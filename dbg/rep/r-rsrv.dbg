     3252   define temp-table temp-font no-undo
     3253     field fontnum  as integer
     3254     field fontname as character
     3255     field fontsize as character
     3256     field fonttype as character
     3257     field font-h   as integer
     3258     field font-w   as integer
     3259     field v-row    as integer
     3260     field v-col    as integer
     3261     field v-row-lans as integer
     3262     field v-col-lans as integer
     3263   index pi fontnum
     3264   .
     3265   procedure get-font-ini :
     3266     do
     3267     on error undo, return error return-value
     3268     :
     3269   define variable ii as integer   no-undo .
     3270   define variable v-font7 as character no-undo .
     3271   define variable v-font as character no-undo .
     3272   define variable loc-name as character no-undo .
     3273   define variable loc-size as character no-undo .
     3274   define variable loc-type as character no-undo .
     3275   define variable old_H as integer   no-undo .
     3276   define variable old_w as integer   no-undo .
     3277   define variable old-row  as integer   no-undo .
     3278   define variable old-col  as integer   no-undo .
     3279   define variable old-row-lans  as integer   no-undo .
     3280   define variable old-col-lans  as integer   no-undo .
     3281   define variable vv as integer   no-undo .
     3282   empty temp-table temp-font.
     3283     GET-KEY-VALUE SECTION "fonts" KEY "font7" VALUE v-font7 .
     3284       case num-entries (v-font7) :
     3285         when 4 then do:
     3286             assign
     3287               loc-name = entry ( 1 , v-font7 )
     3288               loc-size = entry ( 2 , v-font7 )
     3289               loc-type = entry ( 3 , v-font7 ) + "," +  entry ( 4 , v-font7 )
     3290             .
     3291         end.
     3292         when 3 then do:
     3293             assign
     3294               loc-name = entry ( 1 , v-font7 )
     3295               loc-size = entry ( 2 , v-font7 )
     3296               loc-type = entry ( 3 , v-font7 )
     3297             .
     3298         end.
     3299         when 2 then  do:
     3300             assign
     3301               loc-name = entry ( 1 , v-font7 )
     3302               loc-size = entry ( 2 , v-font7 )
     3303               loc-type = ""
     3304             .
     3305         end.
     3306         when 1 then do:
     3307             assign
     3308               loc-name = trim(entry ( 1 , v-font7 ))
     3309               loc-size = ""
     3310               loc-type = ""
     3311             .
     3312         end.
     3313       end case.
     3314     create temp-font.
     3315     assign
     3316       temp-font.fontnum  = 7
     3317       temp-font.fontname = trim(loc-name)
     3318       temp-font.fontsize = trim(loc-size)
     3319       temp-font.fonttype = trim(loc-type)
     3320       temp-font.v-row    = 62
     3321       temp-font.v-col    = 136
     3322       temp-font.v-row-lans = 43
     3323       temp-font.v-col-lans = 198
     3324     .
     3325     repeat ii = 16 to 100 :
     3326       get-key-value section 'fonts' key 'font' + string(ii)   value v-font  .
     3327       if v-font = "" or v-font = ? then leave.
     3328       case num-entries (v-font) :
     3329         when 4 then do:
     3330             assign
     3331               loc-name = entry ( 1 , v-font )
     3332               loc-size = entry ( 2 , v-font )
     3333               loc-type = entry ( 3 , v-font ) + "," +  entry ( 4 , v-font )
     3334             .
     3335         end.
     3336         when 3 then do:
     3337             assign
     3338               loc-name = entry ( 1 , v-font )
     3339               loc-size = entry ( 2 , v-font )
     3340               loc-type = entry ( 3 , v-font )
     3341             .
     3342         end.
     3343         when 2 then do:
     3344             assign
     3345               loc-name = entry ( 1 , v-font )
     3346               loc-size = entry ( 2 , v-font )
     3347               loc-type = ""
     3348             .
     3349         end.
     3350         when 1 then do:
     3351             assign
     3352               loc-name = trim(entry ( 1 , v-font ))
     3353               loc-size = ""
     3354               loc-type = ""
     3355             .
     3356         end.
     3357       end case.
     3358     create temp-font.
     3359     assign
     3360       temp-font.fontnum  = ii
     3361       temp-font.fontname = trim(loc-name)
     3362       temp-font.fontsize = trim(loc-size)
     3363       temp-font.fonttype = trim(loc-type)
     3364     .
     3365     end.
     3366       for each temp-font :
     3367          vv = integer(entry(2,temp-font.fontsize, "=" )) no-error .
     3368          if  vv = ? then vv =  0 .
     3369           run rep/exfont.p (
     3370             input   temp-font.fontname ,
     3371             input   vv ,
     3372             input   temp-font.fonttype ,
     3373             output  temp-font.font-h   ,
     3374             output  temp-font.font-w   )
     3375           .
     3376       end.
     3377   find first temp-font where  temp-font.fontnum  = 7  .
     3378   old_H = temp-font.font-H .
     3379   old_w = temp-font.font-W .
     3380   old-row = temp-font.v-row .
     3381   old-col = temp-font.v-col .
     3382   old-row-lans = temp-font.v-row-lans .
     3383   old-col-lans = temp-font.v-col-lans .
     3384       for each temp-font where
     3385                temp-font.fontnum  <> 7 :
     3386           assign
     3387               temp-font.v-row    = old_H * old-row / temp-font.font-h
     3388               temp-font.v-col    = old_W * old-col / temp-font.font-W
     3389               temp-font.v-row-lans    = old_H * old-row-lans / temp-font.font-h
     3390               temp-font.v-col-lans    = old_W * old-col-lans / temp-font.font-W
     3391           .
     3392       end.
     3393     end.
     3394   end procedure.
     3395   PROCEDURE How-name :
     3396   define input  parameter h as integer no-undo .
     3397   define input  parameter w as integer no-undo .
     3398   define output parameter n as character  no-undo .
     3399   define variable A4port-H as integer   no-undo init 63.
     3400   define variable A4port-W as integer   no-undo init 136.
     3401   define variable A4lans-H as integer   no-undo init 43.
     3402   define variable A4lans-W as integer   no-undo init 198.
     3403   define variable Strim-W  as integer   no-undo init 278.
     3404   run define-a4-size (
     3405        input ReportFontNum
     3406       ,output A4port-H
     3407       ,output A4port-W
     3408       ,output A4lans-H
     3409       ,output A4lans-W ).
     3410   If w >= 1 and w <= A4port-W Then DO:
     3411     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     3412     If h > A4lans-H  and h <= A4port-H Then n = "A4-port":U.
     3413     If h > A4port-H              Then n = "to-file":U.
     3414   End.
     3415   If w > A4port-W and w <= A4lans-W Then DO:
     3416     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     3417     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     3418     If h > A4port-H              Then n = "to-file":U.
     3419   End.
     3420   If w > A4lans-W and w <= Strim-W Then DO:
     3421     If h >= 1  and h <= A4lans-H Then n = "to-file":U.
     3422     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     3423     If h > A4port-H              Then n = "to-file":U.
     3424   End.
     3425   If w > Strim-W Then DO:
     3426      n = "to-file":U.
     3427   End.
     3428   END PROCEDURE.
     3429   PROCEDURE define-a4-size :
     3430   define input  parameter p-ReportFontNum as integer   no-undo .
     3431   define output parameter A4port-H as integer   no-undo .
     3432   define output parameter A4port-W as integer   no-undo .
     3433   define output parameter A4lans-H as integer   no-undo .
     3434   define output parameter A4lans-W as integer   no-undo .
     3435   if not can-find (first temp-font ) then do:
     3436      run get-font-ini .
     3437   end.
     3438   find first temp-font where temp-font.fontnum = p-ReportFontNum no-error .
     3439   if available temp-font then do:
     3440   assign
     3441     A4port-H = temp-font.v-row
     3442     A4port-W = temp-font.v-col
     3443     A4lans-H = temp-font.v-row-lans
     3444     A4lans-W = temp-font.v-col-lans
     3445   .
     3446   end.
     3447   else do:
     3448   assign
     3449     A4port-H = 63
     3450     A4port-W = 136
     3451     A4lans-H = 43
     3452     A4lans-W = 198
     3453   .
     3454   end.
     3455   END PROCEDURE.
     3456   define temp-table temp_result-line no-undo
     3457       field obj-type      as character
     3458       field obj-code      as integer
     3459       field line-order    as integer
     3460       field artic         as character
     3461       field prod-type     as character
     3462       field prod-code     as integer
     3463       field prod-string   as character
     3464       field gds-code      as integer
     3465       field gds-name      as character
     3466       field grp-name      as character
     3467       field rsrv-qnty     as decimal
     3468       field cost-sum      as decimal
     3469       field free-qnty     as decimal
     3470       field doc-code      as character
     3471       field doc-date      as date
     3472       field cli-string    as character
     3473       field duration      as integer
     3474       field class-order   as integer
     3475       index pi is primary unique
     3476           line-order
     3477       index gds-code
     3478           gds-code
     3479       index artic
     3480           artic
     3481       index gds-name
     3482           gds-name
     3483       index class
     3484           class-order
     3485       index obj
     3486           obj-type
     3487           obj-code
     3488   .
     3489   define temp-table temp_classificator no-undo
     3490       field class-order   as integer
     3491       field class-code    as character
     3492       field obj-type      as character
     3493       field obj-code      as integer
     3494       field class1-key    as character
     3495       field class2-key    as character
     3496       field class1-value  as character
     3497       field class2-value  as character
     3498       field sum-rsrv-qnty as decimal
     3499       field sum-cost      as decimal
     3500       field sum-free-qnty as decimal
     3501       index pi is primary unique
     3502           class-order
     3503           obj-type
     3504           obj-code
     3505       index obj
     3506           obj-type
     3507           obj-code
     3508       index code
     3509           class-code
     3510           class1-key
     3511           class2-key
     3512       index alphabet
     3513           class1-value
     3514   .
     3515   define variable v-r-rsrv-sum-rsrv-qnty    as decimal      no-undo.
     3516   define variable v-r-rsrv-sum-cost         as decimal      no-undo.
     3517   define variable v-r-rsrv-sum-free-qnty    as decimal      no-undo.
     3518   define variable v-ext-doc-type-list as character extent 42 init
     3519   [
     3520         'ee':U      , no  , 'накл':U
     3521       , 'ee':U      , no  , 'разрешен':U
     3522       , 'ep':U   , no  , 'накл':U
     3523       , 'ep':U   , no  , 'разрешен':U
     3524       , 'es':U , no  , 'касс':U
     3525       , 'we':U      , no  , 'накл':U
     3526       , 'we':U      , no  , 'разрешен':U
     3527       , 'vt':U            , no  , 'накл':U
     3528       , 'vt':U            , no  , 'разрешен':U
     3529       , 'vt':U            , no  , 'нередакт':U
     3530       , 'vp':U       , no  , 'накл':U
     3531       , 'ev':U      , yes , 'накл':U
     3532       , 'ev':U      , yes , 'разрешен':U
     3533       , 'wm':U       , yes , 'прво':U
     3534   ]                                                           no-undo.
     3535       define stream out-stream .
     3536       define variable v-r-rsrv-line-counter          as integer      no-undo.
     3537       define variable v-r-rsrv-single-line           as character    no-undo.
     3538       define variable v-r-rsrv-double-line           as character    no-undo.
     3539       define variable v-r-rsrv-first-line-printed    as logical      no-undo.
     3540       define variable v-r-rsrv-class-order            as integer      no-undo.
     3541       define variable v-data-present                  as logical      no-undo.
     3542       define variable v-internal                      as logical      no-undo.
     3543       define variable v-doc-type                      as character    no-undo.
     3544       define variable v-ext-doc-type                  as character    no-undo.
     3545       define variable v-status                        as character    no-undo.
     3546       define variable v-counter                       as integer      no-undo.
     3547       define buffer buf_temp_result-line      for temp_result-line.
     3548       define buffer buf_temp_classificator    for temp_classificator.
     3549       define buffer buf_obj-list              for obj-list.
     3550       define buffer buf_trn-doc               for trn-doc.
     3551       define buffer buf_doc-line              for doc-line.
     3552   do
     3553   for buf_temp_result-line
     3554     , buf_temp_classificator
     3555     , buf_obj-list
     3556     , buf_trn-doc
     3557     , buf_doc-line
     3558   on error undo, return error
     3559   :
     3560   define variable v-account as integer init 0 no-undo .
     3561   define variable v-account-lavel as character no-undo .
     3562   define variable v-button-stop as logical no-undo .
     3563   define variable v-kol-spice as integer no-undo .
     3564   define variable v-kol-spice2 as integer no-undo .
     3565   define variable v-kol-spice3 as integer no-undo .
     3566   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     3567   DEFINE BUTTON StopBtn AUTO-END-KEY
     3568        LABEL "Стоп"
     3569        SIZE 10 BY 1.
     3570   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     3571        LABEL "Обработано записей"
     3572         VIEW-AS TEXT
     3573        SIZE 14 BY .67 NO-UNDO.
     3574   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     3575         VIEW-AS TEXT
     3576        SIZE 53.25 BY .67
     3577        FGCOLOR 1  NO-UNDO.
     3578   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     3579         VIEW-AS TEXT
     3580        SIZE 53.25 BY .67
     3581        FGCOLOR 1  NO-UNDO.
     3582   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     3583         VIEW-AS TEXT
     3584        SIZE 53.25 BY .67
     3585        FGCOLOR 1  NO-UNDO.
     3586   DEFINE RECTANGLE RECT-1
     3587        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     3588        SIZE 55.13 BY 4.46.
     3589   DEFINE FRAME InfoFrame
     3590        StopBtn AT ROW 4.25 COL 21.75
     3591        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     3592        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     3593        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     3594        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     3595        RECT-1 AT ROW 1 COL 1
     3596       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     3597            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     3598            TITLE "Процесс"
     3599            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     3600   define variable mFrameView      as logical   no-undo init yes.
     3601     define variable mFramHandle as handle no-undo.
     3602     mFramHandle = frame InfoFrame:handle.
     3603     if  log-manager:logfile-name ne ?
     3604     then DO:
     3605         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     3606         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     3607         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     3608     end.
     3609     mFrameView = not session:batch-mode and mFramHandle:visible.
     3610     if mFrameView
     3611     then do:
     3612       ASSIGN
     3613          FRAME InfoFrame:HIDDEN                           = TRUE
     3614          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     3615     end.
     3616   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     3617   DO:
     3618     IF not StopProcessing THEN
     3619       Message "Вы действительно хотите прервать" SKIP
     3620               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     3621                 UPDATE StopProcessing.
     3622     IF StopProcessing THEN do:
     3623        if mFrameView
     3624        then do:
     3625           HIDE FRAME InfoFrame.
     3626        end.
     3627     End.
     3628   END.
     3629   assign v-account = ( if integer( 20 ) = 0 then 100 else integer( 20 ) ).
     3630     if  log-manager:logfile-name ne ?
     3631     then DO:
     3632         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     3633     end.
     3634     if not session:batch-mode then
     3635     do:
     3636       VIEW FRAME InfoFrame.
     3637       mFrameView = true.
     3638     end.
     3639      v-button-stop = false .
     3640         if mFrameView
     3641         then do:
     3642         if v-button-stop then view STOPBTN in frame InfoFrame.
     3643                          else Hide STOPBTN in frame InfoFrame.
     3644         end.
     3645       assign
     3646           v-r-rsrv-line-counter  = 0
     3647           v-r-rsrv-single-line   = fill( "-", 195 )
     3648           v-r-rsrv-double-line   = fill( "=", 195 )
     3649           v-r-rsrv-class-order   = 0
     3650       .
     3651       for each buf_obj-list
     3652       on error undo, return error
     3653       :
     3654           do v-counter = 1 to 13
     3655           on error undo, return error
     3656           :
     3657               assign
     3658                   v-ext-doc-type  = v-ext-doc-type-list[ v-counter * 3 - 2 ]
     3659                   v-internal      = ( v-ext-doc-type-list[ v-counter * 3 - 1 ] = "yes" )
     3660                   v-status        = v-ext-doc-type-list[ v-counter * 3 ]
     3661               .
     3662   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run trnextdt in g#library
     3663     (input  v-ext-doc-type
     3664     ,output v-doc-type
     3665     )  .
     3666               for each buf_trn-doc no-lock
     3667               where buf_trn-doc.obj-type       = buf_obj-list.obj-type
     3668                   and buf_trn-doc.obj-code     = buf_obj-list.obj-code
     3669                   and buf_trn-doc.internal     = v-internal
     3670                   and buf_trn-doc.doc-type     = v-doc-type
     3671                   and buf_trn-doc.ext-doc-type = v-ext-doc-type
     3672                   and buf_trn-doc.status_      = v-status
     3673               on error undo, return error
     3674               :
     3675                   for each buf_doc-line no-lock
     3676                   where buf_doc-line.doc-code = buf_trn-doc.doc-code
     3677                   on error undo, return error
     3678                   :
     3679                       run out-selected-goods in this-procedure (
     3680                             input rowid( buf_doc-line )
     3681                           , input p-classificator
     3682                       ).
     3683                   end.
     3684               end.
     3685           end.
     3686       end.
     3687       run check-data-presence in this-procedure (
     3688           output v-data-present
     3689       ).
     3690       if v-data-present = yes
     3691       then do:
     3692   output stream out-stream to value( string( session:temp-directory +
     3693                                        "rpt" + string( g#report-num ) ) )
     3694                                        page-size  value(ReportPageHeight) .
     3695           form header
     3696               space(2) v-r-rsrv-single-line format "X(195)"
     3697               skip "Продолжение - на следующей странице" at 90
     3698               with frame BottomFrame
     3699                   width 232
     3700                   page-bottom
     3701                   no-labels
     3702                   no-box
     3703           .
     3704           view stream out-stream frame BottomFrame .
     3705           run print-header in this-procedure.
     3706       end.
     3707       else do:
     3708           message
     3709               "Нет зарезервированных товаров."
     3710           view-as alert-box information
     3711           title "Нет строк для печати".
     3712           undo, return .
     3713       end.
     3714       define variable v-first-object    as logical      no-undo.
     3715       assign
     3716           v-first-object = yes
     3717       .
     3718       for each buf_obj-list
     3719       on error undo, return error
     3720       :
     3721           run print-object-string in this-procedure (
     3722                 input buf_obj-list.obj-type
     3723               , input buf_obj-list.obj-code
     3724               , input v-first-object
     3725           ).
     3726           assign
     3727               v-first-object = no
     3728           .
     3729           for each buf_temp_classificator
     3730              where buf_temp_classificator.class-code = p-classificator
     3731                and buf_temp_classificator.obj-type   = buf_obj-list.obj-type
     3732                and buf_temp_classificator.obj-code   = buf_obj-list.obj-code
     3733           break by buf_temp_classificator.class1-value
     3734           on error undo, return error
     3735           :
     3736               if first-of( buf_temp_classificator.class1-value )
     3737               then do:
     3738                   run print-classificator in this-procedure (
     3739                       input buf_temp_classificator.class-order
     3740                   ).
     3741               end.
     3742               case p-sort-type
     3743               :
     3744                   when "sort-code":U
     3745                   then do:
     3746                       for each buf_temp_result-line
     3747                       where buf_temp_result-line.class-order = buf_temp_classificator.class-order
     3748                       by buf_temp_result-line.gds-code
     3749                       on error undo, return error
     3750                       :
     3751                           run print-line in this-procedure (
     3752                               input buf_temp_result-line.line-order
     3753                           ).
     3754                       end.
     3755                   end.
     3756                   when "sort-artic":U
     3757                   then do:
     3758                       for each buf_temp_result-line
     3759                       where buf_temp_result-line.class-order = buf_temp_classificator.class-order
     3760                       by buf_temp_result-line.artic
     3761                       on error undo, return error
     3762                       :
     3763                           run print-line in this-procedure (
     3764                               input buf_temp_result-line.line-order
     3765                           ).
     3766                       end.
     3767                   end.
     3768                   when "sort-name":U
     3769                   then do:
     3770                       for each buf_temp_result-line
     3771                       where buf_temp_result-line.class-order = buf_temp_classificator.class-order
     3772                       by buf_temp_result-line.gds-name
     3773                       on error undo, return error
     3774                       :
     3775                           run print-line in this-procedure (
     3776                               input buf_temp_result-line.line-order
     3777                           ).
     3778                       end.
     3779                   end.
     3780               end case.
     3781               if last-of( buf_temp_classificator.class1-value )
     3782               then do:
     3783                   run print-classificator-itog in this-procedure (
     3784                         input buf_temp_classificator.sum-rsrv-qnty
     3785                       , input buf_temp_classificator.sum-cost
     3786                       , input buf_temp_classificator.sum-free-qnty
     3787                   ).
     3788               end.
     3789           end.
     3790       end.
     3791       run print-footer in this-procedure .
     3792       hide stream out-stream frame BottomFrame .
     3793       output stream out-stream close.
     3794   if mFrameView
     3795   then do:
     3796      HIDE FRAME InfoFrame.
     3797   end.
     3798       define variable v-user-action           as character            no-undo.
     3799       define variable v-printed               as logical              no-undo.
     3800       define variable v-orient-page as character no-undo .
     3801       define variable DisabledOptions as integer   no-undo .
     3802       run How-name in this-procedure (
     3803           input ReportPageHeight,
     3804           input ReportPageWidth,
     3805           output v-orient-page )
     3806           .
     3807       if v-orient-page = "A4-lans":U then DisabledOptions = 8 .
     3808                                      else DisabledOptions = 0 .
     3809       run gbl/prnfilen.w (
     3810             input "":U
     3811           , input DisabledOptions
     3812           , input string( session :temp-directory ) + "rpt" + string( g#report-num )
     3813           , input ReportFontNum
     3814           , output v-user-action
     3815           , output v-printed
     3816       ) .
     3817   end.
     3818   procedure fill-result-line :
     3819   define input parameter p-doc-line-rowid as rowid            no-undo.
     3820   define input parameter p-classificator  as character        no-undo.
     3821       define variable v-today         as date         no-undo.
     3822       define variable v-time          as integer      no-undo.
     3823       define variable v-cost-sum      as decimal      no-undo.
     3824       define variable v-free-qnty     as decimal      no-undo.
     3825       define variable v-rsrv-qnty     as decimal      no-undo.
     3826       define variable v-duration      as integer      no-undo.
     3827       define variable v-ext-name      as character    no-undo.
     3828       define variable v-class1-key    as character    no-undo.
     3829       define variable v-class1-value  as character    no-undo.
     3830       define variable v-class2-key    as character    no-undo.
     3831       define variable v-class2-value  as character    no-undo.
     3832       define buffer buf_doc-line              for doc-line.
     3833       define buffer buf_trn-doc               for trn-doc.
     3834       define buffer buf_goods                 for goods.
     3835       define buffer buf_temp_result-line      for temp_result-line.
     3836       define buffer buf_temp_classificator    for temp_classificator.
     3837   do
     3838   for buf_doc-line
     3839     , buf_trn-doc
     3840     , buf_goods
     3841     , buf_temp_result-line
     3842     , buf_temp_classificator
     3843   on error undo, return error
     3844   :
     3845       find first buf_doc-line no-lock
     3846            where rowid( buf_doc-line ) = p-doc-line-rowid
     3847       .
     3848       find first buf_trn-doc no-lock
     3849            where buf_trn-doc.doc-code = buf_doc-line.doc-code
     3850       .
     3851       run cur-time in this-procedure (
     3852             output v-today
     3853           , output v-time
     3854       ).
     3855       run godendo-date-to-offset in this-procedure (
     3856             input v-today
     3857           , input buf_trn-doc.doc-date
     3858           , output v-duration
     3859       ).
     3860       find first buf_goods no-lock
     3861            where buf_goods.artic     = buf_doc-line.artic
     3862              and buf_goods.prod-type = buf_doc-line.prod-type
     3863              and buf_goods.prod-code = buf_doc-line.prod-code
     3864       .
     3865       run get-price-and-qnty in this-procedure (
     3866             input p-doc-line-rowid
     3867           , output v-cost-sum
     3868           , output v-rsrv-qnty
     3869           , output v-free-qnty
     3870       ).
     3871       if v-rsrv-qnty <> 0
     3872       then do:
     3873           assign
     3874               v-r-rsrv-line-counter = v-r-rsrv-line-counter + 1
     3875           .
     3876   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3877   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run docextnm in g#library
     3878     (input  buf_trn-doc.doc-code
     3879     ,output v-ext-name
     3880     )  .
     3881           create buf_temp_result-line.
     3882           assign
     3883               buf_temp_result-line.line-order     = v-r-rsrv-line-counter * 10
     3884               buf_temp_result-line.obj-type       = buf_trn-doc.obj-type
     3885               buf_temp_result-line.obj-code       = buf_trn-doc.obj-code
     3886               buf_temp_result-line.artic          = buf_doc-line.artic
     3887               buf_temp_result-line.prod-type      = buf_doc-line.prod-type
     3888               buf_temp_result-line.prod-code      = buf_doc-line.prod-code
     3889               buf_temp_result-line.prod-string    = substitute( "&1 &2", buf_doc-line.prod-type, buf_doc-line.prod-code )
     3890               buf_temp_result-line.gds-code       = buf_goods.gds-code
     3891               buf_temp_result-line.gds-name       = buf_goods.gds-name
     3892               buf_temp_result-line.grp-name       = buf_goods.grp-name
     3893               buf_temp_result-line.rsrv-qnty      = v-rsrv-qnty
     3894               buf_temp_result-line.cost-sum       = v-cost-sum
     3895               buf_temp_result-line.free-qnty      = v-free-qnty
     3896               buf_temp_result-line.doc-code       = substitute( "&1 &2", v-ext-name, buf_trn-doc.doc-code )
     3897               buf_temp_result-line.doc-date       = buf_trn-doc.doc-date
     3898               buf_temp_result-line.cli-string     = substitute( "&1 &2", buf_trn-doc.cli-type,  buf_trn-doc.cli-code  )
     3899               buf_temp_result-line.duration       = ( -1 ) * v-duration
     3900           .
     3901           case p-classificator
     3902           :
     3903               when "no-classify":U
     3904               then do:
     3905                   assign
     3906                       v-class1-key   = ""
     3907                       v-class1-value = ""
     3908                       v-class2-key   = ""
     3909                       v-class2-value = ""
     3910                   .
     3911               end.
     3912               when "grp-goods":U
     3913               then do:
     3914                   assign
     3915                       v-class1-key   = buf_temp_result-line.grp-name
     3916                       v-class1-value = substitute( "    Группа: &1", buf_temp_result-line.grp-name )
     3917                       v-class2-key   = ""
     3918                       v-class2-value = ""
     3919                   .
     3920               end.
     3921           end case.
     3922           find first buf_temp_classificator
     3923                where buf_temp_classificator.class-code   = p-classificator
     3924                  and buf_temp_classificator.obj-type     = buf_trn-doc.obj-type
     3925                  and buf_temp_classificator.obj-code     = buf_trn-doc.obj-code
     3926                  and buf_temp_classificator.class1-key   = v-class1-key
     3927                  and buf_temp_classificator.class2-key   = v-class2-key
     3928           no-error.
     3929           if not available buf_temp_classificator
     3930           then do:
     3931               assign
     3932                   v-r-rsrv-class-order = v-r-rsrv-class-order + 1
     3933               .
     3934               create buf_temp_classificator.
     3935               assign
     3936                   buf_temp_classificator.class-order  = v-r-rsrv-class-order
     3937                   buf_temp_classificator.class-code   = p-classificator
     3938                   buf_temp_classificator.obj-type     = buf_trn-doc.obj-type
     3939                   buf_temp_classificator.obj-code     = buf_trn-doc.obj-code
     3940                   buf_temp_classificator.class1-key   = v-class1-key
     3941                   buf_temp_classificator.class2-key   = v-class2-key
     3942                   buf_temp_classificator.class1-value = v-class1-value
     3943                   buf_temp_classificator.class2-value = v-class2-value
     3944               .
     3945           end.
     3946           assign
     3947               buf_temp_classificator.sum-rsrv-qnty  = buf_temp_classificator.sum-rsrv-qnty  + buf_temp_result-line.rsrv-qnty
     3948               buf_temp_classificator.sum-cost       = buf_temp_classificator.sum-cost       + buf_temp_result-line.cost-sum
     3949               buf_temp_classificator.sum-free-qnty  = buf_temp_classificator.sum-free-qnty  + buf_temp_result-line.free-qnty
     3950               v-r-rsrv-sum-rsrv-qnty                = v-r-rsrv-sum-rsrv-qnty                + buf_temp_result-line.rsrv-qnty
     3951               v-r-rsrv-sum-cost                     = v-r-rsrv-sum-cost                     + buf_temp_result-line.cost-sum
     3952               v-r-rsrv-sum-free-qnty                = v-r-rsrv-sum-free-qnty                + buf_temp_result-line.free-qnty
     3953           .
     3954           assign
     3955               buf_temp_result-line.class-order = buf_temp_classificator.class-order
     3956           .
     3957   IF ( v-r-rsrv-line-counter modulo v-account = 0 )  then DO:
     3958    Assign
     3959       v-kol-spice = (50 - LENGTH(reportname)) / 2
     3960       RecordsString = fill(' ',v-kol-spice) + string(reportname)
     3961       .
     3962             if  log-manager:logfile-name ne ?
     3963             then DO:
     3964                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     3965             end.
     3966              if mFrameView
     3967              then do:
     3968               DISPLAY
     3969                 v-r-rsrv-line-counter @ RecordsDone
     3970                 RecordsString   @ RecordsString
     3971                 WITH FRAME InfoFrame.
     3972              end.
     3973   End.
     3974      if v-button-stop then  DO:
     3975            if mFrameView
     3976            then
     3977               PROCESS EVENTS.
     3978            IF StopProcessing THEN DO:
     3979            RETURN error.
     3980            End.
     3981      end.
     3982       end.
     3983   end.
     3984   end procedure.
     3985   procedure check-data-presence :
     3986   define output parameter p-data-present  as logical          no-undo.
     3987       define buffer buf_temp_result-line      for temp_result-line.
     3988   do
     3989   for buf_temp_result-line
     3990   on error undo, return error
     3991   :
     3992       find first buf_temp_result-line
     3993       no-error.
     3994       if available buf_temp_result-line
     3995       then do:
     3996           assign
     3997               p-data-present = yes
     3998           .
     3999       end.
     4000       else do:
     4001           assign
     4002               p-data-present = no
     4003           .
     4004       end.
     4005   end.
     4006   end procedure.
     4007   procedure print-header :
     4008   do
     4009   on error undo, return error
     4010   :
     4011       put stream out-stream
     4012           skip(1)
     4013           skip space( 22 )
     4014                   "Отчет по зарезервированным товарам."
     4015       .
     4016       put stream out-stream unformatted
     4017           skip(1)
     4018               str2            format "X(100)"
     4019           skip
     4020               str4            format "X(100)"
     4021           skip
     4022               ReportHeader
     4023           skip
     4024               "Показано товаров:"
     4025               v-r-rsrv-line-counter   format ">>>>>>>9"
     4026           skip
     4027               "Дата печати: "
     4028               cur-time-string()       format "X(40)"
     4029               "Цены и суммы указаны в "
     4030               ( if x-SET_val_TYPE = 1
     4031                 then "РУБ"
     4032                 else base-type )      format "X(10)"
     4033       .
     4034       put stream out-stream
     4035           skip
     4036           space(2)
     4037               v-r-rsrv-single-line   format "X(195)"
     4038           skip space(2)  "|"
     4039               "Код"                   at center-field(2 + 1, 2 + 11, 3)
     4040               "|"                     at 2 + 11
     4041               "Артикул"               at center-field(2 + 11, 2 + 28, 7)
     4042               "|"                     at 2 + 28
     4043               "Производитель"         at center-field(2 + 28, 2 + 42, 13)
     4044               "|"                     at 2 + 42
     4045               "Наименование товара"   at 2 + 42 + 2
     4046               "|"                     at 2 + 82
     4047               "Количество"            at 2 + 82 + 2
     4048               "|"                     at 2 + 96
     4049               "Учетная"               at 2 + 96 + 2
     4050               "|"                     at 2 + 110
     4051               "Сумма"                 at 2 + 110 + 2
     4052               "|"                     at 2 + 125
     4053               "Свободное"             at 2 + 125 + 2
     4054               "|"                     at 2 + 139
     4055               "Номер"                 at 2 + 139 + 2
     4056               "|"                     at 2 + 156
     4057               "Дата"                  at 2 + 156 + 2
     4058               "|"                     at 2 + 168
     4059               "Контрагент"            at 2 + 168 + 2
     4060               "|"                     at 2 + 182
     4061               "Дней"                  at 2 + 182 + 2
     4062               "|"                     at 2 + 195
     4063           skip space(2)  "|"
     4064               "товара"                at center-field(2 + 1, 2 + 11, 6)
     4065               "|"                     at 2 + 11
     4066               "|"                     at 2 + 28
     4067               "|"                     at 2 + 42
     4068               "|"                     at 2 + 82
     4069               "резерв"                at 2 + 82 + 2
     4070               "|"                     at 2 + 96
     4071               "цена"                  at 2 + 96 + 2
     4072               "|"                     at 2 + 110
     4073               "в уч.ц."               at 2 + 110 + 2
     4074               "|"                     at 2 + 125
     4075               "количество"            at 2 + 125 + 2
     4076               "|"                     at 2 + 139
     4077               "накладной"             at 2 + 139 + 2
     4078               "|"                     at 2 + 156
     4079               "накладной"             at 2 + 156 + 2
     4080               "|"                     at 2 + 168
     4081               "|"                     at 2 + 182
     4082               "в резерве"             at 2 + 182 + 2
     4083               "|"                     at 2 + 195
     4084           skip space(2)
     4085               "|" v-r-rsrv-single-line format "X(193)" "|"
     4086       .
     4087   end.
     4088   end procedure.
     4089   procedure print-line :
     4090   define input parameter p-line-order     as integer          no-undo.
     4091       define buffer buf_temp_result-line          for temp_result-line.
     4092   do
     4093   for buf_temp_result-line
     4094   on error undo, return error
     4095   :
     4096       find first buf_temp_result-line
     4097            where buf_temp_result-line.line-order = p-line-order
     4098       .
     4099       put stream out-stream
     4100           skip space(2) "|"
     4101               buf_temp_result-line.gds-code        format "999999999"
     4102               "|"                     at 2 + 11
     4103               buf_temp_result-line.artic           format "X(16)"
     4104               "|"                     at 2 + 28
     4105               buf_temp_result-line.prod-string     format "X(13)"
     4106               "|"                     at 2 + 42
     4107               buf_temp_result-line.gds-name        format "X(39)"
     4108               "|"                     at 2 + 82
     4109               buf_temp_result-line.rsrv-qnty       format "->>>>>>9.99"
     4110               "|"                     at 2 + 96
     4111               buf_temp_result-line.cost-sum / buf_temp_result-line.rsrv-qnty
     4112                                                    format "->,>>>,>>9.99"
     4113               "|"                     at 2 + 110
     4114               buf_temp_result-line.cost-sum        format "->,>>>,>>9.99"
     4115               "|"                     at 2 + 125
     4116               buf_temp_result-line.free-qnty       format "->>>>>>9.99"
     4117               "|"                     at 2 + 139
     4118               buf_temp_result-line.doc-code        format "X(13)"
     4119               "|"                     at 2 + 156
     4120               buf_temp_result-line.doc-date        format "99.99.9999"
     4121               "|"                     at 2 + 168
     4122               buf_temp_result-line.cli-string      format "X(13)"
     4123               "|"                     at 2 + 182
     4124               buf_temp_result-line.duration        format "->>>>>9"
     4125               "|"                     at 2 + 195
     4126       .
     4127   end.
     4128   end procedure.
     4129   procedure print-classificator :
     4130   define input parameter p-class-order    as integer          no-undo.
     4131       define buffer buf_temp_classificator        for temp_classificator.
     4132   do
     4133   for buf_temp_classificator
     4134   on error undo, return error
     4135   :
     4136       find first buf_temp_classificator
     4137            where buf_temp_classificator.class-order = p-class-order
     4138       .
     4139       if buf_temp_classificator.class-code = "no-classify":U
     4140       then do:
     4141           undo, return .
     4142       end.
     4143       if v-r-rsrv-first-line-printed = no
     4144       then do:
     4145           assign
     4146               v-r-rsrv-first-line-printed = yes
     4147           .
     4148       end.
     4149       else do:
     4150           put stream out-stream
     4151               skip space(2)
     4152                   "|" v-r-rsrv-single-line format "X(193)" "|"
     4153           .
     4154       end.
     4155       put stream out-stream
     4156           skip space(2)
     4157                   "|"
     4158                   buf_temp_classificator.class1-value format "X(193)"
     4159                   "|"             at 2 + 195
     4160       .
     4161       if buf_temp_classificator.class2-key <> ""
     4162       then do:
     4163           put stream out-stream
     4164               skip space(2)
     4165                   "|" v-r-rsrv-single-line format "X(193)" "|"
     4166               skip space(2)
     4167                   "|"
     4168                   buf_temp_classificator.class2-value format "X(193)"
     4169                   "|"             at 2 + 195
     4170           .
     4171       end.
     4172   end.
     4173   end procedure.
     4174   procedure print-footer :
     4175   do
     4176   on error undo, return error
     4177   :
     4178       put stream out-stream
     4179           skip space(2)
     4180               "|" v-r-rsrv-single-line format "X(193)" "|"
     4181           skip space(2) "|     Всего                  "
     4182               "|"                     at 2 + 82
     4183               v-r-rsrv-sum-rsrv-qnty                     format "->>>>>>9.99"
     4184               "|"                     at 2 + 96
     4185               "|"                     at 2 + 110
     4186               v-r-rsrv-sum-cost                          format "->,>>>,>>9.99"
     4187               "|"                     at 2 + 125
     4188               v-r-rsrv-sum-free-qnty                     format "->>>>>>9.99"
     4189               "|"                     at 2 + 139
     4190               "|"                     at 2 + 195
     4191           skip space(2)
     4192               v-r-rsrv-single-line   format "X(195)"
     4193       .
     4194   end.
     4195   end procedure.
     4196   procedure out-selected-goods :
     4197   define input parameter p-doc-line-rowid as rowid            no-undo.
     4198   define input parameter p-classificator  as character        no-undo.
     4199       define buffer buf_doc-line              for doc-line.
     4200       define buffer buf_goods                 for goods.
     4201       define buffer buf_temp_goods            for gds-list.
     4202       define buffer buf_temp_goods-grp        for tmp#grp.
     4203   do
     4204   for buf_doc-line
     4205     , buf_goods
     4206     , buf_temp_goods
     4207     , buf_temp_goods-grp
     4208   on error undo, return error
     4209   :
     4210       find first buf_doc-line no-lock
     4211            where rowid( buf_doc-line ) = p-doc-line-rowid
     4212       .
     4213       find first buf_goods no-lock
     4214            where buf_goods.artic     = buf_doc-line.artic
     4215              and buf_goods.prod-type = buf_doc-line.prod-type
     4216              and buf_goods.prod-code = buf_doc-line.prod-code
     4217       .
     4218       if buf_goods.gds-type = 'т':U
     4219       then do:
     4220           case x-SelectGood
     4221           :
     4222               when 1
     4223               then do:
     4224                   run fill-result-line in this-procedure (
     4225                         input p-doc-line-rowid
     4226                       , input p-classificator
     4227                   ).
     4228               end.
     4229               when 2
     4230               then do:
     4231                   find first buf_temp_goods-grp
     4232                        where buf_temp_goods-grp.node-code = buf_goods.grp-code
     4233                   no-error.
     4234                   if available buf_temp_goods-grp
     4235                   then do:
     4236                       run fill-result-line in this-procedure (
     4237                             input p-doc-line-rowid
     4238                           , input p-classificator
     4239                       ).
     4240                   end.
     4241               end.
     4242               when 4
     4243               or when 5
     4244               then do:
     4245                   find first buf_temp_goods
     4246                        where buf_temp_goods.artic     = buf_doc-line.artic
     4247                          and buf_temp_goods.prod-type = buf_doc-line.prod-type
     4248                          and buf_temp_goods.prod-code = buf_doc-line.prod-code
     4249                   no-error.
     4250                   if available buf_temp_goods
     4251                   then do:
     4252                       run fill-result-line in this-procedure (
     4253                             input p-doc-line-rowid
     4254                           , input p-classificator
     4255                       ).
     4256                   end.
     4257               end.
     4258           end case.
     4259       end.
     4260   end.
     4261   end procedure.
     4262   procedure get-price-and-qnty :
     4263   define input parameter p-doc-line-rowid     as rowid            no-undo.
     4264   define output parameter p-cost-sum          as decimal          no-undo.
     4265   define output parameter p-rsrv-qnty         as decimal          no-undo.
     4266   define output parameter p-free-qnty         as decimal          no-undo.
     4267       define buffer buf_doc-line      for doc-line.
     4268       define buffer buf_gds-obj       for gds-obj.
     4269   do
     4270   for buf_doc-line
     4271     , buf_gds-obj
     4272   on error undo, return error
     4273   :
     4274       find first buf_doc-line no-lock
     4275            where rowid( buf_doc-line ) = p-doc-line-rowid
     4276       .
     4277       run clcprtsl_calc-line in this-procedure (
     4278           input recid( buf_doc-line )
     4279       ).
     4280       find first tt-allsum-line
     4281            where tt-allsum-line.sum-type = 'основная_сумма':U
     4282       no-error.
     4283       if available tt-allsum-line
     4284       then do:
     4285           assign
     4286               p-cost-sum   = ( if x-SET_val_TYPE = 1 then tt-allsum-line.sum-dsc-rubl-acc else tt-allsum-line.sum-dsc-base-acc )
     4287               p-rsrv-qnty  = tt-allsum-line.fact-qnty
     4288           .
     4289       end.
     4290       else do:
     4291           assign
     4292               p-cost-sum   = 0
     4293               p-rsrv-qnty  = 0
     4294           .
     4295       end.
     4296       find first buf_gds-obj no-lock
     4297            where buf_gds-obj.obj-type     = buf_doc-line.obj-type
     4298              and buf_gds-obj.obj-code     = buf_doc-line.obj-code
     4299              and buf_gds-obj.artic        = buf_doc-line.artic
     4300              and buf_gds-obj.prod-type    = buf_doc-line.prod-type
     4301              and buf_gds-obj.prod-code    = buf_doc-line.prod-code
     4302       no-error.
     4303       if available buf_gds-obj
     4304       then do:
     4305           assign
     4306               p-free-qnty = buf_gds-obj.fact-qnty
     4307           .
     4308       end.
     4309       else do:
     4310           assign
     4311               p-free-qnty = 0
     4312           .
     4313       end.
     4314   end.
     4315   end procedure.
     4316   procedure print-object-string :
     4317   define input parameter p-obj-type       as character        no-undo.
     4318   define input parameter p-obj-code       as integer          no-undo.
     4319   define input parameter p-first-object   as logical          no-undo.
     4320   do
     4321   on error undo, return error
     4322   :
     4323       if p-first-object = no
     4324       then do:
     4325           put stream out-stream
     4326               skip space(2)
     4327                   "|" v-r-rsrv-double-line format "X(193)" "|"
     4328           .
     4329       end.
     4330       put stream out-stream
     4331           skip space(2)
     4332               "|"
     4333               substitute( "Объект: &1 &2", p-obj-type, p-obj-code )  format "X(193)"
     4334               "|"             at 2 + 195
     4335           skip space(2)
     4336               "|" v-r-rsrv-double-line format "X(193)" "|"
     4337       .
     4338   end.
     4339   end procedure.
     4340   procedure print-classificator-itog :
     4341   define input parameter p-sum-rsrv-qnty  as decimal          no-undo.
     4342   define input parameter p-sum-cost       as decimal          no-undo.
     4343   define input parameter p-sum-free-qnty  as decimal          no-undo.
     4344   do
     4345   on error undo, return error
     4346   :
     4347       put stream out-stream
     4348           skip space(2) "|     Итого по классификатору"
     4349               "|"                     at 2 + 82
     4350               p-sum-rsrv-qnty                     format "->>>>>>9.99"
     4351               "|"                     at 2 + 96
     4352               "|"                     at 2 + 110
     4353               p-sum-cost                          format "->,>>>,>>9.99"
     4354               "|"                     at 2 + 125
     4355               p-sum-free-qnty                     format "->>>>>>9.99"
     4356               "|"                     at 2 + 139
     4357               "|"                     at 2 + 195
     4358       .
     4359   end.
     4360   end procedure.
