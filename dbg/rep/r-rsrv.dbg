     1616                                      out-vatp_goodscl.prod-type = parprod-type and
     1617                                      out-vatp_goodscl.prod-code = parprod-code no-lock.
     1618   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1619   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
     1620     (input  parartic
     1621     ,input  parprod-type
     1622     ,input  parprod-code
     1623     ,output varroot-nodecl
     1624     ) no-error .
     1625   if error-status :error then do:
     1626     message
     1627       vss-workfile vss-revision vss-description skip
     1628       "Ошибка при определении корневого признака товара" skip
     1629       "Артикул" parartic parprod-type parprod-code skip
     1630       error-status :get-message(1) skip
     1631       return-value skip
     1632       view-as alert-box error .
     1633     undo, return error .
     1634   end.
     1635   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtat in g#library
     1636     (input  varroot-nodecl
     1637     ,input  'empty-scale=request'
     1638     ,output varempty-scalecl
     1639     ) no-error .
     1640   if error-status :error then do:
     1641     message
     1642       vss-workfile vss-revision vss-description skip
     1643       "Ошибка при определении атрибута признака" skip
     1644       "Артикул" parartic parprod-type parprod-code skip
     1645       "Признак" varroot-nodecl skip
     1646       "Запрашивался атрибут" "empty-scale=request" skip
     1647       error-status :get-message(1) skip
     1648       return-value skip
     1649       view-as alert-box error .
