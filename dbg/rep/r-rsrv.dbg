     2998   procedure clcprtsl_calc-ttable :
     2999   define input parameter paris-doc           as   logical                 no-undo.
     3000   define input parameter paris-cur           as   logical                 no-undo.
     3001   define input parameter parroad-tax         like ub.doc-line.road-tax    no-undo.
     3002   define input parameter parexcise           like ub.doc-line.excise      no-undo.
     3003   define input parameter parvat-pc           like ub.doc-line.vat-pc      no-undo.
     3004   define input parameter parcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     3005   define input parameter parslt-pc           like ub.doc-line.slt-pc      no-undo.
     3006   define input parameter parbase-rate        like ub.trn-doc.base-rate    no-undo.
     3007   define input parameter parbase-scale       like ub.trn-doc.base-scale   no-undo.
     3008   define input parameter parr-b              as   character               no-undo.
     3009   define input parameter parcur-base         like ub.gds-dtl.cur-base     no-undo.
     3010   define input parameter parcur-road-tax     like ub.doc-line.road-tax    no-undo.
     3011   define input parameter parcur-excise       like ub.doc-line.excise      no-undo.
     3012   define input parameter parcur-vat-pc       like ub.doc-line.vat-pc      no-undo.
     3013   define input parameter parcurcons-vat-pc   like ub.doc-line.cons-vat-pc no-undo.
     3014   define input parameter parcurslt-pc        like ub.doc-line.slt-pc      no-undo.
     3015   define buffer bf_tt-allsum      for tt-allsum.
     3016   define buffer bf_tt-clcparts    for tt-clcparts.
     3017   define buffer bf_tt-allsum-line for tt-allsum-line.
     3018   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     3019   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     3020   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     3021   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     3022   define variable varexcise          like ub.price-list.excise     no-undo.
     3023   do on error undo, return error return-value :
     3024   for each bf_tt-allsum-line
     3025   on error undo, return error return-value
     3026    :
     3027     delete bf_tt-allsum-line.
     3028   end.
     3029   for each bf_tt-allsum
     3030   on error undo, return error return-value
     3031   :
     3032     delete bf_tt-allsum.
     3033   end.
     3034   for each bf_tt-clcparts
     3035   on error undo, return error return-value
     3036   :
     3037   if v-calcbypart then do:
     3038             assign
     3039             parcur-base =   bf_tt-clcparts.part-cur-base
     3040             parcur-road-tax = bf_tt-clcparts.part-cur-road-tax
     3041             parcur-excise =   bf_tt-clcparts.part-cur-excise
     3042             .
     3043   end.
     3044      run clcprtsl_calc-parts in this-procedure (
     3045        input recid(bf_tt-clcparts),
     3046        input paris-doc,
     3047        input paris-cur,
     3048        input parroad-tax,
     3049        input parexcise,
     3050        input parvat-pc,
     3051        input parcons-vat-pc,
     3052        input parslt-pc,
     3053        input parbase-rate,
     3054        input parbase-scale,
     3055        input parr-b,
     3056        input parcur-base,
     3057        input parcur-road-tax,
     3058        input parcur-excise,
     3059        input parcur-vat-pc,
     3060        input parcurcons-vat-pc,
     3061        input parcurslt-pc
     3062        ) no-error.
     3063     if error-status:error then do:
     3064       message
     3065         vss-workfile vss-revision vss-description skip
     3066         vss-include-info11 skip
     3067         "Ошибка при обсчете партии" skip
     3068         "Документ партии " bf_tt-clcparts.out-code skip
     3069         "Товар" bf_tt-clcparts.artic bf_tt-clcparts.prod-type bf_tt-clcparts.prod-code skip
     3070         return-value skip
     3071         error-status:get-message(1) skip
     3072         error-status:get-message(2) skip
     3073         error-status:get-message(3) skip
     3074         view-as alert-box error .
     3075       undo, return error .
     3076     end.
     3077     for each bf_tt-allsum on error undo, return error return-value :
     3078       find first bf_tt-allsum-line where bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type no-error.
     3079       if not available bf_tt-allsum-line then do:
     3080         create bf_tt-allsum-line.
     3081         assign
     3082           bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type.
     3083       end.
     3084       assign
     3085         bf_tt-allsum-line.fact-qnty              = bf_tt-allsum-line.fact-qnty            + bf_tt-allsum.fact-qnty
     3086         bf_tt-allsum-line.cli-qnty               = bf_tt-allsum-line.cli-qnty             + bf_tt-allsum.cli-qnty
     3087         bf_tt-allsum-line.sum-dsc-base-doc       = bf_tt-allsum-line.sum-dsc-base-doc     + bf_tt-allsum.sum-dsc-base-doc
