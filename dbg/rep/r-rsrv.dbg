      580   define temp-table temp_p-fmt_string-part no-undo
      581       field str-key       as integer
      582       field string-part   as character
      583       index pi is primary unique
      584           str-key
      585   .
      586   define variable v-p-fmt-8-str-key    as integer      no-undo.
      587   FUNCTION center-field RETURNS INTEGER (INPUT iStartPix AS INTEGER, iEndPix AS INTEGER,
      588                                     iInput AS INTEGER).
      589     def var v-start-print as integer no-undo .
      590     if (iStartPix < 0) or (iEndPix < iStartPix) then return 0.
      591     assign
      592       v-start-print = INTEGER(iStartPix + ((iEndPix - iStartPix) / 2) - (iInput / 2))
      593     .
      594     RETURN v-start-print .
      595   END FUNCTION.
      596   FUNCTION right-field RETURNS INTEGER ( iEndPix AS INTEGER,
      597                                     iInput AS INTEGER).
      598     def var v-start-print as integer no-undo .
      599     assign
      600       v-start-print = INTEGER(iEndPix - 1 - iInput)
      601     .
      602     if v-start-print < 0 then return 0.
      603     RETURN v-start-print .
      604   END FUNCTION.
      605   function p-fmt-align-string returns character (
      606         p-in-string      as character
      607       , p-page-width     as integer
      608       , p-align-type     as character
      609   ).
      610       define variable v-string-length     as integer      no-undo.
      611       define variable v-out-string        as character    no-undo.
      612       assign
      613           v-string-length = length( trim( p-in-string ) )
      614       .
      615       if v-string-length >= p-page-width
      616       then do:
      617           assign
      618               v-out-string = trim( p-in-string )
      619           .
      620       end.
      621       else do:
      622           case p-align-type
      623           :
      624               when 'left':U
      625               then do:
      626                   assign
      627                       v-out-string = trim( p-in-string )
      628                   .
      629               end.
      630               when 'right':U
      631               then do:
      632                   assign
      633                       v-out-string = fill( " ":U, p-page-width - v-string-length ) + trim( p-in-string )
      634                   .
      635               end.
      636               when 'center':U
      637               then do:
      638                   assign
      639                       v-out-string = fill( " ":U, integer( ( p-page-width - v-string-length ) / 2 ) ) + trim( p-in-string )
      640                   .
      641               end.
      642           end case.
      643       end.
      644       return v-out-string .
      645   end function.
      646   procedure p-fmt-split-string :
      647   define input parameter p-source-string  as character        no-undo.
      648   define input parameter p-split-length   as integer          no-undo.
      649   define output parameter p-string-1      as character        no-undo.
      650   define output parameter p-string-2      as character        no-undo.
      651   do
      652   on error undo, return error
      653   :
      654       define variable v-space-pos    as integer      no-undo.
      655       if length( p-source-string ) <= p-split-length
      656       then do:
      657           assign
      658               p-string-1 = p-source-string
      659           .
      660       end.
      661       else do:
      662           assign
      663               v-space-pos = r-index( p-source-string, " ":U, p-split-length )
      664           .
      665           if v-space-pos = 0
      666           then do:
      667               assign
      668                   v-space-pos = index( p-source-string, " ":U )
      669               .
      670           end.
      671           if v-space-pos = 0
      672           then do:
      673               assign
      674                   p-string-1 = substring( p-source-string, 1, p-split-length )
      675                   p-string-2 = trim( substring( p-source-string, p-split-length, p-split-length ) )
      676               .
      677           end.
      678           else do:
      679               assign
      680                   p-string-1 = substring( p-source-string, 1, v-space-pos )
      681                   p-string-2 = trim( substring( p-source-string, v-space-pos ) )
      682               .
      683           end.
      684       end.
      685   end.
      686   end procedure.
      687   procedure p-fmt-round :
      688   define input parameter p-qnty               as decimal          no-undo.
      689   define input parameter p-price-no-VAT       as decimal          no-undo.
      690   define input parameter p-VAT                as decimal          no-undo.
      691   define input parameter p-SLT                as decimal          no-undo.
      692   define input parameter p-road-tax           as decimal          no-undo.
      693   define output parameter p-new-price-no-VAT  as decimal          no-undo.
      694   define output parameter p-new-VAT           as decimal          no-undo.
      695   define output parameter p-new-SLT           as decimal          no-undo.
      696   define output parameter p-new-sum-VAT       as decimal          no-undo.
      697   define output parameter p-new-sum-SLT       as decimal          no-undo.
      698   define output parameter p-new-sum-road-tax  as decimal          no-undo.
      699   define output parameter p-new-sum-no-VAT    as decimal          no-undo.
      700   define output parameter p-new-sum-full      as decimal          no-undo.
      701       define variable v-vat-pc    as decimal      no-undo.
      702       define variable v-slt-pc    as decimal      no-undo.
      703   do
      704   on error undo, return error
      705   :
      706       if p-price-no-VAT = 0
      707       then do:
      708           assign
      709               p-new-price-no-VAT = 0.0
      710               p-new-VAT          = ?
      711               p-new-SLT          = ?
      712               p-new-sum-VAT      = 0.0
      713               p-new-sum-SLT      = 0.0
      714               p-new-sum-no-VAT   = 0.0
      715               p-new-sum-road-tax = 0.0
      716               p-new-sum-full     = 0.0
      717           .
      718       end.
      719       else do:
      720           assign
      721               v-vat-pc            = p-VAT / p-price-no-VAT
      722               v-slt-pc            = p-SLT / ( p-price-no-VAT + p-VAT )
      723               p-new-price-no-VAT  = round( p-price-no-VAT, 2 )
      724               p-new-VAT           = round( p-new-price-no-VAT * v-vat-pc, 2 )
      725               p-new-SLT           = round( ( p-new-price-no-VAT + p-new-VAT ) * v-slt-pc, 2 )
      726               p-new-sum-VAT       = round( p-new-VAT          * p-qnty, 2 )
      727               p-new-sum-SLT       = round( ( p-new-price-no-VAT + p-new-VAT ) * p-qnty * v-slt-pc, 2 )
      728               p-new-sum-no-VAT    = round( p-new-price-no-VAT * p-qnty, 2 )
      729               p-new-sum-road-tax  = round( p-road-tax * p-qnty, 2 )
      730               p-new-sum-full      = round( ( p-new-price-no-VAT + p-new-VAT + p-new-SLT + p-road-tax ) * p-qnty, 2 )
      731           .
      732       end.
      733   end.
      734   end procedure.
      735   procedure p-fmt-split :
      736   define input parameter p-in-string      as character        no-undo.
      737   define input parameter p-split-length   as integer          no-undo.
      738       define variable v-start-pos     as integer      no-undo.
      739       define variable v-end-pos       as integer      no-undo.
      740       define buffer buf_temp_p-fmt_string-part        for temp_p-fmt_string-part.
      741   do
      742   for buf_temp_p-fmt_string-part
      743   on error undo, return error
      744   :
      745       empty temp-table buf_temp_p-fmt_string-part.
      746       if p-split-length < 1
      747       then do:
      748           undo, return error substitute( "p-fmt-split: Строка не может быть разбита на &1 частей", p-split-length ).
      749       end.
      750       assign
      751           p-in-string                 = trim( p-in-string )
      752           v-p-fmt-8-str-key   = 0
      753           v-start-pos                 = 1
      754           v-end-pos                   = length( p-in-string )
      755       .
      756       run p-fmt-get-string-range in this-procedure (
      757             input p-in-string
      758           , input p-split-length
      759           , input v-start-pos
      760           , output v-start-pos
      761           , output v-end-pos
      762       ).
      763       do while v-end-pos <> 0
      764       :
      765           create buf_temp_p-fmt_string-part.
      766           assign
      767               v-p-fmt-8-str-key = v-p-fmt-8-str-key + 1
      768           .
      769           assign
      770               buf_temp_p-fmt_string-part.str-key      = v-p-fmt-8-str-key
      771               buf_temp_p-fmt_string-part.string-part  = substring( p-in-string, v-start-pos, v-end-pos - v-start-pos )
      772           .
      773           assign
      774               v-start-pos = v-end-pos + 1
      775           .
      776           run p-fmt-get-string-range in this-procedure (
      777                 input p-in-string
      778               , input p-split-length
      779               , input v-start-pos
      780               , output v-start-pos
      781               , output v-end-pos
      782           ).
      783       end.
      784   end.
      785   end procedure.
      786   procedure p-fmt-get-string-range :
      787   define input parameter p-in-string      as character        no-undo.
      788   define input parameter p-split-length   as integer          no-undo.
      789   define input parameter p-old-start-pos  as integer          no-undo.
      790   define output parameter p-start-pos     as integer          no-undo.
      791   define output parameter p-end-pos       as integer          no-undo.
      792       define variable v-init-string    as character    no-undo.
      793       define variable v-temp-char      as character    no-undo.
      794       define variable v-temp-pos       as integer      no-undo.
      795       define variable v-counter        as integer      no-undo.
      796   do
      797   on error undo, return error
      798   :
      799       assign
      800           p-start-pos   = p-old-start-pos
      801           v-init-string = substring( p-in-string, p-start-pos )
      802       no-error.
      803       if error-status :error
      804       or trim( v-init-string ) = "":U
      805       then do:
      806           assign
      807               p-end-pos = 0
      808           .
      809           undo, return .
      810       end.
      811       assign
      812           v-temp-char   = substring( v-init-string, 1, 1 )
      813       .
      814       do
      815       while trim( v-temp-char ) = "":U
      816       :
      817           assign
      818               p-start-pos     = p-start-pos + 1
      819               v-init-string   = substring( p-in-string, p-start-pos )
      820               v-temp-char     = substring( v-init-string, 1, 1 )
      821           .
      822       end.
      823       assign
      824           v-temp-pos  = p-split-length
      825           v-temp-char = substring( v-init-string, v-temp-pos, 1 )
      826           v-counter   = 0
      827       .
      828       search-word-end:
      829       do
      830       while trim( v-temp-char ) <> "":U
      831       :
      832           assign
      833               v-counter   = v-counter + 1
      834           .
      835           if v-counter > 20
      836           then do:
      837               assign
      838                   v-temp-pos  = p-split-length
      839               .
      840               leave search-word-end.
      841           end.
      842           assign
      843               v-temp-pos  = v-temp-pos - 1
      844               v-temp-char = substring( v-init-string, v-temp-pos, 1 )
      845           .
      846       end.
      847       assign
      848           p-end-pos = p-start-pos + v-temp-pos - 1
      849       .
      850   end.
      851   end procedure.
      852   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      853   procedure cur-time :
      854      define output parameter p-today as date      no-undo .
      855      define output parameter p-time  as integer   no-undo .
      856     do
      857     on error undo, return error
      858     :
      859       define variable v-date1 as date      no-undo .
      860       define variable v-date2 as date      no-undo .
      861       define variable v-time  as integer   no-undo .
      862       assign
      863         v-date1 = today
      864         v-time  = time
      865         v-date2 = today
      866       .
      867       if v-date1 <> v-date2
      868       then do:
      869         assign
      870           v-date1 = today
      871           v-time  = v-time
      872         .
      873       end.
      874       assign
      875         p-today = v-date1
      876         p-time  = v-time
      877       .
      878     end.
      879   end.
      880   function cur-time-date returns character
      881   :
      882     return string(today, '99/99/9999':U) .
      883   end.
      884   function cur-time-mjd returns decimal
      885   :
      886     define variable v-date as date      no-undo .
      887     define variable v-time as integer   no-undo .
      888     run cur-time in this-procedure
      889       (output v-date
      890       ,output v-time
      891       ) .
      892     return integer(v-date) - 2400002 + (v-time / 86400) .
      893   end.
      894   function cur-time-get-ending-index returns integer
      895   (input p-number as integer
      896   )
      897   :
      898     if p-number < 0
      899     or p-number = ?
      900     then do:
      901       return 1 .
      902     end.
      903     define variable v-rest as integer   no-undo .
      904     assign
      905       p-number = p-number modulo 100
      906     .
      907     if p-number < 20
      908     then do:
      909       assign
      910         v-rest = p-number
      911       .
      912     end.
      913     else do:
      914       assign
      915         v-rest = p-number modulo 10
      916       .
      917     end.
      918     case v-rest :
      919       when 1
      920       then do:
      921         return 2 .
      922       end.
      923       when 2 or
      924       when 3 or
      925       when 4
      926       then do:
      927         return 3 .
      928       end.
      929       otherwise do:
      930         return 1 .
      931       end.
      932     end case .
      933   end.
      934   procedure cur-time-mjd-to-date :
      935      define input  parameter i-mjd-diff as decimal no-undo.
      936      define output parameter o-Date     as date    no-undo.
      937      define output parameter o-Time     as integer no-undo.
      938      define variable v-day-number as integer   no-undo .
      939      if    i-mjd-diff < 0
      940         or i-mjd-diff = ?
      941      then do:
      942         return "?" .
      943      end.
      944      assign
      945         v-day-number = truncate(i-mjd-diff,0).
      946         o-Date = date(v-day-number + 2400002).
      947         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      948     .
      949   end.
      950   function cur-time-mjd-to-string returns character
      951   (input p-mjd-diff as decimal
      952   )
      953   :
      954     define variable v-day-number as integer   no-undo .
      955     define variable v-seconds    as integer   no-undo .
      956     define variable v-hour       as integer   no-undo .
      957     define variable v-min        as integer   no-undo .
      958     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      959     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      960     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      961     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      962     if p-mjd-diff < 0
      963     or p-mjd-diff = ?
      964     then do:
      965       return "?" .
      966     end.
      967     assign
      968       v-day-number = integer(truncate(p-mjd-diff,0))
      969       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      970     .
      971     if v-seconds > 86400
      972     then do:
      973       assign
      974         v-seconds = 86400 - 1
      975       .
      976     end.
      977     if v-seconds < 0
      978     then do:
      979       assign
      980         v-seconds = 0
      981       .
      982     end.
      983     assign
      984       v-hour = truncate(v-seconds / 3600, 0)
      985     .
      986     assign
      987       v-seconds = v-seconds modulo 3600
      988     .
      989     assign
      990       v-min = truncate(v-seconds / 60, 0)
      991     .
      992     assign
      993       v-seconds = v-seconds modulo 60
      994     .
      995     return
      996         (if v-day-number <> 0
      997           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      998           else ""
      999         )
     1000       + (if v-day-number <> 0 or v-hour <> 0
     1001           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1002           else ""
     1003         )
     1004       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1005           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1006           else ""
     1007         )
     1008       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1009       .
     1010   end.
     1011   function cur-time-string returns character
     1012   :
     1013     define variable v-date as date      no-undo .
     1014     define variable v-time as integer   no-undo .
     1015     run cur-time in this-procedure
     1016       (output v-date
     1017       ,output v-time
     1018       ) .
     1019     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1020   end.
     1021   function cur-time-string-sec returns character
     1022   :
     1023     define variable v-date as date      no-undo .
     1024     define variable v-time as integer   no-undo .
     1025     run cur-time in this-procedure
     1026       (output v-date
     1027       ,output v-time
     1028       ) .
     1029     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1030   end.
     1031   function cur-time-custom  returns character
     1032   (input p-prefix as character
     1033   ,input p-date-format as character
     1034   ,input p-delimiter as character
     1035   ,input p-time-format as character
     1036   ,input p-suffix as character
     1037   )
     1038   :
     1039     define variable v-date as date      no-undo .
     1040     define variable v-time as integer   no-undo .
     1041     run cur-time in this-procedure
     1042       (output v-date
     1043       ,output v-time
     1044       ) .
     1045     return
     1046       p-prefix
     1047       + string(v-date, p-date-format)
     1048       + p-delimiter
     1049       + string(v-time, p-time-format)
     1050       + p-suffix
     1051       .
     1052   end.
     1053   function cur-time-print  returns character
     1054   :
     1055     define variable v-date as date      no-undo .
     1056     define variable v-time as integer   no-undo .
     1057     run cur-time in this-procedure
     1058       (output v-date
     1059       ,output v-time
     1060       ) .
     1061     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1062   end.
     1063   function cur-time-datetime returns datetime
     1064   :
     1065     define variable v-char as character no-undo .
     1066     define variable v-datetime as datetime no-undo .
     1067     v-char = cur-time-string().
     1068     v-datetime = datetime(v-char).
     1069     return  v-datetime.
     1070   end.
     1071   function cur-time-string-msec returns character
     1072   :
     1073     define variable v-date as datetime  no-undo .
     1074     v-date = now.
     1075     return string(v-date) .
     1076   end.
     1077   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1078   procedure godendo-date-to-offset :
     1079     define input  parameter p-today  as date      no-undo .
     1080     define input  parameter p-date   as date      no-undo .
     1081     define output parameter p-offset as integer   no-undo .
     1082     do
     1083     on error undo, return error return-value
     1084     :
     1085       if p-date  = ?
     1086       or p-today = ?
     1087       then do:
     1088         assign
     1089           p-offset = ?
     1090         .
     1091       end.
     1092       else do:
     1093         assign
     1094           p-offset = p-date - p-today + 1
     1095         .
     1096       end.
     1097     end.
     1098   end procedure.
     1099   procedure godendo-offset-to-date :
     1100     define input  parameter p-today  as date      no-undo .
     1101     define input  parameter p-offset as integer   no-undo .
     1102     define output parameter p-date   as date      no-undo .
     1103     do
     1104     on error undo, return error return-value
     1105     :
     1106       if p-today  = ?
     1107       or p-offset = ?
     1108       then do:
     1109         assign
     1110           p-date = ?
     1111         .
     1112       end.
     1113       else do:
     1114         assign
     1115           p-date = p-offset + p-today - 1
     1116         .
     1117       end.
     1118     end.
     1119   end procedure.
