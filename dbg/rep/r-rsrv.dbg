      145   procedure create_obj-list :
      146      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      147      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      148      do
      149      on error undo, return error return-value
      150      :
      151         define buffer cli-obj for ub.clients .
      152         define variable p-var as integer no-undo .
      153         define buffer buf_obj-list for obj-list .
      154         find last buf_obj-list  use-index pi no-error .
      155         if available buf_obj-list
      156         then
      157            p-var = buf_obj-list.obj-id + 1.
      158         else
      159            p-var = 1.
      160         find first cli-obj where
      161                   cli-obj.obj-type = p-obj-type
      162               and cli-obj.obj-code = p-obj-code
      163         no-lock no-error.
      164         if available cli-obj
      165         then do:
      166            create buf_obj-list.
      167            assign
      168               buf_obj-list.obj-id   = p-var
      169               buf_obj-list.obj-code = cli-obj.obj-code
      170               buf_obj-list.obj-type = cli-obj.obj-type
      171               buf_obj-list.obj-name = cli-obj.obj-name
      172               buf_obj-list.db-num   = cli-obj.db-num
      173            .
      174         end.
      175      end.
      176   end.
