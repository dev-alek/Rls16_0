     1652   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1653   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1654     (output varoutvprbcl
     1655     )  .
     1656   if varoutvprbcl = "base":u then do:
     1657     assign
     1658           road-tax-base-salecl    =  (if parroad-tax = ? then 0 else parroad-tax * 1)
     1659       excise-base-salecl      =  (if parexcise   = ? then 0 else parexcise   * 1)
     1660     .
     1661   end.
     1662   else do:
     1663     assign
     1664           road-tax-base-salecl    =  (if parroad-tax = ? then 0 else parroad-tax / parbase-rate * parbase-scale)
     1665       excise-base-salecl      =  (if parexcise   = ? then 0 else parexcise   / parbase-rate * parbase-scale)
     1666     .
     1667   end.
     1668   if varoutvprbcl = "rubl":u then do:
     1669     assign
     1670           road-tax-rubl-salecl    = (if parroad-tax = ? then 0 else parroad-tax * 1)
     1671       excise-rubl-salecl      = (if parexcise   = ? then 0 else parexcise   * 1) .
     1672   end.
     1673   else do:
     1674     assign
     1675           road-tax-rubl-salecl    = (if parroad-tax = ? then 0 else parroad-tax * parbase-rate / parbase-scale)
     1676       excise-rubl-salecl      = (if parexcise   = ? then 0 else parexcise   * parbase-rate / parbase-scale) .
     1677   end.
     1678   assign
     1679     varis-cons-parts-havecl =  no.
     1680   assign
