     1114   PROCEDURE adm-update-record :
     1115       MESSAGE
     1116         "Object ":U THIS-PROCEDURE:FILE-NAME
     1117           "must have at least one Enabled Table to perform Update.":U
     1118             VIEW-AS ALERT-BOX ERROR.
     1119      RETURN.
     1120   END PROCEDURE.
     1121   PROCEDURE check-modified :
     1122   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1123   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1124   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1125   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1126     IF check-state = "check":U THEN
     1127     DO:
     1128       RUN get-link-handle IN adm-broker-hdl
     1129         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1130            OUTPUT group-target-list).
     1131       IF group-target-list NE "":U THEN
     1132       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1133         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1134         RUN check-modified IN curr-widget ('group-check':U).
     1135         IF RETURN-VALUE NE "":U THEN
     1136         DO:
     1137           RUN check-modified-message(RETURN-VALUE).
     1138           RETURN "":U.
     1139         END.
     1140       END.
     1141     END.
     1142     RETURN "":U.
     1143   END PROCEDURE.
     1144   PROCEDURE check-modified-message :
     1145     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1146        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1147           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1148        IF RETURN-VALUE = "YES":U THEN
     1149           RUN notify ('view,CONTAINER-SOURCE':U).
     1150        MESSAGE IF p-changed-table NE ? THEN
     1151           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1152           ELSE "Current values have been changed."
     1153           SKIP "  Do you wish to save those changes?"
     1154           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1155        IF ANS THEN
     1156        DO:
     1157           IF group-assign-target THEN
     1158             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1159           ELSE RUN dispatch('update-record':U).
     1160           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1161           DO:
     1162               MESSAGE "Changes to the previous record were not saved."
     1163                 VIEW-AS ALERT-BOX ERROR.
     1164               IF group-assign-target THEN
     1165                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1166               ELSE RUN dispatch ('cancel-record':U).
     1167           END.
     1168        END.
     1169        ELSE DO:
     1170          IF group-assign-target THEN
     1171             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1172          ELSE RUN dispatch('cancel-record':U).
     1173        END.
     1174        RETURN.
     1175   END PROCEDURE.
     1176   PROCEDURE get-rowid :
     1177       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1178       ASSIGN
     1179       p-table   =   adm-first-table.
     1180       RETURN.
     1181   END PROCEDURE.
     1182   PROCEDURE init-group-assign :
     1183       RUN request-attribute IN adm-broker-hdl
     1184         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1185       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1186         group-assign-target = yes.
     1187       ELSE group-assign-target = no.
     1188       RETURN.
     1189   END PROCEDURE.
     1190   PROCEDURE set-editors :
     1191       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1192       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1193       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1194       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1195       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1196       DO WHILE VALID-HANDLE (curr-widget):
     1197           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1198              curr-widget:HIDDEN = no THEN DO:
     1199             CASE p-field-setting:
     1200               WHEN "INITIALIZE":U THEN
     1201               DO:
     1202                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1203                     read-only-list +
     1204                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1205                        STRING(curr-widget).
     1206               END.
     1207               WHEN "DISABLE":U OR
     1208               WHEN "ENABLE":U THEN
     1209               DO:
     1210                   curr-widget:SENSITIVE = yes.
     1211                   RUN get-attribute ('Read-Only-Editors':U).
     1212                   IF RETURN-VALUE = ? OR
     1213                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1214                       curr-widget:READ-ONLY =
     1215                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1216               END.
     1217               WHEN "CLEAR":U THEN
     1218                   curr-widget:SCREEN-VALUE = "":U.
     1219             END CASE.
     1220           END.
     1221           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1222       END.
     1223       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1224         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1225           + '"':U).
     1226       RETURN.
     1227   END PROCEDURE.
     1228   PROCEDURE use-check-modified-all :
     1229    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1230     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1231     RETURN.
     1232   END PROCEDURE.
     1233   PROCEDURE use-create-on-add :
     1234   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1235      RETURN.
     1236   END PROCEDURE.
     1237   PROCEDURE use-initial-lock :
     1238     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1239     ASSIGN adm-initial-lock = p-attr-value.
     1240     RETURN.
     1241   END PROCEDURE.
     1242     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1243   ASSIGN
     1244          FRAME F-Main:SCROLLABLE       = FALSE
     1245          FRAME F-Main:HIDDEN           = TRUE.
     1246   if not this-procedure :persistent
     1247   then do:
     1248     message
     1249       vss-workfile vss-revision vss-description skip
     1250       "Ошибка при запуске процедуры" skip
     1251       "Данную процедуру следует запускать только с параметром persistent" skip
     1252       view-as alert-box error .
     1253     undo, return error .
     1254   end.
     1255   assign
     1256     parparentproc = my-handle
     1257   .
     1258   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1259     run mainmenu_getcntxt in parparentproc
     1260       (output v-cntxt-db-num
     1261       ,output v-cntxt-userid
     1262       ,output v-cntxt-level
     1263       ,output v-cntxt-host-code-obj
     1264       ,output v-cntxt-obj-type
     1265       ,output v-cntxt-obj-code
     1266       ,output v-cntxt-db-num-obj
     1267       ,output v-cntxt-is-admin
     1268       ) .
     1269   PROCEDURE adm-row-available :
     1270     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
     1271     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
     1272     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
     1273     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
     1274     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
     1275     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
     1276     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
     1277     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
     1278     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
     1279     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
     1280     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
     1281     IF adm-updating-record THEN RETURN.
     1282     RUN get-attribute ('FIELDS-ENABLED':U).
     1283     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
     1284     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
     1285         OUTPUT link-handle) NO-ERROR.
     1286     IF link-handle = "":U THEN
     1287         RETURN.
     1288     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
     1289     IF NUM-ENTRIES(link-handle) > 1 THEN
     1290         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
     1291             "encountered more than one RECORD-SOURCE.":U SKIP
     1292             "The first - ":U record-source-hdl:file-name " - will be used.":U
     1293                VIEW-AS ALERT-BOX ERROR.
     1294     RUN get-attribute ('Key-Name':U).
     1295     key-name = RETURN-VALUE.
     1296     IF key-name = "":U THEN key-name = ?.
     1297     IF key-name NE ? THEN DO:
     1298       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
     1299         NO-ERROR.
     1300       IF key-value NE ? THEN
     1301         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
     1302     END.
     1303   IF VALID-HANDLE (adm-object-hdl) THEN
     1304       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1305   RUN notify IN THIS-PROCEDURE ('row-available':U).
     1306   END PROCEDURE.
     1307   PROCEDURE disable_UI :
     1308     HIDE FRAME F-Main.
     1309     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1310   END PROCEDURE.
     1311   PROCEDURE local-initialize :
     1312     run dispatch in this-procedure ( input 'initialize':u ) .
     1313   END PROCEDURE.
     1314   PROCEDURE my-report :
     1315     if x-shift-start = ? or x-shift-end = ?
     1316       then assign x-shift-start = ?
     1317                   x-shift-end   = ? .
     1318     IF NOT CAN-FIND(FIRST obj-list) THEN DO:
     1319        message "Вы не выбрали объект." view-as alert-box.
     1320        return.
     1321     END.
     1322     FIND FIRST obj-list.
     1323     run rep/r-ptrlopbal.p
     1324       ( input my-handle
     1325       , input obj-list.obj-type
     1326       , input obj-list.obj-code
     1327       , input tog-with-tot-day
     1328       ).
     1329   END PROCEDURE.
     1330   PROCEDURE my-var :
     1331   define variable reportname as char initial "ОПЕРАТИВНЫЙ БАЛАНСОВЫЙ ОТЧЕТ ДВИЖЕНИЯ НЕФТЕПРОДУКТОВ" no-undo.
     1332   define variable reportheader as char no-undo.
     1333     assign frame F-Main
     1334       tog-with-tot-day
     1335       .
     1336   END PROCEDURE.
     1337   PROCEDURE send-records :
     1338   END PROCEDURE.
     1339   PROCEDURE state-changed :
     1340     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     1341     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     1342     CASE p-state:
     1343       WHEN 'update-begin':U THEN DO:
     1344           RUN dispatch('enable-fields':U).
     1345           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1346           DO:
     1347             RUN new-state('update-failed,TABLEIO-SOURCE':U).
     1348             RUN new-state('update-complete':U).
     1349           END.
     1350           ELSE RUN new-state ('update':U).
     1351       END.
     1352       WHEN 'update-complete':U THEN DO:
     1353           RUN new-state ('update-complete':U).
     1354       END.
     1355     END CASE.
     1356   END PROCEDURE.
