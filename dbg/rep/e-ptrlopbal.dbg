      711               when 'chkgdsfi':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Товарная строка чека - доп поля"     p-tooltip = "Товарная строка чека - доп поля "     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      712               when 'chkdocfi':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Чек - доп поля"     p-tooltip = "Чек - доп поля"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      713               when 'barcodfi':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Бар-код - доп поля"     p-tooltip = "Бар-код - доп поля"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      714                when 'UPD':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Настройки справочника Электронного документоборота"     p-tooltip = "Настройки справочника Электронного документоборота"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      715               when 'LK_RECEIPT':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Настройки справочника документов Вывода из оборота (ОСУ)"     p-tooltip = "Настройки справочника документов Вывода из оборота (ОСУ)"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      716         otherwise do:
      717           undo, return error "неизвестная настройка пользователя usr-flt" + " " + p-code .
      718         end.
      719       end CASE.
      720     end.
      721   end procedure.
      722   procedure uf-get :
      723     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      724     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
      725     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
      726     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
      727     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      728     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      729     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
      730     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
      731     do
      732     on error undo, return error
      733     :
      734       define buffer buf_usr-flt for ubflt.usr-flt .
      735       define variable v-use-List_     as logical   no-undo .
      736       define variable v-type-List_     as character no-undo .
      737       define variable v-format-List_   as character no-undo .
      738       define variable v-use-Naim      as logical   no-undo .
      739       define variable v-type-Naim      as character no-undo .
      740       define variable v-format-Naim    as character no-undo .
      741       define variable v-use-print-graft as logical   no-undo .
      742       define variable v-use-sort-gr     as logical   no-undo .
      743       define variable v-use-type-price  as logical   no-undo .
      744       define variable v-use-type-val    as logical   no-undo .
      745       define variable v-label          as character no-undo .
      746       define variable v-tooltip        as character no-undo .
      747       define variable v-user-can-edit  as logical   no-undo .
      748       define variable v-output-display as logical   no-undo .
      749       define variable v-other          as character no-undo .
      750       run uf-name in this-procedure
      751          (input  entry(1, p-code, chr(4))
      752         ,output v-use-List_
      753         ,output v-type-List_
      754         ,output v-format-List_
      755         ,output v-use-Naim
      756         ,output v-type-Naim
      757         ,output v-format-Naim
      758         ,output v-use-print-graft
      759         ,output v-use-sort-gr
      760         ,output v-use-type-price
      761         ,output v-use-type-val
      762         ,output v-label
      763         ,output v-tooltip
      764         ,output v-user-can-edit
      765         ,output v-output-display
      766         ,output v-other
      767         ) no-error .
      768       if error-status :error then do:
      769         undo, return error return-value .
      770       end.
      771       find first buf_usr-flt no-lock where
      772                  buf_usr-flt.Call-point     = p-code AND
      773                  buf_usr-flt.user-name       = p-user-name
      774         no-error .
      775       if avail buf_usr-flt then do:
      776         assign
      777         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
      778         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
      779         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
      780         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
      781         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
      782         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
      783         .
      784       end.
      785       else do:
      786         assign
      787         p-List_        = (if v-use-List_       then "":U                    else ?)
      788         p-Naim         = (if v-use-Naim        then "":U                    else ?)
      789         p-print-graft  = (if v-use-print-graft then no                      else ?)
      790         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
      791         p-type-price   = (if v-use-type-price  then no                      else ?)
      792         p-type-val     = (if v-use-List_       then no                      else ?)
      793         .
      794       end.
      795     end.
      796   end procedure.
      797   procedure uf-set :
      798     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      799     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
      800     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
      801     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
      802     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      803     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      804     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
      805     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
      806     do
      807     on error undo, return error
      808     :
      809       define buffer buf_usr-flt for ubflt.usr-flt .
      810       define variable v-use-List_     as logical   no-undo .
      811       define variable v-type-List_     as character no-undo .
      812       define variable v-format-List_   as character no-undo .
      813       define variable v-use-Naim      as logical   no-undo .
      814       define variable v-type-Naim      as character no-undo .
      815       define variable v-format-Naim    as character no-undo .
      816       define variable v-use-print-graft as logical   no-undo .
      817       define variable v-use-sort-gr   as logical   no-undo .
      818       define variable v-use-type-price as logical   no-undo .
      819       define variable v-use-type-val  as logical   no-undo .
      820       define variable v-tooltip        as character no-undo .
      821       define variable v-label          as character no-undo .
      822       define variable v-user-can-edit  as logical   no-undo .
      823       define variable v-output-display as logical   no-undo .
      824       define variable v-other          as character no-undo .
      825       run uf-name in this-procedure
      826         (input  entry(1, p-code, chr(4))
      827         ,output v-use-List_
      828         ,output v-type-List_
      829         ,output v-format-List_
      830         ,output v-use-Naim
      831         ,output v-type-Naim
      832         ,output v-format-Naim
      833         ,output v-use-print-graft
      834         ,output v-use-sort-gr
      835         ,output v-use-type-price
      836         ,output v-use-type-val
      837         ,output v-label
      838         ,output v-tooltip
      839         ,output v-user-can-edit
      840         ,output v-output-display
      841         ,output v-other
      842         ) no-error .
      843       if error-status :error then do:
      844         undo, return error return-value .
      845       end.
      846       find first buf_usr-flt where
      847                  buf_usr-flt.Call-point     = p-code AND
      848                  buf_usr-flt.user-name       = p-user-name
      849         no-error .
      850       if not avail buf_usr-flt then do:
      851           create buf_usr-flt .
      852           assign
      853           buf_usr-flt.call-point = p-code
      854           buf_usr-flt.user-name  = p-user-name
      855           .
      856       end.
      857       if avail buf_usr-flt then do:
      858        assign
      859        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
      860        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
      861        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
      862        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
      863        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
      864        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
      865       .
      866       release buf_usr-flt.
      867       end.
      868       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
      869     end.
      870   end procedure.
      871   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      872     define variable v-cntxt-db-num        as integer   no-undo .
      873     define variable v-cntxt-userid        as character no-undo .
      874     define variable v-cntxt-level         as character no-undo .
      875     define variable v-cntxt-host-code-obj as integer   no-undo .
      876     define variable v-cntxt-obj-type      as character no-undo .
      877     define variable v-cntxt-obj-code      as integer   no-undo .
      878     define variable v-cntxt-db-num-obj    as integer   no-undo .
      879     define variable v-cntxt-is-admin      as logical   no-undo .
      880   RUN set-attribute-list (
      881       'Keys-Accepted = "",
      882        Keys-Supplied = ""':U).
      883   DEFINE VARIABLE tog-with-tot-day AS LOGICAL INITIAL no
      884        LABEL "C итогами за сутки"
      885        VIEW-AS TOGGLE-BOX
      886        SIZE 22 BY .83 NO-UNDO.
      887   DEFINE FRAME F-Main
      888        tog-with-tot-day AT ROW 2.5 COL 3
      889       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      890            SIDE-LABELS NO-UNDERLINE THREE-D
      891            AT COL 1 ROW 1 SCROLLABLE
      892            BGCOLOR 8 .
      893   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      894   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      895   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      896   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      897   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      898   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      899   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      900   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      901         adm-object-hdl = FRAME F-Main:HANDLE.
      902   RUN ensure-broker.
      903   THIS-PROCEDURE:ADM-DATA =
      904        'ADM1.1~`':U +
      905        'SmartObject~`':U +
      906        '~`':U +
      907        'NO ~`':U +
      908        '~`':U +
      909        '~`':U +
      910        '~`':U +
      911        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      912           + "~`":U +
      913        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
      914        'Record-Source,Record-Target,TableIO-Target~`':U +
      915        '~`':U +
      916        '~`~`~`~`~`~`~`~`~`~`~`':U +
      917        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      918            THEN "^^":U
      919        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      920             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      921   PROCEDURE adm-apply-entry :
      922     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      923   END PROCEDURE.
      924   PROCEDURE adm-destroy :
      925    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      926   END PROCEDURE.
      927   PROCEDURE adm-disable :
      928       DISABLE tog-with-tot-day WITH FRAME F-Main.
      929       RUN dispatch ('disable-fields':U).
      930       RUN set-attribute-list ('ENABLED=no':U).
      931       RETURN.
      932   END PROCEDURE.
      933   PROCEDURE adm-edit-attribute-list :
      934         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
      935         RETURN.
      936   END PROCEDURE.
      937   PROCEDURE adm-enable :
      938       ENABLE UNLESS-HIDDEN tog-with-tot-day WITH FRAME F-Main.
      939       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      940       RUN set-attribute-list ('ENABLED=yes':U).
      941       RETURN.
      942   END PROCEDURE.
      943   PROCEDURE adm-exit :
      944        RUN notify ('exit':U).
      945     RETURN.
      946   END PROCEDURE.
      947   PROCEDURE adm-hide :
      948     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      949   END PROCEDURE.
      950   PROCEDURE adm-initialize :
      951     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      952   END PROCEDURE.
      953   PROCEDURE adm-show-errors :
      954       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      955       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      956           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      957       END.
      958       RETURN.
      959   END PROCEDURE.
      960   PROCEDURE adm-UIB-mode :
      961     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      962   END PROCEDURE.
      963   PROCEDURE adm-view :
      964     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      965   END PROCEDURE.
      966   PROCEDURE dispatch :
      967       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      968       RUN broker-dispatch IN adm-broker-hdl
      969           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      970       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      971   END PROCEDURE.
      972   PROCEDURE ensure-broker :
      973   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      974   IF RETURN-VALUE NE "ADM-Broker":U THEN
      975   DO:
      976       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      977       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      978   END.
      979   END PROCEDURE.
      980   PROCEDURE get-attribute :
      981     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      982     RUN broker-get-attribute IN adm-broker-hdl
      983         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      984     RETURN RETURN-VALUE.
      985   END PROCEDURE.
      986   PROCEDURE get-attribute-list :
      987     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      988     RUN broker-get-attribute-list IN adm-broker-hdl
      989         (INPUT THIS-PROCEDURE,
      990          INPUT ?,
      991          OUTPUT p-attr-list) NO-ERROR.
      992     RETURN.
      993   END PROCEDURE.
      994   PROCEDURE new-state :
      995     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      996     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      997     RETURN.
      998   END PROCEDURE.
      999   PROCEDURE notify :
     1000     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1001     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1002     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1003         RETURN "ADM-ERROR":U.
     1004     RETURN.
     1005   END PROCEDURE.
     1006   PROCEDURE set-attribute-list :
     1007     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1008     RUN ensure-broker.
     1009     RUN broker-set-attribute-list IN adm-broker-hdl
     1010         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1011     RETURN.
     1012   END PROCEDURE.
     1013   PROCEDURE set-position :
     1014       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1015       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1016       IF VALID-HANDLE(adm-object-hdl) THEN
     1017       DO:
     1018         ASSIGN adm-object-hdl:ROW    =   p-row
     1019                adm-object-hdl:COLUMN =   p-col.
     1020       END.
     1021       RETURN.
     1022   END PROCEDURE.
     1023   PROCEDURE adm-display-fields :
     1024       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
     1025       RETURN.
     1026   END PROCEDURE.
     1027   PROCEDURE adm-open-query :
     1028     RETURN.
     1029   END PROCEDURE.
     1030   PROCEDURE adm-row-changed :
     1031         IF VALID-HANDLE(adm-object-hdl) THEN
     1032           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1033         RUN notify ('row-available':U).
     1034         RETURN.
     1035   END PROCEDURE.
     1036   PROCEDURE reposition-query :
     1037       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
     1038       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
     1039       RETURN.
     1040   END PROCEDURE.
     1041     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
     1042     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
     1043     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
     1044     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
     1045     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
     1046     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
     1047     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
     1048     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
     1049     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1050     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
     1051     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1052     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
     1053     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
     1054     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
     1055     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
     1056     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
     1057     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
     1058     IF "":U = "":U THEN
     1059       RUN modify-list-attribute IN adm-broker-hdl
     1060         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
     1061     RUN use-create-on-add(?).
     1062   PROCEDURE adm-add-record :
     1063       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1064          "must have at least one Enabled Table to perform Add.":U
     1065          VIEW-AS ALERT-BOX ERROR.
     1066       RETURN.
     1067   END PROCEDURE.
     1068   PROCEDURE adm-assign-record :
     1069    MESSAGE
     1070          "Object ":U THIS-PROCEDURE:FILE-NAME
     1071            "must have at least one Enabled Table to perform Assign.":U
     1072              VIEW-AS ALERT-BOX ERROR.
     1073      RETURN.
     1074     END PROCEDURE.
     1075   PROCEDURE adm-assign-statement :
     1076     RETURN.
     1077   END PROCEDURE.
     1078   PROCEDURE adm-cancel-record :
     1079      RETURN.
     1080     END PROCEDURE.
     1081   PROCEDURE adm-copy-record :
