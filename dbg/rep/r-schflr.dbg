     4930       bfs_tt-allsum.other-cli-acc       =  - bf_tt-allsum.other-cli-acc.
     4931   end.
     4932   create bfpc_tt-allsum.
     4933   create bfspc_tt-allsum.
     4934   case cl_tt-clcparts.purch-code :
     4935   when 1           then do:
     4936     assign
     4937       bfpc_tt-allsum.sum-type  = 'сумма_по_выкупу':U
     4938       bfspc_tt-allsum.sum-type = 'сумма_по_выкупу_со_знаком':U.
     4939     buffer-copy bf_tt-allsum  except bf_tt-allsum.sum-type  to bfpc_tt-allsum.
     4940     buffer-copy bfs_tt-allsum except bfs_tt-allsum.sum-type to bfspc_tt-allsum.
     4941   end.
     4942   when 4    then do:
     4943     assign
     4944       bfpc_tt-allsum.sum-type  = 'сумма_по_старой_консигнации':U
     4945       bfspc_tt-allsum.sum-type = 'сумма_по_старой_консигнации_со_знаком':U.
     4946     buffer-copy bf_tt-allsum  except bf_tt-allsum.sum-type  to bfpc_tt-allsum.
     4947     buffer-copy bfs_tt-allsum except bfs_tt-allsum.sum-type to bfspc_tt-allsum.
     4948   end.
     4949   when 3 then do:
     4950     assign
     4951       bfpc_tt-allsum.sum-type  = 'сумма_по_ответственному_хранению':U
     4952       bfspc_tt-allsum.sum-type = 'сумма_по_ответственному_хранению_со_знаком':U.
     4953     buffer-copy bf_tt-allsum  except bf_tt-allsum.sum-type  to bfpc_tt-allsum.
     4954     buffer-copy bfs_tt-allsum except bfs_tt-allsum.sum-type to bfspc_tt-allsum.
     4955   end.
     4956   when 2 then do:
     4957     assign
     4958       bfpc_tt-allsum.sum-type  = 'сумма_по_консигнации_выгода':U
     4959       bfspc_tt-allsum.sum-type = 'сумма_по_консигнации_выгода_со_знаком':U.
     4960     assign
