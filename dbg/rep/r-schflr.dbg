     5993   output STREAM Out_Stream to value( string( session:temp-directory +
     5994                                        "rpt" + string( g#report-num ) ) )
     5995                                        page-size 62 .
     5996     find first t-doc where recid(t-doc)   = rec_id  no-lock no-error.
     5997     define variable v-sort-prod         as character         no-undo.
     5998     define variable v-sys-key as character no-undo .
     5999   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile:currsysk.i $ $Revision: $".
     6000   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run currsysk in g#library
     6001     (output v-sys-key
     6002     ) no-error .
     6003   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6004   empty temp-table thbjattr_thbj-attr.
     6005   run adm/shattri.p (
     6006      input "get":U
     6007     ,input ''
     6008     ,input 0
     6009     ,input 'prt-glob':U
     6010     ,input  ""
     6011     ,output v-value-character
     6012     ,output v-value-date
     6013     ,output v-value-decimal
     6014     ,output v-value-integer
     6015     ,output v-value-logical
     6016     ,output par-type
     6017     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     6018     ) no-error .
     6019     for each thbjattr_thbj-attr :
     6020         if thbjattr_thbj-attr.prop-code = 'sort-prd' then v-sort-prod = string( thbjattr_thbj-attr.property-value-logical) .
     6021     end.
     6022       if t-doc.obj-type = 'маг':U then do:
     6023         find first ub.shop no-lock where ub.shop.obj-code = t-doc.obj-code no-error .
     6024         if available ub.shop then
     6025           g#rsrv-time = ub.shop.rsrv-time
     6026         .
     6027       end.
     6028       else do:
     6029         find first ub.store no-lock where ub.store.obj-code = t-doc.obj-code no-error .
     6030           if available ub.store then
     6031             g#rsrv-time = ub.store.rsrv-time
     6032           .
     6033       end.
     6034     define variable p-form-name         as character init "schet"    no-undo.
     6035     define variable v-host-code         as integer              no-undo.
     6036   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6037   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     6038     (input  t-doc.obj-type
     6039     ,input  t-doc.obj-code
     6040     ,output v-host-code
     6041     )  .
     6042     run torgconf-read in this-procedure (input p-form-name, input v-host-code, input t-doc.obj-type, input t-doc.obj-code) no-error.
     6043     if error-status :error then do:
     6044       message
     6045         vss-workfile vss-revision vss-description skip "Ошибка чтения параметров печати формы." skip "Форма будет напечатана с параметрами по умолчанию."
     6046           skip return-value   skip trim(error-status :get-message(1))  trim(error-status :get-message(2)) trim(error-status :get-message(3))
     6047       view-as alert-box error.
     6048     end.
     6049     define variable v-curr-code as integer   no-undo .
     6050     if printRubl = yes then assign v-curr-code = 0 .
     6051     else do:
     6052   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6053   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     6054     (input  v-host-code
     6055     ,output v-curr-code
     6056     )  .
     6057     end.
     6058     run torgconf-get-self-param in this-procedure ( input t-doc.obj-type, input t-doc.obj-code, input v-curr-code) no-error.
     6059     if error-status :error then do:
     6060       message
     6061         vss-workfile vss-revision vss-description   skip "Ошибка чтения параметров объекта документа."  skip return-value
     6062         skip trim(error-status :get-message(1))   trim(error-status :get-message(2))  trim(error-status :get-message(3))
     6063       view-as alert-box warning.
     6064     end.
     6065     find first our_object  where our_object.obj-type   = t-doc.obj-type and our_object.obj-code  = t-doc.obj-code  no-lock.
     6066     find first our_host    where our_host.obj-type     = 'орг':U         and our_host.obj-code    = t-doc.host-code no-lock.
     6067     find first buf_firm    where buf_firm.firm-code    = our_host.obj-code no-lock.
     6068     find first buf_sysconf where buf_sysconf.host-code = buf_firm.firm-code  no-lock.
     6069     if v-torgconf-self-schet-exists then do:
     6070       PUT STREAM Out_Stream
     6071         space(9)  string ( "Поставщик: ИНН " + v-torgconf-self-host-inn + " , КПП " + v-torgconf-self-host-kpp + " " + v-torgconf-self-host-name ) format "X(100)" SKIP
     6072         space(9)  string ( "Адрес: " + v-torgconf-self-host-addres ) format "X(100)" SKIP
     6073         space(9)  string ( "Телефон, факс: " + v-torgconf-self-host-phone ) format "X(100)" SKIP
     6074         space(9)  string ( "Реквизиты банка: " + v-torgconf-self-bank-name  ) format "X(100)" SKIP
     6075         space(26) string ( "р/c " + v-torgconf-self-bank-r-schet ) format "X(100)" SKIP
     6076         space(26) string ( "БИК " + v-torgconf-self-bank-bik ) format "X(100)" SKIP
     6077         space(26) string ( "к/c " + v-torgconf-self-bank-c-schet ) format "X(100)" SKIP
     6078       .
     6079     end.
     6080     else do:
     6081       PUT STREAM Out_Stream
     6082         space(9)  string ( "Поставщик: ИНН " + v-torgconf-self-host-inn + " , КПП " + v-torgconf-self-host-kpp + " " + v-torgconf-self-host-name ) format "X(100)" SKIP
     6083         space(9)  string ( "Адрес: " + v-torgconf-self-host-addres ) format "X(100)" SKIP
     6084         space(9)  string ( "Телефон, факс: " + v-torgconf-self-host-phone ) format "X(100)" SKIP
     6085         space(9)  string ( "Реквизиты банка: "  ) format "X(100)" SKIP
     6086       .
     6087     end.
     6088     PUT STREAM Out_Stream " " SKIP .
     6089     FIND cli-obj WHERE cli-obj.obj-type = t-doc.cli-type AND cli-obj.obj-code = t-doc.cli-code NO-LOCK .
     6090     PUT STREAM Out_Stream   (  "С Ч Е Т       N " ) AT 32
     6091                          format "X(17)"  t-doc.doc-code format "X(10)" "  от  " t-doc.doc-date format "99.99.9999" SKIP .
     6092     PUT STREAM Out_Stream " " SKIP .
     6093     PUT STREAM Out_Stream SPACE(9) "Плательщик   : " + cli-obj.obj-name + "(" + string(cli-obj.obj-code) + ")" format "X(102)" SKIP .
     6094     Find ub.pay-type Where ub.pay-type.Obj-code = T-doc.Pay-code No-lock No-error.
     6095     Put Stream Out_Stream String( "вид оплаты : " + ( If Available ub.pay-type Then ub.pay-type.Obj-name Else "?" ) ) At 10 Format "X(60)" Skip .
     6096     If V-torgconf-outprim = No Then Do:
     6097       Put Stream Out_Stream  String( "примечание : " + ( If ( Not Can-do( 'факт':U, T-doc.Status_ ) Or Logres ) And Not ( T-doc.Ps Begins "@" ) Then  T-doc.Ps Else " " ) ) At 10 Format "X(100)" Skip .
     6098     End.
     6099     PUT STREAM Out_Stream SPACE(9) string("Срок оплаты счета: " + ( if g#rsrv-time = 0 then "2" else string(g#rsrv-time, ">>9") ) + " дней.") format "X(102)" SKIP .
     6100     if session:set-wait-state("compiler") then.
     6101     assign
     6102       Line = fill( "-", 232 )
     6103       Lines_Counter = 0
     6104     .
     6105     if v-torgconf-outnum = yes then assign  v-doc-code = fill( " ", 10 )  .
     6106     else                            assign  v-doc-code = t-doc.doc-code .
     6107     if v-torgconf-outdate = yes then assign v-doc-date-string = fill( " ", 10 ) .
     6108     else                             assign v-doc-date-string = string( t-doc.doc-date, "99/99/9999" )  .
     6109     define variable prn_NP as logical initial no no-undo .
     6110     if buf_sysconf.cash-pay = t-doc.pay-code then assign prn_NP = yes .
     6111       if not PrintRubl then form with frame val1 .
     6112       else                  form with frame rubl1 .
     6113       form header
     6114         Line format "X(119)" at 1 skip
     6115         "Продолжение - на следующей странице" at 30 skip
     6116         with frame Bottomframe width 232 page-bottom no-labels no-box .
     6117     view stream Out_stream frame Bottomframe .
     6118     if v-sort-prod = "yes" then do:
     6119       if sort-gr = yes then do:
     6120         if sort-name = yes then do:
     6121           for each buf_doc-line no-lock
     6122             where buf_doc-line.doc-code = t-doc.doc-code
     6123             , first buf_goods no-lock
     6124               where buf_goods.artic      = buf_doc-line.artic
     6125                 and buf_goods.prod-type  = buf_doc-line.prod-type
     6126                 and buf_goods.prod-code  = buf_doc-line.prod-code
     6127             break by buf_doc-line.prod-type by buf_doc-line.prod-code by buf_goods.grp-name  by buf_goods.gds-name
     6128           :
     6129             if  first-of( buf_doc-line.prod-code) then do:
     6130               run print-prod in this-procedure .
     6131             end.
     6132             if  first-of( buf_goods.grp-name) then do:
     6133               run print-grp in this-procedure .
     6134             end.
     6135             run print-line in this-procedure .
     6136           end.
     6137         end.
     6138         else do:
     6139           for each buf_doc-line
     6140             where buf_doc-line.doc-code = t-doc.doc-code
     6141             , first buf_goods no-lock
     6142               where buf_goods.artic      = buf_doc-line.artic
     6143                 and buf_goods.prod-type  = buf_doc-line.prod-type
     6144                 and buf_goods.prod-code  = buf_doc-line.prod-code
     6145             break by buf_doc-line.prod-type by buf_doc-line.prod-code by buf_goods.grp-name  by buf_doc-line.num-place
     6146           :
     6147             if  first-of( buf_doc-line.prod-code) then do:
     6148               run print-prod in this-procedure .
     6149             end.
     6150             if  first-of( buf_goods.grp-name) then do:
     6151               run print-grp in this-procedure .
     6152             end.
     6153             run print-line in this-procedure .
     6154           end.
     6155         end.
     6156       end.
     6157       else do:
     6158         if sort-name = yes then do:
     6159           for each buf_doc-line no-lock
     6160             where buf_doc-line.doc-code = t-doc.doc-code
     6161             , first buf_goods no-lock
     6162             where buf_goods.artic      = buf_doc-line.artic
     6163               and buf_goods.prod-type  = buf_doc-line.prod-type
     6164               and buf_goods.prod-code  = buf_doc-line.prod-code
     6165             break by buf_doc-line.prod-type by buf_doc-line.prod-code by buf_goods.gds-name
     6166           :
     6167             if  first-of( buf_doc-line.prod-code) then do:
     6168               run print-prod in this-procedure .
     6169             end.
     6170             run print-line in this-procedure .
     6171           end.
     6172         end.
     6173         else do:
     6174           for each buf_doc-line
     6175             where buf_doc-line.doc-code = t-doc.doc-code
     6176             , first buf_goods no-lock
     6177             where buf_goods.artic      = buf_doc-line.artic
     6178                 and buf_goods.prod-type  = buf_doc-line.prod-type
     6179                 and buf_goods.prod-code  = buf_doc-line.prod-code
     6180             break by buf_doc-line.prod-type by buf_doc-line.prod-code by buf_doc-line.num-place
     6181           :
     6182             if  first-of( buf_doc-line.prod-code) then do:
     6183               run print-prod in this-procedure .
     6184             end.
     6185             run print-line in this-procedure .
     6186           end.
     6187         end.
     6188       end.
     6189     end.
     6190     else do:
     6191       if sort-gr = yes then do:
     6192         if sort-name = yes then do:
     6193           for each buf_doc-line no-lock
     6194             where buf_doc-line.doc-code = t-doc.doc-code
     6195             , first buf_goods no-lock
     6196               where buf_goods.artic      = buf_doc-line.artic
     6197                 and buf_goods.prod-type  = buf_doc-line.prod-type
     6198                 and buf_goods.prod-code  = buf_doc-line.prod-code
     6199             break by buf_goods.grp-name  by buf_goods.gds-name
     6200           :
     6201             if  first-of( buf_goods.grp-name) then do:
     6202               run print-grp in this-procedure .
     6203             end.
     6204             run print-line in this-procedure .
     6205           end.
     6206         end.
     6207         else do:
     6208           for each buf_doc-line
     6209             where buf_doc-line.doc-code = t-doc.doc-code
     6210             , first buf_goods no-lock
     6211               where buf_goods.artic      = buf_doc-line.artic
     6212                 and buf_goods.prod-type  = buf_doc-line.prod-type
     6213                 and buf_goods.prod-code  = buf_doc-line.prod-code
     6214             break by buf_goods.grp-name  by buf_doc-line.num-place
     6215           :
     6216             if  first-of( buf_goods.grp-name) then do:
     6217               run print-grp in this-procedure .
     6218             end.
     6219             run print-line in this-procedure .
     6220           end.
     6221         end.
     6222       end.
     6223       else do:
     6224         if sort-name = yes then do:
     6225           for each buf_doc-line no-lock
     6226             where buf_doc-line.doc-code = t-doc.doc-code
     6227             , first buf_goods no-lock
     6228             where buf_goods.artic      = buf_doc-line.artic
     6229               and buf_goods.prod-type  = buf_doc-line.prod-type
     6230               and buf_goods.prod-code  = buf_doc-line.prod-code
     6231             break by buf_goods.gds-name
     6232           :
     6233             run print-line in this-procedure .
     6234           end.
     6235         end.
     6236         else do:
     6237           for each buf_doc-line
     6238             where buf_doc-line.doc-code = t-doc.doc-code
     6239             , first buf_goods no-lock
     6240             where buf_goods.artic      = buf_doc-line.artic
     6241                 and buf_goods.prod-type  = buf_doc-line.prod-type
     6242                 and buf_goods.prod-code  = buf_doc-line.prod-code
     6243             break by buf_doc-line.num-place
     6244           :
     6245             run print-line in this-procedure .
     6246           end.
     6247         end.
     6248       end.
     6249     end.
     6250     if prn_NP then do:
     6251       put stream out_stream Line format "X(134)" skip .
     6252       if PrintRubl then do:
     6253         display stream out_stream
     6254           sym1 sym2 sym3 sym4 "ИТОГО: " @ gds_name sym5 sym6 sym7 all-qnty @ qnty sym8 all-stoim @ stoim sym9 all-SLT-sum @ SLT-sum sym10
     6255         with frame rubl.
     6256         down stream out_stream with frame rubl .
     6257       end.
     6258       else do:
     6259         display stream out_stream
     6260           sym1 sym2 sym3 sym4 "ИТОГО: " @ gds_name sym5 sym6 sym7 all-qnty @ qnty sym8 all-stoim @ stoim sym9 all-SLT-sum @ SLT-sum sym10
     6261         with frame val.
     6262         down stream out_stream with frame val .
     6263       end.
     6264       put stream out_stream Line format "X(134)" skip .
     6265     end.
     6266     else do:
     6267       put stream out_stream Line format "X(119)" skip .
     6268       if PrintRubl then do:
     6269         display stream out_stream
     6270           sym1 sym2 sym3 sym4 "ИТОГО: " @ gds_name sym5 sym6 sym7 all-qnty @ qnty sym8 all-stoim @ stoim sym10
     6271         with frame rubl1.
     6272         down stream out_stream with frame rubl1 .
     6273       end.
     6274       else do:
     6275         display stream out_stream
     6276           sym1 sym2 sym3 sym4 "ИТОГО: " @ gds_name sym5 sym6 sym7 all-qnty @ qnty sym8 all-stoim @ stoim sym10
     6277         with frame val1.
     6278         down stream out_stream with frame val1 .
     6279       end.
     6280       put stream out_stream Line format "X(119)" skip .
     6281     end.
     6282     if line-counter( Out_stream ) + 8 > page-size( Out_stream ) then page stream Out_stream .
     6283       put stream Out_stream
     6284             space(5) "Всего " + trim(string(v-kol-n)) + " наименований на сумму: " format "x(30)"
     6285             space(2) all-stoim  format "->>>,>>>,>>>,>>9.99"
     6286             space(2) ( if not PrintRubl then base-type else "РУБ" )  format "x(4)" skip .
     6287       if not t-doc.internal  then do:
     6288           put stream Out_stream
     6289             space(5) "Скидка " +  string( string( t-doc.discnt-pc, "->>9.99" ) + "%" ) +
     6290             " на сумму :" format "x(30)"
     6291             space(2) ( if not PrintRubl then t-doc.tot-calc else t-doc.discnt-rubl )  format "->>>,>>>,>>>,>>9.99"
     6292             space(2) ( if not PrintRubl then base-type      else "РУБ" )  format "x(4)" skip .
     6293           all-stoim = all-stoim - ( if not PrintRubl then t-doc.tot-calc else t-doc.discnt-rubl ) .
     6294        end.
     6295       put stream Out_stream
     6296         space(5) "Итого к оплате :" format "x(30)"
     6297         space(2) all-stoim  format "->>>,>>>,>>>,>>9.99"
     6298         space(2) ( if not PrintRubl then base-type else "РУБ" )  format "x(4)" skip .
     6299       if not PrintRubl
     6300       then do:
     6301          run rep/wp.p
     6302            (input parparentproc
     6303            ,input all-stoim
     6304            ,output s1
     6305            ,output s2
     6306            ) .
     6307       end.
     6308       else do:
     6309          run rep/wp-rub.p
     6310            (input all-stoim
     6311            ,output s1
     6312            ,output s2
     6313            ) .
     6314       end.
     6315       put stream Out_stream skip space(5)  caps(s1) format "x(126)" skip .
     6316       put stream Out_stream space(5)  "В том числе: " skip .
     6317         if PrintRubl then do:
     6318           for each temp-nalog :
     6319             put stream Out_stream space(15) string( "НДС " + string(temp-nalog.vat-prc) + "% : " + string( temp-nalog.vat-sum , "->>>,>>>,>>9.99" ) + " " + "РУБ" ) format "x(35)"
     6320                                "от суммы "  string( temp-nalog.sum , "->>>,>>>,>>9.99" ) + " " + "РУБ"   format "x(20)"   skip .
     6321           end.
     6322         end.
     6323         else do:
     6324          for each temp-nalog :
     6325             put stream Out_stream space(15) string( "НДС " + string(temp-nalog.vat-prc) + "% : "  + string( temp-nalog.vat-sum , "->>>,>>>,>>9.99" ) + " " + base-type) format "x(35)"
     6326                               "от суммы "  (string( temp-nalog.sum , "->>>,>>>,>>9.99" ) + " " + base-type )  format "x(20)" skip .
     6327          end.
     6328         end.
     6329       put stream Out_stream  skip(2)
     6330         "Руководитель предприятия: ___________________ / " buf_firm.director      format "X(20)"  " /"   skip(1)
     6331         "Главный бухгалтер:        __________________ /"   buf_sysconf.snr-accnt  format "X(20)"  " /" skip .
     6332     hide stream Out_stream frame Bottomframe .
     6333     output stream Out_stream close.
     6334     if session:set-wait-state("") then.
     6335   if g#quest-print = false
     6336   then do:
     6337     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
     6338                                         7, (if 4 >= 8 then 2 else 0), 0, 0,
     6339                                         OUTPUT g#log ).
     6340   end.
     6341   else do:
     6342     os-command silent
     6343       value( "COPY /b " +
     6344         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
     6345         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
     6346         string( session:temp-directory) +  "$" + string( g#report-num )
     6347                 ) .
     6348     os-command silent
     6349       value( "COPY /b " +
     6350         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
     6351         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
     6352         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
     6353                 ) .
     6354   end.
     6355   end.
     6356   procedure Print-prod :
     6357     do on error undo, return error return-value :
     6358       find first buf_clients where buf_clients.obj-type = buf_goods.prod-type and buf_clients.obj-code = buf_goods.prod-code no-lock .
     6359       if prn_NP then do:
     6360         if not printrubl then do:
     6361           display stream out_stream sym1 "Производитель -" @ buf_goods.artic buf_clients.obj-name @ gds_name sym10 with frame val .
     6362           down stream out_stream 1 with frame val .
     6363           underline stream out_stream buf_goods.artic gds_name with frame val .
     6364         end.
     6365         else do:
     6366           display stream out_stream sym1 "Производитель -" @ buf_goods.artic buf_clients.obj-name @ gds_name sym10 with frame rubl .
     6367           down stream out_stream 1 with frame rubl .
     6368           underline stream out_stream buf_goods.artic gds_name with frame rubl .
     6369         end.
     6370       end.
     6371       else do:
     6372         if not printrubl then do:
     6373           display stream out_stream sym1 "Производитель -" @ buf_goods.artic buf_clients.obj-name @ gds_name sym10 with frame val1 .
     6374           down stream out_stream 1 with frame val1 .
     6375           underline stream out_stream buf_goods.artic gds_name with frame val1 .
     6376         end.
     6377         else do:
     6378           display stream out_stream sym1 "Производитель -" @ buf_goods.artic buf_clients.obj-name @ gds_name sym10 with frame rubl1 .
     6379           down stream out_stream 1 with frame rubl1 .
     6380           underline stream out_stream buf_goods.artic gds_name with frame rubl1 .
     6381         end.
     6382       end.
     6383     end.
     6384   end procedure.
     6385   procedure print-grp :
     6386     do on error undo, return error return-value :
     6387       if prn_NP then do:
     6388         if not printrubl then do:
     6389           display stream out_stream sym1 "Группа -" @ buf_goods.artic buf_goods.grp-name @ gds_name sym10 with frame val .
     6390           down stream out_stream 1 with frame val .
     6391           underline stream out_stream buf_goods.artic gds_name with frame val .
     6392         end.
     6393         else do:
     6394           display stream out_stream sym1 "Группа -" @ buf_goods.artic buf_goods.grp-name @ gds_name sym10 with frame rubl .
     6395           down stream out_stream 1 with frame rubl .
     6396           underline stream out_stream buf_goods.artic gds_name with frame rubl .
     6397         end.
     6398       end.
     6399       else do:
     6400         if not printrubl then do:
     6401           display stream out_stream sym1 "Группа -" @ buf_goods.artic buf_goods.grp-name @ gds_name sym10 with frame val1 .
     6402           down stream out_stream 1 with frame val1 .
     6403           underline stream out_stream buf_goods.artic gds_name with frame val1 .
     6404         end.
     6405         else do:
     6406           display stream out_stream sym1 "Группа -" @ buf_goods.artic buf_goods.grp-name @ gds_name sym10 with frame rubl1 .
     6407           down stream out_stream 1 with frame rubl1 .
     6408           underline stream out_stream buf_goods.artic gds_name with frame rubl1 .
     6409         end.
     6410       end.
     6411     end.
     6412   end procedure.
     6413   procedure print-line :
     6414     do on error undo, return error return-value :
     6415     v-kol-n = v-kol-n + 1 .
     6416       if prn_NP then do:
     6417         if PrintRubl then do:
     6418   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     6419     (input  buf_goods.gds-code
     6420     ,input  ?
     6421     ,output b-code
     6422     ) no-error .
     6423       if error-status :error then do:
     6424         message vss-workfile vss-revision vss-description skip "Ошибка при определении бар-кода товара" skip  "Код товара" buf_goods.gds-code skip
     6425         view-as alert-box error .
     6426       end.
     6427   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6428   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
     6429     (input  buf_goods.artic
     6430     ,input  buf_goods.prod-type
     6431     ,input  buf_goods.prod-code
     6432     ,output v-root-node
     6433     )  .
     6434   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtat in g#library
     6435     (input  v-root-node
     6436     ,input  'empty-scale=request'
     6437     ,output empty-scale
     6438     )  .
     6439       run clcprtsl_calc-line in this-procedure (input recid (buf_doc-line)).
     6440       find first tt-allsum-line where tt-allsum-line.sum-type = 'основная_сумма':U no-error .
     6441       if not available tt-allsum-line then do:
     6442            message
     6443           "Не рассчитаны строки в процедуре  clcprtsl_calc-line  для строки документа "
     6444           buf_doc-line.line-num skip
     6445           "Артикул : "buf_doc-line.artic  skip
     6446           view-as alert-box error .
     6447           return error return-value .
     6448       end.
     6449       if CostPrice then do:
     6450         if PrintRubl then do:
     6451           assign
     6452              stoim = tt-allsum-line.sum-dsc-rubl-acc + tt-allsum-line.dsc-rubl-acc
     6453              stoim-d = tt-allsum-line.sum-dsc-rubl-acc
     6454              SLT-sum = tt-allsum-line.slt-rubl-acc
     6455              VAT-sum = tt-allsum-line.vat-rubl-acc
     6456              .
     6457         end.
     6458         else do:
     6459           assign
     6460             stoim = tt-allsum-line.sum-dsc-base-acc  + tt-allsum-line.dsc-base-acc
     6461             stoim-d = tt-allsum-line.sum-dsc-base-acc
     6462             SLT-sum = tt-allsum-line.slt-base-acc
     6463             VAT-sum = tt-allsum-line.vat-base-acc
     6464             .
     6465         end.
     6466       end.
     6467       else do:
     6468         if PrintRubl then do:
     6469           assign
     6470             stoim = tt-allsum-line.sum-dsc-rubl-doc + tt-allsum-line.dsc-rubl-doc
     6471             stoim-d = tt-allsum-line.sum-dsc-rubl-doc
     6472             SLT-sum = tt-allsum-line.slt-rubl-doc
     6473             VAT-sum = tt-allsum-line.vat-rubl-buyer-doc .
     6474         end.
     6475         else do:
     6476           assign
     6477              stoim = tt-allsum-line.sum-dsc-base-doc + tt-allsum-line.dsc-base-doc
     6478              stoim-d = tt-allsum-line.sum-dsc-base-doc
     6479              SLT-sum = tt-allsum-line.slt-base-doc
     6480              VAT-sum = tt-allsum-line.vat-base-buyer-doc .
     6481         end.
     6482       end.
     6483       if g#gds-engl then assign gds_name = buf_goods.engl-name.
     6484       else               assign gds_name = buf_goods.gds-name.
     6485       assign
     6486         Lines_Counter = Lines_Counter + 1
     6487         tb-code = string(b-code)
     6488         qnty    = buf_doc-line.fact-qnty
     6489         Price   = stoim / qnty
     6490         all-qnty    = all-qnty    + qnty
     6491         all-stoim   = all-stoim   + stoim
     6492         all-SLT-sum = all-SLT-sum + SLT-sum
     6493         all-VAT-sum = all-VAT-sum + VAT-sum
     6494         v-vat-pc = round(buf_doc-line.vat-pc,1)
     6495         v-slt-pc = round(buf_doc-line.slt-pc,1)
     6496       .
     6497       find first temp-nalog where temp-nalog.vat-prc = v-vat-pc and temp-nalog.slt-prc = v-slt-pc no-error .
     6498       if not available temp-nalog then do:
     6499         create temp-nalog .
     6500         assign
     6501           temp-nalog.vat-prc = v-vat-pc
     6502           temp-nalog.slt-prc = v-slt-pc
     6503         .
     6504       end.
     6505       assign
     6506         temp-nalog.vat-sum = temp-nalog.vat-sum + VAT-sum
     6507         temp-nalog.sum     = temp-nalog.sum     + stoim-d
     6508         temp-nalog.slt-sum = temp-nalog.slt-sum + SLT-sum
     6509       .
     6510       if empty-scale = no and PrintScale = yes then do:
     6511         display stream out_stream
     6512           sym1  Lines_Counter sym2 tb-code sym3 buf_goods.artic sym4 gds_name sym5 buf_goods.unit-base sym6 sym7 sym8 sym10
     6513         with frame rubl.
     6514         display stream out_stream    with frame rubl.
     6515         down stream out_stream with frame rubl .
     6516         for each buf_gds-dtl no-lock
     6517           where buf_gds-dtl.doc-code  = buf_doc-line.doc-code
     6518             and buf_gds-dtl.artic     = buf_doc-line.artic
     6519             and buf_gds-dtl.prod-type = buf_doc-line.prod-type
     6520             and buf_gds-dtl.prod-code = buf_doc-line.prod-code
     6521           :
     6522   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     6523     (input  buf_goods.gds-code
     6524     ,input  buf_gds-dtl.prt-code
     6525     ,output b-code
     6526     ) no-error .
     6527           if error-status :error then do:
     6528             message vss-workfile vss-revision vss-description skip "Ошибка при определении бар-кода признака" skip  "Код товара" buf_goods.gds-code skip  "Код признака" buf_gds-dtl.prt-code skip
     6529             view-as alert-box error .
     6530           end.
     6531           find first ub.gds-prt where ub.gds-prt.node-code  = buf_gds-dtl.prt-code no-lock no-error .
     6532           if not CostPrice then do:
     6533             if PrintRubl then assign Price = buf_gds-dtl.price-rubl .
     6534             else              assign Price = buf_gds-dtl.price-base .
     6535           end.
     6536           display stream out_stream
     6537             sym1  sym2 string(b-code) @ tb-code sym3 sym4 ('  /'+ ub.gds-prt.f-name)  @  gds_name  sym5 sym6
     6538             Price sym7   buf_gds-dtl.fact-qnty @ qnty  sym8 (buf_gds-dtl.fact-qnty * Price ) @ stoim  sym10
     6539           with frame rubl.
     6540           display stream out_stream    with frame rubl.
     6541           down stream out_stream with frame rubl .
     6542         end.
     6543       end.
     6544       else do:
     6545         display stream out_stream
     6546           sym1 Lines_Counter sym2 tb-code sym3 buf_goods.artic sym4 gds_name sym5 buf_goods.unit-base sym6  Price sym7 qnty sym8 stoim sym10
     6547         with frame rubl.
     6548         display stream out_stream    with frame rubl.
     6549         down stream out_stream with frame rubl .
     6550       end.
     6551        end.
     6552         else do:
     6553   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     6554     (input  buf_goods.gds-code
     6555     ,input  ?
     6556     ,output b-code
     6557     ) no-error .
     6558       if error-status :error then do:
     6559         message vss-workfile vss-revision vss-description skip "Ошибка при определении бар-кода товара" skip  "Код товара" buf_goods.gds-code skip
     6560         view-as alert-box error .
     6561       end.
     6562   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6563   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
     6564     (input  buf_goods.artic
     6565     ,input  buf_goods.prod-type
     6566     ,input  buf_goods.prod-code
     6567     ,output v-root-node
     6568     )  .
     6569   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtat in g#library
     6570     (input  v-root-node
     6571     ,input  'empty-scale=request'
     6572     ,output empty-scale
