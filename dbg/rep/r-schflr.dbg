     3476         where buf_wth-doc.doc-code = p-doc-code
     3477         no-error.
     3478         if available buf_wth-doc
     3479            then do:
     3480   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3481   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3482     (input  buf_wth-doc.obj-type
     3483     ,input  buf_wth-doc.obj-code
     3484     ,output v-host-code
     3485     )  .
     3486            end.
     3487         if v-torgconf-outogr = "no_print"
     3488            then do:
     3489               assign
     3490                  v-torgconf-ogr-name = ""
     3491                  v-torgconf-ogr-post = ""
     3492               .
     3493            end.
     3494         if v-torgconf-outogr  = "ruk_firm"
     3495               then do:
     3496               find first buf_sysconf no-lock
     3497               where buf_sysconf.host-code = v-host-code
     3498               no-error.
     3499               if available buf_sysconf
     3500               then do:
     3501                  assign
     3502                     v-torgconf-ogr-post = buf_sysconf.head-position
     3503                  .
     3504               end.
     3505               find first buf_clients no-lock
     3506                  where buf_clients.obj-type = 'орг':U
     3507                  and buf_clients.obj-code = v-host-code
     3508               .
     3509               find first buf_firm no-lock
     3510                  where buf_firm.firm-code = buf_clients.obj-code
     3511               .
     3512               assign
     3513                  v-torgconf-ogr-name = buf_firm.director
     3514               .
     3515            end.
     3516            if v-torgconf-outogr = "dir_obj"
     3517               then do:
     3518               find first buf_wth-doc no-lock
     3519               where buf_wth-doc.doc-code = p-doc-code
     3520               no-error.
     3521                  find first buf_shop no-lock
     3522                  where buf_shop.obj-code = buf_wth-doc.obj-code
     3523                  .
     3524                  assign
     3525                     v-torgconf-ogr-name = buf_shop.director
     3526                     v-torgconf-ogr-post = "Директор"
     3527                  .
     3528               end.
     3529         if v-torgconf-outogr = "manag_doc"
     3530            then do:
     3531               find first buf_wth-doc no-lock
     3532               where buf_wth-doc.doc-code = p-doc-code
     3533               no-error.
     3534               if available buf_wth-doc
     3535               then do:
     3536                  run rep/get-psn.p
     3537                  (input buf_wth-doc.deliver
     3538                  ,output v-torgconf-ogr-name
     3539                  ) .
     3540               end.
     3541               find first buf_person no-lock
     3542               where buf_person.psn-code = buf_wth-doc.deliver
     3543               no-error.
     3544               if available buf_person
     3545               then do:
     3546                  v-torgconf-ogr-post = buf_person.position.
     3547               end.
     3548               if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     3549               if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     3550            end.
     3551      end.
     3552   end.
     3553   end procedure.
     3554   procedure torgconf-get-outogr-param:
     3555       define input parameter p-form-name  as character    no-undo.
     3556       define input parameter p-host-code  as integer      no-undo.
     3557       define input parameter p-obj-type   as character    no-undo.
     3558       define input parameter p-obj-code   as integer      no-undo.
     3559       define input parameter p-doc-code   as character      no-undo.
     3560       define buffer buf_firm          for ub.firm .
     3561       define buffer buf_clients       for ub.clients .
     3562       define buffer buf_sysconf       for ub.sysconf .
     3563       define buffer buf_shop          for ub.shop .
     3564       define buffer buf_store         for ub.store .
     3565       define buffer buf_person        for ub.person .
     3566       define buffer buf_trn-doc       for ub.trn-doc .
     3567       define buffer buf_wth-doc       for ub.wth-doc .
     3568      if  p-form-name <> 'wthtrg12':U
     3569      and p-form-name <> 'wthfct':U
     3570      and p-form-name <> 'wthm11':U
     3571      then do:
     3572       find first buf_trn-doc no-lock
     3573       where buf_trn-doc.doc-code = p-doc-code
     3574       no-error.
     3575       if v-torgconf-outogr = "no_print"
     3576         then do:
     3577            assign
     3578               v-torgconf-ogr-name = ""
     3579               v-torgconf-ogr-post = ""
     3580            .
     3581         end.
     3582      if v-torgconf-outogr  = "ruk_firm"
     3583            then do:
     3584            find first buf_sysconf no-lock
     3585            where buf_sysconf.host-code = p-host-code
     3586            no-error.
     3587            if available buf_sysconf
     3588            then do:
     3589               assign
     3590                  v-torgconf-ogr-post = buf_sysconf.head-position
     3591               .
     3592            end.
     3593            find first buf_clients no-lock
     3594                where buf_clients.obj-type = 'орг':U
     3595                and buf_clients.obj-code = p-host-code
     3596            .
     3597            find first buf_firm no-lock
     3598                where buf_firm.firm-code = buf_clients.obj-code
     3599            .
     3600            assign
     3601                v-torgconf-ogr-name = buf_firm.director
     3602            .
     3603         end.
     3604         if v-torgconf-outogr = "dir_obj"
     3605            then do:
     3606            find first buf_trn-doc no-lock
     3607            where buf_trn-doc.doc-code = p-doc-code
     3608            no-error.
     3609               CASE buf_trn-doc.obj-type:
     3610               WHEN 'маг':U
     3611               THEN DO:
     3612                  find first buf_shop no-lock
     3613                  where buf_shop.obj-code = buf_trn-doc.obj-code
     3614                  .
     3615                  assign
     3616                     v-torgconf-ogr-name = buf_shop.director
     3617                     v-torgconf-ogr-post = "Директор"
     3618                  .
     3619               END.
     3620               WHEN 'скл':U
     3621               THEN DO:
     3622                  find first buf_store no-lock
     3623                  where buf_store.obj-code = buf_trn-doc.obj-code
     3624                  .
     3625                  assign
     3626                     v-torgconf-ogr-name = buf_store.store-boss
     3627                     v-torgconf-ogr-post = "Директор"
     3628                  .
     3629               END.
     3630               OTHERWISE DO:
     3631                  assign
     3632                     v-torgconf-ogr-name = "":U
     3633                     v-torgconf-ogr-post = "":U
     3634                  .
     3635               END.
     3636               END CASE.
     3637            end.
     3638      if v-torgconf-outogr = "manag_doc"
     3639         then do:
     3640            find first buf_trn-doc no-lock
     3641            where buf_trn-doc.doc-code = p-doc-code
     3642            no-error.
     3643            if available buf_trn-doc
     3644            then do:
     3645               run rep/get-psn.p
     3646               (input buf_trn-doc.boss
     3647               ,output v-torgconf-ogr-name
     3648               ) .
     3649            end.
     3650            find first buf_person no-lock
     3651            where buf_person.psn-code = buf_trn-doc.boss
     3652            no-error.
     3653            if available buf_person
     3654            then do:
     3655               v-torgconf-ogr-post = buf_person.position.
     3656            end.
     3657            if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     3658            if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     3659         end.
     3660      end.
     3661      else do:
     3662      find first buf_wth-doc no-lock
     3663         where buf_wth-doc.doc-code = p-doc-code
     3664         no-error.
     3665         if v-torgconf-outogr = "no_print"
     3666            then do:
     3667               assign
     3668                  v-torgconf-ogr-name = ""
     3669                  v-torgconf-ogr-post = ""
     3670               .
     3671            end.
     3672         if v-torgconf-outogr  = "ruk_firm"
     3673               then do:
     3674               find first buf_sysconf no-lock
     3675               where buf_sysconf.host-code = p-host-code
     3676               no-error.
     3677               if available buf_sysconf
     3678               then do:
     3679                  assign
     3680                     v-torgconf-ogr-post = buf_sysconf.head-position
     3681                  .
     3682               end.
     3683               find first buf_clients no-lock
     3684                  where buf_clients.obj-type = 'орг':U
     3685                  and buf_clients.obj-code = p-host-code
     3686               .
     3687               find first buf_firm no-lock
     3688                  where buf_firm.firm-code = buf_clients.obj-code
     3689               .
     3690               assign
     3691                  v-torgconf-ogr-name = buf_firm.director
     3692               .
     3693            end.
     3694            if v-torgconf-outogr = "dir_obj"
     3695               then do:
     3696               find first buf_wth-doc no-lock
     3697               where buf_wth-doc.doc-code = p-doc-code
     3698               no-error.
     3699                  find first buf_shop no-lock
     3700                  where buf_shop.obj-code = buf_wth-doc.obj-code
     3701                  .
     3702                  assign
     3703                     v-torgconf-ogr-name = buf_shop.director
     3704                     v-torgconf-ogr-post = "Директор"
     3705                  .
     3706               end.
     3707         if v-torgconf-outogr = "manag_doc"
     3708            then do:
     3709               find first buf_wth-doc no-lock
     3710               where buf_wth-doc.doc-code = p-doc-code
     3711               no-error.
     3712               if available buf_wth-doc
     3713               then do:
     3714                  run rep/get-psn.p
     3715                  (input buf_wth-doc.deliver
     3716                  ,output v-torgconf-ogr-name
     3717                  ) .
     3718               end.
     3719               find first buf_person no-lock
     3720               where buf_person.psn-code = buf_wth-doc.deliver
     3721               no-error.
     3722               if available buf_person
     3723               then do:
     3724                  v-torgconf-ogr-post = buf_person.position.
     3725               end.
     3726               if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     3727               if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     3728            end.
     3729      end.
     3730   end.
     3731   procedure torgconf-get-reason  :
     3732   define input parameter  p-doc-code       as character        no-undo.
     3733   define input parameter  p-reason-code    as integer          no-undo .
     3734   define input parameter  p-doc-type       as character        no-undo.
     3735       if p-reason-code > 0
     3736       then do:
     3737           define buffer buf_trn-reason for ub.trn-reason.
     3738           find first buf_trn-reason no-lock where buf_trn-reason.reason-code = p-reason-code no-error .
     3739           if available buf_trn-reason then assign v-torgconf-reason =  buf_trn-reason.reason-name .
     3740       end.
     3741       else do:
     3742           if p-doc-type = 'при':U
     3743           then  do:
     3744               define variable v-attr-type     as character    no-undo.
     3745               define variable v-attr-value    as character    no-undo.
     3746               run gbl/trdcat-v.p (input p-doc-code,input 'nids':U,output v-attr-value,output v-attr-type) .
     3747               assign v-torgconf-reason = v-attr-value .
     3748               run gbl/trdcat-v.p (input p-doc-code,input 'dids':U,output v-attr-value,output v-attr-type) .
     3749               assign v-torgconf-reason = v-torgconf-reason + " от " + v-attr-value .
     3750           end.
     3751       end.
     3752   end procedure.
