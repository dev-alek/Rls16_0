     4916       bfs_tt-allsum.slt-base-acc        =  - bf_tt-allsum.slt-base-acc
     4917       bfs_tt-allsum.slt-rubl-acc        =  - bf_tt-allsum.slt-rubl-acc
     4918       bfs_tt-allsum.slt-cli-acc         =  - bf_tt-allsum.slt-cli-acc
     4919       bfs_tt-allsum.road-tax-base-acc   =  - bf_tt-allsum.road-tax-base-acc
     4920       bfs_tt-allsum.road-tax-rubl-acc   =  - bf_tt-allsum.road-tax-rubl-acc
