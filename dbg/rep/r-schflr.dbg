     1647   procedure torgconf-get-sup-param :
     1648   define input parameter p-obj-type           as character        no-undo.
     1649   define input parameter p-obj-code           as integer          no-undo.
     1650   define input parameter p-curr-code          as integer          no-undo.
     1651       define variable v-host-code    as integer      no-undo.
     1652       define variable v-par-type     as character    no-undo.
     1653   do
     1654   on error undo, return error
     1655   :
     1656       assign
     1657          v-torgconf-sup-host-code = v-host-code
     1658       .
     1659       if v-torgconf-sup-host-code = 0
     1660       then do:
     1661           assign
     1662               v-torgconf-sup-host-name           = "":U
     1663               v-torgconf-sup-host-addres         = "":U
     1664               v-torgconf-sup-host-post-addres    = "":U
     1665               v-torgconf-sup-host-phone          = "":U
     1666               v-torgconf-sup-host-inn            = "":U
     1667               v-torgconf-sup-host-kpp            = "":U
     1668               v-torgconf-sup-host-okpo           = "":U
     1669               v-torgconf-sup-host-egrip-date     = "":U
     1670               v-torgconf-sup-host-egrip-num      = "":U
     1671           .
     1672       end.
     1673       else do:
     1674           run fmtcli-get-client in this-procedure (
     1675                 input 'орг':U
     1676               , input v-torgconf-sup-host-code
     1677           ).
     1678           assign
     1679               v-torgconf-sup-host-name        = v-fmtcli-name
     1680               v-torgconf-sup-host-engl-name   = v-fmtcli-engl-name
     1681               v-torgconf-sup-host-addres      = v-fmtcli-full-addres
     1682               v-torgconf-sup-host-post-addres = v-fmtcli-post-addres
     1683               v-torgconf-sup-host-phone       = v-fmtcli-phone
     1684               v-torgconf-sup-host-inn         = v-fmtcli-inn
     1685               v-torgconf-sup-host-kpp         = v-fmtcli-kpp
     1686               v-torgconf-sup-host-okpo        = v-fmtcli-okpo
     1687           .
     1688           run gbl/clntat-v.p (
     1689                 input 'орг':U
     1690               , input v-torgconf-sup-host-code
     1691               , input 'egrip-date':U
     1692               , output v-torgconf-sup-host-egrip-date
     1693               , output v-par-type
     1694           ).
     1695           run gbl/clntat-v.p (
     1696                 input 'орг':U
     1697               , input v-torgconf-sup-host-code
     1698               , input 'egrip-num':U
     1699               , output v-torgconf-sup-host-egrip-num
     1700               , output v-par-type
     1701           ).
     1702           run fmtcli-get-bank in this-procedure (
     1703                 input v-host-code
     1704               , input 'орг':U
     1705               , input v-torgconf-sup-host-code
     1706               , input p-curr-code
     1707           ).
     1708       end.
     1709       assign
     1710           v-torgconf-sup-schet-exists = v-fmtcli-schet-exists
     1711           v-torgconf-sup-bank-exists  = v-fmtcli-bank-exists
     1712           v-torgconf-sup-bank-r-schet = v-fmtcli-bank-r-schet
     1713           v-torgconf-sup-bank-c-schet = v-fmtcli-bank-c-schet
     1714           v-torgconf-sup-bank-bik     = v-fmtcli-bank-bik
     1715           v-torgconf-sup-bank-name    = v-fmtcli-bank-name
     1716           v-torgconf-sup-bank-addres  = v-fmtcli-bank-addres
     1717           v-torgconf-sup-bank-city    = v-fmtcli-bank-city
     1718       .
     1719       assign
     1720           v-torgconf-sup-obj-type = p-obj-type
     1721           v-torgconf-sup-obj-code = p-obj-code
     1722       .
     1723       if trim(p-obj-type) <> ""
     1724       and p-obj-code <> 0
     1725       then do:
     1726       run fmtcli-get-client in this-procedure (
     1727             input p-obj-type
     1728           , input p-obj-code
     1729       ).
     1730       assign
     1731           v-torgconf-sup-obj-name        = v-fmtcli-name
     1732           v-torgconf-sup-obj-engl-name   = v-fmtcli-engl-name
     1733           v-torgconf-sup-obj-addres      = v-fmtcli-full-addres
     1734           v-torgconf-temp-post-addres    = v-fmtcli-post-addres
     1735           v-torgconf-sup-obj-phone       = v-fmtcli-phone
     1736           v-torgconf-sup-obj-inn         = v-fmtcli-inn
     1737           v-torgconf-sup-obj-okpo        = v-fmtcli-okpo
     1738       .
     1739      end.
     1740      end.
     1741   end procedure.
     1742   procedure torgconf-get-cli-param :
     1743   define input parameter p-host-obj-code      as integer          no-undo.
     1744   define input parameter p-obj-type           as character        no-undo.
     1745   define input parameter p-obj-code           as integer          no-undo.
     1746   define input parameter p-curr-code          as integer          no-undo.
     1747       define variable v-host-code    as integer      no-undo.
     1748   do
     1749   on error undo, return error
     1750   :
     1751       assign
     1752           v-torgconf-cli-type = p-obj-type
     1753           v-torgconf-cli-code = p-obj-code
     1754       .
     1755       run fmtcli-get-client in this-procedure (
     1756             input p-obj-type
     1757           , input p-obj-code
     1758       ).
     1759       assign
     1760           v-torgconf-cli-name         = trim( v-fmtcli-name          )
     1761           v-torgconf-cli-engl-name    = trim( v-fmtcli-engl-name          )
     1762           v-torgconf-cli-addres       = trim( v-fmtcli-full-addres   )
     1763           v-torgconf-cli-post-addres  = trim( v-fmtcli-post-addres   )
     1764           v-torgconf-cli-phone        = trim( v-fmtcli-phone         )
     1765           v-torgconf-cli-inn          = trim( v-fmtcli-inn           )
     1766           v-torgconf-cli-kpp          = trim( v-fmtcli-kpp           )
     1767           v-torgconf-cli-okpo         = trim( v-fmtcli-okpo          )
     1768       .
     1769      run fmtcli-get-bank in this-procedure (
     1770             input p-host-obj-code
     1771           , input p-obj-type
     1772           , input p-obj-code
     1773           , input p-curr-code
     1774       ).
     1775       assign
     1776           v-torgconf-cli-schet-exists = v-fmtcli-schet-exists
     1777           v-torgconf-cli-bank-exists  = v-fmtcli-bank-exists
     1778           v-torgconf-cli-bank-r-schet = v-fmtcli-bank-r-schet
     1779           v-torgconf-cli-bank-c-schet = v-fmtcli-bank-c-schet
     1780           v-torgconf-cli-bank-bik     = v-fmtcli-bank-bik
     1781           v-torgconf-cli-bank-name    = v-fmtcli-bank-name
     1782           v-torgconf-cli-bank-addres  = v-fmtcli-bank-addres
     1783           v-torgconf-cli-bank-city    = v-fmtcli-bank-city
     1784       .
     1785   end.
     1786   end procedure.
     1787   procedure torgconf-get-ship-param :
     1788   define input parameter p-host-obj-code      as integer          no-undo.
     1789   define input parameter p-obj-type           as character        no-undo.
     1790   define input parameter p-obj-code           as integer          no-undo.
     1791   define input parameter p-curr-code          as integer          no-undo.
     1792       define variable v-host-code    as integer      no-undo.
     1793   do
     1794   on error undo, return error
     1795   :
     1796       assign
     1797           v-torgconf-ship-type = p-obj-type
     1798           v-torgconf-ship-code = p-obj-code
     1799       .
     1800       if trim(p-obj-type) = ""
     1801       and p-obj-code = 0
     1802       then do:
     1803       assign
     1804           v-torgconf-ship-name         = "":U
     1805           v-torgconf-ship-addres       = "":U
     1806           v-torgconf-ship-post-addres  = "":U
     1807           v-torgconf-ship-phone        = "":U
     1808           v-torgconf-ship-inn          = "":U
     1809           v-torgconf-ship-kpp          = "":U
     1810           v-torgconf-ship-okpo         = "":U
     1811       .
     1812       end.
     1813       else do:
     1814       run fmtcli-get-client in this-procedure (
     1815             input p-obj-type
     1816           , input p-obj-code
     1817       ).
     1818       assign
     1819           v-torgconf-ship-name         = trim( v-fmtcli-name          )
     1820           v-torgconf-ship-engl-name    = trim( v-fmtcli-engl-name          )
     1821           v-torgconf-ship-addres       = trim( v-fmtcli-full-addres   )
     1822           v-torgconf-ship-post-addres  = trim( v-fmtcli-post-addres   )
     1823           v-torgconf-ship-phone        = trim( v-fmtcli-phone         )
     1824           v-torgconf-ship-inn          = trim( v-fmtcli-inn           )
     1825           v-torgconf-ship-kpp          = trim( v-fmtcli-kpp           )
     1826           v-torgconf-ship-okpo         = trim( v-fmtcli-okpo          )
     1827       .
     1828       end.
     1829           run fmtcli-get-bank in this-procedure (
     1830             input p-host-obj-code
     1831           , input p-obj-type
     1832           , input p-obj-code
     1833           , input p-curr-code
     1834       ).
     1835       assign
     1836           v-torgconf-ship-schet-exists = v-fmtcli-schet-exists
     1837           v-torgconf-ship-bank-exists  = v-fmtcli-bank-exists
     1838           v-torgconf-ship-bank-r-schet = v-fmtcli-bank-r-schet
     1839           v-torgconf-ship-bank-c-schet = v-fmtcli-bank-c-schet
     1840           v-torgconf-ship-bank-bik     = v-fmtcli-bank-bik
     1841           v-torgconf-ship-bank-name    = v-fmtcli-bank-name
     1842           v-torgconf-ship-bank-addres  = v-fmtcli-bank-addres
     1843           v-torgconf-ship-bank-city    = v-fmtcli-bank-city
     1844       .
     1845   end.
     1846   end procedure.
     1847   procedure torgconf-get-holdfirm-code :
     1848   define input parameter p-obj-type   as character        no-undo.
     1849   define input parameter p-obj-code   as integer          no-undo.
     1850   define output parameter p-firm-code as integer          no-undo.
     1851       define variable v-firm-code-str     as character    no-undo.
     1852       define variable v-par-type          as character    no-undo.
     1853       define buffer buf_clients       for ub.clients.
     1854   do
     1855   for buf_clients
     1856   on error undo, return error
     1857   :
     1858       run gbl/clntat-v.p (
     1859             input p-obj-type
     1860           , input p-obj-code
     1861           , input 'holdfirm-code':U
     1862           , output v-firm-code-str
     1863           , output v-par-type
     1864       ).
     1865       assign
     1866           p-firm-code = integer( v-firm-code-str )
     1867       no-error.
     1868       if error-status :error
     1869       then do:
     1870           message
     1871               "Неверно задан код фирмы для печати накладных."
     1872           view-as alert-box warning.
     1873           assign
     1874               p-firm-code = 0
     1875           .
     1876       end.
     1877       else do:
     1878           find first buf_clients no-lock
     1879                where buf_clients.obj-type = 'орг':U
     1880                  and buf_clients.obj-code = p-firm-code
     1881           no-error.
     1882           if not available buf_clients
     1883           then do:
     1884               message
     1885                   "Включен параметр 'Список печатных форм, для которых должна быть задана фирма для печати накладных' (outhold)" skip
     1886                   "Не найдена фирма по заданному коду фирмы для печати накладных."
     1887               view-as alert-box warning.
     1888               assign
     1889                   p-firm-code = 0
     1890               .
     1891           end.
     1892       end.
     1893   end.
     1894   end procedure.
     1895   procedure torgconf-get-post-head:
     1896   define input  parameter p-obj-type             as character        no-undo.
     1897   define input  parameter p-obj-code             as integer          no-undo.
     1898   define output parameter p-torgconf-post-head   as character        no-undo.
     1899      define variable v-host-code         as integer      no-undo.
     1900      define buffer buf_sysconf     for ub.sysconf.
     1901        assign
     1902         p-torgconf-post-head  = ""
     1903        .
     1904   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1905   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1906     (input  p-obj-type
     1907     ,input  p-obj-code
     1908     ,output v-host-code
     1909     )  .
     1910      find first buf_sysconf no-lock
     1911      where buf_sysconf.host-code = v-host-code
     1912      no-error.
     1913      if available buf_sysconf
     1914      then do:
     1915         assign
     1916            p-torgconf-post-head = buf_sysconf.head-position
     1917         .
     1918      end.
     1919   end procedure.
     1920   procedure torgconf-get-storekeeper:
     1921   define input  parameter p-wrkr                   as integer          no-undo.
     1922   define output parameter p-torgconf-wrkr-name     as character        no-undo.
     1923   define output parameter p-torgconf-post          as character        no-undo.
     1924      define buffer buf_sysconf     for ub.sysconf.
     1925      define buffer buf_person      for ub.person.
     1926      define buffer buf_shop        for ub.shop .
     1927      define buffer buf_store       for ub.store .
     1928      if v-torgconf-outC = "no_print"
     1929      then do:
     1930         assign p-torgconf-post = ""
     1931                p-torgconf-wrkr-name = ""
     1932                .
     1933      end.
     1934      if v-torgconf-outC = "clad_doc"
     1935      then do:
     1936         run rep/get-psn.p
     1937               (input  p-wrkr
     1938               ,output p-torgconf-wrkr-name
     1939               ) .
     1940         find first buf_person no-lock
     1941         where buf_person.psn-code = p-wrkr
     1942         no-error.
     1943         if available buf_person
     1944         then do:
     1945           p-torgconf-post = buf_person.position.
     1946         end.
     1947         if p-torgconf-post = "?":U then p-torgconf-post = "".
     1948         if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     1949      end.
     1950      if v-torgconf-outC = "clad_obj"
     1951      then do:
     1952         CASE v-torgconf-self-obj-type:
     1953         WHEN 'маг':U
     1954         THEN DO:
     1955            find first buf_shop no-lock
     1956            where buf_shop.obj-code = v-torgconf-self-obj-code
     1957            .
     1958            assign
     1959               p-torgconf-wrkr-name = buf_shop.store-man
     1960               p-torgconf-post = ""
     1961            .
     1962            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     1963         END.
     1964         WHEN 'скл':U
     1965         THEN DO:
     1966            find first buf_store no-lock
     1967            where buf_store.obj-code = v-torgconf-self-obj-code
     1968            .
     1969            assign
     1970               p-torgconf-wrkr-name = buf_store.store-man
     1971               p-torgconf-post = ""
     1972            .
     1973            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     1974         END.
     1975         OTHERWISE DO:
     1976            assign
     1977               p-torgconf-post = "":U
     1978               p-torgconf-wrkr-name = "":U
     1979            .
     1980         END.
     1981         END CASE.
     1982      end.
     1983    end procedure.
     1984   procedure torgconf-get-form-header :
     1985   define input parameter p-for-inverse    as logical          no-undo.
     1986   define input parameter p-doc-code       as character        no-undo.
     1987   define input parameter p-print-doc      as logical          no-undo.
     1988   define input parameter p-doc-date       as date             no-undo.
     1989   define input parameter p-fact-date      as date             no-undo.
     1990   define input parameter p-doc-type       as character        no-undo.
     1991   define input parameter p-status_        as character        no-undo.
     1992   define input parameter p-reverse        as logical          no-undo.
     1993   define input parameter p-sf-par         as logical          no-undo.
     1994       define variable v-attr-type         as character    no-undo.
     1995       define variable v-doc-code-standard as logical      no-undo.
     1996       define variable v-doc-date-standard as logical      no-undo.
     1997       define variable v-par-consignee-addres  as character    no-undo.
     1998       define variable v-host-code         as integer      no-undo.
     1999       define variable v-dcode-attr        as character    no-undo.
     2000       define variable v-ddate-attr        as character    no-undo.
     2001       define variable v-doc-date          as character    no-undo.
     2002       define variable v-doc-code          as character    no-undo.
     2003       define variable v-par-type          as character    no-undo.
     2004       define variable v-attr              as character    no-undo.
     2005       define buffer buf_firm          for ub.firm .
     2006       define buffer buf_clients       for ub.clients .
     2007       define buffer buf_sysconf       for ub.sysconf .
     2008       define buffer buf_shop          for ub.shop .
     2009       define buffer buf_store         for ub.store .
     2010       define buffer buf_person        for ub.person .
     2011       define buffer buf_trn-doc       for ub.trn-doc .
     2012       define buffer buf_wth-doc       for ub.wth-doc .
     2013       do
     2014   for buf_firm
     2015     , buf_clients
     2016     , buf_sysconf
     2017     , buf_shop
     2018     , buf_trn-doc
     2019     , buf_person
     2020     , buf_wth-doc
     2021   on error undo, return error
     2022   :
     2023       if p-doc-type = 'при':U
     2024       or p-doc-type = 'возврат':U
     2025       then do:
     2026           assign
     2027               v-torgconf-supplier         = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     2028                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     2029               v-torgconf-suppi            = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     2030                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     2031               v-torgconf-saler            = substitute( "&1&2&3&4&5", v-torgconf-self-host-name, ( if v-torgconf-self-host-addres = "":U then "":U else ", " ),
     2032                                             v-torgconf-self-host-addres, ( if v-torgconf-self-host-phone = "":U then "":U else ", " ),v-torgconf-self-host-phone )
     2033               v-torgconf-consignee        = substitute( "&1&2&3&4&5", v-torgconf-sup-host-name, ( if v-torgconf-sup-host-addres = "":U then "":U else ", " ),
     2034                                             v-torgconf-sup-host-addres, ( if v-torgconf-sup-host-phone = "":U then "":U else ", " ), v-torgconf-sup-host-phone  )
     2035               v-torgconf-supplier-okpo    = v-torgconf-cli-okpo
     2036               v-torgconf-saler-okpo       = v-torgconf-self-host-okpo
     2037               v-torgconf-consignee-okpo   = v-torgconf-sup-host-okpo
     2038               v-torgconf-supplier-code    = substitute( "&1", v-torgconf-cli-code         )
     2039               v-torgconf-supplier-type    = v-torgconf-cli-type
     2040               v-torgconf-saler-code       = substitute( "&1", v-torgconf-self-host-code   )
     2041               v-torgconf-saler-type       = v-torgconf-self-host-type
     2042               v-torgconf-consignee-code   = substitute( "&1", v-torgconf-sup-host-code   )
     2043               v-torgconf-consignee-type   = v-torgconf-sup-host-type
     2044               v-torgconf-supplier-name    = substitute( "&1", v-torgconf-cli-name         )
     2045               v-torgconf-saler-name       = substitute( "&1", v-torgconf-self-host-name   )
     2046               v-torgconf-consignee-name   = substitute( "&1", v-torgconf-sup-host-name   )
     2047               v-torgconf-supplier-addr    = substitute( "&1", v-torgconf-cli-addres       )
     2048               v-torgconf-saler-addr       = substitute( "&1", v-torgconf-self-host-addres )
     2049               v-torgconf-consignee-addr   = substitute( "&1", v-torgconf-sup-host-addres )
     2050               v-torgconf-supplier-inn     = substitute( "&1", v-torgconf-cli-inn          )
     2051               v-torgconf-supplier-engl-name     = substitute( "&1", v-torgconf-cli-engl-name          )
     2052               v-torgconf-saler-inn        = substitute( "&1", v-torgconf-self-host-inn    )
     2053               v-torgconf-consignee-inn    = substitute( "&1", v-torgconf-sup-host-inn    )
     2054               v-torgconf-supplier-kpp     = substitute( "&1", v-torgconf-cli-kpp          )
     2055               v-torgconf-saler-kpp        = substitute( "&1", v-torgconf-self-host-kpp    )
     2056               v-torgconf-consignee-kpp    = substitute( "&1", v-torgconf-sup-host-kpp    )
     2057           .
     2058           if v-torgconf-cli-schet-exists = yes
     2059           AND v-form-name                  = "torg12":U
     2060           then do:
     2061               assign
     2062                   v-torgconf-supplier = v-torgconf-supplier
     2063                       + substitute( ", р/с &1 к/с &2"
     2064                                   , v-torgconf-cli-bank-r-schet
     2065                                   , v-torgconf-cli-bank-c-schet
     2066                                   )
     2067                   v-torgconf-suppi = v-torgconf-supplier
     2068                       + substitute( ", р/с &1 к/с &2"
     2069                                   , v-torgconf-cli-bank-r-schet
     2070                                   , v-torgconf-cli-bank-c-schet
     2071                                   )
     2072               .
     2073               if v-torgconf-cli-bank-exists = yes
     2074               then do:
     2075                   assign
     2076                       v-torgconf-supplier = v-torgconf-supplier
     2077                           + substitute( " БИК &1 в &2 &3"
     2078                                       , v-torgconf-cli-bank-bik
     2079                                       , v-torgconf-cli-bank-name
     2080                                       ,(if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     2081                                       )
     2082                      v-torgconf-suppi = v-torgconf-supplier
     2083                           + substitute( " БИК &1 в &2 &3"
     2084                                       , v-torgconf-cli-bank-bik
     2085                                       , v-torgconf-cli-bank-name
     2086                                       ,(if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     2087                                       )
     2088                   .
     2089               end.
     2090           end.
     2091           if v-torgconf-self-schet-exists = yes
     2092           AND v-form-name                  = "torg12":U
     2093           then do:
     2094               assign
     2095                   v-torgconf-saler = v-torgconf-saler
     2096                       + substitute( ", р/с &1 к/с &2"
     2097                                   , v-torgconf-self-bank-r-schet
     2098                                   , v-torgconf-self-bank-c-schet
     2099                                   )
     2100               .
     2101               if v-torgconf-self-bank-exists = yes
     2102               then do:
     2103                   assign
     2104                       v-torgconf-saler = v-torgconf-saler
     2105                           + substitute( " БИК &1 в &2 &3"
     2106                                       , v-torgconf-self-bank-bik
     2107                                       , v-torgconf-self-bank-name
     2108                                       , v-torgconf-self-bank-addres
     2109                                       )
     2110                   .
     2111               end.
     2112           end.
     2113           if v-torgconf-sup-schet-exists = yes
     2114           AND v-form-name                  = "torg12":U
     2115           then do:
     2116               assign
     2117                   v-torgconf-consignee = v-torgconf-consignee
     2118                       + substitute( ", р/с &1 к/с &2"
     2119                                   , v-torgconf-sup-bank-r-schet
     2120                                   , v-torgconf-sup-bank-c-schet
     2121                                   )
     2122               .
     2123             if v-torgconf-sup-bank-exists = yes
     2124              then do:
     2125                assign
