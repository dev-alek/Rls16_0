     5204   procedure clcprtsl_calc-line :
     5205   define input  parameter parrec-line as recid no-undo.
     5206   define variable v-tax-date         as   date                     no-undo.
     5207   define variable v-vat-pc           like ub.doc-line.vat-pc       no-undo.
     5208   define variable varr-b             as   character                no-undo.
     5209   define variable varr-btype         as   character                no-undo.
     5210   define variable varcur-base        like ub.gds-dtl.price-base    no-undo.
     5211   define variable varcur-road-tax    like ub.doc-line.road-tax     no-undo.
     5212   define variable varcur-excise      like ub.doc-line.excise       no-undo.
     5213   define variable varcur-vat-pc      like ub.doc-line.vat-pc       no-undo.
     5214   define variable varcur-cons-vat-pc like ub.doc-line.cons-vat-pc  no-undo.
     5215   define variable varcur-slt-pc      like ub.doc-line.slt-pc       no-undo.
     5216   define variable varcur-fact-qnty   like ub.gds-dtl.fact-qnty     no-undo.
     5217   define variable varb-code          like ub.bar-code.b-code       no-undo.
     5218   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     5219   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     5220   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     5221   define variable varexcise          like ub.price-list.excise     no-undo.
     5222   define variable varlastcur-base        like ub.gds-dtl.price-base no-undo.
     5223   define variable varlastcur-road-tax    like ub.gds-dtl.price-base no-undo.
     5224   define variable varlastcur-excise      like ub.gds-dtl.price-base     no-undo.
     5225   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     5226   define variable v-varsum           as decimal                  no-undo.
     5227   define variable varprice-salef as decimal   no-undo .
     5228   define buffer bf_trn-doc             for ub.trn-doc.
     5229   define buffer bf_doc-line            for ub.doc-line.
     5230   define buffer bf_gds-dtl             for ub.gds-dtl.
     5231   define buffer bf_goods               for ub.goods.
     5232   define buffer bf_parts               for ub.parts.
     5233   define buffer bf_sysconf             for ub.sysconf.
     5234   define buffer bf_tt-allsum-line      for tt-allsum-line.
     5235   define buffer bfs_tt-allsum-line     for tt-allsum-line.
     5236   define buffer bfo_tt-allsum-line     for tt-allsum-line.
     5237   define buffer bfos_tt-allsum-line    for tt-allsum-line.
     5238   define buffer buf_parts        for ub.parts.
     5239   v-calcbypart = no.
     5240   do on error undo, return error return-value :
     5241   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     5242   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     5243     (output varr-b
     5244     )  .
     5245     find first bf_doc-line where recid (bf_doc-line) = parrec-line no-lock.
     5246     find first bf_trn-doc where bf_trn-doc.doc-code = bf_doc-line.doc-code no-lock.
     5247     find first bf_goods where bf_goods.artic     = bf_doc-line.artic     and
     5248                               bf_goods.prod-type = bf_doc-line.prod-type and
     5249                               bf_goods.prod-code = bf_doc-line.prod-code no-lock.
     5250     if bf_trn-doc.fact-date <> ?        then do:
     5251       assign v-tax-date = bf_trn-doc.fact-date.
     5252     end.
     5253     else do:
     5254       assign v-tax-date = ?.
     5255     end.
     5256   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5257   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     5258     (input  bf_goods.gds-code
     5259     ,input  '1':U
     5260     ,input  v-tax-date
     5261     ,input  bf_trn-doc.host-code
     5262     ,input  bf_trn-doc.obj-type
     5263     ,input  bf_trn-doc.obj-code
     5264     ,output v-vat-pc
     5265     ) no-error .
     5266     if error-status :error
     5267     or v-vat-pc = ? then do:
     5268        return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     5269     end.
     5270     if bf_goods.gds-type = 'у':U or
     5271        bf_trn-doc.status_ = 'запрос':U then do:
     5272       for each bf_tt-allsum-line
     5273       on error undo, return error return-value
     5274        :
     5275         delete bf_tt-allsum-line.
     5276       end.
     5277       create bf_tt-allsum-line.
     5278       assign
     5279        bf_tt-allsum-line.sum-type = 'основная_сумма':U.
     5280       for each bf_gds-dtl where bf_gds-dtl.doc-code  = bf_doc-line.doc-code  and
     5281                                 bf_gds-dtl.artic     = bf_doc-line.artic     and
     5282                                 bf_gds-dtl.prod-type = bf_doc-line.prod-type and
     5283                                 bf_gds-dtl.prod-code = bf_doc-line.prod-code no-lock on error undo, return error return-value :
     5284         assign
     5285           bf_tt-allsum-line.fact-qnty            =  bf_tt-allsum-line.fact-qnty        + bf_gds-dtl.fact-qnty
     5286           bf_tt-allsum-line.sum-dsc-base-doc     =  bf_tt-allsum-line.sum-dsc-base-doc + (bf_gds-dtl.price-base - bf_gds-dtl.discnt-base) * bf_gds-dtl.fact-qnty
     5287           bf_tt-allsum-line.sum-dsc-rubl-doc     =  bf_tt-allsum-line.sum-dsc-rubl-doc + (bf_gds-dtl.price-rubl - bf_gds-dtl.discnt-rubl) * bf_gds-dtl.fact-qnty
     5288           bf_tt-allsum-line.dsc-base-doc         =  bf_tt-allsum-line.dsc-base-doc     + bf_gds-dtl.discnt-base * bf_gds-dtl.fact-qnty
     5289           bf_tt-allsum-line.dsc-rubl-doc         =  bf_tt-allsum-line.dsc-rubl-doc     + bf_gds-dtl.discnt-rubl * bf_gds-dtl.fact-qnty
     5290           bf_tt-allsum-line.sum-dsc-base-cur     =  bf_tt-allsum-line.sum-dsc-base-cur + (if varr-b = "base" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base / bf_trn-doc.exch-rate * bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     5291           bf_tt-allsum-line.sum-dsc-rubl-cur     =  bf_tt-allsum-line.sum-dsc-rubl-cur + (if varr-b = "rubl" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base * bf_trn-doc.exch-rate / bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     5292           bf_tt-allsum-line.sum-dsc-base-acc     =  bf_tt-allsum-line.sum-dsc-base-acc + bf_doc-line.price-base * bf_gds-dtl.fact-qnty
     5293           bf_tt-allsum-line.sum-dsc-rubl-acc     =  bf_tt-allsum-line.sum-dsc-rubl-acc + bf_doc-line.price-rubl * bf_gds-dtl.fact-qnty
     5294           bf_tt-allsum-line.sum-dsc-cli-acc      =  ?
     5295           bf_tt-allsum-line.vat-base-acc         =  bf_tt-allsum-line.vat-base-acc     + bf_doc-line.price-base * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     5296           bf_tt-allsum-line.vat-rubl-acc         =  bf_tt-allsum-line.vat-rubl-acc     + bf_doc-line.price-rubl * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     5297           bf_tt-allsum-line.vat-cli-acc          =  ?
     5298           .
     5299       end.
     5300       assign
     5301         bf_tt-allsum-line.cli-qnty             =  ?
     5302         bf_tt-allsum-line.slt-base-doc         =  bf_tt-allsum-line.sum-dsc-base-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     5303         bf_tt-allsum-line.slt-rubl-doc         =  bf_tt-allsum-line.sum-dsc-rubl-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     5304         bf_tt-allsum-line.vat-base-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-base-doc - bf_tt-allsum-line.slt-base-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     5305         bf_tt-allsum-line.vat-rubl-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-rubl-doc - bf_tt-allsum-line.slt-rubl-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     5306         bf_tt-allsum-line.road-tax-base-doc    =  0
