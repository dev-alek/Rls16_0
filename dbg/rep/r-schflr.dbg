     1288               .
     1289           end.
     1290           if lookup( p-form-name, v-outprops   ) <> 0
     1291           then do:
     1292               assign
     1293                   v-torgconf-outprops    = yes
     1294               .
     1295           end.
     1296           if lookup( p-form-name, v-outexlst ) <> 0
     1297           then do:
     1298               assign
     1299                   v-torgconf-outexlst  = yes
     1300               .
     1301           end.
     1302        assign
     1303         v-name = p-form-name.
     1304   end.
     1305   end.
     1306   end procedure.
     1307   procedure torgconf-get-self-param :
     1308   define input parameter p-obj-type           as character        no-undo.
     1309   define input parameter p-obj-code           as integer          no-undo.
     1310   define input parameter p-curr-code          as integer          no-undo.
     1311       define variable v-host-code    as integer      no-undo.
     1312       define variable v-par-type     as character    no-undo.
     1313   do
     1314   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message(1))
     1315   :
     1316   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1317   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1318     (input  p-obj-type
     1319     ,input  p-obj-code
     1320     ,output v-host-code
     1321     )  .
     1322       if v-torgconf-outhold = yes
     1323       then do:
     1324           run torgconf-get-holdfirm-code in this-procedure (
     1325                 input p-obj-type
     1326               , input p-obj-code
     1327               , output v-torgconf-self-host-code
     1328           ).
     1329           if v-torgconf-self-host-code = 0
     1330           then do:
     1331               return error.
     1332           end.
     1333       end.
     1334       else do:
     1335           assign
     1336               v-torgconf-self-host-code = v-host-code
     1337           .
     1338       end.
     1339       if v-torgconf-self-host-code = 0
     1340       then do:
     1341           assign
     1342               v-torgconf-self-host-name           = "":U
     1343               v-torgconf-self-host-addres         = "":U
     1344               v-torgconf-self-host-post-addres    = "":U
     1345               v-torgconf-self-host-phone          = "":U
