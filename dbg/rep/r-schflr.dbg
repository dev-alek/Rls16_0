     5849     define buffer cli-obj     for ub.clients .
     5850     define buffer Our_Object  for ub.clients.
     5851     define buffer Our_Host    for ub.clients.
     5852     define buffer buf_clients for ub.clients.
     5853     define buffer buf_goods   for ub.goods.
     5854     define buffer buf_doc-line for ub.doc-line.
     5855     define buffer buf_gds-dtl for ub.gds-dtl.
     5856     define variable LogRes              as logical   init no    no-undo.
     5857     define variable s1                  as character            no-undo.
