      991   procedure wthcattr-sprcli :
      992   define input parameter parparentproc  as widget-handle no-undo.
      993   define input parameter p-mode  as character no-undo.
      994   define input-output parameter p-value as character no-undo .
      995   define output parameter p-setted as logical no-undo .
      996     DEFINE VARIABLE v-value as character no-undo .
      997     define variable v-cli-type as character no-undo .
      998     define variable v-cli-code as integer no-undo .
      999     define buffer buf_clients   for ub.clients.
     1000     define variable v_rid as character no-undo.
     1001     define variable ref-rec as recid no-undo .
     1002     do
     1003     on error undo, return error
     1004     :
     1005         v-value = p-value.
     1006      if p-value <> '':U then do:
     1007       assign
     1008       v-cli-type = substring(p-value, 1, 3)
     1009       v-cli-code = integer(substring(p-value, 4))
     1010       no-error.
     1011       if error-status:error then do:
     1012         assign
     1013         v-cli-type = '':U
     1014         v-cli-code = 0
     1015         .
     1016       end.
     1017      end.
     1018      FIND FIRST buf_clients NO-LOCK WHERE
     1019               buf_clients.obj-type = v-cli-type AND
     1020               buf_clients.obj-code = v-cli-code  NO-ERROR.
     1021      IF available(buf_clients) then do:
     1022       run ref/cli-all.w (
     1023                   input parparentproc
     1024                  ,input if p-mode = 'ИЗМЕНЕНИЕ':U then "b-sel":U else "":U
     1025                  ,input v-cli-type
     1026                  ,input 'все':U
     1027                  ,input 'все':U
     1028                  ,input RECID( buf_clients )
     1029                  ,input ",,,,,,NO"
     1030                  ,input ?
     1031                  ,OUTPUT v_rid ).
     1032     END.
     1033     ELSE if p-mode = 'ИЗМЕНЕНИЕ':U then DO:
     1034       run ref/cli-all.w (
     1035                    input parparentproc
     1036                   ,INPUT "b-sel":U
     1037                  ,input  v-cli-type
     1038                  ,input 'все':U
     1039                  ,input 'текущие':U
     1040                  ,input ?
     1041                  ,input ",,,,,,NO"
     1042                  ,input ?
     1043                  ,OUTPUT v_rid ).
     1044     END.
     1045     else do:
     1046       message
     1047       if p-value = "":U then 'Атрибут не задан!'
     1048       else substitute('Не найден клиент &1',p-value)
     1049       view-as alert-box warning.
     1050     end.
     1051     IF v_rid <> ? AND v_rid <> "":U THEN DO:
     1052       ASSIGN ref-rec = INT( v_rid ) NO-ERROR.
     1053       IF ERROR-STATUS:ERROR THEN DO:
     1054           RETURN NO-APPLY.
     1055       END.
     1056       FIND FIRST buf_clients NO-LOCK WHERE
     1057                  RECID( buf_clients ) = ref-rec NO-ERROR.
     1058       IF AVAIL buf_clients THEN DO:
     1059         v-value = buf_clients.obj-type + string(buf_clients.obj-code, ">>>>>>>>9").
     1060       end.
     1061     end.
     1062     if v-value <> p-value then do:
     1063       p-value = v-value.
     1064       p-setted = yes.
     1065     end.
     1066     end.
     1067   end procedure.
     1068     define new global shared variable g#wthcalib as handle no-undo.
     1069   procedure torgconf-read :
     1070   do
     1071   on error undo, return error
     1072   :
     1073       define input parameter p-form-name  as character    no-undo.
     1074       define input parameter p-host-code  as integer      no-undo.
     1075       define input parameter p-obj-type   as character    no-undo.
     1076       define input parameter p-obj-code   as integer      no-undo.
     1077       define variable v-outdate   as character     no-undo.
     1078       define variable v-outares   as character     no-undo.
     1079       define variable v-outsend   as character     no-undo.
     1080       define variable v-outasend  as character     no-undo.
     1081       define variable v-outprops  as character     no-undo.
