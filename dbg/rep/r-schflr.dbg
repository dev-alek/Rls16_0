     4781   price-rubl-without-tax-salecur = price-rubl-with-tax-salecur - vat-rubl-salecur - slt-rubl-salecur - road-tax-rubl-salecur.
     4782   end.
     4783   create bf_tt-allsum.
     4784   assign
     4785     bf_tt-allsum.sum-type = 'основная_сумма':U.
