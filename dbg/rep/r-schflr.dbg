     5456   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5457   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     5458     (input  bf_goods.gds-code
     5459     ,input  '1':U
     5460     ,input  bf_trn-doc.fact-date
     5461     ,input  bf_trn-doc.host-code
     5462     ,input  bf_trn-doc.obj-type
     5463     ,input  bf_trn-doc.obj-code
     5464     ,output varcur-vat-pc
     5465     ) no-error .
     5466       if varcur-vat-pc = ?
     5467       then do:
     5468         return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3 документ &4", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code, bf_trn-doc.doc-code).
     5469       end.
     5470       if varcur-slt-pc = ?
     5471       then do:
     5472         return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3 документ &4", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code, bf_trn-doc.doc-code).
     5473       end.
     5474       v-calcbypart = no.
     5475       if bf_doc-line.whole-send-news = integer('1':U)   then
     5476       v-calcbypart = yes.
     5477       else do:
     5478       for each bf_gds-dtl no-lock
     5479         where bf_gds-dtl.doc-code  = bf_doc-line.doc-code
     5480           and bf_gds-dtl.artic     = bf_doc-line.artic
     5481           and bf_gds-dtl.prod-type = bf_doc-line.prod-type
     5482           and bf_gds-dtl.prod-code = bf_doc-line.prod-code
