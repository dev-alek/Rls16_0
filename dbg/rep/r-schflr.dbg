     1093       define variable v-outexlst  as character     no-undo.
     1094       define variable v-outprncd  as character     no-undo.
     1095       define variable v-par-type  as character     no-undo.
     1096       define variable v-outogr    as character     no-undo.
     1097       define variable v-outR      as character     no-undo.
     1098       define variable v-outB      as character     no-undo.
     1099       define variable v-outC      as character     no-undo.
     1100       assign
     1101           v-torgconf-outdate  = no
     1102           v-torgconf-outnum   = no
     1103           v-torgconf-outprim  = no
     1104           v-torgconf-outdisc  = no
     1105           v-torgconf-outsubs  = no
     1106           v-torgconf-outrecv  = no
     1107           v-torgconf-outegrp  = no
     1108           v-torgconf-outt12   = no
     1109           v-torgconf-outappr  = no
     1110           v-torgconf-outrubl  = no
     1111           v-torgconf-outhold  = no
     1112           v-torgconf-outobj   = no
     1113           v-torgconf-outexlst = no
     1114           v-torgconf-outexpas = "":U
     1115           v-torgconf-outprncd = yes
     1116           v-torgconf-outares  = no
     1117           v-torgconf-outsend  = no
     1118           v-torgconf-outasend  = no
     1119           v-torgconf-outprops  = no
     1120           v-form-name          = p-form-name
     1121       .
     1122   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1123   empty temp-table thbjattr_thbj-attr.
     1124   run adm/shattri.p (
     1125      input "get":U
     1126     ,input ''
     1127     ,input 0
     1128     ,input 'prt-glob':U
     1129     ,input  ""
     1130     ,output v-value-character
     1131     ,output v-value-date
     1132     ,output v-value-decimal
     1133     ,output v-value-integer
     1134     ,output v-value-logical
     1135     ,output par-type
     1136     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1137     ) no-error .
     1138   for each thbjattr_thbj-attr :
     1139       if thbjattr_thbj-attr.prop-code = 'outprncd':U then v-outprncd =  string(thbjattr_thbj-attr.property-value-logical) .
     1140       if thbjattr_thbj-attr.prop-code = 'outrecv':U  then v-outrecv  =  thbjattr_thbj-attr.property-value-character .
     1141       if thbjattr_thbj-attr.prop-code = 'outprops':U then v-outprops =  thbjattr_thbj-attr.property-value-character .
     1142   end.
     1143   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1144   empty temp-table thbjattr_thbj-attr.
     1145   run adm/shattri.p (
     1146      input "get":U
     1147     ,input p-obj-type
     1148     ,input p-obj-code
     1149     ,input 'prt-obj':U
     1150     ,input  ""
     1151     ,output v-value-character
     1152     ,output v-value-date
     1153     ,output v-value-decimal
     1154     ,output v-value-integer
     1155     ,output v-value-logical
     1156     ,output par-type
     1157     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1158     ) no-error .
     1159   for each thbjattr_thbj-attr :
     1160       if thbjattr_thbj-attr.prop-code = 'outdate':U  then v-outdate  =  thbjattr_thbj-attr.property-value-character .
     1161       if thbjattr_thbj-attr.prop-code = 'outares':U  then v-outares  =  thbjattr_thbj-attr.property-value-character .
     1162       if thbjattr_thbj-attr.prop-code = 'outnum':U   then v-outnum   =  thbjattr_thbj-attr.property-value-character .
     1163       if thbjattr_thbj-attr.prop-code = 'outprim':U  then v-outprim  =  thbjattr_thbj-attr.property-value-character .
     1164       if thbjattr_thbj-attr.prop-code = 'outdisc':U  then v-outdisc  =  thbjattr_thbj-attr.property-value-character .
     1165       if thbjattr_thbj-attr.prop-code = 'outsubs':U  then v-outsubs  =  thbjattr_thbj-attr.property-value-character .
     1166       if thbjattr_thbj-attr.prop-code = 'outegrp':U  then v-outegrp  =  thbjattr_thbj-attr.property-value-character .
     1167       if thbjattr_thbj-attr.prop-code = 'outt12':U   then v-outt12   =  thbjattr_thbj-attr.property-value-character .
     1168       if thbjattr_thbj-attr.prop-code = 'outappr':U  then v-outappr  =  thbjattr_thbj-attr.property-value-character .
     1169       if thbjattr_thbj-attr.prop-code = 'outrubl':U  then v-outrubl  =  thbjattr_thbj-attr.property-value-character .
     1170       if thbjattr_thbj-attr.prop-code = 'outhold':U  then v-outhold  =  thbjattr_thbj-attr.property-value-character .
     1171       if thbjattr_thbj-attr.prop-code = 'outobj':U   then v-outobj   =  thbjattr_thbj-attr.property-value-character .
     1172       if thbjattr_thbj-attr.prop-code = 'outsend':U  then v-outsend  =  thbjattr_thbj-attr.property-value-character .
     1173       if thbjattr_thbj-attr.prop-code = 'outasend':U then v-outasend =  thbjattr_thbj-attr.property-value-character .
     1174       if thbjattr_thbj-attr.prop-code = 'outogr':U   then v-torgconf-outogr   =  thbjattr_thbj-attr.property-value-character .
     1175       if thbjattr_thbj-attr.prop-code = 'outR':U     then v-torgconf-outR     =  thbjattr_thbj-attr.property-value-character .
     1176       if thbjattr_thbj-attr.prop-code = 'outB':U     then v-torgconf-outB     =  thbjattr_thbj-attr.property-value-character .
     1177       if thbjattr_thbj-attr.prop-code = 'outssdoc':U then v-torgconf-outssdoc =  thbjattr_thbj-attr.property-value-character .
     1178       if thbjattr_thbj-attr.prop-code = 'outC':U     then v-torgconf-outC     =  thbjattr_thbj-attr.property-value-character .
     1179   end.
     1180       run gbl/conf-rd.p ("outexpas", "":U, "":U, 0, "":U, "":U, "":U, no, output v-torgconf-outexpas, output v-par-type) no-error.
     1181       if error-status :error
     1182       then do:
     1183           assign
     1184               v-torgconf-outexpas = "":U
     1185           .
     1186       end.
     1187       assign
     1188           v-torgconf-outprncd = ( v-outprncd = "yes":U )
     1189       .
     1190       if p-form-name <> ""
     1191       and p-form-name <> ?
     1192       then do:
     1193           run gbl/conf-rd.p ("outexlst" , p-host-code, p-obj-type, p-obj-code, "", "", "", no, output v-outexlst , output v-par-type) no-error.
     1194           if error-status :error
     1195           then do:
     1196               assign
     1197                   v-outexlst           = ""
     1198               .
     1199           end.
     1200           if lookup( p-form-name, v-outdate ) <> 0
     1201           then do:
     1202               assign
     1203                   v-torgconf-outdate  = yes
     1204               .
     1205           end.
     1206           if lookup( p-form-name, v-outares ) <> 0
     1207           then do:
     1208               assign
     1209                   v-torgconf-outares  = yes
     1210               .
     1211           end.
     1212           if lookup( p-form-name, v-outnum  ) <> 0
     1213           then do:
     1214               assign
     1215                   v-torgconf-outnum   = yes
     1216               .
     1217           end.
     1218           if lookup( p-form-name, v-outprim ) <> 0
     1219           then do:
     1220               assign
     1221                   v-torgconf-outprim  = yes
     1222               .
     1223           end.
     1224           if lookup( p-form-name, v-outdisc ) <> 0
     1225           then do:
     1226               assign
     1227                   v-torgconf-outdisc  = yes
     1228               .
     1229           end.
     1230           if lookup( p-form-name, v-outsubs ) <> 0
     1231           then do:
     1232               assign
     1233                   v-torgconf-outsubs  = yes
     1234               .
     1235           end.
     1236           if lookup( p-form-name, v-outrecv ) <> 0
     1237           then do:
     1238               assign
     1239                   v-torgconf-outrecv  = yes
     1240               .
     1241           end.
     1242           if lookup( p-form-name, v-outegrp ) <> 0
     1243           then do:
     1244               assign
     1245                   v-torgconf-outegrp  = yes
     1246               .
     1247           end.
     1248           if lookup( p-form-name, v-outt12  ) <> 0
     1249           then do:
     1250               assign
     1251                   v-torgconf-outt12   = yes
     1252               .
     1253           end.
     1254           if lookup( p-form-name, v-outappr  ) <> 0
     1255           then do:
     1256               assign
     1257                   v-torgconf-outappr   = yes
     1258               .
     1259           end.
     1260           if lookup( p-form-name, v-outrubl  ) <> 0
     1261           then do:
     1262               assign
     1263                   v-torgconf-outrubl   = yes
     1264               .
     1265           end.
     1266           if lookup( p-form-name, v-outhold  ) <> 0
     1267           then do:
     1268               assign
     1269                   v-torgconf-outhold   = yes
     1270               .
     1271           end.
     1272           if lookup( p-form-name, v-outobj   ) <> 0
     1273           then do:
     1274               assign
     1275                   v-torgconf-outobj    = yes
     1276               .
     1277           end.
     1278           if lookup( p-form-name, v-outsend   ) <> 0
     1279           then do:
     1280               assign
     1281                   v-torgconf-outsend    = yes
     1282               .
     1283           end.
     1284           if lookup( p-form-name, v-outasend   ) <> 0
     1285           then do:
     1286               assign
