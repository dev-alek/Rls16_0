     1083       define variable v-outprim   as character     no-undo.
     1084       define variable v-outdisc   as character     no-undo.
     1085       define variable v-outsubs   as character     no-undo.
     1086       define variable v-outrecv   as character     no-undo.
     1087       define variable v-outegrp   as character     no-undo.
     1088       define variable v-outt12    as character     no-undo.
     1089       define variable v-outappr   as character     no-undo.
     1090       define variable v-outrubl   as character     no-undo.
