     5486     (input  bf_goods.gds-code
     5487     ,input  bf_gds-dtl.prt-code
     5488     ,output varb-code
     5489     ) no-error .
     5490   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5491   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     5492     (input  bf_trn-doc.obj-type
     5493     ,input  bf_trn-doc.obj-code
     5494     ,input  varb-code
     5495     ,input  0
     5496     ,input  bf_trn-doc.fact-order
     5497     ,output vardoc-num
     5498     ,output varprice-sale
     5499     ,output varroad-tax
     5500     ,output varexcise
     5501     )  .
     5502             if varprice-sale = ?
     5503             then do:
     5504               assign
     5505                 varprice-sale = 0
     5506                 varroad-tax   = 0
     5507                 varexcise     = 0
     5508               .
     5509             end.
     5510             assign
     5511               varlastcur-base     = varprice-sale
     5512               varlastcur-road-tax = varroad-tax
     5513               varlastcur-excise   = varexcise
     5514               varcur-base         = varcur-base      + varprice-sale * bf_gds-dtl.fact-qnty
     5515               varcur-road-tax     = varcur-road-tax  + varroad-tax   * bf_gds-dtl.fact-qnty
     5516               varcur-excise       = varcur-excise    + varexcise     * bf_gds-dtl.fact-qnty
     5517               varcur-fact-qnty    = varcur-fact-qnty + bf_gds-dtl.fact-qnty
     5518             .
     5519         end.
     5520       end.
     5521       if varcur-fact-qnty = 0 then do:
     5522         assign
     5523           varcur-base      = varlastcur-base
     5524           varcur-road-tax  = varlastcur-road-tax
     5525           varcur-excise    = varlastcur-excise
     5526         .
     5527       end.
     5528       else do:
     5529         assign
     5530           varcur-base      = varcur-base      / varcur-fact-qnty
     5531           varcur-road-tax  = varcur-road-tax  / varcur-fact-qnty
     5532           varcur-excise    = varcur-excise    / varcur-fact-qnty
     5533         .
     5534       end.
     5535       if varcur-vat-pc = ?
     5536       then do:
     5537         return error substitute ("Нет текущего продажного НДС по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     5538       end.
     5539       if varcur-slt-pc = ?
     5540       then do:
     5541         return error substitute ("Нет текущего продажного НП по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     5542       end.
     5543       find first bf_sysconf where bf_sysconf.host-code = bf_trn-doc.host-code no-lock.
     5544       assign
     5545         varcur-cons-vat-pc = bf_sysconf.cons-vat-pc.
     5546       if varcur-cons-vat-pc = ? then do:
     5547         return error substitute ("Нет текущего продажного консигнационного НДС по фирме &1", bf_trn-doc.host-code).
     5548       end.
     5549       define buffer buf_tt-clcparts for tt-clcparts .
     5550       for each buf_tt-clcparts
     5551       on error undo, return error return-value
     5552       :
     5553         delete buf_tt-clcparts.
     5554       end.
     5555       for each bf_parts no-lock
     5556         where bf_parts.out-code  = bf_doc-line.doc-code
     5557           and bf_parts.obj-type  = bf_doc-line.obj-type
     5558           and bf_parts.obj-code  = bf_doc-line.obj-code
     5559           and bf_parts.artic     = bf_doc-line.artic
     5560           and bf_parts.prod-type = bf_doc-line.prod-type
     5561           and bf_parts.prod-code = bf_doc-line.prod-code
     5562       on error undo, return error return-value
     5563       :
     5564         create buf_tt-clcparts .
     5565         buffer-copy bf_parts to buf_tt-clcparts .
     5566         if v-calcbypart = yes   then do:
     5567   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run partbcod in g#library
     5568     (buffer bf_parts
     5569     ,output v-b-pcode
     5570     ) no-error .
     5571   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5572   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     5573     (input  bf_parts.obj-type
     5574     ,input  bf_parts.obj-code
     5575     ,input  v-b-pcode
     5576     ,input  0
     5577     ,input  bf_trn-doc.fact-order
     5578     ,output vardoc-num
     5579     ,output varprice-salef
     5580     ,output varroad-tax
     5581     ,output varexcise
     5582     ) no-error .
     5583             if varprice-sale = ?
     5584             then do:
     5585               assign
     5586                 varprice-salef = 0
     5587                 varroad-tax   = 0
     5588                 varexcise     = 0
     5589               .
     5590             end.
     5591             assign
     5592             part-cur-base  = varprice-salef
     5593             part-cur-road-tax  = varroad-tax
     5594             part-cur-excise = varexcise.
     5595         end.
     5596       end.
     5597       run clcprtsl_calc-ttable in this-procedure
     5598         (input yes,
     5599          input yes,
     5600          input bf_doc-line.road-tax,
     5601          input bf_doc-line.excise,
     5602          input bf_doc-line.vat-pc,
     5603          input bf_doc-line.cons-vat-pc,
     5604          input bf_doc-line.slt-pc,
     5605          input bf_trn-doc.base-rate,
     5606          input bf_trn-doc.base-scale,
     5607          input varr-b,
     5608          input varcur-base,
     5609          input varcur-road-tax,
     5610          input varcur-excise,
     5611          input varcur-vat-pc,
     5612          input varcur-cons-vat-pc,
     5613          input varcur-slt-pc
     5614          ) no-error.
     5615       if error-status:error then do:
     5616         message
     5617           vss-workfile vss-revision vss-description skip
     5618           "Ошибка при вызове процедуры clcprtsl_calc-ttable." skip
     5619           return-value skip
     5620           trim(error-status :get-message(1))
     5621           trim(error-status :get-message(2))
     5622           trim(error-status :get-message(3))
     5623           trim(error-status :get-message(4))
     5624           trim(error-status :get-message(5)) skip
     5625           view-as alert-box error.
     5626         undo, return error .
     5627       end.
     5628     end.
     5629   end.
     5630   end.
     5631   procedure clcprtsl_calc-ttable :
     5632   define input parameter paris-doc           as   logical                 no-undo.
     5633   define input parameter paris-cur           as   logical                 no-undo.
     5634   define input parameter parroad-tax         like ub.doc-line.road-tax    no-undo.
     5635   define input parameter parexcise           like ub.doc-line.excise      no-undo.
     5636   define input parameter parvat-pc           like ub.doc-line.vat-pc      no-undo.
     5637   define input parameter parcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     5638   define input parameter parslt-pc           like ub.doc-line.slt-pc      no-undo.
     5639   define input parameter parbase-rate        like ub.trn-doc.base-rate    no-undo.
     5640   define input parameter parbase-scale       like ub.trn-doc.base-scale   no-undo.
     5641   define input parameter parr-b              as   character               no-undo.
     5642   define input parameter parcur-base         like ub.gds-dtl.cur-base     no-undo.
     5643   define input parameter parcur-road-tax     like ub.doc-line.road-tax    no-undo.
     5644   define input parameter parcur-excise       like ub.doc-line.excise      no-undo.
     5645   define input parameter parcur-vat-pc       like ub.doc-line.vat-pc      no-undo.
     5646   define input parameter parcurcons-vat-pc   like ub.doc-line.cons-vat-pc no-undo.
     5647   define input parameter parcurslt-pc        like ub.doc-line.slt-pc      no-undo.
     5648   define buffer bf_tt-allsum      for tt-allsum.
     5649   define buffer bf_tt-clcparts    for tt-clcparts.
     5650   define buffer bf_tt-allsum-line for tt-allsum-line.
     5651   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     5652   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     5653   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     5654   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     5655   define variable varexcise          like ub.price-list.excise     no-undo.
     5656   do on error undo, return error return-value :
     5657   for each bf_tt-allsum-line
     5658   on error undo, return error return-value
     5659    :
     5660     delete bf_tt-allsum-line.
     5661   end.
     5662   for each bf_tt-allsum
     5663   on error undo, return error return-value
     5664   :
     5665     delete bf_tt-allsum.
     5666   end.
     5667   for each bf_tt-clcparts
     5668   on error undo, return error return-value
     5669   :
     5670   if v-calcbypart then do:
     5671             assign
     5672             parcur-base =   bf_tt-clcparts.part-cur-base
     5673             parcur-road-tax = bf_tt-clcparts.part-cur-road-tax
     5674             parcur-excise =   bf_tt-clcparts.part-cur-excise
     5675             .
     5676   end.
     5677      run clcprtsl_calc-parts in this-procedure (
     5678        input recid(bf_tt-clcparts),
     5679        input paris-doc,
     5680        input paris-cur,
     5681        input parroad-tax,
     5682        input parexcise,
     5683        input parvat-pc,
     5684        input parcons-vat-pc,
     5685        input parslt-pc,
     5686        input parbase-rate,
     5687        input parbase-scale,
     5688        input parr-b,
     5689        input parcur-base,
     5690        input parcur-road-tax,
     5691        input parcur-excise,
     5692        input parcur-vat-pc,
     5693        input parcurcons-vat-pc,
     5694        input parcurslt-pc
     5695        ) no-error.
     5696     if error-status:error then do:
     5697       message
     5698         vss-workfile vss-revision vss-description skip
     5699         vss-include-info14 skip
     5700         "Ошибка при обсчете партии" skip
     5701         "Документ партии " bf_tt-clcparts.out-code skip
     5702         "Товар" bf_tt-clcparts.artic bf_tt-clcparts.prod-type bf_tt-clcparts.prod-code skip
     5703         return-value skip
     5704         error-status:get-message(1) skip
     5705         error-status:get-message(2) skip
     5706         error-status:get-message(3) skip
     5707         view-as alert-box error .
     5708       undo, return error .
     5709     end.
     5710     for each bf_tt-allsum on error undo, return error return-value :
     5711       find first bf_tt-allsum-line where bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type no-error.
     5712       if not available bf_tt-allsum-line then do:
     5713         create bf_tt-allsum-line.
     5714         assign
     5715           bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type.
     5716       end.
     5717       assign
     5718         bf_tt-allsum-line.fact-qnty              = bf_tt-allsum-line.fact-qnty            + bf_tt-allsum.fact-qnty
     5719         bf_tt-allsum-line.cli-qnty               = bf_tt-allsum-line.cli-qnty             + bf_tt-allsum.cli-qnty
     5720         bf_tt-allsum-line.sum-dsc-base-doc       = bf_tt-allsum-line.sum-dsc-base-doc     + bf_tt-allsum.sum-dsc-base-doc
     5721         bf_tt-allsum-line.sum-dsc-rubl-doc       = bf_tt-allsum-line.sum-dsc-rubl-doc     + bf_tt-allsum.sum-dsc-rubl-doc
     5722         bf_tt-allsum-line.dsc-base-doc           = bf_tt-allsum-line.dsc-base-doc         + bf_tt-allsum.dsc-base-doc
     5723         bf_tt-allsum-line.dsc-rubl-doc           = bf_tt-allsum-line.dsc-rubl-doc         + bf_tt-allsum.dsc-rubl-doc
     5724         bf_tt-allsum-line.vat-base-doc           = bf_tt-allsum-line.vat-base-doc         + bf_tt-allsum.vat-base-doc
     5725         bf_tt-allsum-line.vat-rubl-doc           = bf_tt-allsum-line.vat-rubl-doc         + bf_tt-allsum.vat-rubl-doc
     5726         bf_tt-allsum-line.vat-base-buyer-doc     = bf_tt-allsum-line.vat-base-buyer-doc   + bf_tt-allsum.vat-base-buyer-doc
     5727         bf_tt-allsum-line.vat-rubl-buyer-doc     = bf_tt-allsum-line.vat-rubl-buyer-doc   + bf_tt-allsum.vat-rubl-buyer-doc
     5728         bf_tt-allsum-line.slt-base-doc           = bf_tt-allsum-line.slt-base-doc         + bf_tt-allsum.slt-base-doc
     5729         bf_tt-allsum-line.slt-rubl-doc           = bf_tt-allsum-line.slt-rubl-doc         + bf_tt-allsum.slt-rubl-doc
     5730         bf_tt-allsum-line.road-tax-base-doc      = bf_tt-allsum-line.road-tax-base-doc    + bf_tt-allsum.road-tax-base-doc
     5731         bf_tt-allsum-line.road-tax-rubl-doc      = bf_tt-allsum-line.road-tax-rubl-doc    + bf_tt-allsum.road-tax-rubl-doc
     5732         bf_tt-allsum-line.excise-base-doc        = bf_tt-allsum-line.excise-base-doc      + bf_tt-allsum.excise-base-doc
     5733         bf_tt-allsum-line.excise-rubl-doc        = bf_tt-allsum-line.excise-rubl-doc      + bf_tt-allsum.excise-rubl-doc
     5734         bf_tt-allsum-line.sum-dsc-base-cur       = bf_tt-allsum-line.sum-dsc-base-cur     + bf_tt-allsum.sum-dsc-base-cur
     5735         bf_tt-allsum-line.sum-dsc-rubl-cur       = bf_tt-allsum-line.sum-dsc-rubl-cur     + bf_tt-allsum.sum-dsc-rubl-cur
     5736         bf_tt-allsum-line.dsc-base-cur           = bf_tt-allsum-line.dsc-base-cur         + bf_tt-allsum.dsc-base-cur
     5737         bf_tt-allsum-line.dsc-rubl-cur           = bf_tt-allsum-line.dsc-rubl-cur         + bf_tt-allsum.dsc-rubl-cur
     5738         bf_tt-allsum-line.vat-base-cur           = bf_tt-allsum-line.vat-base-cur         + bf_tt-allsum.vat-base-cur
     5739         bf_tt-allsum-line.vat-rubl-cur           = bf_tt-allsum-line.vat-rubl-cur         + bf_tt-allsum.vat-rubl-cur
     5740         bf_tt-allsum-line.vat-base-buyer-cur     = bf_tt-allsum-line.vat-base-buyer-cur   + bf_tt-allsum.vat-base-buyer-cur
     5741         bf_tt-allsum-line.vat-rubl-buyer-cur     = bf_tt-allsum-line.vat-rubl-buyer-cur   + bf_tt-allsum.vat-rubl-buyer-cur
     5742         bf_tt-allsum-line.slt-base-cur           = bf_tt-allsum-line.slt-base-cur         + bf_tt-allsum.slt-base-cur
     5743         bf_tt-allsum-line.slt-rubl-cur           = bf_tt-allsum-line.slt-rubl-cur         + bf_tt-allsum.slt-rubl-cur
     5744         bf_tt-allsum-line.road-tax-base-cur      = bf_tt-allsum-line.road-tax-base-cur    + bf_tt-allsum.road-tax-base-cur
     5745         bf_tt-allsum-line.road-tax-rubl-cur      = bf_tt-allsum-line.road-tax-rubl-cur    + bf_tt-allsum.road-tax-rubl-cur
     5746         bf_tt-allsum-line.excise-base-cur        = bf_tt-allsum-line.excise-base-cur      + bf_tt-allsum.excise-base-cur
     5747         bf_tt-allsum-line.excise-rubl-cur        = bf_tt-allsum-line.excise-rubl-cur      + bf_tt-allsum.excise-rubl-cur
     5748         bf_tt-allsum-line.sum-dsc-base-acc       = bf_tt-allsum-line.sum-dsc-base-acc     + bf_tt-allsum.sum-dsc-base-acc
     5749         bf_tt-allsum-line.sum-dsc-rubl-acc       = bf_tt-allsum-line.sum-dsc-rubl-acc     + bf_tt-allsum.sum-dsc-rubl-acc
     5750         bf_tt-allsum-line.sum-dsc-cli-acc        = bf_tt-allsum-line.sum-dsc-cli-acc      + bf_tt-allsum.sum-dsc-cli-acc
     5751         bf_tt-allsum-line.dsc-base-acc           = bf_tt-allsum-line.dsc-base-acc         + bf_tt-allsum.dsc-base-acc
     5752         bf_tt-allsum-line.dsc-rubl-acc           = bf_tt-allsum-line.dsc-rubl-acc         + bf_tt-allsum.dsc-rubl-acc
     5753         bf_tt-allsum-line.dsc-cli-acc            = bf_tt-allsum-line.dsc-cli-acc          + bf_tt-allsum.dsc-cli-acc
     5754         bf_tt-allsum-line.vat-base-acc           = bf_tt-allsum-line.vat-base-acc         + bf_tt-allsum.vat-base-acc
     5755         bf_tt-allsum-line.vat-rubl-acc           = bf_tt-allsum-line.vat-rubl-acc         + bf_tt-allsum.vat-rubl-acc
     5756         bf_tt-allsum-line.vat-cli-acc            = bf_tt-allsum-line.vat-cli-acc          + bf_tt-allsum.vat-cli-acc
     5757         bf_tt-allsum-line.slt-base-acc           = bf_tt-allsum-line.slt-base-acc         + bf_tt-allsum.slt-base-acc
     5758         bf_tt-allsum-line.slt-rubl-acc           = bf_tt-allsum-line.slt-rubl-acc         + bf_tt-allsum.slt-rubl-acc
     5759         bf_tt-allsum-line.slt-cli-acc            = bf_tt-allsum-line.slt-cli-acc          + bf_tt-allsum.slt-cli-acc
     5760         bf_tt-allsum-line.road-tax-base-acc      = bf_tt-allsum-line.road-tax-base-acc    + bf_tt-allsum.road-tax-base-acc
     5761         bf_tt-allsum-line.road-tax-rubl-acc      = bf_tt-allsum-line.road-tax-rubl-acc    + bf_tt-allsum.road-tax-rubl-acc
     5762         bf_tt-allsum-line.road-tax-cli-acc       = bf_tt-allsum-line.road-tax-cli-acc     + bf_tt-allsum.road-tax-cli-acc
     5763         bf_tt-allsum-line.excise-base-acc        = bf_tt-allsum-line.excise-base-acc      + bf_tt-allsum.excise-base-acc
     5764         bf_tt-allsum-line.excise-rubl-acc        = bf_tt-allsum-line.excise-rubl-acc      + bf_tt-allsum.excise-rubl-acc
     5765         bf_tt-allsum-line.excise-cli-acc         = bf_tt-allsum-line.excise-cli-acc       + bf_tt-allsum.excise-cli-acc
     5766         bf_tt-allsum-line.transport-base-acc     = bf_tt-allsum-line.transport-base-acc   + bf_tt-allsum.transport-base-acc
     5767         bf_tt-allsum-line.transport-rubl-acc     = bf_tt-allsum-line.transport-rubl-acc   + bf_tt-allsum.transport-rubl-acc
     5768         bf_tt-allsum-line.transport-cli-acc      = bf_tt-allsum-line.transport-cli-acc    + bf_tt-allsum.transport-cli-acc
     5769         bf_tt-allsum-line.other-base-acc         = bf_tt-allsum-line.other-base-acc       + bf_tt-allsum.other-base-acc
     5770         bf_tt-allsum-line.other-rubl-acc         = bf_tt-allsum-line.other-rubl-acc       + bf_tt-allsum.other-rubl-acc
     5771         bf_tt-allsum-line.other-cli-acc          = bf_tt-allsum-line.other-cli-acc        + bf_tt-allsum.other-cli-acc
     5772         .
     5773     end.
     5774   end.
     5775   end.
     5776   end procedure.
     5777   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5778     define variable v-cntxt-db-num        as integer   no-undo .
     5779     define variable v-cntxt-userid        as character no-undo .
     5780     define variable v-cntxt-level         as character no-undo .
     5781     define variable v-cntxt-host-code-obj as integer   no-undo .
     5782     define variable v-cntxt-obj-type      as character no-undo .
     5783     define variable v-cntxt-obj-code      as integer   no-undo .
     5784     define variable v-cntxt-db-num-obj    as integer   no-undo .
     5785     define variable v-cntxt-is-admin      as logical   no-undo .
     5786   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5787     run mainmenu_getcntxt in parparentproc
     5788       (output v-cntxt-db-num
     5789       ,output v-cntxt-userid
     5790       ,output v-cntxt-level
     5791       ,output v-cntxt-host-code-obj
     5792       ,output v-cntxt-obj-type
     5793       ,output v-cntxt-obj-code
     5794       ,output v-cntxt-db-num-obj
     5795       ,output v-cntxt-is-admin
     5796       ) .
     5797   do
     5798   on error undo, return error
     5799   :
     5800   define variable base-type as character no-undo .
     5801   define variable base-code as integer   no-undo .
     5802   define variable g#gds-engl as logical   no-undo .
     5803   define variable g#report-num as integer   no-undo .
     5804   define variable g#rsrv-time as integer   no-undo .
     5805   define variable g#quest-print as logical   no-undo .
     5806   define variable g#log as logical   no-undo .
     5807   define variable v-cntxt-host-name-obj as character no-undo .
     5808   define buffer buf_rep_currency for ub.currency.
     5809   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5810   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostname in g#library
     5811     (input  v-cntxt-obj-type
     5812     ,input  v-cntxt-obj-code
     5813     ,output v-cntxt-host-code-obj
     5814     ,output v-cntxt-host-name-obj
     5815     )  .
     5816   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5817   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     5818     (input  v-cntxt-host-code-obj
     5819     ,output base-code
     5820     )  .
     5821   find first buf_rep_currency no-lock
     5822     where buf_rep_currency.curr-code = base-code
     5823     no-error .
     5824     if available buf_rep_currency then base-type = buf_rep_currency.curr-abbr .
     5825                  else base-type = "б.в." .
     5826   run get-report-num  in parparentproc ( output g#report-num ).
     5827   run get-gds-engl   in parparentproc ( output g#gds-engl ) .
     5828   run get-quest-print in parparentproc ( output g#quest-print ) .
     5829     DEFINE temp-table temp-nalog no-undo
     5830       field   slt-prc          as  decimal
     5831       field   vat-prc          as  decimal
     5832       field   sum              as  decimal
     5833       field   slt-sum          as  decimal
     5834       field   vat-sum          as  decimal
     5835       INDEX pi  IS PRIMARY   vat-prc slt-prc
     5836     .
     5837     define shared variable CostPrice    as logical          no-undo .
     5838     define shared variable PrintScale   as logical          no-undo.
     5839     define shared variable sort-gr      as logical          no-undo.
     5840     define shared variable sort-name    as logical          no-undo.
     5841     CostPrice   = false .
     5842     PrintScale  = false .
     5843     sort-gr     = false .
     5844     sort-name   = false .
     5845     define buffer t-doc       for ub.trn-doc.
