        1   block-level on error undo, throw.
        2   define input parameter parparentproc as handle    no-undo.
        3   define input parameter rec_id        as recid          no-undo.
        4   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: r-schflr.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: rep/r-schflr.p $":U .
        9   define variable vss-description as character no-undo init "Печать счета Топ-аукцион".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   procedure proc-alt-shift-f2:
       65     if not ibs.th.gbl.gbl-var:rcode
       66   then
       67     run gbl\inidebug.p .
       68   end.
       69   procedure proc-alt-shift-f3:
       70     run gbl/prvssinf.p
       71       ( input this-procedure
       72       ) .
       73   end.
       74   define variable v-inform-launched as logical no-undo initial false .
       75   procedure proc-alt-shift-f4:
       76     define variable v-action as character no-undo .
       77     if v-inform-launched = false then do:
       78       assign
       79         v-inform-launched = true
       80       .
       81       run gbl/d-inform.w
       82         (  input self
       83         ,  input this-procedure
       84         , output v-action
       85         ) no-error .
       86       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       87       assign
       88         v-inform-launched = false
       89       .
       90     end.
       91   end.
       92   procedure proc-alt-f1:
       93     run gbl/corrhelp.p
       94       (input this-procedure
       95       ) .
       96   end .
       97   on alt-shift-f2 anywhere do:
       98     run proc-alt-shift-f2.
       99   end.
      100   on alt-shift-f3 anywhere do:
      101     run proc-alt-shift-f3 in this-procedure .
      102   end.
      103   on alt-shift-f4 anywhere do:
      104     run proc-alt-shift-f4 in this-procedure.
      105   end.
      106   on alt-f1 anywhere do:
      107     run proc-alt-f1 in this-procedure .
      108   end.
      109   define new global shared variable g#language as character no-undo .
      110   if g#language <> '' and g#language <> 'rus':U then do:
      111     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      112   end.
      113   define new global shared variable g#library  as handle no-undo .
      114   define new global shared variable g#library2 as handle no-undo .
      115   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      116   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      117   define  shared variable RepPathName        as character no-undo .
      118   define  shared variable PrintRubl          as logical   no-undo .
      119   define variable vss-include-info1 as character format "X(65)" no-undo
      120   initial "@(#)$Workfile$ $Revision$".
      121   define variable v-fmtcli-name          as character    no-undo.
      122   define variable v-fmtcli-engl-name     as character    no-undo.
      123   define variable v-fmtcli-addres        as character    no-undo.
      124   define variable v-fmtcli-post-addres   as character    no-undo.
      125   define variable v-fmtcli-full-addres   as character    no-undo.
      126   define variable v-fmtcli-phone         as character    no-undo.
      127   define variable v-fmtcli-inn           as character    no-undo.
      128   define variable v-fmtcli-kpp           as character    no-undo.
      129   define variable v-fmtcli-okpo          as character    no-undo.
      130   define variable v-fmtcli-country       as character    no-undo.
      131   define variable v-fmtcli-city          as character    no-undo.
      132   define variable v-fmtcli-index         as character    no-undo.
      133   define variable v-fmtcli-schet-exists  as logical      no-undo.
      134   define variable v-fmtcli-bank-exists   as logical      no-undo.
      135   define variable v-fmtcli-bank-r-schet  as character    no-undo.
      136   define variable v-fmtcli-bank-c-schet  as character    no-undo.
      137   define variable v-fmtcli-bank-bik      as character    no-undo.
      138   define variable v-fmtcli-bank-name     as character    no-undo.
      139   define variable v-fmtcli-bank-addres   as character    no-undo.
      140   define variable v-fmtcli-bank-city     as character    no-undo.
      141   procedure fmtcli-get-bank :
      142   define input parameter p-host-code      as integer          no-undo.
      143   define input parameter p-obj-type       as character        no-undo.
      144   define input parameter p-obj-code       as integer          no-undo.
      145   define input parameter p-curr-code      as integer          no-undo.
      146       define buffer buf_fin-schet     for ub.fin-schet.
      147       define buffer buf_fin-bank      for ub.fin-bank.
      148   do
      149   for buf_fin-schet
      150     , buf_fin-bank
      151   on error undo, return error
      152   :
      153       assign
      154           v-fmtcli-schet-exists       = no
      155           v-fmtcli-bank-exists        = no
      156           v-fmtcli-bank-r-schet       = "":U
      157           v-fmtcli-bank-c-schet       = "":U
      158           v-fmtcli-bank-bik           = "":U
      159           v-fmtcli-bank-name          = "":U
      160           v-fmtcli-bank-addres        = "":U
      161           v-fmtcli-bank-city          = "":U
      162       .
      163       search-for-schet:
      164       for each buf_fin-schet no-lock
      165          where buf_fin-schet.host-code = p-host-code
      166            and buf_fin-schet.cli-type  = p-obj-type
      167            and buf_fin-schet.cli-code  = p-obj-code
      168            and buf_fin-schet.curr-code = p-curr-code
      169       on error undo, return error
      170       :
      171           if buf_fin-schet.status_   = 'удал':U
      172           then do:
      173           end.
      174           else do:
      175               assign
      176                   v-fmtcli-schet-exists   = yes
      177                   v-fmtcli-bank-r-schet   = trim( buf_fin-schet.r-schet )
      178                   v-fmtcli-bank-c-schet   = trim( buf_fin-schet.c-schet )
      179               .
      180               find first buf_fin-bank no-lock
      181                    where buf_fin-bank.host-code = p-host-code
      182                      and buf_fin-bank.code-bank = buf_fin-schet.code-bank
      183               no-error.
      184               if available buf_fin-bank
      185               then do:
      186                   assign
      187                       v-fmtcli-bank-exists      = yes
      188                       v-fmtcli-bank-bik         = trim( buf_fin-bank.bik )
      189                       v-fmtcli-bank-name        = trim( buf_fin-bank.bank-name )
      190                       v-fmtcli-bank-addres      = trim(buf_fin-bank.addres)
      191                       v-fmtcli-bank-city      = trim(buf_fin-bank.bank-city)
      192                   .
      193               end.
      194               else do:
      195                   assign
      196                       v-fmtcli-bank-exists    = no
      197                       v-fmtcli-bank-bik       = "":U
      198                       v-fmtcli-bank-name      = "":U
      199                       v-fmtcli-bank-addres    = "":U
      200                       v-fmtcli-bank-city      = "":U
      201                   .
      202               end.
      203               leave search-for-schet.
      204           end.
      205       end.
      206   end.
      207   end procedure.
      208   procedure fmtcli-get-client :
      209   define input parameter p-obj-type       as character    no-undo.
      210   define input parameter p-obj-code       as integer      no-undo.
      211       define variable v-temp-fmtcli-address      as character     no-undo.
      212       define variable v-num-country-city    as integer      no-undo.
      213       define buffer buf_clients   for ub.clients.
      214       define buffer buf_firm      for ub.firm.
      215       define buffer buf_store     for ub.store.
      216       define buffer buf_shop      for ub.shop.
      217       define buffer buf_person    for ub.person.
      218   do
      219   for buf_clients
      220     , buf_firm
      221     , buf_store
      222     , buf_shop
      223     , buf_person
      224   on error undo, return error
      225   :
      226       assign
      227           v-fmtcli-name           = "":U
      228           v-fmtcli-addres         = "":U
      229           v-fmtcli-post-addres    = "":U
      230           v-fmtcli-full-addres    = "":U
      231           v-fmtcli-phone          = "":U
      232           v-fmtcli-inn            = "":U
      233           v-fmtcli-kpp            = "":U
      234           v-fmtcli-okpo           = "":U
      235           v-fmtcli-city           = "":U
      236           v-fmtcli-index          = "":U
      237           v-fmtcli-country        = "":U
      238       .
      239       find first buf_clients no-lock
      240            where buf_clients.obj-type = p-obj-type
      241              and buf_clients.obj-code = p-obj-code
      242       .
      243       assign
      244           v-fmtcli-name = buf_clients.obj-name
      245       .
      246       case buf_clients.obj-type:
      247          when 'орг':U
      248          then do:
      249               find first buf_firm no-lock
      250                    where buf_firm.firm-code = buf_clients.obj-code
      251                    no-error
      252               .
      253               if available buf_firm
      254               then do:
      255                   assign
      256                       v-num-country-city = num-entries( buf_firm.city )
      257                       v-fmtcli-engl-name = buf_firm.engl-name
      258                   .
      259                   if v-num-country-city > 0
      260                   then do:
      261                       assign
      262                           v-fmtcli-country    = trim( entry( 1, buf_firm.city ) )
      263                       .
      264                   end.
      265                   if v-num-country-city > 1
      266                   then do:
      267                       assign
      268                           v-fmtcli-city       = trim( entry( 2, buf_firm.city ) )
      269                       .
      270                   end.
      271                   run fmtcli-concatenate-strings in this-procedure (
      272                         input v-fmtcli-full-addres
      273                       , input v-fmtcli-country
      274                       , input ", ":U
      275                       , input 50
      276                       , output v-fmtcli-full-addres
      277                   ).
      278                   run fmtcli-concatenate-strings in this-procedure (
      279                         input v-fmtcli-full-addres
      280                       , input v-fmtcli-city
      281                       , input ", ":U
      282                       , input 50
      283                       , output v-fmtcli-full-addres
      284                   ).
      285                   run fmtcli-concatenate-strings in this-procedure (
      286                         input v-fmtcli-full-addres
      287                       , input IF buf_firm.ind = 0 THEN "" ELSE string( buf_firm.ind )
      288                       , input ", ":U
      289                       , input 50
      290                       , output v-fmtcli-full-addres
      291                   ).
      292                   run fmtcli-concatenate-strings in this-procedure (
      293                         input v-fmtcli-post-addres
      294                       , input v-fmtcli-country
      295                       , input ", ":U
      296                       , input 50
      297                       , output v-fmtcli-post-addres
      298                   ).
      299                   run fmtcli-concatenate-strings in this-procedure (
      300                         input v-fmtcli-post-addres
      301                       , input v-fmtcli-city
      302                       , input ", ":U
      303                       , input 50
      304                       , output v-fmtcli-post-addres
      305                   ).
      306                   run fmtcli-concatenate-strings in this-procedure (
      307                         input v-fmtcli-post-addres
      308                       , input string( buf_firm.ind )
      309                       , input ", ":U
      310                       , input 50
      311                       , output v-fmtcli-post-addres
      312                   ).
      313                   run fmtcli-concatenate-strings in this-procedure (
      314                         input substring( buf_firm.addres1, 1, 50 )
      315                       , input buf_firm.addres2
      316                       , input " ":U
      317                       , input 50
      318                       , output v-temp-fmtcli-address
      319                   ).
      320                   run fmtcli-concatenate-strings in this-procedure (
      321                         input v-temp-fmtcli-address
      322                       , input substring( buf_firm.addres1, 51, 50 )
      323                       , input " ":U
      324                       , input 50
      325                       , output v-temp-fmtcli-address
      326                   ).
      327                   run fmtcli-concatenate-strings in this-procedure (
      328                         input v-temp-fmtcli-address
      329                       , input substring( buf_firm.addres1, 101, 50 )
      330                       , input " ":U
      331                       , input 50
      332                       , output v-temp-fmtcli-address
      333                   ).
      334                   assign
      335                       v-fmtcli-addres = v-temp-fmtcli-address
      336                   .
      337                   if buf_firm.addres1 <> ?
      338                   then do:
      339                       run fmtcli-concatenate-strings in this-procedure (
      340                             input v-fmtcli-full-addres
      341                           , input v-fmtcli-addres
      342                           , input ", ":U
      343                           , input 0
      344                           , output v-fmtcli-full-addres
      345                       ).
      346                   end.
      347                   run fmtcli-concatenate-strings in this-procedure (
      348                         input substring( buf_firm.post-addr1, 1, 50 )
      349                       , input buf_firm.post-addr2
      350                       , input " ":U
      351                       , input 50
      352                       , output v-fmtcli-post-addres
      353                   ).
      354                   run fmtcli-concatenate-strings in this-procedure (
      355                         input v-fmtcli-post-addres
      356                       , input substring( buf_firm.post-addr1, 51, 50 )
      357                       , input " ":U
      358                       , input 50
      359                       , output v-fmtcli-post-addres
      360                   ).
      361                   run fmtcli-concatenate-strings in this-procedure (
      362                         input v-fmtcli-post-addres
      363                       , input substring( buf_firm.post-addr1, 101, 50 )
      364                       , input " ":U
      365                       , input 50
      366                       , output v-fmtcli-post-addres
      367                   ).
      368                   assign
      369                       v-fmtcli-phone         = buf_firm.phone
      370                       v-fmtcli-inn           = buf_firm.inn
      371                       v-fmtcli-kpp           = buf_firm.kpp
      372                       v-fmtcli-okpo          = buf_firm.okpo
      373                       v-fmtcli-index         = string( buf_firm.ind )
      374                   .
      375               end.
      376          end.
      377          when 'маг':U
      378          then do:
      379               find first buf_shop no-lock
      380                    where buf_shop.obj-code = buf_clients.obj-code
      381               .
      382               if available buf_shop
      383               then do:
      384                   run fmtcli-concatenate-strings in this-procedure (
      385                         input buf_shop.addres1
      386                       , input buf_shop.addres2
      387                       , input " ":U
      388                       , input 50
      389                       , output v-fmtcli-addres
      390                   ).
      391                   assign
      392                       v-fmtcli-full-addres = v-fmtcli-addres
      393                       v-fmtcli-post-addres = v-fmtcli-addres
      394                       v-fmtcli-phone       = buf_shop.phone
      395                       v-fmtcli-inn         = "":U
      396                       v-fmtcli-kpp         = "":U
      397                       v-fmtcli-okpo        = "":U
      398                       v-fmtcli-city        = "":U
      399                       v-fmtcli-index       = "":U
      400                   .
      401               end.
      402          end.
      403          when 'скл':U
      404          then do:
      405               find first buf_store no-lock
      406                    where buf_store.obj-code = buf_clients.obj-code
      407               .
      408               if available buf_store
      409               then do:
      410                   run fmtcli-concatenate-strings in this-procedure (
      411                         input buf_store.addres1
      412                       , input buf_store.addres2
      413                       , input " ":U
      414                       , input 50
      415                       , output v-fmtcli-addres
      416                   ).
      417                   assign
      418                       v-fmtcli-full-addres = v-fmtcli-addres
      419                       v-fmtcli-phone       = buf_store.phone
      420                       v-fmtcli-inn         = "":U
      421                       v-fmtcli-kpp         = "":U
      422                       v-fmtcli-okpo        = "":U
      423                       v-fmtcli-city        = "":U
      424                       v-fmtcli-index       = "":U
      425                   .
      426               end.
      427          end.
      428          when 'чел':U
      429          then do:
      430               find first buf_person no-lock
      431                    where buf_person.psn-code = buf_clients.obj-code
      432               .
      433               if available buf_person
      434               then do:
      435                   run fmtcli-concatenate-strings in this-procedure (
      436                         input ( if buf_person.ind = 0 or buf_person.ind = ?
      437                                 then "":U
      438                                 else string( buf_person.ind, "999999")
      439                                 )
      440                       , input buf_person.city
      441                       , input ", ":U
      442                       , input 0
      443                       , output v-fmtcli-full-addres
      444                   ).
      445                   assign
      446                       v-fmtcli-addres = buf_person.address
      447                   .
      448                   run fmtcli-concatenate-strings in this-procedure (
      449                         input v-fmtcli-full-addres
      450                       , input v-fmtcli-addres
      451                       , input ", ":U
      452                       , input 0
      453                       , output v-fmtcli-full-addres
      454                   ).
      455                   assign
      456                       v-fmtcli-phone     = buf_person.phone1
      457                       v-fmtcli-inn       = buf_person.inn
      458                       v-fmtcli-kpp       = buf_person.kpp
      459                       v-fmtcli-okpo      = buf_person.okpo
      460                       v-fmtcli-city      = buf_person.city
      461                       v-fmtcli-index     = string( buf_person.ind )
      462                   .
      463               end.
      464          end.
      465       end case.
      466   end.
      467   end procedure.
      468   procedure fmtcli-concatenate-strings :
      469   define input parameter p-string-1       as character        no-undo.
      470   define input parameter p-string-2       as character        no-undo.
      471   define input parameter p-delimiter      as character        no-undo.
      472   define input parameter p-length         as integer          no-undo.
      473   define output parameter p-out-string    as character        no-undo.
      474   do
      475   on error undo, return error
      476   :
      477       assign
      478           p-out-string = ( if p-string-1 = ?
      479                            then "":U
      480                            else trim( p-string-1 ) )
      481       .
      482       assign
      483           p-out-string = p-out-string
      484                        + ( if p-out-string = "":U
      485                            or length( p-out-string ) = p-length
      486                            or p-string-2 = ?
      487                            or trim( p-string-2 ) = "":U
      488                            then "":U
      489                            else p-delimiter )
      490                        + ( if p-string-2 = ?
      491                            or trim( p-string-2 ) = "":U
      492                            then "":U
      493                            else trim( p-string-2 ) )
      494       .
      495   end.
      496   end procedure.
      497   def var vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      498   define new global shared variable g#attr-lib  as handle no-undo .
      499   define variable v-attr-lib-variable as handle no-undo .
      500   procedure clntattr-code :
      501     define input  parameter p-code           as character no-undo .
      502     define output parameter p-type           as character no-undo .
      503     define output parameter p-format         as character no-undo .
      504     define output parameter p-label          as character no-undo .
      505     define output parameter p-user-can-edit  as logical   no-undo .
      506     define output parameter p-output-display as logical   no-undo .
      507     define output parameter p-other          as character no-undo .
      508     do
      509     on error undo, return error return-value
      510     :
      511           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clntattr-code in g#attr-lib
      512         (input  p-code
      513         ,output p-type
      514         ,output p-format
      515         ,output p-label
      516         ,output p-user-can-edit
      517         ,output p-output-display
      518         ,output p-other
      519         ) no-error .
      520       if error-status :error
      521       then do:
      522         undo, return error return-value .
      523       end.
      524     end.
      525   end procedure.
      526   procedure clntattr-tooltip :
      527     define input  parameter p-code    as character no-undo .
      528     define output parameter p-tooltip as character no-undo .
      529     define output parameter p-label   as character no-undo .
      530     do
      531     on error undo, return error return-value
      532     :
      533           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clntattr-tooltip in g#attr-lib
      534         (input  p-code
      535         ,output p-tooltip
      536         ,output p-label
      537         ) no-error .
      538       if error-status :error
      539       then do:
      540         undo, return error return-value .
      541       end.
      542     end.
      543   end procedure.
      544   procedure clntattr-value :
      545     define input  parameter p-obj-type like ub.clients-attr.obj-type   no-undo .
      546     define input  parameter p-obj-code like ub.clients-attr.obj-code   no-undo .
      547     define input  parameter p-code     like ub.clients-attr.attr-code  no-undo .
      548     define output parameter p-value    like ub.clients-attr.attr-value no-undo .
      549     define output parameter p-type     as character no-undo .
      550     do
