     5441     ,input  bf_trn-doc.fact-order
     5442     ,output vardoc-num
     5443     ,output varprice-sale
     5444     ,output varroad-tax
     5445     ,output varexcise
     5446     ,output varcur-vat-pc
     5447     ,output varcur-slt-pc
