     1418   procedure torgconf-get-recepient-param :
     1419   define input parameter torgconfdoc-code   as character                  no-undo.
     1420   define output parameter v-code-rec        as integer                    no-undo .
     1421   define output parameter v-type-rec        as character                  no-undo initial 'C':U.
     1422   define output parameter v-codefirm-rec    as integer                    no-undo .
     1423   define output parameter v-curcode-rec     as integer                    no-undo .
     1424        define variable  v-recipient-code  as character                  no-undo .
     1425        define variable  v-recipient       like ub.doc-attr.attr-value   no-undo.
     1426        define variable  v-trdcattr-type   as character                  no-undo initial 'C':U.
     1427   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input torgconfdoc-code ,
     1428                           input 'Recipient':U ,
     1429                          output v-recipient-code ,
     1430                          output v-trdcattr-type ) no-error .
     1431       if error-status :error then do:
     1432        message
     1433         vss-workfile vss-revision vss-description skip
     1434         "Ошибка при вызове процедуры tdat-val":U skip
     1435         "Документ: " torgconfdoc-code skip
     1436         "Атрибут: " 'Recipient':U skip
     1437         "Значение: " v-recipient skip
     1438         trim( error-status :get-message (1) ) skip
     1439         return-value skip
     1440         view-as alert-box error.
     1441       undo, return error return-value.
     1442       end.
     1443     assign
     1444       v-recipient  = v-recipient-code
     1445       v-type-rec = substring(v-recipient-code,1,3)
     1446       v-code-rec  = int(substring(v-recipient-code,4,15))
     1447       no-error
     1448     .
     1449     if v-type-rec = ? then v-type-rec = "" .
     1450     if v-code-rec  = ? then v-code-rec  =  0 .
     1451     end procedure.
