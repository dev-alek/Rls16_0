     4904       bfs_tt-allsum.road-tax-rubl-cur   =  - bf_tt-allsum.road-tax-rubl-cur
     4905       bfs_tt-allsum.excise-base-cur     =  - bf_tt-allsum.excise-base-cur
     4906       bfs_tt-allsum.excise-rubl-cur     =  - bf_tt-allsum.excise-rubl-cur
