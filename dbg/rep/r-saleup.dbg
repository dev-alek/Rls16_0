     2249               if Make-Excel then  put   stream ForExcel unformatted buf_clients.obj-name skip.
     2250             end.
     2251             run print-line in this-procedure (input recid(tt-line)) .
     2252             if last-of(tt-line.prod-code) then do:
     2253               find first tt-sum where tt-sum.obj-type  = tt-line.obj-type  and
