     1851   Procedure fill-tt :
     1852     define input parameter p-artic     like goods.artic     no-undo.
     1853     define input parameter p-prod-type like goods.prod-type no-undo.
     1854     define input parameter p-prod-code like goods.prod-code no-undo.
     1855     define input parameter p-gds-code  like goods.gds-code  no-undo.
     1856     define input parameter p-grp-name  like goods.grp-name  no-undo.
     1857   find first buf_goods where buf_goods.gds-code = p-gds-code no-lock .
     1858     DEFINE BUFFER b_bar-code FOR  ub.bar-code .
     1859     DEFINE BUFFER buf_prod-bc  FOR  ub.prod-bc.
     1860     DEFINE BUFFER buf_place    FOR  ub.place.
     1861     DEFINE VARIABLE v-cResult  AS CHARACTER NO-UNDO INITIAL "".
     1862     DEFINE VARIABLE v-cType-bc AS CHARACTER NO-UNDO INITIAL "".
     1863     DEFINE VARIABLE v-dWeight  AS DECIMAL   NO-UNDO INITIAL 0.
     1864   for first buf_bar-code where buf_bar-code.gds-code = p-gds-code  and buf_bar-code.unit-cli = buf_goods.unit-base  no-lock,
     1865          each  tt-chk-gds where tt-chk-gds.b-code = buf_bar-code.b-code  and tt-chk-gds.obj-type = obj-list.obj-type and
     1866                                    tt-chk-gds.obj-code = obj-list.obj-code and tt-chk-gds.doc-qnty <> tt-chk-gds.src-qnty  no-lock break by tt-chk-gds.src-code
     1867           :
     1868   if (valid-handle(g#libbcrcn) <> true) then do:   run str/libbcrcn.p persistent no-error .   if error-status :error or (valid-handle(g#libbcrcn) <> true) then do:     message       "Error starting libbcrcn.p" skip       g#libbcrcn skip       g#libbcrcn :type skip       g#libbcrcn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libbcrcn_bc-rcnz in g#libbcrcn
     1869   (
     1870    input  parparentproc
     1871   ,input  tt-chk-gds.src-code
     1872   ,input  ?
     1873   ,input  obj-list.obj-type
     1874   ,input  obj-list.obj-code
     1875   ,input  yes
     1876   ,input  no
     1877   ,input  varscales-pref
     1878   ,input  varpgscales-pref
     1879   ,output v-cResult
     1880   ,output v-cType-bc
     1881   ,output v-dWeight
     1882   ,buffer b_bar-code
     1883   ,buffer buf_prod-bc
     1884   ,buffer buf_place
     1885   ) no-error.
     1886             if not available b_bar-code then next.
     1887               if p-det-obj then do :
     1888                 find first tt-line where tt-line.gds-code = p-gds-code        and
     1889                                          tt-line.obj-type = obj-list.obj-type and
     1890                                          tt-line.obj-code = obj-list.obj-code and
     1891                                          tt-line.unit     = b_bar-code.unit-cli  and
     1892                                          tt-line.rate     = b_bar-code.cli-base-rate
     1893                                           no-lock no-error.
     1894                 if not available tt-line then do :
     1895                   create tt-line.
     1896                   assign
     1897                     tt-line.artic     = p-artic
     1898                     tt-line.prod-code = p-prod-code
     1899                     tt-line.prod-type = p-prod-type
     1900                     tt-line.gds-code  = p-gds-code
     1901                     tt-line.gds-name  = buf_goods.gds-name
     1902                     tt-line.obj-type  = obj-list.obj-type
     1903                     tt-line.obj-code  = obj-list.obj-code
     1904                     tt-line.obj-name  = obj-list.obj-name
     1905                     tt-line.grp-name  = p-grp-name
     1906                     tt-line.unit      = b_bar-code.unit-cli
     1907                     tt-line.rate      = b_bar-code.cli-base-rate
     1908                     tt-line.qnty      = 0
     1909                     tt-line.sum       = 0
     1910                   .
     1911                 end.
     1912                 assign
     1913                   tt-line.qnty = tt-line.qnty + tt-chk-gds.src-qnty
     1914                   tt-line.sum  = tt-line.sum  + tt-chk-gds.sum-base
     1915                   v-sum-itog   = v-sum-itog   + tt-chk-gds.sum-base
     1916                 .
     1917                 find first bf1_tt-sum where bf1_tt-sum.obj-type = obj-list.obj-type   and
     1918                                             bf1_tt-sum.obj-code = obj-list.obj-code   and
     1919                                             bf1_tt-sum.prod-type = "-1"               and
     1920                                             bf1_tt-sum.prod-code = -1                 and
     1921                                             bf1_tt-sum.grp-name  = "-1"               no-lock no-error.
     1922                 if not available bf1_tt-sum then do :
     1923                   create bf1_tt-sum.
     1924                   assign
     1925                     bf1_tt-sum.obj-type = obj-list.obj-type
     1926                     bf1_tt-sum.obj-code = obj-list.obj-code
     1927                     bf1_tt-sum.prod-type = "-1"
     1928                     bf1_tt-sum.prod-code = -1
     1929                     bf1_tt-sum.grp-name  = "-1"
     1930                     bf1_tt-sum.sum      = 0
     1931                   .
     1932                 end.
     1933                 bf1_tt-sum.sum = bf1_tt-sum.sum + tt-chk-gds.sum-base.
     1934                 find first bf2_tt-sum where bf2_tt-sum.obj-type  = obj-list.obj-type  and
     1935                                         bf2_tt-sum.obj-code  = obj-list.obj-code  and
     1936                                         bf2_tt-sum.prod-type = p-prod-type        and
     1937                                         bf2_tt-sum.prod-code = p-prod-code        and
     1938                                         bf2_tt-sum.grp-name  = "-1"               no-lock no-error.
     1939                 if not available bf2_tt-sum then do :
     1940                   create bf2_tt-sum.
     1941                   assign
     1942                     bf2_tt-sum.obj-type  = obj-list.obj-type
     1943                     bf2_tt-sum.obj-code  = obj-list.obj-code
     1944                     bf2_tt-sum.prod-type = p-prod-type
     1945                     bf2_tt-sum.prod-code = p-prod-code
     1946                     bf2_tt-sum.grp-name  = "-1"
     1947                     bf2_tt-sum.sum       = 0
     1948                   .
     1949                 end.
     1950                 bf2_tt-sum.sum = bf2_tt-sum.sum + tt-chk-gds.sum-base.
     1951                 find first bf3_tt-sum where bf3_tt-sum.obj-type  = obj-list.obj-type  and
     1952                                         bf3_tt-sum.obj-code  = obj-list.obj-code  and
     1953                                         bf3_tt-sum.prod-type = "-1"               and
     1954                                         bf3_tt-sum.prod-code = -1                 and
     1955                                         bf3_tt-sum.grp-name  = p-grp-name         no-lock no-error.
     1956                 if not available bf3_tt-sum then do :
     1957                   create bf3_tt-sum.
     1958                   assign
     1959                     bf3_tt-sum.obj-type  = obj-list.obj-type
     1960                     bf3_tt-sum.obj-code  = obj-list.obj-code
     1961                     bf3_tt-sum.prod-type = "-1"
     1962                     bf3_tt-sum.prod-code = -1
     1963                     bf3_tt-sum.grp-name  = p-grp-name
     1964                     bf3_tt-sum.sum       = 0
     1965                   .
     1966                 end.
     1967                 bf3_tt-sum.sum = bf3_tt-sum.sum + tt-chk-gds.sum-base.
     1968                 find first bf4_tt-sum where bf4_tt-sum.obj-type  = obj-list.obj-type  and
     1969                                         bf4_tt-sum.obj-code  = obj-list.obj-code  and
     1970                                         bf4_tt-sum.prod-type = p-prod-type        and
     1971                                         bf4_tt-sum.prod-code = p-prod-code        and
     1972                                         bf4_tt-sum.grp-name  = p-grp-name         no-lock no-error.
     1973                 if not available bf4_tt-sum then do :
     1974                   create bf4_tt-sum.
     1975                   assign
     1976                     bf4_tt-sum.obj-type  = obj-list.obj-type
     1977                     bf4_tt-sum.obj-code  = obj-list.obj-code
     1978                     bf4_tt-sum.prod-type = p-prod-type
     1979                     bf4_tt-sum.prod-code = p-prod-code
     1980                     bf4_tt-sum.grp-name  = p-grp-name
     1981                     bf4_tt-sum.sum       = 0
     1982                   .
     1983                 end.
     1984                 bf4_tt-sum.sum = bf4_tt-sum.sum + tt-chk-gds.sum-base.
     1985               end.
     1986               else do :
     1987                 find first tt-line where tt-line.gds-code = p-gds-code and
     1988                                          tt-line.unit     = b_bar-code.unit-cli  and
     1989                                          tt-line.rate     = b_bar-code.cli-base-rate
     1990                                          no-lock no-error.
     1991                 if not available tt-line then do :
     1992                   create tt-line.
     1993                   assign
     1994                     tt-line.artic     = p-artic
     1995                     tt-line.prod-code = p-prod-code
     1996                     tt-line.prod-type = p-prod-type
     1997                     tt-line.gds-code  = p-gds-code
     1998                     tt-line.gds-name  = buf_goods.gds-name
     1999                     tt-line.grp-name  = p-grp-name
     2000                     tt-line.unit      = b_bar-code.unit-cli
     2001                     tt-line.rate      = b_bar-code.cli-base-rate
     2002                     tt-line.qnty      = 0
     2003                     tt-line.sum       = 0
     2004                   .
     2005                 end.
     2006                 assign
     2007                   tt-line.qnty = tt-line.qnty + tt-chk-gds.src-qnty
     2008                   tt-line.sum  = tt-line.sum  + tt-chk-gds.sum-base
     2009                   v-sum-itog   = v-sum-itog   + tt-chk-gds.sum-base
     2010                 .
     2011               end.
     2012                 find first bf5_tt-sum where bf5_tt-sum.obj-type  = "-1"               and
     2013                                         bf5_tt-sum.obj-code  = -1                 and
     2014                                         bf5_tt-sum.prod-type = p-prod-type        and
     2015                                         bf5_tt-sum.prod-code = p-prod-code        and
     2016                                         bf5_tt-sum.grp-name  = "-1"               no-lock no-error.
     2017                 if not available bf5_tt-sum then do :
     2018                   create bf5_tt-sum.
     2019                   assign
     2020                     bf5_tt-sum.obj-type  = "-1"
     2021                     bf5_tt-sum.obj-code  = -1
     2022                     bf5_tt-sum.prod-type = p-prod-type
     2023                     bf5_tt-sum.prod-code = p-prod-code
     2024                     bf5_tt-sum.grp-name  = "-1"
     2025                     bf5_tt-sum.sum       = 0
     2026                   .
     2027                 end.
     2028                 bf5_tt-sum.sum = bf5_tt-sum.sum + tt-chk-gds.sum-base.
     2029                 find first bf6_tt-sum where bf6_tt-sum.obj-type  = "-1"               and
     2030                                         bf6_tt-sum.obj-code  = -1                 and
     2031                                         bf6_tt-sum.grp-name  = p-grp-name         and
     2032                                         bf6_tt-sum.prod-type = "-1"               and
     2033                                         bf6_tt-sum.prod-code = -1                 no-lock no-error.
     2034                 if not available bf6_tt-sum then do :
     2035                   create bf6_tt-sum.
     2036                   assign
     2037                     bf6_tt-sum.obj-type  = "-1"
     2038                     bf6_tt-sum.obj-code  = -1
     2039                     bf6_tt-sum.grp-name  = p-grp-name
     2040                     bf6_tt-sum.prod-type = "-1"
     2041                     bf6_tt-sum.prod-code = -1
     2042                     bf6_tt-sum.sum       = 0
     2043                   .
     2044                 end.
     2045                 bf6_tt-sum.sum = bf6_tt-sum.sum + tt-chk-gds.sum-base.
     2046                 find first bf7_tt-sum where bf7_tt-sum.obj-type  = "-1"               and
     2047                                         bf7_tt-sum.obj-code  = -1                 and
     2048                                         bf7_tt-sum.prod-type = p-prod-type        and
     2049                                         bf7_tt-sum.prod-code = p-prod-code        and
     2050                                         bf7_tt-sum.grp-name  = p-grp-name         no-lock no-error.
     2051                 if not available bf7_tt-sum then do :
     2052                   create bf7_tt-sum.
     2053                   assign
     2054                     bf7_tt-sum.obj-type  = "-1"
     2055                     bf7_tt-sum.obj-code  = -1
     2056                     bf7_tt-sum.prod-type = p-prod-type
     2057                     bf7_tt-sum.prod-code = p-prod-code
     2058                     bf7_tt-sum.grp-name  = p-grp-name
     2059                     bf7_tt-sum.sum       = 0
     2060                   .
     2061                 end.
     2062                 bf7_tt-sum.sum = bf7_tt-sum.sum + tt-chk-gds.sum-base.
     2063         end.
     2064   end.
     2065   procedure print-line :
     2066     define input parameter p-line-recid as recid no-undo.
     2067     for tt-line field (artic
     2068                        gds-code
     2069                        gds-name
     2070                        unit
     2071                        rate
     2072                        qnty
     2073                        sum     ) where recid (tt-line) = p-line-recid no-lock :
     2074       if Make-Excel then  put   stream ForExcel unformatted
     2075                 tt-line.artic     CHR(9)
     2076                 tt-line.gds-code  CHR(9)
     2077                 tt-line.gds-name  CHR(9)
     2078                 tt-line.unit      CHR(9)
     2079                 tt-line.rate      CHR(9)
     2080                 tt-line.qnty      CHR(9)
     2081                 (tt-line.rate * tt-line.qnty)      CHR(9)
     2082                 tt-line.sum       CHR(9)
     2083       skip.
     2084     end.
     2085   end.
     2086   procedure print-header :
     2087   find first sheetf where sheet-num = 1 .
     2088       assign
     2089       Sheetf.MergeCellsH = ""
     2090       Sheetf.MergeCellsV = ""
     2091       Sheetf.Excel-Column-Lable = "Артикул" + chr(44) +
     2092                            "Код" + chr(44) +
     2093                            "Наименование" + chr(44) +
     2094                            "Ед. Изм." + chr(44) +
     2095                            "Коэффициент" + chr(44) +
     2096                            "Оборот в количестве упаковок. (Продажа-возврат)" + chr(44) +
     2097                            "Оборот в количестве в пересчёте на штуки. (Продажа-возврат)" + chr(44) +
     2098                            "Сумма в продажных ценах"
     2099       Sheetf.Sizes = "10,10,80,5,10,15,15,20"
     2100       Sheetf.colformat = "1=@;2=@;3=@;4=@;5=0;6=0;7=0;8=0,00;"
     2101       .
     2102     RUN rep/extitle.p (1).
     2103   end.
     2104   procedure class1 :
     2105     do on error undo, return error return-value :
     2106     if not p-det-obj then do :
     2107       case SortType:
     2108         when 1 then do:
     2109           for each tt-line break by tt-line.gds-code :  run print-line in this-procedure (input recid(tt-line)) .  end.
     2110         end.
     2111         when 2 then do:
     2112           for each tt-line break by tt-line.artic :     run print-line in this-procedure (input recid(tt-line)) .  end.
     2113         end.
     2114         when 3 then do:
     2115           for each tt-line break by tt-line.gds-name :  run print-line in this-procedure (input recid(tt-line)) .  end.
     2116         end.
     2117       end case.
     2118     end.
     2119     if  p-det-obj then do :
     2120       case SortType:
     2121         when 1 then do:
     2122           for each tt-line break by tt-line.obj-type by tt-line.obj-code by tt-line.gds-code :
     2123             if first-of(tt-line.obj-code) then if Make-Excel then  put   stream ForExcel unformatted tt-line.obj-name skip.
     2124             run print-line in this-procedure (input recid(tt-line)) .
     2125             if last-of(tt-line.obj-code) then do:
     2126               find first tt-sum where tt-sum.obj-type = tt-line.obj-type and
     2127                                       tt-sum.obj-code = tt-line.obj-code and
     2128                                       tt-sum.prod-type = "-1"            and
     2129                                       tt-sum.prod-code = -1              and
     2130                                       tt-sum.grp-name  = "-1"            no-lock no-error.
     2131               if Make-Excel then  put   stream ForExcel unformatted CHR(9) CHR(9) CHR(9) CHR(9)
     2132                           ("Итого по " + string(tt-line.obj-name) + " :")         CHR(9) CHR(9) CHR(9)
     2133                           tt-sum.sum
     2134               skip.
     2135             end.
     2136           end.
     2137         end.
     2138         when 2 then do:
     2139           for each tt-line break by tt-line.obj-type by tt-line.obj-code by tt-line.artic :
     2140             if first-of(tt-line.obj-code) then if Make-Excel then  put   stream ForExcel unformatted tt-line.obj-name skip.
     2141             run print-line in this-procedure (input recid(tt-line)) .
     2142             if last-of(tt-line.obj-code) then do:
     2143               find first tt-sum where tt-sum.obj-type = tt-line.obj-type and
     2144                                       tt-sum.obj-code = tt-line.obj-code and
     2145                                       tt-sum.prod-type = "-1"            and
     2146                                       tt-sum.prod-code = -1              and
     2147                                       tt-sum.grp-name  = "-1"            no-lock no-error.
     2148               if Make-Excel then  put   stream ForExcel unformatted CHR(9) CHR(9) CHR(9) CHR(9)
     2149                           ("Итого по " + string(tt-line.obj-name) + " :")         CHR(9) CHR(9) CHR(9)
     2150                           tt-sum.sum
     2151               skip.
     2152             end.
     2153           end.
     2154         end.
     2155         when 3 then do:
     2156           for each tt-line break by tt-line.obj-type by tt-line.obj-code by tt-line.gds-name :
     2157             if first-of(tt-line.obj-code) then if Make-Excel then  put   stream ForExcel unformatted tt-line.obj-name skip.
     2158             run print-line in this-procedure (input recid(tt-line)) .
     2159             if last-of(tt-line.obj-code) then do:
     2160               find first tt-sum where tt-sum.obj-type = tt-line.obj-type and
     2161                                       tt-sum.obj-code = tt-line.obj-code and
     2162                                       tt-sum.prod-type = "-1"            and
     2163                                       tt-sum.prod-code = -1              and
     2164                                       tt-sum.grp-name  = "-1"            no-lock no-error.
     2165               if Make-Excel then  put   stream ForExcel unformatted CHR(9) CHR(9) CHR(9) CHR(9)
     2166                           ("Итого по " + string(tt-line.obj-name) + " :")         CHR(9) CHR(9) CHR(9)
     2167                           tt-sum.sum
     2168               skip.
     2169             end.
     2170           end.
     2171         end.
     2172       end case.
     2173     end.
     2174     end.
     2175   end procedure.
