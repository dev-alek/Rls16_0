     1448   define variable v-account as integer init 0 no-undo .
     1449   define variable v-account-lavel as character no-undo .
     1450   define variable v-button-stop as logical no-undo .
     1451   define variable v-kol-spice as integer no-undo .
     1452   define variable v-kol-spice2 as integer no-undo .
     1453   define variable v-kol-spice3 as integer no-undo .
     1454   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     1455   DEFINE BUTTON StopBtn AUTO-END-KEY
     1456        LABEL "Стоп"
     1457        SIZE 10 BY 1.
     1458   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     1459        LABEL "Обработано записей"
     1460         VIEW-AS TEXT
     1461        SIZE 14 BY .67 NO-UNDO.
     1462   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     1463         VIEW-AS TEXT
     1464        SIZE 53.25 BY .67
     1465        FGCOLOR 1  NO-UNDO.
     1466   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     1467         VIEW-AS TEXT
     1468        SIZE 53.25 BY .67
     1469        FGCOLOR 1  NO-UNDO.
     1470   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     1471         VIEW-AS TEXT
     1472        SIZE 53.25 BY .67
     1473        FGCOLOR 1  NO-UNDO.
     1474   DEFINE RECTANGLE RECT-1
     1475        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1476        SIZE 55.13 BY 4.46.
     1477   DEFINE FRAME InfoFrame
     1478        StopBtn AT ROW 4.25 COL 21.75
     1479        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     1480        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     1481        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     1482        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     1483        RECT-1 AT ROW 1 COL 1
     1484       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1485            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1486            TITLE "Процесс"
     1487            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     1488   define variable mFrameView      as logical   no-undo init yes.
     1489     define variable mFramHandle as handle no-undo.
     1490     mFramHandle = frame InfoFrame:handle.
     1491     if  log-manager:logfile-name ne ?
     1492     then DO:
     1493         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1494         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1495         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     1496     end.
     1497     mFrameView = not session:batch-mode and mFramHandle:visible.
     1498     if mFrameView
     1499     then do:
     1500       ASSIGN
     1501          FRAME InfoFrame:HIDDEN                           = TRUE
     1502          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     1503     end.
     1504   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     1505   DO:
     1506     IF not StopProcessing THEN
     1507       Message "Вы действительно хотите прервать" SKIP
     1508               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     1509                 UPDATE StopProcessing.
     1510     IF StopProcessing THEN do:
     1511        if mFrameView
     1512        then do:
     1513           HIDE FRAME InfoFrame.
     1514        end.
     1515     End.
     1516   END.
