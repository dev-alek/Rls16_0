     1251   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     1252   procedure paramls-clear :
     1253     define buffer buf_temp-param for temp-param .
     1254     do
     1255     on error undo, return error return-value
     1256     :
     1257       for each buf_temp-param
     1258       on error undo, return error
