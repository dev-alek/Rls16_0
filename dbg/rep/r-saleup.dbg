      574   define variable vss-include-info7 as character format "X(65)" no-undo
      575   initial "@(#)$Workfile$ $Revision$".
      576   define temp-table temp_grplib_grp no-undo
      577       field sel           as character
      578       field nabor         as character
      579       field full-name     as character
      580       field print-code    as character
      581       field sort-name     as character
      582       field node-code     as integer
      583       field upper-code    as integer
      584       field calc-method   as character
      585       field round-method  as character
      586       field increase-pc   as decimal
      587       field min-marg      as character
      588       field max-marg      as character
      589       field cli-type      as character
      590       field cli-code      as integer
      591       field notcorr      as character
      592       field name          as character
      593       field level         as integer
      594       field mark          as character
      595       index pi is primary unique sort-name
      596       index fn full-name
      597       index nc is unique node-code
      598       index sl sel
      599       index uc upper-code
      600   .
      601   define temp-table temp_grplib_found-grp no-undo
      602       field full-name   as character
      603       field sort-name   as character
      604       field node-code   as integer
      605       field level       as integer
      606       field is-terminal as logical
      607       index pi is primary unique sort-name
      608       index fn full-name
      609       index lv level
      610       index it is-terminal
      611   .
      612   define temp-table temp_found-result-nodelist no-undo
      613       field node-code     as recid
      614       field processed     as logical
      615       field sort-name     as character
      616       field full-name     as character
      617       index pi is primary unique node-code
      618       index ps processed
      619   .
      620   define variable v-grplib-not-fill-extra-info        as logical      no-undo.
      621   define variable v-grplib-no-warning-grp-amount      as logical      no-undo.
      622   define variable v-grplib-grp-amount-for-load        as integer      no-undo.
      623   procedure grplib-get-parameters :
      624   define input parameter p-store-type     as character        no-undo.
      625   define input parameter p-store-code     as integer          no-undo.
      626   do
      627   on error undo, return error
      628   :
      629       assign
      630           v-grplib-not-fill-extra-info = no
      631       .
      632   end.
      633   end procedure.
      634   procedure grplib-get-sort-name :
      635   do
      636   on error undo, return error
      637   :
      638   define input parameter p-node-code  as integer      no-undo.
      639   define output parameter p-sort-name as character    no-undo.
      640       define variable v-upper-code    as integer           no-undo.
      641       define buffer buf_gds-grp       for ub.gds-grp.
      642       define buffer buf_upper_gds-grp for ub.gds-grp.
      643       find first buf_gds-grp no-lock
      644            where buf_gds-grp.node-code = p-node-code
      645       no-error.
      646       if not available buf_gds-grp
      647       then do:
      648           undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      649       end.
      650       assign
      651           p-sort-name  = ""
      652           v-upper-code = 1
      653       .
      654       do while buf_gds-grp.upper-code <> 0
      655       on error undo, return error "grplib-get-sort-name: Ошибка составления полного имени группы"
      656       :
      657           assign
      658               p-sort-name  = buf_gds-grp.node-name
      659                            + (if p-sort-name <> "" then chr(2) else "")
      660                            + p-sort-name
      661               v-upper-code = buf_gds-grp.upper-code
      662           .
      663           find first buf_gds-grp no-lock
      664                where buf_gds-grp.node-code = v-upper-code
      665           no-error.
      666           if not available buf_gds-grp
      667           then do:
      668               undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом "
      669                                   + string( v-upper-code )
      670                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      671           end.
      672       end.
      673   end.
      674   end procedure.
      675   define variable vss-include-info8 as character format "X(65)" no-undo
      676   initial "@(#)$Workfile$ $Revision$".
      677   procedure grplib-get-full-name :
      678      define input parameter p-node-code  as integer      no-undo.
      679      define output parameter p-full-name as character    no-undo.
      680      do
      681   on error undo, return error
      682   :
      683       define variable v-upper-code    as integer           no-undo.
      684       define buffer buf_gds-grp       for ub.gds-grp.
      685       define buffer buf_upper_gds-grp for ub.gds-grp.
      686       find first buf_gds-grp no-lock
      687            where buf_gds-grp.node-code = p-node-code
      688       no-error.
      689       if not available buf_gds-grp
      690       then do:
      691           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      692       end.
      693       assign
      694           p-full-name  = ""
      695           v-upper-code = 1
      696       .
      697       do while buf_gds-grp.upper-code <> 0
      698       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
      699       :
      700           assign
      701               p-full-name  = buf_gds-grp.node-name
      702                            + (if p-full-name <> "" then chr(47) else "")
      703                            + p-full-name
      704               v-upper-code = buf_gds-grp.upper-code
      705           .
      706           find first buf_gds-grp no-lock
      707                where buf_gds-grp.node-code = v-upper-code
      708           no-error.
      709           if not available buf_gds-grp
      710           then do:
      711               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
      712                                   + string( v-upper-code )
      713                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      714           end.
      715       end.
      716       assign
      717       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      718       .
      719   end.
      720   end .
      721   procedure grplib-get-node-from-full-name :
      722   define input parameter p-full-name as character no-undo .
      723   define output parameter p-node-code as integer no-undo .
      724   define variable v-ii as integer no-undo .
      725   define variable v-upper-code as integer no-undo .
      726   define variable v-root-code as integer no-undo .
      727   define variable v-entry as character no-undo .
      728   define buffer buf_gds-grp       for ub.gds-grp.
      729   do
      730   on error undo, return error
      731   :
      732     find first buf_gds-grp no-lock
      733         where buf_gds-grp.upper-code = 0
      734     no-error .
      735     if not available buf_gds-grp
      736     then do:
      737         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
      738     end.
      739     else do:
      740       assign
      741       v-root-code = buf_gds-grp.node-code
      742       .
      743     end.
      744     v-upper-code = v-root-code.
      745     do v-ii = 1 to num-entries(p-full-name, chr(47)):
      746       assign
      747       v-entry = entry(v-ii, p-full-name, chr(47)).
      748       if v-entry = '' then leave.
      749       find first buf_gds-grp no-lock where
      750                 buf_gds-grp.node-name = v-entry
      751             and buf_gds-grp.upper-code = v-upper-code
      752             no-error.
      753       if not available buf_gds-grp then do:
      754         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
      755       end.
      756       else do:
      757         p-node-code = buf_gds-grp.node-code.
      758         v-upper-code = buf_gds-grp.node-code.
      759       end.
      760     end.
      761   end.
      762   end .
      763   procedure grplib-get-root-code :
      764   do
      765   on error undo, return error
      766   :
      767   define output parameter p-root-code as integer      no-undo.
      768       define buffer buf_gds-grp       for ub.gds-grp.
      769       find first buf_gds-grp no-lock
      770           where buf_gds-grp.upper-code = 0
      771       no-error .
      772       if not available buf_gds-grp
      773       then do:
      774           undo, return error .
      775       end.
      776       else do:
      777           assign
      778               p-root-code = buf_gds-grp.node-code
      779           .
      780       end.
      781   end.
      782   end procedure.
      783   procedure grplib-find-grp-by-full-name :
      784   do
      785   on error undo, return error
      786   :
      787   define input parameter p-search-name  as character    no-undo.
      788   define input parameter p-fill-path    as logical      no-undo.
      789   define output parameter p-found       as logical      no-undo.
      790       define variable v-upper-code    as integer          no-undo.
      791       define variable v-counter       as integer           no-undo.
      792       define variable v-level         as integer           no-undo.
      793       define variable v-full-name     as character         no-undo.
      794       define variable v-sort-name     as character         no-undo.
      795       define buffer buf_gds-grp       for ub.gds-grp.
      796       assign
      797           p-search-name = replace( p-search-name, chr(47), chr(2) )
      798       .
      799       run grplib-get-root-code ( output v-upper-code ) no-error .
      800       if error-status :error
      801       then do:
      802           undo, return error "grplib-expand-name: Ошибка при поиске корневого узла".
      803       end.
      804       assign
      805           v-full-name  = ""
      806           v-level      = num-entries( p-search-name, chr(2) )
      807       .
      808       for each temp_grplib_found-grp
      809       :
      810           delete temp_grplib_found-grp.
      811       end.
      812       start-name-analyze:
      813       do v-counter = 1 to v-level
      814       :
      815           if v-counter < v-level
      816           then do:
      817               find first buf_gds-grp no-lock
      818                    where buf_gds-grp.upper-code = v-upper-code
      819                      and buf_gds-grp.node-name  = entry( v-counter, p-search-name, chr(2) )
      820               no-error .
      821               if not available buf_gds-grp
      822               then do:
      823                   assign
      824                       v-full-name  = p-search-name
      825                       v-sort-name  = p-search-name
      826                   .
      827                   return error "grplib-expand-name: не найдена группа " + entry( v-level, p-search-name, chr(2) ).
      828               end.
      829               else do:
      830                   assign
      831                       v-full-name = v-full-name + ( if v-full-name = "" then "" else chr(47) )        + buf_gds-grp.node-name
      832                       v-sort-name = v-sort-name + ( if v-sort-name = "" then "" else chr(2) ) + buf_gds-grp.node-name
      833                       v-upper-code = buf_gds-grp.node-code
      834                   .
      835                   if p-fill-path = yes
      836                   then do:
      837                       create temp_grplib_found-grp.
      838                       assign
      839                           temp_grplib_found-grp.full-name = v-full-name + chr(47)
      840                           temp_grplib_found-grp.sort-name = v-sort-name
      841                           temp_grplib_found-grp.node-code = v-upper-code
      842                           temp_grplib_found-grp.level     = v-counter
      843                       .
      844                   end.
      845               end.
      846           end.
      847           else do:
      848               for each buf_gds-grp no-lock
      849                  where buf_gds-grp.upper-code = v-upper-code
      850                    and buf_gds-grp.node-name begins entry( v-counter, p-search-name, chr(2) )
      851               :
      852                   assign
      853                       p-found = yes
      854                   .
      855                   create temp_grplib_found-grp.
      856                   assign
      857                       temp_grplib_found-grp.full-name = v-full-name
      858                                                           + (if v-full-name = "" then "" else chr(47) )
      859                                                           + buf_gds-grp.node-name + chr(47)
      860                       temp_grplib_found-grp.sort-name = v-sort-name
      861                                                           + ( if v-sort-name = "" then "" else chr(2) )
      862                                                           + buf_gds-grp.node-name
      863                       temp_grplib_found-grp.node-code = buf_gds-grp.node-code
      864                       temp_grplib_found-grp.level     = v-level
      865                   .
      866               end.
      867               if p-found = no
      868               then do:
      869                   assign
      870                       v-full-name  = p-search-name
      871                       v-sort-name  = p-search-name
      872                   .
      873                   for each temp_grplib_found-grp
      874                   :
      875                       delete temp_grplib_found-grp.
      876                   end.
      877                   assign
      878                       p-found = no
      879                   .
      880               end.
      881           end.
      882       end.
      883   end.
      884   end procedure.
      885   procedure grplib-find-all-subgroup :
      886   do
      887   on error undo, return error
      888   :
      889   define input parameter p-start-node-code    as integer      no-undo.
      890   define input parameter p-terminal-only      as logical      no-undo.
      891       define variable v-start-full-name   as character     no-undo.
      892       define variable v-start-sort-name   as character     no-undo.
      893       define variable v-not-found         as logical       no-undo.
      894       define variable v-is-terminal       as logical       no-undo.
      895       define buffer buf_gds-grp           for ub.gds-grp.
      896       create temp_found-result-nodelist.
      897       assign
      898           temp_found-result-nodelist.node-code = p-start-node-code
      899           temp_found-result-nodelist.processed = no
      900       .
      901       run grplib-get-full-name in this-procedure (
      902             input p-start-node-code
      903           , output v-start-full-name
      904       ).
      905       run grplib-get-full-name in this-procedure (
      906             input p-start-node-code
      907           , output v-start-sort-name
      908       ).
      909       process-nodes:
      910       do while yes
      911       :
      912           find first temp_found-result-nodelist
      913                where temp_found-result-nodelist.node-code = p-start-node-code
      914           .
      915           assign
      916               temp_found-result-nodelist.processed = yes
      917           .
      918           for each buf_gds-grp no-lock
      919              where buf_gds-grp.upper-code = p-start-node-code
      920           on error undo, return error
      921           :
      922               run grplib-is-terminal in this-procedure (
      923                     input buf_gds-grp.node-code
      924                   , output v-is-terminal
      925               ).
      926               if v-is-terminal = yes
      927               then do:
      928                   create temp_grplib_found-grp.
      929                   assign
      930                       temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
      931                                                           chr(47) + buf_gds-grp.node-name + chr(47)
      932                       temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
      933                                                           chr(2) + buf_gds-grp.node-name + chr(2)
      934                       temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
      935                       temp_grplib_found-grp.is-terminal = yes
      936                   .
      937               end.
      938               else do:
      939                   create temp_found-result-nodelist.
      940                   assign
      941                       temp_found-result-nodelist.node-code = buf_gds-grp.node-code
      942                       temp_found-result-nodelist.full-name = right-trim(v-start-full-name, chr(47)) +
      943                                                              chr(47) + buf_gds-grp.node-name + chr(47)
      944                       temp_found-result-nodelist.sort-name = right-trim(v-start-sort-name, chr(2)) +
      945                                                              chr(2) + buf_gds-grp.node-name + chr(2)
      946                       temp_found-result-nodelist.processed = no
      947                   .
      948                   if p-terminal-only = no
      949                   then do:
      950                       create temp_grplib_found-grp.
      951                       assign
      952                           temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
      953                                                               chr(47) + buf_gds-grp.node-name + chr(47)
      954                           temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
      955                                                               chr(2) + buf_gds-grp.node-name + chr(2)
      956                           temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
      957                           temp_grplib_found-grp.is-terminal = no
      958                       .
      959                   end.
      960               end.
      961           end.
      962           find first temp_found-result-nodelist
      963                where temp_found-result-nodelist.processed = no
      964           no-error.
      965           if not available temp_found-result-nodelist
      966           then do:
      967               leave process-nodes.
      968           end.
      969           else do:
      970               assign
      971                   p-start-node-code = temp_found-result-nodelist.node-code
      972                   v-start-full-name = temp_found-result-nodelist.full-name
      973                   v-start-sort-name = temp_found-result-nodelist.sort-name
      974               .
      975           end.
      976       end.
      977   end.
      978   end procedure.
      979   procedure grplib-expand-name :
      980   define input parameter p-start-name as character        no-undo.
      981   define output parameter p-end-name  as character        no-undo.
      982       define variable v-is-terminal   as logical      no-undo.
      983       define variable v-found         as character    no-undo.
      984       define buffer buf_temp_grplib_found-grp     for temp_grplib_found-grp.
      985   do
      986   for buf_temp_grplib_found-grp
      987   on error undo, return error
      988   :
      989       run grplib-find-grp-by-full-name in this-procedure (
      990             input p-start-name
      991           , input no
      992           , output v-found
      993       ) no-error.
      994       run grplib-get-max-substring in this-procedure (
      995                   input length( p-start-name )
      996                 , output p-end-name
      997       ) no-error .
      998       if error-status :error
      999       then do:
     1000           assign
     1001               p-end-name = ""
     1002           .
     1003       end.
     1004       else do:
     1005           find first temp_grplib_found-grp
     1006               where temp_grplib_found-grp.full-name = p-end-name
     1007           no-error.
     1008           if available temp_grplib_found-grp
     1009           then do:
     1010               find first buf_temp_grplib_found-grp
     1011                   where buf_temp_grplib_found-grp.full-name begins p-end-name
     1012                   and recid( buf_temp_grplib_found-grp ) <> recid( temp_grplib_found-grp )
     1013               no-error.
     1014               if not available buf_temp_grplib_found-grp
     1015               then do:
     1016                   run grplib-is-terminal in this-procedure (
     1017                       input temp_grplib_found-grp.node-code
     1018                       , output v-is-terminal
     1019                   ).
     1020               end.
     1021           end.
     1022       end.
     1023   end.
     1024   end procedure.
     1025   procedure grplib-get-max-substring :
     1026   do
     1027   on error undo, return error
     1028   :
     1029   define input parameter p-min-substring-length   as integer      no-undo.
     1030   define output parameter p-substring             as character    no-undo.
     1031           define variable v-char-counter  as integer           no-undo.
     1032           define variable v-current-char  as character         no-undo.
     1033           define variable v-names-counter  as integer           no-undo.
     1034           define variable v-base-string   as character         no-undo.
     1035           assign
     1036               v-char-counter  = p-min-substring-length
     1037           .
     1038           find first temp_grplib_found-grp no-error.
     1039           if not available temp_grplib_found-grp
     1040           then do:
     1041               undo, return error "grplib-get-max-substring: Нет строк для вычисления общей подстроки".
     1042           end.
     1043           else do:
     1044               assign
     1045                   v-base-string  = temp_grplib_found-grp.full-name
     1046                   v-char-counter = 0
     1047               .
     1048               counter-block:
     1049               do while yes
     1050               on error undo, return error "grplib-get-max-substring: Ошибка вычисления продолжения имени группы."
     1051               :
     1052                   assign
     1053                       v-char-counter  = v-char-counter + 1
     1054                       v-current-char  = substring( v-base-string, v-char-counter, 1 )
     1055                       v-names-counter = 0
     1056                   .
     1057                   compare-block:
     1058                   for each temp_grplib_found-grp
     1059                   :
     1060                       assign
     1061                           v-names-counter = v-names-counter + 1
     1062                       .
     1063                       if v-names-counter = 1
     1064                       then do:
     1065                           next compare-block.
     1066                       end.
     1067                       if substring( temp_grplib_found-grp.full-name, v-char-counter, 1 ) <> v-current-char
     1068                       then do:
     1069                           leave counter-block.
     1070                       end.
     1071                   end.
     1072                   if v-names-counter = 1
     1073                   then do:
     1074                       assign
     1075                           p-substring = v-base-string
     1076                       .
     1077                       return.
     1078                   end.
     1079               end.
     1080               assign
     1081                   p-substring = substring( v-base-string, 1, v-char-counter - 1 )
     1082               .
     1083           end.
     1084   end.
     1085   end procedure.
     1086   procedure grplib-is-terminal :
     1087   do
     1088   on error undo, return error "Ошибка процедуры grplib-is-terminal"
     1089   :
     1090   define input parameter p-node-code      as integer      no-undo.
     1091   define output parameter p-is-terminal   as logical      no-undo.
     1092       define buffer buf_gds-grp       for ub.gds-grp.
     1093       find first buf_gds-grp no-lock
     1094           where buf_gds-grp.upper-code = p-node-code
     1095       no-error .
     1096       if not available buf_gds-grp
     1097       then do:
     1098           assign
     1099               p-is-terminal = yes
     1100           .
     1101       end.
     1102       else do:
     1103           assign
     1104               p-is-terminal = no
     1105           .
     1106       end.
     1107   end.
     1108   end procedure.
     1109   procedure grplib-have-goods :
     1110   do
     1111   on error undo, return error
     1112   :
     1113   define input parameter p-node-code      as integer      no-undo.
     1114   define output parameter p-have-goods   as logical      no-undo.
     1115       define buffer buf_goods         for ub.goods.
     1116       find first buf_goods no-lock
     1117            where buf_goods.grp-code = p-node-code
     1118       no-error .
     1119       if available buf_goods
     1120       then do:
     1121           assign
     1122               p-have-goods = yes
     1123           .
     1124       end.
     1125       else do:
     1126           assign
     1127               p-have-goods = no
     1128           .
     1129       end.
     1130   end.
     1131   end procedure.
     1132   procedure grplib-find-by-substring :
     1133   do
     1134   on error undo, return error
     1135   :
     1136   define input parameter p-start-code         as integer      no-undo.
     1137   define input parameter p-full-search-string as character    no-undo.
     1138   define output parameter p-found-code        as integer      no-undo.
     1139   define output parameter p-full-name         as character    no-undo.
     1140       define variable v-start-code     as integer           no-undo.
     1141       define variable v-found          as logical  init no  no-undo.
     1142       define buffer buf_gds-grp       for ub.gds-grp.
     1143       search-grp:
     1144       for each buf_gds-grp no-lock
     1145           where buf_gds-grp.node-code > p-start-code
     1146       :
     1147           if index( buf_gds-grp.node-name, p-full-search-string ) <> 0
     1148           then do:
     1149               assign
     1150                   p-found-code = buf_gds-grp.node-code
     1151                   v-found      = yes
     1152               .
     1153               run grplib-get-full-name in this-procedure (
     1154                     input p-found-code
     1155                   , output p-full-name
     1156               ) no-error .
     1157               if error-status :error
     1158               then do:
     1159                   undo, return error "grplib-find-by-substring: Ошибка вычисления полного имени группы." + chr(10) + return-value.
     1160               end.
     1161               leave search-grp.
     1162           end.
     1163       end.
     1164       if v-found = yes
     1165       then do:
     1166       end.
     1167       else do:
     1168           assign
     1169               p-full-name  = ""
     1170               p-found-code = 0
     1171           .
     1172       end.
     1173   end.
     1174   end procedure.
     1175   procedure grplib-analyze-grp-name :
     1176   do
     1177   on error undo, return error
     1178   :
     1179   define input parameter p-grp-name       as character            no-undo.
     1180   define input parameter p-upper-code     as integer              no-undo.
     1181   define output parameter p-error-message as character init ""    no-undo.
     1182       define variable v-char-list     as character    no-undo.
     1183       define variable v-char-counter  as integer      no-undo.
     1184       define variable v-full-name     as character    no-undo.
     1185       if p-grp-name = "" then do:
     1186           assign
     1187               p-error-message = "Название группы не может быть пустым.".
     1188           .
     1189       end.
     1190       else do:
     1191           assign
     1192               v-char-list = "47,92,58,63,34,60,62,171,187,183"
     1193           .
     1194           do v-char-counter = 1 to num-entries( v-char-list )
     1195           :
     1196               if index( p-grp-name, chr( integer( entry( v-char-counter, v-char-list ) ) ) ) <> 0
     1197               then do:
     1198                   assign
     1199                       p-error-message = 'Название группы не может содержать символы /\:*?"<>|«»·'
     1200                   .
     1201                   return.
     1202               end.
     1203           end.
     1204           if p-upper-code > 0
     1205           then do:
     1206               run grplib-get-full-name in this-procedure (
     1207                     input p-upper-code
     1208                   , output v-full-name
     1209               ) no-error .
     1210               if error-status :error
     1211               then do:
     1212                   undo, return error "grplib-analyze-grp-name: Не удалось вычислить полное имя группы." + chr(10) + return-value.
     1213               end.
     1214               if length( v-full-name ) + 1 + length( p-grp-name ) > 350
     1215               then do:
     1216                   assign
     1217                       p-error-message = 'Полное название группы не может содержать более 350 символов.'
     1218                   .
     1219               end.
     1220           end.
     1221       end.
     1222   end.
     1223   end procedure.
     1224   procedure grplib-get-lvl-num :
     1225   define input parameter p-node-code  as integer      no-undo.
     1226   define output parameter p-lvl-num   as integer      no-undo.
     1227       define variable v-full-name    as character    no-undo.
     1228   do
     1229   on error undo, return error
     1230   :
     1231       run grplib-get-full-name in this-procedure (
     1232             input p-node-code
     1233           , output v-full-name
     1234       ).
     1235       assign
     1236           p-lvl-num = num-entries( v-full-name, chr(47) ) - 1
     1237       .
     1238       if p-lvl-num = -1
     1239       then do:
     1240           assign
     1241               p-lvl-num = 0
     1242           .
     1243       end.
     1244   end.
     1245   end procedure.
