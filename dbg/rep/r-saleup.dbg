     2344   procedure class3 :
     2345     do on error undo, return error return-value :
     2346     if not p-det-obj then do :
     2347       case SortType:
     2348         when 1 then do:
     2349           for each tt-line break by tt-line.grp-name by tt-line.gds-code :
     2350             if first-of(tt-line.grp-name) then do:
     2351               if Make-Excel then  put   stream ForExcel unformatted tt-line.grp-name skip.
     2352             end.
     2353             run print-line in this-procedure (input recid(tt-line)) .
     2354             if last-of(tt-line.grp-name) then do:
     2355               find first tt-sum where tt-sum.obj-type  = "-1"              and
     2356                                       tt-sum.obj-code  = -1                and
     2357                                       tt-sum.prod-type = "-1"              and
     2358                                       tt-sum.prod-code = -1                and
     2359                                       tt-sum.grp-name  = tt-line.grp-name  no-lock no-error.
     2360               if Make-Excel then  put   stream ForExcel unformatted CHR(9) CHR(9) CHR(9) CHR(9)
     2361                           ("Итого по " + string(tt-line.grp-name) + " :")         CHR(9) CHR(9) CHR(9)
     2362                           tt-sum.sum
     2363               skip.
     2364             end.
     2365           end.
     2366         end.
