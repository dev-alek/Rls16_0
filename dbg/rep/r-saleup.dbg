     1264   procedure paramls-write :
     1265     define input  parameter p-code     as character no-undo .
     1266     define input  parameter p-sub-code as character no-undo .
     1267     define input  parameter p-value    as character no-undo .
     1268     define buffer buf_temp-param for temp-param .
     1269     do
     1270     on error undo, return error return-value
     1271     :
     1272       find first buf_temp-param
     1273         where buf_temp-param.param-code     = p-code
     1274           and buf_temp-param.param-sub-code = p-sub-code
     1275         no-error .
     1276       if not available buf_temp-param then do:
     1277         create buf_temp-param .
     1278         assign
     1279           buf_temp-param.param-code     = p-code
     1280           buf_temp-param.param-sub-code = p-sub-code
     1281         .
     1282       end.
     1283       assign
     1284         buf_temp-param.param-value = p-value
     1285       .
     1286     end.
     1287   end procedure.
     1288   procedure paramls-read :
     1289     define input  parameter p-code          as character no-undo .
     1290     define input  parameter p-sub-code      as character no-undo .
     1291     define input  parameter p-default-value as character no-undo .
     1292     define output parameter p-value         as character no-undo .
     1293     define buffer buf_temp-param for temp-param .
     1294     do
     1295     on error undo, return error return-value
     1296     :
     1297       find first buf_temp-param
     1298         where buf_temp-param.param-code     = p-code
     1299           and buf_temp-param.param-sub-code = p-sub-code
     1300         no-error .
     1301       if available buf_temp-param then do:
     1302         assign
     1303           p-value = buf_temp-param.param-value
     1304         .
     1305       end.
     1306       else do:
     1307         assign
     1308           p-value = p-default-value
     1309         .
     1310       end.
     1311     end.
     1312   end procedure.
     1313   procedure paramls-append :
     1314     define input  parameter p-code     as character no-undo .
     1315     define input  parameter p-sub-code as character no-undo .
     1316     define input  parameter p-value    as character no-undo .
     1317     define buffer buf_temp-param for temp-param .
     1318     do
     1319     on error undo, return error return-value
     1320     :
     1321       find first buf_temp-param
     1322            where buf_temp-param.param-code     = p-code
     1323              and buf_temp-param.param-sub-code = p-sub-code
     1324         no-error .
     1325       if not available buf_temp-param then do:
     1326         create buf_temp-param .
     1327         assign
     1328           buf_temp-param.param-code     = p-code
     1329           buf_temp-param.param-sub-code = p-sub-code
     1330           buf_temp-param.param-value    = p-value
     1331         .
     1332       end.
     1333       else do:
     1334           assign
     1335               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     1336           .
     1337       end.
     1338     end.
     1339   end procedure.
