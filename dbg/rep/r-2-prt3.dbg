      319   procedure create_obj-list :
      320      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      321      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      322      do
      323      on error undo, return error return-value
      324      :
      325         define buffer cli-obj for ub.clients .
      326         define variable p-var as integer no-undo .
      327         define buffer buf_obj-list for obj-list .
      328         find last buf_obj-list  use-index pi no-error .
      329         if available buf_obj-list
      330         then
      331            p-var = buf_obj-list.obj-id + 1.
      332         else
      333            p-var = 1.
      334         find first cli-obj where
      335                   cli-obj.obj-type = p-obj-type
      336               and cli-obj.obj-code = p-obj-code
      337         no-lock no-error.
      338         if available cli-obj
      339         then do:
      340            create buf_obj-list.
      341            assign
      342               buf_obj-list.obj-id   = p-var
      343               buf_obj-list.obj-code = cli-obj.obj-code
      344               buf_obj-list.obj-type = cli-obj.obj-type
      345               buf_obj-list.obj-name = cli-obj.obj-name
      346               buf_obj-list.db-num   = cli-obj.db-num
      347            .
      348         end.
      349      end.
      350   end.
