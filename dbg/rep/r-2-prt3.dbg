     1728                 vss-workfile vss-revision vss-description skip
     1729                 vss-include-info20 skip
     1730                 "Ошибка при закрытии переоценки" skip
     1731                 "Не задано количество для бар-кода с основной единицей измерения" skip
     1732                 "Переоценка" v-doc-num skip
     1733                 "Бар-код" buf_price-list.b-code skip
