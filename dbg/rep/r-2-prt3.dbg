     3012           "Ошибка при определении момента времени, на который требуется остаток" skip
     3013           "Объект" p-obj-type p-obj-code skip
     3014           "Артикул" p-artic p-prod-type p-prod-code skip
     3015           "Дата" p-fact-date skip
     3016           view-as alert-box error .
     3017         undo, return error .
     3018       end.
     3019       run prdoclib-init-prt-obj-by-date-factord in this-procedure
     3020         (input p-obj-type
     3021         ,input p-obj-code
     3022         ,input p-artic
     3023         ,input p-prod-type
     3024         ,input p-prod-code
     3025         ,input v-day-end-fact-order
     3026         ,input false
     3027         ) no-error .
     3028       if error-status :error
     3029       then do:
     3030         message
     3031           vss-workfile vss-revision vss-description skip
     3032           vss-include-info20 skip
     3033           "Ошибка при вызове метода prdoclib-init-prt-obj-by-date-factord" skip
     3034           "Объект" p-obj-type p-obj-code skip
     3035           "Артикул" p-artic p-prod-type p-prod-code skip
     3036           "Дата" p-fact-date skip
     3037           view-as alert-box error .
     3038         undo, return error .
     3039       end.
     3040     end.
     3041   end procedure.
     3042   procedure prdoclib-calc-temp-fact-sale :
     3043     define input  parameter p-obj-type           as character no-undo .
     3044     define input  parameter p-obj-code           as integer   no-undo .
     3045     define input  parameter p-gds-code           as integer   no-undo .
     3046     define input  parameter p-day-end-fact-order as decimal   no-undo .
     3047     define input  parameter p-curr-r-b           as character no-undo .
     3048     define output parameter p-fact-qnty          as decimal   no-undo .
     3049     define output parameter p-cur-base           as decimal   no-undo .
     3050     define output parameter p-cur-VAT-base       as decimal   no-undo .
     3051     define output parameter p-cur-SLT-base       as decimal   no-undo .
     3052     define output parameter p-cur-road-tax-base  as decimal   no-undo .
     3053     define output parameter p-cur-excise-base    as decimal   no-undo .
     3054     define buffer buf_temp-prt-obj for temp-prt-obj .
     3055     define variable v-prt-b-code        like ub.bar-code.b-code no-undo .
     3056     define variable v-cli-base-rate     like ub.bar-code.cli-base-rate no-undo .
     3057     define variable parrecid-prl        as recid     no-undo .
     3058     define variable v-fact-qnty         as decimal   no-undo .
     3059     define variable v-cur-base          as decimal   no-undo .
     3060     define variable v-cur-VAT-base      as decimal   no-undo .
     3061     define variable v-cur-SLT-base      as decimal   no-undo .
     3062     define variable v-cur-road-tax-base as decimal   no-undo .
     3063     define variable v-cur-excise-base   as decimal   no-undo .
     3064     define variable price-rubl-with-tax-sale-prl    as decimal   no-undo .
     3065     define variable price-base-with-tax-sale-prl    as decimal   no-undo .
     3066     define variable price-rubl-without-tax-sale-prl as decimal   no-undo .
     3067     define variable price-base-without-tax-sale-prl as decimal   no-undo .
     3068     define variable vat-base-sale-prl               as decimal   no-undo .
     3069     define variable vat-rubl-sale-prl               as decimal   no-undo .
     3070     define variable vat-base-buyer-prl              as decimal   no-undo .
     3071     define variable vat-rubl-buyer-prl              as decimal   no-undo .
     3072     define variable slt-base-sale-prl               as decimal   no-undo .
     3073     define variable slt-rubl-sale-prl               as decimal   no-undo .
     3074     define variable road-tax-base-sale-prl          as decimal   no-undo .
     3075     define variable road-tax-rubl-sale-prl          as decimal   no-undo .
     3076     define variable excise-base-sale-prl            as decimal   no-undo .
     3077     define variable excise-rubl-sale-prl            as decimal   no-undo .
     3078     define variable discnt-base-sale-prl            as decimal   no-undo .
     3079     define variable discnt-rubl-sale-prl            as decimal   no-undo .
     3080     do
     3081     on error undo, return error return-value
     3082     :
     3083       for each buf_temp-prt-obj no-lock
     3084       on error undo, return error return-value
     3085       :
     3086   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     3087     (input  p-gds-code
     3088     ,input  buf_temp-prt-obj.prt-code
     3089     ,output v-prt-b-code
     3090     ) no-error .
     3091         if error-status :error
     3092         then do:
     3093           message
     3094             vss-workfile vss-revision vss-description skip
     3095             "Ошибка при определении бар-кода признака" skip
     3096             "Код товара"   p-gds-code skip
     3097             "Код признака" buf_temp-prt-obj.prt-code skip
     3098             error-status :get-message(1) skip
     3099             return-value skip
     3100             view-as alert-box error .
     3101           undo, return error .
     3102         end.
     3103   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3104   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodepls in g#library
     3105     (input  p-obj-type
     3106     ,input  p-obj-code
     3107     ,input  v-prt-b-code
     3108     ,input  0
     3109     ,input  p-day-end-fact-order
     3110     ,output parrecid-prl
     3111     ,output v-cli-base-rate
     3112     ) no-error .
     3113         if error-status :error
     3114         then do:
     3115           message
     3116             vss-workfile vss-revision vss-description skip
     3117             "Ошибка при определении цены бар-кода" skip
     3118             "Объект" p-obj-type p-obj-code skip
     3119             "Бар-код" v-prt-b-code skip
     3120             "fact-order" p-day-end-fact-order skip
     3121             error-status :get-message(1) skip
     3122             return-value skip
     3123             view-as alert-box error .
     3124           undo, return error .
     3125         end.
     3126         if parrecid-prl <> ?
     3127         then do:
     3128           run prl-vat in this-procedure
     3129             (input  parrecid-prl
     3130             ,output price-rubl-with-tax-sale-prl
     3131             ,output price-base-with-tax-sale-prl
     3132             ,output price-rubl-without-tax-sale-prl
     3133             ,output price-base-without-tax-sale-prl
     3134             ,output vat-base-sale-prl
     3135             ,output vat-rubl-sale-prl
     3136             ,output vat-base-buyer-prl
     3137             ,output vat-rubl-buyer-prl
     3138             ,output slt-base-sale-prl
     3139             ,output slt-rubl-sale-prl
     3140             ,output road-tax-base-sale-prl
     3141             ,output road-tax-rubl-sale-prl
     3142             ,output excise-base-sale-prl
     3143             ,output excise-rubl-sale-prl
     3144             ,output discnt-base-sale-prl
     3145             ,output discnt-rubl-sale-prl
     3146             ) no-error .
     3147           if error-status :error
     3148           then do:
     3149             message
     3150               vss-workfile vss-revision vss-description skip
     3151               "Ошибка при вызове процеды prl-vat" skip
     3152               "Объект" p-obj-type p-obj-code skip
     3153               "Код товара" p-gds-code skip
     3154               "Указатель на запись переоценки" parrecid-prl skip
     3155               error-status :get-message(1) skip
     3156               return-value skip
     3157               view-as alert-box error .
     3158             undo, return error .
     3159           end.
     3160         end.
     3161         else do:
     3162           assign
     3163             price-rubl-with-tax-sale-prl    = 0
     3164             price-base-with-tax-sale-prl    = 0
     3165             price-rubl-without-tax-sale-prl = 0
     3166             price-base-without-tax-sale-prl = 0
     3167             vat-base-sale-prl               = 0
     3168             vat-rubl-sale-prl               = 0
     3169             slt-base-sale-prl               = 0
     3170             slt-rubl-sale-prl               = 0
     3171             road-tax-base-sale-prl          = 0
     3172             road-tax-rubl-sale-prl          = 0
     3173             excise-base-sale-prl            = 0
     3174             excise-rubl-sale-prl            = 0
     3175             discnt-base-sale-prl            = 0
     3176             discnt-rubl-sale-prl            = 0
     3177           .
     3178         end.
     3179         assign
     3180           v-fact-qnty         = v-fact-qnty
     3181                               + buf_temp-prt-obj.fact-qnty
     3182           v-cur-base          = v-cur-base
     3183                               + (if p-curr-r-b = 'base':U
     3184                                   then price-base-with-tax-sale-prl
     3185                                   else price-rubl-with-tax-sale-prl
     3186                                 )
     3187                               * buf_temp-prt-obj.fact-qnty
     3188           v-cur-VAT-base      = v-cur-VAT-base
     3189                               + (if p-curr-r-b = 'base':U
     3190                                   then vat-base-sale-prl
     3191                                   else vat-rubl-sale-prl
     3192                                 )
     3193                               * buf_temp-prt-obj.fact-qnty
     3194           v-cur-SLT-base      = v-cur-SLT-base
     3195                               + (if p-curr-r-b = 'base':U
     3196                                   then slt-base-sale-prl
     3197                                   else slt-rubl-sale-prl
     3198                                 )
     3199                               * buf_temp-prt-obj.fact-qnty
     3200           v-cur-road-tax-base = v-cur-road-tax-base
     3201                               + (if p-curr-r-b = 'base':U
     3202                                   then road-tax-base-sale-prl
     3203                                   else road-tax-rubl-sale-prl
     3204                                 )
     3205                               * buf_temp-prt-obj.fact-qnty
     3206           v-cur-excise-base   = v-cur-excise-base
     3207                               + (if p-curr-r-b = 'base':U
     3208                                   then excise-base-sale-prl
     3209                                   else excise-rubl-sale-prl
     3210                                 )
     3211                               * buf_temp-prt-obj.fact-qnty
     3212         .
     3213       end.
     3214       assign
     3215         p-fact-qnty         = v-fact-qnty
     3216         p-cur-base          = v-cur-base
     3217         p-cur-VAT-base      = v-cur-VAT-base
     3218         p-cur-SLT-base      = v-cur-SLT-base
     3219         p-cur-road-tax-base = v-cur-road-tax-base
     3220         p-cur-excise-base   = v-cur-excise-base
     3221       .
     3222     end.
     3223   end procedure.
     3224   procedure prdoclib-clear-temp-pl-gds :
     3225     define buffer buf_temp-pl-gds for temp-pl-gds .
     3226     do
     3227     on error undo, return error return-value
     3228     :
     3229       for each buf_temp-pl-gds
     3230       on error undo, return error return-value
     3231       :
     3232         delete buf_temp-pl-gds .
     3233       end.
     3234     end.
     3235   end procedure.
     3236   procedure prdoclib-init-temp-pl-gds :
     3237     define input parameter p-obj-type        like ub.pl-gds.obj-type  no-undo .
     3238     define input parameter p-obj-code        like ub.pl-gds.obj-code  no-undo .
     3239     define input parameter p-gds-code        like ub.pl-gds.gds-code  no-undo .
     3240     define buffer buf_pl-gds      for ub.pl-gds .
     3241     define buffer buf_temp-pl-gds for temp-pl-gds .
     3242     do
     3243     on error undo, return error return-value
     3244     :
     3245       run prdoclib-clear-temp-pl-gds in this-procedure .
     3246       for each buf_pl-gds
     3247         where buf_pl-gds.obj-type = p-obj-type
     3248           and buf_pl-gds.obj-code = p-obj-code
     3249           and buf_pl-gds.gds-code = p-gds-code
     3250       on error undo, return error return-value
     3251       :
     3252         create buf_temp-pl-gds .
     3253         buffer-copy buf_pl-gds to buf_temp-pl-gds .
     3254       end.
     3255     end.
     3256   end procedure.
     3257   procedure prdoclib-init-pl-gds-by-factord :
     3258     define input parameter p-obj-type           like ub.gds-obj.obj-type  no-undo .
     3259     define input parameter p-obj-code           like ub.gds-obj.obj-code  no-undo .
     3260     define input parameter p-artic              like ub.gds-obj.artic     no-undo .
     3261     define input parameter p-prod-type          like ub.gds-obj.prod-type no-undo .
     3262     define input parameter p-prod-code          like ub.gds-obj.prod-code no-undo .
     3263     define input parameter p-fact-order         as decimal   no-undo .
     3264     define input parameter p-include-fact-order as logical   no-undo .
     3265     define variable vss-description as character no-undo init "prdoclib-init-pl-gds-by-factord: определение остатков по признакам на любой момент времени".
     3266     define buffer buf_goods       for ub.goods .
     3267     define buffer buf_gds-obj     for ub.gds-obj .
     3268     define buffer buf_doc-line    for ub.doc-line .
     3269     define buffer buf_temp-pl-gds for temp-pl-gds .
     3270     define variable v-total-pl-gds-qnty     as decimal   no-undo .
     3271     define variable v-total-pl-gds-cli-qnty as decimal   no-undo .
     3272     do
     3273     on error undo, return error return-value
     3274     :
     3275       do transaction
     3276       on error undo, return error return-value
     3277       :
     3278   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3279   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     3280     (input  p-obj-type
     3281     ,input  p-obj-code
     3282     ,input  p-artic
     3283     ,input  p-prod-type
     3284     ,input  p-prod-code
     3285     ,buffer buf_gds-obj
     3286     ) no-error .
     3287         if error-status :error
     3288         then do:
     3289           message
     3290             vss-workfile vss-revision vss-description skip
     3291             vss-include-info20 skip
     3292             "Невозможно найти gds-obj" skip
     3293             error-status :get-message(1) skip
     3294             return-value skip
     3295             view-as alert-box error .
     3296           undo, return error return-value .
     3297         end.
     3298         find current buf_gds-obj exclusive-lock .
     3299       end.
     3300       find first buf_goods no-lock
     3301         where buf_goods.artic     = p-artic
     3302           and buf_goods.prod-type = p-prod-type
     3303           and buf_goods.prod-code = p-prod-code
     3304         .
     3305       run prdoclib-init-temp-pl-gds in this-procedure
     3306         (input p-obj-type
     3307         ,input p-obj-code
     3308         ,input buf_goods.gds-code
     3309         ) .
     3310       if p-include-fact-order = true
     3311       then do:
     3312         assign
     3313          p-fact-order = p-fact-order - 0.0000000001
     3314         .
     3315       end.
     3316       for each buf_doc-line no-lock
     3317         where buf_doc-line.obj-type   = p-obj-type
     3318           and buf_doc-line.obj-code   = p-obj-code
     3319           and buf_doc-line.artic      = p-artic
     3320           and buf_doc-line.prod-type  = p-prod-type
     3321           and buf_doc-line.prod-code  = p-prod-code
     3322           and buf_doc-line.status_    = 'факт':U
     3323           and buf_doc-line.fact-order >= p-fact-order
     3324       on error undo, return error return-value
     3325       :
     3326         run prdoclib-prc-pl-document in this-procedure
     3327           ( input  buf_doc-line.doc-code
     3328            ,input  p-obj-type
     3329            ,input  p-obj-code
     3330            ,input  buf_goods.gds-code
     3331            ,output v-total-pl-gds-qnty
     3332            ,output v-total-pl-gds-cli-qnty
     3333           ) .
     3334       end.
     3335     end.
     3336   end procedure.
