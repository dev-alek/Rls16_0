     1973   procedure prdoclib-clear-temp-prt-obj :
     1974     define buffer buf_temp-prt-obj for temp-prt-obj .
     1975     do
     1976     on error undo, return error return-value
     1977     :
     1978       for each buf_temp-prt-obj
     1979       on error undo, return error return-value
     1980       :
     1981         delete buf_temp-prt-obj .
     1982       end.
     1983     end.
     1984   end procedure.
     1985   procedure prdoclib-create-temp-prt-obj :
     1986     define input parameter  p-root-price-sale like ub.price-list.price-sale no-undo .
     1987     define parameter buffer buf_prt-obj       for ub.prt-obj .
     1988     define parameter buffer buf_temp-prt-obj  for temp-prt-obj .
     1989     define buffer buf_gds-prt for ub.gds-prt .
     1990     do
     1991     on error undo, return error return-value
     1992     :
     1993       find first buf_temp-prt-obj
     1994         where buf_temp-prt-obj.prt-code = buf_prt-obj.prt-code
     1995         no-error .
     1996       if not available buf_temp-prt-obj
     1997       then do:
     1998         create buf_temp-prt-obj .
     1999         assign
     2000           buf_temp-prt-obj.prt-code         = buf_prt-obj.prt-code
     2001           buf_temp-prt-obj.price-sale       = ?
     2002           buf_temp-prt-obj.fact-qnty        = buf_prt-obj.fact-qnty
     2003           buf_temp-prt-obj.price-list-qnty  = ?
     2004           buf_temp-prt-obj.prt-obj-recid    = recid(buf_prt-obj)
     2005           buf_temp-prt-obj.price-list-recid = ?
     2006         .
     2007         find first buf_gds-prt no-lock
     2008           where buf_gds-prt.node-code = buf_temp-prt-obj.prt-code
     2009           .
     2010         assign
     2011           buf_temp-prt-obj.is-term = buf_gds-prt.is-term
     2012         .
     2013         if buf_temp-prt-obj.is-term
     2014         then do:
     2015           assign
     2016             buf_temp-prt-obj.price-sale = p-root-price-sale
     2017           .
     2018         end.
     2019       end.
     2020     end.
     2021   end procedure.
     2022   procedure prdoclib-temp-prt-obj-by-prt-root :
     2023     define input parameter  p-prt-code like ub.prt-obj.prt-code no-undo .
     2024     define parameter buffer buf_temp-prt-obj  for temp-prt-obj .
     2025     define buffer buf_gds-prt for ub.gds-prt .
     2026     do
     2027     on error undo, return error return-value
     2028     :
     2029       find first buf_temp-prt-obj
     2030         where buf_temp-prt-obj.prt-code = p-prt-code
     2031         no-error .
     2032       if not available buf_temp-prt-obj
     2033       then do:
     2034         create buf_temp-prt-obj .
     2035         assign
     2036           buf_temp-prt-obj.prt-code         = p-prt-code
     2037           buf_temp-prt-obj.price-sale       = ?
     2038           buf_temp-prt-obj.fact-qnty        = 0
     2039           buf_temp-prt-obj.price-list-qnty  = ?
     2040           buf_temp-prt-obj.prt-obj-recid    = ?
     2041           buf_temp-prt-obj.price-list-recid = ?
     2042         .
     2043         find first buf_gds-prt no-lock
     2044           where buf_gds-prt.node-code = buf_temp-prt-obj.prt-code
     2045           .
     2046         assign
     2047           buf_temp-prt-obj.is-term = buf_gds-prt.is-term
     2048         .
     2049         if buf_temp-prt-obj.is-term
     2050         then do:
     2051           assign
     2052             buf_temp-prt-obj.price-sale = 0
     2053           .
     2054         end.
     2055       end.
     2056     end.
     2057   end procedure.
     2058   procedure prdoclib-init-temp-prt-obj :
     2059     define input parameter p-obj-type        like ub.prt-obj.obj-type  no-undo .
     2060     define input parameter p-obj-code        like ub.prt-obj.obj-code  no-undo .
     2061     define input parameter p-artic           like ub.prt-obj.artic     no-undo .
     2062     define input parameter p-prod-type       like ub.prt-obj.prod-type no-undo .
     2063     define input parameter p-prod-code       like ub.prt-obj.prod-code no-undo .
     2064     define input parameter p-root-price-sale like ub.prt-obj.price-sale no-undo .
     2065     define buffer buf_prt-obj      for ub.prt-obj .
     2066     define buffer buf_temp-prt-obj for temp-prt-obj .
     2067     do
     2068     on error undo, return error return-value
     2069     :
     2070       run prdoclib-clear-temp-prt-obj in this-procedure .
     2071       for each buf_prt-obj
     2072         where buf_prt-obj.obj-type  = p-obj-type
     2073           and buf_prt-obj.obj-code  = p-obj-code
     2074           and buf_prt-obj.artic     = p-artic
     2075           and buf_prt-obj.prod-type = p-prod-type
     2076           and buf_prt-obj.prod-code = p-prod-code
     2077       on error undo, return error return-value
     2078       :
     2079         run prdoclib-create-temp-prt-obj in this-procedure
     2080           (input  p-root-price-sale
     2081           ,buffer buf_prt-obj
     2082           ,buffer buf_temp-prt-obj
     2083           ).
     2084       end.
     2085     end.
     2086   end procedure.
     2087   procedure prdoclib-calc-fact-sale :
