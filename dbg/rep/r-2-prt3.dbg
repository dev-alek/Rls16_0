      926   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      927   procedure factord :
      928     define input  parameter p-fact-date            as date    no-undo .
      929     define input  parameter p-fact-time            as integer no-undo .
      930     define input  parameter p-fact-num             as integer no-undo .
      931     define input  parameter p-shift-date           as date    no-undo .
      932     define input  parameter p-shift-num            as integer no-undo .
      933     define input  parameter p-shift-on             as logical no-undo .
      934     define output parameter p-fact-order           as decimal no-undo .
      935     define output parameter p-shift-end-fact-order as decimal no-undo .
      936     define output parameter p-day-end-fact-order   as decimal no-undo .
      937     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      938     if p-fact-date = ?
      939     then do:
      940       return error "Не указана фактическая дата" .
      941     end.
      942     define variable v-fact-date-num as integer no-undo .
      943     assign
      944       v-fact-date-num = integer(p-fact-date)
      945     .
      946     if p-fact-num = ?
      947     or p-fact-num = 0
      948     then do:
      949       return error "Не задан p-fact-num " + string(p-fact-num) .
      950     end.
      951     if p-fact-num < 0
      952     then do:
      953       return error "Отрицательный fact-num " + string(p-fact-num) .
      954     end.
      955     if p-fact-num >= 100000000
      956     then do:
      957       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      958     end.
      959     if p-shift-on = true
      960     then do:
      961       if p-shift-date = ?
      962       then do:
      963         return error "Не задана дата смены" .
      964       end.
      965       if p-shift-num = ?
      966       or p-shift-num = 0
      967       then do:
      968         return error "Не задан номер смены" .
      969       end.
      970     end.
      971     else do:
      972       assign
      973         p-shift-date = p-fact-date
      974         p-shift-num  = 24
      975       .
      976     end.
      977     define variable v-shift-offset as integer no-undo .
      978     if p-shift-date = p-fact-date
      979     then do:
      980       assign
      981         v-shift-offset = 1
      982       .
      983     end.
      984     if p-shift-date < p-fact-date
      985     then do:
      986       assign
      987         v-shift-offset = 0
      988       .
      989     end.
      990     if p-shift-date > p-fact-date
      991     then do:
      992       message
      993         vss-workfile vss-revision vss-description skip
      994         "Неправильная дата закрытия смены" skip
      995         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      996         view-as alert-box error .
      997       undo, return error
      998         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      999           ,string(p-fact-date, '99/99/9999':U)
     1000           ,string(p-shift-date, '99/99/9999':U)
     1001           )
     1002       .
     1003     end.
     1004     if p-shift-num < 1
     1005     or p-shift-num > 24
     1006     then do:
     1007       message
     1008         vss-workfile vss-revision vss-description skip
     1009         "Неправильный номер смены" skip
     1010         "p-shift-num" p-shift-num skip
     1011         view-as alert-box error .
     1012       undo, return error return-value .
     1013     end.
     1014     assign
     1015       p-fact-order           = v-fact-date-num
     1016                              + v-shift-offset * 0.5
     1017                              + p-shift-num    * 0.02 - 0.01
     1018                              + p-fact-num     * 0.0000000001
     1019       p-shift-end-fact-order = v-fact-date-num
     1020                              + v-shift-offset * 0.5
     1021                              + p-shift-num    * 0.02
     1022       p-day-end-fact-order   = v-fact-date-num
     1023                              + 0.99
     1024     .
     1025     if p-fact-order           <= v-fact-date-num
     1026     or p-shift-end-fact-order <= v-fact-date-num
     1027     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     1028     or p-shift-end-fact-order >= p-day-end-fact-order
     1029     then do:
     1030       message
     1031         vss-workfile vss-revision vss-description skip
     1032         "Внутренняя ошибка при генерации фактического номера" skip
     1033         "p-fact-date"            p-fact-date            skip
     1034         "p-fact-time"            p-fact-time            skip
     1035         "p-fact-num"             p-fact-num             skip
     1036         "p-shift-date"           p-shift-date           skip
     1037         "p-shift-num"            p-shift-num            skip
     1038         "p-shift-on"             p-shift-on             skip
     1039         "p-shift-end-fact-order" p-shift-end-fact-order skip
     1040         "p-day-end-fact-order"   p-day-end-fact-order   skip
     1041         "v-fact-date-num"        v-fact-date-num        skip
     1042         view-as alert-box error .
     1043       undo, return error return-value .
     1044     end.
     1045   end procedure.
     1046   procedure day-begin-fact-order :
     1047     define input  parameter p-fact-date            as date    no-undo .
     1048     define output parameter p-day-begin-fact-order as decimal no-undo .
     1049     do
     1050     on error undo, return error return-value
     1051     :
     1052       if p-fact-date = ?
     1053       then do:
     1054         assign
     1055           p-day-begin-fact-order = 0
     1056         .
     1057       end.
     1058       else do:
     1059         assign
     1060           p-day-begin-fact-order = integer(p-fact-date)
     1061         .
     1062       end.
     1063     end.
     1064   end procedure.
     1065   procedure factord-max-fact-order :
     1066     define output parameter p-max-fact-order as decimal   no-undo .
     1067     do
     1068     on error undo, return error return-value
     1069     :
     1070       run day-begin-fact-order in this-procedure
     1071         (input  date(1, 1, 5000)
     1072         ,output p-max-fact-order
     1073         ) .
     1074     end.
     1075   end procedure.
     1076   procedure factord-cut-archive :
     1077     define input  parameter p-obj-type             as character no-undo .
     1078     define input  parameter p-obj-code             as integer   no-undo .
     1079     define input  parameter p-fact-date            as date      no-undo .
     1080     define output parameter p-shift-on             as logical   no-undo .
     1081     define output parameter p-shift-date           as date      no-undo .
     1082     define output parameter p-shift-num            as integer   no-undo .
     1083     define output parameter p-day-end-fact-order   as decimal   no-undo .
     1084     define output parameter p-shift-end-fact-order as decimal   no-undo .
     1085     define variable v-fact-order as decimal   no-undo .
     1086     define buffer buf_shift-obj for ub.shift-obj .
     1087     do
     1088     on error undo, return error return-value
     1089     :
     1090   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1091   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1092     (input  p-obj-type
     1093     ,input  p-obj-code
     1094     ,input  'shift-on=request'
     1095     ,output p-shift-on
     1096     ) no-error .
     1097       if error-status :error
     1098       then do:
     1099         message
     1100           vss-workfile vss-revision vss-description skip
     1101           "Ошибка при определении атрибута объекта" skip
     1102           "Объект" p-obj-type p-obj-code skip
     1103           error-status :get-message(1) skip
     1104           return-value skip
     1105           view-as alert-box error .
     1106         undo, return error return-value .
     1107       end.
     1108       if p-shift-on = false
     1109       then do:
     1110         assign
     1111           p-shift-date               = ?
     1112           p-shift-num                = 0
     1113         .
     1114       end.
     1115       else do:
     1116         find first buf_shift-obj share-lock
     1117           where buf_shift-obj.obj-type   = p-obj-type
     1118             and buf_shift-obj.obj-code   = p-obj-code
     1119             and buf_shift-obj.shift-date > p-fact-date
     1120           use-index pi
     1121           no-error .
     1122         if not available buf_shift-obj
     1123         or buf_shift-obj.status_ <> 'зкр':U
     1124         then do:
     1125           message
     1126             vss-workfile vss-revision vss-description skip
     1127             "Невозможно вычислить последнюю смену" skip
     1128             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1129             "Объект" p-obj-type p-obj-code skip
     1130             "Дата" p-fact-date skip
     1131             view-as alert-box error .
     1132           undo, return error return-value .
     1133         end.
     1134         find last buf_shift-obj share-lock
     1135           where buf_shift-obj.obj-type = p-obj-type
     1136             and buf_shift-obj.obj-code = p-obj-code
     1137             and buf_shift-obj.shift-date <= p-fact-date
     1138           use-index pi
     1139           no-error .
     1140         if available buf_shift-obj
     1141         then do:
     1142           if  buf_shift-obj.status_ = 'зкр':U
     1143           then do:
     1144             assign
     1145               p-shift-date = buf_shift-obj.shift-date
     1146               p-shift-num  = buf_shift-obj.shift-num
     1147             .
     1148           end.
     1149           else do:
     1150             message
     1151               vss-workfile vss-revision vss-description skip
     1152               "Невозможно вычислить последнюю смену" skip
     1153               "Статус смены отличен от статуса" 'зкр':U skip
     1154               "Объект" p-obj-type p-obj-code skip
     1155               "Дата" p-fact-date skip
     1156               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1157               view-as alert-box error .
     1158             undo, return error return-value .
     1159           end.
     1160         end.
     1161         else do:
     1162           assign
     1163             p-shift-date = p-fact-date - 1
     1164             p-shift-num  = 1
     1165           .
     1166         end.
     1167       end.
     1168       run factord in this-procedure
     1169         (input  p-fact-date
     1170         ,input  1
     1171         ,input  1
     1172         ,input  p-shift-date
     1173         ,input  p-shift-num
     1174         ,input  p-shift-on
     1175         ,output v-fact-order
     1176         ,output p-shift-end-fact-order
     1177         ,output p-day-end-fact-order
     1178         ) no-error .
     1179       if error-status :error
     1180       then do:
     1181         message
     1182           vss-workfile vss-revision vss-description skip
     1183           "Ошибка при вызове процедуры factord"
     1184           error-status :get-message(1) skip
     1185           return-value skip
     1186           view-as alert-box error .
     1187         undo, return error return-value .
     1188       end.
     1189     end.
     1190   end procedure.
     1191   procedure factord-lock-shift :
     1192     define input  parameter p-obj-type  as character no-undo .
     1193     define input  parameter p-obj-code  as integer   no-undo .
     1194     define input  parameter p-fact-date as date      no-undo .
     1195     define parameter buffer buf_shift-obj for ub.shift-obj .
     1196     define variable v-shift-on      as logical   no-undo .
     1197     define variable v-extra-message as character no-undo .
     1198     define variable v-error as character no-undo .
     1199     do
     1200     on error undo, return error return-value
     1201     :
     1202   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1203   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1204     (input  p-obj-type
     1205     ,input  p-obj-code
     1206     ,input  'shift-on=request'
     1207     ,output v-shift-on
     1208     ) no-error .
     1209       if error-status :error
     1210       then do:
     1211         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1212         undo, return error v-error .
     1213       end.
     1214       if v-shift-on = true
     1215       then do:
     1216         find first buf_shift-obj share-lock
     1217           where buf_shift-obj.obj-type   = p-obj-type
     1218             and buf_shift-obj.obj-code   = p-obj-code
     1219             and buf_shift-obj.shift-date > p-fact-date
     1220           use-index pi
     1221           no-error .
     1222         if not available buf_shift-obj
     1223         or buf_shift-obj.status_ <> 'зкр':U
     1224         then do:
     1225           find last buf_shift-obj
     1226             where buf_shift-obj.obj-type = p-obj-type
     1227               and buf_shift-obj.obj-code = p-obj-code
     1228               and buf_shift-obj.status_  = 'зкр':U
     1229             use-index stts
     1230             no-error .
     1231           if available buf_shift-obj
     1232           then do:
     1233             assign
     1234               v-extra-message =
     1235                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1236                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1237                               )
     1238             .
     1239           end.
     1240           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1241           undo, return error v-error .
     1242         end.
     1243       end.
     1244     end.
     1245   end procedure.
     1246   procedure factord-end-day :
     1247     define input  parameter p-fact-date            as date    no-undo .
     1248     define output parameter p-day-end-fact-order   as decimal no-undo .
     1249     do
     1250     on error undo, return error return-value
     1251     :
     1252       if p-fact-date = ?
     1253       then do:
     1254         return error "Не указана фактическая дата" .
     1255       end.
     1256       assign
     1257         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1258       .
     1259     end.
     1260   end procedure.
     1261   procedure factord-to-date :
     1262     define input  parameter p-fact-order as decimal no-undo .
     1263     define output parameter p-fact-date  as date    no-undo .
     1264     define variable v-ref-date  as date      no-undo .
     1265     define variable v-ref-delta as integer   no-undo .
     1266     do
     1267     on error undo, return error return-value
     1268     :
     1269       if p-fact-order = ?
     1270       or p-fact-order = 0
     1271       then do:
     1272         return error "Не указан fact-order" .
     1273       end.
     1274       assign
     1275         v-ref-date  = date(1, 1, 2000)
     1276       .
     1277       assign
     1278         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1279       .
     1280       assign
     1281         p-fact-date = v-ref-date + v-ref-delta
     1282       .
     1283     end.
     1284   end procedure.
     1285   procedure factord-to-fact-num :
     1286     define input  parameter p-fact-order as decimal no-undo .
     1287     define output parameter p-fact-num   as integer no-undo .
     1288     define variable v-fact-order-trunc as decimal no-undo .
     1289     do
     1290     on error undo, return error return-value
     1291     :
     1292       if p-fact-order = ?
     1293       or p-fact-order = 0
     1294       then do:
     1295         return error "Не указан fact-order" .
     1296       end.
     1297       assign
     1298        v-fact-order-trunc = truncate(p-fact-order, 2)
     1299       .
     1300       assign
     1301         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1302       .
     1303     end.
     1304   end procedure.
     1305   procedure factord-to-shift-num :
     1306     define input  parameter p-fact-order as decimal no-undo .
     1307     define output parameter p-shift-num   as integer no-undo .
     1308     define variable  p-shift-numd  as decimal   no-undo .
     1309     define variable v-fact-order-trunc as decimal no-undo .
     1310     do
     1311     on error undo, return error return-value
     1312     :
     1313       if p-fact-order = ?
     1314       or p-fact-order = 0
     1315       then do:
     1316         return error "Не указан fact-order" .
     1317       end.
     1318       assign
     1319        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1320       .
     1321       if v-fact-order-trunc < 0.5 then do:
     1322         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1323       end.
     1324       assign
     1325         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1326         .
     1327        assign
     1328         p-shift-num = truncate (p-shift-numd , 0)
     1329       .
     1330     end.
     1331   end procedure.
     1332   def var vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1333   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     1334   procedure paramls-clear :
     1335     define buffer buf_temp-param for temp-param .
     1336     do
     1337     on error undo, return error return-value
     1338     :
     1339       for each buf_temp-param
     1340       on error undo, return error
     1341       :
     1342         delete buf_temp-param .
     1343       end.
     1344     end.
     1345   end procedure.
     1346   procedure paramls-write :
     1347     define input  parameter p-code     as character no-undo .
     1348     define input  parameter p-sub-code as character no-undo .
     1349     define input  parameter p-value    as character no-undo .
     1350     define buffer buf_temp-param for temp-param .
     1351     do
     1352     on error undo, return error return-value
     1353     :
     1354       find first buf_temp-param
     1355         where buf_temp-param.param-code     = p-code
     1356           and buf_temp-param.param-sub-code = p-sub-code
     1357         no-error .
     1358       if not available buf_temp-param then do:
     1359         create buf_temp-param .
     1360         assign
     1361           buf_temp-param.param-code     = p-code
     1362           buf_temp-param.param-sub-code = p-sub-code
     1363         .
     1364       end.
     1365       assign
     1366         buf_temp-param.param-value = p-value
     1367       .
     1368     end.
     1369   end procedure.
     1370   procedure paramls-read :
     1371     define input  parameter p-code          as character no-undo .
     1372     define input  parameter p-sub-code      as character no-undo .
     1373     define input  parameter p-default-value as character no-undo .
     1374     define output parameter p-value         as character no-undo .
     1375     define buffer buf_temp-param for temp-param .
     1376     do
     1377     on error undo, return error return-value
     1378     :
     1379       find first buf_temp-param
     1380         where buf_temp-param.param-code     = p-code
     1381           and buf_temp-param.param-sub-code = p-sub-code
     1382         no-error .
     1383       if available buf_temp-param then do:
     1384         assign
     1385           p-value = buf_temp-param.param-value
     1386         .
     1387       end.
     1388       else do:
     1389         assign
     1390           p-value = p-default-value
     1391         .
     1392       end.
     1393     end.
     1394   end procedure.
     1395   procedure paramls-append :
     1396     define input  parameter p-code     as character no-undo .
     1397     define input  parameter p-sub-code as character no-undo .
     1398     define input  parameter p-value    as character no-undo .
     1399     define buffer buf_temp-param for temp-param .
     1400     do
     1401     on error undo, return error return-value
     1402     :
     1403       find first buf_temp-param
     1404            where buf_temp-param.param-code     = p-code
     1405              and buf_temp-param.param-sub-code = p-sub-code
     1406         no-error .
     1407       if not available buf_temp-param then do:
     1408         create buf_temp-param .
     1409         assign
     1410           buf_temp-param.param-code     = p-code
     1411           buf_temp-param.param-sub-code = p-sub-code
     1412           buf_temp-param.param-value    = p-value
     1413         .
     1414       end.
     1415       else do:
     1416           assign
     1417               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     1418           .
     1419       end.
     1420     end.
     1421   end procedure.
     1422   function excel-format-dec-to-char returns char (input p-dec as decimal ).
     1423     if num-entries(string(p-dec), '.') = 2
     1424       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
     1425       else return( string(p-dec)) .
     1426   end function.
     1427   function format-point-to-comma returns char (input orig as char ) .
     1428   define variable rtext as character no-undo .
     1429   define variable strt as integer no-undo .
     1430   define variable leng as integer no-undo .
     1431   assign rtext = orig .
     1432   repeat:
     1433     strt =  index(rtext,'.').
     1434     if strt = 0 then leave.
     1435     leng = 1.
     1436     substring(rtext,strt,leng,"character") = v-delim .
     1437   end.
     1438   return rtext.
     1439   end function.
     1440   function format-excel-text returns char ( input start-text as char ) :
     1441   def var  i    as int no-undo.
     1442   def var  ch   as char no-undo.
     1443   def var  n    as int no-undo.
     1444   def var  ipos as int no-undo.
     1445     n = num-entries(trim(start-text), chr(10)) - 1 .
     1446     do i = 1 to n :
     1447       ipos = index( start-text, chr(10)).
     1448       if ipos > 0 then
     1449         substr( start-text, ipos, 1 ) = ' '.
     1450     end.
     1451     n = num-entries(trim(start-text), chr(13)) - 1 .
     1452     do i = 1 to n :
     1453       ipos = index( start-text, chr(13)).
     1454       if ipos > 0 then
     1455         substr( start-text, ipos, 1 ) = ' '.
     1456     end.
     1457     if index( start-text, '"' ) = 0 then
     1458       start-text =  '="'   + trim( start-text) + '"'   .
     1459       else do:
     1460         n = num-entries(trim(start-text), '"') - 1.
     1461         do i = 1 to n :
     1462           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1463         end.
     1464         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1465         start-text = '="'  + ch  + '"' .
     1466       end.
     1467     return start-text.
     1468   end.
     1469   function excel-sum returns char (input p-dec as decimal ).
     1470     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
     1471   end function.
     1472   function excel-qnty returns char (input p-dec as decimal ).
     1473     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
     1474   end function.
     1475   function format-excel-text-macr returns char ( input start-text as char ) :
     1476   def var  i    as int no-undo.
     1477   def var  ch   as char no-undo.
     1478   def var  n    as int no-undo.
     1479   def var  ipos as int no-undo.
     1480     n = num-entries(trim(start-text), chr(10)) - 1 .
     1481     do i = 1 to n :
     1482       ipos = index( start-text, chr(10)).
     1483       if ipos > 0 then
     1484         substring( start-text, ipos , 1 ) = ' '.
     1485     end.
     1486     n = num-entries(trim(start-text), chr(13)) - 1 .
     1487     do i = 1 to n :
     1488       ipos = index( start-text, chr(13)).
     1489       if ipos > 0 then
     1490         substring( start-text, ipos, 1 ) = ' '.
     1491     end.
     1492     if index( start-text, '"' ) = 0 then
     1493       start-text =  '"'   + trim( start-text) + '"'   .
     1494       else do:
     1495         n = num-entries(trim(start-text), '"') - 1.
     1496         do i = 1 to n :
     1497           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1498         end.
     1499         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1500         start-text = '"'  + ch  + '"' .
     1501       end.
     1502     n = num-entries(trim(start-text), chr(10)) - 1 .
     1503     do i = 1 to n :
     1504       ipos = index( start-text, chr(10)).
     1505       if ipos > 0 then
     1506         substring( start-text, ipos , 1 ) = ' '.
     1507     end.
