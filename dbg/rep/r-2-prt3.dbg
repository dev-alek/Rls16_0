     2316               no-error .
     2317             if available buf_bar-code
     2318             and buf_bar-code.unit-cli = v-unit-base
     2319             then do:
     2320               message
     2321                 vss-workfile vss-revision vss-description skip
     2322                 vss-include-info20 skip
     2323                 "Ошибка при закрытии переоценки" skip
     2324                 "Не задано количество для бар-кода с основной единицей измерения" skip
     2325                 "Переоценка" buf_main_price-list.doc-num skip
     2326                 "Бар-код" buf_price-list.b-code skip
     2327                 "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     2328                 "Количество" buf_price-list.doc-qnty skip
     2329                 "Основная единица измерения" v-unit-base skip
     2330                 "Единица измерения бар-кода" buf_bar-code.unit-cli skip
     2331                 view-as alert-box error .
     2332               undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     2333             end.
     2334             next .
     2335           end.
     2336           if not can-find
     2337             (first buf_bar-code
     2338             where buf_bar-code.b-code = buf_price-list.b-code
     2339             )
     2340           then do:
     2341             message
     2342               vss-workfile vss-revision vss-description skip
     2343               vss-include-info20 skip
     2344               "В переоценке задан несуществующий бар-код" skip
     2345               "Переоценка" buf_price-list.doc-num skip
     2346               "Артикул" buf_price-list.artic buf_price-list.prod-type buf_price-list.prod-code skip
     2347               "Бар-код" buf_price-list.b-code skip
     2348               view-as alert-box error .
     2349             undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     2350           end.
     2351           if buf_price-list.doc-qnty <> 0
     2352           then do:
     2353             run prl-vat in this-procedure
     2354               (input  recid(buf_price-list)
     2355               ,output price-rubl-with-tax-sale-prl
     2356               ,output price-base-with-tax-sale-prl
     2357               ,output price-rubl-without-tax-sale-prl
     2358               ,output price-base-without-tax-sale-prl
     2359               ,output vat-base-sale-prl
     2360               ,output vat-rubl-sale-prl
     2361               ,output vat-base-buyer-prl
     2362               ,output vat-rubl-buyer-prl
     2363               ,output slt-base-sale-prl
     2364               ,output slt-rubl-sale-prl
     2365               ,output road-tax-base-sale-prl
     2366               ,output road-tax-rubl-sale-prl
     2367               ,output excise-base-sale-prl
     2368               ,output excise-rubl-sale-prl
     2369               ,output discnt-base-sale-prl
     2370               ,output discnt-rubl-sale-prl
     2371               ) no-error .
     2372             if error-status :error
     2373             then do:
     2374               message
     2375                 vss-workfile vss-revision vss-description skip
     2376                 vss-include-info20 skip
     2377                 "Ошибка при вызове процеды prl-vat" skip
     2378                 "Документ" buf_price-list.doc-num skip
     2379                 "Артикул" buf_price-list.artic buf_price-list.prod-type buf_price-list.prod-code skip
     2380                 error-status :get-message(1) skip
     2381                 return-value skip
     2382                 view-as alert-box error .
     2383               undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     2384             end.
     2385           end.
     2386           else do:
     2387             assign
     2388               price-rubl-with-tax-sale-prl    = 0
     2389               price-base-with-tax-sale-prl    = 0
     2390               price-rubl-without-tax-sale-prl = 0
     2391               price-base-without-tax-sale-prl = 0
     2392               vat-base-sale-prl               = 0
     2393               vat-rubl-sale-prl               = 0
     2394               vat-base-buyer-prl              = 0
     2395               vat-rubl-buyer-prl              = 0
     2396               slt-base-sale-prl               = 0
     2397               slt-rubl-sale-prl               = 0
     2398               road-tax-base-sale-prl          = 0
     2399               road-tax-rubl-sale-prl          = 0
     2400               excise-base-sale-prl            = 0
     2401               excise-rubl-sale-prl            = 0
     2402               discnt-base-sale-prl            = 0
     2403               discnt-rubl-sale-prl            = 0
     2404             .
     2405           end.
     2406           if v-curr-r-b = 'base':U
     2407           then do:
     2408             assign
     2409               p-fact-qnty         = p-fact-qnty
     2410                                   + buf_price-list.doc-qnty
     2411               p-cur-base          = p-cur-base
     2412                                   + price-base-with-tax-sale-prl * buf_price-list.doc-qnty
     2413               p-cur-VAT-base      = p-cur-VAT-base
     2414                                   + vat-base-sale-prl * buf_price-list.doc-qnty
     2415               p-cur-SLT-base      = p-cur-SLT-base
     2416                                   + slt-base-sale-prl * buf_price-list.doc-qnty
     2417               p-cur-road-tax-base = p-cur-road-tax-base
     2418                                   + road-tax-base-sale-prl * buf_price-list.doc-qnty
     2419               p-cur-excise-base   = p-cur-excise-base
     2420                                   + excise-base-sale-prl * buf_price-list.doc-qnty
     2421             .
     2422           end.
     2423           else do:
     2424             assign
     2425               p-fact-qnty         = p-fact-qnty
     2426                                   + buf_price-list.doc-qnty
     2427               p-cur-base          = p-cur-base
     2428                                   + price-rubl-with-tax-sale-prl * buf_price-list.doc-qnty
     2429               p-cur-VAT-base      = p-cur-VAT-base
     2430                                   + vat-rubl-sale-prl * buf_price-list.doc-qnty
     2431               p-cur-SLT-base      = p-cur-SLT-base
     2432                                   + slt-rubl-sale-prl * buf_price-list.doc-qnty
     2433               p-cur-road-tax-base = p-cur-road-tax-base
     2434                                   + road-tax-rubl-sale-prl * buf_price-list.doc-qnty
     2435               p-cur-excise-base   = p-cur-excise-base
     2436                                   + excise-rubl-sale-prl * buf_price-list.doc-qnty
     2437             .
     2438           end.
     2439         end.
     2440     end.
     2441   end procedure.
     2442   procedure prdoclib-calc-prc :
     2443     define input  parameter p-price-doc-recid as   recid                  no-undo.
     2444     define input  parameter p-cons-pay        as   integer                no-undo.
     2445     define output parameter p-ov-cons         like ub.doc-line.price-base no-undo.
     2446     define output parameter p-ov-VAT-cons     like ub.doc-line.price-base no-undo.
     2447     define output parameter p-ov-SLT-cons     like ub.doc-line.price-base no-undo.
     2448     define output parameter p-ov-prch         like ub.doc-line.price-base no-undo.
     2449     define output parameter p-ov-VAT-prch     like ub.doc-line.price-base no-undo.
     2450     define output parameter p-ov-SLT-prch     like ub.doc-line.price-base no-undo.
     2451     do
     2452     on error undo, return error return-value
     2453     :
     2454       define buffer buf_price-doc       for ub.price-doc .
     2455       define buffer buf_price-list      for ub.price-list .
     2456       define buffer buf_parts           for ub.parts .
     2457       define variable v-ov-qnty     as decimal   no-undo .
     2458       define variable v-ov-base     as decimal   no-undo .
     2459       define variable v-ov-VAT-base as decimal   no-undo .
     2460       define variable v-ov-SLT-base as decimal   no-undo .
     2461       define variable v-cons-qnty   as decimal   no-undo .
     2462       define variable v-prch-qnty   as decimal   no-undo .
     2463       define variable v-cons-mult   as decimal   no-undo .
     2464       define variable v-prch-mult   as decimal   no-undo .
     2465       find first buf_price-doc no-lock
     2466         where recid(buf_price-doc) = p-price-doc-recid
     2467         no-error .
     2468       if not available buf_price-doc
     2469       then do:
     2470         message
     2471           vss-workfile vss-revision vss-description skip
     2472           vss-include-info20 skip
     2473           "Ошибка задания входных параметров" skip
     2474           "Не найден документ переоценки" skip
     2475           "Код записи (recid)" p-price-doc-recid skip
     2476           view-as alert-box error .
     2477         undo, return error .
     2478       end.
     2479       for each buf_price-list no-lock
     2480         where buf_price-list.doc-num    = buf_price-doc.doc-num
     2481           and buf_price-list.main-price = true
     2482       on error undo, return error return-value
     2483       :
     2484         run prdoclib-calc-ov
     2485           (input recid(buf_price-list)
     2486           ,output v-ov-qnty
     2487           ,output v-ov-base
     2488           ,output v-ov-VAT-base
     2489           ,output v-ov-SLT-base
     2490           ) no-error .
     2491         if error-status :error
     2492         then do:
     2493           if error-status :get-message(1) <> ""
     2494           then do:
     2495             message
     2496               vss-workfile vss-revision vss-description skip
     2497               vss-include-info20 skip
     2498               "Ошибка при вызове процедуры prdoclib-calc-ov" skip
     2499               error-status :get-message(1) skip
     2500               return-value skip
     2501               view-as alert-box error .
     2502           end.
     2503           undo, return error return-value .
     2504         end.
     2505         assign
     2506           v-cons-qnty = 0
     2507           v-prch-qnty = 0
     2508         .
     2509         for each buf_parts no-lock
     2510           where buf_parts.out-code  = buf_price-list.doc-num
     2511             and buf_parts.obj-type  = buf_price-list.obj-type
     2512             and buf_parts.obj-code  = buf_price-list.obj-code
     2513             and buf_parts.artic     = buf_price-list.artic
     2514             and buf_parts.prod-type = buf_price-list.prod-type
     2515             and buf_parts.prod-code = buf_price-list.prod-code
     2516         on error undo, return error return-value
     2517         :
     2518           if buf_parts.pay-code = p-cons-pay
     2519           then do:
     2520             assign
     2521               v-cons-qnty = v-cons-qnty + buf_parts.fact-qnty
     2522             .
     2523           end.
     2524           else do:
     2525             assign
     2526               v-prch-qnty = v-prch-qnty + buf_parts.fact-qnty
     2527             .
     2528           end.
     2529         end.
     2530         if (v-cons-qnty + v-prch-qnty) = 0
     2531         then do:
     2532           assign
     2533             v-cons-mult = 0
     2534             v-prch-mult = 1
     2535           .
     2536         end.
     2537         else do:
     2538           assign
     2539             v-cons-mult = v-cons-qnty / (v-cons-qnty + v-prch-qnty)
     2540             v-prch-mult = v-prch-qnty / (v-cons-qnty + v-prch-qnty)
     2541           .
     2542         end.
     2543         assign
     2544           p-ov-cons     = p-ov-cons     + v-ov-base     * v-cons-mult
     2545           p-ov-VAT-cons = p-ov-VAT-cons + v-ov-VAT-base * v-cons-mult
     2546           p-ov-SLT-cons = p-ov-SLT-cons + v-ov-SLT-base * v-cons-mult
     2547           p-ov-prch     = p-ov-prch     + v-ov-base     * v-prch-mult
     2548           p-ov-VAT-prch = p-ov-VAT-prch + v-ov-VAT-base * v-prch-mult
     2549           p-ov-SLT-prch = p-ov-SLT-prch + v-ov-SLT-base * v-prch-mult
     2550         .
     2551       end.
     2552     end.
     2553   end procedure.
     2554   procedure prdoclib-calc-ov :
     2555     define input  parameter p-price-list-recid as recid     no-undo .
     2556     define output parameter p-fact-qnty        as decimal   no-undo .
     2557     define output parameter p-ov-base          as decimal   no-undo .
     2558     define output parameter p-ov-VAT-base      as decimal   no-undo .
     2559     define output parameter p-ov-SLT-base      as decimal   no-undo .
     2560     do
     2561     on error undo, return error return-value
     2562     :
     2563       define buffer buf_main_price-list    for ub.price-list .
     2564       define buffer buf_prev_price-list    for ub.price-list .
     2565       define buffer buf_special_price-list for ub.price-list .
     2566       define buffer buf_goods              for ub.goods .
     2567       define variable v-fact-qnty             like ub.doc-line.price-base no-undo.
     2568       define variable v-cur-base              like ub.doc-line.price-base no-undo.
     2569       define variable v-cur-VAT-base          like ub.doc-line.price-base no-undo.
     2570       define variable v-cur-SLT-base          like ub.doc-line.price-base no-undo.
     2571       define variable v-cur-road-tax-base     like ub.doc-line.price-base no-undo.
     2572       define variable v-cur-excise-base       like ub.doc-line.price-base no-undo.
     2573       define variable v-prev-price-list-recid as   recid                  no-undo.
     2574       define variable v-prev-cli-base-rate    like ub.goods.cli-base-rate no-undo.
     2575       define variable v-prev-fact-qnty        like ub.doc-line.price-base no-undo.
     2576       define variable v-prev-cur-base         like ub.doc-line.price-base no-undo.
     2577       define variable v-prev-cur-VAT-base     like ub.doc-line.price-base no-undo.
     2578       define variable v-prev-cur-SLT-base     like ub.doc-line.price-base no-undo.
     2579       find first buf_main_price-list no-lock
     2580         where recid(buf_main_price-list) = p-price-list-recid
     2581         no-error .
     2582       if not available buf_main_price-list
     2583       then do:
     2584         message
     2585           vss-workfile vss-revision vss-description skip
     2586           vss-include-info20 skip
     2587           "Ошибка задания входных параметров" skip
     2588           "Не найдена строка переоценки" skip
     2589           "Код записи (recid)" p-price-list-recid skip
     2590           view-as alert-box error .
     2591         undo, return error .
     2592       end.
     2593       if buf_main_price-list.main-price <> true
     2594       then do:
     2595         message
     2596           vss-workfile vss-revision vss-description skip
     2597           vss-include-info20 skip
     2598           "Ошибка задания входных параметров" skip
     2599           "Строка переоценки не является основной" skip
     2600           "Код записи (recid)" p-price-list-recid skip
     2601           "Переоценка" buf_main_price-list.doc-num skip
     2602           "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     2603           "Бар-код" buf_main_price-list.b-code skip
     2604           view-as alert-box error .
     2605         undo, return error .
     2606       end.
     2607       run prdoclib-calc-fact-sale in this-procedure
     2608         (input  recid(buf_main_price-list)
     2609         ,output v-fact-qnty
     2610         ,output v-cur-base
     2611         ,output v-cur-VAT-base
     2612         ,output v-cur-SLT-base
     2613         ,output v-cur-road-tax-base
     2614         ,output v-cur-excise-base
     2615         ) no-error.
     2616       if error-status :error
     2617       then do:
     2618         message
     2619           vss-workfile vss-revision vss-description skip
     2620           vss-include-info20 skip
     2621           "Ошибка при расчете сумм переоценки." skip
     2622           "Документ переоценки" buf_main_price-list.doc-num skip
     2623           "Товар" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     2624           error-status :get-message(1) skip
     2625           return-value skip
     2626           view-as alert-box error .
     2627         undo, return error .
     2628       end.
     2629   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2630   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodepls in g#library
     2631     (input  buf_main_price-list.obj-type
     2632     ,input  buf_main_price-list.obj-code
     2633     ,input  buf_main_price-list.b-code
     2634     ,input  buf_main_price-list.b-code
     2635     ,input  buf_main_price-list.fact-order
     2636     ,output v-prev-price-list-recid
     2637     ,output v-prev-cli-base-rate
     2638     ) no-error .
     2639       if error-status :error
     2640       then do:
     2641         message
     2642           vss-workfile vss-revision vss-description skip
     2643           vss-include-info20 skip
     2644           "Ошибка при поиске предыдущей переоценки." skip
     2645           "Документ переоценки " buf_main_price-list.doc-num skip
     2646           "Товар " buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     2647           error-status :get-message(1) skip
     2648           return-value skip
     2649           view-as alert-box error .
     2650         undo, return error .
     2651       end.
     2652       if v-prev-price-list-recid <> ?
     2653       then do:
     2654         find first buf_prev_price-list no-lock
     2655           where recid(buf_prev_price-list) = v-prev-price-list-recid
     2656           .
     2657         find first buf_special_price-list no-lock
     2658           where buf_special_price-list.doc-num    = buf_prev_price-list.doc-num
     2659             and buf_special_price-list.main-price = false
     2660             and buf_special_price-list.artic      = buf_prev_price-list.artic
     2661             and buf_special_price-list.prod-type  = buf_prev_price-list.prod-type
     2662             and buf_special_price-list.prod-code  = buf_prev_price-list.prod-code
     2663             and buf_special_price-list.doc-qnty   <> ?
     2664           no-error .
     2665         if available buf_special_price-list
     2666         then do:
     2667           message
     2668             "Товар имеет специальные цены на признаки" skip
     2669             "Разбиение суммы переоценки по консигнации, выкупу невозможно" skip
     2670             "Переоценка" buf_prev_price-list.doc-num skip
     2671             "Товар" buf_prev_price-list.artic buf_prev_price-list.prod-type buf_prev_price-list.prod-code skip
     2672             view-as alert-box error .
     2673           undo, return error .
     2674         end.
     2675         find first buf_goods no-lock
     2676           where buf_goods.artic     = buf_main_price-list.artic
     2677             and buf_goods.prod-type = buf_main_price-list.prod-type
     2678             and buf_goods.prod-code = buf_main_price-list.prod-code
     2679           no-error .
     2680         if not available buf_goods
     2681         then do:
     2682           message
     2683             vss-workfile vss-revision vss-description skip
     2684             vss-include-info20 skip
     2685             "Не найден товар" skip
     2686             "Переоценка" buf_main_price-list.doc-num skip
     2687             "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     2688             view-as alert-box error .
     2689           undo, return error .
     2690         end.
     2691         if buf_prev_price-list.vat-pc = ?
     2692         or buf_prev_price-list.slt-pc = ?
     2693         then do:
     2694           message
     2695             "В переоценке не заданы налоги товара" skip
     2696             "Разбиение суммы переоценки по консигнации, выкупу невозможно" skip
     2697             "Переоценка" buf_prev_price-list.doc-num skip
     2698             "Товар" buf_prev_price-list.artic buf_prev_price-list.prod-type buf_prev_price-list.prod-code skip
     2699             "НДС" buf_prev_price-list.vat-pc skip
     2700             "НП" buf_prev_price-list.slt-pc skip
     2701             view-as alert-box error .
     2702           undo, return error return-value .
     2703         end.
     2704         define variable v-prev-cur-SLT-pc as decimal no-undo .
     2705         assign
     2706           v-prev-cur-SLT-pc   = buf_prev_price-list.price-sale * buf_prev_price-list.slt-pc / (100 + buf_prev_price-list.slt-pc)
     2707         .
     2708         assign
     2709           v-prev-cur-base     = v-fact-qnty * buf_prev_price-list.price-sale
     2710           v-prev-cur-VAT-base = v-fact-qnty
     2711                               * (buf_prev_price-list.price-sale - v-prev-cur-SLT-pc)
     2712                               * buf_prev_price-list.vat-pc / (100 + buf_prev_price-list.vat-pc)
     2713           v-prev-cur-SLT-base = v-fact-qnty * v-prev-cur-SLT-pc
     2714         .
     2715         assign
     2716           p-fact-qnty   = v-fact-qnty
     2717           p-ov-base     = v-cur-base     - v-prev-cur-base
     2718           p-ov-VAT-base = v-cur-VAT-base - v-prev-cur-VAT-base
     2719           p-ov-SLT-base = v-cur-SLT-base - v-prev-cur-SLT-base
     2720         .
     2721       end.
     2722       else do:
     2723         assign
     2724           v-prev-cur-base     = 0
     2725           v-prev-cur-VAT-base = 0
     2726           v-prev-cur-SLT-base = 0
     2727           .
     2728         assign
     2729           p-fact-qnty   = v-fact-qnty
     2730           p-ov-base     = v-cur-base     - v-prev-cur-base
     2731           p-ov-VAT-base = v-cur-VAT-base - v-prev-cur-VAT-base
     2732           p-ov-SLT-base = v-cur-SLT-base - v-prev-cur-SLT-base
     2733         .
     2734       end.
     2735     end.
     2736   end procedure.
     2737   procedure prdoclib-init-prt-obj-by-factord :
     2738     define input parameter p-obj-type           like ub.gds-obj.obj-type  no-undo .
     2739     define input parameter p-obj-code           like ub.gds-obj.obj-code  no-undo .
     2740     define input parameter p-artic              like ub.gds-obj.artic     no-undo .
     2741     define input parameter p-prod-type          like ub.gds-obj.prod-type no-undo .
     2742     define input parameter p-prod-code          like ub.gds-obj.prod-code no-undo .
     2743     define input parameter p-fact-order         as decimal   no-undo .
     2744     define input parameter p-include-fact-order as logical   no-undo .
     2745     define variable vss-description as character no-undo init "prdoclib-init-prt-obj-by-factord: определение остатков по признакам на любой момент времени".
     2746     define buffer buf_gds-obj      for ub.gds-obj .
     2747     define buffer buf_doc-line     for ub.doc-line .
     2748     define buffer buf_temp-prt-obj for temp-prt-obj .
     2749     define variable v-total-gds-dtl-qnty as decimal   no-undo .
     2750     do
     2751     on error undo, return error return-value
     2752     :
     2753       do transaction
     2754       on error undo, return error return-value
     2755       :
     2756   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2757   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     2758     (input  p-obj-type
     2759     ,input  p-obj-code
     2760     ,input  p-artic
     2761     ,input  p-prod-type
     2762     ,input  p-prod-code
     2763     ,buffer buf_gds-obj
     2764     ) no-error .
     2765         if error-status :error
     2766         then do:
     2767           message
     2768             vss-workfile vss-revision vss-description skip
     2769             vss-include-info20 skip
     2770             "Невозможно найти gds-obj" skip
     2771             error-status :get-message(1) skip
     2772             return-value skip
     2773             view-as alert-box error .
     2774           undo, return error .
     2775         end.
     2776         find current buf_gds-obj exclusive-lock .
     2777       end.
     2778       run prdoclib-init-temp-prt-obj in this-procedure
     2779         (input p-obj-type
     2780         ,input p-obj-code
     2781         ,input p-artic
     2782         ,input p-prod-type
     2783         ,input p-prod-code
     2784         ,input 0
     2785         ) .
     2786       for each buf_temp-prt-obj
     2787         where buf_temp-prt-obj.is-term <> true
     2788       on error undo, return error return-value
     2789       :
     2790         delete buf_temp-prt-obj .
     2791       end.
     2792       if p-include-fact-order = true
     2793       then do:
     2794         assign
     2795          p-fact-order = p-fact-order - 0.0000000001
     2796         .
     2797       end.
     2798       for each buf_doc-line no-lock
     2799         where buf_doc-line.obj-type   = p-obj-type
     2800           and buf_doc-line.obj-code   = p-obj-code
     2801           and buf_doc-line.artic      = p-artic
     2802           and buf_doc-line.prod-type  = p-prod-type
     2803           and buf_doc-line.prod-code  = p-prod-code
     2804           and buf_doc-line.status_    = 'факт':U
     2805           and buf_doc-line.fact-order >= p-fact-order
     2806       on error undo, return error return-value
     2807       :
     2808         run prdoclib-process-document in this-procedure
     2809           (input  buf_doc-line.doc-code
     2810           ,input  p-obj-type
     2811           ,input  p-obj-code
     2812           ,input  p-artic
     2813           ,input  p-prod-type
     2814           ,input  p-prod-code
     2815           ,output v-total-gds-dtl-qnty
     2816           ) .
     2817       end.
     2818     end.
     2819   end procedure.
     2820   procedure prdoclib-process-document :
     2821     define input  parameter p-doc-code           as character no-undo .
     2822     define input  parameter p-obj-type           as character no-undo .
     2823     define input  parameter p-obj-code           as integer   no-undo .
     2824     define input  parameter p-artic              as character no-undo .
     2825     define input  parameter p-prod-type          as character no-undo .
     2826     define input  parameter p-prod-code          as integer   no-undo .
     2827     define output parameter p-total-gds-dtl-qnty as decimal   no-undo .
     2828     define buffer buf_trn-doc      for ub.trn-doc .
     2829     define buffer buf_gds-dtl      for ub.gds-dtl .
     2830     define buffer buf_temp-prt-obj for temp-prt-obj .
     2831     do
     2832     on error undo, return error return-value
     2833     :
     2834       find first buf_trn-doc no-lock
     2835         where buf_trn-doc.doc-code = p-doc-code
     2836         no-error .
     2837       if not available buf_trn-doc then do:
     2838         message
     2839           vss-workfile vss-revision vss-description skip
     2840           vss-include-info20 skip
     2841           "Ошибка при поиске документа" skip
     2842           "Документ" p-doc-code skip
     2843           "Объект" p-obj-type p-obj-code skip
     2844           "Артикул" p-artic p-prod-type p-prod-code skip
     2845           view-as alert-box error .
     2846         undo, return error .
     2847       end.
     2848       assign
     2849         p-total-gds-dtl-qnty = 0
     2850       .
     2851       for each buf_gds-dtl no-lock
     2852         where buf_gds-dtl.doc-code  = p-doc-code
     2853           and buf_gds-dtl.artic     = p-artic
     2854           and buf_gds-dtl.prod-type = p-prod-type
     2855           and buf_gds-dtl.prod-code = p-prod-code
     2856       on error undo, return error
     2857       :
     2858         define variable v-term-node as integer   no-undo .
     2859   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run termnode in g#library
     2860     (input  buf_gds-dtl.prt-code
     2861     ,output v-term-node
     2862     )  .
     2863         run prdoclib-temp-prt-obj-by-prt-root in this-procedure
     2864           (input  v-term-node
     2865           ,buffer buf_temp-prt-obj
     2866           ) .
     2867         if buf_temp-prt-obj.is-term <> true then do:
     2868           undo, return error substitute("Документ ссылается на нетерминальный признак. Код признака &1"
     2869                                        ,buf_gds-dtl.prt-code
     2870                                        ) .
     2871         end.
     2872         case buf_trn-doc.doc-type :
     2873           when 'при':U or
     2874           when 'возврат':U
     2875           then do:
     2876             assign
     2877               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     2878                                           - buf_gds-dtl.fact-qnty
     2879               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     2880                                           - buf_gds-dtl.fact-qnty
     2881             .
     2882           end.
     2883           when 'рас':U or
     2884           when 'спи':U
     2885           then do:
     2886             assign
     2887               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     2888                                           + buf_gds-dtl.fact-qnty
     2889               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     2890                                           + buf_gds-dtl.fact-qnty
     2891             .
     2892           end.
     2893           when 'инв':U
     2894           then do:
     2895             assign
     2896               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     2897                                           - buf_gds-dtl.doc-qnty
     2898               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     2899                                           - buf_gds-dtl.doc-qnty
     2900             .
     2901           end.
     2902           otherwise do:
     2903             undo, return error substitute("Неизвестный тип документа &1"
     2904                                          ,buf_trn-doc.doc-type
     2905                                          ) .
     2906           end.
     2907         end.
     2908       end.
     2909     end.
     2910   end procedure.
     2911   procedure prdoclib-prc-pl-document :
     2912     define input  parameter p-doc-code              as character no-undo .
     2913     define input  parameter p-obj-type              as character no-undo .
     2914     define input  parameter p-obj-code              as integer   no-undo .
     2915     define input  parameter p-gds-code              as integer   no-undo .
     2916     define output parameter p-total-pl-gds-qnty     as decimal   no-undo .
     2917     define output parameter p-total-pl-gds-cli-qnty as decimal   no-undo .
     2918     do
     2919     on error undo, return error return-value
     2920     :
     2921       define buffer buf_trn-doc      for ub.trn-doc .
     2922       define buffer buf_doc-pl       for ub.doc-pl .
     2923       define buffer buf_temp-pl-gds for temp-pl-gds .
     2924       define variable v-sign as decimal   no-undo .
     2925       find first buf_trn-doc no-lock
     2926         where buf_trn-doc.doc-code = p-doc-code
     2927         no-error .
     2928       if not available buf_trn-doc then do:
     2929         message
     2930           vss-workfile vss-revision vss-description skip
     2931           vss-include-info20 skip
     2932           "Ошибка при поиске документа" skip
     2933           "Документ" p-doc-code skip
     2934           "Объект" p-obj-type p-obj-code skip
     2935           "Товар" p-gds-code skip
     2936           view-as alert-box error .
     2937         undo, return error .
     2938       end.
     2939       assign
     2940         p-total-pl-gds-qnty     = 0
     2941         p-total-pl-gds-cli-qnty = 0
     2942       .
     2943       for each buf_doc-pl no-lock
     2944         where buf_doc-pl.out-code  = p-doc-code
     2945           and buf_doc-pl.gds-code  = p-gds-code
     2946       on error undo, return error return-value
     2947       :
     2948         find first buf_temp-pl-gds
     2949           where buf_temp-pl-gds.obj-type = buf_trn-doc.obj-type
     2950             and buf_temp-pl-gds.obj-code = buf_trn-doc.obj-code
     2951             and buf_temp-pl-gds.pl-code  = buf_doc-pl.pl-code
     2952           .
     2953         case buf_trn-doc.doc-type :
     2954           when 'при':U
     2955           or when 'возврат':U
     2956           or when 'инв':U
     2957           then do:
     2958             assign
     2959               v-sign = -1.0
     2960             .
     2961           end.
     2962           when 'рас':U or
     2963           when 'спи':U
     2964           then do:
     2965             assign
     2966               v-sign = 1.0
     2967             .
     2968           end.
     2969           otherwise do:
     2970             undo, return error substitute("(prdoclib-prc-pl-document) Неизвестный тип документа &1", buf_trn-doc.doc-type ) .
     2971           end.
     2972         end case.
     2973         assign
     2974           p-total-pl-gds-qnty           = p-total-pl-gds-qnty           + buf_doc-pl.fact-qnty     * v-sign
     2975           p-total-pl-gds-cli-qnty       = p-total-pl-gds-cli-qnty       + buf_doc-pl.cli-fact-qnty * v-sign
     2976           buf_temp-pl-gds.fact-qnty     = buf_temp-pl-gds.fact-qnty     + buf_doc-pl.fact-qnty     * v-sign
     2977           buf_temp-pl-gds.cli-fact-qnty = buf_temp-pl-gds.cli-fact-qnty + buf_doc-pl.cli-fact-qnty * v-sign
     2978         .
     2979       end.
     2980     end.
     2981   end procedure.
     2982   procedure prdoclib-init-prt-obj-by-date :
     2983     define input parameter p-obj-type   like ub.gds-obj.obj-type  no-undo .
     2984     define input parameter p-obj-code   like ub.gds-obj.obj-code  no-undo .
     2985     define input parameter p-artic      like ub.gds-obj.artic     no-undo .
     2986     define input parameter p-prod-type  like ub.gds-obj.prod-type no-undo .
     2987     define input parameter p-prod-code  like ub.gds-obj.prod-code no-undo .
     2988     define input parameter p-fact-date  as date      no-undo .
     2989     define variable vss-description as character no-undo init "prdoclib-init-prt-obj-by-date: определение остатков по признакам на конец дня".
     2990     do
     2991     on error undo, return error return-value
     2992     :
     2993       define variable v-fact-order                as decimal   no-undo .
     2994       define variable v-shift-end-fact-order      as decimal   no-undo .
     2995       define variable v-day-end-fact-order        as decimal   no-undo .
     2996       run factord in this-procedure
     2997         (input  p-fact-date
     2998         ,input  1
     2999         ,input  1
     3000         ,input  ?
     3001         ,input  0
     3002         ,input  false
     3003         ,output v-fact-order
     3004         ,output v-shift-end-fact-order
     3005         ,output v-day-end-fact-order
     3006         ) no-error .
     3007       if error-status :error
