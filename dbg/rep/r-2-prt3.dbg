     2210           ,output price-rubl-with-tax-sale-prl
     2211           ,output price-base-with-tax-sale-prl
     2212           ,output price-rubl-without-tax-sale-prl
     2213           ,output price-base-without-tax-sale-prl
     2214           ,output vat-base-sale-prl
     2215           ,output vat-rubl-sale-prl
     2216           ,output vat-base-buyer-prl
     2217           ,output vat-rubl-buyer-prl
     2218           ,output slt-base-sale-prl
     2219           ,output slt-rubl-sale-prl
     2220           ,output road-tax-base-sale-prl
     2221           ,output road-tax-rubl-sale-prl
     2222           ,output excise-base-sale-prl
     2223           ,output excise-rubl-sale-prl
