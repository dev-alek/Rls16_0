      908   function func-vat returns decimal (
      909       input p-gds-code as integer  ,
      910       input p-obj-type as character ,
      911       input p-obj-code as integer  ).
      912   define variable i-vat-pc as decimal no-undo .
      913   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      914   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
      915     (input  p-gds-code
      916     ,input  '1':U
      917     ,input  x-Date-End
      918     ,input  v-cntxt-host-code-obj
      919     ,input  p-obj-type
      920     ,input  p-obj-code
