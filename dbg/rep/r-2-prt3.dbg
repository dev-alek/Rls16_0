     3479   def var vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3480   procedure macr_excel_char :
     3481    do
     3482    on error undo, return error return-value
     3483    :
     3484    define input parameter  p-val as character no-undo .
     3485    define input parameter  p-row as integer no-undo .
     3486    define input parameter  p-col as integer no-undo .
     3487    if p-val = ? then p-val = "" .
     3488       put stream macr_excel unformatted
     3489             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     3490    end.
     3491   end procedure.
     3492   procedure macr_excel_char_with_format :
     3493    do
     3494    on error undo, return error return-value
     3495    :
     3496    define input parameter  p-val as character no-undo .
     3497    define input parameter  p-row as integer no-undo .
     3498    define input parameter  p-col as integer no-undo .
     3499    if p-val = ? then p-val = "" .
     3500       put stream macr_excel unformatted
     3501             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     3502       put stream macr_excel unformatted 'format.number("@")' + chr(10) .
     3503       put stream macr_excel unformatted
     3504             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     3505    end.
     3506   end procedure.
     3507   procedure macr_excel_cell_format :
     3508    do
     3509    on error undo, return error return-value
     3510    :
     3511    define input parameter  p-val    as character no-undo .
     3512    define input parameter  p-row    as integer   no-undo .
     3513    define input parameter  p-col    as integer   no-undo .
     3514    define input parameter  p-format as character no-undo .
     3515    if p-val = ? then p-val = "" .
     3516       put stream macr_excel unformatted
     3517             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     3518       put stream macr_excel unformatted substitute('format.number("&1")', p-format) + chr(10) .
     3519       put stream macr_excel unformatted
     3520             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     3521    end.
     3522   end procedure.
     3523   procedure macr_excel_sum :
     3524    do
     3525    on error undo, return error return-value
     3526    :
     3527    define input parameter  p-row as integer no-undo .
     3528    define input parameter  p-col as integer no-undo .
     3529    define input parameter  p-row1 as integer no-undo .
     3530    define input parameter  p-col1 as integer no-undo .
     3531    define input parameter  p-row2 as integer no-undo .
     3532    define input parameter  p-col2 as integer no-undo .
     3533       put stream macr_excel unformatted
     3534             substitute('formula("=sum(r&3c&4:r&5c&6)","r&1c&2")', p-row , p-col , p-row1 , p-col1 ,p-row2 , p-col2 ) + chr(10)  .
     3535    end.
     3536   end procedure.
     3537   procedure macr_excel_dec :
     3538    do
     3539    on error undo, return error return-value
     3540    :
     3541    define input parameter  p-val as character no-undo .
     3542    define input parameter  p-row as integer   no-undo .
     3543    define input parameter  p-col as integer   no-undo .
     3544     if p-val = ? then p-val =  "" .
     3545      put  stream macr_excel unformatted
     3546           substitute('formula(&3,"r&1c&2")', p-row , p-col ,  p-val )  + chr(10) .
     3547    end.
     3548   end procedure.
     3549   procedure macr_cell_format :
     3550    do
     3551    on error undo, return error return-value
     3552    :
     3553    define input parameter  p-size   as integer   no-undo .
     3554    define input parameter  p-bold   as logical   no-undo .
     3555    define input parameter  p-italic as logical   no-undo .
     3556    define input parameter  p-color  as integer   no-undo .
     3557    define input parameter  p-row    as integer   no-undo .
     3558    define input parameter  p-col    as integer   no-undo .
     3559    define input parameter  p-row-2  as integer   no-undo .
     3560    define input parameter  p-col-2  as integer   no-undo .
     3561     if p-size = ? then p-size = 10 .
     3562     if p-bold = ? then p-bold = false .
     3563     if p-italic = ? then p-italic = false .
     3564     if p-row-2 = ? then p-row-2 = p-row .
     3565     if p-col-2 = ? then p-col-2 = p-col .
     3566     put  stream macr_excel unformatted
     3567      substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 ) + chr(10) .
     3568     if p-color <> ? then do:
     3569        put  stream macr_excel unformatted
     3570          substitute('patterns(1,,&1,true)', p-color ) + chr(10)  .
     3571     end.
     3572     put  stream macr_excel unformatted
     3573          substitute('format.font(,&1,&2,&3)' , p-size,
     3574                                           string ( p-bold  , "true/false" ) ,
     3575                                           string ( p-italic , "true/false" )
     3576                                           ) + chr(10) .
     3577    end.
     3578   end procedure.
     3579   procedure macr_cell_size :
     3580    do
     3581    on error undo, return error return-value
     3582    :
     3583    define input parameter  p-w   as integer   no-undo .
     3584    define input parameter  p-l   as integer   no-undo .
     3585    define input parameter  p-row    as integer   no-undo .
     3586    define input parameter  p-col    as integer   no-undo .
     3587    define input parameter  p-row-2  as integer   no-undo .
     3588    define input parameter  p-col-2  as integer   no-undo .
     3589     if p-row-2 = ? then p-row-2 = p-row .
     3590     if p-col-2 = ? then p-col-2 = p-col .
     3591     if p-w = ? then    p-w = 0 .
     3592     if p-l = ? then    p-l = 0 .
     3593    define variable s-w as character no-undo .
     3594    define variable s-l as character no-undo .
     3595    if p-w = 0 then s-w = "" .
     3596               else s-w = string(p-w)  .
     3597    if p-l = 0 then s-l = "" .
     3598               else s-l = string(p-l)  .
     3599   put  stream macr_excel unformatted
     3600        substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 )  skip .
     3601   put  stream macr_excel unformatted
     3602        substitute('COLUMN.WIDTH(&1,,,,)' , s-w  )  skip.
     3603   put  stream macr_excel unformatted
     3604        'FORMAT.TEXT(2,2,0,,,,,)'  skip.
     3605    end.
     3606   end procedure.
     3607   procedure proc-print-header :
     3608    do
     3609    on error undo, return error return-value
     3610    :
     3611      find first sheetf .
     3612        sheetf.excel-row-heder =  num-entries( c-str ,chr(10)) + 1.
     3613        sheetf.excel-row-title =  num-entries( sheetf.excel-column-lable , chr(10) ).
     3614        var-1 =  num#str# .
     3615        repeat c-c = 1 to sheetf.excel-row-title :
     3616        num#str# = num#str# + 1 .
     3617        p-var = num-entries( entry (c-c, sheetf.excel-column-lable, chr(10)) , chr(44) ) .
     3618        do c-i = 1 to p-var :
     3619           str--1 = entry( c-i, entry (c-c,sheetf.excel-column-lable, chr(10)) , chr(44)) .
     3620           str--2 = integer(entry( c-i, sheetf.sizes )) .
     3621           num#col# = c-i .
     3622           run macr_excel_char_with_format ( str--1  , num#str# , num#col#  ) .
     3623           run macr_cell_size ( str--2 , ? , num#str# , num#col# , ?, ? ) .
     3624        end.
     3625       c-i = 0.
     3626       end.
     3627       run macr_cell_format (
     3628           10       ,
     3629           true     ,
     3630           false    ,
     3631           35       ,
     3632           var-1 + 1,
     3633           1        ,
     3634           num#str# ,
     3635           num#col# )
     3636           .
     3637     put  stream macr_excel unformatted
     3638          substitute('select("r&1c&2:r&3c&4 ")' , var-1 + 1 , 1 , num#str# ,  num#col# ) + chr(10)  +
     3639          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     3640          .
     3641    end.
     3642   end procedure.
     3643   procedure end-proc :
     3644    do
     3645    on error undo, return error return-value
     3646    :
     3647     v-file-name = ( string( session:temp-directory + "rpt" + string( g#report-num ) ) + ".t-t").
     3648     OUTPUT to VALUE (v-file-name) .
     3649     for each temp-param :
     3650       export  temp-param  .
     3651     end.
     3652    end.
     3653   end procedure.
     3654   define variable v-account as integer init 0 no-undo .
     3655   define variable v-account-lavel as character no-undo .
     3656   define variable v-button-stop as logical no-undo .
     3657   define variable v-kol-spice as integer no-undo .
     3658   define variable v-kol-spice2 as integer no-undo .
     3659   define variable v-kol-spice3 as integer no-undo .
     3660   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     3661   DEFINE BUTTON StopBtn AUTO-END-KEY
     3662        LABEL "Стоп"
     3663        SIZE 10 BY 1.
     3664   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     3665        LABEL "Обработано записей"
     3666         VIEW-AS TEXT
     3667        SIZE 14 BY .67 NO-UNDO.
     3668   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     3669         VIEW-AS TEXT
     3670        SIZE 53.25 BY .67
     3671        FGCOLOR 1  NO-UNDO.
     3672   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     3673         VIEW-AS TEXT
     3674        SIZE 53.25 BY .67
     3675        FGCOLOR 1  NO-UNDO.
     3676   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     3677         VIEW-AS TEXT
     3678        SIZE 53.25 BY .67
     3679        FGCOLOR 1  NO-UNDO.
     3680   DEFINE RECTANGLE RECT-1
     3681        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     3682        SIZE 55.13 BY 4.46.
     3683   DEFINE FRAME InfoFrame
     3684        StopBtn AT ROW 4.25 COL 21.75
     3685        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     3686        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     3687        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     3688        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     3689        RECT-1 AT ROW 1 COL 1
     3690       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     3691            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     3692            TITLE "Процесс"
     3693            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     3694   define variable mFrameView      as logical   no-undo init yes.
     3695     define variable mFramHandle as handle no-undo.
     3696     mFramHandle = frame InfoFrame:handle.
     3697     if  log-manager:logfile-name ne ?
     3698     then DO:
     3699         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     3700         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     3701         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     3702     end.
     3703     mFrameView = not session:batch-mode and mFramHandle:visible.
     3704     if mFrameView
     3705     then do:
     3706       ASSIGN
     3707          FRAME InfoFrame:HIDDEN                           = TRUE
     3708          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     3709     end.
     3710   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     3711   DO:
     3712     IF not StopProcessing THEN
     3713       Message "Вы действительно хотите прервать" SKIP
     3714               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     3715                 UPDATE StopProcessing.
     3716     IF StopProcessing THEN do:
     3717        if mFrameView
     3718        then do:
     3719           HIDE FRAME InfoFrame.
     3720        end.
     3721     End.
     3722   END.
     3723   assign v-account = ( if integer( 100 ) = 0 then 100 else integer( 100 ) ).
     3724     if  log-manager:logfile-name ne ?
     3725     then DO:
     3726         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     3727     end.
     3728     if not session:batch-mode then
     3729     do:
     3730       VIEW FRAME InfoFrame.
     3731       mFrameView = true.
     3732     end.
     3733      v-button-stop = false .
     3734         if mFrameView
     3735         then do:
     3736         if v-button-stop then view STOPBTN in frame InfoFrame.
     3737                          else Hide STOPBTN in frame InfoFrame.
     3738         end.
     3739   for each tdedt :
     3740      case tdedt.id :
     3741                     when  'ie':U    then do:
     3742                       pp-prih-qnty = true.
     3743                     end.
     3744                     when 'ep':U  then do:
     3745                       pp-voz-qnty = true.
     3746                     end.
     3747                     when 'ee':U      or
     3748                     when 're':U  then
     3749                         pp-rash-qnty = true.
     3750                     when 'rs':U or
     3751                     when 'es':U   then do:
     3752                         pp-kassa-qnty = true .
     3753                     end.
     3754                     when 'we':U        then do:
     3755                         pp-spis-qnty = true .
     3756                     end.
     3757                     when 'vt':U    or
     3758                     when 'vp':U   or
     3759                     when 'ap':U   or
     3760                     when 'mp':U             then do:
     3761                         pp-inv-qnty = true.
     3762                     end.
     3763                     when 'iv':U        or
     3764                     when 'im':U         or
     3765                     when 'ev':U        or
     3766                     when 'rv':U    or
     3767                     when 'em':U         or
     3768                     when 'wm':U         then do:
     3769                         pp-perem-qnty = true.
     3770                     end.
     3771                 end case.
     3772   end.
     3773   run report-execute in this-procedure .
     3774   procedure report-execute :
     3775    do
     3776    on error undo, return error return-value
     3777    :
     3778       p-file-name =  string( session:temp-directory +
     3779                                     "rpt" + string( g#report-num ) + ".txt" ) .
     3780   run gbl/_tmpfile.p ("wb", ".txt", output v-file-name) .
     3781   output stream macr_excel to value(v-file-name)   .
     3782   v-ind = 1    .
     3783   num#str# = 0 .
     3784     run calcitog in this-procedure.
     3785         num#str# = num#str# + 1 .
     3786         num#col# =  1 .
     3787         run macr_excel_char_with_format( reportname , num#str# , num#col#  ).
     3788         run macr_cell_format
     3789             ( 12       ,
     3790               true     ,
     3791               false    ,
     3792               ?        ,
     3793               num#str# ,
     3794               num#col# ,
     3795               ?        ,
     3796               ?         ) .
     3797   define variable l-ii  as integer no-undo .
     3798   define variable l-jj  as integer no-undo .
     3799   define variable l-len as integer no-undo .
     3800   define variable l-m   as integer no-undo .
     3801   do l-ii = 1 to num-entries( str1 , "chr(10)"  )    :        l-len = length (entry( l-ii , str1  , "chr(10)")) .                       l-m = integer( l-len / 220 ) + 1 .                                                      do l-jj = 1 to  l-m  :                                                                      num#str# = num#str# + 1 .                                                               run macr_excel_char_with_format(                                                                        substring(entry( l-ii , str1  , "chr(10)") , (( 220 * l-jj ) - 219 )  , 220 )  , num#str# , num#col# ) .      end.                                                                                                         end.
     3802   do l-ii = 1 to num-entries( str2 , "chr(10)"  )    :        l-len = length (entry( l-ii , str2  , "chr(10)")) .                       l-m = integer( l-len / 220 ) + 1 .                                                      do l-jj = 1 to  l-m  :                                                                      num#str# = num#str# + 1 .                                                               run macr_excel_char_with_format(                                                                        substring(entry( l-ii , str2  , "chr(10)") , (( 220 * l-jj ) - 219 )  , 220 )  , num#str# , num#col# ) .      end.                                                                                                         end.
     3803   do l-ii = 1 to num-entries( str3 , "chr(10)"  )    :        l-len = length (entry( l-ii , str3  , "chr(10)")) .                       l-m = integer( l-len / 220 ) + 1 .                                                      do l-jj = 1 to  l-m  :                                                                      num#str# = num#str# + 1 .                                                               run macr_excel_char_with_format(                                                                        substring(entry( l-ii , str3  , "chr(10)") , (( 220 * l-jj ) - 219 )  , 220 )  , num#str# , num#col# ) .      end.                                                                                                         end.
     3804   do l-ii = 1 to num-entries( str4 , "chr(10)"  )    :        l-len = length (entry( l-ii , str4  , "chr(10)")) .                       l-m = integer( l-len / 220 ) + 1 .                                                      do l-jj = 1 to  l-m  :                                                                      num#str# = num#str# + 1 .                                                               run macr_excel_char_with_format(                                                                        substring(entry( l-ii , str4  , "chr(10)") , (( 220 * l-jj ) - 219 )  , 220 )  , num#str# , num#col# ) .      end.                                                                                                         end.
     3805   do l-ii = 1 to num-entries( reportheader , "chr(10)"  )    :        l-len = length (entry( l-ii , reportheader  , "chr(10)")) .                       l-m = integer( l-len / 220 ) + 1 .                                                      do l-jj = 1 to  l-m  :                                                                      num#str# = num#str# + 1 .                                                               run macr_excel_char_with_format(                                                                        substring(entry( l-ii , reportheader  , "chr(10)") , (( 220 * l-jj ) - 219 )  , 220 )  , num#str# , num#col# ) .      end.                                                                                                         end.
     3806   num#str# = num#str# + 1.
     3807   num#col# = 1.
     3808     Find first ub.gds-prt where ub.gds-prt.node-name = '_Пустая шкала':U no-lock no-error.
     3809     If available  ub.gds-prt then   Prtroot = ub.gds-prt.prt-root.
     3810                           Else   Prtroot = 0.
     3811       case classify :
     3812         when 1 then do:
     3813           run foreach1 in this-procedure.
     3814         end.
     3815         when 2 then do:
     3816           run foreach2 in this-procedure.
     3817         end.
     3818         when 3 then do:
     3819           run foreach3 in this-procedure.
     3820         end.
     3821       end case.
     3822     output stream macr_excel  close .
     3823   if mFrameView
     3824   then do:
     3825      HIDE FRAME InfoFrame.
     3826   end.
     3827       run paramls-write in this-procedure
     3828         (input "file"
     3829         ,input string(v-ind)
     3830         ,input v-file-name
     3831         ) .
     3832       run paramls-write in this-procedure
     3833           (input "charcol"
     3834           ,input ""
     3835           ,input "1,2"
     3836           ) .
     3837     run end-proc .
     3838     run rep/runexcel.p (p-file-name ).
     3839    end.
     3840   end procedure.
     3841   procedure calcitog :
     3842    do
     3843    on error undo, return error return-value
     3844    :
     3845       run day-begin-fact-order(
     3846           input x-date-start ,
     3847           output fact-order-1  ) .
     3848       run day-begin-fact-order(
     3849           input ( x-date-end + 1 ) ,
     3850           output fact-order-2  ) .
     3851    end.
     3852   end procedure.
     3853   procedure print-header :
     3854    do
     3855    on error undo, return error return-value
     3856    :
     3857     define input parameter p-name  as character no-undo .
     3858         num#str# = num#str# + 3 .
     3859         run macr_excel_char_with_format( p-name , num#str# , 1  ).
     3860         run macr_cell_format
     3861             ( 12       ,
     3862               true     ,
     3863               true     ,
     3864               35        ,
     3865               num#str# ,
     3866               1 ,
     3867               num#str# ,
     3868               6   ) .
     3869     first-name = "".
     3870     first-str = false .
     3871    end.
     3872   end procedure.
     3873   procedure print-footer :
     3874    do
     3875    on error undo, return error return-value
     3876    :
     3877     define input parameter p-name  as character no-undo .
     3878         num#str# = num#str# + 1 .
     3879         run macr_excel_char_with_format( p-name , num#str# , 1  ).
     3880         run macr_cell_format
     3881             ( 12       ,
     3882               true     ,
     3883               true     ,
     3884               ?        ,
     3885               num#str# ,
     3886               1 ,
     3887               num#str# ,
     3888               6   ) .
     3889     last-name = "".
     3890     last-str = false .
     3891    end.
     3892   end procedure.
     3893   procedure make-gds-list :
     3894    do
     3895    on error undo, return error return-value
     3896    :
     3897     i = 0 .
     3898      for each obj-list no-lock :
     3899       i = i + 100 .
     3900   IF ( i modulo v-account = 0 )  then DO:
     3901    Assign
     3902       v-kol-spice = (50 - LENGTH('Сбор списка товара')) / 2
     3903       RecordsString = fill(' ',v-kol-spice) + string('Сбор списка товара')
     3904       .
     3905    Assign
     3906       v-kol-spice = (50 - LENGTH(Obj-list.obj-name)) / 2
     3907       RecordsString2 = fill(' ',v-kol-spice) + string(Obj-list.obj-name)
     3908       .
     3909             if  log-manager:logfile-name ne ?
     3910             then DO:
     3911                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     3912             end.
     3913              if mFrameView
     3914              then do:
     3915               DISPLAY
     3916                 i @ RecordsDone
     3917                 RecordsString   @ RecordsString
     3918                 RecordsString2  @ RecordsString2
     3919                 WITH FRAME InfoFrame.
     3920              end.
     3921   End.
     3922      if v-button-stop then  DO:
     3923            if mFrameView
     3924            then
     3925               PROCESS EVENTS.
     3926            IF StopProcessing THEN DO:
     3927            RETURN error.
     3928            End.
     3929      end.
     3930                for each ub.gds-obj where
     3931                         ub.gds-obj.obj-type = obj-list.obj-type    and
     3932                         ub.gds-obj.obj-code = obj-list.obj-code
     3933                         and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     3934                         no-lock,
     3935                   first gds-list  where ub.gds-obj.gds-code  = gds-list.gds-code
     3936                   no-lock :
     3937                         if not can-find(first temp-gds where temp-gds.gds-code = ub.gds-obj.gds-code)
     3938                             and Prtroot <> gds-list.prt-root    then do:
     3939                             find first ub.clients where
     3940                                         ub.clients.obj-type = ub.gds-obj.prod-type and
     3941                                         ub.clients.obj-code = ub.gds-obj.prod-code  no-lock no-error .
     3942                               find first ub.gds-prt no-lock  where  ub.gds-prt.prt-root =  integer(gds-list.prt-root) no-error  .
     3943                               if not available ub.gds-prt then next.
     3944   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtlevel in g#library
     3945     (input  ub.gds-prt.node-code
     3946     ,output v-prt-level
     3947     )  .
     3948                                 if v-prt-level > 3 then next.
     3949                             create temp-gds.
     3950                             assign
     3951                               temp-gds.gds-code  = ub.gds-obj.gds-code
     3952                               temp-gds.artic     = ub.gds-obj.artic
     3953                               temp-gds.prod-code = ub.gds-obj.prod-code
     3954                               temp-gds.prod-type = ub.gds-obj.prod-type
     3955                               temp-gds.grp-name  = ub.gds-obj.grp-name
     3956                               temp-gds.gds-name  = gds-list.gds-name
     3957                               temp-gds.prt-root  = gds-list.prt-root
     3958                               temp-gds.prt-lvl   = v-prt-level
     3959                               temp-gds.cli-name  = if available ub.clients
     3960                                  then ( ub.clients.obj-name + " (" + string(gds-obj.prod-code)
     3961                                                                 + ub.gds-obj.prod-type
     3962                                                                 + ")" )
     3963                                  else ""
     3964                              .
     3965                         end.
     3966                end.
     3967      end.
     3968      i = 0 .
     3969    end.
     3970   end procedure.
     3971   procedure foreach1 :
     3972    do
     3973    on error undo, return error return-value
     3974    :
     3975   define variable  p-obj-type           like ub.gds-obj.obj-type  no-undo .
     3976   define variable  p-obj-code           like ub.gds-obj.obj-code  no-undo .
     3977   define variable  p-artic              like ub.gds-obj.artic     no-undo .
     3978   define variable  p-prod-type          like ub.gds-obj.prod-type no-undo .
     3979   define variable  p-prod-code          like ub.gds-obj.prod-code no-undo .
     3980   define variable  p-fact-order         as decimal   no-undo .
     3981   define variable  p-include-fact-order as logical   no-undo .
     3982   define variable l-pusto as logical no-undo .
     3983   first-str = false .
     3984     run make-gds-list.
     3985     for each temp-gds  :
     3986         v-prt-level = temp-gds.prt-lvl .
     3987             run zap
     3988                 ( input-output p-obj-type
     3989                 ,input-output p-obj-code
     3990                 ,input-output p-artic
     3991                 ,input-output p-prod-type
     3992                 ,input-output p-prod-code
     3993                 ,input-output  p-fact-order
     3994                 ,input-output p-include-fact-order )        .
     3995             if itog = false then do:
     3996                 run scan-tt (output l-pusto ).
     3997                 run print-tt.
     3998             end.
     3999             run make-type-prt.
     4000     end.
     4001     run print-type-prt.
     4002    end.
     4003   end procedure.
     4004   procedure clear-matrix :
     4005    do
     4006    on error undo, return error return-value
     4007    :
     4008     for each temp-prt :
     4009        delete temp-prt .
     4010     end.
     4011     for each temp-vert :
     4012        delete temp-vert.
     4013     end.
     4014     for each temp-gor :
     4015        delete temp-gor.
     4016     end.
     4017    end.
     4018   end procedure.
     4019   procedure prt-matrix :
     4020    do
     4021    on error undo, return error return-value
     4022    :
     4023   define input parameter p-prt-code   as integer no-undo .
     4024   define input parameter p-sum-type   as character no-undo .
     4025   define input parameter p-fact-qnty  as decimal no-undo .
     4026   if p-fact-qnty = 0 then return.
     4027   define variable type-0 as character init "" no-undo .
     4028   define variable type-1 as character init "" no-undo .
     4029   define variable type-2 as character init "" no-undo .
     4030   define variable type-11 as character init "" no-undo .
     4031   define variable type-12 as character init "" no-undo .
     4032   define buffer   buf_gds-prt    for ub.gds-prt.
     4033   define variable p-upper-code-1 as integer no-undo .
     4034   define variable p-upper-code-2 as integer no-undo .
     4035    find first temp-prt where temp-prt.prt-code = p-prt-code no-error .
     4036    if not available temp-prt then do:
     4037       find first buf_gds-prt where buf_gds-prt.node-code = p-prt-code no-lock no-error .
     4038       type-1 = buf_gds-prt.node-name.
     4039       p-upper-code-1 = buf_gds-prt.upper-code.
     4040       find first buf_gds-prt where buf_gds-prt.node-code = p-upper-code-1 no-lock no-error .
     4041       if available buf_gds-prt then do:
     4042           type-2 = buf_gds-prt.node-name.
     4043           p-upper-code-2 = buf_gds-prt.upper-code.
     4044           find first buf_gds-prt where buf_gds-prt.node-code = p-upper-code-2 no-lock no-error .
     4045           if available buf_gds-prt then do:
     4046              type-0 = buf_gds-prt.node-name.
     4047           end.
     4048       end.
     4049       if v-prt-level = 3 then do:
     4050           assign
     4051             type-11 = type-1
     4052             type-12 = type-2
     4053             type-1 = type-12
     4054             type-2 = type-11
     4055           .
     4056       end.
     4057         run make-vert-gor (type-1, type-2).
     4058         create temp-prt.
     4059         assign
     4060           temp-prt.prt-code     =  p-prt-code
     4061           temp-prt.type-1       =  type-1
     4062           temp-prt.type-2       =  type-2
     4063           temp-prt.prt-root     =  temp-gds.prt-root
     4064         .
     4065    end.
     4066    case p-sum-type:
     4067       when "ost-1"      then do:  temp-prt.ost-1-qnty   = temp-prt.ost-1-qnty  + p-fact-qnty  . end.
     4068       when "ost-2"      then do:  temp-prt.ost-2-qnty   = temp-prt.ost-2-qnty  + p-fact-qnty  . end.
     4069       when "prih-qnty"  then do:  temp-prt.prih-qnty    = temp-prt.prih-qnty   + p-fact-qnty  . end.
     4070       when "voz-qnty"   then do:  temp-prt.voz-qnty     = temp-prt.voz-qnty    + p-fact-qnty  . end.
     4071       when "rash-qnty"  then do:  temp-prt.rash-qnty    = temp-prt.rash-qnty   + p-fact-qnty  . end.
     4072       when "kassa-qnty"  then do:  temp-prt.kassa-qnty    = temp-prt.kassa-qnty   + p-fact-qnty  . end.
     4073       when "spis-qnty"  then do:  temp-prt.spis-qnty    = temp-prt.spis-qnty   + p-fact-qnty  . end.
     4074       when "inv-qnty"   then do:  temp-prt.inv-qnty     = temp-prt.inv-qnty    + p-fact-qnty  . end.
     4075       when "perem-qnty" then do:  temp-prt.perem-qnty   = temp-prt.perem-qnty  + p-fact-qnty  . end.
     4076    end case.
     4077    end.
     4078   end procedure.
     4079   procedure make-vert-gor :
     4080   do
     4081   on error undo, return error return-value
     4082   :
     4083   define input parameter p-type-1    as character no-undo .
     4084   define input parameter p-type-2    as character no-undo .
     4085   find first temp-vert where temp-vert.type-1 = p-type-1 no-error .
     4086   if not available temp-vert then do:
     4087      create temp-vert.
     4088      temp-vert.type-1 = p-type-1.
     4089   end.
     4090   find first temp-gor where temp-gor.type-2 = p-type-2 no-error .
     4091   if not available temp-gor then do:
     4092      create temp-gor.
     4093      temp-gor.type-2 = p-type-2.
     4094   end.
     4095   end.
     4096   end procedure.
     4097   procedure scan-tt :
     4098    do
     4099    on error undo, return error return-value
     4100    :
     4101   define output parameter p-pusto as logical no-undo .
     4102   define variable ii as integer no-undo .
     4103   define variable ij as integer no-undo .
     4104   p-pusto = false .
     4105           .
     4106   ii = 2.
     4107   for each temp-vert :
     4108       ii = ii + 1 .
     4109       temp-vert.n = ii.
     4110   end.
     4111   ij = 2.
     4112   for each temp-gor :
     4113       ij = ij + 1 .
     4114       temp-gor.n = ij.
     4115   end.
     4116   if not can-find( first temp-vert)  then  p-pusto = true .
     4117    end.
     4118   end procedure.
     4119   procedure print-tt :
     4120    do
     4121    on error undo, return error return-value
     4122    :
     4123   define variable loc-str as integer no-undo .
     4124   define variable hh as integer no-undo .
     4125   define variable lh as integer no-undo .
     4126   define variable max-loc-str as integer no-undo .
     4127   define variable l-row as integer no-undo .
     4128   define variable l-col as integer no-undo .
     4129   define variable p-row as integer no-undo .
     4130   define variable p-col as integer no-undo .
     4131   define variable s-ost-1       as   decimal  no-undo .
     4132   define variable s-ost-2       as   decimal  no-undo .
     4133   define variable s-prih-qnty   as   decimal  no-undo .
     4134   define variable s-voz-qnty    as   decimal  no-undo .
     4135   define variable s-rash-qnty   as   decimal  no-undo .
     4136   define variable s-kassa-qnty   as   decimal  no-undo .
     4137   define variable s-spis-qnty   as   decimal  no-undo .
     4138   define variable s-inv-qnty    as   decimal  no-undo .
     4139   define variable s-perem-qnty  as   decimal  no-undo .
     4140   i = i +  50 .
     4141   IF ( i modulo v-account = 0 )  then DO:
     4142    Assign
     4143       v-kol-spice = (50 - LENGTH('Вывод в файл')) / 2
     4144       RecordsString = fill(' ',v-kol-spice) + string('Вывод в файл')
     4145       .
     4146             if  log-manager:logfile-name ne ?
     4147             then DO:
     4148                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     4149             end.
     4150              if mFrameView
     4151              then do:
     4152               DISPLAY
     4153                 i @ RecordsDone
     4154                 RecordsString   @ RecordsString
     4155                 WITH FRAME InfoFrame.
     4156              end.
     4157   End.
     4158      if v-button-stop then  DO:
     4159            if mFrameView
     4160            then
     4161               PROCESS EVENTS.
     4162            IF StopProcessing THEN DO:
     4163            RETURN error.
     4164            End.
     4165      end.
     4166   define variable ll-i as integer no-undo .
     4167     ll-i        = 0.
     4168   for each temp-vert:
     4169   ll-i  = ll-i + 1.
     4170   if ll-i = 1 then  do:
     4171        if first-str = true  then do:
     4172           run print-header ( first-name ).
     4173        end.
     4174         num#col# =  1 .
     4175         num#str# = num#str# + 1 .
     4176         good-row = num#str#.
     4177         run print-goods (good-row , 1 ).
     4178         num#str# = num#str# + 1 .
     4179         l-row    = num#str# .
     4180         l-col    = 1.
     4181         run macr_excel_char_with_format( "данные" , num#str# , 2  ).
     4182         end.
     4183        run macr_excel_char_with_format( temp-vert.type-1 , num#str# , temp-vert.n  ).
     4184        p-col = temp-vert.n.
     4185   end.
     4186   if ll-i = 0 then return.
     4187   for each temp-gor :
     4188       assign
     4189           s-ost-1     = 0
     4190           s-ost-2     = 0
     4191           s-prih-qnty = 0
     4192           s-voz-qnty  = 0
     4193           s-rash-qnty = 0
     4194           s-kassa-qnty = 0
     4195           s-spis-qnty = 0
     4196           s-inv-qnty  = 0
     4197           s-perem-qnty= 0
     4198       .
     4199     num#str# = num#str# + 1 .
     4200     run macr_excel_char_with_format( temp-gor.type-2 , num#str# , 1 ).
     4201     hh = 0 .
     4202     for each temp-vert:
     4203       loc-str = num#str# .
     4204       find first  temp-prt where
     4205                   temp-prt.type-1  = temp-vert.type-1 and
     4206                   temp-prt.type-2  = temp-gor.type-2  no-error .
     4207         if available temp-prt then do:
     4208         hh = hh + 1 .
     4209         lh = 0 .
     4210           if x-ost-1 = true then do:
     4211                                    lh = lh + 1 .
     4212                                    if lh > 1 then loc-str = loc-str + 1 .
     4213                                    if hh = 1 then run macr_excel_char_with_format( "нач.остаток" , loc-str , 2  ) .
     4214                                    run macr_excel_dec ( temp-prt.ost-1 , loc-str , temp-vert.n  ).
     4215                                end.
     4216           if pp-prih-qnty = true then do:
     4217                                    lh = lh + 1 .
     4218                                    if lh > 1 then loc-str = loc-str + 1 .
     4219                                    if hh = 1 then run macr_excel_char_with_format( "приход" , loc-str , 2  ) .
     4220                                    run macr_excel_dec( temp-prt.prih-qnty , loc-str , temp-vert.n  ).
     4221                                end.
     4222           if pp-voz-qnty = true then do:
     4223                                    lh = lh + 1 .
     4224                                    if lh > 1 then loc-str = loc-str + 1 .
     4225                                    if hh = 1 then run macr_excel_char_with_format( "возврат пост." , loc-str , 2  ) .
     4226                                    run macr_excel_dec( temp-prt.voz-qnty , loc-str , temp-vert.n  ).
     4227                                end.
     4228           if pp-rash-qnty = true then do:
     4229                                    lh = lh + 1 .
     4230                                    if lh > 1 then loc-str = loc-str + 1 .
     4231                                    if hh = 1 then run macr_excel_char_with_format( "расход внеш." , loc-str , 2  ) .
     4232                                    run macr_excel_dec( temp-prt.rash-qnty , loc-str , temp-vert.n  ).
     4233                                end.
     4234           if pp-kassa-qnty = true then do:
     4235                                    lh = lh + 1 .
     4236                                    if lh > 1 then loc-str = loc-str + 1 .
     4237                                    if hh = 1 then run macr_excel_char_with_format( "касса" , loc-str , 2  ) .
     4238                                    run macr_excel_dec( temp-prt.kassa-qnty , loc-str , temp-vert.n  ).
     4239                                end.
     4240           if pp-inv-qnty = true then do:
     4241                                    lh = lh + 1 .
     4242                                    if lh > 1 then loc-str = loc-str + 1 .
     4243                                    if hh = 1 then run macr_excel_char_with_format( "инвентаризация" , loc-str , 2  ) .
     4244                                    run macr_excel_dec( temp-prt.inv-qnty , loc-str , temp-vert.n  ).
     4245                                end.
     4246           if pp-spis-qnty = true then do:
     4247                                    lh = lh + 1 .
     4248                                    if lh > 1 then loc-str = loc-str + 1 .
     4249                                    if hh = 1 then run macr_excel_char_with_format( "списание" , loc-str , 2  ) .
     4250                                    run macr_excel_dec( temp-prt.spis-qnty , loc-str , temp-vert.n  ).
     4251                                end.
     4252           if pp-perem-qnty = true then do:
     4253                                    lh = lh + 1 .
     4254                                    if lh > 1 then loc-str = loc-str + 1 .
     4255                                    if hh = 1 then run macr_excel_char_with_format( "перемещение" , loc-str , 2  ) .
     4256                                    run macr_excel_dec( temp-prt.perem-qnty , loc-str , temp-vert.n  ).
     4257                                end.
     4258           if x-ost-2 = true then do:
     4259                                    lh = lh + 1 .
     4260                                    if lh > 1 then loc-str = loc-str + 1 .
     4261                                    if hh = 1 then run macr_excel_char_with_format( "кон.остаток" , loc-str , 2  ) .
     4262                                    run macr_excel_dec( temp-prt.ost-2 , loc-str , temp-vert.n  ).
     4263                                end.
     4264           if max-loc-str < loc-str then max-loc-str = loc-str.
     4265           assign
     4266               s-ost-1     =  s-ost-1       + temp-prt.ost-1
     4267               s-ost-2     =  s-ost-2       + temp-prt.ost-2
     4268               s-prih-qnty =  s-prih-qnty   + temp-prt.prih-qnty
     4269               s-voz-qnty  =  s-voz-qnty    + temp-prt.voz-qnty
     4270               s-rash-qnty =  s-rash-qnty   + temp-prt.rash-qnty
     4271               s-kassa-qnty =  s-kassa-qnty   + temp-prt.kassa-qnty
     4272               s-spis-qnty =  s-spis-qnty   + temp-prt.spis-qnty
     4273               s-inv-qnty  =  s-inv-qnty    + temp-prt.inv-qnty
     4274               s-perem-qnty=  s-perem-qnty  + temp-prt.perem-qnty
     4275           .
     4276         end.
     4277     end.
     4278      define variable f-col as decimal no-undo .
     4279      define variable f-row as decimal no-undo .
     4280      f-col = p-col + 1 .
     4281      f-row = num#str# - 1 .
     4282       if l-row = f-row then run macr_excel_char_with_format( " Итого" , f-row   , f-col  ) .
     4283       if x-ost-1 = true then do:
     4284                               f-row = f-row + 1.  run macr_excel_dec ( s-ost-1 , f-row , f-col  ).
     4285                             end.
     4286       if pp-prih-qnty = true then do:
     4287                               f-row = f-row + 1.  run macr_excel_dec( s-prih-qnty , f-row , f-col  ).
     4288                             end.
     4289       if pp-voz-qnty = true then do:
     4290                               f-row = f-row + 1.  run macr_excel_dec( s-voz-qnty , f-row , f-col  ).
     4291                             end.
     4292       if pp-rash-qnty = true then do:
     4293                               f-row = f-row + 1.  run macr_excel_dec( s-rash-qnty , f-row , f-col  ).
     4294                             end.
     4295       if pp-kassa-qnty = true then do:
     4296                               f-row = f-row + 1.  run macr_excel_dec( s-kassa-qnty , f-row , f-col  ).
     4297                             end.
     4298       if pp-inv-qnty = true then do:
     4299                               f-row = f-row + 1.  run macr_excel_dec( s-inv-qnty , f-row , f-col  ).
     4300                             end.
     4301       if pp-spis-qnty = true then do:
     4302                               f-row = f-row + 1.  run macr_excel_dec( s-spis-qnty , f-row , f-col  ).
     4303                             end.
     4304       if pp-perem-qnty = true then do:
     4305                               f-row = f-row + 1.  run macr_excel_dec( s-perem-qnty , f-row ,f-col  ).
     4306                             end.
     4307       if x-ost-2 = true then do:
     4308                               f-row = f-row + 1.  run macr_excel_dec( s-ost-2 , f-row , f-col  ).
     4309                             end.
     4310       nnn = nnn + 1  .
     4311       if (nnn modulo 2) = 0    then do:
     4312       run macr_cell_format
     4313             ( ?    ,
     4314               ?  ,
     4315               ?  ,
     4316               34    ,
     4317               num#str#,
     4318               2 ,
     4319               max-loc-str ,
     4320               p-col + 1 ) .
     4321       end.
     4322       num#str# =  max-loc-str .
     4323    end.
     4324   p-row    = num#str# .
     4325   if ll-i > 0  then do:
     4326      run bord-tt (l-row , l-col , p-row , p-col , 33 , true ) .
     4327      end.
     4328    end.
     4329   end procedure.
     4330   procedure print-goods :
     4331    do
     4332    on error undo, return error return-value
     4333    :
     4334    define input parameter p-row as integer no-undo .
     4335    define input parameter p-col as integer no-undo .
     4336     run macr_excel_char_with_format( temp-gds.artic
     4337         , p-row
     4338         , p-col ) .
     4339     run macr_excel_char_with_format( temp-gds.gds-name
     4340         , p-row
     4341         , p-col + 1 ) .
     4342      run macr_cell_format
     4343             ( 10       ,
     4344               true     ,
     4345               false    ,
     4346               ?        ,
     4347               p-row ,
     4348               p-col ,
     4349               p-row  ,
     4350               p-col + 1   ) .
     4351    end.
     4352   end procedure.
     4353   procedure bord-tt :
     4354    do
     4355    on error undo, return error return-value
     4356    :
     4357   define input parameter row-1 as integer no-undo .
     4358   define input parameter col-1 as integer no-undo .
     4359   define input parameter row-2 as integer no-undo .
     4360   define input parameter col-2 as integer no-undo .
     4361   define input parameter p-color as integer no-undo .
     4362   define input parameter p-sdvig as logical no-undo .
     4363   define variable var-col-1 as integer no-undo .
     4364   define variable var-col-2 as integer no-undo .
     4365   if p-sdvig then
     4366   assign
     4367     var-col-1  = col-1 + 2
     4368     var-col-2  = col-2 + 1
     4369    .
     4370    else
     4371    assign
     4372     var-col-1  = col-1
     4373     var-col-2  = col-2
     4374    .
     4375     put  stream macr_excel unformatted
     4376          substitute('select("r&1c&2:r&3c&4 ")' , row-1 + 1 , var-col-1 , row-2 , var-col-2  ) + chr(10)  +
     4377           'BORDER( 2 , 2 , 2 , 2 , 2 , ,0,0,0,0,0) '  + chr(10) +
     4378          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     4379          .
     4380      run macr_cell_format
     4381           ( ?    ,
     4382             ?  ,
     4383             ?  ,
     4384             p-color    ,
     4385             row-1 ,
     4386             2 ,
     4387             row-1 ,
     4388             var-col-2 ) .
     4389      run macr_cell_format
     4390           ( ?    ,
     4391             ?  ,
     4392             ?  ,
     4393             p-color   ,
     4394             row-1 + 1,
     4395             1 ,
     4396             row-2 ,
     4397             1 ) .
     4398      run macr_cell_size ( 12 , ? , row-1 , 1 , row-2, 1 ) .
     4399      run macr_cell_size ( 14 , ? , row-1 , 2 , row-2, 2 ) .
     4400    end.
     4401   end procedure.
     4402   procedure ob-line :
     4403    do
     4404    on error undo, return error return-value
     4405    :
     4406   define input parameter p-fact-order-1   as decimal no-undo .
     4407   define input parameter p-fact-order-2   as decimal no-undo .
     4408   define input parameter p-artic        as character no-undo .
     4409   define input parameter p-prod-type    as character no-undo .
     4410   define input parameter p-prod-code    as integer no-undo .
     4411   define input parameter p-obj-type    as character no-undo .
     4412   define input parameter p-obj-code    as integer no-undo .
     4413   define buffer buf_gds-dtl for ub.gds-dtl .
     4414   define buffer buf_trn-doc for ub.trn-doc .
     4415      for each buf_gds-dtl no-lock where
     4416          buf_gds-dtl.artic = p-artic and
     4417          buf_gds-dtl.prod-type = p-prod-type and
     4418          buf_gds-dtl.prod-code = p-prod-code and
     4419          buf_gds-dtl.obj-code  = p-obj-code and
     4420          buf_gds-dtl.obj-type  = p-obj-type ,
     4421               first buf_trn-doc no-lock where  buf_trn-doc.doc-code = buf_gds-dtl.doc-code and
     4422                                                buf_trn-doc.fact-order >= p-fact-order-1 and
     4423                                                buf_trn-doc.fact-order <= p-fact-order-2 and
     4424                                                buf_trn-doc.status_     = 'факт':U    and
     4425                  can-find( first tdedt where tdedt.id = buf_trn-doc.ext-doc-type) :
     4426      case buf_trn-doc.ext-doc-type :
     4427                     when  'ie':U    then do:
     4428                           run prt-matrix (
     4429                               buf_gds-dtl.prt-code
     4430                               , "prih-qnty"
     4431                               , buf_gds-dtl.fact-qnty
     4432                           ) .
     4433                     end.
     4434                     when 'ep':U  then do:
     4435                           run prt-matrix (
     4436                               buf_gds-dtl.prt-code
     4437                               , "voz-qnty"
     4438                               , buf_gds-dtl.fact-qnty * (-1)
     4439                           ) .
     4440                     end.
     4441                     when 'ee':U      then
     4442                           run prt-matrix (
     4443                               buf_gds-dtl.prt-code
     4444                               , "rash-qnty"
     4445                               , buf_gds-dtl.fact-qnty * (-1)
     4446                           ) .
     4447                     when 're':U  then
     4448                           run prt-matrix (
     4449                               buf_gds-dtl.prt-code
     4450                               , "rash-qnty"
     4451                               , buf_gds-dtl.fact-qnty
     4452                           ) .
     4453                     when 'rs':U then
     4454                           run prt-matrix (
     4455                               buf_gds-dtl.prt-code
     4456                               , "kassa-qnty"
     4457                               , buf_gds-dtl.fact-qnty
     4458                           ) .
     4459                     when 'es':U   then do:
     4460                           run prt-matrix (
     4461                               buf_gds-dtl.prt-code
     4462                               , "kassa-qnty"
     4463                               , buf_gds-dtl.fact-qnty * (-1)
     4464                           ) .
     4465                     end.
     4466                     when 'we':U        then do:
     4467                           run prt-matrix (
     4468                               buf_gds-dtl.prt-code
     4469                               , "spis-qnty"
     4470                               , buf_gds-dtl.fact-qnty * (-1)
     4471                           ) .
     4472                     end.
     4473                     when 'vt':U              or
     4474                     when 'vp':U        or
     4475                     when 'mp':U or
     4476                     when 'ap':U
     4477                     then do:
     4478                           run prt-matrix (
     4479                               buf_gds-dtl.prt-code
     4480                               , "inv-qnty"
     4481                               , buf_gds-dtl.doc-qnty
     4482                           ) .
     4483                     end.
     4484                     when 'iv':U        or
     4485                     when 'im':U         then do:
     4486                           run prt-matrix (
     4487                               buf_gds-dtl.prt-code
     4488                               , "perem-qnty"
     4489                               , buf_gds-dtl.fact-qnty
     4490                           ) .
     4491                     end.
     4492                     when 'ev':U        or
     4493                     when 'rv':U    or
     4494                     when 'em':U         or
     4495                     when 'wm':U         then do:
     4496                           run prt-matrix (
     4497                               buf_gds-dtl.prt-code
     4498                               , "perem-qnty"
     4499                               , buf_gds-dtl.fact-qnty * (-1)
     4500                           ) .
     4501                     end.
     4502                 end case.
     4503      end.
     4504    end.
     4505   end procedure.
     4506   procedure make-type-prt :
     4507    do
     4508    on error undo, return error return-value
     4509    :
     4510       for each temp-prt :
     4511       find first temp-type-prt  where
     4512             temp-type-prt.prt-root    =   temp-prt.prt-root and
     4513             temp-type-prt.type-2      =   temp-prt.type-2  no-error .
     4514             if not available temp-type-prt then   create temp-type-prt.
     4515           assign
     4516             temp-type-prt.ost-1-qnty  =   temp-type-prt.ost-1-qnty +  temp-prt.ost-1-qnty
     4517             temp-type-prt.ost-2-qnty  =   temp-type-prt.ost-2-qnty +  temp-prt.ost-2-qnty
     4518             temp-type-prt.prih-qnty   =   temp-type-prt.prih-qnty  +  temp-prt.prih-qnty
     4519             temp-type-prt.voz-qnty    =   temp-type-prt.voz-qnty   +  temp-prt.voz-qnty
     4520             temp-type-prt.rash-qnty   =   temp-type-prt.rash-qnty  +  temp-prt.rash-qnty
     4521             temp-type-prt.kassa-qnty   =   temp-type-prt.kassa-qnty  +  temp-prt.kassa-qnty
     4522             temp-type-prt.spis-qnty   =   temp-type-prt.spis-qnty  +  temp-prt.spis-qnty
     4523             temp-type-prt.inv-qnty    =   temp-type-prt.inv-qnty   +  temp-prt.inv-qnty
     4524             temp-type-prt.perem-qnty  =   temp-type-prt.perem-qnty +  temp-prt.perem-qnty
     4525             temp-type-prt.prt-root    =   temp-prt.prt-root
     4526             temp-type-prt.type-2      =   temp-prt.type-2
     4527           .
     4528       find first temp-type-prt  where
     4529             temp-type-prt.prt-root    =   temp-prt.prt-root and
     4530             temp-type-prt.type-2      =   "_Итого"  no-error .
     4531             if not available temp-type-prt then   create temp-type-prt.
     4532           assign
     4533             temp-type-prt.ost-1-qnty  =   temp-type-prt.ost-1-qnty +  temp-prt.ost-1-qnty
     4534             temp-type-prt.ost-2-qnty  =   temp-type-prt.ost-2-qnty +  temp-prt.ost-2-qnty
     4535             temp-type-prt.prih-qnty   =   temp-type-prt.prih-qnty  +  temp-prt.prih-qnty
     4536             temp-type-prt.voz-qnty    =   temp-type-prt.voz-qnty   +  temp-prt.voz-qnty
     4537             temp-type-prt.rash-qnty   =   temp-type-prt.rash-qnty  +  temp-prt.rash-qnty
     4538             temp-type-prt.kassa-qnty   =   temp-type-prt.kassa-qnty  +  temp-prt.kassa-qnty
     4539             temp-type-prt.spis-qnty   =   temp-type-prt.spis-qnty  +  temp-prt.spis-qnty
     4540             temp-type-prt.inv-qnty    =   temp-type-prt.inv-qnty   +  temp-prt.inv-qnty
     4541             temp-type-prt.perem-qnty  =   temp-type-prt.perem-qnty +  temp-prt.perem-qnty
     4542             temp-type-prt.prt-root    =   temp-prt.prt-root
     4543             temp-type-prt.type-2      =   "_Итого"
     4544           .
     4545       end.
     4546    end.
     4547   end procedure.
     4548   procedure print-type-prt :
     4549    do
     4550    on error undo, return error return-value
     4551    :
     4552   define variable start-row as integer no-undo .
     4553   define variable f-row as integer no-undo .
     4554   define variable f-col as integer no-undo .
     4555   define buffer buf_gds-prt for ub.gds-prt.
     4556    f-col = 1.
     4557       for each temp-type-prt break by  temp-type-prt.prt-root  by temp-type-prt.type-2 :
     4558       if last-str then run print-footer (last-name ) .
     4559       if first-of (temp-type-prt.prt-root) then do:
     4560           find first buf_gds-prt no-lock  where  buf_gds-prt.prt-root =  integer(temp-type-prt.prt-root) no-error  .
     4561           num#str# = num#str# + 1 .
     4562           run macr_excel_char_with_format( "Шкала"              , num#str#    , 1 ) .
     4563           run macr_excel_char_with_format( buf_gds-prt.node-name   , num#str#    , 2 ) .
     4564           run macr_cell_format ( 12       ,
     4565               true     ,
     4566               false    ,
     4567               ?        ,
     4568               num#str# ,
     4569               1 ,
     4570               num#str#  ,
     4571               2   ) .
     4572           start-row = num#str# + 1 .
     4573           end.
     4574             f-col = f-col + 1.
     4575             f-row = start-row.
     4576             run macr_excel_char_with_format( temp-type-prt.type-2    , f-row    , f-col ) .
     4577             if x-ost-1 = true then do:
     4578                                     f-row = f-row + 1.  run macr_excel_dec ( temp-type-prt.ost-1-qnty , f-row , f-col  ).
     4579                                     if f-col = 2 then run macr_excel_char_with_format( "нач.остаток" ,  f-row , 1  ) .
     4580                                   end.
     4581             if pp-prih-qnty = true then do:
     4582                                     f-row = f-row + 1.  run macr_excel_dec( temp-type-prt.prih-qnty , f-row , f-col  ).
     4583                                     if f-col = 2 then run macr_excel_char_with_format( "приход" ,  f-row , 1  ) .
     4584                                   end.
     4585             if pp-voz-qnty = true then do:
     4586                                     f-row = f-row + 1.  run macr_excel_dec( temp-type-prt.voz-qnty , f-row , f-col  ).
     4587                                     if f-col = 2 then run macr_excel_char_with_format( "возврат пост." ,  f-row , 1  ) .
     4588                                   end.
     4589             if pp-rash-qnty = true then do:
     4590                                     f-row = f-row + 1.  run macr_excel_dec( temp-type-prt.rash-qnty , f-row , f-col  ).
     4591                                     if f-col = 2 then run macr_excel_char_with_format( "расход внеш" ,  f-row , 1  ) .
     4592                                   end.
     4593             if pp-kassa-qnty = true then do:
     4594                                     f-row = f-row + 1.  run macr_excel_dec( temp-type-prt.kassa-qnty , f-row , f-col  ).
     4595                                     if f-col = 2 then run macr_excel_char_with_format( "касса" ,  f-row , 1  ) .
     4596                                   end.
     4597             if pp-inv-qnty = true then do:
     4598                                     f-row = f-row + 1.  run macr_excel_dec( temp-type-prt.inv-qnty , f-row , f-col  ).
     4599                                     if f-col = 2 then run macr_excel_char_with_format( "инвентар." ,  f-row , 1  ) .
     4600                                   end.
     4601             if pp-spis-qnty = true then do:
     4602                                     f-row = f-row + 1.  run macr_excel_dec( temp-type-prt.spis-qnty , f-row , f-col  ).
     4603                                     if f-col = 2 then run macr_excel_char_with_format( "списание" ,  f-row , 1  ) .
     4604                                   end.
     4605             if pp-perem-qnty = true then do:
     4606                                     f-row = f-row + 1.  run macr_excel_dec( temp-type-prt.perem-qnty , f-row ,f-col  ).
     4607                                     if f-col = 2 then run macr_excel_char_with_format( "перемещ" ,  f-row , 1  ) .
     4608                                   end.
     4609             if x-ost-2 = true then do:
     4610                                     f-row = f-row + 1.  run macr_excel_dec( temp-type-prt.ost-2-qnty , f-row , f-col  ).
     4611                                     if f-col = 2 then run macr_excel_char_with_format( "кон.остаток" ,  f-row , 1  ) .
     4612                                   end.
     4613           if last-of (temp-type-prt.prt-root) then do:
     4614              run bord-tt (start-row  , 1 , f-row , f-col , 39 , false  ) .
     4615              num#str# = f-row .
     4616              f-col = 1.
     4617           end.
     4618       end.
     4619       for each temp-type-prt : delete temp-type-prt . end.
     4620    end.
     4621   end procedure.
     4622   procedure foreach2 :
     4623    do
     4624    on error undo, return error return-value
     4625    :
     4626   define variable  p-obj-type           like ub.gds-obj.obj-type  no-undo .
     4627   define variable  p-obj-code           like ub.gds-obj.obj-code  no-undo .
     4628   define variable  p-artic              like ub.gds-obj.artic     no-undo .
     4629   define variable  p-prod-type          like ub.gds-obj.prod-type no-undo .
     4630   define variable  p-prod-code          like ub.gds-obj.prod-code no-undo .
     4631   define variable  p-fact-order         as decimal   no-undo .
     4632   define variable  p-include-fact-order as logical   no-undo .
     4633   define variable l-pusto as logical no-undo .
     4634     run make-gds-list.
     4635     for each temp-gds  break by  temp-gds.cli-name :
     4636               v-prt-level = temp-gds.prt-lvl .
     4637               run zap
     4638                  (input-output p-obj-type
     4639                 ,input-output p-obj-code
     4640                 ,input-output p-artic
     4641                 ,input-output p-prod-type
     4642                 ,input-output p-prod-code
     4643                 ,input-output  p-fact-order
     4644                 ,input-output p-include-fact-order )        .
     4645               run scan-tt (output l-pusto ).
     4646                   if itog = false then do:
     4647                       if first-of( temp-gds.cli-name ) then do:
     4648                           assign
     4649                               first-str = true
     4650                               first-name = temp-gds.cli-name
     4651                           .
     4652                       end.
     4653                       run print-tt.
     4654                   end.
     4655                   run make-type-prt.
     4656                   if last-of( temp-gds.cli-name ) then do:
     4657                       assign
     4658                           last-str = true
     4659                           last-name = "Итоги по производителю " + temp-gds.cli-name
     4660                       .
     4661                       run print-type-prt.
     4662                   end.
     4663     end.
     4664    end.
     4665   end procedure.
     4666   procedure foreach3 :
     4667    do
     4668    on error undo, return error return-value
     4669    :
     4670   define variable  p-obj-type           like ub.gds-obj.obj-type  no-undo .
     4671   define variable  p-obj-code           like ub.gds-obj.obj-code  no-undo .
     4672   define variable  p-artic              like ub.gds-obj.artic     no-undo .
     4673   define variable  p-prod-type          like ub.gds-obj.prod-type no-undo .
     4674   define variable  p-prod-code          like ub.gds-obj.prod-code no-undo .
     4675   define variable  p-fact-order         as decimal   no-undo .
     4676   define variable  p-include-fact-order as logical   no-undo .
     4677   define variable l-pusto as logical no-undo .
     4678     run make-gds-list.
     4679     for each temp-gds  break by  temp-gds.grp-name :
     4680         v-prt-level = temp-gds.prt-lvl .
     4681               run zap
     4682                 ( input-output p-obj-type
     4683                 ,input-output p-obj-code
     4684                 ,input-output p-artic
     4685                 ,input-output p-prod-type
     4686                 ,input-output p-prod-code
     4687                 ,input-output  p-fact-order
     4688                 ,input-output p-include-fact-order )        .
     4689               run scan-tt (output l-pusto ).
     4690                   if itog = false then do:
     4691                       if first-of( temp-gds.grp-name ) then do:
     4692                           assign
     4693                               first-str = true
     4694                               first-name = temp-gds.grp-name
     4695                           .
     4696                       end.
     4697                       run print-tt.
     4698                   end.
     4699                   run make-type-prt.
     4700                   if last-of( temp-gds.grp-name ) then do:
     4701                       assign
     4702                           last-str = true
     4703                           last-name = "Итоги по группе " +  temp-gds.grp-name
     4704                       .
     4705                       run print-type-prt.
     4706                   end.
     4707     end.
     4708    end.
     4709   end procedure.
     4710   procedure zap :
     4711    do
     4712    on error undo, return error return-value
     4713    :
     4714   define input-output parameter   p-obj-type           like ub.gds-obj.obj-type  no-undo .
     4715   define input-output parameter   p-obj-code           like ub.gds-obj.obj-code  no-undo .
     4716   define input-output parameter   p-artic              like ub.gds-obj.artic     no-undo .
     4717   define input-output parameter   p-prod-type          like ub.gds-obj.prod-type no-undo .
     4718   define input-output parameter   p-prod-code          like ub.gds-obj.prod-code no-undo .
     4719   define input-output parameter   p-fact-order         as decimal   no-undo .
     4720   define input-output parameter   p-include-fact-order as logical   no-undo .
     4721    run clear-matrix .
     4722         for each obj-list :
     4723             assign
     4724               p-obj-type                = obj-list.obj-type
     4725               p-obj-code                = obj-list.obj-code
     4726               p-artic                   = temp-gds.artic
     4727               p-prod-type               = temp-gds.prod-type
     4728               p-prod-code               = temp-gds.prod-code
     4729               p-include-fact-order      = false
     4730             .
     4731             if x-ost-1 = true then do:
     4732                 run prdoclib-clear-temp-prt-obj .
     4733                 run prdoclib-init-prt-obj-by-factord
     4734                   (input  p-obj-type
     4735                   ,input  p-obj-code
     4736                   ,input  p-artic
     4737                   ,input  p-prod-type
     4738                   ,input  p-prod-code
     4739                   ,input  fact-order-1
     4740                   ,input  p-include-fact-order ) .
     4741                   for each temp-prt-obj :
     4742                   run prt-matrix (
     4743                       temp-prt-obj.prt-code
     4744                       , "ost-1"
     4745                       , temp-prt-obj.fact-qnty
     4746                   ) .
     4747                   end.
     4748             end.
     4749             if x-ost-2 = true then do:
     4750                 run prdoclib-clear-temp-prt-obj .
     4751                 run prdoclib-init-prt-obj-by-factord
     4752                   (input  p-obj-type
     4753                   ,input  p-obj-code
     4754                   ,input  p-artic
     4755                   ,input  p-prod-type
     4756                   ,input  p-prod-code
     4757                   ,input  fact-order-2
     4758                   ,input  p-include-fact-order ) .
     4759                   for each temp-prt-obj :
     4760                   run prt-matrix (
     4761                       temp-prt-obj.prt-code
     4762                       , "ost-2"
     4763                       , temp-prt-obj.fact-qnty
     4764                   ) .
     4765                   end.
     4766             end.
     4767             run ob-line(  input   fact-order-1
     4768                         , input   fact-order-2
     4769                         , input   p-artic
     4770                         , input   p-prod-type
     4771                         , input   p-prod-code
     4772                         , input   p-obj-type
     4773                         , input   p-obj-code    ).
     4774         end.
     4775    end.
     4776   end procedure.
