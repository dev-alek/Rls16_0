      751   procedure proc-alt-shift-f2:
      752     if not ibs.th.gbl.gbl-var:rcode
      753   then
      754     run gbl\inidebug.p .
      755   end.
      756   procedure proc-alt-shift-f3:
      757     run gbl/prvssinf.p
      758       ( input this-procedure
      759       ) .
      760   end.
      761   define variable v-inform-launched as logical no-undo initial false .
      762   procedure proc-alt-shift-f4:
      763     define variable v-action as character no-undo .
      764     if v-inform-launched = false then do:
      765       assign
      766         v-inform-launched = true
      767       .
      768       run gbl/d-inform.w
      769         (  input self
      770         ,  input this-procedure
      771         , output v-action
      772         ) no-error .
      773       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      774       assign
      775         v-inform-launched = false
      776       .
      777     end.
      778   end.
      779   procedure proc-alt-f1:
      780     run gbl/corrhelp.p
      781       (input this-procedure
      782       ) .
      783   end .
      784   on alt-shift-f2 anywhere do:
      785     run proc-alt-shift-f2.
      786   end.
      787   on alt-shift-f3 anywhere do:
      788     run proc-alt-shift-f3 in this-procedure .
      789   end.
      790   on alt-shift-f4 anywhere do:
      791     run proc-alt-shift-f4 in this-procedure.
      792   end.
      793   on alt-f1 anywhere do:
      794     run proc-alt-f1 in this-procedure .
      795   end.
