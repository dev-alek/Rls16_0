     1174   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1175   procedure wthcattr-sprcli :
     1176   define input parameter parparentproc  as widget-handle no-undo.
     1177   define input parameter p-mode  as character no-undo.
     1178   define input-output parameter p-value as character no-undo .
     1179   define output parameter p-setted as logical no-undo .
     1180     DEFINE VARIABLE v-value as character no-undo .
     1181     define variable v-cli-type as character no-undo .
     1182     define variable v-cli-code as integer no-undo .
     1183     define buffer buf_clients   for ub.clients.
     1184     define variable v_rid as character no-undo.
     1185     define variable ref-rec as recid no-undo .
     1186     do
     1187     on error undo, return error
     1188     :
     1189         v-value = p-value.
     1190      if p-value <> '':U then do:
     1191       assign
     1192       v-cli-type = substring(p-value, 1, 3)
     1193       v-cli-code = integer(substring(p-value, 4))
     1194       no-error.
     1195       if error-status:error then do:
     1196         assign
     1197         v-cli-type = '':U
     1198         v-cli-code = 0
     1199         .
     1200       end.
     1201      end.
     1202      FIND FIRST buf_clients NO-LOCK WHERE
     1203               buf_clients.obj-type = v-cli-type AND
     1204               buf_clients.obj-code = v-cli-code  NO-ERROR.
     1205      IF available(buf_clients) then do:
     1206       run ref/cli-all.w (
     1207                   input parparentproc
     1208                  ,input if p-mode = 'ИЗМЕНЕНИЕ':U then "b-sel":U else "":U
     1209                  ,input v-cli-type
     1210                  ,input 'все':U
     1211                  ,input 'все':U
     1212                  ,input RECID( buf_clients )
     1213                  ,input ",,,,,,NO"
     1214                  ,input ?
     1215                  ,OUTPUT v_rid ).
     1216     END.
     1217     ELSE if p-mode = 'ИЗМЕНЕНИЕ':U then DO:
     1218       run ref/cli-all.w (
     1219                    input parparentproc
     1220                   ,INPUT "b-sel":U
     1221                  ,input  v-cli-type
     1222                  ,input 'все':U
     1223                  ,input 'текущие':U
     1224                  ,input ?
     1225                  ,input ",,,,,,NO"
     1226                  ,input ?
     1227                  ,OUTPUT v_rid ).
     1228     END.
     1229     else do:
     1230       message
     1231       if p-value = "":U then 'Атрибут не задан!'
     1232       else substitute('Не найден клиент &1',p-value)
     1233       view-as alert-box warning.
     1234     end.
     1235     IF v_rid <> ? AND v_rid <> "":U THEN DO:
     1236       ASSIGN ref-rec = INT( v_rid ) NO-ERROR.
     1237       IF ERROR-STATUS:ERROR THEN DO:
     1238           RETURN NO-APPLY.
     1239       END.
     1240       FIND FIRST buf_clients NO-LOCK WHERE
     1241                  RECID( buf_clients ) = ref-rec NO-ERROR.
     1242       IF AVAIL buf_clients THEN DO:
     1243         v-value = buf_clients.obj-type + string(buf_clients.obj-code, ">>>>>>>>9").
     1244       end.
     1245     end.
     1246     if v-value <> p-value then do:
     1247       p-value = v-value.
     1248       p-setted = yes.
     1249     end.
     1250     end.
     1251   end procedure.
     1252     define new global shared variable g#wthcalib as handle no-undo.
     1253   procedure torgconf-read :
     1254   do
     1255   on error undo, return error
     1256   :
     1257       define input parameter p-form-name  as character    no-undo.
     1258       define input parameter p-host-code  as integer      no-undo.
     1259       define input parameter p-obj-type   as character    no-undo.
     1260       define input parameter p-obj-code   as integer      no-undo.
     1261       define variable v-outdate   as character     no-undo.
     1262       define variable v-outares   as character     no-undo.
     1263       define variable v-outsend   as character     no-undo.
     1264       define variable v-outasend  as character     no-undo.
     1265       define variable v-outprops  as character     no-undo.
     1266       define variable v-outnum    as character     no-undo.
     1267       define variable v-outprim   as character     no-undo.
     1268       define variable v-outdisc   as character     no-undo.
     1269       define variable v-outsubs   as character     no-undo.
     1270       define variable v-outrecv   as character     no-undo.
     1271       define variable v-outegrp   as character     no-undo.
     1272       define variable v-outt12    as character     no-undo.
     1273       define variable v-outappr   as character     no-undo.
     1274       define variable v-outrubl   as character     no-undo.
     1275       define variable v-outhold   as character     no-undo.
     1276       define variable v-outobj    as character     no-undo.
     1277       define variable v-outexlst  as character     no-undo.
     1278       define variable v-outprncd  as character     no-undo.
     1279       define variable v-par-type  as character     no-undo.
     1280       define variable v-outogr    as character     no-undo.
     1281       define variable v-outR      as character     no-undo.
     1282       define variable v-outB      as character     no-undo.
     1283       define variable v-outC      as character     no-undo.
     1284       assign
     1285           v-torgconf-outdate  = no
     1286           v-torgconf-outnum   = no
     1287           v-torgconf-outprim  = no
     1288           v-torgconf-outdisc  = no
     1289           v-torgconf-outsubs  = no
     1290           v-torgconf-outrecv  = no
     1291           v-torgconf-outegrp  = no
     1292           v-torgconf-outt12   = no
     1293           v-torgconf-outappr  = no
     1294           v-torgconf-outrubl  = no
     1295           v-torgconf-outhold  = no
     1296           v-torgconf-outobj   = no
     1297           v-torgconf-outexlst = no
     1298           v-torgconf-outexpas = "":U
     1299           v-torgconf-outprncd = yes
     1300           v-torgconf-outares  = no
     1301           v-torgconf-outsend  = no
     1302           v-torgconf-outasend  = no
     1303           v-torgconf-outprops  = no
     1304           v-form-name          = p-form-name
     1305       .
     1306   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1307   empty temp-table thbjattr_thbj-attr.
     1308   run adm/shattri.p (
     1309      input "get":U
     1310     ,input ''
     1311     ,input 0
     1312     ,input 'prt-glob':U
     1313     ,input  ""
     1314     ,output v-value-character
     1315     ,output v-value-date
     1316     ,output v-value-decimal
     1317     ,output v-value-integer
     1318     ,output v-value-logical
     1319     ,output par-type
     1320     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1321     ) no-error .
     1322   for each thbjattr_thbj-attr :
     1323       if thbjattr_thbj-attr.prop-code = 'outprncd':U then v-outprncd =  string(thbjattr_thbj-attr.property-value-logical) .
     1324       if thbjattr_thbj-attr.prop-code = 'outrecv':U  then v-outrecv  =  thbjattr_thbj-attr.property-value-character .
     1325       if thbjattr_thbj-attr.prop-code = 'outprops':U then v-outprops =  thbjattr_thbj-attr.property-value-character .
     1326   end.
     1327   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1328   empty temp-table thbjattr_thbj-attr.
     1329   run adm/shattri.p (
     1330      input "get":U
     1331     ,input p-obj-type
     1332     ,input p-obj-code
     1333     ,input 'prt-obj':U
     1334     ,input  ""
     1335     ,output v-value-character
     1336     ,output v-value-date
     1337     ,output v-value-decimal
     1338     ,output v-value-integer
     1339     ,output v-value-logical
     1340     ,output par-type
     1341     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1342     ) no-error .
     1343   for each thbjattr_thbj-attr :
     1344       if thbjattr_thbj-attr.prop-code = 'outdate':U  then v-outdate  =  thbjattr_thbj-attr.property-value-character .
     1345       if thbjattr_thbj-attr.prop-code = 'outares':U  then v-outares  =  thbjattr_thbj-attr.property-value-character .
     1346       if thbjattr_thbj-attr.prop-code = 'outnum':U   then v-outnum   =  thbjattr_thbj-attr.property-value-character .
     1347       if thbjattr_thbj-attr.prop-code = 'outprim':U  then v-outprim  =  thbjattr_thbj-attr.property-value-character .
     1348       if thbjattr_thbj-attr.prop-code = 'outdisc':U  then v-outdisc  =  thbjattr_thbj-attr.property-value-character .
     1349       if thbjattr_thbj-attr.prop-code = 'outsubs':U  then v-outsubs  =  thbjattr_thbj-attr.property-value-character .
     1350       if thbjattr_thbj-attr.prop-code = 'outegrp':U  then v-outegrp  =  thbjattr_thbj-attr.property-value-character .
     1351       if thbjattr_thbj-attr.prop-code = 'outt12':U   then v-outt12   =  thbjattr_thbj-attr.property-value-character .
     1352       if thbjattr_thbj-attr.prop-code = 'outappr':U  then v-outappr  =  thbjattr_thbj-attr.property-value-character .
     1353       if thbjattr_thbj-attr.prop-code = 'outrubl':U  then v-outrubl  =  thbjattr_thbj-attr.property-value-character .
     1354       if thbjattr_thbj-attr.prop-code = 'outhold':U  then v-outhold  =  thbjattr_thbj-attr.property-value-character .
     1355       if thbjattr_thbj-attr.prop-code = 'outobj':U   then v-outobj   =  thbjattr_thbj-attr.property-value-character .
     1356       if thbjattr_thbj-attr.prop-code = 'outsend':U  then v-outsend  =  thbjattr_thbj-attr.property-value-character .
     1357       if thbjattr_thbj-attr.prop-code = 'outasend':U then v-outasend =  thbjattr_thbj-attr.property-value-character .
