     3915   procedure torgconf-get-reason  :
     3916   define input parameter  p-doc-code       as character        no-undo.
     3917   define input parameter  p-reason-code    as integer          no-undo .
     3918   define input parameter  p-doc-type       as character        no-undo.
     3919       if p-reason-code > 0
     3920       then do:
     3921           define buffer buf_trn-reason for ub.trn-reason.
     3922           find first buf_trn-reason no-lock where buf_trn-reason.reason-code = p-reason-code no-error .
     3923           if available buf_trn-reason then assign v-torgconf-reason =  buf_trn-reason.reason-name .
     3924       end.
     3925       else do:
     3926           if p-doc-type = 'при':U
     3927           then  do:
     3928               define variable v-attr-type     as character    no-undo.
     3929               define variable v-attr-value    as character    no-undo.
     3930               run gbl/trdcat-v.p (input p-doc-code,input 'nids':U,output v-attr-value,output v-attr-type) .
     3931               assign v-torgconf-reason = v-attr-value .
     3932               run gbl/trdcat-v.p (input p-doc-code,input 'dids':U,output v-attr-value,output v-attr-type) .
     3933               assign v-torgconf-reason = v-torgconf-reason + " от " + v-attr-value .
     3934           end.
     3935       end.
     3936   end procedure.
     3937   def var vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3938   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     3939   procedure paramls-clear :
     3940     define buffer buf_temp-param for temp-param .
     3941     do
     3942     on error undo, return error return-value
     3943     :
     3944       for each buf_temp-param
     3945       on error undo, return error
     3946       :
     3947         delete buf_temp-param .
     3948       end.
     3949     end.
     3950   end procedure.
     3951   procedure paramls-write :
     3952     define input  parameter p-code     as character no-undo .
     3953     define input  parameter p-sub-code as character no-undo .
     3954     define input  parameter p-value    as character no-undo .
     3955     define buffer buf_temp-param for temp-param .
     3956     do
     3957     on error undo, return error return-value
     3958     :
     3959       find first buf_temp-param
     3960         where buf_temp-param.param-code     = p-code
     3961           and buf_temp-param.param-sub-code = p-sub-code
     3962         no-error .
     3963       if not available buf_temp-param then do:
     3964         create buf_temp-param .
     3965         assign
     3966           buf_temp-param.param-code     = p-code
     3967           buf_temp-param.param-sub-code = p-sub-code
     3968         .
     3969       end.
     3970       assign
     3971         buf_temp-param.param-value = p-value
     3972       .
     3973     end.
     3974   end procedure.
     3975   procedure paramls-read :
     3976     define input  parameter p-code          as character no-undo .
     3977     define input  parameter p-sub-code      as character no-undo .
     3978     define input  parameter p-default-value as character no-undo .
     3979     define output parameter p-value         as character no-undo .
     3980     define buffer buf_temp-param for temp-param .
     3981     do
     3982     on error undo, return error return-value
     3983     :
     3984       find first buf_temp-param
     3985         where buf_temp-param.param-code     = p-code
     3986           and buf_temp-param.param-sub-code = p-sub-code
     3987         no-error .
     3988       if available buf_temp-param then do:
     3989         assign
     3990           p-value = buf_temp-param.param-value
     3991         .
     3992       end.
     3993       else do:
     3994         assign
     3995           p-value = p-default-value
     3996         .
     3997       end.
     3998     end.
     3999   end procedure.
     4000   procedure paramls-append :
     4001     define input  parameter p-code     as character no-undo .
     4002     define input  parameter p-sub-code as character no-undo .
     4003     define input  parameter p-value    as character no-undo .
     4004     define buffer buf_temp-param for temp-param .
     4005     do
     4006     on error undo, return error return-value
     4007     :
     4008       find first buf_temp-param
     4009            where buf_temp-param.param-code     = p-code
     4010              and buf_temp-param.param-sub-code = p-sub-code
     4011         no-error .
     4012       if not available buf_temp-param then do:
     4013         create buf_temp-param .
     4014         assign
     4015           buf_temp-param.param-code     = p-code
     4016           buf_temp-param.param-sub-code = p-sub-code
     4017           buf_temp-param.param-value    = p-value
     4018         .
     4019       end.
     4020       else do:
     4021           assign
     4022               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     4023           .
     4024       end.
     4025     end.
     4026   end procedure.
     4027   do
     4028   on error undo, return error
     4029   :
     4030   define buffer t-doc             for trn-doc.
     4031   define buffer buf_gds-dtl      for gds-dtl.
     4032   define buffer buf_goods         for goods.
     4033   define buffer buf_clients       for clients .
     4034   define buffer buf_firm          for firm.
     4035   define buffer buf_sysconf       for sysconf.
     4036   define buffer buf_currency      for currency .
     4037   define stream out-stream .
     4038     define variable g#report-num as integer   no-undo .
     4039     run get-report-num  in parParentProc ( output g#report-num ).
     4040     define variable g#quest-print as logical   no-undo .
     4041     run get-quest-print in parParentProc ( output g#quest-print ).
     4042     define variable g#log as logical   no-undo .
     4043   define shared var sort-name    as logical                          no-undo.
     4044   define shared var sort-gr      as logical                          no-undo.
     4045   define variable v-par-type                  as character                no-undo.
     4046   define variable v-curr-code                 as integer                  no-undo.
     4047   define variable all-qnty as decimal   no-undo .
     4048   define variable all-sum as decimal   no-undo .
     4049   define variable v-propis       as char              no-undo.
     4050   define variable v-propis-cop       as char              no-undo.
     4051   define variable v-itog as decimal no-undo .
     4052   define variable v-num as integer   no-undo .
     4053   define variable v-single-line       as char              no-undo.
     4054   define variable v-underline         as char              no-undo.
     4055   assign
     4056     v-single-line = fill("-", 230)
     4057     v-underline = fill("_", 230)
     4058   .
     4059     find first t-doc no-lock where recid( t-doc ) = rec_id .
     4060     find first buf_currency no-lock where buf_currency.curr-code = t-doc.exch-code no-error .
     4061     if not available buf_currency then do:
     4062       undo, return error substitute("Не найдена валюта &1", t-doc.exch-code) .
     4063     end.
     4064     define variable str-curr as character no-undo .
     4065     assign str-curr = string(buf_currency.curr-abbr,"x(8)") .
     4066     define variable v-sort-prod             as character            no-undo.
     4067   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4068   empty temp-table thbjattr_thbj-attr.
     4069   run adm/shattri.p (
     4070      input "get":U
     4071     ,input ''
     4072     ,input 0
     4073     ,input 'prt-glob':U
     4074     ,input  ""
     4075     ,output v-value-character
     4076     ,output v-value-date
     4077     ,output v-value-decimal
     4078     ,output v-value-integer
     4079     ,output v-value-logical
     4080     ,output par-type
     4081     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     4082     ) no-error .
     4083     for each thbjattr_thbj-attr :
     4084         if thbjattr_thbj-attr.prop-code = 'sort-prd' then v-sort-prod = string( thbjattr_thbj-attr.property-value-logical) .
     4085     end.
     4086     run torgconf-read in this-procedure ( input "torg2", input t-doc.host-code, input t-doc.obj-type, input t-doc.obj-code) no-error.
     4087     if error-status :error then do:
     4088       message
     4089         vss-workfile vss-revision vss-description    skip "Ошибка чтения параметров печати формы."
     4090         skip "Форма будет напечатана с параметрами по умолчанию."    skip return-value
     4091         skip trim(error-status :get-message(1))    trim(error-status :get-message(2))    trim(error-status :get-message(3))
     4092       view-as alert-box error.
     4093     end.
     4094     run torgconf-get-self-param in this-procedure ( input t-doc.obj-type, input t-doc.obj-code, input v-curr-code) no-error.
     4095     if error-status :error then do:
     4096       message
     4097         vss-workfile vss-revision vss-description    skip "Ошибка чтения параметров объекта документа."
     4098         skip return-value    skip trim(error-status :get-message(1))
     4099         trim(error-status :get-message(2))     trim(error-status :get-message(3))
     4100       view-as alert-box warning.
     4101     end.
     4102     run torgconf-get-cli-param in this-procedure ( input t-doc.host-code, input t-doc.cli-type, input t-doc.cli-code, input v-curr-code) no-error.
     4103     if error-status :error then do:
     4104       message
     4105         vss-workfile vss-revision vss-description    skip "Ошибка чтения параметров объекта клиента документа."
     4106         skip return-value    skip trim(error-status :get-message(1))    trim(error-status :get-message(2))  trim(error-status :get-message(3))
     4107       view-as alert-box warning.
     4108     end.
     4109     run torgconf-get-form-header in this-procedure (
     4110             input no
     4111           , input t-doc.doc-code
     4112           , input "no"
     4113           , input t-doc.doc-date
     4114           , input t-doc.fact-date
     4115           , input t-doc.doc-type
     4116           , input t-doc.status_
     4117           , input no
     4118           , input no
     4119       ).
     4120     if v-torgconf-outappr = yes  then do:
     4121       put stream out-stream  "Утверждена постановлением Госкомстата России от 25.12.98 N 132" at 87 .
     4122     end.
     4123   if session :set-wait-state( "compiler" ) then.
     4124   output stream out-stream to value( string( session:temp-directory +
     4125                                        "rpt" + string( g#report-num ) ) )
     4126                                        page-size 62 .
     4127     define variable v-operation-type    as character    no-undo.
     4128     assign  v-operation-type = " " .
     4129     put stream out-stream
     4130           space(5) v-single-line          format  "X(19)"     at 110 skip
     4131           space(5) "| "  at 110    'код':U  at 118   "|"  at 128 skip
     4132           space(5) "Форма по ОКУД"   format "X(14)"  at 95 "| " at 110  "0330202"  "|"   at 128 skip
     4133           string(v-torgconf-self-host-name  + ", " + v-torgconf-self-host-post-addres)    format "X(96)" "по ОКПО" format "X(7)" at 102  "| " at 110  v-torgconf-okpo  format "X(16)" "|" at 128 skip
     4134           string( caps( v-torgconf-self-obj-name)  + " (" + string(v-torgconf-self-obj-code) + ")") format "X(104)" "| "  at 110  "|"  at 128 skip
     4135           space(5) "Вид деятельности по ОКДП" format "X(25)"  at 84   "| "  at 110  "|"  at 128 skip
     4136           space(5) string( "Основание для составления акта ______________приказ, распоряжение________ " ) format "X(75)"
     4137                           "номер" format "X(5)" at 104 "| " at 110 v-torgconf-doc-code format "X(16)" "|" at 128 skip
     4138           space(5) "дата" format "X(4)" at 105 "| " at 110 v-torgconf-doc-date format "X(10)" "|" at 128 skip
     4139           space(5) "Вид операции"   format "X(12)"    at 97  "| "  at 110  v-operation-type format "X(16)"  "|" at 128 skip
     4140           space(5) v-single-line format  "X(19)" at 110 skip
     4141       .
     4142     put stream out-stream
     4143             "УТВЕРЖДАЮ Руководитель" format "X(23)" at 105 skip
     4144           space(50) v-single-line format "X(33)"  space(10)  v-underline format "X(33)" skip
     4145           space(44) string( "А К Т | " + string( v-torgconf-doc-code, "X(16)") + "| "
     4146                                        + string( v-torgconf-doc-date, "X(12)")
     4147                                        + "| " + (if t-doc.status_ <> 'факт':U then string( "(" + CAPS(t-doc.status_) + ")" ) else "")
     4148                                       ) format "X(50)"  skip
     4149           space(50) v-single-line format "X(33)"  space(10)  v-underline format "X(15)" space(3)  v-underline format "X(15)"  skip
     4150           space(35) "ОБ УСТАНОВЛЕННОМ РАСХОЖДЕНИИ ПО КОЛИЧЕСТВУ"   skip
     4151           space(25) "И КАЧЕСТВУ ПРИ ПРИЕМКЕ ТОВАРНО-МАТЕРИАЛЬНЫХ ЦЕННОСТЕЙ"   space(15) '"____"'  space(3)  v-underline format "X(15)"  space(3)  v-underline format "X(5)" "г."  skip(2)
     4152           "Поставщик товара " format "X(18)"  v-torgconf-cli-name format "X(110)" skip
     4153           'Настоящий акт составлен комиссией, которая установила, что ниже перечисленный товар имеет '  skip
     4154           'ненадлежащее качество ( ________________________ ), вследствие чего его следует возвратить:'  skip
     4155     .
     4156     put stream out-stream
     4157           v-single-line          format  "X(130)"    skip
     4158                  "|  №  |                   Наименование товара                 |Един|  Количество  |      Цена      |       Сумма        |Причина | "     format  "X(130)"    skip
     4159           string("| п/п |                                                       |изм.|   (Масса)    |       " + str-curr + " |        " + str-curr + "    |возврата|")     format  "X(130)"    skip
     4160           v-single-line          format  "X(130)"    skip
     4161     .
     4162     run for-each in this-procedure  .
     4163     if line-counter( out-stream ) + 7 > page-size( out-stream ) then page stream out-stream.
     4164     put stream out-stream
     4165           "    Заключение комиссии: Вернуть некачественный товар поставщику"       format  "X(130)"    skip
     4166           "    ПРИЛОЖЕНИЕ: возвратная, приходная накладная № ____________ от <_____> ______________ 20____ г."       format  "X(130)"    skip
     4167           "                возвратная, приходная накладная № ____________ от <_____> ______________ 20____ г."       format  "X(130)"    skip
     4168           "                возвратная, приходная накладная № ____________ от <_____> ______________ 20____ г."       format  "X(130)"    skip
     4169           "                возвратная, приходная накладная № ____________ от <_____> ______________ 20____ г."       format  "X(130)"    skip
     4170           "                возвратная, приходная накладная № ____________ от <_____> ______________ 20____ г."       format  "X(130)"    skip
     4171           "    Члены комиссии предупреждены об ответственности за подписание акта, содержащего данные, не соответствующие действительности."       format  "X(130)"    skip
     4172     .
     4173     if line-counter( out-stream ) + 4 > page-size( out-stream ) then page stream out-stream.
     4174     put stream out-stream
     4175           "Председатель комиссии         ___________________________    _____________   _________________________"       format  "X(130)"    skip
     4176           "Члены комиссии                ___________________________    _____________   _________________________"       format  "X(130)"    skip
     4177           "                              ___________________________    _____________   _________________________"       format  "X(130)"    skip
     4178           "                              ___________________________    _____________   _________________________"       format  "X(130)"    skip
     4179     .
     4180     if line-counter( out-stream ) + 2 > page-size( out-stream ) then page stream out-stream.
     4181     put stream out-stream
     4182           "Представитель поставщика      ___________________________    _____________   _________________________"       format  "X(130)"    skip
     4183           "Решение руководителя: Вернуть некачественный товар поставщику "       format  "X(130)"    skip
     4184     .
     4185   if session :set-wait-state( "" ) then.
     4186     output stream out-stream close.
     4187   if g#quest-print = false
     4188   then do:
     4189     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
     4190                                         7, (if 0 >= 8 then 2 else 0), 0, 0,
     4191                                         OUTPUT g#log ).
     4192   end.
     4193   else do:
     4194     os-command silent
     4195       value( "COPY /b " +
     4196         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
     4197         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
     4198         string( session:temp-directory) +  "$" + string( g#report-num )
     4199                 ) .
     4200     os-command silent
     4201       value( "COPY /b " +
     4202         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
     4203         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
     4204         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
     4205                 ) .
     4206   end.
     4207   end.
     4208   procedure for-each :
     4209     do on error undo, return error return-value :
     4210       if v-sort-prod = "yes" then do:
     4211         if sort-gr = yes then do:
     4212           if sort-name = yes then do:
     4213             for each buf_gds-dtl no-lock
     4214               where buf_gds-dtl.doc-code = t-doc.doc-code
     4215               , first buf_goods no-lock
     4216                 where buf_goods.artic      = buf_gds-dtl.artic
     4217                   and buf_goods.prod-type  = buf_gds-dtl.prod-type
     4218                   and buf_goods.prod-code  = buf_gds-dtl.prod-code
     4219               break by buf_gds-dtl.prod-type by buf_gds-dtl.prod-code by buf_goods.grp-name  by buf_goods.gds-name
     4220             :
     4221               if  first-of( buf_gds-dtl.prod-code) then do:
     4222                 run print-prod in this-procedure .
     4223               end.
     4224               if  first-of( buf_goods.grp-name) then do:
     4225                 run print-grp in this-procedure .
     4226               end.
     4227               run print-line in this-procedure .
     4228             end.
     4229           end.
     4230           else do:
     4231             for each buf_gds-dtl
     4232               where buf_gds-dtl.doc-code = t-doc.doc-code
     4233               , first buf_goods no-lock
     4234                 where buf_goods.artic      = buf_gds-dtl.artic
     4235                   and buf_goods.prod-type  = buf_gds-dtl.prod-type
     4236                   and buf_goods.prod-code  = buf_gds-dtl.prod-code
     4237               break by buf_gds-dtl.prod-type by buf_gds-dtl.prod-code by buf_goods.grp-name  by buf_gds-dtl.artic
     4238             :
     4239               if  first-of( buf_gds-dtl.prod-code) then do:
     4240                 run print-prod in this-procedure .
     4241               end.
     4242               if  first-of( buf_goods.grp-name) then do:
     4243                 run print-grp in this-procedure .
     4244               end.
     4245               run print-line in this-procedure .
     4246             end.
     4247           end.
     4248         end.
     4249         else do:
     4250           if sort-name = yes then do:
     4251             for each buf_gds-dtl no-lock
     4252               where buf_gds-dtl.doc-code = t-doc.doc-code
     4253               , first buf_goods no-lock
     4254               where buf_goods.artic      = buf_gds-dtl.artic
     4255                 and buf_goods.prod-type  = buf_gds-dtl.prod-type
     4256                 and buf_goods.prod-code  = buf_gds-dtl.prod-code
     4257               break by buf_gds-dtl.prod-type by buf_gds-dtl.prod-code by buf_goods.gds-name
     4258             :
     4259               if  first-of( buf_gds-dtl.prod-code) then do:
     4260                 run print-prod in this-procedure .
     4261               end.
     4262               run print-line in this-procedure .
     4263             end.
     4264           end.
     4265           else do:
     4266             for each buf_gds-dtl
     4267               where buf_gds-dtl.doc-code = t-doc.doc-code
     4268               , first buf_goods no-lock
     4269               where buf_goods.artic      = buf_gds-dtl.artic
     4270                   and buf_goods.prod-type  = buf_gds-dtl.prod-type
     4271                   and buf_goods.prod-code  = buf_gds-dtl.prod-code
     4272               break by buf_gds-dtl.prod-type by buf_gds-dtl.prod-code by buf_gds-dtl.artic
     4273             :
     4274               if  first-of( buf_gds-dtl.prod-code) then do:
     4275                 run print-prod in this-procedure .
     4276               end.
     4277               run print-line in this-procedure .
     4278             end.
     4279           end.
     4280         end.
     4281       end.
     4282       else do:
     4283         if sort-gr = yes then do:
     4284           if sort-name = yes then do:
     4285             for each buf_gds-dtl no-lock
     4286               where buf_gds-dtl.doc-code = t-doc.doc-code
     4287               , first buf_goods no-lock
     4288                 where buf_goods.artic      = buf_gds-dtl.artic
     4289                   and buf_goods.prod-type  = buf_gds-dtl.prod-type
     4290                   and buf_goods.prod-code  = buf_gds-dtl.prod-code
     4291               break by buf_goods.grp-name  by buf_goods.gds-name
     4292             :
     4293               if  first-of( buf_goods.grp-name) then do:
     4294                 run print-grp in this-procedure .
     4295               end.
     4296               run print-line in this-procedure .
     4297             end.
     4298           end.
     4299           else do:
     4300             for each buf_gds-dtl
     4301               where buf_gds-dtl.doc-code = t-doc.doc-code
     4302               , first buf_goods no-lock
     4303                 where buf_goods.artic      = buf_gds-dtl.artic
     4304                   and buf_goods.prod-type  = buf_gds-dtl.prod-type
     4305                   and buf_goods.prod-code  = buf_gds-dtl.prod-code
     4306               break by buf_goods.grp-name  by buf_gds-dtl.artic
     4307             :
     4308               if  first-of( buf_goods.grp-name) then do:
     4309                 run print-grp in this-procedure .
     4310               end.
     4311               run print-line in this-procedure .
     4312             end.
     4313           end.
     4314         end.
     4315         else do:
     4316           if sort-name = yes then do:
     4317             for each buf_gds-dtl no-lock
     4318               where buf_gds-dtl.doc-code = t-doc.doc-code
     4319               , first buf_goods no-lock
     4320               where buf_goods.artic      = buf_gds-dtl.artic
     4321                 and buf_goods.prod-type  = buf_gds-dtl.prod-type
     4322                 and buf_goods.prod-code  = buf_gds-dtl.prod-code
     4323               break by buf_goods.gds-name
     4324             :
     4325               run print-line in this-procedure .
     4326             end.
     4327           end.
     4328           else do:
     4329             for each buf_gds-dtl
     4330               where buf_gds-dtl.doc-code = t-doc.doc-code
     4331               , first buf_goods no-lock
     4332               where buf_goods.artic      = buf_gds-dtl.artic
     4333                   and buf_goods.prod-type  = buf_gds-dtl.prod-type
     4334                   and buf_goods.prod-code  = buf_gds-dtl.prod-code
     4335               break by buf_gds-dtl.artic
     4336             :
     4337               run print-line in this-procedure .
     4338             end.
     4339           end.
     4340         end.
     4341       end.
     4342       put stream out-stream   v-single-line  format  "X(130)"    skip
     4343         "|  ИТОГО "                   format  "X(67)"
     4344         "|"  all-qnty   format ">>>>>,>>>,>>9.<<<"
     4345         "|"
     4346         "|" at 100 all-sum  format ">,>>>,>>>,>>>,>>9.99"
     4347         "|" "|" at 130
     4348       skip
     4349       v-single-line  format  "X(130)"
     4350       skip .
     4351     end.
     4352   end procedure.
     4353   procedure Print-prod :
     4354     do on error undo, return error return-value :
     4355       if line-counter( out-stream ) + 2 > page-size( out-stream ) then page stream out-stream.
     4356       find first buf_clients where buf_clients.obj-type = buf_goods.prod-type and buf_clients.obj-code = buf_goods.prod-code no-lock .
     4357       put stream out-stream "| Производитель - " format "X(18)"  buf_clients.obj-name   format  "X(110)"  "|" at 130 skip .
     4358     end.
     4359   end procedure.
     4360   procedure print-grp :
     4361     do on error undo, return error return-value :
     4362       if line-counter( out-stream ) + 2 > page-size( out-stream ) then page stream out-stream.
     4363       put stream out-stream "| Группа - " format "X(11)"  buf_goods.grp-name   format  "X(118)"  "|" at 130 skip .
     4364     end.
     4365   end procedure.
     4366   procedure print-line :
     4367     do on error undo, return error return-value :
     4368       if line-counter( out-stream ) + 2 > page-size( out-stream ) then page stream out-stream.
     4369       assign
     4370         v-num = v-num + 1
     4371         all-qnty  = all-qnty + buf_gds-dtl.fact-qnty
     4372         all-sum   = all-sum  + if t-doc.exch-code = 0 then buf_gds-dtl.price-rubl * buf_gds-dtl.fact-qnty else buf_gds-dtl.price-base * buf_gds-dtl.fact-qnty
     4373       .
     4374       put stream out-stream
     4375         "|"  v-num                    format ">>>>9"
     4376         "|"  buf_goods.gds-name       format  "X(55)"
     4377         "|"  buf_goods.unit-base      format  "X(4)"
     4378         "|"  buf_gds-dtl.fact-qnty   format ">>>>>,>>>,>>9.<<<"
     4379         "|"  if t-doc.exch-code = 0 then buf_gds-dtl.price-rubl else buf_gds-dtl.price-base  format ">,>>>,>>>,>>9.99"
     4380         "|"  if t-doc.exch-code = 0 then buf_gds-dtl.price-rubl * buf_gds-dtl.fact-qnty else buf_gds-dtl.price-base * buf_gds-dtl.fact-qnty  format ">,>>>,>>>,>>>,>>9.99"
     4381         "|" "|" at 130
     4382       skip .
     4383     end.
     4384   end procedure.
