     1831   procedure torgconf-get-sup-param :
     1832   define input parameter p-obj-type           as character        no-undo.
     1833   define input parameter p-obj-code           as integer          no-undo.
     1834   define input parameter p-curr-code          as integer          no-undo.
     1835       define variable v-host-code    as integer      no-undo.
     1836       define variable v-par-type     as character    no-undo.
     1837   do
     1838   on error undo, return error
     1839   :
     1840       assign
     1841          v-torgconf-sup-host-code = v-host-code
     1842       .
     1843       if v-torgconf-sup-host-code = 0
     1844       then do:
     1845           assign
     1846               v-torgconf-sup-host-name           = "":U
     1847               v-torgconf-sup-host-addres         = "":U
     1848               v-torgconf-sup-host-post-addres    = "":U
     1849               v-torgconf-sup-host-phone          = "":U
     1850               v-torgconf-sup-host-inn            = "":U
     1851               v-torgconf-sup-host-kpp            = "":U
     1852               v-torgconf-sup-host-okpo           = "":U
     1853               v-torgconf-sup-host-egrip-date     = "":U
     1854               v-torgconf-sup-host-egrip-num      = "":U
     1855           .
     1856       end.
     1857       else do:
     1858           run fmtcli-get-client in this-procedure (
     1859                 input 'орг':U
     1860               , input v-torgconf-sup-host-code
     1861           ).
     1862           assign
     1863               v-torgconf-sup-host-name        = v-fmtcli-name
     1864               v-torgconf-sup-host-engl-name   = v-fmtcli-engl-name
     1865               v-torgconf-sup-host-addres      = v-fmtcli-full-addres
     1866               v-torgconf-sup-host-post-addres = v-fmtcli-post-addres
     1867               v-torgconf-sup-host-phone       = v-fmtcli-phone
     1868               v-torgconf-sup-host-inn         = v-fmtcli-inn
     1869               v-torgconf-sup-host-kpp         = v-fmtcli-kpp
     1870               v-torgconf-sup-host-okpo        = v-fmtcli-okpo
     1871           .
     1872           run gbl/clntat-v.p (
     1873                 input 'орг':U
     1874               , input v-torgconf-sup-host-code
     1875               , input 'egrip-date':U
     1876               , output v-torgconf-sup-host-egrip-date
     1877               , output v-par-type
     1878           ).
     1879           run gbl/clntat-v.p (
     1880                 input 'орг':U
     1881               , input v-torgconf-sup-host-code
     1882               , input 'egrip-num':U
     1883               , output v-torgconf-sup-host-egrip-num
     1884               , output v-par-type
     1885           ).
     1886           run fmtcli-get-bank in this-procedure (
     1887                 input v-host-code
     1888               , input 'орг':U
     1889               , input v-torgconf-sup-host-code
     1890               , input p-curr-code
     1891           ).
     1892       end.
     1893       assign
     1894           v-torgconf-sup-schet-exists = v-fmtcli-schet-exists
     1895           v-torgconf-sup-bank-exists  = v-fmtcli-bank-exists
     1896           v-torgconf-sup-bank-r-schet = v-fmtcli-bank-r-schet
     1897           v-torgconf-sup-bank-c-schet = v-fmtcli-bank-c-schet
     1898           v-torgconf-sup-bank-bik     = v-fmtcli-bank-bik
     1899           v-torgconf-sup-bank-name    = v-fmtcli-bank-name
     1900           v-torgconf-sup-bank-addres  = v-fmtcli-bank-addres
     1901           v-torgconf-sup-bank-city    = v-fmtcli-bank-city
     1902       .
     1903       assign
     1904           v-torgconf-sup-obj-type = p-obj-type
     1905           v-torgconf-sup-obj-code = p-obj-code
     1906       .
     1907       if trim(p-obj-type) <> ""
     1908       and p-obj-code <> 0
     1909       then do:
     1910       run fmtcli-get-client in this-procedure (
     1911             input p-obj-type
     1912           , input p-obj-code
     1913       ).
     1914       assign
     1915           v-torgconf-sup-obj-name        = v-fmtcli-name
     1916           v-torgconf-sup-obj-engl-name   = v-fmtcli-engl-name
     1917           v-torgconf-sup-obj-addres      = v-fmtcli-full-addres
     1918           v-torgconf-temp-post-addres    = v-fmtcli-post-addres
     1919           v-torgconf-sup-obj-phone       = v-fmtcli-phone
     1920           v-torgconf-sup-obj-inn         = v-fmtcli-inn
     1921           v-torgconf-sup-obj-okpo        = v-fmtcli-okpo
     1922       .
     1923      end.
     1924      end.
     1925   end procedure.
     1926   procedure torgconf-get-cli-param :
     1927   define input parameter p-host-obj-code      as integer          no-undo.
     1928   define input parameter p-obj-type           as character        no-undo.
     1929   define input parameter p-obj-code           as integer          no-undo.
     1930   define input parameter p-curr-code          as integer          no-undo.
     1931       define variable v-host-code    as integer      no-undo.
     1932   do
     1933   on error undo, return error
     1934   :
     1935       assign
     1936           v-torgconf-cli-type = p-obj-type
     1937           v-torgconf-cli-code = p-obj-code
     1938       .
     1939       run fmtcli-get-client in this-procedure (
     1940             input p-obj-type
     1941           , input p-obj-code
     1942       ).
     1943       assign
     1944           v-torgconf-cli-name         = trim( v-fmtcli-name          )
     1945           v-torgconf-cli-engl-name    = trim( v-fmtcli-engl-name          )
     1946           v-torgconf-cli-addres       = trim( v-fmtcli-full-addres   )
     1947           v-torgconf-cli-post-addres  = trim( v-fmtcli-post-addres   )
     1948           v-torgconf-cli-phone        = trim( v-fmtcli-phone         )
     1949           v-torgconf-cli-inn          = trim( v-fmtcli-inn           )
     1950           v-torgconf-cli-kpp          = trim( v-fmtcli-kpp           )
     1951           v-torgconf-cli-okpo         = trim( v-fmtcli-okpo          )
     1952       .
     1953      run fmtcli-get-bank in this-procedure (
     1954             input p-host-obj-code
     1955           , input p-obj-type
     1956           , input p-obj-code
     1957           , input p-curr-code
     1958       ).
     1959       assign
     1960           v-torgconf-cli-schet-exists = v-fmtcli-schet-exists
     1961           v-torgconf-cli-bank-exists  = v-fmtcli-bank-exists
     1962           v-torgconf-cli-bank-r-schet = v-fmtcli-bank-r-schet
     1963           v-torgconf-cli-bank-c-schet = v-fmtcli-bank-c-schet
     1964           v-torgconf-cli-bank-bik     = v-fmtcli-bank-bik
     1965           v-torgconf-cli-bank-name    = v-fmtcli-bank-name
     1966           v-torgconf-cli-bank-addres  = v-fmtcli-bank-addres
     1967           v-torgconf-cli-bank-city    = v-fmtcli-bank-city
     1968       .
     1969   end.
     1970   end procedure.
     1971   procedure torgconf-get-ship-param :
     1972   define input parameter p-host-obj-code      as integer          no-undo.
     1973   define input parameter p-obj-type           as character        no-undo.
     1974   define input parameter p-obj-code           as integer          no-undo.
     1975   define input parameter p-curr-code          as integer          no-undo.
     1976       define variable v-host-code    as integer      no-undo.
     1977   do
     1978   on error undo, return error
     1979   :
     1980       assign
     1981           v-torgconf-ship-type = p-obj-type
     1982           v-torgconf-ship-code = p-obj-code
     1983       .
     1984       if trim(p-obj-type) = ""
     1985       and p-obj-code = 0
     1986       then do:
     1987       assign
     1988           v-torgconf-ship-name         = "":U
     1989           v-torgconf-ship-addres       = "":U
     1990           v-torgconf-ship-post-addres  = "":U
     1991           v-torgconf-ship-phone        = "":U
     1992           v-torgconf-ship-inn          = "":U
     1993           v-torgconf-ship-kpp          = "":U
     1994           v-torgconf-ship-okpo         = "":U
     1995       .
     1996       end.
     1997       else do:
     1998       run fmtcli-get-client in this-procedure (
     1999             input p-obj-type
     2000           , input p-obj-code
     2001       ).
     2002       assign
     2003           v-torgconf-ship-name         = trim( v-fmtcli-name          )
     2004           v-torgconf-ship-engl-name    = trim( v-fmtcli-engl-name          )
     2005           v-torgconf-ship-addres       = trim( v-fmtcli-full-addres   )
     2006           v-torgconf-ship-post-addres  = trim( v-fmtcli-post-addres   )
     2007           v-torgconf-ship-phone        = trim( v-fmtcli-phone         )
     2008           v-torgconf-ship-inn          = trim( v-fmtcli-inn           )
     2009           v-torgconf-ship-kpp          = trim( v-fmtcli-kpp           )
     2010           v-torgconf-ship-okpo         = trim( v-fmtcli-okpo          )
     2011       .
     2012       end.
     2013           run fmtcli-get-bank in this-procedure (
     2014             input p-host-obj-code
     2015           , input p-obj-type
     2016           , input p-obj-code
     2017           , input p-curr-code
     2018       ).
     2019       assign
     2020           v-torgconf-ship-schet-exists = v-fmtcli-schet-exists
     2021           v-torgconf-ship-bank-exists  = v-fmtcli-bank-exists
     2022           v-torgconf-ship-bank-r-schet = v-fmtcli-bank-r-schet
     2023           v-torgconf-ship-bank-c-schet = v-fmtcli-bank-c-schet
     2024           v-torgconf-ship-bank-bik     = v-fmtcli-bank-bik
     2025           v-torgconf-ship-bank-name    = v-fmtcli-bank-name
     2026           v-torgconf-ship-bank-addres  = v-fmtcli-bank-addres
     2027           v-torgconf-ship-bank-city    = v-fmtcli-bank-city
     2028       .
     2029   end.
     2030   end procedure.
     2031   procedure torgconf-get-holdfirm-code :
     2032   define input parameter p-obj-type   as character        no-undo.
     2033   define input parameter p-obj-code   as integer          no-undo.
     2034   define output parameter p-firm-code as integer          no-undo.
     2035       define variable v-firm-code-str     as character    no-undo.
     2036       define variable v-par-type          as character    no-undo.
     2037       define buffer buf_clients       for ub.clients.
     2038   do
     2039   for buf_clients
     2040   on error undo, return error
     2041   :
     2042       run gbl/clntat-v.p (
     2043             input p-obj-type
     2044           , input p-obj-code
     2045           , input 'holdfirm-code':U
     2046           , output v-firm-code-str
     2047           , output v-par-type
     2048       ).
     2049       assign
     2050           p-firm-code = integer( v-firm-code-str )
     2051       no-error.
     2052       if error-status :error
     2053       then do:
     2054           message
     2055               "Неверно задан код фирмы для печати накладных."
     2056           view-as alert-box warning.
     2057           assign
     2058               p-firm-code = 0
     2059           .
     2060       end.
     2061       else do:
     2062           find first buf_clients no-lock
     2063                where buf_clients.obj-type = 'орг':U
     2064                  and buf_clients.obj-code = p-firm-code
     2065           no-error.
     2066           if not available buf_clients
     2067           then do:
     2068               message
     2069                   "Включен параметр 'Список печатных форм, для которых должна быть задана фирма для печати накладных' (outhold)" skip
     2070                   "Не найдена фирма по заданному коду фирмы для печати накладных."
     2071               view-as alert-box warning.
     2072               assign
     2073                   p-firm-code = 0
     2074               .
     2075           end.
     2076       end.
     2077   end.
     2078   end procedure.
     2079   procedure torgconf-get-post-head:
     2080   define input  parameter p-obj-type             as character        no-undo.
     2081   define input  parameter p-obj-code             as integer          no-undo.
     2082   define output parameter p-torgconf-post-head   as character        no-undo.
     2083      define variable v-host-code         as integer      no-undo.
     2084      define buffer buf_sysconf     for ub.sysconf.
     2085        assign
     2086         p-torgconf-post-head  = ""
     2087        .
     2088   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2089   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2090     (input  p-obj-type
     2091     ,input  p-obj-code
     2092     ,output v-host-code
     2093     )  .
     2094      find first buf_sysconf no-lock
     2095      where buf_sysconf.host-code = v-host-code
     2096      no-error.
     2097      if available buf_sysconf
     2098      then do:
     2099         assign
     2100            p-torgconf-post-head = buf_sysconf.head-position
     2101         .
     2102      end.
     2103   end procedure.
     2104   procedure torgconf-get-storekeeper:
     2105   define input  parameter p-wrkr                   as integer          no-undo.
     2106   define output parameter p-torgconf-wrkr-name     as character        no-undo.
     2107   define output parameter p-torgconf-post          as character        no-undo.
     2108      define buffer buf_sysconf     for ub.sysconf.
     2109      define buffer buf_person      for ub.person.
     2110      define buffer buf_shop        for ub.shop .
     2111      define buffer buf_store       for ub.store .
     2112      if v-torgconf-outC = "no_print"
     2113      then do:
     2114         assign p-torgconf-post = ""
     2115                p-torgconf-wrkr-name = ""
     2116                .
     2117      end.
     2118      if v-torgconf-outC = "clad_doc"
     2119      then do:
     2120         run rep/get-psn.p
     2121               (input  p-wrkr
     2122               ,output p-torgconf-wrkr-name
     2123               ) .
     2124         find first buf_person no-lock
     2125         where buf_person.psn-code = p-wrkr
     2126         no-error.
     2127         if available buf_person
     2128         then do:
     2129           p-torgconf-post = buf_person.position.
     2130         end.
     2131         if p-torgconf-post = "?":U then p-torgconf-post = "".
     2132         if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2133      end.
     2134      if v-torgconf-outC = "clad_obj"
     2135      then do:
     2136         CASE v-torgconf-self-obj-type:
     2137         WHEN 'маг':U
     2138         THEN DO:
     2139            find first buf_shop no-lock
     2140            where buf_shop.obj-code = v-torgconf-self-obj-code
     2141            .
     2142            assign
     2143               p-torgconf-wrkr-name = buf_shop.store-man
     2144               p-torgconf-post = ""
     2145            .
     2146            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2147         END.
     2148         WHEN 'скл':U
     2149         THEN DO:
     2150            find first buf_store no-lock
     2151            where buf_store.obj-code = v-torgconf-self-obj-code
     2152            .
     2153            assign
     2154               p-torgconf-wrkr-name = buf_store.store-man
     2155               p-torgconf-post = ""
     2156            .
     2157            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2158         END.
     2159         OTHERWISE DO:
     2160            assign
     2161               p-torgconf-post = "":U
     2162               p-torgconf-wrkr-name = "":U
     2163            .
     2164         END.
     2165         END CASE.
     2166      end.
     2167    end procedure.
     2168   procedure torgconf-get-form-header :
     2169   define input parameter p-for-inverse    as logical          no-undo.
     2170   define input parameter p-doc-code       as character        no-undo.
     2171   define input parameter p-print-doc      as logical          no-undo.
     2172   define input parameter p-doc-date       as date             no-undo.
     2173   define input parameter p-fact-date      as date             no-undo.
     2174   define input parameter p-doc-type       as character        no-undo.
     2175   define input parameter p-status_        as character        no-undo.
     2176   define input parameter p-reverse        as logical          no-undo.
     2177   define input parameter p-sf-par         as logical          no-undo.
     2178       define variable v-attr-type         as character    no-undo.
     2179       define variable v-doc-code-standard as logical      no-undo.
     2180       define variable v-doc-date-standard as logical      no-undo.
     2181       define variable v-par-consignee-addres  as character    no-undo.
     2182       define variable v-host-code         as integer      no-undo.
     2183       define variable v-dcode-attr        as character    no-undo.
     2184       define variable v-ddate-attr        as character    no-undo.
     2185       define variable v-doc-date          as character    no-undo.
     2186       define variable v-doc-code          as character    no-undo.
     2187       define variable v-par-type          as character    no-undo.
     2188       define variable v-attr              as character    no-undo.
     2189       define buffer buf_firm          for ub.firm .
     2190       define buffer buf_clients       for ub.clients .
     2191       define buffer buf_sysconf       for ub.sysconf .
     2192       define buffer buf_shop          for ub.shop .
     2193       define buffer buf_store         for ub.store .
