        1   block-level on error undo, throw.
        2   define input parameter parParentProc     AS WIDGET-HANDLE NO-UNDO.
        3   define input parameter rec_id       as recid      no-undo.
        4   define variable vss-revision    as character no-undo initial "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo initial "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo initial "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo initial "$Workfile: r-torg2.p $":U .
        8   define variable vss-archive     as character no-undo initial "$Archive: rep/r-torg2.p $":U .
        9   define variable vss-description as character no-undo initial "Печатные формы. Торг-2 для возврата поставщику":U .
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define new global shared variable g#lib-trn  as handle no-undo .
       71   define new global shared variable g#lib-trn2 as handle no-undo .
       72   define new global shared variable g#lib-trn3 as handle no-undo .
       73   define new global shared variable g#lib-trn4 as handle no-undo .
       74   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       75   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
       76   define  shared variable RepPathName        as character no-undo .
       77   define  shared variable PrintRubl          as logical   no-undo .
       78   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       79   procedure cur-time :
       80      define output parameter p-today as date      no-undo .
       81      define output parameter p-time  as integer   no-undo .
       82     do
       83     on error undo, return error
       84     :
       85       define variable v-date1 as date      no-undo .
       86       define variable v-date2 as date      no-undo .
       87       define variable v-time  as integer   no-undo .
       88       assign
       89         v-date1 = today
       90         v-time  = time
       91         v-date2 = today
       92       .
       93       if v-date1 <> v-date2
       94       then do:
       95         assign
       96           v-date1 = today
       97           v-time  = v-time
       98         .
       99       end.
      100       assign
      101         p-today = v-date1
      102         p-time  = v-time
      103       .
      104     end.
      105   end.
      106   function cur-time-date returns character
      107   :
      108     return string(today, '99/99/9999':U) .
      109   end.
      110   function cur-time-mjd returns decimal
      111   :
      112     define variable v-date as date      no-undo .
      113     define variable v-time as integer   no-undo .
      114     run cur-time in this-procedure
      115       (output v-date
      116       ,output v-time
      117       ) .
      118     return integer(v-date) - 2400002 + (v-time / 86400) .
      119   end.
      120   function cur-time-get-ending-index returns integer
      121   (input p-number as integer
      122   )
      123   :
      124     if p-number < 0
      125     or p-number = ?
      126     then do:
      127       return 1 .
      128     end.
      129     define variable v-rest as integer   no-undo .
      130     assign
      131       p-number = p-number modulo 100
      132     .
      133     if p-number < 20
      134     then do:
      135       assign
      136         v-rest = p-number
      137       .
      138     end.
      139     else do:
      140       assign
      141         v-rest = p-number modulo 10
      142       .
      143     end.
      144     case v-rest :
      145       when 1
      146       then do:
      147         return 2 .
      148       end.
      149       when 2 or
      150       when 3 or
      151       when 4
      152       then do:
      153         return 3 .
      154       end.
      155       otherwise do:
      156         return 1 .
      157       end.
      158     end case .
      159   end.
      160   procedure cur-time-mjd-to-date :
      161      define input  parameter i-mjd-diff as decimal no-undo.
      162      define output parameter o-Date     as date    no-undo.
      163      define output parameter o-Time     as integer no-undo.
      164      define variable v-day-number as integer   no-undo .
      165      if    i-mjd-diff < 0
      166         or i-mjd-diff = ?
      167      then do:
      168         return "?" .
      169      end.
      170      assign
      171         v-day-number = truncate(i-mjd-diff,0).
      172         o-Date = date(v-day-number + 2400002).
      173         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      174     .
      175   end.
      176   function cur-time-mjd-to-string returns character
      177   (input p-mjd-diff as decimal
      178   )
      179   :
      180     define variable v-day-number as integer   no-undo .
      181     define variable v-seconds    as integer   no-undo .
      182     define variable v-hour       as integer   no-undo .
      183     define variable v-min        as integer   no-undo .
      184     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      185     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      186     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      187     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      188     if p-mjd-diff < 0
      189     or p-mjd-diff = ?
      190     then do:
      191       return "?" .
      192     end.
      193     assign
      194       v-day-number = integer(truncate(p-mjd-diff,0))
      195       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      196     .
      197     if v-seconds > 86400
      198     then do:
      199       assign
      200         v-seconds = 86400 - 1
      201       .
      202     end.
      203     if v-seconds < 0
      204     then do:
      205       assign
      206         v-seconds = 0
      207       .
      208     end.
      209     assign
      210       v-hour = truncate(v-seconds / 3600, 0)
      211     .
      212     assign
      213       v-seconds = v-seconds modulo 3600
      214     .
      215     assign
      216       v-min = truncate(v-seconds / 60, 0)
      217     .
      218     assign
      219       v-seconds = v-seconds modulo 60
      220     .
      221     return
      222         (if v-day-number <> 0
      223           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      224           else ""
      225         )
      226       + (if v-day-number <> 0 or v-hour <> 0
      227           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      228           else ""
      229         )
      230       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      231           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      232           else ""
      233         )
      234       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      235       .
      236   end.
      237   function cur-time-string returns character
      238   :
      239     define variable v-date as date      no-undo .
      240     define variable v-time as integer   no-undo .
      241     run cur-time in this-procedure
      242       (output v-date
      243       ,output v-time
      244       ) .
      245     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      246   end.
      247   function cur-time-string-sec returns character
      248   :
      249     define variable v-date as date      no-undo .
      250     define variable v-time as integer   no-undo .
      251     run cur-time in this-procedure
      252       (output v-date
      253       ,output v-time
      254       ) .
      255     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      256   end.
      257   function cur-time-custom  returns character
      258   (input p-prefix as character
      259   ,input p-date-format as character
      260   ,input p-delimiter as character
      261   ,input p-time-format as character
      262   ,input p-suffix as character
      263   )
      264   :
      265     define variable v-date as date      no-undo .
      266     define variable v-time as integer   no-undo .
      267     run cur-time in this-procedure
      268       (output v-date
      269       ,output v-time
      270       ) .
      271     return
      272       p-prefix
      273       + string(v-date, p-date-format)
      274       + p-delimiter
      275       + string(v-time, p-time-format)
      276       + p-suffix
      277       .
      278   end.
      279   function cur-time-print  returns character
      280   :
      281     define variable v-date as date      no-undo .
      282     define variable v-time as integer   no-undo .
      283     run cur-time in this-procedure
      284       (output v-date
      285       ,output v-time
      286       ) .
      287     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      288   end.
      289   function cur-time-datetime returns datetime
      290   :
      291     define variable v-char as character no-undo .
      292     define variable v-datetime as datetime no-undo .
      293     v-char = cur-time-string().
      294     v-datetime = datetime(v-char).
      295     return  v-datetime.
      296   end.
      297   function cur-time-string-msec returns character
      298   :
      299     define variable v-date as datetime  no-undo .
      300     v-date = now.
      301     return string(v-date) .
      302   end.
      303   define variable vss-include-info2 as character format "X(65)" no-undo
      304   initial "@(#)$Workfile$ $Revision$".
      305   define variable v-fmtcli-name          as character    no-undo.
      306   define variable v-fmtcli-engl-name     as character    no-undo.
      307   define variable v-fmtcli-addres        as character    no-undo.
      308   define variable v-fmtcli-post-addres   as character    no-undo.
      309   define variable v-fmtcli-full-addres   as character    no-undo.
      310   define variable v-fmtcli-phone         as character    no-undo.
      311   define variable v-fmtcli-inn           as character    no-undo.
      312   define variable v-fmtcli-kpp           as character    no-undo.
      313   define variable v-fmtcli-okpo          as character    no-undo.
      314   define variable v-fmtcli-country       as character    no-undo.
      315   define variable v-fmtcli-city          as character    no-undo.
      316   define variable v-fmtcli-index         as character    no-undo.
      317   define variable v-fmtcli-schet-exists  as logical      no-undo.
      318   define variable v-fmtcli-bank-exists   as logical      no-undo.
      319   define variable v-fmtcli-bank-r-schet  as character    no-undo.
      320   define variable v-fmtcli-bank-c-schet  as character    no-undo.
      321   define variable v-fmtcli-bank-bik      as character    no-undo.
      322   define variable v-fmtcli-bank-name     as character    no-undo.
      323   define variable v-fmtcli-bank-addres   as character    no-undo.
      324   define variable v-fmtcli-bank-city     as character    no-undo.
      325   procedure fmtcli-get-bank :
      326   define input parameter p-host-code      as integer          no-undo.
      327   define input parameter p-obj-type       as character        no-undo.
      328   define input parameter p-obj-code       as integer          no-undo.
      329   define input parameter p-curr-code      as integer          no-undo.
      330       define buffer buf_fin-schet     for ub.fin-schet.
      331       define buffer buf_fin-bank      for ub.fin-bank.
      332   do
      333   for buf_fin-schet
      334     , buf_fin-bank
      335   on error undo, return error
      336   :
      337       assign
      338           v-fmtcli-schet-exists       = no
      339           v-fmtcli-bank-exists        = no
      340           v-fmtcli-bank-r-schet       = "":U
      341           v-fmtcli-bank-c-schet       = "":U
      342           v-fmtcli-bank-bik           = "":U
      343           v-fmtcli-bank-name          = "":U
      344           v-fmtcli-bank-addres        = "":U
      345           v-fmtcli-bank-city          = "":U
      346       .
      347       search-for-schet:
      348       for each buf_fin-schet no-lock
      349          where buf_fin-schet.host-code = p-host-code
      350            and buf_fin-schet.cli-type  = p-obj-type
      351            and buf_fin-schet.cli-code  = p-obj-code
      352            and buf_fin-schet.curr-code = p-curr-code
      353       on error undo, return error
      354       :
      355           if buf_fin-schet.status_   = 'удал':U
      356           then do:
      357           end.
      358           else do:
      359               assign
      360                   v-fmtcli-schet-exists   = yes
      361                   v-fmtcli-bank-r-schet   = trim( buf_fin-schet.r-schet )
      362                   v-fmtcli-bank-c-schet   = trim( buf_fin-schet.c-schet )
      363               .
      364               find first buf_fin-bank no-lock
      365                    where buf_fin-bank.host-code = p-host-code
      366                      and buf_fin-bank.code-bank = buf_fin-schet.code-bank
      367               no-error.
      368               if available buf_fin-bank
      369               then do:
      370                   assign
      371                       v-fmtcli-bank-exists      = yes
      372                       v-fmtcli-bank-bik         = trim( buf_fin-bank.bik )
      373                       v-fmtcli-bank-name        = trim( buf_fin-bank.bank-name )
      374                       v-fmtcli-bank-addres      = trim(buf_fin-bank.addres)
      375                       v-fmtcli-bank-city      = trim(buf_fin-bank.bank-city)
      376                   .
      377               end.
      378               else do:
      379                   assign
      380                       v-fmtcli-bank-exists    = no
      381                       v-fmtcli-bank-bik       = "":U
      382                       v-fmtcli-bank-name      = "":U
      383                       v-fmtcli-bank-addres    = "":U
      384                       v-fmtcli-bank-city      = "":U
      385                   .
      386               end.
      387               leave search-for-schet.
      388           end.
      389       end.
      390   end.
      391   end procedure.
      392   procedure fmtcli-get-client :
      393   define input parameter p-obj-type       as character    no-undo.
      394   define input parameter p-obj-code       as integer      no-undo.
      395       define variable v-temp-fmtcli-address      as character     no-undo.
      396       define variable v-num-country-city    as integer      no-undo.
      397       define buffer buf_clients   for ub.clients.
      398       define buffer buf_firm      for ub.firm.
      399       define buffer buf_store     for ub.store.
      400       define buffer buf_shop      for ub.shop.
      401       define buffer buf_person    for ub.person.
      402   do
      403   for buf_clients
      404     , buf_firm
      405     , buf_store
      406     , buf_shop
      407     , buf_person
      408   on error undo, return error
      409   :
      410       assign
      411           v-fmtcli-name           = "":U
      412           v-fmtcli-addres         = "":U
      413           v-fmtcli-post-addres    = "":U
      414           v-fmtcli-full-addres    = "":U
      415           v-fmtcli-phone          = "":U
      416           v-fmtcli-inn            = "":U
      417           v-fmtcli-kpp            = "":U
      418           v-fmtcli-okpo           = "":U
      419           v-fmtcli-city           = "":U
      420           v-fmtcli-index          = "":U
      421           v-fmtcli-country        = "":U
      422       .
      423       find first buf_clients no-lock
      424            where buf_clients.obj-type = p-obj-type
      425              and buf_clients.obj-code = p-obj-code
      426       .
      427       assign
      428           v-fmtcli-name = buf_clients.obj-name
      429       .
      430       case buf_clients.obj-type:
      431          when 'орг':U
      432          then do:
      433               find first buf_firm no-lock
      434                    where buf_firm.firm-code = buf_clients.obj-code
      435                    no-error
      436               .
      437               if available buf_firm
      438               then do:
      439                   assign
      440                       v-num-country-city = num-entries( buf_firm.city )
      441                       v-fmtcli-engl-name = buf_firm.engl-name
      442                   .
      443                   if v-num-country-city > 0
      444                   then do:
      445                       assign
      446                           v-fmtcli-country    = trim( entry( 1, buf_firm.city ) )
      447                       .
      448                   end.
      449                   if v-num-country-city > 1
      450                   then do:
      451                       assign
      452                           v-fmtcli-city       = trim( entry( 2, buf_firm.city ) )
      453                       .
      454                   end.
      455                   run fmtcli-concatenate-strings in this-procedure (
      456                         input v-fmtcli-full-addres
      457                       , input v-fmtcli-country
      458                       , input ", ":U
      459                       , input 50
      460                       , output v-fmtcli-full-addres
      461                   ).
      462                   run fmtcli-concatenate-strings in this-procedure (
      463                         input v-fmtcli-full-addres
      464                       , input v-fmtcli-city
      465                       , input ", ":U
      466                       , input 50
      467                       , output v-fmtcli-full-addres
      468                   ).
      469                   run fmtcli-concatenate-strings in this-procedure (
      470                         input v-fmtcli-full-addres
      471                       , input IF buf_firm.ind = 0 THEN "" ELSE string( buf_firm.ind )
      472                       , input ", ":U
      473                       , input 50
      474                       , output v-fmtcli-full-addres
      475                   ).
      476                   run fmtcli-concatenate-strings in this-procedure (
      477                         input v-fmtcli-post-addres
      478                       , input v-fmtcli-country
      479                       , input ", ":U
      480                       , input 50
      481                       , output v-fmtcli-post-addres
      482                   ).
      483                   run fmtcli-concatenate-strings in this-procedure (
      484                         input v-fmtcli-post-addres
      485                       , input v-fmtcli-city
      486                       , input ", ":U
      487                       , input 50
      488                       , output v-fmtcli-post-addres
      489                   ).
      490                   run fmtcli-concatenate-strings in this-procedure (
      491                         input v-fmtcli-post-addres
      492                       , input string( buf_firm.ind )
      493                       , input ", ":U
      494                       , input 50
      495                       , output v-fmtcli-post-addres
      496                   ).
      497                   run fmtcli-concatenate-strings in this-procedure (
      498                         input substring( buf_firm.addres1, 1, 50 )
      499                       , input buf_firm.addres2
      500                       , input " ":U
      501                       , input 50
      502                       , output v-temp-fmtcli-address
      503                   ).
      504                   run fmtcli-concatenate-strings in this-procedure (
      505                         input v-temp-fmtcli-address
      506                       , input substring( buf_firm.addres1, 51, 50 )
      507                       , input " ":U
      508                       , input 50
      509                       , output v-temp-fmtcli-address
      510                   ).
      511                   run fmtcli-concatenate-strings in this-procedure (
      512                         input v-temp-fmtcli-address
      513                       , input substring( buf_firm.addres1, 101, 50 )
      514                       , input " ":U
      515                       , input 50
      516                       , output v-temp-fmtcli-address
      517                   ).
      518                   assign
      519                       v-fmtcli-addres = v-temp-fmtcli-address
      520                   .
      521                   if buf_firm.addres1 <> ?
      522                   then do:
      523                       run fmtcli-concatenate-strings in this-procedure (
      524                             input v-fmtcli-full-addres
      525                           , input v-fmtcli-addres
      526                           , input ", ":U
      527                           , input 0
      528                           , output v-fmtcli-full-addres
      529                       ).
      530                   end.
      531                   run fmtcli-concatenate-strings in this-procedure (
      532                         input substring( buf_firm.post-addr1, 1, 50 )
      533                       , input buf_firm.post-addr2
      534                       , input " ":U
      535                       , input 50
      536                       , output v-fmtcli-post-addres
      537                   ).
      538                   run fmtcli-concatenate-strings in this-procedure (
      539                         input v-fmtcli-post-addres
      540                       , input substring( buf_firm.post-addr1, 51, 50 )
      541                       , input " ":U
      542                       , input 50
      543                       , output v-fmtcli-post-addres
      544                   ).
      545                   run fmtcli-concatenate-strings in this-procedure (
      546                         input v-fmtcli-post-addres
      547                       , input substring( buf_firm.post-addr1, 101, 50 )
      548                       , input " ":U
      549                       , input 50
      550                       , output v-fmtcli-post-addres
      551                   ).
      552                   assign
      553                       v-fmtcli-phone         = buf_firm.phone
      554                       v-fmtcli-inn           = buf_firm.inn
      555                       v-fmtcli-kpp           = buf_firm.kpp
      556                       v-fmtcli-okpo          = buf_firm.okpo
      557                       v-fmtcli-index         = string( buf_firm.ind )
      558                   .
      559               end.
      560          end.
      561          when 'маг':U
      562          then do:
      563               find first buf_shop no-lock
      564                    where buf_shop.obj-code = buf_clients.obj-code
      565               .
      566               if available buf_shop
      567               then do:
      568                   run fmtcli-concatenate-strings in this-procedure (
      569                         input buf_shop.addres1
      570                       , input buf_shop.addres2
      571                       , input " ":U
      572                       , input 50
      573                       , output v-fmtcli-addres
      574                   ).
      575                   assign
      576                       v-fmtcli-full-addres = v-fmtcli-addres
      577                       v-fmtcli-post-addres = v-fmtcli-addres
      578                       v-fmtcli-phone       = buf_shop.phone
      579                       v-fmtcli-inn         = "":U
      580                       v-fmtcli-kpp         = "":U
      581                       v-fmtcli-okpo        = "":U
      582                       v-fmtcli-city        = "":U
      583                       v-fmtcli-index       = "":U
      584                   .
      585               end.
      586          end.
      587          when 'скл':U
      588          then do:
      589               find first buf_store no-lock
      590                    where buf_store.obj-code = buf_clients.obj-code
      591               .
      592               if available buf_store
      593               then do:
      594                   run fmtcli-concatenate-strings in this-procedure (
      595                         input buf_store.addres1
      596                       , input buf_store.addres2
      597                       , input " ":U
      598                       , input 50
      599                       , output v-fmtcli-addres
      600                   ).
      601                   assign
      602                       v-fmtcli-full-addres = v-fmtcli-addres
      603                       v-fmtcli-phone       = buf_store.phone
      604                       v-fmtcli-inn         = "":U
      605                       v-fmtcli-kpp         = "":U
      606                       v-fmtcli-okpo        = "":U
      607                       v-fmtcli-city        = "":U
      608                       v-fmtcli-index       = "":U
      609                   .
      610               end.
      611          end.
      612          when 'чел':U
      613          then do:
      614               find first buf_person no-lock
      615                    where buf_person.psn-code = buf_clients.obj-code
      616               .
      617               if available buf_person
      618               then do:
      619                   run fmtcli-concatenate-strings in this-procedure (
      620                         input ( if buf_person.ind = 0 or buf_person.ind = ?
      621                                 then "":U
      622                                 else string( buf_person.ind, "999999")
      623                                 )
      624                       , input buf_person.city
      625                       , input ", ":U
      626                       , input 0
      627                       , output v-fmtcli-full-addres
      628                   ).
      629                   assign
      630                       v-fmtcli-addres = buf_person.address
      631                   .
      632                   run fmtcli-concatenate-strings in this-procedure (
      633                         input v-fmtcli-full-addres
      634                       , input v-fmtcli-addres
      635                       , input ", ":U
      636                       , input 0
      637                       , output v-fmtcli-full-addres
      638                   ).
      639                   assign
      640                       v-fmtcli-phone     = buf_person.phone1
      641                       v-fmtcli-inn       = buf_person.inn
      642                       v-fmtcli-kpp       = buf_person.kpp
      643                       v-fmtcli-okpo      = buf_person.okpo
      644                       v-fmtcli-city      = buf_person.city
      645                       v-fmtcli-index     = string( buf_person.ind )
      646                   .
      647               end.
      648          end.
      649       end case.
      650   end.
      651   end procedure.
      652   procedure fmtcli-concatenate-strings :
      653   define input parameter p-string-1       as character        no-undo.
      654   define input parameter p-string-2       as character        no-undo.
      655   define input parameter p-delimiter      as character        no-undo.
      656   define input parameter p-length         as integer          no-undo.
      657   define output parameter p-out-string    as character        no-undo.
      658   do
      659   on error undo, return error
      660   :
      661       assign
      662           p-out-string = ( if p-string-1 = ?
      663                            then "":U
      664                            else trim( p-string-1 ) )
      665       .
      666       assign
      667           p-out-string = p-out-string
      668                        + ( if p-out-string = "":U
      669                            or length( p-out-string ) = p-length
      670                            or p-string-2 = ?
      671                            or trim( p-string-2 ) = "":U
      672                            then "":U
      673                            else p-delimiter )
      674                        + ( if p-string-2 = ?
      675                            or trim( p-string-2 ) = "":U
      676                            then "":U
      677                            else trim( p-string-2 ) )
      678       .
      679   end.
      680   end procedure.
