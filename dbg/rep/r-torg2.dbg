     1491   procedure torgconf-get-self-param :
     1492   define input parameter p-obj-type           as character        no-undo.
     1493   define input parameter p-obj-code           as integer          no-undo.
     1494   define input parameter p-curr-code          as integer          no-undo.
     1495       define variable v-host-code    as integer      no-undo.
     1496       define variable v-par-type     as character    no-undo.
     1497   do
     1498   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message(1))
     1499   :
     1500   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1501   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1502     (input  p-obj-type
     1503     ,input  p-obj-code
     1504     ,output v-host-code
     1505     )  .
     1506       if v-torgconf-outhold = yes
     1507       then do:
     1508           run torgconf-get-holdfirm-code in this-procedure (
     1509                 input p-obj-type
     1510               , input p-obj-code
     1511               , output v-torgconf-self-host-code
     1512           ).
     1513           if v-torgconf-self-host-code = 0
     1514           then do:
     1515               return error.
     1516           end.
     1517       end.
     1518       else do:
     1519           assign
     1520               v-torgconf-self-host-code = v-host-code
     1521           .
     1522       end.
     1523       if v-torgconf-self-host-code = 0
     1524       then do:
     1525           assign
     1526               v-torgconf-self-host-name           = "":U
     1527               v-torgconf-self-host-addres         = "":U
     1528               v-torgconf-self-host-post-addres    = "":U
     1529               v-torgconf-self-host-phone          = "":U
     1530               v-torgconf-self-host-inn            = "":U
     1531               v-torgconf-self-host-kpp            = "":U
     1532               v-torgconf-self-host-okpo           = "":U
     1533               v-torgconf-self-host-egrip-date     = "":U
     1534               v-torgconf-self-host-egrip-num      = "":U
     1535           .
     1536       end.
     1537       else do:
     1538           run fmtcli-get-client in this-procedure (
     1539                 input 'орг':U
     1540               , input v-torgconf-self-host-code
     1541           ).
     1542           assign
     1543               v-torgconf-self-host-name        = v-fmtcli-name
     1544               v-torgconf-self-host-engl-name   = v-fmtcli-engl-name
     1545               v-torgconf-self-host-addres      = v-fmtcli-full-addres
     1546               v-torgconf-self-host-post-addres = v-fmtcli-post-addres
     1547               v-torgconf-self-host-phone       = v-fmtcli-phone
     1548               v-torgconf-self-host-inn         = v-fmtcli-inn
     1549               v-torgconf-self-host-kpp         = v-fmtcli-kpp
     1550               v-torgconf-self-host-okpo        = v-fmtcli-okpo
     1551           .
     1552           run gbl/clntat-v.p (
     1553                 input 'орг':U
     1554               , input v-torgconf-self-host-code
     1555               , input 'egrip-date':U
     1556               , output v-torgconf-self-host-egrip-date
     1557               , output v-par-type
     1558           ).
     1559           run gbl/clntat-v.p (
     1560                 input 'орг':U
     1561               , input v-torgconf-self-host-code
     1562               , input 'egrip-num':U
     1563               , output v-torgconf-self-host-egrip-num
     1564               , output v-par-type
     1565           ).
     1566           run fmtcli-get-bank in this-procedure (
     1567                 input v-host-code
     1568               , input 'орг':U
     1569               , input v-torgconf-self-host-code
     1570               , input p-curr-code
     1571           ).
     1572       end.
     1573       assign
     1574           v-torgconf-self-schet-exists = v-fmtcli-schet-exists
     1575           v-torgconf-self-bank-exists  = v-fmtcli-bank-exists
     1576           v-torgconf-self-bank-r-schet = v-fmtcli-bank-r-schet
     1577           v-torgconf-self-bank-c-schet = v-fmtcli-bank-c-schet
     1578           v-torgconf-self-bank-bik     = v-fmtcli-bank-bik
     1579           v-torgconf-self-bank-name    = v-fmtcli-bank-name
     1580           v-torgconf-self-bank-addres  = v-fmtcli-bank-addres
     1581           v-torgconf-self-bank-city    = v-fmtcli-bank-city
     1582       .
     1583       assign
     1584           v-torgconf-self-obj-type = p-obj-type
     1585           v-torgconf-self-obj-code = p-obj-code
     1586       .
     1587       run fmtcli-get-client in this-procedure (
     1588             input p-obj-type
     1589           , input p-obj-code
     1590       ).
     1591       assign
     1592           v-torgconf-self-obj-name       = v-fmtcli-name
     1593           v-torgconf-self-obj-engl-name  = v-fmtcli-engl-name
     1594           v-torgconf-self-obj-addres     = v-fmtcli-full-addres
     1595           v-torgconf-temp-post-addres    = v-fmtcli-post-addres
     1596           v-torgconf-self-obj-phone      = v-fmtcli-phone
     1597           v-torgconf-self-obj-inn        = v-fmtcli-inn
     1598           v-torgconf-self-obj-okpo       = v-fmtcli-okpo
     1599       .
     1600   end.
     1601   end procedure.
     1602   procedure torgconf-get-recepient-param :
     1603   define input parameter torgconfdoc-code   as character                  no-undo.
     1604   define output parameter v-code-rec        as integer                    no-undo .
     1605   define output parameter v-type-rec        as character                  no-undo initial 'C':U.
     1606   define output parameter v-codefirm-rec    as integer                    no-undo .
     1607   define output parameter v-curcode-rec     as integer                    no-undo .
     1608        define variable  v-recipient-code  as character                  no-undo .
     1609        define variable  v-recipient       like ub.doc-attr.attr-value   no-undo.
     1610        define variable  v-trdcattr-type   as character                  no-undo initial 'C':U.
     1611   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input torgconfdoc-code ,
     1612                           input 'Recipient':U ,
     1613                          output v-recipient-code ,
     1614                          output v-trdcattr-type ) no-error .
     1615       if error-status :error then do:
     1616        message
     1617         vss-workfile vss-revision vss-description skip
     1618         "Ошибка при вызове процедуры tdat-val":U skip
     1619         "Документ: " torgconfdoc-code skip
     1620         "Атрибут: " 'Recipient':U skip
     1621         "Значение: " v-recipient skip
     1622         trim( error-status :get-message (1) ) skip
     1623         return-value skip
     1624         view-as alert-box error.
     1625       undo, return error return-value.
     1626       end.
     1627     assign
     1628       v-recipient  = v-recipient-code
     1629       v-type-rec = substring(v-recipient-code,1,3)
     1630       v-code-rec  = int(substring(v-recipient-code,4,15))
     1631       no-error
     1632     .
     1633     if v-type-rec = ? then v-type-rec = "" .
     1634     if v-code-rec  = ? then v-code-rec  =  0 .
     1635     end procedure.
