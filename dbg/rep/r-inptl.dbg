     1262   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1263   define new global shared variable g#lib-calc as handle no-undo .
     1264   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1265   define variable v-waitfram-action01         as character   no-undo .
     1266   define variable v-waitfram-action02         as character   no-undo .
     1267   define variable v-waitfram-action03         as character   no-undo .
     1268   define variable mWaitFramTextBeg            as character   no-undo.
     1269   define variable mWaitFramTextEnd            as character   no-undo.
     1270   define variable mWaitFramView               as logical     no-undo.
     1271   define variable mWaitProcEvent              as logical     no-undo init yes.
     1272   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1273   define variable mWaitFramStop               as logical     no-undo.
     1274   define variable mWaitFramStopUser           as logical     no-undo.
     1275   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1276   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1277   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1278   define button B-WaitFramStop auto-end-key
     1279        label "Стоп"
     1280        size 10 by 1 tooltip "Остоновить процесс".
     1281   define button B-viewProcInfo
     1282        label "Информация"
     1283        size 15 by 1 tooltip "Информация о процесс".
     1284   define frame waitfram
     1285     v-waitfram-action01 format "x(72)" no-label skip
     1286     v-waitfram-action02 format "x(72)" no-label skip
     1287     v-waitfram-action03 format "x(72)" no-label skip
     1288     B-viewProcInfo
     1289     B-WaitFramStop at row 4 col 30
     1290     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1291     .
     1292   define new global shared variable mBatchMode as logical no-undo init ?.
     1293   define variable mFramBachModHandle as handle no-undo.
     1294   mFramBachModHandle = frame waitfram:handle.
     1295   define variable mFameOldVis as logical no-undo.
     1296   define variable mVisCUrentVin as logical no-undo.
     1297   if session:batch-mode
     1298   then
     1299      mBatchMode = yes.
     1300   if mBatchMode = ? then do:
     1301     mVisCUrentVin = current-window:visible.
     1302     mFameOldVis = mFramBachModHandle:visible.
     1303     mFramBachModHandle:visible  = yes.
     1304     mBatchMode = mFramBachModHandle:visible ne yes.
     1305     mFramBachModHandle:visible = mFameOldVis.
     1306     current-window:visible = mVisCUrentVin.
     1307   end.
     1308    if  log-manager:logfile-name ne ?
     1309     then DO:
     1310         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1311         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1312         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1313     end.
     1314   on choose of B-WaitFramStop in frame waitfram
     1315   do:
     1316     mWaitFramStop = yes.
     1317     mWaitFramStopUser = yes.
     1318   end.
     1319   function waitfram-check-timeout returns logical():
     1320      define variable vtime as int64 no-undo.
     1321      if mWaitFramStopTimeOut
     1322      then
     1323         return yes.
     1324      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1325      if     mWaitFramTimeOut ne ?
     1326         and mWaitFramTimeOut ne 0
     1327         and mWaitFramTimeOut lt vtime
     1328      then do:
     1329         mWaitFramStopTimeOut = yes.
     1330      end.
     1331      return mWaitFramStopTimeOut.
     1332   end.
     1333   procedure waitfram-hide :
     1334     if not session:batch-mode
     1335     then do
     1336     on error undo, return error return-value
     1337     :
     1338       pause 0 before-hide .
     1339       if not mBatchMode then
     1340         hide frame waitfram .
     1341     if     not mWaitFramView
     1342        and mWaitProcEvent
     1343     then
     1344       process events .
     1345     end.
     1346   end procedure.
     1347   procedure waitfram-show :
     1348     define input  parameter p-message as character no-undo .
     1349     define variable v-left-margin as integer   no-undo .
     1350     if not session:batch-mode
     1351     then do
     1352     on error undo, return error return-value
     1353     :
     1354       if length(p-message) <= 70 then do:
     1355         assign
     1356           v-left-margin = integer((70 - length(p-message)) / 2)
     1357         .
     1358         assign
     1359           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1360         .
     1361         assign
     1362           v-waitfram-action01 = " "
     1363           v-waitfram-action02 = " "
     1364                                    + fill(" ", v-left-margin)
     1365                                    + p-message
     1366           v-waitfram-action03 = " "
     1367         .
     1368       end.
     1369       else do:
     1370         define variable vRindex1 as integer no-undo.
     1371         define variable vRindex2 as integer no-undo.
     1372         vRindex1 = r-index(p-message," ",70).
     1373         if vRindex1 = 0
     1374         then
     1375            vRindex1 = 70.
     1376         if length(p-message)  <= vRindex1 + 70 then do:
     1377           assign
     1378             v-waitfram-action01 = " "
     1379             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1380             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1381           .
     1382         end.
     1383         else do:
     1384           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1385           if vRindex2 <= vRindex1
     1386           then
     1387              vRindex2 = vRindex1 + 70.
     1388           assign
     1389             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1390             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1391             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1392           .
     1393         end.
     1394       end.
     1395       B-viewProcInfo:visible   in frame waitfram = no.
     1396       B-viewProcInfo:sensitive in frame waitfram = no.
     1397       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1398       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1399       if  (   mWaitFramView
     1400          or  mWaitProcEvent)
     1401          and not mBatchMode
     1402       then
     1403          display
     1404             v-waitfram-action01 skip
     1405             v-waitfram-action02 skip
     1406             v-waitfram-action03 skip
     1407          with frame waitfram .
     1408       if     mWaitFramView
     1409          then do:
     1410             if     mWaitFramInterval ne ?
     1411                and not mBatchMode
     1412             then
     1413                wait-for go of frame waitfram pause mWaitFramInterval.
     1414          end.
     1415          else
     1416             if     mWaitProcEvent
     1417                and not mBatchMode
     1418             then
     1419                process events .
     1420     end.
     1421   end procedure.
     1422      procedure waitfram-show-this:
     1423         define input  parameter iInterval as int64 no-undo.
     1424         define variable vtime as int64 no-undo.
     1425         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1426         mWaitFramInterval = iInterval.
     1427         run waitfram-show (substitute("&1&2 &3&4" ,
     1428                                       mWaitFramTextBeg ,
     1429                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1430                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1431                                       mWaitFramTextEnd
     1432                                      )
     1433                           ).
     1434      end.
     1435      procedure WaitFramRunPause:
     1436         define input  parameter iInterval as dec no-undo.
     1437         define variable vStart  as datetime-tz no-undo.
     1438         define variable vend    as datetime-tz no-undo.
     1439         define variable vint as int64 no-undo.
     1440         define variable vOk as logical no-undo.
     1441         vStart = now.
     1442         vend   = vStart.
     1443         publish "WaitFramPause" (iInterval,output vOk).
     1444         vend   =  now.
     1445         vint = vend - vStart.
     1446         vint = iInterval - vint / 1000.
     1447         if     not mWaitFramStop
     1448            and (   vint > 0
     1449                 or (    not vOk
     1450                     and iInterval eq ?
     1451                     )
     1452                 )
     1453         then
     1454            run waitfram-show-this (iInterval).
     1455         vend   =  now.
     1456         vint = vend - vStart.
     1457         vint = iInterval - vint / 1000.
     1458         if     not mWaitFramStop
     1459            and vint > 0
     1460         then do:
     1461            run gbl/pause.p (vint * 1000).
     1462         end.
     1463         if iInterval ne ?
     1464         then
     1465            publish "WaitFramStop".
     1466         waitfram-check-timeout().
     1467      end.
     1468      procedure WaitFramWaitFor:
     1469         define input  parameter iInterval as dec no-undo.
     1470         assign
     1471            mWaitFramStartProc   = now
     1472            mWaitFramStopUser    = no
     1473            mWaitFramStopTimeOut = no
     1474         .
     1475         block-wait:
     1476         do while not mWaitFramStop:
     1477            run WaitFramRunPause (iInterval).
     1478            if  waitfram-check-timeout()
     1479            then do:
     1480               leave block-wait.
     1481            end.
     1482         end.
     1483         run waitfram-hide.
     1484      end.
     1485   procedure waitfram-join :
     1486     define input  parameter p-line-1  as character no-undo .
     1487     define input  parameter p-line-2  as character no-undo .
     1488     define input  parameter p-line-3  as character no-undo .
     1489     define output parameter p-message as character no-undo .
     1490     do
     1491     on error undo, return error return-value
     1492     :
     1493       assign
     1494         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1495                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1496                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1497       .
     1498     end.
     1499   end procedure.
     1500   function waitfram-join-function returns character
     1501     (input p-line-1 as character
     1502     ,input p-line-2 as character
     1503     ,input p-line-3 as character
     1504     ).
     1505     define variable v-message as character no-undo .
     1506     run waitfram-join in this-procedure
     1507       (input  p-line-1
     1508       ,input  p-line-2
     1509       ,input  p-line-3
     1510       ,output v-message
     1511       ) .
     1512     return v-message .
     1513   end function .
     1514   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1515   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1516   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
     1517   define variable ptrlprop-denstclc      as character no-undo initial 'shft_rvs-inc':U .
     1518   define variable ptrlprop-inpptrl       as character no-undo initial 'weight':U .
     1519   define variable ptrlprop-expptrl       as character no-undo initial 'volume':U .
     1520   define variable ptrlprop-autopump      as logical   no-undo initial false .
     1521   define variable ptrlprop-avtinvpm      as logical   no-undo initial false .
     1522   define variable ptrlprop-rvsnmter      as logical   no-undo initial false .
     1523   define variable ptrlprop-olddens       as logical   no-undo initial false .
     1524   define variable ptrlprop-invclipt      as integer   no-undo initial ? .
     1525   define variable ptrlprop-algrvspt      as integer   no-undo initial 1 .
     1526   define variable ptrlprop-temp-for-pomi as integer   no-undo initial 1 .
     1527   define variable ptrlprop-algoincome as integer no-undo init 0.
     1528   define variable ptrlprop-mand-choice-autocar as logical no-undo init false.
     1529   define variable ptrlprop-Delta-mass-horiz      as character no-undo .
     1530   define variable ptrlprop-Delta-mass-vert       as character no-undo .
     1531   define variable ptrlprop-calc-free-vol as logical no-undo init false.
     1532   define variable ptrlprop-calc-free-vol-sug as logical no-undo init false.
     1533   define variable ptrlprop-trn-reas-sug as logical no-undo init true.
     1534   define variable ptrlprop-rvd-own-nb as logical no-undo init false.
     1535   define variable ptrlprop-qr-scan-time as integer no-undo init 5000 .
     1536   define variable ptrlprop-block-nozzle as logical no-undo init false.
     1537   define variable ptrlprop-timeout-block-nozzle as integer no-undo init 5 .
     1538   define variable ptrlprop-autopump-skip-time as integer no-undo init 0 .
     1539   procedure get-ptrl-prop :
     1540     define input  parameter p-obj-type as character no-undo .
     1541     define input  parameter p-obj-code as integer   no-undo .
     1542     do
     1543     on error  undo, return error substitute( "&1 (get-ptrl-prop). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1544     on stop   undo, return error substitute( "&1 (get-ptrl-prop). stop", vss-workfile )
     1545     on endkey undo, return error substitute( "&1 (get-ptrl-prop). endkey", vss-workfile )
     1546     :
     1547       define variable par-type          as character no-undo.
     1548       define variable v-value-character as character no-undo .
     1549       define variable v-value-date      as date      no-undo .
     1550       define variable v-value-decimal   as decimal   no-undo .
     1551       define variable v-value-integer   as integer   no-undo .
     1552       define variable v-value-logical   as logical   no-undo .
     1553       for each thbjattr_thbj-attr
     1554       :
     1555         delete thbjattr_thbj-attr .
     1556       end.
     1557       run adm/shattri.p
     1558         ( input "get":U
     1559         , input p-obj-type
     1560         , input p-obj-code
     1561         , input 'petrol':U
     1562         , input  ""
     1563         , output v-value-character
     1564         , output v-value-date
     1565         , output v-value-decimal
     1566         , output v-value-integer
     1567         , output v-value-logical
     1568         , output par-type
     1569         , input-output table thbjattr_thbj-attr
     1570         ) no-error .
     1571       for each thbjattr_thbj-attr
     1572       on error undo, return error return-value
     1573       :
     1574         case thbjattr_thbj-attr.prop-code :
     1575           when 'denstclc':U then do:
     1576             if thbjattr_thbj-attr.prop-value-type = 'character':U then do:
     1577               assign
     1578                 ptrlprop-denstclc = thbjattr_thbj-attr.property-value-character
     1579               .
     1580             end.
     1581           end.
     1582           when 'expptrl':U then do:
     1583             if lookup( thbjattr_thbj-attr.property-value-character, 'volume,weight,volume+,weight+':U ) > 0
     1584               and thbjattr_thbj-attr.prop-value-type = 'character':U
     1585             then do:
     1586               assign
     1587                 ptrlprop-expptrl = thbjattr_thbj-attr.property-value-character
     1588               .
     1589             end.
     1590           end.
     1591           when 'inpptrl':U then do:
     1592             if lookup( thbjattr_thbj-attr.property-value-character, 'volume,weight,volume+,weight+':U ) > 0
     1593               and thbjattr_thbj-attr.prop-value-type = 'character':U
     1594             then do:
     1595               assign
     1596                 ptrlprop-inpptrl = thbjattr_thbj-attr.property-value-character
     1597               .
     1598             end.
     1599           end.
     1600           when 'autopump':U then do:
     1601             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
     1602               assign
     1603                 ptrlprop-autopump = thbjattr_thbj-attr.property-value-logical
     1604               .
     1605             end.
     1606           end.
     1607           when 'rvsnmter':U then do:
     1608             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
     1609               assign
     1610                 ptrlprop-rvsnmter = thbjattr_thbj-attr.property-value-logical
     1611               .
     1612             end.
     1613           end.
     1614           when 'avtinvpm':U then do:
     1615             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
     1616               assign
     1617                 ptrlprop-avtinvpm = thbjattr_thbj-attr.property-value-logical
     1618               .
     1619             end.
     1620           end.
     1621           when 'invclipt':U then do:
     1622             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
     1623               assign
     1624                 ptrlprop-invclipt = thbjattr_thbj-attr.property-value-integer
     1625               .
     1626             end.
     1627           end.
     1628           when 'olddens':U then do:
     1629             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
     1630               assign
     1631                 ptrlprop-olddens = thbjattr_thbj-attr.property-value-logical
     1632               .
     1633             end.
     1634           end.
     1635           when 'algrvspt':U then do:
     1636             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
     1637               assign
     1638                 ptrlprop-algrvspt = thbjattr_thbj-attr.property-value-integer
     1639               .
     1640             end.
     1641           end.
     1642           when 'temp-for-pomi':U then do:
     1643             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
     1644               assign
     1645                 ptrlprop-temp-for-pomi = thbjattr_thbj-attr.property-value-integer
     1646               .
     1647             end.
     1648           end.
     1649           when 'algoincome':U then do:
     1650             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
     1651               assign
     1652                 ptrlprop-algoincome = thbjattr_thbj-attr.property-value-integer
     1653               .
     1654             end.
     1655           end.
     1656           when 'mand-choice-autocar':U then do:
     1657             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
     1658               assign
     1659                 ptrlprop-mand-choice-autocar = thbjattr_thbj-attr.property-value-logical
     1660               .
     1661             end.
     1662           end.
     1663           when 'block-nozzle':U then do:
     1664             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
     1665               assign
     1666                 ptrlprop-block-nozzle = thbjattr_thbj-attr.property-value-logical
     1667               .
     1668             end.
     1669           end.
     1670           when 'timeout-block-nozzle':U then do:
     1671             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
     1672               assign
     1673                 ptrlprop-timeout-block-nozzle = thbjattr_thbj-attr.property-value-integer
     1674               .
     1675             end.
     1676           end.
     1677           when 'Delta-mass-horiz':U then do:
     1678             if thbjattr_thbj-attr.prop-value-type = 'character':U then do:
     1679               assign
     1680                 ptrlprop-Delta-mass-horiz = thbjattr_thbj-attr.property-value-character
     1681               .
     1682             end.
     1683           end.
     1684           when 'Delta-mass-vert':U then do:
     1685             if thbjattr_thbj-attr.prop-value-type = 'character':U then do:
     1686               assign
     1687                 ptrlprop-Delta-mass-vert = thbjattr_thbj-attr.property-value-character
     1688               .
     1689             end.
     1690           end.
     1691           when 'calc-free-vol':U then do:
     1692             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
     1693               assign
     1694                 ptrlprop-calc-free-vol = thbjattr_thbj-attr.property-value-logical
     1695               .
     1696             end.
     1697           end.
     1698           when 'calc-free-vol-sug':U then do:
     1699             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
     1700               assign
     1701                 ptrlprop-calc-free-vol-sug = thbjattr_thbj-attr.property-value-logical
     1702               .
     1703             end.
     1704           end.
     1705           when 'trn-reas-sug':U then do:
     1706             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
     1707               assign
     1708                 ptrlprop-trn-reas-sug = thbjattr_thbj-attr.property-value-logical
     1709               .
     1710             end.
     1711           end.
     1712                 when 'rvd-own-nb':U then do:
     1713             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
     1714               assign
     1715                 ptrlprop-rvd-own-nb = thbjattr_thbj-attr.property-value-logical
     1716               .
     1717             end.
     1718           end.
     1719           when 'qr-scan-time':U then do:
     1720             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
     1721               assign
     1722                 ptrlprop-qr-scan-time = thbjattr_thbj-attr.property-value-integer
     1723               .
     1724             end.
     1725           end.
     1726           when 'autopump-skip-time':U then do:
     1727             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
     1728               assign
     1729                 ptrlprop-autopump-skip-time = thbjattr_thbj-attr.property-value-integer
     1730               .
     1731             end.
     1732           end.
     1733         end case.
     1734         delete thbjattr_thbj-attr .
     1735       end.
     1736     end.
     1737     return .
     1738   end procedure.
