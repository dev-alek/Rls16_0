     2263     end.
     2264     find first car-num-attr no-lock
     2265       where car-num-attr.doc-code  = ub.doc-line.doc-code
     2266         and car-num-attr.attr-code = 'car-num':U
     2267       no-error .
     2268     find first car-vol-attr no-lock
     2269       where car-vol-attr.doc-code  = ub.doc-line.doc-code
     2270         and car-vol-attr.gds-code  = gds-list.gds-code
     2271         and car-vol-attr.attr-code = "car-vol":U
     2272       no-error .
     2273     find first tests-attr no-lock
     2274       where tests-attr.doc-code    = ub.doc-line.doc-code
     2275         and tests-attr.gds-code    = gds-list.gds-code
     2276         and tests-attr.attr-code   = "tests":U
     2277       no-error .
     2278     find first doc-line-attr no-lock
     2279          where doc-line-attr.doc-code  = ub.doc-line.doc-code
     2280            and doc-line-attr.gds-code  = gds-list.gds-code
     2281            and doc-line-attr.attr-code = "n":U no-error .
     2282     if available doc-line-attr then
     2283       v-num-sections = integer (doc-line-attr.attr-value) no-error .
     2284     else v-num-sections = 1 .
     2285     v-temperature = ? .
     2286     for each doc-line-attr no-lock
     2287        where doc-line-attr.doc-code  = ub.doc-line.doc-code
     2288          and doc-line-attr.gds-code  = gds-list.gds-code :
     2289       if entry(1, doc-line-attr.attr-code, chr(4)) = "ttn-temp":U then do :
     2290         if num-entries (doc-line-attr.attr-code, chr(4)) > 1 then do :
     2291           v-n-section = integer (  entry(2, doc-line-attr.attr-code, chr(4))  ) no-error .
     2292           if v-n-section = 1 then do :
     2293             v-temperature = decimal (doc-line-attr.attr-value) no-error .
     2294             leave .
     2295           end .
     2296         end .
     2297         else do :
     2298           v-temperature = decimal (doc-line-attr.attr-value) no-error .
     2299           leave .
     2300         end .
     2301       end .
     2302     end .
     2303     find first bef-rvs-doc no-lock
     2304       where bef-rvs-doc.out-code   = ub.trn-doc.doc-code
     2305         and bef-rvs-doc.rvs-type   = 'перед_док':U
     2306       no-error .
     2307     find first aft-rvs-doc no-lock
     2308       where aft-rvs-doc.out-code   = ub.trn-doc.doc-code
     2309         and aft-rvs-doc.rvs-type   = 'после_док':U
     2310       no-error .
     2311     for each ub.doc-pl no-lock
     2312       where ub.doc-pl.out-code = ub.doc-line.doc-code
     2313         and ub.doc-pl.gds-code = gds-list.gds-code
     2314     on error undo, return error return-value
     2315     :
     2316       if available bef-rvs-doc then do:
     2317         find first bef-rvs-line no-lock
     2318           where bef-rvs-line.rvs-code = bef-rvs-doc.rvs-code
     2319             and bef-rvs-line.obj-type = bef-rvs-doc.obj-type
     2320             and bef-rvs-line.obj-code = bef-rvs-doc.obj-code
     2321             and bef-rvs-line.pl-code  = ub.doc-pl.pl-code
     2322             and bef-rvs-line.gds-code = gds-list.gds-code
     2323           no-error .
     2324       end.
     2325       if available aft-rvs-doc then do:
     2326         find first aft-rvs-line no-lock
     2327           where aft-rvs-line.rvs-code = aft-rvs-doc.rvs-code
     2328             and aft-rvs-line.obj-type = aft-rvs-doc.obj-type
     2329             and aft-rvs-line.obj-code = aft-rvs-doc.obj-code
     2330             and aft-rvs-line.pl-code  = ub.doc-pl.pl-code
     2331             and aft-rvs-line.gds-code = gds-list.gds-code
     2332           no-error .
     2333       end.
     2334       assign
     2335         v-ind = v-ind + 1
     2336       .
     2337       run waitfram-show in this-procedure
     2338         ( input "Печать журнала поступивших нефтепродуктов за период. Обработано строк: "
     2339               + trim( string( v-ind, "->,>>>,>>>,>>9":U ) ) + "..."
     2340         ) .
     2341       assign
     2342         varshift-id   = ( if x-radio-task <= 2 then string( ub.trn-doc.fact-date  )
     2343                                                 else string( ub.trn-doc.shift-name ) ) + ":" +
     2344                                                     string( ub.trn-doc.shift-date )
     2345         v-doc-qnty    = ub.doc-pl.doc-qnty
     2346         v-fact-qnty   = ub.doc-pl.fact-qnty
     2347         varinaccuracy = ub.doc-pl.doc-qnty * v-pogresh
     2348         varmeasure    = ( if available bef-rvs-line and
     2349                             available aft-rvs-line
     2350                           then ( aft-rvs-line.measure-qnty - bef-rvs-line.measure-qnty )
     2351                           else ? )
     2352         vardifference = varmeasure - ub.doc-pl.doc-qnty
     2353         v-tot-doc-qnty   = v-tot-doc-qnty   + v-doc-qnty
     2354         v-tot-fact-qnty  = v-tot-fact-qnty  + v-fact-qnty
     2355         v-tot-measure    = v-tot-measure    + varmeasure
     2356         v-tot-difference = v-tot-difference + vardifference
     2357       .
     2358   define variable vss-include-info19 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2359   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrnick in g#library
     2360     (input  ub.trn-doc.creid
     2361     ,output v-oper-name
     2362     )  .
     2363       display stream PrnLibStream
     2364         sym1  varshift-id
     2365         sym2  v-oper-name
     2366         sym3  ub.trn-doc.doc-code
     2367         sym4  ( if available car-num-attr then          car-num-attr.attr-value   else ? ) @ car-num-attr.attr-value
     2368         sym5  ( if available car-vol-attr then decimal( car-vol-attr.attr-value ) else ? ) @ varvol-attr
     2369         sym6  v-doc-qnty
     2370         sym7  ub.doc-pl.pl-code
     2371         sym8  ( if available bef-rvs-line then bef-rvs-line.state-level-petrol    else ? ) @ bef-rvs-line.state-level-petrol
     2372         sym9  ( if available aft-rvs-line then aft-rvs-line.state-level-petrol    else ? ) @ aft-rvs-line.state-level-petrol
     2373         sym10 v-fact-qnty
     2374         sym11 varmeasure
     2375         sym12 varinaccuracy
     2376         sym13 vardifference
     2377         sym14 ( if available tests-attr   then tests-attr.attr-value              else ? ) @ tests-attr.attr-value
     2378         sym15 ub.doc-line.fact-density
     2379         sym16 v-temperature @ ub.doc-line.temperature
     2380         sym17
     2381         sym18
     2382       with frame doc-line-frm .
     2383       down stream PrnLibStream 1 with frame doc-line-frm .
     2384     end.
     2385   end.
     2386   if v-ind > 0 then do:
     2387     put stream PrnLibStream unformatted v-line skip .
     2388   end.
     2389   display stream PrnLibStream
     2390     "ИТОГО"          @ varshift-id
     2391     "ЗА"             @ v-oper-name
     2392     "ПЕРИОД"         @ ub.trn-doc.doc-code
     2393     v-tot-doc-qnty   @ v-doc-qnty
     2394     v-tot-fact-qnty  @ v-fact-qnty
     2395     v-tot-measure    @ varmeasure
     2396     v-tot-difference @ vardifference
     2397     with frame doc-line-frm .
     2398   down stream PrnLibStream 1 with frame doc-line-frm .
     2399       end.
     2400     end.
     2401     put  stream PrnLibStream unformatted skip( 2 ) "   Управляющий АЗС___________________________" skip .
     2402   end.
     2403   hide stream PrnLibStream frame bottomframe .
     2404   output stream PrnLibStream close .
     2405   run waitfram-hide in this-procedure .
     2406   run prn-lib-prn-file in this-procedure
     2407     ( input my-handle
     2408     , input 8
     2409     ) .
