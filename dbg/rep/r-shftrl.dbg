     1813       define  variable road-tax-rubl-sale          like ub.doc-line.road-tax   no-undo.
     1814       define  variable excise-base-sale            like ub.doc-line.price-base no-undo.
     1815       define  variable excise-rubl-sale            like ub.doc-line.price-rubl no-undo.
     1816       define  variable discnt-base-sale            like ub.gds-dtl.discnt-base no-undo.
     1817       define  variable discnt-rubl-sale            like ub.gds-dtl.discnt-rubl no-undo.
     1818       define buffer out-vatp_gds-dtl     for ub.gds-dtl.
     1819       define buffer buf_out-vatp_gds-dtl for ub.gds-dtl.
     1820       define buffer out-vatp_parts       for ub.parts.
     1821       define buffer out-vatp_sysconf     for ub.sysconf.
     1822       define buffer out-vatp_doc-line    for ub.doc-line.
     1823       define buffer out-vatp_goods       for ub.goods.
     1824       define buffer out-vatp_trn-doc     for ub.trn-doc.
     1825       define buffer out-vatp_doc-attr    for ub.doc-attr.
     1826       define variable varprice-base-cons      like ub.doc-line.price-base initial 0.00 no-undo.
     1827       define variable varprice-rubl-cons      like ub.doc-line.price-rubl initial 0.00 no-undo.
     1828       define variable varfrm-cnsv-type         as   character                           no-undo.
     1829       define variable varfrm-cnsv              as   character                           no-undo.
