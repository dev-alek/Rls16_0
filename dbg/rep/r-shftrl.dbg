     1854       define variable varcons-qnty             like ub.parts.fact-qnty                  no-undo.
     1855       define variable varis-one-gds-dtl        as   logical                             no-undo.
     1856       define variable varcurprice-base         like ub.gds-dtl.cur-base                 no-undo.
     1857       define variable varcurprice-rubl         like ub.gds-dtl.price-base               no-undo.
     1858       define variable varcurdiscnt-base        like ub.gds-dtl.cur-base                 no-undo.
     1859       define variable varcurdiscnt-rubl        like ub.gds-dtl.price-base               no-undo.
     1860       define variable varoutvprb               as   character                           no-undo.
     1861       define variable out-vatp-have-vat-slt    as   logical initial yes                 no-undo.
     1862       define buffer   in-vatp-trn-doco  for ub.trn-doc .
     1863       define buffer   in-vatp-partso    for ub.parts   .
     1864       define buffer   in-vatp-doco      for ub.trn-doc .
     1865       define buffer   in-vatp-goodso    for ub.goods   .
     1866       define buffer   in-vatp-sysconfo  for ub.sysconf .
     1867       define buffer   in-vatp_doc-attro for ub.doc-attr.
     1868       define variable in-vatp-have-vat-slto       as   logical initial yes    no-undo.
     1869       define variable vat-pc-loco                 like ub.doc-line.vat-pc     no-undo.
     1870       define variable varinvprbo                  as   character              no-undo.
     1871       define variable slt-pc-loco                 like ub.doc-line.slt-pc     no-undo.
     1872       define variable cli-base-rateo              as   decimal                no-undo.
     1873       define variable price-rubl-with-tax-loco    like ub.doc-line.price-rubl no-undo.
     1874       define variable price-base-with-tax-loco    like ub.doc-line.price-base no-undo.
     1875       define variable price-cli-with-tax-loco     like ub.doc-line.price-cli  no-undo.
     1876       define variable price-rubl-without-tax-loco like ub.doc-line.price-rubl no-undo.
     1877       define variable price-base-without-tax-loco like ub.doc-line.price-base no-undo.
     1878       define variable price-cli-without-tax-loco  like ub.doc-line.price-base no-undo.
     1879       define variable vat-base-loco               like ub.doc-line.price-base no-undo.
     1880       define variable vat-rubl-loco               like ub.doc-line.price-rubl no-undo.
     1881       define variable vat-cli-loco                like ub.doc-line.price-rubl no-undo.
     1882       define variable slt-base-loco               like ub.doc-line.price-base no-undo.
     1883       define variable slt-rubl-loco               like ub.doc-line.price-rubl no-undo.
     1884       define variable slt-cli-loco                like ub.doc-line.price-rubl no-undo.
     1885       define variable road-tax-base-loco          like ub.doc-line.road-tax   no-undo.
     1886       define variable road-tax-rubl-loco          like ub.doc-line.road-tax   no-undo.
     1887       define variable road-tax-cli-loco           like ub.doc-line.road-tax   no-undo.
     1888       define variable transport-base-loco         like ub.doc-line.price-base no-undo.
     1889       define variable transport-rubl-loco         like ub.doc-line.price-rubl no-undo.
     1890       define variable transport-cli-loco          like ub.doc-line.price-rubl no-undo.
     1891       define variable other-base-loco             like ub.doc-line.price-base no-undo.
     1892       define variable other-rubl-loco             like ub.doc-line.price-rubl no-undo.
     1893       define variable other-cli-loco              like ub.doc-line.price-rubl no-undo.
     1894       define variable exch-rate-cli-loco          like ub.trn-doc.exch-rate   no-undo.
     1895       define variable varinvatp-envdo             as   character              no-undo.
     1896       define variable varinvatp-typeo             as   character              no-undo.
     1897       define variable v-gds-dtl-fact-qnty as decimal no-undo .
     1898       define buffer buf_gds-dtl  for ub.gds-dtl .
     1899       define buffer buf_goods    for ub.goods .
     1900       define buffer buf_trn-doc  for ub.trn-doc .
     1901       define buffer buf_doc-line for ub.doc-line .
     1902       find first buf_doc-line no-lock
     1903         where buf_doc-line.doc-code  = p-doc-code
     1904           and buf_doc-line.artic     = p-artic
     1905           and buf_doc-line.prod-type = p-prod-type
     1906           and buf_doc-line.prod-code = p-prod-code
     1907         no-error .
     1908       if not available buf_doc-line then do:
     1909         message
     1910           vss-workfile vss-revision vss-description skip
     1911           vss-include-info14 skip
     1912           "Ошибка задания входных параметров" skip
     1913           "Не найдена строка документа" skip
     1914           "Документ" p-doc-code skip
     1915           "Артикул" p-artic p-prod-type p-prod-code skip
     1916           view-as alert-box error .
     1917         undo, return error .
     1918       end.
     1919       find first buf_trn-doc no-lock
     1920         where buf_trn-doc.doc-code = buf_doc-line.doc-code
     1921         no-error .
     1922       if not available buf_trn-doc then do:
     1923         message
     1924           vss-workfile vss-revision vss-description skip
     1925           vss-include-info14 skip
     1926           "Не найден документ" skip
     1927           "Документ" p-doc-code skip
     1928           "Артикул" p-artic p-prod-type p-prod-code skip
     1929           view-as alert-box error .
     1930         undo, return error .
     1931       end.
     1932       for each buf_gds-dtl no-lock
     1933         where buf_gds-dtl.doc-code  = buf_doc-line.doc-code
     1934           and buf_gds-dtl.artic     = buf_doc-line.artic
     1935           and buf_gds-dtl.prod-type = buf_doc-line.prod-type
     1936           and buf_gds-dtl.prod-code = buf_doc-line.prod-code
     1937       on error undo, return error
     1938       :
     1939           if buf_trn-doc.doc-type <> 'инв':U
     1940           then do:
     1941               if buf_trn-doc.doc-type = 'при':U
     1942               or buf_trn-doc.doc-type = 'возврат':U
     1943               then do:
     1944                   assign
     1945                       v-gds-dtl-fact-qnty = buf_gds-dtl.fact-qnty
     1946                   .
     1947               end.
     1948               else do:
     1949                   assign
     1950                       v-gds-dtl-fact-qnty = - buf_gds-dtl.fact-qnty
     1951                   .
     1952               end.
