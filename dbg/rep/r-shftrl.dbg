     2328     assign  Counter1 = 0 .
     2329   define variable v-account as integer init 0 no-undo .
     2330   define variable v-account-lavel as character no-undo .
     2331   define variable v-button-stop as logical no-undo .
     2332   define variable v-kol-spice as integer no-undo .
     2333   define variable v-kol-spice2 as integer no-undo .
     2334   define variable v-kol-spice3 as integer no-undo .
     2335   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     2336   DEFINE BUTTON StopBtn AUTO-END-KEY
     2337        LABEL "Стоп"
     2338        SIZE 10 BY 1.
     2339   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     2340        LABEL "Обработано записей"
     2341         VIEW-AS TEXT
     2342        SIZE 14 BY .67 NO-UNDO.
     2343   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     2344         VIEW-AS TEXT
     2345        SIZE 53.25 BY .67
     2346        FGCOLOR 1  NO-UNDO.
     2347   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     2348         VIEW-AS TEXT
     2349        SIZE 53.25 BY .67
     2350        FGCOLOR 1  NO-UNDO.
     2351   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     2352         VIEW-AS TEXT
     2353        SIZE 53.25 BY .67
     2354        FGCOLOR 1  NO-UNDO.
     2355   DEFINE RECTANGLE RECT-1
     2356        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     2357        SIZE 55.13 BY 4.46.
     2358   DEFINE FRAME InfoFrame
     2359        StopBtn AT ROW 4.25 COL 21.75
     2360        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     2361        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     2362        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     2363        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     2364        RECT-1 AT ROW 1 COL 1
     2365       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     2366            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     2367            TITLE "Процесс"
     2368            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     2369   define variable mFrameView      as logical   no-undo init yes.
     2370     define variable mFramHandle as handle no-undo.
     2371     mFramHandle = frame InfoFrame:handle.
     2372     if  log-manager:logfile-name ne ?
     2373     then DO:
     2374         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     2375         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     2376         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     2377     end.
     2378     mFrameView = not session:batch-mode and mFramHandle:visible.
     2379     if mFrameView
     2380     then do:
     2381       ASSIGN
     2382          FRAME InfoFrame:HIDDEN                           = TRUE
     2383          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     2384     end.
     2385   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     2386   DO:
     2387     IF not StopProcessing THEN
     2388       Message "Вы действительно хотите прервать" SKIP
     2389               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     2390                 UPDATE StopProcessing.
     2391     IF StopProcessing THEN do:
     2392        if mFrameView
     2393        then do:
     2394           HIDE FRAME InfoFrame.
     2395        end.
     2396     End.
     2397   END.
     2398   assign v-account = ( if integer( 1 ) = 0 then 100 else integer( 1 ) ).
     2399     if  log-manager:logfile-name ne ?
     2400     then DO:
     2401         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     2402     end.
     2403     if not session:batch-mode then
     2404     do:
     2405       VIEW FRAME InfoFrame.
     2406       mFrameView = true.
     2407     end.
     2408      v-button-stop = false .
     2409         if mFrameView
     2410         then do:
     2411         if v-button-stop then view STOPBTN in frame InfoFrame.
     2412                          else Hide STOPBTN in frame InfoFrame.
     2413         end.
     2414     find first obj-list
     2415          where obj-list.obj-type = v-cntxt-obj-type
     2416            and obj-list.obj-code = v-cntxt-obj-code
     2417            no-error .
     2418          if available obj-list then do :
     2419              assign v-cntxt-obj-name = obj-list.obj-name .
     2420          end .
     2421     for each obj-list no-lock :
     2422           create temp-shift-obj .
     2423           assign
     2424             temp-shift-obj.v-shift-name = obj-list.obj-name
     2425             v-count-neg                 = v-count-neg + 1
     2426             temp-shift-obj.v-count      = - ( v-count-neg )
     2427             v-str                       = v-str + 1
     2428             temp-shift-obj.v-str        = v-str
     2429             v-sum-all                   = 0
     2430             v-sum-ret-all               = 0
     2431           .
     2432         find first tmp#grp no-error .
     2433         if not available tmp#grp then do:
     2434           message "Не выбраны группы товаров." view-as alert-box error .
     2435           return .
     2436         end.
     2437   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2438   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2439     (input  obj-list.obj-type
     2440     ,input  obj-list.obj-code
     2441     ,output v-host-code
     2442     )  .
     2443         for each tmp#grp :
     2444         run grplib-get-full-name in this-procedure( input tmp#grp.node-code, output CurrGrpName ) .
     2445           for each buf_gds-obj no-lock
     2446             where buf_gds-obj.obj-type = obj-list.obj-type
     2447               and buf_gds-obj.obj-code = obj-list.obj-code
     2448               and buf_gds-obj.grp-name begins CurrGrpName
     2449             use-index obj-grp :
     2450             find first temp-gds
     2451             where temp-gds.prod-code = buf_gds-obj.prod-code
     2452               and temp-gds.prod-type = buf_gds-obj.prod-type
     2453               and temp-gds.artic     = buf_gds-obj.artic
     2454               no-error .
     2455               if not available temp-gds then do :
     2456                 create temp-gds .
     2457                       assign
     2458                   temp-gds.prod-code = buf_gds-obj.prod-code
     2459                   temp-gds.prod-type = buf_gds-obj.prod-type
     2460                   temp-gds.artic     = buf_gds-obj.artic
     2461                 .
     2462               end .
     2463           end.
     2464         end.
     2465         for each buf_shift-obj  no-lock
     2466           where buf_shift-obj.obj-code = obj-list.obj-code
     2467             and buf_shift-obj.obj-type = obj-list.obj-type
     2468         :
     2469           assign v-count = v-count + 1 .
     2470           if buf_shift-obj.shift-date < x-date-Start then next .
     2471           if buf_shift-obj.shift-date = x-date-Start and buf_shift-obj.shift-num < x-Shift-Start then next .
     2472           if buf_shift-obj.shift-date > x-date-End   then next.
     2473           if buf_shift-obj.shift-date = x-date-End   and buf_shift-obj.shift-num > x-Shift-End then leave.
     2474           assign Counter1 = Counter1 + 1.
     2475   IF ( Counter1 modulo v-account = 0 )  then DO:
     2476             if  log-manager:logfile-name ne ?
     2477             then DO:
     2478                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     2479             end.
     2480              if mFrameView
     2481              then do:
     2482               DISPLAY
     2483                 Counter1 @ RecordsDone
     2484                 WITH FRAME InfoFrame.
     2485              end.
     2486   End.
     2487      if v-button-stop then  DO:
     2488            if mFrameView
     2489            then
     2490               PROCESS EVENTS.
     2491            IF StopProcessing THEN DO:
     2492            RETURN error.
     2493            End.
     2494      end.
     2495           create temp-shift-obj .
     2496           assign
     2497             temp-shift-obj.v-obj-type   = obj-list.obj-type
     2498             temp-shift-obj.v-obj-code   = obj-list.obj-code
     2499             temp-shift-obj.v-count      = v-count
     2500             temp-shift-obj.v-shift-date = buf_shift-obj.shift-date
     2501             temp-shift-obj.v-shift-num  = buf_shift-obj.shift-num
     2502             v-str = v-str + 1
     2503             temp-shift-obj.v-str        = v-str
     2504           .
     2505   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_shiftnam in g#lib-trn3
     2506     (
     2507        input buf_shift-obj.obj-type
     2508     ,  input buf_shift-obj.obj-code
     2509     ,  input buf_shift-obj.shift-date
     2510     ,  input buf_shift-obj.shift-num
     2511     , output temp-shift-obj.v-shift-name
     2512     , output temp-shift-obj.v-shift-name-num
     2513     )        no-error .
     2514           assign
     2515             temp-shift-obj.v-shift-name = " " + temp-shift-obj.v-shift-name + "(" + string(buf_shift-obj.shift-num) + ")"
     2516           .
     2517           for each buf_trn-doc no-lock
     2518             where buf_trn-doc.obj-code   = obj-list.obj-code
     2519               and buf_trn-doc.obj-type   = obj-list.obj-type
     2520               and buf_trn-doc.shift-date = buf_shift-obj.shift-date
     2521               and buf_trn-doc.shift-num  = buf_shift-obj.shift-num
     2522               and buf_trn-doc.status_    = 'факт':U
     2523             :
     2524             if buf_trn-doc.ext-doc-type <> 'es':U and buf_trn-doc.ext-doc-type <> 'rs':U then next .
     2525             for each buf_doc-line no-lock where buf_doc-line.doc-code = buf_trn-doc.doc-code :
     2526               find first temp-gds where temp-gds.prod-code = buf_doc-line.prod-code and temp-gds.prod-type = buf_doc-line.prod-type and temp-gds.artic = buf_doc-line.artic no-error .
     2527               if available temp-gds then do:
     2528                 run r-sale in this-procedure ( input buf_doc-line.doc-code   , input buf_doc-line.artic   , input buf_doc-line.prod-type
     2529                                         , input buf_doc-line.prod-code  , output tmp     , output tmp    , output tmp
     2530                                         , output v-sum-base      , output v-sum-rubl   , output tmp    , output tmp
     2531                                         , output tmp      , output tmp   , output tmp    , output tmp    , output tmp
     2532                                         , output tmp      , output tmp   , output tmp    , output tmp    , output tmp ).
     2533                 if buf_trn-doc.ext-doc-type = 'es':U then assign temp-shift-obj.v-sum = temp-shift-obj.v-sum - v-sum-rubl .
     2534                 else  assign temp-shift-obj.v-sum-ret = temp-shift-obj.v-sum-ret + v-sum-rubl .
     2535               end.
     2536             end.
     2537           end.
     2538         end.
     2539         for each temp-shift-obj
     2540            where temp-shift-obj.v-obj-code = obj-list.obj-code
     2541              and temp-shift-obj.v-obj-type = obj-list.obj-type
     2542              no-lock :
     2543              assign
     2544               v-sum-all     = v-sum-all     + temp-shift-obj.v-sum
     2545               v-sum-ret-all = v-sum-ret-all + temp-shift-obj.v-sum-ret
     2546              .
     2547         end.
     2548         create temp-shift-obj .
     2549           assign
     2550             temp-shift-obj.v-shift-name = "Итого " + obj-list.obj-name
     2551             v-count-neg = v-count-neg + 1
     2552             temp-shift-obj.v-count      = - ( v-count-neg )
     2553             v-str = v-str + 1
     2554             temp-shift-obj.v-str           = v-str
     2555             temp-shift-obj.v-sum-itog      = v-sum-all
     2556             temp-shift-obj.v-sum-ret-itog  = v-sum-ret-all
     2557             temp-shift-obj.v-sum-all       = temp-shift-obj.v-sum-itog - temp-shift-obj.v-sum-ret-itog
     2558           .
     2559     end.
     2560     DEFINE FRAME shift
     2561           sym1 column-label ":!:" format "X(1)" space(0)
     2562           temp-shift-obj.v-count column-label "N смены" format ">>>>>>9" space(0)
     2563           sym2 column-label ":!:" format "X(1)" space(0)
     2564           temp-shift-obj.v-shift-name  column-label "Смена" format "x(15)" space(0)
     2565           sym3 column-label ":!:" format "X(1)" space(0)
     2566           temp-shift-obj.v-shift-date column-label " Дата " format "99.99.9999" space(0)
     2567           sym4 column-label ":!:" format "X(1)" space(0)
     2568           temp-shift-obj.v-sum        column-label "Сумма реализации" format "->>>>,>>>,>>>,>>>,>>9.99" space(0)
     2569           sym5 column-label ":!:" format "X(1)" space(0)
     2570           temp-shift-obj.v-sum-ret    column-label "Сумма возврата" format "->>>>,>>>,>>>,>>>,>>9.99" space(0)
     2571           sym6 column-label ":!:" format "X(1)" space(0)
     2572           v-sum  column-label "Сумма с учетом возврата" format "->>>>,>>>,>>>,>>>,>>9.99" space(0)
     2573           sym7 column-label ":!:" format "X(1)" space(0)
     2574       header
     2575           string( "Дата печати : " + string(TODAY,"99.99.9999") +  " , " + string(TIME, "HH:MM") ) at 5 format "X(35)"
     2576           string( "Страница " + string( PAGE-NUMBER( PrnLibStream ), ">>9" ) ) at 100 format "X(13)" skip
     2577           Line format "X(111)" at 1
     2578     with width 136 down stream-io.
     2579   output stream PrnLibStream to value( string( session:temp-directory +
     2580                                        "rpt" + string( g#report-num ) ) )
     2581                                        page-size 62 .
     2582     form header  Line format "X(111)" at 1  skip "Продолжение - на следующей странице" at 30  skip
     2583     with frame Bottomframe width 136 page-bottom no-labels no-box .
     2584     view stream PrnLibStream frame Bottomframe .
     2585     str2 = replace(str2, "/" + chr(10) + "     ", "/," ) .
     2586     str4 = substring(str4, 1, index(str4, "объекта") + 7) + chr(10) + replace(substring(str4, index(str4, chr(10) + "     ") + 1), chr(10) + "     ", "," ) .
     2587     find first buf_clients no-lock where buf_clients.obj-type = 'орг':U and buf_clients.obj-code = v-host-code .
     2588     assign
     2589       ReportNAme   = " "
     2590       ReportHeader = string( "Дата печати : " + string(TODAY,"99.99.9999") +  " , " + string(TIME, "HH:MM") )
     2591       str1 = "Фирма: " + buf_clients.obj-name + ", " + "Объект: " + v-cntxt-obj-name
     2592       str3 = str4
     2593       str4 = "За период с " + string(x-date-Start,"99/99/9999") + " по " + string(x-date-End,"99/99/9999")
     2594     .
     2595     if length(str2) > 138 then str2 = string(substring(str2, 1, 135)) + "..." .
     2596     if length(str3) > 126 then str3 = string(substring(str3, 1, 123)) + "..." .
     2597     run rep/extitle.p (1) .
     2598     put stream PrnLibStream str1 format "X(100)" skip
     2599                             str2 format "X(150)" skip
     2600                             str3 format "X(150)" skip
     2601                             str4 format "X(110)" skip
     2602     .
     2603     for each temp-shift-obj break by temp-shift-obj.v-str :
     2604       assign
     2605         v-sum = temp-shift-obj.v-sum - temp-shift-obj.v-sum-ret
     2606         v-all-sum1 = v-all-sum1 + temp-shift-obj.v-sum
     2607         v-all-sum2 = v-all-sum2 + temp-shift-obj.v-sum-ret
     2608         v-all-sum3 = v-all-sum3 + v-sum
     2609       .
     2610       if temp-shift-obj.v-count > 0  then do :
     2611         display stream PrnLibStream
     2612           sym1 temp-shift-obj.v-count
     2613           sym2 temp-shift-obj.v-shift-name
     2614           sym3 temp-shift-obj.v-shift-date
     2615           sym4 temp-shift-obj.v-sum
     2616           sym5 temp-shift-obj.v-sum-ret
     2617           sym6 v-sum
     2618           sym7
     2619         with frame shift.
     2620         down stream PrnLibStream with frame shift .
     2621         if Make-Excel then  put   stream ForExcel unformatted  string(temp-shift-obj.v-count) CHR(9) temp-shift-obj.v-shift-name CHR(9) temp-shift-obj.v-shift-date CHR(9) excel-sum (temp-shift-obj.v-sum) CHR(9)  excel-sum (temp-shift-obj.v-sum-ret) CHR(9)  excel-sum (v-sum) chr(10) .
     2622       end.
     2623       else do :
     2624         if temp-shift-obj.v-shift-name begins "Итого " then do :
     2625           display stream PrnLibStream
     2626             sym1
     2627             sym2 temp-shift-obj.v-shift-name
     2628             sym3 temp-shift-obj.v-shift-date
     2629             sym4 temp-shift-obj.v-sum-itog      @ temp-shift-obj.v-sum
     2630             sym5 temp-shift-obj.v-sum-ret-itog  @ temp-shift-obj.v-sum-ret
     2631             sym6 temp-shift-obj.v-sum-all       @ v-sum
     2632             sym7
     2633           with frame shift.
     2634           down stream PrnLibStream with frame shift .
     2635           if Make-Excel then  put   stream ForExcel unformatted CHR(9) temp-shift-obj.v-shift-name CHR(9) CHR(9) excel-sum (temp-shift-obj.v-sum-itog) CHR(9)  excel-sum (temp-shift-obj.v-sum-ret-itog) CHR(9)  excel-sum (temp-shift-obj.v-sum-all) chr(10) .
     2636         end.
     2637         else do :
     2638           display stream PrnLibStream
     2639             sym1
     2640             sym2 temp-shift-obj.v-shift-name
     2641             sym3
     2642             sym4
     2643             sym5
     2644             sym6
     2645             sym7
     2646           with frame shift.
     2647           down stream PrnLibStream with frame shift .
     2648           if Make-Excel then  put   stream ForExcel unformatted  CHR(9) temp-shift-obj.v-shift-name chr(10) .
     2649         end .
     2650       end .
     2651     end .
     2652     put stream PrnLibStream Line format "X(111)" skip
     2653       sym1 "ИТОГО" sym4 at 36 v-all-sum1 format  "->>>>,>>>,>>>,>>>,>>9.99" sym5 v-all-sum2  format  "->>>>,>>>,>>>,>>>,>>9.99" sym6 v-all-sum3  format  "->>>>,>>>,>>>,>>>,>>9.99" sym7
     2654       skip Line format "X(111)" skip
     2655     .
     2656     if Make-Excel then  put   stream ForExcel unformatted  "ИТОГО"  CHR(9) CHR(9) CHR(9) excel-sum (v-all-sum1) CHR(9)  excel-sum (v-all-sum2) CHR(9)  excel-sum (v-all-sum3) .
     2657     if Make-Excel then output stream ForExcel close.
     2658     HIDE STREAM   PrnLibStream   FRAME shift .
     2659     Output stream PrnLibStream   close .
     2660   if mFrameView
     2661   then do:
     2662      HIDE FRAME InfoFrame.
     2663   end.
     2664     RUN prn-lib-prn-file in this-procedure (input parParentProc,input 0).
