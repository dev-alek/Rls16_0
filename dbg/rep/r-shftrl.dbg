     2272       ,output v-cntxt-db-num-obj
     2273       ,output v-cntxt-is-admin
     2274       ) .
     2275     define variable v-cntxt-obj-name as character no-undo .
     2276   assign
     2277     sheetf.Excel-Column-Lable = "№ смены" + "," + "Смена" + "," + "Дата" + "," + "Сумма реализации" + "," + "Сумма возврата" + "," + "Сумма реализации с учетом возврата"
     2278     sheetf.Sizes              = "7,21,10,12,12,18"
     2279     sheetf.ColFormat          = "2=@;3=dd/mm/yyyy;"
     2280     Sheetf.make-correct       = "true,true,true,true,true,true"
     2281   .
     2282   define temp-table temp-shift-obj no-undo
     2283     FIELD v-shift-num      as integer
     2284     FIELD v-shift-date     as date
     2285     FIELD v-shift-name     as character
     2286     FIELD v-shift-name-num as character
     2287     FIELD v-count          as integer
     2288     FIELD v-str            as integer
     2289     FIELD v-sum            as decimal
     2290     FIELD v-sum-ret        as decimal
     2291     FIELD v-sum-itog       as decimal
     2292     FIELD v-sum-ret-itog   as decimal
     2293     FIELD v-sum-all        as decimal
     2294     FIELD v-obj-code       as integer
     2295     FIELD v-obj-type       as character
     2296     INDEX ii IS UNIQUE v-count
     2297     INDEX ii1 IS UNIQUE v-shift-num v-shift-date v-obj-code v-obj-type
     2298     .
     2299   define temp-table temp-gds no-undo
     2300     FIELD prod-code as integer
     2301     FIELD prod-type as character
     2302     FIELD artic     as character
     2303     INDEX ii IS UNIQUE artic prod-type prod-code
     2304   .
     2305     define buffer buf_shift-obj   for ub.shift-obj .
     2306     define buffer buf_trn-doc     for ub.trn-doc.
     2307     define buffer buf_doc-line    for ub.doc-line.
     2308     define buffer buf_gds-obj     for ub.gds-obj .
     2309     define buffer buf_clients     for ub.clients.
     2310     define variable v-count       as integer   no-undo .
     2311     define variable v-str         as integer   no-undo .
     2312     define variable v-count-neg   as integer   no-undo .
     2313     define variable CurrGrpName   as character no-undo .
     2314     define variable ListGrpName   as character no-undo .
     2315     define variable v-sum         as decimal   no-undo .
     2316     define variable v-sum-ret-all as decimal   no-undo .
     2317     define variable v-sum-all     as decimal   no-undo .
     2318     define variable Line          as character no-undo .
     2319     define variable v-host-code   as integer   no-undo .
     2320     define variable Counter1      as integer   no-undo .
     2321     define variable v-all-sum1    as decimal   no-undo .
