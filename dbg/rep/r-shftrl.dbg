     1833       define variable varsum-base-factovp      like ub.gds-dtl.price-base               no-undo.
     1834       define variable varslt-base-factovp      like ub.gds-dtl.price-base               no-undo.
     1835       define variable varvat-base-factovp      like ub.gds-dtl.price-base               no-undo.
     1836       define variable varvatcons-base-factovp  like ub.gds-dtl.price-base               no-undo.
     1837       define variable vardsc-base-factovp      like ub.gds-dtl.price-base               no-undo.
     1838       define variable varsum-base-docovp       like ub.gds-dtl.price-base               no-undo.
     1839       define variable varslt-base-docovp       like ub.gds-dtl.price-base               no-undo.
     1840       define variable varvat-base-docovp       like ub.gds-dtl.price-base               no-undo.
     1841       define variable varvatcons-base-docovp   like ub.gds-dtl.price-base               no-undo.
     1842       define variable vardsc-base-docovp       like ub.gds-dtl.price-base               no-undo.
     1843       define variable varsum-rubl-factovp      like ub.gds-dtl.price-base               no-undo.
     1844       define variable varslt-rubl-factovp      like ub.gds-dtl.price-base               no-undo.
     1845       define variable varvat-rubl-factovp      like ub.gds-dtl.price-base               no-undo.
     1846       define variable varvatcons-rubl-factovp  like ub.gds-dtl.price-base               no-undo.
     1847       define variable vardsc-rubl-factovp      like ub.gds-dtl.price-base               no-undo.
     1848       define variable varsum-rubl-docovp       like ub.gds-dtl.price-base               no-undo.
     1849       define variable varslt-rubl-docovp       like ub.gds-dtl.price-base               no-undo.
     1850       define variable varvat-rubl-docovp       like ub.gds-dtl.price-base               no-undo.
     1851       define variable varvatcons-rubl-docovp   like ub.gds-dtl.price-base               no-undo.
     1852       define variable vardsc-rubl-docovp       like ub.gds-dtl.price-base               no-undo.
