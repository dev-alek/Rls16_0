     1781     define output parameter p-fact-qnty         like ub.ot-line.fact-qnty       no-undo .
     1782     define output parameter p-vat-pc            like ub.doc-line.vat-pc         no-undo .
     1783     define output parameter p-slt-pc            like ub.doc-line.slt-pc         no-undo .
     1784     define output parameter p-sum-base          like ub.ot-line.sum-base        no-undo .
     1785     define output parameter p-sum-rubl          like ub.ot-line.sum-rubl        no-undo .
     1786     define output parameter p-vat-base          like ub.ot-line.vat-base        no-undo .
     1787     define output parameter p-vat-rubl          like ub.ot-line.vat-rubl        no-undo .
     1788     define output parameter p-slt-base          like ub.ot-line.slt-base        no-undo .
     1789     define output parameter p-slt-rubl          like ub.ot-line.slt-rubl        no-undo .
     1790     define output parameter p-road-tax-base     like ub.ot-line.road-tax-base   no-undo .
     1791     define output parameter p-road-tax-rubl     like ub.ot-line.road-tax-rubl   no-undo .
     1792     define output parameter p-transport-base    like ub.ot-line.transport-base  no-undo .
     1793     define output parameter p-transport-rubl    like ub.ot-line.transport-rubl  no-undo .
     1794     define output parameter p-other-base        like ub.ot-line.other-base      no-undo .
     1795     define output parameter p-other-rubl        like ub.ot-line.other-rubl      no-undo .
     1796     define output parameter p-excise-base       like ub.ot-line.excise-base     no-undo .
     1797     define output parameter p-excise-rubl       like ub.ot-line.excise-rubl     no-undo .
     1798     define variable vss-description as character no-undo initial "r-sale-01: обработка продажных цен товара".
     1799     do
     1800     on error undo, return error
     1801     :
