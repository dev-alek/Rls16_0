     2184                   p-sum-base            = p-sum-base      + price-base-with-tax-sale  * v-gds-dtl-fact-qnty
     2185                   p-sum-rubl            = p-sum-rubl      + price-rubl-with-tax-sale  * v-gds-dtl-fact-qnty
     2186                   p-vat-base            = p-vat-base      + vat-base-sale             * v-gds-dtl-fact-qnty
     2187                   p-vat-rubl            = p-vat-rubl      + vat-rubl-sale             * v-gds-dtl-fact-qnty
     2188                   p-slt-base            = p-slt-base      + slt-base-sale             * v-gds-dtl-fact-qnty
     2189                   p-slt-rubl            = p-slt-rubl      + slt-rubl-sale             * v-gds-dtl-fact-qnty
     2190                   p-road-tax-base       = p-road-tax-base + road-tax-base-sale        * v-gds-dtl-fact-qnty
     2191                   p-road-tax-rubl       = p-road-tax-rubl + road-tax-rubl-sale        * v-gds-dtl-fact-qnty
     2192                   p-excise-base         = p-excise-base   + excise-base-sale          * v-gds-dtl-fact-qnty
     2193                   p-excise-rubl         = p-excise-rubl   + excise-rubl-sale          * v-gds-dtl-fact-qnty
     2194                   p-other-base          = p-other-base    + discnt-base-sale          * v-gds-dtl-fact-qnty
     2195                   p-other-rubl          = p-other-rubl    + discnt-rubl-sale          * v-gds-dtl-fact-qnty
     2196               .
     2197           end.
     2198       end.
     2199       assign
     2200           p-transport-base      = 0
     2201           p-transport-rubl      = 0
     2202           p-vat-pc              = buf_doc-line.vat-pc
     2203           p-slt-pc              = buf_doc-line.slt-pc
     2204       .
     2205     end.
     2206     if p-fact-qnty      = ?
     2207     or p-vat-pc         = ?
     2208     or p-slt-pc         = ?
     2209     or p-sum-base       = ?
     2210     or p-sum-rubl       = ?
     2211     or p-vat-base       = ?
     2212     or p-vat-rubl       = ?
     2213     or p-slt-base       = ?
     2214     or p-slt-rubl       = ?
     2215     or p-road-tax-base  = ?
     2216     or p-road-tax-rubl  = ?
     2217     or p-transport-base = ?
     2218     or p-transport-rubl = ?
     2219     or p-other-base     = ?
     2220     or p-other-rubl     = ?
     2221     or p-excise-base    = ?
     2222     or p-excise-rubl    = ?
     2223     then do:
     2224       message
     2225         vss-workfile vss-revision vss-description skip
     2226         vss-include-info14 skip
     2227         "Получены неопределенные значения" skip
     2228         "Документ" p-doc-code skip
     2229         "Артикул" p-artic p-prod-type p-prod-code skip
     2230         "fact-qnty     " p-fact-qnty      skip
     2231         "vat-pc        " p-vat-pc         skip
     2232         "slt-pc        " p-slt-pc         skip
     2233         "sum-base      " p-sum-base       skip
     2234         "sum-rubl      " p-sum-rubl       skip
     2235         "vat-base      " p-vat-base       skip
     2236         "vat-rubl      " p-vat-rubl       skip
     2237         "slt-base      " p-slt-base       skip
     2238         "slt-rubl      " p-slt-rubl       skip
     2239         "road-tax-base " p-road-tax-base  skip
     2240         "road-tax-rubl " p-road-tax-rubl  skip
     2241         "transport-base" p-transport-base skip
     2242         "transport-rubl" p-transport-rubl skip
     2243         "other-base    " p-other-base     skip
     2244         "other-rubl    " p-other-rubl     skip
     2245         "excise-base   " p-excise-base    skip
     2246         "excise-rubl   " p-excise-rubl    skip
     2247         view-as alert-box error .
     2248       undo, return error .
     2249     end.
     2250   end procedure.
     2251     DEFINE VARIABLE parParentProc     AS WIDGET-HANDLE NO-UNDO.
     2252     ASSIGN parParentProc =  my-handle .
     2253     define variable g#report-num as integer no-undo .
     2254     run get-report-num  in parparentproc (output  g#report-num).
     2255   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2256     define variable v-cntxt-db-num        as integer   no-undo .
     2257     define variable v-cntxt-userid        as character no-undo .
     2258     define variable v-cntxt-level         as character no-undo .
     2259     define variable v-cntxt-host-code-obj as integer   no-undo .
     2260     define variable v-cntxt-obj-type      as character no-undo .
     2261     define variable v-cntxt-obj-code      as integer   no-undo .
     2262     define variable v-cntxt-db-num-obj    as integer   no-undo .
