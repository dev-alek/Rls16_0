      602   function excel-format-dec-to-char returns char (input p-dec as decimal ).
      603     if num-entries(string(p-dec), '.') = 2
      604       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
      605       else return( string(p-dec)) .
      606   end function.
      607   function format-point-to-comma returns char (input orig as char ) .
      608   define variable rtext as character no-undo .
      609   define variable strt as integer no-undo .
      610   define variable leng as integer no-undo .
      611   assign rtext = orig .
      612   repeat:
      613     strt =  index(rtext,'.').
      614     if strt = 0 then leave.
      615     leng = 1.
      616     substring(rtext,strt,leng,"character") = v-delim .
      617   end.
      618   return rtext.
      619   end function.
      620   function format-excel-text returns char ( input start-text as char ) :
      621   def var  i    as int no-undo.
      622   def var  ch   as char no-undo.
      623   def var  n    as int no-undo.
      624   def var  ipos as int no-undo.
      625     n = num-entries(trim(start-text), chr(10)) - 1 .
      626     do i = 1 to n :
      627       ipos = index( start-text, chr(10)).
      628       if ipos > 0 then
      629         substr( start-text, ipos, 1 ) = ' '.
      630     end.
      631     n = num-entries(trim(start-text), chr(13)) - 1 .
      632     do i = 1 to n :
      633       ipos = index( start-text, chr(13)).
      634       if ipos > 0 then
      635         substr( start-text, ipos, 1 ) = ' '.
      636     end.
      637     if index( start-text, '"' ) = 0 then
      638       start-text =  '="'   + trim( start-text) + '"'   .
      639       else do:
      640         n = num-entries(trim(start-text), '"') - 1.
      641         do i = 1 to n :
      642           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      643         end.
      644         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      645         start-text = '="'  + ch  + '"' .
      646       end.
      647     return start-text.
      648   end.
      649   function excel-sum returns char (input p-dec as decimal ).
      650     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
      651   end function.
      652   function excel-qnty returns char (input p-dec as decimal ).
      653     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
      654   end function.
      655   function format-excel-text-macr returns char ( input start-text as char ) :
      656   def var  i    as int no-undo.
      657   def var  ch   as char no-undo.
      658   def var  n    as int no-undo.
      659   def var  ipos as int no-undo.
      660     n = num-entries(trim(start-text), chr(10)) - 1 .
      661     do i = 1 to n :
      662       ipos = index( start-text, chr(10)).
      663       if ipos > 0 then
      664         substring( start-text, ipos , 1 ) = ' '.
      665     end.
      666     n = num-entries(trim(start-text), chr(13)) - 1 .
      667     do i = 1 to n :
      668       ipos = index( start-text, chr(13)).
      669       if ipos > 0 then
      670         substring( start-text, ipos, 1 ) = ' '.
      671     end.
      672     if index( start-text, '"' ) = 0 then
      673       start-text =  '"'   + trim( start-text) + '"'   .
      674       else do:
      675         n = num-entries(trim(start-text), '"') - 1.
      676         do i = 1 to n :
      677           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      678         end.
      679         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      680         start-text = '"'  + ch  + '"' .
      681       end.
      682     n = num-entries(trim(start-text), chr(10)) - 1 .
      683     do i = 1 to n :
      684       ipos = index( start-text, chr(10)).
      685       if ipos > 0 then
      686         substring( start-text, ipos , 1 ) = ' '.
      687     end.
      688       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
      689     return start-text.
      690   end.
      691   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      692   procedure cur-time :
      693      define output parameter p-today as date      no-undo .
      694      define output parameter p-time  as integer   no-undo .
      695     do
      696     on error undo, return error
      697     :
      698       define variable v-date1 as date      no-undo .
      699       define variable v-date2 as date      no-undo .
      700       define variable v-time  as integer   no-undo .
      701       assign
      702         v-date1 = today
      703         v-time  = time
      704         v-date2 = today
      705       .
      706       if v-date1 <> v-date2
      707       then do:
      708         assign
      709           v-date1 = today
      710           v-time  = v-time
      711         .
      712       end.
      713       assign
      714         p-today = v-date1
      715         p-time  = v-time
      716       .
      717     end.
      718   end.
      719   function cur-time-date returns character
      720   :
      721     return string(today, '99/99/9999':U) .
      722   end.
      723   function cur-time-mjd returns decimal
      724   :
      725     define variable v-date as date      no-undo .
      726     define variable v-time as integer   no-undo .
      727     run cur-time in this-procedure
      728       (output v-date
      729       ,output v-time
      730       ) .
      731     return integer(v-date) - 2400002 + (v-time / 86400) .
      732   end.
      733   function cur-time-get-ending-index returns integer
      734   (input p-number as integer
      735   )
      736   :
      737     if p-number < 0
      738     or p-number = ?
      739     then do:
      740       return 1 .
      741     end.
      742     define variable v-rest as integer   no-undo .
      743     assign
      744       p-number = p-number modulo 100
      745     .
      746     if p-number < 20
      747     then do:
      748       assign
      749         v-rest = p-number
      750       .
      751     end.
      752     else do:
      753       assign
      754         v-rest = p-number modulo 10
      755       .
      756     end.
      757     case v-rest :
      758       when 1
      759       then do:
      760         return 2 .
      761       end.
      762       when 2 or
      763       when 3 or
      764       when 4
      765       then do:
      766         return 3 .
      767       end.
      768       otherwise do:
      769         return 1 .
      770       end.
      771     end case .
      772   end.
      773   procedure cur-time-mjd-to-date :
      774      define input  parameter i-mjd-diff as decimal no-undo.
      775      define output parameter o-Date     as date    no-undo.
      776      define output parameter o-Time     as integer no-undo.
      777      define variable v-day-number as integer   no-undo .
      778      if    i-mjd-diff < 0
      779         or i-mjd-diff = ?
      780      then do:
      781         return "?" .
      782      end.
      783      assign
      784         v-day-number = truncate(i-mjd-diff,0).
      785         o-Date = date(v-day-number + 2400002).
      786         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      787     .
      788   end.
      789   function cur-time-mjd-to-string returns character
      790   (input p-mjd-diff as decimal
      791   )
      792   :
      793     define variable v-day-number as integer   no-undo .
      794     define variable v-seconds    as integer   no-undo .
      795     define variable v-hour       as integer   no-undo .
      796     define variable v-min        as integer   no-undo .
      797     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      798     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      799     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      800     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      801     if p-mjd-diff < 0
      802     or p-mjd-diff = ?
      803     then do:
      804       return "?" .
      805     end.
      806     assign
      807       v-day-number = integer(truncate(p-mjd-diff,0))
      808       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      809     .
      810     if v-seconds > 86400
      811     then do:
      812       assign
      813         v-seconds = 86400 - 1
      814       .
      815     end.
      816     if v-seconds < 0
      817     then do:
      818       assign
      819         v-seconds = 0
      820       .
      821     end.
      822     assign
      823       v-hour = truncate(v-seconds / 3600, 0)
      824     .
      825     assign
      826       v-seconds = v-seconds modulo 3600
      827     .
      828     assign
      829       v-min = truncate(v-seconds / 60, 0)
      830     .
      831     assign
      832       v-seconds = v-seconds modulo 60
      833     .
      834     return
      835         (if v-day-number <> 0
      836           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      837           else ""
      838         )
      839       + (if v-day-number <> 0 or v-hour <> 0
      840           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      841           else ""
      842         )
      843       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      844           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      845           else ""
      846         )
      847       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      848       .
      849   end.
      850   function cur-time-string returns character
      851   :
      852     define variable v-date as date      no-undo .
      853     define variable v-time as integer   no-undo .
      854     run cur-time in this-procedure
      855       (output v-date
      856       ,output v-time
      857       ) .
      858     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      859   end.
      860   function cur-time-string-sec returns character
      861   :
      862     define variable v-date as date      no-undo .
      863     define variable v-time as integer   no-undo .
      864     run cur-time in this-procedure
      865       (output v-date
      866       ,output v-time
      867       ) .
      868     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      869   end.
      870   function cur-time-custom  returns character
      871   (input p-prefix as character
      872   ,input p-date-format as character
      873   ,input p-delimiter as character
      874   ,input p-time-format as character
      875   ,input p-suffix as character
      876   )
      877   :
      878     define variable v-date as date      no-undo .
      879     define variable v-time as integer   no-undo .
      880     run cur-time in this-procedure
      881       (output v-date
      882       ,output v-time
      883       ) .
      884     return
      885       p-prefix
      886       + string(v-date, p-date-format)
      887       + p-delimiter
      888       + string(v-time, p-time-format)
      889       + p-suffix
      890       .
      891   end.
      892   function cur-time-print  returns character
      893   :
      894     define variable v-date as date      no-undo .
      895     define variable v-time as integer   no-undo .
      896     run cur-time in this-procedure
      897       (output v-date
      898       ,output v-time
      899       ) .
      900     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      901   end.
      902   function cur-time-datetime returns datetime
      903   :
      904     define variable v-char as character no-undo .
      905     define variable v-datetime as datetime no-undo .
      906     v-char = cur-time-string().
      907     v-datetime = datetime(v-char).
      908     return  v-datetime.
      909   end.
      910   function cur-time-string-msec returns character
      911   :
      912     define variable v-date as datetime  no-undo .
      913     v-date = now.
      914     return string(v-date) .
      915   end.
      916   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      917   define  stream PrnLibStream.
      918   procedure prn-lib-prn-file :
      919     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      920     define input parameter p-DIsabledoptions as integer no-undo .
      921     define variable v-report-name as character no-undo .
      922     define variable v-user-action as character no-undo .
      923     define variable v-printed     as logical   no-undo .
      924     define variable v-exist       as logical   no-undo .
      925     do
      926       on error undo, return error
      927       :
      928       run prn-lib-get-report-name  in this-procedure (
      929         input parParentProc
      930         ,output v-report-name
      931         ).
      932   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      933   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      934     (input  v-report-name
      935     ,input  2
      936     ,output v-exist
      937     )  .
      938       if NOT v-exist then
      939       DO:
      940         Message
      941           "Нет заданий на печать ! "
      942           view-as alert-box .
      943         Return  .
      944       End.
      945       run gbl/prnfilen.w
      946         (input  ""
      947         ,input  p-DisabledOptions
      948         ,input  string(v-report-name )
      949         ,input  7
      950         ,output v-user-action
      951         ,output v-printed
      952         ) .
      953       if v-printed then
      954       do:
      955         return "YES" .
      956       end.
      957       else
      958       do:
      959         return "NO" .
      960       end.
      961     end.
      962   end procedure.
      963   procedure prn-lib-open-stream :
      964     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      965     define input parameter p-page-size    as integer no-undo .
      966     define input parameter p-is-stream    as logical no-undo .
      967     define input parameter p-append       as logical no-undo .
      968     define variable v-report-name as character no-undo .
      969     do
      970       on error undo, return error
      971       :
      972       run prn-lib-get-report-name  in this-procedure (
      973         input parParentProc
      974         ,output v-report-name
      975         ).
      976       if p-is-stream then
      977       do:
      978         if p-append then
      979         do:
      980           output stream PrnLibStream to value( v-report-name )
      981             page-size value(p-page-size) append .
      982         end.
      983         if not p-append then
      984         do:
      985           output stream PrnLibStream to value( v-report-name )
      986             page-size value(p-page-size) .
      987         end.
      988       end.
      989       if not p-is-stream then
      990       do:
      991         if p-append then
      992         do:
      993           output to value( v-report-name )
      994             page-size value(p-page-size) append .
      995         end.
      996         if not p-append then
      997         do:
      998           output to value( v-report-name )
      999             page-size value(p-page-size) .
     1000         end.
     1001       end.
     1002     end.
     1003   end procedure.
     1004   procedure prn-lib-open-exp :
     1005     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1006     define input parameter p-is-stream    as logical no-undo .
     1007     define input parameter p-is-append    as logical no-undo .
     1008     define output parameter p-ReportFileName as char init "report" no-undo.
     1009     define output parameter p-process as logical no-undo .
     1010     define variable glog as logical no-undo .
     1011     do
     1012       on error undo, return error
     1013       :
     1014       SYSTEM-DIALOG GET-FILE p-ReportFileName
     1015         TITLE      "Укажите путь"
     1016         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     1017         ASK-OVERWRITE
     1018         CREATE-TEST-FILE
     1019         SAVE-AS
     1020         USE-FILENAME
     1021         DEFAULT-EXTENSION "txt"
     1022         UPDATE glog
     1023         .
     1024       if not glog then  return.
     1025       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     1026       if p-is-stream then
     1027       do:
     1028         if p-is-append then
     1029         do:
     1030           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1031         end.
     1032         else
     1033         do:
     1034           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1035         end.
     1036       end.
     1037       else
     1038       do:
     1039         if p-is-append then
     1040         do:
     1041           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1042         end.
     1043         else
     1044         do:
     1045           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1046         end.
     1047       end.
     1048       p-process = yes.
     1049     end.
     1050   end procedure.
     1051   procedure prn-lib-get-report-name :
     1052     define input parameter parParentProc  as widget-handle no-undo.
     1053     define output parameter p-report-name as character no-undo .
     1054     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     1055   end procedure.
     1056   procedure prn-lib-reportviewer-report-name :
     1057     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1058     define input parameter p-report-name-html as character no-undo .
     1059     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
     1060   end procedure.
     1061   procedure prn-lib-reportviewer :
     1062     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1063     define input parameter p-report-name-html as character no-undo .
     1064     define input parameter p-param        as character no-undo .
     1065     define variable v-excel           as character no-undo init 'TRUE' .
     1066     define variable v-value-character as character no-undo .
     1067     define variable v-value-integer   as character no-undo .
     1068     define variable v-value-date      as date      no-undo .
     1069     define variable v-value-decimal   as decimal   no-undo .
     1070     define variable rep-excel         as logical   no-undo .
     1071     define variable excel-string      as character no-undo .
     1072     define variable v-param-type      as character no-undo .
     1073     define variable v-tth             as handle    no-undo .
     1074     run adm/shattri.p (
     1075       input "get":U
     1076       ,input  ""
     1077       ,input  0
     1078       ,input  'report-glob':U
     1079       ,input  'rep-excel':U
     1080       ,output v-value-character
     1081       ,output v-value-date
     1082       ,output v-value-decimal
     1083       ,output v-value-integer
     1084       ,output rep-excel
     1085       ,output v-param-type
     1086       ,INPUT-OUTPUT table-handle v-tth
     1087       )  .
     1088     if rep-excel then v-excel = "TRUE" .
     1089     else v-excel = "FALSE" .
     1090     if p-param eq ""
     1091     then
     1092        p-param = "EXCEL:" + v-excel.
     1093     else
     1094        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1095     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1096   end procedure.
     1097   define variable vss-include-info11 as character format "X(65)" no-undo
     1098   initial "@(#)$Workfile$ $Revision$".
     1099   define temp-table temp_grplib_grp no-undo
     1100       field sel           as character
     1101       field nabor         as character
     1102       field full-name     as character
     1103       field print-code    as character
     1104       field sort-name     as character
     1105       field node-code     as integer
     1106       field upper-code    as integer
     1107       field calc-method   as character
     1108       field round-method  as character
     1109       field increase-pc   as decimal
     1110       field min-marg      as character
     1111       field max-marg      as character
     1112       field cli-type      as character
     1113       field cli-code      as integer
     1114       field notcorr      as character
     1115       field name          as character
     1116       field level         as integer
     1117       field mark          as character
     1118       index pi is primary unique sort-name
     1119       index fn full-name
     1120       index nc is unique node-code
     1121       index sl sel
     1122       index uc upper-code
     1123   .
     1124   define temp-table temp_grplib_found-grp no-undo
     1125       field full-name   as character
     1126       field sort-name   as character
     1127       field node-code   as integer
     1128       field level       as integer
     1129       field is-terminal as logical
     1130       index pi is primary unique sort-name
     1131       index fn full-name
     1132       index lv level
     1133       index it is-terminal
     1134   .
     1135   define temp-table temp_found-result-nodelist no-undo
     1136       field node-code     as recid
     1137       field processed     as logical
     1138       field sort-name     as character
     1139       field full-name     as character
     1140       index pi is primary unique node-code
     1141       index ps processed
     1142   .
     1143   define variable v-grplib-not-fill-extra-info        as logical      no-undo.
     1144   define variable v-grplib-no-warning-grp-amount      as logical      no-undo.
     1145   define variable v-grplib-grp-amount-for-load        as integer      no-undo.
     1146   procedure grplib-get-parameters :
     1147   define input parameter p-store-type     as character        no-undo.
     1148   define input parameter p-store-code     as integer          no-undo.
     1149   do
     1150   on error undo, return error
     1151   :
     1152       assign
     1153           v-grplib-not-fill-extra-info = no
     1154       .
     1155   end.
     1156   end procedure.
     1157   procedure grplib-get-sort-name :
     1158   do
     1159   on error undo, return error
     1160   :
     1161   define input parameter p-node-code  as integer      no-undo.
     1162   define output parameter p-sort-name as character    no-undo.
     1163       define variable v-upper-code    as integer           no-undo.
     1164       define buffer buf_gds-grp       for ub.gds-grp.
     1165       define buffer buf_upper_gds-grp for ub.gds-grp.
     1166       find first buf_gds-grp no-lock
     1167            where buf_gds-grp.node-code = p-node-code
     1168       no-error.
     1169       if not available buf_gds-grp
     1170       then do:
     1171           undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     1172       end.
     1173       assign
     1174           p-sort-name  = ""
     1175           v-upper-code = 1
     1176       .
     1177       do while buf_gds-grp.upper-code <> 0
     1178       on error undo, return error "grplib-get-sort-name: Ошибка составления полного имени группы"
     1179       :
     1180           assign
     1181               p-sort-name  = buf_gds-grp.node-name
     1182                            + (if p-sort-name <> "" then chr(2) else "")
     1183                            + p-sort-name
     1184               v-upper-code = buf_gds-grp.upper-code
     1185           .
     1186           find first buf_gds-grp no-lock
     1187                where buf_gds-grp.node-code = v-upper-code
     1188           no-error.
     1189           if not available buf_gds-grp
     1190           then do:
     1191               undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом "
     1192                                   + string( v-upper-code )
     1193                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     1194           end.
     1195       end.
     1196   end.
     1197   end procedure.
     1198   define variable vss-include-info12 as character format "X(65)" no-undo
     1199   initial "@(#)$Workfile$ $Revision$".
     1200   procedure grplib-get-full-name :
     1201      define input parameter p-node-code  as integer      no-undo.
     1202      define output parameter p-full-name as character    no-undo.
     1203      do
     1204   on error undo, return error
     1205   :
     1206       define variable v-upper-code    as integer           no-undo.
     1207       define buffer buf_gds-grp       for ub.gds-grp.
     1208       define buffer buf_upper_gds-grp for ub.gds-grp.
     1209       find first buf_gds-grp no-lock
     1210            where buf_gds-grp.node-code = p-node-code
     1211       no-error.
     1212       if not available buf_gds-grp
     1213       then do:
     1214           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     1215       end.
     1216       assign
     1217           p-full-name  = ""
     1218           v-upper-code = 1
     1219       .
     1220       do while buf_gds-grp.upper-code <> 0
     1221       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     1222       :
     1223           assign
     1224               p-full-name  = buf_gds-grp.node-name
     1225                            + (if p-full-name <> "" then chr(47) else "")
     1226                            + p-full-name
     1227               v-upper-code = buf_gds-grp.upper-code
     1228           .
     1229           find first buf_gds-grp no-lock
     1230                where buf_gds-grp.node-code = v-upper-code
     1231           no-error.
     1232           if not available buf_gds-grp
     1233           then do:
     1234               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
     1235                                   + string( v-upper-code )
     1236                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     1237           end.
     1238       end.
     1239       assign
     1240       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     1241       .
     1242   end.
     1243   end .
     1244   procedure grplib-get-node-from-full-name :
     1245   define input parameter p-full-name as character no-undo .
     1246   define output parameter p-node-code as integer no-undo .
     1247   define variable v-ii as integer no-undo .
     1248   define variable v-upper-code as integer no-undo .
     1249   define variable v-root-code as integer no-undo .
     1250   define variable v-entry as character no-undo .
     1251   define buffer buf_gds-grp       for ub.gds-grp.
     1252   do
     1253   on error undo, return error
     1254   :
     1255     find first buf_gds-grp no-lock
     1256         where buf_gds-grp.upper-code = 0
     1257     no-error .
     1258     if not available buf_gds-grp
     1259     then do:
     1260         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
     1261     end.
     1262     else do:
     1263       assign
     1264       v-root-code = buf_gds-grp.node-code
     1265       .
     1266     end.
     1267     v-upper-code = v-root-code.
     1268     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     1269       assign
     1270       v-entry = entry(v-ii, p-full-name, chr(47)).
     1271       if v-entry = '' then leave.
     1272       find first buf_gds-grp no-lock where
     1273                 buf_gds-grp.node-name = v-entry
     1274             and buf_gds-grp.upper-code = v-upper-code
     1275             no-error.
     1276       if not available buf_gds-grp then do:
     1277         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     1278       end.
     1279       else do:
     1280         p-node-code = buf_gds-grp.node-code.
     1281         v-upper-code = buf_gds-grp.node-code.
     1282       end.
     1283     end.
     1284   end.
     1285   end .
     1286   procedure grplib-get-root-code :
     1287   do
     1288   on error undo, return error
     1289   :
     1290   define output parameter p-root-code as integer      no-undo.
     1291       define buffer buf_gds-grp       for ub.gds-grp.
     1292       find first buf_gds-grp no-lock
     1293           where buf_gds-grp.upper-code = 0
     1294       no-error .
     1295       if not available buf_gds-grp
     1296       then do:
     1297           undo, return error .
     1298       end.
     1299       else do:
     1300           assign
     1301               p-root-code = buf_gds-grp.node-code
     1302           .
     1303       end.
     1304   end.
     1305   end procedure.
     1306   procedure grplib-find-grp-by-full-name :
     1307   do
     1308   on error undo, return error
     1309   :
     1310   define input parameter p-search-name  as character    no-undo.
     1311   define input parameter p-fill-path    as logical      no-undo.
     1312   define output parameter p-found       as logical      no-undo.
     1313       define variable v-upper-code    as integer          no-undo.
     1314       define variable v-counter       as integer           no-undo.
     1315       define variable v-level         as integer           no-undo.
     1316       define variable v-full-name     as character         no-undo.
     1317       define variable v-sort-name     as character         no-undo.
     1318       define buffer buf_gds-grp       for ub.gds-grp.
     1319       assign
     1320           p-search-name = replace( p-search-name, chr(47), chr(2) )
     1321       .
     1322       run grplib-get-root-code ( output v-upper-code ) no-error .
     1323       if error-status :error
     1324       then do:
     1325           undo, return error "grplib-expand-name: Ошибка при поиске корневого узла".
     1326       end.
     1327       assign
     1328           v-full-name  = ""
     1329           v-level      = num-entries( p-search-name, chr(2) )
     1330       .
     1331       for each temp_grplib_found-grp
     1332       :
     1333           delete temp_grplib_found-grp.
     1334       end.
     1335       start-name-analyze:
     1336       do v-counter = 1 to v-level
     1337       :
     1338           if v-counter < v-level
     1339           then do:
     1340               find first buf_gds-grp no-lock
     1341                    where buf_gds-grp.upper-code = v-upper-code
     1342                      and buf_gds-grp.node-name  = entry( v-counter, p-search-name, chr(2) )
     1343               no-error .
     1344               if not available buf_gds-grp
     1345               then do:
     1346                   assign
     1347                       v-full-name  = p-search-name
     1348                       v-sort-name  = p-search-name
     1349                   .
     1350                   return error "grplib-expand-name: не найдена группа " + entry( v-level, p-search-name, chr(2) ).
     1351               end.
     1352               else do:
     1353                   assign
     1354                       v-full-name = v-full-name + ( if v-full-name = "" then "" else chr(47) )        + buf_gds-grp.node-name
     1355                       v-sort-name = v-sort-name + ( if v-sort-name = "" then "" else chr(2) ) + buf_gds-grp.node-name
     1356                       v-upper-code = buf_gds-grp.node-code
     1357                   .
     1358                   if p-fill-path = yes
     1359                   then do:
     1360                       create temp_grplib_found-grp.
     1361                       assign
     1362                           temp_grplib_found-grp.full-name = v-full-name + chr(47)
     1363                           temp_grplib_found-grp.sort-name = v-sort-name
     1364                           temp_grplib_found-grp.node-code = v-upper-code
     1365                           temp_grplib_found-grp.level     = v-counter
     1366                       .
     1367                   end.
     1368               end.
     1369           end.
     1370           else do:
     1371               for each buf_gds-grp no-lock
     1372                  where buf_gds-grp.upper-code = v-upper-code
     1373                    and buf_gds-grp.node-name begins entry( v-counter, p-search-name, chr(2) )
     1374               :
     1375                   assign
     1376                       p-found = yes
     1377                   .
     1378                   create temp_grplib_found-grp.
     1379                   assign
     1380                       temp_grplib_found-grp.full-name = v-full-name
     1381                                                           + (if v-full-name = "" then "" else chr(47) )
     1382                                                           + buf_gds-grp.node-name + chr(47)
     1383                       temp_grplib_found-grp.sort-name = v-sort-name
     1384                                                           + ( if v-sort-name = "" then "" else chr(2) )
     1385                                                           + buf_gds-grp.node-name
     1386                       temp_grplib_found-grp.node-code = buf_gds-grp.node-code
     1387                       temp_grplib_found-grp.level     = v-level
     1388                   .
     1389               end.
     1390               if p-found = no
     1391               then do:
     1392                   assign
     1393                       v-full-name  = p-search-name
     1394                       v-sort-name  = p-search-name
     1395                   .
     1396                   for each temp_grplib_found-grp
     1397                   :
     1398                       delete temp_grplib_found-grp.
     1399                   end.
     1400                   assign
     1401                       p-found = no
     1402                   .
     1403               end.
     1404           end.
     1405       end.
     1406   end.
     1407   end procedure.
     1408   procedure grplib-find-all-subgroup :
     1409   do
     1410   on error undo, return error
     1411   :
     1412   define input parameter p-start-node-code    as integer      no-undo.
     1413   define input parameter p-terminal-only      as logical      no-undo.
     1414       define variable v-start-full-name   as character     no-undo.
     1415       define variable v-start-sort-name   as character     no-undo.
     1416       define variable v-not-found         as logical       no-undo.
     1417       define variable v-is-terminal       as logical       no-undo.
     1418       define buffer buf_gds-grp           for ub.gds-grp.
     1419       create temp_found-result-nodelist.
     1420       assign
     1421           temp_found-result-nodelist.node-code = p-start-node-code
     1422           temp_found-result-nodelist.processed = no
     1423       .
     1424       run grplib-get-full-name in this-procedure (
     1425             input p-start-node-code
     1426           , output v-start-full-name
     1427       ).
     1428       run grplib-get-full-name in this-procedure (
     1429             input p-start-node-code
     1430           , output v-start-sort-name
     1431       ).
     1432       process-nodes:
     1433       do while yes
     1434       :
     1435           find first temp_found-result-nodelist
     1436                where temp_found-result-nodelist.node-code = p-start-node-code
     1437           .
     1438           assign
     1439               temp_found-result-nodelist.processed = yes
     1440           .
     1441           for each buf_gds-grp no-lock
     1442              where buf_gds-grp.upper-code = p-start-node-code
     1443           on error undo, return error
     1444           :
     1445               run grplib-is-terminal in this-procedure (
     1446                     input buf_gds-grp.node-code
     1447                   , output v-is-terminal
     1448               ).
     1449               if v-is-terminal = yes
     1450               then do:
     1451                   create temp_grplib_found-grp.
     1452                   assign
     1453                       temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
     1454                                                           chr(47) + buf_gds-grp.node-name + chr(47)
     1455                       temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
     1456                                                           chr(2) + buf_gds-grp.node-name + chr(2)
     1457                       temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
     1458                       temp_grplib_found-grp.is-terminal = yes
     1459                   .
     1460               end.
     1461               else do:
     1462                   create temp_found-result-nodelist.
     1463                   assign
     1464                       temp_found-result-nodelist.node-code = buf_gds-grp.node-code
     1465                       temp_found-result-nodelist.full-name = right-trim(v-start-full-name, chr(47)) +
     1466                                                              chr(47) + buf_gds-grp.node-name + chr(47)
     1467                       temp_found-result-nodelist.sort-name = right-trim(v-start-sort-name, chr(2)) +
     1468                                                              chr(2) + buf_gds-grp.node-name + chr(2)
     1469                       temp_found-result-nodelist.processed = no
     1470                   .
     1471                   if p-terminal-only = no
     1472                   then do:
     1473                       create temp_grplib_found-grp.
     1474                       assign
     1475                           temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
     1476                                                               chr(47) + buf_gds-grp.node-name + chr(47)
     1477                           temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
     1478                                                               chr(2) + buf_gds-grp.node-name + chr(2)
     1479                           temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
     1480                           temp_grplib_found-grp.is-terminal = no
     1481                       .
     1482                   end.
     1483               end.
     1484           end.
     1485           find first temp_found-result-nodelist
     1486                where temp_found-result-nodelist.processed = no
     1487           no-error.
     1488           if not available temp_found-result-nodelist
     1489           then do:
     1490               leave process-nodes.
     1491           end.
     1492           else do:
     1493               assign
     1494                   p-start-node-code = temp_found-result-nodelist.node-code
     1495                   v-start-full-name = temp_found-result-nodelist.full-name
     1496                   v-start-sort-name = temp_found-result-nodelist.sort-name
     1497               .
     1498           end.
     1499       end.
     1500   end.
     1501   end procedure.
     1502   procedure grplib-expand-name :
     1503   define input parameter p-start-name as character        no-undo.
     1504   define output parameter p-end-name  as character        no-undo.
     1505       define variable v-is-terminal   as logical      no-undo.
     1506       define variable v-found         as character    no-undo.
     1507       define buffer buf_temp_grplib_found-grp     for temp_grplib_found-grp.
     1508   do
     1509   for buf_temp_grplib_found-grp
     1510   on error undo, return error
     1511   :
     1512       run grplib-find-grp-by-full-name in this-procedure (
     1513             input p-start-name
     1514           , input no
     1515           , output v-found
     1516       ) no-error.
     1517       run grplib-get-max-substring in this-procedure (
     1518                   input length( p-start-name )
     1519                 , output p-end-name
     1520       ) no-error .
     1521       if error-status :error
     1522       then do:
     1523           assign
     1524               p-end-name = ""
     1525           .
     1526       end.
     1527       else do:
     1528           find first temp_grplib_found-grp
     1529               where temp_grplib_found-grp.full-name = p-end-name
     1530           no-error.
     1531           if available temp_grplib_found-grp
     1532           then do:
     1533               find first buf_temp_grplib_found-grp
     1534                   where buf_temp_grplib_found-grp.full-name begins p-end-name
     1535                   and recid( buf_temp_grplib_found-grp ) <> recid( temp_grplib_found-grp )
     1536               no-error.
     1537               if not available buf_temp_grplib_found-grp
     1538               then do:
     1539                   run grplib-is-terminal in this-procedure (
     1540                       input temp_grplib_found-grp.node-code
     1541                       , output v-is-terminal
     1542                   ).
     1543               end.
     1544           end.
     1545       end.
     1546   end.
     1547   end procedure.
     1548   procedure grplib-get-max-substring :
     1549   do
     1550   on error undo, return error
     1551   :
     1552   define input parameter p-min-substring-length   as integer      no-undo.
     1553   define output parameter p-substring             as character    no-undo.
     1554           define variable v-char-counter  as integer           no-undo.
     1555           define variable v-current-char  as character         no-undo.
     1556           define variable v-names-counter  as integer           no-undo.
     1557           define variable v-base-string   as character         no-undo.
     1558           assign
     1559               v-char-counter  = p-min-substring-length
     1560           .
     1561           find first temp_grplib_found-grp no-error.
     1562           if not available temp_grplib_found-grp
     1563           then do:
     1564               undo, return error "grplib-get-max-substring: Нет строк для вычисления общей подстроки".
     1565           end.
     1566           else do:
     1567               assign
     1568                   v-base-string  = temp_grplib_found-grp.full-name
     1569                   v-char-counter = 0
     1570               .
     1571               counter-block:
     1572               do while yes
     1573               on error undo, return error "grplib-get-max-substring: Ошибка вычисления продолжения имени группы."
     1574               :
     1575                   assign
     1576                       v-char-counter  = v-char-counter + 1
     1577                       v-current-char  = substring( v-base-string, v-char-counter, 1 )
     1578                       v-names-counter = 0
     1579                   .
     1580                   compare-block:
     1581                   for each temp_grplib_found-grp
     1582                   :
     1583                       assign
     1584                           v-names-counter = v-names-counter + 1
     1585                       .
     1586                       if v-names-counter = 1
     1587                       then do:
     1588                           next compare-block.
     1589                       end.
     1590                       if substring( temp_grplib_found-grp.full-name, v-char-counter, 1 ) <> v-current-char
     1591                       then do:
     1592                           leave counter-block.
     1593                       end.
     1594                   end.
     1595                   if v-names-counter = 1
     1596                   then do:
     1597                       assign
     1598                           p-substring = v-base-string
     1599                       .
     1600                       return.
     1601                   end.
     1602               end.
     1603               assign
     1604                   p-substring = substring( v-base-string, 1, v-char-counter - 1 )
     1605               .
     1606           end.
     1607   end.
     1608   end procedure.
     1609   procedure grplib-is-terminal :
     1610   do
     1611   on error undo, return error "Ошибка процедуры grplib-is-terminal"
     1612   :
     1613   define input parameter p-node-code      as integer      no-undo.
     1614   define output parameter p-is-terminal   as logical      no-undo.
     1615       define buffer buf_gds-grp       for ub.gds-grp.
     1616       find first buf_gds-grp no-lock
     1617           where buf_gds-grp.upper-code = p-node-code
     1618       no-error .
     1619       if not available buf_gds-grp
     1620       then do:
     1621           assign
     1622               p-is-terminal = yes
     1623           .
     1624       end.
     1625       else do:
     1626           assign
     1627               p-is-terminal = no
     1628           .
     1629       end.
     1630   end.
     1631   end procedure.
     1632   procedure grplib-have-goods :
     1633   do
     1634   on error undo, return error
     1635   :
     1636   define input parameter p-node-code      as integer      no-undo.
     1637   define output parameter p-have-goods   as logical      no-undo.
     1638       define buffer buf_goods         for ub.goods.
     1639       find first buf_goods no-lock
     1640            where buf_goods.grp-code = p-node-code
     1641       no-error .
     1642       if available buf_goods
     1643       then do:
     1644           assign
     1645               p-have-goods = yes
     1646           .
     1647       end.
     1648       else do:
     1649           assign
     1650               p-have-goods = no
     1651           .
     1652       end.
     1653   end.
     1654   end procedure.
     1655   procedure grplib-find-by-substring :
     1656   do
     1657   on error undo, return error
     1658   :
     1659   define input parameter p-start-code         as integer      no-undo.
     1660   define input parameter p-full-search-string as character    no-undo.
     1661   define output parameter p-found-code        as integer      no-undo.
     1662   define output parameter p-full-name         as character    no-undo.
     1663       define variable v-start-code     as integer           no-undo.
     1664       define variable v-found          as logical  init no  no-undo.
     1665       define buffer buf_gds-grp       for ub.gds-grp.
     1666       search-grp:
     1667       for each buf_gds-grp no-lock
     1668           where buf_gds-grp.node-code > p-start-code
     1669       :
     1670           if index( buf_gds-grp.node-name, p-full-search-string ) <> 0
     1671           then do:
     1672               assign
     1673                   p-found-code = buf_gds-grp.node-code
     1674                   v-found      = yes
     1675               .
     1676               run grplib-get-full-name in this-procedure (
     1677                     input p-found-code
     1678                   , output p-full-name
     1679               ) no-error .
     1680               if error-status :error
     1681               then do:
     1682                   undo, return error "grplib-find-by-substring: Ошибка вычисления полного имени группы." + chr(10) + return-value.
     1683               end.
     1684               leave search-grp.
     1685           end.
     1686       end.
     1687       if v-found = yes
     1688       then do:
     1689       end.
     1690       else do:
     1691           assign
     1692               p-full-name  = ""
     1693               p-found-code = 0
     1694           .
     1695       end.
     1696   end.
     1697   end procedure.
     1698   procedure grplib-analyze-grp-name :
     1699   do
     1700   on error undo, return error
     1701   :
     1702   define input parameter p-grp-name       as character            no-undo.
     1703   define input parameter p-upper-code     as integer              no-undo.
     1704   define output parameter p-error-message as character init ""    no-undo.
     1705       define variable v-char-list     as character    no-undo.
     1706       define variable v-char-counter  as integer      no-undo.
     1707       define variable v-full-name     as character    no-undo.
     1708       if p-grp-name = "" then do:
     1709           assign
     1710               p-error-message = "Название группы не может быть пустым.".
     1711           .
     1712       end.
     1713       else do:
     1714           assign
     1715               v-char-list = "47,92,58,63,34,60,62,171,187,183"
     1716           .
     1717           do v-char-counter = 1 to num-entries( v-char-list )
     1718           :
     1719               if index( p-grp-name, chr( integer( entry( v-char-counter, v-char-list ) ) ) ) <> 0
     1720               then do:
     1721                   assign
     1722                       p-error-message = 'Название группы не может содержать символы /\:*?"<>|«»·'
     1723                   .
     1724                   return.
     1725               end.
     1726           end.
     1727           if p-upper-code > 0
     1728           then do:
     1729               run grplib-get-full-name in this-procedure (
     1730                     input p-upper-code
     1731                   , output v-full-name
     1732               ) no-error .
     1733               if error-status :error
     1734               then do:
     1735                   undo, return error "grplib-analyze-grp-name: Не удалось вычислить полное имя группы." + chr(10) + return-value.
     1736               end.
     1737               if length( v-full-name ) + 1 + length( p-grp-name ) > 350
     1738               then do:
     1739                   assign
     1740                       p-error-message = 'Полное название группы не может содержать более 350 символов.'
     1741                   .
     1742               end.
     1743           end.
     1744       end.
     1745   end.
     1746   end procedure.
     1747   procedure grplib-get-lvl-num :
     1748   define input parameter p-node-code  as integer      no-undo.
     1749   define output parameter p-lvl-num   as integer      no-undo.
     1750       define variable v-full-name    as character    no-undo.
     1751   do
     1752   on error undo, return error
     1753   :
     1754       run grplib-get-full-name in this-procedure (
     1755             input p-node-code
     1756           , output v-full-name
     1757       ).
     1758       assign
     1759           p-lvl-num = num-entries( v-full-name, chr(47) ) - 1
     1760       .
     1761       if p-lvl-num = -1
     1762       then do:
     1763           assign
     1764               p-lvl-num = 0
     1765           .
     1766       end.
     1767   end.
     1768   end procedure.
     1769   define new global shared variable g#lib-trn  as handle no-undo .
     1770   define new global shared variable g#lib-trn2 as handle no-undo .
     1771   define new global shared variable g#lib-trn3 as handle no-undo .
     1772   define new global shared variable g#lib-trn4 as handle no-undo .
     1773   define variable vss-include-info13 as character format "X(65)" no-undo
     1774   initial "@(#)$Workfile$ $Revision$".
     1775   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1776   procedure r-sale :
     1777     define input parameter  p-doc-code          like ub.doc-line.doc-code          no-undo .
