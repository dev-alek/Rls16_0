      909   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      910   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      911   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      912   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      913   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      914   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      915   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      916   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      917         adm-object-hdl = FRAME F-Main:HANDLE.
      918   RUN ensure-broker.
      919   THIS-PROCEDURE:ADM-DATA =
      920        'ADM1.1~`':U +
      921        'SmartViewer~`':U +
      922        '~`':U +
      923        'NO ~`':U +
      924        '~`':U +
      925        '~`':U +
      926        '~`':U +
      927        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      928           + "~`":U +
      929        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
      930        'Record-Source,Record-Target,TableIO-Target~`':U +
      931        '~`':U +
      932        '~`~`~`~`~`~`~`~`~`~`~`':U +
      933        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      934            THEN "^^":U
      935        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      936             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      937   PROCEDURE adm-apply-entry :
      938     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      939   END PROCEDURE.
      940   PROCEDURE adm-destroy :
      941    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      942   END PROCEDURE.
      943   PROCEDURE adm-disable :
      944       DISABLE T-crsa R-all T-nacenka T-det-obj WITH FRAME F-Main.
      945       RUN dispatch ('disable-fields':U).
      946       RUN set-attribute-list ('ENABLED=no':U).
      947       RETURN.
      948   END PROCEDURE.
      949   PROCEDURE adm-edit-attribute-list :
      950         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
      951         RETURN.
      952   END PROCEDURE.
      953   PROCEDURE adm-enable :
      954       ENABLE UNLESS-HIDDEN T-crsa R-all T-nacenka T-det-obj WITH FRAME F-Main.
      955       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      956       RUN set-attribute-list ('ENABLED=yes':U).
      957       RETURN.
      958   END PROCEDURE.
      959   PROCEDURE adm-exit :
      960        RUN notify ('exit':U).
      961     RETURN.
      962   END PROCEDURE.
      963   PROCEDURE adm-hide :
      964     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      965   END PROCEDURE.
      966   PROCEDURE adm-initialize :
      967     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      968   END PROCEDURE.
      969   PROCEDURE adm-show-errors :
      970       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      971       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      972           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      973       END.
      974       RETURN.
      975   END PROCEDURE.
      976   PROCEDURE adm-UIB-mode :
      977     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      978   END PROCEDURE.
      979   PROCEDURE adm-view :
      980     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      981   END PROCEDURE.
      982   PROCEDURE dispatch :
      983       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      984       RUN broker-dispatch IN adm-broker-hdl
      985           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      986       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      987   END PROCEDURE.
      988   PROCEDURE ensure-broker :
      989   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      990   IF RETURN-VALUE NE "ADM-Broker":U THEN
      991   DO:
      992       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      993       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      994   END.
      995   END PROCEDURE.
      996   PROCEDURE get-attribute :
      997     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      998     RUN broker-get-attribute IN adm-broker-hdl
      999         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1000     RETURN RETURN-VALUE.
     1001   END PROCEDURE.
     1002   PROCEDURE get-attribute-list :
     1003     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1004     RUN broker-get-attribute-list IN adm-broker-hdl
     1005         (INPUT THIS-PROCEDURE,
     1006          INPUT ?,
     1007          OUTPUT p-attr-list) NO-ERROR.
     1008     RETURN.
     1009   END PROCEDURE.
     1010   PROCEDURE new-state :
     1011     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1012     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1013     RETURN.
     1014   END PROCEDURE.
     1015   PROCEDURE notify :
     1016     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1017     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1018     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1019         RETURN "ADM-ERROR":U.
     1020     RETURN.
     1021   END PROCEDURE.
     1022   PROCEDURE set-attribute-list :
     1023     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1024     RUN ensure-broker.
     1025     RUN broker-set-attribute-list IN adm-broker-hdl
     1026         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1027     RETURN.
     1028   END PROCEDURE.
     1029   PROCEDURE set-position :
     1030       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1031       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1032       IF VALID-HANDLE(adm-object-hdl) THEN
     1033       DO:
     1034         ASSIGN adm-object-hdl:ROW    =   p-row
     1035                adm-object-hdl:COLUMN =   p-col.
     1036       END.
     1037       RETURN.
     1038   END PROCEDURE.
     1039   PROCEDURE adm-display-fields :
     1040       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
     1041       RETURN.
     1042   END PROCEDURE.
     1043   PROCEDURE adm-open-query :
     1044     RETURN.
     1045   END PROCEDURE.
     1046   PROCEDURE adm-row-changed :
     1047         IF VALID-HANDLE(adm-object-hdl) THEN
     1048           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1049         RUN notify ('row-available':U).
     1050         RETURN.
     1051   END PROCEDURE.
     1052   PROCEDURE reposition-query :
     1053       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
     1054       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
     1055       RETURN.
     1056   END PROCEDURE.
     1057     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
     1058     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
     1059     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
     1060     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
     1061     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
     1062     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
     1063     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
     1064     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
     1065     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1066     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
     1067     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1068     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
     1069     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
     1070     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
     1071     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
     1072     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
     1073     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
     1074     IF "":U = "":U THEN
     1075       RUN modify-list-attribute IN adm-broker-hdl
     1076         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
     1077     RUN use-create-on-add(?).
     1078   PROCEDURE adm-add-record :
     1079       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1080          "must have at least one Enabled Table to perform Add.":U
     1081          VIEW-AS ALERT-BOX ERROR.
     1082       RETURN.
     1083   END PROCEDURE.
     1084   PROCEDURE adm-assign-record :
     1085    MESSAGE
     1086          "Object ":U THIS-PROCEDURE:FILE-NAME
     1087            "must have at least one Enabled Table to perform Assign.":U
     1088              VIEW-AS ALERT-BOX ERROR.
     1089      RETURN.
     1090     END PROCEDURE.
     1091   PROCEDURE adm-assign-statement :
     1092     RETURN.
     1093   END PROCEDURE.
     1094   PROCEDURE adm-cancel-record :
     1095      RETURN.
     1096     END PROCEDURE.
     1097   PROCEDURE adm-copy-record :
     1098       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1099        "must have at least one Enabled Table to perform Copy.":U
     1100          VIEW-AS ALERT-BOX ERROR.
     1101       RETURN.
     1102   END PROCEDURE.
     1103   PROCEDURE adm-create-record :
     1104      RETURN.
     1105   END PROCEDURE.
     1106   PROCEDURE adm-current-changed :
     1107     RETURN.
     1108   END PROCEDURE.
     1109   PROCEDURE adm-delete-record :
     1110    MESSAGE
     1111          "Object ":U THIS-PROCEDURE:FILE-NAME
     1112            "must have at least one Enabled Table to perform Delete.":U
     1113              VIEW-AS ALERT-BOX ERROR.
     1114       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
     1115       RETURN.
     1116   END PROCEDURE.
     1117   PROCEDURE adm-disable-fields :
     1118         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
     1119       RETURN.
     1120   END PROCEDURE.
     1121   PROCEDURE adm-enable-fields :
     1122       RETURN.
     1123   END PROCEDURE.
     1124   PROCEDURE adm-end-update :
     1125     RETURN.
     1126   END PROCEDURE.
     1127   PROCEDURE adm-reset-record :
     1128       RETURN.
     1129   END PROCEDURE.
     1130   PROCEDURE adm-update-record :
     1131       MESSAGE
     1132         "Object ":U THIS-PROCEDURE:FILE-NAME
     1133           "must have at least one Enabled Table to perform Update.":U
     1134             VIEW-AS ALERT-BOX ERROR.
     1135      RETURN.
     1136   END PROCEDURE.
     1137   PROCEDURE check-modified :
     1138   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1139   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1140   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1141   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1142     IF check-state = "check":U THEN
     1143     DO:
     1144       RUN get-link-handle IN adm-broker-hdl
     1145         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1146            OUTPUT group-target-list).
     1147       IF group-target-list NE "":U THEN
     1148       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1149         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1150         RUN check-modified IN curr-widget ('group-check':U).
     1151         IF RETURN-VALUE NE "":U THEN
     1152         DO:
     1153           RUN check-modified-message(RETURN-VALUE).
     1154           RETURN "":U.
     1155         END.
     1156       END.
     1157     END.
     1158     RETURN "":U.
     1159   END PROCEDURE.
     1160   PROCEDURE check-modified-message :
     1161     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1162        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1163           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1164        IF RETURN-VALUE = "YES":U THEN
     1165           RUN notify ('view,CONTAINER-SOURCE':U).
     1166        MESSAGE IF p-changed-table NE ? THEN
     1167           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1168           ELSE "Current values have been changed."
     1169           SKIP "  Do you wish to save those changes?"
     1170           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1171        IF ANS THEN
     1172        DO:
     1173           IF group-assign-target THEN
     1174             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1175           ELSE RUN dispatch('update-record':U).
     1176           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1177           DO:
     1178               MESSAGE "Changes to the previous record were not saved."
     1179                 VIEW-AS ALERT-BOX ERROR.
     1180               IF group-assign-target THEN
     1181                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1182               ELSE RUN dispatch ('cancel-record':U).
     1183           END.
     1184        END.
     1185        ELSE DO:
     1186          IF group-assign-target THEN
     1187             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1188          ELSE RUN dispatch('cancel-record':U).
     1189        END.
     1190        RETURN.
     1191   END PROCEDURE.
     1192   PROCEDURE get-rowid :
     1193       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1194       ASSIGN
     1195       p-table   =   adm-first-table.
     1196       RETURN.
     1197   END PROCEDURE.
     1198   PROCEDURE init-group-assign :
     1199       RUN request-attribute IN adm-broker-hdl
     1200         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1201       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1202         group-assign-target = yes.
     1203       ELSE group-assign-target = no.
     1204       RETURN.
     1205   END PROCEDURE.
     1206   PROCEDURE set-editors :
     1207       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1208       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1209       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1210       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1211       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1212       DO WHILE VALID-HANDLE (curr-widget):
     1213           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1214              curr-widget:HIDDEN = no THEN DO:
     1215             CASE p-field-setting:
     1216               WHEN "INITIALIZE":U THEN
     1217               DO:
     1218                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1219                     read-only-list +
     1220                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1221                        STRING(curr-widget).
     1222               END.
     1223               WHEN "DISABLE":U OR
     1224               WHEN "ENABLE":U THEN
     1225               DO:
     1226                   curr-widget:SENSITIVE = yes.
     1227                   RUN get-attribute ('Read-Only-Editors':U).
     1228                   IF RETURN-VALUE = ? OR
     1229                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1230                       curr-widget:READ-ONLY =
     1231                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1232               END.
     1233               WHEN "CLEAR":U THEN
     1234                   curr-widget:SCREEN-VALUE = "":U.
     1235             END CASE.
     1236           END.
     1237           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1238       END.
     1239       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1240         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1241           + '"':U).
     1242       RETURN.
     1243   END PROCEDURE.
     1244   PROCEDURE use-check-modified-all :
     1245    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1246     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1247     RETURN.
     1248   END PROCEDURE.
     1249   PROCEDURE use-create-on-add :
     1250   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1251      RETURN.
     1252   END PROCEDURE.
     1253   PROCEDURE use-initial-lock :
     1254     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1255     ASSIGN adm-initial-lock = p-attr-value.
     1256     RETURN.
     1257   END PROCEDURE.
     1258     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1259   ASSIGN
     1260          FRAME F-Main:SCROLLABLE       = FALSE
     1261          FRAME F-Main:HIDDEN           = TRUE.
     1262   PROCEDURE disable_UI :
     1263     HIDE FRAME F-Main.
     1264     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1265   END PROCEDURE.
     1266   PROCEDURE local-apply-layout :
     1267     RUN dispatch IN THIS-PROCEDURE ( INPUT 'apply-layout':U ) .
     1268   R-all = 1 .
     1269   T-crsa = true .
     1270   display R-all T-crsa with frame F-Main .
     1271   END PROCEDURE.
