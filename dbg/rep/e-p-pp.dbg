      862       field obj-type like ub.clients.obj-type
      863       field obj-code like ub.clients.obj-code
      864       field obj-name like ub.clients.obj-name
      865       INDEX pi IS UNIQUE PRIMARY obj-type obj-code.
      866   def New SHARED temp-table g#post-f NO-UNDO
      867       field obj-type like ub.clients.obj-type
      868       field obj-code like ub.clients.obj-code
      869       field obj-name like ub.clients.obj-name
