      873       INDEX pi IS UNIQUE PRIMARY obj-type obj-code
      874       INDEX p1  obj-name
      875       .
      876   def var  post-grp_recids as character no-undo .
      877   def var ii as integer no-undo .
      878   DEFINE VARIABLE R-all AS INTEGER
      879        VIEW-AS RADIO-SET VERTICAL
      880        RADIO-BUTTONS
      881             "Все товары", 1,
      882   "Только где цена менялась", 2
      883        SIZE 27.63 BY 2.08 NO-UNDO.
      884   DEFINE VARIABLE T-crsa AS LOGICAL INITIAL no
      885        LABEL "Продажные цены"
      886        VIEW-AS TOGGLE-BOX
      887        SIZE 18 BY .83 NO-UNDO.
      888   DEFINE VARIABLE T-det-obj AS LOGICAL INITIAL no
      889        LABEL "Детализировать по объектам"
      890        VIEW-AS TOGGLE-BOX
      891        SIZE 41 BY .79 NO-UNDO.
      892   DEFINE VARIABLE T-nacenka AS LOGICAL INITIAL no
      893        LABEL "Наценка (из группы товара - справочно)"
      894        VIEW-AS TOGGLE-BOX
      895        SIZE 41 BY .79 NO-UNDO.
      896   DEFINE FRAME F-Main
      897        T-crsa AT ROW 6.57 COL 3
      898        R-all AT ROW 2.58 COL 3 NO-LABEL
      899        T-nacenka AT ROW 5.24 COL 3
      900        T-det-obj AT ROW 1.25 COL 3 WIDGET-ID 2
      901       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      902            SIDE-LABELS NO-UNDERLINE THREE-D
      903            AT COL 1 ROW 1 SCROLLABLE .
      904   IF NOT THIS-PROCEDURE:PERSISTENT THEN DO:
      905     MESSAGE "c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\rep\e-p-pp.w should only be RUN PERSISTENT."
