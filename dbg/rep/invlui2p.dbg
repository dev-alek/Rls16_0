      103   procedure create_obj-list :
      104      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      105      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      106      do
      107      on error undo, return error return-value
      108      :
      109         define buffer cli-obj for ub.clients .
      110         define variable p-var as integer no-undo .
      111         define buffer buf_obj-list for obj-list .
      112         find last buf_obj-list  use-index pi no-error .
      113         if available buf_obj-list
      114         then
      115            p-var = buf_obj-list.obj-id + 1.
      116         else
      117            p-var = 1.
      118         find first cli-obj where
      119                   cli-obj.obj-type = p-obj-type
      120               and cli-obj.obj-code = p-obj-code
      121         no-lock no-error.
      122         if available cli-obj
      123         then do:
      124            create buf_obj-list.
      125            assign
      126               buf_obj-list.obj-id   = p-var
      127               buf_obj-list.obj-code = cli-obj.obj-code
      128               buf_obj-list.obj-type = cli-obj.obj-type
      129               buf_obj-list.obj-name = cli-obj.obj-name
      130               buf_obj-list.db-num   = cli-obj.db-num
      131            .
      132         end.
      133      end.
      134   end.
