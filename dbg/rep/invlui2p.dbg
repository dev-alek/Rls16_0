      543   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      544   procedure cur-time :
      545      define output parameter p-today as date      no-undo .
      546      define output parameter p-time  as integer   no-undo .
      547     do
      548     on error undo, return error
      549     :
      550       define variable v-date1 as date      no-undo .
      551       define variable v-date2 as date      no-undo .
      552       define variable v-time  as integer   no-undo .
      553       assign
      554         v-date1 = today
      555         v-time  = time
      556         v-date2 = today
      557       .
      558       if v-date1 <> v-date2
      559       then do:
      560         assign
      561           v-date1 = today
      562           v-time  = v-time
      563         .
      564       end.
      565       assign
      566         p-today = v-date1
      567         p-time  = v-time
      568       .
      569     end.
      570   end.
      571   function cur-time-date returns character
      572   :
      573     return string(today, '99/99/9999':U) .
      574   end.
      575   function cur-time-mjd returns decimal
      576   :
      577     define variable v-date as date      no-undo .
      578     define variable v-time as integer   no-undo .
      579     run cur-time in this-procedure
      580       (output v-date
      581       ,output v-time
      582       ) .
      583     return integer(v-date) - 2400002 + (v-time / 86400) .
      584   end.
      585   function cur-time-get-ending-index returns integer
      586   (input p-number as integer
      587   )
      588   :
      589     if p-number < 0
      590     or p-number = ?
      591     then do:
      592       return 1 .
      593     end.
      594     define variable v-rest as integer   no-undo .
      595     assign
      596       p-number = p-number modulo 100
      597     .
      598     if p-number < 20
      599     then do:
      600       assign
      601         v-rest = p-number
      602       .
      603     end.
      604     else do:
      605       assign
      606         v-rest = p-number modulo 10
      607       .
      608     end.
      609     case v-rest :
      610       when 1
      611       then do:
      612         return 2 .
      613       end.
      614       when 2 or
      615       when 3 or
      616       when 4
      617       then do:
      618         return 3 .
      619       end.
      620       otherwise do:
      621         return 1 .
      622       end.
      623     end case .
      624   end.
      625   procedure cur-time-mjd-to-date :
      626      define input  parameter i-mjd-diff as decimal no-undo.
      627      define output parameter o-Date     as date    no-undo.
      628      define output parameter o-Time     as integer no-undo.
      629      define variable v-day-number as integer   no-undo .
      630      if    i-mjd-diff < 0
      631         or i-mjd-diff = ?
      632      then do:
      633         return "?" .
      634      end.
      635      assign
      636         v-day-number = truncate(i-mjd-diff,0).
      637         o-Date = date(v-day-number + 2400002).
      638         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      639     .
      640   end.
      641   function cur-time-mjd-to-string returns character
      642   (input p-mjd-diff as decimal
      643   )
      644   :
      645     define variable v-day-number as integer   no-undo .
      646     define variable v-seconds    as integer   no-undo .
      647     define variable v-hour       as integer   no-undo .
      648     define variable v-min        as integer   no-undo .
      649     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      650     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      651     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      652     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      653     if p-mjd-diff < 0
      654     or p-mjd-diff = ?
      655     then do:
      656       return "?" .
      657     end.
      658     assign
      659       v-day-number = integer(truncate(p-mjd-diff,0))
      660       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      661     .
      662     if v-seconds > 86400
      663     then do:
      664       assign
      665         v-seconds = 86400 - 1
      666       .
      667     end.
      668     if v-seconds < 0
      669     then do:
      670       assign
      671         v-seconds = 0
      672       .
      673     end.
      674     assign
      675       v-hour = truncate(v-seconds / 3600, 0)
      676     .
      677     assign
      678       v-seconds = v-seconds modulo 3600
      679     .
      680     assign
      681       v-min = truncate(v-seconds / 60, 0)
      682     .
      683     assign
      684       v-seconds = v-seconds modulo 60
      685     .
      686     return
      687         (if v-day-number <> 0
      688           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      689           else ""
      690         )
      691       + (if v-day-number <> 0 or v-hour <> 0
      692           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      693           else ""
      694         )
      695       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      696           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      697           else ""
      698         )
      699       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      700       .
      701   end.
      702   function cur-time-string returns character
      703   :
      704     define variable v-date as date      no-undo .
      705     define variable v-time as integer   no-undo .
      706     run cur-time in this-procedure
      707       (output v-date
      708       ,output v-time
      709       ) .
      710     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      711   end.
      712   function cur-time-string-sec returns character
      713   :
      714     define variable v-date as date      no-undo .
      715     define variable v-time as integer   no-undo .
      716     run cur-time in this-procedure
      717       (output v-date
      718       ,output v-time
      719       ) .
      720     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      721   end.
      722   function cur-time-custom  returns character
      723   (input p-prefix as character
      724   ,input p-date-format as character
      725   ,input p-delimiter as character
      726   ,input p-time-format as character
      727   ,input p-suffix as character
      728   )
      729   :
      730     define variable v-date as date      no-undo .
      731     define variable v-time as integer   no-undo .
      732     run cur-time in this-procedure
      733       (output v-date
      734       ,output v-time
      735       ) .
      736     return
      737       p-prefix
      738       + string(v-date, p-date-format)
      739       + p-delimiter
      740       + string(v-time, p-time-format)
      741       + p-suffix
      742       .
      743   end.
      744   function cur-time-print  returns character
      745   :
      746     define variable v-date as date      no-undo .
      747     define variable v-time as integer   no-undo .
      748     run cur-time in this-procedure
      749       (output v-date
      750       ,output v-time
      751       ) .
      752     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      753   end.
      754   function cur-time-datetime returns datetime
      755   :
      756     define variable v-char as character no-undo .
      757     define variable v-datetime as datetime no-undo .
      758     v-char = cur-time-string().
      759     v-datetime = datetime(v-char).
      760     return  v-datetime.
      761   end.
      762   function cur-time-string-msec returns character
      763   :
      764     define variable v-date as datetime  no-undo .
      765     v-date = now.
      766     return string(v-date) .
      767   end.
      768   define temp-table param-to-export no-undo
      769   field param-code     as character
      770   field param-sub-code as character
      771   field param-type     as character
      772   field param-value    as character
      773   field param-comment  as character
      774   index pi is unique primary  param-code     param-sub-code
      775   .
      776   procedure OpenForExcel :
      777      define variable v-ch#ExcelApplication as com-handle no-undo .
      778      define variable v-ch#Workbook         as com-handle no-undo .
      779      define variable v-ch#Worksheet        as com-handle no-undo .
      780      os-delete value( string( session:temp-directory ) +
      781                                 "rpt" + string( g#report-num ) + ".txt":U ) .
      782      os-delete value( string( session:temp-directory ) +
      783                                 "rpt" + string( g#report-num ) + ".frm":U ) .
      784      os-delete value( string( session:temp-directory ) +
      785                                 "rpt" + string( g#report-num ) + ".txl":U ) .
      786      if Make-Excel
      787      then do:
      788         output stream ForExcel to value( string( session:temp-directory +
      789                                        "rpt" + string( g#report-num ) + ".txt":U ) ) .
      790         assign
      791            v-excel-file = string( session:temp-directory + "rpt" + string( g#report-num ) )
      792            number-list = 1
      793         .
      794         if make-excel-com
      795         then do:
      796   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      797   if valid-handle(ch#WorkSheet) then
      798   RELEASE OBJECT ch#WorkSheet no-error.
      799   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      800   if valid-handle(ch#Workbook) then
      801   RELEASE OBJECT ch#Workbook no-error.
      802   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      803   if valid-handle(ch#ExcelApplication) then
      804   RELEASE OBJECT ch#ExcelApplication no-error.
      805            create "Excel.Application" ch#excelApplication connect no-error.
      806            if error-status:error
      807            then do :
      808           create "Excel.Application" ch#excelApplication no-error.
      809       if error-status :error then do:
      810           message
      811           "Ошибка при запуске Excel" skip
      812           error-status :get-message(1) skip
      813           view-as alert-box error .
      814           undo, return error .
      815       end.
      816            end.
      817            assign
      818               num#str#  = 0.
      819               v-ch#excelApplication  = ch#excelApplication.
      820               v-ch#excelApplication:Interactive = false.
      821               v-ch#excelApplication:ScreenUpdating = false.
      822               v-ch#excelApplication:Visible = false.
      823               ch#Workbook  = v-ch#excelApplication:Workbooks:add ().
      824               ch#WorkSheet = v-ch#excelApplication:Sheets:Item (1).
      825               v-ch#Worksheet = ch#WorkSheet.
      826               v-ch#Worksheet:Range ("A1"):Font:Bold = true.
      827               v-ch#Worksheet:Range ("A1"):Font:Size = 14.
      828               v-ch#Worksheet:Range ("A1"):HorizontalAlignment = -4131.
      829               v-ch#Worksheet:Range ("A1"):VerticalAlignment   = -4160
      830            no-error .
      831            if error-status:error
      832            then do:
      833               Make-Excel-com = false .
      834               Make-Excel = false .
      835               output Stream  ForExcel close.
      836               os-delete value( string( session:temp-directory ) +
      837                              "rpt" + string( g#report-num ) + ".txt":U ) .
      838               os-delete value( string( session:temp-directory ) +
      839                              "rpt" + string( g#report-num ) + ".frm":U ) .
      840               return.
      841            end.
      842         end.
      843      end.
      844   end.
      845   procedure CloseForExcel :
      846      define variable ii as integer no-undo .
      847      define variable vsheet-num as integer no-undo.
      848      if Make-Excel
      849      then  do:
      850         output Stream  ForExcel close.
      851         os-delete value( string( session:temp-directory ) +
      852                                "rpt" + string( g#report-num ) + ".txt":U ) .
      853         os-delete value( string( session:temp-directory ) +
      854                                "rpt" + string( g#report-num ) + ".frm":U ) .
      855         define buffer buf_sheetf for sheetf.
      856         find last buf_sheetf no-error .
      857         if available buf_sheetf
      858         then
      859            vsheet-num = buf_sheetf.sheet-num.
      860         if vsheet-num > 1
      861         then do:
      862            do ii = 2 to vsheet-num:
      863               os-delete value( string( session:temp-directory ) +
      864                                     "rpt" + string( g#report-num ) + ".":U  + string(ii)) .
      865            end.
      866         end.
      867   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      868   if valid-handle(ch#WorkSheet) then
      869   RELEASE OBJECT ch#WorkSheet no-error.
      870   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      871   if valid-handle(ch#Workbook) then
      872   RELEASE OBJECT ch#Workbook no-error.
      873   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      874   if valid-handle(ch#ExcelApplication) then
      875   RELEASE OBJECT ch#ExcelApplication no-error.
      876      end.
      877   end.
      878   run get-report-num  in parParentProc ( output g#report-num ).
      879   assign
      880     make-excel = yes.
      881   run openforexcel in this-procedure .
      882   run rep/invluipr.p (parParentProc , input table tt-result).
      883   run closeforexcel in this-procedure .
