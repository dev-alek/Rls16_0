     1040       define variable v-outares   as character     no-undo.
     1041       define variable v-outsend   as character     no-undo.
     1042       define variable v-outasend  as character     no-undo.
     1043       define variable v-outprops  as character     no-undo.
     1044       define variable v-outnum    as character     no-undo.
     1045       define variable v-outprim   as character     no-undo.
     1046       define variable v-outdisc   as character     no-undo.
     1047       define variable v-outsubs   as character     no-undo.
     1048       define variable v-outrecv   as character     no-undo.
     1049       define variable v-outegrp   as character     no-undo.
