     1059       define variable v-outR      as character     no-undo.
     1060       define variable v-outB      as character     no-undo.
     1061       define variable v-outC      as character     no-undo.
     1062       assign
     1063           v-torgconf-outdate  = no
     1064           v-torgconf-outnum   = no
     1065           v-torgconf-outprim  = no
     1066           v-torgconf-outdisc  = no
     1067           v-torgconf-outsubs  = no
     1068           v-torgconf-outrecv  = no
     1069           v-torgconf-outegrp  = no
     1070           v-torgconf-outt12   = no
     1071           v-torgconf-outappr  = no
     1072           v-torgconf-outrubl  = no
     1073           v-torgconf-outhold  = no
     1074           v-torgconf-outobj   = no
     1075           v-torgconf-outexlst = no
     1076           v-torgconf-outexpas = "":U
     1077           v-torgconf-outprncd = yes
     1078           v-torgconf-outares  = no
     1079           v-torgconf-outsend  = no
     1080           v-torgconf-outasend  = no
     1081           v-torgconf-outprops  = no
     1082           v-form-name          = p-form-name
     1083       .
     1084   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1085   empty temp-table thbjattr_thbj-attr.
     1086   run adm/shattri.p (
     1087      input "get":U
     1088     ,input ''
     1089     ,input 0
     1090     ,input 'prt-glob':U
     1091     ,input  ""
     1092     ,output v-value-character
     1093     ,output v-value-date
     1094     ,output v-value-decimal
     1095     ,output v-value-integer
     1096     ,output v-value-logical
     1097     ,output par-type
     1098     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1099     ) no-error .
     1100   for each thbjattr_thbj-attr :
     1101       if thbjattr_thbj-attr.prop-code = 'outprncd':U then v-outprncd =  string(thbjattr_thbj-attr.property-value-logical) .
     1102       if thbjattr_thbj-attr.prop-code = 'outrecv':U  then v-outrecv  =  thbjattr_thbj-attr.property-value-character .
     1103       if thbjattr_thbj-attr.prop-code = 'outprops':U then v-outprops =  thbjattr_thbj-attr.property-value-character .
     1104   end.
