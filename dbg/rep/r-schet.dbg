     1106   empty temp-table thbjattr_thbj-attr.
     1107   run adm/shattri.p (
     1108      input "get":U
     1109     ,input p-obj-type
     1110     ,input p-obj-code
     1111     ,input 'prt-obj':U
     1112     ,input  ""
     1113     ,output v-value-character
     1114     ,output v-value-date
     1115     ,output v-value-decimal
     1116     ,output v-value-integer
     1117     ,output v-value-logical
     1118     ,output par-type
     1119     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1120     ) no-error .
     1121   for each thbjattr_thbj-attr :
     1122       if thbjattr_thbj-attr.prop-code = 'outdate':U  then v-outdate  =  thbjattr_thbj-attr.property-value-character .
     1123       if thbjattr_thbj-attr.prop-code = 'outares':U  then v-outares  =  thbjattr_thbj-attr.property-value-character .
     1124       if thbjattr_thbj-attr.prop-code = 'outnum':U   then v-outnum   =  thbjattr_thbj-attr.property-value-character .
     1125       if thbjattr_thbj-attr.prop-code = 'outprim':U  then v-outprim  =  thbjattr_thbj-attr.property-value-character .
     1126       if thbjattr_thbj-attr.prop-code = 'outdisc':U  then v-outdisc  =  thbjattr_thbj-attr.property-value-character .
     1127       if thbjattr_thbj-attr.prop-code = 'outsubs':U  then v-outsubs  =  thbjattr_thbj-attr.property-value-character .
     1128       if thbjattr_thbj-attr.prop-code = 'outegrp':U  then v-outegrp  =  thbjattr_thbj-attr.property-value-character .
     1129       if thbjattr_thbj-attr.prop-code = 'outt12':U   then v-outt12   =  thbjattr_thbj-attr.property-value-character .
     1130       if thbjattr_thbj-attr.prop-code = 'outappr':U  then v-outappr  =  thbjattr_thbj-attr.property-value-character .
     1131       if thbjattr_thbj-attr.prop-code = 'outrubl':U  then v-outrubl  =  thbjattr_thbj-attr.property-value-character .
     1132       if thbjattr_thbj-attr.prop-code = 'outhold':U  then v-outhold  =  thbjattr_thbj-attr.property-value-character .
     1133       if thbjattr_thbj-attr.prop-code = 'outobj':U   then v-outobj   =  thbjattr_thbj-attr.property-value-character .
     1134       if thbjattr_thbj-attr.prop-code = 'outsend':U  then v-outsend  =  thbjattr_thbj-attr.property-value-character .
     1135       if thbjattr_thbj-attr.prop-code = 'outasend':U then v-outasend =  thbjattr_thbj-attr.property-value-character .
     1136       if thbjattr_thbj-attr.prop-code = 'outogr':U   then v-torgconf-outogr   =  thbjattr_thbj-attr.property-value-character .
     1137       if thbjattr_thbj-attr.prop-code = 'outR':U     then v-torgconf-outR     =  thbjattr_thbj-attr.property-value-character .
     1138       if thbjattr_thbj-attr.prop-code = 'outB':U     then v-torgconf-outB     =  thbjattr_thbj-attr.property-value-character .
     1139       if thbjattr_thbj-attr.prop-code = 'outssdoc':U then v-torgconf-outssdoc =  thbjattr_thbj-attr.property-value-character .
     1140       if thbjattr_thbj-attr.prop-code = 'outC':U     then v-torgconf-outC     =  thbjattr_thbj-attr.property-value-character .
     1141   end.
     1142       run gbl/conf-rd.p ("outexpas", "":U, "":U, 0, "":U, "":U, "":U, no, output v-torgconf-outexpas, output v-par-type) no-error.
     1143       if error-status :error
     1144       then do:
     1145           assign
     1146               v-torgconf-outexpas = "":U
     1147           .
     1148       end.
     1149       assign
     1150           v-torgconf-outprncd = ( v-outprncd = "yes":U )
     1151       .
     1152       if p-form-name <> ""
     1153       and p-form-name <> ?
     1154       then do:
     1155           run gbl/conf-rd.p ("outexlst" , p-host-code, p-obj-type, p-obj-code, "", "", "", no, output v-outexlst , output v-par-type) no-error.
     1156           if error-status :error
     1157           then do:
     1158               assign
     1159                   v-outexlst           = ""
     1160               .
     1161           end.
     1162           if lookup( p-form-name, v-outdate ) <> 0
     1163           then do:
     1164               assign
     1165                   v-torgconf-outdate  = yes
     1166               .
     1167           end.
     1168           if lookup( p-form-name, v-outares ) <> 0
     1169           then do:
     1170               assign
     1171                   v-torgconf-outares  = yes
     1172               .
     1173           end.
     1174           if lookup( p-form-name, v-outnum  ) <> 0
     1175           then do:
     1176               assign
     1177                   v-torgconf-outnum   = yes
     1178               .
     1179           end.
     1180           if lookup( p-form-name, v-outprim ) <> 0
     1181           then do:
     1182               assign
     1183                   v-torgconf-outprim  = yes
     1184               .
     1185           end.
     1186           if lookup( p-form-name, v-outdisc ) <> 0
     1187           then do:
     1188               assign
     1189                   v-torgconf-outdisc  = yes
     1190               .
     1191           end.
     1192           if lookup( p-form-name, v-outsubs ) <> 0
     1193           then do:
     1194               assign
     1195                   v-torgconf-outsubs  = yes
     1196               .
     1197           end.
     1198           if lookup( p-form-name, v-outrecv ) <> 0
     1199           then do:
     1200               assign
     1201                   v-torgconf-outrecv  = yes
     1202               .
     1203           end.
     1204           if lookup( p-form-name, v-outegrp ) <> 0
     1205           then do:
     1206               assign
     1207                   v-torgconf-outegrp  = yes
     1208               .
     1209           end.
     1210           if lookup( p-form-name, v-outt12  ) <> 0
     1211           then do:
     1212               assign
     1213                   v-torgconf-outt12   = yes
     1214               .
     1215           end.
     1216           if lookup( p-form-name, v-outappr  ) <> 0
     1217           then do:
     1218               assign
     1219                   v-torgconf-outappr   = yes
     1220               .
     1221           end.
     1222           if lookup( p-form-name, v-outrubl  ) <> 0
     1223           then do:
     1224               assign
     1225                   v-torgconf-outrubl   = yes
     1226               .
     1227           end.
     1228           if lookup( p-form-name, v-outhold  ) <> 0
     1229           then do:
     1230               assign
     1231                   v-torgconf-outhold   = yes
     1232               .
     1233           end.
     1234           if lookup( p-form-name, v-outobj   ) <> 0
     1235           then do:
     1236               assign
     1237                   v-torgconf-outobj    = yes
     1238               .
     1239           end.
     1240           if lookup( p-form-name, v-outsend   ) <> 0
     1241           then do:
     1242               assign
     1243                   v-torgconf-outsend    = yes
     1244               .
     1245           end.
     1246           if lookup( p-form-name, v-outasend   ) <> 0
     1247           then do:
     1248               assign
     1249                   v-torgconf-outasend    = yes
     1250               .
     1251           end.
     1252           if lookup( p-form-name, v-outprops   ) <> 0
     1253           then do:
     1254               assign
     1255                   v-torgconf-outprops    = yes
     1256               .
     1257           end.
     1258           if lookup( p-form-name, v-outexlst ) <> 0
     1259           then do:
     1260               assign
     1261                   v-torgconf-outexlst  = yes
     1262               .
     1263           end.
     1264        assign
     1265         v-name = p-form-name.
     1266   end.
     1267   end.
     1268   end procedure.
     1269   procedure torgconf-get-self-param :
     1270   define input parameter p-obj-type           as character        no-undo.
     1271   define input parameter p-obj-code           as integer          no-undo.
     1272   define input parameter p-curr-code          as integer          no-undo.
     1273       define variable v-host-code    as integer      no-undo.
     1274       define variable v-par-type     as character    no-undo.
     1275   do
     1276   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message(1))
     1277   :
     1278   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1279   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1280     (input  p-obj-type
     1281     ,input  p-obj-code
     1282     ,output v-host-code
     1283     )  .
     1284       if v-torgconf-outhold = yes
     1285       then do:
     1286           run torgconf-get-holdfirm-code in this-procedure (
     1287                 input p-obj-type
     1288               , input p-obj-code
     1289               , output v-torgconf-self-host-code
     1290           ).
     1291           if v-torgconf-self-host-code = 0
     1292           then do:
     1293               return error.
     1294           end.
     1295       end.
     1296       else do:
     1297           assign
     1298               v-torgconf-self-host-code = v-host-code
     1299           .
     1300       end.
     1301       if v-torgconf-self-host-code = 0
     1302       then do:
     1303           assign
     1304               v-torgconf-self-host-name           = "":U
     1305               v-torgconf-self-host-addres         = "":U
     1306               v-torgconf-self-host-post-addres    = "":U
     1307               v-torgconf-self-host-phone          = "":U
     1308               v-torgconf-self-host-inn            = "":U
     1309               v-torgconf-self-host-kpp            = "":U
     1310               v-torgconf-self-host-okpo           = "":U
     1311               v-torgconf-self-host-egrip-date     = "":U
     1312               v-torgconf-self-host-egrip-num      = "":U
     1313           .
     1314       end.
     1315       else do:
     1316           run fmtcli-get-client in this-procedure (
     1317                 input 'орг':U
     1318               , input v-torgconf-self-host-code
     1319           ).
     1320           assign
     1321               v-torgconf-self-host-name        = v-fmtcli-name
     1322               v-torgconf-self-host-engl-name   = v-fmtcli-engl-name
     1323               v-torgconf-self-host-addres      = v-fmtcli-full-addres
     1324               v-torgconf-self-host-post-addres = v-fmtcli-post-addres
     1325               v-torgconf-self-host-phone       = v-fmtcli-phone
     1326               v-torgconf-self-host-inn         = v-fmtcli-inn
     1327               v-torgconf-self-host-kpp         = v-fmtcli-kpp
     1328               v-torgconf-self-host-okpo        = v-fmtcli-okpo
     1329           .
     1330           run gbl/clntat-v.p (
     1331                 input 'орг':U
