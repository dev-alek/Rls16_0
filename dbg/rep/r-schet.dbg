      952   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      953   procedure wthcattr-sprcli :
      954   define input parameter parparentproc  as widget-handle no-undo.
      955   define input parameter p-mode  as character no-undo.
      956   define input-output parameter p-value as character no-undo .
      957   define output parameter p-setted as logical no-undo .
      958     DEFINE VARIABLE v-value as character no-undo .
      959     define variable v-cli-type as character no-undo .
      960     define variable v-cli-code as integer no-undo .
      961     define buffer buf_clients   for ub.clients.
      962     define variable v_rid as character no-undo.
      963     define variable ref-rec as recid no-undo .
      964     do
      965     on error undo, return error
      966     :
      967         v-value = p-value.
      968      if p-value <> '':U then do:
      969       assign
      970       v-cli-type = substring(p-value, 1, 3)
      971       v-cli-code = integer(substring(p-value, 4))
      972       no-error.
      973       if error-status:error then do:
      974         assign
      975         v-cli-type = '':U
      976         v-cli-code = 0
      977         .
      978       end.
      979      end.
      980      FIND FIRST buf_clients NO-LOCK WHERE
      981               buf_clients.obj-type = v-cli-type AND
      982               buf_clients.obj-code = v-cli-code  NO-ERROR.
      983      IF available(buf_clients) then do:
      984       run ref/cli-all.w (
      985                   input parparentproc
      986                  ,input if p-mode = 'ИЗМЕНЕНИЕ':U then "b-sel":U else "":U
      987                  ,input v-cli-type
      988                  ,input 'все':U
      989                  ,input 'все':U
      990                  ,input RECID( buf_clients )
      991                  ,input ",,,,,,NO"
      992                  ,input ?
      993                  ,OUTPUT v_rid ).
      994     END.
      995     ELSE if p-mode = 'ИЗМЕНЕНИЕ':U then DO:
      996       run ref/cli-all.w (
      997                    input parparentproc
      998                   ,INPUT "b-sel":U
      999                  ,input  v-cli-type
     1000                  ,input 'все':U
     1001                  ,input 'текущие':U
     1002                  ,input ?
     1003                  ,input ",,,,,,NO"
     1004                  ,input ?
     1005                  ,OUTPUT v_rid ).
     1006     END.
     1007     else do:
     1008       message
     1009       if p-value = "":U then 'Атрибут не задан!'
     1010       else substitute('Не найден клиент &1',p-value)
     1011       view-as alert-box warning.
     1012     end.
     1013     IF v_rid <> ? AND v_rid <> "":U THEN DO:
     1014       ASSIGN ref-rec = INT( v_rid ) NO-ERROR.
     1015       IF ERROR-STATUS:ERROR THEN DO:
     1016           RETURN NO-APPLY.
     1017       END.
     1018       FIND FIRST buf_clients NO-LOCK WHERE
     1019                  RECID( buf_clients ) = ref-rec NO-ERROR.
     1020       IF AVAIL buf_clients THEN DO:
     1021         v-value = buf_clients.obj-type + string(buf_clients.obj-code, ">>>>>>>>9").
     1022       end.
     1023     end.
     1024     if v-value <> p-value then do:
     1025       p-value = v-value.
     1026       p-setted = yes.
     1027     end.
     1028     end.
     1029   end procedure.
     1030     define new global shared variable g#wthcalib as handle no-undo.
     1031   procedure torgconf-read :
     1032   do
     1033   on error undo, return error
     1034   :
