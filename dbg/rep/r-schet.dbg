     3732     define variable v-cntxp-down-pay        like ub.store.down-pay        no-undo.
     3733     define variable v-cntxp-inv-pay         like ub.store.inv-pay         no-undo.
     3734     define variable v-cntxp-chk-pay         like ub.store.chk-pay         no-undo.
     3735     define variable v-cntxp-retail          like ub.sysconf.ord-prt       no-undo.
     3736     define variable v-cntxp-osn-base        like ub.sysconf.osn-base      no-undo.
     3737     define variable v-cntxp-conf-par        as   character                no-undo.
     3738     define variable v-cntxp-par-type        as   character                no-undo.
     3739     define variable v-cntxp-curr-host-code  like ub.store.host-code       no-undo.
     3740     define variable v-cntxp-obj-type        like ub.clients.obj-type      no-undo.
     3741     define variable v-cntxp-obj-code        like ub.clients.obj-code      no-undo.
     3742     define variable v-cntxp-db-num          as integer   no-undo .
     3743     define variable v-cntxp-userid          as character no-undo .
     3744     define variable v-cntxp-level           as character no-undo .
     3745     define variable v-cntxp-db-num-obj      as integer   no-undo .
     3746     define variable v-cntxp-is-admin        as logical   no-undo .
     3747     define buffer bf-cntxp_store for ub.store.
     3748     define buffer bf-cntxp_shop  for ub.shop.
     3749     define buffer bf-cntxp_sysconf for ub.sysconf.
     3750   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3751     run mainmenu_getcntxt in parparentproc
     3752       (output v-cntxp-db-num
     3753       ,output v-cntxp-userid
     3754       ,output v-cntxp-level
     3755       ,output v-cntxp-curr-host-code
     3756       ,output v-cntxp-obj-type
     3757       ,output v-cntxp-obj-code
     3758       ,output v-cntxp-db-num-obj
     3759       ,output v-cntxp-is-admin
     3760       ) .
     3761     if (v-cntxp-obj-type = 'маг':U or v-cntxp-obj-type = 'скл':U) and
     3762        v-cntxp-obj-code <> 0 then do:
     3763   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     3764     (input  'is-prt'
     3765     ,input  0
     3766     ,input  ''
     3767     ,input  0
     3768     ,input  ''
     3769     ,input  ''
     3770     ,input  ''
     3771     ,input  yes
     3772     ,output v-cntxp-conf-par
     3773     ,output v-cntxp-par-type
     3774     ) no-error .
     3775       case v-cntxp-obj-type :
     3776         when 'скл':U then do:
     3777           find first bf-cntxp_store where bf-cntxp_store.obj-code = v-cntxp-obj-code no-lock.
     3778           find first bf-cntxp_sysconf where bf-cntxp_sysconf.host-code = bf-cntxp_store.host-code no-lock.
     3779           assign
     3780             v-cntxp-doc-prt         = (v-cntxp-conf-par = "yes") and bf-cntxp_store.doc-prt
     3781             v-cntxp-price-calc      = bf-cntxp_store.price-calc
     3782             v-cntxp-inout-price     = bf-cntxp_store.inout-price
     3783             v-cntxp-unit-cli-perm   = bf-cntxp_store.unit-cli-perm
     3784             v-cntxp-out-rate        = bf-cntxp_store.out-rate
     3785             v-cntxp-out-line-discnt = bf-cntxp_store.out-line-discnt
     3786             v-cntxp-in-ov           = bf-cntxp_store.in-ov
     3787             v-cntxp-in-perm         = bf-cntxp_store.in-perm
     3788             v-cntxp-no-eq           = bf-cntxp_store.no-eq
     3789             v-cntxp-rsrv-time       = bf-cntxp_store.rsrv-time
     3790             v-cntxp-load-time       = bf-cntxp_store.load-time
     3791             v-cntxp-holidays        = bf-cntxp_store.holidays
     3792             v-cntxp-in-pay          = bf-cntxp_store.in-pay
     3793             v-cntxp-out-pay         = bf-cntxp_store.out-pay
     3794             v-cntxp-ret-pay         = bf-cntxp_store.ret-pay
     3795             v-cntxp-ret-sup-pay     = bf-cntxp_store.ret-sup-pay
     3796             v-cntxp-down-pay        = bf-cntxp_store.down-pay
     3797             v-cntxp-inv-pay         = bf-cntxp_store.inv-pay
     3798             v-cntxp-chk-pay         = bf-cntxp_store.chk-pay
     3799             v-cntxp-retail          = bf-cntxp_sysconf.ord-prt
     3800             v-cntxp-osn-base        = bf-cntxp_sysconf.osn-base
     3801             .
     3802         end.
     3803         when 'маг':U then do:
     3804           find first bf-cntxp_shop where bf-cntxp_shop.obj-code = v-cntxp-obj-code no-lock.
     3805           find first bf-cntxp_sysconf where bf-cntxp_sysconf.host-code = bf-cntxp_shop.host-code no-lock.
     3806           assign
     3807             v-cntxp-doc-prt         = (v-cntxp-conf-par = "yes") and bf-cntxp_shop.doc-prt
     3808             v-cntxp-price-calc      = bf-cntxp_shop.price-calc
     3809             v-cntxp-inout-price     = bf-cntxp_shop.inout-price
     3810             v-cntxp-unit-cli-perm   = bf-cntxp_shop.unit-cli-perm
     3811             v-cntxp-out-rate        = bf-cntxp_shop.out-rate
     3812             v-cntxp-out-line-discnt = bf-cntxp_shop.out-line-discnt
     3813             v-cntxp-in-ov           = bf-cntxp_shop.in-ov
     3814             v-cntxp-in-perm         = bf-cntxp_shop.in-perm
     3815             v-cntxp-no-eq           = bf-cntxp_shop.no-eq
     3816             v-cntxp-rsrv-time       = bf-cntxp_shop.rsrv-time
     3817             v-cntxp-load-time       = bf-cntxp_shop.load-time
     3818             v-cntxp-holidays        = bf-cntxp_shop.holidays
     3819             v-cntxp-in-pay          = bf-cntxp_shop.in-pay
     3820             v-cntxp-out-pay         = bf-cntxp_shop.out-pay
     3821             v-cntxp-ret-pay         = bf-cntxp_shop.ret-pay
     3822             v-cntxp-ret-sup-pay     = bf-cntxp_shop.ret-sup-pay
     3823             v-cntxp-down-pay        = bf-cntxp_shop.down-pay
     3824             v-cntxp-inv-pay         = bf-cntxp_shop.inv-pay
     3825             v-cntxp-chk-pay         = bf-cntxp_shop.chk-pay
     3826             v-cntxp-retail          = bf-cntxp_sysconf.ord-prt
     3827             v-cntxp-osn-base        = bf-cntxp_sysconf.osn-base
     3828             .
     3829         end.
     3830       end case.
     3831     end.
     3832   DEFINE  BUFFER t-doc FOR trn-doc.
     3833   DEFINE  BUFFER buf_clients FOR clients.
     3834   DEFINE new shared  STREAM Out_Stream .
     3835   output STREAM Out_Stream to value( string( session:temp-directory +
     3836                                        "rpt" + string( g#report-num ) ) )
     3837                                        page-size 62 .
     3838   def buffer      Our_Object for clients.
     3839   def buffer      Our_Host for clients.
     3840   FIND t-doc WHERE recid(t-doc) = rec_id  NO-LOCK NO-ERROR.
     3841   FIND buf_clients WHERE buf_clients.obj-type = t-doc.cli-type and
     3842                                     buf_clients.obj-code = t-doc.cli-code NO-LOCK.
     3843   FIND Our_Object WHERE Our_Object.obj-type = t-doc.obj-type and
     3844                                             Our_Object.obj-code = t-doc.obj-code NO-LOCK.
     3845   FIND Our_Host WHERE Our_Host.obj-type = 'орг':U and
     3846                                             Our_Host.obj-code = t-doc.host-code NO-LOCK.
     3847   def buffer     cli-pbank    for     clients .
     3848   def buffer     cli-obj    for     clients .
     3849   def var     LogRes       as      log            no-undo.
     3850   def var     s1               as      character             no-undo.
     3851   def var     s2               as      character             no-undo.
     3852   def var     Wrkr_name as      character             no-undo.
     3853   def var     Isp_name as      character             no-undo.
     3854   FIND Our_Host WHERE Our_Host.obj-type = 'орг':U AND Our_Host.obj-code = t-doc.host-code NO-LOCK.
     3855   FIND firm WHERE firm.firm-code = Our_Host.obj-code NO-LOCK.
     3856     define variable v-curr-code as integer   no-undo .
     3857     if printRubl = yes then assign v-curr-code = 0 .
     3858     else do:
     3859   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3860   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     3861     (input  t-doc.host-code
     3862     ,output v-curr-code
     3863     )  .
     3864     end.
     3865     run torgconf-get-self-param in this-procedure ( input t-doc.obj-type, input t-doc.obj-code, input v-curr-code) no-error.
     3866     if error-status :error then do:
     3867       message
     3868         vss-workfile vss-revision vss-description   skip "Ошибка чтения параметров объекта документа."  skip return-value
     3869         skip trim(error-status :get-message(1))   trim(error-status :get-message(2))  trim(error-status :get-message(3))
     3870       view-as alert-box warning.
     3871     end.
     3872     PUT STREAM Out_Stream
     3873       space(6) ( string( Our_Host.obj-name , "X(60)" ) +
     3874       ( if v-torgconf-self-schet-exists then ( "Р/c " + v-torgconf-self-bank-r-schet + ' в "' + v-torgconf-self-bank-name + '" ' ) else " " ) )  format "X(130)" SKIP
     3875       space(6) ( string( trim( firm.city ) + " " + string( firm.ind ) , "X(60)" ) +
     3876       ( if v-torgconf-self-schet-exists then ( "к/с " + v-torgconf-self-bank-c-schet + ", БИК " + v-torgconf-self-bank-bik +
     3877       ( if available firm then ( ", ИНН " + trim( firm.inn ) ) else "" ) ) else " " ) )  format "X(130)" SKIP .
     3878     PUT STREAM Out_Stream
     3879       space(6) ( string( firm.addres1, "x(60)" ) +
     3880       ( if available firm then ( "ОКОНХ " + trim( string( firm.okonh, "x(61)" ) ) ) else "" ) ) format "X(131)" SKIP .
     3881     if firm.addres2 <> "" then  PUT STREAM Out_Stream SPACE(6) firm.addres2 format "X(130)" SKIP .
     3882     PUT STREAM Out_Stream SPACE(6)  "тел." + firm.phone + ", факс " + firm.fax format "X(130)" .
     3883     PUT STREAM Out_Stream " " SKIP .
     3884   s1 = fill("-", 140).
     3885   FIND cli-obj WHERE cli-obj.obj-type = t-doc.obj-type AND
     3886                                     cli-obj.obj-code = t-doc.obj-code NO-LOCK .
     3887   if p-mode <> "mag"
     3888   then do:
     3889       PUT STREAM Out_Stream SPACE(22) s1 format "X(72)" SKIP .
     3890       PUT STREAM Out_Stream
     3891               SPACE(22) "Грузоотправитель : " + Our_Host.obj-name format "X(100)" SKIP
     3892               space(41) cli-obj.obj-name format "X(90)" SKIP
     3893               SPACE(22) s1 format "X(72)" SKIP
     3894               SPACE(22) "Грузополучатель  : " + buf_clients.obj-name + "(" + string(buf_clients.obj-code) + ")" format "X(100)" SKIP
     3895               SPACE(22) s1 format "X(72)" SKIP(1) .
     3896       PUT STREAM Out_Stream
     3897               ( if  t-doc.status_ = 'запрос':U
     3898               then " З А П Р О С   N "
     3899               else "С Ч Е Т       N " ) AT 32 format "X(17)"
     3900                   t-doc.doc-code format "X(10)" "  от  " t-doc.doc-date format "99.99.9999" SKIP
     3901                   s1 format "X(102)" SKIP.
     3902       PUT STREAM Out_Stream SPACE(12)
     3903               SPACE(12) "Плательщик   " + buf_clients.obj-name + "(" + string(buf_clients.obj-code) + ")" format "X(102)" SKIP
     3904               SPACE(12) "Расч. счет  N                        ," format "X(36)" space(2)
     3905                               "Банк                                      Гор. " format "X(50)" SKIP
     3906               SPACE(12) s1 format "X(102)" SKIP
     3907       SPACE(12)
     3908       "Дата отпр.         способ отпр.             Сумма счета ___________   Квит/накл.  N"
     3909       format "X(100)" SKIP
     3910               SPACE(12) "Упаковка        число мест       вес        Отметка об оплате _____"
     3911                       format "X(100)" SKIP(1) .
     3912           PUT STREAM Out_Stream
     3913               SPACE(12) s1 format "X(38)" " В Н И М А Н И Е " format "X(17)" s1 format "X(47)" SKIP .
     3914       if t-doc.status_ <> 'запрос':U then
     3915           PUT STREAM Out_Stream
     3916               SPACE(23) "Срок оплаты до " + string( t-doc.fact-date, "99.99.9999" ) +
     3917                       ". Товар по просроченным счетам отпускается" format "X(100)" SKIP
     3918               SPACE(23) "по цене на момент прихода денег. Товар резервируется на " +
     3919                   ( if v-cntxp-rsrv-time = 0 then "2" else string(v-cntxp-rsrv-time, ">>9") ) + " дней."
     3920                       format "X(100)" SKIP .
     3921       else
     3922           PUT STREAM Out_Stream
     3923               SPACE(32) " ТОВАР  Н Е  З А Р Е З Е Р В И Р О В А Н." format "X(100)" SKIP .
     3924       PUT STREAM Out_Stream SPACE(22) s1 format "X(70)" SKIP(1) .
     3925       FIND pay-type WHERE pay-type.obj-code = t-doc.pay-code NO-LOCK NO-ERROR.
     3926       PUT STREAM Out_Stream
     3927           string( "вид оплаты   :" + ( if available pay-type then pay-type.obj-name else "?" ) ) AT 10 format "X(60)" SKIP
     3928           string( "примечание   :" + ( if ( NOT can-do( 'факт':U, t-doc.status_ ) OR LogRes ) AND NOT ( t-doc.PS BEGINS "@" ) then  t-doc.PS else " " ) ) AT 10 format "X(100)" SKIP .
     3929   end.
     3930   else do:
     3931       PUT STREAM Out_Stream
     3932               skip(3)
     3933               "С Ч Е Т       N "  AT 32 format "X(17)"
     3934                   "" format "X(10)" "  от  " t-doc.doc-date format "99.99.9999" SKIP(1)
     3935           SPACE(12) "Плательщик   " + buf_clients.obj-name + "(" + string(buf_clients.obj-code) + ")" format "X(102)" SKIP.
     3936   end.
     3937   if p-mode <> "mag"
     3938   then do:
     3939       run rep/outp-tbl.p ( parParentProc, rec_id, "no-print", "oldexp" ).
     3940   end.
     3941   else do:
     3942       run rep/outp-tbl.p ( parParentProc, rec_id, "no-print,mag", "oldexp" ).
     3943   end.
