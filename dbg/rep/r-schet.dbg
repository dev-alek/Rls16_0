      931   define variable v-torgconf-sf-buyer-addr        as character    no-undo.
      932   define variable v-torgconf-wth-cargo-to         as character    no-undo.
      933   define variable p-torgconf-date-warrant         as date      no-undo.
      934   define variable p-torgconf-N-warrant            as character no-undo.
