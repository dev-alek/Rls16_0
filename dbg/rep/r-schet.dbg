     3460               no-error.
     3461               if available buf_sysconf
     3462               then do:
     3463                  assign
     3464                     v-torgconf-ogr-post = buf_sysconf.head-position
     3465                  .
     3466               end.
     3467               find first buf_clients no-lock
     3468                  where buf_clients.obj-type = 'орг':U
     3469                  and buf_clients.obj-code = v-host-code
     3470               .
     3471               find first buf_firm no-lock
     3472                  where buf_firm.firm-code = buf_clients.obj-code
     3473               .
     3474               assign
     3475                  v-torgconf-ogr-name = buf_firm.director
     3476               .
     3477            end.
     3478            if v-torgconf-outogr = "dir_obj"
     3479               then do:
     3480               find first buf_wth-doc no-lock
     3481               where buf_wth-doc.doc-code = p-doc-code
     3482               no-error.
     3483                  find first buf_shop no-lock
     3484                  where buf_shop.obj-code = buf_wth-doc.obj-code
     3485                  .
     3486                  assign
     3487                     v-torgconf-ogr-name = buf_shop.director
     3488                     v-torgconf-ogr-post = "Директор"
     3489                  .
     3490               end.
     3491         if v-torgconf-outogr = "manag_doc"
     3492            then do:
     3493               find first buf_wth-doc no-lock
     3494               where buf_wth-doc.doc-code = p-doc-code
     3495               no-error.
     3496               if available buf_wth-doc
     3497               then do:
     3498                  run rep/get-psn.p
     3499                  (input buf_wth-doc.deliver
     3500                  ,output v-torgconf-ogr-name
     3501                  ) .
     3502               end.
     3503               find first buf_person no-lock
     3504               where buf_person.psn-code = buf_wth-doc.deliver
     3505               no-error.
     3506               if available buf_person
     3507               then do:
     3508                  v-torgconf-ogr-post = buf_person.position.
     3509               end.
     3510               if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     3511               if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     3512            end.
     3513      end.
     3514   end.
     3515   end procedure.
     3516   procedure torgconf-get-outogr-param:
     3517       define input parameter p-form-name  as character    no-undo.
     3518       define input parameter p-host-code  as integer      no-undo.
     3519       define input parameter p-obj-type   as character    no-undo.
     3520       define input parameter p-obj-code   as integer      no-undo.
     3521       define input parameter p-doc-code   as character      no-undo.
     3522       define buffer buf_firm          for ub.firm .
     3523       define buffer buf_clients       for ub.clients .
     3524       define buffer buf_sysconf       for ub.sysconf .
     3525       define buffer buf_shop          for ub.shop .
     3526       define buffer buf_store         for ub.store .
     3527       define buffer buf_person        for ub.person .
     3528       define buffer buf_trn-doc       for ub.trn-doc .
     3529       define buffer buf_wth-doc       for ub.wth-doc .
     3530      if  p-form-name <> 'wthtrg12':U
     3531      and p-form-name <> 'wthfct':U
     3532      and p-form-name <> 'wthm11':U
     3533      then do:
     3534       find first buf_trn-doc no-lock
     3535       where buf_trn-doc.doc-code = p-doc-code
     3536       no-error.
     3537       if v-torgconf-outogr = "no_print"
     3538         then do:
     3539            assign
     3540               v-torgconf-ogr-name = ""
     3541               v-torgconf-ogr-post = ""
     3542            .
     3543         end.
     3544      if v-torgconf-outogr  = "ruk_firm"
     3545            then do:
     3546            find first buf_sysconf no-lock
     3547            where buf_sysconf.host-code = p-host-code
     3548            no-error.
     3549            if available buf_sysconf
     3550            then do:
     3551               assign
     3552                  v-torgconf-ogr-post = buf_sysconf.head-position
     3553               .
     3554            end.
     3555            find first buf_clients no-lock
     3556                where buf_clients.obj-type = 'орг':U
     3557                and buf_clients.obj-code = p-host-code
     3558            .
     3559            find first buf_firm no-lock
     3560                where buf_firm.firm-code = buf_clients.obj-code
     3561            .
     3562            assign
     3563                v-torgconf-ogr-name = buf_firm.director
     3564            .
     3565         end.
     3566         if v-torgconf-outogr = "dir_obj"
     3567            then do:
     3568            find first buf_trn-doc no-lock
     3569            where buf_trn-doc.doc-code = p-doc-code
     3570            no-error.
     3571               CASE buf_trn-doc.obj-type:
     3572               WHEN 'маг':U
     3573               THEN DO:
     3574                  find first buf_shop no-lock
     3575                  where buf_shop.obj-code = buf_trn-doc.obj-code
     3576                  .
     3577                  assign
     3578                     v-torgconf-ogr-name = buf_shop.director
     3579                     v-torgconf-ogr-post = "Директор"
     3580                  .
     3581               END.
     3582               WHEN 'скл':U
     3583               THEN DO:
     3584                  find first buf_store no-lock
     3585                  where buf_store.obj-code = buf_trn-doc.obj-code
     3586                  .
     3587                  assign
     3588                     v-torgconf-ogr-name = buf_store.store-boss
     3589                     v-torgconf-ogr-post = "Директор"
     3590                  .
     3591               END.
     3592               OTHERWISE DO:
     3593                  assign
     3594                     v-torgconf-ogr-name = "":U
     3595                     v-torgconf-ogr-post = "":U
     3596                  .
     3597               END.
     3598               END CASE.
     3599            end.
     3600      if v-torgconf-outogr = "manag_doc"
     3601         then do:
     3602            find first buf_trn-doc no-lock
     3603            where buf_trn-doc.doc-code = p-doc-code
     3604            no-error.
     3605            if available buf_trn-doc
     3606            then do:
     3607               run rep/get-psn.p
     3608               (input buf_trn-doc.boss
     3609               ,output v-torgconf-ogr-name
     3610               ) .
     3611            end.
     3612            find first buf_person no-lock
     3613            where buf_person.psn-code = buf_trn-doc.boss
     3614            no-error.
     3615            if available buf_person
     3616            then do:
     3617               v-torgconf-ogr-post = buf_person.position.
     3618            end.
     3619            if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     3620            if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     3621         end.
     3622      end.
     3623      else do:
     3624      find first buf_wth-doc no-lock
     3625         where buf_wth-doc.doc-code = p-doc-code
     3626         no-error.
     3627         if v-torgconf-outogr = "no_print"
     3628            then do:
     3629               assign
     3630                  v-torgconf-ogr-name = ""
     3631                  v-torgconf-ogr-post = ""
     3632               .
     3633            end.
     3634         if v-torgconf-outogr  = "ruk_firm"
     3635               then do:
     3636               find first buf_sysconf no-lock
     3637               where buf_sysconf.host-code = p-host-code
     3638               no-error.
     3639               if available buf_sysconf
     3640               then do:
     3641                  assign
     3642                     v-torgconf-ogr-post = buf_sysconf.head-position
     3643                  .
     3644               end.
     3645               find first buf_clients no-lock
     3646                  where buf_clients.obj-type = 'орг':U
     3647                  and buf_clients.obj-code = p-host-code
     3648               .
     3649               find first buf_firm no-lock
     3650                  where buf_firm.firm-code = buf_clients.obj-code
     3651               .
     3652               assign
     3653                  v-torgconf-ogr-name = buf_firm.director
     3654               .
     3655            end.
     3656            if v-torgconf-outogr = "dir_obj"
     3657               then do:
     3658               find first buf_wth-doc no-lock
     3659               where buf_wth-doc.doc-code = p-doc-code
     3660               no-error.
     3661                  find first buf_shop no-lock
     3662                  where buf_shop.obj-code = buf_wth-doc.obj-code
     3663                  .
     3664                  assign
     3665                     v-torgconf-ogr-name = buf_shop.director
     3666                     v-torgconf-ogr-post = "Директор"
     3667                  .
     3668               end.
     3669         if v-torgconf-outogr = "manag_doc"
     3670            then do:
     3671               find first buf_wth-doc no-lock
     3672               where buf_wth-doc.doc-code = p-doc-code
     3673               no-error.
     3674               if available buf_wth-doc
     3675               then do:
     3676                  run rep/get-psn.p
     3677                  (input buf_wth-doc.deliver
     3678                  ,output v-torgconf-ogr-name
     3679                  ) .
     3680               end.
     3681               find first buf_person no-lock
     3682               where buf_person.psn-code = buf_wth-doc.deliver
     3683               no-error.
     3684               if available buf_person
     3685               then do:
     3686                  v-torgconf-ogr-post = buf_person.position.
     3687               end.
     3688               if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     3689               if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     3690            end.
     3691      end.
     3692   end.
     3693   procedure torgconf-get-reason  :
     3694   define input parameter  p-doc-code       as character        no-undo.
     3695   define input parameter  p-reason-code    as integer          no-undo .
     3696   define input parameter  p-doc-type       as character        no-undo.
     3697       if p-reason-code > 0
     3698       then do:
     3699           define buffer buf_trn-reason for ub.trn-reason.
     3700           find first buf_trn-reason no-lock where buf_trn-reason.reason-code = p-reason-code no-error .
     3701           if available buf_trn-reason then assign v-torgconf-reason =  buf_trn-reason.reason-name .
     3702       end.
     3703       else do:
     3704           if p-doc-type = 'при':U
     3705           then  do:
     3706               define variable v-attr-type     as character    no-undo.
     3707               define variable v-attr-value    as character    no-undo.
     3708               run gbl/trdcat-v.p (input p-doc-code,input 'nids':U,output v-attr-value,output v-attr-type) .
     3709               assign v-torgconf-reason = v-attr-value .
     3710               run gbl/trdcat-v.p (input p-doc-code,input 'dids':U,output v-attr-value,output v-attr-type) .
     3711               assign v-torgconf-reason = v-torgconf-reason + " от " + v-attr-value .
     3712           end.
     3713       end.
     3714   end procedure.
     3715   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3716     define variable v-cntxp-doc-prt         like ub.store.doc-prt         no-undo.
     3717     define variable v-cntxp-price-calc      like ub.store.price-calc      no-undo.
     3718     define variable v-cntxp-inout-price     like ub.store.inout-price     no-undo.
     3719     define variable v-cntxp-unit-cli-perm   like ub.store.unit-cli-perm   no-undo.
     3720     define variable v-cntxp-out-rate        like ub.store.out-rate        no-undo.
