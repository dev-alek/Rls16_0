     1609   procedure torgconf-get-sup-param :
     1610   define input parameter p-obj-type           as character        no-undo.
     1611   define input parameter p-obj-code           as integer          no-undo.
     1612   define input parameter p-curr-code          as integer          no-undo.
     1613       define variable v-host-code    as integer      no-undo.
     1614       define variable v-par-type     as character    no-undo.
     1615   do
     1616   on error undo, return error
     1617   :
     1618       assign
     1619          v-torgconf-sup-host-code = v-host-code
     1620       .
     1621       if v-torgconf-sup-host-code = 0
     1622       then do:
     1623           assign
     1624               v-torgconf-sup-host-name           = "":U
     1625               v-torgconf-sup-host-addres         = "":U
     1626               v-torgconf-sup-host-post-addres    = "":U
     1627               v-torgconf-sup-host-phone          = "":U
     1628               v-torgconf-sup-host-inn            = "":U
     1629               v-torgconf-sup-host-kpp            = "":U
     1630               v-torgconf-sup-host-okpo           = "":U
     1631               v-torgconf-sup-host-egrip-date     = "":U
     1632               v-torgconf-sup-host-egrip-num      = "":U
     1633           .
     1634       end.
     1635       else do:
     1636           run fmtcli-get-client in this-procedure (
     1637                 input 'орг':U
     1638               , input v-torgconf-sup-host-code
     1639           ).
     1640           assign
     1641               v-torgconf-sup-host-name        = v-fmtcli-name
     1642               v-torgconf-sup-host-engl-name   = v-fmtcli-engl-name
     1643               v-torgconf-sup-host-addres      = v-fmtcli-full-addres
     1644               v-torgconf-sup-host-post-addres = v-fmtcli-post-addres
     1645               v-torgconf-sup-host-phone       = v-fmtcli-phone
     1646               v-torgconf-sup-host-inn         = v-fmtcli-inn
     1647               v-torgconf-sup-host-kpp         = v-fmtcli-kpp
     1648               v-torgconf-sup-host-okpo        = v-fmtcli-okpo
     1649           .
     1650           run gbl/clntat-v.p (
     1651                 input 'орг':U
     1652               , input v-torgconf-sup-host-code
     1653               , input 'egrip-date':U
     1654               , output v-torgconf-sup-host-egrip-date
     1655               , output v-par-type
     1656           ).
     1657           run gbl/clntat-v.p (
     1658                 input 'орг':U
     1659               , input v-torgconf-sup-host-code
     1660               , input 'egrip-num':U
     1661               , output v-torgconf-sup-host-egrip-num
     1662               , output v-par-type
     1663           ).
     1664           run fmtcli-get-bank in this-procedure (
     1665                 input v-host-code
     1666               , input 'орг':U
     1667               , input v-torgconf-sup-host-code
     1668               , input p-curr-code
     1669           ).
     1670       end.
     1671       assign
     1672           v-torgconf-sup-schet-exists = v-fmtcli-schet-exists
     1673           v-torgconf-sup-bank-exists  = v-fmtcli-bank-exists
     1674           v-torgconf-sup-bank-r-schet = v-fmtcli-bank-r-schet
     1675           v-torgconf-sup-bank-c-schet = v-fmtcli-bank-c-schet
     1676           v-torgconf-sup-bank-bik     = v-fmtcli-bank-bik
     1677           v-torgconf-sup-bank-name    = v-fmtcli-bank-name
     1678           v-torgconf-sup-bank-addres  = v-fmtcli-bank-addres
     1679           v-torgconf-sup-bank-city    = v-fmtcli-bank-city
     1680       .
     1681       assign
     1682           v-torgconf-sup-obj-type = p-obj-type
     1683           v-torgconf-sup-obj-code = p-obj-code
     1684       .
     1685       if trim(p-obj-type) <> ""
     1686       and p-obj-code <> 0
     1687       then do:
     1688       run fmtcli-get-client in this-procedure (
     1689             input p-obj-type
     1690           , input p-obj-code
     1691       ).
     1692       assign
     1693           v-torgconf-sup-obj-name        = v-fmtcli-name
     1694           v-torgconf-sup-obj-engl-name   = v-fmtcli-engl-name
     1695           v-torgconf-sup-obj-addres      = v-fmtcli-full-addres
     1696           v-torgconf-temp-post-addres    = v-fmtcli-post-addres
     1697           v-torgconf-sup-obj-phone       = v-fmtcli-phone
     1698           v-torgconf-sup-obj-inn         = v-fmtcli-inn
     1699           v-torgconf-sup-obj-okpo        = v-fmtcli-okpo
     1700       .
     1701      end.
     1702      end.
     1703   end procedure.
     1704   procedure torgconf-get-cli-param :
     1705   define input parameter p-host-obj-code      as integer          no-undo.
     1706   define input parameter p-obj-type           as character        no-undo.
     1707   define input parameter p-obj-code           as integer          no-undo.
     1708   define input parameter p-curr-code          as integer          no-undo.
     1709       define variable v-host-code    as integer      no-undo.
     1710   do
     1711   on error undo, return error
     1712   :
     1713       assign
     1714           v-torgconf-cli-type = p-obj-type
     1715           v-torgconf-cli-code = p-obj-code
     1716       .
     1717       run fmtcli-get-client in this-procedure (
     1718             input p-obj-type
     1719           , input p-obj-code
     1720       ).
     1721       assign
     1722           v-torgconf-cli-name         = trim( v-fmtcli-name          )
     1723           v-torgconf-cli-engl-name    = trim( v-fmtcli-engl-name          )
     1724           v-torgconf-cli-addres       = trim( v-fmtcli-full-addres   )
     1725           v-torgconf-cli-post-addres  = trim( v-fmtcli-post-addres   )
     1726           v-torgconf-cli-phone        = trim( v-fmtcli-phone         )
     1727           v-torgconf-cli-inn          = trim( v-fmtcli-inn           )
     1728           v-torgconf-cli-kpp          = trim( v-fmtcli-kpp           )
     1729           v-torgconf-cli-okpo         = trim( v-fmtcli-okpo          )
     1730       .
     1731      run fmtcli-get-bank in this-procedure (
     1732             input p-host-obj-code
     1733           , input p-obj-type
     1734           , input p-obj-code
     1735           , input p-curr-code
     1736       ).
     1737       assign
     1738           v-torgconf-cli-schet-exists = v-fmtcli-schet-exists
     1739           v-torgconf-cli-bank-exists  = v-fmtcli-bank-exists
     1740           v-torgconf-cli-bank-r-schet = v-fmtcli-bank-r-schet
     1741           v-torgconf-cli-bank-c-schet = v-fmtcli-bank-c-schet
     1742           v-torgconf-cli-bank-bik     = v-fmtcli-bank-bik
     1743           v-torgconf-cli-bank-name    = v-fmtcli-bank-name
     1744           v-torgconf-cli-bank-addres  = v-fmtcli-bank-addres
     1745           v-torgconf-cli-bank-city    = v-fmtcli-bank-city
     1746       .
     1747   end.
     1748   end procedure.
     1749   procedure torgconf-get-ship-param :
     1750   define input parameter p-host-obj-code      as integer          no-undo.
     1751   define input parameter p-obj-type           as character        no-undo.
     1752   define input parameter p-obj-code           as integer          no-undo.
     1753   define input parameter p-curr-code          as integer          no-undo.
     1754       define variable v-host-code    as integer      no-undo.
     1755   do
     1756   on error undo, return error
     1757   :
     1758       assign
     1759           v-torgconf-ship-type = p-obj-type
     1760           v-torgconf-ship-code = p-obj-code
     1761       .
     1762       if trim(p-obj-type) = ""
     1763       and p-obj-code = 0
     1764       then do:
     1765       assign
     1766           v-torgconf-ship-name         = "":U
     1767           v-torgconf-ship-addres       = "":U
     1768           v-torgconf-ship-post-addres  = "":U
     1769           v-torgconf-ship-phone        = "":U
     1770           v-torgconf-ship-inn          = "":U
     1771           v-torgconf-ship-kpp          = "":U
     1772           v-torgconf-ship-okpo         = "":U
     1773       .
     1774       end.
     1775       else do:
     1776       run fmtcli-get-client in this-procedure (
     1777             input p-obj-type
     1778           , input p-obj-code
     1779       ).
     1780       assign
     1781           v-torgconf-ship-name         = trim( v-fmtcli-name          )
     1782           v-torgconf-ship-engl-name    = trim( v-fmtcli-engl-name          )
     1783           v-torgconf-ship-addres       = trim( v-fmtcli-full-addres   )
     1784           v-torgconf-ship-post-addres  = trim( v-fmtcli-post-addres   )
     1785           v-torgconf-ship-phone        = trim( v-fmtcli-phone         )
     1786           v-torgconf-ship-inn          = trim( v-fmtcli-inn           )
     1787           v-torgconf-ship-kpp          = trim( v-fmtcli-kpp           )
     1788           v-torgconf-ship-okpo         = trim( v-fmtcli-okpo          )
     1789       .
     1790       end.
     1791           run fmtcli-get-bank in this-procedure (
     1792             input p-host-obj-code
     1793           , input p-obj-type
     1794           , input p-obj-code
     1795           , input p-curr-code
     1796       ).
     1797       assign
     1798           v-torgconf-ship-schet-exists = v-fmtcli-schet-exists
     1799           v-torgconf-ship-bank-exists  = v-fmtcli-bank-exists
     1800           v-torgconf-ship-bank-r-schet = v-fmtcli-bank-r-schet
     1801           v-torgconf-ship-bank-c-schet = v-fmtcli-bank-c-schet
     1802           v-torgconf-ship-bank-bik     = v-fmtcli-bank-bik
     1803           v-torgconf-ship-bank-name    = v-fmtcli-bank-name
     1804           v-torgconf-ship-bank-addres  = v-fmtcli-bank-addres
     1805           v-torgconf-ship-bank-city    = v-fmtcli-bank-city
     1806       .
     1807   end.
     1808   end procedure.
     1809   procedure torgconf-get-holdfirm-code :
     1810   define input parameter p-obj-type   as character        no-undo.
     1811   define input parameter p-obj-code   as integer          no-undo.
     1812   define output parameter p-firm-code as integer          no-undo.
     1813       define variable v-firm-code-str     as character    no-undo.
     1814       define variable v-par-type          as character    no-undo.
     1815       define buffer buf_clients       for ub.clients.
     1816   do
     1817   for buf_clients
     1818   on error undo, return error
     1819   :
     1820       run gbl/clntat-v.p (
     1821             input p-obj-type
     1822           , input p-obj-code
     1823           , input 'holdfirm-code':U
     1824           , output v-firm-code-str
     1825           , output v-par-type
     1826       ).
     1827       assign
     1828           p-firm-code = integer( v-firm-code-str )
     1829       no-error.
     1830       if error-status :error
     1831       then do:
     1832           message
     1833               "Неверно задан код фирмы для печати накладных."
     1834           view-as alert-box warning.
     1835           assign
     1836               p-firm-code = 0
     1837           .
     1838       end.
     1839       else do:
     1840           find first buf_clients no-lock
     1841                where buf_clients.obj-type = 'орг':U
     1842                  and buf_clients.obj-code = p-firm-code
     1843           no-error.
     1844           if not available buf_clients
     1845           then do:
     1846               message
     1847                   "Включен параметр 'Список печатных форм, для которых должна быть задана фирма для печати накладных' (outhold)" skip
     1848                   "Не найдена фирма по заданному коду фирмы для печати накладных."
     1849               view-as alert-box warning.
     1850               assign
     1851                   p-firm-code = 0
     1852               .
     1853           end.
     1854       end.
     1855   end.
     1856   end procedure.
     1857   procedure torgconf-get-post-head:
     1858   define input  parameter p-obj-type             as character        no-undo.
     1859   define input  parameter p-obj-code             as integer          no-undo.
     1860   define output parameter p-torgconf-post-head   as character        no-undo.
     1861      define variable v-host-code         as integer      no-undo.
     1862      define buffer buf_sysconf     for ub.sysconf.
     1863        assign
     1864         p-torgconf-post-head  = ""
     1865        .
     1866   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1867   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1868     (input  p-obj-type
     1869     ,input  p-obj-code
     1870     ,output v-host-code
     1871     )  .
     1872      find first buf_sysconf no-lock
     1873      where buf_sysconf.host-code = v-host-code
     1874      no-error.
     1875      if available buf_sysconf
     1876      then do:
     1877         assign
     1878            p-torgconf-post-head = buf_sysconf.head-position
     1879         .
     1880      end.
     1881   end procedure.
     1882   procedure torgconf-get-storekeeper:
     1883   define input  parameter p-wrkr                   as integer          no-undo.
     1884   define output parameter p-torgconf-wrkr-name     as character        no-undo.
     1885   define output parameter p-torgconf-post          as character        no-undo.
     1886      define buffer buf_sysconf     for ub.sysconf.
     1887      define buffer buf_person      for ub.person.
     1888      define buffer buf_shop        for ub.shop .
     1889      define buffer buf_store       for ub.store .
     1890      if v-torgconf-outC = "no_print"
     1891      then do:
     1892         assign p-torgconf-post = ""
     1893                p-torgconf-wrkr-name = ""
     1894                .
     1895      end.
     1896      if v-torgconf-outC = "clad_doc"
     1897      then do:
     1898         run rep/get-psn.p
     1899               (input  p-wrkr
     1900               ,output p-torgconf-wrkr-name
     1901               ) .
     1902         find first buf_person no-lock
     1903         where buf_person.psn-code = p-wrkr
     1904         no-error.
     1905         if available buf_person
     1906         then do:
     1907           p-torgconf-post = buf_person.position.
     1908         end.
     1909         if p-torgconf-post = "?":U then p-torgconf-post = "".
     1910         if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     1911      end.
     1912      if v-torgconf-outC = "clad_obj"
     1913      then do:
     1914         CASE v-torgconf-self-obj-type:
     1915         WHEN 'маг':U
     1916         THEN DO:
     1917            find first buf_shop no-lock
     1918            where buf_shop.obj-code = v-torgconf-self-obj-code
     1919            .
     1920            assign
     1921               p-torgconf-wrkr-name = buf_shop.store-man
     1922               p-torgconf-post = ""
     1923            .
     1924            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     1925         END.
     1926         WHEN 'скл':U
     1927         THEN DO:
     1928            find first buf_store no-lock
     1929            where buf_store.obj-code = v-torgconf-self-obj-code
     1930            .
     1931            assign
     1932               p-torgconf-wrkr-name = buf_store.store-man
     1933               p-torgconf-post = ""
     1934            .
     1935            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     1936         END.
     1937         OTHERWISE DO:
     1938            assign
     1939               p-torgconf-post = "":U
     1940               p-torgconf-wrkr-name = "":U
     1941            .
     1942         END.
     1943         END CASE.
     1944      end.
     1945    end procedure.
     1946   procedure torgconf-get-form-header :
     1947   define input parameter p-for-inverse    as logical          no-undo.
     1948   define input parameter p-doc-code       as character        no-undo.
     1949   define input parameter p-print-doc      as logical          no-undo.
     1950   define input parameter p-doc-date       as date             no-undo.
     1951   define input parameter p-fact-date      as date             no-undo.
     1952   define input parameter p-doc-type       as character        no-undo.
     1953   define input parameter p-status_        as character        no-undo.
     1954   define input parameter p-reverse        as logical          no-undo.
     1955   define input parameter p-sf-par         as logical          no-undo.
     1956       define variable v-attr-type         as character    no-undo.
     1957       define variable v-doc-code-standard as logical      no-undo.
     1958       define variable v-doc-date-standard as logical      no-undo.
     1959       define variable v-par-consignee-addres  as character    no-undo.
     1960       define variable v-host-code         as integer      no-undo.
     1961       define variable v-dcode-attr        as character    no-undo.
     1962       define variable v-ddate-attr        as character    no-undo.
     1963       define variable v-doc-date          as character    no-undo.
     1964       define variable v-doc-code          as character    no-undo.
     1965       define variable v-par-type          as character    no-undo.
     1966       define variable v-attr              as character    no-undo.
     1967       define buffer buf_firm          for ub.firm .
     1968       define buffer buf_clients       for ub.clients .
     1969       define buffer buf_sysconf       for ub.sysconf .
     1970       define buffer buf_shop          for ub.shop .
     1971       define buffer buf_store         for ub.store .
     1972       define buffer buf_person        for ub.person .
     1973       define buffer buf_trn-doc       for ub.trn-doc .
     1974       define buffer buf_wth-doc       for ub.wth-doc .
     1975       do
     1976   for buf_firm
     1977     , buf_clients
     1978     , buf_sysconf
     1979     , buf_shop
     1980     , buf_trn-doc
     1981     , buf_person
     1982     , buf_wth-doc
     1983   on error undo, return error
     1984   :
     1985       if p-doc-type = 'при':U
     1986       or p-doc-type = 'возврат':U
     1987       then do:
     1988           assign
     1989               v-torgconf-supplier         = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     1990                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     1991               v-torgconf-suppi            = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     1992                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     1993               v-torgconf-saler            = substitute( "&1&2&3&4&5", v-torgconf-self-host-name, ( if v-torgconf-self-host-addres = "":U then "":U else ", " ),
     1994                                             v-torgconf-self-host-addres, ( if v-torgconf-self-host-phone = "":U then "":U else ", " ),v-torgconf-self-host-phone )
     1995               v-torgconf-consignee        = substitute( "&1&2&3&4&5", v-torgconf-sup-host-name, ( if v-torgconf-sup-host-addres = "":U then "":U else ", " ),
     1996                                             v-torgconf-sup-host-addres, ( if v-torgconf-sup-host-phone = "":U then "":U else ", " ), v-torgconf-sup-host-phone  )
     1997               v-torgconf-supplier-okpo    = v-torgconf-cli-okpo
     1998               v-torgconf-saler-okpo       = v-torgconf-self-host-okpo
     1999               v-torgconf-consignee-okpo   = v-torgconf-sup-host-okpo
     2000               v-torgconf-supplier-code    = substitute( "&1", v-torgconf-cli-code         )
     2001               v-torgconf-supplier-type    = v-torgconf-cli-type
     2002               v-torgconf-saler-code       = substitute( "&1", v-torgconf-self-host-code   )
     2003               v-torgconf-saler-type       = v-torgconf-self-host-type
     2004               v-torgconf-consignee-code   = substitute( "&1", v-torgconf-sup-host-code   )
     2005               v-torgconf-consignee-type   = v-torgconf-sup-host-type
     2006               v-torgconf-supplier-name    = substitute( "&1", v-torgconf-cli-name         )
     2007               v-torgconf-saler-name       = substitute( "&1", v-torgconf-self-host-name   )
     2008               v-torgconf-consignee-name   = substitute( "&1", v-torgconf-sup-host-name   )
     2009               v-torgconf-supplier-addr    = substitute( "&1", v-torgconf-cli-addres       )
     2010               v-torgconf-saler-addr       = substitute( "&1", v-torgconf-self-host-addres )
     2011               v-torgconf-consignee-addr   = substitute( "&1", v-torgconf-sup-host-addres )
     2012               v-torgconf-supplier-inn     = substitute( "&1", v-torgconf-cli-inn          )
     2013               v-torgconf-supplier-engl-name     = substitute( "&1", v-torgconf-cli-engl-name          )
     2014               v-torgconf-saler-inn        = substitute( "&1", v-torgconf-self-host-inn    )
     2015               v-torgconf-consignee-inn    = substitute( "&1", v-torgconf-sup-host-inn    )
     2016               v-torgconf-supplier-kpp     = substitute( "&1", v-torgconf-cli-kpp          )
     2017               v-torgconf-saler-kpp        = substitute( "&1", v-torgconf-self-host-kpp    )
     2018               v-torgconf-consignee-kpp    = substitute( "&1", v-torgconf-sup-host-kpp    )
     2019           .
     2020           if v-torgconf-cli-schet-exists = yes
     2021           AND v-form-name                  = "torg12":U
     2022           then do:
     2023               assign
     2024                   v-torgconf-supplier = v-torgconf-supplier
     2025                       + substitute( ", р/с &1 к/с &2"
     2026                                   , v-torgconf-cli-bank-r-schet
     2027                                   , v-torgconf-cli-bank-c-schet
     2028                                   )
     2029                   v-torgconf-suppi = v-torgconf-supplier
     2030                       + substitute( ", р/с &1 к/с &2"
     2031                                   , v-torgconf-cli-bank-r-schet
     2032                                   , v-torgconf-cli-bank-c-schet
     2033                                   )
     2034               .
     2035               if v-torgconf-cli-bank-exists = yes
     2036               then do:
     2037                   assign
     2038                       v-torgconf-supplier = v-torgconf-supplier
     2039                           + substitute( " БИК &1 в &2 &3"
     2040                                       , v-torgconf-cli-bank-bik
     2041                                       , v-torgconf-cli-bank-name
     2042                                       ,(if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     2043                                       )
     2044                      v-torgconf-suppi = v-torgconf-supplier
     2045                           + substitute( " БИК &1 в &2 &3"
     2046                                       , v-torgconf-cli-bank-bik
     2047                                       , v-torgconf-cli-bank-name
     2048                                       ,(if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     2049                                       )
     2050                   .
     2051               end.
     2052           end.
     2053           if v-torgconf-self-schet-exists = yes
     2054           AND v-form-name                  = "torg12":U
     2055           then do:
     2056               assign
     2057                   v-torgconf-saler = v-torgconf-saler
     2058                       + substitute( ", р/с &1 к/с &2"
     2059                                   , v-torgconf-self-bank-r-schet
     2060                                   , v-torgconf-self-bank-c-schet
     2061                                   )
     2062               .
     2063               if v-torgconf-self-bank-exists = yes
     2064               then do:
     2065                   assign
     2066                       v-torgconf-saler = v-torgconf-saler
     2067                           + substitute( " БИК &1 в &2 &3"
     2068                                       , v-torgconf-self-bank-bik
     2069                                       , v-torgconf-self-bank-name
     2070                                       , v-torgconf-self-bank-addres
     2071                                       )
     2072                   .
     2073               end.
     2074           end.
     2075           if v-torgconf-sup-schet-exists = yes
     2076           AND v-form-name                  = "torg12":U
     2077           then do:
     2078               assign
     2079                   v-torgconf-consignee = v-torgconf-consignee
     2080                       + substitute( ", р/с &1 к/с &2"
     2081                                   , v-torgconf-sup-bank-r-schet
     2082                                   , v-torgconf-sup-bank-c-schet
     2083                                   )
     2084               .
     2085             if v-torgconf-sup-bank-exists = yes
     2086              then do:
     2087                assign
     2088                   v-torgconf-consignee = v-torgconf-consignee
     2089                           + substitute( " БИК &1 в &2 &3"
     2090                                       , v-torgconf-sup-bank-bik
     2091                                       , v-torgconf-sup-bank-name
     2092                                       , v-torgconf-sup-bank-addres
     2093                                       )
     2094                   .
     2095               end.
     2096           end.
     2097      if v-torgconf-outares = yes  AND v-form-name  = "torg12":U
     2098      then do:
     2099          assign
     2100            v-torgconf-supplier = substitute(  "&1&2&3 &4 &5&6"
     2101                                                   , IF v-form-name = "torg12":U THEN SUBSTITUTE("ИНН &1 КПП &2 ", v-torgconf-cli-inn, v-torgconf-cli-kpp) ELSE "":U
     2102                                                   , v-torgconf-cli-name
     2103                                                   , ( if v-torgconf-outprncd = yes
     2104                                                         then substitute( " (&1)", v-torgconf-cli-code )
     2105                                                         else "":U )
     2106                                                   , v-torgconf-cli-post-addres
     2107                                                   , v-torgconf-cli-phone
     2108                                                   , ( if v-torgconf-cli-bank-r-schet <> "":U
     2109                                                       AND v-form-name                  = "torg12":U
