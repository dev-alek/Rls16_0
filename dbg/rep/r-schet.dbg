        1   block-level on error undo, throw.
        2   define input parameter parParentProc     AS WIDGET-HANDLE NO-UNDO.
        3   define input parameter rec_id   as recid          no-undo.
        4   define input parameter p-mode   as character      no-undo.
        5     define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        6     define variable vss-author      as character no-undo init "$Author: expertek $":U .
        7     define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        8     define variable vss-workfile    as character no-undo init "$Workfile: r-schet.p $":U .
        9     define variable vss-archive     as character no-undo init "$Archive: rep/r-schet.p $":U .
       10     define variable vss-description as character no-undo init "Печать счета".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define new global shared variable g#library  as handle no-undo .
       70   define new global shared variable g#library2 as handle no-undo .
       71     define variable g#report-num as integer   no-undo .
       72     run get-report-num  in parParentProc ( output g#report-num ).
       73     define variable g#quest-print as logical   no-undo .
       74     run get-quest-print in parParentProc ( output g#quest-print ).
       75     define variable g#gds-engl as logical   no-undo .
       76     run get-gds-engl  in parParentProc ( output g#gds-engl ).
       77   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       78   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
       79   define  shared variable RepPathName        as character no-undo .
       80   define  shared variable PrintRubl          as logical   no-undo .
       81   define variable vss-include-info1 as character format "X(65)" no-undo
       82   initial "@(#)$Workfile$ $Revision$".
       83   define variable v-fmtcli-name          as character    no-undo.
       84   define variable v-fmtcli-engl-name     as character    no-undo.
       85   define variable v-fmtcli-addres        as character    no-undo.
       86   define variable v-fmtcli-post-addres   as character    no-undo.
       87   define variable v-fmtcli-full-addres   as character    no-undo.
       88   define variable v-fmtcli-phone         as character    no-undo.
       89   define variable v-fmtcli-inn           as character    no-undo.
       90   define variable v-fmtcli-kpp           as character    no-undo.
       91   define variable v-fmtcli-okpo          as character    no-undo.
       92   define variable v-fmtcli-country       as character    no-undo.
       93   define variable v-fmtcli-city          as character    no-undo.
       94   define variable v-fmtcli-index         as character    no-undo.
       95   define variable v-fmtcli-schet-exists  as logical      no-undo.
       96   define variable v-fmtcli-bank-exists   as logical      no-undo.
       97   define variable v-fmtcli-bank-r-schet  as character    no-undo.
       98   define variable v-fmtcli-bank-c-schet  as character    no-undo.
       99   define variable v-fmtcli-bank-bik      as character    no-undo.
      100   define variable v-fmtcli-bank-name     as character    no-undo.
      101   define variable v-fmtcli-bank-addres   as character    no-undo.
      102   define variable v-fmtcli-bank-city     as character    no-undo.
      103   procedure fmtcli-get-bank :
      104   define input parameter p-host-code      as integer          no-undo.
      105   define input parameter p-obj-type       as character        no-undo.
      106   define input parameter p-obj-code       as integer          no-undo.
      107   define input parameter p-curr-code      as integer          no-undo.
      108       define buffer buf_fin-schet     for ub.fin-schet.
      109       define buffer buf_fin-bank      for ub.fin-bank.
      110   do
      111   for buf_fin-schet
      112     , buf_fin-bank
      113   on error undo, return error
      114   :
      115       assign
      116           v-fmtcli-schet-exists       = no
      117           v-fmtcli-bank-exists        = no
      118           v-fmtcli-bank-r-schet       = "":U
      119           v-fmtcli-bank-c-schet       = "":U
      120           v-fmtcli-bank-bik           = "":U
      121           v-fmtcli-bank-name          = "":U
      122           v-fmtcli-bank-addres        = "":U
      123           v-fmtcli-bank-city          = "":U
      124       .
      125       search-for-schet:
      126       for each buf_fin-schet no-lock
      127          where buf_fin-schet.host-code = p-host-code
      128            and buf_fin-schet.cli-type  = p-obj-type
      129            and buf_fin-schet.cli-code  = p-obj-code
      130            and buf_fin-schet.curr-code = p-curr-code
      131       on error undo, return error
      132       :
      133           if buf_fin-schet.status_   = 'удал':U
      134           then do:
      135           end.
      136           else do:
      137               assign
      138                   v-fmtcli-schet-exists   = yes
      139                   v-fmtcli-bank-r-schet   = trim( buf_fin-schet.r-schet )
      140                   v-fmtcli-bank-c-schet   = trim( buf_fin-schet.c-schet )
      141               .
      142               find first buf_fin-bank no-lock
      143                    where buf_fin-bank.host-code = p-host-code
      144                      and buf_fin-bank.code-bank = buf_fin-schet.code-bank
      145               no-error.
      146               if available buf_fin-bank
      147               then do:
      148                   assign
      149                       v-fmtcli-bank-exists      = yes
      150                       v-fmtcli-bank-bik         = trim( buf_fin-bank.bik )
      151                       v-fmtcli-bank-name        = trim( buf_fin-bank.bank-name )
      152                       v-fmtcli-bank-addres      = trim(buf_fin-bank.addres)
      153                       v-fmtcli-bank-city      = trim(buf_fin-bank.bank-city)
      154                   .
      155               end.
      156               else do:
      157                   assign
      158                       v-fmtcli-bank-exists    = no
      159                       v-fmtcli-bank-bik       = "":U
      160                       v-fmtcli-bank-name      = "":U
      161                       v-fmtcli-bank-addres    = "":U
      162                       v-fmtcli-bank-city      = "":U
      163                   .
      164               end.
      165               leave search-for-schet.
      166           end.
      167       end.
      168   end.
      169   end procedure.
      170   procedure fmtcli-get-client :
      171   define input parameter p-obj-type       as character    no-undo.
      172   define input parameter p-obj-code       as integer      no-undo.
      173       define variable v-temp-fmtcli-address      as character     no-undo.
      174       define variable v-num-country-city    as integer      no-undo.
      175       define buffer buf_clients   for ub.clients.
      176       define buffer buf_firm      for ub.firm.
      177       define buffer buf_store     for ub.store.
      178       define buffer buf_shop      for ub.shop.
      179       define buffer buf_person    for ub.person.
      180   do
      181   for buf_clients
      182     , buf_firm
      183     , buf_store
      184     , buf_shop
      185     , buf_person
      186   on error undo, return error
      187   :
      188       assign
      189           v-fmtcli-name           = "":U
      190           v-fmtcli-addres         = "":U
      191           v-fmtcli-post-addres    = "":U
      192           v-fmtcli-full-addres    = "":U
      193           v-fmtcli-phone          = "":U
      194           v-fmtcli-inn            = "":U
      195           v-fmtcli-kpp            = "":U
      196           v-fmtcli-okpo           = "":U
      197           v-fmtcli-city           = "":U
      198           v-fmtcli-index          = "":U
      199           v-fmtcli-country        = "":U
      200       .
      201       find first buf_clients no-lock
      202            where buf_clients.obj-type = p-obj-type
      203              and buf_clients.obj-code = p-obj-code
      204       .
      205       assign
      206           v-fmtcli-name = buf_clients.obj-name
      207       .
      208       case buf_clients.obj-type:
      209          when 'орг':U
      210          then do:
      211               find first buf_firm no-lock
      212                    where buf_firm.firm-code = buf_clients.obj-code
      213                    no-error
      214               .
      215               if available buf_firm
      216               then do:
      217                   assign
      218                       v-num-country-city = num-entries( buf_firm.city )
      219                       v-fmtcli-engl-name = buf_firm.engl-name
      220                   .
      221                   if v-num-country-city > 0
      222                   then do:
      223                       assign
      224                           v-fmtcli-country    = trim( entry( 1, buf_firm.city ) )
      225                       .
      226                   end.
      227                   if v-num-country-city > 1
      228                   then do:
      229                       assign
      230                           v-fmtcli-city       = trim( entry( 2, buf_firm.city ) )
      231                       .
      232                   end.
      233                   run fmtcli-concatenate-strings in this-procedure (
      234                         input v-fmtcli-full-addres
      235                       , input v-fmtcli-country
      236                       , input ", ":U
      237                       , input 50
      238                       , output v-fmtcli-full-addres
      239                   ).
      240                   run fmtcli-concatenate-strings in this-procedure (
      241                         input v-fmtcli-full-addres
      242                       , input v-fmtcli-city
      243                       , input ", ":U
      244                       , input 50
      245                       , output v-fmtcli-full-addres
      246                   ).
      247                   run fmtcli-concatenate-strings in this-procedure (
      248                         input v-fmtcli-full-addres
      249                       , input IF buf_firm.ind = 0 THEN "" ELSE string( buf_firm.ind )
      250                       , input ", ":U
      251                       , input 50
      252                       , output v-fmtcli-full-addres
      253                   ).
      254                   run fmtcli-concatenate-strings in this-procedure (
      255                         input v-fmtcli-post-addres
      256                       , input v-fmtcli-country
      257                       , input ", ":U
      258                       , input 50
      259                       , output v-fmtcli-post-addres
      260                   ).
      261                   run fmtcli-concatenate-strings in this-procedure (
      262                         input v-fmtcli-post-addres
      263                       , input v-fmtcli-city
      264                       , input ", ":U
      265                       , input 50
      266                       , output v-fmtcli-post-addres
      267                   ).
      268                   run fmtcli-concatenate-strings in this-procedure (
      269                         input v-fmtcli-post-addres
      270                       , input string( buf_firm.ind )
      271                       , input ", ":U
      272                       , input 50
      273                       , output v-fmtcli-post-addres
      274                   ).
      275                   run fmtcli-concatenate-strings in this-procedure (
      276                         input substring( buf_firm.addres1, 1, 50 )
      277                       , input buf_firm.addres2
      278                       , input " ":U
      279                       , input 50
      280                       , output v-temp-fmtcli-address
      281                   ).
      282                   run fmtcli-concatenate-strings in this-procedure (
      283                         input v-temp-fmtcli-address
      284                       , input substring( buf_firm.addres1, 51, 50 )
      285                       , input " ":U
      286                       , input 50
      287                       , output v-temp-fmtcli-address
      288                   ).
      289                   run fmtcli-concatenate-strings in this-procedure (
      290                         input v-temp-fmtcli-address
      291                       , input substring( buf_firm.addres1, 101, 50 )
      292                       , input " ":U
      293                       , input 50
      294                       , output v-temp-fmtcli-address
      295                   ).
      296                   assign
      297                       v-fmtcli-addres = v-temp-fmtcli-address
      298                   .
      299                   if buf_firm.addres1 <> ?
      300                   then do:
      301                       run fmtcli-concatenate-strings in this-procedure (
      302                             input v-fmtcli-full-addres
      303                           , input v-fmtcli-addres
      304                           , input ", ":U
      305                           , input 0
      306                           , output v-fmtcli-full-addres
      307                       ).
      308                   end.
      309                   run fmtcli-concatenate-strings in this-procedure (
      310                         input substring( buf_firm.post-addr1, 1, 50 )
      311                       , input buf_firm.post-addr2
      312                       , input " ":U
      313                       , input 50
      314                       , output v-fmtcli-post-addres
      315                   ).
      316                   run fmtcli-concatenate-strings in this-procedure (
      317                         input v-fmtcli-post-addres
      318                       , input substring( buf_firm.post-addr1, 51, 50 )
      319                       , input " ":U
      320                       , input 50
      321                       , output v-fmtcli-post-addres
      322                   ).
      323                   run fmtcli-concatenate-strings in this-procedure (
      324                         input v-fmtcli-post-addres
      325                       , input substring( buf_firm.post-addr1, 101, 50 )
      326                       , input " ":U
      327                       , input 50
      328                       , output v-fmtcli-post-addres
      329                   ).
      330                   assign
      331                       v-fmtcli-phone         = buf_firm.phone
      332                       v-fmtcli-inn           = buf_firm.inn
      333                       v-fmtcli-kpp           = buf_firm.kpp
      334                       v-fmtcli-okpo          = buf_firm.okpo
      335                       v-fmtcli-index         = string( buf_firm.ind )
      336                   .
      337               end.
      338          end.
      339          when 'маг':U
      340          then do:
      341               find first buf_shop no-lock
      342                    where buf_shop.obj-code = buf_clients.obj-code
      343               .
      344               if available buf_shop
      345               then do:
      346                   run fmtcli-concatenate-strings in this-procedure (
      347                         input buf_shop.addres1
      348                       , input buf_shop.addres2
      349                       , input " ":U
      350                       , input 50
      351                       , output v-fmtcli-addres
      352                   ).
      353                   assign
      354                       v-fmtcli-full-addres = v-fmtcli-addres
      355                       v-fmtcli-post-addres = v-fmtcli-addres
      356                       v-fmtcli-phone       = buf_shop.phone
      357                       v-fmtcli-inn         = "":U
      358                       v-fmtcli-kpp         = "":U
      359                       v-fmtcli-okpo        = "":U
      360                       v-fmtcli-city        = "":U
      361                       v-fmtcli-index       = "":U
      362                   .
      363               end.
      364          end.
      365          when 'скл':U
      366          then do:
      367               find first buf_store no-lock
      368                    where buf_store.obj-code = buf_clients.obj-code
      369               .
      370               if available buf_store
      371               then do:
      372                   run fmtcli-concatenate-strings in this-procedure (
      373                         input buf_store.addres1
      374                       , input buf_store.addres2
      375                       , input " ":U
      376                       , input 50
      377                       , output v-fmtcli-addres
      378                   ).
      379                   assign
      380                       v-fmtcli-full-addres = v-fmtcli-addres
      381                       v-fmtcli-phone       = buf_store.phone
      382                       v-fmtcli-inn         = "":U
      383                       v-fmtcli-kpp         = "":U
      384                       v-fmtcli-okpo        = "":U
      385                       v-fmtcli-city        = "":U
      386                       v-fmtcli-index       = "":U
      387                   .
      388               end.
      389          end.
      390          when 'чел':U
      391          then do:
      392               find first buf_person no-lock
      393                    where buf_person.psn-code = buf_clients.obj-code
      394               .
      395               if available buf_person
      396               then do:
      397                   run fmtcli-concatenate-strings in this-procedure (
      398                         input ( if buf_person.ind = 0 or buf_person.ind = ?
      399                                 then "":U
      400                                 else string( buf_person.ind, "999999")
      401                                 )
      402                       , input buf_person.city
      403                       , input ", ":U
      404                       , input 0
      405                       , output v-fmtcli-full-addres
      406                   ).
      407                   assign
      408                       v-fmtcli-addres = buf_person.address
      409                   .
      410                   run fmtcli-concatenate-strings in this-procedure (
      411                         input v-fmtcli-full-addres
      412                       , input v-fmtcli-addres
      413                       , input ", ":U
      414                       , input 0
      415                       , output v-fmtcli-full-addres
      416                   ).
      417                   assign
      418                       v-fmtcli-phone     = buf_person.phone1
      419                       v-fmtcli-inn       = buf_person.inn
      420                       v-fmtcli-kpp       = buf_person.kpp
      421                       v-fmtcli-okpo      = buf_person.okpo
      422                       v-fmtcli-city      = buf_person.city
      423                       v-fmtcli-index     = string( buf_person.ind )
      424                   .
      425               end.
      426          end.
      427       end case.
      428   end.
      429   end procedure.
      430   procedure fmtcli-concatenate-strings :
      431   define input parameter p-string-1       as character        no-undo.
      432   define input parameter p-string-2       as character        no-undo.
      433   define input parameter p-delimiter      as character        no-undo.
      434   define input parameter p-length         as integer          no-undo.
      435   define output parameter p-out-string    as character        no-undo.
      436   do
      437   on error undo, return error
      438   :
      439       assign
      440           p-out-string = ( if p-string-1 = ?
      441                            then "":U
      442                            else trim( p-string-1 ) )
      443       .
      444       assign
      445           p-out-string = p-out-string
      446                        + ( if p-out-string = "":U
      447                            or length( p-out-string ) = p-length
      448                            or p-string-2 = ?
      449                            or trim( p-string-2 ) = "":U
      450                            then "":U
      451                            else p-delimiter )
      452                        + ( if p-string-2 = ?
      453                            or trim( p-string-2 ) = "":U
      454                            then "":U
      455                            else trim( p-string-2 ) )
      456       .
      457   end.
      458   end procedure.
      459   def var vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      460   define new global shared variable g#attr-lib  as handle no-undo .
      461   define variable v-attr-lib-variable as handle no-undo .
      462   procedure clntattr-code :
      463     define input  parameter p-code           as character no-undo .
      464     define output parameter p-type           as character no-undo .
      465     define output parameter p-format         as character no-undo .
      466     define output parameter p-label          as character no-undo .
      467     define output parameter p-user-can-edit  as logical   no-undo .
      468     define output parameter p-output-display as logical   no-undo .
      469     define output parameter p-other          as character no-undo .
      470     do
      471     on error undo, return error return-value
      472     :
      473           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clntattr-code in g#attr-lib
      474         (input  p-code
      475         ,output p-type
      476         ,output p-format
      477         ,output p-label
      478         ,output p-user-can-edit
      479         ,output p-output-display
      480         ,output p-other
      481         ) no-error .
      482       if error-status :error
      483       then do:
      484         undo, return error return-value .
      485       end.
      486     end.
      487   end procedure.
      488   procedure clntattr-tooltip :
      489     define input  parameter p-code    as character no-undo .
      490     define output parameter p-tooltip as character no-undo .
      491     define output parameter p-label   as character no-undo .
      492     do
      493     on error undo, return error return-value
      494     :
      495           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clntattr-tooltip in g#attr-lib
      496         (input  p-code
      497         ,output p-tooltip
      498         ,output p-label
      499         ) no-error .
      500       if error-status :error
      501       then do:
      502         undo, return error return-value .
      503       end.
      504     end.
      505   end procedure.
      506   procedure clntattr-value :
      507     define input  parameter p-obj-type like ub.clients-attr.obj-type   no-undo .
      508     define input  parameter p-obj-code like ub.clients-attr.obj-code   no-undo .
      509     define input  parameter p-code     like ub.clients-attr.attr-code  no-undo .
      510     define output parameter p-value    like ub.clients-attr.attr-value no-undo .
      511     define output parameter p-type     as character no-undo .
      512     do
      513     on error undo, return error return-value
      514     :
      515           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clntattr-value in g#attr-lib
      516         (input  p-obj-type
      517         ,input  p-obj-code
      518         ,input  p-code
      519         ,output p-value
      520         ,output p-type
      521         ) no-error .
      522       if error-status :error
      523       then do:
      524         undo, return error return-value .
      525       end.
      526     end.
      527   end procedure.
      528   procedure clntattr-write :
      529     define input  parameter p-obj-type like ub.clients-attr.obj-type   no-undo .
      530     define input  parameter p-obj-code like ub.clients-attr.obj-code   no-undo .
      531     define input  parameter p-code     like ub.clients-attr.attr-code  no-undo .
      532     define input  parameter p-value    like ub.clients-attr.attr-value no-undo .
      533     do
