     1087       then assign
     1088               v-pg-need-qnty     = 0
     1089               v-pg-places-amount = 0
     1090               v-pg-qnty-all      = 0
     1091               v-pg-cost-sum      = 0
     1092               v-pg-sale-sum      = 0
     1093           .
     1094               assign
     1095                   PrevPage           = page-number( Out-Stream )
     1096                   v-pg-need-qnty     = v-pg-need-qnty + v-need-qnty
     1097                   v-pg-places-amount = 0
     1098                   v-pg-qnty-all      = v-pg-qnty-all + v-qnty-all
     1099                   v-pg-cost-sum      = v-pg-cost-sum + v-cost-sum
     1100                   v-pg-sale-sum      = v-pg-sale-sum + v-sale-sum
     1101               .
     1102           if line-counter( Out-Stream ) + 2 > page-size( Out-Stream ) then
     1103               do:
