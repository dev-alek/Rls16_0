      118   FUNCTION center-field RETURNS INTEGER (INPUT iStartPix AS INTEGER, iEndPix AS INTEGER,
      119                                     iInput AS INTEGER).
      120     def var v-start-print as integer no-undo .
      121     if (iStartPix < 0) or (iEndPix < iStartPix) then return 0.
      122     assign
      123       v-start-print = INTEGER(iStartPix + ((iEndPix - iStartPix) / 2) - (iInput / 2))
      124     .
      125     RETURN v-start-print .
      126   END FUNCTION.
      127   FUNCTION right-field RETURNS INTEGER ( iEndPix AS INTEGER,
      128                                     iInput AS INTEGER).
      129     def var v-start-print as integer no-undo .
      130     assign
      131       v-start-print = INTEGER(iEndPix - 1 - iInput)
      132     .
      133     if v-start-print < 0 then return 0.
      134     RETURN v-start-print .
      135   END FUNCTION.
      136   function p-fmt-align-string returns character (
      137         p-in-string      as character
      138       , p-page-width     as integer
      139       , p-align-type     as character
      140   ).
      141       define variable v-string-length     as integer      no-undo.
      142       define variable v-out-string        as character    no-undo.
      143       assign
      144           v-string-length = length( trim( p-in-string ) )
      145       .
      146       if v-string-length >= p-page-width
      147       then do:
      148           assign
      149               v-out-string = trim( p-in-string )
      150           .
      151       end.
      152       else do:
      153           case p-align-type
      154           :
      155               when 'left':U
      156               then do:
      157                   assign
      158                       v-out-string = trim( p-in-string )
      159                   .
      160               end.
      161               when 'right':U
      162               then do:
      163                   assign
      164                       v-out-string = fill( " ":U, p-page-width - v-string-length ) + trim( p-in-string )
      165                   .
      166               end.
      167               when 'center':U
      168               then do:
      169                   assign
      170                       v-out-string = fill( " ":U, integer( ( p-page-width - v-string-length ) / 2 ) ) + trim( p-in-string )
      171                   .
      172               end.
      173           end case.
      174       end.
      175       return v-out-string .
      176   end function.
      177   procedure p-fmt-split-string :
      178   define input parameter p-source-string  as character        no-undo.
      179   define input parameter p-split-length   as integer          no-undo.
      180   define output parameter p-string-1      as character        no-undo.
      181   define output parameter p-string-2      as character        no-undo.
      182   do
      183   on error undo, return error
      184   :
      185       define variable v-space-pos    as integer      no-undo.
      186       if length( p-source-string ) <= p-split-length
      187       then do:
      188           assign
      189               p-string-1 = p-source-string
      190           .
      191       end.
      192       else do:
      193           assign
      194               v-space-pos = r-index( p-source-string, " ":U, p-split-length )
      195           .
      196           if v-space-pos = 0
      197           then do:
      198               assign
      199                   v-space-pos = index( p-source-string, " ":U )
      200               .
      201           end.
      202           if v-space-pos = 0
      203           then do:
      204               assign
      205                   p-string-1 = substring( p-source-string, 1, p-split-length )
      206                   p-string-2 = trim( substring( p-source-string, p-split-length, p-split-length ) )
      207               .
      208           end.
      209           else do:
      210               assign
      211                   p-string-1 = substring( p-source-string, 1, v-space-pos )
      212                   p-string-2 = trim( substring( p-source-string, v-space-pos ) )
      213               .
      214           end.
      215       end.
      216   end.
      217   end procedure.
      218   procedure p-fmt-round :
      219   define input parameter p-qnty               as decimal          no-undo.
      220   define input parameter p-price-no-VAT       as decimal          no-undo.
      221   define input parameter p-VAT                as decimal          no-undo.
      222   define input parameter p-SLT                as decimal          no-undo.
      223   define input parameter p-road-tax           as decimal          no-undo.
      224   define output parameter p-new-price-no-VAT  as decimal          no-undo.
      225   define output parameter p-new-VAT           as decimal          no-undo.
      226   define output parameter p-new-SLT           as decimal          no-undo.
      227   define output parameter p-new-sum-VAT       as decimal          no-undo.
      228   define output parameter p-new-sum-SLT       as decimal          no-undo.
      229   define output parameter p-new-sum-road-tax  as decimal          no-undo.
      230   define output parameter p-new-sum-no-VAT    as decimal          no-undo.
      231   define output parameter p-new-sum-full      as decimal          no-undo.
      232       define variable v-vat-pc    as decimal      no-undo.
      233       define variable v-slt-pc    as decimal      no-undo.
      234   do
      235   on error undo, return error
      236   :
      237       if p-price-no-VAT = 0
      238       then do:
      239           assign
      240               p-new-price-no-VAT = 0.0
      241               p-new-VAT          = ?
      242               p-new-SLT          = ?
      243               p-new-sum-VAT      = 0.0
      244               p-new-sum-SLT      = 0.0
      245               p-new-sum-no-VAT   = 0.0
      246               p-new-sum-road-tax = 0.0
      247               p-new-sum-full     = 0.0
      248           .
      249       end.
      250       else do:
      251           assign
      252               v-vat-pc            = p-VAT / p-price-no-VAT
      253               v-slt-pc            = p-SLT / ( p-price-no-VAT + p-VAT )
      254               p-new-price-no-VAT  = round( p-price-no-VAT, 2 )
      255               p-new-VAT           = round( p-new-price-no-VAT * v-vat-pc, 2 )
      256               p-new-SLT           = round( ( p-new-price-no-VAT + p-new-VAT ) * v-slt-pc, 2 )
      257               p-new-sum-VAT       = round( p-new-VAT          * p-qnty, 2 )
      258               p-new-sum-SLT       = round( ( p-new-price-no-VAT + p-new-VAT ) * p-qnty * v-slt-pc, 2 )
      259               p-new-sum-no-VAT    = round( p-new-price-no-VAT * p-qnty, 2 )
      260               p-new-sum-road-tax  = round( p-road-tax * p-qnty, 2 )
      261               p-new-sum-full      = round( ( p-new-price-no-VAT + p-new-VAT + p-new-SLT + p-road-tax ) * p-qnty, 2 )
      262           .
      263       end.
      264   end.
      265   end procedure.
      266   procedure p-fmt-split :
      267   define input parameter p-in-string      as character        no-undo.
      268   define input parameter p-split-length   as integer          no-undo.
      269       define variable v-start-pos     as integer      no-undo.
      270       define variable v-end-pos       as integer      no-undo.
      271       define buffer buf_temp_p-fmt_string-part        for temp_p-fmt_string-part.
      272   do
      273   for buf_temp_p-fmt_string-part
      274   on error undo, return error
      275   :
      276       empty temp-table buf_temp_p-fmt_string-part.
      277       if p-split-length < 1
      278       then do:
      279           undo, return error substitute( "p-fmt-split: Строка не может быть разбита на &1 частей", p-split-length ).
      280       end.
      281       assign
      282           p-in-string                 = trim( p-in-string )
      283           v-p-fmt-1-str-key   = 0
      284           v-start-pos                 = 1
      285           v-end-pos                   = length( p-in-string )
      286       .
      287       run p-fmt-get-string-range in this-procedure (
      288             input p-in-string
      289           , input p-split-length
      290           , input v-start-pos
      291           , output v-start-pos
      292           , output v-end-pos
      293       ).
      294       do while v-end-pos <> 0
      295       :
      296           create buf_temp_p-fmt_string-part.
      297           assign
      298               v-p-fmt-1-str-key = v-p-fmt-1-str-key + 1
      299           .
      300           assign
      301               buf_temp_p-fmt_string-part.str-key      = v-p-fmt-1-str-key
      302               buf_temp_p-fmt_string-part.string-part  = substring( p-in-string, v-start-pos, v-end-pos - v-start-pos )
      303           .
      304           assign
      305               v-start-pos = v-end-pos + 1
      306           .
      307           run p-fmt-get-string-range in this-procedure (
      308                 input p-in-string
      309               , input p-split-length
      310               , input v-start-pos
      311               , output v-start-pos
      312               , output v-end-pos
      313           ).
      314       end.
      315   end.
      316   end procedure.
      317   procedure p-fmt-get-string-range :
      318   define input parameter p-in-string      as character        no-undo.
      319   define input parameter p-split-length   as integer          no-undo.
      320   define input parameter p-old-start-pos  as integer          no-undo.
      321   define output parameter p-start-pos     as integer          no-undo.
      322   define output parameter p-end-pos       as integer          no-undo.
      323       define variable v-init-string    as character    no-undo.
      324       define variable v-temp-char      as character    no-undo.
      325       define variable v-temp-pos       as integer      no-undo.
      326       define variable v-counter        as integer      no-undo.
      327   do
      328   on error undo, return error
      329   :
      330       assign
      331           p-start-pos   = p-old-start-pos
      332           v-init-string = substring( p-in-string, p-start-pos )
      333       no-error.
      334       if error-status :error
      335       or trim( v-init-string ) = "":U
      336       then do:
      337           assign
      338               p-end-pos = 0
      339           .
      340           undo, return .
      341       end.
      342       assign
      343           v-temp-char   = substring( v-init-string, 1, 1 )
      344       .
      345       do
      346       while trim( v-temp-char ) = "":U
      347       :
      348           assign
      349               p-start-pos     = p-start-pos + 1
      350               v-init-string   = substring( p-in-string, p-start-pos )
      351               v-temp-char     = substring( v-init-string, 1, 1 )
      352           .
      353       end.
      354       assign
      355           v-temp-pos  = p-split-length
      356           v-temp-char = substring( v-init-string, v-temp-pos, 1 )
      357           v-counter   = 0
      358       .
      359       search-word-end:
      360       do
      361       while trim( v-temp-char ) <> "":U
      362       :
      363           assign
      364               v-counter   = v-counter + 1
      365           .
      366           if v-counter > 20
      367           then do:
      368               assign
      369                   v-temp-pos  = p-split-length
      370               .
      371               leave search-word-end.
      372           end.
      373           assign
      374               v-temp-pos  = v-temp-pos - 1
      375               v-temp-char = substring( v-init-string, v-temp-pos, 1 )
      376           .
      377       end.
      378       assign
      379           p-end-pos = p-start-pos + v-temp-pos - 1
      380       .
      381   end.
      382   end procedure.
