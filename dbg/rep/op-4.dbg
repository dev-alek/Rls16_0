     1212                 "4"                  at center-field( 5 + 68, 5 + 78, 1)
     1213                 ":"                  at 5 + 78
     1214                 "5"                  at center-field( 5 + 78, 5 + 83, 1)
     1215                 ":"                  at 5 + 83
     1216                 "6"                  at center-field( 5 + 83, 5 + 88, 1)
     1217                 ":"                  at 5 + 88
     1218                 "7"                  at center-field( 5 + 88, 5 + 96, 1)
     1219                 ":"                  at 5 + 96
     1220                 "8"                  at center-field( 5 + 96, 5 + 101, 1)
     1221                 ":"                  at 5 + 101
     1222                 "9"                  at center-field( 5 + 101, 5 + 107, 1)
     1223                 ":"                  at 5 + 107
     1224                 "10"                 at center-field( 5 + 107, 5 + 115, 2)
     1225                 ":"                  at 5 + 115
     1226                 "11"                 at center-field( 5 + 115, 5 + 129, 2)
     1227                 ":"                  at 5 + 129
     1228                 "12"                 at center-field( 5 + 129, 5 + 144, 2)
     1229                 ":"                  at 5 + 144
     1230                 "13"                 at center-field( 5 + 144, 5 + 158, 2)
     1231                 ":"                  at 5 + 158
     1232                 "14"                 at center-field( 5 + 158, 5 + 173, 2)
     1233                 ":"                  at 5 + 173
     1234                 "15"                 at center-field( 5 + 173, 5 + 193, 2)
     1235                 "|"                  at 5 + 193
     1236               skip space(5)
     1237                 "|"
     1238                 v-single-line format "X(191)"
     1239                 "|"                  at 5 + 193
     1240           .
     1241       end.
     1242   hide stream Out-Stream frame BottomFrame .
     1243   define variable vss-include-info7 as character format "X(65)" no-undo
     1244   initial "@(#)$Workfile$ $Revision$".
     1245       if page-number( Out-Stream ) > PrevPage
     1246       then assign
     1247               v-pg-need-qnty     = 0
     1248               v-pg-places-amount = 0
     1249               v-pg-qnty-all      = 0
     1250               v-pg-cost-sum      = 0
     1251               v-pg-sale-sum      = 0
     1252           .
     1253               do:
     1254                   PUT stream Out-Stream
     1255                     skip space(5)
     1256                       v-single-line format "X(193)"
     1257                   .
     1258                   display stream Out-Stream
     1259                     skip space(5)
     1260                       "Итого"             @ v-goods-name
     1261                       v-pg-need-qnty      @ v-need-qnty
     1262                       v-pg-qnty-all       @ v-qnty-all
     1263                       v-pg-cost-sum       @ v-cost-sum
     1264                       v-pg-sale-sum       @ v-sale-sum
     1265                   with frame f-doc.
     1266               end.
     1267   display stream Out-Stream
     1268       "Всего по накладной" @ v-goods-name
     1269       t-doc.doc-qnty  @ v-need-qnty
     1270       t-doc.fact-qnty @ v-qnty-all
     1271       ( accum total v-cost-sum ) @ v-cost-sum
     1272       ( accum total v-sale-sum ) @ v-sale-sum
     1273   with frame f-doc .
     1274   down stream Out-Stream 2 with frame f-doc .
     1275   if PrintRubl then
     1276       run rep/wp-rub.p ( (accum total v-cost-sum), output s1, output s2 ) .
     1277   else
     1278       run rep/wp.p ( input p-mainmenu-handle, (accum total v-cost-sum), output s1, output s2 ) .
     1279   put stream Out-Stream
     1280       skip(1)
     1281         space(10)
     1282         "Всего на сумму"
     1283         caps(substring(s1, 1, 78)) format "X(78)"
     1284                                                   at 10 + 17
     1285         "Отпустил"                                at 10 + 97
     1286         v-underline format "X(19)"                at 10 + 107
     1287         v-underline format "X(19)"                at 10 + 128
     1288         v-underline format "X(30)"                at 10 + 148
     1289       skip
     1290         caps(substring(s1, 78 + 1)) format "X(78)"
     1291                                                   at 10 + 17
     1292         "должность"                               at center-field( 10 + 107, 10 + 128, 9)
     1293         "подпись"                                 at center-field( 10 + 128, 10 + 148, 6)
     1294         "расшифровка подписи"                     at center-field( 10 + 148, 10 + 178, 19)
     1295       skip(1) space(10)
     1296         "Отпуск разрешил:"
     1297         "Принял"                                  at 10 + 97
     1298         v-underline format "X(19)"                at 10 + 107
     1299         v-underline format "X(19)"                at 10 + 128
     1300         v-underline format "X(30)"                at 10 + 148
     1301       skip space(10)
     1302         "должность"                               at center-field( 10 + 107, 10 + 128, 9)
     1303         "подпись"                                 at center-field( 10 + 128, 10 + 148, 6)
     1304         "расшифровка подписи"                     at center-field( 10 + 148, 10 + 178, 19)
     1305       skip(1) space(10)
     1306         "Руководитель"
     1307         v-underline format "X(19)"                at 10 + 17
     1308         v-underline format "X(19)"                at 10 + 37
     1309         v-underline format "X(30)"                at 10 + 57
     1310         "Заведующий производством"                at 10 + 97
     1311         v-underline format "X(19)"                at 10 + 128
     1312         v-underline format "X(30)"                at 10 + 148
     1313       skip space(10)
     1314         "должность"                               at center-field( 10 + 17, 10 + 37, 9)
     1315         "подпись"                                 at center-field( 10 + 37, 10 + 57, 6)
     1316         "расшифровка подписи"                     at center-field( 10 + 57, 10 + 57 + 30, 19)
     1317         "подпись"                                 at center-field( 10 + 128, 10 + 148, 6)
     1318         "расшифровка подписи"                     at center-field( 10 + 148, 10 + 178, 19)
     1319   .
     1320   output stream Out-Stream close.
     1321   if session :set-wait-state( "" ) then.
     1322   if g#quest-print = false
     1323   then do:
     1324     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
     1325                                         7, (if 8 >= 8 then 2 else 0), 0, 0,
     1326                                         OUTPUT g#log ).
     1327   end.
     1328   else do:
     1329     os-command silent
     1330       value( "COPY /b " +
     1331         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
     1332         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
     1333         string( session:temp-directory) +  "$" + string( g#report-num )
     1334                 ) .
     1335     os-command silent
     1336       value( "COPY /b " +
     1337         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
     1338         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
     1339         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
     1340                 ) .
     1341   end.
     1342   end.
