      481       output g#quest-print
      482   ).
      483   find first t-doc
      484        where recid( t-doc ) = rec_id  no-lock
      485   .
      486   if    t-doc.ext-doc-type <> 'wm':U
      487     and t-doc.ext-doc-type <> 'im':U
      488   then do:
      489     return.
      490   end.
      491   DEFINE frame f-doc
      492           space(5)
      493           sym1 column-label "|" format "X(1)" space(0)
      494           v-doc-line-counter column-label " 1" format ">>9" space(1)
      495           sym2 column-label ":" format "X(1)" space(0)
      496           v-goods-artic column-label "        2       " format "X(16)" space(0)
      497           sym3 column-label ":" format "X(1)" space(0)
      498           v-goods-name column-label "                     3                      " format "X(44)" space(0)
      499           sym4 column-label ":" format "X(1)" space(0)
      500           v-bar-code column-label "    4    " format ">>>>>>>>9" space(0)
      501           sym5 column-label ":" format "X(1)" space(0)
      502           v-unit-name column-label "  5 " format "X(4)" space(0)
      503           sym6 column-label ":" format "X(1)" space(0)
      504           v-unit-OKEI column-label "  6 " format "X(4)" space(0)
      505           sym7 column-label ":" format "X(1)" space(0)
      506           v-need-qnty column-label "  7  " format ">>>9.99" space(0)
      507           sym8 column-label ":" format "X(1)" space(0)
      508           v-places-amount column-label "  8 " format ">>>9" space(0)
      509           sym9 column-label ":" format "X(1)" space(0)
      510           v-qnty-in-one-place column-label "  9  " format ">>9.9" space(0)
      511           sym10 column-label ":" format "X(1)" space(0)
      512           v-qnty-all column-label "  10 " format ">>>9.99" space(0)
      513           sym11 column-label ":" format "X(1)" space(0)
      514           v-cost-price column-label "     11      " format  "->,>>>,>>9.99" space(0)
      515           sym12 column-label ":" format "X(1)" space(0)
      516           v-cost-sum column-label   "      12      " format "->>,>>>,>>9.99" space(0)
      517           sym13 column-label ":" format "X(1)" space(0)
      518           v-sale-price column-label "     13      " format  "->,>>>,>>9.99" space(0)
      519           sym14 column-label ":" format "X(1)" space(0)
      520           v-sale-sum column-label   "     14       " format "->>,>>>,>>9.99" space(0)
      521           sym15 column-label ":" format "X(1)" space(0)
      522           v-comment column-label "        15         " format "X(19)" space(0)
      523           sym16 column-label "|" format "X(1)" space(0)
      524       with width 235 down stream-io.
      525   assign
      526       v-valut-name   = ( if PrintRubl then "рублях" else "баз.вал" )
      527       v-single-line  = fill("-", 230)
      528       v-underline    = fill("_", 230)
      529       v-line-counter = 1
      530   .
      531   assign
      532       tdoc-code = t-doc.doc-code
      533       tdoc-date = (if t-doc.status_ <> 'факт':U then t-doc.doc-date else t-doc.fact-date )
      534   .
      535   find first buf_clients no-lock
      536        where buf_clients.obj-type = t-doc.obj-type
      537          and buf_clients.obj-code = t-doc.obj-code
      538   no-error.
      539   case buf_clients.obj-type :
      540       when 'маг':U then
      541           do:
      542               find first shop no-lock
      543                    where shop.obj-code = buf_clients.obj-code
      544               .
      545               assign
      546                   tdoc-prt = shop.doc-prt.
      547               .
      548           end.
      549       when 'скл':U then
      550           do:
      551               find first store no-lock
      552                    where store.obj-code = buf_clients.obj-code
      553               .
      554               assign
      555                   tdoc-prt = store.doc-prt .
      556               .
      557           end.
      558   end case.
      559   assign
      560       v-org-from = buf_clients.obj-name
      561   .
      562   if not tdoc-prt
      563   then
      564       PrintScale = no
      565   .
      566   find first buf_clients no-lock
      567        where buf_clients.obj-type = t-doc.cli-type
      568          and buf_clients.obj-code = t-doc.cli-code
      569   no-error.
      570   assign
      571       v-org-to = buf_clients.obj-name
      572   .
      573   if session :set-wait-state( "compiler" ) then.
      574   output stream Out-Stream to value( string( session:temp-directory +
      575                                        "rpt" + string( g#report-num ) ) )
      576                                        page-size  value(43) .
      577   form header
      578       v-single-line format "X(193)" at 1 skip
      579       "Продолжение - на следующей странице" at 30 skip
      580       with frame BottomFrame width 235 page-bottom no-labels no-box .
      581   view stream Out-Stream frame BottomFrame .
      582   find first clients no-lock
      583        where clients.obj-type = 'орг':U
      584          and clients.obj-code = t-doc.host-code
      585   .
      586       case clients.obj-type:
      587          when 'орг':U
      588          then do:
      589               FIND ub.firm WHERE ub.firm.firm-code = clients.obj-code NO-LOCK .
      590               if available ub.firm
      591               then do:
      592                   assign
      593                       t-addres = ( if ub.firm.ind = 0 or ub.firm.ind = ? then "" else string( ub.firm.ind ) )
      594                       t-addres = t-addres
      595                           + ( if ub.firm.city = ? or trim(ub.firm.city) = ""
      596                               then ""
      597                               else ( (if t-addres = "" then "" else ", ") + trim( ub.firm.city ) )
      598                             )
      599                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 1, 50 ) ) )
      600                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
      601                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
      602                           + ( if  ub.firm.addres2 = ? or trim(ub.firm.addres2) = "" then "" else ( ", " + trim( ub.firm.addres2 ) ) )
      603                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 51, 50 ) ) )
      604                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
      605                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
      606                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 101, 50 ) ) )
      607                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
      608                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
      609                       t-phone = ub.firm.phone
      610                       t-inn   = ub.firm.inn
      611                       t-okpo  = ub.firm.okpo
      612                   .
      613               end.
      614          end.
      615          when 'маг':U
      616          then do:
      617               FIND ub.shop WHERE ub.shop.obj-code = clients.obj-code NO-LOCK .
      618               if available ub.shop
      619               then do:
      620                   assign
      621                       t-addres = ( if trim( shop.addres1 ) <> "" then ( trim( shop.addres1 ) ) else "" )
      622                               + ( if trim( shop.addres2 ) <> "" then ( ", " + trim( shop.addres2 ) ) else "" )
      623                       t-phone = shop.phone
      624                       t-inn = ""
      625                       t-okpo = ""
      626                   .
      627               end.
      628          end.
      629          when 'скл':U
      630          then do:
      631               FIND ub.store WHERE ub.store.obj-code = clients.obj-code NO-LOCK .
      632               if available ub.store
      633               then do:
      634                   assign
      635                       t-addres = ( if trim( ub.store.addres1 ) <> "" then ( trim( ub.store.addres1 ) ) else "" )
      636                               + ( if trim( ub.store.addres2 ) <> "" then ( ", " + trim( ub.store.addres2 ) ) else "" )
      637                       t-phone = ub.store.phone
      638                       t-inn = ""
      639                       t-okpo = ""
      640                   .
      641               end.
      642          end.
      643          when 'чел':U
      644          then do:
      645               find ub.person where ub.person.psn-code = clients.obj-code no-lock .
      646               if available ub.person
      647               then do:
      648                   assign
      649                       t-addres = ( if ub.person.ind <> 0 and ub.person.ind <> ? then string( ub.person.ind ) else "" )
      650                                   + ( if  ub.person.city <> ? and trim(ub.person.city) <> "" then ( ", " + trim( ub.person.city ) ) else "" )
      651                                   + ( if  ub.person.address <> ? and trim(ub.person.address) <> "" then ( ", " + trim( ub.person.address ) ) else "" )
      652                       t-phone = ub.person.phone1
      653                       t-inn = ub.person.inn
      654                       t-okpo = ub.person.okpo
      655                   .
      656               end.
      657          end.
      658       end case.
      659   assign
      660       v-organization = string( "ИНН " + t-inn + " " + CAPS( clients.obj-name ) + " (" + string(clients.obj-code) + ")"
      661                   + t-addres + t-phone)
      662   .
      663   put stream Out-Stream
      664     skip
      665       string( "Страница " + string( PAGE-NUMBER( Out-Stream ), ">>9" ) ) format "X(13)" at right-field( 5 + 193, 13)
      666     skip
      667       space(5) v-single-line format  "X(19)"             at 180
      668     skip
      669       space(5) "| "                                      at 180
      670                     'код':U                               at 188
      671                     "|"                                       at 5 + 193
      672     skip
      673       space(5) "Форма по ОКУД" format "X(14)"            at 166
      674                     "| "                                      at 180
      675                     "0330504"
      676                     "|"                                       at 5 + 193
      677     skip
      678       space(5) "Организация:                         "
      679                v-organization             format "X(100)"
      680                "по ОКПО"                  format "X(7)"       at 172
      681                "| "                                           at 180
      682                t-okpo                     format "X(16)" "|"  at 5 + 193
      683     skip
      684       space(5) "Струрное подразделение:              "
      685                     (if t-doc.doc-type = 'при':U then v-org-to else v-org-from) format "X(80)"
      686                     "| "                                      at 180
      687                     "|"                                       at 5 + 193
      688     skip
      689       space(5) "Струрное подразделение - получатель: "
      690                     (if t-doc.doc-type = 'при':U then v-org-from else v-org-to) format "X(80)"
      691                     "| "                                      at 180
      692                     "|"                                       at 5 + 193
      693     skip
      694       space(5) "Вид деятельности по ОКДП" format "X(25)" at 155
      695                     "| "                                      at 180
      696                     "|"                                       at 5 + 193
      697     skip
      698       space(5) "Вид операции"        format "X(12)"      at 167
      699                     "| "                                      at 180
      700                      ( if t-doc.doc-type = 'при':U
      701                      then " приход"
      702                      else ( if t-doc.doc-type = 'возврат':U then " возврат " else " расход" ) )
      703                                           format "X(16)"
      704                      "|"                                      at 5 + 193
      705     skip
      706       space(5) v-single-line         format  "X(19)"     at 180
      707   .
      708   put stream Out-Stream
      709      skip
      710       space(64) v-single-line format "X(33)"
      711      skip
      712       space(64) "|"
      713         "Номер"   at  center-field(65, 83, 5)
      714          "|"  at 84
      715          "Дата"   at  center-field(85, 96, 4)
      716          "|"  at 97
      717        format "X(33)"
      718      skip
      719       space(64) "|"
      720         "документа" format "X(9)" at  center-field(65, 83, 9)
      721          "|"  at 84
      722          "составления" format "X(11)" at  center-field(85, 96, 11)
      723          "|"  at 97
      724      skip
      725       space(64) "|"
      726                 v-single-line format "X(31)"
      727                 "|"  at 97
      728      skip
      729       space(54) string( "НАКЛАДНАЯ | "
      730                                   + string( tdoc-code , "X(16)") + " | "
      731                                   + string( tdoc-date, "99/99/9999") + " | "
      732                                   + (if t-doc.status_ <> 'факт':U then string( "(" + CAPS(t-doc.status_) + ")" ) else "")
      733                                   ) format "X(100)"
      734      skip
      735       space(64) v-single-line format "X(33)"
      736      skip
      737       space(50) "НА ОТПУСК ТОВАРА" format "X(20)"
      738   .
      739   form with frame f-doc .
      740   down stream Out-Stream 1 with frame f-doc no-labels.
      741   put stream Out-Stream
      742       skip space(5)
      743         string( "Цены и суммы указаны в " + trim( v-valut-name ) ) format "X(30)"
      744         ( if t-doc.status_ <> 'факт':U
      745           then string( "Статус документа: " + t-doc.status_ + " " + string( t-doc.flag_, "+/-" ) )
      746           else " " )
      747                                                     at 100 format "X(30)"
      748   .
      749   put stream Out-Stream
      750      skip space(5)
      751        v-single-line format "X(193)"
