     1163   if line-counter( Out-Stream ) + 9 > page-size( Out-Stream ) then
     1164       do:
     1165   define variable vss-include-info5 as character format "X(65)" no-undo
     1166   initial "@(#)$Workfile$ $Revision$".
     1167       if page-number( Out-Stream ) > PrevPage
