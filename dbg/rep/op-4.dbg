      869   .
      870   define variable vss-include-info2 as character format "X(65)" no-undo
      871   initial "@(#)$Workfile$ $Revision$".
      872           PUT stream Out-Stream
      873               skip space(5)
      874                 "|  1"
      875                 ":"                  at 5 + 6
      876                 "2"                  at center-field( 5 + 6, 5 + 23, 1)
      877                 ":"                  at 5 + 23
      878                 "3"                  at center-field( 5 + 23, 5 + 68, 1)
      879                 ":"                  at 5 + 68
