      895                 ":"                  at 5 + 129
      896                 "12"                 at center-field( 5 + 129, 5 + 144, 2)
      897                 ":"                  at 5 + 144
      898                 "13"                 at center-field( 5 + 144, 5 + 158, 2)
      899                 ":"                  at 5 + 158
      900                 "14"                 at center-field( 5 + 158, 5 + 173, 2)
      901                 ":"                  at 5 + 173
      902                 "15"                 at center-field( 5 + 173, 5 + 193, 2)
      903                 "|"                  at 5 + 193
      904               skip space(5)
      905                 "|"
      906                 v-single-line format "X(191)"
      907                 "|"                  at 5 + 193
      908           .
      909   for each doc-line no-lock
      910      where doc-line.doc-code = t-doc.doc-code
      911      break
      912            BY doc-line.artic
      913   :
      914       find first goods no-lock
      915            where goods.prod-type = doc-line.prod-type
      916              and goods.prod-code = doc-line.prod-code
      917              and goods.artic = doc-line.artic
      918       .
      919       find first gds-prt no-lock
      920            where gds-prt.upper-code = goods.prt-root
      921       .
      922       rootnode_code = gds-prt.node-code.
      923   assign
      924     price-rubl-with-tax-loc = doc-line.price-rubl
      925     price-base-with-tax-loc = doc-line.price-base
      926   .
      927   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      928   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      929     (output varinvprb
      930     )  .
      931      find first in-vatp_doc-attr no-lock
      932       where in-vatp_doc-attr.doc-code  = t-doc.doc-code
      933         and in-vatp_doc-attr.attr-code = 'envd':U
      934       no-error .
      935       if available in-vatp_doc-attr
      936          then do:
      937          assign
      938            in-vatp-have-vat-slt = no.
      939      end.
      940      else do:
      941        assign
      942          in-vatp-have-vat-slt = yes.
      943      end.
      944      find first in-vatp-goods where in-vatp-goods.artic     = doc-line.artic     and
      945                                        in-vatp-goods.prod-type = doc-line.prod-type and
      946                                        in-vatp-goods.prod-code = doc-line.prod-code no-lock.
      947      if (not t-doc.internal and
      948              t-doc.doc-type = 'при':U) or
      949         in-vatp-goods.gds-type = 'у':U then do:
      950         if varinvprb = "base":u then do:
      951           assign
      952             road-tax-base-loc = doc-line.road-tax
      953             road-tax-rubl-loc = doc-line.road-tax * t-doc.base-rate / t-doc.base-scale.
      954         end.
      955         else do:
      956           ASSIGN
      957             road-tax-rubl-loc = doc-line.road-tax
      958             road-tax-base-loc = doc-line.road-tax / t-doc.base-rate * t-doc.base-scale.
      959         end.
      960         if road-tax-base-loc = ? then road-tax-base-loc = 0.
      961         if road-tax-rubl-loc = ? then road-tax-rubl-loc = 0.
      962         assign
      963           road-tax-cli-loc = ?.
      964         ASSIGN
      965           transport-base-loc = (if doc-line.transport-base = ? then 0 else doc-line.transport-base)
      966           transport-rubl-loc = (if doc-line.transport-rubl = ? then 0 else doc-line.transport-rubl)
      967           transport-cli-loc  = 0
