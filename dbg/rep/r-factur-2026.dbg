      832   define variable v-torgconf-sup-schet-exists         as logical      no-undo.
      833   define variable v-torgconf-sup-bank-exists          as logical      no-undo.
      834   define variable v-torgconf-sup-bank-r-schet         as character    no-undo.
      835   define variable v-torgconf-sup-bank-c-schet         as character    no-undo.
      836   define variable v-torgconf-sup-bank-bik             as character    no-undo.
      837   define variable v-torgconf-sup-bank-name            as character    no-undo.
      838   define variable v-torgconf-sup-bank-addres          as character    no-undo.
      839   define variable v-torgconf-sup-bank-city            as character    no-undo.
      840   define variable v-torgconf-cli-type             as character    no-undo.
