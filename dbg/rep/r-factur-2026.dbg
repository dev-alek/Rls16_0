     6362                           v-tot-prt-doc-VAT        = v-tot-prt-doc-VAT     + v-prt-doc-VAT
     6363                           v-tot-prt-SLT            = v-tot-prt-SLT         + v-prt-SLT
     6364                           v-tot-prt-sum-no-VAT     = v-tot-prt-sum-no-VAT  + v-prt-sum-no-VAT
     6365                           v-tot-prt-doc-sum-no-VAT = v-tot-prt-doc-sum-no-VAT  + v-prt-doc-sum-no-VAT
     6366                           v-tot-prt-sum            = v-tot-prt-sum         + v-prt-sum
     6367                           v-tot-prt-doc-sum        = v-tot-prt-doc-sum     + v-prt-doc-sum
     6368                           .
