     7320               if v-diff-sum-no-VAT < 0 then v-tot-sum-no-VAT2   = v-tot-sum-no-VAT2 + abs(v-diff-sum-no-VAT).
     7321               if v-diff-VAT        > 0 then v-tot-VAT1          = v-tot-VAT1        + v-diff-VAT.
