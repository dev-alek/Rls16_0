      825   define variable v-torgconf-self-bank-exists         as logical      no-undo.
      826   define variable v-torgconf-self-bank-r-schet        as character    no-undo.
      827   define variable v-torgconf-self-bank-c-schet        as character    no-undo.
      828   define variable v-torgconf-self-bank-bik            as character    no-undo.
      829   define variable v-torgconf-self-bank-name           as character    no-undo.
