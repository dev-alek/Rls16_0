        1   block-level on error undo, throw.
        2   define input parameter p-mainmenu-handle    as handle           no-undo.
        3   define input parameter rec_id           as recid                no-undo.
        4   define input parameter invers           as logical              no-undo.
        5   define input parameter p-mode           as character            no-undo.
        6   define input parameter p-round          as character            no-undo.
        7   define input parameter p-no-slt         as logical              no-undo .
        8   define input parameter p-reverse        as logical              no-undo .
        9   define new global shared variable g#language as character no-undo .
       10   if g#language <> '' and g#language <> 'rus':U then do:
       11     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       12   end.
       13   FUNCTION MonthNameRusCase RETURNS CHARACTER ( INPUT i-month AS INTEGER, INPUT i-case AS INTEGER ) :
       14     DEFINE VARIABLE v-name AS CHARACTER NO-UNDO.
       15     RUN get-month-name-case IN THIS-PROCEDURE ( INPUT i-month, INPUT i-case, OUTPUT v-name ) NO-ERROR.
       16     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE v-name ).
       17   END FUNCTION.
       18   PROCEDURE get-month-name-case :
       19     DEFINE  INPUT PARAMETER p-month AS INTEGER   NO-UNDO.
       20     DEFINE  INPUT PARAMETER p-case  AS INTEGER   NO-UNDO.
       21     DEFINE OUTPUT PARAMETER p-name  AS CHARACTER NO-UNDO.
       22     DEFINE VARIABLE v-list AS CHARACTER NO-UNDO EXTENT 6 INITIAL
       23       [ "Январь,Февраль,Март,Апрель,Май,Июнь,Июль,Август,Сентябрь,Октябрь,Ноябрь,Декабрь",
       24         "января,февраля,марта,апреля,мая,июня,июля,августа,сентября,октября,ноября,декабря",
       25         "Январю,Февралю,Марту,Апрелю,Маю,Июню,Июлю,Августу,Сентябрю,Октябрю,Ноябрю,Декабрю",
       26         "Январь,Февраль,Март,Апрель,Май,Июнь,Июль,Август,Сентябрь,Октябрь,Ноябрь,Декабрь",
       27         "Январем,Февралем,Мартом,Апрелем,Маем,Июнем,Июлем,Августом,Сентябрем,Октябрем,Ноябрем,Декабрем",
       28         "Январе,Феврале,Марте,Апреле,Мае,Июне,Июле,Августе,Сентябре,Октябре,Ноябре,Декабре"              ].
       29     DO ON ERROR UNDO, RETURN ERROR :
       30       IF p-month < 1 OR p-month > 12 OR
       31          p-case  < 1 OR p-case  >  6 THEN DO:
       32         ASSIGN p-name = ?.
       33       END.                           ELSE DO:
       34         ASSIGN p-name = ENTRY( p-month, v-list[ p-case ] ).
       35       END.
       36     END.
       37   END PROCEDURE.
       38   FUNCTION Sparse RETURNS CHARACTER ( INPUT p-instring AS CHARACTER ) :
       39     DEFINE VARIABLE v-outstring AS CHARACTER NO-UNDO.
       40     RUN get-sparsed-string IN THIS-PROCEDURE ( INPUT p-instring, OUTPUT v-outstring ) NO-ERROR.
       41     RETURN ( IF ERROR-STATUS :ERROR THEN p-instring ELSE v-outstring ).
       42   END FUNCTION.
       43   PROCEDURE get-sparsed-string :
       44     DEFINE  INPUT PARAMETER p-instring  AS CHARACTER NO-UNDO.
       45     DEFINE OUTPUT PARAMETER p-outstring AS CHARACTER NO-UNDO INITIAL "":U.
       46     DEFINE VARIABLE jj AS INTEGER NO-UNDO.
       47     DO ON ERROR UNDO, RETURN ERROR :
       48       DO jj = 1 TO LENGTH( p-instring ) :
       49         ASSIGN p-outstring = p-outstring + ( IF p-outstring = "":U THEN "":U ELSE " ":U ) + SUBSTRING( p-instring, jj, 1 ).
       50       END.
       51       ASSIGN p-outstring = CAPS( TRIM( p-outstring ) ).
       52     END.
       53   END PROCEDURE.
