     7538               .
     7539   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input p-doc-code ,
     7540                           input 'idCountryContr':U ,
     7541                          output v-idContr ,
     7542                          output v-attr-type ) no-error .
     7543           assign
     7544               t-inn = substitute( "&1&2&3",
     7545                                v-torgconf-saler-inn,
     7546                                ( if v-torgconf-saler-kpp = "":U then "":U else "/":U ),
     7547                                v-torgconf-saler-kpp )
     7548               .
     7549           if lookup( "GreenL", p-mode ) <> 0
     7550               then
     7551           do:
     7552               assign
     7553                   v-plat-rasch-doc = "":U
     7554                   .
     7555           end.
     7556           else
     7557           do:
     7558               assign
     7559                   v-plat-rasch-doc = " N ":U + ( if p-round = 'round':U then ": ":U else " ":U ) + fill( " ", 6 ) + v-torgconf-plat-rasch-doc
     7560                   .
     7561           end.
     7562           if LOOKUP( "serv", p-mode ) <> 0 then v-out-name = '---------------------'  .
     7563           else if     buf_trn-doc.doc-type <> 'при':U
     7564                   and buf_trn-doc.doc-type <> 'возврат':U
     7565                   then v-out-name =  v-torgconf-consignee.
     7566               else v-out-name =  v-torgconf-cargo-to-value .
     7567           put stream OutStr-html unformatted
     7568               '<tr>' skip
     7569               '<td colspan="34" style="text-align: left;">Грузополучатель и его адрес</td>' skip
     7570               '<td></td>' skip
     7571               '<td colspan="85" style="border-bottom: 1px solid black;">' + v-out-name + '</td>' skip
     7572               '<td></td>' skip
     7573               '<td colspan="60">(4)</td>' skip
     7574               '</tr>'
     7575               '<tr>' skip
     7576               '<td colspan="31" style="text-align: left;">К платежно-расчетному документу</td>' skip
     7577               '<td></td>' skip
     7578               '<td colspan="88" style="border-bottom: 1px solid black;">' + string(v-plat-rasch-doc) + '</td>' skip
     7579               '<td></td>' skip
     7580               '<td colspan="60">(5)</td>' skip
     7581               '</tr>'
     7582               '<tr>' skip
     7583               '<td colspan="24" style="text-align: left;">Документ об отгрузке № п/п</td>' skip
     7584               '<td></td>' skip
     7585               '<td colspan="16" style="border-bottom: 1px solid black; text-align: center;">' + v-ship-doc + '</td>' skip
     7586               '<td colspan="4" style="text-align: center;">№</td>' skip
     7587               '<td colspan="16" style="border-bottom: 1px solid black; text-align: center;">' + buf_trn-doc.doc-code + '</td>' skip
     7588               '<td colspan="4" style="text-align: center;">от</td>' skip
     7589               '<td colspan="55" style="border-bottom: 1px solid black; text-align: center;">' + string(buf_trn-doc.doc-date) + '</td>' skip
     7590               '<td></td>' skip
     7591               '<td colspan="60">(5а)</td>' skip
     7592               '</tr>'
     7593               '<tr style="height:50px;">' skip
     7594               '<td text_wrap="true" colspan="120" style="text-align: left; vertical-align: bottom;">К счету-фактуре (счетам-фактурам), выставленному (выставленным) при получении оплаты, частичной оплаты или иных платежей в счет предстоящих поставок товаров (выполнения работ, оказания услуг), передачи имущественных прав N______________от _______________________________,</td>' skip
     7595               '<td rowspan="2"></td>' skip
     7596               '<td rowspan="2" colspan="60" style="vertical-align: middle;">(5б)</td>' skip
     7597               '</tr>'
     7598               '<tr>'
     7599               '<td text_wrap="true" colspan="120" style="text-align: left;">Исправление N_____________от   _______________________________ .</td>' skip
     7600               '</tr>'
     7601               '<tr>' skip
     7602               '<td colspan="24" style="text-align: left;">Покупатель</td>' skip
     7603               '<td></td>' skip
     7604               '<td colspan="95" style="border-bottom: 1px solid black;">' + string(v-torgconf-saler-name) + " (" + string(v-torgconf-saler-code) + ")" '</td>' skip
     7605               '<td></td>' skip
     7606               '<td colspan="60">(6)</td>' skip
     7607               '</tr>'
     7608               '<tr>' skip
     7609               '<td colspan="6" style="text-align: left;">Адрес</td>' skip
     7610               '<td></td>' skip
     7611               '<td colspan="113" style="border-bottom: 1px solid black;">' + v-torgconf-saler-addr + '</td>' skip
     7612               '<td></td>' skip
     7613               '<td colspan="60">(6а)</td>' skip
     7614               '</tr>'
     7615               '<tr>' skip
     7616               '<td colspan="24" style="text-align: left;">ИНН/КПП покупателя</td>' skip
     7617               '<td></td>' skip
     7618               '<td colspan="95" style="border-bottom: 1px solid black;">' + t-inn + '</td>' skip
     7619               '<td></td>' skip
     7620               '<td colspan="60">(6б)</td>' skip
     7621               '</tr>'
     7622               .
     7623           assign
     7624               t-currency = ( trim( ( if invers and buf_trn-doc.doc-type <> 'при':U then v-curr-name else ( if PrintRubl then v-rubl-name else v-base-name  ) ) ) )
     7625               .
     7626           put stream OutStr-html unformatted
     7627               '<tr>' skip
     7628               '<td colspan="35" style="text-align: left;">Валюта: наименование, код</td>' skip
     7629               '<td></td>' skip
     7630               '<td colspan="84" style="border-bottom: 1px solid black;">' + string(trim( ( if invers and buf_trn-doc.doc-type <> 'при':U then v-curr-name else ( if PrintRubl then v-rubl-name else v-base-name  ) ) ) ) + '</td>' skip
     7631               '<td></td>' skip
     7632               '<td colspan="60">(7)</td>' skip
     7633               '</tr>'
     7634               '<tr>' skip
     7635               '<td colspan="74" style="text-align: left;">Идентификатор государственного контракта, договора (соглашения) (при наличии)</td>' skip
     7636               '<td></td>' skip
     7637               '<td colspan="45" style="border-bottom: 1px solid black;">' + trim(v-idContr) + '</td>' skip
     7638               '<td></td>' skip
     7639               '<td colspan="60">(8)</td>' skip
     7640               '</tr>'
     7641               '<tr>' skip
     7642               '<td colspan="117" style="text-align: center;"></td>' skip
     7643               '<td colspan="64" style="text-align: right;"></td>' skip
     7644               '</tr>'
     7645               '</thead>'
     7646               '<tbody>'.
     7647       end.
     7648   end procedure.
     7649   procedure print-footer :
     7650       define variable v-base-code as integer   no-undo .
     7651       define variable v-base-abbr as character no-undo .
     7652       define buffer buf_currency for ub.currency.
     7653       do
     7654           on error undo, return error
     7655           :
     7656           put stream OutStr-html unformatted
     7657               '<tr>' skip
     7658               '<td colspan="57" style="text-align:left;">Всего к оплате (9)</td>' skip
     7659               '<TD text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(v-tot-sum-no-VAT,"->>>>>>>>>>>9.99",2) + '" colspan="11" style="text-align: right; border: 1px solid black;">' + fnc-convert-dot-to-colon(v-tot-sum-no-VAT,"->>>>>>>>>>>9.99",2) + '</TD>' skip
     7660               '<td colspan="14" style="text-align:center; border: 1px solid black;">Х</td>' skip
     7661               '<TD text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(v-tot-VAT,"->>>>>>>>>>>9.99",2) + '" colspan="9" style="text-align: right; border: 1px solid black;">' + fnc-convert-dot-to-colon(v-tot-VAT,"->>>>>>>>>>>9.99",2) + '</TD>' skip
     7662               '<TD text_wrap="true" num="0.00" val="' + fnc-convert-dot-to-colon(v-tot-sum,"->>>>>>>>>>>9.99",2) + '" colspan="13" style="text-align: right; border: 1px solid black;">' + fnc-convert-dot-to-colon(v-tot-sum,"->>>>>>>>>>>9.99",2) + '</TD>' skip
     7663               '<td colspan="77"></td>' skip
     7664               '</tr>'
     7665               .
     7666           put stream OutStr-html unformatted
     7667               '<tfoot>' skip
     7668               '<tr>' skip
     7669               '<td colspan="87" style="text-align:left;">Руководитель организации</td>' skip
     7670               '<td colspan="80" style="text-align:left;">Главный бухгалтер</td>' skip
     7671               '</tr>'
     7672               .
     7673           put stream OutStr-html unformatted
     7674               '<tr>' skip
     7675               '<td colspan="38" style="text-align:left;">или иное уполномоченное лицо</td>' skip
     7676               '<TD colspan="16" style="text-align: center;"></TD>'
     7677               '<TD colspan="2"></TD>' skip
     7678               '<TD colspan="29" style="text-align: center;">' + v-torgconf-main-boss + '</TD>'
     7679               '<TD colspan="2"></TD>'
     7680               '<td colspan="33" style="text-align:left;">или иное уполномоченное лицо</td>' skip
     7681               '<TD colspan="16" style="text-align: center;"></TD>'
     7682               '<TD colspan="2"></TD>' skip
     7683               '<TD colspan="29" style="text-align: center;">' + v-torgconf-main-buh + '</TD>'
     7684               '</TR>'skip
     7685               '<tr>' skip
     7686               '<td colspan="38" style="text-align:left;"></td>' skip
     7687               '<TD colspan="16" style="text-align: center; border-top: 1px solid black;">(подпись)</TD>'
     7688               '<TD colspan="2"></TD>' skip
     7689               '<TD colspan="29" style="text-align: center; border-top: 1px solid black;">(ф.и.о.)</TD>'
     7690               '<TD colspan="2"></TD>'
     7691               '<td colspan="33" style="text-align:left;"></td>' skip
     7692               '<TD colspan="16" style="text-align: center; border-top: 1px solid black;">(подпись)</TD>'
     7693               '<TD colspan="2"></TD>' skip
     7694               '<TD colspan="29" style="text-align: center; border-top: 1px solid black;">(ф.и.о.)</TD>'
     7695               '</TR>'skip
     7696               .
     7697           if v-torgconf-outegrp = no
     7698               then
     7699           do :
     7700               if trim(v-torgconf-self-host-name) = "":U
     7701                   then
     7702               do:
     7703                   v-torgconf-self-host-name = fill("_", 42).
     7704               end.
     7705               put stream OutStr-html unformatted
     7706                   '<tr>' skip
     7707                   '<td colspan="87" style="text-align:left;">Индивидуальный предприниматель</td>' skip
     7708                   '<td colspan="80" style="text-align:center;"></td>' skip
     7709                   '</tr>'
     7710                   .
     7711               if v-torgconf-self-host-egrip-date <> "":U
     7712                   or v-torgconf-self-host-egrip-num  <> "":U
     7713                   then
     7714               do:
     7715                   put stream OutStr-html unformatted
     7716                       '<tr>' skip
     7717                       '<td colspan="38" style="text-align:left;">или иное уполномоченное лицо</td>' skip
     7718                       '<TD colspan="16" style="text-align: center;"></TD>'
     7719                       '<TD colspan="2"></TD>' skip
     7720                       '<TD colspan="29" style="text-align: center;">' +  string(v-torgconf-self-host-name) + '</TD>'
     7721                       '<TD colspan="2"></TD>'
     7722                       '<td colspan="80" style="text-align:left;">' + substitute( "ЕГРИП N &1 от &2 ", v-torgconf-self-host-egrip-num, v-torgconf-self-host-egrip-date ) + '</td>' skip
     7723                       '</TR>'skip
     7724                       .
     7725               end.
     7726               else
     7727               do :
     7728                   put stream OutStr-html unformatted
     7729                       '<tr>' skip
     7730                       '<td colspan="38" style="text-align:left;">или иное уполномоченное лицо</td>' skip
     7731                       '<TD colspan="16" style="text-align: center;"></TD>'
     7732                       '<TD colspan="2"></TD>' skip
     7733                       '<TD colspan="29" style="text-align: center;"></TD>'
     7734                       '<TD colspan="2"></TD>'
     7735                       '<td colspan="80" style="text-align:left;"></td>' skip
     7736                       '</TR>'skip
     7737                       .
     7738               end.
     7739               put stream OutStr-html unformatted
     7740                   '<tr>' skip
     7741                   '<td colspan="38" style="text-align:left;"></td>' skip
     7742                   '<TD colspan="16" style="text-align: center; border-top: 1px solid black;">(подпись)</TD>'
     7743                   '<TD colspan="2"></TD>' skip
     7744                   '<TD colspan="29" style="text-align: center; border-top: 1px solid black;">(ф.и.о.)</TD>'
     7745                   '<TD colspan="2"></TD>'
     7746                   '<TD colspan="80" style="text-align: center; border-top: 1px solid black;">(Основной государственный регистрационный номер индивидуального предпринимателя и дата присвоения такого номера)</TD>'
     7747                   '</TR>'skip
     7748                   .
     7749           end.
     7750       end.
     7751   end procedure.
     7752   procedure get-DD:
     7753       define input parameter p-dat-date as date no-undo.
     7754       define output parameter p-str-day as character no-undo.
     7755       define variable v-str-date  as character no-undo.
     7756       define variable v-str-day   as character no-undo.
     7757       define variable v-num-month as character no-undo.
     7758       define variable v-str-month as character no-undo.
     7759       define variable v-str-year  as character no-undo.
     7760       v-str-date = string(p-dat-date).
     7761       do:
     7762           p-str-day = string(entry(1, v-str-date, "/")).
     7763       end.
     7764   end procedure.
     7765   procedure get-Month:
     7766       define input parameter p-dat-date as date no-undo.
     7767       define output parameter p-str-month as character no-undo.
     7768       define variable v-str-date  as character no-undo.
     7769       define variable v-str-day   as character no-undo.
     7770       define variable v-num-month as character no-undo.
     7771       define variable v-str-month as character no-undo.
     7772       define variable v-str-year  as character no-undo.
     7773       v-str-date = string(p-dat-date).
     7774       do:
     7775           v-num-month = entry(2, v-str-date, "/").
     7776           p-str-month = MonthNameRusCase(integer(v-num-month), 2).
     7777       end.
     7778   end procedure.
     7779   procedure get-YYYY:
     7780       define input parameter p-dat-date as date no-undo.
     7781       define output parameter p-str-year as character no-undo.
     7782       define variable v-str-date  as character no-undo.
     7783       define variable v-str-day   as character no-undo.
     7784       define variable v-num-month as character no-undo.
     7785       define variable v-str-month as character no-undo.
     7786       define variable v-str-year  as character no-undo.
     7787       v-str-date = string(p-dat-date).
     7788       do:
     7789           p-str-year = string(year(p-dat-date)).
     7790       end.
     7791   end procedure.
     7792   PROCEDURE get-report-num :
     7793       define output parameter p-report-num as integer no-undo .
     7794       do
     7795           on error undo, return error
     7796           :
     7797           if v-cntxa-report-num = 0 then
     7798           do:
     7799               run gbl/getrpnum.p (output p-report-num).
     7800               v-cntxa-report-num = p-report-num.
     7801           end.
     7802           else
     7803           do:
     7804               assign
     7805                   p-report-num = v-cntxa-report-num
     7806                   .
     7807           end.
     7808       end.
     7809   END PROCEDURE.
