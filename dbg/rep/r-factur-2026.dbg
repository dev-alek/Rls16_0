     3697   procedure torgconf-get-reason  :
     3698   define input parameter  p-doc-code       as character        no-undo.
     3699   define input parameter  p-reason-code    as integer          no-undo .
     3700   define input parameter  p-doc-type       as character        no-undo.
     3701       if p-reason-code > 0
     3702       then do:
     3703           define buffer buf_trn-reason for ub.trn-reason.
     3704           find first buf_trn-reason no-lock where buf_trn-reason.reason-code = p-reason-code no-error .
     3705           if available buf_trn-reason then assign v-torgconf-reason =  buf_trn-reason.reason-name .
     3706       end.
     3707       else do:
     3708           if p-doc-type = 'при':U
     3709           then  do:
     3710               define variable v-attr-type     as character    no-undo.
     3711               define variable v-attr-value    as character    no-undo.
     3712               run gbl/trdcat-v.p (input p-doc-code,input 'nids':U,output v-attr-value,output v-attr-type) .
     3713               assign v-torgconf-reason = v-attr-value .
     3714               run gbl/trdcat-v.p (input p-doc-code,input 'dids':U,output v-attr-value,output v-attr-type) .
     3715               assign v-torgconf-reason = v-torgconf-reason + " от " + v-attr-value .
     3716           end.
     3717       end.
     3718   end procedure.
     3719   define variable vss-include-info16 as character format "X(65)" no-undo
     3720   initial "@(#)$Workfile$ $Revision$".
     3721   define temp-table temp_p-fmt_string-part no-undo
     3722       field str-key       as integer
     3723       field string-part   as character
     3724       index pi is primary unique
     3725           str-key
     3726   .
     3727   define variable v-p-fmt-16-str-key    as integer      no-undo.
     3728   FUNCTION center-field RETURNS INTEGER (INPUT iStartPix AS INTEGER, iEndPix AS INTEGER,
     3729                                     iInput AS INTEGER).
     3730     def var v-start-print as integer no-undo .
     3731     if (iStartPix < 0) or (iEndPix < iStartPix) then return 0.
     3732     assign
     3733       v-start-print = INTEGER(iStartPix + ((iEndPix - iStartPix) / 2) - (iInput / 2))
     3734     .
     3735     RETURN v-start-print .
     3736   END FUNCTION.
     3737   FUNCTION right-field RETURNS INTEGER ( iEndPix AS INTEGER,
     3738                                     iInput AS INTEGER).
     3739     def var v-start-print as integer no-undo .
     3740     assign
     3741       v-start-print = INTEGER(iEndPix - 1 - iInput)
     3742     .
     3743     if v-start-print < 0 then return 0.
     3744     RETURN v-start-print .
     3745   END FUNCTION.
     3746   function p-fmt-align-string returns character (
     3747         p-in-string      as character
     3748       , p-page-width     as integer
     3749       , p-align-type     as character
     3750   ).
     3751       define variable v-string-length     as integer      no-undo.
     3752       define variable v-out-string        as character    no-undo.
     3753       assign
     3754           v-string-length = length( trim( p-in-string ) )
     3755       .
     3756       if v-string-length >= p-page-width
     3757       then do:
     3758           assign
     3759               v-out-string = trim( p-in-string )
     3760           .
     3761       end.
     3762       else do:
     3763           case p-align-type
     3764           :
     3765               when 'left':U
     3766               then do:
     3767                   assign
     3768                       v-out-string = trim( p-in-string )
     3769                   .
     3770               end.
     3771               when 'right':U
     3772               then do:
     3773                   assign
     3774                       v-out-string = fill( " ":U, p-page-width - v-string-length ) + trim( p-in-string )
     3775                   .
     3776               end.
     3777               when 'center':U
     3778               then do:
     3779                   assign
     3780                       v-out-string = fill( " ":U, integer( ( p-page-width - v-string-length ) / 2 ) ) + trim( p-in-string )
     3781                   .
     3782               end.
     3783           end case.
     3784       end.
     3785       return v-out-string .
     3786   end function.
     3787   procedure p-fmt-split-string :
     3788   define input parameter p-source-string  as character        no-undo.
     3789   define input parameter p-split-length   as integer          no-undo.
     3790   define output parameter p-string-1      as character        no-undo.
     3791   define output parameter p-string-2      as character        no-undo.
     3792   do
     3793   on error undo, return error
     3794   :
     3795       define variable v-space-pos    as integer      no-undo.
     3796       if length( p-source-string ) <= p-split-length
     3797       then do:
     3798           assign
     3799               p-string-1 = p-source-string
     3800           .
     3801       end.
     3802       else do:
     3803           assign
     3804               v-space-pos = r-index( p-source-string, " ":U, p-split-length )
     3805           .
     3806           if v-space-pos = 0
     3807           then do:
     3808               assign
     3809                   v-space-pos = index( p-source-string, " ":U )
     3810               .
     3811           end.
     3812           if v-space-pos = 0
     3813           then do:
     3814               assign
     3815                   p-string-1 = substring( p-source-string, 1, p-split-length )
     3816                   p-string-2 = trim( substring( p-source-string, p-split-length, p-split-length ) )
     3817               .
     3818           end.
     3819           else do:
     3820               assign
     3821                   p-string-1 = substring( p-source-string, 1, v-space-pos )
     3822                   p-string-2 = trim( substring( p-source-string, v-space-pos ) )
     3823               .
     3824           end.
     3825       end.
     3826   end.
     3827   end procedure.
     3828   procedure p-fmt-round :
     3829   define input parameter p-qnty               as decimal          no-undo.
     3830   define input parameter p-price-no-VAT       as decimal          no-undo.
     3831   define input parameter p-VAT                as decimal          no-undo.
     3832   define input parameter p-SLT                as decimal          no-undo.
     3833   define input parameter p-road-tax           as decimal          no-undo.
     3834   define output parameter p-new-price-no-VAT  as decimal          no-undo.
     3835   define output parameter p-new-VAT           as decimal          no-undo.
     3836   define output parameter p-new-SLT           as decimal          no-undo.
     3837   define output parameter p-new-sum-VAT       as decimal          no-undo.
     3838   define output parameter p-new-sum-SLT       as decimal          no-undo.
     3839   define output parameter p-new-sum-road-tax  as decimal          no-undo.
     3840   define output parameter p-new-sum-no-VAT    as decimal          no-undo.
     3841   define output parameter p-new-sum-full      as decimal          no-undo.
     3842       define variable v-vat-pc    as decimal      no-undo.
     3843       define variable v-slt-pc    as decimal      no-undo.
     3844   do
     3845   on error undo, return error
     3846   :
     3847       if p-price-no-VAT = 0
     3848       then do:
     3849           assign
     3850               p-new-price-no-VAT = 0.0
     3851               p-new-VAT          = ?
     3852               p-new-SLT          = ?
     3853               p-new-sum-VAT      = 0.0
     3854               p-new-sum-SLT      = 0.0
     3855               p-new-sum-no-VAT   = 0.0
     3856               p-new-sum-road-tax = 0.0
     3857               p-new-sum-full     = 0.0
     3858           .
     3859       end.
     3860       else do:
     3861           assign
     3862               v-vat-pc            = p-VAT / p-price-no-VAT
     3863               v-slt-pc            = p-SLT / ( p-price-no-VAT + p-VAT )
     3864               p-new-price-no-VAT  = round( p-price-no-VAT, 2 )
     3865               p-new-VAT           = round( p-new-price-no-VAT * v-vat-pc, 2 )
     3866               p-new-SLT           = round( ( p-new-price-no-VAT + p-new-VAT ) * v-slt-pc, 2 )
     3867               p-new-sum-VAT       = round( p-new-VAT          * p-qnty, 2 )
     3868               p-new-sum-SLT       = round( ( p-new-price-no-VAT + p-new-VAT ) * p-qnty * v-slt-pc, 2 )
     3869               p-new-sum-no-VAT    = round( p-new-price-no-VAT * p-qnty, 2 )
     3870               p-new-sum-road-tax  = round( p-road-tax * p-qnty, 2 )
     3871               p-new-sum-full      = round( ( p-new-price-no-VAT + p-new-VAT + p-new-SLT + p-road-tax ) * p-qnty, 2 )
     3872           .
     3873       end.
     3874   end.
     3875   end procedure.
     3876   procedure p-fmt-split :
     3877   define input parameter p-in-string      as character        no-undo.
     3878   define input parameter p-split-length   as integer          no-undo.
     3879       define variable v-start-pos     as integer      no-undo.
     3880       define variable v-end-pos       as integer      no-undo.
     3881       define buffer buf_temp_p-fmt_string-part        for temp_p-fmt_string-part.
     3882   do
     3883   for buf_temp_p-fmt_string-part
     3884   on error undo, return error
     3885   :
     3886       empty temp-table buf_temp_p-fmt_string-part.
     3887       if p-split-length < 1
     3888       then do:
     3889           undo, return error substitute( "p-fmt-split: Строка не может быть разбита на &1 частей", p-split-length ).
     3890       end.
     3891       assign
     3892           p-in-string                 = trim( p-in-string )
     3893           v-p-fmt-16-str-key   = 0
     3894           v-start-pos                 = 1
     3895           v-end-pos                   = length( p-in-string )
     3896       .
     3897       run p-fmt-get-string-range in this-procedure (
     3898             input p-in-string
     3899           , input p-split-length
     3900           , input v-start-pos
     3901           , output v-start-pos
     3902           , output v-end-pos
     3903       ).
     3904       do while v-end-pos <> 0
     3905       :
     3906           create buf_temp_p-fmt_string-part.
     3907           assign
     3908               v-p-fmt-16-str-key = v-p-fmt-16-str-key + 1
     3909           .
     3910           assign
     3911               buf_temp_p-fmt_string-part.str-key      = v-p-fmt-16-str-key
     3912               buf_temp_p-fmt_string-part.string-part  = substring( p-in-string, v-start-pos, v-end-pos - v-start-pos )
     3913           .
     3914           assign
     3915               v-start-pos = v-end-pos + 1
     3916           .
     3917           run p-fmt-get-string-range in this-procedure (
     3918                 input p-in-string
     3919               , input p-split-length
     3920               , input v-start-pos
     3921               , output v-start-pos
     3922               , output v-end-pos
     3923           ).
     3924       end.
     3925   end.
     3926   end procedure.
     3927   procedure p-fmt-get-string-range :
     3928   define input parameter p-in-string      as character        no-undo.
     3929   define input parameter p-split-length   as integer          no-undo.
     3930   define input parameter p-old-start-pos  as integer          no-undo.
     3931   define output parameter p-start-pos     as integer          no-undo.
     3932   define output parameter p-end-pos       as integer          no-undo.
     3933       define variable v-init-string    as character    no-undo.
     3934       define variable v-temp-char      as character    no-undo.
     3935       define variable v-temp-pos       as integer      no-undo.
     3936       define variable v-counter        as integer      no-undo.
     3937   do
     3938   on error undo, return error
     3939   :
     3940       assign
     3941           p-start-pos   = p-old-start-pos
     3942           v-init-string = substring( p-in-string, p-start-pos )
     3943       no-error.
     3944       if error-status :error
     3945       or trim( v-init-string ) = "":U
     3946       then do:
     3947           assign
     3948               p-end-pos = 0
     3949           .
     3950           undo, return .
     3951       end.
     3952       assign
     3953           v-temp-char   = substring( v-init-string, 1, 1 )
     3954       .
     3955       do
     3956       while trim( v-temp-char ) = "":U
     3957       :
     3958           assign
     3959               p-start-pos     = p-start-pos + 1
     3960               v-init-string   = substring( p-in-string, p-start-pos )
     3961               v-temp-char     = substring( v-init-string, 1, 1 )
     3962           .
     3963       end.
     3964       assign
     3965           v-temp-pos  = p-split-length
     3966           v-temp-char = substring( v-init-string, v-temp-pos, 1 )
     3967           v-counter   = 0
     3968       .
     3969       search-word-end:
     3970       do
     3971       while trim( v-temp-char ) <> "":U
     3972       :
     3973           assign
     3974               v-counter   = v-counter + 1
     3975           .
     3976           if v-counter > 20
     3977           then do:
     3978               assign
     3979                   v-temp-pos  = p-split-length
     3980               .
     3981               leave search-word-end.
     3982           end.
     3983           assign
     3984               v-temp-pos  = v-temp-pos - 1
     3985               v-temp-char = substring( v-init-string, v-temp-pos, 1 )
     3986           .
     3987       end.
     3988       assign
     3989           p-end-pos = p-start-pos + v-temp-pos - 1
     3990       .
     3991   end.
     3992   end procedure.
