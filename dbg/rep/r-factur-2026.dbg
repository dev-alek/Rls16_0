     6041                                               else ( transport-base-loc + other-base-loc ) )
     6042                               .
     6043                       end.
     6044                       if p-round = 'round':U
     6045                           then
     6046                       do:
     6047                           run p-fmt-round in this-procedure (
     6048                               input v-prt-qnty
     6049                               , input v-price-no-VAT
     6050                               , input v-VAT
     6051                               , input v-SLT
     6052                               , input 0
