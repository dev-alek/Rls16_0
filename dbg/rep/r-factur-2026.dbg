     4319   define output parameter p-prop-type-list as character no-undo .
     4320   define output parameter p-prop-label-list as character no-undo .
     4321   define output parameter p-global          as logical no-undo .
     4322   define output parameter p-host           as logical no-undo .
     4323   define output parameter p-shop           as logical no-undo .
     4324   define output parameter p-store          as logical no-undo .
     4325   define output parameter p-db             as logical no-undo .
