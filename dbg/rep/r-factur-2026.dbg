      284   function cross-list returns logical (
      285     input parfirst-stream  as character,
      286     input parsecond-stream as character,
      287     input pardelim         as character).
      288     if pardelim = ""
      289     or pardelim = ?
      290     then do:
      291       assign
      292         pardelim = ","
      293       .
      294     end.
      295     define variable vari            as integer no-undo .
      296     define variable varresult-cross as logical no-undo .
      297     assign
      298       varresult-cross = no
      299     .
      300     def var v-num-parfirst-stream as integer no-undo .
      301     assign
      302       v-num-parfirst-stream = num-entries(parfirst-stream, pardelim)
      303     .
      304     do vari = 1 to v-num-parfirst-stream
      305     :
      306       if lookup(entry(vari, parfirst-stream, pardelim)
      307                ,parsecond-stream
      308                ,pardelim
      309                ) > 0 then do:
      310         assign
      311           varresult-cross = yes
      312         .
      313         leave.
      314       end.
      315     end.
      316     return varresult-cross .
      317   end function.
      318   function hvrdtax return logical (input parrecid as recid):
      319   define variable varresult as logical no-undo.
      320   run hvrdtax-proc (input parrecid, output varresult).
      321   return varresult.
      322   end function.
      323   procedure hvrdtax-proc:
      324   define input  parameter parrecid  as recid   no-undo.
      325   define output parameter parresult as logical no-undo.
      326   define buffer bf_goods for ub.goods.
      327   define buffer bf_units for ub.units.
      328   define buffer rt_tax   for ub.tax.
      329   find first rt_tax   where rt_tax.tax-code    = integer('3':U) no-lock no-error.
      330   find first bf_goods where recid(bf_goods)    = parrecid              no-lock.
      331   find first bf_units where bf_units.unit-name = bf_goods.unit-base    no-lock.
      332   if available rt_tax and
      333       can-find(first ub.tax-units No-LOCK WHERE
      334                      ub.tax-units.tax-code = rt_tax.tax-code AND
      335                      LOOKUP(ub.tax-units.type, bf_units.type) > 0) then assign parresult = yes.
      336                                                       else assign parresult = no.
      337   end procedure.
      338   def var vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      339   procedure tax-name:
      340   define input  parameter pardef-tax  as character           no-undo.
      341   define output parameter parname-tax as character initial ? no-undo.
      342   define buffer bf_tax for ub.tax.
      343   do on error undo, return error :
      344      case pardef-tax:
      345         when 'vat':U then do:
      346                     find first bf_tax where bf_tax.tax-code = integer('1':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '1':U(не задействован)".
      347         end.
      348         when 'slt':U then do:
      349                     find first bf_tax where bf_tax.tax-code = integer('2':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '2':U(не задействован)".
      350         end.
      351         when 'rdt':U then do:
      352                     find first bf_tax where bf_tax.tax-code = integer('3':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '3':U(не задействован)".
      353         end.
      354         when 'exc':U then do:
      355                     find first bf_tax where bf_tax.tax-code = integer('4':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '4':U(не задействован)".
      356         end.
      357         otherwise do:
      358            return error "Задан неверный параметр " + pardef-tax + " .".
      359         end.
      360      end case.
      361   end.
      362   end procedure.
      363   define variable vss-include-info4 as character format "X(65)" no-undo
      364   initial "@(#)$Workfile$ $Revision$".
      365       def var v-tax-name      as char                         no-undo.
      366       def var v-tax-price     as decimal      init 0          no-undo.
      367       def var v-tax           as decimal      init 0          no-undo.
      368       def var v-tot-tax       as decimal      init 0          no-undo.
      369   define variable vss-include-info5 as character format "X(65)" no-undo
      370   initial "@(#)$Workfile$ $Revision$".
      371   define variable v-fmtcli-name          as character    no-undo.
      372   define variable v-fmtcli-engl-name     as character    no-undo.
      373   define variable v-fmtcli-addres        as character    no-undo.
      374   define variable v-fmtcli-post-addres   as character    no-undo.
      375   define variable v-fmtcli-full-addres   as character    no-undo.
      376   define variable v-fmtcli-phone         as character    no-undo.
      377   define variable v-fmtcli-inn           as character    no-undo.
      378   define variable v-fmtcli-kpp           as character    no-undo.
      379   define variable v-fmtcli-okpo          as character    no-undo.
      380   define variable v-fmtcli-country       as character    no-undo.
      381   define variable v-fmtcli-city          as character    no-undo.
      382   define variable v-fmtcli-index         as character    no-undo.
      383   define variable v-fmtcli-schet-exists  as logical      no-undo.
      384   define variable v-fmtcli-bank-exists   as logical      no-undo.
      385   define variable v-fmtcli-bank-r-schet  as character    no-undo.
      386   define variable v-fmtcli-bank-c-schet  as character    no-undo.
      387   define variable v-fmtcli-bank-bik      as character    no-undo.
      388   define variable v-fmtcli-bank-name     as character    no-undo.
      389   define variable v-fmtcli-bank-addres   as character    no-undo.
      390   define variable v-fmtcli-bank-city     as character    no-undo.
      391   procedure fmtcli-get-bank :
      392   define input parameter p-host-code      as integer          no-undo.
      393   define input parameter p-obj-type       as character        no-undo.
      394   define input parameter p-obj-code       as integer          no-undo.
      395   define input parameter p-curr-code      as integer          no-undo.
      396       define buffer buf_fin-schet     for ub.fin-schet.
      397       define buffer buf_fin-bank      for ub.fin-bank.
      398   do
      399   for buf_fin-schet
      400     , buf_fin-bank
      401   on error undo, return error
      402   :
      403       assign
      404           v-fmtcli-schet-exists       = no
      405           v-fmtcli-bank-exists        = no
      406           v-fmtcli-bank-r-schet       = "":U
      407           v-fmtcli-bank-c-schet       = "":U
      408           v-fmtcli-bank-bik           = "":U
      409           v-fmtcli-bank-name          = "":U
      410           v-fmtcli-bank-addres        = "":U
      411           v-fmtcli-bank-city          = "":U
      412       .
      413       search-for-schet:
      414       for each buf_fin-schet no-lock
      415          where buf_fin-schet.host-code = p-host-code
      416            and buf_fin-schet.cli-type  = p-obj-type
      417            and buf_fin-schet.cli-code  = p-obj-code
      418            and buf_fin-schet.curr-code = p-curr-code
      419       on error undo, return error
      420       :
      421           if buf_fin-schet.status_   = 'удал':U
      422           then do:
      423           end.
      424           else do:
      425               assign
      426                   v-fmtcli-schet-exists   = yes
      427                   v-fmtcli-bank-r-schet   = trim( buf_fin-schet.r-schet )
      428                   v-fmtcli-bank-c-schet   = trim( buf_fin-schet.c-schet )
      429               .
      430               find first buf_fin-bank no-lock
      431                    where buf_fin-bank.host-code = p-host-code
      432                      and buf_fin-bank.code-bank = buf_fin-schet.code-bank
      433               no-error.
      434               if available buf_fin-bank
      435               then do:
      436                   assign
      437                       v-fmtcli-bank-exists      = yes
      438                       v-fmtcli-bank-bik         = trim( buf_fin-bank.bik )
      439                       v-fmtcli-bank-name        = trim( buf_fin-bank.bank-name )
      440                       v-fmtcli-bank-addres      = trim(buf_fin-bank.addres)
      441                       v-fmtcli-bank-city      = trim(buf_fin-bank.bank-city)
      442                   .
      443               end.
      444               else do:
      445                   assign
      446                       v-fmtcli-bank-exists    = no
      447                       v-fmtcli-bank-bik       = "":U
      448                       v-fmtcli-bank-name      = "":U
      449                       v-fmtcli-bank-addres    = "":U
      450                       v-fmtcli-bank-city      = "":U
      451                   .
      452               end.
      453               leave search-for-schet.
      454           end.
      455       end.
      456   end.
      457   end procedure.
      458   procedure fmtcli-get-client :
      459   define input parameter p-obj-type       as character    no-undo.
      460   define input parameter p-obj-code       as integer      no-undo.
      461       define variable v-temp-fmtcli-address      as character     no-undo.
      462       define variable v-num-country-city    as integer      no-undo.
      463       define buffer buf_clients   for ub.clients.
      464       define buffer buf_firm      for ub.firm.
      465       define buffer buf_store     for ub.store.
      466       define buffer buf_shop      for ub.shop.
      467       define buffer buf_person    for ub.person.
      468   do
      469   for buf_clients
      470     , buf_firm
      471     , buf_store
      472     , buf_shop
      473     , buf_person
      474   on error undo, return error
      475   :
      476       assign
      477           v-fmtcli-name           = "":U
      478           v-fmtcli-addres         = "":U
      479           v-fmtcli-post-addres    = "":U
      480           v-fmtcli-full-addres    = "":U
      481           v-fmtcli-phone          = "":U
      482           v-fmtcli-inn            = "":U
      483           v-fmtcli-kpp            = "":U
      484           v-fmtcli-okpo           = "":U
      485           v-fmtcli-city           = "":U
      486           v-fmtcli-index          = "":U
      487           v-fmtcli-country        = "":U
      488       .
      489       find first buf_clients no-lock
      490            where buf_clients.obj-type = p-obj-type
      491              and buf_clients.obj-code = p-obj-code
      492       .
      493       assign
      494           v-fmtcli-name = buf_clients.obj-name
      495       .
      496       case buf_clients.obj-type:
      497          when 'орг':U
      498          then do:
      499               find first buf_firm no-lock
      500                    where buf_firm.firm-code = buf_clients.obj-code
      501                    no-error
      502               .
      503               if available buf_firm
      504               then do:
      505                   assign
      506                       v-num-country-city = num-entries( buf_firm.city )
      507                       v-fmtcli-engl-name = buf_firm.engl-name
      508                   .
      509                   if v-num-country-city > 0
      510                   then do:
      511                       assign
      512                           v-fmtcli-country    = trim( entry( 1, buf_firm.city ) )
      513                       .
      514                   end.
      515                   if v-num-country-city > 1
      516                   then do:
      517                       assign
      518                           v-fmtcli-city       = trim( entry( 2, buf_firm.city ) )
      519                       .
      520                   end.
      521                   run fmtcli-concatenate-strings in this-procedure (
      522                         input v-fmtcli-full-addres
      523                       , input v-fmtcli-country
      524                       , input ", ":U
      525                       , input 50
      526                       , output v-fmtcli-full-addres
      527                   ).
      528                   run fmtcli-concatenate-strings in this-procedure (
      529                         input v-fmtcli-full-addres
      530                       , input v-fmtcli-city
      531                       , input ", ":U
      532                       , input 50
      533                       , output v-fmtcli-full-addres
      534                   ).
      535                   run fmtcli-concatenate-strings in this-procedure (
      536                         input v-fmtcli-full-addres
      537                       , input IF buf_firm.ind = 0 THEN "" ELSE string( buf_firm.ind )
      538                       , input ", ":U
      539                       , input 50
      540                       , output v-fmtcli-full-addres
      541                   ).
      542                   run fmtcli-concatenate-strings in this-procedure (
      543                         input v-fmtcli-post-addres
      544                       , input v-fmtcli-country
      545                       , input ", ":U
      546                       , input 50
      547                       , output v-fmtcli-post-addres
      548                   ).
      549                   run fmtcli-concatenate-strings in this-procedure (
      550                         input v-fmtcli-post-addres
      551                       , input v-fmtcli-city
      552                       , input ", ":U
      553                       , input 50
      554                       , output v-fmtcli-post-addres
      555                   ).
      556                   run fmtcli-concatenate-strings in this-procedure (
      557                         input v-fmtcli-post-addres
      558                       , input string( buf_firm.ind )
      559                       , input ", ":U
      560                       , input 50
      561                       , output v-fmtcli-post-addres
      562                   ).
      563                   run fmtcli-concatenate-strings in this-procedure (
      564                         input substring( buf_firm.addres1, 1, 50 )
      565                       , input buf_firm.addres2
      566                       , input " ":U
      567                       , input 50
      568                       , output v-temp-fmtcli-address
      569                   ).
      570                   run fmtcli-concatenate-strings in this-procedure (
      571                         input v-temp-fmtcli-address
      572                       , input substring( buf_firm.addres1, 51, 50 )
      573                       , input " ":U
      574                       , input 50
      575                       , output v-temp-fmtcli-address
      576                   ).
      577                   run fmtcli-concatenate-strings in this-procedure (
      578                         input v-temp-fmtcli-address
      579                       , input substring( buf_firm.addres1, 101, 50 )
      580                       , input " ":U
      581                       , input 50
      582                       , output v-temp-fmtcli-address
      583                   ).
      584                   assign
      585                       v-fmtcli-addres = v-temp-fmtcli-address
      586                   .
      587                   if buf_firm.addres1 <> ?
      588                   then do:
      589                       run fmtcli-concatenate-strings in this-procedure (
      590                             input v-fmtcli-full-addres
      591                           , input v-fmtcli-addres
      592                           , input ", ":U
      593                           , input 0
      594                           , output v-fmtcli-full-addres
      595                       ).
      596                   end.
      597                   run fmtcli-concatenate-strings in this-procedure (
      598                         input substring( buf_firm.post-addr1, 1, 50 )
      599                       , input buf_firm.post-addr2
      600                       , input " ":U
      601                       , input 50
      602                       , output v-fmtcli-post-addres
      603                   ).
      604                   run fmtcli-concatenate-strings in this-procedure (
      605                         input v-fmtcli-post-addres
      606                       , input substring( buf_firm.post-addr1, 51, 50 )
      607                       , input " ":U
      608                       , input 50
      609                       , output v-fmtcli-post-addres
      610                   ).
      611                   run fmtcli-concatenate-strings in this-procedure (
      612                         input v-fmtcli-post-addres
      613                       , input substring( buf_firm.post-addr1, 101, 50 )
      614                       , input " ":U
      615                       , input 50
      616                       , output v-fmtcli-post-addres
      617                   ).
      618                   assign
      619                       v-fmtcli-phone         = buf_firm.phone
      620                       v-fmtcli-inn           = buf_firm.inn
      621                       v-fmtcli-kpp           = buf_firm.kpp
      622                       v-fmtcli-okpo          = buf_firm.okpo
      623                       v-fmtcli-index         = string( buf_firm.ind )
      624                   .
      625               end.
      626          end.
      627          when 'маг':U
      628          then do:
      629               find first buf_shop no-lock
      630                    where buf_shop.obj-code = buf_clients.obj-code
      631               .
      632               if available buf_shop
      633               then do:
      634                   run fmtcli-concatenate-strings in this-procedure (
      635                         input buf_shop.addres1
      636                       , input buf_shop.addres2
      637                       , input " ":U
      638                       , input 50
      639                       , output v-fmtcli-addres
      640                   ).
      641                   assign
      642                       v-fmtcli-full-addres = v-fmtcli-addres
      643                       v-fmtcli-post-addres = v-fmtcli-addres
      644                       v-fmtcli-phone       = buf_shop.phone
      645                       v-fmtcli-inn         = "":U
      646                       v-fmtcli-kpp         = "":U
      647                       v-fmtcli-okpo        = "":U
      648                       v-fmtcli-city        = "":U
      649                       v-fmtcli-index       = "":U
      650                   .
      651               end.
      652          end.
      653          when 'скл':U
      654          then do:
      655               find first buf_store no-lock
      656                    where buf_store.obj-code = buf_clients.obj-code
      657               .
      658               if available buf_store
      659               then do:
      660                   run fmtcli-concatenate-strings in this-procedure (
      661                         input buf_store.addres1
      662                       , input buf_store.addres2
      663                       , input " ":U
      664                       , input 50
      665                       , output v-fmtcli-addres
      666                   ).
      667                   assign
      668                       v-fmtcli-full-addres = v-fmtcli-addres
      669                       v-fmtcli-phone       = buf_store.phone
      670                       v-fmtcli-inn         = "":U
      671                       v-fmtcli-kpp         = "":U
      672                       v-fmtcli-okpo        = "":U
      673                       v-fmtcli-city        = "":U
      674                       v-fmtcli-index       = "":U
      675                   .
      676               end.
      677          end.
      678          when 'чел':U
      679          then do:
      680               find first buf_person no-lock
      681                    where buf_person.psn-code = buf_clients.obj-code
      682               .
      683               if available buf_person
      684               then do:
      685                   run fmtcli-concatenate-strings in this-procedure (
      686                         input ( if buf_person.ind = 0 or buf_person.ind = ?
      687                                 then "":U
      688                                 else string( buf_person.ind, "999999")
      689                                 )
      690                       , input buf_person.city
      691                       , input ", ":U
      692                       , input 0
      693                       , output v-fmtcli-full-addres
      694                   ).
      695                   assign
      696                       v-fmtcli-addres = buf_person.address
      697                   .
      698                   run fmtcli-concatenate-strings in this-procedure (
      699                         input v-fmtcli-full-addres
      700                       , input v-fmtcli-addres
      701                       , input ", ":U
      702                       , input 0
      703                       , output v-fmtcli-full-addres
      704                   ).
      705                   assign
      706                       v-fmtcli-phone     = buf_person.phone1
      707                       v-fmtcli-inn       = buf_person.inn
      708                       v-fmtcli-kpp       = buf_person.kpp
      709                       v-fmtcli-okpo      = buf_person.okpo
      710                       v-fmtcli-city      = buf_person.city
      711                       v-fmtcli-index     = string( buf_person.ind )
      712                   .
      713               end.
      714          end.
      715       end case.
      716   end.
      717   end procedure.
      718   procedure fmtcli-concatenate-strings :
      719   define input parameter p-string-1       as character        no-undo.
      720   define input parameter p-string-2       as character        no-undo.
      721   define input parameter p-delimiter      as character        no-undo.
      722   define input parameter p-length         as integer          no-undo.
      723   define output parameter p-out-string    as character        no-undo.
      724   do
      725   on error undo, return error
      726   :
      727       assign
      728           p-out-string = ( if p-string-1 = ?
      729                            then "":U
      730                            else trim( p-string-1 ) )
      731       .
      732       assign
      733           p-out-string = p-out-string
      734                        + ( if p-out-string = "":U
      735                            or length( p-out-string ) = p-length
      736                            or p-string-2 = ?
      737                            or trim( p-string-2 ) = "":U
      738                            then "":U
      739                            else p-delimiter )
      740                        + ( if p-string-2 = ?
      741                            or trim( p-string-2 ) = "":U
      742                            then "":U
      743                            else trim( p-string-2 ) )
      744       .
      745   end.
      746   end procedure.
