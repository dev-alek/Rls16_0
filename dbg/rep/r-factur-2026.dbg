     5581       ,input  0
     5582       ,input  0
     5583       ,input  0
     5584       ,input  no
     5585       ,output Log-Res
     5586       )  .
     5587   end.
     5588       if Log-Res
     5589           then
     5590       do:
     5591           run prn-lib-reportviewer-report-name in this-procedure (
     5592               input THIS-PROCEDURE
     5593               ,input v-file-name-rep-html
     5594               ).
     5595           if error-status:error then
     5596           do:
     5597               message return-value view-as alert-box.
     5598               return .
     5599           end.
     5600       end.
     5601       else
     5602       do:
     5603           run prn-lib-reportviewer-report-name in this-procedure (
     5604               input THIS-PROCEDURE
     5605               ,input v-file-name-rep-html
     5606               ).
     5607           if error-status:error then
     5608           do:
     5609               message return-value view-as alert-box.
     5610               return .
     5611           end.
     5612       end.
     5613   end.
     5614   procedure print-more:
     5615       do
     5616           on error undo, return error
     5617           :
     5618           define variable v-start-string as character no-undo.
     5619           define variable v-add-string   as character no-undo.
     5620           assign
     5621               v-start-string = gds-str2
     5622               .
     5623           do while trim(v-start-string) <> "" :
     5624               assign
     5625                   gds-str = v-start-string.
     5626               v-add-string = breakstr(gds-str, 42, input-output v-add-string, input-output v-start-string).
     5627           end.
     5628       end.
     5629   end procedure.
     5630   procedure print-line :
     5631       do
     5632           on error undo, return error
     5633           :
     5634           define variable v-print-parts as logical init no no-undo.
     5635           assign
     5636               v-add-str   = ""
     5637               v-start-str = ""
     5638               .
     5639           find first ub.goods no-lock
     5640               where ub.goods.prod-type = ub.doc-line.prod-type
     5641               and ub.goods.prod-code = ub.doc-line.prod-code
     5642               and ub.goods.artic = ub.doc-line.artic
     5643               .
     5644           find first ub.country no-lock
     5645               where ub.country.alpha1 = ub.goods.alpha1
     5646               no-error.
     5647           if lookup( "zum", p-mode ) <> 0
     5648               then
     5649           do:
     5650               assign
     5651                   v-country = ub.goods.engl-name
     5652                   .
     5653           end.
     5654           else
     5655           do:
     5656               if available ub.country and ub.country.num-code <> 643
     5657                   then
     5658               do:
     5659                   assign
     5660                       v-country-code = " " + string(ub.country.num-code)
     5661                       v-country      = ub.country.short-name
     5662                       .
     5663               end.
     5664               else
     5665               do:
     5666                   assign
     5667                       v-country-code = ""
     5668                       v-country      = ""
     5669                       .
     5670               end.
     5671           end.
     5672           assign
     5673               gds-str  = ''
     5674               gds-str1 = ''
     5675               gds-str2 = ''
     5676               .
     5677           find first ub.Units no-lock
     5678               where ub.units.unit-name = ub.goods.unit-base
     5679               .
     5680           if v-uaes-code = "" then v-uaes-code = "-" .
     5681           v-unit-code = (if ub.units.OKEI = 0 then "-" else string(ub.units.OKEI)) .
     5682           if (units.type = "дро,2ед"  or  ub.units.type = "дро,доп" )
     5683               then
     5684           do:
     5685               assign
     5686                   str = (if rep-artic then (string(ub.goods.artic,"x(16)") +  " ") else "")  + string(ub.goods.Sort,"x(5)") + " " + trim(ub.goods.gds-name)
     5687                                                                                    + " " + trim(ub.goods.PS)
     5688                   .
     5689           end.
     5690           else
     5691           do:
     5692               assign
     5693                   str = (if rep-artic then (string(ub.goods.artic,"x(16)") +  " ") else "")  + trim(ub.goods.gds-name)
     5694                   .
     5695           end.
     5696           assign
     5697               Gds-str1 = breakstr(str, 42, input-output gds-str1, input-output gds-str2)
     5698               .
     5699           do while trim(gds-str2) <> "" :
     5700               assign
     5701                   gds-str  = gds-str2
     5702                   gds-str1 = breakstr(gds-str, 42, input-output gds-str1, input-output gds-str2)
     5703                   .
     5704           end.
     5705           assign
     5706               gds-str1 = breakstr(str, 42, input-output gds-str1, input-output gds-str2).
     5707           .
     5708           find first ub.gds-prt no-lock
     5709               where ub.gds-prt.upper-code = ub.doc-line.prt-root
     5710               .
     5711           assign
     5712               rootnode_code = ub.gds-prt.node-code
     5713               .
     5714           assign
     5715               v-tot-prt-qnty           = 0
     5716               v-tot-prt-doc-qnty       = 0
     5717               v-tot-prt-VAT            = 0
     5718               v-tot-prt-doc-VAT        = 0
     5719               v-tot-prt-SLT            = 0
     5720               v-tot-prt-sum-no-VAT     = 0
     5721               v-tot-prt-doc-sum-no-VAT = 0
     5722               v-tot-prt-sum            = 0
     5723               v-tot-prt-doc-sum        = 0
     5724               v-VAT                    = 0
     5725               v-doc-VAT                = 0
     5726               v-SLT                    = 0
     5727               v-sum-no-VAT             = 0
     5728               v-doc-sum-no-VAT         = 0
     5729               v-tax                    = 0
     5730               .
     5731           if ( ub.gds-prt.node-name <> '_Пустая шкала':U )
     5732               then
     5733           do:
     5734               assign
     5735                   v-tot-prt-qnty           = 0
     5736                   v-tot-prt-doc-qnty       = 0
     5737                   v-tot-prt-VAT            = 0
     5738                   v-tot-prt-doc-VAT        = 0
     5739                   v-tot-prt-SLT            = 0
     5740                   v-tot-prt-sum-no-VAT     = 0
     5741                   v-tot-prt-doc-sum-no-VAT = 0
     5742                   v-tot-prt-sum            = 0
     5743                   v-tot-prt-doc-sum        = 0
     5744                   v-must-print-scale       = PrintScale
     5745                   .
     5746               if v-must-print-scale = yes
     5747                   then
     5748               do:
     5749                   define variable is-printed as logical initial no no-undo .
     5750                   for each ub.parts no-lock
     5751                       where ub.parts.out-code  = ub.doc-line.doc-code
     5752                       and ub.parts.obj-type  = ub.doc-line.obj-type
     5753                       and ub.parts.obj-code  = ub.doc-line.obj-code
     5754                       and ub.parts.artic     = ub.doc-line.artic
     5755                       and ub.parts.prod-type = ub.doc-line.prod-type
     5756                       and ub.parts.prod-code = ub.doc-line.prod-code
     5757                       :
     5758                       jj = jj + 1 .
     5759                       assign
     5760                           v-GTD = (if trim(ub.parts.cst-code) <> "" then ub.parts.cst-code else "-").
     5761                       if available ub.country
     5762                           and ub.country.alpha1 = "RU":U
     5763                           then
     5764                       do:
     5765                           assign
     5766                               v-GTD          = "-":U
     5767                               v-country      = "":U
     5768                               v-country-code = "":U
     5769                               .
     5770                       end.
     5771                       find first buf_parts-attr no-lock
     5772                           where buf_parts-attr.in-code   = ub.parts.in-code
     5773                           and buf_parts-attr.gds-code  = ub.goods.gds-code
     5774                           and buf_parts-attr.part-code = ub.parts.part-code
     5775                           no-error .
     5776                       if available buf_parts-attr
     5777                           and buf_parts-attr.country-code <> 0
     5778                           then
     5779                       do:
     5780                           find first buf_country
     5781                               where buf_country.num-code = buf_parts-attr.country-code
     5782                               no-error.
     5783                           if available buf_country
     5784                               and buf_country.num-code <> ub.country.num-code
     5785                               and buf_country.short-name <> "" and ub.country.num-code <> 643
     5786                               then
     5787                           do :
     5788                               assign
     5789                                   v-country-code = " " + string(buf_country.num-code)
     5790                                   v-country      = buf_country.short-name
     5791                                   .
     5792                               if buf_country.alpha1 = "RU":U
     5793                                   then
     5794                               do :
     5795                                   assign
     5796                                       v-country-code = "":U
     5797                                       v-country      = "":U
     5798                                       v-GTD          = "-":U
     5799                                       .
     5800                               end .
     5801                           end.
     5802                       end.
     5803                       if is-printed = no then
     5804                       do:
     5805                           assign
     5806                               is-printed = yes .
     5807                           if lookup ( "corr", p-mode ) <> 0 then
     5808                           do :
     5809                           end.
     5810                           else
     5811                           do :
     5812                               put stream OutStr-html unformatted
     5813                                   '<TR>' skip
     5814                                   '<TD colspan="4" text_wrap="true" style="text-align: center;">' + string(jj) + '</TD>' skip
     5815                                   '<TD colspan="15" style="text-align: center;"></TD>' skip
     5816                                   '<TD colspan="6" style="text-align: center;"></TD>' skip
     5817                                   '<TD colspan="5" style="text-align: center;"></TD>' skip
     5818                                   '<TD colspan="11" style="text-align: center;"></TD>' skip
     5819                                   '<TD colspan="7" style="text-align: center;"></TD>' skip
     5820                                   '<TD colspan="9" style="text-align: center;"></TD>' skip
     5821                                   '<TD colspan="11" style="text-align: center;"></TD>' skip
     5822                                   '<TD colspan="7" style="text-align: center;"></TD>' skip
     5823                                   '<TD colspan="7" style="text-align: center;"></TD>' skip
     5824                                   '<TD colspan="9" style="text-align: center;"></TD>' skip
     5825                                   '<TD colspan="13" style="text-align: center;"></TD>' skip
     5826                                   '<TD colspan="7" text_wrap="true" style="text-align: center;">' + v-country-code + '</TD>' skip
     5827                                   '<TD colspan="10" text_wrap="true" style="text-align: center;">' + v-country + '</TD>' skip
     5828                                   '<TD colspan="15" text_wrap="true" style="text-align: center;">' + v-GTD + '</TD>' skip
     5829                                   '<TD colspan="7" style="text-align: center;"></TD>' skip
     5830                                   '<TD colspan="9" style="text-align: center;"></TD>' skip
     5831                                   '<TD colspan="15" style="text-align: center;"></TD>' skip
     5832                                   '<TD colspan="14" style="text-align: center;"></TD>' skip
     5833                                   '</TR>'skip
     5834                                   .
     5835                           end.
     5836                       end.
     5837                       else
     5838                       do:
     5839                           if v-GTD <> "" and v-GTD <> "-" then
     5840                           do:
     5841                               put stream OutStr-html unformatted
     5842                                   '<TR>' skip
     5843                                   '<TD colspan="4" text_wrap="true" style="text-align: center;">' + string(jj) + '</TD>' skip
     5844                                   '<TD colspan="15" style="text-align: center;"></TD>' skip
     5845                                   '<TD colspan="6" style="text-align: center;"></TD>' skip
     5846                                   '<TD colspan="5" style="text-align: center;"></TD>' skip
     5847                                   '<TD colspan="11" style="text-align: center;"></TD>' skip
     5848                                   '<TD colspan="7" style="text-align: center;"></TD>' skip
     5849                                   '<TD colspan="9" style="text-align: center;"></TD>' skip
     5850                                   '<TD colspan="11" style="text-align: center;"></TD>' skip
     5851                                   '<TD colspan="7" style="text-align: center;"></TD>' skip
     5852                                   '<TD colspan="7" style="text-align: center;"></TD>' skip
     5853                                   '<TD colspan="9" style="text-align: center;"></TD>' skip
     5854                                   '<TD colspan="13" style="text-align: center;"></TD>' skip
     5855                                   '<TD colspan="7" style="text-align: center;"></TD>' skip
     5856                                   '<TD colspan="10" style="text-align: center;"></TD>' skip
     5857                                   '<TD colspan="15" text_wrap="true" style="text-align: center;">' + v-GTD + '</TD>' skip
     5858                                   '<TD colspan="7" style="text-align: center;"></TD>' skip
     5859                                   '<TD colspan="9" style="text-align: center;"></TD>' skip
     5860                                   '<TD colspan="15" style="text-align: center;"></TD>' skip
     5861                                   '<TD colspan="14" style="text-align: center;"></TD>' skip
     5862                                   '</TR>'skip
     5863                                   .
     5864                           end.
     5865                       end.
     5866                   end.
     5867                   if is-printed = no then
     5868                   do:
     5869                       put stream OutStr-html unformatted
     5870                           '<TR>' skip
     5871                           '<TD colspan="4" text_wrap="true" style="text-align: center;">' + string(jj) + '</TD>' skip
     5872                           '<TD text_wrap="true" colspan="15" style="text-align: center;">' + if rep-artic then (string(goods.artic,"x(16)") +  " ") + goods.gds-name   + '</TD>' else goods.gds-name + '</td>' skip
     5873                           '<TD colspan="6" style="text-align: center;"></TD>' skip
     5874                           '<TD colspan="5" style="text-align: center;"></TD>' skip
     5875                           '<TD colspan="11" style="text-align: center;"></TD>' skip
     5876                           '<TD colspan="7" style="text-align: center;"></TD>' skip
     5877                           '<TD colspan="9" style="text-align: center;"></TD>' skip
     5878                           '<TD colspan="11" style="text-align: center;"></TD>' skip
     5879                           '<TD colspan="7" style="text-align: center;"></TD>' skip
     5880                           '<TD colspan="7" style="text-align: center;"></TD>' skip
     5881                           '<TD colspan="9" style="text-align: center;"></TD>' skip
     5882                           '<TD colspan="13" style="text-align: center;"></TD>' skip
     5883                           '<TD colspan="7" text_wrap="true" style="text-align: center;">' + v-country-code + '</TD>' skip
     5884                           '<TD colspan="10" text_wrap="true" style="text-align: center;">' + v-country + '</TD>' skip
     5885                           '<TD colspan="15" style="text-align: center;"></TD>' skip
     5886                           '<TD colspan="7" style="text-align: center;"></TD>' skip
     5887                           '<TD colspan="9" style="text-align: center;"></TD>' skip
     5888                           '<TD colspan="15" style="text-align: center;"></TD>' skip
     5889                           '<TD colspan="14" style="text-align: center;"></TD>' skip
     5890                           '</TR>'skip
     5891                           .
     5892                       if FullGdsName
     5893                           and gds-str1 <> "":U then
     5894                       do :
     5895                           run print-more in this-procedure.
     5896                       end.
     5897                   end.
     5898               end.
     5899               for each ub.gds-dtl no-lock
     5900                   where ub.gds-dtl.prod-type  = ub.doc-line.prod-type
     5901                   and ub.gds-dtl.prod-code  = ub.doc-line.prod-code
     5902                   and ub.gds-dtl.artic      = ub.doc-line.artic
     5903                   and ub.gds-dtl.doc-code   = ub.doc-line.doc-code
     5904                   :
     5905                   find first ub.gds-prt no-lock
     5906                       where ub.gds-prt.node-code = ub.gds-dtl.prt-code
     5907                       .
     5908                   if CostPrice = yes
     5909                       then
     5910                   do:
     5911   assign
     5912     price-rubl-with-tax-loc = ub.doc-line.price-rubl
     5913     price-base-with-tax-loc = ub.doc-line.price-base
     5914   .
     5915   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     5916   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     5917     (output varinvprb
     5918     )  .
     5919      find first in-vatp_doc-attr no-lock
     5920       where in-vatp_doc-attr.doc-code  = buf_trn-doc.doc-code
     5921         and in-vatp_doc-attr.attr-code = 'envd':U
     5922       no-error .
     5923       if available in-vatp_doc-attr
     5924          then do:
     5925          assign
     5926            in-vatp-have-vat-slt = no.
     5927      end.
     5928      else do:
     5929        assign
     5930          in-vatp-have-vat-slt = yes.
     5931      end.
     5932      find first in-vatp-goods where in-vatp-goods.artic     = ub.doc-line.artic     and
     5933                                        in-vatp-goods.prod-type = ub.doc-line.prod-type and
     5934                                        in-vatp-goods.prod-code = ub.doc-line.prod-code no-lock.
     5935      if (not buf_trn-doc.internal and
     5936              buf_trn-doc.doc-type = 'при':U) or
     5937         in-vatp-goods.gds-type = 'у':U then do:
     5938         if varinvprb = "base":u then do:
     5939           assign
     5940             road-tax-base-loc = ub.doc-line.road-tax
     5941             road-tax-rubl-loc = ub.doc-line.road-tax * buf_trn-doc.base-rate / buf_trn-doc.base-scale.
     5942         end.
     5943         else do:
     5944           ASSIGN
     5945             road-tax-rubl-loc = ub.doc-line.road-tax
     5946             road-tax-base-loc = ub.doc-line.road-tax / buf_trn-doc.base-rate * buf_trn-doc.base-scale.
     5947         end.
     5948         if road-tax-base-loc = ? then road-tax-base-loc = 0.
     5949         if road-tax-rubl-loc = ? then road-tax-rubl-loc = 0.
     5950         assign
     5951           road-tax-cli-loc = ?.
     5952         ASSIGN
     5953           transport-base-loc = (if ub.doc-line.transport-base = ? then 0 else ub.doc-line.transport-base)
     5954           transport-rubl-loc = (if ub.doc-line.transport-rubl = ? then 0 else ub.doc-line.transport-rubl)
     5955           transport-cli-loc  = 0
     5956           other-base-loc     = (if ub.doc-line.other-base     = ? then 0 else ub.doc-line.other-base)
     5957           other-rubl-loc     = (if ub.doc-line.other-rubl     = ? then 0 else ub.doc-line.other-rubl)
     5958           other-cli-loc      = 0
     5959           vat-pc-loc         = (if ub.doc-line.vat-pc         = ? then 0 else ub.doc-line.vat-pc)
     5960           slt-pc-loc         = (if ub.doc-line.slt-pc         = ? then 0 else ub.doc-line.slt-pc).
     5961                                 ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     5962               ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     5963         assign
     5964           vat-cli-loc            = ?
     5965           slt-cli-loc            = ?
     5966           price-cli-with-tax-loc = ?.
     5967      end.
     5968      else do:
     5969                                                   for each in-vatp-parts where in-vatp-parts.out-code  = ub.doc-line.doc-code  and
     5970                                         in-vatp-parts.obj-type  = ub.doc-line.obj-type  and
     5971                                         in-vatp-parts.obj-code  = ub.doc-line.obj-code  and
     5972                                         in-vatp-parts.artic     = ub.doc-line.artic     and
     5973                                         in-vatp-parts.prod-type = ub.doc-line.prod-type and
     5974                                         in-vatp-parts.prod-code = ub.doc-line.prod-code
     5975                            use-index out-code no-lock:
     5976             accumulate  in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty (total)
     5977                         in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty (total)
     5978                         in-vatp-parts.transport-base * in-vatp-parts.fact-qnty (total)
     5979                         in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty (total)
     5980                         in-vatp-parts.other-base     * in-vatp-parts.fact-qnty (total)
     5981                         in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty (total)
     5982                                                                                                                 (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  (total)
     5983                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
