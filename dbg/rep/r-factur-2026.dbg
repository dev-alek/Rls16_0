      124   function breakstr returns character ( input        for-name    as character,
      125                                         input        line-length as integer,
      126                                         input-output line1       as character,
      127                                         input-output line2       as character ) :
      128     define variable ii as integer no-undo.
      129     if length( for-name ) > line-length then do:
      130       assign ii    = 1
      131              line1 = "":u
      132              line2 = "":u.
      133       if length( entry( ii, for-name , " ":u ) ) > line-length then do:
      134         assign line1 =       substring( for-name, 1, line-length     )
      135                line2 = trim( substring( for-name,    line-length + 1 ) ).
      136       end.                                                     else do:
      137         do while length( line1 + entry( ii, for-name, " ":u ) ) < ( line-length + 1 ) :
      138           assign line1 = line1 + entry( ii, for-name, " ":u ) + " ":u
      139                  ii    = ii    + 1.
      140           if length( entry( ii, for-name, " ":u ) ) > line-length then do:
      141             assign line1 = line1 + substring( for-name, length( line1 ), line-length - length( line1 ) + 1 ).
      142           end.
      143         end.
      144         assign line2 = trim( substring( for-name, length( line1 ) ) ).
      145       end.
      146     end.                                else do:
      147       assign line1 = for-name
      148              line2 = "":u.
      149     end.
      150     return ( line1 ).
      151   end function.
