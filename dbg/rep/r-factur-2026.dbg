      793   define variable v-torgconf-self-host-egrip-date     as character    no-undo.
      794   define variable v-torgconf-self-host-egrip-num      as character    no-undo.
      795   define variable v-torgconf-sup-host-code            as integer      no-undo.
      796   define variable v-torgconf-sup-host-type            as character  INITIAL 'орг':U  no-undo.
      797   define variable v-torgconf-sup-host-name            as character    no-undo.
