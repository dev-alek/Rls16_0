     4563   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4564   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4565   define  stream PrnLibStream.
     4566   procedure prn-lib-prn-file :
     4567     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     4568     define input parameter p-DIsabledoptions as integer no-undo .
     4569     define variable v-report-name as character no-undo .
     4570     define variable v-user-action as character no-undo .
     4571     define variable v-printed     as logical   no-undo .
     4572     define variable v-exist       as logical   no-undo .
     4573     do
     4574       on error undo, return error
     4575       :
     4576       run prn-lib-get-report-name  in this-procedure (
     4577         input parParentProc
     4578         ,output v-report-name
     4579         ).
     4580   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4581   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     4582     (input  v-report-name
     4583     ,input  2
     4584     ,output v-exist
     4585     )  .
     4586       if NOT v-exist then
     4587       DO:
     4588         Message
     4589           "Нет заданий на печать ! "
     4590           view-as alert-box .
     4591         Return  .
     4592       End.
     4593       run gbl/prnfilen.w
     4594         (input  ""
     4595         ,input  p-DisabledOptions
     4596         ,input  string(v-report-name )
     4597         ,input  7
     4598         ,output v-user-action
     4599         ,output v-printed
     4600         ) .
     4601       if v-printed then
     4602       do:
     4603         return "YES" .
     4604       end.
     4605       else
     4606       do:
     4607         return "NO" .
     4608       end.
     4609     end.
     4610   end procedure.
     4611   procedure prn-lib-open-stream :
     4612     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     4613     define input parameter p-page-size    as integer no-undo .
     4614     define input parameter p-is-stream    as logical no-undo .
     4615     define input parameter p-append       as logical no-undo .
     4616     define variable v-report-name as character no-undo .
     4617     do
     4618       on error undo, return error
     4619       :
     4620       run prn-lib-get-report-name  in this-procedure (
     4621         input parParentProc
     4622         ,output v-report-name
     4623         ).
     4624       if p-is-stream then
     4625       do:
     4626         if p-append then
     4627         do:
     4628           output stream PrnLibStream to value( v-report-name )
     4629             page-size value(p-page-size) append .
     4630         end.
     4631         if not p-append then
     4632         do:
     4633           output stream PrnLibStream to value( v-report-name )
     4634             page-size value(p-page-size) .
     4635         end.
     4636       end.
     4637       if not p-is-stream then
     4638       do:
     4639         if p-append then
     4640         do:
     4641           output to value( v-report-name )
     4642             page-size value(p-page-size) append .
     4643         end.
     4644         if not p-append then
     4645         do:
     4646           output to value( v-report-name )
     4647             page-size value(p-page-size) .
     4648         end.
     4649       end.
     4650     end.
     4651   end procedure.
     4652   procedure prn-lib-open-exp :
     4653     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     4654     define input parameter p-is-stream    as logical no-undo .
     4655     define input parameter p-is-append    as logical no-undo .
     4656     define output parameter p-ReportFileName as char init "report" no-undo.
     4657     define output parameter p-process as logical no-undo .
     4658     define variable glog as logical no-undo .
     4659     do
     4660       on error undo, return error
     4661       :
     4662       SYSTEM-DIALOG GET-FILE p-ReportFileName
     4663         TITLE      "Укажите путь"
     4664         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     4665         ASK-OVERWRITE
     4666         CREATE-TEST-FILE
     4667         SAVE-AS
     4668         USE-FILENAME
     4669         DEFAULT-EXTENSION "txt"
     4670         UPDATE glog
     4671         .
     4672       if not glog then  return.
     4673       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     4674       if p-is-stream then
     4675       do:
     4676         if p-is-append then
     4677         do:
     4678           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     4679         end.
     4680         else
     4681         do:
     4682           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     4683         end.
     4684       end.
     4685       else
     4686       do:
     4687         if p-is-append then
     4688         do:
     4689           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     4690         end.
     4691         else
     4692         do:
     4693           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     4694         end.
     4695       end.
     4696       p-process = yes.
     4697     end.
     4698   end procedure.
     4699   procedure prn-lib-get-report-name :
     4700     define input parameter parParentProc  as widget-handle no-undo.
     4701     define output parameter p-report-name as character no-undo .
     4702     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     4703   end procedure.
     4704   procedure prn-lib-reportviewer-report-name :
     4705     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     4706     define input parameter p-report-name-html as character no-undo .
     4707     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
     4708   end procedure.
     4709   procedure prn-lib-reportviewer :
     4710     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     4711     define input parameter p-report-name-html as character no-undo .
     4712     define input parameter p-param        as character no-undo .
     4713     define variable v-excel           as character no-undo init 'TRUE' .
     4714     define variable v-value-character as character no-undo .
     4715     define variable v-value-integer   as character no-undo .
     4716     define variable v-value-date      as date      no-undo .
     4717     define variable v-value-decimal   as decimal   no-undo .
     4718     define variable rep-excel         as logical   no-undo .
     4719     define variable excel-string      as character no-undo .
     4720     define variable v-param-type      as character no-undo .
     4721     define variable v-tth             as handle    no-undo .
     4722     run adm/shattri.p (
     4723       input "get":U
     4724       ,input  ""
     4725       ,input  0
     4726       ,input  'report-glob':U
     4727       ,input  'rep-excel':U
     4728       ,output v-value-character
     4729       ,output v-value-date
     4730       ,output v-value-decimal
     4731       ,output v-value-integer
     4732       ,output rep-excel
     4733       ,output v-param-type
     4734       ,INPUT-OUTPUT table-handle v-tth
     4735       )  .
     4736     if rep-excel then v-excel = "TRUE" .
     4737     else v-excel = "FALSE" .
     4738     if p-param eq ""
     4739     then
     4740        p-param = "EXCEL:" + v-excel.
     4741     else
     4742        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     4743     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     4744   end procedure.
     4745   function fnc-convert-dot-to-colon returns character
     4746       (input p-data as decimal, input p-accur as character, input p-num as integer) forward.
     4747   function fnc-convert-dot-to-colon returns character
     4748   (input p-data as decimal, input p-accur as character, input p-num as integer):
     4749       define variable result as character no-undo.
     4750       define variable v-str-result as character no-undo.
     4751       if p-data = ? then p-data = 0 .
     4752       p-data = round(p-data, p-num).
     4753       v-str-result = trim(replace(string(p-data, p-accur), ".", ",")).
     4754       return v-str-result.
     4755   END FUNCTION.
     4756       define variable g#report-num as integer no-undo.
     4757       define variable g#log        as logical no-undo.
     4758   def var vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4759   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     4760   procedure paramls-clear :
     4761     define buffer buf_temp-param for temp-param .
     4762     do
     4763     on error undo, return error return-value
     4764     :
     4765       for each buf_temp-param
     4766       on error undo, return error
     4767       :
     4768         delete buf_temp-param .
     4769       end.
     4770     end.
     4771   end procedure.
     4772   procedure paramls-write :
     4773     define input  parameter p-code     as character no-undo .
     4774     define input  parameter p-sub-code as character no-undo .
     4775     define input  parameter p-value    as character no-undo .
     4776     define buffer buf_temp-param for temp-param .
     4777     do
     4778     on error undo, return error return-value
     4779     :
     4780       find first buf_temp-param
     4781         where buf_temp-param.param-code     = p-code
     4782           and buf_temp-param.param-sub-code = p-sub-code
     4783         no-error .
     4784       if not available buf_temp-param then do:
     4785         create buf_temp-param .
     4786         assign
     4787           buf_temp-param.param-code     = p-code
     4788           buf_temp-param.param-sub-code = p-sub-code
     4789         .
     4790       end.
     4791       assign
     4792         buf_temp-param.param-value = p-value
     4793       .
     4794     end.
     4795   end procedure.
     4796   procedure paramls-read :
     4797     define input  parameter p-code          as character no-undo .
     4798     define input  parameter p-sub-code      as character no-undo .
     4799     define input  parameter p-default-value as character no-undo .
     4800     define output parameter p-value         as character no-undo .
     4801     define buffer buf_temp-param for temp-param .
     4802     do
     4803     on error undo, return error return-value
     4804     :
     4805       find first buf_temp-param
     4806         where buf_temp-param.param-code     = p-code
     4807           and buf_temp-param.param-sub-code = p-sub-code
     4808         no-error .
     4809       if available buf_temp-param then do:
     4810         assign
     4811           p-value = buf_temp-param.param-value
     4812         .
     4813       end.
     4814       else do:
     4815         assign
     4816           p-value = p-default-value
     4817         .
     4818       end.
     4819     end.
     4820   end procedure.
     4821   procedure paramls-append :
     4822     define input  parameter p-code     as character no-undo .
     4823     define input  parameter p-sub-code as character no-undo .
     4824     define input  parameter p-value    as character no-undo .
     4825     define buffer buf_temp-param for temp-param .
     4826     do
     4827     on error undo, return error return-value
     4828     :
     4829       find first buf_temp-param
     4830            where buf_temp-param.param-code     = p-code
     4831              and buf_temp-param.param-sub-code = p-sub-code
     4832         no-error .
     4833       if not available buf_temp-param then do:
     4834         create buf_temp-param .
     4835         assign
     4836           buf_temp-param.param-code     = p-code
     4837           buf_temp-param.param-sub-code = p-sub-code
     4838           buf_temp-param.param-value    = p-value
     4839         .
     4840       end.
     4841       else do:
     4842           assign
     4843               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     4844           .
     4845       end.
     4846     end.
     4847   end procedure.
