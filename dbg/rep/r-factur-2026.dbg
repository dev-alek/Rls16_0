      956   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      957   procedure wthcattr-sprcli :
      958   define input parameter parparentproc  as widget-handle no-undo.
      959   define input parameter p-mode  as character no-undo.
      960   define input-output parameter p-value as character no-undo .
      961   define output parameter p-setted as logical no-undo .
      962     DEFINE VARIABLE v-value as character no-undo .
      963     define variable v-cli-type as character no-undo .
      964     define variable v-cli-code as integer no-undo .
      965     define buffer buf_clients   for ub.clients.
      966     define variable v_rid as character no-undo.
      967     define variable ref-rec as recid no-undo .
      968     do
      969     on error undo, return error
      970     :
      971         v-value = p-value.
      972      if p-value <> '':U then do:
      973       assign
      974       v-cli-type = substring(p-value, 1, 3)
      975       v-cli-code = integer(substring(p-value, 4))
      976       no-error.
      977       if error-status:error then do:
      978         assign
      979         v-cli-type = '':U
      980         v-cli-code = 0
      981         .
      982       end.
      983      end.
      984      FIND FIRST buf_clients NO-LOCK WHERE
      985               buf_clients.obj-type = v-cli-type AND
      986               buf_clients.obj-code = v-cli-code  NO-ERROR.
      987      IF available(buf_clients) then do:
      988       run ref/cli-all.w (
      989                   input parparentproc
      990                  ,input if p-mode = 'ИЗМЕНЕНИЕ':U then "b-sel":U else "":U
      991                  ,input v-cli-type
      992                  ,input 'все':U
      993                  ,input 'все':U
      994                  ,input RECID( buf_clients )
      995                  ,input ",,,,,,NO"
      996                  ,input ?
      997                  ,OUTPUT v_rid ).
      998     END.
      999     ELSE if p-mode = 'ИЗМЕНЕНИЕ':U then DO:
     1000       run ref/cli-all.w (
     1001                    input parparentproc
     1002                   ,INPUT "b-sel":U
     1003                  ,input  v-cli-type
     1004                  ,input 'все':U
     1005                  ,input 'текущие':U
     1006                  ,input ?
     1007                  ,input ",,,,,,NO"
     1008                  ,input ?
     1009                  ,OUTPUT v_rid ).
     1010     END.
     1011     else do:
     1012       message
     1013       if p-value = "":U then 'Атрибут не задан!'
     1014       else substitute('Не найден клиент &1',p-value)
     1015       view-as alert-box warning.
     1016     end.
     1017     IF v_rid <> ? AND v_rid <> "":U THEN DO:
     1018       ASSIGN ref-rec = INT( v_rid ) NO-ERROR.
     1019       IF ERROR-STATUS:ERROR THEN DO:
     1020           RETURN NO-APPLY.
     1021       END.
     1022       FIND FIRST buf_clients NO-LOCK WHERE
     1023                  RECID( buf_clients ) = ref-rec NO-ERROR.
     1024       IF AVAIL buf_clients THEN DO:
     1025         v-value = buf_clients.obj-type + string(buf_clients.obj-code, ">>>>>>>>9").
     1026       end.
     1027     end.
     1028     if v-value <> p-value then do:
     1029       p-value = v-value.
     1030       p-setted = yes.
     1031     end.
     1032     end.
     1033   end procedure.
     1034     define new global shared variable g#wthcalib as handle no-undo.
     1035   procedure torgconf-read :
     1036   do
     1037   on error undo, return error
     1038   :
     1039       define input parameter p-form-name  as character    no-undo.
     1040       define input parameter p-host-code  as integer      no-undo.
     1041       define input parameter p-obj-type   as character    no-undo.
     1042       define input parameter p-obj-code   as integer      no-undo.
     1043       define variable v-outdate   as character     no-undo.
     1044       define variable v-outares   as character     no-undo.
     1045       define variable v-outsend   as character     no-undo.
     1046       define variable v-outasend  as character     no-undo.
     1047       define variable v-outprops  as character     no-undo.
     1048       define variable v-outnum    as character     no-undo.
     1049       define variable v-outprim   as character     no-undo.
     1050       define variable v-outdisc   as character     no-undo.
     1051       define variable v-outsubs   as character     no-undo.
     1052       define variable v-outrecv   as character     no-undo.
     1053       define variable v-outegrp   as character     no-undo.
     1054       define variable v-outt12    as character     no-undo.
     1055       define variable v-outappr   as character     no-undo.
     1056       define variable v-outrubl   as character     no-undo.
     1057       define variable v-outhold   as character     no-undo.
     1058       define variable v-outobj    as character     no-undo.
     1059       define variable v-outexlst  as character     no-undo.
     1060       define variable v-outprncd  as character     no-undo.
     1061       define variable v-par-type  as character     no-undo.
     1062       define variable v-outogr    as character     no-undo.
     1063       define variable v-outR      as character     no-undo.
     1064       define variable v-outB      as character     no-undo.
     1065       define variable v-outC      as character     no-undo.
     1066       assign
     1067           v-torgconf-outdate  = no
     1068           v-torgconf-outnum   = no
     1069           v-torgconf-outprim  = no
     1070           v-torgconf-outdisc  = no
     1071           v-torgconf-outsubs  = no
     1072           v-torgconf-outrecv  = no
     1073           v-torgconf-outegrp  = no
     1074           v-torgconf-outt12   = no
     1075           v-torgconf-outappr  = no
     1076           v-torgconf-outrubl  = no
     1077           v-torgconf-outhold  = no
     1078           v-torgconf-outobj   = no
     1079           v-torgconf-outexlst = no
     1080           v-torgconf-outexpas = "":U
     1081           v-torgconf-outprncd = yes
     1082           v-torgconf-outares  = no
     1083           v-torgconf-outsend  = no
     1084           v-torgconf-outasend  = no
     1085           v-torgconf-outprops  = no
     1086           v-form-name          = p-form-name
     1087       .
     1088   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1089   empty temp-table thbjattr_thbj-attr.
     1090   run adm/shattri.p (
     1091      input "get":U
     1092     ,input ''
     1093     ,input 0
     1094     ,input 'prt-glob':U
     1095     ,input  ""
     1096     ,output v-value-character
     1097     ,output v-value-date
     1098     ,output v-value-decimal
     1099     ,output v-value-integer
     1100     ,output v-value-logical
     1101     ,output par-type
     1102     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1103     ) no-error .
     1104   for each thbjattr_thbj-attr :
     1105       if thbjattr_thbj-attr.prop-code = 'outprncd':U then v-outprncd =  string(thbjattr_thbj-attr.property-value-logical) .
     1106       if thbjattr_thbj-attr.prop-code = 'outrecv':U  then v-outrecv  =  thbjattr_thbj-attr.property-value-character .
     1107       if thbjattr_thbj-attr.prop-code = 'outprops':U then v-outprops =  thbjattr_thbj-attr.property-value-character .
     1108   end.
     1109   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1110   empty temp-table thbjattr_thbj-attr.
     1111   run adm/shattri.p (
     1112      input "get":U
     1113     ,input p-obj-type
     1114     ,input p-obj-code
     1115     ,input 'prt-obj':U
     1116     ,input  ""
     1117     ,output v-value-character
     1118     ,output v-value-date
     1119     ,output v-value-decimal
     1120     ,output v-value-integer
     1121     ,output v-value-logical
     1122     ,output par-type
     1123     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1124     ) no-error .
     1125   for each thbjattr_thbj-attr :
     1126       if thbjattr_thbj-attr.prop-code = 'outdate':U  then v-outdate  =  thbjattr_thbj-attr.property-value-character .
     1127       if thbjattr_thbj-attr.prop-code = 'outares':U  then v-outares  =  thbjattr_thbj-attr.property-value-character .
     1128       if thbjattr_thbj-attr.prop-code = 'outnum':U   then v-outnum   =  thbjattr_thbj-attr.property-value-character .
     1129       if thbjattr_thbj-attr.prop-code = 'outprim':U  then v-outprim  =  thbjattr_thbj-attr.property-value-character .
     1130       if thbjattr_thbj-attr.prop-code = 'outdisc':U  then v-outdisc  =  thbjattr_thbj-attr.property-value-character .
     1131       if thbjattr_thbj-attr.prop-code = 'outsubs':U  then v-outsubs  =  thbjattr_thbj-attr.property-value-character .
     1132       if thbjattr_thbj-attr.prop-code = 'outegrp':U  then v-outegrp  =  thbjattr_thbj-attr.property-value-character .
     1133       if thbjattr_thbj-attr.prop-code = 'outt12':U   then v-outt12   =  thbjattr_thbj-attr.property-value-character .
     1134       if thbjattr_thbj-attr.prop-code = 'outappr':U  then v-outappr  =  thbjattr_thbj-attr.property-value-character .
     1135       if thbjattr_thbj-attr.prop-code = 'outrubl':U  then v-outrubl  =  thbjattr_thbj-attr.property-value-character .
     1136       if thbjattr_thbj-attr.prop-code = 'outhold':U  then v-outhold  =  thbjattr_thbj-attr.property-value-character .
     1137       if thbjattr_thbj-attr.prop-code = 'outobj':U   then v-outobj   =  thbjattr_thbj-attr.property-value-character .
     1138       if thbjattr_thbj-attr.prop-code = 'outsend':U  then v-outsend  =  thbjattr_thbj-attr.property-value-character .
     1139       if thbjattr_thbj-attr.prop-code = 'outasend':U then v-outasend =  thbjattr_thbj-attr.property-value-character .
     1140       if thbjattr_thbj-attr.prop-code = 'outogr':U   then v-torgconf-outogr   =  thbjattr_thbj-attr.property-value-character .
     1141       if thbjattr_thbj-attr.prop-code = 'outR':U     then v-torgconf-outR     =  thbjattr_thbj-attr.property-value-character .
     1142       if thbjattr_thbj-attr.prop-code = 'outB':U     then v-torgconf-outB     =  thbjattr_thbj-attr.property-value-character .
     1143       if thbjattr_thbj-attr.prop-code = 'outssdoc':U then v-torgconf-outssdoc =  thbjattr_thbj-attr.property-value-character .
     1144       if thbjattr_thbj-attr.prop-code = 'outC':U     then v-torgconf-outC     =  thbjattr_thbj-attr.property-value-character .
     1145   end.
     1146       run gbl/conf-rd.p ("outexpas", "":U, "":U, 0, "":U, "":U, "":U, no, output v-torgconf-outexpas, output v-par-type) no-error.
     1147       if error-status :error
     1148       then do:
     1149           assign
     1150               v-torgconf-outexpas = "":U
     1151           .
     1152       end.
     1153       assign
     1154           v-torgconf-outprncd = ( v-outprncd = "yes":U )
     1155       .
     1156       if p-form-name <> ""
     1157       and p-form-name <> ?
     1158       then do:
     1159           run gbl/conf-rd.p ("outexlst" , p-host-code, p-obj-type, p-obj-code, "", "", "", no, output v-outexlst , output v-par-type) no-error.
     1160           if error-status :error
     1161           then do:
     1162               assign
     1163                   v-outexlst           = ""
     1164               .
     1165           end.
     1166           if lookup( p-form-name, v-outdate ) <> 0
     1167           then do:
     1168               assign
     1169                   v-torgconf-outdate  = yes
     1170               .
     1171           end.
     1172           if lookup( p-form-name, v-outares ) <> 0
     1173           then do:
     1174               assign
     1175                   v-torgconf-outares  = yes
     1176               .
     1177           end.
     1178           if lookup( p-form-name, v-outnum  ) <> 0
     1179           then do:
     1180               assign
     1181                   v-torgconf-outnum   = yes
     1182               .
     1183           end.
     1184           if lookup( p-form-name, v-outprim ) <> 0
     1185           then do:
     1186               assign
     1187                   v-torgconf-outprim  = yes
     1188               .
     1189           end.
     1190           if lookup( p-form-name, v-outdisc ) <> 0
     1191           then do:
     1192               assign
     1193                   v-torgconf-outdisc  = yes
     1194               .
     1195           end.
     1196           if lookup( p-form-name, v-outsubs ) <> 0
     1197           then do:
     1198               assign
     1199                   v-torgconf-outsubs  = yes
     1200               .
     1201           end.
     1202           if lookup( p-form-name, v-outrecv ) <> 0
     1203           then do:
     1204               assign
     1205                   v-torgconf-outrecv  = yes
     1206               .
     1207           end.
     1208           if lookup( p-form-name, v-outegrp ) <> 0
     1209           then do:
     1210               assign
     1211                   v-torgconf-outegrp  = yes
     1212               .
     1213           end.
     1214           if lookup( p-form-name, v-outt12  ) <> 0
     1215           then do:
     1216               assign
     1217                   v-torgconf-outt12   = yes
     1218               .
     1219           end.
     1220           if lookup( p-form-name, v-outappr  ) <> 0
     1221           then do:
     1222               assign
     1223                   v-torgconf-outappr   = yes
     1224               .
     1225           end.
     1226           if lookup( p-form-name, v-outrubl  ) <> 0
     1227           then do:
     1228               assign
     1229                   v-torgconf-outrubl   = yes
     1230               .
     1231           end.
     1232           if lookup( p-form-name, v-outhold  ) <> 0
     1233           then do:
     1234               assign
     1235                   v-torgconf-outhold   = yes
     1236               .
     1237           end.
     1238           if lookup( p-form-name, v-outobj   ) <> 0
     1239           then do:
     1240               assign
     1241                   v-torgconf-outobj    = yes
     1242               .
     1243           end.
     1244           if lookup( p-form-name, v-outsend   ) <> 0
     1245           then do:
     1246               assign
     1247                   v-torgconf-outsend    = yes
     1248               .
     1249           end.
     1250           if lookup( p-form-name, v-outasend   ) <> 0
     1251           then do:
     1252               assign
     1253                   v-torgconf-outasend    = yes
     1254               .
     1255           end.
     1256           if lookup( p-form-name, v-outprops   ) <> 0
     1257           then do:
     1258               assign
     1259                   v-torgconf-outprops    = yes
     1260               .
     1261           end.
     1262           if lookup( p-form-name, v-outexlst ) <> 0
     1263           then do:
     1264               assign
     1265                   v-torgconf-outexlst  = yes
     1266               .
     1267           end.
     1268        assign
     1269         v-name = p-form-name.
     1270   end.
     1271   end.
     1272   end procedure.
     1273   procedure torgconf-get-self-param :
     1274   define input parameter p-obj-type           as character        no-undo.
     1275   define input parameter p-obj-code           as integer          no-undo.
     1276   define input parameter p-curr-code          as integer          no-undo.
     1277       define variable v-host-code    as integer      no-undo.
     1278       define variable v-par-type     as character    no-undo.
     1279   do
     1280   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message(1))
     1281   :
     1282   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1283   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1284     (input  p-obj-type
     1285     ,input  p-obj-code
     1286     ,output v-host-code
     1287     )  .
     1288       if v-torgconf-outhold = yes
     1289       then do:
     1290           run torgconf-get-holdfirm-code in this-procedure (
     1291                 input p-obj-type
     1292               , input p-obj-code
     1293               , output v-torgconf-self-host-code
     1294           ).
     1295           if v-torgconf-self-host-code = 0
     1296           then do:
     1297               return error.
     1298           end.
     1299       end.
     1300       else do:
     1301           assign
     1302               v-torgconf-self-host-code = v-host-code
     1303           .
     1304       end.
     1305       if v-torgconf-self-host-code = 0
     1306       then do:
     1307           assign
     1308               v-torgconf-self-host-name           = "":U
     1309               v-torgconf-self-host-addres         = "":U
     1310               v-torgconf-self-host-post-addres    = "":U
     1311               v-torgconf-self-host-phone          = "":U
     1312               v-torgconf-self-host-inn            = "":U
     1313               v-torgconf-self-host-kpp            = "":U
     1314               v-torgconf-self-host-okpo           = "":U
     1315               v-torgconf-self-host-egrip-date     = "":U
     1316               v-torgconf-self-host-egrip-num      = "":U
     1317           .
     1318       end.
     1319       else do:
     1320           run fmtcli-get-client in this-procedure (
     1321                 input 'орг':U
     1322               , input v-torgconf-self-host-code
     1323           ).
     1324           assign
     1325               v-torgconf-self-host-name        = v-fmtcli-name
     1326               v-torgconf-self-host-engl-name   = v-fmtcli-engl-name
     1327               v-torgconf-self-host-addres      = v-fmtcli-full-addres
     1328               v-torgconf-self-host-post-addres = v-fmtcli-post-addres
     1329               v-torgconf-self-host-phone       = v-fmtcli-phone
     1330               v-torgconf-self-host-inn         = v-fmtcli-inn
     1331               v-torgconf-self-host-kpp         = v-fmtcli-kpp
     1332               v-torgconf-self-host-okpo        = v-fmtcli-okpo
     1333           .
     1334           run gbl/clntat-v.p (
     1335                 input 'орг':U
     1336               , input v-torgconf-self-host-code
     1337               , input 'egrip-date':U
     1338               , output v-torgconf-self-host-egrip-date
     1339               , output v-par-type
     1340           ).
     1341           run gbl/clntat-v.p (
     1342                 input 'орг':U
     1343               , input v-torgconf-self-host-code
     1344               , input 'egrip-num':U
     1345               , output v-torgconf-self-host-egrip-num
     1346               , output v-par-type
     1347           ).
     1348           run fmtcli-get-bank in this-procedure (
     1349                 input v-host-code
     1350               , input 'орг':U
     1351               , input v-torgconf-self-host-code
     1352               , input p-curr-code
     1353           ).
     1354       end.
     1355       assign
     1356           v-torgconf-self-schet-exists = v-fmtcli-schet-exists
     1357           v-torgconf-self-bank-exists  = v-fmtcli-bank-exists
     1358           v-torgconf-self-bank-r-schet = v-fmtcli-bank-r-schet
     1359           v-torgconf-self-bank-c-schet = v-fmtcli-bank-c-schet
     1360           v-torgconf-self-bank-bik     = v-fmtcli-bank-bik
     1361           v-torgconf-self-bank-name    = v-fmtcli-bank-name
     1362           v-torgconf-self-bank-addres  = v-fmtcli-bank-addres
     1363           v-torgconf-self-bank-city    = v-fmtcli-bank-city
     1364       .
     1365       assign
     1366           v-torgconf-self-obj-type = p-obj-type
     1367           v-torgconf-self-obj-code = p-obj-code
     1368       .
     1369       run fmtcli-get-client in this-procedure (
     1370             input p-obj-type
     1371           , input p-obj-code
     1372       ).
     1373       assign
     1374           v-torgconf-self-obj-name       = v-fmtcli-name
     1375           v-torgconf-self-obj-engl-name  = v-fmtcli-engl-name
     1376           v-torgconf-self-obj-addres     = v-fmtcli-full-addres
     1377           v-torgconf-temp-post-addres    = v-fmtcli-post-addres
     1378           v-torgconf-self-obj-phone      = v-fmtcli-phone
     1379           v-torgconf-self-obj-inn        = v-fmtcli-inn
     1380           v-torgconf-self-obj-okpo       = v-fmtcli-okpo
     1381       .
     1382   end.
     1383   end procedure.
     1384   procedure torgconf-get-recepient-param :
     1385   define input parameter torgconfdoc-code   as character                  no-undo.
     1386   define output parameter v-code-rec        as integer                    no-undo .
     1387   define output parameter v-type-rec        as character                  no-undo initial 'C':U.
     1388   define output parameter v-codefirm-rec    as integer                    no-undo .
     1389   define output parameter v-curcode-rec     as integer                    no-undo .
     1390        define variable  v-recipient-code  as character                  no-undo .
     1391        define variable  v-recipient       like ub.doc-attr.attr-value   no-undo.
     1392        define variable  v-trdcattr-type   as character                  no-undo initial 'C':U.
     1393   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input torgconfdoc-code ,
     1394                           input 'Recipient':U ,
     1395                          output v-recipient-code ,
     1396                          output v-trdcattr-type ) no-error .
     1397       if error-status :error then do:
     1398        message
     1399         vss-workfile vss-revision vss-description skip
     1400         "Ошибка при вызове процедуры tdat-val":U skip
     1401         "Документ: " torgconfdoc-code skip
     1402         "Атрибут: " 'Recipient':U skip
     1403         "Значение: " v-recipient skip
     1404         trim( error-status :get-message (1) ) skip
     1405         return-value skip
     1406         view-as alert-box error.
     1407       undo, return error return-value.
     1408       end.
     1409     assign
     1410       v-recipient  = v-recipient-code
     1411       v-type-rec = substring(v-recipient-code,1,3)
     1412       v-code-rec  = int(substring(v-recipient-code,4,15))
     1413       no-error
     1414     .
     1415     if v-type-rec = ? then v-type-rec = "" .
     1416     if v-code-rec  = ? then v-code-rec  =  0 .
     1417     end procedure.
