     4311   procedure thbjattr_code_reg :
     4312   define input  parameter p-upper-code     as character no-undo .
     4313   define input  parameter p-code           as character no-undo .
     4314   define output parameter p-label          as character no-undo .
     4315   define output parameter p-user-can-edit  as logical   no-undo .
     4316   define output parameter p-output-display as logical   no-undo .
     4317   define output parameter p-other          as character no-undo .
