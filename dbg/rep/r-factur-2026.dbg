     3614               ) .
     3615            end.
     3616            find first buf_person no-lock
     3617            where buf_person.psn-code = buf_trn-doc.boss
     3618            no-error.
     3619            if available buf_person
     3620            then do:
     3621               v-torgconf-ogr-post = buf_person.position.
     3622            end.
     3623            if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     3624            if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     3625         end.
     3626      end.
     3627      else do:
     3628      find first buf_wth-doc no-lock
     3629         where buf_wth-doc.doc-code = p-doc-code
     3630         no-error.
