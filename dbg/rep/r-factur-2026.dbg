       61       define variable vss-archive     as character no-undo initial "$Archive$":U .
       62       define variable vss-description as character no-undo initial "Печать счета-фактуры.":U .
       63   procedure vss-get-info :
       64     define output parameter p-vss-revision    like vss-revision    no-undo .
       65     define output parameter p-vss-author      like vss-author      no-undo .
       66     define output parameter p-vss-date        like vss-date        no-undo .
       67     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       68     define output parameter p-vss-archive     like vss-archive     no-undo .
       69     define output parameter p-vss-description like vss-description no-undo .
       70     assign
       71       p-vss-revision    = vss-revision
       72       p-vss-author      = vss-author
       73       p-vss-date        = vss-date
       74       p-vss-workfile    = vss-workfile
       75       p-vss-archive     = vss-archive
       76       p-vss-description = vss-description
       77     .
       78   end procedure.
