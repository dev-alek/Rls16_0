     1601         message
     1602            vss-workfile vss-revision vss-description skip
     1603            "Ошибка при вызове процедуры tdat-val":U skip
     1604            "Документ: " p-torgconfdoc-code skip
     1605            "Атрибут: " 't_accept-fname':U skip
     1606            "Значение: " p-torgconf-accept-fname skip
     1607            trim( error-status :get-message (1) ) skip
     1608            return-value skip
     1609            view-as alert-box error.
     1610         undo, return error return-value.
     1611         end.
     1612     end procedure.
     1613   procedure torgconf-get-sup-param :
     1614   define input parameter p-obj-type           as character        no-undo.
     1615   define input parameter p-obj-code           as integer          no-undo.
     1616   define input parameter p-curr-code          as integer          no-undo.
     1617       define variable v-host-code    as integer      no-undo.
     1618       define variable v-par-type     as character    no-undo.
     1619   do
     1620   on error undo, return error
     1621   :
     1622       assign
     1623          v-torgconf-sup-host-code = v-host-code
     1624       .
     1625       if v-torgconf-sup-host-code = 0
     1626       then do:
     1627           assign
     1628               v-torgconf-sup-host-name           = "":U
     1629               v-torgconf-sup-host-addres         = "":U
     1630               v-torgconf-sup-host-post-addres    = "":U
     1631               v-torgconf-sup-host-phone          = "":U
     1632               v-torgconf-sup-host-inn            = "":U
     1633               v-torgconf-sup-host-kpp            = "":U
     1634               v-torgconf-sup-host-okpo           = "":U
     1635               v-torgconf-sup-host-egrip-date     = "":U
     1636               v-torgconf-sup-host-egrip-num      = "":U
     1637           .
     1638       end.
     1639       else do:
     1640           run fmtcli-get-client in this-procedure (
     1641                 input 'орг':U
     1642               , input v-torgconf-sup-host-code
     1643           ).
     1644           assign
     1645               v-torgconf-sup-host-name        = v-fmtcli-name
     1646               v-torgconf-sup-host-engl-name   = v-fmtcli-engl-name
     1647               v-torgconf-sup-host-addres      = v-fmtcli-full-addres
     1648               v-torgconf-sup-host-post-addres = v-fmtcli-post-addres
     1649               v-torgconf-sup-host-phone       = v-fmtcli-phone
     1650               v-torgconf-sup-host-inn         = v-fmtcli-inn
     1651               v-torgconf-sup-host-kpp         = v-fmtcli-kpp
     1652               v-torgconf-sup-host-okpo        = v-fmtcli-okpo
     1653           .
     1654           run gbl/clntat-v.p (
     1655                 input 'орг':U
     1656               , input v-torgconf-sup-host-code
     1657               , input 'egrip-date':U
     1658               , output v-torgconf-sup-host-egrip-date
     1659               , output v-par-type
     1660           ).
     1661           run gbl/clntat-v.p (
     1662                 input 'орг':U
     1663               , input v-torgconf-sup-host-code
     1664               , input 'egrip-num':U
     1665               , output v-torgconf-sup-host-egrip-num
     1666               , output v-par-type
     1667           ).
     1668           run fmtcli-get-bank in this-procedure (
     1669                 input v-host-code
     1670               , input 'орг':U
     1671               , input v-torgconf-sup-host-code
     1672               , input p-curr-code
     1673           ).
     1674       end.
     1675       assign
     1676           v-torgconf-sup-schet-exists = v-fmtcli-schet-exists
     1677           v-torgconf-sup-bank-exists  = v-fmtcli-bank-exists
     1678           v-torgconf-sup-bank-r-schet = v-fmtcli-bank-r-schet
     1679           v-torgconf-sup-bank-c-schet = v-fmtcli-bank-c-schet
     1680           v-torgconf-sup-bank-bik     = v-fmtcli-bank-bik
     1681           v-torgconf-sup-bank-name    = v-fmtcli-bank-name
     1682           v-torgconf-sup-bank-addres  = v-fmtcli-bank-addres
     1683           v-torgconf-sup-bank-city    = v-fmtcli-bank-city
     1684       .
     1685       assign
     1686           v-torgconf-sup-obj-type = p-obj-type
     1687           v-torgconf-sup-obj-code = p-obj-code
     1688       .
     1689       if trim(p-obj-type) <> ""
     1690       and p-obj-code <> 0
     1691       then do:
     1692       run fmtcli-get-client in this-procedure (
     1693             input p-obj-type
     1694           , input p-obj-code
     1695       ).
     1696       assign
     1697           v-torgconf-sup-obj-name        = v-fmtcli-name
     1698           v-torgconf-sup-obj-engl-name   = v-fmtcli-engl-name
     1699           v-torgconf-sup-obj-addres      = v-fmtcli-full-addres
     1700           v-torgconf-temp-post-addres    = v-fmtcli-post-addres
     1701           v-torgconf-sup-obj-phone       = v-fmtcli-phone
     1702           v-torgconf-sup-obj-inn         = v-fmtcli-inn
     1703           v-torgconf-sup-obj-okpo        = v-fmtcli-okpo
     1704       .
     1705      end.
     1706      end.
     1707   end procedure.
     1708   procedure torgconf-get-cli-param :
     1709   define input parameter p-host-obj-code      as integer          no-undo.
     1710   define input parameter p-obj-type           as character        no-undo.
     1711   define input parameter p-obj-code           as integer          no-undo.
     1712   define input parameter p-curr-code          as integer          no-undo.
     1713       define variable v-host-code    as integer      no-undo.
     1714   do
     1715   on error undo, return error
     1716   :
     1717       assign
     1718           v-torgconf-cli-type = p-obj-type
     1719           v-torgconf-cli-code = p-obj-code
     1720       .
     1721       run fmtcli-get-client in this-procedure (
     1722             input p-obj-type
     1723           , input p-obj-code
     1724       ).
     1725       assign
     1726           v-torgconf-cli-name         = trim( v-fmtcli-name          )
     1727           v-torgconf-cli-engl-name    = trim( v-fmtcli-engl-name          )
     1728           v-torgconf-cli-addres       = trim( v-fmtcli-full-addres   )
     1729           v-torgconf-cli-post-addres  = trim( v-fmtcli-post-addres   )
     1730           v-torgconf-cli-phone        = trim( v-fmtcli-phone         )
     1731           v-torgconf-cli-inn          = trim( v-fmtcli-inn           )
     1732           v-torgconf-cli-kpp          = trim( v-fmtcli-kpp           )
     1733           v-torgconf-cli-okpo         = trim( v-fmtcli-okpo          )
     1734       .
     1735      run fmtcli-get-bank in this-procedure (
     1736             input p-host-obj-code
     1737           , input p-obj-type
     1738           , input p-obj-code
     1739           , input p-curr-code
     1740       ).
     1741       assign
     1742           v-torgconf-cli-schet-exists = v-fmtcli-schet-exists
     1743           v-torgconf-cli-bank-exists  = v-fmtcli-bank-exists
     1744           v-torgconf-cli-bank-r-schet = v-fmtcli-bank-r-schet
     1745           v-torgconf-cli-bank-c-schet = v-fmtcli-bank-c-schet
     1746           v-torgconf-cli-bank-bik     = v-fmtcli-bank-bik
     1747           v-torgconf-cli-bank-name    = v-fmtcli-bank-name
     1748           v-torgconf-cli-bank-addres  = v-fmtcli-bank-addres
     1749           v-torgconf-cli-bank-city    = v-fmtcli-bank-city
     1750       .
     1751   end.
     1752   end procedure.
     1753   procedure torgconf-get-ship-param :
     1754   define input parameter p-host-obj-code      as integer          no-undo.
     1755   define input parameter p-obj-type           as character        no-undo.
     1756   define input parameter p-obj-code           as integer          no-undo.
     1757   define input parameter p-curr-code          as integer          no-undo.
     1758       define variable v-host-code    as integer      no-undo.
     1759   do
     1760   on error undo, return error
     1761   :
     1762       assign
     1763           v-torgconf-ship-type = p-obj-type
     1764           v-torgconf-ship-code = p-obj-code
     1765       .
     1766       if trim(p-obj-type) = ""
     1767       and p-obj-code = 0
     1768       then do:
     1769       assign
     1770           v-torgconf-ship-name         = "":U
     1771           v-torgconf-ship-addres       = "":U
     1772           v-torgconf-ship-post-addres  = "":U
     1773           v-torgconf-ship-phone        = "":U
     1774           v-torgconf-ship-inn          = "":U
     1775           v-torgconf-ship-kpp          = "":U
     1776           v-torgconf-ship-okpo         = "":U
     1777       .
     1778       end.
     1779       else do:
     1780       run fmtcli-get-client in this-procedure (
     1781             input p-obj-type
     1782           , input p-obj-code
     1783       ).
     1784       assign
     1785           v-torgconf-ship-name         = trim( v-fmtcli-name          )
     1786           v-torgconf-ship-engl-name    = trim( v-fmtcli-engl-name          )
     1787           v-torgconf-ship-addres       = trim( v-fmtcli-full-addres   )
     1788           v-torgconf-ship-post-addres  = trim( v-fmtcli-post-addres   )
     1789           v-torgconf-ship-phone        = trim( v-fmtcli-phone         )
     1790           v-torgconf-ship-inn          = trim( v-fmtcli-inn           )
     1791           v-torgconf-ship-kpp          = trim( v-fmtcli-kpp           )
     1792           v-torgconf-ship-okpo         = trim( v-fmtcli-okpo          )
     1793       .
     1794       end.
     1795           run fmtcli-get-bank in this-procedure (
     1796             input p-host-obj-code
     1797           , input p-obj-type
     1798           , input p-obj-code
     1799           , input p-curr-code
     1800       ).
     1801       assign
     1802           v-torgconf-ship-schet-exists = v-fmtcli-schet-exists
     1803           v-torgconf-ship-bank-exists  = v-fmtcli-bank-exists
     1804           v-torgconf-ship-bank-r-schet = v-fmtcli-bank-r-schet
     1805           v-torgconf-ship-bank-c-schet = v-fmtcli-bank-c-schet
     1806           v-torgconf-ship-bank-bik     = v-fmtcli-bank-bik
     1807           v-torgconf-ship-bank-name    = v-fmtcli-bank-name
     1808           v-torgconf-ship-bank-addres  = v-fmtcli-bank-addres
     1809           v-torgconf-ship-bank-city    = v-fmtcli-bank-city
     1810       .
     1811   end.
     1812   end procedure.
     1813   procedure torgconf-get-holdfirm-code :
     1814   define input parameter p-obj-type   as character        no-undo.
     1815   define input parameter p-obj-code   as integer          no-undo.
     1816   define output parameter p-firm-code as integer          no-undo.
     1817       define variable v-firm-code-str     as character    no-undo.
     1818       define variable v-par-type          as character    no-undo.
     1819       define buffer buf_clients       for ub.clients.
     1820   do
     1821   for buf_clients
     1822   on error undo, return error
     1823   :
     1824       run gbl/clntat-v.p (
     1825             input p-obj-type
     1826           , input p-obj-code
     1827           , input 'holdfirm-code':U
     1828           , output v-firm-code-str
     1829           , output v-par-type
     1830       ).
     1831       assign
     1832           p-firm-code = integer( v-firm-code-str )
     1833       no-error.
     1834       if error-status :error
     1835       then do:
     1836           message
     1837               "Неверно задан код фирмы для печати накладных."
     1838           view-as alert-box warning.
     1839           assign
     1840               p-firm-code = 0
     1841           .
     1842       end.
     1843       else do:
     1844           find first buf_clients no-lock
     1845                where buf_clients.obj-type = 'орг':U
     1846                  and buf_clients.obj-code = p-firm-code
     1847           no-error.
     1848           if not available buf_clients
     1849           then do:
     1850               message
     1851                   "Включен параметр 'Список печатных форм, для которых должна быть задана фирма для печати накладных' (outhold)" skip
     1852                   "Не найдена фирма по заданному коду фирмы для печати накладных."
     1853               view-as alert-box warning.
     1854               assign
     1855                   p-firm-code = 0
     1856               .
     1857           end.
     1858       end.
     1859   end.
     1860   end procedure.
     1861   procedure torgconf-get-post-head:
     1862   define input  parameter p-obj-type             as character        no-undo.
     1863   define input  parameter p-obj-code             as integer          no-undo.
     1864   define output parameter p-torgconf-post-head   as character        no-undo.
     1865      define variable v-host-code         as integer      no-undo.
     1866      define buffer buf_sysconf     for ub.sysconf.
     1867        assign
     1868         p-torgconf-post-head  = ""
     1869        .
     1870   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1871   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1872     (input  p-obj-type
     1873     ,input  p-obj-code
     1874     ,output v-host-code
     1875     )  .
     1876      find first buf_sysconf no-lock
     1877      where buf_sysconf.host-code = v-host-code
     1878      no-error.
     1879      if available buf_sysconf
     1880      then do:
     1881         assign
     1882            p-torgconf-post-head = buf_sysconf.head-position
     1883         .
     1884      end.
     1885   end procedure.
     1886   procedure torgconf-get-storekeeper:
     1887   define input  parameter p-wrkr                   as integer          no-undo.
     1888   define output parameter p-torgconf-wrkr-name     as character        no-undo.
     1889   define output parameter p-torgconf-post          as character        no-undo.
     1890      define buffer buf_sysconf     for ub.sysconf.
     1891      define buffer buf_person      for ub.person.
     1892      define buffer buf_shop        for ub.shop .
     1893      define buffer buf_store       for ub.store .
     1894      if v-torgconf-outC = "no_print"
     1895      then do:
     1896         assign p-torgconf-post = ""
     1897                p-torgconf-wrkr-name = ""
     1898                .
     1899      end.
     1900      if v-torgconf-outC = "clad_doc"
     1901      then do:
     1902         run rep/get-psn.p
     1903               (input  p-wrkr
     1904               ,output p-torgconf-wrkr-name
     1905               ) .
     1906         find first buf_person no-lock
     1907         where buf_person.psn-code = p-wrkr
     1908         no-error.
     1909         if available buf_person
     1910         then do:
     1911           p-torgconf-post = buf_person.position.
     1912         end.
     1913         if p-torgconf-post = "?":U then p-torgconf-post = "".
     1914         if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     1915      end.
     1916      if v-torgconf-outC = "clad_obj"
     1917      then do:
     1918         CASE v-torgconf-self-obj-type:
     1919         WHEN 'маг':U
     1920         THEN DO:
     1921            find first buf_shop no-lock
     1922            where buf_shop.obj-code = v-torgconf-self-obj-code
     1923            .
     1924            assign
     1925               p-torgconf-wrkr-name = buf_shop.store-man
     1926               p-torgconf-post = ""
     1927            .
     1928            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     1929         END.
     1930         WHEN 'скл':U
     1931         THEN DO:
     1932            find first buf_store no-lock
     1933            where buf_store.obj-code = v-torgconf-self-obj-code
     1934            .
     1935            assign
     1936               p-torgconf-wrkr-name = buf_store.store-man
     1937               p-torgconf-post = ""
     1938            .
     1939            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     1940         END.
     1941         OTHERWISE DO:
     1942            assign
     1943               p-torgconf-post = "":U
     1944               p-torgconf-wrkr-name = "":U
     1945            .
     1946         END.
     1947         END CASE.
     1948      end.
     1949    end procedure.
     1950   procedure torgconf-get-form-header :
     1951   define input parameter p-for-inverse    as logical          no-undo.
     1952   define input parameter p-doc-code       as character        no-undo.
     1953   define input parameter p-print-doc      as logical          no-undo.
     1954   define input parameter p-doc-date       as date             no-undo.
     1955   define input parameter p-fact-date      as date             no-undo.
     1956   define input parameter p-doc-type       as character        no-undo.
     1957   define input parameter p-status_        as character        no-undo.
     1958   define input parameter p-reverse        as logical          no-undo.
     1959   define input parameter p-sf-par         as logical          no-undo.
     1960       define variable v-attr-type         as character    no-undo.
     1961       define variable v-doc-code-standard as logical      no-undo.
     1962       define variable v-doc-date-standard as logical      no-undo.
     1963       define variable v-par-consignee-addres  as character    no-undo.
     1964       define variable v-host-code         as integer      no-undo.
     1965       define variable v-dcode-attr        as character    no-undo.
     1966       define variable v-ddate-attr        as character    no-undo.
     1967       define variable v-doc-date          as character    no-undo.
     1968       define variable v-doc-code          as character    no-undo.
     1969       define variable v-par-type          as character    no-undo.
     1970       define variable v-attr              as character    no-undo.
     1971       define buffer buf_firm          for ub.firm .
     1972       define buffer buf_clients       for ub.clients .
     1973       define buffer buf_sysconf       for ub.sysconf .
     1974       define buffer buf_shop          for ub.shop .
     1975       define buffer buf_store         for ub.store .
     1976       define buffer buf_person        for ub.person .
     1977       define buffer buf_trn-doc       for ub.trn-doc .
     1978       define buffer buf_wth-doc       for ub.wth-doc .
     1979       do
     1980   for buf_firm
     1981     , buf_clients
     1982     , buf_sysconf
     1983     , buf_shop
     1984     , buf_trn-doc
     1985     , buf_person
     1986     , buf_wth-doc
     1987   on error undo, return error
     1988   :
     1989       if p-doc-type = 'при':U
     1990       or p-doc-type = 'возврат':U
     1991       then do:
     1992           assign
     1993               v-torgconf-supplier         = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     1994                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     1995               v-torgconf-suppi            = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     1996                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     1997               v-torgconf-saler            = substitute( "&1&2&3&4&5", v-torgconf-self-host-name, ( if v-torgconf-self-host-addres = "":U then "":U else ", " ),
     1998                                             v-torgconf-self-host-addres, ( if v-torgconf-self-host-phone = "":U then "":U else ", " ),v-torgconf-self-host-phone )
     1999               v-torgconf-consignee        = substitute( "&1&2&3&4&5", v-torgconf-sup-host-name, ( if v-torgconf-sup-host-addres = "":U then "":U else ", " ),
     2000                                             v-torgconf-sup-host-addres, ( if v-torgconf-sup-host-phone = "":U then "":U else ", " ), v-torgconf-sup-host-phone  )
     2001               v-torgconf-supplier-okpo    = v-torgconf-cli-okpo
     2002               v-torgconf-saler-okpo       = v-torgconf-self-host-okpo
     2003               v-torgconf-consignee-okpo   = v-torgconf-sup-host-okpo
     2004               v-torgconf-supplier-code    = substitute( "&1", v-torgconf-cli-code         )
     2005               v-torgconf-supplier-type    = v-torgconf-cli-type
     2006               v-torgconf-saler-code       = substitute( "&1", v-torgconf-self-host-code   )
     2007               v-torgconf-saler-type       = v-torgconf-self-host-type
     2008               v-torgconf-consignee-code   = substitute( "&1", v-torgconf-sup-host-code   )
     2009               v-torgconf-consignee-type   = v-torgconf-sup-host-type
     2010               v-torgconf-supplier-name    = substitute( "&1", v-torgconf-cli-name         )
     2011               v-torgconf-saler-name       = substitute( "&1", v-torgconf-self-host-name   )
     2012               v-torgconf-consignee-name   = substitute( "&1", v-torgconf-sup-host-name   )
     2013               v-torgconf-supplier-addr    = substitute( "&1", v-torgconf-cli-addres       )
     2014               v-torgconf-saler-addr       = substitute( "&1", v-torgconf-self-host-addres )
     2015               v-torgconf-consignee-addr   = substitute( "&1", v-torgconf-sup-host-addres )
     2016               v-torgconf-supplier-inn     = substitute( "&1", v-torgconf-cli-inn          )
     2017               v-torgconf-supplier-engl-name     = substitute( "&1", v-torgconf-cli-engl-name          )
     2018               v-torgconf-saler-inn        = substitute( "&1", v-torgconf-self-host-inn    )
     2019               v-torgconf-consignee-inn    = substitute( "&1", v-torgconf-sup-host-inn    )
     2020               v-torgconf-supplier-kpp     = substitute( "&1", v-torgconf-cli-kpp          )
     2021               v-torgconf-saler-kpp        = substitute( "&1", v-torgconf-self-host-kpp    )
     2022               v-torgconf-consignee-kpp    = substitute( "&1", v-torgconf-sup-host-kpp    )
     2023           .
     2024           if v-torgconf-cli-schet-exists = yes
     2025           AND v-form-name                  = "torg12":U
     2026           then do:
     2027               assign
     2028                   v-torgconf-supplier = v-torgconf-supplier
     2029                       + substitute( ", р/с &1 к/с &2"
     2030                                   , v-torgconf-cli-bank-r-schet
     2031                                   , v-torgconf-cli-bank-c-schet
     2032                                   )
     2033                   v-torgconf-suppi = v-torgconf-supplier
     2034                       + substitute( ", р/с &1 к/с &2"
     2035                                   , v-torgconf-cli-bank-r-schet
     2036                                   , v-torgconf-cli-bank-c-schet
     2037                                   )
     2038               .
     2039               if v-torgconf-cli-bank-exists = yes
     2040               then do:
