      818   define variable v-torgconf-sup-obj-name             as character    no-undo.
      819   define variable v-torgconf-sup-obj-engl-name             as character    no-undo.
      820   define variable v-torgconf-sup-obj-addres           as character    no-undo.
      821   define variable v-torgconf-sup-obj-phone            as character    no-undo.
