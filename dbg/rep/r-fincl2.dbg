     2401     end.
     2402     run waitfram-show in this-procedure ("Печать отчета...") .
     2403     run print-header in this-procedure .
     2404     run print-report in this-procedure .
     2405     run waitfram-hide in this-procedure .
     2406     hide stream out-stream frame BottomFrame.
     2407     output stream out-stream close.
     2408     if Make-Excel then output stream ForExcel close.
     2409     empty temp-table tt-report.
     2410     empty temp-table tt-report-pay-sum.
     2411   if session :set-wait-state( "" ) then.
     2412     define variable v-user-action   as character no-undo .
     2413     define variable v-printed       as logical   no-undo .
     2414     define variable DisabledOptions as integer   no-undo .
     2415     define variable v-orient-page as character no-undo .
     2416     run How-name in this-procedure ( input ReportPageHeight
     2417                                    , input ReportPageWidth
     2418                                    , output v-orient-page
     2419                                    ) .
     2420     if v-orient-page = "A4-lans":U then DisabledOptions = 8 .
     2421                                    else DisabledOptions = 0 .
     2422     run gbl/prnfilen.w
     2423         ( input  ""
     2424         , input  DisabledOptions
     2425         , input  string(session :temp-directory) + "rpt" + string( g#report-num )
     2426         , input  ReportFontNum
     2427         , output v-user-action
     2428         , output v-printed
     2429         ) .
     2430   end.
     2431   procedure print-header :
     2432   do
     2433   on error undo, return error return-value
     2434   :
     2435     put stream out-stream unformatted
     2436       substitute( "Взаиморасчеты по контрагентам за период с &1 по &2", x-Date-Start , X-Date-end ) skip
     2437     .
     2438     assign
     2439       str1 = ""
     2440       str2 = ""
     2441       str3 = ""
     2442       str4 = ""
     2443       reportname = substitute( "Взаиморасчеты по контрагентам за период с &1 по &2", x-Date-Start , X-Date-end )
     2444       sheetf.sheet-num   = 1
     2445       sheetf.MergeCellsH = "3:5,6:7"
     2446       sheetf.MergeCellsV = "1=1:2/2=1:2"
     2447       sheetf.Excel-Column-Lable =
     2448         "Клиент"          + chr(44) +
     2449         "Оплачено руб"   + chr(44) +
     2450         "Выдано талонов"  + chr(44) +
     2451                             chr(44) +
     2452                             chr(44) +
     2453         "Отпущено топлива по талонам" + chr(44) +
     2454         chr(44) +
     2455         chr(10)   +
     2456         chr(44) +
     2457         chr(44) +
     2458         "Талон"           + chr(44) +
     2459         "л"               + chr(44) +
     2460         "руб"             + chr(44) +
     2461         "л"               + chr(44) +
     2462         "руб"
     2463       sheetf.sizes =
     2464         "30"  + chr(44) +
     2465         "15"  + chr(44) +
     2466         "20"  + chr(44) +
     2467         "10"  + chr(44) +
     2468         "15"  + chr(44) +
     2469         "15"  + chr(44) +
     2470         "20"
     2471       Sheetf.colformat = "1=@;2=@;3=@;4=@;5=@;6=@;7=@"
     2472     .
     2473     run rep/extitle.p (1).
     2474   end.
     2475   end procedure.
     2476   procedure print-report :
     2477   do
     2478   on error undo, return error return-value
     2479   :
     2480     define variable v-is-first-print                as logical   no-undo .
     2481     define variable v-subtotal-talon-give-money-sum as decimal   no-undo .
     2482     define variable v-subtotal-fuel-sell-money-sum  as decimal   no-undo .
     2483     define variable v-total-talon-give-money-sum    as decimal   no-undo .
     2484     define variable v-total-fuel-sell-money-sum     as decimal   no-undo .
     2485     for each tt-report-pay-sum
     2486       by tt-report-pay-sum.obj-name
     2487     :
     2488       if tt-report-pay-sum.pay-sum = 0 then do:
     2489         find first tt-report
     2490           where tt-report.obj-type = tt-report-pay-sum.obj-type
     2491             and tt-report.obj-code = tt-report-pay-sum.obj-code
     2492         no-error .
     2493         if not available tt-report then next.
     2494       end.
     2495       assign
     2496         v-is-first-print                = yes
     2497       .
     2498       display stream out-stream
     2499           tt-report-pay-sum.obj-name
     2500           tt-report-pay-sum.pay-sum
     2501           sym1
     2502           sym2
     2503           sym3
     2504           sym4
     2505           sym5
     2506           sym6
     2507           sym7
     2508           sym8
     2509       with frame fincl2.
     2510       for each tt-report
     2511         where tt-report.obj-type = tt-report-pay-sum.obj-type
     2512           and tt-report.obj-code = tt-report-pay-sum.obj-code
     2513       by tt-report.talon-name
     2514       :
     2515         display stream out-stream
     2516           tt-report.talon-name
     2517           tt-report.talon-give-units-sum
     2518           tt-report.talon-give-money-sum
     2519           tt-report.fuel-sell-units-sum
     2520           tt-report.fuel-sell-money-sum
     2521           sym1
     2522           sym2
     2523           sym3
     2524           sym4
     2525           sym5
     2526           sym6
     2527           sym7
     2528           sym8
     2529         with frame fincl2.
     2530         down stream out-stream with frame fincl2.
     2531         if Make-Excel then  put   stream ForExcel unformatted
     2532           ( if v-is-first-print then tt-report-pay-sum.obj-name else " ")           CHR(9)
     2533           ( if v-is-first-print then string(tt-report-pay-sum.pay-sum)  else " " )  CHR(9)
     2534           tt-report.talon-name                                                      CHR(9)
     2535           tt-report.talon-give-units-sum                                            CHR(9)
     2536           tt-report.talon-give-money-sum                                            CHR(9)
     2537           tt-report.fuel-sell-units-sum                                             CHR(9)
     2538           tt-report.fuel-sell-money-sum                                             CHR(9)
     2539         skip.
     2540         assign
     2541           v-counter                       = v-counter + 1
     2542           v-is-first-print                = no
     2543           v-subtotal-talon-give-money-sum = v-subtotal-talon-give-money-sum + tt-report.talon-give-money-sum
     2544           v-subtotal-fuel-sell-money-sum  = v-subtotal-fuel-sell-money-sum  + tt-report.fuel-sell-money-sum
     2545         .
     2546       end.
     2547       put stream out-stream unformatted v-line format "X(125)" skip.
     2548       display stream out-stream
     2549         "Итого:"                        @ tt-report-pay-sum.pay-sum
     2550         v-subtotal-talon-give-money-sum @ tt-report.talon-give-money-sum
     2551         v-subtotal-fuel-sell-money-sum  @ tt-report.fuel-sell-money-sum
     2552         sym1
     2553         sym2
     2554         sym3
     2555         sym4
     2556         sym5
     2557         sym6
     2558         sym7
     2559         sym8
     2560       with frame fincl2.
     2561       down stream out-stream with frame fincl2.
     2562       put stream out-stream unformatted v-line format "X(125)" skip.
     2563       if Make-Excel then  put   stream ForExcel unformatted
     2564         " "                             CHR(9)
     2565         "Итого"                         CHR(9)
     2566         " "                             CHR(9)
     2567         " "                             CHR(9)
     2568         v-subtotal-talon-give-money-sum CHR(9)
     2569         " "                             CHR(9)
     2570         v-subtotal-fuel-sell-money-sum  CHR(9)
     2571       skip.
     2572       assign
     2573         v-total-talon-give-money-sum    = v-total-talon-give-money-sum + v-subtotal-talon-give-money-sum
     2574         v-total-fuel-sell-money-sum     = v-total-fuel-sell-money-sum  + v-subtotal-fuel-sell-money-sum
     2575         v-subtotal-talon-give-money-sum = 0
     2576         v-subtotal-fuel-sell-money-sum  = 0
     2577       .
     2578     end.
     2579     display stream out-stream
     2580       "Всего"                      @ tt-report-pay-sum.pay-sum
     2581       v-total-talon-give-money-sum @ tt-report.talon-give-money-sum
     2582       v-total-fuel-sell-money-sum  @ tt-report.fuel-sell-money-sum
     2583       sym1
     2584       sym2
     2585       sym3
     2586       sym4
     2587       sym5
     2588       sym6
     2589       sym7
     2590       sym8
     2591     with frame fincl2.
     2592     put stream out-stream unformatted v-line format "X(125)" skip.
     2593     if Make-Excel then  put   stream ForExcel unformatted
     2594       " "                          CHR(9)
     2595       "Всего"                      CHR(9)
     2596       " "                          CHR(9)
     2597       " "                          CHR(9)
