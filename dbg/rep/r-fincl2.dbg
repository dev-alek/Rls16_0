     1532   define variable v-saldo-2                as decimal   no-undo .
     1533   define variable v-curr-r-b           as integer   no-undo .
     1534   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1535   procedure calc-cli-saldo :
     1536     define input  parameter p-cli-type      like ub.clients.obj-type no-undo .
     1537     define input  parameter p-cli-code      like ub.clients.obj-code no-undo .
     1538     define input  parameter p-host-code-obj like ub.clients.obj-code no-undo .
     1539     define input  parameter p-curr-r-b      like ub.arh-fin-doc-contr-schet.calc-curr-code no-undo .
     1540     define input  parameter p-fact-order    as decimal   no-undo .
     1541     define output parameter p-saldo         as decimal   no-undo .
     1542     define variable v-saldo as decimal   no-undo .
     1543     define variable v-sum-e as decimal   no-undo .
     1544     define variable v-sum-i as decimal   no-undo .
     1545   do
     1546   on error undo, return error return-value
     1547   :
     1548       run CalcOstatFin( input p-cli-type
     1549                       , input p-cli-code
     1550                       , input p-host-code-obj
     1551                       , input p-curr-r-b
     1552                       , input p-fact-order
     1553                       , input 'ппп':U
     1554                       , output v-sum-e
     1555                       , output v-sum-i
     1556                       ) .
     1557       assign  v-saldo = v-saldo - v-sum-e .
     1558       run CalcOstatFin( input p-cli-type
     1559                       , input p-cli-code
     1560                       , input p-host-code-obj
     1561                       , input p-curr-r-b
     1562                       , input p-fact-order
     1563                       , input 'рпп':U
     1564                       , output v-sum-e
     1565                       , output v-sum-i
     1566                       ) .
     1567       assign  v-saldo = v-saldo + v-sum-i .
     1568       run CalcOstatFinNal( input p-cli-type
     1569                          , input p-cli-code
     1570                          , input p-host-code-obj
     1571                          , input p-curr-r-b
     1572                          , input p-fact-order
     1573                          , input 'пко':U
     1574                          , output v-sum-e
     1575                          , output v-sum-i
     1576                          ) .
     1577       assign  v-saldo = v-saldo - v-sum-e .
     1578       run CalcOstatFinNal( input p-cli-type
     1579                          , input p-cli-code
     1580                          , input p-host-code-obj
     1581                          , input p-curr-r-b
     1582                          , input p-fact-order
     1583                          , input 'рко':U
     1584                          , output v-sum-e
     1585                          , output v-sum-i
     1586                          ) .
     1587       assign  v-saldo = v-saldo + v-sum-i .
     1588       run CalcOstatFinNal( input p-cli-type
     1589                          , input p-cli-code
     1590                          , input p-host-code-obj
     1591                          , input p-curr-r-b
     1592                          , input p-fact-order
     1593                          , input 'апп':U
     1594                          , output v-sum-e
     1595                          , output v-sum-i
     1596                          ) .
     1597       assign  v-saldo = v-saldo - v-sum-e .
     1598       run CalcOstatFinNal( input p-cli-type
     1599                          , input p-cli-code
     1600                          , input p-host-code-obj
     1601                          , input p-curr-r-b
     1602                          , input p-fact-order
     1603                          , input 'апр':U
     1604                          , output v-sum-e
     1605                          , output v-sum-i
     1606                          ) .
     1607       assign  v-saldo = v-saldo + v-sum-i .
     1608       define buffer buf_clients for ub.clients.
     1609       define buffer buf_arh-wth-cli-tot for ub.arh-wth-cli-tot.
     1610               define variable v-wth-saldo as decimal   no-undo .
     1611     for each buf_clients no-lock
     1612       where buf_clients.host-code = p-host-code-obj
     1613     :
     1614       find last buf_arh-wth-cli-tot no-lock
     1615         where buf_arh-wth-cli-tot.cli-type     = p-cli-type
     1616           and buf_arh-wth-cli-tot.cli-code     = p-cli-code
     1617           and buf_arh-wth-cli-tot.obj-type     = buf_clients.obj-type
     1618           and buf_arh-wth-cli-tot.obj-code     = buf_clients.obj-code
     1619           and buf_arh-wth-cli-tot.ext-doc-type = 'pc':U
     1620           and buf_arh-wth-cli-tot.sum-type     = 'при':U
     1621           and buf_arh-wth-cli-tot.fact-order  <= p-fact-order
     1622       no-error .
     1623       if available buf_arh-wth-cli-tot then do:
     1624         assign
     1625           v-saldo = v-saldo + if v-print-rubl then buf_arh-wth-cli-tot.in-sum-rubl
     1626                               else                 buf_arh-wth-cli-tot.in-sum-base
     1627         .
     1628       end.
     1629       find last buf_arh-wth-cli-tot no-lock
     1630         where buf_arh-wth-cli-tot.cli-type     = p-cli-type
     1631           and buf_arh-wth-cli-tot.cli-code     = p-cli-code
     1632           and buf_arh-wth-cli-tot.obj-type     = buf_clients.obj-type
     1633           and buf_arh-wth-cli-tot.obj-code     = buf_clients.obj-code
     1634           and buf_arh-wth-cli-tot.ext-doc-type = 'ps':U
     1635           and buf_arh-wth-cli-tot.sum-type     = 'при':U
     1636           and buf_arh-wth-cli-tot.fact-order  <= p-fact-order
     1637       no-error .
     1638       if available buf_arh-wth-cli-tot then do:
     1639         assign
     1640           v-saldo = v-saldo + if v-print-rubl then buf_arh-wth-cli-tot.in-sum-rubl
     1641                               else                 buf_arh-wth-cli-tot.in-sum-base
     1642         .
     1643       end.
     1644       find last buf_arh-wth-cli-tot no-lock
     1645         where buf_arh-wth-cli-tot.cli-type     = p-cli-type
     1646           and buf_arh-wth-cli-tot.cli-code     = p-cli-code
     1647           and buf_arh-wth-cli-tot.obj-type     = buf_clients.obj-type
     1648           and buf_arh-wth-cli-tot.obj-code     = buf_clients.obj-code
     1649           and buf_arh-wth-cli-tot.ext-doc-type = 'pz':U
     1650           and buf_arh-wth-cli-tot.sum-type     = 'при':U
     1651           and buf_arh-wth-cli-tot.fact-order  <= p-fact-order
     1652       no-error .
     1653       if available buf_arh-wth-cli-tot then do:
     1654         assign
     1655           v-saldo = v-saldo + if v-print-rubl then buf_arh-wth-cli-tot.out-sum-rubl
     1656                               else                 buf_arh-wth-cli-tot.out-sum-base
     1657         .
     1658       end.
     1659     end.
     1660     assign
     1661       p-saldo = v-saldo
     1662     .
     1663   end.
     1664   end procedure.
     1665   procedure CalcOstatFin:
     1666     do on error undo, return error return-value :
     1667       define input  parameter p-cli-type      like ub.clients.obj-type no-undo .
     1668       define input  parameter p-cli-code      like ub.clients.obj-code no-undo .
     1669       define input  parameter p-host-code-obj like ub.clients.obj-code no-undo .
     1670       define input  parameter p-curr-r-b      like ub.arh-fin-doc-contr-schet.calc-curr-code no-undo .
     1671       define input  parameter p-fact-order     as decimal   no-undo .
     1672       define input  parameter p-type          as character no-undo .
     1673       define output parameter p-sum-exp       as decimal   no-undo .
     1674       define output parameter p-sum-inc       as decimal   no-undo .
     1675       define buffer buf_contract                for ub.contract .
     1676       define buffer buf_arh-fin-doc-contr-schet for ub.arh-fin-doc-contr-schet .
     1677       for each buf_contract no-lock
     1678         where buf_contract.host-code = p-host-code-obj
     1679           and buf_contract.cli-type  = p-cli-type
     1680           and buf_contract.cli-code  = p-cli-code
     1681           and buf_contract.doc-type  = 'рас':U
     1682       :
     1683         find last buf_arh-fin-doc-contr-schet no-lock
     1684           where buf_arh-fin-doc-contr-schet.host-code        = p-host-code-obj
     1685             and buf_arh-fin-doc-contr-schet.contract-code    = buf_contract.contract-code
     1686             and buf_arh-fin-doc-contr-schet.code-schet       = 0
     1687             and buf_arh-fin-doc-contr-schet.cli-code         = p-cli-code
     1688             and buf_arh-fin-doc-contr-schet.cli-type         = p-cli-type
     1689             and buf_arh-fin-doc-contr-schet.fin-ext-doc-type = p-type
     1690             and buf_arh-fin-doc-contr-schet.calc-curr-code   = p-curr-r-b
     1691             and buf_arh-fin-doc-contr-schet.sum-type         = "sum-contract"
     1692             and buf_arh-fin-doc-contr-schet.fact-order      < p-fact-order
     1693         no-error .
     1694         if available buf_arh-fin-doc-contr-schet then
     1695           assign
     1696             p-sum-exp = p-sum-exp + buf_arh-fin-doc-contr-schet.expense
     1697             p-sum-inc = p-sum-inc + buf_arh-fin-doc-contr-schet.income
     1698           .
     1699         end.
     1700       end.
     1701   end procedure.
     1702   procedure CalcOstatFinNal:
     1703     do on error undo, return error return-value :
     1704       define input  parameter p-cli-type      like ub.clients.obj-type no-undo .
     1705       define input  parameter p-cli-code      like ub.clients.obj-code no-undo .
     1706       define input  parameter p-host-code-obj like ub.clients.obj-code no-undo .
     1707       define input  parameter p-curr-r-b      like ub.arh-fin-doc-contr-schet.calc-curr-code no-undo .
     1708       define input  parameter p-fact-order    as decimal   no-undo .
     1709       define input  parameter p-type          as character no-undo .
     1710       define output parameter p-sum-exp       as decimal   no-undo .
     1711       define output parameter p-sum-inc       as decimal   no-undo .
     1712       define buffer buf_contract                    for ub.contract .
     1713       define buffer buf_arh-fin-doc-contr-schet-nal for ub.arh-fin-doc-contr-schet-nal .
     1714       for each buf_contract no-lock
     1715         where buf_contract.host-code = p-host-code-obj
     1716           and buf_contract.cli-type  = p-cli-type
     1717           and buf_contract.cli-code  = p-cli-code
     1718           and buf_contract.doc-type  = 'рас':U
     1719       :
     1720         find last buf_arh-fin-doc-contr-schet-nal no-lock
     1721           where buf_arh-fin-doc-contr-schet-nal.host-code        = p-host-code-obj
     1722             and buf_arh-fin-doc-contr-schet-nal.contract-code    = buf_contract.contract-code
     1723             and buf_arh-fin-doc-contr-schet-nal.cli-code         = p-cli-code
     1724             and buf_arh-fin-doc-contr-schet-nal.cli-type         = p-cli-type
     1725             and buf_arh-fin-doc-contr-schet-nal.fin-code-acc     = 0
     1726             and buf_arh-fin-doc-contr-schet-nal.fin-ext-doc-type = p-type
     1727             and buf_arh-fin-doc-contr-schet-nal.curr-code        = p-curr-r-b
     1728             and buf_arh-fin-doc-contr-schet-nal.calc-curr-code   = p-curr-r-b
     1729             and buf_arh-fin-doc-contr-schet-nal.sum-type         = "sum-contract"
     1730             and buf_arh-fin-doc-contr-schet-nal.fact-order       < p-fact-order
     1731         no-error .
     1732         if available buf_arh-fin-doc-contr-schet-nal then
     1733           assign
     1734             p-sum-exp = p-sum-exp + buf_arh-fin-doc-contr-schet-nal.expense
     1735             p-sum-inc = p-sum-inc + buf_arh-fin-doc-contr-schet-nal.income
     1736           .
     1737         end.
     1738       end.
     1739   end procedure.
     1740   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1741   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run r-b-curr in g#library
     1742     (input  v-cntxt-host-code-obj
     1743     ,output v-curr-r-b
     1744     )  .
     1745   define frame fincl2
     1746     sym1                            no-label format "X(1)"                          space(0)
     1747     tt-report-pay-sum.obj-name      no-label format "X(30)":U                   space(0)
     1748     sym2                            no-label format "X(1)"                          space(0)
     1749     tt-report-pay-sum.pay-sum       no-label format "->>>,>>>,>>9.99":U                   space(0)
     1750     sym3                            no-label format "X(1)"                          space(0)
     1751     tt-report.talon-name            no-label format "X(20)"                   space(0)
     1752     sym4                            no-label format "X(1)"                          space(0)
     1753     tt-report.talon-give-units-sum  no-label format "->>>,>>9.99":U                   space(0)
     1754     sym5                            no-label format "X(1)"                          space(0)
     1755     tt-report.talon-give-money-sum  no-label format "->>>,>>>,>>9.99":U                   space(0)
     1756     sym6                            no-label format "X(1)"                          space(0)
     1757     tt-report.fuel-sell-units-sum   no-label format "->>>,>>9.99":U                   space(0)
     1758     sym7                            no-label format "X(1)"                          space(0)
     1759     tt-report.fuel-sell-money-sum   no-label format "->>>,>>>,>>9.99":U                   space(0)
     1760     sym8                            no-label format "X(1)"                          space(0)
     1761   header
     1762       "-----------------------------------------------------------------------------------------------------------------------------":U skip
     1763       ":            Клиент            : Оплачено, руб :                     Выдано талонов             :Отпущено топлива по талонам:":U skip
     1764       ":                              :               :--------------------:-----------:---------------:-----------:---------------:":U skip
     1765       ":                              :               :        Талон       :     л     :       руб.    :     л     :       руб.    :":U skip
     1766   with width 125 down stream-io no-label no-box.
     1767   form header
     1768           v-line format "X(125)" at 1 SKIP
     1769           "Продолжение - на следующей странице" at 1 SKIP
     1770   with frame BottomFrame width 198 PAGE-BOTTOM NO-LABELS NO-BOX .
     1771   do on error undo, return error return-value :
     1772     assign
     1773       v-line = fill( "-" , 300 )
     1774       v-repfrm-str = "Расчет по архиву..."
     1775       v-counter    = 0
     1776     .
     1777     case x-SET_val_TYPE :
     1778       when 1 then do:
     1779         assign
     1780           v-print-rubl = yes
     1781         .
     1782       end.
     1783       when 2 then do:
     1784         assign
     1785           v-print-rubl = no
     1786         .
     1787       end.
     1788       otherwise do:
     1789         message "Неизвестный тип валюты!" skip "Отчет формируется в базовой валюте" view-as alert-box information .
     1790         assign
     1791           v-print-rubl = no
     1792         .
     1793       end.
     1794     end case.
     1795   if session :set-wait-state( "compiler" ) then.
     1796   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1797     run mainmenu_getcntxt in parparentproc
     1798       (output v-cntxt-db-num
     1799       ,output v-cntxt-userid
     1800       ,output v-cntxt-level
     1801       ,output v-cntxt-host-code-obj
     1802       ,output v-cntxt-obj-type
     1803       ,output v-cntxt-obj-code
     1804       ,output v-cntxt-db-num-obj
     1805       ,output v-cntxt-is-admin
     1806       ) .
     1807     run day-begin-fact-order in this-procedure ( input x-Date-Start , output v-fact-order-start ).
     1808     run day-begin-fact-order in this-procedure ( input ( x-Date-End + 1 ) , output v-fact-order-end ).
     1809     run get-report-num in parparentproc (output g#report-num).
     1810   output stream out-stream to value( string( session:temp-directory +
     1811                                        "rpt" + string( g#report-num ) ) )
     1812                                        page-size 62 .
     1813     view stream out-stream frame BottomFrame .
     1814     if p-rad = 1 then do:
     1815   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1816       _calc-block:
     1817       for each ub.clients no-lock :
     1818         if ub.clients.obj-type = 'маг':U or ub.clients.obj-type = 'скл':U then do:
     1819           next _calc-block.
     1820         end.
     1821         assign
     1822           v-repfrm-str  = "Расчет для: " + ub.clients.obj-name
     1823         .
     1824         run waitfram-show in this-procedure ( input v-repfrm-str ).
     1825         run calc-cli-saldo in this-procedure ( input ub.clients.obj-type
     1826                                              , input ub.clients.obj-code
     1827                                              , input v-cntxt-host-code-obj
     1828                                              , input v-curr-r-b
     1829                                              , input v-fact-order-start
     1830                                              , output v-saldo-1
     1831                                              ) .
     1832         run calc-cli-saldo in this-procedure ( input ub.clients.obj-type
     1833                                              , input ub.clients.obj-code
     1834                                              , input v-cntxt-host-code-obj
     1835                                              , input v-curr-r-b
     1836                                              , input v-fact-order-start
     1837                                              , output v-saldo-2
     1838                                              ) .
     1839         create tt-report-pay-sum.
     1840         assign
     1841           tt-report-pay-sum.obj-type = ub.clients.obj-type
     1842           tt-report-pay-sum.obj-code = ub.clients.obj-code
     1843           tt-report-pay-sum.obj-name = ub.clients.obj-name
     1844           tt-report-pay-sum.pay-sum  = v-saldo-2 - v-saldo-1
     1845         .
     1846         for each buf_wth-gds no-lock
     1847               where buf_wth-gds.stts = 0 ,
     1848             each buf_wth-par no-lock
     1849               where buf_wth-par.wth-code = buf_wth-gds.wth-code ,
     1850             each buf_wth-ser no-lock
     1851               where buf_wth-ser.wth-code = buf_wth-par.wth-code
     1852                 and buf_wth-ser.par-code = buf_wth-par.par-code ,
     1853             first buf_goods no-lock
     1854               where buf_goods.gds-code = buf_wth-gds.gds-code
     1855         :
     1856           for each buf_clients no-lock
     1857             where buf_clients.host-code = v-cntxt-host-code-obj
     1858           :
     1859             assign
     1860               v-counter = v-counter + 1
     1861             .
     1862                 find last buf_arh-wth-cli no-lock
     1863                   where buf_arh-wth-cli.cli-type     = ub.clients.obj-type
     1864                     and buf_arh-wth-cli.cli-code     = ub.clients.obj-code
     1865                     and buf_arh-wth-cli.ext-doc-type = 'pc':U
     1866                     and buf_arh-wth-cli.wth-code     = buf_wth-par.wth-code
     1867                     and buf_arh-wth-cli.par-code     = buf_wth-par.par-code
     1868                     and buf_arh-wth-cli.ser-code     = buf_wth-ser.ser-code
     1869                     and buf_arh-wth-cli.db-num       = buf_wth-ser.db-num
     1870                     and buf_arh-wth-cli.gds-code     = buf_goods.gds-code
     1871                     and buf_arh-wth-cli.obj-type     = buf_clients.obj-type
     1872                     and buf_arh-wth-cli.obj-code     = buf_clients.obj-code
     1873                     and buf_arh-wth-cli.sum-type     = 'при':U
     1874                     and buf_arh-wth-cli.fact-order  <= v-fact-order-start
     1875                 no-error .
     1876                 if available buf_arh-wth-cli then do:
     1877                   assign
     1878                     v-fuel-sell-money-sum-1 = v-fuel-sell-money-sum-1 + if v-print-rubl then buf_arh-wth-cli.in-sum-rubl
     1879                                                                         else                 buf_arh-wth-cli.in-sum-base
     1880                     v-fuel-sell-units-sum-1 = v-fuel-sell-units-sum-1 + buf_arh-wth-cli.in-qnty
     1881                   .
     1882                 end.
     1883                 find last buf_arh-wth-cli no-lock
