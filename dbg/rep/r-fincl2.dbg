     1510   define buffer buf_wth-gds     for ub.wth-gds.
     1511   define buffer buf_wth-ser     for ub.wth-ser.
     1512   define buffer buf_wealth      for ub.wealth.
     1513   define buffer buf_arh-wth-cli for ub.arh-wth-cli.
     1514   define variable g#report-num             as integer   no-undo .
     1515   define variable v-fact-order-start       as decimal   no-undo .
     1516   define variable v-fact-order-end         as decimal   no-undo .
     1517   define variable v-line                   as character no-undo .
     1518   define variable v-print-rubl             as logical   no-undo .
     1519   define variable v-repfrm-str             as character no-undo .
     1520   define variable v-counter                as integer   no-undo .
     1521   define variable v-pay-sum-1              as decimal   no-undo .
     1522   define variable v-talon-give-money-sum-1 as decimal   no-undo .
     1523   define variable v-fuel-sell-money-sum-1  as decimal   no-undo .
     1524   define variable v-talon-give-units-sum-1 as decimal   no-undo .
     1525   define variable v-fuel-sell-units-sum-1  as decimal   no-undo .
     1526   define variable v-pay-sum-2              as decimal   no-undo .
     1527   define variable v-talon-give-money-sum-2 as decimal   no-undo .
     1528   define variable v-fuel-sell-money-sum-2  as decimal   no-undo .
     1529   define variable v-talon-give-units-sum-2 as decimal   no-undo .
     1530   define variable v-fuel-sell-units-sum-2  as decimal   no-undo .
