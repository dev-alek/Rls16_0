     2352                     and buf_arh-wth-cli.db-num       = buf_wth-ser.db-num
     2353                     and buf_arh-wth-cli.gds-code     = buf_goods.gds-code
     2354                     and buf_arh-wth-cli.obj-type     = buf_clients.obj-type
