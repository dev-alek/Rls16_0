     2369             or (v-fuel-sell-money-sum-2  - v-fuel-sell-money-sum-1 ) <> 0
     2370             or (v-fuel-sell-units-sum-2  - v-fuel-sell-units-sum-1 ) <> 0
     2371           then do :
