      586   define variable sym11 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      587   define variable sym12 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      588   define variable sym13 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      589   define variable sym14 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      590   define variable sym15 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      591   define variable sym16 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      592   define variable sym17 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      593   define variable sym18 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      594   define variable sym19 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      595   define variable sym20 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      596   define variable sym21 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      597   define variable sym22 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      598   define variable sym23 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      599   define variable sym24 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      600   define variable sym25 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      601   define variable sym26 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      602   define variable sym27 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      603   define variable temp1 as integer   no-undo.
      604   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      605   procedure factord :
      606     define input  parameter p-fact-date            as date    no-undo .
      607     define input  parameter p-fact-time            as integer no-undo .
      608     define input  parameter p-fact-num             as integer no-undo .
      609     define input  parameter p-shift-date           as date    no-undo .
      610     define input  parameter p-shift-num            as integer no-undo .
      611     define input  parameter p-shift-on             as logical no-undo .
      612     define output parameter p-fact-order           as decimal no-undo .
      613     define output parameter p-shift-end-fact-order as decimal no-undo .
      614     define output parameter p-day-end-fact-order   as decimal no-undo .
      615     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      616     if p-fact-date = ?
      617     then do:
      618       return error "Не указана фактическая дата" .
      619     end.
      620     define variable v-fact-date-num as integer no-undo .
      621     assign
      622       v-fact-date-num = integer(p-fact-date)
      623     .
      624     if p-fact-num = ?
      625     or p-fact-num = 0
      626     then do:
      627       return error "Не задан p-fact-num " + string(p-fact-num) .
      628     end.
      629     if p-fact-num < 0
      630     then do:
      631       return error "Отрицательный fact-num " + string(p-fact-num) .
      632     end.
      633     if p-fact-num >= 100000000
      634     then do:
      635       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      636     end.
      637     if p-shift-on = true
      638     then do:
      639       if p-shift-date = ?
      640       then do:
      641         return error "Не задана дата смены" .
      642       end.
      643       if p-shift-num = ?
      644       or p-shift-num = 0
      645       then do:
      646         return error "Не задан номер смены" .
      647       end.
      648     end.
      649     else do:
      650       assign
      651         p-shift-date = p-fact-date
      652         p-shift-num  = 24
      653       .
      654     end.
      655     define variable v-shift-offset as integer no-undo .
      656     if p-shift-date = p-fact-date
      657     then do:
      658       assign
      659         v-shift-offset = 1
      660       .
      661     end.
      662     if p-shift-date < p-fact-date
      663     then do:
      664       assign
      665         v-shift-offset = 0
      666       .
      667     end.
      668     if p-shift-date > p-fact-date
      669     then do:
      670       message
      671         vss-workfile vss-revision vss-description skip
      672         "Неправильная дата закрытия смены" skip
      673         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      674         view-as alert-box error .
      675       undo, return error
      676         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      677           ,string(p-fact-date, '99/99/9999':U)
      678           ,string(p-shift-date, '99/99/9999':U)
      679           )
      680       .
      681     end.
      682     if p-shift-num < 1
      683     or p-shift-num > 24
      684     then do:
      685       message
      686         vss-workfile vss-revision vss-description skip
      687         "Неправильный номер смены" skip
      688         "p-shift-num" p-shift-num skip
      689         view-as alert-box error .
      690       undo, return error return-value .
      691     end.
      692     assign
      693       p-fact-order           = v-fact-date-num
      694                              + v-shift-offset * 0.5
      695                              + p-shift-num    * 0.02 - 0.01
      696                              + p-fact-num     * 0.0000000001
      697       p-shift-end-fact-order = v-fact-date-num
      698                              + v-shift-offset * 0.5
      699                              + p-shift-num    * 0.02
      700       p-day-end-fact-order   = v-fact-date-num
      701                              + 0.99
      702     .
      703     if p-fact-order           <= v-fact-date-num
      704     or p-shift-end-fact-order <= v-fact-date-num
      705     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      706     or p-shift-end-fact-order >= p-day-end-fact-order
      707     then do:
      708       message
      709         vss-workfile vss-revision vss-description skip
      710         "Внутренняя ошибка при генерации фактического номера" skip
      711         "p-fact-date"            p-fact-date            skip
      712         "p-fact-time"            p-fact-time            skip
      713         "p-fact-num"             p-fact-num             skip
      714         "p-shift-date"           p-shift-date           skip
      715         "p-shift-num"            p-shift-num            skip
      716         "p-shift-on"             p-shift-on             skip
      717         "p-shift-end-fact-order" p-shift-end-fact-order skip
      718         "p-day-end-fact-order"   p-day-end-fact-order   skip
      719         "v-fact-date-num"        v-fact-date-num        skip
      720         view-as alert-box error .
      721       undo, return error return-value .
      722     end.
      723   end procedure.
      724   procedure day-begin-fact-order :
      725     define input  parameter p-fact-date            as date    no-undo .
      726     define output parameter p-day-begin-fact-order as decimal no-undo .
      727     do
      728     on error undo, return error return-value
      729     :
      730       if p-fact-date = ?
      731       then do:
      732         assign
      733           p-day-begin-fact-order = 0
      734         .
      735       end.
      736       else do:
      737         assign
      738           p-day-begin-fact-order = integer(p-fact-date)
      739         .
      740       end.
      741     end.
      742   end procedure.
      743   procedure factord-max-fact-order :
      744     define output parameter p-max-fact-order as decimal   no-undo .
      745     do
      746     on error undo, return error return-value
      747     :
      748       run day-begin-fact-order in this-procedure
      749         (input  date(1, 1, 5000)
      750         ,output p-max-fact-order
      751         ) .
      752     end.
      753   end procedure.
      754   procedure factord-cut-archive :
      755     define input  parameter p-obj-type             as character no-undo .
      756     define input  parameter p-obj-code             as integer   no-undo .
      757     define input  parameter p-fact-date            as date      no-undo .
      758     define output parameter p-shift-on             as logical   no-undo .
      759     define output parameter p-shift-date           as date      no-undo .
      760     define output parameter p-shift-num            as integer   no-undo .
      761     define output parameter p-day-end-fact-order   as decimal   no-undo .
      762     define output parameter p-shift-end-fact-order as decimal   no-undo .
      763     define variable v-fact-order as decimal   no-undo .
      764     define buffer buf_shift-obj for ub.shift-obj .
      765     do
      766     on error undo, return error return-value
      767     :
      768   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      769   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      770     (input  p-obj-type
      771     ,input  p-obj-code
      772     ,input  'shift-on=request'
      773     ,output p-shift-on
      774     ) no-error .
      775       if error-status :error
      776       then do:
      777         message
      778           vss-workfile vss-revision vss-description skip
      779           "Ошибка при определении атрибута объекта" skip
      780           "Объект" p-obj-type p-obj-code skip
      781           error-status :get-message(1) skip
      782           return-value skip
      783           view-as alert-box error .
      784         undo, return error return-value .
      785       end.
      786       if p-shift-on = false
      787       then do:
      788         assign
      789           p-shift-date               = ?
      790           p-shift-num                = 0
      791         .
      792       end.
      793       else do:
      794         find first buf_shift-obj share-lock
      795           where buf_shift-obj.obj-type   = p-obj-type
      796             and buf_shift-obj.obj-code   = p-obj-code
      797             and buf_shift-obj.shift-date > p-fact-date
      798           use-index pi
      799           no-error .
      800         if not available buf_shift-obj
      801         or buf_shift-obj.status_ <> 'зкр':U
      802         then do:
      803           message
      804             vss-workfile vss-revision vss-description skip
      805             "Невозможно вычислить последнюю смену" skip
      806             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      807             "Объект" p-obj-type p-obj-code skip
      808             "Дата" p-fact-date skip
      809             view-as alert-box error .
      810           undo, return error return-value .
      811         end.
      812         find last buf_shift-obj share-lock
      813           where buf_shift-obj.obj-type = p-obj-type
      814             and buf_shift-obj.obj-code = p-obj-code
      815             and buf_shift-obj.shift-date <= p-fact-date
      816           use-index pi
      817           no-error .
      818         if available buf_shift-obj
      819         then do:
      820           if  buf_shift-obj.status_ = 'зкр':U
      821           then do:
      822             assign
      823               p-shift-date = buf_shift-obj.shift-date
      824               p-shift-num  = buf_shift-obj.shift-num
      825             .
      826           end.
      827           else do:
      828             message
      829               vss-workfile vss-revision vss-description skip
      830               "Невозможно вычислить последнюю смену" skip
      831               "Статус смены отличен от статуса" 'зкр':U skip
      832               "Объект" p-obj-type p-obj-code skip
      833               "Дата" p-fact-date skip
      834               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      835               view-as alert-box error .
      836             undo, return error return-value .
      837           end.
      838         end.
      839         else do:
      840           assign
      841             p-shift-date = p-fact-date - 1
      842             p-shift-num  = 1
      843           .
      844         end.
      845       end.
      846       run factord in this-procedure
      847         (input  p-fact-date
      848         ,input  1
      849         ,input  1
      850         ,input  p-shift-date
      851         ,input  p-shift-num
      852         ,input  p-shift-on
      853         ,output v-fact-order
      854         ,output p-shift-end-fact-order
      855         ,output p-day-end-fact-order
      856         ) no-error .
      857       if error-status :error
      858       then do:
      859         message
      860           vss-workfile vss-revision vss-description skip
      861           "Ошибка при вызове процедуры factord"
      862           error-status :get-message(1) skip
      863           return-value skip
      864           view-as alert-box error .
      865         undo, return error return-value .
      866       end.
      867     end.
      868   end procedure.
      869   procedure factord-lock-shift :
      870     define input  parameter p-obj-type  as character no-undo .
      871     define input  parameter p-obj-code  as integer   no-undo .
      872     define input  parameter p-fact-date as date      no-undo .
      873     define parameter buffer buf_shift-obj for ub.shift-obj .
      874     define variable v-shift-on      as logical   no-undo .
      875     define variable v-extra-message as character no-undo .
      876     define variable v-error as character no-undo .
      877     do
      878     on error undo, return error return-value
      879     :
      880   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      881   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      882     (input  p-obj-type
      883     ,input  p-obj-code
      884     ,input  'shift-on=request'
      885     ,output v-shift-on
      886     ) no-error .
      887       if error-status :error
      888       then do:
      889         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      890         undo, return error v-error .
      891       end.
      892       if v-shift-on = true
      893       then do:
      894         find first buf_shift-obj share-lock
      895           where buf_shift-obj.obj-type   = p-obj-type
      896             and buf_shift-obj.obj-code   = p-obj-code
      897             and buf_shift-obj.shift-date > p-fact-date
      898           use-index pi
      899           no-error .
      900         if not available buf_shift-obj
      901         or buf_shift-obj.status_ <> 'зкр':U
      902         then do:
      903           find last buf_shift-obj
      904             where buf_shift-obj.obj-type = p-obj-type
      905               and buf_shift-obj.obj-code = p-obj-code
      906               and buf_shift-obj.status_  = 'зкр':U
      907             use-index stts
      908             no-error .
      909           if available buf_shift-obj
      910           then do:
      911             assign
      912               v-extra-message =
      913                     substitute("Дата начала последеней закрытой смены на объекте &1"
      914                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      915                               )
      916             .
      917           end.
      918           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      919           undo, return error v-error .
      920         end.
      921       end.
      922     end.
      923   end procedure.
      924   procedure factord-end-day :
      925     define input  parameter p-fact-date            as date    no-undo .
      926     define output parameter p-day-end-fact-order   as decimal no-undo .
      927     do
      928     on error undo, return error return-value
      929     :
      930       if p-fact-date = ?
      931       then do:
      932         return error "Не указана фактическая дата" .
      933       end.
      934       assign
      935         p-day-end-fact-order = integer(p-fact-date) + 0.99
      936       .
      937     end.
      938   end procedure.
      939   procedure factord-to-date :
      940     define input  parameter p-fact-order as decimal no-undo .
      941     define output parameter p-fact-date  as date    no-undo .
      942     define variable v-ref-date  as date      no-undo .
      943     define variable v-ref-delta as integer   no-undo .
      944     do
      945     on error undo, return error return-value
      946     :
      947       if p-fact-order = ?
      948       or p-fact-order = 0
      949       then do:
      950         return error "Не указан fact-order" .
      951       end.
      952       assign
      953         v-ref-date  = date(1, 1, 2000)
      954       .
      955       assign
      956         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      957       .
      958       assign
      959         p-fact-date = v-ref-date + v-ref-delta
      960       .
      961     end.
      962   end procedure.
      963   procedure factord-to-fact-num :
      964     define input  parameter p-fact-order as decimal no-undo .
      965     define output parameter p-fact-num   as integer no-undo .
      966     define variable v-fact-order-trunc as decimal no-undo .
      967     do
      968     on error undo, return error return-value
      969     :
      970       if p-fact-order = ?
      971       or p-fact-order = 0
      972       then do:
      973         return error "Не указан fact-order" .
      974       end.
      975       assign
      976        v-fact-order-trunc = truncate(p-fact-order, 2)
      977       .
      978       assign
      979         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      980       .
      981     end.
      982   end procedure.
      983   procedure factord-to-shift-num :
      984     define input  parameter p-fact-order as decimal no-undo .
      985     define output parameter p-shift-num   as integer no-undo .
      986     define variable  p-shift-numd  as decimal   no-undo .
      987     define variable v-fact-order-trunc as decimal no-undo .
      988     do
      989     on error undo, return error return-value
      990     :
      991       if p-fact-order = ?
      992       or p-fact-order = 0
      993       then do:
      994         return error "Не указан fact-order" .
      995       end.
      996       assign
      997        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      998       .
      999       if v-fact-order-trunc < 0.5 then do:
     1000         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1001       end.
     1002       assign
     1003         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1004         .
     1005        assign
     1006         p-shift-num = truncate (p-shift-numd , 0)
     1007       .
     1008     end.
     1009   end procedure.
     1010   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1011   define variable v-waitfram-action01         as character   no-undo .
     1012   define variable v-waitfram-action02         as character   no-undo .
     1013   define variable v-waitfram-action03         as character   no-undo .
     1014   define variable mWaitFramTextBeg            as character   no-undo.
     1015   define variable mWaitFramTextEnd            as character   no-undo.
     1016   define variable mWaitFramView               as logical     no-undo.
     1017   define variable mWaitProcEvent              as logical     no-undo init yes.
     1018   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1019   define variable mWaitFramStop               as logical     no-undo.
     1020   define variable mWaitFramStopUser           as logical     no-undo.
     1021   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1022   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1023   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1024   define button B-WaitFramStop auto-end-key
     1025        label "Стоп"
     1026        size 10 by 1 tooltip "Остоновить процесс".
     1027   define button B-viewProcInfo
     1028        label "Информация"
     1029        size 15 by 1 tooltip "Информация о процесс".
     1030   define frame waitfram
     1031     v-waitfram-action01 format "x(72)" no-label skip
     1032     v-waitfram-action02 format "x(72)" no-label skip
     1033     v-waitfram-action03 format "x(72)" no-label skip
     1034     B-viewProcInfo
     1035     B-WaitFramStop at row 4 col 30
     1036     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1037     .
     1038   define new global shared variable mBatchMode as logical no-undo init ?.
     1039   define variable mFramBachModHandle as handle no-undo.
     1040   mFramBachModHandle = frame waitfram:handle.
     1041   define variable mFameOldVis as logical no-undo.
     1042   define variable mVisCUrentVin as logical no-undo.
     1043   if session:batch-mode
     1044   then
     1045      mBatchMode = yes.
     1046   if mBatchMode = ? then do:
     1047     mVisCUrentVin = current-window:visible.
     1048     mFameOldVis = mFramBachModHandle:visible.
     1049     mFramBachModHandle:visible  = yes.
     1050     mBatchMode = mFramBachModHandle:visible ne yes.
     1051     mFramBachModHandle:visible = mFameOldVis.
     1052     current-window:visible = mVisCUrentVin.
     1053   end.
     1054    if  log-manager:logfile-name ne ?
     1055     then DO:
     1056         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1057         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1058         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1059     end.
     1060   on choose of B-WaitFramStop in frame waitfram
     1061   do:
     1062     mWaitFramStop = yes.
     1063     mWaitFramStopUser = yes.
     1064   end.
     1065   function waitfram-check-timeout returns logical():
     1066      define variable vtime as int64 no-undo.
     1067      if mWaitFramStopTimeOut
     1068      then
     1069         return yes.
     1070      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1071      if     mWaitFramTimeOut ne ?
     1072         and mWaitFramTimeOut ne 0
     1073         and mWaitFramTimeOut lt vtime
     1074      then do:
     1075         mWaitFramStopTimeOut = yes.
     1076      end.
     1077      return mWaitFramStopTimeOut.
     1078   end.
     1079   procedure waitfram-hide :
     1080     if not session:batch-mode
     1081     then do
     1082     on error undo, return error return-value
     1083     :
     1084       pause 0 before-hide .
     1085       if not mBatchMode then
     1086         hide frame waitfram .
     1087     if     not mWaitFramView
     1088        and mWaitProcEvent
     1089     then
     1090       process events .
     1091     end.
     1092   end procedure.
     1093   procedure waitfram-show :
     1094     define input  parameter p-message as character no-undo .
     1095     define variable v-left-margin as integer   no-undo .
     1096     if not session:batch-mode
     1097     then do
     1098     on error undo, return error return-value
     1099     :
     1100       if length(p-message) <= 70 then do:
     1101         assign
     1102           v-left-margin = integer((70 - length(p-message)) / 2)
     1103         .
     1104         assign
     1105           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1106         .
     1107         assign
     1108           v-waitfram-action01 = " "
     1109           v-waitfram-action02 = " "
     1110                                    + fill(" ", v-left-margin)
     1111                                    + p-message
     1112           v-waitfram-action03 = " "
     1113         .
     1114       end.
     1115       else do:
     1116         define variable vRindex1 as integer no-undo.
     1117         define variable vRindex2 as integer no-undo.
     1118         vRindex1 = r-index(p-message," ",70).
     1119         if vRindex1 = 0
     1120         then
     1121            vRindex1 = 70.
     1122         if length(p-message)  <= vRindex1 + 70 then do:
     1123           assign
     1124             v-waitfram-action01 = " "
     1125             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1126             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1127           .
     1128         end.
     1129         else do:
     1130           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1131           if vRindex2 <= vRindex1
     1132           then
     1133              vRindex2 = vRindex1 + 70.
     1134           assign
     1135             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1136             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1137             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1138           .
     1139         end.
     1140       end.
     1141       B-viewProcInfo:visible   in frame waitfram = no.
     1142       B-viewProcInfo:sensitive in frame waitfram = no.
     1143       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1144       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1145       if  (   mWaitFramView
     1146          or  mWaitProcEvent)
     1147          and not mBatchMode
     1148       then
     1149          display
     1150             v-waitfram-action01 skip
     1151             v-waitfram-action02 skip
     1152             v-waitfram-action03 skip
     1153          with frame waitfram .
     1154       if     mWaitFramView
     1155          then do:
     1156             if     mWaitFramInterval ne ?
     1157                and not mBatchMode
     1158             then
     1159                wait-for go of frame waitfram pause mWaitFramInterval.
     1160          end.
     1161          else
     1162             if     mWaitProcEvent
     1163                and not mBatchMode
     1164             then
     1165                process events .
     1166     end.
     1167   end procedure.
     1168      procedure waitfram-show-this:
     1169         define input  parameter iInterval as int64 no-undo.
     1170         define variable vtime as int64 no-undo.
     1171         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1172         mWaitFramInterval = iInterval.
     1173         run waitfram-show (substitute("&1&2 &3&4" ,
     1174                                       mWaitFramTextBeg ,
     1175                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1176                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1177                                       mWaitFramTextEnd
     1178                                      )
     1179                           ).
     1180      end.
     1181      procedure WaitFramRunPause:
     1182         define input  parameter iInterval as dec no-undo.
     1183         define variable vStart  as datetime-tz no-undo.
     1184         define variable vend    as datetime-tz no-undo.
     1185         define variable vint as int64 no-undo.
     1186         define variable vOk as logical no-undo.
     1187         vStart = now.
     1188         vend   = vStart.
     1189         publish "WaitFramPause" (iInterval,output vOk).
     1190         vend   =  now.
     1191         vint = vend - vStart.
     1192         vint = iInterval - vint / 1000.
     1193         if     not mWaitFramStop
     1194            and (   vint > 0
     1195                 or (    not vOk
     1196                     and iInterval eq ?
     1197                     )
     1198                 )
     1199         then
     1200            run waitfram-show-this (iInterval).
     1201         vend   =  now.
     1202         vint = vend - vStart.
     1203         vint = iInterval - vint / 1000.
     1204         if     not mWaitFramStop
     1205            and vint > 0
     1206         then do:
     1207            run gbl/pause.p (vint * 1000).
     1208         end.
     1209         if iInterval ne ?
     1210         then
     1211            publish "WaitFramStop".
     1212         waitfram-check-timeout().
     1213      end.
     1214      procedure WaitFramWaitFor:
     1215         define input  parameter iInterval as dec no-undo.
     1216         assign
     1217            mWaitFramStartProc   = now
     1218            mWaitFramStopUser    = no
     1219            mWaitFramStopTimeOut = no
     1220         .
     1221         block-wait:
     1222         do while not mWaitFramStop:
     1223            run WaitFramRunPause (iInterval).
     1224            if  waitfram-check-timeout()
     1225            then do:
     1226               leave block-wait.
     1227            end.
     1228         end.
     1229         run waitfram-hide.
     1230      end.
     1231   procedure waitfram-join :
     1232     define input  parameter p-line-1  as character no-undo .
     1233     define input  parameter p-line-2  as character no-undo .
     1234     define input  parameter p-line-3  as character no-undo .
     1235     define output parameter p-message as character no-undo .
     1236     do
     1237     on error undo, return error return-value
     1238     :
     1239       assign
     1240         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1241                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1242                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1243       .
     1244     end.
     1245   end procedure.
     1246   function waitfram-join-function returns character
     1247     (input p-line-1 as character
     1248     ,input p-line-2 as character
     1249     ,input p-line-3 as character
     1250     ).
     1251     define variable v-message as character no-undo .
     1252     run waitfram-join in this-procedure
     1253       (input  p-line-1
     1254       ,input  p-line-2
     1255       ,input  p-line-3
     1256       ,output v-message
     1257       ) .
     1258     return v-message .
     1259   end function .
     1260   define temp-table temp-font no-undo
     1261     field fontnum  as integer
     1262     field fontname as character
     1263     field fontsize as character
     1264     field fonttype as character
     1265     field font-h   as integer
     1266     field font-w   as integer
     1267     field v-row    as integer
     1268     field v-col    as integer
     1269     field v-row-lans as integer
     1270     field v-col-lans as integer
     1271   index pi fontnum
     1272   .
     1273   procedure get-font-ini :
     1274     do
     1275     on error undo, return error return-value
     1276     :
     1277   define variable ii as integer   no-undo .
     1278   define variable v-font7 as character no-undo .
     1279   define variable v-font as character no-undo .
     1280   define variable loc-name as character no-undo .
     1281   define variable loc-size as character no-undo .
     1282   define variable loc-type as character no-undo .
     1283   define variable old_H as integer   no-undo .
     1284   define variable old_w as integer   no-undo .
     1285   define variable old-row  as integer   no-undo .
     1286   define variable old-col  as integer   no-undo .
     1287   define variable old-row-lans  as integer   no-undo .
     1288   define variable old-col-lans  as integer   no-undo .
     1289   define variable vv as integer   no-undo .
     1290   empty temp-table temp-font.
     1291     GET-KEY-VALUE SECTION "fonts" KEY "font7" VALUE v-font7 .
     1292       case num-entries (v-font7) :
     1293         when 4 then do:
     1294             assign
     1295               loc-name = entry ( 1 , v-font7 )
     1296               loc-size = entry ( 2 , v-font7 )
     1297               loc-type = entry ( 3 , v-font7 ) + "," +  entry ( 4 , v-font7 )
     1298             .
     1299         end.
     1300         when 3 then do:
     1301             assign
     1302               loc-name = entry ( 1 , v-font7 )
     1303               loc-size = entry ( 2 , v-font7 )
     1304               loc-type = entry ( 3 , v-font7 )
     1305             .
     1306         end.
     1307         when 2 then  do:
     1308             assign
     1309               loc-name = entry ( 1 , v-font7 )
     1310               loc-size = entry ( 2 , v-font7 )
     1311               loc-type = ""
     1312             .
     1313         end.
     1314         when 1 then do:
     1315             assign
     1316               loc-name = trim(entry ( 1 , v-font7 ))
     1317               loc-size = ""
     1318               loc-type = ""
     1319             .
     1320         end.
     1321       end case.
     1322     create temp-font.
     1323     assign
     1324       temp-font.fontnum  = 7
     1325       temp-font.fontname = trim(loc-name)
     1326       temp-font.fontsize = trim(loc-size)
     1327       temp-font.fonttype = trim(loc-type)
     1328       temp-font.v-row    = 62
     1329       temp-font.v-col    = 136
     1330       temp-font.v-row-lans = 43
     1331       temp-font.v-col-lans = 198
     1332     .
     1333     repeat ii = 16 to 100 :
     1334       get-key-value section 'fonts' key 'font' + string(ii)   value v-font  .
     1335       if v-font = "" or v-font = ? then leave.
     1336       case num-entries (v-font) :
     1337         when 4 then do:
     1338             assign
     1339               loc-name = entry ( 1 , v-font )
     1340               loc-size = entry ( 2 , v-font )
     1341               loc-type = entry ( 3 , v-font ) + "," +  entry ( 4 , v-font )
     1342             .
     1343         end.
     1344         when 3 then do:
     1345             assign
     1346               loc-name = entry ( 1 , v-font )
     1347               loc-size = entry ( 2 , v-font )
     1348               loc-type = entry ( 3 , v-font )
     1349             .
     1350         end.
     1351         when 2 then do:
     1352             assign
     1353               loc-name = entry ( 1 , v-font )
     1354               loc-size = entry ( 2 , v-font )
     1355               loc-type = ""
     1356             .
     1357         end.
     1358         when 1 then do:
     1359             assign
     1360               loc-name = trim(entry ( 1 , v-font ))
     1361               loc-size = ""
     1362               loc-type = ""
     1363             .
     1364         end.
     1365       end case.
     1366     create temp-font.
     1367     assign
     1368       temp-font.fontnum  = ii
     1369       temp-font.fontname = trim(loc-name)
     1370       temp-font.fontsize = trim(loc-size)
     1371       temp-font.fonttype = trim(loc-type)
     1372     .
     1373     end.
     1374       for each temp-font :
     1375          vv = integer(entry(2,temp-font.fontsize, "=" )) no-error .
     1376          if  vv = ? then vv =  0 .
     1377           run rep/exfont.p (
     1378             input   temp-font.fontname ,
     1379             input   vv ,
     1380             input   temp-font.fonttype ,
     1381             output  temp-font.font-h   ,
     1382             output  temp-font.font-w   )
     1383           .
     1384       end.
     1385   find first temp-font where  temp-font.fontnum  = 7  .
     1386   old_H = temp-font.font-H .
     1387   old_w = temp-font.font-W .
     1388   old-row = temp-font.v-row .
     1389   old-col = temp-font.v-col .
     1390   old-row-lans = temp-font.v-row-lans .
     1391   old-col-lans = temp-font.v-col-lans .
     1392       for each temp-font where
     1393                temp-font.fontnum  <> 7 :
     1394           assign
     1395               temp-font.v-row    = old_H * old-row / temp-font.font-h
     1396               temp-font.v-col    = old_W * old-col / temp-font.font-W
     1397               temp-font.v-row-lans    = old_H * old-row-lans / temp-font.font-h
     1398               temp-font.v-col-lans    = old_W * old-col-lans / temp-font.font-W
     1399           .
     1400       end.
     1401     end.
     1402   end procedure.
     1403   PROCEDURE How-name :
     1404   define input  parameter h as integer no-undo .
     1405   define input  parameter w as integer no-undo .
     1406   define output parameter n as character  no-undo .
     1407   define variable A4port-H as integer   no-undo init 63.
     1408   define variable A4port-W as integer   no-undo init 136.
     1409   define variable A4lans-H as integer   no-undo init 43.
     1410   define variable A4lans-W as integer   no-undo init 198.
     1411   define variable Strim-W  as integer   no-undo init 278.
     1412   run define-a4-size (
     1413        input ReportFontNum
     1414       ,output A4port-H
     1415       ,output A4port-W
     1416       ,output A4lans-H
     1417       ,output A4lans-W ).
     1418   If w >= 1 and w <= A4port-W Then DO:
     1419     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     1420     If h > A4lans-H  and h <= A4port-H Then n = "A4-port":U.
     1421     If h > A4port-H              Then n = "to-file":U.
     1422   End.
     1423   If w > A4port-W and w <= A4lans-W Then DO:
     1424     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     1425     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     1426     If h > A4port-H              Then n = "to-file":U.
     1427   End.
     1428   If w > A4lans-W and w <= Strim-W Then DO:
     1429     If h >= 1  and h <= A4lans-H Then n = "to-file":U.
     1430     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     1431     If h > A4port-H              Then n = "to-file":U.
     1432   End.
     1433   If w > Strim-W Then DO:
     1434      n = "to-file":U.
     1435   End.
     1436   END PROCEDURE.
     1437   PROCEDURE define-a4-size :
     1438   define input  parameter p-ReportFontNum as integer   no-undo .
     1439   define output parameter A4port-H as integer   no-undo .
     1440   define output parameter A4port-W as integer   no-undo .
     1441   define output parameter A4lans-H as integer   no-undo .
     1442   define output parameter A4lans-W as integer   no-undo .
     1443   if not can-find (first temp-font ) then do:
     1444      run get-font-ini .
     1445   end.
     1446   find first temp-font where temp-font.fontnum = p-ReportFontNum no-error .
     1447   if available temp-font then do:
     1448   assign
     1449     A4port-H = temp-font.v-row
     1450     A4port-W = temp-font.v-col
     1451     A4lans-H = temp-font.v-row-lans
     1452     A4lans-W = temp-font.v-col-lans
     1453   .
     1454   end.
     1455   else do:
     1456   assign
     1457     A4port-H = 63
     1458     A4port-W = 136
     1459     A4lans-H = 43
     1460     A4lans-W = 198
     1461   .
     1462   end.
     1463   END PROCEDURE.
     1464   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1465     define variable v-cntxt-db-num        as integer   no-undo .
     1466     define variable v-cntxt-userid        as character no-undo .
     1467     define variable v-cntxt-level         as character no-undo .
     1468     define variable v-cntxt-host-code-obj as integer   no-undo .
     1469     define variable v-cntxt-obj-type      as character no-undo .
     1470     define variable v-cntxt-obj-code      as integer   no-undo .
     1471     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1472     define variable v-cntxt-is-admin      as logical   no-undo .
     1473   define shared temp-table g#post-f no-undo
     1474       field obj-type  like ub.clients.obj-type
     1475       field obj-code  like ub.clients.obj-code
     1476       field obj-name  like ub.clients.obj-name
     1477       field grp-code  like ub.clients.grp-code
     1478       field grp-name  like ub.clients.grp-name
     1479       field lvl-num   like ub.cli-grp.lvl-num
     1480       field host-code like ub.clients.host-code
     1481   index pi is unique primary obj-type obj-code
     1482   index p1  obj-name
     1483   index hc host-code
     1484   .
     1485   define temp-table tt-report-pay-sum no-undo
     1486       field obj-type              like ub.clients.obj-type
     1487       field obj-code              like ub.clients.obj-code
     1488       field obj-name              like ub.clients.obj-name
     1489       field pay-sum               as decimal
     1490   index pi is primary unique obj-type obj-code
     1491   index p1 obj-name.
     1492   define temp-table tt-report no-undo
     1493       field obj-type              like ub.clients.obj-type
     1494       field obj-code              like ub.clients.obj-code
     1495       field talon-name            as character
     1496       field wth-code              like ub.wth-gds.wth-code
     1497       field par-code              like ub.wth-par.par-code
     1498       field par-val               like ub.wth-par.par-val
     1499       field gds-code              like ub.wth-gds.gds-code
     1500       field talon-give-money-sum  as decimal
     1501       field talon-give-units-sum  as decimal
     1502       field fuel-sell-money-sum   as decimal
     1503       field fuel-sell-units-sum   as decimal
     1504   index pi is primary unique obj-type obj-code gds-code wth-code par-code
     1505   index p1 talon-name.
     1506   define stream out-stream.
