      997       HEADER
      998           cur-time-print() AT 5 format "X(35)"
      999           string( "Отчет о продажах: ") AT 45 format "X(40)"
     1000           string( "Страница " + string( PAGE-NUMBER( PrnLibStream ), ">>9" ) ) AT 150 format "X(13)" SKIP
     1001           Line format "X(195)" AT 1
     1002       with width 232 down stream-io.
     1003   if session:set-wait-state("COMPILER") then.
     1004   assign Line = fill("-", 195).
     1005   DEFINE BUTTON b-date
     1006        LABEL "Сбор данных"
     1007        SIZE 15.38 BY 1.08.
     1008   DEFINE BUTTON b-exit AUTO-END-KEY
     1009        LABEL "Выход"
     1010        SIZE 9.5 BY 1.13
     1011        BGCOLOR 8 .
     1012   DEFINE BUTTON b-help
     1013        LABEL "&Помощь"
     1014        SIZE 10.25 BY 1.13
     1015        BGCOLOR 8 .
     1016   DEFINE BUTTON b-print
     1017        LABEL "Печать"
     1018        SIZE 15.13 BY 1.08.
     1019   DEFINE BUTTON r-gds-grp
     1020        IMAGE-UP FILE "btn-down-arrow"
     1021        IMAGE-DOWN FILE "btn-down-arrow"
     1022        IMAGE-INSENSITIVE FILE "btn-down-arrow"
     1023        SIZE 3.13 BY .96.
     1024   DEFINE VARIABLE vargrp-name AS CHARACTER
     1025        VIEW-AS EDITOR SCROLLBAR-VERTICAL
     1026        SIZE 55.38 BY 2.75 NO-UNDO.
     1027   DEFINE VARIABLE end-date AS DATE FORMAT "99/99/99":U
     1028        LABEL "По"
     1029        VIEW-AS FILL-IN
     1030        SIZE 14.13 BY 1.08 NO-UNDO.
     1031   DEFINE VARIABLE start-date AS DATE FORMAT "99/99/99":U
     1032        LABEL "С"
     1033        VIEW-AS FILL-IN
     1034        SIZE 14.13 BY 1.08 NO-UNDO.
     1035   DEFINE VARIABLE rb-gds-grp AS INTEGER
     1036        VIEW-AS RADIO-SET HORIZONTAL
     1037        RADIO-BUTTONS
     1038        "По всему классификатору", 1,
     1039        "Выборочно", 2
     1040        SIZE 54.88 BY .96 NO-UNDO.
     1041   DEFINE FRAME Dialog-Frame
     1042        b-exit AT ROW 1.17 COL 1.75
     1043        b-help AT ROW 1.17 COL 13.38
     1044        start-date AT ROW 2.67 COL 2.25
     1045        end-date AT ROW 2.67 COL 22.13
     1046        b-date AT ROW 2.67 COL 42.13
     1047        rb-gds-grp AT ROW 4 COL 2.38 NO-LABEL
     1048        b-print AT ROW 5.25 COL 42.25
     1049        r-gds-grp AT ROW 5.38 COL 37.13
     1050        vargrp-name AT ROW 6.58 COL 1.63 NO-LABEL
     1051        "   Уровень классификатора" VIEW-AS TEXT
     1052             SIZE 28.13 BY 1.08 AT ROW 5.29 COL 1.88
     1053        SPACE(27.98) SKIP(3.29)
     1054       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1055            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1056            TITLE "Отчет о продажах"
     1057            DEFAULT-BUTTON b-exit.
     1058   ASSIGN
     1059          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1060          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1061   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1062   DO:
     1063     APPLY "END-ERROR":U TO SELF.
     1064   END.
     1065   ON CHOOSE OF b-date IN FRAME Dialog-Frame
     1066   DO:
     1067     for each tt-doc-line:
     1068         delete tt-doc-line.
     1069     end.
     1070     RUN calc-sale
     1071     (INPUT p-curr-obj-type,
     1072      INPUT p-curr-obj-code,
     1073      INPUT input frame Dialog-Frame start-date,
     1074      INPUT input frame Dialog-Frame end-date)
     1075     .
     1076     message "Сбор данных завершен" view-as alert-box.
     1077   END.
     1078   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1079   on help of frame Dialog-Frame
     1080   do:
     1081     run gbl/app_help.p
     1082       (input this-procedure :file-name
     1083       ,input ''
     1084       ,input ?
     1085       ) no-error.
     1086     if error-status :error then do:
     1087       message
     1088         "Ошибка при вызове помощи"
     1089         error-status :get-message(1)
     1090         view-as alert-box .
     1091     end.
     1092   end.
     1093   run minbtn-set in this-procedure .
     1094   on choose of b-help in frame Dialog-Frame
     1095   do:
     1096     apply "help":u to frame Dialog-Frame .
     1097   end.
     1098   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1099   procedure minbtn-set :
     1100       do
     1101           on error undo, return error return-value
     1102           :
     1103           define variable ii              as integer       no-undo .
     1104           define variable fh              as widget-handle no-undo .
     1105           define variable hh              as widget-handle no-undo .
     1106           define variable v-h             as handle        extent 4 no-undo .
     1107           define variable v-name-button   as character     no-undo .
     1108           define variable v-help-old-x    as decimal       no-undo .
     1109           define variable v-help-old-y    as decimal       no-undo .
     1110           define variable v-help-old-size as decimal       no-undo .
     1111           define variable v-frame-width   as decimal       no-undo .
     1112           define variable jj              as integer       no-undo .
     1113           do
     1114               on error undo, return error
     1115               :
     1116               assign
     1117                   v-frame-width = frame Dialog-Frame:width - 0.3
     1118                   fh            = frame Dialog-Frame:first-child
     1119                   hh            = fh:first-child
     1120                   ii            = 1
     1121                   .
     1122               do while valid-handle(hh):
     1123                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1124                   do:
     1125                       case lc(hh:name) :
     1126                           when "b-help" then
     1127                               do:
     1128                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1129                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1130                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1131                                   hh:TOOLTIP = "Помощь" .
     1132                                   v-help-old-x = hh:column .
     1133                                   v-help-old-y = hh:row    .
     1134                                   v-help-old-size = hh:width .
     1135                                   hh:width-chars = 2.5 .
     1136                               end.
     1137                           when "b-print" then
     1138                               do:
     1139                                   hh:load-image("cmp/b-print.bmp":u) .
     1140                                   hh:TOOLTIP = "Печать" .
     1141                                   v-h[ii] = hh:handle .
     1142                                   ii = ii + 1 .
     1143                                   hh:width-chars = 3 .
     1144                               end.
     1145                           when "b-history" or
     1146                           when "b-hist" then
     1147                               do:
     1148                                   hh:load-image("cmp/b-hist.bmp":u) .
     1149                                   hh:TOOLTIP = "История" .
     1150                                   v-h[ii] = hh:handle .
     1151                                   ii = ii + 1 .
     1152                                   hh:width-chars = 3 .
     1153                               end.
     1154                           when "b-sch" then
     1155                               do:
     1156                                   hh:load-image("cmp/b-sch.bmp":u) .
     1157                                   hh:TOOLTIP = "Установка Фильтра" .
     1158                                   v-h[ii] = hh:handle .
     1159                                   ii = ii + 1 .
     1160                                   hh:width-chars = 3 .
     1161                               end.
     1162                           when "b-hist-user" then
     1163                               do:
     1164                                   hh:load-image("cmp/b-hist.bmp":u) .
     1165                                   hh:TOOLTIP = "История пользователя" .
     1166                                   ii = ii + 1 .
     1167                               end.
     1168                       end case.
     1169                   end.
     1170                   hh = hh:next-sibling.
     1171               end.
     1172               b-help:column = v-frame-width - b-help:width-chars.
     1173               jj = 0.
     1174               repeat ii = 4 to 1 by -1 :
     1175                   if valid-handle (v-h[ii] ) then
     1176                   do:
     1177                       jj  = jj + 1 .
     1178                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1179                       v-h[ii]:row    = v-help-old-y .
     1180                   end.
     1181               end.
     1182           end.
     1183       end.
     1184   end procedure.
     1185   ON CHOOSE OF b-print IN FRAME Dialog-Frame
     1186   DO:
     1187   run prn-lib-open-stream  in this-procedure (
     1188                                                input parParentProc
     1189                                               ,input 43
     1190                                               ,input yes
     1191                                               ,input no
     1192                                               ).
     1193   FORM with FRAME gds-grp.
     1194   FORM HEADER
     1195       Line format "X(195)" AT 1 SKIP
     1196       "Продолжение - на следующей странице" AT 60 SKIP
     1197       with FRAME BottomFrame width 232
     1198       PAGE-BOTTOM no-labels no-box.
     1199   VIEW STREAM PrnLibStream FRAME BottomFrame .
     1200   PUT STREAM PrnLibStream
     1201       string( "Отчет за период с: " + string(input frame Dialog-Frame start-date,"99/99/9999") + " по: " + string(input frame Dialog-Frame end-date,"99/99/9999"))
     1202       AT 37 format "X(195)" SKIP(1).
     1203     assign varroot = vargds-grp.
     1204     RUN calc-gds-grp (input  1,
     1205                       input  vargds-grp,
     1206                       input  " ",
     1207                       output varsum-vat-acc,
     1208                       output varsum-vat-sale,
     1209                       output varsum-acc-out-vat,
     1210                       output varsum-sale-out-vat,
     1211                       output varsum-sale,
     1212                       output varsum-road-tax,
     1213                       output varsum-qnty).
     1214   HIDE STREAM PrnLibStream FRAME BottomFrame .
     1215   OUTPUT STREAM PrnLibStream CLOSE.
     1216   if session:set-wait-state("") then.
     1217   run prn-lib-prn-file in this-procedure (
     1218                                             input parParentProc
     1219                                             ,input 8
     1220                                             ).
     1221   END.
     1222   ON CHOOSE OF r-gds-grp IN FRAME Dialog-Frame
     1223   DO:
     1224     define variable ref-list as character no-undo.
     1225     run ref/gds-grp.w (
     1226                     input parparentproc
     1227                    ,input "b-sel"
     1228                    ,input p-curr-obj-type
     1229                    ,input p-curr-obj-code
     1230                    ,input-output ref-list).
     1231     IF REF-LIST <>  "":U then do:
     1232       find first gds-grp where RECID(gds-grp) = integer(ref-list) no-lock.
     1233       ASSIGN vargrp-name:SCREEN-VALUE in frame Dialog-Frame = gds-grp.node-name
     1234             vargds-grp = gds-grp.node-code.
     1235     end.
     1236     else do:
     1237       return no-apply.
     1238     end.
     1239   END.
     1240   ON VALUE-CHANGED OF rb-gds-grp IN FRAME Dialog-Frame
     1241   DO:
     1242     if input frame Dialog-Frame rb-gds-grp = 1 then do:
     1243       find first gds-grp where gds-grp.upper-code = 0 no-lock.
     1244       vargds-grp = gds-grp.node-code.
     1245        ASSIGN vargrp-name:SCREEN-VALUE in frame Dialog-Frame = " "
     1246               r-gds-grp:SENSITIVE      = no.
     1247     end.
     1248     else do:
     1249          assign r-gds-grp:SENSITIVE      = yes.
     1250          apply "choose" to r-gds-grp in frame Dialog-Frame.
     1251          return no-apply.
     1252     end.
     1253   END.
     1254   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1255   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1256   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1257   on ' ' of start-date in frame Dialog-Frame
     1258   do:
     1259     if (can-query (self, "sensitive")
     1260        and
     1261        self :sensitive = true
     1262        )
     1263     or (can-query (self, "read-only")
     1264        and
     1265        self :read-only = false
     1266        )
     1267     then do:
     1268       assign
     1269         self :screen-value = ?
     1270       .
     1271     end.
     1272     return no-apply.
     1273   end.
     1274   on delete-character of start-date in frame Dialog-Frame
     1275   do:
     1276     if (can-query (self, "sensitive")
     1277        and
     1278        self :sensitive = true
     1279        )
     1280     or (can-query (self, "read-only")
     1281        and
     1282        self :read-only = false
     1283        )
     1284     then do:
     1285       assign
     1286         self :screen-value = ?
     1287       .
     1288     end.
     1289     return no-apply.
     1290   end.
     1291   on ctrl-d of start-date in frame Dialog-Frame
     1292   do:
     1293     define variable v-curr-sv-date as date no-undo .
     1294     if (can-query (self, "sensitive")
     1295        and
     1296        self :sensitive = true
     1297        )
     1298     or (can-query (self, "read-only")
     1299        and
     1300        self :read-only = false
     1301        )
     1302     then do:
     1303       if self :handle <> focus :handle
     1304       then do:
     1305         apply "entry":u to self .
     1306       end.
     1307       run gbl/getcurdt.p
     1308         (output v-curr-sv-date
     1309         ) .
     1310       assign
     1311         self :screen-value = string(v-curr-sv-date) .
     1312       .
     1313     end.
     1314     return no-apply.
     1315   end.
     1316   on ctrl-b of start-date in frame Dialog-Frame
     1317   do:
     1318     if (can-query (self, "sensitive")
     1319        and
     1320        self :sensitive = true
     1321        )
     1322     or (can-query (self, "read-only")
     1323        and
     1324        self :read-only = false
     1325        )
     1326     then do:
     1327       if self :handle <> focus :handle
     1328       then do:
     1329         apply "entry":u to self .
     1330       end.
     1331       define variable v-curr-sv-date as date no-undo .
     1332       define variable v-new-sv-date  as date no-undo .
     1333       assign
     1334         v-curr-sv-date = date(self :screen-value) no-error
     1335       .
     1336       if v-curr-sv-date = ?
     1337       then do:
     1338         run gbl/getcurdt.p
     1339           (output v-curr-sv-date
     1340           ) .
     1341       end.
     1342       if v-curr-sv-date <> ?
     1343       then do:
     1344         assign
     1345           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     1346         .
     1347         assign
     1348           self :screen-value = string(v-new-sv-date) .
     1349         .
     1350       end.
     1351     end.
     1352     return no-apply .
     1353   end.
     1354   on ctrl-e of start-date in frame Dialog-Frame
     1355   do:
     1356     if (can-query (self, "sensitive")
     1357        and
     1358        self :sensitive = true
     1359        )
     1360     or (can-query (self, "read-only")
     1361        and
     1362        self :read-only = false
     1363        )
     1364     then do:
     1365       if self :handle <> focus :handle
     1366       then do:
     1367         apply "entry":u to self .
     1368       end.
     1369       define variable v-curr-sv-date as date no-undo .
     1370       define variable v-new-sv-date  as date no-undo .
     1371       assign
     1372         v-curr-sv-date = date(self :screen-value) no-error
     1373       .
     1374       if v-curr-sv-date = ?
     1375       then do:
     1376         run gbl/getcurdt.p
     1377           (output v-curr-sv-date
     1378           ) .
     1379       end.
     1380       if v-curr-sv-date <> ?
     1381       then do:
     1382         run gbl/lastdate.p
     1383           (input  v-curr-sv-date
     1384           ,output v-new-sv-date
     1385           ).
     1386         assign
     1387           self :screen-value = string(v-new-sv-date) .
     1388         .
     1389       end.
     1390     end.
     1391     return no-apply .
     1392   end.
     1393   on ctrl-f of start-date in frame Dialog-Frame
     1394   do:
     1395     if (can-query (self, "sensitive")
     1396        and
     1397        self :sensitive = true
     1398        )
     1399     or (can-query (self, "read-only")
     1400        and
     1401        self :read-only = false
     1402        )
     1403     then do:
     1404       if self :handle <> focus :handle
     1405       then do:
     1406         apply "entry":u to self .
     1407       end.
     1408       define variable v-ok            as logical   no-undo .
     1409       define variable v-curr-sv-date  as date      no-undo .
     1410       define variable v-description   as character no-undo .
     1411       assign
     1412         v-curr-sv-date = date(self :screen-value) no-error
     1413       .
     1414       if v-curr-sv-date = ?
     1415       then do:
     1416         run gbl/getcurdt.p
     1417           (output v-curr-sv-date
     1418           ) .
     1419       end.
     1420       if v-curr-sv-date <> ?
     1421       then do:
     1422         run gbl/d-inpday.w
     1423           (input ?
     1424           ,input "Выбор даты"
     1425           ,input v-description
     1426           ,input ""
     1427           ,input-output v-curr-sv-date
     1428           ,output v-ok
     1429           ).
     1430         if v-ok = true
     1431         then do:
     1432           assign
     1433             self :screen-value = string(v-curr-sv-date) .
     1434           .
     1435         end.
     1436       end.
     1437     end.
     1438     return no-apply .
     1439   end.
     1440     define MENU m-ed-date8
