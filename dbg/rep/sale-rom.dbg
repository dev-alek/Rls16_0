      978         sym8                          column-label ":!:" format "X(1)" space(0)
      979         tt-doc-line.sum-vat-acc       COLUMN-LABEL "Сумма!НДС" format ">>>>>>>9.99" space(0)
      980         sym9                          column-label ":!:" format "X(1)"         space(0)
      981         tt-doc-line.price-acc         COLUMN-LABEL "Уч. цена! с НДС" format ">>>>9.99" space(0)
      982         sym10                         column-label ":!:" format "X(1)" space(0)
      983         tt-doc-line.increase          COLUMN-LABEL "Наценка" format "->>>>>9.99" space(0)
