     2260          varsum-rubl-docovp  = varsum-rubl-docovp  + (out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl)                 * out-vatp_gds-dtl.doc-qnty
     2261          varslt-rubl-docovp  = varslt-rubl-docovp  + (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc)                   * out-vatp_gds-dtl.doc-qnty
     2262          varvat-rubl-docovp  = varvat-rubl-docovp  + (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-rubl-sale) * doc-line.vat-pc / (100 + doc-line.vat-pc)                   * out-vatp_gds-dtl.doc-qnty
     2263          varvatcons-rubl-docovp  = varvatcons-rubl-docovp  + (((out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * doc-line.cons-vat-pc / (100 + doc-line.cons-vat-pc) * out-vatp_gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-rubl-sale) * doc-line.vat-pc / (100 + doc-line.vat-pc) * out-vatp_gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty)
     2264          vardsc-rubl-docovp  = vardsc-rubl-docovp  + out-vatp_gds-dtl.discnt-rubl * out-vatp_gds-dtl.doc-qnty   .
     2265       end.
     2266       if trn-doc.doc-type = 'инв':U then do:
     2267         ASSIGN
     2268                   price-base-with-tax-sale    = varsum-base-docovp / varfact-qnty
     2269           slt-base-sale               = varslt-base-docovp / varfact-qnty
     2270           vat-base-buyer              = varvat-base-docovp / varfact-qnty
     2271           discnt-base-sale            = vardsc-base-docovp / varfact-qnty
     2272           vat-base-sale               = varvatcons-base-docovp / varfact-qnty
     2273                   price-rubl-with-tax-sale    = varsum-rubl-docovp / varfact-qnty
     2274           slt-rubl-sale               = varslt-rubl-docovp / varfact-qnty
     2275           vat-rubl-buyer              = varvat-rubl-docovp / varfact-qnty
     2276           discnt-rubl-sale            = vardsc-rubl-docovp / varfact-qnty
     2277           vat-rubl-sale               = varvatcons-rubl-docovp / varfact-qnty.
     2278       end.
     2279       else do:
     2280         ASSIGN
     2281                   price-base-with-tax-sale    = varsum-base-factovp / varfact-qnty
     2282           slt-base-sale               = varslt-base-factovp / varfact-qnty
     2283           vat-base-buyer              = varvat-base-factovp / varfact-qnty
     2284           discnt-base-sale            = vardsc-base-factovp / varfact-qnty
     2285           vat-base-sale               = varvatcons-base-factovp / varfact-qnty
     2286                   price-rubl-with-tax-sale    = varsum-rubl-factovp / varfact-qnty
     2287           slt-rubl-sale               = varslt-rubl-factovp / varfact-qnty
     2288           vat-rubl-buyer              = varvat-rubl-factovp / varfact-qnty
     2289           discnt-rubl-sale            = vardsc-rubl-factovp / varfact-qnty
     2290           vat-rubl-sale               = varvatcons-rubl-factovp / varfact-qnty.
     2291       end.
     2292     end.
     2293   end.
     2294   assign
     2295     price-base-without-tax-sale = price-base-with-tax-sale - vat-base-sale - slt-base-sale - road-tax-base-sale
     2296     price-rubl-without-tax-sale = price-rubl-with-tax-sale - vat-rubl-sale - slt-rubl-sale - road-tax-rubl-sale.
     2297                                                                                        ~
     2298   end procedure.
     2299   procedure cr-tt-doc-line:
     2300   find first tt-doc-line where tt-doc-line.artic     = doc-line.artic     and
     2301                                tt-doc-line.prod-type = doc-line.prod-type and
     2302                                tt-doc-line.prod-code = doc-line.prod-code no-error.
     2303   if not available tt-doc-line then do:
     2304        create tt-doc-line.
     2305        ASSIGN tt-doc-line.artic             =  doc-line.artic
     2306               tt-doc-line.prod-type         =  doc-line.prod-type
     2307               tt-doc-line.prod-code         =  doc-line.prod-code
     2308               tt-doc-line.gds-type          =  goods.gds-type
     2309               tt-doc-line.grp-code          =  goods.grp-code
     2310               tt-doc-line.gds-name          =  goods.gds-name
     2311               tt-doc-line.gds-unit-base     =  goods.unit-base.
     2312   end.
     2313   end procedure.
     2314   procedure as1-tt-doc-line:
     2315   ASSIGN    tt-doc-line.vat-acc            = tt-doc-line.vat-acc          + doc-line.fact-qnty * vat-pc-loc
     2316             tt-doc-line.vat-sale           = tt-doc-line.vat-sale         + doc-line.fact-qnty * doc-line.vat-pc
     2317             tt-doc-line.sum-road-tax       = tt-doc-line.sum-road-tax     + doc-line.fact-qnty * road-tax-rubl-sale
     2318             tt-doc-line.qnty               = tt-doc-line.qnty             + doc-line.fact-qnty
     2319             tt-doc-line.sum-vat-acc        = tt-doc-line.sum-vat-acc      + doc-line.fact-qnty * vat-rubl-loc
     2320             tt-doc-line.sum-vat-sale       = tt-doc-line.sum-vat-sale     + doc-line.fact-qnty * vat-rubl-sale
     2321             tt-doc-line.sum-acc            = tt-doc-line.sum-acc          + doc-line.fact-qnty * price-rubl-with-tax-loc
     2322             tt-doc-line.sum-sale           = tt-doc-line.sum-sale         + doc-line.fact-qnty * price-rubl-with-tax-sale.
     2323   end procedure.
     2324   procedure as2-tt-doc-line :
     2325   ASSIGN    tt-doc-line.vat-acc            = tt-doc-line.vat-acc          + doc-line.fact-qnty * vat-pc-loc
     2326             tt-doc-line.vat-sale           = tt-doc-line.vat-sale         + doc-line.fact-qnty * doc-line.vat-pc
     2327             tt-doc-line.sum-road-tax       = tt-doc-line.sum-road-tax     + doc-line.fact-qnty * road-tax-base-sale
     2328             tt-doc-line.qnty               = tt-doc-line.qnty             + doc-line.fact-qnty
     2329             tt-doc-line.sum-vat-acc        = tt-doc-line.sum-vat-acc      + doc-line.fact-qnty * vat-base-loc
     2330             tt-doc-line.sum-vat-sale       = tt-doc-line.sum-vat-sale     + doc-line.fact-qnty * vat-base-sale
     2331             tt-doc-line.sum-acc            = tt-doc-line.sum-acc          + doc-line.fact-qnty * price-base-with-tax-loc
     2332             tt-doc-line.sum-sale           = tt-doc-line.sum-sale         + doc-line.fact-qnty * price-base-with-tax-sale.
     2333   end procedure.
     2334   procedure as3-tt-doc-line:
     2335   for each tt-doc-line:
     2336      ASSIGN
     2337      tt-doc-line.sum-acc-out-vat    = tt-doc-line.sum-acc            - tt-doc-line.sum-vat-acc
     2338      tt-doc-line.sum-sale-out-vat   = tt-doc-line.sum-sale           - tt-doc-line.sum-vat-sale
     2339      tt-doc-line.increase           = tt-doc-line.sum-sale-out-vat   - tt-doc-line.sum-road-tax
     2340      tt-doc-line.vat-acc            = tt-doc-line.vat-acc            / tt-doc-line.qnty
     2341      tt-doc-line.vat-sale           = tt-doc-line.vat-sale           / tt-doc-line.qnty
     2342      tt-doc-line.road-tax           = tt-doc-line.sum-road-tax       / tt-doc-line.qnty
     2343      tt-doc-line.price-acc          = tt-doc-line.sum-acc            / tt-doc-line.qnty
     2344      tt-doc-line.price-acc-out-vat  = tt-doc-line.sum-acc-out-vat    / tt-doc-line.qnty
     2345      tt-doc-line.price-sale         = tt-doc-line.sum-sale           / tt-doc-line.qnty
     2346      tt-doc-line.price-sale-out-vat = tt-doc-line.sum-sale-out-vat   / tt-doc-line.qnty
     2347      .
     2348   end.
     2349   end procedure.
     2350   PROCEDURE disable_UI :
     2351     HIDE FRAME Dialog-Frame.
     2352   END PROCEDURE.
     2353   PROCEDURE enable_UI :
     2354     DISPLAY start-date end-date rb-gds-grp vargrp-name
     2355         WITH FRAME Dialog-Frame.
     2356     ENABLE b-exit b-help start-date end-date b-date rb-gds-grp b-print
     2357         WITH FRAME Dialog-Frame.
     2358     VIEW FRAME Dialog-Frame.
     2359   END PROCEDURE.
     2360   PROCEDURE disp-tt-doc-line:
     2361       display stream PrnLibStream
     2362              sym1
     2363              tt-doc-line.gds-type
     2364              sym2
     2365              tt-doc-line.artic
     2366              sym3
     2367              tt-doc-line.gds-name
     2368              sym4
     2369              tt-doc-line.vat-acc
     2370              sym5
     2371              tt-doc-line.road-tax
     2372              sym6
     2373              tt-doc-line.qnty
     2374              sym7
     2375              tt-doc-line.price-acc-out-vat
     2376              sym8
     2377              tt-doc-line.sum-vat-acc
     2378              sym9
     2379              tt-doc-line.price-acc
     2380              sym10
     2381              tt-doc-line.increase
     2382              sym11
     2383              tt-doc-line.vat-sale
     2384              sym12
     2385              tt-doc-line.sum-vat-sale
     2386              sym13
     2387              tt-doc-line.price-sale
     2388              sym14
     2389              tt-doc-line.sum-acc-out-vat
     2390              sym15
     2391              tt-doc-line.sum-sale-out-vat
     2392              sym16
     2393              tt-doc-line.sum-sale
     2394              sym17
     2395              with frame gds-grp.
     2396   DOWN STREAM PrnLibStream 1 with FRAME gds-grp.
     2397              PUT STREAM PrnLibStream Line format "X(195)" SKIP.
     2398   END PROCEDURE.
     2399   PROCEDURE disp-total:
     2400   define input parameter pardispgrp-name         as   character           no-undo.
     2401   define input parameter pardispsum-vat-acc      like doc-line.price-rubl no-undo.
     2402   define input parameter pardispsum-vat-sale     like doc-line.price-rubl no-undo.
     2403   define input parameter pardispsum-acc-out-vat  like doc-line.price-rubl no-undo.
     2404   define input parameter pardispsum-sale-out-vat like doc-line.price-rubl no-undo.
     2405   define input parameter pardispsum-sale         like doc-line.price-rubl no-undo.
     2406   define input parameter pardispsum-road-tax     like doc-line.price-rubl no-undo.
     2407   define input parameter pardispsum-qnty         like doc-line.fact-qnty  no-undo.
     2408   display stream PrnLibStream
     2409   sym1
     2410   ">" @ tt-doc-line.gds-type
     2411   sym2
     2412   "Итого " @ tt-doc-line.artic
     2413   sym3
     2414   pardispgrp-name @ tt-doc-line.gds-name
     2415   sym4
     2416   sym5
     2417   sym6
     2418   sym7
     2419   sym8
     2420   pardispsum-vat-acc        @ tt-doc-line.sum-vat-acc
     2421   sym9
     2422   sym10
     2423   sym11
     2424   sym12
     2425   pardispsum-vat-sale       @ tt-doc-line.sum-vat-sale
     2426   sym13
     2427   sym14
     2428   pardispsum-acc-out-vat    @ tt-doc-line.sum-acc-out-vat
     2429   sym15
     2430   pardispsum-sale-out-vat   @ tt-doc-line.sum-sale-out-vat
     2431   sym16
     2432   pardispsum-sale           @ tt-doc-line.sum-sale
     2433   sym17
     2434   with frame gds-grp.
     2435   DOWN STREAM PrnLibStream 1 with FRAME gds-grp.
     2436              PUT STREAM PrnLibStream Line format "X(195)" SKIP.
     2437   END PROCEDURE.
     2438   procedure disp-grp-name:
     2439   define input parameter pargrp-name like goods.grp-name no-undo.
     2440   end procedure.
