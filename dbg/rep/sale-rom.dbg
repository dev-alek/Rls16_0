      444         ).
      445   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      446   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      447     (input  v-report-name
      448     ,input  2
      449     ,output v-exist
      450     )  .
      451       if NOT v-exist then
      452       DO:
      453         Message
      454           "Нет заданий на печать ! "
      455           view-as alert-box .
      456         Return  .
      457       End.
      458       run gbl/prnfilen.w
      459         (input  ""
      460         ,input  p-DisabledOptions
      461         ,input  string(v-report-name )
      462         ,input  7
      463         ,output v-user-action
      464         ,output v-printed
      465         ) .
      466       if v-printed then
      467       do:
      468         return "YES" .
      469       end.
      470       else
      471       do:
      472         return "NO" .
      473       end.
      474     end.
      475   end procedure.
      476   procedure prn-lib-open-stream :
      477     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      478     define input parameter p-page-size    as integer no-undo .
      479     define input parameter p-is-stream    as logical no-undo .
      480     define input parameter p-append       as logical no-undo .
      481     define variable v-report-name as character no-undo .
      482     do
      483       on error undo, return error
      484       :
      485       run prn-lib-get-report-name  in this-procedure (
      486         input parParentProc
      487         ,output v-report-name
      488         ).
      489       if p-is-stream then
      490       do:
      491         if p-append then
      492         do:
      493           output stream PrnLibStream to value( v-report-name )
      494             page-size value(p-page-size) append .
      495         end.
      496         if not p-append then
      497         do:
      498           output stream PrnLibStream to value( v-report-name )
      499             page-size value(p-page-size) .
      500         end.
      501       end.
      502       if not p-is-stream then
      503       do:
      504         if p-append then
      505         do:
      506           output to value( v-report-name )
      507             page-size value(p-page-size) append .
      508         end.
      509         if not p-append then
      510         do:
      511           output to value( v-report-name )
      512             page-size value(p-page-size) .
      513         end.
      514       end.
      515     end.
      516   end procedure.
      517   procedure prn-lib-open-exp :
      518     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      519     define input parameter p-is-stream    as logical no-undo .
      520     define input parameter p-is-append    as logical no-undo .
      521     define output parameter p-ReportFileName as char init "report" no-undo.
      522     define output parameter p-process as logical no-undo .
      523     define variable glog as logical no-undo .
      524     do
      525       on error undo, return error
      526       :
      527       SYSTEM-DIALOG GET-FILE p-ReportFileName
      528         TITLE      "Укажите путь"
      529         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      530         ASK-OVERWRITE
      531         CREATE-TEST-FILE
      532         SAVE-AS
      533         USE-FILENAME
      534         DEFAULT-EXTENSION "txt"
      535         UPDATE glog
      536         .
      537       if not glog then  return.
      538       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      539       if p-is-stream then
      540       do:
      541         if p-is-append then
      542         do:
      543           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      544         end.
      545         else
      546         do:
      547           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      548         end.
      549       end.
      550       else
      551       do:
      552         if p-is-append then
      553         do:
      554           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      555         end.
      556         else
      557         do:
      558           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      559         end.
      560       end.
      561       p-process = yes.
      562     end.
      563   end procedure.
      564   procedure prn-lib-get-report-name :
      565     define input parameter parParentProc  as widget-handle no-undo.
      566     define output parameter p-report-name as character no-undo .
      567     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      568   end procedure.
      569   procedure prn-lib-reportviewer-report-name :
      570     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      571     define input parameter p-report-name-html as character no-undo .
      572     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      573   end procedure.
      574   procedure prn-lib-reportviewer :
      575     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      576     define input parameter p-report-name-html as character no-undo .
      577     define input parameter p-param        as character no-undo .
      578     define variable v-excel           as character no-undo init 'TRUE' .
      579     define variable v-value-character as character no-undo .
      580     define variable v-value-integer   as character no-undo .
      581     define variable v-value-date      as date      no-undo .
      582     define variable v-value-decimal   as decimal   no-undo .
      583     define variable rep-excel         as logical   no-undo .
      584     define variable excel-string      as character no-undo .
      585     define variable v-param-type      as character no-undo .
      586     define variable v-tth             as handle    no-undo .
      587     run adm/shattri.p (
      588       input "get":U
      589       ,input  ""
      590       ,input  0
      591       ,input  'report-glob':U
      592       ,input  'rep-excel':U
      593       ,output v-value-character
      594       ,output v-value-date
      595       ,output v-value-decimal
      596       ,output v-value-integer
      597       ,output rep-excel
      598       ,output v-param-type
      599       ,INPUT-OUTPUT table-handle v-tth
      600       )  .
      601     if rep-excel then v-excel = "TRUE" .
      602     else v-excel = "FALSE" .
      603     if p-param eq ""
      604     then
      605        p-param = "EXCEL:" + v-excel.
      606     else
      607        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      608     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      609   end procedure.
      610   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      611   define variable v-waitfram-action01         as character   no-undo .
      612   define variable v-waitfram-action02         as character   no-undo .
      613   define variable v-waitfram-action03         as character   no-undo .
      614   define variable mWaitFramTextBeg            as character   no-undo.
      615   define variable mWaitFramTextEnd            as character   no-undo.
      616   define variable mWaitFramView               as logical     no-undo.
      617   define variable mWaitProcEvent              as logical     no-undo init yes.
      618   define variable mWaitFramInterval           as integer     no-undo init 1 .
      619   define variable mWaitFramStop               as logical     no-undo.
      620   define variable mWaitFramStopUser           as logical     no-undo.
      621   define variable mWaitFramStopTimeOut        as logical     no-undo.
      622   define variable mWaitFramStartProc          as datetime-tz no-undo.
      623   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      624   define button B-WaitFramStop auto-end-key
      625        label "Стоп"
      626        size 10 by 1 tooltip "Остоновить процесс".
      627   define button B-viewProcInfo
      628        label "Информация"
      629        size 15 by 1 tooltip "Информация о процесс".
      630   define frame waitfram
      631     v-waitfram-action01 format "x(72)" no-label skip
      632     v-waitfram-action02 format "x(72)" no-label skip
      633     v-waitfram-action03 format "x(72)" no-label skip
      634     B-viewProcInfo
      635     B-WaitFramStop at row 4 col 30
      636     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      637     .
      638   define new global shared variable mBatchMode as logical no-undo init ?.
      639   define variable mFramBachModHandle as handle no-undo.
      640   mFramBachModHandle = frame waitfram:handle.
      641   define variable mFameOldVis as logical no-undo.
      642   define variable mVisCUrentVin as logical no-undo.
      643   if session:batch-mode
      644   then
      645      mBatchMode = yes.
      646   if mBatchMode = ? then do:
      647     mVisCUrentVin = current-window:visible.
      648     mFameOldVis = mFramBachModHandle:visible.
      649     mFramBachModHandle:visible  = yes.
      650     mBatchMode = mFramBachModHandle:visible ne yes.
      651     mFramBachModHandle:visible = mFameOldVis.
      652     current-window:visible = mVisCUrentVin.
      653   end.
      654    if  log-manager:logfile-name ne ?
      655     then DO:
      656         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      657         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      658         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      659     end.
      660   on choose of B-WaitFramStop in frame waitfram
      661   do:
      662     mWaitFramStop = yes.
      663     mWaitFramStopUser = yes.
      664   end.
      665   function waitfram-check-timeout returns logical():
      666      define variable vtime as int64 no-undo.
      667      if mWaitFramStopTimeOut
      668      then
      669         return yes.
      670      vtime = ( now - mWaitFramStartProc ) / 1000 .
      671      if     mWaitFramTimeOut ne ?
      672         and mWaitFramTimeOut ne 0
      673         and mWaitFramTimeOut lt vtime
      674      then do:
      675         mWaitFramStopTimeOut = yes.
      676      end.
      677      return mWaitFramStopTimeOut.
      678   end.
      679   procedure waitfram-hide :
      680     if not session:batch-mode
      681     then do
      682     on error undo, return error return-value
      683     :
      684       pause 0 before-hide .
      685       if not mBatchMode then
      686         hide frame waitfram .
      687     if     not mWaitFramView
      688        and mWaitProcEvent
      689     then
      690       process events .
      691     end.
      692   end procedure.
      693   procedure waitfram-show :
      694     define input  parameter p-message as character no-undo .
      695     define variable v-left-margin as integer   no-undo .
      696     if not session:batch-mode
      697     then do
      698     on error undo, return error return-value
      699     :
      700       if length(p-message) <= 70 then do:
      701         assign
      702           v-left-margin = integer((70 - length(p-message)) / 2)
      703         .
      704         assign
      705           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      706         .
      707         assign
      708           v-waitfram-action01 = " "
      709           v-waitfram-action02 = " "
      710                                    + fill(" ", v-left-margin)
      711                                    + p-message
      712           v-waitfram-action03 = " "
      713         .
      714       end.
      715       else do:
      716         define variable vRindex1 as integer no-undo.
      717         define variable vRindex2 as integer no-undo.
      718         vRindex1 = r-index(p-message," ",70).
      719         if vRindex1 = 0
      720         then
      721            vRindex1 = 70.
      722         if length(p-message)  <= vRindex1 + 70 then do:
      723           assign
      724             v-waitfram-action01 = " "
      725             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      726             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      727           .
      728         end.
      729         else do:
      730           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      731           if vRindex2 <= vRindex1
      732           then
      733              vRindex2 = vRindex1 + 70.
      734           assign
      735             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      736             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      737             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      738           .
      739         end.
      740       end.
      741       B-viewProcInfo:visible   in frame waitfram = no.
      742       B-viewProcInfo:sensitive in frame waitfram = no.
      743       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      744       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      745       if  (   mWaitFramView
      746          or  mWaitProcEvent)
      747          and not mBatchMode
      748       then
      749          display
      750             v-waitfram-action01 skip
      751             v-waitfram-action02 skip
      752             v-waitfram-action03 skip
      753          with frame waitfram .
      754       if     mWaitFramView
      755          then do:
      756             if     mWaitFramInterval ne ?
      757                and not mBatchMode
      758             then
      759                wait-for go of frame waitfram pause mWaitFramInterval.
      760          end.
      761          else
      762             if     mWaitProcEvent
      763                and not mBatchMode
      764             then
      765                process events .
      766     end.
      767   end procedure.
      768      procedure waitfram-show-this:
      769         define input  parameter iInterval as int64 no-undo.
      770         define variable vtime as int64 no-undo.
      771         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      772         mWaitFramInterval = iInterval.
      773         run waitfram-show (substitute("&1&2 &3&4" ,
      774                                       mWaitFramTextBeg ,
      775                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      776                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      777                                       mWaitFramTextEnd
      778                                      )
      779                           ).
      780      end.
      781      procedure WaitFramRunPause:
      782         define input  parameter iInterval as dec no-undo.
      783         define variable vStart  as datetime-tz no-undo.
      784         define variable vend    as datetime-tz no-undo.
      785         define variable vint as int64 no-undo.
      786         define variable vOk as logical no-undo.
      787         vStart = now.
      788         vend   = vStart.
      789         publish "WaitFramPause" (iInterval,output vOk).
      790         vend   =  now.
      791         vint = vend - vStart.
      792         vint = iInterval - vint / 1000.
      793         if     not mWaitFramStop
      794            and (   vint > 0
      795                 or (    not vOk
      796                     and iInterval eq ?
      797                     )
      798                 )
      799         then
      800            run waitfram-show-this (iInterval).
      801         vend   =  now.
      802         vint = vend - vStart.
      803         vint = iInterval - vint / 1000.
      804         if     not mWaitFramStop
      805            and vint > 0
      806         then do:
      807            run gbl/pause.p (vint * 1000).
      808         end.
      809         if iInterval ne ?
      810         then
      811            publish "WaitFramStop".
      812         waitfram-check-timeout().
      813      end.
      814      procedure WaitFramWaitFor:
      815         define input  parameter iInterval as dec no-undo.
      816         assign
      817            mWaitFramStartProc   = now
      818            mWaitFramStopUser    = no
      819            mWaitFramStopTimeOut = no
      820         .
      821         block-wait:
      822         do while not mWaitFramStop:
      823            run WaitFramRunPause (iInterval).
      824            if  waitfram-check-timeout()
      825            then do:
      826               leave block-wait.
      827            end.
      828         end.
      829         run waitfram-hide.
      830      end.
      831   procedure waitfram-join :
      832     define input  parameter p-line-1  as character no-undo .
      833     define input  parameter p-line-2  as character no-undo .
      834     define input  parameter p-line-3  as character no-undo .
      835     define output parameter p-message as character no-undo .
      836     do
      837     on error undo, return error return-value
      838     :
      839       assign
      840         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      841                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      842                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      843       .
      844     end.
      845   end procedure.
      846   function waitfram-join-function returns character
      847     (input p-line-1 as character
      848     ,input p-line-2 as character
      849     ,input p-line-3 as character
      850     ).
      851     define variable v-message as character no-undo .
      852     run waitfram-join in this-procedure
      853       (input  p-line-1
      854       ,input  p-line-2
      855       ,input  p-line-3
      856       ,output v-message
      857       ) .
      858     return v-message .
      859   end function .
      860   procedure proc-alt-shift-f2:
