      867       ( input this-procedure
      868       ) .
      869   end.
      870   define variable v-inform-launched as logical no-undo initial false .
      871   procedure proc-alt-shift-f4:
      872     define variable v-action as character no-undo .
      873     if v-inform-launched = false then do:
      874       assign
      875         v-inform-launched = true
      876       .
      877       run gbl/d-inform.w
      878         (  input self
      879         ,  input this-procedure
      880         , output v-action
      881         ) no-error .
      882       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      883       assign
      884         v-inform-launched = false
      885       .
      886     end.
      887   end.
      888   procedure proc-alt-f1:
      889     run gbl/corrhelp.p
      890       (input this-procedure
      891       ) .
      892   end .
