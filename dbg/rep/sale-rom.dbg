     1501        self :sensitive = true
     1502        )
     1503     or (can-query (self, "read-only")
     1504        and
     1505        self :read-only = false
     1506        )
     1507     then do:
     1508       assign
     1509         self :screen-value = ?
     1510       .
     1511     end.
     1512     return no-apply.
     1513   end.
     1514   on ctrl-d of end-date in frame Dialog-Frame
     1515   do:
     1516     define variable v-curr-sv-date as date no-undo .
     1517     if (can-query (self, "sensitive")
     1518        and
     1519        self :sensitive = true
     1520        )
     1521     or (can-query (self, "read-only")
     1522        and
     1523        self :read-only = false
     1524        )
     1525     then do:
     1526       if self :handle <> focus :handle
     1527       then do:
     1528         apply "entry":u to self .
     1529       end.
     1530       run gbl/getcurdt.p
     1531         (output v-curr-sv-date
     1532         ) .
     1533       assign
     1534         self :screen-value = string(v-curr-sv-date) .
     1535       .
     1536     end.
     1537     return no-apply.
     1538   end.
     1539   on ctrl-b of end-date in frame Dialog-Frame
     1540   do:
     1541     if (can-query (self, "sensitive")
     1542        and
     1543        self :sensitive = true
     1544        )
     1545     or (can-query (self, "read-only")
     1546        and
     1547        self :read-only = false
     1548        )
     1549     then do:
     1550       if self :handle <> focus :handle
     1551       then do:
     1552         apply "entry":u to self .
     1553       end.
     1554       define variable v-curr-sv-date as date no-undo .
     1555       define variable v-new-sv-date  as date no-undo .
     1556       assign
     1557         v-curr-sv-date = date(self :screen-value) no-error
     1558       .
     1559       if v-curr-sv-date = ?
     1560       then do:
     1561         run gbl/getcurdt.p
     1562           (output v-curr-sv-date
     1563           ) .
     1564       end.
     1565       if v-curr-sv-date <> ?
     1566       then do:
     1567         assign
     1568           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     1569         .
     1570         assign
     1571           self :screen-value = string(v-new-sv-date) .
     1572         .
     1573       end.
     1574     end.
     1575     return no-apply .
     1576   end.
     1577   on ctrl-e of end-date in frame Dialog-Frame
     1578   do:
     1579     if (can-query (self, "sensitive")
     1580        and
     1581        self :sensitive = true
     1582        )
     1583     or (can-query (self, "read-only")
     1584        and
     1585        self :read-only = false
     1586        )
     1587     then do:
     1588       if self :handle <> focus :handle
     1589       then do:
     1590         apply "entry":u to self .
     1591       end.
     1592       define variable v-curr-sv-date as date no-undo .
     1593       define variable v-new-sv-date  as date no-undo .
     1594       assign
     1595         v-curr-sv-date = date(self :screen-value) no-error
     1596       .
     1597       if v-curr-sv-date = ?
     1598       then do:
     1599         run gbl/getcurdt.p
     1600           (output v-curr-sv-date
     1601           ) .
     1602       end.
     1603       if v-curr-sv-date <> ?
     1604       then do:
     1605         run gbl/lastdate.p
     1606           (input  v-curr-sv-date
     1607           ,output v-new-sv-date
     1608           ).
     1609         assign
     1610           self :screen-value = string(v-new-sv-date) .
     1611         .
     1612       end.
     1613     end.
     1614     return no-apply .
     1615   end.
     1616   on ctrl-f of end-date in frame Dialog-Frame
     1617   do:
     1618     if (can-query (self, "sensitive")
     1619        and
     1620        self :sensitive = true
     1621        )
     1622     or (can-query (self, "read-only")
     1623        and
     1624        self :read-only = false
     1625        )
     1626     then do:
     1627       if self :handle <> focus :handle
     1628       then do:
     1629         apply "entry":u to self .
     1630       end.
     1631       define variable v-ok            as logical   no-undo .
     1632       define variable v-curr-sv-date  as date      no-undo .
     1633       define variable v-description   as character no-undo .
     1634       assign
     1635         v-curr-sv-date = date(self :screen-value) no-error
     1636       .
     1637       if v-curr-sv-date = ?
     1638       then do:
     1639         run gbl/getcurdt.p
     1640           (output v-curr-sv-date
     1641           ) .
     1642       end.
     1643       if v-curr-sv-date <> ?
     1644       then do:
     1645         run gbl/d-inpday.w
     1646           (input ?
     1647           ,input "Выбор даты"
     1648           ,input v-description
     1649           ,input ""
     1650           ,input-output v-curr-sv-date
     1651           ,output v-ok
     1652           ).
     1653         if v-ok = true
     1654         then do:
     1655           assign
     1656             self :screen-value = string(v-curr-sv-date) .
     1657           .
     1658         end.
     1659       end.
     1660     end.
     1661     return no-apply .
     1662   end.
     1663     define MENU m-ed-date10
     1664       MENU-ITEM m-ed-date10-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
     1665       MENU-ITEM m-ed-date10-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
     1666       MENU-ITEM m-ed-date10-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
     1667       MENU-ITEM m-ed-date10-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
     1668       .
     1669     if end-date :POPUP-MENU in frame Dialog-Frame = ?
     1670     then do:
     1671       ASSIGN
     1672         end-date :POPUP-MENU in frame Dialog-Frame = MENU m-ed-date10 :HANDLE
     1673         end-date :MENU-MOUSE in frame Dialog-Frame = 3
     1674       .
     1675     end.
     1676     define variable v-label-handle10 as handle no-undo .
     1677     assign
     1678       v-label-handle10 = end-date :side-label-handle in frame Dialog-Frame
     1679     .
     1680     if valid-handle (v-label-handle10)
     1681     then do:
     1682       if v-label-handle10 :tooltip = ""
     1683       or v-label-handle10 :tooltip = ?
     1684       then do:
     1685         assign
     1686           v-label-handle10 :tooltip = "Ctrl-D - текущая, Ctrl-B - начало, Ctrl-E - конец, Ctrl-F - календарь, Прав.Клавиша Мыши - Popup Menu"
     1687         .
     1688       end.
     1689     end.
     1690     ON CHOOSE OF MENU-ITEM m-ed-date10-1 in menu m-ed-date10 DO:
     1691       apply "ctrl-b":U to end-date in frame Dialog-Frame .
     1692     END.
     1693     ON CHOOSE OF MENU-ITEM m-ed-date10-2 in menu m-ed-date10 DO:
     1694       apply "ctrl-d":U to end-date in frame Dialog-Frame .
     1695     END.
     1696     ON CHOOSE OF MENU-ITEM m-ed-date10-3 in menu m-ed-date10 DO:
     1697       apply "ctrl-e":U to end-date in frame Dialog-Frame .
     1698     END.
     1699     ON CHOOSE OF MENU-ITEM m-ed-date10-4 in menu m-ed-date10 DO:
     1700       apply "ctrl-f":U to end-date in frame Dialog-Frame .
     1701     END.
     1702   MAIN-BLOCK:
     1703   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1704      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1705   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1706   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     1707     (input  p-curr-obj-type
     1708     ,input  p-curr-obj-code
     1709     ,output v-today
     1710     )  .
     1711     assign
     1712         start-date = v-today
     1713         end-date   = v-today
     1714     .
     1715     find first gds-grp where gds-grp.upper-code = 0 no-lock.
     1716     vargds-grp = gds-grp.node-code.
     1717     RUN enable_UI.
     1718     WAIT-FOR GO OF FRAME Dialog-Frame.
     1719   END.
     1720   RUN disable_UI.
     1721   PROCEDURE calc-gds-grp :
     1722     define input  parameter pardisp-all         as   integer               no-undo.
     1723     define input  parameter parnode-code        like gds-grp.node-code     no-undo.
     1724     define input  parameter pargrp-name         like goods.grp-name        no-undo.
     1725     define output parameter parsum-vat-acc      like doc-line.price-rubl no-undo.
     1726     define output parameter parsum-vat-sale     like doc-line.price-rubl no-undo.
     1727     define output parameter parsum-acc-out-vat  like doc-line.price-rubl no-undo.
     1728     define output parameter parsum-sale-out-vat like doc-line.price-rubl no-undo.
     1729     define output parameter parsum-sale         like doc-line.price-rubl no-undo.
     1730     define output parameter parsum-road-tax     like doc-line.price-rubl no-undo.
     1731     define output parameter parsum-qnty         like doc-line.fact-qnty    no-undo.
     1732     define variable vargrp-name-loc like goods.grp-name no-undo.
     1733     find first gds-grp where gds-grp.node-code = parnode-code no-lock.
     1734     vargrp-name-loc = pargrp-name + "\" + gds-grp.node-name.
     1735     if length(vargrp-name-loc) > 37 then vargrp-name-loc = "..." +
     1736                                          SUBSTRING(vargrp-name-loc, length(vargrp-name-loc) - 36, 37).
     1737     if can-find(first gds-grp where gds-grp.upper-code = parnode-code no-lock) then do:
     1738        for each gds-grp where gds-grp.upper-code = parnode-code no-lock:
     1739            RUN calc-gds-grp (input  pardisp-all,
     1740                              input  gds-grp.node-code,
     1741                              input  vargrp-name-loc,
     1742                              output varsum-vat-acc,
     1743                              output varsum-vat-sale,
     1744                              output varsum-acc-out-vat,
     1745                              output varsum-sale-out-vat,
     1746                              output varsum-sale,
     1747                              output varsum-road-tax,
     1748                              output varsum-qnty).
     1749            ACCUMULATE varsum-vat-acc      (total)
     1750                       varsum-vat-sale     (total)
     1751                       varsum-acc-out-vat  (total)
     1752                       varsum-sale-out-vat (total)
     1753                       varsum-sale         (total)
     1754                       varsum-road-tax     (total)
     1755                       varsum-qnty         (total).
     1756        end.
     1757        ASSIGN
     1758          parsum-vat-acc      = (ACCUM TOTAL varsum-vat-acc     )
     1759          parsum-vat-sale     = (ACCUM TOTAL varsum-vat-sale    )
     1760          parsum-acc-out-vat  = (ACCUM TOTAL varsum-acc-out-vat )
     1761          parsum-sale-out-vat = (ACCUM TOTAL varsum-sale-out-vat)
     1762          parsum-sale         = (ACCUM TOTAL varsum-sale        )
     1763          parsum-road-tax     = (ACCUM TOTAL varsum-road-tax    )
     1764          parsum-qnty         = (ACCUM TOTAL varsum-qnty        ).
     1765          if parsum-vat-acc       > 0 OR
     1766             parsum-vat-sale      > 0 OR
     1767             parsum-acc-out-vat   > 0 OR
     1768             parsum-sale-out-vat  > 0 OR
     1769             parsum-sale          > 0 OR
     1770             parsum-road-tax      > 0 OR
     1771             parsum-qnty          > 0 THEN DO:
     1772             if (pardisp-all <> 2 OR parnode-code = varroot) AND
     1773                (pardisp-all <> 4 OR parnode-code = varroot) AND
     1774                (pardisp-all <> 5 OR parnode-code = varroot) THEN
     1775             run disp-total(input vargrp-name-loc    ,
     1776                            input parsum-vat-acc     ,
     1777                            input parsum-vat-sale    ,
     1778                            input parsum-acc-out-vat ,
     1779                            input parsum-sale-out-vat,
     1780                            input parsum-sale        ,
     1781                            input parsum-road-tax    ,
     1782                            input parsum-qnty).
     1783          END.
     1784     end.
     1785     else do:
     1786          if can-find(first tt-doc-line where tt-doc-line.grp-code = gds-grp.node-code) and
     1787             pardisp-all <> 2 and
     1788             pardisp-all <> 3 and
     1789             pardisp-all <> 5 then run disp-grp-name(input vargrp-name-loc).
     1790          for each tt-doc-line where tt-doc-line.grp-code = gds-grp.node-code:
     1791              if pardisp-all <> 3 and
     1792                 pardisp-all <> 5 then run disp-tt-doc-line.
     1793              ACCUMULATE tt-doc-line.sum-vat-acc      (total)
     1794                         tt-doc-line.sum-vat-sale     (total)
     1795                         tt-doc-line.sum-acc-out-vat  (total)
     1796                         tt-doc-line.sum-sale-out-vat (total)
     1797                         tt-doc-line.sum-sale         (total)
     1798                         tt-doc-line.sum-road-tax     (total)
     1799                         tt-doc-line.qnty             (total).
     1800          end.
     1801          ASSIGN
     1802          parsum-vat-acc      = (ACCUM TOTAL tt-doc-line.sum-vat-acc     )
     1803          parsum-vat-sale     = (ACCUM TOTAL tt-doc-line.sum-vat-sale    )
     1804          parsum-acc-out-vat  = (ACCUM TOTAL tt-doc-line.sum-acc-out-vat )
     1805          parsum-sale-out-vat = (ACCUM TOTAL tt-doc-line.sum-sale-out-vat)
     1806          parsum-sale         = (ACCUM TOTAL tt-doc-line.sum-sale        )
     1807          parsum-road-tax     = (ACCUM TOTAL tt-doc-line.sum-road-tax    )
     1808          parsum-qnty         = (ACCUM TOTAL tt-doc-line.qnty            ).
     1809          find first tt-doc-line where tt-doc-line.grp-code = gds-grp.node-code no-error.
     1810          if available tt-doc-line then do:
     1811              if pardisp-all <> 2       OR
     1812                 parnode-code = varroot then
     1813              run disp-total(input vargrp-name-loc    ,
     1814                             input parsum-vat-acc     ,
     1815                             input parsum-vat-sale    ,
     1816                             input parsum-acc-out-vat ,
     1817                             input parsum-sale-out-vat,
     1818                             input parsum-sale        ,
     1819                             input parsum-road-tax    ,
     1820                             input parsum-qnty).
     1821         end.
     1822     end.
     1823   END PROCEDURE.
     1824   PROCEDURE calc-sale :
     1825   DEFINE INPUT PARAMETER parobj-type   LIKE ub.clients.obj-type NO-UNDO.
     1826   DEFINE INPUT PARAMETER parobj-code   LIKE ub.clients.obj-code NO-UNDO.
     1827   DEFINE INPUT PARAMETER parstart-date AS   DATE       NO-UNDO.
     1828   DEFINE INPUT PARAMETER parend-date   AS   DATE       NO-UNDO.
     1829   define variable varr-b as character no-undo.
     1830   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1831   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1832     (output varr-b
     1833     )  .
     1834   run waitfram-show in this-procedure ("Сбор данных о продажах").
     1835   for each trn-doc where trn-doc.obj-type    = parobj-type   and
     1836                          trn-doc.obj-code    = parobj-code   and
     1837                          trn-doc.status_     = 'факт':U       and
     1838                          trn-doc.fact-date  >= parstart-date and
     1839                          trn-doc.fact-date  <= parend-date   and
     1840                          trn-doc.internal    = no            and
     1841                          trn-doc.doc-type    = 'рас':U    and
     1842                          trn-doc.discnt-type = 'касс':U no-lock ,
     1843     each doc-line where doc-line.doc-code = trn-doc.doc-code and
     1844                         doc-line.doc-qnty <> 0 no-lock,
     1845     first goods where goods.artic     = doc-line.artic     and
     1846                       goods.prod-type = doc-line.prod-type and
     1847                       goods.prod-code = doc-line.prod-code no-lock:
     1848       run calc-in-out in this-procedure.
     1849       run cr-tt-doc-line in this-procedure.
     1850       if varr-b = "rubl":u then do:
     1851         run as1-tt-doc-line in this-procedure.
     1852       end.
     1853       else do:
     1854         run as2-tt-doc-line in this-procedure.
     1855       end.
     1856   end .
     1857   run as3-tt-doc-line in this-procedure.
     1858   run waitfram-hide in this-procedure .
     1859   END PROCEDURE.
     1860   procedure calc-in-out :
     1861   assign
     1862     price-rubl-with-tax-loc = doc-line.price-rubl
     1863     price-base-with-tax-loc = doc-line.price-base
     1864   .
     1865   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1866   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1867     (output varinvprb
     1868     )  .
     1869      find first in-vatp_doc-attr no-lock
     1870       where in-vatp_doc-attr.doc-code  = trn-doc.doc-code
     1871         and in-vatp_doc-attr.attr-code = 'envd':U
     1872       no-error .
     1873       if available in-vatp_doc-attr
     1874          then do:
     1875          assign
     1876            in-vatp-have-vat-slt = no.
     1877      end.
     1878      else do:
     1879        assign
     1880          in-vatp-have-vat-slt = yes.
     1881      end.
     1882      find first in-vatp-goods where in-vatp-goods.artic     = doc-line.artic     and
     1883                                        in-vatp-goods.prod-type = doc-line.prod-type and
     1884                                        in-vatp-goods.prod-code = doc-line.prod-code no-lock.
     1885      if (not trn-doc.internal and
     1886              trn-doc.doc-type = 'при':U) or
     1887         in-vatp-goods.gds-type = 'у':U then do:
     1888         if varinvprb = "base":u then do:
     1889           assign
     1890             road-tax-base-loc = doc-line.road-tax
     1891             road-tax-rubl-loc = doc-line.road-tax * trn-doc.base-rate / trn-doc.base-scale.
     1892         end.
     1893         else do:
     1894           ASSIGN
     1895             road-tax-rubl-loc = doc-line.road-tax
     1896             road-tax-base-loc = doc-line.road-tax / trn-doc.base-rate * trn-doc.base-scale.
     1897         end.
     1898         if road-tax-base-loc = ? then road-tax-base-loc = 0.
     1899         if road-tax-rubl-loc = ? then road-tax-rubl-loc = 0.
     1900         assign
     1901           road-tax-cli-loc = ?.
     1902         ASSIGN
     1903           transport-base-loc = (if doc-line.transport-base = ? then 0 else doc-line.transport-base)
     1904           transport-rubl-loc = (if doc-line.transport-rubl = ? then 0 else doc-line.transport-rubl)
     1905           transport-cli-loc  = 0
     1906           other-base-loc     = (if doc-line.other-base     = ? then 0 else doc-line.other-base)
     1907           other-rubl-loc     = (if doc-line.other-rubl     = ? then 0 else doc-line.other-rubl)
     1908           other-cli-loc      = 0
     1909           vat-pc-loc         = (if doc-line.vat-pc         = ? then 0 else doc-line.vat-pc)
     1910           slt-pc-loc         = (if doc-line.slt-pc         = ? then 0 else doc-line.slt-pc).
     1911                                 ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1912               ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1913         assign
     1914           vat-cli-loc            = ?
     1915           slt-cli-loc            = ?
     1916           price-cli-with-tax-loc = ?.
     1917      end.
     1918      else do:
     1919                                                   for each in-vatp-parts where in-vatp-parts.out-code  = doc-line.doc-code  and
     1920                                         in-vatp-parts.obj-type  = doc-line.obj-type  and
     1921                                         in-vatp-parts.obj-code  = doc-line.obj-code  and
     1922                                         in-vatp-parts.artic     = doc-line.artic     and
     1923                                         in-vatp-parts.prod-type = doc-line.prod-type and
     1924                                         in-vatp-parts.prod-code = doc-line.prod-code
     1925                            use-index out-code no-lock:
     1926             accumulate  in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty (total)
     1927                         in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty (total)
     1928                         in-vatp-parts.transport-base * in-vatp-parts.fact-qnty (total)
     1929                         in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty (total)
