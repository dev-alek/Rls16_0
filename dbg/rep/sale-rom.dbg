      987         tt-doc-line.sum-vat-sale      COLUMN-LABEL "Сумма!НДС" format ">>>>>>>9.99" space(0)
      988         sym13                         column-label ":!:" format "X(1)" space(0)
      989         tt-doc-line.price-sale        COLUMN-LABEL "Розн.цена! с НДС" format ">>>>9.99" space(0)
      990         sym14                         column-label ":!:" format "X(1)" space(0)
      991         tt-doc-line.sum-acc-out-vat   COLUMN-LABEL "Сумма по уч!цене без НДС" format ">>>>>>>9.99" space(0)
      992         sym15                         column-label ":!:" format "X(1)" space(0)
      993         tt-doc-line.sum-sale-out-vat  column-label "Сумма прод.! без НДС" format ">>>>>>>9.99" space(0)
      994         sym16                         column-label ":!:" format "X(1)" space(0)
