      615   function diff-list returns character (
      616     input parfirst-list  as character,
      617     input parsecond-list as character,
      618     input pardelim       as character).
      619     if pardelim = ""
      620     or pardelim = ?
      621     then do:
      622       assign
      623         pardelim = ","
      624       .
      625     end.
      626     def var ind as integer no-undo .
      627     def var v-elem as character no-undo .
      628     def var v-result-list as character no-undo init "".
      629     def var v-num-parfirst-list as integer no-undo .
      630     assign
      631       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      632     .
      633     do ind = 1 to v-num-parfirst-list
      634     :
      635       assign
      636         v-elem = entry(ind, parfirst-list, pardelim)
      637       .
      638       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
      639         assign
      640           v-result-list = v-result-list
      641                         + (if v-result-list > "" then pardelim else "")
      642                         + v-elem
      643         .
      644       end.
      645     end.
      646     return v-result-list .
      647   end function.
      648   function add-list returns character (
      649    input parfirst-list  as character,
      650    input parsecond-list as character,
      651    input pardelim       as character).
      652     if pardelim = ""
      653     or pardelim = ?
      654     then do:
      655       assign
      656         pardelim = ","
      657       .
      658     end.
      659     def var ind as integer no-undo .
      660     def var v-elem as character no-undo .
      661     def var v-result-list as character no-undo init "".
      662     def var v-num-parfirst-list as integer no-undo .
      663     assign
      664       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      665     .
      666     do ind = 1 to v-num-parfirst-list
      667     :
      668       assign
      669         v-elem = entry(ind, parfirst-list, pardelim)
      670       .
      671       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      672         assign
      673           v-result-list = v-result-list
      674                         + (if v-result-list > "" then pardelim else "")
      675                         + v-elem
      676         .
      677       end.
      678     end.
      679     def var v-num-parsecond-list as integer no-undo .
      680     assign
      681       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
      682     .
      683     do ind = 1 to v-num-parsecond-list
      684     :
      685       assign
      686         v-elem = entry(ind, parsecond-list, pardelim)
      687       .
      688       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      689         assign
      690           v-result-list = v-result-list
      691                         + (if v-result-list > "" then pardelim else "")
      692                         + v-elem
      693         .
      694       end.
      695     end.
      696     return v-result-list .
      697   end function.
      698   function cross-list returns character (
      699    input parfirst-list  as character,
      700    input parsecond-list as character,
      701    input pardelim       as character).
      702     if pardelim = ""
      703     or pardelim = ?
      704     then do:
      705       assign
      706         pardelim = ","
      707       .
      708     end.
      709     def var ind as integer no-undo .
      710     def var v-elem as character no-undo .
      711     def var v-result-list as character no-undo init "".
      712     def var v-num-parfirst-list as integer no-undo .
      713     assign
      714       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      715     .
      716     do ind = 1 to v-num-parfirst-list
      717     :
      718       assign
      719         v-elem = entry(ind, parfirst-list, pardelim)
      720       .
      721       if lookup(v-elem, v-result-list, pardelim) = 0
      722       and lookup(v-elem, parsecond-list, pardelim) > 0
      723       then do:
      724         assign
      725           v-result-list = v-result-list
      726                         + (if v-result-list > "" then pardelim else "")
      727                         + v-elem
      728         .
      729       end.
      730     end.
      731     return v-result-list .
      732   end function.
      733   function radio-label returns character (
      734    input par-rs-value  as character,
      735    input par-rs-radio-buttons as character)
      736    .
      737    DEFINE variable v-result-label as character no-undo.
      738    assign
      739    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
      740                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
      741                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
      742                             ), par-rs-radio-buttons
      743                           )
      744    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      745    .
      746   return v-result-label.
      747   end function.
      748   function m-radio-label returns character (
      749    input par-rs-value  as character,
      750    input par-rs-radio-buttons as character,
      751    input par-delim as character
      752    )
      753    .
      754    DEFINE variable v-result-label as character no-undo.
      755    assign
      756    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
      757                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
      758                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
      759                             ), par-rs-radio-buttons, par-delim
      760                           )
      761    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      762    .
      763   return v-result-label.
      764   end function.
      765   FUNCTION mixlist returns character
      766   (
      767    input parfirst-list  as character
      768    ,input parsecond-list as character
      769    ,input pardelim       as character
      770    ,input pardelim-result as character ) :
      771     if pardelim = ""
      772     or pardelim = ?
      773     then do:
      774       assign
      775         pardelim = ","
      776       .
      777     end.
      778     def var ind as integer no-undo .
      779     def var v-elem1 as character no-undo .
      780     def var v-elem2 as character no-undo .
      781     def var v-result-list as character no-undo init "".
      782     do ind = 1 to num-entries(parfirst-list, pardelim)
      783     :
      784       assign
      785         v-elem1 = entry(ind, parfirst-list, pardelim)
      786         v-elem2 = entry(ind, parsecond-list, pardelim)
      787       .
      788         assign
      789           v-result-list = v-result-list
      790                         + (if v-result-list > "" then pardelim-result else "")
      791                         + v-elem1 + pardelim-result + v-elem2
      792         .
      793     end.
      794     return v-result-list .
      795   END FUNCTION.
      796   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      797   define variable v-waitfram-action01         as character   no-undo .
      798   define variable v-waitfram-action02         as character   no-undo .
      799   define variable v-waitfram-action03         as character   no-undo .
      800   define variable mWaitFramTextBeg            as character   no-undo.
      801   define variable mWaitFramTextEnd            as character   no-undo.
      802   define variable mWaitFramView               as logical     no-undo.
      803   define variable mWaitProcEvent              as logical     no-undo init yes.
      804   define variable mWaitFramInterval           as integer     no-undo init 1 .
      805   define variable mWaitFramStop               as logical     no-undo.
      806   define variable mWaitFramStopUser           as logical     no-undo.
      807   define variable mWaitFramStopTimeOut        as logical     no-undo.
      808   define variable mWaitFramStartProc          as datetime-tz no-undo.
      809   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      810   define button B-WaitFramStop auto-end-key
      811        label "Стоп"
      812        size 10 by 1 tooltip "Остоновить процесс".
      813   define button B-viewProcInfo
      814        label "Информация"
      815        size 15 by 1 tooltip "Информация о процесс".
      816   define frame waitfram
      817     v-waitfram-action01 format "x(72)" no-label skip
      818     v-waitfram-action02 format "x(72)" no-label skip
      819     v-waitfram-action03 format "x(72)" no-label skip
      820     B-viewProcInfo
      821     B-WaitFramStop at row 4 col 30
      822     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      823     .
      824   define new global shared variable mBatchMode as logical no-undo init ?.
      825   define variable mFramBachModHandle as handle no-undo.
      826   mFramBachModHandle = frame waitfram:handle.
      827   define variable mFameOldVis as logical no-undo.
      828   define variable mVisCUrentVin as logical no-undo.
      829   if session:batch-mode
      830   then
      831      mBatchMode = yes.
      832   if mBatchMode = ? then do:
      833     mVisCUrentVin = current-window:visible.
      834     mFameOldVis = mFramBachModHandle:visible.
      835     mFramBachModHandle:visible  = yes.
      836     mBatchMode = mFramBachModHandle:visible ne yes.
      837     mFramBachModHandle:visible = mFameOldVis.
      838     current-window:visible = mVisCUrentVin.
      839   end.
      840    if  log-manager:logfile-name ne ?
      841     then DO:
      842         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      843         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      844         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      845     end.
      846   on choose of B-WaitFramStop in frame waitfram
      847   do:
      848     mWaitFramStop = yes.
      849     mWaitFramStopUser = yes.
      850   end.
      851   function waitfram-check-timeout returns logical():
      852      define variable vtime as int64 no-undo.
      853      if mWaitFramStopTimeOut
      854      then
      855         return yes.
      856      vtime = ( now - mWaitFramStartProc ) / 1000 .
      857      if     mWaitFramTimeOut ne ?
      858         and mWaitFramTimeOut ne 0
      859         and mWaitFramTimeOut lt vtime
      860      then do:
      861         mWaitFramStopTimeOut = yes.
      862      end.
      863      return mWaitFramStopTimeOut.
      864   end.
      865   procedure waitfram-hide :
      866     if not session:batch-mode
      867     then do
      868     on error undo, return error return-value
      869     :
      870       pause 0 before-hide .
      871       if not mBatchMode then
      872         hide frame waitfram .
      873     if     not mWaitFramView
      874        and mWaitProcEvent
      875     then
      876       process events .
      877     end.
      878   end procedure.
      879   procedure waitfram-show :
      880     define input  parameter p-message as character no-undo .
      881     define variable v-left-margin as integer   no-undo .
      882     if not session:batch-mode
      883     then do
      884     on error undo, return error return-value
      885     :
      886       if length(p-message) <= 70 then do:
      887         assign
      888           v-left-margin = integer((70 - length(p-message)) / 2)
      889         .
      890         assign
      891           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      892         .
      893         assign
      894           v-waitfram-action01 = " "
      895           v-waitfram-action02 = " "
      896                                    + fill(" ", v-left-margin)
      897                                    + p-message
      898           v-waitfram-action03 = " "
      899         .
      900       end.
      901       else do:
      902         define variable vRindex1 as integer no-undo.
      903         define variable vRindex2 as integer no-undo.
      904         vRindex1 = r-index(p-message," ",70).
      905         if vRindex1 = 0
      906         then
      907            vRindex1 = 70.
      908         if length(p-message)  <= vRindex1 + 70 then do:
      909           assign
      910             v-waitfram-action01 = " "
      911             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      912             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      913           .
      914         end.
      915         else do:
      916           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      917           if vRindex2 <= vRindex1
      918           then
      919              vRindex2 = vRindex1 + 70.
      920           assign
      921             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      922             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      923             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      924           .
      925         end.
      926       end.
      927       B-viewProcInfo:visible   in frame waitfram = no.
      928       B-viewProcInfo:sensitive in frame waitfram = no.
      929       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      930       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      931       if  (   mWaitFramView
      932          or  mWaitProcEvent)
      933          and not mBatchMode
      934       then
      935          display
      936             v-waitfram-action01 skip
      937             v-waitfram-action02 skip
      938             v-waitfram-action03 skip
      939          with frame waitfram .
      940       if     mWaitFramView
      941          then do:
      942             if     mWaitFramInterval ne ?
      943                and not mBatchMode
      944             then
      945                wait-for go of frame waitfram pause mWaitFramInterval.
      946          end.
      947          else
      948             if     mWaitProcEvent
      949                and not mBatchMode
      950             then
      951                process events .
      952     end.
      953   end procedure.
      954      procedure waitfram-show-this:
      955         define input  parameter iInterval as int64 no-undo.
      956         define variable vtime as int64 no-undo.
      957         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      958         mWaitFramInterval = iInterval.
      959         run waitfram-show (substitute("&1&2 &3&4" ,
      960                                       mWaitFramTextBeg ,
      961                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      962                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      963                                       mWaitFramTextEnd
      964                                      )
      965                           ).
      966      end.
      967      procedure WaitFramRunPause:
      968         define input  parameter iInterval as dec no-undo.
      969         define variable vStart  as datetime-tz no-undo.
      970         define variable vend    as datetime-tz no-undo.
      971         define variable vint as int64 no-undo.
      972         define variable vOk as logical no-undo.
      973         vStart = now.
      974         vend   = vStart.
      975         publish "WaitFramPause" (iInterval,output vOk).
      976         vend   =  now.
      977         vint = vend - vStart.
      978         vint = iInterval - vint / 1000.
      979         if     not mWaitFramStop
      980            and (   vint > 0
      981                 or (    not vOk
      982                     and iInterval eq ?
      983                     )
      984                 )
      985         then
      986            run waitfram-show-this (iInterval).
      987         vend   =  now.
      988         vint = vend - vStart.
      989         vint = iInterval - vint / 1000.
      990         if     not mWaitFramStop
      991            and vint > 0
      992         then do:
      993            run gbl/pause.p (vint * 1000).
      994         end.
      995         if iInterval ne ?
      996         then
      997            publish "WaitFramStop".
      998         waitfram-check-timeout().
      999      end.
     1000      procedure WaitFramWaitFor:
     1001         define input  parameter iInterval as dec no-undo.
     1002         assign
     1003            mWaitFramStartProc   = now
     1004            mWaitFramStopUser    = no
     1005            mWaitFramStopTimeOut = no
     1006         .
     1007         block-wait:
     1008         do while not mWaitFramStop:
     1009            run WaitFramRunPause (iInterval).
     1010            if  waitfram-check-timeout()
     1011            then do:
     1012               leave block-wait.
     1013            end.
     1014         end.
     1015         run waitfram-hide.
     1016      end.
     1017   procedure waitfram-join :
     1018     define input  parameter p-line-1  as character no-undo .
     1019     define input  parameter p-line-2  as character no-undo .
     1020     define input  parameter p-line-3  as character no-undo .
     1021     define output parameter p-message as character no-undo .
     1022     do
     1023     on error undo, return error return-value
     1024     :
     1025       assign
     1026         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1027                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1028                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1029       .
     1030     end.
     1031   end procedure.
     1032   function waitfram-join-function returns character
     1033     (input p-line-1 as character
     1034     ,input p-line-2 as character
     1035     ,input p-line-3 as character
     1036     ).
     1037     define variable v-message as character no-undo .
     1038     run waitfram-join in this-procedure
     1039       (input  p-line-1
     1040       ,input  p-line-2
     1041       ,input  p-line-3
     1042       ,output v-message
     1043       ) .
     1044     return v-message .
     1045   end function .
     1046   define variable parparentproc as widget-handle no-undo .
     1047   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1048     define variable v-cntxt-db-num        as integer   no-undo .
     1049     define variable v-cntxt-userid        as character no-undo .
     1050     define variable v-cntxt-level         as character no-undo .
     1051     define variable v-cntxt-host-code-obj as integer   no-undo .
     1052     define variable v-cntxt-obj-type      as character no-undo .
     1053     define variable v-cntxt-obj-code      as integer   no-undo .
     1054     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1055     define variable v-cntxt-is-admin      as logical   no-undo .
     1056   DEFINE VARIABLE RS-by AS INTEGER
     1057        VIEW-AS RADIO-SET VERTICAL
     1058        RADIO-BUTTONS
     1059             "Дата", 0,
     1060   "Услуги", 1,
     1061   "Дата/Услуги", 2
     1062        SIZE 31.8 BY 3.13 NO-UNDO.
     1063   DEFINE RECTANGLE RECT-5
     1064        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1065        SIZE 35.4 BY 7.53.
     1066   DEFINE RECTANGLE RECT-detail
     1067        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1068        SIZE 35.4 BY 7.57.
     1069   DEFINE VARIABLE Tot_Objects AS LOGICAL INITIAL no
     1070        LABEL "По объектам"
     1071        VIEW-AS TOGGLE-BOX
     1072        SIZE 20 BY 1 NO-UNDO.
     1073   DEFINE FRAME F-Main
     1074        RS-by AT ROW 2.7 COL 4.3 NO-LABEL
     1075        Tot_Objects AT ROW 4.7 COL 40.4
     1076        "Детализация" VIEW-AS TEXT
     1077             SIZE 19.3 BY .83 AT ROW 1.43 COL 40
     1078             FGCOLOR 4
     1079        "Классификация" VIEW-AS TEXT
     1080             SIZE 27.9 BY 1 AT ROW 1.43 COL 4.3
     1081             FGCOLOR 4
     1082        RECT-5 AT ROW 1.2 COL 38.6
     1083        RECT-detail AT ROW 1.13 COL 2.3
     1084       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
     1085            SIDE-LABELS NO-UNDERLINE THREE-D
     1086            AT COL 1 ROW 1
     1087            SIZE 73 BY 15.13.
     1088   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     1089   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     1090   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     1091   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     1092   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     1093   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     1094   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     1095   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     1096       ASSIGN adm-object-hdl = FRAME F-Main:HANDLE.
     1097   RUN ensure-broker.
     1098   THIS-PROCEDURE:ADM-DATA =
     1099        'ADM1.1~`':U +
     1100        'SmartObject~`':U +
     1101        'FRAME~`':U +
     1102        'NO ~`':U +
     1103        '~`':U +
     1104        '~`':U +
     1105        '~`':U +
     1106        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     1107           + "~`":U +
     1108        'Layout,Hide-on-Init~`':U +
     1109        '~`':U +
     1110        '~`':U +
     1111        '~`~`~`~`~`~`~`~`~`~`~`':U +
     1112        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1113            THEN "^^":U
     1114        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1115             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1116   PROCEDURE adm-apply-entry :
     1117     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1118   END PROCEDURE.
     1119   PROCEDURE adm-destroy :
     1120    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1121   END PROCEDURE.
     1122   PROCEDURE adm-disable :
     1123       DISABLE RECT-5 RECT-detail RS-by Tot_Objects WITH FRAME F-Main.
     1124       RUN dispatch ('disable-fields':U).
     1125       RUN set-attribute-list ('ENABLED=no':U).
     1126       RETURN.
     1127   END PROCEDURE.
     1128   PROCEDURE adm-edit-attribute-list :
     1129         RUN adm/support/contnrd.w (INPUT THIS-PROCEDURE).
     1130         RETURN.
     1131   END PROCEDURE.
     1132   PROCEDURE adm-enable :
     1133       ENABLE UNLESS-HIDDEN RECT-5 RECT-detail RS-by Tot_Objects WITH FRAME F-Main.
     1134       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     1135       RUN set-attribute-list ('ENABLED=yes':U).
     1136       RETURN.
     1137   END PROCEDURE.
     1138   PROCEDURE adm-exit :
     1139        RUN notify ('exit':U).
     1140     RETURN.
     1141   END PROCEDURE.
     1142   PROCEDURE adm-hide :
     1143     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1144   END PROCEDURE.
     1145   PROCEDURE adm-initialize :
     1146     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1147   END PROCEDURE.
     1148   PROCEDURE adm-show-errors :
     1149       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1150       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1151           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1152       END.
     1153       RETURN.
     1154   END PROCEDURE.
     1155   PROCEDURE adm-UIB-mode :
     1156     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1157   END PROCEDURE.
     1158   PROCEDURE adm-view :
     1159     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1160   END PROCEDURE.
     1161   PROCEDURE dispatch :
     1162       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1163       RUN broker-dispatch IN adm-broker-hdl
     1164           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1165       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1166   END PROCEDURE.
     1167   PROCEDURE ensure-broker :
     1168   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1169   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1170   DO:
     1171       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1172       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1173   END.
     1174   END PROCEDURE.
     1175   PROCEDURE get-attribute :
     1176     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1177     RUN broker-get-attribute IN adm-broker-hdl
     1178         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1179     RETURN RETURN-VALUE.
     1180   END PROCEDURE.
     1181   PROCEDURE get-attribute-list :
     1182     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1183     RUN broker-get-attribute-list IN adm-broker-hdl
     1184         (INPUT THIS-PROCEDURE,
     1185          INPUT ?,
     1186          OUTPUT p-attr-list) NO-ERROR.
     1187     RETURN.
     1188   END PROCEDURE.
     1189   PROCEDURE new-state :
     1190     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1191     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1192     RETURN.
     1193   END PROCEDURE.
     1194   PROCEDURE notify :
     1195     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1196     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1197     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1198         RETURN "ADM-ERROR":U.
     1199     RETURN.
     1200   END PROCEDURE.
     1201   PROCEDURE set-attribute-list :
     1202     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1203     RUN ensure-broker.
     1204     RUN broker-set-attribute-list IN adm-broker-hdl
     1205         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1206     RETURN.
     1207   END PROCEDURE.
     1208   PROCEDURE set-position :
     1209       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1210       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1211       IF VALID-HANDLE(adm-object-hdl) THEN
     1212       DO:
     1213           DEFINE VARIABLE parent-hdl AS HANDLE NO-UNDO.
     1214           IF adm-object-hdl:TYPE = "WINDOW":U THEN
     1215           DO:
     1216             IF p-row = 0 THEN p-row =
     1217               (SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2.
     1218             IF p-col = 0 THEN p-col =
     1219               (SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2.
     1220           END.
     1221           ELSE IF adm-object-hdl:TYPE = "DIALOG-BOX":U THEN
     1222           DO:
     1223             parent-hdl = adm-object-hdl:PARENT.
     1224             IF p-row = 0 THEN p-row =
     1225               ((SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2) -
     1226                 parent-hdl:ROW.
     1227             IF p-col = 0 THEN p-col =
     1228               ((SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2) -
     1229                 parent-hdl:COL.
     1230           END.
     1231           IF p-row GE 0 AND p-row < 1 THEN p-row = 1.
     1232           IF p-col GE 0 AND p-col < 1 THEN p-col = 1.
     1233         ASSIGN adm-object-hdl:ROW    =   p-row
     1234                adm-object-hdl:COLUMN =   p-col.
     1235       END.
     1236       RETURN.
     1237   END PROCEDURE.
     1238   RUN set-attribute-list ("CURRENT-PAGE=0,ADM-OBJECT-HANDLE=":U +
     1239       STRING(adm-object-hdl)).
     1240   PAUSE 0 BEFORE-HIDE.
     1241   PROCEDURE adm-change-page :
     1242     RUN broker-change-page IN adm-broker-hdl (INPUT THIS-PROCEDURE) NO-ERROR.
     1243     END PROCEDURE.
     1244   PROCEDURE delete-page :
     1245     DEFINE INPUT PARAMETER p-page# AS INTEGER NO-UNDO.
     1246     RUN broker-delete-page IN adm-broker-hdl
     1247         (INPUT THIS-PROCEDURE, INPUT p-page#).
     1248     END PROCEDURE.
     1249   PROCEDURE init-object :
     1250     DEFINE INPUT PARAMETER  p-proc-name   AS CHARACTER NO-UNDO.
     1251     DEFINE INPUT PARAMETER  p-parent-hdl  AS HANDLE    NO-UNDO.
     1252     DEFINE INPUT PARAMETER  p-attr-list   AS CHARACTER NO-UNDO.
     1253     DEFINE OUTPUT PARAMETER p-proc-hdl    AS HANDLE    NO-UNDO.
     1254     RUN broker-init-object IN adm-broker-hdl
     1255         (INPUT THIS-PROCEDURE, INPUT p-proc-name, INPUT p-parent-hdl,
     1256          INPUT p-attr-list, OUTPUT p-proc-hdl) NO-ERROR.
     1257     RETURN.
     1258   END PROCEDURE.
     1259   PROCEDURE init-pages :
     1260     DEFINE INPUT PARAMETER p-page-list      AS CHARACTER NO-UNDO.
     1261     RUN broker-init-pages IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1262         INPUT p-page-list) NO-ERROR.
     1263     END PROCEDURE.
     1264   PROCEDURE select-page :
     1265     DEFINE INPUT PARAMETER p-page#     AS INTEGER   NO-UNDO.
     1266     RUN broker-select-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1267         INPUT p-page#) NO-ERROR.
     1268     END PROCEDURE.
     1269   PROCEDURE view-page :
     1270     DEFINE INPUT PARAMETER p-page#      AS INTEGER   NO-UNDO.
     1271     RUN broker-view-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1272         INPUT p-page#).
     1273     END PROCEDURE.
     1274   if not this-procedure :persistent
     1275   then do:
     1276     message
     1277       vss-workfile vss-revision vss-description skip
     1278       "Ошибка при запуске процедуры" skip
     1279       "Данную процедуру следует запускать только с параметром persistent" skip
     1280       view-as alert-box error .
     1281     undo, return error .
     1282   end.
     1283   PROCEDURE adm-create-objects :
     1284   END PROCEDURE.
     1285   PROCEDURE adm-row-available :
     1286     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
     1287     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
     1288     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
     1289     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
     1290     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
     1291     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
     1292     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
     1293     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
     1294     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
     1295     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
     1296     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
     1297     IF adm-updating-record THEN RETURN.
     1298     RUN get-attribute ('FIELDS-ENABLED':U).
     1299     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
     1300     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
     1301         OUTPUT link-handle) NO-ERROR.
     1302     IF link-handle = "":U THEN
     1303         RETURN.
     1304     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
     1305     IF NUM-ENTRIES(link-handle) > 1 THEN
     1306         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
     1307             "encountered more than one RECORD-SOURCE.":U SKIP
     1308             "The first - ":U record-source-hdl:file-name " - will be used.":U
     1309                VIEW-AS ALERT-BOX ERROR.
     1310     RUN get-attribute ('Key-Name':U).
     1311     key-name = RETURN-VALUE.
     1312     IF key-name = "":U THEN key-name = ?.
     1313     IF key-name NE ? THEN DO:
     1314       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
     1315         NO-ERROR.
     1316       IF key-value NE ? THEN
     1317         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
     1318     END.
     1319   IF VALID-HANDLE (adm-object-hdl) THEN
     1320       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1321   RUN notify IN THIS-PROCEDURE ('row-available':U).
     1322   END PROCEDURE.
     1323   PROCEDURE disable_UI :
     1324     HIDE FRAME F-Main.
     1325     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1326   END PROCEDURE.
     1327   PROCEDURE enable_UI :
     1328     DISPLAY RS-by Tot_Objects
     1329         WITH FRAME F-Main.
     1330     ENABLE RECT-5 RECT-detail RS-by Tot_Objects
     1331         WITH FRAME F-Main.
     1332   END PROCEDURE.
     1333   PROCEDURE ini-from-selobj :
     1334   define variable num-obj-list as integer no-undo.
     1335   CASE X-SelectObject :
     1336     when "текущий" then do:
     1337       disable
     1338       Tot_objects
     1339       with frame F-Main.
     1340     end.
     1341     otherwise do:
     1342       for each obj-list no-lock:
     1343         num-obj-list = num-obj-list + 1.
     1344         if num-obj-list > 1 then leave.
     1345       end.
     1346       if num-obj-list > 1 then do:
     1347         enable
     1348         Tot_objects
     1349         with frame F-Main.
     1350       end.
     1351       else do:
     1352         disable
     1353         Tot_objects
     1354         with frame F-Main.
     1355       end.
     1356     end.
     1357   END CASE.
     1358   END PROCEDURE.
     1359   PROCEDURE local-initialize :
     1360    parparentproc = my-handle.
     1361   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1362     run mainmenu_getcntxt in parparentproc
     1363       (output v-cntxt-db-num
     1364       ,output v-cntxt-userid
     1365       ,output v-cntxt-level
     1366       ,output v-cntxt-host-code-obj
     1367       ,output v-cntxt-obj-type
     1368       ,output v-cntxt-obj-code
     1369       ,output v-cntxt-db-num-obj
     1370       ,output v-cntxt-is-admin
     1371       ) .
     1372     run dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     1373     run ini-from-selobj in this-procedure .
     1374   END PROCEDURE.
     1375   PROCEDURE My-report :
     1376   Run My-var in this-procedure .
     1377   run rep/r-srvsal.p (
     1378                    input my-handle
     1379                   ,input X-date-start
     1380                   ,input X-date-end
     1381                   ,input x-SelectGood
     1382                   ,input rs-by
     1383                   ,input tot_objects
     1384                   ,input reportheader
     1385                   )
     1386               .
     1387   END PROCEDURE.
     1388   PROCEDURE My-var :
     1389   define variable rs-by-str as character no-undo .
     1390   define variable tot_objects-str as character no-undo .
     1391   assign
     1392   frame F-Main Rs-By
     1393   frame F-Main Tot_objects
     1394   .
     1395   Assign
     1396    STR-obj-type = ''
     1397    STR-obj-code = ''
     1398    STR-obj-name = ''
     1399    STR-obj      = ''.
     1400   For each obj-list no-lock:
     1401    Assign
     1402    STR-obj-type = STR-obj-type + obj-list.obj-type + ','
     1403    STR-obj-code = STR-obj-code + String(obj-list.obj-code) + ','
     1404    STR-obj-name = STR-obj-name + obj-list.obj-name + ','
     1405    STR-obj = STR-obj +  obj-list.obj-type + '#' + string(obj-list.obj-code)  + ',' .
     1406   End.
     1407   assign
     1408   Rs-by-str =   radio-label(string(rs-by), rs-by:radio-buttons)
     1409   tot_objects-str = (if Tot_objects then (Tot_objects:label + " ") else "")
     1410   ReportHeader =  "Классификация: " + rs-by-str + chr(10) +
     1411                    (if Tot_Objects
     1412                    then ("Детализация: " + tot_objects-str
     1413                         )
     1414                    else ""
     1415                   ).
     1416   END PROCEDURE.
     1417   PROCEDURE send-records :
     1418   END PROCEDURE.
     1419   PROCEDURE state-changed :
     1420     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE NO-UNDO.
     1421     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1422     CASE p-state:
     1423       WHEN "link-changed" then do:
     1424         run ini-from-selobj in this-procedure .
     1425       end.
     1426     END CASE.
     1427   END PROCEDURE.
