     1212   .
     1213   define buffer buf2_gds-grp for ub.gds-grp  .
     1214   define variable first-lavel as integer   no-undo .
     1215   define variable v-sum-prc as decimal   no-undo .
     1216   find first ub.gds-grp where  ub.gds-grp.upper-code = 0 no-lock no-error .
     1217   if avail   ub.gds-grp then   first-lavel = ub.gds-grp.node-code.
     1218                      else   first-lavel = 0.
     1219   define variable var-i as integer   no-undo .
     1220   define variable var-kol as integer   no-undo .
     1221   define variable number-group as character no-undo .
     1222   define variable i-numb as integer   no-undo .
     1223   var-kol = num-entries (p-rez).
     1224   repeat var-i = 1 to var-kol :
     1225      find first buf_abc-analysis no-lock where recid(buf_abc-analysis) = int(entry(var-i,p-rez )) no-error .
     1226      if not available buf_abc-analysis  then next.
     1227      find first  buf_criterion-analysis no-lock where buf_criterion-analysis.cral-id = buf_abc-analysis.cral-id no-error .
     1228      if not available buf_criterion-analysis  then next.
     1229       create temp-abc.
