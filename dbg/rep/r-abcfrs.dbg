     1299                                else assign pp = "Цены  баз.вал." .
     1300   define variable v-account as integer init 0 no-undo .
     1301   define variable v-account-lavel as character no-undo .
     1302   define variable v-button-stop as logical no-undo .
     1303   define variable v-kol-spice as integer no-undo .
     1304   define variable v-kol-spice2 as integer no-undo .
     1305   define variable v-kol-spice3 as integer no-undo .
     1306   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     1307   DEFINE BUTTON StopBtn AUTO-END-KEY
     1308        LABEL "Стоп"
     1309        SIZE 10 BY 1.
     1310   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     1311        LABEL "Обработано записей"
     1312         VIEW-AS TEXT
     1313        SIZE 14 BY .67 NO-UNDO.
     1314   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     1315         VIEW-AS TEXT
     1316        SIZE 53.25 BY .67
     1317        FGCOLOR 1  NO-UNDO.
     1318   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     1319         VIEW-AS TEXT
     1320        SIZE 53.25 BY .67
     1321        FGCOLOR 1  NO-UNDO.
     1322   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     1323         VIEW-AS TEXT
     1324        SIZE 53.25 BY .67
     1325        FGCOLOR 1  NO-UNDO.
     1326   DEFINE RECTANGLE RECT-1
     1327        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1328        SIZE 55.13 BY 4.46.
     1329   DEFINE FRAME InfoFrame
     1330        StopBtn AT ROW 4.25 COL 21.75
     1331        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     1332        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     1333        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     1334        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     1335        RECT-1 AT ROW 1 COL 1
     1336       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1337            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1338            TITLE "Процесс"
     1339            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     1340   define variable mFrameView      as logical   no-undo init yes.
     1341     define variable mFramHandle as handle no-undo.
     1342     mFramHandle = frame InfoFrame:handle.
     1343     if  log-manager:logfile-name ne ?
     1344     then DO:
     1345         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1346         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1347         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     1348     end.
     1349     mFrameView = not session:batch-mode and mFramHandle:visible.
     1350     if mFrameView
     1351     then do:
     1352       ASSIGN
     1353          FRAME InfoFrame:HIDDEN                           = TRUE
     1354          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     1355     end.
     1356   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     1357   DO:
     1358     IF not StopProcessing THEN
     1359       Message "Вы действительно хотите прервать" SKIP
     1360               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     1361                 UPDATE StopProcessing.
     1362     IF StopProcessing THEN do:
     1363        if mFrameView
     1364        then do:
     1365           HIDE FRAME InfoFrame.
     1366        end.
     1367     End.
     1368   END.
     1369   assign v-account = ( if integer( 25 ) = 0 then 100 else integer( 25 ) ).
     1370     if  log-manager:logfile-name ne ?
     1371     then DO:
     1372         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     1373     end.
     1374     if not session:batch-mode then
     1375     do:
     1376       VIEW FRAME InfoFrame.
     1377       mFrameView = true.
     1378     end.
     1379      v-button-stop = false .
     1380         if mFrameView
     1381         then do:
     1382         if v-button-stop then view STOPBTN in frame InfoFrame.
     1383                          else Hide STOPBTN in frame InfoFrame.
     1384         end.
     1385   v-ind = 0    .
     1386    run paramls-clear in this-procedure .
     1387    run paramls-write in this-procedure
     1388       (input 'rowsgroup-enable':u
     1389       ,input '':u
     1390       ,input 'yes':u
     1391       ) .
     1392       Output stream Macr_Excel  close .
     1393       num#str# = 0 .
     1394       run gbl/_tmpfile.p ( "wb", ".txt", output v-file-name) .
     1395       output stream macr_excel to value(v-file-name)   .
     1396       v-ind = v-ind + 1.
     1397    run get-report-num in parParentProc(output g#report-num).
     1398       define stream  Stream-rpt .
     1399       p-file-name =  string( session:temp-directory +
     1400                     "rpt" + string( g#report-num ) + ".txt" ) .
     1401       output stream stream-rpt to value(p-file-name)   .
     1402       output stream stream-rpt close  .
     1403     run PrintTitul in this-procedure .
     1404     for each temp-str :  delete temp-str.  end.
     1405     run make-tt in this-procedure .
     1406     define variable v-row as integer   no-undo .
     1407     for each temp-grp1 :
     1408        i-numb = i-numb + 1 .
     1409        number-group = string(i-numb,"99999") .
     1410         run print-grp-name in this-procedure ( output v-row ) .
     1411         for each temp-str where temp-str.node-code =  temp-grp1.grp-code  no-lock :
     1412             run print-line in this-procedure .
     1413         end.
     1414         run print-grp-itogo in this-procedure (input v-row ) .
     1415      end.
     1416     run PrintPodval in this-procedure .
     1417     run paramls-write in this-procedure
     1418       (input "file"
     1419       ,input string(v-ind)
     1420       ,input v-file-name
     1421       ) .
     1422   Output stream Macr_Excel  close .
     1423   if mFrameView
     1424   then do:
     1425      HIDE FRAME InfoFrame.
     1426   end.
     1427       run paramls-write in this-procedure
     1428           (input "charcol"
     1429           ,input ""
     1430           ,input "1,3,4,5,6"
     1431           ) .
     1432     run end-proc in this-procedure .
     1433     run rep/runexcel.p (p-file-name ).
     1434   procedure print-line :
     1435     do on error undo, return error return-value :
     1436   num#str# = num#str# + 1.
     1437   num#col# = 1.
     1438   run macr_excel_char in this-procedure ( temp-str.artic     , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1439   run macr_excel_char in this-procedure ( temp-str.gds-code  , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1440   run macr_excel_char in this-procedure ( temp-str.gds-name  , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1441   run macr_excel_char in this-procedure ( temp-str.grp-name  , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1442   run macr_excel_char in this-procedure ( temp-str.prod-name , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1443   for each temp-abc:
     1444     find first ub.abc-analysis-goods no-lock where
     1445                ub.abc-analysis-goods.abc-id = temp-abc.id and
     1446                ub.abc-analysis-goods.db-num = temp-abc.db-num and
     1447                ub.abc-analysis-goods.gds-code = temp-STR.gds-code no-error .
     1448     if available ub.abc-analysis-goods then do:
     1449        run macr_excel_char in this-procedure ( ub.abc-analysis-goods.abcg-abc + string(ub.abc-analysis-goods.rating) , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1450        run macr_excel_DEC in this-procedure  ( ub.abc-analysis-goods.proc-from-all , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1451        run macr_excel_DEC in this-procedure  ( ub.abc-analysis-goods.abcg-sum-for-estimate   , num#str# , num#col#   ) .
     1452   define variable v-color as integer   no-undo .
     1453       if ub.abc-analysis-goods.abcg-abc = "A" then
     1454          assign
     1455            v-color = 3
     1456          .
     1457       if ub.abc-analysis-goods.abcg-abc = "C" then
     1458          assign
     1459            v-color = 0
     1460          .
     1461       if ub.abc-analysis-goods.abcg-abc = "B" then
     1462          assign
     1463             v-color = 41
     1464          .
     1465       if ub.abc-analysis-goods.abcg-abc = "D" then
     1466          assign
     1467            v-color = 14
     1468          .
     1469       if ub.abc-analysis-goods.abcg-abc = "E" then
     1470          assign
     1471            v-color = 13
     1472          .
     1473       if ub.abc-analysis-goods.abcg-abc = "F" then
     1474          assign
     1475             v-color = 48
     1476          .
     1477      put  stream macr_excel unformatted
     1478           substitute('select("r&1c&2:r&3c&4 ")' , num#str# , num#col# - 2 , num#str# , num#col# ) + chr(10)
     1479           substitute('font.properties(,,,,,,,,,&1,,,)', v-color ) + chr(10) .
     1480        assign    num#col# = num#col# + 1 .
     1481     end.
     1482     ELSE
     1483     num#col# = num#col# + 3 .
     1484   end.
     1485     end.
     1486   end procedure.
     1487   procedure print-all-itog :
     1488   end procedure.
     1489   procedure PrintTitul :
     1490     do  on error undo, return error return-value  :
     1491     define variable cc as integer no-undo .
     1492     define variable tt as integer no-undo .
     1493       num#str# = num#str# + 1.
     1494       num#col# = 2.
     1495       cc = num#str# .
     1496       run macr_excel_char in this-procedure ( "Сравнение ABC анализов по группам товаров"  , num#str# , num#col#   ) .
     1497       num#str# = num#str# + 1.
     1498       num#col# = 2.
     1499       run macr_excel_char in this-procedure ("Печать " + cur-time-date()  , num#str# , num#col#   ) .
     1500       run macr_cell_format in this-procedure
     1501           ( 12     ,
     1502             true   ,
     1503             false  ,
     1504             ?      ,
     1505             cc     ,
     1506             2      ,
     1507             num#str# ,
     1508             2 ) .
     1509       run pshap in this-procedure .
     1510        num#str# = num#str# + 1.
     1511       num#col# = 1.
     1512       run macr_excel_char in this-procedure ( "Артикул товара"   , num#str# , num#col#   ) .
     1513       run macr_cell_size in this-procedure  ( 10 , ? , num#str# , num#col# , ?, ? ) .
     1514       num#col# = 2.
     1515       run macr_excel_char in this-procedure ( "Код"   , num#str# , num#col#   ) .
     1516       run macr_cell_size in this-procedure  ( 10 , ? , num#str# , num#col# , ?, ? ) .
     1517       num#col# = 3.
     1518       run macr_excel_char in this-procedure ( "ТМЦ"   , num#str# , num#col#   ) .
     1519       run macr_cell_size in this-procedure  ( 25 , ? , num#str# , num#col# , ?, ? ) .
     1520       num#col# = 4.
     1521       run macr_excel_char in this-procedure ( "Группа"   , num#str# , num#col#   ) .
     1522       run macr_cell_size in this-procedure  ( 32 , ? , num#str# , num#col# , ?, ? ) .
     1523       num#col# = 5.
     1524       run macr_excel_char in this-procedure ( "Производитель"   , num#str# , num#col#   ) .
     1525       run macr_cell_size in this-procedure  ( 20 , ? , num#str# , num#col# , ?, ? ) .
     1526       for each temp-abc :
     1527           num#col# = num#col# + 1.
     1528           run macr_excel_char in this-procedure ( "Анализ № " + string(temp-abc.nn) , num#str# , num#col#   ) .
     1529           run macr_cell_size in this-procedure  ( 10 , ? , num#str# , num#col# , ?, ? ) .
     1530           num#col# = num#col# + 1.
     1531           run macr_excel_char in this-procedure (  "%"  , num#str# , num#col#   ) .
     1532           run macr_cell_size in this-procedure  ( 5 , ? , num#str# , num#col# , ?, ? ) .
     1533           num#col# = num#col# + 1.
     1534           run macr_excel_char in this-procedure ( "Сумма по критерию"  , num#str# , num#col#   ) .
     1535           run macr_cell_size in this-procedure  ( 15 , ? , num#str# , num#col# , ?, ? ) .
     1536           if temp-abc.nn modulo 2 = 0 then do:
     1537               run macr_cell_format in this-procedure
     1538               ( 10    ,
     1539                 true  ,
     1540                 false  ,
     1541                 33    ,
     1542                 num#str# ,
     1543                 num#col# - 2 ,
     1544                 num#str# ,
     1545                 num#col# ) .
     1546           end.
     1547           else do:
     1548               run macr_cell_format in this-procedure
     1549               ( 10    ,
     1550                 true  ,
     1551                 false  ,
     1552                 34    ,
     1553                 num#str# ,
     1554                 num#col# - 2 ,
     1555                 num#str# ,
     1556                 num#col# ) .
     1557           end.
     1558       end.
     1559       run macr_cell_format in this-procedure
     1560       ( 10    ,
     1561         true  ,
     1562         false  ,
     1563         ?    ,
     1564         num#str# ,
     1565         1 ,
     1566         num#str# ,
     1567         14 ) .
     1568        put  stream macr_excel unformatted
     1569          substitute('select("r&1c&2:r&3c&4 ")' , num#str# , 1 , num#str# ,  num#col# ) + chr(10)  +
     1570          'BORDER( 2 , 2 , 2 , 2 , 2 , ,0,0,0,0,0) '  + chr(10) +
     1571          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     1572          .
     1573     end.
     1574   end procedure.
     1575   procedure PrintPodval :
     1576     do on error undo, return error return-value  :
     1577       num#str# = num#str# + 3.
     1578       num#col# = 2.
     1579       run macr_excel_char in this-procedure ( "Исполнитель"   , num#str# , num#col#   ) .
     1580     end.
     1581   end procedure.
     1582   procedure make-tt :
     1583     do
     1584     on error undo, return error return-value
     1585     :
     1586   define buffer buf_abc-analysis-goods  for ub.abc-analysis-goods.
     1587   define buffer buf_goods               for ub.goods.
     1588   define buffer buf_clients             for ub.clients  .
     1589   define variable  v-izt      as character no-undo .
     1590   define variable  v-acc-mat as character no-undo .
     1591   define variable  v-Amin    as character no-undo .
     1592   for each temp-abc :
     1593     for each buf_abc-analysis-goods no-lock where
     1594              buf_abc-analysis-goods.abc-id = temp-abc.id  and
     1595              buf_abc-analysis-goods.db-num = temp-abc.db-num :
     1596       if not can-find ( first temp-str where temp-str.gds-code  = buf_abc-analysis-goods.gds-code) then do:
     1597           find first buf_goods no-lock where buf_goods.gds-code =  buf_abc-analysis-goods.gds-code no-error .
     1598           find first buf_clients no-lock where buf_clients.obj-type = buf_goods.prod-type and buf_clients.obj-code = buf_goods.prod-code no-error .
     1599           create temp-str .
     1600           assign
     1601               temp-str.prc       = buf_abc-analysis-goods.abcg-prcnt-for-estimate
     1602               temp-str.gds-code  = buf_abc-analysis-goods.gds-code
     1603               temp-str.artic     = buf_goods.artic
     1604               temp-str.gds-name  = buf_goods.gds-name
     1605               temp-str.grp-code  = buf_goods.grp-code
     1606               temp-str.grp-name  = buf_goods.grp-name
     1607               temp-str.prod-name = buf_clients.obj-name
     1608           .
     1609       end.
     1610     end.
     1611     for each buf_abc-analysis-grp no-lock where
     1612              buf_abc-analysis-grp.abc-id = temp-abc.id  and
     1613              buf_abc-analysis-grp.db-num = temp-abc.db-num :
     1614       if not can-find ( first temp-grp where temp-grp.grp-code  = buf_abc-analysis-grp.grp-code) then do:
     1615           find first buf_gds-grp no-lock where buf_gds-grp.node-code =  buf_abc-analysis-grp.grp-code no-error .
     1616           create temp-grp .
     1617           assign
     1618               temp-grp.prc        = buf_abc-analysis-grp.abcg-prcnt-for-estimate
     1619               temp-grp.grp-code   = buf_gds-grp.node-code
     1620               temp-grp.is-term    = buf_gds-grp.is-term
     1621               temp-grp.lvl-num    = buf_gds-grp.lvl-num
     1622               temp-grp.node-name  = buf_gds-grp.node-name
     1623               temp-grp.upper-code = buf_gds-grp.upper-code
     1624           .
     1625       end.
     1626     end.
     1627   end.
     1628       FOR EACH temp-str  BY temp-str.grp-name :
     1629           find first temp-grp1 where temp-grp1.grp-name  = n-lavel(temp-str.grp-name , 1 ) no-error .
     1630           if not available temp-grp1 then do:
     1631               create temp-grp1.
     1632               assign
     1633                 temp-grp1.grp-name  = n-lavel(temp-str.grp-name , 1 ) .
     1634               .
     1635           end.
     1636       END.
     1637   for each temp-abc :
     1638     v-sum-prc = 0 .
     1639     for each temp-grp1 :
     1640           for each buf_abc-analysis-goods no-lock where
     1641                   buf_abc-analysis-goods.abc-id = temp-abc.id  and
     1642                   buf_abc-analysis-goods.db-num = temp-abc.db-num ,
     1643             first temp-str where
     1644                   temp-str.gds-code = buf_abc-analysis-goods.gds-code and
     1645                   temp-str.grp-name begins temp-grp1.grp-name :
     1646                 v-sum-prc = v-sum-prc + temp-str.prc .
     1647           end.
     1648           if v-sum-prc = 0 then delete temp-grp1.
     1649                            else do:
     1650                                temp-grp1.prc = v-sum-prc .
     1651                            end.
     1652     end.
     1653   end.
     1654     end.
     1655   end procedure.
     1656   procedure pshap :
     1657     do
     1658     on error undo, return error return-value
     1659     :
     1660     define variable tt as integer   no-undo .
     1661       num#str# = num#str# + 1.
     1662       num#col# = 1.
     1663       tt = num#str# .
     1664       for each temp-abc :
     1665           run macr_excel_char in this-procedure ( "Анализ № " + string(temp-abc.nn )                , num#str# , num#col#   ) .
     1666               run macr_cell_format in this-procedure
     1667               ( 10    ,
     1668                 true  ,
     1669                 false  ,
     1670                 ?    ,
     1671                 num#str# ,
     1672                 num#col#  ,
     1673                 num#str# ,
     1674                 num#col# ) .
     1675           num#str# = num#str# + 1.
     1676           run macr_excel_char in this-procedure ( temp-abc.name               , num#str# , num#col#   ) . num#str# = num#str# + 1.
     1677           if temp-abc.des <> "" then do:  run macr_excel_char( temp-abc.des                , num#str# , num#col#   ) . num#str# = num#str# + 1. end.
     1678           run macr_excel_char in this-procedure ( temp-abc.name-cral          , num#str# , num#col#   ) . num#str# = num#str# + 1.
     1679           run macr_excel_char in this-procedure ( "A=" + string( temp-abc.A )                 , num#str# , num#col#   ) . num#str# = num#str# + 1.
     1680           run macr_excel_char in this-procedure ( "B=" + string( temp-abc.B )                 , num#str# , num#col#   ) . num#str# = num#str# + 1.
     1681           run macr_excel_char in this-procedure ( "C=" + string( temp-abc.C )                 , num#str# , num#col#   ) . num#str# = num#str# + 1.
     1682           if temp-abc.D > 0 then do:  run macr_excel_char in this-procedure ( "D=" + string(temp-abc.D )   , num#str# , num#col#   ) .    num#str# = num#str# + 1. end.
     1683           if temp-abc.E > 0 then do:  run macr_excel_char in this-procedure ( "E=" + string(temp-abc.E )   , num#str# , num#col#   ) .    num#str# = num#str# + 1. end.
     1684           if temp-abc.F > 0 then do:  run macr_excel_char in this-procedure ( "F=" + string(temp-abc.F )   , num#str# , num#col#   ) .    num#str# = num#str# + 1. end.
     1685           if temp-abc.type <> " " then do: run macr_excel_char in this-procedure ( temp-abc.type          , num#str# , num#col#   ) .  num#str# = num#str# + 1.    end.
     1686           run macr_excel_char in this-procedure ( "создан : " + string(temp-abc.date-cr , "99/99/9999")            , num#str# , num#col#   ) . num#str# = num#str# + 1.
     1687           run macr_excel_char in this-procedure ( temp-abc.period             , num#str# , num#col#   ) .  num#str# = num#str# + 1.
     1688           run macr_excel_char in this-procedure ( temp-abc.ext-doc-type       , num#str# , num#col#   ) .  num#str# = num#str# + 1.
     1689           run macr_excel_char in this-procedure ( temp-abc.obj                , num#str# , num#col#   ) .  num#str# = num#str# + 1.
     1690       end.
     1691     end.
     1692   end procedure.
     1693   procedure print-grp-name :
     1694   define output parameter p-row as integer   no-undo .
     1695     do
     1696     on error undo, return error return-value
     1697     :
     1698   num#str# = num#str# + 1.
     1699   num#col# = 1.
     1700   run macr_excel_char in this-procedure (  temp-grp1.grp-name   , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1701    assign    num#col# = num#col# + 1 .
     1702    assign    num#col# = num#col# + 1 .
     1703   run macr_excel_char in this-procedure ( ""     , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1704       run macr_cell_format  in this-procedure
     1705           ( 12     ,
     1706             true   ,
     1707             false  ,
     1708             48      ,
     1709             num#str# ,
     1710             1      ,
     1711             num#str# ,
     1712             11 ) .
     1713   p-row =  num#str# .
     1714     end.
     1715   end procedure.
     1716   procedure print-grp-itogo :
     1717   define input  parameter p-row as integer   no-undo .
     1718     do
     1719     on error undo, return error return-value
     1720     :
     1721     run paramls-write in this-procedure
     1722       (input "rowsgroup"
     1723       ,input string(v-ind) + ',':u + number-group
     1724       ,input substitute('&1:&2' ,  p-row, num#str# )
     1725       ) .
     1726   num#str# = num#str# + 1.
     1727   num#col# = 1.
     1728       run macr_cell_format in this-procedure
     1729           ( ?     ,
     1730             true   ,
     1731             false  ,
     1732             ?      ,
     1733             num#str# ,
     1734             1      ,
     1735             num#str# ,
     1736             11 ) .
     1737   define variable v-full-name as character no-undo .
     1738   run grplib-get-full-name in this-procedure  ( input temp-grp.grp-code , output v-full-name ) .
     1739   run macr_excel_char in this-procedure (  temp-grp1.grp-name    , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1740    assign    num#col# = num#col# + 1 .
     1741    assign    num#col# = num#col# + 1 .
     1742   run macr_excel_char in this-procedure ( "" , num#str# , num#col#   ) . assign num#col# = num#col# + 1 .
     1743   run macr_excel_char in this-procedure ( ""                  , num#str# , num#col#   ) . assign num#col# = num#col# + 1 .
     1744   for each temp-abc:
     1745     find first ub.abc-analysis-grp no-lock where
     1746                ub.abc-analysis-grp.abc-id = temp-abc.id and
     1747                ub.abc-analysis-grp.db-num = temp-abc.db-num and
     1748                ub.abc-analysis-grp.grp-code = temp-grp.grp-code no-error .
     1749     if available ub.abc-analysis-grp then do:
     1750        run macr_excel_char in this-procedure ( ub.abc-analysis-grp.abcg-abc + string(ub.abc-analysis-grp.rating) , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1751        run macr_excel_DEC in this-procedure  ( ub.abc-analysis-grp.proc-from-all , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1752        run macr_excel_DEC in this-procedure  ( ub.abc-analysis-grp.abcg-sum-for-estimate   , num#str# , num#col#   ) .
     1753   define variable v-color as integer   no-undo .
     1754       if ub.abc-analysis-grp.abcg-abc = "A" then
     1755          assign
     1756            v-color = 3
     1757          .
     1758       if ub.abc-analysis-grp.abcg-abc = "C" then
     1759          assign
     1760            v-color = 0
     1761          .
     1762       if ub.abc-analysis-grp.abcg-abc = "B" then
     1763          assign
     1764             v-color = 41
     1765          .
     1766       if ub.abc-analysis-grp.abcg-abc = "D" then
     1767          assign
     1768            v-color = 14
     1769          .
     1770       if ub.abc-analysis-grp.abcg-abc = "E" then
     1771          assign
     1772            v-color = 13
     1773          .
     1774       if ub.abc-analysis-grp.abcg-abc = "F" then
     1775          assign
     1776             v-color = 48
     1777          .
     1778      put  stream macr_excel unformatted
     1779           substitute('select("r&1c&2:r&3c&4 ")' , num#str# , num#col# - 2 , num#str# , num#col# ) + chr(10)
     1780           substitute('font.properties(,,,,,,,,,&1,,,)', v-color ) + chr(10)
     1781           .
     1782        assign    num#col# = num#col# + 1 .
     1783     end.
     1784     ELSE
     1785     num#col# = num#col# + 3 .
     1786   end.
     1787     end.
     1788   end procedure.
     1789   def var vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1790   procedure macr_excel_char :
     1791    do
     1792    on error undo, return error return-value
     1793    :
     1794    define input parameter  p-val as character no-undo .
     1795    define input parameter  p-row as integer no-undo .
     1796    define input parameter  p-col as integer no-undo .
     1797    if p-val = ? then p-val = "" .
     1798       put stream macr_excel unformatted
     1799             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     1800    end.
     1801   end procedure.
     1802   procedure macr_excel_char_with_format :
     1803    do
     1804    on error undo, return error return-value
     1805    :
     1806    define input parameter  p-val as character no-undo .
     1807    define input parameter  p-row as integer no-undo .
     1808    define input parameter  p-col as integer no-undo .
     1809    if p-val = ? then p-val = "" .
     1810       put stream macr_excel unformatted
     1811             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     1812       put stream macr_excel unformatted 'format.number("@")' + chr(10) .
     1813       put stream macr_excel unformatted
     1814             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     1815    end.
     1816   end procedure.
     1817   procedure macr_excel_cell_format :
     1818    do
     1819    on error undo, return error return-value
     1820    :
     1821    define input parameter  p-val    as character no-undo .
     1822    define input parameter  p-row    as integer   no-undo .
     1823    define input parameter  p-col    as integer   no-undo .
     1824    define input parameter  p-format as character no-undo .
     1825    if p-val = ? then p-val = "" .
     1826       put stream macr_excel unformatted
     1827             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     1828       put stream macr_excel unformatted substitute('format.number("&1")', p-format) + chr(10) .
     1829       put stream macr_excel unformatted
     1830             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     1831    end.
     1832   end procedure.
     1833   procedure macr_excel_sum :
     1834    do
     1835    on error undo, return error return-value
     1836    :
     1837    define input parameter  p-row as integer no-undo .
     1838    define input parameter  p-col as integer no-undo .
     1839    define input parameter  p-row1 as integer no-undo .
     1840    define input parameter  p-col1 as integer no-undo .
     1841    define input parameter  p-row2 as integer no-undo .
     1842    define input parameter  p-col2 as integer no-undo .
     1843       put stream macr_excel unformatted
     1844             substitute('formula("=sum(r&3c&4:r&5c&6)","r&1c&2")', p-row , p-col , p-row1 , p-col1 ,p-row2 , p-col2 ) + chr(10)  .
     1845    end.
     1846   end procedure.
     1847   procedure macr_excel_dec :
     1848    do
     1849    on error undo, return error return-value
     1850    :
     1851    define input parameter  p-val as character no-undo .
     1852    define input parameter  p-row as integer   no-undo .
     1853    define input parameter  p-col as integer   no-undo .
     1854     if p-val = ? then p-val =  "" .
     1855      put  stream macr_excel unformatted
     1856           substitute('formula(&3,"r&1c&2")', p-row , p-col ,  p-val )  + chr(10) .
     1857    end.
     1858   end procedure.
     1859   procedure macr_cell_format :
     1860    do
     1861    on error undo, return error return-value
     1862    :
     1863    define input parameter  p-size   as integer   no-undo .
     1864    define input parameter  p-bold   as logical   no-undo .
     1865    define input parameter  p-italic as logical   no-undo .
     1866    define input parameter  p-color  as integer   no-undo .
     1867    define input parameter  p-row    as integer   no-undo .
     1868    define input parameter  p-col    as integer   no-undo .
     1869    define input parameter  p-row-2  as integer   no-undo .
     1870    define input parameter  p-col-2  as integer   no-undo .
     1871     if p-size = ? then p-size = 10 .
     1872     if p-bold = ? then p-bold = false .
     1873     if p-italic = ? then p-italic = false .
     1874     if p-row-2 = ? then p-row-2 = p-row .
     1875     if p-col-2 = ? then p-col-2 = p-col .
     1876     put  stream macr_excel unformatted
     1877      substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 ) + chr(10) .
     1878     if p-color <> ? then do:
     1879        put  stream macr_excel unformatted
     1880          substitute('patterns(1,,&1,true)', p-color ) + chr(10)  .
     1881     end.
     1882     put  stream macr_excel unformatted
     1883          substitute('format.font(,&1,&2,&3)' , p-size,
     1884                                           string ( p-bold  , "true/false" ) ,
     1885                                           string ( p-italic , "true/false" )
     1886                                           ) + chr(10) .
     1887    end.
     1888   end procedure.
     1889   procedure macr_cell_size :
     1890    do
     1891    on error undo, return error return-value
     1892    :
     1893    define input parameter  p-w   as integer   no-undo .
     1894    define input parameter  p-l   as integer   no-undo .
     1895    define input parameter  p-row    as integer   no-undo .
     1896    define input parameter  p-col    as integer   no-undo .
     1897    define input parameter  p-row-2  as integer   no-undo .
     1898    define input parameter  p-col-2  as integer   no-undo .
     1899     if p-row-2 = ? then p-row-2 = p-row .
     1900     if p-col-2 = ? then p-col-2 = p-col .
     1901     if p-w = ? then    p-w = 0 .
     1902     if p-l = ? then    p-l = 0 .
     1903    define variable s-w as character no-undo .
     1904    define variable s-l as character no-undo .
     1905    if p-w = 0 then s-w = "" .
     1906               else s-w = string(p-w)  .
     1907    if p-l = 0 then s-l = "" .
     1908               else s-l = string(p-l)  .
     1909   put  stream macr_excel unformatted
     1910        substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 )  skip .
     1911   put  stream macr_excel unformatted
     1912        substitute('COLUMN.WIDTH(&1,,,,)' , s-w  )  skip.
     1913   put  stream macr_excel unformatted
     1914        'FORMAT.TEXT(2,2,0,,,,,)'  skip.
     1915    end.
     1916   end procedure.
     1917   procedure proc-print-header :
     1918    do
     1919    on error undo, return error return-value
     1920    :
     1921      find first sheetf .
     1922        sheetf.excel-row-heder =  num-entries( c-str ,chr(10)) + 1.
     1923        sheetf.excel-row-title =  num-entries( sheetf.excel-column-lable , chr(10) ).
     1924        var-1 =  num#str# .
     1925        repeat c-c = 1 to sheetf.excel-row-title :
     1926        num#str# = num#str# + 1 .
     1927        p-var = num-entries( entry (c-c, sheetf.excel-column-lable, chr(10)) , chr(44) ) .
     1928        do c-i = 1 to p-var :
     1929           str--1 = entry( c-i, entry (c-c,sheetf.excel-column-lable, chr(10)) , chr(44)) .
     1930           str--2 = integer(entry( c-i, sheetf.sizes )) .
     1931           num#col# = c-i .
     1932           run macr_excel_char_with_format ( str--1  , num#str# , num#col#  ) .
     1933           run macr_cell_size ( str--2 , ? , num#str# , num#col# , ?, ? ) .
     1934        end.
     1935       c-i = 0.
     1936       end.
     1937       run macr_cell_format (
     1938           10       ,
     1939           true     ,
     1940           false    ,
     1941           35       ,
     1942           var-1 + 1,
     1943           1        ,
     1944           num#str# ,
     1945           num#col# )
     1946           .
     1947     put  stream macr_excel unformatted
     1948          substitute('select("r&1c&2:r&3c&4 ")' , var-1 + 1 , 1 , num#str# ,  num#col# ) + chr(10)  +
     1949          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     1950          .
     1951    end.
     1952   end procedure.
     1953   procedure end-proc :
     1954    do
     1955    on error undo, return error return-value
     1956    :
     1957     v-file-name = ( string( session:temp-directory + "rpt" + string( g#report-num ) ) + ".t-t").
     1958     OUTPUT to VALUE (v-file-name) .
     1959     for each temp-param :
     1960       export  temp-param  .
     1961     end.
     1962    end.
     1963   end procedure.
