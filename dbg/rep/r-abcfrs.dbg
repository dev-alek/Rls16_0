     1285   def var j as int no-undo.
     1286   define variable Counter1 as integer init 0  no-undo .
     1287   def var LineBuf       as char    no-undo.
     1288   def var Line       as char    no-undo.
     1289   def var UndLine    as char    no-undo.
     1290   def var Lines_Counter as   int  init 0  no-undo.
     1291   def var Tmp_Counter   as   int  init 0  no-undo.
