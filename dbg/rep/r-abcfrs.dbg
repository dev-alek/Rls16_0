      821   def var vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      822   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
      823   procedure paramls-clear :
      824     define buffer buf_temp-param for temp-param .
      825     do
      826     on error undo, return error return-value
      827     :
      828       for each buf_temp-param
      829       on error undo, return error
      830       :
      831         delete buf_temp-param .
      832       end.
      833     end.
      834   end procedure.
      835   procedure paramls-write :
      836     define input  parameter p-code     as character no-undo .
      837     define input  parameter p-sub-code as character no-undo .
      838     define input  parameter p-value    as character no-undo .
      839     define buffer buf_temp-param for temp-param .
      840     do
      841     on error undo, return error return-value
      842     :
      843       find first buf_temp-param
      844         where buf_temp-param.param-code     = p-code
      845           and buf_temp-param.param-sub-code = p-sub-code
      846         no-error .
      847       if not available buf_temp-param then do:
      848         create buf_temp-param .
      849         assign
      850           buf_temp-param.param-code     = p-code
      851           buf_temp-param.param-sub-code = p-sub-code
      852         .
      853       end.
      854       assign
      855         buf_temp-param.param-value = p-value
      856       .
      857     end.
      858   end procedure.
      859   procedure paramls-read :
      860     define input  parameter p-code          as character no-undo .
      861     define input  parameter p-sub-code      as character no-undo .
      862     define input  parameter p-default-value as character no-undo .
      863     define output parameter p-value         as character no-undo .
      864     define buffer buf_temp-param for temp-param .
      865     do
      866     on error undo, return error return-value
      867     :
      868       find first buf_temp-param
      869         where buf_temp-param.param-code     = p-code
      870           and buf_temp-param.param-sub-code = p-sub-code
      871         no-error .
      872       if available buf_temp-param then do:
      873         assign
      874           p-value = buf_temp-param.param-value
      875         .
      876       end.
      877       else do:
      878         assign
      879           p-value = p-default-value
      880         .
      881       end.
      882     end.
      883   end procedure.
      884   procedure paramls-append :
      885     define input  parameter p-code     as character no-undo .
      886     define input  parameter p-sub-code as character no-undo .
      887     define input  parameter p-value    as character no-undo .
      888     define buffer buf_temp-param for temp-param .
      889     do
      890     on error undo, return error return-value
      891     :
      892       find first buf_temp-param
      893            where buf_temp-param.param-code     = p-code
      894              and buf_temp-param.param-sub-code = p-sub-code
      895         no-error .
      896       if not available buf_temp-param then do:
      897         create buf_temp-param .
      898         assign
      899           buf_temp-param.param-code     = p-code
      900           buf_temp-param.param-sub-code = p-sub-code
      901           buf_temp-param.param-value    = p-value
      902         .
      903       end.
      904       else do:
      905           assign
      906               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
      907           .
      908       end.
      909     end.
      910   end procedure.
      911   function excel-format-dec-to-char returns char (input p-dec as decimal ).
      912     if num-entries(string(p-dec), '.') = 2
      913       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
      914       else return( string(p-dec)) .
      915   end function.
      916   function format-point-to-comma returns char (input orig as char ) .
      917   define variable rtext as character no-undo .
      918   define variable strt as integer no-undo .
      919   define variable leng as integer no-undo .
      920   assign rtext = orig .
      921   repeat:
      922     strt =  index(rtext,'.').
      923     if strt = 0 then leave.
      924     leng = 1.
      925     substring(rtext,strt,leng,"character") = v-delim .
      926   end.
      927   return rtext.
      928   end function.
      929   function format-excel-text returns char ( input start-text as char ) :
      930   def var  i    as int no-undo.
      931   def var  ch   as char no-undo.
      932   def var  n    as int no-undo.
      933   def var  ipos as int no-undo.
      934     n = num-entries(trim(start-text), chr(10)) - 1 .
      935     do i = 1 to n :
      936       ipos = index( start-text, chr(10)).
      937       if ipos > 0 then
      938         substr( start-text, ipos, 1 ) = ' '.
      939     end.
      940     n = num-entries(trim(start-text), chr(13)) - 1 .
      941     do i = 1 to n :
      942       ipos = index( start-text, chr(13)).
      943       if ipos > 0 then
      944         substr( start-text, ipos, 1 ) = ' '.
      945     end.
      946     if index( start-text, '"' ) = 0 then
      947       start-text =  '="'   + trim( start-text) + '"'   .
      948       else do:
      949         n = num-entries(trim(start-text), '"') - 1.
      950         do i = 1 to n :
      951           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      952         end.
      953         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      954         start-text = '="'  + ch  + '"' .
      955       end.
      956     return start-text.
      957   end.
      958   function excel-sum returns char (input p-dec as decimal ).
      959     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
      960   end function.
      961   function excel-qnty returns char (input p-dec as decimal ).
      962     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
      963   end function.
      964   function format-excel-text-macr returns char ( input start-text as char ) :
      965   def var  i    as int no-undo.
      966   def var  ch   as char no-undo.
      967   def var  n    as int no-undo.
      968   def var  ipos as int no-undo.
      969     n = num-entries(trim(start-text), chr(10)) - 1 .
      970     do i = 1 to n :
      971       ipos = index( start-text, chr(10)).
      972       if ipos > 0 then
      973         substring( start-text, ipos , 1 ) = ' '.
      974     end.
      975     n = num-entries(trim(start-text), chr(13)) - 1 .
      976     do i = 1 to n :
      977       ipos = index( start-text, chr(13)).
      978       if ipos > 0 then
      979         substring( start-text, ipos, 1 ) = ' '.
      980     end.
      981     if index( start-text, '"' ) = 0 then
      982       start-text =  '"'   + trim( start-text) + '"'   .
      983       else do:
      984         n = num-entries(trim(start-text), '"') - 1.
      985         do i = 1 to n :
      986           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      987         end.
      988         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      989         start-text = '"'  + ch  + '"' .
      990       end.
      991     n = num-entries(trim(start-text), chr(10)) - 1 .
      992     do i = 1 to n :
      993       ipos = index( start-text, chr(10)).
      994       if ipos > 0 then
      995         substring( start-text, ipos , 1 ) = ' '.
      996     end.
      997       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
      998     return start-text.
      999   end.
     1000   def var vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1001   function func-get-name-from-ext-type   returns char
     1002     ( p-ext-type as character   ,
     1003       p-caps     as logical ).
     1004   define variable v-ext-name as character no-undo .
     1005   run get-name-from-ext-type in this-procedure (
     1006       input p-ext-type  ,
     1007       input p-caps  ,
     1008       output v-ext-name )
     1009       no-error .
     1010       if error-status :error then do:
     1011          assign
     1012            v-ext-name = p-ext-type
     1013          .
     1014       end.
     1015    return (v-ext-name) .
     1016   end.
     1017   procedure get-name-from-ext-type :
     1018    do
     1019    on error undo, return error return-value
     1020    :
     1021   define input  parameter p-ext-type as character no-undo .
     1022   define input  parameter p-caps     as logical no-undo   .
     1023   define output parameter p-ext-name as character no-undo .
     1024   define variable v-num as integer no-undo .
     1025     if lookup ( p-ext-type , 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ) = 0 then do :
     1026       message
     1027         vss-include-info10 skip
     1028         "Неправильно задано значение входящего параметра! "
     1029         "Нет такого типа документов " p-ext-type
     1030         view-as alert-box error .
     1031         undo, return error .
     1032     end.
     1033     v-num      = lookup ( p-ext-type , 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ) .
     1034     p-ext-name = entry  ( v-num , 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U ) .
     1035     if p-caps  = true then do :
     1036        p-ext-name = caps(substring(p-ext-name,1,1) ) + substring(p-ext-name, 2 , length (p-ext-name) - 1 ) .
     1037     end .
     1038     end.
     1039   end procedure.
     1040   FUNCTION n-lavel RETURNS char (INPUT grp-name as char, INPUT lavel# as int ).
     1041   define variable  str  as char format "X(60)"  no-undo.
     1042   define variable  str2 as char no-undo.
     1043   define variable v-r as character no-undo init "" .
     1044   define variable  i#i as int no-undo.
     1045   STR = "".
     1046   repeat i#i =1 to lavel#:
     1047       if i#i =1 then str   = entry(1,grp-name, chr(47)) .
     1048       else do:
     1049           str2 = entry(i#i,grp-name, chr(47)) no-error.
     1050           if not error-status:error  and str2 <> "":u then
     1051                  str = str +  chr(47) +  entry(i#i,grp-name, chr(47)) no-error .
     1052           end.
     1053   end.
     1054   if str <> ? then do:
     1055   v-r = str + chr(47) .
     1056   end.
     1057   RETURN v-r .
     1058   END FUNCTION.
     1059   define variable vss-include-info11 as character format "X(65)" no-undo
     1060   initial "@(#)$Workfile$ $Revision$".
     1061   procedure grplib-get-full-name :
     1062      define input parameter p-node-code  as integer      no-undo.
     1063      define output parameter p-full-name as character    no-undo.
     1064      do
     1065   on error undo, return error
     1066   :
     1067       define variable v-upper-code    as integer           no-undo.
     1068       define buffer buf_gds-grp       for ub.gds-grp.
     1069       define buffer buf_upper_gds-grp for ub.gds-grp.
     1070       find first buf_gds-grp no-lock
     1071            where buf_gds-grp.node-code = p-node-code
     1072       no-error.
     1073       if not available buf_gds-grp
     1074       then do:
     1075           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     1076       end.
     1077       assign
     1078           p-full-name  = ""
     1079           v-upper-code = 1
     1080       .
     1081       do while buf_gds-grp.upper-code <> 0
     1082       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     1083       :
     1084           assign
     1085               p-full-name  = buf_gds-grp.node-name
     1086                            + (if p-full-name <> "" then chr(47) else "")
     1087                            + p-full-name
     1088               v-upper-code = buf_gds-grp.upper-code
     1089           .
     1090           find first buf_gds-grp no-lock
     1091                where buf_gds-grp.node-code = v-upper-code
     1092           no-error.
     1093           if not available buf_gds-grp
     1094           then do:
     1095               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
     1096                                   + string( v-upper-code )
     1097                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     1098           end.
     1099       end.
     1100       assign
     1101       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     1102       .
     1103   end.
     1104   end .
     1105   procedure grplib-get-node-from-full-name :
     1106   define input parameter p-full-name as character no-undo .
     1107   define output parameter p-node-code as integer no-undo .
     1108   define variable v-ii as integer no-undo .
     1109   define variable v-upper-code as integer no-undo .
     1110   define variable v-root-code as integer no-undo .
     1111   define variable v-entry as character no-undo .
     1112   define buffer buf_gds-grp       for ub.gds-grp.
     1113   do
     1114   on error undo, return error
     1115   :
     1116     find first buf_gds-grp no-lock
     1117         where buf_gds-grp.upper-code = 0
     1118     no-error .
     1119     if not available buf_gds-grp
     1120     then do:
     1121         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
     1122     end.
     1123     else do:
     1124       assign
     1125       v-root-code = buf_gds-grp.node-code
     1126       .
     1127     end.
     1128     v-upper-code = v-root-code.
     1129     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     1130       assign
     1131       v-entry = entry(v-ii, p-full-name, chr(47)).
     1132       if v-entry = '' then leave.
     1133       find first buf_gds-grp no-lock where
     1134                 buf_gds-grp.node-name = v-entry
     1135             and buf_gds-grp.upper-code = v-upper-code
     1136             no-error.
     1137       if not available buf_gds-grp then do:
     1138         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     1139       end.
     1140       else do:
     1141         p-node-code = buf_gds-grp.node-code.
     1142         v-upper-code = buf_gds-grp.node-code.
     1143       end.
     1144     end.
     1145   end.
     1146   end .
     1147   Make-Excel      = true.
     1148   Make-Excel-com  = false .
