     1232       temp-abc.id          = buf_abc-analysis.abc-id
     1233       temp-abc.db-num      = buf_abc-analysis.db-num
     1234       temp-abc.type        = if buf_abc-analysis.abc-type = "2"  then "Двухпроходный, ограничение Е <= " + string(buf_abc-analysis.le-proc)  else " "
     1235       temp-abc.name        = buf_abc-analysis.abc-name
     1236       temp-abc.des         = buf_abc-analysis.abc-des
     1237       temp-abc.name-cral   = buf_criterion-analysis.cral-name
     1238       temp-abc.A           = buf_abc-analysis.abc-a
     1239       temp-abc.B           = buf_abc-analysis.abc-b
     1240       temp-abc.C           = buf_abc-analysis.abc-c
     1241       temp-abc.D           = buf_abc-analysis.abc-d
     1242       temp-abc.E           = buf_abc-analysis.abc-E
     1243       temp-abc.F           = buf_abc-analysis.abc-F
     1244       temp-abc.date-cr     = buf_abc-analysis.abc-date-create
     1245       temp-abc.period      = buf_abc-analysis.abc-string-period
     1246       temp-abc.ext-doc-type = ""
     1247       .
     1248       define buffer buf_abc-analysis-doc for ub.abc-analysis-doc.
     1249        for each buf_abc-analysis-doc no-lock where
     1250                 buf_abc-analysis-doc.abc-id = buf_abc-analysis.abc-id and
     1251                 buf_abc-analysis-doc.db-num = buf_abc-analysis.db-num
     1252        :
     1253        temp-abc.ext-doc-type = temp-abc.ext-doc-type + func-get-name-from-ext-type (buf_abc-analysis-doc.abcd-ext-doc-type , true ) + "," .
     1254        end.
     1255        for each buf_abc-analysis-obj no-lock where
     1256                 buf_abc-analysis-obj.abc-id = buf_abc-analysis.abc-id and
     1257                 buf_abc-analysis-obj.db-num = buf_abc-analysis.db-num
     1258        :
     1259        temp-abc.obj = temp-abc.obj +  buf_abc-analysis-obj.obj-type + " " + string(buf_abc-analysis-obj.obj-code) + "," .
     1260        end.
     1261   end.
     1262   define stream  macr_excel .
