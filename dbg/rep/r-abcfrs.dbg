      381   procedure create_obj-list :
      382      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      383      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      384      do
      385      on error undo, return error return-value
      386      :
      387         define buffer cli-obj for ub.clients .
      388         define variable p-var as integer no-undo .
      389         define buffer buf_obj-list for obj-list .
      390         find last buf_obj-list  use-index pi no-error .
      391         if available buf_obj-list
      392         then
      393            p-var = buf_obj-list.obj-id + 1.
      394         else
      395            p-var = 1.
      396         find first cli-obj where
      397                   cli-obj.obj-type = p-obj-type
      398               and cli-obj.obj-code = p-obj-code
      399         no-lock no-error.
      400         if available cli-obj
      401         then do:
      402            create buf_obj-list.
      403            assign
      404               buf_obj-list.obj-id   = p-var
      405               buf_obj-list.obj-code = cli-obj.obj-code
      406               buf_obj-list.obj-type = cli-obj.obj-type
      407               buf_obj-list.obj-name = cli-obj.obj-name
      408               buf_obj-list.db-num   = cli-obj.db-num
      409            .
      410         end.
      411      end.
      412   end.
