      981   run rep/ticket.p (
      982                  buffer ub.goods
      983                 ,buffer ub.bar-code
      984                 ,buffer ub.scales-gds
      985                 ,input p-obj-type
      986                 ,input p-obj-code
      987                 ,input Action
      988                 ,input rootnode_code
      989                 ,input TickOnw
      990                 ,input TickOnN
      991                 ,input QntyType
      992                 ,input PriceType
      993                 ,input scaleprice
      994                 ,input nakl-qnty
      995                 ,input list-qnty
      996                 ,input pr-doc-rubl
      997                 ,input pr-doc-rb
      998                 ,input pr-doc-rubl-old
      999                 ,input pr-doc-rb-old
     1000                 ,input v-fact-order
     1001                 ,input ListProdBc
     1002                 ,input curr-rate
     1003                 ,input TickPS
     1004                 ,input dflt-cd
     1005                 ,input how-pcnt-kat
     1006                 ,input-output b-count
     1007                 ,input v-part-code
     1008                 ,input v-doc-code
     1009                 ,input v-promo-code
     1010                 ,input v-ActionId
     1011                 ,input v-db-num
     1012                 ) no-error .
     1013         end.
     1014       end.
     1015       if bb-list.b-str <> "":U
     1016       and bb-list.loc-ean then do:
     1017         ListProdbc = bb-list.b-str.
     1018         do on error undo, return error :
     1019           if prn-prt = false     and bar-code.node-code <> rootnode_code   then do:     next.   end.   if prn-prt = true then do:     find first gds-prt no-lock       where gds-prt.node-code = bar-code.node-code     .     if gds-prt.is-term = false then do:       next.     end.   end.
