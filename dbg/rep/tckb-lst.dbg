     1053       end.
     1054     end.
     1055   end.
     1056   def var vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1057   OUTPUT STREAM OutStream CLOSE.
     1058   message
     1059     substitute( "Передано на печать &1 этикеток (ценников)", b-count )
     1060     view-as alert-box INFORMATION.
     1061   os-command NO-WAIT value( substitute( "start &1run-lbc.bat &1 &2title &3 &4", lbc-path, lbc-tmp, TicketName, v-user-id ) ).
     1062     end.
     1063   end procedure.
