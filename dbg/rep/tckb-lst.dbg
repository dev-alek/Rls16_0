      325         end.
      326         if varcont3 = yes then do:
      327           assign
      328             sum3 = sum3 * 3
      329           .
      330           do i3 = 2 to len-code3 by 2
      331           :
      332             assign
      333               v-sum-char3 = substr(full-b-code, len-code3 - i3 + 1, 1)
      334             .
      335             if v-sum-char3 < "0"
      336             or v-sum-char3 > "9"
      337             then do:
      338               message
      339                 "Невозможно сформировать бар-код" skip
      340                 "для товара с кодом: " internal-b-code skip
      341                 view-as alert-box error title "подсчет контрольной суммы".
      342               return error.
      343             end.
      344             assign
      345               sum3 = sum3 + integer(v-sum-char3)
