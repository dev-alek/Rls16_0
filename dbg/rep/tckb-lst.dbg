      472     field to-del as logical
      473     field order-num as integer
      474     field loc-ean as logical
      475     index pi  is primary unique b-code b-str
      476     index art artic prod-type prod-code
      477     index code gds-code
      478     index oi order-num
      479     index ibc-on-type bc-on-type
      480     index iprt
      481     gds-code
      482     node-code
      483     part-code
      484     in-code
      485     unit-cli
      486     b-str
      487     index iprt2
      488     gds-code
      489     node-code
      490     unit-cli
      491     part-code
      492     in-code
      493     b-str
      494     .
      495   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      496   define  shared  temp-table bb-list-hist no-undo
      497   field list-table as character
      498   field id as integer
      499   field line as integer
      500   field hist-mode as character
      501   field des as character
      502   field num-recs as integer
      503   field option_ as character
      504   field item_ as character
      505   field status_ as character
      506   field num-add as integer
      507   field num-ignored as integer
      508   field done as logical
      509   field err_ as logical
      510   field err-mes as character
      511   index pi is primary
