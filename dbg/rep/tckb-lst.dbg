      516   .
      517   define variable how-pcnt-kat as character no-undo .
      518   define variable dflt-cd as character no-undo .
      519   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      520   define variable v-param-type9 as character no-undo .
      521   define variable v-value-date9 as date no-undo .
      522   define variable v-value-decimal9 as decimal no-undo .
      523   define variable v-value-integer9 as INTEGER no-undo .
      524   define variable v-value-logical9 AS LOGICAL no-undo .
      525   define variable v-tth9 as handle no-undo .
      526   define variable v-host-code9 as integer no-undo .
      527   define buffer buf_dis-thbj-rule9 for ub.dis-thbj-rule.
      528   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      529   define variable v-param-type10 as character no-undo .
      530   define variable v-value-date10 as date no-undo .
      531   define variable v-value-decimal10 as decimal no-undo .
      532   define variable v-value-integer10 as INTEGER no-undo .
      533   define variable v-value-logical10 AS LOGICAL no-undo .
      534   define variable v-tth10 as handle no-undo .
      535   run adm/shattri.p (
      536       input "get":U
      537       ,input  p-obj-type
      538       ,input  p-obj-code
      539       ,input  'cd-sending':U
      540       ,input  'dflt-cd':U
      541       ,output dflt-cd
      542       ,output v-value-date10
      543       ,output v-value-decimal10
      544       ,output v-value-integer10
      545       ,output v-value-logical10
      546       ,output v-param-type10
      547       ,INPUT-OUTPUT table-handle v-tth10
      548       )  .
      549   delete object v-tth10 no-error.
      550   how-pcnt-kat = ''.
      551   run adm/shattri.p (
      552       input "get":U
      553       ,input  p-obj-type
      554       ,input  p-obj-code
      555       ,input  'cd-inf-send':U
      556       ,input  'how-pcnt-kat':U
      557       ,output how-pcnt-kat
      558       ,output v-value-date9
      559       ,output v-value-decimal9
      560       ,output v-value-integer9
      561       ,output v-value-logical9
      562       ,output v-param-type9
      563       ,INPUT-OUTPUT table-handle v-tth9
      564       ) no-error .
      565   delete object v-tth9.
      566   if how-pcnt-kat = 'pcnt-kat-pdf':U then do:
      567     find first  buf_dis-thbj-rule9 No-LOCK  where
      568                 buf_dis-thbj-rule9.obj-type = p-obj-type
      569           AND  buf_dis-thbj-rule9.obj-code = p-obj-code
      570           and  buf_dis-thbj-rule9.pos-type = dflt-cd
      571           and  buf_dis-thbj-rule9.discnt-role = 'pcnt-kat-pdf':U
      572           and  buf_dis-thbj-rule9.nonunique = ''
      573           no-error .
      574     if not available buf_dis-thbj-rule9 then do:
      575   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      576   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      577     (input  p-obj-type
      578     ,input  p-obj-code
      579     ,output v-host-code9
      580     )  .
      581       find first  buf_dis-thbj-rule9 No-LOCK  where
      582                   buf_dis-thbj-rule9.obj-code = v-host-code9
      583             AND  buf_dis-thbj-rule9.obj-type = 'орг':U
      584             and  buf_dis-thbj-rule9.pos-type = dflt-cd
      585             and  buf_dis-thbj-rule9.discnt-role = 'pcnt-kat-pdf':U
      586             and  buf_dis-thbj-rule9.nonunique = ''
      587             no-error .
      588     end.
      589     if not available buf_dis-thbj-rule9 then do:
      590       find first  buf_dis-thbj-rule9 No-LOCK  where
      591                   buf_dis-thbj-rule9.obj-code = 0
      592             AND  buf_dis-thbj-rule9.obj-type = ''
      593             and  buf_dis-thbj-rule9.pos-type = dflt-cd
      594             and  buf_dis-thbj-rule9.discnt-role = 'pcnt-kat-pdf':U
      595             and  buf_dis-thbj-rule9.nonunique = ''
      596             no-error .
      597     end.
      598     if available buf_dis-thbj-rule9 then do:
      599       how-pcnt-kat = how-pcnt-kat + "=" + string(buf_dis-thbj-rule9.rule-num).
      600     end.
      601     else do:
      602       how-pcnt-kat = how-pcnt-kat + "="  + string(0).
      603     end.
      604   end.
      605   tickons = yes.
      606   action = "all-bb".
      607   CASE List-sort:
      608     when "artic":U then do:
      609       run bb-list-artic in this-procedure .
      610     end.
      611     when "b-code":U then do:
      612       run bb-list-b-code in this-procedure .
      613     end.
      614     when "order-num":U then do:
      615       run bb-list-order-num in this-procedure .
      616     end.
      617   END CASE.
      618   procedure bb-list-artic :
      619     do
      620     on error undo, return error
      621     :
      622   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      623   define variable v-value12 as character no-undo .
      624   if NOT can-find(first bb-list) then
      625       RETURN.
      626   for each bb-list
      627   by bb-list.artic
      628   by bb-list.prod-type
      629   by bb-list.prod-code
      630   :
      631     if bb-list.b-str = "":U then next.
      632     find ub.goods no-lock
      633       where ub.goods.prod-type = bb-list.prod-type
      634         and ub.goods.prod-code = bb-list.prod-code
      635         and ub.goods.artic = bb-list.artic
      636     .
      637     find ub.gds-prt no-lock
      638       where ub.gds-prt.upper-code = ub.goods.prt-root
      639     .
      640     if bb-list.qnty = ? then do:
      641       run gbl/d-prompt.w (
      642         'title=':u +  substitute("ЕАН &1" , bb-list.b-str )  + '\':u
      643       + 'text1=':u + substitute("Для товара  &1 &2" ,  ub.goods.artic , ub.goods.gds-name )  + '\':u
      644       + 'text2=':u + "Введите количество" + '\':u
      645       + 'format=' + ">>>>9" + '\':u
      646       + 'type=' + 'I':U + '\':u
      647       + 'fillin_row=3\':u
      648       + 'fillin_col=4\':u
      649       + 'fillin_width=7\':u
      650       + 'fillin_height=1\':u
      651       + 'max-chars=5\':u
      652       + 'readonly=no\':u
      653       , input-output v-value12
      654       ).
      655       if return-value = 'false':u
      656           then bb-list.qnty .
      657           else bb-list.qnty = int(v-value12) .
      658     end.
      659     assign
      660       rootnode_code = ub.gds-prt.node-code
      661       list-qnty = bb-list.qnty
      662     .
      663     if v-cntxp-doc-prt AND TickOnS AND can-find(first ub.gds-prt where ub.gds-prt.upper-code = rootnode_code) then do:
      664       assign
      665         prn-prt = TRUE
      666       .
      667     end.
      668     else do:
      669       assign
      670         prn-prt = FALSE
      671       .
      672     end.
      673     find first ub.bar-code no-lock where
      674               ub.bar-code.b-code = bb-list.b-code no-error .
      675     if available ub.bar-code then do:
      676       if bb-list.b-str <> "":U
      677       and not bb-list.loc-ean then do:
      678         define buffer buf_prod-bc for ub.prod-bc.
      679         find first buf_prod-bc where buf_prod-bc.b-code =
      680                     bb-list.b-code
      681                 AND buf_prod-bc.b-str = bb-list.b-str no-error .
      682         ListProdbc = buf_prod-bc.b-str.
      683         do on error undo, return error :
      684           if prn-prt = false     and bar-code.node-code <> rootnode_code   then do:     next.   end.   if prn-prt = true then do:     find first gds-prt no-lock       where gds-prt.node-code = bar-code.node-code     .     if gds-prt.is-term = false then do:       next.     end.   end.
      685   run rep/ticket.p (
      686                  buffer ub.goods
      687                 ,buffer ub.bar-code
      688                 ,buffer ub.scales-gds
      689                 ,input p-obj-type
      690                 ,input p-obj-code
      691                 ,input Action
      692                 ,input rootnode_code
      693                 ,input TickOnw
      694                 ,input TickOnN
      695                 ,input QntyType
      696                 ,input PriceType
      697                 ,input scaleprice
      698                 ,input nakl-qnty
      699                 ,input list-qnty
      700                 ,input pr-doc-rubl
      701                 ,input pr-doc-rb
      702                 ,input pr-doc-rubl-old
      703                 ,input pr-doc-rb-old
      704                 ,input v-fact-order
      705                 ,input ListProdBc
      706                 ,input curr-rate
      707                 ,input TickPS
      708                 ,input dflt-cd
      709                 ,input how-pcnt-kat
      710                 ,input-output b-count
      711                 ,input v-part-code
      712                 ,input v-doc-code
      713                 ,input v-promo-code
      714                 ,input v-ActionId
      715                 ,input v-db-num
      716                 ) no-error .
      717         end.
      718       end.
      719       if bb-list.b-str <> "":U
      720       and bb-list.loc-ean then do:
      721         ListProdbc = bb-list.b-str.
      722         do on error undo, return error :
      723           if prn-prt = false     and bar-code.node-code <> rootnode_code   then do:     next.   end.   if prn-prt = true then do:     find first gds-prt no-lock       where gds-prt.node-code = bar-code.node-code     .     if gds-prt.is-term = false then do:       next.     end.   end.
      724   run rep/ticket.p (
      725                  buffer ub.goods
      726                 ,buffer ub.bar-code
      727                 ,buffer ub.scales-gds
      728                 ,input p-obj-type
      729                 ,input p-obj-code
      730                 ,input Action
      731                 ,input rootnode_code
      732                 ,input TickOnw
      733                 ,input TickOnN
      734                 ,input QntyType
      735                 ,input PriceType
      736                 ,input scaleprice
      737                 ,input nakl-qnty
      738                 ,input list-qnty
      739                 ,input pr-doc-rubl
      740                 ,input pr-doc-rb
      741                 ,input pr-doc-rubl-old
      742                 ,input pr-doc-rb-old
      743                 ,input v-fact-order
      744                 ,input ListProdBc
      745                 ,input curr-rate
      746                 ,input TickPS
      747                 ,input dflt-cd
      748                 ,input how-pcnt-kat
      749                 ,input-output b-count
      750                 ,input v-part-code
      751                 ,input v-doc-code
      752                 ,input v-promo-code
      753                 ,input v-ActionId
      754                 ,input v-db-num
      755                 ) no-error .
      756         end.
      757       end.
      758     end.
      759   end.
