      128   def new shared var bc-frmt as character no-undo .
      129   def new shared var bc-pfx  as character no-undo .
      130   def var bc-par-type as character no-undo .
      131       run gbl/conf-rd.p ("bc-frmt", "", "", 0, "", "", "",  no , output bc-frmt, output bc-par-type) no-error.
      132       if "new" = "bc" AND ( error-status:error OR bc-par-type <> "C":U OR not can-do ("EAN8,EAN13", bc-frmt) ) then
      133           do:
      134               message "Не задан или не верно задан ТИП собственного бар-кода!"
      135                   view-as alert-box ERROR TITLE "".
      136               return error.
      137           end.
      138       run gbl/conf-rd.p ("bc-pfx", "", "", 0, "", "", "",  no , output bc-pfx, output bc-par-type) no-error.
      139       if "new" = "bc" AND ( error-status:error OR bc-par-type <> "C":U ) then
      140           do:
      141               message "Не задан или не верно задан ПРЕФИКС бар-кода складского места!"
      142                   view-as alert-box ERROR TITLE "".
      143               return error.
      144           end.
      145   PROCEDURE gen-bc:
      146     def input  parameter internal-b-code like ub.bar-code.b-code no-undo .
      147     def output parameter full-b-code     as character init ""    no-undo .
      148   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      149     define variable tmp-str2  as character no-undo.
      150     define variable tmp-num2  as character no-undo.
      151     define variable i2        as integer   no-undo.
      152     define variable sum2      as integer   no-undo.
      153     define variable len-code2 as integer   no-undo.
      154     define variable varcont2  as logical   initial yes no-undo.
      155     CASE bc-frmt :
      156       WHEN "EAN13" THEN do:
      157         assign
      158           tmp-str2 = string( internal-b-code, "999999999999" )
      159         .
      160       end.
      161       WHEN "EAN8" THEN do:
      162         assign
      163           tmp-str2 = string( internal-b-code, "9999999" )
      164         .
      165       end.
      166       OTHERWISE DO:
      167           message "Неизвестный тип генерации бар-кода процедурой bc-gnrti.i: " bc-frmt " ."
      168           view-as alert-box error.
      169           return error.
      170       END.
      171     END CASE.
      172     if varcont2 = yes then do:
      173       if integer( substring( tmp-str2, 1, length( bc-pfx ) ) ) <> 0
      174       then do:
      175         message
      176           "Невозможно сформировать бар-код" SKIP
      177           "для товара с кодом: " internal-b-code
      178           view-as alert-box error title "подрезание кода".
      179         return error.
      180       end.
      181       else do:
      182         assign
      183           full-b-code = bc-pfx + substring( tmp-str2, length( bc-pfx ) + 1, length( tmp-str2 ) - length( bc-pfx ) )
      184           len-code2    = length( full-b-code )
      185         .
      186         define variable v-sum-char2 as character no-undo .
      187         assign
      188           sum2 = 0
      189         .
      190         do i2 = 1 to len-code2 by 2
      191         :
      192           assign
      193             v-sum-char2 = substr(full-b-code, len-code2 - i2 + 1, 1)
      194           .
      195           if v-sum-char2 < "0"
      196           or v-sum-char2 > "9"
      197           then do:
      198             message
      199               "Невозможно сформировать бар-код" skip
      200               "для товара с кодом: " internal-b-code skip
      201               view-as alert-box error title "подсчет контрольной суммы".
      202             return error.
      203           end.
      204           assign
      205             sum2 = sum2 + integer(v-sum-char2)
      206           .
      207         end.
      208         if varcont2 = yes then do:
      209           assign
      210             sum2 = sum2 * 3
      211           .
      212           do i2 = 2 to len-code2 by 2
      213           :
      214             assign
      215               v-sum-char2 = substr(full-b-code, len-code2 - i2 + 1, 1)
      216             .
      217             if v-sum-char2 < "0"
      218             or v-sum-char2 > "9"
      219             then do:
      220               message
      221                 "Невозможно сформировать бар-код" skip
      222                 "для товара с кодом: " internal-b-code skip
      223                 view-as alert-box error title "подсчет контрольной суммы".
      224               return error.
      225             end.
      226             assign
      227               sum2 = sum2 + integer(v-sum-char2)
      228             .
      229           end.
      230           if varcont2 = yes then do:
      231              if sum2 mod 10 = 0 then do:
      232                assign
      233                  full-b-code = full-b-code + '0'
      234                .
      235              end.
      236              else do:
      237                assign
      238                  full-b-code = full-b-code + string(10 - sum2 mod 10)
      239                .
      240              end.
      241           end.
      242         end.
      243       end.
      244     end.
      245   END PROCEDURE.
      246   def new shared var pl-frmt as character no-undo .
      247   def new shared var pl-pfx  as character no-undo .
      248   def var pl-par-type as character no-undo .
      249       run gbl/conf-rd.p ("pl-frmt", "", "", 0, "", "", "",  no , output pl-frmt, output pl-par-type) no-error.
      250       if "new" = "bc" AND ( error-status:error OR pl-par-type <> "C":U OR not can-do ("EAN8,EAN13", pl-frmt) ) then
      251           do:
      252               message "Не задан или не верно задан ТИП собственного бар-кода!"
      253                   view-as alert-box ERROR TITLE "".
      254               return error.
      255           end.
      256       run gbl/conf-rd.p ("pl-pfx", "", "", 0, "", "", "",  no , output pl-pfx, output pl-par-type) no-error.
      257       if "new" = "bc" AND ( error-status:error OR pl-par-type <> "C":U ) then
      258           do:
      259               message "Не задан или не верно задан ПРЕФИКС бар-кода складского места!"
      260                   view-as alert-box ERROR TITLE "".
      261               return error.
      262           end.
      263   PROCEDURE gen-pl:
