     1149     if tog-lavel =TRUE
     1150           Then do:
     1151               display  var-Lavel  with frame F-Main .
     1152               enable   var-Lavel  with frame F-Main .
     1153           end.
     1154            Else do:
     1155               display    var-Lavel with frame F-Main .
     1156               disable    var-Lavel with frame F-Main .
     1157           end.
     1158   END.
     1159   if not this-procedure :persistent
     1160   then do:
     1161     message
     1162       vss-workfile vss-revision vss-description skip
     1163       "Ошибка при запуске процедуры" skip
     1164       "Данную процедуру следует запускать только с параметром persistent" skip
     1165       view-as alert-box error .
     1166     undo, return error .
     1167   end.
