     1240   PROCEDURE my-report :
     1241   define variable v_r-b      as character no-undo .
     1242   define variable  v_data-type as character no-undo .
     1243   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1244   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1245     (output v_r-b
     1246     ) no-error .
     1247     if error-status :error then do:
     1248       message vss-workfile vss-revision vss-description skip
     1249              "Ошибка при чтении параметра конфигурации r-b!  " skip
     1250               skip
     1251               error-status :get-message(1) skip
     1252               return-value skip
     1253               view-as alert-box error
     1254       .
     1255       return error.
     1256     end.
     1257   if v_r-b = "base" then do:
     1258     if base-code <> 0 then do:
     1259       if x-SET_val_TYPE = 1 then do:
     1260           message  "Выполнить отчет в рублях нельзя ! " view-as alert-box information .
     1261           return no-apply.
     1262       end.
     1263     end.
     1264   end.
     1265   case SortType :
     1266     when "sort-artic" then do:
     1267       run proc-r in this-procedure .
     1268     end.
     1269     when "sort-code" then do:
     1270       run proc-c in this-procedure .
     1271     end.
     1272     when "sort-name" then do:
     1273       run proc-n in this-procedure .
     1274     end.
     1275   end case.
     1276   END PROCEDURE.
     1277   PROCEDURE my-var :
     1278   if VALID-HANDLE(type-pr) = false  then do:
     1279       message "Нет архивов по типу приобретения !!!" skip
     1280       view-as alert-box information .
     1281       return 'First-page':U.
     1282    end.
     1283   assign frame F-Main SumsOnly ShowZero tog-obj ShowZero-2
     1284   tog-lavel var-lavel Classify SortType VAT-Cost VAT-CRSA VAT-sale  .
     1285   if x-SelectObject = "currency":U and tog-obj = false then tog-obj = true .
     1286   Assign
     1287    STR-obj-type = ''
     1288    STR-obj-code = ''
     1289    STR-obj-name = ''
     1290    STR-obj      = ''.
     1291   For each obj-list no-lock:
     1292    Assign
     1293    STR-obj-type = STR-obj-type + obj-list.obj-type + ','
     1294    STR-obj-code = STR-obj-code + String(obj-list.obj-code) + ','
     1295    STR-obj-name = STR-obj-name + obj-list.obj-name + ','
     1296    STR-obj = STR-obj +  obj-list.obj-type + '#' + string(obj-list.obj-code)  + ',' .
     1297   End.
     1298   Reportname = caps(reportname) .
     1299   def var t-class as char no-undo.
     1300   def var t-sort as char no-undo.
     1301     case classify:
     1302       when "no-classify":u    then t-class =   "Без классификации" .
     1303       when "prod":u           then t-class =   "Производители"   .
     1304       when "post":u           then t-class =   "Поставщики"   .
     1305       when "grp-goods":u      then t-class =   "Группы товаров"  .
     1306       when "post/grp-goods":u then t-class =   "Поставщики/Группы товаров" .
     1307       when "prod/grp-goods":u then t-class =   "Производители/Группы товаров" .
     1308       when "grp-goods/prod":u then t-class =   "Группы товаров/Производители" .
     1309       when "grp-goods/post":u then t-class =   "Группы товаров/Поставщики" .
     1310       when  "vat-ps":u        then t-class =   "Ставка НДС" .
     1311       when  "sort":u          then t-class =   "Проба(Сорт)" .
     1312       when  "n-level":u       then t-class =   "Группы с уровнем вложенности " .
     1313       when  "t-level":u       then t-class =   "Терминальные группы" .
     1314    end case.
     1315     case sorttype:
     1316       when "sort-pp":u               then t-sort =   "по порядку" .
     1317       when "sort-code":u             then t-sort =   "по коду" .
     1318       when "sort-artic":u            then t-sort =   "по артикулу"  .
     1319       when "sort-qunty":u            then t-sort =   "по реализации".
     1320       when "sort-name":u             then t-sort =   "по наименованию".
     1321       when "sort-type":u             then t-sort =   "по типу ткани".
     1322       when "sort-doc-code":u         then t-sort =   "по номеру документа".
     1323       when "sort-recipe-code":u      then t-sort =   "по номеру рецепта".
     1324    end case.
     1325   ReportHeader = "Классификация : " + t-Class.
     1326   ReportHeader = ReportHeader +
     1327                  (if tog-lavel  then "    Итоги с уровня  "  + String(var-lavel)  else " "    ).
     1328   ReportHeader = ReportHeader  + chr(10).
     1329   ReportHeader = ReportHeader +
     1330                  "Сортировка " + t-Sort + chr(10) +
     1331                  "Показать : " +
     1332                  (if SumsOnly     then "Только итоги, "  else " "            ) +
     1333                  (if Show-Cost    then "Суммы в учетных ценах, "  else " "   ) +
     1334                  (if Show-Crsa    then "Суммы в продажных ценах, "  else " " ) +
     1335                  (if Show-Sale    then "Суммы комиссии , "  else " " ) +
     1336                  (if vat-Cost     then "НДС в учетных ценах, "  else " "   ) +
     1337                  (if vat-Crsa     then "НДС в продажных ценах, "  else " " ) +
     1338                  (if vat-Sale     then "НДС комиссии , "  else " " ) +
     1339                  (if ShowZero     then "Показывать нулевые остатки "  else "Не показывать нулевые остатки" ) +
     1340                  (if ShowZero-2   then "Показывать нулевые обороты "  else "Не показывать нулевые обороты" ) .
     1341   if type-pr:screen-value = "all" then ReportHeader =  ReportHeader  +    chr(10) + "Итоги по типам приобретения показываются , если типов приобретения больше одного." .
     1342   Sheetf.Excel-Column-Lable = "Код,Артикул,Название товара ,Ед.изм,т/у,Скидка,Остаток на  начало,,,,,,,Приход,,,,,,,Расход,,,,,,,Касса,,,,,,,Инвентаризация / Смена типа приобретения,,,,,,,Переоценка,,,,,,,Остаток на конец,,,,,,,, "  + chr(10).
     1343   Sheetf.Excel-Column-Lable = Excel-Column-Lable + ",,,,,, " +
     1344         Fill ( "кол-во,учет.сумма,прод.сумма,комиссия,учет.НДС,прод.НДС,НДС в ценах док-та ," , 7) .
     1345   Sheetf.Sizes = "10,16,60,7,3,13," + Fill("13,", 49) .
     1346   Sheetf.make-correct = fill("false,", 55) .
     1347   sheetf.ColFormat = "2=@;3=@;" .
     1348   END PROCEDURE.
     1349   def var vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1350   procedure cr-ob :
     1351    do
     1352    on error undo, return error return-value
     1353    :
     1354   define input parameter p-x as integer no-undo .
     1355   define input parameter p-y as integer no-undo .
     1356   define input parameter type-pr-name as character no-undo .
     1357   define input parameter type-pr-val  as character no-undo .
     1358   define variable l-str as character no-undo .
     1359   define variable i as integer no-undo .
     1360   if type-pr-name = ? then type-pr-name = 'Все,Выкуп,Консигнаци,Консигнация закупка,Консигнация выгода,Ответственное хранение,Старая консигнация':L .
     1361   if type-pr-val  = ?then type-pr-val  = 'all,r,cb,c,b,s,1':U .
     1362   repeat i = 1 to num-entries(type-pr-name) :
     1363    l-str =  l-str  + entry(i ,type-pr-name) + ","  +
     1364                      entry(i ,type-pr-val)  + "," .
     1365   end.
     1366   l-str = substring(l-str,1 , LENGTH (l-str) - 1) .
     1367   if num-entries(l-str) < 2 then do:
     1368       message "Нет архивов по типу приобретения !!!" skip
     1369       vss-include-info17 skip
     1370       view-as alert-box information .
     1371       return 'First-page':U.
     1372      end.
     1373      create radio-set type-pr
     1374      assign
     1375       row    = p-y
     1376       column = p-x
     1377       frame  = frame F-Main:handle
     1378       horizontal    = false
     1379       radio-buttons = l-str
     1380    .
     1381   if valid-handle(type-pr) = false then do:
     1382       message "Нет архивов по типу приобретения !!!" skip
     1383       vss-include-info17 skip
     1384       view-as alert-box information .
     1385       return 'First-page':U.
     1386    end.
     1387     type-pr:sensitive = yes  .
     1388     type-pr:visible   = yes  .
     1389    end.
     1390   end procedure.
