     1000   PROCEDURE check-modified :
     1001   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1002   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1003   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1004   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1005     IF check-state = "check":U THEN
     1006     DO:
     1007       RUN get-link-handle IN adm-broker-hdl
     1008         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1009            OUTPUT group-target-list).
     1010       IF group-target-list NE "":U THEN
     1011       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1012         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1013         RUN check-modified IN curr-widget ('group-check':U).
     1014         IF RETURN-VALUE NE "":U THEN
     1015         DO:
     1016           RUN check-modified-message(RETURN-VALUE).
     1017           RETURN "":U.
     1018         END.
     1019       END.
     1020     END.
     1021     RETURN "":U.
     1022   END PROCEDURE.
     1023   PROCEDURE check-modified-message :
     1024     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1025        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1026           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1027        IF RETURN-VALUE = "YES":U THEN
     1028           RUN notify ('view,CONTAINER-SOURCE':U).
     1029        MESSAGE IF p-changed-table NE ? THEN
     1030           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1031           ELSE "Current values have been changed."
     1032           SKIP "  Do you wish to save those changes?"
     1033           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1034        IF ANS THEN
     1035        DO:
     1036           IF group-assign-target THEN
     1037             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1038           ELSE RUN dispatch('update-record':U).
     1039           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1040           DO:
     1041               MESSAGE "Changes to the previous record were not saved."
     1042                 VIEW-AS ALERT-BOX ERROR.
     1043               IF group-assign-target THEN
     1044                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1045               ELSE RUN dispatch ('cancel-record':U).
     1046           END.
     1047        END.
     1048        ELSE DO:
     1049          IF group-assign-target THEN
     1050             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1051          ELSE RUN dispatch('cancel-record':U).
     1052        END.
     1053        RETURN.
     1054   END PROCEDURE.
     1055   PROCEDURE get-rowid :
     1056       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1057       ASSIGN
     1058       p-table   =   adm-first-table.
     1059       RETURN.
     1060   END PROCEDURE.
     1061   PROCEDURE init-group-assign :
     1062       RUN request-attribute IN adm-broker-hdl
     1063         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1064       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1065         group-assign-target = yes.
     1066       ELSE group-assign-target = no.
     1067       RETURN.
     1068   END PROCEDURE.
     1069   PROCEDURE set-editors :
     1070       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1071       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1072       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1073       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1074       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1075       DO WHILE VALID-HANDLE (curr-widget):
     1076           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1077              curr-widget:HIDDEN = no THEN DO:
     1078             CASE p-field-setting:
     1079               WHEN "INITIALIZE":U THEN
     1080               DO:
     1081                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1082                     read-only-list +
     1083                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1084                        STRING(curr-widget).
     1085               END.
     1086               WHEN "DISABLE":U OR
     1087               WHEN "ENABLE":U THEN
     1088               DO:
     1089                   curr-widget:SENSITIVE = yes.
     1090                   RUN get-attribute ('Read-Only-Editors':U).
     1091                   IF RETURN-VALUE = ? OR
     1092                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1093                       curr-widget:READ-ONLY =
     1094                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1095               END.
     1096               WHEN "CLEAR":U THEN
     1097                   curr-widget:SCREEN-VALUE = "":U.
     1098             END CASE.
     1099           END.
     1100           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1101       END.
     1102       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1103         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1104           + '"':U).
     1105       RETURN.
     1106   END PROCEDURE.
     1107   PROCEDURE use-check-modified-all :
     1108    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1109     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1110     RETURN.
     1111   END PROCEDURE.
     1112   PROCEDURE use-create-on-add :
     1113   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1114      RETURN.
     1115   END PROCEDURE.
     1116   PROCEDURE use-initial-lock :
     1117     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1118     ASSIGN adm-initial-lock = p-attr-value.
     1119     RETURN.
     1120   END PROCEDURE.
     1121     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1122   ON VALUE-CHANGED OF Classify IN FRAME F-Main
     1123   DO:
     1124       Assign Classify.
     1125       if Classify  Begins "prod":U OR
     1126          Classify  Begins "grp-goods":U OR
     1127          Classify  Begins "vat-ps":U
     1128           then
     1129           enable SumsOnly with frame F-Main .
     1130      if Classify = "no-classify":U
     1131         Then do:
     1132               SumsOnly = FALSE .
     1133               display SumsOnly with frame F-Main .
     1134               disable SumsOnly with frame F-Main .
     1135           end.
     1136      if Classify = "grp-goods":U
     1137            Then do:
     1138               display TOG-lavel   with frame F-Main .
     1139               enable  TOG-lavel   with frame F-Main .
     1140           end.
     1141            Else do:
     1142               display  TOG-lavel  var-Lavel with frame F-Main .
     1143               disable  TOG-lavel  var-Lavel with frame F-Main .
     1144           end.
     1145   END.
     1146   ON VALUE-CHANGED OF Tog-lavel IN FRAME F-Main
     1147   DO:
