      563   define new global shared variable g#library  as handle no-undo .
      564   define new global shared variable g#library2 as handle no-undo .
      565   define variable var-report-r-b as character no-undo .
      566   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      567   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      568     (output var-report-r-b
      569     )  .
      570   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      571   procedure proc-alt-shift-f2:
      572     if not ibs.th.gbl.gbl-var:rcode
      573   then
      574     run gbl\inidebug.p .
      575   end.
      576   procedure proc-alt-shift-f3:
      577     run gbl/prvssinf.p
      578       ( input this-procedure
      579       ) .
      580   end.
      581   define variable v-inform-launched as logical no-undo initial false .
      582   procedure proc-alt-shift-f4:
      583     define variable v-action as character no-undo .
      584     if v-inform-launched = false then do:
      585       assign
      586         v-inform-launched = true
      587       .
      588       run gbl/d-inform.w
      589         (  input self
      590         ,  input this-procedure
      591         , output v-action
      592         ) no-error .
      593       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      594       assign
      595         v-inform-launched = false
      596       .
      597     end.
      598   end.
      599   procedure proc-alt-f1:
      600     run gbl/corrhelp.p
      601       (input this-procedure
      602       ) .
      603   end .
      604   on alt-shift-f2 anywhere do:
      605     run proc-alt-shift-f2.
      606   end.
      607   on alt-shift-f3 anywhere do:
      608     run proc-alt-shift-f3 in this-procedure .
      609   end.
      610   on alt-shift-f4 anywhere do:
      611     run proc-alt-shift-f4 in this-procedure.
      612   end.
      613   on alt-f1 anywhere do:
      614     run proc-alt-f1 in this-procedure .
      615   end.
      616   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      617     define variable v-cntxt-db-num        as integer   no-undo .
      618     define variable v-cntxt-userid        as character no-undo .
      619     define variable v-cntxt-level         as character no-undo .
      620     define variable v-cntxt-host-code-obj as integer   no-undo .
      621     define variable v-cntxt-obj-type      as character no-undo .
      622     define variable v-cntxt-obj-code      as integer   no-undo .
      623     define variable v-cntxt-db-num-obj    as integer   no-undo .
      624     define variable v-cntxt-is-admin      as logical   no-undo .
      625   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      626     run mainmenu_getcntxt in my-handle
      627       (output v-cntxt-db-num
      628       ,output v-cntxt-userid
      629       ,output v-cntxt-level
      630       ,output v-cntxt-host-code-obj
      631       ,output v-cntxt-obj-type
      632       ,output v-cntxt-obj-code
      633       ,output v-cntxt-db-num-obj
      634       ,output v-cntxt-is-admin
      635       ) .
      636   define variable base-type as character no-undo .
      637   define variable base-code as integer   no-undo .
      638   define variable g#report-num as integer   no-undo .
      639   define variable g#gds-engl as logical   no-undo .
      640   define variable vv-exch-rate  as decimal   no-undo .
      641   define variable vv-exch-scale as decimal   no-undo .
      642   define variable v-cntxt-host-name-obj as character no-undo .
      643   if v-cntxt-level = 'object':U then do:
      644   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      645   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostname in g#library
      646     (input  v-cntxt-obj-type
      647     ,input  v-cntxt-obj-code
      648     ,output v-cntxt-host-code-obj
      649     ,output v-cntxt-host-name-obj
      650     )  .
      651   end.
      652   if v-cntxt-level = 'firm':U then do:
      653     find first ub.clients no-lock where
      654                ub.clients.obj-type = 'орг':U and
      655                ub.clients.obj-code = v-cntxt-host-code-obj no-error .
      656   if error-status :error then v-cntxt-host-name-obj = ? .
      657      else v-cntxt-host-name-obj = ub.clients.obj-name.
      658   end.
      659   if v-cntxt-level = 'object':U
      660   or v-cntxt-level = 'firm':U
      661   then do:
      662   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      663   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
      664     (input  v-cntxt-host-code-obj
      665     ,output base-code
      666     )  .
      667   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      668   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
      669     (input  base-code
      670     ,input  today
      671     ,output vv-exch-rate
      672     ,output vv-exch-scale
      673     ,output base-type
      674     )  .
      675   end.
      676   run get-report-num in my-handle ( output g#report-num ).
      677   run get-gds-engl in my-handle ( output g#gds-engl ) .
      678   CREATE WIDGET-POOL.
      679   def var State-source as  WIDGET-HANDLE.
      680   define variable v-log as logical   no-undo .
      681   DEFINE VARIABLE var-lavel AS INTEGER FORMAT ">>9":U INITIAL 1
      682        VIEW-AS FILL-IN NATIVE
      683        SIZE 5 BY 1 NO-UNDO.
      684   DEFINE VARIABLE Classify AS CHARACTER
      685        VIEW-AS RADIO-SET VERTICAL
      686        RADIO-BUTTONS
      687             "Без классификации", "no-classify":U,
      688   "Производители", "prod":U,
      689   "Группы товаров", "grp-goods":U,
      690   "Производители/Группы товаров", "prod/grp-goods":U,
      691   "Группы товаров/Производители", "grp-goods/prod":U,
      692   "Ставка НДС", "vat-ps":U
      693        size 32 by 6.29 NO-UNDO.
      694   DEFINE VARIABLE SortType AS CHARACTER
      695        VIEW-AS RADIO-SET VERTICAL
      696        RADIO-BUTTONS
      697             "по коду", "sort-code":U,
      698   "по артикулу", "sort-artic":U,
      699   "по наименов.", "sort-name":U
      700        size 16.88 by 2.5 NO-UNDO.
      701   DEFINE RECTANGLE RECT-5
      702        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      703        SIZE 47.63 BY 9.29.
      704   DEFINE RECTANGLE RECT-6
      705        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      706        SIZE 47.63 BY 3.75.
      707   DEFINE RECTANGLE RECT-8
      708        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      709        SIZE 47.63 BY 4.25.
      710   DEFINE VARIABLE ShowZero AS LOGICAL INITIAL no
      711        LABEL "Нулевые остатки":L
      712        VIEW-AS TOGGLE-BOX
      713        size 19 by 0.83 NO-UNDO.
      714   DEFINE VARIABLE ShowZero-2 AS LOGICAL INITIAL no
      715        LABEL "Нулевые обороты":L
      716        VIEW-AS TOGGLE-BOX
      717        size 19 by 0.83 NO-UNDO.
      718   DEFINE VARIABLE SumsOnly AS LOGICAL INITIAL no
      719        LABEL "Только итоги":L
      720        VIEW-AS TOGGLE-BOX
      721        SIZE 19 BY .83 NO-UNDO.
      722   DEFINE VARIABLE Tog-lavel AS LOGICAL INITIAL no
      723        LABEL "с уровня":L
      724        VIEW-AS TOGGLE-BOX
      725        size 12.63 by 1 NO-UNDO.
      726   DEFINE VARIABLE Tog-obj AS LOGICAL INITIAL yes
      727        LABEL "Раздельно по объектам":L
      728        VIEW-AS TOGGLE-BOX
      729        size 39.38 by 1 NO-UNDO.
      730   DEFINE VARIABLE VAT-Cost AS LOGICAL INITIAL no
      731        LABEL "НДС в учетных ценах":L
      732        VIEW-AS TOGGLE-BOX
      733        size 25.63 by 0.83 NO-UNDO.
      734   DEFINE VARIABLE VAT-CRSA AS LOGICAL INITIAL no
      735        LABEL "НДС в продажных ценах":L
      736        VIEW-AS TOGGLE-BOX
      737        size 25.63 by 0.83 NO-UNDO.
      738   DEFINE VARIABLE VAT-sale AS LOGICAL INITIAL no
      739        LABEL "НДС комиссии":L
      740        VIEW-AS TOGGLE-BOX
      741        size 25.63 by 0.83 NO-UNDO.
      742   DEFINE FRAME F-Main
      743        Tog-obj at row 2.54 col 3.25
      744        Classify at row 3.79 col 3.25 NO-LABEL
      745        Tog-lavel at row 5.96 col 22.5
      746        var-lavel AT ROW 6 COL 33.75 COLON-ALIGNED NO-LABEL
      747        ShowZero-2 at row 11.58 col 3.25
      748        VAT-Cost at row 11.58 col 23.38
      749        ShowZero at row 12.46 col 3.25
      750        VAT-CRSA at row 12.46 col 23.38
      751        SumsOnly AT ROW 13.38 COL 3.25
      752        VAT-sale at row 13.28 col 23.38
      753        SortType at row 15.5 col 3 NO-LABEL
      754        RECT-8 AT ROW 10.29 COL 1.88
      755        "Показать :" VIEW-AS TEXT
      756             size 46.13 by 0.75 at row 10.54 col 3.25
      757             FGCOLOR 4
      758        RECT-5 AT ROW 1 COL 1.88
      759        RECT-6 AT ROW 14.46 COL 1.88
      760        "Сортировка :" VIEW-AS TEXT
      761             size 46.5 by 0.75 at row 14.54 col 2.75
      762             FGCOLOR 4
      763        "Классификация :" VIEW-AS TEXT
      764             size 46 by 0.75 at row 1.28 col 3.5
      765             FGCOLOR 4
      766       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      767            SIDE-LABELS NO-UNDERLINE THREE-D
      768            AT COL 1 ROW 1 SCROLLABLE .
      769   ASSIGN
      770          FRAME F-Main:SCROLLABLE       = FALSE
      771          FRAME F-Main:HIDDEN           = TRUE.
      772   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      773   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      774   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      775   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      776   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      777   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      778   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      779   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      780         adm-object-hdl = FRAME F-Main:HANDLE.
      781   RUN ensure-broker.
      782   THIS-PROCEDURE:ADM-DATA =
      783        'ADM1.1~`':U +
      784        'SmartObject~`':U +
      785        '~`':U +
      786        'NO ~`':U +
      787        '~`':U +
      788        '~`':U +
      789        '~`':U +
      790        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      791           + "~`":U +
      792        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
      793        'Record-Source,Record-Target,TableIO-Target~`':U +
      794        '~`':U +
      795        '~`~`~`~`~`~`~`~`~`~`~`':U +
      796        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      797            THEN "^^":U
      798        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      799             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      800   PROCEDURE adm-apply-entry :
      801     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      802   END PROCEDURE.
      803   PROCEDURE adm-destroy :
      804    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      805   END PROCEDURE.
      806   PROCEDURE adm-disable :
      807       DISABLE RECT-8 RECT-5 RECT-6 Tog-obj Classify ShowZero-2 VAT-Cost ShowZero VAT-CRSA VAT-sale SortType WITH FRAME F-Main.
      808       RUN dispatch ('disable-fields':U).
      809       RUN set-attribute-list ('ENABLED=no':U).
      810       RETURN.
      811   END PROCEDURE.
      812   PROCEDURE adm-edit-attribute-list :
      813         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
      814         RETURN.
      815   END PROCEDURE.
      816   PROCEDURE adm-enable :
      817       ENABLE UNLESS-HIDDEN RECT-8 RECT-5 RECT-6 Tog-obj Classify ShowZero-2 VAT-Cost ShowZero VAT-CRSA VAT-sale SortType WITH FRAME F-Main.
      818       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      819       RUN set-attribute-list ('ENABLED=yes':U).
      820       RETURN.
      821   END PROCEDURE.
      822   PROCEDURE adm-exit :
      823        RUN notify ('exit':U).
      824     RETURN.
      825   END PROCEDURE.
      826   PROCEDURE adm-hide :
      827     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      828   END PROCEDURE.
      829   PROCEDURE adm-initialize :
      830     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      831   END PROCEDURE.
      832   PROCEDURE adm-show-errors :
      833       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      834       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      835           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      836       END.
      837       RETURN.
      838   END PROCEDURE.
      839   PROCEDURE adm-UIB-mode :
      840     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      841   END PROCEDURE.
      842   PROCEDURE adm-view :
      843     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      844   END PROCEDURE.
      845   PROCEDURE dispatch :
      846       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      847       RUN broker-dispatch IN adm-broker-hdl
      848           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      849       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      850   END PROCEDURE.
      851   PROCEDURE ensure-broker :
      852   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      853   IF RETURN-VALUE NE "ADM-Broker":U THEN
      854   DO:
      855       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      856       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      857   END.
      858   END PROCEDURE.
      859   PROCEDURE get-attribute :
      860     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      861     RUN broker-get-attribute IN adm-broker-hdl
      862         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      863     RETURN RETURN-VALUE.
      864   END PROCEDURE.
      865   PROCEDURE get-attribute-list :
      866     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      867     RUN broker-get-attribute-list IN adm-broker-hdl
      868         (INPUT THIS-PROCEDURE,
      869          INPUT ?,
      870          OUTPUT p-attr-list) NO-ERROR.
      871     RETURN.
      872   END PROCEDURE.
      873   PROCEDURE new-state :
      874     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      875     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      876     RETURN.
      877   END PROCEDURE.
      878   PROCEDURE notify :
      879     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      880     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      881     IF RETURN-VALUE = "ADM-ERROR":U THEN
      882         RETURN "ADM-ERROR":U.
      883     RETURN.
      884   END PROCEDURE.
      885   PROCEDURE set-attribute-list :
      886     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      887     RUN ensure-broker.
      888     RUN broker-set-attribute-list IN adm-broker-hdl
      889         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      890     RETURN.
      891   END PROCEDURE.
      892   PROCEDURE set-position :
      893       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      894       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      895       IF VALID-HANDLE(adm-object-hdl) THEN
      896       DO:
      897         ASSIGN adm-object-hdl:ROW    =   p-row
      898                adm-object-hdl:COLUMN =   p-col.
      899       END.
      900       RETURN.
      901   END PROCEDURE.
      902   PROCEDURE adm-display-fields :
      903       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
      904       RETURN.
      905   END PROCEDURE.
      906   PROCEDURE adm-open-query :
      907     RETURN.
      908   END PROCEDURE.
      909   PROCEDURE adm-row-changed :
      910         IF VALID-HANDLE(adm-object-hdl) THEN
      911           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      912         RUN notify ('row-available':U).
      913         RETURN.
      914   END PROCEDURE.
      915   PROCEDURE reposition-query :
      916       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
      917       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
      918       RETURN.
      919   END PROCEDURE.
      920     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
      921     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
      922     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
      923     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
      924     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
      925     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
      926     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
      927     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
      928     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      929     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
      930     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      931     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
      932     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
      933     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
      934     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
      935     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
      936     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
      937     IF "":U = "":U THEN
      938       RUN modify-list-attribute IN adm-broker-hdl
      939         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
      940     RUN use-create-on-add(?).
