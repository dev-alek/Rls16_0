     1560                                                   for each in-vatp-parts where in-vatp-parts.out-code  = buf_doc-line.doc-code  and
     1561                                         in-vatp-parts.obj-type  = buf_doc-line.obj-type  and
     1562                                         in-vatp-parts.obj-code  = buf_doc-line.obj-code  and
     1563                                         in-vatp-parts.artic     = buf_doc-line.artic     and
     1564                                         in-vatp-parts.prod-type = buf_doc-line.prod-type and
     1565                                         in-vatp-parts.prod-code = buf_doc-line.prod-code
     1566                            use-index out-code no-lock:
     1567             accumulate  in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty (total)
     1568                         in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty (total)
     1569                         in-vatp-parts.transport-base * in-vatp-parts.fact-qnty (total)
     1570                         in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty (total)
     1571                         in-vatp-parts.other-base     * in-vatp-parts.fact-qnty (total)
     1572                         in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty (total)
     1573                                                                                                                 (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  (total)
     1574                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
     1575                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))  (total)
     1576                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc))  (total)
     1577                                               (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  (total)
     1578                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
     1579                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))  (total)
     1580                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc))  (total)
     1581                         .
     1582         end.
     1583         ASSIGN
     1584           road-tax-base-loc   = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     1585           road-tax-rubl-loc   = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     1586           transport-base-loc  = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-base * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     1587           transport-rubl-loc  = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     1588           other-base-loc      = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-base     * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     1589           other-rubl-loc      = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     1590                                           vat-base-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / buf_doc-line.fact-qnty   else 0
     1591           slt-base-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / buf_doc-line.fact-qnty   else 0
     1592                   vat-rubl-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / buf_doc-line.fact-qnty   else 0
     1593           slt-rubl-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / buf_doc-line.fact-qnty   else 0
     1594           vat-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc)))
     1595           slt-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))).
     1596         if road-tax-base-loc  = ? then road-tax-base-loc  = 0.
     1597         if road-tax-rubl-loc  = ? then road-tax-rubl-loc  = 0.
     1598         if transport-base-loc = ? then transport-base-loc = 0.
     1599         if transport-rubl-loc = ? then transport-rubl-loc = 0.
     1600         if other-base-loc     = ? then other-base-loc     = 0.
     1601         if other-rubl-loc     = ? then other-rubl-loc     = 0.
     1602         assign
     1603           transport-cli-loc      = 0
     1604           other-cli-loc          = 0
     1605           road-tax-cli-loc       = ?
     1606           vat-cli-loc            = ?
     1607           slt-cli-loc            = ?
     1608           price-cli-with-tax-loc = ?.
     1609      end.
     1610   ASSIGN
     1611             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     1612       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     1613   .
     1614             assign
     1615               v-fact-qnty           = v-fact-qnty      + v-parts-fact-qnty
     1616               v-vat-pc              = vat-pc-loc
     1617               v-slt-pc              = slt-pc-loc
     1618               v-sum-base            = v-sum-base       + (price-base-with-tax-loc * v-parts-fact-qnty)
     1619               v-sum-rubl            = v-sum-rubl       + (price-rubl-with-tax-loc * v-parts-fact-qnty)
     1620               v-vat-base            = v-vat-base       + (vat-base-loc            * v-parts-fact-qnty)
     1621               v-vat-rubl            = v-vat-rubl       + (vat-rubl-loc            * v-parts-fact-qnty)
     1622               v-slt-base            = v-slt-base       + (slt-base-loc            * v-parts-fact-qnty)
     1623               v-slt-rubl            = v-slt-rubl       + (slt-rubl-loc            * v-parts-fact-qnty)
     1624               v-road-tax-base       =  0
     1625               v-road-tax-rubl       =  0
     1626               v-excise-base         =  0
     1627               v-excise-rubl         =  0
     1628               v-transport-base      =  0
     1629               v-transport-rubl      =  0
     1630               v-other-base          =  0
     1631               v-other-rubl          =  0
     1632             .
     1633       end.
     1634     end.
     1635   end procedure.
     1636   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1637   procedure factord :
     1638     define input  parameter p-fact-date            as date    no-undo .
     1639     define input  parameter p-fact-time            as integer no-undo .
     1640     define input  parameter p-fact-num             as integer no-undo .
     1641     define input  parameter p-shift-date           as date    no-undo .
     1642     define input  parameter p-shift-num            as integer no-undo .
     1643     define input  parameter p-shift-on             as logical no-undo .
     1644     define output parameter p-fact-order           as decimal no-undo .
     1645     define output parameter p-shift-end-fact-order as decimal no-undo .
     1646     define output parameter p-day-end-fact-order   as decimal no-undo .
     1647     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     1648     if p-fact-date = ?
     1649     then do:
     1650       return error "Не указана фактическая дата" .
     1651     end.
     1652     define variable v-fact-date-num as integer no-undo .
     1653     assign
     1654       v-fact-date-num = integer(p-fact-date)
     1655     .
     1656     if p-fact-num = ?
     1657     or p-fact-num = 0
     1658     then do:
     1659       return error "Не задан p-fact-num " + string(p-fact-num) .
     1660     end.
     1661     if p-fact-num < 0
     1662     then do:
     1663       return error "Отрицательный fact-num " + string(p-fact-num) .
     1664     end.
     1665     if p-fact-num >= 100000000
     1666     then do:
     1667       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     1668     end.
     1669     if p-shift-on = true
     1670     then do:
     1671       if p-shift-date = ?
     1672       then do:
     1673         return error "Не задана дата смены" .
     1674       end.
     1675       if p-shift-num = ?
     1676       or p-shift-num = 0
     1677       then do:
     1678         return error "Не задан номер смены" .
     1679       end.
     1680     end.
     1681     else do:
     1682       assign
     1683         p-shift-date = p-fact-date
     1684         p-shift-num  = 24
     1685       .
     1686     end.
     1687     define variable v-shift-offset as integer no-undo .
     1688     if p-shift-date = p-fact-date
     1689     then do:
     1690       assign
     1691         v-shift-offset = 1
     1692       .
     1693     end.
     1694     if p-shift-date < p-fact-date
     1695     then do:
     1696       assign
     1697         v-shift-offset = 0
     1698       .
     1699     end.
     1700     if p-shift-date > p-fact-date
     1701     then do:
     1702       message
     1703         vss-workfile vss-revision vss-description skip
     1704         "Неправильная дата закрытия смены" skip
     1705         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     1706         view-as alert-box error .
     1707       undo, return error
     1708         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     1709           ,string(p-fact-date, '99/99/9999':U)
     1710           ,string(p-shift-date, '99/99/9999':U)
     1711           )
     1712       .
     1713     end.
     1714     if p-shift-num < 1
     1715     or p-shift-num > 24
     1716     then do:
     1717       message
     1718         vss-workfile vss-revision vss-description skip
     1719         "Неправильный номер смены" skip
     1720         "p-shift-num" p-shift-num skip
     1721         view-as alert-box error .
     1722       undo, return error return-value .
     1723     end.
     1724     assign
     1725       p-fact-order           = v-fact-date-num
     1726                              + v-shift-offset * 0.5
     1727                              + p-shift-num    * 0.02 - 0.01
     1728                              + p-fact-num     * 0.0000000001
     1729       p-shift-end-fact-order = v-fact-date-num
     1730                              + v-shift-offset * 0.5
     1731                              + p-shift-num    * 0.02
     1732       p-day-end-fact-order   = v-fact-date-num
     1733                              + 0.99
     1734     .
     1735     if p-fact-order           <= v-fact-date-num
     1736     or p-shift-end-fact-order <= v-fact-date-num
     1737     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     1738     or p-shift-end-fact-order >= p-day-end-fact-order
     1739     then do:
     1740       message
     1741         vss-workfile vss-revision vss-description skip
     1742         "Внутренняя ошибка при генерации фактического номера" skip
     1743         "p-fact-date"            p-fact-date            skip
     1744         "p-fact-time"            p-fact-time            skip
     1745         "p-fact-num"             p-fact-num             skip
     1746         "p-shift-date"           p-shift-date           skip
     1747         "p-shift-num"            p-shift-num            skip
     1748         "p-shift-on"             p-shift-on             skip
     1749         "p-shift-end-fact-order" p-shift-end-fact-order skip
     1750         "p-day-end-fact-order"   p-day-end-fact-order   skip
     1751         "v-fact-date-num"        v-fact-date-num        skip
     1752         view-as alert-box error .
     1753       undo, return error return-value .
     1754     end.
     1755   end procedure.
     1756   procedure day-begin-fact-order :
     1757     define input  parameter p-fact-date            as date    no-undo .
     1758     define output parameter p-day-begin-fact-order as decimal no-undo .
     1759     do
     1760     on error undo, return error return-value
     1761     :
     1762       if p-fact-date = ?
     1763       then do:
     1764         assign
     1765           p-day-begin-fact-order = 0
     1766         .
     1767       end.
     1768       else do:
     1769         assign
     1770           p-day-begin-fact-order = integer(p-fact-date)
     1771         .
     1772       end.
     1773     end.
     1774   end procedure.
     1775   procedure factord-max-fact-order :
     1776     define output parameter p-max-fact-order as decimal   no-undo .
     1777     do
     1778     on error undo, return error return-value
     1779     :
     1780       run day-begin-fact-order in this-procedure
     1781         (input  date(1, 1, 5000)
     1782         ,output p-max-fact-order
     1783         ) .
     1784     end.
     1785   end procedure.
     1786   procedure factord-cut-archive :
     1787     define input  parameter p-obj-type             as character no-undo .
     1788     define input  parameter p-obj-code             as integer   no-undo .
     1789     define input  parameter p-fact-date            as date      no-undo .
     1790     define output parameter p-shift-on             as logical   no-undo .
     1791     define output parameter p-shift-date           as date      no-undo .
     1792     define output parameter p-shift-num            as integer   no-undo .
     1793     define output parameter p-day-end-fact-order   as decimal   no-undo .
     1794     define output parameter p-shift-end-fact-order as decimal   no-undo .
     1795     define variable v-fact-order as decimal   no-undo .
     1796     define buffer buf_shift-obj for ub.shift-obj .
     1797     do
     1798     on error undo, return error return-value
     1799     :
     1800   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1801   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1802     (input  p-obj-type
     1803     ,input  p-obj-code
     1804     ,input  'shift-on=request'
     1805     ,output p-shift-on
     1806     ) no-error .
     1807       if error-status :error
     1808       then do:
     1809         message
     1810           vss-workfile vss-revision vss-description skip
     1811           "Ошибка при определении атрибута объекта" skip
     1812           "Объект" p-obj-type p-obj-code skip
     1813           error-status :get-message(1) skip
     1814           return-value skip
     1815           view-as alert-box error .
     1816         undo, return error return-value .
     1817       end.
     1818       if p-shift-on = false
     1819       then do:
     1820         assign
     1821           p-shift-date               = ?
     1822           p-shift-num                = 0
     1823         .
     1824       end.
     1825       else do:
     1826         find first buf_shift-obj share-lock
     1827           where buf_shift-obj.obj-type   = p-obj-type
     1828             and buf_shift-obj.obj-code   = p-obj-code
     1829             and buf_shift-obj.shift-date > p-fact-date
     1830           use-index pi
     1831           no-error .
     1832         if not available buf_shift-obj
     1833         or buf_shift-obj.status_ <> 'зкр':U
     1834         then do:
     1835           message
     1836             vss-workfile vss-revision vss-description skip
     1837             "Невозможно вычислить последнюю смену" skip
     1838             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1839             "Объект" p-obj-type p-obj-code skip
     1840             "Дата" p-fact-date skip
     1841             view-as alert-box error .
     1842           undo, return error return-value .
     1843         end.
     1844         find last buf_shift-obj share-lock
     1845           where buf_shift-obj.obj-type = p-obj-type
     1846             and buf_shift-obj.obj-code = p-obj-code
     1847             and buf_shift-obj.shift-date <= p-fact-date
     1848           use-index pi
     1849           no-error .
     1850         if available buf_shift-obj
     1851         then do:
     1852           if  buf_shift-obj.status_ = 'зкр':U
     1853           then do:
     1854             assign
     1855               p-shift-date = buf_shift-obj.shift-date
     1856               p-shift-num  = buf_shift-obj.shift-num
     1857             .
     1858           end.
     1859           else do:
     1860             message
     1861               vss-workfile vss-revision vss-description skip
     1862               "Невозможно вычислить последнюю смену" skip
     1863               "Статус смены отличен от статуса" 'зкр':U skip
     1864               "Объект" p-obj-type p-obj-code skip
     1865               "Дата" p-fact-date skip
     1866               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1867               view-as alert-box error .
     1868             undo, return error return-value .
     1869           end.
     1870         end.
     1871         else do:
     1872           assign
     1873             p-shift-date = p-fact-date - 1
     1874             p-shift-num  = 1
     1875           .
     1876         end.
     1877       end.
     1878       run factord in this-procedure
     1879         (input  p-fact-date
     1880         ,input  1
     1881         ,input  1
     1882         ,input  p-shift-date
     1883         ,input  p-shift-num
     1884         ,input  p-shift-on
     1885         ,output v-fact-order
     1886         ,output p-shift-end-fact-order
     1887         ,output p-day-end-fact-order
     1888         ) no-error .
     1889       if error-status :error
     1890       then do:
     1891         message
     1892           vss-workfile vss-revision vss-description skip
     1893           "Ошибка при вызове процедуры factord"
     1894           error-status :get-message(1) skip
     1895           return-value skip
     1896           view-as alert-box error .
     1897         undo, return error return-value .
     1898       end.
     1899     end.
     1900   end procedure.
     1901   procedure factord-lock-shift :
     1902     define input  parameter p-obj-type  as character no-undo .
     1903     define input  parameter p-obj-code  as integer   no-undo .
     1904     define input  parameter p-fact-date as date      no-undo .
     1905     define parameter buffer buf_shift-obj for ub.shift-obj .
     1906     define variable v-shift-on      as logical   no-undo .
     1907     define variable v-extra-message as character no-undo .
     1908     define variable v-error as character no-undo .
     1909     do
     1910     on error undo, return error return-value
     1911     :
     1912   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1913   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1914     (input  p-obj-type
     1915     ,input  p-obj-code
     1916     ,input  'shift-on=request'
     1917     ,output v-shift-on
     1918     ) no-error .
     1919       if error-status :error
     1920       then do:
     1921         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1922         undo, return error v-error .
     1923       end.
     1924       if v-shift-on = true
     1925       then do:
     1926         find first buf_shift-obj share-lock
     1927           where buf_shift-obj.obj-type   = p-obj-type
     1928             and buf_shift-obj.obj-code   = p-obj-code
     1929             and buf_shift-obj.shift-date > p-fact-date
     1930           use-index pi
     1931           no-error .
     1932         if not available buf_shift-obj
     1933         or buf_shift-obj.status_ <> 'зкр':U
     1934         then do:
     1935           find last buf_shift-obj
     1936             where buf_shift-obj.obj-type = p-obj-type
     1937               and buf_shift-obj.obj-code = p-obj-code
     1938               and buf_shift-obj.status_  = 'зкр':U
     1939             use-index stts
     1940             no-error .
     1941           if available buf_shift-obj
     1942           then do:
     1943             assign
     1944               v-extra-message =
     1945                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1946                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1947                               )
     1948             .
     1949           end.
     1950           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1951           undo, return error v-error .
     1952         end.
     1953       end.
     1954     end.
     1955   end procedure.
     1956   procedure factord-end-day :
     1957     define input  parameter p-fact-date            as date    no-undo .
     1958     define output parameter p-day-end-fact-order   as decimal no-undo .
     1959     do
     1960     on error undo, return error return-value
     1961     :
     1962       if p-fact-date = ?
     1963       then do:
     1964         return error "Не указана фактическая дата" .
     1965       end.
     1966       assign
     1967         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1968       .
     1969     end.
     1970   end procedure.
     1971   procedure factord-to-date :
     1972     define input  parameter p-fact-order as decimal no-undo .
     1973     define output parameter p-fact-date  as date    no-undo .
     1974     define variable v-ref-date  as date      no-undo .
     1975     define variable v-ref-delta as integer   no-undo .
     1976     do
     1977     on error undo, return error return-value
     1978     :
     1979       if p-fact-order = ?
     1980       or p-fact-order = 0
     1981       then do:
     1982         return error "Не указан fact-order" .
     1983       end.
     1984       assign
     1985         v-ref-date  = date(1, 1, 2000)
     1986       .
     1987       assign
     1988         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1989       .
     1990       assign
     1991         p-fact-date = v-ref-date + v-ref-delta
     1992       .
     1993     end.
     1994   end procedure.
     1995   procedure factord-to-fact-num :
     1996     define input  parameter p-fact-order as decimal no-undo .
     1997     define output parameter p-fact-num   as integer no-undo .
     1998     define variable v-fact-order-trunc as decimal no-undo .
     1999     do
     2000     on error undo, return error return-value
     2001     :
     2002       if p-fact-order = ?
     2003       or p-fact-order = 0
     2004       then do:
     2005         return error "Не указан fact-order" .
     2006       end.
     2007       assign
     2008        v-fact-order-trunc = truncate(p-fact-order, 2)
     2009       .
     2010       assign
     2011         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     2012       .
     2013     end.
     2014   end procedure.
     2015   procedure factord-to-shift-num :
     2016     define input  parameter p-fact-order as decimal no-undo .
     2017     define output parameter p-shift-num   as integer no-undo .
     2018     define variable  p-shift-numd  as decimal   no-undo .
     2019     define variable v-fact-order-trunc as decimal no-undo .
     2020     do
     2021     on error undo, return error return-value
     2022     :
     2023       if p-fact-order = ?
     2024       or p-fact-order = 0
     2025       then do:
     2026         return error "Не указан fact-order" .
     2027       end.
     2028       assign
     2029        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     2030       .
     2031       if v-fact-order-trunc < 0.5 then do:
     2032         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     2033       end.
     2034       assign
     2035         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     2036         .
     2037        assign
     2038         p-shift-num = truncate (p-shift-numd , 0)
     2039       .
     2040     end.
     2041   end procedure.
     2042   def var vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2043   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     2044   procedure paramls-clear :
