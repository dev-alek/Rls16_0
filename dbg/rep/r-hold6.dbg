     1096               vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else (((buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * buf_gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - varprice-rubl-cons) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * buf_gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     1097        .
     1098     end.
     1099   end.
     1100   assign
     1101   price-base-without-tax-sale = price-base-with-tax-sale - vat-base-sale - slt-base-sale - road-tax-base-sale
     1102   price-rubl-without-tax-sale = price-rubl-with-tax-sale - vat-rubl-sale - slt-rubl-sale - road-tax-rubl-sale.
     1103               ASSIGN
     1104                   p-fact-qnty           = p-fact-qnty     + v-gds-dtl-fact-qnty
     1105                   p-sum-base            = p-sum-base      + price-base-with-tax-sale  * v-gds-dtl-fact-qnty
     1106                   p-sum-rubl            = p-sum-rubl      + price-rubl-with-tax-sale  * v-gds-dtl-fact-qnty
     1107                   p-vat-base            = p-vat-base      + vat-base-sale             * v-gds-dtl-fact-qnty
     1108                   p-vat-rubl            = p-vat-rubl      + vat-rubl-sale             * v-gds-dtl-fact-qnty
     1109                   p-slt-base            = p-slt-base      + slt-base-sale             * v-gds-dtl-fact-qnty
     1110                   p-slt-rubl            = p-slt-rubl      + slt-rubl-sale             * v-gds-dtl-fact-qnty
     1111                   p-road-tax-base       = p-road-tax-base + road-tax-base-sale        * v-gds-dtl-fact-qnty
     1112                   p-road-tax-rubl       = p-road-tax-rubl + road-tax-rubl-sale        * v-gds-dtl-fact-qnty
     1113                   p-excise-base         = p-excise-base   + excise-base-sale          * v-gds-dtl-fact-qnty
     1114                   p-excise-rubl         = p-excise-rubl   + excise-rubl-sale          * v-gds-dtl-fact-qnty
     1115                   p-other-base          = p-other-base    + discnt-base-sale          * v-gds-dtl-fact-qnty
     1116                   p-other-rubl          = p-other-rubl    + discnt-rubl-sale          * v-gds-dtl-fact-qnty
     1117               .
     1118           end.
     1119       end.
     1120       assign
     1121           p-transport-base      = 0
     1122           p-transport-rubl      = 0
     1123           p-vat-pc              = buf_doc-line.vat-pc
     1124           p-slt-pc              = buf_doc-line.slt-pc
     1125       .
     1126     end.
     1127     if p-fact-qnty      = ?
     1128     or p-vat-pc         = ?
     1129     or p-slt-pc         = ?
     1130     or p-sum-base       = ?
     1131     or p-sum-rubl       = ?
     1132     or p-vat-base       = ?
     1133     or p-vat-rubl       = ?
     1134     or p-slt-base       = ?
     1135     or p-slt-rubl       = ?
     1136     or p-road-tax-base  = ?
     1137     or p-road-tax-rubl  = ?
     1138     or p-transport-base = ?
     1139     or p-transport-rubl = ?
     1140     or p-other-base     = ?
     1141     or p-other-rubl     = ?
     1142     or p-excise-base    = ?
     1143     or p-excise-rubl    = ?
     1144     then do:
     1145       message
     1146         vss-workfile vss-revision vss-description skip
     1147         vss-include-info9 skip
     1148         "Получены неопределенные значения" skip
     1149         "Документ" p-doc-code skip
     1150         "Артикул" p-artic p-prod-type p-prod-code skip
     1151         "fact-qnty     " p-fact-qnty      skip
     1152         "vat-pc        " p-vat-pc         skip
     1153         "slt-pc        " p-slt-pc         skip
     1154         "sum-base      " p-sum-base       skip
     1155         "sum-rubl      " p-sum-rubl       skip
     1156         "vat-base      " p-vat-base       skip
     1157         "vat-rubl      " p-vat-rubl       skip
     1158         "slt-base      " p-slt-base       skip
     1159         "slt-rubl      " p-slt-rubl       skip
     1160         "road-tax-base " p-road-tax-base  skip
     1161         "road-tax-rubl " p-road-tax-rubl  skip
     1162         "transport-base" p-transport-base skip
     1163         "transport-rubl" p-transport-rubl skip
     1164         "other-base    " p-other-base     skip
     1165         "other-rubl    " p-other-rubl     skip
     1166         "excise-base   " p-excise-base    skip
     1167         "excise-rubl   " p-excise-rubl    skip
     1168         view-as alert-box error .
     1169       undo, return error .
     1170     end.
     1171   end procedure.
     1172   define variable vss-include-info13 as character format "X(65)" no-undo
     1173   initial "@(#)$Workfile$ $Revision$".
     1174   def var vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1175   procedure r-cost :
     1176     define input  parameter v-doc-code       like ub.doc-line.doc-code          no-undo .
     1177     define input  parameter v-artic          like ub.doc-line.artic             no-undo .
     1178     define input  parameter v-prod-type      like ub.doc-line.prod-type         no-undo .
     1179     define input  parameter v-prod-code      like ub.doc-line.prod-code         no-undo .
     1180     define output parameter v-fact-qnty      like ub.ot-line.fact-qnty       no-undo .
     1181     define output parameter v-vat-pc         like ub.doc-line.vat-pc         no-undo .
     1182     define output parameter v-slt-pc         like ub.doc-line.slt-pc         no-undo .
     1183     define output parameter v-sum-base       like ub.ot-line.sum-base        no-undo .
     1184     define output parameter v-sum-rubl       like ub.ot-line.sum-rubl        no-undo .
     1185     define output parameter v-vat-base       like ub.ot-line.vat-base        no-undo .
     1186     define output parameter v-vat-rubl       like ub.ot-line.vat-rubl        no-undo .
     1187     define output parameter v-slt-base       like ub.ot-line.slt-base        no-undo .
     1188     define output parameter v-slt-rubl       like ub.ot-line.slt-rubl        no-undo .
     1189     define output parameter v-road-tax-base  like ub.ot-line.road-tax-base   no-undo .
     1190     define output parameter v-road-tax-rubl  like ub.ot-line.road-tax-rubl   no-undo .
     1191     define output parameter v-transport-base like ub.ot-line.transport-base  no-undo .
     1192     define output parameter v-transport-rubl like ub.ot-line.transport-rubl  no-undo .
     1193     define output parameter v-other-base     like ub.ot-line.other-base      no-undo .
     1194     define output parameter v-other-rubl     like ub.ot-line.other-rubl      no-undo .
     1195     define output parameter v-excise-base    like ub.ot-line.excise-base     no-undo .
     1196     define output parameter v-excise-rubl    like ub.ot-line.excise-rubl     no-undo .
     1197     do
     1198     on error undo, return error
     1199     :
     1200       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     1201       define buffer   in-vatp-parts    for ub.parts   .
     1202       define buffer   in-vatp-doc      for ub.trn-doc .
     1203       define buffer   in-vatp-goods    for ub.goods   .
     1204       define buffer   in-vatp-sysconf  for ub.sysconf .
     1205       define buffer   in-vatp_doc-attr for ub.doc-attr.
     1206       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     1207       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     1208       define variable varinvprb                  as   character              no-undo.
     1209       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     1210       define variable cli-base-rate              as   decimal                no-undo.
     1211       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     1212       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     1213       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     1214       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     1215       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     1216       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     1217       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     1218       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1219       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     1220       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     1221       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1222       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     1223       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     1224       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     1225       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     1226       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     1227       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     1228       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     1229       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     1230       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     1231       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     1232       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     1233       define variable varinvatp-envd             as   character              no-undo.
     1234       define variable varinvatp-type             as   character              no-undo.
     1235       def var v-parts-fact-qnty as decimal   no-undo .
     1236       define buffer buf_parts    for ub.parts    .
     1237       define buffer buf_goods    for ub.goods    .
     1238       define buffer buf_trn-doc  for ub.trn-doc  .
     1239       define buffer buf_doc-line for ub.doc-line .
     1240       find first buf_doc-line no-lock
     1241         where buf_doc-line.doc-code  = v-doc-code
     1242           and buf_doc-line.artic     = v-artic
     1243           and buf_doc-line.prod-type = v-prod-type
     1244           and buf_doc-line.prod-code = v-prod-code
     1245         no-error .
     1246       if not available buf_doc-line then do:
     1247         message
     1248           vss-workfile vss-revision vss-description skip
     1249           vss-include-info14 skip
     1250           "Ошибка задания входных параметров" skip
     1251           "Не найдена строка документа"  skip
     1252           "Документ" v-doc-code skip
     1253           "Артикул" v-artic v-prod-type v-prod-code skip
     1254           view-as alert-box error .
     1255         return error .
     1256       end.
     1257       find first buf_trn-doc no-lock
     1258         where buf_trn-doc.doc-code = v-doc-code
     1259         no-error .
     1260       if not available buf_trn-doc then do:
     1261         message
     1262           vss-workfile vss-revision vss-description skip
     1263           vss-include-info14 skip
     1264           "Ошибка задания входных параметров" skip
     1265           "Не найден документ" skip
     1266           "Документ" v-doc-code skip
     1267           "Артикул" v-artic v-prod-type v-prod-code skip
     1268           view-as alert-box error .
     1269         undo, return error .
     1270       end.
     1271       find first buf_goods no-lock
     1272         where buf_goods.artic     = buf_doc-line.artic
     1273           and buf_goods.prod-type = buf_doc-line.prod-type
     1274           and buf_goods.prod-code = buf_doc-line.prod-code
     1275         no-error .
     1276       if not available buf_goods then do:
     1277         message
     1278           vss-workfile vss-revision vss-description skip
     1279           vss-include-info14 skip
     1280           "Ошибка задания входных параметров" skip
     1281           "Не найден товар" skip
     1282           "Документ" v-doc-code skip
     1283           "Артикул" v-artic v-prod-type v-prod-code skip
     1284           view-as alert-box error .
     1285         undo, return error .
     1286       end.
     1287       if buf_goods.gds-type = 'т':U then do:
     1288             for each buf_parts no-lock
     1289               where buf_parts.out-code  = buf_trn-doc.doc-code
     1290                 and buf_parts.obj-type  = buf_trn-doc.obj-type
     1291                 and buf_parts.obj-code  = buf_trn-doc.obj-code
     1292                 and buf_parts.artic     = buf_doc-line.artic
     1293                 and buf_parts.prod-type = buf_doc-line.prod-type
     1294                 and buf_parts.prod-code = buf_doc-line.prod-code
     1295             on error undo, return error
     1296             :
     1297   assign
     1298     price-rubl-with-tax-loc = buf_parts.price-rubl
     1299     price-base-with-tax-loc = buf_parts.price-base
     1300   .
     1301   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1302   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1303     (output varinvprb
     1304     )  .
     1305     if buf_parts.out-code = 'free-zone':U     or
     1306        buf_parts.out-code = 'out-zone':U   or
     1307        buf_parts.doc-type = 'акт':U then do:
     1308       assign
     1309         in-vatp-have-vat-slt = yes.
     1310     end.
     1311     else do:
     1312       find first in-vatp_doc-attr no-lock
     1313         where in-vatp_doc-attr.doc-code  = buf_parts.out-code
     1314           and in-vatp_doc-attr.attr-code = 'envd':U
     1315         no-error .
     1316       if not available in-vatp_doc-attr then do:
     1317         assign
     1318           in-vatp-have-vat-slt = yes.
     1319       end.
     1320       else do:
     1321            in-vatp-have-vat-slt = no.
     1322       end.
     1323     end.
     1324     assign
     1325      price-cli-with-tax-loc = buf_parts.price-cli
     1326      cli-base-rate          = buf_parts.cli-base-rate.
     1327     ASSIGN   road-tax-base-loc  = (if buf_parts.road-tax-base  = ? then 0 else buf_parts.road-tax-base)
     1328              road-tax-rubl-loc  = (if buf_parts.road-tax-rubl  = ? then 0 else buf_parts.road-tax-rubl).
     1329     ASSIGN  transport-base-loc = (if buf_parts.transport-base = ? then 0 else buf_parts.transport-base)
     1330             transport-rubl-loc = (if buf_parts.transport-rubl = ? then 0 else buf_parts.transport-rubl)
     1331             other-base-loc     = (if buf_parts.other-base     = ? then 0 else buf_parts.other-base)
     1332             other-rubl-loc     = (if buf_parts.other-rubl     = ? then 0 else buf_parts.other-rubl)
     1333             vat-pc-loc         = (if buf_parts.vat-pc         = ? then 0 else buf_parts.vat-pc)
     1334             slt-pc-loc         = (if buf_parts.slt-pc         = ? then 0 else buf_parts.slt-pc).
     1335             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1336       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1337     assign
     1338       exch-rate-cli-loc = (buf_parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_parts.price-cli .
     1339     assign
     1340       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     1341       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     1342       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     1343       transport-cli-loc  = 0
     1344       other-cli-loc      = 0
     1345     .
     1346   ASSIGN
     1347             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     1348       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     1349   .
     1350               assign
     1351                 v-parts-fact-qnty  = (if buf_trn-doc.doc-type = 'при':U
     1352                                       or buf_trn-doc.doc-type = 'возврат':U
     1353                                       or buf_trn-doc.doc-type = 'инв':U
     1354                                       then buf_parts.fact-qnty
     1355                                       else - buf_parts.fact-qnty
     1356                                      )
     1357               .
     1358               assign
     1359                 v-fact-qnty           = v-fact-qnty      + v-parts-fact-qnty
     1360                 v-sum-base            = v-sum-base       +  ( price-base-with-tax-loc * v-parts-fact-qnty )
     1361                 v-sum-rubl            = v-sum-rubl       +  ( price-rubl-with-tax-loc * v-parts-fact-qnty )
     1362                 v-vat-base            = v-vat-base       +  ( vat-base-loc            * v-parts-fact-qnty )
     1363                 v-vat-rubl            = v-vat-rubl       +  ( vat-rubl-loc            * v-parts-fact-qnty )
     1364                 v-slt-base            = v-slt-base       +  ( slt-base-loc            * v-parts-fact-qnty )
     1365                 v-slt-rubl            = v-slt-rubl       +  ( slt-rubl-loc            * v-parts-fact-qnty )
     1366                 v-road-tax-base       = v-road-tax-base  +  ( road-tax-base-loc       * v-parts-fact-qnty )
     1367                 v-road-tax-rubl       = v-road-tax-rubl  +  ( road-tax-rubl-loc       * v-parts-fact-qnty )
     1368                 v-excise-base         =   0
     1369                 v-excise-rubl         =   0
     1370                 v-transport-base      = v-transport-base +   (transport-base-loc      * v-parts-fact-qnty )
     1371                 v-transport-rubl      = v-transport-rubl +   (transport-rubl-loc      * v-parts-fact-qnty )
     1372                 v-other-base          = v-other-base     +   (other-base-loc          * v-parts-fact-qnty )
     1373                 v-other-rubl          = v-other-rubl     +   (other-rubl-loc          * v-parts-fact-qnty )
     1374               .
     1375           end.
     1376   assign
     1377     price-rubl-with-tax-loc = buf_doc-line.price-rubl
     1378     price-base-with-tax-loc = buf_doc-line.price-base
     1379   .
     1380   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$".
