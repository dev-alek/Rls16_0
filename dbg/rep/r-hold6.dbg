     2259   procedure macr_cell_size :
     2260    do
     2261    on error undo, return error return-value
     2262    :
     2263    define input parameter  p-w   as integer   no-undo .
     2264    define input parameter  p-l   as integer   no-undo .
     2265    define input parameter  p-row    as integer   no-undo .
     2266    define input parameter  p-col    as integer   no-undo .
     2267    define input parameter  p-row-2  as integer   no-undo .
     2268    define input parameter  p-col-2  as integer   no-undo .
     2269     if p-row-2 = ? then p-row-2 = p-row .
     2270     if p-col-2 = ? then p-col-2 = p-col .
     2271     if p-w = ? then    p-w = 0 .
     2272     if p-l = ? then    p-l = 0 .
     2273    define variable s-w as character no-undo .
     2274    define variable s-l as character no-undo .
     2275    if p-w = 0 then s-w = "" .
     2276               else s-w = string(p-w)  .
     2277    if p-l = 0 then s-l = "" .
     2278               else s-l = string(p-l)  .
     2279   put  stream macr_excel unformatted
     2280        substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 )  skip .
     2281   put  stream macr_excel unformatted
     2282        substitute('COLUMN.WIDTH(&1,,,,)' , s-w  )  skip.
     2283   put  stream macr_excel unformatted
     2284        'FORMAT.TEXT(2,2,0,,,,,)'  skip.
     2285    end.
     2286   end procedure.
