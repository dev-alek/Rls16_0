     2225      substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 ) skip .
     2226     put  stream macr_excel unformatted
     2227          'BORDER( 2 , 2 , 2 , 2 , 2 , ,0,0,0,0,0) '  skip
