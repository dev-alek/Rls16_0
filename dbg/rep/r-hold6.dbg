      605   function excel-format-dec-to-char returns char (input p-dec as decimal ).
      606     if num-entries(string(p-dec), '.') = 2
      607       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
      608       else return( string(p-dec)) .
      609   end function.
      610   function format-point-to-comma returns char (input orig as char ) .
      611   define variable rtext as character no-undo .
      612   define variable strt as integer no-undo .
      613   define variable leng as integer no-undo .
      614   assign rtext = orig .
      615   repeat:
      616     strt =  index(rtext,'.').
      617     if strt = 0 then leave.
      618     leng = 1.
      619     substring(rtext,strt,leng,"character") = v-delim .
      620   end.
      621   return rtext.
      622   end function.
      623   function format-excel-text returns char ( input start-text as char ) :
      624   def var  i    as int no-undo.
      625   def var  ch   as char no-undo.
      626   def var  n    as int no-undo.
      627   def var  ipos as int no-undo.
      628     n = num-entries(trim(start-text), chr(10)) - 1 .
      629     do i = 1 to n :
      630       ipos = index( start-text, chr(10)).
      631       if ipos > 0 then
      632         substr( start-text, ipos, 1 ) = ' '.
      633     end.
      634     n = num-entries(trim(start-text), chr(13)) - 1 .
      635     do i = 1 to n :
      636       ipos = index( start-text, chr(13)).
      637       if ipos > 0 then
      638         substr( start-text, ipos, 1 ) = ' '.
      639     end.
      640     if index( start-text, '"' ) = 0 then
      641       start-text =  '="'   + trim( start-text) + '"'   .
      642       else do:
      643         n = num-entries(trim(start-text), '"') - 1.
      644         do i = 1 to n :
      645           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      646         end.
      647         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      648         start-text = '="'  + ch  + '"' .
      649       end.
      650     return start-text.
      651   end.
      652   function excel-sum returns char (input p-dec as decimal ).
      653     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
      654   end function.
      655   function excel-qnty returns char (input p-dec as decimal ).
      656     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
      657   end function.
      658   function format-excel-text-macr returns char ( input start-text as char ) :
      659   def var  i    as int no-undo.
      660   def var  ch   as char no-undo.
      661   def var  n    as int no-undo.
      662   def var  ipos as int no-undo.
      663     n = num-entries(trim(start-text), chr(10)) - 1 .
      664     do i = 1 to n :
      665       ipos = index( start-text, chr(10)).
      666       if ipos > 0 then
      667         substring( start-text, ipos , 1 ) = ' '.
      668     end.
      669     n = num-entries(trim(start-text), chr(13)) - 1 .
      670     do i = 1 to n :
      671       ipos = index( start-text, chr(13)).
      672       if ipos > 0 then
      673         substring( start-text, ipos, 1 ) = ' '.
      674     end.
      675     if index( start-text, '"' ) = 0 then
      676       start-text =  '"'   + trim( start-text) + '"'   .
      677       else do:
      678         n = num-entries(trim(start-text), '"') - 1.
      679         do i = 1 to n :
      680           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      681         end.
      682         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      683         start-text = '"'  + ch  + '"' .
      684       end.
      685     n = num-entries(trim(start-text), chr(10)) - 1 .
      686     do i = 1 to n :
      687       ipos = index( start-text, chr(10)).
      688       if ipos > 0 then
      689         substring( start-text, ipos , 1 ) = ' '.
      690     end.
      691       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
      692     return start-text.
      693   end.
