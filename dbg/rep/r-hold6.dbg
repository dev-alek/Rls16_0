      821       define buffer buf_trn-doc  for ub.trn-doc .
      822       define buffer buf_doc-line for ub.doc-line .
      823       find first buf_doc-line no-lock
      824         where buf_doc-line.doc-code  = p-doc-code
      825           and buf_doc-line.artic     = p-artic
      826           and buf_doc-line.prod-type = p-prod-type
      827           and buf_doc-line.prod-code = p-prod-code
      828         no-error .
      829       if not available buf_doc-line then do:
      830         message
      831           vss-workfile vss-revision vss-description skip
      832           vss-include-info9 skip
      833           "Ошибка задания входных параметров" skip
      834           "Не найдена строка документа" skip
      835           "Документ" p-doc-code skip
      836           "Артикул" p-artic p-prod-type p-prod-code skip
      837           view-as alert-box error .
      838         undo, return error .
      839       end.
      840       find first buf_trn-doc no-lock
      841         where buf_trn-doc.doc-code = buf_doc-line.doc-code
      842         no-error .
      843       if not available buf_trn-doc then do:
      844         message
      845           vss-workfile vss-revision vss-description skip
      846           vss-include-info9 skip
      847           "Не найден документ" skip
      848           "Документ" p-doc-code skip
      849           "Артикул" p-artic p-prod-type p-prod-code skip
      850           view-as alert-box error .
      851         undo, return error .
      852       end.
      853       for each buf_gds-dtl no-lock
