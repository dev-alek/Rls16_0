     2231   end procedure.
     2232   procedure macr_cell_merge :
     2233    define input parameter  p-row    as integer   no-undo .
     2234    define input parameter  p-col    as integer   no-undo .
     2235    define input parameter  p-row-2  as integer   no-undo .
     2236    define input parameter  p-col-2  as integer   no-undo .
     2237    do
     2238    on error undo, return error return-value
     2239    :
     2240     if p-row-2 = ?
     2241     then do:
