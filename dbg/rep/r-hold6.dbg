     2153   procedure macr_excel_sum :
     2154    do
     2155    on error undo, return error return-value
     2156    :
     2157    define input parameter  p-val as decimal   no-undo .
     2158    define input parameter  p-row as integer   no-undo .
     2159    define input parameter  p-col as integer   no-undo .
     2160    define input parameter  p-typ as integer   no-undo .
     2161    if p-val = ? then assign p-val = 0 .
