     2087     on error undo, return error return-value
     2088     :
     2089       find first buf_temp-param
     2090         where buf_temp-param.param-code     = p-code
     2091           and buf_temp-param.param-sub-code = p-sub-code
     2092         no-error .
     2093       if available buf_temp-param then do:
     2094         assign
     2095           p-value = buf_temp-param.param-value
     2096         .
     2097       end.
     2098       else do:
     2099         assign
     2100           p-value = p-default-value
