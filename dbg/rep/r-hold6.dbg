     2102       end.
     2103     end.
     2104   end procedure.
     2105   procedure paramls-append :
     2106     define input  parameter p-code     as character no-undo .
     2107     define input  parameter p-sub-code as character no-undo .
     2108     define input  parameter p-value    as character no-undo .
     2109     define buffer buf_temp-param for temp-param .
     2110     do
     2111     on error undo, return error return-value
     2112     :
     2113       find first buf_temp-param
     2114            where buf_temp-param.param-code     = p-code
     2115              and buf_temp-param.param-sub-code = p-sub-code
     2116         no-error .
     2117       if not available buf_temp-param then do:
     2118         create buf_temp-param .
     2119         assign
     2120           buf_temp-param.param-code     = p-code
     2121           buf_temp-param.param-sub-code = p-sub-code
