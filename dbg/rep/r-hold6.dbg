     2339     define variable   grp-sum-zak          as decimal initial 0 no-undo .
     2340     define variable   grp-sum-prod         as decimal initial 0 no-undo .
     2341     define variable  v-s-prod                as char                     no-undo.
     2342     define variable  v-goods-name          as char                     no-undo.
     2343     define variable  v-goods-unit          as char                     no-undo.
     2344     define variable  v-num                 as char                     no-undo.
     2345     define variable  v-date                as char                     no-undo.
     2346     define variable  v-cli                 as char                     no-undo.
     2347     define variable  v-value               as decimal                  no-undo.
     2348     define variable  v-prod                as decimal                  no-undo.
     2349     define variable  v-zak                 as decimal                  no-undo.
     2350     define variable  v-sum-zak             as decimal                  no-undo.
     2351     define variable  v-prib                as decimal                  no-undo.
     2352     define variable  v-sum-prod            as decimal                  no-undo.
     2353     define variable  v-rent                as decimal                  no-undo.
     2354     define variable v-row       as integer   no-undo .
     2355     define variable v-col       as integer   no-undo .
     2356     define variable v-ind       as integer   no-undo initial 1 .
     2357     define variable p-fact-qnty     as decimal   no-undo .
     2358     define variable t-dec           as decimal   no-undo .
     2359     assign
     2360       Counter1 = 0 .
     2361     .
     2362   define variable v-account as integer init 0 no-undo .
     2363   define variable v-account-lavel as character no-undo .
     2364   define variable v-button-stop as logical no-undo .
     2365   define variable v-kol-spice as integer no-undo .
     2366   define variable v-kol-spice2 as integer no-undo .
     2367   define variable v-kol-spice3 as integer no-undo .
     2368   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     2369   DEFINE BUTTON StopBtn AUTO-END-KEY
     2370        LABEL "Стоп"
     2371        SIZE 10 BY 1.
     2372   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     2373        LABEL "Обработано записей"
     2374         VIEW-AS TEXT
     2375        SIZE 14 BY .67 NO-UNDO.
     2376   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     2377         VIEW-AS TEXT
     2378        SIZE 53.25 BY .67
     2379        FGCOLOR 1  NO-UNDO.
     2380   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     2381         VIEW-AS TEXT
     2382        SIZE 53.25 BY .67
     2383        FGCOLOR 1  NO-UNDO.
     2384   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     2385         VIEW-AS TEXT
     2386        SIZE 53.25 BY .67
     2387        FGCOLOR 1  NO-UNDO.
     2388   DEFINE RECTANGLE RECT-1
     2389        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     2390        SIZE 55.13 BY 4.46.
     2391   DEFINE FRAME InfoFrame
     2392        StopBtn AT ROW 4.25 COL 21.75
     2393        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     2394        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     2395        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     2396        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     2397        RECT-1 AT ROW 1 COL 1
     2398       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     2399            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     2400            TITLE "Процесс"
     2401            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     2402   define variable mFrameView      as logical   no-undo init yes.
     2403     define variable mFramHandle as handle no-undo.
     2404     mFramHandle = frame InfoFrame:handle.
     2405     if  log-manager:logfile-name ne ?
     2406     then DO:
     2407         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     2408         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     2409         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     2410     end.
     2411     mFrameView = not session:batch-mode and mFramHandle:visible.
     2412     if mFrameView
     2413     then do:
     2414       ASSIGN
     2415          FRAME InfoFrame:HIDDEN                           = TRUE
     2416          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     2417     end.
     2418   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     2419   DO:
     2420     IF not StopProcessing THEN
     2421       Message "Вы действительно хотите прервать" SKIP
     2422               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     2423                 UPDATE StopProcessing.
     2424     IF StopProcessing THEN do:
     2425        if mFrameView
     2426        then do:
     2427           HIDE FRAME InfoFrame.
     2428        end.
     2429     End.
     2430   END.
     2431   assign v-account = ( if integer( 25 ) = 0 then 100 else integer( 25 ) ).
     2432     if  log-manager:logfile-name ne ?
     2433     then DO:
     2434         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     2435     end.
     2436     if not session:batch-mode then
     2437     do:
     2438       VIEW FRAME InfoFrame.
     2439       mFrameView = true.
     2440     end.
     2441      v-button-stop = false .
     2442         if mFrameView
     2443         then do:
     2444         if v-button-stop then view STOPBTN in frame InfoFrame.
     2445                          else Hide STOPBTN in frame InfoFrame.
     2446         end.
     2447     for each db no-lock,
     2448         each clients no-lock
     2449       where clients.db-num = db.db-num
     2450       :
     2451       for each buf_trn-doc no-lock
     2452         where buf_trn-doc.obj-type   = clients.obj-type
     2453           and buf_trn-doc.obj-code   = clients.obj-code
     2454           and buf_trn-doc.status_    = 'факт':U
     2455           and buf_trn-doc.fact-order >= v-fact-order-start
     2456           and buf_trn-doc.fact-order <  v-fact-order-end
     2457         :
     2458         if buf_trn-doc.hold-doc-code-child > "" or buf_trn-doc.hold-doc-code-parent > "" then next.
     2459         if (  buf_trn-doc.ext-doc-type <> 'es':U
     2460           and buf_trn-doc.ext-doc-type <> 'rs':U
     2461           and buf_trn-doc.ext-doc-type <> 'ee':U
     2462           and buf_trn-doc.ext-doc-type <> 're':U )  then next.
     2463         for each buf_doc-line no-lock
     2464           where buf_doc-line.doc-code = buf_trn-doc.doc-code
     2465           :
     2466           find first buf_goods no-lock
     2467             where buf_goods.artic     = buf_doc-line.artic
     2468               and buf_goods.prod-type = buf_doc-line.prod-type
     2469               and buf_goods.prod-code = buf_doc-line.prod-code
     2470           .
     2471           case x-SelectGood :
     2472             when 1 then do:
     2473             end.
     2474             when 3 then do:
     2475               find first  G#cli no-lock
     2476                 where G#cli.obj-type = buf_goods.prod-type
     2477                   and G#cli.obj-code = buf_goods.prod-code
     2478                 no-error .
     2479               if not available G#cli then next.
     2480             end .
     2481             when 2 then do:
     2482               define variable is-find     as logical   no-undo .
     2483               assign is-find = no .
     2484               for each tmp#grp :
     2485                 if buf_goods.grp-name begins tmp#grp.grp-name then do:  assign is-find = yes .   leave .   end.
     2486               end.
     2487               if not is-find then next.
     2488             end.
     2489             otherwise do:
     2490               find first gds-list no-lock
     2491               where gds-list.artic     = buf_goods.artic
     2492                 and gds-list.prod-type = buf_goods.prod-type
     2493                 and gds-list.prod-code = buf_goods.prod-code
     2494               no-error .
     2495               if not available gds-list then next.
     2496             end.
     2497           end case.
     2498           find first temp-hold6
     2499             where temp-hold6.gds-code = buf_goods.gds-code
     2500           no-error .
     2501           if not available temp-hold6 then do:
     2502             create temp-hold6 .
     2503             if g#gds-engl then assign temp-hold6.gds-name = buf_goods.engl-name.
     2504             else               assign temp-hold6.gds-name = buf_goods.gds-name.
     2505             assign
     2506               temp-hold6.artic     = buf_goods.artic
     2507               temp-hold6.prod-type = buf_goods.prod-type
     2508               temp-hold6.prod-code = buf_goods.prod-code
     2509               temp-hold6.grp-name = buf_goods.grp-name
     2510               temp-hold6.gds-unit = buf_goods.unit-base
     2511               temp-hold6.gds-code = buf_goods.gds-code
     2512               temp-hold6.qnty     = 0
     2513               temp-hold6.sum-zak  = 0
     2514               temp-hold6.sum-prod = 0
     2515             .
     2516           end.
     2517           create temp-doc .
     2518           assign
     2519             temp-doc.gds-code = buf_goods.gds-code
     2520             temp-doc.num      = buf_trn-doc.doc-code
     2521             temp-doc.dat      = buf_trn-doc.doc-date
     2522             temp-doc.cli      = buf_trn-doc.cli-name
     2523             temp-doc.qnty     = buf_doc-line.fact-qnty
     2524           .
     2525           if x-SET_val_TYPE = 1 then do:
     2526             run r-cost in this-procedure ( input buf_doc-line.doc-code, input buf_doc-line.artic, input buf_doc-line.prod-type, input buf_doc-line.prod-code,
     2527                  output p-fact-qnty, output t-dec, output t-dec,output t-dec, output temp-doc.zak, output t-dec, output t-dec, output t-dec
     2528                 ,output t-dec, output t-dec, output t-dec, output t-dec, output t-dec, output t-dec, output t-dec, output t-dec, output t-dec ) no-error .
     2529             run r-sale in this-procedure ( input buf_doc-line.doc-code, input buf_doc-line.artic, input buf_doc-line.prod-type, input buf_doc-line.prod-code,
     2530                  output p-fact-qnty, output t-dec, output t-dec,output t-dec, output temp-doc.prod, output t-dec, output t-dec, output t-dec
     2531                 ,output t-dec, output t-dec, output t-dec, output t-dec, output t-dec, output t-dec, output t-dec, output t-dec, output t-dec ) no-error .
     2532           end.
     2533           else do:
     2534             run r-cost in this-procedure ( input buf_doc-line.doc-code, input buf_doc-line.artic, input buf_doc-line.prod-type, input buf_doc-line.prod-code,
     2535                  output p-fact-qnty, output t-dec, output t-dec, output temp-doc.zak,output t-dec, output t-dec, output t-dec, output t-dec
     2536                 ,output t-dec, output t-dec, output t-dec, output t-dec, output t-dec, output t-dec, output t-dec, output t-dec, output t-dec ) no-error .
     2537             run r-sale in this-procedure ( input buf_doc-line.doc-code, input buf_doc-line.artic, input buf_doc-line.prod-type, input buf_doc-line.prod-code,
     2538                  output p-fact-qnty, output t-dec, output t-dec, output temp-doc.prod, output t-dec, output t-dec, output t-dec, output t-dec
     2539                 ,output t-dec, output t-dec, output t-dec, output t-dec, output t-dec, output t-dec, output t-dec, output t-dec, output t-dec ) no-error .
     2540           end.
     2541           if (buf_trn-doc.ext-doc-type = 'rs':U or buf_trn-doc.ext-doc-type <> 're':U)  then
     2542             assign
     2543               temp-doc.zak  = - temp-doc.zak
     2544               temp-doc.prod = - temp-doc.prod
     2545             .
     2546           assign
     2547             temp-hold6.qnty     = temp-hold6.qnty     + temp-doc.qnty
     2548             temp-hold6.sum-zak  = temp-hold6.sum-zak  + temp-doc.qnty * temp-doc.zak
     2549             temp-hold6.sum-prod = temp-hold6.sum-prod + temp-doc.qnty * temp-doc.prod
     2550             all-sum-prod        = all-sum-prod + temp-hold6.sum-prod
     2551             all-sum-zak         = all-sum-zak  + temp-hold6.sum-zak
     2552           .
     2553         end.
     2554       end.
     2555     end.
     2556   if mFrameView
     2557   then do:
     2558      HIDE FRAME InfoFrame.
     2559   end.
     2560     assign
     2561       make-excel = yes
     2562       v-file-name = string(session :temp-directory) + "rpt" + string( g#report-num ) + ".txt"
     2563     .
     2564     output stream macr_excel to value(v-file-name) .
     2565     assign v-ind = v-ind + 1 .
     2566   if session :set-wait-state( "compiler" ) then.
     2567     Line = fill("-", 250).
     2568     DEFINE frame f-doc
     2569           sym19  temp-hold6.artic  column-label " Артикул! " format "X(12)"         space(0)
     2570           sym20  v-s-prod        column-label " Произ-! водитель" format "X(12)"         space(0)
     2571           sym1  v-goods-name column-label " Наименование товара! " format "X(40)"          space(0)
     2572           sym2  v-num        column-label " № накл.! "             format "X(14)"          space(0)
     2573           sym3  v-date       column-label " дата! "                format "X(10)"     space(0)
     2574           sym4  v-cli        column-label " Покупатель! "          format "X(40)"          space(0)
     2575           sym5  v-value      column-label " Кол-во!реал-ции"       format "->,>>>,>>9.999" space(0)
     2576           sym6  v-prod       column-label "Цена!продажи"           format "->>,>>>,>>9.99" space(0)
     2577           sym7  v-zak        column-label "Цена ТД!(закупки)"      format "->>,>>>,>>9.99" space(0)
     2578           sym8  v-sum-zak    column-label "Сумма в ценах!ТД (закупки)"  format "->>,>>>,>>9.99" space(0)
     2579           sym9  v-prib       column-label "Сумма !наценки"         format "->>,>>>,>>9.99" space(0)
     2580           sym10 v-sum-prod   column-label "ИТОГО!товарооборот"     format "->>,>>>,>>9.99" space(0)
     2581           sym11 v-rent       column-label "%  !рентаб."            format "->>>9.99"       space(0)
     2582           sym12
     2583     HEADER
     2584           string( "Дата печати : " + string(TODAY , "99.99.9999") + " , " + string(TIME, "HH:MM") ) AT 5 format "X(100)"
     2585           string( "Страница " + string( PAGE-NUMBER( OutStream )  , ">>9") ) AT 150 format "X(15)" SKIP
     2586           Line format "X(247)" AT 1
     2587     with width 250  down stream-io.
     2588     DEFINE frame f-doc1
     2589           sym1  v-goods-name column-label " Ассортимент! "         format "X(40)"          space(0)
     2590           sym2  v-value      column-label "Итого !кол-во"          format "->,>>>,>>9.999" space(0)
     2591           sym3  v-sum-zak    column-label "Сумма в! ценах ТД"      format "->>,>>>,>>9.99" space(0)
     2592           sym4  v-prib       column-label "Сумма !наценки"         format "->>,>>>,>>9.99" space(0)
     2593           sym5  v-sum-prod   column-label "ИТОГО!товарооборот"     format "->>,>>>,>>9.99" space(0)
     2594           sym6  v-rent       column-label "%  !рентаб."            format "->>>9.99"       space(0)
     2595           sym7
     2596     HEADER
     2597           Line format "X(117)" AT 1
     2598     with width 235 down stream-io.
     2599   output stream OutStream to value( string( session:temp-directory +
     2600                                        "rpt" + string( g#report-num ) ) )
     2601                                        page-size  value(43) .
     2602     FORM with FRAME f-doc .
     2603     PUT stream OutStream  SPACE(30) String("Отчет по реализации с " + string(x-date-start,"99.99.9999") + " по " + string(x-date-end,"99.99.9999"))   format "X(130)"  SKIP .
     2604     run PutColumnTitulExcel in this-procedure .
     2605     for each temp-hold6 no-lock
     2606        by temp-hold6.grp-name
     2607        by temp-hold6.gds-code
     2608       :
     2609       if  ( v-row ) >= 63000 then do:
     2610         Output stream Macr_Excel  close .
     2611         run paramls-write in this-procedure (input "file",input string(v-ind),input v-file-name ) .
     2612         run gbl/_tmpfile.p ("wb", ".txt", output v-file-name) .
     2613         output stream  Macr_Excel to value(v-file-name) .
     2614         v-ind = v-ind + 1 .
     2615         run PutColumnTitulExcel in this-procedure .
     2616       end.
     2617       run PrintLine in this-procedure .
     2618     end.
     2619     run PrintItog in this-procedure .
     2620     PUT STREAM OutStream Line format "X(247)" skip.
     2621     PUT stream OutStream skip "Итоги по ассортиментам" format "X(130)"  SKIP .
     2622     run PutColumnTitulExcel1 in this-procedure .
     2623     for each temp-hold6 no-lock
     2624        break by temp-hold6.grp-name
     2625        by temp-hold6.gds-code
     2626       :
     2627       if  ( v-row ) >= 63000 then do:
     2628         Output stream Macr_Excel  close .
     2629         run paramls-write in this-procedure (input "file",input string(v-ind),input v-file-name ) .
     2630         run gbl/_tmpfile.p ("wb", ".txt", output v-file-name) .
     2631         output stream  Macr_Excel to value(v-file-name) .
     2632         v-ind = v-ind + 1 .
     2633         run PutColumnTitulExcel1 in this-procedure .
     2634       end.
     2635       if first-of(temp-hold6.grp-name ) then do:
     2636         run macr_excel_char("Группа: " + temp-hold6.grp-name, v-row, 1) .
     2637         assign
     2638           v-row = v-row + 1
     2639           v-goods-name = "Группа: " + temp-hold6.grp-name
     2640           grp-qnty     = 0
     2641           grp-sum-zak  = 0
     2642           grp-sum-prod = 0
     2643         .
     2644         display stream outstream sym1 v-goods-name sym2 sym3 sym4 sym5 sym6 sym7  with frame f-doc1.
     2645         down stream outstream with frame f-doc1 .
     2646       end.
     2647       run PrintLine1 in this-procedure .
     2648       if last-of(temp-hold6.grp-name ) then run PrintItog1 in this-procedure .
     2649     end.
     2650     run PrintItog2 in this-procedure .
     2651     PUT STREAM OutStream Line format "X(117)" skip.
     2652     HIDE stream OutStream FRAME BottomFrame .
     2653     OUTPUT stream OutStream CLOSE.
     2654     output stream macr_excel close .
     2655     run paramls-write in this-procedure (input "file",input string(v-ind),input v-file-name) .
     2656     run end-proc .
     2657   if session :set-wait-state( "" ) then.
     2658     define variable v-user-action as character no-undo .
     2659     define variable v-printed as logical   no-undo .
     2660     run gbl/prnfilen.w
     2661       (input  ""
     2662       ,input  1
     2663       ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
     2664       ,input  7
     2665       ,output v-user-action
     2666       ,output v-printed
     2667       ) .
     2668   end.
     2669   procedure PutColumnTitulExcel :
     2670     do
     2671     on error undo, return error return-value
     2672     :
     2673     assign
     2674       v-row = 2
     2675       v-col = 1
     2676     .
     2677     run macr_excel_char (String("Отчет по реализации с " + string(x-date-start,"99.99.9999") + " по " + string(x-date-end,"99.99.9999")), 1, 1) .
     2678     run macr_cell_format ( 11, yes, no, ?, 1, 1, 1, 1) .
     2679     run macr_excel_char("Артикул", v-row, v-col) .             assign v-col = v-col + 1 .
     2680     run macr_excel_char("Производитель", v-row, v-col) .             assign v-col = v-col + 1 .
     2681     run macr_excel_char("Наименование товара", v-row, v-col) .
     2682     run macr_cell_size (40,?, v-row, v-col,?,?).                       assign v-col = v-col + 1 .
     2683     run macr_excel_char("№ накл.", v-row, v-col) .
     2684     run macr_cell_size (14,?, v-row, v-col,?,?).                       assign v-col = v-col + 1 .
     2685     run macr_excel_char("дата", v-row, v-col) .
     2686     run macr_cell_size (10,?, v-row, v-col,?,?).                       assign v-col = v-col + 1 .
     2687     run macr_excel_char("Покупатель", v-row, v-col) .
     2688     run macr_cell_size (40,?, v-row, v-col,?,?).                       assign v-col = v-col + 1 .
     2689     run macr_excel_char("Кол-во реал-ции", v-row, v-col) .             assign v-col = v-col + 1 .
     2690     run macr_excel_char("Цена продажи", v-row, v-col) .                assign v-col = v-col + 1 .
     2691     run macr_excel_char("Цена ТД (закупки)", v-row, v-col) .           assign v-col = v-col + 1 .
     2692     run macr_excel_char("Сумма в ценах ТД (закупки)", v-row, v-col) .  assign v-col = v-col + 1 .
     2693     run macr_excel_char("Сумма наценки", v-row, v-col) .               assign v-col = v-col + 1 .
     2694     run macr_excel_char("ИТОГО товарооборот", v-row, v-col) .          assign v-col = v-col + 1 .
     2695     run macr_excel_char("% рентабельности", v-row, v-col) .            assign v-col = v-col + 1 .
     2696     run macr_cell_bordur ( v-row, 1, v-row, 11) .
     2697     run macr_cell_format ( 10, yes, no, 35, v-row, 1, v-row, 11) .
     2698     run macr_cell_size (14,?, v-row, 5, v-row, 12) .
     2699     assign v-row = v-row + 1 .
     2700     end.
     2701   end procedure.
     2702   procedure PutColumnTitulExcel1 :
     2703     do
     2704     on error undo, return error return-value
     2705     :
     2706     assign v-col = 1 .
     2707     run macr_excel_char ("Итоги по ассортиментам", v-row, v-col) .
     2708     run macr_cell_format ( 11, yes, no, ?, v-row, v-col, v-row, v-col) .   assign v-col = v-col + 1 .
     2709     run macr_excel_char("Ассортимент", v-row, v-col) .
     2710     run macr_excel_char("Итого кол-во", v-row, v-col) .                assign v-col = v-col + 1 .
     2711     run macr_excel_char("Сумма в ценах ТД", v-row, v-col) .            assign v-col = v-col + 1 .
     2712     run macr_excel_char("Сумма наценки", v-row, v-col) .               assign v-col = v-col + 1 .
     2713     run macr_excel_char("ИТОГО товарооборот", v-row, v-col) .          assign v-col = v-col + 1 .
     2714     run macr_excel_char("% рентабельности", v-row, v-col) .
     2715     run macr_cell_bordur ( v-row, 1, v-row, v-col) .
     2716     run macr_cell_format ( 10, yes, no, 35, v-row, 1, v-row, v-col) .
     2717     assign v-row = v-row + 1 .
     2718     end.
     2719   end procedure.
     2720   procedure PrintLine :
     2721     do
     2722     on error undo, return error return-value
     2723     :
     2724       define variable stat as logical initial no no-undo .
     2725       for each temp-doc
     2726         where temp-doc.gds-code = temp-hold6.gds-code
     2727         :
     2728         if stat = no then do:
     2729           assign
     2730             stat         = yes
     2731             v-s-prod       = temp-hold6.prod-type + " " + string(temp-hold6.prod-code)
     2732             v-goods-name = temp-hold6.gds-name
     2733             v-num        = temp-doc.num
     2734             v-date       = String(temp-doc.dat,"99.99.9999")
     2735             v-cli        = temp-doc.cli
     2736             v-value      = temp-doc.qnty
     2737             v-prod       = temp-doc.zak
     2738             v-zak        = temp-doc.prod
     2739             v-sum-zak    = temp-doc.zak * temp-doc.qnty
     2740             v-prib       = (temp-doc.prod - temp-doc.zak) * temp-doc.qnty
     2741             v-sum-prod   = temp-doc.prod * temp-doc.qnty
     2742             v-rent       = v-prib * 100 / v-sum-zak
     2743           .
     2744           run macr_excel_char(temp-hold6.artic, v-row, 1) .
     2745           run macr_excel_char(v-s-prod, v-row, 2) .
     2746         end.
     2747         else do:
     2748           assign
     2749             v-goods-name = ""
     2750             v-s-prod       = ""
     2751             v-num        = temp-doc.num
     2752             v-date       = String(temp-doc.dat,"99.99.9999")
     2753             v-cli        = temp-doc.cli
     2754             v-value      = temp-doc.qnty
     2755             v-prod       = temp-doc.zak
     2756             v-zak        = temp-doc.prod
     2757             v-sum-zak    = temp-doc.zak * temp-doc.qnty
     2758             v-prib       = (temp-doc.prod - temp-doc.zak) * temp-doc.qnty
     2759             v-sum-prod   = temp-doc.prod * temp-doc.qnty
     2760             v-rent       = v-prib * 100 / v-sum-zak
     2761           .
     2762         end.
     2763         if v-rent = ? then assign v-rent = 0 .
     2764         display stream outstream sym1 temp-hold6.artic v-s-prod  v-goods-name sym2 v-num sym3 v-date sym4 v-cli sym5 v-value sym6 v-prod sym7 v-zak
     2765                                  sym8 v-sum-zak sym9 v-prib sym10 v-sum-prod sym11 v-rent sym12  sym19  sym20  with frame f-doc.
     2766         down stream outstream with frame f-doc .
     2767         run macr_excel_char(v-goods-name , v-row, 3) .
     2768         run macr_excel_char(v-num        , v-row, 4) .
     2769         run macr_excel_char(v-date       , v-row, 5) .
     2770         run macr_excel_char(v-cli        , v-row, 6) .
     2771         run macr_excel_sum (v-value      , v-row, 7,  3) .
     2772         run macr_excel_sum (v-prod       , v-row, 8,  2) .
     2773         run macr_excel_sum (v-zak        , v-row, 9,  2) .
     2774         run macr_excel_sum (v-sum-zak    , v-row, 10,  2) .
     2775         run macr_excel_sum (v-prib       , v-row, 11,  2) .
     2776         run macr_excel_sum (v-sum-prod   , v-row, 12, 2) .
     2777         run macr_excel_sum (v-rent       , v-row, 13, 2) .
     2778         assign v-row = v-row + 1 .
     2779       end.
     2780       assign
     2781         v-goods-name = "Итого по товару"
     2782         v-value      = temp-hold6.qnty
     2783         v-sum-zak    = temp-hold6.sum-zak
     2784         v-prib       = temp-hold6.sum-prod - temp-hold6.sum-zak
     2785         v-sum-prod   = temp-hold6.sum-prod
     2786         v-rent       = (temp-hold6.sum-prod - temp-hold6.sum-zak) * 100 / temp-hold6.sum-zak
     2787       .
     2788       if v-rent = ? then assign v-rent = 0 .
     2789       display stream outstream sym1 v-goods-name sym2 sym3 sym4 sym5 v-value sym6 sym7 sym8 v-sum-zak sym9 v-prib sym10 v-sum-prod sym11 v-rent sym12  sym19  sym20  with frame f-doc.
     2790       down stream outstream with frame f-doc .
     2791       run macr_excel_char(v-goods-name , v-row, 3) .
     2792       run macr_excel_sum (v-value      , v-row, 7,  3) .
     2793       run macr_excel_sum (v-sum-zak    , v-row, 10,  2) .
     2794       run macr_excel_sum (v-prib       , v-row, 11,  2) .
     2795       run macr_excel_sum (v-sum-prod   , v-row, 12, 2) .
     2796       run macr_excel_sum (v-rent       , v-row, 13, 2) .
     2797       assign v-row = v-row + 1 .
     2798     end.
     2799   end procedure.
     2800   procedure PrintLine1 :
     2801     do
     2802     on error undo, return error return-value
     2803     :
     2804       assign
     2805         v-goods-name = "  " + temp-hold6.gds-name
     2806         v-value      = temp-hold6.qnty
     2807         v-sum-zak    = temp-hold6.sum-zak
     2808         v-prib       = temp-hold6.sum-prod - temp-hold6.sum-zak
     2809         v-sum-prod   = temp-hold6.sum-prod
     2810         v-rent       = (temp-hold6.sum-prod - temp-hold6.sum-zak) * 100 / temp-hold6.sum-zak
     2811         grp-qnty     = grp-qnty     + temp-hold6.qnty
     2812         grp-sum-zak  = grp-sum-zak  + temp-hold6.sum-zak
     2813         grp-sum-prod = grp-sum-prod + temp-hold6.sum-prod
     2814       .
     2815       if v-rent = ? then assign v-rent = 0 .
     2816       display stream outstream sym1 v-goods-name sym2 v-value sym3 v-sum-zak sym4 v-prib sym5 v-sum-prod sym6 v-rent sym7 with frame f-doc1.
     2817       down stream outstream with frame f-doc1 .
     2818       run macr_excel_char(v-goods-name , v-row, 1) .
     2819       run macr_excel_sum (v-value      , v-row, 2, 3) .
     2820       run macr_excel_sum (v-sum-zak    , v-row, 3, 2) .
     2821       run macr_excel_sum (v-prib       , v-row, 4, 2) .
     2822       run macr_excel_sum (v-sum-prod   , v-row, 5, 2) .
     2823       run macr_excel_sum (v-rent       , v-row, 6, 2) .
     2824       assign v-row = v-row + 1 .
     2825     end.
     2826   end procedure.
     2827   procedure PrintItog :
     2828     do
     2829     on error undo, return error return-value
     2830     :
     2831       assign
     2832         v-goods-name = "ИТОГО: "
     2833         v-sum-zak    = all-sum-zak
     2834         v-prib       = all-sum-prod - all-sum-zak
     2835         v-sum-prod   = all-sum-prod
     2836         v-rent       = (all-sum-prod - all-sum-zak) * 100 / all-sum-zak
     2837       .
     2838       if v-rent = ? then assign v-rent = 0 .
     2839       display stream outstream sym1 v-goods-name sym2 sym3 sym4 sym5 sym6 sym7 sym8 v-sum-zak sym9 v-prib sym10 v-sum-prod sym11 v-rent sym12  sym19  sym20  with frame f-doc.
     2840       down stream outstream with frame f-doc .
     2841       run macr_excel_char(v-goods-name , v-row, 3) .
     2842       run macr_excel_sum (v-sum-zak    , v-row, 10,  2) .
     2843       run macr_excel_sum (v-prib       , v-row, 11,  2) .
     2844       run macr_excel_sum (v-sum-prod   , v-row, 12, 2) .
     2845       run macr_excel_sum (v-rent       , v-row, 13, 2) .
     2846       assign v-row = v-row + 1 .
     2847     end.
     2848   end procedure.
     2849   procedure PrintItog1 :
