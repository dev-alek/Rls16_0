     2852     :
     2853       assign
     2854         v-goods-name = "Итого по " + temp-hold6.grp-name
     2855         v-value      = grp-qnty
     2856         v-sum-zak    = grp-sum-zak
     2857         v-prib       = grp-sum-prod - grp-sum-zak
     2858         v-sum-prod   = grp-sum-prod
     2859         v-rent       = (grp-sum-prod - grp-sum-zak) * 100 / grp-sum-zak
     2860       .
     2861       if v-rent = ? then assign v-rent = 0 .
     2862       display stream outstream sym1 v-goods-name sym2 v-value sym3 v-sum-zak sym4 v-prib sym5 v-sum-prod sym6 v-rent sym7 with frame f-doc1.
     2863       down stream outstream with frame f-doc1 .
     2864       run macr_excel_char(v-goods-name , v-row, 1) .
     2865       run macr_excel_sum (v-value      , v-row, 2,  2) .
     2866       run macr_excel_sum (v-sum-zak    , v-row, 3,  2) .
     2867       run macr_excel_sum (v-prib       , v-row, 4,  2) .
     2868       run macr_excel_sum (v-sum-prod   , v-row, 5, 2) .
     2869       run macr_excel_sum (v-rent       , v-row, 6, 2) .
     2870       assign v-row = v-row + 1 .
     2871     end.
     2872   end procedure.
     2873   procedure PrintItog2 :
