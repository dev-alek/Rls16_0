     2184   procedure macr_cell_format :
     2185    do
     2186    on error undo, return error return-value
     2187    :
     2188    define input parameter  p-size   as integer   no-undo .
     2189    define input parameter  p-bold   as logical   no-undo .
     2190    define input parameter  p-italic as logical   no-undo .
     2191    define input parameter  p-color  as integer   no-undo .
     2192    define input parameter  p-row    as integer   no-undo .
     2193    define input parameter  p-col    as integer   no-undo .
     2194    define input parameter  p-row-2  as integer   no-undo .
     2195    define input parameter  p-col-2  as integer   no-undo .
     2196     if p-size = ? then p-size = 10 .
     2197     if p-bold = ? then p-bold = false .
     2198     if p-italic = ? then p-italic = false .
     2199     if p-row-2 = ? then p-row-2 = p-row .
     2200     if p-col-2 = ? then p-col-2 = p-col .
     2201     put  stream macr_excel unformatted
     2202      substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 ) skip .
     2203     if p-color <> ? then do:
     2204        put  stream macr_excel unformatted
     2205          substitute('patterns(1,,&1,true)', p-color )  skip  .
     2206     end.
     2207     put  stream macr_excel unformatted
     2208          substitute('format.font(,&1,&2,&3)' , p-size,
     2209                                           string ( p-bold  , "true/false" ) ,
     2210                                           string ( p-italic , "true/false" )
     2211                                           ) skip .
     2212    end.
     2213   end procedure.
     2214   procedure macr_cell_bordur :
