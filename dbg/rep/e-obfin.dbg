      898   PROCEDURE adm-update-record :
      899       MESSAGE
      900         "Object ":U THIS-PROCEDURE:FILE-NAME
      901           "must have at least one Enabled Table to perform Update.":U
      902             VIEW-AS ALERT-BOX ERROR.
      903      RETURN.
      904   END PROCEDURE.
      905   PROCEDURE check-modified :
      906   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
      907   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
      908   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
      909   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
      910     IF check-state = "check":U THEN
      911     DO:
      912       RUN get-link-handle IN adm-broker-hdl
      913         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
      914            OUTPUT group-target-list).
      915       IF group-target-list NE "":U THEN
      916       DO i = 1 TO NUM-ENTRIES(group-target-list):
      917         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
      918         RUN check-modified IN curr-widget ('group-check':U).
      919         IF RETURN-VALUE NE "":U THEN
      920         DO:
      921           RUN check-modified-message(RETURN-VALUE).
      922           RETURN "":U.
      923         END.
      924       END.
      925     END.
      926     RETURN "":U.
      927   END PROCEDURE.
      928   PROCEDURE check-modified-message :
      929     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
      930        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
      931           'CONTAINER-SOURCE':U, 'HIDDEN':U).
      932        IF RETURN-VALUE = "YES":U THEN
      933           RUN notify ('view,CONTAINER-SOURCE':U).
      934        MESSAGE IF p-changed-table NE ? THEN
      935           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
      936           ELSE "Current values have been changed."
      937           SKIP "  Do you wish to save those changes?"
      938           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
      939        IF ANS THEN
      940        DO:
      941           IF group-assign-target THEN
      942             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
      943           ELSE RUN dispatch('update-record':U).
      944           IF RETURN-VALUE = "ADM-ERROR":U THEN
      945           DO:
      946               MESSAGE "Changes to the previous record were not saved."
      947                 VIEW-AS ALERT-BOX ERROR.
      948               IF group-assign-target THEN
      949                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      950               ELSE RUN dispatch ('cancel-record':U).
      951           END.
      952        END.
      953        ELSE DO:
      954          IF group-assign-target THEN
      955             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      956          ELSE RUN dispatch('cancel-record':U).
      957        END.
      958        RETURN.
      959   END PROCEDURE.
      960   PROCEDURE get-rowid :
      961       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
      962       ASSIGN
      963       p-table   =   adm-first-table.
      964       RETURN.
      965   END PROCEDURE.
      966   PROCEDURE init-group-assign :
      967       RUN request-attribute IN adm-broker-hdl
      968         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
      969       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
      970         group-assign-target = yes.
      971       ELSE group-assign-target = no.
      972       RETURN.
      973   END PROCEDURE.
      974   PROCEDURE set-editors :
      975       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
      976       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
      977       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
      978       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
      979       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
      980       DO WHILE VALID-HANDLE (curr-widget):
      981           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
      982              curr-widget:HIDDEN = no THEN DO:
      983             CASE p-field-setting:
      984               WHEN "INITIALIZE":U THEN
      985               DO:
      986                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
      987                     read-only-list +
      988                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
      989                        STRING(curr-widget).
      990               END.
      991               WHEN "DISABLE":U OR
      992               WHEN "ENABLE":U THEN
      993               DO:
      994                   curr-widget:SENSITIVE = yes.
      995                   RUN get-attribute ('Read-Only-Editors':U).
      996                   IF RETURN-VALUE = ? OR
      997                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
      998                       curr-widget:READ-ONLY =
      999                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1000               END.
     1001               WHEN "CLEAR":U THEN
     1002                   curr-widget:SCREEN-VALUE = "":U.
     1003             END CASE.
     1004           END.
     1005           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1006       END.
     1007       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1008         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1009           + '"':U).
     1010       RETURN.
     1011   END PROCEDURE.
     1012   PROCEDURE use-check-modified-all :
     1013    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1014     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1015     RETURN.
     1016   END PROCEDURE.
     1017   PROCEDURE use-create-on-add :
     1018   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1019      RETURN.
     1020   END PROCEDURE.
     1021   PROCEDURE use-initial-lock :
     1022     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1023     ASSIGN adm-initial-lock = p-attr-value.
     1024     RETURN.
     1025   END PROCEDURE.
     1026     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1027   ASSIGN
     1028          FRAME F-Main:SCROLLABLE       = FALSE
     1029          FRAME F-Main:HIDDEN           = TRUE.
     1030   if not this-procedure :persistent
     1031   then do:
     1032     message
     1033       vss-workfile vss-revision vss-description skip
     1034       "Ошибка при запуске процедуры" skip
     1035       "Данную процедуру следует запускать только с параметром persistent" skip
     1036       view-as alert-box error .
     1037     undo, return error .
     1038   end.
     1039   PROCEDURE disable_UI :
     1040     HIDE FRAME F-Main.
     1041     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1042   END PROCEDURE.
     1043   PROCEDURE local-apply-layout :
     1044     RUN dispatch IN THIS-PROCEDURE ( INPUT 'apply-layout':U ) .
     1045   END PROCEDURE.
     1046   PROCEDURE my-report :
     1047   run rep/r-obfin.p (input p-radio-schet, input p-curr-code, input RADIO-SET-1, input b-nal, input b-nal-2) .
     1048   END PROCEDURE.
     1049   PROCEDURE my-var :
     1050     Assign frame F-Main RADIO-SET-1 b-nal b-nal-2 .
     1051   define variable v-radio-customer as integer no-undo .
     1052   define variable v-radio-schet    as integer no-undo .
     1053   define variable v-curr-code      as integer no-undo .
     1054   define variable v-radio-period   as character no-undo .
     1055   define variable v-keep-spis      as character no-undo .
     1056   run get-var-from-1-report-page (
     1057       output v-radio-customer ,
     1058       output v-radio-schet,
     1059       output v-curr-code,
     1060       output v-radio-period ,
     1061       output v-keep-spis ) .
     1062     assign
     1063       p-radio-schet = v-radio-schet
     1064       p-curr-code   = v-curr-code
     1065     .
     1066     find first clients no-lock where clients.obj-type = 'орг':U and clients.obj-code = v-cntxt-host-code-obj .
     1067     assign
     1068       ReportNAme = "Оборот финансов с разбивкой по основаниям c " + string(x-Date-Start,"99/99/9999") + "г. по " + string(x-Date-End,"99/99/9999") + "г." .
     1069       str1 = "Фирма: " + clients.obj-name .
     1070     .
     1071   END PROCEDURE.
     1072   procedure get-var-from-1-report-page :
     1073    do
     1074    on error undo, return error return-value
     1075    :
     1076   define output parameter p-customer as integer no-undo .
     1077   define output parameter p-schet    as integer no-undo .
     1078   define output parameter p-curr-code as integer no-undo .
     1079   define output parameter p-period    as character no-undo .
     1080   define output parameter p-keep-spis  as character no-undo .
     1081   define variable v-res as character no-undo .
     1082     RUN get-attribute IN THIS-PROCEDURE ('UIB-MODE').
     1083     IF RETURN-VALUE NE "DESIGN" THEN DO:
     1084       RUN get-link-handle IN adm-broker-hdl ( THIS-PROCEDURE, 'State':U , OUTPUT source-str ).
     1085       State-source = WIDGET-HANDLE ( source-str ).
     1086       IF not VALID-HANDLE ( State-source ) THEN
     1087         Message "Не определен линк " 'State':U view-as alert-box error.
     1088     END.
     1089    run get-attribute in state-source  ( 'KEEP-SPIS':U ).
     1090     v-res = return-value .
     1091     if v-res = ? or v-res = "" then p-keep-spis = ? .
     1092                                else p-keep-spis = return-value .
     1093    run get-attribute in state-source  ( 'RADIO-PERIOD':U ).
     1094     v-res = return-value .
     1095     if v-res = ? or v-res = "" then p-period = ? .
     1096                                else p-period = return-value .
     1097    run get-attribute in state-source  ( 'RADIO-CUSTOMER':U ).
     1098     v-res = return-value .
     1099     if v-res = ? or v-res = "" then p-customer = ? .
     1100                                else p-customer = integer (return-value) .
     1101    run get-attribute in state-source  ( 'RADIO-SCHET':U ).
     1102     v-res = return-value .
     1103     if v-res = ? or v-res = "" then p-schet = ? .
     1104                                else p-schet = integer (return-value) .
     1105    run get-attribute in state-source  ( 'EX-CURR-CODE':U ).
     1106     v-res = return-value .
     1107     if v-res = ? or v-res = "" then p-curr-code = ? .
     1108                                else p-curr-code = integer (return-value) .
     1109    end.
     1110   end procedure.
     1111   PROCEDURE state-changed :
     1112     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     1113     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     1114     CASE p-state:
     1115       when "link-changed":U then  DO:
     1116            Run my-var.
     1117            End.
     1118     END CASE.
     1119   END PROCEDURE.
