      573   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      574   procedure factord :
      575     define input  parameter p-fact-date            as date    no-undo .
      576     define input  parameter p-fact-time            as integer no-undo .
      577     define input  parameter p-fact-num             as integer no-undo .
      578     define input  parameter p-shift-date           as date    no-undo .
      579     define input  parameter p-shift-num            as integer no-undo .
      580     define input  parameter p-shift-on             as logical no-undo .
      581     define output parameter p-fact-order           as decimal no-undo .
      582     define output parameter p-shift-end-fact-order as decimal no-undo .
      583     define output parameter p-day-end-fact-order   as decimal no-undo .
      584     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      585     if p-fact-date = ?
      586     then do:
      587       return error "Не указана фактическая дата" .
      588     end.
      589     define variable v-fact-date-num as integer no-undo .
      590     assign
      591       v-fact-date-num = integer(p-fact-date)
      592     .
      593     if p-fact-num = ?
      594     or p-fact-num = 0
      595     then do:
      596       return error "Не задан p-fact-num " + string(p-fact-num) .
      597     end.
      598     if p-fact-num < 0
      599     then do:
      600       return error "Отрицательный fact-num " + string(p-fact-num) .
      601     end.
      602     if p-fact-num >= 100000000
      603     then do:
      604       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      605     end.
      606     if p-shift-on = true
      607     then do:
      608       if p-shift-date = ?
      609       then do:
      610         return error "Не задана дата смены" .
      611       end.
      612       if p-shift-num = ?
      613       or p-shift-num = 0
      614       then do:
      615         return error "Не задан номер смены" .
      616       end.
      617     end.
      618     else do:
      619       assign
      620         p-shift-date = p-fact-date
      621         p-shift-num  = 24
      622       .
      623     end.
      624     define variable v-shift-offset as integer no-undo .
      625     if p-shift-date = p-fact-date
      626     then do:
      627       assign
      628         v-shift-offset = 1
      629       .
      630     end.
      631     if p-shift-date < p-fact-date
      632     then do:
      633       assign
      634         v-shift-offset = 0
      635       .
      636     end.
      637     if p-shift-date > p-fact-date
      638     then do:
      639       message
      640         vss-workfile vss-revision vss-description skip
      641         "Неправильная дата закрытия смены" skip
      642         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      643         view-as alert-box error .
      644       undo, return error
      645         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      646           ,string(p-fact-date, '99/99/9999':U)
      647           ,string(p-shift-date, '99/99/9999':U)
      648           )
      649       .
      650     end.
      651     if p-shift-num < 1
      652     or p-shift-num > 24
      653     then do:
      654       message
      655         vss-workfile vss-revision vss-description skip
      656         "Неправильный номер смены" skip
      657         "p-shift-num" p-shift-num skip
      658         view-as alert-box error .
      659       undo, return error return-value .
      660     end.
      661     assign
      662       p-fact-order           = v-fact-date-num
      663                              + v-shift-offset * 0.5
      664                              + p-shift-num    * 0.02 - 0.01
      665                              + p-fact-num     * 0.0000000001
      666       p-shift-end-fact-order = v-fact-date-num
      667                              + v-shift-offset * 0.5
      668                              + p-shift-num    * 0.02
      669       p-day-end-fact-order   = v-fact-date-num
      670                              + 0.99
      671     .
      672     if p-fact-order           <= v-fact-date-num
      673     or p-shift-end-fact-order <= v-fact-date-num
      674     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      675     or p-shift-end-fact-order >= p-day-end-fact-order
      676     then do:
      677       message
      678         vss-workfile vss-revision vss-description skip
      679         "Внутренняя ошибка при генерации фактического номера" skip
      680         "p-fact-date"            p-fact-date            skip
      681         "p-fact-time"            p-fact-time            skip
      682         "p-fact-num"             p-fact-num             skip
      683         "p-shift-date"           p-shift-date           skip
      684         "p-shift-num"            p-shift-num            skip
      685         "p-shift-on"             p-shift-on             skip
      686         "p-shift-end-fact-order" p-shift-end-fact-order skip
      687         "p-day-end-fact-order"   p-day-end-fact-order   skip
      688         "v-fact-date-num"        v-fact-date-num        skip
      689         view-as alert-box error .
      690       undo, return error return-value .
      691     end.
      692   end procedure.
      693   procedure day-begin-fact-order :
      694     define input  parameter p-fact-date            as date    no-undo .
      695     define output parameter p-day-begin-fact-order as decimal no-undo .
      696     do
      697     on error undo, return error return-value
      698     :
      699       if p-fact-date = ?
      700       then do:
      701         assign
      702           p-day-begin-fact-order = 0
      703         .
      704       end.
      705       else do:
      706         assign
      707           p-day-begin-fact-order = integer(p-fact-date)
      708         .
      709       end.
      710     end.
      711   end procedure.
      712   procedure factord-max-fact-order :
      713     define output parameter p-max-fact-order as decimal   no-undo .
      714     do
      715     on error undo, return error return-value
      716     :
      717       run day-begin-fact-order in this-procedure
      718         (input  date(1, 1, 5000)
      719         ,output p-max-fact-order
      720         ) .
      721     end.
      722   end procedure.
      723   procedure factord-cut-archive :
      724     define input  parameter p-obj-type             as character no-undo .
      725     define input  parameter p-obj-code             as integer   no-undo .
      726     define input  parameter p-fact-date            as date      no-undo .
      727     define output parameter p-shift-on             as logical   no-undo .
      728     define output parameter p-shift-date           as date      no-undo .
      729     define output parameter p-shift-num            as integer   no-undo .
      730     define output parameter p-day-end-fact-order   as decimal   no-undo .
      731     define output parameter p-shift-end-fact-order as decimal   no-undo .
      732     define variable v-fact-order as decimal   no-undo .
      733     define buffer buf_shift-obj for ub.shift-obj .
      734     do
      735     on error undo, return error return-value
      736     :
      737   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      738   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      739     (input  p-obj-type
      740     ,input  p-obj-code
      741     ,input  'shift-on=request'
      742     ,output p-shift-on
      743     ) no-error .
      744       if error-status :error
      745       then do:
      746         message
      747           vss-workfile vss-revision vss-description skip
      748           "Ошибка при определении атрибута объекта" skip
      749           "Объект" p-obj-type p-obj-code skip
      750           error-status :get-message(1) skip
      751           return-value skip
      752           view-as alert-box error .
      753         undo, return error return-value .
      754       end.
      755       if p-shift-on = false
      756       then do:
      757         assign
      758           p-shift-date               = ?
      759           p-shift-num                = 0
      760         .
      761       end.
      762       else do:
      763         find first buf_shift-obj share-lock
      764           where buf_shift-obj.obj-type   = p-obj-type
      765             and buf_shift-obj.obj-code   = p-obj-code
      766             and buf_shift-obj.shift-date > p-fact-date
      767           use-index pi
      768           no-error .
      769         if not available buf_shift-obj
      770         or buf_shift-obj.status_ <> 'зкр':U
      771         then do:
      772           message
      773             vss-workfile vss-revision vss-description skip
      774             "Невозможно вычислить последнюю смену" skip
      775             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      776             "Объект" p-obj-type p-obj-code skip
      777             "Дата" p-fact-date skip
      778             view-as alert-box error .
      779           undo, return error return-value .
      780         end.
      781         find last buf_shift-obj share-lock
      782           where buf_shift-obj.obj-type = p-obj-type
      783             and buf_shift-obj.obj-code = p-obj-code
      784             and buf_shift-obj.shift-date <= p-fact-date
      785           use-index pi
      786           no-error .
      787         if available buf_shift-obj
      788         then do:
      789           if  buf_shift-obj.status_ = 'зкр':U
      790           then do:
      791             assign
      792               p-shift-date = buf_shift-obj.shift-date
      793               p-shift-num  = buf_shift-obj.shift-num
      794             .
      795           end.
      796           else do:
      797             message
      798               vss-workfile vss-revision vss-description skip
      799               "Невозможно вычислить последнюю смену" skip
      800               "Статус смены отличен от статуса" 'зкр':U skip
      801               "Объект" p-obj-type p-obj-code skip
      802               "Дата" p-fact-date skip
      803               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      804               view-as alert-box error .
      805             undo, return error return-value .
      806           end.
      807         end.
      808         else do:
      809           assign
      810             p-shift-date = p-fact-date - 1
      811             p-shift-num  = 1
      812           .
      813         end.
      814       end.
      815       run factord in this-procedure
      816         (input  p-fact-date
      817         ,input  1
      818         ,input  1
      819         ,input  p-shift-date
      820         ,input  p-shift-num
      821         ,input  p-shift-on
      822         ,output v-fact-order
      823         ,output p-shift-end-fact-order
      824         ,output p-day-end-fact-order
      825         ) no-error .
      826       if error-status :error
      827       then do:
      828         message
      829           vss-workfile vss-revision vss-description skip
      830           "Ошибка при вызове процедуры factord"
      831           error-status :get-message(1) skip
      832           return-value skip
      833           view-as alert-box error .
      834         undo, return error return-value .
      835       end.
      836     end.
      837   end procedure.
      838   procedure factord-lock-shift :
      839     define input  parameter p-obj-type  as character no-undo .
      840     define input  parameter p-obj-code  as integer   no-undo .
      841     define input  parameter p-fact-date as date      no-undo .
      842     define parameter buffer buf_shift-obj for ub.shift-obj .
      843     define variable v-shift-on      as logical   no-undo .
      844     define variable v-extra-message as character no-undo .
      845     define variable v-error as character no-undo .
      846     do
      847     on error undo, return error return-value
      848     :
      849   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      850   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      851     (input  p-obj-type
      852     ,input  p-obj-code
      853     ,input  'shift-on=request'
      854     ,output v-shift-on
      855     ) no-error .
      856       if error-status :error
      857       then do:
      858         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      859         undo, return error v-error .
      860       end.
      861       if v-shift-on = true
      862       then do:
      863         find first buf_shift-obj share-lock
      864           where buf_shift-obj.obj-type   = p-obj-type
      865             and buf_shift-obj.obj-code   = p-obj-code
      866             and buf_shift-obj.shift-date > p-fact-date
      867           use-index pi
      868           no-error .
      869         if not available buf_shift-obj
      870         or buf_shift-obj.status_ <> 'зкр':U
      871         then do:
      872           find last buf_shift-obj
      873             where buf_shift-obj.obj-type = p-obj-type
      874               and buf_shift-obj.obj-code = p-obj-code
      875               and buf_shift-obj.status_  = 'зкр':U
      876             use-index stts
      877             no-error .
      878           if available buf_shift-obj
      879           then do:
      880             assign
      881               v-extra-message =
      882                     substitute("Дата начала последеней закрытой смены на объекте &1"
      883                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      884                               )
      885             .
      886           end.
      887           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      888           undo, return error v-error .
      889         end.
      890       end.
      891     end.
      892   end procedure.
      893   procedure factord-end-day :
      894     define input  parameter p-fact-date            as date    no-undo .
      895     define output parameter p-day-end-fact-order   as decimal no-undo .
      896     do
      897     on error undo, return error return-value
      898     :
      899       if p-fact-date = ?
      900       then do:
      901         return error "Не указана фактическая дата" .
      902       end.
      903       assign
      904         p-day-end-fact-order = integer(p-fact-date) + 0.99
      905       .
      906     end.
      907   end procedure.
      908   procedure factord-to-date :
      909     define input  parameter p-fact-order as decimal no-undo .
      910     define output parameter p-fact-date  as date    no-undo .
      911     define variable v-ref-date  as date      no-undo .
      912     define variable v-ref-delta as integer   no-undo .
      913     do
      914     on error undo, return error return-value
      915     :
      916       if p-fact-order = ?
      917       or p-fact-order = 0
      918       then do:
      919         return error "Не указан fact-order" .
      920       end.
      921       assign
      922         v-ref-date  = date(1, 1, 2000)
      923       .
      924       assign
      925         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      926       .
      927       assign
      928         p-fact-date = v-ref-date + v-ref-delta
      929       .
      930     end.
      931   end procedure.
      932   procedure factord-to-fact-num :
      933     define input  parameter p-fact-order as decimal no-undo .
      934     define output parameter p-fact-num   as integer no-undo .
      935     define variable v-fact-order-trunc as decimal no-undo .
      936     do
      937     on error undo, return error return-value
      938     :
      939       if p-fact-order = ?
      940       or p-fact-order = 0
      941       then do:
      942         return error "Не указан fact-order" .
      943       end.
      944       assign
      945        v-fact-order-trunc = truncate(p-fact-order, 2)
      946       .
      947       assign
      948         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      949       .
      950     end.
      951   end procedure.
      952   procedure factord-to-shift-num :
      953     define input  parameter p-fact-order as decimal no-undo .
      954     define output parameter p-shift-num   as integer no-undo .
      955     define variable  p-shift-numd  as decimal   no-undo .
      956     define variable v-fact-order-trunc as decimal no-undo .
      957     do
      958     on error undo, return error return-value
      959     :
      960       if p-fact-order = ?
      961       or p-fact-order = 0
      962       then do:
      963         return error "Не указан fact-order" .
      964       end.
      965       assign
      966        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      967       .
      968       if v-fact-order-trunc < 0.5 then do:
      969         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      970       end.
      971       assign
      972         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      973         .
      974        assign
      975         p-shift-num = truncate (p-shift-numd , 0)
      976       .
      977     end.
      978   end procedure.
      979   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      980   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      981   define  shared variable RepPathName        as character no-undo .
      982   define  shared variable PrintRubl          as logical   no-undo .
      983   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      984   define  stream PrnLibStream.
      985   procedure prn-lib-prn-file :
      986     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      987     define input parameter p-DIsabledoptions as integer no-undo .
      988     define variable v-report-name as character no-undo .
      989     define variable v-user-action as character no-undo .
      990     define variable v-printed     as logical   no-undo .
      991     define variable v-exist       as logical   no-undo .
      992     do
      993       on error undo, return error
      994       :
      995       run prn-lib-get-report-name  in this-procedure (
      996         input parParentProc
      997         ,output v-report-name
      998         ).
      999   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1000   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     1001     (input  v-report-name
     1002     ,input  2
     1003     ,output v-exist
     1004     )  .
     1005       if NOT v-exist then
     1006       DO:
     1007         Message
     1008           "Нет заданий на печать ! "
     1009           view-as alert-box .
     1010         Return  .
     1011       End.
     1012       run gbl/prnfilen.w
     1013         (input  ""
     1014         ,input  p-DisabledOptions
     1015         ,input  string(v-report-name )
     1016         ,input  7
     1017         ,output v-user-action
     1018         ,output v-printed
     1019         ) .
     1020       if v-printed then
     1021       do:
     1022         return "YES" .
     1023       end.
     1024       else
     1025       do:
     1026         return "NO" .
     1027       end.
     1028     end.
     1029   end procedure.
     1030   procedure prn-lib-open-stream :
     1031     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1032     define input parameter p-page-size    as integer no-undo .
     1033     define input parameter p-is-stream    as logical no-undo .
     1034     define input parameter p-append       as logical no-undo .
     1035     define variable v-report-name as character no-undo .
     1036     do
     1037       on error undo, return error
     1038       :
     1039       run prn-lib-get-report-name  in this-procedure (
     1040         input parParentProc
     1041         ,output v-report-name
     1042         ).
     1043       if p-is-stream then
     1044       do:
     1045         if p-append then
     1046         do:
     1047           output stream PrnLibStream to value( v-report-name )
     1048             page-size value(p-page-size) append .
     1049         end.
     1050         if not p-append then
     1051         do:
     1052           output stream PrnLibStream to value( v-report-name )
     1053             page-size value(p-page-size) .
     1054         end.
     1055       end.
     1056       if not p-is-stream then
     1057       do:
     1058         if p-append then
     1059         do:
     1060           output to value( v-report-name )
     1061             page-size value(p-page-size) append .
     1062         end.
     1063         if not p-append then
     1064         do:
     1065           output to value( v-report-name )
     1066             page-size value(p-page-size) .
     1067         end.
     1068       end.
     1069     end.
     1070   end procedure.
     1071   procedure prn-lib-open-exp :
     1072     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1073     define input parameter p-is-stream    as logical no-undo .
     1074     define input parameter p-is-append    as logical no-undo .
     1075     define output parameter p-ReportFileName as char init "report" no-undo.
     1076     define output parameter p-process as logical no-undo .
     1077     define variable glog as logical no-undo .
     1078     do
     1079       on error undo, return error
     1080       :
     1081       SYSTEM-DIALOG GET-FILE p-ReportFileName
     1082         TITLE      "Укажите путь"
     1083         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     1084         ASK-OVERWRITE
     1085         CREATE-TEST-FILE
     1086         SAVE-AS
     1087         USE-FILENAME
     1088         DEFAULT-EXTENSION "txt"
     1089         UPDATE glog
     1090         .
     1091       if not glog then  return.
     1092       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     1093       if p-is-stream then
     1094       do:
     1095         if p-is-append then
     1096         do:
     1097           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1098         end.
     1099         else
     1100         do:
     1101           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1102         end.
     1103       end.
     1104       else
     1105       do:
     1106         if p-is-append then
     1107         do:
     1108           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1109         end.
     1110         else
     1111         do:
     1112           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1113         end.
     1114       end.
     1115       p-process = yes.
     1116     end.
     1117   end procedure.
     1118   procedure prn-lib-get-report-name :
     1119     define input parameter parParentProc  as widget-handle no-undo.
     1120     define output parameter p-report-name as character no-undo .
     1121     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     1122   end procedure.
     1123   procedure prn-lib-reportviewer-report-name :
     1124     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1125     define input parameter p-report-name-html as character no-undo .
     1126     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
     1127   end procedure.
     1128   procedure prn-lib-reportviewer :
     1129     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1130     define input parameter p-report-name-html as character no-undo .
     1131     define input parameter p-param        as character no-undo .
     1132     define variable v-excel           as character no-undo init 'TRUE' .
     1133     define variable v-value-character as character no-undo .
     1134     define variable v-value-integer   as character no-undo .
     1135     define variable v-value-date      as date      no-undo .
     1136     define variable v-value-decimal   as decimal   no-undo .
     1137     define variable rep-excel         as logical   no-undo .
     1138     define variable excel-string      as character no-undo .
     1139     define variable v-param-type      as character no-undo .
     1140     define variable v-tth             as handle    no-undo .
     1141     run adm/shattri.p (
     1142       input "get":U
     1143       ,input  ""
     1144       ,input  0
     1145       ,input  'report-glob':U
     1146       ,input  'rep-excel':U
     1147       ,output v-value-character
     1148       ,output v-value-date
     1149       ,output v-value-decimal
     1150       ,output v-value-integer
     1151       ,output rep-excel
     1152       ,output v-param-type
     1153       ,INPUT-OUTPUT table-handle v-tth
     1154       )  .
     1155     if rep-excel then v-excel = "TRUE" .
     1156     else v-excel = "FALSE" .
     1157     if p-param eq ""
     1158     then
     1159        p-param = "EXCEL:" + v-excel.
     1160     else
     1161        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1162     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1163   end procedure.
     1164   define variable sym1  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1165   define variable sym2  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1166   define variable sym3  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1167   define variable sym4  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1168   define variable sym5  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1169   define variable sym6  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1170   define variable sym7  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1171   define variable sym8  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1172   define variable sym9  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1173   define variable sym10 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1174   define variable sym11 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1175   define variable sym12 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1176   define variable sym13 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1177   define variable sym14 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1178   define variable sym15 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1179   define variable sym16 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1180   define variable sym17 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1181   define variable sym18 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1182   define variable sym19 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1183   define variable sym20 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1184   define variable sym21 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     1185   define variable sym22 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     1186   define variable sym23 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     1187   define variable sym24 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     1188   define variable sym25 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     1189   define variable sym26 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     1190   define variable sym27 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     1191   define variable temp1 as integer   no-undo.
     1192   define variable vss-include-info13 as character format "X(65)" no-undo
     1193   initial "@(#)$Workfile$ $Revision$".
     1194   procedure grplib-get-full-name :
     1195      define input parameter p-node-code  as integer      no-undo.
     1196      define output parameter p-full-name as character    no-undo.
     1197      do
     1198   on error undo, return error
     1199   :
     1200       define variable v-upper-code    as integer           no-undo.
     1201       define buffer buf_gds-grp       for ub.gds-grp.
     1202       define buffer buf_upper_gds-grp for ub.gds-grp.
     1203       find first buf_gds-grp no-lock
     1204            where buf_gds-grp.node-code = p-node-code
     1205       no-error.
     1206       if not available buf_gds-grp
     1207       then do:
     1208           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     1209       end.
     1210       assign
     1211           p-full-name  = ""
     1212           v-upper-code = 1
     1213       .
     1214       do while buf_gds-grp.upper-code <> 0
     1215       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     1216       :
     1217           assign
     1218               p-full-name  = buf_gds-grp.node-name
     1219                            + (if p-full-name <> "" then chr(47) else "")
     1220                            + p-full-name
     1221               v-upper-code = buf_gds-grp.upper-code
     1222           .
     1223           find first buf_gds-grp no-lock
     1224                where buf_gds-grp.node-code = v-upper-code
     1225           no-error.
     1226           if not available buf_gds-grp
     1227           then do:
     1228               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
     1229                                   + string( v-upper-code )
     1230                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     1231           end.
     1232       end.
     1233       assign
     1234       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     1235       .
     1236   end.
     1237   end .
     1238   procedure grplib-get-node-from-full-name :
     1239   define input parameter p-full-name as character no-undo .
     1240   define output parameter p-node-code as integer no-undo .
     1241   define variable v-ii as integer no-undo .
     1242   define variable v-upper-code as integer no-undo .
     1243   define variable v-root-code as integer no-undo .
     1244   define variable v-entry as character no-undo .
     1245   define buffer buf_gds-grp       for ub.gds-grp.
     1246   do
     1247   on error undo, return error
     1248   :
     1249     find first buf_gds-grp no-lock
     1250         where buf_gds-grp.upper-code = 0
     1251     no-error .
     1252     if not available buf_gds-grp
     1253     then do:
     1254         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
     1255     end.
     1256     else do:
     1257       assign
     1258       v-root-code = buf_gds-grp.node-code
     1259       .
     1260     end.
     1261     v-upper-code = v-root-code.
     1262     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     1263       assign
     1264       v-entry = entry(v-ii, p-full-name, chr(47)).
     1265       if v-entry = '' then leave.
     1266       find first buf_gds-grp no-lock where
     1267                 buf_gds-grp.node-name = v-entry
     1268             and buf_gds-grp.upper-code = v-upper-code
     1269             no-error.
     1270       if not available buf_gds-grp then do:
     1271         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     1272       end.
     1273       else do:
     1274         p-node-code = buf_gds-grp.node-code.
     1275         v-upper-code = buf_gds-grp.node-code.
     1276       end.
     1277     end.
     1278   end.
     1279   end .
     1280   define buffer buf_goods    for goods.
     1281   define buffer buf_clients  for clients.
     1282   define buffer buf_gds-obj  for gds-obj.
     1283   define buffer buf_gds-grp  for gds-grp.
     1284   define buffer buf_stk-line for stk-line.
     1285   DEFINE temp-table temp-DiscSales no-undo
     1286   field   fact-qnty        as decimal
     1287   field   sum-sale         as decimal
     1288   field   prod-type        as  char
     1289   field   prod-code        as  integer
     1290   field   artic            as  char
     1291   field   gds-name         as  char
     1292   field   grp-name         as  char
     1293   field   price            as  decimal
     1294   field   unit-base        as  char
     1295   field   grp-code         as  integer
     1296   INDEX pi  IS PRIMARY   artic  prod-type prod-code
     1297   INDEX pi2              grp-name
     1298   .
     1299   define variable  v-fact-order           as decimal   no-undo .
     1300   define variable  v-fact-order-start     as decimal   no-undo .
     1301   define variable  v-fact-order-end       as decimal   no-undo .
     1302   define variable p-fact-qnty     as decimal   no-undo .
     1303   define variable p-cost-rubl     as decimal   no-undo .
     1304   define variable p-sale-rubl     as decimal   no-undo .
     1305   define variable t-dec           as decimal   no-undo .
     1306   define variable ind                    as integer   no-undo .
     1307   define variable ii                     as integer initial 0  no-undo .
     1308   define variable Counter1               as integer   no-undo .
     1309   define variable CurrGrpName            as character no-undo .
     1310   define variable Line                   as character no-undo .
     1311   define variable str-find               as character no-undo .
     1312   define variable v-NameString  as character no-undo .
     1313   define variable v-unit-base  as character no-undo .
     1314   define variable g#gds-engl as logical   no-undo .
     1315   run get-gds-engl   in my-handle ( output g#gds-engl ) .
     1316   run day-begin-fact-order in this-procedure ( input x-date-start,        output v-fact-order-start ).
     1317   run day-begin-fact-order in this-procedure ( input ( x-date-end + 1 ),  output v-fact-order-end ).
     1318   assign
     1319     Counter1 = 0 .
     1320   .
     1321   define variable v-account as integer init 0 no-undo .
     1322   define variable v-account-lavel as character no-undo .
     1323   define variable v-button-stop as logical no-undo .
     1324   define variable v-kol-spice as integer no-undo .
     1325   define variable v-kol-spice2 as integer no-undo .
     1326   define variable v-kol-spice3 as integer no-undo .
     1327   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     1328   DEFINE BUTTON StopBtn AUTO-END-KEY
     1329        LABEL "Стоп"
     1330        SIZE 10 BY 1.
     1331   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     1332        LABEL "Обработано записей"
     1333         VIEW-AS TEXT
     1334        SIZE 14 BY .67 NO-UNDO.
     1335   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     1336         VIEW-AS TEXT
     1337        SIZE 53.25 BY .67
     1338        FGCOLOR 1  NO-UNDO.
     1339   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     1340         VIEW-AS TEXT
     1341        SIZE 53.25 BY .67
     1342        FGCOLOR 1  NO-UNDO.
     1343   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     1344         VIEW-AS TEXT
     1345        SIZE 53.25 BY .67
     1346        FGCOLOR 1  NO-UNDO.
     1347   DEFINE RECTANGLE RECT-1
     1348        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1349        SIZE 55.13 BY 4.46.
     1350   DEFINE FRAME InfoFrame
     1351        StopBtn AT ROW 4.25 COL 21.75
     1352        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     1353        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     1354        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     1355        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     1356        RECT-1 AT ROW 1 COL 1
     1357       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1358            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1359            TITLE "Процесс"
     1360            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     1361   define variable mFrameView      as logical   no-undo init yes.
     1362     define variable mFramHandle as handle no-undo.
     1363     mFramHandle = frame InfoFrame:handle.
     1364     if  log-manager:logfile-name ne ?
     1365     then DO:
     1366         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1367         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1368         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     1369     end.
     1370     mFrameView = not session:batch-mode and mFramHandle:visible.
     1371     if mFrameView
     1372     then do:
     1373       ASSIGN
     1374          FRAME InfoFrame:HIDDEN                           = TRUE
     1375          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     1376     end.
     1377   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     1378   DO:
     1379     IF not StopProcessing THEN
     1380       Message "Вы действительно хотите прервать" SKIP
     1381               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     1382                 UPDATE StopProcessing.
     1383     IF StopProcessing THEN do:
     1384        if mFrameView
     1385        then do:
     1386           HIDE FRAME InfoFrame.
     1387        end.
     1388     End.
     1389   END.
     1390   assign v-account = ( if integer( 5 ) = 0 then 100 else integer( 5 ) ).
     1391     if  log-manager:logfile-name ne ?
     1392     then DO:
     1393         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     1394     end.
     1395     if not session:batch-mode then
     1396     do:
     1397       VIEW FRAME InfoFrame.
     1398       mFrameView = true.
     1399     end.
     1400      v-button-stop = false .
     1401         if mFrameView
     1402         then do:
     1403         if v-button-stop then view STOPBTN in frame InfoFrame.
     1404                          else Hide STOPBTN in frame InfoFrame.
     1405         end.
     1406   for each temp-DiscSales :
     1407     delete temp-DiscSales .
     1408   end.
     1409   for each obj-list no-lock :
     1410     for each buf_gds-obj
     1411         where buf_gds-obj.obj-type  = obj-list.obj-type
     1412           and buf_gds-obj.obj-code  = obj-list.obj-code :
     1413       find first buf_goods no-lock
     1414         where buf_goods.gds-code = buf_gds-obj.gds-code
     1415       no-error.
     1416   assign Counter1 = Counter1 + 1.
     1417   IF ( Counter1 modulo v-account = 0 )  then DO:
     1418             if  log-manager:logfile-name ne ?
     1419             then DO:
     1420                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     1421             end.
     1422              if mFrameView
     1423              then do:
     1424               DISPLAY
     1425                 Counter1 @ RecordsDone
     1426                 WITH FRAME InfoFrame.
     1427              end.
     1428   End.
     1429      if v-button-stop then  DO:
     1430            if mFrameView
     1431            then
     1432               PROCESS EVENTS.
     1433            IF StopProcessing THEN DO:
     1434            RETURN error.
     1435            End.
     1436      end.
     1437   find first temp-DiscSales
     1438   where temp-DiscSales.artic        = buf_goods.artic
     1439     and temp-DiscSales.prod-type    = buf_goods.prod-type
     1440     and temp-DiscSales.prod-code    = buf_goods.prod-code
     1441   no-error .
     1442   if not available temp-DiscSales then do:
     1443   create temp-DiscSales .
     1444   assign
     1445     temp-DiscSales.artic     = buf_goods.artic
     1446     temp-DiscSales.prod-type = buf_goods.prod-type
     1447     temp-DiscSales.prod-code = buf_goods.prod-code
     1448     temp-DiscSales.grp-name  = trim( buf_goods.grp-name )
     1449     temp-DiscSales.unit-base = buf_goods.unit-base
     1450     temp-DiscSales.grp-code  = buf_goods.grp-code
     1451     temp-DiscSales.sum-sale  = 0
     1452     temp-DiscSales.fact-qnty = 0
     1453   .
     1454   if g#gds-engl then assign temp-DiscSales.gds-name = buf_goods.engl-name.
     1455   else               assign temp-DiscSales.gds-name = buf_goods.gds-name.
     1456   end.
     1457   do ii = 1 to 4 :
     1458   case ii :
     1459     when 1 then assign str-find = 'sadt':U + 'ee':U .
     1460     when 2 then assign str-find = 'sadt':U + 'es':U .
     1461     when 3 then assign str-find = 'sadt':U + 're':U .
     1462     when 4 then assign str-find = 'sadt':U + 'rs':U .
     1463     end.
     1464   find last buf_stk-line no-lock
     1465     where buf_stk-line.obj-type  = buf_gds-obj.obj-type
     1466       and buf_stk-line.obj-code  = buf_gds-obj.obj-code
     1467       and buf_stk-line.artic     = buf_goods.artic
     1468       and buf_stk-line.prod-type = buf_gds-obj.prod-type
     1469       and buf_stk-line.prod-code = buf_gds-obj.prod-code
     1470       and buf_stk-line.sum-type  = str-find
     1471       and buf_stk-line.cat-id    = '##,##'
     1472       and buf_stk-line.fact-order  <= v-fact-order-start
     1473   use-index category no-error .
     1474   if available buf_stk-line then do:
     1475     case ii :
     1476       when 1 or when 2 then assign
     1477       temp-DiscSales.sum-sale = temp-DiscSales.sum-sale + buf_stk-line.sum-rubl
     1478       temp-DiscSales.fact-qnty = temp-DiscSales.fact-qnty + buf_stk-line.fact-qnty.
     1479       when 3 or when 4 then assign
     1480       temp-DiscSales.sum-sale = temp-DiscSales.sum-sale + buf_stk-line.sum-rubl
     1481       temp-DiscSales.fact-qnty = temp-DiscSales.fact-qnty + buf_stk-line.fact-qnty.
     1482       end.
     1483   end.
     1484   find last buf_stk-line no-lock
     1485     where buf_stk-line.obj-type  = buf_gds-obj.obj-type
     1486       and buf_stk-line.obj-code  = buf_gds-obj.obj-code
     1487       and buf_stk-line.artic     = buf_goods.artic
     1488       and buf_stk-line.prod-type = buf_gds-obj.prod-type
     1489       and buf_stk-line.prod-code = buf_gds-obj.prod-code
     1490       and buf_stk-line.sum-type  = str-find
     1491       and buf_stk-line.cat-id    = '##,##'
     1492       and buf_stk-line.fact-order  < v-fact-order-end
     1493   use-index category no-error .
     1494   if available buf_stk-line then do:
     1495       case ii :
     1496       when 1 or when 2 then assign
     1497       temp-DiscSales.sum-sale = temp-DiscSales.sum-sale - buf_stk-line.sum-rubl
     1498       temp-DiscSales.fact-qnty = temp-DiscSales.fact-qnty - buf_stk-line.fact-qnty.
     1499       when 3 or when 4 then assign
     1500       temp-DiscSales.sum-sale = temp-DiscSales.sum-sale - buf_stk-line.sum-rubl
     1501       temp-DiscSales.fact-qnty = temp-DiscSales.fact-qnty - buf_stk-line.fact-qnty.
     1502       end.
     1503   end.
     1504   end.
     1505     end.
     1506   end.
     1507   def var sum-all as dec init 0.
     1508   for each temp-DiscSales :
     1509     if temp-DiscSales.fact-qnty = 0 then do:
     1510     delete temp-DiscSales.
     1511     end.
     1512     else do:
     1513     assign  temp-discSales.price = temp-DiscSales.sum-sale / temp-DiscSales.fact-qnty
     1514     sum-all = sum-all + temp-DiscSales.sum-sale.
     1515     end.
     1516   end.
     1517   if session :set-wait-state( "compiler" ) then.
     1518     Line = fill("-", 250).
     1519     DEFINE frame f-doc
     1520     sym1  temp-DiscSales.gds-name  column-label "                  Наименование ! "        format "X(50)"               space(0)
     1521     sym2  temp-DiscSales.price     column-label "Цена   ! (руб.)"            format ">>>,>>>,>>9.99"          space(0)
     1522     sym3  temp-DiscSales.unit-base column-label "   Единица! "               format "X(15)"               space(0)
     1523     sym4  temp-DiscSales.fact-qnty column-label "  Количество  ! "           format "->>>,>>>,>>9.999"    space(0)
     1524     sym5  temp-DiscSales.sum-sale  column-label "Сумма        !(руб.)"           format "->>>,>>>,>>>,>>9.99" space(0)
     1525     sym6
     1526     HEADER
     1527     Line format "X(125)" AT 1
     1528     with width 136 down stream-io.
     1529      reportpageheight = 43  .
     1530     run prn-lib-open-stream  in this-procedure (
     1531                                                 input my-handle
     1532                                                 ,input 43
     1533                                                 ,input yes
     1534                                                 ,input no
     1535                                                 ).
     1536     FORM HEADER
     1537     Line format "X(125)" AT 1 SKIP
     1538     with FRAME BottomFrame width 136 PAGE-BOTTOM NO-LABELS NO-BOX .
     1539     VIEW stream PrnLibStream FRAME BottomFrame .
     1540     FORM with FRAME f-doc .
     1541     PUT stream PrnLibStream SPACE(45) "Отчет о реализации блюд и товаров в рознице" SKIP .
     1542     PUT stream PrnLibStream str1 at 50 format "X(100)" SKIP .
     1543     assign  v-NameString = "Выбор объекта: " .
     1544     PUT stream PrnLibStream v-NameString format "X(100)" SKIP .
     1545     for each obj-list no-lock:
     1546       Assign  v-NameString = obj-list.obj-name + " (" + obj-list.obj-type + '#' + string(obj-list.obj-code)  + "), " .
     1547       PUT stream PrnLibStream SPACE(5) v-NameString format "X(100)" SKIP .
     1548     end.
     1549     for each temp-DiscSales :
     1550       display stream PrnLibStream
     1551       sym1  temp-DiscSales.gds-name
     1552       sym2  temp-DiscSales.price
     1553       sym3  temp-DiscSales.unit-base
     1554       sym4  temp-DiscSales.fact-qnty
     1555       sym5  temp-DiscSales.sum-sale
     1556       sym6
     1557       with frame f-doc.
     1558       down stream PrnLibStream with frame f-doc .
     1559     End.
     1560     PUT STREAM PrnLibStream Line format "X(125)".
     1561     HIDE stream PrnLibStream FRAME BottomFrame .
     1562     OUTPUT stream PrnLibStream CLOSE.
     1563   if mFrameView
     1564   then do:
     1565      HIDE FRAME InfoFrame.
     1566   end.
     1567   if session :set-wait-state( "" ) then.
     1568     run prn-lib-prn-file in this-procedure (
     1569                                               input my-handle
     1570                                               ,input 8
     1571                                               ).
     1572   end.
