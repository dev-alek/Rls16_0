      523   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      524   DEFINE shared TEMP-TABLE treal-4 no-undo
      525   FIELD gds-code as integer
      526   FIELD cpay-code as integer
      527   FIELD curr-code as integer
      528   FIELD qnty1 as decimal
      529   FIELD netto as decimal
      530   FIELD out-name as character format "X(20)"
      531   FIELD is-pay as logical
      532   FIELD discnt-type   as integer
      533   FIELD brutto as decimal
      534   FIELD discount-sum as decimal
      535   FIELD chk-qnty as int
      536   FIELD ii as integer
      537   INDEX pi IS UNIQUE PRIMARY
      538         gds-code
      539         cpay-code
      540             discnt-type
      541         curr-code
      542         is-pay DESCENDING
      543   INDEX vi
      544         gds-code
      545         ii
      546   .
      547   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      548   DEFINE shared TEMP-TABLE t-4 no-undo
      549   FIELD gds-code like ub.goods.gds-code
      550   FIELD main-code like ub.bar-code.b-code
      551   FIELD artic like ub.goods.artic
      552   FIELD prod-type like ub.goods.prod-type
      553   FIELD prod-code like ub.goods.prod-code
      554   FIELD last-price as decimal FORMAT ">>>>9.99"
      555   FIELD gds-name like ub.goods.gds-name FORMAT "X(24)"
      556   FIELD lines as integer
      557   INDEX pi IS UNIQUE primary
      558   gds-code
      559   INDEX art IS UNIQUE
      560   artic
      561   prod-type
      562   prod-code
      563   INDEX pervakov IS UNIQUE
      564   main-code
      565   .
      566   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      567     define temp-table tt-stk-line no-undo like ub.stk-line.
      568   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      569   PROCEDURE create-treal-4.
      570   DEFINE INPUT PARAMETER pgds-code like ub.goods.gds-code no-undo.
      571   DEFINE INPUT PARAMETER pcpay-code like ub.cash-pay.cdpay-code no-undo.
      572   DEFINE INPUT PARAMETER pcurr-code like ub.cash-pay.curr-code no-undo.
      573   DEFINE INPUT PARAMETER pqnty1 as decimal no-undo.
      574   DEFINE INPUT PARAMETER pnetto as decimal no-undo.
      575   DEFINE INPUT PARAMETER pout-name as character no-undo.
      576   DEFINE INPUT PARAMETER pis-pay as logical no-undo.
      577   DEFINE INPUT PARAMETER pii as integer no-undo.
      578   _main:
      579   DO ON ERROR UNDO _main, return error:
      580       create treal-4.
      581       assign
      582       treal-4.gds-code = pgds-code
      583       treal-4.cpay-code = pcpay-code
      584       treal-4.curr-code = pcurr-code
      585       treal-4.qnty1  =  pqnty1
      586       treal-4.netto = pnetto
      587       treal-4.out-name = pout-name
      588       treal-4.is-pay = pis-pay
      589       treal-4.ii = pii
      590       no-error
      591       .
      592       if error-status:error then undo _main, return error.
      593   END.
      594   END PROCEDURE.
      595   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      596   procedure factord :
      597     define input  parameter p-fact-date            as date    no-undo .
      598     define input  parameter p-fact-time            as integer no-undo .
      599     define input  parameter p-fact-num             as integer no-undo .
      600     define input  parameter p-shift-date           as date    no-undo .
      601     define input  parameter p-shift-num            as integer no-undo .
      602     define input  parameter p-shift-on             as logical no-undo .
      603     define output parameter p-fact-order           as decimal no-undo .
      604     define output parameter p-shift-end-fact-order as decimal no-undo .
      605     define output parameter p-day-end-fact-order   as decimal no-undo .
      606     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      607     if p-fact-date = ?
      608     then do:
      609       return error "Не указана фактическая дата" .
      610     end.
      611     define variable v-fact-date-num as integer no-undo .
      612     assign
      613       v-fact-date-num = integer(p-fact-date)
      614     .
      615     if p-fact-num = ?
      616     or p-fact-num = 0
      617     then do:
      618       return error "Не задан p-fact-num " + string(p-fact-num) .
      619     end.
      620     if p-fact-num < 0
      621     then do:
      622       return error "Отрицательный fact-num " + string(p-fact-num) .
      623     end.
      624     if p-fact-num >= 100000000
      625     then do:
      626       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      627     end.
      628     if p-shift-on = true
      629     then do:
      630       if p-shift-date = ?
      631       then do:
      632         return error "Не задана дата смены" .
      633       end.
      634       if p-shift-num = ?
      635       or p-shift-num = 0
      636       then do:
      637         return error "Не задан номер смены" .
      638       end.
      639     end.
      640     else do:
      641       assign
      642         p-shift-date = p-fact-date
      643         p-shift-num  = 24
      644       .
      645     end.
      646     define variable v-shift-offset as integer no-undo .
      647     if p-shift-date = p-fact-date
      648     then do:
      649       assign
      650         v-shift-offset = 1
      651       .
      652     end.
      653     if p-shift-date < p-fact-date
      654     then do:
      655       assign
      656         v-shift-offset = 0
      657       .
      658     end.
      659     if p-shift-date > p-fact-date
      660     then do:
      661       message
      662         vss-workfile vss-revision vss-description skip
      663         "Неправильная дата закрытия смены" skip
      664         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      665         view-as alert-box error .
      666       undo, return error
      667         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      668           ,string(p-fact-date, '99/99/9999':U)
      669           ,string(p-shift-date, '99/99/9999':U)
      670           )
      671       .
      672     end.
      673     if p-shift-num < 1
      674     or p-shift-num > 24
      675     then do:
      676       message
      677         vss-workfile vss-revision vss-description skip
      678         "Неправильный номер смены" skip
      679         "p-shift-num" p-shift-num skip
      680         view-as alert-box error .
      681       undo, return error return-value .
      682     end.
      683     assign
      684       p-fact-order           = v-fact-date-num
      685                              + v-shift-offset * 0.5
      686                              + p-shift-num    * 0.02 - 0.01
      687                              + p-fact-num     * 0.0000000001
      688       p-shift-end-fact-order = v-fact-date-num
      689                              + v-shift-offset * 0.5
      690                              + p-shift-num    * 0.02
      691       p-day-end-fact-order   = v-fact-date-num
      692                              + 0.99
      693     .
      694     if p-fact-order           <= v-fact-date-num
      695     or p-shift-end-fact-order <= v-fact-date-num
      696     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      697     or p-shift-end-fact-order >= p-day-end-fact-order
      698     then do:
      699       message
      700         vss-workfile vss-revision vss-description skip
      701         "Внутренняя ошибка при генерации фактического номера" skip
      702         "p-fact-date"            p-fact-date            skip
      703         "p-fact-time"            p-fact-time            skip
      704         "p-fact-num"             p-fact-num             skip
      705         "p-shift-date"           p-shift-date           skip
      706         "p-shift-num"            p-shift-num            skip
      707         "p-shift-on"             p-shift-on             skip
      708         "p-shift-end-fact-order" p-shift-end-fact-order skip
      709         "p-day-end-fact-order"   p-day-end-fact-order   skip
      710         "v-fact-date-num"        v-fact-date-num        skip
      711         view-as alert-box error .
      712       undo, return error return-value .
      713     end.
      714   end procedure.
      715   procedure day-begin-fact-order :
      716     define input  parameter p-fact-date            as date    no-undo .
      717     define output parameter p-day-begin-fact-order as decimal no-undo .
      718     do
      719     on error undo, return error return-value
      720     :
      721       if p-fact-date = ?
      722       then do:
      723         assign
      724           p-day-begin-fact-order = 0
      725         .
      726       end.
      727       else do:
      728         assign
      729           p-day-begin-fact-order = integer(p-fact-date)
      730         .
      731       end.
      732     end.
      733   end procedure.
      734   procedure factord-max-fact-order :
      735     define output parameter p-max-fact-order as decimal   no-undo .
      736     do
      737     on error undo, return error return-value
      738     :
      739       run day-begin-fact-order in this-procedure
      740         (input  date(1, 1, 5000)
      741         ,output p-max-fact-order
      742         ) .
      743     end.
      744   end procedure.
      745   procedure factord-cut-archive :
      746     define input  parameter p-obj-type             as character no-undo .
      747     define input  parameter p-obj-code             as integer   no-undo .
      748     define input  parameter p-fact-date            as date      no-undo .
      749     define output parameter p-shift-on             as logical   no-undo .
      750     define output parameter p-shift-date           as date      no-undo .
      751     define output parameter p-shift-num            as integer   no-undo .
      752     define output parameter p-day-end-fact-order   as decimal   no-undo .
      753     define output parameter p-shift-end-fact-order as decimal   no-undo .
      754     define variable v-fact-order as decimal   no-undo .
      755     define buffer buf_shift-obj for ub.shift-obj .
      756     do
      757     on error undo, return error return-value
      758     :
      759   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      760   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      761     (input  p-obj-type
      762     ,input  p-obj-code
      763     ,input  'shift-on=request'
      764     ,output p-shift-on
      765     ) no-error .
      766       if error-status :error
      767       then do:
      768         message
      769           vss-workfile vss-revision vss-description skip
      770           "Ошибка при определении атрибута объекта" skip
      771           "Объект" p-obj-type p-obj-code skip
      772           error-status :get-message(1) skip
      773           return-value skip
      774           view-as alert-box error .
      775         undo, return error return-value .
      776       end.
      777       if p-shift-on = false
      778       then do:
      779         assign
      780           p-shift-date               = ?
      781           p-shift-num                = 0
      782         .
      783       end.
      784       else do:
      785         find first buf_shift-obj share-lock
      786           where buf_shift-obj.obj-type   = p-obj-type
      787             and buf_shift-obj.obj-code   = p-obj-code
      788             and buf_shift-obj.shift-date > p-fact-date
      789           use-index pi
      790           no-error .
      791         if not available buf_shift-obj
      792         or buf_shift-obj.status_ <> 'зкр':U
      793         then do:
      794           message
      795             vss-workfile vss-revision vss-description skip
      796             "Невозможно вычислить последнюю смену" skip
      797             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      798             "Объект" p-obj-type p-obj-code skip
      799             "Дата" p-fact-date skip
      800             view-as alert-box error .
      801           undo, return error return-value .
      802         end.
      803         find last buf_shift-obj share-lock
      804           where buf_shift-obj.obj-type = p-obj-type
      805             and buf_shift-obj.obj-code = p-obj-code
      806             and buf_shift-obj.shift-date <= p-fact-date
      807           use-index pi
      808           no-error .
      809         if available buf_shift-obj
      810         then do:
      811           if  buf_shift-obj.status_ = 'зкр':U
      812           then do:
      813             assign
      814               p-shift-date = buf_shift-obj.shift-date
      815               p-shift-num  = buf_shift-obj.shift-num
      816             .
      817           end.
      818           else do:
      819             message
      820               vss-workfile vss-revision vss-description skip
      821               "Невозможно вычислить последнюю смену" skip
      822               "Статус смены отличен от статуса" 'зкр':U skip
      823               "Объект" p-obj-type p-obj-code skip
      824               "Дата" p-fact-date skip
      825               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      826               view-as alert-box error .
      827             undo, return error return-value .
      828           end.
      829         end.
      830         else do:
      831           assign
      832             p-shift-date = p-fact-date - 1
      833             p-shift-num  = 1
      834           .
      835         end.
      836       end.
      837       run factord in this-procedure
      838         (input  p-fact-date
      839         ,input  1
      840         ,input  1
      841         ,input  p-shift-date
      842         ,input  p-shift-num
      843         ,input  p-shift-on
      844         ,output v-fact-order
      845         ,output p-shift-end-fact-order
      846         ,output p-day-end-fact-order
      847         ) no-error .
      848       if error-status :error
      849       then do:
      850         message
      851           vss-workfile vss-revision vss-description skip
      852           "Ошибка при вызове процедуры factord"
      853           error-status :get-message(1) skip
      854           return-value skip
      855           view-as alert-box error .
      856         undo, return error return-value .
      857       end.
      858     end.
      859   end procedure.
      860   procedure factord-lock-shift :
      861     define input  parameter p-obj-type  as character no-undo .
      862     define input  parameter p-obj-code  as integer   no-undo .
      863     define input  parameter p-fact-date as date      no-undo .
      864     define parameter buffer buf_shift-obj for ub.shift-obj .
      865     define variable v-shift-on      as logical   no-undo .
      866     define variable v-extra-message as character no-undo .
      867     define variable v-error as character no-undo .
      868     do
      869     on error undo, return error return-value
      870     :
      871   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      872   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      873     (input  p-obj-type
      874     ,input  p-obj-code
      875     ,input  'shift-on=request'
      876     ,output v-shift-on
      877     ) no-error .
      878       if error-status :error
      879       then do:
      880         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      881         undo, return error v-error .
      882       end.
      883       if v-shift-on = true
      884       then do:
      885         find first buf_shift-obj share-lock
      886           where buf_shift-obj.obj-type   = p-obj-type
      887             and buf_shift-obj.obj-code   = p-obj-code
      888             and buf_shift-obj.shift-date > p-fact-date
      889           use-index pi
      890           no-error .
      891         if not available buf_shift-obj
      892         or buf_shift-obj.status_ <> 'зкр':U
      893         then do:
      894           find last buf_shift-obj
      895             where buf_shift-obj.obj-type = p-obj-type
      896               and buf_shift-obj.obj-code = p-obj-code
      897               and buf_shift-obj.status_  = 'зкр':U
      898             use-index stts
      899             no-error .
      900           if available buf_shift-obj
      901           then do:
      902             assign
      903               v-extra-message =
      904                     substitute("Дата начала последеней закрытой смены на объекте &1"
      905                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      906                               )
      907             .
      908           end.
      909           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      910           undo, return error v-error .
      911         end.
      912       end.
      913     end.
      914   end procedure.
      915   procedure factord-end-day :
      916     define input  parameter p-fact-date            as date    no-undo .
      917     define output parameter p-day-end-fact-order   as decimal no-undo .
      918     do
      919     on error undo, return error return-value
      920     :
      921       if p-fact-date = ?
      922       then do:
      923         return error "Не указана фактическая дата" .
      924       end.
      925       assign
      926         p-day-end-fact-order = integer(p-fact-date) + 0.99
      927       .
      928     end.
      929   end procedure.
      930   procedure factord-to-date :
      931     define input  parameter p-fact-order as decimal no-undo .
      932     define output parameter p-fact-date  as date    no-undo .
      933     define variable v-ref-date  as date      no-undo .
      934     define variable v-ref-delta as integer   no-undo .
      935     do
      936     on error undo, return error return-value
      937     :
      938       if p-fact-order = ?
      939       or p-fact-order = 0
      940       then do:
      941         return error "Не указан fact-order" .
      942       end.
      943       assign
      944         v-ref-date  = date(1, 1, 2000)
      945       .
      946       assign
      947         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      948       .
      949       assign
      950         p-fact-date = v-ref-date + v-ref-delta
      951       .
      952     end.
      953   end procedure.
      954   procedure factord-to-fact-num :
      955     define input  parameter p-fact-order as decimal no-undo .
      956     define output parameter p-fact-num   as integer no-undo .
      957     define variable v-fact-order-trunc as decimal no-undo .
      958     do
      959     on error undo, return error return-value
      960     :
      961       if p-fact-order = ?
      962       or p-fact-order = 0
      963       then do:
      964         return error "Не указан fact-order" .
      965       end.
      966       assign
      967        v-fact-order-trunc = truncate(p-fact-order, 2)
      968       .
      969       assign
      970         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      971       .
      972     end.
      973   end procedure.
      974   procedure factord-to-shift-num :
      975     define input  parameter p-fact-order as decimal no-undo .
      976     define output parameter p-shift-num   as integer no-undo .
      977     define variable  p-shift-numd  as decimal   no-undo .
      978     define variable v-fact-order-trunc as decimal no-undo .
      979     do
      980     on error undo, return error return-value
      981     :
      982       if p-fact-order = ?
      983       or p-fact-order = 0
      984       then do:
      985         return error "Не указан fact-order" .
      986       end.
      987       assign
      988        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      989       .
      990       if v-fact-order-trunc < 0.5 then do:
      991         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      992       end.
      993       assign
      994         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      995         .
      996        assign
      997         p-shift-num = truncate (p-shift-numd , 0)
      998       .
      999     end.
     1000   end procedure.
     1001   define buffer end_shift-obj      for ub.shift-obj .
     1002   define buffer previous-shift-obj for ub.shift-obj.
     1003   define variable fo      as decimal no-undo init 0.
     1004   define variable prev-fo as decimal no-undo init 0.
     1005   define variable moving  as logical no-undo init yes.
     1006   find first end_shift-obj share-lock
     1007     where end_shift-obj.obj-type   = pobj-type
     1008       and end_shift-obj.obj-code   = pobj-code
     1009       and end_shift-obj.shift-date = pshift-date1
     1010       and end_shift-obj.shift-num  = pshift-num1
     1011       no-error.
     1012   if not available end_shift-obj then do:
     1013     message
     1014       vss-workfile vss-revision vss-description skip
     1015       substitute("Не найдена смена с порядковым номером &1 от &2 для объекта &3 &4", pshift-num1, pshift-date1, pobj-type, pobj-code ) skip
     1016       view-as alert-box error .
     1017     return error.
     1018   end.
     1019   else do:
     1020     assign
     1021       fo = end_shift-obj.fact-order
     1022     .
     1023   end.
     1024   find last previous-shift-obj share-lock
     1025     where previous-shift-obj.obj-type = pobj-type
     1026       and previous-shift-obj.obj-code = pobj-code
     1027       and (( previous-shift-obj.shift-date = pshift-date
     1028              and previous-shift-obj.shift-num < pshift-num
     1029            )
     1030            or previous-shift-obj.shift-date < pshift-date
     1031           )
     1032       use-index pi no-error.
     1033   if available previous-shift-obj then do:
     1034       if  previous-shift-obj.shift-date < p-previous-shift-date then do:
     1035         run day-begin-fact-order in this-procedure (
     1036                                                 input  p-previous-shift-date
     1037                                                ,output prev-fo).
     1038       end.
     1039       else do:
     1040       assign
     1041         prev-fo = previous-shift-obj.fact-order
     1042       .
     1043       end.
     1044   end.
     1045   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1046   define temp-table start-stk-line no-undo like ub.stk-line.
     1047   define temp-table end-stk-line   no-undo like ub.stk-line.
     1048   procedure stk-lnrv:
     1049   define input  parameter parobj-type         like ub.clients.obj-type       no-undo.
     1050   define input  parameter parobj-code         like ub.clients.obj-code       no-undo.
     1051   define input  parameter parartic            like ub.goods.artic            no-undo.
     1052   define input  parameter parprod-type        like ub.goods.prod-type        no-undo.
     1053   define input  parameter parprod-code        like ub.goods.prod-code        no-undo.
     1054   define input  parameter parfact-order-start like ub.stk-line.fact-order no-undo.
     1055   define input  parameter parfact-order-end   like ub.stk-line.fact-order no-undo.
     1056   define input  parameter parsum-type         like ub.stk-line.sum-type   no-undo.
     1057   define input  parameter parcat-id           like ub.stk-line.cat-id     no-undo.
     1058   define input  parameter paris-shift         as   logical                no-undo.
     1059   define output parameter table for tt-stk-line.
     1060   define variable i                as integer no-undo.
     1061   define variable varqnty-doc-type as integer no-undo.
     1062   define variable varsum-type like ub.stk-line.sum-type no-undo.
     1063   do on error undo, return error return-value :
     1064   assign varqnty-doc-type = num-entries('ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U).
     1065   do i = 1 to varqnty-doc-type:
     1066      assign varsum-type = parsum-type + ENTRY(i, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U).
     1067   if paris-shift then do:
     1068     for each start-stk-line:                                                                                        delete start-stk-line.                                                                                  end.                                                                                                                find last ub.stk-line where ub.stk-line.obj-type    = parobj-type                  and                                                             ub.stk-line.obj-code    = parobj-code                  and                                                             ub.stk-line.artic       = parartic                     and                                                             ub.stk-line.prod-type   = parprod-type                 and                                                             ub.stk-line.prod-code   = parprod-code                 and                                                             ub.stk-line.fact-order <= parfact-order-start  and                                                             ub.stk-line.sum-type    = varsum-type                  and                                                             ub.stk-line.cat-id      = parcat-id                    and                                                             ub.stk-line.shift-date <> ?                                                                                                    use-index category no-lock no-error .                                                       if available ub.stk-line then do:                                                                                         create start-stk-line.                                                                                      buffer-copy ub.stk-line to start-stk-line.                                                                  end.
     1069   end.
     1070   else do:
     1071     for each start-stk-line:                                                                                        delete start-stk-line.                                                                                  end.                                                                                                                find last ub.stk-line where ub.stk-line.obj-type    = parobj-type                  and                                                             ub.stk-line.obj-code    = parobj-code                  and                                                             ub.stk-line.artic       = parartic                     and                                                             ub.stk-line.prod-type   = parprod-type                 and                                                             ub.stk-line.prod-code   = parprod-code                 and                                                             ub.stk-line.fact-order <= parfact-order-start  and                                                             ub.stk-line.sum-type    = varsum-type                  and                                                             ub.stk-line.cat-id      = parcat-id                    and                                                             ub.stk-line.shift-date = ?                                                                                                    use-index category no-lock no-error .                                                       if available ub.stk-line then do:                                                                                         create start-stk-line.                                                                                      buffer-copy ub.stk-line to start-stk-line.                                                                  end.
     1072   end.
     1073   if paris-shift then do:
     1074     for each end-stk-line:                                                                                        delete end-stk-line.                                                                                  end.                                                                                                                find last ub.stk-line where ub.stk-line.obj-type    = parobj-type                  and                                                             ub.stk-line.obj-code    = parobj-code                  and                                                             ub.stk-line.artic       = parartic                     and                                                             ub.stk-line.prod-type   = parprod-type                 and                                                             ub.stk-line.prod-code   = parprod-code                 and                                                             ub.stk-line.fact-order <= parfact-order-end  and                                                             ub.stk-line.sum-type    = varsum-type                  and                                                             ub.stk-line.cat-id      = parcat-id                    and                                                             ub.stk-line.shift-date <> ?                                                                                                    use-index category no-lock no-error .                                                       if available ub.stk-line then do:                                                                                         create end-stk-line.                                                                                      buffer-copy ub.stk-line to end-stk-line.                                                                  end.
     1075   end.
     1076   else do:
     1077     for each end-stk-line:                                                                                        delete end-stk-line.                                                                                  end.                                                                                                                find last ub.stk-line where ub.stk-line.obj-type    = parobj-type                  and                                                             ub.stk-line.obj-code    = parobj-code                  and                                                             ub.stk-line.artic       = parartic                     and                                                             ub.stk-line.prod-type   = parprod-type                 and                                                             ub.stk-line.prod-code   = parprod-code                 and                                                             ub.stk-line.fact-order <= parfact-order-end  and                                                             ub.stk-line.sum-type    = varsum-type                  and                                                             ub.stk-line.cat-id      = parcat-id                    and                                                             ub.stk-line.shift-date = ?                                                                                                    use-index category no-lock no-error .                                                       if available ub.stk-line then do:                                                                                         create end-stk-line.                                                                                      buffer-copy ub.stk-line to end-stk-line.                                                                  end.
     1078   end.
     1079   if
     1080      available end-stk-line   and
     1081      (not available start-stk-line or
     1082      start-stk-line.fact-order <> end-stk-line.fact-order) then do:
     1083         create tt-stk-line.
     1084         assign
     1085         tt-stk-line.obj-type       = parobj-type
     1086         tt-stk-line.obj-code       = parobj-code
     1087         tt-stk-line.artic          = parartic
     1088         tt-stk-line.prod-type      = parprod-type
     1089         tt-stk-line.prod-code      = parprod-code
     1090         tt-stk-line.sum-type       = varsum-type
     1091         tt-stk-line.cat-id         = parcat-id
     1092         tt-stk-line.fact-qnty      = (if available end-stk-line then (end-stk-line.fact-qnty      - (if available start-stk-line then start-stk-line.fact-qnty      else 0)) else 0)
     1093         tt-stk-line.sum-base       = (if available end-stk-line then (end-stk-line.sum-base       - (if available start-stk-line then start-stk-line.sum-base       else 0)) else 0)
     1094         tt-stk-line.sum-rubl       = (if available end-stk-line then (end-stk-line.sum-rubl       - (if available start-stk-line then start-stk-line.sum-rubl       else 0)) else 0)
     1095         tt-stk-line.SLT-base       = (if available end-stk-line then (end-stk-line.SLT-base       - (if available start-stk-line then start-stk-line.SLT-base       else 0)) else 0)
     1096         tt-stk-line.SLT-rubl       = (if available end-stk-line then (end-stk-line.SLT-rubl       - (if available start-stk-line then start-stk-line.SLT-rubl       else 0)) else 0)
     1097         tt-stk-line.VAT-base       = (if available end-stk-line then (end-stk-line.VAT-base       - (if available start-stk-line then start-stk-line.VAT-base       else 0)) else 0)
     1098         tt-stk-line.VAT-rubl       = (if available end-stk-line then (end-stk-line.VAT-rubl       - (if available start-stk-line then start-stk-line.VAT-rubl       else 0)) else 0)
     1099         tt-stk-line.excise-base    = (if available end-stk-line then (end-stk-line.excise-base    - (if available start-stk-line then start-stk-line.excise-base    else 0)) else 0)
     1100         tt-stk-line.excise-rubl    = (if available end-stk-line then (end-stk-line.excise-rubl    - (if available start-stk-line then start-stk-line.excise-rubl    else 0)) else 0)
     1101         tt-stk-line.other-base     = (if available end-stk-line then (end-stk-line.other-base     - (if available start-stk-line then start-stk-line.other-base     else 0)) else 0)
     1102         tt-stk-line.other-rubl     = (if available end-stk-line then (end-stk-line.other-rubl     - (if available start-stk-line then start-stk-line.other-rubl     else 0)) else 0)
     1103         tt-stk-line.road-tax-base  = (if available end-stk-line then (end-stk-line.road-tax-base  - (if available start-stk-line then start-stk-line.road-tax-base  else 0)) else 0)
     1104         tt-stk-line.road-tax-rubl  = (if available end-stk-line then (end-stk-line.road-tax-rubl  - (if available start-stk-line then start-stk-line.road-tax-rubl  else 0)) else 0)
     1105         tt-stk-line.transport-base = (if available end-stk-line then (end-stk-line.transport-base - (if available start-stk-line then start-stk-line.transport-base else 0)) else 0)
     1106         tt-stk-line.transport-rubl = (if available end-stk-line then (end-stk-line.transport-rubl - (if available start-stk-line then start-stk-line.transport-rubl else 0)) else 0).
     1107      end.
     1108   end.
     1109   end.
     1110   end procedure.
     1111   define variable vdoc-num        like ub.price-list.doc-num    no-undo .
     1112   define variable vprice-sale     like ub.price-list.price-sale no-undo .
     1113   define variable vroad-tax       as   decimal                  no-undo .
     1114   define variable vexcise         as   decimal                  no-undo .
     1115   define variable acc-other-qnty1 as   decimal                  no-undo .
     1116   define variable acc-other-netto as   decimal                  no-undo .
     1117   define variable mc              like ub.bar-code.b-code       no-undo .
     1118   if MOVING <> yes
     1119   then do:
     1120     return .
     1121   end.
     1122   for each  ub.stk-line no-lock where
     1123             ub.stk-line.obj-type   =      pobj-type           and
     1124             ub.stk-line.obj-code   =      pobj-code           and
     1125             ub.stk-line.fact-order >= prev-fo                 AND
     1126             ub.stk-line.fact-order <= fo                      AND
     1127             ub.stk-line.cat-id     =      '##,##':U      and
     1128             ub.stk-line.sum-type   begins 'adsr':U
     1129     , first ub.goods    no-lock where
     1130             ub.goods.artic     = ub.stk-line.artic     and
     1131             ub.goods.prod-type = ub.stk-line.prod-type and
     1132             ub.goods.prod-code = ub.stk-line.prod-code
     1133    break by ub.stk-line.artic
     1134          by ub.stk-line.prod-type
     1135          by ub.stk-line.prod-code
     1136   :
     1137     if last-of( ub.stk-line.prod-code )
     1138     then do:
     1139   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1140   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     1141     (input  pobj-type
     1142     ,input  pobj-code
     1143     ,input  ub.goods.gds-code
     1144     ,input  0
     1145     ,input  fo
     1146     ,output vdoc-num
     1147     ,output vprice-sale
     1148     ,output vroad-tax
     1149     ,output vexcise
     1150     ) no-error .
     1151       assign
     1152         mc = ub.goods.gds-code
     1153       .
     1154   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1155     (input  ub.goods.gds-code
     1156     ,input  ?
     1157     ,output mc
     1158     )  .
     1159       create t-4 .
     1160       assign
     1161         t-4.gds-code = ub.goods.gds-code
     1162         t-4.main-code = mc
     1163         t-4.artic = ub.goods.artic
     1164         t-4.gds-name = ub.goods.gds-name
     1165         t-4.prod-type = ub.goods.prod-type
     1166         t-4.prod-code = ub.goods.prod-code
     1167         t-4.last-price = vprice-sale
     1168       .
     1169       for each tt-stk-line
     1170       :
     1171         delete tt-stk-line .
     1172       end.
     1173          assign
     1174           acc-other-qnty1 = 0
     1175           acc-other-netto = 0.
     1176       run stk-lnrv in this-procedure
     1177         ( input        pobj-type
     1178         , input        pobj-code
     1179         , input        t-4.artic
     1180         , input        t-4.prod-type
     1181         , input        t-4.prod-code
     1182         , input        prev-fo
     1183         , input        fo
     1184         , input        'adsr':U
     1185         , input        '##,##':U
     1186         , input        yes
     1187         , output table tt-stk-line
     1188         ) no-error .
     1189       for each tt-stk-line
     1190       :
     1191         case substring( tt-stk-line.sum-type, length( 'adsr':U ) + 1 ) :
     1192           when 'es':U     or
     1193           when 'rs':U
     1194           then do:
     1195           end.
     1196           otherwise do:
     1197             assign
     1198               acc-other-qnty1 = acc-other-qnty1 - tt-stk-line.fact-qnty
     1199               acc-other-netto = acc-other-netto - tt-stk-line.sum-base
     1200             .
     1201           end.
     1202         end case.
     1203         delete tt-stk-line .
     1204       end.
     1205       run create-treal-4 in this-procedure
     1206         ( input t-4.gds-code
     1207         , input -1
     1208         , input 0
     1209         , input acc-other-qnty1
     1210         , input acc-other-netto
     1211         , input "Прочий докум.расход"
     1212         , input no
     1213         , input ?
     1214         ) no-error .
     1215     end.
     1216   end.
