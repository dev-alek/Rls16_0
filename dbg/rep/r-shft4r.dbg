       94   procedure create_obj-list :
       95      define input parameter p-obj-type like ub.clients.obj-type no-undo .
       96      define input parameter p-obj-code like ub.clients.obj-code no-undo .
       97      do
       98      on error undo, return error return-value
       99      :
      100         define buffer cli-obj for ub.clients .
      101         define variable p-var as integer no-undo .
      102         define buffer buf_obj-list for obj-list .
      103         find last buf_obj-list  use-index pi no-error .
      104         if available buf_obj-list
      105         then
      106            p-var = buf_obj-list.obj-id + 1.
      107         else
      108            p-var = 1.
      109         find first cli-obj where
      110                   cli-obj.obj-type = p-obj-type
      111               and cli-obj.obj-code = p-obj-code
      112         no-lock no-error.
      113         if available cli-obj
      114         then do:
      115            create buf_obj-list.
      116            assign
      117               buf_obj-list.obj-id   = p-var
      118               buf_obj-list.obj-code = cli-obj.obj-code
      119               buf_obj-list.obj-type = cli-obj.obj-type
      120               buf_obj-list.obj-name = cli-obj.obj-name
      121               buf_obj-list.db-num   = cli-obj.db-num
      122            .
      123         end.
      124      end.
      125   end.
