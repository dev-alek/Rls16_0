      766   define variable var-report-r-b as character no-undo .
      767   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      768   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      769     (output var-report-r-b
      770     )  .
      771   DEFINE STREAM OutStr-html.
      772   DEFINE TEMP-TABLE ttVSD  NO-UNDO
      773    FIELD id           as INTEGER
      774    FIELD db-num       AS INTEGER
      775    FIELD dateTTH      AS DATE
      776    FIELD NomTTH       AS CHAR
      777    FIELD NomTTHpost   AS CHAR
      778    FIELD NomAZS       AS CHAR
      779    FIELD Post         AS CHAR
      780    FIELD artic        AS CHAR
      781    FIELD gdsname      AS CHAR
      782    FIELD prod-code    AS CHAR
      783    FIELD COLobj       AS DEC
      784    FIELD unit-cli     AS CHAR
      785    FIELD UUID         AS CHAR
      786    FIELD statusvsd    AS CHAR
      787    FIELD ojd          AS char
      788    FIELD msg-err         AS char
      789    FIELD vsdtypelbl   AS CHARACTER
      790   .
      791   DEFINE BUFFER bclients FOR clients.
      792   DEFINE VARIABLE v-attr-type AS CHARACTER NO-UNDO.
      793   DEFINE VARIABLE vOjd AS INTEGER   NO-UNDO.
      794   DEFINE VARIABLE vsdsTHObj  AS CLASS vsdsubs.
      795   DEFINE VARIABLE vsdStorage AS CLASS vsdtostorage.
      796   DEFINE VARIABLE vI AS INTEGER NO-UNDO.
      797   vsdsTHObj = NEW vsdsubs ().
      798   vsdStorage = NEW vsdtostorage ().
      799   FOR EACH obj-list:
      800       vsdsTHObj = vsdStorage:getVSDsubs(obj-list.obj-type,obj-list.obj-code,pstatus).
      801       Block-vsd:
      802       DO vi = 1 TO vsdsTHObj:GetItem (vi):
      803           FIND FIRST ttvsd WHERE ttVSD.ID         = vsdsTHObj:VsdObjCurr:ID
      804                            AND ttvsd.db-num       = vsdsTHObj:VsdObjCurr:DBNum
      805               NO-ERROR.
      806           IF AVAIL ttvsd
      807               THEN
      808               NEXT Block-vsd.
      809           FIND FIRST trn-doc WHERE trn-doc.doc-code EQ ENTRY (8,vsdsTHObj:VsdObjCurr:PartKey,chr(3)) NO-LOCK NO-ERROR.
      810       IF NOT AVAIL trn-doc
      811       THEN
      812           NEXT Block-vsd.
      813       IF    trn-doc.doc-date < x-date-start
      814          OR trn-doc.doc-date > x-date-end
      815       THEN
      816           NEXT Block-vsd.
      817           FIND FIRST goods WHERE goods.gds-code EQ vsdsTHObj:VsdObjCurr:GdsCode NO-LOCK NO-ERROR.
      818       IF NOT AVAIL goods THEN NEXT Block-vsd.
      819       CASE  x-SelectGood:
      820           WHEN 4 OR
      821           WHEN 6 OR
      822           WHEN 5 THEN
      823               DO:
      824                   FIND FIRST gds-list
      825                       WHERE gds-list.artic     = goods.artic
      826                         AND gds-list.prod-type = goods.prod-type
      827                         AND gds-list.prod-code = goods.prod-code NO-ERROR .
      828                   IF NOT AVAILABLE gds-list THEN NEXT Block-vsd.
      829               END.
      830           WHEN 1 THEN .
      831        END.
      832        FIND FIRST  clients WHERE clients.obj-type EQ goods.prod-type
      833                     AND clients.obj-code EQ goods.prod-code
      834                     NO-LOCK NO-ERROR.
      835       FIND FIRST  bclients WHERE bclients.obj-type EQ  trn-doc.cli-type
      836           AND bclients.obj-code EQ trn-doc.cli-code
      837           NO-LOCK NO-ERROR.
      838           vOjd =  IF vsdsTHObj:VsdObjCurr:PendingRepayment THEN 0 ELSE TRUNC ((NOW - vsdsTHObj:VsdObjCurr:FactDatetime)/ (1000 * 60 * 60),0).
      839       IF    vOjd >= pTime
      840               OR vsdsTHObj:VsdObjCurr:PendingRepayment
      841       THEN
      842       DO:
      843           CREATE ttvsd.
      844               ttVSD.ID            = vsdsTHObj:VsdObjCurr:ID.
      845               ttvsd.db-num        = vsdsTHObj:VsdObjCurr:DBNum.
      846               ttVSD.UUID       = vsdsTHObj:VsdObjCurr:UUID                     .
      847               ttVSD.msg-err       = vsdsTHObj:VsdObjCurr:MsgErr.
      848               ttVSD.statusvsd  = vsdsTHObj:VsdObjCurr:StatusLbl .
      849               ttvsd.vsdtypelbl    = vsdsTHObj:VsdObjCurr:VSDTypeLbl.
      850               ttVSD.COLobj      = vsdsTHObj:VsdObjCurr:Qnty            .
      851           ASSIGN
      852               ttVSD.dateTTH     = trn-doc.doc-date
      853               ttVSD.NomTTH      = trn-doc.doc-code
      854               ttVSD.NomTTHpost  = trn-doc.rcv-code
      855               ttVSD.NomAZS      = STRING(obj-list.obj-code)
      856               ttVSD.Post        = IF AVAIL bclients
      857                                   THEN bclients.obj-name
      858                                   ELSE ""
      859               ttVSD.artic       = goods.artic
      860               ttVSD.gdsname     = goods.gds-name
      861               ttVSD.prod-code   = IF AVAIL clients
      862                                   THEN clients.obj-name
      863                                   ELSE ""
      864               ttVSD.unit-cli    = goods.unit-cli
      865               ttVSD.ojd        = string (vOjd )
      866               .
      867               RUN gbl/trdcat-v.p
      868                  ( INPUT trn-doc.doc-code
      869                   ,INPUT 'nids':U
      870                   ,OUTPUT ttVSD.NomTTHpost
      871                   ,OUTPUT v-attr-type
      872                  ).
      873        END.
      874       end.
      875   END.
      876   FIND FIRST ttvsd NO-ERROR.
      877   IF NOT AVAIL ttvsd
      878   THEN
      879      MESSAGE "Отчет пуст."
      880      VIEW-AS ALERT-BOX.
      881   ELSE
      882   DO:
      883       RUN prn-lib-get-report-name  IN this-procedure
      884       (INPUT parParentProc, OUTPUT v-report-name).
      885       v-file-name-rep-htm = v-report-name + ".html".
      886       OUTPUT stream OutStr-html to value(v-file-name-rep-htm) convert target 'UTF-8' .
      887       PUT STREAM OutStr-html UNFORMATTED
      888           "<!DOCTYPE HTML>"                                               SKIP
      889           '<html>'                                                        SKIP
      890           '<head>'                                                        SKIP
      891           '  <meta charset="utf-8">'                                      SKIP
      892           '  <style>'                                                     SKIP
      893           '      table ~{ '                                               SKIP
      894           '             border-collapse: collapse;'                       SKIP
      895           '             ~}'                                               SKIP
      896           '       tbody td, th ~{'                                        SKIP
      897           '                 border: 1px solid black;'                     SKIP
      898           '                    ~}'                                        SKIP
      899           '   </style>'                                                   SKIP
      900           '</head>'                                                       SKIP
      901           '<body>'                                                        SKIP
      902           '<TABLE name="1" fit_to_page="true" orientation="landscape">'   SKIP
      903           '<thead>'                                                       SKIP
      904           '  <tr>'                                SKIP
      905           '    <td style="width:  53px;"></td>'   SKIP
      906           '    <td style="width: 106px;"></td>'   SKIP
      907           '    <td style="width: 106px;"></td>'   SKIP
      908           '    <td style="width: 53px;"></td>'    SKIP
      909           '    <td style="width: 200px;"></td>'    SKIP
      910           '    <td style="width: 60px;"></td>'    SKIP
      911           '    <td style="width: 200px;"></td>'    SKIP
      912           '    <td style="width: 200px;"></td>'    SKIP
      913           '    <td style="width: 53px;"></td>'    SKIP
      914           '    <td style="width: 53px;"></td>'    SKIP
      915           '    <td style="width: 100px;"></td>'    SKIP
      916           '    <td style="width: 300px;"></td>'    SKIP
      917           '    <td style="width: 170px;"></td>'    SKIP
      918           '    <td style="width: 80px;"></td>'    SKIP
      919           '    <td style="width: 200px;"></td>'    SKIP
      920           '  </tr>'                               SKIP
      921           '  <tr>'                                                            SKIP
      922           '     <td colspan="13">Отчет с детализацией по накладным c ' + STRING (x-date-start, "99/99/9999")
      923           + " по " +  String(x-date-end,"99/99/9999") +
      924           '</td>'    SKIP
      925           '  </tr>'                                                           SKIP
      926           '</thead>'                                                          SKIP
      927           '<tbody>'                               SKIP
      928           '  <tr>'                                SKIP
      929           '    <th>Дата ТТН</th>'                 SKIP
      930           '    <th>Номер ТТН</th>'                SKIP
      931           '    <th>Номер ТТН поставщика</th>'     SKIP
      932           '    <th>№ АЗС</th>'                    SKIP
      933           '    <th>Поставщик</th>'                SKIP
      934           '    <th>Артикул товара</th>'           SKIP
      935           '    <th>Наименование товара</th>'      SKIP
      936           '    <th>Производитель</th>'            SKIP
      937           '    <th>Кол-во по ВСД</th>'            SKIP
      938           '    <th>Ед.изм.</th>'                  SKIP
      939           '    <th>Тип</th>'                      SKIP
      940           '    <th>Номер ВСД</th>'                SKIP
      941           '    <th>Статус ВСД</th>'               SKIP
      942           '    <th>Ожидает гашения (ч.)</th>'          SKIP
      943       '    <th>Описание ошибки</th>'          SKIP
      944           '  </tr>'                               SKIP
      945           .
      946           FOR EACH ttvsd:
      947               PUT STREAM OutStr-html UNFORMATTED
      948                   '  <tr>' SKIP
      949                   SUBSTITUTE('      <td>&1</td>',          STRING(ttvsd.dateTTH))              SKIP
      950                   SUBSTITUTE('      <td>&1</td>',                 ttvsd.NomTTH)                SKIP
      951                   SUBSTITUTE('      <td>&1</td>',                 ttvsd.NomTTHpost)            SKIP
      952                   SUBSTITUTE('      <td>&1</td>',                 ttvsd.NomAZS)                SKIP
      953                   SUBSTITUTE('      <td text_wrap="true">&1</td>',ttvsd.Post)                  SKIP
      954                   SUBSTITUTE('      <td>&1</td>',                 ttvsd.artic)                 SKIP
      955                   SUBSTITUTE('      <td text_wrap="true">&1</td>',ttvsd.gdsname)               SKIP
      956                   SUBSTITUTE('      <td text_wrap="true">&1</td>',ttvsd.prod-code)             SKIP
      957                   SUBSTITUTE('      <td>&1</td>',       trim( STRING(ttvsd.COLobj,">>>>>>9.999")))               SKIP
      958                   SUBSTITUTE('      <td num="0" val="&1">&1</td>',ttvsd.unit-cli)              SKIP
      959                   SUBSTITUTE('      <td text_wrap="true">&1</td>',ttvsd.vsdtypelbl )           SKIP
      960                   SUBSTITUTE('      <td>&1</td>',                 ttvsd.UUID)                  SKIP
      961                   SUBSTITUTE('      <td>&1</td>',                 ttvsd.statusvsd)             SKIP
      962                   SUBSTITUTE('      <td>&1</td>',                 ttvsd.ojd )                  SKIP
      963                   SUBSTITUTE('      <td text_wrap="true">&1</td>',ttvsd.msg-err )                 SKIP
      964               '</tr>' SKIP
      965               .
      966           END.
      967           PUT STREAM OutStr-html UNFORMATTED
      968           '</tbody>'              SKIP
      969           '<tfoot>' '</tfoot>'    SKIP
      970           '</table>'              SKIP
      971           '</body>'               SKIP
      972           '</html>'               SKIP
      973           .
      974       OUTPUT stream OutStr-html close.
      975       RUN prn-lib-reportviewer-report-name IN this-procedure
      976        (
      977           INPUT this-procedure
