      342   procedure create_obj-list :
      343      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      344      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      345      do
      346      on error undo, return error return-value
      347      :
      348         define buffer cli-obj for ub.clients .
      349         define variable p-var as integer no-undo .
      350         define buffer buf_obj-list for obj-list .
      351         find last buf_obj-list  use-index pi no-error .
      352         if available buf_obj-list
      353         then
      354            p-var = buf_obj-list.obj-id + 1.
      355         else
      356            p-var = 1.
      357         find first cli-obj where
      358                   cli-obj.obj-type = p-obj-type
      359               and cli-obj.obj-code = p-obj-code
      360         no-lock no-error.
      361         if available cli-obj
      362         then do:
      363            create buf_obj-list.
      364            assign
      365               buf_obj-list.obj-id   = p-var
      366               buf_obj-list.obj-code = cli-obj.obj-code
      367               buf_obj-list.obj-type = cli-obj.obj-type
      368               buf_obj-list.obj-name = cli-obj.obj-name
      369               buf_obj-list.db-num   = cli-obj.db-num
      370            .
      371         end.
      372      end.
      373   end.
