      840   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      841   define  stream PrnLibStream.
      842   procedure prn-lib-prn-file :
      843     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      844     define input parameter p-DIsabledoptions as integer no-undo .
      845     define variable v-report-name as character no-undo .
      846     define variable v-user-action as character no-undo .
      847     define variable v-printed     as logical   no-undo .
      848     define variable v-exist       as logical   no-undo .
      849     do
      850       on error undo, return error
      851       :
      852       run prn-lib-get-report-name  in this-procedure (
      853         input parParentProc
      854         ,output v-report-name
      855         ).
      856   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      857   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      858     (input  v-report-name
      859     ,input  2
      860     ,output v-exist
      861     )  .
      862       if NOT v-exist then
      863       DO:
      864         Message
      865           "Нет заданий на печать ! "
      866           view-as alert-box .
      867         Return  .
      868       End.
      869       run gbl/prnfilen.w
      870         (input  ""
      871         ,input  p-DisabledOptions
      872         ,input  string(v-report-name )
      873         ,input  7
      874         ,output v-user-action
      875         ,output v-printed
      876         ) .
      877       if v-printed then
      878       do:
      879         return "YES" .
      880       end.
      881       else
      882       do:
      883         return "NO" .
      884       end.
      885     end.
      886   end procedure.
      887   procedure prn-lib-open-stream :
      888     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      889     define input parameter p-page-size    as integer no-undo .
      890     define input parameter p-is-stream    as logical no-undo .
      891     define input parameter p-append       as logical no-undo .
      892     define variable v-report-name as character no-undo .
      893     do
      894       on error undo, return error
      895       :
      896       run prn-lib-get-report-name  in this-procedure (
      897         input parParentProc
      898         ,output v-report-name
      899         ).
      900       if p-is-stream then
      901       do:
      902         if p-append then
      903         do:
      904           output stream PrnLibStream to value( v-report-name )
      905             page-size value(p-page-size) append .
      906         end.
      907         if not p-append then
      908         do:
      909           output stream PrnLibStream to value( v-report-name )
      910             page-size value(p-page-size) .
      911         end.
      912       end.
      913       if not p-is-stream then
      914       do:
      915         if p-append then
      916         do:
      917           output to value( v-report-name )
      918             page-size value(p-page-size) append .
      919         end.
      920         if not p-append then
      921         do:
      922           output to value( v-report-name )
      923             page-size value(p-page-size) .
      924         end.
      925       end.
      926     end.
      927   end procedure.
      928   procedure prn-lib-open-exp :
      929     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      930     define input parameter p-is-stream    as logical no-undo .
      931     define input parameter p-is-append    as logical no-undo .
      932     define output parameter p-ReportFileName as char init "report" no-undo.
      933     define output parameter p-process as logical no-undo .
      934     define variable glog as logical no-undo .
      935     do
      936       on error undo, return error
      937       :
      938       SYSTEM-DIALOG GET-FILE p-ReportFileName
      939         TITLE      "Укажите путь"
      940         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      941         ASK-OVERWRITE
      942         CREATE-TEST-FILE
      943         SAVE-AS
      944         USE-FILENAME
      945         DEFAULT-EXTENSION "txt"
      946         UPDATE glog
      947         .
      948       if not glog then  return.
      949       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      950       if p-is-stream then
      951       do:
      952         if p-is-append then
      953         do:
      954           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      955         end.
      956         else
      957         do:
      958           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      959         end.
      960       end.
      961       else
      962       do:
      963         if p-is-append then
      964         do:
      965           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      966         end.
      967         else
      968         do:
      969           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      970         end.
      971       end.
      972       p-process = yes.
      973     end.
      974   end procedure.
      975   procedure prn-lib-get-report-name :
      976     define input parameter parParentProc  as widget-handle no-undo.
      977     define output parameter p-report-name as character no-undo .
      978     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      979   end procedure.
      980   procedure prn-lib-reportviewer-report-name :
      981     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      982     define input parameter p-report-name-html as character no-undo .
      983     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      984   end procedure.
      985   procedure prn-lib-reportviewer :
      986     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      987     define input parameter p-report-name-html as character no-undo .
      988     define input parameter p-param        as character no-undo .
      989     define variable v-excel           as character no-undo init 'TRUE' .
      990     define variable v-value-character as character no-undo .
      991     define variable v-value-integer   as character no-undo .
      992     define variable v-value-date      as date      no-undo .
      993     define variable v-value-decimal   as decimal   no-undo .
      994     define variable rep-excel         as logical   no-undo .
      995     define variable excel-string      as character no-undo .
      996     define variable v-param-type      as character no-undo .
      997     define variable v-tth             as handle    no-undo .
      998     run adm/shattri.p (
      999       input "get":U
     1000       ,input  ""
     1001       ,input  0
     1002       ,input  'report-glob':U
     1003       ,input  'rep-excel':U
     1004       ,output v-value-character
     1005       ,output v-value-date
     1006       ,output v-value-decimal
     1007       ,output v-value-integer
     1008       ,output rep-excel
     1009       ,output v-param-type
     1010       ,INPUT-OUTPUT table-handle v-tth
     1011       )  .
     1012     if rep-excel then v-excel = "TRUE" .
     1013     else v-excel = "FALSE" .
     1014     if p-param eq ""
     1015     then
     1016        p-param = "EXCEL:" + v-excel.
     1017     else
     1018        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1019     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1020   end procedure.
     1021   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1022   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
     1023   define new shared variable RepPathName        as character no-undo .
     1024   define new shared variable PrintRubl          as logical   no-undo .
     1025   function diff-list returns character (
     1026     input parfirst-list  as character,
     1027     input parsecond-list as character,
     1028     input pardelim       as character).
     1029     if pardelim = ""
     1030     or pardelim = ?
     1031     then do:
     1032       assign
     1033         pardelim = ","
     1034       .
     1035     end.
     1036     def var ind as integer no-undo .
     1037     def var v-elem as character no-undo .
     1038     def var v-result-list as character no-undo init "".
     1039     def var v-num-parfirst-list as integer no-undo .
     1040     assign
     1041       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
     1042     .
     1043     do ind = 1 to v-num-parfirst-list
     1044     :
     1045       assign
     1046         v-elem = entry(ind, parfirst-list, pardelim)
     1047       .
     1048       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
     1049         assign
     1050           v-result-list = v-result-list
     1051                         + (if v-result-list > "" then pardelim else "")
     1052                         + v-elem
     1053         .
     1054       end.
     1055     end.
     1056     return v-result-list .
     1057   end function.
     1058   function add-list returns character (
     1059    input parfirst-list  as character,
     1060    input parsecond-list as character,
     1061    input pardelim       as character).
     1062     if pardelim = ""
     1063     or pardelim = ?
     1064     then do:
     1065       assign
     1066         pardelim = ","
     1067       .
     1068     end.
     1069     def var ind as integer no-undo .
     1070     def var v-elem as character no-undo .
     1071     def var v-result-list as character no-undo init "".
     1072     def var v-num-parfirst-list as integer no-undo .
     1073     assign
     1074       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
     1075     .
     1076     do ind = 1 to v-num-parfirst-list
     1077     :
     1078       assign
     1079         v-elem = entry(ind, parfirst-list, pardelim)
     1080       .
     1081       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
     1082         assign
     1083           v-result-list = v-result-list
     1084                         + (if v-result-list > "" then pardelim else "")
     1085                         + v-elem
     1086         .
     1087       end.
     1088     end.
     1089     def var v-num-parsecond-list as integer no-undo .
     1090     assign
     1091       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
     1092     .
     1093     do ind = 1 to v-num-parsecond-list
     1094     :
     1095       assign
     1096         v-elem = entry(ind, parsecond-list, pardelim)
     1097       .
     1098       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
     1099         assign
     1100           v-result-list = v-result-list
     1101                         + (if v-result-list > "" then pardelim else "")
     1102                         + v-elem
     1103         .
     1104       end.
     1105     end.
     1106     return v-result-list .
     1107   end function.
     1108   function cross-list returns character (
     1109    input parfirst-list  as character,
     1110    input parsecond-list as character,
     1111    input pardelim       as character).
     1112     if pardelim = ""
     1113     or pardelim = ?
     1114     then do:
     1115       assign
     1116         pardelim = ","
     1117       .
     1118     end.
     1119     def var ind as integer no-undo .
     1120     def var v-elem as character no-undo .
     1121     def var v-result-list as character no-undo init "".
     1122     def var v-num-parfirst-list as integer no-undo .
     1123     assign
     1124       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
     1125     .
     1126     do ind = 1 to v-num-parfirst-list
     1127     :
     1128       assign
     1129         v-elem = entry(ind, parfirst-list, pardelim)
     1130       .
     1131       if lookup(v-elem, v-result-list, pardelim) = 0
     1132       and lookup(v-elem, parsecond-list, pardelim) > 0
     1133       then do:
     1134         assign
     1135           v-result-list = v-result-list
     1136                         + (if v-result-list > "" then pardelim else "")
     1137                         + v-elem
     1138         .
     1139       end.
     1140     end.
     1141     return v-result-list .
     1142   end function.
     1143   function radio-label returns character (
     1144    input par-rs-value  as character,
     1145    input par-rs-radio-buttons as character)
     1146    .
     1147    DEFINE variable v-result-label as character no-undo.
     1148    assign
     1149    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
     1150                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
     1151                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
     1152                             ), par-rs-radio-buttons
     1153                           )
     1154    v-result-label = REPLACE(v-result-label, "&":U, "":U)
     1155    .
     1156   return v-result-label.
     1157   end function.
     1158   function m-radio-label returns character (
     1159    input par-rs-value  as character,
     1160    input par-rs-radio-buttons as character,
     1161    input par-delim as character
     1162    )
     1163    .
     1164    DEFINE variable v-result-label as character no-undo.
     1165    assign
     1166    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
     1167                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
     1168                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
     1169                             ), par-rs-radio-buttons, par-delim
     1170                           )
     1171    v-result-label = REPLACE(v-result-label, "&":U, "":U)
     1172    .
     1173   return v-result-label.
     1174   end function.
     1175   FUNCTION mixlist returns character
     1176   (
     1177    input parfirst-list  as character
     1178    ,input parsecond-list as character
     1179    ,input pardelim       as character
     1180    ,input pardelim-result as character ) :
     1181     if pardelim = ""
     1182     or pardelim = ?
     1183     then do:
     1184       assign
     1185         pardelim = ","
     1186       .
     1187     end.
     1188     def var ind as integer no-undo .
     1189     def var v-elem1 as character no-undo .
     1190     def var v-elem2 as character no-undo .
     1191     def var v-result-list as character no-undo init "".
     1192     do ind = 1 to num-entries(parfirst-list, pardelim)
     1193     :
     1194       assign
     1195         v-elem1 = entry(ind, parfirst-list, pardelim)
     1196         v-elem2 = entry(ind, parsecond-list, pardelim)
     1197       .
     1198         assign
     1199           v-result-list = v-result-list
     1200                         + (if v-result-list > "" then pardelim-result else "")
     1201                         + v-elem1 + pardelim-result + v-elem2
     1202         .
     1203     end.
     1204     return v-result-list .
     1205   END FUNCTION.
     1206   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1207   define variable v-waitfram-action01         as character   no-undo .
     1208   define variable v-waitfram-action02         as character   no-undo .
     1209   define variable v-waitfram-action03         as character   no-undo .
     1210   define variable mWaitFramTextBeg            as character   no-undo.
     1211   define variable mWaitFramTextEnd            as character   no-undo.
     1212   define variable mWaitFramView               as logical     no-undo.
     1213   define variable mWaitProcEvent              as logical     no-undo init yes.
     1214   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1215   define variable mWaitFramStop               as logical     no-undo.
     1216   define variable mWaitFramStopUser           as logical     no-undo.
     1217   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1218   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1219   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1220   define button B-WaitFramStop auto-end-key
     1221        label "Стоп"
     1222        size 10 by 1 tooltip "Остоновить процесс".
     1223   define button B-viewProcInfo
     1224        label "Информация"
     1225        size 15 by 1 tooltip "Информация о процесс".
     1226   define frame waitfram
     1227     v-waitfram-action01 format "x(72)" no-label skip
     1228     v-waitfram-action02 format "x(72)" no-label skip
     1229     v-waitfram-action03 format "x(72)" no-label skip
     1230     B-viewProcInfo
     1231     B-WaitFramStop at row 4 col 30
     1232     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1233     .
     1234   define new global shared variable mBatchMode as logical no-undo init ?.
     1235   define variable mFramBachModHandle as handle no-undo.
     1236   mFramBachModHandle = frame waitfram:handle.
     1237   define variable mFameOldVis as logical no-undo.
     1238   define variable mVisCUrentVin as logical no-undo.
     1239   if session:batch-mode
     1240   then
     1241      mBatchMode = yes.
     1242   if mBatchMode = ? then do:
     1243     mVisCUrentVin = current-window:visible.
     1244     mFameOldVis = mFramBachModHandle:visible.
     1245     mFramBachModHandle:visible  = yes.
     1246     mBatchMode = mFramBachModHandle:visible ne yes.
     1247     mFramBachModHandle:visible = mFameOldVis.
     1248     current-window:visible = mVisCUrentVin.
     1249   end.
     1250    if  log-manager:logfile-name ne ?
     1251     then DO:
     1252         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1253         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1254         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1255     end.
     1256   on choose of B-WaitFramStop in frame waitfram
     1257   do:
     1258     mWaitFramStop = yes.
     1259     mWaitFramStopUser = yes.
     1260   end.
     1261   function waitfram-check-timeout returns logical():
     1262      define variable vtime as int64 no-undo.
     1263      if mWaitFramStopTimeOut
     1264      then
     1265         return yes.
     1266      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1267      if     mWaitFramTimeOut ne ?
     1268         and mWaitFramTimeOut ne 0
     1269         and mWaitFramTimeOut lt vtime
     1270      then do:
     1271         mWaitFramStopTimeOut = yes.
     1272      end.
     1273      return mWaitFramStopTimeOut.
     1274   end.
     1275   procedure waitfram-hide :
     1276     if not session:batch-mode
     1277     then do
     1278     on error undo, return error return-value
     1279     :
     1280       pause 0 before-hide .
     1281       if not mBatchMode then
     1282         hide frame waitfram .
     1283     if     not mWaitFramView
     1284        and mWaitProcEvent
     1285     then
     1286       process events .
     1287     end.
     1288   end procedure.
     1289   procedure waitfram-show :
     1290     define input  parameter p-message as character no-undo .
     1291     define variable v-left-margin as integer   no-undo .
     1292     if not session:batch-mode
     1293     then do
     1294     on error undo, return error return-value
     1295     :
     1296       if length(p-message) <= 70 then do:
     1297         assign
     1298           v-left-margin = integer((70 - length(p-message)) / 2)
     1299         .
     1300         assign
     1301           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1302         .
     1303         assign
     1304           v-waitfram-action01 = " "
     1305           v-waitfram-action02 = " "
     1306                                    + fill(" ", v-left-margin)
     1307                                    + p-message
     1308           v-waitfram-action03 = " "
     1309         .
     1310       end.
     1311       else do:
     1312         define variable vRindex1 as integer no-undo.
     1313         define variable vRindex2 as integer no-undo.
     1314         vRindex1 = r-index(p-message," ",70).
     1315         if vRindex1 = 0
     1316         then
     1317            vRindex1 = 70.
     1318         if length(p-message)  <= vRindex1 + 70 then do:
     1319           assign
     1320             v-waitfram-action01 = " "
     1321             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1322             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1323           .
     1324         end.
     1325         else do:
     1326           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1327           if vRindex2 <= vRindex1
     1328           then
     1329              vRindex2 = vRindex1 + 70.
     1330           assign
     1331             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1332             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1333             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1334           .
     1335         end.
     1336       end.
     1337       B-viewProcInfo:visible   in frame waitfram = no.
     1338       B-viewProcInfo:sensitive in frame waitfram = no.
     1339       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1340       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1341       if  (   mWaitFramView
     1342          or  mWaitProcEvent)
     1343          and not mBatchMode
     1344       then
     1345          display
     1346             v-waitfram-action01 skip
     1347             v-waitfram-action02 skip
     1348             v-waitfram-action03 skip
     1349          with frame waitfram .
     1350       if     mWaitFramView
     1351          then do:
     1352             if     mWaitFramInterval ne ?
     1353                and not mBatchMode
     1354             then
     1355                wait-for go of frame waitfram pause mWaitFramInterval.
     1356          end.
     1357          else
     1358             if     mWaitProcEvent
     1359                and not mBatchMode
     1360             then
     1361                process events .
     1362     end.
     1363   end procedure.
     1364      procedure waitfram-show-this:
     1365         define input  parameter iInterval as int64 no-undo.
     1366         define variable vtime as int64 no-undo.
     1367         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1368         mWaitFramInterval = iInterval.
     1369         run waitfram-show (substitute("&1&2 &3&4" ,
     1370                                       mWaitFramTextBeg ,
     1371                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1372                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1373                                       mWaitFramTextEnd
     1374                                      )
     1375                           ).
     1376      end.
     1377      procedure WaitFramRunPause:
     1378         define input  parameter iInterval as dec no-undo.
     1379         define variable vStart  as datetime-tz no-undo.
     1380         define variable vend    as datetime-tz no-undo.
     1381         define variable vint as int64 no-undo.
     1382         define variable vOk as logical no-undo.
     1383         vStart = now.
     1384         vend   = vStart.
     1385         publish "WaitFramPause" (iInterval,output vOk).
     1386         vend   =  now.
     1387         vint = vend - vStart.
     1388         vint = iInterval - vint / 1000.
     1389         if     not mWaitFramStop
     1390            and (   vint > 0
     1391                 or (    not vOk
     1392                     and iInterval eq ?
     1393                     )
     1394                 )
     1395         then
     1396            run waitfram-show-this (iInterval).
     1397         vend   =  now.
     1398         vint = vend - vStart.
     1399         vint = iInterval - vint / 1000.
     1400         if     not mWaitFramStop
     1401            and vint > 0
     1402         then do:
     1403            run gbl/pause.p (vint * 1000).
     1404         end.
     1405         if iInterval ne ?
     1406         then
     1407            publish "WaitFramStop".
     1408         waitfram-check-timeout().
     1409      end.
     1410      procedure WaitFramWaitFor:
     1411         define input  parameter iInterval as dec no-undo.
     1412         assign
     1413            mWaitFramStartProc   = now
     1414            mWaitFramStopUser    = no
     1415            mWaitFramStopTimeOut = no
     1416         .
     1417         block-wait:
     1418         do while not mWaitFramStop:
     1419            run WaitFramRunPause (iInterval).
     1420            if  waitfram-check-timeout()
     1421            then do:
     1422               leave block-wait.
     1423            end.
     1424         end.
     1425         run waitfram-hide.
     1426      end.
     1427   procedure waitfram-join :
     1428     define input  parameter p-line-1  as character no-undo .
     1429     define input  parameter p-line-2  as character no-undo .
     1430     define input  parameter p-line-3  as character no-undo .
     1431     define output parameter p-message as character no-undo .
     1432     do
     1433     on error undo, return error return-value
     1434     :
     1435       assign
     1436         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1437                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1438                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1439       .
     1440     end.
     1441   end procedure.
     1442   function waitfram-join-function returns character
     1443     (input p-line-1 as character
     1444     ,input p-line-2 as character
     1445     ,input p-line-3 as character
     1446     ).
     1447     define variable v-message as character no-undo .
     1448     run waitfram-join in this-procedure
     1449       (input  p-line-1
     1450       ,input  p-line-2
     1451       ,input  p-line-3
     1452       ,output v-message
     1453       ) .
     1454     return v-message .
     1455   end function .
     1456   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1457   FUNCTION gbclcode-is-this-db-code returns logical ( input p-db-num as integer
     1458                                                       ,input p-range-type as character
     1459                                                       ,input p-code as integer):
     1460   define variable v-seq-val as integer no-undo .
     1461   define buffer buf_code-range for ub.code-range.
     1462   find first buf_code-range no-lock where
     1463             buf_code-range.db-num = p-db-num
     1464       and  buf_code-range.range-type = p-range-type
     1465       and  buf_code-range.stts = 'u'
     1466       and buf_code-range.first-code <= p-code
     1467       and buf_code-range.last-code >= p-code no-error .
     1468   if available buf_code-range then return yes.
     1469   CASE p-range-type:
     1470     when 'pngb':U then do:
     1471       v-seq-val = current-value(s-pngb-code, ub).
     1472     end.
     1473     when 'fmgb':U then do:
     1474       v-seq-val = current-value(s-fmgb-code, ub).
     1475     end.
     1476   END CASE.
     1477   if p-code <= v-seq-val then do:
     1478     find first buf_code-range no-lock where
     1479               buf_code-range.db-num = p-db-num
     1480         and  buf_code-range.range-type = p-range-type
     1481         and  buf_code-range.stts = 'a'
     1482         and buf_code-range.first-code <= p-code
     1483         no-error .
     1484    if available buf_code-range then return yes.
     1485   end.
     1486   find first buf_code-range no-lock where
     1487             buf_code-range.db-num = p-db-num
     1488       and  buf_code-range.range-type = p-range-type
     1489       and  buf_code-range.stts = 'f'
     1490       and buf_code-range.first-code <= p-code
     1491       and buf_code-range.last-code >= p-code
     1492       no-error .
     1493   if available buf_code-range then return yes.
     1494   return no.
     1495   END FUNCTION.
     1496   FUNCTION gbclcode-is-this-db-code-short returns logical ( input p-db-num as integer
     1497                                                       ,input p-range-type as character
     1498                                                       ,input p-code as integer):
     1499   define variable v-seq-val as integer no-undo .
     1500   define buffer buf_code-range for ub.code-range.
     1501   CASE p-range-type:
     1502     when 'pngb':U then do:
     1503       v-seq-val = current-value(s-pngb-code, ub).
     1504     end.
     1505     when 'fmgb':U then do:
     1506       v-seq-val = current-value(s-fmgb-code, ub).
     1507     end.
     1508   END CASE.
     1509   if p-code <= v-seq-val then do:
     1510     find first buf_code-range no-lock where
     1511               buf_code-range.db-num = p-db-num
     1512         and  buf_code-range.range-type = p-range-type
     1513         and buf_code-range.first-code <= p-code
     1514         and buf_code-range.last-code >= p-code no-error .
     1515     if available buf_code-range then return yes.
     1516   end.
     1517   return no.
     1518   END FUNCTION.
     1519   FUNCTION gbclcode-is-this-db-role returns integer ( input p-role as character
     1520                                                       ,input p-db-num as integer
     1521                                                       ,input p-staff-code as integer
     1522                                                       ,input p-date as date
     1523                                                        ):
     1524   define buffer buf_staff for ub.staff.
     1525   if p-date = ? then do:
     1526     p-date = today .
     1527   end.
     1528   find first buf_staff no-lock where
     1529             buf_staff.role = p-role
     1530         and buf_staff.role-level = 'db':U
     1531         and buf_staff.db-num = p-db-num
     1532         and buf_staff.staff-code = p-staff-code
     1533         and buf_staff.date-end >= p-date use-index pi  no-error .
     1534   if available buf_staff then do:
     1535     return buf_staff.psn-code.
     1536   end.
     1537   return 0.
     1538   end FUNCTION.
     1539   FUNCTION gbclcode-get-this-db-first-role returns integer ( input p-role as character
     1540                                                             ,input p-db-num as integer
     1541                                                             ,input p-date as date
     1542                                                                 ):
     1543   define buffer buf_staff for ub.staff.
     1544   define buffer buf2_staff for ub.staff.
     1545   if p-date = ? then do:
     1546     p-date = today .
     1547   end.
     1548   for each  buf_staff no-lock where
     1549             buf_staff.role = p-role
     1550         and buf_staff.db-num = p-db-num,
     1551   first buf2_staff no-lock where
     1552         buf2_staff.role = p-role
     1553     and buf2_staff.role-level = 'db':U
     1554     and buf2_staff.staff-code = buf_staff.staff-code
     1555     and buf2_staff.date-start <= p-date
     1556     and buf2_staff.date-end >= p-date
     1557   by buf_staff.staff-code
     1558   by date-start descending:
     1559     return buf_staff.staff-code.
     1560   end.
     1561   end FUNCTION.
     1562   FUNCTION gbclcode-get-db-role returns integer ( input p-role as character
     1563                                                  ,input p-db-num as integer
     1564                                                  ,input p-psn-code as integer
     1565                                                  ,input p-date as date
     1566                                                  ,output p-c-password as character
     1567                                                        ):
     1568   define buffer buf_staff for ub.staff.
     1569   if p-date = ? then do:
     1570     p-date = today .
     1571   end.
     1572   find first buf_staff no-lock where
     1573             buf_staff.role = p-role
     1574         and buf_staff.role-level = 'db':U
     1575         and buf_staff.db-num = p-db-num
     1576        and buf_staff.date-end >= p-date
     1577        and buf_staff.psn-code = p-psn-code use-index irole-psn no-error .
     1578   if available buf_staff
     1579   then do:
     1580     assign
     1581     p-c-password = buf_staff.password.
     1582     return buf_staff.staff-code.
     1583   end.
     1584   p-c-password = ''.
     1585   return 0.
     1586   end FUNCTION.
     1587   FUNCTION gbclcode-is-psn-role returns integer (
     1588                                                 input p-role as character
     1589                                                 ,input p-psn-code as integer
     1590                                                 ,input p-date as date
     1591                                                     ):
     1592   define buffer buf_staff for ub.staff.
     1593   if p-date = ? then do:
     1594     p-date = today .
     1595   end.
     1596   for each buf_staff no-lock where
     1597             buf_staff.psn-code = p-psn-code
     1598        and  buf_staff.role = p-role
     1599   by buf_staff.role-level
     1600   by buf_staff.date-start
     1601        :
     1602     if  buf_staff.date-start <= p-date and
     1603     buf_staff.date-end >= p-date  then do:
     1604       return buf_staff.staff-code.
     1605     end.
     1606   end.
     1607   return 0.
     1608   end FUNCTION.
     1609   FUNCTION gbclcode-get-role-name returns character ( input p-role as character):
     1610   define variable v-role-name as character no-undo .
     1611   assign
     1612   v-role-name = entry (lookup (p-role, 'C,S':U) + 1, ',':U + 'Кассир,Продавец':U)
     1613   no-error .
     1614   return v-role-name.
     1615   END.
     1616   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1617   FUNCTION gbclcode-get-position returns character ( input p-role as character
     1618                                                     ,input p-role-level as character
     1619                                                     ,input p-work-place as character
     1620                                                     ,input p-staff-code as integer
     1621                                                                ):
     1622   define variable v-role-name as character no-undo .
     1623   define variable v-role-level as character no-undo .
     1624   define variable v-staff-code as integer no-undo .
     1625   assign
     1626   v-role-name = entry (lookup (p-role, 'C,S':U) + 1, ',':U + 'Кассир,Продавец':U)
     1627   v-role-level = substitute("&1 &2", entry (lookup (p-role-level, 'global,db,firm,object':U) + 1, ',':U + 'Глобально,БД,Фирма,Объект':U) , p-work-place)
     1628   v-staff-code = p-staff-code
     1629   no-error .
     1630   return substitute("&1, &2, Код &3"
     1631                   ,v-role-name
     1632                   ,v-role-level
     1633                   ,(if p-staff-code = 0 then chr(63) else string(p-staff-code))).
     1634   END.
     1635   FUNCTION gbclcode-get-work-place returns character (
     1636                                                   input p-role as character
     1637                                                  ,input p-role-level as character
     1638                                                  ,input p-db-num as integer
     1639                                                  ,input p-host-code as integer
     1640                                                  ,input p-obj-type as character
     1641                                                  ,input p-obj-code as integer
     1642                                                  ) :
     1643   define variable v-work-place as character no-undo .
     1644   define variable v-obj-type as character no-undo .
     1645     case p-role-level:
     1646       when 'db':U then do:
     1647         v-work-place = string(p-db-num, "99999").
     1648       end.
     1649       when 'firm':U then do:
     1650         v-work-place = string(p-host-code, "99999").
     1651       end.
     1652       when 'object':U then do:
     1653         assign
     1654         v-work-place = p-obj-type + string(p-obj-code, "999999999")
     1655         .
     1656       end.
     1657     END CASE.
     1658     return v-work-place.
     1659   END FUNCTION.
     1660   FUNCTION gbclcode-get-level-last-code returns integer (
     1661                                                           input p-role as character
     1662                                                         , input p-role-level as character
     1663                                                         , input p-work-place as character
     1664                                                         , input p-date-start as date
     1665                                                         ):
     1666   DEFINE VARIABLE v-today as date no-undo .
     1667   define buffer buf_staff for ub.staff.
     1668   if p-work-place = chr(63) then return ?.
     1669   if p-date-start = ? then do:
     1670     v-today = today .
     1671   end.
     1672   else do:
     1673     v-today = p-date-start.
     1674   end.
     1675   find last buf_staff no-lock where
     1676             buf_staff.role = p-role
     1677        and  buf_staff.role-level = p-role-level
     1678        and  buf_staff.work-place = p-work-place
     1679        and  buf_staff.date-start <= v-today + 1
     1680        and  buf_staff.date-end >= v-today + 1
     1681        use-index pi  no-error .
     1682   if available buf_staff
     1683   then return buf_staff.staff-code.
     1684   return 0.
     1685   end FUNCTION.
     1686   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1687     define variable v-cntxt-db-num        as integer   no-undo .
     1688     define variable v-cntxt-userid        as character no-undo .
     1689     define variable v-cntxt-level         as character no-undo .
     1690     define variable v-cntxt-host-code-obj as integer   no-undo .
     1691     define variable v-cntxt-obj-type      as character no-undo .
     1692     define variable v-cntxt-obj-code      as integer   no-undo .
     1693     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1694     define variable v-cntxt-is-admin      as logical   no-undo .
     1695   define temp-table tt-cshr no-undo
     1696   field cashier as integer
     1697   field psn-code as integer
     1698   index pi is unique primary
     1699   cashier
     1700   psn-code
     1701   index ipsn psn-code.
     1702   define variable State-source as Widget-Handle.
     1703   define variable cash-recids as char no-undo .
     1704   define variable cash-nums as char no-undo .
     1705   define variable rec-list as char no-undo .
     1706   define variable str-buf as char no-undo .
     1707   define variable FineDate      as log no-undo .
     1708   define variable stat      as log no-undo .
     1709   define variable cas-shft as logical no-undo.
     1710   define variable cas-num as integer no-undo.
     1711   define variable found as logical no-undo.
     1712   define variable ii as integer no-undo .
     1713   define variable obj-amount as integer no-undo .
     1714   define buffer cli-obj  for ub.clients .
     1715   define buffer b-chk-gds  for ub.chk-gds .
     1716   define temp-table cash-stat no-undo
     1717   field   obj-attr as char
     1718   field   b-code like ub.chk-gds.b-code
     1719   field   grp-code like ub.chk-gds.grp-code
     1720   field   cashier   like ub.chk-doc.cashier
     1721   field   psn-code  like ub.chk-doc.cashier-psn-code
     1722   field   qnty        as  decimal
     1723   field   sum        as  decimal
     1724   field   count        as  integer
     1725   field   out   as log
     1726   field   ret   as log
     1727   index   p1  is primary  b-code obj-attr
     1728   index   p2              grp-code obj-attr
     1729   index   p3
     1730   cashier                ascending
     1731   psn-code               ascending
     1732   obj-attr               ascending
     1733   b-code                 descending
     1734   grp-code               ascending
     1735       .
     1736   DEFINE VARIABLE ByOperations AS INTEGER
     1737        VIEW-AS RADIO-SET VERTICAL
     1738        RADIO-BUTTONS
     1739             "Продажи", 1,
     1740   "Возвраты", -1,
     1741   "Продажи + возвраты", 0
     1742        SIZE 21.38 BY 3
     1743        BGCOLOR 8 FGCOLOR 0  NO-UNDO.
     1744   DEFINE VARIABLE SelectCashiers AS CHARACTER
     1745        VIEW-AS RADIO-SET HORIZONTAL
     1746        RADIO-BUTTONS
     1747             "все", "1",
     1748   "Выборочно", "2"
     1749        SIZE 21 BY 1
     1750        BGCOLOR 8 FGCOLOR 0  NO-UNDO.
     1751   DEFINE VARIABLE WithCashiers AS LOGICAL INITIAL yes
     1752        VIEW-AS RADIO-SET VERTICAL
     1753        RADIO-BUTTONS
     1754             "Детально", yes,
     1755   "Суммарно", no
     1756        SIZE 13.5 BY 2
     1757        BGCOLOR 8 FGCOLOR 0  NO-UNDO.
     1758   DEFINE VARIABLE WithGoods AS LOGICAL INITIAL yes
     1759        VIEW-AS RADIO-SET VERTICAL
     1760        RADIO-BUTTONS
     1761             "Потоварно", yes,
     1762   "Только итоги", no
     1763        SIZE 15.75 BY 1.71
     1764        BGCOLOR 8 FGCOLOR 0  NO-UNDO.
     1765   DEFINE VARIABLE WithoutObjects AS LOGICAL INITIAL yes
     1766        VIEW-AS RADIO-SET VERTICAL
     1767        RADIO-BUTTONS
     1768             "Суммарно", yes,
     1769   "Пообъектно", no
     1770        SIZE 14.5 BY 1.71
     1771        BGCOLOR 8 FGCOLOR 0  NO-UNDO.
     1772   DEFINE RECTANGLE RECT-cashiers
     1773        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1774        SIZE 36.5 BY 5.21.
     1775   DEFINE RECTANGLE RECT-checks
     1776        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1777        SIZE 36.5 BY 5.92.
     1778   DEFINE RECTANGLE RECT-totals
     1779        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1780        SIZE 17.75 BY 11.29.
     1781   DEFINE VARIABLE ByGoods AS LOGICAL INITIAL yes
     1782        LABEL "Товарные"
     1783        VIEW-AS TOGGLE-BOX
     1784        SIZE 12.13 BY .92
     1785        BGCOLOR 8 FGCOLOR 0  NO-UNDO.
     1786   DEFINE VARIABLE BySums AS LOGICAL INITIAL no
     1787        LABEL "Суммовые"
     1788        VIEW-AS TOGGLE-BOX
     1789        SIZE 12.5 BY .92
     1790        BGCOLOR 8 FGCOLOR 0  NO-UNDO.
     1791   DEFINE FRAME F-Main
     1792        WithCashiers AT ROW 3.79 COL 40 NO-LABEL
     1793        SelectCashiers AT ROW 3.88 COL 5.38 NO-LABEL
     1794        WithGoods AT ROW 7.17 COL 40 NO-LABEL
     1795        ByOperations AT ROW 8.54 COL 2.88 NO-LABEL
     1796        ByGoods AT ROW 8.63 COL 25.13
     1797        BySums AT ROW 9.88 COL 25.25
     1798        WithoutObjects AT ROW 10.29 COL 40 NO-LABEL
     1799        "По объектам :" VIEW-AS TEXT
     1800             SIZE 14.25 BY .92 AT ROW 9.08 COL 39.88
     1801             BGCOLOR 8 FGCOLOR 4
     1802        "Просмотреть операции ( чеки ):" VIEW-AS TEXT
     1803             SIZE 30.25 BY .92 AT ROW 7.17 COL 4
     1804             BGCOLOR 8 FGCOLOR 4
     1805        "По товарам :" VIEW-AS TEXT
     1806             SIZE 13.5 BY .92 AT ROW 6.04 COL 39.88
     1807             BGCOLOR 8 FGCOLOR 4
     1808        "Кассиры :" VIEW-AS TEXT
     1809             SIZE 10.25 BY .92 AT ROW 2.54 COL 5
     1810             BGCOLOR 8 FGCOLOR 4
     1811        "По кассирам :" VIEW-AS TEXT
     1812             SIZE 13.63 BY .92 AT ROW 2.75 COL 39.88
     1813             BGCOLOR 8 FGCOLOR 4
     1814        "Итоги :" VIEW-AS TEXT
     1815             SIZE 8.13 BY .92 AT ROW 1.58 COL 42.25
     1816             BGCOLOR 8 FGCOLOR 4
     1817        RECT-totals AT ROW 1.13 COL 39.13
     1818        RECT-cashiers AT ROW 1.17 COL 1.75
     1819        RECT-checks AT ROW 6.5 COL 1.63
     1820       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
     1821            SIDE-LABELS NO-UNDERLINE THREE-D
     1822            AT COL 1 ROW 1
     1823            SIZE 56.88 BY 11.83.
     1824   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     1825   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     1826   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     1827   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     1828   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     1829   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     1830   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     1831   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     1832       ASSIGN adm-object-hdl = FRAME F-Main:HANDLE.
     1833   RUN ensure-broker.
     1834   THIS-PROCEDURE:ADM-DATA =
     1835        'ADM1.1~`':U +
     1836        'SmartObject~`':U +
     1837        'FRAME~`':U +
     1838        'NO ~`':U +
     1839        '~`':U +
     1840        '~`':U +
     1841        '~`':U +
     1842        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     1843           + "~`":U +
     1844        'Layout,Hide-on-Init~`':U +
     1845        '~`':U +
     1846        '~`':U +
     1847        '~`~`~`~`~`~`~`~`~`~`~`':U +
     1848        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1849            THEN "^^":U
     1850        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1851             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1852   PROCEDURE adm-apply-entry :
     1853     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1854   END PROCEDURE.
     1855   PROCEDURE adm-destroy :
     1856    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1857   END PROCEDURE.
     1858   PROCEDURE adm-disable :
     1859       DISABLE RECT-totals RECT-cashiers RECT-checks WithCashiers SelectCashiers WithGoods ByOperations WithoutObjects WITH FRAME F-Main.
     1860       RUN dispatch ('disable-fields':U).
     1861       RUN set-attribute-list ('ENABLED=no':U).
     1862       RETURN.
     1863   END PROCEDURE.
     1864   PROCEDURE adm-edit-attribute-list :
     1865         RUN adm/support/contnrd.w (INPUT THIS-PROCEDURE).
     1866         RETURN.
     1867   END PROCEDURE.
     1868   PROCEDURE adm-enable :
     1869       ENABLE UNLESS-HIDDEN RECT-totals RECT-cashiers RECT-checks WithCashiers SelectCashiers WithGoods ByOperations WithoutObjects WITH FRAME F-Main.
     1870       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     1871       RUN set-attribute-list ('ENABLED=yes':U).
     1872       RETURN.
     1873   END PROCEDURE.
     1874   PROCEDURE adm-exit :
     1875        RUN notify ('exit':U).
     1876     RETURN.
     1877   END PROCEDURE.
     1878   PROCEDURE adm-hide :
     1879     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1880   END PROCEDURE.
     1881   PROCEDURE adm-initialize :
     1882     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1883   END PROCEDURE.
     1884   PROCEDURE adm-show-errors :
     1885       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1886       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1887           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1888       END.
     1889       RETURN.
     1890   END PROCEDURE.
     1891   PROCEDURE adm-UIB-mode :
     1892     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1893   END PROCEDURE.
     1894   PROCEDURE adm-view :
     1895     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1896   END PROCEDURE.
     1897   PROCEDURE dispatch :
     1898       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1899       RUN broker-dispatch IN adm-broker-hdl
     1900           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1901       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1902   END PROCEDURE.
     1903   PROCEDURE ensure-broker :
     1904   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1905   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1906   DO:
     1907       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1908       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1909   END.
     1910   END PROCEDURE.
     1911   PROCEDURE get-attribute :
     1912     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1913     RUN broker-get-attribute IN adm-broker-hdl
     1914         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1915     RETURN RETURN-VALUE.
     1916   END PROCEDURE.
     1917   PROCEDURE get-attribute-list :
     1918     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1919     RUN broker-get-attribute-list IN adm-broker-hdl
     1920         (INPUT THIS-PROCEDURE,
     1921          INPUT ?,
     1922          OUTPUT p-attr-list) NO-ERROR.
     1923     RETURN.
     1924   END PROCEDURE.
     1925   PROCEDURE new-state :
     1926     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1927     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1928     RETURN.
     1929   END PROCEDURE.
     1930   PROCEDURE notify :
     1931     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1932     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1933     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1934         RETURN "ADM-ERROR":U.
     1935     RETURN.
     1936   END PROCEDURE.
     1937   PROCEDURE set-attribute-list :
     1938     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1939     RUN ensure-broker.
     1940     RUN broker-set-attribute-list IN adm-broker-hdl
     1941         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1942     RETURN.
     1943   END PROCEDURE.
     1944   PROCEDURE set-position :
     1945       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1946       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1947       IF VALID-HANDLE(adm-object-hdl) THEN
     1948       DO:
     1949           DEFINE VARIABLE parent-hdl AS HANDLE NO-UNDO.
     1950           IF adm-object-hdl:TYPE = "WINDOW":U THEN
     1951           DO:
     1952             IF p-row = 0 THEN p-row =
     1953               (SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2.
     1954             IF p-col = 0 THEN p-col =
     1955               (SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2.
     1956           END.
     1957           ELSE IF adm-object-hdl:TYPE = "DIALOG-BOX":U THEN
     1958           DO:
     1959             parent-hdl = adm-object-hdl:PARENT.
     1960             IF p-row = 0 THEN p-row =
     1961               ((SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2) -
     1962                 parent-hdl:ROW.
     1963             IF p-col = 0 THEN p-col =
     1964               ((SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2) -
     1965                 parent-hdl:COL.
     1966           END.
     1967           IF p-row GE 0 AND p-row < 1 THEN p-row = 1.
     1968           IF p-col GE 0 AND p-col < 1 THEN p-col = 1.
     1969         ASSIGN adm-object-hdl:ROW    =   p-row
     1970                adm-object-hdl:COLUMN =   p-col.
     1971       END.
     1972       RETURN.
     1973   END PROCEDURE.
     1974   RUN set-attribute-list ("CURRENT-PAGE=0,ADM-OBJECT-HANDLE=":U +
     1975       STRING(adm-object-hdl)).
     1976   PAUSE 0 BEFORE-HIDE.
     1977   PROCEDURE adm-change-page :
     1978     RUN broker-change-page IN adm-broker-hdl (INPUT THIS-PROCEDURE) NO-ERROR.
     1979     END PROCEDURE.
     1980   PROCEDURE delete-page :
     1981     DEFINE INPUT PARAMETER p-page# AS INTEGER NO-UNDO.
     1982     RUN broker-delete-page IN adm-broker-hdl
     1983         (INPUT THIS-PROCEDURE, INPUT p-page#).
     1984     END PROCEDURE.
     1985   PROCEDURE init-object :
     1986     DEFINE INPUT PARAMETER  p-proc-name   AS CHARACTER NO-UNDO.
     1987     DEFINE INPUT PARAMETER  p-parent-hdl  AS HANDLE    NO-UNDO.
     1988     DEFINE INPUT PARAMETER  p-attr-list   AS CHARACTER NO-UNDO.
     1989     DEFINE OUTPUT PARAMETER p-proc-hdl    AS HANDLE    NO-UNDO.
     1990     RUN broker-init-object IN adm-broker-hdl
     1991         (INPUT THIS-PROCEDURE, INPUT p-proc-name, INPUT p-parent-hdl,
     1992          INPUT p-attr-list, OUTPUT p-proc-hdl) NO-ERROR.
     1993     RETURN.
     1994   END PROCEDURE.
     1995   PROCEDURE init-pages :
     1996     DEFINE INPUT PARAMETER p-page-list      AS CHARACTER NO-UNDO.
     1997     RUN broker-init-pages IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1998         INPUT p-page-list) NO-ERROR.
     1999     END PROCEDURE.
     2000   PROCEDURE select-page :
     2001     DEFINE INPUT PARAMETER p-page#     AS INTEGER   NO-UNDO.
     2002     RUN broker-select-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     2003         INPUT p-page#) NO-ERROR.
     2004     END PROCEDURE.
     2005   PROCEDURE view-page :
     2006     DEFINE INPUT PARAMETER p-page#      AS INTEGER   NO-UNDO.
     2007     RUN broker-view-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     2008         INPUT p-page#).
     2009     END PROCEDURE.
     2010   ASSIGN
     2011          ByGoods:HIDDEN IN FRAME F-Main           = TRUE.
     2012   ASSIGN
     2013          BySums:HIDDEN IN FRAME F-Main           = TRUE.
     2014   ON VALUE-CHANGED OF ByOperations IN FRAME F-Main
     2015   DO:
     2016       assign ByOperations .
     2017   END.
     2018   ON VALUE-CHANGED OF SelectCashiers IN FRAME F-Main
     2019   DO:
     2020   define buffer buf_staff for ub.staff.
     2021     for each tt-cshr:
     2022      delete tt-cshr.
     2023     end.
     2024     assign SelectCashiers .
     2025     if SelectCashiers = 'все':U then do:
     2026       create tt-cshr.
     2027       assign
     2028       tt-cshr.psn-code = - 1
     2029       tt-cshr.cashier = 0
     2030       .
     2031     end.
     2032     else do:
     2033       cash-recids = "" .
     2034       run ref/staffs.w ( input my-handle
     2035                   , input "b-sel,b-mark"
     2036                   , input 'C':U
     2037                   , input (if v-cntxt-db-num = 0 then ? else v-cntxt-db-num)
     2038                   , input 0
     2039                   , output cash-recids ) .
     2040       if cash-recids = "" then do:
     2041          SelectCashiers = 'все':U .
     2042          DISPLAY
     2043          SelectCashiers
     2044          with frame F-Main .
     2045       end.
     2046       else do:
     2047         DO ii = 1 to num-entries( cash-recids ) :
     2048            FIND FIRST buf_staff no-lock WHERE
     2049                         recid( buf_staff ) = integer( entry( ii, cash-recids ) ) .
     2050            find first tt-cshr where
     2051                       tt-cshr.cashier = buf_staff.staff-code
     2052                  and  tt-cshr.psn-code = buf_staff.psn-code no-error.
     2053            if not available tt-cshr then do:
     2054               create tt-cshr.
     2055               assign
     2056               tt-cshr.cashier  = buf_staff.staff-code
     2057               tt-cshr.psn-code = buf_staff.psn-code
     2058               .
     2059               release tt-cshr.
     2060               create tt-cshr.
     2061               assign
     2062               tt-cshr.cashier = buf_staff.staff-code
     2063               tt-cshr.psn-code = 0
     2064               .
     2065               release tt-cshr.
     2066            end.
     2067         END .
     2068       end.
     2069     end.
     2070   END.
     2071   ON VALUE-CHANGED OF WithCashiers IN FRAME F-Main
     2072   DO:
     2073       assign WithCashiers .
     2074   END.
     2075   ON VALUE-CHANGED OF WithGoods IN FRAME F-Main
     2076   DO:
     2077       assign WithGoods .
     2078   END.
     2079   if not this-procedure :persistent
     2080   then do:
     2081     message
     2082       vss-workfile vss-revision vss-description skip
     2083       "Ошибка при запуске процедуры" skip
     2084       "Данную процедуру следует запускать только с параметром persistent" skip
     2085       view-as alert-box error .
     2086     undo, return error .
     2087   end.
     2088   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2089     run mainmenu_getcntxt in my-handle
     2090       (output v-cntxt-db-num
     2091       ,output v-cntxt-userid
     2092       ,output v-cntxt-level
     2093       ,output v-cntxt-host-code-obj
     2094       ,output v-cntxt-obj-type
     2095       ,output v-cntxt-obj-code
     2096       ,output v-cntxt-db-num-obj
     2097       ,output v-cntxt-is-admin
     2098       ) .
     2099   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2100   PROCEDURE no-benq.
     2101   DEFINE OUTPUT PARAMETER found as logical init no.
     2102   define buffer buf_chk-doc for ub.chk-doc.
     2103   FOR EACH obj-list WHERE
     2104           obj-list.obj-type = 'маг':U NO-LOCK :
     2105     CASE X-Radio-Task > 1 :
     2106       WHEN YES THEN DO:
     2107         FOR EACH buf_chk-doc NO-LOCK WHERE
     2108                 buf_chk-doc.obj-type = obj-list.obj-type AND
     2109                 buf_chk-doc.obj-code = obj-list.obj-code AND
     2110                 (
     2111                   buf_chk-doc.shift-date >= X-date-start AND
     2112                   buf_chk-doc.shift-date <= X-date-end)
     2113                   AND
     2114                   (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     2115           IF X-Radio-Task = 3 AND
     2116           ((buf_chk-doc.shift-date = X-date-start AND buf_chk-doc.shift-num < X-shift-Start) OR
     2117             (buf_chk-doc.shift-date = X-date-end AND  buf_chk-doc.shift-num > X-shift-End) ) THEN NEXT.
     2118           IF X-Radio-Task = 4 AND
     2119           (buf_chk-doc.shift-num <> X-shift-Alone ) THEN NEXT.
     2120           found = yes.
     2121           return.
     2122         END.
     2123       END.
     2124       WHEN NO THEN DO:
     2125         FOR EACH buf_chk-doc NO-LOCK WHERE
     2126               buf_chk-doc.obj-type = obj-list.obj-type AND
     2127               buf_chk-doc.obj-code = obj-list.obj-code AND
     2128               buf_chk-doc.chk-date >= X-date-start AND
     2129               buf_chk-doc.chk-date <= X-date-end   AND
     2130               (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     2131           found = yes.
     2132           return.
     2133         END.
     2134        END.
     2135      END CASE.
     2136    END.
     2137   END PROCEDURE.
     2138   PROCEDURE no-benqi.
     2139   DEFINE OUTPUT PARAMETER found as logical init no.
     2140   define buffer buf_chk-doc for ub.chk-doc.
     2141   define buffer buf_inkas for ub.inkas.
     2142   FOR EACH obj-list WHERE
     2143         obj-list.obj-type = 'маг':U NO-LOCK :
     2144     CASE X-Radio-Task > 1 :
     2145       WHEN YES THEN DO:
     2146         FOR EACH buf_chk-doc No-LOCK WHERE
     2147                 buf_chk-doc.obj-type = obj-list.obj-type AND
     2148                 buf_chk-doc.obj-code = obj-list.obj-code AND
     2149                 (
     2150                   buf_chk-doc.shift-date >= X-date-start AND
     2151                   buf_chk-doc.shift-date <= X-date-end)
     2152                   AND
     2153                   buf_Chk-doc.out-code = ? AND
     2154                   (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     2155           IF X-Radio-Task = 3 AND
     2156           ((buf_chk-doc.shift-date = X-date-start AND buf_chk-doc.shift-num < X-shift-Start) OR
     2157             (buf_chk-doc.shift-date = X-date-end AND  buf_chk-doc.shift-num > X-shift-End) ) THEN NEXT.
     2158           IF X-Radio-Task = 4 AND
     2159           (buf_chk-doc.shift-num <> X-shift-Alone ) THEN NEXT.
     2160           found = yes.
     2161           return.
     2162         END.
     2163         FOR EACH buf_inkas No-LOCK WHERE
     2164                   buf_inkas.obj-type = obj-list.obj-type AND
     2165                   buf_inkas.obj-code = obj-list.obj-code AND
     2166                   (
     2167                   buf_inkas.shift-date >= X-date-start AND
     2168                   buf_inkas.shift-date <= X-date-end):
     2169           if buf_inkas.status_ = 'факт':U
     2170           or buf_inkas.status_ = 'запрос':U then next.
     2171           IF X-Radio-Task = 3 AND
     2172           ((buf_inkas.shift-date = X-date-start AND buf_inkas.shift-num < X-shift-Start) OR
     2173             (buf_inkas.shift-date = X-date-end AND  buf_inkas.shift-num > X-shift-End) ) THEN NEXT.
     2174           IF X-Radio-Task = 4 AND
     2175           (buf_inkas.shift-num <> X-shift-Alone ) THEN NEXT.
     2176           found = yes.
     2177           return.
     2178         END.
     2179       END.
     2180       WHEN NO THEN DO:
     2181         FOR EACH buf_chk-doc NO-LOCK WHERE
     2182                 buf_chk-doc.obj-type = obj-list.obj-type AND
     2183                 buf_chk-doc.obj-code = obj-list.obj-code AND
     2184                 buf_chk-doc.chk-date >= X-date-start AND
     2185                 buf_chk-doc.chk-date <= X-date-end   AND
     2186                 buf_Chk-doc.out-code = ? AND
     2187                 (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     2188           found = yes.
     2189           return.
     2190         END.
     2191         FOR EACH buf_inkas NO-LOCK WHERE
     2192                 buf_inkas.obj-type = obj-list.obj-type AND
     2193                 buf_inkas.obj-code = obj-list.obj-code AND
     2194                 buf_inkas.doc-date >= X-date-start AND
     2195                 buf_inkas.doc-date <= X-date-end :
     2196           if buf_inkas.status_ = 'факт':U
     2197           or buf_inkas.status_ = 'запрос':U then next.
     2198           found = yes.
     2199           return.
     2200         END.
     2201       END.
     2202     END CASE.
     2203   END.
     2204   END PROCEDURE.
     2205   PROCEDURE no-benq-i.
     2206   DEFINE OUTPUT PARAMETER found as logical init no.
     2207   define buffer buf_inkas for ub.inkas.
     2208   CASE X-Radio-Task > 1:
     2209     WHEN YES then do:
     2210       FOR EACH obj-list WHERE
     2211               obj-list.obj-type = 'маг':U NO-LOCK :
     2212         FOR EACH buf_inkas NO-LOCK WHERE
     2213                 buf_inkas.obj-type = obj-list.obj-type AND
     2214                 buf_inkas.obj-code = obj-list.obj-code AND
     2215                 buf_inkas.status_ = 'факт':U AND
     2216                 (
     2217                 buf_inkas.shift-date >= X-date-start AND
     2218                 buf_inkas.shift-date <= X-date-end):
     2219           IF X-Radio-Task = 3 AND
     2220           ((buf_inkas.shift-date = X-date-start AND buf_inkas.shift-num < X-shift-Start) OR
     2221             (buf_inkas.shift-date = X-date-end AND  buf_inkas.shift-num > X-shift-End) ) THEN NEXT.
     2222           IF X-Radio-Task = 4 AND
     2223           (buf_inkas.shift-num <> X-shift-Alone ) THEN NEXT.
     2224           found = yes.
     2225           return.
     2226         END.
     2227     END.
     2228     END.
     2229     WHEN NO THEN DO:
     2230       FOR EACH obj-list WHERE
     2231               obj-list.obj-type = 'маг':U NO-LOCK :
     2232         FOR EACH buf_inkas NO-LOCK WHERE
     2233                 buf_inkas.obj-type = obj-list.obj-type AND
     2234                 buf_inkas.obj-code = obj-list.obj-code AND
     2235                 buf_inkas.status_ = 'факт':U AND
     2236                 buf_inkas.doc-date >= X-date-start AND
     2237                 buf_inkas.doc-date <= X-date-end :
     2238            found = yes.
     2239            return.
     2240         END.
     2241       END.
     2242     END.
     2243   END CASE.
     2244   END PROCEDURE.
     2245   PROCEDURE no-benq-i-office.
     2246   DEFINE OUTPUT PARAMETER found as logical init no.
     2247   define buffer buf_sale-doc for ub.sale-doc.
     2248   CASE X-Radio-Task > 1:
     2249     WHEN YES then do:
     2250       FOR EACH obj-list WHERE
     2251               obj-list.obj-type = 'маг':U NO-LOCK :
     2252         FOR EACH buf_sale-doc NO-LOCK WHERE
     2253                  buf_Sale-doc.obj-type = obj-list.obj-type
     2254              AND buf_sale-doc.obj-code = obj-list.obj-code
     2255              AND buf_sale-doc.status_ = 'факт':U
     2256              AND buf_sale-doc.chr-office = 'у':U
     2257              AND (
     2258                 buf_sale-doc.shift-date >= X-date-start
     2259                 AND
     2260                 buf_sale-doc.shift-date <= X-date-end):
     2261           IF X-Radio-Task = 3 AND
     2262           ((buf_sale-doc.shift-date = X-date-start AND buf_sale-doc.shift-num < X-shift-Start) OR
     2263             (buf_sale-doc.shift-date = X-date-end AND  buf_sale-doc.shift-num > X-shift-End) ) THEN NEXT.
     2264           IF X-Radio-Task = 4 AND
     2265           (buf_sale-doc.shift-num <> X-shift-Alone ) THEN NEXT.
     2266           found = yes.
     2267           return.
     2268         END.
     2269       END.
     2270     END.
     2271     WHEN NO THEN DO:
     2272       FOR EACH obj-list WHERE
     2273               obj-list.obj-type = 'маг':U NO-LOCK :
     2274         FOR EACH buf_sale-doc NO-LOCK WHERE
     2275                 buf_sale-doc.obj-type = obj-list.obj-type
     2276            AND  buf_sale-doc.obj-code = obj-list.obj-code
     2277            AND  buf_sale-doc.status_ = 'факт':U
     2278            AND  buf_sale-doc.chr-office = 'у':U
     2279            AND  buf_sale-doc.doc-date >= X-date-start
     2280            AND  buf_sale-doc.doc-date <= X-date-end :
     2281           found = yes.
     2282           return.
     2283         END.
     2284       END.
     2285     END.
     2286   END CASE.
     2287   END PROCEDURE.
     2288   PROCEDURE adm-create-objects :
     2289   END PROCEDURE.
     2290   PROCEDURE adm-row-available :
     2291     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
     2292     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
     2293     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
     2294     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
     2295     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
     2296     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
     2297     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
     2298     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
     2299     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
     2300     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
     2301     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
     2302     IF adm-updating-record THEN RETURN.
     2303     RUN get-attribute ('FIELDS-ENABLED':U).
     2304     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
     2305     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
     2306         OUTPUT link-handle) NO-ERROR.
     2307     IF link-handle = "":U THEN
     2308         RETURN.
     2309     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
     2310     IF NUM-ENTRIES(link-handle) > 1 THEN
     2311         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
     2312             "encountered more than one RECORD-SOURCE.":U SKIP
     2313             "The first - ":U record-source-hdl:file-name " - will be used.":U
     2314                VIEW-AS ALERT-BOX ERROR.
     2315     RUN get-attribute ('Key-Name':U).
     2316     key-name = RETURN-VALUE.
     2317     IF key-name = "":U THEN key-name = ?.
     2318     IF key-name NE ? THEN DO:
     2319       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
     2320         NO-ERROR.
     2321       IF key-value NE ? THEN
     2322         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
     2323     END.
     2324   IF VALID-HANDLE (adm-object-hdl) THEN
     2325       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     2326   RUN notify IN THIS-PROCEDURE ('row-available':U).
     2327   END PROCEDURE.
     2328   PROCEDURE disable_UI :
     2329     HIDE FRAME F-Main.
     2330     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     2331   END PROCEDURE.
     2332   PROCEDURE enable_UI :
     2333     DISPLAY WithCashiers SelectCashiers WithGoods ByOperations WithoutObjects
     2334         WITH FRAME F-Main.
     2335     ENABLE RECT-totals RECT-cashiers RECT-checks WithCashiers SelectCashiers
     2336            WithGoods ByOperations WithoutObjects
     2337         WITH FRAME F-Main.
     2338   END PROCEDURE.
     2339   PROCEDURE local-apply-layout :
     2340   ASSIGN
     2341   SelectCashiers:RADIO-BUTTONS IN FRAME F-Main =  "все" + chr(44) + 'все':U + chr(44) +
     2342                                    "Выборочно" + chr(44) + "currency":U.
     2343     run dispatch IN THIS-PROCEDURE ( INPUT 'apply-layout':U ) .
     2344   END PROCEDURE.
     2345   PROCEDURE My-Report :
     2346   define variable acc-qnty-g as decimal no-undo .
     2347   define variable acc-sum-g as decimal no-undo .
     2348   define variable acc-count-g as integer no-undo .
     2349   define variable acc-qnty-b as decimal no-undo .
     2350   define variable acc-sum-b as decimal no-undo .
     2351   define variable acc-count-b as integer no-undo .
     2352   run My-var in this-procedure  .
     2353   FOR EACH cash-stat :
     2354     delete cash-stat .
     2355   END .
     2356   run no-benq in this-procedure ( output found).
     2357   if not found then do:
     2358     run waitfram-hide in this-procedure .
     2359     message "Не было никакой выручки на выбранных объектах в течение заданного Вами периода времени." view-as alert-box information .
     2360     return.
     2361   end.
     2362   FOR EACH obj-list :
     2363     _chk-doc:
     2364     FOR EACH ub.chk-doc WHERE
     2365             ub.chk-doc.obj-type = obj-list.obj-type
     2366       AND  ub.chk-doc.obj-code = obj-list.obj-code
     2367       AND  ub.chk-doc.chk-date >= X-date-start
     2368       AND  ub.chk-doc.chk-date <= X-date-end NO-LOCK :
     2369       if lookup(string(ub.chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0 then next _chk-doc.
     2370       if NOT can-do( 'т,у,сумма':U, ub.chk-doc.office )  then NEXT _chk-doc.
     2371       if SelectCashiers <> 'все':U then do:
     2372         find first tt-cshr no-lock where
     2373                   tt-cshr.cashier = ub.chk-doc.cashier
     2374              and  tt-cshr.psn-code = (if ub.chk-doc.cashier-psn-code = ?
     2375                                       then 0
     2376                                       else ub.chk-doc.cashier-psn-code)
     2377                   no-error.
     2378          if not available tt-cshr then next _Chk-doc.
     2379       end.
     2380       else do:
     2381       end.
     2382       if chk-doc.netto < 0 then  do:
     2383         if ( ByOperations <> 1 )
     2384         AND can-find( first ub.chk-gds where
     2385                             ub.chk-gds.doc-code = ub.chk-doc.doc-code
     2386                         AND ub.chk-gds.doc-qnty > 0 ) then do:
     2387           str-buf = ub.chk-doc.obj-type + chr(32) + string( ub.chk-doc.obj-code ) .
     2388           _chk-gds:
     2389           FOR EACH ub.chk-gds WHERE
     2390                     ub.chk-gds.doc-code = ub.chk-doc.doc-code
     2391                 AND ub.chk-gds.doc-qnty > 0 NO-LOCK :
     2392             if NOT ( ByGoods AND BySums ) then  do:
     2393               if ByGoods AND ( ub.chk-gds.b-code = 0 ) then NEXT _chk-gds.
     2394               if BySums AND ( ub.chk-gds.grp-code = 0 ) then NEXT _chk-gds.
     2395             end.
     2396             if ub.chk-gds.write-off-code <> ?
     2397             and ub.chk-gds.write-off-code <> 0 then NEXT.
     2398             if ub.chk-gds.grp-code = 0 then do:
     2399               FIND FIRST cash-stat WHERE
     2400                     cash-stat.b-code = ub.chk-gds.b-code
     2401                 AND cash-stat.obj-attr = str-buf
     2402                 AND cash-stat.cashier = ub.chk-doc.cashier
     2403                 AND cash-stat.psn-code = (if ub.chk-doc.cashier-psn-code = ?
     2404                                           then 0
     2405                                           else ub.chk-doc.cashier-psn-code)
     2406                 AND cash-stat.ret = TRUE NO-ERROR .
     2407             end.
     2408             else do:
     2409               FIND FIRST cash-stat WHERE
     2410                         cash-stat.grp-code = ub.chk-gds.grp-code
     2411                       AND cash-stat.obj-attr = str-buf
     2412                       AND cash-stat.cashier = ub.chk-doc.cashier
     2413                       AND cash-stat.psn-code = (if ub.chk-doc.cashier-psn-code = ?
     2414                                                 then 0
     2415                                                 else ub.chk-doc.cashier-psn-code)
     2416                       AND cash-stat.ret = TRUE NO-ERROR .
     2417             end.
     2418             if NOT available cash-stat then do:
     2419               CREATE cash-stat.
     2420               assign
     2421               cash-stat.obj-attr = str-buf
     2422               cash-stat.b-code = ub.chk-gds.b-code
     2423               cash-stat.grp-code = ub.chk-gds.grp-code
     2424               cash-stat.cashier = ub.chk-doc.cashier
     2425               cash-stat.psn-code = (if ub.chk-doc.cashier-psn-code = ?
     2426                                     then 0
     2427                                     else ub.chk-doc.cashier-psn-code)
     2428               cash-stat.out = FALSE
     2429               cash-stat.ret = TRUE
     2430               .
     2431             end.
     2432             assign
     2433             cash-stat.count = cash-stat.count + 1
     2434             cash-stat.qnty = cash-stat.qnty + ub.chk-gds.doc-qnty
     2435             cash-stat.sum = cash-stat.sum + ( ub.chk-gds.price-base - ub.chk-gds.discnt ) * ub.chk-gds.doc-qnty
     2436             .
     2437           END .
     2438         end.
     2439       end.
     2440       else do:
     2441         if ( ByOperations >= 0 )
     2442         AND can-find( first ub.chk-gds where
     2443                              ub.chk-gds.doc-code = ub.chk-doc.doc-code
     2444                          AND ub.chk-gds.doc-qnty < 0 ) then do:
     2445           str-buf = ub.chk-doc.obj-type + chr(32) + string( ub.chk-doc.obj-code ) .
     2446           _chk-gds2:
     2447           FOR EACH ub.chk-gds WHERE
     2448                   ub.chk-gds.doc-code = ub.chk-doc.doc-code
     2449               AND ub.chk-gds.doc-qnty < 0 NO-LOCK :
     2450             if NOT ( ByGoods AND BySums ) then do:
     2451               if ByGoods AND ( ub.chk-gds.b-code = 0 )  then NEXT _chk-gds2.
     2452               if BySums AND ( ub.chk-gds.grp-code = 0 )  then NEXT _chk-gds2.
     2453             end.
     2454             if ub.chk-gds.grp-code = 0 then do:
     2455               FIND FIRST cash-stat WHERE
     2456                         cash-stat.b-code = ub.chk-gds.b-code
     2457                   AND cash-stat.obj-attr = str-buf
     2458                   AND cash-stat.cashier = ub.chk-doc.cashier
     2459                   AND cash-stat.psn-code = (if ub.chk-doc.cashier-psn-code = ?
     2460                                             then 0
     2461                                             else ub.chk-doc.cashier-psn-code)
     2462                   AND cash-stat.out = TRUE NO-ERROR .
     2463             end.
     2464             else do:
     2465               FIND FIRST cash-stat WHERE
     2466                         cash-stat.grp-code = ub.chk-gds.grp-code
     2467                     AND cash-stat.obj-attr = str-buf
     2468                     AND cash-stat.cashier = ub.chk-doc.cashier
     2469                     AND cash-stat.psn-code = (if ub.chk-doc.cashier-psn-code = ?
     2470                                               then 0
     2471                                               else ub.chk-doc.cashier-psn-code)
     2472                     AND cash-stat.out = TRUE NO-ERROR .
     2473             end.
     2474             if NOT available cash-stat then do:
     2475               CREATE cash-stat.
     2476               assign
     2477               cash-stat.obj-attr = str-buf
     2478               cash-stat.b-code = ub.chk-gds.b-code
     2479               cash-stat.grp-code = ub.chk-gds.grp-code
     2480               cash-stat.cashier = ub.chk-doc.cashier
     2481               cash-stat.psn-code = (if ub.chk-doc.cashier-psn-code = ?
     2482                                     then 0
     2483                                     else ub.chk-doc.cashier-psn-code)
     2484               cash-stat.out = TRUE
     2485               cash-stat.ret = FALSE
     2486               .
     2487             end.
     2488             assign
     2489             cash-stat.count = cash-stat.count + 1
     2490             cash-stat.qnty = cash-stat.qnty + ub.chk-gds.doc-qnty
     2491             cash-stat.sum = cash-stat.sum + ( ub.chk-gds.price-base - ub.chk-gds.discnt ) * ub.chk-gds.doc-qnty
     2492             .
     2493           END .
     2494         end.
     2495       end.
     2496     END .
     2497     assign
     2498     obj-amount = obj-amount + 1.
     2499   END .
     2500   if WithoutObjects then do:
     2501     if obj-amount > 1 then do:
     2502       if BySums then do:
     2503         FOR EACH cash-stat WHERE
     2504                 cash-stat.b-code = 0
     2505         BREAK
     2506         BY cash-stat.out
     2507         BY cash-stat.cashier
     2508         BY cash-stat.psn-code
     2509         BY cash-stat.grp-code :
     2510           if first-of (cash-stat.grp-code) then do:
     2511             assign
     2512             acc-qnty-g = 0
     2513             acc-sum-g = 0
     2514             acc-count-g = 0
     2515             .
     2516           end.
     2517           assign
     2518           acc-qnty-g = acc-qnty-g + cash-stat.qnty
     2519           acc-sum-g = acc-sum-g + cash-stat.sum
     2520           acc-count-g = acc-count-g + 1
     2521           .
     2522           if last-of( cash-stat.grp-code ) then do:
     2523             assign
     2524             cash-stat.obj-attr = ""
     2525             cash-stat.count = acc-count-g
     2526             cash-stat.sum = acc-sum-g
     2527             cash-stat.qnty = acc-qnty-g
     2528             .
     2529           end.
     2530           else delete cash-stat .
     2531         END .
     2532       end.
     2533       if ByGoods then do:
     2534         FOR EACH cash-stat WHERE
     2535                 cash-stat.grp-code = 0
     2536         BREAK
     2537         BY cash-stat.out
     2538         BY cash-stat.cashier
     2539         BY cash-stat.psn-code
     2540         BY cash-stat.b-code :
     2541           if first-of(cash-stat.b-code) then do:
     2542             assign
     2543             acc-qnty-b = 0
     2544             acc-sum-b= 0
     2545             acc-count-b = 0
     2546             .
     2547           end.
     2548           assign
     2549           acc-qnty-b = acc-qnty-b + cash-stat.qnty
     2550           acc-sum-b = acc-sum-b + cash-stat.sum
     2551           acc-count-b = acc-count-b + 1
     2552           .
     2553           if last-of( cash-stat.b-code ) then do:
     2554             assign
     2555             cash-stat.obj-attr = ""
     2556             cash-stat.count = acc-count-b
     2557             cash-stat.sum = acc-sum-b
     2558             cash-stat.qnty = acc-qnty-b
     2559             .
     2560           end.
     2561           else delete cash-stat .
     2562         END .
     2563       end.
     2564     end.
     2565   end.
     2566   if ByOperations = 0 then do:
     2567     if BySums then do:
     2568       FOR EACH cash-stat WHERE
     2569              cash-stat.b-code = 0
     2570       BREAK
     2571       BY cash-stat.obj-attr
     2572       BY cash-stat.cashier
     2573       BY cash-stat.psn-code
     2574       BY cash-stat.grp-code :
     2575         if first-of (cash-stat.grp-code) then do:
     2576           assign
     2577           acc-qnty-g = 0
     2578           acc-sum-g = 0
     2579           acc-count-g = 0
     2580           .
     2581         end.
     2582         assign
     2583         acc-qnty-g = acc-qnty-g + cash-stat.qnty
     2584         acc-sum-g = acc-sum-g + cash-stat.sum
     2585         acc-count-g = acc-count-g + 1
     2586         .
     2587         if last-of( cash-stat.grp-code ) then do:
     2588           assign
     2589           cash-stat.out = TRUE
     2590           cash-stat.ret = TRUE
     2591           cash-stat.count = acc-qnty-g
     2592           cash-stat.sum = acc-sum-g
     2593           cash-stat.qnty = acc-count-g
     2594           .
     2595         end.
     2596         else delete cash-stat .
     2597       END .
     2598     end.
     2599     if ByGoods then do:
     2600         FOR EACH cash-stat WHERE
     2601                cash-stat.grp-code = 0
     2602         BREAK
     2603         BY cash-stat.obj-attr
     2604         BY cash-stat.cashier
     2605         BY cash-stat.b-code :
     2606           if first-of(cash-stat.b-code) then do:
     2607             assign
     2608             acc-qnty-b = 0
     2609             acc-sum-b= 0
     2610             acc-count-b = 0
     2611             .
     2612           end.
     2613           assign
     2614           acc-qnty-b = acc-qnty-b + cash-stat.qnty
     2615           acc-sum-b = acc-sum-b + cash-stat.sum
     2616           acc-count-b = acc-count-b + 1
     2617           .
     2618           if last-of( cash-stat.b-code ) then do:
     2619             assign
     2620             cash-stat.out = TRUE
     2621             cash-stat.ret = TRUE
     2622             cash-stat.count = acc-count-b
     2623             cash-stat.sum = acc-sum-b
     2624             cash-stat.qnty = acc-qnty-b
     2625             .
     2626           end.
     2627           else delete cash-stat .
     2628         END .
     2629        end.
     2630    end.
     2631    if NOT WithCashiers then do:
     2632      if BySums then do:
     2633         FOR EACH cash-stat WHERE
     2634                cash-stat.b-code = 0
     2635         BREAK
     2636         BY cash-stat.obj-attr
     2637         BY cash-stat.out
     2638         BY cash-stat.grp-code :
     2639           if first-of (cash-stat.grp-code) then do:
     2640             assign
     2641             acc-qnty-g = 0
     2642             acc-sum-g = 0
     2643             acc-count-g = 0
     2644             .
     2645           end.
     2646           assign
     2647           acc-qnty-g = acc-qnty-g + cash-stat.qnty
     2648           acc-sum-g = acc-sum-g + cash-stat.sum
     2649           acc-count-g = acc-count-g + 1
     2650           .
     2651           if last-of( cash-stat.grp-code ) then do:
     2652             assign
     2653             cash-stat.cashier = 0
     2654             cash-stat.count = acc-qnty-g
     2655             cash-stat.sum = acc-sum-g
     2656             cash-stat.qnty = acc-count-g
     2657             .
     2658           end.
     2659           else delete cash-stat .
     2660        END .
     2661      end.
     2662      if ByGoods then do:
     2663         FOR EACH cash-stat WHERE
     2664              cash-stat.grp-code = 0
     2665         BREAK
     2666         BY cash-stat.obj-attr
     2667         BY cash-stat.out
     2668         BY cash-stat.b-code :
     2669           if first-of(cash-stat.b-code) then do:
     2670             assign
     2671             acc-qnty-b = 0
     2672             acc-sum-b= 0
     2673             acc-count-b = 0
     2674             .
     2675           end.
     2676           assign
     2677           acc-qnty-b = acc-qnty-b + cash-stat.qnty
     2678           acc-sum-b = acc-sum-b + cash-stat.sum
     2679           acc-count-b = acc-count-b + 1
     2680           .
     2681           if last-of( cash-stat.b-code ) then do:
     2682             assign
     2683             cash-stat.cashier = 0
     2684             cash-stat.count = acc-count-b
     2685             cash-stat.sum = acc-sum-b
     2686             cash-stat.qnty = acc-qnty-b
     2687             .
     2688           end.
     2689          else delete cash-stat .
     2690        end.
     2691      END .
     2692   end.
     2693   if can-find( first cash-stat ) then do:
     2694     run PrintProc in this-procedure .
     2695   end.
     2696   else
     2697   message
     2698   "Отчет по отмененным/аннулированым строкам чеков" skip
     2699   "ПУСТ при выбранных Вами параметрах."
     2700   view-as alert-box INFORMATION .
     2701   END PROCEDURE.
     2702   PROCEDURE My-var :
     2703    assign
     2704    FRAME F-Main SelectCashiers
     2705    FRAME F-Main ByGoods
     2706    FRAME F-Main BySums
     2707    FRAME F-Main ByOperations
     2708    FRAME F-Main WithoutObjects
     2709    FRAME F-Main WithCashiers
     2710    .
     2711   Assign
     2712    STR-obj-type = ''
     2713    STR-obj-code = ''
     2714    STR-obj-name = ''
     2715    STR-obj      = ''.
     2716   For each obj-list no-lock:
     2717    Assign
     2718    STR-obj-type = STR-obj-type + obj-list.obj-type + ','
     2719    STR-obj-code = STR-obj-code + String(obj-list.obj-code) + ','
     2720    STR-obj-name = STR-obj-name + obj-list.obj-name + ','
     2721    STR-obj = STR-obj +  obj-list.obj-type + '#' + string(obj-list.obj-code)  + ',' .
     2722   End.
     2723   ReportNAme = "Статистика по кассирам".
     2724   ReportHeader =
     2725                  "Кассиры : " +
     2726                  radio-label(string(SelectCashiers), SelectCashiers:radio-buttons) + chr(10) +
     2727                  "Операции : " + (if ByOperations = 0
     2728                                   then "Продажи + возвраты"
     2729                                   else if ByOperations = 1
     2730                                        then "Продажи"
     2731                                        else "Возвраты" ) + ", " +
     2732                  (if ByGoods then "Товарные" else "" ) +
     2733                  (if BySums then " Суммовые" else "" ) + chr(10) +
     2734                  "Итоги по объектам : " +
     2735                  radio-label(string(WithoutObjects), WithoutObjects:radio-buttons) + chr(10) +
     2736                  "Итоги по кассирам : " +
     2737                  radio-label(string(WithCashiers), WithCashiers:radio-buttons) + chr(10) +
     2738                  "Итоги по товарам  : " +
     2739                 radio-label(string(WithGoods), WithGoods:radio-buttons)
     2740                  .
     2741   END PROCEDURE.
     2742   PROCEDURE PrintProc :
     2743   define variable sym1 as char init ":"   no-undo.
     2744   define variable sym2 as char init ":"   no-undo.
     2745   define variable sym3 as char init ":"   no-undo.
     2746   define variable sym4 as char init ":"   no-undo.
     2747   define variable sym5 as char init ":"   no-undo.
     2748   define variable sym6 as char init ":"   no-undo.
     2749   define variable sym7 as char init ":"   no-undo.
     2750   define variable sym8 as char init ":"   no-undo.
     2751   define variable sym9 as char init ":"   no-undo.
     2752   define variable acc-qnty-0 as decimal no-undo .
     2753   define variable acc-sum-0 as decimal no-undo .
     2754   define variable acc-count-0 as integer no-undo .
     2755   define variable acc-qnty-o as decimal no-undo .
     2756   define variable acc-sum-o as decimal no-undo .
     2757   define variable acc-count-o as integer no-undo .
     2758   define variable acc-qnty-p as decimal no-undo .
     2759   define variable acc-sum-p as decimal no-undo .
     2760   define variable acc-count-p as integer no-undo .
     2761   define variable Line as char no-undo.
     2762   define variable CashierName as char no-undo.
     2763   define variable G-Artic as char no-undo.
     2764   define variable v-header-base-curr as character no-undo .
     2765   define variable v-curr-r-b as character no-undo .
     2766   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2767   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2768     (output v-curr-r-b
     2769     )  .
     2770   if v-curr-r-b = 'base':U then do:
     2771     assign
     2772     v-header-base-curr =  "( Баз.Вал. ) "
     2773     .
     2774   end.
     2775   DEFINE FRAME F1
     2776   sym1 column-label ":!:" format "X(1)"
     2777   cash-stat.cashier column-label "Код!кассира" format ">>>>>9"
     2778   cash-stat.psn-code column-label "Код!чел" format ">>>>>>>>9"
     2779   CashierName column-label "Имя !кассира" format "x(25)"
     2780   cash-stat.obj-attr column-label "Объект!(тип код)" format "X(10)"
     2781   sym3 column-label ":!:" format "X(1)"
     2782   cash-stat.b-code column-label "Код товара /!   группы" format ">>>>>>>>>>>>9"
     2783   sym9 column-label ":!:" format "X(1)"
     2784   G-Artic column-label "Артикул!товара" format "X(16)"
     2785   sym4 column-label ":!:" format "X(1)"
     2786   cash-stat.qnty column-label "Кол-во товаров! " format "->>>,>>>,>>9.<<<"
     2787   sym5 column-label ":!:" format "X(1)"
     2788   cash-stat.sum column-label "Сумма в Б.Вал.! " format "->>>,>>>,>>>,>>9.99"
     2789   sym6 column-label ":!:" format "X(1)"
     2790   cash-stat.count column-label "Всего!строк" format "->>>>>>>>>9"
     2791   sym7 column-label ":!:" format "X(1)"
     2792   HEADER
     2793   cur-time-print() AT 5 format "X(35)"
     2794   v-header-base-curr        format "X(20)" AT 42
     2795   "Страница " AT 100 PAGE-NUMBER( PrnLibStream ) AT 115 format ">>9" SKIP
     2796   Line format "X(136)" AT 1
     2797   with width 160 down stream-io use-text .
     2798   Line = fill( "-", 170 ).
     2799   run prn-lib-open-stream  in this-procedure (
     2800                                                input my-handle
     2801                                               ,input 62
     2802                                               ,input yes
     2803                                               ,input no
     2804                                               ).
     2805   FORM HEADER
     2806   Line format "X(136)" AT 1 SKIP
     2807   "Продолжение - на следующей странице" AT 30 SKIP
     2808   with FRAME BottomFrame width 160 PAGE-BOTTOM NO-LABELS NO-BOX .
     2809   VIEW stream PrnLibStream FRAME BottomFrame .
     2810   PUT stream PrnLibStream space(20)
     2811   ( "Статистика по кассирам " + str1) format "X(100)" skip(2)
     2812   space(10) "По объектам : " format "X(14)" .
     2813   FOR EACH obj-list :
     2814     FIND FIRST cli-obj WHERE
     2815              cli-obj.obj-type = obj-list.obj-type
     2816          AND cli-obj.obj-code = obj-list.obj-code NO-LOCK .
     2817     PUT stream PrnLibStream
     2818     string( obj-list.obj-type + " " + string( obj-list.obj-code ) +
     2819         " (" + trim( cli-obj.obj-name ) + ")" ) format "x(90)" skip space(24) .
     2820   END.
     2821   PUT stream PrnLibStream " " skip .
     2822   PUT stream PrnLibStream unformatted
     2823   ReportHeader skip(0)
     2824   .
     2825   FOR EACH cash-stat use-index p3
     2826   BREAK
     2827   BY cash-stat.cashier
     2828   BY cash-stat.psn-code
     2829   BY cash-stat.obj-attr
     2830   BY cash-stat.out
     2831   BY cash-stat.b-code
     2832   BY cash-stat.grp-code with FRAME F1 :
     2833     if first-of( cash-stat.obj-attr) then do:
     2834       assign
     2835       acc-qnty-o = 0
     2836       acc-sum-o = 0
     2837       acc-count-o = 0
     2838       .
     2839     end.
     2840     if first-of( cash-stat.psn-code) then do:
     2841       assign
     2842       acc-qnty-p = 0
     2843       acc-sum-p = 0
     2844       acc-count-p = 0
     2845       .
     2846     end.
     2847     assign
     2848     acc-qnty-o = acc-qnty-o + cash-stat.qnty
     2849     acc-sum-o  = acc-sum-o + cash-stat.sum
     2850     acc-count-o  = acc-count-o + cash-stat.count
     2851     acc-qnty-p = acc-qnty-p + cash-stat.qnty
     2852     acc-sum-p  = acc-sum-p + cash-stat.sum
     2853     acc-count-p  = acc-count-p + cash-stat.count
     2854     acc-qnty-0 = acc-qnty-0 + cash-stat.qnty
     2855     acc-sum-0 = acc-sum-0 + cash-stat.sum
     2856     acc-count-0  = acc-count-0 + cash-stat.count
     2857     .
     2858     if WithGoods
     2859     AND ( first-of( cash-stat.b-code ) )
     2860     AND ( cash-stat.b-code <> 0 ) then do:
     2861       FIND FIRST ub.bar-code WHERE
     2862                 ub.bar-code.b-code = cash-stat.b-code NO-LOCK .
     2863     end.
     2864     if cash-stat.cashier = 0 then do:
     2865       cashiername = "Все кассиры".
     2866     end.
     2867     if first-of( cash-stat.psn-code ) then do:
     2868       if cash-stat.cashier <> 0 then do:
     2869         if cash-stat.psn-code <> 0 then do:
     2870           FIND FIRST ub.clients no-lock WHERE
     2871                     ub.clients.obj-type = 'чел':U
     2872                 AND ub.clients.obj-code = cash-stat.psn-code  .
     2873           FIND FIRST ub.person no-lock WHERE
     2874                    ub.person.psn-code = ub.clients.obj-code.
     2875           cashiername = substitute("&1 &2", ub.clients.obj-name , ub.person.name1 ).
     2876         end.
     2877         else do:
     2878           cashiername = substitute("КАССИР &1" , cash-stat.cashier).
     2879         end.
     2880       end.
     2881       if WithGoods then do:
     2882         DISPLAY stream PrnLibStream
     2883         sym1
     2884         cash-stat.cashier WHEN cash-stat.cashier <> 0
     2885         cash-stat.psn-code WHEN cash-stat.cashier <> 0
     2886         CashierName
     2887         (if first-of( cash-stat.obj-attr ) and cash-stat.obj-attr <> ""
     2888           then cash-stat.obj-attr
     2889           else " " )   @ cash-stat.obj-attr
     2890         sym3
     2891         (if cash-stat.b-code = 0
     2892           then cash-stat.grp-code
     2893           else cash-stat.b-code )
     2894         @ cash-stat.b-code
     2895         sym9
     2896         (if cash-stat.b-code = 0 then " " else string(bar-code.gds-code) ) @ G-Artic
     2897         sym4
     2898         cash-stat.qnty
     2899         sym5
     2900         cash-stat.sum
     2901         sym6
     2902         cash-stat.count
     2903         sym7 .
     2904       end.
     2905     end.
     2906     else do:
     2907       if WithGoods then do:
     2908         DISPLAY stream PrnLibStream
     2909         sym1
     2910         cash-stat.cashier WHEN cash-stat.cashier <> 0
     2911         cash-stat.psn-code WHEN cash-stat.cashier <> 0
     2912         " " @ CashierName
     2913         (if first-of( cash-stat.obj-attr ) and cash-stat.obj-attr <> ""
     2914         then cash-stat.obj-attr
     2915         else " " )  @ cash-stat.obj-attr
     2916         sym3
     2917         (if cash-stat.b-code = 0
     2918         then cash-stat.grp-code
     2919         else cash-stat.b-code )  @ cash-stat.b-code
     2920         sym9
     2921         (if cash-stat.b-code = 0 then " " else string(bar-code.gds-code)) @ G-Artic
     2922         sym4
     2923         cash-stat.qnty
     2924         sym5
     2925         cash-stat.sum
     2926         sym6
     2927         cash-stat.count
     2928         sym7 .
     2929       end.
     2930     end.
     2931     if last-of( cash-stat.obj-attr ) and cash-stat.obj-attr <> "" then do:
     2932       if WithGoods then do:
     2933         UNDERLINE stream PrnLibStream
     2934         cash-stat.cashier
     2935         CashierName
     2936         cash-stat.obj-attr
     2937         cash-stat.b-code
     2938         cash-stat.qnty
     2939         cash-stat.sum
     2940         cash-stat.count .
     2941         DISPLAY stream PrnLibStream
     2942         sym1
     2943         "Итого по объекту" @ CashierName
     2944         cash-stat.obj-attr
     2945         acc-qnty-o @ cash-stat.qnty
     2946         acc-sum-o @ cash-stat.sum
     2947         acc-count-o @ cash-stat.count
     2948         sym7 .
     2949       end.
     2950       UNDERLINE stream PrnLibStream
     2951       cash-stat.cashier
     2952       CashierName
     2953       cash-stat.obj-attr
     2954       cash-stat.b-code
     2955       cash-stat.qnty
     2956       cash-stat.sum
     2957       cash-stat.count .
     2958     end.
     2959     if last-of( cash-stat.psn-code )
     2960     and cash-stat.cashier <> 0 then do:
     2961       if WithGoods then do:
     2962         UNDERLINE stream PrnLibStream
     2963         cash-stat.cashier
     2964         CashierName
     2965         cash-stat.obj-attr
     2966         cash-stat.b-code
     2967         cash-stat.qnty
     2968         cash-stat.sum
     2969         cash-stat.count
     2970         .
     2971       end.
     2972       DISPLAY stream PrnLibStream
     2973         sym1
     2974       ( substitute("Итого по кассиру &1", cash-stat.cashier, cash-stat.psn-code) ) @ CashierName
     2975       " " @ cash-stat.obj-attr
     2976       acc-qnty-p @ cash-stat.qnty
     2977       acc-sum-p @ cash-stat.sum
     2978       acc-count-p  @ cash-stat.count
     2979       sym7 .
     2980       UNDERLINE stream PrnLibStream
     2981       cash-stat.cashier
     2982       CashierName
     2983       cash-stat.obj-attr
     2984       cash-stat.b-code
     2985       cash-stat.qnty
     2986       cash-stat.sum
     2987       cash-stat.count .
     2988     end.
     2989     if last( cash-stat.grp-code ) then do:
     2990       UNDERLINE stream PrnLibStream
     2991       cash-stat.cashier
     2992       CashierName
     2993       cash-stat.obj-attr
     2994       cash-stat.b-code
     2995       cash-stat.qnty
     2996       cash-stat.sum
     2997       cash-stat.count .
     2998       DISPLAY stream PrnLibStream
     2999       sym1 "ИТОГО" @ CashierName
     3000       acc-qnty-0 @ cash-stat.qnty
     3001       acc-sum-0 @ cash-stat.sum
     3002       acc-count-0 @ cash-stat.count
     3003       sym7 .
     3004     end.
     3005   END .
     3006   HIDE stream PrnLibStream FRAME BottomFrame .
     3007   PUT stream PrnLibStream Line format "X(136)" skip.
     3008   output stream PrnLibStream CLOSE .
     3009   run prn-lib-prn-file in this-procedure (
     3010                                             input my-handle
     3011                                             ,input 0
     3012                                             ).
     3013   END PROCEDURE.
     3014   PROCEDURE send-records :
     3015   END PROCEDURE.
     3016   PROCEDURE state-changed :
     3017     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE NO-UNDO.
     3018     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     3019   END PROCEDURE.
