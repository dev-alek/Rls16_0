     3998       :
     3999         create buf_tt-clcparts .
     4000         buffer-copy bf_parts to buf_tt-clcparts .
     4001         if v-calcbypart = yes   then do:
     4002   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run partbcod in g#library
     4003     (buffer bf_parts
     4004     ,output v-b-pcode
     4005     ) no-error .
     4006   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4007   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     4008     (input  bf_parts.obj-type
     4009     ,input  bf_parts.obj-code
     4010     ,input  v-b-pcode
     4011     ,input  0
     4012     ,input  bf_trn-doc.fact-order
     4013     ,output vardoc-num
     4014     ,output varprice-salef
     4015     ,output varroad-tax
     4016     ,output varexcise
     4017     ) no-error .
     4018             if varprice-sale = ?
     4019             then do:
     4020               assign
     4021                 varprice-salef = 0
     4022                 varroad-tax   = 0
     4023                 varexcise     = 0
     4024               .
     4025             end.
     4026             assign
     4027             part-cur-base  = varprice-salef
     4028             part-cur-road-tax  = varroad-tax
     4029             part-cur-excise = varexcise.
     4030         end.
     4031       end.
     4032       run clcprtsl_calc-ttable in this-procedure
     4033         (input yes,
     4034          input yes,
     4035          input bf_doc-line.road-tax,
     4036          input bf_doc-line.excise,
     4037          input bf_doc-line.vat-pc,
     4038          input bf_doc-line.cons-vat-pc,
     4039          input bf_doc-line.slt-pc,
     4040          input bf_trn-doc.base-rate,
     4041          input bf_trn-doc.base-scale,
     4042          input varr-b,
     4043          input varcur-base,
     4044          input varcur-road-tax,
     4045          input varcur-excise,
     4046          input varcur-vat-pc,
     4047          input varcur-cons-vat-pc,
     4048          input varcur-slt-pc
     4049          ) no-error.
     4050       if error-status:error then do:
     4051         message
     4052           vss-workfile vss-revision vss-description skip
     4053           "Ошибка при вызове процедуры clcprtsl_calc-ttable." skip
     4054           return-value skip
     4055           trim(error-status :get-message(1))
     4056           trim(error-status :get-message(2))
     4057           trim(error-status :get-message(3))
     4058           trim(error-status :get-message(4))
     4059           trim(error-status :get-message(5)) skip
     4060           view-as alert-box error.
     4061         undo, return error .
     4062       end.
     4063     end.
     4064   end.
     4065   end.
     4066   procedure clcprtsl_calc-ttable :
     4067   define input parameter paris-doc           as   logical                 no-undo.
     4068   define input parameter paris-cur           as   logical                 no-undo.
     4069   define input parameter parroad-tax         like ub.doc-line.road-tax    no-undo.
     4070   define input parameter parexcise           like ub.doc-line.excise      no-undo.
     4071   define input parameter parvat-pc           like ub.doc-line.vat-pc      no-undo.
     4072   define input parameter parcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     4073   define input parameter parslt-pc           like ub.doc-line.slt-pc      no-undo.
     4074   define input parameter parbase-rate        like ub.trn-doc.base-rate    no-undo.
     4075   define input parameter parbase-scale       like ub.trn-doc.base-scale   no-undo.
     4076   define input parameter parr-b              as   character               no-undo.
     4077   define input parameter parcur-base         like ub.gds-dtl.cur-base     no-undo.
     4078   define input parameter parcur-road-tax     like ub.doc-line.road-tax    no-undo.
     4079   define input parameter parcur-excise       like ub.doc-line.excise      no-undo.
     4080   define input parameter parcur-vat-pc       like ub.doc-line.vat-pc      no-undo.
     4081   define input parameter parcurcons-vat-pc   like ub.doc-line.cons-vat-pc no-undo.
     4082   define input parameter parcurslt-pc        like ub.doc-line.slt-pc      no-undo.
     4083   define buffer bf_tt-allsum      for tt-allsum.
     4084   define buffer bf_tt-clcparts    for tt-clcparts.
     4085   define buffer bf_tt-allsum-line for tt-allsum-line.
     4086   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     4087   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     4088   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     4089   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     4090   define variable varexcise          like ub.price-list.excise     no-undo.
     4091   do on error undo, return error return-value :
     4092   for each bf_tt-allsum-line
     4093   on error undo, return error return-value
     4094    :
     4095     delete bf_tt-allsum-line.
     4096   end.
     4097   for each bf_tt-allsum
     4098   on error undo, return error return-value
     4099   :
     4100     delete bf_tt-allsum.
     4101   end.
     4102   for each bf_tt-clcparts
     4103   on error undo, return error return-value
     4104   :
     4105   if v-calcbypart then do:
     4106             assign
     4107             parcur-base =   bf_tt-clcparts.part-cur-base
     4108             parcur-road-tax = bf_tt-clcparts.part-cur-road-tax
     4109             parcur-excise =   bf_tt-clcparts.part-cur-excise
     4110             .
     4111   end.
     4112      run clcprtsl_calc-parts in this-procedure (
     4113        input recid(bf_tt-clcparts),
     4114        input paris-doc,
     4115        input paris-cur,
     4116        input parroad-tax,
     4117        input parexcise,
     4118        input parvat-pc,
     4119        input parcons-vat-pc,
     4120        input parslt-pc,
     4121        input parbase-rate,
     4122        input parbase-scale,
     4123        input parr-b,
     4124        input parcur-base,
     4125        input parcur-road-tax,
     4126        input parcur-excise,
     4127        input parcur-vat-pc,
     4128        input parcurcons-vat-pc,
     4129        input parcurslt-pc
     4130        ) no-error.
     4131     if error-status:error then do:
     4132       message
     4133         vss-workfile vss-revision vss-description skip
     4134         vss-include-info16 skip
     4135         "Ошибка при обсчете партии" skip
     4136         "Документ партии " bf_tt-clcparts.out-code skip
     4137         "Товар" bf_tt-clcparts.artic bf_tt-clcparts.prod-type bf_tt-clcparts.prod-code skip
     4138         return-value skip
     4139         error-status:get-message(1) skip
     4140         error-status:get-message(2) skip
     4141         error-status:get-message(3) skip
     4142         view-as alert-box error .
     4143       undo, return error .
     4144     end.
     4145     for each bf_tt-allsum on error undo, return error return-value :
     4146       find first bf_tt-allsum-line where bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type no-error.
     4147       if not available bf_tt-allsum-line then do:
     4148         create bf_tt-allsum-line.
     4149         assign
     4150           bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type.
     4151       end.
     4152       assign
     4153         bf_tt-allsum-line.fact-qnty              = bf_tt-allsum-line.fact-qnty            + bf_tt-allsum.fact-qnty
     4154         bf_tt-allsum-line.cli-qnty               = bf_tt-allsum-line.cli-qnty             + bf_tt-allsum.cli-qnty
     4155         bf_tt-allsum-line.sum-dsc-base-doc       = bf_tt-allsum-line.sum-dsc-base-doc     + bf_tt-allsum.sum-dsc-base-doc
     4156         bf_tt-allsum-line.sum-dsc-rubl-doc       = bf_tt-allsum-line.sum-dsc-rubl-doc     + bf_tt-allsum.sum-dsc-rubl-doc
     4157         bf_tt-allsum-line.dsc-base-doc           = bf_tt-allsum-line.dsc-base-doc         + bf_tt-allsum.dsc-base-doc
     4158         bf_tt-allsum-line.dsc-rubl-doc           = bf_tt-allsum-line.dsc-rubl-doc         + bf_tt-allsum.dsc-rubl-doc
     4159         bf_tt-allsum-line.vat-base-doc           = bf_tt-allsum-line.vat-base-doc         + bf_tt-allsum.vat-base-doc
     4160         bf_tt-allsum-line.vat-rubl-doc           = bf_tt-allsum-line.vat-rubl-doc         + bf_tt-allsum.vat-rubl-doc
     4161         bf_tt-allsum-line.vat-base-buyer-doc     = bf_tt-allsum-line.vat-base-buyer-doc   + bf_tt-allsum.vat-base-buyer-doc
     4162         bf_tt-allsum-line.vat-rubl-buyer-doc     = bf_tt-allsum-line.vat-rubl-buyer-doc   + bf_tt-allsum.vat-rubl-buyer-doc
     4163         bf_tt-allsum-line.slt-base-doc           = bf_tt-allsum-line.slt-base-doc         + bf_tt-allsum.slt-base-doc
     4164         bf_tt-allsum-line.slt-rubl-doc           = bf_tt-allsum-line.slt-rubl-doc         + bf_tt-allsum.slt-rubl-doc
     4165         bf_tt-allsum-line.road-tax-base-doc      = bf_tt-allsum-line.road-tax-base-doc    + bf_tt-allsum.road-tax-base-doc
     4166         bf_tt-allsum-line.road-tax-rubl-doc      = bf_tt-allsum-line.road-tax-rubl-doc    + bf_tt-allsum.road-tax-rubl-doc
     4167         bf_tt-allsum-line.excise-base-doc        = bf_tt-allsum-line.excise-base-doc      + bf_tt-allsum.excise-base-doc
     4168         bf_tt-allsum-line.excise-rubl-doc        = bf_tt-allsum-line.excise-rubl-doc      + bf_tt-allsum.excise-rubl-doc
     4169         bf_tt-allsum-line.sum-dsc-base-cur       = bf_tt-allsum-line.sum-dsc-base-cur     + bf_tt-allsum.sum-dsc-base-cur
     4170         bf_tt-allsum-line.sum-dsc-rubl-cur       = bf_tt-allsum-line.sum-dsc-rubl-cur     + bf_tt-allsum.sum-dsc-rubl-cur
     4171         bf_tt-allsum-line.dsc-base-cur           = bf_tt-allsum-line.dsc-base-cur         + bf_tt-allsum.dsc-base-cur
     4172         bf_tt-allsum-line.dsc-rubl-cur           = bf_tt-allsum-line.dsc-rubl-cur         + bf_tt-allsum.dsc-rubl-cur
     4173         bf_tt-allsum-line.vat-base-cur           = bf_tt-allsum-line.vat-base-cur         + bf_tt-allsum.vat-base-cur
     4174         bf_tt-allsum-line.vat-rubl-cur           = bf_tt-allsum-line.vat-rubl-cur         + bf_tt-allsum.vat-rubl-cur
     4175         bf_tt-allsum-line.vat-base-buyer-cur     = bf_tt-allsum-line.vat-base-buyer-cur   + bf_tt-allsum.vat-base-buyer-cur
     4176         bf_tt-allsum-line.vat-rubl-buyer-cur     = bf_tt-allsum-line.vat-rubl-buyer-cur   + bf_tt-allsum.vat-rubl-buyer-cur
     4177         bf_tt-allsum-line.slt-base-cur           = bf_tt-allsum-line.slt-base-cur         + bf_tt-allsum.slt-base-cur
     4178         bf_tt-allsum-line.slt-rubl-cur           = bf_tt-allsum-line.slt-rubl-cur         + bf_tt-allsum.slt-rubl-cur
     4179         bf_tt-allsum-line.road-tax-base-cur      = bf_tt-allsum-line.road-tax-base-cur    + bf_tt-allsum.road-tax-base-cur
     4180         bf_tt-allsum-line.road-tax-rubl-cur      = bf_tt-allsum-line.road-tax-rubl-cur    + bf_tt-allsum.road-tax-rubl-cur
     4181         bf_tt-allsum-line.excise-base-cur        = bf_tt-allsum-line.excise-base-cur      + bf_tt-allsum.excise-base-cur
     4182         bf_tt-allsum-line.excise-rubl-cur        = bf_tt-allsum-line.excise-rubl-cur      + bf_tt-allsum.excise-rubl-cur
     4183         bf_tt-allsum-line.sum-dsc-base-acc       = bf_tt-allsum-line.sum-dsc-base-acc     + bf_tt-allsum.sum-dsc-base-acc
     4184         bf_tt-allsum-line.sum-dsc-rubl-acc       = bf_tt-allsum-line.sum-dsc-rubl-acc     + bf_tt-allsum.sum-dsc-rubl-acc
     4185         bf_tt-allsum-line.sum-dsc-cli-acc        = bf_tt-allsum-line.sum-dsc-cli-acc      + bf_tt-allsum.sum-dsc-cli-acc
     4186         bf_tt-allsum-line.dsc-base-acc           = bf_tt-allsum-line.dsc-base-acc         + bf_tt-allsum.dsc-base-acc
     4187         bf_tt-allsum-line.dsc-rubl-acc           = bf_tt-allsum-line.dsc-rubl-acc         + bf_tt-allsum.dsc-rubl-acc
     4188         bf_tt-allsum-line.dsc-cli-acc            = bf_tt-allsum-line.dsc-cli-acc          + bf_tt-allsum.dsc-cli-acc
     4189         bf_tt-allsum-line.vat-base-acc           = bf_tt-allsum-line.vat-base-acc         + bf_tt-allsum.vat-base-acc
     4190         bf_tt-allsum-line.vat-rubl-acc           = bf_tt-allsum-line.vat-rubl-acc         + bf_tt-allsum.vat-rubl-acc
     4191         bf_tt-allsum-line.vat-cli-acc            = bf_tt-allsum-line.vat-cli-acc          + bf_tt-allsum.vat-cli-acc
     4192         bf_tt-allsum-line.slt-base-acc           = bf_tt-allsum-line.slt-base-acc         + bf_tt-allsum.slt-base-acc
     4193         bf_tt-allsum-line.slt-rubl-acc           = bf_tt-allsum-line.slt-rubl-acc         + bf_tt-allsum.slt-rubl-acc
     4194         bf_tt-allsum-line.slt-cli-acc            = bf_tt-allsum-line.slt-cli-acc          + bf_tt-allsum.slt-cli-acc
     4195         bf_tt-allsum-line.road-tax-base-acc      = bf_tt-allsum-line.road-tax-base-acc    + bf_tt-allsum.road-tax-base-acc
     4196         bf_tt-allsum-line.road-tax-rubl-acc      = bf_tt-allsum-line.road-tax-rubl-acc    + bf_tt-allsum.road-tax-rubl-acc
     4197         bf_tt-allsum-line.road-tax-cli-acc       = bf_tt-allsum-line.road-tax-cli-acc     + bf_tt-allsum.road-tax-cli-acc
     4198         bf_tt-allsum-line.excise-base-acc        = bf_tt-allsum-line.excise-base-acc      + bf_tt-allsum.excise-base-acc
     4199         bf_tt-allsum-line.excise-rubl-acc        = bf_tt-allsum-line.excise-rubl-acc      + bf_tt-allsum.excise-rubl-acc
     4200         bf_tt-allsum-line.excise-cli-acc         = bf_tt-allsum-line.excise-cli-acc       + bf_tt-allsum.excise-cli-acc
     4201         bf_tt-allsum-line.transport-base-acc     = bf_tt-allsum-line.transport-base-acc   + bf_tt-allsum.transport-base-acc
     4202         bf_tt-allsum-line.transport-rubl-acc     = bf_tt-allsum-line.transport-rubl-acc   + bf_tt-allsum.transport-rubl-acc
     4203         bf_tt-allsum-line.transport-cli-acc      = bf_tt-allsum-line.transport-cli-acc    + bf_tt-allsum.transport-cli-acc
     4204         bf_tt-allsum-line.other-base-acc         = bf_tt-allsum-line.other-base-acc       + bf_tt-allsum.other-base-acc
     4205         bf_tt-allsum-line.other-rubl-acc         = bf_tt-allsum-line.other-rubl-acc       + bf_tt-allsum.other-rubl-acc
     4206         bf_tt-allsum-line.other-cli-acc          = bf_tt-allsum-line.other-cli-acc        + bf_tt-allsum.other-cli-acc
     4207         .
