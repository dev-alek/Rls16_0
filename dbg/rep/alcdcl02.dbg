     4429   procedure paramls-clear :
     4430     define buffer buf_temp-param for temp-param .
     4431     do
     4432     on error undo, return error return-value
     4433     :
     4434       for each buf_temp-param
     4435       on error undo, return error
     4436       :
     4437         delete buf_temp-param .
     4438       end.
     4439     end.
