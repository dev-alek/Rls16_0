     4822   procedure alcdclxl-run-excel :
     4823   define input parameter p-header-filename    as character        no-undo.
     4824   define input parameter p-data-filename      as character        no-undo.
     4825       define variable v-template-file-name    as character    no-undo.
     4826       define variable v-vb-file-name          as character    no-undo.
     4827       define buffer buf_temp-param for temp-param .
     4828   do
     4829   for buf_temp-param
     4830   on error undo, return error
     4831   :
     4832       create buf_temp-param.
     4833       assign
     4834           v-template-file-name    = search( "exe/alcdcl.xlt" )
     4835           v-vb-file-name          = search( "exe/t_form.bas")
     4836       .
     4837       if v-template-file-name = ?
     4838       or v-template-file-name = "":U
     4839       then do:
     4840           message
     4841               "Ошибка имени файла шаблона."
     4842           view-as alert-box error.
     4843       end.
     4844       if v-vb-file-name = ?
     4845       or v-vb-file-name = "":U
     4846       then do:
     4847           message
     4848               "Ошибка имени файла кода обработки."
     4849           view-as alert-box error.
     4850       end.
     4851       run paramls-write in this-procedure (
     4852             input "template":U
     4853           , input "template-file-name":U
     4854           , input v-template-file-name
     4855       ).
     4856       run paramls-write in this-procedure (
     4857             input "template":U
     4858           , input "vb-file-name":U
     4859           , input v-vb-file-name
     4860       ).
     4861       run paramls-write in this-procedure (
     4862             input "data":U
     4863           , input "data-header-filename":U
     4864           , input p-header-filename
     4865       ).
     4866       run paramls-write in this-procedure (
     4867             input "data":U
     4868           , input "data-filename":U
     4869           , input p-data-filename
     4870       ).
     4871       run gbl/macroxlt.p (
     4872           input-output table buf_temp-param
     4873       ) no-error.
     4874       if error-status :error
     4875       then do:
     4876           message
     4877                    vss-workfile vss-revision vss-description
     4878               skip(1)
     4879               skip "Ошибка создания файла Excel."
     4880               skip return-value
     4881               skip trim(error-status :get-message(1))
     4882                    trim(error-status :get-message(2))
     4883                    trim(error-status :get-message(3))
     4884           view-as alert-box error.
     4885           undo, return error .
     4886       end.
     4887   end.
     4888   end procedure.
     4889   procedure alcdclxl-close :
     4890   do
     4891   on error undo, return error
     4892   :
     4893       output stream excel-line close.
     4894       output stream excel-cell close.
     4895       output to value( string( session:temp-directory + "$" + string( g#report-num ) ) + ".txl" ) append.
     4896           export "exe/alcdcl.xlt":U.
     4897           export "exe/t_form.bas":U.
     4898           export v-alcdclxl-cell-file-name.
     4899           export v-alcdclxl-data-file-name.
     4900       output close.
     4901   end.
     4902   end procedure.
