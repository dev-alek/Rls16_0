     2613        cl_tt-clcparts.doc-type = 'акт':U then do:
     2614       assign
     2615         in-vatp-have-vat-sltcl = yes.
     2616     end.
     2617     else do:
     2618       find first in-vatp_doc-attrcl no-lock
     2619         where in-vatp_doc-attrcl.doc-code  = cl_tt-clcparts.out-code
     2620           and in-vatp_doc-attrcl.attr-code = 'envd':U
     2621         no-error .
     2622       if not available in-vatp_doc-attrcl then do:
     2623         assign
     2624           in-vatp-have-vat-sltcl = yes.
     2625       end.
     2626       else do:
