     4210   end.
     4211   end procedure.
     4212   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4213   define new global shared variable g#trdcalib as handle no-undo.
     4214   define temp-table temp-font no-undo
     4215     field fontnum  as integer
     4216     field fontname as character
     4217     field fontsize as character
     4218     field fonttype as character
     4219     field font-h   as integer
     4220     field font-w   as integer
     4221     field v-row    as integer
     4222     field v-col    as integer
     4223     field v-row-lans as integer
     4224     field v-col-lans as integer
     4225   index pi fontnum
     4226   .
     4227   procedure get-font-ini :
     4228     do
     4229     on error undo, return error return-value
     4230     :
     4231   define variable ii as integer   no-undo .
     4232   define variable v-font7 as character no-undo .
     4233   define variable v-font as character no-undo .
     4234   define variable loc-name as character no-undo .
     4235   define variable loc-size as character no-undo .
     4236   define variable loc-type as character no-undo .
     4237   define variable old_H as integer   no-undo .
     4238   define variable old_w as integer   no-undo .
     4239   define variable old-row  as integer   no-undo .
     4240   define variable old-col  as integer   no-undo .
     4241   define variable old-row-lans  as integer   no-undo .
     4242   define variable old-col-lans  as integer   no-undo .
     4243   define variable vv as integer   no-undo .
     4244   empty temp-table temp-font.
     4245     GET-KEY-VALUE SECTION "fonts" KEY "font7" VALUE v-font7 .
     4246       case num-entries (v-font7) :
     4247         when 4 then do:
     4248             assign
     4249               loc-name = entry ( 1 , v-font7 )
     4250               loc-size = entry ( 2 , v-font7 )
     4251               loc-type = entry ( 3 , v-font7 ) + "," +  entry ( 4 , v-font7 )
     4252             .
     4253         end.
     4254         when 3 then do:
     4255             assign
     4256               loc-name = entry ( 1 , v-font7 )
     4257               loc-size = entry ( 2 , v-font7 )
     4258               loc-type = entry ( 3 , v-font7 )
     4259             .
     4260         end.
     4261         when 2 then  do:
     4262             assign
     4263               loc-name = entry ( 1 , v-font7 )
     4264               loc-size = entry ( 2 , v-font7 )
     4265               loc-type = ""
     4266             .
     4267         end.
     4268         when 1 then do:
     4269             assign
     4270               loc-name = trim(entry ( 1 , v-font7 ))
     4271               loc-size = ""
     4272               loc-type = ""
     4273             .
     4274         end.
     4275       end case.
     4276     create temp-font.
     4277     assign
     4278       temp-font.fontnum  = 7
     4279       temp-font.fontname = trim(loc-name)
     4280       temp-font.fontsize = trim(loc-size)
     4281       temp-font.fonttype = trim(loc-type)
     4282       temp-font.v-row    = 62
     4283       temp-font.v-col    = 136
     4284       temp-font.v-row-lans = 43
     4285       temp-font.v-col-lans = 198
     4286     .
     4287     repeat ii = 16 to 100 :
     4288       get-key-value section 'fonts' key 'font' + string(ii)   value v-font  .
     4289       if v-font = "" or v-font = ? then leave.
     4290       case num-entries (v-font) :
     4291         when 4 then do:
     4292             assign
     4293               loc-name = entry ( 1 , v-font )
     4294               loc-size = entry ( 2 , v-font )
     4295               loc-type = entry ( 3 , v-font ) + "," +  entry ( 4 , v-font )
     4296             .
     4297         end.
     4298         when 3 then do:
     4299             assign
     4300               loc-name = entry ( 1 , v-font )
     4301               loc-size = entry ( 2 , v-font )
     4302               loc-type = entry ( 3 , v-font )
     4303             .
     4304         end.
     4305         when 2 then do:
     4306             assign
     4307               loc-name = entry ( 1 , v-font )
     4308               loc-size = entry ( 2 , v-font )
     4309               loc-type = ""
     4310             .
     4311         end.
     4312         when 1 then do:
     4313             assign
     4314               loc-name = trim(entry ( 1 , v-font ))
     4315               loc-size = ""
     4316               loc-type = ""
     4317             .
     4318         end.
     4319       end case.
     4320     create temp-font.
     4321     assign
     4322       temp-font.fontnum  = ii
     4323       temp-font.fontname = trim(loc-name)
     4324       temp-font.fontsize = trim(loc-size)
     4325       temp-font.fonttype = trim(loc-type)
     4326     .
     4327     end.
     4328       for each temp-font :
     4329          vv = integer(entry(2,temp-font.fontsize, "=" )) no-error .
     4330          if  vv = ? then vv =  0 .
     4331           run rep/exfont.p (
     4332             input   temp-font.fontname ,
     4333             input   vv ,
     4334             input   temp-font.fonttype ,
     4335             output  temp-font.font-h   ,
     4336             output  temp-font.font-w   )
     4337           .
     4338       end.
     4339   find first temp-font where  temp-font.fontnum  = 7  .
     4340   old_H = temp-font.font-H .
     4341   old_w = temp-font.font-W .
     4342   old-row = temp-font.v-row .
     4343   old-col = temp-font.v-col .
     4344   old-row-lans = temp-font.v-row-lans .
     4345   old-col-lans = temp-font.v-col-lans .
     4346       for each temp-font where
     4347                temp-font.fontnum  <> 7 :
     4348           assign
     4349               temp-font.v-row    = old_H * old-row / temp-font.font-h
     4350               temp-font.v-col    = old_W * old-col / temp-font.font-W
     4351               temp-font.v-row-lans    = old_H * old-row-lans / temp-font.font-h
     4352               temp-font.v-col-lans    = old_W * old-col-lans / temp-font.font-W
     4353           .
     4354       end.
     4355     end.
     4356   end procedure.
     4357   PROCEDURE How-name :
     4358   define input  parameter h as integer no-undo .
     4359   define input  parameter w as integer no-undo .
     4360   define output parameter n as character  no-undo .
     4361   define variable A4port-H as integer   no-undo init 63.
     4362   define variable A4port-W as integer   no-undo init 136.
     4363   define variable A4lans-H as integer   no-undo init 43.
     4364   define variable A4lans-W as integer   no-undo init 198.
     4365   define variable Strim-W  as integer   no-undo init 278.
     4366   run define-a4-size (
     4367        input ReportFontNum
     4368       ,output A4port-H
     4369       ,output A4port-W
     4370       ,output A4lans-H
     4371       ,output A4lans-W ).
     4372   If w >= 1 and w <= A4port-W Then DO:
     4373     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     4374     If h > A4lans-H  and h <= A4port-H Then n = "A4-port":U.
     4375     If h > A4port-H              Then n = "to-file":U.
     4376   End.
     4377   If w > A4port-W and w <= A4lans-W Then DO:
     4378     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     4379     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     4380     If h > A4port-H              Then n = "to-file":U.
     4381   End.
     4382   If w > A4lans-W and w <= Strim-W Then DO:
     4383     If h >= 1  and h <= A4lans-H Then n = "to-file":U.
     4384     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     4385     If h > A4port-H              Then n = "to-file":U.
     4386   End.
     4387   If w > Strim-W Then DO:
     4388      n = "to-file":U.
     4389   End.
     4390   END PROCEDURE.
     4391   PROCEDURE define-a4-size :
     4392   define input  parameter p-ReportFontNum as integer   no-undo .
     4393   define output parameter A4port-H as integer   no-undo .
     4394   define output parameter A4port-W as integer   no-undo .
     4395   define output parameter A4lans-H as integer   no-undo .
     4396   define output parameter A4lans-W as integer   no-undo .
     4397   if not can-find (first temp-font ) then do:
     4398      run get-font-ini .
     4399   end.
     4400   find first temp-font where temp-font.fontnum = p-ReportFontNum no-error .
     4401   if available temp-font then do:
     4402   assign
     4403     A4port-H = temp-font.v-row
     4404     A4port-W = temp-font.v-col
     4405     A4lans-H = temp-font.v-row-lans
     4406     A4lans-W = temp-font.v-col-lans
     4407   .
     4408   end.
     4409   else do:
     4410   assign
     4411     A4port-H = 63
     4412     A4port-W = 136
     4413     A4lans-H = 43
     4414     A4lans-W = 198
     4415   .
     4416   end.
     4417   END PROCEDURE.
