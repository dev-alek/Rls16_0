     5110     with frame BottomPriFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     5111   do
     5112     on error  undo , return error return-value
     5113     on endkey undo , return error return-value
     5114     on stop   undo , return error return-value
     5115   :
     5116   if session :set-wait-state( "compiler" ) then.
     5117     run alcdclxl-init in this-procedure.
     5118     assign
     5119       v-line        = fill( "-" , 300 )
     5120     .
     5121     define variable v-fact-order-start   as decimal   no-undo .
     5122     define variable v-fact-order-end     as decimal   no-undo .
     5123     run day-begin-fact-order in this-procedure ( input p-begin-date, output v-fact-order-start ).
     5124     run day-begin-fact-order in this-procedure ( input ( p-end-date + 1 ),   output v-fact-order-end ).
     5125     define variable num-obj as integer   no-undo .
     5126     assign num-obj = 0 .
     5127     for each  obj-list : assign num-obj = num-obj + 1 .  end.
     5128     if num-obj = 0  then do:
     5129       message  "Не определен объект для формирования отчета"   view-as alert-box information .
     5130       return error.
     5131     end.
     5132   output stream out-stream to value( string( session:temp-directory +
     5133                                        "rpt" + string( g#report-num ) ) )
     5134                                        page-size  value(62) .
     5135     run print-enclosure in this-procedure .
     5136   define variable v-account as integer init 0 no-undo .
     5137   define variable v-account-lavel as character no-undo .
     5138   define variable v-button-stop as logical no-undo .
     5139   define variable v-kol-spice as integer no-undo .
     5140   define variable v-kol-spice2 as integer no-undo .
     5141   define variable v-kol-spice3 as integer no-undo .
     5142   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     5143   DEFINE BUTTON StopBtn AUTO-END-KEY
     5144        LABEL "Стоп"
     5145        SIZE 10 BY 1.
     5146   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     5147        LABEL "Обработано записей"
     5148         VIEW-AS TEXT
     5149        SIZE 14 BY .67 NO-UNDO.
     5150   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     5151         VIEW-AS TEXT
     5152        SIZE 53.25 BY .67
     5153        FGCOLOR 1  NO-UNDO.
     5154   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     5155         VIEW-AS TEXT
     5156        SIZE 53.25 BY .67
     5157        FGCOLOR 1  NO-UNDO.
     5158   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     5159         VIEW-AS TEXT
     5160        SIZE 53.25 BY .67
     5161        FGCOLOR 1  NO-UNDO.
     5162   DEFINE RECTANGLE RECT-1
     5163        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     5164        SIZE 55.13 BY 4.46.
     5165   DEFINE FRAME InfoFrame
     5166        StopBtn AT ROW 4.25 COL 21.75
     5167        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     5168        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     5169        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     5170        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     5171        RECT-1 AT ROW 1 COL 1
     5172       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     5173            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     5174            TITLE "Процесс"
     5175            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     5176   define variable mFrameView      as logical   no-undo init yes.
     5177     define variable mFramHandle as handle no-undo.
     5178     mFramHandle = frame InfoFrame:handle.
     5179     if  log-manager:logfile-name ne ?
     5180     then DO:
     5181         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     5182         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     5183         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     5184     end.
     5185     mFrameView = not session:batch-mode and mFramHandle:visible.
     5186     if mFrameView
     5187     then do:
     5188       ASSIGN
     5189          FRAME InfoFrame:HIDDEN                           = TRUE
     5190          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     5191     end.
     5192   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     5193   DO:
     5194     IF not StopProcessing THEN
     5195       Message "Вы действительно хотите прервать" SKIP
     5196               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     5197                 UPDATE StopProcessing.
     5198     IF StopProcessing THEN do:
     5199        if mFrameView
     5200        then do:
     5201           HIDE FRAME InfoFrame.
     5202        end.
     5203     End.
     5204   END.
     5205   assign v-account = ( if integer( 100 ) = 0 then 100 else integer( 100 ) ).
     5206     if  log-manager:logfile-name ne ?
     5207     then DO:
     5208         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     5209     end.
     5210     if not session:batch-mode then
     5211     do:
     5212       VIEW FRAME InfoFrame.
     5213       mFrameView = true.
     5214     end.
     5215      v-button-stop = false .
     5216         if mFrameView
     5217         then do:
     5218         if v-button-stop then view STOPBTN in frame InfoFrame.
     5219                          else Hide STOPBTN in frame InfoFrame.
     5220         end.
     5221     assign Counter1  = 0 .
     5222     run find-alc-goods in this-procedure .
     5223     assign Counter1  = 0 .
     5224     run print-alc-retail in this-procedure .
     5225     view stream out-stream frame BottomFrame .
     5226     assign Counter1  = 0 .
     5227     run print-alc-pri in this-procedure .
     5228     run clear-temp-tables in this-procedure .
     5229   if mFrameView
     5230   then do:
     5231      HIDE FRAME InfoFrame.
     5232   end.
     5233     output stream out-stream close.
     5234   if session :set-wait-state( "" ) then.
     5235     if v-is-find-not-binded-gds = yes then do:
     5236       message
     5237         "При формировании отчета были найдены товары входящие в группу товаров алкоголь, но не привязанных к справочнику виды алкогольной продукции. " skip
     5238         "Список товаров выведен в файл nbgoods.txt"
     5239       view-as alert-box information.
     5240     end.
     5241     run alcdclxl-close in this-procedure .
     5242     os-delete value( string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )  .
     5243     os-rename
     5244       value( string( session:temp-directory ) + "$" + string( g#report-num ) + ".txl" )
     5245       value( string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )
     5246     .
     5247     define variable v-user-action   as character no-undo .
     5248     define variable v-printed       as logical   no-undo .
     5249     run gbl/prnfilen.w
     5250         (input  ""
     5251         ,input  8
     5252         ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
     5253         ,input  ReportFontNum
     5254         ,output v-user-action
     5255         ,output v-printed
     5256         ) .
     5257     os-delete value( string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )  .
     5258   end.
     5259   procedure print-enclosure :
     5260   do
     5261   on error undo, return error return-value
     5262   :
     5263     define buffer buf_clients       for ub.clients.
     5264     define buffer buf_alc-sale-lic  for ub.alc-sale-lic.
     5265     define variable v-host-egrip-num  as character format "X(75)" no-undo .
     5266     define variable v-host-egrip-date as character format "X(10)" no-undo .
     5267     define variable v-sertificate     as character format "X(87)" no-undo .
     5268     define variable v-org-address     as character format "X(87)" no-undo .
     5269     define variable v-str             as character no-undo .
     5270     define variable v-log-carret      as logical   no-undo .
     5271     define variable v-host-egrip      as character format "X(87)" no-undo .
     5272     find first obj-list no-lock no-error .
     5273   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5274   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     5275     (input  obj-list.obj-type
     5276     ,input  obj-list.obj-code
     5277     ,output v-host-code
     5278     )  .
     5279     run fmtcli-get-client in this-procedure ( input  'орг':U, input  v-host-code ) .
     5280     run clntattr-value in this-procedure ( input 'орг':U, input v-host-code, input 'egrip-date':U, output v-host-egrip-date, output v-par-type).
     5281     run clntattr-value in this-procedure ( input 'орг':U, input v-host-code, input 'egrip-num':U , output v-host-egrip-num , output v-par-type).
     5282     assign
     5283       v-host-egrip-date = string(date(v-host-egrip-date),"99/99/9999")
     5284       v-str             = substitute("&1, &2", v-fmtcli-addres , v-fmtcli-phone)
     5285       v-host-egrip      = ( if v-host-egrip-date = "?" then "" else v-host-egrip-date + ", " + v-host-egrip-num )
     5286     .
     5287     find first buf_clients no-lock where buf_clients.obj-type = 'орг':U and buf_clients.obj-code = v-host-code no-error .
     5288     if not available buf_clients then do:
     5289       message  substitute ("Не могу найти фирму с кодом: &1", v-host-code)  view-as alert-box error .
     5290       return error.
     5291     end.
     5292      find first buf_alc-sale-lic
     5293           where buf_alc-sale-lic.cli-type = buf_clients.obj-type
     5294             and buf_alc-sale-lic.cli-code = buf_clients.obj-code
     5295             and buf_alc-sale-lic.date-to  > p-end-date
     5296            no-lock
     5297            no-error
     5298            .
     5299     if available buf_alc-sale-lic then do:
     5300         assign
     5301           v-sertificate = substitute( "серия&1 №&2 выдана &3 c &4 по &5"
     5302                                     , buf_alc-sale-lic.seria
     5303                                     , buf_alc-sale-lic.number
     5304                                     , buf_alc-sale-lic.who-are-got
     5305                                     , string( buf_alc-sale-lic.date-from , "99/99/9999")
     5306                                     , string( buf_alc-sale-lic.date-to , "99/99/9999")
     5307                                     )
     5308         .
     5309     end.
     5310     else do:
     5311       assign
     5312         v-sertificate = ""
     5313       .
     5314     end.
     5315     put stream out-stream
     5316       "Приложение № 2":U at 180 skip
     5317       "к приказу":U at 185 skip
     5318       "Центра по лицензированию Калужской области":U at 152 skip
     5319       "от 21 апреля 2006 г. N 114":U at 168 skip(2)
     5320       "Данные об организации":U at 5 skip (1)
     5321       v-line format "X(189)" at 5 skip
     5322       ": Наименование" at 5 ":" at 85 v-fmtcli-name format "X(87)" ":" at 193
     5323       v-line format "X(189)" at 5 skip
     5324       ": ИНН" at 5 ":" at 85 v-fmtcli-inn format "X(87)" ":" at 193
     5325       v-line format "X(189)" at 5 skip
     5326       ": Дата внесения и номер в Единый " at 5 ":" at 85 v-host-egrip ":" at 193
     5327       ": государственный реестр юридических лицр " at 5 ":" at 85 ":" at 193
     5328       v-line format "X(189)" at 5 skip
     5329     .
     5330     run alcdclxl-write-cell-data in this-procedure ( input "orgname":U, input v-fmtcli-name ).
     5331     run alcdclxl-write-cell-data in this-procedure ( input "orghinn":U, input v-fmtcli-inn ).
     5332     run alcdclxl-write-cell-data in this-procedure ( input "hostegrip":U, input v-host-egrip ).
     5333     run alcdclxl-write-cell-data in this-procedure ( input "addr":U, input v-str ).
     5334     run alcdclxl-write-cell-data in this-procedure ( input "sertificate":U, input v-sertificate ).
     5335     do while v-str <> ""  :
     5336       assign
     5337         v-org-address = substring(v-str, 1 , 87)
     5338         v-str         = substring(v-str, 87 , length(v-str))
     5339       .
     5340       if v-log-carret then do:
     5341         put stream out-stream  ":" at 5 ":" at 85 v-org-address ":" at 193 .
     5342       end.
     5343       else do:
     5344         put stream out-stream ": Место нахождения организации, телефон" at 5 ":" at 85 v-org-address ":" at 193 .
     5345         assign v-log-carret = yes .
     5346       end.
     5347     end.
     5348     put stream out-stream v-line format "X(189)" at 5 skip.
     5349     put stream out-stream
     5350       ": Количество обособленных подразделений (торговых объектов)" at 5  ":" at 85  ":" at 193 skip
     5351       ": и (или) общественного питания, их адреса" at 5  ":" at 85  ":" at 193 skip
     5352       v-line format "X(189)" at 5 skip
     5353      .
     5354     put stream out-stream
     5355       ": Серия, номер бланка, регистрационный номер," at 5
     5356       ":" at 85
     5357       v-sertificate
     5358       ":" at 193
     5359       ": срок действия лицензии, кем выдана" at 5
     5360       ":" at 85
     5361       ":" at 193
     5362       v-line format "X(189)" at 5 skip
     5363     .
     5364     page stream out-stream.
     5365     down stream out-stream 1 .
     5366   end.
     5367   end procedure.
     5368   procedure find-alc-goods :
     5369   do
     5370   on error undo, return error return-value
     5371   :
     5372     define buffer buf_alc-type      for ub.alc-type.
     5373     define buffer buf_alc-type-gds  for ub.alc-type-gds.
     5374     define buffer buf_goods         for ub.goods.
     5375     define frame f-nbgoods
     5376           buf_goods.artic     no-label format "X(10)"     space(0)
     5377           buf_goods.prod-code no-label format ">>>>>>>>9" space(0)
     5378           buf_goods.prod-type no-label format "X(10)"     space(0)
     5379           buf_goods.gds-name  no-label format "X(40)"     space(0)
     5380     with width 232 down stream-io no-labels no-box.
     5381     define variable v-gds-grp-code  as integer   no-undo .
     5382     empty temp-table tt-gds.
     5383     empty temp-table tt-alc-type.
     5384     for each buf_alc-type no-lock :
     5385       create tt-alc-type.
     5386       buffer-copy buf_alc-type to tt-alc-type.
     5387       for each buf_alc-type-gds no-lock where buf_alc-type-gds.alc-type-inner-code = buf_alc-type.alc-type-inner-code
     5388         , first buf_goods no-lock where buf_goods.gds-code = buf_alc-type-gds.gds-code
     5389       :
     5390         assign Counter1 = Counter1 + 1.
     5391   IF ( Counter1 modulo v-account = 0 )  then DO:
     5392    Assign
     5393       v-kol-spice = (50 - LENGTH('Заполняем список алкогольных товаров')) / 2
     5394       RecordsString = fill(' ',v-kol-spice) + string('Заполняем список алкогольных товаров')
     5395       .
     5396             if  log-manager:logfile-name ne ?
     5397             then DO:
     5398                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     5399             end.
     5400              if mFrameView
     5401              then do:
     5402               DISPLAY
     5403                 Counter1 @ RecordsDone
     5404                 RecordsString   @ RecordsString
     5405                 WITH FRAME InfoFrame.
     5406              end.
     5407   End.
     5408      if v-button-stop then  DO:
     5409            if mFrameView
     5410            then
     5411               PROCESS EVENTS.
     5412            IF StopProcessing THEN DO:
     5413            RETURN error.
     5414            End.
     5415      end.
     5416         find first tt-gds no-lock where tt-gds.gds-code = buf_goods.gds-code no-error .
     5417         if not available tt-gds then do:
     5418           create tt-gds.
     5419           buffer-copy buf_goods to tt-gds .
     5420           assign
     5421             tt-gds.alc-type-code = buf_alc-type.alc-type-code
     5422             tt-gds.alc-type-name = buf_alc-type.alc-type-name
     5423             tt-gds.alc-type-inner-code = buf_alc-type.alc-type-inner-code
     5424           .
     5425         end.
     5426       end.
     5427     end.
     5428   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5429   empty temp-table thbjattr_thbj-attr.
     5430   run adm/shattri.p (
     5431      input "get":U
     5432     ,input ''
     5433     ,input 0
     5434     ,input 'report-glob':U
     5435     ,input  ""
     5436     ,output v-value-character
     5437     ,output v-value-date
     5438     ,output v-value-decimal
     5439     ,output v-value-integer
     5440     ,output v-value-logical
     5441     ,output par-type
     5442     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     5443     ) no-error .
     5444   for each thbjattr_thbj-attr :
     5445       if thbjattr_thbj-attr.prop-code = 'alcgrpgd' then  v-par-val =  string(thbjattr_thbj-attr.property-value-integer) .
     5446   end.
     5447     assign
     5448       v-gds-grp-code = integer(v-par-val)
     5449     .
     5450     for each buf_goods no-lock
     5451       where buf_goods.grp-code = v-gds-grp-code
     5452     :
     5453       find first tt-gds no-lock where tt-gds.gds-code = buf_goods.gds-code no-error .
     5454       assign Counter1 = Counter1 + 1.
     5455   IF ( Counter1 modulo v-account = 0 )  then DO:
     5456    Assign
     5457       v-kol-spice = (50 - LENGTH('Заполняем список алкогольных товаров')) / 2
     5458       RecordsString = fill(' ',v-kol-spice) + string('Заполняем список алкогольных товаров')
     5459       .
     5460             if  log-manager:logfile-name ne ?
     5461             then DO:
     5462                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     5463             end.
     5464              if mFrameView
     5465              then do:
     5466               DISPLAY
     5467                 Counter1 @ RecordsDone
     5468                 RecordsString   @ RecordsString
     5469                 WITH FRAME InfoFrame.
     5470              end.
     5471   End.
     5472      if v-button-stop then  DO:
     5473            if mFrameView
     5474            then
     5475               PROCESS EVENTS.
     5476            IF StopProcessing THEN DO:
     5477            RETURN error.
     5478            End.
     5479      end.
     5480       if not available tt-gds then do:
     5481         if v-is-find-not-binded-gds = no then do:
     5482           output to value ("nbgoods.txt").
     5483         end.
     5484         assign v-is-find-not-binded-gds = yes .
     5485         display  buf_goods.artic " "   buf_goods.prod-code " "    buf_goods.prod-type " "   buf_goods.gds-name  with frame f-nbgoods.
     5486         down 1.
     5487       end.
     5488     end.
     5489     output close.
     5490   end.
     5491   end procedure.
     5492   procedure find-sert :
     5493   define input  parameter p-cli-type            like ub.trn-doc.cli-type no-undo .
     5494   define input  parameter p-cli-code            like ub.trn-doc.cli-code no-undo .
     5495   define input  parameter p-alc-type-inner-code like ub.alc-type.alc-type-inner-code .
     5496   define output parameter p-sert      as character          no-undo .
     5497   define output parameter p-sert-give as character          no-undo .
     5498   define buffer buf_alc-supp-lic      for ub.alc-supp-lic.
     5499   define buffer buf_alc-supp-lic-type for ub.alc-supp-lic-type.
     5500   do
     5501   on error undo, return error return-value
     5502   :
     5503     for each   buf_alc-supp-lic
     5504          where buf_alc-supp-lic.cli-type = p-cli-type
     5505            and buf_alc-supp-lic.cli-code = p-cli-code
     5506            and buf_alc-supp-lic.date-to  > p-end-date
     5507          no-lock
     5508          :
     5509          IF buf_alc-supp-lic.all-type = 0 then do:
     5510             find first buf_alc-supp-lic-type
     5511                  where buf_alc-supp-lic-type.alc-supp-lic-code   = buf_alc-supp-lic.alc-supp-lic-code
     5512                  and buf_alc-supp-lic-type.alc-type-inner-code = p-alc-type-inner-code
     5513                  no-lock
     5514                  no-error.
     5515             if not available buf_alc-supp-lic-type then do:
     5516                next.
     5517             end.
     5518         end.
     5519         assign
     5520           p-sert       =  substitute( "серия &1 № &2 выдана &3 c &4 по &5"
     5521                                     , buf_alc-supp-lic.seria
     5522                                     , buf_alc-supp-lic.number
     5523                                     )
     5524           p-sert-give  = substitute( "выдана &3 c &4 по &5"
     5525                                     , buf_alc-supp-lic.who-are-got
     5526                                     , string( buf_alc-supp-lic.date-from , "99/99/9999")
     5527                                     , string( buf_alc-supp-lic.date-to , "99/99/9999")
     5528                                     )
     5529         .
     5530         return.
     5531     end.
     5532   end.
     5533   end procedure.
     5534   function str-format returns character (val as decimal , v-format as char, v-str-len as integer):
     5535     define variable v-str as character no-undo .
     5536     assign
     5537       v-str = ( if val = 0 then " ------- ":U else replace( trim(string( val , v-format )) , "." , "," ) )
     5538     .
     5539     if length(v-str) < v-str-len then do:
     5540       assign
     5541         v-str = fill(" ", v-str-len - length(v-str)) + v-str
     5542       .
     5543     end.
     5544     return v-str.
     5545   end function.
     5546   procedure create-tt-alc-retail :
     5547   do
     5548   on error undo, return error return-value
     5549   :
     5550     empty temp-table tt-alc-retail.
     5551     define buffer buf_doc-line for ub.doc-line.
     5552     for each tt-alc-type :
     5553       create tt-alc-retail.
     5554       assign
     5555         tt-alc-retail.alc-type-code = tt-alc-type.alc-type-code
     5556         tt-alc-retail.alc-type-name = tt-alc-type.alc-type-name
     5557       .
     5558     end.
     5559     for each tt-gds :
     5560       run get-cli-type in this-procedure ( input tt-gds.prod-code, input tt-gds.prod-type, output v-producer ).
     5561       find first tt-alc-retail where tt-alc-retail.alc-type-code = tt-gds.alc-type-code no-error .
     5562       if not available tt-alc-retail then do:
     5563         create tt-alc-retail.
     5564         assign
     5565           tt-alc-retail.alc-type-code = tt-gds.alc-type-code
     5566           tt-alc-retail.alc-type-name = tt-gds.alc-type-name
     5567           tt-alc-retail.sea-list = tt-gds.list_
     5568         .
     5569       end.
     5570       for each obj-list :
     5571         assign Counter1 = Counter1 + 1.
     5572   IF ( Counter1 modulo v-account = 0 )  then DO:
     5573    Assign
     5574       v-kol-spice = (50 - LENGTH('Формирование декларации об объемах розничной продажи...')) / 2
     5575       RecordsString = fill(' ',v-kol-spice) + string('Формирование декларации об объемах розничной продажи...')
     5576       .
     5577             if  log-manager:logfile-name ne ?
     5578             then DO:
     5579                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     5580             end.
     5581              if mFrameView
     5582              then do:
     5583               DISPLAY
     5584                 Counter1 @ RecordsDone
     5585                 RecordsString   @ RecordsString
     5586                 WITH FRAME InfoFrame.
     5587              end.
     5588   End.
     5589      if v-button-stop then  DO:
     5590            if mFrameView
     5591            then
     5592               PROCESS EVENTS.
     5593            IF StopProcessing THEN DO:
     5594            RETURN error.
     5595            End.
     5596      end.
     5597         find last buf_stk-line no-lock
     5598           where buf_stk-line.obj-type  = obj-list.obj-type
     5599             and buf_stk-line.obj-code  = obj-list.obj-code
     5600             and buf_stk-line.artic     = tt-gds.artic
     5601             and buf_stk-line.prod-type = tt-gds.prod-type
     5602             and buf_stk-line.prod-code = tt-gds.prod-code
     5603             and buf_stk-line.sum-type  = 'cost':U
     5604             and buf_stk-line.cat-id    = '##,##'
     5605             and buf_stk-line.fact-order < v-fact-order-start
     5606         use-index category no-error .
     5607         if available buf_stk-line then do:
     5608           case v-producer :
     5609             when 1 then   assign tt-alc-retail.ost-beg-local  = tt-alc-retail.ost-beg-local  + (buf_stk-line.fact-qnty * tt-gds.ms-base / 10 ) .
     5610             when 2 then  assign tt-alc-retail.ost-beg-region = tt-alc-retail.ost-beg-region + (buf_stk-line.fact-qnty * tt-gds.ms-base / 10 ) .
     5611             when 3 then assign tt-alc-retail.ost-beg-imp    = tt-alc-retail.ost-beg-imp    + (buf_stk-line.fact-qnty * tt-gds.ms-base / 10 ) .
     5612           end case.
     5613         end.
     5614         define variable v-qnty as decimal   no-undo .
     5615         run CalcOborot in this-procedure  ( input 'ie':U,output v-qnty) .
     5616         case v-producer :
     5617           when 1 then   assign tt-alc-retail.pri-local  = tt-alc-retail.pri-local  + (v-qnty * tt-gds.ms-base / 10 ) .
     5618           when 2 then  assign tt-alc-retail.pri-region = tt-alc-retail.pri-region + (v-qnty * tt-gds.ms-base / 10 ) .
     5619           when 3 then assign tt-alc-retail.pri-imp    = tt-alc-retail.pri-imp    + (v-qnty * tt-gds.ms-base / 10 ) .
     5620         end case.
     5621         if num-obj = 1 then run CalcOborot  in this-procedure ( input 'iv':U,output v-qnty)  .
     5622         else                run CalcOborot1 in this-procedure ( input 'iv':U,output v-qnty)  .
     5623         case v-producer :
     5624           when 1 then   assign tt-alc-retail.pri-local  = tt-alc-retail.pri-local  + (v-qnty * tt-gds.ms-base / 10 ) .
     5625           when 2 then  assign tt-alc-retail.pri-region = tt-alc-retail.pri-region + (v-qnty * tt-gds.ms-base / 10 ) .
     5626           when 3 then assign tt-alc-retail.pri-imp    = tt-alc-retail.pri-imp    + (v-qnty * tt-gds.ms-base / 10 ) .
     5627         end case.
     5628         if num-obj = 1 then run CalcOborot  in this-procedure ( input 'rv':U,output v-qnty)  .
     5629         else                run CalcOborot1 in this-procedure ( input 'rv':U,output v-qnty)  .
     5630         case v-producer :
     5631           when 1 then   assign tt-alc-retail.pri-local  = tt-alc-retail.pri-local  + (v-qnty * tt-gds.ms-base / 10 ) .
     5632           when 2 then  assign tt-alc-retail.pri-region = tt-alc-retail.pri-region + (v-qnty * tt-gds.ms-base / 10 ) .
     5633           when 3 then assign tt-alc-retail.pri-imp    = tt-alc-retail.pri-imp    + (v-qnty * tt-gds.ms-base / 10 ) .
     5634         end case.
     5635         run CalcOborot in this-procedure ( input 'es':U,output v-qnty)  .
     5636         case v-producer :
     5637           when 1 then   assign tt-alc-retail.sale-local  = tt-alc-retail.sale-local  + abs(v-qnty * tt-gds.ms-base / 10 ) .
     5638           when 2 then  assign tt-alc-retail.sale-region = tt-alc-retail.sale-region + abs(v-qnty * tt-gds.ms-base / 10 ) .
     5639           when 3 then assign tt-alc-retail.sale-imp    = tt-alc-retail.sale-imp    + abs(v-qnty * tt-gds.ms-base / 10 ) .
     5640         end case.
     5641         run CalcOborot in this-procedure ( input 'rs':U,output v-qnty)  .
     5642         case v-producer :
     5643           when 1 then   assign tt-alc-retail.ret-local  = tt-alc-retail.ret-local  + (v-qnty * tt-gds.ms-base / 10 ) .
     5644           when 2 then  assign tt-alc-retail.ret-region = tt-alc-retail.ret-region + (v-qnty * tt-gds.ms-base / 10 ) .
     5645           when 3 then assign tt-alc-retail.ret-imp    = tt-alc-retail.ret-imp    + (v-qnty * tt-gds.ms-base / 10 ) .
     5646         end case.
     5647         run CalcOborot in this-procedure ( input 're':U,output v-qnty)  .
     5648         case v-producer :
     5649           when 1 then   assign tt-alc-retail.oth-local  = tt-alc-retail.oth-local  - (v-qnty * tt-gds.ms-base / 10 ) .
     5650           when 2 then  assign tt-alc-retail.oth-region = tt-alc-retail.oth-region - (v-qnty * tt-gds.ms-base / 10 ) .
     5651           when 3 then assign tt-alc-retail.oth-imp    = tt-alc-retail.oth-imp    - (v-qnty * tt-gds.ms-base / 10 ) .
     5652         end case.
     5653         run CalcOborot in this-procedure ( input 'vt':U,output v-qnty)  .
     5654         case v-producer :
     5655           when 1 then   assign tt-alc-retail.oth-local  = tt-alc-retail.oth-local  - (v-qnty * tt-gds.ms-base / 10 ) .
     5656           when 2 then  assign tt-alc-retail.oth-region = tt-alc-retail.oth-region - (v-qnty * tt-gds.ms-base / 10 ) .
     5657           when 3 then assign tt-alc-retail.oth-imp    = tt-alc-retail.oth-imp    - (v-qnty * tt-gds.ms-base / 10 ) .
     5658         end case.
     5659         run CalcOborot in this-procedure ( input 'vp':U,output v-qnty)  .
     5660         case v-producer :
     5661           when 1 then   assign tt-alc-retail.oth-local  = tt-alc-retail.oth-local  - (v-qnty * tt-gds.ms-base / 10 ) .
     5662           when 2 then  assign tt-alc-retail.oth-region = tt-alc-retail.oth-region - (v-qnty * tt-gds.ms-base / 10 ) .
     5663           when 3 then assign tt-alc-retail.oth-imp    = tt-alc-retail.oth-imp    - (v-qnty * tt-gds.ms-base / 10 ) .
     5664         end case.
     5665         run CalcOborot in this-procedure ( input 'ee':U,output v-qnty)  .
     5666         case v-producer :
     5667           when 1 then   assign tt-alc-retail.oth-local  = tt-alc-retail.oth-local  + abs(v-qnty * tt-gds.ms-base / 10 ) .
     5668           when 2 then  assign tt-alc-retail.oth-region = tt-alc-retail.oth-region + abs(v-qnty * tt-gds.ms-base / 10 ) .
     5669           when 3 then assign tt-alc-retail.oth-imp    = tt-alc-retail.oth-imp    + abs(v-qnty * tt-gds.ms-base / 10 ) .
     5670         end case.
     5671         if num-obj = 1 then run CalcOborot  in this-procedure ( input 'ev':U,output v-qnty)  .
     5672         else                run CalcOborot1 in this-procedure ( input 'ev':U,output v-qnty)  .
     5673         case v-producer :
     5674           when 1 then   assign tt-alc-retail.oth-local  = tt-alc-retail.oth-local  + abs(v-qnty * tt-gds.ms-base / 10 ) .
     5675           when 2 then  assign tt-alc-retail.oth-region = tt-alc-retail.oth-region + abs(v-qnty * tt-gds.ms-base / 10 ) .
     5676           when 3 then assign tt-alc-retail.oth-imp    = tt-alc-retail.oth-imp    + abs(v-qnty * tt-gds.ms-base / 10 ) .
     5677         end case.
     5678         run CalcOborot in this-procedure ( input 'ep':U,output v-qnty)  .
     5679         case v-producer :
     5680           when 1 then   assign tt-alc-retail.oth-local  = tt-alc-retail.oth-local  + abs(v-qnty * tt-gds.ms-base / 10 ) .
     5681           when 2 then  assign tt-alc-retail.oth-region = tt-alc-retail.oth-region + abs(v-qnty * tt-gds.ms-base / 10 ) .
     5682           when 3 then assign tt-alc-retail.oth-imp    = tt-alc-retail.oth-imp    + abs(v-qnty * tt-gds.ms-base / 10 ) .
     5683         end case.
     5684         run CalcOborot in this-procedure ( input 'we':U,output v-qnty)  .
     5685         case v-producer :
     5686           when 1 then   assign tt-alc-retail.oth-local  = tt-alc-retail.oth-local  + abs(v-qnty * tt-gds.ms-base / 10 ) .
     5687           when 2 then  assign tt-alc-retail.oth-region = tt-alc-retail.oth-region + abs(v-qnty * tt-gds.ms-base / 10 ) .
     5688           when 3 then assign tt-alc-retail.oth-imp    = tt-alc-retail.oth-imp    + abs(v-qnty * tt-gds.ms-base / 10 ) .
     5689         end case.
     5690         run CalcOborot in this-procedure  ( input 'im':U,output v-qnty) .
     5691         case v-producer :
     5692           when 1 then   assign tt-alc-retail.oth-local  = tt-alc-retail.oth-local  - abs(v-qnty * tt-gds.ms-base / 10 ) .
     5693           when 2 then  assign tt-alc-retail.oth-region = tt-alc-retail.oth-region - abs(v-qnty * tt-gds.ms-base / 10 ) .
     5694           when 3 then assign tt-alc-retail.oth-imp    = tt-alc-retail.oth-imp    - abs(v-qnty * tt-gds.ms-base / 10 ) .
     5695         end case.
     5696         run CalcOborot in this-procedure ( input 'em':U,output v-qnty)  .
     5697         case v-producer :
     5698           when 1 then   assign tt-alc-retail.oth-local  = tt-alc-retail.oth-local  + abs(v-qnty * tt-gds.ms-base / 10 ) .
     5699           when 2 then  assign tt-alc-retail.oth-region = tt-alc-retail.oth-region + abs(v-qnty * tt-gds.ms-base / 10 ) .
     5700           when 3 then assign tt-alc-retail.oth-imp    = tt-alc-retail.oth-imp    + abs(v-qnty * tt-gds.ms-base / 10 ) .
     5701         end case.
     5702         run CalcOborot in this-procedure ( input 'wm':U,output v-qnty)  .
     5703         case v-producer :
     5704           when 1 then   assign tt-alc-retail.oth-local  = tt-alc-retail.oth-local  + abs(v-qnty * tt-gds.ms-base / 10 ) .
     5705           when 2 then  assign tt-alc-retail.oth-region = tt-alc-retail.oth-region + abs(v-qnty * tt-gds.ms-base / 10 ) .
     5706           when 3 then assign tt-alc-retail.oth-imp    = tt-alc-retail.oth-imp    + abs(v-qnty * tt-gds.ms-base / 10 ) .
     5707         end case.
     5708       end.
     5709       for each tt-doc :
     5710         find first buf_doc-line no-lock
     5711           where buf_doc-line.doc-code  = tt-doc.doc-code
     5712             and buf_doc-line.artic     = tt-gds.artic
     5713             and buf_doc-line.prod-type = tt-gds.prod-type
     5714             and buf_doc-line.prod-code = tt-gds.prod-code
     5715         no-error .
     5716         if not available buf_doc-line then next .
     5717         case buf_doc-line.ext-doc-type :
     5718           when  'ie':U or
     5719           when  'iv':U or
     5720           when  'rv':U then do:
     5721             case v-producer :
     5722               when 1 then   assign tt-alc-retail.pri-local  = tt-alc-retail.pri-local  - (buf_doc-line.fact-qnty * tt-gds.ms-base / 10 ) .
     5723               when 2 then  assign tt-alc-retail.pri-region = tt-alc-retail.pri-region - (buf_doc-line.fact-qnty * tt-gds.ms-base / 10 ) .
     5724               when 3 then assign tt-alc-retail.pri-imp    = tt-alc-retail.pri-imp    - (buf_doc-line.fact-qnty * tt-gds.ms-base / 10 ) .
     5725             end case.
     5726           end.
     5727           when 'es':U then do:
     5728             case v-producer :
     5729               when 1 then   assign tt-alc-retail.sale-local  = tt-alc-retail.sale-local  - (buf_doc-line.fact-qnty * tt-gds.ms-base / 10 ) .
     5730               when 2 then  assign tt-alc-retail.sale-region = tt-alc-retail.sale-region - (buf_doc-line.fact-qnty * tt-gds.ms-base / 10 ) .
     5731               when 3 then assign tt-alc-retail.sale-imp    = tt-alc-retail.sale-imp    - (buf_doc-line.fact-qnty * tt-gds.ms-base / 10 ) .
     5732             end case.
     5733           end.
     5734           when 'rs':U then do:
     5735             case v-producer :
     5736               when 1 then   assign tt-alc-retail.ret-local  = tt-alc-retail.ret-local  - (buf_doc-line.fact-qnty * tt-gds.ms-base / 10 ) .
     5737               when 2 then  assign tt-alc-retail.ret-region = tt-alc-retail.ret-region - (buf_doc-line.fact-qnty * tt-gds.ms-base / 10 ) .
     5738               when 3 then assign tt-alc-retail.ret-imp    = tt-alc-retail.ret-imp    - (buf_doc-line.fact-qnty * tt-gds.ms-base / 10 ) .
     5739             end case.
     5740           end.
     5741           when 're':U or
     5742           when  'im':U then do:
     5743             case v-producer :
     5744               when 1 then   assign tt-alc-retail.oth-local  = tt-alc-retail.oth-local  + (buf_doc-line.fact-qnty * tt-gds.ms-base / 10 ) .
     5745               when 2 then  assign tt-alc-retail.oth-region = tt-alc-retail.oth-region + (buf_doc-line.fact-qnty * tt-gds.ms-base / 10 ) .
     5746               when 3 then assign tt-alc-retail.oth-imp    = tt-alc-retail.oth-imp    + (buf_doc-line.fact-qnty * tt-gds.ms-base / 10 ) .
     5747             end case.
     5748           end.
     5749           when 'vt':U or
     5750           when 'vp':U  then do:
     5751             case v-producer :
     5752               when 1 then   assign tt-alc-retail.oth-local  = tt-alc-retail.oth-local  + (buf_doc-line.fact-qnty * tt-gds.ms-base / 10 ) .
     5753               when 2 then  assign tt-alc-retail.oth-region = tt-alc-retail.oth-region + (buf_doc-line.fact-qnty * tt-gds.ms-base / 10 ) .
     5754               when 3 then assign tt-alc-retail.oth-imp    = tt-alc-retail.oth-imp    + (buf_doc-line.fact-qnty * tt-gds.ms-base / 10 ) .
     5755             end case.
     5756           end.
     5757           when 'em':U or
     5758           when 'wm':U or
     5759           when 'ev':U or
     5760           when 'ee':U or
     5761           when 'ep':U or
     5762           when 'we':U then do:
     5763             case v-producer :
     5764               when 1 then   assign tt-alc-retail.oth-local  = tt-alc-retail.oth-local  - (buf_doc-line.fact-qnty * tt-gds.ms-base / 10 ) .
     5765               when 2 then  assign tt-alc-retail.oth-region = tt-alc-retail.oth-region - (buf_doc-line.fact-qnty * tt-gds.ms-base / 10 ) .
     5766               when 3 then assign tt-alc-retail.oth-imp    = tt-alc-retail.oth-imp    - (buf_doc-line.fact-qnty * tt-gds.ms-base / 10 ) .
     5767             end case.
     5768           end.
     5769         end.
     5770       end.
     5771       assign
     5772         tt-alc-retail.ost-beg-tot     = tt-alc-retail.ost-beg-local  + tt-alc-retail.ost-beg-region  + tt-alc-retail.ost-beg-imp
     5773         tt-alc-retail.pri-tot         = tt-alc-retail.pri-local      + tt-alc-retail.pri-region      + tt-alc-retail.pri-imp
     5774         tt-alc-retail.sale-tot        = tt-alc-retail.sale-local     + tt-alc-retail.sale-region     + tt-alc-retail.sale-imp
     5775         tt-alc-retail.ret-tot         = tt-alc-retail.ret-local      + tt-alc-retail.ret-region      + tt-alc-retail.ret-imp
     5776         tt-alc-retail.oth-tot         = tt-alc-retail.oth-local      + tt-alc-retail.oth-region      + tt-alc-retail.oth-imp
     5777         tt-alc-retail.ost-end-local   = tt-alc-retail.ost-beg-local  + tt-alc-retail.pri-local       - tt-alc-retail.sale-local  + tt-alc-retail.ret-local  - tt-alc-retail.oth-local
     5778         tt-alc-retail.ost-end-region  = tt-alc-retail.ost-beg-region + tt-alc-retail.pri-region      - tt-alc-retail.sale-region + tt-alc-retail.ret-region - tt-alc-retail.oth-region
     5779         tt-alc-retail.ost-end-imp     = tt-alc-retail.ost-beg-imp    + tt-alc-retail.pri-imp         - tt-alc-retail.sale-imp    + tt-alc-retail.ret-imp    - tt-alc-retail.oth-imp
     5780         tt-alc-retail.ost-end-tot     = tt-alc-retail.ost-beg-tot    + tt-alc-retail.pri-tot         - tt-alc-retail.sale-tot    + tt-alc-retail.ret-tot    - tt-alc-retail.oth-tot
     5781       .
     5782     end.
     5783   end.
     5784   end procedure.
     5785   procedure print-alc-retail :
     5786   do
     5787   on error undo, return error return-value
     5788   :
     5789     page stream out-stream.
     5790     view stream out-stream frame TopPriFrame .
     5791     view stream out-stream frame BottomPriFrame .
     5792     define variable line-num as integer   no-undo .
     5793     run create-tt-alc-retail in this-procedure .
     5794     assign  v-is-first-page-of-report  = yes .
     5795     for each tt-alc-retail no-lock break by tt-alc-retail.sea-list :
     5796       assign Counter1 = Counter1 + 1.
     5797   IF ( Counter1 modulo v-account = 0 )  then DO:
     5798    Assign
     5799       v-kol-spice = (50 - LENGTH('Формирование декларации об объемах розничной продажи...')) / 2
     5800       RecordsString = fill(' ',v-kol-spice) + string('Формирование декларации об объемах розничной продажи...')
     5801       .
     5802             if  log-manager:logfile-name ne ?
     5803             then DO:
     5804                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     5805             end.
     5806              if mFrameView
     5807              then do:
     5808               DISPLAY
     5809                 Counter1 @ RecordsDone
     5810                 RecordsString   @ RecordsString
     5811                 WITH FRAME InfoFrame.
     5812              end.
     5813   End.
     5814      if v-button-stop then  DO:
     5815            if mFrameView
     5816            then
     5817               PROCESS EVENTS.
     5818            IF StopProcessing THEN DO:
     5819            RETURN error.
     5820            End.
     5821      end.
     5822       accumulate  tt-alc-retail.ost-beg-tot      (total) .
     5823       accumulate  tt-alc-retail.ost-beg-local    (total) .
     5824       accumulate  tt-alc-retail.ost-beg-region   (total) .
     5825       accumulate  tt-alc-retail.ost-beg-imp      (total) .
     5826       accumulate  tt-alc-retail.pri-tot          (total) .
     5827       accumulate  tt-alc-retail.pri-local        (total) .
     5828       accumulate  tt-alc-retail.pri-region       (total) .
     5829       accumulate  tt-alc-retail.pri-imp          (total) .
     5830       accumulate  tt-alc-retail.sale-tot         (total) .
     5831       accumulate  tt-alc-retail.sale-local       (total) .
     5832       accumulate  tt-alc-retail.sale-region      (total) .
     5833       accumulate  tt-alc-retail.sale-imp         (total) .
     5834       accumulate  tt-alc-retail.ret-tot          (total) .
     5835       accumulate  tt-alc-retail.ret-local        (total) .
     5836       accumulate  tt-alc-retail.ret-region       (total) .
     5837       accumulate  tt-alc-retail.ret-imp          (total) .
     5838       accumulate  tt-alc-retail.oth-tot          (total) .
     5839       accumulate  tt-alc-retail.oth-local        (total) .
     5840       accumulate  tt-alc-retail.oth-region       (total) .
     5841       accumulate  tt-alc-retail.oth-imp          (total) .
     5842       accumulate  tt-alc-retail.ost-end-tot      (total) .
     5843       accumulate  tt-alc-retail.ost-end-local    (total) .
     5844       accumulate  tt-alc-retail.ost-end-region   (total) .
     5845       accumulate  tt-alc-retail.ost-end-imp      (total) .
     5846       if v-is-first-page-of-report = yes and line-counter(out-stream) = page-size( out-stream) then do:
     5847         assign v-is-first-page-of-report = no .
     5848       end.
     5849       display stream out-stream
     5850         tt-alc-retail.alc-type-name
     5851         tt-alc-retail.alc-type-code
     5852         tt-alc-retail.ost-beg-tot
     5853         tt-alc-retail.ost-beg-local
     5854         tt-alc-retail.ost-beg-region
     5855         tt-alc-retail.ost-beg-imp
     5856         tt-alc-retail.pri-tot
     5857         tt-alc-retail.pri-local
     5858         tt-alc-retail.pri-region
     5859         tt-alc-retail.pri-imp
     5860         tt-alc-retail.sale-tot
     5861         tt-alc-retail.sale-local
     5862         tt-alc-retail.sale-region
     5863         tt-alc-retail.sale-imp
     5864         tt-alc-retail.ret-tot
     5865         tt-alc-retail.ret-local
     5866         tt-alc-retail.ret-region
     5867         tt-alc-retail.ret-imp
     5868         tt-alc-retail.oth-tot
     5869         tt-alc-retail.oth-local
     5870         tt-alc-retail.oth-region
     5871         tt-alc-retail.oth-imp
     5872         tt-alc-retail.ost-end-tot
     5873         tt-alc-retail.ost-end-local
     5874         tt-alc-retail.ost-end-region
     5875         tt-alc-retail.ost-end-imp
     5876         sym1  sym2  sym3  sym4  sym5  sym6  sym7  sym8  sym9  sym10
     5877         sym11 sym12 sym13 sym14 sym15 sym16 sym17 sym18 sym19 sym20
     5878         sym21 sym22 sym23 sym24 sym25 sym26 sym27
     5879       with frame f-alc-retail.
     5880       down stream out-stream 1 with frame f-alc-retail.
     5881       put stream out-stream unformatted fill( "-" , 230 ) skip.
     5882       run alcdclxl-sheet1-write-line-data (
     5883           tt-alc-retail.alc-type-name
     5884         , tt-alc-retail.alc-type-code
     5885         , tt-alc-retail.ost-beg-tot
     5886         , tt-alc-retail.ost-beg-local
     5887         , tt-alc-retail.ost-beg-region
     5888         , tt-alc-retail.ost-beg-imp
     5889         , tt-alc-retail.pri-tot
     5890         , tt-alc-retail.pri-local
     5891         , tt-alc-retail.pri-region
     5892         , tt-alc-retail.pri-imp
     5893         , tt-alc-retail.sale-tot
     5894         , tt-alc-retail.sale-local
     5895         , tt-alc-retail.sale-region
     5896         , tt-alc-retail.sale-imp
     5897         , tt-alc-retail.ret-tot
     5898         , tt-alc-retail.ret-local
     5899         , tt-alc-retail.ret-region
     5900         , tt-alc-retail.ret-imp
     5901         , tt-alc-retail.oth-tot
     5902         , tt-alc-retail.oth-local
     5903         , tt-alc-retail.oth-region
     5904         , tt-alc-retail.oth-imp
     5905         , tt-alc-retail.ost-end-tot
     5906         , tt-alc-retail.ost-end-local
     5907         , tt-alc-retail.ost-end-region
     5908         , tt-alc-retail.ost-end-imp
     5909       ) .
     5910       assign   line-num = line-num + 1 .
     5911     end.
     5912     display stream out-stream
     5913       " ИТОГО "                                      @  tt-alc-retail.alc-type-name
     5914         accum total tt-alc-retail.ost-beg-tot        @  tt-alc-retail.ost-beg-tot
     5915         accum total tt-alc-retail.ost-beg-local      @  tt-alc-retail.ost-beg-local
     5916         accum total tt-alc-retail.ost-beg-region     @  tt-alc-retail.ost-beg-region
     5917         accum total tt-alc-retail.ost-beg-imp        @  tt-alc-retail.ost-beg-imp
     5918         accum total tt-alc-retail.pri-tot            @  tt-alc-retail.pri-tot
     5919         accum total tt-alc-retail.pri-local          @  tt-alc-retail.pri-local
     5920         accum total tt-alc-retail.pri-region         @  tt-alc-retail.pri-region
     5921         accum total tt-alc-retail.pri-imp            @  tt-alc-retail.pri-imp
     5922         accum total tt-alc-retail.sale-tot           @  tt-alc-retail.sale-tot
     5923         accum total tt-alc-retail.sale-local         @  tt-alc-retail.sale-local
     5924         accum total tt-alc-retail.sale-region        @  tt-alc-retail.sale-region
     5925         accum total tt-alc-retail.sale-imp           @  tt-alc-retail.sale-imp
     5926         accum total tt-alc-retail.ret-tot            @  tt-alc-retail.ret-tot
     5927         accum total tt-alc-retail.ret-local          @  tt-alc-retail.ret-local
     5928         accum total tt-alc-retail.ret-region         @  tt-alc-retail.ret-region
     5929         accum total tt-alc-retail.ret-imp            @  tt-alc-retail.ret-imp
     5930         accum total tt-alc-retail.oth-tot            @  tt-alc-retail.oth-tot
     5931         accum total tt-alc-retail.oth-local          @  tt-alc-retail.oth-local
     5932         accum total tt-alc-retail.oth-region         @  tt-alc-retail.oth-region
     5933         accum total tt-alc-retail.oth-imp            @  tt-alc-retail.oth-imp
     5934         accum total tt-alc-retail.ost-end-tot        @  tt-alc-retail.ost-end-tot
     5935         accum total tt-alc-retail.ost-end-local      @  tt-alc-retail.ost-end-local
     5936         accum total tt-alc-retail.ost-end-region     @  tt-alc-retail.ost-end-region
     5937         accum total tt-alc-retail.ost-end-imp        @  tt-alc-retail.ost-end-imp
     5938         sym1  sym2  sym3  sym4  sym5  sym6  sym7  sym8  sym9  sym10
     5939         sym11 sym12 sym13 sym14 sym15 sym16 sym17 sym18 sym19 sym20
     5940         sym21 sym22 sym23 sym24 sym25 sym26 sym27
     5941     with frame f-alc-retail.
     5942     down stream out-stream 1 with frame f-alc-retail.
     5943     put stream out-stream unformatted fill( "-" , 230 ) skip.
     5944     put stream out-stream
     5945       skip
     5946       "             М.П."         "Руководитель организации__________________________________________" at 100 skip
     5947       "        Дата_____________" "Главный бухгалтер_________________________________________________" at 100 skip
     5948     .
     5949   line-num = line-num + 2 - 1 .
     5950     run alcdclxl-write-cell-data in this-procedure ( input "Продажа_it_ostbegtot":U, input "=SUM(C2:C" + string(line-num ) + ")").
     5951     run alcdclxl-write-cell-data in this-procedure ( input "Продажа_it_ostbeglocal":U, input "=SUM(D2:D" + string(line-num ) + ")").
     5952     run alcdclxl-write-cell-data in this-procedure ( input "Продажа_it_ostbegregion":U, input "=SUM(E2:E" + string(line-num ) + ")").
     5953     run alcdclxl-write-cell-data in this-procedure ( input "Продажа_it_ostbegimp":U, input "=SUM(F2:F" + string(line-num ) + ")").
     5954     run alcdclxl-write-cell-data in this-procedure ( input "Продажа_it_pritot":U, input "=SUM(G2:G" + string(line-num ) + ")").
     5955     run alcdclxl-write-cell-data in this-procedure ( input "Продажа_it_prilocal":U, input "=SUM(H2:H" + string(line-num ) + ")").
     5956     run alcdclxl-write-cell-data in this-procedure ( input "Продажа_it_priregion":U, input "=SUM(I2:I" + string(line-num ) + ")").
     5957     run alcdclxl-write-cell-data in this-procedure ( input "Продажа_it_priimp":U, input "=SUM(J2:J" + string(line-num ) + ")").
     5958     run alcdclxl-write-cell-data in this-procedure ( input "Продажа_it_saletot":U, input "=SUM(K2:K" + string(line-num ) + ")").
     5959     run alcdclxl-write-cell-data in this-procedure ( input "Продажа_it_salelocal":U, input "=SUM(L2:L" + string(line-num ) + ")").
     5960     run alcdclxl-write-cell-data in this-procedure ( input "Продажа_it_saleregion":U, input "=SUM(M2:M" + string(line-num ) + ")").
     5961     run alcdclxl-write-cell-data in this-procedure ( input "Продажа_it_saleimp":U, input "=SUM(N2:N" + string(line-num ) + ")").
     5962     run alcdclxl-write-cell-data in this-procedure ( input "Продажа_it_rettot":U, input "=SUM(O2:O" + string(line-num ) + ")").
     5963     run alcdclxl-write-cell-data in this-procedure ( input "Продажа_it_retlocal":U, input "=SUM(P2:P" + string(line-num ) + ")").
     5964     run alcdclxl-write-cell-data in this-procedure ( input "Продажа_it_retregion":U, input "=SUM(Q2:Q" + string(line-num ) + ")").
     5965     run alcdclxl-write-cell-data in this-procedure ( input "Продажа_it_retimp":U, input "=SUM(R2:R" + string(line-num ) + ")").
     5966     run alcdclxl-write-cell-data in this-procedure ( input "Продажа_it_othtot":U, input "=SUM(S2:S" + string(line-num ) + ")").
     5967     run alcdclxl-write-cell-data in this-procedure ( input "Продажа_it_othlocal":U, input "=SUM(T2:T" + string(line-num ) + ")").
     5968     run alcdclxl-write-cell-data in this-procedure ( input "Продажа_it_othregion":U, input "=SUM(U2:U" + string(line-num ) + ")").
     5969     run alcdclxl-write-cell-data in this-procedure ( input "Продажа_it_othimp":U, input "=SUM(V2:V" + string(line-num ) + ")").
     5970     run alcdclxl-write-cell-data in this-procedure ( input "Продажа_it_ostendtot":U, input substitute("=C&1+G&1-K&1+O&1-S&1" ,line-num + 1 )) .
     5971     run alcdclxl-write-cell-data in this-procedure ( input "Продажа_it_ostendlocal":U, input substitute("=D&1+H&1-L&1+P&1-T&1" ,line-num + 1 )) .
     5972     run alcdclxl-write-cell-data in this-procedure ( input "Продажа_it_ostendregion":U, input substitute("=E&1+I&1-M&1+Q&1-U&1" ,line-num + 1)) .
     5973     run alcdclxl-write-cell-data in this-procedure ( input "Продажа_it_ostendimp":U, input substitute("=F&1+J&1-N&1+R&1-V&1" ,line-num + 1)) .
     5974   end.
     5975   end procedure.
     5976   procedure get-cli-type :
     5977     define input  parameter p-cli-code like ub.trn-doc.cli-code no-undo .
     5978     define input  parameter p-cli-type like ub.trn-doc.cli-type no-undo .
     5979     define output parameter p-type     as integer            no-undo .
     5980     define variable v-is-local                      as logical   no-undo .
     5981     define variable v-is-producer                   as logical   no-undo .
     5982     define variable v-is-foreign-producer           as logical   no-undo .
     5983    do on error undo, return error return-value :
     5984      run clntattr-value in this-procedure ( input p-cli-type, input p-cli-code, input 'cli-local':U, output v-attr-value, output v-attr-type ) .
     5985      assign v-is-local = logical( v-attr-value ) .
     5986      run clntattr-value in this-procedure ( input p-cli-type, input p-cli-code, input 'cli-alc-producer':U, output v-attr-value, output v-attr-type ) .
     5987      assign v-is-producer = logical ( v-attr-value ) .
     5988      run clntattr-value in this-procedure ( input p-cli-type, input p-cli-code, input 'foreign-producer':U, output v-attr-value, output v-attr-type ) .
     5989      assign v-is-foreign-producer = logical( v-attr-value ) .
     5990      if ( v-is-local = yes ) then assign  p-type = 1 .
     5991      if ( v-is-local = no ) and ( v-is-foreign-producer = no ) then assign  p-type = 2 .
     5992      if v-is-foreign-producer = yes then assign  p-type = 3  .
     5993     end.
     5994   end procedure.
     5995   procedure create-tt-alc-pri :
     5996   do
     5997   on error undo, return error return-value
     5998   :
     5999     define buffer buf_doc-line for ub.doc-line.
     6000     define buffer buf_trn-doc  for ub.trn-doc.
     6001     define buffer buf_parts    for ub.parts.
     6002     define variable v-attr-value      as character no-undo .
     6003     define variable v-attr-type       as character no-undo .
     6004     define variable v-quantity        as character no-undo .
     6005     define variable v-region-code     as character no-undo .
     6006     define variable v-q               as decimal   no-undo .
     6007     empty temp-table tt-alc-pri.
     6008     for each tt-gds,
     6009       each obj-list no-lock,
     6010         each buf_doc-line no-lock
     6011           where buf_doc-line.artic      = tt-gds.artic
     6012             and buf_doc-line.prod-type  = tt-gds.prod-type
     6013             and buf_doc-line.prod-code  = tt-gds.prod-code
     6014             and buf_doc-line.obj-type   = obj-list.obj-type
     6015             and buf_doc-line.obj-code   = obj-list.obj-code
     6016             and buf_doc-line.status_    = 'факт':U
     6017             and buf_doc-line.ext-doc-type = 'ie':U
     6018             and buf_doc-line.fact-order >= v-fact-order-start
     6019             and buf_doc-line.fact-order <  v-fact-order-end
     6020       :
     6021       find first tt-doc where tt-doc.doc-code = buf_doc-line.doc-code no-error .
     6022       if available tt-doc then next .
     6023       assign Counter1 = Counter1 + 1.
     6024   IF ( Counter1 modulo v-account = 0 )  then DO:
     6025    Assign
     6026       v-kol-spice = (50 - LENGTH('Формирование сведений об объемах закупки и поставщиках...')) / 2
     6027       RecordsString = fill(' ',v-kol-spice) + string('Формирование сведений об объемах закупки и поставщиках...')
     6028       .
     6029             if  log-manager:logfile-name ne ?
     6030             then DO:
     6031                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     6032             end.
     6033              if mFrameView
     6034              then do:
     6035               DISPLAY
     6036                 Counter1 @ RecordsDone
     6037                 RecordsString   @ RecordsString
     6038                 WITH FRAME InfoFrame.
     6039              end.
     6040   End.
     6041      if v-button-stop then  DO:
     6042            if mFrameView
     6043            then
     6044               PROCESS EVENTS.
     6045            IF StopProcessing THEN DO:
     6046            RETURN error.
     6047            End.
     6048      end.
     6049       run get-cli-type in this-procedure ( input buf_doc-line.prod-code, input buf_doc-line.prod-type, output v-producer ).
     6050       find first tt-alc-pri
     6051         where tt-alc-pri.alc-type-code  = tt-gds.alc-type-code
     6052           and tt-alc-pri.doc-code  = buf_doc-line.doc-code
     6053           and tt-alc-pri.in-code   = buf_doc-line.doc-code
     6054           and tt-alc-pri.part-code = ""
     6055           and tt-alc-pri.prod-type = v-producer
     6056       no-error .
     6057       if not available tt-alc-pri then do:
     6058         find first buf_trn-doc no-lock where buf_trn-doc.doc-code = buf_doc-line.doc-code .
     6059         run fmtcli-get-client in this-procedure ( input  buf_trn-doc.cli-type, input  buf_trn-doc.cli-code ) .
     6060         run find-sert in this-procedure ( input buf_trn-doc.cli-type
     6061                                         , input buf_trn-doc.cli-code
     6062                                         , input tt-gds.alc-type-inner-code
     6063                                         , output v-sert
     6064                                         , output v-sert-give ) .
     6065         run clntattr-value in this-procedure ( input buf_trn-doc.cli-type, input buf_trn-doc.cli-code, input 'region-code':U, output v-attr-value, output v-attr-type ) .
     6066         create tt-alc-pri.
     6067         assign
     6068           tt-alc-pri.cli-name        = if v-fmtcli-name = "" or v-fmtcli-name = ? then " ------- ":U else v-fmtcli-name
     6069           tt-alc-pri.cli-type        = buf_trn-doc.cli-type
     6070           tt-alc-pri.cli-code        = buf_trn-doc.cli-code
     6071           tt-alc-pri.cli-inn         = if v-fmtcli-inn = "" or v-fmtcli-inn = ? then " ------- ":U else v-fmtcli-inn
     6072           tt-alc-pri.cli-address     = if v-fmtcli-addres = "" then " ------- ":U else v-fmtcli-addres
     6073           tt-alc-pri.cli-region-code = if integer(v-attr-value) = 0 then " ------- ":U else v-attr-value
     6074           tt-alc-pri.lic-num         = v-sert
     6075           tt-alc-pri.lic-give        = v-sert-give
     6076           tt-alc-pri.doc-code        = buf_doc-line.doc-code
     6077           tt-alc-pri.in-code         = buf_doc-line.doc-code
     6078           tt-alc-pri.part-code       = "":u
     6079           tt-alc-pri.fact-date       = buf_trn-doc.fact-date
     6080           tt-alc-pri.alc-type-name        = tt-gds.alc-type-name
     6081           tt-alc-pri.alc-type-code        = tt-gds.alc-type-code
     6082           tt-alc-pri.sea-list        = tt-gds.list_
     6083           tt-alc-pri.prod-type       = v-producer
     6084         .
     6085         run get-cli-type in this-procedure ( input buf_trn-doc.cli-code, input buf_trn-doc.cli-type, output v-producer ).
     6086         assign  tt-alc-pri.supp-type       = if v-producer = 0 then " ------- ":U else string(v-producer,"9")  .
     6087   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input buf_trn-doc.doc-code ,
     6088                           input 'dids':U ,
     6089                          output v-attr-value ,
     6090                          output v-attr-type )  .
     6091         assign v-doc-date = if v-attr-value = "" or v-attr-value = ? then buf_trn-doc.fact-date else date( v-attr-value ) .
     6092   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input buf_trn-doc.doc-code ,
     6093                           input 'nids':U ,
     6094                          output v-attr-value ,
     6095                          output v-attr-type )  .
     6096         assign v-doc-code = if v-attr-value = "" or v-attr-value = ? then buf_trn-doc.doc-code else v-attr-value .
     6097         assign tt-alc-pri.doc-num-date = substitute("&1, &2", v-doc-code , v-doc-date) .
     6098       end.
     6099       assign
     6100         tt-alc-pri.quantity     = tt-alc-pri.quantity + ( buf_doc-line.fact-qnty * tt-gds.ms-base / 10 )
     6101         tt-alc-pri.quantity-str = str-format( tt-alc-pri.quantity, ">>>>>>>>>9.9999", 12 )
     6102       .
     6103     end.
     6104     if p-Pri_Perem = yes then do:
     6105       run CalcPri in this-procedure ( input 'iv':U )  .
     6106       run CalcPri in this-procedure ( input 'rv':U ) .
     6107       run CalcPri in this-procedure ( input 'im':U ) .
     6108     end.
     6109   end.
     6110   end procedure.
     6111   procedure print-alc-pri :
     6112     do on error undo, return error return-value :
     6113     page stream out-stream.
     6114     view stream out-stream frame TopPriFrame .
     6115     view stream out-stream frame BottomPriFrame .
     6116     run create-tt-alc-pri in this-procedure .
     6117     assign
     6118       v-is-first-page-of-report  = yes
     6119       ii = 0
     6120     .
     6121     for each tt-alc-pri no-lock  break by tt-alc-pri.sea-list by tt-alc-pri.cli-code by tt-alc-pri.cli-type by tt-alc-pri.prod-type by tt-alc-pri.fact-date :
     6122       assign Counter1 = Counter1 + 1.
     6123   IF ( Counter1 modulo v-account = 0 )  then DO:
     6124    Assign
     6125       v-kol-spice = (50 - LENGTH('Формирование сведений об объемах закупки и поставщиках...')) / 2
     6126       RecordsString = fill(' ',v-kol-spice) + string('Формирование сведений об объемах закупки и поставщиках...')
     6127       .
     6128             if  log-manager:logfile-name ne ?
     6129             then DO:
     6130                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     6131             end.
     6132              if mFrameView
     6133              then do:
     6134               DISPLAY
     6135                 Counter1 @ RecordsDone
     6136                 RecordsString   @ RecordsString
     6137                 WITH FRAME InfoFrame.
     6138              end.
     6139   End.
     6140      if v-button-stop then  DO:
     6141            if mFrameView
     6142            then
     6143               PROCESS EVENTS.
     6144            IF StopProcessing THEN DO:
     6145            RETURN error.
     6146            End.
     6147      end.
     6148       accumulate tt-alc-pri.quantity (total).
     6149       if v-is-first-page-of-report = yes and line-counter(out-stream) = page-size( out-stream) then do:
     6150         assign v-is-first-page-of-report = no .
     6151       end.
     6152       display stream out-stream
     6153         tt-alc-pri.cli-name
     6154         tt-alc-pri.cli-inn
     6155         tt-alc-pri.cli-address
     6156         tt-alc-pri.cli-region-code
     6157         tt-alc-pri.lic-num
     6158         tt-alc-pri.lic-give
     6159         tt-alc-pri.doc-num-date
     6160         tt-alc-pri.alc-type-name @ v-alc-type-name
     6161         tt-alc-pri.alc-type-code
     6162         tt-alc-pri.prod-type
     6163         tt-alc-pri.quantity-str
     6164         sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     6165       with frame f-alc-pri.
     6166       down stream out-stream 1 with frame f-alc-pri.
     6167       run alcdclxl-sheet2-write-line-data (
     6168           tt-alc-pri.cli-name
     6169         , tt-alc-pri.cli-inn
     6170         , tt-alc-pri.cli-address
     6171         , tt-alc-pri.cli-region-code
     6172         , tt-alc-pri.lic-num
     6173         , tt-alc-pri.lic-give
     6174         , tt-alc-pri.doc-num-date
     6175         , tt-alc-pri.alc-type-name
     6176         , tt-alc-pri.alc-type-code
     6177         , tt-alc-pri.prod-type
     6178         , string( tt-alc-pri.quantity )
     6179       ) .
     6180       if last-of(tt-alc-pri.sea-list) then do:
     6181          put stream out-stream unformatted fill( "-" , 216 ) skip.
     6182       end.
     6183       assign ii = ii + 1  .
     6184     end.
     6185     display stream out-stream
     6186       " ИТОГО " @ tt-alc-pri.cli-name
     6187       str-format( accum total tt-alc-pri.quantity , ">>>>>>>>>9.9999" , 12 )  @ tt-alc-pri.quantity-str
     6188       sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     6189     with frame f-alc-pri.
     6190     down stream out-stream 1 with frame f-alc-pri.
     6191     put stream out-stream unformatted fill( "-" , 216 ) skip.
     6192     run alcdclxl-write-cell-data in this-procedure ( input "Поставщики_it_quantity":U, input string(accum total tt-alc-pri.quantity )).
     6193     put stream out-stream
     6194       skip
     6195       "             М.П."         "Руководитель организации__________________________________________" at 100 skip
     6196       "        Дата_____________" "Главный бухгалтер_________________________________________________" at 100 skip
     6197       "Примечание:  1. Калужская область    2. Другие субъекты Российской Федерации   3. Иностранный производитель" skip
     6198     .
     6199     hide stream out-stream frame BottomPriFrame .
     6200   end.
     6201   end procedure.
     6202   procedure clear-temp-tables :
     6203   do
     6204   on error undo, return error return-value
     6205   :
     6206     empty temp-table tt-alc-type.
     6207     empty temp-table tt-gds.
     6208     empty temp-table tt-alc-retail.
     6209     empty temp-table tt-alc-pri.
     6210   end.
     6211   end procedure.
     6212   procedure CalcOborot :
     6213     do on error undo, return error return-value :
     6214       define input  parameter p-doc-type as character no-undo .
     6215       define output parameter p-qnty  as decimal   no-undo .
     6216       assign  p-qnty = 0 .
     6217       find last buf_stk-line no-lock
     6218         where buf_stk-line.obj-type  = obj-list.obj-type
     6219           and buf_stk-line.obj-code  = obj-list.obj-code
     6220           and buf_stk-line.artic     = tt-gds.artic
     6221           and buf_stk-line.prod-type = tt-gds.prod-type
     6222           and buf_stk-line.prod-code = tt-gds.prod-code
     6223           and buf_stk-line.sum-type  = 'csdt':U + p-doc-type
     6224           and buf_stk-line.cat-id    = '##,##'
     6225           and buf_stk-line.fact-order <= v-fact-order-end
     6226         use-index category no-error .
     6227       if available buf_stk-line then assign p-qnty = p-qnty + buf_stk-line.fact-qnty .
     6228       find last buf_stk-line no-lock
     6229         where buf_stk-line.obj-type  = obj-list.obj-type
     6230           and buf_stk-line.obj-code  = obj-list.obj-code
     6231           and buf_stk-line.artic     = tt-gds.artic
     6232           and buf_stk-line.prod-type = tt-gds.prod-type
     6233           and buf_stk-line.prod-code = tt-gds.prod-code
     6234           and buf_stk-line.sum-type  = 'csdt':U + p-doc-type
     6235           and buf_stk-line.cat-id    = '##,##'
     6236           and buf_stk-line.fact-order < v-fact-order-start
     6237         use-index category no-error .
     6238       if available buf_stk-line then assign p-qnty = p-qnty - buf_stk-line.fact-qnty .
     6239     end.
     6240   end procedure.
     6241   procedure CalcOborot1 :
     6242     do on error undo, return error return-value :
     6243       define input  parameter p-doc-type as character no-undo .
     6244       define output parameter p-qnty  as decimal   no-undo .
     6245       define buffer buf_obj-list for obj-list.
     6246       define buffer buf_doc-line  for ub.doc-line .
     6247       define buffer buf_trn-doc   for ub.trn-doc .
     6248       assign  p-qnty = 0 .
     6249       for each buf_doc-line no-lock
     6250         where buf_doc-line.obj-type     = obj-list.obj-type
     6251           and buf_doc-line.obj-code     = obj-list.obj-code
     6252           and buf_doc-line.artic        = tt-gds.artic
     6253           and buf_doc-line.prod-type    = tt-gds.prod-type
     6254           and buf_doc-line.prod-code    = tt-gds.prod-code
     6255           and buf_doc-line.ext-doc-type = p-doc-type
     6256           and buf_doc-line.status_      = 'факт':U
     6257           and buf_doc-line.fact-order > v-fact-order-start
     6258           and buf_doc-line.fact-order < v-fact-order-end
     6259         :
     6260         find first buf_trn-doc no-lock where buf_trn-doc.doc-code = buf_doc-line.doc-code .
     6261         find first buf_obj-list where buf_obj-list.obj-type = buf_trn-doc.cli-type and buf_obj-list.obj-code = buf_trn-doc.cli-code no-error .
     6262         if not available buf_obj-list then assign p-qnty = p-qnty + buf_doc-line.fact-qnty .
     6263       end.
     6264     end.
     6265   end procedure.
     6266   procedure CalcPri :
     6267     do on error undo, return error return-value :
     6268       define input  parameter p-ext-doc-type as character no-undo .
     6269       define buffer buf_doc-line  for ub.doc-line .
     6270       define buffer buf_parts     for ub.parts .
     6271       define buffer buf_trn-doc   for ub.trn-doc .
     6272       define buffer buf_obj-list  for obj-list.
     6273       for each tt-gds,
     6274         each obj-list no-lock,
     6275           each buf_doc-line no-lock
     6276             where buf_doc-line.artic      = tt-gds.artic
     6277               and buf_doc-line.prod-type  = tt-gds.prod-type
     6278               and buf_doc-line.prod-code  = tt-gds.prod-code
     6279               and buf_doc-line.obj-type   = obj-list.obj-type
     6280               and buf_doc-line.obj-code   = obj-list.obj-code
     6281               and buf_doc-line.status_    = 'факт':U
     6282               and buf_doc-line.ext-doc-type = p-ext-doc-type
     6283               and buf_doc-line.fact-order >= v-fact-order-start
     6284               and buf_doc-line.fact-order <  v-fact-order-end,
     6285           each buf_parts where buf_parts.out-code  = buf_doc-line.doc-code  and
     6286                                buf_parts.obj-type  = obj-list.obj-type      and
     6287                                buf_parts.obj-code  = obj-list.obj-code      and
     6288                                buf_parts.artic     = buf_doc-line.artic     and
     6289                                buf_parts.prod-type = buf_doc-line.prod-type and
     6290                                buf_parts.prod-code = buf_doc-line.prod-code no-lock
     6291         :
     6292         find first tt-doc where tt-doc.doc-code = buf_doc-line.doc-code no-error .
     6293         if available tt-doc then next .
     6294         if ( p-ext-doc-type = 'iv':U or p-ext-doc-type = 'rv':U ) then do:
     6295           find first buf_trn-doc no-lock where buf_trn-doc.doc-code = buf_doc-line.doc-code .
     6296           find first buf_obj-list where buf_obj-list.obj-type = buf_trn-doc.cli-type and buf_obj-list.obj-code = buf_trn-doc.cli-code no-error .
     6297           if available buf_obj-list then next .
     6298         end.
     6299         assign Counter1 = Counter1 + 1.
     6300   IF ( Counter1 modulo v-account = 0 )  then DO:
     6301    Assign
     6302       v-kol-spice = (50 - LENGTH('Формирование сведений об объемах закупки и поставщиках...')) / 2
     6303       RecordsString = fill(' ',v-kol-spice) + string('Формирование сведений об объемах закупки и поставщиках...')
     6304       .
     6305             if  log-manager:logfile-name ne ?
     6306             then DO:
     6307                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     6308             end.
     6309              if mFrameView
     6310              then do:
     6311               DISPLAY
     6312                 Counter1 @ RecordsDone
     6313                 RecordsString   @ RecordsString
     6314                 WITH FRAME InfoFrame.
     6315              end.
     6316   End.
     6317      if v-button-stop then  DO:
     6318            if mFrameView
     6319            then
     6320               PROCESS EVENTS.
     6321            IF StopProcessing THEN DO:
     6322            RETURN error.
     6323            End.
     6324      end.
     6325         run get-cli-type in this-procedure ( input buf_doc-line.prod-code, input buf_doc-line.prod-type, output v-producer ).
     6326         find first tt-alc-pri
     6327           where tt-alc-pri.alc-type-code  = tt-gds.alc-type-code
     6328             and tt-alc-pri.doc-code  = buf_doc-line.doc-code
     6329             and tt-alc-pri.in-code   = buf_parts.in-code
     6330             and tt-alc-pri.part-code = buf_parts.part-code
     6331             and tt-alc-pri.prod-type = v-producer
     6332         no-error .
     6333         if not available tt-alc-pri then do:
     6334           run fmtcli-get-client in this-procedure ( input  buf_parts.supp-type, input  buf_parts.supp-code ) .
     6335           run find-sert in this-procedure ( input buf_parts.supp-type
     6336                                           , input buf_parts.supp-code
     6337                                           , input tt-gds.alc-type-inner-code
     6338                                           , output v-sert
     6339                                           , output v-sert-give ) .
     6340           run clntattr-value in this-procedure ( input buf_parts.supp-type, input buf_parts.supp-code, input 'region-code':U, output v-attr-value, output v-attr-type ) .
     6341           create tt-alc-pri.
     6342           assign
     6343             tt-alc-pri.cli-name        = if v-fmtcli-name = "" or v-fmtcli-name = ? then " ------- ":U else v-fmtcli-name
     6344             tt-alc-pri.cli-type        = buf_parts.supp-type
     6345             tt-alc-pri.cli-code        = buf_parts.supp-code
     6346             tt-alc-pri.cli-inn         = if v-fmtcli-inn = "" or v-fmtcli-inn = ? then " ------- ":U else v-fmtcli-inn
     6347             tt-alc-pri.cli-address     = if v-fmtcli-addres = "" then " ------- ":U else v-fmtcli-addres
     6348             tt-alc-pri.cli-region-code = if integer(v-attr-value) = 0 then " ------- ":U else v-attr-value
     6349             tt-alc-pri.lic-num         = v-sert
     6350             tt-alc-pri.lic-give        = v-sert-give
     6351             tt-alc-pri.alc-type-code   = tt-gds.alc-type-code
     6352             tt-alc-pri.doc-code        = buf_doc-line.doc-code
     6353             tt-alc-pri.in-code         = buf_parts.in-code
     6354             tt-alc-pri.part-code       = buf_parts.part-code
     6355             tt-alc-pri.prod-type       = v-producer
     6356             tt-alc-pri.fact-date       = buf_parts.fact-date
     6357             tt-alc-pri.alc-type-name   = tt-gds.alc-type-name
     6358             tt-alc-pri.sea-list        = tt-gds.list_
     6359           .
     6360           run get-cli-type in this-procedure ( input buf_parts.supp-code, input buf_parts.supp-type, output v-producer ).
     6361           assign  tt-alc-pri.supp-type       = if v-producer = 0 then " ------- ":U else string(v-producer,"9")  .
     6362           find first buf_trn-doc where buf_trn-doc.doc-code = buf_parts.in-code no-lock no-error.
     6363           assign v-doc-date = buf_parts.fact-date.
     6364           if available buf_trn-doc then do:
     6365   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input buf_trn-doc.doc-code ,
     6366                           input 'nids':U ,
     6367                          output v-attr-value ,
     6368                          output v-attr-type )  .
     6369             assign v-doc-code = if v-attr-value = "" or v-attr-value = ? then buf_parts.in-code + " " + buf_parts.out-code else v-attr-value + " " + buf_parts.out-code.
     6370             assign tt-alc-pri.doc-num-date = substitute("&1, &2", v-doc-code , v-doc-date) .
     6371           end.
     6372           else do:
     6373             assign v-doc-code = buf_parts.in-code + " " + buf_parts.out-code.
     6374             assign tt-alc-pri.doc-num-date = substitute("&1, &2", v-doc-code , v-doc-date) .
     6375           end.
     6376         end.
     6377         assign
     6378           tt-alc-pri.quantity     = tt-alc-pri.quantity + ( buf_parts.fact-qnty * tt-gds.ms-base / 10 )
     6379           tt-alc-pri.quantity-str = str-format( tt-alc-pri.quantity, ">>>>>>>>>9.9999", 12 )
     6380         .
     6381       end.
     6382     end.
     6383   end procedure.
