     3927     (input  bf_trn-doc.obj-type
     3928     ,input  bf_trn-doc.obj-code
     3929     ,input  varb-code
     3930     ,input  0
     3931     ,input  bf_trn-doc.fact-order
     3932     ,output vardoc-num
     3933     ,output varprice-sale
     3934     ,output varroad-tax
     3935     ,output varexcise
     3936     )  .
     3937             if varprice-sale = ?
     3938             then do:
     3939               assign
     3940                 varprice-sale = 0
     3941                 varroad-tax   = 0
     3942                 varexcise     = 0
     3943               .
     3944             end.
     3945             assign
     3946               varlastcur-base     = varprice-sale
     3947               varlastcur-road-tax = varroad-tax
     3948               varlastcur-excise   = varexcise
     3949               varcur-base         = varcur-base      + varprice-sale * bf_gds-dtl.fact-qnty
     3950               varcur-road-tax     = varcur-road-tax  + varroad-tax   * bf_gds-dtl.fact-qnty
     3951               varcur-excise       = varcur-excise    + varexcise     * bf_gds-dtl.fact-qnty
     3952               varcur-fact-qnty    = varcur-fact-qnty + bf_gds-dtl.fact-qnty
     3953             .
     3954         end.
     3955       end.
     3956       if varcur-fact-qnty = 0 then do:
     3957         assign
     3958           varcur-base      = varlastcur-base
     3959           varcur-road-tax  = varlastcur-road-tax
     3960           varcur-excise    = varlastcur-excise
     3961         .
     3962       end.
     3963       else do:
     3964         assign
     3965           varcur-base      = varcur-base      / varcur-fact-qnty
     3966           varcur-road-tax  = varcur-road-tax  / varcur-fact-qnty
     3967           varcur-excise    = varcur-excise    / varcur-fact-qnty
     3968         .
     3969       end.
     3970       if varcur-vat-pc = ?
     3971       then do:
     3972         return error substitute ("Нет текущего продажного НДС по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     3973       end.
