     3638   end procedure.
     3639   procedure clcprtsl_calc-line :
     3640   define input  parameter parrec-line as recid no-undo.
     3641   define variable v-tax-date         as   date                     no-undo.
     3642   define variable v-vat-pc           like ub.doc-line.vat-pc       no-undo.
     3643   define variable varr-b             as   character                no-undo.
     3644   define variable varr-btype         as   character                no-undo.
     3645   define variable varcur-base        like ub.gds-dtl.price-base    no-undo.
     3646   define variable varcur-road-tax    like ub.doc-line.road-tax     no-undo.
     3647   define variable varcur-excise      like ub.doc-line.excise       no-undo.
     3648   define variable varcur-vat-pc      like ub.doc-line.vat-pc       no-undo.
     3649   define variable varcur-cons-vat-pc like ub.doc-line.cons-vat-pc  no-undo.
     3650   define variable varcur-slt-pc      like ub.doc-line.slt-pc       no-undo.
     3651   define variable varcur-fact-qnty   like ub.gds-dtl.fact-qnty     no-undo.
     3652   define variable varb-code          like ub.bar-code.b-code       no-undo.
     3653   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     3654   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     3655   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     3656   define variable varexcise          like ub.price-list.excise     no-undo.
     3657   define variable varlastcur-base        like ub.gds-dtl.price-base no-undo.
     3658   define variable varlastcur-road-tax    like ub.gds-dtl.price-base no-undo.
     3659   define variable varlastcur-excise      like ub.gds-dtl.price-base     no-undo.
     3660   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     3661   define variable v-varsum           as decimal                  no-undo.
     3662   define variable varprice-salef as decimal   no-undo .
     3663   define buffer bf_trn-doc             for ub.trn-doc.
     3664   define buffer bf_doc-line            for ub.doc-line.
     3665   define buffer bf_gds-dtl             for ub.gds-dtl.
     3666   define buffer bf_goods               for ub.goods.
     3667   define buffer bf_parts               for ub.parts.
     3668   define buffer bf_sysconf             for ub.sysconf.
     3669   define buffer bf_tt-allsum-line      for tt-allsum-line.
     3670   define buffer bfs_tt-allsum-line     for tt-allsum-line.
     3671   define buffer bfo_tt-allsum-line     for tt-allsum-line.
     3672   define buffer bfos_tt-allsum-line    for tt-allsum-line.
     3673   define buffer buf_parts        for ub.parts.
     3674   v-calcbypart = no.
     3675   do on error undo, return error return-value :
     3676   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     3677   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     3678     (output varr-b
     3679     )  .
     3680     find first bf_doc-line where recid (bf_doc-line) = parrec-line no-lock.
     3681     find first bf_trn-doc where bf_trn-doc.doc-code = bf_doc-line.doc-code no-lock.
     3682     find first bf_goods where bf_goods.artic     = bf_doc-line.artic     and
     3683                               bf_goods.prod-type = bf_doc-line.prod-type and
     3684                               bf_goods.prod-code = bf_doc-line.prod-code no-lock.
     3685     if bf_trn-doc.fact-date <> ?        then do:
     3686       assign v-tax-date = bf_trn-doc.fact-date.
     3687     end.
     3688     else do:
     3689       assign v-tax-date = ?.
     3690     end.
     3691   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3692   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     3693     (input  bf_goods.gds-code
     3694     ,input  '1':U
     3695     ,input  v-tax-date
     3696     ,input  bf_trn-doc.host-code
     3697     ,input  bf_trn-doc.obj-type
     3698     ,input  bf_trn-doc.obj-code
     3699     ,output v-vat-pc
     3700     ) no-error .
     3701     if error-status :error
     3702     or v-vat-pc = ? then do:
     3703        return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     3704     end.
     3705     if bf_goods.gds-type = 'у':U or
     3706        bf_trn-doc.status_ = 'запрос':U then do:
     3707       for each bf_tt-allsum-line
     3708       on error undo, return error return-value
     3709        :
     3710         delete bf_tt-allsum-line.
     3711       end.
     3712       create bf_tt-allsum-line.
     3713       assign
     3714        bf_tt-allsum-line.sum-type = 'основная_сумма':U.
     3715       for each bf_gds-dtl where bf_gds-dtl.doc-code  = bf_doc-line.doc-code  and
     3716                                 bf_gds-dtl.artic     = bf_doc-line.artic     and
     3717                                 bf_gds-dtl.prod-type = bf_doc-line.prod-type and
     3718                                 bf_gds-dtl.prod-code = bf_doc-line.prod-code no-lock on error undo, return error return-value :
     3719         assign
     3720           bf_tt-allsum-line.fact-qnty            =  bf_tt-allsum-line.fact-qnty        + bf_gds-dtl.fact-qnty
     3721           bf_tt-allsum-line.sum-dsc-base-doc     =  bf_tt-allsum-line.sum-dsc-base-doc + (bf_gds-dtl.price-base - bf_gds-dtl.discnt-base) * bf_gds-dtl.fact-qnty
     3722           bf_tt-allsum-line.sum-dsc-rubl-doc     =  bf_tt-allsum-line.sum-dsc-rubl-doc + (bf_gds-dtl.price-rubl - bf_gds-dtl.discnt-rubl) * bf_gds-dtl.fact-qnty
     3723           bf_tt-allsum-line.dsc-base-doc         =  bf_tt-allsum-line.dsc-base-doc     + bf_gds-dtl.discnt-base * bf_gds-dtl.fact-qnty
     3724           bf_tt-allsum-line.dsc-rubl-doc         =  bf_tt-allsum-line.dsc-rubl-doc     + bf_gds-dtl.discnt-rubl * bf_gds-dtl.fact-qnty
     3725           bf_tt-allsum-line.sum-dsc-base-cur     =  bf_tt-allsum-line.sum-dsc-base-cur + (if varr-b = "base" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base / bf_trn-doc.exch-rate * bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     3726           bf_tt-allsum-line.sum-dsc-rubl-cur     =  bf_tt-allsum-line.sum-dsc-rubl-cur + (if varr-b = "rubl" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base * bf_trn-doc.exch-rate / bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     3727           bf_tt-allsum-line.sum-dsc-base-acc     =  bf_tt-allsum-line.sum-dsc-base-acc + bf_doc-line.price-base * bf_gds-dtl.fact-qnty
     3728           bf_tt-allsum-line.sum-dsc-rubl-acc     =  bf_tt-allsum-line.sum-dsc-rubl-acc + bf_doc-line.price-rubl * bf_gds-dtl.fact-qnty
     3729           bf_tt-allsum-line.sum-dsc-cli-acc      =  ?
