     3373       bfspc_tt-allsum.sum-type = 'сумма_по_выкупу_со_знаком':U.
     3374     buffer-copy bf_tt-allsum  except bf_tt-allsum.sum-type  to bfpc_tt-allsum.
     3375     buffer-copy bfs_tt-allsum except bfs_tt-allsum.sum-type to bfspc_tt-allsum.
