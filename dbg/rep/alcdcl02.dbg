     4441   procedure paramls-write :
     4442     define input  parameter p-code     as character no-undo .
     4443     define input  parameter p-sub-code as character no-undo .
     4444     define input  parameter p-value    as character no-undo .
     4445     define buffer buf_temp-param for temp-param .
     4446     do
     4447     on error undo, return error return-value
     4448     :
     4449       find first buf_temp-param
     4450         where buf_temp-param.param-code     = p-code
     4451           and buf_temp-param.param-sub-code = p-sub-code
     4452         no-error .
     4453       if not available buf_temp-param then do:
     4454         create buf_temp-param .
     4455         assign
     4456           buf_temp-param.param-code     = p-code
     4457           buf_temp-param.param-sub-code = p-sub-code
     4458         .
     4459       end.
     4460       assign
     4461         buf_temp-param.param-value = p-value
     4462       .
     4463     end.
     4464   end procedure.
     4465   procedure paramls-read :
     4466     define input  parameter p-code          as character no-undo .
     4467     define input  parameter p-sub-code      as character no-undo .
     4468     define input  parameter p-default-value as character no-undo .
     4469     define output parameter p-value         as character no-undo .
     4470     define buffer buf_temp-param for temp-param .
     4471     do
     4472     on error undo, return error return-value
     4473     :
     4474       find first buf_temp-param
     4475         where buf_temp-param.param-code     = p-code
     4476           and buf_temp-param.param-sub-code = p-sub-code
     4477         no-error .
     4478       if available buf_temp-param then do:
     4479         assign
     4480           p-value = buf_temp-param.param-value
     4481         .
     4482       end.
     4483       else do:
     4484         assign
     4485           p-value = p-default-value
     4486         .
     4487       end.
     4488     end.
     4489   end procedure.
     4490   procedure paramls-append :
     4491     define input  parameter p-code     as character no-undo .
     4492     define input  parameter p-sub-code as character no-undo .
     4493     define input  parameter p-value    as character no-undo .
     4494     define buffer buf_temp-param for temp-param .
     4495     do
     4496     on error undo, return error return-value
     4497     :
     4498       find first buf_temp-param
     4499            where buf_temp-param.param-code     = p-code
     4500              and buf_temp-param.param-sub-code = p-sub-code
     4501         no-error .
     4502       if not available buf_temp-param then do:
     4503         create buf_temp-param .
     4504         assign
     4505           buf_temp-param.param-code     = p-code
     4506           buf_temp-param.param-sub-code = p-sub-code
     4507           buf_temp-param.param-value    = p-value
     4508         .
     4509       end.
     4510       else do:
     4511           assign
     4512               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     4513           .
     4514       end.
     4515     end.
     4516   end procedure.
