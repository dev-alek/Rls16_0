      960   procedure prn-lib-open-stream :
      961     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      962     define input parameter p-page-size    as integer no-undo .
      963     define input parameter p-is-stream    as logical no-undo .
      964     define input parameter p-append       as logical no-undo .
      965     define variable v-report-name as character no-undo .
      966     do
      967       on error undo, return error
      968       :
      969       run prn-lib-get-report-name  in this-procedure (
      970         input parParentProc
      971         ,output v-report-name
      972         ).
      973       if p-is-stream then
      974       do:
      975         if p-append then
      976         do:
      977           output stream PrnLibStream to value( v-report-name )
      978             page-size value(p-page-size) append .
      979         end.
      980         if not p-append then
      981         do:
      982           output stream PrnLibStream to value( v-report-name )
      983             page-size value(p-page-size) .
      984         end.
      985       end.
      986       if not p-is-stream then
      987       do:
      988         if p-append then
      989         do:
      990           output to value( v-report-name )
      991             page-size value(p-page-size) append .
      992         end.
      993         if not p-append then
      994         do:
      995           output to value( v-report-name )
      996             page-size value(p-page-size) .
      997         end.
      998       end.
      999     end.
     1000   end procedure.
     1001   procedure prn-lib-open-exp :
     1002     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1003     define input parameter p-is-stream    as logical no-undo .
     1004     define input parameter p-is-append    as logical no-undo .
     1005     define output parameter p-ReportFileName as char init "report" no-undo.
     1006     define output parameter p-process as logical no-undo .
     1007     define variable glog as logical no-undo .
     1008     do
     1009       on error undo, return error
     1010       :
     1011       SYSTEM-DIALOG GET-FILE p-ReportFileName
     1012         TITLE      "Укажите путь"
     1013         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     1014         ASK-OVERWRITE
     1015         CREATE-TEST-FILE
     1016         SAVE-AS
     1017         USE-FILENAME
     1018         DEFAULT-EXTENSION "txt"
     1019         UPDATE glog
     1020         .
     1021       if not glog then  return.
     1022       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     1023       if p-is-stream then
     1024       do:
     1025         if p-is-append then
     1026         do:
     1027           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1028         end.
     1029         else
     1030         do:
     1031           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1032         end.
     1033       end.
     1034       else
     1035       do:
     1036         if p-is-append then
     1037         do:
     1038           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1039         end.
     1040         else
     1041         do:
     1042           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1043         end.
     1044       end.
     1045       p-process = yes.
     1046     end.
     1047   end procedure.
     1048   procedure prn-lib-get-report-name :
     1049     define input parameter parParentProc  as widget-handle no-undo.
     1050     define output parameter p-report-name as character no-undo .
     1051     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     1052   end procedure.
     1053   procedure prn-lib-reportviewer-report-name :
     1054     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1055     define input parameter p-report-name-html as character no-undo .
     1056     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
     1057   end procedure.
     1058   procedure prn-lib-reportviewer :
     1059     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1060     define input parameter p-report-name-html as character no-undo .
     1061     define input parameter p-param        as character no-undo .
     1062     define variable v-excel           as character no-undo init 'TRUE' .
     1063     define variable v-value-character as character no-undo .
     1064     define variable v-value-integer   as character no-undo .
     1065     define variable v-value-date      as date      no-undo .
     1066     define variable v-value-decimal   as decimal   no-undo .
     1067     define variable rep-excel         as logical   no-undo .
     1068     define variable excel-string      as character no-undo .
     1069     define variable v-param-type      as character no-undo .
     1070     define variable v-tth             as handle    no-undo .
     1071     run adm/shattri.p (
     1072       input "get":U
     1073       ,input  ""
     1074       ,input  0
     1075       ,input  'report-glob':U
     1076       ,input  'rep-excel':U
     1077       ,output v-value-character
     1078       ,output v-value-date
     1079       ,output v-value-decimal
     1080       ,output v-value-integer
     1081       ,output rep-excel
     1082       ,output v-param-type
     1083       ,INPUT-OUTPUT table-handle v-tth
     1084       )  .
     1085     if rep-excel then v-excel = "TRUE" .
     1086     else v-excel = "FALSE" .
     1087     if p-param eq ""
     1088     then
     1089        p-param = "EXCEL:" + v-excel.
     1090     else
     1091        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1092     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1093   end procedure.
     1094   define variable sym1  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1095   define variable sym2  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1096   define variable sym3  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1097   define variable sym4  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1098   define variable sym5  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1099   define variable sym6  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1100   define variable sym7  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1101   define variable sym8  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1102   define variable sym9  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1103   define variable sym10 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1104   define variable sym11 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1105   define variable sym12 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1106   define variable sym13 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1107   define variable sym14 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1108   define variable sym15 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1109   define variable sym16 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1110   define variable sym17 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1111   define variable sym18 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1112   define variable sym19 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1113   define variable sym20 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1114   define variable sym21 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     1115   define variable sym22 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     1116   define variable sym23 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     1117   define variable sym24 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     1118   define variable sym25 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     1119   define variable sym26 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     1120   define variable sym27 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     1121   define variable temp1 as integer   no-undo.
     1122   define variable vss-include-info11 as character format "X(65)" no-undo
     1123   initial "@(#)$Workfile$ $Revision$".
     1124   define variable v-fmtcli-name          as character    no-undo.
     1125   define variable v-fmtcli-engl-name     as character    no-undo.
     1126   define variable v-fmtcli-addres        as character    no-undo.
     1127   define variable v-fmtcli-post-addres   as character    no-undo.
     1128   define variable v-fmtcli-full-addres   as character    no-undo.
     1129   define variable v-fmtcli-phone         as character    no-undo.
     1130   define variable v-fmtcli-inn           as character    no-undo.
     1131   define variable v-fmtcli-kpp           as character    no-undo.
     1132   define variable v-fmtcli-okpo          as character    no-undo.
     1133   define variable v-fmtcli-country       as character    no-undo.
     1134   define variable v-fmtcli-city          as character    no-undo.
     1135   define variable v-fmtcli-index         as character    no-undo.
     1136   define variable v-fmtcli-schet-exists  as logical      no-undo.
     1137   define variable v-fmtcli-bank-exists   as logical      no-undo.
     1138   define variable v-fmtcli-bank-r-schet  as character    no-undo.
     1139   define variable v-fmtcli-bank-c-schet  as character    no-undo.
     1140   define variable v-fmtcli-bank-bik      as character    no-undo.
     1141   define variable v-fmtcli-bank-name     as character    no-undo.
     1142   define variable v-fmtcli-bank-addres   as character    no-undo.
     1143   define variable v-fmtcli-bank-city     as character    no-undo.
     1144   procedure fmtcli-get-bank :
     1145   define input parameter p-host-code      as integer          no-undo.
     1146   define input parameter p-obj-type       as character        no-undo.
     1147   define input parameter p-obj-code       as integer          no-undo.
     1148   define input parameter p-curr-code      as integer          no-undo.
     1149       define buffer buf_fin-schet     for ub.fin-schet.
     1150       define buffer buf_fin-bank      for ub.fin-bank.
     1151   do
     1152   for buf_fin-schet
     1153     , buf_fin-bank
     1154   on error undo, return error
     1155   :
     1156       assign
     1157           v-fmtcli-schet-exists       = no
     1158           v-fmtcli-bank-exists        = no
     1159           v-fmtcli-bank-r-schet       = "":U
     1160           v-fmtcli-bank-c-schet       = "":U
     1161           v-fmtcli-bank-bik           = "":U
     1162           v-fmtcli-bank-name          = "":U
     1163           v-fmtcli-bank-addres        = "":U
     1164           v-fmtcli-bank-city          = "":U
     1165       .
     1166       search-for-schet:
     1167       for each buf_fin-schet no-lock
     1168          where buf_fin-schet.host-code = p-host-code
     1169            and buf_fin-schet.cli-type  = p-obj-type
     1170            and buf_fin-schet.cli-code  = p-obj-code
     1171            and buf_fin-schet.curr-code = p-curr-code
     1172       on error undo, return error
     1173       :
     1174           if buf_fin-schet.status_   = 'удал':U
     1175           then do:
     1176           end.
     1177           else do:
     1178               assign
     1179                   v-fmtcli-schet-exists   = yes
     1180                   v-fmtcli-bank-r-schet   = trim( buf_fin-schet.r-schet )
     1181                   v-fmtcli-bank-c-schet   = trim( buf_fin-schet.c-schet )
     1182               .
     1183               find first buf_fin-bank no-lock
     1184                    where buf_fin-bank.host-code = p-host-code
     1185                      and buf_fin-bank.code-bank = buf_fin-schet.code-bank
     1186               no-error.
     1187               if available buf_fin-bank
     1188               then do:
     1189                   assign
     1190                       v-fmtcli-bank-exists      = yes
     1191                       v-fmtcli-bank-bik         = trim( buf_fin-bank.bik )
     1192                       v-fmtcli-bank-name        = trim( buf_fin-bank.bank-name )
     1193                       v-fmtcli-bank-addres      = trim(buf_fin-bank.addres)
     1194                       v-fmtcli-bank-city      = trim(buf_fin-bank.bank-city)
     1195                   .
     1196               end.
     1197               else do:
     1198                   assign
     1199                       v-fmtcli-bank-exists    = no
     1200                       v-fmtcli-bank-bik       = "":U
     1201                       v-fmtcli-bank-name      = "":U
     1202                       v-fmtcli-bank-addres    = "":U
     1203                       v-fmtcli-bank-city      = "":U
     1204                   .
     1205               end.
     1206               leave search-for-schet.
     1207           end.
     1208       end.
     1209   end.
     1210   end procedure.
     1211   procedure fmtcli-get-client :
     1212   define input parameter p-obj-type       as character    no-undo.
     1213   define input parameter p-obj-code       as integer      no-undo.
     1214       define variable v-temp-fmtcli-address      as character     no-undo.
     1215       define variable v-num-country-city    as integer      no-undo.
     1216       define buffer buf_clients   for ub.clients.
     1217       define buffer buf_firm      for ub.firm.
     1218       define buffer buf_store     for ub.store.
     1219       define buffer buf_shop      for ub.shop.
     1220       define buffer buf_person    for ub.person.
     1221   do
     1222   for buf_clients
     1223     , buf_firm
     1224     , buf_store
     1225     , buf_shop
     1226     , buf_person
     1227   on error undo, return error
     1228   :
     1229       assign
     1230           v-fmtcli-name           = "":U
     1231           v-fmtcli-addres         = "":U
     1232           v-fmtcli-post-addres    = "":U
     1233           v-fmtcli-full-addres    = "":U
     1234           v-fmtcli-phone          = "":U
     1235           v-fmtcli-inn            = "":U
     1236           v-fmtcli-kpp            = "":U
     1237           v-fmtcli-okpo           = "":U
     1238           v-fmtcli-city           = "":U
     1239           v-fmtcli-index          = "":U
     1240           v-fmtcli-country        = "":U
     1241       .
     1242       find first buf_clients no-lock
     1243            where buf_clients.obj-type = p-obj-type
     1244              and buf_clients.obj-code = p-obj-code
     1245       .
     1246       assign
     1247           v-fmtcli-name = buf_clients.obj-name
     1248       .
     1249       case buf_clients.obj-type:
     1250          when 'орг':U
     1251          then do:
     1252               find first buf_firm no-lock
     1253                    where buf_firm.firm-code = buf_clients.obj-code
     1254                    no-error
     1255               .
     1256               if available buf_firm
     1257               then do:
     1258                   assign
     1259                       v-num-country-city = num-entries( buf_firm.city )
     1260                       v-fmtcli-engl-name = buf_firm.engl-name
     1261                   .
     1262                   if v-num-country-city > 0
     1263                   then do:
     1264                       assign
     1265                           v-fmtcli-country    = trim( entry( 1, buf_firm.city ) )
     1266                       .
     1267                   end.
     1268                   if v-num-country-city > 1
     1269                   then do:
     1270                       assign
     1271                           v-fmtcli-city       = trim( entry( 2, buf_firm.city ) )
     1272                       .
     1273                   end.
     1274                   run fmtcli-concatenate-strings in this-procedure (
     1275                         input v-fmtcli-full-addres
     1276                       , input v-fmtcli-country
     1277                       , input ", ":U
     1278                       , input 50
     1279                       , output v-fmtcli-full-addres
     1280                   ).
     1281                   run fmtcli-concatenate-strings in this-procedure (
     1282                         input v-fmtcli-full-addres
     1283                       , input v-fmtcli-city
     1284                       , input ", ":U
     1285                       , input 50
     1286                       , output v-fmtcli-full-addres
     1287                   ).
     1288                   run fmtcli-concatenate-strings in this-procedure (
     1289                         input v-fmtcli-full-addres
     1290                       , input IF buf_firm.ind = 0 THEN "" ELSE string( buf_firm.ind )
     1291                       , input ", ":U
     1292                       , input 50
     1293                       , output v-fmtcli-full-addres
     1294                   ).
     1295                   run fmtcli-concatenate-strings in this-procedure (
     1296                         input v-fmtcli-post-addres
     1297                       , input v-fmtcli-country
     1298                       , input ", ":U
     1299                       , input 50
     1300                       , output v-fmtcli-post-addres
     1301                   ).
     1302                   run fmtcli-concatenate-strings in this-procedure (
     1303                         input v-fmtcli-post-addres
     1304                       , input v-fmtcli-city
     1305                       , input ", ":U
     1306                       , input 50
     1307                       , output v-fmtcli-post-addres
     1308                   ).
     1309                   run fmtcli-concatenate-strings in this-procedure (
     1310                         input v-fmtcli-post-addres
     1311                       , input string( buf_firm.ind )
     1312                       , input ", ":U
     1313                       , input 50
     1314                       , output v-fmtcli-post-addres
     1315                   ).
     1316                   run fmtcli-concatenate-strings in this-procedure (
     1317                         input substring( buf_firm.addres1, 1, 50 )
     1318                       , input buf_firm.addres2
     1319                       , input " ":U
     1320                       , input 50
     1321                       , output v-temp-fmtcli-address
     1322                   ).
     1323                   run fmtcli-concatenate-strings in this-procedure (
     1324                         input v-temp-fmtcli-address
     1325                       , input substring( buf_firm.addres1, 51, 50 )
     1326                       , input " ":U
     1327                       , input 50
     1328                       , output v-temp-fmtcli-address
     1329                   ).
     1330                   run fmtcli-concatenate-strings in this-procedure (
     1331                         input v-temp-fmtcli-address
     1332                       , input substring( buf_firm.addres1, 101, 50 )
     1333                       , input " ":U
     1334                       , input 50
     1335                       , output v-temp-fmtcli-address
     1336                   ).
     1337                   assign
     1338                       v-fmtcli-addres = v-temp-fmtcli-address
     1339                   .
     1340                   if buf_firm.addres1 <> ?
     1341                   then do:
     1342                       run fmtcli-concatenate-strings in this-procedure (
     1343                             input v-fmtcli-full-addres
     1344                           , input v-fmtcli-addres
     1345                           , input ", ":U
     1346                           , input 0
     1347                           , output v-fmtcli-full-addres
     1348                       ).
     1349                   end.
     1350                   run fmtcli-concatenate-strings in this-procedure (
     1351                         input substring( buf_firm.post-addr1, 1, 50 )
     1352                       , input buf_firm.post-addr2
     1353                       , input " ":U
     1354                       , input 50
     1355                       , output v-fmtcli-post-addres
     1356                   ).
     1357                   run fmtcli-concatenate-strings in this-procedure (
     1358                         input v-fmtcli-post-addres
     1359                       , input substring( buf_firm.post-addr1, 51, 50 )
     1360                       , input " ":U
     1361                       , input 50
     1362                       , output v-fmtcli-post-addres
     1363                   ).
     1364                   run fmtcli-concatenate-strings in this-procedure (
     1365                         input v-fmtcli-post-addres
     1366                       , input substring( buf_firm.post-addr1, 101, 50 )
     1367                       , input " ":U
     1368                       , input 50
     1369                       , output v-fmtcli-post-addres
     1370                   ).
     1371                   assign
     1372                       v-fmtcli-phone         = buf_firm.phone
     1373                       v-fmtcli-inn           = buf_firm.inn
     1374                       v-fmtcli-kpp           = buf_firm.kpp
     1375                       v-fmtcli-okpo          = buf_firm.okpo
     1376                       v-fmtcli-index         = string( buf_firm.ind )
     1377                   .
     1378               end.
     1379          end.
     1380          when 'маг':U
     1381          then do:
     1382               find first buf_shop no-lock
     1383                    where buf_shop.obj-code = buf_clients.obj-code
     1384               .
     1385               if available buf_shop
     1386               then do:
     1387                   run fmtcli-concatenate-strings in this-procedure (
     1388                         input buf_shop.addres1
     1389                       , input buf_shop.addres2
     1390                       , input " ":U
     1391                       , input 50
     1392                       , output v-fmtcli-addres
     1393                   ).
     1394                   assign
     1395                       v-fmtcli-full-addres = v-fmtcli-addres
     1396                       v-fmtcli-post-addres = v-fmtcli-addres
     1397                       v-fmtcli-phone       = buf_shop.phone
     1398                       v-fmtcli-inn         = "":U
     1399                       v-fmtcli-kpp         = "":U
     1400                       v-fmtcli-okpo        = "":U
     1401                       v-fmtcli-city        = "":U
     1402                       v-fmtcli-index       = "":U
     1403                   .
     1404               end.
     1405          end.
     1406          when 'скл':U
     1407          then do:
     1408               find first buf_store no-lock
     1409                    where buf_store.obj-code = buf_clients.obj-code
     1410               .
     1411               if available buf_store
     1412               then do:
     1413                   run fmtcli-concatenate-strings in this-procedure (
     1414                         input buf_store.addres1
     1415                       , input buf_store.addres2
     1416                       , input " ":U
     1417                       , input 50
     1418                       , output v-fmtcli-addres
     1419                   ).
     1420                   assign
     1421                       v-fmtcli-full-addres = v-fmtcli-addres
     1422                       v-fmtcli-phone       = buf_store.phone
     1423                       v-fmtcli-inn         = "":U
     1424                       v-fmtcli-kpp         = "":U
     1425                       v-fmtcli-okpo        = "":U
     1426                       v-fmtcli-city        = "":U
     1427                       v-fmtcli-index       = "":U
     1428                   .
     1429               end.
     1430          end.
     1431          when 'чел':U
     1432          then do:
     1433               find first buf_person no-lock
     1434                    where buf_person.psn-code = buf_clients.obj-code
     1435               .
     1436               if available buf_person
     1437               then do:
     1438                   run fmtcli-concatenate-strings in this-procedure (
     1439                         input ( if buf_person.ind = 0 or buf_person.ind = ?
     1440                                 then "":U
     1441                                 else string( buf_person.ind, "999999")
     1442                                 )
     1443                       , input buf_person.city
     1444                       , input ", ":U
     1445                       , input 0
     1446                       , output v-fmtcli-full-addres
     1447                   ).
     1448                   assign
     1449                       v-fmtcli-addres = buf_person.address
     1450                   .
     1451                   run fmtcli-concatenate-strings in this-procedure (
     1452                         input v-fmtcli-full-addres
     1453                       , input v-fmtcli-addres
     1454                       , input ", ":U
     1455                       , input 0
     1456                       , output v-fmtcli-full-addres
     1457                   ).
     1458                   assign
     1459                       v-fmtcli-phone     = buf_person.phone1
     1460                       v-fmtcli-inn       = buf_person.inn
     1461                       v-fmtcli-kpp       = buf_person.kpp
     1462                       v-fmtcli-okpo      = buf_person.okpo
     1463                       v-fmtcli-city      = buf_person.city
     1464                       v-fmtcli-index     = string( buf_person.ind )
     1465                   .
     1466               end.
     1467          end.
     1468       end case.
     1469   end.
     1470   end procedure.
     1471   procedure fmtcli-concatenate-strings :
     1472   define input parameter p-string-1       as character        no-undo.
     1473   define input parameter p-string-2       as character        no-undo.
     1474   define input parameter p-delimiter      as character        no-undo.
     1475   define input parameter p-length         as integer          no-undo.
     1476   define output parameter p-out-string    as character        no-undo.
     1477   do
     1478   on error undo, return error
     1479   :
     1480       assign
     1481           p-out-string = ( if p-string-1 = ?
     1482                            then "":U
     1483                            else trim( p-string-1 ) )
     1484       .
     1485       assign
     1486           p-out-string = p-out-string
     1487                        + ( if p-out-string = "":U
     1488                            or length( p-out-string ) = p-length
     1489                            or p-string-2 = ?
     1490                            or trim( p-string-2 ) = "":U
     1491                            then "":U
     1492                            else p-delimiter )
     1493                        + ( if p-string-2 = ?
     1494                            or trim( p-string-2 ) = "":U
     1495                            then "":U
     1496                            else trim( p-string-2 ) )
     1497       .
     1498   end.
     1499   end procedure.
     1500   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1501   procedure factord :
     1502     define input  parameter p-fact-date            as date    no-undo .
     1503     define input  parameter p-fact-time            as integer no-undo .
     1504     define input  parameter p-fact-num             as integer no-undo .
     1505     define input  parameter p-shift-date           as date    no-undo .
     1506     define input  parameter p-shift-num            as integer no-undo .
     1507     define input  parameter p-shift-on             as logical no-undo .
     1508     define output parameter p-fact-order           as decimal no-undo .
     1509     define output parameter p-shift-end-fact-order as decimal no-undo .
     1510     define output parameter p-day-end-fact-order   as decimal no-undo .
     1511     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     1512     if p-fact-date = ?
     1513     then do:
     1514       return error "Не указана фактическая дата" .
     1515     end.
     1516     define variable v-fact-date-num as integer no-undo .
     1517     assign
     1518       v-fact-date-num = integer(p-fact-date)
     1519     .
     1520     if p-fact-num = ?
     1521     or p-fact-num = 0
     1522     then do:
     1523       return error "Не задан p-fact-num " + string(p-fact-num) .
     1524     end.
     1525     if p-fact-num < 0
     1526     then do:
     1527       return error "Отрицательный fact-num " + string(p-fact-num) .
     1528     end.
     1529     if p-fact-num >= 100000000
     1530     then do:
     1531       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     1532     end.
     1533     if p-shift-on = true
     1534     then do:
     1535       if p-shift-date = ?
     1536       then do:
     1537         return error "Не задана дата смены" .
     1538       end.
     1539       if p-shift-num = ?
     1540       or p-shift-num = 0
     1541       then do:
     1542         return error "Не задан номер смены" .
     1543       end.
     1544     end.
     1545     else do:
     1546       assign
     1547         p-shift-date = p-fact-date
     1548         p-shift-num  = 24
     1549       .
     1550     end.
     1551     define variable v-shift-offset as integer no-undo .
     1552     if p-shift-date = p-fact-date
     1553     then do:
     1554       assign
     1555         v-shift-offset = 1
     1556       .
     1557     end.
     1558     if p-shift-date < p-fact-date
     1559     then do:
     1560       assign
     1561         v-shift-offset = 0
     1562       .
     1563     end.
     1564     if p-shift-date > p-fact-date
     1565     then do:
     1566       message
     1567         vss-workfile vss-revision vss-description skip
     1568         "Неправильная дата закрытия смены" skip
     1569         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     1570         view-as alert-box error .
     1571       undo, return error
     1572         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     1573           ,string(p-fact-date, '99/99/9999':U)
     1574           ,string(p-shift-date, '99/99/9999':U)
     1575           )
     1576       .
     1577     end.
     1578     if p-shift-num < 1
     1579     or p-shift-num > 24
     1580     then do:
     1581       message
     1582         vss-workfile vss-revision vss-description skip
     1583         "Неправильный номер смены" skip
     1584         "p-shift-num" p-shift-num skip
     1585         view-as alert-box error .
     1586       undo, return error return-value .
     1587     end.
     1588     assign
     1589       p-fact-order           = v-fact-date-num
     1590                              + v-shift-offset * 0.5
     1591                              + p-shift-num    * 0.02 - 0.01
     1592                              + p-fact-num     * 0.0000000001
     1593       p-shift-end-fact-order = v-fact-date-num
     1594                              + v-shift-offset * 0.5
     1595                              + p-shift-num    * 0.02
     1596       p-day-end-fact-order   = v-fact-date-num
     1597                              + 0.99
     1598     .
     1599     if p-fact-order           <= v-fact-date-num
     1600     or p-shift-end-fact-order <= v-fact-date-num
     1601     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     1602     or p-shift-end-fact-order >= p-day-end-fact-order
     1603     then do:
     1604       message
     1605         vss-workfile vss-revision vss-description skip
     1606         "Внутренняя ошибка при генерации фактического номера" skip
     1607         "p-fact-date"            p-fact-date            skip
     1608         "p-fact-time"            p-fact-time            skip
     1609         "p-fact-num"             p-fact-num             skip
     1610         "p-shift-date"           p-shift-date           skip
     1611         "p-shift-num"            p-shift-num            skip
     1612         "p-shift-on"             p-shift-on             skip
     1613         "p-shift-end-fact-order" p-shift-end-fact-order skip
     1614         "p-day-end-fact-order"   p-day-end-fact-order   skip
     1615         "v-fact-date-num"        v-fact-date-num        skip
     1616         view-as alert-box error .
     1617       undo, return error return-value .
     1618     end.
     1619   end procedure.
     1620   procedure day-begin-fact-order :
     1621     define input  parameter p-fact-date            as date    no-undo .
     1622     define output parameter p-day-begin-fact-order as decimal no-undo .
     1623     do
     1624     on error undo, return error return-value
     1625     :
     1626       if p-fact-date = ?
     1627       then do:
     1628         assign
     1629           p-day-begin-fact-order = 0
     1630         .
     1631       end.
     1632       else do:
     1633         assign
     1634           p-day-begin-fact-order = integer(p-fact-date)
     1635         .
     1636       end.
     1637     end.
     1638   end procedure.
     1639   procedure factord-max-fact-order :
     1640     define output parameter p-max-fact-order as decimal   no-undo .
     1641     do
     1642     on error undo, return error return-value
     1643     :
     1644       run day-begin-fact-order in this-procedure
     1645         (input  date(1, 1, 5000)
     1646         ,output p-max-fact-order
     1647         ) .
     1648     end.
     1649   end procedure.
     1650   procedure factord-cut-archive :
     1651     define input  parameter p-obj-type             as character no-undo .
     1652     define input  parameter p-obj-code             as integer   no-undo .
     1653     define input  parameter p-fact-date            as date      no-undo .
     1654     define output parameter p-shift-on             as logical   no-undo .
     1655     define output parameter p-shift-date           as date      no-undo .
     1656     define output parameter p-shift-num            as integer   no-undo .
     1657     define output parameter p-day-end-fact-order   as decimal   no-undo .
     1658     define output parameter p-shift-end-fact-order as decimal   no-undo .
     1659     define variable v-fact-order as decimal   no-undo .
     1660     define buffer buf_shift-obj for ub.shift-obj .
     1661     do
     1662     on error undo, return error return-value
     1663     :
     1664   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1665   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1666     (input  p-obj-type
     1667     ,input  p-obj-code
     1668     ,input  'shift-on=request'
     1669     ,output p-shift-on
     1670     ) no-error .
     1671       if error-status :error
     1672       then do:
     1673         message
     1674           vss-workfile vss-revision vss-description skip
     1675           "Ошибка при определении атрибута объекта" skip
     1676           "Объект" p-obj-type p-obj-code skip
     1677           error-status :get-message(1) skip
     1678           return-value skip
     1679           view-as alert-box error .
     1680         undo, return error return-value .
     1681       end.
     1682       if p-shift-on = false
     1683       then do:
     1684         assign
     1685           p-shift-date               = ?
     1686           p-shift-num                = 0
     1687         .
     1688       end.
     1689       else do:
     1690         find first buf_shift-obj share-lock
     1691           where buf_shift-obj.obj-type   = p-obj-type
     1692             and buf_shift-obj.obj-code   = p-obj-code
     1693             and buf_shift-obj.shift-date > p-fact-date
     1694           use-index pi
     1695           no-error .
     1696         if not available buf_shift-obj
     1697         or buf_shift-obj.status_ <> 'зкр':U
     1698         then do:
     1699           message
     1700             vss-workfile vss-revision vss-description skip
     1701             "Невозможно вычислить последнюю смену" skip
     1702             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1703             "Объект" p-obj-type p-obj-code skip
     1704             "Дата" p-fact-date skip
     1705             view-as alert-box error .
     1706           undo, return error return-value .
     1707         end.
     1708         find last buf_shift-obj share-lock
     1709           where buf_shift-obj.obj-type = p-obj-type
     1710             and buf_shift-obj.obj-code = p-obj-code
     1711             and buf_shift-obj.shift-date <= p-fact-date
     1712           use-index pi
     1713           no-error .
     1714         if available buf_shift-obj
     1715         then do:
     1716           if  buf_shift-obj.status_ = 'зкр':U
     1717           then do:
     1718             assign
     1719               p-shift-date = buf_shift-obj.shift-date
     1720               p-shift-num  = buf_shift-obj.shift-num
     1721             .
     1722           end.
     1723           else do:
     1724             message
     1725               vss-workfile vss-revision vss-description skip
     1726               "Невозможно вычислить последнюю смену" skip
     1727               "Статус смены отличен от статуса" 'зкр':U skip
     1728               "Объект" p-obj-type p-obj-code skip
     1729               "Дата" p-fact-date skip
     1730               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1731               view-as alert-box error .
     1732             undo, return error return-value .
     1733           end.
     1734         end.
     1735         else do:
     1736           assign
     1737             p-shift-date = p-fact-date - 1
     1738             p-shift-num  = 1
     1739           .
     1740         end.
     1741       end.
     1742       run factord in this-procedure
     1743         (input  p-fact-date
     1744         ,input  1
     1745         ,input  1
     1746         ,input  p-shift-date
     1747         ,input  p-shift-num
     1748         ,input  p-shift-on
     1749         ,output v-fact-order
     1750         ,output p-shift-end-fact-order
     1751         ,output p-day-end-fact-order
     1752         ) no-error .
     1753       if error-status :error
     1754       then do:
     1755         message
     1756           vss-workfile vss-revision vss-description skip
     1757           "Ошибка при вызове процедуры factord"
     1758           error-status :get-message(1) skip
     1759           return-value skip
     1760           view-as alert-box error .
     1761         undo, return error return-value .
     1762       end.
     1763     end.
     1764   end procedure.
     1765   procedure factord-lock-shift :
     1766     define input  parameter p-obj-type  as character no-undo .
     1767     define input  parameter p-obj-code  as integer   no-undo .
     1768     define input  parameter p-fact-date as date      no-undo .
     1769     define parameter buffer buf_shift-obj for ub.shift-obj .
     1770     define variable v-shift-on      as logical   no-undo .
     1771     define variable v-extra-message as character no-undo .
     1772     define variable v-error as character no-undo .
     1773     do
     1774     on error undo, return error return-value
     1775     :
     1776   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1777   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1778     (input  p-obj-type
     1779     ,input  p-obj-code
     1780     ,input  'shift-on=request'
     1781     ,output v-shift-on
     1782     ) no-error .
     1783       if error-status :error
     1784       then do:
     1785         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1786         undo, return error v-error .
     1787       end.
     1788       if v-shift-on = true
     1789       then do:
     1790         find first buf_shift-obj share-lock
     1791           where buf_shift-obj.obj-type   = p-obj-type
     1792             and buf_shift-obj.obj-code   = p-obj-code
     1793             and buf_shift-obj.shift-date > p-fact-date
     1794           use-index pi
     1795           no-error .
     1796         if not available buf_shift-obj
     1797         or buf_shift-obj.status_ <> 'зкр':U
     1798         then do:
     1799           find last buf_shift-obj
     1800             where buf_shift-obj.obj-type = p-obj-type
     1801               and buf_shift-obj.obj-code = p-obj-code
     1802               and buf_shift-obj.status_  = 'зкр':U
     1803             use-index stts
     1804             no-error .
     1805           if available buf_shift-obj
     1806           then do:
     1807             assign
     1808               v-extra-message =
     1809                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1810                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1811                               )
     1812             .
     1813           end.
     1814           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1815           undo, return error v-error .
     1816         end.
     1817       end.
     1818     end.
     1819   end procedure.
     1820   procedure factord-end-day :
     1821     define input  parameter p-fact-date            as date    no-undo .
     1822     define output parameter p-day-end-fact-order   as decimal no-undo .
     1823     do
     1824     on error undo, return error return-value
     1825     :
     1826       if p-fact-date = ?
     1827       then do:
     1828         return error "Не указана фактическая дата" .
     1829       end.
     1830       assign
     1831         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1832       .
     1833     end.
     1834   end procedure.
     1835   procedure factord-to-date :
     1836     define input  parameter p-fact-order as decimal no-undo .
     1837     define output parameter p-fact-date  as date    no-undo .
     1838     define variable v-ref-date  as date      no-undo .
     1839     define variable v-ref-delta as integer   no-undo .
     1840     do
     1841     on error undo, return error return-value
     1842     :
     1843       if p-fact-order = ?
     1844       or p-fact-order = 0
     1845       then do:
     1846         return error "Не указан fact-order" .
     1847       end.
     1848       assign
     1849         v-ref-date  = date(1, 1, 2000)
     1850       .
     1851       assign
     1852         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1853       .
     1854       assign
     1855         p-fact-date = v-ref-date + v-ref-delta
     1856       .
     1857     end.
     1858   end procedure.
     1859   procedure factord-to-fact-num :
     1860     define input  parameter p-fact-order as decimal no-undo .
     1861     define output parameter p-fact-num   as integer no-undo .
     1862     define variable v-fact-order-trunc as decimal no-undo .
     1863     do
     1864     on error undo, return error return-value
     1865     :
     1866       if p-fact-order = ?
     1867       or p-fact-order = 0
     1868       then do:
     1869         return error "Не указан fact-order" .
     1870       end.
     1871       assign
     1872        v-fact-order-trunc = truncate(p-fact-order, 2)
     1873       .
     1874       assign
     1875         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1876       .
     1877     end.
     1878   end procedure.
     1879   procedure factord-to-shift-num :
     1880     define input  parameter p-fact-order as decimal no-undo .
     1881     define output parameter p-shift-num   as integer no-undo .
     1882     define variable  p-shift-numd  as decimal   no-undo .
     1883     define variable v-fact-order-trunc as decimal no-undo .
     1884     do
     1885     on error undo, return error return-value
     1886     :
     1887       if p-fact-order = ?
     1888       or p-fact-order = 0
     1889       then do:
     1890         return error "Не указан fact-order" .
     1891       end.
     1892       assign
     1893        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1894       .
     1895       if v-fact-order-trunc < 0.5 then do:
     1896         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1897       end.
     1898       assign
     1899         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1900         .
     1901        assign
     1902         p-shift-num = truncate (p-shift-numd , 0)
     1903       .
     1904     end.
     1905   end procedure.
