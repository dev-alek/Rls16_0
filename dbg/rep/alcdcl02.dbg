     1995   procedure clntattr-exist :
     1996     define input  parameter p-obj-type like ub.clients-attr.obj-type   no-undo .
     1997     define input  parameter p-obj-code like ub.clients-attr.obj-code   no-undo .
     1998     define input  parameter p-code     like ub.clients-attr.attr-code  no-undo .
     1999     define output parameter p-exist    as logical  no-undo .
     2000     do
     2001     on error undo, return error return-value
     2002     :
     2003           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clntattr-exist in g#attr-lib
     2004         (input  p-obj-type
     2005         ,input  p-obj-code
     2006         ,input  p-code
     2007         ,output p-exist
     2008         ) no-error .
