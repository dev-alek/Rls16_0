      685       gp-price-sale = gp-price-sale-parts.
      686    end.
      687                   assign price-lst = gp-price-sale.
      688               end.
      689           else do:
      690               assign price-lst = gds-dtl.cur-base.
      691           end.
      692           if t-doc.doc-type = 'при':U
      693           then do:
      694   assign
      695     price-rubl-with-tax-loc = doc-line.price-rubl
      696     price-base-with-tax-loc = doc-line.price-base
      697   .
      698   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      699   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      700     (output varinvprb
      701     )  .
      702      find first in-vatp_doc-attr no-lock
      703       where in-vatp_doc-attr.doc-code  = t-doc.doc-code
      704         and in-vatp_doc-attr.attr-code = 'envd':U
      705       no-error .
      706       if available in-vatp_doc-attr
      707          then do:
      708          assign
      709            in-vatp-have-vat-slt = no.
      710      end.
      711      else do:
      712        assign
      713          in-vatp-have-vat-slt = yes.
      714      end.
      715      find first in-vatp-goods where in-vatp-goods.artic     = doc-line.artic     and
      716                                        in-vatp-goods.prod-type = doc-line.prod-type and
      717                                        in-vatp-goods.prod-code = doc-line.prod-code no-lock.
      718      if (not t-doc.internal and
      719              t-doc.doc-type = 'при':U) or
      720         in-vatp-goods.gds-type = 'у':U then do:
      721         if varinvprb = "base":u then do:
      722           assign
      723             road-tax-base-loc = doc-line.road-tax
      724             road-tax-rubl-loc = doc-line.road-tax * t-doc.base-rate / t-doc.base-scale.
      725         end.
      726         else do:
      727           ASSIGN
      728             road-tax-rubl-loc = doc-line.road-tax
      729             road-tax-base-loc = doc-line.road-tax / t-doc.base-rate * t-doc.base-scale.
      730         end.
      731         if road-tax-base-loc = ? then road-tax-base-loc = 0.
      732         if road-tax-rubl-loc = ? then road-tax-rubl-loc = 0.
      733         assign
      734           road-tax-cli-loc = ?.
      735         ASSIGN
      736           transport-base-loc = (if doc-line.transport-base = ? then 0 else doc-line.transport-base)
      737           transport-rubl-loc = (if doc-line.transport-rubl = ? then 0 else doc-line.transport-rubl)
      738           transport-cli-loc  = 0
      739           other-base-loc     = (if doc-line.other-base     = ? then 0 else doc-line.other-base)
      740           other-rubl-loc     = (if doc-line.other-rubl     = ? then 0 else doc-line.other-rubl)
      741           other-cli-loc      = 0
      742           vat-pc-loc         = (if doc-line.vat-pc         = ? then 0 else doc-line.vat-pc)
      743           slt-pc-loc         = (if doc-line.slt-pc         = ? then 0 else doc-line.slt-pc).
      744                                 ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
      745               ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
      746         assign
      747           vat-cli-loc            = ?
      748           slt-cli-loc            = ?
      749           price-cli-with-tax-loc = ?.
      750      end.
      751      else do:
      752                                                   for each in-vatp-parts where in-vatp-parts.out-code  = doc-line.doc-code  and
      753                                         in-vatp-parts.obj-type  = doc-line.obj-type  and
      754                                         in-vatp-parts.obj-code  = doc-line.obj-code  and
      755                                         in-vatp-parts.artic     = doc-line.artic     and
      756                                         in-vatp-parts.prod-type = doc-line.prod-type and
      757                                         in-vatp-parts.prod-code = doc-line.prod-code
      758                            use-index out-code no-lock:
      759             accumulate  in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty (total)
      760                         in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty (total)
      761                         in-vatp-parts.transport-base * in-vatp-parts.fact-qnty (total)
      762                         in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty (total)
      763                         in-vatp-parts.other-base     * in-vatp-parts.fact-qnty (total)
      764                         in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty (total)
      765                                                                                                                 (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  (total)
      766                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
      767                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))  (total)
      768                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc))  (total)
      769                                               (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  (total)
      770                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
      771                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))  (total)
      772                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc))  (total)
      773                         .
      774         end.
      775         ASSIGN
      776           road-tax-base-loc   = if doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty) / doc-line.fact-qnty  else 0
      777           road-tax-rubl-loc   = if doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty) / doc-line.fact-qnty  else 0
      778           transport-base-loc  = if doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-base * in-vatp-parts.fact-qnty) / doc-line.fact-qnty  else 0
      779           transport-rubl-loc  = if doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty) / doc-line.fact-qnty  else 0
      780           other-base-loc      = if doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-base     * in-vatp-parts.fact-qnty) / doc-line.fact-qnty  else 0
      781           other-rubl-loc      = if doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty) / doc-line.fact-qnty  else 0
      782                                           vat-base-loc        = if doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / doc-line.fact-qnty   else 0
      783           slt-base-loc        = if doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / doc-line.fact-qnty   else 0
      784                   vat-rubl-loc        = if doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / doc-line.fact-qnty   else 0
      785           slt-rubl-loc        = if doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / doc-line.fact-qnty   else 0
      786           vat-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc)))
      787           slt-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))).
      788         if road-tax-base-loc  = ? then road-tax-base-loc  = 0.
      789         if road-tax-rubl-loc  = ? then road-tax-rubl-loc  = 0.
      790         if transport-base-loc = ? then transport-base-loc = 0.
      791         if transport-rubl-loc = ? then transport-rubl-loc = 0.
      792         if other-base-loc     = ? then other-base-loc     = 0.
      793         if other-rubl-loc     = ? then other-rubl-loc     = 0.
      794         assign
      795           transport-cli-loc      = 0
      796           other-cli-loc          = 0
      797           road-tax-cli-loc       = ?
      798           vat-cli-loc            = ?
      799           slt-cli-loc            = ?
      800           price-cli-with-tax-loc = ?.
      801      end.
      802   ASSIGN
      803             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
      804       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
      805   .
      806               if road-tax-rubl-loc = ? then assign road-tax-rubl-loc = 0.
      807               if road-tax-base-loc = ? then assign road-tax-base-loc = 0.
      808               assign
      809                   price-doc = ( if v-curr-r-b = 'base':U
      810                                 then ( price-base-with-tax-loc - vat-base-loc )
      811                                 else ( price-rubl-with-tax-loc - vat-rubl-loc ) )
      812                   v-tax-sum = ( if v-curr-r-b = 'base':U
      813                                 then road-tax-base-loc
      814                                 else road-tax-rubl-loc )
      815               .
      816           end.
      817           else do:
      818               if v-curr-r-b = 'base':U
      819               then do:
      820                   assign
      821                       price-doc = gds-dtl.price-base - (ub.gds-dtl.price-base - ub.gds-dtl.discnt-base - ub.doc-line.road-tax * 1 - (ub.gds-dtl.price-base - ub.gds-dtl.discnt-base - ub.doc-line.road-tax * 1)                           * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc))                           * ub.doc-line.VAT-pc / (100 + ub.doc-line.VAT-pc)
      822                   .
      823               end.
      824               else do:
      825                   assign
      826                       price-doc = gds-dtl.price-rubl - (ub.gds-dtl.price-rubl - ub.gds-dtl.discnt-rubl - ub.doc-line.road-tax * 1 - (ub.gds-dtl.price-rubl - ub.gds-dtl.discnt-rubl - ub.doc-line.road-tax * 1)                           * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc))                           * ub.doc-line.VAT-pc / (100 + ub.doc-line.VAT-pc)
      827                   .
      828               end.
      829           end.
      830           if prod-price = yes
      831           then do:
      832   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      833   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
      834     (input  goods.gds-code
      835     ,input  '1':U
      836     ,input  ?
      837     ,input  v-host-code
      838     ,input  doc-line.obj-type
      839     ,input  doc-line.obj-code
      840     ,output Vat-gds-pc
      841     ) no-error .
      842           end.
      843           else do:
      844   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      845   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
      846     (input  goods.gds-code
      847     ,input  '1':U
      848     ,input  t-doc.fact-date
      849     ,input  v-host-code
      850     ,input  doc-line.obj-type
      851     ,input  doc-line.obj-code
      852     ,output Vat-gds-pc
      853     ) no-error .
      854           end.
      855           assign
      856               Vat-gds     = ( price-lst - (price-lst - ub.doc-line.road-tax * 1) * t-doc-line.SLT-pc / (100 + t-doc-line.SLT-pc) - v-tax-sum) * Vat-gds-pc / ( 100 + Vat-gds-pc )
      857               Vat-prod    = ( gds-dtl.fact-qnty * ( if v-curr-r-b = 'base':U then gds-dtl.price-base else gds-dtl.price-rubl ) )
      858                               - ( gds-dtl.fact-qnty * price-doc )
      859               marg        = price-lst - price-doc - Vat-gds - (price-lst - ub.doc-line.road-tax * 1) * t-doc-line.SLT-pc / (100 + t-doc-line.SLT-pc)
      860           .
      861           ACCUMULATE
      862               bar-code.b-code ( COUNT )
      863               gds-dtl.fact-qnty ( TOTAL )
      864               marg * gds-dtl.fact-qnty ( TOTAL )
      865               gds-dtl.fact-qnty * (price-lst - ub.doc-line.road-tax * 1) * t-doc-line.SLT-pc / (100 + t-doc-line.SLT-pc) ( TOTAL )
      866               gds-dtl.fact-qnty * VAT-gds ( TOTAL )
      867               ( gds-dtl.fact-qnty * price-lst ) ( TOTAL )
      868               ( gds-dtl.fact-qnty * price-doc ) ( TOTAL )
      869           .
      870           if v-curr-r-b = 'base':U
      871           then do:
      872               ACCUMULATE
      873                   ( gds-dtl.fact-qnty * gds-dtl.price-base ) ( TOTAL )
      874                   ( ( price-lst - gds-dtl.price-base ) * gds-dtl.fact-qnty ) ( TOTAL )
      875               .
      876           end.
      877           else do:
      878               ACCUMULATE
      879                   ( gds-dtl.fact-qnty * gds-dtl.price-rubl ) ( TOTAL )
      880                   ( ( price-lst - gds-dtl.price-rubl ) * gds-dtl.fact-qnty ) ( TOTAL )
      881               .
      882           end.
      883           assign
      884                delt = ( if v-curr-r-b = 'base':U
      885                         then string( ( price-lst - gds-dtl.price-base ) / gds-dtl.price-base * 100, "->>>9.9" )
      886                         else string( ( price-lst - gds-dtl.price-rubl ) / gds-dtl.price-rubl * 100, "->>>9.9" )
      887                       ) + "%"
      888           .
      889           DISPLAY sym1
      890                   trim( string( bar-code.b-code ) ) @ tb-code
      891                   gds-dtl.artic
      892                   goods.gds-name
      893                   gds-dtl.fact-qnty
      894                   price-doc
      895                   ( gds-dtl.fact-qnty * price-doc ) @ sum-no-NDS
      896                   VAT-prod
      897                   ( gds-dtl.fact-qnty * ( if v-curr-r-b = 'base':U then gds-dtl.price-base else gds-dtl.price-rubl ) ) @ doc-sum
      898                   price-lst
      899                   ( gds-dtl.fact-qnty * price-lst ) @ obj-sum
      900                   t-doc-line.vat-pc
      901                   ( gds-dtl.fact-qnty * VAT-gds ) @ VAT-sum
      902                   string( string( marg / price-doc * 100, "->>>9.9" ) + "%" ) @ UpFact
      903                   Delt
      904                   sym2
      905           .
      906           IF LENGTH(goods.gds-name, "CHARACTER") > 20 and FullGdsName THEN  do:
      907             assign propis = SUBSTRING(goods.gds-name,21) .
      908             DOWN 1 .
      909             DISPLAY sym1 propis @ goods.gds-name  sym2     .
      910           end.
      911           if LAST( gds-dtl.artic ) then
      912               do:
      913                   DOWN 1 .
      914                   PUT Line format "X(180)" SKIP .
      915                   assign
      916                       v-sum-cost-without-vat = ACCUM TOTAL ( gds-dtl.fact-qnty * price-doc )
      917                       v-sum-sale             = ACCUM TOTAL ( gds-dtl.fact-qnty * price-lst )
      918                   .
      919                   assign
      920                       Delt = ( if v-curr-r-b = 'base':U
      921                               then string( ( ACCUM TOTAL ( ( price-lst - gds-dtl.price-base ) * gds-dtl.fact-qnty ) )
      922                                          / ( ACCUM TOTAL ( gds-dtl.fact-qnty * gds-dtl.price-base ) ) * 100, "->>>9.9" ) + "%"
      923                               else string( ( ACCUM TOTAL ( ( price-lst - gds-dtl.price-rubl ) * gds-dtl.fact-qnty ) )
      924                                          / ( ACCUM TOTAL ( gds-dtl.fact-qnty * gds-dtl.price-rubl ) ) * 100, "->>>9.9" ) + "%"
      925                              )
      926                   .
      927                   DISPLAY "  ИТОГО"    @ goods.gds-name
      928                       ACCUM TOTAL gds-dtl.fact-qnty @ gds-dtl.fact-qnty
      929                       ACCUM TOTAL ( gds-dtl.fact-qnty * price-doc )   @ sum-no-NDS
      930                       ( if v-curr-r-b = 'base':U
      931                         then ACCUM TOTAL ( gds-dtl.fact-qnty * gds-dtl.price-base )
      932                         else ACCUM TOTAL ( gds-dtl.fact-qnty * gds-dtl.price-rubl )
      933                       )                                               @ doc-sum
      934                       ACCUM TOTAL ( gds-dtl.fact-qnty * price-lst ) @ obj-sum
      935                       ACCUM TOTAL ( gds-dtl.fact-qnty * VAT-gds ) @ VAT-sum
      936                       string( string( ( ACCUM TOTAL ( marg * gds-dtl.fact-qnty ) ) /
      937                                              ( ACCUM TOTAL ( gds-dtl.fact-qnty * price-doc ) ) * 100, "->>>9.9" ) + "%" )
      938                                       @ UpFact
      939                       Delt .
      940                   UNDERLINE goods.gds-name gds-dtl.fact-qnty sum-no-NDS obj-sum UpFact .
      941                   DOWN 2 .
      942               end.
      943   END.
      944   HIDE FRAME BottomFrame .
      945   if v-curr-r-b = 'base':U
      946   then do:
      947       run rep/wp.p ( input p-mainmenu-handle, input absolute( ACCUM TOTAL ( marg * gds-dtl.fact-qnty ) ), output propis, output abbr ) .
      948   end.
      949   else do:
      950       run rep/wp-rub.p ( input absolute( ACCUM TOTAL ( marg * gds-dtl.fact-qnty ) ), output propis, output abbr ) .
      951   end.
      952   PUT SPACE(10) "Всего  " ( ACCUM COUNT bar-code.b-code ) format ">>>>9"
      953       " наименований." format "X(15)"
      954       SKIP(1)
      955       SPACE(10)
      956       string( "Сумма цен по объекту составила : "
      957                  + trim( string( ACCUM TOTAL ( gds-dtl.fact-qnty * price-lst ), "->>>,>>>,>>>,>>>,>>9.99" ) )
      958                  + " " + trim( abbr )
      959                  + ", в том числе налог с продаж : "
      960                  + trim( string( ACCUM TOTAL ( gds-dtl.fact-qnty * (price-lst - ub.doc-line.road-tax * 1) * t-doc-line.SLT-pc / (100 + t-doc-line.SLT-pc) ), "->>>,>>>,>>>,>>>,>>9.99" ) )
      961                  + " " + trim( abbr )
      962                  + ", НДС : "
      963                  + trim( string( ACCUM TOTAL ( gds-dtl.fact-qnty * VAT-gds ), "->>>,>>>,>>>,>>>,>>9.99" ) )
      964                  + " " + trim( abbr )
      965                 ) format "X(126)"
      966       skip(1)
      967       space(10) "Разница между суммой в продажных ценах по объекту и суммой в ценах документа без НДС составила: "
      968                  + trim( string( v-sum-sale - v-sum-cost-without-vat, "->>>,>>>,>>>,>>>,>>9.99" ) )
      969                  + " " + trim( abbr )
      970                                                           format "X(126)"
      971       skip(1)
      972       space(10) string( "Торговая наценка составила : "
      973                  + trim( string( ACCUM TOTAL ( marg * gds-dtl.fact-qnty ), "->>>,>>>,>>>,>>>,>>9.99" ) )
      974                  + " " + trim( abbr )
      975                 ) format "X(126)"
      976       SKIP(1)
      977       .
      978   if line-counter + 4 > page-size then
      979       PAGE .
      980   PUT SPACE(10)
      981           ( if trim(propis) begins trim( abbr ) then string( "0 " + propis ) else propis )
      982           format "X(120)" SKIP(2).
      983   PUT SPACE(20) "Зав. складом/Зав. секцией : " format "X(30)" SKIP.
      984   output CLOSE.
      985   if g#quest-print = false
      986   then do:
      987     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
      988                                         7, (if 8 >= 8 then 2 else 0), 0, 0,
      989                                         OUTPUT g#log ).
      990   end.
      991   else do:
      992     os-command silent
      993       value( "COPY /b " +
      994         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
      995         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
      996         string( session:temp-directory) +  "$" + string( g#report-num )
      997                 ) .
      998     os-command silent
      999       value( "COPY /b " +
     1000         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
     1001         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
     1002         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
     1003                 ) .
     1004   end.
