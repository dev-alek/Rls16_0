      542               string( (if prod-price then "(Прод. цена на момент печати)" else "" ) ) AT 125 format "X(35)"
      543               string( "Страница " + string(PAGE-NUMBER) ) AT 164 format "X(15)" SKIP
      544           Line format "X(180)" AT 1
      545       with width 235 stream-io.
