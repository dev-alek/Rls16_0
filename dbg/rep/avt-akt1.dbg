      496             v-cntxp-out-rate        = bf-cntxp_shop.out-rate
      497             v-cntxp-out-line-discnt = bf-cntxp_shop.out-line-discnt
      498             v-cntxp-in-ov           = bf-cntxp_shop.in-ov
      499             v-cntxp-in-perm         = bf-cntxp_shop.in-perm
      500             v-cntxp-no-eq           = bf-cntxp_shop.no-eq
      501             v-cntxp-rsrv-time       = bf-cntxp_shop.rsrv-time
