      603       do:
      604           PUT SPACE(20) string( "ПОСТАВЩИК : " + t-doc.cli-name ) format "x(90)" SKIP(1) .
      605       end.
      606   FORM HEADER
      607       Line format "X(180)" AT 1 SKIP
      608       "Продолжение - на следующей странице" AT 30 SKIP
      609       with FRAME BottomFrame width 235 PAGE-BOTTOM NO-LABELS NO-BOX .
      610   VIEW FRAME BottomFrame .
      611   FOR EACH doc-line WHERE doc-line.doc-code = t-doc.doc-code NO-LOCK ,
