      614                                               gds-dtl.prod-code = doc-line.prod-code AND
      615                                               gds-dtl.artic = doc-line.artic NO-LOCK,
      616           EACH goods WHERE goods.prod-type = gds-dtl.prod-type AND
      617                                              goods.prod-code = gds-dtl.prod-code AND
      618                                              goods.artic = gds-dtl.artic NO-LOCK
      619               BREAK BY gds-dtl.artic BY gds-dtl.prt-code with FRAME Akt :
      620          FOR EACH t-doc-line :
