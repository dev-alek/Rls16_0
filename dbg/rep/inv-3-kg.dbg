     2330   procedure PrintTitul :
     2331     define variable v-organization  as character    no-undo.
     2332     define variable v-object        as character    no-undo.
     2333     do on error undo, return error return-value  :
     2334       case ub.clients.obj-type:
     2335          when 'орг':U
     2336          then do:
     2337               FIND ub.firm WHERE ub.firm.firm-code = ub.clients.obj-code NO-LOCK .
     2338               if available ub.firm
     2339               then do:
     2340                   assign
     2341                       t-addres = ( if ub.firm.ind = 0 or ub.firm.ind = ? then "" else string( ub.firm.ind ) )
     2342                       t-addres = t-addres
     2343                           + ( if ub.firm.city = ? or trim(ub.firm.city) = ""
     2344                               then ""
     2345                               else ( (if t-addres = "" then "" else ", ") + trim( ub.firm.city ) )
     2346                             )
     2347                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 1, 50 ) ) )
     2348                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     2349                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     2350                           + ( if  ub.firm.addres2 = ? or trim(ub.firm.addres2) = "" then "" else ( ", " + trim( ub.firm.addres2 ) ) )
     2351                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 51, 50 ) ) )
     2352                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     2353                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     2354                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 101, 50 ) ) )
     2355                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     2356                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     2357                       t-phone = ub.firm.phone
     2358                       t-inn   = ub.firm.inn
     2359                       t-okpo  = ub.firm.okpo
     2360                   .
     2361               end.
     2362          end.
     2363          when 'маг':U
     2364          then do:
     2365               FIND ub.shop WHERE ub.shop.obj-code = ub.clients.obj-code NO-LOCK .
     2366               if available ub.shop
     2367               then do:
     2368                   assign
     2369                       t-addres = ( if trim( shop.addres1 ) <> "" then ( trim( shop.addres1 ) ) else "" )
     2370                               + ( if trim( shop.addres2 ) <> "" then ( ", " + trim( shop.addres2 ) ) else "" )
     2371                       t-phone = shop.phone
     2372                       t-inn = ""
     2373                       t-okpo = ""
     2374                   .
     2375               end.
     2376          end.
     2377          when 'скл':U
     2378          then do:
     2379               FIND ub.store WHERE ub.store.obj-code = ub.clients.obj-code NO-LOCK .
     2380               if available ub.store
     2381               then do:
     2382                   assign
     2383                       t-addres = ( if trim( ub.store.addres1 ) <> "" then ( trim( ub.store.addres1 ) ) else "" )
     2384                               + ( if trim( ub.store.addres2 ) <> "" then ( ", " + trim( ub.store.addres2 ) ) else "" )
     2385                       t-phone = ub.store.phone
     2386                       t-inn = ""
     2387                       t-okpo = ""
     2388                   .
     2389               end.
     2390          end.
     2391          when 'чел':U
     2392          then do:
     2393               find ub.person where ub.person.psn-code = ub.clients.obj-code no-lock .
     2394               if available ub.person
     2395               then do:
     2396                   assign
     2397                       t-addres = ( if ub.person.ind <> 0 and ub.person.ind <> ? then string( ub.person.ind ) else "" )
     2398                                   + ( if  ub.person.city <> ? and trim(ub.person.city) <> "" then ( ", " + trim( ub.person.city ) ) else "" )
     2399                                   + ( if  ub.person.address <> ? and trim(ub.person.address) <> "" then ( ", " + trim( ub.person.address ) ) else "" )
     2400                       t-phone = ub.person.phone1
     2401                       t-inn = ub.person.inn
     2402                       t-okpo = ub.person.okpo
     2403                   .
     2404               end.
     2405          end.
     2406       end case.
     2407       assign
     2408           v-organization = string( "ИНН " + t-inn + " " + CAPS( ub.clients.obj-name ) + " (" + string(ub.clients.obj-code) + ")"
     2409                                 + t-addres + t-phone)
     2410           v-object       = string( CAPS( This_Object.obj-name ) + " (" + string(This_Object.obj-code) + ")" )
     2411       .
     2412       if rep-tipe = "invent" then do:
     2413         if p-grp = "no" then do:
     2414           run inv3xl-write-cell-data in this-procedure ( input "h_organization":U , input v-organization ).
     2415           run inv3xl-write-cell-data in this-procedure ( input "h_object":U , input v-object ).
     2416           run inv3xl-write-cell-data in this-procedure ( input "h_docCode":U , input tdoc-code ).
     2417           run inv3xl-write-cell-data in this-procedure ( input "h_docDate":U , input string( tdoc-date, "99/99/9999") ).
     2418           run inv3xl-write-cell-data in this-procedure ( input "h_tbl_startDate":U , input string( buf_trn-doc.doc-date, "99/99/9999") ).
     2419           run inv3xl-write-cell-data in this-procedure ( input "h_tbl_endDate":U , input ( if buf_trn-doc.status_ <> 'факт':U then string( tdoc-date, "99/99/9999") else "":U ) ).
     2420         end.
     2421         put stream Out-Stream
     2422           space(5) Line format  "x(19)":U at 180 skip
     2423           space(5) "| " at 180 'код':U at 188 "|" at 198 skip
     2424           space(5) "Форма по ОКУД" format "x(14)":U at 166 "| " at 180 "0317004" "|" at 198 skip
     2425           space(5) v-organization format "x(160)"
     2426                      "по ОКПО" format "x(7)":U at 172 "| " at 180 t-okpo format "x(16)":U "|" at 198 skip
     2427           space(5) v-object format "x(160)":U "| " at 180  "|" at 198 skip
     2428           space(5) "Вид деятельности по ОКДП" format "x(25)":U at 155 "| " at 180 "|" at 198 skip
     2429           space(5) string( "Основание для проведения инвентаризации:                 приказ, постановление, распоряжение " ) format "x(160)"
     2430                          "номер" format "x(5)":U at 174 "| " at 180 "|" at 198 skip
     2431           space(5) string( "ненужное зачеркнуть " ) format "x(20)":U at 67
     2432                          "дата" format "x(4)":U at 175 "| " at 180 "|" at 198 skip
     2433           space(5) "Дата начала инвентаризации" format "x(26)":U at 153 "| " at 180 buf_trn-doc.doc-date format "99/99/9999" "|" at 198 skip
     2434           space(5) "Дата окончания инвентаризации" format "x(29)":U at 150 "| " at 180
     2435                          (if buf_trn-doc.status_ <> 'факт':U then tdoc-date else ?) format "99/99/9999" "|" at 198 skip
     2436           space(5) "Вид операции" format "x(12)":U at 167 "| " at 180 " инвентаризация" format "x(16)":U "|" at 198 skip
     2437           space(5) Line format  "x(19)":U at 180 skip(2)
     2438           space(79) Line format "x(33)":U skip
     2439           space(54) string( "ИНВЕНТАРИЗАЦИОННАЯ ОПИСЬ | "
     2440                                       + string( tdoc-code , "x(16)") + " | "
     2441                                       + string( tdoc-date, "99/99/9999")
     2442                                       + " | "  + (if buf_trn-doc.status_ <> 'факт':U then string( "(" + CAPS(buf_trn-doc.status_) + ")" ) else "")
     2443                                       ) format "x(100)":U skip
     2444           space(79) Line format "x(33)":U skip
     2445           space(54) "товарно-материальных ценностей" format "x(30)":U skip( 1 )
     2446           space(5) UndLine format "x(191)":U " ," skip
     2447           space(52) "вид товарно-материальных ценностей" format "x(34)":U skip( 1 )
     2448           space(5) string( "находящиеся " + UndLine ) format "x(193)":U skip
     2449           space(52) "в собственности организации, полученные для переработки" format "x(55)":U skip(2)
     2450           space(60) "РАСПИСКА" format "x(8)":U skip(2)
     2451           space(10) "К началу проведения инвентаризации все расходные и приходные документы на товарно-материальные ценности сданы" format "x(188)":U skip
     2452           space(5) "в бухгалтерию и все  товарно-материальные ценности,  поступившие  на  мою (нашу) ответственность,  оприходованы,  а выбывшие  списаны" format "x(193)":U skip
     2453           space(5) "в расход." format "x(193)":U skip( 1 )
     2454           space(5) "Материально ответственное (ые) лицо (а): " format "x(41)"
     2455                          UndLine format "x(25)":U at 50 UndLine format "x(25)":U at 80 UndLine format "x(50)":U at 110 skip
     2456           "должность" format "x(25)":U at 50 "подпись" format "x(25)":U at 80 "расшифровка подписи" format "x(50)":U at 110 skip( 1 )
     2457           UndLine format "x(25)":U at 50 UndLine format "x(25)":U at 80 UndLine format "x(50)":U at 110 skip
     2458           "должность" format "x(25)":U at 50 "подпись" format "x(25)":U at 80 "расшифровка подписи" format "x(50)":U at 110 skip( 1 )
     2459           space(5) "Произведено снятие фактических остатков ценностей по состоянию на <<       >> _________________        г." format "x(193)":U skip(4)
     2460         .
     2461       end.
     2462       else do:
     2463         put stream Out-Stream
     2464           space(5) Line format  "x(19)":U at 180 skip
     2465           space(5) "| " at 180 'код':U at 188 "|" at 198 skip
     2466           space(5) "Форма по ОКУД" format "x(14)":U at 166 "| " at 180 "0317017" "|" at 198 skip
     2467           space(5) string( "ИНН " + t-inn + " " + CAPS( ub.clients.obj-name ) + " (" + string(ub.clients.obj-code) + ")"
     2468                                     + t-addres + t-phone) format "x(160)"
     2469                          "по ОКПО" format "x(7)":U at 172 "| " at 180 t-okpo format "x(16)":U "|" at 198 skip
     2470           space(5) string( CAPS( This_Object.obj-name ) + " (" + string(This_Object.obj-code) + ")" ) format "x(160)":U "| " at 180  "|" at 198 skip
     2471           space(5) "Вид деятельности по ОКДП" format "x(25)":U at 155 "| " at 180 "|" at 198 skip
     2472           space(5) string( "Основание для проведения инвентаризации:                 приказ, постановление, распоряжение " ) format "x(160)"
     2473                          "номер" format "x(5)":U at 174 "| " at 180 "|" at 198 skip
     2474           space(5) string( "ненужное зачеркнуть " ) format "x(20)":U at 67
     2475                          "дата" format "x(4)":U at 175 "| " at 180 "|" at 198 skip
     2476           space(5) "Дата начала инвентаризации" format "x(26)":U at 153 "| " at 180 buf_trn-doc.doc-date format "99/99/9999" "|" at 198 skip
     2477           space(5) "Дата окончания инвентаризации" format "x(29)":U at 150 "| " at 180
     2478                          (if buf_trn-doc.status_ <> 'факт':U then tdoc-date else ?) format "99/99/9999" "|" at 198 skip
     2479           space(5) "Вид операции" format "x(12)":U at 167 "| " at 180 " инвентаризация" format "x(16)":U "|" at 198 skip
     2480           space(5) Line format  "x(19)":U at 180 skip(2)
     2481           space(79) Line format "x(33)":U skip
     2482           space(56) string( "СЛИЧИТЕЛЬНАЯ ВЕДОМОСТЬ | "
     2483                                       + string( tdoc-code , "x(16)") + " | "
     2484                                       + string( tdoc-date, "99/99/9999")
     2485                                       + " | "  + (if buf_trn-doc.status_ <> 'факт':U then string( "(" + CAPS(buf_trn-doc.status_) + ")" ) else "")
     2486                                       ) format "x(100)":U skip
     2487           space(79) Line format "x(33)":U skip
     2488           space(40) "результатов инвентаризации товарно-материальных ценностей" format "x(130)":U skip(2)
     2489           space(52) "Проведена инвентаризация фактического наличия ценностей, находящихся на ответственном хранении" format "x(134)":U skip(3)
     2490            UndLine format "x(25)":U at 10 UndLine format "x(90)":U at 50 skip
     2491           "должность" format "x(25)":U at 10 "фамилия,имя,отчество" format "x(50)":U   at 50 skip( 1 )
     2492           UndLine format "x(25)":U at 10 UndLine format "x(90)":U at 50 skip
     2493           "должность" format "x(25)":U at 10 "фамилия,имя,отчество" format "x(50)":U  at 50 skip( 1 )
     2494           space(5) "По состоянию на <<       >> _________________        г." format "x(193)":U skip(2)
     2495           space(5) "При инвентаризации установлено следующее :" skip
     2496         .
     2497       end.
     2498       page stream Out-Stream.
     2499     end.
     2500   end procedure.
     2501   procedure PrintPodval :
     2502     do on error undo, return error return-value  :
     2503       run rep/wp-qnty.p ( num-ln , output PropisCount).
     2504       if PropisCount = '' Then PropisCount = 'Ноль'.
     2505       if rep-tipe = "invent" then do:
     2506         PAGE stream Out-Stream.
     2507         HIDE stream Out-Stream FRAME BottomFrame.
     2508         HIDE stream Out-Stream FRAME BottomFrame2.
     2509         run rep/wp-qnty.p ( sum1-a-qnty , output PropisQnty).
     2510         if PropisQnty = '' Then PropisQnty = 'Ноль'.
     2511         if PrintRubl = yes then do: run rep/wp-rub.p (                      input sum1-a-stoim, output PropisSumall, output abbr ). end.
     2512                            else do: run rep/wp.p     ( input parParentProc, input sum1-a-stoim, output PropisSumall, output abbr ). end.
     2513         if p-grp = "no" then do:
     2514           run inv3xl-write-cell-data in this-procedure ( input "f_itNumStr":U , input PropisCount ).
     2515           run inv3xl-write-cell-data in this-procedure ( input "f_itQntyFactStr":U , input PropisQnty ).
     2516           run inv3xl-write-cell-data in this-procedure ( input "f_itSumFactStr":U , input PropisSumall ).
     2517           run inv3xl-write-cell-data in this-procedure ( input "it_qntyFact":U , input string( sum1-a-qnty ) ).
     2518           run inv3xl-write-cell-data in this-procedure ( input "it_sumFact":U , input string( sum1-a-stoim ) ).
     2519           run inv3xl-write-cell-data in this-procedure ( input "it_qntyBuh":U , input string( sum1-b-qnty ) ).
     2520           run inv3xl-write-cell-data in this-procedure ( input "it_sumBuh":U , input string( sum1-b-stoim ) ).
     2521         end.
     2522         put stream Out-Stream
     2523                 "Итого по описи :" skip
     2524                   "а) количество порядковых номеров: " + string( num-ln ) + " (" + PropisCount + ")"  format "x(179)":U                         at 18 skip
     2525                   "б) общее количество единиц фактически: " + string( sum1-a-qnty ) + " (" + PropisQnty + ")"  format "x(179)":U  at 18 skip
     2526                   "в) на сумму фактически : " + trim(string((sum1-a-stoim ), "->,>>>,>>>,>>>,>>>,>>>,>>9.99")) + abbr +
     2527                                 " (" + PropisSumall + ")"  format "x(179)":U                                                 at 18 skip( 1 )
     2528                 "   Все цены, подсчеты итогов по строкам, страницам и в целом по инвентаризационной описи товарно-материальных ценностей проверены." skip
     2529                 "Председатель комиссии: " format "x(25)":U at 10 LineBuf format "x(25)":U at 40 LineBuf format "x(50)":U at 70 skip
     2530                 " " format "x(25)":U at 10 "подпись" format "x(25)":U at 40 "расшифровка подписи" format "x(50)":U at 70 skip
     2531                 "Члены комиссии: " format "x(25)":U at 10 skip
     2532                 LineBuf format "x(25)":U at 10 LineBuf format "x(25)":U at 40 LineBuf format "x(50)":U at 70 skip
     2533                 "должность" format "x(25)":U at 10 "подпись" format "x(25)":U at 40 "расшифровка подписи" format "x(50)":U at 70 skip
     2534                 LineBuf format "x(25)":U at 10 LineBuf format "x(25)":U at 40 LineBuf format "x(50)":U at 70 skip
     2535                 "должность" format "x(25)":U at 10 "подпись" format "x(25)":U at 40 "расшифровка подписи" format "x(50)":U at 70 skip
     2536                 LineBuf format "x(25)":U at 10 LineBuf format "x(25)":U at 40 LineBuf format "x(50)":U at 70 skip
     2537                 "должность" format "x(25)":U at 10 "подпись" format "x(25)":U at 40 "расшифровка подписи" format "x(50)":U at 70 skip
     2538                 "   Все товарно-материальные ценности, поименованные  в  настоящей  инвентаризационной  описи  с № ___________ по № _________" skip
     2539                 "комиссией проверены в натуре в моем (нашем) личном присутствии  и внесены в опись, в связи с чем претензий к инвентаризационной " skip
     2540                 "комиссии не имею (не имеем). Товарно-материальные ценности, перечисленные в описи, находятся на моем (нашем) ответственном хранении." skip( 1 )
     2541                 "   Лицо(а), ответственное(ые) за сохранность товарно-материальных ценностей : " skip( 1 )
     2542                 LineBuf format "x(25)":U at 10 LineBuf format "x(25)":U at 40 LineBuf format "x(50)":U at 70 skip
     2543                 "должность" format "x(25)":U at 10 "подпись" format "x(25)":U at 40 "расшифровка подписи" format "x(50)":U at 70 skip
     2544                 LineBuf format "x(25)":U at 10 LineBuf format "x(25)":U at 40 LineBuf format "x(50)":U at 70 skip
     2545                 "должность" format "x(25)":U at 10 "подпись" format "x(25)":U at 40 "расшифровка подписи" format "x(50)":U at 70 skip
     2546                 LineBuf format "x(25)":U at 10 LineBuf format "x(25)":U at 40 LineBuf format "x(50)":U at 70 skip
     2547                 "должность" format "x(25)":U at 10 "подпись" format "x(25)":U at 40 "расшифровка подписи" format "x(50)":U at 70 skip( 1 )
     2548                 "<<       >> _________________        г. "   skip( 1 )
     2549                 "Указанные в настоящей описи данные и расчеты проверил"
     2550                     LineBuf format "x(25)":U at 10 LineBuf format "x(25)":U   at 40 LineBuf format "x(50)":U               at 70 skip
     2551                 "должность" format "x(25)":U at 10 "подпись" format "x(25)":U at 40 "расшифровка подписи" format "x(50)":U at 70 skip
     2552                 "<<       >> _________________        г. "
     2553         .
     2554       end.
     2555       else do:
     2556         if PrintRubl = yes then do: run rep/wp-rub.p (                      input ( sum1-a-stoim - sum1-b-stoim ), output PropisSumall, output abbr ). end.
     2557                            else do: run rep/wp.p     ( input parParentProc, input ( sum1-a-stoim - sum1-b-stoim ), output PropisSumall, output abbr ). end.
     2558         run rep/wp-qnty.p ( input ( sum1-a-qnty - sum1-b-qnty ), output PropisQnty ).
