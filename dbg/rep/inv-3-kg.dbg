      433     function valid-density returns logical ( input p-density as decimal, input p-unit-base-cli-eq as logical ) :
      434       define variable v-answ as logical no-undo .
      435       if ( p-unit-base-cli-eq = true
      436            and p-density = 1.0
      437          )
      438         or ( p-unit-base-cli-eq = false
      439              and p-density <> ?
      440              and p-density > 0.0
      441              and p-density < 1.0
      442            )
      443       then do:
      444         assign
      445           v-answ = true
      446         .
      447       end.
      448       else do:
      449         assign
      450           v-answ = false
      451         .
      452       end.
      453       return v-answ.
      454     end function.
