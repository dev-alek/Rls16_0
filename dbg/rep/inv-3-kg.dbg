     2574   end procedure.
     2575   PROCEDURE on-same-page :
     2576     define input parameter p-line-number as integer no-undo.
     2577     if p-line-number > page-size( Out-Stream ) then do: return. end.
     2578     if line-counter( Out-Stream ) + p-line-number > page-size( Out-Stream ) then do: page stream Out-Stream. end.
     2579   end procedure.
     2580   procedure Check-Doc-Sum :
     2581     define variable v-attr-value as character no-undo.
     2582     define variable v-attr-type  as character no-undo.
     2583     define variable ask          as logical   no-undo.
     2584     do on error undo, return error return-value :
     2585   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input buf_trn-doc.doc-code ,
     2586                           input 'addsum':U ,
     2587                          output v-attr-value ,
     2588                          output v-attr-type )  .
     2589       if buf_trn-doc.status_ = 'факт':U then do:
     2590         case rep-tipe :
     2591           when "invent" then do:
     2592             if lookup( 'bd':U, v-attr-value ) = 0 or
     2593                lookup( 'ad':U,  v-attr-value ) = 0 then do:
     2594               run utl/uaddsum.p ( input buf_trn-doc.doc-code, input no, input no, input no ) no-error.
     2595               if error-status :error then do: message return-value error-status :get-message( 1 ) view-as alert-box error. end.
     2596             end.
     2597           end.
     2598           when "sl"     then do:
     2599             if lookup( 'gen':U, v-attr-value ) = 0 or
     2600                lookup( 'wst':U, v-attr-value ) = 0 then do:
     2601               run utl/uaddsum.p ( input buf_trn-doc.doc-code, input yes, input yes, input no ) no-error.
     2602               if error-status :error then do: message return-value error-status :get-message( 1 ) view-as alert-box error. end.
     2603             end.
     2604           end.
     2605         end case.
     2606       end.
     2607       else do:
     2608         case rep-tipe :
     2609           when "invent" then do:
     2610             if lookup( 'bd':U, v-attr-value ) = 0 then do:
     2611               message "Не рассчитаны данные до начала инвентаризации!" view-as alert-box.
     2612               undo, return error.
     2613             end.
     2614             if lookup( 'ad':U, v-attr-value ) = 0 then do:
     2615               if p-no-vat = "yes" then do:
     2616                 message "Не рассчитаны данные после инвентаризации!" view-as alert-box.
     2617                 undo, return error.
     2618               end.
     2619               assign is-after = no.
     2620             end.
     2621           end.
     2622           when "sl"     then do:
     2623             if lookup( 'wst':U, v-attr-value ) = 0 then do:
     2624               message "Не рассчитаны нормы естественной убыли!" skip
     2625                       "Напечатать документ без их учета?"
     2626               view-as alert-box question buttons yes-no update ask.
     2627               if ask = yes then do: assign is-wastage = no. end.
     2628                            else do: undo, return error. end.
     2629             end.
     2630             if lookup( 'gen':U, v-attr-value ) = 0 then do: assign is-general = no. end.
     2631           end.
     2632         end case.
     2633       end.
     2634     end.
     2635   end procedure.
