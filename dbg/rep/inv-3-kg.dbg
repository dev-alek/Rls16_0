        8   define variable vss-revision    as character no-undo initial "$Revision: 053a3dce2430, 1077, rls $":U.
        9   define variable vss-author      as character no-undo initial "$Author: EShklyar $":U.
       10   define variable vss-date        as character no-undo initial "$Date: Fri Oct 06 18:38:00 2017 +0300 $":U.
