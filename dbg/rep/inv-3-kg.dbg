      687   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      688   empty temp-table thbjattr_thbj-attr.
      689   run adm/shattri.p (
      690      input "get":U
      691     ,input ''
      692     ,input 0
      693     ,input 'prt-glob':U
      694     ,input  ""
      695     ,output v-value-character
      696     ,output v-value-date
      697     ,output v-value-decimal
      698     ,output v-value-integer
      699     ,output v-value-logical
      700     ,output par-type
      701     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
      702     ) no-error .
      703     for each thbjattr_thbj-attr :
      704         if thbjattr_thbj-attr.prop-code = 'sort-prd' then v-sort-prod = string( thbjattr_thbj-attr.property-value-logical) .
      705         if thbjattr_thbj-attr.prop-code = 'invprn0'  then v-prn0      = string( thbjattr_thbj-attr.property-value-logical) .
      706     end.
      707     if      p-grp = "yes"  then do: assign v-sort-prod = "no".  end.
      708     else if p-grp = "prod" then do: assign v-sort-prod = "yes". end.
      709     else do:
      710     end.
      711     if sort-name = no then do:
      712       message 'Сортировать по коду?' skip
      713               'При ответе "НЕТ(NO)" - сортировка по артикулу.'
      714       view-as alert-box question buttons yes-no update sort-code.
      715     end.
      716     assign sort-group = ( if sort-gr = yes or p-grp = "yes" then yes else no ).
      717     find first buf_trn-doc no-lock where recid( buf_trn-doc ) = rec_id.
      718     assign tdoc-date = ( if buf_trn-doc.status_ <> 'факт':U then buf_trn-doc.doc-date else buf_trn-doc.fact-date )
      719            tdoc-code = buf_trn-doc.doc-code.
      720     run Check-Doc-Sum in this-procedure no-error.
      721     if error-status :error then do: return error. end.
      722     if rep-tipe = "invent" and PrintScale = yes then do:
      723       message "Инвентаризационная опись не проводится с разбиением по признакам !" view-as alert-box.
      724       assign PrintScale = no.
      725     end.
      726     if session :set-wait-state( "COMPILER":U ) then do: end.
      727     define variable v-host-code as integer   no-undo .
      728     define variable v-curr-code as integer   no-undo .
      729   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      730   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      731     (input  buf_trn-doc.obj-type
      732     ,input  buf_trn-doc.obj-code
      733     ,output v-host-code
      734     )  .
      735     if printRubl = yes
      736     then do:
      737         assign
      738             v-curr-code = 0
      739         .
      740     end.
      741     else do:
      742   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      743   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
      744     (input  v-host-code
      745     ,output v-curr-code
      746     )  .
      747     end.
      748   define variable vss-include-info12 as character format "X(65)" no-undo
      749   initial "@(#)$Workfile: inv3xl.i $ $Revision: aea5316774be, 0, rls $".
      750   define stream excel-line.
      751   define stream excel-cell.
      752   define temp-table temp_cell-data no-undo
      753       field data-key as character
      754       field data-value as character
      755       index pi is primary unique data-key
      756   .
      757   define temp-table temp_line-data no-undo
      758       field data-key     as character
      759       field xl-line-id   as integer
      760       field num          as integer
      761       field name         as character
      762       field gdscode      as character
      763       field EI           as character
      764       field OKEI         as character
      765       field price        as character
      766       field qntyFact     as character
      767       field sumFact      as character
      768       field qntyBuh      as character
      769       field sumBuh       as character
      770       index pi is primary unique xl-line-id
      771   .
      772   define variable v-inv3xl-current-data-row     as integer      no-undo.
      773   define variable v-inv3xl-cell-file-name       as character    no-undo.
      774   define variable v-inv3xl-data-file-name       as character    no-undo.
      775   procedure inv3xl-init :
      776       define buffer buf_temp_cell-data        for temp_cell-data.
      777       define buffer buf_usr-flt               for ubflt.usr-flt.
      778   do
      779   for buf_temp_cell-data
      780     , buf_usr-flt
      781   on error undo, return error
      782   :
      783       assign
      784           v-inv3xl-current-data-row = 0
      785       .
      786       run gbl/_tmpfile.p (
      787             input "xd"
      788           , input ".txt"
      789           , output v-inv3xl-data-file-name
      790       ).
      791       output stream excel-line to value( v-inv3xl-data-file-name ).
      792       run gbl/_tmpfile.p (
      793             input "xc"
      794           , input ".txt"
      795           , output v-inv3xl-cell-file-name
      796       ).
      797       output stream excel-cell to value( v-inv3xl-cell-file-name ).
      798       if v-curr-code = 0 then do :
      799          run inv3xl-write-cell-data in this-procedure (
      800                input "valutCode":U
      801              , input 0
      802          ).
      803       end.
      804       else do :
      805          run inv3xl-write-cell-data in this-procedure (
      806                input "valutCode":U
      807              , input 1
      808          ).
      809       end.
      810       run inv3xl-write-cell-data in this-procedure (
      811             input "columnList":U
      812           , input "num,name,gdscode,EI,OKEI,price,qntyFact,sumFact,qntyBuh,sumBuh":U
      813       ).
      814       run inv3xl-write-cell-data in this-procedure (
      815             input "columnType":U
      816           , input "I,S,I,S,S,C,D,C,D,C":U
      817       ).
      818       run inv3xl-write-cell-data in this-procedure (
      819             input "columnAmount":U
      820           , input "10":U
      821       ).
      822       run inv3xl-write-cell-data in this-procedure (
      823             input "subtotalList":U
      824           , input "num,qntyFact,qntyBuh":U
      825       ).
      826       run inv3xl-write-cell-data in this-procedure (
      827             input "subtotalType":U
      828           , input "C,S,S,S,S":U
      829       ).
      830       run inv3xl-write-cell-data in this-procedure (
      831             input "subtotalAmount":U
      832           , input "5":U
      833       ).
      834       run inv3xl-write-cell-data in this-procedure (
      835           input "subtotalPropisList":U
      836           , input "num,qntyFact":U
      837       ).
      838       run inv3xl-write-cell-data in this-procedure (
      839           input "subtotalPropisAmount":U
      840           , input "3":U
      841       ).
      842   end.
      843   end procedure.
      844   procedure inv3xl-close :
      845   do
      846   on error undo, return error
      847   :
      848       output stream excel-line close.
      849       output stream excel-cell close.
      850       output to value( string( session:temp-directory + "$" + string( g#report-num ) ) + ".txl" ) append.
      851           export "exe/i3_97.xlt":U.
      852           export "exe/t_97.bas":U.
      853           export v-inv3xl-cell-file-name.
      854           export v-inv3xl-data-file-name.
      855       output close.
      856   end.
      857   end procedure.
      858   procedure inv3xl-write-cell-data :
      859   define input parameter p-data-key   as character        no-undo.
      860   define input parameter p-data-value as character        no-undo.
      861       define buffer buf_temp_cell-data     for temp_cell-data.
      862   do
      863   for buf_temp_cell-data
      864   on error undo, return error
      865   :
      866       find first buf_temp_cell-data
      867            where buf_temp_cell-data.data-key = p-data-key
      868       no-error.
      869       if not available buf_temp_cell-data
      870       then do:
      871           create buf_temp_cell-data.
      872           assign
      873               buf_temp_cell-data.data-key = p-data-key
      874           .
      875       end.
      876       assign
      877           buf_temp_cell-data.data-value = p-data-value
      878       .
      879       put stream excel-cell unformatted
      880                           buf_temp_cell-data.data-key
      881           chr(9)   buf_temp_cell-data.data-value
      882           chr(10)
      883       .
      884   end.
      885   end procedure.
      886   procedure inv3xl-write-line-data :
      887   define input parameter p-num        as integer          no-undo.
      888   define input parameter p-name       as character        no-undo.
      889   define input parameter p-gdscode    as character        no-undo.
      890   define input parameter p-EI         as character        no-undo.
      891   define input parameter p-OKEI       as character        no-undo.
      892   define input parameter p-price      as character        no-undo.
      893   define input parameter p-qntyFact   as character        no-undo.
      894   define input parameter p-sumFact    as character        no-undo.
      895   define input parameter p-qntyBuh    as character        no-undo.
      896   define input parameter p-sumBuh     as character        no-undo.
      897       define buffer buf_temp_line-data        for temp_line-data.
      898   do
      899   for buf_temp_line-data
      900   on error undo, return error
      901   :
      902       for each buf_temp_line-data
      903       :
      904           delete buf_temp_line-data.
      905       end.
      906       create buf_temp_line-data.
      907       assign
      908           v-inv3xl-current-data-row = v-inv3xl-current-data-row + 1
      909       .
      910       assign
      911           buf_temp_line-data.data-key     = "LD":U
      912           buf_temp_line-data.xl-line-id   = v-inv3xl-current-data-row
      913           buf_temp_line-data.num       = p-num
      914           buf_temp_line-data.name      = p-name
      915           buf_temp_line-data.gdscode   = p-gdscode
      916           buf_temp_line-data.EI        = p-EI
      917           buf_temp_line-data.OKEI      = p-OKEI
      918           buf_temp_line-data.price     = p-price
      919           buf_temp_line-data.qntyFact  = p-qntyFact
      920           buf_temp_line-data.sumFact   = p-sumFact
      921           buf_temp_line-data.qntyBuh   = p-qntyBuh
      922           buf_temp_line-data.sumBuh    = p-sumBuh
      923       .
      924       put stream excel-line unformatted
      925                           buf_temp_line-data.data-key
      926           chr(9)   ( if buf_temp_line-data.num = 0 then "":U else string( buf_temp_line-data.num ) )
      927           chr(9)   buf_temp_line-data.name
      928           chr(9)   buf_temp_line-data.gdscode
      929           chr(9)   buf_temp_line-data.EI
      930           chr(9)   buf_temp_line-data.OKEI
      931           chr(9)   buf_temp_line-data.price
      932           chr(9)   buf_temp_line-data.qntyFact
      933           chr(9)   buf_temp_line-data.sumFact
      934           chr(9)   buf_temp_line-data.qntyBuh
      935           chr(9)   buf_temp_line-data.sumBuh
      936           chr(10)
      937       .
      938   end.
      939   end procedure.
      940   procedure inv3xl-run-excel :
      941   define input parameter p-header-filename    as character        no-undo.
      942   define input parameter p-data-filename      as character        no-undo.
      943       define variable v-template-file-name    as character    no-undo.
      944       define variable v-vb-file-name          as character    no-undo.
      945       define buffer buf_temp-param for temp-param .
      946   do
      947   for buf_temp-param
      948   on error undo, return error
      949   :
      950       create buf_temp-param.
      951       assign
      952           v-template-file-name    = search( "exe/i3_97.xlt" )
      953           v-vb-file-name          = search( "exe/t_97.bas")
      954       .
      955       if v-template-file-name = ?
      956       or v-template-file-name = "":U
      957       then do:
      958           message
      959               "Ошибка имени файла шаблона."
      960           view-as alert-box error.
      961       end.
      962       if v-vb-file-name = ?
      963       or v-vb-file-name = "":U
      964       then do:
      965           message
      966               "Ошибка имени файла кода обработки."
      967           view-as alert-box error.
      968       end.
      969       run paramls-write in this-procedure (
      970             input "template":U
      971           , input "template-file-name":U
      972           , input v-template-file-name
      973       ).
      974       run paramls-write in this-procedure (
      975             input "template":U
      976           , input "vb-file-name":U
      977           , input v-vb-file-name
      978       ).
      979       run paramls-write in this-procedure (
      980             input "data":U
      981           , input "data-header-filename":U
      982           , input p-header-filename
      983       ).
      984       run paramls-write in this-procedure (
      985             input "data":U
      986           , input "data-filename":U
      987           , input p-data-filename
      988       ).
      989       run gbl/macroxlt.p (
      990           input-output table buf_temp-param
      991       ) no-error.
      992       if error-status :error
      993       then do:
      994           message
      995                    vss-workfile vss-revision vss-description
      996               skip(1)
      997               skip "Ошибка создания файла Excel."
      998               skip return-value
      999               skip trim(error-status :get-message(1))
     1000                    trim(error-status :get-message(2))
     1001                    trim(error-status :get-message(3))
     1002           view-as alert-box error.
     1003           undo, return error .
     1004       end.
     1005   end.
     1006   end procedure.
     1007   output stream Out-Stream to value( string( session:temp-directory +
     1008                                        "rpt" + string( g#report-num ) ) )
     1009                                        page-size  value(43) .
     1010     if rep-tipe = "invent" and p-grp = "no" then do: run inv3xl-init in this-procedure. end.
     1011     assign Line    = fill( "-", 230 )
     1012            UndLine = fill( "_", 230 )
     1013            LineBuf = fill( "_", 240 ).
     1014     if CostPrice = yes then DO:
     1015       if p-no-vat = "no" then do:
     1016         assign PP = ( if PrintRubl = yes then "Учетные цены " else "Учетные цены (б.в.)" ).
     1017       end.
     1018       else do:
     1019         assign PP = ( if PrintRubl = yes then "Учетные цены без НДС " else "Учетные цены без НДС (б.в.)" ).
     1020       end.
     1021     end.
     1022     else do:
     1023       assign PP = ( if PrintRubl = yes then "Цены док-та" else "Цены док-та (б.в.)" ).
     1024     end.
     1025     find This_Object no-lock where
     1026          This_Object.obj-type = buf_trn-doc.obj-type  and
     1027          This_Object.obj-code = buf_trn-doc.obj-code.
     1028     find ub.clients  no-lock where
     1029          ub.clients.obj-type  = 'орг':U               and
     1030          ub.clients.obj-code  = buf_trn-doc.host-code.
     1031     run PrintTitul in this-procedure.
     1032     if rep-tipe = "invent" then do:
     1033       form with frame invent.
     1034       form header
     1035         LineBuf format "x(185)":U skip
     1036         string( sym1 + string( PgQnty,   "->>>>>>>>>9.<<<":U    ) + sym2 + string( PgSum,   "->>>>>>>>>>9.99":U    ) + sym6 + "                 ":U +
     1037                 sym3 + string( PgQnty-b, "->>>>>>>>>>>>9.<<<":U ) + sym4 + string( PgSum-b, "->>>>>>>>>>>>>9.99":U ) + sym5 ) at 100 format "x(90)":U skip
     1038         "Итого по странице : " skip
     1039         "а) количество порядковых номеров "      +       string( PgNPP  ) + " (" + f-wp-qnty( decimal( PgNPP  ) ) + ")" format "x(185)":U at 18 skip
     1040         "б) общее количество единиц фактически " +       string( PgQnty ) + " (" + f-wp-qnty( decimal( PgQnty ) ) + ")" format "x(185)":U at 18 skip
     1041         "в) на сумму фактически "                + trim( string( PgSum, "->,>>>,>>>,>>>,>>>,>>>,>>9.99":U ) ) + abbr + " (" + f-wp-sum( decimal( PgSum ) ) + ")" format "x(185)":U at 18 skip( 1 )
     1042         "Вкладной лист к форме № ИНВ-3 №  "      +       string( page-number( Out-Stream ) - 1, ">>>>9":U ) format "x(170)":U at 30 skip
     1043       with frame BottomFrame width 232 page-bottom no-labels no-box.
     1044       view stream Out-Stream frame BottomFrame.
     1045       put  stream Out-Stream space( 35 ) string( "Инвентаризационная опись N " + tdoc-code ) format "x(50)":U skip
     1046         space(  10 ) string( string( This_Object.obj-type, "x(3)":U ) + ": " + trim( This_Object.obj-name ) ) format "x(50)":U
     1047         string( "дата инвентаризации : " + string( tdoc-date, "99.99.9999":U ) ) format "x(50)":U skip.
     1048     end.
     1049     if rep-tipe = "sl" then do: form with frame sl. end.
     1050   define variable v-account as integer init 0 no-undo .
     1051   define variable v-account-lavel as character no-undo .
     1052   define variable v-button-stop as logical no-undo .
     1053   define variable v-kol-spice as integer no-undo .
     1054   define variable v-kol-spice2 as integer no-undo .
     1055   define variable v-kol-spice3 as integer no-undo .
     1056   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     1057   DEFINE BUTTON StopBtn AUTO-END-KEY
     1058        LABEL "Стоп"
     1059        SIZE 10 BY 1.
     1060   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     1061        LABEL "Обработано записей"
     1062         VIEW-AS TEXT
     1063        SIZE 14 BY .67 NO-UNDO.
     1064   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     1065         VIEW-AS TEXT
     1066        SIZE 53.25 BY .67
     1067        FGCOLOR 1  NO-UNDO.
     1068   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     1069         VIEW-AS TEXT
     1070        SIZE 53.25 BY .67
     1071        FGCOLOR 1  NO-UNDO.
     1072   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     1073         VIEW-AS TEXT
     1074        SIZE 53.25 BY .67
     1075        FGCOLOR 1  NO-UNDO.
     1076   DEFINE RECTANGLE RECT-1
     1077        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1078        SIZE 55.13 BY 4.46.
     1079   DEFINE FRAME InfoFrame
     1080        StopBtn AT ROW 4.25 COL 21.75
     1081        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     1082        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     1083        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     1084        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     1085        RECT-1 AT ROW 1 COL 1
     1086       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1087            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1088            TITLE "Процесс"
     1089            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     1090   define variable mFrameView      as logical   no-undo init yes.
     1091     define variable mFramHandle as handle no-undo.
     1092     mFramHandle = frame InfoFrame:handle.
     1093     if  log-manager:logfile-name ne ?
     1094     then DO:
     1095         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1096         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1097         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     1098     end.
     1099     mFrameView = not session:batch-mode and mFramHandle:visible.
     1100     if mFrameView
     1101     then do:
     1102       ASSIGN
     1103          FRAME InfoFrame:HIDDEN                           = TRUE
     1104          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     1105     end.
     1106   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     1107   DO:
     1108     IF not StopProcessing THEN
     1109       Message "Вы действительно хотите прервать" SKIP
     1110               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     1111                 UPDATE StopProcessing.
     1112     IF StopProcessing THEN do:
     1113        if mFrameView
     1114        then do:
     1115           HIDE FRAME InfoFrame.
     1116        end.
     1117     End.
     1118   END.
     1119   assign v-account = ( if integer( 25 ) = 0 then 100 else integer( 25 ) ).
     1120     if  log-manager:logfile-name ne ?
     1121     then DO:
     1122         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     1123     end.
     1124     if not session:batch-mode then
     1125     do:
     1126       VIEW FRAME InfoFrame.
     1127       mFrameView = true.
     1128     end.
     1129      v-button-stop = false .
     1130         if mFrameView
     1131         then do:
     1132         if v-button-stop then view STOPBTN in frame InfoFrame.
     1133                          else Hide STOPBTN in frame InfoFrame.
     1134         end.
     1135   define variable vss-include-info13 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1136   define variable is-petrol as logical no-undo.
     1137   define variable is-pieces as logical no-undo.
     1138   define buffer buf_inv-line for ub.inv-line.
     1139   for each  buf_doc-line no-lock where
     1140             buf_doc-line.doc-code = buf_trn-doc.doc-code
     1141     , first buf_inv-line no-lock where
     1142             buf_inv-line.doc-code  = buf_doc-line.doc-code  and
     1143             buf_inv-line.artic     = buf_doc-line.artic     and
     1144             buf_inv-line.prod-type = buf_doc-line.prod-type and
     1145             buf_inv-line.prod-code = buf_doc-line.prod-code
     1146     , first buf_goods no-lock where
     1147             buf_goods.prod-type = buf_doc-line.prod-type and
     1148             buf_goods.prod-code = buf_doc-line.prod-code and
     1149             buf_goods.artic     = buf_doc-line.artic
     1150     , first ub.units no-lock where
     1151             ub.units.unit-name = buf_goods.unit-base
     1152   :
     1153   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     1154     (
     1155        input buf_doc-line.artic
     1156     ,  input buf_doc-line.prod-type
     1157     ,  input buf_doc-line.prod-code
     1158     , output is-petrol
     1159     , output is-pieces
     1160     ) no-error.
     1161     if error-status :error or is-petrol <> yes or is-pieces <> no then do: next. end.
     1162   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1163     (input  buf_goods.gds-code
     1164     ,input  ?
     1165     ,output b-code
     1166     ) no-error .
     1167     if error-status :error then do:
     1168       message vss-workfile skip vss-date skip vss-revision skip( 1 ) vss-description skip( 1 )
     1169               "Ошибка при определении бар-кода товара"     skip
     1170               "Артикул товара:" buf_goods.artic            skip
     1171               "Производитель:"  buf_goods.prod-type buf_goods.prod-code skip
     1172               error-status :get-message( 1 ) skip
     1173               error-status :get-message( 2 ) skip
     1174               return-value                   skip( 1 )
     1175       view-as alert-box error.
     1176     end.
     1177     assign Counter1 = Counter1 + 1.
     1178   IF ( Counter1 modulo v-account = 0 )  then DO:
     1179             if  log-manager:logfile-name ne ?
     1180             then DO:
     1181                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     1182             end.
     1183              if mFrameView
     1184              then do:
     1185               DISPLAY
     1186                 Counter1 @ RecordsDone
     1187                 WITH FRAME InfoFrame.
     1188              end.
     1189   End.
     1190      if v-button-stop then  DO:
     1191            if mFrameView
     1192            then
     1193               PROCESS EVENTS.
     1194            IF StopProcessing THEN DO:
     1195            RETURN error.
     1196            End.
     1197      end.
     1198     create temp-str.
     1199     assign temp-str.b-code      = string( b-code )
     1200            temp-str.grp-name    = buf_goods.grp-name
     1201            temp-str.artic       = buf_goods.artic
     1202            temp-str.prod-type   = buf_goods.prod-type
     1203            temp-str.prod-code   = buf_goods.prod-code
     1204            temp-str.gds-code    = buf_goods.gds-code
     1205            temp-str.OKEI        = units.OKEI
     1206            temp-str.unit-base   = buf_goods.unit-cli
     1207            temp-str.tb-code     = buf_goods.sort
     1208            temp-str.gds-name    = ( if g#gds-engl = yes then buf_goods.engl-name else buf_goods.gds-name ).
     1209   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1210   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
     1211     (input  buf_goods.artic
     1212     ,input  buf_goods.prod-type
     1213     ,input  buf_goods.prod-code
     1214     ,output v-root-node
     1215     )  .
     1216   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtat in g#library
     1217     (input  v-root-node
     1218     ,input  'empty-scale=request'
     1219     ,output temp-str.empty-scale
     1220     )  .
     1221     if rep-tipe = "invent" then do:
     1222       find first buf_doc-line-sum no-lock where
     1223                  buf_doc-line-sum.doc-code = buf_doc-line.doc-code and
     1224                  buf_doc-line-sum.gds-code = buf_goods.gds-code    and
     1225                  buf_doc-line-sum.sum-type = 'bd':U     no-error.
     1226       if costprice = yes then do:
     1227         if p-no-vat = "no" then do:
     1228           if PrintRubl = yes then do: assign temp-str.b-stoim = buf_doc-line-sum.cost-sum-rubl. end.
     1229                              else do: assign temp-str.b-stoim = buf_doc-line-sum.cost-sum-base. end.
     1230         end.
     1231         else do:
     1232           if PrintRubl = yes then do: assign temp-str.b-stoim = buf_doc-line-sum.cost-sum-rubl - buf_doc-line-sum.cost-VAT-rubl. end.
     1233                              else do: assign temp-str.b-stoim = buf_doc-line-sum.cost-sum-base - buf_doc-line-sum.cost-VAT-base. end.
     1234         end.
     1235       end.
     1236       else do:
     1237         if PrintRubl = yes then do: assign temp-str.b-stoim = buf_doc-line-sum.crsa-sum-rubl. end.
     1238                            else do: assign temp-str.b-stoim = buf_doc-line-sum.crsa-sum-base. end.
     1239       end.
     1240       assign temp-str.b-qnty      = ( buf_inv-line.wast-cli-qnty - buf_doc-line.cli-qnty )
     1241              temp-str.price-befor = temp-str.b-stoim / temp-str.b-qnty.
     1242       if temp-str.price-befor = ? then do: assign temp-str.price-befor = 0. end.
     1243       if is-after = yes then do:
     1244         find first buf_doc-line-sum no-lock where
     1245                    buf_doc-line-sum.doc-code = buf_doc-line.doc-code and
     1246                    buf_doc-line-sum.gds-code = buf_goods.gds-code    and
     1247                    buf_doc-line-sum.sum-type = 'ad':U      no-error.
     1248         if costprice = yes then do:
     1249           if p-no-vat = "no" then do:
     1250             if PrintRubl = yes then do: assign temp-str.a-stoim = buf_doc-line-sum.cost-sum-rubl. end.
     1251                                else do: assign temp-str.a-stoim = buf_doc-line-sum.cost-sum-base. end.
     1252           end.
     1253           else do:
     1254             if PrintRubl = yes then do: assign temp-str.a-stoim = buf_doc-line-sum.cost-sum-rubl - buf_doc-line-sum.cost-VAT-rubl. end.
     1255                                else do: assign temp-str.a-stoim = buf_doc-line-sum.cost-sum-base - buf_doc-line-sum.cost-VAT-base. end.
     1256           end.
     1257         end.
     1258         else do:
     1259           if PrintRubl = yes then do: assign temp-str.a-stoim = buf_doc-line-sum.crsa-sum-rubl. end.
     1260                              else do: assign temp-str.a-stoim = buf_doc-line-sum.crsa-sum-base. end.
     1261         end.
     1262         assign temp-str.a-qnty      = buf_inv-line.wast-cli-qnty
     1263                temp-str.price-after = temp-str.a-stoim / temp-str.a-qnty.
     1264       end.
     1265       else do:
     1266         if costprice = yes then do:
     1267           if PrintRubl = yes then do: assign sum = buf_doc-line.price-rubl * buf_doc-line.fact-qnty. end.
     1268                              else do: assign sum = buf_doc-line.price-base * buf_doc-line.fact-qnty. end.
     1269         end.
     1270         else do:
     1271           assign sum = 0.
     1272           for each buf_gds-dtl no-lock where
     1273                    buf_gds-dtl.doc-code  = buf_doc-line.doc-code  and
     1274                    buf_gds-dtl.artic     = buf_doc-line.artic     and
     1275                    buf_gds-dtl.prod-type = buf_doc-line.prod-type and
     1276                    buf_gds-dtl.prod-code = buf_doc-line.prod-code :
     1277             if PrintRubl = yes then do: assign sum = sum + buf_gds-dtl.price-rubl * buf_gds-dtl.doc-qnty. end.
     1278                                else do: assign sum = sum + buf_gds-dtl.price-base * buf_gds-dtl.doc-qnty. end.
     1279           end.
     1280         end.
     1281         assign temp-str.a-stoim     = temp-str.b-stoim + sum
     1282                temp-str.a-qnty      = temp-str.b-qnty  + buf_inv-line.wast-cli-qnty
     1283                temp-str.price-after = temp-str.a-stoim / temp-str.a-qnty.
     1284       end.
     1285       if temp-str.price-after = ? then do: assign temp-str.price-after = 0. end.
     1286       if v-prn0 = "no" then do:
     1287         if temp-str.a-qnty = 0 and temp-str.a-stoim = 0 and temp-str.b-qnty = 0 and temp-str.b-stoim = 0 then do:
     1288           delete temp-str.
     1289         end.
     1290       end.
     1291     end.
     1292     else do:
     1293       if costprice = yes then do:
     1294         if buf_doc-line.fact-qnty = 0 then do:
     1295           if is-general = yes then do:
     1296             find first buf_doc-line-sum no-lock where
     1297                        buf_doc-line-sum.doc-code = buf_doc-line.doc-code and
     1298                        buf_doc-line-sum.gds-code = buf_goods.gds-code    and
     1299                        buf_doc-line-sum.sum-type = 'gen':U    no-error.
     1300             if PrintRubl = yes then do: assign sum = buf_doc-line-sum.cost-sum-rubl. end.
     1301                                else do: assign sum = buf_doc-line-sum.cost-sum-base. end.
     1302           end.
     1303         end.
     1304         else do:
     1305           if PrintRubl = yes then do: assign sum = buf_doc-line.price-rubl * buf_doc-line.fact-qnty. end.
     1306                              else do: assign sum = buf_doc-line.price-base * buf_doc-line.fact-qnty. end.
     1307         end.
     1308       end.
     1309       else do:
     1310         assign sum = 0.
     1311         for each buf_gds-dtl no-lock where
     1312                  buf_gds-dtl.doc-code  = buf_doc-line.doc-code  and
     1313                  buf_gds-dtl.artic     = buf_doc-line.artic     and
     1314                  buf_gds-dtl.prod-type = buf_doc-line.prod-type and
     1315                  buf_gds-dtl.prod-code = buf_doc-line.prod-code :
     1316           if PrintRubl = yes then do: assign sum = sum + buf_gds-dtl.price-rubl * buf_gds-dtl.doc-qnty. end.
     1317                              else do: assign sum = sum + buf_gds-dtl.price-base * buf_gds-dtl.doc-qnty. end.
     1318         end.
     1319       end.
     1320       assign qnty = buf_doc-line.cli-qnty.
     1321       if sum >= 0 then do:
     1322         assign temp-str.a-qnty      = qnty
     1323                temp-str.a-stoim     = sum
     1324                temp-str.a-qnty1     = buf_doc-line.cli-qnty
     1325                temp-str.ubl         = 0.
     1326         if temp-str.a-qnty = 0 and temp-str.a-stoim = 0 then do: delete temp-str. end.
     1327       end.
     1328       else do:
     1329         assign temp-str.b-qnty      = - qnty
     1330                temp-str.b-stoim     = - sum
     1331                temp-str.b-qnty1     = - buf_doc-line.cli-qnty
     1332                temp-str.ubl         = 0
     1333                sum                  = - sum.
     1334         if is-wastage = yes then do:
     1335           find first buf_doc-line-sum no-lock where
     1336                      buf_doc-line-sum.doc-code = buf_doc-line.doc-code and
     1337                      buf_doc-line-sum.gds-code = buf_goods.gds-code    and
     1338                      buf_doc-line-sum.sum-type = 'wst':U    no-error.
     1339           if available buf_doc-line-sum then do:
     1340             if costprice = yes then do:
     1341               if PrintRubl = yes then do: assign temp-str.ubl = buf_doc-line-sum.cost-sum-rubl. end.
     1342                                  else do: assign temp-str.ubl = buf_doc-line-sum.cost-sum-base. end.
     1343             end.
     1344             else do:
     1345               if PrintRubl = yes then do: assign temp-str.ubl = buf_doc-line-sum.sale-sum-rubl. end.
     1346                                  else do: assign temp-str.ubl = buf_doc-line-sum.sale-sum-base. end.
     1347             end.
     1348             if sum < temp-str.ubl then do: assign temp-str.ubl = sum. end.
     1349           end.
     1350         end.
     1351         if temp-str.b-qnty = 0 and temp-str.b-stoim = 0 then do: delete temp-str. end.
     1352       end.
     1353     end.
     1354   end.
     1355     if v-sort-prod = "yes" then do:
     1356       if sort-group = yes then do:
     1357         for each temp-str no-lock
     1358         break by temp-str.prod-type
     1359               by temp-str.prod-code
     1360               by temp-str.grp-name
     1361               by ( if sort-name = yes then temp-str.gds-name else                  ( if sort-code = yes then temp-str.b-code   else temp-str.artic ) )
     1362         :
     1363           if first-of( temp-str.prod-code ) then do: run print-prod in this-procedure. end.
     1364           if p-grp <> "prod" and first-of( temp-str.grp-name ) then do: run print-grp      in this-procedure. end.
     1365           run print-line in this-procedure.
     1366           if p-grp <> "prod" and  last-of( temp-str.grp-name ) then do: run print-grp-itog in this-procedure. end.
     1367           if last-of( temp-str.prod-code ) then do: run print-prod-itog in this-procedure. end.
     1368         end.
     1369       end.
     1370       else do:
     1371         for each temp-str no-lock
     1372         break by temp-str.prod-type
     1373               by temp-str.prod-code
     1374               by ( if sort-name = yes then temp-str.gds-name else                  ( if sort-code = yes then temp-str.b-code   else temp-str.artic ) )
     1375         :
     1376           if p-grp <> "prod" and first-of( temp-str.prod-code ) then do: run print-prod in this-procedure. end.
     1377           run print-line in this-procedure.
     1378           if last-of( temp-str.prod-code ) then do: run print-prod-itog in this-procedure. end.
     1379         end.
     1380       end.
     1381     end.
     1382     else do:
     1383       if sort-group = yes then do:
     1384         for each temp-str no-lock
     1385         break by temp-str.grp-name
     1386               by ( if sort-name = yes then temp-str.gds-name else                  ( if sort-code = yes then temp-str.b-code   else temp-str.artic ) )
     1387         :
     1388           if p-grp = "no" and first-of( temp-str.grp-name ) then do: run print-grp in this-procedure. end.
     1389           run print-line in this-procedure.
     1390           if last-of( temp-str.grp-name ) then do: run print-grp-itog in this-procedure. end.
     1391         end.
     1392       end.
     1393       else do:
     1394         for each temp-str no-lock break by ( if sort-name = yes then temp-str.gds-name else                  ( if sort-code = yes then temp-str.b-code   else temp-str.artic ) ) :
     1395           run print-line in this-procedure.
     1396         end.
     1397       end.
     1398     end.
     1399     run print-all-itog in this-procedure.
     1400     run on-same-page in this-procedure ( input 14 ).
     1401     run PrintPodval  in this-procedure.
     1402     output stream Out-Stream close.
     1403   if mFrameView
     1404   then do:
     1405      HIDE FRAME InfoFrame.
     1406   end.
     1407     if rep-tipe = "invent" and p-grp = "no" then do: run inv3xl-close in this-procedure. end.
     1408   if g#quest-print = false
     1409   then do:
     1410     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
     1411                                         7, (if 8 >= 8 then 2 else 0), 0, 0,
     1412                                         OUTPUT g#log ).
     1413   end.
     1414   else do:
     1415     os-command silent
     1416       value( "COPY /b " +
     1417         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
     1418         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
     1419         string( session:temp-directory) +  "$" + string( g#report-num )
     1420                 ) .
     1421     os-command silent
     1422       value( "COPY /b " +
     1423         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
     1424         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
     1425         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
     1426                 ) .
     1427   end.
     1428   end.
     1429   procedure print-grp :
     1430     do on error undo, return error return-value :
     1431       case rep-tipe :
     1432         when "invent" then do:
     1433           down stream Out-Stream 1 with frame invent.
     1434           put  stream Out-Stream unformatted string( "_______________Группа : " + trim( caps( temp-str.grp-name ) ) + UndLine ) format "x(185)":U skip.
     1435         end.
     1436         when "sl"     then do:
     1437           down stream Out-Stream 1 with FRAME sl.
     1438           put  stream Out-Stream unformatted string( "_______________Группа : " + trim( caps( temp-str.grp-name ) ) + UndLine ) format "x(162)":U  skip.
     1439         end.
     1440       end case.
     1441     end.
     1442   end procedure.
     1443   procedure print-prod :
     1444     do on error undo, return error return-value :
     1445       if p-grp = "prod" then do: return. end.
     1446       find first buf_clients no-lock where
     1447                  buf_clients.obj-type = temp-str.prod-type and
     1448                  buf_clients.obj-code = temp-str.prod-code.
     1449       case rep-tipe :
     1450         when "invent" then do:
     1451           down stream Out-Stream 1 with frame invent.
     1452           put  stream Out-Stream unformatted string( "________Производитель : " + trim( caps( buf_clients.obj-name ) ) + UndLine ) format "x(185)":U skip.
     1453         end.
     1454         when "sl"     then do:
     1455           down stream Out-Stream 1 with FRAME sl .
     1456           put  stream Out-Stream unformatted string( "________Производитель : " + trim( caps( buf_clients.obj-name ) ) + UndLine ) format "x(162)":U  skip.
     1457         end.
     1458       end case.
     1459     end.
     1460   end procedure.
     1461   procedure print-line :
     1462     do on error undo, return error return-value :
     1463       case rep-tipe :
     1464         when "invent" then do:
     1465   define variable vss-include-info15 as character format "X(65)" no-undo
     1466   initial "@(#)$Workfile$ $Revision$".
     1467     assign Lines_Counter = Lines_Counter + 1  .
     1468     if line-counter( out-stream ) + 2 > page-size( out-stream ) then page stream out-stream.
     1469     if line-counter( Out-Stream ) < Tmp_Counter then
     1470       assign PgNPP = 0  PgQnty = 0 PgSum = 0 PgQnty-b = 0 PgSum-b  = 0  PgQnty-v = 0  PgQnty-b-v = 0 .
     1471     assign
     1472       Tmp_Counter  = line-counter( Out-Stream )
     1473       PgNPP        = PgNPP      + 1
     1474       PgQnty       = PgQnty     + temp-str.a-qnty
     1475       PgQnty-b     = PgQnty-b   + temp-str.b-qnty
     1476       PgQnty-v     = PgQnty-v   + temp-str.a-qnty1
     1477       PgQnty-b-v   = PgQnty-b-v + temp-str.b-qnty1
     1478       PgSum        = PgSum      + temp-str.a-stoim
     1479       PgSum-b      = PgSum-b    + temp-str.b-stoim
     1480       num-ln = num-ln + 1
     1481       sum-a-qnty    = sum-a-qnty    + temp-str.a-qnty
     1482       sum-b-qnty    = sum-b-qnty    + temp-str.b-qnty
     1483       sum-a-qnty1   = sum-a-qnty1   + temp-str.a-qnty1
     1484       sum-b-qnty1   = sum-b-qnty1   + temp-str.b-qnty1
     1485       sum-a-stoim   = sum-a-stoim   + temp-str.a-stoim
     1486       sum-b-stoim   = sum-b-stoim   + temp-str.b-stoim
     1487       sum-ubl       = sum-ubl       + temp-str.ubl
     1488       sum1-a-qnty   = sum1-a-qnty   + temp-str.a-qnty
     1489       sum1-b-qnty   = sum1-b-qnty   + temp-str.b-qnty
     1490       sum1-a-qnty1  = sum1-a-qnty1  + temp-str.a-qnty1
     1491       sum1-b-qnty1  = sum1-b-qnty1  + temp-str.b-qnty1
     1492       sum1-a-stoim  = sum1-a-stoim  + temp-str.a-stoim
     1493       sum1-b-stoim  = sum1-b-stoim  + temp-str.b-stoim
     1494       sum1-ubl      = sum1-ubl      + temp-str.ubl
     1495       sum2-a-qnty   = sum2-a-qnty   + temp-str.a-qnty
     1496       sum2-b-qnty   = sum2-b-qnty   + temp-str.b-qnty
     1497       sum2-a-qnty1  = sum2-a-qnty1  + temp-str.a-qnty1
     1498       sum2-b-qnty1  = sum2-b-qnty1  + temp-str.b-qnty1
     1499       sum2-a-stoim  = sum2-a-stoim  + temp-str.a-stoim
     1500       sum2-b-stoim  = sum2-b-stoim  + temp-str.b-stoim
     1501       sum2-ubl      = sum2-ubl      + temp-str.ubl
     1502     .
     1503     FullNameGds = temp-str.gds-name .
     1504     gds-str1 = breakstr(FullNameGds, 40, input-output  gds-str1, input-output gds-str2).
     1505     assign j = 0.
     1506     DO WHILE gds-str2 <> "" :
     1507       assign gds-str = gds-str2.
     1508       gds-str1 = breakstr(gds-str, 40, input-output gds-str1, input-output gds-str2).
     1509       assign j = j + 1.
     1510     END.
     1511     if line-counter( Out-Stream ) + j > page-size( Out-Stream ) then  PAGE STREAM Out-Stream.
     1512     gds-str1 = breakstr(FullNameGds, 40, input-output  gds-str1, input-output gds-str2).
     1513   if temp-str.aa-qnty <> 0 then do:
     1514       if p-grp = "no" then do:
     1515     display stream Out-Stream
     1516       sym1     num-ln @ Lines_Counter
     1517       sym2     temp-str.artic
     1518       sym3     (if rep-tipe = "invent-gold" OR rep-tipe = "sl-gold" then gds-str1         else temp-str.gds-name) @ temp-str.gds-name
     1519       sym4     (if rep-tipe = "invent-gold" OR rep-tipe = "sl-gold" then temp-str.tb-code else temp-str.b-code)   @ temp-str.b-code
     1520       sym5     temp-str.OKEI
     1521       sym6     temp-str.unit-base
     1522       sym7     temp-str.price-befor
     1523       sym8     temp-str.b-qnty @ temp-str.a-qnty
     1524       sym9    temp-str.b-qnty
     1525       sym10  with FRAME invent.
     1526     DOWN stream Out-Stream 1 with FRAME invent .
     1527     display stream Out-Stream
     1528       sym1     num-ln @ Lines_Counter
     1529       sym2     temp-str.artic
     1530       sym3     (if rep-tipe = "invent-gold" OR rep-tipe = "sl-gold" then gds-str1         else temp-str.gds-name) @ temp-str.gds-name
     1531       sym4     (if rep-tipe = "invent-gold" OR rep-tipe = "sl-gold" then temp-str.tb-code else temp-str.b-code)   @ temp-str.b-code
     1532       sym5     temp-str.OKEI
     1533       sym6     temp-str.unit-base
     1534       sym7     temp-str.price-befor
     1535       sym8     temp-str.aa-qnty @ temp-str.a-qnty
     1536       sym9    0.00 @ temp-str.b-qnty
     1537       sym10  with FRAME invent.
     1538     DOWN stream Out-Stream 1 with FRAME invent .
     1539       if rep-tipe begins "invent"
     1540       and p-grp = "no"
     1541       then do:
     1542           run inv3xl-write-line-data in this-procedure (
     1543               input num-ln
     1544               , input temp-str.artic + " ":U
     1545                   + ( if rep-tipe = "invent-gold"
     1546                       or rep-tipe = "sl-gold"
     1547                       then gds-str1
     1548                       else temp-str.gds-name )
     1549               , input string( if rep-tipe = "invent-gold"
     1550                               or rep-tipe = "sl-gold"
     1551                               then temp-str.tb-code
     1552                               else temp-str.b-code )
     1553               , input temp-str.unit-base
     1554               , input temp-str.OKEI
     1555               , input temp-str.bb-price
     1556               , input temp-str.b-qnty
     1557               , input temp-str.bb-stoim
     1558               , input temp-str.b-qnty
     1559               , input temp-str.b-stoim
     1560           ).
     1561           run inv3xl-write-line-data in this-procedure (
     1562               input num-ln
     1563               , input temp-str.artic + " ":U
     1564                   + ( if rep-tipe = "invent-gold"
     1565                       or rep-tipe = "sl-gold"
     1566                       then gds-str1
     1567                       else temp-str.gds-name )
     1568               , input string( if rep-tipe = "invent-gold"
     1569                               or rep-tipe = "sl-gold"
     1570                               then temp-str.tb-code
     1571                               else temp-str.b-code )
     1572               , input temp-str.unit-base
     1573               , input temp-str.OKEI
     1574               , input temp-str.Price
     1575               , input temp-str.aa-qnty
     1576               , input temp-str.aa-stoim
     1577               , input 0.00
     1578               , input 0.00
     1579           ).
     1580       end.
     1581     if rep-tipe = "invent-gold" OR rep-tipe = "sl-gold" then DO:
     1582       DO WHILE gds-str2 <> "" :
     1583         assign gds-str = gds-str2.
     1584         gds-str1 = breakstr(gds-str, 40, input-output gds-str1, input-output gds-str2).
     1585         DISPLAY STREAM Out-Stream gds-str1 @ temp-str.gds-name sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym10  with frame invent .
     1586         DOWN STREAM Out-Stream 1 with FRAME invent .
     1587           if rep-tipe begins "invent"
     1588           and p-grp = "no"
     1589           then do:
     1590               run inv3xl-write-line-data in this-procedure (
     1591                     input 0
     1592                   , input gds-str1
     1593                   , input "":U
     1594                   , input "":U
     1595                   , input "":U
     1596                   , input "":U
     1597                   , input "":U
     1598                   , input "":U
     1599                   , input "":U
     1600                   , input "":U
     1601               ).
     1602           end.
     1603       END.
     1604     END.
     1605     if PrintScale and temp-str.empty-scale = no THEN DO :
     1606       for each buf_gds-dtl no-lock
     1607         where buf_gds-dtl.doc-code  = buf_trn-doc.doc-code
     1608           and buf_gds-dtl.artic     = temp-str.artic
     1609           and buf_gds-dtl.prod-type = temp-str.prod-type
     1610           and buf_gds-dtl.prod-code = temp-str.prod-code
     1611         :
     1612   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1613     (input  temp-str.gds-code
     1614     ,input  buf_gds-dtl.prt-code
     1615     ,output b-code
     1616     ) no-error .
     1617         if error-status :error then do:
     1618           message vss-workfile vss-revision vss-description skip "Ошибка при определении бар-кода признака" skip  "Код товара" temp-str.gds-code skip  "Код признака" buf_gds-dtl.prt-code skip
     1619           view-as alert-box error .
     1620         end.
     1621         find first buf_gds-prt where buf_gds-prt.node-code  = buf_gds-dtl.prt-code no-lock no-error .
     1622         assign qnty = buf_gds-dtl.doc-qnty .
     1623         if not CostPrice then do:
     1624           if PrintRubl then assign sum = buf_gds-dtl.price-rubl .
     1625           else              assign sum = buf_gds-dtl.price-base .
     1626         end.
     1627         else assign sum = if temp-str.a-stoim <> 0  or temp-str.a-qnty <> 0 then temp-str.a-stoim / temp-str.a-qnty else temp-str.b-stoim / temp-str.b-qnty .
     1628         if qnty >= 0 then do:
     1629           display stream Out-Stream
     1630             sym1     sym2     sym3     ('  /'+ buf_gds-prt.f-name)  @ temp-str.gds-name
     1631             sym4     if rep-tipe = "sl-gold" then "" else string(b-code) @ temp-str.b-code
     1632             sym5     sym6
     1633             sym7     qnty @ temp-str.a-qnty
     1634             sym10
     1635           with FRAME invent.
     1636           if rep-tipe begins "invent"
     1637           and p-grp = "no"
     1638           then do:
     1639               run inv3xl-write-line-data in this-procedure (
     1640                     input 0
     1641                   , input ( "  /":U + buf_gds-prt.f-name )
     1642                   , input ( if rep-tipe = "sl-gold":U
     1643                             then "":U
     1644                             else string( b-code ) )
     1645                   , input "":U
     1646                   , input "":U
     1647                   , input "":U
     1648                   , input string( qnty )
     1649                   , input string( sum * qnty )
     1650                   , input "":U
     1651                   , input "":U
     1652               ).
     1653           end.
     1654         end.
     1655         else do:
     1656           assign qnty = - qnty .
     1657           display stream Out-Stream
     1658             sym1     sym2     sym3  ('  /'+ buf_gds-prt.f-name)  @ temp-str.gds-name
     1659             sym4     if rep-tipe = "sl-gold" then "" else string(b-code) @ temp-str.b-code
     1660             sym5     sym6
     1661             sym7     qnty @ temp-str.b-qnty
     1662                  sym10
     1663           with FRAME invent.
     1664           if rep-tipe begins "invent"
     1665           and p-grp = "no"
     1666           then do:
     1667               run inv3xl-write-line-data in this-procedure (
     1668                     input 0
     1669                   , input ( '  /':U + buf_gds-prt.f-name )
     1670                   , input ( if rep-tipe = "sl-gold":U
     1671                             then "":U
     1672                             else string( b-code ) )
     1673                   , input "":U
     1674                   , input "":U
     1675                   , input "":U
     1676                   , input "":U
     1677                   , input "":U
     1678                   , input string( qnty )
     1679                   , input string( sum * qnty )
     1680               ).
     1681           end.
     1682         end.
     1683         DOWN stream Out-Stream 1 with FRAME invent .
     1684       end.
     1685     end.
     1686     if print-graft = false THEN  Put stream Out-Stream LineBuf format "x(185):U" SKIP.
     1687   end.
     1688   end.
     1689   else do:
     1690   if p-grp = "no" then do:
     1691     display stream Out-Stream
     1692       sym1     num-ln @ Lines_Counter
     1693       sym2     temp-str.artic
     1694       sym3     (if rep-tipe = "invent-gold" OR rep-tipe = "sl-gold" then gds-str1         else temp-str.gds-name) @ temp-str.gds-name
     1695       sym4     (if rep-tipe = "invent-gold" OR rep-tipe = "sl-gold" then temp-str.tb-code else temp-str.b-code)   @ temp-str.b-code
     1696       sym5     temp-str.OKEI
     1697       sym6     temp-str.unit-base
     1698       sym7    temp-str.price-befor
     1699       sym8    temp-str.a-qnty
     1700       sym9     temp-str.a-stoim
     1701       sym9    temp-str.b-qnty
     1702       sym12    temp-str.b-stoim
     1703       sym10  with FRAME invent.
     1704     DOWN stream Out-Stream 1 with FRAME invent .
     1705       if rep-tipe begins "invent"
     1706       and p-grp = "no"
     1707       then do:
     1708           run inv3xl-write-line-data in this-procedure (
     1709               input num-ln
     1710               , input temp-str.artic + " ":U
     1711                   + ( if rep-tipe = "invent-gold"
     1712                       or rep-tipe = "sl-gold"
     1713                       then gds-str1
     1714                       else temp-str.gds-name )
     1715               , input string( if rep-tipe = "invent-gold"
     1716                               or rep-tipe = "sl-gold"
     1717                               then temp-str.tb-code
     1718                               else temp-str.b-code )
     1719               , input temp-str.unit-base
     1720               , input temp-str.OKEI
     1721               , input temp-str.Price-after
     1722               , input temp-str.a-qnty
     1723               , input temp-str.a-stoim
     1724               , input temp-str.b-qnty
     1725               , input temp-str.b-stoim
     1726           ).
     1727       end.
     1728     if rep-tipe = "invent-gold" OR rep-tipe = "sl-gold" then DO:
     1729       DO WHILE gds-str2 <> "" :
     1730         assign gds-str = gds-str2.
     1731         gds-str1 = breakstr(gds-str, 40, input-output gds-str1, input-output gds-str2).
     1732         DISPLAY STREAM Out-Stream gds-str1 @ temp-str.gds-name sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym10  with frame invent .
     1733         DOWN STREAM Out-Stream 1 with FRAME invent .
     1734           if rep-tipe begins "invent"
     1735           and p-grp = "no"
     1736           then do:
     1737               run inv3xl-write-line-data in this-procedure (
     1738                     input 0
