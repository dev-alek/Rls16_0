      304   function breakstr returns character ( input        for-name    as character,
      305                                         input        line-length as integer,
      306                                         input-output line1       as character,
      307                                         input-output line2       as character ) :
      308     define variable ii as integer no-undo.
      309     if length( for-name ) > line-length then do:
      310       assign ii    = 1
      311              line1 = "":u
      312              line2 = "":u.
      313       if length( entry( ii, for-name , " ":u ) ) > line-length then do:
      314         assign line1 =       substring( for-name, 1, line-length     )
      315                line2 = trim( substring( for-name,    line-length + 1 ) ).
      316       end.                                                     else do:
      317         do while length( line1 + entry( ii, for-name, " ":u ) ) < ( line-length + 1 ) :
      318           assign line1 = line1 + entry( ii, for-name, " ":u ) + " ":u
      319                  ii    = ii    + 1.
      320           if length( entry( ii, for-name, " ":u ) ) > line-length then do:
      321             assign line1 = line1 + substring( for-name, length( line1 ), line-length - length( line1 ) + 1 ).
      322           end.
      323         end.
      324         assign line2 = trim( substring( for-name, length( line1 ) ) ).
      325       end.
      326     end.                                else do:
      327       assign line1 = for-name
      328              line2 = "":u.
      329     end.
      330     return ( line1 ).
      331   end function.
