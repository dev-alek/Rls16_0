     2167                   , input string( sum * qnty )
     2168                   , input "":U
     2169                   , input "":U
     2170               ).
     2171           end.
     2172         end.
     2173         else do:
     2174           assign qnty = - qnty .
     2175           display stream Out-Stream
     2176             sym1     sym2     sym3  ('  /'+ buf_gds-prt.f-name)  @ temp-str.gds-name
     2177             sym4     if rep-tipe = "sl-gold" then "" else string(b-code) @ temp-str.b-code
     2178             sym5     sym6
     2179             sym7     qnty @ temp-str.b-qnty
     2180                  sym10
     2181           with FRAME sl.
     2182           if rep-tipe begins "invent"
     2183           and p-grp = "no"
     2184           then do:
     2185               run inv3xl-write-line-data in this-procedure (
     2186                     input 0
     2187                   , input ( '  /':U + buf_gds-prt.f-name )
     2188                   , input ( if rep-tipe = "sl-gold":U
     2189                             then "":U
     2190                             else string( b-code ) )
     2191                   , input "":U
     2192                   , input "":U
     2193                   , input "":U
     2194                   , input "":U
     2195                   , input "":U
     2196                   , input string( qnty )
     2197                   , input string( sum * qnty )
     2198               ).
     2199           end.
     2200         end.
     2201         DOWN stream Out-Stream 1 with FRAME sl .
     2202       end.
     2203     end.
     2204     if print-graft = false THEN  Put stream Out-Stream LineBuf format "x(162):U" SKIP.
     2205   end.
     2206   end.
     2207     end.
     2208       end case.
     2209     end.
     2210   end procedure.
     2211   procedure print-grp-itog :
     2212     do on error undo, return error return-value :
     2213       case rep-tipe :
     2214         when "invent" THEN DO:
     2215           display stream Out-Stream
     2216             "ИТОГО"      @  temp-str.artic
     2217             TRIM(CAPS(temp-str.grp-name)) @ temp-str.gds-name
     2218             sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym9 sym10 sym12  sym13  sym8 sym11
     2219             sum-a-qnty   @ temp-str.a-qnty
     2220             sum-a-stoim  @ temp-str.a-stoim
     2221             sum-b-qnty   @ temp-str.b-qnty
     2222             sum-b-stoim  @ temp-str.b-stoim
     2223           with FRAME invent.
     2224           DOWN stream Out-Stream 1 with FRAME invent .
     2225           if print-graft = no THEN Put stream Out-Stream LineBuf format "x(185)":U skip.
     2226         End.
     2227         when  "sl"  THEN DO:
     2228           display stream Out-Stream
     2229             "ИТОГО"      @  temp-str.artic
     2230             TRIM(CAPS(temp-str.grp-name)) @ temp-str.gds-name
     2231             sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym9 sym10 sym12  sym13
     2232             sym14 sum-ubl @ temp-str.UBL
     2233             sum-a-qnty   @ temp-str.a-qnty
     2234             sum-a-stoim  @ temp-str.a-stoim
     2235             sum-b-qnty   @ temp-str.b-qnty
     2236             sum-b-stoim  @ temp-str.b-stoim
     2237           with FRAME sl.
     2238           DOWN stream Out-Stream 1 with FRAME sl .
     2239           if print-graft = no THEN Put stream Out-Stream LineBuf format "x(162)":U skip.
     2240         End.
     2241       end.
     2242       assign
     2243         sum-a-qnty  = 0
     2244         sum-b-qnty  = 0
     2245         sum-a-qnty1 = 0
     2246         sum-b-qnty1 = 0
     2247         sum-a-stoim = 0
     2248         sum-b-stoim = 0
     2249         sum-ubl     = 0
