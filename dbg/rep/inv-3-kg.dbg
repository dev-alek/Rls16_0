      340   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
      341   procedure paramls-clear :
      342     define buffer buf_temp-param for temp-param .
      343     do
      344     on error undo, return error return-value
      345     :
      346       for each buf_temp-param
      347       on error undo, return error
      348       :
      349         delete buf_temp-param .
      350       end.
      351     end.
      352   end procedure.
      353   procedure paramls-write :
      354     define input  parameter p-code     as character no-undo .
      355     define input  parameter p-sub-code as character no-undo .
      356     define input  parameter p-value    as character no-undo .
      357     define buffer buf_temp-param for temp-param .
      358     do
      359     on error undo, return error return-value
      360     :
      361       find first buf_temp-param
      362         where buf_temp-param.param-code     = p-code
      363           and buf_temp-param.param-sub-code = p-sub-code
      364         no-error .
      365       if not available buf_temp-param then do:
      366         create buf_temp-param .
      367         assign
      368           buf_temp-param.param-code     = p-code
      369           buf_temp-param.param-sub-code = p-sub-code
      370         .
      371       end.
      372       assign
      373         buf_temp-param.param-value = p-value
      374       .
      375     end.
      376   end procedure.
      377   procedure paramls-read :
      378     define input  parameter p-code          as character no-undo .
      379     define input  parameter p-sub-code      as character no-undo .
      380     define input  parameter p-default-value as character no-undo .
      381     define output parameter p-value         as character no-undo .
      382     define buffer buf_temp-param for temp-param .
      383     do
      384     on error undo, return error return-value
      385     :
      386       find first buf_temp-param
      387         where buf_temp-param.param-code     = p-code
      388           and buf_temp-param.param-sub-code = p-sub-code
      389         no-error .
      390       if available buf_temp-param then do:
      391         assign
      392           p-value = buf_temp-param.param-value
      393         .
      394       end.
      395       else do:
      396         assign
      397           p-value = p-default-value
      398         .
      399       end.
      400     end.
      401   end procedure.
      402   procedure paramls-append :
      403     define input  parameter p-code     as character no-undo .
      404     define input  parameter p-sub-code as character no-undo .
      405     define input  parameter p-value    as character no-undo .
      406     define buffer buf_temp-param for temp-param .
      407     do
      408     on error undo, return error return-value
      409     :
      410       find first buf_temp-param
      411            where buf_temp-param.param-code     = p-code
      412              and buf_temp-param.param-sub-code = p-sub-code
      413         no-error .
      414       if not available buf_temp-param then do:
      415         create buf_temp-param .
      416         assign
      417           buf_temp-param.param-code     = p-code
      418           buf_temp-param.param-sub-code = p-sub-code
      419           buf_temp-param.param-value    = p-value
      420         .
      421       end.
      422       else do:
      423           assign
      424               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
      425           .
      426       end.
      427     end.
      428   end procedure.
      429   define new global shared variable g#lib-trn  as handle no-undo .
