     2299   procedure print-all-itog :
     2300     do on error undo, return error return-value :
     2301       case rep-tipe :
     2302         when "invent" THEN DO:
     2303           display stream Out-Stream
     2304             "ИТОГО"      @  temp-str.artic
     2305             sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym9 sym10 sym12  sym13  sym8 sym11
     2306             sum1-a-qnty   @ temp-str.a-qnty
     2307             sum1-a-stoim  @ temp-str.a-stoim
