     1022   procedure uf-get :
     1023     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     1024     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     1025     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     1026     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     1027     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     1028     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     1029     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     1030     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     1031     do
     1032     on error undo, return error
     1033     :
     1034       define buffer buf_usr-flt for ubflt.usr-flt .
     1035       define variable v-use-List_     as logical   no-undo .
     1036       define variable v-type-List_     as character no-undo .
     1037       define variable v-format-List_   as character no-undo .
     1038       define variable v-use-Naim      as logical   no-undo .
     1039       define variable v-type-Naim      as character no-undo .
     1040       define variable v-format-Naim    as character no-undo .
     1041       define variable v-use-print-graft as logical   no-undo .
     1042       define variable v-use-sort-gr     as logical   no-undo .
     1043       define variable v-use-type-price  as logical   no-undo .
     1044       define variable v-use-type-val    as logical   no-undo .
     1045       define variable v-label          as character no-undo .
     1046       define variable v-tooltip        as character no-undo .
     1047       define variable v-user-can-edit  as logical   no-undo .
     1048       define variable v-output-display as logical   no-undo .
     1049       define variable v-other          as character no-undo .
     1050       run uf-name in this-procedure
     1051          (input  entry(1, p-code, chr(4))
     1052         ,output v-use-List_
     1053         ,output v-type-List_
     1054         ,output v-format-List_
     1055         ,output v-use-Naim
     1056         ,output v-type-Naim
     1057         ,output v-format-Naim
     1058         ,output v-use-print-graft
     1059         ,output v-use-sort-gr
     1060         ,output v-use-type-price
     1061         ,output v-use-type-val
     1062         ,output v-label
     1063         ,output v-tooltip
     1064         ,output v-user-can-edit
     1065         ,output v-output-display
     1066         ,output v-other
     1067         ) no-error .
     1068       if error-status :error then do:
     1069         undo, return error return-value .
     1070       end.
     1071       find first buf_usr-flt no-lock where
     1072                  buf_usr-flt.Call-point     = p-code AND
     1073                  buf_usr-flt.user-name       = p-user-name
     1074         no-error .
     1075       if avail buf_usr-flt then do:
     1076         assign
     1077         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
     1078         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
     1079         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
     1080         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
     1081         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
     1082         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
     1083         .
     1084       end.
     1085       else do:
     1086         assign
     1087         p-List_        = (if v-use-List_       then "":U                    else ?)
     1088         p-Naim         = (if v-use-Naim        then "":U                    else ?)
     1089         p-print-graft  = (if v-use-print-graft then no                      else ?)
     1090         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
     1091         p-type-price   = (if v-use-type-price  then no                      else ?)
     1092         p-type-val     = (if v-use-List_       then no                      else ?)
     1093         .
     1094       end.
     1095     end.
     1096   end procedure.
     1097   procedure uf-set :
     1098     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     1099     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     1100     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     1101     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     1102     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     1103     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     1104     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     1105     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     1106     do
     1107     on error undo, return error
     1108     :
     1109       define buffer buf_usr-flt for ubflt.usr-flt .
     1110       define variable v-use-List_     as logical   no-undo .
     1111       define variable v-type-List_     as character no-undo .
     1112       define variable v-format-List_   as character no-undo .
     1113       define variable v-use-Naim      as logical   no-undo .
     1114       define variable v-type-Naim      as character no-undo .
     1115       define variable v-format-Naim    as character no-undo .
     1116       define variable v-use-print-graft as logical   no-undo .
     1117       define variable v-use-sort-gr   as logical   no-undo .
     1118       define variable v-use-type-price as logical   no-undo .
     1119       define variable v-use-type-val  as logical   no-undo .
     1120       define variable v-tooltip        as character no-undo .
     1121       define variable v-label          as character no-undo .
     1122       define variable v-user-can-edit  as logical   no-undo .
     1123       define variable v-output-display as logical   no-undo .
     1124       define variable v-other          as character no-undo .
     1125       run uf-name in this-procedure
     1126         (input  entry(1, p-code, chr(4))
     1127         ,output v-use-List_
     1128         ,output v-type-List_
     1129         ,output v-format-List_
     1130         ,output v-use-Naim
     1131         ,output v-type-Naim
     1132         ,output v-format-Naim
     1133         ,output v-use-print-graft
     1134         ,output v-use-sort-gr
     1135         ,output v-use-type-price
     1136         ,output v-use-type-val
     1137         ,output v-label
     1138         ,output v-tooltip
     1139         ,output v-user-can-edit
     1140         ,output v-output-display
     1141         ,output v-other
     1142         ) no-error .
     1143       if error-status :error then do:
     1144         undo, return error return-value .
     1145       end.
     1146       find first buf_usr-flt where
     1147                  buf_usr-flt.Call-point     = p-code AND
     1148                  buf_usr-flt.user-name       = p-user-name
     1149         no-error .
     1150       if not avail buf_usr-flt then do:
     1151           create buf_usr-flt .
     1152           assign
     1153           buf_usr-flt.call-point = p-code
     1154           buf_usr-flt.user-name  = p-user-name
     1155           .
     1156       end.
     1157       if avail buf_usr-flt then do:
     1158        assign
     1159        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
     1160        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
     1161        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
     1162        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
     1163        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
     1164        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
     1165       .
     1166       release buf_usr-flt.
     1167       end.
     1168       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
     1169     end.
     1170   end procedure.
     1171   CREATE WIDGET-POOL.
     1172   def var vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1173   procedure gen-key-rec :
     1174     define input  parameter p-tbl-name    as character no-undo.
     1175     define input  parameter p-bh_tbl-name as handle    no-undo.
     1176     define output parameter p-key-rec     as character no-undo.
     1177     do
     1178     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1179     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     1180     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     1181     :
     1182       define variable fh               as handle    no-undo .
     1183       define variable v-ok             as logical   no-undo .
     1184       define variable v-inform         as character no-undo .
     1185       define variable v-ind            as integer   no-undo .
     1186       define variable v-idx-field-qnty as integer   no-undo .
     1187       if p-tbl-name = ?
     1188         or p-tbl-name = "":U
     1189       then do:
     1190         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info15 ).
     1191       end.
     1192       if not p-bh_tbl-name:available then do:
     1193         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info15, p-tbl-name ).
     1194       end.
     1195       assign
     1196         p-key-rec = p-tbl-name
     1197         v-inform  = p-bh_tbl-name:index-information(1)
     1198         v-ind     = 2
     1199       .
     1200       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1201       on error undo, return error
     1202       :
     1203         assign
     1204           v-inform = p-bh_tbl-name:index-information( v-ind )
     1205           v-ind    = v-ind + 1
     1206         .
     1207       end.
     1208       if v-inform = ?
     1209         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1210         or entry( 3, v-inform, ",":U ) <> "1":U
     1211       then do:
     1212         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info15, p-tbl-name ).
     1213       end.
     1214       else do:
     1215         assign
     1216           v-idx-field-qnty = num-entries( v-inform ) - 4
     1217         .
     1218         if v-idx-field-qnty < 2 then do:
     1219           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info15, v-inform, p-tbl-name ).
     1220         end.
     1221         do v-ind = 1 to v-idx-field-qnty by 2
     1222         on error undo, return error
     1223         :
     1224           assign
     1225             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     1226             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     1227           .
     1228         end.
     1229       end.
     1230       if p-key-rec = ? then do:
     1231         assign
     1232           p-key-rec = "":U
     1233         .
     1234         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info15, p-tbl-name ).
     1235       end.
     1236     end.
     1237     return.
     1238   end procedure.
     1239   procedure gen-where-keyr-tab :
     1240     define input  parameter i-tableSerach as character no-undo.
     1241     define input  parameter i-tablekey   as character  no-undo.
     1242     define input  parameter p-key-rec    as character  no-undo.
     1243     define input  parameter p-key-handle as handle     no-undo .
     1244     define input  parameter p-db-name    as character  no-undo .
     1245     define input  parameter p-tt-handle  as handle     no-undo .
     1246     define output parameter o-Where      as character  no-undo.
     1247     do
     1248     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1249     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1250     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     1251     :
     1252       define variable v-full-tbl-name  as character no-undo .
     1253       define variable bh_tbl-name      as handle    no-undo .
     1254       define variable fh_key           as handle    no-undo .
     1255       define variable fh_search        as handle    no-undo .
     1256       define variable v-field-num      as integer   no-undo .
     1257       define variable v-count-fld      as integer   no-undo .
     1258       define variable v-inform         as character no-undo .
     1259       define variable v-ind            as integer   no-undo .
     1260       define variable v-idx-field-qnty as integer   no-undo .
     1261       define variable v-field-name     as character no-undo .
     1262       define variable v-field-val      as character no-undo .
     1263       define variable v-word-link      as character no-undo .
     1264       define variable vTable           as character no-undo.
     1265       define variable bh_tbl-key       as handle    no-undo .
     1266       assign
     1267         p-key-rec = trim( p-key-rec )
     1268       .
     1269       if p-key-handle <> ? then do:
     1270         if not valid-handle(p-key-handle)
     1271            or p-key-handle:type <> "buffer"
     1272         then do:
     1273           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info15 ).
     1274         end.
     1275         if num-entries( p-key-rec, chr(3) ) > 1
     1276           or p-key-rec = ?
     1277           or p-key-rec = "":U
     1278         then do:
     1279           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info15, p-key-rec ).
     1280         end.
     1281       end.
     1282       else do:
     1283         if p-key-rec = ?
     1284           or p-key-rec = "":U
     1285         then do:
     1286           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info15 ).
     1287         end.
     1288       end.
     1289       assign
     1290         vTable = entry( 1 , p-key-rec, chr(3) )
     1291       .
     1292       if p-tt-handle <> ?
     1293         and ( not valid-handle(p-tt-handle)
     1294               or p-tt-handle:type <> "buffer"
     1295             )
     1296       then do:
     1297         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info15, vTable, chr(10) ).
     1298       end.
     1299       if p-tt-handle = ? then do:
     1300         assign
     1301           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     1302         .
     1303         create buffer bh_tbl-name for table v-full-tbl-name .
     1304       end.
     1305       else do:
     1306         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1307       end.
     1308       assign
     1309         v-inform = bh_tbl-name:index-information(1)
     1310         v-ind    = 2
     1311       .
     1312       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1313       on error undo, return error
     1314       :
     1315         assign
     1316           v-inform = bh_tbl-name:index-information( v-ind )
     1317           v-ind    = v-ind + 1
     1318         .
     1319       end.
     1320       if v-inform = ?
     1321         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1322         or entry( 3, v-inform, ",":U ) <> "1":U
     1323       then do:
     1324         delete object bh_tbl-name no-error.
     1325         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info15, vTable ).
     1326       end.
     1327       assign
     1328         v-idx-field-qnty = num-entries( v-inform ) - 4
     1329       .
     1330       if v-idx-field-qnty < 2 then do:
     1331         delete object bh_tbl-name no-error.
     1332         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info15, v-inform, vTable ).
     1333       end.
     1334       assign
     1335         o-where     = "where":U
     1336         v-word-link = "":U
     1337         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     1338         v-count-fld = 0
     1339       .
     1340       if i-tablekey ne "" and i-tablekey ne ?
     1341       then do:
     1342         assign
     1343           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     1344         .
     1345         create buffer bh_tbl-key for table v-full-tbl-name .
     1346       end.
     1347       if i-tableSerach ne "" and i-tableSerach ne ?
     1348       then do:
     1349         delete object bh_tbl-name no-error.
     1350         assign
     1351           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     1352         .
     1353         create buffer bh_tbl-name for table v-full-tbl-name .
     1354       end.
     1355       block_where:
     1356       do v-ind = 1 to v-idx-field-qnty by 2
     1357       on error undo, return error
     1358       :
     1359         assign
     1360           v-count-fld = v-count-fld + 1
     1361         .
     1362         if p-key-handle = ?
     1363           and v-count-fld > v-field-num
     1364         then do:
     1365           leave block_where.
     1366         end.
     1367         define variable VfieldKeyTable as handle no-undo.
     1368         assign
     1369           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1370           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     1371         .
     1372         if     bh_tbl-key ne ?
     1373         then do:
     1374            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     1375            if VfieldKeyTable eq ?
     1376            then next block_where.
     1377         end.
     1378         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     1379         then
     1380            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     1381         else
     1382            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     1383         if p-key-handle = ? then do:
     1384           assign
     1385             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     1386           .
     1387         end.
     1388         else do:
     1389           assign
     1390             fh_key = p-key-handle:buffer-field( v-field-name )
     1391           .
     1392           if fh_key = ?
     1393             or not valid-handle( fh_key )
     1394           then do:
     1395             delete object bh_tbl-name.
     1396             if     bh_tbl-key ne ?
     1397             then
     1398                delete object bh_tbl-key.
     1399             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info15, p-key-handle:name, v-field-name ).
     1400           end.
     1401           assign
     1402             v-field-val = fh_key:buffer-value
     1403           .
     1404         end.
     1405         if fh_search:data-type ="character":U then do:
     1406           assign
     1407             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     1408             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     1409             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     1410             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     1411             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     1412             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     1413             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     1414             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     1415             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     1416             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     1417             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     1418             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     1419             v-field-val = substitute( '"&1"', v-field-val )
     1420           .
     1421         end.
     1422         assign
     1423           o-where = substitute( "&1 &2", o-where, v-field-val )
     1424         .
     1425         if v-word-link = "":U then do:
     1426           assign
     1427             v-word-link = "and":U
     1428           .
     1429         end.
     1430       end.
     1431       delete object bh_tbl-name.
     1432       if     bh_tbl-key ne ?
     1433       then
     1434          delete object bh_tbl-key.
     1435       if p-key-handle = ?
     1436         and v-count-fld <> v-field-num
     1437       then do:
     1438         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info15, vTable ).
     1439       end.
     1440     end.
     1441   end procedure.
     1442   procedure gen-hn-keyr-tab :
     1443     define input  parameter i-tableSerach as character no-undo.
     1444     define input  parameter i-tablekey   as character no-undo.
     1445     define input  parameter p-key-rec    as character no-undo.
     1446     define input  parameter p-key-handle as handle    no-undo .
     1447     define input  parameter p-db-name    as character no-undo .
     1448     define input  parameter p-tt-handle  as handle    no-undo .
     1449     define input  parameter p-stts-lock  as integer   no-undo .
     1450     define output parameter o-hn         as handle    no-undo.
     1451     define variable v-full-tbl-name as character no-undo.
     1452     define variable v-where         as character no-undo.
     1453     define variable bh_tbl-name     as handle    no-undo.
     1454     define variable vTable          as character no-undo.
     1455     do
     1456     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1457     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1458     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     1459         run gen-where-keyr-tab(i-tableSerach,
     1460                                i-tablekey,
     1461                                p-key-rec,
     1462                                p-key-handle,
     1463                                p-db-name,
     1464                                p-tt-handle,
     1465                                output v-where).
     1466         if i-tableSerach ne "" and i-tableSerach ne ?
     1467         then do:
     1468            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     1469            create buffer bh_tbl-name for table v-full-tbl-name .
     1470         end.
     1471         else do:
     1472            if p-tt-handle = ? then do:
     1473               assign
     1474                  vTable = entry( 1 , p-key-rec, chr(3) )
     1475               .
     1476               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     1477               create buffer bh_tbl-name for table v-full-tbl-name .
     1478            end.
     1479            else do:
     1480               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1481            end.
     1482         end.
     1483         if p-tt-handle = ? then do:
     1484            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     1485         end.
     1486         else do:
     1487            bh_tbl-name:find-first( v-where ) no-error .
     1488         end.
     1489         o-hn = bh_tbl-name.
     1490      end.
     1491   end procedure.
     1492   procedure gen-hn-keyr :
     1493     define input  parameter p-key-rec    as character no-undo.
     1494     define input  parameter p-key-handle as handle    no-undo .
     1495     define input  parameter p-db-name    as character no-undo .
     1496     define input  parameter p-tt-handle  as handle    no-undo .
     1497     define input  parameter p-stts-lock  as integer   no-undo .
     1498     define output parameter o-hn         as handle    no-undo.
     1499     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     1500   end.
     1501   procedure gen-row-keyr :
     1502     define input  parameter p-key-rec    as character no-undo.
     1503     define input  parameter p-key-handle as handle    no-undo .
     1504     define input  parameter p-db-name    as character no-undo .
     1505     define input  parameter p-tt-handle  as handle    no-undo .
     1506     define input  parameter p-stts-lock  as integer   no-undo .
     1507     define output parameter p-tbl-row    as rowid     no-undo.
     1508     define output parameter p-tbl-name   as character no-undo.
     1509     define variable vHn as handle no-undo.
     1510       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     1511       p-tbl-row = if vHn:available then vHn:rowid else ?.
     1512       p-tbl-name =  vHn:table.
     1513       delete object vHn no-error.
     1514     if p-tbl-row = ? then do:
     1515       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info15, p-tbl-name, p-key-rec ).
     1516     end.
     1517     else do:
     1518       return.
     1519     end.
     1520   end procedure.
     1521   procedure gen-key-fv :
     1522     define input  parameter p-key-rec    as character no-undo .
     1523     define output parameter p-field-list as character no-undo .
     1524     define output parameter p-value-list as character no-undo.
     1525     do
     1526     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1527     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1528     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1529     :
     1530       define variable v-full-tbl-name  as character no-undo .
     1531       define variable bh_tbl-name      as handle    no-undo .
     1532       define variable v-tbl-name       as character no-undo .
     1533       define variable v-field-num      as integer   no-undo .
     1534       define variable v-count-fld      as integer   no-undo .
     1535       define variable v-inform         as character no-undo .
     1536       define variable v-ind            as integer   no-undo .
     1537       define variable v-idx-field-qnty as integer   no-undo .
     1538       define variable v-delim-key      as character no-undo .
     1539       if p-key-rec = ?
     1540         or p-key-rec = "":U
     1541       then do:
     1542         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info15 ).
     1543       end.
     1544       assign
     1545         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1546         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1547       .
     1548       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1549       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info15 ).
     1550       assign
     1551         v-inform = bh_tbl-name:index-information(1)
     1552         v-ind    = 2
     1553       .
     1554       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1555       on error undo, return error
     1556       :
     1557         assign
     1558           v-inform = bh_tbl-name:index-information( v-ind )
     1559           v-ind    = v-ind + 1
     1560         .
     1561       end.
     1562       if v-inform = ?
     1563         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1564         or entry( 3, v-inform, ",":U ) <> "1":U
     1565       then do:
     1566         delete object bh_tbl-name no-error.
     1567         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info15, v-tbl-name ).
     1568       end.
     1569       assign
     1570         v-idx-field-qnty = num-entries( v-inform ) - 4
     1571       .
     1572       if v-idx-field-qnty < 2 then do:
     1573         delete object bh_tbl-name no-error.
     1574         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info15, v-inform, v-tbl-name ).
     1575       end.
     1576       assign
     1577         p-field-list = "":U
     1578         p-value-list = "":U
     1579         v-delim-key  = "":U
     1580         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     1581         v-count-fld  = 0
     1582       .
     1583       block_where:
     1584       do v-ind = 1 to v-idx-field-qnty by 2
     1585       on error undo, return error
     1586       :
     1587         assign
     1588           v-count-fld = v-count-fld + 1
     1589         .
     1590         if v-count-fld > v-field-num then do:
     1591           leave block_where.
     1592         end.
     1593         assign
     1594           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1595           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1596         .
     1597         if v-ind = 1 then do:
     1598           assign
     1599             v-delim-key = chr(3)
     1600           .
     1601         end.
     1602       end.
     1603       delete object bh_tbl-name.
     1604       if v-count-fld <> v-field-num then do:
     1605         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info15, v-tbl-name ).
     1606       end.
     1607     end.
     1608   end procedure.
     1609   procedure gen-key-field :
     1610     define input  parameter p-table      as character no-undo .
     1611     define output parameter p-field-list as character no-undo .
     1612     do
     1613     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1614     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1615     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1616     :
     1617       define variable v-full-tbl-name  as character no-undo .
     1618       define variable bh_tbl-name      as handle    no-undo .
     1619       define variable v-tbl-name       as character no-undo .
     1620       define variable v-field-num      as integer   no-undo .
     1621       define variable v-count-fld      as integer   no-undo .
     1622       define variable v-inform         as character no-undo .
     1623       define variable v-ind            as integer   no-undo .
     1624       define variable v-idx-field-qnty as integer   no-undo .
     1625       define variable v-delim-key      as character no-undo .
     1626       if p-table = ?
     1627         or p-table = "":U
     1628       then do:
     1629         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info15 ).
     1630       end.
     1631       assign
     1632         v-tbl-name      = p-table
     1633         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1634       .
     1635       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1636       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info15 ).
     1637       assign
     1638         v-inform = bh_tbl-name:index-information(1)
     1639         v-ind    = 2
     1640       .
     1641       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1642       on error undo, return error
     1643       :
     1644         assign
     1645           v-inform = bh_tbl-name:index-information( v-ind )
     1646           v-ind    = v-ind + 1
     1647         .
     1648       end.
     1649       if v-inform = ?
     1650         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1651         or entry( 3, v-inform, ",":U ) <> "1":U
     1652       then do:
     1653         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info15, v-tbl-name ).
     1654       end.
     1655       assign
     1656         v-idx-field-qnty = num-entries( v-inform ) - 4
     1657       .
     1658       if v-idx-field-qnty < 2 then do:
     1659         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info15, v-inform, v-tbl-name ).
     1660       end.
     1661       assign
     1662         p-field-list = "":U
     1663         v-delim-key  = "":U
     1664         v-count-fld  = 0
     1665       .
     1666       block_where:
     1667       do v-ind = 1 to v-idx-field-qnty by 2
     1668       on error undo, return error
     1669       :
     1670         assign
     1671           v-count-fld = v-count-fld + 1
     1672         .
     1673         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1674         if v-ind = 1 then do:
     1675           assign
     1676             v-delim-key = chr(3)
     1677           .
     1678         end.
     1679       end.
     1680       delete object bh_tbl-name.
     1681     end.
     1682   end procedure.
     1683   define variable v-nn as integer   no-undo .
     1684   define variable State-source as  WIDGET-HANDLE.
     1685   define variable g#log as logical   no-undo .
     1686   define variable v-curr-r-b               as character no-undo .
     1687   define variable v-print-rubl             as logical   no-undo .
     1688   define variable p-customer as integer no-undo .
     1689   define variable v-res as character no-undo .
     1690   define variable v-profile-id as integer no-undo .
     1691   define variable v-output-type as character no-undo .
     1692   define variable ii as integer no-undo .
     1693   DEFINE VARIABLE v-printform AS integer NO-UNDO.
     1694   DEFINE VARIABLE print-form AS INTEGER
     1695        VIEW-AS RADIO-SET VERTICAL
     1696        RADIO-BUTTONS
     1697             "Вкладной лист кассовой книги", 1,
     1698   "Отчет кассира", 2
     1699        SIZE 34 BY 3 NO-UNDO.
     1700   DEFINE RECTANGLE RECT-13
     1701        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1702        SIZE 42 BY 5.
     1703   DEFINE VARIABLE t-excel AS LOGICAL INITIAL no
     1704        LABEL "Excel"
     1705        VIEW-AS TOGGLE-BOX
     1706        SIZE 13 BY 1 NO-UNDO.
     1707   DEFINE VARIABLE t-TEXT AS LOGICAL INITIAL no
     1708        LABEL "TEXT"
     1709        VIEW-AS TOGGLE-BOX
     1710        SIZE 13 BY 1 NO-UNDO.
     1711   DEFINE FRAME F-Main
     1712        print-form AT ROW 2.27 COL 5.5 NO-LABEL WIDGET-ID 14
     1713        t-excel AT ROW 6.33 COL 3.5 WIDGET-ID 24
     1714        t-TEXT AT ROW 6.33 COL 24 WIDGET-ID 22
     1715        RECT-13 AT ROW 1.27 COL 2 WIDGET-ID 18
     1716       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
     1717            SIDE-LABELS NO-UNDERLINE THREE-D
     1718            AT COL 1 ROW 1 SCROLLABLE .
     1719   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     1720   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     1721   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     1722   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     1723   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     1724   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     1725   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     1726   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     1727         adm-object-hdl = FRAME F-Main:HANDLE.
     1728   RUN ensure-broker.
     1729   THIS-PROCEDURE:ADM-DATA =
     1730        'ADM1.1~`':U +
     1731        'SmartObject~`':U +
     1732        '~`':U +
     1733        'NO ~`':U +
     1734        '~`':U +
     1735        '~`':U +
     1736        '~`':U +
     1737        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     1738           + "~`":U +
     1739        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
     1740        'Record-Source,Record-Target,TableIO-Target~`':U +
     1741        '~`':U +
     1742        '~`~`~`~`~`~`~`~`~`~`~`':U +
     1743        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1744            THEN "^^":U
     1745        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1746             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1747   PROCEDURE adm-apply-entry :
     1748     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1749   END PROCEDURE.
     1750   PROCEDURE adm-destroy :
     1751    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1752   END PROCEDURE.
     1753   PROCEDURE adm-disable :
     1754       DISABLE RECT-13 print-form t-excel t-TEXT WITH FRAME F-Main.
     1755       RUN dispatch ('disable-fields':U).
     1756       RUN set-attribute-list ('ENABLED=no':U).
     1757       RETURN.
     1758   END PROCEDURE.
     1759   PROCEDURE adm-edit-attribute-list :
     1760         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
     1761         RETURN.
     1762   END PROCEDURE.
     1763   PROCEDURE adm-enable :
     1764       ENABLE UNLESS-HIDDEN RECT-13 print-form t-excel t-TEXT WITH FRAME F-Main.
     1765       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     1766       RUN set-attribute-list ('ENABLED=yes':U).
     1767       RETURN.
     1768   END PROCEDURE.
     1769   PROCEDURE adm-exit :
     1770        RUN notify ('exit':U).
     1771     RETURN.
     1772   END PROCEDURE.
     1773   PROCEDURE adm-hide :
     1774     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1775   END PROCEDURE.
     1776   PROCEDURE adm-initialize :
     1777     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1778   END PROCEDURE.
     1779   PROCEDURE adm-show-errors :
     1780       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1781       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1782           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1783       END.
     1784       RETURN.
     1785   END PROCEDURE.
     1786   PROCEDURE adm-UIB-mode :
     1787     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1788   END PROCEDURE.
     1789   PROCEDURE adm-view :
     1790     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1791   END PROCEDURE.
     1792   PROCEDURE dispatch :
     1793       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1794       RUN broker-dispatch IN adm-broker-hdl
     1795           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1796       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1797   END PROCEDURE.
     1798   PROCEDURE ensure-broker :
     1799   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1800   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1801   DO:
     1802       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1803       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1804   END.
     1805   END PROCEDURE.
     1806   PROCEDURE get-attribute :
     1807     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1808     RUN broker-get-attribute IN adm-broker-hdl
     1809         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1810     RETURN RETURN-VALUE.
     1811   END PROCEDURE.
     1812   PROCEDURE get-attribute-list :
     1813     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1814     RUN broker-get-attribute-list IN adm-broker-hdl
     1815         (INPUT THIS-PROCEDURE,
     1816          INPUT ?,
     1817          OUTPUT p-attr-list) NO-ERROR.
     1818     RETURN.
     1819   END PROCEDURE.
     1820   PROCEDURE new-state :
     1821     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1822     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1823     RETURN.
     1824   END PROCEDURE.
     1825   PROCEDURE notify :
     1826     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1827     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1828     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1829         RETURN "ADM-ERROR":U.
     1830     RETURN.
     1831   END PROCEDURE.
     1832   PROCEDURE set-attribute-list :
     1833     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1834     RUN ensure-broker.
     1835     RUN broker-set-attribute-list IN adm-broker-hdl
     1836         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1837     RETURN.
     1838   END PROCEDURE.
     1839   PROCEDURE set-position :
     1840       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1841       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1842       IF VALID-HANDLE(adm-object-hdl) THEN
     1843       DO:
     1844         ASSIGN adm-object-hdl:ROW    =   p-row
     1845                adm-object-hdl:COLUMN =   p-col.
     1846       END.
     1847       RETURN.
     1848   END PROCEDURE.
     1849   PROCEDURE adm-display-fields :
     1850       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
     1851       RETURN.
     1852   END PROCEDURE.
     1853   PROCEDURE adm-open-query :
     1854     RETURN.
     1855   END PROCEDURE.
     1856   PROCEDURE adm-row-changed :
     1857         IF VALID-HANDLE(adm-object-hdl) THEN
     1858           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1859         RUN notify ('row-available':U).
     1860         RETURN.
     1861   END PROCEDURE.
     1862   PROCEDURE reposition-query :
     1863       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
     1864       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
     1865       RETURN.
     1866   END PROCEDURE.
     1867     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
     1868     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
     1869     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
     1870     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
     1871     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
     1872     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
     1873     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
     1874     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
     1875     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1876     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
     1877     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1878     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
     1879     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
     1880     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
     1881     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
     1882     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
     1883     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
     1884     IF "":U = "":U THEN
     1885       RUN modify-list-attribute IN adm-broker-hdl
     1886         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
     1887     RUN use-create-on-add(?).
     1888   PROCEDURE adm-add-record :
     1889       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1890          "must have at least one Enabled Table to perform Add.":U
     1891          VIEW-AS ALERT-BOX ERROR.
     1892       RETURN.
     1893   END PROCEDURE.
     1894   PROCEDURE adm-assign-record :
