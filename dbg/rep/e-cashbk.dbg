     1937   PROCEDURE adm-reset-record :
     1938       RETURN.
     1939   END PROCEDURE.
     1940   PROCEDURE adm-update-record :
     1941       MESSAGE
     1942         "Object ":U THIS-PROCEDURE:FILE-NAME
     1943           "must have at least one Enabled Table to perform Update.":U
     1944             VIEW-AS ALERT-BOX ERROR.
     1945      RETURN.
     1946   END PROCEDURE.
     1947   PROCEDURE check-modified :
     1948   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1949   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1950   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1951   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1952     IF check-state = "check":U THEN
     1953     DO:
     1954       RUN get-link-handle IN adm-broker-hdl
     1955         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1956            OUTPUT group-target-list).
     1957       IF group-target-list NE "":U THEN
     1958       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1959         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1960         RUN check-modified IN curr-widget ('group-check':U).
     1961         IF RETURN-VALUE NE "":U THEN
     1962         DO:
     1963           RUN check-modified-message(RETURN-VALUE).
     1964           RETURN "":U.
     1965         END.
     1966       END.
     1967     END.
     1968     RETURN "":U.
     1969   END PROCEDURE.
     1970   PROCEDURE check-modified-message :
     1971     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1972        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1973           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1974        IF RETURN-VALUE = "YES":U THEN
     1975           RUN notify ('view,CONTAINER-SOURCE':U).
     1976        MESSAGE IF p-changed-table NE ? THEN
     1977           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1978           ELSE "Current values have been changed."
     1979           SKIP "  Do you wish to save those changes?"
     1980           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1981        IF ANS THEN
     1982        DO:
     1983           IF group-assign-target THEN
     1984             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1985           ELSE RUN dispatch('update-record':U).
     1986           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1987           DO:
     1988               MESSAGE "Changes to the previous record were not saved."
     1989                 VIEW-AS ALERT-BOX ERROR.
     1990               IF group-assign-target THEN
     1991                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1992               ELSE RUN dispatch ('cancel-record':U).
     1993           END.
     1994        END.
     1995        ELSE DO:
     1996          IF group-assign-target THEN
     1997             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1998          ELSE RUN dispatch('cancel-record':U).
     1999        END.
     2000        RETURN.
     2001   END PROCEDURE.
     2002   PROCEDURE get-rowid :
     2003       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     2004       ASSIGN
     2005       p-table   =   adm-first-table.
     2006       RETURN.
     2007   END PROCEDURE.
     2008   PROCEDURE init-group-assign :
     2009       RUN request-attribute IN adm-broker-hdl
     2010         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     2011       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     2012         group-assign-target = yes.
     2013       ELSE group-assign-target = no.
     2014       RETURN.
     2015   END PROCEDURE.
     2016   PROCEDURE set-editors :
     2017       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     2018       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     2019       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     2020       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     2021       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     2022       DO WHILE VALID-HANDLE (curr-widget):
     2023           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     2024              curr-widget:HIDDEN = no THEN DO:
     2025             CASE p-field-setting:
     2026               WHEN "INITIALIZE":U THEN
     2027               DO:
     2028                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     2029                     read-only-list +
     2030                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     2031                        STRING(curr-widget).
     2032               END.
     2033               WHEN "DISABLE":U OR
     2034               WHEN "ENABLE":U THEN
     2035               DO:
     2036                   curr-widget:SENSITIVE = yes.
     2037                   RUN get-attribute ('Read-Only-Editors':U).
     2038                   IF RETURN-VALUE = ? OR
     2039                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     2040                       curr-widget:READ-ONLY =
     2041                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     2042               END.
     2043               WHEN "CLEAR":U THEN
     2044                   curr-widget:SCREEN-VALUE = "":U.
     2045             END CASE.
     2046           END.
     2047           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     2048       END.
     2049       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     2050         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     2051           + '"':U).
     2052       RETURN.
     2053   END PROCEDURE.
     2054   PROCEDURE use-check-modified-all :
     2055    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     2056     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     2057     RETURN.
     2058   END PROCEDURE.
     2059   PROCEDURE use-create-on-add :
     2060   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     2061      RETURN.
     2062   END PROCEDURE.
     2063   PROCEDURE use-initial-lock :
     2064     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     2065     ASSIGN adm-initial-lock = p-attr-value.
     2066     RETURN.
     2067   END PROCEDURE.
     2068     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     2069   ASSIGN
     2070          FRAME F-Main:SCROLLABLE       = FALSE
     2071          FRAME F-Main:HIDDEN           = TRUE.
     2072   ON VALUE-CHANGED OF print-form IN FRAME F-Main
     2073   DO:
     2074     assign print-form.
     2075     if not (place-call = 'schedule':U
     2076             or
     2077             place-call = 'rp-by-call':U
     2078             ) then do:
     2079     find first ubflt.usr-flt share-lock
     2080      where ubflt.usr-flt.user-name  = v-cntxt-userid
     2081        and ubflt.usr-flt.call-point = "e-cash-bk":U
     2082        no-error .
     2083        if available ubflt.usr-flt then do:
     2084           assign
     2085              ubflt.usr-flt.naim  = string(print-form)
     2086           .
     2087        End.
     2088        else do:
     2089           assign frame F-Main print-form.
     2090           create ubflt.usr-flt.
     2091           assign
     2092             ubflt.usr-flt.user-name = v-cntxt-userid
     2093             ubflt.usr-flt.call-point = "e-cash-bk":U
     2094             ubflt.usr-flt.naim  = string(print-form)
     2095           .
     2096        end.
     2097       end.
     2098   assign
     2099     v-printform = print-form
     2100   .
     2101   END.
     2102   if not this-procedure :persistent
     2103   then do:
     2104     message
     2105       vss-workfile vss-revision vss-description skip
     2106       "Ошибка при запуске процедуры" skip
     2107       "Данную процедуру следует запускать только с параметром persistent" skip
     2108       view-as alert-box error .
     2109     undo, return error .
     2110   end.
     2111   PROCEDURE disable_UI :
     2112     HIDE FRAME F-Main.
     2113     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     2114   END PROCEDURE.
     2115   PROCEDURE local-initialize :
     2116     RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     2117   CASE place-call:
     2118     WHEN 'schedule':U
     2119     or when 'rp-by-call':U
     2120     THEN DO:
     2121       RUN rcps_get-profile-id IN parent-handle ( OUTPUT v-profile-id).
     2122       CASE v-profile-id:
     2123         WHEN 71 THEN DO:
     2124           print-form = 2.
     2125           display
     2126           print-form
     2127           with frame F-Main .
     2128           disable
     2129           print-form
     2130           with frame F-Main .
     2131           enable
     2132           t-excel
     2133           t-text
     2134           with frame F-Main .
     2135         end.
     2136       end case.
     2137     end.
     2138     otherwise do:
     2139       disable
     2140       t-excel
     2141       t-text
     2142       with frame F-Main .
     2143       hide
     2144       t-excel
     2145       t-text
     2146       in frame F-Main .
     2147     find first ubflt.usr-flt share-lock
     2148      where ubflt.usr-flt.user-name  = v-cntxt-userid
     2149        and ubflt.usr-flt.call-point = "e-cash-bk":U
     2150      no-error .
     2151        if available ubflt.usr-flt then do:
     2152            assign print-form = integer(ubflt.usr-flt.naim) .
     2153        end.
     2154        else do:
     2155            assign frame F-Main print-form.
     2156            create ubflt.usr-flt.
     2157            assign
     2158              ubflt.usr-flt.user-name = v-cntxt-userid
     2159              ubflt.usr-flt.call-point = "e-cash-bk":U
     2160              ubflt.usr-flt.naim  = string(print-form)
     2161            .
     2162        end.
     2163       display
     2164       print-form
     2165       with frame F-Main .
     2166   assign
     2167     v-printform = print-form
     2168   .
     2169     end.
     2170   end case.
     2171   END PROCEDURE.
     2172   PROCEDURE my-params :
     2173   define input parameter p-action as character no-undo .
     2174   define variable v-index-id as integer no-undo .
     2175   define variable v-value-character as character no-undo .
     2176   define variable v-value-date as date no-undo .
     2177   define variable v-value-decimal as decimal no-undo .
     2178   define variable v-value-integer as integer no-undo .
     2179   define variable v-value-logical as logical no-undo .
     2180   CASE p-action :
     2181     WHEN 'get' THEN DO:
     2182       IF v-profile-id = 71  THEN DO:
     2183          v-index-id = 0.
     2184          RUN rcps_get-value IN parent-handle (
     2185                                             input "p-output-type"
     2186                                            ,INPUT-output v-index-id
     2187                                            ,output v-output-type
     2188                                            ,output v-value-date
     2189                                            ,output v-value-decimal
     2190                                            ,output v-value-integer
     2191                                            ,output v-value-logical
     2192                                            ) no-error .
     2193          assign
     2194          t-excel:screen-value in frame F-Main =  string(lookup('excel':U, v-output-type) > 0)
     2195          t-text:screen-value in frame F-Main = string(lookup('text':U, v-output-type) > 0)
     2196          .
     2197       END.
     2198       RUN local-initialize IN THIS-PROCEDURE.
     2199     END.
     2200     WHEN 'set' THEN DO:
     2201       IF v-profile-id = 71 THEN DO:
     2202         ASSIGN
     2203         FRAME F-Main
     2204         t-text
     2205         t-excel
     2206         v-output-type = ","
     2207         ENTRY(1, v-output-type) = (IF t-excel THEN 'excel':U ELSE '')
     2208         ENTRY(2, v-output-type) = (IF t-text THEN 'text':U ELSE '')
     2209         v-output-type = TRIM(v-output-type, chr(44))
     2210         .
     2211         if not t-excel
     2212         and not t-text then do:
     2213           define variable glog as logical no-undo .
     2214           message
     2215           "Внимание!! Вы не выбрали ни вывод в текстовый файл, ни вывод в Excel!" skip
     2216           "Продолжить?"
     2217           view-as alert-box question buttons yes-no update glog.
     2218           if not glog then return error.
     2219         end.
     2220         RUN rcps_set-value IN parent-handle (
     2221                                           input "p-output-type"
     2222                                         ,INPUT 0
     2223                                         ,input v-output-type
     2224                                         ,input ?
     2225                                         ,input 0.0
     2226                                         ,input 0
     2227                                         ,input no
     2228                                         ) no-error .
     2229       END.
     2230     END.
     2231   END CASE.
     2232   END PROCEDURE.
     2233   PROCEDURE my-report :
     2234   run rep/r-cashbk.p
     2235       (
     2236        input my-handle
     2237       ,input this-procedure:handle
     2238       ,input this-procedure:handle
     2239       ,input this-procedure:handle
     2240       ,input this-procedure:handle
     2241       ,input ?
     2242       ,input ?
     2243       ,input ''
     2244       ,input integer('0':U)
     2245       ,input 0
     2246       ,input 0
     2247       ,input ""
     2248       ,input print-form
     2249       ,input yes
     2250       ,input yes
     2251       ,input ''
     2252         ) .
     2253   END PROCEDURE.
     2254   PROCEDURE my-var :
     2255   assign frame F-Main print-form
     2256   .
     2257     assign
     2258       ReportHeader = if v-printform = 1 then "Вкладной лист кассовой книги" else "Отчет кассира"
     2259     .
     2260   END PROCEDURE.
     2261   PROCEDURE write-to-log :
     2262   define input param p-str as char no-undo.
     2263   do
     2264   on error undo, return error
     2265   :
     2266      message
     2267         p-str
     2268         skip
     2269      view-as alert-box error.
     2270   end.
     2271   END PROCEDURE.
