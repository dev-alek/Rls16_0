     1896          "Object ":U THIS-PROCEDURE:FILE-NAME
     1897            "must have at least one Enabled Table to perform Assign.":U
     1898              VIEW-AS ALERT-BOX ERROR.
     1899      RETURN.
     1900     END PROCEDURE.
     1901   PROCEDURE adm-assign-statement :
     1902     RETURN.
     1903   END PROCEDURE.
     1904   PROCEDURE adm-cancel-record :
     1905      RETURN.
     1906     END PROCEDURE.
     1907   PROCEDURE adm-copy-record :
     1908       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1909        "must have at least one Enabled Table to perform Copy.":U
     1910          VIEW-AS ALERT-BOX ERROR.
     1911       RETURN.
     1912   END PROCEDURE.
     1913   PROCEDURE adm-create-record :
     1914      RETURN.
     1915   END PROCEDURE.
     1916   PROCEDURE adm-current-changed :
     1917     RETURN.
     1918   END PROCEDURE.
     1919   PROCEDURE adm-delete-record :
     1920    MESSAGE
     1921          "Object ":U THIS-PROCEDURE:FILE-NAME
     1922            "must have at least one Enabled Table to perform Delete.":U
     1923              VIEW-AS ALERT-BOX ERROR.
     1924       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
     1925       RETURN.
     1926   END PROCEDURE.
     1927   PROCEDURE adm-disable-fields :
     1928         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
