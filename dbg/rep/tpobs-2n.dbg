     3395         gds-zap-grp-name   = goods.grp-name
     3396         gds-zap-b-code     = goods.gds-code
     3397         gds-zap-prod-name  = clients.obj-name .
     3398     if g#gds-engl then
     3399         assign gds-zap-gds-name = goods.engl-name.
     3400     else
     3401         assign gds-zap-gds-name = goods.gds-name.
     3402   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     3403     (input  gds-zap-b-code
     3404     ,input  ?
     3405     ,output v-bar-code
     3406     )  .
     3407     s-bar-code = string (v-bar-code,"999999999").
     3408     run foreach in this-procedure .
     3409       if  first-of ( temp-gds-list.grp-name )  then do:
     3410           fr = true .
     3411           l-stroka = "ГРУППА : " + str .
     3412           temp-str = l-stroka.
     3413       end.
     3414      run display-line in this-procedure .
     3415      if last-of( temp-gds-list.grp-name ) then do:
     3416         s-bar-code = "Итого по " .
     3417         gds-zap-artic = substring(str,1,16) .
