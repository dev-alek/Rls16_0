     3668           input xtog-obj ,
     3669           output  fact-order-2 ).
     3670   end procedure.
     3671   procedure display-str1  :
     3672      if p-tpsy = no  or ( p-tpsy = true and  p-type-tpsy-goods = 2 ) then do:
     3673            run di-qnty ("кол-во", 1, s-bar-code,gds-zap-artic,gds-zap-gds-name,gds-zap-unit-base,"").
     3674            if xshowcost   then do: run di ( "учет." , 2,"","","","","" ). end.
     3675            if xshowcrsa   then do: run di ( "прод." , 5,"","","","","" ). end.
     3676            if xshowsale   then do: run di ( "док."  , 8,"","","","","" ). end.
     3677            if vat-cost    then do: run di ( "уч.НДС", 3,"","","","","" ). end.
     3678            if vat-crsa    then do: run di ( "пр.НДС", 6,"","","","","" ). end.
     3679            if vat-sale    then do: run di ( "дк.НДС", 9,"","","","","" ). end.
     3680      end.
     3681      if p-tpsy = true  then do:
     3682            if  p-type-tpsy-goods = 3 then
     3683                run di-qnty ("кол-во", 11, s-bar-code,gds-zap-artic,gds-zap-gds-name,gds-zap-unit-base,"").
     3684            else
     3685               run di-qnty ("кол-во", 11, "","",str_svoi,"","").
     3686            if xshowcost   then do: run di ( "учет." , 12,"","","","","" ). end.
     3687            if xshowcrsa   then do: run di ( "прод." , 15,"","","","","" ). end.
     3688            if xshowsale   then do: run di ( "док."  , 18,"","","","","" ). end.
     3689            if vat-cost    then do: run di ( "уч.НДС", 13,"","","","","" ). end.
     3690            if vat-crsa    then do: run di ( "пр.НДС", 16,"","","","","" ). end.
     3691            if vat-sale    then do: run di ( "дк.НДС", 19,"","","","","" ). end.
     3692      end.
