     4728    end procedure.
     4729   procedure ost-line-body :
     4730   do on error undo, return error return-value :
     4731   define input parameter p-num        as   integer   no-undo .
     4732   define input parameter p-store-type like ub.clients.obj-type no-undo .
     4733   define input parameter p-store-code like ub.clients.obj-code no-undo .
     4734    find last  ub.aht-stk-line where
     4735                           ub.aht-stk-line.gds-code   = gds-zap-b-code
     4736                     and   ub.aht-stk-line.fact-order <= fact-order-1
     4737                     and   ub.aht-stk-line.obj-code   = p-store-code
     4738                     and   ub.aht-stk-line.obj-type   = p-store-type
     4739                     and   ub.aht-stk-line.sum-type   = x-type-pr
     4740                           use-index category no-lock no-error.
     4741           if available ub.aht-stk-line then do:
     4742               if  tprintrubl  then
     4743                     assign
     4744                           ostatok-start[1 + p-num]  = ostatok-start[1 + p-num] +  (if ub.aht-stk-line.sum-type <> "b"
     4745                                                                   then round( ub.aht-stk-line.fact-qnty,3) else 0 )
     4746                           ostatok-start[2 + p-num]  =ostatok-start[2 + p-num] +  round( ub.aht-stk-line.cost-sum-rubl ,2)
     4747                           ostatok-start[3 + p-num]  =ostatok-start[3 + p-num] +  round( ub.aht-stk-line.cost-vat-rubl ,2)
     4748                           ostatok-start[4 + p-num]  =ostatok-start[4 + p-num] +  0
     4749                           ostatok-start[5 + p-num]  =ostatok-start[5 + p-num]  + round( ub.aht-stk-line.crsa-sum-rubl ,2)
     4750                           ostatok-start[6 + p-num]  =ostatok-start[6 + p-num]  + round( ub.aht-stk-line.crsa-vat-rubl ,2)
     4751                           ostatok-start[7 + p-num]  =ostatok-start[7 + p-num]  + round( ub.aht-stk-line.sale-discnt-rubl ,2)
     4752                           ostatok-start[8 + p-num]  =ostatok-start[8 + p-num]  + round( ub.aht-stk-line.crsa-sum-rubl ,2)
     4753                           ostatok-start[9 + p-num]  =ostatok-start[9 + p-num]  + round( ub.aht-stk-line.crsa-vat-rubl ,2)
     4754                           ostatok-start[10 + p-num] =ostatok-start[10 + p-num] + round( ub.aht-stk-line.crsa-slt-rubl ,2)
     4755                           .
     4756                 else
     4757                     assign
     4758                           ostatok-start[1 + p-num]  = ostatok-start[1 + p-num] + (if ub.aht-stk-line.sum-type <> "b"
     4759                                                                      then round( ub.aht-stk-line.fact-qnty,3) else 0 )
     4760                           ostatok-start[2 + p-num]  = ostatok-start[2 + p-num] +  round( ub.aht-stk-line.cost-sum-base ,2)
     4761                           ostatok-start[3 + p-num]  = ostatok-start[3 + p-num] +  round( ub.aht-stk-line.cost-vat-base ,2)
     4762                           ostatok-start[4 + p-num]  = ostatok-start[4 + p-num] +  0
     4763                           ostatok-start[5 + p-num]  = ostatok-start[5 + p-num]  + round( ub.aht-stk-line.crsa-sum-base ,2)
     4764                           ostatok-start[6 + p-num]  = ostatok-start[6 + p-num]  + round( ub.aht-stk-line.crsa-vat-base ,2)
     4765                           ostatok-start[7 + p-num]  = ostatok-start[7 + p-num]  + round( ub.aht-stk-line.sale-discnt-base ,2)
     4766                           ostatok-start[8 + p-num]  = ostatok-start[8 + p-num]  + round( ub.aht-stk-line.crsa-sum-base ,2)
     4767                           ostatok-start[9 + p-num]  = ostatok-start[9 + p-num]  + round( ub.aht-stk-line.crsa-vat-base ,2)
     4768                           ostatok-start[10 + p-num] = ostatok-start[10 + p-num] + round( ub.aht-stk-line.crsa-slt-base ,2)
     4769                     .
     4770                end.
     4771    find last  ub.aht-stk-line where
     4772                           ub.aht-stk-line.gds-code   = gds-zap-b-code
     4773                     and   ub.aht-stk-line.fact-order <= fact-order-2
     4774                     and   ub.aht-stk-line.obj-code   = p-store-code
     4775                     and   ub.aht-stk-line.obj-type   = p-store-type
     4776                     and   ub.aht-stk-line.sum-type   = x-type-pr
     4777                           use-index category no-lock no-error.
     4778           if available ub.aht-stk-line then do:
     4779               if  tprintrubl  then
     4780                     assign
     4781                           ostatok-end[1 + p-num]  = ostatok-end[1 + p-num] + (if ub.aht-stk-line.sum-type <> "b"
     4782                                                                  then round( ub.aht-stk-line.fact-qnty,3) else 0 )
     4783                           ostatok-end[2 + p-num]  = ostatok-end[2 + p-num] + round( ub.aht-stk-line.cost-sum-rubl ,2)
     4784                           ostatok-end[3 + p-num]  = ostatok-end[3 + p-num] + round( ub.aht-stk-line.cost-vat-rubl ,2)
     4785                           ostatok-end[4 + p-num]  = ostatok-end[4 + p-num] + 0
     4786                           ostatok-end[5 + p-num]  = ostatok-end[5 + p-num] + round( ub.aht-stk-line.crsa-sum-rubl ,2)
     4787                           ostatok-end[6 + p-num]  = ostatok-end[6 + p-num] + round( ub.aht-stk-line.crsa-vat-rubl ,2)
     4788                           ostatok-end[7 + p-num]  = ostatok-end[7 + p-num] + round( ub.aht-stk-line.sale-discnt-rubl ,2)
     4789                           ostatok-end[8 + p-num]  = ostatok-end[8 + p-num] + round( ub.aht-stk-line.crsa-sum-rubl ,2)
     4790                           ostatok-end[9 + p-num]  = ostatok-end[9 + p-num] + round( ub.aht-stk-line.crsa-vat-rubl ,2)
     4791                           ostatok-end[10 + p-num] = ostatok-end[10 + p-num] + round( ub.aht-stk-line.crsa-slt-rubl ,2)
     4792                           .
     4793                 else
     4794                     assign
     4795                           ostatok-end[1 + p-num]  = ostatok-end[1 + p-num] +  (if ub.aht-stk-line.sum-type <> "b"
     4796                                                                   then round( ub.aht-stk-line.fact-qnty,3) else 0 )
     4797                           ostatok-end[2 + p-num]  = ostatok-end[2 + p-num] +  round( ub.aht-stk-line.cost-sum-base ,2)
     4798                           ostatok-end[3 + p-num]  = ostatok-end[3 + p-num] +  round( ub.aht-stk-line.cost-vat-base ,2)
     4799                           ostatok-end[4 + p-num]  = ostatok-end[4 + p-num] +  0
     4800                           ostatok-end[5 + p-num]  = ostatok-end[5 + p-num] +  round( ub.aht-stk-line.crsa-sum-base ,2)
     4801                           ostatok-end[6 + p-num]  = ostatok-end[6 + p-num] +  round( ub.aht-stk-line.crsa-vat-base ,2)
     4802                           ostatok-end[7 + p-num]  = ostatok-end[7 + p-num] +  round( ub.aht-stk-line.sale-discnt-base ,2)
     4803                           ostatok-end[8 + p-num]  = ostatok-end[8 + p-num] +  round( ub.aht-stk-line.crsa-sum-base ,2)
     4804                           ostatok-end[9 + p-num]  = ostatok-end[9 + p-num] +  round( ub.aht-stk-line.crsa-vat-base ,2)
     4805                           ostatok-end[10 + p-num] = ostatok-end[10 + p-num] + round( ub.aht-stk-line.crsa-slt-base ,2)
     4806                     .
     4807                end.
     4808   end.
     4809   end procedure.
     4810   procedure ob-line  :
     4811   do on error undo, return error return-value :
     4812   def input  parameter x-store-code     like ub.clients.obj-code         no-undo .
     4813   def input  parameter x-store-type     like ub.clients.obj-type         no-undo .
     4814   def input  parameter x-gds-code       like ub.aht-ot-line.gds-code     no-undo .
     4815   def input  parameter x-fact-order-1   like ub.aht-ot-line.fact-order   no-undo .
     4816   def input  parameter x-fact-order-2   like ub.aht-ot-line.fact-order   no-undo .
     4817   def input  parameter x-sum-type       like ub.aht-ot-line.sum-type     no-undo .
     4818   def input  parameter xtog-obj         as logical no-undo .
     4819   define variable      tt#              as integer no-undo .
     4820   define variable x-type-pr1 as character no-undo .
     4821   define variable x-type-pr2 as character no-undo .
     4822   define variable p-ok as logical   no-undo .
     4823    if x-sum-type = arh-type-cost then tt# = 0 .
     4824    if x-sum-type = arh-type-crsa then tt# = 3 .
     4825    if x-sum-type = arh-type-sale then tt# = 6 .
     4826   if  x-sum-type = "cb" then
     4827    assign
     4828       x-type-pr1 = "c"
     4829       x-type-pr2 = "b"
     4830    .
     4831   else
     4832    assign
     4833       x-type-pr1 = x-sum-type
     4834       x-type-pr2 = x-sum-type
     4835    .
     4836     for each obj-list  no-lock :
     4837        for each ub.aht-ot-line where
     4838                         ( ub.aht-ot-line.gds-code      = x-gds-code
     4839                     and   ub.aht-ot-line.fact-order   <= x-fact-order-2
     4840                     and   ub.aht-ot-line.fact-order   >= x-fact-order-1
     4841                     and   ub.aht-ot-line.obj-code     = obj-list.obj-code
     4842                     and   ub.aht-ot-line.obj-type     = obj-list.obj-type
     4843                     and   ub.aht-ot-line.sum-type     = x-type-pr1 )
     4844                     OR  ( ub.aht-ot-line.gds-code      = x-gds-code
     4845                     and   ub.aht-ot-line.fact-order   <= x-fact-order-2
     4846                     and   ub.aht-ot-line.fact-order   >= x-fact-order-1
     4847                     and   ub.aht-ot-line.obj-code     = obj-list.obj-code
     4848                     and   ub.aht-ot-line.obj-type     = obj-list.obj-type
     4849                     and   ub.aht-ot-line.sum-type     = x-type-pr2 )
     4850                     no-lock :
     4851       if  p-tpsy = true then do:
     4852           run ver-owner2
     4853           ( input  ub.aht-ot-line.gds-code,
     4854             input  ub.aht-ot-line.obj-type,
     4855             input  ub.aht-ot-line.obj-code,
     4856             output p-ok ) .
     4857       end.
     4858       case ub.aht-ot-line.ext-doc-type:
     4859                 when        'ie':U  or
     4860                 when        're':U  or
     4861                 when        'iv':U    or
     4862                 when        'rv':U or
     4863                 when        'im':U     then
     4864                 do:
     4865                 assign
     4866                        prih[1 ]   = prih[1 ]   + (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     4867                        prih[2 ]   = prih[2 ]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     4868                        prih[3 ]   = prih[3 ]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     4869                        prih[4 ]   = prih[4 ]
     4870                        prih[5 ]   = prih[5 ]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     4871                        prih[6 ]   = prih[6 ]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     4872                        prih[7 ]   = prih[7 ]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4873                        prih[8 ]   = prih[8 ]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     4874                        prih[9 ]   = prih[9 ]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     4875                        gds-zap-other   = gds-zap-other  +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4876                  .
     4877        if p-ok = true then do:
     4878           assign
     4879             prih[11 ]   = prih[11 ]   + (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     4880             prih[12 ]   = prih[12 ]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     4881             prih[13 ]   = prih[13 ]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     4882             prih[14 ]   = prih[14 ]
     4883             prih[15 ]   = prih[15 ]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     4884             prih[16 ]   = prih[16 ]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     4885             prih[17 ]   = prih[17 ]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4886             prih[18 ]   = prih[18 ]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     4887             prih[19 ]   = prih[19 ]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     4888             .
     4889        end.
     4890                 end.
     4891                 when       'ee':U      or
     4892                 when       'ep':U    or
     4893                 when       'ev':U     or
     4894                 when       'em':U       or
     4895                 when       'wm':U       or
     4896                 when       'we':U     then
     4897                 do:
     4898                   assign
     4899                       rash[1  ]   = rash[1 ]   +  (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     4900                       rash[2  ]   = rash[2 ]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     4901                       rash[3 ]   = rash[3 ]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     4902                       rash[4 ]   = rash[4 ]
     4903                       rash[5 ]   = rash[5 ]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     4904                       rash[6 ]   = rash[6 ]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     4905                       rash[7 ]   = rash[7 ]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4906                       rash[8 ]   = rash[8 ]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     4907                       rash[9 ]   = rash[9 ]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     4908                       gds-zap-other   = gds-zap-other  +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4909                 .
     4910                   if p-ok = true then do:
     4911                     assign
     4912                       rash[11  ]   = rash[11 ]   +  (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     4913                       rash[12  ]   = rash[12 ]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     4914                       rash[13 ]   = rash[13 ]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     4915                       rash[14 ]   = rash[14 ]
     4916                       rash[15 ]   = rash[15 ]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     4917                       rash[16 ]   = rash[16 ]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     4918                       rash[17 ]   = rash[17 ]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4919                       rash[18 ]   = rash[18 ]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     4920                       rash[19 ]   = rash[19 ]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     4921                     .
     4922                   end.
     4923                 end.
     4924                 when       'es':U  or
     4925                 when       'rs':U then
     4926                 do:
     4927                     assign
     4928                       kassa[1  ]   = kassa[1 ]   +  (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     4929                       kassa[2  ]   = kassa[2 ]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     4930                       kassa[3  ]   = kassa[3 ]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     4931                       kassa[4  ]   = kassa[4 ]
     4932                       kassa[5  ]   = kassa[5 ]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     4933                       kassa[6  ]   = kassa[6 ]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     4934                       kassa[7  ]   = kassa[7 ]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4935                       kassa[8  ]   = kassa[8 ]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     4936                       kassa[9  ]   = kassa[9 ]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     4937                       gds-zap-other   = gds-zap-other  +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4938                       .
     4939                     if p-ok = true then
     4940                     assign
     4941                       kassa[11  ]   = kassa[11 ]   +  (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     4942                       kassa[12  ]   = kassa[12 ]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     4943                       kassa[13  ]   = kassa[13 ]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     4944                       kassa[14  ]   = kassa[14 ]
     4945                       kassa[15  ]   = kassa[15 ]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     4946                       kassa[16  ]   = kassa[16 ]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     4947                       kassa[17  ]   = kassa[17 ]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4948                       kassa[18  ]   = kassa[18 ]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     4949                       kassa[19  ]   = kassa[19 ]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     4950                       .
     4951                 end.
     4952             when       'vt':U            or
     4953             when       'pc':U or
     4954             when       'vp':U       then do:
     4955                 assign
     4956                   inv[1  ]   = inv[1 ]   +  (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     4957                   inv[2  ]   = inv[2 ]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     4958                   inv[3  ]   = inv[3 ]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     4959                   inv[4  ]   = inv[4 ]
     4960                   inv[5  ]   = inv[5 ]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     4961                   inv[6  ]   = inv[6 ]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     4962                   inv[7  ]   = inv[7 ]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4963                   inv[8  ]   = inv[8 ]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     4964                   inv[9  ]   = inv[9 ]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     4965                   gds-zap-other   = gds-zap-other  +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4966                   .
     4967                 if p-ok = true then
     4968                 assign
     4969                   inv[11  ]   = inv[11 ]   +  (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     4970                   inv[12  ]   = inv[12 ]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     4971                   inv[13  ]   = inv[13 ]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     4972                   inv[14  ]   = inv[14 ]
     4973                   inv[15  ]   = inv[15 ]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     4974                   inv[16  ]   = inv[16 ]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     4975                   inv[17  ]   = inv[17 ]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4976                   inv[18  ]   = inv[18 ]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     4977                   inv[19  ]   = inv[19 ]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     4978                   .
     4979                 end.
     4980             when       'ot':U or
     4981             when       'ap':U then
     4982                 do:
     4983                    assign
     4984                       overturn[1  ]   = overturn[1 ]   +  (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     4985                       overturn[2  ]   = overturn[2 ]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     4986                       overturn[3  ]   = overturn[3 ]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     4987                       overturn[4  ]   = overturn[4 ]
     4988                       overturn[5  ]   = overturn[5 ]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     4989                       overturn[6  ]   = overturn[6 ]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     4990                       overturn[7  ]   = overturn[7 ]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4991                       overturn[8  ]   = overturn[8 ]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     4992                       overturn[9  ]   = overturn[9 ]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     4993                       gds-zap-other   = gds-zap-other  +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4994                       .
     4995                    if p-ok = true then
     4996                    assign
     4997                       overturn[11  ]   = overturn[11 ]   +  (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     4998                       overturn[12  ]   = overturn[12 ]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     4999                       overturn[13  ]   = overturn[13 ]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     5000                       overturn[14  ]   = overturn[14 ]
     5001                       overturn[15  ]   = overturn[15 ]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     5002                       overturn[16  ]   = overturn[16 ]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     5003                       overturn[17  ]   = overturn[17 ]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     5004                       overturn[18  ]   = overturn[18 ]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     5005                       overturn[19  ]   = overturn[19 ]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     5006                       .
     5007                 end.
     5008         end case.
     5009      end.
     5010     end.
     5011     assign
     5012       tt# = 6
     5013       overturn[1 + tt# ]   = (ostatok-end[1 + tt# ]  - ostatok-start[1 + tt# ] )  -  (inv[1 + tt# ] + prih[1 + tt# ] + kassa[1 + tt# ] + rash[1 + tt# ]  )
     5014       overturn[2 + tt# ]   = (ostatok-end[2 + tt# ]  - ostatok-start[2 + tt# ] )  -  (inv[2 + tt# ] + prih[2 + tt# ] + kassa[2 + tt# ] + rash[2 + tt# ]  )
     5015       overturn[3 + tt# ]   = (ostatok-end[3 + tt# ]  - ostatok-start[3 + tt# ] )  -  (inv[3 + tt# ] + prih[3 + tt# ] + kassa[3 + tt# ] + rash[3 + tt# ]  )
     5016     .
     5017     if p-ok = true then
     5018     assign
     5019       tt# = 6
     5020       overturn[1 + tt# ]   = (ostatok-end[1 + tt# ]  - ostatok-start[1 + tt# ] )  -  (inv[1 + tt# ] + prih[1 + tt# ] + kassa[1 + tt# ] + rash[1 + tt# ]  )
     5021       overturn[2 + tt# ]   = (ostatok-end[2 + tt# ]  - ostatok-start[2 + tt# ] )  -  (inv[2 + tt# ] + prih[2 + tt# ] + kassa[2 + tt# ] + rash[2 + tt# ]  )
     5022       overturn[3 + tt# ]   = (ostatok-end[3 + tt# ]  - ostatok-start[3 + tt# ] )  -  (inv[3 + tt# ] + prih[3 + tt# ] + kassa[3 + tt# ] + rash[3 + tt# ]  )
     5023     .
     5024   end.
     5025   end procedure.
     5026   procedure ver-owner :
     5027     do
     5028     on error undo, return error return-value
     5029     :
     5030   define input  parameter p-gds-code like ub.goods.gds-code no-undo .
     5031   define input  parameter p-db-num as integer   no-undo .
     5032   define output parameter p-ok as logical   no-undo .
     5033   define variable  p-proprietor-host-code like ub.clients.host-code no-undo .
     5034   define variable  p-proprietor-obj-type  like ub.clients.obj-type no-undo .
     5035   define variable  p-proprietor-obj-code  like ub.clients.obj-code no-undo .
     5036   p-ok = false .
     5037   if  p-tpsy = false  then return.
     5038     run tpsi-gds-proprietor (
     5039         input  p-gds-code             ,
     5040         input  p-db-num               ,
     5041         output p-proprietor-host-code ,
     5042         output p-proprietor-obj-type  ,
     5043         output p-proprietor-obj-code )  .
     5044    if p-proprietor-host-code = v-cntxt-host-code-obj then p-ok = true  .
     5045   end.
     5046   end procedure.
     5047   procedure ver-owner2 :
     5048     do
     5049     on error undo, return error return-value
     5050     :
     5051   define input  parameter p-gds-code like ub.goods.gds-code no-undo .
     5052   define input  parameter p-obj-type  like ub.clients.obj-type no-undo .
     5053   define input  parameter p-obj-code  like ub.clients.obj-code no-undo .
     5054   define output parameter p-ok as logical   no-undo .
     5055   define variable  p-proprietor-host-code like ub.clients.host-code no-undo .
     5056   define variable  p-proprietor-obj-type  like ub.clients.obj-type no-undo .
     5057   define variable  p-proprietor-obj-code  like ub.clients.obj-code no-undo .
     5058   p-ok = false .
     5059   if  p-tpsy = false  then return.
     5060   define buffer buf_obj-list for obj-list.
     5061   find first buf_obj-list where
     5062         buf_obj-list.obj-type = p-obj-type and
     5063         buf_obj-list.obj-code = p-obj-code
     5064         no-error .
     5065   if error-status :error then return .
     5066     run tpsi-gds-proprietor (
     5067         input  p-gds-code             ,
     5068         input  buf_obj-list.db-num     ,
     5069         output p-proprietor-host-code ,
     5070         output p-proprietor-obj-type  ,
     5071         output p-proprietor-obj-code )  .
     5072    if p-proprietor-host-code = v-cntxt-host-code-obj then p-ok = true  .
     5073   end.
     5074   end procedure.
