     3740   procedure display-b1  :
     3741         if not( not show-negativ-2 and
     3742            ( b1-prih          [1]   = 0 and
     3743              b1-rash          [1]   = 0 and
     3744              b1-kassa         [1]   = 0 and
     3745              b1-inv           [1]   = 0 and
     3746              b1-overturn      [1]   = 0 and
     3747              b1-overturn      [5]   = 0 and
     3748              b1-overturn      [8]   = 0 ) ) then do:
     3749           if  not (not show-negativ  and (
     3750                 b1-prih          [1]   = 0 and
     3751                 b1-rash          [1]   = 0 and
     3752                 b1-kassa         [1]   = 0 and
     3753                 b1-inv           [1]   = 0 and
     3754                 b1-overturn      [1]   = 0 and
     3755                 b1-overturn      [5]   = 0 and
     3756                 b1-ostatok-start [1]   = 0 and
     3757                 b1-ostatok-end   [1]   = 0   )) then do:
     3758                 if sums-only then do:
     3759                     if fr0 = true then do:
     3760                         put stream  outstream  tmp#stroka0 format "x(100)" skip.
     3761                         if Make-Excel then  put   stream ForExcel unformatted string(tmp#stroka0) skip.
     3762                         fr0 = false .
     3763                       end.
     3764                  end.
     3765      if p-tpsy = no  or ( p-tpsy = true and  p-type-tpsy-goods = 2 ) then do:
     3766           run di-qnty in this-procedure ("кол-во"  ,1, s-bar-code, gds-zap-artic, gds-zap-gds-name  ,"","b1":u).
     3767           if xshowcost    then do: run di in this-procedure ("учет." ,2 ,"","", "", "", "b1":u).  end.
     3768           if xshowcrsa    then do: run di in this-procedure ("прод." , 5, "","", "", "", "b1":u).  end.
     3769           if xshowsale    then do: run di in this-procedure ("док." , 8, "","", "", "", "b1":u).  end.
     3770           if vat-cost    then do: run di in this-procedure ( "уч.НДС", 3,"","","","","b1":u ). end.
     3771           if vat-crsa    then do: run di in this-procedure ( "пр.НДС", 6,"","","","","b1":u ).  end.
     3772           if vat-sale    then do: run di in this-procedure ( "дк.НДС", 9,"","","","","b1":u ).  end.
     3773      end.
     3774      if p-tpsy = true  then do:
     3775            if  p-type-tpsy-goods = 3 then
     3776                run di-qnty ("кол-во"  ,11, s-bar-code, gds-zap-artic, gds-zap-gds-name  ,"","b1":u).
     3777            else
     3778               run di-qnty in this-procedure ("кол-во"  ,11, "","", str_svoi, "","b1":u).
     3779           if xshowcost    then do: run di in this-procedure ("учет." ,12 ,"","", "", "", "b1":u).  end.
     3780           if xshowcrsa    then do: run di in this-procedure ("прод." ,15, "","", "", "", "b1":u).  end.
     3781           if xshowsale    then do: run di in this-procedure ("док." , 18, "","", "", "", "b1":u).  end.
     3782           if vat-cost    then do: run di in this-procedure ( "уч.НДС", 13,"","","","","b1":u ). end.
     3783           if vat-crsa    then do: run di in this-procedure ( "пр.НДС", 16,"","","","","b1":u ).  end.
     3784           if vat-sale    then do: run di in this-procedure ( "дк.НДС", 19,"","","","","b1":u ).  end.
     3785      end.
     3786          if not sums-only then run p-line.
     3787    end.
     3788    end.
