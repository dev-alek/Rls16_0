     4077                   else Assign temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name )  b2-name = gds-zap-prod-name.
     4078                 if NOT xSumsOnly THEN DO:
     4079                     fr = true .
     4080                 End.
     4081                 break_group1 = false.
     4082               END.
     4083          break_group = false.
     4084       End.
     4085       gds-zap-gds-name = string(old-gds-zap-gds-name,"x(28)") + "|"   + "Консиг".
     4086       run display-line.
