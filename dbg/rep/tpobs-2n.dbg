     3820            else
     3821             run di-qnty( "кол-во", 11 ,"","", str_svoi,"", "b2":u).
     3822           if xshowcost    then do: run di ("учет.", 12, "","", "", "", "b2":u).  end.
     3823           if xshowcrsa    then do: run di ("прод.", 15 ,"","", "", "", "b2":u).  end.
     3824           if xshowsale    then do: run di ("док.", 18 ,"","", "", "", "b2":u).  end.
     3825            if vat-cost    then do: run di ( "уч.НДС", 13,"","","","","b2":u ). end.
     3826            if vat-crsa    then do: run di ( "пр.НДС", 16,"","","","","b2":u ).  end.
     3827            if vat-sale    then do: run di ( "дк.НДС", 19,"","","","","b2":u ).  end.
     3828      end.
     3829    end.
     3830   end.
     3831   end procedure.
     3832   procedure clear-b1  :
     3833    b1-gds-zap-other           = 0.
     3834    repeat kk = 1 to 20 :
     3835    assign
     3836       b1-prih                                            [kk]    = 0
     3837       b1-rash                                            [kk]    = 0
     3838       b1-kassa                                           [kk]    = 0
     3839       b1-inv                                             [kk]    = 0
     3840       b1-overturn                                        [kk]    = 0
     3841       b1-ostatok-end                                     [kk]    = 0
     3842       b1-ostatok-start                                   [kk]    = 0   .
