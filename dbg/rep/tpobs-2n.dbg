     3962   procedure item-goods :
     3963      def input parameter  par-3 as char no-undo.
     3964      def input parameter  par-4 as char no-undo.
     3965        if par-4 = "goods":u  then do:
     3966           assign
     3967               gds-zap-unit-base  = goods.unit-base
     3968               gds-zap-prt-root   = goods.prt-root
     3969               gds-zap-prod-type  = goods.prod-type
     3970               gds-zap-prod-code  = goods.prod-code
     3971               gds-zap-artic      = goods.artic
     3972               gds-zap-grp-name   = goods.grp-name
     3973               gds-zap-b-code     = goods.gds-code
     3974               gds-zap-type       = goods.gds-type.
     3975           if g#gds-engl then
     3976               assign gds-zap-gds-name = goods.engl-name.
     3977           else
     3978               assign gds-zap-gds-name = goods.gds-name.
     3979        end.
     3980        if par-4 = "gds-list":u  then do:
     3981           assign
     3982               gds-zap-unit-base  = gds-list.unit-base
     3983               gds-zap-prt-root   = gds-list.prt-root
     3984               gds-zap-prod-type  = gds-list.prod-type
     3985               gds-zap-prod-code  = gds-list.prod-code
     3986               gds-zap-artic      = gds-list.artic
     3987               gds-zap-grp-name   = gds-list.grp-name
     3988               gds-zap-b-code     = gds-list.gds-code
     3989               gds-zap-type       = gds-list.gds-type.
     3990           if g#gds-engl then
     3991               assign gds-zap-gds-name = gds-list.engl-name.
     3992           else
     3993               assign gds-zap-gds-name = gds-list.gds-name.
     3994        end.
     3995       define variable old-gds-zap-gds-name as character no-undo .
     3996       old-gds-zap-gds-name = gds-zap-gds-name.
     3997       x-type-pr = "r".
     3998       run foreach.
     3999   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     4000     (input  gds-zap-b-code
     4001     ,input  ?
     4002     ,output v-bar-code
     4003     )  .
     4004   s-bar-code = string (v-bar-code,"999999999").
     4005       If  break_group = true  and par-3 <> "1"  then DO :
     4006            FIND FIRST clients WHERE clients.obj-type = gds-zap-prod-type AND clients.obj-code = gds-zap-prod-code use-index pi NO-LOCK .
     4007            gds-zap-prod-name  = clients.obj-name.
     4008             If break_group1 = true  THEN  DO :
     4009               if (par-3 = "3"  OR  par-3 = "5" ) and  par-3 <> "6"
     4010                 then DO: Assign temp-str = string("ГРУППА : " + gds-zap-grp-name )         b1-name = gds-zap-grp-name . end.
     4011                 else DO: Assign temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name ) b1-name = gds-zap-prod-name. end.
     4012               if par-3 = "6"  then  dO:
     4013                  if xTog-obj = true then do:
     4014                    var-vat-pc = func-vat (input gds-zap-b-code , input x-store-type, input x-store-code)
     4015                     .
     4016                   end.
     4017                  else do:
     4018                   var-vat-pc = temp-gds-list.vat-pc .
     4019                   end.
     4020                   assign
     4021                       temp-str = string( "СТАВКА НДС : " + string(var-vat-pc) + "%" )
     4022                       b1-name = temp-str.
     4023                   end.
     4024               if NOT xSumsOnly or (par-3 = "4" Or par-3 = "5" ) THEN DO :
     4025                   fr0 = true .
     4026                   tmp#stroka0 = temp-str.
     4027               End.
     4028             End.
     4029               IF (par-3 = "4"  OR  par-3 = "5")  THEN DO:
     4030                 if par-3 = "4"
     4031                   then Assign temp-str = string("ГРУППА : " + gds-zap-grp-name )          b2-name = gds-zap-grp-name .
     4032                   else Assign temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name )  b2-name = gds-zap-prod-name.
     4033                 if NOT xSumsOnly THEN DO:
     4034                     fr = true .
     4035                 End.
     4036                 break_group1 = false.
     4037               END.
     4038          break_group = false.
     4039       End.
     4040       gds-zap-gds-name = string(old-gds-zap-gds-name,"x(28)") + "|" + "Выкуп".
     4041       run display-line.
     4042       x-type-pr = "cb".
