     2650   define variable b2-gds-zap-other         like ub.stk-tot.sum-base no-undo.
     2651   define variable  fact-order-1   like ub.stk-tot.fact-order no-undo.
     2652   define variable  quantity1      like ub.stk-tot.fact-qnty  no-undo.
     2653   define variable  coast_r1       like ub.stk-tot.sum-rubl   no-undo.
     2654   define variable  coast_v1       like ub.stk-tot.sum-rubl   no-undo.
     2655   define variable  vat_r1         like ub.stk-tot.sum-rubl   no-undo.
     2656   define variable  vat_v1         like ub.stk-tot.sum-rubl   no-undo.
     2657   define variable  fact-order-2   like ub.stk-tot.fact-order no-undo.
     2658   define variable  quantity2      like ub.stk-tot.fact-qnty  no-undo.
     2659   define variable  coast2         like ub.stk-tot.sum-rubl   no-undo.
     2660   define variable  coast_r2       like ub.stk-tot.sum-rubl   no-undo.
     2661   define variable  coast_v2       like ub.stk-tot.sum-rubl   no-undo.
     2662   define variable  vat_r2         like ub.stk-tot.sum-rubl   no-undo.
     2663   define variable  vat_v2         like ub.stk-tot.sum-rubl   no-undo.
     2664   define variable  quantity    like ub.stk-tot.fact-qnty  no-undo.
     2665   define variable  coast       like ub.stk-tot.sum-rubl   no-undo.
     2666   define variable  coast_r     like ub.stk-tot.sum-rubl   no-undo.
     2667   define variable  coast_v     like ub.stk-tot.sum-rubl   no-undo.
     2668   define variable  vat_r       like ub.stk-tot.sum-rubl   no-undo.
     2669   define variable  vat_v       like ub.stk-tot.sum-rubl   no-undo.
     2670   define variable  slt_r       like ub.stk-tot.sum-rubl   no-undo.
     2671   define variable  slt_v       like ub.stk-tot.sum-rubl   no-undo.
     2672   define variable  coast3       like ub.stk-tot.sum-rubl   no-undo.
     2673   define variable  coast4       like ub.stk-tot.sum-rubl   no-undo.
     2674   define variable  temp-str as char no-undo.
     2675   define variable xshowcost as logical no-undo .
     2676   define variable xshowsale as logical no-undo .
     2677   define variable xshowcrsa as logical no-undo .
     2678   define variable arh-type-sale as character no-undo .
     2679   define variable arh-type-crsa as character no-undo .
     2680   define variable arh-type-cost as character no-undo .
     2681   define variable arh-type-sadt as character no-undo .
     2682   define variable arh-type-cgdt as character no-undo .
     2683   define variable arh-type-csdt as character no-undo .
     2684   define variable arh-type-allsum  as character no-undo .
     2685   define variable str as char format "x(60)" no-undo.
     2686   define variable i#i as int no-undo.
     2687   define variable xlavel as int  no-undo.
     2688   define variable list-field as char no-undo.
     2689   define variable str10 as char no-undo.
     2690   define frame zapas
     2691           s-bar-code column-label  "Код! ! ":c9 space(0)
     2692           sym1 column-label ":!:!:" format "x(1)"       space(0)
     2693           gds-zap-artic column-label "Артикул! ! ":c16 format "x(16)" space(0)
     2694           sym2 column-label ":!:!:" format "x(1)"                         space(0)
     2695           gds-zap-gds-name column-label "Название товара! ! ":c36 format "x(36)" space(0)
     2696           sym3 column-label ":!:!:" format "x(1)"                                     space(0)
     2697           gds-zap-unit-base column-label "Ед.!изм! " format "x(3)"                  space(0)
     2698           sym4 column-label ":!:!:" format "x(1)"                                     space(0)
     2699           gds-type column-label "Тип!данных! ":c6 format "x(6)"                  space(0)
     2700           sym5 column-label ":!:!:" format "x(1)" space(0)
     2701           f-ostatok-start     column-label "Остаток на!начало! ":c14 format "x(14)"           space(0)
     2702           sym6 column-label ":!:!:" format "x(1)" space(0)
     2703           f-prih       column-label "Приход! ! ":c14     format "x(14)"     space(0)
     2704           sym7 column-label ":!:!:" format "x(1)" space(0)
     2705           f-rash       column-label "Расход! ! ":c14  format "x(14)"   space(0)
     2706           sym8 column-label ":!:!:" format "x(1)" space(0)
     2707           f-kassa             column-label "Касса! ! ":c14  format "x(14)"   space(0)
     2708           sym9  column-label ":!:!:" format "x(1)" space(0)
     2709           f-inv               column-label "Инвентаризация!Смена типа!приобретения":c14  format "x(14)"   space(0)
     2710           sym10 column-label ":!:!:" format "x(1)" space(0)
     2711           f-overturn         column-label "Переоценка!продажной и!учетной цен":c14  format "x(14)"   space(0)
     2712           sym11 column-label ":!:!:" format "x(1)" space(0)
     2713           gds-zap-other      column-label "Скидка! ! ":c13     space(0)
     2714           sym12 column-label ":!:!:" format "x(1)" space(0)
     2715           f-ostatok-end     column-label "Остаток!на конец! ":c14 format "x(14)"           space(0)
     2716       header
     2717           string( "Дата печати : " + string(today,"99.99.9999") +  " , " + string(time, "hh:mm") ) at 5 format "x(35)"
     2718           "Цены указаны в" (if tprintrubl then "руб" else x-base-type )
     2719           string( "Страница " + string( page-number( outstream ), ">>>>>9") ) at 147 format "x(53)" skip
     2720           line format "x(194)" at 1
     2721      with width 232 down stream-io use-text no-box.
     2722        assign
     2723           i = 0
     2724           xlavel        = xvar-lavel
     2725           select-good   = x-selectgood
     2726           paytype       = x-set_pay_type
     2727           retclassify   = xclassify
     2728           retsorttype   = xsorttype
     2729           sums-only     = xsumsonly
     2730           show-negativ  = xshowzero
     2731           show-negativ-2  = xshowzero-2
     2732           xshowcost     = show-cost
     2733           xshowsale     = show-sale
     2734           xshowcrsa     = show-crsa
     2735           firstline     = false
     2736           line          = fill("-", 232)
     2737           valtype       = if (paytype = 1) then 0  else x-set_val_type.
     2738      run report-execute.
     2739   procedure report-execute :
     2740   define variable gj as integer no-undo init 0.
     2741     if (valtype=0 and x-base-code=0)  or valtype=1
     2742                                   then   assign tprintrubl = yes .
     2743                                   else   assign tprintrubl = no .
     2744     if reportpageheight = 0 then reportpageheight  = 43.
     2745   output stream outstream to value( string( session:temp-directory +
     2746                                        "rpt" + string( g#report-num ) ) )
     2747                                        page-size  value(reportpageheight) .
     2748     find first clients where x-store-type = clients.obj-type and
     2749                              x-store-code = clients.obj-code no-lock no-error.
     2750     if available clients then  objname = clients.obj-name.
     2751                                   else  objname="объект не определен".
     2752   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2753   form header
     2754     line format "x(194)" at 1 skip
     2755     "Продолжение - на следующей странице" at 30 skip
     2756     with frame bottomframe width 232 page-bottom no-labels no-box .
     2757   view stream outstream frame bottomframe .
     2758        run report-exec1.
     2759     hide stream outstream frame bottomframe .
     2760     hide   stream outstream frame zapas .
     2761     output stream outstream close.
     2762   if mFrameView
     2763   then do:
     2764      HIDE FRAME InfoFrame.
     2765   end.
     2766     if Make-Excel then output stream ForExcel close.
     2767     define variable v-user-action as character no-undo .
     2768     define variable v-printed as logical   no-undo .
     2769     define variable DisabledOptions as integer   no-undo .
     2770     define variable v-orient-page as character no-undo .
     2771     run How-name in this-procedure (
     2772         input ReportPageHeight,
     2773         input ReportPageWidth,
     2774         output v-orient-page )
     2775         .
     2776     if v-orient-page = "A4-lans":U then DisabledOptions = 8 .
     2777                                    else DisabledOptions = 0 .
     2778     run gbl/prnfilen.w
     2779       (input  ""
     2780       ,input  DisabledOptions
     2781       ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
     2782       ,input reportfontNum
     2783       ,output v-user-action
     2784       ,output v-printed
     2785       ) .
     2786   end procedure.
     2787   procedure clear-line :
     2788    do on error undo, return error return-value :
     2789    define variable l as integer   no-undo init 1.
     2790    repeat L = 1 to 20 :
     2791       assign
     2792           ostatok-start[L]  = 0
     2793           ostatok-end[L]  = 0
     2794     .
     2795    end.
     2796    end.
     2797   end procedure.
     2798   procedure ost-line :
     2799   do
     2800   on error undo, return error return-value
     2801   :
     2802   define input parameter p-store-type like ub.clients.obj-type no-undo .
     2803   define input parameter p-store-code like ub.clients.obj-code no-undo.
     2804   define input parameter p-gds-code   like goods.gds-code no-undo .
     2805   define input parameter p-db-num as integer   no-undo .
     2806   define variable p-ok as logical   no-undo .
     2807   if  p-tpsy = true then do:
     2808       run ver-owner
     2809       ( input  p-gds-code,
     2810         input  p-db-num  ,
     2811         output p-ok ) .
     2812         if p-ok = true  then
     2813             run ost-line-body(10 , p-store-type , p-store-code) .
     2814         if p-type-tpsy-goods = 2 then
     2815             run ost-line-body(0 , p-store-type , p-store-code) .
     2816   end.
     2817   if  p-tpsy = false  then do:
     2818    run ost-line-body(0 , p-store-type , p-store-code) .
     2819   end.
     2820   end.
     2821   end procedure.
     2822   procedure foreach :
     2823   define variable old-type as character no-undo .
     2824   define variable old-gds-zap-gds-name as character no-undo .
     2825      old-type = x-type-pr.
     2826   IF ( i modulo v-account = 0 )  then DO:
     2827    Assign
     2828       v-kol-spice = (50 - LENGTH(reportname)) / 2
     2829       RecordsString = fill(' ',v-kol-spice) + string(reportname)
     2830       .
     2831    Assign
     2832       v-kol-spice = (50 - LENGTH(objname)) / 2
     2833       RecordsString2 = fill(' ',v-kol-spice) + string(objname)
     2834       .
     2835             if  log-manager:logfile-name ne ?
     2836             then DO:
     2837                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     2838             end.
     2839              if mFrameView
     2840              then do:
     2841               DISPLAY
     2842                 i @ RecordsDone
     2843                 RecordsString   @ RecordsString
     2844                 RecordsString2  @ RecordsString2
     2845                 WITH FRAME InfoFrame.
     2846              end.
     2847   End.
     2848      if v-button-stop then  DO:
     2849            if mFrameView
     2850            then
     2851               PROCESS EVENTS.
     2852            IF StopProcessing THEN DO:
     2853            RETURN error.
     2854            End.
     2855      end.
     2856     run clear-item.
     2857     run clear-line.
     2858     for each obj-list  no-lock :
     2859       if x-type-pr = "cb" then do:
     2860          x-type-pr = "b".
     2861          run ost-line (obj-list.obj-type , obj-list.obj-code , gds-zap-b-code , obj-list.db-num ) .
     2862          x-type-pr = "c".
     2863          run ost-line (obj-list.obj-type , obj-list.obj-code  , gds-zap-b-code , obj-list.db-num) .
     2864          x-type-pr = old-type .
     2865       end.
     2866       else do:
     2867          run ost-line (obj-list.obj-type , obj-list.obj-code  , gds-zap-b-code , obj-list.db-num) .
     2868       end.
     2869     end.
     2870      run ob-line (
     2871             input   x-store-code   ,
     2872             input   x-store-type   ,
     2873             input   gds-zap-b-code ,
     2874             input   fact-order-1,
     2875             input   fact-order-2,
     2876             input   x-type-pr     ,
     2877             input   xtog-obj) .
     2878      run calc-sub-itog .
     2879   end procedure.
     2880   procedure display-line :
     2881   if num-entries(gds-zap-gds-name, "|") = 2 then
     2882   assign
     2883     g1 =  entry(1 ,gds-zap-gds-name, "|")
     2884     g2 =  entry(2 ,gds-zap-gds-name, "|")
     2885   .
     2886   assign
     2887     g1 =  gds-zap-gds-name
     2888     g2 =  ""
     2889   .
     2890        i = i + 1.
     2891           if not( not show-negativ-2 and
     2892            ( prih         [1]   = 0 and
     2893             rash          [1]   = 0 and
     2894             kassa         [1]   = 0 and
     2895             inv           [1]   = 0 and
     2896             overturn      [1]   = 0 and
     2897             overturn      [5]   = 0 and
     2898             overturn      [8]   = 0 ) ) then do:
     2899           if  not (not show-negativ  and (
     2900                 prih          [1]   = 0 and
     2901                 rash          [1]   = 0 and
     2902                 kassa         [1]   = 0 and
     2903                 inv           [1]   = 0 and
     2904                 overturn      [1]   = 0 and
     2905                 overturn      [5]   = 0 and
     2906                 ostatok-start [1]   = 0 and
     2907                 ostatok-end   [1]   = 0   )) then do:
     2908           if not sums-only then do:
     2909               if fr0 = true then do:
     2910                 put stream  outstream  tmp#stroka0 format "x(100)" skip.
     2911                 if Make-Excel then  put   stream ForExcel unformatted string(tmp#stroka0) skip.
     2912                 fr0 = false .
     2913               end.
     2914               if fr = true then do:
     2915                 put stream outstream space(10) temp-str format "x(100)" skip.
     2916                 if Make-Excel then  put   stream ForExcel unformatted CHR(9) string(temp-str) skip.
     2917                 fr = false .
     2918               end.
     2919              run display-str1 in this-procedure.
     2920             end.
     2921           end.
     2922        end.
     2923     end procedure.
     2924   procedure print-header :
     2925   if not firstline then do:
     2926      run display-title.
     2927      form with FRAME ZAPAS .  DOWN stream   OutStream 1 with FRAME ZAPAS .
     2928   end.
     2929    firstline = true .
     2930       if xtog-obj and   x-selectobject <> "currency":u   then  do:
     2931             PUT stream  OutStream  UNFORMATTED     "ПО ОБЪЕКТУ : " + caps(clients.obj-name)  at 30 format "x(170)" skip.
     2932             if Make-Excel then  put   stream ForExcel unformatted   "ПО ОБЪЕКТУ : " + caps(clients.obj-name) format "x(170)" skip.
     2933         end.
     2934         run clear-b1 .
     2935         run clear-b2.
     2936         run clear-bi .
     2937         break_group = true.
     2938         break_group1 = true.
     2939      end procedure.
     2940   procedure print-footer :
     2941         if retclassify = "no-classify":u  then run u-line.
     2942          gds-zap-artic = "ИТОГО" .
     2943          run display-bi.
     2944          run u-line.
     2945          end procedure.
     2946   procedure u-line :
     2947   underline stream outstream  sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     2948     s-bar-code
     2949     gds-zap-artic
     2950     gds-zap-gds-name
     2951     gds-zap-unit-base
     2952     gds-type
     2953     f-ostatok-start
     2954     f-prih
     2955     f-rash
     2956     f-kassa
     2957     f-inv
     2958     f-overturn
     2959     f-ostatok-end
     2960     gds-zap-other
     2961     with FRAME ZAPAS .
     2962     DOWN stream   OutStream 1 with FRAME ZAPAS.
     2963   end procedure.
     2964   procedure p-line :
     2965   underline stream outstream  sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     2966           gds-zap-artic
     2967           gds-zap-gds-name
     2968           gds-zap-unit-base
     2969           gds-type
     2970           f-ostatok-start
     2971           f-prih
     2972           f-rash
     2973           f-kassa
     2974           f-inv
     2975           f-overturn
     2976           f-ostatok-end
     2977           gds-zap-other
     2978           with FRAME ZAPAS .
     2979           DOWN stream   OutStream 1 with FRAME ZAPAS.
     2980   end procedure.
     2981   procedure run2 :
     2982        if not xtog-lavel then do:   run run2sort1.    end.
     2983          else do:   run lavel1.      end.
     2984      end procedure.
     2985   procedure run2sort1 :
     2986                 case select-good :
     2987                     when 1  then do:
     2988   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2989   IF x-SelectObject = "currency":U  OR  xTog-obj THEN DO :
     2990       for each gds-obj  where
     2991             gds-obj.obj-type = x-store-type  and
     2992             gds-obj.obj-code = x-store-code
     2993             and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     2994                   no-lock,
     2995             First goods  where  gds-obj.gds-code   = goods.gds-code
     2996   no-lock
     2997   BREAK
     2998         BY (temp-gds-list.grp-name)
     2999       BY (temp-gds-list.gds-code) :
     3000         run item-goods ( "3" , "goods" ) .
     3001         if return-value <> "" then NEXT.
     3002           If Last-of(temp-gds-list.grp-name) Then Do:
     3003           If String(Entry(2,"temp-gds-list.grp-name",".")) = "Grp-name"
     3004             Then  Assign
     3005                     S-bar-code   = " Итого по "
     3006                     Gds-zap-artic = Substring(
     3007                                         B1-name
     3008                                         ,1,16)
     3009                     Gds-zap-gds-name = Substring(
     3010                                         B1-name
     3011                                         ,17,40)
     3012                                   .
     3013             Else  Assign
     3014                     S-bar-code   = ""
     3015                     Gds-zap-artic = "        Итого по "
     3016                     Gds-zap-gds-name =  B1-name
     3017                                   .
     3018               Run Display-b1 In This-procedure .
     3019               Run Clear-b1 In This-procedure .
     3020               Assign Break_Group = True.
     3021           End.
     3022       End.
     3023     END.
     3024     Else DO:
     3025      For each obj-list no-lock :
     3026                     FOR EACH gds-obj where
     3027                   gds-obj.obj-type = obj-list.obj-type    and
     3028                   gds-obj.obj-code = obj-list.obj-code
     3029                   and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     3030                   no-lock :
     3031                   if NOT can-find(First temp-gds-list where temp-gds-list.gds-code = gds-obj.gds-code) Then do:
     3032                       find first goods no-lock  where goods.gds-code  = gds-obj.gds-code .
     3033                       Create temp-gds-list.
     3034                       Assign
     3035                         temp-gds-list.prod-code = gds-obj.prod-code
     3036                         temp-gds-list.grp-name  = gds-obj.grp-name
     3037                         temp-gds-list.gds-name  = goods.gds-name
     3038                         temp-gds-list.gds-code  = gds-obj.gds-code
     3039                         temp-gds-list.artic     = gds-obj.artic
     3040                       .
     3041                   End.
     3042               End.
     3043     End.
     3044     for each temp-gds-list no-lock
     3045       , First goods     where goods.gds-code  = temp-gds-list.gds-code no-lock
     3046         BREAK
     3047   BY (temp-gds-list.grp-name)
     3048       BY temp-gds-list.gds-code :
