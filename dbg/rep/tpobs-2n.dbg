     3351   procedure lavel1 :
     3352                 case select-good :
     3353                     when 1  then do:
     3354       define buffer buf_obj-list26 for obj-list.
     3355     for each buf_obj-list26 no-lock :
     3356         if xtog-obj and  not (buf_obj-list26.obj-type = x-store-type  and
     3357                               buf_obj-list26.obj-code = x-store-code )
     3358         then next.
     3359           for  each gds-obj   where
     3360                               gds-obj.obj-type = buf_obj-list26.obj-type    and
     3361                               gds-obj.obj-code = buf_obj-list26.obj-code
     3362                               and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     3363                               no-lock ,
     3364           first goods where gds-obj.gds-code  = goods.gds-code
     3365                               no-lock :
     3366               if not can-find(first temp-gds-list where temp-gds-list.gds-code = gds-obj.gds-code) then do:
     3367                   create temp-gds-list.
     3368                   assign
     3369                     temp-gds-list.prod-code = gds-obj.prod-code
     3370                     temp-gds-list.grp-name  = ""
     3371                     temp-gds-list.gds-code  = gds-obj.gds-code
     3372                     temp-gds-list.artic     = gds-obj.artic
     3373                     temp-gds-list.gds-name  = goods.gds-name
     3374                     .
     3375                     temp-gds-list.grp-name  = n-lavel(input gds-obj.grp-name, input xlavel )
     3376                     .
     3377               end.
     3378           end.
     3379    end.
     3380     for each temp-gds-list no-lock
     3381       , first goods  where goods.gds-code  = temp-gds-list.gds-code no-lock
     3382         break
     3383           by  temp-gds-list.grp-name
     3384           by temp-gds-list.gds-code :
     3385           str = n-lavel(input goods.grp-name, input xlavel ) no-error .
     3386   find clients where clients.obj-type = goods.prod-type and
     3387                      clients.obj-code = goods.prod-code no-lock .
     3388     assign
     3389         gds-zap-unit-base  = goods.unit-base
     3390         gds-zap-prt-root   = goods.prt-root
     3391         gds-zap-prod-type  = goods.prod-type
     3392         gds-zap-prod-code  = goods.prod-code
     3393         gds-zap-artic      = goods.artic
