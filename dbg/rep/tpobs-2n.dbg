     3871   procedure display-title :
     3872   define variable v-nn as integer   no-undo .
     3873      PUT stream  OutStream  UNFORMATTED  string( v-cntxt-host-name-obj +  " , " + x-store-type  +  " " + objname) at 50 format "x(85)" skip(2)
     3874             reportname  at 20 format "x(170)" skip
     3875             trim(str1)  at 35 format "x(75)" skip.
     3876        v-nn = num-entries(str2,chr(10)) .
     3877        repeat i = 1 to v-nn :
     3878         PUT stream  OutStream  UNFORMATTED  entry(i,str2,chr(10))  at 1 format "x(170)" skip.
     3879        end.
     3880       i=0.
     3881        PUT stream  OutStream  UNFORMATTED  trim(str3)  at 35 format "x(75)" skip.
     3882        v-nn = num-entries(str4,chr(10)) .
     3883        repeat i = 1 to v-nn:
     3884          PUT stream  OutStream  UNFORMATTED  entry(i,str4,chr(10))  at 1 format "x(170)" skip.
     3885        end.
     3886       i=0.
     3887        v-nn = num-entries( reportheader,chr(10)) .
     3888        repeat i = 1 to v-nn :
     3889         PUT stream  OutStream  UNFORMATTED  entry(i,reportheader,chr(10))  at 1 format "x(170)" skip.
     3890        end.
     3891       i=0.
     3892       run rep/extitle.p (1) .
     3893   end procedure.
     3894   procedure report-exec1  :
     3895      find first clients where x-store-type = clients.obj-type and
     3896                               x-store-code = clients.obj-code no-lock no-error.
     3897     run calcitog.
     3898     run print-header.
     3899      case retclassify :
     3900         when "grp-goods":u then      run run2 in this-procedure .
     3901         otherwise do:
     3902           message "error" view-as alert-box error .
     3903         end.
     3904      end case.
     3905     run print-footer.
     3906     end procedure.
     3907   procedure calc-sub-itog :
     3908   define variable b  as int no-undo.
     3909   assign
     3910     b1-gds-zap-other = b1-gds-zap-other +  gds-zap-other
     3911     b2-gds-zap-other = b2-gds-zap-other +  gds-zap-other
     3912     bi-gds-zap-other = bi-gds-zap-other +  gds-zap-other
     3913     bo-gds-zap-other = bo-gds-zap-other +  gds-zap-other
     3914     .
     3915   repeat b = 1 to 20 :
     3916     assign
     3917     b1-ostatok-start[b ]    = b1-ostatok-start[b ]    +  ostatok-start[b ]
     3918     b1-ostatok-end  [b ]    = b1-ostatok-end  [b ]    +  ostatok-end  [b ]
     3919     b2-ostatok-start[b ]    = b2-ostatok-start[b ]    +  ostatok-start[b ]
     3920     b2-ostatok-end  [b ]    = b2-ostatok-end  [b ]    +  ostatok-end  [b ]
     3921     bi-ostatok-start[b ]    = bi-ostatok-start[b ]    +  ostatok-start[b ]
     3922     bi-ostatok-end  [b ]    = bi-ostatok-end  [b ]    +  ostatok-end  [b ]
     3923     bo-ostatok-start[b ]    = bo-ostatok-start[b ]    +  ostatok-start[b ]
     3924     bo-ostatok-end  [b ]    = bo-ostatok-end  [b ]    +  ostatok-end  [b ]
     3925     b1-prih[b ]    = b1-prih[b ]    +  prih[b ]
     3926     b2-prih[b ]    = b2-prih[b ]    +  prih[b ]
     3927     bi-prih[b ]    = bi-prih[b ]    +  prih[b ]
     3928     bo-prih[b ]    = bo-prih[b ]    +  prih[b ]
     3929     b1-rash[b ]    = b1-rash[b ]    +  rash[b ]
     3930     b2-rash[b ]    = b2-rash[b ]    +  rash[b ]
     3931     bi-rash[b ]    = bi-rash[b ]    +  rash[b ]
     3932     bo-rash[b ]    = bo-rash[b ]    +  rash[b ]
     3933     b1-kassa[b ]    = b1-kassa[b ]    +  kassa[b ]
     3934     b2-kassa[b ]    = b2-kassa[b ]    +  kassa[b ]
     3935     bi-kassa[b ]    = bi-kassa[b ]    +  kassa[b ]
     3936     bo-kassa[b ]    = bo-kassa[b ]    +  kassa[b ]
     3937     b1-inv[b ]    = b1-inv[b ]    +  inv[b ]
     3938     b2-inv[b ]    = b2-inv[b ]    +  inv[b ]
     3939     bi-inv[b ]    = bi-inv[b ]    +  inv[b ]
     3940     bo-inv[b ]    = bo-inv[b ]    +  inv[b ]
     3941     b1-overturn[b ]    = b1-overturn[b ]    +  overturn[b ]
     3942     b2-overturn[b ]    = b2-overturn[b ]    +  overturn[b ]
     3943     bi-overturn[b ]    = bi-overturn[b ]    +  overturn[b ]
     3944     bo-overturn[b ]    = bo-overturn[b ]    +  overturn[b ]
     3945     .
     3946   end.
     3947   end procedure.
