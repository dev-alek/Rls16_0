     1091   define variable vss-include-info13 as character format "X(65)" no-undo
     1092   initial "@(#)$Workfile$ $Revision$".
     1093   procedure grplib-get-full-name :
     1094      define input parameter p-node-code  as integer      no-undo.
     1095      define output parameter p-full-name as character    no-undo.
     1096      do
     1097   on error undo, return error
     1098   :
     1099       define variable v-upper-code    as integer           no-undo.
     1100       define buffer buf_gds-grp       for ub.gds-grp.
     1101       define buffer buf_upper_gds-grp for ub.gds-grp.
     1102       find first buf_gds-grp no-lock
     1103            where buf_gds-grp.node-code = p-node-code
     1104       no-error.
     1105       if not available buf_gds-grp
     1106       then do:
     1107           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     1108       end.
     1109       assign
     1110           p-full-name  = ""
     1111           v-upper-code = 1
     1112       .
     1113       do while buf_gds-grp.upper-code <> 0
     1114       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     1115       :
     1116           assign
     1117               p-full-name  = buf_gds-grp.node-name
     1118                            + (if p-full-name <> "" then chr(47) else "")
     1119                            + p-full-name
     1120               v-upper-code = buf_gds-grp.upper-code
     1121           .
     1122           find first buf_gds-grp no-lock
     1123                where buf_gds-grp.node-code = v-upper-code
     1124           no-error.
     1125           if not available buf_gds-grp
     1126           then do:
     1127               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
     1128                                   + string( v-upper-code )
     1129                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     1130           end.
     1131       end.
     1132       assign
     1133       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     1134       .
     1135   end.
     1136   end .
     1137   procedure grplib-get-node-from-full-name :
     1138   define input parameter p-full-name as character no-undo .
     1139   define output parameter p-node-code as integer no-undo .
     1140   define variable v-ii as integer no-undo .
     1141   define variable v-upper-code as integer no-undo .
     1142   define variable v-root-code as integer no-undo .
     1143   define variable v-entry as character no-undo .
     1144   define buffer buf_gds-grp       for ub.gds-grp.
     1145   do
     1146   on error undo, return error
     1147   :
     1148     find first buf_gds-grp no-lock
     1149         where buf_gds-grp.upper-code = 0
     1150     no-error .
     1151     if not available buf_gds-grp
     1152     then do:
     1153         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
     1154     end.
     1155     else do:
     1156       assign
     1157       v-root-code = buf_gds-grp.node-code
     1158       .
     1159     end.
     1160     v-upper-code = v-root-code.
     1161     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     1162       assign
     1163       v-entry = entry(v-ii, p-full-name, chr(47)).
     1164       if v-entry = '' then leave.
     1165       find first buf_gds-grp no-lock where
     1166                 buf_gds-grp.node-name = v-entry
     1167             and buf_gds-grp.upper-code = v-upper-code
     1168             no-error.
     1169       if not available buf_gds-grp then do:
     1170         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     1171       end.
     1172       else do:
     1173         p-node-code = buf_gds-grp.node-code.
     1174         v-upper-code = buf_gds-grp.node-code.
     1175       end.
     1176     end.
     1177   end.
     1178   end .
     1179   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1180   define variable v-waitfram-action01         as character   no-undo .
     1181   define variable v-waitfram-action02         as character   no-undo .
     1182   define variable v-waitfram-action03         as character   no-undo .
     1183   define variable mWaitFramTextBeg            as character   no-undo.
     1184   define variable mWaitFramTextEnd            as character   no-undo.
     1185   define variable mWaitFramView               as logical     no-undo.
     1186   define variable mWaitProcEvent              as logical     no-undo init yes.
     1187   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1188   define variable mWaitFramStop               as logical     no-undo.
     1189   define variable mWaitFramStopUser           as logical     no-undo.
     1190   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1191   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1192   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1193   define button B-WaitFramStop auto-end-key
     1194        label "Стоп"
     1195        size 10 by 1 tooltip "Остоновить процесс".
     1196   define button B-viewProcInfo
     1197        label "Информация"
     1198        size 15 by 1 tooltip "Информация о процесс".
     1199   define frame waitfram
     1200     v-waitfram-action01 format "x(72)" no-label skip
     1201     v-waitfram-action02 format "x(72)" no-label skip
     1202     v-waitfram-action03 format "x(72)" no-label skip
     1203     B-viewProcInfo
     1204     B-WaitFramStop at row 4 col 30
     1205     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1206     .
     1207   define new global shared variable mBatchMode as logical no-undo init ?.
     1208   define variable mFramBachModHandle as handle no-undo.
     1209   mFramBachModHandle = frame waitfram:handle.
     1210   define variable mFameOldVis as logical no-undo.
     1211   define variable mVisCUrentVin as logical no-undo.
     1212   if session:batch-mode
     1213   then
     1214      mBatchMode = yes.
     1215   if mBatchMode = ? then do:
     1216     mVisCUrentVin = current-window:visible.
     1217     mFameOldVis = mFramBachModHandle:visible.
     1218     mFramBachModHandle:visible  = yes.
     1219     mBatchMode = mFramBachModHandle:visible ne yes.
     1220     mFramBachModHandle:visible = mFameOldVis.
     1221     current-window:visible = mVisCUrentVin.
     1222   end.
     1223    if  log-manager:logfile-name ne ?
     1224     then DO:
     1225         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1226         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1227         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1228     end.
     1229   on choose of B-WaitFramStop in frame waitfram
     1230   do:
     1231     mWaitFramStop = yes.
     1232     mWaitFramStopUser = yes.
     1233   end.
     1234   function waitfram-check-timeout returns logical():
     1235      define variable vtime as int64 no-undo.
     1236      if mWaitFramStopTimeOut
     1237      then
     1238         return yes.
     1239      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1240      if     mWaitFramTimeOut ne ?
     1241         and mWaitFramTimeOut ne 0
     1242         and mWaitFramTimeOut lt vtime
     1243      then do:
     1244         mWaitFramStopTimeOut = yes.
     1245      end.
     1246      return mWaitFramStopTimeOut.
     1247   end.
     1248   procedure waitfram-hide :
     1249     if not session:batch-mode
     1250     then do
     1251     on error undo, return error return-value
     1252     :
     1253       pause 0 before-hide .
     1254       if not mBatchMode then
     1255         hide frame waitfram .
     1256     if     not mWaitFramView
     1257        and mWaitProcEvent
     1258     then
     1259       process events .
     1260     end.
     1261   end procedure.
     1262   procedure waitfram-show :
     1263     define input  parameter p-message as character no-undo .
     1264     define variable v-left-margin as integer   no-undo .
     1265     if not session:batch-mode
     1266     then do
     1267     on error undo, return error return-value
     1268     :
     1269       if length(p-message) <= 70 then do:
     1270         assign
     1271           v-left-margin = integer((70 - length(p-message)) / 2)
     1272         .
     1273         assign
     1274           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1275         .
     1276         assign
     1277           v-waitfram-action01 = " "
     1278           v-waitfram-action02 = " "
     1279                                    + fill(" ", v-left-margin)
     1280                                    + p-message
     1281           v-waitfram-action03 = " "
     1282         .
     1283       end.
     1284       else do:
     1285         define variable vRindex1 as integer no-undo.
     1286         define variable vRindex2 as integer no-undo.
     1287         vRindex1 = r-index(p-message," ",70).
     1288         if vRindex1 = 0
     1289         then
     1290            vRindex1 = 70.
     1291         if length(p-message)  <= vRindex1 + 70 then do:
     1292           assign
     1293             v-waitfram-action01 = " "
     1294             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1295             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1296           .
     1297         end.
     1298         else do:
     1299           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1300           if vRindex2 <= vRindex1
     1301           then
     1302              vRindex2 = vRindex1 + 70.
     1303           assign
     1304             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1305             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1306             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1307           .
     1308         end.
     1309       end.
     1310       B-viewProcInfo:visible   in frame waitfram = no.
     1311       B-viewProcInfo:sensitive in frame waitfram = no.
     1312       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1313       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1314       if  (   mWaitFramView
     1315          or  mWaitProcEvent)
     1316          and not mBatchMode
     1317       then
     1318          display
     1319             v-waitfram-action01 skip
     1320             v-waitfram-action02 skip
     1321             v-waitfram-action03 skip
     1322          with frame waitfram .
     1323       if     mWaitFramView
     1324          then do:
     1325             if     mWaitFramInterval ne ?
     1326                and not mBatchMode
     1327             then
     1328                wait-for go of frame waitfram pause mWaitFramInterval.
     1329          end.
     1330          else
     1331             if     mWaitProcEvent
     1332                and not mBatchMode
     1333             then
     1334                process events .
     1335     end.
     1336   end procedure.
     1337      procedure waitfram-show-this:
     1338         define input  parameter iInterval as int64 no-undo.
     1339         define variable vtime as int64 no-undo.
     1340         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1341         mWaitFramInterval = iInterval.
     1342         run waitfram-show (substitute("&1&2 &3&4" ,
     1343                                       mWaitFramTextBeg ,
     1344                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1345                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1346                                       mWaitFramTextEnd
     1347                                      )
     1348                           ).
     1349      end.
     1350      procedure WaitFramRunPause:
     1351         define input  parameter iInterval as dec no-undo.
     1352         define variable vStart  as datetime-tz no-undo.
     1353         define variable vend    as datetime-tz no-undo.
     1354         define variable vint as int64 no-undo.
     1355         define variable vOk as logical no-undo.
     1356         vStart = now.
     1357         vend   = vStart.
     1358         publish "WaitFramPause" (iInterval,output vOk).
     1359         vend   =  now.
     1360         vint = vend - vStart.
     1361         vint = iInterval - vint / 1000.
     1362         if     not mWaitFramStop
     1363            and (   vint > 0
     1364                 or (    not vOk
     1365                     and iInterval eq ?
     1366                     )
     1367                 )
     1368         then
     1369            run waitfram-show-this (iInterval).
     1370         vend   =  now.
     1371         vint = vend - vStart.
     1372         vint = iInterval - vint / 1000.
     1373         if     not mWaitFramStop
     1374            and vint > 0
     1375         then do:
     1376            run gbl/pause.p (vint * 1000).
     1377         end.
     1378         if iInterval ne ?
     1379         then
     1380            publish "WaitFramStop".
     1381         waitfram-check-timeout().
     1382      end.
     1383      procedure WaitFramWaitFor:
     1384         define input  parameter iInterval as dec no-undo.
     1385         assign
     1386            mWaitFramStartProc   = now
     1387            mWaitFramStopUser    = no
     1388            mWaitFramStopTimeOut = no
     1389         .
     1390         block-wait:
     1391         do while not mWaitFramStop:
     1392            run WaitFramRunPause (iInterval).
     1393            if  waitfram-check-timeout()
     1394            then do:
     1395               leave block-wait.
     1396            end.
     1397         end.
     1398         run waitfram-hide.
     1399      end.
     1400   procedure waitfram-join :
     1401     define input  parameter p-line-1  as character no-undo .
     1402     define input  parameter p-line-2  as character no-undo .
     1403     define input  parameter p-line-3  as character no-undo .
     1404     define output parameter p-message as character no-undo .
     1405     do
     1406     on error undo, return error return-value
     1407     :
     1408       assign
     1409         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1410                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1411                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1412       .
     1413     end.
     1414   end procedure.
     1415   function waitfram-join-function returns character
     1416     (input p-line-1 as character
     1417     ,input p-line-2 as character
     1418     ,input p-line-3 as character
     1419     ).
     1420     define variable v-message as character no-undo .
     1421     run waitfram-join in this-procedure
     1422       (input  p-line-1
     1423       ,input  p-line-2
     1424       ,input  p-line-3
     1425       ,output v-message
     1426       ) .
     1427     return v-message .
     1428   end function .
