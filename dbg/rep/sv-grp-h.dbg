      463   procedure prn-lib-reportviewer :
      464     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      465     define input parameter p-report-name-html as character no-undo .
      466     define input parameter p-param        as character no-undo .
      467     define variable v-excel           as character no-undo init 'TRUE' .
      468     define variable v-value-character as character no-undo .
      469     define variable v-value-integer   as character no-undo .
      470     define variable v-value-date      as date      no-undo .
      471     define variable v-value-decimal   as decimal   no-undo .
      472     define variable rep-excel         as logical   no-undo .
      473     define variable excel-string      as character no-undo .
      474     define variable v-param-type      as character no-undo .
      475     define variable v-tth             as handle    no-undo .
      476     run adm/shattri.p (
      477       input "get":U
      478       ,input  ""
      479       ,input  0
      480       ,input  'report-glob':U
      481       ,input  'rep-excel':U
      482       ,output v-value-character
      483       ,output v-value-date
      484       ,output v-value-decimal
      485       ,output v-value-integer
      486       ,output rep-excel
      487       ,output v-param-type
      488       ,INPUT-OUTPUT table-handle v-tth
      489       )  .
      490     if rep-excel then v-excel = "TRUE" .
      491     else v-excel = "FALSE" .
      492     if p-param eq ""
      493     then
      494        p-param = "EXCEL:" + v-excel.
      495     else
      496        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      497     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      498   end procedure.
