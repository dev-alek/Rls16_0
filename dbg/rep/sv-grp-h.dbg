     1529        v-r-col-num = v-r-col-num + 1
     1530        .
     1531     end.
     1532   Assign l-col-type="CHARACTER" l-col-len=44 l-col-format= "X(44)"
     1533   l-col-lable = (if method = "line"
     1534   then "Группа товаров ( по классификатору )"
     1535   else "ВИд платежа")
     1536   .
     1537     define variable ed2 as handle no-undo.
