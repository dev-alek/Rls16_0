     1012   run gbl/getlocal.p (
     1013                     output v-dec-sep
     1014                    ,output v-th-sep
     1015                    ,output v-sdate
     1016                    ,output v-shortdate
     1017                    ) no-error .
     1018   assign
     1019   v-reg-replace = NOT (v-dec-sep = ".":U and v-th-sep = chr(44))
     1020                   AND (v-dec-sep <> ? and v-th-sep <> ?)
     1021   .
     1022     FUNCTION supress-null RETURNS CHARACTER ( INPUT p-string  AS CHARACTER,
     1023                                               INPUT p-dec-sep AS CHARACTER  ) :
     1024       DEFINE VARIABLE v-string AS CHARACTER NO-UNDO.
     1025       IF TRIM( p-string ) = "0"                    OR
     1026          TRIM( p-string ) = "0" + p-dec-sep + "00" OR
     1027          TRIM( p-string ) =       p-dec-sep + "00" OR
     1028          TRIM( p-string ) =       p-dec-sep + "0"  OR
     1029          TRIM( p-string ) = "0" + p-dec-sep + "0"  THEN DO: ASSIGN v-string = "":U.     END.
     1030                                                    ELSE DO: ASSIGN v-string = p-string. END.
     1031       RETURN ( TRIM( v-string ) ).
     1032     END FUNCTION.
     1033   FUNCTION reg-output returns character( input p-string as character
     1034                                         ,input p-private-data as character
     1035                                         ,input p-replace as logical
     1036                                         ,input p-supress as logical
     1037                                         ,input p-dec-sep as character
     1038                                         ,input p-th-sep as character
     1039                                         ):
     1040   DEFINE VARIABLE v-reg-output as character no-undo .
     1041   DEFINE VARIABLE v-data-type as character no-undo .
     1042   DEFINE VARIABLE v-progress-format as character no-undo .
     1043   assign
     1044   v-progress-format = entry(1, p-private-data, chr(4))
     1045   v-data-type = entry(2, p-private-data, chr(4))
     1046   .
     1047   if p-string = ? then return chr(63).
     1048   if (v-data-type = "INTEGER"
     1049       OR v-data-type = "DECIMAL" ) THEN DO:
     1050     IF p-replace THEN DO:
     1051       assign
     1052         v-reg-output = replace( p-string
     1053                                         ,chr(44)
     1054                                         ,"":U
     1055                                       )
     1056         v-reg-output = trim(v-reg-output)
     1057       .
     1058     END.
     1059     else do:
     1060       v-reg-output = p-string.
     1061     end.
     1062     IF p-supress THEN DO: ASSIGN v-reg-output = supress-null( TRIM( v-reg-output ), p-dec-sep ). END.
     1063     return v-reg-output.
     1064   end.
     1065     return p-string.
     1066   END FUNCTION.
     1067   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
