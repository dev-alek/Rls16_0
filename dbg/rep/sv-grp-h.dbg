     1481      with width 232 down stream-io use-text NO-BOX.
     1482   CREATE WIDGET-POOL "My-pool" PERSISTENT no-error .
     1483   l-col-pos = 1.
     1484   Assign l-col-type="CHARACTER" l-col-len=1  l-col-format="X(1)"       l-col-lable=":".
     1485     define variable ed1 as handle no-undo.
