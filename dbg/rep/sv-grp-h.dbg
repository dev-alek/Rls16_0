      319   define  stream PrnLibStream.
      320   procedure prn-lib-prn-file :
      321     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      322     define input parameter p-DIsabledoptions as integer no-undo .
      323     define variable v-report-name as character no-undo .
      324     define variable v-user-action as character no-undo .
      325     define variable v-printed     as logical   no-undo .
      326     define variable v-exist       as logical   no-undo .
      327     do
      328       on error undo, return error
      329       :
      330       run prn-lib-get-report-name  in this-procedure (
      331         input parParentProc
      332         ,output v-report-name
      333         ).
      334   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      335   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      336     (input  v-report-name
      337     ,input  2
      338     ,output v-exist
      339     )  .
      340       if NOT v-exist then
      341       DO:
      342         Message
      343           "Нет заданий на печать ! "
      344           view-as alert-box .
      345         Return  .
      346       End.
      347       run gbl/prnfilen.w
      348         (input  ""
      349         ,input  p-DisabledOptions
      350         ,input  string(v-report-name )
      351         ,input  7
      352         ,output v-user-action
      353         ,output v-printed
      354         ) .
      355       if v-printed then
      356       do:
      357         return "YES" .
      358       end.
      359       else
      360       do:
      361         return "NO" .
      362       end.
      363     end.
      364   end procedure.
      365   procedure prn-lib-open-stream :
      366     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      367     define input parameter p-page-size    as integer no-undo .
      368     define input parameter p-is-stream    as logical no-undo .
      369     define input parameter p-append       as logical no-undo .
      370     define variable v-report-name as character no-undo .
      371     do
      372       on error undo, return error
      373       :
      374       run prn-lib-get-report-name  in this-procedure (
      375         input parParentProc
      376         ,output v-report-name
      377         ).
      378       if p-is-stream then
      379       do:
      380         if p-append then
      381         do:
      382           output stream PrnLibStream to value( v-report-name )
      383             page-size value(p-page-size) append .
      384         end.
      385         if not p-append then
      386         do:
      387           output stream PrnLibStream to value( v-report-name )
      388             page-size value(p-page-size) .
      389         end.
      390       end.
      391       if not p-is-stream then
      392       do:
      393         if p-append then
      394         do:
      395           output to value( v-report-name )
      396             page-size value(p-page-size) append .
      397         end.
      398         if not p-append then
      399         do:
      400           output to value( v-report-name )
      401             page-size value(p-page-size) .
      402         end.
      403       end.
      404     end.
      405   end procedure.
      406   procedure prn-lib-open-exp :
      407     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      408     define input parameter p-is-stream    as logical no-undo .
      409     define input parameter p-is-append    as logical no-undo .
      410     define output parameter p-ReportFileName as char init "report" no-undo.
      411     define output parameter p-process as logical no-undo .
      412     define variable glog as logical no-undo .
      413     do
      414       on error undo, return error
      415       :
      416       SYSTEM-DIALOG GET-FILE p-ReportFileName
      417         TITLE      "Укажите путь"
      418         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      419         ASK-OVERWRITE
      420         CREATE-TEST-FILE
      421         SAVE-AS
      422         USE-FILENAME
      423         DEFAULT-EXTENSION "txt"
      424         UPDATE glog
      425         .
      426       if not glog then  return.
      427       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      428       if p-is-stream then
      429       do:
      430         if p-is-append then
      431         do:
      432           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      433         end.
      434         else
      435         do:
      436           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      437         end.
      438       end.
      439       else
      440       do:
      441         if p-is-append then
      442         do:
      443           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      444         end.
      445         else
      446         do:
      447           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      448         end.
      449       end.
      450       p-process = yes.
      451     end.
      452   end procedure.
      453   procedure prn-lib-get-report-name :
      454     define input parameter parParentProc  as widget-handle no-undo.
      455     define output parameter p-report-name as character no-undo .
      456     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      457   end procedure.
      458   procedure prn-lib-reportviewer-report-name :
      459     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      460     define input parameter p-report-name-html as character no-undo .
      461     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
