     3030     if use-column[19]
     3031     then  C-num-chk16:screen-value = string(fill11).
     3032     if use-column[20]
     3033     then  C-num-chk17:screen-value = string(fill11).
     3034     if use-column[21]
     3035     then  C-num-chk18:screen-value = string(fill11).
     3036     if use-column[22]
     3037     then  C-num-chk19:screen-value = string(fill11).
     3038     if use-column[23]
     3039     then  C-num-chk20:screen-value = string(fill11).
     3040     if use-column[24]
     3041     then  C-num-chk21:screen-value = string(fill11).
     3042     if use-column[25]
     3043     then  C-num-chk22:screen-value = string(fill11).
     3044     if use-column[26]
     3045     then  C-num-chk23:screen-value = string(fill11).
     3046     if use-column[27]
