      572   procedure create_obj-list :
      573      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      574      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      575      do
      576      on error undo, return error return-value
      577      :
      578         define buffer cli-obj for ub.clients .
      579         define variable p-var as integer no-undo .
      580         define buffer buf_obj-list for obj-list .
      581         find last buf_obj-list  use-index pi no-error .
      582         if available buf_obj-list
      583         then
      584            p-var = buf_obj-list.obj-id + 1.
      585         else
      586            p-var = 1.
      587         find first cli-obj where
      588                   cli-obj.obj-type = p-obj-type
      589               and cli-obj.obj-code = p-obj-code
      590         no-lock no-error.
      591         if available cli-obj
      592         then do:
      593            create buf_obj-list.
      594            assign
      595               buf_obj-list.obj-id   = p-var
      596               buf_obj-list.obj-code = cli-obj.obj-code
      597               buf_obj-list.obj-type = cli-obj.obj-type
      598               buf_obj-list.obj-name = cli-obj.obj-name
      599               buf_obj-list.db-num   = cli-obj.db-num
      600            .
      601         end.
      602      end.
      603   end.
      604   define  shared temp-table X-init_obj-list no-undo
      605   field obj-type like ub.clients.obj-type
      606   field obj-code like ub.clients.obj-code
      607   index pi is unique primary obj-type obj-code.
