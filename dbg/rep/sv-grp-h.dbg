     3048     if use-column[28]
     3049     then  C-tot-nc:screen-value = string(fill11).
     3050           DISPLAY stream  PrnLibStream with frame HOUR.       DOWN 1 stream PrnLibStream with frame HOUR.
     3051       assign
     3052       accum-count = 0
     3053       tot-nc = 0
     3054       accum-num-chk[1] =  0
     3055       accum-num-chk[2] =  0
     3056       accum-num-chk[3] =  0
