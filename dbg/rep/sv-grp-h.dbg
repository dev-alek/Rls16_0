     2880   Line = fill( "-" , 60 ) .
     2881   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2882   define buffer tot_full-grp for full-grp.
     2883   for each obj-list no-lock:
     2884     assign
     2885     accum-obj-list = accum-obj-list + 1.
     2886     if accum-obj-list > 1 then LEAVE.
     2887   end.
     2888   CASE method:
     2889     when "LINE":U then do:
     2890       run waitfram-show in this-procedure ("Строю дерево групп ...").
     2891       for each ub.gds-grp no-lock:
     2892         find first for-grp where
     2893                   for-grp.upper-code = ub.gds-grp.node-code No-LOCK No-ERROR.
     2894         if not avail for-grp then do:
     2895           create full-grp.
     2896           assign
     2897           full-grp.grp-code = ub.gds-grp.node-code.
     2898           if tree then
     2899           run grplib-get-full-name in this-procedure(input ub.gds-grp.node-code, output full-grp.full-name).
     2900           else
     2901           full-grp.full-name = ub.gds-grp.node-name.
     2902           full-grp.full-name = replace(full-grp.full-name, " ", "_").
     2903         end.
     2904       end.
     2905       run waitfram-hide in this-procedure .
     2906     end.
     2907     when "pay":U then do:
     2908       for each ub.cash-pay No-LOCK:
     2909         create full-grp.
     2910         assign
     2911         full-grp.grp-code = ub.cash-pay.cdpay-code
     2912         full-grp.other-code = ub.cash-pay.curr-code
     2913         .
     2914         FIND FIRST ub.currency No-LOCK WHERE
     2915                   ub.currency.curr-code = ub.cash-pay.curr-code no-error.
     2916         full-grp.full-name = substitute("&1_Валюта_&2"
     2917                                         , ub.cash-pay.obj-name
     2918                                         ,(if available ub.currency
     2919                                           then ub.currency.curr-abbr
     2920                                           else string(ub.cash-pay.curr-code))).
     2921       end.
     2922     end.
     2923   END CASE.
     2924   if nc > 15 then do:
     2925     run prn-lib-open-stream  in this-procedure (
     2926                                                 input parParentProc
     2927                                                 ,input 62
     2928                                                 ,input yes
     2929                                                 ,input no
     2930                                                 ).
     2931   end.
     2932   else do:
     2933     run prn-lib-open-stream  in this-procedure (
     2934                                                 input parParentProc
     2935                                                 ,input 43
     2936                                                 ,input yes
     2937                                                 ,input no
     2938                                                 ).
     2939   end.
     2940   FORM with FRAME Hour .
     2941   FORM HEADER
     2942   Line format "X(60)" AT 1 SKIP
     2943   string( "Продолжение - на следующей странице" ) FORMAT "X(40)" AT 10 SKIP
     2944   with FRAME NBottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     2945   VIEW stream PrnLibStream FRAME NBottomFrame .
     2946   PUT stream PrnLibStream
     2947   SPACE(10)
     2948   "Почасовая статистика розничных продаж" format "x(80)" SKIP(0)
     2949   ("( ПО ВЕЛИЧИНЕ СУММ ПРОДАЖ - СТРОКИ ЧЕКОВ) ЗА ПЕРИОД c " +
     2950   string( startdate, "99/99/9999" ) + " по " +
     2951   string( enddate, "99/99/9999" ) + ".")      format "x(80)" SKIP(0)
     2952   (IF RETS
     2953   then "ВОЗВРАТЫ УЧТЕНЫ"
     2954   ELSE "") format "x(80)" SKIP(0).
     2955   if t-dis-card then do:
     2956     PUT stream PrnLibStream UNFORMATTED
     2957     SPACE(10)
     2958     "Только покупки по дисконтным картам" skip.
     2959     if rs-dis-card = 1 then do:
     2960       for each temp-dis-card-type No-LOCK:
     2961         PUT stream PrnLibStream UNFORMATTED
     2962         SPACE(10)
     2963         temp-dis-card-type.type
     2964         skip.
     2965       END.
     2966     end.
     2967   end.
     2968   PUT stream PrnLibStream UNFORMATTED
     2969   SPACE(10) trim( SelectObject )  skip(0)
     2970   (if byobject then "С разбивкой по объектам" else '':U) skip(1)
     2971   .
     2972   display STREAM PrnLibStream with frame top-Frame .
     2973   _cycle:
     2974   do cycle = 1 to 0 by -1:
     2975     if byobject and cycle = 0 and accum-obj-list = 1 then LEAVE _cycle.
     2976     _obj-list:
     2977     for each obj-list no-lock:
     2978       if not byobject and cycle = 1 then LEAVE _obj-list.
     2979       if cycle = 1 then v-obj-code = obj-list.obj-code.
     2980       if cycle = 0 then v-obj-code = 0.
     2981       if cycle = 1 then do:
     2982         FIND FIRST ub.clients NO-LOCK WHERE
     2983                   ub.clients.obj-code = v-obj-code AND
     2984                   ub.clients.obj-type = 'маг':U NO-ERROR.
     2985         if available ub.clients then do:
     2986           v-obj-name = ub.clients.obj-name.
     2987         end.
     2988         else v-obj-name = string(v-obj-code).
     2989       end.
     2990       if byobject and cycle = 0 then do:
     2991         v-obj-name = "ПО ВСЕМ ОБЪЕКТАМ".
     2992       end.
     2993     if use-column[1]
     2994     then  C-sym1:screen-value = string(sym1, entry(1, c-sym1:private-data, chr(4))).
     2995     if use-column[2]
     2996     then  C-full-name:screen-value = string(v-obj-name, entry(1, c-full-name:private-data, chr(4))).
     2997       DISPLAY stream  PrnLibStream with frame HOUR.                                      DOWN 1 stream PrnLibStream with frame HOUR.
     2998     if use-column[2]
     2999     then  C-full-name:screen-value = string(fill44).
     3000     if use-column[4]
     3001     then  C-num-chk1:screen-value = string(fill11).
     3002     if use-column[5]
     3003     then  C-num-chk2:screen-value = string(fill11).
     3004     if use-column[6]
     3005     then  C-num-chk3:screen-value = string(fill11).
