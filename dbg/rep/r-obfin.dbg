     1516   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     1517        LABEL "Обработано записей"
     1518         VIEW-AS TEXT
     1519        SIZE 14 BY .67 NO-UNDO.
     1520   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     1521         VIEW-AS TEXT
     1522        SIZE 53.25 BY .67
     1523        FGCOLOR 1  NO-UNDO.
     1524   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     1525         VIEW-AS TEXT
     1526        SIZE 53.25 BY .67
     1527        FGCOLOR 1  NO-UNDO.
     1528   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     1529         VIEW-AS TEXT
     1530        SIZE 53.25 BY .67
     1531        FGCOLOR 1  NO-UNDO.
     1532   DEFINE RECTANGLE RECT-1
     1533        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1534        SIZE 55.13 BY 4.46.
     1535   DEFINE FRAME InfoFrame
     1536        StopBtn AT ROW 4.25 COL 21.75
     1537        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     1538        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     1539        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     1540        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     1541        RECT-1 AT ROW 1 COL 1
     1542       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1543            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1544            TITLE "Процесс"
     1545            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     1546   define variable mFrameView      as logical   no-undo init yes.
     1547     define variable mFramHandle as handle no-undo.
     1548     mFramHandle = frame InfoFrame:handle.
     1549     if  log-manager:logfile-name ne ?
     1550     then DO:
     1551         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1552         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1553         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     1554     end.
     1555     mFrameView = not session:batch-mode and mFramHandle:visible.
     1556     if mFrameView
     1557     then do:
     1558       ASSIGN
     1559          FRAME InfoFrame:HIDDEN                           = TRUE
     1560          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     1561     end.
     1562   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     1563   DO:
     1564     IF not StopProcessing THEN
     1565       Message "Вы действительно хотите прервать" SKIP
     1566               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     1567                 UPDATE StopProcessing.
     1568     IF StopProcessing THEN do:
     1569        if mFrameView
     1570        then do:
     1571           HIDE FRAME InfoFrame.
     1572        end.
     1573     End.
     1574   END.
     1575   assign v-account = ( if integer( 10 ) = 0 then 100 else integer( 10 ) ).
     1576     if  log-manager:logfile-name ne ?
     1577     then DO:
     1578         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     1579     end.
     1580     if not session:batch-mode then
     1581     do:
     1582       VIEW FRAME InfoFrame.
     1583       mFrameView = true.
     1584     end.
     1585      v-button-stop = false .
     1586         if mFrameView
     1587         then do:
     1588         if v-button-stop then view STOPBTN in frame InfoFrame.
     1589                          else Hide STOPBTN in frame InfoFrame.
     1590         end.
     1591     define buffer buf_arh-fin-doc-schet   for arh-fin-doc-schet .
     1592     define buffer buf_arh-fin-doc-an      for arh-fin-doc-an .
