     1609     find first buf_fin-bank no-lock where buf_fin-bank.host-code = buf_fin-schet.host-code and buf_fin-bank.code-bank = buf_fin-schet.code-bank .
     1610     create temp-schet .
     1611     assign
     1612       temp-schet.r-schet = buf_fin-schet.r-schet
     1613       temp-schet.code    = buf_fin-schet.code-schet
     1614       temp-schet.curr    = buf_fin-schet.curr-code
     1615       temp-schet.s-curr  = buf_currency.curr-abbr
     1616       temp-schet.bank    = buf_fin-bank.short-name
