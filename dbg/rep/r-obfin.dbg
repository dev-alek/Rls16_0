     1703     run CalcOst (input 'ппп':U, input buf_fin-schet.curr-code, input v-fact-order-start, output sum1) .
     1704     assign temp-schet.sum1 = sum1 .
     1705     run CalcOst (input 'ппп':U, input 0, input v-fact-order-start, output sum1) .
