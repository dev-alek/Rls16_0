     1597     define buffer b_fin-code-cor-acc for fin-code-cor-acc .
     1598     if p-radio-schet <> 7 then assign p-curr-code = 0 .
     1599     case p-radio-schet :
     1600       when 7 or when 5 then do:
     1601         for each buf_fin-schet no-lock
     1602           where buf_fin-schet.host-code = v-cntxt-host-code-obj
     1603             and buf_fin-schet.cli-code  = v-cntxt-host-code-obj
     1604             and buf_fin-schet.cli-type  = 'орг':U
