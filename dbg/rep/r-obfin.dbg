     1266   procedure prn-lib-prn-file :
     1267     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1268     define input parameter p-DIsabledoptions as integer no-undo .
     1269     define variable v-report-name as character no-undo .
     1270     define variable v-user-action as character no-undo .
     1271     define variable v-printed     as logical   no-undo .
     1272     define variable v-exist       as logical   no-undo .
     1273     do
     1274       on error undo, return error
     1275       :
     1276       run prn-lib-get-report-name  in this-procedure (
     1277         input parParentProc
     1278         ,output v-report-name
     1279         ).
     1280   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1281   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     1282     (input  v-report-name
     1283     ,input  2
     1284     ,output v-exist
     1285     )  .
     1286       if NOT v-exist then
     1287       DO:
     1288         Message
     1289           "Нет заданий на печать ! "
     1290           view-as alert-box .
     1291         Return  .
     1292       End.
     1293       run gbl/prnfilen.w
     1294         (input  ""
     1295         ,input  p-DisabledOptions
     1296         ,input  string(v-report-name )
     1297         ,input  7
     1298         ,output v-user-action
     1299         ,output v-printed
     1300         ) .
     1301       if v-printed then
     1302       do:
     1303         return "YES" .
     1304       end.
     1305       else
     1306       do:
     1307         return "NO" .
     1308       end.
     1309     end.
     1310   end procedure.
     1311   procedure prn-lib-open-stream :
     1312     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1313     define input parameter p-page-size    as integer no-undo .
     1314     define input parameter p-is-stream    as logical no-undo .
     1315     define input parameter p-append       as logical no-undo .
     1316     define variable v-report-name as character no-undo .
     1317     do
     1318       on error undo, return error
     1319       :
     1320       run prn-lib-get-report-name  in this-procedure (
     1321         input parParentProc
     1322         ,output v-report-name
     1323         ).
     1324       if p-is-stream then
     1325       do:
     1326         if p-append then
     1327         do:
     1328           output stream PrnLibStream to value( v-report-name )
     1329             page-size value(p-page-size) append .
     1330         end.
     1331         if not p-append then
     1332         do:
     1333           output stream PrnLibStream to value( v-report-name )
     1334             page-size value(p-page-size) .
     1335         end.
     1336       end.
     1337       if not p-is-stream then
     1338       do:
     1339         if p-append then
     1340         do:
     1341           output to value( v-report-name )
     1342             page-size value(p-page-size) append .
     1343         end.
     1344         if not p-append then
     1345         do:
     1346           output to value( v-report-name )
     1347             page-size value(p-page-size) .
     1348         end.
     1349       end.
     1350     end.
     1351   end procedure.
     1352   procedure prn-lib-open-exp :
     1353     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1354     define input parameter p-is-stream    as logical no-undo .
     1355     define input parameter p-is-append    as logical no-undo .
     1356     define output parameter p-ReportFileName as char init "report" no-undo.
     1357     define output parameter p-process as logical no-undo .
     1358     define variable glog as logical no-undo .
     1359     do
     1360       on error undo, return error
     1361       :
     1362       SYSTEM-DIALOG GET-FILE p-ReportFileName
     1363         TITLE      "Укажите путь"
     1364         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     1365         ASK-OVERWRITE
     1366         CREATE-TEST-FILE
     1367         SAVE-AS
     1368         USE-FILENAME
     1369         DEFAULT-EXTENSION "txt"
     1370         UPDATE glog
     1371         .
     1372       if not glog then  return.
     1373       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     1374       if p-is-stream then
     1375       do:
     1376         if p-is-append then
     1377         do:
     1378           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1379         end.
     1380         else
     1381         do:
     1382           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1383         end.
     1384       end.
     1385       else
     1386       do:
     1387         if p-is-append then
     1388         do:
     1389           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1390         end.
     1391         else
     1392         do:
     1393           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1394         end.
     1395       end.
     1396       p-process = yes.
     1397     end.
     1398   end procedure.
