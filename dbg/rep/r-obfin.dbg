     2184   procedure is-page :
     2185     do
     2186     on error undo, return error return-value
     2187     :
     2188       if line-counter( PrnLibStream ) + 2 > page-size( PrnLibStream ) then do:
     2189         put stream PrnLibStream  skip Line format str skip "продолжение - на следующей странице" AT 30 SKIP .
     2190         page stream PrnLibStream .
