     2154   procedure prn-line :
     2155     do on error undo, return error return-value :
     2156       define input  parameter p-is-in as logical   no-undo .
     2157       run is-page in this-procedure .
     2158       put stream PrnLibStream   "|" string( (if temp-code.lavel2 <> 0 then " " else "" ) + (if temp-code.lavel3 <> 0 then " " else "" ) + temp-code.num + " " + temp-code.name)   format "X(40)" "|" at 42 .
     2159       assign
     2160         sum-rubl = 0
     2161         sum-base = 0
     2162         jj = 1
     2163       .
     2164       for each temp-schet :
     2165         find first  temp-sum where temp-sum.code-fin = temp-code.code and temp-sum.code-schet = temp-schet.code .
     2166         put stream PrnLibStream  (if p-is-in then temp-sum.sum-in else temp-sum.sum-out) format "->>>,>>>,>>>,>>>,>>9.99" "|" at ( 42 + 24 * jj ) .
     2167         assign
     2168           jj = jj + 1
     2169           sum-rubl = sum-rubl + (if p-is-in then temp-sum.sum-in-rubl else temp-sum.sum-out-rubl)
     2170           sum-base = sum-base + (if p-is-in then temp-sum.sum-in-base else temp-sum.sum-out-base)
     2171         .
     2172       end.
     2173       put stream PrnLibStream sum-rubl format "->>>,>>>,>>>,>>>,>>9.99" "|" at ( 42 + 24 * jj ) .
     2174       assign jj = jj + 1 .
     2175       put stream PrnLibStream sum-base format "->>>,>>>,>>>,>>>,>>9.99" "|" at ( 42 + 24 * jj ) skip .
     2176     end.
