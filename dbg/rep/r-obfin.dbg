     1746               and buf_arh-fin-doc-an.fact-order       <= v-fact-order-end
     1747           no-error .
     1748           if not available buf_arh-fin-doc-an then do:
     1749             if (p-nal or p-akt) then do:
     1750               find first buf_arh-fin-doc-an-nal no-lock
     1751                 where buf_arh-fin-doc-an-nal.host-code         = v-cntxt-host-code-obj
     1752                   and buf_arh-fin-doc-an-nal.fin-code-cor-acc  = fin-code-cor-acc.fin-code
     1753                   and buf_arh-fin-doc-an-nal.fact-order       >= v-fact-order-start
     1754                   and buf_arh-fin-doc-an-nal.fact-order       <= v-fact-order-end
     1755                 no-error .
     1756               if not available buf_arh-fin-doc-an-nal then next .
     1757             end.
     1758             else next .
     1759           end.
     1760           find first temp-code where temp-code.code = fin-code-cor-acc.fin-code no-error .
     1761           if not available temp-code then do:
     1762             create temp-code .
     1763             assign
     1764               temp-code.num    = fin-code-cor-acc.code-value
     1765               temp-code.name   = fin-code-cor-acc.descr
     1766               temp-code.code   = fin-code-cor-acc.fin-code
     1767               temp-code.lavel1 = fin-code-cor-acc.level-1
     1768               temp-code.lavel2 = fin-code-cor-acc.level-2
     1769               temp-code.lavel3 = fin-code-cor-acc.level-3
     1770             .
     1771           end.
     1772         end.
     1773       end.
     1774       when 2 then do:
     1775         for each fin-code-an-uchet no-lock where fin-code-an-uchet.host-code = v-cntxt-host-code-obj :
