     1713     run CalcOst (input 'рпп':U, input v-curr-r-b, input v-fact-order-start, output sum1) .
     1714     assign  ost-beg-base = ost-beg-base - sum1 .
     1715     run CalcOst (input 'ппп':U, input buf_fin-schet.curr-code, input v-fact-order-end, output sum1) .
     1716     assign temp-schet.sum2 = sum1 .
     1717     run CalcOst (input 'ппп':U, input 0, input v-fact-order-end, output sum1) .
     1718     assign  ost-end-rubl = ost-end-rubl + sum1 .
     1719     run CalcOst (input 'ппп':U, input v-curr-r-b, input v-fact-order-end, output sum1) .
     1720     assign  ost-end-base = ost-end-base + sum1 .
