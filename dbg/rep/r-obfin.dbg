     1014   procedure cur-time :
     1015      define output parameter p-today as date      no-undo .
     1016      define output parameter p-time  as integer   no-undo .
     1017     do
     1018     on error undo, return error
     1019     :
     1020       define variable v-date1 as date      no-undo .
     1021       define variable v-date2 as date      no-undo .
     1022       define variable v-time  as integer   no-undo .
     1023       assign
     1024         v-date1 = today
     1025         v-time  = time
     1026         v-date2 = today
     1027       .
     1028       if v-date1 <> v-date2
     1029       then do:
     1030         assign
     1031           v-date1 = today
     1032           v-time  = v-time
     1033         .
     1034       end.
     1035       assign
     1036         p-today = v-date1
     1037         p-time  = v-time
     1038       .
     1039     end.
     1040   end.
     1041   function cur-time-date returns character
     1042   :
     1043     return string(today, '99/99/9999':U) .
     1044   end.
     1045   function cur-time-mjd returns decimal
     1046   :
     1047     define variable v-date as date      no-undo .
     1048     define variable v-time as integer   no-undo .
     1049     run cur-time in this-procedure
     1050       (output v-date
     1051       ,output v-time
     1052       ) .
     1053     return integer(v-date) - 2400002 + (v-time / 86400) .
     1054   end.
     1055   function cur-time-get-ending-index returns integer
     1056   (input p-number as integer
     1057   )
     1058   :
     1059     if p-number < 0
     1060     or p-number = ?
     1061     then do:
     1062       return 1 .
     1063     end.
     1064     define variable v-rest as integer   no-undo .
     1065     assign
     1066       p-number = p-number modulo 100
     1067     .
     1068     if p-number < 20
     1069     then do:
     1070       assign
     1071         v-rest = p-number
     1072       .
     1073     end.
     1074     else do:
     1075       assign
     1076         v-rest = p-number modulo 10
     1077       .
     1078     end.
     1079     case v-rest :
     1080       when 1
     1081       then do:
     1082         return 2 .
     1083       end.
     1084       when 2 or
     1085       when 3 or
     1086       when 4
     1087       then do:
     1088         return 3 .
     1089       end.
     1090       otherwise do:
     1091         return 1 .
     1092       end.
     1093     end case .
     1094   end.
     1095   procedure cur-time-mjd-to-date :
     1096      define input  parameter i-mjd-diff as decimal no-undo.
     1097      define output parameter o-Date     as date    no-undo.
     1098      define output parameter o-Time     as integer no-undo.
     1099      define variable v-day-number as integer   no-undo .
     1100      if    i-mjd-diff < 0
     1101         or i-mjd-diff = ?
     1102      then do:
     1103         return "?" .
     1104      end.
     1105      assign
     1106         v-day-number = truncate(i-mjd-diff,0).
     1107         o-Date = date(v-day-number + 2400002).
     1108         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1109     .
     1110   end.
     1111   function cur-time-mjd-to-string returns character
     1112   (input p-mjd-diff as decimal
     1113   )
     1114   :
     1115     define variable v-day-number as integer   no-undo .
     1116     define variable v-seconds    as integer   no-undo .
     1117     define variable v-hour       as integer   no-undo .
     1118     define variable v-min        as integer   no-undo .
     1119     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1120     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1121     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1122     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1123     if p-mjd-diff < 0
     1124     or p-mjd-diff = ?
     1125     then do:
     1126       return "?" .
     1127     end.
     1128     assign
     1129       v-day-number = integer(truncate(p-mjd-diff,0))
     1130       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1131     .
     1132     if v-seconds > 86400
     1133     then do:
     1134       assign
     1135         v-seconds = 86400 - 1
     1136       .
     1137     end.
     1138     if v-seconds < 0
     1139     then do:
     1140       assign
     1141         v-seconds = 0
     1142       .
     1143     end.
     1144     assign
     1145       v-hour = truncate(v-seconds / 3600, 0)
     1146     .
     1147     assign
     1148       v-seconds = v-seconds modulo 3600
     1149     .
     1150     assign
     1151       v-min = truncate(v-seconds / 60, 0)
     1152     .
     1153     assign
     1154       v-seconds = v-seconds modulo 60
     1155     .
     1156     return
     1157         (if v-day-number <> 0
     1158           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1159           else ""
     1160         )
     1161       + (if v-day-number <> 0 or v-hour <> 0
     1162           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1163           else ""
     1164         )
     1165       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1166           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1167           else ""
     1168         )
     1169       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1170       .
     1171   end.
     1172   function cur-time-string returns character
     1173   :
     1174     define variable v-date as date      no-undo .
     1175     define variable v-time as integer   no-undo .
     1176     run cur-time in this-procedure
     1177       (output v-date
     1178       ,output v-time
     1179       ) .
     1180     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1181   end.
     1182   function cur-time-string-sec returns character
     1183   :
     1184     define variable v-date as date      no-undo .
     1185     define variable v-time as integer   no-undo .
     1186     run cur-time in this-procedure
     1187       (output v-date
     1188       ,output v-time
     1189       ) .
     1190     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1191   end.
     1192   function cur-time-custom  returns character
     1193   (input p-prefix as character
     1194   ,input p-date-format as character
     1195   ,input p-delimiter as character
     1196   ,input p-time-format as character
     1197   ,input p-suffix as character
     1198   )
     1199   :
     1200     define variable v-date as date      no-undo .
     1201     define variable v-time as integer   no-undo .
     1202     run cur-time in this-procedure
     1203       (output v-date
     1204       ,output v-time
     1205       ) .
     1206     return
     1207       p-prefix
     1208       + string(v-date, p-date-format)
     1209       + p-delimiter
     1210       + string(v-time, p-time-format)
     1211       + p-suffix
     1212       .
     1213   end.
     1214   function cur-time-print  returns character
     1215   :
     1216     define variable v-date as date      no-undo .
     1217     define variable v-time as integer   no-undo .
     1218     run cur-time in this-procedure
     1219       (output v-date
     1220       ,output v-time
     1221       ) .
     1222     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1223   end.
     1224   function cur-time-datetime returns datetime
     1225   :
     1226     define variable v-char as character no-undo .
     1227     define variable v-datetime as datetime no-undo .
     1228     v-char = cur-time-string().
     1229     v-datetime = datetime(v-char).
     1230     return  v-datetime.
     1231   end.
     1232   function cur-time-string-msec returns character
     1233   :
     1234     define variable v-date as datetime  no-undo .
     1235     v-date = now.
     1236     return string(v-date) .
     1237   end.
