     1730     create temp-code .
     1731       assign
     1732         temp-code.num    = ""
     1733         temp-code.name   = "Без основания"
     1734         temp-code.code   = 0
     1735         temp-code.lavel1 = 0
     1736         temp-code.lavel2 = 0
     1737         temp-code.lavel3 = 0
     1738       .
     1739     case p-type :
     1740       when 1 then do:
     1741         for each fin-code-cor-acc no-lock where fin-code-cor-acc.host-code = v-cntxt-host-code-obj :
     1742           find first buf_arh-fin-doc-an no-lock
