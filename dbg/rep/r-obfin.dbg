     2278            if mFrameView
     2279            then
     2280               PROCESS EVENTS.
     2281            IF StopProcessing THEN DO:
     2282            RETURN error.
     2283            End.
     2284      end.
     2285       case p-type :
     2286         when 1 then do:
     2287             find last buf_arh-fin-doc-an no-lock
     2288               where buf_arh-fin-doc-an.host-code         = v-cntxt-host-code-obj
     2289                 and buf_arh-fin-doc-an.code-schet        = temp-schet.code
     2290                 and buf_arh-fin-doc-an.cli-code          = v-cntxt-host-code-obj
     2291                 and buf_arh-fin-doc-an.cli-type          = 'орг':U
     2292                 and buf_arh-fin-doc-an.fin-ext-doc-type  = p-typ
     2293                 and buf_arh-fin-doc-an.calc-curr-code    = p-cur
     2294                 and buf_arh-fin-doc-an.fact-order       <= p-fo
     2295                 and buf_arh-fin-doc-an.fin-code-cor-acc  = temp-code.code
     2296                 and buf_arh-fin-doc-an.sum-type          = "sum-schet-cor-acc"
     2297                 and buf_arh-fin-doc-an.fin-code-an-uchet = 0
     2298                 and buf_arh-fin-doc-an.fin-code-cel-nazn = 0
     2299             no-error .
     2300         end.
     2301         when 2 then do:
     2302             find last buf_arh-fin-doc-an no-lock
     2303               where buf_arh-fin-doc-an.host-code         = v-cntxt-host-code-obj
     2304                 and buf_arh-fin-doc-an.code-schet        = temp-schet.code
     2305                 and buf_arh-fin-doc-an.cli-code          = v-cntxt-host-code-obj
     2306                 and buf_arh-fin-doc-an.cli-type          = 'орг':U
     2307                 and buf_arh-fin-doc-an.fin-ext-doc-type  = p-typ
     2308                 and buf_arh-fin-doc-an.calc-curr-code    = p-cur
     2309                 and buf_arh-fin-doc-an.fact-order       <= p-fo
     2310                 and buf_arh-fin-doc-an.fin-code-an-uchet = temp-code.code
     2311                 and buf_arh-fin-doc-an.sum-type          = "sum-schet-uchet"
     2312                 and buf_arh-fin-doc-an.fin-code-cor-acc  = 0
     2313                 and buf_arh-fin-doc-an.fin-code-cel-nazn = 0
     2314              no-error .
     2315         end.
     2316         when 3 then do:
     2317             find last buf_arh-fin-doc-an no-lock
     2318               where buf_arh-fin-doc-an.host-code         = v-cntxt-host-code-obj
     2319                 and buf_arh-fin-doc-an.code-schet        = temp-schet.code
     2320                 and buf_arh-fin-doc-an.cli-code          = v-cntxt-host-code-obj
     2321                 and buf_arh-fin-doc-an.cli-type          = 'орг':U
     2322                 and buf_arh-fin-doc-an.fin-ext-doc-type  = p-typ
     2323                 and buf_arh-fin-doc-an.calc-curr-code    = p-cur
     2324                 and buf_arh-fin-doc-an.fact-order       <= p-fo
     2325                 and buf_arh-fin-doc-an.fin-code-cel-nazn = temp-code.code
     2326                 and buf_arh-fin-doc-an.sum-type          = "sum-schet-cel-nazn"
     2327                 and buf_arh-fin-doc-an.fin-code-cor-acc  = 0
     2328                 and buf_arh-fin-doc-an.fin-code-an-uchet = 0
     2329             no-error .
     2330         end.
     2331       end.
     2332       if available buf_arh-fin-doc-an then do:
     2333         if p-typ = 'ппп':U then assign sm = sm + buf_arh-fin-doc-an.income .
     2334         else                               assign sm = sm + buf_arh-fin-doc-an.expense .
     2335       end.
     2336     end.
     2337   end procedure.
     2338   procedure CalcOst1 :
     2339     do on error undo, return error return-value :
     2340       define input  parameter p-typ as character no-undo .
     2341       define input  parameter p-calc as integer   no-undo .
     2342       define input  parameter p-cur as integer   no-undo .
     2343       define input  parameter p-fo  as decimal   no-undo .
     2344       define output parameter sm    as decimal   no-undo .
     2345       assign sm = 0 .
     2346       assign Counter1 = Counter1 + 1.
     2347   IF ( Counter1 modulo v-account = 0 )  then DO:
     2348             if  log-manager:logfile-name ne ?
     2349             then DO:
     2350                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     2351             end.
     2352              if mFrameView
     2353              then do:
     2354               DISPLAY
     2355                 Counter1 @ RecordsDone
     2356                 WITH FRAME InfoFrame.
     2357              end.
     2358   End.
     2359      if v-button-stop then  DO:
     2360            if mFrameView
     2361            then
     2362               PROCESS EVENTS.
     2363            IF StopProcessing THEN DO:
     2364            RETURN error.
     2365            End.
     2366      end.
     2367       find last buf_arh-fin-doc-an-nal no-lock
     2368         where buf_arh-fin-doc-an-nal.host-code         = v-cntxt-host-code-obj
     2369           and buf_arh-fin-doc-an-nal.fin-ext-doc-type  = p-typ
     2370           and buf_arh-fin-doc-an-nal.cli-code          = v-cntxt-host-code-obj
     2371           and buf_arh-fin-doc-an-nal.cli-type          = 'орг':U
     2372           and buf_arh-fin-doc-an-nal.curr-code         = p-cur
     2373           and buf_arh-fin-doc-an-nal.calc-curr-code    = p-calc
     2374           and buf_arh-fin-doc-an-nal.sum-type          = "sum-without-schet-code"
     2375           and buf_arh-fin-doc-an-nal.fact-order       <= p-fo
     2376           and buf_arh-fin-doc-an-nal.fin-code-cor-acc  = 0
     2377           and buf_arh-fin-doc-an-nal.fin-code-acc      = 0
     2378           and buf_arh-fin-doc-an-nal.fin-code-an-uchet = 0
     2379           and buf_arh-fin-doc-an-nal.fin-code-cel-nazn = 0
     2380       no-error .
     2381       if available buf_arh-fin-doc-an-nal then do:
     2382         if p-typ = 'пко':U or p-typ = 'апп':U then assign sm = sm + buf_arh-fin-doc-an-nal.income .
     2383         else                                                       assign sm = sm + buf_arh-fin-doc-an-nal.expense .
     2384       end.
     2385     end.
     2386   end procedure.
     2387   procedure CalcOborot1 :
     2388     do on error undo, return error return-value :
     2389       define input  parameter p-typ as character no-undo .
     2390       define input  parameter p-calc as integer   no-undo .
     2391       define input  parameter p-cur as integer   no-undo .
     2392       define input  parameter p-fo  as decimal   no-undo .
     2393       define input  parameter p-sum-type as character no-undo .
     2394       define output parameter sm    as decimal   no-undo .
     2395       assign sm = 0 .
     2396       assign Counter1 = Counter1 + 1.
     2397   IF ( Counter1 modulo v-account = 0 )  then DO:
     2398             if  log-manager:logfile-name ne ?
     2399             then DO:
     2400                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     2401             end.
     2402              if mFrameView
     2403              then do:
     2404               DISPLAY
     2405                 Counter1 @ RecordsDone
     2406                 WITH FRAME InfoFrame.
     2407              end.
     2408   End.
     2409      if v-button-stop then  DO:
     2410            if mFrameView
     2411            then
     2412               PROCESS EVENTS.
     2413            IF StopProcessing THEN DO:
     2414            RETURN error.
     2415            End.
     2416      end.
     2417         case p-type :
     2418           when 1 then do:
     2419             assign p-sum-type = p-sum-type + "cor-acc" .
     2420             find last buf_arh-fin-doc-an-nal no-lock
     2421               where buf_arh-fin-doc-an-nal.host-code         = v-cntxt-host-code-obj
     2422                 and buf_arh-fin-doc-an-nal.cli-code          = v-cntxt-host-code-obj
     2423                 and buf_arh-fin-doc-an-nal.cli-type          = 'орг':U
     2424                 and buf_arh-fin-doc-an-nal.fin-ext-doc-type  = p-typ
     2425                 and buf_arh-fin-doc-an-nal.curr-code         = p-cur
     2426                 and buf_arh-fin-doc-an-nal.calc-curr-code    = p-calc
     2427                 and buf_arh-fin-doc-an-nal.sum-type          = p-sum-type
     2428                 and buf_arh-fin-doc-an-nal.fact-order       <= p-fo
     2429                 and buf_arh-fin-doc-an-nal.fin-code-cor-acc  = temp-code.code
     2430                 and buf_arh-fin-doc-an-nal.fin-code-acc      = 0
     2431                 and buf_arh-fin-doc-an-nal.fin-code-an-uchet = 0
     2432                 and buf_arh-fin-doc-an-nal.fin-code-cel-nazn = 0
     2433             no-error .
     2434           end.
     2435           when 2 then do:
     2436             assign p-sum-type = p-sum-type + "uchet" .
     2437             find last buf_arh-fin-doc-an-nal no-lock
     2438               where buf_arh-fin-doc-an-nal.host-code         = v-cntxt-host-code-obj
     2439                 and buf_arh-fin-doc-an-nal.cli-code          = v-cntxt-host-code-obj
     2440                 and buf_arh-fin-doc-an-nal.cli-type          = 'орг':U
     2441                 and buf_arh-fin-doc-an-nal.fin-ext-doc-type  = p-typ
     2442                 and buf_arh-fin-doc-an-nal.curr-code         = p-cur
     2443                 and buf_arh-fin-doc-an-nal.calc-curr-code    = p-calc
     2444                 and buf_arh-fin-doc-an-nal.sum-type          = p-sum-type
     2445                 and buf_arh-fin-doc-an-nal.fact-order       <= p-fo
     2446                 and buf_arh-fin-doc-an-nal.fin-code-cor-acc  = 0
     2447                 and buf_arh-fin-doc-an-nal.fin-code-acc      = 0
     2448                 and buf_arh-fin-doc-an-nal.fin-code-an-uchet = temp-code.code
     2449                 and buf_arh-fin-doc-an-nal.fin-code-cel-nazn = 0
     2450             no-error .
     2451           end.
     2452           when 3 then do:
     2453             assign p-sum-type = p-sum-type + "cel-nazn" .
     2454             find last buf_arh-fin-doc-an-nal no-lock
     2455               where buf_arh-fin-doc-an-nal.host-code         = v-cntxt-host-code-obj
     2456                 and buf_arh-fin-doc-an-nal.cli-code          = v-cntxt-host-code-obj
     2457                 and buf_arh-fin-doc-an-nal.cli-type          = 'орг':U
     2458                 and buf_arh-fin-doc-an-nal.fin-ext-doc-type  = p-typ
     2459                 and buf_arh-fin-doc-an-nal.curr-code         = p-cur
     2460                 and buf_arh-fin-doc-an-nal.calc-curr-code    = p-calc
     2461                 and buf_arh-fin-doc-an-nal.sum-type          = p-sum-type
     2462                 and buf_arh-fin-doc-an-nal.fact-order       <= p-fo
     2463                 and buf_arh-fin-doc-an-nal.fin-code-cor-acc  = 0
     2464                 and buf_arh-fin-doc-an-nal.fin-code-acc      = 0
     2465                 and buf_arh-fin-doc-an-nal.fin-code-an-uchet = 0
     2466                 and buf_arh-fin-doc-an-nal.fin-code-cel-nazn = temp-code.code
     2467             no-error .
     2468           end.
     2469         end.
     2470       if available buf_arh-fin-doc-an-nal then do:
     2471         if p-typ = 'пко':U or p-typ = 'апп':U  then assign sm = sm + buf_arh-fin-doc-an-nal.income .
     2472         else                                                        assign sm = sm + buf_arh-fin-doc-an-nal.expense .
     2473       end.
     2474     end.
     2475   end procedure.
