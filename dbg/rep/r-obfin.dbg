     1650     run CalcOst (input 'рпп':U, input v-curr-r-b, input v-fact-order-start, output sum1) .
     1651     assign  ost-beg-base = ost-beg-base - sum1 .
     1652     run CalcOst (input 'ппп':U, input buf_fin-schet.curr-code, input v-fact-order-end, output sum1) .
