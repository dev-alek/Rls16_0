     5322   procedure Print-Footer :
     5323   define input parameter Nx as integer no-undo .
     5324   define input parameter Name as char no-undo .
     5325       if Nx = 1 Then DO:
     5326            run di-qnty  ( "кол-во", 1,"","Итого по : ",trim ( name),"","b1").
     5327            if show-cost then do : run di  (  "учет." , 2, "","","","","b1" ).  end.
     5328            if show-sale then do : run di  (  "док-т.", 8, "","","","","b1" ).  end.
     5329            if not sums-only then
     5330               run u-line.
     5331            run clear-itemb1- in this-procedure .
     5332            End.
     5333    if Nx = 2 Then DO:
     5334            run di-qnty  ( "кол-во", 1,"","","Итого по : " + trim ( name),"","b2").
     5335            if show-cost then do : run di  (  "учет." , 2, "","","","","b2" ).  end.
     5336            if show-sale then do : run di  (  "док-т.", 8, "","","","","b2" ).  end.
     5337            if not sums-only then run u-line.
     5338            run clear-itemb2-.
     5339           end.
     5340    if nx = 3 then do:
     5341            if not sums-only then run u-line.
     5342            run di-qnty  ( "кол-во", 1,"","Итого по пост-ку" , trim ( name),"","p").
     5343            if show-cost then do : run di  (  "учет." , 2, "","","","","p" ).  end.
     5344            if show-sale then do : run di  (  "док-т.", 8, "","","","","p" ).  end.
     5345            if not sums-only then run u-line.
     5346            run clear-itemp-.
     5347             end.
     5348    if nx = 0 then do:
     5349            run di-qnty  ( "кол-во", 1,"","Итого  объект: " , trim ( name),"","o").
     5350            if show-cost then do : run di  (  "учет." , 2, "","","","","o" ).  end.
     5351            if show-sale then do : run di  (  "док-т.", 8, "","","","","o" ).  end.
     5352            if not sums-only then run u-line.
     5353            run clear-itemo-.
     5354             end.
     5355    END PROCEDURE.
     5356   PROCEDURE Clear-item :
     5357   def var kk as int no-undo.
     5358    REPEAT kk = 1 to 9:
     5359    Assign
     5360       prih             [kk]  = 0
     5361       rash             [kk]  = 0
     5362       kassa            [kk]  = 0
     5363       spis             [kk]  = 0
     5364       Inv              [kk]  = 0
     5365       vzvr             [kk]  = 0
     5366       vzvr-post        [kk]  = 0
     5367        .
     5368          End.
     5369    END PROCEDURE.
     5370   PROCEDURE Clear-itemb1- :
     5371   def var kk as int no-undo.
     5372    REPEAT kk = 1 to 9:
     5373    Assign
     5374      b1-prih             [kk]  = 0
     5375      b1-rash             [kk]  = 0
     5376      b1-kassa            [kk]  = 0
     5377      b1-spis              [kk]  = 0
     5378      b1-Inv              [kk]  = 0
     5379      b1-vzvr             [kk]  = 0
     5380      b1-vzvr-post        [kk]  = 0
     5381      b1-ostatok-end      [kk]  = 0
     5382      b1-ostatok-start    [kk]  = 0
     5383      .
     5384          End.
     5385    END PROCEDURE.
     5386   PROCEDURE Clear-itemb2- :
     5387   def var kk as int no-undo.
     5388    REPEAT kk = 1 to 9:
     5389    Assign
     5390      b2-prih             [kk]  = 0
     5391      b2-rash             [kk]  = 0
     5392      b2-kassa            [kk]  = 0
     5393      b2-spis             [kk]  = 0
     5394      b2-Inv              [kk]  = 0
     5395      b2-vzvr             [kk]  = 0
     5396      b2-vzvr-post        [kk]  = 0
     5397      b2-ostatok-end      [kk]  = 0
     5398      b2-ostatok-start    [kk]  = 0
     5399      .
     5400      End.
     5401    END PROCEDURE.
     5402   PROCEDURE Clear-itemp- :
     5403   def var kk as int no-undo.
     5404    REPEAT kk = 1 to 9:
     5405    Assign
     5406      p-prih             [kk]  = 0
     5407      p-rash             [kk]  = 0
     5408      p-kassa            [kk]  = 0
     5409      p-spis             [kk]  = 0
     5410      p-Inv              [kk]  = 0
     5411      p-vzvr             [kk]  = 0
     5412      p-vzvr-post        [kk]  = 0
     5413      p-ostatok-end      [kk]  = 0
     5414      p-ostatok-start    [kk]  = 0
     5415      .
     5416      End.
     5417    END PROCEDURE.
     5418   PROCEDURE Clear-itemo- :
     5419   def var kk as int no-undo.
     5420    REPEAT kk = 1 to 9:
     5421    Assign
     5422      o-prih             [kk]  = 0
     5423      o-rash             [kk]  = 0
     5424      o-kassa            [kk]  = 0
     5425      o-Spis             [kk]  = 0
     5426      o-Inv              [kk]  = 0
     5427      o-vzvr             [kk]  = 0
     5428      o-vzvr-post        [kk]  = 0
     5429      o-ostatok-end      [kk]  = 0
     5430      o-ostatok-start    [kk]  = 0
