     1430   function waitfram-check-timeout returns logical():
     1431      define variable vtime as int64 no-undo.
     1432      if mWaitFramStopTimeOut
     1433      then
     1434         return yes.
     1435      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1436      if     mWaitFramTimeOut ne ?
     1437         and mWaitFramTimeOut ne 0
     1438         and mWaitFramTimeOut lt vtime
     1439      then do:
     1440         mWaitFramStopTimeOut = yes.
     1441      end.
     1442      return mWaitFramStopTimeOut.
     1443   end.
     1444   procedure waitfram-hide :
     1445     if not session:batch-mode
     1446     then do
     1447     on error undo, return error return-value
     1448     :
     1449       pause 0 before-hide .
     1450       if not mBatchMode then
     1451         hide frame waitfram .
     1452     if     not mWaitFramView
     1453        and mWaitProcEvent
     1454     then
     1455       process events .
     1456     end.
     1457   end procedure.
     1458   procedure waitfram-show :
     1459     define input  parameter p-message as character no-undo .
     1460     define variable v-left-margin as integer   no-undo .
     1461     if not session:batch-mode
     1462     then do
     1463     on error undo, return error return-value
     1464     :
     1465       if length(p-message) <= 70 then do:
     1466         assign
     1467           v-left-margin = integer((70 - length(p-message)) / 2)
     1468         .
     1469         assign
     1470           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1471         .
     1472         assign
     1473           v-waitfram-action01 = " "
     1474           v-waitfram-action02 = " "
     1475                                    + fill(" ", v-left-margin)
     1476                                    + p-message
     1477           v-waitfram-action03 = " "
     1478         .
     1479       end.
     1480       else do:
     1481         define variable vRindex1 as integer no-undo.
     1482         define variable vRindex2 as integer no-undo.
     1483         vRindex1 = r-index(p-message," ",70).
     1484         if vRindex1 = 0
     1485         then
     1486            vRindex1 = 70.
     1487         if length(p-message)  <= vRindex1 + 70 then do:
     1488           assign
     1489             v-waitfram-action01 = " "
     1490             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1491             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1492           .
     1493         end.
     1494         else do:
     1495           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1496           if vRindex2 <= vRindex1
     1497           then
     1498              vRindex2 = vRindex1 + 70.
     1499           assign
     1500             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1501             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1502             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1503           .
     1504         end.
     1505       end.
     1506       B-viewProcInfo:visible   in frame waitfram = no.
     1507       B-viewProcInfo:sensitive in frame waitfram = no.
     1508       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1509       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1510       if  (   mWaitFramView
     1511          or  mWaitProcEvent)
     1512          and not mBatchMode
     1513       then
     1514          display
     1515             v-waitfram-action01 skip
     1516             v-waitfram-action02 skip
     1517             v-waitfram-action03 skip
     1518          with frame waitfram .
     1519       if     mWaitFramView
     1520          then do:
     1521             if     mWaitFramInterval ne ?
     1522                and not mBatchMode
     1523             then
     1524                wait-for go of frame waitfram pause mWaitFramInterval.
     1525          end.
     1526          else
     1527             if     mWaitProcEvent
     1528                and not mBatchMode
     1529             then
     1530                process events .
     1531     end.
     1532   end procedure.
     1533      procedure waitfram-show-this:
     1534         define input  parameter iInterval as int64 no-undo.
     1535         define variable vtime as int64 no-undo.
     1536         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1537         mWaitFramInterval = iInterval.
     1538         run waitfram-show (substitute("&1&2 &3&4" ,
     1539                                       mWaitFramTextBeg ,
     1540                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1541                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1542                                       mWaitFramTextEnd
     1543                                      )
     1544                           ).
     1545      end.
     1546      procedure WaitFramRunPause:
     1547         define input  parameter iInterval as dec no-undo.
     1548         define variable vStart  as datetime-tz no-undo.
     1549         define variable vend    as datetime-tz no-undo.
     1550         define variable vint as int64 no-undo.
     1551         define variable vOk as logical no-undo.
     1552         vStart = now.
     1553         vend   = vStart.
     1554         publish "WaitFramPause" (iInterval,output vOk).
     1555         vend   =  now.
     1556         vint = vend - vStart.
     1557         vint = iInterval - vint / 1000.
     1558         if     not mWaitFramStop
     1559            and (   vint > 0
     1560                 or (    not vOk
     1561                     and iInterval eq ?
     1562                     )
     1563                 )
     1564         then
     1565            run waitfram-show-this (iInterval).
     1566         vend   =  now.
     1567         vint = vend - vStart.
     1568         vint = iInterval - vint / 1000.
     1569         if     not mWaitFramStop
     1570            and vint > 0
     1571         then do:
     1572            run gbl/pause.p (vint * 1000).
     1573         end.
     1574         if iInterval ne ?
     1575         then
     1576            publish "WaitFramStop".
     1577         waitfram-check-timeout().
     1578      end.
     1579      procedure WaitFramWaitFor:
     1580         define input  parameter iInterval as dec no-undo.
     1581         assign
     1582            mWaitFramStartProc   = now
     1583            mWaitFramStopUser    = no
     1584            mWaitFramStopTimeOut = no
     1585         .
     1586         block-wait:
     1587         do while not mWaitFramStop:
     1588            run WaitFramRunPause (iInterval).
     1589            if  waitfram-check-timeout()
     1590            then do:
     1591               leave block-wait.
     1592            end.
     1593         end.
     1594         run waitfram-hide.
     1595      end.
     1596   procedure waitfram-join :
     1597     define input  parameter p-line-1  as character no-undo .
     1598     define input  parameter p-line-2  as character no-undo .
     1599     define input  parameter p-line-3  as character no-undo .
     1600     define output parameter p-message as character no-undo .
     1601     do
     1602     on error undo, return error return-value
     1603     :
     1604       assign
     1605         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1606                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1607                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1608       .
     1609     end.
     1610   end procedure.
     1611   function waitfram-join-function returns character
     1612     (input p-line-1 as character
     1613     ,input p-line-2 as character
     1614     ,input p-line-3 as character
     1615     ).
     1616     define variable v-message as character no-undo .
     1617     run waitfram-join in this-procedure
     1618       (input  p-line-1
     1619       ,input  p-line-2
     1620       ,input  p-line-3
     1621       ,output v-message
     1622       ) .
     1623     return v-message .
     1624   end function .
     1625   define variable ii like i init 0 no-undo .
     1626   define variable t#cat-id like ub.stk-line.cat-id no-undo .
     1627   define variable t#Sum-type like ub.stk-line.Sum-type no-undo .
     1628   define variable t#kol-rec-obj like i init 0  no-undo .
     1629   if Show-Negativ then null-fact-order = 0 .
     1630      else  null-fact-order = fact-order-1 .
     1631   null-fact-order = 0 .
     1632   for each obj-list no-lock :
