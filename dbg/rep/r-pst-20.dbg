     3753   procedure Print-Header :
     3754   define input parameter N as integer no-undo .
     3755   define input parameter Name as char no-undo .
     3756   PUT stream  OutStream  UNFORMATTED trim(Name) AT ((N - 1) * 10 ) format "x(100)" skip.
     3757   if Make-Excel then  put   stream ForExcel unformatted fill(" " + CHR(9), N - 1) trim(Name) skip.
     3758   END PROCEDURE.
