     1665   procedure run1-0 :
     1666   CASE RetClassify :
     1667     when "no-classify":u then  do:
     1668   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1669   for each temp-t-post-stk-line : delete temp-t-post-stk-line. end.
     1670   For each obj-list no-lock
     1671     , each post-stk-line  no-lock where
     1672                                     post-stk-line.obj-type = obj-list.obj-type and
     1673                                     post-stk-line.obj-code = obj-list.obj-code and
     1674                                     post-stk-line.fact-order >= null-fact-order   and
     1675                                     post-stk-line.fact-order <= fact-order-2   and
     1676                                     post-stk-line.sum-type    = 'cost':U    and
     1677                                     post-stk-line.cat-id      = '##':U
     1678                                     and can-find(first g#post  where  post-stk-line.cli-type = g#post.obj-type and  post-stk-line.cli-code = g#post.obj-code ) = TRUE
     1679                                     :
     1680           find first  temp-t-post-stk-line where
     1681             temp-t-post-stk-line.obj-type  = obj-list.obj-type       and
     1682             temp-t-post-stk-line.obj-code  = obj-list.obj-code       and
     1683             temp-t-post-stk-line.cli-type  = post-stk-line.cli-type  and
     1684             temp-t-post-stk-line.cli-code  = post-stk-line.cli-code  and
     1685             temp-t-post-stk-line.artic     = post-stk-line.artic     and
     1686             temp-t-post-stk-line.prod-type = post-stk-line.prod-type and
     1687             temp-t-post-stk-line.prod-code = post-stk-line.prod-code no-lock no-error .
     1688             if not available temp-t-post-stk-line then do:
     1689               find first  ub.goods no-lock where
     1690                                     ub.goods.artic     = post-stk-line.artic     and
     1691                                     ub.goods.prod-type = post-stk-line.prod-type and
     1692                                     ub.goods.prod-code = post-stk-line.prod-code no-error .
     1693               find first  prod-cli no-lock  where
     1694                                         prod-cli.obj-type = post-stk-line.prod-type and
     1695                                         prod-cli.obj-code = post-stk-line.prod-code
     1696                                         no-error .
     1697               find first  ub.clients  no-lock  where
     1698                                         ub.clients.obj-type = post-stk-line.cli-type and
     1699                                         ub.clients.obj-code = post-stk-line.cli-code no-error .
     1700                 Run create-temp-t-post-stk-line .
     1701                 if xLavel <> 0 THEN  DO:
     1702                    temp-t-post-stk-line.goods-grp-name = n-lavel (temp-t-post-stk-line.goods-grp-name , xLavel ) .
     1703                 end.
     1704           end.
     1705           else do:
     1706                   assign
     1707                     temp-t-post-stk-line.fact-order = post-stk-line.fact-order  .
     1708                   .
     1709           end.
     1710   end.
     1711   CASE RetClassify :
     1712   when "grp-goods":U  then   DO:
     1713   for each temp-t-post-stk-line break
     1714            by temp-t-post-stk-line.goods-grp-name
     1715            by ( temp-t-post-stk-line.cli-type + string(temp-t-post-stk-line.cli-code) )
     1716            BY temp-t-post-stk-line.artic
     1717            by  temp-t-post-stk-line.gds-code
     1718            :
     1719       if first-of( temp-t-post-stk-line.goods-grp-name) then do:
     1720         Run Print-Header(1 , temp-t-post-stk-line.goods-grp-name ).
     1721       end.
     1722       if first-of(temp-t-post-stk-line.cli-type + string(temp-t-post-stk-line.cli-code)) then do:
     1723         Run Print-Header(3 , temp-t-post-stk-line.clients-obj-name).
     1724       end.
     1725       IF last-of(temp-t-post-stk-line.GDS-CODE) THEN DO:
     1726       Assign
     1727         Ostatok-end[1] = 0
     1728         Ostatok-end[2] = 0
     1729         Ostatok-end[8] = 0
     1730         Ostatok-start[1] = 0
     1731         Ostatok-start[2] = 0
     1732         Ostatok-start[8] = 0
     1733         .
