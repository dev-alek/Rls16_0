     4686   procedure Goods-start :
     4687    def buffer  b-post-stk-line for ub.stk-supp-line .
     4688    define variable p-fact-order as decimal no-undo .
     4689     p-fact-order = fact-order-1 .
     4690     Find last temp2-post-stk-line  no-lock where
     4691                                       temp2-post-stk-line.artic       =  temp-t-post-stk-line.artic        and
     4692                                       temp2-post-stk-line.prod-type   =  temp-t-post-stk-line.prod-type    and
     4693                                       temp2-post-stk-line.prod-code   =  temp-t-post-stk-line.prod-code    and
     4694                                       temp2-post-stk-line.cli-type    =  temp-t-post-stk-line.cli-type     and
     4695                                       temp2-post-stk-line.cli-code    =  temp-t-post-stk-line.cli-code     and
     4696                                       temp2-post-stk-line.obj-type    =  temp-t-post-stk-line.obj-type     and
     4697                                       temp2-post-stk-line.obj-code    =  temp-t-post-stk-line.obj-code     and
     4698                                       temp2-post-stk-line.fact-order <=  fact-order-1               and
     4699                                       temp2-post-stk-line.sum-type    =  'cost':U                and
     4700                                       temp2-post-stk-line.cat-id      =  '##':U
     4701                                       no-error .
     4702     Find Last a-post-stk-line  where
     4703         a-post-stk-line.fact-order =   ( if avail temp2-post-stk-line then temp2-post-stk-line.fact-order else 0)  and
     4704         a-post-stk-line.cat-id     =  t#cat-id      and
     4705         a-post-stk-line.Sum-type   =  t#sum-type    and
     4706         a-post-stk-line.artic      =  temp-t-post-stk-line.artic       and
     4707         a-post-stk-line.prod-type  =  temp-t-post-stk-line.prod-type   and
     4708         a-post-stk-line.prod-code  =  temp-t-post-stk-line.prod-code   and
     4709         a-post-stk-line.cli-type   =  temp-t-post-stk-line.cli-type  and
     4710         a-post-stk-line.cli-code   =  temp-t-post-stk-line.cli-code  and
     4711         a-post-stk-line.obj-type   =  temp-t-post-stk-line.obj-type  and
     4712         a-post-stk-line.obj-code   =  temp-t-post-stk-line.obj-code
     4713         no-lock no-error .
     4714         if avail  a-post-stk-line Then
     4715         Assign
     4716           p-fact-order     = a-post-stk-line.fact-order
     4717           Ostatok-start[1] = a-post-stk-line.fact-qnty
     4718           Ostatok-start[2] = IF tPrintRubl THEN  a-post-stk-line.sum-rubl
     4719                                            else a-post-stk-line.sum-base.
     4720           Else
     4721         Assign
     4722           Ostatok-start[1] = 0
     4723           Ostatok-start[2] = 0
     4724         Ostatok-start[8] = 0.
     4725        IF Show-Sale  then do:
     4726                For each b-post-stk-line where
     4727                                            b-post-stk-line.fact-order = p-fact-order and
     4728                                            b-post-stk-line.cat-id     = t#cat-id   and
     4729                                            b-post-stk-line.Sum-type   begins 'sadt':U         and
     4730                                            b-post-stk-line.artic      = temp-t-post-stk-line.artic      and
     4731                                            b-post-stk-line.prod-type  = temp-t-post-stk-line.prod-type  and
     4732                                            b-post-stk-line.prod-code  = temp-t-post-stk-line.prod-code  and
     4733                                            b-post-stk-line.cli-type   = temp-t-post-stk-line.cli-type   and
     4734                                            b-post-stk-line.cli-code   = temp-t-post-stk-line.cli-code   and
     4735                                            b-post-stk-line.obj-type   = temp-t-post-stk-line.obj-type   and
     4736                                            b-post-stk-line.obj-code   = temp-t-post-stk-line.obj-code
     4737                                            no-lock :
     4738                         IF  tPrintRubl  THEN
     4739                              ASSIGN  Ostatok-start[8] = Ostatok-start[8]  + b-post-stk-line.sum-rubl .
     4740                           ELSE
     4741                              ASSIGN  Ostatok-start[8] = Ostatok-start[8]  +  b-post-stk-line.sum-base.
     4742                 End.
     4743         End.
     4744    END PROCEDURE.
     4745   procedure Goods-end :
     4746    def buffer  b-post-stk-line for ub.stk-supp-line .
     4747    define variable p-fact-order as decimal no-undo .
     4748     p-fact-order = fact-order-2 .
     4749     Find last temp2-post-stk-line  no-lock where
     4750                                       temp2-post-stk-line.artic       =  temp-t-post-stk-line.artic        and
     4751                                       temp2-post-stk-line.prod-type   =  temp-t-post-stk-line.prod-type    and
     4752                                       temp2-post-stk-line.prod-code   =  temp-t-post-stk-line.prod-code    and
     4753                                       temp2-post-stk-line.cli-type    =  temp-t-post-stk-line.cli-type     and
     4754                                       temp2-post-stk-line.cli-code    =  temp-t-post-stk-line.cli-code     and
     4755                                       temp2-post-stk-line.obj-type    =  temp-t-post-stk-line.obj-type     and
     4756                                       temp2-post-stk-line.obj-code    =  temp-t-post-stk-line.obj-code     and
     4757                                       temp2-post-stk-line.fact-order <=  fact-order-2               and
     4758                                       temp2-post-stk-line.sum-type    =  'cost':U                and
     4759                                       temp2-post-stk-line.cat-id      =  '##':U
     4760                                       no-error .
     4761     Find Last a-post-stk-line  where
     4762         a-post-stk-line.fact-order =   ( if avail temp2-post-stk-line then temp2-post-stk-line.fact-order else 0)  and
     4763         a-post-stk-line.cat-id     =  t#cat-id       and
     4764         a-post-stk-line.Sum-type   =  t#sum-type     and
     4765         a-post-stk-line.artic      =  temp-t-post-stk-line.artic       and
     4766         a-post-stk-line.prod-type  =  temp-t-post-stk-line.prod-type   and
     4767         a-post-stk-line.prod-code  =  temp-t-post-stk-line.prod-code   and
     4768         a-post-stk-line.cli-type   =  temp-t-post-stk-line.cli-type    and
     4769         a-post-stk-line.cli-code   =  temp-t-post-stk-line.cli-code    and
     4770         a-post-stk-line.obj-type   =  temp-t-post-stk-line.obj-type    and
     4771         a-post-stk-line.obj-code   =  temp-t-post-stk-line.obj-code
     4772         no-lock no-error .
     4773     if avail  a-post-stk-line Then do :
     4774         Assign
     4775           p-fact-order     = a-post-stk-line.fact-order
     4776           ostatok-end[1] = a-post-stk-line.fact-qnty
     4777           ostatok-end[2] = if tprintrubl then  a-post-stk-line.sum-rubl
     4778                                          else  a-post-stk-line.sum-base.
     4779           end.
     4780           Else
     4781         Assign
     4782           Ostatok-end[1] = 0
     4783           Ostatok-end[2] = 0.
     4784           Ostatok-end[8] = 0.
     4785        IF Show-Sale  then do:
     4786                For each b-post-stk-line where
     4787                                            b-post-stk-line.fact-order = p-fact-order and
     4788                                            b-post-stk-line.cat-id     = t#cat-id   and
     4789                                            b-post-stk-line.Sum-type    begins 'sadt':U         and                                         b-post-stk-line.artic      = post-stk-line.artic      and
     4790                                            b-post-stk-line.prod-type  = temp-t-post-stk-line.prod-type  and
     4791                                            b-post-stk-line.prod-code  = temp-t-post-stk-line.prod-code  and
     4792                                            b-post-stk-line.cli-type   = temp-t-post-stk-line.cli-type   and
     4793                                            b-post-stk-line.cli-code   = temp-t-post-stk-line.cli-code   and
     4794                                            b-post-stk-line.obj-type   = temp-t-post-stk-line.obj-type   and
     4795                                            b-post-stk-line.obj-code   = temp-t-post-stk-line.obj-code
     4796                                            no-lock :
     4797                         IF  tPrintRubl  THEN
     4798                              ASSIGN  Ostatok-end[8] = Ostatok-end[8]  + b-post-stk-line.sum-rubl .
     4799                           ELSE
     4800                              ASSIGN  Ostatok-end[8] = Ostatok-end[8]  +  b-post-stk-line.sum-base.
     4801                 End.
     4802         End.
     4803   END PROCEDURE.
     4804   PROCEDURE display-line :
     4805     i = i + 1.
     4806   If Integer(10) = 0 Then Temp1  = 100  .
     4807                         Else Temp1 = Integer(10) .
     4808        IF ( i modulo Temp1 = 0 ) AND ( i >= Temp1 ) then
     4809            RUN waitfram-show( "Обработано строк : " + string( i )) .
     4810     run clear-item.
     4811       assign
     4812             gds-zap-gds-name   = temp-t-post-stk-line.gds-name
     4813             gds-zap-unit-base  = temp-t-post-stk-line.unit-base
     4814             gds-zap-prt-root   = temp-t-post-stk-line.prt-root
     4815             gds-zap-prod-type  = temp-t-post-stk-line.prod-type
     4816             gds-zap-prod-code  = temp-t-post-stk-line.prod-code
     4817             gds-zap-artic      = temp-t-post-stk-line.artic
     4818             gds-zap-grp-name   = temp-t-post-stk-line.Goods-grp-name
     4819             gds-zap-b-code     = temp-t-post-stk-line.gds-code
     4820             gds-zap-type       = temp-t-post-stk-line.gds-type
     4821             pos-cli-type       = temp-t-post-stk-line.Cli-type
     4822             pos-cli-code       = temp-t-post-stk-line.Cli-code
     4823             pos-cli-grp-name   = temp-t-post-stk-line.Clients-grp-name.
     4824       run ob-line  (
     4825                temp-t-post-stk-line.obj-code    ,
     4826                temp-t-post-stk-line.obj-type    ,
     4827                temp-t-post-stk-line.cli-code    ,
     4828                temp-t-post-stk-line.cli-type    ,
     4829                temp-t-post-stk-line.artic       ,
     4830                temp-t-post-stk-line.prod-code   ,
     4831                temp-t-post-stk-line.prod-type   ,
     4832                Fact-order-1     ,
     4833                Fact-order-2     ,
     4834                t#sum-type       ,
     4835                t#cat-id         ,
     4836                ""               ,
     4837                yes) .
     4838      if Show-Sale Then  run ob-line  (
     4839                temp-t-post-stk-line.obj-code    ,
     4840                temp-t-post-stk-line.obj-type    ,
     4841                temp-t-post-stk-line.cli-code    ,
     4842                temp-t-post-stk-line.cli-type    ,
     4843                temp-t-post-stk-line.artic       ,
     4844                temp-t-post-stk-line.prod-code   ,
     4845                temp-t-post-stk-line.prod-type   ,
     4846                Fact-order-1   ,
     4847                Fact-order-2   ,
     4848                'sale':U    ,
     4849                '##':U ,
     4850                ""             ,
     4851                yes) .
     4852            run calc-sub-itog ( 0).
     4853                if Show-Sale Then
     4854                   run calc-sub-itog ( 6).
     4855          IF  NOT  ( ( ostatok-start[1] = 0  AND
     4856                                          Prih         [1] = 0  AND
     4857                                          RAsh         [1] = 0  AND
     4858                                          KAssa        [1] = 0  AND
     4859                                          Inv          [1] = 0  AND
     4860                                          vzvr         [1] = 0  AND
     4861                                          vzvr-post    [1] = 0  AND
     4862                                          Ostatok-end  [1] = 0)) then DO:
     4863            IF NOT Sums-Only then DO:
     4864               run display-str1 in this-procedure .
     4865               run clear-item in this-procedure .
     4866            End.
     4867          End.
     4868     END PROCEDURE.
     4869   PROCEDURE display-str1  :
     4870   if   Show-Negativ = true or not  (
     4871       Prih         [1] = 0  AND
     4872       RAsh         [1] = 0  AND
     4873       KAssa        [1] = 0  AND
     4874       Inv          [1] = 0  AND
     4875       vzvr         [1] = 0  AND
     4876       spis         [1] = 0  AND
     4877       vzvr-post    [1] = 0
     4878       ) then DO:
     4879       if not  (  not Show-zero-ost   and
     4880               (  ostatok-end[1] = 0  and
     4881                ostatok-end[2] = 0  and
     4882                ostatok-end[8] = 0 ))  then DO:
     4883            run di-qnty  ( "кол-во", 1, gds-zap-b-code,gds-zap-artic,gds-zap-gds-name,gds-zap-unit-base,"").
     4884            if show-cost then do : run di  (  "учет." , 2, "","","","","" ).  end.
     4885            if show-sale then do : run di  (  "док-т.", 8, "","","","","" ).  end.
     4886          end.
     4887   end.
     4888   run clear-item in this-procedure .
     4889   END PROCEDURE.
     4890   PROCEDURE Di :
     4891   def input parameter p1 as char no-undo.
     4892   def input parameter p2 as int no-undo.
     4893   def input parameter p3 as char no-undo.
     4894   def input parameter p4 as char no-undo.
     4895   def input parameter p5 as char no-undo.
     4896   def input parameter p6 as char no-undo.
     4897   def input parameter p7 as char no-undo.
     4898    CASE CAPS ( p7) :
     4899      WHEN "B1":U  Then do:
     4900                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 sym11 sym12 sym13
     4901                   p3 @ gds-zap-b-code
     4902                   p4 @ gds-zap-artic
     4903                   p5 @ gds-zap-gds-name
     4904                   p6 @ gds-zap-unit-base
     4905                   p1 @ gds-type
     4906                   b1-ostatok-start[p2] when ( NOT( Show-SAle = true and p2 = 8 )) @  F-ostatok-start
     4907                   b1-Prih         [p2]  @  F-Prih
     4908                   b1-RAsh         [p2]  @  F-RAsh
     4909                   b1-KAssa        [p2]  @  F-KAssa
     4910                   b1-Inv          [p2]  @  F-Inv
     4911                   b1-spis         [p2]  @  F-spis
     4912                   b1-vzvr         [p2]  @  F-vzvr
     4913                   b1-vzvr-post    [p2]  @  F-vzvr-post
     4914                   b1-Ostatok-end  [p2] when ( NOT( Show-SAle = true and p2 = 8 ))  @  F-Ostatok-end
     4915                  with FRAME ZAPAS .
     4916     end.
     4917      WHEN "B2":U  Then do:
     4918                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 sym11 sym12 sym13
     4919                   p3 @ gds-zap-b-code
     4920                   p4 @ gds-zap-artic
     4921                   p5 @ gds-zap-gds-name
     4922                   p6 @ gds-zap-unit-base
     4923                   p1 @ gds-type
     4924                   b2-ostatok-start[p2] when ( NOT( Show-SAle = true and p2 = 8 )) @  F-ostatok-start
     4925                   b2-Prih         [p2]  @  F-Prih
     4926                   b2-RAsh         [p2]  @  F-RAsh
     4927                   b2-KAssa        [p2]  @  F-KAssa
     4928                   b2-Inv          [p2]  @  F-Inv
     4929                   b2-spis         [p2]  @  F-spis
     4930                   b2-vzvr         [p2]  @  F-vzvr
     4931                   b2-vzvr-post    [p2]  @  F-vzvr-post
     4932                   b2-Ostatok-end  [p2] when ( NOT( Show-SAle = true and p2 = 8 ))  @  F-Ostatok-end
     4933                  with FRAME ZAPAS .
     4934     end.
     4935      WHEN "BI":U Then do:
     4936                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 sym11 sym12 sym13
     4937                   p3 @ gds-zap-b-code
     4938                   p4 @ gds-zap-artic
     4939                   p5 @ gds-zap-gds-name
     4940                   p6 @ gds-zap-unit-base
     4941                   p1 @ gds-type
     4942                   bi-ostatok-start[p2] when ( NOT( Show-SAle = true and p2 = 8 )) @  F-ostatok-start
     4943                   bi-Prih         [p2]  @  F-Prih
     4944                   bi-RAsh         [p2]  @  F-RAsh
     4945                   bi-KAssa        [p2]  @  F-KAssa
     4946                   bi-Inv          [p2]  @  F-Inv
     4947                   bi-spis         [p2]  @  F-spis
     4948                   bi-vzvr         [p2]  @  F-vzvr
     4949                   bi-vzvr-post    [p2]  @  F-vzvr-post
     4950                   bi-Ostatok-end  [p2] when ( NOT( Show-SAle = true and p2 = 8 ))  @  F-Ostatok-end
     4951                  with FRAME ZAPAS .
     4952     end.
     4953      WHEN "P":U Then do:
     4954                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 sym11 sym12 sym13
     4955                   p3 @ gds-zap-b-code
     4956                   p4 @ gds-zap-artic
     4957                   p5 @ gds-zap-gds-name
     4958                   p6 @ gds-zap-unit-base
     4959                   p1 @ gds-type
     4960                   p-ostatok-start[p2] when ( NOT( Show-SAle = true and p2 = 8 )) @  F-ostatok-start
     4961                   p-Prih         [p2]  @  F-Prih
     4962                   p-RAsh         [p2]  @  F-RAsh
     4963                   p-KAssa        [p2]  @  F-KAssa
     4964                   p-Inv          [p2]  @  F-Inv
     4965                   p-spis         [p2]  @  F-spis
     4966                   p-vzvr         [p2]  @  F-vzvr
     4967                   p-vzvr-post    [p2]  @  F-vzvr-post
     4968                   p-Ostatok-end  [p2] when ( NOT( Show-SAle = true and p2 = 8 ))  @  F-Ostatok-end
     4969                  with FRAME ZAPAS .
     4970     end.
     4971      WHEN "O"  Then     DO :
     4972                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 sym11 sym12 sym13
     4973                   p3 @ gds-zap-b-code
     4974                   p4 @ gds-zap-artic
     4975                   p5 @ gds-zap-gds-name
     4976                   p6 @ gds-zap-unit-base
     4977                   p1 @ gds-type
     4978                   o-ostatok-start[p2] when ( NOT( Show-SAle = true and p2 = 8 )) @  F-ostatok-start
     4979                   o-Prih         [p2]  @  F-Prih
     4980                   o-RAsh         [p2]  @  F-RAsh
     4981                   o-KAssa        [p2]  @  F-KAssa
     4982                   o-Inv          [p2]  @  F-Inv
     4983                   o-spis         [p2]  @  F-spis
     4984                   o-vzvr         [p2]  @  F-vzvr
     4985                   o-vzvr-post    [p2]  @  F-vzvr-post
     4986                   o-Ostatok-end  [p2] when ( NOT( Show-SAle = true and p2 = 8 ))  @  F-Ostatok-end
     4987                  with FRAME ZAPAS .
     4988        End.
     4989      WHEN ""  Then DO:
     4990                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 sym11 sym12 sym13
     4991                   p3 @ gds-zap-b-code
     4992                   p4 @ gds-zap-artic
     4993                   p5 @ gds-zap-gds-name
     4994                   p6 @ gds-zap-unit-base
     4995                   p1 @ gds-type
     4996                   ostatok-start[p2] when ( NOT( Show-SAle = true and p2 = 8 )) @  F-ostatok-start
     4997                   Prih         [p2]  @  F-Prih
     4998                   RAsh         [p2]  @  F-RAsh
     4999                   KAssa        [p2]  @  F-KAssa
     5000                   Inv          [p2]  @  F-Inv
     5001                   spis         [p2]  @  F-spis
     5002                   vzvr         [p2]  @  F-vzvr
     5003                   vzvr-post    [p2]  @  F-vzvr-post
     5004                   Ostatok-end  [p2] when ( NOT( Show-SAle = true and p2 = 8 ))  @  F-Ostatok-end
     5005                  with FRAME ZAPAS .
     5006        End.
     5007      End case.
     5008        DOWN stream   OutStream 1 with FRAME ZAPAS.
     5009    END PROCEDURE.
     5010   PROCEDURE Di-qnty :
     5011   def input parameter p1 as char no-undo.
     5012   def input parameter p2 as int no-undo.
     5013   def input parameter p3 as char no-undo.
     5014   def input parameter p4 as char no-undo.
     5015   def input parameter p5 as char no-undo.
     5016   def input parameter p6 as char no-undo.
     5017   def input parameter p7 as char no-undo.
     5018    CASE CAPS ( p7) :
     5019      WHEN "B1":U  Then DO :
     5020                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 sym11 sym12 sym13
     5021                   p3 @ gds-zap-b-code
     5022                   p4 @ gds-zap-artic
     5023                   p5 @ gds-zap-gds-name
     5024                   p6 @ gds-zap-unit-base
     5025                   p1 @ gds-type
     5026                   b1-ostatok-start[p2] when ( NOT( Show-SAle = true and p2 = 8 )) @  F-ostatok-start
     5027                   b1-Prih         [p2]  @  F-Prih
     5028                   b1-RAsh         [p2]  @  F-RAsh
     5029                   b1-KAssa        [p2]  @  F-KAssa
     5030                   b1-Inv          [p2]  @  F-Inv
     5031                   b1-spis         [p2]  @  F-spis
     5032                   b1-vzvr         [p2]  @  F-vzvr
     5033                   b1-vzvr-post    [p2]  @  F-vzvr-post
     5034                   b1-Ostatok-end  [p2] when ( NOT( Show-SAle = true and p2 = 8 ))  @  F-Ostatok-end
     5035                  with FRAME ZAPAS .
     5036       if Make-Excel then  put   stream ForExcel unformatted p3 CHR(9)
     5037                   p4 CHR(9)
     5038                   p5 CHR(9)
     5039                   p6 CHR(9)
     5040                      ( excel-qnty(b1-ostatok-start[1]) +  CHR(9))
     5041   if Show-cost  then  ( excel-sum(b1-ostatok-start[2]) +  CHR(9))   else ("")
     5042   if Show-sale  then  ( "" +                              CHR(9))   else ("")
     5043                      ( excel-qnty(b1-Prih         [1]) +  CHR(9))
     5044   if Show-cost  then  ( excel-sum(b1-Prih         [2]) +  CHR(9))   else ("")
     5045   if Show-sale  then  ( excel-sum(b1-Prih         [8]) +  CHR(9))   else ("")
     5046                      ( excel-qnty(b1-RAsh         [1]) +  CHR(9))
     5047   if Show-cost  then  ( excel-sum(b1-RAsh         [2]) +  CHR(9))   else ("")
     5048   if Show-sale  then  ( excel-sum(b1-RAsh         [8]) +  CHR(9))   else ("")
     5049                      ( excel-qnty(b1-KAssa        [1]) +  CHR(9))
     5050   if Show-cost  then  ( excel-sum(b1-KAssa        [2]) +  CHR(9))   else ("")
     5051   if Show-sale  then  ( excel-sum(b1-KAssa        [8]) +  CHR(9))   else ("")
     5052                      ( excel-qnty(b1-Inv          [1]) +  CHR(9))
     5053   if Show-cost  then  ( excel-sum(b1-Inv          [2]) +  CHR(9))   else ("")
     5054   if Show-sale  then  ( excel-sum(b1-Inv          [8]) +  CHR(9))   else ("")
     5055                      ( excel-qnty(b1-spis         [1]) +  CHR(9))
     5056   if Show-cost  then  ( excel-sum(b1-spis         [2]) +  CHR(9))   else ("")
     5057   if Show-sale  then  ( excel-sum(b1-spis         [8]) +  CHR(9))   else ("")
     5058                      ( excel-qnty(b1-vzvr         [1]) +  CHR(9))
     5059   if Show-cost  then  ( excel-sum(b1-vzvr         [2]) +  CHR(9))   else ("")
     5060   if Show-sale  then  ( excel-sum(b1-vzvr         [8]) +  CHR(9))   else ("")
     5061                      ( excel-qnty(b1-vzvr-post    [1]) +  CHR(9))
     5062   if Show-cost  then  ( excel-sum(b1-vzvr-post    [2]) +  CHR(9))   else ("")
     5063   if Show-sale  then  ( excel-sum(b1-vzvr-post    [8]) +  CHR(9))   else ("")
     5064                      ( excel-qnty(b1-Ostatok-end  [1]) +  CHR(9))
     5065   if Show-cost  then  ( excel-sum(b1-Ostatok-end  [2]) +  CHR(9))   else ("")
     5066   if Show-sale  then  (  "" +                             CHR(9))   else ("")
     5067      chr(10).
     5068                   End.
