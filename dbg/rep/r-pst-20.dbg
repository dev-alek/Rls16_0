     1409   then
     1410      mBatchMode = yes.
     1411   if mBatchMode = ? then do:
     1412     mVisCUrentVin = current-window:visible.
     1413     mFameOldVis = mFramBachModHandle:visible.
     1414     mFramBachModHandle:visible  = yes.
     1415     mBatchMode = mFramBachModHandle:visible ne yes.
     1416     mFramBachModHandle:visible = mFameOldVis.
     1417     current-window:visible = mVisCUrentVin.
     1418   end.
     1419    if  log-manager:logfile-name ne ?
     1420     then DO:
     1421         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1422         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1423         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1424     end.
     1425   on choose of B-WaitFramStop in frame waitfram
     1426   do:
     1427     mWaitFramStop = yes.
     1428     mWaitFramStopUser = yes.
