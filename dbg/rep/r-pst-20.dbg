     1735         gds-zap-gds-name   = temp-t-post-stk-line.gds-name
     1736         gds-zap-unit-base  = temp-t-post-stk-line.unit-base
     1737         gds-zap-prt-root   = temp-t-post-stk-line.prt-root
     1738         gds-zap-prod-type  = temp-t-post-stk-line.prod-type
     1739         gds-zap-prod-code  = temp-t-post-stk-line.prod-code
     1740         gds-zap-artic      = temp-t-post-stk-line.artic
     1741         gds-zap-grp-name   = temp-t-post-stk-line.Goods-grp-name
     1742         gds-zap-b-code     = temp-t-post-stk-line.gds-code
     1743         gds-zap-type       = temp-t-post-stk-line.gds-type
     1744         pos-cli-type       = temp-t-post-stk-line.Cli-type
     1745         pos-cli-code       = temp-t-post-stk-line.Cli-code
     1746         pos-cli-grp-name   = temp-t-post-stk-line.Clients-grp-name
     1747         .
     1748           for each OBJ-LIST :
     1749           RUN Goods-start-O .
     1750           RUN Goods-end-O .
     1751           RUN ob-line (
     1752                   OBJ-LIST.obj-code    ,
     1753                   OBJ-LIST.obj-type    ,
     1754                   temp-t-post-stk-line.cli-code    ,
     1755                   temp-t-post-stk-line.cli-type    ,
     1756                   temp-t-post-stk-line.artic       ,
     1757                   temp-t-post-stk-line.prod-code   ,
     1758                   temp-t-post-stk-line.prod-type   ,
     1759                   Fact-order-1     ,
     1760                   Fact-order-2     ,
     1761                   t#sum-type       ,
     1762                   t#cat-id         ,
     1763                   ""               ,
     1764                   yes) .
     1765         if Show-Sale Then  RUN ob-line (
     1766                   OBJ-LIST.obj-code    ,
     1767                   OBJ-LIST.obj-type    ,
     1768               temp-t-post-stk-line.cli-code    ,
     1769               temp-t-post-stk-line.cli-type    ,
     1770               temp-t-post-stk-line.artic       ,
     1771               temp-t-post-stk-line.prod-code   ,
     1772               temp-t-post-stk-line.prod-type   ,
     1773               Fact-order-1   ,
     1774               Fact-order-2   ,
     1775               'sale':U    ,
     1776               '##':U ,
     1777               ""             ,
     1778               yes) .
     1779           end.
     1780           RUN Calc-Sub-itog(0).
     1781           if Show-Sale Then RUN Calc-Sub-itog(6).
     1782           IF  NOT ( (ostatok-start[1] = 0  AND
     1783                     Prih         [1] = 0  AND
     1784                     RAsh         [1] = 0  AND
     1785                     KAssa        [1] = 0  AND
     1786                     Inv          [1] = 0  AND
     1787                     vzvr         [1] = 0  AND
     1788                     vzvr-post    [1] = 0  AND
     1789                     ostatok-end  [1] = 0 )) then do:
     1790               if not sums-only then do:
     1791                 run display-str1.
     1792                 run clear-item.
     1793               end.
