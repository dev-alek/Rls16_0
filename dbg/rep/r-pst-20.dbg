     1397     v-waitfram-action02 format "x(72)" no-label skip
     1398     v-waitfram-action03 format "x(72)" no-label skip
     1399     B-viewProcInfo
     1400     B-WaitFramStop at row 4 col 30
     1401     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1402     .
     1403   define new global shared variable mBatchMode as logical no-undo init ?.
     1404   define variable mFramBachModHandle as handle no-undo.
     1405   mFramBachModHandle = frame waitfram:handle.
     1406   define variable mFameOldVis as logical no-undo.
     1407   define variable mVisCUrentVin as logical no-undo.
