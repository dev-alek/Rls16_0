      889   define variable v-inform-launched as logical no-undo initial false .
      890   procedure proc-alt-shift-f4:
      891     define variable v-action as character no-undo .
      892     if v-inform-launched = false then do:
      893       assign
      894         v-inform-launched = true
      895       .
      896       run gbl/d-inform.w
      897         (  input self
      898         ,  input this-procedure
      899         , output v-action
      900         ) no-error .
      901       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      902       assign
      903         v-inform-launched = false
      904       .
      905     end.
      906   end.
