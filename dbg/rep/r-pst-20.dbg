     5432      End.
     5433    END PROCEDURE.
     5434   PROCEDURE ob-line :
     5435   def input  parameter x-store-code     like ub.clients.obj-code          no-undo.
     5436   def input  parameter x-store-type     like ub.clients.obj-type          no-undo.
     5437   def input  parameter x-cli-code       like ub.clients.obj-code          no-undo.
     5438   def input  parameter x-cli-type       like ub.clients.obj-type          no-undo.
     5439   def INPUT  parameter x-artic          like post-ot-line.artic        no-undo.
     5440   def INPUT  parameter x-prod-code      like post-ot-line.prod-code    no-undo.
     5441   def INPUT  parameter x-prod-type      like post-ot-line.prod-type    no-undo.
     5442   def INPUT  parameter x-Fact-order-1   like post-ot-line.Fact-order   no-undo.
     5443   def INPUT  parameter x-Fact-order-2   like post-ot-line.Fact-order   no-undo.
     5444   def input  parameter x-sum-type       like post-ot-line.sum-type     no-undo.
     5445   def input  parameter x-cat-id         like post-ot-line.cat-id       no-undo.
     5446   def input  parameter x-ext-doc-type   like post-ot-line.ext-doc-type no-undo.
     5447   def input  parameter xTog-obj           as log no-undo .
     5448   def var  tt#          as   int                 no-undo .
     5449    if  ( x-sum-type = 'cost':U ) then tt# = 0.
     5450    if  ( x-sum-type = 'sale':U ) then tt# = 6.
     5451        FOR each post-ot-line where
     5452                 post-ot-line.artic        = x-artic
     5453           AND   post-ot-line.fact-order  <= x-fact-order-2
     5454           AND   post-ot-line.fact-order  >= x-fact-order-1
     5455           AND   post-ot-line.obj-code     = x-store-code
     5456           AND   post-ot-line.obj-type     = x-store-type
     5457           AND   post-ot-line.prod-code    = x-prod-code
     5458           AND   post-ot-line.prod-type    = x-prod-type
     5459           AND   post-ot-line.cli-code     = x-cli-code
     5460           AND   post-ot-line.cli-type     = x-cli-type
     5461           AND   post-ot-line.sum-type     = x-sum-type
     5462           AND   post-ot-line.cat-id       = x-cat-id
     5463                  no-lock :
     5464           CASE post-ot-line.ext-doc-type:
     5465                WHEN        'iv':U      OR
     5466                WHEN        'rv':U  OR
     5467                WHEN        'im':U     THEN     DO:
     5468              if t-in then
     5469              ASSIGN prih[1 + tt#]   = prih[1 + tt#]   +  post-ot-line.fact-qnty
     5470                     prih[2 + tt#]   = prih[2 + tt#]   +  if tprintrubl then post-ot-line.sum-rubl else post-ot-line.sum-base
     5471                     prih[3 + tt#]   = prih[3 + tt#]   +  if tprintrubl then post-ot-line.vat-rubl else post-ot-line.vat-base  .
     5472                    End.
     5473                WHEN        'ie':U   THEN     DO:
     5474              ASSIGN prih[1 + tt#]   = prih[1 + tt#]   +  post-ot-line.fact-qnty
     5475                     prih[2 + tt#]   = prih[2 + tt#]   +  if tprintrubl then post-ot-line.sum-rubl else post-ot-line.sum-base
     5476                     prih[3 + tt#]   = prih[3 + tt#]   +  if tprintrubl then post-ot-line.vat-rubl else post-ot-line.vat-base  .
     5477                    End.
     5478                WHEN        're':U  THEN DO:
     5479              ASSIGN vzvr[1 + tt#]   = vzvr[1 + tt#]   +  post-ot-line.fact-qnty
     5480                     vzvr[2 + tt#]   = vzvr[2 + tt#]   +  if tprintrubl then post-ot-line.sum-rubl else post-ot-line.sum-base
     5481                     vzvr[3 + tt#]   = vzvr[3 + tt#]   +  if tprintrubl then post-ot-line.vat-rubl else post-ot-line.vat-base  .
     5482                    End.
     5483                WHEN       'ep':U  THEN DO:
     5484              ASSIGN vzvr-post[1 + tt#]   = vzvr-post[1 + tt#]   +  post-ot-line.fact-qnty
     5485                     vzvr-post[2 + tt#]   = vzvr-post[2 + tt#]   +  if tprintrubl then post-ot-line.sum-rubl else post-ot-line.sum-base
     5486                     vzvr-post[3 + tt#]   = vzvr-post[3 + tt#]   +  if tprintrubl then post-ot-line.vat-rubl else post-ot-line.vat-base  .
     5487                    End.
     5488                WHEN       'ee':U          THEN  DO:
     5489                ASSIGN rash[1 + tt#]   = rash[1 + tt#]   +  post-ot-line.fact-qnty
     5490                     rash[2 + tt#]   = rash[2 + tt#]   +  if tprintrubl then post-ot-line.sum-rubl else post-ot-line.sum-base
     5491                     rash[3 + tt#]   = rash[3 + tt#]   +  if tprintrubl then post-ot-line.vat-rubl else post-ot-line.vat-base  .
     5492                    End.
     5493                WHEN       'ev':U       OR
     5494                WHEN       'em':U        THEN  DO:
     5495              if t-in then
     5496              ASSIGN rash[1 + tt#]   = rash[1 + tt#]   +  post-ot-line.fact-qnty
     5497                     rash[2 + tt#]   = rash[2 + tt#]   +  if tprintrubl then post-ot-line.sum-rubl else post-ot-line.sum-base
     5498                     rash[3 + tt#]   = rash[3 + tt#]   +  if tprintrubl then post-ot-line.vat-rubl else post-ot-line.vat-base  .
     5499                    End.
     5500                WHEN       'es':U  OR
     5501                WHEN       'rs':U THEN  DO:
     5502              ASSIGN kassa[1 + tt#]   = kassa[1 + tt#]   +  post-ot-line.fact-qnty
     5503                     kassa[2 + tt#]   = kassa[2 + tt#]   +  if tprintrubl then post-ot-line.sum-rubl else post-ot-line.sum-base
     5504                     kassa[3 + tt#]   = kassa[3 + tt#]   +  if tprintrubl then post-ot-line.vat-rubl else post-ot-line.vat-base .
     5505                    End.
     5506                WHEN       'vt':U      or
     5507                when       'vp':U   or
     5508                when       'ap':U   or
     5509                when       'mp':U or
     5510                when       'pc':U
     5511        THEN  DO:
     5512              ASSIGN INV[1 + tt#]   = INV[1 + tt#]   +  post-ot-line.fact-qnty
     5513                     Inv[2 + tt#]   = Inv[2 + tt#]   +  if tprintrubl then post-ot-line.sum-rubl else post-ot-line.sum-base
     5514                     Inv[3 + tt#]   = Inv[3 + tt#]   +  if tprintrubl then post-ot-line.vat-rubl else post-ot-line.vat-base  .
     5515                    End.
     5516                WHEN       'we':U       THEN  DO:
     5517              ASSIGN spis[1 + tt#]   = spis[1 + tt#]   +  post-ot-line.fact-qnty
     5518                     spis[2 + tt#]   = spis[2 + tt#]   +  if tprintrubl then post-ot-line.sum-rubl else post-ot-line.sum-base
     5519                     spis[3 + tt#]   = spis[3 + tt#]   +  if tprintrubl then post-ot-line.vat-rubl else post-ot-line.vat-base  .
     5520                    End.
     5521                WHEN       'wm':U       THEN  DO:
     5522              if t-in then
     5523              ASSIGN spis[1 + tt#]   = spis[1 + tt#]   +  post-ot-line.fact-qnty
     5524                     spis[2 + tt#]   = spis[2 + tt#]   +  if tprintrubl then post-ot-line.sum-rubl else post-ot-line.sum-base
     5525                     spis[3 + tt#]   = spis[3 + tt#]   +  if tprintrubl then post-ot-line.vat-rubl else post-ot-line.vat-base  .
     5526                    End.
     5527             End CASE.
     5528      End.
     5529   END PROCEDURE.
     5530   PROCEDURE Calc-Sub-itog :
     5531   def input parameter tt as int no-undo.
     5532   def var b as int no-undo.
     5533   repeat b = 1 to 3 :
     5534     Assign
     5535     B1-Prih[b + TT]    = B1-Prih[b + TT]    +  Prih[b + TT]
     5536     B2-Prih[b + TT]    = B2-Prih[b + TT]    +  Prih[b + TT]
     5537     Bi-Prih[b + TT]    = Bi-Prih[b + TT]    +  Prih[b + TT]
     5538     p-Prih[b + TT]     = p-Prih[b + TT]    +  Prih[b + TT]
     5539     o-Prih[b + TT]     = o-Prih[b + TT]    +  Prih[b + TT]
     5540     B1-RAsh[b + TT]    = B1-RAsh[b + TT]    +  RAsh[b + TT]
     5541     B2-RAsh[b + TT]    = B2-RAsh[b + TT]    +  RAsh[b + TT]
     5542     Bi-RAsh[b + TT]    = Bi-RAsh[b + TT]    +  RAsh[b + TT]
     5543     p-RAsh[b + TT]    = p-RAsh[b + TT]    +  RAsh[b + TT]
     5544     o-RAsh[b + TT]    = o-RAsh[b + TT]    +  RAsh[b + TT]
     5545     B1-KAssa[b + TT]    = B1-KAssa[b + TT]    +  KAssa[b + TT]
     5546     B2-kassa[b + TT]    = B2-kassa[b + TT]    +  kassa[b + TT]
     5547     Bi-kassa[b + TT]     = Bi-kassa[b + TT]     +  kassa[b + TT]
     5548     p-kassa[b + TT]      = p-kassa[b + TT]      +  kassa[b + TT]
     5549     o-kassa[b + TT]      = o-kassa[b + TT]      +  kassa[b + TT]
     5550     B1-Inv[b + TT]    = B1-Inv[b + TT]    +  Inv[b + TT]
     5551     B2-Inv[b + TT]    = B2-Inv[b + TT]    +  Inv[b + TT]
     5552     Bi-Inv[b + TT]    = Bi-Inv[b + TT]    +  Inv[b + TT]
     5553     p-Inv[b + TT]    = p-Inv[b + TT]    +  Inv[b + TT]
     5554     o-Inv[b + TT]    = o-Inv[b + TT]    +  Inv[b + TT]
     5555     B1-spis[b + TT]    = B1-spis[b + TT]    +  spis[b + TT]
     5556     B2-spis[b + TT]    = B2-spis[b + TT]    +  spis[b + TT]
     5557     Bi-spis[b + TT]    = Bi-spis[b + TT]    +  spis[b + TT]
     5558      p-spis[b + TT]    =  p-spis[b + TT]    +  spis[b + TT]
     5559      o-spis[b + TT]    =  o-spis[b + TT]    +  spis[b + TT]
     5560     B1-vzvr[b + TT]    = B1-vzvr[b + TT]    + vzvr[b + TT]
     5561     B2-vzvr[b + TT]    = B2-vzvr[b + TT]    + vzvr[b + TT]
     5562     Bi-vzvr[b + TT]    = Bi-vzvr[b + TT]    + vzvr[b + TT]
     5563     p-vzvr[b + TT]    = p-vzvr[b + TT]    + vzvr[b + TT]
     5564     o-vzvr[b + TT]    = o-vzvr[b + TT]    + vzvr[b + TT]
     5565     B1-vzvr-post[b + TT]    = B1-vzvr-post[b + TT]    + vzvr-post[b + TT]
     5566     B2-vzvr-post[b + TT]    = B2-vzvr-post[b + TT]    + vzvr-post[b + TT]
     5567     Bi-vzvr-post[b + TT]    = Bi-vzvr-post[b + TT]    + vzvr-post[b + TT]
     5568     p-vzvr-post[b + TT]    = p-vzvr-post[b + TT]    + vzvr-post[b + TT]
     5569     o-vzvr-post[b + TT]    = o-vzvr-post[b + TT]    + vzvr-post[b + TT]
     5570     B1-ostatok-start[b + TT]    = B1-ostatok-start[b + TT]    + ostatok-start[b + TT]
     5571     B2-ostatok-start[b + TT]    = B2-ostatok-start[b + TT]    + ostatok-start[b + TT]
     5572     Bi-ostatok-start[b + TT]    = Bi-ostatok-start[b + TT]    + ostatok-start[b + TT]
     5573     p-ostatok-start[b + TT]    = p-ostatok-start[b + TT]    + ostatok-start[b + TT]
     5574     o-ostatok-start[b + TT]    = o-ostatok-start[b + TT]    + ostatok-start[b + TT]
     5575     B1-ostatok-end[b + TT]    = B1-ostatok-end[b + TT]    + ostatok-end[b + TT]
     5576     B2-ostatok-end[b + TT]    = B2-ostatok-end[b + TT]    + ostatok-end[b + TT]
     5577     Bi-ostatok-end[b + TT]    = Bi-ostatok-end[b + TT]    + ostatok-end[b + TT]
     5578     p-ostatok-end[b + TT]    = p-ostatok-end[b + TT]    + ostatok-end[b + TT]
     5579     o-ostatok-end[b + TT]    = o-ostatok-end[b + TT]    + ostatok-end[b + TT]
     5580   .
     5581   End.
     5582   END PROCEDURE.
     5583   PROCEDURE U-LINE :
     5584   UNDERLINE stream OutStream  sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 sym13
     5585           gds-zap-b-code
     5586           gds-zap-artic
     5587           gds-zap-gds-name
     5588           gds-zap-unit-base
     5589           gds-type
     5590           F-ostatok-start
     5591           F-Prih
     5592           F-Rash
     5593           F-KAssa
     5594           F-Inv
     5595           F-spis
     5596           F-vzvr
     5597           F-vzvr-post
     5598           F-ostatok-end
     5599           with FRAME ZAPAS .
     5600           DOWN stream   OutStream 1 with FRAME ZAPAS.
     5601           END PROCEDURE.
     5602   Procedure Tmp-create :
     5603   define input parameter p1   like ub.clients.obj-code  no-undo .
     5604   define input parameter p2   like ub.clients.obj-type  no-undo .
     5605   define input parameter Name like ub.clients.obj-name  no-undo .
     5606   define input parameter p3   like obj-list.obj-code no-undo .
     5607   define input parameter p4   like obj-list.obj-type no-undo .
     5608     Create tmp-cli-gds.
     5609    def var kk as int no-undo.
     5610    REPEAT kk = 1 to 9 :
     5611      Assign
     5612         tmp-cli-gds.p-ostatok-start[kk]  = p-ostatok-start[kk]
     5613         tmp-cli-gds.p-ostatok-End[kk]    = p-ostatok-End[kk]
     5614         tmp-cli-gds.p-prih[kk]           = p-prih[kk]
     5615         tmp-cli-gds.p-rash[kk]           = p-rash[kk]
     5616         tmp-cli-gds.p-kassa[kk]          = p-kassa[kk]
     5617         tmp-cli-gds.p-Inv[kk]            = p-Inv[kk]
     5618         tmp-cli-gds.p-spis[kk]           = p-spis[kk]
     5619         tmp-cli-gds.p-vzvr[kk]           = p-vzvr[kk]
     5620         tmp-cli-gds.p-vzvr-post[kk]      = p-vzvr-post[kk]
     5621         .
     5622    end.
     5623         assign
     5624         tmp-cli-gds.cli-code         = p1
     5625         tmp-cli-gds.cli-type         = p2
     5626         tmp-cli-gds.Name             = Name
     5627         tmp-cli-gds.obj-code         = p3
     5628         tmp-cli-gds.obj-type         = p4
     5629         .
     5630    END PROCEDURE.
     5631   Procedure Tmp-clear :
     5632    def var kk as int no-undo.
     5633    REPEAT kk = 1 to 9 :
     5634    Assign
     5635        p-ostatok-start[kk] = 0
     5636        p-ostatok-End[kk]   = 0
     5637        p-prih[kk]          = 0
     5638        p-rash[kk]          = 0
     5639        p-kassa[kk]         = 0
     5640        p-Inv[kk]           = 0
     5641        p-spis[kk]          = 0
     5642        p-vzvr[kk]          = 0
     5643        p-vzvr-post[kk]     = 0
     5644       .
     5645       end.
     5646   END PROCEDURE.
     5647   Procedure Tmp-assign :
     5648    def var kk as int no-undo.
     5649    REPEAT kk = 1 to 9 :
     5650       Assign
     5651       p-ostatok-start[kk]  = p-ostatok-start[kk]   + tmp-cli-gds.p-ostatok-start[kk]
     5652       p-ostatok-End[kk]    = p-ostatok-End[kk]     + tmp-cli-gds.p-ostatok-End[kk]
     5653       p-prih[kk]           = p-prih[kk]            + tmp-cli-gds.p-prih[kk]
     5654       p-rash[kk]           = p-rash[kk]            + tmp-cli-gds.p-rash[kk]
     5655       p-kassa[kk]          = p-kassa[kk]           + tmp-cli-gds.p-kassa[kk]
     5656       p-Inv[kk]            = p-Inv[kk]             + tmp-cli-gds.p-Inv[kk]
     5657       p-spis[kk]           = p-spis[kk]            + tmp-cli-gds.p-spis[kk]
     5658       p-vzvr[kk]           = p-vzvr[kk]            + tmp-cli-gds.p-vzvr[kk]
     5659       p-vzvr-post[kk]      = p-vzvr-post[kk]       + tmp-cli-gds.p-vzvr-post[kk]
     5660       .
     5661    end.
     5662   END PROCEDURE.
     5663   procedure Goods-start-O :
     5664    def buffer  b-post-stk-line for ub.stk-supp-line .
     5665    define variable p-fact-order as decimal no-undo .
     5666     p-fact-order = fact-order-1 .
     5667     Find last temp2-post-stk-line  no-lock where
     5668       temp2-post-stk-line.artic       =  temp-t-post-stk-line.artic        and
     5669       temp2-post-stk-line.prod-type   =  temp-t-post-stk-line.prod-type    and
     5670       temp2-post-stk-line.prod-code   =  temp-t-post-stk-line.prod-code    and
     5671       temp2-post-stk-line.cli-type    =  temp-t-post-stk-line.cli-type     and
     5672       temp2-post-stk-line.cli-code    =  temp-t-post-stk-line.cli-code     and
     5673       temp2-post-stk-line.obj-type    =  OBJ-LIST.obj-type     and
     5674       temp2-post-stk-line.obj-code    =  obj-list.obj-code     and
     5675       temp2-post-stk-line.fact-order <=  fact-order-1               and
     5676       temp2-post-stk-line.sum-type    =  'cost':U                and
     5677       temp2-post-stk-line.cat-id      =  '##':U
     5678       no-error .
     5679     Find Last a-post-stk-line  where
     5680         a-post-stk-line.fact-order =  (if avail temp2-post-stk-line then temp2-post-stk-line.fact-order else 0)  and
     5681         a-post-stk-line.cat-id     =  t#cat-id      and
     5682         a-post-stk-line.Sum-type   =  t#sum-type    and
     5683         a-post-stk-line.artic      =  temp-t-post-stk-line.artic       and
     5684         a-post-stk-line.prod-type  =  temp-t-post-stk-line.prod-type   and
     5685         a-post-stk-line.prod-code  =  temp-t-post-stk-line.prod-code   and
     5686         a-post-stk-line.cli-type   =  temp-t-post-stk-line.cli-type  and
     5687         a-post-stk-line.cli-code   =  temp-t-post-stk-line.cli-code  and
     5688         a-post-stk-line.obj-type   =  obj-list.obj-type  and
     5689         a-post-stk-line.obj-code   =  obj-list.obj-code
     5690         no-lock no-error .
     5691         if avail  a-post-stk-line Then do:
     5692           p-fact-order     = a-post-stk-line.fact-order .
     5693           Ostatok-start[1] = Ostatok-start[1] +  a-post-stk-line.fact-qnty   .
     5694           ostatok-start[2] = ostatok-start[2] +  if tprintrubl then  a-post-stk-line.sum-rubl
     5695                                                     else a-post-stk-line.sum-base .
     5696           end.
     5697        IF Show-Sale  then do:
     5698                For each b-post-stk-line where
     5699                                            b-post-stk-line.fact-order = p-fact-order and
     5700                                            b-post-stk-line.cat-id     = t#cat-id   and
     5701                                            b-post-stk-line.Sum-type   begins 'sadt':U         and
     5702                                            b-post-stk-line.artic      = temp-t-post-stk-line.artic      and
     5703                                            b-post-stk-line.prod-type  = temp-t-post-stk-line.prod-type  and
     5704                                            b-post-stk-line.prod-code  = temp-t-post-stk-line.prod-code  and
     5705                                            b-post-stk-line.cli-type   = temp-t-post-stk-line.cli-type   and
     5706                                            b-post-stk-line.cli-code   = temp-t-post-stk-line.cli-code   and
     5707                                            b-post-stk-line.obj-type   = obj-list.obj-type   and
     5708                                            b-post-stk-line.obj-code   = obj-list.obj-code
     5709                                            no-lock :
     5710                         IF  tPrintRubl  THEN
     5711                              ASSIGN  Ostatok-start[8] = Ostatok-start[8]  + b-post-stk-line.sum-rubl .
     5712                           ELSE
     5713                              ASSIGN  Ostatok-start[8] = Ostatok-start[8]  +  b-post-stk-line.sum-base.
     5714                 End.
     5715         End.
     5716   END PROCEDURE.
     5717   procedure Goods-end-O :
     5718    def buffer  b-post-stk-line for ub.stk-supp-line .
     5719    define variable p-fact-order as decimal no-undo .
     5720     p-fact-order = fact-order-2 .
     5721     Find last temp2-post-stk-line  no-lock where
     5722       temp2-post-stk-line.artic       =  temp-t-post-stk-line.artic        and
     5723       temp2-post-stk-line.prod-type   =  temp-t-post-stk-line.prod-type    and
     5724       temp2-post-stk-line.prod-code   =  temp-t-post-stk-line.prod-code    and
     5725       temp2-post-stk-line.cli-type    =  temp-t-post-stk-line.cli-type     and
     5726       temp2-post-stk-line.cli-code    =  temp-t-post-stk-line.cli-code     and
     5727       temp2-post-stk-line.obj-type    =  obj-list.obj-type     and
     5728       temp2-post-stk-line.obj-code    =  obj-list.obj-code     and
     5729       temp2-post-stk-line.fact-order <=  fact-order-2               and
     5730       temp2-post-stk-line.sum-type    =  'cost':U                and
     5731       temp2-post-stk-line.cat-id      =  '##':U
     5732       no-error .
     5733     Find Last a-post-stk-line  where
     5734         a-post-stk-line.fact-order =  (if avail temp2-post-stk-line then temp2-post-stk-line.fact-order else 0)  and
     5735         a-post-stk-line.cat-id     =  t#cat-id       and
     5736         a-post-stk-line.Sum-type   =  t#sum-type     and
     5737         a-post-stk-line.artic      =  temp-t-post-stk-line.artic       and
     5738         a-post-stk-line.prod-type  =  temp-t-post-stk-line.prod-type   and
     5739         a-post-stk-line.prod-code  =  temp-t-post-stk-line.prod-code   and
     5740         a-post-stk-line.cli-type   =  temp-t-post-stk-line.cli-type    and
     5741         a-post-stk-line.cli-code   =  temp-t-post-stk-line.cli-code    and
     5742         a-post-stk-line.obj-type   =  obj-list.obj-type    and
     5743         a-post-stk-line.obj-code   =  obj-list.obj-code
     5744         no-lock no-error .
     5745     if avail  a-post-stk-line Then do :
     5746         Assign
     5747           p-fact-order     = a-post-stk-line.fact-order
     5748           ostatok-end[1] = ostatok-end[1] + a-post-stk-line.fact-qnty
     5749           ostatok-end[2] = ostatok-end[2] + if tprintrubl then  a-post-stk-line.sum-rubl
     5750                                             else  a-post-stk-line.sum-base.
     5751     end.
     5752        IF Show-Sale  then do:
     5753                For each b-post-stk-line where
     5754                     b-post-stk-line.fact-order = p-fact-order and
     5755                     b-post-stk-line.cat-id     = t#cat-id   and
     5756                     b-post-stk-line.Sum-type    begins 'sadt':U         and
     5757                     b-post-stk-line.artic      = post-stk-line.artic      and
     5758                     b-post-stk-line.prod-type  = temp-t-post-stk-line.prod-type  and
     5759                     b-post-stk-line.prod-code  = temp-t-post-stk-line.prod-code  and
     5760                     b-post-stk-line.cli-type   = temp-t-post-stk-line.cli-type   and
     5761                     b-post-stk-line.cli-code   = temp-t-post-stk-line.cli-code   and
     5762                     b-post-stk-line.obj-type   = obj-list.obj-type   and
     5763                     b-post-stk-line.obj-code   = obj-list.obj-code
     5764                     no-lock :
     5765                         IF  tPrintRubl  THEN
     5766                              ASSIGN  Ostatok-end[8] = Ostatok-end[8]  + b-post-stk-line.sum-rubl .
     5767                           ELSE
     5768                              ASSIGN  Ostatok-end[8] = Ostatok-end[8]  +  b-post-stk-line.sum-base.
     5769                 End.
     5770         End.
     5771   END PROCEDURE.
