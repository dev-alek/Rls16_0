     1177   .
     1178   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1179     run mainmenu_getcntxt in parparentproc
     1180       (output v-cntxt-db-num
     1181       ,output v-cntxt-userid
