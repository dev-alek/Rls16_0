     1234     .
     1235     run rep/chk-ahz.p
     1236       (input        ub.clients.obj-type
     1237       ,input        ub.clients.obj-code
     1238       ,input        no
     1239       ,input        yes
     1240       ,input        no
     1241       ,input        no
     1242       ,input        yes
     1243       ,input        v-cntxt-db-num
     1244       ,input        v-cntxt-userid
     1245       ,input-output v-check-date
     1246       ,input-output v-check-date
     1247       ,output       v-archive-ok
     1248       ,output       v-comment
     1249       ,output       v-can-print
     1250       ) .
     1251     if v-archive-ok = false
     1252     then do:
     1253       if v-can-print = true
     1254       then do:
     1255         define variable v-ok as logical   no-undo .
     1256         message
     1257           "ВНИМАНИЕ!" skip
     1258           v-comment skip
     1259           "" skip
     1260           "Продолжить формирование отчета?" skip
     1261           view-as alert-box question buttons yes-no update v-ok .
     1262         if v-ok <> true
     1263         then do:
     1264           return .
     1265         end.
     1266       end.
     1267       else do:
     1268         message
     1269           "ВНИМАНИЕ !!!" skip
     1270           "Отчет не может быть сформирован!" skip
     1271           "На запрошенную дату нет архивов или они сжаты" skip
     1272           v-comment skip
     1273           view-as alert-box information .
     1274         return .
     1275       end.
     1276     end.
     1277     def var v-ind         as integer   no-undo .
     1278     def var v-line        as character no-undo format "X(136)" .
     1279     assign
     1280       v-line = fill("-", 136 )
     1281     .
     1282     def var v-line1        as character no-undo format "X(136)" .
     1283     def var v-line2        as character no-undo format "X(136)" .
     1284     def var v-line3        as character no-undo format "X(136)" .
     1285     assign
     1286       v-line1 = v-line
     1287       v-line2 = v-line
     1288       v-line3 = v-line
     1289     .
     1290     def var sym1          as character no-undo format "x(1)":u label '!':u init ":":u .
     1291     def var sym2          as character no-undo format "x(1)":u label '!':u init ":":u .
     1292     def var sym3          as character no-undo format "x(1)":u label '!':u init ":":u .
     1293     def var sym4          as character no-undo format "x(1)":u label '!':u init ":":u .
     1294     def var sym5          as character no-undo format "x(1)":u label '!':u init ":":u .
     1295     def var sym6          as character no-undo format "x(1)":u label '!':u init ":":u .
     1296     def var sym7          as character no-undo format "x(1)":u label '!':u init ":":u .
     1297     def var sym8          as character no-undo format "x(1)":u label '!':u init ":":u .
     1298     def var sym9          as character no-undo format "x(1)":u label '!':u init ":":u .
     1299     def var sym10         as character no-undo format "x(1)":u label '!':u init ":":u .
     1300     def var sym11         as character no-undo format "x(1)":u label '!':u init ":":u .
     1301     def var sym12         as character no-undo format "x(1)":u label '!':u init ":":u .
     1302     def var sym13         as character no-undo format "x(1)":u label '!':u init ":":u .
     1303     def var sym14         as character no-undo format "x(1)":u label '!':u init ":":u .
     1304     def var sym15         as character no-undo format "x(1)":u label '!':u init ":":u .
     1305     run waitfram-show in this-procedure ( 'Подождите ...' ) .
     1306     run prn-lib-open-stream  in this-procedure (
     1307                                                input parParentProc
     1308                                               ,input 62
     1309                                               ,input yes
     1310                                               ,input no
     1311                                               ).
     1312     def var v-header-name as character no-undo .
     1313     def var v-print-time  as character no-undo .
     1314     assign
     1315       v-header-name = "ПРИХОДЫ"
     1316       v-print-time  = cur-time-string()
     1317     .
     1318     form header
     1319       v-line1 at 1 skip
     1320       v-header-name + ": " + v-month-name + " " + string(v-year) format "x(50)" at 1
     1321         "Дата печати :" at 60
     1322         v-print-time format "x(20)"
     1323         "Стр." at 111 string( page-number(PrnLibStream), ">>>9" )  skip
     1324       "ОБЪЕКТ:" at 1 clients.obj-type + " " + string(clients.obj-code) format "x(15)"
     1325       clients.obj-name skip
     1326       v-line2 at 1 skip
     1327       with frame topframe
     1328       width 160 page-top no-labels no-box .
     1329     view stream PrnLibStream frame topframe .
     1330     form header
     1331       v-line at 1 skip
     1332       "Продолжение на следующей странице" at 30 skip
     1333       with frame bottomframe
     1334       width 160 page-bottom no-labels no-box .
     1335     view stream PrnLibStream frame bottomframe .
     1336     if v-archive-ok = false
     1337     then do:
     1338       put stream PrnLibStream
     1339         "Расчитать полностью архивы не удалось." +
     1340         "Информация в отчете может быть не корректной !" skip .
     1341     end.
     1342     define frame input-frm
     1343       buf_goods.gds-name        format "x(52)" column-label "ТОВАР"
     1344       buf_trn-doc.fact-date                    column-label "ДАТА"
     1345       buf_parts.cli-qnty                       column-label "КОЛ-ВО (КГ)"
     1346       buf_doc-line.fact-density                column-label "ПЛ-ТЬ"
     1347       buf_parts.fact-qnty                      column-label "КОЛ-ВО"
     1348       buf_units.long-name       format "x(20)" column-label "ЕД.ИЗМ."
     1349       with width 160 down stream-io use-text .
     1350     form with frame input-frm .
     1351     for each gds-list no-lock
     1352     ,first buf_goods no-lock
     1353       where buf_goods.artic     = gds-list.artic
     1354         and buf_goods.prod-type = gds-list.prod-type
     1355         and buf_goods.prod-code = gds-list.prod-code
     1356     :
     1357       find first buf_units no-lock
     1358         where buf_units.unit-name = buf_goods.unit-base
     1359         .
     1360       assign
     1361         v-ind = v-ind + 1
     1362       .
     1363       process events .
     1364       run waitfram-show in this-procedure ( "Линий обработано: " + string(v-ind) ) .
     1365       def var v-total-cli-qnty  as decimal no-undo .
     1366       def var v-total-fact-qnty as decimal no-undo .
     1367       assign
     1368         v-total-cli-qnty  = 0
     1369         v-total-fact-qnty = 0
     1370       .
     1371       for each buf_doc-line no-lock
     1372         where buf_doc-line.obj-type  = p-curr-obj-type
     1373           and buf_doc-line.obj-code  = p-curr-obj-code
     1374           and buf_doc-line.artic     = buf_goods.artic
     1375           and buf_doc-line.prod-type = buf_goods.prod-type
     1376           and buf_doc-line.prod-code = buf_goods.prod-code
     1377           and buf_doc-line.status_   = 'факт':U
     1378       , first buf_trn-doc no-lock
     1379         where buf_trn-doc.doc-code = buf_doc-line.doc-code
     1380           and buf_trn-doc.doc-type = 'при':U
     1381           and buf_trn-doc.internal = false
     1382           and buf_trn-doc.fact-date >= v-first-date
     1383           and buf_trn-doc.fact-date <= v-last-date
     1384       :
     1385         for each buf_parts no-lock
     1386           where buf_parts.out-code  = buf_doc-line.doc-code
     1387             and buf_parts.obj-type  = buf_doc-line.obj-type
     1388             and buf_parts.obj-code  = buf_doc-line.obj-code
     1389             and buf_parts.artic     = buf_doc-line.artic
     1390             and buf_parts.prod-type = buf_doc-line.prod-type
     1391             and buf_parts.prod-code = buf_doc-line.prod-code
     1392         :
     1393           display stream PrnLibStream
     1394             buf_goods.gds-name
     1395             buf_trn-doc.fact-date
     1396             ( buf_parts.fact-qnty * buf_doc-line.fact-density ) @ buf_parts.cli-qnty
     1397             buf_doc-line.fact-density
     1398             buf_parts.fact-qnty
     1399             buf_units.long-name
     1400             with frame input-frm .
     1401           down stream PrnLibStream 1 with frame input-frm .
     1402           assign
     1403             v-total-cli-qnty  = v-total-cli-qnty  + ( buf_parts.fact-qnty * buf_doc-line.fact-density )
     1404             v-total-fact-qnty = v-total-fact-qnty + buf_parts.fact-qnty
     1405           .
     1406         end.
     1407       end.
     1408       display stream PrnLibStream
     1409         "ВСЕГО " + v-header-name + " " + buf_goods.gds-name  @ buf_goods.gds-name
     1410         v-total-cli-qnty @ buf_parts.cli-qnty
     1411         v-total-fact-qnty @ buf_parts.fact-qnty
     1412         buf_units.long-name
     1413         with frame input-frm .
     1414       down stream PrnLibStream 1 with frame input-frm .
     1415       put stream PrnLibStream
     1416         SKIP(2)
     1417         .
     1418     end.
     1419     hide frame input-frm .
     1420     assign
     1421       v-header-name = "РАСХОДЫ "
     1422     .
     1423     run next-page in this-procedure .
     1424     define frame output-frm
     1425       buf_goods.gds-name     format "x(52)" column-label "ТОВАР"
     1426       buf_trn-doc.fact-date                 column-label "ДАТА"
     1427       buf_doc-line.fact-qnty                column-label "КОЛ-ВО"
     1428       buf_units.long-name    format "x(20)" column-label "ЕД.ИЗМ."
     1429       with width 160 down stream-io use-text .
     1430     form with frame output-frm .
     1431     for each gds-list no-lock
     1432     ,first buf_goods no-lock
     1433       where buf_goods.artic     = gds-list.artic
     1434         and buf_goods.prod-type = gds-list.prod-type
     1435         and buf_goods.prod-code = gds-list.prod-code
     1436     :
     1437       find first buf_units no-lock
     1438         where buf_units.unit-name = buf_goods.unit-base
     1439         .
     1440       assign
     1441         v-ind = v-ind + 1
     1442       .
     1443       process events .
     1444       run waitfram-show in this-procedure ( "Линий обработано: " + string(v-ind) ) .
     1445       assign
     1446         v-total-fact-qnty = 0
     1447       .
     1448       for each buf_doc-line no-lock
     1449         where buf_doc-line.obj-type  = p-curr-obj-type
     1450           and buf_doc-line.obj-code  = p-curr-obj-code
     1451           and buf_doc-line.artic     = buf_goods.artic
     1452           and buf_doc-line.prod-type = buf_goods.prod-type
     1453           and buf_doc-line.prod-code = buf_goods.prod-code
     1454           and buf_doc-line.status_   = 'факт':U
     1455       , first buf_trn-doc no-lock
     1456         where buf_trn-doc.doc-code = buf_doc-line.doc-code
     1457           and buf_trn-doc.doc-type = 'рас':U
     1458           and buf_trn-doc.internal = false
     1459           and buf_trn-doc.fact-date >= v-first-date
     1460           and buf_trn-doc.fact-date <= v-last-date
     1461       :
     1462         display stream PrnLibStream
     1463           buf_goods.gds-name
     1464           buf_trn-doc.fact-date
     1465           buf_doc-line.fact-qnty
     1466           buf_units.long-name
     1467           with frame output-frm .
     1468         down stream PrnLibStream 1 with frame output-frm .
     1469         assign
     1470           v-total-fact-qnty = v-total-fact-qnty + buf_doc-line.fact-qnty
     1471         .
     1472       end.
     1473       display stream PrnLibStream
     1474         "ВСЕГО " + v-header-name + " " + buf_goods.gds-name  @ buf_goods.gds-name
     1475         v-total-fact-qnty @ buf_doc-line.fact-qnty
     1476         buf_units.long-name
     1477         with frame output-frm .
     1478       down stream PrnLibStream 1 with frame output-frm .
     1479       put stream PrnLibStream
     1480         SKIP(2)
     1481         .
     1482     end.
     1483     hide frame output-frm .
     1484     assign
     1485       v-header-name = "ОСТАТОК НА КОНЕЦ МЕСЯЦА"
     1486     .
     1487     run next-page in this-procedure .
     1488     define frame stock-frm
     1489       buf_goods.gds-name      format "x(52)" column-label "ТОВАР"
     1490       var-Quantity        column-label "КОЛ-ВО"
     1491       buf_units.long-name     format "x(20)" column-label "ЕД.ИЗМ."
     1492       with width 160 down stream-io use-text .
     1493     form with frame stock-frm .
     1494     for each gds-list no-lock
     1495     ,first buf_goods no-lock
     1496       where buf_goods.artic     = gds-list.artic
     1497         and buf_goods.prod-type = gds-list.prod-type
     1498         and buf_goods.prod-code = gds-list.prod-code
     1499     :
     1500       find first buf_units no-lock
     1501         where buf_units.unit-name = buf_goods.unit-base
     1502         .
     1503       assign
     1504         v-ind = v-ind + 1
     1505       .
     1506       process events .
     1507       run waitfram-show in this-procedure ( "Линий обработано: " + string(v-ind) ) .
     1508       assign
     1509         v-total-fact-qnty = 0
     1510       .
     1511       for each obj-list:
     1512           delete obj-list.
     1513       end.
     1514   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1515   run create_obj-list in this-procedure
     1516    ( input ub.clients.obj-type ,
     1517      input ub.clients.obj-code )
     1518      .
     1519       assign
     1520         var-x-p-curr-obj-code  = ub.clients.obj-code
     1521         var-x-p-curr-obj-type  = ub.clients.obj-type
     1522         var-x-date-start  = v-last-date
     1523         var-x-date-endt   = ?
     1524         var-x-sum-type    = 'cost':U
     1525         var-x-cat-id      = '##,##':U
     1526         var-xTog-obj      = yes
     1527       .
     1528       run ostatok   (input var-x-p-curr-obj-code,
     1529                      input var-x-p-curr-obj-type,
     1530                      input no,
     1531                      input var-x-date-start,
     1532                      input var-x-date-endt ,
     1533                      input ?               ,
     1534                      input ?               ,
     1535                      input var-x-sum-type  ,
     1536                      input var-x-cat-id    ,
     1537                      input var-xTog-obj    ,
     1538                      output var-Quantity   ,
     1539                      output var-Coast_R    ,
     1540                      output var-Coast_V    ,
     1541                      output var-VAT_R      ,
     1542                      output var-VAT_V      ,
     1543                      output var-Fact-order ).
     1544      ASSIGN var-x-artic     = buf_goods.artic
     1545             var-x-prod-code = buf_goods.prod-code
     1546             var-x-prod-type = buf_goods.prod-type.
     1547      RUN ost-line  (
     1548         input   var-x-p-curr-obj-code,
     1549         input   var-x-p-curr-obj-type,
     1550         INPUT   var-x-artic     ,
     1551         INPUT   var-x-prod-code ,
     1552         INPUT   var-x-prod-type ,
     1553         input   no              ,
     1554         INPUT   var-Fact-order  ,
     1555         input   var-x-sum-type  ,
     1556         input   var-x-cat-id    ,
     1557         input   var-xTog-obj    ,
     1558         output  var-Quantity    ,
     1559         output  var-Coast_R     ,
     1560         output  var-Coast_V     ,
     1561         output  var-VAT_R       ,
     1562         output  var-VAT_V       ,
     1563         output  var-SLT_R       ,
     1564         output  var-SLT_V       ).
     1565       display stream PrnLibStream
     1566         "ОСТАТОК " + buf_goods.gds-name @ buf_goods.gds-name
     1567         var-Quantity
     1568         buf_units.long-name
     1569         with frame stock-frm .
     1570       down stream PrnLibStream 1 with frame stock-frm .
     1571       put stream PrnLibStream
     1572         SKIP(2)
     1573         .
     1574     end.
     1575     hide frame stock-frm .
     1576     run on-same-page in this-procedure (input 2) .
     1577     put stream PrnLibStream
     1578       v-line  skip
     1579       space(10) "Всего страниц" page-number(PrnLibStream) skip
     1580       .
     1581     hide stream PrnLibStream frame bottomframe .
     1582     output stream PrnLibStream close.
     1583     run waitfram-hide in this-procedure .
     1584     run prn-lib-prn-file in this-procedure (
     1585                                             input parParentProc
     1586                                             ,input 8
     1587                                             ).
     1588   end.
     1589   procedure on-same-page :
     1590     define input parameter p-line-number as integer no-undo .
     1591     if p-line-number > page-size( PrnLibStream ) then do:
     1592       return .
     1593     end.
     1594     if line-counter( PrnLibStream ) + p-line-number > page-size( PrnLibStream ) then do:
     1595       page stream PrnLibStream .
     1596     end.
     1597   end procedure.
     1598   procedure next-page :
     1599     page stream PrnLibStream .
     1600   end procedure.
