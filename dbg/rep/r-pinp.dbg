     1135   define variable var-x-prod-type   like ub.stk-line.prod-type    no-undo.
     1136   define variable var-SLT_R         like ub.stk-tot.sum-rubl    no-undo.
     1137   define variable var-SLT_V         like ub.stk-tot.sum-rubl    no-undo.
     1138   define variable v-today      as date      no-undo .
     1139   define variable v-archive-ok as logical   no-undo .
     1140   define variable v-comment    as character no-undo .
     1141   define variable v-can-print  as logical   no-undo .
     1142   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1143   define new shared temp-table gds-list no-undo like ub.goods
     1144     field qnty   as decimal
