        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-curr-obj-type like ub.clients.obj-type no-undo .
        4   define input parameter p-curr-obj-code like ub.clients.obj-code no-undo .
        5   def var vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        6   def var vss-author      as character no-undo init "$Author: expertek $":U .
        7   def var vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        8   def var vss-workfile    as character no-undo init "$Workfile: r-pinp.p $":U .
        9   def var vss-archive     as character no-undo init "$Archive: rep/r-pinp.p $":U .
       10   def var vss-description as character no-undo init "Топливо: приходы, расходы, остатки на конец месяца".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define new global shared variable g#library  as handle no-undo .
       70   define new global shared variable g#library2 as handle no-undo .
       71   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       72   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
       73   define new shared variable RepPathName        as character no-undo .
       74   define new shared variable PrintRubl          as logical   no-undo .
       75   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       76   define  stream PrnLibStream.
       77   procedure prn-lib-prn-file :
       78     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
       79     define input parameter p-DIsabledoptions as integer no-undo .
       80     define variable v-report-name as character no-undo .
       81     define variable v-user-action as character no-undo .
       82     define variable v-printed     as logical   no-undo .
       83     define variable v-exist       as logical   no-undo .
       84     do
       85       on error undo, return error
       86       :
       87       run prn-lib-get-report-name  in this-procedure (
       88         input parParentProc
       89         ,output v-report-name
       90         ).
       91   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       92   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
       93     (input  v-report-name
       94     ,input  2
       95     ,output v-exist
       96     )  .
       97       if NOT v-exist then
       98       DO:
       99         Message
      100           "Нет заданий на печать ! "
      101           view-as alert-box .
      102         Return  .
      103       End.
      104       run gbl/prnfilen.w
      105         (input  ""
      106         ,input  p-DisabledOptions
      107         ,input  string(v-report-name )
      108         ,input  7
      109         ,output v-user-action
      110         ,output v-printed
      111         ) .
      112       if v-printed then
      113       do:
      114         return "YES" .
      115       end.
      116       else
      117       do:
      118         return "NO" .
      119       end.
      120     end.
      121   end procedure.
      122   procedure prn-lib-open-stream :
      123     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      124     define input parameter p-page-size    as integer no-undo .
      125     define input parameter p-is-stream    as logical no-undo .
      126     define input parameter p-append       as logical no-undo .
      127     define variable v-report-name as character no-undo .
      128     do
      129       on error undo, return error
      130       :
      131       run prn-lib-get-report-name  in this-procedure (
      132         input parParentProc
      133         ,output v-report-name
      134         ).
      135       if p-is-stream then
      136       do:
      137         if p-append then
      138         do:
      139           output stream PrnLibStream to value( v-report-name )
      140             page-size value(p-page-size) append .
      141         end.
      142         if not p-append then
      143         do:
      144           output stream PrnLibStream to value( v-report-name )
      145             page-size value(p-page-size) .
      146         end.
      147       end.
      148       if not p-is-stream then
      149       do:
      150         if p-append then
      151         do:
      152           output to value( v-report-name )
      153             page-size value(p-page-size) append .
      154         end.
      155         if not p-append then
      156         do:
      157           output to value( v-report-name )
      158             page-size value(p-page-size) .
      159         end.
      160       end.
      161     end.
      162   end procedure.
      163   procedure prn-lib-open-exp :
      164     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      165     define input parameter p-is-stream    as logical no-undo .
      166     define input parameter p-is-append    as logical no-undo .
      167     define output parameter p-ReportFileName as char init "report" no-undo.
      168     define output parameter p-process as logical no-undo .
      169     define variable glog as logical no-undo .
      170     do
      171       on error undo, return error
      172       :
      173       SYSTEM-DIALOG GET-FILE p-ReportFileName
      174         TITLE      "Укажите путь"
      175         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      176         ASK-OVERWRITE
      177         CREATE-TEST-FILE
      178         SAVE-AS
      179         USE-FILENAME
      180         DEFAULT-EXTENSION "txt"
      181         UPDATE glog
      182         .
      183       if not glog then  return.
      184       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      185       if p-is-stream then
      186       do:
      187         if p-is-append then
      188         do:
      189           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      190         end.
      191         else
      192         do:
      193           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      194         end.
      195       end.
      196       else
      197       do:
      198         if p-is-append then
      199         do:
      200           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      201         end.
      202         else
      203         do:
      204           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      205         end.
      206       end.
      207       p-process = yes.
      208     end.
      209   end procedure.
      210   procedure prn-lib-get-report-name :
      211     define input parameter parParentProc  as widget-handle no-undo.
      212     define output parameter p-report-name as character no-undo .
      213     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      214   end procedure.
      215   procedure prn-lib-reportviewer-report-name :
      216     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      217     define input parameter p-report-name-html as character no-undo .
      218     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      219   end procedure.
      220   procedure prn-lib-reportviewer :
      221     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      222     define input parameter p-report-name-html as character no-undo .
      223     define input parameter p-param        as character no-undo .
      224     define variable v-excel           as character no-undo init 'TRUE' .
      225     define variable v-value-character as character no-undo .
      226     define variable v-value-integer   as character no-undo .
      227     define variable v-value-date      as date      no-undo .
      228     define variable v-value-decimal   as decimal   no-undo .
      229     define variable rep-excel         as logical   no-undo .
      230     define variable excel-string      as character no-undo .
      231     define variable v-param-type      as character no-undo .
      232     define variable v-tth             as handle    no-undo .
      233     run adm/shattri.p (
      234       input "get":U
      235       ,input  ""
      236       ,input  0
      237       ,input  'report-glob':U
      238       ,input  'rep-excel':U
      239       ,output v-value-character
      240       ,output v-value-date
      241       ,output v-value-decimal
      242       ,output v-value-integer
      243       ,output rep-excel
      244       ,output v-param-type
      245       ,INPUT-OUTPUT table-handle v-tth
      246       )  .
      247     if rep-excel then v-excel = "TRUE" .
      248     else v-excel = "FALSE" .
      249     if p-param eq ""
      250     then
      251        p-param = "EXCEL:" + v-excel.
      252     else
      253        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      254     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      255   end procedure.
      256   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      257   PROCEDURE LastDate:
      258       def input parameter in-date as date no-undo.
      259       def output parameter LastDate as date no-undo.
      260       LastDate = ((DATE(MONTH(in-date),28,YEAR(in-date)) + 4) - DAY(DATE(MONTH(in-date),28,YEAR(in-date)) + 4)).
      261   END PROCEDURE.
      262   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      263     define variable v-cntxt-db-num        as integer   no-undo .
      264     define variable v-cntxt-userid        as character no-undo .
      265     define variable v-cntxt-level         as character no-undo .
      266     define variable v-cntxt-host-code-obj as integer   no-undo .
      267     define variable v-cntxt-obj-type      as character no-undo .
      268     define variable v-cntxt-obj-code      as integer   no-undo .
      269     define variable v-cntxt-db-num-obj    as integer   no-undo .
      270     define variable v-cntxt-is-admin      as logical   no-undo .
      271   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      272   def
      273   new shared
      274   temp-table  obj-list no-undo
      275     field obj-type like ub.clients.obj-type
      276     field obj-code like ub.clients.obj-code
      277     field obj-name like ub.clients.obj-name
      278     field obj-id   as integer
      279     field db-num   as integer
      280     index pi is primary unique obj-id
      281     index ie1 obj-type obj-code
      282     index ie2 obj-name
      283   .
      284   procedure create_obj-list :
      285      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      286      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      287      do
      288      on error undo, return error return-value
      289      :
      290         define buffer cli-obj for ub.clients .
      291         define variable p-var as integer no-undo .
      292         define buffer buf_obj-list for obj-list .
      293         find last buf_obj-list  use-index pi no-error .
      294         if available buf_obj-list
      295         then
      296            p-var = buf_obj-list.obj-id + 1.
      297         else
      298            p-var = 1.
      299         find first cli-obj where
      300                   cli-obj.obj-type = p-obj-type
      301               and cli-obj.obj-code = p-obj-code
      302         no-lock no-error.
      303         if available cli-obj
      304         then do:
      305            create buf_obj-list.
      306            assign
      307               buf_obj-list.obj-id   = p-var
      308               buf_obj-list.obj-code = cli-obj.obj-code
      309               buf_obj-list.obj-type = cli-obj.obj-type
      310               buf_obj-list.obj-name = cli-obj.obj-name
      311               buf_obj-list.db-num   = cli-obj.db-num
      312            .
      313         end.
      314      end.
      315   end.
      316   PROCEDURE ostatok :
      317   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
      318   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
      319   def input parameter x-tog-shift   as   logical             no-undo.
      320   def input parameter x-date-start  like ub.stk-tot.Fact-date   no-undo.
      321   def input parameter x-date-end    like ub.stk-tot.Fact-date   no-undo.
      322   def input parameter x-shift-start as integer               no-undo.
      323   def input parameter x-shift-end   as integer               no-undo.
      324   def input parameter x-sum-type    like ub.stk-tot.sum-type    no-undo.
      325   def input parameter x-cat-id      like ub.stk-tot.cat-id      no-undo.
      326   def input parameter xTog-obj   as log no-undo.
      327   def output parameter Quantity    like ub.stk-tot.fact-qnty   no-undo.
      328   def output parameter Coast_R     like ub.stk-tot.sum-rubl    no-undo.
      329   def output parameter Coast_V     like ub.stk-tot.sum-rubl    no-undo.
      330   def output parameter VAT_R       like ub.stk-tot.sum-rubl    no-undo.
      331   def output parameter VAT_V       like ub.stk-tot.sum-rubl    no-undo.
      332   def output parameter Fact-order  like ub.stk-tot.Fact-order  no-undo.
      333   def var              Fact-order#   like ub.stk-tot.Fact-order  no-undo.
      334   def var              Fact-orderS   as char  no-undo.
      335   def var x-date-start-t  like ub.stk-tot.shift-date   no-undo.
      336      Assign
      337         Fact-order   = 0
      338         Quantity     = 0
      339         Coast_R      = 0
      340         Coast_V      = 0
      341         VAT_R        = 0
      342         VAT_V        = 0 .
      343    x-date-start-t  = x-date-start + 1 .
      344   IF x-date-end = date('') then DO:
      345      Fact-order = 0 .
      346      for each obj-list
      347          where  ( not xtog-obj or
      348                 ( x-store-type = obj-list.obj-type and x-store-code = obj-list.obj-code ))
      349                 no-lock :
      350         if  x-tog-shift = false then do:
      351                          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
      352                               ub.stk-tot.Fact-date <=  x-date-start
      353                               and ub.stk-tot.shift-num = 0
      354                               USE-INDEX fact-date no-lock no-error .
      355              if Available ub.stk-tot THEN  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
      356         End.
      357         Else  DO :
      358             find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
      359              (ub.stk-tot.shift-date  = x-date-start-t and
      360               ub.stk-tot.shift-num  < x-shift-start or
      361               ub.stk-tot.shift-date  < x-date-start-t  )
      362               and ub.stk-tot.shift-num  > 0
      363               USE-INDEX Shift-num no-lock no-error .
      364            If Available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
      365           END.
      366       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
      367     End.
      368   End.
      369   Else DO:
      370     For each obj-list  WHERE
      371        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
      372         no-lock :
      373      IF  x-TOG-Shift = False Then DO:
      374          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
      375               ub.stk-tot.Fact-date <= x-date-end
      376               and ub.stk-tot.shift-num = 0
      377               USE-INDEX fact-date no-lock no-error.
      378          if available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
      379      END.
      380      Else DO:
      381           find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
      382               (ub.stk-tot.shift-date  = x-date-end and
      383               ub.stk-tot.shift-num  <= x-shift-end or
      384               ub.stk-tot.shift-date  < x-date-end       ) and
      385               ub.stk-tot.shift-num   > 0      use-index shift-num no-lock no-error.
      386               if Available ub.stk-tot THEN Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
      387       End.
      388       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
      389     End.
      390   End.
      391   END PROCEDURE.
      392   procedure ost-line :
      393     define input  parameter x-store-code like ub.clients.obj-code    no-undo .
      394     define input  parameter x-store-type like ub.clients.obj-type    no-undo .
      395     define input  parameter x-artic      like ub.stk-line.artic      no-undo .
      396     define input  parameter x-prod-code  like ub.stk-line.prod-code  no-undo .
      397     define input  parameter x-prod-type  like ub.stk-line.prod-type  no-undo .
      398     define input  parameter x-tog-shift  as logical no-undo .
      399     define input  parameter x-fact-order like ub.stk-line.fact-order no-undo .
      400     define input  parameter x-sum-type   like ub.stk-line.sum-type   no-undo .
      401     define input  parameter x-cat-id     like ub.stk-line.cat-id     no-undo .
      402     define input  parameter xtog-obj     as logical no-undo .
      403     define output parameter quantity     like ub.stk-line.fact-qnty  no-undo .
      404     define output parameter coast_r      like ub.stk-line.sum-rubl   no-undo .
      405     define output parameter coast_v      like ub.stk-line.sum-rubl   no-undo .
      406     define output parameter vat_r        like ub.stk-line.sum-rubl   no-undo .
      407     define output parameter vat_v        like ub.stk-line.sum-rubl   no-undo .
      408     define output parameter slt_r        like ub.stk-line.sum-rubl   no-undo .
      409     define output parameter slt_v        like ub.stk-line.sum-rubl   no-undo .
      410     define buffer buff-obj-list  for obj-list .
      411     define buffer buff-stk-line  for ub.stk-line .
      412     assign
      413       Quantity = 0
      414       Coast_R  = 0
      415       Coast_V  = 0
      416       VAT_R    = 0
      417       VAT_V    = 0
      418       SLT_R    = 0
      419       SLT_V    = 0
      420     .
      421     if  x-tog-shift = false then do:
      422       for each buff-obj-list no-lock
      423         where xtog-obj = false
      424            or (buff-obj-list.obj-type = x-store-type
      425               and buff-obj-list.obj-code = x-store-code
      426               )
      427       on error undo, return error
      428       :
      429         find last buff-stk-line no-lock
      430           where buff-stk-line.obj-type   = buff-obj-list.obj-type
      431             and buff-stk-line.obj-code   = buff-obj-list.obj-code
      432             and buff-stk-line.artic      = x-artic
      433             and buff-stk-line.prod-type  = x-prod-type
      434             and buff-stk-line.prod-code  = x-prod-code
      435             and buff-stk-line.sum-type   = x-sum-type
      436             and buff-stk-line.cat-id     = '##,##':U
      437             and buff-stk-line.fact-order <= x-fact-order
      438             and buff-stk-line.shift-num  = 0
      439           use-index category
      440           no-error .
      441         if available buff-stk-line then do:
      442           assign
      443             Quantity = Quantity +  buff-stk-line.fact-qnty
      444             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
      445             Coast_V  = Coast_V  +  buff-stk-line.sum-base
      446             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
      447             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
      448             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
      449             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
      450           .
      451         end.
      452       end.
      453     end.
      454     else do:
      455       for each buff-obj-list no-lock
      456         where xtog-obj = false
      457            or (buff-obj-list.obj-type = x-store-type
      458               and buff-obj-list.obj-code = x-store-code
      459               )
      460       on error undo, return error
      461       :
      462         find last buff-stk-line no-lock
      463           where buff-stk-line.obj-type   = buff-obj-list.obj-type
      464             and buff-stk-line.obj-code   = buff-obj-list.obj-code
      465             and buff-stk-line.artic      = x-artic
      466             and buff-stk-line.prod-type  = x-prod-type
      467             and buff-stk-line.prod-code  = x-prod-code
      468             and buff-stk-line.sum-type   = x-sum-type
      469             and buff-stk-line.cat-id     = '##,##':U
      470             and buff-stk-line.fact-order <= x-fact-order
      471             and buff-stk-line.shift-num  > 0
      472           use-index category
      473           no-error .
      474         if available buff-stk-line then do:
      475           assign
      476             Quantity = Quantity +  buff-stk-line.fact-qnty
      477             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
      478             Coast_V  = Coast_V  +  buff-stk-line.sum-base
      479             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
      480             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
      481             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
      482             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
      483           .
      484         end.
      485       end.
      486     end.
      487   end procedure.
      488   procedure ost-lineother-tax :
      489     define input  parameter x-store-code like ub.clients.obj-code      no-undo.
      490     define input  parameter x-store-type like ub.clients.obj-type      no-undo.
      491     define input  parameter x-artic      like ub.stk-line.artic        no-undo.
      492     define input  parameter x-prod-code  like ub.stk-line.prod-code    no-undo.
      493     define input  parameter x-prod-type  like ub.stk-line.prod-type    no-undo.
      494     define input  parameter x-tog-shift  as logical no-undo .
      495     define input  parameter x-fact-order like ub.stk-line.fact-order   no-undo.
      496     define input  parameter x-sum-type   like ub.stk-line.sum-type     no-undo.
      497     define input  parameter x-type-id    like ub.stk-line.cat-id       no-undo.
      498     define input  parameter xTog-obj     as logical no-undo .
      499     define output parameter Quantity     like ub.stk-line.fact-qnty   no-undo.
      500     define output parameter Coast_R      like ub.stk-line.sum-rubl    no-undo.
      501     define output parameter Coast_V      like ub.stk-line.sum-rubl    no-undo.
      502     define output parameter VAT_R        like ub.stk-line.sum-rubl    no-undo.
      503     define output parameter VAT_V        like ub.stk-line.sum-rubl    no-undo.
      504     define output parameter SLT_R        like ub.stk-line.sum-rubl    no-undo.
      505     define output parameter SLT_V        like ub.stk-line.sum-rubl    no-undo.
      506     define output parameter other_R      like ub.stk-line.sum-rubl    no-undo.
      507     define output parameter other_V      like ub.stk-line.sum-rubl    no-undo.
      508     define buffer buff-obj-list  for obj-list .
      509     define buffer buff-stk-line  for ub.stk-line .
      510     assign
      511       Quantity = 0
      512       Coast_R  = 0
      513       Coast_V  = 0
      514       VAT_R    = 0
      515       VAT_V    = 0
      516       SLT_R    = 0
      517       SLT_V    = 0
      518       other_R  = 0
      519       other_V  = 0
      520     .
      521     if  x-tog-shift = false then do:
      522       for each buff-obj-list no-lock
      523         where xtog-obj = false
      524            or (buff-obj-list.obj-type = x-store-type
      525               and buff-obj-list.obj-code = x-store-code
      526               )
      527       on error undo, return error
      528       :
      529         find last buff-stk-line no-lock
      530           where buff-stk-line.obj-type   = buff-obj-list.obj-type
      531             and buff-stk-line.obj-code   = buff-obj-list.obj-code
      532             and buff-stk-line.artic      = x-artic
      533             and buff-stk-line.prod-type  = x-prod-type
      534             and buff-stk-line.prod-code  = x-prod-code
      535             and buff-stk-line.sum-type   = x-sum-type
      536             and buff-stk-line.cat-id     = '##,##':U
      537             and buff-stk-line.fact-order <= x-fact-order
      538             and buff-stk-line.shift-num  = 0
      539           use-index category
      540           no-error .
      541         if available buff-stk-line then do:
      542           assign
      543             Quantity = Quantity +  buff-stk-line.fact-qnty
      544             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
      545             Coast_V  = Coast_V  +  buff-stk-line.sum-base
      546             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
      547             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
      548             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
      549             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
      550             other_R  = other_R  +  buff-stk-line.other-rubl
      551             other_V  = other_V  +  buff-stk-line.other-base
      552           .
      553         end.
      554       end.
      555     end.
      556     else do:
      557       for each buff-obj-list no-lock
      558         where xtog-obj = false
      559            or (buff-obj-list.obj-type = x-store-type
      560               and buff-obj-list.obj-code = x-store-code
      561               )
      562       on error undo, return error
      563       :
      564         find last buff-stk-line no-lock
      565           where buff-stk-line.obj-type   = buff-obj-list.obj-type
      566             and buff-stk-line.obj-code   = buff-obj-list.obj-code
      567             and buff-stk-line.artic      = x-artic
      568             and buff-stk-line.prod-type  = x-prod-type
      569             and buff-stk-line.prod-code  = x-prod-code
      570             and buff-stk-line.sum-type   = x-sum-type
      571             and buff-stk-line.cat-id     = '##,##':U
      572             and buff-stk-line.fact-order <= x-fact-order
      573             and buff-stk-line.shift-num  > 0
      574           use-index category
      575           no-error .
      576         if available buff-stk-line then do:
      577           assign
      578             Quantity = Quantity +  buff-stk-line.fact-qnty
      579             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
      580             Coast_V  = Coast_V  +  buff-stk-line.sum-base
      581             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
      582             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
      583             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
      584             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
      585             other_R = other_R   +  buff-stk-line.other-rubl
      586             other_V = other_V   +  buff-stk-line.other-base
      587           .
      588         end.
      589       end.
      590     end.
      591   end procedure.
      592   procedure ost-line-kg :
      593     define  input parameter p-obj-code    like ub.stk-line.obj-code   no-undo .
      594     define  input parameter p-obj-type    like ub.stk-line.obj-type   no-undo .
      595     define  input parameter p-artic       like ub.stk-line.artic      no-undo .
      596     define  input parameter p-prod-code   like ub.stk-line.prod-code  no-undo .
      597     define  input parameter p-prod-type   like ub.stk-line.prod-type  no-undo .
      598     define  input parameter p-fact-order  like ub.stk-line.fact-order no-undo .
      599     define output parameter p-quantity-kg like ub.stk-line.fact-qnty  no-undo initial 0.00 .
      600     define buffer buff-obj-list  for obj-list .
      601     define buffer buf_doc-line for ub.doc-line .
      602     define buffer buf_inv-line for ub.inv-line .
      603     do
      604     on error undo, return error
      605     :
      606       for each buf_doc-line no-lock where
      607                buf_doc-line.obj-type    = p-obj-type   and
      608                buf_doc-line.obj-code    = p-obj-code   and
      609                buf_doc-line.prod-type   = p-prod-type  and
      610                buf_doc-line.prod-code   = p-prod-code  and
      611                buf_doc-line.artic       = p-artic      and
      612                buf_doc-line.status_     = 'факт':U      and
      613                buf_doc-line.fact-order <= p-fact-order
      614             by buf_doc-line.fact-order    descending
      615       :
      616         find first buf_inv-line no-lock where
      617                    buf_inv-line.doc-code  = buf_doc-line.doc-code  and
      618                    buf_inv-line.artic     = buf_doc-line.artic     and
      619                    buf_inv-line.prod-type = buf_doc-line.prod-type and
      620                    buf_inv-line.prod-code = buf_doc-line.prod-code no-error .
      621         if available buf_inv-line
      622         then do:
      623           if buf_inv-line.after-cli-qnty <> ?
      624           then do:
      625             assign
      626               p-quantity-kg = buf_inv-line.after-cli-qnty
      627             .
      628             leave .
      629           end.
      630         end.
      631       end.
      632       if p-quantity-kg = ?
      633       then do:
      634         assign
      635           p-quantity-kg = 0
      636         .
      637       end.
      638     end.
      639   end procedure.
      640   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      641   procedure cur-time :
      642      define output parameter p-today as date      no-undo .
      643      define output parameter p-time  as integer   no-undo .
      644     do
      645     on error undo, return error
      646     :
      647       define variable v-date1 as date      no-undo .
      648       define variable v-date2 as date      no-undo .
      649       define variable v-time  as integer   no-undo .
      650       assign
      651         v-date1 = today
      652         v-time  = time
      653         v-date2 = today
      654       .
      655       if v-date1 <> v-date2
      656       then do:
      657         assign
      658           v-date1 = today
      659           v-time  = v-time
      660         .
      661       end.
      662       assign
      663         p-today = v-date1
      664         p-time  = v-time
      665       .
      666     end.
      667   end.
      668   function cur-time-date returns character
      669   :
      670     return string(today, '99/99/9999':U) .
      671   end.
      672   function cur-time-mjd returns decimal
      673   :
      674     define variable v-date as date      no-undo .
      675     define variable v-time as integer   no-undo .
      676     run cur-time in this-procedure
      677       (output v-date
      678       ,output v-time
      679       ) .
      680     return integer(v-date) - 2400002 + (v-time / 86400) .
      681   end.
      682   function cur-time-get-ending-index returns integer
      683   (input p-number as integer
      684   )
      685   :
      686     if p-number < 0
      687     or p-number = ?
      688     then do:
      689       return 1 .
      690     end.
      691     define variable v-rest as integer   no-undo .
      692     assign
      693       p-number = p-number modulo 100
      694     .
      695     if p-number < 20
      696     then do:
      697       assign
      698         v-rest = p-number
      699       .
      700     end.
      701     else do:
      702       assign
      703         v-rest = p-number modulo 10
      704       .
      705     end.
      706     case v-rest :
      707       when 1
      708       then do:
      709         return 2 .
      710       end.
      711       when 2 or
      712       when 3 or
      713       when 4
      714       then do:
      715         return 3 .
      716       end.
      717       otherwise do:
      718         return 1 .
      719       end.
      720     end case .
      721   end.
      722   procedure cur-time-mjd-to-date :
      723      define input  parameter i-mjd-diff as decimal no-undo.
      724      define output parameter o-Date     as date    no-undo.
      725      define output parameter o-Time     as integer no-undo.
      726      define variable v-day-number as integer   no-undo .
      727      if    i-mjd-diff < 0
      728         or i-mjd-diff = ?
      729      then do:
      730         return "?" .
      731      end.
      732      assign
      733         v-day-number = truncate(i-mjd-diff,0).
      734         o-Date = date(v-day-number + 2400002).
      735         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      736     .
      737   end.
      738   function cur-time-mjd-to-string returns character
      739   (input p-mjd-diff as decimal
      740   )
      741   :
      742     define variable v-day-number as integer   no-undo .
      743     define variable v-seconds    as integer   no-undo .
      744     define variable v-hour       as integer   no-undo .
      745     define variable v-min        as integer   no-undo .
      746     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      747     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      748     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      749     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      750     if p-mjd-diff < 0
      751     or p-mjd-diff = ?
      752     then do:
      753       return "?" .
      754     end.
      755     assign
      756       v-day-number = integer(truncate(p-mjd-diff,0))
      757       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      758     .
      759     if v-seconds > 86400
      760     then do:
      761       assign
      762         v-seconds = 86400 - 1
      763       .
      764     end.
      765     if v-seconds < 0
      766     then do:
      767       assign
      768         v-seconds = 0
      769       .
      770     end.
      771     assign
      772       v-hour = truncate(v-seconds / 3600, 0)
      773     .
      774     assign
      775       v-seconds = v-seconds modulo 3600
      776     .
      777     assign
      778       v-min = truncate(v-seconds / 60, 0)
      779     .
      780     assign
      781       v-seconds = v-seconds modulo 60
      782     .
      783     return
      784         (if v-day-number <> 0
      785           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      786           else ""
      787         )
      788       + (if v-day-number <> 0 or v-hour <> 0
      789           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      790           else ""
      791         )
      792       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      793           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      794           else ""
      795         )
      796       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      797       .
      798   end.
      799   function cur-time-string returns character
      800   :
      801     define variable v-date as date      no-undo .
      802     define variable v-time as integer   no-undo .
      803     run cur-time in this-procedure
      804       (output v-date
      805       ,output v-time
      806       ) .
      807     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      808   end.
      809   function cur-time-string-sec returns character
      810   :
      811     define variable v-date as date      no-undo .
      812     define variable v-time as integer   no-undo .
      813     run cur-time in this-procedure
      814       (output v-date
      815       ,output v-time
      816       ) .
      817     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      818   end.
      819   function cur-time-custom  returns character
      820   (input p-prefix as character
      821   ,input p-date-format as character
      822   ,input p-delimiter as character
      823   ,input p-time-format as character
      824   ,input p-suffix as character
      825   )
      826   :
      827     define variable v-date as date      no-undo .
      828     define variable v-time as integer   no-undo .
      829     run cur-time in this-procedure
      830       (output v-date
      831       ,output v-time
      832       ) .
      833     return
      834       p-prefix
      835       + string(v-date, p-date-format)
      836       + p-delimiter
      837       + string(v-time, p-time-format)
      838       + p-suffix
      839       .
      840   end.
      841   function cur-time-print  returns character
      842   :
      843     define variable v-date as date      no-undo .
      844     define variable v-time as integer   no-undo .
      845     run cur-time in this-procedure
      846       (output v-date
      847       ,output v-time
      848       ) .
      849     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      850   end.
      851   function cur-time-datetime returns datetime
      852   :
      853     define variable v-char as character no-undo .
      854     define variable v-datetime as datetime no-undo .
      855     v-char = cur-time-string().
      856     v-datetime = datetime(v-char).
      857     return  v-datetime.
      858   end.
      859   function cur-time-string-msec returns character
      860   :
      861     define variable v-date as datetime  no-undo .
      862     v-date = now.
      863     return string(v-date) .
      864   end.
      865   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      866   define variable v-waitfram-action01         as character   no-undo .
      867   define variable v-waitfram-action02         as character   no-undo .
      868   define variable v-waitfram-action03         as character   no-undo .
      869   define variable mWaitFramTextBeg            as character   no-undo.
      870   define variable mWaitFramTextEnd            as character   no-undo.
      871   define variable mWaitFramView               as logical     no-undo.
      872   define variable mWaitProcEvent              as logical     no-undo init yes.
      873   define variable mWaitFramInterval           as integer     no-undo init 1 .
      874   define variable mWaitFramStop               as logical     no-undo.
      875   define variable mWaitFramStopUser           as logical     no-undo.
      876   define variable mWaitFramStopTimeOut        as logical     no-undo.
      877   define variable mWaitFramStartProc          as datetime-tz no-undo.
      878   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      879   define button B-WaitFramStop auto-end-key
      880        label "Стоп"
      881        size 10 by 1 tooltip "Остоновить процесс".
      882   define button B-viewProcInfo
      883        label "Информация"
      884        size 15 by 1 tooltip "Информация о процесс".
      885   define frame waitfram
      886     v-waitfram-action01 format "x(72)" no-label skip
      887     v-waitfram-action02 format "x(72)" no-label skip
      888     v-waitfram-action03 format "x(72)" no-label skip
      889     B-viewProcInfo
      890     B-WaitFramStop at row 4 col 30
      891     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      892     .
      893   define new global shared variable mBatchMode as logical no-undo init ?.
      894   define variable mFramBachModHandle as handle no-undo.
      895   mFramBachModHandle = frame waitfram:handle.
      896   define variable mFameOldVis as logical no-undo.
      897   define variable mVisCUrentVin as logical no-undo.
      898   if session:batch-mode
      899   then
      900      mBatchMode = yes.
      901   if mBatchMode = ? then do:
      902     mVisCUrentVin = current-window:visible.
      903     mFameOldVis = mFramBachModHandle:visible.
      904     mFramBachModHandle:visible  = yes.
      905     mBatchMode = mFramBachModHandle:visible ne yes.
      906     mFramBachModHandle:visible = mFameOldVis.
      907     current-window:visible = mVisCUrentVin.
      908   end.
      909    if  log-manager:logfile-name ne ?
      910     then DO:
      911         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      912         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      913         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      914     end.
      915   on choose of B-WaitFramStop in frame waitfram
      916   do:
      917     mWaitFramStop = yes.
      918     mWaitFramStopUser = yes.
      919   end.
      920   function waitfram-check-timeout returns logical():
      921      define variable vtime as int64 no-undo.
      922      if mWaitFramStopTimeOut
      923      then
      924         return yes.
      925      vtime = ( now - mWaitFramStartProc ) / 1000 .
      926      if     mWaitFramTimeOut ne ?
      927         and mWaitFramTimeOut ne 0
      928         and mWaitFramTimeOut lt vtime
      929      then do:
      930         mWaitFramStopTimeOut = yes.
      931      end.
      932      return mWaitFramStopTimeOut.
      933   end.
      934   procedure waitfram-hide :
      935     if not session:batch-mode
      936     then do
      937     on error undo, return error return-value
      938     :
      939       pause 0 before-hide .
      940       if not mBatchMode then
      941         hide frame waitfram .
      942     if     not mWaitFramView
      943        and mWaitProcEvent
      944     then
      945       process events .
      946     end.
      947   end procedure.
      948   procedure waitfram-show :
      949     define input  parameter p-message as character no-undo .
      950     define variable v-left-margin as integer   no-undo .
      951     if not session:batch-mode
      952     then do
      953     on error undo, return error return-value
      954     :
      955       if length(p-message) <= 70 then do:
      956         assign
      957           v-left-margin = integer((70 - length(p-message)) / 2)
      958         .
      959         assign
      960           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      961         .
      962         assign
      963           v-waitfram-action01 = " "
      964           v-waitfram-action02 = " "
      965                                    + fill(" ", v-left-margin)
      966                                    + p-message
      967           v-waitfram-action03 = " "
      968         .
      969       end.
      970       else do:
      971         define variable vRindex1 as integer no-undo.
      972         define variable vRindex2 as integer no-undo.
      973         vRindex1 = r-index(p-message," ",70).
      974         if vRindex1 = 0
      975         then
      976            vRindex1 = 70.
      977         if length(p-message)  <= vRindex1 + 70 then do:
      978           assign
      979             v-waitfram-action01 = " "
      980             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      981             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      982           .
      983         end.
      984         else do:
      985           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      986           if vRindex2 <= vRindex1
      987           then
      988              vRindex2 = vRindex1 + 70.
      989           assign
      990             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      991             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      992             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      993           .
      994         end.
      995       end.
      996       B-viewProcInfo:visible   in frame waitfram = no.
      997       B-viewProcInfo:sensitive in frame waitfram = no.
      998       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      999       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1000       if  (   mWaitFramView
     1001          or  mWaitProcEvent)
     1002          and not mBatchMode
     1003       then
     1004          display
     1005             v-waitfram-action01 skip
     1006             v-waitfram-action02 skip
     1007             v-waitfram-action03 skip
     1008          with frame waitfram .
     1009       if     mWaitFramView
     1010          then do:
     1011             if     mWaitFramInterval ne ?
     1012                and not mBatchMode
     1013             then
     1014                wait-for go of frame waitfram pause mWaitFramInterval.
     1015          end.
     1016          else
     1017             if     mWaitProcEvent
     1018                and not mBatchMode
     1019             then
     1020                process events .
     1021     end.
     1022   end procedure.
     1023      procedure waitfram-show-this:
     1024         define input  parameter iInterval as int64 no-undo.
     1025         define variable vtime as int64 no-undo.
     1026         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1027         mWaitFramInterval = iInterval.
     1028         run waitfram-show (substitute("&1&2 &3&4" ,
     1029                                       mWaitFramTextBeg ,
     1030                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1031                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1032                                       mWaitFramTextEnd
     1033                                      )
     1034                           ).
     1035      end.
     1036      procedure WaitFramRunPause:
     1037         define input  parameter iInterval as dec no-undo.
     1038         define variable vStart  as datetime-tz no-undo.
     1039         define variable vend    as datetime-tz no-undo.
     1040         define variable vint as int64 no-undo.
     1041         define variable vOk as logical no-undo.
     1042         vStart = now.
     1043         vend   = vStart.
     1044         publish "WaitFramPause" (iInterval,output vOk).
     1045         vend   =  now.
     1046         vint = vend - vStart.
     1047         vint = iInterval - vint / 1000.
     1048         if     not mWaitFramStop
     1049            and (   vint > 0
     1050                 or (    not vOk
     1051                     and iInterval eq ?
     1052                     )
     1053                 )
     1054         then
     1055            run waitfram-show-this (iInterval).
     1056         vend   =  now.
     1057         vint = vend - vStart.
     1058         vint = iInterval - vint / 1000.
     1059         if     not mWaitFramStop
     1060            and vint > 0
     1061         then do:
     1062            run gbl/pause.p (vint * 1000).
     1063         end.
     1064         if iInterval ne ?
     1065         then
     1066            publish "WaitFramStop".
     1067         waitfram-check-timeout().
     1068      end.
     1069      procedure WaitFramWaitFor:
     1070         define input  parameter iInterval as dec no-undo.
     1071         assign
     1072            mWaitFramStartProc   = now
     1073            mWaitFramStopUser    = no
     1074            mWaitFramStopTimeOut = no
     1075         .
     1076         block-wait:
     1077         do while not mWaitFramStop:
     1078            run WaitFramRunPause (iInterval).
     1079            if  waitfram-check-timeout()
     1080            then do:
     1081               leave block-wait.
     1082            end.
     1083         end.
     1084         run waitfram-hide.
     1085      end.
     1086   procedure waitfram-join :
     1087     define input  parameter p-line-1  as character no-undo .
     1088     define input  parameter p-line-2  as character no-undo .
     1089     define input  parameter p-line-3  as character no-undo .
     1090     define output parameter p-message as character no-undo .
     1091     do
     1092     on error undo, return error return-value
     1093     :
     1094       assign
     1095         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1096                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1097                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1098       .
     1099     end.
     1100   end procedure.
     1101   function waitfram-join-function returns character
     1102     (input p-line-1 as character
     1103     ,input p-line-2 as character
     1104     ,input p-line-3 as character
     1105     ).
     1106     define variable v-message as character no-undo .
     1107     run waitfram-join in this-procedure
     1108       (input  p-line-1
     1109       ,input  p-line-2
     1110       ,input  p-line-3
     1111       ,output v-message
     1112       ) .
     1113     return v-message .
     1114   end function .
     1115   def var v-month  as integer no-undo format "99"   .
     1116   def var v-year   as integer no-undo format "9999" .
     1117   def var l-ok     as logical no-undo .
     1118   def var v-first-date as date no-undo .
     1119   def var v-last-date  as date no-undo .
     1120   define variable var-x-p-curr-obj-code  like ub.clients.obj-code    no-undo.
