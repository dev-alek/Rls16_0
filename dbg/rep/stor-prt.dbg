        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        4   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        5   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: stor-prt.p $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: rep/stor-prt.p $":U .
        8   define variable vss-description as character no-undo init "Печать списка складов".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       70   procedure cur-time :
       71      define output parameter p-today as date      no-undo .
       72      define output parameter p-time  as integer   no-undo .
       73     do
       74     on error undo, return error
       75     :
       76       define variable v-date1 as date      no-undo .
       77       define variable v-date2 as date      no-undo .
       78       define variable v-time  as integer   no-undo .
       79       assign
       80         v-date1 = today
       81         v-time  = time
       82         v-date2 = today
       83       .
       84       if v-date1 <> v-date2
       85       then do:
       86         assign
       87           v-date1 = today
       88           v-time  = v-time
       89         .
       90       end.
       91       assign
       92         p-today = v-date1
       93         p-time  = v-time
       94       .
       95     end.
       96   end.
       97   function cur-time-date returns character
       98   :
       99     return string(today, '99/99/9999':U) .
      100   end.
      101   function cur-time-mjd returns decimal
      102   :
      103     define variable v-date as date      no-undo .
      104     define variable v-time as integer   no-undo .
      105     run cur-time in this-procedure
      106       (output v-date
      107       ,output v-time
      108       ) .
      109     return integer(v-date) - 2400002 + (v-time / 86400) .
      110   end.
      111   function cur-time-get-ending-index returns integer
      112   (input p-number as integer
      113   )
      114   :
      115     if p-number < 0
      116     or p-number = ?
      117     then do:
      118       return 1 .
      119     end.
      120     define variable v-rest as integer   no-undo .
      121     assign
      122       p-number = p-number modulo 100
      123     .
      124     if p-number < 20
      125     then do:
      126       assign
      127         v-rest = p-number
      128       .
      129     end.
      130     else do:
      131       assign
      132         v-rest = p-number modulo 10
      133       .
      134     end.
      135     case v-rest :
      136       when 1
      137       then do:
      138         return 2 .
      139       end.
      140       when 2 or
      141       when 3 or
      142       when 4
      143       then do:
      144         return 3 .
      145       end.
      146       otherwise do:
      147         return 1 .
      148       end.
      149     end case .
      150   end.
      151   procedure cur-time-mjd-to-date :
      152      define input  parameter i-mjd-diff as decimal no-undo.
      153      define output parameter o-Date     as date    no-undo.
      154      define output parameter o-Time     as integer no-undo.
      155      define variable v-day-number as integer   no-undo .
      156      if    i-mjd-diff < 0
      157         or i-mjd-diff = ?
      158      then do:
      159         return "?" .
      160      end.
      161      assign
      162         v-day-number = truncate(i-mjd-diff,0).
      163         o-Date = date(v-day-number + 2400002).
      164         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      165     .
      166   end.
      167   function cur-time-mjd-to-string returns character
      168   (input p-mjd-diff as decimal
      169   )
      170   :
      171     define variable v-day-number as integer   no-undo .
      172     define variable v-seconds    as integer   no-undo .
      173     define variable v-hour       as integer   no-undo .
      174     define variable v-min        as integer   no-undo .
      175     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      176     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      177     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      178     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      179     if p-mjd-diff < 0
      180     or p-mjd-diff = ?
      181     then do:
      182       return "?" .
      183     end.
      184     assign
      185       v-day-number = integer(truncate(p-mjd-diff,0))
      186       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      187     .
      188     if v-seconds > 86400
      189     then do:
      190       assign
      191         v-seconds = 86400 - 1
      192       .
      193     end.
      194     if v-seconds < 0
      195     then do:
      196       assign
      197         v-seconds = 0
      198       .
      199     end.
      200     assign
      201       v-hour = truncate(v-seconds / 3600, 0)
      202     .
      203     assign
      204       v-seconds = v-seconds modulo 3600
      205     .
      206     assign
      207       v-min = truncate(v-seconds / 60, 0)
      208     .
      209     assign
      210       v-seconds = v-seconds modulo 60
      211     .
      212     return
      213         (if v-day-number <> 0
      214           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      215           else ""
      216         )
      217       + (if v-day-number <> 0 or v-hour <> 0
      218           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      219           else ""
      220         )
      221       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      222           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      223           else ""
      224         )
      225       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      226       .
      227   end.
      228   function cur-time-string returns character
      229   :
      230     define variable v-date as date      no-undo .
      231     define variable v-time as integer   no-undo .
      232     run cur-time in this-procedure
      233       (output v-date
      234       ,output v-time
      235       ) .
      236     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      237   end.
      238   function cur-time-string-sec returns character
      239   :
      240     define variable v-date as date      no-undo .
      241     define variable v-time as integer   no-undo .
      242     run cur-time in this-procedure
      243       (output v-date
      244       ,output v-time
      245       ) .
      246     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      247   end.
      248   function cur-time-custom  returns character
      249   (input p-prefix as character
      250   ,input p-date-format as character
      251   ,input p-delimiter as character
      252   ,input p-time-format as character
      253   ,input p-suffix as character
      254   )
      255   :
      256     define variable v-date as date      no-undo .
      257     define variable v-time as integer   no-undo .
      258     run cur-time in this-procedure
      259       (output v-date
      260       ,output v-time
      261       ) .
      262     return
      263       p-prefix
      264       + string(v-date, p-date-format)
      265       + p-delimiter
      266       + string(v-time, p-time-format)
      267       + p-suffix
      268       .
      269   end.
      270   function cur-time-print  returns character
      271   :
      272     define variable v-date as date      no-undo .
      273     define variable v-time as integer   no-undo .
      274     run cur-time in this-procedure
      275       (output v-date
      276       ,output v-time
      277       ) .
      278     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      279   end.
      280   function cur-time-datetime returns datetime
      281   :
      282     define variable v-char as character no-undo .
      283     define variable v-datetime as datetime no-undo .
      284     v-char = cur-time-string().
      285     v-datetime = datetime(v-char).
      286     return  v-datetime.
      287   end.
      288   function cur-time-string-msec returns character
      289   :
      290     define variable v-date as datetime  no-undo .
      291     v-date = now.
      292     return string(v-date) .
      293   end.
      294   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      295   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      296   define  shared variable RepPathName        as character no-undo .
      297   define  shared variable PrintRubl          as logical   no-undo .
      298   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      299   define  stream PrnLibStream.
      300   procedure prn-lib-prn-file :
      301     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      302     define input parameter p-DIsabledoptions as integer no-undo .
      303     define variable v-report-name as character no-undo .
      304     define variable v-user-action as character no-undo .
      305     define variable v-printed     as logical   no-undo .
      306     define variable v-exist       as logical   no-undo .
      307     do
      308       on error undo, return error
      309       :
      310       run prn-lib-get-report-name  in this-procedure (
      311         input parParentProc
      312         ,output v-report-name
      313         ).
      314   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      315   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      316     (input  v-report-name
      317     ,input  2
      318     ,output v-exist
      319     )  .
      320       if NOT v-exist then
      321       DO:
      322         Message
      323           "Нет заданий на печать ! "
      324           view-as alert-box .
      325         Return  .
      326       End.
      327       run gbl/prnfilen.w
      328         (input  ""
      329         ,input  p-DisabledOptions
      330         ,input  string(v-report-name )
      331         ,input  7
      332         ,output v-user-action
      333         ,output v-printed
      334         ) .
      335       if v-printed then
      336       do:
      337         return "YES" .
      338       end.
      339       else
      340       do:
      341         return "NO" .
      342       end.
      343     end.
      344   end procedure.
      345   procedure prn-lib-open-stream :
      346     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      347     define input parameter p-page-size    as integer no-undo .
      348     define input parameter p-is-stream    as logical no-undo .
      349     define input parameter p-append       as logical no-undo .
      350     define variable v-report-name as character no-undo .
      351     do
      352       on error undo, return error
      353       :
      354       run prn-lib-get-report-name  in this-procedure (
      355         input parParentProc
      356         ,output v-report-name
      357         ).
      358       if p-is-stream then
      359       do:
      360         if p-append then
      361         do:
      362           output stream PrnLibStream to value( v-report-name )
      363             page-size value(p-page-size) append .
      364         end.
      365         if not p-append then
      366         do:
      367           output stream PrnLibStream to value( v-report-name )
      368             page-size value(p-page-size) .
      369         end.
      370       end.
      371       if not p-is-stream then
      372       do:
      373         if p-append then
      374         do:
      375           output to value( v-report-name )
      376             page-size value(p-page-size) append .
      377         end.
      378         if not p-append then
      379         do:
      380           output to value( v-report-name )
      381             page-size value(p-page-size) .
      382         end.
      383       end.
      384     end.
      385   end procedure.
      386   procedure prn-lib-open-exp :
      387     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      388     define input parameter p-is-stream    as logical no-undo .
      389     define input parameter p-is-append    as logical no-undo .
      390     define output parameter p-ReportFileName as char init "report" no-undo.
      391     define output parameter p-process as logical no-undo .
      392     define variable glog as logical no-undo .
      393     do
      394       on error undo, return error
      395       :
      396       SYSTEM-DIALOG GET-FILE p-ReportFileName
      397         TITLE      "Укажите путь"
      398         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      399         ASK-OVERWRITE
      400         CREATE-TEST-FILE
      401         SAVE-AS
      402         USE-FILENAME
      403         DEFAULT-EXTENSION "txt"
      404         UPDATE glog
      405         .
      406       if not glog then  return.
      407       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      408       if p-is-stream then
      409       do:
      410         if p-is-append then
      411         do:
      412           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      413         end.
      414         else
      415         do:
      416           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      417         end.
      418       end.
      419       else
      420       do:
      421         if p-is-append then
      422         do:
      423           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      424         end.
      425         else
      426         do:
      427           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      428         end.
      429       end.
      430       p-process = yes.
      431     end.
      432   end procedure.
      433   procedure prn-lib-get-report-name :
      434     define input parameter parParentProc  as widget-handle no-undo.
      435     define output parameter p-report-name as character no-undo .
      436     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      437   end procedure.
      438   procedure prn-lib-reportviewer-report-name :
      439     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      440     define input parameter p-report-name-html as character no-undo .
      441     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      442   end procedure.
      443   procedure prn-lib-reportviewer :
      444     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      445     define input parameter p-report-name-html as character no-undo .
      446     define input parameter p-param        as character no-undo .
      447     define variable v-excel           as character no-undo init 'TRUE' .
      448     define variable v-value-character as character no-undo .
      449     define variable v-value-integer   as character no-undo .
      450     define variable v-value-date      as date      no-undo .
      451     define variable v-value-decimal   as decimal   no-undo .
      452     define variable rep-excel         as logical   no-undo .
      453     define variable excel-string      as character no-undo .
      454     define variable v-param-type      as character no-undo .
      455     define variable v-tth             as handle    no-undo .
      456     run adm/shattri.p (
      457       input "get":U
      458       ,input  ""
      459       ,input  0
      460       ,input  'report-glob':U
      461       ,input  'rep-excel':U
      462       ,output v-value-character
      463       ,output v-value-date
      464       ,output v-value-decimal
      465       ,output v-value-integer
      466       ,output rep-excel
      467       ,output v-param-type
      468       ,INPUT-OUTPUT table-handle v-tth
      469       )  .
      470     if rep-excel then v-excel = "TRUE" .
      471     else v-excel = "FALSE" .
      472     if p-param eq ""
      473     then
      474        p-param = "EXCEL:" + v-excel.
      475     else
      476        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      477     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      478   end procedure.
      479   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      480   define variable v-waitfram-action01         as character   no-undo .
      481   define variable v-waitfram-action02         as character   no-undo .
      482   define variable v-waitfram-action03         as character   no-undo .
      483   define variable mWaitFramTextBeg            as character   no-undo.
      484   define variable mWaitFramTextEnd            as character   no-undo.
      485   define variable mWaitFramView               as logical     no-undo.
      486   define variable mWaitProcEvent              as logical     no-undo init yes.
      487   define variable mWaitFramInterval           as integer     no-undo init 1 .
      488   define variable mWaitFramStop               as logical     no-undo.
      489   define variable mWaitFramStopUser           as logical     no-undo.
      490   define variable mWaitFramStopTimeOut        as logical     no-undo.
      491   define variable mWaitFramStartProc          as datetime-tz no-undo.
      492   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      493   define button B-WaitFramStop auto-end-key
      494        label "Стоп"
      495        size 10 by 1 tooltip "Остоновить процесс".
      496   define button B-viewProcInfo
      497        label "Информация"
      498        size 15 by 1 tooltip "Информация о процесс".
      499   define frame waitfram
      500     v-waitfram-action01 format "x(72)" no-label skip
      501     v-waitfram-action02 format "x(72)" no-label skip
      502     v-waitfram-action03 format "x(72)" no-label skip
      503     B-viewProcInfo
      504     B-WaitFramStop at row 4 col 30
      505     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      506     .
      507   define new global shared variable mBatchMode as logical no-undo init ?.
      508   define variable mFramBachModHandle as handle no-undo.
      509   mFramBachModHandle = frame waitfram:handle.
      510   define variable mFameOldVis as logical no-undo.
      511   define variable mVisCUrentVin as logical no-undo.
      512   if session:batch-mode
      513   then
      514      mBatchMode = yes.
      515   if mBatchMode = ? then do:
      516     mVisCUrentVin = current-window:visible.
      517     mFameOldVis = mFramBachModHandle:visible.
      518     mFramBachModHandle:visible  = yes.
      519     mBatchMode = mFramBachModHandle:visible ne yes.
      520     mFramBachModHandle:visible = mFameOldVis.
      521     current-window:visible = mVisCUrentVin.
      522   end.
      523    if  log-manager:logfile-name ne ?
      524     then DO:
      525         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      526         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      527         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      528     end.
      529   on choose of B-WaitFramStop in frame waitfram
      530   do:
      531     mWaitFramStop = yes.
      532     mWaitFramStopUser = yes.
      533   end.
      534   function waitfram-check-timeout returns logical():
      535      define variable vtime as int64 no-undo.
      536      if mWaitFramStopTimeOut
      537      then
      538         return yes.
      539      vtime = ( now - mWaitFramStartProc ) / 1000 .
      540      if     mWaitFramTimeOut ne ?
      541         and mWaitFramTimeOut ne 0
      542         and mWaitFramTimeOut lt vtime
      543      then do:
      544         mWaitFramStopTimeOut = yes.
      545      end.
      546      return mWaitFramStopTimeOut.
      547   end.
      548   procedure waitfram-hide :
      549     if not session:batch-mode
      550     then do
      551     on error undo, return error return-value
      552     :
      553       pause 0 before-hide .
      554       if not mBatchMode then
      555         hide frame waitfram .
      556     if     not mWaitFramView
      557        and mWaitProcEvent
      558     then
      559       process events .
      560     end.
      561   end procedure.
      562   procedure waitfram-show :
      563     define input  parameter p-message as character no-undo .
      564     define variable v-left-margin as integer   no-undo .
      565     if not session:batch-mode
      566     then do
      567     on error undo, return error return-value
      568     :
      569       if length(p-message) <= 70 then do:
      570         assign
      571           v-left-margin = integer((70 - length(p-message)) / 2)
      572         .
      573         assign
      574           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      575         .
      576         assign
      577           v-waitfram-action01 = " "
      578           v-waitfram-action02 = " "
      579                                    + fill(" ", v-left-margin)
      580                                    + p-message
      581           v-waitfram-action03 = " "
      582         .
      583       end.
      584       else do:
      585         define variable vRindex1 as integer no-undo.
      586         define variable vRindex2 as integer no-undo.
      587         vRindex1 = r-index(p-message," ",70).
      588         if vRindex1 = 0
      589         then
      590            vRindex1 = 70.
      591         if length(p-message)  <= vRindex1 + 70 then do:
      592           assign
      593             v-waitfram-action01 = " "
      594             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      595             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      596           .
      597         end.
      598         else do:
      599           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      600           if vRindex2 <= vRindex1
      601           then
      602              vRindex2 = vRindex1 + 70.
      603           assign
      604             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      605             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      606             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      607           .
      608         end.
      609       end.
      610       B-viewProcInfo:visible   in frame waitfram = no.
      611       B-viewProcInfo:sensitive in frame waitfram = no.
      612       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      613       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      614       if  (   mWaitFramView
      615          or  mWaitProcEvent)
      616          and not mBatchMode
      617       then
      618          display
      619             v-waitfram-action01 skip
      620             v-waitfram-action02 skip
      621             v-waitfram-action03 skip
      622          with frame waitfram .
      623       if     mWaitFramView
      624          then do:
      625             if     mWaitFramInterval ne ?
      626                and not mBatchMode
      627             then
      628                wait-for go of frame waitfram pause mWaitFramInterval.
      629          end.
      630          else
      631             if     mWaitProcEvent
      632                and not mBatchMode
      633             then
      634                process events .
      635     end.
      636   end procedure.
      637      procedure waitfram-show-this:
      638         define input  parameter iInterval as int64 no-undo.
      639         define variable vtime as int64 no-undo.
      640         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      641         mWaitFramInterval = iInterval.
      642         run waitfram-show (substitute("&1&2 &3&4" ,
      643                                       mWaitFramTextBeg ,
      644                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      645                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      646                                       mWaitFramTextEnd
      647                                      )
      648                           ).
      649      end.
      650      procedure WaitFramRunPause:
      651         define input  parameter iInterval as dec no-undo.
      652         define variable vStart  as datetime-tz no-undo.
      653         define variable vend    as datetime-tz no-undo.
      654         define variable vint as int64 no-undo.
      655         define variable vOk as logical no-undo.
      656         vStart = now.
      657         vend   = vStart.
      658         publish "WaitFramPause" (iInterval,output vOk).
      659         vend   =  now.
      660         vint = vend - vStart.
      661         vint = iInterval - vint / 1000.
      662         if     not mWaitFramStop
      663            and (   vint > 0
      664                 or (    not vOk
      665                     and iInterval eq ?
      666                     )
      667                 )
      668         then
      669            run waitfram-show-this (iInterval).
      670         vend   =  now.
      671         vint = vend - vStart.
      672         vint = iInterval - vint / 1000.
      673         if     not mWaitFramStop
      674            and vint > 0
      675         then do:
      676            run gbl/pause.p (vint * 1000).
      677         end.
      678         if iInterval ne ?
      679         then
      680            publish "WaitFramStop".
      681         waitfram-check-timeout().
      682      end.
      683      procedure WaitFramWaitFor:
      684         define input  parameter iInterval as dec no-undo.
      685         assign
      686            mWaitFramStartProc   = now
      687            mWaitFramStopUser    = no
      688            mWaitFramStopTimeOut = no
      689         .
      690         block-wait:
      691         do while not mWaitFramStop:
      692            run WaitFramRunPause (iInterval).
      693            if  waitfram-check-timeout()
      694            then do:
      695               leave block-wait.
      696            end.
      697         end.
      698         run waitfram-hide.
      699      end.
      700   procedure waitfram-join :
      701     define input  parameter p-line-1  as character no-undo .
      702     define input  parameter p-line-2  as character no-undo .
      703     define input  parameter p-line-3  as character no-undo .
      704     define output parameter p-message as character no-undo .
      705     do
      706     on error undo, return error return-value
      707     :
      708       assign
      709         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      710                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      711                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      712       .
      713     end.
      714   end procedure.
      715   function waitfram-join-function returns character
      716     (input p-line-1 as character
      717     ,input p-line-2 as character
      718     ,input p-line-3 as character
      719     ).
      720     define variable v-message as character no-undo .
      721     run waitfram-join in this-procedure
      722       (input  p-line-1
      723       ,input  p-line-2
      724       ,input  p-line-3
      725       ,output v-message
      726       ) .
      727     return v-message .
      728   end function .
      729   define variable Line as char no-undo.
      730   define variable sym1 as char init ":!:"   no-undo.
      731   define variable sym2 as char init ":!:"   no-undo.
      732   define variable sym3 as char init ":!:"   no-undo.
      733   define variable sym4 as char init ":!:"   no-undo.
      734   define variable sym5 as char init ":!:"   no-undo.
      735   define variable sym6 as char init ":!:"   no-undo.
      736   define variable sym7 as char init ":!:"   no-undo.
      737   define variable sym8 as char init ":!:"   no-undo.
      738   run prn-lib-open-stream  in this-procedure (
      739                                                input parParentProc
      740                                               ,input 62
      741                                               ,input yes
      742                                               ,input no
      743                                               ).
      744   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      745   define variable v-price-calc as logical no-undo .
      746   define variable v-doc-prt as logical no-undo .
      747   DEFINE FRAME main
      748       sym1 column-label ":!:" format "x(1)"
      749   ub.clients.obj-code COLUMN-LABEL "Номер! " FORMAT ">>>9"
      750       sym2 column-label ":!:" format "x(1)"
      751       ub.clients.obj-name COLUMN-LABEL "Название! "
      752       sym8 column-label ":!:" format "x(1)"
      753       ub.clients.host-code COLUMN-LABEL "фирма" FORMAT ">>>>>>>>9"
      754       sym3 column-label ":!:" format "x(1)"
      755   v-price-calc COLUMN-LABEL "Запр.прих!при нерав.цен" FORMAT "да/нет"
      756       sym4 column-label ":!:" format "x(1)"
      757   v-doc-prt COLUMN-LABEL "Учет!по шкал" FORMAT "да/нет"
      758       sym5 column-label ":!:" format "x(1)"
      759       ub.clients.grp-name COLUMN-LABEL "Название группы! "
      760       sym6 column-label ":!:" format "x(1)"
      761       ub.clients.db-num COLUMN-LABEL "БД! "
      762       sym7 column-label ":!:" format "x(1)"
      763       HEADER
      764           cur-time-print() AT 5 format "x(35)"
      765               string( "Страница " + string (PAGE-NUMBER( PrnLibStream ) , ">>9") )
      766                       AT 45 format "X(15)" SKIP
      767   Line format "X(137)" AT 1
      768   with width 160 down stream-io .
      769   FORM HEADER
      770   Line format "X(137)" SKIP
      771   "Продолжение - на следующей странице" AT 30 SKIP
      772   with FRAME BottomFrame width 160 PAGE-BOTTOM NO-LABELS NO-BOX .
      773   VIEW stream PrnLibStream FRAME BottomFrame .
      774   if session:set-wait-state("compiler") then.
      775   Line = fill("-", 140).
      776   FORM with FRAME main .
      777   run waitfram-show in this-procedure ( "Минуточку . . ." ).
      778    PUT STREAM PrnLibStream SPACE(4) "С П И С О К    С К Л А Д О В" FORMAT "X(128)" SKIP.
      779   FOR EACH ub.store NO-LOCK:
      780           FIND ub.clients WHERE
      781               ub.clients.obj-code = ub.store.obj-code
      782         AND ub.clients.obj-type = 'скл':U.
      783      v-doc-prt = ub.store.doc-prt.
      784      v-price-calc = ub.store.price-calc.
      785     ACCUMULATE ub.clients.obj-code ( COUNT ).
      786           DISPLAY stream  PrnLibStream
      787                   sym1
      788     ub.clients.obj-code
      789                   sym2
      790                   ub.clients.obj-name
      791                   sym8
      792                   ub.clients.host-code COLUMN-LABEL "Фирма" FORMAT ">>>>>>>>>9"
      793                   sym3
      794     v-price-calc
      795                   sym4
      796     v-doc-prt
      797                   sym5
      798                   ub.clients.grp-name
      799                   sym6
      800                   ub.clients.db-num
      801                   sym7
      802           with FRAME main .
      803           DOWN stream  PrnLibStream 1 with FRAME main .
      804     IF ( ( ACCUM COUNT ub.clients.obj-code) modulo 5 = 0 ) AND
      805             ( ACCUM COUNT ub.clients.obj-code) >= 5 THEN do:
      806           run waitfram-show in this-procedure ( "Просмотрено складов - " + string( ACCUM COUNT ub.clients.obj-code) ).
      807   END.
      808   end.
      809   IF ( LINE-COUNTER( PrnLibStream ) + 1 ) > PAGE-SIZE( PrnLibStream )
      810   THEN PAGE STREAM PrnLibStream .
      811   PUT STREAM PrnLibStream Line FORMAT "X(137)" SKIP.
      812   HIDE STREAM PrnLibStream FRAME BottomFrame .
      813   run waitfram-hide in this-procedure .
      814   OUTPUT STREAM PrnLibStream CLOSE.
      815   run prn-lib-prn-file in this-procedure (
      816                                             input parParentProc
      817                                             ,input 0
      818                                             ).
