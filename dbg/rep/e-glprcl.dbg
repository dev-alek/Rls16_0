      893     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
      894     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      895     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
      896     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
      897     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
      898     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
      899     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
      900     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
      901     IF "":U = "":U THEN
