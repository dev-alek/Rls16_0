      679   def var   ChosedType    as   integer.
      680   def var   PayType       as   integer.
      681   def var   Sort-Type     as   char   .
      682   def var   NoPrt         as   log    .
      683   def var State-source as  WIDGET-HANDLE.
      684   def var stat                as      log       init no           no-undo.
      685       define variable v-e-glprcl-host-code    as integer      no-undo.
      686       define variable v-e-glprcl-store-type   as character    no-undo.
      687       define variable v-e-glprcl-store-code   as integer      no-undo.
      688       define variable v-e-glprcl-base-code    as integer      no-undo.
      689   RUN set-attribute-list (
      690       'Keys-Accepted = ,
      691        Keys-Supplied = ':U).
      692   DEFINE VARIABLE MainTypes AS INTEGER
      693        VIEW-AS RADIO-SET VERTICAL
      694        RADIO-BUTTONS
      695             "Фактическое наличие", 1,
      696   "Только цены", 2
      697        SIZE 24 BY 2.33 NO-UNDO.
      698   DEFINE VARIABLE SET_PAY_TYPE AS INTEGER
      699        VIEW-AS RADIO-SET VERTICAL
      700        RADIO-BUTTONS
      701             "В валюте", 1,
      702   "В рублях", 2
      703        SIZE 12 BY 2.33
      704        FGCOLOR 0  NO-UNDO.
      705   DEFINE VARIABLE SortType AS CHARACTER INITIAL "По наименованию"
      706        VIEW-AS RADIO-SET VERTICAL
      707        RADIO-BUTTONS
      708             "По наименованию", "По наименованию"
      709        SIZE 36.5 BY 2.33 NO-UNDO.
      710   DEFINE RECTANGLE RECT-1
      711        EDGE-PIXELS 3 GRAPHIC-EDGE  NO-FILL
      712        SIZE 40 BY 3.17.
      713   DEFINE RECTANGLE RECT-3
      714        EDGE-PIXELS 3 GRAPHIC-EDGE  NO-FILL
      715        SIZE 40 BY 4.17.
      716   DEFINE RECTANGLE RECT-4
      717        EDGE-PIXELS 3 GRAPHIC-EDGE  NO-FILL
      718        SIZE 40 BY 1.67.
      719   DEFINE VARIABLE No-Prt AS LOGICAL INITIAL no
      720        LABEL "Без детализации по признакам"
      721        VIEW-AS TOGGLE-BOX
      722        SIZE 33.5 BY .83 NO-UNDO.
      723   DEFINE FRAME F-Main
      724        MainTypes AT ROW 1.75 COL 3.5 NO-LABEL
      725        SET_PAY_TYPE AT ROW 1.75 COL 28.5 NO-LABEL
      726        SortType AT ROW 5.75 COL 3.5 NO-LABEL
      727        No-Prt AT ROW 8.92 COL 4.5
      728        "Сортировка :" VIEW-AS TEXT
      729             SIZE 13.5 BY .75 AT ROW 4.75 COL 15
      730        RECT-4 AT ROW 8.58 COL 2
      731        RECT-1 AT ROW 1.25 COL 2
      732        RECT-3 AT ROW 4.42 COL 2
      733       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      734            SIDE-LABELS NO-UNDERLINE THREE-D
      735            AT COL 1 ROW 1 SCROLLABLE .
      736   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      737   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      738   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      739   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      740   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      741   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      742   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      743   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      744         adm-object-hdl = FRAME F-Main:HANDLE.
      745   RUN ensure-broker.
      746   THIS-PROCEDURE:ADM-DATA =
      747        'ADM1.1~`':U +
      748        'SmartObject~`':U +
      749        '~`':U +
      750        'NO ~`':U +
      751        '~`':U +
      752        '~`':U +
      753        '~`':U +
      754        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      755           + "~`":U +
      756        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
      757        'Record-Source,Record-Target,TableIO-Target~`':U +
      758        '~`':U +
      759        '~`~`~`~`~`~`~`~`~`~`~`':U +
      760        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      761            THEN "^^":U
      762        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      763             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      764   PROCEDURE adm-apply-entry :
      765     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      766   END PROCEDURE.
      767   PROCEDURE adm-destroy :
      768    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      769   END PROCEDURE.
      770   PROCEDURE adm-disable :
      771       DISABLE RECT-4 RECT-1 RECT-3 MainTypes SET_PAY_TYPE SortType No-Prt WITH FRAME F-Main.
      772       RUN dispatch ('disable-fields':U).
      773       RUN set-attribute-list ('ENABLED=no':U).
      774       RETURN.
      775   END PROCEDURE.
      776   PROCEDURE adm-edit-attribute-list :
      777         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
      778         RETURN.
      779   END PROCEDURE.
      780   PROCEDURE adm-enable :
      781       ENABLE UNLESS-HIDDEN RECT-4 RECT-1 RECT-3 MainTypes SET_PAY_TYPE SortType No-Prt WITH FRAME F-Main.
      782       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      783       RUN set-attribute-list ('ENABLED=yes':U).
      784       RETURN.
      785   END PROCEDURE.
      786   PROCEDURE adm-exit :
      787        RUN notify ('exit':U).
      788     RETURN.
      789   END PROCEDURE.
      790   PROCEDURE adm-hide :
      791     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      792   END PROCEDURE.
      793   PROCEDURE adm-initialize :
      794     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      795   END PROCEDURE.
      796   PROCEDURE adm-show-errors :
      797       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      798       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      799           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      800       END.
      801       RETURN.
      802   END PROCEDURE.
      803   PROCEDURE adm-UIB-mode :
      804     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      805   END PROCEDURE.
      806   PROCEDURE adm-view :
      807     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      808   END PROCEDURE.
      809   PROCEDURE dispatch :
      810       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      811       RUN broker-dispatch IN adm-broker-hdl
      812           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      813       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      814   END PROCEDURE.
      815   PROCEDURE ensure-broker :
      816   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      817   IF RETURN-VALUE NE "ADM-Broker":U THEN
      818   DO:
      819       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      820       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      821   END.
      822   END PROCEDURE.
      823   PROCEDURE get-attribute :
      824     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      825     RUN broker-get-attribute IN adm-broker-hdl
      826         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      827     RETURN RETURN-VALUE.
      828   END PROCEDURE.
      829   PROCEDURE get-attribute-list :
      830     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      831     RUN broker-get-attribute-list IN adm-broker-hdl
      832         (INPUT THIS-PROCEDURE,
      833          INPUT ?,
      834          OUTPUT p-attr-list) NO-ERROR.
      835     RETURN.
      836   END PROCEDURE.
      837   PROCEDURE new-state :
      838     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      839     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      840     RETURN.
      841   END PROCEDURE.
      842   PROCEDURE notify :
      843     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      844     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      845     IF RETURN-VALUE = "ADM-ERROR":U THEN
      846         RETURN "ADM-ERROR":U.
      847     RETURN.
      848   END PROCEDURE.
      849   PROCEDURE set-attribute-list :
      850     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      851     RUN ensure-broker.
      852     RUN broker-set-attribute-list IN adm-broker-hdl
      853         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      854     RETURN.
      855   END PROCEDURE.
      856   PROCEDURE set-position :
      857       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      858       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      859       IF VALID-HANDLE(adm-object-hdl) THEN
      860       DO:
      861         ASSIGN adm-object-hdl:ROW    =   p-row
      862                adm-object-hdl:COLUMN =   p-col.
      863       END.
      864       RETURN.
      865   END PROCEDURE.
      866   PROCEDURE adm-display-fields :
      867       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
      868       RETURN.
      869   END PROCEDURE.
      870   PROCEDURE adm-open-query :
      871     RETURN.
      872   END PROCEDURE.
      873   PROCEDURE adm-row-changed :
      874         IF VALID-HANDLE(adm-object-hdl) THEN
      875           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      876         RUN notify ('row-available':U).
      877         RETURN.
      878   END PROCEDURE.
      879   PROCEDURE reposition-query :
      880       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
      881       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
      882       RETURN.
      883   END PROCEDURE.
      884     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
      885     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
      886     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
      887     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
      888     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
      889     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
