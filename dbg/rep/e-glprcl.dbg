      957   PROCEDURE adm-update-record :
      958       MESSAGE
      959         "Object ":U THIS-PROCEDURE:FILE-NAME
      960           "must have at least one Enabled Table to perform Update.":U
      961             VIEW-AS ALERT-BOX ERROR.
      962      RETURN.
      963   END PROCEDURE.
      964   PROCEDURE check-modified :
      965   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
      966   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
      967   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
      968   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
      969     IF check-state = "check":U THEN
      970     DO:
      971       RUN get-link-handle IN adm-broker-hdl
      972         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
      973            OUTPUT group-target-list).
      974       IF group-target-list NE "":U THEN
      975       DO i = 1 TO NUM-ENTRIES(group-target-list):
      976         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
      977         RUN check-modified IN curr-widget ('group-check':U).
      978         IF RETURN-VALUE NE "":U THEN
      979         DO:
      980           RUN check-modified-message(RETURN-VALUE).
      981           RETURN "":U.
      982         END.
      983       END.
      984     END.
      985     RETURN "":U.
      986   END PROCEDURE.
      987   PROCEDURE check-modified-message :
      988     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
      989        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
      990           'CONTAINER-SOURCE':U, 'HIDDEN':U).
      991        IF RETURN-VALUE = "YES":U THEN
      992           RUN notify ('view,CONTAINER-SOURCE':U).
      993        MESSAGE IF p-changed-table NE ? THEN
      994           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
      995           ELSE "Current values have been changed."
      996           SKIP "  Do you wish to save those changes?"
      997           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
      998        IF ANS THEN
      999        DO:
     1000           IF group-assign-target THEN
     1001             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1002           ELSE RUN dispatch('update-record':U).
     1003           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1004           DO:
     1005               MESSAGE "Changes to the previous record were not saved."
     1006                 VIEW-AS ALERT-BOX ERROR.
     1007               IF group-assign-target THEN
     1008                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1009               ELSE RUN dispatch ('cancel-record':U).
     1010           END.
     1011        END.
     1012        ELSE DO:
     1013          IF group-assign-target THEN
     1014             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1015          ELSE RUN dispatch('cancel-record':U).
     1016        END.
     1017        RETURN.
     1018   END PROCEDURE.
     1019   PROCEDURE get-rowid :
     1020       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1021       ASSIGN
     1022       p-table   =   adm-first-table.
     1023       RETURN.
     1024   END PROCEDURE.
     1025   PROCEDURE init-group-assign :
     1026       RUN request-attribute IN adm-broker-hdl
     1027         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1028       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1029         group-assign-target = yes.
     1030       ELSE group-assign-target = no.
     1031       RETURN.
     1032   END PROCEDURE.
     1033   PROCEDURE set-editors :
     1034       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1035       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1036       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1037       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1038       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1039       DO WHILE VALID-HANDLE (curr-widget):
     1040           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1041              curr-widget:HIDDEN = no THEN DO:
     1042             CASE p-field-setting:
     1043               WHEN "INITIALIZE":U THEN
     1044               DO:
     1045                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1046                     read-only-list +
     1047                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1048                        STRING(curr-widget).
     1049               END.
     1050               WHEN "DISABLE":U OR
     1051               WHEN "ENABLE":U THEN
     1052               DO:
     1053                   curr-widget:SENSITIVE = yes.
     1054                   RUN get-attribute ('Read-Only-Editors':U).
     1055                   IF RETURN-VALUE = ? OR
     1056                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1057                       curr-widget:READ-ONLY =
     1058                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1059               END.
     1060               WHEN "CLEAR":U THEN
     1061                   curr-widget:SCREEN-VALUE = "":U.
     1062             END CASE.
     1063           END.
     1064           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1065       END.
     1066       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1067         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1068           + '"':U).
     1069       RETURN.
     1070   END PROCEDURE.
     1071   PROCEDURE use-check-modified-all :
     1072    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1073     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1074     RETURN.
     1075   END PROCEDURE.
     1076   PROCEDURE use-create-on-add :
     1077   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1078      RETURN.
     1079   END PROCEDURE.
     1080   PROCEDURE use-initial-lock :
     1081     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1082     ASSIGN adm-initial-lock = p-attr-value.
     1083     RETURN.
     1084   END PROCEDURE.
     1085     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1086   ASSIGN
     1087          FRAME F-Main:SCROLLABLE       = FALSE
     1088          FRAME F-Main:HIDDEN           = TRUE.
     1089   if not this-procedure :persistent
     1090   then do:
     1091     message
     1092       vss-workfile vss-revision vss-description skip
     1093       "Ошибка при запуске процедуры" skip
     1094       "Данную процедуру следует запускать только с параметром persistent" skip
     1095       view-as alert-box error .
     1096     undo, return error .
     1097   end.
     1098   PROCEDURE adm-row-available :
     1099     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
     1100     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
     1101     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
     1102     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
     1103     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
     1104     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
     1105     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
     1106     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
     1107     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
     1108     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
     1109     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
     1110     IF adm-updating-record THEN RETURN.
     1111     RUN get-attribute ('FIELDS-ENABLED':U).
     1112     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
     1113     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
     1114         OUTPUT link-handle) NO-ERROR.
     1115     IF link-handle = "":U THEN
     1116         RETURN.
     1117     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
     1118     IF NUM-ENTRIES(link-handle) > 1 THEN
     1119         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
     1120             "encountered more than one RECORD-SOURCE.":U SKIP
     1121             "The first - ":U record-source-hdl:file-name " - will be used.":U
     1122                VIEW-AS ALERT-BOX ERROR.
     1123     RUN get-attribute ('Key-Name':U).
     1124     key-name = RETURN-VALUE.
     1125     IF key-name = "":U THEN key-name = ?.
     1126     IF key-name NE ? THEN DO:
     1127       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
     1128         NO-ERROR.
     1129       IF key-value NE ? THEN
     1130         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
     1131     END.
     1132   IF VALID-HANDLE (adm-object-hdl) THEN
     1133       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1134   RUN notify IN THIS-PROCEDURE ('row-available':U).
     1135   END PROCEDURE.
     1136   PROCEDURE disable_UI :
     1137     HIDE FRAME F-Main.
     1138     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1139   END PROCEDURE.
     1140   PROCEDURE local-initialize :
     1141     RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     1142       assign
     1143           v-e-glprcl-host-code   = v-cntxt-host-code-obj
     1144           v-e-glprcl-store-type  = v-cntxt-obj-type
     1145           v-e-glprcl-store-code  = v-cntxt-obj-code
     1146       .
     1147   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1148   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1149     (input  v-e-glprcl-store-type
     1150     ,input  v-e-glprcl-store-code
     1151     ,output v-e-glprcl-host-code
     1152     )  .
     1153   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1154   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     1155     (input  v-e-glprcl-host-code
     1156     ,output v-e-glprcl-base-code
     1157     )  .
     1158      if v-e-glprcl-base-code = 0 then
     1159       stat = SET_PAY_TYPE:DISABLE("В валюте") in frame  F-Main .
     1160   END PROCEDURE.
     1161   PROCEDURE my-report :
     1162       run rep/r-glprcl.p (
     1163             input v-e-glprcl-store-type
     1164           , input v-e-glprcl-store-code
     1165           , input ChosedType
     1166           , input PayType
     1167           , input Sort-Type
     1168           , input NoPrt
     1169       ).
     1170   END PROCEDURE.
     1171   PROCEDURE my-var :
     1172    assign frame F-Main   No-Prt .
     1173    assign
     1174       ChosedType = integer(MainTypes:screen-value )
     1175       PayType    = integer(SET_PAY_TYPE:screen-value)
     1176       Sort-Type  = SortType:screen-value
     1177       NoPrt      = No-Prt .
     1178   END PROCEDURE.
     1179   PROCEDURE send-records :
     1180   END PROCEDURE.
     1181   PROCEDURE state-changed :
     1182     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     1183     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     1184     CASE p-state:
     1185       WHEN 'update-begin':U THEN DO:
     1186           RUN dispatch('enable-fields':U).
     1187           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1188           DO:
     1189             RUN new-state('update-failed,TABLEIO-SOURCE':U).
     1190             RUN new-state('update-complete':U).
     1191           END.
     1192           ELSE RUN new-state ('update':U).
     1193       END.
     1194       WHEN 'update-complete':U THEN DO:
     1195           RUN new-state ('update-complete':U).
     1196       END.
     1197     END CASE.
     1198   END PROCEDURE.
