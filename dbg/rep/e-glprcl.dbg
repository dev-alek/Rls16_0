      903         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
      904     RUN use-create-on-add(?).
      905   PROCEDURE adm-add-record :
      906       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      907          "must have at least one Enabled Table to perform Add.":U
      908          VIEW-AS ALERT-BOX ERROR.
      909       RETURN.
