      572   procedure proc-alt-shift-f2:
      573     if not ibs.th.gbl.gbl-var:rcode
      574   then
      575     run gbl\inidebug.p .
      576   end.
      577   procedure proc-alt-shift-f3:
      578     run gbl/prvssinf.p
      579       ( input this-procedure
      580       ) .
      581   end.
      582   define variable v-inform-launched as logical no-undo initial false .
      583   procedure proc-alt-shift-f4:
      584     define variable v-action as character no-undo .
      585     if v-inform-launched = false then do:
      586       assign
      587         v-inform-launched = true
      588       .
      589       run gbl/d-inform.w
      590         (  input self
      591         ,  input this-procedure
      592         , output v-action
      593         ) no-error .
      594       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      595       assign
      596         v-inform-launched = false
      597       .
      598     end.
      599   end.
      600   procedure proc-alt-f1:
      601     run gbl/corrhelp.p
      602       (input this-procedure
      603       ) .
      604   end .
      605   on alt-shift-f2 anywhere do:
      606     run proc-alt-shift-f2.
      607   end.
      608   on alt-shift-f3 anywhere do:
      609     run proc-alt-shift-f3 in this-procedure .
      610   end.
      611   on alt-shift-f4 anywhere do:
      612     run proc-alt-shift-f4 in this-procedure.
      613   end.
      614   on alt-f1 anywhere do:
      615     run proc-alt-f1 in this-procedure .
      616   end.
      617   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      618     define variable v-cntxt-db-num        as integer   no-undo .
      619     define variable v-cntxt-userid        as character no-undo .
      620     define variable v-cntxt-level         as character no-undo .
      621     define variable v-cntxt-host-code-obj as integer   no-undo .
      622     define variable v-cntxt-obj-type      as character no-undo .
      623     define variable v-cntxt-obj-code      as integer   no-undo .
      624     define variable v-cntxt-db-num-obj    as integer   no-undo .
