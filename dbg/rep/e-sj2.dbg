     2823                               DOWN STREAM PrnLibStream 1 with FRAME sj-full-t .
     2824     end.
     2825     else do:
     2826                               DOWN STREAM PrnLibStream 1 with FRAME sj-base-t .
     2827     end.
     2828   end.
     2829                   if first-of( sj-goods.obj-attr ) AND ( ObjsQnty > 1 ) then  do:
     2830                           assign
     2831                           strbuf1 = substr( sj-goods.obj-attr, 1, 3 )
     2832                           intbuf1 = integer( substr( sj-goods.obj-attr, 4 ) ) .
     2833                           FIND FIRST cli-obj WHERE
     2834                                      cli-obj.obj-type = strbuf1 AND
