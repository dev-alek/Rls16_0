     5995                           intbuf1 = integer( substr( sj-goods.obj-attr, 4 ) ) .
     5996                           FIND FIRST cli-obj WHERE
     5997                                      cli-obj.obj-type = strbuf1 AND
     5998                                      cli-obj.obj-code = intbuf1 NO-LOCK .
     5999                           PUT STREAM PrnLibStream
     6000                           cli-obj.obj-name format "x(120)" SKIP.
     6001   if v-curr-r-b = 'base':U then do:
     6002                           if my-set_val_type = 2  then
