     5975                   BY sj-goods.saleman
     5976                   BY sj-goods.artic
     5977                   BY sj-goods.b-code
     5978                   BY sj-adv.price
     5979                   :
     5980   define variable vss-include-info45 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5981   if first( sj-goods.obj-attr ) then do:
