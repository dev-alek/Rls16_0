     3076         namebuf2 @ sj-goods.name
     3077         prodbuf2 @ sj-goods.prod-name
     3078         with FRAME sj-full-t .
     3079         if not SHOnly_tot then
     3080         DOWN STREAM PrnLibStream 1 with FRAME sj-full-t .
     3081       end.
     3082     END CASE .
     3083     if LASt-OF(sj-goods.b-code) AND NOT SHOnly_tot then do:
     3084     CASE my-Set_Val_Type :
     3085       when 2 then  do:
