     5051   define variable vss-include-info41 as character format "x(65)" no-undo initial "@(#)$Workfile: e-sjprod.i $ $Revision: aea5316774be, 0, rls $".
     5052   define variable vss-include-info42 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5053       ACCUMULATE
     5054       sj-adv.qnty (TOTAL)
