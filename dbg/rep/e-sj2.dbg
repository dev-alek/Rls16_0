     2672                 ACCUM TOTAL BY sj-tots.grp-name sj-tots.qnty    @ sj-adv.qnty
     2673                 ACCUM TOTAL BY sj-tots.grp-name sj-tots.qnty-2    @ sj-adv.qnty-2
     2674                 ACCUM TOTAL BY sj-tots.grp-name sj-tots.qnty-3    @ sj-adv.qnty-3
     2675                 ACCUM TOTAL BY sj-tots.grp-name sj-tots.brutto-sum      @ sj-adv.brutto-sum
     2676                 ACCUM TOTAL BY sj-tots.grp-name sj-tots.discnt-sum      @ sj-adv.discnt-sum
     2677                 round( ( ACCUM TOTAL BY sj-tots.grp-name sj-tots.discnt-sum ) /
     2678                        ( ACCUM TOTAL BY sj-tots.grp-name sj-tots.brutto-sum) * 100 , 1 )
     2679                                 @ pcnt
     2680                 ACCUM TOTAL BY sj-tots.grp-name sj-tots.netto-sum   @ sj-adv.netto-sum
     2681                 with FRAME sj-base-t .
     2682                 DOWN STREAM PrnLibStream 1 with FRAME sj-base-t .
     2683               end.
     2684               when 3 then do:
     2685                 UNDERLINE STREAM PrnLibStream
     2686                 sj-goods.b-code
     2687                 sj-goods.artic
     2688                 sj-goods.name
     2689                 sj-adv.qnty
     2690                 sj-adv.qnty-2
     2691                 sj-adv.qnty-3
     2692                 sj-adv.brutto-sum
     2693                 sj-adv.brutto-sum-r
     2694                 sj-adv.discnt-sum
     2695                 pcnt
     2696                 sj-adv.netto-sum
     2697                 sj-adv.netto-sum-r
     2698                 with FRAME sj-full-t .
     2699                 DISPLAY STREAM PrnLibStream
     2700                 get-grp-name(sj-tots.grp-name) @ sj-goods.name
     2701                 ACCUM TOTAL BY sj-tots.grp-name sj-tots.qnty    @ sj-adv.qnty
     2702                 ACCUM TOTAL BY sj-tots.grp-name sj-tots.qnty-2    @ sj-adv.qnty-2
     2703                 ACCUM TOTAL BY sj-tots.grp-name sj-tots.qnty-3    @ sj-adv.qnty-3
     2704                 ACCUM TOTAL BY sj-tots.grp-name sj-tots.brutto-sum  @ sj-adv.brutto-sum
     2705                 ACCUM TOTAL BY sj-tots.grp-name sj-tots.brutto-sum-r @ sj-adv.brutto-sum-r
     2706                 ACCUM TOTAL BY sj-tots.grp-name sj-tots.discnt-sum      @ sj-adv.discnt-sum
     2707                 round( ( ACCUM TOTAL BY sj-tots.grp-name sj-tots.discnt-sum ) /
     2708                             ( ACCUM TOTAL BY sj-tots.grp-name sj-tots.brutto-sum) * 100 , 1 )
     2709                                 @ pcnt
     2710                 ACCUM TOTAL BY sj-tots.grp-name sj-tots.netto-sum   @ sj-adv.netto-sum
     2711                 ACCUM TOTAL BY sj-tots.grp-name sj-tots.netto-sum-r @ sj-adv.netto-sum-r
     2712                 with FRAME sj-full-t .
     2713                 DOWN STREAM PrnLibStream 1 with FRAME sj-full-t .
     2714               end.
     2715             END CASE .
     2716           end.
     2717         END.
     2718       end.
     2719       if ( line-counter(PrnLibStream) + 7 ) > page-size(PrnLibStream) then page stream PrnLibStream.
     2720       CASE my-set_val_type :
     2721         when 2 then do:
     2722           if OneLinePrinted then
     2723           PUT STREAM PrnLibStream  LINE format ("X(" + string(198) + ")") SKIP.
     2724           DISPLAY STREAM PrnLibStream
     2725           substitute("ИТОГО ч- &1", v-num-chk) @ sj-goods.name
     2726           ACCUM TOTAL sj-adv.qnty @ sj-adv.qnty
     2727           ACCUM TOTAL sj-adv.qnty-2 @ sj-adv.qnty-2
     2728           ACCUM TOTAL sj-adv.qnty-3 @ sj-adv.qnty-3
     2729           ACCUM TOTAL sj-adv.brutto-sum @ sj-adv.brutto-sum
     2730           ACCUM TOTAL sj-adv.discnt-sum @ sj-adv.discnt-sum
     2731           (IF (ACCUM TOTAL sj-adv.qnty) <> 0 THEN
     2732           round( ( ACCUM TOTAL sj-adv.discnt-sum ) /
     2733                       ( ACCUM TOTAL sj-adv.brutto-sum ) * 100 , 1 ) ELSE 0) @ pcnt
     2734           ACCUM TOTAL sj-adv.netto-sum @ sj-adv.netto-sum
     2735               with FRAME sj-base-t .
     2736           DOWN STREAM PrnLibStream 1 with FRAME sj-base-t .
     2737           DISPLAY STREAM PrnLibStream
     2738           (string(round((ACCUM TOTAL sj-adv.qnty) / v-num-chk, 2)) + "/ч")  @ sj-adv.qnty
     2739           (string(round((ACCUM TOTAL sj-adv.qnty-2) / v-num-chk, 2)) + "/ч") @ sj-adv.qnty-2
     2740           (string(round((ACCUM TOTAL sj-adv.qnty-3) / v-num-chk, 2)) + "/ч") @ sj-adv.qnty-3
     2741           with FRAME sj-base-t .
     2742           DOWN STREAM PrnLibStream 1 with FRAME sj-base-t .
     2743           UNDERLINE STREAM PrnLibStream
     2744           sj-goods.b-code
     2745           sj-goods.artic
     2746           sj-goods.name
     2747           sj-adv.qnty
     2748           sj-adv.qnty-2
     2749           sj-adv.qnty-3
     2750           sj-adv.brutto-sum
     2751           sj-adv.discnt-sum
     2752           pcnt
     2753           sj-adv.netto-sum
     2754           with FRAME sj-base-t .
     2755         end.
     2756         when 3 then do:
     2757           if OneLinePrinted then
     2758           PUT STREAM PrnLibStream LINE  SKIP.
     2759           DISPLAY STREAM PrnLibStream
     2760           substitute("ИТОГО ч- &1", v-num-chk) @ sj-goods.name
     2761           ACCUM TOTAL sj-adv.qnty @ sj-adv.qnty
     2762           ACCUM TOTAL sj-adv.qnty-2 @ sj-adv.qnty-2
     2763           ACCUM TOTAL sj-adv.qnty-3 @ sj-adv.qnty-3
     2764           ACCUM TOTAL sj-adv.brutto-sum @ sj-adv.brutto-sum
     2765           ACCUM TOTAL sj-adv.brutto-sum-r @ sj-adv.brutto-sum-r
     2766           ACCUM TOTAL sj-adv.discnt-sum @ sj-adv.discnt-sum
     2767           (IF (ACCUM TOTAL sj-adv.qnty) <> 0 THEN
     2768           round( ( ACCUM TOTAL sj-adv.discnt-sum ) /
     2769                       ( ACCUM TOTAL sj-adv.brutto-sum ) * 100 , 1 ) ELSE 0) @ pcnt
     2770           ACCUM TOTAL sj-adv.netto-sum @ sj-adv.netto-sum
     2771           ACCUM TOTAL sj-adv.netto-sum-r @ sj-adv.netto-sum-r
     2772           with FRAME sj-full-t .
     2773           DOWN STREAM PrnLibStream 1 with FRAME sj-full-t .
     2774           DISPLAY STREAM PrnLibStream
     2775           (string(round((ACCUM TOTAL sj-adv.qnty) / v-num-chk, 2)) + "/ч") @ sj-adv.qnty
     2776           (string(round((ACCUM TOTAL sj-adv.qnty-2) / v-num-chk, 2)) + "/ч") @ sj-adv.qnty-2
     2777           (string(round((ACCUM TOTAL sj-adv.qnty-3) / v-num-chk, 2)) + "/ч") @ sj-adv.qnty-3
     2778           with FRAME sj-full-t .
     2779           DOWN STREAM PrnLibStream 1 with FRAME sj-full-t .
     2780           UNDERLINE STREAM PrnLibStream
     2781           sj-goods.b-code
     2782           sj-goods.artic
     2783           sj-goods.name
     2784           sj-adv.qnty
     2785           sj-adv.qnty-2
     2786           sj-adv.qnty-3
     2787           sj-adv.brutto-sum
     2788           sj-adv.brutto-sum-r
     2789           sj-adv.discnt-sum pcnt
     2790           sj-adv.netto-sum
     2791           sj-adv.netto-sum-r
     2792           with FRAME sj-full-t .
     2793         end.
     2794       END CASE .
     2795       if ObjsQnty = 1 then
     2796       PUT STREAM PrnLibStream
     2797       " " SKIP(1) space(10)
     2798       "Директор ______________" format "X(50)"
     2799       "Кассир ___________________" format "X(50)" SKIP .
     2800     end.
     2801         END .
     2802       end.
     2803       else do:
     2804         FOR EACH sj-goods NO-LOCK,
     2805             EACH sj-adv NO-LOCK WHERE
     2806                   sj-adv.obj-attr = sj-goods.obj-attr AND
     2807                   sj-adv.b-code = sj-goods.b-code AND
     2808                   sj-adv.saleman-chr = sj-goods.saleman-chr
     2809             BREAK
     2810             BY sj-goods.obj-attr
     2811             BY sj-goods.grp-name
     2812             BY sj-goods.prod-name
     2813             BY sj-goods.saleman-chr
     2814             BY sj-goods.b-code
     2815             BY sj-adv.price
     2816         :
     2817   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2818   if first( sj-goods.obj-attr ) then do:
     2819     if v-curr-r-b = 'base':U then do:
     2820                           if my-set_val_type = 2  then
     2821                               DOWN STREAM PrnLibStream 1 with FRAME sj-base-t .
