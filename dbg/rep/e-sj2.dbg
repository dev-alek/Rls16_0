     2974       sj-adv.qnty-3 (SUB-TOTAL BY ( sj-goods.b-code ) )
     2975       sj-adv.brutto-sum  (SUB-TOTAL BY ( sj-goods.b-code ) )
     2976       sj-adv.discnt-sum  (SUB-TOTAL BY ( sj-goods.b-code ) )
     2977       sj-adv.netto-sum  (SUB-TOTAL BY ( sj-goods.b-code ) )
     2978       sj-adv.brutto-sum-r  (SUB-TOTAL BY ( sj-goods.b-code ) )
     2979       sj-adv.netto-sum-r  (SUB-TOTAL BY ( sj-goods.b-code ) )
