     4715                           DOWN STREAM PrnLibStream 1 with FRAME sj-full-t .
     4716                       end.
     4717               END CASE .
     4718               if NOT last(  sj-adv.price ) then
     4719                   CASE my-set_val_type :
     4720                       when 2 then
     4721                           UNDERLINE STREAM PrnLibStream
     4722                           sj-goods.name
     4723                           sj-adv.qnty
     4724                           sj-adv.qnty-2
     4725                           sj-adv.qnty-3
     4726                           sj-adv.brutto-sum
     4727                           sj-adv.discnt-sum
     4728                           pcnt
     4729                           sj-adv.netto-sum
     4730                           with FRAME sj-base-t .
     4731                       when 3 then
     4732                           UNDERLINE STREAM PrnLibStream
     4733                           sj-goods.name
     4734                           sj-adv.qnty
     4735                           sj-adv.qnty-2
     4736                           sj-adv.qnty-3
     4737                           sj-adv.brutto-sum
     4738                           sj-adv.brutto-sum-r
     4739                           sj-adv.discnt-sum
     4740                           pcnt
     4741                           sj-adv.netto-sum
     4742                           sj-adv.netto-sum-r
     4743                           with FRAME sj-full-t .
     4744                   END CASE .
     4745               OneLinePrinted = TRUE .
     4746           end.
     4747       if last( sj-adv.price    ) then do:
     4748         IF AllObjsTotalsBy then do:
     4749           PUT STREAM PrnLibStream string( "   ПО ВСЕМ ОБЪЕКТАМ " +
     4750              "ПО ПРОИЗВОДИТЕЛЯМ:"
     4751              )
     4752           format "x(120)" SKIP .
     4753           for each sj-tots NO-LOCK BREAK BY sj-tots.prod-name:
     4754             ACCUMULATE
     4755             sj-tots.qnty   (TOTAL BY sj-tots.prod-name)
     4756             sj-tots.qnty-2   (TOTAL BY sj-tots.prod-name)
     4757             sj-tots.qnty-3   (TOTAL BY sj-tots.prod-name)
     4758             sj-tots.brutto-sum  (TOTAL BY sj-tots.prod-name)
     4759             sj-tots.discnt-sum  (TOTAL BY sj-tots.prod-name)
     4760             sj-tots.netto-sum   (TOTAL BY sj-tots.prod-name).
     4761             if my-set_val_type = 3  then
     4762             ACCUMULATE
     4763             sj-tots.brutto-sum-r (TOTAL BY sj-tots.prod-name)
     4764             sj-tots.netto-sum-r (TOTAL BY sj-tots.prod-name).
     4765             IF LAST-OF(sj-tots.prod-name) then do:
     4766               CASE my-set_val_type :
     4767                 when 2 then do:
     4768                   UNDERLINE STREAM PrnLibStream
     4769                   sj-goods.b-code
     4770                   sj-goods.artic
     4771                   sj-goods.name
     4772                   sj-adv.qnty
     4773                   sj-adv.qnty-2
     4774                   sj-adv.qnty-3
     4775                   sj-adv.brutto-sum
     4776                   sj-adv.discnt-sum
     4777                   pcnt
     4778                   sj-adv.netto-sum
     4779                   with FRAME sj-base-t .
     4780                   DISPLAY STREAM PrnLibStream
     4781                   sj-tots.prod-name  @ sj-goods.name
     4782                   ACCUM TOTAL BY sj-tots.prod-name sj-tots.qnty    @ sj-adv.qnty
     4783                   ACCUM TOTAL BY sj-tots.prod-name sj-tots.qnty-2    @ sj-adv.qnty-2
     4784                   ACCUM TOTAL BY sj-tots.prod-name sj-tots.qnty-3    @ sj-adv.qnty-3
     4785                   ACCUM TOTAL BY sj-tots.prod-name sj-tots.brutto-sum      @ sj-adv.brutto-sum
     4786                   ACCUM TOTAL BY sj-tots.prod-name sj-tots.discnt-sum      @ sj-adv.discnt-sum
     4787                   round( ( ACCUM TOTAL BY sj-tots.prod-name sj-tots.discnt-sum ) /
     4788                          ( ACCUM TOTAL BY sj-tots.prod-name sj-tots.brutto-sum) * 100 , 1 )
     4789                                   @ pcnt
     4790                   ACCUM TOTAL BY sj-tots.prod-name sj-tots.netto-sum   @ sj-adv.netto-sum
     4791                   with FRAME sj-base-t .
     4792                   DOWN STREAM PrnLibStream 1 with FRAME sj-base-t .
     4793                 end.
     4794                 when 3 then do:
     4795                   UNDERLINE STREAM PrnLibStream
     4796                   sj-goods.b-code
     4797                   sj-goods.artic
     4798                   sj-goods.name
     4799                   sj-adv.qnty
     4800                   sj-adv.qnty-2
     4801                   sj-adv.qnty-3
     4802                   sj-adv.brutto-sum
     4803                   sj-adv.brutto-sum-r
     4804                   sj-adv.discnt-sum
     4805                   pcnt
     4806                   sj-adv.netto-sum
     4807                   sj-adv.netto-sum-r
     4808                   with FRAME sj-full-t .
     4809                   DISPLAY STREAM PrnLibStream
     4810                   sj-tots.prod-name @ sj-goods.name
     4811                   ACCUM TOTAL BY sj-tots.prod-name sj-tots.qnty    @ sj-adv.qnty
     4812                   ACCUM TOTAL BY sj-tots.prod-name sj-tots.qnty    @ sj-adv.qnty
     4813                   ACCUM TOTAL BY sj-tots.prod-name sj-tots.brutto-sum  @ sj-adv.brutto-sum
     4814                   ACCUM TOTAL BY sj-tots.prod-name sj-tots.brutto-sum-r @ sj-adv.brutto-sum-r
     4815                   ACCUM TOTAL BY sj-tots.prod-name sj-tots.discnt-sum      @ sj-adv.discnt-sum
     4816                   round( ( ACCUM TOTAL BY sj-tots.prod-name sj-tots.discnt-sum ) /
     4817                               ( ACCUM TOTAL BY sj-tots.prod-name sj-tots.brutto-sum) * 100 , 1 )
     4818                                   @ pcnt
     4819                   ACCUM TOTAL BY sj-tots.prod-name sj-tots.netto-sum   @ sj-adv.netto-sum
     4820                   ACCUM TOTAL BY sj-tots.prod-name sj-tots.netto-sum-r @ sj-adv.netto-sum-r
     4821                   with FRAME sj-full-t .
     4822                   DOWN STREAM PrnLibStream 1 with FRAME sj-full-t .
     4823                 end.
     4824               END CASE .
     4825             end.
     4826           END.
     4827       end.
     4828       if ( line-counter(PrnLibStream) + 7 ) > page-size(PrnLibStream) then page stream PrnLibStream.
     4829       CASE my-set_val_type :
     4830         when 2 then do:
     4831           if OneLinePrinted then
     4832           PUT STREAM PrnLibStream  LINE format ("X(" + string(198) + ")") SKIP.
     4833           DISPLAY STREAM PrnLibStream
     4834           substitute("ИТОГО ч- &1", v-num-chk) @ sj-goods.name
     4835           ACCUM TOTAL sj-adv.qnty @ sj-adv.qnty
