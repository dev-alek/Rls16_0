     4874           ACCUM TOTAL sj-adv.brutto-sum-r @ sj-adv.brutto-sum-r
     4875           ACCUM TOTAL sj-adv.discnt-sum @ sj-adv.discnt-sum
     4876           (IF (ACCUM TOTAL sj-adv.qnty) <> 0 THEN
     4877           round( ( ACCUM TOTAL sj-adv.discnt-sum ) /
     4878                       ( ACCUM TOTAL sj-adv.brutto-sum ) * 100 , 1 ) ELSE 0) @ pcnt
     4879           ACCUM TOTAL sj-adv.netto-sum @ sj-adv.netto-sum
     4880           ACCUM TOTAL sj-adv.netto-sum-r @ sj-adv.netto-sum-r
     4881           with FRAME sj-full-t .
     4882           DOWN STREAM PrnLibStream 1 with FRAME sj-full-t .
