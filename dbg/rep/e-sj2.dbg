     3467     if last-of( sj-goods.grp-name ) AND grouptot_flag then do:
     3468       IF AllObjsTotalsBy  then do:
     3469         FIND FIRST sj-tots WHERE
     3470                    sj-tots.obj-attr = sj-goods.obj-attr AND
     3471                   sj-tots.grp-name = sj-goods.grp-name AND
     3472                   sj-tots.prod-name = sj-goods.prod-name No-ERROR.
     3473           IF NOT avail sj-tots then do:
     3474             create sj-tots.
     3475             assign
     3476             sj-tots.obj-attr = sj-goods.obj-attr
     3477             sj-tots.grp-name = sj-goods.grp-name
     3478             sj-tots.qnty = ACCUM SUB-TOTAL BY sj-goods.grp-name sj-adv.qnty
     3479             sj-tots.qnty-2 = ACCUM SUB-TOTAL BY sj-goods.grp-name sj-adv.qnty-2
     3480             sj-tots.qnty-3 = ACCUM SUB-TOTAL BY sj-goods.grp-name sj-adv.qnty-3
     3481             sj-tots.discnt-sum  = ACCUM SUB-TOTAL BY sj-goods.grp-name sj-adv.discnt-sum
     3482             sj-tots.brutto-sum  = ACCUM SUB-TOTAL BY sj-goods.grp-name sj-adv.brutto-sum
     3483             sj-tots.netto-sum  = ACCUM SUB-TOTAL BY sj-goods.grp-name sj-adv.netto-sum.
     3484             IF my-Set_Val_Type = 3 then
     3485             assign
     3486             sj-tots.brutto-sum-r  = ACCUM SUB-TOTAL BY sj-goods.grp-name sj-adv.brutto-sum-r
     3487             sj-tots.netto-sum-r  = ACCUM SUB-TOTAL BY sj-goods.grp-name sj-adv.netto-sum-r.
     3488             ACCUMULATE
     3489             sj-tots.discnt-sum ( TOTAL )
