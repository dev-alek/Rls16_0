     5966   define variable vss-include-info44 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5967   if SHRs-sort = "Article":U then do:
     5968     if SHBySalers then do:
     5969         FOR EACH sj-goods NO-LOCK,
     5970             EACH sj-adv NO-LOCK WHERE
     5971                   sj-adv.obj-attr = sj-goods.obj-attr AND
     5972                   sj-adv.b-code = sj-goods.b-code AND
     5973                   sj-adv.saleman = sj-goods.saleman
