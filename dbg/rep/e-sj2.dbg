     2964       sj-adv.qnty-3 (SUB-TOTAL BY ( sj-adv.price  ))
     2965       sj-adv.brutto-sum  (SUB-TOTAL BY (  sj-adv.price  ))
     2966       sj-adv.discnt-sum  (SUB-TOTAL BY ( sj-adv.price  ))
     2967       sj-adv.netto-sum  (SUB-TOTAL BY (  sj-adv.price  ) )
     2968       sj-adv.brutto-sum-r  (SUB-TOTAL BY (  sj-adv.price  ))
     2969       sj-adv.netto-sum-r  (SUB-TOTAL BY (  sj-adv.price  ) )
     2970       sj-adv.num-lines ( SUB-TOTAL BY (  sj-adv.price  ))
     2971       sj-adv.num-docs (SUB-TOTAL BY (  sj-adv.price  ))
     2972       sj-adv.qnty  (SUB-TOTAL BY ( sj-goods.b-code ) )
