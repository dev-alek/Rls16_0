     2890               PUT STREAM PrnLibStream string( "   ГРУППА : " +  get-grp-name(sj-goods.grp-name) ) format "x(120)" SKIP.
     2891               UNDERLINE STREAM PrnLibStream
     2892               sj-goods.artic
     2893               sj-goods.name
     2894               with FRAME sj-base-t .
     2895             end.
     2896           end.
     2897           if first-of( sj-goods.prod-name ) then do:
     2898             if prodtot_flag OR NOT SHOnly_tot then do:
     2899               if v-curr-r-b = 'base':U then do:
     2900                 if my-Set_Val_Type = 2 then do:
     2901                   if frame sj-base-t:line = 0 then do:
