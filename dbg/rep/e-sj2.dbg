     5076       sj-adv.discnt-sum  (SUB-TOTAL BY ( sj-adv.price  ))
     5077       sj-adv.netto-sum  (SUB-TOTAL BY (  sj-adv.price  ) )
     5078       sj-adv.brutto-sum-r  (SUB-TOTAL BY (  sj-adv.price  ))
     5079       sj-adv.netto-sum-r  (SUB-TOTAL BY (  sj-adv.price  ) )
