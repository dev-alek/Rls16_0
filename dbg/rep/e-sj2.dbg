     5954       if ObjsQnty = 1 then
     5955       PUT STREAM PrnLibStream
     5956       " " SKIP(1) space(10)
     5957       "Директор ______________" format "X(50)"
     5958       "Кассир ___________________" format "X(50)" SKIP .
     5959     end.
     5960     END.
     5961   end.
