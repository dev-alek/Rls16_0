     8442             with FRAME sj-base-t .
     8443             DOWN STREAM PrnLibStream 1 with FRAME sj-base-t .
     8444             DISPLAY STREAM PrnLibStream
     8445             (string(round((ACCUM TOTAL sj-adv.qnty) / v-num-chk, 2)) + "/ч")  @ sj-adv.qnty
     8446             (string(round((ACCUM TOTAL sj-adv.qnty-2) / v-num-chk, 2)) + "/ч") @ sj-adv.qnty-2
     8447             (string(round((ACCUM TOTAL sj-adv.qnty-3) / v-num-chk, 2)) + "/ч") @ sj-adv.qnty-3
     8448             with FRAME sj-base-t .
     8449             DOWN STREAM PrnLibStream 1 with FRAME sj-base-t .
     8450             UNDERLINE STREAM PrnLibStream
     8451             sj-goods.b-code
     8452             sj-goods.artic
     8453             sj-goods.name
     8454             sj-adv.qnty
     8455             sj-adv.qnty
     8456             sj-adv.brutto-sum
     8457             sj-adv.discnt-sum
     8458             pcnt
     8459             sj-adv.netto-sum
     8460             with FRAME sj-base-t .
     8461           end.
     8462           when 3 then do:
     8463           DISPLAY STREAM PrnLibStream
     8464           substitute("ИТОГО ч- &1", v-num-chk) @ sj-goods.name
     8465           ACCUM TOTAL sj-adv.qnty @ sj-adv.qnty
     8466           ACCUM TOTAL sj-adv.qnty-2 @ sj-adv.qnty-2
     8467           ACCUM TOTAL sj-adv.qnty-3 @ sj-adv.qnty-3
     8468           ACCUM TOTAL sj-adv.brutto-sum @ sj-adv.brutto-sum
     8469           ACCUM TOTAL sj-adv.brutto-sum-r @ sj-adv.brutto-sum-r
     8470           ACCUM TOTAL sj-adv.discnt-sum @ sj-adv.discnt-sum
     8471           (IF (ACCUM TOTAL sj-adv.qnty) <> 0
     8472           THEN
     8473           round( ( ACCUM TOTAL sj-adv.discnt-sum ) /
     8474                         ( ACCUM TOTAL sj-adv.brutto-sum ) * 100 , 1 )
     8475           ELSE 0) @ pcnt
     8476           ACCUM TOTAL sj-adv.netto-sum @ sj-adv.netto-sum
     8477           ACCUM TOTAL sj-adv.netto-sum-r @ sj-adv.netto-sum-r
     8478           with FRAME sj-full-t .
     8479           DOWN STREAM PrnLibStream 1 with FRAME sj-full-t .
     8480           DISPLAY STREAM PrnLibStream
     8481           (string(round((ACCUM TOTAL sj-adv.qnty) / v-num-chk, 2)) + "/ч")  @ sj-adv.qnty
     8482           (string(round((ACCUM TOTAL sj-adv.qnty-2) / v-num-chk, 2)) + "/ч") @ sj-adv.qnty-2
     8483           (string(round((ACCUM TOTAL sj-adv.qnty-3) / v-num-chk, 2)) + "/ч") @ sj-adv.qnty-3
     8484           with FRAME sj-full-t .
     8485           DOWN STREAM PrnLibStream 1 with FRAME sj-full-t .
     8486           UNDERLINE STREAM PrnLibStream
     8487           sj-goods.b-code
     8488           sj-goods.artic
     8489           sj-goods.name
     8490           sj-adv.qnty
     8491           sj-adv.qnty-2
     8492           sj-adv.qnty-3
     8493           sj-adv.brutto-sum
     8494           sj-adv.brutto-sum-r
     8495           sj-adv.discnt-sum
     8496           pcnt
     8497           sj-adv.netto-sum
     8498           sj-adv.netto-sum-r
     8499           with FRAME sj-full-t .
     8500         end.
     8501       END CASE .
     8502       if ObjsQnty = 1 then
     8503       PUT STREAM PrnLibStream
     8504       " " SKIP(1) space(10)
     8505       "Директор ______________" format "X(50)"
     8506       "Кассир ___________________" format "X(50)" SKIP .
     8507     end.
     8508       END .
     8509     end.
     8510   end.
     8511   END PROCEDURE.
