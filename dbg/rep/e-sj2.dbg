     4841           round( ( ACCUM TOTAL sj-adv.discnt-sum ) /
     4842                       ( ACCUM TOTAL sj-adv.brutto-sum ) * 100 , 1 ) ELSE 0) @ pcnt
     4843           ACCUM TOTAL sj-adv.netto-sum @ sj-adv.netto-sum
     4844               with FRAME sj-base-t .
     4845           DOWN STREAM PrnLibStream 1 with FRAME sj-base-t .
     4846           DISPLAY STREAM PrnLibStream
     4847           (string(round((ACCUM TOTAL sj-adv.qnty) / v-num-chk, 2)) + "/ч")  @ sj-adv.qnty
     4848           (string(round((ACCUM TOTAL sj-adv.qnty-2) / v-num-chk, 2)) + "/ч") @ sj-adv.qnty-2
     4849           (string(round((ACCUM TOTAL sj-adv.qnty-3) / v-num-chk, 2)) + "/ч") @ sj-adv.qnty-3
     4850           with FRAME sj-base-t .
