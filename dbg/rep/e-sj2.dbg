      576   function diff-list returns character (
      577     input parfirst-list  as character,
      578     input parsecond-list as character,
      579     input pardelim       as character).
      580     if pardelim = ""
      581     or pardelim = ?
      582     then do:
      583       assign
      584         pardelim = ","
      585       .
      586     end.
      587     def var ind as integer no-undo .
      588     def var v-elem as character no-undo .
      589     def var v-result-list as character no-undo init "".
      590     def var v-num-parfirst-list as integer no-undo .
      591     assign
      592       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      593     .
      594     do ind = 1 to v-num-parfirst-list
      595     :
      596       assign
      597         v-elem = entry(ind, parfirst-list, pardelim)
      598       .
      599       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
      600         assign
      601           v-result-list = v-result-list
      602                         + (if v-result-list > "" then pardelim else "")
      603                         + v-elem
      604         .
      605       end.
      606     end.
      607     return v-result-list .
      608   end function.
      609   function add-list returns character (
      610    input parfirst-list  as character,
      611    input parsecond-list as character,
      612    input pardelim       as character).
      613     if pardelim = ""
      614     or pardelim = ?
      615     then do:
      616       assign
      617         pardelim = ","
      618       .
      619     end.
      620     def var ind as integer no-undo .
      621     def var v-elem as character no-undo .
      622     def var v-result-list as character no-undo init "".
      623     def var v-num-parfirst-list as integer no-undo .
      624     assign
      625       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      626     .
      627     do ind = 1 to v-num-parfirst-list
      628     :
      629       assign
      630         v-elem = entry(ind, parfirst-list, pardelim)
      631       .
      632       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      633         assign
      634           v-result-list = v-result-list
      635                         + (if v-result-list > "" then pardelim else "")
      636                         + v-elem
      637         .
      638       end.
      639     end.
      640     def var v-num-parsecond-list as integer no-undo .
      641     assign
      642       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
      643     .
      644     do ind = 1 to v-num-parsecond-list
      645     :
      646       assign
      647         v-elem = entry(ind, parsecond-list, pardelim)
      648       .
      649       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      650         assign
      651           v-result-list = v-result-list
      652                         + (if v-result-list > "" then pardelim else "")
      653                         + v-elem
      654         .
      655       end.
      656     end.
      657     return v-result-list .
      658   end function.
      659   function cross-list returns character (
      660    input parfirst-list  as character,
      661    input parsecond-list as character,
      662    input pardelim       as character).
      663     if pardelim = ""
      664     or pardelim = ?
      665     then do:
      666       assign
      667         pardelim = ","
      668       .
      669     end.
      670     def var ind as integer no-undo .
      671     def var v-elem as character no-undo .
      672     def var v-result-list as character no-undo init "".
      673     def var v-num-parfirst-list as integer no-undo .
      674     assign
      675       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      676     .
      677     do ind = 1 to v-num-parfirst-list
      678     :
      679       assign
      680         v-elem = entry(ind, parfirst-list, pardelim)
      681       .
      682       if lookup(v-elem, v-result-list, pardelim) = 0
      683       and lookup(v-elem, parsecond-list, pardelim) > 0
      684       then do:
      685         assign
      686           v-result-list = v-result-list
      687                         + (if v-result-list > "" then pardelim else "")
      688                         + v-elem
      689         .
      690       end.
      691     end.
      692     return v-result-list .
      693   end function.
      694   function radio-label returns character (
      695    input par-rs-value  as character,
      696    input par-rs-radio-buttons as character)
      697    .
      698    DEFINE variable v-result-label as character no-undo.
      699    assign
      700    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
      701                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
      702                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
      703                             ), par-rs-radio-buttons
      704                           )
      705    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      706    .
      707   return v-result-label.
      708   end function.
      709   function m-radio-label returns character (
      710    input par-rs-value  as character,
      711    input par-rs-radio-buttons as character,
      712    input par-delim as character
      713    )
      714    .
      715    DEFINE variable v-result-label as character no-undo.
      716    assign
      717    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
      718                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
      719                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
      720                             ), par-rs-radio-buttons, par-delim
      721                           )
      722    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      723    .
      724   return v-result-label.
      725   end function.
      726   FUNCTION mixlist returns character
      727   (
      728    input parfirst-list  as character
      729    ,input parsecond-list as character
      730    ,input pardelim       as character
      731    ,input pardelim-result as character ) :
      732     if pardelim = ""
      733     or pardelim = ?
      734     then do:
      735       assign
      736         pardelim = ","
      737       .
      738     end.
      739     def var ind as integer no-undo .
      740     def var v-elem1 as character no-undo .
      741     def var v-elem2 as character no-undo .
      742     def var v-result-list as character no-undo init "".
      743     do ind = 1 to num-entries(parfirst-list, pardelim)
      744     :
      745       assign
      746         v-elem1 = entry(ind, parfirst-list, pardelim)
      747         v-elem2 = entry(ind, parsecond-list, pardelim)
      748       .
      749         assign
      750           v-result-list = v-result-list
      751                         + (if v-result-list > "" then pardelim-result else "")
      752                         + v-elem1 + pardelim-result + v-elem2
      753         .
      754     end.
      755     return v-result-list .
      756   END FUNCTION.
