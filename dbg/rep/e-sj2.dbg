     2852                           sj-goods.artic
     2853                           sj-goods.name
     2854                           with FRAME sj-base-t .
     2855   end.
     2856                       end.
     2857           if first-of( sj-goods.grp-name  ) then do:
     2858             if v-curr-r-b = 'base':U then do:
     2859               if my-Set_Val_Type = 2 then do:
     2860                 if frame sj-base-t:line = 0 then do:
