     2913                 format "x(120)" SKIP .
     2914                 if my-Set_Val_Type = 2 then do:
     2915                   UNDERLINE STREAM PrnLibStream
     2916                   sj-goods.artic
     2917                   sj-goods.name
     2918                   with FRAME sj-base-t .
     2919                 end.
     2920                 else do:
     2921                   UNDERLINE STREAM PrnLibStream
     2922                   sj-goods.artic
     2923                   sj-goods.name
     2924                   with FRAME sj-full-t .
