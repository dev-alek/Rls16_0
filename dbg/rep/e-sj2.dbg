     4853           sj-goods.b-code
     4854           sj-goods.artic
     4855           sj-goods.name
     4856           sj-adv.qnty
     4857           sj-adv.qnty-2
     4858           sj-adv.qnty-3
     4859           sj-adv.brutto-sum
     4860           sj-adv.discnt-sum
     4861           pcnt
     4862           sj-adv.netto-sum
     4863           with FRAME sj-base-t .
     4864         end.
     4865         when 3 then do:
     4866           if OneLinePrinted then
     4867           PUT STREAM PrnLibStream LINE  SKIP.
     4868           DISPLAY STREAM PrnLibStream
     4869           substitute("ИТОГО ч- &1", v-num-chk) @ sj-goods.name
     4870           ACCUM TOTAL sj-adv.qnty @ sj-adv.qnty
