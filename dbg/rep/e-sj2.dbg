     2866                 if frame sj-full-t:line = 0 then do:
     2867                   down 1 stream PrnLibStream
     2868                   with frame sj-full-t.
     2869                 end.
     2870               end.
     2871               PUT STREAM PrnLibStream string( "   ГРУППА : " +  get-grp-name(sj-goods.grp-name) ) format "x(120)" SKIP.
     2872               if my-Set_Val_Type = 2 then do:
     2873                 UNDERLINE STREAM PrnLibStream
     2874                 sj-goods.artic
     2875                 sj-goods.name
     2876                 with FRAME sj-base-t .
     2877               end.
     2878               else do:
