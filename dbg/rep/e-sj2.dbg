     4884           (string(round((ACCUM TOTAL sj-adv.qnty) / v-num-chk, 2)) + "/ч") @ sj-adv.qnty
     4885           (string(round((ACCUM TOTAL sj-adv.qnty-2) / v-num-chk, 2)) + "/ч") @ sj-adv.qnty-2
     4886           (string(round((ACCUM TOTAL sj-adv.qnty-3) / v-num-chk, 2)) + "/ч") @ sj-adv.qnty-3
     4887           with FRAME sj-full-t .
     4888           DOWN STREAM PrnLibStream 1 with FRAME sj-full-t .
     4889           UNDERLINE STREAM PrnLibStream
     4890           sj-goods.b-code
     4891           sj-goods.artic
     4892           sj-goods.name
     4893           sj-adv.qnty
     4894           sj-adv.qnty-2
     4895           sj-adv.qnty-3
     4896           sj-adv.brutto-sum
