     3861   PROCEDURE ProdGrpProc-t.
     3862   define variable v-salesman-name as character no-undo .
     3863   define buffer buf_saleman for ub.clients.
     3864   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3865   if SHRS-Sort = "Article":U then do:
     3866     FOR EACH sj-goods NO-LOCK,
     3867       EACH sj-adv NO-LOCK WHERE
     3868            sj-adv.obj-attr = sj-goods.obj-attr AND
     3869            sj-adv.b-code = sj-goods.b-code AND
     3870            sj-adv.saleman-chr = sj-goods.saleman-chr
     3871       BREAK BY sj-goods.obj-attr
     3872             BY sj-goods.prod-name
     3873             BY sj-goods.grp-name
     3874             BY sj-goods.saleman-chr
     3875             BY sj-goods.artic
     3876             BY sj-goods.b-code
     3877             BY sj-adv.price
     3878             :
     3879   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3880   if first( sj-goods.obj-attr ) then do:
     3881     if v-curr-r-b = 'base':U then do:
     3882                           if my-set_val_type = 2  then
     3883                               DOWN STREAM PrnLibStream 1 with FRAME sj-base-t .
     3884                           else
     3885                               DOWN STREAM PrnLibStream 1 with FRAME sj-full-t .
     3886     end.
     3887     else do:
     3888                               DOWN STREAM PrnLibStream 1 with FRAME sj-base-t .
     3889     end.
     3890   end.
     3891                   if first-of( sj-goods.obj-attr ) AND ( ObjsQnty > 1 ) then  do:
     3892                           assign
     3893                           strbuf1 = substr( sj-goods.obj-attr, 1, 3 )
     3894                           intbuf1 = integer( substr( sj-goods.obj-attr, 4 ) ) .
     3895                           FIND FIRST cli-obj WHERE
