      559   def var vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      560   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
      561   procedure paramls-clear :
      562     define buffer buf_temp-param for temp-param .
      563     do
      564     on error undo, return error return-value
      565     :
      566       for each buf_temp-param
      567       on error undo, return error
      568       :
      569         delete buf_temp-param .
      570       end.
      571     end.
      572   end procedure.
      573   procedure paramls-write :
      574     define input  parameter p-code     as character no-undo .
      575     define input  parameter p-sub-code as character no-undo .
      576     define input  parameter p-value    as character no-undo .
      577     define buffer buf_temp-param for temp-param .
      578     do
      579     on error undo, return error return-value
      580     :
      581       find first buf_temp-param
      582         where buf_temp-param.param-code     = p-code
      583           and buf_temp-param.param-sub-code = p-sub-code
      584         no-error .
      585       if not available buf_temp-param then do:
      586         create buf_temp-param .
      587         assign
      588           buf_temp-param.param-code     = p-code
      589           buf_temp-param.param-sub-code = p-sub-code
      590         .
      591       end.
      592       assign
      593         buf_temp-param.param-value = p-value
      594       .
      595     end.
      596   end procedure.
      597   procedure paramls-read :
      598     define input  parameter p-code          as character no-undo .
      599     define input  parameter p-sub-code      as character no-undo .
      600     define input  parameter p-default-value as character no-undo .
      601     define output parameter p-value         as character no-undo .
      602     define buffer buf_temp-param for temp-param .
      603     do
      604     on error undo, return error return-value
      605     :
      606       find first buf_temp-param
      607         where buf_temp-param.param-code     = p-code
      608           and buf_temp-param.param-sub-code = p-sub-code
      609         no-error .
      610       if available buf_temp-param then do:
      611         assign
      612           p-value = buf_temp-param.param-value
      613         .
      614       end.
      615       else do:
      616         assign
      617           p-value = p-default-value
      618         .
      619       end.
      620     end.
      621   end procedure.
      622   procedure paramls-append :
      623     define input  parameter p-code     as character no-undo .
      624     define input  parameter p-sub-code as character no-undo .
      625     define input  parameter p-value    as character no-undo .
      626     define buffer buf_temp-param for temp-param .
      627     do
      628     on error undo, return error return-value
      629     :
      630       find first buf_temp-param
      631            where buf_temp-param.param-code     = p-code
      632              and buf_temp-param.param-sub-code = p-sub-code
      633         no-error .
      634       if not available buf_temp-param then do:
      635         create buf_temp-param .
      636         assign
      637           buf_temp-param.param-code     = p-code
      638           buf_temp-param.param-sub-code = p-sub-code
      639           buf_temp-param.param-value    = p-value
      640         .
      641       end.
      642       else do:
      643           assign
      644               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
      645           .
      646       end.
      647     end.
      648   end procedure.
      649   define variable vss-include-info8 as character format "X(65)" no-undo
      650   initial "@(#)$Workfile$ $Revision$".
      651   define stream excel-line.
      652   define stream excel-cell.
      653   define temp-table temp_cell-data no-undo
      654       field data-key as character
      655       field data-value as character
      656       index pi is primary unique data-key
      657   .
      658   define temp-table temp_line-data no-undo
      659       field data-key     as character
      660       field xl-line-id   as integer
      661       field iCounter    as integer
      662       field cTb-code    as character format "X(10)"
      663       field artic       like ub.goods.artic
      664       field gds-name    like ub.goods.gds-name
      665       field qnty        as decimal
      666       field unit-base   like ub.goods.unit-base
      667       field last-date   like ub.parts.last-date
      668       field PS          like ub.parts.PS
      669       field price-rubl  like ub.parts.price-rubl
      670       field list-b-code as character
      671       index pi is primary unique xl-line-id
      672   .
      673   define variable v-specifxl-current-data-row     as integer      no-undo.
      674   define variable v-specifxl-cell-file-name       as character    no-undo.
      675   define variable v-specifxl-data-file-name       as character    no-undo.
      676   procedure specifxl-init :
      677       define buffer buf_temp_cell-data        for temp_cell-data.
      678   do
      679   for buf_temp_cell-data on error undo, return error :
      680       assign
      681           v-specifxl-current-data-row = 0
      682       .
      683       run gbl/_tmpfile.p
      684         (input  "xd"
      685         ,input  ".txt"
      686         ,output v-specifxl-data-file-name
      687         ).
      688       output stream excel-line to value( v-specifxl-data-file-name ).
      689       run gbl/_tmpfile.p
      690         (input "xc"
      691         ,input ".txt"
      692         ,output v-specifxl-cell-file-name
      693         ).
      694       output stream excel-cell to value( v-specifxl-cell-file-name ).
      695       run specifxl-write-cell-data in this-procedure
      696            (input "valutCode":U
      697            ,input "0":U
      698         ).
      699       run specifxl-write-cell-data in this-procedure (
      700             input "regularExpressions":U
      701           , input "1":U
      702         ).
      703       if print_zak then do:
      704         run specifxl-write-cell-data in this-procedure (
      705               input "columnList":U
      706             , input "ID,code,artic,name,qnty,EI,ldate,PS,price,listbcode":U
      707         ).
      708         run specifxl-write-cell-data in this-procedure (
      709               input "columnType":U
      710             , input "I,S,S,S,D,S,S,S,D,S":U
      711         ).
      712         run specifxl-write-cell-data in this-procedure (
      713               input "columnAmount":U
      714             , input "10":U
      715         ).
      716       end.
      717       else do:
      718         run specifxl-write-cell-data in this-procedure (
      719               input "columnList":U
      720             , input "ID,code,artic,name,qnty,EI,ldate,PS,listbcode":U
      721         ).
      722         run specifxl-write-cell-data in this-procedure (
      723               input "columnType":U
      724             , input "I,S,S,S,D,S,S,S,S":U
      725         ).
      726         run specifxl-write-cell-data in this-procedure (
      727               input "columnAmount":U
      728             , input "9":U
      729         ).
      730       end.
      731   end.
      732   end procedure.
      733   procedure specifxl-close :
      734   do
      735   on error undo, return error
      736   :
      737       output stream excel-line close.
      738       output stream excel-cell close.
      739       output to value( string( session:temp-directory + "$" + string( g#report-num ) ) + ".txl" ) append.
      740         if print_zak then do:
      741           export "exe/specif.xlt":U.
      742         end.
      743         else do:
      744           export "exe/specif1.xlt":U.
      745         end.
      746           export "exe/t_97.bas":U.
      747           export v-specifxl-cell-file-name.
      748           export v-specifxl-data-file-name.
      749       output close.
      750   end.
      751   end procedure.
      752   procedure specifxl-write-cell-data :
      753   define input parameter p-data-key   as character        no-undo.
      754   define input parameter p-data-value as character        no-undo.
      755       define buffer buf_temp_cell-data     for temp_cell-data.
      756   do
      757   for buf_temp_cell-data
      758   on error undo, return error
      759   :
      760       find first buf_temp_cell-data
      761            where buf_temp_cell-data.data-key = p-data-key
      762       no-error.
      763       if not available buf_temp_cell-data
      764       then do:
      765           create buf_temp_cell-data.
      766           assign
      767               buf_temp_cell-data.data-key = p-data-key
      768           .
      769       end.
      770       assign
      771           buf_temp_cell-data.data-value = p-data-value
      772       .
      773       put stream excel-cell unformatted
      774                           buf_temp_cell-data.data-key
      775           chr(9)   buf_temp_cell-data.data-value
      776           chr(10)
      777       .
      778   end.
      779   end procedure.
      780   procedure specifxl-write-line-data :
      781   define input parameter p-Counter     as integer               no-undo.
      782   define input parameter p-cTb-code    as character format "X(10)" no-undo.
      783   define input parameter p-artic       like goods.artic         no-undo.
      784   define input parameter p-gds-name    like ub.goods.gds-name   no-undo.
      785   define input parameter p-qnty        as decimal               no-undo.
      786   define input parameter p-unit-base   like ub.goods.unit-base  no-undo.
      787   define input parameter p-last-date   like ub.parts.last-date  no-undo.
      788   define input parameter p-PS          like ub.parts.PS         no-undo.
      789   define input parameter p-price-rubl  like ub.parts.price-rubl no-undo.
      790   define input parameter p-list-b-code as character             no-undo.
      791   define input parameter p-print_zak   as logical               no-undo.
      792   define buffer buf_temp_line-data        for temp_line-data.
      793   do
      794   for buf_temp_line-data
      795   on error undo, return error
      796   :
      797     for each buf_temp_line-data
      798     :
      799         delete buf_temp_line-data.
      800     end.
      801     create buf_temp_line-data.
      802     assign
      803       v-specifxl-current-data-row = v-specifxl-current-data-row + 1
      804     .
      805     assign
      806       buf_temp_line-data.data-key     = "LD":U
      807       buf_temp_line-data.xl-line-id   = v-specifxl-current-data-row
      808       buf_temp_line-data.iCounter     = p-Counter
      809       buf_temp_line-data.cTb-code     = p-cTb-code
      810       buf_temp_line-data.artic        = p-artic
      811       buf_temp_line-data.gds-name     = p-gds-name
      812       buf_temp_line-data.qnty         = p-qnty
      813       buf_temp_line-data.unit-base    = p-unit-base
      814       buf_temp_line-data.last-date    = p-last-date
      815       buf_temp_line-data.PS           = p-PS
      816       buf_temp_line-data.price-rubl   = p-price-rubl
      817       buf_temp_line-data.list-b-code  = p-list-b-code
      818     .
      819     put stream excel-line unformatted
      820                       buf_temp_line-data.data-key
      821       chr(9)   ( if buf_temp_line-data.iCounter = 0 then "":U else string( buf_temp_line-data.iCounter ) )
      822       chr(9)   buf_temp_line-data.cTb-code
      823       chr(9)   buf_temp_line-data.artic
      824       chr(9)   buf_temp_line-data.gds-name
      825       chr(9)   ( if buf_temp_line-data.qnty = 0 then "" else string( buf_temp_line-data.qnty ) )
      826       chr(9)   buf_temp_line-data.unit-base
      827       chr(9)   ( if buf_temp_line-data.iCounter = 0 then ( if buf_temp_line-data.last-date = ? then "":U else string( buf_temp_line-data.last-date, "99.99.9999" ) ) else "":U )
      828       chr(9)   buf_temp_line-data.PS
      829       chr(9)   ( if print_zak then ( if buf_temp_line-data.price-rubl = 0 then "" else string( buf_temp_line-data.price-rubl ) ) else buf_temp_line-data.list-b-code )
      830       ( if print_zak then chr(9) else "" )
      831       ( if print_zak then buf_temp_line-data.list-b-code else "" )
      832       chr(10)
      833     .
      834   end.
      835   end procedure.
      836   procedure specifxl-run-excel :
      837     define input parameter p-header-filename    as character        no-undo.
      838     define input parameter p-data-filename      as character        no-undo.
      839     define variable v-template-file-name    as character    no-undo.
      840     define variable v-vb-file-name          as character    no-undo.
      841     define buffer buf_temp-param for temp-param .
      842     do for buf_temp-param on error undo, return error :
      843       create buf_temp-param.
      844       assign
      845           v-template-file-name    = search( "exe/sp_97.xlt" )
      846           v-vb-file-name          = search( "exe/t_97.bas")
      847       .
      848       if v-template-file-name = ?  or v-template-file-name = "":U  then do:
      849           message  "Ошибка имени файла шаблона." view-as alert-box error.
      850       end.
      851       if v-vb-file-name = ?  or v-vb-file-name = "":U then do:
      852           message  "Ошибка имени файла кода обработки."   view-as alert-box error.
      853       end.
      854       run paramls-write in this-procedure (
      855             input "template":U
      856           , input "template-file-name":U
      857           , input v-template-file-name
      858       ).
      859       run paramls-write in this-procedure (
      860             input "template":U
      861           , input "vb-file-name":U
      862           , input v-vb-file-name
      863       ).
      864       run paramls-write in this-procedure (
      865             input "data":U
      866           , input "data-header-filename":U
      867           , input p-header-filename
      868       ).
      869       run paramls-write in this-procedure (
      870             input "data":U
      871           , input "data-filename":U
      872           , input p-data-filename
      873       ).
      874       run gbl/macroxlt.p (
      875           input-output table buf_temp-param
      876       ) no-error.
      877       if error-status :error
      878       then do:
      879           message vss-workfile vss-revision vss-description skip(1)
      880               skip "Ошибка создания файла Excel."
      881               skip return-value
      882               skip trim(error-status :get-message(1))
      883                    trim(error-status :get-message(2))
      884                    trim(error-status :get-message(3))
      885           view-as alert-box error.
      886           undo, return error .
      887       end.
      888     end.
      889   end procedure.
      890   DEFINE STREAM Out_Stream.
      891   DEFINE FRAME parts-print
      892           sym1 column-label ":!:" format "X(1)"
      893           Lines_Counter COLUMN-LABEL " N!п/п" format ">>>9"
      894           sym2 column-label ":!:" format "X(1)"
      895           tb-code column-label "Код" format "x(10)"
      896           sym3 column-label ":!:" format "X(1)"
      897           goods.artic COLUMN-LABEL "Артикул" format "X(16)"
      898           sym4 column-label ":!:" format "X(1)"
      899           goods.gds-name COLUMN-LABEL "Наименование!Партия" format "X(40)"
      900           sym5 column-label ":!:" format "X(1)"
      901           parts.fact-qnty COLUMN-LABEL " Количество " format "->>>,>>9.<<<"
      902           sym6 column-label ":!:" format "X(1)"
      903           goods.unit-base COLUMN-LABEL "Ед.!изм." format "X(4)"
      904           sym7 column-label ":!:" format "X(1)"
      905           parts.last-date COLUMN-LABEL "Срок!годности" format "99.99.9999"
      906           sym8 column-label ":!:" format "X(1)"
      907           parts.PS COLUMN-LABEL "Описание" format "X(46)"
      908           sym9 column-label ":!:" format "X(1)"
      909           list-b-code COLUMN-LABEL "БАР-КОДЫ по товару" format "X(27)"
      910           sym10 column-label ":!:" format "X(1)"
      911       HEADER
      912           cur-time-print() AT 5 format "X(35)"
      913               tdoc-code AT 70 format "X(10)" " от " tdoc-date format "99/99/99"
      914               "Страница " AT 120 PAGE-NUMBER( Out_Stream ) AT 130 FORMAT ">>9" SKIP
      915           Line format "X(197)" AT 1
      916       with width 235 down stream-io.
      917   DEFINE FRAME parts-print1
      918           sym1 column-label ":!:" format "X(1)"
      919           Lines_Counter COLUMN-LABEL " N!п/п" format ">>>9"
      920           sym2 column-label ":!:" format "X(1)"
      921           tb-code column-label "Код" format "x(10)"
      922           sym3 column-label ":!:" format "X(1)"
      923           goods.artic COLUMN-LABEL "Артикул" format "X(16)"
      924           sym4 column-label ":!:" format "X(1)"
      925           goods.gds-name COLUMN-LABEL "Наименование!Партия" format "X(40)"
      926           sym5 column-label ":!:" format "X(1)"
      927           parts.fact-qnty COLUMN-LABEL " Количество " format "->>>,>>9.<<<"
      928           sym6 column-label ":!:" format "X(1)"
      929           goods.unit-base COLUMN-LABEL "Ед.!изм." format "X(4)"
      930           sym7 column-label ":!:" format "X(1)"
      931           parts.last-date COLUMN-LABEL "Срок!годности" format "99.99.9999"
      932           sym8 column-label ":!:" format "X(1)"
      933           parts.PS COLUMN-LABEL "Описание" format "X(32)"
      934           sym9 column-label ":!:" format "X(1)"
      935           parts.price-rubl COLUMN-LABEL "   Цена  "   format "->>>,>>9.99"
      936           sym10 column-label ":!:" format "X(1)"
      937           list-b-code COLUMN-LABEL "БАР-КОДЫ по товару" format "X(27)"
      938           sym11 column-label ":!:" format "X(1)"
      939       HEADER
      940           cur-time-print() AT 5 format "X(35)"
      941               tdoc-code AT 70 format "X(10)" " от " tdoc-date format "99/99/99"
      942               "Страница " AT 120 PAGE-NUMBER( Out_Stream ) AT 130 FORMAT ">>9" SKIP
      943           Line format "X(197)" AT 1
      944       with width 235 down stream-io.
      945   FIND trn-doc WHERE recid( trn-doc ) = rec_id  NO-LOCK.
      946   if session:set-wait-state("compiler") then.
      947   Line = fill("-", 200).
      948   assign
      949     Lines_Counter = 0
      950     tdoc-code = trn-doc.doc-code
      951     tdoc-date = trn-doc.doc-date
      952   .
      953   run get-report-num  in parParentProc(output g#report-num).
      954   run get-quest-print in parParentProc(output g#quest-print).
      955   output STREAM Out_Stream to value( string( session:temp-directory +
      956                                        "rpt" + string( g#report-num ) ) )
      957                                        page-size 62 .
      958   run specifxl-init in this-procedure .
      959    if print_zak = yes then do:
      960      FORM with FRAME parts-print1 .
      961    end.
      962    else do:
      963      FORM with FRAME parts-print .
      964    end.
      965    FORM HEADER
      966      Line format "X(197)" AT 1 SKIP "Продолжение - на следующей странице" AT 30 SKIP
      967      with FRAME BottomFrame width 198 PAGE-BOTTOM NO-LABELS NO-BOX .
      968    VIEW STREAM Out_Stream FRAME BottomFrame .
      969   PUT STREAM Out_Stream "С П Е Ц И Ф И К А Ц И Я   к документу N "
      970       AT 32 format "X(40)" trn-doc.doc-code format "X(10)" "  от  "
      971       trn-doc.doc-date format "99.99.9999" SKIP(1).
      972   run specifxl-write-cell-data in this-procedure (
      973         input "h_docName":U
      974       , input string("С П Е Ц И Ф И К А Ц И Я   к документу №  " + string(trn-doc.doc-code) ) + "  от  " + string( trn-doc.doc-date, "99.99.9999" )
      975   ).
      976   run specifxl-write-cell-data in this-procedure (
      977         input "h_printdate":U
      978       , input cur-time-print()
      979   ).
      980   FOR EACH doc-line WHERE doc-line.doc-code = trn-doc.doc-code NO-LOCK
      981                                                 BY doc-line.artic:
      982       FIND goods WHERE goods.prod-type = doc-line.prod-type AND
      983                                         goods.prod-code = doc-line.prod-code AND
      984                                         goods.artic = doc-line.artic NO-LOCK .
      985       if print_zak = yes then DISPLAY STREAM Out_Stream with FRAME parts-print1 .
      986       else                    DISPLAY STREAM Out_Stream with FRAME parts-print .
      987       assign
      988         Lines_Counter = Lines_Counter + 1
      989       .
      990   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
      991     (input  goods.gds-code
      992     ,input  ?
      993     ,output b-code
      994     ) no-error .
      995       if error-status :error then do:
      996         message vss-workfile vss-revision vss-description skip "Ошибка при определении бар-кода товара" skip  "Код товара" goods.gds-code skip
      997         view-as alert-box error .
      998         undo, return error .
      999       end.
     1000       run b-code-lst in this-procedure .
     1001       assign
     1002         full_list-b-code = list-b-code
     1003       .
     1004       run sub-b-code-lst in this-procedure  (input-output list-b-code, output new-list) .
     1005       if print_zak = no then do:
     1006         DISPLAY STREAM Out_Stream
     1007           sym1 Lines_Counter
     1008           sym2 string( goods.gds-code ) @ tb-code
     1009           sym3 goods.artic
     1010           sym4 goods.gds-name
     1011           sym5 (if can-do( 'факт':U , trn-doc.status_ ) then doc-line.fact-qnty else doc-line.doc-qnty) @ parts.fact-qnty
     1012           sym6 goods.unit-base
     1013           sym7
     1014           sym8
     1015           sym9 list-b-code
     1016           sym10
     1017         with FRAME parts-print .
     1018         DOWN STREAM Out_Stream 1 with FRAME parts-print .
     1019       end.
     1020       else do:
     1021           DISPLAY STREAM Out_Stream
     1022             sym1 Lines_Counter
     1023             sym2 string( goods.gds-code ) @ tb-code
     1024             sym3 goods.artic
     1025             sym4 goods.gds-name
     1026             sym5 (if can-do( 'факт':U , trn-doc.status_ ) then doc-line.fact-qnty else doc-line.doc-qnty) @ parts.fact-qnty
     1027             sym6 goods.unit-base
     1028             sym7
     1029             sym8
     1030             sym9
     1031             sym10 list-b-code
     1032             sym11
     1033           with FRAME parts-print1 .
     1034           DOWN STREAM Out_Stream 1 with FRAME parts-print1 .
     1035       end.
     1036       run fill-line( Lines_Counter, goods.gds-code, goods.artic, goods.gds-name,
     1037                      (if can-do( 'факт':U , trn-doc.status_ ) then doc-line.fact-qnty else doc-line.doc-qnty),
     1038                      goods.unit-base, ? , "" , 0 , full_list-b-code, print_zak ).
     1039       FOR EACH parts NO-LOCK
     1040         WHERE parts.out-code = trn-doc.doc-code
     1041           AND parts.artic = doc-line.artic
     1042           AND parts.prod-type = doc-line.prod-type
     1043           AND parts.prod-code = doc-line.prod-code
     1044       BREAK BY parts.part-code:
     1045           FIND bar-code WHERE bar-code.gds-code = goods.gds-code AND
     1046                                                 bar-code.unit-cli = goods.unit-base AND
     1047                                                 bar-code.part-code = parts.part-code AND
     1048                                                 bar-code.in-code = parts.in-code
     1049                                                 NO-LOCK NO-ERROR .
     1050           if available bar-code then do:
     1051             assign tb-code = string( bar-code.b-code ).
     1052             if lookup( tb-code, full_list-b-code ) = 0 then
     1053               assign
     1054                 part-b-code = tb-code
     1055                 full_list-b-code = full_list-b-code + (if full_list-b-code = "" then "" else ",") + tb-code
     1056                 new-list = new-list + (if new-list = "" then "" else ",") + tb-code
     1057               .
     1058             else
     1059               part-b-code = "".
     1060           end.
     1061           else
     1062               assign tb-code = "" part-b-code = "".
     1063           assign parts-PS = ENTRY( 1, parts.PS , chr( 10 ) ) .
     1064           DO i = 2 TO ( NUM-ENTRIES( parts.PS , chr( 10 ) ) ) :
     1065               assign parts-PS = parts-PS + " " + ENTRY( i, parts.PS , chr( 10 ) ) .
     1066           END.
     1067           assign parts-PS = trim( parts-PS ) .
     1068           parts-PS1 = breakstr(parts-PS, (if print_zak = yes then 32 else 46 ), input-output parts-PS1, input-output parts-PS2).
     1069           Assign
     1070             list-b-code = new-list
     1071           .
     1072           run sub-b-code-lst in this-procedure  (input-output list-b-code, output new-list) .
     1073           if print_zak = yes then do:
     1074             DISPLAY STREAM Out_Stream
     1075               sym1
     1076               sym2
     1077               sym3
     1078               sym4 ( if parts.part-code = "" then "  ----  " else parts.part-code ) @ goods.gds-name
     1079               sym5 ( if can-do( 'факт':U , trn-doc.status_ ) then parts.fact-qnty else parts.qnty ) @ parts.fact-qnty
     1080               sym6 goods.unit-base
     1081               sym7 parts.last-date
     1082               sym8 parts-PS1 @ parts.PS
     1083               sym9 ( if PrintRubl = yes then parts.price-rubl else parts.price-base ) @ parts.price-rubl
     1084               sym10 list-b-code
     1085               sym11
     1086             with FRAME parts-print1 .
     1087             DOWN STREAM Out_Stream 1 with FRAME parts-print1 .
     1088           end.
     1089           else do:
     1090             DISPLAY STREAM Out_Stream
     1091               sym1
     1092               sym2
     1093               sym3
     1094               sym4 ( if parts.part-code = "" then "  ----  " else parts.part-code ) @ goods.gds-name
     1095               sym5 ( if can-do( 'факт':U , trn-doc.status_ ) then parts.fact-qnty else parts.qnty ) @ parts.fact-qnty
     1096               sym6 goods.unit-base
     1097               sym7 parts.last-date
     1098               sym8 parts-PS1 @ parts.PS
     1099               sym9 list-b-code
     1100               sym10
     1101             with FRAME parts-print .
     1102             DOWN STREAM Out_Stream 1 with FRAME parts-print .
     1103           end.
     1104           run fill-line( 0 , "" , "" , ( if parts.part-code = "" then "  ----  " else parts.part-code ) ,
     1105                          ( if can-do( 'факт':U , trn-doc.status_ ) then parts.fact-qnty else parts.qnty ),
     1106                          goods.unit-base, parts.last-date, parts-PS,
     1107                          ( if PrintRubl = yes then parts.price-rubl else parts.price-base ), part-b-code, print_zak ).
     1108           assign parts-PS = trim( parts-PS2 ) .
     1109           DO WHILE parts-PS <> "" or new-list <> "" and last( parts.part-code ) :
     1110             parts-PS1 = breakstr(parts-PS, (if print_zak = yes then 32 else 46 ), input-output parts-PS1, input-output parts-PS2).
     1111             assign list-b-code = new-list .
     1112             run sub-b-code-lst in this-procedure  (input-output list-b-code, output new-list) .
     1113             if print_zak = yes then do:
     1114               DISPLAY STREAM Out_Stream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 parts-PS1 @ parts.PS sym9 sym10 list-b-code sym11 with FRAME parts-print1 .
     1115               DOWN STREAM Out_Stream 1 with FRAME parts-print1 .
     1116             end.
     1117             else do:
     1118               DISPLAY STREAM Out_Stream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 parts-PS1 @ parts.PS sym9 list-b-code sym10 with FRAME parts-print .
     1119               DOWN STREAM Out_Stream 1 with FRAME parts-print .
     1120             end.
     1121             assign parts-PS = trim( parts-PS2 ) .
     1122           END .
     1123       END.
     1124   END.
     1125   PUT STREAM Out_Stream Line format "X(197)" AT 1 SKIP .
     1126   HIDE STREAM Out_Stream FRAME BottomFrame .
     1127   output STREAM Out_Stream CLOSE.
     1128   run specifxl-close in this-procedure .
     1129   if session:set-wait-state("") then.
     1130   def var Log-Res as log no-undo .
     1131   define variable vss-include-info9 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1132   do:
     1133     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1134       (input  v-cntxt-db-num
     1135       ,input  v-cntxt-userid
     1136       ,input  0
     1137       ,input  'actn_waybills-to-file_print':U
     1138       ,input  'firm':U
     1139       ,input  trn-doc.host-code
     1140       ,input  '':U
     1141       ,input  0
     1142       ,input  0
     1143       ,input  0
     1144       ,input  0
     1145       ,input  false
     1146       ,output Log-Res
     1147       )  .
     1148   end.
     1149   if Log-Res then DO:
     1150   if g#quest-print = false
     1151   then do:
     1152     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
     1153                                         7, (if 0 >= 8 then 2 else 0), 0, 0,
     1154                                         OUTPUT g#log ).
     1155   end.
     1156   else do:
     1157     os-command silent
     1158       value( "COPY /b " +
     1159         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
     1160         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
     1161         string( session:temp-directory) +  "$" + string( g#report-num )
     1162                 ) .
     1163     os-command silent
     1164       value( "COPY /b " +
     1165         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
     1166         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
     1167         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
     1168                 ) .
     1169   end.
     1170      End.
     1171   else  DO:
     1172   if g#quest-print = false
     1173   then do:
     1174     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
     1175                                         7, (if 4 >= 8 then 2 else 0), 0, 0,
     1176                                         OUTPUT g#log ).
     1177   end.
     1178   else do:
     1179     os-command silent
     1180       value( "COPY /b " +
     1181         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
     1182         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
     1183         string( session:temp-directory) +  "$" + string( g#report-num )
     1184                 ) .
     1185     os-command silent
     1186       value( "COPY /b " +
     1187         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
     1188         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
     1189         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
     1190                 ) .
     1191   end.
     1192      End.
     1193   procedure b-code-lst :
     1194     do
     1195     on error undo, return error return-value
     1196     :
     1197         assign
     1198           is-new = yes
     1199           list-b-code = ""
     1200         .
     1201         for each prod-bc no-lock where prod-bc.b-code = b-code :
     1202           if is-new then do:
     1203             assign is-new = no .
     1204             if prod-bc.bc-on then assign list-b-code = "* " + prod-bc.b-str .
     1205             else assign list-b-code = prod-bc.b-str .
     1206           end.
     1207           else do:
     1208             if prod-bc.bc-on then assign list-b-code = list-b-code + ", " +  "* " + prod-bc.b-str .
     1209             else assign list-b-code = list-b-code + ", " + prod-bc.b-str .
     1210           end.
     1211           if length(list-b-code) > 30000 then do:
     1212             message vss-workfile vss-revision vss-description skip "Слишком много бар-кодов производителя! Список будет выводиться неполностью." skip  "Код товара " goods.gds-code " Артикул товара " goods.artic skip
     1213             view-as alert-box error .
     1214             leave.
     1215           end.
     1216         end.
     1217     end.
     1218   end procedure.
     1219   procedure sub-b-code-lst :
     1220     do
     1221     on error undo, return error return-value
     1222     :
     1223       define input-output  parameter str1 as character no-undo .
     1224       define output parameter        str2 as character no-undo .
     1225       assign  str2 = "" .
     1226       if length(str1) > 27 then do:
     1227         define variable nn as integer initial 0  no-undo .
     1228         define variable ii as integer initial 1  no-undo .
     1229         repeat :
     1230           ii = index(str1,',',ii) .
     1231           if ii > 27 or ii < 1 then leave.
     1232           assign
     1233             nn = ii
     1234             ii = ii + 1
     1235           .
     1236         end.
     1237         str2 = substr ( str1, nn + 1) .
     1238         str1 = substr ( str1, 1, nn - 1) .
     1239       end.
     1240     end.
     1241   end procedure.
     1242   Procedure fill-line :
     1243     define input parameter p-Counter     as integer               no-undo.
     1244     define input parameter p-cTb-code    as character format "X(10)" no-undo.
     1245     define input parameter p-artic       like goods.artic         no-undo.
     1246     define input parameter p-gds-name    like ub.goods.gds-name   no-undo.
     1247     define input parameter p-qnty        as decimal               no-undo.
     1248     define input parameter p-unit-base   like ub.goods.unit-base  no-undo.
     1249     define input parameter p-last-date   like ub.parts.last-date  no-undo.
     1250     define input parameter p-PS          like ub.parts.PS         no-undo.
     1251     define input parameter p-price-rubl  like ub.parts.price-rubl no-undo.
     1252     define input parameter p-list-b-code as character             no-undo.
     1253     define input parameter p-print_zak   as logical               no-undo.
     1254     run specifxl-write-line-data in this-procedure (
     1255               input p-Counter
     1256             , input p-cTb-code
     1257             , input p-artic
     1258             , input p-gds-name
     1259             , input p-qnty
     1260             , input p-unit-base
     1261             , input p-last-date
     1262             , input p-PS
     1263             , input p-price-rubl
     1264             , input p-list-b-code
     1265             , input p-print_zak
     1266     ).
     1267   end.
