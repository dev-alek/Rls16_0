        1   block-level on error undo, throw.
        2   define input parameter parParentProc as   widget-handle         no-undo.
        3   define input parameter rec_id        as recid.
        4   define input parameter print_zak     as log no-undo .
        5   def var vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        6   def var vss-author      as character no-undo init "$Author: expertek $":U .
        7   def var vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        8   def var vss-workfile    as character no-undo init "$Workfile: r-specif.p $":U .
        9   def var vss-archive     as character no-undo init "$Archive: rep/r-specif.p $":U .
       10   def var vss-description as character no-undo init "Печать спецификации к документу по партиям".
       11   procedure vss-get-info :
