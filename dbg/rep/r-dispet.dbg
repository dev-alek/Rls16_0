     2100   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2101   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2102   define variable tempcxml_v-num_ as integer no-undo .
     2103   define  temp-table temp-xml-tables no-undo
     2104   field order as integer
     2105   field tbl-name as character
     2106   field tbl-handle_ as handle
     2107   field table-handle_ as handle
     2108   field uniq-gate-rec as character
     2109   field gate-name as character
     2110   field gate-handle_ as handle
     2111   field is-parent as logical
     2112   index pi is unique primary
     2113   uniq-gate-rec
     2114   tbl-name
     2115   index iorder
     2116   order
     2117   index gr
     2118   uniq-gate-rec
     2119   index gh
     2120   gate-handle_
     2121   index iparent
     2122   is-parent
     2123   .
     2124   define  temp-table temp-xml-records no-undo
     2125   field tbl-name as character
     2126   field uniq-key-rec as character
     2127   index pi is unique primary
     2128   tbl-name
     2129   uniq-key-rec
     2130   .
     2131   def var vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2132   procedure gen-key-rec :
     2133     define input  parameter p-tbl-name    as character no-undo.
     2134     define input  parameter p-bh_tbl-name as handle    no-undo.
     2135     define output parameter p-key-rec     as character no-undo.
     2136     do
     2137     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2138     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     2139     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     2140     :
     2141       define variable fh               as handle    no-undo .
     2142       define variable v-ok             as logical   no-undo .
     2143       define variable v-inform         as character no-undo .
     2144       define variable v-ind            as integer   no-undo .
     2145       define variable v-idx-field-qnty as integer   no-undo .
     2146       if p-tbl-name = ?
     2147         or p-tbl-name = "":U
     2148       then do:
     2149         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info11 ).
     2150       end.
     2151       if not p-bh_tbl-name:available then do:
     2152         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info11, p-tbl-name ).
     2153       end.
     2154       assign
     2155         p-key-rec = p-tbl-name
     2156         v-inform  = p-bh_tbl-name:index-information(1)
     2157         v-ind     = 2
     2158       .
     2159       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2160       on error undo, return error
     2161       :
     2162         assign
     2163           v-inform = p-bh_tbl-name:index-information( v-ind )
     2164           v-ind    = v-ind + 1
     2165         .
     2166       end.
     2167       if v-inform = ?
     2168         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2169         or entry( 3, v-inform, ",":U ) <> "1":U
     2170       then do:
     2171         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info11, p-tbl-name ).
     2172       end.
     2173       else do:
     2174         assign
     2175           v-idx-field-qnty = num-entries( v-inform ) - 4
     2176         .
     2177         if v-idx-field-qnty < 2 then do:
     2178           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info11, v-inform, p-tbl-name ).
     2179         end.
     2180         do v-ind = 1 to v-idx-field-qnty by 2
     2181         on error undo, return error
     2182         :
     2183           assign
     2184             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     2185             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     2186           .
     2187         end.
     2188       end.
     2189       if p-key-rec = ? then do:
     2190         assign
     2191           p-key-rec = "":U
     2192         .
     2193         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info11, p-tbl-name ).
     2194       end.
     2195     end.
     2196     return.
     2197   end procedure.
     2198   procedure gen-where-keyr-tab :
     2199     define input  parameter i-tableSerach as character no-undo.
     2200     define input  parameter i-tablekey   as character  no-undo.
     2201     define input  parameter p-key-rec    as character  no-undo.
     2202     define input  parameter p-key-handle as handle     no-undo .
     2203     define input  parameter p-db-name    as character  no-undo .
     2204     define input  parameter p-tt-handle  as handle     no-undo .
     2205     define output parameter o-Where      as character  no-undo.
     2206     do
     2207     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2208     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     2209     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     2210     :
     2211       define variable v-full-tbl-name  as character no-undo .
     2212       define variable bh_tbl-name      as handle    no-undo .
     2213       define variable fh_key           as handle    no-undo .
     2214       define variable fh_search        as handle    no-undo .
     2215       define variable v-field-num      as integer   no-undo .
     2216       define variable v-count-fld      as integer   no-undo .
     2217       define variable v-inform         as character no-undo .
     2218       define variable v-ind            as integer   no-undo .
     2219       define variable v-idx-field-qnty as integer   no-undo .
     2220       define variable v-field-name     as character no-undo .
     2221       define variable v-field-val      as character no-undo .
     2222       define variable v-word-link      as character no-undo .
     2223       define variable vTable           as character no-undo.
     2224       define variable bh_tbl-key       as handle    no-undo .
     2225       assign
     2226         p-key-rec = trim( p-key-rec )
     2227       .
     2228       if p-key-handle <> ? then do:
     2229         if not valid-handle(p-key-handle)
     2230            or p-key-handle:type <> "buffer"
     2231         then do:
     2232           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info11 ).
     2233         end.
     2234         if num-entries( p-key-rec, chr(3) ) > 1
     2235           or p-key-rec = ?
     2236           or p-key-rec = "":U
     2237         then do:
     2238           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info11, p-key-rec ).
     2239         end.
     2240       end.
     2241       else do:
     2242         if p-key-rec = ?
     2243           or p-key-rec = "":U
     2244         then do:
     2245           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info11 ).
     2246         end.
     2247       end.
     2248       assign
     2249         vTable = entry( 1 , p-key-rec, chr(3) )
     2250       .
     2251       if p-tt-handle <> ?
     2252         and ( not valid-handle(p-tt-handle)
     2253               or p-tt-handle:type <> "buffer"
     2254             )
     2255       then do:
     2256         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info11, vTable, chr(10) ).
     2257       end.
     2258       if p-tt-handle = ? then do:
     2259         assign
     2260           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     2261         .
     2262         create buffer bh_tbl-name for table v-full-tbl-name .
     2263       end.
     2264       else do:
     2265         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     2266       end.
     2267       assign
     2268         v-inform = bh_tbl-name:index-information(1)
     2269         v-ind    = 2
     2270       .
     2271       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2272       on error undo, return error
     2273       :
     2274         assign
     2275           v-inform = bh_tbl-name:index-information( v-ind )
     2276           v-ind    = v-ind + 1
     2277         .
     2278       end.
     2279       if v-inform = ?
     2280         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2281         or entry( 3, v-inform, ",":U ) <> "1":U
     2282       then do:
     2283         delete object bh_tbl-name no-error.
     2284         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info11, vTable ).
     2285       end.
     2286       assign
     2287         v-idx-field-qnty = num-entries( v-inform ) - 4
     2288       .
     2289       if v-idx-field-qnty < 2 then do:
     2290         delete object bh_tbl-name no-error.
     2291         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info11, v-inform, vTable ).
     2292       end.
     2293       assign
     2294         o-where     = "where":U
     2295         v-word-link = "":U
     2296         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     2297         v-count-fld = 0
     2298       .
     2299       if i-tablekey ne "" and i-tablekey ne ?
     2300       then do:
     2301         assign
     2302           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     2303         .
     2304         create buffer bh_tbl-key for table v-full-tbl-name .
     2305       end.
     2306       if i-tableSerach ne "" and i-tableSerach ne ?
     2307       then do:
     2308         delete object bh_tbl-name no-error.
     2309         assign
     2310           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     2311         .
     2312         create buffer bh_tbl-name for table v-full-tbl-name .
     2313       end.
     2314       block_where:
     2315       do v-ind = 1 to v-idx-field-qnty by 2
     2316       on error undo, return error
     2317       :
     2318         assign
     2319           v-count-fld = v-count-fld + 1
     2320         .
     2321         if p-key-handle = ?
     2322           and v-count-fld > v-field-num
     2323         then do:
     2324           leave block_where.
     2325         end.
     2326         define variable VfieldKeyTable as handle no-undo.
     2327         assign
     2328           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     2329           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     2330         .
     2331         if     bh_tbl-key ne ?
     2332         then do:
     2333            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     2334            if VfieldKeyTable eq ?
     2335            then next block_where.
     2336         end.
     2337         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     2338         then
     2339            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     2340         else
     2341            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     2342         if p-key-handle = ? then do:
     2343           assign
     2344             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     2345           .
     2346         end.
     2347         else do:
     2348           assign
     2349             fh_key = p-key-handle:buffer-field( v-field-name )
     2350           .
     2351           if fh_key = ?
     2352             or not valid-handle( fh_key )
     2353           then do:
     2354             delete object bh_tbl-name.
     2355             if     bh_tbl-key ne ?
     2356             then
     2357                delete object bh_tbl-key.
     2358             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info11, p-key-handle:name, v-field-name ).
     2359           end.
     2360           assign
     2361             v-field-val = fh_key:buffer-value
     2362           .
     2363         end.
     2364         if fh_search:data-type ="character":U then do:
     2365           assign
     2366             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     2367             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     2368             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     2369             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     2370             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     2371             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     2372             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     2373             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     2374             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     2375             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     2376             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     2377             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     2378             v-field-val = substitute( '"&1"', v-field-val )
     2379           .
     2380         end.
     2381         assign
     2382           o-where = substitute( "&1 &2", o-where, v-field-val )
     2383         .
     2384         if v-word-link = "":U then do:
     2385           assign
     2386             v-word-link = "and":U
     2387           .
     2388         end.
     2389       end.
     2390       delete object bh_tbl-name.
     2391       if     bh_tbl-key ne ?
     2392       then
     2393          delete object bh_tbl-key.
     2394       if p-key-handle = ?
     2395         and v-count-fld <> v-field-num
     2396       then do:
     2397         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info11, vTable ).
     2398       end.
     2399     end.
     2400   end procedure.
     2401   procedure gen-hn-keyr-tab :
     2402     define input  parameter i-tableSerach as character no-undo.
     2403     define input  parameter i-tablekey   as character no-undo.
     2404     define input  parameter p-key-rec    as character no-undo.
     2405     define input  parameter p-key-handle as handle    no-undo .
     2406     define input  parameter p-db-name    as character no-undo .
     2407     define input  parameter p-tt-handle  as handle    no-undo .
     2408     define input  parameter p-stts-lock  as integer   no-undo .
     2409     define output parameter o-hn         as handle    no-undo.
     2410     define variable v-full-tbl-name as character no-undo.
     2411     define variable v-where         as character no-undo.
     2412     define variable bh_tbl-name     as handle    no-undo.
     2413     define variable vTable          as character no-undo.
     2414     do
     2415     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2416     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     2417     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     2418         run gen-where-keyr-tab(i-tableSerach,
     2419                                i-tablekey,
     2420                                p-key-rec,
     2421                                p-key-handle,
     2422                                p-db-name,
     2423                                p-tt-handle,
     2424                                output v-where).
     2425         if i-tableSerach ne "" and i-tableSerach ne ?
     2426         then do:
     2427            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     2428            create buffer bh_tbl-name for table v-full-tbl-name .
     2429         end.
     2430         else do:
     2431            if p-tt-handle = ? then do:
     2432               assign
     2433                  vTable = entry( 1 , p-key-rec, chr(3) )
     2434               .
     2435               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     2436               create buffer bh_tbl-name for table v-full-tbl-name .
     2437            end.
     2438            else do:
     2439               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     2440            end.
     2441         end.
     2442         if p-tt-handle = ? then do:
     2443            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     2444         end.
     2445         else do:
     2446            bh_tbl-name:find-first( v-where ) no-error .
     2447         end.
     2448         o-hn = bh_tbl-name.
     2449      end.
     2450   end procedure.
     2451   procedure gen-hn-keyr :
     2452     define input  parameter p-key-rec    as character no-undo.
     2453     define input  parameter p-key-handle as handle    no-undo .
     2454     define input  parameter p-db-name    as character no-undo .
     2455     define input  parameter p-tt-handle  as handle    no-undo .
     2456     define input  parameter p-stts-lock  as integer   no-undo .
     2457     define output parameter o-hn         as handle    no-undo.
     2458     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     2459   end.
     2460   procedure gen-row-keyr :
     2461     define input  parameter p-key-rec    as character no-undo.
     2462     define input  parameter p-key-handle as handle    no-undo .
     2463     define input  parameter p-db-name    as character no-undo .
     2464     define input  parameter p-tt-handle  as handle    no-undo .
     2465     define input  parameter p-stts-lock  as integer   no-undo .
     2466     define output parameter p-tbl-row    as rowid     no-undo.
     2467     define output parameter p-tbl-name   as character no-undo.
     2468     define variable vHn as handle no-undo.
     2469       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     2470       p-tbl-row = if vHn:available then vHn:rowid else ?.
     2471       p-tbl-name =  vHn:table.
     2472       delete object vHn no-error.
     2473     if p-tbl-row = ? then do:
     2474       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info11, p-tbl-name, p-key-rec ).
     2475     end.
     2476     else do:
     2477       return.
     2478     end.
     2479   end procedure.
     2480   procedure gen-key-fv :
     2481     define input  parameter p-key-rec    as character no-undo .
     2482     define output parameter p-field-list as character no-undo .
     2483     define output parameter p-value-list as character no-undo.
     2484     do
     2485     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2486     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     2487     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     2488     :
     2489       define variable v-full-tbl-name  as character no-undo .
     2490       define variable bh_tbl-name      as handle    no-undo .
     2491       define variable v-tbl-name       as character no-undo .
     2492       define variable v-field-num      as integer   no-undo .
     2493       define variable v-count-fld      as integer   no-undo .
     2494       define variable v-inform         as character no-undo .
     2495       define variable v-ind            as integer   no-undo .
     2496       define variable v-idx-field-qnty as integer   no-undo .
     2497       define variable v-delim-key      as character no-undo .
     2498       if p-key-rec = ?
     2499         or p-key-rec = "":U
     2500       then do:
     2501         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info11 ).
     2502       end.
     2503       assign
     2504         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     2505         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     2506       .
     2507       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     2508       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info11 ).
     2509       assign
     2510         v-inform = bh_tbl-name:index-information(1)
     2511         v-ind    = 2
     2512       .
     2513       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2514       on error undo, return error
     2515       :
     2516         assign
     2517           v-inform = bh_tbl-name:index-information( v-ind )
     2518           v-ind    = v-ind + 1
     2519         .
     2520       end.
     2521       if v-inform = ?
     2522         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2523         or entry( 3, v-inform, ",":U ) <> "1":U
     2524       then do:
     2525         delete object bh_tbl-name no-error.
     2526         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info11, v-tbl-name ).
     2527       end.
     2528       assign
     2529         v-idx-field-qnty = num-entries( v-inform ) - 4
     2530       .
     2531       if v-idx-field-qnty < 2 then do:
     2532         delete object bh_tbl-name no-error.
     2533         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info11, v-inform, v-tbl-name ).
     2534       end.
     2535       assign
     2536         p-field-list = "":U
     2537         p-value-list = "":U
     2538         v-delim-key  = "":U
     2539         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     2540         v-count-fld  = 0
     2541       .
     2542       block_where:
     2543       do v-ind = 1 to v-idx-field-qnty by 2
     2544       on error undo, return error
     2545       :
     2546         assign
     2547           v-count-fld = v-count-fld + 1
     2548         .
     2549         if v-count-fld > v-field-num then do:
     2550           leave block_where.
     2551         end.
     2552         assign
     2553           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     2554           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     2555         .
     2556         if v-ind = 1 then do:
     2557           assign
     2558             v-delim-key = chr(3)
     2559           .
     2560         end.
     2561       end.
     2562       delete object bh_tbl-name.
     2563       if v-count-fld <> v-field-num then do:
     2564         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info11, v-tbl-name ).
     2565       end.
     2566     end.
     2567   end procedure.
     2568   procedure gen-key-field :
     2569     define input  parameter p-table      as character no-undo .
     2570     define output parameter p-field-list as character no-undo .
     2571     do
     2572     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2573     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     2574     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     2575     :
     2576       define variable v-full-tbl-name  as character no-undo .
     2577       define variable bh_tbl-name      as handle    no-undo .
     2578       define variable v-tbl-name       as character no-undo .
     2579       define variable v-field-num      as integer   no-undo .
     2580       define variable v-count-fld      as integer   no-undo .
     2581       define variable v-inform         as character no-undo .
     2582       define variable v-ind            as integer   no-undo .
     2583       define variable v-idx-field-qnty as integer   no-undo .
     2584       define variable v-delim-key      as character no-undo .
     2585       if p-table = ?
     2586         or p-table = "":U
     2587       then do:
     2588         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info11 ).
     2589       end.
     2590       assign
     2591         v-tbl-name      = p-table
     2592         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     2593       .
     2594       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     2595       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info11 ).
     2596       assign
     2597         v-inform = bh_tbl-name:index-information(1)
     2598         v-ind    = 2
     2599       .
     2600       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2601       on error undo, return error
     2602       :
     2603         assign
     2604           v-inform = bh_tbl-name:index-information( v-ind )
     2605           v-ind    = v-ind + 1
     2606         .
     2607       end.
     2608       if v-inform = ?
     2609         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2610         or entry( 3, v-inform, ",":U ) <> "1":U
     2611       then do:
     2612         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info11, v-tbl-name ).
     2613       end.
     2614       assign
     2615         v-idx-field-qnty = num-entries( v-inform ) - 4
     2616       .
     2617       if v-idx-field-qnty < 2 then do:
     2618         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info11, v-inform, v-tbl-name ).
     2619       end.
     2620       assign
     2621         p-field-list = "":U
     2622         v-delim-key  = "":U
     2623         v-count-fld  = 0
     2624       .
     2625       block_where:
     2626       do v-ind = 1 to v-idx-field-qnty by 2
     2627       on error undo, return error
     2628       :
     2629         assign
     2630           v-count-fld = v-count-fld + 1
     2631         .
     2632         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     2633         if v-ind = 1 then do:
     2634           assign
     2635             v-delim-key = chr(3)
     2636           .
     2637         end.
     2638       end.
     2639       delete object bh_tbl-name.
     2640     end.
     2641   end procedure.
     2642   procedure get-gate-file-name :
     2643   define input parameter p-gate-rec as character no-undo .
     2644   define output  parameter p-gate-file-name as character no-undo .
     2645   define buffer buf_clob-data for ub.clob-data.
     2646   define variable v-tbl-row as rowid no-undo .
     2647   define variable v-tbl-name as character no-undo .
     2648   run gen-row-keyr in this-procedure ( input p-gate-rec
     2649                                       ,input ?
     2650                                       ,input "ub"
     2651                                       ,input ?
     2652                                       ,input no-lock
     2653                                       ,output v-tbl-row
     2654                                       ,output v-tbl-name) no-error.
     2655   if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
     2656                                                           ,vss-include-info9
     2657                                                           ,p-gate-rec).
     2658   find first buf_clob-data no-lock where
     2659             rowid(buf_clob-data) = v-tbl-row no-error.
     2660   if not available buf_clob-data then do:
     2661     if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
     2662                                                             ,vss-include-info9
     2663                                                             ,p-gate-rec).
     2664   end.
     2665   p-gate-file-name = buf_clob-data.file-name.
     2666   end procedure.
     2667   procedure get-gate-rec :
     2668   define input  parameter p-gate-name as character no-undo .
     2669   define output parameter p-gate-rec as character no-undo .
     2670   define buffer buf_clob-bind for ub.clob-bind.
     2671   define buffer buf_clob-data for ub.clob-data.
     2672   main-block:
     2673   do
     2674   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info9, return-value, chr(10), error-status :get-message (1))
     2675   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info9 )
     2676   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info9 )
     2677   :
     2678       find first buf_clob-bind no-lock where
     2679                 buf_clob-bind.uniq-key-rec = p-gate-name
     2680             and buf_clob-bind.field-name = '':U
     2681             and buf_clob-bind.part-num = 1
     2682             and buf_clob-bind.resource-type = 'gate':U
     2683             no-error.
     2684       if not available buf_clob-bind then do:
     2685         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
     2686                                         , p-gate-name
     2687                                         ).
     2688       end.
     2689       find first buf_clob-data no-lock where
     2690                 buf_clob-data.db-num = buf_clob-bind.db-num
     2691             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
     2692       if not available buf_clob-data then do:
     2693         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     2694                                         , buf_clob-bind.db-num
     2695                                         , buf_clob-bind.int64-id
     2696                                         , p-gate-name
     2697                                         ).
     2698       end.
     2699       run gen-key-rec in this-procedure ( input 'clob-data':U
     2700                                 ,input buffer buf_clob-data:handle
     2701                                 ,output p-gate-rec).
     2702   end.
     2703   end procedure.
     2704   procedure get-gate-by-name :
     2705   define input  parameter p-gate-name as character no-undo .
     2706   define output parameter p-gate-rec as character no-undo .
     2707   define output parameter p-dsh as handle no-undo .
     2708   define input-output  parameter p-xmlh as handle no-undo .
     2709   define variable v-ii as integer   no-undo .
     2710   define variable glog as logical   no-undo .
     2711   define variable v-longchar as longchar no-undo .
     2712   define variable v-txmlh as handle no-undo .
     2713   define variable v-db-num as integer no-undo .
     2714   define variable v-int64-id as int64 no-undo .
     2715   define buffer buf_clob-bind for ub.clob-bind.
     2716   define buffer buf_clob-data for ub.clob-data.
     2717   main-block:
     2718   do
     2719   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info9, return-value, chr(10), error-status :get-message (1))
     2720   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info9 )
     2721   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info9 )
     2722   :
     2723       find first buf_clob-bind no-lock where
     2724                 buf_clob-bind.uniq-key-rec = p-gate-name
     2725             and buf_clob-bind.field-name = '':U
     2726             and buf_clob-bind.part-num = 1
     2727             and buf_clob-bind.resource-type = 'gate':U
     2728             no-error.
     2729       if not available buf_clob-bind then do:
     2730         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
     2731                                         , p-gate-name
     2732                                         ).
     2733       end.
     2734       find first buf_clob-data no-lock where
     2735                 buf_clob-data.db-num = buf_clob-bind.db-num
     2736             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
     2737       if not available buf_clob-data then do:
     2738         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     2739                                         , buf_clob-bind.db-num
     2740                                         , buf_clob-bind.int64-id
     2741                                         , p-gate-name
     2742                                         ).
     2743       end.
     2744       assign
     2745       v-longchar = buf_clob-data.cdata
     2746       .
     2747       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     2748       if error-status :error then do:
     2749         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     2750       end.
     2751       create dataset p-dsh .
     2752       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     2753                                     , v-longchar
     2754                                     , ?
     2755                                     , ?
     2756                                     , ?
     2757                                     ) no-error.
     2758       v-longchar = '':U.
     2759       if error-status :error
     2760       or not glog
     2761       then do:
     2762         undo, return error substitute("Не удалось прочитать XML-схему &1 из БД:&2&3", p-gate-name, chr(10), error-status:get-message(1) ).
     2763       end.
     2764       if not valid-handle(p-xmlh)
     2765       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     2766         create temp-table v-txmlh.
     2767         v-txmlh:create-like(buffer temp-xml-tables:handle).
     2768         v-txmlh:temp-table-prepare("temp-xml-tables").
     2769         p-xmlh = v-txmlh:default-buffer-handle.
     2770       end.
     2771       run gen-key-rec in this-procedure ( input 'clob-data':U
     2772                                 ,input buffer buf_clob-data:handle
     2773                                 ,output p-gate-rec).
     2774       do v-ii = 1 to p-dsh:num-buffers:
     2775         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     2776         if not p-xmlh:available then do:
     2777           p-xmlh:buffer-create().
     2778           assign
     2779           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     2780           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     2781           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     2782           p-xmlh::gate-handle_ = p-dsh
     2783           p-xmlh::uniq-gate-rec = p-gate-rec
     2784           p-xmlh::gate-name = p-dsh:name
     2785           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     2786           .
     2787           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     2788             assign
     2789             p-xmlh::order = -3.
     2790           end.
     2791         end.
     2792       end.
     2793   end.
     2794   end procedure.
     2795   procedure get-gate-by-rec :
     2796   define input  parameter p-gate-rec as character no-undo .
     2797   define output parameter p-dsh as handle no-undo .
     2798   define input-output  parameter p-xmlh as handle no-undo .
     2799   define input-output parameter p-longchar  as longchar no-undo .
     2800   define variable v-ii as integer   no-undo .
     2801   define variable glog as logical   no-undo .
     2802   define variable v-rowid as rowid no-undo .
     2803   define variable v-tbl-name as character no-undo .
     2804   define variable v-longchar as longchar no-undo .
     2805   define variable v-txmlh as handle no-undo .
     2806   define buffer buf_clob-data for ub.clob-data.
     2807   main-block:
     2808   do
     2809   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info9, return-value, chr(10), error-status :get-message (1))
     2810   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info9 )
     2811   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info9 )
     2812   :
     2813     run gen-row-keyr in this-procedure (
     2814                                           input  p-gate-rec
     2815                                           ,input  ?
     2816                                           ,input  "ub"
     2817                                           ,input  ?
     2818                                           ,input  NO-LOCK
     2819                                           ,output v-rowid
     2820                                           ,output v-tbl-name   ) no-error.
     2821       find first buf_clob-data no-lock where
     2822                 rowid(buf_clob-data) = v-rowid  no-error.
     2823       if not available buf_clob-data then do:
     2824         undo, return error substitute("Не найден CLOB  &1"
     2825                                         , p-gate-rec
     2826                                         ).
     2827       end.
     2828       assign
     2829       v-longchar = buf_clob-data.cdata
     2830       .
     2831       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     2832       if error-status :error then do:
     2833         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     2834       end.
     2835       create dataset p-dsh .
     2836       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     2837                                     , v-longchar
     2838                                     , ?
     2839                                     , ?
     2840                                     , ?
     2841                                     ) no-error.
     2842       define variable v-esm as character no-undo .
     2843       v-esm = error-status:get-message(1) .
     2844       if p-longchar <> ? then do:
     2845         p-longchar = v-longchar.
     2846       end.
     2847       v-longchar = '':U.
     2848       if error-status :error
     2849       or not glog
     2850       then do:
     2851         undo, return error substitute("Не удалось прочитать XML-схему &1 (&2) из БД&3&4"
     2852                                      , p-gate-rec
     2853                                      , p-gate-rec
     2854                                      , v-esm
     2855                                      ).
     2856       end.
     2857       p-dsh:private-data = buf_clob-data.file-name_ + chr(4) + p-gate-rec.
     2858       if not valid-handle(p-xmlh)
     2859       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     2860         create temp-table v-txmlh.
     2861         v-txmlh:create-like(buffer temp-xml-tables:handle).
     2862         v-txmlh:temp-table-prepare("temp-xml-tables").
     2863         p-xmlh = v-txmlh:default-buffer-handle.
     2864       end.
     2865       do v-ii = 1 to p-dsh:num-buffers:
     2866         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     2867         if not p-xmlh:available then do:
     2868           p-xmlh:buffer-create().
     2869           assign
     2870           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     2871           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     2872           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     2873           p-xmlh::gate-handle_ = p-dsh
     2874           p-xmlh::uniq-gate-rec = p-gate-rec
     2875           p-xmlh::gate-name = p-dsh:name
     2876           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     2877           .
     2878           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     2879             assign
     2880             p-xmlh::order = -3.
     2881           end.
     2882           p-xmlh:buffer-release().
     2883         end.
     2884       end.
     2885   end.
     2886   end procedure.
     2887   procedure get-gate-by-file :
     2888   define input  parameter p-schema-file-name as character no-undo .
     2889   define input  parameter p-gate-rec as character no-undo .
     2890   define output parameter p-dsh as handle no-undo .
     2891   define input-output  parameter p-xmlh as handle no-undo .
     2892   define variable v-ii as integer   no-undo .
     2893   define variable glog as logical   no-undo .
     2894   define variable v-rowid as rowid no-undo .
     2895   define variable v-tbl-name as character no-undo .
     2896   define variable v-longchar as longchar no-undo .
     2897   define variable v-txmlh as handle no-undo .
     2898   main-block:
     2899   do
     2900   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info9, return-value, chr(10), error-status :get-message (1))
     2901   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info9 )
     2902   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info9 )
     2903   :
     2904       COPY-LOB
     2905       FROM  FILE p-schema-file-name
     2906       TO  OBJECT v-longchar
     2907       no-convert
     2908       NO-ERROR .
     2909       if error-status :error then do:
     2910           undo, return error substitute("Не удалось считать файл схемы &1 в память&2&3"
     2911                                     , p-schema-file-name
     2912                                 , chr(10)
     2913                                 , error-status:get-message(1) ).
     2914       end.
     2915       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     2916       if error-status :error then do:
     2917         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, p-schema-file-name, chr(10), error-status:get-message(1) , return-value ).
     2918       end.
     2919       create dataset p-dsh .
     2920       glog = p-dsh:READ-XMLSCHEMA( "longchar"
     2921                                     , v-longchar
     2922                                     , ?
     2923                                     , ?
     2924                                     , ?
     2925                                     ) no-error.
     2926       v-longchar = ''.
     2927       if error-status :error
     2928       or not glog
     2929       then do:
     2930         undo, return error substitute("Не удалось прочитать XML-схему из файла &1&2&3"
     2931                                      , p-schema-file-name
     2932                                      ,chr(10)
     2933                                      , error-status:get-message(1)
     2934                                      ).
     2935       end.
     2936       if not valid-handle(p-xmlh)
     2937       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     2938         create temp-table v-txmlh.
     2939         v-txmlh:create-like(buffer temp-xml-tables:handle).
     2940         v-txmlh:temp-table-prepare("temp-xml-tables").
     2941         p-xmlh = v-txmlh:default-buffer-handle.
     2942       end.
     2943       do v-ii = 1 to p-dsh:num-buffers:
     2944         p-xmlh:find-first(substitute(' where tbl-name = "&1" and  uniq-gate-rec = "&2" '
     2945                                      ,p-dsh:get-buffer-handle(v-ii):name
     2946                                      ,p-gate-rec
     2947                                      )) no-error.
     2948         if not p-xmlh:available then do:
     2949           p-xmlh:buffer-create().
     2950           assign
     2951           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):table
     2952           p-xmlh::uniq-gate-rec = p-gate-rec
     2953           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     2954           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     2955           p-xmlh::gate-handle_ = p-dsh
     2956           p-xmlh::gate-name = p-dsh:name
     2957           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     2958           .
     2959           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     2960             assign
     2961             p-xmlh::order = -3.
     2962           end.
     2963           p-xmlh:buffer-release().
     2964         end.
     2965       end.
     2966   end.
     2967   end procedure.
     2968   procedure gate-clear :
     2969   define input  parameter p-dsh as handle no-undo .
     2970   define input  parameter p-xmlh as handle no-undo .
     2971   define variable v-dsh as handle no-undo .
     2972   define variable v-th as handle no-undo .
     2973     do
     2974     on error undo, return error return-value
     2975     :
     2976       if valid-handle(p-dsh) then do:
     2977         delete object p-dsh.
     2978         v-dsh = p-dsh.
     2979         p-dsh = ?.
     2980       end.
     2981       repeat while true:
     2982         p-xmlh:find-first( substitute( " where gate-handle_ = &1 ", v-dsh)
     2983                            , share-lock) no-error.
     2984         if p-xmlh:available then do:
     2985           assign
     2986           v-th = p-xmlh:buffer-field("table-handle_"):buffer-value.
     2987           if valid-handle(p-xmlh:buffer-field("table-handle_"))
     2988           and valid-handle(v-th)
     2989           and v-th:dynamic = yes
     2990           then do:
     2991             delete object p-xmlh:buffer-field("table-handle_"):buffer-value.
     2992             p-xmlh:buffer-field("table-handle_"):buffer-value = ?.
     2993           end.
     2994           p-xmlh:buffer-delete().
     2995         end.
     2996         else do:
     2997           leave.
     2998         end.
     2999       end.
     3000       if p-xmlh:dynamic = yes
     3001       and valid-handle(p-xmlh)
     3002       then do:
     3003         delete object p-xmlh:table-handle.
     3004         p-xmlh = ?.
     3005       end.
     3006       v-dsh = ?.
     3007     end.
     3008   end procedure.
     3009   procedure all-gates-clear :
     3010   define parameter buffer buf_temp-xml-tables for temp-xml-tables.
     3011   do
     3012   on error undo, return error
     3013   :
     3014     for each buf_temp-xml-tables
     3015     break
     3016     by buf_temp-xml-tables.uniq-gate-rec
     3017     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3018     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     3019     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     3020     :
     3021         if first-of(buf_temp-xml-tables.uniq-gate-rec) then do:
     3022           delete object buf_temp-xml-tables.gate-handle_.
     3023           buf_temp-xml-tables.gate-handle_ = ?.
     3024         end.
     3025         if valid-handle(buf_temp-xml-tables.table-handle_)
     3026         and buf_temp-xml-tables.table-handle_:dynamic = no
     3027         then do:
     3028           delete object buf_temp-xml-tables.table-handle_.
     3029           buf_temp-xml-tables.table-handle_ = ?.
     3030         end.
     3031         delete buf_temp-xml-tables.
     3032     end.
     3033   end.
     3034   end procedure.
     3035   procedure fix-schemalocation :
     3036   define input-output  parameter p-longchar as longchar no-undo .
     3037   DEFINE VARIABLE hdoc AS HANDLE.
     3038   DEFINE VARIABLE hroot AS HANDLE.
     3039   DEFINE VARIABLE hnode-child AS HANDLE.
     3040   DEFINE VARIABLE hnode-attr AS HANDLE.
     3041   define variable v-jj as integer   no-undo .
     3042   define variable ok as logical   no-undo .
     3043   define variable v-path1                    as character                no-undo .
     3044   DEFINE VARIABLE v-full-path1               as character                no-undo .
     3045   DEFINE VARIABLE v-file-name1               as character                no-undo .
     3046   DEFINE VARIABLE v-file-name-no-ext1        as character                no-undo .
     3047   DEFINE VARIABLE v-file-name-ext1           as character                no-undo .
     3048   define variable v-schema-location          as character                no-undo .
     3049   do
     3050   on error undo, return error return-value
     3051   :
     3052     CREATE X-DOCUMENT hdoc.
     3053     CREATE X-noderef hroot.
     3054     CREATE X-noderef hnode-child.
     3055     CREATE X-noderef hnode-attr.
     3056     hdoc:load("longchar", p-longchar, no) no-error.
     3057     iF ERROR-STATUS:GET-MESSAGE(1) <> '' THEN message ERROR-STATUS:GET-MESSAGE(1) view-as alert-box .
     3058     hdoc:get-document-element(hroot).
     3059     _repeat:
     3060     REPEAT v-jj = 1 TO hroot:NUM-CHILDREN:
     3061       ok = hroot:GET-CHILD(hNode-Child, v-jj).
     3062       if not ok then next.
     3063       if hNode-Child:local-name = "include"
     3064       then do:
     3065         ok = hNode-Child:GET-ATTRIBUTE-NODE( hnode-attr, "schemaLocation" ).
     3066           v-schema-location = hnode-attr:node-value.
     3067           run gbl/filename.p (
     3068                           input "exe/" + hnode-attr:node-value
     3069                         ,output v-full-path1
     3070                         ,output v-path1
     3071                         ,output v-file-name1
     3072                         ,output v-file-name-no-ext1
     3073                         ,output v-file-name-ext1
     3074                         ) no-error .
     3075           if error-status :error then do:
     3076             delete object hnode-attr.
     3077             delete object hnode-child.
     3078             delete object hroot.
     3079             delete object hdoc.
     3080             undo, return error substitute("Не удалось определить расположение схемы &1", v-schema-location).
     3081           end.
     3082         ok = hNode-Child:sET-ATTRIBUTE(  "schemaLocation", v-full-path1 ).
     3083         leave  _repeat.
     3084       end.
     3085     END.
     3086     hdoc:save("longchar", p-longchar).
     3087     delete object hnode-attr.
     3088     delete object hnode-child.
     3089     delete object hroot.
     3090     delete object hdoc.
     3091   end.
     3092   end procedure.
     3093   procedure gate-clb_fill-xml-tables :
     3094   define input parameter p-dsh as handle no-undo .
     3095   define input-output parameter p-xmlh as handle no-undo .
     3096   define variable v-ii as integer no-undo .
     3097     do
     3098     on error undo, return error
     3099     :
     3100       do v-ii = 1 to p-dsh:num-buffers:
     3101         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     3102         if not p-xmlh:available then do:
     3103           p-xmlh:buffer-create().
     3104           assign
     3105           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     3106           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     3107           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     3108           p-xmlh::gate-handle_ = p-dsh
     3109           p-xmlh::uniq-gate-rec = entry(2, p-dsh:private-data, chr(4))
     3110           p-xmlh::gate-name = p-dsh:name
     3111           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     3112           .
     3113           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     3114             assign
     3115             p-xmlh::order = -3.
     3116           end.
     3117           p-xmlh:buffer-release().
     3118         end.
     3119       end.
     3120     end.
     3121   end procedure.
     3122   procedure all-gates-empty :
     3123   define buffer buf_temp-xml-tables for temp-xml-tables.
     3124   do
     3125   on error undo, return error
     3126   :
     3127     for each buf_temp-xml-tables
     3128     break
     3129     by buf_temp-xml-tables.uniq-gate-rec
     3130     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3131     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     3132     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     3133     :
     3134       if valid-handle(buf_temp-xml-tables.tbl-handle_) then do:
     3135         buf_temp-xml-tables.tbl-handle_:empty-temp-table().
     3136       end.
     3137     end.
     3138   end.
     3139   end procedure.
     3140   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3141   define stream temp-stream.
     3142   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3143   procedure prnexldl_clear:
     3144   define input parameter p-txl-file-name as character no-undo .
     3145   define variable v-template-file-name as character no-undo .
     3146   define variable v-vb-file-name as character no-undo .
     3147   define variable v-data-header-filename as character no-undo .
     3148   define variable v-data-filename as character no-undo .
     3149   if search( p-txl-file-name ) <> ? then do:
     3150     input stream temp-stream from value( p-txl-file-name ).
     3151     repeat
     3152     :
     3153         import stream temp-stream v-template-file-name   .
     3154         import stream temp-stream v-vb-file-name         .
     3155         import stream temp-stream v-data-header-filename .
     3156         os-delete value(v-data-header-filename).
     3157         import stream temp-stream v-data-filename        .
     3158         os-delete value(v-data-filename).
     3159     end.
     3160     input stream temp-stream close.
     3161     os-delete value( p-txl-file-name ).
     3162   end.
     3163   end procedure .
     3164   define stream reprumpr_in.
     3165   procedure reprumpr_print-xlt :
     3166   define input parameter p-dir-name as character no-undo .
     3167   define input parameter p-subdir-name as character no-undo .
     3168   define input parameter p-custom-name as character no-undo .
     3169   define input parameter p-disable-option as integer no-undo .
     3170   define input parameter p-font-number as integer no-undo .
     3171   define buffer buf_temp-param for temp-param .
     3172   define variable v-report-num            as integer no-undo .
     3173   define variable v-filename              as character    no-undo .
     3174   define variable v-obj-dir               as character    no-undo .
     3175   define variable v-report-filename       as character    no-undo .
     3176   define variable v-home-dir-filename     as character    no-undo .
     3177   define variable v-error-num             as integer      no-undo .
     3178   define variable v-template-file-name    as character    no-undo .
     3179   define variable v-vb-file-name          as character    no-undo .
     3180   define variable v-data-header-filename  as character    no-undo .
     3181   define variable v-data-filename         as character    no-undo .
     3182   define variable v-excel-file-name       as character    no-undo .
     3183   define variable v-err-message           as character    no-undo .
     3184   define variable v-os-err-str            as character    no-undo .
     3185   define variable v-report-dir            as character    no-undo .
     3186   do for buf_temp-param
     3187   on error undo, return error return-value
     3188   :
     3189   assign
     3190     v-report-dir  = trim( replace( p-dir-name, '/' , '\' ) , '\' )
     3191   .
     3192     assign
     3193     v-report-num = g#report-num
     3194     v-obj-dir           = v-report-dir + chr(47) +
     3195                           (if p-subdir-name <> '' then (p-subdir-name + chr(47)) else '')
     3196     v-filename          = string( session:temp-directory ) + "rpt" + string( v-report-num )
     3197     v-excel-file-name   = string( session:temp-directory ) + "rpt" + string( v-report-num ) + ".xls"
     3198     v-home-dir-filename = v-obj-dir +  p-custom-name
     3199     .
     3200     os-delete value( v-filename + ".txl" )  .
     3201     os-rename
     3202       value( string( session:temp-directory ) + "$" + string( v-report-num ) + ".txl" )
     3203       value( v-filename + ".txl" )
     3204     .
     3205     assign
     3206       v-filename = search( v-filename + ".txl" )
     3207     .
     3208     if v-filename = "" or v-filename = ?
     3209     then do:
     3210       assign
     3211         v-err-message = v-err-message + substitute( "Не найден файл &1 для формирования Excel-файла по объекту p-custom-name"
     3212                                                   , string( session:temp-directory ) + "rpt" + string( v-report-num )
     3213                                                   )
     3214       .
     3215       return error v-err-message.
     3216     end.
     3217     input stream reprumpr_in from value( v-filename ).
     3218     import stream reprumpr_in v-template-file-name   no-error .
     3219     import stream reprumpr_in v-vb-file-name         no-error .
     3220     import stream reprumpr_in v-data-header-filename no-error .
     3221     import stream reprumpr_in v-data-filename        no-error .
     3222     input stream reprumpr_in close.
     3223     if search( v-template-file-name ) = ?
     3224     then do:
     3225       assign
     3226         v-err-message = v-err-message + substitute( "Не найден шаблон Excel для вывода данных.&2Указан файл шаблона:&1&2&2"
     3227                                                   , v-template-file-name
     3228                                                   , chr(10)
     3229                                                   )
     3230       .
     3231       return error v-err-message.
     3232     end.
     3233     if search( v-vb-file-name ) = ?
     3234     then do:
     3235       assign
     3236         v-err-message = v-err-message + substitute( "Не найден текст программы заполнения шаблона Excel.&3Файл шаблона:&1&3Указан файл программы:&2&3&3"
     3237                                                   , v-template-file-name
     3238                                                   , v-vb-file-name
     3239                                                   , chr(10)
     3240                                                   )
     3241       .
     3242       return error v-err-message.
     3243     end.
     3244     if v-data-header-filename <> "":U
     3245     and search( v-data-header-filename ) = ?
     3246     then do:
     3247       assign
     3248         v-err-message = v-err-message + substitute( "Не найден файл шапки.&3Файл шаблона:&1&3Указан файл шапки:&2&3&3"
     3249                                                   , v-template-file-name
     3250                                                   , v-data-header-filename
     3251                                                   , chr(10)
     3252                                                   )
     3253       .
     3254       return error v-err-message.
     3255     end.
     3256     if v-data-filename <> "":U
     3257     and search( v-data-filename )   = ?
     3258     then do:
     3259       assign
     3260         v-err-message = v-err-message + substitute( "Не найден файл строк данных.&3Файл шаблона:&1&3Указан файл строк данных:&2&3&3"
     3261                                                   , v-template-file-name
     3262                                                   , v-data-filename
     3263                                                   , chr(10)
     3264                                                   )
     3265       .
     3266       return error v-err-message.
     3267     end.
     3268     create buf_temp-param.
     3269     assign
     3270       v-template-file-name = search( v-template-file-name )
     3271       file-info :file-name = v-template-file-name
     3272       v-template-file-name = file-info :full-pathname
     3273       v-vb-file-name       = search( v-vb-file-name )
     3274       file-info :file-name = v-vb-file-name
     3275       v-vb-file-name       = file-info :full-pathname
     3276     .
     3277     if v-template-file-name = ? or v-template-file-name = "":U
     3278     then do:
     3279       RETURN error substitute("Не найден шаблон &1", v-template-file-name).
     3280     end.
     3281     run paramls-write in this-procedure ( input "template":U
     3282                                         , input "template-file-name":U
     3283                                         , input v-template-file-name
     3284                                         ).
     3285     run paramls-write in this-procedure ( input "template":U
     3286                                         , input "vb-file-name":U
     3287                                         , input v-vb-file-name
     3288                                         ).
     3289     run paramls-write in this-procedure ( input "data":U
     3290                                         , input "data-header-filename":U
     3291                                         , input v-data-header-filename
     3292                                         ).
     3293     run paramls-write in this-procedure ( input "data":U
     3294                                         , input "data-filename":U
     3295                                         , input v-data-filename
     3296                                         ).
     3297     run paramls-write in this-procedure ( input "saveas":U
     3298                                         , input "excel-file-name":U
     3299                                         , input v-excel-file-name
     3300                                         ).
     3301     run paramls-write in this-procedure ( input "file":U
     3302                                         , input "file-no-open":U
     3303                                         , input "yes":U
     3304                                         ).
     3305     run gbl/macroxlt.p ( input-output table buf_temp-param ) no-error.
     3306     if error-status :error
     3307     then do:
     3308       assign
     3309         v-err-message = v-err-message + substitute( "&1&2&3&4Ошибка создания файла Excel.&4&5&4&6&4&7&4&8&4&4"
     3310                                                   , vss-workfile
     3311                                                   , vss-revision
     3312                                                   , vss-description
     3313                                                   , chr(10)
     3314                                                   , return-value
     3315                                                   , trim(error-status :get-message(1))
     3316                                                   , trim(error-status :get-message(2))
     3317                                                   , trim(error-status :get-message(3))
     3318                                                   )
     3319       .
     3320       return error v-err-message.
     3321     end.
     3322     run prnexldl_clear in this-procedure ( input v-filename) no-error.
     3323     if error-status :error
     3324     then do:
     3325       assign
     3326         v-err-message = v-err-message + substitute( "Ошибка удаления файла &1: &2 &3&3"
     3327                                                   , v-filename
     3328                                                   , return-value
     3329                                                   , chr(10)
     3330                                                   )
     3331       .
     3332       return error v-err-message.
     3333     end.
     3334     run gbl/dir-cre.p ( input v-obj-dir ) no-error  .
     3335     if error-status :error
     3336     then do:
     3337       assign
     3338         v-err-message = v-err-message + substitute( "Ошибка создания директории &1: &2&4&3&4&4"
     3339                                                   , v-filename
     3340                                                   , return-value
     3341                                                   , trim(error-status :get-message(1))
     3342                                                   , chr(10)
     3343                                                   )
     3344       .
     3345     end.
     3346     run gbl/del-file.p ( input v-home-dir-filename ) no-error .
     3347     if error-status :error
     3348     then do:
     3349       assign
     3350         v-err-message = v-err-message + substitute( "Ошибка удаления файла &1: &2 &3&3"
     3351                                                   , v-home-dir-filename
     3352                                                   , return-value
     3353                                                   , chr(10)
     3354                                                   )
     3355       .
     3356       return error v-err-message.
     3357     end.
     3358     run gbl/ren-file.p ( input v-excel-file-name
     3359                     , input v-home-dir-filename
     3360                     ) no-error .
     3361     if error-status :error
     3362     then do:
     3363       assign
     3364         v-err-message = v-err-message + substitute( "Ошибка перемещения файла &1 -> &2: &3&4&4"
     3365                                                   , v-excel-file-name
     3366                                                   , v-home-dir-filename
     3367                                                   , return-value
     3368                                                   , chr(10)
     3369                                                   )
     3370       .
     3371       return error v-err-message.
     3372     end.
     3373     run cb_fill-report-destination in p-parent-handle (  input p-rdbh
     3374                                                   ,input p-report-id
     3375                                                   ,input 'excel':U
     3376                                                   ,input v-home-dir-filename
     3377                                                   ,input string(p-disable-option) + chr(4) + string(p-font-number)
     3378                                                   ).
     3379   end.
     3380   end procedure.
     3381   procedure placelib_write-attr:
     3382   define input  parameter p-code     like ub.place-attr.attr-code .
     3383   define input  parameter p-obj-code like ub.place-attr.obj-code .
     3384   define input  parameter p-obj-type like ub.place-attr.obj-type .
     3385   define input  parameter p-pl-code  like ub.place-attr.pl-code .
     3386   define input  parameter p-value    like ub.place-attr.attr-value .
     3387   define output parameter p-ok       as logical.
     3388   define buffer buf_place-attr for ub.place-attr .
     3389     do on error undo, return error return-value :
     3390        p-ok = false.
     3391        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
     3392                                                   and buf_place-attr.obj-code    = p-obj-code
     3393                                                   and buf_place-attr.obj-type    = p-obj-type
     3394                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
     3395        if not available buf_place-attr then do :
     3396           create buf_place-attr.
     3397           assign
     3398             buf_place-attr.attr-code   = p-code
     3399             buf_place-attr.attr-value  = p-value
     3400             buf_place-attr.obj-code    = p-obj-code
     3401             buf_place-attr.obj-type    = p-obj-type
     3402             buf_place-attr.pl-code     = p-pl-code
     3403           .
     3404           p-ok = true.
     3405        end.
     3406        else do:
     3407           buf_place-attr.attr-value  = p-value .
     3408           p-ok = true.
     3409        end.
     3410     end.
     3411   end.
     3412   procedure placelib_get-attr:
     3413   define input  parameter  p-code     like ub.place-attr.attr-code .
     3414   define input  parameter  p-obj-code like ub.place-attr.obj-code .
     3415   define input  parameter  p-obj-type like ub.place-attr.obj-type .
     3416   define input  parameter  p-pl-code  like ub.place-attr.pl-code .
     3417   define output parameter  p-value    like ub.place-attr.attr-value .
     3418   define output parameter  p-ok       as logical.
     3419   define buffer buf_place-attr for ub.place-attr .
     3420     do on error undo, return error return-value :
     3421        p-ok = false.
     3422        find first buf_place-attr no-lock where buf_place-attr.attr-code   = p-code
     3423                                                   and buf_place-attr.obj-code    = p-obj-code
     3424                                                   and buf_place-attr.obj-type    = p-obj-type
     3425                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
     3426        if available buf_place-attr then do :
     3427          p-value = buf_place-attr.attr-value.
     3428          p-ok = true.
     3429        end.
     3430        else do :
     3431          p-ok = false.
     3432        end.
     3433     end.
     3434   end.
     3435   procedure placelib_del-attr:
     3436   define input parameter  p-code     like ub.place-attr.attr-code .
     3437   define input parameter  p-obj-code like ub.place-attr.obj-code .
     3438   define input parameter  p-obj-type like ub.place-attr.obj-type .
     3439   define input parameter  p-pl-code  like ub.place-attr.pl-code .
     3440   define input parameter  p-value    like ub.place-attr.attr-value .
     3441   define output parameter p-ok       as logical.
     3442   define buffer buf_place-attr for ub.place-attr .
     3443     do on error undo, return error return-value :
     3444        p-ok = false.
     3445        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
     3446                                                   and buf_place-attr.obj-code    = p-obj-code
     3447                                                   and buf_place-attr.obj-type    = p-obj-type
     3448                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
     3449        if available buf_place-attr then do :
     3450           delete buf_place-attr.
     3451           p-ok = true.
     3452        end.
     3453     end.
     3454   end.
     3455   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3456   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3457   define  temp-table report-headert no-undo
