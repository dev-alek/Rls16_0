        1   block-level on error undo, throw.
        2   define input parameter parParentProc   as handle    no-undo .
        3   define input parameter p-parent-handle as handle no-undo .
        4   define input parameter p-log-handle  as handle no-undo .
        5   define input parameter p-cont-handle  as handle no-undo .
        6   define input parameter p-call-handle as handle no-undo .
        7   define input parameter p-rebh as handle no-undo .
        8   define input parameter p-rdbh                   as handle                  no-undo .
        9   define input parameter p-report-id as character no-undo .
       10   define input parameter p-xsd-file as character no-undo .
       11   define input parameter p-log-file-name as character no-undo .
       12   define input parameter p-batch        as integer  no-undo .
       13   define input parameter p-codex-id               as integer no-undo .
       14   define input parameter p-ruleset-id             as integer no-undo .
       15   define input parameter p-time as integer          no-undo.
       16   define input parameter p-date         as date   no-undo .
       17   define input parameter p-cli-list     as character        no-undo.
       18   define input parameter p-excel         as logical          no-undo .
       19   define input parameter p-xml           as logical          no-undo .
       20   define input parameter p-dir-excel          as character no-undo .
       21   define input parameter p-dir-xml          as character no-undo .
       22   define output parameter p-dataseth as handle no-undo .
       23   define output parameter p-xmlh as handle no-undo.
       24   define variable vss-revision    as character no-undo init "$Revision: 63c9a434965b, 3578, rls $":U .
       25   define variable vss-author      as character no-undo init "$Author: VSpiridonov $":U .
       26   define variable vss-date        as character no-undo init "$Date: 2023/12/14 13:36:13 $":U .
       27   define variable vss-workfile    as character no-undo init "$Workfile: r-dispet.p $":U .
       28   define variable vss-archive     as character no-undo init "$Archive: rep/r-dispet.p $":U .
       29   define variable vss-description as character no-undo init "Отчет диспетчера".
       30   define variable g#report-num  as integer      no-undo .
       31   define variable v-sort-list    as character    no-undo.
       32   define variable v-sort-type    as character    no-undo.
       33   define variable v-sort         as logical      no-undo.
       34   define variable v-sort-MAX     as integer      no-undo.
       35   define variable v-sort-code    as integer      no-undo.
       36   define variable v-message    as character    no-undo.
       37   define variable v-err-mess as character no-undo .
       38   define variable v-start-datetime as datetime no-undo .
       39   define buffer buf_rvs-line-attr for ub.rvs-line-attr .
       40   procedure vss-get-info :
       41     define output parameter p-vss-revision    like vss-revision    no-undo .
       42     define output parameter p-vss-author      like vss-author      no-undo .
       43     define output parameter p-vss-date        like vss-date        no-undo .
       44     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       45     define output parameter p-vss-archive     like vss-archive     no-undo .
       46     define output parameter p-vss-description like vss-description no-undo .
       47     assign
       48       p-vss-revision    = vss-revision
       49       p-vss-author      = vss-author
       50       p-vss-date        = vss-date
       51       p-vss-workfile    = vss-workfile
       52       p-vss-archive     = vss-archive
       53       p-vss-description = vss-description
       54     .
       55   end procedure.
       56   procedure vss-get-parameters :
       57     define output parameter p-vss-parameters as character no-undo .
       58   end procedure.
       59   define new global shared variable g#vssrevis-logger as handle    no-undo .
       60   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       61   define variable v-vssrevis-logger                   as handle    no-undo .
       62   procedure vss-logevent :
       63     define input  parameter p-extra-paramters as character no-undo .
       64     define variable v-vssrevis-parameters as character no-undo .
       65     do
       66     on error undo, return error return-value
       67     :
       68       if  valid-handle(v-vssrevis-logger)
       69       and v-vssrevis-logger :get-signature("logevent") <> ""
       70       then do:
       71         run vss-get-parameters in this-procedure
       72           (output v-vssrevis-parameters
       73           ).
       74         run logevent in v-vssrevis-logger
       75           (input vss-workfile
       76           ,input vss-revision
       77           ,input v-vssrevis-parameters
       78           ,input p-extra-paramters
       79           ).
       80       end.
       81     end.
       82   end procedure.
       83   assign
       84     v-vssrevis-logger = g#vssrevis-logger
       85   .
       86   if  valid-handle(v-vssrevis-logger)
       87   and v-vssrevis-logger :get-signature("logevent") <> ""
       88   then do:
       89     assign
       90       v-vssrevis-logevent = true
       91     .
       92     run vss-logevent in this-procedure (input vss-description) .
       93   end.
       94   define new global shared variable g#language as character no-undo .
       95   if g#language <> '' and g#language <> 'rus':U then do:
       96     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       97   end.
       98   define new global shared variable g#library  as handle no-undo .
       99   define new global shared variable g#library2 as handle no-undo .
      100   procedure proc-alt-shift-f2:
      101     if not ibs.th.gbl.gbl-var:rcode
      102   then
      103     run gbl\inidebug.p .
      104   end.
      105   procedure proc-alt-shift-f3:
      106     run gbl/prvssinf.p
      107       ( input this-procedure
      108       ) .
      109   end.
      110   define variable v-inform-launched as logical no-undo initial false .
      111   procedure proc-alt-shift-f4:
      112     define variable v-action as character no-undo .
      113     if v-inform-launched = false then do:
      114       assign
      115         v-inform-launched = true
      116       .
      117       run gbl/d-inform.w
      118         (  input self
      119         ,  input this-procedure
      120         , output v-action
      121         ) no-error .
      122       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      123       assign
      124         v-inform-launched = false
      125       .
      126     end.
      127   end.
      128   procedure proc-alt-f1:
      129     run gbl/corrhelp.p
      130       (input this-procedure
      131       ) .
      132   end .
      133   on alt-shift-f2 anywhere do:
      134     run proc-alt-shift-f2.
      135   end.
      136   on alt-shift-f3 anywhere do:
      137     run proc-alt-shift-f3 in this-procedure .
      138   end.
      139   on alt-shift-f4 anywhere do:
      140     run proc-alt-shift-f4 in this-procedure.
      141   end.
      142   on alt-f1 anywhere do:
      143     run proc-alt-f1 in this-procedure .
      144   end.
      145   define variable vss-include-info0 as character format "X(65)" no-undo
      146   initial "@(#)$Workfile$ $Revision$".
      147   define variable v-fmtcli-name          as character    no-undo.
      148   define variable v-fmtcli-engl-name     as character    no-undo.
      149   define variable v-fmtcli-addres        as character    no-undo.
      150   define variable v-fmtcli-post-addres   as character    no-undo.
      151   define variable v-fmtcli-full-addres   as character    no-undo.
      152   define variable v-fmtcli-phone         as character    no-undo.
      153   define variable v-fmtcli-inn           as character    no-undo.
      154   define variable v-fmtcli-kpp           as character    no-undo.
      155   define variable v-fmtcli-okpo          as character    no-undo.
      156   define variable v-fmtcli-country       as character    no-undo.
      157   define variable v-fmtcli-city          as character    no-undo.
      158   define variable v-fmtcli-index         as character    no-undo.
      159   define variable v-fmtcli-schet-exists  as logical      no-undo.
      160   define variable v-fmtcli-bank-exists   as logical      no-undo.
      161   define variable v-fmtcli-bank-r-schet  as character    no-undo.
      162   define variable v-fmtcli-bank-c-schet  as character    no-undo.
      163   define variable v-fmtcli-bank-bik      as character    no-undo.
      164   define variable v-fmtcli-bank-name     as character    no-undo.
      165   define variable v-fmtcli-bank-addres   as character    no-undo.
      166   define variable v-fmtcli-bank-city     as character    no-undo.
      167   procedure fmtcli-get-bank :
      168   define input parameter p-host-code      as integer          no-undo.
      169   define input parameter p-obj-type       as character        no-undo.
      170   define input parameter p-obj-code       as integer          no-undo.
      171   define input parameter p-curr-code      as integer          no-undo.
      172       define buffer buf_fin-schet     for ub.fin-schet.
      173       define buffer buf_fin-bank      for ub.fin-bank.
      174   do
      175   for buf_fin-schet
      176     , buf_fin-bank
      177   on error undo, return error
      178   :
      179       assign
      180           v-fmtcli-schet-exists       = no
      181           v-fmtcli-bank-exists        = no
      182           v-fmtcli-bank-r-schet       = "":U
      183           v-fmtcli-bank-c-schet       = "":U
      184           v-fmtcli-bank-bik           = "":U
      185           v-fmtcli-bank-name          = "":U
      186           v-fmtcli-bank-addres        = "":U
      187           v-fmtcli-bank-city          = "":U
      188       .
      189       search-for-schet:
      190       for each buf_fin-schet no-lock
      191          where buf_fin-schet.host-code = p-host-code
      192            and buf_fin-schet.cli-type  = p-obj-type
      193            and buf_fin-schet.cli-code  = p-obj-code
      194            and buf_fin-schet.curr-code = p-curr-code
      195       on error undo, return error
      196       :
      197           if buf_fin-schet.status_   = 'удал':U
      198           then do:
      199           end.
      200           else do:
      201               assign
      202                   v-fmtcli-schet-exists   = yes
      203                   v-fmtcli-bank-r-schet   = trim( buf_fin-schet.r-schet )
      204                   v-fmtcli-bank-c-schet   = trim( buf_fin-schet.c-schet )
      205               .
      206               find first buf_fin-bank no-lock
      207                    where buf_fin-bank.host-code = p-host-code
      208                      and buf_fin-bank.code-bank = buf_fin-schet.code-bank
      209               no-error.
      210               if available buf_fin-bank
      211               then do:
      212                   assign
      213                       v-fmtcli-bank-exists      = yes
      214                       v-fmtcli-bank-bik         = trim( buf_fin-bank.bik )
      215                       v-fmtcli-bank-name        = trim( buf_fin-bank.bank-name )
      216                       v-fmtcli-bank-addres      = trim(buf_fin-bank.addres)
      217                       v-fmtcli-bank-city      = trim(buf_fin-bank.bank-city)
      218                   .
      219               end.
      220               else do:
      221                   assign
      222                       v-fmtcli-bank-exists    = no
      223                       v-fmtcli-bank-bik       = "":U
      224                       v-fmtcli-bank-name      = "":U
      225                       v-fmtcli-bank-addres    = "":U
      226                       v-fmtcli-bank-city      = "":U
      227                   .
      228               end.
      229               leave search-for-schet.
      230           end.
      231       end.
      232   end.
      233   end procedure.
      234   procedure fmtcli-get-client :
      235   define input parameter p-obj-type       as character    no-undo.
      236   define input parameter p-obj-code       as integer      no-undo.
      237       define variable v-temp-fmtcli-address      as character     no-undo.
      238       define variable v-num-country-city    as integer      no-undo.
      239       define buffer buf_clients   for ub.clients.
      240       define buffer buf_firm      for ub.firm.
      241       define buffer buf_store     for ub.store.
      242       define buffer buf_shop      for ub.shop.
      243       define buffer buf_person    for ub.person.
      244   do
      245   for buf_clients
      246     , buf_firm
      247     , buf_store
      248     , buf_shop
      249     , buf_person
      250   on error undo, return error
      251   :
      252       assign
      253           v-fmtcli-name           = "":U
      254           v-fmtcli-addres         = "":U
      255           v-fmtcli-post-addres    = "":U
      256           v-fmtcli-full-addres    = "":U
      257           v-fmtcli-phone          = "":U
      258           v-fmtcli-inn            = "":U
      259           v-fmtcli-kpp            = "":U
      260           v-fmtcli-okpo           = "":U
      261           v-fmtcli-city           = "":U
      262           v-fmtcli-index          = "":U
      263           v-fmtcli-country        = "":U
      264       .
      265       find first buf_clients no-lock
      266            where buf_clients.obj-type = p-obj-type
      267              and buf_clients.obj-code = p-obj-code
      268       .
      269       assign
      270           v-fmtcli-name = buf_clients.obj-name
      271       .
      272       case buf_clients.obj-type:
      273          when 'орг':U
      274          then do:
      275               find first buf_firm no-lock
      276                    where buf_firm.firm-code = buf_clients.obj-code
      277                    no-error
      278               .
      279               if available buf_firm
      280               then do:
      281                   assign
      282                       v-num-country-city = num-entries( buf_firm.city )
      283                       v-fmtcli-engl-name = buf_firm.engl-name
      284                   .
      285                   if v-num-country-city > 0
      286                   then do:
      287                       assign
      288                           v-fmtcli-country    = trim( entry( 1, buf_firm.city ) )
      289                       .
      290                   end.
      291                   if v-num-country-city > 1
      292                   then do:
      293                       assign
      294                           v-fmtcli-city       = trim( entry( 2, buf_firm.city ) )
      295                       .
      296                   end.
      297                   run fmtcli-concatenate-strings in this-procedure (
      298                         input v-fmtcli-full-addres
      299                       , input v-fmtcli-country
      300                       , input ", ":U
      301                       , input 50
      302                       , output v-fmtcli-full-addres
      303                   ).
      304                   run fmtcli-concatenate-strings in this-procedure (
      305                         input v-fmtcli-full-addres
      306                       , input v-fmtcli-city
      307                       , input ", ":U
      308                       , input 50
      309                       , output v-fmtcli-full-addres
      310                   ).
      311                   run fmtcli-concatenate-strings in this-procedure (
      312                         input v-fmtcli-full-addres
      313                       , input IF buf_firm.ind = 0 THEN "" ELSE string( buf_firm.ind )
      314                       , input ", ":U
      315                       , input 50
      316                       , output v-fmtcli-full-addres
      317                   ).
      318                   run fmtcli-concatenate-strings in this-procedure (
      319                         input v-fmtcli-post-addres
      320                       , input v-fmtcli-country
      321                       , input ", ":U
      322                       , input 50
      323                       , output v-fmtcli-post-addres
      324                   ).
      325                   run fmtcli-concatenate-strings in this-procedure (
      326                         input v-fmtcli-post-addres
      327                       , input v-fmtcli-city
      328                       , input ", ":U
      329                       , input 50
      330                       , output v-fmtcli-post-addres
      331                   ).
      332                   run fmtcli-concatenate-strings in this-procedure (
      333                         input v-fmtcli-post-addres
      334                       , input string( buf_firm.ind )
      335                       , input ", ":U
      336                       , input 50
      337                       , output v-fmtcli-post-addres
      338                   ).
      339                   run fmtcli-concatenate-strings in this-procedure (
      340                         input substring( buf_firm.addres1, 1, 50 )
      341                       , input buf_firm.addres2
      342                       , input " ":U
      343                       , input 50
      344                       , output v-temp-fmtcli-address
      345                   ).
      346                   run fmtcli-concatenate-strings in this-procedure (
      347                         input v-temp-fmtcli-address
      348                       , input substring( buf_firm.addres1, 51, 50 )
      349                       , input " ":U
      350                       , input 50
      351                       , output v-temp-fmtcli-address
      352                   ).
      353                   run fmtcli-concatenate-strings in this-procedure (
      354                         input v-temp-fmtcli-address
      355                       , input substring( buf_firm.addres1, 101, 50 )
      356                       , input " ":U
      357                       , input 50
      358                       , output v-temp-fmtcli-address
      359                   ).
      360                   assign
      361                       v-fmtcli-addres = v-temp-fmtcli-address
      362                   .
      363                   if buf_firm.addres1 <> ?
      364                   then do:
      365                       run fmtcli-concatenate-strings in this-procedure (
      366                             input v-fmtcli-full-addres
      367                           , input v-fmtcli-addres
      368                           , input ", ":U
      369                           , input 0
      370                           , output v-fmtcli-full-addres
      371                       ).
      372                   end.
      373                   run fmtcli-concatenate-strings in this-procedure (
      374                         input substring( buf_firm.post-addr1, 1, 50 )
      375                       , input buf_firm.post-addr2
      376                       , input " ":U
      377                       , input 50
      378                       , output v-fmtcli-post-addres
      379                   ).
      380                   run fmtcli-concatenate-strings in this-procedure (
      381                         input v-fmtcli-post-addres
      382                       , input substring( buf_firm.post-addr1, 51, 50 )
      383                       , input " ":U
      384                       , input 50
      385                       , output v-fmtcli-post-addres
      386                   ).
      387                   run fmtcli-concatenate-strings in this-procedure (
      388                         input v-fmtcli-post-addres
      389                       , input substring( buf_firm.post-addr1, 101, 50 )
      390                       , input " ":U
      391                       , input 50
      392                       , output v-fmtcli-post-addres
      393                   ).
      394                   assign
      395                       v-fmtcli-phone         = buf_firm.phone
      396                       v-fmtcli-inn           = buf_firm.inn
      397                       v-fmtcli-kpp           = buf_firm.kpp
      398                       v-fmtcli-okpo          = buf_firm.okpo
      399                       v-fmtcli-index         = string( buf_firm.ind )
      400                   .
      401               end.
      402          end.
      403          when 'маг':U
      404          then do:
      405               find first buf_shop no-lock
      406                    where buf_shop.obj-code = buf_clients.obj-code
      407               .
      408               if available buf_shop
      409               then do:
      410                   run fmtcli-concatenate-strings in this-procedure (
      411                         input buf_shop.addres1
      412                       , input buf_shop.addres2
      413                       , input " ":U
      414                       , input 50
      415                       , output v-fmtcli-addres
      416                   ).
      417                   assign
      418                       v-fmtcli-full-addres = v-fmtcli-addres
      419                       v-fmtcli-post-addres = v-fmtcli-addres
      420                       v-fmtcli-phone       = buf_shop.phone
      421                       v-fmtcli-inn         = "":U
      422                       v-fmtcli-kpp         = "":U
      423                       v-fmtcli-okpo        = "":U
      424                       v-fmtcli-city        = "":U
      425                       v-fmtcli-index       = "":U
      426                   .
      427               end.
      428          end.
      429          when 'скл':U
      430          then do:
      431               find first buf_store no-lock
      432                    where buf_store.obj-code = buf_clients.obj-code
      433               .
      434               if available buf_store
      435               then do:
      436                   run fmtcli-concatenate-strings in this-procedure (
      437                         input buf_store.addres1
      438                       , input buf_store.addres2
      439                       , input " ":U
      440                       , input 50
      441                       , output v-fmtcli-addres
      442                   ).
      443                   assign
      444                       v-fmtcli-full-addres = v-fmtcli-addres
      445                       v-fmtcli-phone       = buf_store.phone
      446                       v-fmtcli-inn         = "":U
      447                       v-fmtcli-kpp         = "":U
      448                       v-fmtcli-okpo        = "":U
      449                       v-fmtcli-city        = "":U
      450                       v-fmtcli-index       = "":U
      451                   .
      452               end.
      453          end.
      454          when 'чел':U
      455          then do:
      456               find first buf_person no-lock
      457                    where buf_person.psn-code = buf_clients.obj-code
      458               .
      459               if available buf_person
      460               then do:
      461                   run fmtcli-concatenate-strings in this-procedure (
      462                         input ( if buf_person.ind = 0 or buf_person.ind = ?
      463                                 then "":U
      464                                 else string( buf_person.ind, "999999")
      465                                 )
      466                       , input buf_person.city
      467                       , input ", ":U
      468                       , input 0
      469                       , output v-fmtcli-full-addres
      470                   ).
      471                   assign
      472                       v-fmtcli-addres = buf_person.address
      473                   .
      474                   run fmtcli-concatenate-strings in this-procedure (
      475                         input v-fmtcli-full-addres
      476                       , input v-fmtcli-addres
      477                       , input ", ":U
      478                       , input 0
      479                       , output v-fmtcli-full-addres
      480                   ).
      481                   assign
      482                       v-fmtcli-phone     = buf_person.phone1
      483                       v-fmtcli-inn       = buf_person.inn
      484                       v-fmtcli-kpp       = buf_person.kpp
      485                       v-fmtcli-okpo      = buf_person.okpo
      486                       v-fmtcli-city      = buf_person.city
      487                       v-fmtcli-index     = string( buf_person.ind )
      488                   .
      489               end.
      490          end.
      491       end case.
      492   end.
      493   end procedure.
      494   procedure fmtcli-concatenate-strings :
      495   define input parameter p-string-1       as character        no-undo.
      496   define input parameter p-string-2       as character        no-undo.
      497   define input parameter p-delimiter      as character        no-undo.
      498   define input parameter p-length         as integer          no-undo.
      499   define output parameter p-out-string    as character        no-undo.
      500   do
      501   on error undo, return error
      502   :
      503       assign
      504           p-out-string = ( if p-string-1 = ?
      505                            then "":U
      506                            else trim( p-string-1 ) )
      507       .
      508       assign
      509           p-out-string = p-out-string
      510                        + ( if p-out-string = "":U
      511                            or length( p-out-string ) = p-length
      512                            or p-string-2 = ?
      513                            or trim( p-string-2 ) = "":U
      514                            then "":U
      515                            else p-delimiter )
      516                        + ( if p-string-2 = ?
      517                            or trim( p-string-2 ) = "":U
      518                            then "":U
      519                            else trim( p-string-2 ) )
      520       .
      521   end.
      522   end procedure.
      523   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      524   define variable v-waitfram-action01         as character   no-undo .
      525   define variable v-waitfram-action02         as character   no-undo .
      526   define variable v-waitfram-action03         as character   no-undo .
      527   define variable mWaitFramTextBeg            as character   no-undo.
      528   define variable mWaitFramTextEnd            as character   no-undo.
      529   define variable mWaitFramView               as logical     no-undo.
      530   define variable mWaitProcEvent              as logical     no-undo init yes.
      531   define variable mWaitFramInterval           as integer     no-undo init 1 .
      532   define variable mWaitFramStop               as logical     no-undo.
      533   define variable mWaitFramStopUser           as logical     no-undo.
      534   define variable mWaitFramStopTimeOut        as logical     no-undo.
      535   define variable mWaitFramStartProc          as datetime-tz no-undo.
      536   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      537   define button B-WaitFramStop auto-end-key
      538        label "Стоп"
      539        size 10 by 1 tooltip "Остоновить процесс".
      540   define button B-viewProcInfo
      541        label "Информация"
      542        size 15 by 1 tooltip "Информация о процесс".
      543   define frame waitfram
      544     v-waitfram-action01 format "x(72)" no-label skip
      545     v-waitfram-action02 format "x(72)" no-label skip
      546     v-waitfram-action03 format "x(72)" no-label skip
      547     B-viewProcInfo
      548     B-WaitFramStop at row 4 col 30
      549     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      550     .
      551   define new global shared variable mBatchMode as logical no-undo init ?.
      552   define variable mFramBachModHandle as handle no-undo.
      553   mFramBachModHandle = frame waitfram:handle.
      554   define variable mFameOldVis as logical no-undo.
      555   define variable mVisCUrentVin as logical no-undo.
      556   if session:batch-mode
      557   then
      558      mBatchMode = yes.
      559   if mBatchMode = ? then do:
      560     mVisCUrentVin = current-window:visible.
      561     mFameOldVis = mFramBachModHandle:visible.
      562     mFramBachModHandle:visible  = yes.
      563     mBatchMode = mFramBachModHandle:visible ne yes.
      564     mFramBachModHandle:visible = mFameOldVis.
      565     current-window:visible = mVisCUrentVin.
      566   end.
      567    if  log-manager:logfile-name ne ?
      568     then DO:
      569         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      570         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      571         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      572     end.
      573   on choose of B-WaitFramStop in frame waitfram
      574   do:
      575     mWaitFramStop = yes.
      576     mWaitFramStopUser = yes.
      577   end.
      578   function waitfram-check-timeout returns logical():
      579      define variable vtime as int64 no-undo.
      580      if mWaitFramStopTimeOut
      581      then
      582         return yes.
      583      vtime = ( now - mWaitFramStartProc ) / 1000 .
      584      if     mWaitFramTimeOut ne ?
      585         and mWaitFramTimeOut ne 0
      586         and mWaitFramTimeOut lt vtime
      587      then do:
      588         mWaitFramStopTimeOut = yes.
      589      end.
      590      return mWaitFramStopTimeOut.
      591   end.
      592   procedure waitfram-hide :
      593     if not session:batch-mode
      594     then do
      595     on error undo, return error return-value
      596     :
      597       pause 0 before-hide .
      598       if not mBatchMode then
      599         hide frame waitfram .
      600     if     not mWaitFramView
      601        and mWaitProcEvent
      602     then
      603       process events .
      604     end.
      605   end procedure.
      606   procedure waitfram-show :
      607     define input  parameter p-message as character no-undo .
      608     define variable v-left-margin as integer   no-undo .
      609     if not session:batch-mode
      610     then do
      611     on error undo, return error return-value
      612     :
      613       if length(p-message) <= 70 then do:
      614         assign
      615           v-left-margin = integer((70 - length(p-message)) / 2)
      616         .
      617         assign
      618           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      619         .
      620         assign
      621           v-waitfram-action01 = " "
      622           v-waitfram-action02 = " "
      623                                    + fill(" ", v-left-margin)
      624                                    + p-message
      625           v-waitfram-action03 = " "
      626         .
      627       end.
      628       else do:
      629         define variable vRindex1 as integer no-undo.
      630         define variable vRindex2 as integer no-undo.
      631         vRindex1 = r-index(p-message," ",70).
      632         if vRindex1 = 0
      633         then
      634            vRindex1 = 70.
      635         if length(p-message)  <= vRindex1 + 70 then do:
      636           assign
      637             v-waitfram-action01 = " "
      638             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      639             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      640           .
      641         end.
      642         else do:
      643           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      644           if vRindex2 <= vRindex1
      645           then
      646              vRindex2 = vRindex1 + 70.
      647           assign
      648             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      649             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      650             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      651           .
      652         end.
      653       end.
      654       B-viewProcInfo:visible   in frame waitfram = no.
      655       B-viewProcInfo:sensitive in frame waitfram = no.
      656       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      657       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      658       if  (   mWaitFramView
      659          or  mWaitProcEvent)
      660          and not mBatchMode
      661       then
      662          display
      663             v-waitfram-action01 skip
      664             v-waitfram-action02 skip
      665             v-waitfram-action03 skip
      666          with frame waitfram .
      667       if     mWaitFramView
      668          then do:
      669             if     mWaitFramInterval ne ?
      670                and not mBatchMode
      671             then
      672                wait-for go of frame waitfram pause mWaitFramInterval.
      673          end.
      674          else
      675             if     mWaitProcEvent
      676                and not mBatchMode
      677             then
      678                process events .
      679     end.
      680   end procedure.
      681      procedure waitfram-show-this:
      682         define input  parameter iInterval as int64 no-undo.
      683         define variable vtime as int64 no-undo.
      684         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      685         mWaitFramInterval = iInterval.
      686         run waitfram-show (substitute("&1&2 &3&4" ,
      687                                       mWaitFramTextBeg ,
      688                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      689                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      690                                       mWaitFramTextEnd
      691                                      )
      692                           ).
      693      end.
      694      procedure WaitFramRunPause:
      695         define input  parameter iInterval as dec no-undo.
      696         define variable vStart  as datetime-tz no-undo.
      697         define variable vend    as datetime-tz no-undo.
      698         define variable vint as int64 no-undo.
      699         define variable vOk as logical no-undo.
      700         vStart = now.
      701         vend   = vStart.
      702         publish "WaitFramPause" (iInterval,output vOk).
      703         vend   =  now.
      704         vint = vend - vStart.
      705         vint = iInterval - vint / 1000.
      706         if     not mWaitFramStop
      707            and (   vint > 0
      708                 or (    not vOk
      709                     and iInterval eq ?
      710                     )
      711                 )
      712         then
      713            run waitfram-show-this (iInterval).
      714         vend   =  now.
      715         vint = vend - vStart.
      716         vint = iInterval - vint / 1000.
      717         if     not mWaitFramStop
      718            and vint > 0
      719         then do:
      720            run gbl/pause.p (vint * 1000).
      721         end.
      722         if iInterval ne ?
      723         then
      724            publish "WaitFramStop".
      725         waitfram-check-timeout().
      726      end.
      727      procedure WaitFramWaitFor:
      728         define input  parameter iInterval as dec no-undo.
      729         assign
      730            mWaitFramStartProc   = now
      731            mWaitFramStopUser    = no
      732            mWaitFramStopTimeOut = no
      733         .
      734         block-wait:
      735         do while not mWaitFramStop:
      736            run WaitFramRunPause (iInterval).
      737            if  waitfram-check-timeout()
      738            then do:
      739               leave block-wait.
      740            end.
      741         end.
      742         run waitfram-hide.
      743      end.
      744   procedure waitfram-join :
      745     define input  parameter p-line-1  as character no-undo .
      746     define input  parameter p-line-2  as character no-undo .
      747     define input  parameter p-line-3  as character no-undo .
      748     define output parameter p-message as character no-undo .
      749     do
      750     on error undo, return error return-value
      751     :
      752       assign
      753         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      754                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      755                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      756       .
      757     end.
      758   end procedure.
      759   function waitfram-join-function returns character
      760     (input p-line-1 as character
      761     ,input p-line-2 as character
      762     ,input p-line-3 as character
      763     ).
      764     define variable v-message as character no-undo .
      765     run waitfram-join in this-procedure
      766       (input  p-line-1
      767       ,input  p-line-2
      768       ,input  p-line-3
      769       ,output v-message
      770       ) .
      771     return v-message .
      772   end function .
      773   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      774   define  stream PrnLibStream.
      775   procedure prn-lib-prn-file :
      776     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      777     define input parameter p-DIsabledoptions as integer no-undo .
      778     define variable v-report-name as character no-undo .
      779     define variable v-user-action as character no-undo .
      780     define variable v-printed     as logical   no-undo .
      781     define variable v-exist       as logical   no-undo .
      782     do
      783       on error undo, return error
      784       :
      785       run prn-lib-get-report-name  in this-procedure (
      786         input parParentProc
      787         ,output v-report-name
      788         ).
      789   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      790   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      791     (input  v-report-name
      792     ,input  2
      793     ,output v-exist
      794     )  .
      795       if NOT v-exist then
      796       DO:
      797         Message
      798           "Нет заданий на печать ! "
      799           view-as alert-box .
      800         Return  .
      801       End.
      802       run gbl/prnfilen.w
      803         (input  ""
      804         ,input  p-DisabledOptions
      805         ,input  string(v-report-name )
      806         ,input  7
      807         ,output v-user-action
      808         ,output v-printed
      809         ) .
      810       if v-printed then
      811       do:
      812         return "YES" .
      813       end.
      814       else
      815       do:
      816         return "NO" .
      817       end.
      818     end.
      819   end procedure.
      820   procedure prn-lib-open-stream :
      821     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      822     define input parameter p-page-size    as integer no-undo .
      823     define input parameter p-is-stream    as logical no-undo .
      824     define input parameter p-append       as logical no-undo .
      825     define variable v-report-name as character no-undo .
      826     do
      827       on error undo, return error
      828       :
      829       run prn-lib-get-report-name  in this-procedure (
      830         input parParentProc
      831         ,output v-report-name
      832         ).
      833       if p-is-stream then
      834       do:
      835         if p-append then
      836         do:
      837           output stream PrnLibStream to value( v-report-name )
      838             page-size value(p-page-size) append .
      839         end.
      840         if not p-append then
      841         do:
      842           output stream PrnLibStream to value( v-report-name )
      843             page-size value(p-page-size) .
      844         end.
      845       end.
      846       if not p-is-stream then
      847       do:
      848         if p-append then
      849         do:
      850           output to value( v-report-name )
      851             page-size value(p-page-size) append .
      852         end.
      853         if not p-append then
      854         do:
      855           output to value( v-report-name )
      856             page-size value(p-page-size) .
      857         end.
      858       end.
      859     end.
      860   end procedure.
      861   procedure prn-lib-open-exp :
      862     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      863     define input parameter p-is-stream    as logical no-undo .
      864     define input parameter p-is-append    as logical no-undo .
      865     define output parameter p-ReportFileName as char init "report" no-undo.
      866     define output parameter p-process as logical no-undo .
      867     define variable glog as logical no-undo .
      868     do
      869       on error undo, return error
      870       :
      871       SYSTEM-DIALOG GET-FILE p-ReportFileName
      872         TITLE      "Укажите путь"
      873         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      874         ASK-OVERWRITE
      875         CREATE-TEST-FILE
      876         SAVE-AS
      877         USE-FILENAME
      878         DEFAULT-EXTENSION "txt"
      879         UPDATE glog
      880         .
      881       if not glog then  return.
      882       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      883       if p-is-stream then
      884       do:
      885         if p-is-append then
      886         do:
      887           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      888         end.
      889         else
      890         do:
      891           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      892         end.
      893       end.
      894       else
      895       do:
      896         if p-is-append then
      897         do:
      898           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      899         end.
      900         else
      901         do:
      902           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      903         end.
      904       end.
      905       p-process = yes.
      906     end.
      907   end procedure.
      908   procedure prn-lib-get-report-name :
      909     define input parameter parParentProc  as widget-handle no-undo.
      910     define output parameter p-report-name as character no-undo .
      911     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      912   end procedure.
      913   procedure prn-lib-reportviewer-report-name :
      914     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      915     define input parameter p-report-name-html as character no-undo .
      916     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      917   end procedure.
      918   procedure prn-lib-reportviewer :
      919     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      920     define input parameter p-report-name-html as character no-undo .
      921     define input parameter p-param        as character no-undo .
      922     define variable v-excel           as character no-undo init 'TRUE' .
      923     define variable v-value-character as character no-undo .
      924     define variable v-value-integer   as character no-undo .
      925     define variable v-value-date      as date      no-undo .
      926     define variable v-value-decimal   as decimal   no-undo .
      927     define variable rep-excel         as logical   no-undo .
      928     define variable excel-string      as character no-undo .
      929     define variable v-param-type      as character no-undo .
      930     define variable v-tth             as handle    no-undo .
      931     run adm/shattri.p (
      932       input "get":U
      933       ,input  ""
      934       ,input  0
      935       ,input  'report-glob':U
      936       ,input  'rep-excel':U
      937       ,output v-value-character
      938       ,output v-value-date
      939       ,output v-value-decimal
      940       ,output v-value-integer
      941       ,output rep-excel
      942       ,output v-param-type
      943       ,INPUT-OUTPUT table-handle v-tth
      944       )  .
      945     if rep-excel then v-excel = "TRUE" .
      946     else v-excel = "FALSE" .
      947     if p-param eq ""
      948     then
      949        p-param = "EXCEL:" + v-excel.
      950     else
      951        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      952     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      953   end procedure.
      954   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      955   procedure cur-time :
      956      define output parameter p-today as date      no-undo .
      957      define output parameter p-time  as integer   no-undo .
      958     do
      959     on error undo, return error
      960     :
      961       define variable v-date1 as date      no-undo .
      962       define variable v-date2 as date      no-undo .
      963       define variable v-time  as integer   no-undo .
      964       assign
      965         v-date1 = today
      966         v-time  = time
      967         v-date2 = today
      968       .
      969       if v-date1 <> v-date2
      970       then do:
      971         assign
      972           v-date1 = today
      973           v-time  = v-time
      974         .
      975       end.
      976       assign
      977         p-today = v-date1
      978         p-time  = v-time
      979       .
      980     end.
      981   end.
      982   function cur-time-date returns character
      983   :
      984     return string(today, '99/99/9999':U) .
      985   end.
      986   function cur-time-mjd returns decimal
      987   :
      988     define variable v-date as date      no-undo .
      989     define variable v-time as integer   no-undo .
      990     run cur-time in this-procedure
      991       (output v-date
      992       ,output v-time
      993       ) .
      994     return integer(v-date) - 2400002 + (v-time / 86400) .
      995   end.
      996   function cur-time-get-ending-index returns integer
      997   (input p-number as integer
      998   )
      999   :
     1000     if p-number < 0
     1001     or p-number = ?
     1002     then do:
     1003       return 1 .
     1004     end.
     1005     define variable v-rest as integer   no-undo .
     1006     assign
     1007       p-number = p-number modulo 100
     1008     .
     1009     if p-number < 20
     1010     then do:
     1011       assign
     1012         v-rest = p-number
     1013       .
     1014     end.
     1015     else do:
     1016       assign
     1017         v-rest = p-number modulo 10
     1018       .
     1019     end.
     1020     case v-rest :
     1021       when 1
     1022       then do:
     1023         return 2 .
     1024       end.
     1025       when 2 or
     1026       when 3 or
     1027       when 4
     1028       then do:
     1029         return 3 .
     1030       end.
     1031       otherwise do:
     1032         return 1 .
     1033       end.
     1034     end case .
     1035   end.
     1036   procedure cur-time-mjd-to-date :
     1037      define input  parameter i-mjd-diff as decimal no-undo.
     1038      define output parameter o-Date     as date    no-undo.
     1039      define output parameter o-Time     as integer no-undo.
     1040      define variable v-day-number as integer   no-undo .
     1041      if    i-mjd-diff < 0
     1042         or i-mjd-diff = ?
     1043      then do:
     1044         return "?" .
     1045      end.
     1046      assign
     1047         v-day-number = truncate(i-mjd-diff,0).
     1048         o-Date = date(v-day-number + 2400002).
     1049         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1050     .
     1051   end.
     1052   function cur-time-mjd-to-string returns character
     1053   (input p-mjd-diff as decimal
     1054   )
     1055   :
     1056     define variable v-day-number as integer   no-undo .
     1057     define variable v-seconds    as integer   no-undo .
     1058     define variable v-hour       as integer   no-undo .
     1059     define variable v-min        as integer   no-undo .
     1060     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1061     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1062     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1063     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1064     if p-mjd-diff < 0
     1065     or p-mjd-diff = ?
     1066     then do:
     1067       return "?" .
     1068     end.
     1069     assign
     1070       v-day-number = integer(truncate(p-mjd-diff,0))
     1071       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1072     .
     1073     if v-seconds > 86400
     1074     then do:
     1075       assign
     1076         v-seconds = 86400 - 1
     1077       .
     1078     end.
     1079     if v-seconds < 0
     1080     then do:
     1081       assign
     1082         v-seconds = 0
     1083       .
     1084     end.
     1085     assign
     1086       v-hour = truncate(v-seconds / 3600, 0)
     1087     .
     1088     assign
     1089       v-seconds = v-seconds modulo 3600
     1090     .
     1091     assign
     1092       v-min = truncate(v-seconds / 60, 0)
     1093     .
     1094     assign
     1095       v-seconds = v-seconds modulo 60
     1096     .
     1097     return
     1098         (if v-day-number <> 0
     1099           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1100           else ""
     1101         )
     1102       + (if v-day-number <> 0 or v-hour <> 0
     1103           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1104           else ""
     1105         )
     1106       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1107           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1108           else ""
     1109         )
     1110       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1111       .
     1112   end.
     1113   function cur-time-string returns character
     1114   :
     1115     define variable v-date as date      no-undo .
     1116     define variable v-time as integer   no-undo .
     1117     run cur-time in this-procedure
     1118       (output v-date
     1119       ,output v-time
     1120       ) .
     1121     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1122   end.
     1123   function cur-time-string-sec returns character
     1124   :
     1125     define variable v-date as date      no-undo .
     1126     define variable v-time as integer   no-undo .
     1127     run cur-time in this-procedure
     1128       (output v-date
     1129       ,output v-time
     1130       ) .
     1131     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1132   end.
     1133   function cur-time-custom  returns character
     1134   (input p-prefix as character
     1135   ,input p-date-format as character
     1136   ,input p-delimiter as character
     1137   ,input p-time-format as character
     1138   ,input p-suffix as character
     1139   )
     1140   :
     1141     define variable v-date as date      no-undo .
     1142     define variable v-time as integer   no-undo .
     1143     run cur-time in this-procedure
     1144       (output v-date
     1145       ,output v-time
     1146       ) .
     1147     return
     1148       p-prefix
     1149       + string(v-date, p-date-format)
     1150       + p-delimiter
     1151       + string(v-time, p-time-format)
     1152       + p-suffix
     1153       .
     1154   end.
     1155   function cur-time-print  returns character
     1156   :
     1157     define variable v-date as date      no-undo .
     1158     define variable v-time as integer   no-undo .
     1159     run cur-time in this-procedure
     1160       (output v-date
     1161       ,output v-time
     1162       ) .
     1163     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1164   end.
     1165   function cur-time-datetime returns datetime
     1166   :
     1167     define variable v-char as character no-undo .
     1168     define variable v-datetime as datetime no-undo .
     1169     v-char = cur-time-string().
     1170     v-datetime = datetime(v-char).
     1171     return  v-datetime.
     1172   end.
     1173   function cur-time-string-msec returns character
     1174   :
     1175     define variable v-date as datetime  no-undo .
     1176     v-date = now.
     1177     return string(v-date) .
     1178   end.
     1179   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1180   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
     1181   define new shared variable RepPathName        as character no-undo .
     1182   define new shared variable PrintRubl          as logical   no-undo .
     1183   def var vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1184   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     1185   procedure paramls-clear :
     1186     define buffer buf_temp-param for temp-param .
     1187     do
     1188     on error undo, return error return-value
     1189     :
     1190       for each buf_temp-param
     1191       on error undo, return error
     1192       :
     1193         delete buf_temp-param .
     1194       end.
     1195     end.
     1196   end procedure.
     1197   procedure paramls-write :
     1198     define input  parameter p-code     as character no-undo .
     1199     define input  parameter p-sub-code as character no-undo .
     1200     define input  parameter p-value    as character no-undo .
     1201     define buffer buf_temp-param for temp-param .
     1202     do
     1203     on error undo, return error return-value
     1204     :
     1205       find first buf_temp-param
     1206         where buf_temp-param.param-code     = p-code
     1207           and buf_temp-param.param-sub-code = p-sub-code
     1208         no-error .
     1209       if not available buf_temp-param then do:
     1210         create buf_temp-param .
     1211         assign
     1212           buf_temp-param.param-code     = p-code
     1213           buf_temp-param.param-sub-code = p-sub-code
     1214         .
     1215       end.
     1216       assign
     1217         buf_temp-param.param-value = p-value
     1218       .
     1219     end.
     1220   end procedure.
     1221   procedure paramls-read :
     1222     define input  parameter p-code          as character no-undo .
     1223     define input  parameter p-sub-code      as character no-undo .
     1224     define input  parameter p-default-value as character no-undo .
     1225     define output parameter p-value         as character no-undo .
     1226     define buffer buf_temp-param for temp-param .
     1227     do
     1228     on error undo, return error return-value
     1229     :
     1230       find first buf_temp-param
     1231         where buf_temp-param.param-code     = p-code
     1232           and buf_temp-param.param-sub-code = p-sub-code
     1233         no-error .
     1234       if available buf_temp-param then do:
     1235         assign
     1236           p-value = buf_temp-param.param-value
     1237         .
     1238       end.
     1239       else do:
     1240         assign
     1241           p-value = p-default-value
     1242         .
     1243       end.
     1244     end.
     1245   end procedure.
     1246   procedure paramls-append :
     1247     define input  parameter p-code     as character no-undo .
     1248     define input  parameter p-sub-code as character no-undo .
     1249     define input  parameter p-value    as character no-undo .
     1250     define buffer buf_temp-param for temp-param .
     1251     do
     1252     on error undo, return error return-value
     1253     :
     1254       find first buf_temp-param
     1255            where buf_temp-param.param-code     = p-code
     1256              and buf_temp-param.param-sub-code = p-sub-code
     1257         no-error .
     1258       if not available buf_temp-param then do:
     1259         create buf_temp-param .
     1260         assign
     1261           buf_temp-param.param-code     = p-code
     1262           buf_temp-param.param-sub-code = p-sub-code
     1263           buf_temp-param.param-value    = p-value
     1264         .
     1265       end.
     1266       else do:
     1267           assign
     1268               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     1269           .
     1270       end.
     1271     end.
     1272   end procedure.
     1273   define variable vss-include-info7 as character format "X(65)" no-undo
     1274   initial "@(#)$Workfile$ $Revision$".
     1275   DEFINE VARIABLE v-disp-xl-current-data-row AS INTEGER   NO-UNDO.
     1276   DEFINE VARIABLE v-disp-xl-cell-file-name   AS CHARACTER NO-UNDO.
     1277   DEFINE VARIABLE v-disp-xl-data-file-name   AS CHARACTER NO-UNDO.
     1278   DEFINE STREAM excel-line.
     1279   DEFINE STREAM excel-cell.
     1280   define temp-table temp_cell-data no-undo
     1281       field data-key as character
     1282       field data-value as character
     1283       index pi is primary unique data-key
     1284   .
     1285   define temp-table temp_line-data no-undo
     1286       field data-key      as character
     1287       field xl-line-id    as integer
     1288       field obj-number      as character
     1289       field obj-address     as character
     1290       field obj-phone       as character
     1291       field gds-name        as character
     1292       field loc1            as character
     1293       field max-qnty        as character
     1294       field add-qnty        as character
     1295       field sale-qnty-7     as character
     1296       field curr-qnty       as character
     1297       field level-water     as character
     1298       field volume-water    as character
     1299       field doc-qnty       as character
     1300       field curr-date       as character
     1301       field curr-time       as character
     1302       field sale-qnty-1     as character
     1303       index pi is primary unique
     1304           xl-line-id
     1305   .
     1306   PROCEDURE disp-xl-init :
     1307   DO
     1308   ON ERROR UNDO, RETURN ERROR
     1309   :
     1310      ASSIGN
     1311         v-disp-xl-current-data-row = 0
     1312      .
     1313      run gbl/_tmpfile.p (
     1314            INPUT "xd"
     1315         , INPUT ".txt"
     1316         , OUTPUT v-disp-xl-data-file-name
     1317      ).
     1318      OUTPUT STREAM excel-line TO value( v-disp-xl-data-file-name ).
     1319      run gbl/_tmpfile.p (
     1320            INPUT "xc"
     1321         , INPUT ".txt"
     1322         , OUTPUT v-disp-xl-cell-file-name
     1323      ).
     1324      OUTPUT STREAM excel-cell TO value( v-disp-xl-cell-file-name ).
     1325      run disp-xl-write-cell-data in this-procedure (
     1326            input "valutCode":U
     1327         , input "1":U
     1328      ).
     1329      RUN disp-xl-write-cell-data IN THIS-PROCEDURE (
     1330            INPUT "columnList":U
     1331         , INPUT "obj_number,obj_address,obj_phone,gds_name,loc1,max_qnty,add_qnty,sale_qnty_7,curr_qnty,doc_qnty,level_water,volume_water,curr_date,curr_time,sale_qnty_1":U
     1332      ).
     1333      RUN disp-xl-write-cell-data IN THIS-PROCEDURE (
     1334            INPUT "columnType":U
     1335         , INPUT "S,S,S,S,S,S,S,S,S,S,S,S,S,S,S":U
     1336      ).
     1337      RUN disp-xl-write-cell-data IN THIS-PROCEDURE (
     1338            INPUT "columnAmount":U
     1339         , INPUT "15":U
     1340      ).
     1341   END.
     1342   END PROCEDURE.
     1343   PROCEDURE disp-xl-close :
     1344   DO
     1345   ON ERROR UNDO, RETURN ERROR
     1346   :
     1347       OUTPUT STREAM excel-line CLOSE.
     1348       OUTPUT STREAM excel-cell CLOSE.
     1349       OUTPUT TO value( STRING( SESSION:temp-directory + "$" + STRING( g#report-num ) ) + ".txl" )  .
     1350           EXPORT "exe/rep-disp.xlt":U.
     1351           EXPORT "exe/t_97.bas":U.
     1352           EXPORT v-disp-xl-cell-file-name.
     1353           EXPORT v-disp-xl-data-file-name.
     1354       OUTPUT CLOSE.
     1355   END.
     1356   END PROCEDURE.
     1357   PROCEDURE disp-xl-write-cell-data :
     1358   DEFINE INPUT PARAMETER p-data-key   AS CHARACTER NO-UNDO.
     1359   DEFINE INPUT PARAMETER p-data-value AS CHARACTER NO-UNDO.
     1360   define buffer buf_temp_cell-data     for temp_cell-data.
     1361   DO
     1362   ON ERROR UNDO, RETURN ERROR
     1363   :
     1364       find first buf_temp_cell-data
     1365            where buf_temp_cell-data.data-key = p-data-key
     1366       no-error.
     1367       if not available buf_temp_cell-data
     1368       then do:
     1369           create buf_temp_cell-data.
     1370           assign
     1371               buf_temp_cell-data.data-key = p-data-key
     1372           .
     1373       end.
     1374       assign
     1375           buf_temp_cell-data.data-value = p-data-value
     1376       .
     1377       put stream excel-cell unformatted
     1378                           buf_temp_cell-data.data-key
     1379           chr(9)   buf_temp_cell-data.data-value
     1380           chr(10)
     1381       .
     1382   end.
     1383   end procedure.
     1384   PROCEDURE disp-xl-write-line-data :
     1385   DEFINE INPUT PARAMETER p-obj-number  AS CHARACTER NO-UNDO.
     1386   DEFINE INPUT PARAMETER p-obj-address AS CHARACTER NO-UNDO.
     1387   DEFINE INPUT PARAMETER p-obj-phone   AS CHARACTER NO-UNDO.
     1388   DEFINE INPUT PARAMETER p-gds-name    AS CHARACTER NO-UNDO.
     1389   DEFINE INPUT PARAMETER p-loc1        AS CHARACTER NO-UNDO.
     1390   DEFINE INPUT PARAMETER p-max-qnty    AS CHARACTER NO-UNDO.
     1391   DEFINE INPUT PARAMETER p-add-qnty    AS CHARACTER NO-UNDO.
     1392   DEFINE INPUT PARAMETER p-sale-qnty-7 AS CHARACTER NO-UNDO.
     1393   DEFINE INPUT PARAMETER p-curr-qnty   AS CHARACTER NO-UNDO.
     1394   DEFINE INPUT PARAMETER p-level-water AS CHARACTER NO-UNDO.
     1395   DEFINE INPUT PARAMETER p-volume-water AS CHARACTER NO-UNDO.
     1396   DEFINE INPUT PARAMETER p-doc-qnty    AS CHARACTER NO-UNDO.
     1397   DEFINE INPUT PARAMETER p-curr-date   AS CHARACTER NO-UNDO.
     1398   DEFINE INPUT PARAMETER p-curr-time   AS CHARACTER NO-UNDO.
     1399   DEFINE INPUT PARAMETER p-sale-qnty-1 AS CHARACTER NO-UNDO.
     1400   define buffer buf_temp_line-data        for temp_line-data.
     1401   DO
     1402   ON ERROR UNDO, RETURN ERROR
     1403   :
     1404       for each buf_temp_line-data
     1405       :
     1406           delete buf_temp_line-data.
     1407       end.
     1408       create buf_temp_line-data.
     1409       assign
     1410           v-disp-xl-current-data-row = v-disp-xl-current-data-row + 1
     1411       .
     1412       assign
     1413           buf_temp_line-data.data-key   = "LD":U
     1414           buf_temp_line-data.xl-line-id = v-disp-xl-current-data-row
     1415           buf_temp_line-data.obj-number    = p-obj-number
     1416           buf_temp_line-data.obj-address   = p-obj-address
     1417           buf_temp_line-data.obj-phone     = p-obj-phone
     1418           buf_temp_line-data.gds-name      = p-gds-name
     1419           buf_temp_line-data.loc1          = p-loc1
     1420           buf_temp_line-data.max-qnty      = p-max-qnty
     1421           buf_temp_line-data.add-qnty      = p-add-qnty
     1422           buf_temp_line-data.sale-qnty-7   = p-sale-qnty-7
     1423           buf_temp_line-data.curr-qnty     = p-curr-qnty
     1424           buf_temp_line-data.level-water   = p-level-water
     1425           buf_temp_line-data.volume-water  = p-volume-water
     1426           buf_temp_line-data.curr-date     = p-curr-date
     1427           buf_temp_line-data.curr-time     = p-curr-time
     1428           buf_temp_line-data.sale-qnty-1   = p-sale-qnty-1
     1429       .
     1430       PUT STREAM excel-line UNFORMATTED
     1431                           buf_temp_line-data.data-key
     1432           chr(9)   p-obj-number
     1433           chr(9)   p-obj-address
     1434           chr(9)   p-obj-phone
     1435           chr(9)   p-gds-name
     1436           chr(9)   p-loc1
     1437           chr(9)   p-max-qnty
     1438           chr(9)   p-add-qnty
     1439           chr(9)   p-sale-qnty-7
     1440           chr(9)   p-curr-qnty
     1441           chr(9)   p-doc-qnty
     1442           chr(9)   p-level-water
     1443           chr(9)   p-volume-water
     1444           chr(9)   p-curr-date
     1445           chr(9)   p-curr-time
     1446           chr(9)   p-sale-qnty-1
     1447           chr(10)
     1448       .
     1449   END.
     1450   END PROCEDURE.
     1451   PROCEDURE disp-xl-run-excel :
     1452   DEFINE INPUT PARAMETER p-header-filename    AS CHARACTER        NO-UNDO.
     1453   DEFINE INPUT PARAMETER p-data-filename      AS CHARACTER        NO-UNDO.
     1454   DEFINE VARIABLE v-template-file-name    AS CHARACTER    NO-UNDO.
     1455   DEFINE VARIABLE v-vb-file-name          AS CHARACTER    NO-UNDO.
     1456   DEFINE BUFFER buf_temp-param FOR temp-param .
     1457   DO
     1458   FOR buf_temp-param
     1459   ON ERROR UNDO, RETURN ERROR
     1460   :
     1461       CREATE buf_temp-param.
     1462       ASSIGN
     1463           v-template-file-name    = SEARCH( "exe/rep-disp.xlt" )
     1464           v-vb-file-name          = SEARCH( "exe/t_97.bas")
     1465       .
     1466       IF v-template-file-name = ?
     1467       OR v-template-file-name = "":U
     1468       THEN DO:
     1469           MESSAGE
     1470               "Ошибка имени файла шаблона."
     1471           VIEW-AS ALERT-BOX ERROR.
     1472       END.
     1473       IF v-vb-file-name = ?
     1474       OR v-vb-file-name = "":U
     1475       THEN DO:
     1476           MESSAGE
     1477               "Ошибка имени файла кода обработки."
     1478           VIEW-AS ALERT-BOX ERROR.
     1479       END.
     1480       RUN paramls-write IN THIS-PROCEDURE (
     1481             INPUT "template":U
     1482           , INPUT "template-file-name":U
     1483           , INPUT v-template-file-name
     1484       ).
     1485       RUN paramls-write IN THIS-PROCEDURE (
     1486             INPUT "template":U
     1487           , INPUT "vb-file-name":U
     1488           , INPUT v-vb-file-name
     1489       ).
     1490       RUN PARAMLS-WRITE IN THIS-PROCEDURE (
     1491             INPUT "data":U
     1492           , INPUT "data-header-filename":U
     1493           , INPUT p-header-filename
     1494       ).
     1495       RUN paramls-write IN THIS-PROCEDURE (
     1496             INPUT "data":U
     1497           , INPUT "data-filename":U
     1498           , INPUT p-data-filename
     1499       ).
     1500       run gbl/macroxlt.p (
     1501           INPUT-OUTPUT table buf_temp-param
     1502       ) NO-ERROR.
     1503       IF ERROR-STATUS :ERROR
     1504       THEN DO:
     1505           MESSAGE
     1506                    vss-workfile vss-revision vss-description
     1507               SKIP(1)
     1508               SKIP "Ошибка создания файла Excel."
     1509               SKIP RETURN-VALUE
     1510               SKIP TRIM(ERROR-STATUS :GET-MESSAGE(1))
     1511                    TRIM(ERROR-STATUS :GET-MESSAGE(2))
     1512                    TRIM(ERROR-STATUS :GET-MESSAGE(3))
     1513           VIEW-AS ALERT-BOX ERROR.
     1514           UNDO, RETURN ERROR .
     1515       END.
     1516   END.
     1517   END PROCEDURE.
     1518   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1519   define new global shared variable g#attr-lib  as handle no-undo .
