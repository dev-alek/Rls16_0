     6594   procedure get-supp-cli-name :
     6595     define  input parameter p-parts-rec as recid     no-undo .
     6596     define output parameter p-doc-code  as character no-undo .
     6597     define variable v-in-code   like ub.parts-supp.in-code   no-undo .
     6598     define variable v-artic     like ub.parts-supp.artic     no-undo .
     6599     define variable v-prod-type like ub.parts-supp.prod-type no-undo .
     6600     define variable v-prod-code like ub.parts-supp.prod-code no-undo .
     6601     define variable v-part-code like ub.parts-supp.part-code no-undo .
     6602     define variable v-supp-type like ub.parts-supp.supp-type no-undo .
     6603     define variable v-supp-code like ub.parts-supp.supp-code no-undo .
     6604     define buffer buf_parts     for ub.parts      .
     6605     define buffer bf_parts-supp for ub.parts-supp .
     6606     define buffer buf_trn-doc   for ub.trn-doc    .
     6607     do
     6608     on error undo, return error return-value
     6609     :
     6610       find first buf_parts no-lock where
     6611           recid( buf_parts ) = p-parts-rec no-error .
     6612       if available buf_parts
     6613       then do:
     6614         assign
     6615           v-in-code   = bf_parts.in-code
     6616           v-artic     = bf_parts.artic
     6617           v-prod-type = bf_parts.prod-type
     6618           v-prod-code = bf_parts.prod-code
     6619           v-part-code = bf_parts.part-code
     6620           v-supp-type = bf_parts.supp-type
     6621           v-supp-code = bf_parts.supp-code
     6622         .
     6623         repeat
     6624         :
     6625           find first bf_parts-supp no-lock where
     6626                      bf_parts-supp.in-code   = v-in-code   and
     6627                      bf_parts-supp.artic     = v-artic     and
     6628                      bf_parts-supp.prod-type = v-prod-type and
     6629                      bf_parts-supp.prod-code = v-prod-code and
     6630                      bf_parts-supp.part-code = v-part-code no-error .
     6631           if not available bf_parts-supp
     6632           then do:
     6633             leave .
     6634           end.
     6635           assign
     6636             v-in-code   = bf_parts-supp.orig-in-code
     6637             v-artic     = bf_parts-supp.artic
     6638             v-prod-type = bf_parts-supp.prod-type
     6639             v-prod-code = bf_parts-supp.prod-code
     6640             v-part-code = bf_parts-supp.orig-part-code
     6641             v-supp-type = bf_parts-supp.supp-type
     6642             v-supp-code = bf_parts-supp.supp-code
     6643           .
     6644         end.
     6645         find first buf_trn-doc no-lock where
     6646                    buf_trn-doc.doc-code = v-in-code no-error .
     6647         if available buf_trn-doc
     6648         then do:
     6649           case p-trn-doc-num :
     6650             when 1
     6651             then do:
     6652   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input buf_trn-doc.doc-code ,
     6653                           input 'nids':U ,
     6654                          output p-doc-code ,
     6655                          output v-type ) no-error .
     6656               if error-status :error or
     6657                  p-doc-code = "":U   or
     6658                  p-doc-code = ?
     6659               then do:
     6660                 assign
     6661                   p-doc-code = '@' + buf_trn-doc.doc-code
     6662                 .
     6663               end.
     6664             end.
     6665             otherwise do:
     6666               assign
     6667                 p-doc-code = buf_trn-doc.doc-code
     6668               .
     6669             end.
     6670           end case.
     6671         end.
     6672       end.
     6673     end.
     6674   end procedure.
