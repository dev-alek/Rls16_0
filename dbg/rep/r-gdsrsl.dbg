     1666     end.
     1667     else do:
     1668       find first in-vatp_doc-attrcl no-lock
     1669         where in-vatp_doc-attrcl.doc-code  = cl_tt-clcparts.out-code
     1670           and in-vatp_doc-attrcl.attr-code = 'envd':U
     1671         no-error .
