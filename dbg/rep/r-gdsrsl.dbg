     2515       bfspc_tt-allsum.road-tax-rubl-doc   = bfs_tt-allsum.road-tax-rubl-doc   - bfs_tt-allsum.road-tax-rubl-acc
     2516       bfspc_tt-allsum.excise-base-doc     = bfs_tt-allsum.excise-base-doc
