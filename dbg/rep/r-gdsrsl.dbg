     5378                  ":" + string( string( j-npp,              ">>9":U                   ), "x(3)":U  ) +
     5379                  ":" + string(         tt-suppl.cli-name,  "x(24)":U                 )              +
     5380                  ":" + string( string( tt-suppl.fact-date, "99/99/9999":U            ), "x(10)":U ) +
     5381                  ":" + string(         tt-suppl.doc-code,  "x(13)":U                 )
     5382               .
     5383             end.
     5384             assign
     5385               jj = j-supp-vat-ord - 1
     5386             .
     5387             for each tt-supp-vat no-lock where
     5388                      tt-supp-vat.order  = tt-suppl.order
     5389             break by tt-supp-vat.vat-pc descending
     5390             :
     5391               find first tt-vat-total no-lock where
     5392                          tt-vat-total.vat-pc = tt-supp-vat.vat-pc no-error .
     5393               if not available tt-vat-total
     5394               then do:
     5395                 create tt-vat-total .
     5396                 assign
     5397                   tt-vat-total.vat-pc  = tt-supp-vat.vat-pc
     5398                   tt-vat-total.vat-ord = tt-supp-vat.vat-ord
     5399                   tt-vat-total.vat-sum = 0.00
     5400                 .
     5401               end.
     5402               else do:
     5403                 if tt-vat-total.vat-sum = ?
     5404                 then do:
     5405                   assign
     5406                     tt-vat-total.vat-sum = 0.00
     5407                   .
     5408                 end.
     5409               end.
     5410               assign
     5411                 tt-vat-total.vat-sum = tt-vat-total.vat-sum + tt-supp-vat.sum-doc
     5412               .
     5413             end.
     5414             if last-of( tt-suppl.doc-code )
     5415             then do:
     5416               assign
     5417                 Document_Total = 0.00
     5418                 Discount_Total = 0.00
     5419               .
     5420               for each tt-vat-total no-lock
     5421               break by tt-vat-total.vat-pc descending
     5422               :
     5423                 if tt-vat-total.vat-sum = ?
     5424                 then do:
     5425                   put stream text_out unformatted
     5426                     ":             ":U
     5427                   .
     5428                 end.
     5429                 else do:
     5430                   assign
     5431                     Document_Total = Document_Total + tt-vat-total.vat-sum
     5432                   .
     5433                   put stream text_out unformatted
     5434                     ":" + string( string( tt-vat-total.vat-sum, "->,>>>,>>9.99":U ), "x(13)":U )
     5435                   .
     5436                 end.
     5437               end.
     5438               assign
     5439                 jj = 0
     5440               .
     5441               assign
     5442                 Discount_Total = d_doc-sum-sale - Document_Total
     5443               .
     5444               put stream text_out unformatted
     5445                  ":" string( string( Document_Total, "->,>>>,>>9.99":U ), "x(13)":U )
     5446                  ":" string( string( Discount_Total, "->,>>>,>>9.99":U ), "x(13)":U )
     5447                  ":" string( string( d_doc-sum-sale, "->,>>>,>>9.99":U ), "x(13)":U ) ":" skip
     5448               .
     5449               assign
     5450                 d_doc-sum-sale = 0.00
     5451               .
     5452               for each tt-vat-total
     5453               :
     5454                 delete tt-vat-total .
     5455               end.
     5456             end.
     5457           end.
     5458         end case.
     5459         if last-of( tt-suppl.ext-doc-ord )
     5460         then do:
     5461           assign
     5462             v-original-code = substitute( '&1#&2-&3&4'
     5463                                         , "---"
     5464                                         , -1
     5465                                         , tt-suppl.ext-doc-type
     5466                                         , trim( string( tt-suppl.is-hold-doc = yes, "_hold/":U ) )
     5467                                         )
     5468           .
     5469           find first bf_suppl no-lock where
     5470                      bf_suppl.is-total    = yes                  and
     5471                      bf_suppl.supp-type   = "---"   and
     5472                      bf_suppl.supp-code   = -1   and
     5473                      bf_suppl.ext-doc-grp = tt-suppl.ext-doc-grp and
     5474                      bf_suppl.ext-doc-ord = tt-suppl.ext-doc-ord and
     5475                      bf_suppl.orig-code   = v-original-code      no-error .
     5476           if available bf_suppl
     5477           then do:
     5478             case tt-suppl.ext-doc-grp :
     5479               when 1
     5480               then do:
     5481                 put stream text_out unformatted
     5482                   ':-------:----------------------------------------:-----------:---------------:---------------------:' skip( 0 )
     5483                   ':       :                                        :           : Итого:        :'
     5484                   string( string( bf_suppl.sum-sale, "->,>>>,>>>,>>>,>>9.99":U ), "x(21)":U )                        ':' skip( 0 )
     5485                   '----------------------------------------------------------------------------------------------------' skip( 0 )
     5486                 .
     5487               end.
     5488               when 2
     5489               then do:
     5490                 put stream text_out unformatted
     5491                   ':-------:----------------------------------------:-----------:---------------:---------------------:' skip( 0 )
     5492                   ':       :                                        :           : Итого:        :'
     5493                   string( string( bf_suppl.sum-sale, "->,>>>,>>>,>>>,>>9.99":U ), "x(21)":U )                        ':' skip( 0 )
     5494                   '----------------------------------------------------------------------------------------------------' skip( 0 )
     5495                 .
     5496               end.
     5497               when 3
     5498               then do:
     5499                 assign
     5500                   Document_Total = 0.00
     5501                   Discount_Total = 0.00
     5502                 .
     5503                 put stream text_out unformatted
     5504                   ':---:------------------------:----------:-------------:'
     5505                   fill( '-------------:', j-supp-vat-ord ) '-------------:-------------:' skip( 0 )
     5506                   ':   :                        :          : Итого:      :'
     5507                 .
     5508                 for each bf_supp-vat no-lock where
     5509                          bf_supp-vat.order  = bf_suppl.order and
     5510                          bf_supp-vat.is-tot = yes
     5511                 break by bf_supp-vat.vat-pc descending
     5512                 :
     5513                   assign
     5514                     Document_Total = Document_Total + bf_supp-vat.sum-doc
     5515                   .
     5516                   put stream text_out unformatted
     5517                     string( string( bf_supp-vat.sum-doc, "->,>>>,>>9.99":U ), "x(13)":U ) ':'
     5518                   .
     5519                 end.
     5520                 assign
     5521                   Discount_Total = bf_suppl.sum-sale - Document_Total
     5522                 .
     5523                 put stream text_out unformatted
     5524                   string( string( Document_Total,    "->,>>>,>>9.99":U ), "x(13)":U ) ':'
     5525                   string( string( Discount_Total,    "->,>>>,>>9.99":U ), "x(13)":U ) ':'
     5526                   string( string( bf_suppl.sum-sale, "->,>>>,>>9.99":U ), "x(13)":U ) ':' skip( 0 )
     5527                   '-------------------------------------------------------'
     5528                   fill( '--------------', j-supp-vat-ord ) '----------------------------' skip( 0 )
     5529                 .
     5530               end.
     5531             end case.
     5532           end.
     5533           assign
     5534             first_time = ?
     5535           .
     5536           find first bf_suppl no-lock where
     5537                      bf_suppl.is-total    = no                   and
     5538                      bf_suppl.ext-doc-ord > tt-suppl.ext-doc-ord no-error .
     5539           if available bf_suppl
     5540           then do:
     5541             assign
     5542               first_time = yes
     5543             .
     5544             do jj = tt-suppl.ext-doc-ord + 1 to bf_suppl.ext-doc-ord - 1
     5545             :
     5546               if use-column[ jj ] = yes
     5547               then do:
     5548                 if first_time = yes
     5549                 then do:
     5550                   assign
     5551                     first_time = no
     5552                   .
     5553                   put stream text_out unformatted
     5554                     skip( 1 )
     5555                   .
     5556                 end.
     5557                 run get-xtype-name in this-procedure
     5558                   (  input jj
     5559                   , output v-ext-doc-name
     5560                   ) .
     5561                 put stream text_out unformatted
     5562                   v-ext-doc-name ':' skip
     5563                 .
     5564               end.
     5565             end.
     5566             if first_time = no
     5567             then do:
     5568               put stream text_out unformatted
     5569                 skip( 1 )
     5570               .
     5571             end.
     5572           end.
     5573         end.
     5574         if last( tt-suppl.ext-doc-ord )
     5575         then do:
     5576           assign
     5577             first_time = ?
     5578           .
     5579           if tt-suppl.ext-doc-ord < 18
     5580           then do:
     5581             assign
     5582               first_time = yes
     5583             .
     5584             do jj = tt-suppl.ext-doc-ord + 1 to 18
     5585             :
     5586               if use-column[ jj ] = yes
     5587               then do:
     5588                 if first_time = yes
     5589                 then do:
     5590                   assign
     5591                     first_time = no
     5592                   .
     5593                   put stream text_out unformatted
     5594                     skip( 1 )
     5595                   .
     5596                 end.
     5597                 run get-xtype-name in this-procedure
     5598                   (  input jj
     5599                   , output v-ext-doc-name
     5600                   ) .
     5601                 put stream text_out unformatted
     5602                   v-ext-doc-name ':' skip
     5603                 .
     5604               end.
     5605             end.
     5606             if first_time = no
     5607             then do:
     5608               put stream text_out unformatted
     5609                 skip( 1 )
     5610               .
     5611             end.
     5612           end.
     5613           hide stream text_out frame Bottom_Page no-pause .
     5614         end.
     5615       end.
     5616       if p-all-suppl = yes
     5617       then do:
     5618         find first bf_stk-tot no-lock where
     5619                    bf_stk-tot.obj-type    = p-obj-type      and
     5620                    bf_stk-tot.obj-code    = p-obj-code      and
     5621                    bf_stk-tot.fact-order >= fact-order-till and
     5622                    bf_stk-tot.sum-type    = 'crsa':U     and
     5623                    bf_stk-tot.cat-id      = '##,##':U  no-error .
     5624         if available bf_stk-tot
     5625         then do:
     5626           assign
     5627             d_final-rest = ( if varr-b = "rubl" then bf_stk-tot.sum-rubl else bf_stk-tot.sum-base )
     5628             d_final-qnty = bf_stk-tot.fact-qnty
     5629           .
     5630         end.
     5631         else do:
     5632           assign
     5633             d_final-rest = 0.00
     5634             d_final-qnty = 0.00
     5635           .
     5636         end.
     5637       end.
     5638       else do:
     5639         for each g#supplier no-lock
     5640         :
     5641           run get-supp-rest in this-procedure
     5642             (  input g#supplier.supp-type
     5643             ,  input g#supplier.supp-code
     5644             ,  input "final":U
     5645             ,  input fact-order-till
     5646             , output d_temp-rest
     5647             , output d_temp-qnty
     5648             ) no-error .
     5649           if error-status :error or
     5650              d_temp-rest = ?
     5651           then do:
     5652             assign
     5653               d_temp-rest = 0.00
     5654             .
     5655           end.
     5656           assign
     5657             d_final-rest = d_final-rest + d_temp-rest
     5658             d_temp-rest  = 0.00
     5659           .
     5660         end.
     5661       end.
     5662       put stream text_out unformatted
     5663         string( substitute( 'Остаток на конец: &1'
     5664                           , trim( string( d_final-rest, "->,>>>,>>>,>>>,>>9.99":U ) )
     5665                           ), "x(80)":U ) skip( 1 )
     5666       .
     5667     end.
     5668     output stream text_out close .
     5669     run WaitFram-Hide in this-procedure .
     5670     run prn-lib-prn-file in this-procedure
     5671       ( input p-parent-proc
     5672       , input 0
     5673       ) .
     5674   end.
     5675   procedure get-suppl :
     5676     define  input parameter p-in-code   like ub.parts-supp.in-code   no-undo .
     5677     define  input parameter p-artic     like ub.parts-supp.artic     no-undo .
     5678     define  input parameter p-prod-type like ub.parts-supp.prod-type no-undo .
     5679     define  input parameter p-prod-code like ub.parts-supp.prod-code no-undo .
     5680     define  input parameter p-part-code like ub.parts-supp.part-code no-undo .
     5681     define output parameter p-supp-type like ub.parts-supp.supp-type no-undo initial "":U .
     5682     define output parameter p-supp-code like ub.parts-supp.supp-code no-undo initial 0 .
     5683     define buffer bf_parts-supp for ub.parts-supp .
     5684     do
     5685     on error undo, return error return-value
     5686     :
     5687       repeat
     5688       :
     5689         find first bf_parts-supp no-lock where
     5690                    bf_parts-supp.in-code   = p-in-code   and
     5691                    bf_parts-supp.artic     = p-artic     and
     5692                    bf_parts-supp.prod-type = p-prod-type and
     5693                    bf_parts-supp.prod-code = p-prod-code and
     5694                    bf_parts-supp.part-code = p-part-code no-error .
     5695         if not available bf_parts-supp
     5696         then do:
     5697           leave .
     5698         end.
     5699         assign
     5700           p-in-code   = bf_parts-supp.orig-in-code
     5701           p-part-code = bf_parts-supp.orig-part-code
     5702           p-supp-type = bf_parts-supp.supp-type
     5703           p-supp-code = bf_parts-supp.supp-code
     5704         .
     5705       end.
     5706     end.
     5707   end procedure.
     5708   procedure cr-tt-suppl :
     5709     define input parameter p-parts     as recid     no-undo .
     5710     define input parameter p-supp-type as character no-undo .
     5711     define input parameter p-supp-code as integer   no-undo .
     5712     define variable varcur-fact-qnty    like ub.gds-dtl.fact-qnty     no-undo .
     5713     define variable varcur-base         like ub.gds-dtl.price-base    no-undo .
     5714     define variable varcur-road-tax     like ub.doc-line.road-tax     no-undo .
     5715     define variable varcur-excise       like ub.doc-line.excise       no-undo .
     5716     define variable varcur-vat-pc       like ub.doc-line.vat-pc       no-undo .
     5717     define variable varcur-cons-vat-pc  like ub.doc-line.cons-vat-pc  no-undo .
     5718     define variable varcur-slt-pc       like ub.doc-line.slt-pc       no-undo .
     5719     define variable varprice-sale       like ub.price-list.price-sale no-undo .
     5720     define variable vardoc-num          like ub.price-doc.doc-num     no-undo .
     5721     define variable varb-code           like ub.bar-code.b-code       no-undo .
     5722     define variable varroad-tax         like ub.price-list.road-tax   no-undo .
     5723     define variable varexcise           like ub.price-list.excise     no-undo .
     5724     define variable varlastcur-base     like ub.gds-dtl.price-base    no-undo .
     5725     define variable varlastcur-road-tax like ub.gds-dtl.price-base    no-undo .
     5726     define variable varlastcur-excise   like ub.gds-dtl.price-base    no-undo .
     5727     define buffer buf_parts    for ub.parts    .
     5728     define buffer buf_trn-doc  for ub.trn-doc  .
     5729     define buffer buf_doc-line for ub.doc-line .
     5730     define buffer buf_goods    for ub.goods    .
     5731     define buffer buf_sysconf  for ub.sysconf  .
     5732     define buffer buf_gds-dtl  for ub.gds-dtl  .
     5733     define buffer buf_suppl    for tt-suppl    .
     5734     define buffer buf_supp-vat for tt-supp-vat .
     5735     define buffer buf_clients  for ub.clients  .
     5736     do
     5737     on error undo, return error return-value
     5738     :
     5739       find first buf_parts no-lock where
     5740           recid( buf_parts ) = p-parts no-error .
     5741       if not available buf_parts
     5742       then do:
     5743         run WaitFram-Hide in this-procedure .
     5744         undo, return error "Партия не найдена" .
     5745       end.
     5746       find first g#supplier no-lock where
     5747                  g#supplier.supp-type = p-supp-type and
     5748                  g#supplier.supp-code = p-supp-code no-error .
     5749       if not available g#supplier
     5750       then do:
     5751         if p-all-suppl = yes
     5752         then do:
     5753           find first bf_clients no-lock where
     5754                      bf_clients.obj-type = buf_parts.supp-type and
     5755                      bf_clients.obj-code = buf_parts.supp-code no-error .
     5756           if available bf_clients
     5757           then do:
     5758             create g#supplier .
     5759             assign
     5760               g#supplier.supp-type = bf_clients.obj-type
     5761               g#supplier.supp-code = bf_clients.obj-code
     5762               g#supplier.supp-name = bf_clients.obj-name
     5763             .
     5764           end.
     5765         end.
     5766         else do:
     5767           run WaitFram-Hide in this-procedure .
     5768           undo, return error substitute( 'Не найден поставщик &1 &2.'
     5769                                        , p-supp-type
     5770                                        , p-supp-code
     5771                                        ) .
     5772         end.
     5773       end.
     5774       find first buf_trn-doc no-lock where
     5775                  buf_trn-doc.doc-code = buf_parts.out-code no-error .
     5776       if not available buf_trn-doc
     5777       then do:
     5778         run WaitFram-Hide in this-procedure .
     5779         undo, return error substitute( 'Не найден документ "&1" по партии.'
     5780                                      , buf_parts.out-code
     5781                                      ) .
     5782       end.
     5783       find first buf_clients no-lock where
     5784                  buf_clients.obj-type = buf_trn-doc.cli-type and
     5785                  buf_clients.obj-code = buf_trn-doc.cli-code no-error .
     5786       if not available buf_clients
     5787       then do:
     5788         run WaitFram-Hide in this-procedure .
     5789         undo, return error substitute( 'Не найден контрагент &1 &2 из документа "&3".'
     5790                                      , buf_trn-doc.cli-type
     5791                                      , buf_trn-doc.cli-code
     5792                                      , buf_trn-doc.doc-code
     5793                                      ) .
     5794       end.
     5795       find first buf_doc-line no-lock where
     5796                  buf_doc-line.doc-code  = buf_trn-doc.doc-code and
     5797                  buf_doc-line.artic     = buf_parts.artic      and
     5798                  buf_doc-line.prod-type = buf_parts.prod-type  and
     5799                  buf_doc-line.prod-code = buf_parts.prod-code  no-error .
     5800       if not available buf_doc-line
     5801       then do:
     5802         run WaitFram-Hide in this-procedure .
     5803         undo, return error substitute( 'Не найдена строка документа "&1" по партии (&2 &3 &4).'
     5804                                      , buf_trn-doc.doc-code
     5805                                      , buf_parts.artic
     5806                                      , buf_parts.prod-type
     5807                                      , buf_parts.prod-code
     5808                                      ) .
     5809       end.
     5810       find first buf_goods no-lock where
     5811                  buf_goods.artic     = buf_doc-line.artic     and
     5812                  buf_goods.prod-type = buf_doc-line.prod-type and
     5813                  buf_goods.prod-code = buf_doc-line.prod-code .
     5814       if varcur-vat-pc = ?
     5815       then do:
     5816   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5817   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     5818     (input  buf_goods.gds-code
     5819     ,input  '1':U
     5820     ,input  buf_trn-doc.fact-date
     5821     ,input  buf_trn-doc.host-code
     5822     ,input  buf_trn-doc.obj-type
     5823     ,input  buf_trn-doc.obj-code
     5824     ,output varcur-vat-pc
     5825     )  .
     5826       end.
     5827       if varcur-slt-pc = ?
     5828       then do:
     5829   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5830   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     5831     (input  buf_goods.gds-code
     5832     ,input  '2':U
     5833     ,input  buf_trn-doc.fact-date
     5834     ,input  buf_trn-doc.host-code
     5835     ,input  buf_trn-doc.obj-type
     5836     ,input  buf_trn-doc.obj-code
     5837     ,output varcur-slt-pc
     5838     )  .
     5839       end.
     5840       if varcur-vat-pc = ?
     5841       then do:
     5842         run WaitFram-Hide in this-procedure .
     5843         undo, return error substitute( 'Нет текущего продажного НДС по товару &1 &2 &3'
     5844                                      , buf_goods.artic
     5845                                      , buf_goods.prod-type
     5846                                      , buf_goods.prod-code
     5847                                      ) .
     5848       end.
     5849       if varcur-slt-pc = ?
     5850       then do:
     5851         return error substitute( 'Нет текущего продажного НП по товару &1 &2 &3'
     5852                                , buf_goods.artic
     5853                                , buf_goods.prod-type
     5854                                , buf_goods.prod-code
     5855                                ) .
     5856       end.
     5857       find first buf_sysconf no-lock where
     5858                  buf_sysconf.host-code = buf_trn-doc.host-code .
     5859       assign
     5860         varcur-cons-vat-pc = buf_sysconf.cons-vat-pc
     5861       .
     5862       if varcur-cons-vat-pc = ?
     5863       then do:
     5864         return error substitute( 'Нет текущего продажного консигнационного НДС по фирме &1'
     5865                                , buf_trn-doc.host-code
     5866                                ) .
     5867       end.
     5868       for each buf_gds-dtl no-lock where
     5869                buf_gds-dtl.doc-code  = buf_doc-line.doc-code  and
     5870                buf_gds-dtl.artic     = buf_doc-line.artic     and
     5871                buf_gds-dtl.prod-type = buf_doc-line.prod-type and
     5872                buf_gds-dtl.prod-code = buf_doc-line.prod-code
     5873       on error undo, return error return-value
     5874       :
     5875   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     5876     (input  buf_goods.gds-code
     5877     ,input  buf_gds-dtl.prt-code
     5878     ,output varb-code
     5879     ) no-error .
     5880   define variable vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5881   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     5882     (input  buf_trn-doc.obj-type
     5883     ,input  buf_trn-doc.obj-code
     5884     ,input  varb-code
     5885     ,input  0
     5886     ,input  buf_trn-doc.fact-order
     5887     ,output vardoc-num
     5888     ,output varprice-sale
     5889     ,output varroad-tax
     5890     ,output varexcise
     5891     )  .
     5892         if varprice-sale = ?
     5893         then do:
     5894           assign
     5895             varprice-sale = 0.00
     5896             varroad-tax   = 0.00
     5897             varexcise     = 0.00
     5898           .
     5899         end.
     5900         assign
     5901           varlastcur-base     = varprice-sale
     5902           varlastcur-road-tax = varroad-tax
     5903           varlastcur-excise   = varexcise
     5904           varcur-base         = varcur-base      + varprice-sale * buf_gds-dtl.fact-qnty
     5905           varcur-road-tax     = varcur-road-tax  + varroad-tax   * buf_gds-dtl.fact-qnty
     5906           varcur-excise       = varcur-excise    + varexcise     * buf_gds-dtl.fact-qnty
     5907           varcur-fact-qnty    = varcur-fact-qnty +                 buf_gds-dtl.fact-qnty
     5908         .
     5909       end.
     5910       if varcur-fact-qnty = 0.00
     5911       then do:
     5912         assign
     5913           varcur-base      = varlastcur-base
     5914           varcur-road-tax  = varlastcur-road-tax
     5915           varcur-excise    = varlastcur-excise
     5916         .
     5917       end.
     5918       else do:
     5919         assign
     5920           varcur-base      = varcur-base     / varcur-fact-qnty
     5921           varcur-road-tax  = varcur-road-tax / varcur-fact-qnty
     5922           varcur-excise    = varcur-excise   / varcur-fact-qnty
     5923         .
     5924       end.
     5925   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     5926     (input  buf_goods.gds-code
     5927     ,input  ?
     5928     ,output varb-code
     5929     )  .
     5930   define variable vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5931   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcprcex in g#library
     5932     (input  buf_trn-doc.obj-type
     5933     ,input  buf_trn-doc.obj-code
     5934     ,input  varb-code
     5935     ,input  0
     5936     ,input  buf_trn-doc.fact-order
     5937     ,output vardoc-num
     5938     ,output varprice-sale
     5939     ,output varroad-tax
     5940     ,output varexcise
     5941     ,output varcur-vat-pc
     5942     ,output varcur-slt-pc
     5943     )  .
     5944       if varprice-sale = ?
     5945       then do:
     5946         assign
     5947           varcur-vat-pc = 0.00
     5948           varcur-slt-pc = 0.00
     5949         .
     5950       end.
     5951       create tt-clcparts .
     5952       buffer-copy buf_parts to tt-clcparts no-error .
     5953       if error-status :error
     5954       then do:
     5955         run WaitFram-Hide in this-procedure .
     5956         undo, return error "Ошибка расчета сумм по партиям" .
     5957       end.
     5958       run clcprtsl_calc-parts in this-procedure
     5959         ( input recid( tt-clcparts )
     5960         , input yes
     5961         , input yes
     5962         , input buf_doc-line.road-tax
     5963         , input buf_doc-line.excise
     5964         , input buf_doc-line.vat-pc
     5965         , input buf_doc-line.cons-vat-pc
     5966         , input buf_doc-line.slt-pc
     5967         , input buf_trn-doc.base-rate
     5968         , input buf_trn-doc.base-scale
     5969         , input varr-b
     5970         , input varcur-base
     5971         , input varcur-road-tax
     5972         , input varcur-excise
     5973         , input varcur-vat-pc
     5974         , input varcur-cons-vat-pc
     5975         , input varcur-slt-pc
     5976         ) no-error .
     5977       if error-status :error
     5978       then do:
     5979         run WaitFram-Hide in this-procedure .
     5980         undo, return error "Ошибка расчета сумм по партиям" .
     5981       end.
     5982       find first tt-allsum where
     5983                  tt-allsum.sum-type = 'основная_сумма':U .
     5984       find first buf_suppl no-lock where
     5985                  buf_suppl.supp-type = p-supp-type          and
     5986                  buf_suppl.supp-code = p-supp-code          and
     5987                  buf_suppl.orig-code = buf_trn-doc.doc-code no-error .
     5988       if not available buf_suppl
     5989       then do:
     5990         assign
     5991           j-order = j-order + 10
     5992         .
     5993         create buf_suppl .
     5994         assign
     5995           buf_suppl.order        = j-order
     5996           buf_suppl.supp-type    = p-supp-type
     5997           buf_suppl.supp-code    = p-supp-code
     5998           buf_suppl.cli-name     = ( if available buf_clients
     5999                                      then buf_clients.obj-name
     6000                                      else substitute( '&1 &2'
     6001                                                     , buf_trn-doc.doc-type
     6002                                                     , buf_trn-doc.doc-code
     6003                                                     )
     6004                                    )
     6005           buf_suppl.ext-doc-type = buf_trn-doc.ext-doc-type
     6006           buf_suppl.fact-date    = buf_trn-doc.fact-date
     6007           buf_suppl.orig-code    = buf_trn-doc.doc-code
     6008           buf_suppl.is-total     = no
     6009         .
     6010         case p-trn-doc-num :
     6011           when 1
     6012           then do:
     6013   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input buf_trn-doc.doc-code ,
     6014                           input 'nids':U ,
     6015                          output buf_suppl.doc-code ,
     6016                          output v-type ) no-error .
     6017             if error-status :error      or
     6018                buf_suppl.doc-code = "":U or
     6019                buf_suppl.doc-code = ?
     6020             then do:
     6021               assign
     6022                 buf_suppl.doc-code = '@' + buf_trn-doc.doc-code
     6023               .
     6024             end.
     6025           end.
     6026           otherwise do:
     6027             assign
     6028               buf_suppl.doc-code = buf_trn-doc.doc-code
     6029             .
     6030           end.
     6031         end case.
     6032   define variable vss-include-info41 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6033   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hold-doc in g#library
     6034     (input  buf_trn-doc.doc-code
     6035     ,output buf_suppl.is-hold-doc
     6036     ) no-error .
     6037         if error-status :error       or
     6038            buf_suppl.is-hold-doc = ?
     6039         then do:
     6040           run WaitFram-Hide in this-procedure .
     6041           undo, return error substitute( 'Ошибка определения межфирменного перемещения по документу "&1"'
     6042                                        , buf_trn-doc.doc-code
     6043                                        ) .
     6044         end.
     6045         run get-xtype-order in this-procedure
     6046           (  input buf_suppl.ext-doc-type
     6047           ,  input buf_suppl.is-hold-doc
     6048           , output buf_suppl.ext-doc-ord
     6049           , output buf_suppl.ext-doc-grp
     6050           ) .
     6051       end.
     6052       case buf_trn-doc.ext-doc-type :
     6053         when 'ie':U
     6054         then do:
     6055           assign
     6056             buf_suppl.sum-sale = buf_suppl.sum-sale +
     6057                                  ( if varr-b = "rubl" then tt-allsum.sum-dsc-rubl-cur else tt-allsum.sum-dsc-base-cur )
     6058           .
     6059         end.
     6060         otherwise do:
     6061           assign
     6062             buf_suppl.sum-sale = buf_suppl.sum-sale +
     6063                                  ( if varr-b = "rubl" then tt-allsum.sum-dsc-rubl-doc else tt-allsum.sum-dsc-base-doc )
     6064           .
     6065         end.
     6066       end case.
     6067       if buf_trn-doc.ext-doc-type = 'es':U     or
     6068          buf_trn-doc.ext-doc-type = 'rs':U or
     6069          buf_trn-doc.ext-doc-type = 'ee':U          and buf_suppl.is-hold-doc <> yes or
     6070          buf_trn-doc.ext-doc-type = 're':U      and buf_suppl.is-hold-doc <> yes
     6071       then do:
     6072         if buf_parts.purch-code = 2
     6073         then do:
     6074           find first buf_supp-vat where
     6075                      buf_supp-vat.order  = buf_suppl.order          and
     6076                      buf_supp-vat.vat-pc = buf_doc-line.cons-vat-pc no-error .
     6077           if not available buf_supp-vat
     6078           then do:
     6079             create buf_supp-vat .
     6080             assign
     6081               buf_supp-vat.order   = buf_suppl.order
     6082               buf_supp-vat.vat-pc  = buf_doc-line.cons-vat-pc
     6083               buf_supp-vat.sum-doc = 0.00
     6084               buf_supp-vat.is-tot  = no
     6085             .
     6086           end.
     6087         end.
     6088         else do:
     6089           find first buf_supp-vat where
     6090                      buf_supp-vat.order  = buf_suppl.order     and
     6091                      buf_supp-vat.vat-pc = buf_doc-line.vat-pc no-error .
     6092           if not available buf_supp-vat
     6093           then do:
     6094             create buf_supp-vat .
     6095             assign
     6096               buf_supp-vat.order   = buf_suppl.order
     6097               buf_supp-vat.vat-pc  = buf_doc-line.vat-pc
     6098               buf_supp-vat.sum-doc = 0.00
     6099               buf_supp-vat.is-tot  = no
     6100             .
     6101           end.
     6102         end.
     6103         case buf_trn-doc.ext-doc-type :
     6104           when 'ie':U
     6105           then do:
     6106             assign
     6107               buf_supp-vat.sum-doc = buf_supp-vat.sum-doc +
     6108                                      ( if varr-b = "rubl" then tt-allsum.sum-dsc-rubl-cur else tt-allsum.sum-dsc-base-cur )
     6109             .
     6110           end.
     6111           otherwise do:
     6112             assign
     6113               buf_supp-vat.sum-doc = buf_supp-vat.sum-doc +
     6114                                      ( if varr-b = "rubl" then tt-allsum.sum-dsc-rubl-doc else tt-allsum.sum-dsc-base-doc )
     6115             .
     6116           end.
     6117         end case.
     6118       end.
     6119     end.
     6120   end procedure.
     6121   procedure cr-tt-suppl-prc :
     6122     define input parameter p-parts     as recid     no-undo .
     6123     define input parameter p-supp-type as character no-undo .
     6124     define input parameter p-supp-code as integer   no-undo .
     6125     define variable varcur-fact-qnty    like ub.gds-dtl.fact-qnty     no-undo .
     6126     define variable varcur-base         like ub.gds-dtl.price-base    no-undo .
     6127     define variable varcur-road-tax     like ub.doc-line.road-tax     no-undo .
     6128     define variable varcur-excise       like ub.doc-line.excise       no-undo .
     6129     define variable varcur-vat-pc       like ub.doc-line.vat-pc       no-undo .
     6130     define variable varcur-cons-vat-pc  like ub.doc-line.cons-vat-pc  no-undo .
     6131     define variable varcur-slt-pc       like ub.doc-line.slt-pc       no-undo .
     6132     define variable varprice-sale       like ub.price-list.price-sale no-undo .
     6133     define variable vardoc-num          like ub.price-doc.doc-num     no-undo .
     6134     define variable varb-code           like ub.bar-code.b-code       no-undo .
     6135     define variable varroad-tax         like ub.price-list.road-tax   no-undo .
     6136     define variable varexcise           like ub.price-list.excise     no-undo .
     6137     define variable varlastcur-base     like ub.gds-dtl.price-base    no-undo .
     6138     define variable varlastcur-road-tax like ub.gds-dtl.price-base    no-undo .
     6139     define variable varlastcur-excise   like ub.gds-dtl.price-base    no-undo .
     6140     define variable v-trn-doc-code      like ub.trn-doc.doc-code      no-undo .
     6141     define buffer buf_parts      for ub.parts      .
     6142     define buffer buf_price-doc  for ub.price-doc  .
     6143     define buffer buf_price-list for ub.price-list .
     6144     define buffer buf_price-prev for ub.price-list .
     6145     define buffer buf_goods      for ub.goods      .
     6146     define buffer buf_sysconf    for ub.sysconf    .
     6147     define buffer buf_gds-dtl    for ub.gds-dtl    .
     6148     define buffer buf_suppl      for tt-suppl      .
     6149     define buffer buf_supp-vat   for tt-supp-vat   .
     6150     define buffer buf_clients    for ub.clients    .
     6151     do
     6152     on error undo, return error return-value
     6153     :
     6154       find first buf_parts no-lock where
     6155           recid( buf_parts ) = p-parts no-error .
     6156       if not available buf_parts
     6157       then do:
     6158         run WaitFram-Hide in this-procedure .
     6159         undo, return error "Партия не найдена" .
     6160       end.
     6161       find first g#supplier no-lock where
     6162                  g#supplier.supp-type = p-supp-type and
     6163                  g#supplier.supp-code = p-supp-code no-error .
     6164       if not available g#supplier
     6165       then do:
     6166         if p-all-suppl = yes
     6167         then do:
     6168           find first bf_clients no-lock where
     6169                      bf_clients.obj-type = buf_parts.supp-type and
     6170                      bf_clients.obj-code = buf_parts.supp-code no-error .
     6171           if available bf_clients
     6172           then do:
     6173             create g#supplier .
     6174             assign
     6175               g#supplier.supp-type = bf_clients.obj-type
     6176               g#supplier.supp-code = bf_clients.obj-code
     6177               g#supplier.supp-name = bf_clients.obj-name
     6178             .
     6179           end.
     6180         end.
     6181         else do:
     6182           run WaitFram-Hide in this-procedure .
     6183           undo, return error substitute( 'Не найден поставщик &1 &2.'
     6184                                        , p-supp-type
     6185                                        , p-supp-code
     6186                                        ) .
     6187         end.
     6188       end.
     6189       find first buf_price-doc no-lock where
     6190                  buf_price-doc.doc-num = buf_parts.out-code no-error .
     6191       if not available buf_price-doc
     6192       then do:
     6193         run WaitFram-Hide in this-procedure .
     6194         undo, return error substitute( 'Не найден документ переоценки "&1" по партии.'
     6195                                      , buf_parts.out-code
     6196                                      ) .
     6197       end.
     6198       find first buf_price-list no-lock where
     6199                  buf_price-list.doc-num    = buf_parts.out-code  and
     6200                  buf_price-list.main-price = yes                 and
     6201                  buf_price-list.artic      = buf_parts.artic     and
     6202                  buf_price-list.prod-type  = buf_parts.prod-type and
     6203                  buf_price-list.prod-code  = buf_parts.prod-code no-error .
     6204       if not available buf_price-list
     6205       then do:
     6206         run WaitFram-Hide in this-procedure .
     6207         undo, return error substitute( 'Не найдена строка переоценки "&1" по партии (&2 &3 &4).'
     6208                                      , buf_parts.out-code
     6209                                      , buf_parts.artic
     6210                                      , buf_parts.prod-type
     6211                                      , buf_parts.prod-code
     6212                                      ) .
     6213       end.
     6214       find first buf_clients no-lock where
     6215                  buf_clients.obj-type = buf_price-doc.obj-type and
     6216                  buf_clients.obj-code = buf_price-doc.obj-code no-error .
     6217       if not available buf_clients
     6218       then do:
     6219         run WaitFram-Hide in this-procedure .
     6220         undo, return error substitute( 'Не найден контрагент &1 &2 из партии переоценки "&3".'
     6221                                      , buf_price-doc.obj-type
     6222                                      , buf_price-doc.obj-code
     6223                                      , buf_price-doc.doc-num
     6224                                      ) .
     6225       end.
     6226       find first buf_suppl no-lock where
     6227                  buf_suppl.supp-type = p-supp-type          and
     6228                  buf_suppl.supp-code = p-supp-code          and
     6229                  buf_suppl.orig-code = buf_price-doc.doc-num no-error .
     6230       if not available buf_suppl
     6231       then do:
     6232         assign
     6233           j-order = j-order + 10
     6234         .
     6235         run get-supp-cli-name in this-procedure
     6236           (
     6237              input p-parts
     6238           , output v-trn-doc-code
     6239           ) no-error .
     6240         if error-status :error   or
     6241            v-trn-doc-code = "":U or
     6242            v-trn-doc-code = ?
     6243         then do:
     6244           assign
     6245             v-trn-doc-code = replace( buf_price-doc.PS, chr(10), " ":U )
     6246           .
     6247         end.
     6248         else do:
     6249           assign
     6250             v-trn-doc-code = v-trn-doc-code + " ":U + g#supplier.supp-name
     6251           .
     6252         end.
     6253         create buf_suppl .
     6254         assign
     6255           buf_suppl.order        = j-order
     6256           buf_suppl.supp-type    = p-supp-type
     6257           buf_suppl.supp-code    = p-supp-code
     6258           buf_suppl.cli-name     = replace( buf_price-doc.PS, chr(10), " ":U )
     6259           buf_suppl.ext-doc-type = 'ot':U
     6260           buf_suppl.fact-date    = buf_price-doc.fact-date
     6261           buf_suppl.doc-code     = buf_price-doc.doc-num
     6262           buf_suppl.orig-code    = buf_price-doc.doc-num
     6263           buf_suppl.is-total     = no
     6264         .
     6265         run get-xtype-order in this-procedure
     6266           (  input buf_suppl.ext-doc-type
     6267           ,  input buf_suppl.is-hold-doc
     6268           , output buf_suppl.ext-doc-ord
     6269           , output buf_suppl.ext-doc-grp
     6270           ) .
     6271       end.
     6272       find last buf_price-prev no-lock where
     6273                 buf_price-prev.obj-type   = buf_price-list.obj-type   and
     6274                 buf_price-prev.obj-code   = buf_price-list.obj-code   and
     6275                 buf_price-prev.b-code     = buf_price-list.b-code     and
     6276                 buf_price-prev.fact-order < buf_price-list.fact-order no-error .
     6277       if available buf_price-prev
     6278       then do:
     6279         assign
     6280           buf_suppl.sum-sale = buf_suppl.sum-sale +
     6281                              ( buf_price-list.price-sale - buf_price-prev.price-sale ) * buf_parts.fact-qnty
     6282         .
     6283       end.
     6284       else do:
     6285         assign
     6286           buf_suppl.sum-sale = buf_suppl.sum-sale + buf_price-list.price-sale * buf_parts.fact-qnty
     6287         .
     6288       end.
     6289     end.
     6290   end procedure.
     6291   procedure get-xtype-order :
     6292     define  input parameter p-xtype as character no-undo .
     6293     define  input parameter p-hold  as logical   no-undo .
     6294     define output parameter p-index as integer   no-undo initial 0 .
     6295     define output parameter p-group as integer   no-undo initial 0 .
     6296     do
     6297     on error undo, return error return-value
     6298     :
     6299       case p-xtype :
     6300         when 'ie':U
     6301         then do:
     6302           assign
     6303             p-index = ( if p-hold = yes then 3 else 1 )
     6304             p-group = 1
     6305           .
     6306         end.
     6307         when 'ep':U
     6308         then do:
     6309           assign
     6310             p-index = ( if p-hold = yes then 4 else 2 )
     6311             p-group = 1
     6312           .
     6313         end.
     6314         when 'iv':U
     6315         then do:
     6316           assign
     6317             p-index = 5
     6318             p-group = 1
     6319           .
     6320         end.
     6321         when 'rv':U
     6322         then do:
     6323           assign
     6324             p-index = 6
     6325             p-group = 1
     6326           .
     6327         end.
     6328         when 'we':U
     6329         then do:
     6330           assign
     6331             p-index = 7
     6332             p-group = 1
     6333           .
     6334         end.
     6335         when 'wm':U
     6336         then do:
     6337           assign
     6338             p-index = 8
     6339             p-group = 1
     6340           .
     6341         end.
     6342         when 'ee':U
     6343         then do:
     6344           assign
     6345             p-index = ( if p-hold = yes then 9 else 15 )
     6346             p-group = ( if p-hold = yes then 1 else  3 )
     6347           .
     6348         end.
     6349         when 're':U
     6350         then do:
     6351           assign
     6352             p-index = ( if p-hold = yes then 10 else 16 )
     6353             p-group = ( if p-hold = yes then  1 else  3 )
     6354           .
     6355         end.
     6356         when 'ev':U
     6357         then do:
     6358           assign
     6359             p-index = 11
     6360             p-group =  1
     6361           .
     6362         end.
     6363         when 'vt':U
     6364         then do:
     6365           assign
     6366             p-index = 12
     6367             p-group =  2
     6368           .
     6369         end.
     6370         when 'vp':U
     6371         then do:
     6372           assign
     6373             p-index = 13
     6374             p-group =  2
     6375           .
     6376         end.
     6377         when 'ot':U
     6378         then do:
     6379           assign
     6380             p-index = 14
     6381             p-group =  2
     6382           .
     6383         end.
     6384         when 'es':U
     6385         then do:
     6386           assign
     6387             p-index = 17
     6388             p-group =  3
     6389           .
     6390         end.
     6391         when 'rs':U
     6392         then do:
     6393           assign
     6394             p-index = 18
     6395             p-group =  3
     6396           .
     6397         end.
     6398       end case.
     6399     end.
     6400   end procedure.
     6401   procedure get-xtype-name :
     6402     define  input parameter p-num  as integer   no-undo .
     6403     define output parameter p-name as character no-undo initial "":U .
     6404     define variable v-list as character no-undo .
     6405     do
     6406     on error undo, return error return-value
     6407     :
     6408       assign
     6409         v-list = 'Приход внешний,Возврат поставщику,Приход межфирменный,Возврат поставщику между фирмами,':U      +
     6410                  'Приход внутренний,Возврат внутренний,Списание,Списание в производство,Расход межфирменный,':U   +
     6411                  'Возврат от покупателя между фирмами,Расход внутренний,Инвентаризация,Пересортица,Переоценка,':U +
     6412                  'Расход внешний,Возврат от покупателя,Расход через ККМ,Возврат от покупателя через ККМ':U
     6413       .
     6414       if p-num >=  1 and
     6415          p-num <= 18
     6416       then do:
     6417         assign
     6418           p-name = trim( string( p-num, ">9":U ) ) + ". ":U + entry( p-num, v-list )
     6419         .
     6420       end.
     6421     end.
     6422   end procedure.
     6423   procedure get-supp-rest :
     6424     define  input parameter p-supp-type  as character no-undo .
     6425     define  input parameter p-supp-code  as integer   no-undo .
     6426     define  input parameter p-rest-type  as character no-undo .
     6427     define  input parameter p-fact-order as decimal   no-undo .
     6428     define output parameter p-rest-sum   as decimal   no-undo .
     6429     define output parameter p-rest-qnty  as decimal   no-undo .
     6430     define variable j_bar-code      as integer   no-undo .
     6431     define variable j_root-bar-code as integer   no-undo .
     6432     define variable v_doc-num-price as character no-undo .
     6433     define variable d_price-sale    as decimal   no-undo .
     6434     define variable d_road-tax      as decimal   no-undo .
     6435     define variable d_excise        as decimal   no-undo .
     6436     define buffer bf_prt-obj       for ub.prt-obj       .
     6437     define buffer bf_bar-code      for ub.bar-code      .
     6438     define buffer bf_goods         for ub.goods         .
     6439     define buffer bf_stk-supp-line for ub.stk-supp-line .
     6440     do
     6441     on error undo, return error return-value
     6442     :
     6443       case p-rest-type :
     6444         when "start":U
     6445         then do:
     6446           for each bf_prt-obj no-lock where
     6447                    bf_prt-obj.obj-type = p-obj-type and
     6448                    bf_prt-obj.obj-code = p-obj-code
     6449           break by bf_prt-obj.prod-type
     6450                 by bf_prt-obj.prod-code
     6451                 by bf_prt-obj.artic
     6452                 by bf_prt-obj.prt-code
     6453           :
     6454             find last bf_stk-supp-line no-lock where
     6455                       bf_stk-supp-line.obj-type    = bf_prt-obj.obj-type  and
     6456                       bf_stk-supp-line.obj-code    = bf_prt-obj.obj-code  and
     6457                       bf_stk-supp-line.cli-type    = p-supp-type          and
     6458                       bf_stk-supp-line.cli-code    = p-supp-code          and
     6459                       bf_stk-supp-line.artic       = bf_prt-obj.artic     and
     6460                       bf_stk-supp-line.prod-type   = bf_prt-obj.prod-type and
