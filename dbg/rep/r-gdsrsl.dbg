     5220                 for each tt-supp-vat no-lock where
     5221                          tt-supp-vat.order  = tt-suppl.order
     5222                 break by tt-supp-vat.vat-pc descending
     5223                 :
     5224                   assign
     5225                     j-supp-vat-ord = j-supp-vat-ord +  1
     5226                     j-add-length   = j-add-length   + 13
     5227                     v-tmp-string   = Centering( string( tt-supp-vat.vat-pc, ">>9.<<":U ) + "% НДС", 13 )
     5228                     v-tmp-string   = replace( v-tmp-string, ".%", "%" )
     5229                     Header-Line1   = Header-Line1 + "--------------"
     5230                     Header-Line4   = Header-Line4 + "--------------"
     5231                     Header-Line5   = Header-Line5 + v-tmp-string + fill( " ":U, 13 - length( v-tmp-string ) ) + ":"
     5232                     Header-Line6   = Header-Line6 + "-------------:"
     5233                     Header-Line7   = Header-Line7 + substring( Centering( string( j-supp-vat-ord + 4 ), 13 ) + fill( " ":U, 13 ), 1, 13 ) + ":"
     5234                     Header-Line8   = Header-Line8 + "-------------:"
     5235                   .
     5236                 end.
     5237               end.
     5238               assign
     5239                 j-supp-vat-ord = j-supp-vat-ord +  1
     5240                 j-add-length   = j-add-length   + 13
     5241                 v-tmp-string   = Centering( string( j-supp-vat-ord + 4 ), 13 )
     5242                 Header-Line1   = Header-Line1 + "-------------"
     5243                 Header-Line2   = Centering(         "Стоимость",         j-add-length + j-supp-vat-ord - 1 )
     5244                 Header-Line3   = Centering( "(сумма в ценах документа)", j-add-length + j-supp-vat-ord - 1 )
     5245                 Header-Line4   = Header-Line4 + "-------------"
     5246                 Header-Line5   = Header-Line5 + "    Итого    "
     5247                 Header-Line6   = Header-Line6 + "-------------"
     5248                 Header-Line7   = Header-Line7 + v-tmp-string + fill( " ":U, 13 - length( v-tmp-string ) ) + ":"
     5249                 Header-Line8   = Header-Line8 + "-------------"
     5250               .
