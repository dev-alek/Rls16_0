     5330               .
     5331               put stream text_out unformatted
     5332                  ": " + string( string( j-npp,              ">>>>9":U                 ), "x(5)":U )  +
     5333                 " :"  + string(         tt-suppl.cli-name,  "x(40)":U                 )              +
     5334                  ": " + string( string( tt-suppl.fact-date, "99/99/9999":U            ), "x(10)":U ) +
     5335                  ":"  + string(         tt-suppl.doc-code,  "x(15)":U                 )              +
     5336                  ":"  + string( string( d_doc-sum-sale,     "->,>>>,>>>,>>>,>>9.99":U ), "x(21)":U ) + ":" skip
     5337               .
     5338               assign
     5339                 d_doc-sum-sale = 0.00
     5340               .
     5341             end.
     5342           end.
     5343           when 2
     5344           then do:
     5345             assign
     5346               d_doc-sum-sale = d_doc-sum-sale + tt-suppl.sum-sale
     5347             .
     5348             if last-of( tt-suppl.doc-code ) or
     5349                last-of( tt-suppl.cli-name ) and
     5350                tt-suppl.ext-doc-ord = 14
     5351             then do:
     5352               assign
     5353                 j-npp = j-npp + 1
     5354               .
     5355               put stream text_out unformatted
     5356                  ": " + string( string( j-npp,              ">>>>9":U                 ), "x(5)":U  ) +
     5357                 " :"  + string(         tt-suppl.cli-name,  "x(40)":U                 )              +
     5358                  ": " + string( string( tt-suppl.fact-date, "99/99/9999":U            ), "x(10)":U ) +
     5359                  ":"  + string(         tt-suppl.doc-code,  "x(15)":U                 )              +
     5360                  ":"  + string( string( d_doc-sum-sale,     "->,>>>,>>>,>>>,>>9.99":U ), "x(21)":U ) + ":" skip
     5361               .
     5362               assign
     5363                 d_doc-sum-sale = 0.00
     5364               .
     5365             end.
     5366           end.
     5367           when 3
     5368           then do:
     5369             assign
     5370               d_doc-sum-sale = d_doc-sum-sale + tt-suppl.sum-sale
     5371             .
     5372             if last-of( tt-suppl.doc-code )
     5373             then do:
     5374               assign
