     2921   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcprcex in g#library
     2922     (input  bf_trn-doc.obj-type
     2923     ,input  bf_trn-doc.obj-code
     2924     ,input  varb-code
     2925     ,input  0
     2926     ,input  bf_trn-doc.fact-order
     2927     ,output vardoc-num
     2928     ,output varprice-sale
     2929     ,output varroad-tax
     2930     ,output varexcise
     2931     ,output varcur-vat-pc
     2932     ,output varcur-slt-pc
     2933     )  .
     2934       if varprice-sale = ?
     2935       then do:
     2936         assign
     2937           varcur-vat-pc = 0
     2938           varcur-slt-pc = 0
     2939         .
     2940       end.
     2941   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2942   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     2943     (input  bf_goods.gds-code
     2944     ,input  '1':U
     2945     ,input  bf_trn-doc.fact-date
     2946     ,input  bf_trn-doc.host-code
     2947     ,input  bf_trn-doc.obj-type
     2948     ,input  bf_trn-doc.obj-code
     2949     ,output varcur-vat-pc
     2950     ) no-error .
     2951       if varcur-vat-pc = ?
     2952       then do:
     2953         return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3 документ &4", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code, bf_trn-doc.doc-code).
     2954       end.
     2955       if varcur-slt-pc = ?
     2956       then do:
     2957         return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3 документ &4", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code, bf_trn-doc.doc-code).
     2958       end.
     2959       v-calcbypart = no.
     2960       if bf_doc-line.whole-send-news = integer('1':U)   then
     2961       v-calcbypart = yes.
     2962       else do:
     2963       for each bf_gds-dtl no-lock
     2964         where bf_gds-dtl.doc-code  = bf_doc-line.doc-code
     2965           and bf_gds-dtl.artic     = bf_doc-line.artic
     2966           and bf_gds-dtl.prod-type = bf_doc-line.prod-type
     2967           and bf_gds-dtl.prod-code = bf_doc-line.prod-code
     2968       on error undo, return error return-value
     2969       :
     2970   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     2971     (input  bf_goods.gds-code
     2972     ,input  bf_gds-dtl.prt-code
     2973     ,output varb-code
     2974     ) no-error .
     2975   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2976   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     2977     (input  bf_trn-doc.obj-type
     2978     ,input  bf_trn-doc.obj-code
     2979     ,input  varb-code
     2980     ,input  0
     2981     ,input  bf_trn-doc.fact-order
     2982     ,output vardoc-num
     2983     ,output varprice-sale
     2984     ,output varroad-tax
     2985     ,output varexcise
     2986     )  .
     2987             if varprice-sale = ?
     2988             then do:
     2989               assign
     2990                 varprice-sale = 0
     2991                 varroad-tax   = 0
     2992                 varexcise     = 0
     2993               .
     2994             end.
     2995             assign
     2996               varlastcur-base     = varprice-sale
     2997               varlastcur-road-tax = varroad-tax
     2998               varlastcur-excise   = varexcise
     2999               varcur-base         = varcur-base      + varprice-sale * bf_gds-dtl.fact-qnty
     3000               varcur-road-tax     = varcur-road-tax  + varroad-tax   * bf_gds-dtl.fact-qnty
     3001               varcur-excise       = varcur-excise    + varexcise     * bf_gds-dtl.fact-qnty
     3002               varcur-fact-qnty    = varcur-fact-qnty + bf_gds-dtl.fact-qnty
     3003             .
     3004         end.
     3005       end.
     3006       if varcur-fact-qnty = 0 then do:
     3007         assign
     3008           varcur-base      = varlastcur-base
     3009           varcur-road-tax  = varlastcur-road-tax
     3010           varcur-excise    = varlastcur-excise
     3011         .
     3012       end.
     3013       else do:
     3014         assign
     3015           varcur-base      = varcur-base      / varcur-fact-qnty
     3016           varcur-road-tax  = varcur-road-tax  / varcur-fact-qnty
     3017           varcur-excise    = varcur-excise    / varcur-fact-qnty
     3018         .
     3019       end.
     3020       if varcur-vat-pc = ?
     3021       then do:
     3022         return error substitute ("Нет текущего продажного НДС по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     3023       end.
     3024       if varcur-slt-pc = ?
     3025       then do:
     3026         return error substitute ("Нет текущего продажного НП по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     3027       end.
     3028       find first bf_sysconf where bf_sysconf.host-code = bf_trn-doc.host-code no-lock.
     3029       assign
     3030         varcur-cons-vat-pc = bf_sysconf.cons-vat-pc.
     3031       if varcur-cons-vat-pc = ? then do:
     3032         return error substitute ("Нет текущего продажного консигнационного НДС по фирме &1", bf_trn-doc.host-code).
     3033       end.
     3034       define buffer buf_tt-clcparts for tt-clcparts .
     3035       for each buf_tt-clcparts
     3036       on error undo, return error return-value
     3037       :
     3038         delete buf_tt-clcparts.
     3039       end.
     3040       for each bf_parts no-lock
     3041         where bf_parts.out-code  = bf_doc-line.doc-code
     3042           and bf_parts.obj-type  = bf_doc-line.obj-type
     3043           and bf_parts.obj-code  = bf_doc-line.obj-code
     3044           and bf_parts.artic     = bf_doc-line.artic
     3045           and bf_parts.prod-type = bf_doc-line.prod-type
     3046           and bf_parts.prod-code = bf_doc-line.prod-code
     3047       on error undo, return error return-value
     3048       :
     3049         create buf_tt-clcparts .
     3050         buffer-copy bf_parts to buf_tt-clcparts .
     3051         if v-calcbypart = yes   then do:
     3052   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run partbcod in g#library
     3053     (buffer bf_parts
     3054     ,output v-b-pcode
     3055     ) no-error .
     3056   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3057   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     3058     (input  bf_parts.obj-type
     3059     ,input  bf_parts.obj-code
     3060     ,input  v-b-pcode
     3061     ,input  0
     3062     ,input  bf_trn-doc.fact-order
     3063     ,output vardoc-num
     3064     ,output varprice-salef
     3065     ,output varroad-tax
     3066     ,output varexcise
     3067     ) no-error .
     3068             if varprice-sale = ?
     3069             then do:
     3070               assign
     3071                 varprice-salef = 0
     3072                 varroad-tax   = 0
     3073                 varexcise     = 0
     3074               .
     3075             end.
     3076             assign
     3077             part-cur-base  = varprice-salef
     3078             part-cur-road-tax  = varroad-tax
     3079             part-cur-excise = varexcise.
     3080         end.
     3081       end.
     3082       run clcprtsl_calc-ttable in this-procedure
     3083         (input yes,
     3084          input yes,
     3085          input bf_doc-line.road-tax,
     3086          input bf_doc-line.excise,
     3087          input bf_doc-line.vat-pc,
     3088          input bf_doc-line.cons-vat-pc,
     3089          input bf_doc-line.slt-pc,
     3090          input bf_trn-doc.base-rate,
     3091          input bf_trn-doc.base-scale,
     3092          input varr-b,
     3093          input varcur-base,
     3094          input varcur-road-tax,
     3095          input varcur-excise,
     3096          input varcur-vat-pc,
     3097          input varcur-cons-vat-pc,
     3098          input varcur-slt-pc
     3099          ) no-error.
     3100       if error-status:error then do:
     3101         message
     3102           vss-workfile vss-revision vss-description skip
     3103           "Ошибка при вызове процедуры clcprtsl_calc-ttable." skip
     3104           return-value skip
     3105           trim(error-status :get-message(1))
     3106           trim(error-status :get-message(2))
     3107           trim(error-status :get-message(3))
     3108           trim(error-status :get-message(4))
     3109           trim(error-status :get-message(5)) skip
     3110           view-as alert-box error.
     3111         undo, return error .
     3112       end.
     3113     end.
     3114   end.
     3115   end.
     3116   procedure clcprtsl_calc-ttable :
     3117   define input parameter paris-doc           as   logical                 no-undo.
     3118   define input parameter paris-cur           as   logical                 no-undo.
     3119   define input parameter parroad-tax         like ub.doc-line.road-tax    no-undo.
     3120   define input parameter parexcise           like ub.doc-line.excise      no-undo.
     3121   define input parameter parvat-pc           like ub.doc-line.vat-pc      no-undo.
     3122   define input parameter parcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     3123   define input parameter parslt-pc           like ub.doc-line.slt-pc      no-undo.
     3124   define input parameter parbase-rate        like ub.trn-doc.base-rate    no-undo.
     3125   define input parameter parbase-scale       like ub.trn-doc.base-scale   no-undo.
     3126   define input parameter parr-b              as   character               no-undo.
     3127   define input parameter parcur-base         like ub.gds-dtl.cur-base     no-undo.
     3128   define input parameter parcur-road-tax     like ub.doc-line.road-tax    no-undo.
     3129   define input parameter parcur-excise       like ub.doc-line.excise      no-undo.
     3130   define input parameter parcur-vat-pc       like ub.doc-line.vat-pc      no-undo.
     3131   define input parameter parcurcons-vat-pc   like ub.doc-line.cons-vat-pc no-undo.
     3132   define input parameter parcurslt-pc        like ub.doc-line.slt-pc      no-undo.
     3133   define buffer bf_tt-allsum      for tt-allsum.
     3134   define buffer bf_tt-clcparts    for tt-clcparts.
     3135   define buffer bf_tt-allsum-line for tt-allsum-line.
     3136   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     3137   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     3138   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     3139   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     3140   define variable varexcise          like ub.price-list.excise     no-undo.
     3141   do on error undo, return error return-value :
     3142   for each bf_tt-allsum-line
     3143   on error undo, return error return-value
     3144    :
     3145     delete bf_tt-allsum-line.
     3146   end.
     3147   for each bf_tt-allsum
     3148   on error undo, return error return-value
     3149   :
     3150     delete bf_tt-allsum.
     3151   end.
     3152   for each bf_tt-clcparts
     3153   on error undo, return error return-value
     3154   :
     3155   if v-calcbypart then do:
     3156             assign
     3157             parcur-base =   bf_tt-clcparts.part-cur-base
     3158             parcur-road-tax = bf_tt-clcparts.part-cur-road-tax
     3159             parcur-excise =   bf_tt-clcparts.part-cur-excise
     3160             .
     3161   end.
     3162      run clcprtsl_calc-parts in this-procedure (
     3163        input recid(bf_tt-clcparts),
     3164        input paris-doc,
     3165        input paris-cur,
     3166        input parroad-tax,
     3167        input parexcise,
     3168        input parvat-pc,
     3169        input parcons-vat-pc,
     3170        input parslt-pc,
     3171        input parbase-rate,
     3172        input parbase-scale,
     3173        input parr-b,
     3174        input parcur-base,
     3175        input parcur-road-tax,
     3176        input parcur-excise,
     3177        input parcur-vat-pc,
     3178        input parcurcons-vat-pc,
     3179        input parcurslt-pc
     3180        ) no-error.
     3181     if error-status:error then do:
     3182       message
     3183         vss-workfile vss-revision vss-description skip
     3184         vss-include-info13 skip
     3185         "Ошибка при обсчете партии" skip
     3186         "Документ партии " bf_tt-clcparts.out-code skip
     3187         "Товар" bf_tt-clcparts.artic bf_tt-clcparts.prod-type bf_tt-clcparts.prod-code skip
     3188         return-value skip
     3189         error-status:get-message(1) skip
     3190         error-status:get-message(2) skip
     3191         error-status:get-message(3) skip
     3192         view-as alert-box error .
     3193       undo, return error .
     3194     end.
     3195     for each bf_tt-allsum on error undo, return error return-value :
     3196       find first bf_tt-allsum-line where bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type no-error.
     3197       if not available bf_tt-allsum-line then do:
     3198         create bf_tt-allsum-line.
     3199         assign
     3200           bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type.
     3201       end.
