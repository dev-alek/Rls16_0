     3260   end.
     3261   end procedure.
     3262   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3263   procedure cur-time :
     3264      define output parameter p-today as date      no-undo .
     3265      define output parameter p-time  as integer   no-undo .
     3266     do
     3267     on error undo, return error
     3268     :
     3269       define variable v-date1 as date      no-undo .
     3270       define variable v-date2 as date      no-undo .
     3271       define variable v-time  as integer   no-undo .
     3272       assign
     3273         v-date1 = today
     3274         v-time  = time
     3275         v-date2 = today
     3276       .
     3277       if v-date1 <> v-date2
     3278       then do:
     3279         assign
     3280           v-date1 = today
     3281           v-time  = v-time
     3282         .
     3283       end.
     3284       assign
     3285         p-today = v-date1
     3286         p-time  = v-time
     3287       .
     3288     end.
     3289   end.
     3290   function cur-time-date returns character
     3291   :
     3292     return string(today, '99/99/9999':U) .
     3293   end.
     3294   function cur-time-mjd returns decimal
     3295   :
     3296     define variable v-date as date      no-undo .
     3297     define variable v-time as integer   no-undo .
     3298     run cur-time in this-procedure
     3299       (output v-date
     3300       ,output v-time
     3301       ) .
     3302     return integer(v-date) - 2400002 + (v-time / 86400) .
     3303   end.
     3304   function cur-time-get-ending-index returns integer
     3305   (input p-number as integer
     3306   )
     3307   :
     3308     if p-number < 0
     3309     or p-number = ?
     3310     then do:
     3311       return 1 .
     3312     end.
     3313     define variable v-rest as integer   no-undo .
     3314     assign
     3315       p-number = p-number modulo 100
     3316     .
     3317     if p-number < 20
     3318     then do:
     3319       assign
     3320         v-rest = p-number
     3321       .
     3322     end.
     3323     else do:
     3324       assign
     3325         v-rest = p-number modulo 10
     3326       .
     3327     end.
     3328     case v-rest :
     3329       when 1
     3330       then do:
     3331         return 2 .
     3332       end.
     3333       when 2 or
     3334       when 3 or
     3335       when 4
     3336       then do:
     3337         return 3 .
     3338       end.
     3339       otherwise do:
     3340         return 1 .
     3341       end.
     3342     end case .
     3343   end.
     3344   procedure cur-time-mjd-to-date :
     3345      define input  parameter i-mjd-diff as decimal no-undo.
     3346      define output parameter o-Date     as date    no-undo.
     3347      define output parameter o-Time     as integer no-undo.
     3348      define variable v-day-number as integer   no-undo .
     3349      if    i-mjd-diff < 0
     3350         or i-mjd-diff = ?
     3351      then do:
     3352         return "?" .
     3353      end.
     3354      assign
     3355         v-day-number = truncate(i-mjd-diff,0).
     3356         o-Date = date(v-day-number + 2400002).
     3357         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     3358     .
     3359   end.
     3360   function cur-time-mjd-to-string returns character
     3361   (input p-mjd-diff as decimal
     3362   )
     3363   :
     3364     define variable v-day-number as integer   no-undo .
     3365     define variable v-seconds    as integer   no-undo .
     3366     define variable v-hour       as integer   no-undo .
     3367     define variable v-min        as integer   no-undo .
     3368     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     3369     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     3370     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     3371     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     3372     if p-mjd-diff < 0
     3373     or p-mjd-diff = ?
     3374     then do:
     3375       return "?" .
     3376     end.
     3377     assign
     3378       v-day-number = integer(truncate(p-mjd-diff,0))
     3379       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     3380     .
     3381     if v-seconds > 86400
     3382     then do:
     3383       assign
     3384         v-seconds = 86400 - 1
     3385       .
     3386     end.
     3387     if v-seconds < 0
     3388     then do:
     3389       assign
     3390         v-seconds = 0
     3391       .
     3392     end.
     3393     assign
     3394       v-hour = truncate(v-seconds / 3600, 0)
     3395     .
     3396     assign
     3397       v-seconds = v-seconds modulo 3600
     3398     .
     3399     assign
     3400       v-min = truncate(v-seconds / 60, 0)
     3401     .
     3402     assign
     3403       v-seconds = v-seconds modulo 60
     3404     .
     3405     return
     3406         (if v-day-number <> 0
     3407           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     3408           else ""
     3409         )
     3410       + (if v-day-number <> 0 or v-hour <> 0
     3411           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     3412           else ""
     3413         )
     3414       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     3415           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     3416           else ""
     3417         )
     3418       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     3419       .
     3420   end.
     3421   function cur-time-string returns character
     3422   :
     3423     define variable v-date as date      no-undo .
     3424     define variable v-time as integer   no-undo .
     3425     run cur-time in this-procedure
     3426       (output v-date
     3427       ,output v-time
     3428       ) .
     3429     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     3430   end.
     3431   function cur-time-string-sec returns character
     3432   :
     3433     define variable v-date as date      no-undo .
     3434     define variable v-time as integer   no-undo .
     3435     run cur-time in this-procedure
     3436       (output v-date
     3437       ,output v-time
     3438       ) .
     3439     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     3440   end.
     3441   function cur-time-custom  returns character
     3442   (input p-prefix as character
     3443   ,input p-date-format as character
     3444   ,input p-delimiter as character
     3445   ,input p-time-format as character
     3446   ,input p-suffix as character
     3447   )
     3448   :
     3449     define variable v-date as date      no-undo .
     3450     define variable v-time as integer   no-undo .
     3451     run cur-time in this-procedure
     3452       (output v-date
     3453       ,output v-time
     3454       ) .
     3455     return
     3456       p-prefix
     3457       + string(v-date, p-date-format)
     3458       + p-delimiter
     3459       + string(v-time, p-time-format)
     3460       + p-suffix
     3461       .
     3462   end.
     3463   function cur-time-print  returns character
     3464   :
     3465     define variable v-date as date      no-undo .
     3466     define variable v-time as integer   no-undo .
     3467     run cur-time in this-procedure
     3468       (output v-date
     3469       ,output v-time
     3470       ) .
     3471     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     3472   end.
     3473   function cur-time-datetime returns datetime
     3474   :
     3475     define variable v-char as character no-undo .
     3476     define variable v-datetime as datetime no-undo .
     3477     v-char = cur-time-string().
     3478     v-datetime = datetime(v-char).
     3479     return  v-datetime.
     3480   end.
     3481   function cur-time-string-msec returns character
     3482   :
     3483     define variable v-date as datetime  no-undo .
     3484     v-date = now.
     3485     return string(v-date) .
     3486   end.
     3487   FUNCTION Sparse RETURNS CHARACTER ( INPUT p-instring AS CHARACTER ) :
     3488     DEFINE VARIABLE v-outstring AS CHARACTER NO-UNDO.
     3489     RUN get-sparsed-string IN THIS-PROCEDURE ( INPUT p-instring, OUTPUT v-outstring ) NO-ERROR.
     3490     RETURN ( IF ERROR-STATUS :ERROR THEN p-instring ELSE v-outstring ).
     3491   END FUNCTION.
     3492   PROCEDURE get-sparsed-string :
     3493     DEFINE  INPUT PARAMETER p-instring  AS CHARACTER NO-UNDO.
     3494     DEFINE OUTPUT PARAMETER p-outstring AS CHARACTER NO-UNDO INITIAL "":U.
     3495     DEFINE VARIABLE jj AS INTEGER NO-UNDO.
     3496     DO ON ERROR UNDO, RETURN ERROR :
     3497       DO jj = 1 TO LENGTH( p-instring ) :
     3498         ASSIGN p-outstring = p-outstring + ( IF p-outstring = "":U THEN "":U ELSE " ":U ) + SUBSTRING( p-instring, jj, 1 ).
     3499       END.
     3500       ASSIGN p-outstring = CAPS( TRIM( p-outstring ) ).
     3501     END.
     3502   END PROCEDURE.
     3503   FUNCTION Centering RETURNS CHARACTER ( INPUT i-string AS CHARACTER, INPUT i-length AS INTEGER ) :
     3504     DEFINE VARIABLE v-outstring AS CHARACTER NO-UNDO.
     3505     RUN get-centre-string IN THIS-PROCEDURE ( INPUT i-string, INPUT i-length, OUTPUT v-outstring ) NO-ERROR.
     3506     RETURN ( IF ERROR-STATUS :ERROR THEN i-string ELSE v-outstring ).
     3507   END FUNCTION.
     3508   PROCEDURE get-centre-string :
     3509     DEFINE  INPUT PARAMETER p-instring  AS CHARACTER NO-UNDO.
     3510     DEFINE  INPUT PARAMETER p-length    AS INTEGER   NO-UNDO.
     3511     DEFINE OUTPUT PARAMETER p-outstring AS CHARACTER NO-UNDO INITIAL "":U.
     3512     DEFINE VARIABLE j-format AS INTEGER NO-UNDO.
     3513     DEFINE VARIABLE j-left   AS INTEGER NO-UNDO.
     3514     DO ON ERROR UNDO, RETURN ERROR :
     3515       ASSIGN p-instring = TRIM(   p-instring )
     3516              j-format   = LENGTH( p-instring ).
     3517       IF           j-format > p-length THEN DO:
     3518         ASSIGN p-outstring = SUBSTRING( p-instring, 1, p-length ).
     3519       END. ELSE IF j-format < p-length THEN DO:
     3520         ASSIGN j-left      = INTEGER( ( p-length - ( j-format + 1 ) ) * 0.5 )
     3521                p-outstring = FILL( " ":U, j-left ) + p-instring + FILL( " ":U, p-length - ( j-left + j-format ) ).
     3522       END.                             ELSE DO:
     3523         ASSIGN p-outstring = p-instring.
     3524       END.
     3525     END.
     3526   END PROCEDURE.
     3527   FUNCTION ShiftRight RETURNS CHARACTER ( INPUT i-string AS CHARACTER, INPUT i-length AS INTEGER ) :
     3528     DEFINE VARIABLE v-outstring AS CHARACTER NO-UNDO.
     3529     RUN get-right-string IN THIS-PROCEDURE ( INPUT i-string, INPUT i-length, OUTPUT v-outstring ) NO-ERROR.
     3530     RETURN ( IF ERROR-STATUS :ERROR THEN i-string ELSE v-outstring ).
     3531   END FUNCTION.
     3532   PROCEDURE get-right-string :
     3533     DEFINE  INPUT PARAMETER p-instring  AS CHARACTER NO-UNDO.
     3534     DEFINE  INPUT PARAMETER p-length    AS INTEGER   NO-UNDO.
     3535     DEFINE OUTPUT PARAMETER p-outstring AS CHARACTER NO-UNDO INITIAL "":U.
     3536     DEFINE VARIABLE j-format AS INTEGER NO-UNDO.
     3537     DO ON ERROR UNDO, RETURN ERROR :
     3538       ASSIGN p-instring = TRIM(   p-instring )
     3539              j-format   = LENGTH( p-instring ).
     3540       IF           j-format > p-length THEN DO:
     3541         ASSIGN p-outstring = SUBSTRING( p-instring, 1, p-length ).
     3542       END. ELSE IF j-format < p-length THEN DO:
     3543         ASSIGN p-outstring = FILL( " ":U, p-length - j-format ) + p-instring.
     3544       END.                             ELSE DO:
     3545         ASSIGN p-outstring = p-instring.
     3546       END.
     3547     END.
     3548   END PROCEDURE.
