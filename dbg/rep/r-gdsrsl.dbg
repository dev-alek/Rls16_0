     3674   procedure prn-lib-prn-file :
     3675     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     3676     define input parameter p-DIsabledoptions as integer no-undo .
     3677     define variable v-report-name as character no-undo .
     3678     define variable v-user-action as character no-undo .
     3679     define variable v-printed     as logical   no-undo .
     3680     define variable v-exist       as logical   no-undo .
     3681     do
     3682       on error undo, return error
     3683       :
     3684       run prn-lib-get-report-name  in this-procedure (
     3685         input parParentProc
     3686         ,output v-report-name
     3687         ).
     3688   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3689   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     3690     (input  v-report-name
     3691     ,input  2
     3692     ,output v-exist
     3693     )  .
     3694       if NOT v-exist then
     3695       DO:
     3696         Message
     3697           "Нет заданий на печать ! "
     3698           view-as alert-box .
     3699         Return  .
     3700       End.
     3701       run gbl/prnfilen.w
     3702         (input  ""
     3703         ,input  p-DisabledOptions
     3704         ,input  string(v-report-name )
     3705         ,input  7
     3706         ,output v-user-action
     3707         ,output v-printed
     3708         ) .
     3709       if v-printed then
     3710       do:
     3711         return "YES" .
     3712       end.
     3713       else
     3714       do:
     3715         return "NO" .
     3716       end.
     3717     end.
     3718   end procedure.
     3719   procedure prn-lib-open-stream :
     3720     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     3721     define input parameter p-page-size    as integer no-undo .
     3722     define input parameter p-is-stream    as logical no-undo .
     3723     define input parameter p-append       as logical no-undo .
     3724     define variable v-report-name as character no-undo .
     3725     do
     3726       on error undo, return error
     3727       :
     3728       run prn-lib-get-report-name  in this-procedure (
     3729         input parParentProc
     3730         ,output v-report-name
     3731         ).
     3732       if p-is-stream then
     3733       do:
     3734         if p-append then
     3735         do:
     3736           output stream text_out to value( v-report-name )
     3737             page-size value(p-page-size) append .
     3738         end.
     3739         if not p-append then
     3740         do:
     3741           output stream text_out to value( v-report-name )
     3742             page-size value(p-page-size) .
     3743         end.
     3744       end.
     3745       if not p-is-stream then
     3746       do:
     3747         if p-append then
     3748         do:
     3749           output to value( v-report-name )
     3750             page-size value(p-page-size) append .
     3751         end.
     3752         if not p-append then
     3753         do:
     3754           output to value( v-report-name )
     3755             page-size value(p-page-size) .
     3756         end.
     3757       end.
     3758     end.
     3759   end procedure.
     3760   procedure prn-lib-open-exp :
     3761     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     3762     define input parameter p-is-stream    as logical no-undo .
     3763     define input parameter p-is-append    as logical no-undo .
     3764     define output parameter p-ReportFileName as char init "report" no-undo.
     3765     define output parameter p-process as logical no-undo .
     3766     define variable glog as logical no-undo .
     3767     do
     3768       on error undo, return error
     3769       :
     3770       SYSTEM-DIALOG GET-FILE p-ReportFileName
     3771         TITLE      "Укажите путь"
     3772         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     3773         ASK-OVERWRITE
     3774         CREATE-TEST-FILE
     3775         SAVE-AS
     3776         USE-FILENAME
     3777         DEFAULT-EXTENSION "txt"
     3778         UPDATE glog
     3779         .
     3780       if not glog then  return.
     3781       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     3782       if p-is-stream then
     3783       do:
     3784         if p-is-append then
     3785         do:
     3786           OUTPUT stream text_out TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     3787         end.
     3788         else
     3789         do:
     3790           OUTPUT stream text_out TO value ( p-ReportFileName ) PAGE-SIZE 0.
     3791         end.
     3792       end.
     3793       else
     3794       do:
     3795         if p-is-append then
     3796         do:
     3797           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     3798         end.
     3799         else
     3800         do:
     3801           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     3802         end.
     3803       end.
     3804       p-process = yes.
     3805     end.
     3806   end procedure.
     3807   procedure prn-lib-get-report-name :
     3808     define input parameter parParentProc  as widget-handle no-undo.
     3809     define output parameter p-report-name as character no-undo .
     3810     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     3811   end procedure.
     3812   procedure prn-lib-reportviewer-report-name :
     3813     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     3814     define input parameter p-report-name-html as character no-undo .
     3815     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
     3816   end procedure.
     3817   procedure prn-lib-reportviewer :
     3818     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     3819     define input parameter p-report-name-html as character no-undo .
     3820     define input parameter p-param        as character no-undo .
     3821     define variable v-excel           as character no-undo init 'TRUE' .
     3822     define variable v-value-character as character no-undo .
     3823     define variable v-value-integer   as character no-undo .
     3824     define variable v-value-date      as date      no-undo .
     3825     define variable v-value-decimal   as decimal   no-undo .
     3826     define variable rep-excel         as logical   no-undo .
     3827     define variable excel-string      as character no-undo .
     3828     define variable v-param-type      as character no-undo .
     3829     define variable v-tth             as handle    no-undo .
     3830     run adm/shattri.p (
     3831       input "get":U
     3832       ,input  ""
     3833       ,input  0
     3834       ,input  'report-glob':U
     3835       ,input  'rep-excel':U
     3836       ,output v-value-character
     3837       ,output v-value-date
     3838       ,output v-value-decimal
     3839       ,output v-value-integer
     3840       ,output rep-excel
     3841       ,output v-param-type
     3842       ,INPUT-OUTPUT table-handle v-tth
     3843       )  .
     3844     if rep-excel then v-excel = "TRUE" .
     3845     else v-excel = "FALSE" .
     3846     if p-param eq ""
     3847     then
     3848        p-param = "EXCEL:" + v-excel.
     3849     else
     3850        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     3851     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     3852   end procedure.
     3853   form header
     3854     Centering( Sparse( "Товарный отчет (реестр документов) по поставщикам" ), 123 ) format "x(136)":U at 1 skip( 0 )
     3855     Centering( Sparse( "в продажных ценах"                                 ), 123 ) format "x(136)":U at 1 skip( 0 )
     3856     Centering( Sparse( substitute( "за период с &1 по &2."
     3857                                  , string( x-date-start, "99.99.9999":U )
     3858                                  , string( x-date-end,   "99.99.9999":U )
     3859                                  )                                         ), 123 ) format "x(136)":U at 1 skip( 1 )
     3860     ShiftRight( substitute( "Дата печати: &1, время: &2.   Страница: &3."
     3861                           , string( t_today,                 "99.99.9999":U )
     3862                           , string( j_time,                  "HH:MM:SS":U   )
     3863                           , string( page-number( text_out ), ">>9":U        )
     3864                           )                                                , 123 ) format "x(136)":U at 1 skip( 0 )
     3865   with frame Top_Page width 136 page-top no-labels no-box use-text stream-io no-underline .
     3866   form header                                 skip( 1 )
     3867     Under_Line format "x(136)":U  at  1 skip
     3868     "Продолжение на следующей странице" at 30 skip
     3869   with frame Bottom_Page width 136 page-bottom no-labels no-box use-text stream-io no-underline .
     3870   do
     3871   on error undo, return error return-value
     3872   :
     3873     run WaitFram-Show   in this-procedure
     3874       ( input 'Подождите ...'
     3875       ) .
     3876     run get-report-num  in p-parent-proc
     3877       (
     3878         output g#report-num
     3879       ) .
     3880     run get-quest-print in p-parent-proc
     3881       (
     3882         output g#quest-print
     3883       ) .
     3884   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     3885   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
