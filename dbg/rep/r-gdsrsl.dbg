     5255               put stream text_out unformatted
     5256                 v-ext-doc-name              ':' skip
     5257                 '-------------------------------------------------------' + Header-Line1 +
     5258                 '-----------------------------' skip
     5259                 ': № :      Наименование      :   Дата   : № документа :' + Header-Line2 +
     5260                 ':    Сумма    :Сумма в ценах:' skip
     5261                 ':п/п:       контрагента      : документа:             :' + Header-Line3 +
     5262                 ':    скидки   : прайс-листа :' skip
     5263                 ':   :                        :          :             :' + Header-Line4 +
     5264                 ':             :             :' skip
     5265                 ':   :                        :          :             :' + Header-Line5 +
     5266                 ':             :             :' skip
     5267                 ':---:------------------------:----------:-------------:' + Header-Line6 +
     5268                 ':-------------:-------------:' skip
     5269                 ': 1 :            2           :     3    :      4      :' + Header-Line7 +
     5270                 substring( Centering( string( j-supp-vat-ord + 5 ), 13 ) + fill( " ":U, 13 ), 1, 13 ) + ":" +
     5271                 substring( Centering( string( j-supp-vat-ord + 6 ), 13 ) + fill( " ":U, 13 ), 1, 13 ) + ":" skip
     5272                 ':---:------------------------:----------:-------------:' + Header-Line8 +
     5273                 ':-------------:-------------:' skip
     5274               .
     5275             end.
     5276           end case.
     5277         end.
     5278         if first-of( tt-suppl.doc-code )
     5279         then do:
     5280           case tt-suppl.ext-doc-grp :
     5281             when 3
     5282             then do:
     5283               for each tt-vat-total
     5284               :
     5285                 delete tt-vat-total .
     5286               end.
     5287               assign
     5288                 v-original-code = substitute( '&1#&2-&3&4'
     5289                                             , "---"
     5290                                             , -1
     5291                                             , tt-suppl.ext-doc-type
     5292                                             , trim( string( tt-suppl.is-hold-doc = yes, "_hold/":U ) )
     5293                                             )
     5294               .
     5295               find first bf_suppl no-lock where
     5296                          bf_suppl.is-total    = yes                  and
     5297                          bf_suppl.supp-type   = "---"   and
     5298                          bf_suppl.supp-code   = -1   and
     5299                          bf_suppl.ext-doc-grp = tt-suppl.ext-doc-grp and
     5300                          bf_suppl.ext-doc-ord = tt-suppl.ext-doc-ord and
     5301                          bf_suppl.orig-code   = v-original-code      no-error .
     5302               if available bf_suppl
     5303               then do:
     5304                 for each tt-supp-vat no-lock where
     5305                          tt-supp-vat.order  = bf_suppl.order and
     5306                          tt-supp-vat.is-tot = yes
     5307                 break by tt-supp-vat.vat-pc descending
     5308                 :
     5309                   create tt-vat-total .
     5310                   assign
     5311                     tt-vat-total.vat-ord = tt-supp-vat.vat-ord
     5312                     tt-vat-total.vat-pc  = tt-supp-vat.vat-pc
     5313                     tt-vat-total.vat-sum = ?
     5314                   .
     5315                 end.
     5316               end.
     5317             end.
     5318           end case.
     5319         end.
     5320         case tt-suppl.ext-doc-grp :
     5321           when 1
     5322           then do:
     5323             assign
     5324               d_doc-sum-sale = d_doc-sum-sale + tt-suppl.sum-sale
     5325             .
     5326             if last-of( tt-suppl.doc-code )
     5327             then do:
     5328               assign
