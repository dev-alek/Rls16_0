     2687   end.
     2688   end procedure.
     2689   procedure clcprtsl_calc-line :
     2690   define input  parameter parrec-line as recid no-undo.
     2691   define variable v-tax-date         as   date                     no-undo.
     2692   define variable v-vat-pc           like ub.doc-line.vat-pc       no-undo.
     2693   define variable varr-b             as   character                no-undo.
     2694   define variable varr-btype         as   character                no-undo.
     2695   define variable varcur-base        like ub.gds-dtl.price-base    no-undo.
     2696   define variable varcur-road-tax    like ub.doc-line.road-tax     no-undo.
     2697   define variable varcur-excise      like ub.doc-line.excise       no-undo.
     2698   define variable varcur-vat-pc      like ub.doc-line.vat-pc       no-undo.
     2699   define variable varcur-cons-vat-pc like ub.doc-line.cons-vat-pc  no-undo.
     2700   define variable varcur-slt-pc      like ub.doc-line.slt-pc       no-undo.
     2701   define variable varcur-fact-qnty   like ub.gds-dtl.fact-qnty     no-undo.
     2702   define variable varb-code          like ub.bar-code.b-code       no-undo.
     2703   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     2704   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     2705   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     2706   define variable varexcise          like ub.price-list.excise     no-undo.
     2707   define variable varlastcur-base        like ub.gds-dtl.price-base no-undo.
     2708   define variable varlastcur-road-tax    like ub.gds-dtl.price-base no-undo.
     2709   define variable varlastcur-excise      like ub.gds-dtl.price-base     no-undo.
     2710   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     2711   define variable v-varsum           as decimal                  no-undo.
     2712   define variable varprice-salef as decimal   no-undo .
     2713   define buffer bf_trn-doc             for ub.trn-doc.
     2714   define buffer bf_doc-line            for ub.doc-line.
     2715   define buffer bf_gds-dtl             for ub.gds-dtl.
     2716   define buffer bf_goods               for ub.goods.
     2717   define buffer bf_parts               for ub.parts.
     2718   define buffer bf_sysconf             for ub.sysconf.
     2719   define buffer bf_tt-allsum-line      for tt-allsum-line.
     2720   define buffer bfs_tt-allsum-line     for tt-allsum-line.
     2721   define buffer bfo_tt-allsum-line     for tt-allsum-line.
     2722   define buffer bfos_tt-allsum-line    for tt-allsum-line.
     2723   define buffer buf_parts        for ub.parts.
     2724   v-calcbypart = no.
     2725   do on error undo, return error return-value :
     2726   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2727   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2728     (output varr-b
     2729     )  .
     2730     find first bf_doc-line where recid (bf_doc-line) = parrec-line no-lock.
     2731     find first bf_trn-doc where bf_trn-doc.doc-code = bf_doc-line.doc-code no-lock.
     2732     find first bf_goods where bf_goods.artic     = bf_doc-line.artic     and
     2733                               bf_goods.prod-type = bf_doc-line.prod-type and
     2734                               bf_goods.prod-code = bf_doc-line.prod-code no-lock.
     2735     if bf_trn-doc.fact-date <> ?        then do:
     2736       assign v-tax-date = bf_trn-doc.fact-date.
     2737     end.
     2738     else do:
     2739       assign v-tax-date = ?.
     2740     end.
     2741   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2742   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     2743     (input  bf_goods.gds-code
     2744     ,input  '1':U
     2745     ,input  v-tax-date
     2746     ,input  bf_trn-doc.host-code
     2747     ,input  bf_trn-doc.obj-type
     2748     ,input  bf_trn-doc.obj-code
     2749     ,output v-vat-pc
     2750     ) no-error .
     2751     if error-status :error
     2752     or v-vat-pc = ? then do:
     2753        return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     2754     end.
     2755     if bf_goods.gds-type = 'у':U or
     2756        bf_trn-doc.status_ = 'запрос':U then do:
     2757       for each bf_tt-allsum-line
     2758       on error undo, return error return-value
     2759        :
     2760         delete bf_tt-allsum-line.
     2761       end.
     2762       create bf_tt-allsum-line.
     2763       assign
     2764        bf_tt-allsum-line.sum-type = 'основная_сумма':U.
     2765       for each bf_gds-dtl where bf_gds-dtl.doc-code  = bf_doc-line.doc-code  and
     2766                                 bf_gds-dtl.artic     = bf_doc-line.artic     and
     2767                                 bf_gds-dtl.prod-type = bf_doc-line.prod-type and
     2768                                 bf_gds-dtl.prod-code = bf_doc-line.prod-code no-lock on error undo, return error return-value :
     2769         assign
     2770           bf_tt-allsum-line.fact-qnty            =  bf_tt-allsum-line.fact-qnty        + bf_gds-dtl.fact-qnty
     2771           bf_tt-allsum-line.sum-dsc-base-doc     =  bf_tt-allsum-line.sum-dsc-base-doc + (bf_gds-dtl.price-base - bf_gds-dtl.discnt-base) * bf_gds-dtl.fact-qnty
     2772           bf_tt-allsum-line.sum-dsc-rubl-doc     =  bf_tt-allsum-line.sum-dsc-rubl-doc + (bf_gds-dtl.price-rubl - bf_gds-dtl.discnt-rubl) * bf_gds-dtl.fact-qnty
     2773           bf_tt-allsum-line.dsc-base-doc         =  bf_tt-allsum-line.dsc-base-doc     + bf_gds-dtl.discnt-base * bf_gds-dtl.fact-qnty
     2774           bf_tt-allsum-line.dsc-rubl-doc         =  bf_tt-allsum-line.dsc-rubl-doc     + bf_gds-dtl.discnt-rubl * bf_gds-dtl.fact-qnty
     2775           bf_tt-allsum-line.sum-dsc-base-cur     =  bf_tt-allsum-line.sum-dsc-base-cur + (if varr-b = "base" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base / bf_trn-doc.exch-rate * bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     2776           bf_tt-allsum-line.sum-dsc-rubl-cur     =  bf_tt-allsum-line.sum-dsc-rubl-cur + (if varr-b = "rubl" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base * bf_trn-doc.exch-rate / bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     2777           bf_tt-allsum-line.sum-dsc-base-acc     =  bf_tt-allsum-line.sum-dsc-base-acc + bf_doc-line.price-base * bf_gds-dtl.fact-qnty
     2778           bf_tt-allsum-line.sum-dsc-rubl-acc     =  bf_tt-allsum-line.sum-dsc-rubl-acc + bf_doc-line.price-rubl * bf_gds-dtl.fact-qnty
     2779           bf_tt-allsum-line.sum-dsc-cli-acc      =  ?
     2780           bf_tt-allsum-line.vat-base-acc         =  bf_tt-allsum-line.vat-base-acc     + bf_doc-line.price-base * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     2781           bf_tt-allsum-line.vat-rubl-acc         =  bf_tt-allsum-line.vat-rubl-acc     + bf_doc-line.price-rubl * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     2782           bf_tt-allsum-line.vat-cli-acc          =  ?
     2783           .
     2784       end.
     2785       assign
     2786         bf_tt-allsum-line.cli-qnty             =  ?
     2787         bf_tt-allsum-line.slt-base-doc         =  bf_tt-allsum-line.sum-dsc-base-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     2788         bf_tt-allsum-line.slt-rubl-doc         =  bf_tt-allsum-line.sum-dsc-rubl-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     2789         bf_tt-allsum-line.vat-base-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-base-doc - bf_tt-allsum-line.slt-base-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     2790         bf_tt-allsum-line.vat-rubl-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-rubl-doc - bf_tt-allsum-line.slt-rubl-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     2791         bf_tt-allsum-line.road-tax-base-doc    =  0
