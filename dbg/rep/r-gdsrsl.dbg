     5215                          bf_suppl.ext-doc-grp = tt-suppl.ext-doc-grp and
     5216                          bf_suppl.ext-doc-ord = tt-suppl.ext-doc-ord and
     5217                          bf_suppl.orig-code   = v-original-code      no-error .
