     2404       bfs_tt-allsum.road-tax-base-acc   =  - bf_tt-allsum.road-tax-base-acc
     2405       bfs_tt-allsum.road-tax-rubl-acc   =  - bf_tt-allsum.road-tax-rubl-acc
     2406       bfs_tt-allsum.road-tax-cli-acc    =  - bf_tt-allsum.road-tax-cli-acc
     2407       bfs_tt-allsum.excise-base-acc     =  - bf_tt-allsum.excise-base-acc
     2408       bfs_tt-allsum.excise-rubl-acc     =  - bf_tt-allsum.excise-rubl-acc
     2409       bfs_tt-allsum.excise-cli-acc      =  - bf_tt-allsum.excise-cli-acc
     2410       bfs_tt-allsum.transport-base-acc  =  - bf_tt-allsum.transport-base-acc
     2411       bfs_tt-allsum.transport-rubl-acc  =  - bf_tt-allsum.transport-rubl-acc
     2412       bfs_tt-allsum.transport-cli-acc   =  - bf_tt-allsum.transport-cli-acc
     2413       bfs_tt-allsum.other-base-acc      =  - bf_tt-allsum.other-base-acc
     2414       bfs_tt-allsum.other-rubl-acc      =  - bf_tt-allsum.other-rubl-acc
     2415       bfs_tt-allsum.other-cli-acc       =  - bf_tt-allsum.other-cli-acc.
     2416   end.
     2417   create bfpc_tt-allsum.
     2418   create bfspc_tt-allsum.
     2419   case cl_tt-clcparts.purch-code :
     2420   when 1           then do:
     2421     assign
     2422       bfpc_tt-allsum.sum-type  = 'сумма_по_выкупу':U
     2423       bfspc_tt-allsum.sum-type = 'сумма_по_выкупу_со_знаком':U.
     2424     buffer-copy bf_tt-allsum  except bf_tt-allsum.sum-type  to bfpc_tt-allsum.
     2425     buffer-copy bfs_tt-allsum except bfs_tt-allsum.sum-type to bfspc_tt-allsum.
     2426   end.
     2427   when 4    then do:
     2428     assign
     2429       bfpc_tt-allsum.sum-type  = 'сумма_по_старой_консигнации':U
     2430       bfspc_tt-allsum.sum-type = 'сумма_по_старой_консигнации_со_знаком':U.
     2431     buffer-copy bf_tt-allsum  except bf_tt-allsum.sum-type  to bfpc_tt-allsum.
     2432     buffer-copy bfs_tt-allsum except bfs_tt-allsum.sum-type to bfspc_tt-allsum.
     2433   end.
     2434   when 3 then do:
     2435     assign
     2436       bfpc_tt-allsum.sum-type  = 'сумма_по_ответственному_хранению':U
     2437       bfspc_tt-allsum.sum-type = 'сумма_по_ответственному_хранению_со_знаком':U.
     2438     buffer-copy bf_tt-allsum  except bf_tt-allsum.sum-type  to bfpc_tt-allsum.
     2439     buffer-copy bfs_tt-allsum except bfs_tt-allsum.sum-type to bfspc_tt-allsum.
     2440   end.
     2441   when 2 then do:
     2442     assign
     2443       bfpc_tt-allsum.sum-type  = 'сумма_по_консигнации_выгода':U
     2444       bfspc_tt-allsum.sum-type = 'сумма_по_консигнации_выгода_со_знаком':U.
     2445     assign
     2446       bfpc_tt-allsum.fact-qnty           = bf_tt-allsum.fact-qnty
