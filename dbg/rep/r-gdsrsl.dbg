     4988                 run get-xtype-name in this-procedure
     4989                   (  input jj
     4990                   , output v-ext-doc-name
     4991                   ) .
     4992                 put stream text_out unformatted
     4993                   v-ext-doc-name ':' skip
     4994                 .
     4995               end.
     4996             end.
     4997             if first_time = no
     4998             then do:
     4999               put stream text_out unformatted
     5000                 skip( 1 )
     5001               .
     5002             end.
     5003           end.
     5004           run get-supp-rest in this-procedure
     5005             (  input tt-suppl.supp-type
     5006             ,  input tt-suppl.supp-code
     5007             ,  input "final":U
     5008             ,  input fact-order-till
     5009             , output d_final-rest
     5010             , output d_final-qnty
     5011             ) no-error .
     5012           if error-status :error or
     5013              d_final-rest = ?
     5014           then do:
     5015             assign
     5016               d_final-rest = 0.00
     5017             .
     5018           end.
     5019           put stream text_out unformatted
     5020             string( substitute( 'Остаток на конец: &1'
     5021                               , trim( string( d_final-rest, "->,>>>,>>>,>>>,>>9.99":U ) )
     5022                               ), "x(80)":U ) skip( 1 )
     5023           .
     5024           if Make-Excel then  put   stream ForExcel unformatted
     5025             substitute( 'Остаток на конец: &1'
     5026                       , trim( string( d_final-rest, "->,>>>,>>>,>>>,>>9.99":U ) )
     5027                       ) skip
     5028           .
     5029         end.
     5030         if last( tt-suppl.supp-code )
     5031         then do:
     5032           hide stream text_out frame Bottom_Page no-pause .
     5033         end.
     5034       end.
     5035     end.
     5036     else do:
     5037       if p-all-suppl = yes
     5038       then do:
     5039         find last bf_stk-tot no-lock where
     5040                   bf_stk-tot.obj-type    = p-obj-type      and
     5041                   bf_stk-tot.obj-code    = p-obj-code      and
     5042                   bf_stk-tot.fact-order <= fact-order-from and
     5043                   bf_stk-tot.sum-type    = 'crsa':U     and
     5044                   bf_stk-tot.cat-id      = '##,##':U  no-error .
     5045         if available bf_stk-tot
     5046         then do:
     5047           assign
     5048             d_start-rest = ( if varr-b = "rubl" then bf_stk-tot.sum-rubl else bf_stk-tot.sum-base )
     5049             d_start-qnty = bf_stk-tot.fact-qnty
     5050           .
     5051         end.
     5052         else do:
     5053           assign
     5054             d_start-rest = 0.00
     5055             d_start-qnty = 0.00
     5056           .
     5057         end.
     5058       end.
     5059       else do:
     5060         for each g#supplier no-lock
     5061         :
     5062           run get-supp-rest in this-procedure
     5063             (  input g#supplier.supp-type
     5064             ,  input g#supplier.supp-code
     5065             ,  input "start":U
     5066             ,  input fact-order-from
     5067             , output d_temp-rest
     5068             , output d_temp-qnty
     5069             ) no-error .
     5070           if error-status :error or
     5071              d_temp-rest = ?
     5072           then do:
     5073             assign
     5074               d_temp-rest = 0.00
     5075             .
     5076           end.
     5077           assign
     5078             d_start-rest = d_start-rest + d_temp-rest
     5079             d_temp-rest  = 0.00
     5080           .
     5081         end.
     5082       end.
     5083       put stream text_out unformatted
     5084         string( substitute( 'Остаток на начало: &1'
     5085                           , trim( string( d_start-rest, "->,>>>,>>>,>>>,>>9.99":U ) )
     5086                           ), "x(80)":U ) skip
     5087       .
     5088       assign
     5089         str4 = substitute( 'Остаток на начало: &1'
     5090                           , trim( string( d_start-rest, "->,>>>,>>>,>>>,>>9.99":U ) )
     5091                           )
     5092       .
     5093       for each tt-suppl   no-lock where
     5094                tt-suppl.is-total    = no use-index i2
     5095       break by tt-suppl.ext-doc-grp
     5096             by tt-suppl.ext-doc-ord
     5097             by tt-suppl.doc-code
     5098             by tt-suppl.cli-name
     5099       :
     5100         if first( tt-suppl.ext-doc-ord )
     5101         then do:
     5102           assign
     5103             first_time = ?
     5104           .
     5105           if tt-suppl.ext-doc-ord > 1
     5106           then do:
     5107             assign
     5108               first_time = yes
     5109             .
     5110             do jj = 1 to tt-suppl.ext-doc-ord - 1
     5111             :
     5112               if use-column[ jj ] = yes
     5113               then do:
     5114                 if first_time = yes
     5115                 then do:
     5116                   assign
     5117                     first_time = no
     5118                   .
     5119                   put stream text_out unformatted
     5120                     skip( 1 )
     5121                   .
     5122                 end.
     5123                 run get-xtype-name in this-procedure
     5124                   (  input jj
     5125                   , output v-ext-doc-name
     5126                   ) .
     5127                 put stream text_out unformatted
     5128                   v-ext-doc-name ':' skip
     5129                 .
     5130               end.
     5131             end.
     5132             if first_time = no
     5133             then do:
     5134               put stream text_out unformatted
     5135                 skip( 1 )
     5136               .
     5137             end.
     5138           end.
     5139         end.
     5140         if first-of( tt-suppl.ext-doc-ord )
     5141         then do:
     5142           assign
     5143             j-npp = 0
     5144           .
     5145           run get-xtype-name in this-procedure
     5146             (  input tt-suppl.ext-doc-ord
     5147             , output v-ext-doc-name
     5148             ) .
     5149           case tt-suppl.ext-doc-grp :
     5150             when 1
     5151             then do:
     5152               if line-counter( text_out ) + 9 > page-size( text_out )
     5153               then do:
     5154                 page stream text_out .
     5155               end.
     5156               put stream text_out unformatted
     5157                 v-ext-doc-name                                                                                     ':' skip
     5158                 '----------------------------------------------------------------------------------------------------' skip
     5159                 ': № п/п :              Наименование              :    Дата   :  № документа  :     Стоимость в     :' skip
     5160                 ':       :               контрагента              : документа :               :      продажных      :' skip
     5161                 ':       :                                        :           :               :        ценах        :' skip
     5162                 ':-------:----------------------------------------:-----------:---------------:---------------------:' skip
     5163                 ':   1   :                    2                   :     3     :       4       :          5          :' skip
     5164                 ':-------:----------------------------------------:-----------:---------------:---------------------:' skip
     5165               .
     5166             end.
     5167             when 2
     5168             then do:
     5169               if line-counter( text_out ) + 9 > page-size( text_out )
     5170               then do:
     5171                 page stream text_out .
     5172               end.
     5173               put stream text_out unformatted
     5174                 v-ext-doc-name                                                                                     ':' skip
     5175                 '----------------------------------------------------------------------------------------------------' skip
     5176                 ': № п/п :              Наименование              :    Дата   :  № документа  :      Разница в      :' skip
     5177                 ':       :               контрагента              : документа :               :      продажных      :' skip
     5178                 ':       :                                        :           :               :        ценах        :' skip
     5179                 ':-------:----------------------------------------:-----------:---------------:---------------------:' skip
     5180                 ':   1   :                    2                   :     3     :       4       :          5          :' skip
     5181                 ':-------:----------------------------------------:-----------:---------------:---------------------:' skip
     5182               .
     5183             end.
     5184             when 3
     5185             then do:
     5186               assign
     5187                 j-supp-vat-ord = 0
     5188                 j-add-length   = 0
     5189                 Header-Line1   = "":U
     5190                 Header-Line2   = "":U
     5191                 Header-Line3   = "":U
     5192                 Header-Line4   = "":U
     5193                 Header-Line5   = "":U
     5194                 Header-Line6   = "":U
     5195                 Header-Line7   = "":U
     5196                 Header-Line8   = "":U
     5197                 Label-Line1    = "":U
     5198                 Label-Line2    = "":U
     5199                 Label-Line3    = "":U
     5200                 Format-Line1   = "":U
     5201                 Format-Line2   = "":U
     5202               .
     5203               assign
     5204                 v-original-code = substitute( '&1#&2-&3&4'
     5205                                             , "---"
     5206                                             , -1
     5207                                             , tt-suppl.ext-doc-type
     5208                                             , trim( string( tt-suppl.is-hold-doc = yes, "_hold/":U ) )
     5209                                             )
     5210               .
