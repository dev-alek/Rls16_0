      569   define new global shared variable g#library  as handle no-undo .
      570   define new global shared variable g#library2 as handle no-undo .
      571   define variable var-report-r-b as character no-undo .
      572   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      573   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      574     (output var-report-r-b
      575     )  .
      576   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      577   define new global shared variable g#trdcalib as handle no-undo.
      578   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      579   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      580   define  shared variable RepPathName        as character no-undo .
      581   define  shared variable PrintRubl          as logical   no-undo .
      582   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      583   define variable v-waitfram-action01         as character   no-undo .
      584   define variable v-waitfram-action02         as character   no-undo .
      585   define variable v-waitfram-action03         as character   no-undo .
      586   define variable mWaitFramTextBeg            as character   no-undo.
      587   define variable mWaitFramTextEnd            as character   no-undo.
      588   define variable mWaitFramView               as logical     no-undo.
      589   define variable mWaitProcEvent              as logical     no-undo init yes.
      590   define variable mWaitFramInterval           as integer     no-undo init 1 .
      591   define variable mWaitFramStop               as logical     no-undo.
      592   define variable mWaitFramStopUser           as logical     no-undo.
      593   define variable mWaitFramStopTimeOut        as logical     no-undo.
      594   define variable mWaitFramStartProc          as datetime-tz no-undo.
      595   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      596   define button B-WaitFramStop auto-end-key
      597        label "Стоп"
      598        size 10 by 1 tooltip "Остоновить процесс".
      599   define button B-viewProcInfo
      600        label "Информация"
      601        size 15 by 1 tooltip "Информация о процесс".
      602   define frame waitfram
      603     v-waitfram-action01 format "x(72)" no-label skip
      604     v-waitfram-action02 format "x(72)" no-label skip
      605     v-waitfram-action03 format "x(72)" no-label skip
      606     B-viewProcInfo
      607     B-WaitFramStop at row 4 col 30
      608     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      609     .
      610   define new global shared variable mBatchMode as logical no-undo init ?.
      611   define variable mFramBachModHandle as handle no-undo.
      612   mFramBachModHandle = frame waitfram:handle.
      613   define variable mFameOldVis as logical no-undo.
      614   define variable mVisCUrentVin as logical no-undo.
      615   if session:batch-mode
      616   then
      617      mBatchMode = yes.
      618   if mBatchMode = ? then do:
      619     mVisCUrentVin = current-window:visible.
      620     mFameOldVis = mFramBachModHandle:visible.
      621     mFramBachModHandle:visible  = yes.
      622     mBatchMode = mFramBachModHandle:visible ne yes.
      623     mFramBachModHandle:visible = mFameOldVis.
      624     current-window:visible = mVisCUrentVin.
      625   end.
      626    if  log-manager:logfile-name ne ?
      627     then DO:
      628         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      629         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      630         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      631     end.
      632   on choose of B-WaitFramStop in frame waitfram
      633   do:
      634     mWaitFramStop = yes.
      635     mWaitFramStopUser = yes.
      636   end.
      637   function waitfram-check-timeout returns logical():
      638      define variable vtime as int64 no-undo.
      639      if mWaitFramStopTimeOut
      640      then
      641         return yes.
      642      vtime = ( now - mWaitFramStartProc ) / 1000 .
      643      if     mWaitFramTimeOut ne ?
      644         and mWaitFramTimeOut ne 0
      645         and mWaitFramTimeOut lt vtime
      646      then do:
      647         mWaitFramStopTimeOut = yes.
      648      end.
      649      return mWaitFramStopTimeOut.
      650   end.
      651   procedure waitfram-hide :
      652     if not session:batch-mode
      653     then do
      654     on error undo, return error return-value
      655     :
      656       pause 0 before-hide .
      657       if not mBatchMode then
      658         hide frame waitfram .
      659     if     not mWaitFramView
      660        and mWaitProcEvent
      661     then
      662       process events .
      663     end.
      664   end procedure.
      665   procedure waitfram-show :
      666     define input  parameter p-message as character no-undo .
      667     define variable v-left-margin as integer   no-undo .
      668     if not session:batch-mode
      669     then do
      670     on error undo, return error return-value
      671     :
      672       if length(p-message) <= 70 then do:
      673         assign
      674           v-left-margin = integer((70 - length(p-message)) / 2)
      675         .
      676         assign
      677           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      678         .
      679         assign
      680           v-waitfram-action01 = " "
      681           v-waitfram-action02 = " "
      682                                    + fill(" ", v-left-margin)
      683                                    + p-message
      684           v-waitfram-action03 = " "
      685         .
      686       end.
      687       else do:
      688         define variable vRindex1 as integer no-undo.
      689         define variable vRindex2 as integer no-undo.
      690         vRindex1 = r-index(p-message," ",70).
      691         if vRindex1 = 0
      692         then
      693            vRindex1 = 70.
      694         if length(p-message)  <= vRindex1 + 70 then do:
      695           assign
      696             v-waitfram-action01 = " "
      697             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      698             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      699           .
      700         end.
      701         else do:
      702           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      703           if vRindex2 <= vRindex1
      704           then
      705              vRindex2 = vRindex1 + 70.
      706           assign
      707             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      708             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      709             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      710           .
      711         end.
      712       end.
      713       B-viewProcInfo:visible   in frame waitfram = no.
      714       B-viewProcInfo:sensitive in frame waitfram = no.
      715       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      716       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      717       if  (   mWaitFramView
      718          or  mWaitProcEvent)
      719          and not mBatchMode
      720       then
      721          display
      722             v-waitfram-action01 skip
      723             v-waitfram-action02 skip
      724             v-waitfram-action03 skip
      725          with frame waitfram .
      726       if     mWaitFramView
      727          then do:
      728             if     mWaitFramInterval ne ?
      729                and not mBatchMode
      730             then
      731                wait-for go of frame waitfram pause mWaitFramInterval.
      732          end.
      733          else
      734             if     mWaitProcEvent
      735                and not mBatchMode
      736             then
      737                process events .
      738     end.
      739   end procedure.
      740      procedure waitfram-show-this:
      741         define input  parameter iInterval as int64 no-undo.
      742         define variable vtime as int64 no-undo.
      743         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      744         mWaitFramInterval = iInterval.
      745         run waitfram-show (substitute("&1&2 &3&4" ,
      746                                       mWaitFramTextBeg ,
      747                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      748                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      749                                       mWaitFramTextEnd
      750                                      )
      751                           ).
      752      end.
      753      procedure WaitFramRunPause:
      754         define input  parameter iInterval as dec no-undo.
      755         define variable vStart  as datetime-tz no-undo.
      756         define variable vend    as datetime-tz no-undo.
      757         define variable vint as int64 no-undo.
      758         define variable vOk as logical no-undo.
      759         vStart = now.
      760         vend   = vStart.
      761         publish "WaitFramPause" (iInterval,output vOk).
      762         vend   =  now.
      763         vint = vend - vStart.
      764         vint = iInterval - vint / 1000.
      765         if     not mWaitFramStop
      766            and (   vint > 0
      767                 or (    not vOk
      768                     and iInterval eq ?
      769                     )
      770                 )
      771         then
      772            run waitfram-show-this (iInterval).
      773         vend   =  now.
      774         vint = vend - vStart.
      775         vint = iInterval - vint / 1000.
      776         if     not mWaitFramStop
      777            and vint > 0
      778         then do:
      779            run gbl/pause.p (vint * 1000).
      780         end.
      781         if iInterval ne ?
      782         then
      783            publish "WaitFramStop".
      784         waitfram-check-timeout().
      785      end.
      786      procedure WaitFramWaitFor:
      787         define input  parameter iInterval as dec no-undo.
      788         assign
      789            mWaitFramStartProc   = now
      790            mWaitFramStopUser    = no
      791            mWaitFramStopTimeOut = no
      792         .
      793         block-wait:
      794         do while not mWaitFramStop:
      795            run WaitFramRunPause (iInterval).
      796            if  waitfram-check-timeout()
      797            then do:
      798               leave block-wait.
      799            end.
      800         end.
      801         run waitfram-hide.
      802      end.
      803   procedure waitfram-join :
      804     define input  parameter p-line-1  as character no-undo .
      805     define input  parameter p-line-2  as character no-undo .
      806     define input  parameter p-line-3  as character no-undo .
      807     define output parameter p-message as character no-undo .
      808     do
      809     on error undo, return error return-value
      810     :
      811       assign
      812         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      813                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      814                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      815       .
      816     end.
      817   end procedure.
      818   function waitfram-join-function returns character
      819     (input p-line-1 as character
      820     ,input p-line-2 as character
      821     ,input p-line-3 as character
      822     ).
      823     define variable v-message as character no-undo .
      824     run waitfram-join in this-procedure
      825       (input  p-line-1
      826       ,input  p-line-2
      827       ,input  p-line-3
      828       ,output v-message
      829       ) .
      830     return v-message .
      831   end function .
      832   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      833   procedure factord :
      834     define input  parameter p-fact-date            as date    no-undo .
      835     define input  parameter p-fact-time            as integer no-undo .
      836     define input  parameter p-fact-num             as integer no-undo .
      837     define input  parameter p-shift-date           as date    no-undo .
      838     define input  parameter p-shift-num            as integer no-undo .
      839     define input  parameter p-shift-on             as logical no-undo .
      840     define output parameter p-fact-order           as decimal no-undo .
      841     define output parameter p-shift-end-fact-order as decimal no-undo .
      842     define output parameter p-day-end-fact-order   as decimal no-undo .
      843     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      844     if p-fact-date = ?
      845     then do:
      846       return error "Не указана фактическая дата" .
      847     end.
      848     define variable v-fact-date-num as integer no-undo .
      849     assign
      850       v-fact-date-num = integer(p-fact-date)
      851     .
      852     if p-fact-num = ?
      853     or p-fact-num = 0
      854     then do:
      855       return error "Не задан p-fact-num " + string(p-fact-num) .
      856     end.
      857     if p-fact-num < 0
      858     then do:
      859       return error "Отрицательный fact-num " + string(p-fact-num) .
      860     end.
      861     if p-fact-num >= 100000000
      862     then do:
      863       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      864     end.
      865     if p-shift-on = true
      866     then do:
      867       if p-shift-date = ?
      868       then do:
      869         return error "Не задана дата смены" .
      870       end.
      871       if p-shift-num = ?
      872       or p-shift-num = 0
      873       then do:
      874         return error "Не задан номер смены" .
      875       end.
      876     end.
      877     else do:
      878       assign
      879         p-shift-date = p-fact-date
      880         p-shift-num  = 24
      881       .
      882     end.
      883     define variable v-shift-offset as integer no-undo .
      884     if p-shift-date = p-fact-date
      885     then do:
      886       assign
      887         v-shift-offset = 1
      888       .
      889     end.
      890     if p-shift-date < p-fact-date
      891     then do:
      892       assign
      893         v-shift-offset = 0
      894       .
      895     end.
      896     if p-shift-date > p-fact-date
      897     then do:
      898       message
      899         vss-workfile vss-revision vss-description skip
      900         "Неправильная дата закрытия смены" skip
      901         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      902         view-as alert-box error .
      903       undo, return error
      904         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      905           ,string(p-fact-date, '99/99/9999':U)
      906           ,string(p-shift-date, '99/99/9999':U)
      907           )
      908       .
      909     end.
      910     if p-shift-num < 1
      911     or p-shift-num > 24
      912     then do:
      913       message
      914         vss-workfile vss-revision vss-description skip
      915         "Неправильный номер смены" skip
      916         "p-shift-num" p-shift-num skip
      917         view-as alert-box error .
      918       undo, return error return-value .
      919     end.
      920     assign
      921       p-fact-order           = v-fact-date-num
      922                              + v-shift-offset * 0.5
      923                              + p-shift-num    * 0.02 - 0.01
      924                              + p-fact-num     * 0.0000000001
      925       p-shift-end-fact-order = v-fact-date-num
      926                              + v-shift-offset * 0.5
      927                              + p-shift-num    * 0.02
      928       p-day-end-fact-order   = v-fact-date-num
      929                              + 0.99
      930     .
      931     if p-fact-order           <= v-fact-date-num
      932     or p-shift-end-fact-order <= v-fact-date-num
      933     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      934     or p-shift-end-fact-order >= p-day-end-fact-order
      935     then do:
      936       message
      937         vss-workfile vss-revision vss-description skip
      938         "Внутренняя ошибка при генерации фактического номера" skip
      939         "p-fact-date"            p-fact-date            skip
      940         "p-fact-time"            p-fact-time            skip
      941         "p-fact-num"             p-fact-num             skip
      942         "p-shift-date"           p-shift-date           skip
      943         "p-shift-num"            p-shift-num            skip
      944         "p-shift-on"             p-shift-on             skip
      945         "p-shift-end-fact-order" p-shift-end-fact-order skip
      946         "p-day-end-fact-order"   p-day-end-fact-order   skip
      947         "v-fact-date-num"        v-fact-date-num        skip
      948         view-as alert-box error .
      949       undo, return error return-value .
      950     end.
      951   end procedure.
      952   procedure day-begin-fact-order :
      953     define input  parameter p-fact-date            as date    no-undo .
      954     define output parameter p-day-begin-fact-order as decimal no-undo .
      955     do
      956     on error undo, return error return-value
      957     :
      958       if p-fact-date = ?
      959       then do:
      960         assign
      961           p-day-begin-fact-order = 0
      962         .
      963       end.
      964       else do:
      965         assign
      966           p-day-begin-fact-order = integer(p-fact-date)
      967         .
      968       end.
      969     end.
      970   end procedure.
      971   procedure factord-max-fact-order :
      972     define output parameter p-max-fact-order as decimal   no-undo .
      973     do
      974     on error undo, return error return-value
      975     :
      976       run day-begin-fact-order in this-procedure
      977         (input  date(1, 1, 5000)
      978         ,output p-max-fact-order
      979         ) .
      980     end.
      981   end procedure.
      982   procedure factord-cut-archive :
      983     define input  parameter p-obj-type             as character no-undo .
      984     define input  parameter p-obj-code             as integer   no-undo .
      985     define input  parameter p-fact-date            as date      no-undo .
      986     define output parameter p-shift-on             as logical   no-undo .
      987     define output parameter p-shift-date           as date      no-undo .
      988     define output parameter p-shift-num            as integer   no-undo .
      989     define output parameter p-day-end-fact-order   as decimal   no-undo .
      990     define output parameter p-shift-end-fact-order as decimal   no-undo .
      991     define variable v-fact-order as decimal   no-undo .
      992     define buffer buf_shift-obj for ub.shift-obj .
      993     do
      994     on error undo, return error return-value
      995     :
      996   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      997   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      998     (input  p-obj-type
      999     ,input  p-obj-code
     1000     ,input  'shift-on=request'
     1001     ,output p-shift-on
     1002     ) no-error .
     1003       if error-status :error
     1004       then do:
     1005         message
     1006           vss-workfile vss-revision vss-description skip
     1007           "Ошибка при определении атрибута объекта" skip
     1008           "Объект" p-obj-type p-obj-code skip
     1009           error-status :get-message(1) skip
     1010           return-value skip
     1011           view-as alert-box error .
     1012         undo, return error return-value .
     1013       end.
     1014       if p-shift-on = false
     1015       then do:
     1016         assign
     1017           p-shift-date               = ?
     1018           p-shift-num                = 0
     1019         .
     1020       end.
     1021       else do:
     1022         find first buf_shift-obj share-lock
     1023           where buf_shift-obj.obj-type   = p-obj-type
     1024             and buf_shift-obj.obj-code   = p-obj-code
     1025             and buf_shift-obj.shift-date > p-fact-date
     1026           use-index pi
     1027           no-error .
     1028         if not available buf_shift-obj
     1029         or buf_shift-obj.status_ <> 'зкр':U
     1030         then do:
     1031           message
     1032             vss-workfile vss-revision vss-description skip
     1033             "Невозможно вычислить последнюю смену" skip
     1034             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1035             "Объект" p-obj-type p-obj-code skip
     1036             "Дата" p-fact-date skip
     1037             view-as alert-box error .
     1038           undo, return error return-value .
     1039         end.
     1040         find last buf_shift-obj share-lock
     1041           where buf_shift-obj.obj-type = p-obj-type
     1042             and buf_shift-obj.obj-code = p-obj-code
     1043             and buf_shift-obj.shift-date <= p-fact-date
     1044           use-index pi
     1045           no-error .
     1046         if available buf_shift-obj
     1047         then do:
     1048           if  buf_shift-obj.status_ = 'зкр':U
     1049           then do:
     1050             assign
     1051               p-shift-date = buf_shift-obj.shift-date
     1052               p-shift-num  = buf_shift-obj.shift-num
     1053             .
     1054           end.
     1055           else do:
     1056             message
     1057               vss-workfile vss-revision vss-description skip
     1058               "Невозможно вычислить последнюю смену" skip
     1059               "Статус смены отличен от статуса" 'зкр':U skip
     1060               "Объект" p-obj-type p-obj-code skip
     1061               "Дата" p-fact-date skip
     1062               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1063               view-as alert-box error .
     1064             undo, return error return-value .
     1065           end.
     1066         end.
     1067         else do:
     1068           assign
     1069             p-shift-date = p-fact-date - 1
     1070             p-shift-num  = 1
     1071           .
     1072         end.
     1073       end.
     1074       run factord in this-procedure
     1075         (input  p-fact-date
     1076         ,input  1
     1077         ,input  1
     1078         ,input  p-shift-date
     1079         ,input  p-shift-num
     1080         ,input  p-shift-on
     1081         ,output v-fact-order
     1082         ,output p-shift-end-fact-order
     1083         ,output p-day-end-fact-order
     1084         ) no-error .
     1085       if error-status :error
     1086       then do:
     1087         message
     1088           vss-workfile vss-revision vss-description skip
     1089           "Ошибка при вызове процедуры factord"
     1090           error-status :get-message(1) skip
     1091           return-value skip
     1092           view-as alert-box error .
     1093         undo, return error return-value .
     1094       end.
     1095     end.
     1096   end procedure.
     1097   procedure factord-lock-shift :
     1098     define input  parameter p-obj-type  as character no-undo .
     1099     define input  parameter p-obj-code  as integer   no-undo .
     1100     define input  parameter p-fact-date as date      no-undo .
     1101     define parameter buffer buf_shift-obj for ub.shift-obj .
     1102     define variable v-shift-on      as logical   no-undo .
     1103     define variable v-extra-message as character no-undo .
     1104     define variable v-error as character no-undo .
     1105     do
     1106     on error undo, return error return-value
     1107     :
     1108   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1109   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1110     (input  p-obj-type
     1111     ,input  p-obj-code
     1112     ,input  'shift-on=request'
     1113     ,output v-shift-on
     1114     ) no-error .
     1115       if error-status :error
     1116       then do:
     1117         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1118         undo, return error v-error .
     1119       end.
     1120       if v-shift-on = true
     1121       then do:
     1122         find first buf_shift-obj share-lock
     1123           where buf_shift-obj.obj-type   = p-obj-type
     1124             and buf_shift-obj.obj-code   = p-obj-code
     1125             and buf_shift-obj.shift-date > p-fact-date
     1126           use-index pi
     1127           no-error .
     1128         if not available buf_shift-obj
     1129         or buf_shift-obj.status_ <> 'зкр':U
     1130         then do:
     1131           find last buf_shift-obj
     1132             where buf_shift-obj.obj-type = p-obj-type
     1133               and buf_shift-obj.obj-code = p-obj-code
     1134               and buf_shift-obj.status_  = 'зкр':U
     1135             use-index stts
     1136             no-error .
     1137           if available buf_shift-obj
     1138           then do:
     1139             assign
     1140               v-extra-message =
     1141                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1142                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1143                               )
     1144             .
     1145           end.
     1146           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1147           undo, return error v-error .
     1148         end.
     1149       end.
     1150     end.
     1151   end procedure.
     1152   procedure factord-end-day :
     1153     define input  parameter p-fact-date            as date    no-undo .
     1154     define output parameter p-day-end-fact-order   as decimal no-undo .
     1155     do
     1156     on error undo, return error return-value
     1157     :
     1158       if p-fact-date = ?
     1159       then do:
     1160         return error "Не указана фактическая дата" .
     1161       end.
     1162       assign
     1163         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1164       .
     1165     end.
     1166   end procedure.
     1167   procedure factord-to-date :
     1168     define input  parameter p-fact-order as decimal no-undo .
     1169     define output parameter p-fact-date  as date    no-undo .
     1170     define variable v-ref-date  as date      no-undo .
     1171     define variable v-ref-delta as integer   no-undo .
     1172     do
     1173     on error undo, return error return-value
     1174     :
     1175       if p-fact-order = ?
     1176       or p-fact-order = 0
     1177       then do:
     1178         return error "Не указан fact-order" .
     1179       end.
     1180       assign
     1181         v-ref-date  = date(1, 1, 2000)
     1182       .
     1183       assign
     1184         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1185       .
     1186       assign
     1187         p-fact-date = v-ref-date + v-ref-delta
     1188       .
     1189     end.
     1190   end procedure.
     1191   procedure factord-to-fact-num :
     1192     define input  parameter p-fact-order as decimal no-undo .
     1193     define output parameter p-fact-num   as integer no-undo .
     1194     define variable v-fact-order-trunc as decimal no-undo .
     1195     do
     1196     on error undo, return error return-value
     1197     :
     1198       if p-fact-order = ?
     1199       or p-fact-order = 0
     1200       then do:
     1201         return error "Не указан fact-order" .
     1202       end.
     1203       assign
     1204        v-fact-order-trunc = truncate(p-fact-order, 2)
     1205       .
     1206       assign
     1207         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1208       .
     1209     end.
     1210   end procedure.
     1211   procedure factord-to-shift-num :
     1212     define input  parameter p-fact-order as decimal no-undo .
     1213     define output parameter p-shift-num   as integer no-undo .
     1214     define variable  p-shift-numd  as decimal   no-undo .
     1215     define variable v-fact-order-trunc as decimal no-undo .
     1216     do
     1217     on error undo, return error return-value
     1218     :
     1219       if p-fact-order = ?
     1220       or p-fact-order = 0
     1221       then do:
     1222         return error "Не указан fact-order" .
     1223       end.
     1224       assign
     1225        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1226       .
     1227       if v-fact-order-trunc < 0.5 then do:
     1228         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1229       end.
     1230       assign
     1231         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1232         .
     1233        assign
     1234         p-shift-num = truncate (p-shift-numd , 0)
     1235       .
     1236     end.
     1237   end procedure.
