     4430                   bf_supp-vat.vat-pc  = tt-supp-vat.vat-pc
     4431                   bf_supp-vat.is-tot  = yes
     4432                   bf_supp-vat.vat-ord = j-supp-vat-ord
     4433                 .
     4434               end.
     4435               assign
     4436                 bf_supp-vat.sum-doc = bf_supp-vat.sum-doc + tt-supp-vat.sum-doc
     4437               .
     4438             end.
     4439           end.
     4440           assign
     4441             v-tmp-string = "":U
     4442             jj           = 0
     4443           .
     4444         end.
     4445       end.
     4446       for each tt-suppl no-lock where
     4447                tt-suppl.is-total = no
     4448       break by tt-suppl.ext-doc-grp
     4449             by tt-suppl.ext-doc-ord
     4450       :
     4451         assign
     4452           v-original-code = substitute( '&1#&2-&3&4'
     4453                                       , "---"
     4454                                       , -1
     4455                                       , tt-suppl.ext-doc-type
     4456                                       , trim( string( tt-suppl.is-hold-doc = yes, "_hold/":U ) )
     4457                                       )
     4458         .
     4459         find first bf_suppl no-lock where
     4460                    bf_suppl.supp-type = "---" and
     4461                    bf_suppl.supp-code = -1 and
     4462                    bf_suppl.orig-code =   v-original-code  no-error .
     4463         if available bf_suppl
     4464         then do:
     4465           for each tt-supp-vat where
     4466                    tt-supp-vat.order = tt-suppl.order
     4467                 by tt-supp-vat.vat-pc descending
     4468           :
     4469             find first bf_supp-vat no-lock where
     4470                        bf_supp-vat.order  = bf_suppl.order     and
     4471                        bf_supp-vat.vat-pc = tt-supp-vat.vat-pc no-error .
     4472             if available bf_supp-vat
     4473             then do:
     4474               assign
     4475                 tt-supp-vat.vat-ord = bf_supp-vat.vat-ord
     4476               .
     4477             end.
     4478           end.
     4479         end.
     4480       end.
     4481     end.
     4482     run cur-time in this-procedure
     4483       ( output t_today
     4484       , output j_time
     4485       ) .
     4486     assign
     4487       Under_Line = fill( '-', 123 )
     4488     .
     4489     run prn-lib-open-stream in this-procedure
     4490       ( input p-parent-proc
     4491       , input 62
     4492       , input yes
     4493       , input no
     4494       ) .
     4495     view stream text_out frame    Top_Page .
     4496     view stream text_out frame Bottom_Page .
     4497     assign
     4498       ReportName   = "Товарный отчет в продажных ценах по поставщикам" + chr(10)
     4499                    + substitute( "за период с &1 по &2."
     4500                                , string( x-date-start, "99.99.9999":U )
     4501                                , string( x-date-end,   "99.99.9999":U )
     4502                                )
     4503       ReportHeader = substitute( "Дата печати: &1, время: &2"
     4504                                , string( t_today, "99.99.9999":U )
     4505                                , string( j_time,  "HH:MM:SS":U   )
     4506                                )
     4507     .
     4508     if p-tog-suppl = yes
     4509     then do:
     4510       for  each tt-suppl   no-lock where
     4511                 tt-suppl.is-total    = no use-index i3
     4512         , first bf_clients no-lock where
     4513                 bf_clients.obj-type  = tt-suppl.supp-type and
     4514                 bf_clients.obj-code  = tt-suppl.supp-code
     4515        break by tt-suppl.supp-type
     4516              by tt-suppl.supp-code
     4517              by tt-suppl.ext-doc-grp
     4518              by tt-suppl.ext-doc-ord
     4519       :
     4520         if first-of( tt-suppl.supp-code )
     4521         then do:
     4522           run get-supp-rest in this-procedure
     4523             (  input tt-suppl.supp-type
     4524             ,  input tt-suppl.supp-code
     4525             ,  input "start":U
     4526             ,  input fact-order-from
     4527             , output d_start-rest
     4528             , output d_start-qnty
     4529             ) no-error .
     4530           if error-status :error or
     4531              d_start-rest = ?
     4532           then do:
     4533             assign
     4534               d_start-rest = 0.00
     4535             .
     4536           end.
     4537           put stream text_out unformatted
     4538             string( substitute( 'Поставщик: &1'
     4539                               , bf_clients.obj-name
     4540                               ), "x(80)":U ) skip
     4541             string( substitute( 'Остаток на начало: &1'
     4542                               , trim( string( d_start-rest, "->,>>>,>>>,>>>,>>9.99":U ) )
     4543                               ), "x(80)":U ) skip
     4544           .
     4545           assign
     4546             str3 = substitute( 'Поставщик: &1'
     4547                              , bf_clients.obj-name
     4548                              )
     4549             str4 = substitute( 'Остаток на начало: &1'
     4550                              , trim( string( d_start-rest, "->,>>>,>>>,>>>,>>9.99":U ) )
     4551                              )
     4552           .
     4553           assign
     4554             first_time = ?
     4555           .
     4556           if tt-suppl.ext-doc-ord > 1
     4557           then do:
     4558             assign
     4559               first_time = yes
     4560             .
     4561             do jj = 1 to tt-suppl.ext-doc-ord - 1
     4562             :
     4563               if use-column[ jj ] = yes
     4564               then do:
     4565                 if first_time = yes
     4566                 then do:
     4567                   assign
     4568                     first_time = no
     4569                   .
     4570                   put stream text_out unformatted
     4571                     skip( 1 )
     4572                   .
     4573                 end.
     4574                 run get-xtype-name in this-procedure
     4575                   (  input jj
     4576                   , output v-ext-doc-name
     4577                   ) .
     4578                 put stream text_out unformatted
     4579                   v-ext-doc-name ':' skip
     4580                 .
     4581               end.
     4582             end.
     4583             if first_time = no
     4584             then do:
     4585               put stream text_out unformatted
     4586                 skip( 1 )
     4587               .
     4588             end.
     4589           end.
     4590         end.
     4591         if first-of( tt-suppl.ext-doc-ord )
     4592         then do:
     4593           assign
     4594             j-npp = 0
     4595           .
     4596           run get-xtype-name in this-procedure
     4597             (  input tt-suppl.ext-doc-ord
     4598             , output v-ext-doc-name
     4599             ) .
     4600           case tt-suppl.ext-doc-grp :
     4601             when 1
     4602             then do:
     4603               if line-counter( text_out ) + 9 > page-size( text_out )
     4604               then do:
     4605                 page stream text_out .
     4606               end.
     4607               put stream text_out unformatted
     4608                 v-ext-doc-name                                                                                     ':' skip
     4609                 '----------------------------------------------------------------------------------------------------' skip
     4610                 ': № п/п :              Наименование              :    Дата   :  № документа  :     Стоимость в     :' skip
     4611                 ':       :               контрагента              : документа :               :      продажных      :' skip
     4612                 ':       :                                        :           :               :        ценах        :' skip
     4613                 ':-------:----------------------------------------:-----------:---------------:---------------------:' skip
     4614                 ':   1   :                    2                   :     3     :       4       :          5          :' skip
     4615                 ':-------:----------------------------------------:-----------:---------------:---------------------:' skip
     4616               .
     4617             end.
     4618             when 2
     4619             then do:
     4620               if line-counter( text_out ) + 9 > page-size( text_out )
     4621               then do:
     4622                 page stream text_out .
     4623               end.
     4624               put stream text_out unformatted
     4625                 v-ext-doc-name                                                                                     ':' skip
     4626                 '----------------------------------------------------------------------------------------------------' skip
     4627                 ': № п/п :              Наименование              :    Дата   :  № документа  :      Разница в      :' skip
     4628                 ':       :               контрагента              : документа :               :      продажных      :' skip
     4629                 ':       :                                        :           :               :        ценах        :' skip
     4630                 ':-------:----------------------------------------:-----------:---------------:---------------------:' skip
     4631                 ':   1   :                    2                   :     3     :       4       :          5          :' skip
     4632                 ':-------:----------------------------------------:-----------:---------------:---------------------:' skip
     4633               .
     4634             end.
     4635             when 3
     4636             then do:
     4637               assign
     4638                 j-supp-vat-ord = 0
     4639                 j-add-length   = 0
     4640                 Header-Line1   = "":U
     4641                 Header-Line2   = "":U
     4642                 Header-Line3   = "":U
     4643                 Header-Line4   = "":U
     4644                 Header-Line5   = "":U
     4645                 Header-Line6   = "":U
     4646                 Header-Line7   = "":U
     4647                 Header-Line8   = "":U
     4648                 Label-Line1    = "":U
     4649                 Label-Line2    = "":U
     4650                 Label-Line3    = "":U
     4651                 Format-Line1   = "":U
     4652                 Format-Line2   = "":U
     4653               .
     4654               for each tt-vat-total
     4655               :
     4656                 delete tt-vat-total .
     4657               end.
     4658               assign
     4659                 v-original-code = substitute( '&1#&2-&3&4'
     4660                                             , tt-suppl.supp-type
     4661                                             , tt-suppl.supp-code
     4662                                             , tt-suppl.ext-doc-type
     4663                                             , trim( string( tt-suppl.is-hold-doc = yes, "_hold/":U ) )
     4664                                             )
     4665               .
     4666               find first bf_suppl no-lock where
     4667                          bf_suppl.is-total    = yes                  and
     4668                          bf_suppl.supp-type   = tt-suppl.supp-type   and
     4669                          bf_suppl.supp-code   = tt-suppl.supp-code   and
     4670                          bf_suppl.ext-doc-grp = tt-suppl.ext-doc-grp and
     4671                          bf_suppl.ext-doc-ord = tt-suppl.ext-doc-ord and
     4672                          bf_suppl.orig-code   = v-original-code      no-error .
     4673               if available bf_suppl
     4674               then do:
     4675                 for each tt-supp-vat no-lock where
     4676                          tt-supp-vat.order  = bf_suppl.order
     4677                 break by tt-supp-vat.vat-pc descending
     4678                 :
     4679                   assign
     4680                     j-supp-vat-ord = j-supp-vat-ord +  1
     4681                     j-add-length   = j-add-length   + 13
     4682                     v-tmp-string   = Centering( string( tt-supp-vat.vat-pc, ">>9.<<":U ) + "% НДС", 13 )
     4683                     v-tmp-string   = replace( v-tmp-string, ".%", "%" )
     4684                     Header-Line1   = Header-Line1 + "--------------"
     4685                     Header-Line4   = Header-Line4 + "--------------"
     4686                     Header-Line5   = Header-Line5 + v-tmp-string + fill( " ":U, 13 - length( v-tmp-string ) ) + ":"
     4687                     Header-Line6   = Header-Line6 + "-------------:"
     4688                     Header-Line7   = Header-Line7 + substring( Centering( string( j-supp-vat-ord + 4 ), 13 ) + fill( " ":U, 13 ), 1, 13 ) + ":"
     4689                     Header-Line8   = Header-Line8 + "-------------:"
     4690                   .
     4691                   create tt-vat-total .
     4692                   assign
     4693                     tt-vat-total.vat-ord = tt-supp-vat.vat-ord
     4694                     tt-vat-total.vat-pc  = tt-supp-vat.vat-pc
     4695                     tt-vat-total.vat-sum = ?
     4696                   .
     4697                 end.
     4698               end.
     4699               assign
     4700                 j-supp-vat-ord = j-supp-vat-ord +  1
     4701                 j-add-length   = j-add-length   + 13
     4702                 v-tmp-string   = Centering( string( j-supp-vat-ord + 4 ), 13 )
     4703                 Header-Line1   = Header-Line1 + "-------------"
     4704                 Header-Line2   = Centering(         "Стоимость",         j-add-length + j-supp-vat-ord - 1 )
     4705                 Header-Line3   = Centering( "(сумма в ценах документа)", j-add-length + j-supp-vat-ord - 1 )
     4706                 Header-Line4   = Header-Line4 + "-------------"
     4707                 Header-Line5   = Header-Line5 + "    Итого    "
     4708                 Header-Line6   = Header-Line6 + "-------------"
     4709                 Header-Line7   = Header-Line7 + v-tmp-string + fill( " ":U, 13 - length( v-tmp-string ) ) + ":"
     4710                 Header-Line8   = Header-Line8 + "-------------"
     4711               .
     4712               if line-counter( text_out ) + 10 > page-size( text_out )
     4713               then do:
     4714                 page stream text_out .
     4715               end.
     4716               put stream text_out unformatted
     4717                 v-ext-doc-name              ':' skip
     4718                 '-------------------------------------------------------' + Header-Line1 +
     4719                 '-----------------------------' skip
     4720                 ': № :      Наименование      :   Дата   : № документа :' + Header-Line2 +
     4721                 ':    Сумма    :Сумма в ценах:' skip
     4722                 ':п/п:       контрагента      : документа:             :' + Header-Line3 +
     4723                 ':    скидки   : прайс-листа :' skip
     4724                 ':   :                        :          :             :' + Header-Line4 +
     4725                 ':             :             :' skip
     4726                 ':   :                        :          :             :' + Header-Line5 +
     4727                 ':             :             :' skip
     4728                 ':---:------------------------:----------:-------------:' + Header-Line6 +
     4729                 ':-------------:-------------:' skip
     4730                 ': 1 :            2           :     3    :      4      :' + Header-Line7 +
     4731                 substring( Centering( string( j-supp-vat-ord + 5 ), 13 ) + fill( " ":U, 13 ), 1, 13 ) + ":" +
     4732                 substring( Centering( string( j-supp-vat-ord + 6 ), 13 ) + fill( " ":U, 13 ), 1, 13 ) + ":" skip
     4733                 ':---:------------------------:----------:-------------:' + Header-Line8 +
     4734                 ':-------------:-------------:' skip
     4735               .
     4736             end.
     4737           end case.
     4738         end.
     4739         assign
     4740           j-npp = j-npp + 1
     4741         .
     4742         case tt-suppl.ext-doc-grp :
     4743           when 1
     4744           then do:
     4745             put stream text_out unformatted
     4746                ": " + string( string( j-npp,              ">>>>9":U                 ), "x(5)":U )  +
     4747               " :"  + string(         tt-suppl.cli-name,  "x(40)":U                 )              +
     4748                ": " + string( string( tt-suppl.fact-date, "99/99/9999":U            ), "x(10)":U ) +
     4749                ":"  + string(         tt-suppl.doc-code,  "x(15)":U                 )              +
     4750                ":"  + string( string( tt-suppl.sum-sale,  "->,>>>,>>>,>>>,>>9.99":U ), "x(21)":U ) + ":" skip
     4751             .
     4752           end.
     4753           when 2
     4754           then do:
     4755             put stream text_out unformatted
     4756                ": " + string( string( j-npp,              ">>>>9":U                 ), "x(5)":U )  +
     4757               " :"  + string(         tt-suppl.cli-name,  "x(40)":U                 )              +
     4758                ": " + string( string( tt-suppl.fact-date, "99/99/9999":U            ), "x(10)":U ) +
     4759                ":"  + string(         tt-suppl.doc-code,  "x(15)":U                 )              +
     4760                ":"  + string( string( tt-suppl.sum-sale,  "->,>>>,>>>,>>>,>>9.99":U ), "x(21)":U ) + ":" skip
     4761             .
     4762           end.
     4763           when 3
     4764           then do:
     4765             put stream text_out unformatted
     4766                ":" + string( string( j-npp,              ">>9":U                   ), "x(3)":U )  +
     4767                ":" + string(         tt-suppl.cli-name,  "x(24)":U                 )              +
     4768                ":" + string( string( tt-suppl.fact-date, "99/99/9999":U            ), "x(10)":U ) +
     4769                ":" + string(         tt-suppl.doc-code,  "x(13)":U                 )
     4770             .
     4771             for each tt-supp-vat no-lock where
     4772                      tt-supp-vat.order  = tt-suppl.order
     4773             break by tt-supp-vat.vat-pc descending
     4774             :
     4775               find first tt-vat-total no-lock where
     4776                          tt-vat-total.vat-pc = tt-supp-vat.vat-pc no-error .
     4777               if not available tt-vat-total
     4778               then do:
     4779                 create tt-vat-total .
     4780                 assign
     4781                   tt-vat-total.vat-pc  = tt-supp-vat.vat-pc
     4782                   tt-vat-total.vat-ord = tt-supp-vat.vat-ord
     4783                   tt-vat-total.vat-sum = 0.00
     4784                 .
     4785               end.
     4786               else do:
     4787                 if tt-vat-total.vat-sum = ?
     4788                 then do:
     4789                   assign
     4790                     tt-vat-total.vat-sum = 0.00
     4791                   .
     4792                 end.
     4793               end.
     4794               assign
     4795                 tt-vat-total.vat-sum = tt-vat-total.vat-sum + tt-supp-vat.sum-doc
     4796               .
     4797             end.
     4798             assign
     4799               Document_Total = 0.00
     4800               Discount_Total = 0.00
     4801             .
     4802             for each tt-vat-total no-lock
     4803             break by tt-vat-total.vat-pc descending
     4804             :
     4805               if tt-vat-total.vat-sum = ?
     4806               then do:
     4807                 put stream text_out unformatted
     4808                   ":             ":U
     4809                 .
     4810               end.
     4811               else do:
     4812                 find first tt-supp-vat no-lock where
     4813                            tt-supp-vat.order  = tt-suppl.order      and
     4814                            tt-supp-vat.vat-pc = tt-vat-total.vat-pc no-error .
     4815                 if available tt-supp-vat
     4816                 then do:
     4817                   assign
     4818                     Document_Total = Document_Total + tt-supp-vat.sum-doc
     4819                   .
     4820                   put stream text_out unformatted
     4821                     ":" + string( string( tt-supp-vat.sum-doc, "->,>>>,>>9.99":U ), "x(13)":U )
     4822                   .
     4823                 end.
     4824                 else do:
     4825                   put stream text_out unformatted
     4826                     ":             ":U
     4827                   .
     4828                 end.
     4829               end.
     4830             end.
     4831             assign
     4832               jj = 0
     4833             .
     4834             assign
     4835               Discount_Total = tt-suppl.sum-sale - Document_Total
     4836             .
     4837             put stream text_out unformatted
     4838                ":" string( string( Document_Total,    "->,>>>,>>9.99":U ), "x(13)":U )
     4839                ":" string( string( Discount_Total,    "->,>>>,>>9.99":U ), "x(13)":U )
     4840                ":" string( string( tt-suppl.sum-sale, "->,>>>,>>9.99":U ), "x(13)":U ) ":" skip
     4841             .
     4842           end.
     4843         end case.
     4844         if last-of( tt-suppl.ext-doc-ord )
     4845         then do:
     4846           assign
     4847             v-original-code = substitute( '&1#&2-&3&4'
     4848                                         , tt-suppl.supp-type
     4849                                         , tt-suppl.supp-code
     4850                                         , tt-suppl.ext-doc-type
     4851                                         , trim( string( tt-suppl.is-hold-doc = yes, "_hold/":U ) )
     4852                                         )
     4853           .
     4854           find first bf_suppl no-lock where
     4855                      bf_suppl.is-total    = yes                  and
     4856                      bf_suppl.supp-type   = tt-suppl.supp-type   and
     4857                      bf_suppl.supp-code   = tt-suppl.supp-code   and
     4858                      bf_suppl.ext-doc-grp = tt-suppl.ext-doc-grp and
     4859                      bf_suppl.ext-doc-ord = tt-suppl.ext-doc-ord and
     4860                      bf_suppl.orig-code   = v-original-code      no-error .
     4861           if available bf_suppl
     4862           then do:
     4863             case tt-suppl.ext-doc-grp :
     4864               when 1
     4865               then do:
     4866                 put stream text_out unformatted
     4867                   ':-------:----------------------------------------:-----------:---------------:---------------------:' skip( 0 )
     4868                   ':       :                                        :           : Итого:        :'
     4869                   string( string( bf_suppl.sum-sale, "->,>>>,>>>,>>>,>>9.99":U ), "x(21)":U )                        ':' skip( 0 )
     4870                   '----------------------------------------------------------------------------------------------------' skip( 0 )
     4871                 .
     4872               end.
     4873               when 2
     4874               then do:
     4875                 put stream text_out unformatted
     4876                   ':-------:----------------------------------------:-----------:---------------:---------------------:' skip( 0 )
     4877                   ':       :                                        :           : Итого:        :'
     4878                   string( string( bf_suppl.sum-sale, "->,>>>,>>>,>>>,>>9.99":U ), "x(21)":U )                        ':' skip( 0 )
     4879                   '----------------------------------------------------------------------------------------------------' skip( 0 )
     4880                 .
     4881               end.
     4882               when 3
     4883               then do:
     4884                 assign
     4885                   Document_Total = 0.00
     4886                   Discount_Total = 0.00
     4887                 .
     4888                 put stream text_out unformatted
     4889                   ':---:------------------------:----------:-------------:'
     4890                   fill( '-------------:', j-supp-vat-ord ) '-------------:-------------:' skip( 0 )
     4891                   ':   :                        :          : Итого:      :'
     4892                 .
     4893                 for each bf_supp-vat no-lock where
     4894                          bf_supp-vat.order  = bf_suppl.order and
     4895                          bf_supp-vat.is-tot = yes
     4896                 break by bf_supp-vat.vat-pc descending
     4897                 :
     4898                   assign
     4899                     Document_Total = Document_Total + bf_supp-vat.sum-doc
     4900                   .
     4901                   put stream text_out unformatted
     4902                     string( string( bf_supp-vat.sum-doc, "->,>>>,>>9.99":U ), "x(13)":U ) ':'
     4903                   .
     4904                 end.
     4905                 assign
     4906                   Discount_Total = bf_suppl.sum-sale - Document_Total
     4907                 .
     4908                 put stream text_out unformatted
     4909                   string( string( Document_Total,    "->,>>>,>>9.99":U ), "x(13)":U ) ':'
     4910                   string( string( Discount_Total,    "->,>>>,>>9.99":U ), "x(13)":U ) ':'
     4911                   string( string( bf_suppl.sum-sale, "->,>>>,>>9.99":U ), "x(13)":U ) ':' skip( 0 )
     4912                   '-------------------------------------------------------'
     4913                   fill( '--------------', j-supp-vat-ord ) '----------------------------' skip( 0 )
     4914                 .
     4915                 for each tt-vat-total
     4916                 :
     4917                   delete tt-vat-total .
     4918                 end.
     4919               end.
     4920             end case.
     4921           end.
     4922           assign
     4923             first_time = ?
     4924           .
     4925           find first bf_suppl no-lock where
     4926                      bf_suppl.is-total    = no                   and
     4927                      bf_suppl.supp-type   = tt-suppl.supp-type   and
     4928                      bf_suppl.supp-code   = tt-suppl.supp-code   and
     4929                      bf_suppl.ext-doc-ord > tt-suppl.ext-doc-ord no-error .
     4930           if available bf_suppl
     4931           then do:
     4932             assign
     4933               first_time = yes
     4934             .
     4935             do jj = tt-suppl.ext-doc-ord + 1 to bf_suppl.ext-doc-ord - 1
     4936             :
     4937               if use-column[ jj ] = yes
     4938               then do:
     4939                 if first_time = yes
     4940                 then do:
     4941                   assign
     4942                     first_time = no
     4943                   .
     4944                   put stream text_out unformatted
     4945                     skip( 1 )
     4946                   .
     4947                 end.
     4948                 run get-xtype-name in this-procedure
     4949                   (  input jj
     4950                   , output v-ext-doc-name
     4951                   ) .
     4952                 put stream text_out unformatted
     4953                   v-ext-doc-name ':' skip
     4954                 .
     4955               end.
     4956             end.
     4957             if first_time = no
     4958             then do:
     4959               put stream text_out unformatted
     4960                 skip( 1 )
     4961               .
     4962             end.
     4963           end.
     4964         end.
     4965         if last-of( tt-suppl.supp-code )
     4966         then do:
     4967           assign
     4968             first_time = ?
     4969           .
     4970           if tt-suppl.ext-doc-ord < 18
     4971           then do:
     4972             assign
     4973               first_time = yes
     4974             .
     4975             do jj = tt-suppl.ext-doc-ord + 1 to 18
     4976             :
     4977               if use-column[ jj ] = yes
     4978               then do:
     4979                 if first_time = yes
     4980                 then do:
     4981                   assign
     4982                     first_time = no
     4983                   .
     4984                   put stream text_out unformatted
     4985                     skip( 1 )
     4986                   .
