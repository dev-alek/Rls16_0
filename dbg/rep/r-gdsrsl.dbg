     1648   do on error undo, return error return-value :
     1649   find first cl_tt-clcparts where recid(cl_tt-clcparts) = parrec-parts no-lock.
     1650   for each bf_tt-allsum on error undo, return error return-value :
     1651     delete bf_tt-allsum.
     1652   end.
     1653   assign
     1654     price-rubl-with-tax-loccl = cl_tt-clcparts.price-rubl
     1655     price-base-with-tax-loccl = cl_tt-clcparts.price-base
     1656   .
     1657   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1658   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1659     (output varinvprbcl
