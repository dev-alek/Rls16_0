       92   .
       93   procedure create_obj-list :
       94      define input parameter p-obj-type like ub.clients.obj-type no-undo .
       95      define input parameter p-obj-code like ub.clients.obj-code no-undo .
       96      do
       97      on error undo, return error return-value
       98      :
       99         define buffer cli-obj for ub.clients .
      100         define variable p-var as integer no-undo .
      101         define buffer buf_obj-list for obj-list .
      102         find last buf_obj-list  use-index pi no-error .
      103         if available buf_obj-list
      104         then
      105            p-var = buf_obj-list.obj-id + 1.
      106         else
      107            p-var = 1.
      108         find first cli-obj where
      109                   cli-obj.obj-type = p-obj-type
      110               and cli-obj.obj-code = p-obj-code
      111         no-lock no-error.
      112         if available cli-obj
      113         then do:
      114            create buf_obj-list.
      115            assign
      116               buf_obj-list.obj-id   = p-var
      117               buf_obj-list.obj-code = cli-obj.obj-code
      118               buf_obj-list.obj-type = cli-obj.obj-type
      119               buf_obj-list.obj-name = cli-obj.obj-name
      120               buf_obj-list.db-num   = cli-obj.db-num
      121            .
      122         end.
      123      end.
      124   end.
