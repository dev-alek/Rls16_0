      609   FUNCTION get-curr RETURNS CHARACTER
      610     (buffer loc-wealth for ub.wealth ) :
      611   define buffer buf_currency for ub.currency.
      612   if loc-wealth.curr-code = ? or loc-wealth.is-money = no then
      613   return loc-wealth.unit-base.
      614   FIND FIRST buf_currency no-lock where
      615             buf_currency.curr-code = loc-wealth.curr-code No-ERROR.
      616   if avail buf_currency then
      617     RETURN buf_currency.curr-abbr.
      618   else return "".
      619   END FUNCTION.
      620   define variable dopd1 as decimal no-undo .
      621   define variable dopd2 as decimal no-undo .
      622   for each t-5
      623   :
      624     delete t-5 .
      625   end.
      626   for each ub.wth-obj no-lock where
      627            ub.wth-obj.obj-type = pobj-type and
      628            ub.wth-obj.obj-code = pobj-code
      629   :
      630     find first ub.wealth no-lock where
      631                ub.wealth.wth-code = ub.wth-obj.wth-code no-error .
      632     create t-5.
      633     assign
      634       t-5.wth-code = ub.wth-obj.wth-code
      635       t-5.wth-name = ( if available ub.wealth then ub.wealth.wth-name else "НЕИЗВЕСТНАЯ МЦ" )
      636     .
      637     run wth-lib_full-inf-shift-inter(
      638       input pobj-type,
      639       input pobj-code,
      640       input wth-obj.wth-code,
      641       input pshift-date,
      642       input pshift-num,
      643       input pshift-date1,
      644       input pshift-num1
      645       , output t-5.stock-before
      646       , output t-5.stock-after
      647       , output dopd1
      648       , output t-5.income-cassa
      649       , output t-5.income-other
      650       , output dopd2
      651       , output t-5.incass-bank
      652       , output t-5.incass-other
      653       , output t-5.incass-cassa
      654       ) no-error .
      655   end.
