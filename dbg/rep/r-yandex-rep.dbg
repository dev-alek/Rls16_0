     2878               '       <td style="text-align: right; font-weight: normal">' + string(tt-itog.qnty-only-TH) + '</td>' skip
     2879               '       <td colspan = "9"></td>' skip
     2880               '       </tr>' skip
     2881               '       <tr>' skip
     2882               '       <td colspan = "2"></td>' skip
     2883               '       <td colspan = "3" style="text-align: left; font-weight: normal">только Яндекс: </td>' skip
     2884               '       <td style="text-align: right; font-weight: normal">' + string(tt-itog.qnty-RN) + '</td>' skip
     2885               '       <td colspan = "9"></td>' skip
     2886               '       </tr>' skip
     2887               '       <tr>' skip
