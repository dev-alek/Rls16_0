     2504                       '         <td  num="0.00" val="' + fnc-convert-dot-to-colon(tt-obj.qnty-TH,"->>>>>>>>>>>>>9.99",2) + '" style="text-align: right; font-weight: normal; background-color: yellow;">' + fnc-convert-dot-to-colon(tt-obj.qnty-TH,"->>>>>>>>>>>>>9.99",2) + '</td>' skip
     2505                       '         <td  num="0.00" val="' + fnc-convert-dot-to-colon(tt-obj.summ-TH,"->>>>>>>>>>>>>9.99",2) + '" style="text-align: right; font-weight: normal; background-color: yellow;">' + fnc-convert-dot-to-colon(tt-obj.summ-TH,"->>>>>>>>>>>>>9.99",2) + '</td>' skip
     2506                       '         <td  num="0.00" val="' + fnc-convert-dot-to-colon(tt-obj.qnty-RN-cart,"->>>>>>>>>>>>>9.99",2) + '" style="text-align: right; font-weight: normal; background-color: yellow;">' + fnc-convert-dot-to-colon(tt-obj.qnty-RN-cart,"->>>>>>>>>>>>>9.99",2) + '</td>' skip
     2507                       '         <td  num="0.00" val="' + fnc-convert-dot-to-colon(tt-obj.summ-RN-cart,"->>>>>>>>>>>>>9.99",2) + '" style="text-align: right; font-weight: normal; background-color: yellow;">' + fnc-convert-dot-to-colon(tt-obj.summ-RN-cart,"->>>>>>>>>>>>>9.99",2) + '</td>' skip
     2508                       '         <td  num="0.00" val="' + fnc-convert-dot-to-colon((tt-obj.qnty-TH - tt-obj.qnty-RN-cart),"->>>>>>>>>>>>>9.99",2) + '" style="text-align: right; font-weight: normal; background-color: yellow;">' + fnc-convert-dot-to-colon((tt-obj.qnty-TH - tt-obj.qnty-RN-cart),"->>>>>>>>>>>>>9.99",2) + '</td>' skip
     2509                       '         <td  num="0.00" val="' + fnc-convert-dot-to-colon((tt-obj.summ-TH - tt-obj.summ-RN-cart),"->>>>>>>>>>>>>9.99",2) + '" style="text-align: right; font-weight: normal; background-color: yellow;">' + fnc-convert-dot-to-colon((tt-obj.summ-TH - tt-obj.summ-RN-cart),"->>>>>>>>>>>>>9.99",2) + '</td>' skip
     2510                       '         <td style="text-align: right; font-weight: normal; background-color: yellow;"><br></td>' skip
     2511                       '         <td style="text-align: right; font-weight: normal; background-color: yellow;"><br></td>' skip
     2512                       '         <td style="text-align: right; font-weight: normal; background-color: yellow;"><br></td>' skip
     2513                       '         <td style="text-align: right; font-weight: normal; background-color: yellow;"><br></td>' skip
     2514                       '         <td style="text-align: right; font-weight: normal; background-color: yellow;"><br></td>' skip
     2515                       '         <td style="text-align: right; font-weight: normal; background-color: yellow;"><br></td>' skip
     2516                       '       </tr>' skip
     2517                       .
     2518               if tt-obj.obj-name = ""
     2519                   then
     2520                   put stream OutStr-html unformatted
     2521                       '       <tr>' skip
     2522                       '         <td colspan = "13" style="text-align: left; font-weight: normal; background-color: yellow;">Расхождения</td>' skip
     2523                       '       </tr>' skip
     2524                       .
     2525               for each tt-shift where tt-shift.obj-type = tt-obj.obj-type
     2526                   and tt-shift.obj-code = tt-obj.obj-code
     2527                   :
     2528                   if tt-shift.shift-date <> ?
     2529                       then
     2530                       put stream OutStr-html unformatted
     2531                           '       <tr level="2">' skip
     2532                           '         <td style="text-align: left; font-weight: normal; background-color: yellow;">  Смена №' + string(tt-shift.shift-num) + ' от ' + string(tt-shift.shift-date) + '</td>' skip
     2533                           '         <td  num="0.00" val="' + fnc-convert-dot-to-colon(tt-shift.qnty-TH,"->>>>>>>>>>>>>9.99",2) + '" style="text-align: right; font-weight: normal; background-color: yellow;">' + fnc-convert-dot-to-colon(tt-shift.qnty-TH,"->>>>>>>>>>>>>9.99",2) + '</td>' skip
     2534                           '         <td  num="0.00" val="' + fnc-convert-dot-to-colon(tt-shift.summ-TH,"->>>>>>>>>>>>>9.99",2) + '" style="text-align: right; font-weight: normal; background-color: yellow;">' + fnc-convert-dot-to-colon(tt-shift.summ-TH,"->>>>>>>>>>>>>9.99",2) + '</td>' skip
     2535                           '         <td  num="0.00" val="' + fnc-convert-dot-to-colon(tt-shift.qnty-RN-cart,"->>>>>>>>>>>>>9.99",2) + '" style="text-align: right; font-weight: normal; background-color: yellow;">' + fnc-convert-dot-to-colon(tt-shift.qnty-RN-cart,"->>>>>>>>>>>>>9.99",2) + '</td>' skip
     2536                           '         <td  num="0.00" val="' + fnc-convert-dot-to-colon(tt-shift.summ-RN-cart,"->>>>>>>>>>>>>9.99",2) + '" style="text-align: right; font-weight: normal; background-color: yellow;">' + fnc-convert-dot-to-colon(tt-shift.summ-RN-cart,"->>>>>>>>>>>>>9.99",2) + '</td>' skip
     2537                           '         <td  num="0.00" val="' + fnc-convert-dot-to-colon((tt-shift.qnty-TH - tt-shift.qnty-RN-cart),"->>>>>>>>>>>>>9.99",2) + '" style="text-align: right; font-weight: normal; background-color: yellow;">' + fnc-convert-dot-to-colon((tt-shift.qnty-TH - tt-shift.qnty-RN-cart),"->>>>>>>>>>>>>9.99",2) + '</td>' skip
     2538                           '         <td  num="0.00" val="' + fnc-convert-dot-to-colon((tt-shift.summ-TH - tt-shift.summ-RN-cart),"->>>>>>>>>>>>>9.99",2) + '" style="text-align: right; font-weight: normal; background-color: yellow;">' + fnc-convert-dot-to-colon((tt-shift.summ-TH - tt-shift.summ-RN-cart),"->>>>>>>>>>>>>9.99",2) + '</td>' skip
     2539                           '         <td style="text-align: right; font-weight: normal; background-color: yellow;"><br></td>' skip
     2540                           '         <td style="text-align: right; font-weight: normal; background-color: yellow;"><br></td>' skip
     2541                           '         <td style="text-align: right; font-weight: normal; background-color: yellow;"><br></td>' skip
     2542                           '         <td style="text-align: right; font-weight: normal; background-color: yellow;"><br></td>' skip
     2543                           '         <td style="text-align: right; font-weight: normal; background-color: yellow;"><br></td>' skip
     2544                           '         <td style="text-align: right; font-weight: normal; background-color: yellow;"><br></td>' skip
     2545                           '       </tr>' skip
     2546                           .
     2547                   for each tt-rep where tt-rep.obj-type   = tt-shift.obj-type
     2548                       and tt-rep.obj-code   = tt-shift.obj-code
     2549                       and tt-rep.shift-date = tt-shift.shift-date
     2550                       and tt-rep.shift-num  = tt-shift.shift-num
     2551                       :
     2552                           if tt-rep.qnty-TH <> tt-rep.qnty-RN-cart or round(tt-rep.summ-TH,2) <> tt-rep.summ-RN-cart then v-color = "#FFB6C1" .
     2553                       else v-color = "white" .
     2554                       put stream OutStr-html unformatted
     2555                           '       <tr level="3">' skip
     2556                           '         <td style="text-align: left; font-weight: normal; background-color: ' + v-color + ';">' + "    " + tt-rep.gds-name + '</td>' skip
     2557                           '         <td num="0.00" val="' + fnc-convert-dot-to-colon(tt-rep.qnty-TH,"->>>>>>>>>>>>>9.99",2) + '" style="text-align: right; font-weight: normal; background-color: ' + v-color + ';">' + (if tt-rep.qnty-TH = 0 then " " else fnc-convert-dot-to-colon(tt-rep.qnty-TH,"->>>>>>>>>>>>>9.99",2)) + '</td>' skip
     2558                           '         <td num="0.00" val="' + fnc-convert-dot-to-colon(tt-rep.summ-TH,"->>>>>>>>>>>>>9.99",2) + '" style="text-align: right; font-weight: normal; background-color: ' + v-color + ';">' + (if tt-rep.summ-TH = 0 then " " else fnc-convert-dot-to-colon(tt-rep.summ-TH,"->>>>>>>>>>>>>9.99",2)) + '</td>' skip
     2559                           '         <td num="0.00" val="' + fnc-convert-dot-to-colon(tt-rep.qnty-RN-cart,"->>>>>>>>>>>>>9.99",2) + '" style="text-align: right; font-weight: normal; background-color: ' + v-color + ';">' + (if tt-rep.qnty-RN-cart = 0 then " " else fnc-convert-dot-to-colon(tt-rep.qnty-RN-cart,"->>>>>>>>>>>>>9.99",2)) + '</td>' skip
     2560                           '         <td num="0.00" val="' + fnc-convert-dot-to-colon(tt-rep.summ-RN-cart,"->>>>>>>>>>>>>9.99",2) + '" style="text-align: right; font-weight: normal; background-color: ' + v-color + ';">' + (if tt-rep.summ-RN-cart = 0 then " " else fnc-convert-dot-to-colon(tt-rep.summ-RN-cart,"->>>>>>>>>>>>>9.99",2)) + '</td>' skip
     2561                           '         <td num="0.00" val="' + fnc-convert-dot-to-colon((tt-rep.qnty-TH - tt-rep.qnty-RN-cart),"->>>>>>>>>>>>>9.99",2) + '" style="text-align: right; font-weight: normal; background-color: ' + v-color + ';">' + fnc-convert-dot-to-colon((tt-rep.qnty-TH - tt-rep.qnty-RN-cart),"->>>>>>>>>>>>>9.99",2) + '</td>' skip
     2562                           '         <td num="0.00" val="' + fnc-convert-dot-to-colon((tt-rep.summ-TH - tt-rep.summ-RN-cart),"->>>>>>>>>>>>>9.99",2) + '" style="text-align: right; font-weight: normal; background-color: ' + v-color + ';">' + fnc-convert-dot-to-colon((tt-rep.summ-TH - tt-rep.summ-RN-cart),"->>>>>>>>>>>>>9.99",2) + '</td>' skip
     2563                           '         <td style="text-align: right; font-weight: normal; background-color: ' + v-color + ';">' + (if tt-rep.dt-TH <> ? then string(tt-rep.dt-TH,"99.99.9999") + " " + tt-rep.time-TH else " ") + '</td>' skip
     2564                           '         <td style="text-align: right; font-weight: normal; background-color: ' + v-color + ';">' + (if tt-rep.dt-RN-cart <> ? then string(tt-rep.dt-RN-cart, "99.99.9999 HH:MM:SS") else " ") + '</td>' skip
     2565                           '         <td style="text-align: right; font-weight: normal; background-color: ' + v-color + ';">' + tt-rep.RRN-RN + '</td>' skip
