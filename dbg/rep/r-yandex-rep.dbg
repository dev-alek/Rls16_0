      222     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      223     define input parameter p-report-name-html as character no-undo .
      224     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      225   end procedure.
      226   procedure prn-lib-reportviewer :
      227     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      228     define input parameter p-report-name-html as character no-undo .
      229     define input parameter p-param        as character no-undo .
      230     define variable v-excel           as character no-undo init 'TRUE' .
      231     define variable v-value-character as character no-undo .
      232     define variable v-value-integer   as character no-undo .
      233     define variable v-value-date      as date      no-undo .
      234     define variable v-value-decimal   as decimal   no-undo .
      235     define variable rep-excel         as logical   no-undo .
      236     define variable excel-string      as character no-undo .
      237     define variable v-param-type      as character no-undo .
      238     define variable v-tth             as handle    no-undo .
      239     run adm/shattri.p (
      240       input "get":U
      241       ,input  ""
      242       ,input  0
      243       ,input  'report-glob':U
      244       ,input  'rep-excel':U
      245       ,output v-value-character
      246       ,output v-value-date
      247       ,output v-value-decimal
      248       ,output v-value-integer
      249       ,output rep-excel
      250       ,output v-param-type
      251       ,INPUT-OUTPUT table-handle v-tth
      252       )  .
      253     if rep-excel then v-excel = "TRUE" .
      254     else v-excel = "FALSE" .
      255     if p-param eq ""
      256     then
      257        p-param = "EXCEL:" + v-excel.
      258     else
      259        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      260     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      261   end procedure.
