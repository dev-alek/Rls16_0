      335   procedure create_obj-list :
      336      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      337      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      338      do
      339      on error undo, return error return-value
      340      :
      341         define buffer cli-obj for ub.clients .
      342         define variable p-var as integer no-undo .
      343         define buffer buf_obj-list for obj-list .
      344         find last buf_obj-list  use-index pi no-error .
      345         if available buf_obj-list
      346         then
      347            p-var = buf_obj-list.obj-id + 1.
      348         else
      349            p-var = 1.
      350         find first cli-obj where
      351                   cli-obj.obj-type = p-obj-type
      352               and cli-obj.obj-code = p-obj-code
      353         no-lock no-error.
      354         if available cli-obj
      355         then do:
      356            create buf_obj-list.
      357            assign
      358               buf_obj-list.obj-id   = p-var
      359               buf_obj-list.obj-code = cli-obj.obj-code
      360               buf_obj-list.obj-type = cli-obj.obj-type
      361               buf_obj-list.obj-name = cli-obj.obj-name
      362               buf_obj-list.db-num   = cli-obj.db-num
      363            .
      364         end.
      365      end.
      366   end.
