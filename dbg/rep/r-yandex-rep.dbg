     2467           '<td colspan="13" style="text-align: left; font-weight:bold;"><br></td>' skip
     2468           '</tr>' skip
     2469           '<tr>' skip
     2470           '<td colspan="13" style="text-align: left; font-weight:bold;">Параметры: ' + v-period + '</td>' skip
     2471           '</tr>' skip
     2472           '<tr>' skip
     2473           '<td colspan="13" style="text-align: left; font-weight:bold;"><br></td>' skip
     2474           '</tr>' skip
     2475           '</thead>' skip
     2476           .
     2477       put stream OutStr-html unformatted
     2478           '     <tbody>' skip
     2479           '       <tr>' skip
     2480           '         <th style="text-align: center; font-weight:bold; background-color: silver; height: 30px">Номенклатура</th>' skip
     2481           '         <th style="text-align: center; font-weight:bold; background-color: silver;">Литры ГБД</th>' skip
     2482           '         <th style="text-align: center; font-weight:bold; background-color: silver;">Сумма ГБД</th>' skip
     2483           '         <th style="text-align: center; font-weight:bold; background-color: silver;">Литры РН-Карт</th>' skip
     2484           '         <th style="text-align: center; font-weight:bold; background-color: silver;">Сумма РН-Карт</th>' skip
     2485           '         <th style="text-align: center; font-weight:bold; background-color: silver;">Расхождение литры</th>' skip
     2486           '         <th style="text-align: center; font-weight:bold; background-color: silver;">Расхождение сумма</th>' skip
     2487           '         <th style="text-align: center; font-weight:bold; background-color: silver;">Дата ГБД</th>' skip
     2488           '         <th style="text-align: center; font-weight:bold; background-color: silver;">Дата РН-Карт</th>' skip
     2489           '         <th style="text-align: center; font-weight:bold; background-color: silver;">RRN РН-Карт</th>' skip
