     1829   end .
     1830   procedure make-rep :
     1831       define buffer buf_chk-gds-pay  for ub.chk-gds-pay .
     1832       define buffer buf_chk-pay-attr for ub.chk-pay-attr .
     1833       define buffer buf_chk-doc      for ub.chk-doc .
     1834       define buffer buf_chk-gds      for ub.chk-gds .
     1835       define buffer buf_goods        for ub.goods .
     1836       define variable v-RRN  as character no-undo .
     1837       define variable v-date as date      no-undo .
     1838       define variable v-time as integer   no-undo .
     1839       empty TEMP-TABLE tt-itog .
     1840       create tt-itog .
     1841       if p-RRN > ""
     1842           then
     1843       do :
     1844           find first buf_chk-pay-attr no-lock where buf_chk-pay-attr.attr-code = "CPDOC"
     1845               and buf_chk-pay-attr.attr-value = p-RRN
     1846               no-error .
     1847           if not available buf_chk-pay-attr
     1848               then
     1849           do :
     1850               find first buf_chk-pay-attr no-lock where buf_chk-pay-attr.attr-code = "CPDOC"
     1851                   and int64(buf_chk-pay-attr.attr-value) = int64(p-RRN)
     1852                   no-error .
     1853           end .
     1854           if not available buf_chk-pay-attr
     1855               then
     1856           do :
