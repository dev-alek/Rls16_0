     2192               tt-obj.summ-TH      = tt-obj.summ-TH      + tt-rep.summ-TH
     2193               tt-obj.qnty-RN-cart = tt-obj.qnty-RN-cart + tt-rep.qnty-RN-cart
     2194               tt-obj.summ-RN-cart = tt-obj.summ-RN-cart + tt-rep.summ-RN-cart
     2195               tt-obj.qnty-yandex  = tt-obj.qnty-yandex  + tt-rep.qnty-yandex
     2196               tt-obj.summ-yandex  = tt-obj.summ-yandex  + tt-rep.summ-yandex
     2197               .
