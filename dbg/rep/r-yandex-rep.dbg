     1705   define buffer buf_shift-obj for ub.shift-obj .
     1706   define variable v-full-path-RepView as character no-undo.
     1707   define variable v-file-name-rep-htm as character no-undo.
     1708   define variable g#report-num        as integer   no-undo.
     1709   define variable v-report-name       as character no-undo.
     1710   define variable v-azk-list          as character no-undo .
