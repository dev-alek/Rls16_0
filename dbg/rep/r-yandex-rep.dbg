     2158           by tt-rep.obj-code
     2159           by tt-rep.shift-date
     2160           by tt-rep.shift-num
     2161           :
     2162           if first-of(tt-rep.obj-type)
     2163               or first-of(tt-rep.obj-code)
     2164               then
     2165           do :
     2166               create tt-obj .
     2167               assign
     2168                   tt-obj.obj-type = tt-rep.obj-type
     2169                   tt-obj.obj-code = tt-rep.obj-code
     2170                   .
     2171               for first obj-list no-lock where obj-list.obj-type = tt-rep.obj-type
     2172                   and obj-list.obj-code = tt-rep.obj-code
     2173                   :
