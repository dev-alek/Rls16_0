     2114                               tt-rep.time-TH    = string(truncate (buf_chk-gds-pay.chk-time / 3600, 0)) + ":" + string((buf_chk-gds-pay.chk-time modulo 3600) / 60,"99") + ":" + string((buf_chk-gds-pay.chk-time modulo 3600) / 360,"99")
     2115                               tt-rep.shift-date = buf_chk-gds-pay.shift-date
