     2450           '<td style="width: 90px; border: none;"></td>' skip
     2451           '<td style="width: 90px; border: none;"></td>' skip
     2452           '<td style="width: 90px; border: none;"></td>' skip
     2453           '<td style="width: 90px; border: none;"></td>' skip
     2454           '<td style="width: 90px; border: none;"></td>' skip
     2455           '<td style="width: 90px; border: none;"></td>' skip
     2456           '<td style="width: 90px; border: none;"></td>' skip
     2457           '</tr>' skip
     2458           .
     2459       put stream OutStr-html unformatted
     2460           '<tr>' skip
     2461           '<td colspan="13" style="text-align: left; font-weight:bold;"></td>' skip
     2462           '</tr>' skip
     2463           '<tr>' skip
     2464           '<td colspan="13" style="text-align: center; font-weight:bold;">Отчет по сверке продаж по Юр. Лицам по ' + v-azk-list + '</td>' skip
     2465           '</tr>' skip
