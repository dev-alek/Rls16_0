     2200               tt-shift.summ-TH      = tt-shift.summ-TH      + tt-rep.summ-TH
     2201               tt-shift.qnty-RN-cart = tt-shift.qnty-RN-cart + tt-rep.qnty-RN-cart
     2202               tt-shift.summ-RN-cart = tt-shift.summ-RN-cart + tt-rep.summ-RN-cart
     2203               tt-shift.qnty-yandex  = tt-shift.qnty-yandex  + tt-rep.qnty-yandex
     2204               tt-shift.summ-yandex  = tt-shift.summ-yandex  + tt-rep.summ-yandex
     2205               .
     2206           if last-of(tt-rep.obj-type)
     2207               or last-of(tt-rep.obj-code)
     2208               then
     2209           do :
     2210               release tt-obj .
     2211           end .
     2212           if last-of(tt-rep.shift-date)
     2213               or last-of(tt-rep.shift-num)
     2214               then
     2215           do :
     2216               release tt-shift .
     2217           end .
     2218       end .
     2219   end procedure .
     2220   procedure imp-RN-cart :
     2221       DEFINE VARIABLE mExcelApplication AS COMPONENT-HANDLE NO-UNDO.
     2222       DEFINE VARIABLE mWorkBook         AS COMPONENT-HANDLE NO-UNDO.
     2223       DEFINE VARIABLE mWorkSheet        AS COMPONENT-HANDLE NO-UNDO.
     2224       DEFINE VARIABLE mMaxNoLine        AS INTEGER          INITIAL 10 NO-UNDO.
     2225       DEFINE VARIABLE vLine             AS INTEGER          NO-UNDO.
     2226       DEFINE VARIABLE vChLine           AS CHARACTER        NO-UNDO.
     2227       DEFINE VARIABLE vCh               AS CHARACTER        NO-UNDO.
     2228       DEFINE VARIABLE vNoLine           AS INTEGER          NO-UNDO.
     2229       define variable v-num             as character        no-undo .
     2230       define variable v-azk             as character        no-undo .
     2231       define variable v-summ            as character        no-undo .
     2232       define variable v-qnty            as character        no-undo .
     2233       define variable v-dt              as character        no-undo .
     2234       define variable v-RRN             as character        no-undo .
     2235       define variable v-transID         as character        no-undo .
     2236       define variable v-gds-name        as character        no-undo .
     2237       CREATE "Excel.Application":U mExcelApplication no-error.
     2238       if error-status :error then do:
     2239           message
     2240           "Ошибка при запуске Excel" skip
     2241           error-status :get-message(1) skip
     2242           view-as alert-box error .
     2243           undo, return error .
     2244       end.
     2245       ASSIGN
     2246           mExcelApplication:DisplayAlerts = NO
     2247           mWorkbook                       = mExcelApplication:WorkBooks:Add(p-file)
     2248           mWorkSheet                      = mWorkbook:Sheets:Item(1)
     2249           .
     2250       loopbl:
     2251       do vLine = 1 to 1000000:
     2252           ASSIGN
     2253               vChLine    = STRING(vLine)
     2254               v-azk      = ''
     2255               v-summ     = ''
     2256               v-qnty     = ''
     2257               v-dt       = ''
     2258               v-RRN      = ''
     2259               v-transID  = ''
     2260               v-gds-name = ''
     2261               .
     2262           v-RRN = mWorkSheet:Range("P" + vChLine):FORMULA NO-ERROR.
     2263           if v-RRN = ? then v-RRN = mWorkSheet:Range("P" + vChLine):VALUE NO-ERROR.
     2264           if p-RRN > ""
     2265               then
     2266           do :
     2267               if int64(p-RRN) <> int64(v-RRN) then next loopbl .
     2268           end .
     2269           v-num = mWorkSheet:Range("A" + vChLine):FORMULA NO-ERROR.
     2270           if v-num = ? then v-num = mWorkSheet:Range("A" + vChLine):VALUE NO-ERROR.
     2271           integer(v-num) no-error .
     2272           if error-status:error then next loopbl .
     2273           v-azk = mWorkSheet:Range("C" + vChLine):FORMULA NO-ERROR.
     2274           if v-azk = ? then v-azk = mWorkSheet:Range("C" + vChLine):VALUE NO-ERROR.
     2275           v-summ = mWorkSheet:Range("M" + vChLine):FORMULA NO-ERROR.
     2276           if v-summ = ? then v-summ = mWorkSheet:Range("M" + vChLine):VALUE NO-ERROR.
     2277           v-summ = replace(v-summ, ",", ".") .
     2278           decimal(v-summ) no-error .
     2279           if error-status:error then next loopbl .
     2280           v-qnty = mWorkSheet:Range("K" + vChLine):FORMULA NO-ERROR.
     2281           if v-qnty = ? then v-qnty = mWorkSheet:Range("K" + vChLine):VALUE NO-ERROR.
     2282           v-qnty = replace(v-qnty, ",", ".") .
     2283           v-dt = mWorkSheet:Range("E" + vChLine):VALUE NO-ERROR.
     2284           if v-dt = ? then v-dt = mWorkSheet:Range("E" + vChLine):FORMULA NO-ERROR.
     2285           v-transID = mWorkSheet:Range("H" + vChLine):FORMULA NO-ERROR.
     2286           if v-transID = ? then v-transID = mWorkSheet:Range("H" + vChLine):VALUE NO-ERROR.
     2287           v-gds-name = mWorkSheet:Range("J" + vChLine):VALUE NO-ERROR.
     2288           if v-gds-name = ? then v-gds-name = mWorkSheet:Range("J" + vChLine):FORMULA NO-ERROR.
     2289           if length(v-azk) > 0
     2290               or length(v-summ) > 0
     2291               or length(v-qnty) > 0
     2292               or length(v-dt) > 0
     2293               or length(v-RRN) > 0
     2294               or length(v-transID) > 0
     2295               or length(v-gds-name) > 0
     2296               then
     2297           do :
     2298               vNoLine = 0 .
     2299           end.
     2300           else
     2301           do :
     2302               vNoLine = vNoLine + 1.
     2303               IF vNoLine > mMaxNoLine THEN LEAVE loopbl.
     2304               ELSE NEXT loopbl.
     2305           end.
     2306           create tt-trans .
     2307           tt-trans.azk       = v-azk .
     2308           tt-trans.qnty      = decimal(v-qnty) .
     2309           tt-trans.summ      = decimal(v-summ) .
     2310           tt-trans.dt        = datetime(v-dt) .
     2311           tt-trans.RRN       = trim(v-RRN) .
     2312           tt-trans.transID   = trim(v-transID) .
     2313           tt-trans.gds-name  = v-gds-name .
     2314           tt-trans.taken     = false .
     2315           release tt-trans .
     2316       end.
     2317   end procedure .
     2318   procedure imp-yandex :
     2319       DEFINE VARIABLE mExcelApplication AS COMPONENT-HANDLE NO-UNDO.
     2320       DEFINE VARIABLE mWorkBook         AS COMPONENT-HANDLE NO-UNDO.
     2321       DEFINE VARIABLE mWorkSheet        AS COMPONENT-HANDLE NO-UNDO.
     2322       DEFINE VARIABLE mMaxNoLine        AS INTEGER          INITIAL 10 NO-UNDO.
     2323       DEFINE VARIABLE vLine             AS INTEGER          NO-UNDO.
     2324       DEFINE VARIABLE vChLine           AS CHARACTER        NO-UNDO.
     2325       DEFINE VARIABLE vCh               AS CHARACTER        NO-UNDO.
     2326       DEFINE VARIABLE vNoLine           AS INTEGER          NO-UNDO.
     2327       define variable v-num             as character        no-undo .
     2328       define variable v-azk             as character        no-undo .
     2329       define variable v-summ            as character        no-undo .
     2330       define variable v-qnty            as character        no-undo .
     2331       define variable v-dt              as character        no-undo .
     2332       define variable v-RRN             as character        no-undo .
     2333       define variable v-transID         as character        no-undo .
     2334       define variable v-gds-name        as character        no-undo .
     2335       define variable v-date            as character        no-undo .
     2336       define variable v-time            as character        no-undo .
     2337       CREATE "Excel.Application":U mExcelApplication no-error.
     2338       if error-status :error then do:
     2339           message
     2340           "Ошибка при запуске Excel" skip
     2341           error-status :get-message(1) skip
     2342           view-as alert-box error .
     2343           undo, return error .
     2344       end.
     2345       ASSIGN
     2346           mExcelApplication:DisplayAlerts = NO
     2347           mWorkbook                       = mExcelApplication:WorkBooks:Add(p-file)
     2348           mWorkSheet                      = mWorkbook:Sheets:Item(1)
     2349           .
     2350       loopbl:
     2351       do vLine = 1 to 1000000:
     2352           ASSIGN
     2353               vChLine    = STRING(vLine)
     2354               v-azk      = ''
     2355               v-summ     = ''
     2356               v-qnty     = ''
     2357               v-dt       = ''
     2358               v-RRN      = ''
     2359               v-transID  = ''
     2360               v-gds-name = ''
     2361               .
     2362           v-RRN = mWorkSheet:Range("P" + vChLine):FORMULA NO-ERROR.
     2363           if v-RRN = ? then v-RRN = mWorkSheet:Range("P" + vChLine):VALUE NO-ERROR.
     2364           if p-RRN > ""
     2365               then
     2366           do :
     2367               if int64(p-RRN) <> int64(v-RRN) then next loopbl .
     2368           end .
     2369           v-azk = mWorkSheet:Range("B" + vChLine):VALUE NO-ERROR.
     2370           if v-azk = ? then v-azk = mWorkSheet:Range("C" + vChLine):FORMULA NO-ERROR.
     2371           v-summ = mWorkSheet:Range("M" + vChLine):FORMULA NO-ERROR.
     2372           if v-summ = ? then v-summ = mWorkSheet:Range("M" + vChLine):VALUE NO-ERROR.
     2373           v-summ = replace(v-summ, ",", ".") .
     2374           decimal(v-summ) no-error .
     2375           if error-status:error then next loopbl .
     2376           v-qnty = mWorkSheet:Range("K" + vChLine):FORMULA NO-ERROR.
     2377           if v-qnty = ? then v-qnty = mWorkSheet:Range("K" + vChLine):VALUE NO-ERROR.
     2378           v-qnty = replace(v-qnty, ",", ".") .
     2379           v-date = mWorkSheet:Range("E" + vChLine):VALUE NO-ERROR.
     2380           if v-date = ? then v-date = mWorkSheet:Range("E" + vChLine):FORMULA NO-ERROR.
     2381           v-time = mWorkSheet:Range("F" + vChLine):FORMULA NO-ERROR.
     2382           if v-time = ? then v-time = mWorkSheet:Range("F" + vChLine):VALUE NO-ERROR.
     2383           v-dt = v-date + "  " + v-time .
     2384           v-dt = trim(v-dt) .
     2385           v-transID = mWorkSheet:Range("H" + vChLine):FORMULA NO-ERROR.
     2386           if v-transID = ? then v-transID = mWorkSheet:Range("H" + vChLine):VALUE NO-ERROR.
     2387           v-gds-name = mWorkSheet:Range("N" + vChLine):VALUE NO-ERROR.
     2388           if v-gds-name = ? then v-gds-name = mWorkSheet:Range("N" + vChLine):FORMULA NO-ERROR.
     2389           if length(v-azk) > 0
     2390               or length(v-summ) > 0
     2391               or length(v-qnty) > 0
     2392               or length(v-dt) > 0
     2393               or length(v-RRN) > 0
     2394               or length(v-transID) > 0
     2395               or length(v-gds-name) > 0
     2396               then
     2397           do :
     2398               vNoLine = 0 .
     2399           end.
     2400           else
     2401           do :
     2402               vNoLine = vNoLine + 1.
     2403               IF vNoLine > mMaxNoLine THEN LEAVE loopbl.
     2404               ELSE NEXT loopbl.
     2405           end.
     2406           create tt-trans .
     2407           tt-trans.azk       = v-azk .
     2408           tt-trans.qnty      = decimal(v-qnty) .
     2409           tt-trans.summ      = decimal(v-summ) .
     2410           tt-trans.dt        = datetime(v-dt) .
     2411           tt-trans.RRN       = trim(v-RRN) .
     2412           tt-trans.transID   = trim(v-transID) .
     2413           tt-trans.gds-name  = v-gds-name .
     2414           tt-trans.taken     = false .
     2415           release tt-trans .
     2416       end.
     2417   end procedure .
     2418   procedure my-rep-ul :
     2419       run get-full-path-RepViewer(output v-full-path-RepView).
     2420       run get-report-num in parParentProc(output g#report-num).
     2421       run define-full-path-Report(input g#report-num, output v-file-name-rep-htm).
     2422       run create-file(v-file-name-rep-htm).
     2423       run waitfram-show in this-procedure ( "ЖДИТЕ... Формирование отчёта") .
     2424       output stream OutStr-html to value(v-file-name-rep-htm) convert target 'UTF-8' .
     2425       put stream OutStr-html unformatted
     2426           "<!DOCTYPE HTML>" skip
     2427           ' <html>' skip
