     2141       for each tt-trans exclusive-lock where not tt-trans.taken :
     2142           create tt-rep .
     2143           assign
     2144               tt-rep.azk          = tt-trans.azk
     2145               tt-rep.gds-name     = tt-trans.gds-name
     2146               tt-rep.dt-RN-cart   = tt-trans.dt
     2147               tt-rep.qnty-RN-cart = tt-trans.qnty
     2148               tt-rep.summ-RN-cart = tt-trans.summ
