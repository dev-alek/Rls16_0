     2893               '       </tfoot>' skip
     2894               .
     2895       end .
     2896       put stream OutStr-html unformatted
     2897           '     </tbody>' skip
     2898           '   </table>' skip
     2899           '  </body>' skip
     2900           ' </html>' skip
     2901           .
     2902       output stream OutStr-html close.
     2903       output stream OutStr-html close.
     2904       run waitfram-hide in this-procedure .
     2905       run prn-lib-reportviewer-report-name in this-procedure (
     2906           input THIS-PROCEDURE
     2907           ,input v-file-name-rep-htm
     2908           ).
     2909   end procedure .
     2910   procedure get-full-path-RepViewer:
     2911       define output parameter p-fill-path-RepView as character no-undo.
     2912       if search("exe\ReportViewer\reportviewer.exe") <> ? then
     2913       do:
     2914           p-fill-path-RepView = search("exe\ReportViewer\reportviewer.exe").
     2915       end.
     2916       else
     2917       do:
     2918           message "Не найдена программа просмотра отчёта!" view-as alert-box error.
     2919       end.
     2920   end procedure.
     2921   procedure define-full-path-Report:
     2922       define input parameter p-rep-num as integer no-undo.
     2923       define output parameter p-file-name-rep-htm as character no-undo.
     2924       p-file-name-rep-htm = session:temp-directory + "rpt" + string(p-rep-num) + ".html".
     2925   end procedure.
     2926   procedure search-full-path-Report:
     2927       define input parameter p-file-name as character no-undo.
     2928       if search(p-file-name) = ? then
     2929       do:
     2930           message "Не найден файл отчёта: " p-file-name view-as alert-box error.
     2931       end.
     2932       else
     2933       do:
     2934           p-file-name = search(p-file-name).
     2935       end.
     2936   end procedure.
     2937   procedure Report-Viewer:
     2938       define input parameter p-full-path-RepView as character no-undo.
     2939       define input parameter p-file-name-rep-htm as character no-undo.
     2940       os-command no-wait value(p-full-path-RepView + " true " + search(p-file-name-rep-htm)).
     2941   end procedure.
     2942   procedure create-file:
     2943       define input parameter p-file-name as character no-undo.
     2944       output to value(string(p-file-name)).
     2945       output close.
     2946   end procedure.
     2947   function fnc-DD-MM-YYYY returns character
     2948       (input p-dat-date as date):
     2949       define variable result     as character no-undo.
     2950       define variable p-str-date as character no-undo.
     2951       p-str-date = replace(string(p-dat-date,'99.99.9999'), "/", ".").
     2952       return p-str-date.
     2953   end function.
     2954    function fnc-obj-name returns character
     2955       (input p-obj-code as integer, input p-obj-type as character):
     2956       define variable result     as character no-undo.
     2957       define variable p-obj-name as character no-undo.
     2958       define buffer buf_clients for ub.clients .
     2959       for first buf_clients no-lock where buf_clients.obj-code = p-obj-code
     2960                                       and buf_clients.obj-type = p-obj-type:
     2961       p-obj-name = buf_clients.obj-name.
     2962       end.
     2963       return p-obj-name.
     2964   end function.
