      764   define variable vss-include-info10 as character format "X(65)" no-undo
      765   initial "@(#)$Workfile$ $Revision$".
      766   procedure grplib-get-full-name :
      767      define input parameter p-node-code  as integer      no-undo.
      768      define output parameter p-full-name as character    no-undo.
      769      do
      770   on error undo, return error
      771   :
      772       define variable v-upper-code    as integer           no-undo.
      773       define buffer buf_gds-grp       for ub.gds-grp.
      774       define buffer buf_upper_gds-grp for ub.gds-grp.
      775       find first buf_gds-grp no-lock
      776            where buf_gds-grp.node-code = p-node-code
      777       no-error.
      778       if not available buf_gds-grp
      779       then do:
      780           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      781       end.
      782       assign
      783           p-full-name  = ""
      784           v-upper-code = 1
      785       .
      786       do while buf_gds-grp.upper-code <> 0
      787       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
      788       :
      789           assign
      790               p-full-name  = buf_gds-grp.node-name
      791                            + (if p-full-name <> "" then chr(47) else "")
      792                            + p-full-name
      793               v-upper-code = buf_gds-grp.upper-code
      794           .
      795           find first buf_gds-grp no-lock
      796                where buf_gds-grp.node-code = v-upper-code
      797           no-error.
      798           if not available buf_gds-grp
      799           then do:
      800               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
      801                                   + string( v-upper-code )
      802                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      803           end.
      804       end.
      805       assign
      806       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      807       .
      808   end.
      809   end .
      810   procedure grplib-get-node-from-full-name :
      811   define input parameter p-full-name as character no-undo .
      812   define output parameter p-node-code as integer no-undo .
      813   define variable v-ii as integer no-undo .
      814   define variable v-upper-code as integer no-undo .
      815   define variable v-root-code as integer no-undo .
      816   define variable v-entry as character no-undo .
      817   define buffer buf_gds-grp       for ub.gds-grp.
      818   do
      819   on error undo, return error
      820   :
      821     find first buf_gds-grp no-lock
      822         where buf_gds-grp.upper-code = 0
      823     no-error .
      824     if not available buf_gds-grp
      825     then do:
      826         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
      827     end.
      828     else do:
      829       assign
      830       v-root-code = buf_gds-grp.node-code
      831       .
      832     end.
      833     v-upper-code = v-root-code.
      834     do v-ii = 1 to num-entries(p-full-name, chr(47)):
      835       assign
      836       v-entry = entry(v-ii, p-full-name, chr(47)).
      837       if v-entry = '' then leave.
      838       find first buf_gds-grp no-lock where
      839                 buf_gds-grp.node-name = v-entry
      840             and buf_gds-grp.upper-code = v-upper-code
      841             no-error.
      842       if not available buf_gds-grp then do:
      843         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
      844       end.
      845       else do:
      846         p-node-code = buf_gds-grp.node-code.
      847         v-upper-code = buf_gds-grp.node-code.
      848       end.
      849     end.
      850   end.
      851   end .
