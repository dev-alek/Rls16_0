     2816                           '         <td num="0.00" val="' + fnc-convert-dot-to-colon((tt-rep.qnty-TH - tt-rep.qnty-RN-cart),"->>>>>>>>>>>>>9.99",2) + '" style="text-align: right; font-weight: normal; background-color: ' + v-color + ';">' + fnc-convert-dot-to-colon((tt-rep.qnty-TH - tt-rep.qnty-RN-cart),"->>>>>>>>>>>>>9.99",2) + '</td>' skip
     2817                           '         <td num="0.00" val="' + fnc-convert-dot-to-colon((tt-rep.summ-TH - tt-rep.summ-RN-cart),"->>>>>>>>>>>>>9.99",2) + '" style="text-align: right; font-weight: normal; background-color: ' + v-color + ';">' + fnc-convert-dot-to-colon((tt-rep.summ-TH - tt-rep.summ-RN-cart),"->>>>>>>>>>>>>9.99",2) + '</td>' skip
     2818                           '         <td style="text-align: right; font-weight: normal; background-color: ' + v-color + ';">' + (if tt-rep.dt-TH <> ? then string(tt-rep.dt-TH,"99.99.9999") + " " + tt-rep.time-TH else " ") + '</td>' skip
     2819                           '         <td style="text-align: right; font-weight: normal; background-color: ' + v-color + ';">' + (if tt-rep.dt-RN-cart <> ? then string(tt-rep.dt-RN-cart, "99.99.9999 HH:MM:SS") else " ") + '</td>' skip
     2820                           '         <td style="text-align: right; font-weight: normal; background-color: ' + v-color + ';">' + tt-rep.RRN-RN + '</td>' skip
     2821                           '         <td style="text-align: right; font-weight: normal; background-color: ' + v-color + ';">' + tt-rep.RRN-TH + '</td>' skip
     2822                           '         <td style="text-align: right; font-weight: normal; background-color: ' + v-color + ';">' + tt-rep.transID + '</td>' skip
     2823                           '         <td style="text-align: right; font-weight: normal; background-color: ' + v-color + ';">' + tt-rep.azk + '</td>' skip
     2824                           '         <td style="text-align: right; font-weight: normal; background-color: ' + v-color + ';">' + string(tt-rep.obj-name) + '</td>' skip
     2825                           '       </tr>' skip
     2826                           .
     2827                   end .
     2828               end .
     2829           end .
     2830       end.
     2831       else
     2832       do :
     2833           for each tt-rep where tt-rep.obj-type   = tt-shift.obj-type
     2834               and tt-rep.obj-code   = tt-shift.obj-code
     2835               and tt-rep.shift-date = tt-shift.shift-date
     2836               and tt-rep.shift-num  = tt-shift.shift-num
     2837               :
     2838               if tt-rep.qnty-TH <> tt-rep.qnty-RN-cart or round(tt-rep.summ-TH,2) <> tt-rep.summ-RN-cart then v-color = "#FFB6C1" .
     2839               else v-color = "white" .
     2840               put stream OutStr-html unformatted
     2841                   '       <tr level="1">' skip
     2842                   '         <td style="text-align: left; font-weight: normal; background-color: ' + v-color + ';">' + tt-rep.gds-name + '</td>' skip
     2843                   '         <td num="0.00" val="' + fnc-convert-dot-to-colon(tt-rep.qnty-TH,"->>>>>>>>>>>>>9.99",2) + '" style="text-align: right; font-weight: normal; background-color: ' + v-color + ';">' + (if tt-rep.qnty-TH = 0 then " " else fnc-convert-dot-to-colon(tt-rep.qnty-TH,"->>>>>>>>>>>>>9.99",2)) + '</td>' skip
     2844                   '         <td num="0.00" val="' + fnc-convert-dot-to-colon(tt-rep.summ-TH,"->>>>>>>>>>>>>9.99",2) + '" style="text-align: right; font-weight: normal; background-color: ' + v-color + ';">' + (if tt-rep.summ-TH = 0 then " " else fnc-convert-dot-to-colon(tt-rep.summ-TH,"->>>>>>>>>>>>>9.99",2)) + '</td>' skip
     2845                   '         <td num="0.00" val="' + fnc-convert-dot-to-colon(tt-rep.qnty-RN-cart,"->>>>>>>>>>>>>9.99",2) + '" style="text-align: right; font-weight: normal; background-color: ' + v-color + ';">' + (if tt-rep.qnty-RN-cart = 0 then " " else fnc-convert-dot-to-colon(tt-rep.qnty-RN-cart,"->>>>>>>>>>>>>9.99",2)) + '</td>' skip
     2846                   '         <td num="0.00" val="' + fnc-convert-dot-to-colon(tt-rep.summ-RN-cart,"->>>>>>>>>>>>>9.99",2) + '" style="text-align: right; font-weight: normal; background-color: ' + v-color + ';">' + (if tt-rep.summ-RN-cart = 0 then " " else fnc-convert-dot-to-colon(tt-rep.summ-RN-cart,"->>>>>>>>>>>>>9.99",2)) + '</td>' skip
     2847                   '         <td num="0.00" val="' + fnc-convert-dot-to-colon((tt-rep.qnty-TH - tt-rep.qnty-RN-cart),"->>>>>>>>>>>>>9.99",2) + '" style="text-align: right; font-weight: normal; background-color: ' + v-color + ';">' + fnc-convert-dot-to-colon((tt-rep.qnty-TH - tt-rep.qnty-RN-cart),"->>>>>>>>>>>>>9.99",2) + '</td>' skip
     2848                   '         <td num="0.00" val="' + fnc-convert-dot-to-colon((tt-rep.summ-TH - tt-rep.summ-RN-cart),"->>>>>>>>>>>>>9.99",2) + '" style="text-align: right; font-weight: normal; background-color: ' + v-color + ';">' + fnc-convert-dot-to-colon((tt-rep.summ-TH - tt-rep.summ-RN-cart),"->>>>>>>>>>>>>9.99",2) + '</td>' skip
     2849                   '         <td style="text-align: right; font-weight: normal; background-color: ' + v-color + ';">' + (if tt-rep.dt-TH <> ? then string(tt-rep.dt-TH,"99.99.9999") + " " + tt-rep.time-TH else " ") + '</td>' skip
     2850                   '         <td style="text-align: right; font-weight: normal; background-color: ' + v-color + ';">' + (if tt-rep.dt-RN-cart <> ? then string(tt-rep.dt-RN-cart, "99.99.9999 HH:MM:SS") else " ") + '</td>' skip
     2851                   '         <td style="text-align: right; font-weight: normal; background-color: ' + v-color + ';">' + tt-rep.RRN-RN + '</td>' skip
     2852                   '         <td style="text-align: right; font-weight: normal; background-color: ' + v-color + ';">' + tt-rep.RRN-TH + '</td>' skip
     2853                   '         <td style="text-align: right; font-weight: normal; background-color: ' + v-color + ';">' + tt-rep.transID + '</td>' skip
     2854                   '         <td style="text-align: right; font-weight: normal; background-color: ' + v-color + ';">' + tt-rep.azk + '</td>' skip
     2855                   '         <td style="text-align: right; font-weight: normal; background-color: ' + v-color + ';">' + string(tt-rep.obj-name) + '</td>' skip
     2856                   '       </tr>' skip
     2857                   .
     2858           end .
     2859       end .
     2860       for first tt-itog:
     2861           put stream OutStr-html unformatted
     2862               '       <tfoot>' skip
     2863               '       <tr>' skip
     2864               '       <td colspan = "1"></td>' skip
     2865               '       <td colspan = "4" style="text-align: left; font-weight: normal">Всего транзакций: </td>' skip
     2866               '       <td style="text-align: right; font-weight: normal">' + string(tt-itog.qnty-TH + tt-itog.qnty-only-TH + tt-itog.qnty-RN) + '</td>' skip
     2867               '       <td colspan = "9"></td>' skip
     2868               '       </tr>' skip
     2869               '       <tr>' skip
     2870               '       <td colspan = "1"></td>' skip
     2871               '       <td colspan = "4" style="text-align: left; font-weight: normal">из них с расхождением: </td>' skip
     2872               '       <td style="text-align: right; font-weight: normal"></td>' skip
