     1797   end .
     1798   run waitfram-hide in this-procedure .
     1799   run waitfram-show in this-procedure ( "ЖДИТЕ... Сборка данных для отчёта") .
     1800   run make-rep .
     1801   run waitfram-hide in this-procedure .
     1802   if x-TOG-Shift
     1803       then
     1804   do :
     1805       v-period = ("С " + fnc-DD-MM-YYYY(date(string(X-Date-Start,"99/99/9999"))) + ", смена № "  + string(X-Shift-Start) +
     1806           " по " + fnc-DD-MM-YYYY(date(string(X-Date-End,"99/99/9999"))) + ", смена № " + string(X-Shift-End))
     1807           .
     1808   end .
     1809   else
     1810   do :
     1811       v-period = ("С " + fnc-DD-MM-YYYY(date(string(X-Date-Start,"99/99/9999"))) +
     1812           " по " + fnc-DD-MM-YYYY(date(string(X-Date-End,"99/99/9999"))) )
     1813           .
     1814   end .
     1815   for each obj-list :
     1816       v-azk-list = v-azk-list + obj-list.obj-name + ", " .
     1817   end .
     1818   v-azk-list = trim(v-azk-list) .
     1819   v-azk-list = trim(v-azk-list, ",") .
     1820   if p-rep-type = 1
     1821       then
     1822   do :
     1823       run my-rep-ul in this-procedure .
     1824   end .
     1825   if p-rep-type = 2
     1826       then
