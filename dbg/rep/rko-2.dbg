     1589   PROCEDURE get-report-num :
     1590     define output parameter p-report-num as integer no-undo .
     1591     do
     1592       on error undo, return error return-value
     1593       :
     1594       run gbl/getrpnum.p (output p-report-num).
     1595     end.
     1596   END PROCEDURE.
     1597   end.
