     1284       '<tr>' skip
     1285       '<td colspan="21" style="text-align: center;"></td>' skip
     1286       '<td colspan="45" style="text-align: left;">Унифицированная форма № КО-2</td>' skip
     1287       '</tr>' skip .
     1288     put stream OutStr-html unformatted
     1289       '<tr>' skip
     1290       '<td colspan="21" style="text-align: center;"></td>' skip
     1291       '<td colspan="45" style="text-align: left;">Утверждена постановлением Госкомстата России от 18.08.98 №88</td>' skip
     1292       '</tr>' skip .
     1293     put stream OutStr-html unformatted
     1294       '<tr>' skip
     1295       '<td colspan="31" style="text-align: center;"></td>' skip
     1296       '<td colspan="35" style="text-align: left;"></td>' skip
     1297       '</tr>' skip .
     1298     put stream OutStr-html unformatted
     1299       '<tr>' skip
     1300       '<td colspan="49" style="text-align: center;"></td>' skip
     1301       '<td colspan="16" style="text-align: center; border: 1px solid black;">Код</td>' skip
     1302       '<td></td>' skip
     1303       '</tr>' skip .
     1304     put stream OutStr-html unformatted
     1305       '<tr>' skip
     1306       '<td colspan="35" style="text-align: center;"></td>' skip
     1307       '<td colspan="13" style="text-align: right;">Форма по ОКУД</td>' skip
     1308       '<td></td>' skip
     1309       '<td colspan="16" style="text-align: center; border: 2px solid black;">0310002</td>' skip
     1310       '<td></td>' skip
     1311       '</tr>' skip .
     1312     put stream OutStr-html unformatted
     1313       '<tr>' skip
     1314       '<td colspan="39" style="text-align: center; border-bottom: 1px solid black;">' + buf_fin-doc.payer-name + '</td>' skip
     1315       '<td colspan="9" style="text-align: right;">по ОКПО</td>' skip
     1316       '<td></td>' skip
     1317       '<td colspan="16" style="text-align: center; border: 2px solid black;">' + string(buf_fin-doc.payer-okpo) + '</td>' skip
     1318       '<td></td>' skip
     1319       '</tr>' skip     .
     1320     put stream OutStr-html unformatted
     1321       '<tr>' skip
     1322       '<td colspan="39" style="text-align: center; font-size: 10px;">(организация)</td>' skip
     1323       '<td colspan="9" style="text-align: right;"></td>' skip
     1324       '<td></td>' skip
     1325       '<td colspan="16" rowspan="2" style="text-align: center; border: 1px solid black;">' + string( v-hist-code ) + '</td>' skip
     1326       '<td></td>' skip
     1327       '</tr>' skip     .
     1328     put stream OutStr-html unformatted
     1329       '<tr>' skip
     1330       '<td colspan="39" style="text-align: center; border-bottom: 1px solid black;">' + v-str-podr-name + '</td>' skip
     1331       '<td colspan="9" style="text-align: right; border-bottom: 0px solid white;"></td>' skip
     1332       '<td></td>' skip
     1333       '</tr>' skip    .
     1334     put stream OutStr-html unformatted
     1335       '<tr>' skip
     1336       '<td colspan="39" style="text-align:center; font-size: 10px;">(структурное подразделение)</td>' skip
     1337       '<td colspan="9" style="text-align: right; border-bottom: 0px solid white;"></td>' skip
     1338       '<td colspan="16" style="text-align:center;"></td>' skip
     1339       '<td></td>' skip
     1340       '</tr>' skip    .
     1341     put stream OutStr-html unformatted
     1342       '<tr>' skip
     1343       '<td colspan="41" style="text-align:center;"></td>' skip
     1344       '<td colspan="10" style="text-align:center; border-left: 1px solid black; border-right: 1px solid black; border-top: 1px solid black">Номер документа</td>' skip
     1345       '<td colspan="14" style="text-align:center; border-left: 1px solid black; border-right: 1px solid black; border-top: 1px solid black">Дата составления</td>' skip
     1346       '<td></td>' skip
     1347       '</tr>' skip .
     1348     put stream OutStr-html unformatted
     1349       '<tr>' skip
     1350       '<td colspan="41" style="text-align: center; font-weight: bold;">РАСХОДНЫЙ КАССОВЫЙ ОРДЕР</td>' skip
     1351       '<td colspan="10" style="text-align: center; border: 1px solid black;">' + string(buf_fin-doc.prn-doc-code) + '</td>' skip
     1352       '<td colspan="14" style="text-align: center; border: 1px solid black;">' + string(v-doc-date-f) + '</td>' skip
     1353       '<td></td>' skip
     1354       '</tr>' skip      .
     1355     put stream OutStr-html unformatted
     1356       '<tr>' skip
     1357       '<td colspan="41" style="text-align: center; font-weight: bold;"></td>' skip
     1358       '<td colspan="10" style="text-align: center;"></td>' skip
     1359       '<td colspan="14" style="text-align: center;"></td>' skip
     1360       '<td></td>' skip
     1361       '</tr>' skip    .
     1362     put stream OutStr-html unformatted
     1363       '<tr>' skip
     1364       '<td colspan="33" style="text-align: center; border: 1px solid black;">Дебет</td>' skip
     1365       '<td text_wrap="true" rowspan="4" colspan="6" style="text-align: center; border: 1px solid black;">Кредит</td>' skip
     1366       '<td text_wrap="true" rowspan="4" colspan="9" style="text-align: center; border: 1px solid black;">Сумма, руб. коп.</td>' skip
     1367       '<td text_wrap="true" rowspan="4" colspan="10" style="text-align: center; border: 1px solid black;">Код целевого назначения</td>' skip
     1368       '<td text_wrap="true" rowspan="4" colspan="7" style="text-align: center; border: 1px solid black;"></td>' skip
     1369       '<td></td>' skip
     1370       '</tr>' skip .
