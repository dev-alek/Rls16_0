      304   define  stream PrnLibStream.
      305   procedure prn-lib-prn-file :
      306     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      307     define input parameter p-DIsabledoptions as integer no-undo .
      308     define variable v-report-name as character no-undo .
      309     define variable v-user-action as character no-undo .
      310     define variable v-printed     as logical   no-undo .
      311     define variable v-exist       as logical   no-undo .
      312     do
      313       on error undo, return error
      314       :
      315       run prn-lib-get-report-name  in this-procedure (
      316         input parParentProc
      317         ,output v-report-name
      318         ).
      319   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      320   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      321     (input  v-report-name
      322     ,input  2
      323     ,output v-exist
      324     )  .
      325       if NOT v-exist then
      326       DO:
      327         Message
      328           "Нет заданий на печать ! "
      329           view-as alert-box .
      330         Return  .
      331       End.
      332       run gbl/prnfilen.w
      333         (input  ""
      334         ,input  p-DisabledOptions
      335         ,input  string(v-report-name )
      336         ,input  7
      337         ,output v-user-action
      338         ,output v-printed
      339         ) .
      340       if v-printed then
      341       do:
      342         return "YES" .
      343       end.
      344       else
      345       do:
      346         return "NO" .
      347       end.
      348     end.
      349   end procedure.
      350   procedure prn-lib-open-stream :
      351     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      352     define input parameter p-page-size    as integer no-undo .
      353     define input parameter p-is-stream    as logical no-undo .
      354     define input parameter p-append       as logical no-undo .
      355     define variable v-report-name as character no-undo .
      356     do
      357       on error undo, return error
      358       :
      359       run prn-lib-get-report-name  in this-procedure (
      360         input parParentProc
      361         ,output v-report-name
      362         ).
      363       if p-is-stream then
      364       do:
      365         if p-append then
      366         do:
      367           output stream PrnLibStream to value( v-report-name )
      368             page-size value(p-page-size) append .
      369         end.
      370         if not p-append then
      371         do:
      372           output stream PrnLibStream to value( v-report-name )
      373             page-size value(p-page-size) .
      374         end.
      375       end.
      376       if not p-is-stream then
      377       do:
      378         if p-append then
      379         do:
      380           output to value( v-report-name )
      381             page-size value(p-page-size) append .
      382         end.
      383         if not p-append then
      384         do:
      385           output to value( v-report-name )
      386             page-size value(p-page-size) .
      387         end.
      388       end.
      389     end.
      390   end procedure.
      391   procedure prn-lib-open-exp :
      392     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      393     define input parameter p-is-stream    as logical no-undo .
      394     define input parameter p-is-append    as logical no-undo .
      395     define output parameter p-ReportFileName as char init "report" no-undo.
      396     define output parameter p-process as logical no-undo .
      397     define variable glog as logical no-undo .
      398     do
      399       on error undo, return error
      400       :
      401       SYSTEM-DIALOG GET-FILE p-ReportFileName
      402         TITLE      "Укажите путь"
      403         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      404         ASK-OVERWRITE
      405         CREATE-TEST-FILE
      406         SAVE-AS
      407         USE-FILENAME
      408         DEFAULT-EXTENSION "txt"
      409         UPDATE glog
      410         .
      411       if not glog then  return.
      412       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      413       if p-is-stream then
      414       do:
      415         if p-is-append then
      416         do:
      417           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      418         end.
      419         else
      420         do:
      421           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      422         end.
      423       end.
      424       else
      425       do:
      426         if p-is-append then
      427         do:
      428           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      429         end.
      430         else
      431         do:
      432           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      433         end.
      434       end.
      435       p-process = yes.
      436     end.
      437   end procedure.
      438   procedure prn-lib-get-report-name :
      439     define input parameter parParentProc  as widget-handle no-undo.
      440     define output parameter p-report-name as character no-undo .
      441     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      442   end procedure.
      443   procedure prn-lib-reportviewer-report-name :
      444     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      445     define input parameter p-report-name-html as character no-undo .
      446     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      447   end procedure.
      448   procedure prn-lib-reportviewer :
      449     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      450     define input parameter p-report-name-html as character no-undo .
      451     define input parameter p-param        as character no-undo .
      452     define variable v-excel           as character no-undo init 'TRUE' .
      453     define variable v-value-character as character no-undo .
      454     define variable v-value-integer   as character no-undo .
      455     define variable v-value-date      as date      no-undo .
      456     define variable v-value-decimal   as decimal   no-undo .
      457     define variable rep-excel         as logical   no-undo .
      458     define variable excel-string      as character no-undo .
      459     define variable v-param-type      as character no-undo .
      460     define variable v-tth             as handle    no-undo .
      461     run adm/shattri.p (
      462       input "get":U
      463       ,input  ""
      464       ,input  0
      465       ,input  'report-glob':U
      466       ,input  'rep-excel':U
      467       ,output v-value-character
      468       ,output v-value-date
      469       ,output v-value-decimal
      470       ,output v-value-integer
      471       ,output rep-excel
      472       ,output v-param-type
      473       ,INPUT-OUTPUT table-handle v-tth
      474       )  .
      475     if rep-excel then v-excel = "TRUE" .
      476     else v-excel = "FALSE" .
      477     if p-param eq ""
      478     then
      479        p-param = "EXCEL:" + v-excel.
      480     else
      481        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      482     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      483   end procedure.
      484   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile: frmlib.i $ $Revision: aea5316774be, 0, rls $".
      485   FUNCTION Break-n-line RETURNS CHARACTER
      486     ( INPUT p-ost as char,
      487       INPUT p-lengths  as character,
      488       OUTPUT output-num-lines as integer
      489       ) :
      490   define variable ii as integer no-undo.
      491   define variable jj as integer no-undo.
      492   define variable linei as character no-undo extent 10.
      493   define variable line-length as integer no-undo extent 10.
      494   define variable num-line as integer no-undo .
      495   define variable v-line as character no-undo .
      496   do ii = 1 to MIN(num-entries(p-lengths), 10):
      497     assign
      498     line-length[ii] = integer(entry(ii, p-lengths))
      499     num-line = ii
      500     .
      501   end.
      502   do jj = 1 to num-line:
      503     if Length ( p-ost ) <= line-length[jj] then do:
      504       assign
      505       output-num-lines = jj
      506       v-line = v-line + (if jj = 1 then "":U else chr(4)) + p-ost
      507       .
      508       return v-line.
      509     end.
      510     assign
      511     ii = 1
      512     .
      513     if length( entry( ii, p-ost , chr(32)) ) > line-length[jj]
      514     then do:
      515       assign
      516       linei[jj] = substr( p-ost , 1 , line-length[jj] )
      517       p-ost = trim( substr( p-ost , line-length[jj] + 1 ) )
      518       .
      519     end.
      520     else do:
      521       DO WHILE length( linei[jj] + entry( ii, p-ost , chr(32)) ) < ( line-length[jj] + 1 ) :
      522         assign
      523         linei[jj] = linei[jj] + entry( ii, p-ost , chr(32)) + chr(32)
      524         ii = ii + 1
      525         .
      526         if length( entry( ii, p-ost, chr(32) ) ) > line-length[jj] then
      527         assign
      528         linei[jj] = linei[jj] + substr( p-ost , length( linei[jj] ) , line-length[jj] - length( linei[jj] ) + 1 )
      529         .
      530       END.
      531       assign
      532       p-ost = trim( substr( p-ost , length(linei[jj]) + 1  ))
      533       .
      534     end.
      535     assign
      536     v-line = v-line + (if jj = 1 then "":U else chr(4)) + linei[jj]
      537     .
      538     if p-ost = "":U then LEAVE.
      539   end.
      540   assign
      541   output-num-lines = jj.
      542   RETURN v-line.
      543   END FUNCTION.
      544   FUNCTION Center-Field RETURNS CHARACTER
      545     ( INPUT p-str as char,
      546       INPUT p-format as integer,
      547       INPUT p-Length as integer,
      548       INPUT p-fill as character
      549       ) :
      550   define variable v-str as character no-undo .
      551   define variable v-left as integer no-undo .
      552   define variable v-dop as integer no-undo .
      553   assign
      554   p-str = trim(p-str)
      555   .
      556   if p-str = "":U then return fill(p-fill, p-length).
      557   if length(p-str) >= p-format then
      558   p-str = substr(p-str, 1, p-format).
      559   else do:
      560     p-format = length(p-str).
      561   end.
      562   if p-format < p-length then do:
      563     assign
      564     v-left = (p-length - p-format )
      565     v-dop = (if v-left modulo 2 = 1
      566              then 1
      567              else 0)
      568     v-left = (if (v-left modulo 2 = 1)
      569              then (v-left - 1 ) / 2
      570              else v-left / 2)
      571     v-str =  fill(p-fill, v-left) +
      572              string(p-str, "X(":U + string(p-format) + ")":U) +
      573              fill(p-fill, v-left) + fill(p-fill, v-dop)
      574     .
      575     return v-str.
      576   end.
      577   else do:
      578     return string(p-str, "X(":U + string(p-length) + ")":U).
      579   end.
      580   END FUNCTION.
      581   FUNCTION Left-Field RETURNS CHARACTER
      582     ( INPUT p-str as char,
      583       INPUT p-format as integer,
      584       INPUT p-Length as integer,
      585       INPUT p-fill as character
      586       ) :
      587   define variable v-str as character no-undo .
      588   define variable v-left as integer no-undo .
      589   define variable v-dop as integer no-undo .
      590   assign
      591   p-str = trim(p-str)
      592   .
      593   if p-str = "":U then return fill(p-fill, p-length).
      594   if length(p-str) >= p-format then
      595   p-str = substr(p-str, 1, p-format).
      596   else do:
      597     p-format = length(p-str).
      598   end.
      599   if p-format < p-length then do:
      600     assign
      601     v-dop =  p-length - p-format
      602     v-str =  string(p-str, "X(":U + string(p-format) + ")":U) +
      603              fill(p-fill, v-dop)
      604     .
      605     return v-str.
      606   end.
      607   else do:
      608     return string(p-str, "X(":U + string(p-length) + ")":U).
      609   end.
      610   END FUNCTION.
      611   FUNCTION Sum-Rub-Kop-Digit RETURNS CHARACTER
      612     ( INPUT p-sum as decimal,
      613       INPUT p-rub-length as integer,
      614       INPUT p-kop-length as integer,
      615       INPUT p-fill as character,
      616       INPUT p-razr-delim as character,
      617       INPUT p-rub-str  as character,
      618       INPUT p-kop-str  as character
      619       ) :
      620   define variable v-str as character no-undo .
      621   define variable v-format as character no-undo .
      622   define variable v-dopi as integer no-undo .
      623   define variable v-dopi2 as integer no-undo .
      624   assign
      625   v-dopi = length(string(truncate(ABS(p-sum), 0)))
      626   v-dopi2 = truncate(v-dopi / 3, 0) - (if v-dopi modulo  3 = 0 then 1 else 0)
      627   .
      628   if v-dopi > p-rub-length or p-kop-length < 2 then return "?".
      629   assign
      630   v-format = (if p-sum < 0 then "-":U else "":U) + fill((">>>":U + p-razr-delim), v-dopi2) + ">>9":U
      631   v-dopi = length(trim(string(truncate(p-sum, 0), v-format)))
      632   .
      633   assign
      634   v-str = fill(p-fill, p-rub-length - v-dopi) +
      635           string(truncate(p-sum, 0), v-format) +
      636           p-rub-str +
      637           fill(p-fill, p-kop-length - 2) +
      638           string(truncate((ABS(p-sum) - ABS(truncate(p-sum, 0))), 2) * 100, "99":U) + p-kop-str
      639   .
      640   return v-str.
      641   END FUNCTION.
      642   FUNCTION Sum-Invalut-Digit RETURNS CHARACTER
      643     ( INPUT p-sum as decimal,
      644       INPUT p-sum-length as integer,
      645       INPUT p-curr-code as integer,
      646       INPUT p-fill as character,
      647       INPUT p-razr-delim as character
      648       ) :
      649   define variable v-str as character no-undo .
      650   define variable v-format as character no-undo .
      651   define variable v-dopi as integer no-undo .
      652   define variable v-dopi2 as integer no-undo .
      653   define variable v-curr-name as character no-undo .
      654   define buffer buf_currency for ub.currency.
      655   find first buf_currency no-lock where
      656             buf_currency.curr-code = p-curr-code no-error .
      657   if not avail buf_currency
      658   then v-curr-name = "неизвестная валюта".
      659   else
      660   assign
      661   v-curr-name = buf_currency.curr-name
      662   .
      663   assign
      664   v-dopi = length(string(truncate(ABS(p-sum), 0)))
      665   v-dopi2 = truncate(v-dopi / 3, 0) - (if v-dopi modulo  3 = 0 then 1 else 0)
      666   .
      667   if v-dopi > p-sum-length then return "?".
      668   assign
      669   v-format = (if p-sum < 0 then "-":U else "":U) + fill((">>>":U + p-razr-delim), v-dopi2) + ">>9.99":U
      670   v-dopi = length(trim(string(p-sum, v-format)))
      671   .
      672   assign
      673   v-str = "(":U + chr(32) + v-curr-name +  chr(32) + ")":U +
      674           fill(p-fill, p-sum-length - v-dopi - length(v-curr-name) - 4)  +
      675           trim(string(p-sum, v-format))
      676   .
      677   return v-str.
      678   END FUNCTION.
      679   FUNCTION Sum-in-Words-Without-Dec RETURNS CHARACTER
      680   (input v-sum as decimal
      681   ):
      682   define variable v-str as character no-undo .
      683   run gbl/num-rus.p ( input absolute( v-sum ) , output v-str).
      684   v-str = trim( caps( substring( v-str, 1, 1 ) ) ) + substring( v-str, 2 ).
      685   return v-str.
      686   END FUNCTION.
      687   FUNCTION Sum-in-Words-Invalut RETURNS CHARACTER
      688   (input p-sum as decimal
      689    ,input p-curr-code as integer
      690   ):
      691   define variable v-str as character no-undo .
      692   define variable Copeck as character no-undo.
      693   define variable Rouble as character no-undo.
      694   define variable v-Word as character no-undo.
      695   define variable ii as integer init 18 no-undo.
      696   define variable v-str-rubl as character no-undo .
      697   define variable v-kop as integer no-undo .
      698   define buffer buf_currency for ub.currency.
      699   assign
      700   v-Word = string( absolute( p-sum ) , "999999999999999.99" ).
      701   find first buf_currency no-lock where
      702             buf_currency.curr-code = p-curr-code no-error .
      703   if not available buf_currency then return chr(63).
      704   if decimal( substring(v-Word,1,ii - 3) ) <> 0 then do:
      705     CASE substring(v-Word, ii - 3,1):
      706       WHEN "1" THEN DO:
      707         if substring(v-Word, ii - 4,1) = "1" then
      708             Rouble = buf_currency.curr-name-five .
      709         else
      710             Rouble = buf_currency.curr-name-one .
      711       END.
      712       WHEN "2" OR WHEN "3" OR WHEN "4" THEN  DO:
      713         if substring(v-Word, ii - 4,1) = "1" then
      714            Rouble = buf_currency.curr-name-five .
      715            else
      716            Rouble = buf_currency.curr-name-three .
      717         END.
      718       WHEN "0" OR WHEN "5" OR WHEN "6" OR WHEN "7" OR WHEN "8" OR WHEN "9" THEN  DO:
      719          Rouble = buf_currency.curr-name-five .
      720       END.
      721     END CASE.
      722   end.
      723   CASE substring(v-Word, ii, 1):
      724     WHEN "1" THEN DO:
      725       if substring(v-Word, ii - 1, 1) = "1" then
      726           Copeck = buf_currency.part-name-five .
      727       else
      728           Copeck = buf_currency.part-name-one .
      729     END.
      730     WHEN "2" OR WHEN "3" OR WHEN "4" THEN DO:
      731       if substring(v-Word, ii - 1, 1) = "1" then
      732           Copeck = buf_currency.part-name-five .
      733       else
      734           Copeck = buf_currency.part-name-three .
      735     END.
      736     WHEN "0" OR WHEN "5" OR WHEN "6" OR WHEN "7" OR WHEN "8" OR WHEN "9" THEN DO:
      737       Copeck = buf_currency.part-name-five .
      738     END.
      739   END CASE.
      740   run gbl/num-rus.p ( input absolute( p-sum )
      741                , output v-str-rubl).
      742   assign
      743   v-kop = (absolute( p-sum ) - truncate(absolute(p-sum), 0)
      744           ) * 100
      745   .
      746   v-str = ( if p-Sum < 0 then "- " else "" ) +
      747               caps(substring(v-str-rubl, 1, 1)) +  substring(v-str-rubl, 2) + chr(32) + Rouble + chr(32) +
      748               string(v-kop, "99":U) + chr(32) + Copeck .
      749   return v-str.
      750   END FUNCTION.
      751   FUNCTION Sum-delim-with-defis RETURNS CHARACTER
      752   (input v-sum as decimal,
      753   input v-razr as integer
      754   ):
      755   define variable v-str as character no-undo .
      756   define variable v-dec-separ as character no-undo .
      757   case SESSION:NUMERIC-FORMAT:
      758     when "American":U then do:
      759       assign
      760       v-dec-separ = ".":U
      761       .
      762     end.
      763     when "European":U then do:
      764       assign
      765       v-dec-separ = ",":U
      766       .
      767     end.
      768   END CASE.
      769   assign
      770   v-str = replace(string(v-sum, fill(">":U, v-razr - 1) + "9.99"), v-dec-separ, "-":U)
      771   .
      772   return v-str.
      773   END FUNCTION.
      774   FUNCTION MonthNameRusGen RETURNS CHARACTER ( INPUT i-month AS INTEGER ) :
      775     DEFINE VARIABLE v-name AS CHARACTER NO-UNDO.
      776     RUN get-month-name-gen IN THIS-PROCEDURE ( INPUT i-month, OUTPUT v-name ) NO-ERROR.
      777     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE v-name ).
      778   END FUNCTION.
      779   PROCEDURE get-month-name-gen :
      780     DEFINE  INPUT PARAMETER p-month AS INTEGER   NO-UNDO.
      781     DEFINE OUTPUT PARAMETER p-name  AS CHARACTER NO-UNDO.
      782     DEFINE VARIABLE v-list AS CHARACTER NO-UNDO INITIAL "Января,Февраля,Марта,Апреля,Мая,Июня,Июля,Августа,Сентября,Октября,Ноября,Декабря".
      783     DO ON ERROR UNDO, RETURN ERROR :
      784       ASSIGN p-name = ( IF p-month >= 1 AND p-month <= 12 THEN ENTRY( p-month, v-list ) ELSE ? ).
      785     END.
      786   END PROCEDURE.
