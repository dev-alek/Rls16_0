     1023   define variable o-head-position      AS character no-undo.
     1024   define stream Out-Stream.
     1025   define stream OutStr-html.
     1026   define buffer buf_currency for ub.currency.
     1027   define buffer buf_sysconf  FOR ub.sysconf.
     1028   do
     1029     on error undo, return error return-value
     1030     :
     1031     mCashBook = new ibs.th.ref.cashbookstorage () .
     1032     o-uchet    = mCashBook:getSinglRule(buf_fin-doc.CashBookId, buf_fin-doc.obj-type, buf_fin-doc.obj-code, "uchet") .
     1033     if o-uchet = "0"
     1034       then v-uchet = "cal" .
     1035     else v-uchet = "smen" .
     1036     delete object mCashBook no-error .
     1037     run get-report-num  (output g#report-num).
     1038     v-file-name-rep-html = session:temp-directory + string(g#report-num) + ".html".
     1039     if p-format <> 0
     1040       and p-format <> ?
     1041       and p-append
     1042       then
     1043     do:
     1044       assign
     1045         p-format = ?
     1046         .
     1047       return.
     1048     end.
     1049     assign
     1050       Line = fill("_":U, 136)
     1051       .
     1052     assign
     1053       v-chernovik = if buf_fin-doc.status_ = 'новый':U
     1054                   then "Ч Е Р Н О В И К"
     1055                   else (fill( chr(32), 15))
     1056       .
     1057     if buf_fin-doc.curr-code = 0 then
     1058     do:
     1059       assign
     1060         v-rub       = " руб.":U
     1061         v-kop       = " коп.":U
     1062         v-title-rub = v-rub + v-kop + chr(32) + chr(32)
     1063         .
     1064     end.
     1065     else
     1066     do:
     1067       find first buf_currency no-lock where
     1068         buf_currency.curr-code = buf_fin-doc.curr-code .
     1069       assign
     1070         v-rub       = chr(32) + buf_currency.curr-abbr + ".":U
     1071         v-kop       = chr(32) + buf_currency.part-abbr + ".":U
     1072         v-title-rub = "       инвалюты       ":U
     1073         v-okv-code  = (if buf_currency.okv-code = 0
     1074                     then "Код ОКВ?"
     1075                     else string(buf_Currency.okv-code))
     1076         .
     1077     end.
     1078     assign
     1079       v-enclosure-1 = Break-n-line(Buf_fin-doc.enclosure, "62,73", output num-lines)
     1080       v-enclosure-2 = if num-lines >=2
     1081                         then entry(2, v-enclosure-1, chr(4))
     1082                         else "":U
     1083       v-enclosure-1 = entry(1, v-enclosure-1, chr(4))
     1084       .
     1085     assign
     1086       v-passport-1 = Break-n-line(Buf_fin-doc.receiver-passport, "70,73", output num-lines)
     1087       v-passport-2 = if num-lines >=2
     1088                         then entry(2, v-passport-1, chr(4))
     1089                         else "":U
     1090       v-passport-1 = entry(1, v-passport-1, chr(4))
     1091       .
     1092     assign
     1093       v-date-create = buf_fin-doc.doc-date
     1094       v-doc-date-f = string(buf_fin-doc.doc-date, "99.99.9999":U) + " г."
     1095     .
     1096     Case buf_fin-doc.str-podr-type :
     1097       when 'маг':U then
     1098         do:
     1099           find first ub.shop
     1100             where ub.shop.obj-code = buf_fin-doc.str-podr-code
     1101             no-error.
     1102           if available ub.shop then
     1103           do:
     1104             assign
     1105               v-str-podr-name = buf_fin-doc.str-podr-name.
     1106           end.
     1107         end.
     1108       when 'скл':U then
     1109         do:
     1110           find first ub.store
     1111             where ub.store.obj-code = buf_fin-doc.str-podr-code
     1112             no-error.
     1113           if available ub.store then
     1114           do:
     1115             assign
     1116               v-str-podr-name = buf_fin-doc.str-podr-name + " " + ub.store.addres1.
     1117           end.
     1118         end.
     1119     end case.
     1120     if v-str-podr-name = "" then v-str-podr-name = buf_fin-doc.str-podr-name .
     1121     assign
     1122       v-naznach-plat-1 = Break-n-line(buf_fin-doc.naznach-plat, "125,136":U, output num-lines)
     1123       v-naznach-plat-2 = (if num-lines >=2
     1124                         then entry(2, v-naznach-plat-1, chr(4))
     1125                         else "":U
     1126                         )
     1127       v-naznach-plat-1 = entry(1, v-naznach-plat-1, chr(4))
     1128       .
     1129     if buf_fin-doc.curr-code = 0 then
     1130     do:
     1131       assign
     1132         v-dops = Sum-in-Words-Without-Dec(buf_fin-doc.sum-doc)
     1133         .
     1134       assign
     1135         v-sum-kop-p = string((buf_fin-doc.sum-doc - truncate(buf_fin-doc.sum-doc, 0)) * 100, "99":U)
     1136         .
     1137       v-line2 = 121.
     1138     end.
     1139     else
     1140     do:
     1141       assign
     1142         v-dops  = Sum-in-Words-Invalut(buf_fin-doc.sum-doc, buf_fin-doc.curr-code)
     1143         v-line2 = 136
     1144         .
     1145     end.
     1146     assign
     1147       v-sum-doc-v1 = Break-n-line(v-dops, ("128,":U + string(v-line2)), output num-lines)
     1148       v-sum-doc-v2 = If num-lines >= 2
     1149                    then entry(2, v-sum-doc-v1, chr(4))
     1150                    else "":U
     1151       v-sum-doc-v2 = v-sum-doc-v2 +  fill("-":U, v-line2 - length(v-sum-doc-v2))
     1152       v-sum-doc-v1 = entry(1, v-sum-doc-v1, chr(4))
     1153       v-sum-doc-v1 = v-sum-doc-v1 +  fill("-":U, 128 - length(v-sum-doc-v1))
     1154       v-sum-doc-v1 = caps(substring(v-sum-doc-v1, 1, 1)) + substring(v-sum-doc-v1, 2)
     1155       .
     1156     assign
     1157       v-sum-doc-n1 = Break-n-line(v-dops, ("128,":U + string(v-line2)), output num-lines)
     1158       v-sum-doc-n2 = If num-lines >= 2
     1159                    then entry(2, v-sum-doc-n1, chr(4))
     1160                    else "":U
     1161       v-sum-doc-n2 = v-sum-doc-n2 +  fill("-":U, v-line2 - length(v-sum-doc-n2))
     1162       v-sum-doc-n1 = entry(1, v-sum-doc-n1, chr(4))
     1163       v-sum-doc-n1 = v-sum-doc-n1 +  fill("-":U, 128 - length(v-sum-doc-n1))
     1164       v-sum-doc-n1 = caps(substring(v-sum-doc-n1, 1, 1)) + substring(v-sum-doc-n1, 2)
     1165       .
     1166     mCashBook = new ibs.th.ref.cashbookstorage () .
     1167     o-head-position = mCashBook:getSinglRule(0 , buf_fin-doc.obj-type, buf_fin-doc.obj-code, "ManagerPosition") .
     1168     delete object mCashBook no-error .
     1169     case o-head-position:
     1170       when '1':U then
     1171         do:
     1172           v-head-position = "Директор".
     1173         end.
     1174       when '2':U then
     1175         do:
     1176           v-head-position = "Управляющий".
     1177         end.
     1178       when '0':U then
     1179         do:
     1180           for first buf_sysconf where buf_sysconf.host-code = buf_fin-doc.host-code:
     1181             v-head-position = buf_sysconf.head-position.
     1182           end.
     1183         end.
     1184       otherwise
     1185       do:
     1186         v-head-position = o-head-position .
     1187       end.
     1188     end case.
     1189     v-sign1         = (if num-entries(buf_fin-doc.payer-sign1, chr(4))  > 1
     1190       then entry(2, buf_fin-doc.payer-sign1, chr(4))
     1191       else entry(1, buf_fin-doc.payer-sign1, chr(4))
     1192       )
     1193       .
     1194     run db-attr-value(INPUT v-cntxt-db-num,INPUT 'hist-code':U,OUTPUT v-hist-code ,OUTPUT par-type) .
     1195     output stream OutStr-html to value(v-file-name-rep-html) convert target 'UTF-8'.
     1196     put stream OutStr-html unformatted
     1197       "<!DOCTYPE HTML>" skip
     1198       ' <html>' skip
     1199       '  <head>' skip
     1200       '   <meta charset="utf-8">' skip
     1201       '    <style type="text/css">' skip
     1202       '      table ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     1203       '      .class1 ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     1204       '      tbody td, th ' + chr(123) + ' border-collapse: collapse; border: 1px solid black; height: 14px;' + chr(125) skip
     1205       '   </style>' skip
     1206       '  </head>' skip
     1207       '<body>' skip
     1208       .
     1209     put stream OutStr-html unformatted
     1210       '<TABLE fit_to_page="true" orientation="portrait" CELLSPACING="0" BORDER="0" name="Отчет">'skip
     1211       .
     1212     put stream OutStr-html unformatted
     1213       '<thead>' skip
     1214       '<tr  class="set_columns">' skip
