      904   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      905   define variable v-waitfram-action01         as character   no-undo .
      906   define variable v-waitfram-action02         as character   no-undo .
      907   define variable v-waitfram-action03         as character   no-undo .
      908   define variable mWaitFramTextBeg            as character   no-undo.
      909   define variable mWaitFramTextEnd            as character   no-undo.
      910   define variable mWaitFramView               as logical     no-undo.
      911   define variable mWaitProcEvent              as logical     no-undo init yes.
      912   define variable mWaitFramInterval           as integer     no-undo init 1 .
      913   define variable mWaitFramStop               as logical     no-undo.
      914   define variable mWaitFramStopUser           as logical     no-undo.
      915   define variable mWaitFramStopTimeOut        as logical     no-undo.
      916   define variable mWaitFramStartProc          as datetime-tz no-undo.
      917   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      918   define button B-WaitFramStop auto-end-key
      919        label "Стоп"
      920        size 10 by 1 tooltip "Остоновить процесс".
      921   define button B-viewProcInfo
      922        label "Информация"
      923        size 15 by 1 tooltip "Информация о процесс".
      924   define frame waitfram
      925     v-waitfram-action01 format "x(72)" no-label skip
      926     v-waitfram-action02 format "x(72)" no-label skip
      927     v-waitfram-action03 format "x(72)" no-label skip
      928     B-viewProcInfo
      929     B-WaitFramStop at row 4 col 30
      930     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      931     .
      932   define new global shared variable mBatchMode as logical no-undo init ?.
      933   define variable mFramBachModHandle as handle no-undo.
      934   mFramBachModHandle = frame waitfram:handle.
      935   define variable mFameOldVis as logical no-undo.
      936   define variable mVisCUrentVin as logical no-undo.
      937   if session:batch-mode
      938   then
      939      mBatchMode = yes.
      940   if mBatchMode = ? then do:
      941     mVisCUrentVin = current-window:visible.
      942     mFameOldVis = mFramBachModHandle:visible.
      943     mFramBachModHandle:visible  = yes.
      944     mBatchMode = mFramBachModHandle:visible ne yes.
      945     mFramBachModHandle:visible = mFameOldVis.
      946     current-window:visible = mVisCUrentVin.
      947   end.
      948    if  log-manager:logfile-name ne ?
      949     then DO:
      950         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      951         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      952         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      953     end.
      954   on choose of B-WaitFramStop in frame waitfram
      955   do:
      956     mWaitFramStop = yes.
      957     mWaitFramStopUser = yes.
      958   end.
      959   function waitfram-check-timeout returns logical():
      960      define variable vtime as int64 no-undo.
      961      if mWaitFramStopTimeOut
      962      then
      963         return yes.
      964      vtime = ( now - mWaitFramStartProc ) / 1000 .
      965      if     mWaitFramTimeOut ne ?
      966         and mWaitFramTimeOut ne 0
      967         and mWaitFramTimeOut lt vtime
      968      then do:
      969         mWaitFramStopTimeOut = yes.
      970      end.
      971      return mWaitFramStopTimeOut.
      972   end.
      973   procedure waitfram-hide :
      974     if not session:batch-mode
      975     then do
      976     on error undo, return error return-value
      977     :
      978       pause 0 before-hide .
      979       if not mBatchMode then
      980         hide frame waitfram .
      981     if     not mWaitFramView
      982        and mWaitProcEvent
      983     then
      984       process events .
      985     end.
      986   end procedure.
      987   procedure waitfram-show :
      988     define input  parameter p-message as character no-undo .
      989     define variable v-left-margin as integer   no-undo .
      990     if not session:batch-mode
      991     then do
      992     on error undo, return error return-value
      993     :
      994       if length(p-message) <= 70 then do:
      995         assign
      996           v-left-margin = integer((70 - length(p-message)) / 2)
      997         .
      998         assign
      999           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1000         .
     1001         assign
     1002           v-waitfram-action01 = " "
     1003           v-waitfram-action02 = " "
     1004                                    + fill(" ", v-left-margin)
     1005                                    + p-message
     1006           v-waitfram-action03 = " "
     1007         .
     1008       end.
     1009       else do:
     1010         define variable vRindex1 as integer no-undo.
     1011         define variable vRindex2 as integer no-undo.
     1012         vRindex1 = r-index(p-message," ",70).
     1013         if vRindex1 = 0
     1014         then
     1015            vRindex1 = 70.
     1016         if length(p-message)  <= vRindex1 + 70 then do:
     1017           assign
     1018             v-waitfram-action01 = " "
     1019             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1020             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1021           .
     1022         end.
     1023         else do:
     1024           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1025           if vRindex2 <= vRindex1
     1026           then
     1027              vRindex2 = vRindex1 + 70.
     1028           assign
     1029             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1030             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1031             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1032           .
     1033         end.
     1034       end.
     1035       B-viewProcInfo:visible   in frame waitfram = no.
     1036       B-viewProcInfo:sensitive in frame waitfram = no.
     1037       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1038       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1039       if  (   mWaitFramView
     1040          or  mWaitProcEvent)
     1041          and not mBatchMode
     1042       then
     1043          display
     1044             v-waitfram-action01 skip
     1045             v-waitfram-action02 skip
     1046             v-waitfram-action03 skip
     1047          with frame waitfram .
     1048       if     mWaitFramView
     1049          then do:
     1050             if     mWaitFramInterval ne ?
     1051                and not mBatchMode
     1052             then
     1053                wait-for go of frame waitfram pause mWaitFramInterval.
     1054          end.
     1055          else
     1056             if     mWaitProcEvent
     1057                and not mBatchMode
     1058             then
     1059                process events .
     1060     end.
     1061   end procedure.
     1062      procedure waitfram-show-this:
     1063         define input  parameter iInterval as int64 no-undo.
     1064         define variable vtime as int64 no-undo.
     1065         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1066         mWaitFramInterval = iInterval.
     1067         run waitfram-show (substitute("&1&2 &3&4" ,
     1068                                       mWaitFramTextBeg ,
     1069                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1070                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1071                                       mWaitFramTextEnd
     1072                                      )
     1073                           ).
     1074      end.
     1075      procedure WaitFramRunPause:
     1076         define input  parameter iInterval as dec no-undo.
     1077         define variable vStart  as datetime-tz no-undo.
     1078         define variable vend    as datetime-tz no-undo.
     1079         define variable vint as int64 no-undo.
     1080         define variable vOk as logical no-undo.
     1081         vStart = now.
     1082         vend   = vStart.
     1083         publish "WaitFramPause" (iInterval,output vOk).
     1084         vend   =  now.
     1085         vint = vend - vStart.
     1086         vint = iInterval - vint / 1000.
     1087         if     not mWaitFramStop
     1088            and (   vint > 0
     1089                 or (    not vOk
     1090                     and iInterval eq ?
     1091                     )
     1092                 )
     1093         then
     1094            run waitfram-show-this (iInterval).
     1095         vend   =  now.
     1096         vint = vend - vStart.
     1097         vint = iInterval - vint / 1000.
     1098         if     not mWaitFramStop
     1099            and vint > 0
     1100         then do:
     1101            run gbl/pause.p (vint * 1000).
     1102         end.
     1103         if iInterval ne ?
     1104         then
     1105            publish "WaitFramStop".
     1106         waitfram-check-timeout().
     1107      end.
     1108      procedure WaitFramWaitFor:
     1109         define input  parameter iInterval as dec no-undo.
     1110         assign
     1111            mWaitFramStartProc   = now
     1112            mWaitFramStopUser    = no
     1113            mWaitFramStopTimeOut = no
     1114         .
     1115         block-wait:
     1116         do while not mWaitFramStop:
     1117            run WaitFramRunPause (iInterval).
     1118            if  waitfram-check-timeout()
     1119            then do:
     1120               leave block-wait.
     1121            end.
     1122         end.
     1123         run waitfram-hide.
     1124      end.
     1125   procedure waitfram-join :
     1126     define input  parameter p-line-1  as character no-undo .
     1127     define input  parameter p-line-2  as character no-undo .
     1128     define input  parameter p-line-3  as character no-undo .
     1129     define output parameter p-message as character no-undo .
     1130     do
     1131     on error undo, return error return-value
     1132     :
     1133       assign
     1134         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1135                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1136                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1137       .
     1138     end.
     1139   end procedure.
     1140   function waitfram-join-function returns character
     1141     (input p-line-1 as character
     1142     ,input p-line-2 as character
     1143     ,input p-line-3 as character
     1144     ).
     1145     define variable v-message as character no-undo .
     1146     run waitfram-join in this-procedure
     1147       (input  p-line-1
     1148       ,input  p-line-2
     1149       ,input  p-line-3
     1150       ,output v-message
     1151       ) .
     1152     return v-message .
     1153   end function .
     1154   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1155   define variable  sym1 as char init ":"   no-undo.
     1156   define variable  sym2 as char init ":"   no-undo.
     1157   define variable  sym3 as char init ":"   no-undo.
     1158   define variable  sym4 as char init ":"   no-undo.
     1159   define variable  sym5 as char init ":"   no-undo.
     1160   define variable  sym6 as char init ":"   no-undo.
     1161   define variable  sym7 as char init ":"   no-undo.
     1162   define variable  sym8 as char init ":"   no-undo.
     1163   define variable  tb-code as char no-undo.
     1164   define variable  pbtb-code as character no-undo .
     1165   define variable  free-clmn as char no-undo.
     1166   define variable  Line         as  char    no-undo.
     1167   define variable  v-ind as integer no-undo .
     1168   DEFINE VARIABLE varattr-value as character no-undo .
     1169   DEFINE VARIABLE varattr-type as character no-undo .
     1170   define buffer buf_clients for ub.clients.
     1171   define buffer buf_units for ub.units.
     1172   define stream PrnLibStream.
     1173   DEFINE FRAME zapas
     1174   sym1 column-label ":!:" format "X(1)"
     1175   gds-zap.weight-bc column-label "Вес.!код" format "X(5)"
     1176   sym2 column-label ":!:" format "X(1)"
     1177   tb-code column-label "Код! " format "x(10)"
     1178   sym8 column-label ":!:" format "X(1)"
     1179   pbtb-code column-label "   ДопБк  " format "x(13)"
     1180   sym3 column-label ":!:" format "X(1)"
     1181   gds-zap.artic column-label "Артикул! " format "X(16)"
     1182   sym4 column-label ":!:" format "X(1)"
     1183   gds-zap.gds-name column-label "Название товара! " format "X(50)"
     1184   sym5 column-label ":!:" format "X(1)"
     1185   free-clmn column-label "Для заметок! " format "X(38)"
     1186   sym6 column-label ":!:" format "X(1)"
     1187   HEADER
     1188   cur-time-print() AT 5 format "X(35)"
     1189   string( "Страница" ) AT 110 PAGE-NUMBER(Prnlibstream) AT 120 FORMAT ">>>9" SKIP
     1190   Line format "X(135)" AT 1
     1191   with width 160 down stream-io.
     1192   if not can-find(first bb-list) then do:
     1193     message
     1194       "Список пустой"
     1195       view-as alert-box information .
     1196     return .
     1197   end.
     1198   run waitfram-show in this-procedure ( "Обработано записей " ) .
     1199   FOR EACH bb-list USE-INDEX art NO-LOCK:
     1200     assign
     1201     v-ind = v-ind + 1
     1202     .
     1203     if ( v-ind modulo 25 ) = 0 then do:
     1204       run waitfram-show in this-procedure ( "Обработано записей " + string(v-ind) ) .
     1205     end.
     1206     FIND buf_clients WHERE
     1207        buf_clients.obj-type = bb-list.prod-type
     1208    AND buf_clients.obj-code = bb-list.prod-code NO-LOCK .
     1209     CREATE gds-zap .
     1210     assign
     1211     gds-zap.unit-base  = bb-list.unit-base
     1212     gds-zap.prt-root     = bb-list.prt-root
     1213     gds-zap.gds-name = bb-list.gds-name
     1214     gds-zap.prod-type  = bb-list.prod-type
     1215     gds-zap.prod-code = bb-list.prod-code
     1216     gds-zap.artic          = bb-list.artic
     1217     gds-zap.prod-name = buf_clients.obj-name
     1218     gds-zap.grp-name = bb-list.grp-name
     1219     gds-zap.order-num  = bb-list.order-num
     1220     .
     1221   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1222     (input  bb-list.gds-code
     1223     ,input  ?
     1224     ,output gds-zap.b-code
     1225     )  .
     1226     assign
     1227       gds-zap.weight-bc = ""
     1228     .
     1229     FIND buf_units WHERE
     1230         buf_units.unit-name = bb-list.unit-base NO-LOCK.
     1231     if lookup('вес':U, buf_units.type) > 0 then do:
     1232       varattr-value = "":U.
     1233       run gdsoattr-value in this-procedure(
     1234                                             input 'scales-code':U
     1235                                             ,input bb-list.gds-code
     1236                                             ,input p-obj-type
     1237                                             ,input p-obj-code
     1238                                             ,output varattr-value
     1239                                             ,output varattr-type
     1240                                             ) no-error.
     1241       assign gds-zap.weight-bc = varattr-value.
     1242     end.
     1243     gds-zap.b-str     = (if gds-zap.weight-bc <> ? and gds-zap.weight-bc <> '':U then '':U else bb-list.b-str).
     1244   END.
     1245   run waitfram-hide in this-procedure .
     1246     run prn-lib-open-stream  in this-procedure (
     1247                                               input parparentproc
     1248                                               ,input 62
     1249                                               ,input yes
     1250                                               ,input no
     1251                                               ).
     1252   PUT  stream PrnlibStream
     1253   space(30)
     1254   "СПИСОК  КОДОВ" format "X(50)" SKIP(1)
     1255            .
     1256   FORM HEADER
     1257   Line format "X(135)" AT 1 SKIP
     1258   "Продолжение - на следующей странице" AT 30 SKIP
     1259   with FRAME BottomFrame width 160 PAGE-BOTTOM NO-LABELS NO-BOX.
     1260   VIEW stream Prnlibstream FRAME BottomFrame .
     1261   Line = fill("-", 140) .
     1262   FORM with frame zapas .
     1263   CASE p-Classify :
     1264     when "Classify_1" then do:
     1265       FOR EACH gds-zap BREAK BY  (if p-sorttype = "artic":U                     then gds-zap.artic                     else (if p-sorttype = "b-code":U                           then string( gds-zap.b-code, "9999999999" )                           else string(gds-zap.order-num, "9999999999"))                           ) :
     1266         DISPLAY stream PrnLibStream
     1267         sym1 string( gds-zap.b-code, ">>>>>>>>>9" ) @ tb-code
     1268         sym2 gds-zap.artic sym3 gds-zap.gds-name
     1269         sym4 gds-zap.weight-bc
     1270         sym5 free-clmn sym6
     1271           sym8
     1272           gds-zap.b-str @ pbtb-code
     1273         with frame zapas .
     1274         DOWN stream PrnLibStream
     1275         1 with frame zapas .
     1276       END.
     1277     end.
     1278     when "Classify_2" then do:
     1279       FOR EACH gds-zap
     1280       BREAK
     1281       BY ( gds-zap.prod-type + string( gds-zap.prod-code ) )
     1282       BY (if p-sorttype = "artic":U                     then gds-zap.artic                     else (if p-sorttype = "b-code":U                           then string( gds-zap.b-code, "9999999999" )                           else string(gds-zap.order-num, "9999999999"))                           ) :
     1283         if first-of ( ( gds-zap.prod-type + string( gds-zap.prod-code ) ) ) then  do:
     1284           if NOT first ( ( gds-zap.prod-type + string( gds-zap.prod-code ) ) ) then do:
     1285               UNDERLINE stream PrnLibStream
     1286               tb-code
     1287               gds-zap.artic
     1288               gds-zap.gds-name
     1289               with frame zapas .
     1290           end.
     1291           DISPLAY stream PrnLibStream
     1292           sym1
     1293           "Производитель :" @ gds-zap.artic
     1294           gds-zap.prod-name @ gds-zap.gds-name
     1295           sym5 with frame zapas .
     1296           DOWN stream PrnLibStream
     1297           1 with frame zapas .
     1298           UNDERLINE stream PrnLibStream
     1299           tb-code
     1300           gds-zap.artic
     1301           gds-zap.gds-name
     1302           with frame zapas .
     1303         end.
     1304         DISPLAY stream PrnLibStream
     1305         sym1 string( gds-zap.b-code, ">>>>>>>>>9" ) @ tb-code
     1306         sym2 gds-zap.artic sym3 gds-zap.gds-name
     1307         sym4 gds-zap.weight-bc
     1308         sym5 free-clmn sym6
     1309         with frame zapas .
     1310         DOWN stream PrnLibStream
     1311         1 with frame zapas .
     1312       END.
     1313     END.
     1314     when "Classify_3" then do:
     1315       FOR EACH gds-zap
     1316       BREAK
     1317       BY gds-zap.grp-name
     1318       BY (if p-sorttype = "artic":U                     then gds-zap.artic                     else (if p-sorttype = "b-code":U                           then string( gds-zap.b-code, "9999999999" )                           else string(gds-zap.order-num, "9999999999"))                           )  :
     1319         if first-of ( gds-zap.grp-name ) then do:
     1320           if NOT first ( gds-zap.grp-name ) then do:
     1321             UNDERLINE stream PrnLibStream
     1322             tb-code
     1323             gds-zap.artic
     1324             gds-zap.gds-name
     1325             with frame zapas .
     1326           end.
     1327           DISPLAY stream PrnLibStream
     1328           sym1 "Группа товаров :" @ gds-zap.artic
     1329           gds-zap.grp-name @ gds-zap.gds-name
     1330           sym5
     1331           with frame zapas .
     1332           DOWN stream PrnLibStream
     1333           1 with frame zapas .
     1334           UNDERLINE stream PrnLibStream
     1335           tb-code
     1336           gds-zap.artic
     1337           gds-zap.gds-name
     1338           with frame zapas .
     1339         end.
     1340         DISPLAY stream PrnLibStream
     1341         sym1 string( gds-zap.b-code, ">>>>>>>>>9" ) @ tb-code
     1342         sym2 gds-zap.artic sym3 gds-zap.gds-name
     1343         sym4 gds-zap.weight-bc
     1344         sym5 free-clmn
     1345         sym6
     1346           sym8
     1347           gds-zap.b-str @ pbtb-code
     1348         with frame zapas .
     1349         DOWN stream PrnLibStream
     1350         1 with frame zapas .
     1351       END.
     1352     end.
     1353     when "Classify_4" then do:
     1354       FOR EACH gds-zap
     1355       BREAK
     1356       BY ( gds-zap.prod-type + string( gds-zap.prod-code ) )
     1357       BY gds-zap.grp-name
     1358       BY (if p-sorttype = "artic":U                     then gds-zap.artic                     else (if p-sorttype = "b-code":U                           then string( gds-zap.b-code, "9999999999" )                           else string(gds-zap.order-num, "9999999999"))                           ) :
     1359         if first-of ( ( gds-zap.prod-type + string( gds-zap.prod-code ) ) ) then do:
     1360           if NOT first ( ( gds-zap.prod-type + string( gds-zap.prod-code ) ) ) then do:
     1361             UNDERLINE stream PrnLibStream
     1362             tb-code
     1363             gds-zap.artic
     1364             gds-zap.gds-name
     1365             with frame zapas .
     1366           end.
     1367           DISPLAY stream PrnLibStream
     1368           sym1  "Производитель :" @ gds-zap.artic
     1369           gds-zap.prod-name @ gds-zap.gds-name
     1370           sym5 with frame zapas .
     1371           DOWN stream PrnLibStream
     1372           1 with frame zapas .
     1373           UNDERLINE stream PrnLibStream
     1374           tb-code
     1375           gds-zap.artic
     1376           gds-zap.gds-name
     1377           with frame zapas .
     1378         end.
     1379         if first-of ( gds-zap.grp-name ) then do:
     1380           if NOT first ( gds-zap.grp-name ) then do:
     1381             UNDERLINE stream PrnLibStream
     1382             tb-code
     1383             gds-zap.artic
     1384             gds-zap.gds-name
     1385             with frame zapas .
     1386           end.
     1387           DISPLAY stream PrnLibStream
     1388           sym1 "Группа товаров :" @ gds-zap.artic
     1389           gds-zap.grp-name @ gds-zap.gds-name
     1390           sym5 with frame zapas .
     1391           DOWN stream PrnLibStream
     1392           1 with frame zapas .
     1393           UNDERLINE stream PrnLibStream
     1394           tb-code
     1395           gds-zap.artic
     1396           gds-zap.gds-name
     1397           with frame zapas .
     1398         end.
     1399         DISPLAY stream PrnLibStream
     1400         sym1 string( gds-zap.b-code, ">>>>>>>>>9" ) @ tb-code
     1401         sym2 gds-zap.artic sym3 gds-zap.gds-name
     1402         sym4 gds-zap.weight-bc
     1403         sym5 free-clmn sym6
     1404           sym8
     1405           gds-zap.b-str @ pbtb-code
     1406         with frame zapas .
     1407         DOWN stream PrnLibStream
     1408         1 with frame zapas .
     1409       END.
     1410     end.
     1411     when "Classify_5" then do:
     1412       FOR EACH gds-zap
     1413       BREAK
     1414       BY gds-zap.grp-name
     1415       BY ( gds-zap.prod-type + string( gds-zap.prod-code ) )
     1416       BY (if p-sorttype = "artic":U                     then gds-zap.artic                     else (if p-sorttype = "b-code":U                           then string( gds-zap.b-code, "9999999999" )                           else string(gds-zap.order-num, "9999999999"))                           ) :
     1417         if first-of ( gds-zap.grp-name ) then  do:
     1418           if NOT first ( gds-zap.grp-name ) then do:
     1419             UNDERLINE stream PrnLibStream
     1420             tb-code
     1421             gds-zap.artic
     1422             gds-zap.gds-name
     1423             with frame zapas .
     1424           end.
     1425           DISPLAY stream PrnLibStream
     1426           sym1 "Группа товаров :" @ gds-zap.artic
     1427           gds-zap.grp-name @ gds-zap.gds-name
     1428           sym5 with frame zapas .
     1429           DOWN stream PrnLibStream
     1430           1 with frame zapas .
     1431           UNDERLINE stream PrnLibStream
     1432           tb-code gds-zap.artic gds-zap.gds-name with frame zapas .
     1433         end.
     1434         if first-of ( ( gds-zap.prod-type + string( gds-zap.prod-code ) ) ) then do:
     1435           if NOT first ( ( gds-zap.prod-type + string( gds-zap.prod-code ) ) ) then do:
     1436             UNDERLINE stream PrnLibStream
     1437             tb-code
     1438             gds-zap.artic
     1439             gds-zap.gds-name
     1440             with frame zapas .
     1441           end.
     1442           DISPLAY stream PrnLibStream
     1443           sym1 "Производитель :" @ gds-zap.artic
     1444           gds-zap.prod-name @ gds-zap.gds-name
     1445           sym5
     1446           with frame zapas .
     1447           DOWN stream PrnLibStream
     1448           1 with frame zapas .
     1449           UNDERLINE stream PrnLibStream
     1450           tb-code gds-zap.artic gds-zap.gds-name with frame zapas .
     1451         end.
     1452         DISPLAY stream PrnLibStream
     1453         sym1 string( gds-zap.b-code, ">>>>>>>>>9" ) @ tb-code
     1454         sym2 gds-zap.artic sym3 gds-zap.gds-name
     1455         sym4 gds-zap.weight-bc
     1456         sym5 free-clmn sym6
     1457           sym8
     1458           gds-zap.b-str @ pbtb-code
     1459         with frame zapas .
     1460         DOWN stream PrnLibStream
     1461         1 with frame zapas .
     1462       END.
     1463     END.
     1464   END CASE .
     1465   HIDE stream PrnlibStream FRAME BottomFrame .
     1466   PUT  stream PrnlibStream
     1467   Line format "X(135)" SKIP .
     1468   output stream PrnlibStream CLOSE .
     1469   run prn-lib-prn-file in this-procedure (
     1470                                             input parparentproc
     1471                                             ,input 0
     1472                                             ).
     1473   return "OK" .
