      858              VIEW-AS ALERT-BOX ERROR.
      859      RETURN.
      860     END PROCEDURE.
      861   PROCEDURE adm-assign-statement :
      862     RETURN.
      863   END PROCEDURE.
      864   PROCEDURE adm-cancel-record :
      865      RETURN.
      866     END PROCEDURE.
      867   PROCEDURE adm-copy-record :
      868       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      869        "must have at least one Enabled Table to perform Copy.":U
      870          VIEW-AS ALERT-BOX ERROR.
      871       RETURN.
      872   END PROCEDURE.
      873   PROCEDURE adm-create-record :
      874      RETURN.
      875   END PROCEDURE.
      876   PROCEDURE adm-current-changed :
      877     RETURN.
      878   END PROCEDURE.
      879   PROCEDURE adm-delete-record :
      880    MESSAGE
      881          "Object ":U THIS-PROCEDURE:FILE-NAME
      882            "must have at least one Enabled Table to perform Delete.":U
      883              VIEW-AS ALERT-BOX ERROR.
      884       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
      885       RETURN.
      886   END PROCEDURE.
      887   PROCEDURE adm-disable-fields :
      888         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
      889       RETURN.
      890   END PROCEDURE.
      891   PROCEDURE adm-enable-fields :
      892       RETURN.
      893   END PROCEDURE.
      894   PROCEDURE adm-end-update :
      895     RETURN.
      896   END PROCEDURE.
      897   PROCEDURE adm-reset-record :
      898       RETURN.
      899   END PROCEDURE.
      900   PROCEDURE adm-update-record :
      901       MESSAGE
      902         "Object ":U THIS-PROCEDURE:FILE-NAME
      903           "must have at least one Enabled Table to perform Update.":U
      904             VIEW-AS ALERT-BOX ERROR.
      905      RETURN.
      906   END PROCEDURE.
      907   PROCEDURE check-modified :
      908   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
      909   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
      910   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
      911   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
      912     IF check-state = "check":U THEN
      913     DO:
      914       RUN get-link-handle IN adm-broker-hdl
      915         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
      916            OUTPUT group-target-list).
      917       IF group-target-list NE "":U THEN
      918       DO i = 1 TO NUM-ENTRIES(group-target-list):
      919         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
      920         RUN check-modified IN curr-widget ('group-check':U).
      921         IF RETURN-VALUE NE "":U THEN
      922         DO:
      923           RUN check-modified-message(RETURN-VALUE).
      924           RETURN "":U.
      925         END.
      926       END.
      927     END.
      928     RETURN "":U.
      929   END PROCEDURE.
      930   PROCEDURE check-modified-message :
      931     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
      932        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
      933           'CONTAINER-SOURCE':U, 'HIDDEN':U).
      934        IF RETURN-VALUE = "YES":U THEN
      935           RUN notify ('view,CONTAINER-SOURCE':U).
      936        MESSAGE IF p-changed-table NE ? THEN
      937           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
      938           ELSE "Current values have been changed."
      939           SKIP "  Do you wish to save those changes?"
      940           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
      941        IF ANS THEN
      942        DO:
      943           IF group-assign-target THEN
      944             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
      945           ELSE RUN dispatch('update-record':U).
      946           IF RETURN-VALUE = "ADM-ERROR":U THEN
      947           DO:
      948               MESSAGE "Changes to the previous record were not saved."
      949                 VIEW-AS ALERT-BOX ERROR.
      950               IF group-assign-target THEN
      951                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      952               ELSE RUN dispatch ('cancel-record':U).
      953           END.
      954        END.
      955        ELSE DO:
      956          IF group-assign-target THEN
      957             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      958          ELSE RUN dispatch('cancel-record':U).
      959        END.
      960        RETURN.
      961   END PROCEDURE.
      962   PROCEDURE get-rowid :
      963       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
      964       ASSIGN
      965       p-table   =   adm-first-table.
      966       RETURN.
      967   END PROCEDURE.
      968   PROCEDURE init-group-assign :
      969       RUN request-attribute IN adm-broker-hdl
      970         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
      971       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
      972         group-assign-target = yes.
      973       ELSE group-assign-target = no.
      974       RETURN.
      975   END PROCEDURE.
      976   PROCEDURE set-editors :
      977       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
      978       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
      979       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
      980       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
      981       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
      982       DO WHILE VALID-HANDLE (curr-widget):
      983           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
      984              curr-widget:HIDDEN = no THEN DO:
      985             CASE p-field-setting:
      986               WHEN "INITIALIZE":U THEN
      987               DO:
      988                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
      989                     read-only-list +
      990                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
      991                        STRING(curr-widget).
      992               END.
      993               WHEN "DISABLE":U OR
      994               WHEN "ENABLE":U THEN
      995               DO:
      996                   curr-widget:SENSITIVE = yes.
      997                   RUN get-attribute ('Read-Only-Editors':U).
      998                   IF RETURN-VALUE = ? OR
      999                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1000                       curr-widget:READ-ONLY =
     1001                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1002               END.
     1003               WHEN "CLEAR":U THEN
     1004                   curr-widget:SCREEN-VALUE = "":U.
     1005             END CASE.
     1006           END.
     1007           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1008       END.
     1009       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1010         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1011           + '"':U).
     1012       RETURN.
     1013   END PROCEDURE.
     1014   PROCEDURE use-check-modified-all :
     1015    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1016     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1017     RETURN.
     1018   END PROCEDURE.
     1019   PROCEDURE use-create-on-add :
     1020   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1021      RETURN.
     1022   END PROCEDURE.
     1023   PROCEDURE use-initial-lock :
     1024     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1025     ASSIGN adm-initial-lock = p-attr-value.
     1026     RETURN.
     1027   END PROCEDURE.
     1028     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1029   on choose of Btn_Columns in frame F-Main
     1030   do:
     1031     define variable v-part-2 as character no-undo .
     1032     define variable v-part-3 as character no-undo .
     1033     find first buf_usr-flt no-lock
     1034       where buf_usr-flt.user-name  = v-cntxt-userid
     1035         and buf_usr-flt.call-point = c-flt
     1036       no-error .
     1037     if available buf_usr-flt
     1038     then do:
     1039       assign
     1040         v-part-2 = ( if num-entries( buf_usr-flt.list_, ";":U ) > 1 then entry( 2, buf_usr-flt.list_, ";":U ) else "":U )
     1041         v-part-3 = ( if num-entries( buf_usr-flt.list_, ";":U ) > 2 then entry( 3, buf_usr-flt.list_, ";":U ) else "":U )
     1042       .
     1043     end.
     1044     else do:
     1045       assign
     1046         v-part-2 = string( input frame F-Main Tog-Suppl, "yes/no":U )
     1047         v-part-3 = string( input frame F-Main r-s-bill#, "9":U      )
     1048       .
     1049     end.
     1050     run rep/c-xtypes.w
     1051       ( input "r-gdsrsl":U
     1052       ) .
     1053     find first buf_usr-flt no-lock
     1054       where buf_usr-flt.user-name  = v-cntxt-userid
     1055         and buf_usr-flt.call-point = c-flt
     1056       no-error .
     1057     if available buf_usr-flt
     1058     then do:
     1059       find first buf_usr-flt exclusive-lock
     1060         where buf_usr-flt.user-name  = v-cntxt-userid
     1061           and buf_usr-flt.call-point = c-flt .
     1062       assign
     1063         buf_usr-flt.list_ = buf_usr-flt.list_ + ";":U + v-part-2
     1064                                               + ";":U + v-part-3
     1065       .
     1066     end.
     1067   end.
     1068   on value-changed of r-s-bill# in frame F-Main
     1069   do:
     1070     assign
     1071       r-s-bill#
     1072     .
     1073   end.
     1074   on value-changed of r-s-suppl in frame F-Main
     1075   do:
     1076     define variable post-grp_recids as character no-undo .
     1077     define variable jj              as integer   no-undo .
     1078     assign
     1079       r-s-suppl
     1080     .
     1081     for each g#supplier
     1082     :
     1083       delete g#supplier .
     1084     end.
     1085     case r-s-suppl :
     1086       when 1
     1087       then do:
     1088         assign
     1089           SuppName = 'все':U
     1090         .
     1091         display
     1092           SuppName
     1093         with frame F-Main .
     1094       end.
     1095       when 2
     1096       then do:
     1097         run ref/cli-all.w
     1098           (  input my-handle
     1099           ,  input "b-sel,b-mark"
     1100           ,  input 'все':U
     1101           ,  input 'все':U
     1102           ,  input 'текущие':U
     1103           ,  input ?
     1104           ,  input ",,,,,,no,,"
     1105           ,  input ?
     1106           , output post-grp_recids
     1107           ) .
     1108         if post-grp_recids = "":U
     1109         then do:
     1110           assign
     1111             SuppName  = 'все':U
     1112             r-s-suppl = 1
     1113           .
     1114           display
     1115             SuppName
     1116             r-s-suppl
     1117           with frame F-Main .
     1118         end.
     1119         else do:
     1120           assign
     1121             SuppName = "":U
     1122           .
     1123           do jj = 1 to num-entries( post-grp_recids )
     1124           :
     1125             find first bf_suppl no-lock where
     1126                 recid( bf_suppl ) = integer( entry( jj, post-grp_recids ) ) .
     1127             create g#supplier .
     1128             assign
     1129               g#supplier.supp-type =            bf_suppl.obj-type
     1130               g#supplier.supp-code =            bf_suppl.obj-code
     1131               g#supplier.supp-name =            bf_suppl.obj-name
     1132               SuppName             = SuppName + bf_suppl.obj-name + chr(10)
     1133             .
     1134           end.
     1135           display
     1136             SuppName
     1137           with frame F-Main .
     1138         end.
     1139       end.
     1140     end case.
     1141   end.
     1142   if not this-procedure :persistent
     1143   then do:
     1144     message
     1145       vss-workfile vss-revision vss-description skip
     1146       "Ошибка при запуске процедуры" skip
     1147       "Данную процедуру следует запускать только с параметром persistent" skip
     1148       view-as alert-box error .
     1149     undo, return error .
     1150   end.
     1151   procedure disable_UI :
     1152     hide frame F-Main no-pause .
     1153     if this-procedure :persistent
     1154     then do:
     1155       delete procedure this-procedure .
     1156     end.
     1157   end procedure.
     1158   procedure local-initialize :
     1159     define variable l-ind as integer no-undo .
     1160     define variable jndex as integer no-undo .
     1161     run dispatch in this-procedure
     1162       ( input 'initialize':U
     1163       ) .
     1164     assign
     1165       c-flt = "r-gdsrsl":U
     1166     .
     1167     do l-ind = 1 to 18
     1168     :
     1169       assign
     1170         use-column[ l-ind ] = no
     1171       .
     1172     end.
     1173     find first buf_usr-flt no-lock
     1174       where buf_usr-flt.user-name  = v-cntxt-userid
     1175         and buf_usr-flt.call-point = c-flt no-error .
     1176     if not available buf_usr-flt
     1177     then do:
     1178       run rep/c-xtypes.w
     1179         ( input "r-gdsrsl":U
     1180         ) .
     1181     end.
     1182     find first buf_usr-flt no-lock where
     1183                buf_usr-flt.user-name  = v-cntxt-userid and
     1184                buf_usr-flt.call-point = c-flt no-error .
     1185     if available buf_usr-flt
     1186     then do:
     1187       find first buf_usr-flt exclusive-lock where
     1188                  buf_usr-flt.user-name  = v-cntxt-userid and
     1189                  buf_usr-flt.call-point = c-flt .
     1190       do l-ind = 1 to num-entries( entry( 1, buf_usr-flt.list_, ";":U ) )
     1191       :
     1192         assign
     1193           jndex = integer( entry( l-ind, entry( 1, buf_usr-flt.list_, ";":U ) ) )
     1194         no-error .
     1195         if error-status :error
     1196         then do:
     1197           next .
     1198         end.
     1199         if jndex >=  1 and
     1200            jndex <= 18
     1201         then do:
     1202           assign
     1203             use-column[ jndex ] = yes
     1204           .
     1205         end.
     1206       end.
     1207     end.
     1208     else do:
     1209       create buf_usr-flt .
     1210       assign
     1211         buf_usr-flt.user-name  = v-cntxt-userid
     1212         buf_usr-flt.call-point = c-flt
     1213       .
     1214       do l-ind = 1 to 18
     1215       :
     1216         if use-column[ l-ind ] = yes
     1217         then do:
     1218           assign
     1219             buf_usr-flt.list_ = buf_usr-flt.list_ + ( if buf_usr-flt.list_ = "":U then "":U else chr(44) ) +
     1220                                 string( l-ind )
     1221           .
     1222         end.
     1223       end.
     1224       assign
     1225         buf_usr-flt.list_ = buf_usr-flt.list_ + ";yes;2"
     1226       .
     1227     end.
     1228     assign
     1229       Tog-Suppl = ( if num-entries( buf_usr-flt.list_, ";":U ) > 1
     1230                     then logical( entry( 2, buf_usr-flt.list_, ";":U ), "yes/no":U )
     1231                     else yes )
     1232       r-s-bill# = ( if num-entries( buf_usr-flt.list_, ";":U ) > 2
     1233                     then integer( entry( 3, buf_usr-flt.list_, ";":U ) )
     1234                     else 1   )
     1235     .
     1236     apply "VALUE-CHANGED":U to r-s-suppl in frame F-Main .
     1237     display
     1238       SuppName
     1239       Tog-Suppl
     1240       r-s-bill#
     1241     with frame F-Main .
     1242   end procedure.
     1243   procedure my-report :
     1244     define variable l-ind as integer no-undo .
     1245     do
     1246     on error undo, leave
     1247     on stop  undo, leave
     1248     :
     1249       if not available buf_usr-flt
     1250       then do:
     1251         find first buf_usr-flt no-lock where
     1252                    buf_usr-flt.user-name  = v-cntxt-userid and
     1253                    buf_usr-flt.call-point = c-flt no-error .
     1254         if not available buf_usr-flt
     1255         then do:
     1256           create buf_usr-flt .
     1257           assign
     1258             buf_usr-flt.user-name  = v-cntxt-userid
     1259             buf_usr-flt.call-point = c-flt
     1260           .
     1261           do l-ind = 1 to 18
     1262           :
     1263             if use-column[ l-ind ] = yes
     1264             then do:
     1265               assign
     1266                 buf_usr-flt.list_ = buf_usr-flt.list_ + ( if buf_usr-flt.list_ = "":U then "":U else chr(44) ) +
     1267                                     string( l-ind )
     1268               .
     1269             end.
     1270           end.
     1271           assign
     1272             buf_usr-flt.list_ = buf_usr-flt.list_ + ";yes;2"
     1273           .
     1274         end.
     1275       end.
     1276       find first buf_usr-flt exclusive-lock where
     1277                  buf_usr-flt.user-name  = v-cntxt-userid and
     1278                  buf_usr-flt.call-point = c-flt .
     1279       if num-entries( buf_usr-flt.list_, ";":U ) > 1
     1280       then do:
     1281         assign
     1282           entry( 2, buf_usr-flt.list_, ";":U ) = string( Tog-Suppl, "yes/no":U )
     1283         .
     1284       end.
     1285       else do:
     1286         assign
     1287           buf_usr-flt.list_ = buf_usr-flt.list_ + ";":U + "yes":U
     1288         .
     1289       end.
     1290       if num-entries( buf_usr-flt.list_, ";":U ) > 2
     1291       then do:
     1292         assign
     1293           entry( 3, buf_usr-flt.list_, ";":U ) = string( r-s-bill#, "9":U )
     1294         .
     1295       end.
     1296       else do:
     1297         assign
     1298           buf_usr-flt.list_ = buf_usr-flt.list_ + ";":U + "2":U
     1299         .
     1300       end.
     1301       find first obj-list no-lock .
     1302       run rep/r-gdsrsl.p
     1303         ( input my-handle
     1304         , input obj-list.obj-type
     1305         , input obj-list.obj-code
     1306         , input Tog-Suppl
     1307         , input r-s-bill#
     1308         , input ( r-s-suppl = 1 )
     1309         ) no-error .
     1310       if error-status :error
     1311       then do:
     1312         message vss-workfile skip( 0 ) vss-date skip( 0 ) vss-revision skip( 1 ) vss-description skip( 1 )
     1313                 "Ошибка выполнения отчета" skip( 0 )
     1314                 return-value skip( 0 )
     1315                 error-status :get-message( 1 ) skip( 1 )
     1316         view-as alert-box error .
     1317       end.
     1318     end.
     1319     if error-status :error
     1320     then do:
     1321       message vss-workfile skip( 0 ) vss-date skip( 0 ) vss-revision skip( 1 ) vss-description skip( 1 )
     1322               "Ошибка выполнения отчета" skip( 0 )
     1323               return-value skip( 0 )
     1324               error-status :get-message( 1 ) skip( 1 )
     1325       view-as alert-box error .
     1326     end.
     1327   end procedure.
     1328   procedure my-var :
     1329     assign frame F-Main SuppName
     1330                                Tog-Excel
     1331                                Tog-Suppl
     1332                                r-s-suppl
     1333                                r-s-bill#
     1334     .
     1335     assign
     1336       STR-obj-type = "":U
     1337       STR-obj-code = "":U
     1338       STR-obj-name = "":U
     1339       STR-obj      = "":U
     1340     .
     1341     for each obj-list no-lock
     1342     :
     1343       assign
     1344         STR-obj-type = STR-obj-type + obj-list.obj-type + ","
     1345         STR-obj-code = STR-obj-code + string( obj-list.obj-code ) + ","
     1346         STR-obj-name = STR-obj-name + obj-list.obj-name + ","
     1347         STR-obj      = STR-obj      + obj-list.obj-type + "#" + string( obj-list.obj-code ) + ","
     1348       .
     1349     end.
     1350     assign
     1351       ReportName   = "Товарный отчет (реестр документов) по поставщикам в продажных ценах"
     1352       ReportHeader = "":U
     1353     .
     1354   end procedure.
     1355   procedure state-changed :
     1356     define input parameter p-issuer-hdl as handle    no-undo .
     1357     define input parameter p-state      as character no-undo .
     1358     case p-state :
     1359       when "link-changed":U
     1360       then do:
     1361         run my-var in this-procedure .
     1362       end.
     1363     end case.
     1364   end procedure.
