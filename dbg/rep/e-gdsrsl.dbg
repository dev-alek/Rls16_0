      608   define new global shared variable g#library  as handle no-undo .
      609   define new global shared variable g#library2 as handle no-undo .
      610   define variable var-report-r-b as character no-undo .
      611   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      612   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      613     (output var-report-r-b
      614     )  .
      615   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      616     define variable v-cntxt-db-num        as integer   no-undo .
      617     define variable v-cntxt-userid        as character no-undo .
      618     define variable v-cntxt-level         as character no-undo .
      619     define variable v-cntxt-host-code-obj as integer   no-undo .
      620     define variable v-cntxt-obj-type      as character no-undo .
      621     define variable v-cntxt-obj-code      as integer   no-undo .
      622     define variable v-cntxt-db-num-obj    as integer   no-undo .
      623     define variable v-cntxt-is-admin      as logical   no-undo .
      624   define variable parparentproc as widget-handle no-undo .
      625   assign
      626     parparentproc = my-handle
      627   .
      628   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      629     run mainmenu_getcntxt in parparentproc
      630       (output v-cntxt-db-num
      631       ,output v-cntxt-userid
      632       ,output v-cntxt-level
      633       ,output v-cntxt-host-code-obj
      634       ,output v-cntxt-obj-type
      635       ,output v-cntxt-obj-code
      636       ,output v-cntxt-db-num-obj
      637       ,output v-cntxt-is-admin
      638       ) .
      639   define variable State-Source as widget-handle no-undo .
      640   define variable c-flt        as character     no-undo .
      641   define new shared temp-table g#supplier no-undo
      642     field supp-type like ub.clients.obj-type
      643     field supp-code like ub.clients.obj-code
      644     field supp-name like ub.clients.obj-name
      645     index pi       is   unique primary supp-type supp-code
      646   .
      647   define buffer buf_usr-flt for ubflt.usr-flt .
      648   define buffer bf_suppl    for ub.clients .
      649   define button Btn_Columns label "Выбор типов документов" size-chars 28.75 by 1.00 tooltip "Выбор типов документов" .
      650   define variable r-s-suppl as integer no-undo view-as radio-set vertical
      651     radio-buttons "все",       1,
      652                   "Выборочно", 2  size-chars 12.00 by 2.17 .
      653   define variable r-s-bill# as integer no-undo view-as radio-set vertical
      654     radio-buttons "Номер накладной поставщика", 1,
      655                   "Номер накладной системы",    2  size-chars 30.00 by 2.17 .
      656   define variable SuppName  as character no-undo view-as editor scrollbar-vertical size-chars 51.50 by 3.00
      657     tooltip "Список выбранных Поставщиков" initial 'все':U .
      658   define variable Tog-Suppl as logical   no-undo initial yes label "Раздельно по поставщикам"
      659     view-as toggle-box size-chars 38.25 by 1.00 .
      660   define variable Tog-Excel  as logical   no-undo initial  no label "Только в Excel"
      661     view-as toggle-box size-chars 19.00 by 1.00 fgcolor 4 .
      662   define frame F-Main
      663     "Поставщики" at row  1.50 col  2.75 fgcolor 4
      664     SuppName     at row  2.50 col 15.50 no-label
      665     r-s-suppl    at row  2.50 col  2.75 no-label
      666     Tog-Suppl    at row  5.75 col  2.75
      667     "Накладные"  at row  7.25 col  2.75 fgcolor 4
      668     r-s-bill#    at row  8.25 col  2.75 no-label
      669     Btn_Columns  at row 17.50 col  3.00
      670     Tog-Excel    at row 17.50 col 51.38
      671   with 1 down no-box keep-tab-order overlay side-labels no-underline three-d at col 1 row 1 scrollable .
      672   assign
      673     frame F-Main :scrollable = no
      674     frame F-Main :hidden     = yes
      675   .
      676   assign
      677     SuppName :read-only in frame F-Main = yes
      678   .
      679   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      680   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      681   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      682   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      683   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      684   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      685   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      686   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      687         adm-object-hdl = FRAME F-Main:HANDLE.
      688   RUN ensure-broker.
      689   THIS-PROCEDURE:ADM-DATA =
      690        'ADM1.1~`':U +
      691        'SmartObject~`':U +
      692        '~`':U +
      693        'NO ~`':U +
      694        '~`':U +
      695        '~`':U +
      696        '~`':U +
      697        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      698           + "~`":U +
      699        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
      700        'Record-Source,Record-Target,TableIO-Target~`':U +
      701        '~`':U +
      702        '~`~`~`~`~`~`~`~`~`~`~`':U +
      703        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      704            THEN "^^":U
      705        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      706             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      707   PROCEDURE adm-apply-entry :
      708     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      709   END PROCEDURE.
      710   PROCEDURE adm-destroy :
      711    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      712   END PROCEDURE.
      713   PROCEDURE adm-disable :
      714       DISABLE r-s-suppl SuppName Tog-Suppl r-s-bill# Btn_Columns WITH FRAME F-Main.
      715       RUN dispatch ('disable-fields':U).
      716       RUN set-attribute-list ('ENABLED=no':U).
      717       RETURN.
      718   END PROCEDURE.
      719   PROCEDURE adm-edit-attribute-list :
      720         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
      721         RETURN.
      722   END PROCEDURE.
      723   PROCEDURE adm-enable :
      724       ENABLE UNLESS-HIDDEN r-s-suppl SuppName Tog-Suppl r-s-bill# Btn_Columns WITH FRAME F-Main.
      725       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      726       RUN set-attribute-list ('ENABLED=yes':U).
      727       RETURN.
      728   END PROCEDURE.
      729   PROCEDURE adm-exit :
      730        RUN notify ('exit':U).
      731     RETURN.
      732   END PROCEDURE.
      733   PROCEDURE adm-hide :
      734     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      735   END PROCEDURE.
      736   PROCEDURE adm-initialize :
      737     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      738   END PROCEDURE.
      739   PROCEDURE adm-show-errors :
      740       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      741       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      742           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      743       END.
      744       RETURN.
      745   END PROCEDURE.
      746   PROCEDURE adm-UIB-mode :
      747     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      748   END PROCEDURE.
      749   PROCEDURE adm-view :
      750     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      751   END PROCEDURE.
      752   PROCEDURE dispatch :
      753       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      754       RUN broker-dispatch IN adm-broker-hdl
      755           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      756       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      757   END PROCEDURE.
      758   PROCEDURE ensure-broker :
      759   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      760   IF RETURN-VALUE NE "ADM-Broker":U THEN
      761   DO:
      762       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      763       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      764   END.
      765   END PROCEDURE.
      766   PROCEDURE get-attribute :
      767     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      768     RUN broker-get-attribute IN adm-broker-hdl
      769         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      770     RETURN RETURN-VALUE.
      771   END PROCEDURE.
      772   PROCEDURE get-attribute-list :
      773     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      774     RUN broker-get-attribute-list IN adm-broker-hdl
      775         (INPUT THIS-PROCEDURE,
      776          INPUT ?,
      777          OUTPUT p-attr-list) NO-ERROR.
      778     RETURN.
      779   END PROCEDURE.
      780   PROCEDURE new-state :
      781     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      782     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      783     RETURN.
      784   END PROCEDURE.
      785   PROCEDURE notify :
      786     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      787     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      788     IF RETURN-VALUE = "ADM-ERROR":U THEN
      789         RETURN "ADM-ERROR":U.
      790     RETURN.
      791   END PROCEDURE.
      792   PROCEDURE set-attribute-list :
      793     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      794     RUN ensure-broker.
      795     RUN broker-set-attribute-list IN adm-broker-hdl
      796         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      797     RETURN.
      798   END PROCEDURE.
      799   PROCEDURE set-position :
      800       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      801       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      802       IF VALID-HANDLE(adm-object-hdl) THEN
      803       DO:
      804         ASSIGN adm-object-hdl:ROW    =   p-row
      805                adm-object-hdl:COLUMN =   p-col.
      806       END.
      807       RETURN.
      808   END PROCEDURE.
      809   PROCEDURE adm-display-fields :
      810       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
      811       RETURN.
      812   END PROCEDURE.
      813   PROCEDURE adm-open-query :
      814     RETURN.
      815   END PROCEDURE.
      816   PROCEDURE adm-row-changed :
      817         IF VALID-HANDLE(adm-object-hdl) THEN
      818           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      819         RUN notify ('row-available':U).
      820         RETURN.
      821   END PROCEDURE.
      822   PROCEDURE reposition-query :
      823       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
      824       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
      825       RETURN.
      826   END PROCEDURE.
      827     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
      828     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
      829     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
      830     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
      831     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
      832     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
      833     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
      834     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
      835     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      836     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
      837     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      838     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
      839     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
      840     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
      841     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
      842     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
      843     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
      844     IF "":U = "":U THEN
      845       RUN modify-list-attribute IN adm-broker-hdl
      846         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
      847     RUN use-create-on-add(?).
      848   PROCEDURE adm-add-record :
      849       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      850          "must have at least one Enabled Table to perform Add.":U
      851          VIEW-AS ALERT-BOX ERROR.
      852       RETURN.
      853   END PROCEDURE.
      854   PROCEDURE adm-assign-record :
