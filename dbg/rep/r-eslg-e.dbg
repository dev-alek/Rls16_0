     1016   procedure grplib-get-full-name :
     1017      define input parameter p-node-code  as integer      no-undo.
     1018      define output parameter p-full-name as character    no-undo.
     1019      do
     1020   on error undo, return error
     1021   :
     1022       define variable v-upper-code    as integer           no-undo.
     1023       define buffer buf_gds-grp       for ub.gds-grp.
     1024       define buffer buf_upper_gds-grp for ub.gds-grp.
     1025       find first buf_gds-grp no-lock
     1026            where buf_gds-grp.node-code = p-node-code
     1027       no-error.
     1028       if not available buf_gds-grp
     1029       then do:
     1030           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     1031       end.
     1032       assign
     1033           p-full-name  = ""
     1034           v-upper-code = 1
     1035       .
     1036       do while buf_gds-grp.upper-code <> 0
     1037       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     1038       :
     1039           assign
     1040               p-full-name  = buf_gds-grp.node-name
     1041                            + (if p-full-name <> "" then chr(47) else "")
     1042                            + p-full-name
     1043               v-upper-code = buf_gds-grp.upper-code
     1044           .
     1045           find first buf_gds-grp no-lock
     1046                where buf_gds-grp.node-code = v-upper-code
     1047           no-error.
     1048           if not available buf_gds-grp
     1049           then do:
     1050               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
     1051                                   + string( v-upper-code )
     1052                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     1053           end.
     1054       end.
     1055       assign
     1056       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     1057       .
     1058   end.
     1059   end .
     1060   procedure grplib-get-node-from-full-name :
     1061   define input parameter p-full-name as character no-undo .
     1062   define output parameter p-node-code as integer no-undo .
     1063   define variable v-ii as integer no-undo .
     1064   define variable v-upper-code as integer no-undo .
     1065   define variable v-root-code as integer no-undo .
     1066   define variable v-entry as character no-undo .
     1067   define buffer buf_gds-grp       for ub.gds-grp.
     1068   do
     1069   on error undo, return error
     1070   :
     1071     find first buf_gds-grp no-lock
     1072         where buf_gds-grp.upper-code = 0
     1073     no-error .
     1074     if not available buf_gds-grp
     1075     then do:
     1076         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
     1077     end.
     1078     else do:
     1079       assign
     1080       v-root-code = buf_gds-grp.node-code
     1081       .
     1082     end.
     1083     v-upper-code = v-root-code.
     1084     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     1085       assign
     1086       v-entry = entry(v-ii, p-full-name, chr(47)).
     1087       if v-entry = '' then leave.
     1088       find first buf_gds-grp no-lock where
     1089                 buf_gds-grp.node-name = v-entry
     1090             and buf_gds-grp.upper-code = v-upper-code
     1091             no-error.
     1092       if not available buf_gds-grp then do:
     1093         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     1094       end.
     1095       else do:
     1096         p-node-code = buf_gds-grp.node-code.
     1097         v-upper-code = buf_gds-grp.node-code.
     1098       end.
     1099     end.
     1100   end.
     1101   end .
