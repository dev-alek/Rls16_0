     1883   define stream sout.
     1884   define stream macr_excel .
     1885   define temp-table tt-goods no-undo like ub.goods
     1886     field obj-type  as character
     1887     field obj-code  as integer
     1888   index pi is primary unique
     1889     obj-type
     1890     obj-code
     1891     gds-code
     1892   index obj
     1893     obj-type
     1894     obj-code
     1895   index art
     1896     artic
     1897     prod-type
     1898     prod-code
     1899   .
     1900   define temp-table tt-report no-undo
     1901     field   obj-type          as character
     1902     field   obj-code          as integer
     1903     field   artic             as character
     1904     field   prod-type         as character
     1905     field   prod-code         as integer
     1906     field   prod-name          as character
     1907     field   gds-name          as character
     1908     field   grp-name          as character
     1909     field   grp-code          as integer
     1910     field   last-income-date  as date
     1911     field   days-absence      as character
     1912   index pi is primary unique
     1913     obj-type
     1914     obj-code
     1915     artic
     1916     prod-type
     1917     prod-code
     1918   index art
     1919     artic
     1920     prod-type
     1921     prod-code
     1922   index grp
     1923     grp-name
     1924     .
     1925   define buffer buf_tt-report for tt-report.
     1926   define variable v-line      as character no-undo .
     1927   define variable v-tot-goods as integer   no-undo .
     1928   define variable v-ind       as integer   no-undo .
     1929   define variable v-row       as integer   no-undo .
     1930   define variable v-col       as integer   no-undo .
     1931   define frame f-doc
     1932       sym1  buf_tt-report.artic             column-label " Артикул!       "            format "X(12)"                space(0)
     1933       sym2  buf_tt-report.prod-name         column-label " Произ-!водитель"            format "X(8)"                 space(0)
     1934       sym3  buf_tt-report.gds-name          column-label " Наименование товара! "      format "X(50)"                space(0)
     1935       sym6  buf_tt-report.days-absence      column-label "Дни без!товара"              format "X(8)"                 space(0)
     1936       sym7  buf_tt-report.last-income-date  column-label "Послед.!постав"              format "99/99/99"             space(0)
     1937       sym8
     1938   header
     1939       string( "Дата печати : " + string(today , "99.99.9999") + " , " + string(time, "HH:MM") ) at 5 format "X(60)"
     1940       string( "Страница " + string( page-number( sout )  , ">>9") ) at 70 format "X(15)" skip
     1941       v-line format "X(97)" AT 1
     1942   with width 160 down stream-io.
     1943   do
     1944   on error undo, return error return-value
     1945   :
     1946     if p-days-absence < 0
     1947     then do:
     1948       message
     1949         "Количество дней отсутствия товара не может быть отрицательным!"
     1950       view-as alert-box error.
     1951       return.
     1952     end.
     1953     if p-critical-balance < 0
     1954     then do:
     1955       message
     1956         "Критический остаток товара не может быть отрицательным!"
     1957       view-as alert-box error.
     1958       return.
     1959     end.
     1960     if  p-absence-period = yes and
     1961         p-absence-period-from > p-absence-period-to
     1962     then do:
     1963       message
     1964         "Период отсутствия продаж задан некорректно!"
     1965       view-as alert-box error.
     1966       return.
     1967     end.
     1968     run proc-empty-tt in this-procedure .
     1969     run fill-tt-gds in this-procedure no-error .
     1970     if error-status :error = yes
     1971     then do:
     1972       return .
     1973     end.
     1974     run fill-report in this-procedure no-error .
     1975     if error-status :error = yes
     1976     then do:
     1977       return .
     1978     end.
     1979     run print-report  in this-procedure no-error .
     1980     if error-status :error = yes
     1981     then do:
     1982       return .
     1983     end.
     1984     run proc-empty-tt in this-procedure .
     1985     define variable v-user-action as character no-undo .
     1986     define variable v-printed as logical   no-undo .
     1987     run gbl/prnfilen.w ( input ""
     1988                        , input 0
     1989                        , input string(session :temp-directory) + "rpt" + string( g#report-num )
     1990                        , input 7
     1991                        , output v-user-action
     1992                        , output v-printed
     1993                        ) .
     1994   end.
     1995   procedure proc-empty-tt :
     1996   do
     1997   on error undo, return error return-value
     1998   :
     1999     empty temp-table tt-goods.
     2000     empty temp-table tt-report.
     2001   end.
     2002   end procedure.
     2003   procedure fill-tt-gds :
     2004     define buffer buf_goods                   for ub.goods.
     2005     define buffer buf_assortment-matrix       for ub.assortment-matrix.
     2006     define buffer buf_assortment-matrix-goods for ub.assortment-matrix-goods.
     2007     define buffer buf_tt-goods    for tt-goods.
     2008     define variable v-curr-grp-name               as character no-undo .
     2009     define variable v-return-AssMin               as logical   no-undo .
     2010     define variable v-return-igt                  as character no-undo .
     2011     define variable v-gdop-min-stock              as decimal   no-undo .
     2012     define variable v-grop-max-stock              as decimal   no-undo .
     2013     define variable v-grop-level-always-presence  as decimal   no-undo .
     2014     define variable v-grop-min-order              as decimal   no-undo .
     2015     define variable v-obj-type                    as character no-undo .
     2016     define variable v-obj-code                    as integer   no-undo .
     2017   do
     2018   on error undo, return error return-value
     2019   :
     2020     empty temp-table buf_tt-goods.
     2021     assign
     2022       v-tot-goods = 0
     2023     .
     2024     for each obj-list
     2025     :
     2026       run waitfram-show in this-procedure ( input substitute( "Построение списка товаров по объекту &1 &2"
     2027                                                             , obj-list.obj-type
     2028                                                             , obj-list.obj-code
     2029                                                             )
     2030                                           ) .
     2031       find first buf_assortment-matrix no-lock
     2032         where buf_assortment-matrix.obj-type    = obj-list.obj-type
     2033           and buf_assortment-matrix.obj-code    = obj-list.obj-code
     2034           and buf_assortment-matrix.asmt-status = integer ('0':U)
     2035       no-error .
     2036       if available buf_assortment-matrix
     2037       then do:
     2038         for each buf_assortment-matrix-goods no-lock
     2039           where buf_assortment-matrix-goods.asmt-id     = buf_assortment-matrix.asmt-id
     2040             and buf_assortment-matrix-goods.db-num      = buf_assortment-matrix.db-num
     2041             and buf_assortment-matrix-goods.asmg-status = integer ('0':U)
     2042         :
     2043           find first buf_goods no-lock
     2044             where buf_goods.gds-code = buf_assortment-matrix-goods.gds-code
     2045           no-error .
     2046           if available buf_goods
     2047           then do:
     2048             find first buf_tt-goods
     2049               where buf_tt-goods.obj-type = obj-list.obj-type
     2050                 and buf_tt-goods.obj-code = obj-list.obj-code
     2051                 and buf_tt-goods.gds-code = buf_goods.gds-code
     2052             no-error .
     2053             if not available buf_tt-goods
     2054             then do:
     2055               create buf_tt-goods.
     2056               buffer-copy buf_goods to buf_tt-goods
     2057               assign
     2058                 buf_tt-goods.obj-type = obj-list.obj-type
     2059                 buf_tt-goods.obj-code = obj-list.obj-code
     2060                 v-tot-goods           = v-tot-goods + 1
     2061               .
     2062             end.
     2063           end.
     2064         end.
     2065       end.
     2066       else do:
     2067         message
     2068           substitute( "Для объекта &1 &2 не найдена ассортиментная матрица!&3Невозможно составить отчет."
     2069                     , obj-list.obj-type
     2070                     , obj-list.obj-code
     2071                     , chr(10)
     2072                     )
     2073         view-as alert-box error.
     2074         return error .
     2075       end.
     2076     end.
     2077     run waitfram-hide in this-procedure .
     2078     for each buf_tt-goods
     2079     :
     2080   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2081   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjpr in g#library
     2082     (input  buf_tt-goods.obj-type
     2083     ,input  buf_tt-goods.obj-code
     2084     ,input  ?
     2085     ,input  ?
     2086     ,input  ?
     2087     ,input  buf_tt-goods.gds-code
     2088     ,output v-return-AssMin
     2089     ,output v-return-igt
     2090     ,output v-gdop-min-stock
     2091     ,output v-grop-max-stock
     2092     ,output v-grop-level-always-presence
     2093     ,output v-grop-min-order
     2094     )  .
     2095       if  v-return-igt = 'Нештатный':U or
     2096           v-return-igt = 'На вывод из ассортимента':U
     2097       then do:
     2098         delete buf_tt-goods.
     2099       end.
     2100     end.
     2101     run waitfram-hide in this-procedure .
     2102   end.
     2103   end procedure.
     2104   procedure fill-report :
     2105     define buffer buf_gds-obj   for ub.gds-obj.
     2106     define buffer buf_stk-line  for ub.stk-line.
     2107     define buffer buf_ot-line   for ub.ot-line.
     2108     define buffer buf_doc-line  for ub.doc-line.
     2109     define buffer buf_trn-doc   for ub.trn-doc.
     2110     define buffer buf_tt-goods  for tt-goods.
     2111     define buffer buf_tt-report for tt-report.
     2112     define variable v-fact-order        as decimal   no-undo .
     2113     define variable v-i                 as integer   no-undo .
     2114     define variable v-ext-doc-type      as character no-undo .
     2115     define variable v-last-income-date  as date      no-undo .
     2116     define variable v-fo                as decimal   no-undo .
     2117     define variable v-stat              as logical   no-undo .
     2118     define variable v-days-absence-str  as character no-undo .
     2119     define variable v-days-absence      as integer   no-undo .
     2120     define variable v-absence-fo-from   as decimal   no-undo .
     2121     define variable v-absence-fo-to     as decimal   no-undo .
     2122   do
     2123   on error undo, return error return-value
     2124   :
     2125     run day-begin-fact-order in this-procedure ( input x-date-alone
     2126                                                , output v-fact-order
     2127                                                ).
     2128     if p-absence-period = yes
     2129     then do:
     2130       run day-begin-fact-order in this-procedure ( input p-absence-period-from
     2131                                                  , output v-absence-fo-from
     2132                                                  ).
     2133       run factord-end-day in this-procedure ( input p-absence-period-from
     2134                                             , output v-absence-fo-to
     2135                                             ).
     2136     end.
     2137     run prg-bar_init-cb-handle in this-procedure (v-d-report-handle) .
     2138     run prg-bar_new in this-procedure (1 , v-tot-goods).
     2139     run prg-bar_title in this-procedure ( input "Обработка товаров...":U ).
     2140     run prg-bar_show in this-procedure .
     2141     assign
     2142       v-tot-goods = 0
     2143     .
     2144     _goods-cycle:
     2145     for each buf_tt-goods
     2146     :
     2147       run prg-bar_increment in this-procedure .
     2148       find first buf_gds-obj no-lock
     2149         where buf_gds-obj.obj-type  = buf_tt-goods.obj-type
     2150           and buf_gds-obj.obj-code  = buf_tt-goods.obj-code
     2151           and buf_gds-obj.artic     = buf_tt-goods.artic
     2152           and buf_gds-obj.prod-type = buf_tt-goods.prod-type
     2153           and buf_gds-obj.prod-code = buf_tt-goods.prod-code
     2154       no-error .
     2155       if not available buf_gds-obj
     2156       then do:
     2157         next _goods-cycle.
     2158       end.
     2159       if buf_gds-obj.last-doc = ?
     2160       then do:
     2161         next _goods-cycle.
     2162       end.
     2163       assign
     2164         v-tot-goods = v-tot-goods + 1
     2165       .
     2166       find last buf_stk-line no-lock
     2167         where buf_stk-line.obj-type    = buf_tt-goods.obj-type
     2168           and buf_stk-line.obj-code    = buf_tt-goods.obj-code
     2169           and buf_stk-line.artic       = buf_tt-goods.artic
     2170           and buf_stk-line.prod-type   = buf_tt-goods.prod-type
     2171           and buf_stk-line.prod-code   = buf_tt-goods.prod-code
     2172           and buf_stk-line.sum-type    = 'crsa':U
     2173           and buf_stk-line.cat-id      = '##,##':U
     2174           and buf_stk-line.fact-order <= v-fact-order
     2175       use-index category no-error .
     2176       if available buf_stk-line and buf_stk-line.fact-qnty <= p-critical-balance
     2177       then do:
     2178         assign
     2179           v-stat             = no
     2180           v-fo               = v-fact-order
     2181           v-days-absence-str = ""
     2182         .
     2183         do while v-stat = no
     2184         :
     2185           find last buf_stk-line no-lock
     2186             where buf_stk-line.obj-type   = buf_tt-goods.obj-type
     2187               and buf_stk-line.obj-code   = buf_tt-goods.obj-code
     2188               and buf_stk-line.artic      = buf_tt-goods.artic
     2189               and buf_stk-line.prod-type  = buf_tt-goods.prod-type
     2190               and buf_stk-line.prod-code  = buf_tt-goods.prod-code
     2191               and buf_stk-line.sum-type   = 'crsa':U
     2192               and buf_stk-line.cat-id     = '##,##':U
     2193               and buf_stk-line.fact-order < v-fo
     2194           use-index category no-error .
     2195           if not available buf_stk-line
     2196           then do:
     2197             assign
     2198               v-stat = yes
     2199             .
     2200           end.
     2201           else do:
     2202             assign
     2203               v-fo = buf_stk-line.fact-order
     2204             .
     2205             if buf_stk-line.fact-qnty > p-critical-balance
     2206             then do:
     2207               assign
     2208                 v-days-absence-str  = string(x-date-alone - buf_stk-line.fact-date)
     2209                 v-stat              = yes
     2210               .
     2211             end.
     2212           end.
     2213         end.
     2214         if v-days-absence-str <> ""
     2215         then do:
     2216           assign
     2217             v-days-absence = integer(v-days-absence-str)
     2218           no-error .
     2219           if v-days-absence < p-days-absence
     2220           then do:
     2221             next _goods-cycle.
     2222           end.
     2223         end.
     2224         if p-absence-period = yes
     2225         then do:
     2226           find last buf_ot-line no-lock
     2227             where buf_ot-line.obj-type     = buf_tt-goods.obj-type
     2228               and buf_ot-line.obj-code     = buf_tt-goods.obj-code
     2229               and buf_ot-line.artic        = buf_tt-goods.artic
     2230               and buf_ot-line.prod-type    = buf_tt-goods.prod-type
     2231               and buf_ot-line.prod-code    = buf_tt-goods.prod-code
     2232               and buf_ot-line.fact-order  >= v-absence-fo-from
     2233               and buf_ot-line.fact-order  <= v-absence-fo-to
     2234               and buf_ot-line.sum-type     = 'crsa':U
     2235               and buf_ot-line.cat-id       = '##,##':U
     2236               and buf_ot-line.ext-doc-type = 'es':U
     2237           no-error .
     2238           if available buf_ot-line
     2239           then do:
     2240             next _goods-cycle.
     2241           end.
     2242         end.
     2243         assign
     2244           v-fo                = 0
     2245           v-last-income-date  = ?
     2246         .
     2247         do v-i = 1 to 6
     2248         :
     2249           case v-i
     2250           :
     2251             when 1
     2252             then do:
     2253               assign
     2254                 v-ext-doc-type = 'ie':U
     2255               .
     2256             end.
     2257             when 2
     2258             then do:
     2259               assign
     2260                 v-ext-doc-type = 'iv':U
     2261               .
     2262             end.
     2263             when 3
     2264             then do:
     2265               assign
     2266                 v-ext-doc-type = 're':U
     2267               .
     2268             end.
     2269             when 4
     2270             then do:
     2271               assign
     2272                 v-ext-doc-type = 'rs':U
     2273               .
     2274             end.
     2275             when 5
     2276             then do:
     2277               assign
     2278                 v-ext-doc-type = 'im':U
     2279               .
     2280             end.
     2281             when 6
     2282             then do:
     2283               assign
     2284                 v-ext-doc-type = 'rv':U
     2285               .
     2286             end.
     2287           end.
     2288           find last buf_doc-line no-lock
     2289             where buf_doc-line.obj-type     = buf_tt-goods.obj-type
     2290               and buf_doc-line.obj-code     = buf_tt-goods.obj-code
     2291               and buf_doc-line.artic        = buf_tt-goods.artic
     2292               and buf_doc-line.prod-type    = buf_tt-goods.prod-type
     2293               and buf_doc-line.prod-code    = buf_tt-goods.prod-code
     2294               and buf_doc-line.ext-doc-type = v-ext-doc-type
     2295               and buf_doc-line.status_      = 'факт':U
     2296               and buf_doc-line.fact-order  <= v-fact-order
     2297           no-error .
     2298           if available buf_doc-line
     2299           then do:
     2300             if buf_doc-line.fact-order > v-fo
     2301             then do:
     2302               assign
     2303                 v-fo = buf_doc-line.fact-order
     2304               .
     2305               find first buf_trn-doc no-lock
     2306                 where buf_trn-doc.doc-code = buf_doc-line.doc-code
     2307               no-error .
     2308               if not available buf_trn-doc
     2309               then do:
     2310                 run factord-to-date in this-procedure ( input v-fo
     2311                                                       , output v-last-income-date
     2312                                                       ) .
     2313               end.
     2314               else do:
     2315                 assign
     2316                   v-last-income-date = buf_trn-doc.fact-date
     2317                 .
     2318               end.
     2319             end.
     2320           end.
     2321         end.
     2322         find first buf_tt-report
     2323           where buf_tt-report.obj-type  = buf_tt-goods.obj-type
     2324             and buf_tt-report.obj-code  = buf_tt-goods.obj-code
     2325             and buf_tt-report.artic     = buf_tt-goods.artic
     2326             and buf_tt-report.prod-type = buf_tt-goods.prod-type
     2327             and buf_tt-report.prod-code = buf_tt-goods.prod-code
     2328         no-error .
     2329         if not available buf_tt-report
     2330         then do:
     2331           create buf_tt-report.
     2332           assign
     2333             buf_tt-report.obj-type  = buf_tt-goods.obj-type
     2334             buf_tt-report.obj-code  = buf_tt-goods.obj-code
     2335             buf_tt-report.artic     = buf_tt-goods.artic
     2336             buf_tt-report.prod-type = buf_tt-goods.prod-type
     2337             buf_tt-report.prod-code = buf_tt-goods.prod-code
     2338             buf_tt-report.prod-name = substitute("&1 &2" , buf_tt-goods.prod-type , buf_tt-goods.prod-code )
     2339             buf_tt-report.grp-name  = trim(buf_tt-goods.grp-name)
     2340             buf_tt-report.grp-code  = buf_tt-goods.grp-code
     2341           .
     2342           if g#gds-engl
     2343           then do:
     2344             assign
     2345               buf_tt-report.gds-name = buf_tt-goods.engl-name
     2346             .
     2347           end.
     2348           else do:
     2349             assign
     2350               buf_tt-report.gds-name = buf_tt-goods.gds-name
     2351             .
     2352           end.
     2353         end.
     2354         assign
     2355           buf_tt-report.last-income-date  = v-last-income-date
     2356           buf_tt-report.days-absence      = if v-days-absence-str = "" or v-days-absence-str = ? then "#" else v-days-absence-str
     2357         .
     2358       end.
     2359     end.
     2360     run prg-bar_delete in this-procedure .
     2361     if p-NullStr = no
     2362     then do:
     2363       for each buf_tt-report
     2364       :
     2365         if buf_tt-report.day = "#" and buf_tt-report.last-income-date = ?
     2366         then do:
     2367           delete buf_tt-report .
     2368         end.
     2369       end.
     2370     end.
     2371   end.
     2372   end procedure.
     2373   procedure print-report :
     2374     define variable v-obj-str     as character no-undo .
     2375     define variable v-goods-count as integer   no-undo .
     2376     define variable v-file-name   as character no-undo .
     2377   do
     2378   on error undo, return error return-value
     2379   :
     2380     assign
     2381       make-excel  = yes
     2382       v-line      = fill("-", 250)
     2383       v-file-name = string(session :temp-directory) + "rpt" + string( g#report-num ) + ".txt"
     2384     .
     2385     output stream macr_excel to value(v-file-name) .
     2386   output stream sout to value( string( session:temp-directory +
     2387                                        "rpt" + string( g#report-num ) ) )
     2388                                        page-size  value(62) .
     2389     form header
     2390         v-line format "X(97)" at 1 skip   "Продолжение - на следующей странице" at 30 skip
     2391         with frame BottomFrame width 160 page-bottom no-labels no-box .
     2392     view stream sout frame BottomFrame .
     2393     form with frame f-doc .
     2394     put stream sout space(30) "Расширеный оперативный отчет по закончившимся наименованиям на " x-date-alone format "99/99/9999" "г."  skip .
     2395     assign
     2396       v-obj-str = "Выбор объекта: "
     2397     .
     2398     for each obj-list
     2399     :
     2400       assign
     2401         v-obj-str = v-obj-str + substitute("&1 (&2#&3 ), "
     2402                                           , obj-list.obj-name
     2403                                           , obj-list.obj-type
     2404                                           , obj-list.obj-code
     2405                                           )
     2406       .
     2407     end.
     2408     put stream sout v-obj-str format "X(160)" skip .
     2409     if p-NullStr = yes
     2410     then do:
     2411       put stream sout "Показывать непроходившие товары" skip.
     2412     end.
     2413     else do:
     2414       put stream sout "Не показывать непроходившие товары" skip.
     2415     end.
     2416     put stream sout "Количество дней отсутствия товара: " p-days-absence format ">>9" skip.
     2417     put stream sout "Критический остаток товара: " p-critical-balance format ">>>>>>9" skip.
     2418     if p-absence-period = yes
     2419     then do:
     2420       put stream sout "Отсутствуют продажи за период с " p-absence-period-from format "99/99/9999" " по " p-absence-period-to "99/99/9999" skip.
     2421     end.
     2422     put stream sout skip.
     2423     run print-titul-excel in this-procedure .
     2424     for each buf_tt-report
     2425     break by buf_tt-report.grp-name
     2426     :
     2427       assign
     2428         v-goods-count = v-goods-count + 1
     2429       .
     2430       if v-row  >= 63000
     2431       then do:
     2432         output stream macr_excel close .
     2433         run paramls-write in this-procedure ( input "file" , input string(v-ind) , input v-file-name ) .
     2434         run gbl/_tmpfile.p ( "wb", ".txt", output v-file-name ) .
     2435         output stream macr_excel to value(v-file-name) .
     2436         run print-titul-excel in this-procedure .
     2437       end.
     2438       if first-of(buf_tt-report.grp-name)
     2439       then do:
     2440         display stream sout
     2441           sym1
     2442           string("Группа " + buf_tt-report.grp-name) @ buf_tt-report.gds-name
     2443           sym2
     2444           sym8
     2445         with frame f-doc.
     2446         down stream sout with frame f-doc .
     2447         run macr_excel_char in this-procedure ( "Группа " + buf_tt-report.grp-name , v-row, 3) .
     2448         assign
     2449           v-row = v-row + 1
     2450         .
     2451       end.
     2452       display stream sout
     2453         sym1  buf_tt-report.artic
     2454         sym2  buf_tt-report.prod-name
     2455         sym3  buf_tt-report.gds-name
     2456         sym6  buf_tt-report.days-absence
     2457         sym7  buf_tt-report.last-income-date
     2458         sym8
     2459       with frame f-doc.
     2460       down stream sout with frame f-doc .
     2461       assign v-col = 1 .
     2462       run macr_excel_char in this-procedure ( buf_tt-report.artic        , v-row, v-col) . assign v-col = v-col + 1 .
     2463       run macr_excel_char in this-procedure ( buf_tt-report.prod-name    , v-row, v-col) . assign v-col = v-col + 1 .
     2464       run macr_excel_char in this-procedure ( buf_tt-report.gds-name     , v-row, v-col) . assign v-col = v-col + 1 .
     2465       run macr_excel_char in this-procedure ( buf_tt-report.days-absence , v-row, v-col) . assign v-col = v-col + 1 .
     2466       if buf_tt-report.last-income-date <> ?
     2467       then do:
     2468         run macr_excel_char( string(buf_tt-report.last-income-date,"99.99.9999") , v-row, v-col) . assign v-col = v-col + 1 .
     2469       end.
     2470       assign v-row = v-row + 1 .
     2471     end.
     2472     put stream sout v-line format "X(97)" skip.
     2473     put stream sout
     2474       "Итого количество наименований: " format "X(32)"  string(v-goods-count,">>>>>>>9")  " штук."  skip
     2475       "Итого процент отсутствия: " format "X(27)"  string( v-goods-count * 100 / v-tot-goods ,">>9") format "X(2)"  " %"  skip
     2476     .
     2477     assign v-row = v-row + 1 .
     2478     if v-row + 3 >= 63000
     2479     then do:
     2480       output stream macr_excel close .
     2481       run paramls-write in this-procedure ( input "file" , input string(v-ind) , input v-file-name ) .
     2482       run gbl/_tmpfile.p ( "wb", ".txt", output v-file-name ) .
     2483       output stream macr_excel to value(v-file-name) .
     2484       run print-titul-excel in this-procedure .
     2485     end.
     2486     assign
     2487       v-col = 1
     2488     .
     2489     run macr_excel_char( "Итого количество наименований: " + string(v-goods-count,">>>>>>>9") + " штук."   ,  v-row, v-col) .
     2490     assign v-row = v-row + 1 .
     2491     run macr_excel_char( "Итого процент отсутствия: " + string( v-goods-count * 100 / v-tot-goods ,">>9") + " %" ,  v-row, v-col) .
     2492     hide stream sout frame BottomFrame .
     2493     output stream sout close.
     2494     output stream macr_excel close .
     2495     run paramls-write in this-procedure (input "file",input string(v-ind),input v-file-name) .
     2496     run end-proc .
     2497   end.
     2498   end procedure.
     2499   procedure print-titul-excel :
     2500     define variable v-str as character no-undo .
     2501   do
     2502   on error undo, return error return-value
     2503   :
     2504     assign
     2505       v-ind = v-ind + 1
     2506       v-row = 2
     2507       v-col = 1
     2508     .
     2509     run macr_excel_char ("Расширеный оперативный отчет по закончившимся наименованиям на "+ string(x-date-alone,"99/99/9999") + "г.", 1, 3) .
     2510     run macr_cell_format( 11, yes, no, ?, 1, 3, 1, 3) .
     2511     for each obj-list no-lock:
     2512       run macr_excel_char ( string("Выбор объекта: " + obj-list.obj-name + " (" + obj-list.obj-type + '#' + string(obj-list.obj-code)  + "), ") , v-row, v-col) .
     2513       assign v-col = v-col + 1 .
     2514     end.
     2515     assign
     2516       v-col = 1
     2517       v-row = v-row + 1
     2518     .
     2519     if p-NullStr = yes
     2520     then do:
     2521       assign
     2522         v-str = "Показывать непроходившие товары"
     2523       .
     2524     end.
     2525     else do:
     2526       assign
     2527         v-str = "Не показывать непроходившие товары"
     2528       .
     2529     end.
     2530     run macr_excel_char ( v-str , v-row, v-col) .
     2531     assign
     2532       v-col = 1
     2533       v-row = v-row + 1
     2534     .
     2535     run macr_excel_char ( substitute("Количество дней отсутствия товара: &1" , p-days-absence) , v-row, v-col) .
     2536     assign
     2537       v-col = 1
     2538       v-row = v-row + 1
     2539     .
     2540     run macr_excel_char ( substitute("Критический остаток товара: &1" , p-critical-balance) , v-row, v-col) .
     2541     assign
     2542       v-col = 1
     2543       v-row = v-row + 1
     2544     .
     2545     if p-absence-period = yes
     2546     then do:
     2547       assign
     2548         v-str = substitute("Отсутствуют продажи за период с &1 по &2"
     2549                           , p-absence-period-from
     2550                           , p-absence-period-to
     2551                           )
     2552       .
     2553       run macr_excel_char ( substitute("Критический остаток товара: &1" , p-critical-balance) , v-row, v-col) .
     2554       assign
     2555         v-col = 1
     2556         v-row = v-row + 1
     2557       .
     2558     end.
     2559     assign
     2560       v-row = v-row + 1
     2561     .
     2562     run macr_excel_char("Артикул", v-row, v-col) .
     2563     run macr_cell_size (12,?, v-row, v-col,?,?).       assign v-col = v-col + 1 .
     2564     run macr_excel_char("Производитель", v-row, v-col) .
     2565     run macr_cell_size (15,?, v-row, v-col,?,?).       assign v-col = v-col + 1 .
     2566     run macr_excel_char("Наименование товара", v-row, v-col) .
     2567     run macr_cell_size (40,?, v-row, v-col,?,?).      assign v-col = v-col + 1 .
     2568     run macr_excel_char("Дни без товара.", v-row, v-col) .
     2569     run macr_cell_size (14,?, v-row, v-col,?,?).      assign v-col = v-col + 1 .
     2570     run macr_excel_char("Послед. поставка", v-row, v-col) .
     2571     run macr_cell_size (14,?, v-row, v-col,?,?).      assign v-col = v-col + 1 .
     2572     run macr_cell_bordur ( v-row , 1, v-row, 5) .
     2573     run macr_cell_format ( 10, yes, no, 35, v-row , 1, v-row, 5) .
     2574     assign
     2575       v-row = v-row + 1
     2576       v-col = 1
     2577     .
     2578   end.
     2579   end procedure.
