      992   define variable v-twowin15-itm-key    as integer      no-undo.
      993   procedure twowin_clear :
      994       define buffer buf_temp_twowin_items        for temp_twowin_items.
      995   do
      996   for buf_temp_twowin_items
      997   on error undo, return error
      998   :
      999       empty temp-table buf_temp_twowin_items.
     1000   end.
     1001   end procedure.
     1002   procedure twowin_add-item :
     1003   define input parameter p-ext-key   as character        no-undo.
     1004   define input parameter p-item-name as character        no-undo.
     1005   define input parameter p-item-desc as character        no-undo.
     1006   define input parameter p-selected  as logical          no-undo.
     1007       define buffer buf_temp_twowin_items        for temp_twowin_items.
     1008   do
     1009   for buf_temp_twowin_items
     1010   on error undo, return error
     1011   :
     1012       assign
     1013           v-twowin15-itm-key = v-twowin15-itm-key + 1
     1014       .
     1015       create temp_twowin_items.
     1016       assign
     1017           temp_twowin_items.itm-key      = v-twowin15-itm-key
     1018           temp_twowin_items.itmExtKey    = p-ext-key
     1019           temp_twowin_items.itmName      = p-item-name
     1020           temp_twowin_items.itmDesc      = p-item-desc
     1021           temp_twowin_items.itmSelected  = p-selected
     1022           temp_twowin_items.selLeft      = no
     1023           temp_twowin_items.selRight     = no
     1024       .
     1025   end.
     1026   end procedure.
