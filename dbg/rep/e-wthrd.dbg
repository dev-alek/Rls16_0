     1035   procedure uf-name :
     1036     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     1037     define output parameter p-use-List_     as logical   no-undo .
     1038     define output parameter p-type-List_     as character no-undo .
     1039     define output parameter p-format-List_   as character no-undo .
