     1396   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     1397   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     1398   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     1399   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     1400   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     1401   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     1402   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     1403   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     1404         adm-object-hdl = FRAME F-Main:HANDLE.
     1405   RUN ensure-broker.
     1406   THIS-PROCEDURE:ADM-DATA =
     1407        'ADM1.1~`':U +
     1408        'SmartViewer~`':U +
     1409        '~`':U +
     1410        'NO ~`':U +
     1411        '~`':U +
     1412        '~`':U +
     1413        '~`':U +
     1414        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     1415           + "~`":U +
     1416        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
     1417        'Record-Source,Record-Target,TableIO-Target~`':U +
     1418        '~`':U +
     1419        '~`~`~`~`~`~`~`~`~`~`~`':U +
     1420        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1421            THEN "^^":U
     1422        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1423             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1424   PROCEDURE adm-apply-entry :
     1425     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1426   END PROCEDURE.
     1427   PROCEDURE adm-destroy :
     1428    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1429   END PROCEDURE.
     1430   PROCEDURE adm-disable :
     1431       DISABLE RECT-7 RECT-8 RECT-9 RECT-10 is-detal rs-date is-range bt-doc-type sl-doc-type rs-wth-pl bt-wth-pl ed-wth-pl WITH FRAME F-Main.
     1432       RUN dispatch ('disable-fields':U).
     1433       RUN set-attribute-list ('ENABLED=no':U).
     1434       RETURN.
     1435   END PROCEDURE.
     1436   PROCEDURE adm-edit-attribute-list :
     1437         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
     1438         RETURN.
     1439   END PROCEDURE.
     1440   PROCEDURE adm-enable :
     1441       ENABLE UNLESS-HIDDEN RECT-7 RECT-8 RECT-9 RECT-10 is-detal rs-date is-range bt-doc-type sl-doc-type rs-wth-pl bt-wth-pl ed-wth-pl WITH FRAME F-Main.
     1442       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     1443       RUN set-attribute-list ('ENABLED=yes':U).
     1444       RETURN.
     1445   END PROCEDURE.
     1446   PROCEDURE adm-exit :
     1447        RUN notify ('exit':U).
     1448     RETURN.
     1449   END PROCEDURE.
     1450   PROCEDURE adm-hide :
     1451     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1452   END PROCEDURE.
     1453   PROCEDURE adm-initialize :
     1454     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1455   END PROCEDURE.
     1456   PROCEDURE adm-show-errors :
     1457       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1458       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1459           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1460       END.
     1461       RETURN.
     1462   END PROCEDURE.
     1463   PROCEDURE adm-UIB-mode :
     1464     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1465   END PROCEDURE.
     1466   PROCEDURE adm-view :
     1467     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1468   END PROCEDURE.
     1469   PROCEDURE dispatch :
     1470       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1471       RUN broker-dispatch IN adm-broker-hdl
     1472           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1473       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1474   END PROCEDURE.
     1475   PROCEDURE ensure-broker :
     1476   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1477   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1478   DO:
     1479       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1480       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1481   END.
     1482   END PROCEDURE.
     1483   PROCEDURE get-attribute :
     1484     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1485     RUN broker-get-attribute IN adm-broker-hdl
     1486         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1487     RETURN RETURN-VALUE.
     1488   END PROCEDURE.
     1489   PROCEDURE get-attribute-list :
     1490     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1491     RUN broker-get-attribute-list IN adm-broker-hdl
     1492         (INPUT THIS-PROCEDURE,
     1493          INPUT ?,
     1494          OUTPUT p-attr-list) NO-ERROR.
     1495     RETURN.
     1496   END PROCEDURE.
     1497   PROCEDURE new-state :
     1498     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1499     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1500     RETURN.
     1501   END PROCEDURE.
     1502   PROCEDURE notify :
     1503     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1504     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1505     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1506         RETURN "ADM-ERROR":U.
     1507     RETURN.
     1508   END PROCEDURE.
     1509   PROCEDURE set-attribute-list :
     1510     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1511     RUN ensure-broker.
     1512     RUN broker-set-attribute-list IN adm-broker-hdl
     1513         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1514     RETURN.
     1515   END PROCEDURE.
     1516   PROCEDURE set-position :
     1517       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1518       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1519       IF VALID-HANDLE(adm-object-hdl) THEN
     1520       DO:
     1521         ASSIGN adm-object-hdl:ROW    =   p-row
     1522                adm-object-hdl:COLUMN =   p-col.
     1523       END.
     1524       RETURN.
     1525   END PROCEDURE.
     1526   PROCEDURE adm-display-fields :
     1527       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
     1528       RETURN.
     1529   END PROCEDURE.
     1530   PROCEDURE adm-open-query :
     1531     RETURN.
     1532   END PROCEDURE.
     1533   PROCEDURE adm-row-changed :
     1534         IF VALID-HANDLE(adm-object-hdl) THEN
     1535           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1536         RUN notify ('row-available':U).
     1537         RETURN.
     1538   END PROCEDURE.
     1539   PROCEDURE reposition-query :
     1540       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
     1541       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
     1542       RETURN.
     1543   END PROCEDURE.
     1544     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
     1545     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
     1546     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
     1547     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
     1548     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
     1549     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
     1550     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
     1551     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
     1552     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1553     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
     1554     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1555     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
     1556     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
     1557     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
     1558     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
     1559     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
     1560     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
     1561     IF "":U = "":U THEN
     1562       RUN modify-list-attribute IN adm-broker-hdl
     1563         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
     1564     RUN use-create-on-add(?).
     1565   PROCEDURE adm-add-record :
     1566       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1567          "must have at least one Enabled Table to perform Add.":U
     1568          VIEW-AS ALERT-BOX ERROR.
     1569       RETURN.
     1570   END PROCEDURE.
     1571   PROCEDURE adm-assign-record :
     1572    MESSAGE
     1573          "Object ":U THIS-PROCEDURE:FILE-NAME
     1574            "must have at least one Enabled Table to perform Assign.":U
     1575              VIEW-AS ALERT-BOX ERROR.
     1576      RETURN.
     1577     END PROCEDURE.
     1578   PROCEDURE adm-assign-statement :
     1579     RETURN.
     1580   END PROCEDURE.
     1581   PROCEDURE adm-cancel-record :
     1582      RETURN.
     1583     END PROCEDURE.
     1584   PROCEDURE adm-copy-record :
     1585       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1586        "must have at least one Enabled Table to perform Copy.":U
     1587          VIEW-AS ALERT-BOX ERROR.
     1588       RETURN.
     1589   END PROCEDURE.
     1590   PROCEDURE adm-create-record :
     1591      RETURN.
     1592   END PROCEDURE.
     1593   PROCEDURE adm-current-changed :
     1594     RETURN.
     1595   END PROCEDURE.
     1596   PROCEDURE adm-delete-record :
     1597    MESSAGE
     1598          "Object ":U THIS-PROCEDURE:FILE-NAME
     1599            "must have at least one Enabled Table to perform Delete.":U
     1600              VIEW-AS ALERT-BOX ERROR.
     1601       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
     1602       RETURN.
     1603   END PROCEDURE.
     1604   PROCEDURE adm-disable-fields :
     1605         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
     1606       RETURN.
     1607   END PROCEDURE.
     1608   PROCEDURE adm-enable-fields :
     1609       RETURN.
     1610   END PROCEDURE.
     1611   PROCEDURE adm-end-update :
     1612     RETURN.
     1613   END PROCEDURE.
     1614   PROCEDURE adm-reset-record :
     1615       RETURN.
     1616   END PROCEDURE.
     1617   PROCEDURE adm-update-record :
     1618       MESSAGE
     1619         "Object ":U THIS-PROCEDURE:FILE-NAME
     1620           "must have at least one Enabled Table to perform Update.":U
     1621             VIEW-AS ALERT-BOX ERROR.
     1622      RETURN.
     1623   END PROCEDURE.
     1624   PROCEDURE check-modified :
     1625   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1626   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1627   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1628   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1629     IF check-state = "check":U THEN
     1630     DO:
     1631       RUN get-link-handle IN adm-broker-hdl
     1632         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1633            OUTPUT group-target-list).
     1634       IF group-target-list NE "":U THEN
     1635       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1636         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1637         RUN check-modified IN curr-widget ('group-check':U).
     1638         IF RETURN-VALUE NE "":U THEN
     1639         DO:
     1640           RUN check-modified-message(RETURN-VALUE).
     1641           RETURN "":U.
     1642         END.
     1643       END.
     1644     END.
     1645     RETURN "":U.
     1646   END PROCEDURE.
     1647   PROCEDURE check-modified-message :
     1648     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1649        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1650           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1651        IF RETURN-VALUE = "YES":U THEN
     1652           RUN notify ('view,CONTAINER-SOURCE':U).
     1653        MESSAGE IF p-changed-table NE ? THEN
     1654           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1655           ELSE "Current values have been changed."
     1656           SKIP "  Do you wish to save those changes?"
     1657           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1658        IF ANS THEN
     1659        DO:
     1660           IF group-assign-target THEN
     1661             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1662           ELSE RUN dispatch('update-record':U).
     1663           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1664           DO:
     1665               MESSAGE "Changes to the previous record were not saved."
     1666                 VIEW-AS ALERT-BOX ERROR.
     1667               IF group-assign-target THEN
     1668                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1669               ELSE RUN dispatch ('cancel-record':U).
     1670           END.
     1671        END.
     1672        ELSE DO:
     1673          IF group-assign-target THEN
     1674             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1675          ELSE RUN dispatch('cancel-record':U).
     1676        END.
     1677        RETURN.
     1678   END PROCEDURE.
     1679   PROCEDURE get-rowid :
     1680       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1681       ASSIGN
     1682       p-table   =   adm-first-table.
     1683       RETURN.
     1684   END PROCEDURE.
     1685   PROCEDURE init-group-assign :
     1686       RUN request-attribute IN adm-broker-hdl
     1687         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1688       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1689         group-assign-target = yes.
     1690       ELSE group-assign-target = no.
     1691       RETURN.
     1692   END PROCEDURE.
     1693   PROCEDURE set-editors :
     1694       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1695       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1696       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1697       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1698       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1699       DO WHILE VALID-HANDLE (curr-widget):
     1700           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1701              curr-widget:HIDDEN = no THEN DO:
     1702             CASE p-field-setting:
     1703               WHEN "INITIALIZE":U THEN
     1704               DO:
     1705                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1706                     read-only-list +
     1707                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1708                        STRING(curr-widget).
     1709               END.
     1710               WHEN "DISABLE":U OR
     1711               WHEN "ENABLE":U THEN
     1712               DO:
     1713                   curr-widget:SENSITIVE = yes.
     1714                   RUN get-attribute ('Read-Only-Editors':U).
     1715                   IF RETURN-VALUE = ? OR
     1716                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1717                       curr-widget:READ-ONLY =
     1718                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1719               END.
     1720               WHEN "CLEAR":U THEN
     1721                   curr-widget:SCREEN-VALUE = "":U.
     1722             END CASE.
     1723           END.
     1724           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1725       END.
     1726       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1727         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1728           + '"':U).
     1729       RETURN.
     1730   END PROCEDURE.
     1731   PROCEDURE use-check-modified-all :
     1732    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1733     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1734     RETURN.
     1735   END PROCEDURE.
     1736   PROCEDURE use-create-on-add :
     1737   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1738      RETURN.
     1739   END PROCEDURE.
     1740   PROCEDURE use-initial-lock :
     1741     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1742     ASSIGN adm-initial-lock = p-attr-value.
     1743     RETURN.
     1744   END PROCEDURE.
     1745     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1746   ASSIGN
     1747          FRAME F-Main:SCROLLABLE       = FALSE
     1748          FRAME F-Main:HIDDEN           = TRUE.
     1749   ASSIGN
     1750          ed-wth-pl:READ-ONLY IN FRAME F-Main        = TRUE.
     1751   ON CHOOSE OF bt-doc-type IN FRAME F-Main
     1752   DO:
     1753       run select-doc-type in this-procedure.
     1754   END.
     1755   ON CHOOSE OF bt-wth-pl IN FRAME F-Main
     1756   DO:
     1757     assign rs-wth-pl = 2 .
     1758     run select-wth-pl in this-procedure.
     1759     display  rs-wth-pl  ed-wth-pl with frame F-Main.
     1760   END.
     1761   ON RETURN OF f-dtFrom IN FRAME F-Main
     1762   DO:
     1763     APPLY 'entry':U TO f-dtEnd.
     1764     RETURN NO-APPLY.
     1765   END.
     1766   ON VALUE-CHANGED OF is-range IN FRAME F-Main
     1767   DO:
     1768     IF SELF:CHECKED THEN DO:
     1769         ENABLE f-dtFrom f-dtEnd with FRAME F-Main.
     1770         f-dtFrom:BGCOLOR = 15.
     1771         f-dtEnd:BGCOLOR = 15.
     1772         apply "entry":u to f-dtFrom.
     1773         return no-apply.
     1774     END.
     1775     ELSE DO:
     1776         DISABLE f-dtFrom f-dtEnd with FRAME F-Main.
     1777         f-dtFrom:BGCOLOR = ?.
     1778         f-dtEnd:BGCOLOR = ?.
     1779     END.
     1780   END.
     1781   ON VALUE-CHANGED OF rs-wth-pl IN FRAME F-Main
     1782   DO:
     1783     assign  rs-wth-pl .
     1784     case rs-wth-pl:
     1785       when 1 then do:
     1786         assign  ed-wth-pl = "Все" .
     1787         display ed-wth-pl with frame F-Main.
     1788         v-wth-pl-list = ''.
     1789       end.
     1790       when 2 then do:
     1791         apply "choose" to bt-wth-pl.
     1792       end.
     1793       otherwise do:
     1794         return no-apply.
     1795       end.
     1796     end case.
     1797   END.
     1798   PROCEDURE disable_UI :
     1799     HIDE FRAME F-Main.
     1800     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1801   END PROCEDURE.
     1802   PROCEDURE local-apply-layout :
     1803     RUN dispatch IN THIS-PROCEDURE ( INPUT 'apply-layout':U ) .
     1804   END PROCEDURE.
     1805   PROCEDURE local-initialize :
     1806   define buffer buf_wth-place for ub.wth-place .
     1807     define variable v-rs-wth-pl      as logical   no-undo.
     1808     define variable v-rs-doc-type    as logical   no-undo.
     1809     define variable v-factdate       as logical      no-undo.
     1810     define variable v-detal          as logical      no-undo.
     1811     define variable v-found          as logical      no-undo.
     1812     define variable v-i              as integer   no-undo .
     1813     define variable v-wth-pl-lst     as character    no-undo.
     1814     define variable v-doc-type-lst   as character    no-undo.
     1815     do on error undo, return error :
     1816       RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     1817       run uf-get (
     1818             input 'wthrd':U
     1819           , input v-cntxt-userid
     1820           , output v-doc-type-lst
     1821           , output v-wth-pl-lst
     1822           , output v-rs-wth-pl
     1823           , output v-rs-doc-type
     1824           , output v-factdate
     1825           , output v-detal
     1826       ) no-error.
     1827       if error-status :error = false then do:
     1828         if v-factdate = yes then  assign rs-date = 1 .
     1829         else                      assign rs-date = 2 .
     1830         assign is-detal = v-detal .
     1831         if v-rs-wth-pl = no then do:
     1832           assign
     1833             rs-wth-pl  = 1
     1834             ed-wth-pl  = "Все":u
     1835           .
     1836         end.
     1837         else do:
     1838           assign
     1839             rs-wth-pl = 2
     1840             v-wth-pl-list = "":U
     1841           .
     1842           _flt-grp-load:
     1843           do v-i = 1 to num-entries(v-wth-pl-lst) :
     1844             find first buf_wth-place where RECID(buf_wth-place) = integer( entry( v-i, v-wth-pl-lst, chr(44) ) ) no-lock no-error .
     1845             if available buf_wth-place then do:
     1846               assign
     1847                 ed-wth-pl = ed-wth-pl + buf_wth-place.w-p-name + chr(10)
     1848                 v-wth-pl-list = IF v-wth-pl-list = "":U THEN entry( v-i, v-wth-pl-lst, chr(44) ) ELSE v-wth-pl-list + chr(44) + entry( v-i, v-wth-pl-lst, chr(44) )
     1849               .
     1850             end.
     1851           end.
     1852         end.
     1853         assign v-doc-type-list = v-doc-type-lst .
     1854         define variable v-counter as integer   no-undo .
     1855         define variable ii as integer   no-undo .
     1856         if v-rs-doc-type = no then
     1857         assign
     1858           sl-doc-type :list-item-pairs in frame F-Main   = "< Все >":U
     1859         .
     1860         else do:
     1861           assign
     1862             v-counter = 0
     1863           .
     1864           do ii = 1 to num-entries( v-doc-type-lst ) :
     1865             assign  v-counter = v-counter + 1  .
     1866             if v-counter = 1 then do:
     1867               assign sl-doc-type :list-item-pairs = substitute( "&1,&2", entry( lookup(  entry( ii, v-doc-type-lst ), 'ie,ee,ii,ei,ij,ej,fj,jj,pj,oj,we,ci,ce,iy,rj,ip,ep,rp,ff,ef,rf,pc,ps,pz,df,dp,dc,de,xc':u ), 'приход внешний,расход внешний,приход внутренний,расход внутренний,приход внутри объекта,расход внутри объекта,приход внутриобъектн. в своб. зону,расход внутриобъектн. из своб. зоны,приход внутриобъектн. в зону погаш.,расход внутриобъектн. из зоны погаш.,списание,приход внешний через кассы,возврат покупателю через кассы,инвентаризация,возврат внутренний,приход внутр. в зону погашения,расход внутр. из зоны погашения,возврат внутр. в зону погашения,приход внутр. в своб. зону,расход внутр. из своб. зоны,возврат внутр. в своб зону,погашение через кассу,погашение за реализованное топливо,возврат от покупателя,уничтожение в свободной зоне,уничтожение в зоне погашения,уничтожение в зоне клиента,декларация,обмен':u ), entry( ii, v-doc-type-lst ) ) .
     1868             end.
     1869             else do:
     1870               sl-doc-type :add-last (entry( lookup( entry( ii, v-doc-type-lst ), 'ie,ee,ii,ei,ij,ej,fj,jj,pj,oj,we,ci,ce,iy,rj,ip,ep,rp,ff,ef,rf,pc,ps,pz,df,dp,dc,de,xc':u ), 'приход внешний,расход внешний,приход внутренний,расход внутренний,приход внутри объекта,расход внутри объекта,приход внутриобъектн. в своб. зону,расход внутриобъектн. из своб. зоны,приход внутриобъектн. в зону погаш.,расход внутриобъектн. из зоны погаш.,списание,приход внешний через кассы,возврат покупателю через кассы,инвентаризация,возврат внутренний,приход внутр. в зону погашения,расход внутр. из зоны погашения,возврат внутр. в зону погашения,приход внутр. в своб. зону,расход внутр. из своб. зоны,возврат внутр. в своб зону,погашение через кассу,погашение за реализованное топливо,возврат от покупателя,уничтожение в свободной зоне,уничтожение в зоне погашения,уничтожение в зоне клиента,декларация,обмен':u ), entry( ii, v-doc-type-lst ) ) .
     1871             end.
     1872           end.
     1873         end.
     1874       end.
     1875       else do:
     1876         assign
     1877           rs-date = 1
     1878           is-detal = no
     1879           rs-wth-pl  = 1
     1880           ed-wth-pl  = "Все":u
     1881         .
     1882         assign v-doc-type-list = v-list-wdedt .
     1883       end.
     1884       display is-detal rs-date rs-wth-pl ed-wth-pl with frame F-Main.
     1885     end.
     1886   END PROCEDURE.
     1887   PROCEDURE my-report :
     1888       define variable v-counter               as integer      no-undo.
     1889       define variable v-ext-doc-type-list     as character    no-undo.
     1890   assign frame F-Main is-range .
     1891   f-dtFrom = date(f-dtFrom:screen-value in frame F-Main ) no-error.
     1892   f-dtEnd = date(f-dtEnd:screen-value) no-error.
     1893   do on error undo, return error :
     1894      IF rs-wth-pl = 2 and v-wth-pl-list = "":U THEN DO:
     1895        message "Не выбран список мест хранения"  view-as alert-box information.
     1896        return no-apply.
     1897      END.
     1898      IF v-doc-type-list = "":U THEN DO:
     1899        message "Не выбран список типов документов"  view-as alert-box information.
     1900        return no-apply.
     1901      END.
     1902      if is-range and (f-dtFrom = ? or f-dtEnd = ?) then do:
     1903       message "Не верно задан возможный период начала срока годности партий"  view-as alert-box error.
     1904       return no-apply.
     1905      end.
     1906      run uf-set (
     1907           input 'wthrd':U
     1908         , input v-cntxt-userid
     1909         , input v-doc-type-list
     1910         , input v-wth-pl-list
     1911         , input ( if rs-wth-pl = 1 then no else yes )
     1912         , input yes
     1913         , input ( if rs-date = 2 then no else yes )
     1914         , input is-detal
     1915      ) .
     1916      run rep/r-wthrd.p  (  input rs-wth-pl
     1917                          , input v-wth-pl-list
     1918                          , input v-doc-type-list
     1919                          , input rs-date
     1920                          , input is-detal
     1921                          , INPUT is-range
     1922                          , INPUT f-dtFrom
     1923                          , INPUT f-DtEnd
     1924                          ) .
     1925   end.
     1926   END PROCEDURE.
     1927   PROCEDURE my-var :
     1928    assign frame F-Main  rs-wth-pl rs-date is-detal is-range .
     1929   def var v-sl-doc-type as char  no-undo.
     1930   define variable ii as integer   no-undo .
     1931   do ii = 1 to num-entries(sl-doc-type:list-item-pairs):
     1932     if ii modulo 2  = 1 then do:
     1933       v-sl-doc-type = v-sl-doc-type + entry(ii,sl-doc-type:list-item-pairs)  + chr(10).
     1934     end.
     1935   end.
     1936     assign  ReportHeader =   chr(10) + "Отбор документов по:" + chr(10) + entry(rs-date,"Фактической дате,Дате счета-фактуры") + chr(10)
     1937                              + chr(10) + "Виды документов:" + chr(10) + v-sl-doc-type + chr(10)
     1938                              + chr(10)+ "Места хранения:" + chr(10) + ed-wth-pl + chr(10)
     1939                              + chr(10) + "Детализация по МЦ:" + chr(10) + string(is-detal,"Да/Нет") + chr(10)
     1940                              + chr(10) + "Учитывать срок годности:" + chr(10) + string(is-range,"Да/Нет") + chr(10)
     1941                              + chr(10) + (if is-range then substitute("Период возможного начала срока годности: &1 - &2",f-dtFrom:screen-value,f-dtEnd:screen-value) else '')
     1942                              .
     1943   END PROCEDURE.
     1944   PROCEDURE select-doc-type :
     1945       define variable v-counter       as integer      no-undo.
     1946       define variable v-label         as character    no-undo.
     1947       define variable v-value         as character    no-undo.
     1948       define variable v-list          as character    no-undo.
     1949       define variable v-changed       as logical    no-undo.
     1950       define variable v-accepted      as logical    no-undo.
     1951       define variable v-list-edt-full   as character    no-undo.
     1952       define variable v-list-edt      as character    no-undo.
     1953       define variable ii as integer   no-undo .
     1954     do with frame F-Main on error undo, return error :
     1955       assign v-list-edt  = v-list-wdedt.
     1956       do ii = 1 to num-entries( v-list-wdedt ) :
     1957         if ii > 1 then assign v-list-edt-full = v-list-edt-full + ",":U .
     1958         assign v-list-edt-full = v-list-edt-full + entry( lookup ( entry( ii, v-list-wdedt ), 'ie,ee,ii,ei,ij,ej,fj,jj,pj,oj,we,ci,ce,iy,rj,ip,ep,rp,ff,ef,rf,pc,ps,pz,df,dp,dc,de,xc':u ), 'приход внешний,расход внешний,приход внутренний,расход внутренний,приход внутри объекта,расход внутри объекта,приход внутриобъектн. в своб. зону,расход внутриобъектн. из своб. зоны,приход внутриобъектн. в зону погаш.,расход внутриобъектн. из зоны погаш.,списание,приход внешний через кассы,возврат покупателю через кассы,инвентаризация,возврат внутренний,приход внутр. в зону погашения,расход внутр. из зоны погашения,возврат внутр. в зону погашения,приход внутр. в своб. зону,расход внутр. из своб. зоны,возврат внутр. в своб зону,погашение через кассу,погашение за реализованное топливо,возврат от покупателя,уничтожение в свободной зоне,уничтожение в зоне погашения,уничтожение в зоне клиента,декларация,обмен':u ) .
     1959       end.
     1960       run twowin_clear in this-procedure.
     1961       do v-counter = 1 to num-entries( v-list-edt-full ) on error undo, return error :
     1962         assign
     1963           v-label = entry( v-counter, v-list-edt-full )
     1964           v-value = entry( v-counter, v-list-edt )
     1965         .
     1966         run twowin_add-item in this-procedure (
     1967                 input v-value
     1968               , input v-label
     1969               , input substitute( "Код вида документа: &1", v-value )
     1970               , input ( sl-doc-type :lookup( v-value ) <> 0 or sl-doc-type :list-item-pairs = "< Все >,''":U  )
     1971         ).
     1972       end.
     1973       run gbl/twowin.w (
     1974             input ?
     1975           , input 1
     1976           , input "Выбор видов документов":U
     1977           , input "":U
     1978           , input "&Тест"
     1979           , input table temp_twowin_items
     1980           , output table temp_twowin_itemsSelected
     1981           , output v-changed
     1982           , output v-accepted
     1983       ).
     1984       if v-accepted = yes and v-changed = yes then do:
     1985         assign
     1986           sl-doc-type :list-item-pairs    = "< Все >,''":U
     1987           v-list                          = "":U
     1988           v-counter = 0
     1989         .
     1990         for each temp_twowin_itemsSelected by temp_twowin_itemsSelected.itm-key :
     1991           assign
     1992             v-counter = v-counter + 1
     1993             v-list = substitute( "&1&2&3", v-list, ( if v-list = "":U then "":U else ",":U ), temp_twowin_itemsSelected.itmExtKey )
     1994           .
     1995           if v-counter = 1 then do:
     1996             assign sl-doc-type :list-item-pairs = substitute( "&1,&2", entry( lookup( temp_twowin_itemsSelected.itmExtKey, v-list-edt ), v-list-edt-full ), temp_twowin_itemsSelected.itmExtKey ) .
     1997           end.
     1998           else do:
     1999             sl-doc-type :add-last (entry( lookup( temp_twowin_itemsSelected.itmExtKey, v-list-edt ), v-list-edt-full ), temp_twowin_itemsSelected.itmExtKey ) .
     2000           end.
     2001         end.
     2002         assign v-doc-type-list = v-list .
     2003         if v-list = v-list-edt then assign sl-doc-type :list-item-pairs = "< Все >,''":U .
     2004       end.
     2005     end.
     2006   END PROCEDURE.
     2007   PROCEDURE select-wth-pl :
     2008     define buffer buf_wth-place     for ub.wth-place .
     2009     define variable v-count    as integer      no-undo.
     2010     define variable v-wth-pl-lst    as character    no-undo.
     2011     define variable v-i    as integer      no-undo.
     2012     do on error undo, return error :
     2013     assign ed-wth-pl = ''
     2014     v-wth-pl-lst = v-wth-pl-list
     2015     v-wth-pl-list = ''.
     2016       run ref/wthplref.w
     2017           (input my-handle
     2018           ,input 'b-sel,b-mark':u
     2019           ,input v-cntxt-host-code-obj
     2020           ,input v-cntxt-obj-type
     2021           ,input v-cntxt-obj-code
     2022           ,input if v-cntxt-db-num = 0 then 'фирма':U else 'объект':U
     2023           ,input-output v-wth-pl-lst
     2024       ).
     2025       do v-i = 1 to num-entries(v-wth-pl-lst) :
     2026         find first buf_wth-place where RECID(buf_wth-place) = integer( entry( v-i, v-wth-pl-lst, chr(44) ) ) no-lock no-error .
     2027         if available buf_wth-place then do:
     2028           assign
     2029             ed-wth-pl = ed-wth-pl + buf_wth-place.w-p-name + chr(10)
     2030             v-wth-pl-list = IF v-wth-pl-list = "":U THEN entry( v-i, v-wth-pl-lst, chr(44) ) ELSE v-wth-pl-list + chr(44) + entry( v-i, v-wth-pl-lst, chr(44) )
     2031           .
     2032         end.
     2033       end.
     2034     end.
     2035   END PROCEDURE.
