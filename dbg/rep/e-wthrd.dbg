     1121               when 'chkgdsfi':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Товарная строка чека - доп поля"     p-tooltip = "Товарная строка чека - доп поля "     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     1122               when 'chkdocfi':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Чек - доп поля"     p-tooltip = "Чек - доп поля"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     1123               when 'barcodfi':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Бар-код - доп поля"     p-tooltip = "Бар-код - доп поля"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     1124                when 'UPD':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Настройки справочника Электронного документоборота"     p-tooltip = "Настройки справочника Электронного документоборота"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     1125               when 'LK_RECEIPT':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Настройки справочника документов Вывода из оборота (ОСУ)"     p-tooltip = "Настройки справочника документов Вывода из оборота (ОСУ)"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     1126         otherwise do:
     1127           undo, return error "неизвестная настройка пользователя usr-flt" + " " + p-code .
     1128         end.
     1129       end CASE.
     1130     end.
     1131   end procedure.
     1132   procedure uf-get :
     1133     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     1134     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     1135     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     1136     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     1137     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     1138     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     1139     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     1140     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     1141     do
     1142     on error undo, return error
     1143     :
     1144       define buffer buf_usr-flt for ubflt.usr-flt .
     1145       define variable v-use-List_     as logical   no-undo .
     1146       define variable v-type-List_     as character no-undo .
     1147       define variable v-format-List_   as character no-undo .
     1148       define variable v-use-Naim      as logical   no-undo .
     1149       define variable v-type-Naim      as character no-undo .
     1150       define variable v-format-Naim    as character no-undo .
     1151       define variable v-use-print-graft as logical   no-undo .
     1152       define variable v-use-sort-gr     as logical   no-undo .
     1153       define variable v-use-type-price  as logical   no-undo .
     1154       define variable v-use-type-val    as logical   no-undo .
     1155       define variable v-label          as character no-undo .
     1156       define variable v-tooltip        as character no-undo .
     1157       define variable v-user-can-edit  as logical   no-undo .
     1158       define variable v-output-display as logical   no-undo .
     1159       define variable v-other          as character no-undo .
     1160       run uf-name in this-procedure
     1161          (input  entry(1, p-code, chr(4))
     1162         ,output v-use-List_
     1163         ,output v-type-List_
     1164         ,output v-format-List_
     1165         ,output v-use-Naim
     1166         ,output v-type-Naim
     1167         ,output v-format-Naim
     1168         ,output v-use-print-graft
     1169         ,output v-use-sort-gr
     1170         ,output v-use-type-price
     1171         ,output v-use-type-val
     1172         ,output v-label
     1173         ,output v-tooltip
     1174         ,output v-user-can-edit
     1175         ,output v-output-display
     1176         ,output v-other
     1177         ) no-error .
     1178       if error-status :error then do:
     1179         undo, return error return-value .
     1180       end.
     1181       find first buf_usr-flt no-lock where
     1182                  buf_usr-flt.Call-point     = p-code AND
     1183                  buf_usr-flt.user-name       = p-user-name
     1184         no-error .
     1185       if avail buf_usr-flt then do:
     1186         assign
     1187         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
     1188         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
     1189         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
     1190         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
     1191         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
     1192         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
     1193         .
     1194       end.
     1195       else do:
     1196         assign
     1197         p-List_        = (if v-use-List_       then "":U                    else ?)
     1198         p-Naim         = (if v-use-Naim        then "":U                    else ?)
     1199         p-print-graft  = (if v-use-print-graft then no                      else ?)
     1200         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
     1201         p-type-price   = (if v-use-type-price  then no                      else ?)
     1202         p-type-val     = (if v-use-List_       then no                      else ?)
     1203         .
     1204       end.
     1205     end.
     1206   end procedure.
     1207   procedure uf-set :
     1208     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     1209     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     1210     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     1211     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     1212     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     1213     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     1214     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     1215     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     1216     do
     1217     on error undo, return error
     1218     :
     1219       define buffer buf_usr-flt for ubflt.usr-flt .
     1220       define variable v-use-List_     as logical   no-undo .
     1221       define variable v-type-List_     as character no-undo .
     1222       define variable v-format-List_   as character no-undo .
     1223       define variable v-use-Naim      as logical   no-undo .
     1224       define variable v-type-Naim      as character no-undo .
     1225       define variable v-format-Naim    as character no-undo .
     1226       define variable v-use-print-graft as logical   no-undo .
     1227       define variable v-use-sort-gr   as logical   no-undo .
     1228       define variable v-use-type-price as logical   no-undo .
     1229       define variable v-use-type-val  as logical   no-undo .
     1230       define variable v-tooltip        as character no-undo .
     1231       define variable v-label          as character no-undo .
     1232       define variable v-user-can-edit  as logical   no-undo .
     1233       define variable v-output-display as logical   no-undo .
     1234       define variable v-other          as character no-undo .
     1235       run uf-name in this-procedure
     1236         (input  entry(1, p-code, chr(4))
     1237         ,output v-use-List_
     1238         ,output v-type-List_
     1239         ,output v-format-List_
     1240         ,output v-use-Naim
     1241         ,output v-type-Naim
     1242         ,output v-format-Naim
     1243         ,output v-use-print-graft
     1244         ,output v-use-sort-gr
     1245         ,output v-use-type-price
     1246         ,output v-use-type-val
     1247         ,output v-label
     1248         ,output v-tooltip
     1249         ,output v-user-can-edit
     1250         ,output v-output-display
     1251         ,output v-other
     1252         ) no-error .
     1253       if error-status :error then do:
     1254         undo, return error return-value .
     1255       end.
     1256       find first buf_usr-flt where
     1257                  buf_usr-flt.Call-point     = p-code AND
     1258                  buf_usr-flt.user-name       = p-user-name
     1259         no-error .
     1260       if not avail buf_usr-flt then do:
     1261           create buf_usr-flt .
     1262           assign
     1263           buf_usr-flt.call-point = p-code
     1264           buf_usr-flt.user-name  = p-user-name
     1265           .
     1266       end.
     1267       if avail buf_usr-flt then do:
     1268        assign
     1269        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
     1270        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
     1271        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
     1272        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
     1273        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
     1274        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
     1275       .
     1276       release buf_usr-flt.
     1277       end.
     1278       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
     1279     end.
     1280   end procedure.
     1281   CREATE WIDGET-POOL.
     1282   define variable v-wth-pl-list     as character    no-undo.
