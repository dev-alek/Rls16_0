        6   def var vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        7   def var vss-author      as character no-undo init "$Author: expertek $":U .
        8   def var vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        9   def var vss-workfile    as character no-undo init "$Workfile: r-chkhr.p $":U .
       10   def var vss-archive     as character no-undo init "$Archive: rep/r-chkhr.p $":U .
