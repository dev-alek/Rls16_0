     3123                 end.
     3124      when "bo":u then  do:
     3125       DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     3126         p3 @ s-bar-code
     3127         p4 @ gds-zap-artic
     3128         p5 @ gds-zap-gds-name
