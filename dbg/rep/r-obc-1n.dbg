     2432   procedure run1 :
     2433          case select-good :
     2434           when 1  then do:
     2435   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2436   IF x-SelectObject = "currency":U  OR  xTog-obj THEN DO :
     2437       for each gds-obj  where
     2438             gds-obj.obj-type = x-store-type  and
     2439             gds-obj.obj-code = x-store-code
     2440             and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     2441                   no-lock,
     2442             First goods  where  gds-obj.gds-code   = goods.gds-code
     2443   no-lock
     2444   BREAK
     2445       BY (temp-gds-list.gds-code) :
     2446         run item-goods ( "1" , "goods" ) .
     2447         if return-value <> "" then NEXT.
     2448       End.
     2449     END.
     2450     Else DO:
     2451      For each obj-list no-lock :
     2452                     FOR EACH gds-obj where
     2453                   gds-obj.obj-type = obj-list.obj-type    and
     2454                   gds-obj.obj-code = obj-list.obj-code
     2455                   and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     2456                   no-lock :
     2457                   if NOT can-find(First temp-gds-list where temp-gds-list.gds-code = gds-obj.gds-code) Then do:
     2458                       find first goods no-lock  where goods.gds-code  = gds-obj.gds-code .
     2459                       Create temp-gds-list.
     2460                       Assign
     2461                         temp-gds-list.prod-code = gds-obj.prod-code
     2462                         temp-gds-list.grp-name  = gds-obj.grp-name
     2463                         temp-gds-list.gds-name  = goods.gds-name
     2464                         temp-gds-list.gds-code  = gds-obj.gds-code
     2465                         temp-gds-list.artic     = gds-obj.artic
     2466                       .
     2467                   End.
     2468               End.
     2469     End.
     2470     for each temp-gds-list no-lock
     2471       , First goods     where goods.gds-code  = temp-gds-list.gds-code no-lock
     2472         BREAK
     2473       BY temp-gds-list.gds-code :
