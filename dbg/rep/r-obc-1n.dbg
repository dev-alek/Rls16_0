     3544   procedure oborot-stk :
     3545   define input  parameter l-store-code   like ub.clients.obj-code      no-undo.
     3546   define input  parameter l-store-type   like ub.clients.obj-type      no-undo.
     3547   define input  parameter l-artic        like ub.stk-line.artic        no-undo.
     3548   define input  parameter l-prod-code    like ub.stk-line.prod-code    no-undo.
     3549   define input  parameter l-prod-type    like ub.stk-line.prod-type    no-undo.
     3550   define input  parameter l-tog-shift    as   logical                  no-undo.
     3551   define input  parameter l-fact-order-1   like ub.stk-line.fact-order   no-undo.
     3552   define input  parameter l-fact-order-2   like ub.stk-line.fact-order   no-undo.
     3553   define input  parameter l-sum-type     like ub.stk-line.sum-type     no-undo.
     3554   define input  parameter l-cat-id       like ub.stk-line.cat-id       no-undo.
     3555   define input  parameter l-tog-obj       as log no-undo.
     3556   define output parameter quantity    like ub.stk-line.fact-qnty   no-undo.
     3557   define output parameter coast_r     like ub.stk-line.sum-rubl    no-undo.
     3558   define output parameter coast_v     like ub.stk-line.sum-rubl    no-undo.
     3559   define output parameter vat_r       like ub.stk-line.sum-rubl    no-undo.
     3560   define output parameter vat_v       like ub.stk-line.sum-rubl    no-undo.
     3561   define output parameter slt_r       like ub.stk-line.sum-rubl    no-undo.
     3562   define output parameter slt_v       like ub.stk-line.sum-rubl    no-undo.
     3563   define output parameter other_r     like ub.stk-line.sum-rubl    no-undo.
     3564   define output parameter other_v     like ub.stk-line.sum-rubl    no-undo.
     3565   define variable  quantity#1    like ub.stk-line.fact-qnty   no-undo.
     3566   define variable  coast_r#1     like ub.stk-line.sum-rubl    no-undo.
     3567   define variable  coast_v#1     like ub.stk-line.sum-rubl    no-undo.
     3568   define variable  vat_r#1       like ub.stk-line.sum-rubl    no-undo.
     3569   define variable  vat_v#1       like ub.stk-line.sum-rubl    no-undo.
     3570   define variable  slt_r#1       like ub.stk-line.sum-rubl    no-undo.
     3571   define variable  slt_v#1       like ub.stk-line.sum-rubl    no-undo.
     3572   define variable  other_r#1     like ub.stk-line.sum-rubl    no-undo.
     3573   define variable  other_v#1     like ub.stk-line.sum-rubl    no-undo.
     3574   define variable  quantity#2    like ub.stk-line.fact-qnty   no-undo.
     3575   define variable  coast_r#2     like ub.stk-line.sum-rubl    no-undo.
     3576   define variable  coast_v#2     like ub.stk-line.sum-rubl    no-undo.
     3577   define variable  vat_r#2       like ub.stk-line.sum-rubl    no-undo.
     3578   define variable  vat_v#2       like ub.stk-line.sum-rubl    no-undo.
     3579   define variable  slt_r#2       like ub.stk-line.sum-rubl    no-undo.
     3580   define variable  slt_v#2       like ub.stk-line.sum-rubl    no-undo.
     3581   define variable  other_r#2     like ub.stk-line.sum-rubl    no-undo.
     3582   define variable  other_v#2     like ub.stk-line.sum-rubl    no-undo.
     3583   run ost-lineother-tax  in this-procedure
     3584    (  input   l-store-code  ,
     3585       input   l-store-type  ,
     3586       input   l-artic       ,
     3587       input   l-prod-code   ,
     3588       input   l-prod-type   ,
     3589       input   l-tog-shift   ,
     3590       input   l-fact-order-1,
     3591       input   l-sum-type    ,
     3592       input   l-cat-id      ,
     3593       input   l-tog-obj     ,
     3594       output  quantity#1 ,
     3595       output  coast_r#1  ,
     3596       output  coast_v#1  ,
     3597       output  vat_r#1    ,
     3598       output  vat_v#1    ,
     3599       output  slt_r#1    ,
     3600       output  slt_v#1    ,
     3601       output  other_r#1  ,
     3602       output  other_v#1  ).
     3603   run ost-lineother-tax  in this-procedure
     3604    (  input   l-store-code  ,
     3605       input   l-store-type  ,
     3606       input   l-artic       ,
     3607       input   l-prod-code   ,
     3608       input   l-prod-type   ,
     3609       input   l-tog-shift   ,
     3610       input   l-fact-order-2,
     3611       input   l-sum-type    ,
     3612       input   l-cat-id      ,
     3613       input   l-tog-obj     ,
     3614       output  quantity#2 ,
     3615       output  coast_r#2  ,
     3616       output  coast_v#2  ,
     3617       output  vat_r#2    ,
     3618       output  vat_v#2    ,
     3619       output  slt_r#2    ,
     3620       output  slt_v#2    ,
     3621       output  other_r#2  ,
     3622       output  other_v#2  ).
     3623       assign
     3624         quantity =   quantity#2 -  quantity#1
     3625         coast_r  =   coast_r#2  -  coast_r#1
     3626         coast_v  =   coast_v#2  -  coast_v#1
     3627         vat_r    =   vat_r#2    -  vat_r#1
     3628         vat_v    =   vat_v#2    -  vat_v#1
     3629         slt_r    =   slt_r#2    -  slt_r#1
     3630         slt_v    =   slt_v#2    -  slt_v#1
     3631         other_r  =   other_r#2  -  other_r#1
     3632         other_v  =   other_v#2  -  other_v#1
     3633         .
     3634    end procedure.
