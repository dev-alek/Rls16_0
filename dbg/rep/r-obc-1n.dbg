     2799   end procedure.
     2800   procedure display-title :
     2801      PUT stream  OutStream  UNFORMATTED  string( v-cntxt-host-name-obj +  " , " + x-store-type  +  " " + objname) at 50 format "x(85)" skip(2)
     2802             reportname  at 20 format "x(170)" skip
     2803             trim(str1)  at 35 format "x(75)" skip.
     2804        repeat i = 1 to num-entries(str2,chr(10)) :
     2805         PUT stream  OutStream  UNFORMATTED  entry(i,str2,chr(10))  at 1 format "x(170)" skip.
     2806        end.
     2807       i=0.
     2808          PUT stream  OutStream  UNFORMATTED  trim(str3)  at 35 format "x(75)" skip.
     2809        repeat i = 1 to num-entries(str4,chr(10)) :
     2810         PUT stream  OutStream  UNFORMATTED  entry(i,str4,chr(10))  at 1 format "x(170)" skip.
     2811        end.
     2812       i=0.
     2813        repeat i = 1 to num-entries(reportheader,chr(10)) :
     2814         PUT stream  OutStream  UNFORMATTED  entry(i,reportheader,chr(10))  at 1 format "x(170)" skip.
     2815        end.
     2816       i=0.
     2817       run rep/extitle.p (1) .
     2818   end procedure.
     2819   procedure ob-line  :
     2820   define input  parameter x-store-code   like ub.clients.obj-code     no-undo.
     2821   define input  parameter x-store-type   like ub.clients.obj-type     no-undo.
     2822   define input  parameter x-artic        like ub.ot-line.artic        no-undo.
     2823   define input  parameter x-prod-code    like ub.ot-line.prod-code    no-undo.
     2824   define input  parameter x-prod-type    like ub.ot-line.prod-type    no-undo.
     2825   define input  parameter x-fact-order-1   like ub.ot-line.fact-order   no-undo.
     2826   define input  parameter x-fact-order-2   like ub.ot-line.fact-order   no-undo.
     2827   define input  parameter x-sum-type       like ub.ot-line.sum-type     no-undo.
     2828   define input  parameter x-cat-id         like ub.ot-line.cat-id       no-undo.
     2829   define input  parameter x-ext-doc-type   like ub.ot-line.ext-doc-type no-undo.
     2830   define input  parameter xtog-obj           as log no-undo.
     2831   define variable  tt#          as   int                 no-undo.
     2832   define variable  quantity#1    like ub.stk-line.fact-qnty   no-undo.
     2833   define variable  coast_r#1     like ub.stk-line.sum-rubl    no-undo.
     2834   define variable  coast_v#1     like ub.stk-line.sum-rubl    no-undo.
     2835   define variable  vat_r#1       like ub.stk-line.sum-rubl    no-undo.
     2836   define variable  vat_v#1       like ub.stk-line.sum-rubl    no-undo.
     2837   define variable  slt_r#1       like ub.stk-line.sum-rubl    no-undo.
     2838   define variable  slt_v#1       like ub.stk-line.sum-rubl    no-undo.
     2839   define variable  other_r#1     like ub.stk-line.sum-rubl    no-undo.
     2840   define variable  other_v#1     like ub.stk-line.sum-rubl    no-undo.
     2841   define variable  l-sum-type as character no-undo .
     2842   define variable  l-cat-id   as character no-undo .
     2843   define variable v-s# as character no-undo .
     2844    if (x-sum-type = 'sale':U ) then assign tt# = 6 v-s# = 'sadt':U .
     2845    if (x-sum-type = 'crsa':U ) then assign tt# = 3 v-s# = 'cgdt':U .
     2846    if (x-sum-type = 'cost':U ) then assign tt# = 0 v-s# = 'csdt':U .
     2847    if (x-sum-type = 'sasr':U) then assign tt# = 6 v-s# = 'adsr':U .
     2848    if (x-sum-type = 'cgsr':U) then assign tt# = 3 v-s# = 'gdsr':U .
     2849    if (x-sum-type = 'cssr':U) then assign tt# = 0 v-s# = 'sdsr':U .
     2850   define variable v-i as integer no-undo .
     2851   repeat v-i = 1 to  extent(m-prih) :
     2852    run oborot-stk in this-procedure (input  x-store-code , input  x-store-type , input  x-artic ,input  x-prod-code  ,input  x-prod-type  ,input  x-tog-shift  ,input  fact-order-1 ,input  fact-order-2 , input v-s# + m-prih[v-i] , input l-cat-id , input xtog-obj     ,    output quantity#1   ,    output coast_r#1    ,    output coast_v#1    ,    output vat_r#1      ,    output vat_v#1      ,    output slt_r#1      ,    output slt_v#1      ,    output other_r#1    ,    output other_v#1    ) .
     2853       assign prih[1 + tt#]   = prih[1 + tt#] + quantity#1
     2854              prih[2 + tt#]   = prih[2 + tt#] + if tprintrubl then coast_r#1 else coast_v#1
     2855              prih[3 + tt#]   = prih[3 + tt#] + if tprintrubl then vat_r#1   else vat_v#1 .
     2856       if tt# = 6 then gds-zap-other  = gds-zap-other + if tprintrubl then other_r#1  else other_v#1  .
     2857   end.
     2858   repeat v-i = 1 to  extent(m-rash) :
     2859    run oborot-stk in this-procedure (input  x-store-code , input  x-store-type , input  x-artic ,input  x-prod-code  ,input  x-prod-type  ,input  x-tog-shift  ,input  fact-order-1 ,input  fact-order-2 , input  v-s# + m-rash[v-i] , input l-cat-id , input xtog-obj     ,    output quantity#1   ,    output coast_r#1    ,    output coast_v#1    ,    output vat_r#1      ,    output vat_v#1      ,    output slt_r#1      ,    output slt_v#1      ,    output other_r#1    ,    output other_v#1    ) .
     2860       assign rash[1 + tt#]   = rash[1 + tt#] +  quantity#1
     2861              rash[2 + tt#]   = rash[2 + tt#] +  if tprintrubl then coast_r#1 else coast_v#1
     2862              rash[3 + tt#]   = rash[3 + tt#] +  if tprintrubl then vat_r#1   else vat_v#1 .
     2863       if tt# = 6 then gds-zap-other  = gds-zap-other + if tprintrubl then other_r#1  else other_v#1  .
     2864   end.
     2865   repeat v-i = 1 to  extent(m-kassa) :
     2866    run oborot-stk in this-procedure (input  x-store-code , input  x-store-type , input  x-artic ,input  x-prod-code  ,input  x-prod-type  ,input  x-tog-shift  ,input  fact-order-1 ,input  fact-order-2 , input  v-s# + m-kassa[v-i] , input l-cat-id , input xtog-obj     ,    output quantity#1   ,    output coast_r#1    ,    output coast_v#1    ,    output vat_r#1      ,    output vat_v#1      ,    output slt_r#1      ,    output slt_v#1      ,    output other_r#1    ,    output other_v#1    ) .
     2867       assign kassa[1 + tt#]   = kassa[1 + tt#] + quantity#1
     2868              kassa[2 + tt#]   = kassa[2 + tt#] + if tprintrubl then coast_r#1 else coast_v#1
     2869              kassa[3 + tt#]   = kassa[3 + tt#] + if tprintrubl then vat_r#1   else vat_v#1 .
     2870       if tt# = 6 then gds-zap-other  = gds-zap-other + if tprintrubl then other_r#1  else other_v#1  .
     2871    end.
     2872   repeat v-i = 1 to  extent(m-inv) :
     2873    run oborot-stk in this-procedure (input  x-store-code , input  x-store-type , input  x-artic ,input  x-prod-code  ,input  x-prod-type  ,input  x-tog-shift  ,input  fact-order-1 ,input  fact-order-2 , input  v-s# + m-inv[v-i] , input l-cat-id , input xtog-obj     ,    output quantity#1   ,    output coast_r#1    ,    output coast_v#1    ,    output vat_r#1      ,    output vat_v#1      ,    output slt_r#1      ,    output slt_v#1      ,    output other_r#1    ,    output other_v#1    ) .
     2874       assign inv[1 + tt#]   = inv[1 + tt#] + quantity#1
     2875              inv[2 + tt#]   = inv[2 + tt#] + if tprintrubl then coast_r#1 else coast_v#1
     2876              inv[3 + tt#]   = inv[3 + tt#] + if tprintrubl then vat_r#1   else vat_v#1 .
     2877       if tt# = 6 then gds-zap-other  = gds-zap-other + if tprintrubl then other_r#1  else other_v#1  .
     2878   end.
     2879   repeat v-i = 1 to  extent(m-overturn) :
     2880    run oborot-stk in this-procedure (input  x-store-code , input  x-store-type , input  x-artic ,input  x-prod-code  ,input  x-prod-type  ,input  x-tog-shift  ,input  fact-order-1 ,input  fact-order-2 , input  v-s# + m-overturn[v-i] , input l-cat-id , input xtog-obj     ,    output quantity#1   ,    output coast_r#1    ,    output coast_v#1    ,    output vat_r#1      ,    output vat_v#1      ,    output slt_r#1      ,    output slt_v#1      ,    output other_r#1    ,    output other_v#1    ) .
     2881       assign overturn[1 + tt#]   = overturn[1 + tt#] + quantity#1
     2882              overturn[2 + tt#]   = overturn[2 + tt#] + if tprintrubl then coast_r#1 else coast_v#1
     2883              overturn[3 + tt#]   = overturn[3 + tt#] + if tprintrubl then vat_r#1   else vat_v#1 .
     2884       if tt# = 6 then gds-zap-other  = gds-zap-other + if tprintrubl then other_r#1  else other_v#1  .
     2885   end.
     2886     if tt# = 6 then do:
     2887          if (x-sum-type = 'sasr':U) then do:
     2888              assign
     2889              prih[1 ]   = prih[7 ]
     2890              rash[1 ]   = rash[7 ]
     2891              kassa[1]   = kassa[7]
     2892              inv[1]     = inv[7  ]
     2893              .
     2894              end.
     2895              assign overturn[1 + tt#]   = (ostatok-end[1 + tt#]  - ostatok-start[1 + tt#] )  -  (inv[1 + tt#] + prih[1 + tt#]   +  kassa[1 + tt#]  +  rash[1 + tt#]  )
     2896                     overturn[2 + tt#]   = (ostatok-end[2 + tt#]  - ostatok-start[2 + tt#] )  -  (inv[2 + tt#] + prih[2 + tt#]   +  kassa[2 + tt#]  +  rash[2 + tt#]  +  gds-zap-other )
     2897                     overturn[3 + tt#]   = (ostatok-end[3 + tt#]  - ostatok-start[3 + tt#] )  -  (inv[3 + tt#] + prih[3 + tt#]   +  kassa[3 + tt#]  +  rash[3 + tt#]  )  .
     2898     end.
     2899   end procedure.
     2900   procedure report-exec1  :
     2901      find first clients where x-store-type = clients.obj-type and
     2902                               x-store-code = clients.obj-code no-lock no-error.
     2903   IF ( i modulo v-account = 0 )  then DO:
     2904    Assign
     2905       v-kol-spice = (50 - LENGTH(clients.obj-name)) / 2
     2906       RecordsString = fill(' ',v-kol-spice) + string(clients.obj-name)
     2907       .
     2908             if  log-manager:logfile-name ne ?
     2909             then DO:
     2910                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     2911             end.
     2912              if mFrameView
     2913              then do:
     2914               DISPLAY
     2915                 i @ RecordsDone
     2916                 RecordsString   @ RecordsString
     2917                 WITH FRAME InfoFrame.
     2918              end.
     2919   End.
     2920      if v-button-stop then  DO:
     2921            if mFrameView
     2922            then
     2923               PROCESS EVENTS.
     2924            IF StopProcessing THEN DO:
     2925            RETURN error.
     2926            End.
     2927      end.
     2928     run calcitog.
     2929     run print-header.
     2930      case retclassify :
     2931        when "no-classify":u  then   run run1.
     2932      end case.
     2933     run print-footer.
     2934     end procedure.
     2935   procedure calc-sub-itog :
     2936   define input parameter tt as int no-undo.
     2937   define variable b as int no-undo.
     2938   if tt = 6  then assign
     2939     b1-gds-zap-other = b1-gds-zap-other +  gds-zap-other
     2940     b2-gds-zap-other = b2-gds-zap-other +  gds-zap-other
     2941     bi-gds-zap-other = bi-gds-zap-other +  gds-zap-other
     2942     bo-gds-zap-other = bo-gds-zap-other +  gds-zap-other
     2943     .
     2944   repeat b = 1 to 3:
     2945     assign
     2946     b1-prih[b + tt]    = b1-prih[b + tt]    +  prih[b + tt]
     2947     b2-prih[b + tt]    = b2-prih[b + tt]    +  prih[b + tt]
     2948     bi-prih[b + tt]    = bi-prih[b + tt]    +  prih[b + tt]
     2949     bo-prih[b + tt]    = bo-prih[b + tt]    +  prih[b + tt]
     2950     bo-ostatok-start[b + tt]    = bo-ostatok-start[b + tt]    +  ostatok-start[b + tt]
     2951     bo-ostatok-end[b + tt]      = bo-ostatok-end[b + tt]      +  ostatok-end[b + tt]
     2952     b1-rash[b + tt]    = b1-rash[b + tt]    +  rash[b + tt]
     2953     b2-rash[b + tt]    = b2-rash[b + tt]    +  rash[b + tt]
     2954     bi-rash[b + tt]    = bi-rash[b + tt]    +  rash[b + tt]
     2955     bo-rash[b + tt]    = bo-rash[b + tt]    +  rash[b + tt]
     2956     b1-kassa[b + tt]    = b1-kassa[b + tt]    +  kassa[b + tt]
     2957     b2-kassa[b + tt]    = b2-kassa[b + tt]    +  kassa[b + tt]
     2958     bi-kassa[b + tt]    = bi-kassa[b + tt]    +  kassa[b + tt]
     2959     bo-kassa[b + tt]    = bo-kassa[b + tt]    +  kassa[b + tt]
     2960     b1-inv[b + tt]    = b1-inv[b + tt]    +  inv[b + tt]
     2961     b2-inv[b + tt]    = b2-inv[b + tt]    +  inv[b + tt]
     2962     bi-inv[b + tt]    = bi-inv[b + tt]    +  inv[b + tt]
     2963     bo-inv[b + tt]    = bo-inv[b + tt]    +  inv[b + tt]
     2964     b1-overturn[b + tt]    = b1-overturn[b + tt]    +  overturn[b + tt]
     2965     b2-overturn[b + tt]    = b2-overturn[b + tt]    +  overturn[b + tt]
     2966     bi-overturn[b + tt]    = bi-overturn[b + tt]    +  overturn[b + tt]
     2967     bo-overturn[b + tt]    = bo-overturn[b + tt]    +  overturn[b + tt] .
     2968   end.
     2969   end procedure.
     2970   procedure clear-item :
     2971   define variable kk as int no-undo.
     2972    gds-zap-other = 0 .
     2973    repeat kk = 1 to 9 :
     2974    assign
     2975       prih            [kk]    = 0
     2976       rash            [kk]    = 0
     2977       kassa           [kk]    = 0
     2978       inv             [kk]    = 0
     2979       overturn        [kk]    = 0
     2980       ostatok-end     [kk]    = 0
     2981       ostatok-start   [kk]    = 0 .
     2982          end.
     2983    end procedure.
     2984   procedure item-goods :
     2985      define input parameter  par-3 as char no-undo.
     2986      define input parameter  par-4 as char no-undo.
     2987        if par-4 = "goods":u  then do:
     2988           assign
     2989               gds-zap-unit-base  = goods.unit-base
     2990               gds-zap-prt-root   = goods.prt-root
     2991               gds-zap-prod-type  = goods.prod-type
     2992               gds-zap-prod-code  = goods.prod-code
     2993               gds-zap-artic      = goods.artic
     2994               gds-zap-grp-name   = goods.grp-name
     2995               gds-zap-b-code     = goods.gds-code
     2996               gds-zap-type       = goods.gds-type.
     2997           if g#gds-engl then
     2998               assign gds-zap-gds-name = goods.engl-name.
     2999           else
     3000               assign gds-zap-gds-name = goods.gds-name.
     3001        end.
     3002        if par-4 = "gds-list":u  then do:
     3003           assign
     3004               gds-zap-unit-base  = gds-list.unit-base
     3005               gds-zap-prt-root   = gds-list.prt-root
     3006               gds-zap-prod-type  = gds-list.prod-type
     3007               gds-zap-prod-code  = gds-list.prod-code
     3008               gds-zap-artic      = gds-list.artic
     3009               gds-zap-grp-name   = gds-list.grp-name
     3010               gds-zap-b-code     = gds-list.gds-code
     3011               gds-zap-type       = gds-list.gds-type.
     3012           if g#gds-engl then
     3013               assign gds-zap-gds-name = gds-list.engl-name.
     3014           else
     3015               assign gds-zap-gds-name = gds-list.gds-name.
     3016       end.
     3017       run foreach  in this-procedure.
     3018   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     3019     (input  gds-zap-b-code
     3020     ,input  ?
     3021     ,output v-bar-code
     3022     )  .
     3023   s-bar-code = string (v-bar-code,"999999999").
     3024       If  break_group = true  and par-3 <> "1"  then DO :
     3025            FIND FIRST clients WHERE clients.obj-type = gds-zap-prod-type AND clients.obj-code = gds-zap-prod-code use-index pi NO-LOCK .
     3026            gds-zap-prod-name  = clients.obj-name.
     3027             If break_group1 = true  THEN  DO :
     3028               if (par-3 = "3"  OR  par-3 = "5" ) and  par-3 <> "6"
     3029                 then DO: Assign temp-str = string("ГРУППА : " + gds-zap-grp-name )         b1-name = gds-zap-grp-name . end.
     3030                 else DO: Assign temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name ) b1-name = gds-zap-prod-name. end.
     3031               if par-3 = "6"  then  dO:
     3032                  if xTog-obj = true then do:
     3033                    var-vat-pc = func-vat (input gds-zap-b-code , input x-store-type, input x-store-code)
     3034                     .
     3035                   end.
     3036                  else do:
     3037                   var-vat-pc = temp-gds-list.vat-pc .
     3038                   end.
     3039                   assign
     3040                       temp-str = string( "СТАВКА НДС : " + string(var-vat-pc) + "%" )
     3041                       b1-name = temp-str.
     3042                   end.
     3043               if NOT xSumsOnly or (par-3 = "4" Or par-3 = "5" ) THEN DO :
     3044                   fr0 = true .
     3045                   tmp#stroka0 = temp-str.
     3046               End.
     3047             End.
     3048               IF (par-3 = "4"  OR  par-3 = "5")  THEN DO:
     3049                 if par-3 = "4"
     3050                   then Assign temp-str = string("ГРУППА : " + gds-zap-grp-name )          b2-name = gds-zap-grp-name .
     3051                   else Assign temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name )  b2-name = gds-zap-prod-name.
     3052                 if NOT xSumsOnly THEN DO:
     3053                     fr = true .
     3054                 End.
     3055                 break_group1 = false.
     3056               END.
     3057          break_group = false.
     3058       End.
     3059       run display-line  in this-procedure.
     3060    end procedure.
     3061   procedure di :
     3062   define input parameter p1 as char no-undo.
     3063   define input parameter p2 as int no-undo.
     3064   define input parameter p3 as char no-undo.
     3065   define input parameter p4 as char no-undo.
     3066   define input parameter p5 as char no-undo.
     3067   define input parameter p6 as char no-undo.
     3068   define input parameter p7 as char no-undo.
     3069    case caps(p7) :
     3070      when "b1":u  then do:
     3071       DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     3072         p3 @ s-bar-code
     3073         p4 @ gds-zap-artic
     3074         p5 @ gds-zap-gds-name
     3075         p6 @ gds-zap-unit-base
     3076         p1 @ gds-type
     3077         b1-ostatok-start [p2] format "->>>>>>>>>>9.<<" @  F-ostatok-start
