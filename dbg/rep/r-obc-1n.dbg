     2618     End.
     2619     for each temp-gds-list no-lock
     2620       , First gds-list  where gds-list.gds-code  = temp-gds-list.gds-code no-lock
     2621         BREAK
     2622       BY gds-list.gds-code :
     2623       run item-goods ( "1" , "gds-list" ) .
     2624         if return-value <> "" then NEXT.
     2625     End.
     2626   End.
     2627           end.
     2628          end case.
     2629   end procedure.
     2630   procedure calcitog :
     2631       run ostatok  in this-procedure(
     2632           input x-store-code  ,
     2633           input x-store-type  ,x-tog-shift,
     2634           input x-date-start - 1 ,
     2635           input date('')      , x-shift-start,x-shift-end,
     2636           input 'crsa':U   ,
     2637           input '##,##':U,
     2638           input xtog-obj ,
     2639           output  quantity1  ,
     2640           output  coast_r1   ,
     2641           output  coast_v1   ,
     2642           output  vat_r1     ,
     2643           output  vat_v1     ,
     2644           output  fact-order-1 ).
     2645       run ostatok  in this-procedure (
     2646           input x-store-code  ,
     2647           input x-store-type  , x-tog-shift,
     2648           input x-date-start  ,
     2649           input x-date-end    , x-shift-start,x-shift-end,
     2650           input 'crsa':U   ,
     2651           input '##,##':U,
     2652           input xtog-obj ,
     2653           output  quantity1  ,
     2654           output  coast_r1   ,
     2655           output  coast_v1   ,
     2656           output  vat_r1     ,
     2657           output  vat_v1     ,
     2658           output  fact-order-2 ).
     2659             quantity1  = 0.
     2660             coast_r1   = 0.
     2661             coast_v1   = 0.
     2662             vat_r1     = 0.
     2663             vat_v1     = 0.
     2664   end procedure.
     2665   procedure display-str1  :
     2666              run di-qnty  in this-procedure("кол-во", 1, s-bar-code,gds-zap-artic,gds-zap-gds-name,gds-zap-unit-base,"").
     2667            if xshowcost    then do: run di  in this-procedure( "учет.", 2,"","","","",""). end.
     2668            if xshowcrsa    then do: run di  in this-procedure( "прод.", 5,"","","","","" ).  end.
     2669            if xshowsale    then do: run di  in this-procedure( "док." , 8,"","","","","" ).  end.
     2670            if vat-cost    then do: run di  in this-procedure( "уч.НДС", 3,"","","","","" ). end.
     2671            if vat-crsa    then do: run di  in this-procedure( "пр.НДС", 6,"","","","","" ).  end.
     2672            if vat-sale    then do: run di  in this-procedure( "дк.НДС", 9,"","","","","" ).  end.
     2673   end procedure.
     2674   procedure display-bi  :
     2675              run di-qnty in this-procedure ("кол-во",1,  "", gds-zap-artic ,"" ,"", "bi":u).
     2676            if xshowcost    then do: run di in this-procedure ("учет." , 2 , "","", "", "", "bi":u).  end.
     2677            if xshowcrsa    then do: run di in this-procedure ("прод." , 5, "","", "", "",  "bi":u).  end.
     2678            if xshowsale    then do: run di in this-procedure ("док." , 8, "","", "", "",  "bi":u).  end.
     2679            if vat-cost    then do: run di in this-procedure ( "уч.НДС", 3,"","","","","bi":u ). end.
     2680            if vat-crsa    then do: run di in this-procedure ( "пр.НДС", 6,"","","","","bi":u ).  end.
     2681            if vat-sale    then do: run di in this-procedure ( "дк.НДС", 9,"","","","","bi":u ).  end.
     2682   end procedure.
     2683   procedure display-bo  :
     2684              run di-qnty in this-procedure ("кол-во",1,  "", "ИТОГО ПО" ,"ОБЪЕКТАМ" ,"", "bo":u).
     2685            if xshowcost    then do: run di in this-procedure ("учет." , 2 , "","", "", "", "bo":u).  end.
     2686            if xshowcrsa    then do: run di in this-procedure ("прод." , 5, "","", "", "",  "bo":u).  end.
     2687            if xshowsale    then do: run di in this-procedure ("док." , 8, "","", "", "",  "bo":u).  end.
     2688            if vat-cost    then do: run di in this-procedure ( "уч.НДС", 3,"","","","","bo":u ). end.
     2689            if vat-crsa    then do: run di in this-procedure ( "пр.НДС", 6,"","","","","bo":u ).  end.
     2690            if vat-sale    then do: run di in this-procedure ( "дк.НДС", 9,"","","","","bo":u ).  end.
     2691   end procedure.
     2692   procedure display-b1  :
     2693        if not( not show-negativ-2 and
     2694            ( b1-prih         [1]   = 0 and
     2695              b1-rash          [1]   = 0 and
     2696              b1-kassa         [1]   = 0 and
     2697              b1-inv           [1]   = 0 and
     2698              b1-overturn      [1]   = 0 and
     2699              b1-overturn      [5]   = 0 and
     2700              b1-gds-zap-other       = 0 and
     2701              b1-overturn      [8]   = 0 ) ) then do:
     2702           if  not (not show-negativ  and (
     2703                 b1-prih          [1]   = 0 and
     2704                 b1-rash          [1]   = 0 and
     2705                 b1-kassa         [1]   = 0 and
     2706                 b1-inv           [1]   = 0 and
     2707                 b1-gds-zap-other       = 0 and
     2708                 b1-overturn      [1]   = 0 and
     2709                 b1-overturn      [5]   = 0 and
     2710                 b1-ostatok-start [1]   = 0 and
     2711                 b1-ostatok-end   [1]   = 0   )) then do:
     2712                 if sums-only then do:
     2713                     if fr0 = true then do:
     2714                         put stream  outstream  tmp#stroka0 format "x(100)" skip.
     2715                         if Make-Excel then  put   stream ForExcel unformatted string(tmp#stroka0) skip.
     2716                         fr0 = false .
     2717                       end.
     2718                  end.
     2719           run di-qnty in this-procedure ("кол-во"  ,1, s-bar-code, gds-zap-artic, gds-zap-gds-name ,"","b1":u).
     2720           if xshowcost    then do: run di in this-procedure ("учет." ,2 ,"","", "", "", "b1":u).  end.
     2721           if xshowcrsa    then do: run di in this-procedure ("прод." , 5, "","", "", "", "b1":u).  end.
     2722           if xshowsale    then do: run di in this-procedure ("док." , 8, "","", "", "", "b1":u).  end.
     2723           if vat-cost    then do: run di in this-procedure ( "уч.НДС", 3,"","","","","b1":u ). end.
     2724           if vat-crsa    then do: run di in this-procedure ( "пр.НДС", 6,"","","","","b1":u ).  end.
     2725           if vat-sale    then do: run di in this-procedure ( "дк.НДС", 9,"","","","","b1":u ).  end.
     2726          if not sums-only then run p-line.
     2727    end.
     2728    end.
     2729   end procedure.
     2730   procedure display-b2  :
     2731        if not( not show-negativ-2 and
     2732            ( b2-prih         [1]   = 0 and
     2733              b2-rash          [1]   = 0 and
     2734              b2-kassa         [1]   = 0 and
     2735              b2-inv           [1]   = 0 and
     2736              b2-gds-zap-other       = 0 and
     2737              b2-overturn      [1]   = 0 and
     2738              b2-overturn      [5]   = 0 and
     2739              b2-overturn      [8]   = 0 ) ) then do:
     2740           if  not (not show-negativ  and (
     2741                 b2-prih          [1]   = 0 and
     2742                 b2-rash          [1]   = 0 and
     2743                 b2-kassa         [1]   = 0 and
     2744                 b2-inv           [1]   = 0 and
     2745                 b2-gds-zap-other       = 0 and
     2746                 b2-overturn      [1]   = 0 and
     2747                 b2-overturn      [5]   = 0 and
     2748                 b2-ostatok-start [1]   = 0 and
     2749                 b2-ostatok-end   [1]   = 0   )) then do:
     2750           run di-qnty( "кол-во", 1 ,s-bar-code,gds-zap-artic, gds-zap-gds-name,"", "b2":u).
     2751           if xshowcost    then do: run di in this-procedure ("учет.", 2, "","", "", "", "b2":u).  end.
     2752           if xshowcrsa    then do: run di in this-procedure ("прод.", 5 ,"","", "", "", "b2":u).  end.
     2753           if xshowsale    then do: run di in this-procedure ("док.", 8 ,"","", "", "", "b2":u).  end.
     2754            if vat-cost    then do: run di in this-procedure ( "уч.НДС", 3,"","","","","b2":u ). end.
     2755            if vat-crsa    then do: run di in this-procedure ( "пр.НДС", 6,"","","","","b2":u ).  end.
     2756            if vat-sale    then do: run di in this-procedure ( "дк.НДС", 9,"","","","","b2":u ).  end.
     2757            if not sums-only then run u-line.
     2758    end.
     2759   end.
     2760   end procedure.
     2761   procedure clear-b1  :
     2762    b1-gds-zap-other           = 0.
     2763    repeat kk = 1 to 9 :
     2764    assign
     2765       b1-prih                                            [kk]    = 0
     2766       b1-rash                                            [kk]    = 0
     2767       b1-kassa                                           [kk]    = 0
     2768       b1-inv                                             [kk]    = 0
     2769       b1-overturn                                        [kk]    = 0
     2770       b1-ostatok-end                                     [kk]    = 0
     2771       b1-ostatok-start                                   [kk]    = 0   .
     2772      end.
     2773    end procedure.
     2774   procedure clear-b2  :
     2775    b2-gds-zap-other           = 0.
     2776    repeat kk = 1 to 9 :
     2777    assign
     2778       b2-prih                                            [kk]    = 0
     2779       b2-rash                                            [kk]    = 0
     2780       b2-kassa                                           [kk]    = 0
     2781       b2-inv                                             [kk]    = 0
     2782       b2-overturn                                        [kk]    = 0
     2783       b2-ostatok-end                                     [kk]    = 0
     2784       b2-ostatok-start                                   [kk]    = 0   .
     2785      end.
     2786   end procedure.
     2787   procedure clear-bi  :
     2788    bi-gds-zap-other           = 0.
     2789    repeat kk = 1 to 9 :
     2790    assign
     2791       bi-prih                                            [kk]    = 0
     2792       bi-rash                                            [kk]    = 0
     2793       bi-kassa                                           [kk]    = 0
     2794       bi-inv                                             [kk]    = 0
     2795       bi-overturn                                        [kk]    = 0
     2796       bi-ostatok-end                                     [kk]    = 0
     2797       bi-ostatok-start                                   [kk]    = 0   .
