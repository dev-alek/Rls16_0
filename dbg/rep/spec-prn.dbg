      849   procedure create_obj-list :
      850      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      851      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      852      do
      853      on error undo, return error return-value
      854      :
      855         define buffer cli-obj for ub.clients .
      856         define variable p-var as integer no-undo .
      857         define buffer buf_obj-list for obj-list .
      858         find last buf_obj-list  use-index pi no-error .
      859         if available buf_obj-list
      860         then
      861            p-var = buf_obj-list.obj-id + 1.
      862         else
      863            p-var = 1.
      864         find first cli-obj where
      865                   cli-obj.obj-type = p-obj-type
      866               and cli-obj.obj-code = p-obj-code
      867         no-lock no-error.
      868         if available cli-obj
      869         then do:
      870            create buf_obj-list.
      871            assign
      872               buf_obj-list.obj-id   = p-var
      873               buf_obj-list.obj-code = cli-obj.obj-code
      874               buf_obj-list.obj-type = cli-obj.obj-type
      875               buf_obj-list.obj-name = cli-obj.obj-name
      876               buf_obj-list.db-num   = cli-obj.db-num
      877            .
      878         end.
      879      end.
      880   end.
