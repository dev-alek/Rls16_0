        1   block-level on error undo, throw.
        2   define input  parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
        3   define input  parameter p-host-code    as integer   no-undo .
        4   define input  parameter p-doc-num      as integer   no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision$":u .
        6   define variable vss-author      as character no-undo init "$Author$":u .
        7   define variable vss-date        as character no-undo init "$Date$":u .
        8   define variable vss-workfile    as character no-undo init "$Workfile$":u .
        9   define variable vss-archive     as character no-undo init "$Archive$":u .
       10   define variable vss-description as character no-undo init "Печать товарной спецификации к договору" .
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   procedure proc-alt-shift-f2:
       70     if not ibs.th.gbl.gbl-var:rcode
       71   then
       72     run gbl\inidebug.p .
       73   end.
       74   procedure proc-alt-shift-f3:
       75     run gbl/prvssinf.p
       76       ( input this-procedure
       77       ) .
       78   end.
       79   define variable v-inform-launched as logical no-undo initial false .
       80   procedure proc-alt-shift-f4:
       81     define variable v-action as character no-undo .
       82     if v-inform-launched = false then do:
       83       assign
       84         v-inform-launched = true
       85       .
       86       run gbl/d-inform.w
       87         (  input self
       88         ,  input this-procedure
       89         , output v-action
       90         ) no-error .
       91       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       92       assign
       93         v-inform-launched = false
       94       .
       95     end.
       96   end.
       97   procedure proc-alt-f1:
       98     run gbl/corrhelp.p
       99       (input this-procedure
      100       ) .
      101   end .
      102   on alt-shift-f2 anywhere do:
      103     run proc-alt-shift-f2.
      104   end.
      105   on alt-shift-f3 anywhere do:
      106     run proc-alt-shift-f3 in this-procedure .
      107   end.
      108   on alt-shift-f4 anywhere do:
      109     run proc-alt-shift-f4 in this-procedure.
      110   end.
      111   on alt-f1 anywhere do:
      112     run proc-alt-f1 in this-procedure .
      113   end.
      114   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      115   define variable v-waitfram-action01         as character   no-undo .
      116   define variable v-waitfram-action02         as character   no-undo .
      117   define variable v-waitfram-action03         as character   no-undo .
      118   define variable mWaitFramTextBeg            as character   no-undo.
      119   define variable mWaitFramTextEnd            as character   no-undo.
      120   define variable mWaitFramView               as logical     no-undo.
      121   define variable mWaitProcEvent              as logical     no-undo init yes.
      122   define variable mWaitFramInterval           as integer     no-undo init 1 .
      123   define variable mWaitFramStop               as logical     no-undo.
      124   define variable mWaitFramStopUser           as logical     no-undo.
      125   define variable mWaitFramStopTimeOut        as logical     no-undo.
      126   define variable mWaitFramStartProc          as datetime-tz no-undo.
      127   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      128   define button B-WaitFramStop auto-end-key
      129        label "Стоп"
      130        size 10 by 1 tooltip "Остоновить процесс".
      131   define button B-viewProcInfo
      132        label "Информация"
      133        size 15 by 1 tooltip "Информация о процесс".
      134   define frame waitfram
      135     v-waitfram-action01 format "x(72)" no-label skip
      136     v-waitfram-action02 format "x(72)" no-label skip
      137     v-waitfram-action03 format "x(72)" no-label skip
      138     B-viewProcInfo
      139     B-WaitFramStop at row 4 col 30
      140     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      141     .
      142   define new global shared variable mBatchMode as logical no-undo init ?.
      143   define variable mFramBachModHandle as handle no-undo.
      144   mFramBachModHandle = frame waitfram:handle.
      145   define variable mFameOldVis as logical no-undo.
      146   define variable mVisCUrentVin as logical no-undo.
      147   if session:batch-mode
      148   then
      149      mBatchMode = yes.
      150   if mBatchMode = ? then do:
      151     mVisCUrentVin = current-window:visible.
      152     mFameOldVis = mFramBachModHandle:visible.
      153     mFramBachModHandle:visible  = yes.
      154     mBatchMode = mFramBachModHandle:visible ne yes.
      155     mFramBachModHandle:visible = mFameOldVis.
      156     current-window:visible = mVisCUrentVin.
      157   end.
      158    if  log-manager:logfile-name ne ?
      159     then DO:
      160         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      161         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      162         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      163     end.
      164   on choose of B-WaitFramStop in frame waitfram
      165   do:
      166     mWaitFramStop = yes.
      167     mWaitFramStopUser = yes.
      168   end.
      169   function waitfram-check-timeout returns logical():
      170      define variable vtime as int64 no-undo.
      171      if mWaitFramStopTimeOut
      172      then
      173         return yes.
      174      vtime = ( now - mWaitFramStartProc ) / 1000 .
      175      if     mWaitFramTimeOut ne ?
      176         and mWaitFramTimeOut ne 0
      177         and mWaitFramTimeOut lt vtime
      178      then do:
      179         mWaitFramStopTimeOut = yes.
      180      end.
      181      return mWaitFramStopTimeOut.
      182   end.
      183   procedure waitfram-hide :
      184     if not session:batch-mode
      185     then do
      186     on error undo, return error return-value
      187     :
      188       pause 0 before-hide .
      189       if not mBatchMode then
      190         hide frame waitfram .
      191     if     not mWaitFramView
      192        and mWaitProcEvent
      193     then
      194       process events .
      195     end.
      196   end procedure.
      197   procedure waitfram-show :
      198     define input  parameter p-message as character no-undo .
      199     define variable v-left-margin as integer   no-undo .
      200     if not session:batch-mode
      201     then do
      202     on error undo, return error return-value
      203     :
      204       if length(p-message) <= 70 then do:
      205         assign
      206           v-left-margin = integer((70 - length(p-message)) / 2)
      207         .
      208         assign
      209           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      210         .
      211         assign
      212           v-waitfram-action01 = " "
      213           v-waitfram-action02 = " "
      214                                    + fill(" ", v-left-margin)
      215                                    + p-message
      216           v-waitfram-action03 = " "
      217         .
      218       end.
      219       else do:
      220         define variable vRindex1 as integer no-undo.
      221         define variable vRindex2 as integer no-undo.
      222         vRindex1 = r-index(p-message," ",70).
      223         if vRindex1 = 0
      224         then
      225            vRindex1 = 70.
      226         if length(p-message)  <= vRindex1 + 70 then do:
      227           assign
      228             v-waitfram-action01 = " "
      229             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      230             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      231           .
      232         end.
      233         else do:
      234           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      235           if vRindex2 <= vRindex1
      236           then
      237              vRindex2 = vRindex1 + 70.
      238           assign
      239             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      240             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      241             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      242           .
      243         end.
      244       end.
      245       B-viewProcInfo:visible   in frame waitfram = no.
      246       B-viewProcInfo:sensitive in frame waitfram = no.
      247       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      248       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      249       if  (   mWaitFramView
      250          or  mWaitProcEvent)
      251          and not mBatchMode
      252       then
      253          display
      254             v-waitfram-action01 skip
      255             v-waitfram-action02 skip
      256             v-waitfram-action03 skip
      257          with frame waitfram .
      258       if     mWaitFramView
      259          then do:
      260             if     mWaitFramInterval ne ?
      261                and not mBatchMode
      262             then
      263                wait-for go of frame waitfram pause mWaitFramInterval.
      264          end.
      265          else
      266             if     mWaitProcEvent
      267                and not mBatchMode
      268             then
      269                process events .
      270     end.
      271   end procedure.
      272      procedure waitfram-show-this:
      273         define input  parameter iInterval as int64 no-undo.
      274         define variable vtime as int64 no-undo.
      275         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      276         mWaitFramInterval = iInterval.
      277         run waitfram-show (substitute("&1&2 &3&4" ,
      278                                       mWaitFramTextBeg ,
      279                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      280                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      281                                       mWaitFramTextEnd
      282                                      )
      283                           ).
      284      end.
      285      procedure WaitFramRunPause:
      286         define input  parameter iInterval as dec no-undo.
      287         define variable vStart  as datetime-tz no-undo.
      288         define variable vend    as datetime-tz no-undo.
      289         define variable vint as int64 no-undo.
      290         define variable vOk as logical no-undo.
      291         vStart = now.
      292         vend   = vStart.
      293         publish "WaitFramPause" (iInterval,output vOk).
      294         vend   =  now.
      295         vint = vend - vStart.
      296         vint = iInterval - vint / 1000.
      297         if     not mWaitFramStop
      298            and (   vint > 0
      299                 or (    not vOk
      300                     and iInterval eq ?
      301                     )
      302                 )
      303         then
      304            run waitfram-show-this (iInterval).
      305         vend   =  now.
      306         vint = vend - vStart.
      307         vint = iInterval - vint / 1000.
      308         if     not mWaitFramStop
      309            and vint > 0
      310         then do:
      311            run gbl/pause.p (vint * 1000).
      312         end.
      313         if iInterval ne ?
      314         then
      315            publish "WaitFramStop".
      316         waitfram-check-timeout().
      317      end.
      318      procedure WaitFramWaitFor:
      319         define input  parameter iInterval as dec no-undo.
      320         assign
      321            mWaitFramStartProc   = now
      322            mWaitFramStopUser    = no
      323            mWaitFramStopTimeOut = no
      324         .
      325         block-wait:
      326         do while not mWaitFramStop:
      327            run WaitFramRunPause (iInterval).
      328            if  waitfram-check-timeout()
      329            then do:
      330               leave block-wait.
      331            end.
      332         end.
      333         run waitfram-hide.
      334      end.
      335   procedure waitfram-join :
      336     define input  parameter p-line-1  as character no-undo .
      337     define input  parameter p-line-2  as character no-undo .
      338     define input  parameter p-line-3  as character no-undo .
      339     define output parameter p-message as character no-undo .
      340     do
      341     on error undo, return error return-value
      342     :
      343       assign
      344         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      345                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      346                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      347       .
      348     end.
      349   end procedure.
      350   function waitfram-join-function returns character
      351     (input p-line-1 as character
      352     ,input p-line-2 as character
      353     ,input p-line-3 as character
      354     ).
      355     define variable v-message as character no-undo .
      356     run waitfram-join in this-procedure
      357       (input  p-line-1
      358       ,input  p-line-2
      359       ,input  p-line-3
      360       ,output v-message
      361       ) .
      362     return v-message .
      363   end function .
      364   define new global shared variable g#library  as handle no-undo .
      365   define new global shared variable g#library2 as handle no-undo .
      366   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      367   procedure cur-time :
      368      define output parameter p-today as date      no-undo .
      369      define output parameter p-time  as integer   no-undo .
      370     do
      371     on error undo, return error
      372     :
      373       define variable v-date1 as date      no-undo .
      374       define variable v-date2 as date      no-undo .
      375       define variable v-time  as integer   no-undo .
      376       assign
      377         v-date1 = today
      378         v-time  = time
      379         v-date2 = today
      380       .
      381       if v-date1 <> v-date2
      382       then do:
      383         assign
      384           v-date1 = today
      385           v-time  = v-time
      386         .
      387       end.
      388       assign
      389         p-today = v-date1
      390         p-time  = v-time
      391       .
      392     end.
      393   end.
      394   function cur-time-date returns character
      395   :
      396     return string(today, '99/99/9999':U) .
      397   end.
      398   function cur-time-mjd returns decimal
      399   :
      400     define variable v-date as date      no-undo .
      401     define variable v-time as integer   no-undo .
      402     run cur-time in this-procedure
      403       (output v-date
      404       ,output v-time
      405       ) .
      406     return integer(v-date) - 2400002 + (v-time / 86400) .
      407   end.
      408   function cur-time-get-ending-index returns integer
      409   (input p-number as integer
      410   )
      411   :
      412     if p-number < 0
      413     or p-number = ?
      414     then do:
      415       return 1 .
      416     end.
      417     define variable v-rest as integer   no-undo .
      418     assign
      419       p-number = p-number modulo 100
      420     .
      421     if p-number < 20
      422     then do:
      423       assign
      424         v-rest = p-number
      425       .
      426     end.
      427     else do:
      428       assign
      429         v-rest = p-number modulo 10
      430       .
      431     end.
      432     case v-rest :
      433       when 1
      434       then do:
      435         return 2 .
      436       end.
      437       when 2 or
      438       when 3 or
      439       when 4
      440       then do:
      441         return 3 .
      442       end.
      443       otherwise do:
      444         return 1 .
      445       end.
      446     end case .
      447   end.
      448   procedure cur-time-mjd-to-date :
      449      define input  parameter i-mjd-diff as decimal no-undo.
      450      define output parameter o-Date     as date    no-undo.
      451      define output parameter o-Time     as integer no-undo.
      452      define variable v-day-number as integer   no-undo .
      453      if    i-mjd-diff < 0
      454         or i-mjd-diff = ?
      455      then do:
      456         return "?" .
      457      end.
      458      assign
      459         v-day-number = truncate(i-mjd-diff,0).
      460         o-Date = date(v-day-number + 2400002).
      461         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      462     .
      463   end.
      464   function cur-time-mjd-to-string returns character
      465   (input p-mjd-diff as decimal
      466   )
      467   :
      468     define variable v-day-number as integer   no-undo .
      469     define variable v-seconds    as integer   no-undo .
      470     define variable v-hour       as integer   no-undo .
      471     define variable v-min        as integer   no-undo .
      472     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      473     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      474     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      475     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      476     if p-mjd-diff < 0
      477     or p-mjd-diff = ?
      478     then do:
      479       return "?" .
      480     end.
      481     assign
      482       v-day-number = integer(truncate(p-mjd-diff,0))
      483       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      484     .
      485     if v-seconds > 86400
      486     then do:
      487       assign
      488         v-seconds = 86400 - 1
      489       .
      490     end.
      491     if v-seconds < 0
      492     then do:
      493       assign
      494         v-seconds = 0
      495       .
      496     end.
      497     assign
      498       v-hour = truncate(v-seconds / 3600, 0)
      499     .
      500     assign
      501       v-seconds = v-seconds modulo 3600
      502     .
      503     assign
      504       v-min = truncate(v-seconds / 60, 0)
      505     .
      506     assign
      507       v-seconds = v-seconds modulo 60
      508     .
      509     return
      510         (if v-day-number <> 0
      511           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      512           else ""
      513         )
      514       + (if v-day-number <> 0 or v-hour <> 0
      515           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      516           else ""
      517         )
      518       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      519           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      520           else ""
      521         )
      522       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      523       .
      524   end.
      525   function cur-time-string returns character
      526   :
      527     define variable v-date as date      no-undo .
      528     define variable v-time as integer   no-undo .
      529     run cur-time in this-procedure
      530       (output v-date
      531       ,output v-time
      532       ) .
      533     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      534   end.
      535   function cur-time-string-sec returns character
      536   :
      537     define variable v-date as date      no-undo .
      538     define variable v-time as integer   no-undo .
      539     run cur-time in this-procedure
      540       (output v-date
      541       ,output v-time
      542       ) .
      543     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      544   end.
      545   function cur-time-custom  returns character
      546   (input p-prefix as character
      547   ,input p-date-format as character
      548   ,input p-delimiter as character
      549   ,input p-time-format as character
      550   ,input p-suffix as character
      551   )
      552   :
      553     define variable v-date as date      no-undo .
      554     define variable v-time as integer   no-undo .
      555     run cur-time in this-procedure
      556       (output v-date
      557       ,output v-time
      558       ) .
      559     return
      560       p-prefix
      561       + string(v-date, p-date-format)
      562       + p-delimiter
      563       + string(v-time, p-time-format)
      564       + p-suffix
      565       .
      566   end.
      567   function cur-time-print  returns character
      568   :
      569     define variable v-date as date      no-undo .
      570     define variable v-time as integer   no-undo .
      571     run cur-time in this-procedure
      572       (output v-date
      573       ,output v-time
      574       ) .
      575     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      576   end.
      577   function cur-time-datetime returns datetime
      578   :
      579     define variable v-char as character no-undo .
      580     define variable v-datetime as datetime no-undo .
      581     v-char = cur-time-string().
      582     v-datetime = datetime(v-char).
      583     return  v-datetime.
      584   end.
      585   function cur-time-string-msec returns character
      586   :
      587     define variable v-date as datetime  no-undo .
      588     v-date = now.
      589     return string(v-date) .
      590   end.
