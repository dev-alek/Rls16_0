      596   define  stream PrnLibStream.
      597   procedure prn-lib-prn-file :
      598     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      599     define input parameter p-DIsabledoptions as integer no-undo .
      600     define variable v-report-name as character no-undo .
      601     define variable v-user-action as character no-undo .
      602     define variable v-printed     as logical   no-undo .
      603     define variable v-exist       as logical   no-undo .
      604     do
      605       on error undo, return error
      606       :
      607       run prn-lib-get-report-name  in this-procedure (
      608         input parParentProc
      609         ,output v-report-name
      610         ).
      611   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      612   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      613     (input  v-report-name
      614     ,input  2
      615     ,output v-exist
      616     )  .
      617       if NOT v-exist then
      618       DO:
      619         Message
      620           "Нет заданий на печать ! "
      621           view-as alert-box .
      622         Return  .
      623       End.
      624       run gbl/prnfilen.w
      625         (input  ""
      626         ,input  p-DisabledOptions
      627         ,input  string(v-report-name )
      628         ,input  7
      629         ,output v-user-action
      630         ,output v-printed
      631         ) .
      632       if v-printed then
      633       do:
      634         return "YES" .
      635       end.
      636       else
      637       do:
      638         return "NO" .
      639       end.
      640     end.
      641   end procedure.
      642   procedure prn-lib-open-stream :
      643     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      644     define input parameter p-page-size    as integer no-undo .
      645     define input parameter p-is-stream    as logical no-undo .
      646     define input parameter p-append       as logical no-undo .
      647     define variable v-report-name as character no-undo .
      648     do
      649       on error undo, return error
      650       :
      651       run prn-lib-get-report-name  in this-procedure (
      652         input parParentProc
      653         ,output v-report-name
      654         ).
      655       if p-is-stream then
      656       do:
      657         if p-append then
      658         do:
      659           output stream PrnLibStream to value( v-report-name )
      660             page-size value(p-page-size) append .
      661         end.
      662         if not p-append then
      663         do:
      664           output stream PrnLibStream to value( v-report-name )
      665             page-size value(p-page-size) .
      666         end.
      667       end.
      668       if not p-is-stream then
      669       do:
      670         if p-append then
      671         do:
      672           output to value( v-report-name )
      673             page-size value(p-page-size) append .
      674         end.
      675         if not p-append then
      676         do:
      677           output to value( v-report-name )
      678             page-size value(p-page-size) .
      679         end.
      680       end.
      681     end.
      682   end procedure.
      683   procedure prn-lib-open-exp :
      684     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      685     define input parameter p-is-stream    as logical no-undo .
      686     define input parameter p-is-append    as logical no-undo .
      687     define output parameter p-ReportFileName as char init "report" no-undo.
      688     define output parameter p-process as logical no-undo .
      689     define variable glog as logical no-undo .
      690     do
      691       on error undo, return error
      692       :
      693       SYSTEM-DIALOG GET-FILE p-ReportFileName
      694         TITLE      "Укажите путь"
      695         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      696         ASK-OVERWRITE
      697         CREATE-TEST-FILE
      698         SAVE-AS
      699         USE-FILENAME
      700         DEFAULT-EXTENSION "txt"
      701         UPDATE glog
      702         .
      703       if not glog then  return.
      704       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      705       if p-is-stream then
      706       do:
      707         if p-is-append then
      708         do:
      709           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      710         end.
      711         else
      712         do:
      713           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      714         end.
      715       end.
      716       else
      717       do:
      718         if p-is-append then
      719         do:
      720           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      721         end.
      722         else
      723         do:
      724           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      725         end.
      726       end.
      727       p-process = yes.
      728     end.
      729   end procedure.
      730   procedure prn-lib-get-report-name :
      731     define input parameter parParentProc  as widget-handle no-undo.
      732     define output parameter p-report-name as character no-undo .
      733     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      734   end procedure.
      735   procedure prn-lib-reportviewer-report-name :
      736     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      737     define input parameter p-report-name-html as character no-undo .
      738     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      739   end procedure.
      740   procedure prn-lib-reportviewer :
      741     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      742     define input parameter p-report-name-html as character no-undo .
      743     define input parameter p-param        as character no-undo .
      744     define variable v-excel           as character no-undo init 'TRUE' .
      745     define variable v-value-character as character no-undo .
      746     define variable v-value-integer   as character no-undo .
      747     define variable v-value-date      as date      no-undo .
      748     define variable v-value-decimal   as decimal   no-undo .
      749     define variable rep-excel         as logical   no-undo .
      750     define variable excel-string      as character no-undo .
      751     define variable v-param-type      as character no-undo .
      752     define variable v-tth             as handle    no-undo .
      753     run adm/shattri.p (
      754       input "get":U
      755       ,input  ""
      756       ,input  0
      757       ,input  'report-glob':U
      758       ,input  'rep-excel':U
      759       ,output v-value-character
      760       ,output v-value-date
      761       ,output v-value-decimal
      762       ,output v-value-integer
      763       ,output rep-excel
      764       ,output v-param-type
      765       ,INPUT-OUTPUT table-handle v-tth
      766       )  .
      767     if rep-excel then v-excel = "TRUE" .
      768     else v-excel = "FALSE" .
      769     if p-param eq ""
      770     then
      771        p-param = "EXCEL:" + v-excel.
      772     else
      773        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      774     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      775   end procedure.
