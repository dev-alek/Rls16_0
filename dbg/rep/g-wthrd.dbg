      136   procedure create_obj-list :
      137      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      138      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      139      do
      140      on error undo, return error return-value
      141      :
      142         define buffer cli-obj for ub.clients .
      143         define variable p-var as integer no-undo .
      144         define buffer buf_obj-list for obj-list .
      145         find last buf_obj-list  use-index pi no-error .
      146         if available buf_obj-list
      147         then
      148            p-var = buf_obj-list.obj-id + 1.
      149         else
      150            p-var = 1.
      151         find first cli-obj where
      152                   cli-obj.obj-type = p-obj-type
      153               and cli-obj.obj-code = p-obj-code
      154         no-lock no-error.
      155         if available cli-obj
      156         then do:
      157            create buf_obj-list.
      158            assign
      159               buf_obj-list.obj-id   = p-var
      160               buf_obj-list.obj-code = cli-obj.obj-code
      161               buf_obj-list.obj-type = cli-obj.obj-type
      162               buf_obj-list.obj-name = cli-obj.obj-name
      163               buf_obj-list.db-num   = cli-obj.db-num
      164            .
      165         end.
      166      end.
      167   end.
