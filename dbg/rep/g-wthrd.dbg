      124   def
      125   new shared
      126   temp-table  obj-list no-undo
      127     field obj-type like ub.clients.obj-type
      128     field obj-code like ub.clients.obj-code
      129     field obj-name like ub.clients.obj-name
      130     field obj-id   as integer
