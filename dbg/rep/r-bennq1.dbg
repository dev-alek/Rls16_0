      779   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      780   define variable v-waitfram-action01         as character   no-undo .
      781   define variable v-waitfram-action02         as character   no-undo .
      782   define variable v-waitfram-action03         as character   no-undo .
      783   define variable mWaitFramTextBeg            as character   no-undo.
      784   define variable mWaitFramTextEnd            as character   no-undo.
      785   define variable mWaitFramView               as logical     no-undo.
      786   define variable mWaitProcEvent              as logical     no-undo init yes.
      787   define variable mWaitFramInterval           as integer     no-undo init 1 .
      788   define variable mWaitFramStop               as logical     no-undo.
      789   define variable mWaitFramStopUser           as logical     no-undo.
      790   define variable mWaitFramStopTimeOut        as logical     no-undo.
      791   define variable mWaitFramStartProc          as datetime-tz no-undo.
      792   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      793   define button B-WaitFramStop auto-end-key
      794        label "Стоп"
      795        size 10 by 1 tooltip "Остоновить процесс".
      796   define button B-viewProcInfo
      797        label "Информация"
      798        size 15 by 1 tooltip "Информация о процесс".
      799   define frame waitfram
      800     v-waitfram-action01 format "x(72)" no-label skip
      801     v-waitfram-action02 format "x(72)" no-label skip
      802     v-waitfram-action03 format "x(72)" no-label skip
      803     B-viewProcInfo
      804     B-WaitFramStop at row 4 col 30
      805     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      806     .
      807   define new global shared variable mBatchMode as logical no-undo init ?.
      808   define variable mFramBachModHandle as handle no-undo.
      809   mFramBachModHandle = frame waitfram:handle.
      810   define variable mFameOldVis as logical no-undo.
      811   define variable mVisCUrentVin as logical no-undo.
      812   if session:batch-mode
      813   then
      814      mBatchMode = yes.
      815   if mBatchMode = ? then do:
      816     mVisCUrentVin = current-window:visible.
      817     mFameOldVis = mFramBachModHandle:visible.
      818     mFramBachModHandle:visible  = yes.
      819     mBatchMode = mFramBachModHandle:visible ne yes.
      820     mFramBachModHandle:visible = mFameOldVis.
      821     current-window:visible = mVisCUrentVin.
      822   end.
      823    if  log-manager:logfile-name ne ?
      824     then DO:
      825         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      826         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      827         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      828     end.
      829   on choose of B-WaitFramStop in frame waitfram
      830   do:
      831     mWaitFramStop = yes.
      832     mWaitFramStopUser = yes.
      833   end.
      834   function waitfram-check-timeout returns logical():
      835      define variable vtime as int64 no-undo.
      836      if mWaitFramStopTimeOut
      837      then
      838         return yes.
      839      vtime = ( now - mWaitFramStartProc ) / 1000 .
      840      if     mWaitFramTimeOut ne ?
      841         and mWaitFramTimeOut ne 0
      842         and mWaitFramTimeOut lt vtime
      843      then do:
      844         mWaitFramStopTimeOut = yes.
      845      end.
      846      return mWaitFramStopTimeOut.
      847   end.
      848   procedure waitfram-hide :
      849     if not session:batch-mode
      850     then do
      851     on error undo, return error return-value
      852     :
      853       pause 0 before-hide .
      854       if not mBatchMode then
      855         hide frame waitfram .
      856     if     not mWaitFramView
      857        and mWaitProcEvent
      858     then
      859       process events .
      860     end.
      861   end procedure.
      862   procedure waitfram-show :
      863     define input  parameter p-message as character no-undo .
      864     define variable v-left-margin as integer   no-undo .
      865     if not session:batch-mode
      866     then do
      867     on error undo, return error return-value
      868     :
      869       if length(p-message) <= 70 then do:
      870         assign
      871           v-left-margin = integer((70 - length(p-message)) / 2)
      872         .
      873         assign
      874           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      875         .
      876         assign
      877           v-waitfram-action01 = " "
      878           v-waitfram-action02 = " "
      879                                    + fill(" ", v-left-margin)
      880                                    + p-message
      881           v-waitfram-action03 = " "
      882         .
      883       end.
      884       else do:
      885         define variable vRindex1 as integer no-undo.
      886         define variable vRindex2 as integer no-undo.
      887         vRindex1 = r-index(p-message," ",70).
      888         if vRindex1 = 0
      889         then
      890            vRindex1 = 70.
      891         if length(p-message)  <= vRindex1 + 70 then do:
      892           assign
      893             v-waitfram-action01 = " "
      894             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      895             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      896           .
      897         end.
      898         else do:
      899           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      900           if vRindex2 <= vRindex1
      901           then
      902              vRindex2 = vRindex1 + 70.
      903           assign
      904             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      905             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      906             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      907           .
      908         end.
      909       end.
      910       B-viewProcInfo:visible   in frame waitfram = no.
      911       B-viewProcInfo:sensitive in frame waitfram = no.
      912       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      913       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      914       if  (   mWaitFramView
      915          or  mWaitProcEvent)
      916          and not mBatchMode
      917       then
      918          display
      919             v-waitfram-action01 skip
      920             v-waitfram-action02 skip
      921             v-waitfram-action03 skip
      922          with frame waitfram .
      923       if     mWaitFramView
      924          then do:
      925             if     mWaitFramInterval ne ?
      926                and not mBatchMode
      927             then
      928                wait-for go of frame waitfram pause mWaitFramInterval.
      929          end.
      930          else
      931             if     mWaitProcEvent
      932                and not mBatchMode
      933             then
      934                process events .
      935     end.
      936   end procedure.
      937      procedure waitfram-show-this:
      938         define input  parameter iInterval as int64 no-undo.
      939         define variable vtime as int64 no-undo.
      940         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      941         mWaitFramInterval = iInterval.
      942         run waitfram-show (substitute("&1&2 &3&4" ,
      943                                       mWaitFramTextBeg ,
      944                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      945                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      946                                       mWaitFramTextEnd
      947                                      )
      948                           ).
      949      end.
      950      procedure WaitFramRunPause:
      951         define input  parameter iInterval as dec no-undo.
      952         define variable vStart  as datetime-tz no-undo.
      953         define variable vend    as datetime-tz no-undo.
      954         define variable vint as int64 no-undo.
      955         define variable vOk as logical no-undo.
      956         vStart = now.
      957         vend   = vStart.
      958         publish "WaitFramPause" (iInterval,output vOk).
      959         vend   =  now.
      960         vint = vend - vStart.
      961         vint = iInterval - vint / 1000.
      962         if     not mWaitFramStop
      963            and (   vint > 0
      964                 or (    not vOk
      965                     and iInterval eq ?
      966                     )
      967                 )
      968         then
      969            run waitfram-show-this (iInterval).
      970         vend   =  now.
      971         vint = vend - vStart.
      972         vint = iInterval - vint / 1000.
      973         if     not mWaitFramStop
      974            and vint > 0
      975         then do:
      976            run gbl/pause.p (vint * 1000).
      977         end.
      978         if iInterval ne ?
      979         then
      980            publish "WaitFramStop".
      981         waitfram-check-timeout().
      982      end.
      983      procedure WaitFramWaitFor:
      984         define input  parameter iInterval as dec no-undo.
      985         assign
      986            mWaitFramStartProc   = now
      987            mWaitFramStopUser    = no
      988            mWaitFramStopTimeOut = no
      989         .
      990         block-wait:
      991         do while not mWaitFramStop:
      992            run WaitFramRunPause (iInterval).
      993            if  waitfram-check-timeout()
      994            then do:
      995               leave block-wait.
      996            end.
      997         end.
      998         run waitfram-hide.
      999      end.
     1000   procedure waitfram-join :
     1001     define input  parameter p-line-1  as character no-undo .
     1002     define input  parameter p-line-2  as character no-undo .
     1003     define input  parameter p-line-3  as character no-undo .
     1004     define output parameter p-message as character no-undo .
     1005     do
     1006     on error undo, return error return-value
     1007     :
     1008       assign
     1009         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1010                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1011                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1012       .
     1013     end.
     1014   end procedure.
     1015   function waitfram-join-function returns character
     1016     (input p-line-1 as character
     1017     ,input p-line-2 as character
     1018     ,input p-line-3 as character
     1019     ).
     1020     define variable v-message as character no-undo .
     1021     run waitfram-join in this-procedure
     1022       (input  p-line-1
     1023       ,input  p-line-2
     1024       ,input  p-line-3
     1025       ,output v-message
     1026       ) .
     1027     return v-message .
     1028   end function .
     1029   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1030   DEFINE shared TEMP-TABLE times NO-UNDO
     1031   FIELD time1 as integer
     1032   FIELD time2 as integer
     1033   FIELD times as char
     1034   INDEX pi IS PRIMARY UNIQUE time1 time2
     1035   INDEX ps times.
     1036   procedure CreateBenefits private :
     1037   define input parameter p-obj-type  as character no-undo .
     1038   define input parameter p-obj-code  as integer no-undo .
     1039   define input parameter p-pay-code  as integer no-undo .
     1040   define input parameter p-curr-code as integer no-undo .
     1041   define input parameter p-date      as date no-undo .
     1042   define input parameter p-sum       as decimal no-undo .
     1043   define input parameter p-base      as decimal no-undo .
     1044   define input parameter p-rubl      as decimal no-undo .
     1045   define buffer buf_benefits for benefits .
     1046   define buffer buf_cash-pay for ub.cash-pay .
     1047   define buffer buf_currency for ub.currency .
     1048     find first buf_benefits
     1049          where buf_benefits.obj-type  = p-obj-type
     1050            and buf_benefits.obj-code  = p-obj-code
     1051            and buf_benefits.pay-code  = p-pay-code
     1052            and buf_benefits.curr-code = p-curr-code
     1053            and buf_benefits.date_     = p-date no-error .
     1054     if not available buf_benefits then do:
     1055       FIND FIRST buf_cash-pay NO-LOCK
     1056            WHERE buf_cash-pay.cdpay-code = p-pay-code
     1057              AND buf_cash-pay.curr-code  = p-curr-code NO-ERROR.
     1058       FIND FIRST buf_currency NO-LOCK
     1059            WHERE buf_currency.curr-code = p-curr-code NO-ERROR.
     1060       create buf_benefits.
     1061       assign
     1062         buf_benefits.date_     = p-date
     1063         buf_benefits.obj-type  = p-obj-type
     1064         buf_benefits.obj-code  = p-obj-code
     1065         buf_benefits.pay-code  = p-pay-code
     1066         buf_benefits.pay-name  = if available buf_cash-pay then buf_cash-pay.obj-name  else "Неопознанная оплата"
     1067         buf_benefits.curr-code = p-curr-code
     1068         buf_benefits.curr-name = if available buf_currency then buf_currency.curr-name else "Неопознанная валюта"
     1069       .
     1070     end .
     1071     assign
     1072       buf_benefits.tot-sum  = buf_benefits.tot-sum  + p-sum
     1073       buf_benefits.tot-base = buf_benefits.tot-base + p-base
     1074       buf_benefits.tot-rubl = buf_benefits.tot-rubl + p-rubl
     1075       buf_benefits.tot-r-b  = (if v-curr-r-b = 'base':U then buf_benefits.tot-base else buf_benefits.tot-rubl)
     1076     .
     1077   end procedure .
     1078   procedure CreateDaySum private :
     1079   define input parameter p-obj-type  as character no-undo .
     1080   define input parameter p-obj-code  as integer no-undo .
     1081   define input parameter p-date      as date no-undo .
     1082   define input parameter p-cnt-all   as integer no-undo .
     1083   define input parameter p-cnt-nf    as integer no-undo .
     1084   define input parameter p-acc-rubl  as decimal no-undo .
     1085   define input parameter p-acc-base  as decimal no-undo .
     1086   define buffer buf_day_sum for day_sum .
     1087     create buf_day_sum.
     1088     assign
     1089       buf_day_sum.obj-type = p-obj-type
     1090       buf_day_sum.obj-code = p-obj-code
     1091       buf_day_sum.date     = p-date
     1092       buf_day_sum.chk-cnt-all = p-cnt-all
     1093       buf_day_sum.chk-cnt-nf  = p-cnt-nf
     1094       buf_day_sum.tot-rubl    = p-acc-rubl
     1095       buf_day_sum.tot-base    = p-acc-base
     1096     .
     1097   end procedure .
     1098   define variable acc-curr-sum as decimal no-undo.
     1099   define variable acc-curr-base as decimal no-undo.
     1100   define variable acc-curr-rubl as decimal no-undo.
     1101   define variable acc-sub-curr-sum as decimal no-undo.
     1102   define variable acc-sub-curr-base as decimal no-undo.
     1103   define variable acc-sub-curr-rubl as decimal no-undo.
     1104   define variable acc-count-ln as integer no-undo.
     1105   define variable acc-count-step as integer no-undo .
     1106   define variable acc-date-base as decimal no-undo.
     1107   define variable acc-date-rubl as decimal no-undo.
     1108   define variable acc-date-count as integer no-undo.
     1109   define variable acc-sub-date-base as decimal no-undo.
     1110   define variable acc-sub-date-rubl as decimal no-undo.
     1111   define variable acc-sub-date-count as integer no-undo.
     1112   define variable acc-day-rubl as decimal no-undo .
     1113   define variable acc-day-base as decimal no-undo .
     1114   define variable acc-day-cnt as integer no-undo .
     1115   define variable acc-day-nf  as integer no-undo .
     1116   define variable v-skip-line    as logical no-undo .
     1117   define variable v-is-sub-count as logical no-undo .
     1118   define variable found as logical no-undo .
     1119     acc-count-ln = 0 .
     1120     acc-count-step = 0 .
     1121   FOR EACH obj-list WHERE
     1122            obj-list.obj-type = 'маг':U NO-LOCK :
     1123     CASE X-radio-task > 1:
     1124       WHEN YES THEN DO:
     1125         _chk-doc3:
     1126         FOR EACH chk-doc NO-LOCK WHERE
     1127                   chk-doc.obj-type = obj-list.obj-type
     1128               AND chk-doc.obj-code = obj-list.obj-code
     1129               AND chk-doc.shift-date >= x-date-start
     1130               AND chk-doc.shift-date <= x-date-end
     1131               AND (IF cas-num > 0 then chk-doc.pay-desk = cas-num else TRUE)
     1132         BREAK
     1133         BY chk-doc.obj-type
     1134         BY chk-doc.obj-code
     1135         BY chk-doc.shift-date :
     1136           if first-of( chk-doc.shift-date ) then do:
     1137             assign
     1138             acc-date-rubl = 0
     1139             acc-date-base = 0
     1140             acc-date-count = 0
     1141             acc-sub-date-rubl = 0
     1142             acc-sub-date-base = 0
     1143             acc-sub-date-count = 0
     1144             .
     1145           end.
     1146           v-skip-line =
     1147           (
     1148                X-Radio-task = 3 AND
     1149                ((chk-doc.shift-date = x-date-start AND chk-doc.shift-num < X-shift-start) OR
     1150                 (chk-doc.shift-date = x-date-end   AND chk-doc.shift-num > X-shift-end))
     1151           ) OR (
     1152                X-radio-task = 4 AND
     1153                chk-doc.shift-num <> X-Shift-Alone
     1154           ) OR (
     1155                T-time AND
     1156                NOT can-find (FIRST times WHERE times.time1 <= chk-doc.chk-time
     1157                                            AND times.time2 >= chk-doc.chk-time)
     1158           ) .
     1159           if not v-skip-line then do :
     1160             v-is-sub-count = (  lookup(string(chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0  ).
     1161             found = false .
     1162             if v-is-sub-count then do :
     1163               for first chk-pay No-LOCK
     1164                  WHERE chk-pay.doc-code = chk-doc.doc-code
     1165                    and chk-pay.tot-sum <> 0 :
     1166                 found = true .
     1167                 leave .
     1168               end .
     1169             end .
     1170             else do :
     1171               for EACH chk-pay No-LOCK
     1172                  WHERE chk-pay.doc-code = chk-doc.doc-code
     1173                    and chk-pay.tot-sum <> 0
     1174               break BY chk-pay.pay-code
     1175                     BY chk-pay.curr-code :
     1176                 found = true .
     1177   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1178           if FIRST-of( chk-pay.curr-code ) then do:
     1179             assign
     1180             acc-sub-curr-sum = 0
     1181             acc-sub-curr-base = 0
     1182             acc-sub-curr-rubl = 0
     1183             acc-curr-sum = 0
     1184             acc-curr-base = 0
     1185             acc-curr-rubl = 0
     1186             .
     1187           end.
     1188           if v-is-sub-count then do:
     1189             assign
     1190             acc-sub-curr-sum  = acc-sub-curr-sum  + chk-pay.tot-sum
     1191             acc-sub-curr-base = acc-sub-curr-base + chk-pay.tot-base
     1192             acc-sub-curr-rubl = acc-sub-curr-rubl + chk-pay.tot-rubl
     1193             acc-sub-date-base = acc-sub-date-base + chk-pay.tot-base
     1194             acc-sub-date-rubl = acc-sub-date-rubl + chk-pay.tot-rubl
     1195             .
     1196           END.
     1197           assign
     1198           acc-curr-sum  = acc-curr-sum  + chk-pay.tot-sum
     1199           acc-curr-base = acc-curr-base + chk-pay.tot-base
     1200           acc-curr-rubl = acc-curr-rubl + chk-pay.tot-rubl
     1201           acc-date-base = acc-date-base + chk-pay.tot-base
     1202           acc-date-rubl = acc-date-rubl + chk-pay.tot-rubl
     1203           acc-count-ln  = acc-count-ln  + 1
     1204           .
     1205   if acc-count-ln > acc-count-step then do:
     1206     run waitfram-show in this-procedure ( obj-list.obj-type + string( obj-list.obj-code ) +
     1207                                     ", обработано строк чеков : " +
     1208                                     string( ACC-count-ln) ) .
     1209     acc-count-step = acc-count-ln + 96 .
     1210   end.
     1211   if last-of( chk-pay.curr-code ) and (acc-curr-sum - acc-sub-curr-sum) <> 0 then do:
     1212     run CreateBenefits in this-procedure
     1213     ( obj-list.obj-type
     1214     , obj-list.obj-code
     1215     , chk-pay.pay-code
     1216     , chk-pay.curr-code
     1217     , chk-doc.shift-date
     1218     , (acc-curr-sum  - acc-sub-curr-sum)
     1219     , (acc-curr-base - acc-sub-curr-base)
     1220     , (acc-curr-rubl - acc-sub-curr-rubl)
     1221     ) .
     1222     if not v-is-sub-count then do :
     1223     if not can-find (first ben-chk-count where ben-chk-count.doc-code  = chk-pay.doc-code
     1224                                            and ben-chk-count.obj-type  = obj-list.obj-type
     1225                                            and ben-chk-count.obj-code  = obj-list.obj-code
     1226                                            and ben-chk-count.date_     = chk-doc.shift-date
     1227                                            and ben-chk-count.pay-code  = chk-pay.pay-code
     1228                                            and ben-chk-count.curr-code = chk-pay.curr-code) then do:
     1229       create ben-chk-count.
     1230       assign
     1231         ben-chk-count.doc-code  = chk-pay.doc-code
     1232         ben-chk-count.obj-type  = obj-list.obj-type
     1233         ben-chk-count.obj-code  = obj-list.obj-code
     1234         ben-chk-count.date_     = chk-doc.shift-date
     1235         ben-chk-count.pay-code  = chk-pay.pay-code
     1236         ben-chk-count.curr-code = chk-pay.curr-code
     1237       .
     1238     end.
     1239     end .
     1240   end.
     1241               end .
     1242             end .
     1243             if found then assign
     1244               acc-date-count     = acc-date-count     + 1
     1245               acc-sub-date-count = acc-sub-date-count + 1 when (v-is-sub-count)
     1246             .
     1247           end .
     1248           if last-of( chk-doc.shift-date ) then do:
     1249             run CreateDaySum in this-procedure
     1250             ( obj-list.obj-type
     1251             , obj-list.obj-code
     1252             , chk-doc.shift-date
     1253             , acc-date-count
     1254             , acc-sub-date-count
     1255             , acc-date-rubl - acc-sub-date-rubl
     1256             , acc-date-base - acc-sub-date-base
     1257             ) .
     1258           end.
     1259         END.
     1260       END.
     1261       WHEN NO THEN DO:
     1262         _chk-doc4:
     1263         FOR EACH chk-pay No-LOCK WHERE
     1264                 chk-pay.obj-type = obj-list.obj-type AND
     1265                 chk-pay.obj-code = obj-list.obj-code AND
     1266                 chk-pay.chk-date >= x-date-start AND
     1267                 chk-pay.chk-date <= x-date-end AND
     1268                 chk-pay.tot-sum <> 0
     1269         BREAK
     1270         BY chk-pay.obj-type
     1271         BY chk-pay.obj-code
     1272         BY chk-pay.chk-date
     1273         BY chk-pay.doc-code
     1274         BY chk-pay.pay-code
     1275         BY chk-pay.curr-code :
     1276           if first-of( chk-pay.chk-date ) then do:
     1277             assign
     1278             acc-date-rubl = 0
     1279             acc-date-base = 0
     1280             acc-date-count = 0
     1281             acc-sub-date-rubl = 0
     1282             acc-sub-date-base = 0
     1283             acc-sub-date-count = 0
     1284             .
     1285           end.
     1286           if first-of( chk-pay.doc-code ) then do:
     1287             IF cas-num > 0 then
     1288             find FIRST chk-doc NO-LOCK
     1289                  WHERE chk-doc.doc-code = chk-pay.doc-code
     1290                    AND chk-doc.pay-desk = cas-num no-error .
     1291             else
     1292             find FIRST chk-doc NO-LOCK
     1293                  WHERE chk-doc.doc-code = chk-pay.doc-code no-error .
     1294             if available chk-doc then do :
     1295             v-skip-line =
     1296             (
     1297                T-time AND
     1298                NOT can-find (FIRST times WHERE times.time1 <= chk-doc.chk-time
     1299                                            AND times.time2 >= chk-doc.chk-time)
     1300             ) .
     1301             end .
     1302             else v-skip-line = true .
     1303             if not v-skip-line then do :
     1304             v-is-sub-count = (  lookup(string(chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0  ).
     1305             assign
     1306               acc-date-count     = acc-date-count     + 1
     1307               acc-sub-date-count = acc-sub-date-count + 1 when (v-is-sub-count)
     1308             .
     1309             end .
     1310           end.
     1311           if not v-skip-line then do :
     1312   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1313           if FIRST-of( chk-pay.curr-code ) then do:
     1314             assign
     1315             acc-sub-curr-sum = 0
     1316             acc-sub-curr-base = 0
     1317             acc-sub-curr-rubl = 0
     1318             acc-curr-sum = 0
     1319             acc-curr-base = 0
     1320             acc-curr-rubl = 0
     1321             .
     1322           end.
     1323           if v-is-sub-count then do:
     1324             assign
     1325             acc-sub-curr-sum  = acc-sub-curr-sum  + chk-pay.tot-sum
     1326             acc-sub-curr-base = acc-sub-curr-base + chk-pay.tot-base
     1327             acc-sub-curr-rubl = acc-sub-curr-rubl + chk-pay.tot-rubl
     1328             acc-sub-date-base = acc-sub-date-base + chk-pay.tot-base
     1329             acc-sub-date-rubl = acc-sub-date-rubl + chk-pay.tot-rubl
     1330             .
     1331           END.
     1332           assign
     1333           acc-curr-sum  = acc-curr-sum  + chk-pay.tot-sum
     1334           acc-curr-base = acc-curr-base + chk-pay.tot-base
     1335           acc-curr-rubl = acc-curr-rubl + chk-pay.tot-rubl
     1336           acc-date-base = acc-date-base + chk-pay.tot-base
     1337           acc-date-rubl = acc-date-rubl + chk-pay.tot-rubl
     1338           acc-count-ln  = acc-count-ln  + 1
     1339           .
     1340   if acc-count-ln > acc-count-step then do:
     1341     run waitfram-show in this-procedure ( obj-list.obj-type + string( obj-list.obj-code ) +
     1342                                     ", обработано строк чеков : " +
     1343                                     string( ACC-count-ln) ) .
     1344     acc-count-step = acc-count-ln + 96 .
     1345   end.
     1346   if last-of( chk-pay.curr-code ) and (acc-curr-sum - acc-sub-curr-sum) <> 0 then do:
     1347     run CreateBenefits in this-procedure
     1348     ( obj-list.obj-type
     1349     , obj-list.obj-code
     1350     , chk-pay.pay-code
     1351     , chk-pay.curr-code
     1352     , chk-pay.chk-date
     1353     , (acc-curr-sum  - acc-sub-curr-sum)
     1354     , (acc-curr-base - acc-sub-curr-base)
     1355     , (acc-curr-rubl - acc-sub-curr-rubl)
     1356     ) .
     1357     if not v-is-sub-count then do :
     1358     if not can-find (first ben-chk-count where ben-chk-count.doc-code  = chk-pay.doc-code
     1359                                            and ben-chk-count.obj-type  = obj-list.obj-type
     1360                                            and ben-chk-count.obj-code  = obj-list.obj-code
     1361                                            and ben-chk-count.date_     = chk-pay.chk-date
     1362                                            and ben-chk-count.pay-code  = chk-pay.pay-code
     1363                                            and ben-chk-count.curr-code = chk-pay.curr-code) then do:
     1364       create ben-chk-count.
     1365       assign
     1366         ben-chk-count.doc-code  = chk-pay.doc-code
     1367         ben-chk-count.obj-type  = obj-list.obj-type
     1368         ben-chk-count.obj-code  = obj-list.obj-code
     1369         ben-chk-count.date_     = chk-pay.chk-date
     1370         ben-chk-count.pay-code  = chk-pay.pay-code
     1371         ben-chk-count.curr-code = chk-pay.curr-code
     1372       .
     1373     end.
     1374     end .
     1375   end.
     1376           end .
     1377           if last-of( chk-pay.chk-date ) then do:
     1378             run CreateDaySum in this-procedure
     1379             ( obj-list.obj-type
     1380             , obj-list.obj-code
     1381             , chk-pay.chk-date
     1382             , acc-date-count
     1383             , acc-sub-date-count
     1384             , acc-date-rubl - acc-sub-date-rubl
     1385             , acc-date-base - acc-sub-date-base
     1386             ) .
     1387           end.
     1388         END.
     1389       END.
     1390     END CASE.
     1391   END.
     1392     assign
     1393       AllDay-BaseSum = 0.0
     1394       AllDay-RublSum = 0.0
     1395       ObjAmount = 0
     1396       ChkAmount = 0
     1397     .
     1398     for each day_sum break by day_sum.obj-code :
     1399       if first-of (day_sum.obj-code) then do :
     1400         assign
     1401           acc-day-base = 0
     1402           acc-day-rubl = 0
     1403           acc-day-cnt  = 0
     1404           acc-day-nf   = 0
     1405         .
     1406       end .
     1407       assign
     1408         day_sum.tot-r-b  = (if v-curr-r-b = 'base':U then day_sum.tot-base else day_sum.tot-rubl)
     1409         acc-day-rubl = acc-day-rubl + day_sum.tot-rubl
     1410         acc-day-base = acc-day-base + day_sum.tot-base
     1411         acc-day-cnt  = acc-day-cnt  + day_sum.chk-cnt-all
     1412         acc-day-nf   = acc-day-nf   + day_sum.chk-cnt-nf
     1413       .
     1414       if last-of (day_sum.obj-code) then do :
     1415         create all-days_sum .
     1416         assign
     1417           all-days_sum.obj-type = day_sum.obj-type
     1418           all-days_sum.obj-code = day_sum.obj-code
     1419           all-days_sum.tot-base = acc-day-base
     1420           all-days_sum.tot-rubl = acc-day-rubl
     1421           all-days_sum.tot-r-b  = (if v-curr-r-b = 'base':U then acc-day-base else acc-day-rubl)
     1422           all-days_sum.chk-cnt-all = acc-day-cnt
     1423           all-days_sum.chk-cnt-nf  = acc-day-nf
     1424           AllDay-BaseSum = AllDay-BaseSum + all-days_sum.tot-r-b
     1425           AllDay-rublSum = AllDay-RublSum + acc-day-rubl
     1426           ObjAmount      = ObjAmount + 1
     1427           ChkAmount      = ChkAmount + (all-days_sum.chk-cnt-all - all-days_sum.chk-cnt-nf)
     1428         .
     1429       end .
     1430     end .
