     1386        Tog-tree AT ROW 6 COL 39.13
     1387        RADIO-Nomenkl AT ROW 6.54 COL 52 NO-LABEL
     1388        RADIO-AltObj AT ROW 11 COL 2.5 NO-LABEL
     1389        ShowZero-2 AT ROW 12 COL 32
     1390        RADIO-SET-1 AT ROW 12.21 COL 55.38 NO-LABEL
     1391        B-columns AT ROW 12.5 COL 3
     1392        ShowZero AT ROW 13 COL 32
     1393        B-columns-2 AT ROW 13.75 COL 3 WIDGET-ID 2
     1394        SumsOnly AT ROW 14 COL 32
     1395        no-nds AT ROW 15 COL 32
     1396        TOGGLE-1 AT ROW 16.63 COL 31.63
     1397        FILL-IN-31 AT ROW 5.54 COL 51.63 NO-LABEL
     1398        FILL-IN-33 AT ROW 10.88 COL 32.38 NO-LABEL
     1399        FILL-IN-32 AT ROW 10.92 COL 53.5 NO-LABEL
     1400        "Сортировка :" VIEW-AS TEXT
     1401             SIZE 13.63 BY .75 AT ROW 1.46 COL 51.5
     1402             FGCOLOR 4
     1403        "Классификация :":C47 VIEW-AS TEXT
     1404             SIZE 46.25 BY .75 AT ROW 1.42 COL 2.5
     1405             FGCOLOR 4
     1406        RECT-7 AT ROW 5.38 COL 50.5
     1407        RECT-5 AT ROW 1.21 COL 1.75
     1408        RECT-8 AT ROW 10.63 COL 1.75
     1409        RECT-6 AT ROW 1.21 COL 50.38
     1410       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
     1411            SIDE-LABELS NO-UNDERLINE THREE-D
     1412            AT COL 1 ROW 1 SCROLLABLE .
     1413   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     1414   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     1415   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     1416   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     1417   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     1418   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     1419   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     1420   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     1421         adm-object-hdl = FRAME F-Main:HANDLE.
     1422   RUN ensure-broker.
     1423   THIS-PROCEDURE:ADM-DATA =
     1424        'ADM1.1~`':U +
     1425        'SmartObject~`':U +
     1426        '~`':U +
     1427        'NO ~`':U +
     1428        '~`':U +
     1429        '~`':U +
     1430        '~`':U +
     1431        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     1432           + "~`":U +
     1433        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
     1434        'Record-Source,Record-Target,TableIO-Target~`':U +
     1435        '~`':U +
     1436        '~`~`~`~`~`~`~`~`~`~`~`':U +
     1437        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1438            THEN "^^":U
     1439        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1440             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1441   PROCEDURE adm-apply-entry :
     1442     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1443   END PROCEDURE.
     1444   PROCEDURE adm-destroy :
     1445    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1446   END PROCEDURE.
     1447   PROCEDURE adm-disable :
     1448       DISABLE RECT-7 RECT-5 RECT-8 RECT-6 SortType Tog-obj Classify RADIO-Nomenkl ShowZero-2 RADIO-SET-1 B-columns B-columns-2 FILL-IN-31 FILL-IN-33 FILL-IN-32 WITH FRAME F-Main.
     1449       RUN dispatch ('disable-fields':U).
     1450       RUN set-attribute-list ('ENABLED=no':U).
     1451       RETURN.
     1452   END PROCEDURE.
     1453   PROCEDURE adm-edit-attribute-list :
     1454         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
     1455         RETURN.
     1456   END PROCEDURE.
     1457   PROCEDURE adm-enable :
     1458       ENABLE UNLESS-HIDDEN RECT-7 RECT-5 RECT-8 RECT-6 SortType Tog-obj Classify RADIO-Nomenkl ShowZero-2 RADIO-SET-1 B-columns B-columns-2 FILL-IN-31 FILL-IN-33 FILL-IN-32 WITH FRAME F-Main.
     1459       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     1460       RUN set-attribute-list ('ENABLED=yes':U).
     1461       RETURN.
     1462   END PROCEDURE.
     1463   PROCEDURE adm-exit :
     1464        RUN notify ('exit':U).
     1465     RETURN.
     1466   END PROCEDURE.
     1467   PROCEDURE adm-hide :
     1468     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1469   END PROCEDURE.
     1470   PROCEDURE adm-initialize :
     1471     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1472   END PROCEDURE.
     1473   PROCEDURE adm-show-errors :
     1474       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1475       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1476           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1477       END.
     1478       RETURN.
     1479   END PROCEDURE.
     1480   PROCEDURE adm-UIB-mode :
     1481     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1482   END PROCEDURE.
     1483   PROCEDURE adm-view :
     1484     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1485   END PROCEDURE.
     1486   PROCEDURE dispatch :
     1487       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1488       RUN broker-dispatch IN adm-broker-hdl
     1489           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1490       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1491   END PROCEDURE.
     1492   PROCEDURE ensure-broker :
     1493   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1494   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1495   DO:
     1496       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1497       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1498   END.
     1499   END PROCEDURE.
     1500   PROCEDURE get-attribute :
     1501     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1502     RUN broker-get-attribute IN adm-broker-hdl
     1503         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1504     RETURN RETURN-VALUE.
     1505   END PROCEDURE.
     1506   PROCEDURE get-attribute-list :
     1507     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1508     RUN broker-get-attribute-list IN adm-broker-hdl
     1509         (INPUT THIS-PROCEDURE,
     1510          INPUT ?,
     1511          OUTPUT p-attr-list) NO-ERROR.
     1512     RETURN.
     1513   END PROCEDURE.
     1514   PROCEDURE new-state :
     1515     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1516     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1517     RETURN.
     1518   END PROCEDURE.
     1519   PROCEDURE notify :
     1520     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1521     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1522     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1523         RETURN "ADM-ERROR":U.
     1524     RETURN.
     1525   END PROCEDURE.
     1526   PROCEDURE set-attribute-list :
     1527     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1528     RUN ensure-broker.
     1529     RUN broker-set-attribute-list IN adm-broker-hdl
     1530         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1531     RETURN.
     1532   END PROCEDURE.
     1533   PROCEDURE set-position :
     1534       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1535       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1536       IF VALID-HANDLE(adm-object-hdl) THEN
     1537       DO:
     1538         ASSIGN adm-object-hdl:ROW    =   p-row
     1539                adm-object-hdl:COLUMN =   p-col.
     1540       END.
     1541       RETURN.
     1542   END PROCEDURE.
     1543   PROCEDURE adm-display-fields :
     1544       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
     1545       RETURN.
     1546   END PROCEDURE.
     1547   PROCEDURE adm-open-query :
     1548     RETURN.
     1549   END PROCEDURE.
     1550   PROCEDURE adm-row-changed :
     1551         IF VALID-HANDLE(adm-object-hdl) THEN
     1552           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1553         RUN notify ('row-available':U).
     1554         RETURN.
     1555   END PROCEDURE.
     1556   PROCEDURE reposition-query :
     1557       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
     1558       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
     1559       RETURN.
     1560   END PROCEDURE.
     1561     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
     1562     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
     1563     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
     1564     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
     1565     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
     1566     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
     1567     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
     1568     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
     1569     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1570     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
     1571     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1572     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
     1573     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
     1574     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
     1575     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
     1576     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
     1577     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
     1578     IF "":U = "":U THEN
     1579       RUN modify-list-attribute IN adm-broker-hdl
     1580         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
     1581     RUN use-create-on-add(?).
     1582   PROCEDURE adm-add-record :
     1583       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1584          "must have at least one Enabled Table to perform Add.":U
     1585          VIEW-AS ALERT-BOX ERROR.
     1586       RETURN.
     1587   END PROCEDURE.
     1588   PROCEDURE adm-assign-record :
     1589    MESSAGE
     1590          "Object ":U THIS-PROCEDURE:FILE-NAME
     1591            "must have at least one Enabled Table to perform Assign.":U
     1592              VIEW-AS ALERT-BOX ERROR.
     1593      RETURN.
     1594     END PROCEDURE.
     1595   PROCEDURE adm-assign-statement :
     1596     RETURN.
     1597   END PROCEDURE.
     1598   PROCEDURE adm-cancel-record :
     1599      RETURN.
     1600     END PROCEDURE.
     1601   PROCEDURE adm-copy-record :
     1602       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1603        "must have at least one Enabled Table to perform Copy.":U
     1604          VIEW-AS ALERT-BOX ERROR.
     1605       RETURN.
     1606   END PROCEDURE.
     1607   PROCEDURE adm-create-record :
     1608      RETURN.
     1609   END PROCEDURE.
     1610   PROCEDURE adm-current-changed :
     1611     RETURN.
     1612   END PROCEDURE.
     1613   PROCEDURE adm-delete-record :
     1614    MESSAGE
     1615          "Object ":U THIS-PROCEDURE:FILE-NAME
     1616            "must have at least one Enabled Table to perform Delete.":U
     1617              VIEW-AS ALERT-BOX ERROR.
     1618       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
     1619       RETURN.
     1620   END PROCEDURE.
     1621   PROCEDURE adm-disable-fields :
     1622         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
     1623       RETURN.
     1624   END PROCEDURE.
     1625   PROCEDURE adm-enable-fields :
     1626       RETURN.
     1627   END PROCEDURE.
     1628   PROCEDURE adm-end-update :
     1629     RETURN.
     1630   END PROCEDURE.
     1631   PROCEDURE adm-reset-record :
     1632       RETURN.
     1633   END PROCEDURE.
     1634   PROCEDURE adm-update-record :
     1635       MESSAGE
     1636         "Object ":U THIS-PROCEDURE:FILE-NAME
     1637           "must have at least one Enabled Table to perform Update.":U
     1638             VIEW-AS ALERT-BOX ERROR.
     1639      RETURN.
     1640   END PROCEDURE.
     1641   PROCEDURE check-modified :
     1642   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1643   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1644   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1645   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1646     IF check-state = "check":U THEN
     1647     DO:
     1648       RUN get-link-handle IN adm-broker-hdl
     1649         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1650            OUTPUT group-target-list).
     1651       IF group-target-list NE "":U THEN
     1652       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1653         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1654         RUN check-modified IN curr-widget ('group-check':U).
     1655         IF RETURN-VALUE NE "":U THEN
     1656         DO:
     1657           RUN check-modified-message(RETURN-VALUE).
     1658           RETURN "":U.
     1659         END.
     1660       END.
     1661     END.
     1662     RETURN "":U.
     1663   END PROCEDURE.
     1664   PROCEDURE check-modified-message :
     1665     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1666        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1667           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1668        IF RETURN-VALUE = "YES":U THEN
     1669           RUN notify ('view,CONTAINER-SOURCE':U).
     1670        MESSAGE IF p-changed-table NE ? THEN
     1671           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1672           ELSE "Current values have been changed."
     1673           SKIP "  Do you wish to save those changes?"
     1674           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1675        IF ANS THEN
     1676        DO:
     1677           IF group-assign-target THEN
     1678             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1679           ELSE RUN dispatch('update-record':U).
     1680           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1681           DO:
     1682               MESSAGE "Changes to the previous record were not saved."
     1683                 VIEW-AS ALERT-BOX ERROR.
     1684               IF group-assign-target THEN
     1685                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1686               ELSE RUN dispatch ('cancel-record':U).
     1687           END.
     1688        END.
     1689        ELSE DO:
     1690          IF group-assign-target THEN
     1691             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1692          ELSE RUN dispatch('cancel-record':U).
     1693        END.
     1694        RETURN.
     1695   END PROCEDURE.
     1696   PROCEDURE get-rowid :
     1697       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1698       ASSIGN
     1699       p-table   =   adm-first-table.
     1700       RETURN.
     1701   END PROCEDURE.
     1702   PROCEDURE init-group-assign :
     1703       RUN request-attribute IN adm-broker-hdl
     1704         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1705       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1706         group-assign-target = yes.
     1707       ELSE group-assign-target = no.
     1708       RETURN.
     1709   END PROCEDURE.
     1710   PROCEDURE set-editors :
     1711       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1712       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1713       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1714       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1715       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1716       DO WHILE VALID-HANDLE (curr-widget):
     1717           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1718              curr-widget:HIDDEN = no THEN DO:
     1719             CASE p-field-setting:
     1720               WHEN "INITIALIZE":U THEN
     1721               DO:
     1722                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1723                     read-only-list +
     1724                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1725                        STRING(curr-widget).
     1726               END.
     1727               WHEN "DISABLE":U OR
     1728               WHEN "ENABLE":U THEN
     1729               DO:
     1730                   curr-widget:SENSITIVE = yes.
     1731                   RUN get-attribute ('Read-Only-Editors':U).
     1732                   IF RETURN-VALUE = ? OR
     1733                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1734                       curr-widget:READ-ONLY =
     1735                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1736               END.
     1737               WHEN "CLEAR":U THEN
     1738                   curr-widget:SCREEN-VALUE = "":U.
     1739             END CASE.
     1740           END.
     1741           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1742       END.
     1743       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1744         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1745           + '"':U).
     1746       RETURN.
     1747   END PROCEDURE.
     1748   PROCEDURE use-check-modified-all :
     1749    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1750     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1751     RETURN.
     1752   END PROCEDURE.
     1753   PROCEDURE use-create-on-add :
     1754   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1755      RETURN.
     1756   END PROCEDURE.
     1757   PROCEDURE use-initial-lock :
     1758     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1759     ASSIGN adm-initial-lock = p-attr-value.
     1760     RETURN.
     1761   END PROCEDURE.
     1762     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1763   ASSIGN
     1764          FRAME F-Main:SCROLLABLE       = FALSE
     1765          FRAME F-Main:HIDDEN           = TRUE.
     1766   ASSIGN
     1767          RADIO-AltObj:HIDDEN IN FRAME F-Main           = TRUE.
     1768   ASSIGN
     1769          TOGGLE-1:HIDDEN IN FRAME F-Main           = TRUE.
     1770   ON CHOOSE OF B-columns IN FRAME F-Main
     1771   DO:
     1772     run rep/askfld1.w ( input 3 , input-output prod-zen, output print-o ) .
     1773   END.
     1774   ON CHOOSE OF B-columns-2 IN FRAME F-Main
     1775   DO:
     1776     run rep/askfld3.w ( input 3 , input-output prod-zen, output print-o ) .
     1777   END.
     1778   ON VALUE-CHANGED OF Classify IN FRAME F-Main
     1779   DO:
     1780     Assign Classify.
     1781       if Classify  Begins "prod":U OR
     1782          Classify  Begins "grp-goods":U OR
     1783          Classify  Begins "vat-ps":U
     1784           then
     1785           enable SumsOnly with frame F-Main .
     1786      if Classify = "no-classify":U
     1787         Then do:
     1788               SumsOnly = FALSE .
     1789               display SumsOnly with frame F-Main .
     1790               disable SumsOnly with frame F-Main .
     1791           end.
     1792      if Classify = "grp-goods":U
     1793            Then do:
     1794               display TOG-lavel   with frame F-Main .
     1795               enable  TOG-lavel   with frame F-Main .
     1796           end.
     1797            Else do:
     1798               display  TOG-lavel  var-Lavel tog-tree with frame F-Main .
     1799               disable  TOG-lavel  var-Lavel tog-tree with frame F-Main .
     1800           end.
     1801   END.
     1802   ON VALUE-CHANGED OF RADIO-AltObj IN FRAME F-Main
     1803   DO:
     1804     assign RADIO-AltObj .
     1805     assign AltObj-list = "" .
     1806     if RADIO-AltObj = 3 then do:
     1807       define variable v-user-select as logical   no-undo .
     1808   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1809   run userobjs_select-many in this-procedure
     1810     (input  my-handle
     1811     ,input  v-cntxt-db-num
     1812     ,input  v-cntxt-userid
     1813     ,input  v-cntxt-host-code-obj
     1814     ,input  v-cntxt-obj-type
     1815     ,input  v-cntxt-obj-code
     1816     ,output v-user-select
     1817     )  .
     1818       if v-user-select <> true then do:
     1819         assign RADIO-AltObj = 1 .
     1820         display RADIO-AltObj with frame F-Main .
     1821       end.
     1822       else do:
     1823         define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1824         for each buf_userobjs_temp-user-obj :
     1825           if AltObj-list = "" then
     1826             assign  AltObj-list = AltObj-list + buf_userobjs_temp-user-obj.obj-type + "," + string(buf_userobjs_temp-user-obj.obj-code) .
     1827           else
     1828             assign  AltObj-list = AltObj-list + "," + buf_userobjs_temp-user-obj.obj-type + "," + string(buf_userobjs_temp-user-obj.obj-code) .
     1829         end.
     1830       end.
     1831     end.
     1832   END.
     1833   ON VALUE-CHANGED OF ShowZero-2 IN FRAME F-Main
     1834   DO:
     1835       assign ShowZero-2.
     1836     if ShowZero-2 = no then do:
     1837        ShowZero = no .
     1838        display ShowZero with frame F-Main .
     1839        disable ShowZero with frame F-Main .
     1840     end.
     1841     else enable ShowZero with frame F-Main .
     1842   END.
     1843   ON VALUE-CHANGED OF Tog-lavel IN FRAME F-Main
     1844   DO:
     1845     if tog-lavel:screen-value = string(TRUE)
     1846           Then do:
     1847               display  var-Lavel tog-tree with frame F-Main .
     1848               enable   var-Lavel tog-tree with frame F-Main .
     1849           end.
     1850            Else do:
     1851               assign tog-tree = no .
     1852               display    var-Lavel tog-tree with frame F-Main .
     1853               disable    var-Lavel tog-tree with frame F-Main .
     1854           end.
     1855   END.
     1856   ON VALUE-CHANGED OF Tog-tree IN FRAME F-Main
     1857   DO:
     1858     if tog-tree:screen-value=string(TRUE)
     1859           Then do:
     1860               SumsOnly = true.
     1861               display    SumsOnly with frame F-Main .
     1862               disable    SumsOnly with frame F-Main .
     1863           end.
     1864            Else do:
     1865               display  SumsOnly  with frame F-Main .
     1866               enable   SumsOnly  with frame F-Main .
     1867           end.
     1868   END.
     1869   if not this-procedure :persistent
     1870   then do:
     1871     message
     1872       vss-workfile vss-revision vss-description skip
     1873       "Ошибка при запуске процедуры" skip
     1874       "Данную процедуру следует запускать только с параметром persistent" skip
     1875       view-as alert-box error .
     1876     undo, return error .
     1877   end.
     1878   PROCEDURE disable_UI :
     1879     HIDE FRAME F-Main.
     1880     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1881   END PROCEDURE.
     1882   PROCEDURE local-apply-layout :
     1883     RUN dispatch IN THIS-PROCEDURE ( INPUT 'apply-layout':U ) .
     1884   END PROCEDURE.
     1885   PROCEDURE local-initialize :
     1886   define variable l-ind as integer no-undo .
     1887   define variable glog as logical no-undo .
     1888     RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     1889     Tog-obj:screen-value in frame F-Main = string(True).
     1890     var-lavel:screen-value in frame F-Main = '1'.
     1891   repeat l-ind = 1 to 118 :
     1892      use-column[ l-ind ] =  false .
     1893   end.
     1894    find first ubflt.usr-flt share-lock
     1895      where ubflt.usr-flt.user-name  = v-cntxt-userid
     1896        and ubflt.usr-flt.call-point = "e-obort1":U
     1897      no-error .
     1898    if not avail ubflt.usr-flt then do:
     1899       run rep/askfld1.w ( input 0, input-output prod-zen, output print-o ).
     1900    end.
     1901    else do:
     1902      repeat l-ind = 1 to 96 :
     1903           if lookup(string(l-ind) , ubflt.usr-flt.list ) > 0 then use-column[ l-ind ] = true .
     1904      end.
     1905    end.
     1906    find first ubflt.usr-flt share-lock
     1907      where ubflt.usr-flt.user-name  = v-cntxt-userid
     1908        and ubflt.usr-flt.call-point = "e-obort3":U
     1909      no-error .
     1910    if not avail ubflt.usr-flt then do:
     1911       run rep/askfld3.w ( input 3, input-output prod-zen, output print-o ).
     1912    end.
     1913    else do:
     1914      repeat l-ind = 97 to 118 :
     1915           if lookup( string(l-ind) , ubflt.usr-flt.list ) > 0 then use-column[ l-ind ] = true .
     1916      end.
     1917    end.
     1918      run get-gds-engl   in my-handle ( output g#gds-engl ) .
     1919      if g#gds-engl then assign RADIO-SET-1 = 2 .
     1920      ShowZero-2 = true .
     1921    display ShowZero-2 FILL-IN-31 FILL-IN-32 FILL-IN-33 RADIO-SET-1 with frame F-Main .
     1922   END PROCEDURE.
     1923   PROCEDURE my-report :
     1924   define variable sz-qnty      as integer initial 3  no-undo .
     1925     define variable v-fact-order-start   as decimal   no-undo .
     1926     define variable v-fact-order-end     as decimal   no-undo .
     1927   if x-date-end < today then do:
     1928     if use-column[89] or use-column[90] or use-column[91] or use-column[92] or use-column[93] or use-column[94] or use-column[95] or use-column[96] then do:
     1929       message "Данные по резервам можно корректно рассчитать только на текущую дату!" view-as alert-box.
     1930       assign
     1931         use-column[89] = no
     1932         use-column[90] = no
     1933         use-column[91] = no
     1934         use-column[92] = no
     1935         use-column[93] = no
     1936         use-column[94] = no
     1937         use-column[95] = no
     1938         use-column[96] = no
     1939       .
     1940     end.
     1941   end.
     1942   run rep/r-obort1.p  (
     1943      input ShowZero       ,
     1944      input ShowZero-2     ,
     1945      input RADIO-Nomenkl  ,
     1946      input Tog-obj        ,
     1947      input Classify       ,
     1948      input RADIO-AltObj   ,
     1949      input AltObj-list    ,
     1950      input SortType       ,
     1951      input prod-zen       ,
     1952      input "to-file"      ,
     1953      input SumsOnly       ,
     1954      input tog-lavel      ,
     1955      input var-lavel      ,
     1956      input tog-tree       ,
     1957      input RADIO-SET-1    ,
     1958      input no-nds         ,
     1959      input TOGGLE-1       ,
     1960      input sz-qnty        ,
     1961      input "parts"
     1962     ).
     1963   END PROCEDURE.
     1964   PROCEDURE my-var :
     1965   Assign frame F-Main SumsOnly ShowZero tog-obj Classify SortType RADIO-SET-1  TOGGLE-1
     1966                 ShowZero-2 tog-lavel var-lavel tog-tree RADIO-Nomenkl  no-nds .
     1967    RADIO-AltObj = 1.
     1968   Assign
     1969    STR-obj-type = ''
     1970    STR-obj-code = ''
     1971    STR-obj-name = ''
     1972    STR-obj      = ''
     1973    str4  = ""
     1974   .
     1975   For each obj-list no-lock:
     1976    Assign
     1977    STR-obj-type = STR-obj-type + obj-list.obj-type + ','
     1978    STR-obj-code = STR-obj-code + String(obj-list.obj-code) + ','
     1979    STR-obj-name = STR-obj-name + obj-list.obj-name + ','
     1980    STR-obj = STR-obj +  obj-list.obj-type + '#' + string(obj-list.obj-code)  + ','
     1981    str4   = STR-obj
     1982   .
     1983   End.
     1984   def var t-class as char no-undo.
     1985   def var t-sort as char no-undo.
     1986     case classify:
     1987       when "no-classify":u    then t-class =   "Без классификации" .
     1988       when "prod":u           then t-class =   "Производители"   .
     1989       when "post":u           then t-class =   "Поставщики"   .
     1990       when "grp-goods":u      then t-class =   "Группы товаров"  .
     1991       when "post/grp-goods":u then t-class =   "Поставщики/Группы товаров" .
     1992       when "prod/grp-goods":u then t-class =   "Производители/Группы товаров" .
     1993       when "grp-goods/prod":u then t-class =   "Группы товаров/Производители" .
     1994       when "grp-goods/post":u then t-class =   "Группы товаров/Поставщики" .
     1995       when  "vat-ps":u        then t-class =   "Ставка НДС" .
     1996       when  "sort":u          then t-class =   "Проба(Сорт)" .
     1997       when  "n-level":u       then t-class =   "Группы с уровнем вложенности " .
     1998       when  "t-level":u       then t-class =   "Терминальные группы" .
     1999    end case.
     2000     case sorttype:
     2001       when "sort-pp":u               then t-sort =   "по порядку" .
     2002       when "sort-code":u             then t-sort =   "по коду" .
     2003       when "sort-artic":u            then t-sort =   "по артикулу"  .
     2004       when "sort-qunty":u            then t-sort =   "по реализации".
     2005       when "sort-name":u             then t-sort =   "по наименованию".
     2006       when "sort-type":u             then t-sort =   "по типу ткани".
     2007       when "sort-doc-code":u         then t-sort =   "по номеру документа".
     2008       when "sort-recipe-code":u      then t-sort =   "по номеру рецепта".
     2009    end case.
     2010   ReportHeader =  ReportHeader +  str1.
     2011   ReportHeader =  ReportHeader +  "Классификация : " + t-Class.
     2012   ReportHeader = ReportHeader + (if tog-lavel  then "    Итоги с уровня  "  + String(var-lavel)  else " "    ).
     2013   ReportHeader = ReportHeader  + chr(10).
     2014   ReportHeader = ReportHeader  + "Выбор цен: " + (if x-SET_val_TYPE = 1 then "рублевые" else "валютные" ) + chr(10).
     2015    assign
     2016      str3 = ""
     2017      str11 = "Показать : " +
     2018            (if SumsOnly     then " только итоги, "             else " " ) +
     2019            (if no-nds       then " учет. цены без НДС, "         else " " ) +
     2020            (if tog-tree     then " группировка в виде дерева, "   else " " ) +
     2021            (if Tog-obj      then " раздельно по объектам, "  else " " ) +
     2022            (if ShowZero     then " показывать нулевые остатки, "  else " не показывать нулевые остатки, " ) +
     2023            (if ShowZero-2   then " показывать нулевые обороты "  else " не показывать нулевые обороты " ).
     2024    .
     2025    ReportHeader = ReportHeader + "Сортировка " + t-Sort  + chr(10) + str11 + chr(10) .
     2026    case RADIO-Nomenkl :
     2027      when 1 then str2 =  "Номенклатура : Вся".
     2028      when 2 then str2 =  "Номенклатура : Текущая" .
     2029      when 3 then str2 =  "Номенклатура : Удаленная" .
     2030    end case .
     2031    ReportHeader = ReportHeader + str2 +  chr(10).
     2032    if RADIO-AltObj > 1 then do:
     2033      if RADIO-AltObj = 2 then ReportHeader = ReportHeader + "Альтернативные объекты : Все " .
     2034      else do:
     2035        define buffer buf_clients  for ub.clients .
     2036        define variable ii as integer   no-undo .
     2037        define variable p-num as integer   no-undo .
     2038        assign str3 =  "Альтернативные объекты: " .
     2039        assign p-num = num-entries( AltObj-list ) .
     2040        do ii = 1 to p-num by 2 :
     2041          find first buf_clients no-lock
     2042            where buf_clients.obj-type = entry( ii, AltObj-list )
     2043              and buf_clients.obj-code = integer( entry( ii + 1 , AltObj-list ))
     2044          .
     2045          str3 = str3 + buf_clients.obj-name + " (" + buf_clients.obj-type + '#' + string(buf_clients.obj-code) + ")"  + ", " .
     2046        end.
     2047      end.
     2048    end.
     2049   if tog-tree and (use-column [1] = false OR use-column [2] = false) then  do:
     2050      message "Для получения отчета с группировкой по дереву должны быть выбраны колонки  Код и Артикул !" view-as alert-box .
     2051   return error.
     2052   end.
     2053   END PROCEDURE.
     2054   PROCEDURE state-changed :
     2055     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     2056     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     2057     CASE p-state:
     2058       when "link-changed":U then  DO:
     2059            Run my-var.
     2060            End.
     2061     END CASE.
     2062   END PROCEDURE.
