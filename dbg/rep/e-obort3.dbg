      570   define variable var-report-r-b as character no-undo .
      571   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      572   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      573     (output var-report-r-b
      574     )  .
      575   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      576   procedure factord :
      577     define input  parameter p-fact-date            as date    no-undo .
      578     define input  parameter p-fact-time            as integer no-undo .
      579     define input  parameter p-fact-num             as integer no-undo .
      580     define input  parameter p-shift-date           as date    no-undo .
      581     define input  parameter p-shift-num            as integer no-undo .
      582     define input  parameter p-shift-on             as logical no-undo .
      583     define output parameter p-fact-order           as decimal no-undo .
      584     define output parameter p-shift-end-fact-order as decimal no-undo .
      585     define output parameter p-day-end-fact-order   as decimal no-undo .
      586     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      587     if p-fact-date = ?
      588     then do:
      589       return error "Не указана фактическая дата" .
      590     end.
      591     define variable v-fact-date-num as integer no-undo .
      592     assign
      593       v-fact-date-num = integer(p-fact-date)
      594     .
      595     if p-fact-num = ?
      596     or p-fact-num = 0
      597     then do:
      598       return error "Не задан p-fact-num " + string(p-fact-num) .
      599     end.
      600     if p-fact-num < 0
      601     then do:
      602       return error "Отрицательный fact-num " + string(p-fact-num) .
      603     end.
      604     if p-fact-num >= 100000000
      605     then do:
      606       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      607     end.
      608     if p-shift-on = true
      609     then do:
      610       if p-shift-date = ?
      611       then do:
      612         return error "Не задана дата смены" .
      613       end.
      614       if p-shift-num = ?
      615       or p-shift-num = 0
      616       then do:
      617         return error "Не задан номер смены" .
      618       end.
      619     end.
      620     else do:
      621       assign
      622         p-shift-date = p-fact-date
      623         p-shift-num  = 24
      624       .
      625     end.
      626     define variable v-shift-offset as integer no-undo .
      627     if p-shift-date = p-fact-date
      628     then do:
      629       assign
      630         v-shift-offset = 1
      631       .
      632     end.
      633     if p-shift-date < p-fact-date
      634     then do:
      635       assign
      636         v-shift-offset = 0
      637       .
      638     end.
      639     if p-shift-date > p-fact-date
      640     then do:
      641       message
      642         vss-workfile vss-revision vss-description skip
      643         "Неправильная дата закрытия смены" skip
      644         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      645         view-as alert-box error .
      646       undo, return error
      647         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      648           ,string(p-fact-date, '99/99/9999':U)
      649           ,string(p-shift-date, '99/99/9999':U)
      650           )
      651       .
      652     end.
      653     if p-shift-num < 1
      654     or p-shift-num > 24
      655     then do:
      656       message
      657         vss-workfile vss-revision vss-description skip
      658         "Неправильный номер смены" skip
      659         "p-shift-num" p-shift-num skip
      660         view-as alert-box error .
      661       undo, return error return-value .
      662     end.
      663     assign
      664       p-fact-order           = v-fact-date-num
      665                              + v-shift-offset * 0.5
      666                              + p-shift-num    * 0.02 - 0.01
      667                              + p-fact-num     * 0.0000000001
      668       p-shift-end-fact-order = v-fact-date-num
      669                              + v-shift-offset * 0.5
      670                              + p-shift-num    * 0.02
      671       p-day-end-fact-order   = v-fact-date-num
      672                              + 0.99
      673     .
      674     if p-fact-order           <= v-fact-date-num
      675     or p-shift-end-fact-order <= v-fact-date-num
      676     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      677     or p-shift-end-fact-order >= p-day-end-fact-order
      678     then do:
      679       message
      680         vss-workfile vss-revision vss-description skip
      681         "Внутренняя ошибка при генерации фактического номера" skip
      682         "p-fact-date"            p-fact-date            skip
      683         "p-fact-time"            p-fact-time            skip
      684         "p-fact-num"             p-fact-num             skip
      685         "p-shift-date"           p-shift-date           skip
      686         "p-shift-num"            p-shift-num            skip
      687         "p-shift-on"             p-shift-on             skip
      688         "p-shift-end-fact-order" p-shift-end-fact-order skip
      689         "p-day-end-fact-order"   p-day-end-fact-order   skip
      690         "v-fact-date-num"        v-fact-date-num        skip
      691         view-as alert-box error .
      692       undo, return error return-value .
      693     end.
      694   end procedure.
      695   procedure day-begin-fact-order :
      696     define input  parameter p-fact-date            as date    no-undo .
      697     define output parameter p-day-begin-fact-order as decimal no-undo .
      698     do
      699     on error undo, return error return-value
      700     :
      701       if p-fact-date = ?
      702       then do:
      703         assign
      704           p-day-begin-fact-order = 0
      705         .
      706       end.
      707       else do:
      708         assign
      709           p-day-begin-fact-order = integer(p-fact-date)
      710         .
      711       end.
      712     end.
      713   end procedure.
      714   procedure factord-max-fact-order :
      715     define output parameter p-max-fact-order as decimal   no-undo .
      716     do
      717     on error undo, return error return-value
      718     :
      719       run day-begin-fact-order in this-procedure
      720         (input  date(1, 1, 5000)
      721         ,output p-max-fact-order
      722         ) .
      723     end.
      724   end procedure.
      725   procedure factord-cut-archive :
      726     define input  parameter p-obj-type             as character no-undo .
      727     define input  parameter p-obj-code             as integer   no-undo .
      728     define input  parameter p-fact-date            as date      no-undo .
      729     define output parameter p-shift-on             as logical   no-undo .
      730     define output parameter p-shift-date           as date      no-undo .
      731     define output parameter p-shift-num            as integer   no-undo .
      732     define output parameter p-day-end-fact-order   as decimal   no-undo .
      733     define output parameter p-shift-end-fact-order as decimal   no-undo .
      734     define variable v-fact-order as decimal   no-undo .
      735     define buffer buf_shift-obj for ub.shift-obj .
      736     do
      737     on error undo, return error return-value
      738     :
      739   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      740   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      741     (input  p-obj-type
      742     ,input  p-obj-code
      743     ,input  'shift-on=request'
      744     ,output p-shift-on
      745     ) no-error .
      746       if error-status :error
      747       then do:
      748         message
      749           vss-workfile vss-revision vss-description skip
      750           "Ошибка при определении атрибута объекта" skip
      751           "Объект" p-obj-type p-obj-code skip
      752           error-status :get-message(1) skip
      753           return-value skip
      754           view-as alert-box error .
      755         undo, return error return-value .
      756       end.
      757       if p-shift-on = false
      758       then do:
      759         assign
      760           p-shift-date               = ?
      761           p-shift-num                = 0
      762         .
      763       end.
      764       else do:
      765         find first buf_shift-obj share-lock
      766           where buf_shift-obj.obj-type   = p-obj-type
      767             and buf_shift-obj.obj-code   = p-obj-code
      768             and buf_shift-obj.shift-date > p-fact-date
      769           use-index pi
      770           no-error .
      771         if not available buf_shift-obj
      772         or buf_shift-obj.status_ <> 'зкр':U
      773         then do:
      774           message
      775             vss-workfile vss-revision vss-description skip
      776             "Невозможно вычислить последнюю смену" skip
      777             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      778             "Объект" p-obj-type p-obj-code skip
      779             "Дата" p-fact-date skip
      780             view-as alert-box error .
      781           undo, return error return-value .
      782         end.
      783         find last buf_shift-obj share-lock
      784           where buf_shift-obj.obj-type = p-obj-type
      785             and buf_shift-obj.obj-code = p-obj-code
      786             and buf_shift-obj.shift-date <= p-fact-date
      787           use-index pi
      788           no-error .
      789         if available buf_shift-obj
      790         then do:
      791           if  buf_shift-obj.status_ = 'зкр':U
      792           then do:
      793             assign
      794               p-shift-date = buf_shift-obj.shift-date
      795               p-shift-num  = buf_shift-obj.shift-num
      796             .
      797           end.
      798           else do:
      799             message
      800               vss-workfile vss-revision vss-description skip
      801               "Невозможно вычислить последнюю смену" skip
      802               "Статус смены отличен от статуса" 'зкр':U skip
      803               "Объект" p-obj-type p-obj-code skip
      804               "Дата" p-fact-date skip
      805               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      806               view-as alert-box error .
      807             undo, return error return-value .
      808           end.
      809         end.
      810         else do:
      811           assign
      812             p-shift-date = p-fact-date - 1
      813             p-shift-num  = 1
      814           .
      815         end.
      816       end.
      817       run factord in this-procedure
      818         (input  p-fact-date
      819         ,input  1
      820         ,input  1
      821         ,input  p-shift-date
      822         ,input  p-shift-num
      823         ,input  p-shift-on
      824         ,output v-fact-order
      825         ,output p-shift-end-fact-order
      826         ,output p-day-end-fact-order
      827         ) no-error .
      828       if error-status :error
      829       then do:
      830         message
      831           vss-workfile vss-revision vss-description skip
      832           "Ошибка при вызове процедуры factord"
      833           error-status :get-message(1) skip
      834           return-value skip
      835           view-as alert-box error .
      836         undo, return error return-value .
      837       end.
      838     end.
      839   end procedure.
      840   procedure factord-lock-shift :
      841     define input  parameter p-obj-type  as character no-undo .
      842     define input  parameter p-obj-code  as integer   no-undo .
      843     define input  parameter p-fact-date as date      no-undo .
      844     define parameter buffer buf_shift-obj for ub.shift-obj .
      845     define variable v-shift-on      as logical   no-undo .
      846     define variable v-extra-message as character no-undo .
      847     define variable v-error as character no-undo .
      848     do
      849     on error undo, return error return-value
      850     :
      851   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      852   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      853     (input  p-obj-type
      854     ,input  p-obj-code
      855     ,input  'shift-on=request'
      856     ,output v-shift-on
      857     ) no-error .
      858       if error-status :error
      859       then do:
      860         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      861         undo, return error v-error .
      862       end.
      863       if v-shift-on = true
      864       then do:
      865         find first buf_shift-obj share-lock
      866           where buf_shift-obj.obj-type   = p-obj-type
      867             and buf_shift-obj.obj-code   = p-obj-code
      868             and buf_shift-obj.shift-date > p-fact-date
      869           use-index pi
      870           no-error .
      871         if not available buf_shift-obj
      872         or buf_shift-obj.status_ <> 'зкр':U
      873         then do:
      874           find last buf_shift-obj
      875             where buf_shift-obj.obj-type = p-obj-type
      876               and buf_shift-obj.obj-code = p-obj-code
      877               and buf_shift-obj.status_  = 'зкр':U
      878             use-index stts
      879             no-error .
      880           if available buf_shift-obj
      881           then do:
      882             assign
      883               v-extra-message =
      884                     substitute("Дата начала последеней закрытой смены на объекте &1"
      885                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      886                               )
      887             .
      888           end.
      889           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      890           undo, return error v-error .
      891         end.
      892       end.
      893     end.
      894   end procedure.
      895   procedure factord-end-day :
      896     define input  parameter p-fact-date            as date    no-undo .
      897     define output parameter p-day-end-fact-order   as decimal no-undo .
      898     do
      899     on error undo, return error return-value
      900     :
      901       if p-fact-date = ?
      902       then do:
      903         return error "Не указана фактическая дата" .
      904       end.
      905       assign
      906         p-day-end-fact-order = integer(p-fact-date) + 0.99
      907       .
      908     end.
      909   end procedure.
      910   procedure factord-to-date :
      911     define input  parameter p-fact-order as decimal no-undo .
      912     define output parameter p-fact-date  as date    no-undo .
      913     define variable v-ref-date  as date      no-undo .
      914     define variable v-ref-delta as integer   no-undo .
      915     do
      916     on error undo, return error return-value
      917     :
      918       if p-fact-order = ?
      919       or p-fact-order = 0
      920       then do:
      921         return error "Не указан fact-order" .
      922       end.
      923       assign
      924         v-ref-date  = date(1, 1, 2000)
      925       .
      926       assign
      927         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      928       .
      929       assign
      930         p-fact-date = v-ref-date + v-ref-delta
      931       .
      932     end.
      933   end procedure.
      934   procedure factord-to-fact-num :
      935     define input  parameter p-fact-order as decimal no-undo .
      936     define output parameter p-fact-num   as integer no-undo .
      937     define variable v-fact-order-trunc as decimal no-undo .
      938     do
      939     on error undo, return error return-value
      940     :
      941       if p-fact-order = ?
      942       or p-fact-order = 0
      943       then do:
      944         return error "Не указан fact-order" .
      945       end.
      946       assign
      947        v-fact-order-trunc = truncate(p-fact-order, 2)
      948       .
      949       assign
      950         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      951       .
      952     end.
      953   end procedure.
      954   procedure factord-to-shift-num :
      955     define input  parameter p-fact-order as decimal no-undo .
      956     define output parameter p-shift-num   as integer no-undo .
      957     define variable  p-shift-numd  as decimal   no-undo .
      958     define variable v-fact-order-trunc as decimal no-undo .
      959     do
      960     on error undo, return error return-value
      961     :
      962       if p-fact-order = ?
      963       or p-fact-order = 0
      964       then do:
      965         return error "Не указан fact-order" .
      966       end.
      967       assign
      968        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      969       .
      970       if v-fact-order-trunc < 0.5 then do:
      971         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      972       end.
      973       assign
      974         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      975         .
      976        assign
      977         p-shift-num = truncate (p-shift-numd , 0)
      978       .
      979     end.
      980   end procedure.
      981   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      982   procedure proc-alt-shift-f2:
      983     if not ibs.th.gbl.gbl-var:rcode
      984   then
      985     run gbl\inidebug.p .
      986   end.
      987   procedure proc-alt-shift-f3:
      988     run gbl/prvssinf.p
      989       ( input this-procedure
      990       ) .
      991   end.
      992   define variable v-inform-launched as logical no-undo initial false .
      993   procedure proc-alt-shift-f4:
      994     define variable v-action as character no-undo .
      995     if v-inform-launched = false then do:
      996       assign
      997         v-inform-launched = true
      998       .
      999       run gbl/d-inform.w
     1000         (  input self
     1001         ,  input this-procedure
     1002         , output v-action
     1003         ) no-error .
     1004       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
     1005       assign
     1006         v-inform-launched = false
     1007       .
     1008     end.
     1009   end.
     1010   procedure proc-alt-f1:
     1011     run gbl/corrhelp.p
     1012       (input this-procedure
     1013       ) .
     1014   end .
     1015   on alt-shift-f2 anywhere do:
     1016     run proc-alt-shift-f2.
     1017   end.
     1018   on alt-shift-f3 anywhere do:
     1019     run proc-alt-shift-f3 in this-procedure .
     1020   end.
     1021   on alt-shift-f4 anywhere do:
     1022     run proc-alt-shift-f4 in this-procedure.
     1023   end.
     1024   on alt-f1 anywhere do:
     1025     run proc-alt-f1 in this-procedure .
     1026   end.
     1027   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1028     define variable v-cntxt-db-num        as integer   no-undo .
     1029     define variable v-cntxt-userid        as character no-undo .
     1030     define variable v-cntxt-level         as character no-undo .
     1031     define variable v-cntxt-host-code-obj as integer   no-undo .
     1032     define variable v-cntxt-obj-type      as character no-undo .
     1033     define variable v-cntxt-obj-code      as integer   no-undo .
     1034     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1035     define variable v-cntxt-is-admin      as logical   no-undo .
     1036   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1037     run mainmenu_getcntxt in my-handle
     1038       (output v-cntxt-db-num
     1039       ,output v-cntxt-userid
     1040       ,output v-cntxt-level
     1041       ,output v-cntxt-host-code-obj
     1042       ,output v-cntxt-obj-type
     1043       ,output v-cntxt-obj-code
     1044       ,output v-cntxt-db-num-obj
     1045       ,output v-cntxt-is-admin
     1046       ) .
     1047   define variable base-type as character no-undo .
     1048   define variable base-code as integer   no-undo .
     1049   define variable g#report-num as integer   no-undo .
     1050   define variable g#gds-engl as logical   no-undo .
     1051   define variable vv-exch-rate  as decimal   no-undo .
     1052   define variable vv-exch-scale as decimal   no-undo .
     1053   define variable v-cntxt-host-name-obj as character no-undo .
     1054   if v-cntxt-level = 'object':U then do:
     1055   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1056   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostname in g#library
     1057     (input  v-cntxt-obj-type
     1058     ,input  v-cntxt-obj-code
     1059     ,output v-cntxt-host-code-obj
     1060     ,output v-cntxt-host-name-obj
     1061     )  .
     1062   end.
     1063   if v-cntxt-level = 'firm':U then do:
     1064     find first ub.clients no-lock where
     1065                ub.clients.obj-type = 'орг':U and
     1066                ub.clients.obj-code = v-cntxt-host-code-obj no-error .
     1067   if error-status :error then v-cntxt-host-name-obj = ? .
     1068      else v-cntxt-host-name-obj = ub.clients.obj-name.
     1069   end.
     1070   if v-cntxt-level = 'object':U
     1071   or v-cntxt-level = 'firm':U
     1072   then do:
     1073   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1074   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     1075     (input  v-cntxt-host-code-obj
     1076     ,output base-code
     1077     )  .
     1078   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1079   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     1080     (input  base-code
     1081     ,input  today
     1082     ,output vv-exch-rate
     1083     ,output vv-exch-scale
     1084     ,output base-type
     1085     )  .
     1086   end.
     1087   run get-report-num in my-handle ( output g#report-num ).
     1088   run get-gds-engl in my-handle ( output g#gds-engl ) .
     1089   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1090   define temp-table userobjs_temp-user-obj no-undo
     1091     field obj-type as character
     1092     field obj-code as integer
     1093     index xpk is primary unique obj-type obj-code
     1094     .
     1095   procedure userobjs_clear :
     1096     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1097     do
     1098     on error undo, return error return-value
     1099     :
     1100       for each buf_userobjs_temp-user-obj
     1101       on error undo, return error return-value
     1102       :
     1103         delete buf_userobjs_temp-user-obj .
     1104       end.
     1105     end.
     1106   end .
     1107   procedure userobjs_object-count :
     1108     define output parameter p-total-count as integer   no-undo .
     1109     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1110     do
     1111     on error undo, return error return-value
     1112     :
     1113       assign
     1114         p-total-count = 0
     1115       .
     1116       for each buf_userobjs_temp-user-obj
     1117       on error undo, return error return-value
     1118       :
     1119         assign
     1120           p-total-count = p-total-count + 1
     1121         .
     1122       end.
     1123     end.
     1124   end.
     1125   procedure userobjs_append :
     1126      define input  parameter p-obj-type as character no-undo .
     1127      define input  parameter p-obj-code as integer   no-undo .
     1128     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1129     do
     1130     on error undo, return error return-value
     1131     :
     1132       find first buf_userobjs_temp-user-obj
     1133         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
     1134           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
     1135         no-error .
     1136       if not available buf_userobjs_temp-user-obj
     1137       then do:
     1138         create buf_userobjs_temp-user-obj .
     1139         assign
     1140           buf_userobjs_temp-user-obj.obj-type = p-obj-type
     1141           buf_userobjs_temp-user-obj.obj-code = p-obj-code
     1142         .
     1143       end.
     1144     end.
     1145   end.
     1146   procedure userobjs_object-exist :
     1147     define output parameter p-object-exist as logical   no-undo .
     1148     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1149     do
     1150     on error undo, return error return-value
     1151     :
     1152       find first buf_userobjs_temp-user-obj
     1153         no-error .
     1154       if not available buf_userobjs_temp-user-obj
     1155       then do:
     1156         assign
     1157           p-object-exist = false
     1158         .
     1159       end.
     1160       else do:
     1161         assign
     1162           p-object-exist = true
     1163         .
     1164       end.
     1165     end.
     1166   end.
     1167   procedure userobjs_transfer :
     1168     define input  parameter p-callback-handle as handle no-undo .
     1169     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
     1170     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1171     do
     1172     on error undo, return error return-value
     1173     :
     1174       if valid-handle(p-callback-handle) <> true
     1175       then do:
     1176         message
     1177           vss-workfile vss-revision vss-description skip
     1178           "Ошибка задания входных параметров" skip
     1179           "Неизвестный указатель на процедуру" skip
     1180           view-as alert-box error .
     1181         undo, return error return-value .
     1182       end.
     1183       if p-callback-handle :get-signature("userobjs_append") = ""
     1184       then do:
     1185         message
     1186           vss-workfile vss-revision vss-description skip
     1187           "Ошибка задания входных параметров" skip
     1188           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
     1189                     ,p-callback-handle :file-name
     1190                     ) skip
     1191           view-as alert-box error .
     1192         undo, return error return-value .
     1193       end.
     1194       for each buf_userobjs_temp-user-obj
     1195       on error undo, return error return-value
     1196       :
     1197         run userobjs_append in p-callback-handle
     1198           (input  buf_userobjs_temp-user-obj.obj-type
     1199           ,input  buf_userobjs_temp-user-obj.obj-code
     1200           ) .
     1201       end.
     1202     end.
     1203   end procedure.
     1204   procedure userobjs_select-one :
     1205      define input  parameter parparentproc     as widget-handle no-undo .
     1206      define input  parameter p-db-num          as integer   no-undo .
     1207      define input  parameter p-user-id         as character no-undo .
     1208      define input  parameter p-host-code-obj   as integer   no-undo .
     1209      define input  parameter p-obj-type        as character no-undo .
     1210      define input  parameter p-obj-code        as integer   no-undo .
     1211      define output parameter p-user-select     as logical   no-undo .
     1212      define output parameter p-select-obj-type as character no-undo .
     1213      define output parameter p-select-obj-code as character no-undo .
     1214     do
     1215     on error undo, return error return-value
     1216     :
     1217       run gbl/userobjs.w
     1218         (input  parparentproc
     1219         ,input  this-procedure :handle
     1220         ,input  p-db-num
     1221         ,input  p-user-id
     1222         ,input  p-host-code-obj
     1223         ,input  p-obj-type
     1224         ,input  p-obj-code
     1225         ,INPUT  "b-sel"
     1226         ,output p-user-select
     1227         ,output p-select-obj-type
     1228         ,output p-select-obj-code
     1229         ) .
     1230     end.
     1231   end.
     1232   procedure userobjs_select-many :
     1233     define input  parameter parparentproc   as widget-handle no-undo .
     1234     define input  parameter p-db-num        as integer   no-undo .
     1235     define input  parameter p-user-id       as character no-undo .
     1236     define input  parameter p-host-code-obj as integer   no-undo .
     1237     define input  parameter p-obj-type      as character no-undo .
     1238     define input  parameter p-obj-code      as integer   no-undo .
     1239     define output parameter p-user-select   as logical   no-undo .
     1240     define variable v-select-obj-type as character no-undo .
     1241     define variable v-select-obj-code as integer   no-undo .
     1242     do
     1243     on error undo, return error return-value
     1244     :
     1245       run gbl/userobjs.w
     1246         (input  parparentproc
     1247         ,input  this-procedure :handle
     1248         ,input  p-db-num
     1249         ,input  p-user-id
     1250         ,input  p-host-code-obj
     1251         ,input  p-obj-type
     1252         ,input  p-obj-code
     1253         ,INPUT  "b-sel,b-mark"
     1254         ,output p-user-select
     1255         ,output v-select-obj-type
     1256         ,output v-select-obj-code
     1257         ) .
     1258     end.
     1259   end.
     1260   procedure thobjs :
     1261      define input        parameter parparentproc     as widget-handle no-undo .
     1262      define input        parameter i-bttns           as character     no-undo .
     1263      define input        parameter i-list-mode       as character     no-undo.
     1264      define input        parameter i-obj-type        as character     no-undo.
     1265      define input        parameter i-db-num          as integer       no-undo.
     1266      define input        parameter i-host-code       as integer       no-undo.
     1267      define input-output parameter p-rid-list        as character     no-undo .
     1268   run ref/thobjs.p
     1269           ( input parparentproc
     1270            ,input  this-procedure :handle
     1271           , input i-bttns
     1272           , input i-list-mode
     1273           , input i-obj-type
     1274           , input i-db-num
     1275           , input i-host-code
     1276           , input-output p-rid-list ) no-error .
     1277   end.
