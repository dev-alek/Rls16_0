     4175          for each temp-parts no-lock where temp-parts.fact-qnty <> 0:
     4176             if RADIO-SUPPLIER = 2 and
     4177             not can-find(first alc-suppliers where alc-suppliers.obj-type = temp-parts.supp-type
     4178                                                and alc-suppliers.obj-code = temp-parts.supp-code)
     4179             then next.
     4180             v-inner-code = ? .
     4181             if num-entries(temp-parts.alc-ref-ab-path) = 4 and entry(4, temp-parts.alc-ref-ab-path) <> "" then do :
     4182               find first alc-types no-lock where trim(alc-types.alc-type-code) = trim(entry(4, temp-parts.alc-ref-ab-path)) no-error .
     4183               if available alc-types then v-inner-code = alc-types.type-code .
     4184               else next .
     4185             end.
     4186             if v-inner-code = ? then v-inner-code = alc-goods.type-code .
     4187              find first tt-parts-info exclusive-lock where tt-parts-info.obj-type         = obj-list.obj-type
     4188                                                        and tt-parts-info.obj-code         = obj-list.obj-code
     4189                                                        and tt-parts-info.artic            = alc-goods.artic
     4190                                                        and tt-parts-info.prod-type        = alc-goods.prod-type
     4191                                                        and tt-parts-info.prod-code        = alc-goods.prod-code
     4192                                                        and tt-parts-info.in-code          = temp-parts.in-code
     4193                                                        and tt-parts-info.out-code         = temp-parts.out-code
     4194                                                        and tt-parts-info.part-code        = temp-parts.part-code no-error .
     4195              if not available tt-parts-info then do :
