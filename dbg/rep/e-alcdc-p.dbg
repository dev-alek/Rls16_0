     3484   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     3485   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     3486   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     3487   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     3488   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     3489   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     3490   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     3491   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     3492         adm-object-hdl = FRAME F-Main:HANDLE.
     3493   RUN ensure-broker.
     3494   THIS-PROCEDURE:ADM-DATA =
     3495        'ADM1.1~`':U +
     3496        'SmartObject~`':U +
     3497        '~`':U +
     3498        'NO ~`':U +
     3499        '~`':U +
     3500        '~`':U +
     3501        '~`':U +
     3502        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     3503           + "~`":U +
     3504        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
     3505        'Record-Source,Record-Target,TableIO-Target~`':U +
     3506        '~`':U +
     3507        '~`~`~`~`~`~`~`~`~`~`~`':U +
     3508        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     3509            THEN "^^":U
     3510        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     3511             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     3512   PROCEDURE adm-apply-entry :
     3513     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     3514   END PROCEDURE.
     3515   PROCEDURE adm-destroy :
     3516    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     3517   END PROCEDURE.
     3518   PROCEDURE adm-disable :
     3519       DISABLE RECT-13 RADIO-SET-ver FILL-IN-kor RADIO-SET-form RADIO-ALC-PRODUCER EDITOR-ALC-PRODUCER RADIO-SUPPLIER EDITOR-SUPPLIER RADIO-ALC-TYPE EDITOR-ALC-TYPE TOGGLE-Excel TOGGLE-XML TOGGLE-KPP WITH FRAME F-Main.
     3520       RUN dispatch ('disable-fields':U).
     3521       RUN set-attribute-list ('ENABLED=no':U).
     3522       RETURN.
     3523   END PROCEDURE.
     3524   PROCEDURE adm-edit-attribute-list :
     3525         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
     3526         RETURN.
     3527   END PROCEDURE.
     3528   PROCEDURE adm-enable :
     3529       ENABLE UNLESS-HIDDEN RECT-13 RADIO-SET-ver FILL-IN-kor RADIO-SET-form RADIO-ALC-PRODUCER EDITOR-ALC-PRODUCER RADIO-SUPPLIER EDITOR-SUPPLIER RADIO-ALC-TYPE EDITOR-ALC-TYPE TOGGLE-Excel TOGGLE-XML TOGGLE-KPP WITH FRAME F-Main.
     3530       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     3531       RUN set-attribute-list ('ENABLED=yes':U).
     3532       RETURN.
     3533   END PROCEDURE.
     3534   PROCEDURE adm-exit :
     3535        RUN notify ('exit':U).
     3536     RETURN.
     3537   END PROCEDURE.
     3538   PROCEDURE adm-hide :
     3539     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     3540   END PROCEDURE.
     3541   PROCEDURE adm-initialize :
     3542     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     3543   END PROCEDURE.
     3544   PROCEDURE adm-show-errors :
     3545       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     3546       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     3547           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     3548       END.
     3549       RETURN.
     3550   END PROCEDURE.
     3551   PROCEDURE adm-UIB-mode :
     3552     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     3553   END PROCEDURE.
     3554   PROCEDURE adm-view :
     3555     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     3556   END PROCEDURE.
     3557   PROCEDURE dispatch :
     3558       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     3559       RUN broker-dispatch IN adm-broker-hdl
     3560           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     3561       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     3562   END PROCEDURE.
     3563   PROCEDURE ensure-broker :
     3564   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     3565   IF RETURN-VALUE NE "ADM-Broker":U THEN
     3566   DO:
     3567       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     3568       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     3569   END.
     3570   END PROCEDURE.
     3571   PROCEDURE get-attribute :
     3572     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     3573     RUN broker-get-attribute IN adm-broker-hdl
     3574         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     3575     RETURN RETURN-VALUE.
     3576   END PROCEDURE.
     3577   PROCEDURE get-attribute-list :
     3578     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     3579     RUN broker-get-attribute-list IN adm-broker-hdl
     3580         (INPUT THIS-PROCEDURE,
     3581          INPUT ?,
     3582          OUTPUT p-attr-list) NO-ERROR.
     3583     RETURN.
     3584   END PROCEDURE.
     3585   PROCEDURE new-state :
     3586     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     3587     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     3588     RETURN.
     3589   END PROCEDURE.
     3590   PROCEDURE notify :
     3591     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     3592     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     3593     IF RETURN-VALUE = "ADM-ERROR":U THEN
     3594         RETURN "ADM-ERROR":U.
     3595     RETURN.
     3596   END PROCEDURE.
     3597   PROCEDURE set-attribute-list :
     3598     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     3599     RUN ensure-broker.
     3600     RUN broker-set-attribute-list IN adm-broker-hdl
     3601         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     3602     RETURN.
     3603   END PROCEDURE.
     3604   PROCEDURE set-position :
     3605       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     3606       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     3607       IF VALID-HANDLE(adm-object-hdl) THEN
     3608       DO:
     3609         ASSIGN adm-object-hdl:ROW    =   p-row
     3610                adm-object-hdl:COLUMN =   p-col.
     3611       END.
     3612       RETURN.
     3613   END PROCEDURE.
     3614   PROCEDURE adm-display-fields :
     3615       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
     3616       RETURN.
     3617   END PROCEDURE.
     3618   PROCEDURE adm-open-query :
     3619     RETURN.
     3620   END PROCEDURE.
     3621   PROCEDURE adm-row-changed :
     3622         IF VALID-HANDLE(adm-object-hdl) THEN
     3623           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     3624         RUN notify ('row-available':U).
     3625         RETURN.
     3626   END PROCEDURE.
     3627   PROCEDURE reposition-query :
     3628       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
     3629       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
     3630       RETURN.
     3631   END PROCEDURE.
     3632     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
     3633     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
     3634     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
     3635     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
     3636     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
     3637     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
     3638     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
     3639     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
     3640     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     3641     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
     3642     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     3643     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
     3644     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
     3645     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
     3646     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
     3647     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
     3648     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
     3649     IF "":U = "":U THEN
     3650       RUN modify-list-attribute IN adm-broker-hdl
     3651         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
     3652     RUN use-create-on-add(?).
     3653   PROCEDURE adm-add-record :
     3654       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     3655          "must have at least one Enabled Table to perform Add.":U
     3656          VIEW-AS ALERT-BOX ERROR.
     3657       RETURN.
     3658   END PROCEDURE.
     3659   PROCEDURE adm-assign-record :
     3660    MESSAGE
     3661          "Object ":U THIS-PROCEDURE:FILE-NAME
     3662            "must have at least one Enabled Table to perform Assign.":U
     3663              VIEW-AS ALERT-BOX ERROR.
     3664      RETURN.
     3665     END PROCEDURE.
     3666   PROCEDURE adm-assign-statement :
     3667     RETURN.
     3668   END PROCEDURE.
     3669   PROCEDURE adm-cancel-record :
     3670      RETURN.
     3671     END PROCEDURE.
     3672   PROCEDURE adm-copy-record :
