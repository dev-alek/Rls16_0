     4276                 find first part-1 where part-1.type-code = v-inner-code
     4277                                   and   part-1.prod-code = imp-or-prod-code
     4278                                   and   part-1.prod-type = imp-or-prod-type
     4279                                   and   part-1.obj-kpp   = v-kpp no-error.
     4280             end.
