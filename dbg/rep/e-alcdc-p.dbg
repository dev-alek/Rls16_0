     5210                               end.
     5211                           end case.
     5212                           for first buf_alc-supp-lic no-lock where buf_alc-supp-lic.cli-type = part-2.supplier-type
     5213                                                              and   buf_alc-supp-lic.cli-code = part-2.supplier-code
     5214                                                              and   buf_alc-supp-lic.date-from <= buf_trn-doc.fact-date
