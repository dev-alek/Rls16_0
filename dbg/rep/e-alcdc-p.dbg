     4168                                                                          ,input obj-list.obj-code
     4169                                                                          ,input alc-goods.artic
     4170                                                                          ,input alc-goods.prod-type
     4171                                                                          ,input alc-goods.prod-code
     4172                                                                          ,input fact-order-end
     4173                                                                          ,input true).
