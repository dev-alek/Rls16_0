     4160                                                                          ,input obj-list.obj-code
     4161                                                                          ,input alc-goods.artic
     4162                                                                          ,input alc-goods.prod-type
     4163                                                                          ,input alc-goods.prod-code
     4164                                                                          ,input fact-order-end).
