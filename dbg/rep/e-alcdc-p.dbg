     4383                               part-1.producer-inn = ext-cl:GetExtGdsValue(1):INNProd
     4384                               part-1.producer-kpp = ext-cl:GetExtGdsValue(1):KPPProd
     4385                           .
     4386                       end.
     4387                 end.
     4388             end case.
     4389             if part-1.producer-inn = "" or part-1.producer-inn = ?
     4390             or part-1.producer-kpp = "" or part-1.producer-kpp = ?
