     4198                   tt-parts-info.obj-type         = obj-list.obj-type
     4199                   tt-parts-info.obj-code         = obj-list.obj-code
     4200                   tt-parts-info.artic            = alc-goods.artic
     4201                   tt-parts-info.prod-type        = alc-goods.prod-type
     4202                   tt-parts-info.prod-code        = alc-goods.prod-code
     4203                   tt-parts-info.in-code          = temp-parts.in-code
     4204                   tt-parts-info.out-code         = temp-parts.out-code
     4205                   tt-parts-info.part-code        = temp-parts.part-code
     4206                  .
     4207              end.
     4208               v-kpp = "" .
     4209               for first buf_clients-attr no-lock where buf_clients-attr.obj-code  = obj-list.obj-code
     4210                                                  and   buf_clients-attr.obj-type  = obj-list.obj-type
     4211                                                  and   buf_clients-attr.attr-code = 'kpp':U:
     4212                   v-kpp = buf_clients-attr.attr-value.
     4213               end.
     4214               if v-kpp = "" then  v-kpp = v-fmtcli-kpp.
     4215               ext-FormF1:Release_() .
     4216               if num-entries(temp-parts.alc-ref-ab-path) = 4 and entry(1, temp-parts.alc-ref-ab-path) <> "" then do :
     4217                   ext-FormF1:OpenQueryExtFormF1(entry(1, temp-parts.alc-ref-ab-path)) .
     4218               end.
