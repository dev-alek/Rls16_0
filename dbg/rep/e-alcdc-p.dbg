     2734   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
     2735   procedure thbjattr_code :
     2736      define input  parameter p-upper-code     as character no-undo .
     2737      define input  parameter p-code           as character no-undo .
     2738      define output parameter p-label          as character no-undo .
     2739      define output parameter p-user-can-edit  as logical   no-undo .
     2740      define output parameter p-output-display as logical   no-undo .
     2741      define output parameter p-other          as character no-undo .
     2742      define output parameter p-prop-list      as character no-undo .
     2743      define output parameter p-prop-type-list as character no-undo .
     2744      define output parameter p-prop-label-list as character no-undo .
