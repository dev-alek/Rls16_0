     3692   PROCEDURE adm-disable-fields :
     3693         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
     3694       RETURN.
     3695   END PROCEDURE.
     3696   PROCEDURE adm-enable-fields :
     3697       RETURN.
     3698   END PROCEDURE.
     3699   PROCEDURE adm-end-update :
     3700     RETURN.
     3701   END PROCEDURE.
     3702   PROCEDURE adm-reset-record :
     3703       RETURN.
     3704   END PROCEDURE.
     3705   PROCEDURE adm-update-record :
     3706       MESSAGE
     3707         "Object ":U THIS-PROCEDURE:FILE-NAME
     3708           "must have at least one Enabled Table to perform Update.":U
     3709             VIEW-AS ALERT-BOX ERROR.
     3710      RETURN.
     3711   END PROCEDURE.
     3712   PROCEDURE check-modified :
     3713   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     3714   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     3715   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     3716   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     3717     IF check-state = "check":U THEN
     3718     DO:
     3719       RUN get-link-handle IN adm-broker-hdl
     3720         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     3721            OUTPUT group-target-list).
     3722       IF group-target-list NE "":U THEN
     3723       DO i = 1 TO NUM-ENTRIES(group-target-list):
     3724         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     3725         RUN check-modified IN curr-widget ('group-check':U).
     3726         IF RETURN-VALUE NE "":U THEN
     3727         DO:
     3728           RUN check-modified-message(RETURN-VALUE).
     3729           RETURN "":U.
     3730         END.
     3731       END.
     3732     END.
     3733     RETURN "":U.
     3734   END PROCEDURE.
     3735   PROCEDURE check-modified-message :
     3736     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     3737        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     3738           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     3739        IF RETURN-VALUE = "YES":U THEN
     3740           RUN notify ('view,CONTAINER-SOURCE':U).
     3741        MESSAGE IF p-changed-table NE ? THEN
     3742           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     3743           ELSE "Current values have been changed."
     3744           SKIP "  Do you wish to save those changes?"
     3745           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     3746        IF ANS THEN
     3747        DO:
     3748           IF group-assign-target THEN
     3749             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     3750           ELSE RUN dispatch('update-record':U).
     3751           IF RETURN-VALUE = "ADM-ERROR":U THEN
     3752           DO:
     3753               MESSAGE "Changes to the previous record were not saved."
     3754                 VIEW-AS ALERT-BOX ERROR.
     3755               IF group-assign-target THEN
     3756                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     3757               ELSE RUN dispatch ('cancel-record':U).
     3758           END.
     3759        END.
     3760        ELSE DO:
     3761          IF group-assign-target THEN
     3762             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     3763          ELSE RUN dispatch('cancel-record':U).
     3764        END.
     3765        RETURN.
     3766   END PROCEDURE.
     3767   PROCEDURE get-rowid :
     3768       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     3769       ASSIGN
     3770       p-table   =   adm-first-table.
     3771       RETURN.
     3772   END PROCEDURE.
     3773   PROCEDURE init-group-assign :
     3774       RUN request-attribute IN adm-broker-hdl
     3775         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     3776       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     3777         group-assign-target = yes.
     3778       ELSE group-assign-target = no.
     3779       RETURN.
     3780   END PROCEDURE.
     3781   PROCEDURE set-editors :
     3782       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     3783       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     3784       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     3785       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     3786       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     3787       DO WHILE VALID-HANDLE (curr-widget):
     3788           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     3789              curr-widget:HIDDEN = no THEN DO:
     3790             CASE p-field-setting:
     3791               WHEN "INITIALIZE":U THEN
     3792               DO:
     3793                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     3794                     read-only-list +
     3795                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     3796                        STRING(curr-widget).
     3797               END.
     3798               WHEN "DISABLE":U OR
     3799               WHEN "ENABLE":U THEN
     3800               DO:
     3801                   curr-widget:SENSITIVE = yes.
     3802                   RUN get-attribute ('Read-Only-Editors':U).
     3803                   IF RETURN-VALUE = ? OR
     3804                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     3805                       curr-widget:READ-ONLY =
     3806                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     3807               END.
     3808               WHEN "CLEAR":U THEN
     3809                   curr-widget:SCREEN-VALUE = "":U.
     3810             END CASE.
     3811           END.
     3812           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     3813       END.
     3814       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     3815         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     3816           + '"':U).
     3817       RETURN.
     3818   END PROCEDURE.
     3819   PROCEDURE use-check-modified-all :
     3820    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     3821     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     3822     RETURN.
     3823   END PROCEDURE.
     3824   PROCEDURE use-create-on-add :
     3825   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     3826      RETURN.
     3827   END PROCEDURE.
     3828   PROCEDURE use-initial-lock :
     3829     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     3830     ASSIGN adm-initial-lock = p-attr-value.
     3831     RETURN.
     3832   END PROCEDURE.
     3833     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     3834   ASSIGN
     3835          FRAME F-Main:SCROLLABLE       = FALSE
     3836          FRAME F-Main:HIDDEN           = TRUE
     3837          FRAME F-Main:PRIVATE-DATA     =
     3838                   "DLGCLOSE".
     3839   ASSIGN
     3840          EDITOR-ALC-PRODUCER:READ-ONLY IN FRAME F-Main        = TRUE.
     3841   ASSIGN
     3842          EDITOR-ALC-TYPE:READ-ONLY IN FRAME F-Main        = TRUE.
     3843   ASSIGN
     3844          EDITOR-SUPPLIER:READ-ONLY IN FRAME F-Main        = TRUE.
     3845   ON VALUE-CHANGED OF RADIO-ALC-PRODUCER IN FRAME F-Main
     3846   DO:
     3847       assign RADIO-ALC-PRODUCER.
     3848       for each alc-producers:
     3849           delete alc-producers.
     3850       end.
     3851       case RADIO-ALC-PRODUCER:
     3852          when 1 then do:
     3853              assign  EDITOR-ALC-PRODUCER = "По всем производителям".
     3854              display EDITOR-ALC-PRODUCER with frame F-Main.
     3855          end.
     3856          when 2 then do:
     3857              run ref/cli-all.w ( my-handle
     3858                           , "b-sel,b-mark"
     3859                           , 'орг':U
     3860                           , 'все':U
     3861                           , ?
     3862                           , ?
     3863                           , ",,,,,,NO,,"
     3864                           , ?
     3865                           , output alc-producers_recids).
     3866              if alc-producers_recids = "" then do:
     3867                   assign  EDITOR-ALC-PRODUCER = "По всем производителям" RADIO-ALC-PRODUCER = 1.
     3868                   display EDITOR-ALC-PRODUCER RADIO-ALC-PRODUCER with frame F-Main.
     3869              end.
     3870              else do:
     3871                  assign  EDITOR-ALC-PRODUCER = ''.
     3872                  do ii = 1 to num-entries( alc-producers_recids ):
     3873                      find first buf_clients where recid( buf_clients ) = int(entry( ii, alc-producers_recids )) no-lock no-error.
     3874                        if available buf_clients then do:
     3875                            create alc-producers.
     3876                            assign
     3877                              alc-producers.obj-type = buf_clients.obj-type
     3878                              alc-producers.obj-code = buf_clients.obj-code
     3879                              alc-producers.obj-name = buf_clients.obj-name.
     3880                              EDITOR-ALC-PRODUCER = EDITOR-ALC-PRODUCER + alc-producers.obj-name + chr(10).
     3881                        end.
     3882                  end.
     3883                   display EDITOR-ALC-PRODUCER with frame F-Main .
     3884              end.
     3885          end.
     3886       end case.
     3887   END.
     3888   ON VALUE-CHANGED OF RADIO-ALC-TYPE IN FRAME F-Main
     3889   DO:
     3890       assign RADIO-ALC-TYPE.
     3891       for each alc-types : delete alc-types. end.
     3892       case RADIO-ALC-TYPE:
     3893          when 1 then do:
     3894              assign  EDITOR-ALC-TYPE = "По всем типам продукции".
     3895              display EDITOR-ALC-TYPE with frame F-Main.
     3896          end.
     3897          when 2 then do:
     3898              run ref/alc-type.w ( my-handle
     3899                                 , "b-sel,b-mark,alc-p"
     3900                                 , input-output alc-types_recids
     3901                                 , output l-ok).
     3902              if alc-types_recids = "" then do:
     3903                   assign  EDITOR-ALC-TYPE = "По всем типам продукции" RADIO-ALC-TYPE = 1.
     3904                   display EDITOR-ALC-TYPE RADIO-ALC-TYPE with frame F-Main.
     3905              end.
     3906              else do:
     3907                  for each alc-types exclusive-lock:
     3908                      delete alc-types.
     3909                  end.
     3910                  assign  EDITOR-ALC-TYPE = ''.
     3911                  do ii = 1 to num-entries(alc-types_recids):
     3912                      find first buf_alc-type where recid( buf_alc-type ) = int(entry( ii, alc-types_recids)) no-lock no-error.
     3913                        if available buf_alc-type then do:
     3914                            create alc-types.
     3915                            assign
     3916                              alc-types.type-code     = buf_alc-type.alc-type-inner-code
     3917                              alc-types.alc-type-name = buf_alc-type.alc-type-name
     3918                              alc-types.alc-type-code = buf_alc-type.alc-type-code
     3919                              EDITOR-ALC-TYPE = EDITOR-ALC-TYPE + alc-types.alc-type-name + chr(10).
     3920                        end.
     3921                  end.
     3922                   display EDITOR-ALC-TYPE with frame F-Main .
     3923              end.
     3924          end.
     3925       end case.
     3926   END.
     3927   ON VALUE-CHANGED OF RADIO-SUPPLIER IN FRAME F-Main
     3928   DO:
     3929       assign RADIO-SUPPLIER.
     3930       for each alc-suppliers:
     3931           delete alc-suppliers.
     3932       end.
     3933       case RADIO-SUPPLIER:
     3934          when 1 then do:
     3935              assign  EDITOR-SUPPLIER = "По всем поставщикам".
     3936              display EDITOR-SUPPLIER with frame F-Main.
     3937          end.
     3938          when 2 then do:
     3939              run ref/cli-all.w ( my-handle
     3940                           , "b-sel,b-mark"
     3941                           , 'орг':U
     3942                           , 'все':U
     3943                           , ?
     3944                           , ?
     3945                           , ",,,,,,NO,,"
     3946                           , ?
     3947                           , output alc-suppliers_recids).
     3948              if alc-suppliers_recids = "" then do:
     3949                   assign  EDITOR-SUPPLIER = "По всем поставщикам" RADIO-SUPPLIER = 1.
     3950                   display EDITOR-SUPPLIER RADIO-SUPPLIER with frame F-Main.
     3951              end.
     3952              else do:
     3953                  assign  EDITOR-SUPPLIER = ''.
     3954                  do ii = 1 to num-entries( alc-suppliers_recids ):
     3955                      find first buf_clients where recid( buf_clients ) = int(entry( ii, alc-suppliers_recids )) no-lock no-error.
     3956                        if available buf_clients then do:
     3957                            create alc-suppliers.
     3958                            assign
     3959                              alc-suppliers.obj-type = buf_clients.obj-type
     3960                              alc-suppliers.obj-code = buf_clients.obj-code
     3961                              alc-suppliers.obj-name = buf_clients.obj-name
     3962                              EDITOR-SUPPLIER = EDITOR-SUPPLIER + alc-suppliers.obj-name + chr(10).
     3963                   end.
     3964               end.
     3965                   display EDITOR-SUPPLIER with frame F-Main .
     3966               end.
     3967          end.
     3968       end case.
     3969   END.
     3970   ON VALUE-CHANGED OF RADIO-SET-form IN FRAME F-Main
     3971   DO:
     3972       assign RADIO-SET-form.
     3973       case RADIO-SET-form:
     3974           when 1 then
     3975               assign FILL-IN-kor:hidden in frame F-Main = true.
     3976           when 2 then
     3977               assign FILL-IN-kor:hidden in frame F-Main = false.
     3978       end case.
     3979   END.
     3980   if not this-procedure :persistent
     3981   then do:
     3982     message
     3983       vss-workfile vss-revision vss-description skip
     3984       "Ошибка при запуске процедуры" skip
     3985       "Данную процедуру следует запускать только с параметром persistent" skip
     3986       view-as alert-box error .
     3987     undo, return error .
     3988   end.
     3989   PROCEDURE disable_UI :
     3990     HIDE FRAME F-Main.
     3991     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     3992   END PROCEDURE.
     3993   PROCEDURE my-report :
     3994   define variable fact-order-start as decimal   no-undo.
     3995   define variable fact-order-end   as decimal   no-undo.
     3996   define variable wait-message     as character no-undo.
     3997   define variable imp-or-prod-type as character no-undo.
     3998   define variable imp-or-prod-code as integer   no-undo.
     3999   define variable v-attr-val       as character no-undo.
     4000   define variable v-attr-type      as character no-undo.
     4001   assign frame F-Main RADIO-ALC-PRODUCER RADIO-ALC-TYPE RADIO-SUPPLIER TOGGLE-Excel
     4002       TOGGLE-XML TOGGLE-KPP RADIO-SET-ver RADIO-SET-form FILL-IN-kor.
     4003   for each part-1 exclusive-lock:
     4004       delete part-1.
     4005   end.
     4006   for each part-1 exclusive-lock:
     4007       delete part-2.
     4008   end.
     4009   quarter = 1.
     4010   l-ok = yes.
     4011   if day(x-date-start) = 1 and month(x-date-end + 1) <> month(x-date-end) then do:
     4012       if month(x-date-start) = 1  and month(x-date-end) = 3  then quarter = 3.
     4013       if month(x-date-start) = 4  and month(x-date-end) = 6  then quarter = 6.
     4014       if month(x-date-start) = 7  and month(x-date-end) = 9  then quarter = 9.
     4015       if month(x-date-start) = 10 and month(x-date-end) = 12 then quarter = 0.
     4016   end.
     4017   if quarter = 1 then message "Даты не совпадают с кварталом" skip "Продолжить?" view-as alert-box buttons yes-no update l-OK.
     4018   if l-ok = no then return.
     4019   run day-begin-fact-order(input x-date-start, output fact-order-start).
     4020   run factord-end-day(input x-date-end, output fact-order-end).
     4021   if RADIO-ALC-PRODUCER = 2 then do:
     4022       for each alc-producers exclusive-lock :
     4023           find first buf_clients-attr no-lock where buf_clients-attr.obj-code = alc-producers.obj-code
     4024                                                 and buf_clients-attr.obj-type = alc-producers.obj-type
     4025                                                 and buf_clients-attr.attr-code = 'cli-alc-producer':U no-error.
     4026           if not available (buf_clients-attr) then delete alc-producers.
     4027       end.
     4028       end.
     4029   if TOGGLE-Excel = no and TOGGLE-XML = no then do:
     4030       message "Выберите формат вывода" view-as alert-box warning buttons ok.
     4031       return.
     4032   end.
     4033   case RADIO-ALC-TYPE:
     4034       when 1 then do:
     4035           for each alc-types exclusive-lock:
     4036               delete alc-types.
     4037           end.
     4038           for each buf_alc-type,
     4039               first buf_alc-type-attr where buf_alc-type-attr.attr-code = "alc-type"
     4040                                        and buf_alc-type-attr.attr-value = "2"
     4041                                        and buf_alc-type-attr.alc-type-inner-code = buf_alc-type.alc-type-inner-code
     4042                                        :
     4043               create alc-types.
     4044               assign
     4045               alc-types.type-code     = buf_alc-type.alc-type-inner-code
     4046               alc-types.alc-type-name = buf_alc-type.alc-type-name
     4047               alc-types.alc-type-code = buf_alc-type.alc-type-code.
     4048           end.
     4049       end.
     4050   end case.
     4051   case x-SelectGood:
     4052       when 1 then do:
     4053           for each alc-goods exclusive-lock:
     4054               delete alc-goods.
     4055           end.
     4056         for each alc-types no-lock:
     4057           for each buf_alc-type-gds no-lock
     4058                                     where buf_alc-type-gds.alc-type-inner-code = alc-types.type-code:
     4059               for first buf_goods no-lock where buf_goods.gds-code = buf_alc-type-gds.gds-code
     4060                                           and buf_goods.stts = 0:
     4061                   if RADIO-ALC-PRODUCER = 2 and
     4062                   not can-find(first alc-producers where alc-producers.obj-type = buf_goods.prod-type
     4063                                                      and alc-producers.obj-code = buf_goods.prod-code)
     4064                   then next.
     4065                   create alc-goods.
     4066                   assign
     4067                   alc-goods.gds-code  = buf_alc-type-gds.gds-code
     4068                   alc-goods.type-code = buf_alc-type-gds.alc-type-inner-code
     4069                   alc-goods.artic     = buf_goods.artic
     4070                   alc-goods.prod-type = buf_goods.prod-type
     4071                   alc-goods.prod-code = buf_goods.prod-code
     4072                   alc-goods.alpha1    = buf_goods.alpha1
     4073                   alc-goods.vol       = buf_goods.ms-base.
     4074               end.
     4075           end.
     4076         end.
     4077       end.
     4078   end case.
     4079   for first buf_clients no-lock where buf_clients.obj-code = v-cntxt-host-code-obj
     4080                                 and   buf_clients.obj-type = 'орг':U:
     4081     run fmtcli-get-client in this-procedure ( input buf_clients.obj-type, input  buf_clients.obj-code ).
     4082   end.
     4083   for first buf_clients-attr no-lock where buf_clients-attr.obj-type = 'орг':U
     4084                                      and   buf_clients-attr.obj-code = v-cntxt-host-code-obj
     4085                                      and   buf_clients-attr.attr-code = 'requisite-alc-decl':U:
     4086       assign
     4087           v-fmtcli-name         = entry( 1, buf_clients-attr.attr-value, "|")
     4088           firm-country-code     = entry( 3, buf_clients-attr.attr-value, "|")
     4089           firm-post-code    = entry( 4, buf_clients-attr.attr-value, "|")
     4090           firm-reg-code     = entry( 5, buf_clients-attr.attr-value, "|")
     4091           firm-district     = entry( 6, buf_clients-attr.attr-value, "|")
     4092           firm-city             = entry( 7, buf_clients-attr.attr-value, "|")
     4093           firm-settlement       = entry( 8, buf_clients-attr.attr-value, "|")
     4094           firm-street       = entry( 9, buf_clients-attr.attr-value, "|")
     4095           firm-house-number     = entry (10,buf_clients-attr.attr-value,"|")
     4096           firm-house-case       = entry (11,buf_clients-attr.attr-value,"|")
     4097           firm-house-apartment = entry (12,buf_clients-attr.attr-value,"|")
     4098           firm-house-litera     = entry (13,buf_clients-attr.attr-value,"|")
     4099           firm-director-f       = entry (14,buf_clients-attr.attr-value,"|")
     4100           firm-director-i       = entry (15,buf_clients-attr.attr-value,"|")
     4101           firm-director-o       = entry (16,buf_clients-attr.attr-value,"|")
     4102           firm-accountant-f     = entry (17,buf_clients-attr.attr-value,"|")
     4103           firm-accountant-i     = entry (18,buf_clients-attr.attr-value,"|")
     4104           firm-accountant-o     = entry (19,buf_clients-attr.attr-value,"|") no-error.
     4105   end.
     4106   for first buf_firm no-lock where buf_firm.firm-code = v-cntxt-host-code-obj:
     4107           firm-e-mail     = buf_firm.e-mail.
     4108   end.
     4109   for each obj-list no-lock break by obj-list.obj-type :
     4110       v-kpp = "" .
     4111       for first buf_clients-attr no-lock where buf_clients-attr.obj-code  = obj-list.obj-code
     4112                                          and   buf_clients-attr.obj-type  = obj-list.obj-type
     4113                                          and   buf_clients-attr.attr-code = 'kpp':U:
     4114           v-kpp = buf_clients-attr.attr-value.
     4115       end.
     4116       if v-kpp = "" then  v-kpp = v-fmtcli-kpp.
     4117       if TOGGLE-KPP then do :
     4118           find first page-2 exclusive-lock where page-2.kpp = v-kpp no-error.
     4119           if available page-2 then do :
     4120               release page-2 .
     4121               next .
     4122           end.
     4123       end.
     4124       if not available page-2 then do :
     4125           create page-2.
     4126           page-2.obj-type = obj-list.obj-type.
     4127           page-2.obj-code = obj-list.obj-code.
     4128           page-2.kpp      = v-kpp .
     4129       end.
     4130       for first buf_clients-attr no-lock where buf_clients-attr.obj-code  = obj-list.obj-code
     4131                                          and   buf_clients-attr.obj-type  = obj-list.obj-type
     4132                                          and   buf_clients-attr.attr-code = 'requisite-alc-decl':U:
     4133           assign
     4134           page-2.obj-name     = entry( 1, buf_clients-attr.attr-value, "|")
     4135           page-2.country-code = entry( 3, buf_clients-attr.attr-value, "|")
     4136           page-2.post-code   = entry( 4, buf_clients-attr.attr-value, "|")
     4137           page-2.reg-code     = entry( 5, buf_clients-attr.attr-value, "|")
     4138           page-2.district     = entry( 6, buf_clients-attr.attr-value, "|")
     4139           page-2.city         = entry( 7, buf_clients-attr.attr-value, "|")
     4140           page-2.settlement   = entry( 8, buf_clients-attr.attr-value, "|")
     4141           page-2.street       = entry( 9, buf_clients-attr.attr-value, "|")
     4142           page-2.house-number = entry( 10, buf_clients-attr.attr-value, "|")
     4143           page-2.house-case   = entry (11,buf_clients-attr.attr-value,"|")
     4144           page-2.apartment    = entry (12,buf_clients-attr.attr-value,"|")
     4145           page-2.house-litera = entry (13,buf_clients-attr.attr-value,"|") no-error.
     4146       end.
     4147       release page-2 .
     4148   end.
     4149   ext-cl = new extgds(yes) .
     4150   ext-FormF1 = new extFormF1(yes) .
     4151   output stream logStr to value("alc-dec-p_errors.txt") .
     4152   v-inn-err = false.
