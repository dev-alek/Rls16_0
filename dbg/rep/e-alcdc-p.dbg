     4304                 part-1.alc-type-code = trim(entry(4, temp-parts.alc-ref-ab-path)) .
     4305                 for first alc-types no-lock where trim(alc-types.alc-type-code) = trim(entry(4, temp-parts.alc-ref-ab-path)) :
     4306                     part-1.alc-type-name = alc-types.alc-type-name .
     4307                 end.
     4308             end.
     4309             else
