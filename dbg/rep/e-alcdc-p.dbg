     3196     define variable v-report-name as character no-undo .
     3197     define variable v-user-action as character no-undo .
     3198     define variable v-printed     as logical   no-undo .
     3199     define variable v-exist       as logical   no-undo .
     3200     do
     3201       on error undo, return error
     3202       :
     3203       run prn-lib-get-report-name  in this-procedure (
     3204         input parParentProc
     3205         ,output v-report-name
     3206         ).
     3207   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3208   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     3209     (input  v-report-name
     3210     ,input  2
     3211     ,output v-exist
     3212     )  .
     3213       if NOT v-exist then
     3214       DO:
     3215         Message
     3216           "Нет заданий на печать ! "
     3217           view-as alert-box .
     3218         Return  .
     3219       End.
     3220       run gbl/prnfilen.w
     3221         (input  ""
     3222         ,input  p-DisabledOptions
     3223         ,input  string(v-report-name )
     3224         ,input  7
     3225         ,output v-user-action
     3226         ,output v-printed
     3227         ) .
     3228       if v-printed then
     3229       do:
     3230         return "YES" .
     3231       end.
     3232       else
     3233       do:
     3234         return "NO" .
     3235       end.
     3236     end.
     3237   end procedure.
     3238   procedure prn-lib-open-stream :
     3239     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     3240     define input parameter p-page-size    as integer no-undo .
     3241     define input parameter p-is-stream    as logical no-undo .
     3242     define input parameter p-append       as logical no-undo .
     3243     define variable v-report-name as character no-undo .
     3244     do
     3245       on error undo, return error
     3246       :
     3247       run prn-lib-get-report-name  in this-procedure (
     3248         input parParentProc
     3249         ,output v-report-name
     3250         ).
     3251       if p-is-stream then
     3252       do:
     3253         if p-append then
     3254         do:
     3255           output stream PrnLibStream to value( v-report-name )
     3256             page-size value(p-page-size) append .
     3257         end.
     3258         if not p-append then
     3259         do:
     3260           output stream PrnLibStream to value( v-report-name )
     3261             page-size value(p-page-size) .
     3262         end.
     3263       end.
     3264       if not p-is-stream then
     3265       do:
     3266         if p-append then
     3267         do:
     3268           output to value( v-report-name )
     3269             page-size value(p-page-size) append .
     3270         end.
     3271         if not p-append then
     3272         do:
     3273           output to value( v-report-name )
     3274             page-size value(p-page-size) .
     3275         end.
     3276       end.
     3277     end.
     3278   end procedure.
     3279   procedure prn-lib-open-exp :
     3280     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     3281     define input parameter p-is-stream    as logical no-undo .
     3282     define input parameter p-is-append    as logical no-undo .
     3283     define output parameter p-ReportFileName as char init "report" no-undo.
     3284     define output parameter p-process as logical no-undo .
     3285     define variable glog as logical no-undo .
     3286     do
     3287       on error undo, return error
     3288       :
     3289       SYSTEM-DIALOG GET-FILE p-ReportFileName
     3290         TITLE      "Укажите путь"
     3291         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     3292         ASK-OVERWRITE
     3293         CREATE-TEST-FILE
     3294         SAVE-AS
     3295         USE-FILENAME
     3296         DEFAULT-EXTENSION "txt"
     3297         UPDATE glog
     3298         .
     3299       if not glog then  return.
     3300       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     3301       if p-is-stream then
     3302       do:
     3303         if p-is-append then
     3304         do:
     3305           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     3306         end.
     3307         else
     3308         do:
     3309           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     3310         end.
     3311       end.
     3312       else
     3313       do:
     3314         if p-is-append then
     3315         do:
     3316           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     3317         end.
     3318         else
     3319         do:
     3320           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     3321         end.
     3322       end.
     3323       p-process = yes.
     3324     end.
     3325   end procedure.
     3326   procedure prn-lib-get-report-name :
     3327     define input parameter parParentProc  as widget-handle no-undo.
     3328     define output parameter p-report-name as character no-undo .
     3329     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     3330   end procedure.
     3331   procedure prn-lib-reportviewer-report-name :
     3332     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     3333     define input parameter p-report-name-html as character no-undo .
     3334     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
     3335   end procedure.
     3336   procedure prn-lib-reportviewer :
     3337     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     3338     define input parameter p-report-name-html as character no-undo .
     3339     define input parameter p-param        as character no-undo .
     3340     define variable v-excel           as character no-undo init 'TRUE' .
     3341     define variable v-value-character as character no-undo .
     3342     define variable v-value-integer   as character no-undo .
     3343     define variable v-value-date      as date      no-undo .
     3344     define variable v-value-decimal   as decimal   no-undo .
     3345     define variable rep-excel         as logical   no-undo .
     3346     define variable excel-string      as character no-undo .
     3347     define variable v-param-type      as character no-undo .
     3348     define variable v-tth             as handle    no-undo .
     3349     run adm/shattri.p (
     3350       input "get":U
     3351       ,input  ""
     3352       ,input  0
     3353       ,input  'report-glob':U
     3354       ,input  'rep-excel':U
     3355       ,output v-value-character
     3356       ,output v-value-date
     3357       ,output v-value-decimal
     3358       ,output v-value-integer
     3359       ,output rep-excel
     3360       ,output v-param-type
     3361       ,INPUT-OUTPUT table-handle v-tth
     3362       )  .
     3363     if rep-excel then v-excel = "TRUE" .
     3364     else v-excel = "FALSE" .
     3365     if p-param eq ""
     3366     then
     3367        p-param = "EXCEL:" + v-excel.
     3368     else
     3369        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     3370     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     3371   end procedure.
