     3674        "must have at least one Enabled Table to perform Copy.":U
     3675          VIEW-AS ALERT-BOX ERROR.
     3676       RETURN.
     3677   END PROCEDURE.
     3678   PROCEDURE adm-create-record :
     3679      RETURN.
     3680   END PROCEDURE.
     3681   PROCEDURE adm-current-changed :
     3682     RETURN.
     3683   END PROCEDURE.
     3684   PROCEDURE adm-delete-record :
     3685    MESSAGE
     3686          "Object ":U THIS-PROCEDURE:FILE-NAME
     3687            "must have at least one Enabled Table to perform Delete.":U
     3688              VIEW-AS ALERT-BOX ERROR.
     3689       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
     3690       RETURN.
