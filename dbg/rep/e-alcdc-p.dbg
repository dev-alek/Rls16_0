      655   if v-cntxt-level = 'firm':U then do:
      656     find first ub.clients no-lock where
      657                ub.clients.obj-type = 'орг':U and
      658                ub.clients.obj-code = v-cntxt-host-code-obj no-error .
      659   if error-status :error then v-cntxt-host-name-obj = ? .
      660      else v-cntxt-host-name-obj = ub.clients.obj-name.
      661   end.
      662   if v-cntxt-level = 'object':U
      663   or v-cntxt-level = 'firm':U
      664   then do:
      665   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      666   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
      667     (input  v-cntxt-host-code-obj
      668     ,output base-code
      669     )  .
      670   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      671   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
      672     (input  base-code
      673     ,input  today
      674     ,output vv-exch-rate
      675     ,output vv-exch-scale
      676     ,output base-type
      677     )  .
      678   end.
      679   run get-report-num in my-handle ( output g#report-num ).
      680   run get-gds-engl in my-handle ( output g#gds-engl ) .
      681   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      682   procedure factord :
      683     define input  parameter p-fact-date            as date    no-undo .
      684     define input  parameter p-fact-time            as integer no-undo .
      685     define input  parameter p-fact-num             as integer no-undo .
      686     define input  parameter p-shift-date           as date    no-undo .
      687     define input  parameter p-shift-num            as integer no-undo .
      688     define input  parameter p-shift-on             as logical no-undo .
      689     define output parameter p-fact-order           as decimal no-undo .
      690     define output parameter p-shift-end-fact-order as decimal no-undo .
      691     define output parameter p-day-end-fact-order   as decimal no-undo .
      692     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      693     if p-fact-date = ?
      694     then do:
      695       return error "Не указана фактическая дата" .
      696     end.
      697     define variable v-fact-date-num as integer no-undo .
      698     assign
      699       v-fact-date-num = integer(p-fact-date)
      700     .
      701     if p-fact-num = ?
      702     or p-fact-num = 0
      703     then do:
      704       return error "Не задан p-fact-num " + string(p-fact-num) .
      705     end.
      706     if p-fact-num < 0
      707     then do:
      708       return error "Отрицательный fact-num " + string(p-fact-num) .
      709     end.
      710     if p-fact-num >= 100000000
      711     then do:
      712       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      713     end.
      714     if p-shift-on = true
      715     then do:
      716       if p-shift-date = ?
      717       then do:
      718         return error "Не задана дата смены" .
      719       end.
      720       if p-shift-num = ?
      721       or p-shift-num = 0
      722       then do:
      723         return error "Не задан номер смены" .
      724       end.
      725     end.
      726     else do:
      727       assign
      728         p-shift-date = p-fact-date
      729         p-shift-num  = 24
      730       .
      731     end.
      732     define variable v-shift-offset as integer no-undo .
      733     if p-shift-date = p-fact-date
      734     then do:
      735       assign
      736         v-shift-offset = 1
      737       .
      738     end.
      739     if p-shift-date < p-fact-date
      740     then do:
      741       assign
      742         v-shift-offset = 0
      743       .
      744     end.
      745     if p-shift-date > p-fact-date
      746     then do:
      747       message
      748         vss-workfile vss-revision vss-description skip
      749         "Неправильная дата закрытия смены" skip
      750         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      751         view-as alert-box error .
      752       undo, return error
      753         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      754           ,string(p-fact-date, '99/99/9999':U)
      755           ,string(p-shift-date, '99/99/9999':U)
      756           )
      757       .
      758     end.
      759     if p-shift-num < 1
      760     or p-shift-num > 24
      761     then do:
      762       message
      763         vss-workfile vss-revision vss-description skip
      764         "Неправильный номер смены" skip
      765         "p-shift-num" p-shift-num skip
      766         view-as alert-box error .
      767       undo, return error return-value .
      768     end.
      769     assign
      770       p-fact-order           = v-fact-date-num
      771                              + v-shift-offset * 0.5
      772                              + p-shift-num    * 0.02 - 0.01
      773                              + p-fact-num     * 0.0000000001
      774       p-shift-end-fact-order = v-fact-date-num
      775                              + v-shift-offset * 0.5
      776                              + p-shift-num    * 0.02
      777       p-day-end-fact-order   = v-fact-date-num
      778                              + 0.99
      779     .
      780     if p-fact-order           <= v-fact-date-num
      781     or p-shift-end-fact-order <= v-fact-date-num
      782     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      783     or p-shift-end-fact-order >= p-day-end-fact-order
      784     then do:
      785       message
      786         vss-workfile vss-revision vss-description skip
      787         "Внутренняя ошибка при генерации фактического номера" skip
      788         "p-fact-date"            p-fact-date            skip
      789         "p-fact-time"            p-fact-time            skip
      790         "p-fact-num"             p-fact-num             skip
      791         "p-shift-date"           p-shift-date           skip
      792         "p-shift-num"            p-shift-num            skip
      793         "p-shift-on"             p-shift-on             skip
      794         "p-shift-end-fact-order" p-shift-end-fact-order skip
      795         "p-day-end-fact-order"   p-day-end-fact-order   skip
      796         "v-fact-date-num"        v-fact-date-num        skip
      797         view-as alert-box error .
      798       undo, return error return-value .
      799     end.
      800   end procedure.
      801   procedure day-begin-fact-order :
      802     define input  parameter p-fact-date            as date    no-undo .
      803     define output parameter p-day-begin-fact-order as decimal no-undo .
      804     do
      805     on error undo, return error return-value
      806     :
      807       if p-fact-date = ?
      808       then do:
      809         assign
      810           p-day-begin-fact-order = 0
      811         .
      812       end.
      813       else do:
      814         assign
      815           p-day-begin-fact-order = integer(p-fact-date)
      816         .
      817       end.
      818     end.
      819   end procedure.
      820   procedure factord-max-fact-order :
      821     define output parameter p-max-fact-order as decimal   no-undo .
      822     do
      823     on error undo, return error return-value
      824     :
      825       run day-begin-fact-order in this-procedure
      826         (input  date(1, 1, 5000)
      827         ,output p-max-fact-order
      828         ) .
      829     end.
      830   end procedure.
      831   procedure factord-cut-archive :
      832     define input  parameter p-obj-type             as character no-undo .
      833     define input  parameter p-obj-code             as integer   no-undo .
      834     define input  parameter p-fact-date            as date      no-undo .
      835     define output parameter p-shift-on             as logical   no-undo .
      836     define output parameter p-shift-date           as date      no-undo .
      837     define output parameter p-shift-num            as integer   no-undo .
      838     define output parameter p-day-end-fact-order   as decimal   no-undo .
      839     define output parameter p-shift-end-fact-order as decimal   no-undo .
      840     define variable v-fact-order as decimal   no-undo .
      841     define buffer buf_shift-obj for ub.shift-obj .
      842     do
      843     on error undo, return error return-value
      844     :
      845   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      846   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      847     (input  p-obj-type
      848     ,input  p-obj-code
      849     ,input  'shift-on=request'
      850     ,output p-shift-on
      851     ) no-error .
      852       if error-status :error
      853       then do:
      854         message
      855           vss-workfile vss-revision vss-description skip
      856           "Ошибка при определении атрибута объекта" skip
      857           "Объект" p-obj-type p-obj-code skip
      858           error-status :get-message(1) skip
      859           return-value skip
      860           view-as alert-box error .
      861         undo, return error return-value .
      862       end.
      863       if p-shift-on = false
      864       then do:
      865         assign
      866           p-shift-date               = ?
      867           p-shift-num                = 0
      868         .
      869       end.
      870       else do:
      871         find first buf_shift-obj share-lock
      872           where buf_shift-obj.obj-type   = p-obj-type
      873             and buf_shift-obj.obj-code   = p-obj-code
      874             and buf_shift-obj.shift-date > p-fact-date
      875           use-index pi
      876           no-error .
      877         if not available buf_shift-obj
      878         or buf_shift-obj.status_ <> 'зкр':U
      879         then do:
      880           message
      881             vss-workfile vss-revision vss-description skip
      882             "Невозможно вычислить последнюю смену" skip
      883             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      884             "Объект" p-obj-type p-obj-code skip
      885             "Дата" p-fact-date skip
      886             view-as alert-box error .
      887           undo, return error return-value .
      888         end.
      889         find last buf_shift-obj share-lock
      890           where buf_shift-obj.obj-type = p-obj-type
      891             and buf_shift-obj.obj-code = p-obj-code
      892             and buf_shift-obj.shift-date <= p-fact-date
      893           use-index pi
      894           no-error .
      895         if available buf_shift-obj
      896         then do:
      897           if  buf_shift-obj.status_ = 'зкр':U
      898           then do:
      899             assign
      900               p-shift-date = buf_shift-obj.shift-date
      901               p-shift-num  = buf_shift-obj.shift-num
      902             .
      903           end.
      904           else do:
      905             message
      906               vss-workfile vss-revision vss-description skip
      907               "Невозможно вычислить последнюю смену" skip
      908               "Статус смены отличен от статуса" 'зкр':U skip
      909               "Объект" p-obj-type p-obj-code skip
      910               "Дата" p-fact-date skip
      911               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      912               view-as alert-box error .
      913             undo, return error return-value .
      914           end.
      915         end.
      916         else do:
      917           assign
      918             p-shift-date = p-fact-date - 1
      919             p-shift-num  = 1
      920           .
      921         end.
      922       end.
      923       run factord in this-procedure
      924         (input  p-fact-date
      925         ,input  1
      926         ,input  1
      927         ,input  p-shift-date
      928         ,input  p-shift-num
      929         ,input  p-shift-on
      930         ,output v-fact-order
      931         ,output p-shift-end-fact-order
      932         ,output p-day-end-fact-order
      933         ) no-error .
      934       if error-status :error
      935       then do:
      936         message
      937           vss-workfile vss-revision vss-description skip
      938           "Ошибка при вызове процедуры factord"
      939           error-status :get-message(1) skip
      940           return-value skip
      941           view-as alert-box error .
      942         undo, return error return-value .
      943       end.
      944     end.
      945   end procedure.
      946   procedure factord-lock-shift :
      947     define input  parameter p-obj-type  as character no-undo .
      948     define input  parameter p-obj-code  as integer   no-undo .
      949     define input  parameter p-fact-date as date      no-undo .
      950     define parameter buffer buf_shift-obj for ub.shift-obj .
      951     define variable v-shift-on      as logical   no-undo .
      952     define variable v-extra-message as character no-undo .
      953     define variable v-error as character no-undo .
      954     do
      955     on error undo, return error return-value
      956     :
      957   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      958   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      959     (input  p-obj-type
      960     ,input  p-obj-code
      961     ,input  'shift-on=request'
      962     ,output v-shift-on
      963     ) no-error .
      964       if error-status :error
      965       then do:
      966         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      967         undo, return error v-error .
      968       end.
      969       if v-shift-on = true
      970       then do:
      971         find first buf_shift-obj share-lock
      972           where buf_shift-obj.obj-type   = p-obj-type
      973             and buf_shift-obj.obj-code   = p-obj-code
      974             and buf_shift-obj.shift-date > p-fact-date
      975           use-index pi
      976           no-error .
      977         if not available buf_shift-obj
      978         or buf_shift-obj.status_ <> 'зкр':U
      979         then do:
      980           find last buf_shift-obj
      981             where buf_shift-obj.obj-type = p-obj-type
      982               and buf_shift-obj.obj-code = p-obj-code
      983               and buf_shift-obj.status_  = 'зкр':U
      984             use-index stts
      985             no-error .
      986           if available buf_shift-obj
      987           then do:
      988             assign
      989               v-extra-message =
      990                     substitute("Дата начала последеней закрытой смены на объекте &1"
      991                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      992                               )
      993             .
      994           end.
      995           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      996           undo, return error v-error .
      997         end.
      998       end.
      999     end.
     1000   end procedure.
     1001   procedure factord-end-day :
     1002     define input  parameter p-fact-date            as date    no-undo .
     1003     define output parameter p-day-end-fact-order   as decimal no-undo .
     1004     do
     1005     on error undo, return error return-value
     1006     :
     1007       if p-fact-date = ?
     1008       then do:
     1009         return error "Не указана фактическая дата" .
     1010       end.
     1011       assign
     1012         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1013       .
     1014     end.
     1015   end procedure.
     1016   procedure factord-to-date :
     1017     define input  parameter p-fact-order as decimal no-undo .
     1018     define output parameter p-fact-date  as date    no-undo .
     1019     define variable v-ref-date  as date      no-undo .
     1020     define variable v-ref-delta as integer   no-undo .
     1021     do
     1022     on error undo, return error return-value
     1023     :
     1024       if p-fact-order = ?
     1025       or p-fact-order = 0
     1026       then do:
     1027         return error "Не указан fact-order" .
     1028       end.
     1029       assign
     1030         v-ref-date  = date(1, 1, 2000)
     1031       .
     1032       assign
     1033         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1034       .
     1035       assign
     1036         p-fact-date = v-ref-date + v-ref-delta
     1037       .
     1038     end.
     1039   end procedure.
     1040   procedure factord-to-fact-num :
     1041     define input  parameter p-fact-order as decimal no-undo .
     1042     define output parameter p-fact-num   as integer no-undo .
     1043     define variable v-fact-order-trunc as decimal no-undo .
     1044     do
     1045     on error undo, return error return-value
     1046     :
     1047       if p-fact-order = ?
     1048       or p-fact-order = 0
     1049       then do:
     1050         return error "Не указан fact-order" .
     1051       end.
     1052       assign
     1053        v-fact-order-trunc = truncate(p-fact-order, 2)
     1054       .
     1055       assign
     1056         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1057       .
     1058     end.
     1059   end procedure.
     1060   procedure factord-to-shift-num :
     1061     define input  parameter p-fact-order as decimal no-undo .
     1062     define output parameter p-shift-num   as integer no-undo .
     1063     define variable  p-shift-numd  as decimal   no-undo .
     1064     define variable v-fact-order-trunc as decimal no-undo .
     1065     do
     1066     on error undo, return error return-value
     1067     :
     1068       if p-fact-order = ?
     1069       or p-fact-order = 0
     1070       then do:
     1071         return error "Не указан fact-order" .
     1072       end.
     1073       assign
     1074        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1075       .
     1076       if v-fact-order-trunc < 0.5 then do:
     1077         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1078       end.
     1079       assign
     1080         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1081         .
     1082        assign
     1083         p-shift-num = truncate (p-shift-numd , 0)
     1084       .
     1085     end.
     1086   end procedure.
     1087   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1088   define variable v-waitfram-action01         as character   no-undo .
     1089   define variable v-waitfram-action02         as character   no-undo .
     1090   define variable v-waitfram-action03         as character   no-undo .
     1091   define variable mWaitFramTextBeg            as character   no-undo.
     1092   define variable mWaitFramTextEnd            as character   no-undo.
     1093   define variable mWaitFramView               as logical     no-undo.
     1094   define variable mWaitProcEvent              as logical     no-undo init yes.
     1095   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1096   define variable mWaitFramStop               as logical     no-undo.
     1097   define variable mWaitFramStopUser           as logical     no-undo.
     1098   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1099   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1100   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1101   define button B-WaitFramStop auto-end-key
     1102        label "Стоп"
     1103        size 10 by 1 tooltip "Остоновить процесс".
     1104   define button B-viewProcInfo
     1105        label "Информация"
     1106        size 15 by 1 tooltip "Информация о процесс".
     1107   define frame waitfram
     1108     v-waitfram-action01 format "x(72)" no-label skip
     1109     v-waitfram-action02 format "x(72)" no-label skip
     1110     v-waitfram-action03 format "x(72)" no-label skip
     1111     B-viewProcInfo
     1112     B-WaitFramStop at row 4 col 30
     1113     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1114     .
     1115   define new global shared variable mBatchMode as logical no-undo init ?.
     1116   define variable mFramBachModHandle as handle no-undo.
     1117   mFramBachModHandle = frame waitfram:handle.
     1118   define variable mFameOldVis as logical no-undo.
     1119   define variable mVisCUrentVin as logical no-undo.
     1120   if session:batch-mode
     1121   then
     1122      mBatchMode = yes.
     1123   if mBatchMode = ? then do:
     1124     mVisCUrentVin = current-window:visible.
     1125     mFameOldVis = mFramBachModHandle:visible.
     1126     mFramBachModHandle:visible  = yes.
     1127     mBatchMode = mFramBachModHandle:visible ne yes.
     1128     mFramBachModHandle:visible = mFameOldVis.
     1129     current-window:visible = mVisCUrentVin.
     1130   end.
     1131    if  log-manager:logfile-name ne ?
     1132     then DO:
     1133         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1134         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1135         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1136     end.
     1137   on choose of B-WaitFramStop in frame waitfram
     1138   do:
     1139     mWaitFramStop = yes.
     1140     mWaitFramStopUser = yes.
     1141   end.
     1142   function waitfram-check-timeout returns logical():
     1143      define variable vtime as int64 no-undo.
     1144      if mWaitFramStopTimeOut
     1145      then
     1146         return yes.
     1147      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1148      if     mWaitFramTimeOut ne ?
     1149         and mWaitFramTimeOut ne 0
     1150         and mWaitFramTimeOut lt vtime
     1151      then do:
     1152         mWaitFramStopTimeOut = yes.
     1153      end.
     1154      return mWaitFramStopTimeOut.
     1155   end.
     1156   procedure waitfram-hide :
     1157     if not session:batch-mode
     1158     then do
     1159     on error undo, return error return-value
     1160     :
     1161       pause 0 before-hide .
     1162       if not mBatchMode then
     1163         hide frame waitfram .
     1164     if     not mWaitFramView
     1165        and mWaitProcEvent
     1166     then
     1167       process events .
     1168     end.
     1169   end procedure.
     1170   procedure waitfram-show :
     1171     define input  parameter p-message as character no-undo .
     1172     define variable v-left-margin as integer   no-undo .
     1173     if not session:batch-mode
     1174     then do
     1175     on error undo, return error return-value
     1176     :
     1177       if length(p-message) <= 70 then do:
     1178         assign
     1179           v-left-margin = integer((70 - length(p-message)) / 2)
     1180         .
     1181         assign
     1182           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1183         .
     1184         assign
     1185           v-waitfram-action01 = " "
     1186           v-waitfram-action02 = " "
     1187                                    + fill(" ", v-left-margin)
     1188                                    + p-message
     1189           v-waitfram-action03 = " "
     1190         .
     1191       end.
     1192       else do:
     1193         define variable vRindex1 as integer no-undo.
     1194         define variable vRindex2 as integer no-undo.
     1195         vRindex1 = r-index(p-message," ",70).
     1196         if vRindex1 = 0
     1197         then
     1198            vRindex1 = 70.
     1199         if length(p-message)  <= vRindex1 + 70 then do:
     1200           assign
     1201             v-waitfram-action01 = " "
     1202             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1203             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1204           .
     1205         end.
     1206         else do:
     1207           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1208           if vRindex2 <= vRindex1
     1209           then
     1210              vRindex2 = vRindex1 + 70.
     1211           assign
     1212             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1213             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1214             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1215           .
     1216         end.
     1217       end.
     1218       B-viewProcInfo:visible   in frame waitfram = no.
     1219       B-viewProcInfo:sensitive in frame waitfram = no.
     1220       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1221       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1222       if  (   mWaitFramView
     1223          or  mWaitProcEvent)
     1224          and not mBatchMode
     1225       then
     1226          display
     1227             v-waitfram-action01 skip
     1228             v-waitfram-action02 skip
     1229             v-waitfram-action03 skip
     1230          with frame waitfram .
     1231       if     mWaitFramView
     1232          then do:
     1233             if     mWaitFramInterval ne ?
     1234                and not mBatchMode
     1235             then
     1236                wait-for go of frame waitfram pause mWaitFramInterval.
     1237          end.
     1238          else
     1239             if     mWaitProcEvent
     1240                and not mBatchMode
     1241             then
     1242                process events .
     1243     end.
     1244   end procedure.
     1245      procedure waitfram-show-this:
     1246         define input  parameter iInterval as int64 no-undo.
     1247         define variable vtime as int64 no-undo.
     1248         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1249         mWaitFramInterval = iInterval.
     1250         run waitfram-show (substitute("&1&2 &3&4" ,
     1251                                       mWaitFramTextBeg ,
     1252                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1253                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1254                                       mWaitFramTextEnd
     1255                                      )
     1256                           ).
     1257      end.
     1258      procedure WaitFramRunPause:
     1259         define input  parameter iInterval as dec no-undo.
     1260         define variable vStart  as datetime-tz no-undo.
     1261         define variable vend    as datetime-tz no-undo.
     1262         define variable vint as int64 no-undo.
     1263         define variable vOk as logical no-undo.
     1264         vStart = now.
     1265         vend   = vStart.
     1266         publish "WaitFramPause" (iInterval,output vOk).
     1267         vend   =  now.
     1268         vint = vend - vStart.
     1269         vint = iInterval - vint / 1000.
     1270         if     not mWaitFramStop
     1271            and (   vint > 0
     1272                 or (    not vOk
     1273                     and iInterval eq ?
     1274                     )
     1275                 )
     1276         then
     1277            run waitfram-show-this (iInterval).
     1278         vend   =  now.
     1279         vint = vend - vStart.
     1280         vint = iInterval - vint / 1000.
     1281         if     not mWaitFramStop
     1282            and vint > 0
     1283         then do:
     1284            run gbl/pause.p (vint * 1000).
     1285         end.
     1286         if iInterval ne ?
     1287         then
     1288            publish "WaitFramStop".
     1289         waitfram-check-timeout().
     1290      end.
     1291      procedure WaitFramWaitFor:
     1292         define input  parameter iInterval as dec no-undo.
     1293         assign
     1294            mWaitFramStartProc   = now
     1295            mWaitFramStopUser    = no
     1296            mWaitFramStopTimeOut = no
     1297         .
     1298         block-wait:
     1299         do while not mWaitFramStop:
     1300            run WaitFramRunPause (iInterval).
     1301            if  waitfram-check-timeout()
     1302            then do:
     1303               leave block-wait.
     1304            end.
     1305         end.
     1306         run waitfram-hide.
     1307      end.
     1308   procedure waitfram-join :
     1309     define input  parameter p-line-1  as character no-undo .
     1310     define input  parameter p-line-2  as character no-undo .
     1311     define input  parameter p-line-3  as character no-undo .
     1312     define output parameter p-message as character no-undo .
     1313     do
     1314     on error undo, return error return-value
     1315     :
     1316       assign
     1317         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1318                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1319                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1320       .
     1321     end.
     1322   end procedure.
     1323   function waitfram-join-function returns character
     1324     (input p-line-1 as character
     1325     ,input p-line-2 as character
     1326     ,input p-line-3 as character
     1327     ).
     1328     define variable v-message as character no-undo .
     1329     run waitfram-join in this-procedure
     1330       (input  p-line-1
     1331       ,input  p-line-2
     1332       ,input  p-line-3
     1333       ,output v-message
     1334       ) .
     1335     return v-message .
     1336   end function .
     1337   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1338   define new global shared variable g#trdcalib as handle no-undo.
     1339   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1340   define temp-table temp-parts no-undo   like ub.parts   field free-qnty as decimal   field free-cli-qnty as decimal .
     1341   procedure partslib-clear-temp-parts :
     1342     define buffer buf_temp-parts for temp-parts .
     1343     do
     1344     on error undo, return error
     1345     :
     1346       for each buf_temp-parts
     1347       on error undo, return error
     1348       :
     1349         delete buf_temp-parts .
     1350       end.
     1351     end.
     1352   end procedure.
     1353   procedure partslib-create-temp-parts :
     1354     define parameter buffer buf_parts       for ub.parts .
     1355     define parameter buffer buf_temp-parts  for temp-parts .
     1356     define input  parameter p-goods-twounit as logical   no-undo .
     1357     define variable v-base-part-code as character no-undo .
     1358     do
     1359     on error undo, return error
     1360     :
     1361       if p-goods-twounit = true
     1362       then do:
     1363         assign
     1364           v-base-part-code = entry(1, buf_parts.part-code, '#':U)
     1365         .
     1366       end.
     1367       else do:
     1368         assign
     1369           v-base-part-code = buf_parts.part-code
     1370         .
     1371       end.
     1372       find first buf_temp-parts exclusive-lock
     1373         where buf_temp-parts.obj-type  = buf_parts.obj-type
     1374           and buf_temp-parts.obj-code  = buf_parts.obj-code
     1375           and buf_temp-parts.artic     = buf_parts.artic
     1376           and buf_temp-parts.prod-type = buf_parts.prod-type
     1377           and buf_temp-parts.prod-code = buf_parts.prod-code
     1378           and buf_temp-parts.in-code   = buf_parts.in-code
     1379           and buf_temp-parts.out-code  = 'free-zone':U
     1380           and buf_temp-parts.part-code = v-base-part-code
     1381         no-error.
     1382       if not available buf_temp-parts
     1383       then do:
     1384         create buf_temp-parts .
     1385         buffer-copy buf_parts to buf_temp-parts
     1386         assign
     1387           buf_temp-parts.out-code  = 'free-zone':U
     1388           buf_temp-parts.part-code = v-base-part-code
     1389           buf_temp-parts.rsrv-free = yes
     1390           buf_temp-parts.status_   = no
     1391           buf_temp-parts.qnty      = 0
     1392           buf_temp-parts.fact-qnty = 0
     1393           buf_temp-parts.real-qnty = 0
     1394           buf_temp-parts.cli-qnty  = 0
     1395         .
     1396       end.
     1397     end.
     1398   end procedure.
     1399   procedure partslib-init-temp-parts :
     1400     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
     1401     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
     1402     define input parameter p-artic           like ub.parts.artic     no-undo .
     1403     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
     1404     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
     1405     define buffer buf_parts      for ub.parts .
     1406     define buffer buf_temp-parts for temp-parts .
     1407     define variable v-goods-twounit    as logical   no-undo .
     1408     do
     1409     on error undo, return error
     1410     :
     1411   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1412   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1413     (input  p-artic
     1414     ,input  p-prod-type
     1415     ,input  p-prod-code
     1416     ,input  'twounit=request':u
     1417     ,output v-goods-twounit
     1418     ) no-error .
     1419       if error-status :error
     1420       then do:
     1421         message
     1422           vss-workfile vss-revision vss-description skip
     1423           vss-include-info18 skip
     1424           "Ошибка при определении атрибута товара" skip
     1425           "Артикул" p-artic p-prod-type p-prod-code skip
     1426           "twounit=request" skip
     1427           error-status :get-message(1) skip
     1428           return-value skip
     1429           view-as alert-box error .
     1430         undo, return error return-value .
     1431       end.
     1432       run partslib-clear-temp-parts in this-procedure .
     1433       for each buf_parts
     1434         where buf_parts.obj-type  = p-obj-type
     1435           and buf_parts.obj-code  = p-obj-code
     1436           and buf_parts.artic     = p-artic
     1437           and buf_parts.prod-type = p-prod-type
     1438           and buf_parts.prod-code = p-prod-code
     1439           and buf_parts.rsrv-free = yes
     1440           and buf_parts.status_   = no
     1441           and buf_parts.in-code   <> buf_parts.out-code
     1442       on error undo, return error
     1443       :
     1444         run partslib-create-temp-parts in this-procedure
     1445           (buffer buf_parts
     1446           ,buffer buf_temp-parts
     1447           ,input  v-goods-twounit
     1448           ) .
     1449         define variable v-parts-qnty          as decimal   no-undo .
     1450         define variable v-parts-cli-qnty      as decimal   no-undo .
     1451         define variable v-parts-free-qnty     as decimal   no-undo .
     1452         define variable v-parts-free-cli-qnty as decimal   no-undo .
     1453         if buf_parts.out-code = 'free-zone':U
     1454         then do:
     1455           assign
     1456             v-parts-qnty          = buf_parts.qnty
     1457             v-parts-cli-qnty      = buf_parts.cli-qnty
     1458             v-parts-free-qnty     = buf_parts.qnty
     1459             v-parts-free-cli-qnty = buf_parts.cli-qnty
     1460           .
     1461         end.
     1462         else do:
     1463           assign
     1464             v-parts-qnty          = abs(buf_parts.qnty)
     1465             v-parts-cli-qnty      = abs(buf_parts.cli-qnty)
     1466             v-parts-free-qnty     = 0
     1467             v-parts-free-cli-qnty = 0
     1468           .
     1469         end.
     1470         assign
     1471           buf_temp-parts.qnty          = buf_temp-parts.qnty          + v-parts-qnty
     1472           buf_temp-parts.fact-qnty     = buf_temp-parts.fact-qnty     + v-parts-qnty
     1473           buf_temp-parts.real-qnty     = 0
     1474           buf_temp-parts.cli-qnty      = buf_temp-parts.cli-qnty      + v-parts-cli-qnty
     1475           buf_temp-parts.free-qnty     = buf_temp-parts.free-qnty     + v-parts-free-qnty
     1476           buf_temp-parts.free-cli-qnty = buf_temp-parts.free-cli-qnty + v-parts-free-cli-qnty
     1477         .
     1478       end.
     1479     end.
     1480   end procedure.
     1481   procedure partslib-init-temp-parts-by-factord :
     1482     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
     1483     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
     1484     define input parameter p-artic              like ub.parts.artic     no-undo .
     1485     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
     1486     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
     1487     define input parameter p-fact-order         as decimal   no-undo .
     1488     define input parameter p-include-fact-order as logical   no-undo .
     1489     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
     1490     define buffer buf_gds-obj  for ub.gds-obj .
     1491     do
     1492     on error undo, return error
     1493     :
     1494       do transaction
     1495       on error undo, return error
     1496       :
     1497   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1498   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     1499     (input  p-obj-type
     1500     ,input  p-obj-code
     1501     ,input  p-artic
     1502     ,input  p-prod-type
     1503     ,input  p-prod-code
     1504     ,buffer buf_gds-obj
     1505     ) no-error .
     1506         if error-status :error
     1507         then do:
     1508           message
     1509             vss-workfile vss-revision vss-description skip
     1510             vss-include-info18 skip
     1511             "Невозможно найти товар на объекте" skip
     1512             "Объект" p-obj-type p-obj-code skip
     1513             "Артикул" p-artic p-prod-type p-prod-code skip
     1514             error-status :get-message(1) skip
     1515             return-value skip
     1516             view-as alert-box error .
     1517           undo, return error .
     1518         end.
     1519         find current buf_gds-obj exclusive-lock .
     1520       end.
     1521       run partslib-init-temp-parts in this-procedure
     1522         (input p-obj-type
     1523         ,input p-obj-code
     1524         ,input p-artic
     1525         ,input p-prod-type
     1526         ,input p-prod-code
     1527         ) no-error .
     1528       if error-status :error
     1529       then do:
     1530         message
     1531           vss-workfile vss-revision vss-description skip
     1532           vss-include-info18 skip
     1533           "Ошибка при инициализации текущего остатка по партиям свободной зоны" skip
     1534           "Объект" p-obj-type p-obj-code skip
     1535           "Артикул" p-artic p-prod-type p-prod-code skip
     1536           "p-fact-order" p-fact-order skip
     1537           view-as alert-box error .
     1538         undo, return error .
     1539       end.
     1540       if p-include-fact-order = true
     1541       then do:
     1542         assign
     1543           p-fact-order = p-fact-order - 0.0000000001
     1544         .
     1545       end.
     1546       define variable v-max-fact-order as character no-undo .
     1547       run factord-max-fact-order in this-procedure
     1548         (output v-max-fact-order
     1549         ) no-error .
     1550       if error-status :error
     1551       then do:
     1552         message
     1553           vss-workfile vss-revision vss-description skip
     1554           vss-include-info18 skip
     1555           "Ошибка при вызове процедуры factord-max-fact-order" skip
     1556           "Объект" p-obj-type p-obj-code skip
     1557           "Артикул" p-artic p-prod-type p-prod-code skip
     1558           "p-fact-order" p-fact-order skip
     1559           view-as alert-box error .
     1560         undo, return error .
     1561       end.
     1562       run partslib-update-by-factord in this-procedure
     1563         (input p-obj-type
     1564         ,input p-obj-code
     1565         ,input p-artic
     1566         ,input p-prod-type
     1567         ,input p-prod-code
     1568         ,input p-fact-order
     1569         ,input v-max-fact-order
     1570         ,input false
     1571         ) no-error .
     1572       if error-status :error
     1573       then do:
     1574         message
     1575           vss-workfile vss-revision vss-description skip
     1576           vss-include-info18 skip
     1577           "Ошибка при вызове процедуры partslib-update-by-factord" skip
     1578           "Объект" p-obj-type p-obj-code skip
     1579           "Артикул" p-artic p-prod-type p-prod-code skip
     1580           "p-fact-order" p-fact-order skip
     1581           "v-max-fact-order" v-max-fact-order skip
     1582           view-as alert-box error .
     1583         undo, return error .
     1584       end.
     1585     end.
     1586   end procedure.
     1587   procedure partslib-update-by-factord :
     1588     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
     1589     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
     1590     define input parameter p-artic              like ub.parts.artic     no-undo .
     1591     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
     1592     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
     1593     define input parameter p-start-fact-order   as decimal   no-undo .
     1594     define input parameter p-end-fact-order     as decimal   no-undo .
     1595     define input parameter p-lock-gds-obj       as logical   no-undo .
     1596     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
     1597     define buffer buf_gds-obj  for ub.gds-obj .
     1598     define buffer buf_doc-line for ub.doc-line .
     1599     define variable v-total-parts-qnty as decimal   no-undo .
     1600     define variable v-goods-gds-goods  as logical   no-undo .
     1601     define variable v-goods-twounit    as logical   no-undo .
     1602     do
     1603     on error undo, return error
     1604     :
     1605       if p-start-fact-order > p-end-fact-order
     1606       then do:
     1607         message
     1608           vss-workfile vss-revision vss-description skip
     1609           vss-include-info18 skip
     1610           "Ошибка задания входных параметров" skip
     1611           "Начало интервала превышает конец интервала" skip
     1612           "Объект" p-obj-type p-obj-code skip
     1613           "Артикул" p-artic p-prod-type p-prod-code skip
     1614           "p-start-fact-order" p-start-fact-order skip
     1615           "p-end-fact-order"   p-end-fact-order skip
     1616           view-as alert-box error .
     1617         undo, return error .
     1618       end.
     1619       if p-lock-gds-obj = true
     1620       then do:
     1621         do transaction
     1622         on error undo, return error
     1623         :
     1624   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1625   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     1626     (input  p-obj-type
     1627     ,input  p-obj-code
     1628     ,input  p-artic
     1629     ,input  p-prod-type
     1630     ,input  p-prod-code
     1631     ,buffer buf_gds-obj
     1632     ) no-error .
     1633           if error-status :error
     1634           then do:
     1635             message
     1636               vss-workfile vss-revision vss-description skip
     1637               vss-include-info18 skip
     1638               "Невозможно найти gds-obj" skip
     1639               error-status :get-message(1) skip
     1640               return-value skip
     1641               view-as alert-box error .
     1642             undo, return error .
     1643           end.
     1644           find current buf_gds-obj exclusive-lock .
     1645         end.
     1646       end.
     1647   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1648   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1649     (input  p-artic
     1650     ,input  p-prod-type
     1651     ,input  p-prod-code
     1652     ,input  'gds-goods=request':u
     1653     ,output v-goods-gds-goods
     1654     ) no-error .
     1655       if error-status :error
     1656       then do:
     1657         message
     1658           vss-workfile vss-revision vss-description skip
     1659           vss-include-info18 skip
     1660           "Ошибка при определении атрибута товара" skip
     1661           "Артикул" p-artic p-prod-type p-prod-code skip
     1662           "gds-goods=request" skip
     1663           error-status :get-message(1) skip
     1664           return-value skip
     1665           view-as alert-box error .
     1666         undo, return error return-value .
     1667       end.
     1668   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1669   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1670     (input  p-artic
     1671     ,input  p-prod-type
     1672     ,input  p-prod-code
     1673     ,input  'twounit=request':u
     1674     ,output v-goods-twounit
     1675     ) no-error .
     1676       if error-status :error
     1677       then do:
     1678         message
     1679           vss-workfile vss-revision vss-description skip
     1680           vss-include-info18 skip
     1681           "Ошибка при определении атрибута товара" skip
     1682           "Артикул" p-artic p-prod-type p-prod-code skip
     1683           "twounit=request" skip
     1684           error-status :get-message(1) skip
     1685           return-value skip
     1686           view-as alert-box error .
     1687         undo, return error return-value .
     1688       end.
     1689       for each buf_doc-line no-lock
     1690         where buf_doc-line.obj-type   = p-obj-type
     1691           and buf_doc-line.obj-code   = p-obj-code
     1692           and buf_doc-line.artic      = p-artic
     1693           and buf_doc-line.prod-type  = p-prod-type
     1694           and buf_doc-line.prod-code  = p-prod-code
     1695           and buf_doc-line.status_    = 'факт':U
     1696           and buf_doc-line.fact-order > p-start-fact-order
     1697           and buf_doc-line.fact-order <= p-end-fact-order
     1698       on error undo, return error
     1699       :
     1700         run partslib-process-document in this-procedure
     1701           (input  buf_doc-line.doc-code
     1702           ,input  p-obj-type
     1703           ,input  p-obj-code
     1704           ,input  p-artic
     1705           ,input  p-prod-type
     1706           ,input  p-prod-code
     1707           ,input  v-goods-gds-goods
     1708           ,input  v-goods-twounit
     1709           ,output v-total-parts-qnty
     1710           ) no-error .
     1711         if error-status :error
     1712         then do:
     1713           message
     1714             vss-workfile vss-revision vss-description skip
     1715             vss-include-info18 skip
     1716             "Ошибка при вызове процедуры partslib-process-document" skip
     1717             "Документ" buf_doc-line.doc-code skip
     1718             "Объект" p-obj-type p-obj-code skip
     1719             "Артикул" p-artic p-prod-type p-prod-code skip
     1720             "p-start-fact-order" p-start-fact-order skip
     1721             "p-end-fact-order" p-end-fact-order skip
     1722             error-status :get-message(1) skip
     1723             return-value skip
     1724             view-as alert-box error .
     1725           undo, return error return-value .
     1726         end.
     1727       end.
     1728     end.
     1729   end procedure.
     1730   procedure partslib-process-document :
     1731     define input  parameter p-doc-code         as character no-undo .
     1732     define input  parameter p-obj-type         as character no-undo .
     1733     define input  parameter p-obj-code         as integer   no-undo .
     1734     define input  parameter p-artic            as character no-undo .
     1735     define input  parameter p-prod-type        as character no-undo .
     1736     define input  parameter p-prod-code        as integer   no-undo .
     1737     define input  parameter p-goods-gds-goods  as logical   no-undo .
     1738     define input  parameter p-goods-twounit    as logical   no-undo .
     1739     define output parameter p-total-parts-qnty as decimal   no-undo .
     1740     define variable v-parts-sign as integer   no-undo .
     1741     define buffer buf_trn-doc    for ub.trn-doc .
     1742     define buffer buf_doc-line   for ub.doc-line .
     1743     define buffer buf_parts      for ub.parts .
     1744     define buffer buf_temp-parts for temp-parts .
     1745     do
     1746     on error undo, return error return-value
     1747     :
     1748       find first buf_trn-doc no-lock
     1749         where buf_trn-doc.doc-code = p-doc-code
     1750         no-error .
     1751       if not available buf_trn-doc
     1752       then do:
     1753         undo, return error substitute("Ошибка при поиске документа. Документ &1"
     1754                                      ,p-doc-code
     1755                                      ) .
     1756       end.
     1757       case buf_trn-doc.doc-type
     1758       :
     1759         when 'при':U or
     1760         when 'возврат':U or
     1761         when 'инв':U
     1762         then do:
     1763           assign
     1764             v-parts-sign = -1
     1765           .
     1766         end.
     1767         when 'рас':U or
     1768         when 'спи':U
     1769         then do:
     1770           assign
     1771             v-parts-sign = 1
     1772           .
     1773         end.
     1774         otherwise do:
     1775           undo, return error substitute("Неизвестный тип документа &1"
     1776                                       ,buf_trn-doc.doc-type
     1777                                       ) .
     1778         end.
     1779       end.
     1780       find first buf_doc-line no-lock
     1781         where buf_doc-line.doc-code  = p-doc-code
     1782           and buf_doc-line.artic     = p-artic
     1783           and buf_doc-line.prod-type = p-prod-type
     1784           and buf_doc-line.prod-code = p-prod-code
     1785         no-error .
     1786       if not available buf_doc-line
     1787       then do:
     1788         undo, return error substitute("Ошибка при поиске строки документа. Документ &1. Артикул &2 &3 &4"
     1789                                      ,p-doc-code
     1790                                      ,artic
     1791                                      ,prod-type
     1792                                      ,prod-code
     1793                                      ) .
     1794       end.
     1795       assign
     1796         p-total-parts-qnty = 0
     1797       .
     1798       if p-goods-gds-goods = true
     1799       then do:
     1800         for each buf_parts no-lock
     1801           where buf_parts.out-code  = p-doc-code
     1802             and buf_parts.obj-type  = p-obj-type
     1803             and buf_parts.obj-code  = p-obj-code
     1804             and buf_parts.artic     = p-artic
     1805             and buf_parts.prod-type = p-prod-type
     1806             and buf_parts.prod-code = p-prod-code
     1807         on error undo, return error
     1808         :
     1809           run partslib-create-temp-parts in this-procedure
     1810             (buffer buf_parts
     1811             ,buffer buf_temp-parts
     1812             ,input  p-goods-twounit
     1813             ) .
     1814           assign
     1815             p-total-parts-qnty        = p-total-parts-qnty
     1816                                       + v-parts-sign * buf_parts.fact-qnty
     1817             buf_temp-parts.qnty       = buf_temp-parts.qnty
     1818                                       + v-parts-sign * buf_parts.fact-qnty
     1819             buf_temp-parts.fact-qnty  = buf_temp-parts.fact-qnty
     1820                                       + v-parts-sign * buf_parts.fact-qnty
     1821             buf_temp-parts.cli-qnty   = buf_temp-parts.cli-qnty
     1822                                       + v-parts-sign * buf_parts.cli-qnty
     1823           .
     1824           if buf_temp-parts.qnty = 0
     1825           then do:
     1826             delete buf_temp-parts .
     1827           end.
     1828         end.
     1829       end.
     1830       else do:
     1831         assign
     1832           p-total-parts-qnty = p-total-parts-qnty
     1833                              + v-parts-sign * buf_doc-line.fact-qnty
     1834         .
     1835       end.
     1836     end.
     1837   end procedure.
     1838   procedure partslib-init-temp-parts-by-date :
     1839     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
     1840     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
     1841     define input parameter p-artic           like ub.parts.artic     no-undo .
     1842     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
     1843     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
     1844     define input parameter p-fact-date       as date      no-undo .
     1845     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-date: определение партий свободной зоны на любую дату".
     1846     do
     1847     on error undo, return error
     1848     :
     1849       define variable v-fact-order                as decimal   no-undo .
     1850       define variable v-shift-end-fact-order      as decimal   no-undo .
     1851       define variable v-day-end-fact-order        as decimal   no-undo .
     1852       run factord in this-procedure
     1853         (input  p-fact-date
     1854         ,input  1
     1855         ,input  1
     1856         ,input  ?
     1857         ,input  0
     1858         ,input  false
     1859         ,output v-fact-order
     1860         ,output v-shift-end-fact-order
     1861         ,output v-day-end-fact-order
     1862         ) no-error .
     1863       if error-status :error
     1864       then do:
     1865         message
     1866           vss-workfile vss-revision vss-description skip
     1867           vss-include-info18 skip
     1868           "Ошибка при определении момента времени, на который требуется остаток" skip
     1869           "Объект" p-obj-type p-obj-code skip
     1870           "Артикул" p-artic p-prod-type p-prod-code skip
     1871           "Дата" p-fact-date skip
     1872           view-as alert-box error .
     1873         undo, return error .
     1874       end.
     1875       run partslib-init-temp-parts-by-factord in this-procedure
     1876         (input p-obj-type
     1877         ,input p-obj-code
     1878         ,input p-artic
     1879         ,input p-prod-type
     1880         ,input p-prod-code
     1881         ,input v-day-end-fact-order
     1882         ,input false
     1883         ) no-error .
     1884       if error-status :error
     1885       then do:
     1886         message
     1887           vss-workfile vss-revision vss-description skip
     1888           vss-include-info18 skip
     1889           "Ошибка при вызове метода partslib-init-temp-parts-by-factord" skip
     1890           "Объект" p-obj-type p-obj-code skip
     1891           "Артикул" p-artic p-prod-type p-prod-code skip
     1892           "Дата" p-fact-date skip
     1893           view-as alert-box error .
     1894         undo, return error .
     1895       end.
     1896     end.
     1897   end procedure.
     1898   procedure partslib-calc-cost :
     1899     define output parameter p-fact-qnty      as decimal   no-undo .
     1900     define output parameter p-vat-pc         as decimal   no-undo .
     1901     define output parameter p-slt-pc         as decimal   no-undo .
     1902     define output parameter p-sum-base       as decimal   no-undo .
     1903     define output parameter p-sum-rubl       as decimal   no-undo .
     1904     define output parameter p-vat-base       as decimal   no-undo .
     1905     define output parameter p-vat-rubl       as decimal   no-undo .
     1906     define output parameter p-slt-base       as decimal   no-undo .
     1907     define output parameter p-slt-rubl       as decimal   no-undo .
     1908     define output parameter p-road-tax-base  as decimal   no-undo .
     1909     define output parameter p-road-tax-rubl  as decimal   no-undo .
     1910     define output parameter p-transport-base as decimal   no-undo .
     1911     define output parameter p-transport-rubl as decimal   no-undo .
     1912     define output parameter p-other-base     as decimal   no-undo .
     1913     define output parameter p-other-rubl     as decimal   no-undo .
     1914     define output parameter p-excise-base    as decimal   no-undo .
     1915     define output parameter p-excise-rubl    as decimal   no-undo .
     1916     define variable vss-description as character no-undo init "partslib-calc-cost: расчет сумм в учетных ценах".
     1917     do
     1918     on error undo, return error return-value
     1919     :
     1920       define buffer buf_temp-parts for temp-parts .
     1921       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     1922       define buffer   in-vatp-parts    for ub.parts   .
     1923       define buffer   in-vatp-doc      for ub.trn-doc .
     1924       define buffer   in-vatp-goods    for ub.goods   .
     1925       define buffer   in-vatp-sysconf  for ub.sysconf .
     1926       define buffer   in-vatp_doc-attr for ub.doc-attr.
     1927       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     1928       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     1929       define variable varinvprb                  as   character              no-undo.
     1930       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     1931       define variable cli-base-rate              as   decimal                no-undo.
     1932       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     1933       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     1934       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     1935       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     1936       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     1937       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     1938       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     1939       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1940       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     1941       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     1942       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1943       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     1944       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     1945       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     1946       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     1947       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     1948       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     1949       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     1950       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     1951       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     1952       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     1953       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     1954       define variable varinvatp-envd             as   character              no-undo.
     1955       define variable varinvatp-type             as   character              no-undo.
     1956       for each buf_temp-parts
     1957       on error undo, return error
     1958       :
     1959   assign
     1960     price-rubl-with-tax-loc = buf_temp-parts.price-rubl
     1961     price-base-with-tax-loc = buf_temp-parts.price-base
     1962   .
     1963   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1964   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1965     (output varinvprb
     1966     )  .
     1967     if buf_temp-parts.out-code = 'free-zone':U     or
     1968        buf_temp-parts.out-code = 'out-zone':U   or
     1969        buf_temp-parts.doc-type = 'акт':U then do:
     1970       assign
     1971         in-vatp-have-vat-slt = yes.
     1972     end.
     1973     else do:
     1974       find first in-vatp_doc-attr no-lock
     1975         where in-vatp_doc-attr.doc-code  = buf_temp-parts.out-code
     1976           and in-vatp_doc-attr.attr-code = 'envd':U
     1977         no-error .
     1978       if not available in-vatp_doc-attr then do:
     1979         assign
     1980           in-vatp-have-vat-slt = yes.
     1981       end.
     1982       else do:
     1983            in-vatp-have-vat-slt = no.
     1984       end.
     1985     end.
     1986     assign
     1987      price-cli-with-tax-loc = buf_temp-parts.price-cli
     1988      cli-base-rate          = buf_temp-parts.cli-base-rate.
     1989     ASSIGN   road-tax-base-loc  = (if buf_temp-parts.road-tax-base  = ? then 0 else buf_temp-parts.road-tax-base)
     1990              road-tax-rubl-loc  = (if buf_temp-parts.road-tax-rubl  = ? then 0 else buf_temp-parts.road-tax-rubl).
     1991     ASSIGN  transport-base-loc = (if buf_temp-parts.transport-base = ? then 0 else buf_temp-parts.transport-base)
     1992             transport-rubl-loc = (if buf_temp-parts.transport-rubl = ? then 0 else buf_temp-parts.transport-rubl)
     1993             other-base-loc     = (if buf_temp-parts.other-base     = ? then 0 else buf_temp-parts.other-base)
     1994             other-rubl-loc     = (if buf_temp-parts.other-rubl     = ? then 0 else buf_temp-parts.other-rubl)
     1995             vat-pc-loc         = (if buf_temp-parts.vat-pc         = ? then 0 else buf_temp-parts.vat-pc)
     1996             slt-pc-loc         = (if buf_temp-parts.slt-pc         = ? then 0 else buf_temp-parts.slt-pc).
     1997             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1998       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1999     assign
     2000       exch-rate-cli-loc = (buf_temp-parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_temp-parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_temp-parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_temp-parts.price-cli .
     2001     assign
     2002       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     2003       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     2004       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     2005       transport-cli-loc  = 0
     2006       other-cli-loc      = 0
     2007     .
     2008   ASSIGN
     2009             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     2010       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     2011   .
     2012         assign
     2013           p-fact-qnty      = p-fact-qnty      + buf_temp-parts.fact-qnty
     2014           p-vat-pc         = p-vat-pc         + vat-pc-loc
     2015           p-slt-pc         = p-slt-pc         + slt-pc-loc
     2016           p-sum-base       = p-sum-base       + price-base-with-tax-loc * buf_temp-parts.fact-qnty
     2017           p-sum-rubl       = p-sum-rubl       + price-rubl-with-tax-loc * buf_temp-parts.fact-qnty
     2018           p-vat-base       = p-vat-base       + vat-base-loc            * buf_temp-parts.fact-qnty
     2019           p-vat-rubl       = p-vat-rubl       + vat-rubl-loc            * buf_temp-parts.fact-qnty
     2020           p-slt-base       = p-slt-base       + slt-base-loc            * buf_temp-parts.fact-qnty
     2021           p-slt-rubl       = p-slt-rubl       + slt-rubl-loc            * buf_temp-parts.fact-qnty
     2022           p-road-tax-base  = p-road-tax-base  + road-tax-base-loc       * buf_temp-parts.fact-qnty
     2023           p-road-tax-rubl  = p-road-tax-rubl  + road-tax-rubl-loc       * buf_temp-parts.fact-qnty
     2024           p-transport-base = p-transport-base + transport-base-loc      * buf_temp-parts.fact-qnty
     2025           p-transport-rubl = p-transport-rubl + transport-rubl-loc      * buf_temp-parts.fact-qnty
     2026           p-other-base     = p-other-base     + other-base-loc          * buf_temp-parts.fact-qnty
     2027           p-other-rubl     = p-other-rubl     + other-rubl-loc          * buf_temp-parts.fact-qnty
     2028           p-excise-base    = p-excise-base    + 0
     2029           p-excise-rubl    = p-excise-rubl    + 0
     2030         .
     2031       end.
     2032       if p-fact-qnty      = ?
     2033       or p-sum-base       = ?
     2034       or p-sum-rubl       = ?
     2035       or p-vat-base       = ?
     2036       or p-vat-rubl       = ?
     2037       or p-slt-base       = ?
     2038       or p-slt-rubl       = ?
     2039       or p-road-tax-base  = ?
     2040       or p-road-tax-rubl  = ?
     2041       or p-transport-base = ?
     2042       or p-transport-rubl = ?
     2043       or p-other-base     = ?
     2044       or p-other-rubl     = ?
     2045       or p-excise-base    = ?
     2046       or p-excise-rubl    = ?
     2047       then do:
     2048         message
     2049           vss-workfile vss-revision vss-description skip
     2050           vss-include-info18 skip
     2051           "Программа in-vatp.i вернула неопределенные значения" skip
     2052           "p-fact-qnty"      p-fact-qnty      skip
     2053           "p-sum-base"       p-sum-base       skip
     2054           "p-sum-rubl"       p-sum-rubl       skip
     2055           "p-vat-base"       p-vat-base       skip
     2056           "p-vat-rubl"       p-vat-rubl       skip
     2057           "p-slt-base"       p-slt-base       skip
     2058           "p-slt-rubl"       p-slt-rubl       skip
     2059           "p-road-tax-base"  p-road-tax-base  skip
     2060           "p-road-tax-rubl"  p-road-tax-rubl  skip
     2061           "p-transport-base" p-transport-base skip
     2062           "p-transport-rubl" p-transport-rubl skip
     2063           "p-other-base"     p-other-base     skip
     2064           "p-other-rubl"     p-other-rubl     skip
     2065           "p-excise-base"    p-excise-base    skip
     2066           "p-excise-rubl"    p-excise-rubl    skip
     2067           view-as alert-box error .
     2068         undo, return error .
     2069       end.
     2070     end.
     2071   end procedure.
     2072   define variable vss-include-info25 as character format "X(65)" no-undo
     2073   initial "@(#)$Workfile$ $Revision$".
     2074   define variable v-fmtcli-name          as character    no-undo.
     2075   define variable v-fmtcli-engl-name     as character    no-undo.
     2076   define variable v-fmtcli-addres        as character    no-undo.
     2077   define variable v-fmtcli-post-addres   as character    no-undo.
     2078   define variable v-fmtcli-full-addres   as character    no-undo.
     2079   define variable v-fmtcli-phone         as character    no-undo.
     2080   define variable v-fmtcli-inn           as character    no-undo.
     2081   define variable v-fmtcli-kpp           as character    no-undo.
     2082   define variable v-fmtcli-okpo          as character    no-undo.
     2083   define variable v-fmtcli-country       as character    no-undo.
     2084   define variable v-fmtcli-city          as character    no-undo.
     2085   define variable v-fmtcli-index         as character    no-undo.
     2086   define variable v-fmtcli-schet-exists  as logical      no-undo.
     2087   define variable v-fmtcli-bank-exists   as logical      no-undo.
     2088   define variable v-fmtcli-bank-r-schet  as character    no-undo.
     2089   define variable v-fmtcli-bank-c-schet  as character    no-undo.
     2090   define variable v-fmtcli-bank-bik      as character    no-undo.
     2091   define variable v-fmtcli-bank-name     as character    no-undo.
     2092   define variable v-fmtcli-bank-addres   as character    no-undo.
     2093   define variable v-fmtcli-bank-city     as character    no-undo.
     2094   procedure fmtcli-get-bank :
     2095   define input parameter p-host-code      as integer          no-undo.
     2096   define input parameter p-obj-type       as character        no-undo.
     2097   define input parameter p-obj-code       as integer          no-undo.
     2098   define input parameter p-curr-code      as integer          no-undo.
     2099       define buffer buf_fin-schet     for ub.fin-schet.
     2100       define buffer buf_fin-bank      for ub.fin-bank.
     2101   do
     2102   for buf_fin-schet
     2103     , buf_fin-bank
     2104   on error undo, return error
     2105   :
     2106       assign
     2107           v-fmtcli-schet-exists       = no
     2108           v-fmtcli-bank-exists        = no
     2109           v-fmtcli-bank-r-schet       = "":U
     2110           v-fmtcli-bank-c-schet       = "":U
     2111           v-fmtcli-bank-bik           = "":U
     2112           v-fmtcli-bank-name          = "":U
     2113           v-fmtcli-bank-addres        = "":U
     2114           v-fmtcli-bank-city          = "":U
     2115       .
     2116       search-for-schet:
     2117       for each buf_fin-schet no-lock
     2118          where buf_fin-schet.host-code = p-host-code
     2119            and buf_fin-schet.cli-type  = p-obj-type
     2120            and buf_fin-schet.cli-code  = p-obj-code
     2121            and buf_fin-schet.curr-code = p-curr-code
     2122       on error undo, return error
     2123       :
     2124           if buf_fin-schet.status_   = 'удал':U
     2125           then do:
     2126           end.
     2127           else do:
     2128               assign
     2129                   v-fmtcli-schet-exists   = yes
     2130                   v-fmtcli-bank-r-schet   = trim( buf_fin-schet.r-schet )
     2131                   v-fmtcli-bank-c-schet   = trim( buf_fin-schet.c-schet )
     2132               .
     2133               find first buf_fin-bank no-lock
     2134                    where buf_fin-bank.host-code = p-host-code
     2135                      and buf_fin-bank.code-bank = buf_fin-schet.code-bank
     2136               no-error.
     2137               if available buf_fin-bank
     2138               then do:
     2139                   assign
     2140                       v-fmtcli-bank-exists      = yes
     2141                       v-fmtcli-bank-bik         = trim( buf_fin-bank.bik )
     2142                       v-fmtcli-bank-name        = trim( buf_fin-bank.bank-name )
     2143                       v-fmtcli-bank-addres      = trim(buf_fin-bank.addres)
     2144                       v-fmtcli-bank-city      = trim(buf_fin-bank.bank-city)
     2145                   .
     2146               end.
     2147               else do:
     2148                   assign
     2149                       v-fmtcli-bank-exists    = no
     2150                       v-fmtcli-bank-bik       = "":U
     2151                       v-fmtcli-bank-name      = "":U
     2152                       v-fmtcli-bank-addres    = "":U
     2153                       v-fmtcli-bank-city      = "":U
     2154                   .
     2155               end.
     2156               leave search-for-schet.
     2157           end.
     2158       end.
     2159   end.
     2160   end procedure.
     2161   procedure fmtcli-get-client :
     2162   define input parameter p-obj-type       as character    no-undo.
     2163   define input parameter p-obj-code       as integer      no-undo.
     2164       define variable v-temp-fmtcli-address      as character     no-undo.
     2165       define variable v-num-country-city    as integer      no-undo.
     2166       define buffer buf_clients   for ub.clients.
     2167       define buffer buf_firm      for ub.firm.
     2168       define buffer buf_store     for ub.store.
     2169       define buffer buf_shop      for ub.shop.
     2170       define buffer buf_person    for ub.person.
     2171   do
     2172   for buf_clients
     2173     , buf_firm
     2174     , buf_store
     2175     , buf_shop
     2176     , buf_person
     2177   on error undo, return error
     2178   :
     2179       assign
     2180           v-fmtcli-name           = "":U
     2181           v-fmtcli-addres         = "":U
     2182           v-fmtcli-post-addres    = "":U
     2183           v-fmtcli-full-addres    = "":U
     2184           v-fmtcli-phone          = "":U
     2185           v-fmtcli-inn            = "":U
     2186           v-fmtcli-kpp            = "":U
     2187           v-fmtcli-okpo           = "":U
     2188           v-fmtcli-city           = "":U
     2189           v-fmtcli-index          = "":U
     2190           v-fmtcli-country        = "":U
     2191       .
     2192       find first buf_clients no-lock
     2193            where buf_clients.obj-type = p-obj-type
     2194              and buf_clients.obj-code = p-obj-code
     2195       .
     2196       assign
     2197           v-fmtcli-name = buf_clients.obj-name
     2198       .
     2199       case buf_clients.obj-type:
     2200          when 'орг':U
     2201          then do:
     2202               find first buf_firm no-lock
     2203                    where buf_firm.firm-code = buf_clients.obj-code
     2204                    no-error
     2205               .
     2206               if available buf_firm
     2207               then do:
     2208                   assign
     2209                       v-num-country-city = num-entries( buf_firm.city )
     2210                       v-fmtcli-engl-name = buf_firm.engl-name
     2211                   .
     2212                   if v-num-country-city > 0
     2213                   then do:
     2214                       assign
     2215                           v-fmtcli-country    = trim( entry( 1, buf_firm.city ) )
     2216                       .
     2217                   end.
     2218                   if v-num-country-city > 1
     2219                   then do:
     2220                       assign
     2221                           v-fmtcli-city       = trim( entry( 2, buf_firm.city ) )
     2222                       .
     2223                   end.
     2224                   run fmtcli-concatenate-strings in this-procedure (
     2225                         input v-fmtcli-full-addres
     2226                       , input v-fmtcli-country
     2227                       , input ", ":U
     2228                       , input 50
     2229                       , output v-fmtcli-full-addres
     2230                   ).
     2231                   run fmtcli-concatenate-strings in this-procedure (
     2232                         input v-fmtcli-full-addres
     2233                       , input v-fmtcli-city
     2234                       , input ", ":U
     2235                       , input 50
     2236                       , output v-fmtcli-full-addres
     2237                   ).
     2238                   run fmtcli-concatenate-strings in this-procedure (
     2239                         input v-fmtcli-full-addres
     2240                       , input IF buf_firm.ind = 0 THEN "" ELSE string( buf_firm.ind )
     2241                       , input ", ":U
     2242                       , input 50
     2243                       , output v-fmtcli-full-addres
     2244                   ).
     2245                   run fmtcli-concatenate-strings in this-procedure (
     2246                         input v-fmtcli-post-addres
     2247                       , input v-fmtcli-country
     2248                       , input ", ":U
     2249                       , input 50
     2250                       , output v-fmtcli-post-addres
     2251                   ).
     2252                   run fmtcli-concatenate-strings in this-procedure (
     2253                         input v-fmtcli-post-addres
     2254                       , input v-fmtcli-city
     2255                       , input ", ":U
     2256                       , input 50
     2257                       , output v-fmtcli-post-addres
     2258                   ).
     2259                   run fmtcli-concatenate-strings in this-procedure (
     2260                         input v-fmtcli-post-addres
     2261                       , input string( buf_firm.ind )
     2262                       , input ", ":U
     2263                       , input 50
     2264                       , output v-fmtcli-post-addres
     2265                   ).
     2266                   run fmtcli-concatenate-strings in this-procedure (
     2267                         input substring( buf_firm.addres1, 1, 50 )
     2268                       , input buf_firm.addres2
     2269                       , input " ":U
     2270                       , input 50
     2271                       , output v-temp-fmtcli-address
     2272                   ).
     2273                   run fmtcli-concatenate-strings in this-procedure (
     2274                         input v-temp-fmtcli-address
     2275                       , input substring( buf_firm.addres1, 51, 50 )
     2276                       , input " ":U
     2277                       , input 50
     2278                       , output v-temp-fmtcli-address
     2279                   ).
     2280                   run fmtcli-concatenate-strings in this-procedure (
     2281                         input v-temp-fmtcli-address
     2282                       , input substring( buf_firm.addres1, 101, 50 )
     2283                       , input " ":U
     2284                       , input 50
     2285                       , output v-temp-fmtcli-address
     2286                   ).
     2287                   assign
     2288                       v-fmtcli-addres = v-temp-fmtcli-address
     2289                   .
     2290                   if buf_firm.addres1 <> ?
     2291                   then do:
     2292                       run fmtcli-concatenate-strings in this-procedure (
     2293                             input v-fmtcli-full-addres
     2294                           , input v-fmtcli-addres
     2295                           , input ", ":U
     2296                           , input 0
     2297                           , output v-fmtcli-full-addres
     2298                       ).
     2299                   end.
     2300                   run fmtcli-concatenate-strings in this-procedure (
     2301                         input substring( buf_firm.post-addr1, 1, 50 )
     2302                       , input buf_firm.post-addr2
     2303                       , input " ":U
     2304                       , input 50
     2305                       , output v-fmtcli-post-addres
     2306                   ).
     2307                   run fmtcli-concatenate-strings in this-procedure (
     2308                         input v-fmtcli-post-addres
     2309                       , input substring( buf_firm.post-addr1, 51, 50 )
     2310                       , input " ":U
     2311                       , input 50
     2312                       , output v-fmtcli-post-addres
     2313                   ).
     2314                   run fmtcli-concatenate-strings in this-procedure (
     2315                         input v-fmtcli-post-addres
     2316                       , input substring( buf_firm.post-addr1, 101, 50 )
     2317                       , input " ":U
     2318                       , input 50
     2319                       , output v-fmtcli-post-addres
     2320                   ).
     2321                   assign
     2322                       v-fmtcli-phone         = buf_firm.phone
     2323                       v-fmtcli-inn           = buf_firm.inn
     2324                       v-fmtcli-kpp           = buf_firm.kpp
     2325                       v-fmtcli-okpo          = buf_firm.okpo
     2326                       v-fmtcli-index         = string( buf_firm.ind )
     2327                   .
     2328               end.
     2329          end.
     2330          when 'маг':U
     2331          then do:
     2332               find first buf_shop no-lock
     2333                    where buf_shop.obj-code = buf_clients.obj-code
     2334               .
     2335               if available buf_shop
     2336               then do:
     2337                   run fmtcli-concatenate-strings in this-procedure (
     2338                         input buf_shop.addres1
     2339                       , input buf_shop.addres2
     2340                       , input " ":U
     2341                       , input 50
     2342                       , output v-fmtcli-addres
     2343                   ).
     2344                   assign
     2345                       v-fmtcli-full-addres = v-fmtcli-addres
     2346                       v-fmtcli-post-addres = v-fmtcli-addres
     2347                       v-fmtcli-phone       = buf_shop.phone
     2348                       v-fmtcli-inn         = "":U
     2349                       v-fmtcli-kpp         = "":U
     2350                       v-fmtcli-okpo        = "":U
     2351                       v-fmtcli-city        = "":U
     2352                       v-fmtcli-index       = "":U
     2353                   .
     2354               end.
     2355          end.
     2356          when 'скл':U
     2357          then do:
     2358               find first buf_store no-lock
     2359                    where buf_store.obj-code = buf_clients.obj-code
     2360               .
     2361               if available buf_store
     2362               then do:
     2363                   run fmtcli-concatenate-strings in this-procedure (
     2364                         input buf_store.addres1
     2365                       , input buf_store.addres2
     2366                       , input " ":U
     2367                       , input 50
     2368                       , output v-fmtcli-addres
     2369                   ).
     2370                   assign
     2371                       v-fmtcli-full-addres = v-fmtcli-addres
     2372                       v-fmtcli-phone       = buf_store.phone
     2373                       v-fmtcli-inn         = "":U
     2374                       v-fmtcli-kpp         = "":U
     2375                       v-fmtcli-okpo        = "":U
     2376                       v-fmtcli-city        = "":U
     2377                       v-fmtcli-index       = "":U
     2378                   .
     2379               end.
     2380          end.
     2381          when 'чел':U
     2382          then do:
     2383               find first buf_person no-lock
     2384                    where buf_person.psn-code = buf_clients.obj-code
     2385               .
     2386               if available buf_person
     2387               then do:
     2388                   run fmtcli-concatenate-strings in this-procedure (
     2389                         input ( if buf_person.ind = 0 or buf_person.ind = ?
     2390                                 then "":U
     2391                                 else string( buf_person.ind, "999999")
     2392                                 )
     2393                       , input buf_person.city
     2394                       , input ", ":U
     2395                       , input 0
     2396                       , output v-fmtcli-full-addres
     2397                   ).
     2398                   assign
     2399                       v-fmtcli-addres = buf_person.address
     2400                   .
     2401                   run fmtcli-concatenate-strings in this-procedure (
     2402                         input v-fmtcli-full-addres
     2403                       , input v-fmtcli-addres
     2404                       , input ", ":U
     2405                       , input 0
     2406                       , output v-fmtcli-full-addres
     2407                   ).
     2408                   assign
     2409                       v-fmtcli-phone     = buf_person.phone1
     2410                       v-fmtcli-inn       = buf_person.inn
     2411                       v-fmtcli-kpp       = buf_person.kpp
     2412                       v-fmtcli-okpo      = buf_person.okpo
     2413                       v-fmtcli-city      = buf_person.city
     2414                       v-fmtcli-index     = string( buf_person.ind )
     2415                   .
     2416               end.
     2417          end.
     2418       end case.
     2419   end.
     2420   end procedure.
     2421   procedure fmtcli-concatenate-strings :
     2422   define input parameter p-string-1       as character        no-undo.
     2423   define input parameter p-string-2       as character        no-undo.
     2424   define input parameter p-delimiter      as character        no-undo.
     2425   define input parameter p-length         as integer          no-undo.
     2426   define output parameter p-out-string    as character        no-undo.
     2427   do
     2428   on error undo, return error
     2429   :
     2430       assign
     2431           p-out-string = ( if p-string-1 = ?
     2432                            then "":U
     2433                            else trim( p-string-1 ) )
     2434       .
     2435       assign
     2436           p-out-string = p-out-string
     2437                        + ( if p-out-string = "":U
     2438                            or length( p-out-string ) = p-length
     2439                            or p-string-2 = ?
     2440                            or trim( p-string-2 ) = "":U
     2441                            then "":U
     2442                            else p-delimiter )
     2443                        + ( if p-string-2 = ?
     2444                            or trim( p-string-2 ) = "":U
     2445                            then "":U
     2446                            else trim( p-string-2 ) )
     2447       .
     2448   end.
     2449   end procedure.
