     4335                     part-1.producer-inn = buf_firm.inn
     4336                     part-1.producer-kpp = (if buf_clients-attr.attr-value <> ""
     4337                                           and buf_clients-attr.attr-value <> ?
     4338                                           then buf_clients-attr.attr-value else buf_firm.kpp).
     4339                 end.
     4340                 when 'чел':U then do:
     4341                     find first buf_person no-lock where buf_person.psn-code = imp-or-prod-code.
     4342                     find first buf_clients no-lock where buf_clients.obj-code = imp-or-prod-code
     4343                                                    and   buf_clients.obj-type = imp-or-prod-type.
