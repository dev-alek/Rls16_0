     4422                                                                          ,input obj-list.obj-code
     4423                                                                          ,input alc-goods.artic
     4424                                                                          ,input alc-goods.prod-type
     4425                                                                          ,input alc-goods.prod-code
     4426                                                                          ,input fact-order-start).
