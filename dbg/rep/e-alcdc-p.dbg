     5219                               part-2.supplier-date-to = string(buf_alc-supp-lic.date-to, "99.99.9999")
     5220                               part-2.supplier-get-from = buf_alc-supp-lic.who-are-got.
     5221                           end.
     5222                           run gbl/trdcat-v.p   ( input buf_trn-doc.doc-code
     5223                              , input 'dids':U
     5224                              , output v-attr-val
     5225                              , output v-attr-type
     5226                              ) no-error.
     5227                              part-2.purchase-date = (if v-attr-val <> "" then date(v-attr-val) else buf_trn-doc.fact-date).
     5228                           run gbl/trdcat-v.p   ( input buf_trn-doc.doc-code
     5229                              , input 'nids':U
     5230                              , output v-attr-val
     5231                              , output v-attr-type
     5232                              ) no-error.
     5233                              part-2.TTN = (if v-attr-val <> "" then v-attr-val else "Не определено").
     5234                       end.
     5235                   end.
     5236               end.
     5237           end.
     5238       end.
     5239   end.
     5240   delete object ext-cl no-error .
     5241   delete object ext-FormF1 no-error .
     5242   output stream logStr close .
     5243   define buffer buf_part-1 for part-1 .
     5244   for each part-1 exclusive-lock where part-1.producer-inn <> "" :
     5245       if TOGGLE-KPP then do :
     5246           find first buf_part-1 exclusive-lock where buf_part-1.alc-type-code = part-1.alc-type-code
     5247                                                  and buf_part-1.producer-inn  = part-1.producer-inn
     5248                                                  and buf_part-1.producer-kpp  = part-1.producer-kpp
     5249                                                  and buf_part-1.obj-kpp       = part-1.obj-kpp
     5250                                                  and rowid(buf_part-1) <> rowid(part-1) no-error.
     5251       end.
     5252       else do :
     5253           find first buf_part-1 exclusive-lock where buf_part-1.alc-type-code = part-1.alc-type-code
     5254                                                  and buf_part-1.producer-inn  = part-1.producer-inn
     5255                                                  and buf_part-1.producer-kpp  = part-1.producer-kpp
     5256                                                  and buf_part-1.obj-type      = part-1.obj-type
     5257                                                  and buf_part-1.obj-code      = part-1.obj-code
     5258                                                  and rowid(buf_part-1) <> rowid(part-1) no-error.
     5259       end.
     5260       if available buf_part-1 then do :
     5261           if part-1.prod-code = 0 then do :
     5262               assign
     5263                   buf_part-1.inc-7  = buf_part-1.inc-7  + part-1.inc-7
     5264                   buf_part-1.inc-8  = buf_part-1.inc-8  + part-1.inc-8
     5265                   buf_part-1.inc-9  = buf_part-1.inc-9  + part-1.inc-9
     5266                   buf_part-1.inc-10 = buf_part-1.inc-10 + part-1.inc-10
     5267                   buf_part-1.inc-11 = buf_part-1.inc-11 + part-1.inc-11
     5268                   buf_part-1.inc-12 = buf_part-1.inc-12 + part-1.inc-12
     5269                   buf_part-1.inc-13 = buf_part-1.inc-13 + part-1.inc-13
     5270                   buf_part-1.inc-14 = buf_part-1.inc-14 + part-1.inc-14
     5271                   buf_part-1.exp-15 = buf_part-1.exp-15 + part-1.exp-15
     5272                   buf_part-1.exp-16 = buf_part-1.exp-16 + part-1.exp-16
     5273                   buf_part-1.exp-17 = buf_part-1.exp-17 + part-1.exp-17
     5274                   buf_part-1.exp-18 = buf_part-1.exp-18 + part-1.exp-18
     5275                   buf_part-1.exp-19 = buf_part-1.exp-19 + part-1.exp-19
     5276                   buf_part-1.remain-6 = buf_part-1.remain-6 + part-1.remain-6
     5277                   buf_part-1.remain-20 = buf_part-1.remain-20 + part-1.remain-20
     5278               .
     5279               delete part-1.
     5280               next.
     5281           end.
     5282           if buf_part-1.prod-code = 0 then do :
     5283               assign
     5284                   part-1.inc-7  = part-1.inc-7  + buf_part-1.inc-7
     5285                   part-1.inc-8  = part-1.inc-8  + buf_part-1.inc-8
     5286                   part-1.inc-9  = part-1.inc-9  + buf_part-1.inc-9
     5287                   part-1.inc-10 = part-1.inc-10 + buf_part-1.inc-10
     5288                   part-1.inc-11 = part-1.inc-11 + buf_part-1.inc-11
     5289                   part-1.inc-12 = part-1.inc-12 + buf_part-1.inc-12
     5290                   part-1.inc-13 = part-1.inc-13 + buf_part-1.inc-13
     5291                   part-1.inc-14 = part-1.inc-14 + buf_part-1.inc-14
     5292                   part-1.exp-15 = part-1.exp-15 + buf_part-1.exp-15
     5293                   part-1.exp-16 = part-1.exp-16 + buf_part-1.exp-16
     5294                   part-1.exp-17 = part-1.exp-17 + buf_part-1.exp-17
     5295                   part-1.exp-18 = part-1.exp-18 + buf_part-1.exp-18
     5296                   part-1.exp-19 = part-1.exp-19 + buf_part-1.exp-19
     5297                   part-1.remain-6 = part-1.remain-6 + buf_part-1.remain-6
     5298                   part-1.remain-20 = part-1.remain-20 + buf_part-1.remain-20
     5299               .
     5300               delete buf_part-1.
     5301               next.
     5302           end.
     5303       end.
     5304   end.
     5305   for each part-2 exclusive-lock :
     5306       if TOGGLE-KPP then do :
     5307           find first buf_part-2 exclusive-lock where buf_part-2.alc-type-code = part-2.alc-type-code
     5308                                                  and buf_part-2.producer-inn  = part-2.producer-inn
     5309                                                  and buf_part-2.producer-kpp  = part-2.producer-kpp
     5310                                                  and buf_part-2.obj-kpp       = part-2.obj-kpp
     5311                                                  and buf_part-2.TTN           = part-2.TTN
     5312                                                  and buf_part-2.supplier-type = part-2.supplier-type
     5313                                                  and buf_part-2.supplier-code = part-2.supplier-code
     5314                                                  and rowid(buf_part-2) <> rowid(part-2) no-error.
     5315       end.
     5316       else do :
     5317           find first buf_part-2 exclusive-lock where buf_part-2.alc-type-code = part-2.alc-type-code
     5318                                                  and buf_part-2.producer-inn  = part-2.producer-inn
     5319                                                  and buf_part-2.producer-kpp  = part-2.producer-kpp
     5320                                                  and buf_part-2.obj-type      = part-2.obj-type
     5321                                                  and buf_part-2.obj-code      = part-2.obj-code
     5322                                                  and buf_part-2.TTN           = part-2.TTN
     5323                                                  and buf_part-2.supplier-type = part-2.supplier-type
     5324                                                  and buf_part-2.supplier-code = part-2.supplier-code
     5325                                                  and rowid(buf_part-2) <> rowid(part-2) no-error.
     5326       end.
     5327       if available buf_part-2 then do :
     5328           if part-2.prod-code = 0 then do :
     5329               assign
     5330                   buf_part-2.total = buf_part-2.total + part-2.total
     5331               .
     5332               delete part-2.
     5333               next.
     5334           end.
     5335           if buf_part-2.prod-code = 0 then do :
     5336               assign
     5337                   part-2.total = part-2.total + buf_part-2.total
     5338               .
     5339               delete buf_part-2.
     5340               next.
     5341           end.
     5342       end.
     5343   end.
     5344   define variable new-prod-code as integer no-undo .
     5345   assign new-prod-code = 1 .
     5346   for each part-1 exclusive-lock where part-1.prod-code = 0 break by part-1.prod-type :
     5347       for each part-2 exclusive-lock where part-2.alc-type-code = part-1.alc-type-code
     5348                                        and part-2.prod-code = part-1.prod-code
     5349                                        and part-2.prod-type = part-1.prod-type
     5350                                        and part-2.obj-code  = part-1.obj-code
     5351                                        and part-2.obj-type  = part-1.obj-type :
     5352           assign part-2.prod-code = 10000 + new-prod-code .
     5353       end.
     5354       assign part-1.prod-code = 10000 + new-prod-code .
     5355       if last-of(part-1.prod-type) then assign new-prod-code = new-prod-code + 1 .
     5356   end.
     5357   wait-message = string("Идёт формирование отчета").
     5358   run waitfram-show in this-procedure (input wait-message).
     5359   run print-info .
     5360   if TOGGLE-Excel = yes then run excel-output.
     5361   if TOGGLE-XML = yes then run xml-output.
     5362   run waitfram-hide.
     5363   if v-inn-err
     5364   then do :
     5365       define variable v-user-action    as character no-undo.
     5366       define variable v-printed        as logical   no-undo.
     5367       message "Есть замечания по формированию декларации" view-as alert-box.
     5368       run gbl/prnfilen.w
     5369          (input  "Ошибки алкогольной декларации"
     5370          ,input  0
     5371          ,input  "alc-dec-p_errors.txt"
     5372          ,input  7
     5373          ,output v-user-action
     5374          ,output v-printed
     5375          ).
     5376   end.
     5377   apply "go".
     5378   END PROCEDURE.
     5379   procedure print-info :
     5380       define var v-act-file as char no-undo.
     5381       v-act-file  = session:temp-directory + "rpt" +  "alc-dec_parts-info_beer.html".
     5382       output stream OutStr-html to value(v-act-file) convert target 'UTF-8'.
     5383       put stream OutStr-html unformatted
     5384           substitute(
     5385           '<!doctype html>
     5386                    <html>
     5387                 <head>
     5388                 <meta charset="UTF-8">
     5389                    <!-- Стили документа -->
     5390                 <style>
     5391                   table ~{border-collapse: collapse; ~}
     5392                   tbody td, th ~{border: 1px solid black;~}
     5393                   #myid ~{font-weight: bold;~}
     5394                   .class1 ~{font-style: italic;~}
     5395                   .class2 ~{font-family: Arial;~}
     5396                 </style>
     5397                 </head>
     5398                     <body>
     5399                     <table orientation="landscape" name="лист1" repeat_rows="1:1" hide_zero="True">
     5400                     <thead>
     5401                     <!-- Обязательно создаётся строка таблицы, в которой находятся размеры колонок в px-->
     5402                     <tr class="set_columns">
     5403                           <td style="width:40px"></td>
     5404                           <td style="width:50px"></td>
     5405                           <td style="width:50px"></td>
     5406                           <td style="width:80px"></td>
     5407                           <td style="width:80px"></td>
     5408                           <td style="width:80px"></td>
     5409                           <td style="width:80px"></td>
     5410                           <td style="width:120px"></td>
     5411                           <td style="width:180px"></td>
     5412                           <td style="width:80px"></td>
     5413                           <td style="width:80px"></td>
     5414                           <td style="width:120px"></td>
     5415                           <td style="width:90px"></td>
     5416                           <td style="width:90px"></td>
     5417                           <td style="width:90px"></td>
     5418                           <td style="width:90px"></td>
     5419                           <td style="width:90px"></td>
     5420                           <td style="width:90px"></td>
     5421                           <td style="width:90px"></td>
     5422                           <td style="width:90px"></td>
     5423                           <td style="width:90px"></td>
     5424                           <td style="width:90px"></td>
     5425                           <td style="width:90px"></td>
     5426                           <td style="width:90px"></td>
     5427                           <td style="width:90px"></td>
     5428                     </tr>
     5429                     <tr>
     5430                           <td colspan="25" style="front-weight: bold; text-align: center;">Информация по партиям для алкогольной декларации</td>
     5431                     </tr>
     5432           </thead>
     5433               <tbody>
     5434                   <tr>
     5435                   <th>Код объекта</th>
     5436                   <th>Тип объекта</th>
     5437                   <th>Код АП</th>
     5438                   <th>Номер приходного документа (in-code)</th>
     5439                   <th>Номер документа (out-code)</th>
     5440                   <th>Номер партии (part-code)</th>
     5441                   <th>Артикул</th>
     5442                   <th>Алк. Код</th>
     5443                   <th>Имя произв.</th>
     5444                   <th>ИНН произв.</th>
     5445                   <th>КПП произв.</th>
     5446                   <th>Откуда</th>
     5447                   <th>6</th>
     5448                   <th>7</th>
     5449                   <th>8</th>
     5450                   <th>9</th>
     5451                   <th>10</th>
     5452                   <th>11</th>
     5453                   <th>12</th>
     5454                   <th>13</th>
     5455                   <th>14</th>
     5456                   <th>15</th>
     5457                   <th>16</th>
     5458                   <th>17</th>
     5459                   <th>18</th>
     5460                   </tr>').
     5461       for each tt-parts-info break by tt-parts-info.obj-type by tt-parts-info.obj-code by tt-parts-info.alc-type-code :
     5462           put stream OutStr-html unformatted
     5463               '<tr style="height: 50px;">' skip
     5464                '<td text_wrap="true">' + string(tt-parts-info.obj-type) + '</td>' skip
     5465                '<td text_wrap="true">' + string(tt-parts-info.obj-code) + '</td>' skip
     5466                '<td text_wrap="true">' + string(tt-parts-info.alc-type-code) + '</td>' skip
     5467                '<td text_wrap="true">' + string(tt-parts-info.in-code) + '</td>' skip
     5468                '<td text_wrap="true">' + string(tt-parts-info.out-code) + '</td>' skip
     5469                '<td text_wrap="true">' + string(tt-parts-info.part-code) + '</td>' skip
     5470                '<td text_wrap="true">' + string(tt-parts-info.artic) + '</td>' skip
     5471                '<td text_wrap="true">' + string(tt-parts-info.alc-code) + '</td>' skip
     5472                '<td text_wrap="true">' + string(tt-parts-info.producer-obj-name) + '</td>' skip
     5473                '<td text_wrap="true">' + string(tt-parts-info.producer-inn) + '</td>' skip
     5474                '<td text_wrap="true">' + string(tt-parts-info.producer-kpp) + '</td>' skip
     5475                '<td text_wrap="true">' + string(tt-parts-info.importer) + '</td>' skip
     5476                '<td text_wrap="true">' + string(tt-parts-info.remain-6) + '</td>' skip
     5477                '<td text_wrap="true">' + string(tt-parts-info.inc-7) + '</td>' skip
     5478                '<td text_wrap="true">' + string(tt-parts-info.inc-8) + '</td>' skip
     5479                '<td text_wrap="true">' + string(tt-parts-info.inc-9) + '</td>' skip
     5480                '<td text_wrap="true">' + string(tt-parts-info.inc-10) + '</td>' skip
     5481                '<td text_wrap="true">' + string(tt-parts-info.inc-11) + '</td>' skip
     5482                '<td text_wrap="true">' + string(decimal(tt-parts-info.inc-12) + decimal(tt-parts-info.inc-13)) + '</td>' skip
     5483                '<td text_wrap="true">' + string(tt-parts-info.inc-14) + '</td>' skip
     5484                '<td text_wrap="true">' + string(tt-parts-info.exp-15) + '</td>' skip
     5485                '<td text_wrap="true">' + string(decimal(tt-parts-info.exp-16) + decimal(tt-parts-info.exp-18)) + '</td>' skip
     5486                '<td text_wrap="true">' + string(tt-parts-info.exp-17) + '</td>' skip
     5487                '<td text_wrap="true">' + string(tt-parts-info.exp-19) + '</td>' skip
     5488                '<td text_wrap="true">' + string(tt-parts-info.remain-20) + '</td>' skip
     5489                '</tr>' skip
     5490                '</tbody>' skip
     5491             .
     5492       end.
     5493       output stream OutStr-html close.
     5494   end.
     5495   PROCEDURE excel-output :
     5496   define variable hSAXWriter as handle no-undo.
     5497   define variable xml_tmp as character no-undo.
     5498   define variable xslt as character no-undo.
     5499   define variable nn as integer no-undo.
     5500   define variable Report-out as class Rep-Out no-undo.
     5501   xml_tmp = session:temp-directory + "alc-decl-tmp.xml".
     5502   create sax-writer hSAXWriter.
     5503   hSAXWriter:formatted = true.
     5504   hSAXWriter:encoding = "utf-8":U.
     5505   hSAXWriter:set-output-destination("file":U, xml_tmp).
     5506   hSAXWriter:start-document().
     5507   hSAXWriter:start-element ("report").
     5508   hSAXWriter:start-element ("page-1").
     5509       hSAXWriter:write-data-element ("inn",v-fmtcli-inn).
     5510       hSAXWriter:write-data-element ("kpp",v-fmtcli-kpp).
     5511       hSAXWriter:write-data-element ("quarter",string(quarter)).
     5512       if quarter <> 1 then hSAXWriter:write-data-element ("year",string(year(x-date-start))).
     5513       hSAXWriter:write-data-element ("name",v-fmtcli-name).
     5514       hSAXWriter:write-data-element ("post-code",firm-post-code).
     5515       hSAXWriter:write-data-element ("region",firm-reg-code).
     5516       hSAXWriter:write-data-element ("district",firm-district).
     5517       hSAXWriter:write-data-element ("city", if firm-city <> "" then firm-city else firm-settlement).
     5518       hSAXWriter:write-data-element ("street",firm-street).
     5519       hSAXWriter:write-data-element ("house",if firm-house-number <> "" then "д. " + firm-house-number + firm-house-litera else ""
     5520                                             + if firm-house-case <> "" then " кор. " + firm-house-case  else ""
     5521                                             + if firm-house-apartment <> "" then " кв. " + firm-house-apartment else "").
     5522       hSAXWriter:write-data-element ("phone",v-fmtcli-phone).
     5523       hSAXWriter:write-data-element ("e-mail",firm-e-mail).
     5524       hSAXWriter:write-data-element ("director",firm-director-f + " " + firm-director-i + " " + firm-director-o).
     5525       hSAXWriter:write-data-element ("accountant",firm-accountant-f + " " + firm-accountant-i + " " + firm-accountant-o).
     5526       hSAXWriter:write-data-element ("date",string(day(today), "99") + string(month(today), "99") + string(year(today), "9999")).
     5527   hSAXWriter:end-element ("page-1").
     5528   hSAXWriter:start-element ("page-2").
     5529       hSAXWriter:insert-attribute ("inn",v-fmtcli-inn).
     5530       hSAXWriter:insert-attribute ("kpp",v-fmtcli-kpp).
     5531       for each page-2 no-lock:
     5532           hSAXWriter:start-element ("objects").
     5533               hSAXWriter:write-data-element("o1", page-2.kpp).
     5534               hSAXWriter:write-data-element("o2", page-2.post-code).
     5535               hSAXWriter:write-data-element("o3", page-2.reg-code).
     5536               hSAXWriter:write-data-element("o4", page-2.district).
     5537               hSAXWriter:write-data-element("o5", if page-2.city <> "" then page-2.city else page-2.settlement ).
     5538               hSAXWriter:write-data-element("o6", page-2.street).
     5539               hSAXWriter:write-data-element("o7", if page-2.house-number <> "" then "д. " + page-2.house-number + page-2.house-litera else ""
     5540                                                   + if page-2.house-case <> "" then " кор. " + page-2.house-case  else ""
     5541                                                   + if page-2.apartment <> "" then " кв. " + page-2.apartment else "").
     5542           hSAXWriter:end-element ("objects").
     5543       end.
     5544   hSAXWriter:end-element ("page-2").
     5545   hSAXWriter:start-element ("part-1").
     5546   hSAXWriter:start-element ("firm").
     5547       nn = 1.
     5548       hSAXWriter:write-data-element("header", v-fmtcli-name).
     5549   for each part-1 no-lock break by part-1.alc-type-code:
     5550       accumulate part-1.remain-6  (total).
     5551       accumulate part-1.inc-7     (total).
     5552       accumulate part-1.inc-8     (total).
     5553       accumulate part-1.inc-9     (total).
     5554       accumulate part-1.inc-10    (total).
     5555       accumulate part-1.inc-11    (total).
     5556       accumulate part-1.inc-12    (total).
     5557       accumulate part-1.inc-13    (total).
     5558       accumulate part-1.inc-14    (total).
     5559       accumulate part-1.exp-15    (total).
     5560       accumulate part-1.exp-16    (total).
     5561       accumulate part-1.exp-17    (total).
     5562       accumulate part-1.exp-18    (total).
     5563       accumulate part-1.exp-19    (total).
     5564       accumulate part-1.remain-20 (total).
     5565       accumulate part-1.remain-6  (total by part-1.alc-type-code).
     5566       accumulate part-1.inc-7     (total by part-1.alc-type-code).
     5567       accumulate part-1.inc-8     (total by part-1.alc-type-code).
     5568       accumulate part-1.inc-9     (total by part-1.alc-type-code).
     5569       accumulate part-1.inc-10    (total by part-1.alc-type-code).
     5570       accumulate part-1.inc-11    (total by part-1.alc-type-code).
     5571       accumulate part-1.inc-12    (total by part-1.alc-type-code).
     5572       accumulate part-1.inc-13    (total by part-1.alc-type-code).
     5573       accumulate part-1.inc-14    (total by part-1.alc-type-code).
     5574       accumulate part-1.exp-15    (total by part-1.alc-type-code).
     5575       accumulate part-1.exp-16    (total by part-1.alc-type-code).
     5576       accumulate part-1.exp-17    (total by part-1.alc-type-code).
     5577       accumulate part-1.exp-18    (total by part-1.alc-type-code).
     5578       accumulate part-1.exp-19    (total by part-1.alc-type-code).
     5579       accumulate part-1.remain-20 (total by part-1.alc-type-code).
     5580       if last-of (part-1.alc-type-code) then do:
     5581         hSAXWriter:start-element ("row").
     5582           nn = nn + 1.
     5583           hSAXWriter:write-data-element("n", string(nn)).
     5584           hSAXWriter:write-data-element("c01" ,part-1.alc-type-name).
     5585           hSAXWriter:write-data-element("c02" ,part-1.alc-type-code).
     5586           hSAXWriter:write-data-element("c03" ,"").
     5587           hSAXWriter:write-data-element("c04" ,"").
     5588           hSAXWriter:write-data-element("c05" ,"").
     5589           hSAXWriter:write-data-element("c06" ,string(accum total by part-1.alc-type-code part-1.remain-6 )).
     5590           hSAXWriter:write-data-element("c07" ,string(accum total by part-1.alc-type-code part-1.inc-7    )).
     5591           hSAXWriter:write-data-element("c08" ,string(accum total by part-1.alc-type-code part-1.inc-8    )).
     5592           hSAXWriter:write-data-element("c09" ,string(accum total by part-1.alc-type-code part-1.inc-9    )).
     5593           hSAXWriter:write-data-element("c10" ,string(accum total by part-1.alc-type-code part-1.inc-10   )).
     5594           hSAXWriter:write-data-element("c11" ,string(accum total by part-1.alc-type-code part-1.inc-11   )).
     5595           hSAXWriter:write-data-element("c12" ,string( decimal(accum total by part-1.alc-type-code part-1.inc-12)
     5596                                                      + decimal(accum total by part-1.alc-type-code part-1.inc-13) )).
     5597           hSAXWriter:write-data-element("c13" ,string(accum total by part-1.alc-type-code part-1.inc-14   )).
     5598           hSAXWriter:write-data-element("c14" ,string(accum total by part-1.alc-type-code part-1.exp-15   )).
     5599           hSAXWriter:write-data-element("c15" ,string(decimal(accum total by part-1.alc-type-code part-1.exp-16)
     5600                                                     + decimal(accum total by part-1.alc-type-code part-1.exp-18) )).
     5601           hSAXWriter:write-data-element("c16" ,string(accum total by part-1.alc-type-code part-1.exp-17   )).
     5602           hSAXWriter:write-data-element("c17" ,string(accum total by part-1.alc-type-code part-1.exp-19   )).
     5603           hSAXWriter:write-data-element("c18" ,string(accum total by part-1.alc-type-code part-1.remain-20)).
     5604         hSAXWriter:end-element ("row").
     5605       end.
     5606   end.
     5607         hSAXWriter:start-element ("row").
     5608           nn = nn + 1.
     5609           hSAXWriter:write-data-element("n", string(nn)).
     5610           hSAXWriter:write-data-element("c01" ,"ИТОГО").
     5611           hSAXWriter:write-data-element("c02" ,"").
     5612           hSAXWriter:write-data-element("c03" ,"").
     5613           hSAXWriter:write-data-element("c04" ,"").
     5614           hSAXWriter:write-data-element("c05" ,"").
     5615           hSAXWriter:write-data-element("c06" ,string(accum total part-1.remain-6 )).
     5616           hSAXWriter:write-data-element("c07" ,string(accum total part-1.inc-7    )).
     5617           hSAXWriter:write-data-element("c08" ,string(accum total part-1.inc-8    )).
     5618           hSAXWriter:write-data-element("c09" ,string(accum total part-1.inc-9    )).
     5619           hSAXWriter:write-data-element("c10" ,string(accum total part-1.inc-10   )).
     5620           hSAXWriter:write-data-element("c11" ,string(accum total part-1.inc-11   )).
     5621           hSAXWriter:write-data-element("c12" ,string(decimal(accum total part-1.inc-12)
     5622                                                     + decimal(accum total part-1.inc-13) )).
     5623           hSAXWriter:write-data-element("c13" ,string(accum total part-1.inc-14   )).
     5624           hSAXWriter:write-data-element("c14" ,string(decimal(accum total part-1.exp-16)
     5625                                                     + decimal(accum total part-1.exp-18) )).
     5626           hSAXWriter:write-data-element("c15" ,string(accum total part-1.exp-16   )).
     5627           hSAXWriter:write-data-element("c16" ,string(accum total part-1.exp-17   )).
     5628           hSAXWriter:write-data-element("c17" ,string(accum total part-1.exp-19   )).
     5629           hSAXWriter:write-data-element("c18" ,string(accum total part-1.remain-20)).
     5630         hSAXWriter:end-element ("row").
     5631   hSAXWriter:end-element ("firm").
     5632   for each part-1 no-lock break by part-1.obj-type by part-1.obj-code by part-1.alc-type-code:
     5633       if first-of (part-1.obj-code) then do:
     5634           hSAXWriter:start-element ("object").
     5635           find first buf_clients where buf_clients.obj-code = part-1.obj-code
     5636                                   and buf_clients.obj-type = part-1.obj-type.
     5637           nn = nn + 1.
     5638           hSAXWriter:write-data-element("n", string(nn)).
     5639           hSAXWriter:write-data-element("header", buf_clients.obj-name).
     5640       end.
     5641       accumulate part-1.remain-6  (total by part-1.obj-code).
     5642       accumulate part-1.inc-7     (total by part-1.obj-code).
     5643       accumulate part-1.inc-8     (total by part-1.obj-code).
     5644       accumulate part-1.inc-9     (total by part-1.obj-code).
     5645       accumulate part-1.inc-10    (total by part-1.obj-code).
     5646       accumulate part-1.inc-11    (total by part-1.obj-code).
     5647       accumulate part-1.inc-12    (total by part-1.obj-code).
     5648       accumulate part-1.inc-13    (total by part-1.obj-code).
     5649       accumulate part-1.inc-14    (total by part-1.obj-code).
     5650       accumulate part-1.exp-15    (total by part-1.obj-code).
     5651       accumulate part-1.exp-16    (total by part-1.obj-code).
     5652       accumulate part-1.exp-17    (total by part-1.obj-code).
     5653       accumulate part-1.exp-18    (total by part-1.obj-code).
     5654       accumulate part-1.exp-19    (total by part-1.obj-code).
     5655       accumulate part-1.remain-20 (total by part-1.obj-code).
     5656       hSAXWriter:start-element ("row").
     5657           nn = nn + 1.
     5658           hSAXWriter:write-data-element("n", string(nn)).
     5659           hSAXWriter:write-data-element("c01" , part-1.alc-type-name).
     5660           hSAXWriter:write-data-element("c02" ,string(part-1.alc-type-code)).
     5661           hSAXWriter:write-data-element("c03" ,part-1.producer-obj-name).
     5662           hSAXWriter:write-data-element("c04" ,part-1.producer-inn).
     5663           hSAXWriter:write-data-element("c05" ,part-1.producer-kpp).
     5664           hSAXWriter:write-data-element("c06" ,string(part-1.remain-6)).
     5665           hSAXWriter:write-data-element("c07" ,string(part-1.inc-7)).
     5666           hSAXWriter:write-data-element("c08" ,string(part-1.inc-8)).
     5667           hSAXWriter:write-data-element("c09" ,string(part-1.inc-9)).
     5668           hSAXWriter:write-data-element("c10" ,string(part-1.inc-10)).
     5669           hSAXWriter:write-data-element("c11" ,string(part-1.inc-11)).
     5670           hSAXWriter:write-data-element("c12" ,string(decimal(part-1.inc-12) + decimal(part-1.inc-13) )).
     5671           hSAXWriter:write-data-element("c13" ,string(part-1.inc-14)).
     5672           hSAXWriter:write-data-element("c14" ,string(part-1.exp-15)).
     5673           hSAXWriter:write-data-element("c15" ,string(decimal(part-1.exp-16) + decimal(part-1.exp-18) )).
     5674           hSAXWriter:write-data-element("c16" ,string(part-1.exp-17)).
     5675           hSAXWriter:write-data-element("c17" ,string(part-1.exp-19)).
     5676           hSAXWriter:write-data-element("c18" ,string(part-1.remain-20)).
     5677       hSAXWriter:end-element ("row").
     5678       if last-of (part-1.obj-code) then do:
     5679           hSAXWriter:start-element ("row").
     5680               nn = nn + 1.
     5681               hSAXWriter:write-data-element("n", string(nn)).
     5682               hSAXWriter:write-data-element("c01" ,"ИТОГО").
     5683               hSAXWriter:write-data-element("c02" ,"").
     5684               hSAXWriter:write-data-element("c03" ,"").
     5685               hSAXWriter:write-data-element("c04" ,"").
     5686               hSAXWriter:write-data-element("c05" ,"").
     5687               hSAXWriter:write-data-element("c06" ,string(accum total by part-1.obj-code part-1.remain-6 )).
     5688               hSAXWriter:write-data-element("c07" ,string(accum total by part-1.obj-code part-1.inc-7    )).
     5689               hSAXWriter:write-data-element("c08" ,string(accum total by part-1.obj-code part-1.inc-8    )).
     5690               hSAXWriter:write-data-element("c09" ,string(accum total by part-1.obj-code part-1.inc-9    )).
     5691               hSAXWriter:write-data-element("c10" ,string(accum total by part-1.obj-code part-1.inc-10   )).
     5692               hSAXWriter:write-data-element("c11" ,string(accum total by part-1.obj-code part-1.inc-11   )).
     5693               hSAXWriter:write-data-element("c12" ,string(decimal (accum total by part-1.obj-code part-1.inc-12)
     5694                                                         + decimal (accum total by part-1.obj-code part-1.inc-13) )).
     5695               hSAXWriter:write-data-element("c13" ,string(accum total by part-1.obj-code part-1.inc-14   )).
     5696               hSAXWriter:write-data-element("c14" ,string(accum total by part-1.obj-code part-1.exp-15   )).
     5697               hSAXWriter:write-data-element("c15" ,string(decimal (accum total by part-1.obj-code part-1.exp-16)
     5698                                                         + decimal (accum total by part-1.obj-code part-1.exp-18) )).
     5699               hSAXWriter:write-data-element("c16" ,string(accum total by part-1.obj-code part-1.exp-17   )).
     5700               hSAXWriter:write-data-element("c17" ,string(accum total by part-1.obj-code part-1.exp-19   )).
     5701               hSAXWriter:write-data-element("c18" ,string(accum total by part-1.obj-code part-1.remain-20)).
     5702           hSAXWriter:end-element ("row").
     5703          hSAXWriter:end-element ("object").
     5704       end.
     5705   end.
     5706   hSAXWriter:end-element ("part-1").
     5707   hSAXWriter:start-element ("part-2").
     5708   hSAXWriter:start-element ("firm").
     5709       nn = 1.
     5710       hSAXWriter:write-data-element ("header", v-fmtcli-name ).
     5711   for each part-2 no-lock break by part-2.alc-type-code:
     5712       accumulate part-2.total (total).
     5713       accumulate part-2.total (total by part-2.alc-type-code).
     5714       if last-of (part-2.alc-type-code) then do:
     5715         hSAXWriter:start-element ("row").
     5716           nn = nn + 1.
     5717           hSAXWriter:write-data-element ("n", string(nn)).
     5718           hSAXWriter:write-data-element("c01" ,part-2.alc-type-name).
     5719           hSAXWriter:write-data-element("c02" ,part-2.alc-type-code).
     5720           hSAXWriter:write-data-element("c03" ,"").
     5721           hSAXWriter:write-data-element("c04" ,"").
     5722           hSAXWriter:write-data-element("c05" ,"").
     5723           hSAXWriter:write-data-element("c06" ,"").
     5724           hSAXWriter:write-data-element("c07" ,"").
     5725           hSAXWriter:write-data-element("c08" ,"").
     5726           hSAXWriter:write-data-element("c09" ,"").
     5727           hSAXWriter:write-data-element("c10" ,"").
     5728           hSAXWriter:write-data-element("c11" ,"").
     5729           hSAXWriter:write-data-element("c12" ,string(accum total by part-2.alc-type-code part-2.total)).
     5730         hSAXWriter:end-element ("row").
     5731       end.
     5732   end.
     5733         hSAXWriter:start-element ("row").
     5734           nn = nn + 1.
     5735           hSAXWriter:write-data-element ("n", string(nn)).
     5736           hSAXWriter:write-data-element("c01" ,"Итого").
     5737           hSAXWriter:write-data-element("c02" ,"").
     5738           hSAXWriter:write-data-element("c03" ,"").
     5739           hSAXWriter:write-data-element("c04" ,"").
     5740           hSAXWriter:write-data-element("c05" ,"").
     5741           hSAXWriter:write-data-element("c06" ,"").
     5742           hSAXWriter:write-data-element("c07" ,"").
     5743           hSAXWriter:write-data-element("c08" ,"").
     5744           hSAXWriter:write-data-element("c09" ,"").
     5745           hSAXWriter:write-data-element("c10" ,"").
     5746           hSAXWriter:write-data-element("c11" ,"").
     5747           hSAXWriter:write-data-element("c12" ,string(accum total part-2.total)).
     5748         hSAXWriter:end-element ("row").
     5749   hSAXWriter:end-element ("firm").
     5750   for each part-2 no-lock break by part-2.obj-type by part-2.obj-code by part-2.purchase-date:
     5751       if first-of(part-2.obj-code) then do:
     5752           hSAXWriter:start-element ("object").
     5753           find first buf_clients where buf_clients.obj-code = part-2.obj-code
     5754                                   and buf_clients.obj-type = part-2.obj-type.
     5755           nn = nn + 1.
     5756           hSAXWriter:write-data-element ("n", string(nn)).
     5757           hSAXWriter:write-data-element ("header", buf_clients.obj-name).
     5758       end.
     5759       accumulate part-2.total (total by part-2.obj-code).
     5760       hSAXWriter:start-element ("row").
     5761           nn = nn + 1.
     5762           hSAXWriter:write-data-element ("n", string(nn)).
     5763           hSAXWriter:write-data-element("c01", part-2.alc-type-name).
     5764           hSAXWriter:write-data-element("c02", part-2.alc-type-code).
     5765           hSAXWriter:write-data-element("c03", part-2.producer-obj-name).
     5766           hSAXWriter:write-data-element("c04", part-2.producer-inn).
     5767           hSAXWriter:write-data-element("c05", part-2.producer-kpp).
     5768           hSAXWriter:write-data-element("c06", part-2.supplier-obj-name).
     5769           hSAXWriter:write-data-element("c07", part-2.supplier-inn).
     5770           hSAXWriter:write-data-element("c08", part-2.supplier-kpp).
     5771           hSAXWriter:write-data-element("c09", string(part-2.purchase-date)).
     5772           hSAXWriter:write-data-element("c10", part-2.TTN).
     5773           hSAXWriter:write-data-element("c11", part-2.GTD).
     5774           hSAXWriter:write-data-element("c12", string(part-2.total)).
     5775       hSAXWriter:end-element ("row").
     5776       if last-of (part-2.obj-code) then do:
     5777           hSAXWriter:start-element ("row").
     5778               nn = nn + 1.
     5779               hSAXWriter:write-data-element ("n", string(nn)).
     5780               hSAXWriter:write-data-element("c01", "ИТОГО").
     5781               hSAXWriter:write-data-element("c02", "").
     5782               hSAXWriter:write-data-element("c03", "").
     5783               hSAXWriter:write-data-element("c04", "").
     5784               hSAXWriter:write-data-element("c05", "").
     5785               hSAXWriter:write-data-element("c06", "").
     5786               hSAXWriter:write-data-element("c07", "").
     5787               hSAXWriter:write-data-element("c08", "").
     5788               hSAXWriter:write-data-element("c09", "").
     5789               hSAXWriter:write-data-element("c10", "").
     5790               hSAXWriter:write-data-element("c11", "").
     5791               hSAXWriter:write-data-element("c12", string(accum total by part-2.obj-code part-2.total)).
     5792           hSAXWriter:end-element ("row").
     5793          hSAXWriter:end-element ("object").
     5794       end.
     5795   end.
     5796   hSAXWriter:end-element ("part-2").
     5797   hSAXWriter:end-element ("report").
     5798   hSAXWriter:end-document().
     5799   delete object hSAXWriter no-error.
     5800   xslt = search("exe\alcdc-pril12.xsl").
     5801   Report-out = new Rep-Out().
     5802   Report-out:office(xml_tmp, xslt).
     5803   delete object Report-out.
     5804   end procedure.
     5805   PROCEDURE xml-output :
     5806   define variable hSAXWriter as handle no-undo.
     5807   define variable xml        as character no-undo.
     5808   define variable ii-ob   as integer no-undo.
     5809   define variable ii-impr as integer no-undo.
     5810   define variable ii-pos  as integer no-undo.
     5811   define variable ii-dv   as integer no-undo.
     5812   define variable MyUUID as raw       no-undo.
     5813   define variable vGUID  as character no-undo.
     5814   assign
     5815     MyUUID = generate-uuid
     5816     vGUID  = guid(MyUUID).
     5817     ii = 0.
     5818   xml = session:temp-directory + "R2_" + v-fmtcli-inn + "_" + string(quarter, "99") + substring(string(year(today)), 4, 1) + "_" +
     5819         string(day(today), "99") + string(month(today), "99") + string(year(today), "9999") + "_" + vGUID + ".xml".
     5820   create sax-writer hSAXWriter.
     5821   hSAXWriter:formatted = true.
     5822   hSAXWriter:encoding = "windows-1251":U.
     5823   hSAXWriter:set-output-destination("file":U, xml).
     5824   hSAXWriter:start-document().
     5825   hSAXWriter:start-element ("Файл").
     5826       hSAXWriter:insert-attribute ("ДатаДок", string(day(today), "99") + "." + string(month(today), "99")  + "." + string(year(today), "9999")).
     5827       case RADIO-SET-ver:
     5828           when 1 then hSAXWriter:insert-attribute ("ВерсФорм", "4.31").
     5829           when 3 then hSAXWriter:insert-attribute ("ВерсФорм", "4.30").
     5830           when 2 then hSAXWriter:insert-attribute ("ВерсФорм", "4.20").
     5831       end case.
     5832       hSAXWriter:insert-attribute ("НаимПрог", "Trade House").
     5833       hSAXWriter:start-element ("ФормаОтч").
     5834           case RADIO-SET-ver:
     5835               when 1 then do:
     5836                   hSAXWriter:insert-attribute ("НомФорм", "12").
     5837                   hSAXWriter:insert-attribute ("ПризПериодОтч", string(quarter)).
     5838                   hSAXWriter:insert-attribute ("ГодПериодОтч", string(year(x-date-start))).
     5839               end.
     5840               when 3 then do:
     5841                   hSAXWriter:insert-attribute ("НомФорм", "12").
     5842                   hSAXWriter:insert-attribute ("ПризПериодОтч", string(quarter)).
     5843                   hSAXWriter:insert-attribute ("ГодПериодОтч", string(year(x-date-start))).
     5844               end.
     5845               when 2 then do:
     5846                   hSAXWriter:insert-attribute ("ГодПериодОтч", string(year(x-date-start))).
     5847                   hSAXWriter:insert-attribute ("НомФорм", "12-о").
     5848                   hSAXWriter:insert-attribute ("ПризПериодОтч", string(quarter)).
     5849                   hSAXWriter:insert-attribute ("ПризФОтч", "4").
     5850               end.
     5851           end case.
     5852           case RADIO-SET-form:
     5853               when 1 then do:
     5854           hSAXWriter:write-empty-element("Первичная").
     5855               end.
     5856               when 2 then do:
     5857                   hSAXWriter:write-empty-element("Корректирующая").
     5858                       hSAXWriter:insert-attribute ("НомерКорр", string(FILL-IN-kor)).
     5859               end.
     5860           end case.
     5861       hSAXWriter:end-element ("ФормаОтч").
     5862       hSAXWriter:start-element ("Справочники").
     5863           ii = 0.
     5864           for each part-1 no-lock break by part-1.prod-type by part-1.prod-code:
     5865               if last-of(part-1.prod-code) then do:
     5866               ii = ii + 1.
     5867               hSAXWriter:start-element ("ПроизводителиИмпортеры").
     5868                   hSAXWriter:insert-attribute ("ИДПроизвИмп", if part-1.prod-type = 'чел':U then string(part-1.prod-code + 1000) else string(part-1.prod-code)).
     5869                   hSAXWriter:insert-attribute ("П000000000004", part-1.producer-obj-name).
     5870                   hSAXWriter:write-empty-element ("ЮЛ").
     5871                       hSAXWriter:insert-attribute ("П000000000005", part-1.producer-inn).
     5872                       hSAXWriter:insert-attribute ("П000000000006", part-1.producer-kpp).
     5873               hSAXWriter:end-element ("ПроизводителиИмпортеры").
     5874               end.
     5875           end.
     5876           for each part-2 no-lock break by part-2.supplier-type by part-2.supplier-code:
     5877               if first-of(part-2.supplier-code) then do:
     5878                   ii = ii + 1.
     5879                   hSAXWriter:start-element ("Поставщики").
     5880                       hSAXWriter:insert-attribute ("ИдПостав", if part-2.supplier-type = 'чел':U then string(part-2.supplier-code + 1000) else string(part-2.supplier-code)).
     5881                       hSAXWriter:insert-attribute ("П000000000007", part-2.supplier-obj-name).
     5882                           hSAXWriter:write-empty-element ("ЮЛ").
     5883                               hSAXWriter:insert-attribute ("П000000000009", part-2.supplier-inn).
     5884                               hSAXWriter:insert-attribute ("П000000000010", part-2.supplier-kpp).
     5885                   hSAXWriter:end-element ("Поставщики").
     5886               end.
     5887           end.
     5888       hSAXWriter:end-element ("Справочники").
     5889       hSAXWriter:start-element ("Документ").
     5890           hSAXWriter:start-element ("Организация").
     5891               hSAXWriter:start-element ("Реквизиты").
     5892                   case RADIO-SET-ver:
     5893                       when 1 then hSAXWriter:insert-attribute ("Наим", v-fmtcli-name).
     5894                       when 3 then hSAXWriter:insert-attribute ("НаимОрг", v-fmtcli-name).
     5895                       when 2 then hSAXWriter:insert-attribute ("НаимОрг", v-fmtcli-name).
     5896                   end case.
     5897                   hSAXWriter:insert-attribute ("ТелОрг", v-fmtcli-phone).
     5898                   hSAXWriter:insert-attribute ("EmailОтпр", firm-e-mail).
     5899                   hSAXWriter:start-element ("АдрОрг").
     5900                       hSAXWriter:write-data-element ("КодСтраны", firm-country-code).
     5901                       hSAXWriter:write-data-element ("Индекс", firm-post-code).
     5902                       hSAXWriter:write-data-element ("КодРегион", string(integer(firm-reg-code), "99")).
     5903                       hSAXWriter:write-data-element ("Район", firm-district).
     5904                       hSAXWriter:write-data-element ("Город", firm-city).
     5905                       hSAXWriter:write-data-element ("НаселПункт", firm-settlement).
     5906                       hSAXWriter:write-data-element ("Улица", firm-street).
     5907                       hSAXWriter:write-data-element ("Дом", firm-house-number).
     5908                       hSAXWriter:write-data-element ("Корпус", firm-house-case).
     5909                       hSAXWriter:write-data-element ("Литера", firm-house-litera).
     5910                       hSAXWriter:write-data-element ("Кварт", firm-house-apartment).
     5911                   hSAXWriter:end-element ("АдрОрг").
     5912                   hSAXWriter:write-empty-element ("ЮЛ").
     5913                       hSAXWriter:insert-attribute ("ИННЮЛ", v-fmtcli-inn).
     5914                       hSAXWriter:insert-attribute ("КППЮЛ", v-fmtcli-kpp).
     5915               hSAXWriter:end-element ("Реквизиты").
     5916               hSAXWriter:start-element ("ОтветЛицо").
     5917                   hSAXWriter:start-element ("Руководитель").
     5918                       hSAXWriter:write-data-element ("Фамилия", firm-director-f).
     5919                       hSAXWriter:write-data-element ("Имя", firm-director-i).
     5920                       hSAXWriter:write-data-element ("Отчество", firm-director-o).
     5921                   hSAXWriter:end-element ("Руководитель").
     5922                   hSAXWriter:start-element ("Главбух").
     5923                       hSAXWriter:write-data-element ("Фамилия", firm-accountant-f).
     5924                       hSAXWriter:write-data-element ("Имя", firm-accountant-i).
     5925                       hSAXWriter:write-data-element ("Отчество", firm-accountant-o).
     5926                   hSAXWriter:end-element ("Главбух").
     5927               hSAXWriter:end-element ("ОтветЛицо").
     5928           hSAXWriter:end-element ("Организация").
     5929           for each page-2 no-lock:
     5930               hSAXWriter:start-element ("ОбъемОборота").
     5931                   hSAXWriter:insert-attribute ("КППЮЛ", page-2.kpp).
     5932                   case RADIO-SET-ver:
     5933                       when 1 then hSAXWriter:insert-attribute ("Наим", page-2.obj-name).
     5934                       when 3 then hSAXWriter:insert-attribute ("НаимЮЛ", page-2.obj-name).
     5935                       when 2 then hSAXWriter:insert-attribute ("НаимЮЛ", page-2.obj-name).
     5936                   end case.
     5937                   if can-find (first part-1 where part-1.obj-type = page-2.obj-type
     5938                                             and   part-1.obj-code = page-2.obj-code
     5939                                             and   (part-1.inc-14 <> 0 or part-1.exp-19 <> 0 ))
     5940                   then do:
     5941                       hSAXWriter:insert-attribute ("НаличиеОборота", "true").
     5942                   end.
     5943                   else do:
     5944                       hSAXWriter:insert-attribute ("НаличиеОборота", "false").
     5945                   end.
     5946                   hSAXWriter:start-element ("АдрОрг").
     5947                       hSAXWriter:write-data-element ("КодСтраны", page-2.country-code).
     5948                       hSAXWriter:write-data-element ("Индекс", page-2.post-code).
     5949                       hSAXWriter:write-data-element ("КодРегион", string(integer(page-2.reg-code), "99")).
     5950                       hSAXWriter:write-data-element ("Район", page-2.district).
     5951                       hSAXWriter:write-data-element ("Город", page-2.city).
     5952                       hSAXWriter:write-data-element ("НаселПункт", page-2.settlement).
     5953                       hSAXWriter:write-data-element ("Улица", page-2.street).
     5954                       hSAXWriter:write-data-element ("Дом", page-2.house-number).
     5955                       hSAXWriter:write-data-element ("Корпус", page-2.house-case).
     5956                       hSAXWriter:write-data-element ("Литера", page-2.house-litera).
     5957                       hSAXWriter:write-data-element ("Кварт", page-2.apartment).
     5958                   hSAXWriter:end-element ("АдрОрг").
     5959                   ii-ob = 0.
     5960                   for each part-1 no-lock where part-1.obj-code = page-2.obj-code
     5961                                           and   part-1.obj-type = page-2.obj-type
     5962                                           break by part-1.alc-type-code:
     5963                       if first-of(part-1.alc-type-code) then do:
     5964                           ii-impr = 0.
     5965                           ii-ob = ii-ob + 1.
     5966                           hSAXWriter:start-element ("Оборот").
     5967                               hSAXWriter:insert-attribute ("ПN", string(ii-ob)).
     5968                               hSAXWriter:insert-attribute ("П000000000003", part-1.alc-type-code).
     5969                       end.
     5970                       hSAXWriter:start-element ("СведПроизвИмпорт").
     5971                           ii-impr = ii-impr + 1.
     5972                           hSAXWriter:insert-attribute ("ПN", string(ii-impr)).
     5973                           hSAXWriter:insert-attribute ("ИдПроизвИмп", if part-1.prod-type = 'чел':U then string(part-1.prod-code + 1000) else string(part-1.prod-code)).
     5974                           ii-pos = 0.
     5975                           for each part-2 where part-2.alc-type-code = part-1.alc-type-code
     5976                                           and  (
     5977                                                 (part-2.prod-code = part-1.prod-code and part-2.prod-type = part-1.prod-type)
     5978                                              or (part-2.producer-inn = part-1.producer-inn and part-2.producer-kpp = part-1.producer-kpp)
     5979                                                   )
     5980                                           and   part-2.obj-code  = part-1.obj-code
     5981                                           and   part-2.obj-type  = part-1.obj-type
     5982                                           break by part-2.supplier-code:
     5983                               if first-of(part-2.supplier-code) then do:
     5984                                   ii-pos = ii-pos + 1.
     5985                                   hSAXWriter:start-element ("Поставщик").
     5986                                       hSAXWriter:insert-attribute ("ПN", string(ii-impr)).
     5987                                       hSAXWriter:insert-attribute ("ИдПоставщика", if part-2.supplier-type = 'чел':U then string(part-2.supplier-code + 1000) else string(part-2.supplier-code)).
     5988                               end.
     5989                               hSAXWriter:write-empty-element ("Продукция").
     5990                                   hSAXWriter:insert-attribute ("П200000000013", string(part-2.purchase-date, "99.99.9999")).
     5991                                   hSAXWriter:insert-attribute ("П200000000014", part-2.TTN).
     5992                                   hSAXWriter:insert-attribute ("П200000000015", part-2.GTD).
     5993                                   hSAXWriter:insert-attribute ("П200000000016", string(part-2.total)).
     5994                               if last-of(part-2.supplier-code) then do:
     5995                                   hSAXWriter:end-element ("Поставщик").
     5996                               end.
     5997                           end.
     5998                           hSAXWriter:write-empty-element ("Движение").
     5999                               hSAXWriter:insert-attribute ("ПN", "1").
     6000                               hSAXWriter:insert-attribute ("П100000000006", string(part-1.remain-6)).
     6001                               hSAXWriter:insert-attribute ("П100000000007", string(part-1.inc-7)).
     6002                               hSAXWriter:insert-attribute ("П100000000008", string(part-1.inc-8)).
     6003                               hSAXWriter:insert-attribute ("П100000000009", string(part-1.inc-9)).
     6004                               hSAXWriter:insert-attribute ("П100000000010", string(part-1.inc-10)).
     6005                               hSAXWriter:insert-attribute ("П100000000011", string(part-1.inc-11)).
     6006                               hSAXWriter:insert-attribute ("П100000000012", string(decimal(part-1.inc-12) + decimal(part-1.inc-13))).
     6007                               hSAXWriter:insert-attribute ("П100000000013", string(part-1.inc-14)).
     6008                               hSAXWriter:insert-attribute ("П100000000014", string(part-1.exp-15)).
     6009                               hSAXWriter:insert-attribute ("П100000000015", string(decimal(part-1.exp-16) + decimal(part-1.exp-18))).
     6010                               hSAXWriter:insert-attribute ("П100000000016", string(part-1.exp-17)).
     6011                               hSAXWriter:insert-attribute ("П100000000017", string(part-1.exp-19)).
     6012                               hSAXWriter:insert-attribute ("П100000000018", string(part-1.remain-20)).
     6013                           hSAXWriter:end-element ("СведПроизвИмпорт").
     6014                       if last-of(part-1.alc-type-code) then do:
     6015                           hSAXWriter:end-element ("Оборот").
     6016                       end.
     6017                   end.
     6018               hSAXWriter:end-element ("ОбъемОборота").
     6019           end.
     6020       hSAXWriter:end-element ("Документ").
     6021   hSAXWriter:end-element ("Файл").
     6022   hSAXWriter:end-document().
     6023   delete object hSAXWriter no-error.
     6024   message "Вывод в XML завершен." skip
     6025           "Путь к сформированному файлу: " skip
     6026           xml
     6027   view-as alert-box information.
     6028   end procedure.
     6029   PROCEDURE local-initialize :
     6030     RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     6031       assign
     6032       EDITOR-ALC-PRODUCER = "По всем производителям"
     6033       EDITOR-SUPPLIER = "По всем поставщикам"
     6034       EDITOR-ALC-TYPE = "По всем типам продукции"
     6035       TOGGLE-Excel    = yes
     6036       TOGGLE-XML      = yes.
     6037       display EDITOR-ALC-PRODUCER EDITOR-SUPPLIER EDITOR-ALC-TYPE TOGGLE-Excel TOGGLE-XML with frame F-Main.
     6038       assign FILL-IN-kor:hidden in frame F-Main = true.
     6039   END PROCEDURE.
     6040   PROCEDURE my-params :
     6041   END PROCEDURE.
     6042   PROCEDURE my-var :
     6043   END PROCEDURE.
     6044   PROCEDURE write-to-log :
     6045   define input param p-str as char no-undo.
     6046   do
     6047   on error undo, return error
     6048   :
     6049      message
     6050         p-str
     6051         skip
     6052      view-as alert-box error.
     6053   end.
     6054   END PROCEDURE.
     6055   procedure my-init-temp-parts-by-factord :
     6056     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
     6057     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
     6058     define input parameter p-artic              like ub.parts.artic     no-undo .
     6059     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
     6060     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
     6061     define input parameter p-fact-order         as decimal   no-undo .
     6062     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
     6063     define buffer buf_gds-obj  for ub.gds-obj .
     6064     do
     6065     on error undo, return error
     6066     :
     6067       do transaction
     6068       on error undo, return error
     6069       :
     6070   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6071   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     6072     (input  p-obj-type
     6073     ,input  p-obj-code
     6074     ,input  p-artic
     6075     ,input  p-prod-type
     6076     ,input  p-prod-code
     6077     ,buffer buf_gds-obj
     6078     ) no-error .
     6079         if error-status :error
     6080         then do:
     6081           message
     6082             vss-workfile vss-revision vss-description skip
     6083             "Невозможно найти товар на объекте" skip
     6084             "Объект" p-obj-type p-obj-code skip
     6085             "Артикул" p-artic p-prod-type p-prod-code skip
     6086             error-status :get-message(1) skip
     6087             return-value skip
     6088             view-as alert-box error .
     6089           undo, return error .
     6090         end.
     6091         find current buf_gds-obj exclusive-lock .
     6092       end.
     6093       run partslib-init-temp-parts in this-procedure
     6094         (input p-obj-type
     6095         ,input p-obj-code
     6096         ,input p-artic
     6097         ,input p-prod-type
     6098         ,input p-prod-code
     6099         ) no-error .
     6100       if error-status :error
     6101       then do:
     6102         message
     6103           vss-workfile vss-revision vss-description skip
     6104           "Ошибка при инициализации текущего остатка по партиям свободной зоны" skip
     6105           "Объект" p-obj-type p-obj-code skip
     6106           "Артикул" p-artic p-prod-type p-prod-code skip
     6107           "p-fact-order" p-fact-order skip
     6108           view-as alert-box error .
     6109         undo, return error .
     6110       end.
     6111       assign
     6112         p-fact-order = p-fact-order - 0.0000000001
     6113       .
     6114       define variable v-max-fact-order as character no-undo .
     6115       run factord-max-fact-order in this-procedure
     6116         (output v-max-fact-order
     6117         ) no-error .
     6118       if error-status :error
     6119       then do:
     6120         message
     6121           vss-workfile vss-revision vss-description skip
     6122           "Ошибка при вызове процедуры factord-max-fact-order" skip
     6123           "Объект" p-obj-type p-obj-code skip
     6124           "Артикул" p-artic p-prod-type p-prod-code skip
     6125           "p-fact-order" p-fact-order skip
     6126           view-as alert-box error .
     6127         undo, return error .
     6128       end.
     6129       run my-update-by-factord in this-procedure
     6130         (input p-obj-type
     6131         ,input p-obj-code
     6132         ,input p-artic
     6133         ,input p-prod-type
     6134         ,input p-prod-code
     6135         ,input p-fact-order
     6136         ,input v-max-fact-order
     6137         ) no-error .
     6138       if error-status :error
     6139       then do:
     6140         message
     6141           vss-workfile vss-revision vss-description skip
     6142           "Ошибка при вызове процедуры partslib-update-by-factord" skip
     6143           "Объект" p-obj-type p-obj-code skip
     6144           "Артикул" p-artic p-prod-type p-prod-code skip
     6145           "p-fact-order" p-fact-order skip
     6146           "v-max-fact-order" v-max-fact-order skip
     6147           view-as alert-box error .
     6148         undo, return error .
     6149       end.
     6150     end.
     6151   end procedure.
     6152   procedure my-update-by-factord :
     6153     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
     6154     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
     6155     define input parameter p-artic              like ub.parts.artic     no-undo .
     6156     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
     6157     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
     6158     define input parameter p-start-fact-order   as decimal   no-undo .
     6159     define input parameter p-end-fact-order     as decimal   no-undo .
     6160     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
     6161     define buffer buf_gds-obj  for ub.gds-obj .
     6162     define buffer buf_doc-line for ub.doc-line .
     6163     define variable v-total-parts-qnty as decimal   no-undo .
     6164     define variable v-goods-gds-goods  as logical   no-undo .
     6165     define variable v-goods-twounit    as logical   no-undo .
     6166     define variable v-kpp2            as character no-undo .
     6167     do
     6168     on error undo, return error
     6169     :
     6170       if p-start-fact-order > p-end-fact-order
     6171       then do:
     6172         message
     6173           vss-workfile vss-revision vss-description skip
     6174           "Ошибка задания входных параметров" skip
     6175           "Начало интервала превышает конец интервала" skip
     6176           "Объект" p-obj-type p-obj-code skip
     6177           "Артикул" p-artic p-prod-type p-prod-code skip
     6178           "p-start-fact-order" p-start-fact-order skip
     6179           "p-end-fact-order"   p-end-fact-order skip
     6180           view-as alert-box error .
     6181         undo, return error .
     6182       end.
     6183   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6184   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     6185     (input  p-artic
     6186     ,input  p-prod-type
     6187     ,input  p-prod-code
     6188     ,input  'gds-goods=request':u
     6189     ,output v-goods-gds-goods
     6190     ) no-error .
     6191       if error-status :error
     6192       then do:
     6193         message
     6194           vss-workfile vss-revision vss-description skip
     6195           "Ошибка при определении атрибута товара" skip
     6196           "Артикул" p-artic p-prod-type p-prod-code skip
     6197           "gds-goods=request" skip
     6198           error-status :get-message(1) skip
     6199           return-value skip
     6200           view-as alert-box error .
     6201         undo, return error return-value .
     6202       end.
     6203   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6204   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     6205     (input  p-artic
     6206     ,input  p-prod-type
     6207     ,input  p-prod-code
     6208     ,input  'twounit=request':u
     6209     ,output v-goods-twounit
     6210     ) no-error .
     6211       if error-status :error
     6212       then do:
     6213         message
     6214           vss-workfile vss-revision vss-description skip
     6215           "Ошибка при определении атрибута товара" skip
     6216           "Артикул" p-artic p-prod-type p-prod-code skip
     6217           "twounit=request" skip
     6218           error-status :get-message(1) skip
     6219           return-value skip
     6220           view-as alert-box error .
     6221         undo, return error return-value .
     6222       end.
     6223       for each buf_doc-line no-lock
     6224         where buf_doc-line.obj-type   = p-obj-type
     6225           and buf_doc-line.obj-code   = p-obj-code
     6226           and buf_doc-line.artic      = p-artic
     6227           and buf_doc-line.prod-type  = p-prod-type
     6228           and buf_doc-line.prod-code  = p-prod-code
     6229           and buf_doc-line.status_    = 'факт':U
     6230           and buf_doc-line.fact-order > p-start-fact-order
     6231           and buf_doc-line.fact-order <= p-end-fact-order
     6232       on error undo, return error
     6233       :
     6234         if (buf_doc-line.ext-doc-type = 'iv' or buf_doc-line.ext-doc-type = 'ev' or buf_doc-line.ext-doc-type = 'rv')
     6235         then do :
     6236           for first buf_trn-doc no-lock where buf_trn-doc.doc-code = buf_doc-line.doc-code :
     6237               v-kpp = "" .
     6238               for first buf_clients-attr no-lock where buf_clients-attr.obj-code  = buf_trn-doc.cli-code
     6239                                                  and   buf_clients-attr.obj-type  = buf_trn-doc.cli-type
     6240                                                  and   buf_clients-attr.attr-code = 'kpp':U:
     6241                   v-kpp = buf_clients-attr.attr-value.
     6242               end.
     6243               if v-kpp = "" then  v-kpp = v-fmtcli-kpp.
     6244               v-kpp2 = "" .
     6245               for first buf_clients-attr no-lock where buf_clients-attr.obj-code  = buf_trn-doc.obj-code
     6246                                                  and   buf_clients-attr.obj-type  = buf_trn-doc.obj-type
     6247                                                  and   buf_clients-attr.attr-code = 'kpp':U:
     6248                   v-kpp2 = buf_clients-attr.attr-value.
     6249               end.
     6250               if v-kpp2 = "" then  v-kpp2 = v-fmtcli-kpp.
     6251               if v-kpp = v-kpp2 then next .
     6252           end.
     6253         end.
     6254         run partslib-process-document in this-procedure
     6255           (input  buf_doc-line.doc-code
     6256           ,input  p-obj-type
     6257           ,input  p-obj-code
     6258           ,input  p-artic
     6259           ,input  p-prod-type
     6260           ,input  p-prod-code
     6261           ,input  v-goods-gds-goods
     6262           ,input  v-goods-twounit
     6263           ,output v-total-parts-qnty
     6264           ) no-error .
     6265         if error-status :error
     6266         then do:
     6267           message
     6268             vss-workfile vss-revision vss-description skip
     6269             "Ошибка при вызове процедуры partslib-process-document" skip
     6270             "Документ" buf_doc-line.doc-code skip
     6271             "Объект" p-obj-type p-obj-code skip
     6272             "Артикул" p-artic p-prod-type p-prod-code skip
     6273             "p-start-fact-order" p-start-fact-order skip
     6274             "p-end-fact-order" p-end-fact-order skip
     6275             error-status :get-message(1) skip
     6276             return-value skip
     6277             view-as alert-box error .
     6278           undo, return error return-value .
     6279         end.
     6280       end.
     6281     end.
     6282   end procedure.
