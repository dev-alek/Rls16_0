     4461                   tt-parts-info.obj-code         = obj-list.obj-code
     4462                   tt-parts-info.artic            = alc-goods.artic
     4463                   tt-parts-info.prod-type        = alc-goods.prod-type
     4464                   tt-parts-info.prod-code        = alc-goods.prod-code
     4465                   tt-parts-info.in-code          = temp-parts.in-code
     4466                   tt-parts-info.out-code         = temp-parts.out-code
     4467                   tt-parts-info.part-code        = temp-parts.part-code
