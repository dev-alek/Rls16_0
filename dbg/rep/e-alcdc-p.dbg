     4243                   and ext-cl:GetExtGdsValue(1):CliRegIdImpor <> ?
     4244                   then do :
     4245                           if trim(ext-cl:GetExtGdsValue(1):CountryProd) = "643"
     4246                           or trim(ext-cl:GetExtGdsValue(1):CountryProd) = "051"
     4247                           or trim(ext-cl:GetExtGdsValue(1):CountryProd) = "398"
     4248                           or trim(ext-cl:GetExtGdsValue(1):CountryProd) = "417"
     4249                           or trim(ext-cl:GetExtGdsValue(1):CountryProd) = "112"
     4250                           then
     4251                           assign
     4252                               imp-or-prod-type = ext-cl:GetExtGdsValue(1):CliRegIdProd
     4253                               imp-or-prod-code = 0
     4254                               tt-parts-info.importer = 'ЕГАИС. Производитель из Таможенного Союза'
     4255                           .
