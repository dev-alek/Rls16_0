     4221                   ext-cl:OpenQueryExtGds(alc-goods.gds-code, entry(3, temp-parts.alc-ref-ab-path)) .
     4222                   tt-parts-info.alc-code =  entry(3, temp-parts.alc-ref-ab-path) .
     4223               end.
     4224               if temp-parts.alc-imp-code <> 0 then assign
     4225                       imp-or-prod-type = temp-parts.alc-imp-type
     4226                       imp-or-prod-code = temp-parts.alc-imp-code
     4227                       tt-parts-info.importer = 'Импортер из алк.атр. партии' .
     4228               else
     4229               if ext-FormF1:NumBundles > 0
     4230               and ext-FormF1:GetExtFormF1Value():CliRegIdOrigCli <> ""
     4231               and ext-FormF1:GetExtFormF1Value():CliRegIdOrigCli <> ?
     4232               then do :
