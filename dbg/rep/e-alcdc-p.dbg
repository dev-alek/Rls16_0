     4311                 assign
     4312                 part-1.alc-type-code = alc-types.alc-type-code
     4313                 part-1.alc-type-name = alc-types.alc-type-name.
     4314             end.
     4315             case imp-or-prod-type:
     4316                 when 'орг':U then do:
     4317                     find first buf_firm no-lock where buf_firm.firm-code = imp-or-prod-code.
     4318                     find first buf_clients no-lock where buf_clients.obj-code = imp-or-prod-code
     4319                                                    and   buf_clients.obj-type = imp-or-prod-type.
     4320                     assign
     4321                     part-1.producer-obj-name = buf_clients.obj-name
     4322                     part-1.producer-inn = buf_firm.inn
     4323                     part-1.producer-kpp = buf_firm.kpp.
     4324                 end.
     4325                 when 'маг':U or when 'скл':U then do:
     4326                 find first buf_clients no-lock where buf_clients.obj-code = imp-or-prod-code
     4327                                                and   buf_clients.obj-type = imp-or-prod-type.
     4328                 find first buf_firm no-lock where buf_firm.firm-code = buf_clients.host-code.
     4329                 release buf_clients-attr.
     4330                 find first buf_clients-attr no-lock where buf_clients-attr.obj-code  = imp-or-prod-code
     4331                                                     and   buf_clients-attr.obj-type  = imp-or-prod-type
     4332                                                     and   buf_clients-attr.attr-code = 'kpp':U no-error.
