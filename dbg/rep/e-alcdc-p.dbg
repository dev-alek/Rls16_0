     4297             for first buf_clients-attr no-lock where buf_clients-attr.obj-type  = temp-parts.prod-type
     4298                                                and   buf_clients-attr.obj-code  = temp-parts.prod-code
     4299                                                and   buf_clients-attr.attr-code = 'foreign-producer':U
