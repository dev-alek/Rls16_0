     2307   procedure clcprtsl_calc-ttable :
     2308   define input parameter paris-doc           as   logical                 no-undo.
     2309   define input parameter paris-cur           as   logical                 no-undo.
     2310   define input parameter parroad-tax         like ub.doc-line.road-tax    no-undo.
     2311   define input parameter parexcise           like ub.doc-line.excise      no-undo.
     2312   define input parameter parvat-pc           like ub.doc-line.vat-pc      no-undo.
     2313   define input parameter parcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     2314   define input parameter parslt-pc           like ub.doc-line.slt-pc      no-undo.
     2315   define input parameter parbase-rate        like ub.trn-doc.base-rate    no-undo.
     2316   define input parameter parbase-scale       like ub.trn-doc.base-scale   no-undo.
     2317   define input parameter parr-b              as   character               no-undo.
     2318   define input parameter parcur-base         like ub.gds-dtl.cur-base     no-undo.
     2319   define input parameter parcur-road-tax     like ub.doc-line.road-tax    no-undo.
     2320   define input parameter parcur-excise       like ub.doc-line.excise      no-undo.
     2321   define input parameter parcur-vat-pc       like ub.doc-line.vat-pc      no-undo.
     2322   define input parameter parcurcons-vat-pc   like ub.doc-line.cons-vat-pc no-undo.
     2323   define input parameter parcurslt-pc        like ub.doc-line.slt-pc      no-undo.
     2324   define buffer bf_tt-allsum      for tt-allsum.
     2325   define buffer bf_tt-clcparts    for tt-clcparts.
     2326   define buffer bf_tt-allsum-line for tt-allsum-line.
     2327   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     2328   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     2329   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     2330   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     2331   define variable varexcise          like ub.price-list.excise     no-undo.
     2332   do on error undo, return error return-value :
     2333   for each bf_tt-allsum-line
     2334   on error undo, return error return-value
     2335    :
     2336     delete bf_tt-allsum-line.
     2337   end.
     2338   for each bf_tt-allsum
     2339   on error undo, return error return-value
     2340   :
