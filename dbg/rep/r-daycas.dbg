     1845       bfsacc_tt-allsum.dsc-rubl-acc        = bfs_tt-allsum.dsc-rubl-acc
     1846       bfsacc_tt-allsum.dsc-cli-acc         = bfs_tt-allsum.dsc-cli-acc
     1847       bfsacc_tt-allsum.vat-base-acc        = bfs_tt-allsum.vat-base-acc
     1848       bfsacc_tt-allsum.vat-rubl-acc        = bfs_tt-allsum.vat-rubl-acc
     1849       bfsacc_tt-allsum.vat-cli-acc         = bfs_tt-allsum.vat-cli-acc
     1850       bfsacc_tt-allsum.slt-base-acc        = bfs_tt-allsum.slt-base-acc
     1851       bfsacc_tt-allsum.slt-rubl-acc        = bfs_tt-allsum.slt-rubl-acc
     1852       bfsacc_tt-allsum.slt-cli-acc         = bfs_tt-allsum.slt-cli-acc
     1853       bfsacc_tt-allsum.excise-base-acc     = bfs_tt-allsum.excise-base-acc
     1854       bfsacc_tt-allsum.excise-rubl-acc     = bfs_tt-allsum.excise-rubl-acc
     1855       bfsacc_tt-allsum.excise-cli-acc      = bfs_tt-allsum.excise-cli-acc
     1856       bfsacc_tt-allsum.road-tax-base-acc   = bfs_tt-allsum.road-tax-base-acc
     1857       bfsacc_tt-allsum.road-tax-rubl-acc   = bfs_tt-allsum.road-tax-rubl-acc
     1858       bfsacc_tt-allsum.road-tax-cli-acc    = bfs_tt-allsum.road-tax-cli-acc
     1859       bfsacc_tt-allsum.transport-base-acc  = bfs_tt-allsum.transport-base-acc
     1860       bfsacc_tt-allsum.transport-rubl-acc  = bfs_tt-allsum.transport-rubl-acc
     1861       bfsacc_tt-allsum.transport-cli-acc   = bfs_tt-allsum.transport-cli-acc
     1862       bfsacc_tt-allsum.other-base-acc      = bfs_tt-allsum.other-base-acc
     1863       bfsacc_tt-allsum.other-rubl-acc      = bfs_tt-allsum.other-rubl-acc
     1864       bfsacc_tt-allsum.other-cli-acc       = bfs_tt-allsum.other-cli-acc
     1865       .
     1866   end.
     1867   otherwise do:
     1868     return error substitute ("Неизвестный тип приобретения &1 по партии с кодом &2 по документу &3, порожденную документом &4 по товару &5 &6 &7.",
     1869                              cl_tt-clcparts.purch-code,
     1870                              cl_tt-clcparts.part-code,
     1871                              cl_tt-clcparts.out-code,
     1872                              cl_tt-clcparts.in-code,
     1873                              cl_tt-clcparts.artic,
     1874                              cl_tt-clcparts.prod-type,
     1875                              cl_tt-clcparts.prod-code).
     1876   end.
     1877   end case.
     1878   end.
     1879   end procedure.
     1880   procedure clcprtsl_calc-line :
     1881   define input  parameter parrec-line as recid no-undo.
     1882   define variable v-tax-date         as   date                     no-undo.
     1883   define variable v-vat-pc           like ub.doc-line.vat-pc       no-undo.
     1884   define variable varr-b             as   character                no-undo.
     1885   define variable varr-btype         as   character                no-undo.
     1886   define variable varcur-base        like ub.gds-dtl.price-base    no-undo.
     1887   define variable varcur-road-tax    like ub.doc-line.road-tax     no-undo.
     1888   define variable varcur-excise      like ub.doc-line.excise       no-undo.
     1889   define variable varcur-vat-pc      like ub.doc-line.vat-pc       no-undo.
     1890   define variable varcur-cons-vat-pc like ub.doc-line.cons-vat-pc  no-undo.
     1891   define variable varcur-slt-pc      like ub.doc-line.slt-pc       no-undo.
     1892   define variable varcur-fact-qnty   like ub.gds-dtl.fact-qnty     no-undo.
     1893   define variable varb-code          like ub.bar-code.b-code       no-undo.
     1894   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     1895   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     1896   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     1897   define variable varexcise          like ub.price-list.excise     no-undo.
     1898   define variable varlastcur-base        like ub.gds-dtl.price-base no-undo.
     1899   define variable varlastcur-road-tax    like ub.gds-dtl.price-base no-undo.
     1900   define variable varlastcur-excise      like ub.gds-dtl.price-base     no-undo.
     1901   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     1902   define variable v-varsum           as decimal                  no-undo.
     1903   define variable varprice-salef as decimal   no-undo .
     1904   define buffer bf_trn-doc             for ub.trn-doc.
     1905   define buffer bf_doc-line            for ub.doc-line.
     1906   define buffer bf_gds-dtl             for ub.gds-dtl.
     1907   define buffer bf_goods               for ub.goods.
     1908   define buffer bf_parts               for ub.parts.
     1909   define buffer bf_sysconf             for ub.sysconf.
     1910   define buffer bf_tt-allsum-line      for tt-allsum-line.
     1911   define buffer bfs_tt-allsum-line     for tt-allsum-line.
     1912   define buffer bfo_tt-allsum-line     for tt-allsum-line.
     1913   define buffer bfos_tt-allsum-line    for tt-allsum-line.
     1914   define buffer buf_parts        for ub.parts.
     1915   v-calcbypart = no.
     1916   do on error undo, return error return-value :
     1917   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1918   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1919     (output varr-b
     1920     )  .
     1921     find first bf_doc-line where recid (bf_doc-line) = parrec-line no-lock.
     1922     find first bf_trn-doc where bf_trn-doc.doc-code = bf_doc-line.doc-code no-lock.
     1923     find first bf_goods where bf_goods.artic     = bf_doc-line.artic     and
     1924                               bf_goods.prod-type = bf_doc-line.prod-type and
     1925                               bf_goods.prod-code = bf_doc-line.prod-code no-lock.
     1926     if bf_trn-doc.fact-date <> ?        then do:
     1927       assign v-tax-date = bf_trn-doc.fact-date.
     1928     end.
     1929     else do:
     1930       assign v-tax-date = ?.
     1931     end.
     1932   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1933   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     1934     (input  bf_goods.gds-code
     1935     ,input  '1':U
     1936     ,input  v-tax-date
     1937     ,input  bf_trn-doc.host-code
     1938     ,input  bf_trn-doc.obj-type
     1939     ,input  bf_trn-doc.obj-code
     1940     ,output v-vat-pc
     1941     ) no-error .
     1942     if error-status :error
     1943     or v-vat-pc = ? then do:
     1944        return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     1945     end.
     1946     if bf_goods.gds-type = 'у':U or
     1947        bf_trn-doc.status_ = 'запрос':U then do:
     1948       for each bf_tt-allsum-line
     1949       on error undo, return error return-value
     1950        :
     1951         delete bf_tt-allsum-line.
     1952       end.
     1953       create bf_tt-allsum-line.
     1954       assign
     1955        bf_tt-allsum-line.sum-type = 'основная_сумма':U.
     1956       for each bf_gds-dtl where bf_gds-dtl.doc-code  = bf_doc-line.doc-code  and
     1957                                 bf_gds-dtl.artic     = bf_doc-line.artic     and
     1958                                 bf_gds-dtl.prod-type = bf_doc-line.prod-type and
     1959                                 bf_gds-dtl.prod-code = bf_doc-line.prod-code no-lock on error undo, return error return-value :
     1960         assign
     1961           bf_tt-allsum-line.fact-qnty            =  bf_tt-allsum-line.fact-qnty        + bf_gds-dtl.fact-qnty
     1962           bf_tt-allsum-line.sum-dsc-base-doc     =  bf_tt-allsum-line.sum-dsc-base-doc + (bf_gds-dtl.price-base - bf_gds-dtl.discnt-base) * bf_gds-dtl.fact-qnty
     1963           bf_tt-allsum-line.sum-dsc-rubl-doc     =  bf_tt-allsum-line.sum-dsc-rubl-doc + (bf_gds-dtl.price-rubl - bf_gds-dtl.discnt-rubl) * bf_gds-dtl.fact-qnty
     1964           bf_tt-allsum-line.dsc-base-doc         =  bf_tt-allsum-line.dsc-base-doc     + bf_gds-dtl.discnt-base * bf_gds-dtl.fact-qnty
     1965           bf_tt-allsum-line.dsc-rubl-doc         =  bf_tt-allsum-line.dsc-rubl-doc     + bf_gds-dtl.discnt-rubl * bf_gds-dtl.fact-qnty
     1966           bf_tt-allsum-line.sum-dsc-base-cur     =  bf_tt-allsum-line.sum-dsc-base-cur + (if varr-b = "base" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base / bf_trn-doc.exch-rate * bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     1967           bf_tt-allsum-line.sum-dsc-rubl-cur     =  bf_tt-allsum-line.sum-dsc-rubl-cur + (if varr-b = "rubl" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base * bf_trn-doc.exch-rate / bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     1968           bf_tt-allsum-line.sum-dsc-base-acc     =  bf_tt-allsum-line.sum-dsc-base-acc + bf_doc-line.price-base * bf_gds-dtl.fact-qnty
     1969           bf_tt-allsum-line.sum-dsc-rubl-acc     =  bf_tt-allsum-line.sum-dsc-rubl-acc + bf_doc-line.price-rubl * bf_gds-dtl.fact-qnty
     1970           bf_tt-allsum-line.sum-dsc-cli-acc      =  ?
     1971           bf_tt-allsum-line.vat-base-acc         =  bf_tt-allsum-line.vat-base-acc     + bf_doc-line.price-base * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     1972           bf_tt-allsum-line.vat-rubl-acc         =  bf_tt-allsum-line.vat-rubl-acc     + bf_doc-line.price-rubl * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     1973           bf_tt-allsum-line.vat-cli-acc          =  ?
     1974           .
     1975       end.
     1976       assign
     1977         bf_tt-allsum-line.cli-qnty             =  ?
     1978         bf_tt-allsum-line.slt-base-doc         =  bf_tt-allsum-line.sum-dsc-base-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     1979         bf_tt-allsum-line.slt-rubl-doc         =  bf_tt-allsum-line.sum-dsc-rubl-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     1980         bf_tt-allsum-line.vat-base-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-base-doc - bf_tt-allsum-line.slt-base-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     1981         bf_tt-allsum-line.vat-rubl-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-rubl-doc - bf_tt-allsum-line.slt-rubl-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     1982         bf_tt-allsum-line.road-tax-base-doc    =  0
     1983         bf_tt-allsum-line.road-tax-rubl-doc    =  0
     1984         bf_tt-allsum-line.excise-base-doc      =  0
     1985         bf_tt-allsum-line.excise-rubl-doc      =  0
     1986         bf_tt-allsum-line.vat-base-doc         =  bf_tt-allsum-line.vat-base-buyer-doc
     1987         bf_tt-allsum-line.vat-rubl-doc         =  bf_tt-allsum-line.vat-rubl-buyer-doc
     1988         bf_tt-allsum-line.dsc-base-cur         =  0
     1989         bf_tt-allsum-line.dsc-rubl-cur         =  0
     1990         bf_tt-allsum-line.slt-base-cur         =  bf_tt-allsum-line.sum-dsc-base-cur * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     1991         bf_tt-allsum-line.slt-rubl-cur         =  bf_tt-allsum-line.sum-dsc-rubl-cur * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     1992         bf_tt-allsum-line.vat-base-buyer-cur   =  (bf_tt-allsum-line.sum-dsc-base-cur - bf_tt-allsum-line.slt-base-cur) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     1993         bf_tt-allsum-line.vat-rubl-buyer-cur   =  (bf_tt-allsum-line.sum-dsc-rubl-cur - bf_tt-allsum-line.slt-rubl-cur) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     1994         bf_tt-allsum-line.road-tax-base-cur    =  0
     1995         bf_tt-allsum-line.road-tax-rubl-cur    =  0
     1996         bf_tt-allsum-line.excise-base-cur      =  0
     1997         bf_tt-allsum-line.excise-rubl-cur      =  0
     1998         bf_tt-allsum-line.vat-base-cur         =  bf_tt-allsum-line.vat-base-buyer-cur
     1999         bf_tt-allsum-line.vat-rubl-cur         =  bf_tt-allsum-line.vat-rubl-buyer-cur
     2000         bf_tt-allsum-line.dsc-base-acc         =  0
     2001         bf_tt-allsum-line.dsc-rubl-acc         =  0
     2002         bf_tt-allsum-line.dsc-cli-acc          =  0
     2003         bf_tt-allsum-line.slt-base-acc         =  0
     2004         bf_tt-allsum-line.slt-rubl-acc         =  0
     2005         bf_tt-allsum-line.slt-cli-acc          =  0
     2006         bf_tt-allsum-line.road-tax-base-acc    =  0
     2007         bf_tt-allsum-line.road-tax-rubl-acc    =  0
     2008         bf_tt-allsum-line.road-tax-cli-acc     =  0
     2009         bf_tt-allsum-line.excise-base-acc      =  0
     2010         bf_tt-allsum-line.excise-rubl-acc      =  0
     2011         bf_tt-allsum-line.excise-cli-acc       =  0
     2012         bf_tt-allsum-line.transport-base-acc   =  0
     2013         bf_tt-allsum-line.transport-rubl-acc   =  0
     2014         bf_tt-allsum-line.transport-cli-acc    =  0
     2015         bf_tt-allsum-line.other-base-acc       =  0
     2016         bf_tt-allsum-line.other-rubl-acc       =  0
     2017         bf_tt-allsum-line.other-cli-acc        =  0
     2018         .
     2019       create bfs_tt-allsum-line.
     2020       assign
     2021       bfs_tt-allsum-line.sum-type = 'основная_сумма_со_знаком':U.
     2022       if bf_trn-doc.doc-type = 'инв':U or
     2023          bf_trn-doc.doc-type = 'при':U    or
     2024          bf_trn-doc.doc-type = 'возврат':U    then do:
     2025          buffer-copy bf_tt-allsum-line except bf_tt-allsum-line.sum-type to bfs_tt-allsum-line.
     2026       end.
     2027       else do:
     2028         assign
     2029           bfs_tt-allsum-line.fact-qnty           =  - bf_tt-allsum-line.fact-qnty
     2030           bfs_tt-allsum-line.cli-qnty            =  - bf_tt-allsum-line.cli-qnty
     2031           bfs_tt-allsum-line.sum-dsc-base-doc    =  - bf_tt-allsum-line.sum-dsc-base-doc
     2032           bfs_tt-allsum-line.sum-dsc-rubl-doc    =  - bf_tt-allsum-line.sum-dsc-rubl-doc
     2033           bfs_tt-allsum-line.dsc-base-doc        =  - bf_tt-allsum-line.dsc-base-doc
     2034           bfs_tt-allsum-line.dsc-rubl-doc        =  - bf_tt-allsum-line.dsc-rubl-doc
     2035           bfs_tt-allsum-line.vat-base-doc        =  - bf_tt-allsum-line.vat-base-doc
     2036           bfs_tt-allsum-line.vat-rubl-doc        =  - bf_tt-allsum-line.vat-rubl-doc
     2037           bfs_tt-allsum-line.vat-base-buyer-doc  =  - bf_tt-allsum-line.vat-base-buyer-doc
     2038           bfs_tt-allsum-line.vat-rubl-buyer-doc  =  - bf_tt-allsum-line.vat-rubl-buyer-doc
     2039           bfs_tt-allsum-line.slt-base-doc        =  - bf_tt-allsum-line.slt-base-doc
     2040           bfs_tt-allsum-line.slt-rubl-doc        =  - bf_tt-allsum-line.slt-rubl-doc
     2041           bfs_tt-allsum-line.road-tax-base-doc   =  - bf_tt-allsum-line.road-tax-base-doc
     2042           bfs_tt-allsum-line.road-tax-rubl-doc   =  - bf_tt-allsum-line.road-tax-rubl-doc
     2043           bfs_tt-allsum-line.excise-base-doc     =  - bf_tt-allsum-line.excise-base-doc
     2044           bfs_tt-allsum-line.excise-rubl-doc     =  - bf_tt-allsum-line.excise-rubl-doc
     2045           bfs_tt-allsum-line.sum-dsc-base-cur    =  - bf_tt-allsum-line.sum-dsc-base-cur
     2046           bfs_tt-allsum-line.sum-dsc-rubl-cur    =  - bf_tt-allsum-line.sum-dsc-rubl-cur
     2047           bfs_tt-allsum-line.dsc-base-cur        =  - bf_tt-allsum-line.dsc-base-cur
     2048           bfs_tt-allsum-line.dsc-rubl-cur        =  - bf_tt-allsum-line.dsc-rubl-cur
     2049           bfs_tt-allsum-line.vat-base-cur        =  - bf_tt-allsum-line.vat-base-cur
     2050           bfs_tt-allsum-line.vat-rubl-cur        =  - bf_tt-allsum-line.vat-rubl-cur
     2051           bfs_tt-allsum-line.vat-base-buyer-cur  =  - bf_tt-allsum-line.vat-base-buyer-cur
     2052           bfs_tt-allsum-line.vat-rubl-buyer-cur  =  - bf_tt-allsum-line.vat-rubl-buyer-cur
     2053           bfs_tt-allsum-line.slt-base-cur        =  - bf_tt-allsum-line.slt-base-cur
     2054           bfs_tt-allsum-line.slt-rubl-cur        =  - bf_tt-allsum-line.slt-rubl-cur
     2055           bfs_tt-allsum-line.road-tax-base-cur   =  - bf_tt-allsum-line.road-tax-base-cur
     2056           bfs_tt-allsum-line.road-tax-rubl-cur   =  - bf_tt-allsum-line.road-tax-rubl-cur
     2057           bfs_tt-allsum-line.excise-base-cur     =  - bf_tt-allsum-line.excise-base-cur
     2058           bfs_tt-allsum-line.excise-rubl-cur     =  - bf_tt-allsum-line.excise-rubl-cur
     2059           bfs_tt-allsum-line.sum-dsc-base-acc    =  - bf_tt-allsum-line.sum-dsc-base-acc
     2060           bfs_tt-allsum-line.sum-dsc-rubl-acc    =  - bf_tt-allsum-line.sum-dsc-rubl-acc
     2061           bfs_tt-allsum-line.sum-dsc-cli-acc     =  - bf_tt-allsum-line.sum-dsc-cli-acc
     2062           bfs_tt-allsum-line.dsc-base-acc        =  - bf_tt-allsum-line.dsc-base-acc
     2063           bfs_tt-allsum-line.dsc-rubl-acc        =  - bf_tt-allsum-line.dsc-rubl-acc
     2064           bfs_tt-allsum-line.dsc-cli-acc         =  - bf_tt-allsum-line.dsc-cli-acc
     2065           bfs_tt-allsum-line.vat-base-acc        =  - bf_tt-allsum-line.vat-base-acc
     2066           bfs_tt-allsum-line.vat-rubl-acc        =  - bf_tt-allsum-line.vat-rubl-acc
     2067           bfs_tt-allsum-line.vat-cli-acc         =  - bf_tt-allsum-line.vat-cli-acc
     2068           bfs_tt-allsum-line.slt-base-acc        =  - bf_tt-allsum-line.slt-base-acc
     2069           bfs_tt-allsum-line.slt-rubl-acc        =  - bf_tt-allsum-line.slt-rubl-acc
     2070           bfs_tt-allsum-line.slt-cli-acc         =  - bf_tt-allsum-line.slt-cli-acc
     2071           bfs_tt-allsum-line.road-tax-base-acc   =  - bf_tt-allsum-line.road-tax-base-acc
     2072           bfs_tt-allsum-line.road-tax-rubl-acc   =  - bf_tt-allsum-line.road-tax-rubl-acc
     2073           bfs_tt-allsum-line.road-tax-cli-acc    =  - bf_tt-allsum-line.road-tax-cli-acc
     2074           bfs_tt-allsum-line.excise-base-acc     =  - bf_tt-allsum-line.excise-base-acc
     2075           bfs_tt-allsum-line.excise-rubl-acc     =  - bf_tt-allsum-line.excise-rubl-acc
     2076           bfs_tt-allsum-line.excise-cli-acc      =  - bf_tt-allsum-line.excise-cli-acc
     2077           bfs_tt-allsum-line.transport-base-acc  =  - bf_tt-allsum-line.transport-base-acc
     2078           bfs_tt-allsum-line.transport-rubl-acc  =  - bf_tt-allsum-line.transport-rubl-acc
     2079           bfs_tt-allsum-line.transport-cli-acc   =  - bf_tt-allsum-line.transport-cli-acc
     2080           bfs_tt-allsum-line.other-base-acc      =  - bf_tt-allsum-line.other-base-acc
     2081           bfs_tt-allsum-line.other-rubl-acc      =  - bf_tt-allsum-line.other-rubl-acc
     2082           bfs_tt-allsum-line.other-cli-acc       =  - bf_tt-allsum-line.other-cli-acc
     2083           .
     2084       end.
     2085       create bfo_tt-allsum-line.
     2086       assign
