     2191               varcur-road-tax     = varcur-road-tax  + varroad-tax   * bf_gds-dtl.fact-qnty
     2192               varcur-excise       = varcur-excise    + varexcise     * bf_gds-dtl.fact-qnty
     2193               varcur-fact-qnty    = varcur-fact-qnty + bf_gds-dtl.fact-qnty
     2194             .
     2195         end.
     2196       end.
     2197       if varcur-fact-qnty = 0 then do:
     2198         assign
     2199           varcur-base      = varlastcur-base
     2200           varcur-road-tax  = varlastcur-road-tax
     2201           varcur-excise    = varlastcur-excise
     2202         .
     2203       end.
     2204       else do:
     2205         assign
     2206           varcur-base      = varcur-base      / varcur-fact-qnty
     2207           varcur-road-tax  = varcur-road-tax  / varcur-fact-qnty
     2208           varcur-excise    = varcur-excise    / varcur-fact-qnty
     2209         .
     2210       end.
