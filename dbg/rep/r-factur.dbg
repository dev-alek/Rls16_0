     5798       .
     5799       assign
     5800               v-tot-prt-qnty          = 0
     5801               v-tot-prt-doc-qnty      = 0
     5802               v-tot-prt-VAT           = 0
     5803               v-tot-prt-doc-VAT       = 0
     5804               v-tot-prt-SLT           = 0
     5805               v-tot-prt-sum-no-VAT    = 0
     5806               v-tot-prt-doc-sum-no-VAT    = 0
     5807               v-tot-prt-sum           = 0
     5808               v-tot-prt-doc-sum           = 0
     5809                   v-VAT           = 0
