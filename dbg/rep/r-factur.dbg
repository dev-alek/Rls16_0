     4786   procedure facturxl-write-cell-data :
     4787   define input parameter p-data-key   as character        no-undo.
     4788   define input parameter p-data-value as character        no-undo.
     4789       define buffer buf_temp_cell-data     for temp_cell-data.
     4790   do
     4791   for buf_temp_cell-data
     4792   on error undo, return error
     4793   :
     4794       find first buf_temp_cell-data
     4795            where buf_temp_cell-data.data-key = p-data-key
     4796       no-error.
     4797       if not available buf_temp_cell-data
     4798       then do:
     4799           create buf_temp_cell-data.
     4800           assign
     4801               buf_temp_cell-data.data-key = p-data-key
     4802           .
     4803       end.
     4804       assign
     4805           buf_temp_cell-data.data-value = p-data-value
     4806       .
     4807       put stream excel-cell unformatted
     4808                           buf_temp_cell-data.data-key
     4809           chr(9)   buf_temp_cell-data.data-value
     4810           chr(10)
     4811       .
     4812   end.
     4813   end procedure.
     4814   procedure facturxl-write-line-data :
     4815   define input parameter p-Name          as character        no-undo.
     4816   define input parameter p-UAES          as character        no-undo.
     4817   define input parameter p-OKEI          as character        no-undo.
     4818   define input parameter p-EI            as character        no-undo.
     4819   define input parameter p-qnty          as character        no-undo.
     4820   define input parameter p-price         as character        no-undo.
     4821   define input parameter p-SumNoVAT      as character        no-undo.
     4822   define input parameter p-SumActciz     as character        no-undo.
     4823   define input parameter p-VATpc         as character        no-undo.
     4824   define input parameter p-VATsum        as character        no-undo.
     4825   define input parameter p-sum           as character        no-undo.
     4826   define input parameter p-countrycode   as character        no-undo.
     4827   define input parameter p-country       as character        no-undo.
     4828   define input parameter p-GTD           as character        no-undo.
     4829       define buffer buf_temp_line-data        for temp_line-data.
     4830   do
     4831   for buf_temp_line-data
     4832   on error undo, return error
     4833   :
     4834       for each buf_temp_line-data
     4835       :
     4836           delete buf_temp_line-data.
     4837       end.
     4838       create buf_temp_line-data.
     4839       assign
     4840           v-facturxl-current-data-row = v-facturxl-current-data-row + 1
     4841       .
     4842       assign
     4843           buf_temp_line-data.data-key     = "LD":U
     4844           buf_temp_line-data.xl-line-id   = v-facturxl-current-data-row
     4845           buf_temp_line-data.Name         = p-Name
     4846           buf_temp_line-data.UAES         = p-UAES
     4847           buf_temp_line-data.OKEI         = p-OKEI
     4848           buf_temp_line-data.EI           = p-EI
     4849           buf_temp_line-data.qnty         = p-qnty
     4850           buf_temp_line-data.price        = p-price
     4851           buf_temp_line-data.SumNoVAT     = p-SumNoVAT
     4852           buf_temp_line-data.SumActciz    = p-SumActciz
     4853           buf_temp_line-data.VATpc        = p-VATpc
     4854           buf_temp_line-data.VATsum       = p-VATsum
     4855           buf_temp_line-data.sum          = p-sum
     4856           buf_temp_line-data.countrycode  = p-countrycode
     4857           buf_temp_line-data.country      = p-country
     4858           buf_temp_line-data.GTD          = p-GTD
     4859       .
     4860       put stream excel-line unformatted
     4861                           buf_temp_line-data.data-key
     4862           chr(9)   buf_temp_line-data.Name
     4863           chr(9)   buf_temp_line-data.UAES
     4864           chr(9)   buf_temp_line-data.OKEI
     4865           chr(9)   buf_temp_line-data.EI
     4866           chr(9)   buf_temp_line-data.qnty
     4867           chr(9)   buf_temp_line-data.price
     4868           chr(9)   buf_temp_line-data.SumNoVAT
     4869           chr(9)   buf_temp_line-data.SumActciz
     4870           chr(9)   buf_temp_line-data.VATpc
     4871           chr(9)   buf_temp_line-data.VATsum
     4872           chr(9)   buf_temp_line-data.sum
     4873           chr(9)   buf_temp_line-data.countrycode
     4874           chr(9)   buf_temp_line-data.country
     4875           chr(9)   buf_temp_line-data.GTD
     4876           chr(10)
     4877       .
     4878   end.
     4879   end procedure.
     4880   procedure facturxl-write-line-data-corr :
     4881   define input parameter p-Name          as character        no-undo.
