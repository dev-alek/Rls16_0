     4925           chr(9)   buf_temp_line-data.pokazately
     4926           chr(9)   buf_temp_line-data.UAES
     4927           chr(9)   buf_temp_line-data.OKEI
     4928           chr(9)   buf_temp_line-data.EI
     4929           chr(9)   buf_temp_line-data.qnty
     4930           chr(9)   buf_temp_line-data.price
     4931           chr(9)   buf_temp_line-data.SumNoVAT
     4932           chr(9)   buf_temp_line-data.SumActciz
     4933           chr(9)   buf_temp_line-data.VATpc
     4934           chr(9)   buf_temp_line-data.VATsum
     4935           chr(9)   buf_temp_line-data.sum
     4936           chr(10)
     4937       .
     4938   end.
     4939   end procedure.
     4940   procedure facturxl-run-excel :
     4941   define input parameter p-header-filename    as character        no-undo.
     4942   define input parameter p-data-filename      as character        no-undo.
     4943       define variable v-template-file-name    as character    no-undo.
     4944       define variable v-vb-file-name          as character    no-undo.
     4945       define buffer buf_temp-param for temp-param .
     4946   do
     4947   for buf_temp-param
     4948   on error undo, return error
     4949   :
     4950       create buf_temp-param.
     4951       assign
     4952           v-template-file-name    = search( "exe/sf_97.xlt" )
     4953           v-vb-file-name          = search( "exe/t_97.bas")
     4954       .
     4955       if v-template-file-name = ?
     4956       or v-template-file-name = "":U
     4957       then do:
     4958           message
     4959               "Ошибка имени файла шаблона."
     4960           view-as alert-box error.
     4961       end.
     4962       if v-vb-file-name = ?
     4963       or v-vb-file-name = "":U
     4964       then do:
     4965           message
     4966               "Ошибка имени файла кода обработки."
     4967           view-as alert-box error.
     4968       end.
     4969       run paramls-write in this-procedure (
     4970             input "template":U
     4971           , input "template-file-name":U
     4972           , input v-template-file-name
     4973       ).
     4974       run paramls-write in this-procedure (
     4975             input "template":U
     4976           , input "vb-file-name":U
     4977           , input v-vb-file-name
     4978       ).
     4979       run paramls-write in this-procedure (
     4980             input "data":U
     4981           , input "data-header-filename":U
     4982           , input p-header-filename
     4983       ).
     4984       run paramls-write in this-procedure (
     4985             input "data":U
     4986           , input "data-filename":U
     4987           , input p-data-filename
     4988       ).
     4989       run gbl/macroxlt.p (
     4990           input-output table buf_temp-param
     4991       ) no-error.
     4992       if error-status :error
     4993       then do:
     4994           message
     4995                    vss-workfile vss-revision vss-description
     4996               skip(1)
     4997               skip "Ошибка создания файла Excel."
     4998               skip return-value
     4999               skip trim(error-status :get-message(1))
     5000                    trim(error-status :get-message(2))
     5001                    trim(error-status :get-message(3))
     5002           view-as alert-box error.
     5003           undo, return error .
     5004       end.
     5005   end.
     5006   end procedure.
