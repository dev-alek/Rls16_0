     7423                               , input (if v-diff-sum > 0 then string(v-diff-sum) else "")
     7424                           ).
     7425                           run facturxl-write-line-data-corr in this-procedure (
     7426                                 input ""
     7427                               , input "Г (уменьшение)"
     7428                               , input ""
     7429                               , input ""
     7430                               , input ""
     7431                               , input ""
     7432                               , input ""
     7433                               , input (if v-diff-sum-no-VAT < 0 then string(abs(v-diff-sum-no-VAT)) else "")
     7434                               , input "без акциза":U
     7435                               , input ""
     7436                               , input (if v-diff-VAT < 0 then string(abs(v-diff-VAT)) else "")
     7437                               , input (if v-diff-sum < 0 then string(abs(v-diff-sum)) else "")
     7438                           ).
     7439             end.
     7440             else do :
     7441               display stream Out-stream
     7442                   sym1 gds-str1 @ ub.goods.gds-name
     7443                   sym2 "  -   " @ v-uaes-code
     7444                   sym16 v-unit-code
     7445                   sym14 ( if invers then ("  " + ub.doc-line.unit-cli) else ("  " + ub.goods.unit-base) ) @ ub.goods.unit-base
     7446                   sym3 v-qnty
     7447                   sym4 v-price-no-VAT
     7448                   sym5 v-sum-no-VAT
     7449                   sym6 "без акциза" format "x(10)" @ v-sum-actciz
     7450                   sym7 ub.doc-line.Vat-pc
     7451                   sym8 v-VAT
     7452                   sym9 v-sum
     7453                   sym11 v-country-code
     7454                   sym15 v-country
     7455                   sym12
     7456                   sym13
     7457               with frame factur .
     7458               down stream Out-stream 1 with frame factur .
     7459               run facturxl-write-line-data in this-procedure (
     7460                     input (if rep-artic then (string(ub.goods.artic,"x(16)") +  " ") else "") + ub.goods.gds-name
     7461                   , input v-uaes-code
     7462                   , input v-unit-code
     7463                   , input ( if invers then ub.doc-line.unit-cli else ub.goods.unit-base )
     7464                   , input string( v-qnty          )
     7465                   , input string( v-price-no-VAT  )
     7466                   , input string( v-sum-no-VAT    )
     7467                   , input "без акциза":U
     7468                   , input string( ub.doc-line.Vat-pc  )
     7469                   , input string( v-VAT            )
     7470                   , input string( v-sum            )
     7471                   , input v-country-code
     7472                   , input v-country
     7473                   , input "":U
     7474               ).
     7475               if FullGdsName
     7476               and gds-str1 <> "":U then do :
     7477                  run print-more in this-procedure.
     7478               end.
     7479             end.
     7480               assign v-lines-counter = v-lines-counter + 1.
     7481           end.
     7482           else do:
     7483               define variable v-first-parts   as logical     no-undo.
     7484               assign
     7485                   v-first-parts = yes
     7486               .
     7487               for each ub.parts no-lock
     7488                  where ub.parts.out-code  = ub.doc-line.doc-code
     7489                    and ub.parts.obj-type  = ub.doc-line.obj-type
     7490                    and ub.parts.obj-code  = ub.doc-line.obj-code
     7491                    and ub.parts.artic     = ub.doc-line.artic
     7492                    and ub.parts.prod-type = ub.doc-line.prod-type
     7493                    and ub.parts.prod-code = ub.doc-line.prod-code
     7494               :
     7495                   assign
     7496                       v-GTD       = (if trim(ub.parts.cst-code) <> "" then ub.parts.cst-code else "             -             ")
     7497                       v-prt-qnty  = ub.parts.fact-qnty
     7498                       v-prt-doc-qnty = ub.parts.qnty
     7499                   .
     7500                   if available ub.country
     7501                   and ub.country.alpha1 = "RU":U
     7502                   then do:
     7503                       assign
     7504                           v-GTD       = "             -             ":U
     7505                           v-country-code   = "":U
     7506                           v-country   = "":U
     7507                       .
     7508                   end.
     7509                   find first buf_parts-attr no-lock
     7510                     where buf_parts-attr.in-code   = ub.parts.in-code
     7511                       and buf_parts-attr.gds-code  = ub.goods.gds-code
     7512                       and buf_parts-attr.part-code = ub.parts.part-code
     7513                   no-error .
     7514                   if available buf_parts-attr
     7515                     and buf_parts-attr.country-code <> 0
     7516                     then do:
     7517                         find first buf_country
     7518                         where buf_country.num-code = buf_parts-attr.country-code
     7519                         no-error.
     7520                         if available buf_country
     7521                         and buf_country.num-code <> ub.country.num-code
     7522                         and buf_country.short-name <> ""
     7523                         then do :
     7524                             assign
     7525                                 v-country-code = " " + string(buf_country.num-code)
     7526                                 v-country = buf_country.short-name
     7527                               .
     7528                             if buf_country.alpha1 = "RU":U
     7529                             then do :
     7530                                 assign
     7531                                   v-country-code   = "":U
     7532                                   v-country = "":U
     7533                                   v-GTD     = "             -             ":U
     7534                                 .
     7535                             end .
     7536                         end.
     7537                   end.
     7538                   if CostPrice = yes
     7539                   then do:
     7540   assign
     7541     price-rubl-with-tax-loc = ub.parts.price-rubl
     7542     price-base-with-tax-loc = ub.parts.price-base
     7543   .
     7544   define variable vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     7545   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     7546     (output varinvprb
     7547     )  .
     7548     if ub.parts.out-code = 'free-zone':U     or
     7549        ub.parts.out-code = 'out-zone':U   or
     7550        ub.parts.doc-type = 'акт':U then do:
     7551       assign
     7552         in-vatp-have-vat-slt = yes.
     7553     end.
     7554     else do:
     7555       find first in-vatp_doc-attr no-lock
     7556         where in-vatp_doc-attr.doc-code  = ub.parts.out-code
     7557           and in-vatp_doc-attr.attr-code = 'envd':U
     7558         no-error .
     7559       if not available in-vatp_doc-attr then do:
     7560         assign
     7561           in-vatp-have-vat-slt = yes.
     7562       end.
     7563       else do:
     7564            in-vatp-have-vat-slt = no.
     7565       end.
     7566     end.
     7567     assign
     7568      price-cli-with-tax-loc = ub.parts.price-cli
     7569      cli-base-rate          = ub.parts.cli-base-rate.
     7570     ASSIGN   road-tax-base-loc  = (if ub.parts.road-tax-base  = ? then 0 else ub.parts.road-tax-base)
     7571              road-tax-rubl-loc  = (if ub.parts.road-tax-rubl  = ? then 0 else ub.parts.road-tax-rubl).
     7572     ASSIGN  transport-base-loc = (if ub.parts.transport-base = ? then 0 else ub.parts.transport-base)
     7573             transport-rubl-loc = (if ub.parts.transport-rubl = ? then 0 else ub.parts.transport-rubl)
     7574             other-base-loc     = (if ub.parts.other-base     = ? then 0 else ub.parts.other-base)
     7575             other-rubl-loc     = (if ub.parts.other-rubl     = ? then 0 else ub.parts.other-rubl)
     7576             vat-pc-loc         = (if ub.parts.vat-pc         = ? then 0 else ub.parts.vat-pc)
     7577             slt-pc-loc         = (if ub.parts.slt-pc         = ? then 0 else ub.parts.slt-pc).
     7578             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     7579       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     7580     assign
     7581       exch-rate-cli-loc = (ub.parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if ub.parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if ub.parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / ub.parts.price-cli .
     7582     assign
     7583       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     7584       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     7585       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     7586       transport-cli-loc  = 0
     7587       other-cli-loc      = 0
     7588     .
     7589   ASSIGN
     7590             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     7591       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     7592   .
     7593                       assign
     7594                           v-parts-VAT       = ( if PrintRubl then vat-rubl-loc      else vat-base-loc )
     7595                           v-parts-SLT       = ( if PrintRubl then slt-rubl-loc      else slt-base-loc )
     7596                           v-tax-price       = ( if PrintRubl then road-tax-rubl-loc else road-tax-base-loc )
     7597                       .
     7598                       if v-parts-VAT = ?  then assign v-parts-VAT = 0.
     7599                       if v-parts-SLT = ?  then assign v-parts-SLT = 0.
     7600                       if v-tax-price = ?  then assign v-tax-price = 0.
     7601                       assign
     7602                           v-parts-price-no-VAT    =
     7603                                             ( if PrintRubl
     7604                                             then price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - road-tax-rubl-loc
     7605                                             else price-base-with-tax-loc - vat-base-loc - slt-base-loc - road-tax-base-loc )
     7606                           v-parts-sum             =
     7607                                             ( if PrintRubl
     7608                                             then price-rubl-with-tax-loc
     7609                                             else price-base-with-tax-loc ) * v-prt-qnty
     7610                       .
     7611                       if v-r-factur-is-vozvrat-vnesh = yes
     7612                       then do:
     7613                           assign
     7614                               v-parts-price-no-VAT = v-parts-price-no-VAT
     7615                                               - ( if PrintRubl
     7616                                                   then ( transport-rubl-loc + other-rubl-loc )
     7617                                                   else ( transport-base-loc + other-base-loc ) )
     7618                               v-parts-sum          = v-parts-sum
     7619                                               - ( ( if PrintRubl
     7620                                                     then ( transport-rubl-loc + other-rubl-loc )
     7621                                                     else ( transport-base-loc + other-base-loc ) ) * v-prt-qnty )
     7622                           .
     7623                       end.
     7624                       if p-round = 'round':U
     7625                       then do:
     7626                           if v-first-parts = yes
     7627                           then do:
     7628                               assign
     7629                                   v-first-parts   = no
     7630                                   v-sum-no-VAT    = 0
     7631                                   v-VAT           = 0
     7632                                   v-SLT           = 0
     7633                                   v-tax           = 0
     7634                                   v-sum           = 0
     7635                               .
     7636                           end.
     7637                           run p-fmt-round in this-procedure (
     7638                                 input v-prt-qnty
     7639                               , input v-parts-price-no-VAT
     7640                               , input v-parts-VAT
     7641                               , input v-parts-SLT
     7642                               , input v-tax-price
     7643                               , output v-parts-price-no-VAT
     7644                               , output v-parts-VAT
     7645                               , output v-parts-SLT
     7646                               , output v-sum-VAT
     7647                               , output v-sum-SLT
     7648                               , output v-sum-tax
     7649                               , output v-parts-sum-no-VAT
     7650                               , output v-parts-sum
     7651                           ).
     7652                           assign
     7653                               v-sum-no-VAT    = v-sum-no-VAT  + v-parts-sum-no-VAT
     7654                               v-VAT           = v-VAT         + v-sum-VAT
     7655                               v-SLT           = v-SLT         + v-sum-SLT
     7656                               v-tax           = v-tax         + v-sum-tax
     7657                               v-sum           = v-sum         + v-parts-sum
     7658                           .
     7659                       end.
     7660                       if lookup ( "corr" , p-mode ) <> 0 then do :
     7661                           display stream Out-stream
     7662                               sym1 gds-str1                                                           @ ub.goods.gds-name
     7663                               sym2 "А (до изменения)"                                                 @ v-pokazately
     7664                               sym3 "  -   " @ v-uaes-code
     7665                               sym16 v-unit-code
     7666                               sym4 ( if invers then ("  " + ub.doc-line.unit-cli) else ("  " + ub.goods.unit-base) )          @ ub.goods.unit-base
     7667                               sym5 v-prt-doc-qnty                                                         @ v-qnty
     7668                               sym6 v-parts-price-no-VAT                                               @ v-price-no-VAT
     7669                               sym7 v-parts-price-no-VAT * v-prt-doc-qnty                                  @ v-sum-no-VAT
     7670                               sym8 "без акциза" format "x(10)"                                             @ v-sum-actciz
     7671                               sym9 ub.doc-line.Vat-pc
     7672                               sym10 v-parts-VAT * v-prt-doc-qnty  when v-qnty <> 0                         @ v-VAT
     7673                               sym11 (v-parts-price-no-VAT + v-parts-VAT) * v-prt-doc-qnty                         @ v-sum
     7674                               sym12
     7675                           with frame corr-factur .
     7676                           down stream Out-stream 1
     7677                           with frame corr-factur .
     7678                           assign v-start-str = gds-str2
     7679                                 gds-str = v-start-str
     7680                                 v-add-str = breakstr(gds-str, 42, input-output v-add-str, input-output v-start-str).
     7681                           display stream Out-stream
     7682                               sym1 v-add-str                                                          @ ub.goods.gds-name
     7683                               sym2 "Б (после изменения)"                                                 @ v-pokazately
     7684                               sym3 "  -   " @ v-uaes-code
     7685                               sym16 v-unit-code
     7686                               sym4 ( if invers then ("  " + ub.doc-line.unit-cli) else ("  " + ub.goods.unit-base) )          @ ub.goods.unit-base
     7687                               sym5 v-prt-qnty                                                         @ v-qnty
     7688                               sym6 v-parts-price-no-VAT                                               @ v-price-no-VAT
     7689                               sym7 v-parts-price-no-VAT * v-prt-qnty                                  @ v-sum-no-VAT
     7690                               sym8 "без акциза" format "x(10)"                                             @ v-sum-actciz
     7691                               sym9 ub.doc-line.Vat-pc
     7692                               sym10 v-parts-VAT * v-prt-qnty  when v-qnty <> 0                         @ v-VAT
     7693                               sym11 v-parts-sum                                                        @ v-sum
     7694                               sym12
     7695                           with frame corr-factur .
     7696                           down stream Out-stream 1
     7697                           with frame corr-factur .
     7698                           assign v-diff-sum-no-VAT  = (v-parts-price-no-VAT * (v-prt-qnty - v-prt-doc-qnty))
     7699                                  v-diff-VAT         = (v-parts-VAT * (v-prt-qnty - v-prt-doc-qnty))
     7700                                  v-diff-sum         = (v-parts-sum - ((v-parts-price-no-VAT + v-parts-VAT) * v-prt-doc-qnty))
     7701                           .
     7702                           assign gds-str = v-start-str
