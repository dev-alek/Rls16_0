      243   function cross-list returns logical (
      244     input parfirst-stream  as character,
      245     input parsecond-stream as character,
      246     input pardelim         as character).
      247     if pardelim = ""
      248     or pardelim = ?
      249     then do:
      250       assign
      251         pardelim = ","
      252       .
      253     end.
      254     define variable vari            as integer no-undo .
      255     define variable varresult-cross as logical no-undo .
      256     assign
      257       varresult-cross = no
      258     .
      259     def var v-num-parfirst-stream as integer no-undo .
      260     assign
      261       v-num-parfirst-stream = num-entries(parfirst-stream, pardelim)
      262     .
      263     do vari = 1 to v-num-parfirst-stream
      264     :
      265       if lookup(entry(vari, parfirst-stream, pardelim)
      266                ,parsecond-stream
      267                ,pardelim
      268                ) > 0 then do:
      269         assign
      270           varresult-cross = yes
      271         .
      272         leave.
      273       end.
      274     end.
      275     return varresult-cross .
      276   end function.
      277   function hvrdtax return logical (input parrecid as recid):
      278   define variable varresult as logical no-undo.
      279   run hvrdtax-proc (input parrecid, output varresult).
      280   return varresult.
      281   end function.
      282   procedure hvrdtax-proc:
      283   define input  parameter parrecid  as recid   no-undo.
      284   define output parameter parresult as logical no-undo.
      285   define buffer bf_goods for ub.goods.
      286   define buffer bf_units for ub.units.
      287   define buffer rt_tax   for ub.tax.
      288   find first rt_tax   where rt_tax.tax-code    = integer('3':U) no-lock no-error.
      289   find first bf_goods where recid(bf_goods)    = parrecid              no-lock.
      290   find first bf_units where bf_units.unit-name = bf_goods.unit-base    no-lock.
      291   if available rt_tax and
      292       can-find(first ub.tax-units No-LOCK WHERE
      293                      ub.tax-units.tax-code = rt_tax.tax-code AND
      294                      LOOKUP(ub.tax-units.type, bf_units.type) > 0) then assign parresult = yes.
      295                                                       else assign parresult = no.
      296   end procedure.
      297   def var vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      298   procedure tax-name:
      299   define input  parameter pardef-tax  as character           no-undo.
      300   define output parameter parname-tax as character initial ? no-undo.
      301   define buffer bf_tax for ub.tax.
      302   do on error undo, return error :
      303      case pardef-tax:
      304         when 'vat':U then do:
      305                     find first bf_tax where bf_tax.tax-code = integer('1':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '1':U(не задействован)".
      306         end.
      307         when 'slt':U then do:
      308                     find first bf_tax where bf_tax.tax-code = integer('2':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '2':U(не задействован)".
      309         end.
      310         when 'rdt':U then do:
      311                     find first bf_tax where bf_tax.tax-code = integer('3':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '3':U(не задействован)".
      312         end.
      313         when 'exc':U then do:
      314                     find first bf_tax where bf_tax.tax-code = integer('4':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '4':U(не задействован)".
      315         end.
      316         otherwise do:
      317            return error "Задан неверный параметр " + pardef-tax + " .".
      318         end.
      319      end case.
      320   end.
      321   end procedure.
