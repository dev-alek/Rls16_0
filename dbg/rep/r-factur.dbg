     5820               v-tot-prt-doc-qnty      = 0
     5821               v-tot-prt-VAT           = 0
     5822               v-tot-prt-doc-VAT       = 0
     5823               v-tot-prt-SLT           = 0
     5824               v-tot-prt-sum-no-VAT    = 0
     5825               v-tot-prt-doc-sum-no-VAT    = 0
     5826               v-tot-prt-sum           = 0
