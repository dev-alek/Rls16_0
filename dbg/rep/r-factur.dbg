      357   do
      358   for buf_fin-schet
      359     , buf_fin-bank
      360   on error undo, return error
      361   :
      362       assign
      363           v-fmtcli-schet-exists       = no
      364           v-fmtcli-bank-exists        = no
      365           v-fmtcli-bank-r-schet       = "":U
      366           v-fmtcli-bank-c-schet       = "":U
      367           v-fmtcli-bank-bik           = "":U
      368           v-fmtcli-bank-name          = "":U
      369           v-fmtcli-bank-addres        = "":U
      370           v-fmtcli-bank-city          = "":U
      371       .
      372       search-for-schet:
      373       for each buf_fin-schet no-lock
      374          where buf_fin-schet.host-code = p-host-code
      375            and buf_fin-schet.cli-type  = p-obj-type
      376            and buf_fin-schet.cli-code  = p-obj-code
      377            and buf_fin-schet.curr-code = p-curr-code
      378       on error undo, return error
      379       :
      380           if buf_fin-schet.status_   = 'удал':U
      381           then do:
      382           end.
      383           else do:
      384               assign
      385                   v-fmtcli-schet-exists   = yes
      386                   v-fmtcli-bank-r-schet   = trim( buf_fin-schet.r-schet )
      387                   v-fmtcli-bank-c-schet   = trim( buf_fin-schet.c-schet )
      388               .
      389               find first buf_fin-bank no-lock
      390                    where buf_fin-bank.host-code = p-host-code
      391                      and buf_fin-bank.code-bank = buf_fin-schet.code-bank
      392               no-error.
      393               if available buf_fin-bank
      394               then do:
      395                   assign
      396                       v-fmtcli-bank-exists      = yes
      397                       v-fmtcli-bank-bik         = trim( buf_fin-bank.bik )
      398                       v-fmtcli-bank-name        = trim( buf_fin-bank.bank-name )
      399                       v-fmtcli-bank-addres      = trim(buf_fin-bank.addres)
      400                       v-fmtcli-bank-city      = trim(buf_fin-bank.bank-city)
      401                   .
      402               end.
      403               else do:
      404                   assign
      405                       v-fmtcli-bank-exists    = no
      406                       v-fmtcli-bank-bik       = "":U
      407                       v-fmtcli-bank-name      = "":U
      408                       v-fmtcli-bank-addres    = "":U
      409                       v-fmtcli-bank-city      = "":U
      410                   .
      411               end.
      412               leave search-for-schet.
      413           end.
      414       end.
      415   end.
      416   end procedure.
      417   procedure fmtcli-get-client :
      418   define input parameter p-obj-type       as character    no-undo.
      419   define input parameter p-obj-code       as integer      no-undo.
      420       define variable v-temp-fmtcli-address      as character     no-undo.
      421       define variable v-num-country-city    as integer      no-undo.
      422       define buffer buf_clients   for ub.clients.
      423       define buffer buf_firm      for ub.firm.
      424       define buffer buf_store     for ub.store.
      425       define buffer buf_shop      for ub.shop.
      426       define buffer buf_person    for ub.person.
      427   do
      428   for buf_clients
      429     , buf_firm
      430     , buf_store
      431     , buf_shop
      432     , buf_person
      433   on error undo, return error
      434   :
      435       assign
      436           v-fmtcli-name           = "":U
      437           v-fmtcli-addres         = "":U
      438           v-fmtcli-post-addres    = "":U
      439           v-fmtcli-full-addres    = "":U
      440           v-fmtcli-phone          = "":U
      441           v-fmtcli-inn            = "":U
      442           v-fmtcli-kpp            = "":U
      443           v-fmtcli-okpo           = "":U
      444           v-fmtcli-city           = "":U
      445           v-fmtcli-index          = "":U
      446           v-fmtcli-country        = "":U
      447       .
      448       find first buf_clients no-lock
      449            where buf_clients.obj-type = p-obj-type
      450              and buf_clients.obj-code = p-obj-code
      451       .
      452       assign
      453           v-fmtcli-name = buf_clients.obj-name
      454       .
      455       case buf_clients.obj-type:
      456          when 'орг':U
      457          then do:
      458               find first buf_firm no-lock
      459                    where buf_firm.firm-code = buf_clients.obj-code
      460                    no-error
      461               .
      462               if available buf_firm
      463               then do:
      464                   assign
      465                       v-num-country-city = num-entries( buf_firm.city )
      466                       v-fmtcli-engl-name = buf_firm.engl-name
      467                   .
      468                   if v-num-country-city > 0
      469                   then do:
      470                       assign
      471                           v-fmtcli-country    = trim( entry( 1, buf_firm.city ) )
      472                       .
      473                   end.
      474                   if v-num-country-city > 1
      475                   then do:
      476                       assign
      477                           v-fmtcli-city       = trim( entry( 2, buf_firm.city ) )
      478                       .
      479                   end.
      480                   run fmtcli-concatenate-strings in this-procedure (
      481                         input v-fmtcli-full-addres
      482                       , input v-fmtcli-country
      483                       , input ", ":U
      484                       , input 50
      485                       , output v-fmtcli-full-addres
      486                   ).
      487                   run fmtcli-concatenate-strings in this-procedure (
      488                         input v-fmtcli-full-addres
      489                       , input v-fmtcli-city
      490                       , input ", ":U
      491                       , input 50
      492                       , output v-fmtcli-full-addres
      493                   ).
      494                   run fmtcli-concatenate-strings in this-procedure (
      495                         input v-fmtcli-full-addres
      496                       , input IF buf_firm.ind = 0 THEN "" ELSE string( buf_firm.ind )
      497                       , input ", ":U
      498                       , input 50
      499                       , output v-fmtcli-full-addres
      500                   ).
      501                   run fmtcli-concatenate-strings in this-procedure (
      502                         input v-fmtcli-post-addres
      503                       , input v-fmtcli-country
      504                       , input ", ":U
      505                       , input 50
      506                       , output v-fmtcli-post-addres
      507                   ).
      508                   run fmtcli-concatenate-strings in this-procedure (
      509                         input v-fmtcli-post-addres
      510                       , input v-fmtcli-city
      511                       , input ", ":U
      512                       , input 50
      513                       , output v-fmtcli-post-addres
      514                   ).
      515                   run fmtcli-concatenate-strings in this-procedure (
      516                         input v-fmtcli-post-addres
      517                       , input string( buf_firm.ind )
      518                       , input ", ":U
      519                       , input 50
      520                       , output v-fmtcli-post-addres
      521                   ).
      522                   run fmtcli-concatenate-strings in this-procedure (
      523                         input substring( buf_firm.addres1, 1, 50 )
      524                       , input buf_firm.addres2
      525                       , input " ":U
      526                       , input 50
      527                       , output v-temp-fmtcli-address
      528                   ).
      529                   run fmtcli-concatenate-strings in this-procedure (
      530                         input v-temp-fmtcli-address
      531                       , input substring( buf_firm.addres1, 51, 50 )
      532                       , input " ":U
      533                       , input 50
      534                       , output v-temp-fmtcli-address
      535                   ).
      536                   run fmtcli-concatenate-strings in this-procedure (
      537                         input v-temp-fmtcli-address
      538                       , input substring( buf_firm.addres1, 101, 50 )
      539                       , input " ":U
      540                       , input 50
      541                       , output v-temp-fmtcli-address
      542                   ).
      543                   assign
      544                       v-fmtcli-addres = v-temp-fmtcli-address
      545                   .
      546                   if buf_firm.addres1 <> ?
      547                   then do:
      548                       run fmtcli-concatenate-strings in this-procedure (
      549                             input v-fmtcli-full-addres
      550                           , input v-fmtcli-addres
      551                           , input ", ":U
      552                           , input 0
      553                           , output v-fmtcli-full-addres
      554                       ).
      555                   end.
      556                   run fmtcli-concatenate-strings in this-procedure (
      557                         input substring( buf_firm.post-addr1, 1, 50 )
      558                       , input buf_firm.post-addr2
      559                       , input " ":U
      560                       , input 50
      561                       , output v-fmtcli-post-addres
      562                   ).
      563                   run fmtcli-concatenate-strings in this-procedure (
      564                         input v-fmtcli-post-addres
      565                       , input substring( buf_firm.post-addr1, 51, 50 )
      566                       , input " ":U
      567                       , input 50
      568                       , output v-fmtcli-post-addres
      569                   ).
      570                   run fmtcli-concatenate-strings in this-procedure (
      571                         input v-fmtcli-post-addres
      572                       , input substring( buf_firm.post-addr1, 101, 50 )
      573                       , input " ":U
      574                       , input 50
      575                       , output v-fmtcli-post-addres
      576                   ).
      577                   assign
      578                       v-fmtcli-phone         = buf_firm.phone
      579                       v-fmtcli-inn           = buf_firm.inn
      580                       v-fmtcli-kpp           = buf_firm.kpp
      581                       v-fmtcli-okpo          = buf_firm.okpo
      582                       v-fmtcli-index         = string( buf_firm.ind )
      583                   .
      584               end.
      585          end.
      586          when 'маг':U
      587          then do:
      588               find first buf_shop no-lock
      589                    where buf_shop.obj-code = buf_clients.obj-code
      590               .
      591               if available buf_shop
      592               then do:
      593                   run fmtcli-concatenate-strings in this-procedure (
      594                         input buf_shop.addres1
      595                       , input buf_shop.addres2
      596                       , input " ":U
      597                       , input 50
      598                       , output v-fmtcli-addres
      599                   ).
      600                   assign
      601                       v-fmtcli-full-addres = v-fmtcli-addres
      602                       v-fmtcli-post-addres = v-fmtcli-addres
      603                       v-fmtcli-phone       = buf_shop.phone
      604                       v-fmtcli-inn         = "":U
      605                       v-fmtcli-kpp         = "":U
      606                       v-fmtcli-okpo        = "":U
      607                       v-fmtcli-city        = "":U
      608                       v-fmtcli-index       = "":U
      609                   .
      610               end.
      611          end.
      612          when 'скл':U
      613          then do:
      614               find first buf_store no-lock
      615                    where buf_store.obj-code = buf_clients.obj-code
      616               .
      617               if available buf_store
      618               then do:
      619                   run fmtcli-concatenate-strings in this-procedure (
      620                         input buf_store.addres1
      621                       , input buf_store.addres2
      622                       , input " ":U
      623                       , input 50
      624                       , output v-fmtcli-addres
      625                   ).
      626                   assign
      627                       v-fmtcli-full-addres = v-fmtcli-addres
      628                       v-fmtcli-phone       = buf_store.phone
      629                       v-fmtcli-inn         = "":U
      630                       v-fmtcli-kpp         = "":U
      631                       v-fmtcli-okpo        = "":U
      632                       v-fmtcli-city        = "":U
      633                       v-fmtcli-index       = "":U
      634                   .
      635               end.
      636          end.
      637          when 'чел':U
      638          then do:
      639               find first buf_person no-lock
      640                    where buf_person.psn-code = buf_clients.obj-code
      641               .
      642               if available buf_person
      643               then do:
      644                   run fmtcli-concatenate-strings in this-procedure (
      645                         input ( if buf_person.ind = 0 or buf_person.ind = ?
      646                                 then "":U
      647                                 else string( buf_person.ind, "999999")
      648                                 )
      649                       , input buf_person.city
      650                       , input ", ":U
      651                       , input 0
      652                       , output v-fmtcli-full-addres
      653                   ).
      654                   assign
      655                       v-fmtcli-addres = buf_person.address
      656                   .
      657                   run fmtcli-concatenate-strings in this-procedure (
      658                         input v-fmtcli-full-addres
      659                       , input v-fmtcli-addres
      660                       , input ", ":U
      661                       , input 0
      662                       , output v-fmtcli-full-addres
      663                   ).
      664                   assign
      665                       v-fmtcli-phone     = buf_person.phone1
      666                       v-fmtcli-inn       = buf_person.inn
      667                       v-fmtcli-kpp       = buf_person.kpp
      668                       v-fmtcli-okpo      = buf_person.okpo
      669                       v-fmtcli-city      = buf_person.city
      670                       v-fmtcli-index     = string( buf_person.ind )
      671                   .
      672               end.
      673          end.
      674       end case.
      675   end.
      676   end procedure.
      677   procedure fmtcli-concatenate-strings :
      678   define input parameter p-string-1       as character        no-undo.
      679   define input parameter p-string-2       as character        no-undo.
      680   define input parameter p-delimiter      as character        no-undo.
      681   define input parameter p-length         as integer          no-undo.
      682   define output parameter p-out-string    as character        no-undo.
      683   do
      684   on error undo, return error
      685   :
      686       assign
      687           p-out-string = ( if p-string-1 = ?
      688                            then "":U
      689                            else trim( p-string-1 ) )
      690       .
      691       assign
      692           p-out-string = p-out-string
      693                        + ( if p-out-string = "":U
      694                            or length( p-out-string ) = p-length
      695                            or p-string-2 = ?
      696                            or trim( p-string-2 ) = "":U
      697                            then "":U
      698                            else p-delimiter )
      699                        + ( if p-string-2 = ?
      700                            or trim( p-string-2 ) = "":U
      701                            then "":U
      702                            else trim( p-string-2 ) )
      703       .
      704   end.
      705   end procedure.
