     5702   procedure print-more:
     5703   do
     5704   on error undo, return error
     5705   :
     5706       define variable v-start-string as character no-undo.
     5707       define variable v-add-string as character no-undo.
     5708       assign
     5709           v-start-string = gds-str2
     5710       .
     5711       do while trim(v-start-string) <> "" :
     5712           assign gds-str = v-start-string.
     5713           v-add-string = breakstr(gds-str, 42, input-output v-add-string, input-output v-start-string).
     5714           display stream Out-stream
     5715               sym1 (if rep-artic then fill(" ",17) else "") + v-add-string @ ub.goods.gds-name
     5716               sym2 sym3 sym4 sym5 sym6 sym7 sym8
