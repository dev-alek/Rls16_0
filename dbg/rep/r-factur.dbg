      350   procedure fmtcli-get-bank :
      351   define input parameter p-host-code      as integer          no-undo.
      352   define input parameter p-obj-type       as character        no-undo.
      353   define input parameter p-obj-code       as integer          no-undo.
      354   define input parameter p-curr-code      as integer          no-undo.
      355       define buffer buf_fin-schet     for ub.fin-schet.
