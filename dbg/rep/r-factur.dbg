     4236   procedure thbjattr_code :
     4237      define input  parameter p-upper-code     as character no-undo .
     4238      define input  parameter p-code           as character no-undo .
     4239      define output parameter p-label          as character no-undo .
     4240      define output parameter p-user-can-edit  as logical   no-undo .
     4241      define output parameter p-output-display as logical   no-undo .
     4242      define output parameter p-other          as character no-undo .
