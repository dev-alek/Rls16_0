     5769       if (units.type = "дро,2ед"  or  ub.units.type = "дро,доп" )
     5770       then do:
     5771           assign
     5772               str =  (if rep-artic then (string(ub.goods.artic,"x(16)") +  " ") else "")  + string(ub.goods.Sort,"x(5)") + " " + trim(ub.goods.gds-name)
     5773                                                                                    + " " + trim(ub.goods.PS)
     5774           .
     5775       end.
     5776       else do:
     5777           assign
     5778               str = (if rep-artic then (string(ub.goods.artic,"x(16)") +  " ") else "")  + trim(ub.goods.gds-name)
     5779           .
     5780       end.
     5781       assign
     5782           Gds-str1 = breakstr(str, 42, input-output gds-str1, input-output gds-str2)
     5783       .
     5784       do while trim(gds-str2) <> "" :
     5785           assign
     5786               gds-str = gds-str2
     5787               gds-str1 = breakstr(gds-str, 42, input-output gds-str1, input-output gds-str2)
     5788           .
     5789       end.
     5790       assign
