      915   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      916   procedure wthcattr-sprcli :
      917   define input parameter parparentproc  as widget-handle no-undo.
      918   define input parameter p-mode  as character no-undo.
      919   define input-output parameter p-value as character no-undo .
      920   define output parameter p-setted as logical no-undo .
      921     DEFINE VARIABLE v-value as character no-undo .
      922     define variable v-cli-type as character no-undo .
      923     define variable v-cli-code as integer no-undo .
      924     define buffer buf_clients   for ub.clients.
      925     define variable v_rid as character no-undo.
      926     define variable ref-rec as recid no-undo .
      927     do
      928     on error undo, return error
      929     :
      930         v-value = p-value.
      931      if p-value <> '':U then do:
      932       assign
      933       v-cli-type = substring(p-value, 1, 3)
      934       v-cli-code = integer(substring(p-value, 4))
      935       no-error.
      936       if error-status:error then do:
      937         assign
      938         v-cli-type = '':U
      939         v-cli-code = 0
      940         .
      941       end.
      942      end.
      943      FIND FIRST buf_clients NO-LOCK WHERE
      944               buf_clients.obj-type = v-cli-type AND
      945               buf_clients.obj-code = v-cli-code  NO-ERROR.
      946      IF available(buf_clients) then do:
      947       run ref/cli-all.w (
      948                   input parparentproc
      949                  ,input if p-mode = 'ИЗМЕНЕНИЕ':U then "b-sel":U else "":U
      950                  ,input v-cli-type
      951                  ,input 'все':U
      952                  ,input 'все':U
      953                  ,input RECID( buf_clients )
      954                  ,input ",,,,,,NO"
      955                  ,input ?
      956                  ,OUTPUT v_rid ).
      957     END.
      958     ELSE if p-mode = 'ИЗМЕНЕНИЕ':U then DO:
      959       run ref/cli-all.w (
      960                    input parparentproc
      961                   ,INPUT "b-sel":U
      962                  ,input  v-cli-type
      963                  ,input 'все':U
      964                  ,input 'текущие':U
      965                  ,input ?
      966                  ,input ",,,,,,NO"
      967                  ,input ?
      968                  ,OUTPUT v_rid ).
      969     END.
      970     else do:
      971       message
      972       if p-value = "":U then 'Атрибут не задан!'
      973       else substitute('Не найден клиент &1',p-value)
      974       view-as alert-box warning.
      975     end.
      976     IF v_rid <> ? AND v_rid <> "":U THEN DO:
      977       ASSIGN ref-rec = INT( v_rid ) NO-ERROR.
      978       IF ERROR-STATUS:ERROR THEN DO:
      979           RETURN NO-APPLY.
      980       END.
      981       FIND FIRST buf_clients NO-LOCK WHERE
      982                  RECID( buf_clients ) = ref-rec NO-ERROR.
      983       IF AVAIL buf_clients THEN DO:
      984         v-value = buf_clients.obj-type + string(buf_clients.obj-code, ">>>>>>>>9").
      985       end.
      986     end.
      987     if v-value <> p-value then do:
      988       p-value = v-value.
      989       p-setted = yes.
      990     end.
      991     end.
      992   end procedure.
      993     define new global shared variable g#wthcalib as handle no-undo.
      994   procedure torgconf-read :
      995   do
      996   on error undo, return error
      997   :
      998       define input parameter p-form-name  as character    no-undo.
