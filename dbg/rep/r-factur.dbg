     6202     (output varoutvprb
     6203     )  .
     6204   if varoutvprb = "base":u then do:
     6205     assign
     6206           road-tax-base-sale    =  (if ub.doc-line.road-tax = ? then 0 else ub.doc-line.road-tax * 1)
