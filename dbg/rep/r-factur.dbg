     6272           in-vatp-have-vat-slto = yes.
     6273       end.
     6274       else do:
     6275            in-vatp-have-vat-slto = no.
     6276       end.
     6277     end.
     6278     assign
     6279      price-cli-with-tax-loco = out-vatp_parts.price-cli
     6280      cli-base-rateo          = out-vatp_parts.cli-base-rate.
     6281     ASSIGN   road-tax-base-loco  = (if out-vatp_parts.road-tax-base  = ? then 0 else out-vatp_parts.road-tax-base)
     6282              road-tax-rubl-loco  = (if out-vatp_parts.road-tax-rubl  = ? then 0 else out-vatp_parts.road-tax-rubl).
     6283     ASSIGN  transport-base-loco = (if out-vatp_parts.transport-base = ? then 0 else out-vatp_parts.transport-base)
     6284             transport-rubl-loco = (if out-vatp_parts.transport-rubl = ? then 0 else out-vatp_parts.transport-rubl)
     6285             other-base-loco     = (if out-vatp_parts.other-base     = ? then 0 else out-vatp_parts.other-base)
     6286             other-rubl-loco     = (if out-vatp_parts.other-rubl     = ? then 0 else out-vatp_parts.other-rubl)
     6287             vat-pc-loco         = (if out-vatp_parts.vat-pc         = ? then 0 else out-vatp_parts.vat-pc)
     6288             slt-pc-loco         = (if out-vatp_parts.slt-pc         = ? then 0 else out-vatp_parts.slt-pc).
     6289             ASSIGN   slt-base-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-base-with-tax-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco)))                           * slt-pc-loco / (100 + slt-pc-loco))                        vat-base-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-base-with-tax-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco))) * (1 - slt-pc-loco / (100 + slt-pc-loco)) * vat-pc-loco / (100 + vat-pc-loco)).
     6290       ASSIGN   slt-rubl-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-rubl-with-tax-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco)))                           * slt-pc-loco / (100 + slt-pc-loco))                        vat-rubl-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-rubl-with-tax-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco))) * (1 - slt-pc-loco / (100 + slt-pc-loco)) * vat-pc-loco / (100 + vat-pc-loco)).
     6291     assign
     6292       exch-rate-cli-loco = (out-vatp_parts.price-rubl - transport-rubl-loco - other-rubl-loco - road-tax-rubl-loco - (if out-vatp_parts.vat-type <> 'в т. ч.':U then vat-rubl-loco else 0) - (if out-vatp_parts.slt-type <> 'в т. ч.':U then slt-rubl-loco else 0)) / out-vatp_parts.price-cli .
     6293     assign
     6294       slt-cli-loco        = slt-rubl-loco       / exch-rate-cli-loco
     6295       vat-cli-loco        = vat-rubl-loco       / exch-rate-cli-loco
     6296       road-tax-cli-loco   = road-tax-rubl-loco  / exch-rate-cli-loco
     6297       transport-cli-loco  = 0
     6298       other-cli-loco      = 0
     6299     .
     6300   ASSIGN
     6301             price-base-without-tax-loco = price-base-with-tax-loco - vat-base-loco - slt-base-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco))
     6302       price-rubl-without-tax-loco = price-rubl-with-tax-loco - vat-rubl-loco - slt-rubl-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco))
     6303   .
     6304         assign
     6305           varprice-base-cons = varprice-base-cons + (price-base-with-tax-loco - (if road-tax-base-loco = ? then 0 else road-tax-base-loco))* out-vatp_parts.fact-qnty
     6306           varprice-rubl-cons = varprice-rubl-cons + (price-rubl-with-tax-loco - (if road-tax-rubl-loco = ? then 0 else road-tax-rubl-loco))* out-vatp_parts.fact-qnty.
     6307         assign
     6308           varis-cons-parts-have = yes
     6309           varcons-qnty          = varcons-qnty + out-vatp_parts.fact-qnty.
     6310       end.
     6311       assign
     6312         varfact-qnty = varfact-qnty + out-vatp_parts.fact-qnty.
     6313     end.
     6314   end.
     6315   assign
     6316     varprice-base-cons = varprice-base-cons / varcons-qnty
     6317     varprice-rubl-cons = varprice-rubl-cons / varcons-qnty.
     6318   if varprice-base-cons = ? then do:
     6319     assign
     6320       varprice-base-cons = 0.
     6321   end.
     6322   if varprice-rubl-cons = ? then do:
     6323     assign
     6324       varprice-rubl-cons = 0.
     6325   end.
     6326   assign
     6327       slt-base-sale               = (if out-vatp-have-vat-slt = no then 0 else ub.gds-dtl.price-base - ub.gds-dtl.discnt-base                - road-tax-base-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc)
     6328     vat-base-buyer              = (if out-vatp-have-vat-slt = no then 0 else ub.gds-dtl.price-base - ub.gds-dtl.discnt-base - (if out-vatp-have-vat-slt = no then 0 else ub.gds-dtl.price-base - ub.gds-dtl.discnt-base                - road-tax-base-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - road-tax-base-sale) * ub.doc-line.vat-pc / (100 + ub.doc-line.vat-pc)
     6329     discnt-base-sale            = ub.gds-dtl.discnt-base
     6330     price-base-with-tax-sale    = (ub.gds-dtl.price-base - ub.gds-dtl.discnt-base)
     6331       slt-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else ub.gds-dtl.price-rubl - ub.gds-dtl.discnt-rubl                - road-tax-rubl-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc)
     6332     vat-rubl-buyer              = (if out-vatp-have-vat-slt = no then 0 else ub.gds-dtl.price-rubl - ub.gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else ub.gds-dtl.price-rubl - ub.gds-dtl.discnt-rubl                - road-tax-rubl-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - road-tax-rubl-sale) * ub.doc-line.vat-pc / (100 + ub.doc-line.vat-pc)
     6333     discnt-rubl-sale            = ub.gds-dtl.discnt-rubl
     6334     price-rubl-with-tax-sale    = (ub.gds-dtl.price-rubl - ub.gds-dtl.discnt-rubl)
     6335     .
     6336   if buf_trn-doc.doc-type = 'инв':U then do:
     6337     assign
     6338       varfact-qnty = ub.gds-dtl.doc-qnty.
     6339   end.
     6340   else do:
     6341     assign
     6342       varfact-qnty = ub.gds-dtl.fact-qnty.
     6343   end.
     6344   if varis-cons-parts-have = no then do:
     6345     assign
     6346           vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else ub.gds-dtl.price-base - ub.gds-dtl.discnt-base - (if out-vatp-have-vat-slt = no then 0 else ub.gds-dtl.price-base - ub.gds-dtl.discnt-base                - road-tax-base-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - road-tax-base-sale) * ub.doc-line.vat-pc / (100 + ub.doc-line.vat-pc)
     6347           vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else ub.gds-dtl.price-rubl - ub.gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else ub.gds-dtl.price-rubl - ub.gds-dtl.discnt-rubl                - road-tax-rubl-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - road-tax-rubl-sale) * ub.doc-line.vat-pc / (100 + ub.doc-line.vat-pc).
     6348   end.
     6349   else do:
     6350     if buf_trn-doc.doc-type = 'инв':U then do:
     6351       assign
     6352               vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else (((ub.gds-dtl.price-base - ub.gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else ub.gds-dtl.price-base - ub.gds-dtl.discnt-base                - road-tax-base-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - road-tax-base-sale - varprice-base-cons) * ub.doc-line.cons-vat-pc / (100 + ub.doc-line.cons-vat-pc) * ub.gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((ub.gds-dtl.price-base - ub.gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else ub.gds-dtl.price-base - ub.gds-dtl.discnt-base                - road-tax-base-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - road-tax-base-sale) * ub.doc-line.vat-pc / (100 + ub.doc-line.vat-pc) * ub.gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     6353               vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else (((ub.gds-dtl.price-rubl - ub.gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else ub.gds-dtl.price-rubl - ub.gds-dtl.discnt-rubl                - road-tax-rubl-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * ub.doc-line.cons-vat-pc / (100 + ub.doc-line.cons-vat-pc) * ub.gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((ub.gds-dtl.price-rubl - ub.gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else ub.gds-dtl.price-rubl - ub.gds-dtl.discnt-rubl                - road-tax-rubl-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - road-tax-rubl-sale) * ub.doc-line.vat-pc / (100 + ub.doc-line.vat-pc) * ub.gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     6354        .
     6355     end.
     6356     else do:
     6357       assign
     6358               vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else (((ub.gds-dtl.price-base - ub.gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else ub.gds-dtl.price-base - ub.gds-dtl.discnt-base                - road-tax-base-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - road-tax-base-sale - varprice-base-cons) * ub.doc-line.cons-vat-pc / (100 + ub.doc-line.cons-vat-pc) * ub.gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((ub.gds-dtl.price-base - ub.gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else ub.gds-dtl.price-base - ub.gds-dtl.discnt-base                - road-tax-base-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - varprice-base-cons) * ub.doc-line.vat-pc / (100 + ub.doc-line.vat-pc) * ub.gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     6359               vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else (((ub.gds-dtl.price-rubl - ub.gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else ub.gds-dtl.price-rubl - ub.gds-dtl.discnt-rubl                - road-tax-rubl-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * ub.doc-line.cons-vat-pc / (100 + ub.doc-line.cons-vat-pc) * ub.gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((ub.gds-dtl.price-rubl - ub.gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else ub.gds-dtl.price-rubl - ub.gds-dtl.discnt-rubl                - road-tax-rubl-sale) * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc) - varprice-rubl-cons) * ub.doc-line.vat-pc / (100 + ub.doc-line.vat-pc) * ub.gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     6360        .
     6361     end.
     6362   end.
     6363   assign
     6364   price-base-without-tax-sale = price-base-with-tax-sale - vat-base-sale - slt-base-sale - road-tax-base-sale
     6365   price-rubl-without-tax-sale = price-rubl-with-tax-sale - vat-rubl-sale - slt-rubl-sale - road-tax-rubl-sale.
     6366                   assign
     6367                       v-VAT = ( if PrintRubl then vat-rubl-buyer else vat-base-buyer )
     6368                       v-SLT = ( if PrintRubl then slt-rubl-sale else slt-base-sale )
     6369                   .
     6370                   if v-VAT = ? then assign v-VAT = 0.
     6371                   if v-SLT = ? then assign v-SLT = 0.
     6372                   assign
     6373                       v-price-no-VAT   = ( if PrintRubl then price-rubl-with-tax-sale else price-base-with-tax-sale ) - v-VAT - v-SLT
     6374                       v-prt-qnty       = ub.gds-dtl.fact-qnty
     6375                       v-prt-doc-qnty   = ub.gds-dtl.doc-qnty
     6376                   .
     6377                   if p-round = 'round':U
     6378                   then do:
     6379                       run p-fmt-round in this-procedure (
     6380                             input v-prt-qnty
     6381                           , input v-price-no-VAT
     6382                           , input v-VAT
     6383                           , input v-SLT
     6384                           , input 0
     6385                           , output v-price-no-VAT
     6386                           , output v-VAT
     6387                           , output v-SLT
     6388                           , output v-prt-VAT
     6389                           , output v-prt-SLT
     6390                           , output v-void-decimal
     6391                           , output v-prt-sum-no-VAT
     6392                           , output v-void-decimal
     6393                       ).
     6394                   end.
     6395                   else do:
     6396                       assign
     6397                           v-prt-VAT        = v-VAT          * v-prt-qnty
     6398                           v-prt-doc-VAT    = v-VAT          * v-prt-doc-qnty
     6399                           v-prt-SLT        = v-SLT          * v-prt-qnty
     6400                           v-prt-sum-no-VAT = v-price-no-VAT * v-prt-qnty
     6401                           v-prt-doc-sum-no-VAT = v-price-no-VAT * v-prt-doc-qnty
     6402                       .
     6403                   end.
     6404                   assign
     6405                       v-price          = v-price-no-VAT + v-VAT
     6406                       v-prt-sum        = v-prt-sum-no-VAT + v-prt-VAT
     6407                       v-prt-doc-sum        = v-prt-doc-sum-no-VAT + v-prt-doc-VAT
     6408                   .
     6409                   assign
     6410                       v-tot-prt-qnty          = v-tot-prt-qnty        + v-prt-qnty
     6411                       v-tot-prt-doc-qnty      = v-tot-prt-doc-qnty    + v-prt-doc-qnty
     6412                       v-tot-prt-VAT           = v-tot-prt-VAT         + v-prt-VAT
     6413                       v-tot-prt-doc-VAT       = v-tot-prt-doc-VAT     + v-prt-doc-VAT
     6414                       v-tot-prt-SLT           = v-tot-prt-SLT         + v-prt-SLT
     6415                       v-tot-prt-sum-no-VAT    = v-tot-prt-sum-no-VAT  + v-prt-sum-no-VAT
     6416                       v-tot-prt-doc-sum-no-VAT = v-tot-prt-doc-sum-no-VAT  + v-prt-doc-sum-no-VAT
     6417                       v-tot-prt-sum           = v-tot-prt-sum         + v-prt-sum
     6418                       v-tot-prt-doc-sum       = v-tot-prt-doc-sum     + v-prt-doc-sum
     6419                   .
     6420               end.
     6421               if v-must-print-scale
     6422               then do:
     6423                   find first ub.bar-code no-lock
     6424                        where ub.bar-code.gds-code    = ub.goods.gds-code
     6425                          and ub.bar-code.unit-cli    = ub.goods.unit-base
     6426                          and ub.bar-code.node-code   = ub.gds-dtl.prt-code
     6427                          and ub.bar-code.part-code   = ""
     6428                          and ub.bar-code.in-code     = ""
     6429                   .
     6430                   assign
     6431                       v-prt-name = ""
     6432                   .
     6433                   do while available ub.gds-prt:
     6434                       if available ub.gds-prt
     6435                       then do:
     6436                           assign
     6437                               v-prt-name     = "\" + string( ub.gds-prt.node-name, "X(10)" ) + v-prt-name
     6438                               v-node-code   = ub.gds-prt.upper-code
     6439                           .
     6440                       end.
     6441                       find first ub.gds-prt no-lock
     6442                            where ub.gds-prt.node-code = v-node-code
     6443                              and ub.gds-prt.root <> yes
     6444                       no-error.
     6445                   end.
     6446                   if lookup ( "corr" , p-mode ) <> 0 then do :
     6447                         display stream Out-stream
     6448                             sym1 v-prt-name                                                         @ ub.goods.gds-name
     6449                             sym2 "А (до изменения)"                                                 @ v-pokazately
     6450                             sym3 "  -   " @ v-uaes-code
     6451                             sym16 v-unit-code
     6452                             sym4 "  " + ub.goods.unit-base                                             @ ub.goods.unit-base
     6453                             sym5 v-prt-doc-qnty                                               @ v-qnty
     6454                             sym6 v-price-no-VAT
     6455                             sym7 v-prt-doc-sum-no-VAT          @ v-sum-no-VAT
     6456                             sym8 "без акциза" format "x(10)"                                             @ v-sum-actciz
     6457                             sym9 ub.doc-line.Vat-pc
     6458                             sym10 v-prt-doc-VAT when v-prt-qnty <> 0                 @ v-VAT
     6459                             sym11 v-prt-doc-sum       @ v-sum
     6460                             sym12
     6461                         with frame corr-factur .
     6462                         down stream Out-stream 1
     6463                         with frame corr-factur .
     6464                         assign v-start-str = gds-str2
     6465                               gds-str = v-start-str
     6466                               v-add-str = breakstr(gds-str, 42, input-output v-add-str, input-output v-start-str).
     6467                         display stream Out-stream
     6468                             sym1
     6469                             sym2 "Б (после изменения)"                                                 @ v-pokazately
     6470                             sym3 "  -   " @ v-uaes-code
     6471                             sym16 v-unit-code
     6472                             sym4 "  " + ub.goods.unit-base                                                @ ub.goods.unit-base
     6473                             sym5 v-prt-qnty                                             @ v-qnty
     6474                             sym6 v-price-no-VAT
     6475                             sym7 v-prt-sum-no-VAT               @ v-sum-no-VAT
     6476                             sym8 "без акциза" format "x(10)"                                             @ v-sum-actciz
     6477                             sym9 ub.doc-line.Vat-pc
     6478                             sym10 v-prt-VAT when v-prt-qnty <> 0                @ v-VAT
     6479                             sym11 v-prt-sum               @ v-sum
     6480                             sym12
     6481                         with frame corr-factur .
     6482                         down stream Out-stream 1
     6483                         with frame corr-factur .
     6484                         assign v-diff-sum-no-VAT  = (v-prt-sum-no-VAT - v-prt-doc-sum-no-VAT)
     6485                                v-diff-VAT         = (v-prt-VAT - v-prt-doc-VAT)
     6486                                v-diff-sum         = (v-prt-sum - v-prt-doc-sum)
     6487                         .
     6488                         assign gds-str = v-start-str
