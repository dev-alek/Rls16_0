     5884                                             sym4 sym5 sym6 sym7 sym8 sym9  sym11 sym12 sym16 with frame corr-factur .
     5885                   down stream Out-stream 1 with frame corr-factur .
     5886                 end.
     5887                 else do :
     5888                   display stream Out-stream sym1 gds-str1 @ goods.gds-name sym16 sym14 sym2 v-country sym3 v-GTD
     5889                                           sym4 sym5 sym6 sym7 sym8 sym9  sym11 sym15 sym12 sym13 with frame factur .
     5890                 down stream Out-stream 1 with frame factur .
     5891                   run facturxl-write-line-data in this-procedure (
     5892                         input gds-str1
     5893                       , input "":U
     5894                       , input "":U
     5895                       , input "":U
     5896                       , input "":U
     5897                       , input "":U
     5898                       , input "":U
     5899                       , input "":U
     5900                       , input "":U
     5901                       , input "":U
     5902                       , input "":U
     5903                       , input v-country-code
     5904                       , input v-country
     5905                       , input v-GTD
     5906                   ).
     5907               end.
     5908               end.
     5909               else do:
     5910                 if v-GTD <> "" and v-GTD <> "             -             " then do:
     5911                   display stream Out-stream sym1 sym16 sym14 sym2  sym3 v-GTD sym4 sym5 sym6 sym7 sym8 sym9  sym11 sym15 sym12 sym13 with frame factur .
     5912                   down stream Out-stream 1 with frame factur .
     5913                   run facturxl-write-line-data in this-procedure (
     5914                         input "":U
     5915                       , input "":U
     5916                       , input "":U
     5917                       , input "":U
     5918                       , input "":U
     5919                       , input "":U
     5920                       , input "":U
     5921                       , input "":U
     5922                       , input "":U
     5923                       , input "":U
     5924                       , input "":U
     5925                       , input "":U
     5926                       , input "":U
     5927                       , input v-GTD
     5928                   ).
     5929                 end.
     5930               end.
     5931             end.
     5932             if is-printed = no then do:
     5933               display stream Out-stream sym1 gds-str1 @ ub.goods.gds-name sym16 sym14 sym2 v-country sym3 sym4 sym5 sym6 sym7 sym8 sym9  sym11 sym15 sym12 sym13 with frame factur .
     5934               down stream Out-stream 1 with frame factur .
