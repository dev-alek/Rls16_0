       11   :
       12   define variable vss-revision    as character no-undo initial "$Revision: c93cbc1375c4, 1081, rls $":U .
       13   define variable vss-author      as character no-undo initial "$Author: SMMolotkov $":U .
       14   define variable vss-date        as character no-undo initial "$Date: Thu Oct 12 16:32:18 2017 +0300 $":U .
