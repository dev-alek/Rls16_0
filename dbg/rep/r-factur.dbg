     4244      define output parameter p-prop-type-list as character no-undo .
     4245      define output parameter p-prop-label-list as character no-undo .
     4246      define output parameter p-global          as logical no-undo .
     4247      define output parameter p-host           as logical no-undo .
     4248      define output parameter p-shop           as logical no-undo .
     4249      define output parameter p-store          as logical no-undo .
     4250      define output parameter p-db             as logical no-undo .
     4251      define variable p-region as logical no-undo.
     4252      run thbjattr_code_reg in this-procedure (
     4253                                               p-upper-code,
     4254                                               p-code,
     4255                                               output p-label,
     4256                                               output p-user-can-edit,
