       83   function breakstr returns character ( input        for-name    as character,
       84                                         input        line-length as integer,
       85                                         input-output line1       as character,
       86                                         input-output line2       as character ) :
       87     define variable ii as integer no-undo.
       88     if length( for-name ) > line-length then do:
       89       assign ii    = 1
       90              line1 = "":u
       91              line2 = "":u.
       92       if length( entry( ii, for-name , " ":u ) ) > line-length then do:
       93         assign line1 =       substring( for-name, 1, line-length     )
       94                line2 = trim( substring( for-name,    line-length + 1 ) ).
       95       end.                                                     else do:
       96         do while length( line1 + entry( ii, for-name, " ":u ) ) < ( line-length + 1 ) :
       97           assign line1 = line1 + entry( ii, for-name, " ":u ) + " ":u
       98                  ii    = ii    + 1.
       99           if length( entry( ii, for-name, " ":u ) ) > line-length then do:
      100             assign line1 = line1 + substring( for-name, length( line1 ), line-length - length( line1 ) + 1 ).
      101           end.
      102         end.
      103         assign line2 = trim( substring( for-name, length( line1 ) ) ).
      104       end.
      105     end.                                else do:
      106       assign line1 = for-name
      107              line2 = "":u.
      108     end.
      109     return ( line1 ).
      110   end function.
