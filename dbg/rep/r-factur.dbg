     4909           buf_temp_line-data.Name         = p-Name
     4910           buf_temp_line-data.pokazately   = p-pokazately
     4911           buf_temp_line-data.UAES         = p-UAES
     4912           buf_temp_line-data.OKEI         = p-OKEI
     4913           buf_temp_line-data.EI           = p-EI
