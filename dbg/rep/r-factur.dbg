     4526   def var vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4527   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     4528   procedure paramls-clear :
     4529     define buffer buf_temp-param for temp-param .
     4530     do
     4531     on error undo, return error return-value
     4532     :
     4533       for each buf_temp-param
     4534       on error undo, return error
     4535       :
     4536         delete buf_temp-param .
     4537       end.
     4538     end.
     4539   end procedure.
     4540   procedure paramls-write :
     4541     define input  parameter p-code     as character no-undo .
     4542     define input  parameter p-sub-code as character no-undo .
     4543     define input  parameter p-value    as character no-undo .
     4544     define buffer buf_temp-param for temp-param .
     4545     do
     4546     on error undo, return error return-value
     4547     :
     4548       find first buf_temp-param
     4549         where buf_temp-param.param-code     = p-code
     4550           and buf_temp-param.param-sub-code = p-sub-code
     4551         no-error .
     4552       if not available buf_temp-param then do:
     4553         create buf_temp-param .
     4554         assign
     4555           buf_temp-param.param-code     = p-code
     4556           buf_temp-param.param-sub-code = p-sub-code
     4557         .
     4558       end.
     4559       assign
     4560         buf_temp-param.param-value = p-value
     4561       .
     4562     end.
     4563   end procedure.
     4564   procedure paramls-read :
     4565     define input  parameter p-code          as character no-undo .
     4566     define input  parameter p-sub-code      as character no-undo .
     4567     define input  parameter p-default-value as character no-undo .
     4568     define output parameter p-value         as character no-undo .
     4569     define buffer buf_temp-param for temp-param .
     4570     do
     4571     on error undo, return error return-value
     4572     :
     4573       find first buf_temp-param
     4574         where buf_temp-param.param-code     = p-code
     4575           and buf_temp-param.param-sub-code = p-sub-code
     4576         no-error .
     4577       if available buf_temp-param then do:
     4578         assign
     4579           p-value = buf_temp-param.param-value
     4580         .
     4581       end.
     4582       else do:
     4583         assign
     4584           p-value = p-default-value
     4585         .
     4586       end.
     4587     end.
     4588   end procedure.
     4589   procedure paramls-append :
     4590     define input  parameter p-code     as character no-undo .
     4591     define input  parameter p-sub-code as character no-undo .
     4592     define input  parameter p-value    as character no-undo .
     4593     define buffer buf_temp-param for temp-param .
     4594     do
     4595     on error undo, return error return-value
     4596     :
     4597       find first buf_temp-param
     4598            where buf_temp-param.param-code     = p-code
     4599              and buf_temp-param.param-sub-code = p-sub-code
     4600         no-error .
     4601       if not available buf_temp-param then do:
     4602         create buf_temp-param .
     4603         assign
     4604           buf_temp-param.param-code     = p-code
     4605           buf_temp-param.param-sub-code = p-sub-code
     4606           buf_temp-param.param-value    = p-value
     4607         .
     4608       end.
     4609       else do:
     4610           assign
     4611               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     4612           .
     4613       end.
     4614     end.
     4615   end procedure.
     4616   define variable vss-include-info22 as character format "X(65)" no-undo
     4617   initial "@(#)$Workfile$ $Revision$".
     4618   define stream excel-line.
     4619   define stream excel-cell.
     4620   define temp-table temp_cell-data no-undo
     4621       field data-key as character
     4622       field data-value as character
     4623       index pi is primary unique data-key
     4624   .
     4625   define temp-table temp_line-data no-undo
     4626       field data-key     as character
     4627       field xl-line-id   as integer
     4628       field Name         as character
     4629       field pokazately   as character
     4630       field UAES         as character
     4631       field OKEI         as character
     4632       field EI           as character
     4633       field qnty         as character
     4634       field price        as character
     4635       field SumNoVAT     as character
     4636       field SumActciz    as character
     4637       field VATpc        as character
     4638       field VATsum       as character
     4639       field sum          as character
     4640       field countrycode  as character
     4641       field country      as character
     4642       field GTD          as character
     4643       index pi is primary unique xl-line-id
     4644   .
     4645   define variable v-facturxl-current-data-row     as integer      no-undo.
     4646   define variable v-facturxl-cell-file-name       as character    no-undo.
     4647   define variable v-facturxl-data-file-name       as character    no-undo.
     4648   procedure facturxl-init :
     4649       define buffer buf_temp_cell-data        for temp_cell-data.
     4650       define buffer buf_usr-flt               for ubflt.usr-flt.
     4651       define variable v-column-list as character no-undo .
     4652       define variable v-column-type as character no-undo .
     4653       define variable v-num-cloumns as integer no-undo .
     4654   do
     4655   for buf_temp_cell-data
     4656     , buf_usr-flt
     4657   on error undo, return error
     4658   :
     4659       assign
     4660           v-facturxl-current-data-row = 0
     4661       .
     4662       run gbl/_tmpfile.p (
     4663             input "xd"
     4664           , input ".txt"
     4665           , output v-facturxl-data-file-name
     4666       ).
     4667       output stream excel-line to value( v-facturxl-data-file-name ).
     4668       run gbl/_tmpfile.p (
     4669             input "xc"
     4670           , input ".txt"
     4671           , output v-facturxl-cell-file-name
     4672       ).
     4673       output stream excel-cell to value( v-facturxl-cell-file-name ).
     4674       run facturxl-write-cell-data in this-procedure (
     4675             input "valutCode":U
     4676           , input if printrubl then "0":U else "1":U
     4677       ).
     4678     if lookup ("corr" , p-mode) <> 0 then do :
     4679       v-column-list = "Name,pokazately,UAES,OKEI,EI,qnty,price,SumNoVAT,SumActciz,VATpc,VATsum,sum":U .
     4680       v-column-type = "S,S,S,I,S,D,C,C,S,D,C,C":U .
     4681     end.
     4682     else do :
     4683       v-column-list = "Name,UAES,OKEI,EI,qnty,price,SumNoVAT,SumActciz,VATpc,VATsum,sum,countrycode,country,GTD":U .
     4684       v-column-type = "S,S,I,S,D,C,C,S,D,C,C,I,S,S":U .
     4685     end.
     4686     v-num-cloumns = num-entries(v-column-list) .
     4687     run facturxl-write-cell-data in this-procedure (
     4688             input "columnList":U
     4689           , input v-column-list
     4690     ).
     4691     run facturxl-write-cell-data in this-procedure (
     4692             input "columnType":U
     4693           , input v-column-type
     4694     ).
     4695     run facturxl-write-cell-data in this-procedure (
     4696             input "columnAmount":U
     4697           , input string(v-num-cloumns)
     4698     ).
     4699     if lookup ("corr" , p-mode) <> 0 then .
     4700     else do :
     4701       run facturxl-write-cell-data in this-procedure (
     4702             input "subtotalList":U
     4703           , input "SumNoVAT,VATsum,sum":U
     4704       ).
     4705       run facturxl-write-cell-data in this-procedure (
     4706             input "subtotalType":U
     4707           , input "S,S,S":U
     4708       ).
     4709       run facturxl-write-cell-data in this-procedure (
     4710             input "subtotalAmount":U
     4711           , input "3":U
     4712       ).
     4713     end.
     4714   end.
     4715   end procedure.
     4716   procedure facturxl-close :
     4717   do
     4718   on error undo, return error
     4719   :
     4720       output stream excel-line close.
     4721       output stream excel-cell close.
     4722       output to value( string( session:temp-directory + "$" + string( g#report-num ) ) + ".txl" ) append.
     4723           export "exe/sf_97.xlt":U.
     4724           export "exe/t_97.bas":U.
     4725           export v-facturxl-cell-file-name.
     4726           export v-facturxl-data-file-name.
     4727       output close.
     4728   end.
     4729   end procedure.
