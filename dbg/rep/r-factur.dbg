     5609             v-single-line format "X(199)" skip(0)
     5610         .
     5611   END.
     5612   for each ub.doc-line no-lock
     5613      where ub.doc-line.doc-code = buf_trn-doc.doc-code
     5614   break by ub.doc-line.artic
     5615   :
     5616       run print-line in this-procedure .
     5617   end.
     5618   run print-footer in this-procedure .
     5619   if lookup ("corr" , p-mode) <> 0 then do :
     5620     run facturxl-close-corr in this-procedure .
     5621   end.
     5622   else if lookup ("TopAukc" , p-mode) <> 0 then do :
     5623     run facturxl-close-topaukc in this-procedure .
     5624   end.
     5625   else do :
     5626   run facturxl-close in this-procedure .
     5627   end.
     5628   if lookup( "corr", p-mode ) <> 0
     5629   THEN DO:
     5630     hide stream Out-stream frame Bottomframe-corr .
     5631   END.
     5632   ELSE DO:
     5633   hide stream Out-stream frame Bottomframe .
     5634   END.
     5635   output stream Out-stream close.
     5636   if session :set-wait-state( "" ) then.
     5637   def var Log-Res as logical no-undo .
