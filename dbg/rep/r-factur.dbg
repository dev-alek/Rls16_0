     5953                  run print-more in this-procedure.
     5954               end.
     5955             end.
     5956           end.
     5957           for each ub.gds-dtl no-lock
     5958              where ub.gds-dtl.prod-type  = ub.doc-line.prod-type
     5959                and ub.gds-dtl.prod-code  = ub.doc-line.prod-code
     5960                and ub.gds-dtl.artic      = ub.doc-line.artic
     5961                and ub.gds-dtl.doc-code   = ub.doc-line.doc-code
     5962           :
     5963               find first ub.gds-prt no-lock
     5964                    where ub.gds-prt.node-code = ub.gds-dtl.prt-code
     5965               .
     5966               if CostPrice = yes
     5967               then do:
     5968   assign
     5969     price-rubl-with-tax-loc = ub.doc-line.price-rubl
     5970     price-base-with-tax-loc = ub.doc-line.price-base
     5971   .
     5972   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     5973   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     5974     (output varinvprb
     5975     )  .
     5976      find first in-vatp_doc-attr no-lock
     5977       where in-vatp_doc-attr.doc-code  = buf_trn-doc.doc-code
     5978         and in-vatp_doc-attr.attr-code = 'envd':U
     5979       no-error .
     5980       if available in-vatp_doc-attr
     5981          then do:
     5982          assign
     5983            in-vatp-have-vat-slt = no.
     5984      end.
     5985      else do:
     5986        assign
     5987          in-vatp-have-vat-slt = yes.
     5988      end.
     5989      find first in-vatp-goods where in-vatp-goods.artic     = ub.doc-line.artic     and
     5990                                        in-vatp-goods.prod-type = ub.doc-line.prod-type and
     5991                                        in-vatp-goods.prod-code = ub.doc-line.prod-code no-lock.
     5992      if (not buf_trn-doc.internal and
     5993              buf_trn-doc.doc-type = 'при':U) or
     5994         in-vatp-goods.gds-type = 'у':U then do:
     5995         if varinvprb = "base":u then do:
     5996           assign
     5997             road-tax-base-loc = ub.doc-line.road-tax
     5998             road-tax-rubl-loc = ub.doc-line.road-tax * buf_trn-doc.base-rate / buf_trn-doc.base-scale.
     5999         end.
     6000         else do:
     6001           ASSIGN
     6002             road-tax-rubl-loc = ub.doc-line.road-tax
     6003             road-tax-base-loc = ub.doc-line.road-tax / buf_trn-doc.base-rate * buf_trn-doc.base-scale.
     6004         end.
     6005         if road-tax-base-loc = ? then road-tax-base-loc = 0.
     6006         if road-tax-rubl-loc = ? then road-tax-rubl-loc = 0.
     6007         assign
     6008           road-tax-cli-loc = ?.
     6009         ASSIGN
     6010           transport-base-loc = (if ub.doc-line.transport-base = ? then 0 else ub.doc-line.transport-base)
     6011           transport-rubl-loc = (if ub.doc-line.transport-rubl = ? then 0 else ub.doc-line.transport-rubl)
     6012           transport-cli-loc  = 0
     6013           other-base-loc     = (if ub.doc-line.other-base     = ? then 0 else ub.doc-line.other-base)
     6014           other-rubl-loc     = (if ub.doc-line.other-rubl     = ? then 0 else ub.doc-line.other-rubl)
     6015           other-cli-loc      = 0
     6016           vat-pc-loc         = (if ub.doc-line.vat-pc         = ? then 0 else ub.doc-line.vat-pc)
     6017           slt-pc-loc         = (if ub.doc-line.slt-pc         = ? then 0 else ub.doc-line.slt-pc).
     6018                                 ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     6019               ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     6020         assign
     6021           vat-cli-loc            = ?
     6022           slt-cli-loc            = ?
     6023           price-cli-with-tax-loc = ?.
     6024      end.
     6025      else do:
     6026                                                   for each in-vatp-parts where in-vatp-parts.out-code  = ub.doc-line.doc-code  and
     6027                                         in-vatp-parts.obj-type  = ub.doc-line.obj-type  and
     6028                                         in-vatp-parts.obj-code  = ub.doc-line.obj-code  and
     6029                                         in-vatp-parts.artic     = ub.doc-line.artic     and
