     8060                               ( if PrintRubl then parts.road-tax-rubl * v-prt-qnty
     8061                                              else parts.road-tax-base * v-prt-qnty )
     8062                       , input "   ---":U
     8063                       , input "":U
     8064                       , input "0":U
     8065                       , input
     8066                               ( if PrintRubl then parts.road-tax-rubl * v-prt-qnty
     8067                                              else parts.road-tax-base * v-prt-qnty )
     8068                       , input "":U
     8069                       , input "":U
     8070                       , input "":U
     8071                   ).
     8072                       assign
     8073                           v-lines-counter = v-lines-counter   + 1
     8074                       .
     8075           end.
     8076           else do:
     8077               if v-tax-price <> 0
     8078               then do:
     8079                   message
     8080                     "Значение третьего налога (стеклопосуда) в документе отлично от нуля для товара " + goods.artic
     8081                     + ", хотя для этого товара система не позволяет задать третий налог. Возможны ошибки в накладной"
     8082                   view-as alert-box error.
     8083               end.
     8084           end.
     8085                   assign v-lines-counter = v-lines-counter + 1.
     8086               end.
     8087           end.
     8088       end.
     8089       assign
     8090           v-tot-sum-no-VAT    = v-tot-sum-no-VAT  + v-sum-no-VAT  + v-tax
     8091           v-tot-VAT           = v-tot-VAT         + v-VAT
     8092           v-tot-SLT           = v-tot-SLT         + v-SLT
     8093           v-tot-tax           = v-tot-tax         + v-tax
     8094           v-tot-sum           = v-tot-sum         + v-sum         + v-tax
     8095       .
     8096       if lookup ("corr" , p-mode) <> 0 then do :
     8097         if v-diff-sum-no-VAT > 0 then v-tot-sum-no-VAT1   = v-tot-sum-no-VAT1 + v-diff-sum-no-VAT.
     8098         if v-diff-sum-no-VAT < 0 then v-tot-sum-no-VAT2   = v-tot-sum-no-VAT2 + abs(v-diff-sum-no-VAT).
     8099         if v-diff-VAT        > 0 then v-tot-VAT1          = v-tot-VAT1        + v-diff-VAT.
     8100         if v-diff-VAT        < 0 then v-tot-VAT2          = v-tot-VAT2        + abs(v-diff-VAT).
     8101         if v-diff-sum        > 0 then v-tot-sum1          = v-tot-sum1        + v-diff-sum.
     8102         if v-diff-sum        < 0 then v-tot-sum2          = v-tot-sum2        + abs(v-diff-sum).
     8103         put stream Out-stream
     8104             v-single-line format "X(199)"
     8105         .
     8106       end.
     8107   end.
     8108   end procedure.
     8109   procedure print-header :
     8110   define input parameter p-doc-code           as character    no-undo.
     8111   define output parameter p-curr-abbr         as character    no-undo.
     8112       define variable v-print-doc      as character           no-undo.
     8113       define variable v-par-type       as character           no-undo.
     8114       define variable t-num            as character           no-undo.
     8115       define variable v-obj-prt-on     as logical             no-undo.
     8116       define variable t-inn            as character           no-undo.
     8117       define variable v-plat-rasch-doc as character    no-undo.
     8118       define variable v-curr-name      as character           no-undo.
     8119       define variable v-base-name      as character           no-undo.
     8120       define variable v-base-abbr      as character           no-undo.
     8121       define variable v-rubl-name      as character           no-undo.
     8122       define variable t-currency       as character           no-undo.
     8123       define variable v-suppNUM        as character           no-undo.
     8124       define variable v-ordNUM         as character           no-undo.
     8125       define variable v-attr-type      as character           no-undo.
     8126       define variable v-idContr        as character           no-undo.
     8127       define buffer buf_trn-doc       for ub.trn-doc.
     8128       define buffer buf_currency      for ub.currency.
     8129       define buffer buf_ext-classif   for ub.ext-classif.
     8130   do
     8131   for buf_trn-doc
     8132     , buf_currency
     8133   on error undo, return error
     8134   :
     8135       find first buf_trn-doc no-lock
     8136            where buf_trn-doc.doc-code = p-doc-code
     8137       .
     8138   define variable vss-include-info42 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8139   empty temp-table thbjattr_thbj-attr.
     8140   run adm/shattri.p (
     8141      input "get":U
     8142     ,input buf_trn-doc.obj-type
     8143     ,input buf_trn-doc.obj-code
     8144     ,input 'prt-firm':U
     8145     ,input  ""
     8146     ,output v-value-character
     8147     ,output v-value-date
     8148     ,output v-value-decimal
     8149     ,output v-value-integer
     8150     ,output v-value-logical
     8151     ,output par-type
     8152     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     8153     ) no-error .
     8154   for each thbjattr_thbj-attr :
     8155       if thbjattr_thbj-attr.prop-code = 'factur01' then v-print-doc =  string(thbjattr_thbj-attr.property-value-logical) .
     8156   end.
     8157       assign
     8158         p-sf-par = no
     8159       .
     8160       run torgconf-get-form-header in this-procedure (
     8161             input Invers
     8162           , input buf_trn-doc.doc-code
     8163           , input ( v-print-doc = "yes" )
     8164           , input buf_trn-doc.doc-date
     8165           , input buf_trn-doc.fact-date
     8166           , input buf_trn-doc.doc-type
     8167           , input buf_trn-doc.status_
     8168           , input p-reverse
     8169           , input p-sf-par
     8170       ).
     8171   define variable vss-include-info43 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8172   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     8173     (input  buf_trn-doc.obj-type
     8174     ,input  buf_trn-doc.obj-code
     8175     ,input  'doc-prt=request'
     8176     ,output v-obj-prt-on
     8177     )  .
     8178       if v-obj-prt-on = no
     8179       or invers
     8180       then do:
     8181           assign
     8182               PrintScale = no
     8183           .
     8184       end.
     8185       find first buf_currency no-lock
     8186            where buf_currency.curr-code = buf_trn-doc.exch-code
     8187       .
     8188       assign
     8189           p-curr-abbr = buf_currency.curr-abbr
     8190           v-curr-name = buf_currency.curr-name + ", код " + string(buf_currency.okv-code)
     8191       .
     8192       define variable v-base-code as integer   no-undo .
     8193   define variable vss-include-info44 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8194   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     8195     (input  v-cntxt-host-code-obj
     8196     ,output v-base-code
     8197     )  .
     8198       find first buf_currency no-lock
     8199            where buf_currency.curr-code = v-base-code
     8200       .
     8201       assign
     8202           v-base-name = buf_currency.curr-name  + ", код " + string(buf_currency.okv-code)
     8203           v-base-abbr = buf_currency.curr-abbr
     8204       .
     8205       find first buf_currency no-lock
     8206            where buf_currency.curr-code = 0
     8207       .
     8208       assign
     8209           v-rubl-name = buf_currency.curr-name  + ", код " + string(buf_currency.okv-code)
     8210       .
     8211       assign
     8212           t-num = substitute( "&1         от &2 &3"
     8213                           , v-torgconf-doc-code
     8214                           , v-torgconf-doc-date
     8215                           , ( if buf_trn-doc.status_ <> 'факт':U
     8216                               then string( "(" + caps( buf_trn-doc.status_ ) + ")" )
     8217                               else "":U )
     8218                   )
     8219       .
     8220       assign
     8221           t-inn = substitute( "&1&2&3", v-torgconf-supplier-inn, ( if ((v-torgconf-supplier-kpp = "":U) AND (v-torgconf-supplier-inn = "":U)) then "":U else "/":U ), v-torgconf-supplier-kpp )
     8222       .
     8223       if v-torgconf-outappr = yes
     8224       then do:
     8225         if lookup ("corr" , p-mode) <> 0 then do :
     8226           put stream Out-stream
     8227             space(90) "                                                                           Приложение № 2" skip
     8228             space(90) "                                                            к постановлению Правительства" skip
     8229             space(90) "                                                                     Российской Федерации" skip
     8230             space(90) "                                                                     от 26.12.2011 № 1137" skip
     8231             space(90) "                              (в ред. Постановления Правительства РФ от 19.08.2017 № 981)" skip
     8232           .
     8233         end.
     8234         else do :
     8235           put stream Out-stream
     8236             space(108) "                                                                           Приложение № 1" skip
     8237             space(108) "                                                            к постановлению Правительства" skip
     8238             space(108) "                                                                     Российской Федерации" skip
     8239             space(108) "                                                                     от 26.12.2011 № 1137" skip
     8240             space(108) "                              (в ред. Постановления Правительства РФ от 19.08.2017 № 981)" skip
     8241           .
     8242         end.
     8243       END.
     8244       if lookup ("corr" , p-mode) <> 0 then do :
     8245         put stream Out-stream
     8246             space(25) string( "КОРРЕКТИРОВОЧНЫЙ СЧЕТ-ФАКТУРА N" + ( if p-round = 'round':U then ":" else " " ) + t-num + ", ИСПРАВЛЕНИЕ") format "X(190)" skip
     8247             space(23) "КОРРЕКТИРОВОЧНОГО СЧЕТА-ФАКТУРЫ N ______ от  ______________   к СЧЕТУ-ФАКТУРЕ N _______"    skip
     8248             space(31) "от ___________, с учетом исправления N ______ от  ______________ "
     8249             skip(1) space(5) string( "Продавец" + ( if p-round = 'round':U then ":" else " " ) + fill( " ", 31 ) + v-torgconf-supplier-name + IF v-torgconf-supplier-engl-name = "":U THEN "":U ELSE SUBSTITUTE(" (&1)", v-torgconf-supplier-engl-name )) format "X(190)"
     8250             skip    space(5) string( "Адрес"    + ( if p-round = 'round':U then ":" else " " ) + fill( " ", 34 ) + v-torgconf-supplier-addr ) format "X(190)"
     8251             skip    space(5) string( "ИНН/КПП продавца" + ( if p-round = 'round':U then ":" else " " ) + t-inn ) format "X(190)"
     8252         .
     8253       end.
     8254       else do :
     8255       put stream Out-stream
     8256             space(25) string( "СЧЕТ-ФАКТУРА N" + ( if p-round = 'round':U then ":" else " " ) + t-num ) format "X(170)" "(1)" at 196 skip
     8257             space(23) 'ИСПРАВЛЕНИЕ N   -   от " - "     -    ' "(1а)" at 196
     8258             skip(1) space(5) string( "Продавец" + ( if p-round = 'round':U then ":" else " " ) + fill( " ", 31 ) + v-torgconf-supplier-name + IF v-torgconf-supplier-engl-name = "":U THEN "":U ELSE SUBSTITUTE(" (&1)", v-torgconf-supplier-engl-name )) format "X(190)" "(2)" at 196
     8259             skip    space(5) string( "Адрес"    + ( if p-round = 'round':U then ":" else " " ) + fill( " ", 34 ) + v-torgconf-supplier-addr ) format "X(190)" "(2а)" at 196
     8260             skip    space(5) string( "ИНН/КПП продавца" + fill( " ", 23 ) + ( if p-round = 'round':U then ":" else " " ) + t-inn ) format "X(190)" "(2б)" at 196
     8261           .
     8262       end.
     8263      if LOOKUP( "serv", p-mode ) <> 0 then v-out-name = '---------------------'  .
     8264      else if
     8265      buf_trn-doc.doc-type <> 'при':U
     8266      and ( not invers )
     8267      and buf_trn-doc.office = no
     8268      and v-torgconf-outobj = no
     8269      and v-torgconf-outasend = no
     8270      and v-torgconf-outsend = no
     8271      and LOOKUP( "TopAukc", p-mode ) = 0
     8272      then v-out-name = "Он же".
     8273      else
     8274      v-out-name =  if buf_trn-doc.office = yes
     8275                                 then "---"
     8276                                 else v-torgconf-cargo-from-name
     8277                                       + "  "
     8278                                       + ( if invers
     8279                                          or ( v-torgconf-outobj = no
     8280                                             and ( not invers )
     8281                                             and ( buf_trn-doc.doc-type <> 'при':U ) )
     8282                                          then v-torgconf-cargo-from-addres
     8283                                          else '':U ) .
     8284      v-out-name =  v-torgconf-cargo-from-sf-value.
     8285      run facturxl-write-cell-data in this-procedure (
     8286           input "h_cargoFrom":U
     8287         , input v-out-name
     8288      ).
     8289    if lookup ("corr" , p-mode) = 0 then do :
     8290      if LENGTH(v-out-name) > 145
     8291         then do:
     8292            put stream Out-stream
     8293               skip    space(5) string( "Грузоотправитель и его адрес"
     8294                                    + ( if p-round = 'round':U then ":" else " " )
     8295                                    + fill( " ", 11 )
     8296                                    + ( if buf_trn-doc.office = yes
     8297                                          then "---"
     8298                                          else SUBSTRING(v-out-name,1,145))) format "X(190)"
     8299               skip    space(45) SUBSTRING(v-out-name,146) format "X(145)" "(3)" at 196 skip
     8300            .
     8301         end.
     8302         else do:
     8303            put stream Out-stream
     8304               skip    space(5) string( "Грузоотправитель и его адрес"
     8305                                       + ( if p-round = 'round':U then ":" else " " )
     8306                                       + fill( " ", 11 )
     8307                                       + ( if buf_trn-doc.office = yes
     8308                                             then "---"
     8309                                             else v-out-name)) format "X(190)" "(3)" at 196 skip
     8310            .
     8311         end.
     8312     end.
     8313   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input p-doc-code ,
     8314                           input 'idCountryContr':U ,
     8315                          output v-idContr ,
     8316                          output v-attr-type ) no-error .
     8317       run facturxl-write-cell-data in this-procedure (
     8318             input "h_docCode":U
     8319           , input v-torgconf-doc-code
     8320       ).
     8321       run facturxl-write-cell-data in this-procedure (
     8322             input "h_docDate":U
     8323           , input v-torgconf-doc-date
     8324       ).
     8325       run facturxl-write-cell-data in this-procedure (
     8326             input "h_supplier":U
     8327           , input v-torgconf-supplier-name + IF v-torgconf-supplier-engl-name = "":U THEN "":U ELSE SUBSTITUTE(" (&1)", v-torgconf-supplier-engl-name )
     8328       ).
     8329       run facturxl-write-cell-data in this-procedure (
     8330             input "h_supplierAddr":U
     8331           , input v-torgconf-supplier-addr
     8332       ).
     8333       run facturxl-write-cell-data in this-procedure (
     8334             input "h_supplierINN":U
     8335           , input t-inn
     8336       ).
     8337       run facturxl-write-cell-data in this-procedure (
     8338             input "h_idContract":U
     8339           , input v-idContr
     8340       ).
     8341       assign
     8342           t-inn = substitute( "&1&2&3", v-torgconf-saler-inn, ( if v-torgconf-saler-kpp = "":U then "":U else "/":U ), v-torgconf-saler-kpp )
     8343       .
     8344       if lookup( "GreenL", p-mode ) <> 0
     8345       then do:
     8346           assign
     8347               v-plat-rasch-doc    = "":U
     8348           .
     8349       end.
     8350       else do:
     8351           assign
     8352               v-plat-rasch-doc    = " N ":U + ( if p-round = 'round':U then ": ":U else " ":U ) + fill( " ", 6 ) + v-torgconf-plat-rasch-doc
     8353           .
     8354       end.
     8355            if LOOKUP( "serv", p-mode ) <> 0 then v-out-name = '---------------------'  .
     8356            else if     buf_trn-doc.doc-type <> 'при':U
     8357               and buf_trn-doc.doc-type <> 'возврат':U
     8358            then v-out-name =  v-torgconf-consignee.
     8359            else v-out-name =  v-torgconf-cargo-to-value .
     8360            run facturxl-write-cell-data in this-procedure (
     8361                  input "h_cargoTo":U
     8362                , input v-out-name
     8363            ).
     8364     if lookup ("corr" , p-mode) = 0 then do :
     8365           if LENGTH(v-out-name) > 145
     8366            then do:
     8367               put stream Out-stream
     8368                  space(5) string( "Грузополучатель и его адрес" + ( if p-round = 'round':U then ": " else " " ) + fill( " ", 12 ) + SUBSTRING(v-out-name,1,145))   format "X(190)"
     8369                  skip space(45) SUBSTRING(v-out-name, 146) format "X(145)" "(4)" at 196
     8370               .
     8371            end.
     8372            else do:
     8373               put stream Out-stream
     8374                  space(5) string( "Грузополучатель и его адрес" + ( if p-round = 'round':U then ": " else " " ) + fill( " ", 12 ) + v-out-name)   format "X(190)" "(4)" at 196
     8375               .
     8376            end.
     8377           put stream Out-stream
     8378           skip    space(5) string( "К платежно-расчетному документу" + v-plat-rasch-doc ) format "X(190)" "(5)" at 196
     8379           skip    space(5) string( "Покупатель" + ( if p-round = 'round':U then ":" else " " ) + fill( " ", 29 ) + v-torgconf-saler-name +
     8380                                                   if v-torgconf-outprncd = yes
     8381                                                   then substitute( " (&1)", v-torgconf-saler-code )
     8382                                                   else "":U  ) format "X(190)" "(6)" at 196
     8383           skip    space(5) string( "Адрес" + ( if p-round = 'round':U then ":" else " " ) + fill( " ", 34 ) + v-torgconf-saler-addr ) format "X(190)" "(6а)" at 196
     8384           skip    space(5) string( "ИНН/КПП покупателя" + fill( " ", 21 ) + ( if p-round = 'round':U then ": " else " " ) + t-inn ) format "X(190)" "(6б)" at 196
     8385           skip
     8386       .
     8387       run facturxl-write-cell-data in this-procedure (
     8388             input "h_platDoc":U
     8389           , input v-torgconf-plat-rasch-doc
     8390       ).
     8391     end.
     8392     else do :
     8393       put stream Out-stream
     8394           skip    space(5) string( "Покупатель" + ( if p-round = 'round':U then ":" else " " ) + fill( " ", 29 ) + v-torgconf-saler-name +
     8395                                                   if v-torgconf-outprncd = yes
     8396                                                   then substitute( " (&1)", v-torgconf-saler-code )
     8397                                                   else "":U  ) format "X(190)"
     8398           skip    space(5) string( "Адрес" + ( if p-round = 'round':U then ":" else " " ) + fill( " ", 34 ) + v-torgconf-saler-addr ) format "X(190)"
     8399           skip    space(5) string( "Идентификационный номер покупателя (ИНН/КПП)" + ( if p-round = 'round':U then ": " else " " ) + t-inn ) format "X(190)"
     8400           skip
     8401       .
     8402     end.
     8403       run facturxl-write-cell-data in this-procedure (
     8404             input "h_saler":U
     8405           , input v-torgconf-saler-name + if v-torgconf-outprncd = yes
     8406                                           then substitute( " (&1)", v-torgconf-saler-code )
     8407                                           else "":U
     8408       ).
     8409       run facturxl-write-cell-data in this-procedure (
     8410             input "h_salerAddr":U
     8411           , input v-torgconf-saler-addr
     8412       ).
     8413       run facturxl-write-cell-data in this-procedure (
     8414             input "h_salerINN":U
     8415           , input t-inn
     8416       ).
     8417       assign
     8418           t-currency = ( trim( ( if invers and buf_trn-doc.doc-type <> 'при':U then v-curr-name else ( if PrintRubl then v-rubl-name else v-base-name  ) ) ) )
     8419       .
     8420       run facturxl-write-cell-data in this-procedure (
     8421             input "h_currency":U
     8422           , input t-currency
     8423       ).
     8424       if buf_trn-doc.ext-doc-type = 'ep':U
     8425       then do:
     8426           put stream Out-stream
     8427               space(10) "Возврат товара поставщику." format "X(120)" skip
     8428           .
     8429       end.
     8430       if v-torgconf-outrubl = no
     8431       then do:
     8432           put stream Out-stream
     8433           space(5)
     8434               string( "Валюта:  " +
     8435               trim( ( if invers and buf_trn-doc.doc-type <> 'при':U then v-curr-name else ( if PrintRubl then v-rubl-name else v-base-name  ) ) ) ) format "X(120)" "(7)" at 196 skip(0)
     8436           .
     8437       end.
     8438       put stream Out-stream
     8439           space(5)
     8440           "Идентификатор государственного контракта, договора (соглашения) (при наличии):  "
     8441            + trim(v-idContr) format "X(120)" "(8)" at 196 skip(0)
     8442       .
     8443       if lookup("TopAukc", p-mode) <> 0 then do :
     8444         find first buf_ext-classif where buf_ext-classif.classif-subject  = 'clients':U                    and
     8445                                          buf_ext-classif.classif-name     = 'code_firm_ext':U and
     8446                                          buf_ext-classif.Key#_One         = buf_trn-doc.host-code               and
     8447                                          buf_ext-classif.CharKey_One      = ''                                  and
     8448                                          buf_ext-classif.Key#_Two         = buf_trn-doc.cli-code                and
     8449                                          buf_ext-classif.CharKey_Two      = buf_trn-doc.cli-type                and
     8450                                          buf_ext-classif.db-num           = -1                                  and
     8451                                          buf_ext-classif.nonunique        = ((if buf_trn-doc.cli-type = 'орг':U then 1000000000 else 0) + buf_trn-doc.cli-code)
     8452                                           no-lock no-error.
     8453         v-suppNUM = (if available buf_ext-classif then buf_ext-classif.CharKey_Three else '').
     8454   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input p-doc-code ,
     8455                           input 'zakaz-number':U ,
     8456                          output v-ordNUM ,
     8457                          output v-attr-type ) no-error .
     8458         run facturxl-write-cell-data in this-procedure (
     8459               input "h_suppNUM":U
     8460             , input v-suppNUM
     8461         ).
     8462         run facturxl-write-cell-data in this-procedure (
     8463               input "h_ordNUM":U
     8464             , input v-ordNUM
     8465         ).
     8466         put stream Out-stream
     8467             skip space(5) string( "№ поставщика     " + v-suppNUM + "     № заказа     " + v-ordNUM ) format "X(120)"
     8468         .
     8469       end.
     8470       if v-torgconf-outprim = no
     8471       then do:
     8472           put stream Out-stream
     8473               skip space(10)
     8474               ( if not( buf_trn-doc.PS begins "@" )
     8475               then string( "Примечание : " + substr( buf_trn-doc.PS, 1, 120 ) )
     8476               else ""
     8477               ) format "X(120)"
     8478           .
     8479       end.
     8480   end.
     8481   end procedure.
     8482   procedure print-footer :
     8483   define variable v-base-code as integer     no-undo .
     8484   define variable v-base-abbr as character   no-undo .
     8485   define variable xx as integer no-undo.
     8486   define variable yy as integer no-undo.
     8487   define variable zz as integer no-undo.
     8488   define buffer buf_currency      for ub.currency.
     8489   do
     8490   on error undo, return error
     8491   :
     8492     if lookup ( "corr" , p-mode ) <> 0 then do :
     8493       if line-counter( Out-stream ) + 8 > page-size( Out-stream )
     8494       then do:
     8495           page stream Out-stream.
     8496       end.
     8497     end.
     8498     else do :
     8499       put stream Out-stream
     8500           v-single-line format "X(199)"
     8501       .
     8502       if line-counter( Out-stream ) + 9 > page-size( Out-stream )
     8503       then do:
     8504           page stream Out-stream.
     8505       end.
     8506     end.
     8507       if lookup ("corr" , p-mode) <> 0 then do :
     8508         run facturxl-write-cell-data in this-procedure (
     8509               input "it_sumNoVAT1":U
     8510             , input string( v-tot-sum-no-VAT1 )
     8511         ).
     8512         run facturxl-write-cell-data in this-procedure (
     8513               input "it_VAT1":U
     8514             , input string( v-tot-VAT1 )
     8515         ).
     8516         run facturxl-write-cell-data in this-procedure (
     8517               input "it_sum1":U
     8518             , input string( v-tot-sum1 )
     8519         ).
     8520         run facturxl-write-cell-data in this-procedure (
     8521               input "it_sumNoVAT2":U
     8522             , input string( v-tot-sum-no-VAT2 )
     8523         ).
     8524         run facturxl-write-cell-data in this-procedure (
     8525               input "it_VAT2":U
     8526             , input string( v-tot-VAT2 )
     8527         ).
     8528         run facturxl-write-cell-data in this-procedure (
     8529               input "it_sum2":U
     8530             , input string( v-tot-sum2 )
     8531         ).
     8532       end.
     8533       else do :
     8534       run facturxl-write-cell-data in this-procedure (
     8535             input "it_SumNoVAT":U
     8536           , input string( v-tot-sum-no-VAT )
     8537       ).
     8538       run facturxl-write-cell-data in this-procedure (
     8539             input "it_VATsum":U
     8540           , input string( v-tot-VAT )
     8541       ).
     8542       run facturxl-write-cell-data in this-procedure (
     8543             input "it_sum":U
     8544           , input string( v-tot-sum )
     8545       ).
     8546     end.
     8547   define variable vss-include-info45 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8548   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     8549     (input  v-cntxt-host-code-obj
     8550     ,output v-base-code
     8551     )  .
     8552       find first buf_currency no-lock
     8553            where buf_currency.curr-code = v-base-code
     8554       .
     8555       assign
     8556           v-base-abbr = buf_currency.curr-abbr
     8557       .
     8558     if lookup ( "corr" , p-mode ) <> 0 then do :
     8559       display stream Out-stream
     8560           sym1 "                     Всего увеличение (сумма строк В)"  @ goods.gds-name
     8561           sym7 v-tot-sum-no-VAT1    @ v-sum-no-VAT
     8562           sym8
     8563           sym9
     8564           sym10 v-tot-VAT1          @ v-VAT
     8565           sym11 v-tot-sum1          @ v-sum
     8566           sym12
     8567       with frame corr-factur .
     8568       down stream Out-stream 1 with frame corr-factur .
     8569       put stream Out-stream
     8570           v-single-line format "X(199)"
     8571       .
     8572       display stream Out-stream
     8573           sym1 "                     Всего уменьшение (сумма строк Г)"  @ goods.gds-name
     8574           sym7 v-tot-sum-no-VAT2    @ v-sum-no-VAT
     8575           sym8
     8576           sym9
     8577           sym10 v-tot-VAT2          @ v-VAT
     8578           sym11 v-tot-sum2          @ v-sum
     8579           sym12
     8580       with frame corr-factur .
     8581       down stream Out-stream 1 with frame corr-factur .
     8582       put stream Out-stream
     8583           v-single-line format "X(199)"
     8584       .
     8585     end.
     8586     else do :
     8587       if abs( v-tot-SLT ) >= 0.005
     8588       or ( not invers and abs( buf_trn-doc.discnt-rubl ) >= 0.005 )
     8589       then do:
     8590           yy = 158 - length(trim(string(v-tot-sum,"->>>>>>>>>>9.99"))).
     8591           put stream Out-stream
     8592               skip ":Итого по документу" ":" at 44
     8593               trim( string( v-tot-sum, "->>>>>>>>>>9.99" ) ) + ":" at yy
     8594           .
     8595           if v-tot-SLT <> 0 and p-no-slt = false
     8596           then do:
     8597               yy = 158 - length(trim(string(v-tot-SLT,"->>>>>>>>>>9.99"))).
     8598               put stream Out-stream
     8599                   skip ":Налог с продаж" ":" at 44
     8600                           trim( string( v-tot-SLT, "->>>>>>>>>>9.99" ) )  + ":" at yy
     8601               .
     8602           end.
     8603           if buf_trn-doc.discnt-rubl <> 0
     8604           and not invers
     8605           and v-torgconf-outdisc = no
     8606           then do:
     8607               yy = 158 - length(trim(string(if PrintRubl
     8608                                           then buf_trn-doc.discnt-rubl
     8609                                           else buf_trn-doc.tot-calc,"->>>>>>>>>>9.99"))).
     8610               put stream Out-stream
     8611                   skip ":Скидка" ":" at 44
     8612                           trim( string( ( if PrintRubl
     8613                                           then buf_trn-doc.discnt-rubl
     8614                                           else buf_trn-doc.tot-calc ), "->>>>>>>>>>9.99" ) ) + ":" at yy
     8615               .
     8616           end.
     8617       end.
     8618       if v-tot-tax <> 0
     8619       then do:
     8620           yy = 158 - length(trim(string(v-tot-tax,"->>>>>>>>>>9.99"))).
     8621           put stream Out-stream
     8622               skip ":" + v-tax-name  format "X(20)" ":" at 44
     8623                   trim( string( v-tot-tax, "->>>>>>>>>>9.99" ) ) + ":" at yy
     8624           .
     8625       end.
     8626       xx = 142 - length(trim(string(v-tot-VAT,"->>>>>>>9.99"))).
     8627       yy = 158 - length(trim(string(v-tot-sum + v-tot-SLT,"->>>>>>>>>>9.99"))).
     8628       zz = 111 - length(trim(string(v-tot-sum-no-VAT,"->>>>>>>>>>>>9.99"))).
     8629       if PrintRubl
     8630       and v-torgconf-outprops = yes
     8631       then do:
     8632           run rep/wp-rub.p (
     8633               input v-tot-sum + v-tot-SLT
     8634               , output v-propis
     8635               , output v-propis-cop
     8636           ).
     8637       put stream Out-stream
     8638             skip ":Всего к оплате"
     8639                             v-propis format "X(75)" at 46 ":" at 121
     8640                             string( trim( string(v-tot-VAT, "->>>>>>>9.99") ) + ":" ) format "X(13)" at xx
     8641                             string( trim( string( v-tot-sum + v-tot-SLT, "->>>>>>>>>>9.99" ) ) + ":" ) format "X(16)" at yy
     8642             skip fill("-",158) format "x(158)"
     8643      .
     8644       end.
     8645       else do:
     8646         put stream Out-stream
     8647             skip ":Всего к оплате"  ":" at 93
     8648                             string( trim( string( v-tot-sum-no-VAT, "->>>>>>>>>>>>9.99" ) ) + ":" ) format "X(18)" at zz
     8649                             string( trim( string(v-tot-VAT, "->>>>>>>9.99") ) + ":" ) format "X(13)" at xx
     8650                             string( trim( string( v-tot-sum + v-tot-SLT, "->>>>>>>>>>9.99" ) ) + ":" ) format "X(16)" at yy
     8651             skip fill("-",158) format "x(158)"
     8652           .
     8653       end.
     8654     end.
     8655       if PrintRubl
     8656       and v-torgconf-outprops = yes
     8657       and lookup ("corr" , p-mode) = 0
     8658       then do:
     8659           run rep/wp-rub.p (
     8660               input v-tot-sum + v-tot-SLT
     8661               , output v-propis
     8662               , output v-propis-cop
     8663           ).
     8664           run facturxl-write-cell-data in this-procedure (
     8665                 input "h_summ_prop":U
     8666               , input v-propis
     8667           ).
     8668       end.
     8669       if v-torgconf-outsubs = no
     8670       then do:
     8671           run facturxl-write-cell-data in this-procedure (
     8672                 input "f_bossName":U
     8673               , input v-torgconf-main-boss
     8674           ).
     8675           run facturxl-write-cell-data in this-procedure (
     8676                 input "f_buhName":U
     8677               , input v-torgconf-main-buh
     8678           ).
     8679       end.
     8680       if v-torgconf-outsubs = no
     8681       and trim(v-torgconf-main-boss) = "":U
     8682       or v-torgconf-outsubs = yes
     8683         then do:
     8684               v-torgconf-main-boss = fill( "_", 36 ).
     8685         end.
     8686       if v-torgconf-outsubs = no
     8687       and trim(v-torgconf-main-buh) = "":U
     8688       or v-torgconf-outsubs = yes
     8689         then do:
     8690            v-torgconf-main-buh = fill( "_", 36 ).
     8691         end.
     8692           put stream Out-stream
     8693               skip(0) space(4) "Руководитель организации" format "X(25)" space(74)
     8694               "Главный бухгалтер" format "X(25)" skip
     8695               space(4) "или иное уполномоченное лицо " format "X(31)" fill( "_", 26 ) format "X(26)" "    /" v-torgconf-main-boss format "X(31)" "/" space(5)
     8696               "или иное уполномоченное лицо " format "X(31)" fill( "_", 26 ) format "X(26)" "    /" v-torgconf-main-buh format "X(31)" "/"
     8697               skip space(43) "(подпись)" space(27) "(Ф.И.О)"  space(55) "(подпись)" space(27) "(Ф.И.О)"
     8698           .
     8699       if v-torgconf-outegrp = no
     8700       then do :
     8701         if trim(v-torgconf-self-host-name) = "":U
     8702         then do:
     8703             v-torgconf-self-host-name = fill("_", 42).
     8704         end.
     8705         if v-torgconf-self-host-egrip-date <> "":U
     8706          or v-torgconf-self-host-egrip-num  <> "":U
     8707          then do:
     8708             put stream Out-stream
     8709                 skip (1) space(10)             "Индивидуальный предприниматель"
     8710                 skip (0) space(10) substitute( "или иное уполномоченное лицо     &1  / &2 / ЕГРИП N &3 от &4 ", fill( "_", 26 ) , string(v-torgconf-self-host-name, "x(42)") , v-torgconf-self-host-egrip-num, v-torgconf-self-host-egrip-date ) format "X(174)"
     8711                 skip     space(51) "(подпись)"  space(29) "(Ф.И.О)" space(22) "(реквизиты свидетельства о государственной"
     8712                 skip     space(119) substitute( "регистрации индивидуального предпринимателя)" ) format "X(60)"
     8713                 skip
     8714             .
     8715             run facturxl-write-cell-data in this-procedure (
     8716                   input "f_ownerName":U
     8717                 , input v-torgconf-self-host-name
     8718             ).
     8719             run facturxl-write-cell-data in this-procedure (
     8720                 input "f_ownerReg":U
     8721               , input substitute ("N &1 от &2 ", v-torgconf-self-host-egrip-num, v-torgconf-self-host-egrip-date )
     8722             ).
     8723         end.
     8724         else do :
     8725             put stream Out-stream
     8726                 skip (1) space(10)             "Индивидуальный предприниматель"
     8727                 skip (0) space(10) substitute( "или иное уполномоченное лицо     &1  / &2 /  &3  ", fill( "_", 26 ) , fill("_", 42) , fill( "_", 50 ) ) format "X(174)"
     8728                 skip     space(51) "(подпись)"  space(29) "(Ф.И.О)" space(22) "(реквизиты свидетельства о государственной"
     8729                 skip     space(119) substitute( "регистрации индивидуального предпринимателя)" ) format "X(60)"
     8730                 skip
     8731             .
     8732         end.
     8733       end.
     8734   end.
     8735   end procedure.
