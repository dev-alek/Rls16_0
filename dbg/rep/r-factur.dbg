     1072     ,input p-obj-type
     1073     ,input p-obj-code
     1074     ,input 'prt-obj':U
     1075     ,input  ""
     1076     ,output v-value-character
     1077     ,output v-value-date
     1078     ,output v-value-decimal
     1079     ,output v-value-integer
     1080     ,output v-value-logical
     1081     ,output par-type
     1082     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1083     ) no-error .
     1084   for each thbjattr_thbj-attr :
     1085       if thbjattr_thbj-attr.prop-code = 'outdate':U  then v-outdate  =  thbjattr_thbj-attr.property-value-character .
     1086       if thbjattr_thbj-attr.prop-code = 'outares':U  then v-outares  =  thbjattr_thbj-attr.property-value-character .
     1087       if thbjattr_thbj-attr.prop-code = 'outnum':U   then v-outnum   =  thbjattr_thbj-attr.property-value-character .
     1088       if thbjattr_thbj-attr.prop-code = 'outprim':U  then v-outprim  =  thbjattr_thbj-attr.property-value-character .
     1089       if thbjattr_thbj-attr.prop-code = 'outdisc':U  then v-outdisc  =  thbjattr_thbj-attr.property-value-character .
     1090       if thbjattr_thbj-attr.prop-code = 'outsubs':U  then v-outsubs  =  thbjattr_thbj-attr.property-value-character .
     1091       if thbjattr_thbj-attr.prop-code = 'outegrp':U  then v-outegrp  =  thbjattr_thbj-attr.property-value-character .
     1092       if thbjattr_thbj-attr.prop-code = 'outt12':U   then v-outt12   =  thbjattr_thbj-attr.property-value-character .
     1093       if thbjattr_thbj-attr.prop-code = 'outappr':U  then v-outappr  =  thbjattr_thbj-attr.property-value-character .
     1094       if thbjattr_thbj-attr.prop-code = 'outrubl':U  then v-outrubl  =  thbjattr_thbj-attr.property-value-character .
     1095       if thbjattr_thbj-attr.prop-code = 'outhold':U  then v-outhold  =  thbjattr_thbj-attr.property-value-character .
     1096       if thbjattr_thbj-attr.prop-code = 'outobj':U   then v-outobj   =  thbjattr_thbj-attr.property-value-character .
     1097       if thbjattr_thbj-attr.prop-code = 'outsend':U  then v-outsend  =  thbjattr_thbj-attr.property-value-character .
     1098       if thbjattr_thbj-attr.prop-code = 'outasend':U then v-outasend =  thbjattr_thbj-attr.property-value-character .
     1099       if thbjattr_thbj-attr.prop-code = 'outogr':U   then v-torgconf-outogr   =  thbjattr_thbj-attr.property-value-character .
     1100       if thbjattr_thbj-attr.prop-code = 'outR':U     then v-torgconf-outR     =  thbjattr_thbj-attr.property-value-character .
     1101       if thbjattr_thbj-attr.prop-code = 'outB':U     then v-torgconf-outB     =  thbjattr_thbj-attr.property-value-character .
     1102       if thbjattr_thbj-attr.prop-code = 'outssdoc':U then v-torgconf-outssdoc =  thbjattr_thbj-attr.property-value-character .
     1103       if thbjattr_thbj-attr.prop-code = 'outC':U     then v-torgconf-outC     =  thbjattr_thbj-attr.property-value-character .
     1104   end.
     1105       run gbl/conf-rd.p ("outexpas", "":U, "":U, 0, "":U, "":U, "":U, no, output v-torgconf-outexpas, output v-par-type) no-error.
     1106       if error-status :error
     1107       then do:
     1108           assign
     1109               v-torgconf-outexpas = "":U
     1110           .
     1111       end.
     1112       assign
     1113           v-torgconf-outprncd = ( v-outprncd = "yes":U )
     1114       .
     1115       if p-form-name <> ""
     1116       and p-form-name <> ?
     1117       then do:
     1118           run gbl/conf-rd.p ("outexlst" , p-host-code, p-obj-type, p-obj-code, "", "", "", no, output v-outexlst , output v-par-type) no-error.
     1119           if error-status :error
     1120           then do:
     1121               assign
     1122                   v-outexlst           = ""
     1123               .
     1124           end.
     1125           if lookup( p-form-name, v-outdate ) <> 0
     1126           then do:
     1127               assign
     1128                   v-torgconf-outdate  = yes
     1129               .
     1130           end.
     1131           if lookup( p-form-name, v-outares ) <> 0
     1132           then do:
     1133               assign
     1134                   v-torgconf-outares  = yes
     1135               .
     1136           end.
     1137           if lookup( p-form-name, v-outnum  ) <> 0
     1138           then do:
     1139               assign
     1140                   v-torgconf-outnum   = yes
     1141               .
     1142           end.
     1143           if lookup( p-form-name, v-outprim ) <> 0
     1144           then do:
     1145               assign
     1146                   v-torgconf-outprim  = yes
     1147               .
     1148           end.
     1149           if lookup( p-form-name, v-outdisc ) <> 0
     1150           then do:
     1151               assign
     1152                   v-torgconf-outdisc  = yes
     1153               .
     1154           end.
     1155           if lookup( p-form-name, v-outsubs ) <> 0
     1156           then do:
     1157               assign
     1158                   v-torgconf-outsubs  = yes
     1159               .
     1160           end.
     1161           if lookup( p-form-name, v-outrecv ) <> 0
     1162           then do:
     1163               assign
     1164                   v-torgconf-outrecv  = yes
     1165               .
     1166           end.
     1167           if lookup( p-form-name, v-outegrp ) <> 0
     1168           then do:
     1169               assign
     1170                   v-torgconf-outegrp  = yes
     1171               .
     1172           end.
     1173           if lookup( p-form-name, v-outt12  ) <> 0
     1174           then do:
     1175               assign
     1176                   v-torgconf-outt12   = yes
     1177               .
     1178           end.
     1179           if lookup( p-form-name, v-outappr  ) <> 0
     1180           then do:
     1181               assign
     1182                   v-torgconf-outappr   = yes
     1183               .
     1184           end.
     1185           if lookup( p-form-name, v-outrubl  ) <> 0
     1186           then do:
     1187               assign
     1188                   v-torgconf-outrubl   = yes
     1189               .
     1190           end.
     1191           if lookup( p-form-name, v-outhold  ) <> 0
     1192           then do:
     1193               assign
     1194                   v-torgconf-outhold   = yes
     1195               .
     1196           end.
     1197           if lookup( p-form-name, v-outobj   ) <> 0
     1198           then do:
     1199               assign
     1200                   v-torgconf-outobj    = yes
     1201               .
     1202           end.
     1203           if lookup( p-form-name, v-outsend   ) <> 0
     1204           then do:
     1205               assign
     1206                   v-torgconf-outsend    = yes
     1207               .
     1208           end.
     1209           if lookup( p-form-name, v-outasend   ) <> 0
     1210           then do:
     1211               assign
     1212                   v-torgconf-outasend    = yes
     1213               .
     1214           end.
     1215           if lookup( p-form-name, v-outprops   ) <> 0
     1216           then do:
     1217               assign
     1218                   v-torgconf-outprops    = yes
     1219               .
     1220           end.
     1221           if lookup( p-form-name, v-outexlst ) <> 0
     1222           then do:
     1223               assign
     1224                   v-torgconf-outexlst  = yes
     1225               .
     1226           end.
     1227        assign
     1228         v-name = p-form-name.
     1229   end.
     1230   end.
     1231   end procedure.
     1232   procedure torgconf-get-self-param :
     1233   define input parameter p-obj-type           as character        no-undo.
     1234   define input parameter p-obj-code           as integer          no-undo.
     1235   define input parameter p-curr-code          as integer          no-undo.
     1236       define variable v-host-code    as integer      no-undo.
     1237       define variable v-par-type     as character    no-undo.
     1238   do
     1239   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message(1))
     1240   :
     1241   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1242   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1243     (input  p-obj-type
     1244     ,input  p-obj-code
     1245     ,output v-host-code
     1246     )  .
     1247       if v-torgconf-outhold = yes
     1248       then do:
     1249           run torgconf-get-holdfirm-code in this-procedure (
     1250                 input p-obj-type
     1251               , input p-obj-code
     1252               , output v-torgconf-self-host-code
     1253           ).
     1254           if v-torgconf-self-host-code = 0
     1255           then do:
     1256               return error.
     1257           end.
     1258       end.
     1259       else do:
     1260           assign
     1261               v-torgconf-self-host-code = v-host-code
     1262           .
     1263       end.
     1264       if v-torgconf-self-host-code = 0
     1265       then do:
     1266           assign
     1267               v-torgconf-self-host-name           = "":U
     1268               v-torgconf-self-host-addres         = "":U
     1269               v-torgconf-self-host-post-addres    = "":U
     1270               v-torgconf-self-host-phone          = "":U
     1271               v-torgconf-self-host-inn            = "":U
     1272               v-torgconf-self-host-kpp            = "":U
     1273               v-torgconf-self-host-okpo           = "":U
     1274               v-torgconf-self-host-egrip-date     = "":U
     1275               v-torgconf-self-host-egrip-num      = "":U
     1276           .
     1277       end.
     1278       else do:
     1279           run fmtcli-get-client in this-procedure (
     1280                 input 'орг':U
     1281               , input v-torgconf-self-host-code
     1282           ).
     1283           assign
     1284               v-torgconf-self-host-name        = v-fmtcli-name
     1285               v-torgconf-self-host-engl-name   = v-fmtcli-engl-name
     1286               v-torgconf-self-host-addres      = v-fmtcli-full-addres
     1287               v-torgconf-self-host-post-addres = v-fmtcli-post-addres
