     1025   end procedure.
     1026   procedure uf-get :
     1027     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     1028     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     1029     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     1030     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     1031     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     1032     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     1033     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     1034     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     1035     do
     1036     on error undo, return error
     1037     :
     1038       define buffer buf_usr-flt for ubflt.usr-flt .
     1039       define variable v-use-List_     as logical   no-undo .
     1040       define variable v-type-List_     as character no-undo .
     1041       define variable v-format-List_   as character no-undo .
     1042       define variable v-use-Naim      as logical   no-undo .
     1043       define variable v-type-Naim      as character no-undo .
     1044       define variable v-format-Naim    as character no-undo .
     1045       define variable v-use-print-graft as logical   no-undo .
     1046       define variable v-use-sort-gr     as logical   no-undo .
     1047       define variable v-use-type-price  as logical   no-undo .
     1048       define variable v-use-type-val    as logical   no-undo .
     1049       define variable v-label          as character no-undo .
     1050       define variable v-tooltip        as character no-undo .
     1051       define variable v-user-can-edit  as logical   no-undo .
     1052       define variable v-output-display as logical   no-undo .
     1053       define variable v-other          as character no-undo .
     1054       run uf-name in this-procedure
     1055          (input  entry(1, p-code, chr(4))
     1056         ,output v-use-List_
     1057         ,output v-type-List_
     1058         ,output v-format-List_
     1059         ,output v-use-Naim
     1060         ,output v-type-Naim
     1061         ,output v-format-Naim
     1062         ,output v-use-print-graft
     1063         ,output v-use-sort-gr
     1064         ,output v-use-type-price
     1065         ,output v-use-type-val
     1066         ,output v-label
     1067         ,output v-tooltip
     1068         ,output v-user-can-edit
     1069         ,output v-output-display
     1070         ,output v-other
     1071         ) no-error .
     1072       if error-status :error then do:
     1073         undo, return error return-value .
     1074       end.
     1075       find first buf_usr-flt no-lock where
     1076                  buf_usr-flt.Call-point     = p-code AND
     1077                  buf_usr-flt.user-name       = p-user-name
     1078         no-error .
     1079       if avail buf_usr-flt then do:
     1080         assign
     1081         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
     1082         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
     1083         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
     1084         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
     1085         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
     1086         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
     1087         .
     1088       end.
     1089       else do:
     1090         assign
     1091         p-List_        = (if v-use-List_       then "":U                    else ?)
     1092         p-Naim         = (if v-use-Naim        then "":U                    else ?)
     1093         p-print-graft  = (if v-use-print-graft then no                      else ?)
     1094         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
     1095         p-type-price   = (if v-use-type-price  then no                      else ?)
     1096         p-type-val     = (if v-use-List_       then no                      else ?)
     1097         .
     1098       end.
     1099     end.
     1100   end procedure.
     1101   procedure uf-set :
     1102     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     1103     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     1104     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     1105     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     1106     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     1107     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     1108     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     1109     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     1110     do
     1111     on error undo, return error
     1112     :
     1113       define buffer buf_usr-flt for ubflt.usr-flt .
     1114       define variable v-use-List_     as logical   no-undo .
     1115       define variable v-type-List_     as character no-undo .
     1116       define variable v-format-List_   as character no-undo .
     1117       define variable v-use-Naim      as logical   no-undo .
     1118       define variable v-type-Naim      as character no-undo .
     1119       define variable v-format-Naim    as character no-undo .
     1120       define variable v-use-print-graft as logical   no-undo .
     1121       define variable v-use-sort-gr   as logical   no-undo .
     1122       define variable v-use-type-price as logical   no-undo .
     1123       define variable v-use-type-val  as logical   no-undo .
     1124       define variable v-tooltip        as character no-undo .
     1125       define variable v-label          as character no-undo .
     1126       define variable v-user-can-edit  as logical   no-undo .
     1127       define variable v-output-display as logical   no-undo .
     1128       define variable v-other          as character no-undo .
     1129       run uf-name in this-procedure
     1130         (input  entry(1, p-code, chr(4))
     1131         ,output v-use-List_
     1132         ,output v-type-List_
     1133         ,output v-format-List_
     1134         ,output v-use-Naim
     1135         ,output v-type-Naim
     1136         ,output v-format-Naim
     1137         ,output v-use-print-graft
     1138         ,output v-use-sort-gr
     1139         ,output v-use-type-price
     1140         ,output v-use-type-val
     1141         ,output v-label
     1142         ,output v-tooltip
     1143         ,output v-user-can-edit
     1144         ,output v-output-display
     1145         ,output v-other
     1146         ) no-error .
     1147       if error-status :error then do:
     1148         undo, return error return-value .
     1149       end.
     1150       find first buf_usr-flt where
     1151                  buf_usr-flt.Call-point     = p-code AND
     1152                  buf_usr-flt.user-name       = p-user-name
     1153         no-error .
     1154       if not avail buf_usr-flt then do:
     1155           create buf_usr-flt .
     1156           assign
     1157           buf_usr-flt.call-point = p-code
     1158           buf_usr-flt.user-name  = p-user-name
     1159           .
     1160       end.
     1161       if avail buf_usr-flt then do:
     1162        assign
     1163        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
     1164        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
     1165        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
     1166        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
     1167        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
     1168        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
     1169       .
     1170       release buf_usr-flt.
     1171       end.
     1172       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
     1173     end.
     1174   end procedure.
     1175   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1176   define new shared temp-table dc-list no-undo like ub.dis-card
     1177     field to-del as logical
     1178     field order-num as integer
     1179     field fdec as decimal
     1180     field fint as integer
     1181     field flog as logical
     1182     field fchar as character
