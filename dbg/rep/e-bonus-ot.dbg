      885   .
      886   define variable v-twowin13-itm-key    as integer      no-undo.
      887   procedure twowin_clear :
      888       define buffer buf_temp_twowin_items        for temp_twowin_items.
      889   do
      890   for buf_temp_twowin_items
      891   on error undo, return error
      892   :
      893       empty temp-table buf_temp_twowin_items.
      894   end.
      895   end procedure.
      896   procedure twowin_add-item :
      897   define input parameter p-ext-key   as character        no-undo.
      898   define input parameter p-item-name as character        no-undo.
      899   define input parameter p-item-desc as character        no-undo.
      900   define input parameter p-selected  as logical          no-undo.
      901       define buffer buf_temp_twowin_items        for temp_twowin_items.
      902   do
      903   for buf_temp_twowin_items
      904   on error undo, return error
      905   :
      906       assign
      907           v-twowin13-itm-key = v-twowin13-itm-key + 1
      908       .
      909       create temp_twowin_items.
      910       assign
      911           temp_twowin_items.itm-key      = v-twowin13-itm-key
      912           temp_twowin_items.itmExtKey    = p-ext-key
      913           temp_twowin_items.itmName      = p-item-name
      914           temp_twowin_items.itmDesc      = p-item-desc
      915           temp_twowin_items.itmSelected  = p-selected
      916           temp_twowin_items.selLeft      = no
      917           temp_twowin_items.selRight     = no
      918       .
      919   end.
      920   end procedure.
      921   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      922   define variable v-uf-List_        like ubflt.usr-flt.List_        no-undo .
      923   define variable v-uf-Naim         like ubflt.usr-flt.Naim         no-undo .
      924   define variable v-uf-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      925   define variable v-uf-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      926   define variable v-uf-type-price   like ubflt.usr-flt.type-price   no-undo .
      927   define variable v-uf-type-val     like ubflt.usr-flt.type-val     no-undo .
      928   define temp-table usr-flt_custom-labels no-undo like ub.custom-labels.
      929   procedure uf-name :
      930     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      931     define output parameter p-use-List_     as logical   no-undo .
      932     define output parameter p-type-List_     as character no-undo .
      933     define output parameter p-format-List_   as character no-undo .
      934     define output parameter p-use-Naim      as logical   no-undo .
      935     define output parameter p-type-Naim      as character no-undo .
      936     define output parameter p-format-Naim    as character no-undo .
      937     define output parameter p-use-print-graft as logical   no-undo .
      938     define output parameter p-use-sort-gr   as logical   no-undo .
      939     define output parameter p-use-type-price as logical   no-undo .
      940     define output parameter p-use-type-val  as logical   no-undo .
      941     define output parameter p-label          as character no-undo .
      942     define output parameter p-tooltip        as character no-undo .
      943     define output parameter p-user-can-edit  as logical   no-undo .
      944     define output parameter p-output-display as logical   no-undo .
      945     define output parameter p-other          as character no-undo .
      946     do
      947     on error undo, return error
      948     :
      949       case p-code :
      950               when 'cli-all-p':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = yes      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Параметры вызова справочника клиентов"     p-tooltip = "Параметры по умолчанию, используемые для вызова справочника клиентов"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
