     2043          "Object ":U THIS-PROCEDURE:FILE-NAME
     2044            "must have at least one Enabled Table to perform Assign.":U
     2045              VIEW-AS ALERT-BOX ERROR.
     2046      RETURN.
     2047     END PROCEDURE.
     2048   PROCEDURE adm-assign-statement :
     2049     RETURN.
     2050   END PROCEDURE.
     2051   PROCEDURE adm-cancel-record :
     2052      RETURN.
     2053     END PROCEDURE.
     2054   PROCEDURE adm-copy-record :
     2055       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     2056        "must have at least one Enabled Table to perform Copy.":U
     2057          VIEW-AS ALERT-BOX ERROR.
     2058       RETURN.
     2059   END PROCEDURE.
     2060   PROCEDURE adm-create-record :
     2061      RETURN.
     2062   END PROCEDURE.
     2063   PROCEDURE adm-current-changed :
     2064     RETURN.
     2065   END PROCEDURE.
     2066   PROCEDURE adm-delete-record :
     2067    MESSAGE
     2068          "Object ":U THIS-PROCEDURE:FILE-NAME
     2069            "must have at least one Enabled Table to perform Delete.":U
     2070              VIEW-AS ALERT-BOX ERROR.
     2071       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
     2072       RETURN.
     2073   END PROCEDURE.
     2074   PROCEDURE adm-disable-fields :
     2075         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
     2076       RETURN.
     2077   END PROCEDURE.
     2078   PROCEDURE adm-enable-fields :
     2079       RETURN.
     2080   END PROCEDURE.
     2081   PROCEDURE adm-end-update :
     2082     RETURN.
     2083   END PROCEDURE.
     2084   PROCEDURE adm-reset-record :
     2085       RETURN.
     2086   END PROCEDURE.
     2087   PROCEDURE adm-update-record :
     2088       MESSAGE
     2089         "Object ":U THIS-PROCEDURE:FILE-NAME
     2090           "must have at least one Enabled Table to perform Update.":U
     2091             VIEW-AS ALERT-BOX ERROR.
     2092      RETURN.
     2093   END PROCEDURE.
     2094   PROCEDURE check-modified :
     2095   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     2096   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     2097   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     2098   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     2099     IF check-state = "check":U THEN
     2100     DO:
     2101       RUN get-link-handle IN adm-broker-hdl
     2102         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     2103            OUTPUT group-target-list).
     2104       IF group-target-list NE "":U THEN
     2105       DO i = 1 TO NUM-ENTRIES(group-target-list):
     2106         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     2107         RUN check-modified IN curr-widget ('group-check':U).
     2108         IF RETURN-VALUE NE "":U THEN
     2109         DO:
     2110           RUN check-modified-message(RETURN-VALUE).
     2111           RETURN "":U.
     2112         END.
     2113       END.
     2114     END.
     2115     RETURN "":U.
     2116   END PROCEDURE.
     2117   PROCEDURE check-modified-message :
     2118     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     2119        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     2120           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     2121        IF RETURN-VALUE = "YES":U THEN
     2122           RUN notify ('view,CONTAINER-SOURCE':U).
     2123        MESSAGE IF p-changed-table NE ? THEN
     2124           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     2125           ELSE "Current values have been changed."
     2126           SKIP "  Do you wish to save those changes?"
     2127           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     2128        IF ANS THEN
     2129        DO:
     2130           IF group-assign-target THEN
     2131             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     2132           ELSE RUN dispatch('update-record':U).
     2133           IF RETURN-VALUE = "ADM-ERROR":U THEN
     2134           DO:
     2135               MESSAGE "Changes to the previous record were not saved."
     2136                 VIEW-AS ALERT-BOX ERROR.
     2137               IF group-assign-target THEN
     2138                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     2139               ELSE RUN dispatch ('cancel-record':U).
     2140           END.
     2141        END.
     2142        ELSE DO:
     2143          IF group-assign-target THEN
     2144             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     2145          ELSE RUN dispatch('cancel-record':U).
     2146        END.
     2147        RETURN.
     2148   END PROCEDURE.
     2149   PROCEDURE get-rowid :
     2150       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     2151       ASSIGN
     2152       p-table   =   adm-first-table.
     2153       RETURN.
     2154   END PROCEDURE.
     2155   PROCEDURE init-group-assign :
     2156       RUN request-attribute IN adm-broker-hdl
     2157         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     2158       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     2159         group-assign-target = yes.
     2160       ELSE group-assign-target = no.
     2161       RETURN.
     2162   END PROCEDURE.
     2163   PROCEDURE set-editors :
     2164       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     2165       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     2166       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     2167       ASSIGN curr-widget = FRAME fMain:CURRENT-ITERATION.
     2168       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     2169       DO WHILE VALID-HANDLE (curr-widget):
     2170           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     2171              curr-widget:HIDDEN = no THEN DO:
     2172             CASE p-field-setting:
     2173               WHEN "INITIALIZE":U THEN
     2174               DO:
     2175                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     2176                     read-only-list +
     2177                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     2178                        STRING(curr-widget).
     2179               END.
     2180               WHEN "DISABLE":U OR
     2181               WHEN "ENABLE":U THEN
     2182               DO:
     2183                   curr-widget:SENSITIVE = yes.
     2184                   RUN get-attribute ('Read-Only-Editors':U).
     2185                   IF RETURN-VALUE = ? OR
     2186                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     2187                       curr-widget:READ-ONLY =
     2188                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     2189               END.
     2190               WHEN "CLEAR":U THEN
     2191                   curr-widget:SCREEN-VALUE = "":U.
     2192             END CASE.
     2193           END.
     2194           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     2195       END.
     2196       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     2197         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     2198           + '"':U).
     2199       RETURN.
     2200   END PROCEDURE.
     2201   PROCEDURE use-check-modified-all :
     2202    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     2203     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     2204     RETURN.
     2205   END PROCEDURE.
     2206   PROCEDURE use-create-on-add :
     2207   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     2208      RETURN.
     2209   END PROCEDURE.
     2210   PROCEDURE use-initial-lock :
     2211     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     2212     ASSIGN adm-initial-lock = p-attr-value.
     2213     RETURN.
     2214   END PROCEDURE.
     2215     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     2216   ASSIGN
     2217             FRAME FMain:SCROLLABLE       = FALSE
     2218          FRAME FMain:HIDDEN           = TRUE.
     2219   ON VALUE-CHANGED OF selectcard IN FRAME FMain
     2220   DO:
     2221     assign selectcard.
     2222     CASE selectcard:
     2223       when "selective":U then do:
     2224         run str/dc-list.w (my-handle, v-cntxt-host-code-obj, v-cntxt-obj-type, v-cntxt-obj-code).
     2225         assign
     2226         FixDCard = ""
     2227         DcardMode = "LIST":U
     2228         .
     2229         find first dc-list no-lock no-error .
     2230         if not available dc-list then do:
     2231           message
     2232           "В списке карт нет ни одной карты"
     2233           view-as alert-box WARNING.
     2234           assign
     2235           selectcard = "all":U
     2236           DcardMode  = "ALL":U
     2237           .
     2238       end.
     2239     end.
     2240     when "all":U then do:
     2241         assign
     2242         FixDCard = ""
     2243         DcardMode = "ALL":U
     2244         .
     2245     end.
     2246    END CASE.
     2247    display selectcard with frame fMain.
     2248   END.
     2249   ON VALUE-CHANGED OF T-obj-detal IN FRAME FMain
     2250   DO:
     2251       assign T-obj-detal.
     2252       end.
     2253   PROCEDURE adm-create-objects :
     2254   END PROCEDURE.
     2255   PROCEDURE disable_UI :
     2256     HIDE FRAME fMain.
     2257     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     2258   END PROCEDURE.
     2259   PROCEDURE enable_UI :
     2260     DISPLAY selectcard T-obj-detal
     2261         WITH FRAME fMain.
     2262     ENABLE RECT-1 RECT-2 selectcard T-obj-detal
     2263         WITH FRAME fMain.
     2264   END PROCEDURE.
     2265   PROCEDURE my-report :
     2266      run rep/r-bonus-ot.p
     2267       (
     2268          input my-handle
     2269          ,input DcardMode
     2270          ,input FixDCard
     2271          ,input X-SelectGood
     2272          ,input T-obj-detal
     2273          ,input selectcard
     2274         ) .
     2275       END PROCEDURE.
