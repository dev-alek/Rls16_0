      573   function diff-list returns character (
      574     input parfirst-list  as character,
      575     input parsecond-list as character,
      576     input pardelim       as character).
      577     if pardelim = ""
      578     or pardelim = ?
      579     then do:
      580       assign
      581         pardelim = ","
      582       .
      583     end.
      584     def var ind as integer no-undo .
      585     def var v-elem as character no-undo .
      586     def var v-result-list as character no-undo init "".
      587     def var v-num-parfirst-list as integer no-undo .
      588     assign
      589       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      590     .
      591     do ind = 1 to v-num-parfirst-list
      592     :
      593       assign
      594         v-elem = entry(ind, parfirst-list, pardelim)
      595       .
      596       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
      597         assign
      598           v-result-list = v-result-list
      599                         + (if v-result-list > "" then pardelim else "")
      600                         + v-elem
      601         .
      602       end.
      603     end.
      604     return v-result-list .
      605   end function.
      606   function add-list returns character (
      607    input parfirst-list  as character,
      608    input parsecond-list as character,
      609    input pardelim       as character).
      610     if pardelim = ""
      611     or pardelim = ?
      612     then do:
      613       assign
      614         pardelim = ","
      615       .
      616     end.
      617     def var ind as integer no-undo .
      618     def var v-elem as character no-undo .
      619     def var v-result-list as character no-undo init "".
      620     def var v-num-parfirst-list as integer no-undo .
      621     assign
      622       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      623     .
      624     do ind = 1 to v-num-parfirst-list
      625     :
      626       assign
      627         v-elem = entry(ind, parfirst-list, pardelim)
      628       .
      629       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      630         assign
      631           v-result-list = v-result-list
      632                         + (if v-result-list > "" then pardelim else "")
      633                         + v-elem
      634         .
      635       end.
      636     end.
      637     def var v-num-parsecond-list as integer no-undo .
      638     assign
      639       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
      640     .
      641     do ind = 1 to v-num-parsecond-list
      642     :
      643       assign
      644         v-elem = entry(ind, parsecond-list, pardelim)
      645       .
      646       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      647         assign
      648           v-result-list = v-result-list
      649                         + (if v-result-list > "" then pardelim else "")
      650                         + v-elem
      651         .
      652       end.
      653     end.
      654     return v-result-list .
      655   end function.
      656   function cross-list returns character (
      657    input parfirst-list  as character,
      658    input parsecond-list as character,
      659    input pardelim       as character).
      660     if pardelim = ""
      661     or pardelim = ?
      662     then do:
      663       assign
      664         pardelim = ","
      665       .
      666     end.
      667     def var ind as integer no-undo .
      668     def var v-elem as character no-undo .
      669     def var v-result-list as character no-undo init "".
      670     def var v-num-parfirst-list as integer no-undo .
      671     assign
      672       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      673     .
      674     do ind = 1 to v-num-parfirst-list
      675     :
      676       assign
      677         v-elem = entry(ind, parfirst-list, pardelim)
      678       .
      679       if lookup(v-elem, v-result-list, pardelim) = 0
      680       and lookup(v-elem, parsecond-list, pardelim) > 0
      681       then do:
      682         assign
      683           v-result-list = v-result-list
      684                         + (if v-result-list > "" then pardelim else "")
      685                         + v-elem
      686         .
      687       end.
      688     end.
      689     return v-result-list .
      690   end function.
      691   function radio-label returns character (
      692    input par-rs-value  as character,
      693    input par-rs-radio-buttons as character)
      694    .
      695    DEFINE variable v-result-label as character no-undo.
      696    assign
      697    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
      698                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
      699                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
      700                             ), par-rs-radio-buttons
      701                           )
      702    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      703    .
      704   return v-result-label.
      705   end function.
      706   function m-radio-label returns character (
      707    input par-rs-value  as character,
      708    input par-rs-radio-buttons as character,
      709    input par-delim as character
      710    )
      711    .
      712    DEFINE variable v-result-label as character no-undo.
      713    assign
      714    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
      715                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
      716                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
      717                             ), par-rs-radio-buttons, par-delim
      718                           )
      719    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      720    .
      721   return v-result-label.
      722   end function.
      723   FUNCTION mixlist returns character
      724   (
      725    input parfirst-list  as character
      726    ,input parsecond-list as character
      727    ,input pardelim       as character
      728    ,input pardelim-result as character ) :
      729     if pardelim = ""
      730     or pardelim = ?
      731     then do:
      732       assign
      733         pardelim = ","
      734       .
      735     end.
      736     def var ind as integer no-undo .
      737     def var v-elem1 as character no-undo .
      738     def var v-elem2 as character no-undo .
      739     def var v-result-list as character no-undo init "".
      740     do ind = 1 to num-entries(parfirst-list, pardelim)
      741     :
      742       assign
      743         v-elem1 = entry(ind, parfirst-list, pardelim)
      744         v-elem2 = entry(ind, parsecond-list, pardelim)
      745       .
      746         assign
      747           v-result-list = v-result-list
      748                         + (if v-result-list > "" then pardelim-result else "")
      749                         + v-elem1 + pardelim-result + v-elem2
      750         .
      751     end.
      752     return v-result-list .
      753   END FUNCTION.
