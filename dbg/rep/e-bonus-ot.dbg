     1211   .
     1212   define variable vss-include-info17 as character format "X(65)" no-undo
     1213   initial "@(#)$Workfile$ $Revision$".
     1214   procedure grplib-get-full-name :
     1215      define input parameter p-node-code  as integer      no-undo.
     1216      define output parameter p-full-name as character    no-undo.
     1217      do
     1218   on error undo, return error
     1219   :
     1220       define variable v-upper-code    as integer           no-undo.
     1221       define buffer buf_gds-grp       for ub.gds-grp.
     1222       define buffer buf_upper_gds-grp for ub.gds-grp.
     1223       find first buf_gds-grp no-lock
     1224            where buf_gds-grp.node-code = p-node-code
     1225       no-error.
     1226       if not available buf_gds-grp
     1227       then do:
     1228           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     1229       end.
     1230       assign
     1231           p-full-name  = ""
     1232           v-upper-code = 1
     1233       .
     1234       do while buf_gds-grp.upper-code <> 0
     1235       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     1236       :
     1237           assign
     1238               p-full-name  = buf_gds-grp.node-name
     1239                            + (if p-full-name <> "" then chr(47) else "")
     1240                            + p-full-name
     1241               v-upper-code = buf_gds-grp.upper-code
     1242           .
     1243           find first buf_gds-grp no-lock
     1244                where buf_gds-grp.node-code = v-upper-code
     1245           no-error.
     1246           if not available buf_gds-grp
     1247           then do:
     1248               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
     1249                                   + string( v-upper-code )
     1250                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     1251           end.
     1252       end.
     1253       assign
     1254       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     1255       .
     1256   end.
     1257   end .
     1258   procedure grplib-get-node-from-full-name :
     1259   define input parameter p-full-name as character no-undo .
     1260   define output parameter p-node-code as integer no-undo .
     1261   define variable v-ii as integer no-undo .
     1262   define variable v-upper-code as integer no-undo .
     1263   define variable v-root-code as integer no-undo .
     1264   define variable v-entry as character no-undo .
     1265   define buffer buf_gds-grp       for ub.gds-grp.
     1266   do
     1267   on error undo, return error
     1268   :
     1269     find first buf_gds-grp no-lock
     1270         where buf_gds-grp.upper-code = 0
     1271     no-error .
     1272     if not available buf_gds-grp
     1273     then do:
     1274         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
     1275     end.
     1276     else do:
     1277       assign
     1278       v-root-code = buf_gds-grp.node-code
     1279       .
     1280     end.
     1281     v-upper-code = v-root-code.
     1282     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     1283       assign
     1284       v-entry = entry(v-ii, p-full-name, chr(47)).
     1285       if v-entry = '' then leave.
     1286       find first buf_gds-grp no-lock where
     1287                 buf_gds-grp.node-name = v-entry
     1288             and buf_gds-grp.upper-code = v-upper-code
     1289             no-error.
     1290       if not available buf_gds-grp then do:
     1291         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     1292       end.
     1293       else do:
     1294         p-node-code = buf_gds-grp.node-code.
     1295         v-upper-code = buf_gds-grp.node-code.
     1296       end.
     1297     end.
     1298   end.
     1299   end .
     1300   CREATE WIDGET-POOL.
     1301   def var vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1302   procedure gen-key-rec :
     1303     define input  parameter p-tbl-name    as character no-undo.
     1304     define input  parameter p-bh_tbl-name as handle    no-undo.
     1305     define output parameter p-key-rec     as character no-undo.
     1306     do
     1307     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1308     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     1309     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     1310     :
     1311       define variable fh               as handle    no-undo .
     1312       define variable v-ok             as logical   no-undo .
     1313       define variable v-inform         as character no-undo .
     1314       define variable v-ind            as integer   no-undo .
     1315       define variable v-idx-field-qnty as integer   no-undo .
     1316       if p-tbl-name = ?
     1317         or p-tbl-name = "":U
     1318       then do:
     1319         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info18 ).
     1320       end.
     1321       if not p-bh_tbl-name:available then do:
     1322         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info18, p-tbl-name ).
     1323       end.
     1324       assign
     1325         p-key-rec = p-tbl-name
     1326         v-inform  = p-bh_tbl-name:index-information(1)
     1327         v-ind     = 2
     1328       .
     1329       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1330       on error undo, return error
     1331       :
     1332         assign
     1333           v-inform = p-bh_tbl-name:index-information( v-ind )
     1334           v-ind    = v-ind + 1
     1335         .
     1336       end.
     1337       if v-inform = ?
     1338         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1339         or entry( 3, v-inform, ",":U ) <> "1":U
     1340       then do:
     1341         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info18, p-tbl-name ).
     1342       end.
     1343       else do:
     1344         assign
     1345           v-idx-field-qnty = num-entries( v-inform ) - 4
     1346         .
     1347         if v-idx-field-qnty < 2 then do:
     1348           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info18, v-inform, p-tbl-name ).
     1349         end.
     1350         do v-ind = 1 to v-idx-field-qnty by 2
     1351         on error undo, return error
     1352         :
     1353           assign
     1354             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     1355             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     1356           .
     1357         end.
     1358       end.
     1359       if p-key-rec = ? then do:
     1360         assign
     1361           p-key-rec = "":U
     1362         .
     1363         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info18, p-tbl-name ).
     1364       end.
     1365     end.
     1366     return.
     1367   end procedure.
     1368   procedure gen-where-keyr-tab :
     1369     define input  parameter i-tableSerach as character no-undo.
     1370     define input  parameter i-tablekey   as character  no-undo.
     1371     define input  parameter p-key-rec    as character  no-undo.
     1372     define input  parameter p-key-handle as handle     no-undo .
     1373     define input  parameter p-db-name    as character  no-undo .
     1374     define input  parameter p-tt-handle  as handle     no-undo .
     1375     define output parameter o-Where      as character  no-undo.
     1376     do
     1377     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1378     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1379     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     1380     :
     1381       define variable v-full-tbl-name  as character no-undo .
     1382       define variable bh_tbl-name      as handle    no-undo .
     1383       define variable fh_key           as handle    no-undo .
     1384       define variable fh_search        as handle    no-undo .
     1385       define variable v-field-num      as integer   no-undo .
     1386       define variable v-count-fld      as integer   no-undo .
     1387       define variable v-inform         as character no-undo .
     1388       define variable v-ind            as integer   no-undo .
     1389       define variable v-idx-field-qnty as integer   no-undo .
     1390       define variable v-field-name     as character no-undo .
     1391       define variable v-field-val      as character no-undo .
     1392       define variable v-word-link      as character no-undo .
     1393       define variable vTable           as character no-undo.
     1394       define variable bh_tbl-key       as handle    no-undo .
     1395       assign
     1396         p-key-rec = trim( p-key-rec )
     1397       .
     1398       if p-key-handle <> ? then do:
     1399         if not valid-handle(p-key-handle)
     1400            or p-key-handle:type <> "buffer"
     1401         then do:
     1402           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info18 ).
     1403         end.
     1404         if num-entries( p-key-rec, chr(3) ) > 1
     1405           or p-key-rec = ?
     1406           or p-key-rec = "":U
     1407         then do:
     1408           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info18, p-key-rec ).
     1409         end.
     1410       end.
     1411       else do:
     1412         if p-key-rec = ?
     1413           or p-key-rec = "":U
     1414         then do:
     1415           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info18 ).
     1416         end.
     1417       end.
     1418       assign
     1419         vTable = entry( 1 , p-key-rec, chr(3) )
     1420       .
     1421       if p-tt-handle <> ?
     1422         and ( not valid-handle(p-tt-handle)
     1423               or p-tt-handle:type <> "buffer"
     1424             )
     1425       then do:
     1426         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info18, vTable, chr(10) ).
     1427       end.
     1428       if p-tt-handle = ? then do:
     1429         assign
     1430           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     1431         .
     1432         create buffer bh_tbl-name for table v-full-tbl-name .
     1433       end.
     1434       else do:
     1435         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1436       end.
     1437       assign
     1438         v-inform = bh_tbl-name:index-information(1)
     1439         v-ind    = 2
     1440       .
     1441       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1442       on error undo, return error
     1443       :
     1444         assign
     1445           v-inform = bh_tbl-name:index-information( v-ind )
     1446           v-ind    = v-ind + 1
     1447         .
     1448       end.
     1449       if v-inform = ?
     1450         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1451         or entry( 3, v-inform, ",":U ) <> "1":U
     1452       then do:
     1453         delete object bh_tbl-name no-error.
     1454         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info18, vTable ).
     1455       end.
     1456       assign
     1457         v-idx-field-qnty = num-entries( v-inform ) - 4
     1458       .
     1459       if v-idx-field-qnty < 2 then do:
     1460         delete object bh_tbl-name no-error.
     1461         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info18, v-inform, vTable ).
     1462       end.
     1463       assign
     1464         o-where     = "where":U
     1465         v-word-link = "":U
     1466         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     1467         v-count-fld = 0
     1468       .
     1469       if i-tablekey ne "" and i-tablekey ne ?
     1470       then do:
     1471         assign
     1472           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     1473         .
     1474         create buffer bh_tbl-key for table v-full-tbl-name .
     1475       end.
     1476       if i-tableSerach ne "" and i-tableSerach ne ?
     1477       then do:
     1478         delete object bh_tbl-name no-error.
     1479         assign
     1480           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     1481         .
     1482         create buffer bh_tbl-name for table v-full-tbl-name .
     1483       end.
     1484       block_where:
     1485       do v-ind = 1 to v-idx-field-qnty by 2
     1486       on error undo, return error
     1487       :
     1488         assign
     1489           v-count-fld = v-count-fld + 1
     1490         .
     1491         if p-key-handle = ?
     1492           and v-count-fld > v-field-num
     1493         then do:
     1494           leave block_where.
     1495         end.
     1496         define variable VfieldKeyTable as handle no-undo.
     1497         assign
     1498           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1499           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     1500         .
     1501         if     bh_tbl-key ne ?
     1502         then do:
     1503            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     1504            if VfieldKeyTable eq ?
     1505            then next block_where.
     1506         end.
     1507         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     1508         then
     1509            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     1510         else
     1511            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     1512         if p-key-handle = ? then do:
     1513           assign
     1514             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     1515           .
     1516         end.
     1517         else do:
     1518           assign
     1519             fh_key = p-key-handle:buffer-field( v-field-name )
     1520           .
     1521           if fh_key = ?
     1522             or not valid-handle( fh_key )
     1523           then do:
     1524             delete object bh_tbl-name.
     1525             if     bh_tbl-key ne ?
     1526             then
     1527                delete object bh_tbl-key.
     1528             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info18, p-key-handle:name, v-field-name ).
     1529           end.
     1530           assign
     1531             v-field-val = fh_key:buffer-value
     1532           .
     1533         end.
     1534         if fh_search:data-type ="character":U then do:
     1535           assign
     1536             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     1537             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     1538             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     1539             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     1540             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     1541             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     1542             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     1543             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     1544             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     1545             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     1546             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     1547             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     1548             v-field-val = substitute( '"&1"', v-field-val )
     1549           .
     1550         end.
     1551         assign
     1552           o-where = substitute( "&1 &2", o-where, v-field-val )
     1553         .
     1554         if v-word-link = "":U then do:
     1555           assign
     1556             v-word-link = "and":U
     1557           .
     1558         end.
     1559       end.
     1560       delete object bh_tbl-name.
     1561       if     bh_tbl-key ne ?
     1562       then
     1563          delete object bh_tbl-key.
     1564       if p-key-handle = ?
     1565         and v-count-fld <> v-field-num
     1566       then do:
     1567         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info18, vTable ).
     1568       end.
     1569     end.
     1570   end procedure.
     1571   procedure gen-hn-keyr-tab :
     1572     define input  parameter i-tableSerach as character no-undo.
     1573     define input  parameter i-tablekey   as character no-undo.
     1574     define input  parameter p-key-rec    as character no-undo.
     1575     define input  parameter p-key-handle as handle    no-undo .
     1576     define input  parameter p-db-name    as character no-undo .
     1577     define input  parameter p-tt-handle  as handle    no-undo .
     1578     define input  parameter p-stts-lock  as integer   no-undo .
     1579     define output parameter o-hn         as handle    no-undo.
     1580     define variable v-full-tbl-name as character no-undo.
     1581     define variable v-where         as character no-undo.
     1582     define variable bh_tbl-name     as handle    no-undo.
     1583     define variable vTable          as character no-undo.
     1584     do
     1585     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1586     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1587     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     1588         run gen-where-keyr-tab(i-tableSerach,
     1589                                i-tablekey,
     1590                                p-key-rec,
     1591                                p-key-handle,
     1592                                p-db-name,
     1593                                p-tt-handle,
     1594                                output v-where).
     1595         if i-tableSerach ne "" and i-tableSerach ne ?
     1596         then do:
     1597            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     1598            create buffer bh_tbl-name for table v-full-tbl-name .
     1599         end.
     1600         else do:
     1601            if p-tt-handle = ? then do:
     1602               assign
     1603                  vTable = entry( 1 , p-key-rec, chr(3) )
     1604               .
     1605               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     1606               create buffer bh_tbl-name for table v-full-tbl-name .
     1607            end.
     1608            else do:
     1609               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1610            end.
     1611         end.
     1612         if p-tt-handle = ? then do:
     1613            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     1614         end.
     1615         else do:
     1616            bh_tbl-name:find-first( v-where ) no-error .
     1617         end.
     1618         o-hn = bh_tbl-name.
     1619      end.
     1620   end procedure.
     1621   procedure gen-hn-keyr :
     1622     define input  parameter p-key-rec    as character no-undo.
     1623     define input  parameter p-key-handle as handle    no-undo .
     1624     define input  parameter p-db-name    as character no-undo .
     1625     define input  parameter p-tt-handle  as handle    no-undo .
     1626     define input  parameter p-stts-lock  as integer   no-undo .
     1627     define output parameter o-hn         as handle    no-undo.
     1628     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     1629   end.
     1630   procedure gen-row-keyr :
     1631     define input  parameter p-key-rec    as character no-undo.
     1632     define input  parameter p-key-handle as handle    no-undo .
     1633     define input  parameter p-db-name    as character no-undo .
     1634     define input  parameter p-tt-handle  as handle    no-undo .
     1635     define input  parameter p-stts-lock  as integer   no-undo .
     1636     define output parameter p-tbl-row    as rowid     no-undo.
     1637     define output parameter p-tbl-name   as character no-undo.
     1638     define variable vHn as handle no-undo.
     1639       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     1640       p-tbl-row = if vHn:available then vHn:rowid else ?.
     1641       p-tbl-name =  vHn:table.
     1642       delete object vHn no-error.
     1643     if p-tbl-row = ? then do:
     1644       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info18, p-tbl-name, p-key-rec ).
     1645     end.
     1646     else do:
     1647       return.
     1648     end.
     1649   end procedure.
     1650   procedure gen-key-fv :
     1651     define input  parameter p-key-rec    as character no-undo .
     1652     define output parameter p-field-list as character no-undo .
     1653     define output parameter p-value-list as character no-undo.
     1654     do
     1655     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1656     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1657     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1658     :
     1659       define variable v-full-tbl-name  as character no-undo .
     1660       define variable bh_tbl-name      as handle    no-undo .
     1661       define variable v-tbl-name       as character no-undo .
     1662       define variable v-field-num      as integer   no-undo .
     1663       define variable v-count-fld      as integer   no-undo .
     1664       define variable v-inform         as character no-undo .
     1665       define variable v-ind            as integer   no-undo .
     1666       define variable v-idx-field-qnty as integer   no-undo .
     1667       define variable v-delim-key      as character no-undo .
     1668       if p-key-rec = ?
     1669         or p-key-rec = "":U
     1670       then do:
     1671         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info18 ).
     1672       end.
     1673       assign
     1674         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1675         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1676       .
     1677       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1678       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info18 ).
     1679       assign
     1680         v-inform = bh_tbl-name:index-information(1)
     1681         v-ind    = 2
     1682       .
     1683       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1684       on error undo, return error
     1685       :
     1686         assign
     1687           v-inform = bh_tbl-name:index-information( v-ind )
     1688           v-ind    = v-ind + 1
     1689         .
     1690       end.
     1691       if v-inform = ?
     1692         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1693         or entry( 3, v-inform, ",":U ) <> "1":U
     1694       then do:
     1695         delete object bh_tbl-name no-error.
     1696         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info18, v-tbl-name ).
     1697       end.
     1698       assign
     1699         v-idx-field-qnty = num-entries( v-inform ) - 4
     1700       .
     1701       if v-idx-field-qnty < 2 then do:
     1702         delete object bh_tbl-name no-error.
     1703         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info18, v-inform, v-tbl-name ).
     1704       end.
     1705       assign
     1706         p-field-list = "":U
     1707         p-value-list = "":U
     1708         v-delim-key  = "":U
     1709         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     1710         v-count-fld  = 0
     1711       .
     1712       block_where:
     1713       do v-ind = 1 to v-idx-field-qnty by 2
     1714       on error undo, return error
     1715       :
     1716         assign
     1717           v-count-fld = v-count-fld + 1
     1718         .
     1719         if v-count-fld > v-field-num then do:
     1720           leave block_where.
     1721         end.
     1722         assign
     1723           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1724           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1725         .
     1726         if v-ind = 1 then do:
     1727           assign
     1728             v-delim-key = chr(3)
     1729           .
     1730         end.
     1731       end.
     1732       delete object bh_tbl-name.
     1733       if v-count-fld <> v-field-num then do:
     1734         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info18, v-tbl-name ).
     1735       end.
     1736     end.
     1737   end procedure.
     1738   procedure gen-key-field :
     1739     define input  parameter p-table      as character no-undo .
     1740     define output parameter p-field-list as character no-undo .
     1741     do
     1742     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1743     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1744     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1745     :
     1746       define variable v-full-tbl-name  as character no-undo .
     1747       define variable bh_tbl-name      as handle    no-undo .
     1748       define variable v-tbl-name       as character no-undo .
     1749       define variable v-field-num      as integer   no-undo .
     1750       define variable v-count-fld      as integer   no-undo .
     1751       define variable v-inform         as character no-undo .
     1752       define variable v-ind            as integer   no-undo .
     1753       define variable v-idx-field-qnty as integer   no-undo .
     1754       define variable v-delim-key      as character no-undo .
     1755       if p-table = ?
     1756         or p-table = "":U
     1757       then do:
     1758         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info18 ).
     1759       end.
     1760       assign
     1761         v-tbl-name      = p-table
     1762         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1763       .
     1764       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1765       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info18 ).
     1766       assign
     1767         v-inform = bh_tbl-name:index-information(1)
     1768         v-ind    = 2
     1769       .
     1770       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1771       on error undo, return error
     1772       :
     1773         assign
     1774           v-inform = bh_tbl-name:index-information( v-ind )
     1775           v-ind    = v-ind + 1
     1776         .
     1777       end.
     1778       if v-inform = ?
     1779         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1780         or entry( 3, v-inform, ",":U ) <> "1":U
     1781       then do:
     1782         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info18, v-tbl-name ).
     1783       end.
     1784       assign
     1785         v-idx-field-qnty = num-entries( v-inform ) - 4
     1786       .
     1787       if v-idx-field-qnty < 2 then do:
     1788         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info18, v-inform, v-tbl-name ).
     1789       end.
     1790       assign
     1791         p-field-list = "":U
     1792         v-delim-key  = "":U
     1793         v-count-fld  = 0
     1794       .
     1795       block_where:
     1796       do v-ind = 1 to v-idx-field-qnty by 2
     1797       on error undo, return error
     1798       :
     1799         assign
     1800           v-count-fld = v-count-fld + 1
     1801         .
     1802         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1803         if v-ind = 1 then do:
     1804           assign
     1805             v-delim-key = chr(3)
     1806           .
     1807         end.
     1808       end.
     1809       delete object bh_tbl-name.
     1810     end.
     1811   end procedure.
     1812   define variable DcardMode as character no-undo init "ALL".
     1813   define variable FixDCard as character no-undo.
     1814   DEFINE VARIABLE selectcard AS character
     1815        VIEW-AS RADIO-SET VERTICAL
     1816        RADIO-BUTTONS
     1817             "Все","All":U,
     1818   "Выборочно по картам",  "Selective":U
     1819        SIZE 37 BY 3 NO-UNDO.
     1820   DEFINE RECTANGLE RECT-1
     1821        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1822        SIZE 38 BY 3.5.
     1823   DEFINE RECTANGLE RECT-2
     1824        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1825        SIZE 38 BY 2.25.
     1826   DEFINE VARIABLE T-obj-detal AS LOGICAL INITIAL no
     1827        LABEL "Детализация по объектам"
     1828        VIEW-AS TOGGLE-BOX
     1829        SIZE 37 BY 1.75 NO-UNDO.
     1830   DEFINE FRAME fMain
     1831        selectcard AT ROW 3.25 COL 4 NO-LABEL WIDGET-ID 2
     1832        T-obj-detal AT ROW 7.25 COL 3.5 WIDGET-ID 10
     1833        "Выбор карт:" VIEW-AS TEXT
     1834             SIZE 15.5 BY .67 AT ROW 2.25 COL 3.5 WIDGET-ID 8
     1835        RECT-1 AT ROW 3 COL 3.5 WIDGET-ID 6
     1836        RECT-2 AT ROW 7 COL 3 WIDGET-ID 12
     1837       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
     1838            SIDE-LABELS NO-UNDERLINE THREE-D
     1839            AT COL 1 ROW 1
     1840            SIZE 64.13 BY 16.42 WIDGET-ID 100.
     1841   IF NOT THIS-PROCEDURE:PERSISTENT THEN DO:
     1842     MESSAGE "c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\rep\e-bonus-ot.w should only be RUN PERSISTENT.":U
     1843             VIEW-AS ALERT-BOX ERROR BUTTONS OK.
     1844     RETURN.
     1845   END.
     1846   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     1847   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     1848   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     1849   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     1850   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     1851   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     1852   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     1853   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     1854       ASSIGN adm-object-hdl = FRAME fMain:HANDLE.
     1855   RUN ensure-broker.
     1856   THIS-PROCEDURE:ADM-DATA =
     1857        'ADM1.1~`':U +
     1858        'SmartFrame~`':U +
     1859        'FRAME~`':U +
     1860        'NO ~`':U +
     1861        '~`':U +
     1862        '~`':U +
     1863        '~`':U +
     1864        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     1865           + "~`":U +
     1866        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
     1867        'Data-Target,Data-Source,Page-Target,Update-Source,Update-Target~`':U +
     1868        '~`':U +
     1869        '~`~`~`~`~`~`~`~`~`~`~`':U +
     1870        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1871            THEN "^^":U
     1872        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1873             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1874   PROCEDURE adm-apply-entry :
     1875     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1876   END PROCEDURE.
     1877   PROCEDURE adm-destroy :
     1878    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1879   END PROCEDURE.
     1880   PROCEDURE adm-disable :
     1881       DISABLE RECT-1 RECT-2 selectcard T-obj-detal WITH FRAME fMain.
     1882       RUN dispatch ('disable-fields':U).
     1883       RUN set-attribute-list ('ENABLED=no':U).
     1884       RETURN.
     1885   END PROCEDURE.
     1886   PROCEDURE adm-edit-attribute-list :
     1887         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
     1888         RETURN.
     1889   END PROCEDURE.
     1890   PROCEDURE adm-enable :
     1891       ENABLE UNLESS-HIDDEN RECT-1 RECT-2 selectcard T-obj-detal WITH FRAME fMain.
     1892       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     1893       RUN set-attribute-list ('ENABLED=yes':U).
     1894       RETURN.
     1895   END PROCEDURE.
     1896   PROCEDURE adm-exit :
     1897        RUN notify ('exit':U).
     1898     RETURN.
     1899   END PROCEDURE.
     1900   PROCEDURE adm-hide :
     1901     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1902   END PROCEDURE.
     1903   PROCEDURE adm-initialize :
     1904     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1905   END PROCEDURE.
     1906   PROCEDURE adm-show-errors :
     1907       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1908       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1909           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1910       END.
     1911       RETURN.
     1912   END PROCEDURE.
     1913   PROCEDURE adm-UIB-mode :
     1914     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1915   END PROCEDURE.
     1916   PROCEDURE adm-view :
     1917     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1918   END PROCEDURE.
     1919   PROCEDURE dispatch :
     1920       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1921       RUN broker-dispatch IN adm-broker-hdl
     1922           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1923       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1924   END PROCEDURE.
     1925   PROCEDURE ensure-broker :
     1926   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1927   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1928   DO:
     1929       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1930       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1931   END.
     1932   END PROCEDURE.
     1933   PROCEDURE get-attribute :
     1934     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1935     RUN broker-get-attribute IN adm-broker-hdl
     1936         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1937     RETURN RETURN-VALUE.
     1938   END PROCEDURE.
     1939   PROCEDURE get-attribute-list :
     1940     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1941     RUN broker-get-attribute-list IN adm-broker-hdl
     1942         (INPUT THIS-PROCEDURE,
     1943          INPUT ?,
     1944          OUTPUT p-attr-list) NO-ERROR.
     1945     RETURN.
     1946   END PROCEDURE.
     1947   PROCEDURE new-state :
     1948     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1949     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1950     RETURN.
     1951   END PROCEDURE.
     1952   PROCEDURE notify :
     1953     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1954     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1955     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1956         RETURN "ADM-ERROR":U.
     1957     RETURN.
     1958   END PROCEDURE.
     1959   PROCEDURE set-attribute-list :
     1960     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1961     RUN ensure-broker.
     1962     RUN broker-set-attribute-list IN adm-broker-hdl
     1963         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1964     RETURN.
     1965   END PROCEDURE.
     1966   PROCEDURE set-position :
     1967       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1968       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1969       IF VALID-HANDLE(adm-object-hdl) THEN
     1970       DO:
     1971           DEFINE VARIABLE parent-hdl AS HANDLE NO-UNDO.
     1972           IF adm-object-hdl:TYPE = "WINDOW":U THEN
     1973           DO:
     1974             IF p-row = 0 THEN p-row =
     1975               (SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2.
     1976             IF p-col = 0 THEN p-col =
     1977               (SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2.
     1978           END.
     1979           ELSE IF adm-object-hdl:TYPE = "DIALOG-BOX":U THEN
     1980           DO:
     1981             parent-hdl = adm-object-hdl:PARENT.
     1982             IF p-row = 0 THEN p-row =
     1983               ((SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2) -
     1984                 parent-hdl:ROW.
     1985             IF p-col = 0 THEN p-col =
     1986               ((SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2) -
     1987                 parent-hdl:COL.
     1988           END.
     1989           IF p-row GE 0 AND p-row < 1 THEN p-row = 1.
     1990           IF p-col GE 0 AND p-col < 1 THEN p-col = 1.
     1991         ASSIGN adm-object-hdl:ROW    =   p-row
     1992                adm-object-hdl:COLUMN =   p-col.
     1993       END.
     1994       RETURN.
     1995   END PROCEDURE.
     1996   PROCEDURE adm-display-fields :
     1997       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
     1998       RETURN.
     1999   END PROCEDURE.
     2000   PROCEDURE adm-open-query :
     2001     RETURN.
     2002   END PROCEDURE.
     2003   PROCEDURE adm-row-changed :
     2004         IF VALID-HANDLE(adm-object-hdl) THEN
     2005           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     2006         RUN notify ('row-available':U).
     2007         RETURN.
     2008   END PROCEDURE.
     2009   PROCEDURE reposition-query :
     2010       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
     2011       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
     2012       RETURN.
     2013   END PROCEDURE.
     2014     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
     2015     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
     2016     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
     2017     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
     2018     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
     2019     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
     2020     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
     2021     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
     2022     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     2023     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
     2024     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     2025     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
     2026     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
     2027     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
     2028     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
     2029     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
     2030     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
     2031     IF "":U = "":U THEN
     2032       RUN modify-list-attribute IN adm-broker-hdl
     2033         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
     2034     RUN use-create-on-add(?).
     2035   PROCEDURE adm-add-record :
     2036       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     2037          "must have at least one Enabled Table to perform Add.":U
     2038          VIEW-AS ALERT-BOX ERROR.
     2039       RETURN.
     2040   END PROCEDURE.
     2041   PROCEDURE adm-assign-record :
