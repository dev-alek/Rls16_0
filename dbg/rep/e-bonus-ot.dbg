     1186     index host-dscnt  emitent-host-code status_ d-pcnt
     1187     index host-type  emitent-host-code type d-pcnt
     1188     index oi order-num
     1189     .
     1190   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1191   define  new shared  temp-table dc-list-hist no-undo
     1192   field list-table as character
     1193   field id as integer
     1194   field line as integer
     1195   field hist-mode as character
     1196   field des as character
     1197   field num-recs as integer
     1198   field option_ as character
     1199   field item_ as character
     1200   field status_ as character
     1201   field num-add as integer
     1202   field num-ignored as integer
