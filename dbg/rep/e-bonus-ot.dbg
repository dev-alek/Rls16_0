      765   define variable v-inform-launched as logical no-undo initial false .
      766   procedure proc-alt-shift-f4:
      767     define variable v-action as character no-undo .
      768     if v-inform-launched = false then do:
      769       assign
      770         v-inform-launched = true
      771       .
      772       run gbl/d-inform.w
      773         (  input self
      774         ,  input this-procedure
      775         , output v-action
      776         ) no-error .
      777       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      778       assign
      779         v-inform-launched = false
      780       .
      781     end.
      782   end.
