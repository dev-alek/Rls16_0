      864   define temp-table temp_twowin_items no-undo
      865       field itm-key       as integer
      866       field itmExtKey     as character
      867       field itmName       as character
      868       field itmDesc       as character
      869       field itmSelected   as logical
      870       field selLeft       as logical
      871       field selRight      as logical
