      695   DEFINE INPUT PARAMETER pnetto as decimal no-undo.
      696   DEFINE INPUT PARAMETER pout-name as character no-undo.
      697   DEFINE INPUT PARAMETER pis-pay as logical no-undo.
      698   DEFINE INPUT PARAMETER pii as integer no-undo.
      699   _main:
      700   DO ON ERROR UNDO _main, return error:
      701       create actreal-3.
      702       assign
      703       actreal-3.grp-code-sheet = pgrp-code-sheet
      704       actreal-3.cpay-code = pcpay-code
      705       actreal-3.curr-code = pcurr-code
      706       actreal-3.qnty1  =  pqnty1
