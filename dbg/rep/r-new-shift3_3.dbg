      951   tbl-name
      952   uniq-key-rec
      953   .
      954   def var vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      955   procedure gen-key-rec :
      956     define input  parameter p-tbl-name    as character no-undo.
      957     define input  parameter p-bh_tbl-name as handle    no-undo.
      958     define output parameter p-key-rec     as character no-undo.
      959     do
      960     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      961     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      962     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      963     :
      964       define variable fh               as handle    no-undo .
      965       define variable v-ok             as logical   no-undo .
      966       define variable v-inform         as character no-undo .
      967       define variable v-ind            as integer   no-undo .
      968       define variable v-idx-field-qnty as integer   no-undo .
      969       if p-tbl-name = ?
      970         or p-tbl-name = "":U
      971       then do:
      972         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info17 ).
      973       end.
      974       if not p-bh_tbl-name:available then do:
      975         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info17, p-tbl-name ).
      976       end.
      977       assign
      978         p-key-rec = p-tbl-name
      979         v-inform  = p-bh_tbl-name:index-information(1)
      980         v-ind     = 2
      981       .
      982       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      983       on error undo, return error
      984       :
      985         assign
      986           v-inform = p-bh_tbl-name:index-information( v-ind )
      987           v-ind    = v-ind + 1
      988         .
      989       end.
      990       if v-inform = ?
      991         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      992         or entry( 3, v-inform, ",":U ) <> "1":U
      993       then do:
      994         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info17, p-tbl-name ).
      995       end.
      996       else do:
      997         assign
      998           v-idx-field-qnty = num-entries( v-inform ) - 4
      999         .
     1000         if v-idx-field-qnty < 2 then do:
     1001           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info17, v-inform, p-tbl-name ).
     1002         end.
     1003         do v-ind = 1 to v-idx-field-qnty by 2
     1004         on error undo, return error
     1005         :
     1006           assign
     1007             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     1008             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     1009           .
     1010         end.
     1011       end.
     1012       if p-key-rec = ? then do:
     1013         assign
     1014           p-key-rec = "":U
     1015         .
     1016         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info17, p-tbl-name ).
     1017       end.
     1018     end.
     1019     return.
     1020   end procedure.
     1021   procedure gen-where-keyr-tab :
     1022     define input  parameter i-tableSerach as character no-undo.
     1023     define input  parameter i-tablekey   as character  no-undo.
     1024     define input  parameter p-key-rec    as character  no-undo.
     1025     define input  parameter p-key-handle as handle     no-undo .
     1026     define input  parameter p-db-name    as character  no-undo .
     1027     define input  parameter p-tt-handle  as handle     no-undo .
     1028     define output parameter o-Where      as character  no-undo.
     1029     do
     1030     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1031     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1032     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     1033     :
     1034       define variable v-full-tbl-name  as character no-undo .
     1035       define variable bh_tbl-name      as handle    no-undo .
     1036       define variable fh_key           as handle    no-undo .
     1037       define variable fh_search        as handle    no-undo .
     1038       define variable v-field-num      as integer   no-undo .
     1039       define variable v-count-fld      as integer   no-undo .
     1040       define variable v-inform         as character no-undo .
     1041       define variable v-ind            as integer   no-undo .
     1042       define variable v-idx-field-qnty as integer   no-undo .
     1043       define variable v-field-name     as character no-undo .
     1044       define variable v-field-val      as character no-undo .
     1045       define variable v-word-link      as character no-undo .
     1046       define variable vTable           as character no-undo.
     1047       define variable bh_tbl-key       as handle    no-undo .
     1048       assign
     1049         p-key-rec = trim( p-key-rec )
     1050       .
     1051       if p-key-handle <> ? then do:
     1052         if not valid-handle(p-key-handle)
     1053            or p-key-handle:type <> "buffer"
     1054         then do:
     1055           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info17 ).
     1056         end.
     1057         if num-entries( p-key-rec, chr(3) ) > 1
     1058           or p-key-rec = ?
     1059           or p-key-rec = "":U
     1060         then do:
     1061           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info17, p-key-rec ).
     1062         end.
     1063       end.
     1064       else do:
     1065         if p-key-rec = ?
     1066           or p-key-rec = "":U
     1067         then do:
     1068           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info17 ).
     1069         end.
     1070       end.
     1071       assign
     1072         vTable = entry( 1 , p-key-rec, chr(3) )
     1073       .
     1074       if p-tt-handle <> ?
     1075         and ( not valid-handle(p-tt-handle)
     1076               or p-tt-handle:type <> "buffer"
     1077             )
     1078       then do:
     1079         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info17, vTable, chr(10) ).
     1080       end.
     1081       if p-tt-handle = ? then do:
     1082         assign
     1083           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     1084         .
     1085         create buffer bh_tbl-name for table v-full-tbl-name .
     1086       end.
     1087       else do:
     1088         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1089       end.
     1090       assign
     1091         v-inform = bh_tbl-name:index-information(1)
     1092         v-ind    = 2
     1093       .
     1094       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1095       on error undo, return error
     1096       :
     1097         assign
     1098           v-inform = bh_tbl-name:index-information( v-ind )
     1099           v-ind    = v-ind + 1
     1100         .
     1101       end.
     1102       if v-inform = ?
     1103         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1104         or entry( 3, v-inform, ",":U ) <> "1":U
     1105       then do:
     1106         delete object bh_tbl-name no-error.
     1107         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info17, vTable ).
     1108       end.
     1109       assign
     1110         v-idx-field-qnty = num-entries( v-inform ) - 4
     1111       .
     1112       if v-idx-field-qnty < 2 then do:
     1113         delete object bh_tbl-name no-error.
     1114         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info17, v-inform, vTable ).
     1115       end.
     1116       assign
     1117         o-where     = "where":U
     1118         v-word-link = "":U
     1119         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     1120         v-count-fld = 0
     1121       .
     1122       if i-tablekey ne "" and i-tablekey ne ?
     1123       then do:
     1124         assign
     1125           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     1126         .
     1127         create buffer bh_tbl-key for table v-full-tbl-name .
     1128       end.
     1129       if i-tableSerach ne "" and i-tableSerach ne ?
     1130       then do:
     1131         delete object bh_tbl-name no-error.
     1132         assign
     1133           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     1134         .
     1135         create buffer bh_tbl-name for table v-full-tbl-name .
     1136       end.
     1137       block_where:
     1138       do v-ind = 1 to v-idx-field-qnty by 2
     1139       on error undo, return error
     1140       :
     1141         assign
     1142           v-count-fld = v-count-fld + 1
     1143         .
     1144         if p-key-handle = ?
     1145           and v-count-fld > v-field-num
     1146         then do:
     1147           leave block_where.
     1148         end.
     1149         define variable VfieldKeyTable as handle no-undo.
     1150         assign
     1151           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1152           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     1153         .
     1154         if     bh_tbl-key ne ?
     1155         then do:
     1156            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     1157            if VfieldKeyTable eq ?
     1158            then next block_where.
     1159         end.
     1160         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     1161         then
     1162            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     1163         else
     1164            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     1165         if p-key-handle = ? then do:
     1166           assign
     1167             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     1168           .
     1169         end.
     1170         else do:
     1171           assign
     1172             fh_key = p-key-handle:buffer-field( v-field-name )
     1173           .
     1174           if fh_key = ?
     1175             or not valid-handle( fh_key )
     1176           then do:
     1177             delete object bh_tbl-name.
     1178             if     bh_tbl-key ne ?
     1179             then
     1180                delete object bh_tbl-key.
     1181             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info17, p-key-handle:name, v-field-name ).
     1182           end.
     1183           assign
     1184             v-field-val = fh_key:buffer-value
     1185           .
     1186         end.
     1187         if fh_search:data-type ="character":U then do:
     1188           assign
     1189             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     1190             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     1191             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     1192             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     1193             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     1194             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     1195             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     1196             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     1197             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     1198             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     1199             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     1200             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     1201             v-field-val = substitute( '"&1"', v-field-val )
     1202           .
     1203         end.
     1204         assign
     1205           o-where = substitute( "&1 &2", o-where, v-field-val )
     1206         .
     1207         if v-word-link = "":U then do:
     1208           assign
     1209             v-word-link = "and":U
     1210           .
     1211         end.
     1212       end.
     1213       delete object bh_tbl-name.
     1214       if     bh_tbl-key ne ?
     1215       then
     1216          delete object bh_tbl-key.
     1217       if p-key-handle = ?
     1218         and v-count-fld <> v-field-num
     1219       then do:
     1220         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info17, vTable ).
     1221       end.
     1222     end.
     1223   end procedure.
     1224   procedure gen-hn-keyr-tab :
     1225     define input  parameter i-tableSerach as character no-undo.
     1226     define input  parameter i-tablekey   as character no-undo.
     1227     define input  parameter p-key-rec    as character no-undo.
     1228     define input  parameter p-key-handle as handle    no-undo .
     1229     define input  parameter p-db-name    as character no-undo .
     1230     define input  parameter p-tt-handle  as handle    no-undo .
     1231     define input  parameter p-stts-lock  as integer   no-undo .
     1232     define output parameter o-hn         as handle    no-undo.
     1233     define variable v-full-tbl-name as character no-undo.
     1234     define variable v-where         as character no-undo.
     1235     define variable bh_tbl-name     as handle    no-undo.
     1236     define variable vTable          as character no-undo.
     1237     do
     1238     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1239     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1240     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     1241         run gen-where-keyr-tab(i-tableSerach,
     1242                                i-tablekey,
     1243                                p-key-rec,
     1244                                p-key-handle,
     1245                                p-db-name,
     1246                                p-tt-handle,
     1247                                output v-where).
     1248         if i-tableSerach ne "" and i-tableSerach ne ?
     1249         then do:
     1250            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     1251            create buffer bh_tbl-name for table v-full-tbl-name .
     1252         end.
     1253         else do:
     1254            if p-tt-handle = ? then do:
     1255               assign
     1256                  vTable = entry( 1 , p-key-rec, chr(3) )
     1257               .
     1258               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     1259               create buffer bh_tbl-name for table v-full-tbl-name .
     1260            end.
     1261            else do:
     1262               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1263            end.
     1264         end.
     1265         if p-tt-handle = ? then do:
     1266            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     1267         end.
     1268         else do:
     1269            bh_tbl-name:find-first( v-where ) no-error .
     1270         end.
     1271         o-hn = bh_tbl-name.
     1272      end.
     1273   end procedure.
     1274   procedure gen-hn-keyr :
     1275     define input  parameter p-key-rec    as character no-undo.
     1276     define input  parameter p-key-handle as handle    no-undo .
     1277     define input  parameter p-db-name    as character no-undo .
     1278     define input  parameter p-tt-handle  as handle    no-undo .
     1279     define input  parameter p-stts-lock  as integer   no-undo .
     1280     define output parameter o-hn         as handle    no-undo.
     1281     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     1282   end.
     1283   procedure gen-row-keyr :
     1284     define input  parameter p-key-rec    as character no-undo.
     1285     define input  parameter p-key-handle as handle    no-undo .
     1286     define input  parameter p-db-name    as character no-undo .
     1287     define input  parameter p-tt-handle  as handle    no-undo .
     1288     define input  parameter p-stts-lock  as integer   no-undo .
     1289     define output parameter p-tbl-row    as rowid     no-undo.
     1290     define output parameter p-tbl-name   as character no-undo.
     1291     define variable vHn as handle no-undo.
     1292       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     1293       p-tbl-row = if vHn:available then vHn:rowid else ?.
     1294       p-tbl-name =  vHn:table.
     1295       delete object vHn no-error.
     1296     if p-tbl-row = ? then do:
     1297       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info17, p-tbl-name, p-key-rec ).
     1298     end.
     1299     else do:
     1300       return.
     1301     end.
     1302   end procedure.
     1303   procedure gen-key-fv :
     1304     define input  parameter p-key-rec    as character no-undo .
     1305     define output parameter p-field-list as character no-undo .
     1306     define output parameter p-value-list as character no-undo.
     1307     do
     1308     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1309     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1310     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1311     :
     1312       define variable v-full-tbl-name  as character no-undo .
     1313       define variable bh_tbl-name      as handle    no-undo .
     1314       define variable v-tbl-name       as character no-undo .
     1315       define variable v-field-num      as integer   no-undo .
     1316       define variable v-count-fld      as integer   no-undo .
     1317       define variable v-inform         as character no-undo .
     1318       define variable v-ind            as integer   no-undo .
     1319       define variable v-idx-field-qnty as integer   no-undo .
     1320       define variable v-delim-key      as character no-undo .
     1321       if p-key-rec = ?
     1322         or p-key-rec = "":U
     1323       then do:
     1324         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info17 ).
     1325       end.
     1326       assign
     1327         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1328         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1329       .
     1330       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1331       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info17 ).
     1332       assign
     1333         v-inform = bh_tbl-name:index-information(1)
     1334         v-ind    = 2
     1335       .
     1336       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1337       on error undo, return error
     1338       :
     1339         assign
     1340           v-inform = bh_tbl-name:index-information( v-ind )
     1341           v-ind    = v-ind + 1
     1342         .
     1343       end.
     1344       if v-inform = ?
     1345         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1346         or entry( 3, v-inform, ",":U ) <> "1":U
     1347       then do:
     1348         delete object bh_tbl-name no-error.
     1349         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info17, v-tbl-name ).
     1350       end.
     1351       assign
     1352         v-idx-field-qnty = num-entries( v-inform ) - 4
     1353       .
     1354       if v-idx-field-qnty < 2 then do:
     1355         delete object bh_tbl-name no-error.
     1356         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info17, v-inform, v-tbl-name ).
     1357       end.
     1358       assign
     1359         p-field-list = "":U
     1360         p-value-list = "":U
     1361         v-delim-key  = "":U
     1362         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     1363         v-count-fld  = 0
     1364       .
     1365       block_where:
     1366       do v-ind = 1 to v-idx-field-qnty by 2
     1367       on error undo, return error
     1368       :
     1369         assign
     1370           v-count-fld = v-count-fld + 1
     1371         .
     1372         if v-count-fld > v-field-num then do:
     1373           leave block_where.
     1374         end.
     1375         assign
     1376           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1377           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1378         .
     1379         if v-ind = 1 then do:
     1380           assign
     1381             v-delim-key = chr(3)
     1382           .
     1383         end.
     1384       end.
     1385       delete object bh_tbl-name.
     1386       if v-count-fld <> v-field-num then do:
     1387         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info17, v-tbl-name ).
     1388       end.
     1389     end.
     1390   end procedure.
     1391   procedure gen-key-field :
     1392     define input  parameter p-table      as character no-undo .
     1393     define output parameter p-field-list as character no-undo .
     1394     do
     1395     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1396     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1397     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1398     :
     1399       define variable v-full-tbl-name  as character no-undo .
     1400       define variable bh_tbl-name      as handle    no-undo .
     1401       define variable v-tbl-name       as character no-undo .
     1402       define variable v-field-num      as integer   no-undo .
     1403       define variable v-count-fld      as integer   no-undo .
     1404       define variable v-inform         as character no-undo .
     1405       define variable v-ind            as integer   no-undo .
     1406       define variable v-idx-field-qnty as integer   no-undo .
     1407       define variable v-delim-key      as character no-undo .
     1408       if p-table = ?
     1409         or p-table = "":U
     1410       then do:
     1411         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info17 ).
     1412       end.
     1413       assign
     1414         v-tbl-name      = p-table
     1415         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1416       .
     1417       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1418       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info17 ).
     1419       assign
     1420         v-inform = bh_tbl-name:index-information(1)
     1421         v-ind    = 2
     1422       .
     1423       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1424       on error undo, return error
     1425       :
     1426         assign
     1427           v-inform = bh_tbl-name:index-information( v-ind )
     1428           v-ind    = v-ind + 1
     1429         .
     1430       end.
     1431       if v-inform = ?
     1432         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1433         or entry( 3, v-inform, ",":U ) <> "1":U
     1434       then do:
     1435         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info17, v-tbl-name ).
     1436       end.
     1437       assign
     1438         v-idx-field-qnty = num-entries( v-inform ) - 4
     1439       .
     1440       if v-idx-field-qnty < 2 then do:
     1441         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info17, v-inform, v-tbl-name ).
     1442       end.
     1443       assign
     1444         p-field-list = "":U
     1445         v-delim-key  = "":U
     1446         v-count-fld  = 0
     1447       .
     1448       block_where:
     1449       do v-ind = 1 to v-idx-field-qnty by 2
     1450       on error undo, return error
     1451       :
     1452         assign
     1453           v-count-fld = v-count-fld + 1
     1454         .
     1455         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1456         if v-ind = 1 then do:
     1457           assign
     1458             v-delim-key = chr(3)
     1459           .
     1460         end.
     1461       end.
     1462       delete object bh_tbl-name.
     1463     end.
     1464   end procedure.
     1465   procedure get-gate-file-name :
     1466   define input parameter p-gate-rec as character no-undo .
     1467   define output  parameter p-gate-file-name as character no-undo .
     1468   define buffer buf_clob-data for ub.clob-data.
     1469   define variable v-tbl-row as rowid no-undo .
     1470   define variable v-tbl-name as character no-undo .
     1471   run gen-row-keyr in this-procedure ( input p-gate-rec
     1472                                       ,input ?
     1473                                       ,input "ub"
     1474                                       ,input ?
     1475                                       ,input no-lock
     1476                                       ,output v-tbl-row
     1477                                       ,output v-tbl-name) no-error.
     1478   if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
     1479                                                           ,vss-include-info15
     1480                                                           ,p-gate-rec).
     1481   find first buf_clob-data no-lock where
     1482             rowid(buf_clob-data) = v-tbl-row no-error.
     1483   if not available buf_clob-data then do:
     1484     if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
     1485                                                             ,vss-include-info15
     1486                                                             ,p-gate-rec).
     1487   end.
     1488   p-gate-file-name = buf_clob-data.file-name.
     1489   end procedure.
     1490   procedure get-gate-rec :
     1491   define input  parameter p-gate-name as character no-undo .
     1492   define output parameter p-gate-rec as character no-undo .
     1493   define buffer buf_clob-bind for ub.clob-bind.
     1494   define buffer buf_clob-data for ub.clob-data.
     1495   main-block:
     1496   do
     1497   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info15, return-value, chr(10), error-status :get-message (1))
     1498   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info15 )
     1499   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info15 )
     1500   :
     1501       find first buf_clob-bind no-lock where
     1502                 buf_clob-bind.uniq-key-rec = p-gate-name
     1503             and buf_clob-bind.field-name = '':U
     1504             and buf_clob-bind.part-num = 1
     1505             and buf_clob-bind.resource-type = 'gate':U
     1506             no-error.
     1507       if not available buf_clob-bind then do:
     1508         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
     1509                                         , p-gate-name
     1510                                         ).
     1511       end.
     1512       find first buf_clob-data no-lock where
     1513                 buf_clob-data.db-num = buf_clob-bind.db-num
     1514             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
     1515       if not available buf_clob-data then do:
     1516         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     1517                                         , buf_clob-bind.db-num
     1518                                         , buf_clob-bind.int64-id
     1519                                         , p-gate-name
     1520                                         ).
     1521       end.
     1522       run gen-key-rec in this-procedure ( input 'clob-data':U
     1523                                 ,input buffer buf_clob-data:handle
     1524                                 ,output p-gate-rec).
     1525   end.
     1526   end procedure.
     1527   procedure get-gate-by-name :
     1528   define input  parameter p-gate-name as character no-undo .
     1529   define output parameter p-gate-rec as character no-undo .
     1530   define output parameter p-dsh as handle no-undo .
     1531   define input-output  parameter p-xmlh as handle no-undo .
     1532   define variable v-ii as integer   no-undo .
     1533   define variable glog as logical   no-undo .
     1534   define variable v-longchar as longchar no-undo .
     1535   define variable v-txmlh as handle no-undo .
     1536   define variable v-db-num as integer no-undo .
     1537   define variable v-int64-id as int64 no-undo .
     1538   define buffer buf_clob-bind for ub.clob-bind.
     1539   define buffer buf_clob-data for ub.clob-data.
     1540   main-block:
     1541   do
     1542   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info15, return-value, chr(10), error-status :get-message (1))
     1543   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info15 )
     1544   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info15 )
     1545   :
     1546       find first buf_clob-bind no-lock where
     1547                 buf_clob-bind.uniq-key-rec = p-gate-name
     1548             and buf_clob-bind.field-name = '':U
     1549             and buf_clob-bind.part-num = 1
     1550             and buf_clob-bind.resource-type = 'gate':U
     1551             no-error.
     1552       if not available buf_clob-bind then do:
     1553         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
     1554                                         , p-gate-name
     1555                                         ).
     1556       end.
     1557       find first buf_clob-data no-lock where
     1558                 buf_clob-data.db-num = buf_clob-bind.db-num
     1559             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
     1560       if not available buf_clob-data then do:
     1561         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     1562                                         , buf_clob-bind.db-num
     1563                                         , buf_clob-bind.int64-id
     1564                                         , p-gate-name
     1565                                         ).
     1566       end.
     1567       assign
     1568       v-longchar = buf_clob-data.cdata
     1569       .
     1570       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1571       if error-status :error then do:
     1572         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1573       end.
     1574       create dataset p-dsh .
     1575       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     1576                                     , v-longchar
     1577                                     , ?
     1578                                     , ?
     1579                                     , ?
     1580                                     ) no-error.
     1581       v-longchar = '':U.
     1582       if error-status :error
     1583       or not glog
     1584       then do:
     1585         undo, return error substitute("Не удалось прочитать XML-схему &1 из БД:&2&3", p-gate-name, chr(10), error-status:get-message(1) ).
     1586       end.
     1587       if not valid-handle(p-xmlh)
     1588       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1589         create temp-table v-txmlh.
     1590         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1591         v-txmlh:temp-table-prepare("temp-xml-tables").
     1592         p-xmlh = v-txmlh:default-buffer-handle.
     1593       end.
     1594       run gen-key-rec in this-procedure ( input 'clob-data':U
     1595                                 ,input buffer buf_clob-data:handle
     1596                                 ,output p-gate-rec).
     1597       do v-ii = 1 to p-dsh:num-buffers:
     1598         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1599         if not p-xmlh:available then do:
     1600           p-xmlh:buffer-create().
     1601           assign
     1602           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1603           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1604           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1605           p-xmlh::gate-handle_ = p-dsh
     1606           p-xmlh::uniq-gate-rec = p-gate-rec
     1607           p-xmlh::gate-name = p-dsh:name
     1608           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1609           .
     1610           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1611             assign
     1612             p-xmlh::order = -3.
     1613           end.
     1614         end.
     1615       end.
     1616   end.
     1617   end procedure.
     1618   procedure get-gate-by-rec :
     1619   define input  parameter p-gate-rec as character no-undo .
     1620   define output parameter p-dsh as handle no-undo .
     1621   define input-output  parameter p-xmlh as handle no-undo .
     1622   define input-output parameter p-longchar  as longchar no-undo .
     1623   define variable v-ii as integer   no-undo .
     1624   define variable glog as logical   no-undo .
     1625   define variable v-rowid as rowid no-undo .
     1626   define variable v-tbl-name as character no-undo .
     1627   define variable v-longchar as longchar no-undo .
     1628   define variable v-txmlh as handle no-undo .
     1629   define buffer buf_clob-data for ub.clob-data.
     1630   main-block:
     1631   do
     1632   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info15, return-value, chr(10), error-status :get-message (1))
     1633   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info15 )
     1634   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info15 )
     1635   :
     1636     run gen-row-keyr in this-procedure (
     1637                                           input  p-gate-rec
     1638                                           ,input  ?
     1639                                           ,input  "ub"
     1640                                           ,input  ?
     1641                                           ,input  NO-LOCK
     1642                                           ,output v-rowid
     1643                                           ,output v-tbl-name   ) no-error.
     1644       find first buf_clob-data no-lock where
     1645                 rowid(buf_clob-data) = v-rowid  no-error.
     1646       if not available buf_clob-data then do:
     1647         undo, return error substitute("Не найден CLOB  &1"
     1648                                         , p-gate-rec
     1649                                         ).
     1650       end.
     1651       assign
     1652       v-longchar = buf_clob-data.cdata
     1653       .
     1654       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1655       if error-status :error then do:
     1656         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1657       end.
     1658       create dataset p-dsh .
     1659       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     1660                                     , v-longchar
     1661                                     , ?
     1662                                     , ?
     1663                                     , ?
     1664                                     ) no-error.
     1665       define variable v-esm as character no-undo .
     1666       v-esm = error-status:get-message(1) .
     1667       if p-longchar <> ? then do:
     1668         p-longchar = v-longchar.
     1669       end.
     1670       v-longchar = '':U.
     1671       if error-status :error
     1672       or not glog
     1673       then do:
     1674         undo, return error substitute("Не удалось прочитать XML-схему &1 (&2) из БД&3&4"
     1675                                      , p-gate-rec
     1676                                      , p-gate-rec
     1677                                      , v-esm
     1678                                      ).
     1679       end.
     1680       p-dsh:private-data = buf_clob-data.file-name_ + chr(4) + p-gate-rec.
     1681       if not valid-handle(p-xmlh)
     1682       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1683         create temp-table v-txmlh.
     1684         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1685         v-txmlh:temp-table-prepare("temp-xml-tables").
     1686         p-xmlh = v-txmlh:default-buffer-handle.
     1687       end.
     1688       do v-ii = 1 to p-dsh:num-buffers:
     1689         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1690         if not p-xmlh:available then do:
     1691           p-xmlh:buffer-create().
     1692           assign
     1693           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1694           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1695           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1696           p-xmlh::gate-handle_ = p-dsh
     1697           p-xmlh::uniq-gate-rec = p-gate-rec
     1698           p-xmlh::gate-name = p-dsh:name
     1699           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1700           .
     1701           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1702             assign
     1703             p-xmlh::order = -3.
     1704           end.
     1705           p-xmlh:buffer-release().
     1706         end.
     1707       end.
     1708   end.
     1709   end procedure.
     1710   procedure get-gate-by-file :
     1711   define input  parameter p-schema-file-name as character no-undo .
     1712   define input  parameter p-gate-rec as character no-undo .
     1713   define output parameter p-dsh as handle no-undo .
     1714   define input-output  parameter p-xmlh as handle no-undo .
     1715   define variable v-ii as integer   no-undo .
     1716   define variable glog as logical   no-undo .
     1717   define variable v-rowid as rowid no-undo .
     1718   define variable v-tbl-name as character no-undo .
     1719   define variable v-longchar as longchar no-undo .
     1720   define variable v-txmlh as handle no-undo .
     1721   main-block:
     1722   do
     1723   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info15, return-value, chr(10), error-status :get-message (1))
     1724   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info15 )
     1725   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info15 )
     1726   :
     1727       COPY-LOB
     1728       FROM  FILE p-schema-file-name
     1729       TO  OBJECT v-longchar
     1730       no-convert
     1731       NO-ERROR .
     1732       if error-status :error then do:
     1733           undo, return error substitute("Не удалось считать файл схемы &1 в память&2&3"
     1734                                     , p-schema-file-name
     1735                                 , chr(10)
     1736                                 , error-status:get-message(1) ).
     1737       end.
     1738       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1739       if error-status :error then do:
     1740         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, p-schema-file-name, chr(10), error-status:get-message(1) , return-value ).
     1741       end.
     1742       create dataset p-dsh .
     1743       glog = p-dsh:READ-XMLSCHEMA( "longchar"
     1744                                     , v-longchar
     1745                                     , ?
     1746                                     , ?
     1747                                     , ?
     1748                                     ) no-error.
     1749       v-longchar = ''.
     1750       if error-status :error
     1751       or not glog
     1752       then do:
     1753         undo, return error substitute("Не удалось прочитать XML-схему из файла &1&2&3"
     1754                                      , p-schema-file-name
     1755                                      ,chr(10)
     1756                                      , error-status:get-message(1)
     1757                                      ).
     1758       end.
     1759       if not valid-handle(p-xmlh)
     1760       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1761         create temp-table v-txmlh.
     1762         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1763         v-txmlh:temp-table-prepare("temp-xml-tables").
     1764         p-xmlh = v-txmlh:default-buffer-handle.
     1765       end.
     1766       do v-ii = 1 to p-dsh:num-buffers:
     1767         p-xmlh:find-first(substitute(' where tbl-name = "&1" and  uniq-gate-rec = "&2" '
     1768                                      ,p-dsh:get-buffer-handle(v-ii):name
     1769                                      ,p-gate-rec
     1770                                      )) no-error.
     1771         if not p-xmlh:available then do:
     1772           p-xmlh:buffer-create().
     1773           assign
     1774           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):table
     1775           p-xmlh::uniq-gate-rec = p-gate-rec
     1776           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1777           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1778           p-xmlh::gate-handle_ = p-dsh
     1779           p-xmlh::gate-name = p-dsh:name
     1780           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1781           .
     1782           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1783             assign
     1784             p-xmlh::order = -3.
     1785           end.
     1786           p-xmlh:buffer-release().
     1787         end.
     1788       end.
     1789   end.
     1790   end procedure.
     1791   procedure gate-clear :
     1792   define input  parameter p-dsh as handle no-undo .
     1793   define input  parameter p-xmlh as handle no-undo .
     1794   define variable v-dsh as handle no-undo .
     1795   define variable v-th as handle no-undo .
     1796     do
     1797     on error undo, return error return-value
     1798     :
     1799       if valid-handle(p-dsh) then do:
     1800         delete object p-dsh.
     1801         v-dsh = p-dsh.
     1802         p-dsh = ?.
     1803       end.
     1804       repeat while true:
     1805         p-xmlh:find-first( substitute( " where gate-handle_ = &1 ", v-dsh)
     1806                            , share-lock) no-error.
     1807         if p-xmlh:available then do:
     1808           assign
     1809           v-th = p-xmlh:buffer-field("table-handle_"):buffer-value.
     1810           if valid-handle(p-xmlh:buffer-field("table-handle_"))
     1811           and valid-handle(v-th)
     1812           and v-th:dynamic = yes
     1813           then do:
     1814             delete object p-xmlh:buffer-field("table-handle_"):buffer-value.
     1815             p-xmlh:buffer-field("table-handle_"):buffer-value = ?.
     1816           end.
     1817           p-xmlh:buffer-delete().
     1818         end.
     1819         else do:
     1820           leave.
     1821         end.
     1822       end.
     1823       if p-xmlh:dynamic = yes
     1824       and valid-handle(p-xmlh)
     1825       then do:
     1826         delete object p-xmlh:table-handle.
     1827         p-xmlh = ?.
     1828       end.
     1829       v-dsh = ?.
     1830     end.
     1831   end procedure.
     1832   procedure all-gates-clear :
     1833   define parameter buffer buf_temp-xml-tables for temp-xml-tables.
     1834   do
     1835   on error undo, return error
     1836   :
     1837     for each buf_temp-xml-tables
     1838     break
     1839     by buf_temp-xml-tables.uniq-gate-rec
     1840     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1841     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1842     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1843     :
     1844         if first-of(buf_temp-xml-tables.uniq-gate-rec) then do:
     1845           delete object buf_temp-xml-tables.gate-handle_.
     1846           buf_temp-xml-tables.gate-handle_ = ?.
     1847         end.
     1848         if valid-handle(buf_temp-xml-tables.table-handle_)
     1849         and buf_temp-xml-tables.table-handle_:dynamic = no
     1850         then do:
     1851           delete object buf_temp-xml-tables.table-handle_.
     1852           buf_temp-xml-tables.table-handle_ = ?.
     1853         end.
     1854         delete buf_temp-xml-tables.
     1855     end.
     1856   end.
     1857   end procedure.
     1858   procedure fix-schemalocation :
     1859   define input-output  parameter p-longchar as longchar no-undo .
     1860   DEFINE VARIABLE hdoc AS HANDLE.
     1861   DEFINE VARIABLE hroot AS HANDLE.
     1862   DEFINE VARIABLE hnode-child AS HANDLE.
     1863   DEFINE VARIABLE hnode-attr AS HANDLE.
     1864   define variable v-jj as integer   no-undo .
     1865   define variable ok as logical   no-undo .
     1866   define variable v-path1                    as character                no-undo .
     1867   DEFINE VARIABLE v-full-path1               as character                no-undo .
     1868   DEFINE VARIABLE v-file-name1               as character                no-undo .
     1869   DEFINE VARIABLE v-file-name-no-ext1        as character                no-undo .
     1870   DEFINE VARIABLE v-file-name-ext1           as character                no-undo .
     1871   define variable v-schema-location          as character                no-undo .
     1872   do
     1873   on error undo, return error return-value
     1874   :
     1875     CREATE X-DOCUMENT hdoc.
     1876     CREATE X-noderef hroot.
     1877     CREATE X-noderef hnode-child.
     1878     CREATE X-noderef hnode-attr.
     1879     hdoc:load("longchar", p-longchar, no) no-error.
     1880     iF ERROR-STATUS:GET-MESSAGE(1) <> '' THEN message ERROR-STATUS:GET-MESSAGE(1) view-as alert-box .
     1881     hdoc:get-document-element(hroot).
     1882     _repeat:
     1883     REPEAT v-jj = 1 TO hroot:NUM-CHILDREN:
     1884       ok = hroot:GET-CHILD(hNode-Child, v-jj).
     1885       if not ok then next.
     1886       if hNode-Child:local-name = "include"
     1887       then do:
     1888         ok = hNode-Child:GET-ATTRIBUTE-NODE( hnode-attr, "schemaLocation" ).
     1889           v-schema-location = hnode-attr:node-value.
     1890           run gbl/filename.p (
     1891                           input "exe/" + hnode-attr:node-value
     1892                         ,output v-full-path1
     1893                         ,output v-path1
     1894                         ,output v-file-name1
     1895                         ,output v-file-name-no-ext1
     1896                         ,output v-file-name-ext1
     1897                         ) no-error .
     1898           if error-status :error then do:
     1899             delete object hnode-attr.
     1900             delete object hnode-child.
     1901             delete object hroot.
     1902             delete object hdoc.
     1903             undo, return error substitute("Не удалось определить расположение схемы &1", v-schema-location).
     1904           end.
     1905         ok = hNode-Child:sET-ATTRIBUTE(  "schemaLocation", v-full-path1 ).
     1906         leave  _repeat.
     1907       end.
     1908     END.
     1909     hdoc:save("longchar", p-longchar).
     1910     delete object hnode-attr.
     1911     delete object hnode-child.
     1912     delete object hroot.
     1913     delete object hdoc.
     1914   end.
     1915   end procedure.
     1916   procedure gate-clb_fill-xml-tables :
     1917   define input parameter p-dsh as handle no-undo .
     1918   define input-output parameter p-xmlh as handle no-undo .
     1919   define variable v-ii as integer no-undo .
     1920     do
     1921     on error undo, return error
     1922     :
     1923       do v-ii = 1 to p-dsh:num-buffers:
     1924         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1925         if not p-xmlh:available then do:
     1926           p-xmlh:buffer-create().
     1927           assign
     1928           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1929           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1930           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1931           p-xmlh::gate-handle_ = p-dsh
     1932           p-xmlh::uniq-gate-rec = entry(2, p-dsh:private-data, chr(4))
     1933           p-xmlh::gate-name = p-dsh:name
     1934           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1935           .
     1936           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1937             assign
     1938             p-xmlh::order = -3.
     1939           end.
     1940           p-xmlh:buffer-release().
     1941         end.
     1942       end.
     1943     end.
     1944   end procedure.
     1945   procedure all-gates-empty :
     1946   define buffer buf_temp-xml-tables for temp-xml-tables.
     1947   do
     1948   on error undo, return error
     1949   :
     1950     for each buf_temp-xml-tables
     1951     break
     1952     by buf_temp-xml-tables.uniq-gate-rec
     1953     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1954     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1955     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1956     :
     1957       if valid-handle(buf_temp-xml-tables.tbl-handle_) then do:
     1958         buf_temp-xml-tables.tbl-handle_:empty-temp-table().
     1959       end.
     1960     end.
     1961   end.
     1962   end procedure.
     1963   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1964   define new global shared variable g#trdcalib as handle no-undo.
     1965   define shared stream  PrnLibstream.
     1966   define variable pol1  as character no-undo .
     1967   define variable pol2  as decimal   no-undo .
     1968   define variable pol3  as decimal   no-undo .
     1969   define variable pol4  as character no-undo .
     1970   define variable pol5  as integer   no-undo .
     1971   define variable pol6  as character no-undo .
     1972   define variable pol7  as decimal   no-undo .
     1973   define variable pol8  as decimal   no-undo .
     1974   define variable pol9  as character no-undo .
     1975   define variable pol10 as decimal   no-undo .
     1976   define variable pol11 as decimal   no-undo .
     1977   define variable pol11_1 as decimal   no-undo .
     1978   define variable pol11_2 as decimal   no-undo .
     1979   define variable pol11_3 as decimal   no-undo .
     1980   define variable pol12 as decimal   no-undo .
     1981   define variable pol13 as decimal   no-undo .
     1982   define variable pol6-excel as character no-undo .
     1983   define variable line          as character no-undo .
     1984   DEFINE VARIABLE areal-is-pay-qnty1 as decimal no-undo.
     1985   DEFINE VARIABLE areal-is-pay-netto as decimal no-undo.
     1986   DEFINE VARIABLE areal-no-pay-qnty1 as decimal no-undo.
     1987   DEFINE VARIABLE areal-no-pay-netto as decimal no-undo.
     1988   DEFINE VARIABLE areal-qnty1   as decimal   no-undo.
     1989   DEFINE VARIABLE areal-netto   as decimal   no-undo.
     1990   DEFINE VARIABLE aincome-qnty1 as decimal   no-undo.
     1991   DEFINE VARIABLE aincome-netto as decimal   no-undo.
     1992   DEFINE VARIABLE loc-real-ii   as integer   no-undo.
     1993   DEFINE VARIABLE curr-real-ii  as integer   no-undo.
     1994   DEFINE VARIABLE tovar-ii      as integer   no-undo.
     1995   DEFINE VARIABLE loc-income-ii as integer   no-undo.
     1996   DEFINE VARIABLE jj            as integer   no-undo.
     1997   DEFINE VARIABLE loc-jj        as integer   no-undo.
     1998   DEFINE VARIABLE main-line     as logical   no-undo.
     1999   DEFINE VARIABLE supp-line     as logical   no-undo.
     2000   DEFINE VARIABLE pay-line      as logical   no-undo.
     2001   DEFINE VARIABLE rc            as recid     no-undo.
     2002   DEFINE VARIABLE accum-2       as decimal   no-undo.
     2003   DEFINE VARIABLE accum-3       as decimal   no-undo.
     2004   DEFINE VARIABLE accum-7       as decimal   no-undo.
     2005   DEFINE VARIABLE accum-8       as decimal   no-undo.
     2006   DEFINE VARIABLE accum-10      as decimal   no-undo.
     2007   DEFINE VARIABLE accum-11      as decimal   no-undo.
     2008   DEFINE VARIABLE accum-12      as decimal   no-undo.
     2009   DEFINE VARIABLE accum-13      as decimal   no-undo.
     2010   DEFINE VARIABLE acii          as integer   no-undo .
     2011   define variable v-attr-value  as character no-undo .
     2012   define variable v-attr-type   as character no-undo .
     2013   define buffer buf_shift-grp     for shift-grpt.
     2014   define buffer buf_shift-grp-in  for shift-grp-int.
     2015   define buffer buf_shift-grp-out for shift-grp-outt.
     2016   define buffer buf_cash-pay      for ub.cash-pay.
     2017     procedure on-same-page :
     2018       define input parameter p-line-number as integer no-undo .
     2019       if p-line-number > page-size( PrnLibstream )
     2020       then do:
     2021         return .
     2022       end.
     2023       if line-counter( PrnLibstream ) + p-line-number > page-size( PrnLibstream )
     2024       then do:
     2025         page stream PrnLibstream .
     2026       end.
     2027     end procedure.
     2028   run rep/r-shft3r.p
     2029                   (input p-obj-type,
     2030                    input p-obj-code,
     2031                    input X-date-Start,
     2032                    input X-Shift-Start,
     2033                    input X-date-End,
     2034                    input X-Shift-End,
     2035                    input pClassify,
     2036                    input pSorttype,
     2037                    input ptog-lavel,
     2038                    input pvar-lavel,
     2039                    input p-previous-shift-date,
     2040                    input p-batch
     2041                    ) no-error.
     2042       output stream OutStr-html to value(v-report-name-html) append convert target 'UTF-8' .
     2043           put stream OutStr-html unformatted
     2044               substitute (
     2045             '<tbody> <!-- Здесь начинается таблица отчета -->
     2046               <tr>
     2047                   <th colspan="3" style="text-align: center;">Информация о товаре</th>
     2048                   <th colspan="4" style="text-align: center;">Расшифровка поступления</th>
     2049                   <th colspan="6" style="text-align: center;">Расшифровка реализации</th>
     2050                   <th colspan="2" style="text-align: center;">Остаток на конец</th>
     2051               </tr>
     2052               <tr>
     2053                   <th rowspan="2" style="text-align: center;">Наименование группа товаров</th>
     2054                   <th colspan="2" style="text-align: center;">Остаток на начало</th>
     2055                   <th style="text-align: center;">Поставщик</th>
     2056                   <th rowspan="2" style="text-align: center;">Номер документа прихода (ТТН)</th>
     2057                   <th colspan="2" style="text-align: center;">Поступило</th>
     2058                   <th rowspan="2" style="text-align: center;">Тип расхода (тип платежа)</th>
     2059                   <th rowspan="2" style="text-align: center;">Кол-во</th>
     2060                   <th rowspan="2" style="text-align: center;">Сумма (цены документа)</th>
     2061                   <th rowspan="2" style="text-align: center;">Сумма скидки</th>
     2062                   <th rowspan="2" style="text-align: center;">Сумма брутто</th>
     2063                   <th rowspan="2" style="text-align: center;">Кол-во покупок</th>
     2064                   <th rowspan="2" style="text-align: center;">Кол-во</th>
     2065                   <th rowspan="2" style="text-align: center;">Сумма (прод. цены)</th>
     2066               </tr>
     2067               <tr>
     2068                   <th style="text-align: center;">Кол-во</th>
     2069                   <th style="text-align: center;">Сумма (прод. цены)</th>
     2070                   <th style="text-align: center;">Наименование</th>
     2071                   <th style="text-align: center;">Кол-во</th>
     2072                   <th style="text-align: center;">Сумма (учет. цены)</th>
     2073               </tr>
     2074               <tr>
     2075                   <th style="text-align: center;">3.1</th>
     2076                   <th style="text-align: center;">3.2</th>
     2077                   <th style="text-align: center;">3.3</th>
     2078                   <th style="text-align: center;">3.4</th>
     2079                   <th style="text-align: center;">3.5</th>
     2080                   <th style="text-align: center;">3.6</th>
     2081                   <th style="text-align: center;">3.7</th>
     2082                   <th style="text-align: center;">3.8</th>
     2083                   <th style="text-align: center;">3.9</th>
     2084                   <th style="text-align: center;">3.10</th>
     2085                   <th style="text-align: center;">3.11</th>
     2086                   <th style="text-align: center;">3.12</th>
     2087                   <th style="text-align: center;">3.13</th>
     2088                   <th style="text-align: center;">3.14</th>
     2089                   <th style="text-align: center;">3.15</th>
     2090               </tr>
     2091               '
     2092               , chr(123), chr(125)
     2093           ).
     2094   for each actreal-3:
     2095     delete actreal-3.
     2096   end.
     2097   FOR EACH t-3 where (pclassify <> "totals":U or t-3.grp-code-sheet = 0) use-index pi:
     2098     assign
     2099     areal-is-pay-qnty1 = 0
     2100     areal-is-pay-netto = 0
     2101     areal-no-pay-qnty1 = 0
     2102     areal-no-pay-netto = 0
     2103     areal-qnty1 = 0
     2104     areal-netto = 0
     2105     aincome-qnty1 = 0
     2106     aincome-netto = 0
     2107     loc-real-ii = 1
     2108     curr-real-ii = 1
     2109     loc-income-ii = 0
     2110     .
     2111     FIND LAST treal-3 No-LOCK WHERE
     2112               treal-3.grp-code-sheet = t-3.grp-code-sheet AND
     2113               treal-3.is-pay = yes use-index vi No-ERROR.
     2114     if avail treal-3 then
     2115     assign
     2116     loc-real-ii = treal-3.ii + 1
     2117     curr-real-ii = treal-3.ii + 1
     2118     .
     2119     IF can-find(first treal-3 WHERE
     2120                       treal-3.grp-code-sheet = t-3.grp-code-sheet) then do:
     2121       FOR EACh  treal-3 where
     2122                 treal-3.grp-code-sheet = t-3.grp-code-sheet use-index pi:
     2123       if treal-3.discnt-type = -99 or treal-3.cpay-code < 0 then do:
     2124         assign
     2125         areal-qnty1 = areal-qnty1 + treal-3.qnty1
     2126         areal-netto = areal-netto + treal-3.netto
     2127         .
     2128         if treal-3.is-pay then
     2129         assign
     2130         areal-is-pay-qnty1 = areal-is-pay-qnty1 + round(treal-3.qnty1,2)
     2131         areal-is-pay-netto = areal-is-pay-netto + round(treal-3.netto,2)
     2132         .
     2133         else
     2134         assign
     2135         rc = recid(treal-3)
     2136         curr-real-ii = (if curr-real-ii = loc-real-ii AND
     2137                            (loc-real-ii > 1   OR
     2138                             can-find(first treal-3 No-LOCK WHERE
     2139                                            treal-3.grp-code-sheet = t-3.grp-code-sheet AND
     2140                                            treal-3.is-pay = no AND
     2141                                            recid(treal-3) <> rc)
     2142                             )
     2143                         then (curr-real-ii + 1)
     2144                         else curr-real-ii
     2145                        )
     2146         treal-3.ii = curr-real-ii
     2147         curr-real-ii = curr-real-ii + 1
     2148         areal-no-pay-qnty1 = areal-no-pay-qnty1 + round(treal-3.qnty1,2)
     2149         areal-no-pay-netto = areal-no-pay-netto + round(treal-3.netto,2)
     2150         .
     2151         end.
     2152       END.
     2153       if curr-real-ii > 2 then do:
     2154         run create-treal-3 (
     2155                             INPUT t-3.grp-code-sheet,
     2156                             INPUT 0,
     2157                             INPUT 0,
     2158                             INPUT areal-is-pay-qnty1,
     2159                             INPUT areal-is-pay-netto,
     2160                             INPUT "ИТОГО ОПЛАЧ.РАСХОД",
     2161                             INPUT yes,
     2162                             INPUT loc-real-ii) no-error.
     2163         if loc-real-ii = curr-real-ii then
     2164         curr-real-ii = curr-real-ii + 1.
     2165         run create-treal-3 (
     2166                             INPUT t-3.grp-code-sheet,
     2167                             INPUT 0,
     2168                             INPUT 0,
     2169                             INPUT areal-no-pay-qnty1,
     2170                             INPUT areal-no-pay-netto,
     2171                             INPUT "ИТОГО ПРОЧ.РАСХОДОВ",
     2172                             INPUT no,
     2173                             INPUT curr-real-ii) no-error.
     2174         curr-real-ii = curr-real-ii + 1.
     2175         run create-treal-3 (
     2176                             INPUT t-3.grp-code-sheet,
     2177                             INPUT 0,
     2178                             INPUT 0,
     2179                             INPUT areal-qnty1,
     2180                             INPUT areal-netto,
     2181                             INPUT "ВСЕГО  РАСХОД",
     2182                             INPUT ?,
     2183                             INPUT curr-real-ii) no-error.
     2184       END.
     2185       else curr-real-ii = 1.
     2186     END.
     2187     FOR EACh  tincome-3 where
     2188               tincome-3.grp-code-sheet = t-3.grp-code-sheet use-index vi:
     2189       assign
     2190       aincome-qnty1 = aincome-qnty1 + tincome-3.qnty1
     2191       aincome-netto = aincome-netto + tincome-3.netto
     2192       loc-income-ii = tincome-3.ii
     2193       .
     2194     END.
     2195     if loc-income-ii > 1 then do:
     2196       run create-tincome-3 (
     2197                           INPUT t-3.grp-code-sheet,
     2198                           INPUT "",
     2199                           INPUT aincome-qnty1,
     2200                           INPUT aincome-netto,
     2201                           INPUT "ИТОГО ПОСТУПЛЕНИЙ",
     2202                           INPUT 0,
     2203                           INPUT no,
     2204                           INPUT (loc-income-ii + 1)) no-error .
     2205       loc-income-ii = loc-income-ii + 1.
     2206     END.
     2207     assign
     2208     tovar-ii = 1
     2209     t-3.lines = MAX(curr-real-ii, loc-income-ii, tovar-ii, 1 )
     2210     .
     2211   END.
     2212   FOR EACH t-3 No-LOCK WHERE (pclassify <> "totals":U or t-3.grp-code-sheet = 0)
     2213       break by grp-name:
     2214     DO jj = 1 to t-3.lines :
     2215       assign
     2216       pol1 = ""
     2217       pol2 = 0
     2218       pol3 = 0
     2219       pol4 = ""
     2220       pol5 = 0
     2221       pol6 = ""
     2222       pol7 = 0
     2223       pol8 = 0
     2224       pol9 = ""
     2225       pol10 = 0
     2226       pol11 = 0
     2227       pol11_1 = 0
     2228       pol11_2 = 0
     2229       pol11_3 = 0
     2230       pol12 = 0
     2231       pol13 = 0
     2232       main-line = no
     2233       supp-line = no
     2234       pay-line = no
     2235       .
     2236       if p-param and (t-3.qnty1-before <> 0 or t-3.qnty1-after <> 0) then do:
     2237       IF jj = 1 then do:
     2238         assign
     2239         pol1 = t-3.grp-name
     2240         pol2 = t-3.qnty1-before
     2241         pol3 = t-3.netto-before
     2242         pol12 = t-3.qnty1-after
     2243         pol13 = t-3.netto-after
     2244         main-line = yes
     2245         .
     2246       END.
     2247       FIND FIRST tincome-3 No-LOCK WHERE
     2248                  tincome-3.grp-code-sheet = t-3.grp-code-sheet AND
     2249                  tincome-3.ii = jj No-ERROR.
     2250       FIND FIRST treal-3 No-LOCK WHERE
     2251                  treal-3.grp-code-sheet = t-3.grp-code-sheet AND
     2252                  treal-3.ii = jj No-ERROR.
     2253       if p-batch > 0
     2254       and (available tincome-3
     2255       or available treal-3)
     2256       then do:
     2257         find first buf_shift-grp where
     2258                   buf_shift-grp.obj-type = p-obj-type
     2259               and buf_shift-grp.obj-code = p-obj-code
     2260               and buf_shift-grp.shift-date = x-date-end
     2261               and buf_shift-grp.shift-num = x-shift-end
     2262               and buf_shift-grp.grp-code = t-3.grp-code-sheet no-error.
     2263         if not available buf_shift-grp then do:
     2264           create buf_shift-grp.
     2265           assign
     2266           buf_shift-grp.obj-type = p-obj-type
     2267           buf_shift-grp.obj-code = p-obj-code
     2268           buf_shift-grp.shift-date = x-date-end
     2269           buf_shift-grp.shift-num = x-shift-end
     2270           buf_shift-grp.grp-code = t-3.grp-code-sheet
     2271           buf_shift-grp.full-grp-name = t-3.grp-name
     2272           buf_shift-grp.start-qnty = t-3.qnty1-before
     2273           buf_shift-grp.end-qnty = t-3.qnty1-after
     2274           buf_shift-grp.start-sum = t-3.netto-before
     2275           buf_shift-grp.end-sum = t-3.netto-after
     2276           .
     2277         end.
     2278       end.
     2279       IF AVAIl tincome-3 then do:
     2280   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input tincome-3.doc-code ,
     2281                           input 'nids':U ,
     2282                          output v-attr-value ,
     2283                          output v-attr-type )  .
     2284         assign
     2285           pol6 = if v-attr-value = "" or v-attr-value = ?
     2286                  then tincome-3.doc-code
     2287                  else v-attr-value
     2288           pol6-excel = if v-attr-value = "" or v-attr-value = ?
     2289                  then tincome-3.doc-code
     2290                  else '="' + v-attr-value + '"'
     2291         .
     2292         assign
     2293         pol4 = tincome-3.supp-name
     2294         pol5 = tincome-3.supp-code
     2295         pol7 = tincome-3.qnty1
     2296         pol8 = tincome-3.netto
     2297         supp-line = yes
     2298         .
     2299           find first buf_shift-grp-in where
     2300                     buf_shift-grp-in.obj-type = p-obj-type
     2301                 and buf_shift-grp-in.obj-code = p-obj-code
     2302                 and buf_shift-grp-in.shift-date = x-date-end
     2303                 and buf_shift-grp-in.shift-num = x-shift-end
     2304                 and buf_shift-grp-in.grp-code = tincome-3.grp-code-sheet
     2305                 and buf_shift-grp-in.doc-code = tincome-3.doc-code   no-error.
     2306           if not available buf_shift-grp-in then do:
     2307             create buf_shift-grp-in.
     2308             assign
     2309             buf_shift-grp-in.obj-type = p-obj-type
     2310             buf_shift-grp-in.obj-code = p-obj-code
     2311             buf_shift-grp-in.shift-date = x-date-end
     2312             buf_shift-grp-in.shift-num = x-shift-end
     2313             buf_shift-grp-in.grp-code = tincome-3.grp-code-sheet
     2314             buf_shift-grp-in.doc-code = tincome-3.doc-code
     2315             buf_shift-grp-in.cli-type-code = substitute("&1&2", tincome-3.supp-type, tincome-3.supp-code)
     2316             buf_shift-grp-in.cli-name = tincome-3.supp-name
     2317             buf_shift-grp-in.fact-qnty = tincome-3.qnty1
     2318             buf_shift-grp-in.fact-cost-sum = tincome-3.netto
     2319             .
     2320             release buf_shift-grp-in.
     2321           end.
     2322       END.
     2323       IF AVAIl treal-3 then do:
     2324         if treal-3.cpay-code <> 0 and treal-3.discnt-type = -99 then do:
     2325           FIND FIRST actreal-3 WHERE
     2326                     actreal-3.grp-code-sheet = 0 AND
     2327                     actreal-3.cpay-code = treal-3.cpay-code AND
     2328                     actreal-3.curr-code = treal-3.curr-code AND
     2329                     actreal-3.is-pay = treal-3.is-pay NO-ERROR.
     2330           if not avail actreal-3 then do:
     2331             acii = acii + 1.
     2332             run create-actreal-3 (
     2333                                 INPUT 0,
     2334                                 INPUT treal-3.cpay-code,
     2335                                 INPUT treal-3.curr-code,
     2336                                 INPUT treal-3.qnty1,
     2337                                 INPUT treal-3.netto,
     2338                                 INPUT treal-3.out-name,
     2339                                 INPUT treal-3.is-pay,
     2340                                 INPUT acii) no-error.
     2341           end.
     2342           else
     2343           assign
     2344           actreal-3.qnty1 = actreal-3.qnty1 + treal-3.qnty1
     2345           actreal-3.netto = actreal-3.netto + treal-3.netto
     2346           .
     2347         end.
     2348         assign
     2349         pol9 = treal-3.out-name
     2350         pol10 = treal-3.qnty1
     2351         pol11 = treal-3.netto
     2352         pol11_1 = treal-3.discount-sum
     2353         pol11_2 = treal-3.brutto
     2354         pol11_3 = treal-3.chk-qnty
     2355         pay-line = yes
     2356         .
     2357         if p-batch > 0
     2358         and (treal-3.curr-code > 0
     2359         or not (treal-3.curr-code = 0 and treal-3.cpay-code = 0))
     2360         and treal-3.grp-code > 0
     2361         then do:
     2362           find first buf_shift-grp-out where
     2363                     buf_shift-grp-out.obj-type = p-obj-type
     2364                 and buf_shift-grp-out.obj-code = p-obj-code
     2365                 and buf_shift-grp-out.shift-date = x-date-end
     2366                 and buf_shift-grp-out.shift-num = x-shift-end
     2367                 and buf_shift-grp-out.grp-code = treal-3.grp-code-sheet
     2368                 and buf_shift-grp-out.pay-code = treal-3.cpay-code
     2369                 and buf_shift-grp-out.curr-code = treal-3.curr-code
     2370                 no-error.
     2371           if not available buf_shift-grp-out then do:
     2372               find first buf_cash-pay no-lock where
     2373                         buf_cash-pay.cdpay-code = treal-3.cpay-code
     2374                    and  buf_cash-pay.curr-code = treal-3.curr-code no-error.
     2375             create buf_shift-grp-out.
     2376             assign
     2377             buf_shift-grp-out.obj-type = p-obj-type
     2378             buf_shift-grp-out.obj-code = p-obj-code
     2379             buf_shift-grp-out.shift-date = x-date-end
     2380             buf_shift-grp-out.shift-num = x-shift-end
     2381             buf_shift-grp-out.grp-code = treal-3.grp-code-sheet
     2382             buf_shift-grp-out.pay-code = treal-3.cpay-code
     2383             buf_shift-grp-out.curr-code = treal-3.curr-code
     2384             buf_shift-grp-out.out-name = treal-3.out-name
     2385             buf_shift-grp-out.fact-qnty = treal-3.qnty1
     2386             buf_shift-grp-out.fact-sum = treal-3.netto
     2387             buf_shift-grp-out.cp-type = (if available buf_cash-pay
     2388                                           and buf_cash-pay.is-cash
     2389                                           then 1
     2390                                           else 2)
     2391             .
     2392             release buf_shift-grp-out.
     2393           end.
     2394         end.
     2395       END.
     2396       if not available tincome-3 and not available treal-3 then do:
     2397               put stream OutStr-html unformatted
     2398               substitute (
     2399               '  <tr>
     2400                       <td text_wrap="true">&1</td>
     2401                       <td style="text-align: right;">&2</td>
     2402                       <td style="text-align: right;">&3</td>
     2403                       <td text_wrap="true"></td>
     2404                       <td></td>
     2405                       <td style="text-align: right;"></td>
     2406                       <td style="text-align: right;"></td>
     2407                       <td text_wrap="true"></td>
     2408                       <td style="text-align: right;"></td>
     2409                       <td style="text-align: right;"></td>
     2410                       <td style="text-align: right;">&4</td>
     2411                       <td style="text-align: right;">&5</td>
     2412                       <td style="text-align: right;">&6</td>
     2413                       <td style="text-align: right;">&7</td>
     2414                       <td style="text-align: right;">&8</td>
     2415                   </tr>'
     2416               ,
     2417               pol1,
     2418               string(pol2,"->>>>>>>>>>>9.99"),
     2419               string(pol3,"->>>>>>>>>>>9.99"),
     2420               if pol11_1 = 0 then "" else string(pol11_1,"->>>>>>>>>>>9.99"),
     2421               if pol11_2 = 0 then "" else string(pol11_2,"->>>>>>>>>>>9.99"),
     2422               if pol11_3 = 0 then "" else string(pol11_3,"->>>>>>>>>>>9.99"),
     2423               string(pol12,"->>>>>>>>>>>9.99"),
     2424               string(pol13,"->>>>>>>>>>>9.99")
     2425               ).
     2426       end.
     2427       else do:
     2428                 put stream OutStr-html unformatted
     2429               substitute (
     2430               '  <tr>
     2431                       <td text_wrap="true">&1</td>
     2432                       <td style="text-align: right;">&2</td>
     2433                       <td style="text-align: right;">&3</td>
     2434                       <td text_wrap="true">&4</td>
     2435                       <td>&6</td>
     2436                       <td style="text-align: right;">&7</td>
     2437                       <td style="text-align: right;">&8</td>
     2438                       <td text_wrap="true">&9</td>'
     2439               ,
     2440               pol1,
     2441               if main-line = no then "" else string(pol2,"->>>>>>>>>>>9.99"),
     2442               if main-line = no then "" else string(pol3,"->>>>>>>>>>>9.99"),
     2443               pol4,
     2444               if pol5 = 0 then "" else string(pol5),
     2445               pol6,
     2446               if supp-line = no then "" else string(pol7,"->>>>>>>>>>>9.99"),
     2447               if supp-line = no then "" else string(pol8,"->>>>>>>>>>>9.99"),
     2448               pol9
     2449               ).
     2450                         put stream OutStr-html unformatted
     2451               substitute (
     2452               '  
     2453                       <td style="text-align: right;">&1</td>
     2454                       <td style="text-align: right;">&2</td>
     2455                       <td style="text-align: right;">&3</td>
     2456                       <td style="text-align: right;">&4</td>
     2457                       <td style="text-align: right;">&5</td>
     2458                       <td style="text-align: right;">&6</td>
     2459                       <td style="text-align: right;">&7</td>
     2460                   </tr>'
     2461               ,
     2462               if pay-line = no then "" else string(pol10,"->>>>>>>>>>>9.99"),
     2463               if pay-line = no then "" else string(pol11,"->>>>>>>>>>>9.99"),
     2464               if pay-line = no or pol11_1 = 0 then "" else string(pol11_1,"->>>>>>>>>>>9.99"),
     2465               if pay-line = no or pol11_2 = 0 then "" else string(pol11_2,"->>>>>>>>>>>9.99"),
     2466               if pay-line = no or pol11_3 = 0 then "" else string(pol11_3,"->>>>>>>>>>>9.99"),
     2467               if main-line = no then "" else string(pol12,"->>>>>>>>>>>9.99"),
     2468               if main-line = no then "" else string(pol13,"->>>>>>>>>>>9.99")
     2469               ).
     2470       end.
     2471       if jj < t-3.lines then do:
     2472           if main-line then do:
     2473             assign
     2474             accum-2 = accum-2 + pol2
     2475             accum-3 = accum-3 + pol3
     2476             accum-12 = accum-12 + pol12
     2477             accum-13 = accum-13 + pol13
     2478             .
     2479           end.
     2480           if supp-line then do:
     2481             if tincome-3.is-fact = yes then
     2482             assign
     2483             accum-7 = accum-7 + pol7
     2484             accum-8 = accum-8 + pol8
     2485             .
     2486           end.
     2487           if pay-line then do:
     2488             if treal-3.cpay-code <> 0 then do:
     2489                 if treal-3.discnt-type = -99 or treal-3.cpay-code < 0 then
     2490             assign
     2491             accum-10 = accum-10 + pol10
     2492             accum-11 = accum-11 + pol11
     2493             .
     2494             end.
     2495           end.
     2496       end.
     2497       if jj = 1 and t-3.lines = 1 then do:
     2498           if main-line then do:
     2499             assign
     2500             accum-2 = accum-2 + pol2
     2501             accum-3 = accum-3 + pol3
     2502             accum-12 = accum-12 + pol12
     2503             accum-13 = accum-13 + pol13
     2504             .
     2505           end.
     2506           if supp-line then do:
     2507             if tincome-3.is-fact = yes then
     2508             assign
     2509             accum-7 = accum-7 + pol7
     2510             accum-8 = accum-8 + pol8
     2511             .
     2512           end.
     2513           if pay-line then do:
     2514             if treal-3.cpay-code <> 0 then do:
     2515                 if treal-3.discnt-type = -99 or treal-3.cpay-code < 0 then
     2516                     assign
     2517                     accum-10 = accum-10 + pol10
     2518                     accum-11 = accum-11 + pol11
     2519                     .
     2520             end.
     2521           end.
     2522       end.
     2523       end.
     2524    END.
     2525     if pclassify <> "totals":U and last(t-3.grp-name) then do:
     2526       assign
     2527       pol1 = "ИТОГО ПО ВСЕМ ГРУППАМ"
     2528       pol2 = accum-2
     2529       pol3 = accum-3
     2530       pol7 = accum-7
     2531       pol8 = accum-8
     2532       pol9 = "ИТОГО РАСХОД"
     2533       pol10 = accum-10
     2534       pol11 = accum-11
     2535       pol12 = accum-12
     2536       pol13 = accum-13
     2537       .
     2538           put stream OutStr-html unformatted
     2539               substitute (
     2540               '  <tr>
     2541                       <th text_wrap="true" style="text-align: left;">&1</th>
     2542                       <th style="text-align: right;">&2</th>
     2543                       <th style="text-align: right;">&3</th>
     2544                       <th style="text-align: left;"></th>
     2545                       <th></th>
     2546                       <th style="text-align: right;">&4</th>
     2547                       <th style="text-align: right;">&5</th>
     2548                       <th text_wrap="true" style="text-align: left;">&6</th>'
     2549               ,
     2550               pol1,
     2551               string(pol2,"->>>>>>>>>>>9.99"),
     2552               string(pol3,"->>>>>>>>>>>9.99"),
     2553               string(pol7,"->>>>>>>>>>>9.99"),
     2554               string(pol8,"->>>>>>>>>>>9.99"),
     2555               pol9
     2556               ).
     2557           put stream OutStr-html unformatted
     2558               substitute (
     2559               '  
     2560                       <th style="text-align: right;">&1</th>
     2561                       <th style="text-align: right;">&2</th>
     2562                       <th style="text-align: right;"></th>
     2563                       <th style="text-align: right;"></th>
     2564                       <th style="text-align: right;"></th>
     2565                       <th style="text-align: right;">&3</th>
     2566                       <th style="text-align: right;">&4</th>
     2567                   </tr>'
     2568               ,
     2569               string(pol10,"->>>>>>>>>>>9.99"),
     2570               string(pol11,"->>>>>>>>>>>9.99"),
     2571               string(pol12,"->>>>>>>>>>>9.99"),
     2572               string(pol13,"->>>>>>>>>>>9.99")
     2573               ).
     2574       if can-find(first actreal-3 No-LOCK) then do:
     2575         pol9 = "     в том числе:".
     2576           put stream OutStr-html unformatted
     2577               substitute (
     2578               '  <tr>
     2579                       <td></td>
     2580                       <td></td>
     2581                       <td></td>
     2582                       <td></td>
     2583                       <td></td>
     2584                       <td></td>
     2585                       <td></td>
     2586                       <td text_wrap="true">&1</td>
     2587                       <td></td>
     2588                       <td></td>
     2589                       <td></td>
     2590                       <td></td>
     2591                       <td></td>
     2592                       <td></td>
     2593                       <td></td>
     2594                   </tr>'
     2595               ,
     2596               pol9
     2597               ).
     2598         assign
     2599         areal-is-pay-qnty1 = 0
     2600         areal-is-pay-netto = 0
     2601         areal-no-pay-qnty1 = 0
     2602         areal-no-pay-netto = 0
     2603         .
     2604         FOR EACH actreal-3 No-LOCK
     2605         BREAK
     2606         BY actreal-3.grp-code-sheet
     2607         By actreal-3.is-pay descending
     2608         BY actreal-3.cpay-code descending
     2609         BY actreal-3.curr-code:
     2610           if actreal-3.is-pay = yes then
     2611           assign
     2612           areal-is-pay-qnty1 = areal-is-pay-qnty1 + actreal-3.qnty1
     2613           areal-is-pay-netto = areal-is-pay-netto + actreal-3.netto
     2614           .
     2615           else
     2616           assign
     2617           areal-no-pay-qnty1 = areal-no-pay-qnty1 + actreal-3.qnty1
     2618           areal-no-pay-netto = areal-no-pay-netto + actreal-3.netto
     2619           .
     2620           assign
     2621           pol9 = actreal-3.out-name
     2622           pol10 = actreal-3.qnty1
     2623           pol11 = actreal-3.netto
     2624           pol11_1 = actreal-3.discount-sum
     2625           pol11_2 = actreal-3.brutto
     2626           pol11_3 = actreal-3.chk-qnty
     2627           .
     2628           put stream OutStr-html unformatted
     2629               substitute (
     2630               '  <tr>
     2631                       <td></td>
     2632                       <td></td>
     2633                       <td></td>
     2634                       <td></td>
     2635                       <td></td>
     2636                       <td></td>
     2637                       <td></td>
     2638                       <td text_wrap="true">&1</td>
     2639                       <td style="text-align: right;">&2</td>
     2640                       <td style="text-align: right;">&3</td>
     2641                       <td></td>
     2642                       <td></td>
     2643                       <td></td>
     2644                       <td></td>
     2645                       <td></td>
     2646                   </tr>'
     2647               ,
     2648               pol9,
     2649               string(pol10,"->>>>>>>>>>>9.99"),
     2650               string(pol11,"->>>>>>>>>>>9.99"),
     2651               if pol11_1 = 0 then "" else string(pol11_1,"->>>>>>>>>>>9.99"),
     2652               if pol11_2 = 0 then "" else string(pol11_2,"->>>>>>>>>>>9.99"),
     2653               if pol11_3 = 0 then "" else string(pol11_3,"->>>>>>>>>>>9.99")
     2654               ).
     2655          if last-of(actreal-3.is-pay)  then do:
     2656             if actreal-3.discnt-type = -99 or actreal-3.cpay-code < 0 then do:
     2657             if actreal-3.is-pay = yes then
     2658             assign
     2659             pol9 = "ИТОГО ОПЛАЧ.РАСХОД"
     2660             pol10 = areal-is-pay-qnty1
     2661             pol11 = areal-is-pay-netto
     2662             .
     2663             else
     2664             assign
     2665             pol9 = "ИТОГО ПРОЧ.РАСХОД"
     2666             pol10 = areal-no-pay-qnty1
     2667             pol11 = areal-no-pay-netto
     2668             .
     2669           end.
     2670           put stream OutStr-html unformatted
     2671               substitute (
     2672               '  <tr>
     2673                       <td></td>
     2674                       <td></td>
     2675                       <td></td>
     2676                       <td></td>
     2677                       <td></td>
     2678                       <td></td>
     2679                       <td></td>
     2680                       <td text_wrap="true">&1</td>
     2681                       <td style="text-align: right;">&2</td>
     2682                       <td style="text-align: right;">&3</td>
     2683                       <td></td>
     2684                       <td></td>
     2685                       <td></td>
     2686                       <td></td>
     2687                       <td></td>
     2688                   </tr>'
     2689               ,
     2690               pol9,
     2691               string(pol10,"->>>>>>>>>>>9.99"),
     2692               string(pol11,"->>>>>>>>>>>9.99")
     2693               ).
     2694              end.
     2695           end.
     2696         END.
     2697       end.
     2698   END.
     2699        output stream OutStr-html close.
     2700        output stream OutStr-html to value(v-report-name-html) append convert target 'UTF-8' .
     2701        put stream OutStr-html unformatted
     2702           substitute (
     2703           '
     2704           </tbody>
     2705           '
     2706               , chr(123), chr(125)
     2707          ).
     2708         output stream OutStr-html close.
     2709   PROCEDURE create-tincome-3.
     2710   DEFINE INPUT PARAMETER pgrp-code-sheet like ub.gds-grp.node-code no-undo.
     2711   DEFINE INPUT PARAMETER pdoc-code like ub.trn-doc.doc-code no-undo.
     2712   DEFINE INPUT PARAMETER pqnty1 as decimal no-undo.
     2713   DEFINE INPUT PARAMETER pnetto as decimal no-undo.
     2714   DEFINE INPUT PARAMETER psupp-name as character no-undo.
     2715   DEFINE INPUT PARAMETER psupp-code like ub.clients.obj-code no-undo.
     2716   DEFINE INPUT PARAMETER pis-fact as logical no-undo.
     2717   DEFINE INPUT PARAMETER pii as integer no-undo.
     2718   _main:
     2719   DO ON ERROR UNDO _main, return error:
     2720       create tincome-3.
     2721       assign
     2722       tincome-3.grp-code-sheet = pgrp-code-sheet
     2723       tincome-3.doc-code = pdoc-code
     2724       tincome-3.qnty1  =  pqnty1
     2725       tincome-3.netto  = pnetto
     2726       tincome-3.supp-code = psupp-code
     2727       tincome-3.supp-name = psupp-name
     2728       tincome-3.is-fact = pis-fact
     2729       tincome-3.ii = pii
     2730       no-error
     2731       .
     2732       if error-status:error then undo _main, return error.
     2733   END.
     2734   END PROCEDURE.
