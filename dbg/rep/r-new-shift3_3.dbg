      117   .
      118   procedure create_obj-list :
      119      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      120      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      121      do
      122      on error undo, return error return-value
      123      :
      124         define buffer cli-obj for ub.clients .
      125         define variable p-var as integer no-undo .
      126         define buffer buf_obj-list for obj-list .
      127         find last buf_obj-list  use-index pi no-error .
      128         if available buf_obj-list
      129         then
      130            p-var = buf_obj-list.obj-id + 1.
      131         else
      132            p-var = 1.
      133         find first cli-obj where
      134                   cli-obj.obj-type = p-obj-type
      135               and cli-obj.obj-code = p-obj-code
      136         no-lock no-error.
      137         if available cli-obj
      138         then do:
      139            create buf_obj-list.
      140            assign
      141               buf_obj-list.obj-id   = p-var
      142               buf_obj-list.obj-code = cli-obj.obj-code
      143               buf_obj-list.obj-type = cli-obj.obj-type
      144               buf_obj-list.obj-name = cli-obj.obj-name
      145               buf_obj-list.db-num   = cli-obj.db-num
      146            .
      147         end.
      148      end.
      149   end.
