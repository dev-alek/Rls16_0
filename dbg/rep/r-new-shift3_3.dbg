      662   PROCEDURE create-treal-3.
      663   DEFINE INPUT PARAMETER pgrp-code-sheet like ub.gds-grp.node-code no-undo.
      664   DEFINE INPUT PARAMETER pcpay-code like ub.cash-pay.cdpay-code no-undo.
      665   DEFINE INPUT PARAMETER pcurr-code like ub.cash-pay.curr-code no-undo.
      666   DEFINE INPUT PARAMETER pqnty1 as decimal no-undo.
      667   DEFINE INPUT PARAMETER pnetto as decimal no-undo.
      668   DEFINE INPUT PARAMETER pout-name as character no-undo.
      669   DEFINE INPUT PARAMETER pis-pay as logical no-undo.
      670   DEFINE INPUT PARAMETER pii as integer no-undo.
      671   _main:
      672   DO ON ERROR UNDO _main, return error:
      673       create treal-3.
      674       assign
      675       treal-3.grp-code-sheet = pgrp-code-sheet
      676       treal-3.cpay-code = pcpay-code
      677       treal-3.curr-code = pcurr-code
      678       treal-3.qnty1  =  pqnty1
      679       treal-3.netto = pnetto
      680       treal-3.out-name = pout-name
      681       treal-3.is-pay = pis-pay
      682       treal-3.ii = pii
      683       treal-3.discnt-type = -99
      684       no-error
      685       .
      686       if error-status:error then undo _main, return error.
      687   END.
      688   END PROCEDURE.
      689   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      690   PROCEDURE create-actreal-3.
      691   DEFINE INPUT PARAMETER pgrp-code-sheet like ub.gds-grp.node-code no-undo.
      692   DEFINE INPUT PARAMETER pcpay-code like ub.cash-pay.cdpay-code no-undo.
