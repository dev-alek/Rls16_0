      843   procedure uf-get :
      844     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      845     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
      846     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
      847     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
      848     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      849     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      850     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
      851     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
      852     do
      853     on error undo, return error
      854     :
      855       define buffer buf_usr-flt for ubflt.usr-flt .
      856       define variable v-use-List_     as logical   no-undo .
      857       define variable v-type-List_     as character no-undo .
      858       define variable v-format-List_   as character no-undo .
      859       define variable v-use-Naim      as logical   no-undo .
      860       define variable v-type-Naim      as character no-undo .
      861       define variable v-format-Naim    as character no-undo .
      862       define variable v-use-print-graft as logical   no-undo .
      863       define variable v-use-sort-gr     as logical   no-undo .
      864       define variable v-use-type-price  as logical   no-undo .
      865       define variable v-use-type-val    as logical   no-undo .
      866       define variable v-label          as character no-undo .
      867       define variable v-tooltip        as character no-undo .
      868       define variable v-user-can-edit  as logical   no-undo .
      869       define variable v-output-display as logical   no-undo .
      870       define variable v-other          as character no-undo .
      871       run uf-name in this-procedure
      872          (input  entry(1, p-code, chr(4))
      873         ,output v-use-List_
      874         ,output v-type-List_
      875         ,output v-format-List_
      876         ,output v-use-Naim
      877         ,output v-type-Naim
      878         ,output v-format-Naim
      879         ,output v-use-print-graft
      880         ,output v-use-sort-gr
      881         ,output v-use-type-price
      882         ,output v-use-type-val
      883         ,output v-label
      884         ,output v-tooltip
      885         ,output v-user-can-edit
      886         ,output v-output-display
      887         ,output v-other
      888         ) no-error .
      889       if error-status :error then do:
      890         undo, return error return-value .
      891       end.
      892       find first buf_usr-flt no-lock where
      893                  buf_usr-flt.Call-point     = p-code AND
      894                  buf_usr-flt.user-name       = p-user-name
      895         no-error .
      896       if avail buf_usr-flt then do:
      897         assign
      898         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
      899         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
      900         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
      901         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
      902         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
      903         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
      904         .
      905       end.
      906       else do:
      907         assign
      908         p-List_        = (if v-use-List_       then "":U                    else ?)
      909         p-Naim         = (if v-use-Naim        then "":U                    else ?)
      910         p-print-graft  = (if v-use-print-graft then no                      else ?)
      911         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
      912         p-type-price   = (if v-use-type-price  then no                      else ?)
      913         p-type-val     = (if v-use-List_       then no                      else ?)
      914         .
      915       end.
      916     end.
      917   end procedure.
      918   procedure uf-set :
      919     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      920     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
      921     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
      922     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
      923     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      924     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      925     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
      926     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
      927     do
      928     on error undo, return error
      929     :
      930       define buffer buf_usr-flt for ubflt.usr-flt .
      931       define variable v-use-List_     as logical   no-undo .
      932       define variable v-type-List_     as character no-undo .
      933       define variable v-format-List_   as character no-undo .
      934       define variable v-use-Naim      as logical   no-undo .
      935       define variable v-type-Naim      as character no-undo .
      936       define variable v-format-Naim    as character no-undo .
      937       define variable v-use-print-graft as logical   no-undo .
      938       define variable v-use-sort-gr   as logical   no-undo .
      939       define variable v-use-type-price as logical   no-undo .
      940       define variable v-use-type-val  as logical   no-undo .
      941       define variable v-tooltip        as character no-undo .
      942       define variable v-label          as character no-undo .
      943       define variable v-user-can-edit  as logical   no-undo .
      944       define variable v-output-display as logical   no-undo .
      945       define variable v-other          as character no-undo .
      946       run uf-name in this-procedure
      947         (input  entry(1, p-code, chr(4))
      948         ,output v-use-List_
      949         ,output v-type-List_
      950         ,output v-format-List_
      951         ,output v-use-Naim
      952         ,output v-type-Naim
      953         ,output v-format-Naim
      954         ,output v-use-print-graft
      955         ,output v-use-sort-gr
      956         ,output v-use-type-price
      957         ,output v-use-type-val
      958         ,output v-label
      959         ,output v-tooltip
      960         ,output v-user-can-edit
      961         ,output v-output-display
      962         ,output v-other
      963         ) no-error .
      964       if error-status :error then do:
      965         undo, return error return-value .
      966       end.
      967       find first buf_usr-flt where
      968                  buf_usr-flt.Call-point     = p-code AND
      969                  buf_usr-flt.user-name       = p-user-name
      970         no-error .
      971       if not avail buf_usr-flt then do:
      972           create buf_usr-flt .
      973           assign
      974           buf_usr-flt.call-point = p-code
      975           buf_usr-flt.user-name  = p-user-name
      976           .
      977       end.
      978       if avail buf_usr-flt then do:
      979        assign
      980        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
      981        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
      982        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
      983        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
      984        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
      985        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
      986       .
      987       release buf_usr-flt.
      988       end.
      989       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
      990     end.
      991   end procedure.
      992   define variable v-column-list as character no-undo.
      993   run proc-get .
      994   DEFINE BUTTON p-izm-column
      995       LABEL "Изменить"
      996       SIZE 15 BY 1.13.
      997   DEFINE VARIABLE list-column AS CHARACTER
      998       VIEW-AS SELECTION-LIST SINGLE SCROLLBAR-VERTICAL
      999       SIZE 40.5 BY 12 NO-UNDO.
     1000   DEFINE FRAME fMain
     1001       list-column AT ROW 2.75 COL 6 NO-LABEL WIDGET-ID 2
     1002       p-izm-column AT ROW 3 COL 48 WIDGET-ID 6
     1003       "Колонки:" VIEW-AS TEXT
     1004       SIZE 12.5 BY 1 AT ROW 1.5 COL 6 WIDGET-ID 4
     1005       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
     1006       SIDE-LABELS NO-UNDERLINE THREE-D
     1007       AT COL 1 ROW 1
     1008       SIZE 71.5 BY 14.88 WIDGET-ID 100.
     1009   IF NOT THIS-PROCEDURE:PERSISTENT THEN
     1010   DO:
     1011       MESSAGE "c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\rep\alc-rees.w should only be RUN PERSISTENT.":U
     1012           VIEW-AS ALERT-BOX ERROR BUTTONS OK.
     1013       RETURN.
     1014   END.
     1015   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     1016   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     1017   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     1018   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     1019   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     1020   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     1021   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     1022   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     1023         adm-object-hdl = FRAME fMain:HANDLE.
     1024   RUN ensure-broker.
     1025   THIS-PROCEDURE:ADM-DATA =
     1026        'ADM1.1~`':U +
     1027        'SmartViewer~`':U +
     1028        '~`':U +
     1029        'NO ~`':U +
     1030        '~`':U +
     1031        '~`':U +
     1032        '~`':U +
     1033        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     1034           + "~`":U +
     1035        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
     1036        'Record-Source,Record-Target,TableIO-Target~`':U +
     1037        '~`':U +
     1038        '~`~`~`~`~`~`~`~`~`~`~`':U +
     1039        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1040            THEN "^^":U
     1041        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1042             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1043   PROCEDURE adm-apply-entry :
     1044     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1045   END PROCEDURE.
     1046   PROCEDURE adm-destroy :
     1047    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1048   END PROCEDURE.
     1049   PROCEDURE adm-disable :
     1050       DISABLE list-column p-izm-column WITH FRAME fMain.
     1051       RUN dispatch ('disable-fields':U).
     1052       RUN set-attribute-list ('ENABLED=no':U).
     1053       RETURN.
     1054   END PROCEDURE.
     1055   PROCEDURE adm-edit-attribute-list :
     1056         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
     1057         RETURN.
     1058   END PROCEDURE.
     1059   PROCEDURE adm-enable :
     1060       ENABLE UNLESS-HIDDEN list-column p-izm-column WITH FRAME fMain.
     1061       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     1062       RUN set-attribute-list ('ENABLED=yes':U).
     1063       RETURN.
     1064   END PROCEDURE.
     1065   PROCEDURE adm-exit :
     1066        RUN notify ('exit':U).
     1067     RETURN.
     1068   END PROCEDURE.
     1069   PROCEDURE adm-hide :
     1070     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1071   END PROCEDURE.
     1072   PROCEDURE adm-initialize :
     1073     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1074   END PROCEDURE.
     1075   PROCEDURE adm-show-errors :
     1076       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1077       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1078           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1079       END.
     1080       RETURN.
     1081   END PROCEDURE.
     1082   PROCEDURE adm-UIB-mode :
     1083     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1084   END PROCEDURE.
     1085   PROCEDURE adm-view :
     1086     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1087   END PROCEDURE.
     1088   PROCEDURE dispatch :
     1089       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1090       RUN broker-dispatch IN adm-broker-hdl
     1091           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1092       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1093   END PROCEDURE.
     1094   PROCEDURE ensure-broker :
     1095   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1096   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1097   DO:
     1098       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1099       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1100   END.
     1101   END PROCEDURE.
     1102   PROCEDURE get-attribute :
     1103     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1104     RUN broker-get-attribute IN adm-broker-hdl
     1105         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1106     RETURN RETURN-VALUE.
     1107   END PROCEDURE.
     1108   PROCEDURE get-attribute-list :
     1109     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1110     RUN broker-get-attribute-list IN adm-broker-hdl
     1111         (INPUT THIS-PROCEDURE,
     1112          INPUT ?,
     1113          OUTPUT p-attr-list) NO-ERROR.
     1114     RETURN.
     1115   END PROCEDURE.
     1116   PROCEDURE new-state :
     1117     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1118     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1119     RETURN.
     1120   END PROCEDURE.
     1121   PROCEDURE notify :
     1122     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1123     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1124     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1125         RETURN "ADM-ERROR":U.
     1126     RETURN.
     1127   END PROCEDURE.
     1128   PROCEDURE set-attribute-list :
     1129     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1130     RUN ensure-broker.
     1131     RUN broker-set-attribute-list IN adm-broker-hdl
     1132         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1133     RETURN.
     1134   END PROCEDURE.
     1135   PROCEDURE set-position :
     1136       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1137       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1138       IF VALID-HANDLE(adm-object-hdl) THEN
     1139       DO:
     1140         ASSIGN adm-object-hdl:ROW    =   p-row
     1141                adm-object-hdl:COLUMN =   p-col.
     1142       END.
     1143       RETURN.
     1144   END PROCEDURE.
     1145   PROCEDURE adm-display-fields :
     1146       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
     1147       RETURN.
     1148   END PROCEDURE.
     1149   PROCEDURE adm-open-query :
     1150     RETURN.
     1151   END PROCEDURE.
     1152   PROCEDURE adm-row-changed :
     1153         IF VALID-HANDLE(adm-object-hdl) THEN
     1154           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1155         RUN notify ('row-available':U).
     1156         RETURN.
     1157   END PROCEDURE.
     1158   PROCEDURE reposition-query :
     1159       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
     1160       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
     1161       RETURN.
     1162   END PROCEDURE.
     1163     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
     1164     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
     1165     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
     1166     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
     1167     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
     1168     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
     1169     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
     1170     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
     1171     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1172     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
     1173     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1174     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
     1175     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
     1176     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
     1177     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
     1178     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
     1179     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
     1180     IF "":U = "":U THEN
     1181       RUN modify-list-attribute IN adm-broker-hdl
     1182         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
     1183     RUN use-create-on-add(?).
     1184   PROCEDURE adm-add-record :
     1185       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1186          "must have at least one Enabled Table to perform Add.":U
     1187          VIEW-AS ALERT-BOX ERROR.
     1188       RETURN.
     1189   END PROCEDURE.
     1190   PROCEDURE adm-assign-record :
     1191    MESSAGE
     1192          "Object ":U THIS-PROCEDURE:FILE-NAME
     1193            "must have at least one Enabled Table to perform Assign.":U
     1194              VIEW-AS ALERT-BOX ERROR.
     1195      RETURN.
     1196     END PROCEDURE.
     1197   PROCEDURE adm-assign-statement :
     1198     RETURN.
     1199   END PROCEDURE.
     1200   PROCEDURE adm-cancel-record :
     1201      RETURN.
     1202     END PROCEDURE.
     1203   PROCEDURE adm-copy-record :
     1204       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1205        "must have at least one Enabled Table to perform Copy.":U
     1206          VIEW-AS ALERT-BOX ERROR.
     1207       RETURN.
     1208   END PROCEDURE.
     1209   PROCEDURE adm-create-record :
     1210      RETURN.
     1211   END PROCEDURE.
     1212   PROCEDURE adm-current-changed :
     1213     RETURN.
     1214   END PROCEDURE.
     1215   PROCEDURE adm-delete-record :
     1216    MESSAGE
     1217          "Object ":U THIS-PROCEDURE:FILE-NAME
     1218            "must have at least one Enabled Table to perform Delete.":U
     1219              VIEW-AS ALERT-BOX ERROR.
     1220       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
     1221       RETURN.
     1222   END PROCEDURE.
     1223   PROCEDURE adm-disable-fields :
     1224         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
     1225       RETURN.
     1226   END PROCEDURE.
     1227   PROCEDURE adm-enable-fields :
     1228       RETURN.
     1229   END PROCEDURE.
     1230   PROCEDURE adm-end-update :
     1231     RETURN.
     1232   END PROCEDURE.
     1233   PROCEDURE adm-reset-record :
     1234       RETURN.
     1235   END PROCEDURE.
     1236   PROCEDURE adm-update-record :
     1237       MESSAGE
     1238         "Object ":U THIS-PROCEDURE:FILE-NAME
     1239           "must have at least one Enabled Table to perform Update.":U
     1240             VIEW-AS ALERT-BOX ERROR.
     1241      RETURN.
     1242   END PROCEDURE.
     1243   PROCEDURE check-modified :
     1244   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1245   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1246   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1247   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1248     IF check-state = "check":U THEN
     1249     DO:
     1250       RUN get-link-handle IN adm-broker-hdl
     1251         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1252            OUTPUT group-target-list).
     1253       IF group-target-list NE "":U THEN
     1254       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1255         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1256         RUN check-modified IN curr-widget ('group-check':U).
     1257         IF RETURN-VALUE NE "":U THEN
     1258         DO:
     1259           RUN check-modified-message(RETURN-VALUE).
     1260           RETURN "":U.
     1261         END.
     1262       END.
     1263     END.
     1264     RETURN "":U.
     1265   END PROCEDURE.
     1266   PROCEDURE check-modified-message :
     1267     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1268        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1269           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1270        IF RETURN-VALUE = "YES":U THEN
     1271           RUN notify ('view,CONTAINER-SOURCE':U).
     1272        MESSAGE IF p-changed-table NE ? THEN
     1273           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1274           ELSE "Current values have been changed."
     1275           SKIP "  Do you wish to save those changes?"
     1276           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1277        IF ANS THEN
     1278        DO:
     1279           IF group-assign-target THEN
     1280             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1281           ELSE RUN dispatch('update-record':U).
     1282           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1283           DO:
     1284               MESSAGE "Changes to the previous record were not saved."
     1285                 VIEW-AS ALERT-BOX ERROR.
     1286               IF group-assign-target THEN
     1287                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1288               ELSE RUN dispatch ('cancel-record':U).
     1289           END.
     1290        END.
     1291        ELSE DO:
     1292          IF group-assign-target THEN
     1293             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1294          ELSE RUN dispatch('cancel-record':U).
     1295        END.
     1296        RETURN.
     1297   END PROCEDURE.
     1298   PROCEDURE get-rowid :
     1299       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1300       ASSIGN
     1301       p-table   =   adm-first-table.
     1302       RETURN.
     1303   END PROCEDURE.
     1304   PROCEDURE init-group-assign :
     1305       RUN request-attribute IN adm-broker-hdl
     1306         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1307       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1308         group-assign-target = yes.
     1309       ELSE group-assign-target = no.
     1310       RETURN.
     1311   END PROCEDURE.
     1312   PROCEDURE set-editors :
     1313       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1314       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1315       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1316       ASSIGN curr-widget = FRAME fMain:CURRENT-ITERATION.
     1317       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1318       DO WHILE VALID-HANDLE (curr-widget):
     1319           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1320              curr-widget:HIDDEN = no THEN DO:
     1321             CASE p-field-setting:
     1322               WHEN "INITIALIZE":U THEN
     1323               DO:
     1324                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1325                     read-only-list +
     1326                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1327                        STRING(curr-widget).
     1328               END.
     1329               WHEN "DISABLE":U OR
     1330               WHEN "ENABLE":U THEN
     1331               DO:
     1332                   curr-widget:SENSITIVE = yes.
     1333                   RUN get-attribute ('Read-Only-Editors':U).
     1334                   IF RETURN-VALUE = ? OR
     1335                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1336                       curr-widget:READ-ONLY =
     1337                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1338               END.
     1339               WHEN "CLEAR":U THEN
     1340                   curr-widget:SCREEN-VALUE = "":U.
     1341             END CASE.
     1342           END.
     1343           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1344       END.
     1345       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1346         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1347           + '"':U).
     1348       RETURN.
     1349   END PROCEDURE.
     1350   PROCEDURE use-check-modified-all :
     1351    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1352     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1353     RETURN.
     1354   END PROCEDURE.
     1355   PROCEDURE use-create-on-add :
     1356   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1357      RETURN.
     1358   END PROCEDURE.
     1359   PROCEDURE use-initial-lock :
     1360     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1361     ASSIGN adm-initial-lock = p-attr-value.
     1362     RETURN.
     1363   END PROCEDURE.
     1364     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1365   ASSIGN
     1366       FRAME fMain:HIDDEN = TRUE.
     1367   ON CHOOSE OF p-izm-column IN FRAME fMain
     1368       DO:
     1369           run izm-col in this-procedure.
     1370       END.
     1371   if not this-procedure :persistent
     1372   then do:
     1373     message
     1374       vss-workfile vss-revision vss-description skip
     1375       "Ошибка при запуске процедуры" skip
     1376       "Данную процедуру следует запускать только с параметром persistent" skip
     1377       view-as alert-box error .
     1378     undo, return error .
     1379   end.
     1380   assign
     1381       parparentproc = my-handle
     1382       .
     1383   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1384     run mainmenu_getcntxt in parparentproc
     1385       (output v-cntxt-db-num
     1386       ,output v-cntxt-userid
     1387       ,output v-cntxt-level
     1388       ,output v-cntxt-host-code-obj
     1389       ,output v-cntxt-obj-type
     1390       ,output v-cntxt-obj-code
     1391       ,output v-cntxt-db-num-obj
     1392       ,output v-cntxt-is-admin
     1393       ) .
     1394   PROCEDURE disable_UI :
     1395       HIDE FRAME fMain.
     1396       IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1397   END PROCEDURE.
     1398   PROCEDURE enable_UI :
     1399       DISPLAY list-column
     1400           WITH FRAME fMain.
     1401       ENABLE list-column p-izm-column
     1402           WITH FRAME fMain.
     1403   END PROCEDURE.
     1404   PROCEDURE izm-col :
     1405       define variable v-counter       as integer   no-undo.
     1406       define variable v-label         as character no-undo.
     1407       define variable v-value         as character no-undo.
     1408       define variable v-list          as character no-undo.
     1409       define variable v-changed       as logical   no-undo.
     1410       define variable v-accepted      as logical   no-undo.
     1411       define variable v-list-edt      as character no-undo.
     1412       define variable v-list-edt-full as character no-undo.
     1413       do
     1414           with frame fMain
     1415           on error undo, return error
     1416           :
     1417           v-uf-Naim = "".
     1418           assign
     1419               v-list-edt = "Поставщик ЕГАИС" +
     1420           "," + "ID Поставщика" +
     1421           "," + "ИНН/КПП" +
     1422           "," + "Дата документа из ЕГАИС" +
     1423           "," + "№ документа поставщика" +
     1424           "," + "№ накладной в ЕГИС" +
     1425           "," + "дата TH" +
     1426           "," + "№ документа TH" +
     1427           "," + "Сумма документа TH" +
     1428           "," + "Сумма документа ЕГАИС" +
     1429           "," + "Cтатус" +
     1430           "," + "Расхождение(да/нет)".
     1431           assign
     1432               v-list-edt-full = "Поставщик ЕГАИС" +
     1433           "," + "ID Поставщика" +
     1434           "," + "ИНН/КПП" +
     1435           "," + "Дата документа из ЕГАИС" +
     1436           "," + "№ документа поставщика" +
     1437           "," + "№ накладной в ЕГИС" +
     1438           "," + "дата TH" +
     1439           "," + "№ документа TH" +
     1440           "," + "Сумма документа TH" +
     1441           "," + "Сумма документа ЕГАИС" +
     1442           "," + "Cтатус" +
     1443           "," + "Расхождение(да/нет)".
     1444           run twowin_clear in this-procedure.
     1445           do v-counter = 1 to num-entries( v-list-edt-full )
     1446               on error undo, return error
     1447               :
     1448               assign
     1449                   v-label = entry( v-counter, v-list-edt-full )
     1450                   v-value = entry( v-counter, v-list-edt )
     1451                   .
     1452               run twowin_add-item in this-procedure (
     1453                   input v-value
     1454                   , input v-label
     1455                   , input substitute( "Название колонки: &1", v-value )
     1456                   , input ( list-column :lookup( v-value ) <> 0  )
     1457                   ).
     1458           end.
     1459           run gbl/twowin.w (
     1460               input ?
     1461               , input 1
     1462               , input "Выбор колонок":U
     1463               , input "":U
     1464               , input "&Тест"
     1465               , input table temp_twowin_items
     1466               , output table temp_twowin_itemsSelected
     1467               , output v-changed
     1468               , output v-accepted
     1469               ).
     1470           if
     1471               v-changed = yes
     1472               then
     1473           do:
     1474               assign
     1475                   list-column :list-items = "":U
     1476                   v-list                  = "":U
     1477                   v-counter               = 0
     1478                   .
     1479               for each temp_twowin_itemsSelected
     1480                   by temp_twowin_itemsSelected.itm-key
     1481                   :
     1482                   assign
     1483                       v-counter = v-counter + 1
     1484                       v-list    = substitute( "&1&2&3"
     1485                                   , v-list
     1486                                   , ( if v-list = "":U then "":U else ",":U )
     1487                                   , temp_twowin_itemsSelected.itmExtKey
     1488                                   )
     1489                       .
     1490                   list-column :add-last (
     1491                       entry( lookup( temp_twowin_itemsSelected.itmExtKey, v-list-edt ), v-list-edt-full )
     1492                       , temp_twowin_itemsSelected.itmExtKey
     1493                       ) no-error.
     1494               end.
     1495           end.
     1496       end.
     1497       v-column-list = "".
     1498       do v-counter = 1 to list-column :num-items in frame fMain
     1499           on error undo, return error
     1500           :
     1501           assign
     1502               v-column-list = substitute( "&1&2&3"
     1503                                           , v-column-list
     1504                                           , ( if v-column-list = "":U then "":U else ",":U )
     1505                                           , entry( v-counter , list-column :list-items )
     1506                                           )
     1507               .
     1508       end.
     1509       v-uf-Naim = v-column-list.
     1510       run uf-set in this-procedure
     1511           ( input 'alc-rees':U
     1512           ,input v-cntxt-userid
     1513           ,input v-uf-List_
     1514           ,input v-uf-Naim
     1515           ,input v-uf-print-graft
     1516           ,input v-uf-sort-gr
     1517           ,input v-uf-type-price
     1518           ,input v-uf-type-val
     1519           ) no-error .
     1520   END PROCEDURE.
     1521   PROCEDURE adm-row-available :
     1522     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
     1523     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
     1524     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
     1525     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
     1526     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
     1527     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
     1528     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
     1529     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
     1530     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
     1531     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
     1532     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
     1533     IF adm-updating-record THEN RETURN.
     1534     RUN get-attribute ('FIELDS-ENABLED':U).
     1535     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
     1536     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
     1537         OUTPUT link-handle) NO-ERROR.
     1538     IF link-handle = "":U THEN
     1539         RETURN.
     1540     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
     1541     IF NUM-ENTRIES(link-handle) > 1 THEN
     1542         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
     1543             "encountered more than one RECORD-SOURCE.":U SKIP
     1544             "The first - ":U record-source-hdl:file-name " - will be used.":U
     1545                VIEW-AS ALERT-BOX ERROR.
     1546     RUN get-attribute ('Key-Name':U).
     1547     key-name = RETURN-VALUE.
     1548     IF key-name = "":U THEN key-name = ?.
     1549     IF key-name NE ? THEN DO:
     1550       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
     1551         NO-ERROR.
     1552       IF key-value NE ? THEN
     1553         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
     1554     END.
     1555   IF VALID-HANDLE (adm-object-hdl) THEN
     1556       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1557   RUN notify IN THIS-PROCEDURE ('row-available':U).
     1558   END PROCEDURE.
     1559   PROCEDURE my-report :
     1560       define variable v-begin-date  as date    no-undo.
     1561       define variable v-end-date    as date    no-undo.
     1562       define variable v-begin-shift as integer no-undo.
     1563       define variable v-end-shift   as integer no-undo.
     1564       do
     1565           on error undo, return error
     1566           :
     1567           run rep/r-alc-rees.p (
     1568               input v-uf-Naim
     1569               ).
     1570       end.
     1571   END PROCEDURE.
     1572   PROCEDURE my-var :
     1573       assign frame fMain
     1574           list-column
     1575           .
     1576   END PROCEDURE.
     1577   PROCEDURE proc-get :
     1578       assign frame fMain
     1579           list-column
     1580           .
     1581       define variable p-naim     as character no-undo .
     1582       define variable v-list     as character no-undo .
     1583       define variable v-type-val as logical   no-undo .
     1584       run uf-get in this-procedure
     1585           ( input  'alc-rees':U
     1586           , input  v-cntxt-userid
     1587           , output v-uf-List_
     1588           , output v-uf-Naim
     1589           , output v-uf-print-graft
     1590           , output v-uf-sort-gr
     1591           , output v-uf-type-price
     1592           , output v-uf-type-val
     1593           ) no-error.
     1594       if not error-status:error then
     1595       do:
     1596           if v-uf-Naim <> "" then
     1597           do:
     1598               assign
     1599                   list-column :list-items in frame fMain = v-uf-Naim.
     1600           end.
     1601       end.
     1602   end procedure.
