      680   define temp-table temp_twowin_items no-undo
      681       field itm-key       as integer
      682       field itmExtKey     as character
      683       field itmName       as character
      684       field itmDesc       as character
      685       field itmSelected   as logical
      686       field selLeft       as logical
      687       field selRight      as logical
      688       index pi is primary unique
      689           itm-key
      690       index ie
      691           itmExtKey
      692   .
      693   define temp-table temp_twowin_itemsSelected no-undo
      694       field its-key   as integer
      695       field itm-key   as integer
      696       field itmExtKey as character
      697       index pi is primary unique
      698           its-key
      699       index im
      700           itm-key
      701   .
      702   define variable v-twowin13-itm-key    as integer      no-undo.
      703   procedure twowin_clear :
      704       define buffer buf_temp_twowin_items        for temp_twowin_items.
      705   do
      706   for buf_temp_twowin_items
      707   on error undo, return error
      708   :
      709       empty temp-table buf_temp_twowin_items.
      710   end.
      711   end procedure.
      712   procedure twowin_add-item :
      713   define input parameter p-ext-key   as character        no-undo.
      714   define input parameter p-item-name as character        no-undo.
      715   define input parameter p-item-desc as character        no-undo.
      716   define input parameter p-selected  as logical          no-undo.
      717       define buffer buf_temp_twowin_items        for temp_twowin_items.
      718   do
      719   for buf_temp_twowin_items
      720   on error undo, return error
      721   :
      722       assign
      723           v-twowin13-itm-key = v-twowin13-itm-key + 1
      724       .
      725       create temp_twowin_items.
      726       assign
      727           temp_twowin_items.itm-key      = v-twowin13-itm-key
      728           temp_twowin_items.itmExtKey    = p-ext-key
      729           temp_twowin_items.itmName      = p-item-name
      730           temp_twowin_items.itmDesc      = p-item-desc
      731           temp_twowin_items.itmSelected  = p-selected
      732           temp_twowin_items.selLeft      = no
      733           temp_twowin_items.selRight     = no
      734       .
      735   end.
      736   end procedure.
      737   define variable parparentproc as widget-handle no-undo .
