      746   procedure uf-name :
      747     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      748     define output parameter p-use-List_     as logical   no-undo .
      749     define output parameter p-type-List_     as character no-undo .
      750     define output parameter p-format-List_   as character no-undo .
      751     define output parameter p-use-Naim      as logical   no-undo .
      752     define output parameter p-type-Naim      as character no-undo .
      753     define output parameter p-format-Naim    as character no-undo .
      754     define output parameter p-use-print-graft as logical   no-undo .
      755     define output parameter p-use-sort-gr   as logical   no-undo .
      756     define output parameter p-use-type-price as logical   no-undo .
      757     define output parameter p-use-type-val  as logical   no-undo .
