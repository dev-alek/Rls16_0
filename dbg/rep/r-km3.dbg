      206   procedure create_obj-list :
      207      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      208      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      209      do
      210      on error undo, return error return-value
      211      :
      212         define buffer cli-obj for ub.clients .
      213         define variable p-var as integer no-undo .
      214         define buffer buf_obj-list for obj-list .
      215         find last buf_obj-list  use-index pi no-error .
      216         if available buf_obj-list
      217         then
      218            p-var = buf_obj-list.obj-id + 1.
      219         else
      220            p-var = 1.
      221         find first cli-obj where
      222                   cli-obj.obj-type = p-obj-type
      223               and cli-obj.obj-code = p-obj-code
      224         no-lock no-error.
      225         if available cli-obj
      226         then do:
      227            create buf_obj-list.
      228            assign
      229               buf_obj-list.obj-id   = p-var
      230               buf_obj-list.obj-code = cli-obj.obj-code
      231               buf_obj-list.obj-type = cli-obj.obj-type
      232               buf_obj-list.obj-name = cli-obj.obj-name
      233               buf_obj-list.db-num   = cli-obj.db-num
      234            .
      235         end.
      236      end.
      237   end.
