      640   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
      641   procedure paramls-clear :
      642     define buffer buf_temp-param for temp-param .
      643     do
      644     on error undo, return error return-value
      645     :
      646       for each buf_temp-param
      647       on error undo, return error
      648       :
      649         delete buf_temp-param .
      650       end.
      651     end.
      652   end procedure.
      653   procedure paramls-write :
      654     define input  parameter p-code     as character no-undo .
      655     define input  parameter p-sub-code as character no-undo .
      656     define input  parameter p-value    as character no-undo .
      657     define buffer buf_temp-param for temp-param .
      658     do
      659     on error undo, return error return-value
      660     :
      661       find first buf_temp-param
      662         where buf_temp-param.param-code     = p-code
      663           and buf_temp-param.param-sub-code = p-sub-code
      664         no-error .
      665       if not available buf_temp-param then do:
      666         create buf_temp-param .
      667         assign
      668           buf_temp-param.param-code     = p-code
      669           buf_temp-param.param-sub-code = p-sub-code
      670         .
      671       end.
      672       assign
      673         buf_temp-param.param-value = p-value
      674       .
      675     end.
      676   end procedure.
      677   procedure paramls-read :
      678     define input  parameter p-code          as character no-undo .
      679     define input  parameter p-sub-code      as character no-undo .
      680     define input  parameter p-default-value as character no-undo .
      681     define output parameter p-value         as character no-undo .
      682     define buffer buf_temp-param for temp-param .
      683     do
      684     on error undo, return error return-value
      685     :
      686       find first buf_temp-param
      687         where buf_temp-param.param-code     = p-code
      688           and buf_temp-param.param-sub-code = p-sub-code
      689         no-error .
      690       if available buf_temp-param then do:
      691         assign
      692           p-value = buf_temp-param.param-value
      693         .
      694       end.
      695       else do:
      696         assign
      697           p-value = p-default-value
      698         .
      699       end.
      700     end.
      701   end procedure.
      702   procedure paramls-append :
      703     define input  parameter p-code     as character no-undo .
      704     define input  parameter p-sub-code as character no-undo .
      705     define input  parameter p-value    as character no-undo .
      706     define buffer buf_temp-param for temp-param .
      707     do
      708     on error undo, return error return-value
      709     :
      710       find first buf_temp-param
      711            where buf_temp-param.param-code     = p-code
      712              and buf_temp-param.param-sub-code = p-sub-code
      713         no-error .
      714       if not available buf_temp-param then do:
      715         create buf_temp-param .
      716         assign
      717           buf_temp-param.param-code     = p-code
      718           buf_temp-param.param-sub-code = p-sub-code
      719           buf_temp-param.param-value    = p-value
      720         .
      721       end.
      722       else do:
      723           assign
      724               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
      725           .
      726       end.
      727     end.
      728   end procedure.
      729   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      730   define  stream PrnLibStream.
      731   procedure prn-lib-prn-file :
      732     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      733     define input parameter p-DIsabledoptions as integer no-undo .
      734     define variable v-report-name as character no-undo .
      735     define variable v-user-action as character no-undo .
      736     define variable v-printed     as logical   no-undo .
      737     define variable v-exist       as logical   no-undo .
      738     do
      739       on error undo, return error
      740       :
      741       run prn-lib-get-report-name  in this-procedure (
      742         input parParentProc
      743         ,output v-report-name
      744         ).
      745   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      746   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      747     (input  v-report-name
      748     ,input  2
      749     ,output v-exist
      750     )  .
      751       if NOT v-exist then
      752       DO:
      753         Message
      754           "Нет заданий на печать ! "
      755           view-as alert-box .
      756         Return  .
      757       End.
      758       run gbl/prnfilen.w
      759         (input  ""
      760         ,input  p-DisabledOptions
      761         ,input  string(v-report-name )
      762         ,input  7
      763         ,output v-user-action
      764         ,output v-printed
      765         ) .
      766       if v-printed then
      767       do:
      768         return "YES" .
      769       end.
      770       else
      771       do:
      772         return "NO" .
      773       end.
      774     end.
      775   end procedure.
      776   procedure prn-lib-open-stream :
      777     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      778     define input parameter p-page-size    as integer no-undo .
      779     define input parameter p-is-stream    as logical no-undo .
      780     define input parameter p-append       as logical no-undo .
      781     define variable v-report-name as character no-undo .
      782     do
      783       on error undo, return error
      784       :
      785       run prn-lib-get-report-name  in this-procedure (
      786         input parParentProc
      787         ,output v-report-name
      788         ).
      789       if p-is-stream then
      790       do:
      791         if p-append then
      792         do:
      793           output stream PrnLibStream to value( v-report-name )
      794             page-size value(p-page-size) append .
      795         end.
      796         if not p-append then
      797         do:
      798           output stream PrnLibStream to value( v-report-name )
      799             page-size value(p-page-size) .
      800         end.
      801       end.
      802       if not p-is-stream then
      803       do:
      804         if p-append then
      805         do:
      806           output to value( v-report-name )
      807             page-size value(p-page-size) append .
      808         end.
      809         if not p-append then
      810         do:
      811           output to value( v-report-name )
      812             page-size value(p-page-size) .
      813         end.
      814       end.
      815     end.
      816   end procedure.
      817   procedure prn-lib-open-exp :
      818     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      819     define input parameter p-is-stream    as logical no-undo .
      820     define input parameter p-is-append    as logical no-undo .
      821     define output parameter p-ReportFileName as char init "report" no-undo.
      822     define output parameter p-process as logical no-undo .
      823     define variable glog as logical no-undo .
      824     do
      825       on error undo, return error
      826       :
      827       SYSTEM-DIALOG GET-FILE p-ReportFileName
      828         TITLE      "Укажите путь"
      829         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      830         ASK-OVERWRITE
      831         CREATE-TEST-FILE
      832         SAVE-AS
      833         USE-FILENAME
      834         DEFAULT-EXTENSION "txt"
      835         UPDATE glog
      836         .
      837       if not glog then  return.
      838       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      839       if p-is-stream then
      840       do:
      841         if p-is-append then
      842         do:
      843           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      844         end.
      845         else
      846         do:
      847           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      848         end.
      849       end.
      850       else
      851       do:
      852         if p-is-append then
      853         do:
      854           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      855         end.
      856         else
      857         do:
      858           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      859         end.
      860       end.
      861       p-process = yes.
      862     end.
      863   end procedure.
      864   procedure prn-lib-get-report-name :
      865     define input parameter parParentProc  as widget-handle no-undo.
      866     define output parameter p-report-name as character no-undo .
      867     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      868   end procedure.
      869   procedure prn-lib-reportviewer-report-name :
      870     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      871     define input parameter p-report-name-html as character no-undo .
      872     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      873   end procedure.
      874   procedure prn-lib-reportviewer :
      875     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      876     define input parameter p-report-name-html as character no-undo .
      877     define input parameter p-param        as character no-undo .
      878     define variable v-excel           as character no-undo init 'TRUE' .
      879     define variable v-value-character as character no-undo .
      880     define variable v-value-integer   as character no-undo .
      881     define variable v-value-date      as date      no-undo .
      882     define variable v-value-decimal   as decimal   no-undo .
      883     define variable rep-excel         as logical   no-undo .
      884     define variable excel-string      as character no-undo .
      885     define variable v-param-type      as character no-undo .
      886     define variable v-tth             as handle    no-undo .
      887     run adm/shattri.p (
      888       input "get":U
      889       ,input  ""
      890       ,input  0
      891       ,input  'report-glob':U
      892       ,input  'rep-excel':U
      893       ,output v-value-character
      894       ,output v-value-date
      895       ,output v-value-decimal
      896       ,output v-value-integer
      897       ,output rep-excel
      898       ,output v-param-type
      899       ,INPUT-OUTPUT table-handle v-tth
      900       )  .
      901     if rep-excel then v-excel = "TRUE" .
      902     else v-excel = "FALSE" .
      903     if p-param eq ""
      904     then
      905        p-param = "EXCEL:" + v-excel.
      906     else
      907        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      908     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      909   end procedure.
      910   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      911     define variable v-cntxt-db-num        as integer   no-undo .
      912     define variable v-cntxt-userid        as character no-undo .
      913     define variable v-cntxt-level         as character no-undo .
      914     define variable v-cntxt-host-code-obj as integer   no-undo .
      915     define variable v-cntxt-obj-type      as character no-undo .
      916     define variable v-cntxt-obj-code      as integer   no-undo .
      917     define variable v-cntxt-db-num-obj    as integer   no-undo .
