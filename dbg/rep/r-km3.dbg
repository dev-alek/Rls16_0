     6112       if p-batch > 0 then do:      run write-log-and-file in p-log-handle (                 input 1                                          , input p-log-file-name                              , input 1                                          , input "Не было возвратов за выбранный период!!").    end.    else do:       run write-to-log in p-log-handle ( input "Не было возвратов за выбранный период!!").    end.
     6113       run cb_write-report-error in p-parent-handle ( input p-rebh
