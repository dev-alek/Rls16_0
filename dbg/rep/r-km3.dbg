     1722   define variable vss-include-info15 as character format "X(65)":U no-undo initial "@(#)$Workfile$ $Revision$".
     1723   function check-entry-with-mask returns logical ( input p-element as character, input p-list as character, input p-delimiter as character ) :
     1724     define variable p-entry   as logical   no-undo .
     1725     define variable v-ind as integer   no-undo .
     1726     if p-delimiter = "*":U then do:
     1727       message
     1728         vss-workfile "(check-entry-with-mask)" vss-revision vss-description skip
     1729         substitute('Разделитель не может быть равный "&1"', p-delimiter ) skip
     1730         view-as alert-box error .
     1731       return ? .
     1732     end.
     1733     assign
     1734       p-entry = true
     1735     .
     1736     if lookup( p-element, p-list, p-delimiter ) = 0 then do:
     1737       assign
     1738         p-entry = false
     1739       .
     1740       if num-entries( p-list, "*":U ) > 1 then do:
     1741         block_check-list:
     1742         do v-ind = 1 to num-entries( p-list, p-delimiter )
     1743         :
     1744           if p-element matches entry( v-ind, p-list, p-delimiter ) then do:
     1745             assign
     1746               p-entry = true
     1747             .
     1748             leave block_check-list .
     1749           end.
     1750         end.
     1751       end.
     1752     end.
     1753     return p-entry .
     1754   end function .
     1755   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1756   procedure reprumpr_print-plain-text :
     1757   define input parameter p-dir-name as character no-undo .
     1758   define input parameter p-subdir-name as character no-undo .
     1759   define input parameter p-custom-name as character no-undo .
     1760   define input parameter p-disable-option as integer no-undo .
     1761   define input parameter p-font-number as integer no-undo .
     1762   define variable v-file-name as character no-undo .
     1763   define variable v-report-name as character no-undo .
     1764   define variable v-err-status as integer no-undo .
     1765   define variable v-err-mess as character no-undo .
     1766   v-file-name = p-dir-name + (if p-subdir-name <> ''
     1767                               then (p-subdir-name + chr(47))
     1768                               else '') +
     1769                 p-custom-name.
     1770   run prn-lib-get-report-name  in this-procedure (
     1771                                                     input parParentProc
     1772                                                     ,output v-report-name
     1773                                                   ).
     1774   os-copy
     1775   value(v-report-name)
     1776   value(v-file-name)
     1777   .
     1778   assign
     1779   v-err-status = os-error
     1780   .
     1781   if v-err-status <> 0 then do:
     1782     run gbl/os-errnm.p ( input v-err-status
     1783                         ,output v-err-mess).
     1784     return error v-err-mess.
     1785   end.
     1786   else do:
     1787     run cb_fill-report-destination in p-parent-handle (  input p-rdbh
     1788                                                   ,input p-report-id
     1789                                                   ,input 'text':U
     1790                                                   ,input v-file-name
     1791                                                   ,input string(p-disable-option) + chr(4) + string(p-font-number)
     1792                                                   ).
     1793   end.
     1794   end procedure.
     1795   procedure reprumpr_print-printer :
     1796   define input parameter p-font-number as integer no-undo .
     1797   define input parameter p-flags as integer no-undo .
     1798   define variable v-quest-print as logical no-undo .
     1799   define variable lok as logical no-undo .
     1800   define variable v-report-name as character no-undo .
     1801   run get-quest-print in parparentproc ( output v-quest-print) .
     1802   if not v-quest-print then do:
     1803       .
     1804     run prn-lib-get-report-name  in this-procedure (
     1805                                                       input parParentProc
     1806                                                      ,output v-report-name
     1807                                                     ).
     1808     run adecomm/_osprint.p
     1809       (input  ?
     1810       ,input  v-report-name
     1811       ,input  p-font-number
     1812       ,input  p-flags
     1813       ,input  0
     1814       ,input  0
     1815       ,output lok
     1816       ).
     1817     if not lok then do:
     1818     end.
     1819   end.
     1820   end procedure.
     1821   define stream temp-stream.
     1822   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1823   procedure prnexldl_clear:
     1824   define input parameter p-txl-file-name as character no-undo .
     1825   define variable v-template-file-name as character no-undo .
     1826   define variable v-vb-file-name as character no-undo .
     1827   define variable v-data-header-filename as character no-undo .
     1828   define variable v-data-filename as character no-undo .
     1829   if search( p-txl-file-name ) <> ? then do:
     1830     input stream temp-stream from value( p-txl-file-name ).
     1831     repeat
     1832     :
     1833         import stream temp-stream v-template-file-name   .
     1834         import stream temp-stream v-vb-file-name         .
     1835         import stream temp-stream v-data-header-filename .
     1836         os-delete value(v-data-header-filename).
     1837         import stream temp-stream v-data-filename        .
     1838         os-delete value(v-data-filename).
     1839     end.
     1840     input stream temp-stream close.
     1841     os-delete value( p-txl-file-name ).
     1842   end.
     1843   end procedure .
     1844   define stream reprumpr_in.
     1845   procedure reprumpr_print-xlt :
     1846   define input parameter p-dir-name as character no-undo .
     1847   define input parameter p-subdir-name as character no-undo .
     1848   define input parameter p-custom-name as character no-undo .
     1849   define input parameter p-disable-option as integer no-undo .
     1850   define input parameter p-font-number as integer no-undo .
     1851   define buffer buf_temp-param for temp-param .
     1852   define variable v-report-num            as integer no-undo .
     1853   define variable v-filename              as character    no-undo .
     1854   define variable v-obj-dir               as character    no-undo .
     1855   define variable v-report-filename       as character    no-undo .
     1856   define variable v-home-dir-filename     as character    no-undo .
     1857   define variable v-error-num             as integer      no-undo .
     1858   define variable v-template-file-name    as character    no-undo .
     1859   define variable v-vb-file-name          as character    no-undo .
     1860   define variable v-data-header-filename  as character    no-undo .
     1861   define variable v-data-filename         as character    no-undo .
     1862   define variable v-excel-file-name       as character    no-undo .
     1863   define variable v-err-message           as character    no-undo .
     1864   define variable v-os-err-str            as character    no-undo .
     1865   define variable v-report-dir            as character    no-undo .
     1866   do for buf_temp-param
     1867   on error undo, return error return-value
     1868   :
     1869   assign
     1870     v-report-dir  = trim( replace( p-dir-name, '/' , '\' ) , '\' )
     1871   .
     1872     assign
     1873     v-report-num = g#report-num
     1874     v-obj-dir           = v-report-dir + chr(47) +
     1875                           (if p-subdir-name <> '' then (p-subdir-name + chr(47)) else '')
     1876     v-filename          = string( session:temp-directory ) + "rpt" + string( v-report-num )
     1877     v-excel-file-name   = string( session:temp-directory ) + "rpt" + string( v-report-num ) + ".xls"
     1878     v-home-dir-filename = v-obj-dir +  p-custom-name
     1879     .
     1880     os-delete value( v-filename + ".txl" )  .
     1881     os-rename
     1882       value( string( session:temp-directory ) + "$" + string( v-report-num ) + ".txl" )
     1883       value( v-filename + ".txl" )
     1884     .
     1885     assign
     1886       v-filename = search( v-filename + ".txl" )
     1887     .
     1888     if v-filename = "" or v-filename = ?
     1889     then do:
     1890       assign
     1891         v-err-message = v-err-message + substitute( "Не найден файл &1 для формирования Excel-файла по объекту p-custom-name"
     1892                                                   , string( session:temp-directory ) + "rpt" + string( v-report-num )
     1893                                                   )
     1894       .
     1895       return error v-err-message.
     1896     end.
     1897     input stream reprumpr_in from value( v-filename ).
     1898     import stream reprumpr_in v-template-file-name   no-error .
     1899     import stream reprumpr_in v-vb-file-name         no-error .
     1900     import stream reprumpr_in v-data-header-filename no-error .
     1901     import stream reprumpr_in v-data-filename        no-error .
     1902     input stream reprumpr_in close.
     1903     if search( v-template-file-name ) = ?
     1904     then do:
     1905       assign
     1906         v-err-message = v-err-message + substitute( "Не найден шаблон Excel для вывода данных.&2Указан файл шаблона:&1&2&2"
     1907                                                   , v-template-file-name
     1908                                                   , chr(10)
     1909                                                   )
     1910       .
     1911       return error v-err-message.
     1912     end.
     1913     if search( v-vb-file-name ) = ?
     1914     then do:
     1915       assign
     1916         v-err-message = v-err-message + substitute( "Не найден текст программы заполнения шаблона Excel.&3Файл шаблона:&1&3Указан файл программы:&2&3&3"
     1917                                                   , v-template-file-name
     1918                                                   , v-vb-file-name
     1919                                                   , chr(10)
     1920                                                   )
     1921       .
     1922       return error v-err-message.
     1923     end.
     1924     if v-data-header-filename <> "":U
     1925     and search( v-data-header-filename ) = ?
     1926     then do:
     1927       assign
     1928         v-err-message = v-err-message + substitute( "Не найден файл шапки.&3Файл шаблона:&1&3Указан файл шапки:&2&3&3"
     1929                                                   , v-template-file-name
     1930                                                   , v-data-header-filename
     1931                                                   , chr(10)
     1932                                                   )
     1933       .
     1934       return error v-err-message.
     1935     end.
     1936     if v-data-filename <> "":U
     1937     and search( v-data-filename )   = ?
     1938     then do:
     1939       assign
     1940         v-err-message = v-err-message + substitute( "Не найден файл строк данных.&3Файл шаблона:&1&3Указан файл строк данных:&2&3&3"
     1941                                                   , v-template-file-name
     1942                                                   , v-data-filename
     1943                                                   , chr(10)
     1944                                                   )
     1945       .
     1946       return error v-err-message.
     1947     end.
     1948     create buf_temp-param.
     1949     assign
     1950       v-template-file-name = search( v-template-file-name )
     1951       file-info :file-name = v-template-file-name
     1952       v-template-file-name = file-info :full-pathname
     1953       v-vb-file-name       = search( v-vb-file-name )
     1954       file-info :file-name = v-vb-file-name
     1955       v-vb-file-name       = file-info :full-pathname
     1956     .
     1957     if v-template-file-name = ? or v-template-file-name = "":U
     1958     then do:
     1959       RETURN error substitute("Не найден шаблон &1", v-template-file-name).
     1960     end.
     1961     run paramls-write in this-procedure ( input "template":U
     1962                                         , input "template-file-name":U
     1963                                         , input v-template-file-name
     1964                                         ).
     1965     run paramls-write in this-procedure ( input "template":U
     1966                                         , input "vb-file-name":U
     1967                                         , input v-vb-file-name
     1968                                         ).
     1969     run paramls-write in this-procedure ( input "data":U
     1970                                         , input "data-header-filename":U
     1971                                         , input v-data-header-filename
     1972                                         ).
     1973     run paramls-write in this-procedure ( input "data":U
     1974                                         , input "data-filename":U
     1975                                         , input v-data-filename
     1976                                         ).
     1977     run paramls-write in this-procedure ( input "saveas":U
     1978                                         , input "excel-file-name":U
     1979                                         , input v-excel-file-name
     1980                                         ).
     1981     run paramls-write in this-procedure ( input "file":U
     1982                                         , input "file-no-open":U
     1983                                         , input "yes":U
     1984                                         ).
     1985     run gbl/macroxlt.p ( input-output table buf_temp-param ) no-error.
     1986     if error-status :error
     1987     then do:
     1988       assign
     1989         v-err-message = v-err-message + substitute( "&1&2&3&4Ошибка создания файла Excel.&4&5&4&6&4&7&4&8&4&4"
     1990                                                   , vss-workfile
     1991                                                   , vss-revision
     1992                                                   , vss-description
     1993                                                   , chr(10)
     1994                                                   , return-value
     1995                                                   , trim(error-status :get-message(1))
     1996                                                   , trim(error-status :get-message(2))
     1997                                                   , trim(error-status :get-message(3))
     1998                                                   )
     1999       .
     2000       return error v-err-message.
     2001     end.
     2002     run prnexldl_clear in this-procedure ( input v-filename) no-error.
     2003     if error-status :error
     2004     then do:
     2005       assign
     2006         v-err-message = v-err-message + substitute( "Ошибка удаления файла &1: &2 &3&3"
     2007                                                   , v-filename
     2008                                                   , return-value
     2009                                                   , chr(10)
     2010                                                   )
     2011       .
     2012       return error v-err-message.
     2013     end.
     2014     run gbl/dir-cre.p ( input v-obj-dir ) no-error  .
     2015     if error-status :error
     2016     then do:
     2017       assign
     2018         v-err-message = v-err-message + substitute( "Ошибка создания директории &1: &2&4&3&4&4"
     2019                                                   , v-filename
     2020                                                   , return-value
     2021                                                   , trim(error-status :get-message(1))
     2022                                                   , chr(10)
     2023                                                   )
     2024       .
     2025     end.
     2026     run gbl/del-file.p ( input v-home-dir-filename ) no-error .
     2027     if error-status :error
     2028     then do:
     2029       assign
     2030         v-err-message = v-err-message + substitute( "Ошибка удаления файла &1: &2 &3&3"
     2031                                                   , v-home-dir-filename
     2032                                                   , return-value
     2033                                                   , chr(10)
     2034                                                   )
     2035       .
     2036       return error v-err-message.
     2037     end.
     2038     run gbl/ren-file.p ( input v-excel-file-name
     2039                     , input v-home-dir-filename
     2040                     ) no-error .
     2041     if error-status :error
     2042     then do:
     2043       assign
     2044         v-err-message = v-err-message + substitute( "Ошибка перемещения файла &1 -> &2: &3&4&4"
     2045                                                   , v-excel-file-name
     2046                                                   , v-home-dir-filename
     2047                                                   , return-value
     2048                                                   , chr(10)
     2049                                                   )
     2050       .
     2051       return error v-err-message.
     2052     end.
     2053     run cb_fill-report-destination in p-parent-handle (  input p-rdbh
     2054                                                   ,input p-report-id
     2055                                                   ,input 'excel':U
     2056                                                   ,input v-home-dir-filename
     2057                                                   ,input string(p-disable-option) + chr(4) + string(p-font-number)
     2058                                                   ).
