     2920   define new global shared variable g#trdcalib as handle no-undo.
     2921   procedure wthcattr-sprcli :
     2922   define input parameter parparentproc  as widget-handle no-undo.
     2923   define input parameter p-mode  as character no-undo.
     2924   define input-output parameter p-value as character no-undo .
     2925   define output parameter p-setted as logical no-undo .
     2926     DEFINE VARIABLE v-value as character no-undo .
     2927     define variable v-cli-type as character no-undo .
     2928     define variable v-cli-code as integer no-undo .
     2929     define buffer buf_clients   for ub.clients.
     2930     define variable v_rid as character no-undo.
     2931     define variable ref-rec as recid no-undo .
     2932     do
     2933     on error undo, return error
     2934     :
     2935         v-value = p-value.
     2936      if p-value <> '':U then do:
     2937       assign
     2938       v-cli-type = substring(p-value, 1, 3)
     2939       v-cli-code = integer(substring(p-value, 4))
     2940       no-error.
     2941       if error-status:error then do:
     2942         assign
     2943         v-cli-type = '':U
     2944         v-cli-code = 0
     2945         .
     2946       end.
     2947      end.
     2948      FIND FIRST buf_clients NO-LOCK WHERE
     2949               buf_clients.obj-type = v-cli-type AND
     2950               buf_clients.obj-code = v-cli-code  NO-ERROR.
     2951      IF available(buf_clients) then do:
     2952       run ref/cli-all.w (
     2953                   input parparentproc
     2954                  ,input if p-mode = 'ИЗМЕНЕНИЕ':U then "b-sel":U else "":U
     2955                  ,input v-cli-type
     2956                  ,input 'все':U
     2957                  ,input 'все':U
     2958                  ,input RECID( buf_clients )
     2959                  ,input ",,,,,,NO"
     2960                  ,input ?
     2961                  ,OUTPUT v_rid ).
     2962     END.
     2963     ELSE if p-mode = 'ИЗМЕНЕНИЕ':U then DO:
     2964       run ref/cli-all.w (
     2965                    input parparentproc
     2966                   ,INPUT "b-sel":U
     2967                  ,input  v-cli-type
     2968                  ,input 'все':U
     2969                  ,input 'текущие':U
     2970                  ,input ?
     2971                  ,input ",,,,,,NO"
     2972                  ,input ?
     2973                  ,OUTPUT v_rid ).
     2974     END.
     2975     else do:
     2976       message
     2977       if p-value = "":U then 'Атрибут не задан!'
     2978       else substitute('Не найден клиент &1',p-value)
     2979       view-as alert-box warning.
     2980     end.
     2981     IF v_rid <> ? AND v_rid <> "":U THEN DO:
     2982       ASSIGN ref-rec = INT( v_rid ) NO-ERROR.
     2983       IF ERROR-STATUS:ERROR THEN DO:
     2984           RETURN NO-APPLY.
     2985       END.
     2986       FIND FIRST buf_clients NO-LOCK WHERE
     2987                  RECID( buf_clients ) = ref-rec NO-ERROR.
     2988       IF AVAIL buf_clients THEN DO:
     2989         v-value = buf_clients.obj-type + string(buf_clients.obj-code, ">>>>>>>>9").
     2990       end.
     2991     end.
     2992     if v-value <> p-value then do:
     2993       p-value = v-value.
     2994       p-setted = yes.
     2995     end.
     2996     end.
     2997   end procedure.
     2998     define new global shared variable g#wthcalib as handle no-undo.
