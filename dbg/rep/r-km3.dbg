     3577   procedure torgconf-get-sup-param :
     3578   define input parameter p-obj-type           as character        no-undo.
     3579   define input parameter p-obj-code           as integer          no-undo.
     3580   define input parameter p-curr-code          as integer          no-undo.
     3581       define variable v-host-code    as integer      no-undo.
     3582       define variable v-par-type     as character    no-undo.
     3583   do
     3584   on error undo, return error
     3585   :
     3586       assign
     3587          v-torgconf-sup-host-code = v-host-code
     3588       .
     3589       if v-torgconf-sup-host-code = 0
     3590       then do:
     3591           assign
     3592               v-torgconf-sup-host-name           = "":U
     3593               v-torgconf-sup-host-addres         = "":U
     3594               v-torgconf-sup-host-post-addres    = "":U
     3595               v-torgconf-sup-host-phone          = "":U
     3596               v-torgconf-sup-host-inn            = "":U
     3597               v-torgconf-sup-host-kpp            = "":U
     3598               v-torgconf-sup-host-okpo           = "":U
     3599               v-torgconf-sup-host-egrip-date     = "":U
     3600               v-torgconf-sup-host-egrip-num      = "":U
     3601           .
     3602       end.
     3603       else do:
     3604           run fmtcli-get-client in this-procedure (
     3605                 input 'орг':U
     3606               , input v-torgconf-sup-host-code
     3607           ).
     3608           assign
     3609               v-torgconf-sup-host-name        = v-fmtcli-name
     3610               v-torgconf-sup-host-engl-name   = v-fmtcli-engl-name
     3611               v-torgconf-sup-host-addres      = v-fmtcli-full-addres
     3612               v-torgconf-sup-host-post-addres = v-fmtcli-post-addres
     3613               v-torgconf-sup-host-phone       = v-fmtcli-phone
     3614               v-torgconf-sup-host-inn         = v-fmtcli-inn
     3615               v-torgconf-sup-host-kpp         = v-fmtcli-kpp
     3616               v-torgconf-sup-host-okpo        = v-fmtcli-okpo
     3617           .
     3618           run gbl/clntat-v.p (
     3619                 input 'орг':U
     3620               , input v-torgconf-sup-host-code
     3621               , input 'egrip-date':U
     3622               , output v-torgconf-sup-host-egrip-date
     3623               , output v-par-type
     3624           ).
     3625           run gbl/clntat-v.p (
     3626                 input 'орг':U
     3627               , input v-torgconf-sup-host-code
     3628               , input 'egrip-num':U
     3629               , output v-torgconf-sup-host-egrip-num
     3630               , output v-par-type
     3631           ).
     3632           run fmtcli-get-bank in this-procedure (
     3633                 input v-host-code
     3634               , input 'орг':U
     3635               , input v-torgconf-sup-host-code
     3636               , input p-curr-code
     3637           ).
     3638       end.
     3639       assign
     3640           v-torgconf-sup-schet-exists = v-fmtcli-schet-exists
     3641           v-torgconf-sup-bank-exists  = v-fmtcli-bank-exists
     3642           v-torgconf-sup-bank-r-schet = v-fmtcli-bank-r-schet
     3643           v-torgconf-sup-bank-c-schet = v-fmtcli-bank-c-schet
     3644           v-torgconf-sup-bank-bik     = v-fmtcli-bank-bik
     3645           v-torgconf-sup-bank-name    = v-fmtcli-bank-name
     3646           v-torgconf-sup-bank-addres  = v-fmtcli-bank-addres
     3647           v-torgconf-sup-bank-city    = v-fmtcli-bank-city
     3648       .
     3649       assign
     3650           v-torgconf-sup-obj-type = p-obj-type
     3651           v-torgconf-sup-obj-code = p-obj-code
     3652       .
     3653       if trim(p-obj-type) <> ""
     3654       and p-obj-code <> 0
     3655       then do:
     3656       run fmtcli-get-client in this-procedure (
     3657             input p-obj-type
     3658           , input p-obj-code
     3659       ).
     3660       assign
     3661           v-torgconf-sup-obj-name        = v-fmtcli-name
     3662           v-torgconf-sup-obj-engl-name   = v-fmtcli-engl-name
     3663           v-torgconf-sup-obj-addres      = v-fmtcli-full-addres
     3664           v-torgconf-temp-post-addres    = v-fmtcli-post-addres
     3665           v-torgconf-sup-obj-phone       = v-fmtcli-phone
     3666           v-torgconf-sup-obj-inn         = v-fmtcli-inn
     3667           v-torgconf-sup-obj-okpo        = v-fmtcli-okpo
     3668       .
     3669      end.
     3670      end.
     3671   end procedure.
     3672   procedure torgconf-get-cli-param :
     3673   define input parameter p-host-obj-code      as integer          no-undo.
     3674   define input parameter p-obj-type           as character        no-undo.
     3675   define input parameter p-obj-code           as integer          no-undo.
     3676   define input parameter p-curr-code          as integer          no-undo.
     3677       define variable v-host-code    as integer      no-undo.
     3678   do
     3679   on error undo, return error
     3680   :
     3681       assign
     3682           v-torgconf-cli-type = p-obj-type
     3683           v-torgconf-cli-code = p-obj-code
     3684       .
     3685       run fmtcli-get-client in this-procedure (
     3686             input p-obj-type
     3687           , input p-obj-code
     3688       ).
     3689       assign
     3690           v-torgconf-cli-name         = trim( v-fmtcli-name          )
     3691           v-torgconf-cli-engl-name    = trim( v-fmtcli-engl-name          )
     3692           v-torgconf-cli-addres       = trim( v-fmtcli-full-addres   )
     3693           v-torgconf-cli-post-addres  = trim( v-fmtcli-post-addres   )
     3694           v-torgconf-cli-phone        = trim( v-fmtcli-phone         )
     3695           v-torgconf-cli-inn          = trim( v-fmtcli-inn           )
     3696           v-torgconf-cli-kpp          = trim( v-fmtcli-kpp           )
     3697           v-torgconf-cli-okpo         = trim( v-fmtcli-okpo          )
     3698       .
     3699      run fmtcli-get-bank in this-procedure (
     3700             input p-host-obj-code
     3701           , input p-obj-type
     3702           , input p-obj-code
     3703           , input p-curr-code
     3704       ).
     3705       assign
     3706           v-torgconf-cli-schet-exists = v-fmtcli-schet-exists
     3707           v-torgconf-cli-bank-exists  = v-fmtcli-bank-exists
     3708           v-torgconf-cli-bank-r-schet = v-fmtcli-bank-r-schet
     3709           v-torgconf-cli-bank-c-schet = v-fmtcli-bank-c-schet
     3710           v-torgconf-cli-bank-bik     = v-fmtcli-bank-bik
     3711           v-torgconf-cli-bank-name    = v-fmtcli-bank-name
     3712           v-torgconf-cli-bank-addres  = v-fmtcli-bank-addres
     3713           v-torgconf-cli-bank-city    = v-fmtcli-bank-city
     3714       .
     3715   end.
     3716   end procedure.
     3717   procedure torgconf-get-ship-param :
     3718   define input parameter p-host-obj-code      as integer          no-undo.
     3719   define input parameter p-obj-type           as character        no-undo.
     3720   define input parameter p-obj-code           as integer          no-undo.
     3721   define input parameter p-curr-code          as integer          no-undo.
     3722       define variable v-host-code    as integer      no-undo.
     3723   do
     3724   on error undo, return error
     3725   :
     3726       assign
     3727           v-torgconf-ship-type = p-obj-type
     3728           v-torgconf-ship-code = p-obj-code
     3729       .
     3730       if trim(p-obj-type) = ""
     3731       and p-obj-code = 0
     3732       then do:
     3733       assign
     3734           v-torgconf-ship-name         = "":U
     3735           v-torgconf-ship-addres       = "":U
     3736           v-torgconf-ship-post-addres  = "":U
     3737           v-torgconf-ship-phone        = "":U
     3738           v-torgconf-ship-inn          = "":U
     3739           v-torgconf-ship-kpp          = "":U
     3740           v-torgconf-ship-okpo         = "":U
     3741       .
     3742       end.
     3743       else do:
     3744       run fmtcli-get-client in this-procedure (
     3745             input p-obj-type
     3746           , input p-obj-code
     3747       ).
     3748       assign
     3749           v-torgconf-ship-name         = trim( v-fmtcli-name          )
     3750           v-torgconf-ship-engl-name    = trim( v-fmtcli-engl-name          )
     3751           v-torgconf-ship-addres       = trim( v-fmtcli-full-addres   )
     3752           v-torgconf-ship-post-addres  = trim( v-fmtcli-post-addres   )
     3753           v-torgconf-ship-phone        = trim( v-fmtcli-phone         )
     3754           v-torgconf-ship-inn          = trim( v-fmtcli-inn           )
     3755           v-torgconf-ship-kpp          = trim( v-fmtcli-kpp           )
     3756           v-torgconf-ship-okpo         = trim( v-fmtcli-okpo          )
     3757       .
     3758       end.
     3759           run fmtcli-get-bank in this-procedure (
     3760             input p-host-obj-code
     3761           , input p-obj-type
     3762           , input p-obj-code
     3763           , input p-curr-code
     3764       ).
     3765       assign
     3766           v-torgconf-ship-schet-exists = v-fmtcli-schet-exists
     3767           v-torgconf-ship-bank-exists  = v-fmtcli-bank-exists
     3768           v-torgconf-ship-bank-r-schet = v-fmtcli-bank-r-schet
     3769           v-torgconf-ship-bank-c-schet = v-fmtcli-bank-c-schet
     3770           v-torgconf-ship-bank-bik     = v-fmtcli-bank-bik
     3771           v-torgconf-ship-bank-name    = v-fmtcli-bank-name
     3772           v-torgconf-ship-bank-addres  = v-fmtcli-bank-addres
     3773           v-torgconf-ship-bank-city    = v-fmtcli-bank-city
     3774       .
     3775   end.
     3776   end procedure.
     3777   procedure torgconf-get-holdfirm-code :
     3778   define input parameter p-obj-type   as character        no-undo.
     3779   define input parameter p-obj-code   as integer          no-undo.
     3780   define output parameter p-firm-code as integer          no-undo.
     3781       define variable v-firm-code-str     as character    no-undo.
     3782       define variable v-par-type          as character    no-undo.
     3783       define buffer buf_clients       for ub.clients.
     3784   do
     3785   for buf_clients
     3786   on error undo, return error
     3787   :
     3788       run gbl/clntat-v.p (
     3789             input p-obj-type
     3790           , input p-obj-code
     3791           , input 'holdfirm-code':U
     3792           , output v-firm-code-str
     3793           , output v-par-type
     3794       ).
     3795       assign
     3796           p-firm-code = integer( v-firm-code-str )
     3797       no-error.
     3798       if error-status :error
     3799       then do:
     3800           message
     3801               "Неверно задан код фирмы для печати накладных."
     3802           view-as alert-box warning.
     3803           assign
     3804               p-firm-code = 0
     3805           .
     3806       end.
     3807       else do:
     3808           find first buf_clients no-lock
     3809                where buf_clients.obj-type = 'орг':U
     3810                  and buf_clients.obj-code = p-firm-code
     3811           no-error.
     3812           if not available buf_clients
     3813           then do:
     3814               message
     3815                   "Включен параметр 'Список печатных форм, для которых должна быть задана фирма для печати накладных' (outhold)" skip
     3816                   "Не найдена фирма по заданному коду фирмы для печати накладных."
     3817               view-as alert-box warning.
     3818               assign
     3819                   p-firm-code = 0
     3820               .
     3821           end.
     3822       end.
     3823   end.
     3824   end procedure.
     3825   procedure torgconf-get-post-head:
     3826   define input  parameter p-obj-type             as character        no-undo.
     3827   define input  parameter p-obj-code             as integer          no-undo.
     3828   define output parameter p-torgconf-post-head   as character        no-undo.
     3829      define variable v-host-code         as integer      no-undo.
     3830      define buffer buf_sysconf     for ub.sysconf.
     3831        assign
     3832         p-torgconf-post-head  = ""
     3833        .
     3834   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3835   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3836     (input  p-obj-type
     3837     ,input  p-obj-code
     3838     ,output v-host-code
     3839     )  .
     3840      find first buf_sysconf no-lock
     3841      where buf_sysconf.host-code = v-host-code
     3842      no-error.
     3843      if available buf_sysconf
     3844      then do:
     3845         assign
     3846            p-torgconf-post-head = buf_sysconf.head-position
     3847         .
     3848      end.
     3849   end procedure.
     3850   procedure torgconf-get-storekeeper:
     3851   define input  parameter p-wrkr                   as integer          no-undo.
     3852   define output parameter p-torgconf-wrkr-name     as character        no-undo.
     3853   define output parameter p-torgconf-post          as character        no-undo.
     3854      define buffer buf_sysconf     for ub.sysconf.
     3855      define buffer buf_person      for ub.person.
     3856      define buffer buf_shop        for ub.shop .
     3857      define buffer buf_store       for ub.store .
     3858      if v-torgconf-outC = "no_print"
     3859      then do:
     3860         assign p-torgconf-post = ""
     3861                p-torgconf-wrkr-name = ""
     3862                .
     3863      end.
     3864      if v-torgconf-outC = "clad_doc"
     3865      then do:
     3866         run rep/get-psn.p
     3867               (input  p-wrkr
     3868               ,output p-torgconf-wrkr-name
     3869               ) .
     3870         find first buf_person no-lock
     3871         where buf_person.psn-code = p-wrkr
     3872         no-error.
     3873         if available buf_person
     3874         then do:
     3875           p-torgconf-post = buf_person.position.
     3876         end.
     3877         if p-torgconf-post = "?":U then p-torgconf-post = "".
     3878         if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     3879      end.
     3880      if v-torgconf-outC = "clad_obj"
     3881      then do:
     3882         CASE v-torgconf-self-obj-type:
     3883         WHEN 'маг':U
     3884         THEN DO:
     3885            find first buf_shop no-lock
     3886            where buf_shop.obj-code = v-torgconf-self-obj-code
     3887            .
     3888            assign
     3889               p-torgconf-wrkr-name = buf_shop.store-man
     3890               p-torgconf-post = ""
     3891            .
     3892            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     3893         END.
     3894         WHEN 'скл':U
     3895         THEN DO:
     3896            find first buf_store no-lock
     3897            where buf_store.obj-code = v-torgconf-self-obj-code
     3898            .
     3899            assign
     3900               p-torgconf-wrkr-name = buf_store.store-man
     3901               p-torgconf-post = ""
     3902            .
     3903            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     3904         END.
     3905         OTHERWISE DO:
     3906            assign
     3907               p-torgconf-post = "":U
     3908               p-torgconf-wrkr-name = "":U
     3909            .
     3910         END.
     3911         END CASE.
     3912      end.
     3913    end procedure.
     3914   procedure torgconf-get-form-header :
     3915   define input parameter p-for-inverse    as logical          no-undo.
     3916   define input parameter p-doc-code       as character        no-undo.
     3917   define input parameter p-print-doc      as logical          no-undo.
     3918   define input parameter p-doc-date       as date             no-undo.
     3919   define input parameter p-fact-date      as date             no-undo.
     3920   define input parameter p-doc-type       as character        no-undo.
     3921   define input parameter p-status_        as character        no-undo.
     3922   define input parameter p-reverse        as logical          no-undo.
     3923   define input parameter p-sf-par         as logical          no-undo.
     3924       define variable v-attr-type         as character    no-undo.
     3925       define variable v-doc-code-standard as logical      no-undo.
     3926       define variable v-doc-date-standard as logical      no-undo.
     3927       define variable v-par-consignee-addres  as character    no-undo.
     3928       define variable v-host-code         as integer      no-undo.
     3929       define variable v-dcode-attr        as character    no-undo.
     3930       define variable v-ddate-attr        as character    no-undo.
     3931       define variable v-doc-date          as character    no-undo.
     3932       define variable v-doc-code          as character    no-undo.
     3933       define variable v-par-type          as character    no-undo.
     3934       define variable v-attr              as character    no-undo.
     3935       define buffer buf_firm          for ub.firm .
     3936       define buffer buf_clients       for ub.clients .
     3937       define buffer buf_sysconf       for ub.sysconf .
     3938       define buffer buf_shop          for ub.shop .
     3939       define buffer buf_store         for ub.store .
     3940       define buffer buf_person        for ub.person .
     3941       define buffer buf_trn-doc       for ub.trn-doc .
     3942       define buffer buf_wth-doc       for ub.wth-doc .
     3943       do
     3944   for buf_firm
     3945     , buf_clients
     3946     , buf_sysconf
     3947     , buf_shop
     3948     , buf_trn-doc
     3949     , buf_person
     3950     , buf_wth-doc
     3951   on error undo, return error
     3952   :
     3953       if p-doc-type = 'при':U
     3954       or p-doc-type = 'возврат':U
     3955       then do:
     3956           assign
     3957               v-torgconf-supplier         = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     3958                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     3959               v-torgconf-suppi            = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     3960                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     3961               v-torgconf-saler            = substitute( "&1&2&3&4&5", v-torgconf-self-host-name, ( if v-torgconf-self-host-addres = "":U then "":U else ", " ),
     3962                                             v-torgconf-self-host-addres, ( if v-torgconf-self-host-phone = "":U then "":U else ", " ),v-torgconf-self-host-phone )
     3963               v-torgconf-consignee        = substitute( "&1&2&3&4&5", v-torgconf-sup-host-name, ( if v-torgconf-sup-host-addres = "":U then "":U else ", " ),
     3964                                             v-torgconf-sup-host-addres, ( if v-torgconf-sup-host-phone = "":U then "":U else ", " ), v-torgconf-sup-host-phone  )
     3965               v-torgconf-supplier-okpo    = v-torgconf-cli-okpo
     3966               v-torgconf-saler-okpo       = v-torgconf-self-host-okpo
     3967               v-torgconf-consignee-okpo   = v-torgconf-sup-host-okpo
     3968               v-torgconf-supplier-code    = substitute( "&1", v-torgconf-cli-code         )
     3969               v-torgconf-supplier-type    = v-torgconf-cli-type
     3970               v-torgconf-saler-code       = substitute( "&1", v-torgconf-self-host-code   )
     3971               v-torgconf-saler-type       = v-torgconf-self-host-type
     3972               v-torgconf-consignee-code   = substitute( "&1", v-torgconf-sup-host-code   )
     3973               v-torgconf-consignee-type   = v-torgconf-sup-host-type
     3974               v-torgconf-supplier-name    = substitute( "&1", v-torgconf-cli-name         )
     3975               v-torgconf-saler-name       = substitute( "&1", v-torgconf-self-host-name   )
     3976               v-torgconf-consignee-name   = substitute( "&1", v-torgconf-sup-host-name   )
     3977               v-torgconf-supplier-addr    = substitute( "&1", v-torgconf-cli-addres       )
     3978               v-torgconf-saler-addr       = substitute( "&1", v-torgconf-self-host-addres )
     3979               v-torgconf-consignee-addr   = substitute( "&1", v-torgconf-sup-host-addres )
     3980               v-torgconf-supplier-inn     = substitute( "&1", v-torgconf-cli-inn          )
     3981               v-torgconf-supplier-engl-name     = substitute( "&1", v-torgconf-cli-engl-name          )
     3982               v-torgconf-saler-inn        = substitute( "&1", v-torgconf-self-host-inn    )
     3983               v-torgconf-consignee-inn    = substitute( "&1", v-torgconf-sup-host-inn    )
     3984               v-torgconf-supplier-kpp     = substitute( "&1", v-torgconf-cli-kpp          )
     3985               v-torgconf-saler-kpp        = substitute( "&1", v-torgconf-self-host-kpp    )
     3986               v-torgconf-consignee-kpp    = substitute( "&1", v-torgconf-sup-host-kpp    )
     3987           .
     3988           if v-torgconf-cli-schet-exists = yes
     3989           AND v-form-name                  = "torg12":U
     3990           then do:
     3991               assign
     3992                   v-torgconf-supplier = v-torgconf-supplier
     3993                       + substitute( ", р/с &1 к/с &2"
     3994                                   , v-torgconf-cli-bank-r-schet
     3995                                   , v-torgconf-cli-bank-c-schet
     3996                                   )
     3997                   v-torgconf-suppi = v-torgconf-supplier
     3998                       + substitute( ", р/с &1 к/с &2"
     3999                                   , v-torgconf-cli-bank-r-schet
     4000                                   , v-torgconf-cli-bank-c-schet
     4001                                   )
     4002               .
     4003               if v-torgconf-cli-bank-exists = yes
     4004               then do:
     4005                   assign
     4006                       v-torgconf-supplier = v-torgconf-supplier
     4007                           + substitute( " БИК &1 в &2 &3"
     4008                                       , v-torgconf-cli-bank-bik
     4009                                       , v-torgconf-cli-bank-name
     4010                                       ,(if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     4011                                       )
     4012                      v-torgconf-suppi = v-torgconf-supplier
     4013                           + substitute( " БИК &1 в &2 &3"
     4014                                       , v-torgconf-cli-bank-bik
     4015                                       , v-torgconf-cli-bank-name
     4016                                       ,(if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     4017                                       )
     4018                   .
     4019               end.
     4020           end.
     4021           if v-torgconf-self-schet-exists = yes
     4022           AND v-form-name                  = "torg12":U
     4023           then do:
     4024               assign
     4025                   v-torgconf-saler = v-torgconf-saler
     4026                       + substitute( ", р/с &1 к/с &2"
     4027                                   , v-torgconf-self-bank-r-schet
     4028                                   , v-torgconf-self-bank-c-schet
     4029                                   )
     4030               .
     4031               if v-torgconf-self-bank-exists = yes
     4032               then do:
     4033                   assign
     4034                       v-torgconf-saler = v-torgconf-saler
     4035                           + substitute( " БИК &1 в &2 &3"
     4036                                       , v-torgconf-self-bank-bik
     4037                                       , v-torgconf-self-bank-name
     4038                                       , v-torgconf-self-bank-addres
     4039                                       )
     4040                   .
     4041               end.
     4042           end.
     4043           if v-torgconf-sup-schet-exists = yes
     4044           AND v-form-name                  = "torg12":U
     4045           then do:
     4046               assign
     4047                   v-torgconf-consignee = v-torgconf-consignee
     4048                       + substitute( ", р/с &1 к/с &2"
     4049                                   , v-torgconf-sup-bank-r-schet
     4050                                   , v-torgconf-sup-bank-c-schet
     4051                                   )
     4052               .
     4053             if v-torgconf-sup-bank-exists = yes
     4054              then do:
     4055                assign
     4056                   v-torgconf-consignee = v-torgconf-consignee
     4057                           + substitute( " БИК &1 в &2 &3"
     4058                                       , v-torgconf-sup-bank-bik
     4059                                       , v-torgconf-sup-bank-name
     4060                                       , v-torgconf-sup-bank-addres
     4061                                       )
     4062                   .
     4063               end.
     4064           end.
     4065      if v-torgconf-outares = yes  AND v-form-name  = "torg12":U
     4066      then do:
     4067          assign
     4068            v-torgconf-supplier = substitute(  "&1&2&3 &4 &5&6"
