     5409            then do:
     5410   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5411   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     5412     (input  buf_wth-doc.obj-type
     5413     ,input  buf_wth-doc.obj-code
     5414     ,output v-host-code
     5415     )  .
     5416            end.
     5417         if v-torgconf-outogr = "no_print"
     5418            then do:
     5419               assign
     5420                  v-torgconf-ogr-name = ""
     5421                  v-torgconf-ogr-post = ""
     5422               .
     5423            end.
     5424         if v-torgconf-outogr  = "ruk_firm"
     5425               then do:
     5426               find first buf_sysconf no-lock
     5427               where buf_sysconf.host-code = v-host-code
     5428               no-error.
     5429               if available buf_sysconf
     5430               then do:
     5431                  assign
     5432                     v-torgconf-ogr-post = buf_sysconf.head-position
     5433                  .
     5434               end.
     5435               find first buf_clients no-lock
     5436                  where buf_clients.obj-type = 'орг':U
     5437                  and buf_clients.obj-code = v-host-code
     5438               .
     5439               find first buf_firm no-lock
     5440                  where buf_firm.firm-code = buf_clients.obj-code
     5441               .
     5442               assign
     5443                  v-torgconf-ogr-name = buf_firm.director
     5444               .
     5445            end.
     5446            if v-torgconf-outogr = "dir_obj"
     5447               then do:
     5448               find first buf_wth-doc no-lock
     5449               where buf_wth-doc.doc-code = p-doc-code
     5450               no-error.
     5451                  find first buf_shop no-lock
     5452                  where buf_shop.obj-code = buf_wth-doc.obj-code
     5453                  .
     5454                  assign
     5455                     v-torgconf-ogr-name = buf_shop.director
     5456                     v-torgconf-ogr-post = "Директор"
     5457                  .
     5458               end.
     5459         if v-torgconf-outogr = "manag_doc"
     5460            then do:
     5461               find first buf_wth-doc no-lock
     5462               where buf_wth-doc.doc-code = p-doc-code
     5463               no-error.
     5464               if available buf_wth-doc
     5465               then do:
     5466                  run rep/get-psn.p
     5467                  (input buf_wth-doc.deliver
     5468                  ,output v-torgconf-ogr-name
     5469                  ) .
     5470               end.
     5471               find first buf_person no-lock
     5472               where buf_person.psn-code = buf_wth-doc.deliver
     5473               no-error.
     5474               if available buf_person
     5475               then do:
     5476                  v-torgconf-ogr-post = buf_person.position.
     5477               end.
     5478               if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     5479               if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     5480            end.
     5481      end.
     5482   end.
     5483   end procedure.
     5484   procedure torgconf-get-outogr-param:
     5485       define input parameter p-form-name  as character    no-undo.
     5486       define input parameter p-host-code  as integer      no-undo.
     5487       define input parameter p-obj-type   as character    no-undo.
     5488       define input parameter p-obj-code   as integer      no-undo.
     5489       define input parameter p-doc-code   as character      no-undo.
     5490       define buffer buf_firm          for ub.firm .
     5491       define buffer buf_clients       for ub.clients .
     5492       define buffer buf_sysconf       for ub.sysconf .
     5493       define buffer buf_shop          for ub.shop .
     5494       define buffer buf_store         for ub.store .
     5495       define buffer buf_person        for ub.person .
     5496       define buffer buf_trn-doc       for ub.trn-doc .
     5497       define buffer buf_wth-doc       for ub.wth-doc .
     5498      if  p-form-name <> 'wthtrg12':U
     5499      and p-form-name <> 'wthfct':U
     5500      and p-form-name <> 'wthm11':U
     5501      then do:
     5502       find first buf_trn-doc no-lock
     5503       where buf_trn-doc.doc-code = p-doc-code
     5504       no-error.
     5505       if v-torgconf-outogr = "no_print"
     5506         then do:
     5507            assign
     5508               v-torgconf-ogr-name = ""
     5509               v-torgconf-ogr-post = ""
     5510            .
     5511         end.
     5512      if v-torgconf-outogr  = "ruk_firm"
     5513            then do:
     5514            find first buf_sysconf no-lock
     5515            where buf_sysconf.host-code = p-host-code
     5516            no-error.
     5517            if available buf_sysconf
     5518            then do:
     5519               assign
     5520                  v-torgconf-ogr-post = buf_sysconf.head-position
     5521               .
     5522            end.
     5523            find first buf_clients no-lock
     5524                where buf_clients.obj-type = 'орг':U
     5525                and buf_clients.obj-code = p-host-code
     5526            .
     5527            find first buf_firm no-lock
     5528                where buf_firm.firm-code = buf_clients.obj-code
     5529            .
     5530            assign
     5531                v-torgconf-ogr-name = buf_firm.director
     5532            .
     5533         end.
     5534         if v-torgconf-outogr = "dir_obj"
     5535            then do:
     5536            find first buf_trn-doc no-lock
     5537            where buf_trn-doc.doc-code = p-doc-code
     5538            no-error.
     5539               CASE buf_trn-doc.obj-type:
     5540               WHEN 'маг':U
     5541               THEN DO:
     5542                  find first buf_shop no-lock
     5543                  where buf_shop.obj-code = buf_trn-doc.obj-code
     5544                  .
     5545                  assign
     5546                     v-torgconf-ogr-name = buf_shop.director
     5547                     v-torgconf-ogr-post = "Директор"
     5548                  .
     5549               END.
     5550               WHEN 'скл':U
     5551               THEN DO:
     5552                  find first buf_store no-lock
     5553                  where buf_store.obj-code = buf_trn-doc.obj-code
     5554                  .
     5555                  assign
     5556                     v-torgconf-ogr-name = buf_store.store-boss
     5557                     v-torgconf-ogr-post = "Директор"
     5558                  .
     5559               END.
     5560               OTHERWISE DO:
     5561                  assign
     5562                     v-torgconf-ogr-name = "":U
     5563                     v-torgconf-ogr-post = "":U
     5564                  .
     5565               END.
     5566               END CASE.
     5567            end.
     5568      if v-torgconf-outogr = "manag_doc"
     5569         then do:
     5570            find first buf_trn-doc no-lock
     5571            where buf_trn-doc.doc-code = p-doc-code
     5572            no-error.
     5573            if available buf_trn-doc
     5574            then do:
     5575               run rep/get-psn.p
     5576               (input buf_trn-doc.boss
     5577               ,output v-torgconf-ogr-name
     5578               ) .
     5579            end.
     5580            find first buf_person no-lock
     5581            where buf_person.psn-code = buf_trn-doc.boss
     5582            no-error.
     5583            if available buf_person
     5584            then do:
     5585               v-torgconf-ogr-post = buf_person.position.
     5586            end.
     5587            if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     5588            if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     5589         end.
     5590      end.
     5591      else do:
     5592      find first buf_wth-doc no-lock
     5593         where buf_wth-doc.doc-code = p-doc-code
     5594         no-error.
     5595         if v-torgconf-outogr = "no_print"
     5596            then do:
     5597               assign
     5598                  v-torgconf-ogr-name = ""
     5599                  v-torgconf-ogr-post = ""
     5600               .
     5601            end.
     5602         if v-torgconf-outogr  = "ruk_firm"
     5603               then do:
     5604               find first buf_sysconf no-lock
     5605               where buf_sysconf.host-code = p-host-code
     5606               no-error.
     5607               if available buf_sysconf
     5608               then do:
     5609                  assign
     5610                     v-torgconf-ogr-post = buf_sysconf.head-position
     5611                  .
     5612               end.
     5613               find first buf_clients no-lock
     5614                  where buf_clients.obj-type = 'орг':U
     5615                  and buf_clients.obj-code = p-host-code
     5616               .
     5617               find first buf_firm no-lock
     5618                  where buf_firm.firm-code = buf_clients.obj-code
     5619               .
     5620               assign
     5621                  v-torgconf-ogr-name = buf_firm.director
     5622               .
     5623            end.
     5624            if v-torgconf-outogr = "dir_obj"
     5625               then do:
     5626               find first buf_wth-doc no-lock
     5627               where buf_wth-doc.doc-code = p-doc-code
     5628               no-error.
     5629                  find first buf_shop no-lock
     5630                  where buf_shop.obj-code = buf_wth-doc.obj-code
     5631                  .
     5632                  assign
     5633                     v-torgconf-ogr-name = buf_shop.director
     5634                     v-torgconf-ogr-post = "Директор"
     5635                  .
     5636               end.
     5637         if v-torgconf-outogr = "manag_doc"
     5638            then do:
     5639               find first buf_wth-doc no-lock
     5640               where buf_wth-doc.doc-code = p-doc-code
     5641               no-error.
     5642               if available buf_wth-doc
     5643               then do:
     5644                  run rep/get-psn.p
     5645                  (input buf_wth-doc.deliver
     5646                  ,output v-torgconf-ogr-name
     5647                  ) .
     5648               end.
     5649               find first buf_person no-lock
     5650               where buf_person.psn-code = buf_wth-doc.deliver
     5651               no-error.
     5652               if available buf_person
     5653               then do:
     5654                  v-torgconf-ogr-post = buf_person.position.
     5655               end.
     5656               if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     5657               if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     5658            end.
     5659      end.
     5660   end.
     5661   procedure torgconf-get-reason  :
     5662   define input parameter  p-doc-code       as character        no-undo.
     5663   define input parameter  p-reason-code    as integer          no-undo .
     5664   define input parameter  p-doc-type       as character        no-undo.
     5665       if p-reason-code > 0
     5666       then do:
     5667           define buffer buf_trn-reason for ub.trn-reason.
     5668           find first buf_trn-reason no-lock where buf_trn-reason.reason-code = p-reason-code no-error .
     5669           if available buf_trn-reason then assign v-torgconf-reason =  buf_trn-reason.reason-name .
     5670       end.
     5671       else do:
     5672           if p-doc-type = 'при':U
     5673           then  do:
     5674               define variable v-attr-type     as character    no-undo.
     5675               define variable v-attr-value    as character    no-undo.
     5676               run gbl/trdcat-v.p (input p-doc-code,input 'nids':U,output v-attr-value,output v-attr-type) .
     5677               assign v-torgconf-reason = v-attr-value .
     5678               run gbl/trdcat-v.p (input p-doc-code,input 'dids':U,output v-attr-value,output v-attr-type) .
     5679               assign v-torgconf-reason = v-torgconf-reason + " от " + v-attr-value .
     5680           end.
     5681       end.
     5682   end procedure.
     5683   run get-report-num  in parparentproc (output  g#report-num).
