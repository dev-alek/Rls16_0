     5789             temp-str.section-name   column-label " ! Наименование ! отдела, секции ! ":C30 format "X(30)"           space(0)
     5790             sym3                    column-label ":!:!:!:":U  format "X(1)"            space(0)
     5791             temp-str.shift-num      column-label " ! Номер ! смены ! ":C9  format "9999999"         space(0)
     5792             Sym4                    column-label ":!:!:!:":U  format "X(1)"            space(0)
     5793             temp-str.chk-num        column-label " ! Номер ! чека !":C7  format "9999999"         space(0)
     5794             sym5                    column-label ":!:!:!:":U  format "X(1)"            space(0)
     5795             temp-str.chk-tot        column-label " ! сумма чека ! руб. коп. ! ":C15 format "->>>,>>>,>>9.99" space(0)
     5796             sym6                    column-label ":!:!:!:":U  format "X(1)"            space(0)
     5797             temp-str.person         column-label " Должность, ! фамилия, и., о. лица, ! разрешившего возврат ! денег по чеку ":C27 format "X(27)"           space(0)
     5798             sym7                    column-label ":!:!:!:":U  format "X(1)"            space(0)
     5799        HEADER
     5800         Line format "X(103)" AT 1
     5801         with width 136 down stream-io use-text NO-BOX.
     5802     end.
     5803     else do :
     5804       assign
