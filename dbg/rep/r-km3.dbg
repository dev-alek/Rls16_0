     5975                          else Hide STOPBTN in frame InfoFrame.
     5976         end.
     5977   define buffer buf_tt-cash-desk for tt-cash-desk.
     5978   foreach:
     5979   for each buf_chk-doc where buf_chk-doc.obj-type  = 'маг':U
     5980                           and buf_chk-doc.obj-code  = tt-cash-desk.obj-code
     5981                           and ( buf_chk-doc.shift-date >= x-date-start
     5982                            or buf_chk-doc.chk-date     >= x-date-start )
     5983                           and ( buf_chk-doc.shift-date <= x-date-end
     5984                              or buf_chk-doc.chk-date   <= x-date-end )
     5985                           and (buf_chk-doc.chk-type  = integer('6':U)
     5986                              or buf_chk-doc.chk-type  = integer('96':U)
     5987                                 )
     5988                                no-lock
     5989                            :
     5990     if X-tog-shift then do:
     5991       if is-doc then do:
     5992        if buf_chk-doc.shift-date <> x-date-start
     5993        or buf_chk-doc.shift-num <> x-shift-alone then next.
     5994       end .
     5995       else do :
     5996         if (buf_chk-doc.shift-date = x-date-start and buf_chk-doc.shift-num < x-shift-start
     5997         or buf_chk-doc.shift-date = x-date-end   and buf_chk-doc.shift-num > x-shift-end)
     5998         then next.
     5999        end .
     6000      end .
     6001     else do:
     6002        if ( buf_chk-doc.chk-date < x-date-start
     6003          or buf_chk-doc.chk-date > x-date-end )
     6004          then next.
     6005         end .
     6006     if is-doc then do:
     6007       find first buf_tt-cash-desk where
     6008                 buf_tt-cash-desk.cash-num = buf_chk-doc.pay-desk
     6009             and buf_tt-cash-desk.obj-code = buf_chk-doc.obj-code no-error.
     6010       if not available buf_tt-cash-desk then next.
     6011     end .
     6012     find first buf_clients where buf_clients.obj-code = buf_chk-doc.cashier-psn-code
     6013                             and buf_clients.obj-type = 'чел':U
     6014                             no-lock
     6015                         no-error
     6016                         .
     6017     if available buf_clients then v-person = buf_clients.obj-name.
     6018                               else v-person = "Кассир №" + string ( buf_chk-doc.cashier ) .
     6019     find first buf_person no-lock
     6020           where buf_person.psn-code = buf_chk-doc.cashier-psn-code
     6021           no-error .
     6022     if available buf_person
     6023     then do :
     6024       v-person = buf_clients.obj-name.
     6025     end .
     6026     for each buf_chk-pay no-lock
     6027           where buf_chk-pay.doc-code = buf_chk-doc.doc-code :
     6028       find first buf_cash-pay-attr where buf_cash-pay-attr.cdpay-code = buf_chk-pay.pay-code   and
     6029                                          buf_cash-pay-attr.curr-code  = buf_chk-pay.curr-code  and
     6030                                          buf_cash-pay-attr.attr-code  = "form_km3" no-lock no-error.
     6031       if available buf_cash-pay-attr and buf_cash-pay-attr.attr-value = "yes" then
     6032         assign
     6033           v-chk-tot = v-chk-tot + buf_chk-pay.tot-rubl
     6034         .
     6035     end.
     6036     if v-chk-tot = 0 then next foreach.
     6037     assign
     6038     v-chk-tot = 0 - v-chk-tot
     6039     .
     6040     assign
     6041     v-is-petrol     = no
     6042     v-is-pieces     = no
     6043     v-have-petrol   = no
     6044     v-have-pieces   = no
     6045     v-have-servise  = no
     6046     .
     6047     for each buf_chk-gds where buf_chk-gds.doc-code = buf_chk-doc.doc-code
     6048                 no-lock
     6049                 :
     6050       for first buf_bar-code no-lock where buf_bar-code.b-code = buf_chk-gds.b-code, first buf_goods no-lock where buf_goods.gds-code = buf_bar-code.gds-code
     6051                       :
     6052         if buf_goods.gds-type = 'у':U then do :
     6053           assign
     6054           v-have-servise = yes
     6055           .
     6056         end .
     6057         else do :
     6058   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     6059     (
     6060        input buf_goods.artic
     6061     ,  input buf_goods.prod-type
     6062     ,  input buf_goods.prod-code
     6063     , output v-is-petrol
     6064     , output v-is-pieces
     6065     ) .
     6066           if v-is-petrol = yes then v-have-petrol = yes.
     6067           if v-is-pieces = yes then v-have-pieces = yes.
     6068         end .
     6069       end .
     6070     end .
     6071     create temp-str .
     6072     if v-have-pieces = yes then do :
     6073       assign temp-str.section-name  = temp-str.section-name + (if temp-str.section-name > '' then ',' else '') + 'ТНП'.
     6074     end .
