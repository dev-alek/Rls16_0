     3237   procedure torgconf-get-self-param :
     3238   define input parameter p-obj-type           as character        no-undo.
     3239   define input parameter p-obj-code           as integer          no-undo.
     3240   define input parameter p-curr-code          as integer          no-undo.
     3241       define variable v-host-code    as integer      no-undo.
     3242       define variable v-par-type     as character    no-undo.
     3243   do
     3244   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message(1))
     3245   :
     3246   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3247   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3248     (input  p-obj-type
     3249     ,input  p-obj-code
     3250     ,output v-host-code
     3251     )  .
     3252       if v-torgconf-outhold = yes
     3253       then do:
     3254           run torgconf-get-holdfirm-code in this-procedure (
     3255                 input p-obj-type
     3256               , input p-obj-code
     3257               , output v-torgconf-self-host-code
     3258           ).
     3259           if v-torgconf-self-host-code = 0
     3260           then do:
     3261               return error.
     3262           end.
     3263       end.
     3264       else do:
     3265           assign
     3266               v-torgconf-self-host-code = v-host-code
     3267           .
     3268       end.
     3269       if v-torgconf-self-host-code = 0
     3270       then do:
     3271           assign
     3272               v-torgconf-self-host-name           = "":U
     3273               v-torgconf-self-host-addres         = "":U
     3274               v-torgconf-self-host-post-addres    = "":U
     3275               v-torgconf-self-host-phone          = "":U
     3276               v-torgconf-self-host-inn            = "":U
     3277               v-torgconf-self-host-kpp            = "":U
     3278               v-torgconf-self-host-okpo           = "":U
     3279               v-torgconf-self-host-egrip-date     = "":U
     3280               v-torgconf-self-host-egrip-num      = "":U
     3281           .
     3282       end.
     3283       else do:
     3284           run fmtcli-get-client in this-procedure (
     3285                 input 'орг':U
     3286               , input v-torgconf-self-host-code
     3287           ).
     3288           assign
     3289               v-torgconf-self-host-name        = v-fmtcli-name
     3290               v-torgconf-self-host-engl-name   = v-fmtcli-engl-name
