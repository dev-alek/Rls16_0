      919   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      920   procedure cur-time :
      921      define output parameter p-today as date      no-undo .
      922      define output parameter p-time  as integer   no-undo .
      923     do
      924     on error undo, return error
      925     :
      926       define variable v-date1 as date      no-undo .
      927       define variable v-date2 as date      no-undo .
      928       define variable v-time  as integer   no-undo .
      929       assign
      930         v-date1 = today
      931         v-time  = time
      932         v-date2 = today
      933       .
      934       if v-date1 <> v-date2
      935       then do:
      936         assign
      937           v-date1 = today
      938           v-time  = v-time
      939         .
      940       end.
      941       assign
      942         p-today = v-date1
      943         p-time  = v-time
      944       .
      945     end.
      946   end.
      947   function cur-time-date returns character
      948   :
      949     return string(today, '99/99/9999':U) .
      950   end.
      951   function cur-time-mjd returns decimal
      952   :
      953     define variable v-date as date      no-undo .
      954     define variable v-time as integer   no-undo .
      955     run cur-time in this-procedure
      956       (output v-date
      957       ,output v-time
      958       ) .
      959     return integer(v-date) - 2400002 + (v-time / 86400) .
      960   end.
      961   function cur-time-get-ending-index returns integer
      962   (input p-number as integer
      963   )
      964   :
      965     if p-number < 0
      966     or p-number = ?
      967     then do:
      968       return 1 .
      969     end.
      970     define variable v-rest as integer   no-undo .
      971     assign
      972       p-number = p-number modulo 100
      973     .
      974     if p-number < 20
      975     then do:
      976       assign
      977         v-rest = p-number
      978       .
      979     end.
      980     else do:
      981       assign
      982         v-rest = p-number modulo 10
      983       .
      984     end.
      985     case v-rest :
      986       when 1
      987       then do:
      988         return 2 .
      989       end.
      990       when 2 or
      991       when 3 or
      992       when 4
      993       then do:
      994         return 3 .
      995       end.
      996       otherwise do:
      997         return 1 .
      998       end.
      999     end case .
     1000   end.
     1001   procedure cur-time-mjd-to-date :
     1002      define input  parameter i-mjd-diff as decimal no-undo.
     1003      define output parameter o-Date     as date    no-undo.
     1004      define output parameter o-Time     as integer no-undo.
     1005      define variable v-day-number as integer   no-undo .
     1006      if    i-mjd-diff < 0
     1007         or i-mjd-diff = ?
     1008      then do:
     1009         return "?" .
     1010      end.
     1011      assign
     1012         v-day-number = truncate(i-mjd-diff,0).
     1013         o-Date = date(v-day-number + 2400002).
     1014         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1015     .
     1016   end.
     1017   function cur-time-mjd-to-string returns character
     1018   (input p-mjd-diff as decimal
     1019   )
     1020   :
     1021     define variable v-day-number as integer   no-undo .
     1022     define variable v-seconds    as integer   no-undo .
     1023     define variable v-hour       as integer   no-undo .
     1024     define variable v-min        as integer   no-undo .
     1025     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1026     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1027     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1028     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1029     if p-mjd-diff < 0
     1030     or p-mjd-diff = ?
     1031     then do:
     1032       return "?" .
     1033     end.
     1034     assign
     1035       v-day-number = integer(truncate(p-mjd-diff,0))
     1036       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1037     .
     1038     if v-seconds > 86400
     1039     then do:
     1040       assign
     1041         v-seconds = 86400 - 1
     1042       .
     1043     end.
     1044     if v-seconds < 0
     1045     then do:
     1046       assign
     1047         v-seconds = 0
     1048       .
     1049     end.
     1050     assign
     1051       v-hour = truncate(v-seconds / 3600, 0)
     1052     .
     1053     assign
     1054       v-seconds = v-seconds modulo 3600
     1055     .
     1056     assign
     1057       v-min = truncate(v-seconds / 60, 0)
     1058     .
     1059     assign
     1060       v-seconds = v-seconds modulo 60
     1061     .
     1062     return
     1063         (if v-day-number <> 0
     1064           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1065           else ""
     1066         )
     1067       + (if v-day-number <> 0 or v-hour <> 0
     1068           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1069           else ""
     1070         )
     1071       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1072           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1073           else ""
     1074         )
     1075       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1076       .
     1077   end.
     1078   function cur-time-string returns character
     1079   :
     1080     define variable v-date as date      no-undo .
     1081     define variable v-time as integer   no-undo .
     1082     run cur-time in this-procedure
     1083       (output v-date
     1084       ,output v-time
     1085       ) .
     1086     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1087   end.
     1088   function cur-time-string-sec returns character
     1089   :
     1090     define variable v-date as date      no-undo .
     1091     define variable v-time as integer   no-undo .
     1092     run cur-time in this-procedure
     1093       (output v-date
     1094       ,output v-time
     1095       ) .
     1096     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1097   end.
     1098   function cur-time-custom  returns character
     1099   (input p-prefix as character
     1100   ,input p-date-format as character
     1101   ,input p-delimiter as character
     1102   ,input p-time-format as character
     1103   ,input p-suffix as character
     1104   )
     1105   :
     1106     define variable v-date as date      no-undo .
     1107     define variable v-time as integer   no-undo .
     1108     run cur-time in this-procedure
     1109       (output v-date
     1110       ,output v-time
     1111       ) .
     1112     return
     1113       p-prefix
     1114       + string(v-date, p-date-format)
     1115       + p-delimiter
     1116       + string(v-time, p-time-format)
     1117       + p-suffix
     1118       .
     1119   end.
     1120   function cur-time-print  returns character
     1121   :
     1122     define variable v-date as date      no-undo .
     1123     define variable v-time as integer   no-undo .
     1124     run cur-time in this-procedure
     1125       (output v-date
     1126       ,output v-time
     1127       ) .
     1128     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1129   end.
     1130   function cur-time-datetime returns datetime
     1131   :
     1132     define variable v-char as character no-undo .
     1133     define variable v-datetime as datetime no-undo .
     1134     v-char = cur-time-string().
     1135     v-datetime = datetime(v-char).
     1136     return  v-datetime.
     1137   end.
     1138   function cur-time-string-msec returns character
     1139   :
     1140     define variable v-date as datetime  no-undo .
     1141     v-date = now.
     1142     return string(v-date) .
     1143   end.
     1144   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1145   function breakstr returns character ( input        for-name    as character,
     1146                                         input        line-length as integer,
     1147                                         input-output line1       as character,
     1148                                         input-output line2       as character ) :
     1149     define variable ii as integer no-undo.
     1150     if length( for-name ) > line-length then do:
     1151       assign ii    = 1
     1152              line1 = "":u
     1153              line2 = "":u.
     1154       if length( entry( ii, for-name , " ":u ) ) > line-length then do:
     1155         assign line1 =       substring( for-name, 1, line-length     )
     1156                line2 = trim( substring( for-name,    line-length + 1 ) ).
     1157       end.                                                     else do:
     1158         do while length( line1 + entry( ii, for-name, " ":u ) ) < ( line-length + 1 ) :
     1159           assign line1 = line1 + entry( ii, for-name, " ":u ) + " ":u
     1160                  ii    = ii    + 1.
     1161           if length( entry( ii, for-name, " ":u ) ) > line-length then do:
     1162             assign line1 = line1 + substring( for-name, length( line1 ), line-length - length( line1 ) + 1 ).
     1163           end.
     1164         end.
     1165         assign line2 = trim( substring( for-name, length( line1 ) ) ).
     1166       end.
     1167     end.                                else do:
     1168       assign line1 = for-name
     1169              line2 = "":u.
     1170     end.
     1171     return ( line1 ).
     1172   end function.
