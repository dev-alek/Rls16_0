     6094     temp-str.chk-date      = buf_chk-doc.chk-date
     6095     temp-str.shift-date    = buf_chk-doc.shift-date
     6096     v-chk-tot              = 0.0
     6097     v-counter              = v-counter + 1
     6098     .
