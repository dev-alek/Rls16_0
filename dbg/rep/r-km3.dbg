     2332   define variable vss-include-info20 as character format "X(65)" no-undo
     2333   initial "@(#)$Workfile$ $Revision$".
     2334   define variable v-fmtcli-name          as character    no-undo.
     2335   define variable v-fmtcli-engl-name     as character    no-undo.
     2336   define variable v-fmtcli-addres        as character    no-undo.
     2337   define variable v-fmtcli-post-addres   as character    no-undo.
     2338   define variable v-fmtcli-full-addres   as character    no-undo.
     2339   define variable v-fmtcli-phone         as character    no-undo.
     2340   define variable v-fmtcli-inn           as character    no-undo.
     2341   define variable v-fmtcli-kpp           as character    no-undo.
     2342   define variable v-fmtcli-okpo          as character    no-undo.
     2343   define variable v-fmtcli-country       as character    no-undo.
     2344   define variable v-fmtcli-city          as character    no-undo.
     2345   define variable v-fmtcli-index         as character    no-undo.
     2346   define variable v-fmtcli-schet-exists  as logical      no-undo.
     2347   define variable v-fmtcli-bank-exists   as logical      no-undo.
     2348   define variable v-fmtcli-bank-r-schet  as character    no-undo.
     2349   define variable v-fmtcli-bank-c-schet  as character    no-undo.
     2350   define variable v-fmtcli-bank-bik      as character    no-undo.
     2351   define variable v-fmtcli-bank-name     as character    no-undo.
     2352   define variable v-fmtcli-bank-addres   as character    no-undo.
     2353   define variable v-fmtcli-bank-city     as character    no-undo.
     2354   procedure fmtcli-get-bank :
     2355   define input parameter p-host-code      as integer          no-undo.
     2356   define input parameter p-obj-type       as character        no-undo.
     2357   define input parameter p-obj-code       as integer          no-undo.
     2358   define input parameter p-curr-code      as integer          no-undo.
     2359       define buffer buf_fin-schet     for ub.fin-schet.
     2360       define buffer buf_fin-bank      for ub.fin-bank.
     2361   do
     2362   for buf_fin-schet
     2363     , buf_fin-bank
     2364   on error undo, return error
     2365   :
     2366       assign
     2367           v-fmtcli-schet-exists       = no
     2368           v-fmtcli-bank-exists        = no
     2369           v-fmtcli-bank-r-schet       = "":U
     2370           v-fmtcli-bank-c-schet       = "":U
     2371           v-fmtcli-bank-bik           = "":U
     2372           v-fmtcli-bank-name          = "":U
     2373           v-fmtcli-bank-addres        = "":U
     2374           v-fmtcli-bank-city          = "":U
     2375       .
     2376       search-for-schet:
     2377       for each buf_fin-schet no-lock
     2378          where buf_fin-schet.host-code = p-host-code
     2379            and buf_fin-schet.cli-type  = p-obj-type
     2380            and buf_fin-schet.cli-code  = p-obj-code
     2381            and buf_fin-schet.curr-code = p-curr-code
     2382       on error undo, return error
     2383       :
     2384           if buf_fin-schet.status_   = 'удал':U
     2385           then do:
     2386           end.
     2387           else do:
     2388               assign
     2389                   v-fmtcli-schet-exists   = yes
     2390                   v-fmtcli-bank-r-schet   = trim( buf_fin-schet.r-schet )
     2391                   v-fmtcli-bank-c-schet   = trim( buf_fin-schet.c-schet )
     2392               .
     2393               find first buf_fin-bank no-lock
     2394                    where buf_fin-bank.host-code = p-host-code
     2395                      and buf_fin-bank.code-bank = buf_fin-schet.code-bank
     2396               no-error.
     2397               if available buf_fin-bank
     2398               then do:
     2399                   assign
     2400                       v-fmtcli-bank-exists      = yes
     2401                       v-fmtcli-bank-bik         = trim( buf_fin-bank.bik )
     2402                       v-fmtcli-bank-name        = trim( buf_fin-bank.bank-name )
     2403                       v-fmtcli-bank-addres      = trim(buf_fin-bank.addres)
     2404                       v-fmtcli-bank-city      = trim(buf_fin-bank.bank-city)
     2405                   .
     2406               end.
     2407               else do:
     2408                   assign
     2409                       v-fmtcli-bank-exists    = no
     2410                       v-fmtcli-bank-bik       = "":U
     2411                       v-fmtcli-bank-name      = "":U
     2412                       v-fmtcli-bank-addres    = "":U
     2413                       v-fmtcli-bank-city      = "":U
     2414                   .
     2415               end.
     2416               leave search-for-schet.
     2417           end.
     2418       end.
     2419   end.
     2420   end procedure.
     2421   procedure fmtcli-get-client :
     2422   define input parameter p-obj-type       as character    no-undo.
     2423   define input parameter p-obj-code       as integer      no-undo.
     2424       define variable v-temp-fmtcli-address      as character     no-undo.
     2425       define variable v-num-country-city    as integer      no-undo.
     2426       define buffer buf_clients   for ub.clients.
     2427       define buffer buf_firm      for ub.firm.
     2428       define buffer buf_store     for ub.store.
     2429       define buffer buf_shop      for ub.shop.
     2430       define buffer buf_person    for ub.person.
     2431   do
     2432   for buf_clients
     2433     , buf_firm
     2434     , buf_store
     2435     , buf_shop
     2436     , buf_person
     2437   on error undo, return error
     2438   :
     2439       assign
     2440           v-fmtcli-name           = "":U
     2441           v-fmtcli-addres         = "":U
     2442           v-fmtcli-post-addres    = "":U
     2443           v-fmtcli-full-addres    = "":U
     2444           v-fmtcli-phone          = "":U
     2445           v-fmtcli-inn            = "":U
     2446           v-fmtcli-kpp            = "":U
     2447           v-fmtcli-okpo           = "":U
     2448           v-fmtcli-city           = "":U
     2449           v-fmtcli-index          = "":U
     2450           v-fmtcli-country        = "":U
     2451       .
     2452       find first buf_clients no-lock
     2453            where buf_clients.obj-type = p-obj-type
     2454              and buf_clients.obj-code = p-obj-code
     2455       .
     2456       assign
     2457           v-fmtcli-name = buf_clients.obj-name
     2458       .
     2459       case buf_clients.obj-type:
     2460          when 'орг':U
     2461          then do:
     2462               find first buf_firm no-lock
     2463                    where buf_firm.firm-code = buf_clients.obj-code
     2464                    no-error
     2465               .
     2466               if available buf_firm
     2467               then do:
     2468                   assign
     2469                       v-num-country-city = num-entries( buf_firm.city )
     2470                       v-fmtcli-engl-name = buf_firm.engl-name
     2471                   .
     2472                   if v-num-country-city > 0
     2473                   then do:
     2474                       assign
     2475                           v-fmtcli-country    = trim( entry( 1, buf_firm.city ) )
     2476                       .
     2477                   end.
     2478                   if v-num-country-city > 1
     2479                   then do:
     2480                       assign
     2481                           v-fmtcli-city       = trim( entry( 2, buf_firm.city ) )
     2482                       .
     2483                   end.
     2484                   run fmtcli-concatenate-strings in this-procedure (
     2485                         input v-fmtcli-full-addres
     2486                       , input v-fmtcli-country
     2487                       , input ", ":U
     2488                       , input 50
     2489                       , output v-fmtcli-full-addres
     2490                   ).
     2491                   run fmtcli-concatenate-strings in this-procedure (
     2492                         input v-fmtcli-full-addres
     2493                       , input v-fmtcli-city
     2494                       , input ", ":U
     2495                       , input 50
     2496                       , output v-fmtcli-full-addres
     2497                   ).
     2498                   run fmtcli-concatenate-strings in this-procedure (
     2499                         input v-fmtcli-full-addres
     2500                       , input IF buf_firm.ind = 0 THEN "" ELSE string( buf_firm.ind )
     2501                       , input ", ":U
     2502                       , input 50
     2503                       , output v-fmtcli-full-addres
     2504                   ).
     2505                   run fmtcli-concatenate-strings in this-procedure (
     2506                         input v-fmtcli-post-addres
     2507                       , input v-fmtcli-country
     2508                       , input ", ":U
     2509                       , input 50
     2510                       , output v-fmtcli-post-addres
     2511                   ).
     2512                   run fmtcli-concatenate-strings in this-procedure (
     2513                         input v-fmtcli-post-addres
     2514                       , input v-fmtcli-city
     2515                       , input ", ":U
     2516                       , input 50
     2517                       , output v-fmtcli-post-addres
     2518                   ).
     2519                   run fmtcli-concatenate-strings in this-procedure (
     2520                         input v-fmtcli-post-addres
     2521                       , input string( buf_firm.ind )
     2522                       , input ", ":U
     2523                       , input 50
     2524                       , output v-fmtcli-post-addres
     2525                   ).
     2526                   run fmtcli-concatenate-strings in this-procedure (
     2527                         input substring( buf_firm.addres1, 1, 50 )
     2528                       , input buf_firm.addres2
     2529                       , input " ":U
     2530                       , input 50
     2531                       , output v-temp-fmtcli-address
     2532                   ).
     2533                   run fmtcli-concatenate-strings in this-procedure (
     2534                         input v-temp-fmtcli-address
     2535                       , input substring( buf_firm.addres1, 51, 50 )
     2536                       , input " ":U
     2537                       , input 50
     2538                       , output v-temp-fmtcli-address
     2539                   ).
     2540                   run fmtcli-concatenate-strings in this-procedure (
     2541                         input v-temp-fmtcli-address
     2542                       , input substring( buf_firm.addres1, 101, 50 )
     2543                       , input " ":U
     2544                       , input 50
     2545                       , output v-temp-fmtcli-address
     2546                   ).
     2547                   assign
     2548                       v-fmtcli-addres = v-temp-fmtcli-address
     2549                   .
     2550                   if buf_firm.addres1 <> ?
     2551                   then do:
     2552                       run fmtcli-concatenate-strings in this-procedure (
     2553                             input v-fmtcli-full-addres
     2554                           , input v-fmtcli-addres
     2555                           , input ", ":U
     2556                           , input 0
     2557                           , output v-fmtcli-full-addres
     2558                       ).
     2559                   end.
     2560                   run fmtcli-concatenate-strings in this-procedure (
     2561                         input substring( buf_firm.post-addr1, 1, 50 )
     2562                       , input buf_firm.post-addr2
     2563                       , input " ":U
     2564                       , input 50
     2565                       , output v-fmtcli-post-addres
     2566                   ).
     2567                   run fmtcli-concatenate-strings in this-procedure (
     2568                         input v-fmtcli-post-addres
     2569                       , input substring( buf_firm.post-addr1, 51, 50 )
     2570                       , input " ":U
     2571                       , input 50
     2572                       , output v-fmtcli-post-addres
     2573                   ).
     2574                   run fmtcli-concatenate-strings in this-procedure (
     2575                         input v-fmtcli-post-addres
     2576                       , input substring( buf_firm.post-addr1, 101, 50 )
     2577                       , input " ":U
     2578                       , input 50
     2579                       , output v-fmtcli-post-addres
     2580                   ).
     2581                   assign
     2582                       v-fmtcli-phone         = buf_firm.phone
     2583                       v-fmtcli-inn           = buf_firm.inn
     2584                       v-fmtcli-kpp           = buf_firm.kpp
     2585                       v-fmtcli-okpo          = buf_firm.okpo
     2586                       v-fmtcli-index         = string( buf_firm.ind )
     2587                   .
     2588               end.
     2589          end.
     2590          when 'маг':U
     2591          then do:
     2592               find first buf_shop no-lock
     2593                    where buf_shop.obj-code = buf_clients.obj-code
     2594               .
     2595               if available buf_shop
     2596               then do:
     2597                   run fmtcli-concatenate-strings in this-procedure (
     2598                         input buf_shop.addres1
     2599                       , input buf_shop.addres2
     2600                       , input " ":U
     2601                       , input 50
     2602                       , output v-fmtcli-addres
     2603                   ).
     2604                   assign
     2605                       v-fmtcli-full-addres = v-fmtcli-addres
     2606                       v-fmtcli-post-addres = v-fmtcli-addres
     2607                       v-fmtcli-phone       = buf_shop.phone
     2608                       v-fmtcli-inn         = "":U
     2609                       v-fmtcli-kpp         = "":U
     2610                       v-fmtcli-okpo        = "":U
     2611                       v-fmtcli-city        = "":U
     2612                       v-fmtcli-index       = "":U
     2613                   .
     2614               end.
     2615          end.
     2616          when 'скл':U
     2617          then do:
     2618               find first buf_store no-lock
     2619                    where buf_store.obj-code = buf_clients.obj-code
     2620               .
     2621               if available buf_store
     2622               then do:
     2623                   run fmtcli-concatenate-strings in this-procedure (
     2624                         input buf_store.addres1
     2625                       , input buf_store.addres2
     2626                       , input " ":U
     2627                       , input 50
     2628                       , output v-fmtcli-addres
     2629                   ).
     2630                   assign
     2631                       v-fmtcli-full-addres = v-fmtcli-addres
     2632                       v-fmtcli-phone       = buf_store.phone
     2633                       v-fmtcli-inn         = "":U
     2634                       v-fmtcli-kpp         = "":U
     2635                       v-fmtcli-okpo        = "":U
     2636                       v-fmtcli-city        = "":U
     2637                       v-fmtcli-index       = "":U
     2638                   .
     2639               end.
     2640          end.
     2641          when 'чел':U
     2642          then do:
     2643               find first buf_person no-lock
     2644                    where buf_person.psn-code = buf_clients.obj-code
     2645               .
     2646               if available buf_person
     2647               then do:
     2648                   run fmtcli-concatenate-strings in this-procedure (
     2649                         input ( if buf_person.ind = 0 or buf_person.ind = ?
     2650                                 then "":U
     2651                                 else string( buf_person.ind, "999999")
     2652                                 )
     2653                       , input buf_person.city
     2654                       , input ", ":U
     2655                       , input 0
     2656                       , output v-fmtcli-full-addres
     2657                   ).
     2658                   assign
     2659                       v-fmtcli-addres = buf_person.address
     2660                   .
     2661                   run fmtcli-concatenate-strings in this-procedure (
     2662                         input v-fmtcli-full-addres
     2663                       , input v-fmtcli-addres
     2664                       , input ", ":U
     2665                       , input 0
     2666                       , output v-fmtcli-full-addres
     2667                   ).
     2668                   assign
     2669                       v-fmtcli-phone     = buf_person.phone1
     2670                       v-fmtcli-inn       = buf_person.inn
     2671                       v-fmtcli-kpp       = buf_person.kpp
     2672                       v-fmtcli-okpo      = buf_person.okpo
     2673                       v-fmtcli-city      = buf_person.city
     2674                       v-fmtcli-index     = string( buf_person.ind )
     2675                   .
     2676               end.
     2677          end.
     2678       end case.
     2679   end.
     2680   end procedure.
     2681   procedure fmtcli-concatenate-strings :
     2682   define input parameter p-string-1       as character        no-undo.
     2683   define input parameter p-string-2       as character        no-undo.
     2684   define input parameter p-delimiter      as character        no-undo.
     2685   define input parameter p-length         as integer          no-undo.
     2686   define output parameter p-out-string    as character        no-undo.
     2687   do
     2688   on error undo, return error
     2689   :
     2690       assign
     2691           p-out-string = ( if p-string-1 = ?
     2692                            then "":U
     2693                            else trim( p-string-1 ) )
     2694       .
     2695       assign
     2696           p-out-string = p-out-string
     2697                        + ( if p-out-string = "":U
     2698                            or length( p-out-string ) = p-length
     2699                            or p-string-2 = ?
     2700                            or trim( p-string-2 ) = "":U
     2701                            then "":U
     2702                            else p-delimiter )
     2703                        + ( if p-string-2 = ?
     2704                            or trim( p-string-2 ) = "":U
     2705                            then "":U
     2706                            else trim( p-string-2 ) )
     2707       .
     2708   end.
     2709   end procedure.
