     5843         Sheetf.ColFOrmat   = "1=@;2=@;3=dd/mm/yyyy;4=@;5=@;6=@;7=0.00;8=@"
     5844         Make-excel = p-xls
     5845         Make-excel-com = false
     5846         .
     5847         run rep/extitle.p ( 1 ).
     5848     end.
     5849   FUNCTION f-wp-qnty returns character ( INPUT p-dec as decimal ) :
     5850     define variable pr   as character no-undo .
     5851     define variable abbr as character no-undo .
     5852     run rep/wp-rub.p ( input p-dec, output pr, output abbr ) .
     5853     if Pr = '' then do:
     5854        Pr = 'Ноль'.
     5855     end.
     5856     RETURN ( Pr ) .
     5857   END FUNCTION.
     5858   define variable v-account as integer init 0 no-undo .
     5859   define variable v-account-lavel as character no-undo .
     5860   define variable v-button-stop as logical no-undo .
     5861   define variable v-kol-spice as integer no-undo .
