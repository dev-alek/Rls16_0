     5864   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     5865   DEFINE BUTTON StopBtn AUTO-END-KEY
     5866        LABEL "Стоп"
     5867        SIZE 10 BY 1.
     5868   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     5869        LABEL "Обработано записей"
     5870         VIEW-AS TEXT
     5871        SIZE 14 BY .67 NO-UNDO.
     5872   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     5873         VIEW-AS TEXT
