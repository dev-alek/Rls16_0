     3348   procedure torgconf-get-recepient-param :
     3349   define input parameter torgconfdoc-code   as character                  no-undo.
     3350   define output parameter v-code-rec        as integer                    no-undo .
     3351   define output parameter v-type-rec        as character                  no-undo initial 'C':U.
     3352   define output parameter v-codefirm-rec    as integer                    no-undo .
     3353   define output parameter v-curcode-rec     as integer                    no-undo .
     3354        define variable  v-recipient-code  as character                  no-undo .
     3355        define variable  v-recipient       like ub.doc-attr.attr-value   no-undo.
     3356        define variable  v-trdcattr-type   as character                  no-undo initial 'C':U.
     3357   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input torgconfdoc-code ,
     3358                           input 'Recipient':U ,
     3359                          output v-recipient-code ,
     3360                          output v-trdcattr-type ) no-error .
     3361       if error-status :error then do:
     3362        message
     3363         vss-workfile vss-revision vss-description skip
     3364         "Ошибка при вызове процедуры tdat-val":U skip
     3365         "Документ: " torgconfdoc-code skip
     3366         "Атрибут: " 'Recipient':U skip
     3367         "Значение: " v-recipient skip
     3368         trim( error-status :get-message (1) ) skip
     3369         return-value skip
     3370         view-as alert-box error.
     3371       undo, return error return-value.
     3372       end.
