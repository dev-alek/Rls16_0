     5895            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     5896            TITLE "Процесс"
     5897            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     5898   define variable mFrameView      as logical   no-undo init yes.
     5899     define variable mFramHandle as handle no-undo.
     5900     mFramHandle = frame InfoFrame:handle.
     5901     if  log-manager:logfile-name ne ?
     5902     then DO:
     5903         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     5904         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     5905         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     5906     end.
     5907     mFrameView = not session:batch-mode and mFramHandle:visible.
     5908     if mFrameView
     5909     then do:
     5910       ASSIGN
     5911          FRAME InfoFrame:HIDDEN                           = TRUE
     5912          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     5913     end.
     5914   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     5915   DO:
     5916     IF not StopProcessing THEN
     5917       Message "Вы действительно хотите прервать" SKIP
     5918               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     5919                 UPDATE StopProcessing.
     5920     IF StopProcessing THEN do:
     5921        if mFrameView
     5922        then do:
     5923           HIDE FRAME InfoFrame.
     5924        end.
     5925     End.
     5926   END.
     5927   do on error undo, return error
     5928      :
     5929   for each temp-str:
     5930     delete temp-str.
     5931   end.
     5932   for each buf_obj-list
     5933     no-lock :
