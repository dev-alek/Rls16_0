     6320             run reprumpr_print-plain-text in this-procedure ( input p-dir-name
     6321                                                               ,input ''
     6322                                                               ,input substitute("km-3_&1&2_&3&4&5_&6.txt"
     6323                                                                               , v-obj-type
     6324                                                                               , v-obj-code
     6325                                                                               , string(year(X-date-end), "9999")
     6326                                                                               , string(month(X-date-end), "99")
     6327                                                                               , string(day(X-date-end), "99")
     6328                                                                               , X-shift-end)
     6329                                                               ,input DisabledOptions
     6330                                                               ,input ReportFontNum
     6331                                                               ) no-error.
     6332           end.
     6333           if error-status:error then do:
     6334                       if p-batch > 0 then do:      run write-log-and-file in p-log-handle (                 input 1                                          , input p-log-file-name                              , input 1                                          , input return-value).    end.    else do:       run write-to-log in p-log-handle ( input return-value).    end.
     6335           end.
     6336         end.
     6337       end.
     6338       else do:
     6339        os-delete value( string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )  .
     6340      os-rename
     6341        value( string( session:temp-directory ) + "$" + string( g#report-num ) + ".txl" )
     6342        value( string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )
     6343      .
     6344         run gbl/prnfilen.w
     6345             ( input  ""
     6346             , input  DisabledOptions
     6347             , input  string(session :temp-directory) + "rpt" + string( g#report-num )
     6348             , input  ReportFontNum
     6349             , output v-user-action
     6350             , output v-printed
     6351             ) .
     6352       end.
     6353     end.
     6354     else do:
     6355       run gbl/prnfilen.w
     6356           (  input  ""
     6357             ,input  DisabledOptions
     6358             ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
     6359             ,input  reportFontNum
     6360             ,output v-user-action
     6361             ,output v-printed
     6362           ) .
     6363       os-delete value( string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )  .
     6364     end.
     6365   end.
     6366   procedure print-line :
     6367   define input parameter p-sheet-name as character no-undo .
     6368   define input parameter p-is-doc as logical no-undo .
     6369     do on error undo, return error return-value :
     6370       if p-is-doc then do :
     6371   DO:
     6372     ASSIGN
     6373       sum2-shift    = sum2-shift + temp-str.chk-tot
     6374       Lines_Counter = Lines_Counter + 1
     6375     .
     6376     if line-counter( Out-Stream ) + 3 > page-size( Out-Stream )
     6377     then  PAGE STREAM Out-Stream.
     6378     display stream Out-Stream
     6379               sym1  Lines_Counter         @ temp-str.num-pos
     6380               sym2  temp-str.section-name
     6381               sym3  temp-str.shift-num
     6382               Sym4  temp-str.chk-num
     6383               sym5  temp-str.chk-tot
     6384               sym6  temp-str.person
     6385             sym7
     6386     with FRAME km-frame-akt.
     6387     DOWN stream Out-Stream 1 with FRAME km-frame-akt
     6388     .
     6389       run km3xl-write-line-data in this-procedure ( input p-sheet-name
     6390                                                   , input Lines_Counter
     6391                                                 , input temp-str.section-name
     6392                                                 , input temp-str.shift-num
     6393                                                 , input temp-str.chk-num
     6394                                                 , input temp-str.chk-tot
     6395                                                 , input temp-str.person
     6396                                                 ) .
     6397   end.
     6398       end.
     6399       else do :
     6400   DO:
     6401     ASSIGN
     6402       sum2-shift    = sum2-shift + temp-str.chk-tot
     6403       Lines_Counter = Lines_Counter + 1
     6404     .
     6405     if line-counter( Out-Stream ) + 3 > page-size( Out-Stream )
     6406     then  PAGE STREAM Out-Stream.
     6407       display stream Out-Stream
     6408               sym1  Lines_Counter         @ temp-str.num-pos
     6409               sym2  temp-str.section-name
     6410               sym3  temp-str.shift-date
     6411               sym4  temp-str.shift-num
     6412               Sym5  temp-str.cash-num
     6413               sym6  temp-str.chk-num
     6414               sym7  temp-str.chk-tot
     6415               sym8  temp-str.person
     6416               sym9
     6417       with FRAME km-frame-rep.
     6418       DOWN stream Out-Stream 1 with FRAME km-frame-rep
     6419       .
     6420       if Make-Excel then  put   stream ForExcel unformatted
     6421         Lines_Counter                CHR(9)
     6422         temp-str.section-name        CHR(9)
     6423         temp-str.shift-date          CHR(9)
     6424         temp-str.shift-num           CHR(9)
     6425         temp-str.cash-num            CHR(9)
     6426         temp-str.chk-num             CHR(9)
     6427         temp-str.chk-tot             CHR(9)
     6428         temp-str.person              CHR(9) chr(10)
     6429       .
     6430   end.
     6431       end.
     6432     end.
     6433   end procedure.
     6434   procedure PrintTitul :
     6435   define input parameter p-sheet-name as character no-undo .
     6436   define variable v-organization  as character no-undo.
     6437   define variable v-object        as character no-undo.
     6438   define variable v-kkm-code-prod as character no-undo .
     6439   define variable v-kkm-code-reg  as character no-undo .
     6440   define variable v-kkm-programm  as character no-undo .
     6441   define variable v-kkm-num       as character no-undo .
     6442   define variable v-par-type      as character no-undo .
     6443   do on error undo, return error return-value  :
     6444   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6445   empty temp-table thbjattr_thbj-attr.
     6446   run adm/shattri.p (
     6447      input "get":U
     6448     ,input ''
     6449     ,input 0
     6450     ,input 'prt-glob':U
     6451     ,input  ""
     6452     ,output v-value-character
     6453     ,output v-value-date
     6454     ,output v-value-decimal
     6455     ,output v-value-integer
     6456     ,output v-value-logical
     6457     ,output par-type
     6458     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     6459     ) no-error .
     6460      for each thbjattr_thbj-attr :
     6461          if thbjattr_thbj-attr.prop-code = 'outprncd':U then v-outprncd  = string( thbjattr_thbj-attr.property-value-logical) .
     6462      end.
     6463   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6464   empty temp-table thbjattr_thbj-attr.
     6465   run adm/shattri.p (
     6466      input "get":U
     6467     ,input ''
     6468     ,input 0
     6469     ,input 'prt-obj':U
     6470     ,input  ""
     6471     ,output v-value-character
     6472     ,output v-value-date
     6473     ,output v-value-decimal
     6474     ,output v-value-integer
     6475     ,output v-value-logical
     6476     ,output par-type
     6477     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     6478     ) no-error .
     6479      for each thbjattr_thbj-attr :
     6480          if thbjattr_thbj-attr.prop-code = 'outR':U      then v-outR      = string( thbjattr_thbj-attr.property-value-character) .
     6481      end.
     6482      if v-outR = "no_print"
     6483         then do:
     6484            assign
     6485               v-torgconf-main-boss = ""
     6486               v-torgconf-main-boss-post = ""
     6487            .
     6488         end.
     6489      if v-outR = "ruk_firm"
     6490         then do:
     6491            find first buf_sysconf no-lock
     6492            where buf_sysconf.host-code = This_Object.host-code
     6493            no-error.
     6494            if available buf_sysconf
     6495            then do:
     6496               assign
     6497                  v-torgconf-main-boss-post = buf_sysconf.head-position
     6498               .
     6499            end.
     6500            find first buf_clients no-lock
     6501            where buf_clients.obj-type = 'орг':U
     6502            and buf_clients.obj-code = This_Object.host-code
     6503            .
     6504            find first buf_firm no-lock
     6505            where buf_firm.firm-code = buf_clients.obj-code
     6506            no-error.
     6507            if available buf_firm
     6508            then do:
     6509               assign
     6510                  v-torgconf-main-boss = buf_firm.director
     6511               .
     6512            end.
     6513         end.
     6514      if v-outR = "dir_obj"
     6515         then do:
     6516            CASE This_Object.obj-type:
     6517            WHEN 'маг':U
     6518            THEN DO:
     6519               find first buf_shop no-lock
     6520               where buf_shop.obj-code = This_Object.obj-code
     6521               .
     6522               assign
     6523                  v-torgconf-main-boss = buf_shop.director
     6524               .
     6525            END.
     6526            WHEN 'скл':U
     6527            THEN DO:
     6528               find first buf_store no-lock
     6529               where buf_store.obj-code = This_Object.obj-code
     6530               .
     6531               assign
     6532                  v-torgconf-main-boss = buf_store.store-boss
     6533               .
     6534            END.
     6535            OTHERWISE DO:
     6536               assign
     6537                  v-torgconf-main-boss       = "":U
     6538               .
     6539            END.
     6540            END CASE.
     6541      end.
     6542      assign v-director = v-torgconf-main-boss .
     6543   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile:currsysk.i $ $Revision: $".
     6544   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run currsysk in g#library
     6545     (output v-sys-key
     6546     ) no-error .
     6547       case clients.obj-type:
     6548          when 'орг':U
     6549          then do:
     6550               FIND ub.firm WHERE ub.firm.firm-code = clients.obj-code NO-LOCK .
     6551               if available ub.firm
     6552               then do:
     6553                   assign
     6554                       t-addres = ( if ub.firm.ind = 0 or ub.firm.ind = ? then "" else string( ub.firm.ind ) )
     6555                       t-addres = t-addres
     6556                           + ( if ub.firm.city = ? or trim(ub.firm.city) = ""
     6557                               then ""
     6558                               else ( (if t-addres = "" then "" else ", ") + trim( ub.firm.city ) )
     6559                             )
     6560                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 1, 50 ) ) )
     6561                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     6562                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     6563                           + ( if  ub.firm.addres2 = ? or trim(ub.firm.addres2) = "" then "" else ( ", " + trim( ub.firm.addres2 ) ) )
     6564                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 51, 50 ) ) )
     6565                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     6566                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     6567                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 101, 50 ) ) )
     6568                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     6569                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     6570                       t-phone = ub.firm.phone
     6571                       t-inn   = ub.firm.inn
     6572                       t-okpo  = ub.firm.okpo
     6573                   .
     6574               end.
     6575          end.
     6576          when 'маг':U
     6577          then do:
     6578               FIND ub.shop WHERE ub.shop.obj-code = clients.obj-code NO-LOCK .
     6579               if available ub.shop
     6580               then do:
     6581                   assign
     6582                       t-addres = ( if trim( shop.addres1 ) <> "" then ( trim( shop.addres1 ) ) else "" )
     6583                               + ( if trim( shop.addres2 ) <> "" then ( ", " + trim( shop.addres2 ) ) else "" )
     6584                       t-phone = shop.phone
     6585                       t-inn = ""
     6586                       t-okpo = ""
     6587                   .
     6588               end.
     6589          end.
     6590          when 'скл':U
     6591          then do:
     6592               FIND ub.store WHERE ub.store.obj-code = clients.obj-code NO-LOCK .
     6593               if available ub.store
     6594               then do:
     6595                   assign
     6596                       t-addres = ( if trim( ub.store.addres1 ) <> "" then ( trim( ub.store.addres1 ) ) else "" )
     6597                               + ( if trim( ub.store.addres2 ) <> "" then ( ", " + trim( ub.store.addres2 ) ) else "" )
     6598                       t-phone = ub.store.phone
     6599                       t-inn = ""
     6600                       t-okpo = ""
     6601                   .
     6602               end.
     6603          end.
     6604          when 'чел':U
     6605          then do:
     6606               find ub.person where ub.person.psn-code = clients.obj-code no-lock .
     6607               if available ub.person
     6608               then do:
     6609                   assign
     6610                       t-addres = ( if ub.person.ind <> 0 and ub.person.ind <> ? then string( ub.person.ind ) else "" )
     6611                                   + ( if  ub.person.city <> ? and trim(ub.person.city) <> "" then ( ", " + trim( ub.person.city ) ) else "" )
     6612                                   + ( if  ub.person.address <> ? and trim(ub.person.address) <> "" then ( ", " + trim( ub.person.address ) ) else "" )
     6613                       t-phone = ub.person.phone1
     6614                       t-inn = ub.person.inn
     6615                       t-okpo = ub.person.okpo
     6616                   .
     6617               end.
     6618          end.
     6619       end case.
     6620     if v-outprncd = "yes" then
     6621       do:
     6622         assign
     6623         v-organization = string( CAPS( clients.obj-name )     + " (" + string(clients.obj-code) + ")" )
     6624          v-object       = string( CAPS( This_Object.obj-name ) + " (" + string(This_Object.obj-code) + ")" )
     6625         .
     6626       end.
     6627       else do :
     6628         assign
     6629          v-organization = string( CAPS( ub.clients.obj-name ) )
     6630          v-object       = string( CAPS( This_Object.obj-name ) )
     6631          .
     6632       end.
     6633     if check-entry-with-mask( v-sys-key, "Pskov":U, chr(44) ) = true then do:
     6634       find first ub.cli-grp where ub.cli-grp.node-code = This_object.grp-code
     6635                             no-lock
     6636                             no-error
     6637                             .
     6638            if available ub.cli-grp then do :
     6639             assign v-object =  ub.cli-grp.node-name + " " + v-object .
     6640            end.
     6641       end.
     6642     FIND FIRST buf_cash-desk WHERE buf_cash-desk.cash-num = tt-cash-desk.cash-num
     6643                       AND buf_cash-desk.obj-code = This_Object.obj-code
     6644                       AND Buf_cash-desk.db-num   = This_Object.db-num
     6645                     NO-LOCK
     6646                     NO-ERROR
     6647                     .
     6648      assign
     6649       v-kkm-code-reg  = buf_cash-desk.registration-code
     6650       v-kkm-code-prod = buf_cash-desk.serial-code
     6651       v-kkm-model = buf_cash-desk.fr-type
     6652       v-kkm-programm = (if tt-cash-desk.pos-type = 'IBM-XML':U
     6653                         or tt-cash-desk.pos-type = 'IBM':U
     6654                         then  (if tt-cash-desk.cash-os = "LINUX"
     6655                                 then "UniFO-L V 4.0.K"
     6656                                 else "UniFO-IBS V 4.0.K" )
     6657                         else '')
     6658       v-kkm-num = "(" + trim(string(tt-cash-desk.cash-num)) + ")"
     6659      .
     6660      run km3xl-write-cell-data in this-procedure (
     6661          input substitute("&1_&2"
     6662                           , p-sheet-name
     6663                           , "h_organization":U
     6664                           )
     6665          , input v-organization
     6666      ).
     6667      run km3xl-write-cell-data in this-procedure (
     6668          input substitute("&1_&2"
     6669                          , p-sheet-name
     6670                          ,"h_object":U
     6671                          )
     6672          , input v-object
     6673      ).
     6674      run km3xl-write-cell-data in this-procedure (
     6675          input substitute("&1_&2"
     6676                           , p-sheet-name
     6677                           ,"h_docDate":U
     6678                           )
     6679          , input string( p-date, "99/99/9999")
     6680      ).
     6681      run km3xl-write-cell-data in this-procedure (
     6682          input substitute("&1_&2"
     6683                           , p-sheet-name
     6684                           ,"h_OKPO":U
     6685                           )
     6686          , input t-okpo
     6687      ).
     6688      run km3xl-write-cell-data in this-procedure (
     6689          input substitute("&1_&2"
     6690                           , p-sheet-name
     6691                           ,"h_INN":U
     6692                           )
     6693          , input t-inn
     6694      ).
     6695      run km3xl-write-cell-data in this-procedure (
     6696          input substitute("&1_&2"
     6697                           , p-sheet-name
     6698                           ,"h_deskname":U
     6699                           )
     6700          , input (v-kkm-model + " " + v-kkm-num)
     6701      ).
     6702      run km3xl-write-cell-data in this-procedure (
     6703          input substitute("&1_&2"
     6704                          , p-sheet-name
     6705                          ,"h_KKM_reg":U
     6706                          )
     6707          , input v-kkm-code-reg
     6708      ).
     6709      run km3xl-write-cell-data in this-procedure (
     6710          input substitute("&1_&2"
     6711                          , p-sheet-name
     6712                          ,"h_KKM_prod":U
     6713                          )
     6714          , input v-kkm-code-prod
     6715      ).
     6716      run km3xl-write-cell-data in this-procedure (
     6717          input substitute("&1_&2"
     6718                          , p-sheet-name
     6719                          ,"h_KKM_programm":U
     6720                          )
     6721          , input v-kkm-programm
     6722      ).
     6723      find first buf_shop no-lock
     6724           where buf_shop.obj-code = This_Object.obj-code no-error.
     6725      if available buf_shop then do :
     6726        v-post = entry(2,buf_shop.acct,"|") no-error.
     6727        v-boss = entry(1,buf_shop.acct,"|") no-error.
     6728      end.
     6729      run km3xl-write-cell-data in this-procedure (
     6730          input substitute("&1_&2"
     6731                          , p-sheet-name
     6732                          ,"f_post":U
     6733                          )
     6734          , input v-post
     6735      ).
     6736      run km3xl-write-cell-data in this-procedure (
     6737          input substitute("&1_&2"
     6738                          , p-sheet-name
     6739                          ,"f_boss":U
     6740                          )
     6741          , input v-boss
     6742      ).
     6743      PUT STREAM Out-Stream
     6744          "Унифицированная форма N КМ-3"              AT 68 skip
     6745          "Утверждена постановлением Госкомстата"     AT 68 skip
     6746          "России от 25.12.98 г. N 132      "         AT 68 skip
     6747          "+----------------+"                        AT 86 skip
     6748          "|      Код       |"                        AT 86 skip
     6749          "+----------------+"                        AT 86 skip
     6750          "Форма по ОКУД|     0330107    |"           AT 73 skip
     6751          space(4) v-organization format "X(80)" "+----------------+" AT 86 skip
     6752          space(4) Line           format "X(73)" "по ОКРО" format "X(7)" AT 79 "|" AT 86 t-okpo format "X(16)" "|" AT 103 skip
     6753          space(34) "организация" format "X(50)" "+----------------+" AT 86 skip
     6754          space(4) v-object format "X(75)" "ИНН|" AT 83  t-INN format "X(15)"  "|" AT 103 skip
     6755          space(4) Line format  "X(70)"  "+----------------+" AT 86 skip
     6756          space(34) "структурное подразделение" format "x(30)"                                "|                |" AT 86 skip
     6757                                          "+----------------+" AT 86 skip
     6758           "Вид деятельности" AT 70 "| " AT 86 "|" AT 103 skip
     6759          "+----------------+----------------+"                         AT 69 skip
     6760          "Контрольно-кассовая машина " v-kkm-model " " v-kkm-num  "| производителя  |" AT 69  v-kkm-code-prod format "x(16)" "|" AT 103 skip
     6761          "+----------------+----------------+"                         AT 69 skip
     6762          substitute("Прикладная программа___&1&2", v-kkm-programm, fill("_", 32 - length(v-kkm-programm) )) format "X(55)"
     6763          "| регистрационный|" AT 69
     6764          v-kkm-code-reg format "x(16)" "|"  AT 103 skip
     6765          "+----------------+----------------+"                         AT 69 skip
     6766          "Вид деятельности по ОКДП" AT 62 "| " AT 86 "|" AT 103 skip
     6767                      "+----------------+"      AT 86 skip
     6768                "Кассир|                |"      AT 80 skip
     6769                      "+----------------+"      AT 86 skip
     6770          "Вид операции|                |"      AT 74 skip
     6771          "+----------------+----------------+" AT 46                    "+----------------+"      AT 86 skip
     6772          "| Номер документа|Дата составления|" AT 46    "РУКОВОДИТЕЛЬ" AT 86 skip
     6773          "+----------------+----------------+" AT 46 skip
     6774          space(25) "АКТ" "|" AT 46 "|" AT 63 STRING(p-date, "99/99/9999") FORMAT "x(10)" AT 65 "|" AT 80 (if trim(v-post) = "" then "_____________________" else v-post) FORMAT "x(21)" AT 83 skip
     6775          space(5) "О ВОЗВРАТЕ ДЕНЕЖНЫХ СУММ ПОКУПАТЕЛЯМ"  "+----------------+----------------+" AT 46  "должность" AT 86 skip
     6776          space(5) "(КЛИЕНТАМ) ПО НЕИСПОЛЬЗОВАННЫМ КАССОВЫМ ЧЕКАМ" "_______" AT 83 (if trim(v-boss) = "" then "______________" else v-boss) FORMAT "x(14)" AT 92 SKIP
     6777          space(5) "(в том числе по ошибочно пробитым кассовым чекам)" "подпись    расшифровка" AT 83 SKIP
     6778          space(5)  "Настоящий акт составлен комиссией, которая установила:" "___ _______ ____г." AT 86 SKIP
     6779      .
     6780   END.
     6781   end procedure.
     6782   Procedure PrintTitulReport :
     6783      PUT stream Out-Stream unformatted
     6784      ReportName       skip
     6785      " "              skip
     6786      str1             skip
     6787      str3             skip
     6788      str4             skip
     6789      ReportHeader     skip
     6790      .
     6791   end procedure .
     6792   procedure PrintPodval :
     6793   define input parameter p-sheet-name as character no-undo .
     6794   do on error undo, return error return-value  :
     6795      run rep/wp-qnty.p ( TRUNCATE(sum2-shift,0), output PropisSumall).
     6796      if PropisSumAll = ''
     6797      Then PropisSumAll = 'Ноль'.
     6798      ASSIGN
     6799         v-kop = ABSOLUTE(INTEGER((sum2-shift - TRUNCATE(sum2-shift,0)) * 100))
     6800      .
     6801      DEFINE VARIABLE v-length       AS INTEGER NO-UNDO.
     6802      DEFINE VARIABLE v-spase-pos-r  AS INTEGER NO-UNDO.
     6803      DEFINE VARIABLE v-out-str      AS CHARACTER NO-UNDO EXTENT 2.
     6804      DEFINE VARIABLE v-out-str-ex   AS CHARACTER NO-UNDO EXTENT 2.
     6805      v-out-str[1] = "на сумму " + PropisSumall + " руб. " + STRING(v-kop,"99") + " коп.".
     6806      v-length = LENGTH(v-out-str[1]).
     6807      IF v-length > 100
     6808      THEN DO:
     6809         ASSIGN
     6810            v-spase-pos-r   = R-INDEX(SUBSTRING(v-out-str[1], 1, 100)," ")
     6811            v-out-str[2] = SUBSTRING(v-out-str[1], v-spase-pos-r + 1)
     6812            v-out-str[1] = SUBSTRING(v-out-str[1], 1, v-spase-pos-r - 1)
     6813         .
     6814      END.
     6815      v-out-str-ex[1] = PropisSumall.
     6816      v-length = LENGTH(v-out-str-ex[1]).
     6817      IF v-length > 40
     6818      THEN DO:
     6819         ASSIGN
     6820            v-spase-pos-r   = R-INDEX(SUBSTRING(v-out-str-ex[1], 1, 40)," ")
     6821            v-out-str-ex[2] = SUBSTRING(v-out-str-ex[1], v-spase-pos-r + 1)
     6822            v-out-str-ex[1] = SUBSTRING(v-out-str-ex[1], 1, v-spase-pos-r - 1)
     6823         .
     6824      END.
     6825      for first buf_shift-staff
     6826       where buf_shift-staff.obj-type    = 'маг':U
     6827         and buf_shift-staff.obj-code    = This_Object.obj-code
     6828         and buf_shift-staff.shift-date  = x-date-start
     6829         and buf_shift-staff.shift-num   = x-shift-alone
     6830         and buf_shift-staff.staff-role  = yes
     6831       :
     6832           v-cashier = buf_shift-staff.name.
     6833       end.
     6834       if v-cashier = ""
     6835       then do:
     6836          for first buf_shift-staff
     6837          where buf_shift-staff.obj-type    = 'маг':U
     6838          and buf_shift-staff.obj-code    = This_Object.obj-code
     6839          and buf_shift-staff.shift-date  = x-date-start
     6840          and buf_shift-staff.shift-num   = x-shift-alone
     6841          and buf_shift-staff.staff-role  = no
     6842          :
     6843              v-cashier = buf_shift-staff.name.
     6844          end.
     6845       end.
     6846       for last buf_shift-staff
     6847          where buf_shift-staff.obj-type    = 'маг':U
     6848          and buf_shift-staff.obj-code    = This_Object.obj-code
     6849          and buf_shift-staff.shift-date  = x-date-start
     6850          and buf_shift-staff.shift-num   = x-shift-alone
     6851          and buf_shift-staff.staff-role  = no
     6852          :
     6853             v-cashier-op = buf_shift-staff.name.
     6854       end.
     6855       if v-cashier = v-cashier-op then v-cashier-op = "".
     6856      run km3xl-write-cell-data in this-procedure (
     6857            input substitute("&1_&2"
     6858                             , p-sheet-name
     6859                             ,"it_Summ":U
     6860                             )
     6861          , input sum2-shift
     6862      ).
     6863      run km3xl-write-cell-data in this-procedure (
     6864            input substitute("&1_&2"
     6865                             ,p-sheet-name
     6866                             ,"it_s_Summ_1":U
     6867                             )
     6868          , input v-out-str-ex[1]
     6869      ).
     6870      run km3xl-write-cell-data in this-procedure (
     6871            input substitute("&1_&2"
     6872                              , p-sheet-name
     6873                              ,"it_s_Summ_2":U
     6874                              )
     6875          , input v-out-str-ex[2]
     6876      ).
     6877      run km3xl-write-cell-data in this-procedure (
     6878            input substitute("&1_&2"
     6879                            , p-sheet-name
     6880                            ,"it_kop":U
     6881                            )
     6882          , input v-kop
     6883      ).
     6884      run km3xl-write-cell-data in this-procedure (
     6885            input substitute("&1_&2"
     6886                            , p-sheet-name
     6887                            ,"it_dir":U
     6888                            )
     6889          , input v-director
     6890      ).
     6891      run km3xl-write-cell-data in this-procedure (
     6892            input substitute("&1_&2"
     6893                            , p-sheet-name
     6894                            ,"f_cashier":U
     6895                            )
     6896          , input v-cashier
     6897      ).
     6898      run km3xl-write-cell-data in this-procedure (
     6899            input substitute("&1_&2"
     6900                            , p-sheet-name
     6901                            ,"f_cashier_op":U
     6902                            )
     6903          , input v-cashier-op
     6904      ).
     6905      PUT STREAM Out-Stream
     6906          space(5) "Выдано покупателям (клиентам) по возвращенным ими чекам (ошибочно пробитым чекам) согласно акту" Skip
     6907          space(5) v-out-str[1] FORMAT "X(103)" skip
     6908          space(5) v-out-str[2] FORMAT "X(103)" skip
     6909          space(5) "На указанную сумму следует уменьшить выручку кассы." skip(1)
     6910          space(5) "Перечисленные   возвращенные   покупателями   (клиентами) чеки  (ошибочно  пробитые  чеки)" skip
     6911          space(5) "погашены и прилагаются к акту. Приложение __________________________." skip
     6912          space(5) "Члены комиссии:" skip
     6913          space(5) "Заведующий отделом (секцией)"  v-director AT 80 format "X(25)"
     6914          UndLine format "X(25)" AT 40 UndLine format "X(35)" AT 70 skip
     6915          "(подпись)" format "X(25)" AT 48 "(расшифровка подписи)" format "X(25)" AT 78 skip
     6916          "Старший кассир" AT 6
     6917          UndLine format "X(25)" AT 40 UndLine format "X(35)" AT 70 skip
     6918          "(подпись)" format "X(25)" AT 48 "(расшифровка подписи)" format "X(25)" AT 78 skip
     6919          "Кассир-операционист" AT 6
     6920          UndLine format "X(25)" AT 40 UndLine format "X(35)" AT 70 skip
     6921          "(подпись)" format "X(25)" AT 48 "(расшифровка подписи)" format "X(25)" AT 78 skip
     6922          UndLine format "X(25)" AT 6  UndLine format "X(25)" AT 40 UndLine format "X(35)" AT 70 skip
     6923          "(должность)" format "X(25)" AT 13 "(подпись)" format "X(25)" AT 48  "(расшифровка подписи)" format "X(25)" AT 78 skip
     6924          UndLine format "X(25)" AT 6 UndLine format "X(25)" AT 40 UndLine format "X(35)" AT 70 skip
     6925          "(должность)" format "X(25)" AT 13 "(подпись)" format "X(25)" AT 48  "(расшифровка подписи)" format "X(25)" AT 78 skip
     6926      .
     6927   end.
     6928   end procedure.
     6929   PROCEDURE on-same-page :
     6930     define input parameter p-line-number as integer  no-undo .
     6931     if p-line-number > page-size( Out-Stream ) then return .
     6932     if line-counter( Out-Stream ) + p-line-number > page-size( Out-Stream )
     6933     then page stream Out-Stream .
     6934   END PROCEDURE.
