     5813             sym3                    column-label ":!:!:!:":U  format "X(1)"            space(0)
     5814             temp-str.shift-date     column-label " ! Дата  ! смены ! ":C10 format "99/99/9999"      space(0)
     5815             sym4                    column-label ":!:!:!:":U  format "X(1)"            space(0)
     5816             temp-str.shift-num      column-label " ! Номер ! смены ! ":C7  format "9999999"         space(0)
     5817             Sym5                    column-label ":!:!:!:":U  format "X(1)"            space(0)
     5818             temp-str.cash-num       column-label " ! Номер ! кассы ! ":C7  format "9999999"         space(0)
     5819             Sym6                    column-label ":!:!:!:":U  format "X(1)"            space(0)
     5820             temp-str.chk-num        column-label " ! Номер ! чека !":C7  format "9999999"         space(0)
     5821             sym7                    column-label ":!:!:!:":U  format "X(1)"            space(0)
