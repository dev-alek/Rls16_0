     2060   end procedure.
     2061   define stream excel-line.
     2062   define stream excel-cell.
     2063   define temp-table temp_cell-data no-undo
     2064       field data-key as character
     2065       field data-value as character
     2066       index pi is primary unique data-key
     2067   .
     2068   define temp-table temp_line-data no-undo
     2069       field sheet-name    as character
     2070       field xl-line-id    as integer
     2071       field d_LineNum      as integer
     2072       field d_SectionName as character
     2073       field d_ShiftNum    as character
     2074       field d_ChkNum      as integer
     2075       field d_Summ      as decimal
     2076       field d_menager      as character
     2077       index pi is primary unique
     2078             xl-line-id
     2079   .
     2080   define variable v-km3xl-current-data-row     as integer      no-undo.
     2081   define variable v-km3xl-cell-file-name       as character    no-undo.
     2082   define variable v-km3xl-data-file-name       as character    no-undo.
     2083   procedure km3xl-init :
     2084   define input parameter p-first-sheet as logical no-undo .
     2085   define input parameter p-sheet-name as character no-undo .
     2086   define input parameter p-sheet-list as character no-undo .
     2087   define input parameter p-sheet-list-copy-from as character no-undo .
     2088       define buffer buf_temp_cell-data        for temp_cell-data.
     2089       define buffer buf_usr-flt               for ubflt.usr-flt.
     2090   do
     2091   for buf_temp_cell-data
     2092     , buf_usr-flt
     2093   on error undo, return error
     2094   :
     2095       assign
     2096           v-km3xl-current-data-row = 0
     2097       .
     2098       if p-first-sheet then do:
     2099       run gbl/_tmpfile.p (
     2100             input "xd"
     2101           , input ".txt"
     2102           , output v-km3xl-data-file-name
     2103       ).
     2104       output stream excel-line to value( v-km3xl-data-file-name ).
     2105       run gbl/_tmpfile.p (
     2106             input "xc"
     2107           , input ".txt"
     2108           , output v-km3xl-cell-file-name
     2109       ).
     2110       output stream excel-cell to value( v-km3xl-cell-file-name ).
     2111         run km3xl-write-cell-data in this-procedure (
     2112               input "sheetListcopyfrom":U
     2113             , input p-sheet-list-copy-from
     2114         ).
     2115         run km3xl-write-cell-data in this-procedure (
     2116               input "sheetList":U
     2117             , input p-sheet-list
     2118         ).
     2119       end.
     2120       if printrubl = yes
     2121       then do:
     2122           run km3xl-write-cell-data in this-procedure (
     2123                 input substitute("&1_&2"
     2124                                  , p-sheet-name
     2125                                  , "valutCode":U
     2126                                  )
     2127               , input "0":U
     2128           ).
     2129       end.
     2130       else do:
     2131           run km3xl-write-cell-data in this-procedure (
     2132                 input substitute("&1_&2"
     2133                                   , p-sheet-name
     2134                                   , "valutCode":U
     2135                                   )
     2136               , input "1":U
     2137           ).
     2138       end.
     2139       run km3xl-write-cell-data in this-procedure (
     2140             input substitute("&1_&2"
     2141                              ,p-sheet-name
     2142                              ,"columnList":U
     2143                              )
     2144           , input "LineNum,sectionName,ShiftNum,ChkNum,Summ,menager":U
     2145       ).
     2146       run km3xl-write-cell-data in this-procedure (
     2147             input substitute("&1_&2"
     2148                               , p-sheet-name
     2149                               ,"columnType":U
     2150                               )
     2151           , input "I,S,S,I,D,S":U
     2152       ).
     2153       run km3xl-write-cell-data in this-procedure (
     2154             input substitute("&1_&2"
     2155                               , p-sheet-name
     2156                               ,"columnAmount":U
     2157                               )
     2158           , input "6":U
     2159       ).
     2160   end.
     2161   end procedure.
     2162   procedure km3xl-close :
     2163   do
     2164   on error undo, return error
     2165   :
     2166       output stream excel-line close.
     2167       output stream excel-cell close.
     2168       output to value( string( session:temp-directory + "$" + string( g#report-num ) ) + ".txl" ) .
     2169           export "exe/km3_97.xlt":U.
     2170           export "exe/t_form.bas":U.
     2171           export v-km3xl-cell-file-name.
     2172           export v-km3xl-data-file-name.
     2173       output close.
     2174   end.
     2175   end procedure.
     2176   procedure km3xl-write-cell-data :
     2177   define input parameter p-data-key   as character        no-undo.
     2178   define input parameter p-data-value as character        no-undo.
     2179       define buffer buf_temp_cell-data     for temp_cell-data.
     2180   do
     2181   for buf_temp_cell-data
     2182   on error undo, return error
     2183   :
     2184       find first buf_temp_cell-data
     2185            where buf_temp_cell-data.data-key = p-data-key
     2186       no-error.
     2187       if not available buf_temp_cell-data
     2188       then do:
     2189           create buf_temp_cell-data.
     2190           assign
     2191               buf_temp_cell-data.data-key = p-data-key
     2192           .
     2193       end.
     2194       assign
     2195           buf_temp_cell-data.data-value = p-data-value
     2196       .
     2197       put stream excel-cell unformatted
     2198                           buf_temp_cell-data.data-key
     2199           CHR(9)   buf_temp_cell-data.data-value
     2200           chr(10)
     2201       .
     2202   end.
     2203   end procedure.
     2204   procedure km3xl-write-line-data :
     2205   define input parameter p-sheet-name     as character no-undo .
     2206   define input parameter p-d_LineNum      as integer          no-undo.
     2207   define input parameter p-d_SectionName as character        no-undo.
     2208   define input parameter p-d_ShiftNum    as character          no-undo.
     2209   define input parameter p-d_ChkNum      as integer          no-undo.
     2210   define input parameter p-d_Summ      as decimal          no-undo.
     2211   define input parameter p-d_menager      as character        no-undo.
     2212   define buffer buf_temp_line-data        for temp_line-data.
     2213   do
     2214   for buf_temp_line-data
     2215   on error undo, return error
     2216   :
     2217       for each buf_temp_line-data
     2218       :
     2219           delete buf_temp_line-data.
     2220       end.
     2221       create buf_temp_line-data.
     2222       assign
     2223           buf_temp_line-data.sheet-name    = p-sheet-name
     2224           buf_temp_line-data.xl-line-id    = p-d_LineNum
     2225           buf_temp_line-data.d_LineNum     = p-d_LineNum
     2226           buf_temp_line-data.d_SectionName = p-d_SectionName
     2227           buf_temp_line-data.d_ShiftNum    = p-d_ShiftNum
     2228           buf_temp_line-data.d_ChkNum      = p-d_ChkNum
     2229           buf_temp_line-data.d_Summ        = p-d_Summ
     2230           buf_temp_line-data.d_menager      = p-d_menager
     2231       .
     2232       put stream excel-line unformatted
     2233                           buf_temp_line-data.sheet-name
     2234           CHR(9)   "DTA":U
     2235           CHR(9)   buf_temp_line-data.d_LineNum
     2236           CHR(9)   buf_temp_line-data.d_SectionName
     2237           CHR(9)   buf_temp_line-data.d_ShiftNum
     2238           CHR(9)   buf_temp_line-data.d_ChkNum
     2239           CHR(9)   buf_temp_line-data.d_Summ
     2240           CHR(9)   buf_temp_line-data.d_menager
     2241           chr(10)
     2242       .
     2243   end.
     2244   end procedure.
     2245   procedure km3xl-run-excel :
     2246   define input parameter p-header-filename    as character        no-undo.
     2247   define input parameter p-data-filename      as character        no-undo.
     2248       define variable v-template-file-name    as character    no-undo.
     2249       define variable v-vb-file-name          as character    no-undo.
     2250       define buffer buf_temp-param for temp-param .
     2251   do
     2252   for buf_temp-param
     2253   on error undo, return error
     2254   :
     2255       create buf_temp-param.
     2256       assign
     2257           v-template-file-name    = search( "exe/km3_97.xlt" )
     2258           v-vb-file-name          = search( "exe/t_form.bas")
     2259       .
     2260       if v-template-file-name = ?
     2261       or v-template-file-name = "":U
     2262       then do:
     2263           message
     2264               "Ошибка имени файла шаблона."
     2265           view-as alert-box error.
     2266       end.
     2267       if v-vb-file-name = ?
     2268       or v-vb-file-name = "":U
     2269       then do:
     2270           message
     2271               "Ошибка имени файла кода обработки."
     2272           view-as alert-box error.
     2273       end.
     2274       run paramls-write in this-procedure (
     2275             input "template":U
     2276           , input "template-file-name":U
     2277           , input v-template-file-name
     2278       ).
     2279       run paramls-write in this-procedure (
     2280             input "template":U
     2281           , input "vb-file-name":U
     2282           , input v-vb-file-name
     2283       ).
     2284       run paramls-write in this-procedure (
     2285             input "data":U
     2286           , input "data-header-filename":U
     2287           , input p-header-filename
     2288       ).
     2289       run paramls-write in this-procedure (
     2290             input "data":U
     2291           , input "data-filename":U
     2292           , input p-data-filename
     2293       ).
     2294       run gbl/macroxlt.p (
     2295           input-output table buf_temp-param
     2296       ) no-error.
     2297       if error-status :error
     2298       then do:
     2299           message
     2300                    vss-workfile vss-revision vss-description
     2301               skip(1)
     2302               skip "Ошибка создания файла Excel."
     2303               skip return-value
     2304               skip trim(error-status :get-message(1))
     2305                    trim(error-status :get-message(2))
     2306                    trim(error-status :get-message(3))
     2307           view-as alert-box error.
     2308           undo, return error .
     2309       end.
     2310   end.
     2311   end procedure.
     2312   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2313   function shift-name-no-err return char (
     2314                                           buffer loc-chk-doc for ub.chk-doc
     2315    ).
