     3374       v-recipient  = v-recipient-code
     3375       v-type-rec = substring(v-recipient-code,1,3)
     3376       v-code-rec  = int(substring(v-recipient-code,4,15))
     3377       no-error
     3378     .
     3379     if v-type-rec = ? then v-type-rec = "" .
     3380     if v-code-rec  = ? then v-code-rec  =  0 .
     3381     end procedure.
