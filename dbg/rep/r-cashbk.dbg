     4549   procedure report-exec :
     4550     define input  parameter p-date        as date    no-undo .
     4551     define input parameter p-cash-book as integer no-undo .
     4552     assign
     4553       v-ost-begin = 0
     4554       v-num-obj   = 0
     4555       .
     4556     empty temp-table temp-fin-sum .
     4557     empty temp-table temp-fin-doc .
     4558     for each buf_obj-list no-lock :
     4559   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4560   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     4561     (input  buf_obj-list.obj-type
     4562     ,input  buf_obj-list.obj-code
     4563     ,output v-host-code
     4564     )  .
     4565       assign
     4566         fact-order-1 = 0
     4567         fact-order-2 = 0
     4568         v-sum-begin  = 0
     4569         v-shift-on   = yes
     4570         .
     4571       find first buf_cashbook no-lock where buf_cashbook.id = p-cash-book no-error .
     4572       run fostatok in this-procedure (
     4573         input   v-host-code
     4574         ,input   buf_obj-list.obj-code
     4575         ,input   buf_obj-list.obj-type
     4576         ,input   x-tog-shift
     4577         ,input   p-date - 1
     4578         ,input   date('')
     4579         ,input   ( if p-date <> x-date-start then 0 else x-shift-start )
     4580         ,input   X-shift-end
     4581         ,input   yes
     4582         ,input   0
     4583         ,input   buf_cashbook.id
     4584         ,output  v-sum-begin
     4585         ,output  Fact-order-1)
     4586         no-error .
     4587       run fostatok in this-procedure (
     4588         input   v-host-code
     4589         ,input   buf_obj-list.obj-code
     4590         ,input   buf_obj-list.obj-type
     4591         ,input   x-tog-shift
     4592         ,input   p-date
     4593         ,input   x-date-end
     4594         ,input   X-shift-end
     4595         ,input   X-shift-end
     4596         ,input   yes
     4597         ,input   0
     4598         ,input   buf_cashbook.id
     4599         ,output  sum1
     4600         ,output  Fact-order-2)
     4601         no-error .
     4602       for each buf_arh-fin-doc-schet-nal-obj no-lock
     4603         where buf_arh-fin-doc-schet-nal-obj.host-code         = v-host-code
     4604         and buf_arh-fin-doc-schet-nal-obj.obj-type          = buf_obj-list.obj-type
     4605         and buf_arh-fin-doc-schet-nal-obj.obj-code          = buf_obj-list.obj-code
     4606         and buf_arh-fin-doc-schet-nal-obj.cli-type          = 'орг':U
     4607         and buf_arh-fin-doc-schet-nal-obj.cli-code          = v-host-code
     4608         and buf_arh-fin-doc-schet-nal-obj.fin-code-acc      = 0
     4609         and buf_arh-fin-doc-schet-nal-obj.curr-code         = 0
     4610         and buf_arh-fin-doc-schet-nal-obj.cashbookid        = integer(entry(ii,p-cashbook,chr(6)))
     4611         and buf_arh-fin-doc-schet-nal-obj.fin-ext-doc-type  = "":U
     4612         and buf_arh-fin-doc-schet-nal-obj.calc-curr-code    = 0
     4613         and buf_arh-fin-doc-schet-nal-obj.sum-type          = (if x-tog-shift then 'shift-obj':U else 'obj':U )
     4614         and buf_arh-fin-doc-schet-nal-obj.fact-order       >= fact-order-1
     4615         and buf_arh-fin-doc-schet-nal-obj.fact-order       <= fact-order-2
     4616         and p-date = ( if x-tog-shift then buf_arh-fin-doc-schet-nal-obj.shift-date else buf_arh-fin-doc-schet-nal-obj.fact-date )
     4617         use-index pi :
     4618         if x-TOG-Shift then
     4619         do:
     4620           if buf_arh-fin-doc-schet-nal-obj.shift-date = x-Date-Start and buf_arh-fin-doc-schet-nal-obj.shift-num < x-Shift-Start then next .
     4621           if buf_arh-fin-doc-schet-nal-obj.shift-date = x-date-End   and buf_arh-fin-doc-schet-nal-obj.shift-num > x-Shift-End then next .
     4622         end.
     4623         find first buf_fin-doc
     4624           where buf_fin-doc.host-code         = v-host-code
     4625           and buf_fin-doc.fin-doc-code      = buf_arh-fin-doc-schet-nal-obj.fin-doc-code
     4626           and buf_fin-doc.CashBookId        = buf_arh-fin-doc-schet-nal-obj.cashbookid
     4627           and buf_fin-doc.obj-type          = buf_obj-list.obj-type
     4628           and buf_fin-doc.obj-code          = buf_obj-list.obj-code
     4629           and buf_fin-doc.status_           = 'факт':U
     4630           and (buf_fin-doc.fin-ext-doc-type = 'пко':U
     4631           or buf_fin-doc.fin-ext-doc-type   = 'рко':U )
     4632           no-error.
     4633         if available buf_fin-doc then
     4634         do :
     4635                                                   if buf_fin-doc.trn-doc-code = (if buf_fin-doc.obj-code > 0 then substitute('&1&2', buf_fin-doc.obj-type, string(buf_fin-doc.obj-code, '99999')) else '') then
     4636           do:
     4637             find first temp-fin-doc
     4638               where temp-fin-doc.host-code    = v-host-code
     4639               and temp-fin-doc.obj-code     = buf_obj-list.obj-code
     4640               and temp-fin-doc.obj-type     = buf_obj-list.obj-type
     4641               and temp-fin-doc.cashbook_id  = buf_cashbook.id
     4642               and temp-fin-doc.fin-doc-code = buf_fin-doc.fin-doc-code
     4643               use-index pi no-error .
     4644             if not available temp-fin-doc
     4645               then
     4646             do :
     4647               create temp-fin-doc.
     4648               assign
     4649                 temp-fin-doc.obj-code      = buf_obj-list.obj-code
     4650                 temp-fin-doc.obj-type      = buf_obj-list.obj-type
     4651                 temp-fin-doc.host-code     = v-host-code
     4652                 temp-fin-doc.cashbook      = if available (buf_cashbook) then buf_cashbook.CashBookName else "Основная деятельность"
     4653                 temp-fin-doc.cashbook_id   = if available (buf_cashbook) then buf_cashbook.id else 0
     4654                 temp-fin-doc.ostatok-begin = v-sum-begin
     4655                 temp-fin-doc.fin-doc-code  = buf_fin-doc.fin-doc-code
     4656                 .
     4657             end.
     4658             assign
     4659               temp-fin-doc.sheet-num    = v-sheet-num
     4660               temp-fin-doc.prn-doc-code = buf_fin-doc.prn-doc-code
     4661               temp-fin-doc.payer        = buf_fin-doc.payer-name
     4662               temp-fin-doc.receiver     = buf_fin-doc.receiver-name
     4663               temp-fin-doc.cor-acc      = buf_fin-doc.cor-acc-value
     4664               temp-fin-doc.fin-doc-type = buf_fin-doc.fin-doc-type
     4665               temp-fin-doc.sum-rubl     = buf_fin-doc.sum-doc
     4666               .
     4667             if temp-fin-doc.fin-doc-type = 'пко':U then temp-fin-doc.sum-income = temp-fin-doc.sum-income + temp-fin-doc.sum-rubl .
     4668             else temp-fin-doc.sum-expense = temp-fin-doc.sum-expense + temp-fin-doc.sum-rubl .
     4669             find first temp-fin-sum where
     4670               temp-fin-sum.host-code    = temp-fin-doc.host-code
     4671               and temp-fin-sum.obj-code     = temp-fin-doc.obj-code
     4672               and temp-fin-sum.obj-type     = temp-fin-doc.obj-type
     4673               and temp-fin-sum.cashbook_id  = temp-fin-doc.cashbook_id
     4674               use-index pi no-error .
     4675             if not available (temp-fin-sum) then
     4676             do:
     4677               create temp-fin-sum .
     4678               assign
     4679                 temp-fin-sum.host-code   = temp-fin-doc.host-code
     4680                 temp-fin-sum.obj-code    = temp-fin-doc.obj-code
     4681                 temp-fin-sum.obj-type    = temp-fin-doc.obj-type
     4682                 temp-fin-sum.cashbook_id = temp-fin-doc.cashbook_id
     4683                 .
     4684             end.
     4685             assign
     4686               temp-fin-sum.sum-expense = temp-fin-sum.sum-expense + temp-fin-doc.sum-expense
     4687               temp-fin-sum.sum-income  = temp-fin-sum.sum-income + temp-fin-doc.sum-income
     4688               temp-fin-sum.ostatok     = temp-fin-doc.ostatok-begin + temp-fin-sum.sum-income - temp-fin-sum.sum-expense
     4689               .
     4690           end.
     4691         end.
     4692       end.
     4693     end.
     4694     release buf_fin-doc .
     4695   end procedure .
     4696   PROCEDURE get-report-num :
     4697     define output parameter p-report-num as integer no-undo .
     4698     do
     4699       on error undo, return error return-value
     4700       :
     4701       run gbl/getrpnum.p (output p-report-num).
     4702     end.
     4703   END PROCEDURE.
