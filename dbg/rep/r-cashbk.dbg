     3867     o-head-position = mCashBook:getSinglRule(integer(entry(ii,p-cashbook,chr(6))), v-obj-type, v-obj-code, "ManagerPosition") .
     3868     o-director      = mCashBook:getSinglRule(integer(entry(ii,p-cashbook,chr(6))), v-obj-type, v-obj-code, "ManagerFIO") .
     3869     o-snr-accnt     = mCashBook:getSinglRule(integer(entry(ii,p-cashbook,chr(6))), v-obj-type, v-obj-code, "BuhFIO") .
     3870     delete object mCashBook no-error .
     3871     case o-head-position:
     3872       when '0':U then
     3873         do:
     3874           v-head-position = buf_sysconf.head-position.
     3875         end.
     3876       when '1':U then
     3877         do:
     3878           v-head-position = "Директор".
     3879         end.
     3880       when '2' then
     3881         do:
     3882           v-head-position = "Управляющий".
     3883         end.
     3884       otherwise
     3885       do :
     3886         v-head-position = o-head-position .
     3887       end.
     3888     end case.
     3889     case o-director:
     3890       when '1':U then
     3891         do:
     3892           if v-obj-type = 'маг':U then
     3893           do:
     3894             find first buf_shop no-lock where
     3895               buf_shop.obj-code = v-obj-code no-error .
     3896             if available buf_shop then
     3897             do:
     3898               v-director = buf_shop.director.
     3899             end.
     3900           end.
     3901           if v-obj-type = 'скл':U then
     3902           do:
     3903             find first buf_store no-lock where
     3904               buf_store.obj-code = v-obj-code no-error .
     3905             if available buf_store then
     3906             do:
     3907               v-director = buf_store.store-boss.
     3908             end.
     3909           end.
     3910         end.
     3911       when '0':U then
