     3850   do ii = 1 to num-entries (p-cashbook,chr(6)):
     3851     mCashBook = new ibs.th.ref.cashbookstorage () .
     3852     define variable v-ok as logical no-undo .
     3853           if v-cntxt-db-num = 0 then
