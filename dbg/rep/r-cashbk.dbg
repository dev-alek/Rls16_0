     3362   FUNCTION LastMonthDate RETURNS DATE    ( INPUT i-date AS DATE ) :
     3363     DEFINE VARIABLE t_date AS DATE NO-UNDO.
     3364     RUN get-last-month-date IN THIS-PROCEDURE ( INPUT i-date, OUTPUT t_date ) NO-ERROR.
     3365     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE t_date ).
     3366   END FUNCTION.
     3367   PROCEDURE get-last-month-date :
     3368     DEFINE  INPUT PARAMETER p-curr-date AS DATE NO-UNDO.
     3369     DEFINE OUTPUT PARAMETER p-last-date AS DATE NO-UNDO.
     3370     DO ON ERROR UNDO, RETURN ERROR :
     3371       ASSIGN p-last-date = DATE( MONTH( p-curr-date ), 28,  YEAR( p-curr-date ) ).
     3372       ASSIGN p-last-date = p-last-date - DAY( p-last-date + 4 ) + 4.
     3373     END.
     3374   END PROCEDURE.
     3375   FUNCTION LastMonthDay  RETURNS INTEGER ( INPUT i-date AS DATE ) :
     3376     DEFINE VARIABLE j_day AS INTEGER NO-UNDO.
     3377     RUN get-last-month-day IN THIS-PROCEDURE ( INPUT i-date, OUTPUT j_day ) NO-ERROR.
     3378     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE j_day ).
     3379   END FUNCTION.
     3380   PROCEDURE get-last-month-day :
     3381     DEFINE  INPUT PARAMETER p-date AS DATE    NO-UNDO.
     3382     DEFINE OUTPUT PARAMETER p-day  AS INTEGER NO-UNDO.
     3383     DEFINE VARIABLE t_date AS DATE NO-UNDO.
     3384     DO ON ERROR UNDO, RETURN ERROR :
     3385       ASSIGN t_date = DATE( MONTH( p-date ), 28,  YEAR( p-date ) ).
     3386       ASSIGN p-day  = DAY( t_date - DAY( t_date + 4 ) + 4 ).
     3387     END.
     3388   END PROCEDURE.
     3389   FUNCTION LastDay-MY  RETURNS INTEGER ( INPUT i-month AS INTEGER, INPUT i-year AS INTEGER ) :
     3390     DEFINE VARIABLE j_day AS INTEGER NO-UNDO.
     3391     RUN get-last-day-MY IN THIS-PROCEDURE ( INPUT i-month, INPUT i-year, OUTPUT j_day ) NO-ERROR.
     3392     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE j_day ).
     3393   END FUNCTION.
     3394   PROCEDURE get-last-day-MY :
     3395     DEFINE  INPUT PARAMETER p-month AS INTEGER NO-UNDO.
     3396     DEFINE  INPUT PARAMETER p-year  AS INTEGER NO-UNDO.
     3397     DEFINE OUTPUT PARAMETER p-day   AS INTEGER NO-UNDO.
     3398     DEFINE VARIABLE t_date AS DATE NO-UNDO.
     3399     DO ON ERROR UNDO, RETURN ERROR :
     3400       ASSIGN t_date = DATE( p-month, 28, p-year ).
     3401       ASSIGN p-day  = DAY( t_date - DAY( t_date + 4 ) + 4 ).
     3402     END.
     3403   END PROCEDURE.
     3404   FUNCTION LastDate-MY RETURNS DATE    ( INPUT i-month AS INTEGER, INPUT i-year AS INTEGER ) :
     3405     DEFINE VARIABLE t_date AS DATE NO-UNDO.
     3406     RUN get-last-date-MY IN THIS-PROCEDURE ( INPUT i-month, INPUT i-year, OUTPUT t_date ) NO-ERROR.
     3407     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE t_date ).
     3408   END FUNCTION.
     3409   PROCEDURE get-last-date-MY :
     3410     DEFINE  INPUT PARAMETER p-month AS INTEGER NO-UNDO.
     3411     DEFINE  INPUT PARAMETER p-year  AS INTEGER NO-UNDO.
     3412     DEFINE OUTPUT PARAMETER p-date  AS DATE    NO-UNDO.
     3413     DO ON ERROR UNDO, RETURN ERROR :
     3414       ASSIGN p-date = DATE( p-month, 28, p-year ).
     3415       ASSIGN p-date = p-date - DAY( p-date + 4 ) + 4.
     3416     END.
     3417   END PROCEDURE.
     3418   FUNCTION NextMonth RETURNS INTEGER ( INPUT i-date AS DATE ) :
     3419     DEFINE VARIABLE j_month AS INTEGER NO-UNDO.
     3420     RUN get-next-month IN THIS-PROCEDURE ( INPUT i-date, OUTPUT j_month ) NO-ERROR.
     3421     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE j_month ).
     3422   END FUNCTION.
     3423   PROCEDURE get-next-month :
     3424     DEFINE  INPUT PARAMETER p-date  AS DATE    NO-UNDO.
     3425     DEFINE OUTPUT PARAMETER p-month AS INTEGER NO-UNDO.
     3426     DO ON ERROR UNDO, RETURN ERROR :
     3427       ASSIGN p-month = ( MONTH( p-date ) MODULO 12 ) + 1.
     3428     END.
     3429   END PROCEDURE.
     3430   FUNCTION NextYear  RETURNS INTEGER ( INPUT i-date AS DATE ) :
     3431     DEFINE VARIABLE j_year AS INTEGER NO-UNDO.
     3432     RUN get-next-year IN THIS-PROCEDURE ( INPUT i-date, OUTPUT j_year ) NO-ERROR.
     3433     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE j_year ).
     3434   END FUNCTION.
     3435   PROCEDURE get-next-year :
     3436     DEFINE  INPUT PARAMETER p-date AS DATE    NO-UNDO.
     3437     DEFINE OUTPUT PARAMETER p-year AS INTEGER NO-UNDO.
     3438     DO ON ERROR UNDO, RETURN ERROR :
     3439       ASSIGN p-year = YEAR( p-date ) + ( IF MONTH( p-date ) < 12 THEN 0 ELSE 1 ).
     3440     END.
     3441   END PROCEDURE.
     3442   FUNCTION PrevMonth RETURNS INTEGER ( INPUT i-date AS DATE ) :
     3443     DEFINE VARIABLE j_month AS INTEGER NO-UNDO.
     3444     RUN get-prev-month IN THIS-PROCEDURE ( INPUT i-date, OUTPUT j_month ) NO-ERROR.
     3445     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE j_month ).
     3446   END FUNCTION.
     3447   PROCEDURE get-prev-month :
     3448     DEFINE  INPUT PARAMETER p-date  AS DATE    NO-UNDO.
     3449     DEFINE OUTPUT PARAMETER p-month AS INTEGER NO-UNDO.
     3450     DO ON ERROR UNDO, RETURN ERROR :
     3451       ASSIGN p-month = ( ( ( MONTH( p-date ) + 10 ) MODULO 12 ) MODULO 12 ) + 1.
     3452     END.
     3453   END PROCEDURE.
     3454   FUNCTION PrevYear  RETURNS INTEGER ( INPUT i-date AS DATE ) :
     3455     DEFINE VARIABLE j_year AS INTEGER NO-UNDO.
     3456     RUN get-prev-year IN THIS-PROCEDURE ( INPUT i-date, OUTPUT j_year ) NO-ERROR.
     3457     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE j_year ).
     3458   END FUNCTION.
     3459   PROCEDURE get-prev-year :
     3460     DEFINE  INPUT PARAMETER p-date AS DATE    NO-UNDO.
     3461     DEFINE OUTPUT PARAMETER p-year AS INTEGER NO-UNDO.
     3462     DO ON ERROR UNDO, RETURN ERROR :
     3463       ASSIGN p-year = YEAR( p-date ) + ( IF MONTH( p-date ) = 1 THEN -1 ELSE 0 ).
     3464     END.
     3465   END PROCEDURE.
     3466   FUNCTION NextMonth-MY RETURNS INTEGER ( INPUT i-month AS INTEGER ) :
     3467     DEFINE VARIABLE j_month AS INTEGER NO-UNDO.
     3468     RUN get-next-month-MY IN THIS-PROCEDURE ( INPUT i-month, OUTPUT j_month ) NO-ERROR.
     3469     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE j_month ).
     3470   END FUNCTION.
     3471   PROCEDURE get-next-month-MY :
     3472     DEFINE  INPUT PARAMETER p-curr-month AS INTEGER NO-UNDO.
     3473     DEFINE OUTPUT PARAMETER p-next-month AS INTEGER NO-UNDO.
     3474     DO ON ERROR UNDO, RETURN ERROR :
     3475       ASSIGN p-next-month = ( p-curr-month MODULO 12 ) + 1.
     3476     END.
     3477   END PROCEDURE.
     3478   FUNCTION NextYear-MY  RETURNS INTEGER ( INPUT i-month AS INTEGER, INPUT i-year AS INTEGER ) :
     3479     DEFINE VARIABLE j_year AS INTEGER NO-UNDO.
     3480     RUN get-next-year-MY IN THIS-PROCEDURE ( INPUT i-month, INPUT i-year, OUTPUT j_year ) NO-ERROR.
     3481     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE j_year ).
     3482   END FUNCTION.
     3483   PROCEDURE get-next-year-MY :
     3484     DEFINE  INPUT PARAMETER p-curr-month AS INTEGER NO-UNDO.
     3485     DEFINE  INPUT PARAMETER p-curr-year  AS INTEGER NO-UNDO.
     3486     DEFINE OUTPUT PARAMETER p-next-year  AS INTEGER NO-UNDO.
     3487     DO ON ERROR UNDO, RETURN ERROR :
     3488       ASSIGN p-next-year = p-curr-year + ( IF p-curr-month < 12 THEN 0 ELSE 1 ).
     3489     END.
     3490   END PROCEDURE.
     3491   FUNCTION MonthNameRus RETURNS CHARACTER ( INPUT i-month AS INTEGER ) :
     3492     DEFINE VARIABLE v-name AS CHARACTER NO-UNDO.
     3493     RUN get-month-name-rus IN THIS-PROCEDURE ( INPUT i-month, OUTPUT v-name ) NO-ERROR.
     3494     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE v-name ).
     3495   END FUNCTION.
     3496   PROCEDURE get-month-name-rus :
     3497     DEFINE  INPUT PARAMETER p-month AS INTEGER   NO-UNDO.
     3498     DEFINE OUTPUT PARAMETER p-name  AS CHARACTER NO-UNDO.
     3499     DEFINE VARIABLE v-list AS CHARACTER NO-UNDO INITIAL "Январь,Февраль,Март,Апрель,Май,Июнь,Июль,Август,Сентябрь,Октябрь,Ноябрь,Декабрь".
     3500     DO ON ERROR UNDO, RETURN ERROR :
     3501       ASSIGN p-name = ( IF p-month >= 1 AND p-month <= 12 THEN ENTRY( p-month, v-list ) ELSE ? ).
     3502     END.
     3503   END PROCEDURE.
     3504   FUNCTION MonthNameRusGen RETURNS CHARACTER ( INPUT i-month AS INTEGER ) :
     3505     DEFINE VARIABLE v-name AS CHARACTER NO-UNDO.
     3506     RUN get-month-name-gen IN THIS-PROCEDURE ( INPUT i-month, OUTPUT v-name ) NO-ERROR.
     3507     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE v-name ).
     3508   END FUNCTION.
     3509   PROCEDURE get-month-name-gen :
     3510     DEFINE  INPUT PARAMETER p-month AS INTEGER   NO-UNDO.
     3511     DEFINE OUTPUT PARAMETER p-name  AS CHARACTER NO-UNDO.
     3512     DEFINE VARIABLE v-list AS CHARACTER NO-UNDO INITIAL "Января,Февраля,Марта,Апреля,Мая,Июня,Июля,Августа,Сентября,Октября,Ноября,Декабря".
     3513     DO ON ERROR UNDO, RETURN ERROR :
     3514       ASSIGN p-name = ( IF p-month >= 1 AND p-month <= 12 THEN ENTRY( p-month, v-list ) ELSE ? ).
     3515     END.
     3516   END PROCEDURE.
     3517   FUNCTION CalcMonthes  RETURNS INTEGER ( INPUT i-date-from AS DATE, INPUT i-date-till AS DATE ) :
     3518     DEFINE VARIABLE j_month-num AS INTEGER NO-UNDO.
     3519     RUN get-month-number IN THIS-PROCEDURE ( INPUT i-date-from, INPUT i-date-till, OUTPUT j_month-num ) NO-ERROR.
     3520     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE j_month-num ).
     3521   END FUNCTION.
     3522   PROCEDURE get-month-number :
     3523     DEFINE  INPUT PARAMETER p-date-from AS DATE    NO-UNDO.
     3524     DEFINE  INPUT PARAMETER p-date-till AS DATE    NO-UNDO.
     3525     DEFINE OUTPUT PARAMETER p-month-num AS INTEGER NO-UNDO.
     3526     DO ON ERROR UNDO, RETURN ERROR :
     3527       ASSIGN p-month-num = ( YEAR(  p-date-till ) - YEAR(  p-date-from ) ) * 12 +
     3528                              MONTH( p-date-till ) - MONTH( p-date-from )   +  1 .
     3529     END.
     3530   END PROCEDURE.
     3531   FUNCTION CalcMonth-MY RETURNS INTEGER ( INPUT i-year-from  AS INTEGER,
     3532                                           INPUT i-month-from AS INTEGER,
     3533                                           INPUT i-year-till  AS INTEGER,
     3534                                           INPUT i-month-till AS INTEGER  ) :
     3535     DEFINE VARIABLE j_month-num AS INTEGER NO-UNDO.
     3536     RUN get-month-num-MY IN THIS-PROCEDURE (  INPUT i-year-from,
     3537                                               INPUT i-month-from,
     3538                                               INPUT i-year-till,
     3539                                               INPUT i-month-till,
     3540                                              OUTPUT j_month-num   ) NO-ERROR.
     3541     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE j_month-num ).
     3542   END FUNCTION.
     3543   PROCEDURE get-month-num-MY :
     3544     DEFINE  INPUT PARAMETER p-year-from  AS INTEGER NO-UNDO.
     3545     DEFINE  INPUT PARAMETER p-month-from AS INTEGER NO-UNDO.
     3546     DEFINE  INPUT PARAMETER p-year-till  AS INTEGER NO-UNDO.
     3547     DEFINE  INPUT PARAMETER p-month-till AS INTEGER NO-UNDO.
     3548     DEFINE OUTPUT PARAMETER p-month-num  AS INTEGER NO-UNDO.
     3549     DO ON ERROR UNDO, RETURN ERROR :
     3550       ASSIGN p-month-num = ( p-year-till - p-year-from ) * 12 + p-month-till - p-month-from + 1.
     3551     END.
     3552   END PROCEDURE.
     3553   FUNCTION DateTimeHeader RETURNS CHARACTER ( INPUT i-date AS DATE ) :
     3554     DEFINE VARIABLE v-header AS CHARACTER NO-UNDO.
     3555     RUN get-date-time-header IN THIS-PROCEDURE ( INPUT i-date, OUTPUT v-header ) NO-ERROR.
     3556     RETURN ( IF ERROR-STATUS :ERROR THEN "":U ELSE v-header ).
     3557   END FUNCTION.
     3558   PROCEDURE get-date-time-header :
     3559     DEFINE  INPUT PARAMETER p-date AS DATE      NO-UNDO.
     3560     DEFINE OUTPUT PARAMETER p-head AS CHARACTER NO-UNDO.
     3561     DO ON ERROR UNDO, RETURN ERROR :
     3562       IF p-date = ? THEN DO: ASSIGN p-date = TODAY. END.
     3563       ASSIGN p-head = "Дата печати: " + STRING( p-date, "99.99.9999":U ) + ", ":U + STRING( TIME, "HH:MM":U ).
     3564     END.
     3565   END PROCEDURE.
     3566   FUNCTION Leap-Year RETURNS LOGICAL ( INPUT i-year AS INTEGER ) :
     3567     DEFINE VARIABLE bissextile AS LOGICAL NO-UNDO.
     3568     RUN get-leap-year-sign IN THIS-PROCEDURE ( INPUT i-year, OUTPUT bissextile ) NO-ERROR.
     3569     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE bissextile ).
     3570   END FUNCTION.
     3571   PROCEDURE get-leap-year-sign :
     3572     DEFINE  INPUT PARAMETER p-year AS INTEGER NO-UNDO.
     3573     DEFINE OUTPUT PARAMETER p-sign AS LOGICAL NO-UNDO.
     3574     DEFINE VARIABLE t_date AS DATE NO-UNDO.
     3575     DO ON ERROR UNDO, RETURN ERROR :
     3576       IF p-year = ? OR p-year = 0 THEN DO:
     3577         ASSIGN t_date = TODAY.
     3578         IF t_date <> TODAY THEN DO: ASSIGN t_date = TODAY. END.
     3579         ASSIGN p-year = YEAR( t_date ).
     3580       END.
     3581       ASSIGN p-sign = ( INTEGER( TRUNCATE( p-year * 0.25, 0 ) ) * 4 = p-year ).
     3582     END.
     3583   END PROCEDURE.
     3584   FUNCTION Leap-Year-d RETURNS LOGICAL ( INPUT i-date AS DATE ) :
     3585     DEFINE VARIABLE bissextile AS LOGICAL NO-UNDO.
     3586     RUN get-leap-year-sign-d IN THIS-PROCEDURE ( INPUT i-date, OUTPUT bissextile ) NO-ERROR.
     3587     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE bissextile ).
     3588   END FUNCTION.
     3589   PROCEDURE get-leap-year-sign-d :
     3590     DEFINE  INPUT PARAMETER p-date AS DATE    NO-UNDO.
     3591     DEFINE OUTPUT PARAMETER p-sign AS LOGICAL NO-UNDO.
     3592     DEFINE VARIABLE j-year AS INTEGER NO-UNDO.
     3593     DO ON ERROR UNDO, RETURN ERROR :
     3594       IF p-date = ? THEN DO:
     3595         ASSIGN p-date = TODAY.
     3596         IF p-date <> TODAY THEN DO: ASSIGN p-date = TODAY. END.
     3597       END.
     3598       ASSIGN j-year = YEAR( p-date ).
     3599       ASSIGN p-sign = ( INTEGER( TRUNCATE( j-year * 0.25, 0 ) ) * 4 = j-year ).
     3600     END.
     3601   END PROCEDURE.
     3602   function fnc-convert-dot-to-colon returns character
     3603       (input p-data as decimal, input p-accur as character, input p-num as integer) forward.
     3604   function fnc-convert-dot-to-colon returns character
     3605   (input p-data as decimal, input p-accur as character, input p-num as integer):
     3606       define variable result as character no-undo.
     3607       define variable v-str-result as character no-undo.
     3608       if p-data = ? then p-data = 0 .
     3609       p-data = round(p-data, p-num).
     3610       v-str-result = trim(replace(string(p-data, p-accur), ".", ",")).
     3611       return v-str-result.
     3612   END FUNCTION.
