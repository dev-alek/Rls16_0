     2190       assign
     2191               vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else (((buf_gds-dtl.price-base - buf_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale - varprice-base-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * buf_gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((buf_gds-dtl.price-base - buf_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - varprice-base-cons) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * buf_gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     2192               vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else (((buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * buf_gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - varprice-rubl-cons) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * buf_gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     2193        .
     2194     end.
     2195   end.
     2196   assign
     2197   price-base-without-tax-sale = price-base-with-tax-sale - vat-base-sale - slt-base-sale - road-tax-base-sale
     2198   price-rubl-without-tax-sale = price-rubl-with-tax-sale - vat-rubl-sale - slt-rubl-sale - road-tax-rubl-sale.
     2199               ASSIGN
     2200                   p-fact-qnty           = p-fact-qnty     + v-gds-dtl-fact-qnty
     2201                   p-sum-base            = p-sum-base      + price-base-with-tax-sale  * v-gds-dtl-fact-qnty
     2202                   p-sum-rubl            = p-sum-rubl      + price-rubl-with-tax-sale  * v-gds-dtl-fact-qnty
     2203                   p-vat-base            = p-vat-base      + vat-base-sale             * v-gds-dtl-fact-qnty
     2204                   p-vat-rubl            = p-vat-rubl      + vat-rubl-sale             * v-gds-dtl-fact-qnty
     2205                   p-slt-base            = p-slt-base      + slt-base-sale             * v-gds-dtl-fact-qnty
     2206                   p-slt-rubl            = p-slt-rubl      + slt-rubl-sale             * v-gds-dtl-fact-qnty
     2207                   p-road-tax-base       = p-road-tax-base + road-tax-base-sale        * v-gds-dtl-fact-qnty
     2208                   p-road-tax-rubl       = p-road-tax-rubl + road-tax-rubl-sale        * v-gds-dtl-fact-qnty
     2209                   p-excise-base         = p-excise-base   + excise-base-sale          * v-gds-dtl-fact-qnty
     2210                   p-excise-rubl         = p-excise-rubl   + excise-rubl-sale          * v-gds-dtl-fact-qnty
     2211                   p-other-base          = p-other-base    + discnt-base-sale          * v-gds-dtl-fact-qnty
     2212                   p-other-rubl          = p-other-rubl    + discnt-rubl-sale          * v-gds-dtl-fact-qnty
     2213               .
     2214           end.
     2215       end.
     2216       assign
     2217           p-transport-base      = 0
     2218           p-transport-rubl      = 0
     2219           p-vat-pc              = buf_doc-line.vat-pc
     2220           p-slt-pc              = buf_doc-line.slt-pc
     2221       .
     2222     end.
     2223     if p-fact-qnty      = ?
     2224     or p-vat-pc         = ?
     2225     or p-slt-pc         = ?
     2226     or p-sum-base       = ?
     2227     or p-sum-rubl       = ?
     2228     or p-vat-base       = ?
     2229     or p-vat-rubl       = ?
     2230     or p-slt-base       = ?
     2231     or p-slt-rubl       = ?
     2232     or p-road-tax-base  = ?
     2233     or p-road-tax-rubl  = ?
     2234     or p-transport-base = ?
     2235     or p-transport-rubl = ?
     2236     or p-other-base     = ?
     2237     or p-other-rubl     = ?
     2238     or p-excise-base    = ?
     2239     or p-excise-rubl    = ?
     2240     then do:
     2241       message
     2242         vss-workfile vss-revision vss-description skip
     2243         vss-include-info14 skip
     2244         "Получены неопределенные значения" skip
     2245         "Документ" p-doc-code skip
     2246         "Артикул" p-artic p-prod-type p-prod-code skip
     2247         "fact-qnty     " p-fact-qnty      skip
     2248         "vat-pc        " p-vat-pc         skip
     2249         "slt-pc        " p-slt-pc         skip
     2250         "sum-base      " p-sum-base       skip
     2251         "sum-rubl      " p-sum-rubl       skip
     2252         "vat-base      " p-vat-base       skip
     2253         "vat-rubl      " p-vat-rubl       skip
     2254         "slt-base      " p-slt-base       skip
     2255         "slt-rubl      " p-slt-rubl       skip
     2256         "road-tax-base " p-road-tax-base  skip
     2257         "road-tax-rubl " p-road-tax-rubl  skip
     2258         "transport-base" p-transport-base skip
     2259         "transport-rubl" p-transport-rubl skip
     2260         "other-base    " p-other-base     skip
     2261         "other-rubl    " p-other-rubl     skip
     2262         "excise-base   " p-excise-base    skip
     2263         "excise-rubl   " p-excise-rubl    skip
     2264         view-as alert-box error .
     2265       undo, return error .
     2266     end.
     2267   end procedure.
     2268   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2269   procedure factord :
     2270     define input  parameter p-fact-date            as date    no-undo .
     2271     define input  parameter p-fact-time            as integer no-undo .
     2272     define input  parameter p-fact-num             as integer no-undo .
     2273     define input  parameter p-shift-date           as date    no-undo .
     2274     define input  parameter p-shift-num            as integer no-undo .
     2275     define input  parameter p-shift-on             as logical no-undo .
     2276     define output parameter p-fact-order           as decimal no-undo .
     2277     define output parameter p-shift-end-fact-order as decimal no-undo .
     2278     define output parameter p-day-end-fact-order   as decimal no-undo .
     2279     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     2280     if p-fact-date = ?
     2281     then do:
     2282       return error "Не указана фактическая дата" .
     2283     end.
     2284     define variable v-fact-date-num as integer no-undo .
     2285     assign
     2286       v-fact-date-num = integer(p-fact-date)
     2287     .
     2288     if p-fact-num = ?
     2289     or p-fact-num = 0
     2290     then do:
     2291       return error "Не задан p-fact-num " + string(p-fact-num) .
     2292     end.
     2293     if p-fact-num < 0
     2294     then do:
     2295       return error "Отрицательный fact-num " + string(p-fact-num) .
     2296     end.
     2297     if p-fact-num >= 100000000
     2298     then do:
     2299       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     2300     end.
     2301     if p-shift-on = true
     2302     then do:
     2303       if p-shift-date = ?
     2304       then do:
     2305         return error "Не задана дата смены" .
     2306       end.
     2307       if p-shift-num = ?
     2308       or p-shift-num = 0
     2309       then do:
     2310         return error "Не задан номер смены" .
     2311       end.
     2312     end.
     2313     else do:
     2314       assign
     2315         p-shift-date = p-fact-date
     2316         p-shift-num  = 24
     2317       .
     2318     end.
     2319     define variable v-shift-offset as integer no-undo .
     2320     if p-shift-date = p-fact-date
     2321     then do:
     2322       assign
     2323         v-shift-offset = 1
     2324       .
     2325     end.
     2326     if p-shift-date < p-fact-date
     2327     then do:
     2328       assign
     2329         v-shift-offset = 0
     2330       .
     2331     end.
     2332     if p-shift-date > p-fact-date
     2333     then do:
     2334       message
     2335         vss-workfile vss-revision vss-description skip
     2336         "Неправильная дата закрытия смены" skip
     2337         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     2338         view-as alert-box error .
     2339       undo, return error
     2340         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     2341           ,string(p-fact-date, '99/99/9999':U)
     2342           ,string(p-shift-date, '99/99/9999':U)
     2343           )
     2344       .
     2345     end.
     2346     if p-shift-num < 1
     2347     or p-shift-num > 24
     2348     then do:
     2349       message
     2350         vss-workfile vss-revision vss-description skip
     2351         "Неправильный номер смены" skip
     2352         "p-shift-num" p-shift-num skip
     2353         view-as alert-box error .
     2354       undo, return error return-value .
     2355     end.
     2356     assign
     2357       p-fact-order           = v-fact-date-num
     2358                              + v-shift-offset * 0.5
     2359                              + p-shift-num    * 0.02 - 0.01
     2360                              + p-fact-num     * 0.0000000001
     2361       p-shift-end-fact-order = v-fact-date-num
     2362                              + v-shift-offset * 0.5
     2363                              + p-shift-num    * 0.02
     2364       p-day-end-fact-order   = v-fact-date-num
     2365                              + 0.99
     2366     .
     2367     if p-fact-order           <= v-fact-date-num
     2368     or p-shift-end-fact-order <= v-fact-date-num
     2369     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     2370     or p-shift-end-fact-order >= p-day-end-fact-order
     2371     then do:
     2372       message
     2373         vss-workfile vss-revision vss-description skip
     2374         "Внутренняя ошибка при генерации фактического номера" skip
     2375         "p-fact-date"            p-fact-date            skip
     2376         "p-fact-time"            p-fact-time            skip
     2377         "p-fact-num"             p-fact-num             skip
     2378         "p-shift-date"           p-shift-date           skip
     2379         "p-shift-num"            p-shift-num            skip
     2380         "p-shift-on"             p-shift-on             skip
     2381         "p-shift-end-fact-order" p-shift-end-fact-order skip
     2382         "p-day-end-fact-order"   p-day-end-fact-order   skip
     2383         "v-fact-date-num"        v-fact-date-num        skip
     2384         view-as alert-box error .
     2385       undo, return error return-value .
     2386     end.
     2387   end procedure.
     2388   procedure day-begin-fact-order :
     2389     define input  parameter p-fact-date            as date    no-undo .
     2390     define output parameter p-day-begin-fact-order as decimal no-undo .
     2391     do
     2392     on error undo, return error return-value
     2393     :
     2394       if p-fact-date = ?
     2395       then do:
     2396         assign
     2397           p-day-begin-fact-order = 0
     2398         .
     2399       end.
     2400       else do:
     2401         assign
     2402           p-day-begin-fact-order = integer(p-fact-date)
     2403         .
     2404       end.
     2405     end.
     2406   end procedure.
     2407   procedure factord-max-fact-order :
     2408     define output parameter p-max-fact-order as decimal   no-undo .
     2409     do
     2410     on error undo, return error return-value
     2411     :
     2412       run day-begin-fact-order in this-procedure
     2413         (input  date(1, 1, 5000)
     2414         ,output p-max-fact-order
     2415         ) .
     2416     end.
     2417   end procedure.
     2418   procedure factord-cut-archive :
     2419     define input  parameter p-obj-type             as character no-undo .
     2420     define input  parameter p-obj-code             as integer   no-undo .
     2421     define input  parameter p-fact-date            as date      no-undo .
     2422     define output parameter p-shift-on             as logical   no-undo .
     2423     define output parameter p-shift-date           as date      no-undo .
     2424     define output parameter p-shift-num            as integer   no-undo .
     2425     define output parameter p-day-end-fact-order   as decimal   no-undo .
     2426     define output parameter p-shift-end-fact-order as decimal   no-undo .
     2427     define variable v-fact-order as decimal   no-undo .
     2428     define buffer buf_shift-obj for ub.shift-obj .
     2429     do
     2430     on error undo, return error return-value
     2431     :
     2432   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2433   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     2434     (input  p-obj-type
     2435     ,input  p-obj-code
     2436     ,input  'shift-on=request'
     2437     ,output p-shift-on
     2438     ) no-error .
     2439       if error-status :error
     2440       then do:
     2441         message
     2442           vss-workfile vss-revision vss-description skip
     2443           "Ошибка при определении атрибута объекта" skip
     2444           "Объект" p-obj-type p-obj-code skip
     2445           error-status :get-message(1) skip
     2446           return-value skip
     2447           view-as alert-box error .
     2448         undo, return error return-value .
     2449       end.
     2450       if p-shift-on = false
     2451       then do:
     2452         assign
     2453           p-shift-date               = ?
     2454           p-shift-num                = 0
     2455         .
     2456       end.
     2457       else do:
     2458         find first buf_shift-obj share-lock
     2459           where buf_shift-obj.obj-type   = p-obj-type
     2460             and buf_shift-obj.obj-code   = p-obj-code
     2461             and buf_shift-obj.shift-date > p-fact-date
     2462           use-index pi
     2463           no-error .
     2464         if not available buf_shift-obj
     2465         or buf_shift-obj.status_ <> 'зкр':U
     2466         then do:
     2467           message
     2468             vss-workfile vss-revision vss-description skip
     2469             "Невозможно вычислить последнюю смену" skip
     2470             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     2471             "Объект" p-obj-type p-obj-code skip
     2472             "Дата" p-fact-date skip
     2473             view-as alert-box error .
     2474           undo, return error return-value .
     2475         end.
     2476         find last buf_shift-obj share-lock
     2477           where buf_shift-obj.obj-type = p-obj-type
     2478             and buf_shift-obj.obj-code = p-obj-code
     2479             and buf_shift-obj.shift-date <= p-fact-date
     2480           use-index pi
     2481           no-error .
     2482         if available buf_shift-obj
     2483         then do:
     2484           if  buf_shift-obj.status_ = 'зкр':U
     2485           then do:
     2486             assign
     2487               p-shift-date = buf_shift-obj.shift-date
     2488               p-shift-num  = buf_shift-obj.shift-num
     2489             .
     2490           end.
     2491           else do:
     2492             message
     2493               vss-workfile vss-revision vss-description skip
     2494               "Невозможно вычислить последнюю смену" skip
     2495               "Статус смены отличен от статуса" 'зкр':U skip
     2496               "Объект" p-obj-type p-obj-code skip
     2497               "Дата" p-fact-date skip
     2498               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     2499               view-as alert-box error .
     2500             undo, return error return-value .
     2501           end.
     2502         end.
     2503         else do:
     2504           assign
     2505             p-shift-date = p-fact-date - 1
     2506             p-shift-num  = 1
     2507           .
     2508         end.
     2509       end.
     2510       run factord in this-procedure
     2511         (input  p-fact-date
     2512         ,input  1
     2513         ,input  1
     2514         ,input  p-shift-date
     2515         ,input  p-shift-num
     2516         ,input  p-shift-on
     2517         ,output v-fact-order
     2518         ,output p-shift-end-fact-order
     2519         ,output p-day-end-fact-order
     2520         ) no-error .
     2521       if error-status :error
     2522       then do:
     2523         message
     2524           vss-workfile vss-revision vss-description skip
     2525           "Ошибка при вызове процедуры factord"
     2526           error-status :get-message(1) skip
     2527           return-value skip
     2528           view-as alert-box error .
     2529         undo, return error return-value .
     2530       end.
     2531     end.
     2532   end procedure.
     2533   procedure factord-lock-shift :
     2534     define input  parameter p-obj-type  as character no-undo .
     2535     define input  parameter p-obj-code  as integer   no-undo .
     2536     define input  parameter p-fact-date as date      no-undo .
     2537     define parameter buffer buf_shift-obj for ub.shift-obj .
     2538     define variable v-shift-on      as logical   no-undo .
     2539     define variable v-extra-message as character no-undo .
     2540     define variable v-error as character no-undo .
     2541     do
     2542     on error undo, return error return-value
     2543     :
     2544   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2545   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     2546     (input  p-obj-type
     2547     ,input  p-obj-code
     2548     ,input  'shift-on=request'
     2549     ,output v-shift-on
     2550     ) no-error .
     2551       if error-status :error
     2552       then do:
     2553         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     2554         undo, return error v-error .
     2555       end.
     2556       if v-shift-on = true
     2557       then do:
     2558         find first buf_shift-obj share-lock
     2559           where buf_shift-obj.obj-type   = p-obj-type
     2560             and buf_shift-obj.obj-code   = p-obj-code
     2561             and buf_shift-obj.shift-date > p-fact-date
     2562           use-index pi
     2563           no-error .
     2564         if not available buf_shift-obj
     2565         or buf_shift-obj.status_ <> 'зкр':U
     2566         then do:
     2567           find last buf_shift-obj
     2568             where buf_shift-obj.obj-type = p-obj-type
     2569               and buf_shift-obj.obj-code = p-obj-code
     2570               and buf_shift-obj.status_  = 'зкр':U
     2571             use-index stts
     2572             no-error .
     2573           if available buf_shift-obj
     2574           then do:
     2575             assign
     2576               v-extra-message =
     2577                     substitute("Дата начала последеней закрытой смены на объекте &1"
     2578                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     2579                               )
     2580             .
     2581           end.
     2582           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     2583           undo, return error v-error .
     2584         end.
     2585       end.
     2586     end.
     2587   end procedure.
     2588   procedure factord-end-day :
     2589     define input  parameter p-fact-date            as date    no-undo .
     2590     define output parameter p-day-end-fact-order   as decimal no-undo .
     2591     do
     2592     on error undo, return error return-value
     2593     :
     2594       if p-fact-date = ?
     2595       then do:
     2596         return error "Не указана фактическая дата" .
     2597       end.
     2598       assign
     2599         p-day-end-fact-order = integer(p-fact-date) + 0.99
     2600       .
     2601     end.
     2602   end procedure.
     2603   procedure factord-to-date :
     2604     define input  parameter p-fact-order as decimal no-undo .
     2605     define output parameter p-fact-date  as date    no-undo .
     2606     define variable v-ref-date  as date      no-undo .
     2607     define variable v-ref-delta as integer   no-undo .
     2608     do
     2609     on error undo, return error return-value
     2610     :
     2611       if p-fact-order = ?
     2612       or p-fact-order = 0
     2613       then do:
     2614         return error "Не указан fact-order" .
     2615       end.
     2616       assign
     2617         v-ref-date  = date(1, 1, 2000)
     2618       .
     2619       assign
     2620         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     2621       .
     2622       assign
     2623         p-fact-date = v-ref-date + v-ref-delta
     2624       .
     2625     end.
     2626   end procedure.
     2627   procedure factord-to-fact-num :
     2628     define input  parameter p-fact-order as decimal no-undo .
     2629     define output parameter p-fact-num   as integer no-undo .
     2630     define variable v-fact-order-trunc as decimal no-undo .
     2631     do
     2632     on error undo, return error return-value
     2633     :
     2634       if p-fact-order = ?
     2635       or p-fact-order = 0
     2636       then do:
     2637         return error "Не указан fact-order" .
     2638       end.
     2639       assign
     2640        v-fact-order-trunc = truncate(p-fact-order, 2)
     2641       .
     2642       assign
     2643         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     2644       .
     2645     end.
     2646   end procedure.
     2647   procedure factord-to-shift-num :
     2648     define input  parameter p-fact-order as decimal no-undo .
     2649     define output parameter p-shift-num   as integer no-undo .
     2650     define variable  p-shift-numd  as decimal   no-undo .
     2651     define variable v-fact-order-trunc as decimal no-undo .
     2652     do
     2653     on error undo, return error return-value
     2654     :
     2655       if p-fact-order = ?
     2656       or p-fact-order = 0
     2657       then do:
     2658         return error "Не указан fact-order" .
     2659       end.
     2660       assign
     2661        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     2662       .
     2663       if v-fact-order-trunc < 0.5 then do:
     2664         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     2665       end.
     2666       assign
     2667         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     2668         .
     2669        assign
     2670         p-shift-num = truncate (p-shift-numd , 0)
     2671       .
     2672     end.
     2673   end procedure.
     2674   define variable g#report-num as integer no-undo .
     2675   def var vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2676   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     2677   procedure paramls-clear :
     2678     define buffer buf_temp-param for temp-param .
     2679     do
     2680     on error undo, return error return-value
     2681     :
     2682       for each buf_temp-param
     2683       on error undo, return error
     2684       :
     2685         delete buf_temp-param .
     2686       end.
     2687     end.
     2688   end procedure.
     2689   procedure paramls-write :
     2690     define input  parameter p-code     as character no-undo .
     2691     define input  parameter p-sub-code as character no-undo .
     2692     define input  parameter p-value    as character no-undo .
     2693     define buffer buf_temp-param for temp-param .
     2694     do
     2695     on error undo, return error return-value
     2696     :
     2697       find first buf_temp-param
     2698         where buf_temp-param.param-code     = p-code
     2699           and buf_temp-param.param-sub-code = p-sub-code
     2700         no-error .
     2701       if not available buf_temp-param then do:
     2702         create buf_temp-param .
     2703         assign
     2704           buf_temp-param.param-code     = p-code
     2705           buf_temp-param.param-sub-code = p-sub-code
     2706         .
     2707       end.
     2708       assign
     2709         buf_temp-param.param-value = p-value
     2710       .
     2711     end.
     2712   end procedure.
     2713   procedure paramls-read :
     2714     define input  parameter p-code          as character no-undo .
     2715     define input  parameter p-sub-code      as character no-undo .
     2716     define input  parameter p-default-value as character no-undo .
     2717     define output parameter p-value         as character no-undo .
     2718     define buffer buf_temp-param for temp-param .
     2719     do
     2720     on error undo, return error return-value
     2721     :
     2722       find first buf_temp-param
     2723         where buf_temp-param.param-code     = p-code
     2724           and buf_temp-param.param-sub-code = p-sub-code
     2725         no-error .
     2726       if available buf_temp-param then do:
     2727         assign
     2728           p-value = buf_temp-param.param-value
     2729         .
     2730       end.
     2731       else do:
     2732         assign
     2733           p-value = p-default-value
     2734         .
     2735       end.
     2736     end.
     2737   end procedure.
     2738   procedure paramls-append :
     2739     define input  parameter p-code     as character no-undo .
     2740     define input  parameter p-sub-code as character no-undo .
     2741     define input  parameter p-value    as character no-undo .
     2742     define buffer buf_temp-param for temp-param .
     2743     do
     2744     on error undo, return error return-value
     2745     :
     2746       find first buf_temp-param
     2747            where buf_temp-param.param-code     = p-code
     2748              and buf_temp-param.param-sub-code = p-sub-code
     2749         no-error .
     2750       if not available buf_temp-param then do:
     2751         create buf_temp-param .
     2752         assign
     2753           buf_temp-param.param-code     = p-code
     2754           buf_temp-param.param-sub-code = p-sub-code
     2755           buf_temp-param.param-value    = p-value
     2756         .
     2757       end.
     2758       else do:
     2759           assign
     2760               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     2761           .
     2762       end.
     2763     end.
     2764   end procedure.
     2765   PROCEDURE ostatok :
     2766   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
     2767   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
     2768   def input parameter x-tog-shift   as   logical             no-undo.
     2769   def input parameter x-date-start  like ub.stk-tot.Fact-date   no-undo.
     2770   def input parameter x-date-end    like ub.stk-tot.Fact-date   no-undo.
     2771   def input parameter x-shift-start as integer               no-undo.
     2772   def input parameter x-shift-end   as integer               no-undo.
     2773   def input parameter x-sum-type    like ub.stk-tot.sum-type    no-undo.
     2774   def input parameter x-cat-id      like ub.stk-tot.cat-id      no-undo.
     2775   def input parameter xTog-obj   as log no-undo.
     2776   def output parameter Quantity    like ub.stk-tot.fact-qnty   no-undo.
     2777   def output parameter Coast_R     like ub.stk-tot.sum-rubl    no-undo.
     2778   def output parameter Coast_V     like ub.stk-tot.sum-rubl    no-undo.
     2779   def output parameter VAT_R       like ub.stk-tot.sum-rubl    no-undo.
     2780   def output parameter VAT_V       like ub.stk-tot.sum-rubl    no-undo.
     2781   def output parameter Fact-order  like ub.stk-tot.Fact-order  no-undo.
     2782   def var              Fact-order#   like ub.stk-tot.Fact-order  no-undo.
     2783   def var              Fact-orderS   as char  no-undo.
     2784   def var x-date-start-t  like ub.stk-tot.shift-date   no-undo.
     2785      Assign
     2786         Fact-order   = 0
     2787         Quantity     = 0
     2788         Coast_R      = 0
     2789         Coast_V      = 0
     2790         VAT_R        = 0
     2791         VAT_V        = 0 .
     2792    x-date-start-t  = x-date-start + 1 .
     2793   IF x-date-end = date('') then DO:
     2794      Fact-order = 0 .
     2795      for each obj-list
     2796          where  ( not xtog-obj or
     2797                 ( x-store-type = obj-list.obj-type and x-store-code = obj-list.obj-code ))
     2798                 no-lock :
     2799         if  x-tog-shift = false then do:
     2800                          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2801                               ub.stk-tot.Fact-date <=  x-date-start
     2802                               and ub.stk-tot.shift-num = 0
     2803                               USE-INDEX fact-date no-lock no-error .
     2804              if Available ub.stk-tot THEN  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2805         End.
     2806         Else  DO :
     2807             find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2808              (ub.stk-tot.shift-date  = x-date-start-t and
     2809               ub.stk-tot.shift-num  < x-shift-start or
     2810               ub.stk-tot.shift-date  < x-date-start-t  )
     2811               and ub.stk-tot.shift-num  > 0
     2812               USE-INDEX Shift-num no-lock no-error .
     2813            If Available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2814           END.
     2815       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     2816     End.
     2817   End.
     2818   Else DO:
     2819     For each obj-list  WHERE
     2820        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
     2821         no-lock :
     2822      IF  x-TOG-Shift = False Then DO:
     2823          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2824               ub.stk-tot.Fact-date <= x-date-end
     2825               and ub.stk-tot.shift-num = 0
     2826               USE-INDEX fact-date no-lock no-error.
     2827          if available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2828      END.
     2829      Else DO:
     2830           find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2831               (ub.stk-tot.shift-date  = x-date-end and
     2832               ub.stk-tot.shift-num  <= x-shift-end or
     2833               ub.stk-tot.shift-date  < x-date-end       ) and
     2834               ub.stk-tot.shift-num   > 0      use-index shift-num no-lock no-error.
     2835               if Available ub.stk-tot THEN Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2836       End.
     2837       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     2838     End.
     2839   End.
     2840   END PROCEDURE.
     2841   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2842   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2843   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2844   PROCEDURE fostatok :
     2845   define input parameter p-host-code   as integer no-undo .
     2846   define input parameter x-store-code  like ub.clients.obj-code    no-undo.
     2847   define input parameter x-store-type  like ub.clients.obj-type    no-undo.
     2848   define input parameter x-tog-shift   as   logical             no-undo.
     2849   define input parameter x-date-start  as date        no-undo.
     2850   define input parameter x-date-end    as date        no-undo.
     2851   define input parameter x-shift-start as integer     no-undo.
     2852   define input parameter x-shift-end   as integer     no-undo.
     2853   define input parameter xTog-obj   as logical no-undo.
     2854   define input parameter p-curr-code as integer no-undo .
     2855   define input parameter p-cashbookid as integer  no-undo .
     2856   define output parameter sum       as decimal   no-undo.
     2857   define output parameter Fact-order  as decimal  no-undo.
     2858   define variable Fact-order#   as decimal  no-undo.
     2859   define variable Fact-orderS   as character  no-undo.
     2860   define variable x-date-start-t  as date   no-undo.
     2861   define variable x-sum-type as character no-undo .
     2862       if x-tog-shift then do:
     2863         assign
     2864         x-sum-type = 'shift-obj':U.
     2865       end.
     2866       else do:
     2867         x-sum-type = 'obj':U.
     2868       end.
     2869   Assign
     2870   Fact-order   = 0
     2871   sum     = 0
     2872   x-date-start-t  = x-date-start + 1 .
     2873   IF x-date-end = date('') then DO:
     2874     Fact-order = 0 .
     2875     For each obj-list no-lock
     2876         WHERE  (NOT xTog-obj OR
     2877                 (x-store-type = obj-list.obj-type
     2878                 AND
     2879                 x-store-code = obj-list.obj-code))
     2880     :
     2881      fact-order# = 0.
     2882      IF  x-TOG-Shift = False Then DO:
     2883         find last arh-fin-doc-schet-nal-obj no-lock where     arh-fin-doc-schet-nal-obj.obj-type = obj-list.obj-type and arh-fin-doc-schet-nal-obj.obj-code = obj-list.obj-code and arh-fin-doc-schet-nal-obj.cli-code          = p-host-code and arh-fin-doc-schet-nal-obj.cli-type          = 'орг':U and arh-fin-doc-schet-nal-obj.calc-curr-code    = p-curr-code and arh-fin-doc-schet-nal-obj.cashbookid    = p-cashbookid and arh-fin-doc-schet-nal-obj.curr-code    = p-curr-code and arh-fin-doc-schet-nal-obj.sum-type = x-sum-type and
     2884             arh-fin-doc-schet-nal-obj.Fact-date <=  x-date-start
     2885             USE-INDEX fact-date  no-error .
     2886        if Available arh-fin-doc-schet-nal-obj THEN  do:
     2887          Assign                          sum     = arh-fin-doc-schet-nal-obj.income - arh-fin-doc-schet-nal-obj.expense                          Fact-order#  = arh-fin-doc-schet-nal-obj.Fact-order.
     2888        end.
     2889      End.
     2890      Else  DO :
     2891         find last arh-fin-doc-schet-nal-obj no-lock where     arh-fin-doc-schet-nal-obj.obj-type = obj-list.obj-type and arh-fin-doc-schet-nal-obj.obj-code = obj-list.obj-code and arh-fin-doc-schet-nal-obj.cli-code          = p-host-code and arh-fin-doc-schet-nal-obj.cli-type          = 'орг':U and arh-fin-doc-schet-nal-obj.calc-curr-code    = p-curr-code and arh-fin-doc-schet-nal-obj.cashbookid    = p-cashbookid and arh-fin-doc-schet-nal-obj.curr-code    = p-curr-code and arh-fin-doc-schet-nal-obj.sum-type = x-sum-type and
     2892              (arh-fin-doc-schet-nal-obj.shift-date  = x-date-start-t and
     2893               arh-fin-doc-schet-nal-obj.shift-num  < x-shift-start or
     2894               arh-fin-doc-schet-nal-obj.shift-date  < x-date-start-t  )
     2895               and arh-fin-doc-schet-nal-obj.shift-num  > 0
     2896               USE-INDEX Shift-num no-error .
     2897         if Available arh-fin-doc-schet-nal-obj THEN  do:
     2898           Assign                          sum     = arh-fin-doc-schet-nal-obj.income - arh-fin-doc-schet-nal-obj.expense                          Fact-order#  = arh-fin-doc-schet-nal-obj.Fact-order.
     2899         end.
     2900       END.
     2901       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     2902     End.
     2903   End.
     2904   Else DO:
     2905     For each obj-list  no-lock WHERE
     2906        (NOT xTog-obj
     2907         OR
     2908         (x-store-type = obj-list.obj-type
     2909         AND
     2910         x-store-code = obj-list.obj-code))
     2911      :
     2912      IF  x-TOG-Shift = False Then DO:
     2913         find last arh-fin-doc-schet-nal-obj no-lock where     arh-fin-doc-schet-nal-obj.obj-type = obj-list.obj-type and arh-fin-doc-schet-nal-obj.obj-code = obj-list.obj-code and arh-fin-doc-schet-nal-obj.cli-code          = p-host-code and arh-fin-doc-schet-nal-obj.cli-type          = 'орг':U and arh-fin-doc-schet-nal-obj.calc-curr-code    = p-curr-code and arh-fin-doc-schet-nal-obj.cashbookid    = p-cashbookid and arh-fin-doc-schet-nal-obj.curr-code    = p-curr-code and arh-fin-doc-schet-nal-obj.sum-type = x-sum-type and
     2914               arh-fin-doc-schet-nal-obj.Fact-date <= x-date-end
     2915               and arh-fin-doc-schet-nal-obj.shift-num = 0
     2916               USE-INDEX fact-date no-error.
     2917        if Available arh-fin-doc-schet-nal-obj THEN  do:
     2918          Assign                          sum     = arh-fin-doc-schet-nal-obj.income - arh-fin-doc-schet-nal-obj.expense                          Fact-order#  = arh-fin-doc-schet-nal-obj.Fact-order.
     2919        end.
     2920      END.
     2921      Else DO:
     2922         find last arh-fin-doc-schet-nal-obj no-lock where     arh-fin-doc-schet-nal-obj.obj-type = obj-list.obj-type and arh-fin-doc-schet-nal-obj.obj-code = obj-list.obj-code and arh-fin-doc-schet-nal-obj.cli-code          = p-host-code and arh-fin-doc-schet-nal-obj.cli-type          = 'орг':U and arh-fin-doc-schet-nal-obj.calc-curr-code    = p-curr-code and arh-fin-doc-schet-nal-obj.cashbookid    = p-cashbookid and arh-fin-doc-schet-nal-obj.curr-code    = p-curr-code and arh-fin-doc-schet-nal-obj.sum-type = x-sum-type and
     2923               (arh-fin-doc-schet-nal-obj.shift-date  = x-date-end and
     2924               arh-fin-doc-schet-nal-obj.shift-num  <= x-shift-end or
     2925               arh-fin-doc-schet-nal-obj.shift-date  < x-date-end       ) and
     2926               arh-fin-doc-schet-nal-obj.shift-num   > 0      use-index shift-num no-error.
     2927         if Available arh-fin-doc-schet-nal-obj THEN  do:
     2928           Assign                          sum     = arh-fin-doc-schet-nal-obj.income - arh-fin-doc-schet-nal-obj.expense                          Fact-order#  = arh-fin-doc-schet-nal-obj.Fact-order.
     2929         end.
     2930       End.
     2931       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     2932     End.
     2933   End.
     2934   END PROCEDURE.
     2935   procedure ost-line :
     2936     define input  parameter x-store-code like ub.clients.obj-code    no-undo .
     2937     define input  parameter x-store-type like ub.clients.obj-type    no-undo .
     2938     define input  parameter x-artic      like ub.stk-line.artic      no-undo .
     2939     define input  parameter x-prod-code  like ub.stk-line.prod-code  no-undo .
     2940     define input  parameter x-prod-type  like ub.stk-line.prod-type  no-undo .
     2941     define input  parameter x-tog-shift  as logical no-undo .
     2942     define input  parameter x-fact-order like ub.stk-line.fact-order no-undo .
     2943     define input  parameter x-sum-type   like ub.stk-line.sum-type   no-undo .
     2944     define input  parameter x-cat-id     like ub.stk-line.cat-id     no-undo .
     2945     define input  parameter xtog-obj     as logical no-undo .
     2946     define output parameter quantity     like ub.stk-line.fact-qnty  no-undo .
     2947     define output parameter coast_r      like ub.stk-line.sum-rubl   no-undo .
     2948     define output parameter coast_v      like ub.stk-line.sum-rubl   no-undo .
     2949     define output parameter vat_r        like ub.stk-line.sum-rubl   no-undo .
     2950     define output parameter vat_v        like ub.stk-line.sum-rubl   no-undo .
     2951     define output parameter slt_r        like ub.stk-line.sum-rubl   no-undo .
     2952     define output parameter slt_v        like ub.stk-line.sum-rubl   no-undo .
     2953     define buffer buff-obj-list  for obj-list .
     2954     define buffer buff-stk-line  for ub.stk-line .
     2955     assign
     2956       Quantity = 0
     2957       Coast_R  = 0
     2958       Coast_V  = 0
     2959       VAT_R    = 0
     2960       VAT_V    = 0
     2961       SLT_R    = 0
     2962       SLT_V    = 0
     2963     .
     2964     if  x-tog-shift = false then do:
     2965       for each buff-obj-list no-lock
     2966         where xtog-obj = false
     2967            or (buff-obj-list.obj-type = x-store-type
     2968               and buff-obj-list.obj-code = x-store-code
     2969               )
     2970       on error undo, return error
     2971       :
     2972         find last buff-stk-line no-lock
     2973           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     2974             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     2975             and buff-stk-line.artic      = x-artic
     2976             and buff-stk-line.prod-type  = x-prod-type
     2977             and buff-stk-line.prod-code  = x-prod-code
     2978             and buff-stk-line.sum-type   = x-sum-type
     2979             and buff-stk-line.cat-id     = '##,##':U
     2980             and buff-stk-line.fact-order <= x-fact-order
     2981             and buff-stk-line.shift-num  = 0
     2982           use-index category
     2983           no-error .
     2984         if available buff-stk-line then do:
     2985           assign
     2986             Quantity = Quantity +  buff-stk-line.fact-qnty
     2987             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     2988             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     2989             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     2990             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     2991             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     2992             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     2993           .
     2994         end.
     2995       end.
     2996     end.
     2997     else do:
     2998       for each buff-obj-list no-lock
     2999         where xtog-obj = false
     3000            or (buff-obj-list.obj-type = x-store-type
     3001               and buff-obj-list.obj-code = x-store-code
     3002               )
     3003       on error undo, return error
     3004       :
     3005         find last buff-stk-line no-lock
     3006           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     3007             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     3008             and buff-stk-line.artic      = x-artic
     3009             and buff-stk-line.prod-type  = x-prod-type
     3010             and buff-stk-line.prod-code  = x-prod-code
     3011             and buff-stk-line.sum-type   = x-sum-type
     3012             and buff-stk-line.cat-id     = '##,##':U
     3013             and buff-stk-line.fact-order <= x-fact-order
     3014             and buff-stk-line.shift-num  > 0
     3015           use-index category
     3016           no-error .
     3017         if available buff-stk-line then do:
     3018           assign
     3019             Quantity = Quantity +  buff-stk-line.fact-qnty
     3020             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     3021             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     3022             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     3023             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     3024             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     3025             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     3026           .
     3027         end.
     3028       end.
     3029     end.
     3030   end procedure.
     3031   procedure ost-lineother-tax :
     3032     define input  parameter x-store-code like ub.clients.obj-code      no-undo.
     3033     define input  parameter x-store-type like ub.clients.obj-type      no-undo.
     3034     define input  parameter x-artic      like ub.stk-line.artic        no-undo.
     3035     define input  parameter x-prod-code  like ub.stk-line.prod-code    no-undo.
     3036     define input  parameter x-prod-type  like ub.stk-line.prod-type    no-undo.
     3037     define input  parameter x-tog-shift  as logical no-undo .
     3038     define input  parameter x-fact-order like ub.stk-line.fact-order   no-undo.
     3039     define input  parameter x-sum-type   like ub.stk-line.sum-type     no-undo.
     3040     define input  parameter x-type-id    like ub.stk-line.cat-id       no-undo.
     3041     define input  parameter xTog-obj     as logical no-undo .
     3042     define output parameter Quantity     like ub.stk-line.fact-qnty   no-undo.
     3043     define output parameter Coast_R      like ub.stk-line.sum-rubl    no-undo.
     3044     define output parameter Coast_V      like ub.stk-line.sum-rubl    no-undo.
     3045     define output parameter VAT_R        like ub.stk-line.sum-rubl    no-undo.
     3046     define output parameter VAT_V        like ub.stk-line.sum-rubl    no-undo.
     3047     define output parameter SLT_R        like ub.stk-line.sum-rubl    no-undo.
     3048     define output parameter SLT_V        like ub.stk-line.sum-rubl    no-undo.
     3049     define output parameter other_R      like ub.stk-line.sum-rubl    no-undo.
     3050     define output parameter other_V      like ub.stk-line.sum-rubl    no-undo.
     3051     define buffer buff-obj-list  for obj-list .
     3052     define buffer buff-stk-line  for ub.stk-line .
     3053     assign
     3054       Quantity = 0
     3055       Coast_R  = 0
     3056       Coast_V  = 0
     3057       VAT_R    = 0
     3058       VAT_V    = 0
     3059       SLT_R    = 0
     3060       SLT_V    = 0
     3061       other_R  = 0
     3062       other_V  = 0
     3063     .
     3064     if  x-tog-shift = false then do:
     3065       for each buff-obj-list no-lock
     3066         where xtog-obj = false
     3067            or (buff-obj-list.obj-type = x-store-type
     3068               and buff-obj-list.obj-code = x-store-code
     3069               )
     3070       on error undo, return error
     3071       :
     3072         find last buff-stk-line no-lock
     3073           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     3074             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     3075             and buff-stk-line.artic      = x-artic
     3076             and buff-stk-line.prod-type  = x-prod-type
     3077             and buff-stk-line.prod-code  = x-prod-code
     3078             and buff-stk-line.sum-type   = x-sum-type
     3079             and buff-stk-line.cat-id     = '##,##':U
     3080             and buff-stk-line.fact-order <= x-fact-order
     3081             and buff-stk-line.shift-num  = 0
     3082           use-index category
     3083           no-error .
     3084         if available buff-stk-line then do:
     3085           assign
     3086             Quantity = Quantity +  buff-stk-line.fact-qnty
     3087             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     3088             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     3089             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     3090             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     3091             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     3092             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     3093             other_R  = other_R  +  buff-stk-line.other-rubl
     3094             other_V  = other_V  +  buff-stk-line.other-base
     3095           .
     3096         end.
     3097       end.
     3098     end.
     3099     else do:
     3100       for each buff-obj-list no-lock
     3101         where xtog-obj = false
     3102            or (buff-obj-list.obj-type = x-store-type
     3103               and buff-obj-list.obj-code = x-store-code
     3104               )
     3105       on error undo, return error
     3106       :
     3107         find last buff-stk-line no-lock
     3108           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     3109             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     3110             and buff-stk-line.artic      = x-artic
     3111             and buff-stk-line.prod-type  = x-prod-type
     3112             and buff-stk-line.prod-code  = x-prod-code
     3113             and buff-stk-line.sum-type   = x-sum-type
     3114             and buff-stk-line.cat-id     = '##,##':U
     3115             and buff-stk-line.fact-order <= x-fact-order
     3116             and buff-stk-line.shift-num  > 0
     3117           use-index category
     3118           no-error .
     3119         if available buff-stk-line then do:
     3120           assign
     3121             Quantity = Quantity +  buff-stk-line.fact-qnty
     3122             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     3123             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     3124             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     3125             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     3126             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     3127             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     3128             other_R = other_R   +  buff-stk-line.other-rubl
     3129             other_V = other_V   +  buff-stk-line.other-base
     3130           .
     3131         end.
     3132       end.
     3133     end.
     3134   end procedure.
     3135   procedure ost-line-kg :
     3136     define  input parameter p-obj-code    like ub.stk-line.obj-code   no-undo .
     3137     define  input parameter p-obj-type    like ub.stk-line.obj-type   no-undo .
     3138     define  input parameter p-artic       like ub.stk-line.artic      no-undo .
     3139     define  input parameter p-prod-code   like ub.stk-line.prod-code  no-undo .
     3140     define  input parameter p-prod-type   like ub.stk-line.prod-type  no-undo .
     3141     define  input parameter p-fact-order  like ub.stk-line.fact-order no-undo .
     3142     define output parameter p-quantity-kg like ub.stk-line.fact-qnty  no-undo initial 0.00 .
     3143     define buffer buff-obj-list  for obj-list .
     3144     define buffer buf_doc-line for ub.doc-line .
     3145     define buffer buf_inv-line for ub.inv-line .
     3146     do
     3147     on error undo, return error
     3148     :
     3149       for each buf_doc-line no-lock where
     3150                buf_doc-line.obj-type    = p-obj-type   and
     3151                buf_doc-line.obj-code    = p-obj-code   and
     3152                buf_doc-line.prod-type   = p-prod-type  and
     3153                buf_doc-line.prod-code   = p-prod-code  and
     3154                buf_doc-line.artic       = p-artic      and
     3155                buf_doc-line.status_     = 'факт':U      and
     3156                buf_doc-line.fact-order <= p-fact-order
     3157             by buf_doc-line.fact-order    descending
     3158       :
     3159         find first buf_inv-line no-lock where
     3160                    buf_inv-line.doc-code  = buf_doc-line.doc-code  and
     3161                    buf_inv-line.artic     = buf_doc-line.artic     and
     3162                    buf_inv-line.prod-type = buf_doc-line.prod-type and
     3163                    buf_inv-line.prod-code = buf_doc-line.prod-code no-error .
     3164         if available buf_inv-line
     3165         then do:
     3166           if buf_inv-line.after-cli-qnty <> ?
     3167           then do:
     3168             assign
     3169               p-quantity-kg = buf_inv-line.after-cli-qnty
     3170             .
     3171             leave .
     3172           end.
     3173         end.
     3174       end.
     3175       if p-quantity-kg = ?
     3176       then do:
     3177         assign
     3178           p-quantity-kg = 0
     3179         .
     3180       end.
     3181     end.
     3182   end procedure.
