     4017       if ub.shift-obj.shift-date = x-date-End and ub.shift-obj.shift-num > x-Shift-End then leave .
     4018       if can-find (first ub.fin-doc no-lock where ub.fin-doc.obj-code = v-obj-code and ub.fin-doc.obj-type = v-obj-type and ub.fin-doc.cashbookid = buf_cashbook.id
     4019         and ub.fin-doc.shift-date = ub.shift-obj.shift-date and ub.fin-doc.shift-name = ub.shift-obj.shift-name and ub.fin-doc.shift-num = ub.shift-obj.shift-num) then
     4020       do:
     4021         v-num-page = v-num-page + 1 .
     4022       end.
     4023     end.
     4024     end.
     4025        v-num-page = v-num-page - 1.
     4026     end.
     4027     else do:
