     1920         where buf_doc-line.doc-code  = p-doc-code
     1921           and buf_doc-line.artic     = p-artic
     1922           and buf_doc-line.prod-type = p-prod-type
     1923           and buf_doc-line.prod-code = p-prod-code
     1924         no-error .
     1925       if not available buf_doc-line then do:
