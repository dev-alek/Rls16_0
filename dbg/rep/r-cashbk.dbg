     4029       if can-find (first ub.fin-doc no-lock where ub.fin-doc.obj-code = v-obj-code and ub.fin-doc.obj-type = v-obj-type and ub.fin-doc.cashbookid = buf_cashbook.id
     4030         and ub.fin-doc.fact-date = v-date-page) then
