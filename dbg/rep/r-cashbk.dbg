       19   define variable vss-revision    as character no-undo init "$Revision: 95acbc8cdeb8, 3449, rls $":U .
       20   define variable vss-author      as character no-undo init "$Author: EShklyar $":U .
       21   define variable vss-date        as character no-undo init "$Date: 2023/10/16 15:13:33 $":U .
       22   define variable vss-workfile    as character no-undo init "$Workfile: r-cashbk.p $":U .
