      619   function excel-format-dec-to-char returns char (input p-dec as decimal ).
      620     if num-entries(string(p-dec), '.') = 2
      621       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
      622       else return( string(p-dec)) .
      623   end function.
      624   function format-point-to-comma returns char (input orig as char ) .
      625   define variable rtext as character no-undo .
      626   define variable strt as integer no-undo .
      627   define variable leng as integer no-undo .
      628   assign rtext = orig .
      629   repeat:
      630     strt =  index(rtext,'.').
      631     if strt = 0 then leave.
      632     leng = 1.
      633     substring(rtext,strt,leng,"character") = v-delim .
      634   end.
      635   return rtext.
      636   end function.
      637   function format-excel-text returns char ( input start-text as char ) :
      638   def var  i    as int no-undo.
      639   def var  ch   as char no-undo.
      640   def var  n    as int no-undo.
      641   def var  ipos as int no-undo.
      642     n = num-entries(trim(start-text), chr(10)) - 1 .
      643     do i = 1 to n :
      644       ipos = index( start-text, chr(10)).
      645       if ipos > 0 then
      646         substr( start-text, ipos, 1 ) = ' '.
      647     end.
      648     n = num-entries(trim(start-text), chr(13)) - 1 .
      649     do i = 1 to n :
      650       ipos = index( start-text, chr(13)).
      651       if ipos > 0 then
      652         substr( start-text, ipos, 1 ) = ' '.
      653     end.
      654     if index( start-text, '"' ) = 0 then
      655       start-text =  '="'   + trim( start-text) + '"'   .
      656       else do:
      657         n = num-entries(trim(start-text), '"') - 1.
      658         do i = 1 to n :
      659           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      660         end.
      661         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      662         start-text = '="'  + ch  + '"' .
      663       end.
      664     return start-text.
      665   end.
      666   function excel-sum returns char (input p-dec as decimal ).
      667     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
      668   end function.
      669   function excel-qnty returns char (input p-dec as decimal ).
      670     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
      671   end function.
      672   function format-excel-text-macr returns char ( input start-text as char ) :
      673   def var  i    as int no-undo.
      674   def var  ch   as char no-undo.
      675   def var  n    as int no-undo.
      676   def var  ipos as int no-undo.
      677     n = num-entries(trim(start-text), chr(10)) - 1 .
      678     do i = 1 to n :
      679       ipos = index( start-text, chr(10)).
      680       if ipos > 0 then
      681         substring( start-text, ipos , 1 ) = ' '.
      682     end.
      683     n = num-entries(trim(start-text), chr(13)) - 1 .
      684     do i = 1 to n :
      685       ipos = index( start-text, chr(13)).
      686       if ipos > 0 then
      687         substring( start-text, ipos, 1 ) = ' '.
      688     end.
      689     if index( start-text, '"' ) = 0 then
      690       start-text =  '"'   + trim( start-text) + '"'   .
      691       else do:
      692         n = num-entries(trim(start-text), '"') - 1.
      693         do i = 1 to n :
      694           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      695         end.
      696         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      697         start-text = '"'  + ch  + '"' .
      698       end.
      699     n = num-entries(trim(start-text), chr(10)) - 1 .
      700     do i = 1 to n :
      701       ipos = index( start-text, chr(10)).
      702       if ipos > 0 then
      703         substring( start-text, ipos , 1 ) = ' '.
      704     end.
      705       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
      706     return start-text.
      707   end.
      708   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      709   procedure cur-time :
      710      define output parameter p-today as date      no-undo .
      711      define output parameter p-time  as integer   no-undo .
      712     do
      713     on error undo, return error
      714     :
      715       define variable v-date1 as date      no-undo .
      716       define variable v-date2 as date      no-undo .
      717       define variable v-time  as integer   no-undo .
      718       assign
      719         v-date1 = today
      720         v-time  = time
      721         v-date2 = today
      722       .
      723       if v-date1 <> v-date2
      724       then do:
      725         assign
      726           v-date1 = today
      727           v-time  = v-time
      728         .
      729       end.
      730       assign
      731         p-today = v-date1
      732         p-time  = v-time
      733       .
      734     end.
      735   end.
      736   function cur-time-date returns character
      737   :
      738     return string(today, '99/99/9999':U) .
      739   end.
      740   function cur-time-mjd returns decimal
      741   :
      742     define variable v-date as date      no-undo .
      743     define variable v-time as integer   no-undo .
      744     run cur-time in this-procedure
      745       (output v-date
      746       ,output v-time
      747       ) .
      748     return integer(v-date) - 2400002 + (v-time / 86400) .
      749   end.
      750   function cur-time-get-ending-index returns integer
      751   (input p-number as integer
      752   )
      753   :
      754     if p-number < 0
      755     or p-number = ?
      756     then do:
      757       return 1 .
      758     end.
      759     define variable v-rest as integer   no-undo .
      760     assign
      761       p-number = p-number modulo 100
      762     .
      763     if p-number < 20
      764     then do:
      765       assign
      766         v-rest = p-number
      767       .
      768     end.
      769     else do:
      770       assign
      771         v-rest = p-number modulo 10
      772       .
      773     end.
      774     case v-rest :
      775       when 1
      776       then do:
      777         return 2 .
      778       end.
      779       when 2 or
      780       when 3 or
      781       when 4
      782       then do:
      783         return 3 .
      784       end.
      785       otherwise do:
      786         return 1 .
      787       end.
      788     end case .
      789   end.
      790   procedure cur-time-mjd-to-date :
      791      define input  parameter i-mjd-diff as decimal no-undo.
      792      define output parameter o-Date     as date    no-undo.
      793      define output parameter o-Time     as integer no-undo.
      794      define variable v-day-number as integer   no-undo .
      795      if    i-mjd-diff < 0
      796         or i-mjd-diff = ?
      797      then do:
      798         return "?" .
      799      end.
      800      assign
      801         v-day-number = truncate(i-mjd-diff,0).
      802         o-Date = date(v-day-number + 2400002).
      803         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      804     .
      805   end.
      806   function cur-time-mjd-to-string returns character
      807   (input p-mjd-diff as decimal
      808   )
      809   :
      810     define variable v-day-number as integer   no-undo .
      811     define variable v-seconds    as integer   no-undo .
      812     define variable v-hour       as integer   no-undo .
      813     define variable v-min        as integer   no-undo .
      814     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      815     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      816     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      817     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      818     if p-mjd-diff < 0
      819     or p-mjd-diff = ?
      820     then do:
      821       return "?" .
      822     end.
      823     assign
      824       v-day-number = integer(truncate(p-mjd-diff,0))
      825       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      826     .
      827     if v-seconds > 86400
      828     then do:
      829       assign
      830         v-seconds = 86400 - 1
      831       .
      832     end.
      833     if v-seconds < 0
      834     then do:
      835       assign
      836         v-seconds = 0
      837       .
      838     end.
      839     assign
      840       v-hour = truncate(v-seconds / 3600, 0)
      841     .
      842     assign
      843       v-seconds = v-seconds modulo 3600
      844     .
      845     assign
      846       v-min = truncate(v-seconds / 60, 0)
      847     .
      848     assign
      849       v-seconds = v-seconds modulo 60
      850     .
      851     return
      852         (if v-day-number <> 0
      853           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      854           else ""
      855         )
      856       + (if v-day-number <> 0 or v-hour <> 0
      857           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      858           else ""
      859         )
      860       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      861           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      862           else ""
      863         )
      864       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      865       .
      866   end.
      867   function cur-time-string returns character
      868   :
      869     define variable v-date as date      no-undo .
      870     define variable v-time as integer   no-undo .
      871     run cur-time in this-procedure
      872       (output v-date
      873       ,output v-time
      874       ) .
      875     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      876   end.
      877   function cur-time-string-sec returns character
      878   :
      879     define variable v-date as date      no-undo .
      880     define variable v-time as integer   no-undo .
      881     run cur-time in this-procedure
      882       (output v-date
      883       ,output v-time
      884       ) .
      885     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      886   end.
      887   function cur-time-custom  returns character
      888   (input p-prefix as character
      889   ,input p-date-format as character
      890   ,input p-delimiter as character
      891   ,input p-time-format as character
      892   ,input p-suffix as character
      893   )
      894   :
      895     define variable v-date as date      no-undo .
      896     define variable v-time as integer   no-undo .
      897     run cur-time in this-procedure
      898       (output v-date
      899       ,output v-time
      900       ) .
      901     return
      902       p-prefix
      903       + string(v-date, p-date-format)
      904       + p-delimiter
      905       + string(v-time, p-time-format)
      906       + p-suffix
      907       .
      908   end.
      909   function cur-time-print  returns character
      910   :
      911     define variable v-date as date      no-undo .
      912     define variable v-time as integer   no-undo .
      913     run cur-time in this-procedure
      914       (output v-date
      915       ,output v-time
      916       ) .
      917     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      918   end.
      919   function cur-time-datetime returns datetime
      920   :
      921     define variable v-char as character no-undo .
      922     define variable v-datetime as datetime no-undo .
      923     v-char = cur-time-string().
      924     v-datetime = datetime(v-char).
      925     return  v-datetime.
      926   end.
      927   function cur-time-string-msec returns character
      928   :
      929     define variable v-date as datetime  no-undo .
      930     v-date = now.
      931     return string(v-date) .
      932   end.
      933   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      934   define  stream PrnLibStream.
      935   procedure prn-lib-prn-file :
      936     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      937     define input parameter p-DIsabledoptions as integer no-undo .
      938     define variable v-report-name as character no-undo .
      939     define variable v-user-action as character no-undo .
      940     define variable v-printed     as logical   no-undo .
      941     define variable v-exist       as logical   no-undo .
      942     do
      943       on error undo, return error
      944       :
      945       run prn-lib-get-report-name  in this-procedure (
      946         input parParentProc
      947         ,output v-report-name
      948         ).
      949   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      950   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      951     (input  v-report-name
      952     ,input  2
      953     ,output v-exist
      954     )  .
      955       if NOT v-exist then
      956       DO:
      957         Message
      958           "Нет заданий на печать ! "
      959           view-as alert-box .
      960         Return  .
      961       End.
      962       run gbl/prnfilen.w
      963         (input  ""
      964         ,input  p-DisabledOptions
      965         ,input  string(v-report-name )
      966         ,input  7
      967         ,output v-user-action
      968         ,output v-printed
      969         ) .
      970       if v-printed then
      971       do:
      972         return "YES" .
      973       end.
      974       else
      975       do:
      976         return "NO" .
      977       end.
      978     end.
      979   end procedure.
      980   procedure prn-lib-open-stream :
      981     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      982     define input parameter p-page-size    as integer no-undo .
      983     define input parameter p-is-stream    as logical no-undo .
      984     define input parameter p-append       as logical no-undo .
      985     define variable v-report-name as character no-undo .
      986     do
      987       on error undo, return error
      988       :
      989       run prn-lib-get-report-name  in this-procedure (
      990         input parParentProc
      991         ,output v-report-name
      992         ).
      993       if p-is-stream then
      994       do:
      995         if p-append then
      996         do:
      997           output stream PrnLibStream to value( v-report-name )
      998             page-size value(p-page-size) append .
      999         end.
     1000         if not p-append then
     1001         do:
     1002           output stream PrnLibStream to value( v-report-name )
     1003             page-size value(p-page-size) .
     1004         end.
     1005       end.
     1006       if not p-is-stream then
     1007       do:
     1008         if p-append then
     1009         do:
     1010           output to value( v-report-name )
     1011             page-size value(p-page-size) append .
     1012         end.
     1013         if not p-append then
     1014         do:
     1015           output to value( v-report-name )
     1016             page-size value(p-page-size) .
     1017         end.
     1018       end.
     1019     end.
     1020   end procedure.
     1021   procedure prn-lib-open-exp :
     1022     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1023     define input parameter p-is-stream    as logical no-undo .
     1024     define input parameter p-is-append    as logical no-undo .
     1025     define output parameter p-ReportFileName as char init "report" no-undo.
     1026     define output parameter p-process as logical no-undo .
     1027     define variable glog as logical no-undo .
     1028     do
     1029       on error undo, return error
     1030       :
     1031       SYSTEM-DIALOG GET-FILE p-ReportFileName
     1032         TITLE      "Укажите путь"
     1033         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     1034         ASK-OVERWRITE
     1035         CREATE-TEST-FILE
     1036         SAVE-AS
     1037         USE-FILENAME
     1038         DEFAULT-EXTENSION "txt"
     1039         UPDATE glog
     1040         .
     1041       if not glog then  return.
     1042       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     1043       if p-is-stream then
     1044       do:
     1045         if p-is-append then
     1046         do:
     1047           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1048         end.
     1049         else
     1050         do:
     1051           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1052         end.
     1053       end.
     1054       else
     1055       do:
     1056         if p-is-append then
     1057         do:
     1058           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1059         end.
     1060         else
     1061         do:
     1062           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1063         end.
     1064       end.
     1065       p-process = yes.
     1066     end.
     1067   end procedure.
     1068   procedure prn-lib-get-report-name :
     1069     define input parameter parParentProc  as widget-handle no-undo.
     1070     define output parameter p-report-name as character no-undo .
     1071     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     1072   end procedure.
     1073   procedure prn-lib-reportviewer-report-name :
     1074     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1075     define input parameter p-report-name-html as character no-undo .
     1076     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
     1077   end procedure.
     1078   procedure prn-lib-reportviewer :
     1079     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1080     define input parameter p-report-name-html as character no-undo .
     1081     define input parameter p-param        as character no-undo .
     1082     define variable v-excel           as character no-undo init 'TRUE' .
     1083     define variable v-value-character as character no-undo .
     1084     define variable v-value-integer   as character no-undo .
     1085     define variable v-value-date      as date      no-undo .
     1086     define variable v-value-decimal   as decimal   no-undo .
     1087     define variable rep-excel         as logical   no-undo .
     1088     define variable excel-string      as character no-undo .
     1089     define variable v-param-type      as character no-undo .
     1090     define variable v-tth             as handle    no-undo .
     1091     run adm/shattri.p (
     1092       input "get":U
     1093       ,input  ""
     1094       ,input  0
     1095       ,input  'report-glob':U
     1096       ,input  'rep-excel':U
     1097       ,output v-value-character
     1098       ,output v-value-date
     1099       ,output v-value-decimal
     1100       ,output v-value-integer
     1101       ,output rep-excel
     1102       ,output v-param-type
     1103       ,INPUT-OUTPUT table-handle v-tth
     1104       )  .
     1105     if rep-excel then v-excel = "TRUE" .
     1106     else v-excel = "FALSE" .
     1107     if p-param eq ""
     1108     then
     1109        p-param = "EXCEL:" + v-excel.
     1110     else
     1111        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1112     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1113   end procedure.
     1114   define variable vss-include-info11 as character format "X(65)" no-undo
     1115   initial "@(#)$Workfile$ $Revision$".
     1116   define temp-table temp_grplib_grp no-undo
     1117       field sel           as character
     1118       field nabor         as character
     1119       field full-name     as character
     1120       field print-code    as character
     1121       field sort-name     as character
     1122       field node-code     as integer
     1123       field upper-code    as integer
     1124       field calc-method   as character
     1125       field round-method  as character
     1126       field increase-pc   as decimal
     1127       field min-marg      as character
     1128       field max-marg      as character
     1129       field cli-type      as character
     1130       field cli-code      as integer
     1131       field notcorr      as character
     1132       field name          as character
     1133       field level         as integer
     1134       field mark          as character
     1135       index pi is primary unique sort-name
     1136       index fn full-name
     1137       index nc is unique node-code
     1138       index sl sel
     1139       index uc upper-code
     1140   .
     1141   define temp-table temp_grplib_found-grp no-undo
     1142       field full-name   as character
     1143       field sort-name   as character
     1144       field node-code   as integer
     1145       field level       as integer
     1146       field is-terminal as logical
     1147       index pi is primary unique sort-name
     1148       index fn full-name
     1149       index lv level
     1150       index it is-terminal
     1151   .
     1152   define temp-table temp_found-result-nodelist no-undo
     1153       field node-code     as recid
     1154       field processed     as logical
     1155       field sort-name     as character
     1156       field full-name     as character
     1157       index pi is primary unique node-code
     1158       index ps processed
     1159   .
     1160   define variable v-grplib-not-fill-extra-info        as logical      no-undo.
     1161   define variable v-grplib-no-warning-grp-amount      as logical      no-undo.
     1162   define variable v-grplib-grp-amount-for-load        as integer      no-undo.
     1163   procedure grplib-get-parameters :
     1164   define input parameter p-store-type     as character        no-undo.
     1165   define input parameter p-store-code     as integer          no-undo.
     1166   do
     1167   on error undo, return error
     1168   :
     1169       assign
     1170           v-grplib-not-fill-extra-info = no
     1171       .
     1172   end.
     1173   end procedure.
     1174   procedure grplib-get-sort-name :
     1175   do
     1176   on error undo, return error
     1177   :
     1178   define input parameter p-node-code  as integer      no-undo.
     1179   define output parameter p-sort-name as character    no-undo.
     1180       define variable v-upper-code    as integer           no-undo.
     1181       define buffer buf_gds-grp       for ub.gds-grp.
     1182       define buffer buf_upper_gds-grp for ub.gds-grp.
     1183       find first buf_gds-grp no-lock
     1184            where buf_gds-grp.node-code = p-node-code
     1185       no-error.
     1186       if not available buf_gds-grp
     1187       then do:
     1188           undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     1189       end.
     1190       assign
     1191           p-sort-name  = ""
     1192           v-upper-code = 1
     1193       .
     1194       do while buf_gds-grp.upper-code <> 0
     1195       on error undo, return error "grplib-get-sort-name: Ошибка составления полного имени группы"
     1196       :
     1197           assign
     1198               p-sort-name  = buf_gds-grp.node-name
     1199                            + (if p-sort-name <> "" then chr(2) else "")
     1200                            + p-sort-name
     1201               v-upper-code = buf_gds-grp.upper-code
     1202           .
     1203           find first buf_gds-grp no-lock
     1204                where buf_gds-grp.node-code = v-upper-code
     1205           no-error.
     1206           if not available buf_gds-grp
     1207           then do:
     1208               undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом "
     1209                                   + string( v-upper-code )
     1210                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     1211           end.
     1212       end.
     1213   end.
     1214   end procedure.
     1215   define variable vss-include-info12 as character format "X(65)" no-undo
     1216   initial "@(#)$Workfile$ $Revision$".
     1217   procedure grplib-get-full-name :
     1218      define input parameter p-node-code  as integer      no-undo.
     1219      define output parameter p-full-name as character    no-undo.
     1220      do
     1221   on error undo, return error
     1222   :
     1223       define variable v-upper-code    as integer           no-undo.
     1224       define buffer buf_gds-grp       for ub.gds-grp.
     1225       define buffer buf_upper_gds-grp for ub.gds-grp.
     1226       find first buf_gds-grp no-lock
     1227            where buf_gds-grp.node-code = p-node-code
     1228       no-error.
     1229       if not available buf_gds-grp
     1230       then do:
     1231           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     1232       end.
     1233       assign
     1234           p-full-name  = ""
     1235           v-upper-code = 1
     1236       .
     1237       do while buf_gds-grp.upper-code <> 0
     1238       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     1239       :
     1240           assign
     1241               p-full-name  = buf_gds-grp.node-name
     1242                            + (if p-full-name <> "" then chr(47) else "")
     1243                            + p-full-name
     1244               v-upper-code = buf_gds-grp.upper-code
     1245           .
     1246           find first buf_gds-grp no-lock
     1247                where buf_gds-grp.node-code = v-upper-code
     1248           no-error.
     1249           if not available buf_gds-grp
     1250           then do:
     1251               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
     1252                                   + string( v-upper-code )
     1253                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     1254           end.
     1255       end.
     1256       assign
     1257       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     1258       .
     1259   end.
     1260   end .
     1261   procedure grplib-get-node-from-full-name :
     1262   define input parameter p-full-name as character no-undo .
     1263   define output parameter p-node-code as integer no-undo .
     1264   define variable v-ii as integer no-undo .
     1265   define variable v-upper-code as integer no-undo .
     1266   define variable v-root-code as integer no-undo .
     1267   define variable v-entry as character no-undo .
     1268   define buffer buf_gds-grp       for ub.gds-grp.
     1269   do
     1270   on error undo, return error
     1271   :
     1272     find first buf_gds-grp no-lock
     1273         where buf_gds-grp.upper-code = 0
     1274     no-error .
     1275     if not available buf_gds-grp
     1276     then do:
     1277         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
     1278     end.
     1279     else do:
     1280       assign
     1281       v-root-code = buf_gds-grp.node-code
     1282       .
     1283     end.
     1284     v-upper-code = v-root-code.
     1285     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     1286       assign
     1287       v-entry = entry(v-ii, p-full-name, chr(47)).
     1288       if v-entry = '' then leave.
     1289       find first buf_gds-grp no-lock where
     1290                 buf_gds-grp.node-name = v-entry
     1291             and buf_gds-grp.upper-code = v-upper-code
     1292             no-error.
     1293       if not available buf_gds-grp then do:
     1294         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     1295       end.
     1296       else do:
     1297         p-node-code = buf_gds-grp.node-code.
     1298         v-upper-code = buf_gds-grp.node-code.
     1299       end.
     1300     end.
     1301   end.
     1302   end .
     1303   procedure grplib-get-root-code :
     1304   do
     1305   on error undo, return error
     1306   :
     1307   define output parameter p-root-code as integer      no-undo.
     1308       define buffer buf_gds-grp       for ub.gds-grp.
     1309       find first buf_gds-grp no-lock
     1310           where buf_gds-grp.upper-code = 0
     1311       no-error .
     1312       if not available buf_gds-grp
     1313       then do:
     1314           undo, return error .
     1315       end.
     1316       else do:
     1317           assign
     1318               p-root-code = buf_gds-grp.node-code
     1319           .
     1320       end.
     1321   end.
     1322   end procedure.
     1323   procedure grplib-find-grp-by-full-name :
     1324   do
     1325   on error undo, return error
     1326   :
     1327   define input parameter p-search-name  as character    no-undo.
     1328   define input parameter p-fill-path    as logical      no-undo.
     1329   define output parameter p-found       as logical      no-undo.
     1330       define variable v-upper-code    as integer          no-undo.
     1331       define variable v-counter       as integer           no-undo.
     1332       define variable v-level         as integer           no-undo.
     1333       define variable v-full-name     as character         no-undo.
     1334       define variable v-sort-name     as character         no-undo.
     1335       define buffer buf_gds-grp       for ub.gds-grp.
     1336       assign
     1337           p-search-name = replace( p-search-name, chr(47), chr(2) )
     1338       .
     1339       run grplib-get-root-code ( output v-upper-code ) no-error .
     1340       if error-status :error
     1341       then do:
     1342           undo, return error "grplib-expand-name: Ошибка при поиске корневого узла".
     1343       end.
     1344       assign
     1345           v-full-name  = ""
     1346           v-level      = num-entries( p-search-name, chr(2) )
     1347       .
     1348       for each temp_grplib_found-grp
     1349       :
     1350           delete temp_grplib_found-grp.
     1351       end.
     1352       start-name-analyze:
     1353       do v-counter = 1 to v-level
     1354       :
     1355           if v-counter < v-level
     1356           then do:
     1357               find first buf_gds-grp no-lock
     1358                    where buf_gds-grp.upper-code = v-upper-code
     1359                      and buf_gds-grp.node-name  = entry( v-counter, p-search-name, chr(2) )
     1360               no-error .
     1361               if not available buf_gds-grp
     1362               then do:
     1363                   assign
     1364                       v-full-name  = p-search-name
     1365                       v-sort-name  = p-search-name
     1366                   .
     1367                   return error "grplib-expand-name: не найдена группа " + entry( v-level, p-search-name, chr(2) ).
     1368               end.
     1369               else do:
     1370                   assign
     1371                       v-full-name = v-full-name + ( if v-full-name = "" then "" else chr(47) )        + buf_gds-grp.node-name
     1372                       v-sort-name = v-sort-name + ( if v-sort-name = "" then "" else chr(2) ) + buf_gds-grp.node-name
     1373                       v-upper-code = buf_gds-grp.node-code
     1374                   .
     1375                   if p-fill-path = yes
     1376                   then do:
     1377                       create temp_grplib_found-grp.
     1378                       assign
     1379                           temp_grplib_found-grp.full-name = v-full-name + chr(47)
     1380                           temp_grplib_found-grp.sort-name = v-sort-name
     1381                           temp_grplib_found-grp.node-code = v-upper-code
     1382                           temp_grplib_found-grp.level     = v-counter
     1383                       .
     1384                   end.
     1385               end.
     1386           end.
     1387           else do:
     1388               for each buf_gds-grp no-lock
     1389                  where buf_gds-grp.upper-code = v-upper-code
     1390                    and buf_gds-grp.node-name begins entry( v-counter, p-search-name, chr(2) )
     1391               :
     1392                   assign
     1393                       p-found = yes
     1394                   .
     1395                   create temp_grplib_found-grp.
     1396                   assign
     1397                       temp_grplib_found-grp.full-name = v-full-name
     1398                                                           + (if v-full-name = "" then "" else chr(47) )
     1399                                                           + buf_gds-grp.node-name + chr(47)
     1400                       temp_grplib_found-grp.sort-name = v-sort-name
     1401                                                           + ( if v-sort-name = "" then "" else chr(2) )
     1402                                                           + buf_gds-grp.node-name
     1403                       temp_grplib_found-grp.node-code = buf_gds-grp.node-code
     1404                       temp_grplib_found-grp.level     = v-level
     1405                   .
     1406               end.
     1407               if p-found = no
     1408               then do:
     1409                   assign
     1410                       v-full-name  = p-search-name
     1411                       v-sort-name  = p-search-name
     1412                   .
     1413                   for each temp_grplib_found-grp
     1414                   :
     1415                       delete temp_grplib_found-grp.
     1416                   end.
     1417                   assign
     1418                       p-found = no
     1419                   .
     1420               end.
     1421           end.
     1422       end.
     1423   end.
     1424   end procedure.
     1425   procedure grplib-find-all-subgroup :
     1426   do
     1427   on error undo, return error
     1428   :
     1429   define input parameter p-start-node-code    as integer      no-undo.
     1430   define input parameter p-terminal-only      as logical      no-undo.
     1431       define variable v-start-full-name   as character     no-undo.
     1432       define variable v-start-sort-name   as character     no-undo.
     1433       define variable v-not-found         as logical       no-undo.
     1434       define variable v-is-terminal       as logical       no-undo.
     1435       define buffer buf_gds-grp           for ub.gds-grp.
     1436       create temp_found-result-nodelist.
     1437       assign
     1438           temp_found-result-nodelist.node-code = p-start-node-code
     1439           temp_found-result-nodelist.processed = no
     1440       .
     1441       run grplib-get-full-name in this-procedure (
     1442             input p-start-node-code
     1443           , output v-start-full-name
     1444       ).
     1445       run grplib-get-full-name in this-procedure (
     1446             input p-start-node-code
     1447           , output v-start-sort-name
     1448       ).
     1449       process-nodes:
     1450       do while yes
     1451       :
     1452           find first temp_found-result-nodelist
     1453                where temp_found-result-nodelist.node-code = p-start-node-code
     1454           .
     1455           assign
     1456               temp_found-result-nodelist.processed = yes
     1457           .
     1458           for each buf_gds-grp no-lock
     1459              where buf_gds-grp.upper-code = p-start-node-code
     1460           on error undo, return error
     1461           :
     1462               run grplib-is-terminal in this-procedure (
     1463                     input buf_gds-grp.node-code
     1464                   , output v-is-terminal
     1465               ).
     1466               if v-is-terminal = yes
     1467               then do:
     1468                   create temp_grplib_found-grp.
     1469                   assign
     1470                       temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
     1471                                                           chr(47) + buf_gds-grp.node-name + chr(47)
     1472                       temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
     1473                                                           chr(2) + buf_gds-grp.node-name + chr(2)
     1474                       temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
     1475                       temp_grplib_found-grp.is-terminal = yes
     1476                   .
     1477               end.
     1478               else do:
     1479                   create temp_found-result-nodelist.
     1480                   assign
     1481                       temp_found-result-nodelist.node-code = buf_gds-grp.node-code
     1482                       temp_found-result-nodelist.full-name = right-trim(v-start-full-name, chr(47)) +
     1483                                                              chr(47) + buf_gds-grp.node-name + chr(47)
     1484                       temp_found-result-nodelist.sort-name = right-trim(v-start-sort-name, chr(2)) +
     1485                                                              chr(2) + buf_gds-grp.node-name + chr(2)
     1486                       temp_found-result-nodelist.processed = no
     1487                   .
     1488                   if p-terminal-only = no
     1489                   then do:
     1490                       create temp_grplib_found-grp.
     1491                       assign
     1492                           temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
     1493                                                               chr(47) + buf_gds-grp.node-name + chr(47)
     1494                           temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
     1495                                                               chr(2) + buf_gds-grp.node-name + chr(2)
     1496                           temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
     1497                           temp_grplib_found-grp.is-terminal = no
     1498                       .
     1499                   end.
     1500               end.
     1501           end.
     1502           find first temp_found-result-nodelist
     1503                where temp_found-result-nodelist.processed = no
     1504           no-error.
     1505           if not available temp_found-result-nodelist
     1506           then do:
     1507               leave process-nodes.
     1508           end.
     1509           else do:
     1510               assign
     1511                   p-start-node-code = temp_found-result-nodelist.node-code
     1512                   v-start-full-name = temp_found-result-nodelist.full-name
     1513                   v-start-sort-name = temp_found-result-nodelist.sort-name
     1514               .
     1515           end.
     1516       end.
     1517   end.
     1518   end procedure.
     1519   procedure grplib-expand-name :
     1520   define input parameter p-start-name as character        no-undo.
     1521   define output parameter p-end-name  as character        no-undo.
     1522       define variable v-is-terminal   as logical      no-undo.
     1523       define variable v-found         as character    no-undo.
     1524       define buffer buf_temp_grplib_found-grp     for temp_grplib_found-grp.
     1525   do
     1526   for buf_temp_grplib_found-grp
     1527   on error undo, return error
     1528   :
     1529       run grplib-find-grp-by-full-name in this-procedure (
     1530             input p-start-name
     1531           , input no
     1532           , output v-found
     1533       ) no-error.
     1534       run grplib-get-max-substring in this-procedure (
     1535                   input length( p-start-name )
     1536                 , output p-end-name
     1537       ) no-error .
     1538       if error-status :error
     1539       then do:
     1540           assign
     1541               p-end-name = ""
     1542           .
     1543       end.
     1544       else do:
     1545           find first temp_grplib_found-grp
     1546               where temp_grplib_found-grp.full-name = p-end-name
     1547           no-error.
     1548           if available temp_grplib_found-grp
     1549           then do:
     1550               find first buf_temp_grplib_found-grp
     1551                   where buf_temp_grplib_found-grp.full-name begins p-end-name
     1552                   and recid( buf_temp_grplib_found-grp ) <> recid( temp_grplib_found-grp )
     1553               no-error.
     1554               if not available buf_temp_grplib_found-grp
     1555               then do:
     1556                   run grplib-is-terminal in this-procedure (
     1557                       input temp_grplib_found-grp.node-code
     1558                       , output v-is-terminal
     1559                   ).
     1560               end.
     1561           end.
     1562       end.
     1563   end.
     1564   end procedure.
     1565   procedure grplib-get-max-substring :
     1566   do
     1567   on error undo, return error
     1568   :
     1569   define input parameter p-min-substring-length   as integer      no-undo.
     1570   define output parameter p-substring             as character    no-undo.
     1571           define variable v-char-counter  as integer           no-undo.
     1572           define variable v-current-char  as character         no-undo.
     1573           define variable v-names-counter  as integer           no-undo.
     1574           define variable v-base-string   as character         no-undo.
     1575           assign
     1576               v-char-counter  = p-min-substring-length
     1577           .
     1578           find first temp_grplib_found-grp no-error.
     1579           if not available temp_grplib_found-grp
     1580           then do:
     1581               undo, return error "grplib-get-max-substring: Нет строк для вычисления общей подстроки".
     1582           end.
     1583           else do:
     1584               assign
     1585                   v-base-string  = temp_grplib_found-grp.full-name
     1586                   v-char-counter = 0
     1587               .
     1588               counter-block:
     1589               do while yes
     1590               on error undo, return error "grplib-get-max-substring: Ошибка вычисления продолжения имени группы."
     1591               :
     1592                   assign
     1593                       v-char-counter  = v-char-counter + 1
     1594                       v-current-char  = substring( v-base-string, v-char-counter, 1 )
     1595                       v-names-counter = 0
     1596                   .
     1597                   compare-block:
     1598                   for each temp_grplib_found-grp
     1599                   :
     1600                       assign
     1601                           v-names-counter = v-names-counter + 1
     1602                       .
     1603                       if v-names-counter = 1
     1604                       then do:
     1605                           next compare-block.
     1606                       end.
     1607                       if substring( temp_grplib_found-grp.full-name, v-char-counter, 1 ) <> v-current-char
     1608                       then do:
     1609                           leave counter-block.
     1610                       end.
     1611                   end.
     1612                   if v-names-counter = 1
     1613                   then do:
     1614                       assign
     1615                           p-substring = v-base-string
     1616                       .
     1617                       return.
     1618                   end.
     1619               end.
     1620               assign
     1621                   p-substring = substring( v-base-string, 1, v-char-counter - 1 )
     1622               .
     1623           end.
     1624   end.
     1625   end procedure.
     1626   procedure grplib-is-terminal :
     1627   do
     1628   on error undo, return error "Ошибка процедуры grplib-is-terminal"
     1629   :
     1630   define input parameter p-node-code      as integer      no-undo.
     1631   define output parameter p-is-terminal   as logical      no-undo.
     1632       define buffer buf_gds-grp       for ub.gds-grp.
     1633       find first buf_gds-grp no-lock
     1634           where buf_gds-grp.upper-code = p-node-code
     1635       no-error .
     1636       if not available buf_gds-grp
     1637       then do:
     1638           assign
     1639               p-is-terminal = yes
     1640           .
     1641       end.
     1642       else do:
     1643           assign
     1644               p-is-terminal = no
     1645           .
     1646       end.
     1647   end.
     1648   end procedure.
     1649   procedure grplib-have-goods :
     1650   do
     1651   on error undo, return error
     1652   :
     1653   define input parameter p-node-code      as integer      no-undo.
     1654   define output parameter p-have-goods   as logical      no-undo.
     1655       define buffer buf_goods         for ub.goods.
     1656       find first buf_goods no-lock
     1657            where buf_goods.grp-code = p-node-code
     1658       no-error .
     1659       if available buf_goods
     1660       then do:
     1661           assign
     1662               p-have-goods = yes
     1663           .
     1664       end.
     1665       else do:
     1666           assign
     1667               p-have-goods = no
     1668           .
     1669       end.
     1670   end.
     1671   end procedure.
     1672   procedure grplib-find-by-substring :
     1673   do
     1674   on error undo, return error
     1675   :
     1676   define input parameter p-start-code         as integer      no-undo.
     1677   define input parameter p-full-search-string as character    no-undo.
     1678   define output parameter p-found-code        as integer      no-undo.
     1679   define output parameter p-full-name         as character    no-undo.
     1680       define variable v-start-code     as integer           no-undo.
     1681       define variable v-found          as logical  init no  no-undo.
     1682       define buffer buf_gds-grp       for ub.gds-grp.
     1683       search-grp:
     1684       for each buf_gds-grp no-lock
     1685           where buf_gds-grp.node-code > p-start-code
     1686       :
     1687           if index( buf_gds-grp.node-name, p-full-search-string ) <> 0
     1688           then do:
     1689               assign
     1690                   p-found-code = buf_gds-grp.node-code
     1691                   v-found      = yes
     1692               .
     1693               run grplib-get-full-name in this-procedure (
     1694                     input p-found-code
     1695                   , output p-full-name
     1696               ) no-error .
     1697               if error-status :error
     1698               then do:
     1699                   undo, return error "grplib-find-by-substring: Ошибка вычисления полного имени группы." + chr(10) + return-value.
     1700               end.
     1701               leave search-grp.
     1702           end.
     1703       end.
     1704       if v-found = yes
     1705       then do:
     1706       end.
     1707       else do:
     1708           assign
     1709               p-full-name  = ""
     1710               p-found-code = 0
     1711           .
     1712       end.
     1713   end.
     1714   end procedure.
     1715   procedure grplib-analyze-grp-name :
     1716   do
     1717   on error undo, return error
     1718   :
     1719   define input parameter p-grp-name       as character            no-undo.
     1720   define input parameter p-upper-code     as integer              no-undo.
     1721   define output parameter p-error-message as character init ""    no-undo.
     1722       define variable v-char-list     as character    no-undo.
     1723       define variable v-char-counter  as integer      no-undo.
     1724       define variable v-full-name     as character    no-undo.
     1725       if p-grp-name = "" then do:
     1726           assign
     1727               p-error-message = "Название группы не может быть пустым.".
     1728           .
     1729       end.
     1730       else do:
     1731           assign
     1732               v-char-list = "47,92,58,63,34,60,62,171,187,183"
     1733           .
     1734           do v-char-counter = 1 to num-entries( v-char-list )
     1735           :
     1736               if index( p-grp-name, chr( integer( entry( v-char-counter, v-char-list ) ) ) ) <> 0
     1737               then do:
     1738                   assign
     1739                       p-error-message = 'Название группы не может содержать символы /\:*?"<>|«»·'
     1740                   .
     1741                   return.
     1742               end.
     1743           end.
     1744           if p-upper-code > 0
     1745           then do:
     1746               run grplib-get-full-name in this-procedure (
     1747                     input p-upper-code
     1748                   , output v-full-name
     1749               ) no-error .
     1750               if error-status :error
     1751               then do:
     1752                   undo, return error "grplib-analyze-grp-name: Не удалось вычислить полное имя группы." + chr(10) + return-value.
     1753               end.
     1754               if length( v-full-name ) + 1 + length( p-grp-name ) > 350
     1755               then do:
     1756                   assign
     1757                       p-error-message = 'Полное название группы не может содержать более 350 символов.'
     1758                   .
     1759               end.
     1760           end.
     1761       end.
     1762   end.
     1763   end procedure.
     1764   procedure grplib-get-lvl-num :
     1765   define input parameter p-node-code  as integer      no-undo.
     1766   define output parameter p-lvl-num   as integer      no-undo.
     1767       define variable v-full-name    as character    no-undo.
     1768   do
     1769   on error undo, return error
     1770   :
     1771       run grplib-get-full-name in this-procedure (
     1772             input p-node-code
     1773           , output v-full-name
     1774       ).
     1775       assign
     1776           p-lvl-num = num-entries( v-full-name, chr(47) ) - 1
     1777       .
     1778       if p-lvl-num = -1
     1779       then do:
     1780           assign
     1781               p-lvl-num = 0
     1782           .
     1783       end.
     1784   end.
     1785   end procedure.
     1786   define new global shared variable g#lib-trn  as handle no-undo .
     1787   define new global shared variable g#lib-trn2 as handle no-undo .
     1788   define new global shared variable g#lib-trn3 as handle no-undo .
     1789   define new global shared variable g#lib-trn4 as handle no-undo .
     1790   define variable vss-include-info13 as character format "X(65)" no-undo
     1791   initial "@(#)$Workfile$ $Revision$".
     1792   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
