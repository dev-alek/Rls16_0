     4122     assign
     4123       date_      = v-date-start1
     4124       v-date-end = v-date-end1
     4125       .
     4126     do v-date-start = date_ to (v-date-end) :
     4127       for each    temp-fin-doc :
     4128         delete temp-fin-doc.
     4129       end.
     4130       assign
     4131         v-shift-num-min        = 0
     4132         v-shift-num-max        = 0
     4133         v-shift-name-min       = ""
     4134         v-shift-name-max       = ""
     4135         v-shift-multydate      = no
     4136         v-date-start-multydate = ?
     4137         .
     4138       if x-shift-start = x-shift-end and x-date-start = x-date-end then
     4139       do:
     4140         shift-alone = yes.
     4141       end.
     4142       else
     4143       do:
     4144         shift-alone = no.
     4145       end.
     4146       if v-date-start = x-date-start then
     4147       do:
     4148         find first buf_day-shift-obj
     4149           where buf_day-shift-obj.shift-date = v-date-start
     4150           and buf_day-shift-obj.obj-type = v-cntxt-obj-type
     4151           and buf_day-shift-obj.obj-code = v-cntxt-obj-code
     4152           and buf_day-shift-obj.shift-num >= x-shift-start
     4153           no-lock no-error.
     4154         if available buf_day-shift-obj then
     4155         do:
     4156           v-shift-num-min = buf_day-shift-obj.shift-num.
     4157           v-shift-name-min = buf_day-shift-obj.shift-name.
     4158         end.
     4159       end.
     4160       else
     4161       do:
     4162         find first buf_day-shift-obj
     4163           where buf_day-shift-obj.shift-date = v-date-start
     4164           and buf_day-shift-obj.obj-type = v-cntxt-obj-type
     4165           and buf_day-shift-obj.obj-code = v-cntxt-obj-code
     4166           no-lock no-error.
     4167         if available buf_day-shift-obj then
     4168         do:
     4169           v-shift-num-min = buf_day-shift-obj.shift-num.
     4170           v-shift-name-min = buf_day-shift-obj.shift-name.
     4171         end.
     4172         else
     4173         do:
     4174           find last buf_day-shift-obj
     4175             where buf_day-shift-obj.shift-date <= v-date-start
     4176             and buf_day-shift-obj.obj-type = v-cntxt-obj-type
     4177             and buf_day-shift-obj.obj-code = v-cntxt-obj-code
     4178             and buf_day-shift-obj.close-date >= v-date-start
     4179             no-lock no-error.
     4180           do:
     4181             if available buf_day-shift-obj then
     4182             do:
     4183               v-shift-num-min = buf_day-shift-obj.shift-num.
     4184               v-shift-name-min = buf_day-shift-obj.shift-name.
     4185               v-date-start-multydate = buf_day-shift-obj.shift-date.
     4186               v-shift-multydate = yes.
     4187             end.
     4188           end.
     4189         end.
     4190       end.
     4191       find last buf_day-shift-obj
     4192         where buf_day-shift-obj.obj-type = v-cntxt-obj-type
     4193         and buf_day-shift-obj.obj-code = v-cntxt-obj-code
     4194         and buf_day-shift-obj.shift-date = v-date-start
     4195         and (if v-date-start = x-date-end
     4196         then  buf_day-shift-obj.shift-num <= x-shift-end else true)
     4197         no-lock no-error.
     4198       do:
     4199         if available buf_day-shift-obj then
     4200         do:
     4201           if v-shift-num-min < v-shift-num-max then
     4202           do:
     4203             v-multy-shift = yes.
     4204           end.
     4205           else
     4206           do:
     4207             if v-shift-num-min = 0 and buf_day-shift-obj.shift-num > 0 then
     4208             do:
     4209               v-shift-num-min = 0.
     4210               v-shift-num-max = 0.
     4211               v-shift-name-min = "".
     4212               v-shift-name-max = "".
