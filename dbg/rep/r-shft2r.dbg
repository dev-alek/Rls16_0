     2666           and bf_parts.obj-code  = bf_doc-line.obj-code
     2667           and bf_parts.artic     = bf_doc-line.artic
     2668           and bf_parts.prod-type = bf_doc-line.prod-type
     2669           and bf_parts.prod-code = bf_doc-line.prod-code
     2670       on error undo, return error return-value
