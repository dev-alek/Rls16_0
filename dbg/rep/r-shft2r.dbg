     3583         ,output c-type) no-error.
     3584   end.
     3585   result = logical(c-value = 'lgas':U) no-error.
     3586   return result.
     3587   end function.
     3588   function is-gas returns logical
     3589           (input p-gds-code as integer):
     3590   define variable result as logical no-undo.
     3591   define variable c-value as character no-undo.
     3592   define variable c-type as character no-undo.
     3593   do on error undo, return error:
     3594           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3595         (input  p-gds-code
     3596         ,input  'fuel-type':U
     3597         ,output c-value
     3598         ,output c-type) no-error.
     3599   end.
     3600   result = logical(c-value = 'metan':U) no-error.
     3601   return result.
     3602   end function.
     3603   DEFINE VARIABLE loc-ii              AS INTEGER   NO-UNDO INITIAL 1.
     3604   DEFINE VARIABLE for-supp-name       AS CHARACTER NO-UNDO.
     3605   DEFINE VARIABLE vdoc-num            LIKE ub.price-list.doc-num NO-UNDO.
     3606   DEFINE VARIABLE vprice-sale         LIKE ub.price-list.price-sale NO-UNDO.
     3607   DEFINE VARIABLE vroad-tax           AS DECIMAL   NO-UNDO.
     3608   DEFINE VARIABLE vexcise             AS DECIMAL   NO-UNDO.
     3609   DEFINE VARIABLE acc-other-qnty1     AS DECIMAL   NO-UNDO.
     3610   DEFINE VARIABLE acc-other-qnty2     AS DECIMAL   NO-UNDO.
     3611   DEFINE VARIABLE acc-other-netto     AS DECIMAL   NO-UNDO.
     3612   DEFINE VARIABLE acc-other-found     AS LOGICAL   NO-UNDO.
     3613   DEFINE VARIABLE acc-cli-qnty1       AS DECIMAL   NO-UNDO.
     3614   DEFINE VARIABLE acc-cli-qnty2       AS DECIMAL   NO-UNDO.
     3615   DEFINE VARIABLE acc-cli-netto       AS DECIMAL   NO-UNDO.
     3616   DEFINE VARIABLE acc-cli-found       AS LOGICAL   NO-UNDO.
     3617   DEFINE VARIABLE current-cli         AS INTEGER   NO-UNDO.
     3618   DEFINE VARIABLE current-cli-type    AS CHARACTER NO-UNDO.
     3619   DEFINE VARIABLE dop-sum             AS DECIMAL   NO-UNDO.
     3620   DEFINE VARIABLE dop-qnty            AS DECIMAL   NO-UNDO.
     3621   DEFINE VARIABLE dop-kg              AS DECIMAL   NO-UNDO.
     3622   DEFINE VARIABLE found-in-previous   AS LOGICAL   NO-UNDO.
     3623   DEFINE VARIABLE mc                  LIKE ub.bar-code.b-code NO-UNDO.
     3624   DEFINE VARIABLE v-value-attr        AS CHARACTER NO-UNDO.
     3625   DEFINE VARIABLE v-attr-value        AS CHARACTER NO-UNDO.
     3626   DEFINE VARIABLE v-attr-type         AS CHARACTER NO-UNDO.
     3627   DEFINE VARIABLE v-sum-base          LIKE ub.ot-line.sum-base NO-UNDO.
     3628   DEFINE VARIABLE p-base-code         AS INTEGER   NO-UNDO.
     3629   DEFINE VARIABLE v-qnty1             AS DECIMAL   NO-UNDO.
     3630   DEFINE VARIABLE v-qnty2             AS DECIMAL   NO-UNDO.
     3631   DEFINE VARIABLE v-qnty3             AS DECIMAL   NO-UNDO.
     3632   define variable v-value             as character no-undo.
     3633   define variable v-type              as character no-undo.
     3634   define variable v-doc-code          as character no-undo.
     3635   define variable v-InfoSectionsTotal as class     InfoSectionsTotal no-undo .
     3636   define variable v-InfoSection       as class     InfoSection       no-undo .
     3637   define variable iNum                as integer   no-undo .
     3638   define temp-table temp-ptrl-goods no-undo
     3639     field gds-code  as integer
     3640     field ptrl-good as logical
     3641     index pi as unique primary
     3642     gds-code
     3643     .
     3644   define buffer end_shift-obj      for ub.shift-obj .
     3645   define buffer previous-shift-obj for ub.shift-obj.
     3646   define variable fo      as decimal no-undo init 0.
     3647   define variable prev-fo as decimal no-undo init 0.
     3648   define variable moving  as logical no-undo init yes.
     3649   find first end_shift-obj share-lock
     3650     where end_shift-obj.obj-type   = pobj-type
     3651       and end_shift-obj.obj-code   = pobj-code
     3652       and end_shift-obj.shift-date = pshift-date1
     3653       and end_shift-obj.shift-num  = pshift-num1
     3654       no-error.
     3655   if not available end_shift-obj then do:
     3656     message
     3657       vss-workfile vss-revision vss-description skip
     3658       substitute("Не найдена смена с порядковым номером &1 от &2 для объекта &3 &4", pshift-num1, pshift-date1, pobj-type, pobj-code ) skip
     3659       view-as alert-box error .
     3660     return error.
     3661   end.
     3662   else do:
     3663     assign
     3664       fo = end_shift-obj.fact-order
     3665     .
     3666   end.
     3667   find last previous-shift-obj share-lock
     3668     where previous-shift-obj.obj-type = pobj-type
     3669       and previous-shift-obj.obj-code = pobj-code
     3670       and (( previous-shift-obj.shift-date = pshift-date
     3671              and previous-shift-obj.shift-num < pshift-num
     3672            )
     3673            or previous-shift-obj.shift-date < pshift-date
     3674           )
     3675       use-index pi no-error.
     3676   if available previous-shift-obj then do:
     3677       if  previous-shift-obj.shift-date < p-previous-shift-date then do:
     3678         run day-begin-fact-order in this-procedure (
     3679                                                 input  p-previous-shift-date
     3680                                                ,output prev-fo).
     3681       end.
     3682       else do:
     3683       assign
     3684         prev-fo = previous-shift-obj.fact-order
     3685       .
     3686       end.
     3687   end.
     3688   v-InfoSectionsTotal = new InfoSectionsTotal().
     3689   v-InfoSection = new InfoSection().
     3690   DEFINE BUFFER previous-rvs-doc    FOR ub.rvs-doc.
     3691   DEFINE BUFFER previous-rvs-line   FOR ub.rvs-line.
     3692   DEFINE BUFFER this-shift-rvs-doc  FOR ub.rvs-doc.
     3693   DEFINE BUFFER this-shift-rvs-line FOR ub.rvs-line.
     3694   DEFINE BUFFER buf_doc-line        FOR ub.doc-line.
     3695   DEFINE BUFFER buf_inv-line        FOR ub.inv-line.
     3696   DEFINE BUFFER buf_trn-doc         FOR ub.trn-doc.
     3697   FIND FIRST ub.rvs-doc NO-LOCK WHERE
     3698     ub.rvs-doc.obj-type   = pobj-type    AND
     3699     ub.rvs-doc.obj-code   = pobj-code    AND
     3700     ub.rvs-doc.shift-date = pshift-date  AND
     3701     ub.rvs-doc.shift-num  = pshift-num   AND
     3702     ub.rvs-doc.status_    = 'факт':U      AND
     3703     ub.rvs-doc.rvs-type   = 'смена':U NO-ERROR.
     3704   IF NOT AVAILABLE ub.rvs-doc THEN
     3705   DO:
     3706     return error substitute("&1 &2 &3&4Не найдена сверка типа СМН объект &5&6 смена &7 порядок &8"
     3707       ,vss-workfile
     3708       ,vss-revision
     3709       ,vss-description
     3710       ,chr(10)
     3711       ,pobj-type
     3712       ,pobj-code
     3713       ,pshift-date
     3714       ,pshift-num).
     3715   END.
     3716   FIND FIRST ub.sysconf NO-LOCK WHERE
     3717     ub.sysconf.host-code = ub.rvs-doc.host-code NO-ERROR.
     3718   IF NOT AVAILABLE ub.sysconf THEN
     3719   DO:
     3720     return error substitute("&1 &2 &3&4Не найдена фирма типа &5 СМН объект &6&7 смена &8 порядок &9"
     3721       ,vss-workfile
     3722       ,vss-revision
     3723       ,vss-description
     3724       ,chr(10)
     3725       ,ub.rvs-doc.host-code
     3726       ,pobj-type
     3727       ,pobj-code
     3728       ,pshift-date
     3729       ,pshift-num).
     3730   END.
     3731   ASSIGN
     3732     p-base-code = ub.sysconf.base-code.
     3733   IF AVAILABLE previous-shift-obj THEN
     3734   DO:
     3735     FIND FIRST previous-rvs-doc NO-LOCK WHERE
     3736       previous-rvs-doc.obj-type   = pobj-type                     AND
     3737       previous-rvs-doc.obj-code   = pobj-code                     AND
     3738       previous-rvs-doc.shift-date = previous-shift-obj.shift-date AND
     3739       previous-rvs-doc.shift-num  = previous-shift-obj.shift-num  AND
     3740       previous-rvs-doc.status_    = 'факт':U                       AND
     3741       previous-rvs-doc.rvs-type   = 'смена':U                  NO-ERROR.
     3742   END.
     3743   define temp-table temp-rvs no-undo
     3744     FIELD gds-code   as integer
     3745     FIELD shift-date like ub.rvs-doc.shift-date
     3746     FIELD shift-num  like ub.rvs-doc.shift-num
     3747     field pl-code    like ub.rvs-line.pl-code
     3748     field rvs-code   like ub.rvs-line.rvs-code
     3749     INDEX pi IS UNIQUE PRIMARY gds-code pl-code
     3750     .
     3751   define buffer bf_temp-rvs for temp-rvs .
     3752   for each  ub.rvs-doc NO-LOCK WHERE
     3753     ub.rvs-doc.obj-type   = pobj-type    AND
     3754     ub.rvs-doc.obj-code   = pobj-code    AND
     3755     ub.rvs-doc.shift-date >= pshift-date  AND
     3756     ub.rvs-doc.shift-date <= pshift-date1  AND
     3757     ub.rvs-doc.status_    = 'факт':U      AND
     3758     ub.rvs-doc.rvs-type   = 'смена':U
     3759     break by ub.rvs-doc.shift-date by ub.rvs-doc.shift-num:
     3760     if ub.rvs-doc.shift-date = pshift-date  and ub.rvs-doc.shift-num < pshift-num  then next .
     3761     if ub.rvs-doc.shift-date = pshift-date1 and ub.rvs-doc.shift-num > pshift-num1 then next .
     3762     _rvs-line:
     3763     FOR EACH ub.rvs-line NO-LOCK WHERE
     3764       ub.rvs-line.rvs-code = ub.rvs-doc.rvs-code AND
     3765       ub.rvs-line.obj-type = ub.rvs-doc.obj-type AND
     3766       ub.rvs-line.obj-code = ub.rvs-doc.obj-code
     3767       BREAK BY ub.rvs-line.gds-code :
     3768       FIND FIRST t-2 WHERE t-2.gds-code = ub.rvs-line.gds-code NO-ERROR.
     3769       IF NOT AVAILABLE t-2 THEN
     3770       DO:
     3771         v-value = ''.
     3772         run gds-attr-value in this-procedure (
     3773           input ub.rvs-line.gds-code
     3774           ,input 'ptrl-as-good':U
     3775           ,output v-value
     3776           ,output v-type) no-error.
     3777         if logical(v-value) then next _rvs-line.
     3778         FIND FIRST ub.goods NO-LOCK WHERE ub.goods.gds-code = ub.rvs-line.gds-code NO-ERROR.
     3779         IF AVAILABLE ub.goods THEN
     3780         DO:
     3781   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3782   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     3783     (input  pobj-type
     3784     ,input  pobj-code
     3785     ,input  ub.rvs-line.gds-code
     3786     ,input  0
     3787     ,input  fo
     3788     ,output vdoc-num
     3789     ,output vprice-sale
     3790     ,output vroad-tax
     3791     ,output vexcise
     3792     ) no-error .
     3793           ASSIGN
     3794             mc = ub.goods.gds-code.
     3795   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     3796     (input  ub.goods.gds-code
     3797     ,input  ?
     3798     ,output mc
     3799     )  .
     3800           CREATE t-2.
     3801           ASSIGN
     3802             t-2.gds-code      = ub.rvs-line.gds-code
     3803             t-2.main-code     = mc
     3804             t-2.gds-name      = ub.goods.gds-name
     3805             t-2.artic         = ub.goods.artic
     3806             t-2.prod-type     = ub.goods.prod-type
     3807             t-2.prod-code     = ub.goods.prod-code
     3808             t-2.last-price    = vprice-sale
     3809             found-in-previous = NO
     3810             .
     3811         end.
     3812       end.
     3813       IF AVAILABLE previous-rvs-doc THEN
     3814       DO:
     3815         FOR EACH previous-rvs-line NO-LOCK WHERE
     3816           previous-rvs-line.rvs-code = previous-rvs-doc.rvs-code AND
     3817           previous-rvs-line.pl-code  = ub.rvs-line.pl-code       AND
     3818           previous-rvs-line.gds-code = t-2.gds-code              :
     3819           ASSIGN
     3820             found-in-previous = YES .
     3821           if pshift-date = ub.rvs-doc.shift-date and pshift-num  = ub.rvs-doc.shift-num then
     3822           do:
     3823             ASSIGN
     3824               t-2.qnty1-before = t-2.qnty1-before + previous-rvs-line.system-qnty
     3825               t-2.qnty2-before = t-2.qnty2-before + previous-rvs-line.system-cli-qnty
     3826               .
     3827             end.
     3828         END.
     3829       END.
     3830       IF found-in-previous = NO THEN
     3831       DO:
     3832         FOR EACH this-shift-rvs-doc  WHERE
     3833           this-shift-rvs-doc.obj-type   =  pobj-type    AND
     3834           this-shift-rvs-doc.obj-code   =  pobj-code    AND
     3835           this-shift-rvs-doc.shift-date =  pshift-date  AND
     3836           this-shift-rvs-doc.shift-num  =  pshift-num   AND
     3837           this-shift-rvs-doc.status_    =  'факт':U      AND
     3838           this-shift-rvs-doc.rvs-type   <> 'смена':U
     3839           , EACH this-shift-rvs-line WHERE
     3840           this-shift-rvs-line.rvs-code  =  this-shift-rvs-doc.rvs-code AND
     3841           this-shift-rvs-line.obj-type  =  this-shift-rvs-doc.obj-type AND
     3842           this-shift-rvs-line.obj-code  =  this-shift-rvs-doc.obj-code AND
     3843           this-shift-rvs-line.gds-code  =  t-2.gds-code
     3844           BY this-shift-rvs-doc.fact-order
     3845           :
     3846           ASSIGN
     3847             t-2.qnty1-before = this-shift-rvs-line.system-qnty
     3848             t-2.qnty2-before = this-shift-rvs-line.system-cli-qnty
     3849             .
     3850           LEAVE.
     3851         END.
     3852       END.
     3853       find first temp-rvs where temp-rvs.gds-code = ub.rvs-line.gds-code no-error .
     3854       if available temp-rvs then
     3855       do:
     3856         if temp-rvs.shift-date < ub.rvs-doc.shift-date or temp-rvs.shift-date = ub.rvs-doc.shift-date and temp-rvs.shift-num  <= ub.rvs-doc.shift-num then
     3857         do:
     3858           if temp-rvs.pl-code <> ub.rvs-line.pl-code then do:
     3859           ASSIGN
     3860             t-2.qnty1-after = t-2.qnty1-after + ub.rvs-line.system-qnty
     3861             t-2.qnty2-after = t-2.qnty2-after + ub.rvs-line.system-cli-qnty
     3862             .
     3863             if temp-rvs.rvs-code <> ub.rvs-line.rvs-code then temp-rvs.pl-code = ub.rvs-line.pl-code .
     3864             end.
     3865             else do:
     3866           ASSIGN
     3867             t-2.qnty1-after = ub.rvs-line.system-qnty
     3868             t-2.qnty2-after = ub.rvs-line.system-cli-qnty
     3869             temp-rvs.rvs-code   = ub.rvs-line.rvs-code
     3870             .
     3871             end.
     3872         end.
     3873       end.
     3874       else
     3875       do:
     3876         create temp-rvs .
     3877         assign
     3878           temp-rvs.gds-code   = ub.rvs-line.gds-code
     3879           temp-rvs.shift-date = ub.rvs-doc.shift-date
     3880           temp-rvs.shift-num  = ub.rvs-doc.shift-num
     3881           temp-rvs.pl-code    = ub.rvs-line.pl-code
     3882           temp-rvs.rvs-code   = ub.rvs-line.rvs-code
     3883           t-2.qnty1-after     = ub.rvs-line.system-qnty
     3884           t-2.qnty2-after     = ub.rvs-line.system-cli-qnty
     3885           .
     3886       end.
     3887     END.
     3888   end.
     3889   IF moving <> YES THEN
     3890   DO:
     3891     RETURN.
     3892   END.
     3893   FOR EACH  ub.trn-doc  NO-LOCK
     3894     WHERE ub.trn-doc.obj-type   = pobj-type
     3895     AND ub.trn-doc.obj-code   = pobj-code
     3896     AND ub.trn-doc.fact-order >= prev-fo
     3897     AND ub.trn-doc.fact-order <= fo
     3898     AND ub.trn-doc.status_    = 'факт':U
     3899     AND ub.trn-doc.doc-type   = 'при':U
     3900     , EACH  ub.doc-line NO-LOCK WHERE
     3901     ub.doc-line.doc-code = ub.trn-doc.doc-code
     3902     , FIRST t-2                 WHERE
     3903     t-2.artic     = ub.doc-line.artic     AND
     3904     t-2.prod-type = ub.doc-line.prod-type AND
     3905     t-2.prod-code = ub.doc-line.prod-code
     3906     BREAK BY ub.doc-line.artic
     3907     BY ub.doc-line.prod-type
     3908     BY ub.doc-line.prod-code
     3909     by ub.trn-doc.cli-code
     3910     :
     3911     IF FIRST-OF( ub.doc-line.prod-code ) THEN ASSIGN loc-ii = 1.
     3912     FIND FIRST ub.clients NO-LOCK WHERE ub.clients.obj-type = ub.trn-doc.cli-type AND ub.clients.obj-code = ub.trn-doc.cli-code NO-ERROR.
     3913     ASSIGN
     3914       for-supp-name = ( IF AVAILABLE ub.clients THEN ub.clients.obj-name ELSE "":U ) .
     3915     FIND FIRST ub.inv-line NO-LOCK WHERE
     3916       ub.inv-line.doc-code  = ub.doc-line.doc-code  AND
     3917       ub.inv-line.artic     = ub.doc-line.artic     AND
     3918       ub.inv-line.prod-type = ub.doc-line.prod-type AND
     3919       ub.inv-line.prod-code = ub.doc-line.prod-code NO-ERROR.
     3920   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input ub.trn-doc.doc-code ,
     3921                           input 'nids':U ,
     3922                          output v-attr-value ,
     3923                          output v-attr-type )  .
     3924     if v-attr-value <> "" then v-doc-code = v-attr-value .
     3925     else v-doc-code       = ub.trn-doc.doc-code .
     3926   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input ub.trn-doc.doc-code ,
     3927                           input 'is-fuel':U ,
     3928                          output v-value ,
     3929                          output v-type ) no-error .
     3930     if v-value <> "yes" then
     3931     do:
     3932       CREATE tincome-2.
     3933       assign
     3934         tincome-2.gds-code     = t-2.gds-code
     3935         tincome-2.supp-name    = for-supp-name
     3936         tincome-2.supp-type    = ub.trn-doc.cli-type
     3937         tincome-2.supp-code    = ub.trn-doc.cli-code
     3938         tincome-2.doc-code     = v-doc-code
     3939         tincome-2.doc-code-trn = ub.trn-doc.doc-code
     3940         tincome-2.qnty2        = ( IF AVAILABLE ub.inv-line THEN ub.inv-line.wast-cli-qnty ELSE 0 )
     3941         tincome-2.qnty3        = ub.doc-line.cli-qnty
     3942         tincome-2.temperature  = ub.doc-line.temperature
     3943         tincome-2.density      = ( IF tincome-2.qnty2 / ub.doc-line.fact-qnty = ? THEN 0 ELSE tincome-2.qnty2 / ub.doc-line.fact-qnty )
     3944         tincome-2.naturalloss  = 0
     3945         tincome-2.is-fact      = YES
     3946         tincome-2.ii           = loc-ii.
     3947       if is-sug(t-2.gds-code) then tincome-2.qnty1       = ub.doc-line.fact-qnty * tincome-2.density .
     3948       else tincome-2.qnty1       = ub.doc-line.fact-qnty .
     3949       assign
     3950         loc-ii  = loc-ii + 1
     3951         v-qnty1 = v-qnty1 + tincome-2.qnty1
     3952         v-qnty2 = v-qnty2 + tincome-2.qnty2
     3953         v-qnty3 = v-qnty3 + tincome-2.qnty3
     3954         .
     3955     end.
     3956     else
     3957     do:
     3958       v-InfoSectionsTotal:Initialization(ub.trn-doc.doc-code, t-2.gds-code).
     3959       v-InfoSectionsTotal:GetDBAllAttr().
     3960       do iNum = 1 to v-InfoSectionsTotal:SectionNum:
     3961         v-InfoSectionsTotal:GetInfoSectionProp(iNum).
     3962         CREATE tincome-2.
     3963         assign
     3964           tincome-2.gds-code     = t-2.gds-code
     3965           tincome-2.supp-name    = if iNum = 1 then for-supp-name else ""
     3966           tincome-2.supp-type    = ub.trn-doc.cli-type
     3967           tincome-2.supp-code    = ub.trn-doc.cli-code
     3968           tincome-2.doc-code     = v-doc-code + "/" + v-InfoSectionsTotal:InfoSectionCurr:SectionName
     3969           tincome-2.doc-code-trn = ub.trn-doc.doc-code
     3970           tincome-2.qnty1       = v-InfoSectionsTotal:InfoSectionCurr:DocQnty
     3971           tincome-2.qnty3        = ub.doc-line.cli-qnty
     3972           tincome-2.qnty2        = ( IF AVAILABLE ub.inv-line THEN (v-InfoSectionsTotal:InfoSectionCurr:DocQnty * v-InfoSectionsTotal:InfoSectionCurr:DocDensity) ELSE 0 )
     3973           tincome-2.temperature  = v-InfoSectionsTotal:GetInfoSectionProp(iNum):DensTemp
     3974           tincome-2.density      = ( IF tincome-2.qnty2 / tincome-2.qnty1 = ? THEN 0 ELSE tincome-2.qnty2 / tincome-2.qnty1 )
     3975           tincome-2.naturalloss  = v-InfoSectionsTotal:InfoSectionCurr:NaturalLoss
     3976           tincome-2.is-fact      = YES
     3977           tincome-2.ii           = loc-ii
     3978           loc-ii                 = loc-ii + 1.
     3979         if is-sug(t-2.gds-code) then tincome-2.qnty1       = ub.doc-line.fact-qnty * tincome-2.density .
     3980         else tincome-2.qnty1       = v-InfoSectionsTotal:InfoSectionCurr:DocQnty .
     3981         if is-gas(t-2.gds-code)
     3982         then
     3983         assign
     3984           tincome-2.qnty1 = ub.doc-line.fact-qnty
     3985           tincome-2.qnty2 = ub.doc-line.doc-qnty
     3986         .
     3987         v-qnty1               = v-qnty1 + tincome-2.qnty1 .
     3988         v-qnty2               = v-qnty2 + tincome-2.qnty2 .
     3989         v-qnty3               = v-qnty3 + tincome-2.qnty3
     3990           .
     3991       end.
     3992     end.
     3993     if last-of(ub.trn-doc.cli-code) then
     3994     do:
     3995       if pshift-date <> pshift-date1 or (pshift-date = pshift-date1 and pshift-num <> pshift-num1) then
     3996       do:
     3997         CREATE tincome-2.
     3998         ASSIGN
     3999           tincome-2.gds-code    = t-2.gds-code
     4000           tincome-2.supp-name   = "Итого по поставщику"
     4001           tincome-2.supp-type   = ub.trn-doc.cli-type
     4002           tincome-2.supp-code   = ub.trn-doc.cli-code
     4003           tincome-2.qnty1       = v-qnty1
     4004           tincome-2.qnty2       = v-qnty2
     4005           tincome-2.qnty3       = v-qnty3
     4006           tincome-2.temperature = ?
     4007           tincome-2.density     = ?
     4008           tincome-2.is-fact     = no
     4009           tincome-2.ii          = loc-ii
     4010           loc-ii                = loc-ii + 1
     4011           v-qnty1               = 0
     4012           v-qnty2               = 0
     4013           v-qnty3               = 0
     4014           .
     4015       end.
     4016     end.
     4017   END.
     4018   FOR EACH t-2 NO-LOCK :
     4019     ASSIGN
     4020       acc-other-found = NO
     4021       acc-other-qnty1 = 0
     4022       acc-other-qnty2 = 0
     4023       acc-other-netto = 0
     4024       .
     4025     FOR EACH ub.clients-attr WHERE ub.clients-attr.attr-code  = 'shftrep2':U AND ub.clients-attr.attr-value = "yes":U :
     4026       ASSIGN
     4027         current-cli      = ub.clients-attr.obj-code
     4028         current-cli-type = ub.clients-attr.obj-type
     4029         .
     4030       FIND FIRST ub.clients NO-LOCK WHERE ub.clients.obj-type = current-cli-type AND ub.clients.obj-code = current-cli NO-ERROR.
     4031       IF AVAILABLE ub.clients THEN
     4032       DO:
     4033         RUN ot-lnrv IN THIS-PROCEDURE (  INPUT       pobj-type
     4034           ,  INPUT       pobj-code
     4035           ,  INPUT       current-cli-type
     4036           ,  INPUT       current-cli
     4037           ,  INPUT       t-2.artic
     4038           ,  INPUT       t-2.prod-type
     4039           ,  INPUT       t-2.prod-code
     4040           ,  INPUT       prev-fo
     4041           ,  INPUT       fo
     4042           ,  INPUT       'sale':U
     4043           ,  INPUT       ?
     4044           , OUTPUT TABLE tt-ot-line        ) NO-ERROR.
     4045         IF NOT ERROR-STATUS :ERROR THEN
     4046         DO:
     4047           ASSIGN
     4048             acc-cli-qnty1 = 0
     4049             acc-cli-qnty2 = 0
     4050             acc-cli-netto = 0
     4051             acc-cli-found = NO
     4052             .
     4053           FOR EACH tt-ot-line NO-LOCK WHERE
     4054             tt-ot-line.cli-type  = current-cli-type AND
     4055             tt-ot-line.cli-code  = current-cli      AND
     4056             tt-ot-line.artic     = t-2.artic        AND
     4057             tt-ot-line.prod-type = t-2.prod-type    AND
     4058             tt-ot-line.prod-code = t-2.prod-code    :
     4059             IF tt-ot-line.ext-doc-type <> 'ie':U THEN
     4060             DO:
     4061               ASSIGN
     4062                 acc-cli-found = YES
     4063                 acc-cli-qnty1 = acc-cli-qnty1 + tt-ot-line.fact-qnty
     4064                 acc-cli-netto = acc-cli-netto + tt-ot-line.sum-base
     4065                 .
     4066               FOR EACH  buf_doc-line NO-LOCK WHERE
     4067                 buf_doc-line.obj-type      = tt-ot-line.obj-type     AND
     4068                 buf_doc-line.obj-code      = tt-ot-line.obj-code     AND
     4069                 buf_doc-line.prod-type     = tt-ot-line.prod-type    AND
     4070                 buf_doc-line.prod-code     = tt-ot-line.prod-code    AND
     4071                 buf_doc-line.artic         = tt-ot-line.artic        AND
     4072                 buf_doc-line.ext-doc-type  = tt-ot-line.ext-doc-type AND
     4073                 buf_doc-line.status_       = 'факт':U                 AND
     4074                 buf_doc-line.fact-order   >= prev-fo                 AND
     4075                 buf_doc-line.fact-order   <= fo
     4076                 , FIRST buf_trn-doc  NO-LOCK WHERE
     4077                 buf_trn-doc.doc-code = buf_doc-line.doc-code AND
     4078                 buf_trn-doc.cli-type = current-cli-type      AND
     4079                 buf_trn-doc.cli-code = current-cli
     4080                 :
     4081                 IF tt-ot-line.ext-doc-type = 'vt':U or tt-ot-line.ext-doc-type = 'vp':U THEN
     4082                 DO:
     4083                   ASSIGN
     4084                     acc-cli-qnty2 = acc-cli-qnty2 + ( IF buf_doc-line.cli-qnty = ? THEN 0 ELSE buf_doc-line.cli-qnty ).
     4085                 END.
     4086                 ELSE
     4087                 DO:
     4088                   FIND FIRST buf_inv-line NO-LOCK WHERE
     4089                     buf_inv-line.doc-code  = buf_doc-line.doc-code  AND
     4090                     buf_inv-line.artic     = buf_doc-line.artic     AND
     4091                     buf_inv-line.prod-type = buf_doc-line.prod-type AND
     4092                     buf_inv-line.prod-code = buf_doc-line.prod-code NO-ERROR.
     4093                   ASSIGN
     4094                     acc-cli-qnty2 = acc-cli-qnty2 + ( IF AVAILABLE buf_inv-line THEN ( IF buf_inv-line.wast-cli-qnty = ? THEN 0 ELSE ( - buf_inv-line.wast-cli-qnty ) ) ELSE 0 ).
     4095                 END.
     4096               END.
     4097             END.
     4098           END.
     4099           IF acc-cli-found = YES THEN
     4100           DO:
     4101             RUN create-treal-2 IN THIS-PROCEDURE ( INPUT t-2.gds-code,
     4102               INPUT -2,
     4103               INPUT p-base-code,
     4104               INPUT - acc-cli-qnty1,
     4105               INPUT - acc-cli-qnty2,
     4106               INPUT - acc-cli-netto,
     4107               INPUT ub.clients.obj-name,
     4108               INPUT NO,
     4109               INPUT ?                    ) NO-ERROR.
     4110           END.
     4111         END.
     4112       END.
     4113     END.
     4114     FOR EACH  ub.trn-doc NO-LOCK WHERE
     4115       ub.trn-doc.obj-type     = pobj-type          AND
     4116       ub.trn-doc.obj-code     = pobj-code          AND
     4117       ub.trn-doc.fact-order >= prev-fo             and
     4118       ub.trn-doc.fact-order <= fo                  and
     4119       ub.trn-doc.internal     = NO                 AND
     4120       ub.trn-doc.status_      = 'факт':U            AND
     4121       ub.trn-doc.ext-doc-type = 'vt':U       OR
     4122       ub.trn-doc.obj-type     = pobj-type          AND
     4123       ub.trn-doc.obj-code     = pobj-code          AND
     4124       ub.trn-doc.fact-order >= prev-fo             and
     4125       ub.trn-doc.fact-order <= fo                  and
     4126       ub.trn-doc.internal     = NO                 AND
     4127       ub.trn-doc.status_      = 'факт':U            AND
     4128       ub.trn-doc.ext-doc-type = 'vp':U
     4129       , FIRST ub.doc-line NO-LOCK WHERE
     4130       ub.doc-line.doc-code  = ub.trn-doc.doc-code AND
     4131       ub.doc-line.artic     = t-2.artic           AND
     4132       ub.doc-line.prod-type = t-2.prod-type       AND
     4133       ub.doc-line.prod-code = t-2.prod-code
     4134       :
     4135       RUN clntattr-value IN THIS-PROCEDURE (  INPUT ub.trn-doc.cli-type, INPUT ub.trn-doc.cli-code, INPUT 'shftrep2':U, OUTPUT v-attr-value, OUTPUT v-attr-type).
     4136       IF v-attr-value = "no":U THEN
     4137       DO:
     4138         RUN clcprtsl_calc-line IN THIS-PROCEDURE ( INPUT RECID( ub.doc-line ) ).
     4139         FIND FIRST tt-allsum-line NO-LOCK WHERE tt-allsum-line.sum-type = 'основная_сумма':U NO-ERROR.
     4140         ASSIGN
     4141           v-sum-base = ( IF AVAILABLE tt-allsum-line THEN tt-allsum-line.sum-dsc-base-doc ELSE 0.0 ).
     4142         RUN create-treal-2 IN THIS-PROCEDURE ( INPUT t-2.gds-code
     4143           , INPUT -4
     4144           , INPUT 0
     4145           , INPUT - ub.doc-line.fact-qnty
     4146           , INPUT - ub.doc-line.cli-qnty
     4147           , INPUT - v-sum-base
     4148           , INPUT "Инвентаризация"
     4149           , INPUT NO
     4150           , INPUT ?                          ) NO-ERROR.
     4151       END.
     4152     END.
     4153     FOR EACH  ub.trn-doc NO-LOCK WHERE
     4154       ub.trn-doc.obj-type     = pobj-type          AND
     4155       ub.trn-doc.obj-code     = pobj-code          AND
     4156       ub.trn-doc.fact-order >= prev-fo             and
     4157       ub.trn-doc.fact-order <= fo                  and
     4158       ub.trn-doc.internal     = NO                 AND
     4159       ub.trn-doc.status_      = 'факт':U            AND
     4160       ub.trn-doc.ext-doc-type = 'ee':U
     4161       , FIRST ub.doc-line NO-LOCK WHERE
     4162       ub.doc-line.doc-code  = ub.trn-doc.doc-code AND
     4163       ub.doc-line.artic     = t-2.artic           AND
     4164       ub.doc-line.prod-type = t-2.prod-type       AND
     4165       ub.doc-line.prod-code = t-2.prod-code
     4166       :
     4167       RUN clntattr-value IN THIS-PROCEDURE ( INPUT ub.trn-doc.cli-type , INPUT ub.trn-doc.cli-code, INPUT 'shftrep2':U, OUTPUT v-attr-value, OUTPUT v-attr-type ).
     4168       IF v-attr-value = "no":U THEN
     4169       DO:
     4170         RUN clcprtsl_calc-line IN THIS-PROCEDURE ( INPUT RECID( ub.doc-line ) ).
     4171         FIND FIRST tt-allsum-line NO-LOCK WHERE tt-allsum-line.sum-type = 'основная_сумма':U NO-ERROR.
     4172         ASSIGN
     4173           v-sum-base = ( IF AVAILABLE tt-allsum-line THEN tt-allsum-line.sum-dsc-base-doc ELSE 0.0 ).
     4174         FIND FIRST ub.inv-line NO-LOCK WHERE
     4175           ub.inv-line.doc-code  = ub.doc-line.doc-code  AND
     4176           ub.inv-line.artic     = ub.doc-line.artic     AND
     4177           ub.inv-line.prod-type = ub.doc-line.prod-type AND
     4178           ub.inv-line.prod-code = ub.doc-line.prod-code NO-ERROR.
     4179         RUN create-treal-2 IN THIS-PROCEDURE ( INPUT t-2.gds-code
     4180           , INPUT -3
     4181           , INPUT 0
     4182           , INPUT ub.doc-line.fact-qnty
     4183           , INPUT ( IF AVAILABLE ub.inv-line THEN ub.inv-line.wast-cli-qnty ELSE 0 )
     4184           , INPUT v-sum-base
     4185           , INPUT "Отпуск без ККМ"
     4186           , INPUT NO
     4187           , INPUT ?                          ) NO-ERROR.
     4188       END.
     4189     END.
     4190     FOR EACH  ub.trn-doc NO-LOCK WHERE
     4191       ( ub.trn-doc.obj-type     = pobj-type         AND
     4192       ub.trn-doc.obj-code     = pobj-code          AND
     4193       ub.trn-doc.fact-order >= prev-fo             and
     4194       ub.trn-doc.fact-order <= fo                  and
     4195       ub.trn-doc.status_      = 'факт':U            AND
     4196       ub.trn-doc.ext-doc-type = 'ev':U ) OR
     4197       ( ub.trn-doc.obj-type     = pobj-type          AND
     4198       ub.trn-doc.obj-code     = pobj-code          AND
     4199       ub.trn-doc.fact-order >= prev-fo             and
     4200       ub.trn-doc.fact-order <= fo                  and
     4201       ub.trn-doc.status_      = 'факт':U            AND
     4202       ub.trn-doc.ext-doc-type = 'eo':U )
     4203       , FIRST ub.doc-line NO-LOCK WHERE
     4204       ub.doc-line.doc-code  = ub.trn-doc.doc-code AND
     4205       ub.doc-line.artic     = t-2.artic           AND
     4206       ub.doc-line.prod-type = t-2.prod-type       AND
     4207       ub.doc-line.prod-code = t-2.prod-code
     4208       :
     4209       RUN clntattr-value IN THIS-PROCEDURE ( INPUT ub.trn-doc.cli-type , INPUT ub.trn-doc.cli-code, INPUT 'shftrep2':U, OUTPUT v-attr-value, OUTPUT v-attr-type ).
     4210       IF v-attr-value = "no":U THEN
     4211       DO:
     4212         RUN clcprtsl_calc-line IN THIS-PROCEDURE ( INPUT RECID( ub.doc-line ) ).
     4213         FIND FIRST tt-allsum-line NO-LOCK WHERE tt-allsum-line.sum-type = 'основная_сумма':U NO-ERROR.
     4214         ASSIGN
     4215           v-sum-base = ( IF AVAILABLE tt-allsum-line THEN tt-allsum-line.sum-dsc-base-doc ELSE 0.0 ).
     4216         FIND FIRST ub.inv-line NO-LOCK WHERE
     4217           ub.inv-line.doc-code  = ub.doc-line.doc-code  AND
     4218           ub.inv-line.artic     = ub.doc-line.artic     AND
     4219           ub.inv-line.prod-type = ub.doc-line.prod-type AND
     4220           ub.inv-line.prod-code = ub.doc-line.prod-code NO-ERROR.
     4221         RUN create-treal-2 IN THIS-PROCEDURE ( INPUT t-2.gds-code
     4222           , INPUT -5
     4223           , INPUT 0
     4224           , INPUT ub.doc-line.fact-qnty
     4225           , INPUT ( IF AVAILABLE ub.inv-line THEN ub.inv-line.wast-cli-qnty ELSE 0 )
     4226           , INPUT v-sum-base
     4227           , INPUT "Расход внутр."
     4228           , INPUT NO
     4229           , INPUT ?                          ) NO-ERROR.
     4230       END.
     4231     END.
     4232     _trn-doc:
     4233     FOR EACH  ub.trn-doc NO-LOCK WHERE
     4234       ub.trn-doc.obj-type     = pobj-type              AND
     4235       ub.trn-doc.obj-code     = pobj-code              AND
     4236       ub.trn-doc.fact-order >= prev-fo             and
     4237       ub.trn-doc.fact-order <= fo                  and
     4238       ub.trn-doc.internal     = NO                     AND
     4239       ub.trn-doc.status_      = 'факт':U                AND
     4240       (  ub.trn-doc.ext-doc-type = 'we':U     OR
     4241       ub.trn-doc.ext-doc-type = 're':U OR
     4242       ub.trn-doc.ext-doc-type = 'ep':U    )
     4243       , FIRST ub.doc-line NO-LOCK WHERE
     4244       ub.doc-line.doc-code  = ub.trn-doc.doc-code AND
     4245       ub.doc-line.artic     = t-2.artic           AND
     4246       ub.doc-line.prod-type = t-2.prod-type       AND
     4247       ub.doc-line.prod-code = t-2.prod-code
     4248       :
     4249       if ub.trn-doc.ext-doc-type = 'we':U then
     4250       do:
     4251         RUN clntattr-value IN THIS-PROCEDURE (  INPUT ub.trn-doc.cli-type, INPUT ub.trn-doc.cli-code, INPUT 'shftrep2':U, OUTPUT v-attr-value, OUTPUT v-attr-type ).
     4252         if v-attr-value = "yes" then NEXT.
     4253       end.
     4254       RUN clcprtsl_calc-line IN THIS-PROCEDURE ( INPUT RECID( ub.doc-line ) ).
     4255       FIND FIRST tt-allsum-line NO-LOCK WHERE tt-allsum-line.sum-type = 'основная_сумма':U NO-ERROR.
     4256       ASSIGN
     4257         v-sum-base      = ( IF AVAILABLE tt-allsum-line THEN tt-allsum-line.sum-dsc-base-doc ELSE 0.0 )
     4258         acc-other-qnty1 = acc-other-qnty1 + ( IF ub.trn-doc.ext-doc-type = 're':U THEN ( - ub.doc-line.fact-qnty ) ELSE ub.doc-line.fact-qnty )
     4259         acc-other-netto = acc-other-netto + v-sum-base
     4260         acc-other-found = YES
     4261         .
     4262       FIND FIRST ub.inv-line NO-LOCK WHERE
     4263         ub.inv-line.doc-code  = ub.doc-line.doc-code  AND
     4264         ub.inv-line.artic     = ub.doc-line.artic     AND
     4265         ub.inv-line.prod-type = ub.doc-line.prod-type AND
     4266         ub.inv-line.prod-code = ub.doc-line.prod-code NO-ERROR.
     4267       IF AVAILABLE ub.inv-line THEN
     4268       DO:
     4269         ASSIGN
     4270           acc-other-qnty2 = acc-other-qnty2 + ( IF ub.trn-doc.ext-doc-type = 're':U THEN ( - ub.inv-line.wast-cli-qnty ) ELSE ub.inv-line.wast-cli-qnty ).
     4271       END.
     4272     END.
     4273     IF acc-other-found = YES THEN
     4274     DO:
     4275       RUN create-treal-2 IN THIS-PROCEDURE ( INPUT t-2.gds-code
     4276         , INPUT -1
     4277         , INPUT 0
     4278         , INPUT acc-other-qnty1
     4279         , INPUT acc-other-qnty2
     4280         , INPUT v-sum-base
     4281         , INPUT "Проч докум.расход"
     4282         , INPUT NO
     4283         , INPUT ?                   ) NO-ERROR.
     4284     END.
     4285   END.
