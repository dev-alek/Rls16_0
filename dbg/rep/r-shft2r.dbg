     2600     (input  bf_trn-doc.obj-type
     2601     ,input  bf_trn-doc.obj-code
     2602     ,input  varb-code
     2603     ,input  0
     2604     ,input  bf_trn-doc.fact-order
     2605     ,output vardoc-num
     2606     ,output varprice-sale
     2607     ,output varroad-tax
     2608     ,output varexcise
     2609     )  .
     2610             if varprice-sale = ?
     2611             then do:
     2612               assign
     2613                 varprice-sale = 0
     2614                 varroad-tax   = 0
     2615                 varexcise     = 0
     2616               .
     2617             end.
     2618             assign
     2619               varlastcur-base     = varprice-sale
     2620               varlastcur-road-tax = varroad-tax
     2621               varlastcur-excise   = varexcise
     2622               varcur-base         = varcur-base      + varprice-sale * bf_gds-dtl.fact-qnty
     2623               varcur-road-tax     = varcur-road-tax  + varroad-tax   * bf_gds-dtl.fact-qnty
     2624               varcur-excise       = varcur-excise    + varexcise     * bf_gds-dtl.fact-qnty
     2625               varcur-fact-qnty    = varcur-fact-qnty + bf_gds-dtl.fact-qnty
     2626             .
     2627         end.
     2628       end.
     2629       if varcur-fact-qnty = 0 then do:
     2630         assign
     2631           varcur-base      = varlastcur-base
     2632           varcur-road-tax  = varlastcur-road-tax
     2633           varcur-excise    = varlastcur-excise
     2634         .
     2635       end.
     2636       else do:
     2637         assign
     2638           varcur-base      = varcur-base      / varcur-fact-qnty
     2639           varcur-road-tax  = varcur-road-tax  / varcur-fact-qnty
     2640           varcur-excise    = varcur-excise    / varcur-fact-qnty
     2641         .
     2642       end.
     2643       if varcur-vat-pc = ?
     2644       then do:
     2645         return error substitute ("Нет текущего продажного НДС по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     2646       end.
     2647       if varcur-slt-pc = ?
     2648       then do:
     2649         return error substitute ("Нет текущего продажного НП по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     2650       end.
     2651       find first bf_sysconf where bf_sysconf.host-code = bf_trn-doc.host-code no-lock.
     2652       assign
