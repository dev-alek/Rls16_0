      153   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      154     define temp-table tt-ot-line no-undo like ub.ot-line
      155     field cli-type like ub.clients.obj-type
      156     field cli-code like ub.clients.obj-code
