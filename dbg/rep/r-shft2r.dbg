     2278       bfsacc_tt-allsum.dsc-cli-acc         = bfs_tt-allsum.dsc-cli-acc
     2279       bfsacc_tt-allsum.vat-base-acc        = bfs_tt-allsum.vat-base-acc
     2280       bfsacc_tt-allsum.vat-rubl-acc        = bfs_tt-allsum.vat-rubl-acc
     2281       bfsacc_tt-allsum.vat-cli-acc         = bfs_tt-allsum.vat-cli-acc
     2282       bfsacc_tt-allsum.slt-base-acc        = bfs_tt-allsum.slt-base-acc
     2283       bfsacc_tt-allsum.slt-rubl-acc        = bfs_tt-allsum.slt-rubl-acc
     2284       bfsacc_tt-allsum.slt-cli-acc         = bfs_tt-allsum.slt-cli-acc
     2285       bfsacc_tt-allsum.excise-base-acc     = bfs_tt-allsum.excise-base-acc
     2286       bfsacc_tt-allsum.excise-rubl-acc     = bfs_tt-allsum.excise-rubl-acc
     2287       bfsacc_tt-allsum.excise-cli-acc      = bfs_tt-allsum.excise-cli-acc
     2288       bfsacc_tt-allsum.road-tax-base-acc   = bfs_tt-allsum.road-tax-base-acc
     2289       bfsacc_tt-allsum.road-tax-rubl-acc   = bfs_tt-allsum.road-tax-rubl-acc
     2290       bfsacc_tt-allsum.road-tax-cli-acc    = bfs_tt-allsum.road-tax-cli-acc
     2291       bfsacc_tt-allsum.transport-base-acc  = bfs_tt-allsum.transport-base-acc
     2292       bfsacc_tt-allsum.transport-rubl-acc  = bfs_tt-allsum.transport-rubl-acc
     2293       bfsacc_tt-allsum.transport-cli-acc   = bfs_tt-allsum.transport-cli-acc
     2294       bfsacc_tt-allsum.other-base-acc      = bfs_tt-allsum.other-base-acc
     2295       bfsacc_tt-allsum.other-rubl-acc      = bfs_tt-allsum.other-rubl-acc
     2296       bfsacc_tt-allsum.other-cli-acc       = bfs_tt-allsum.other-cli-acc
     2297       .
     2298   end.
     2299   otherwise do:
     2300     return error substitute ("Неизвестный тип приобретения &1 по партии с кодом &2 по документу &3, порожденную документом &4 по товару &5 &6 &7.",
     2301                              cl_tt-clcparts.purch-code,
     2302                              cl_tt-clcparts.part-code,
     2303                              cl_tt-clcparts.out-code,
     2304                              cl_tt-clcparts.in-code,
     2305                              cl_tt-clcparts.artic,
     2306                              cl_tt-clcparts.prod-type,
     2307                              cl_tt-clcparts.prod-code).
     2308   end.
     2309   end case.
     2310   end.
     2311   end procedure.
     2312   procedure clcprtsl_calc-line :
     2313   define input  parameter parrec-line as recid no-undo.
     2314   define variable v-tax-date         as   date                     no-undo.
     2315   define variable v-vat-pc           like ub.doc-line.vat-pc       no-undo.
     2316   define variable varr-b             as   character                no-undo.
     2317   define variable varr-btype         as   character                no-undo.
     2318   define variable varcur-base        like ub.gds-dtl.price-base    no-undo.
     2319   define variable varcur-road-tax    like ub.doc-line.road-tax     no-undo.
     2320   define variable varcur-excise      like ub.doc-line.excise       no-undo.
     2321   define variable varcur-vat-pc      like ub.doc-line.vat-pc       no-undo.
     2322   define variable varcur-cons-vat-pc like ub.doc-line.cons-vat-pc  no-undo.
     2323   define variable varcur-slt-pc      like ub.doc-line.slt-pc       no-undo.
     2324   define variable varcur-fact-qnty   like ub.gds-dtl.fact-qnty     no-undo.
     2325   define variable varb-code          like ub.bar-code.b-code       no-undo.
     2326   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     2327   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     2328   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     2329   define variable varexcise          like ub.price-list.excise     no-undo.
     2330   define variable varlastcur-base        like ub.gds-dtl.price-base no-undo.
     2331   define variable varlastcur-road-tax    like ub.gds-dtl.price-base no-undo.
     2332   define variable varlastcur-excise      like ub.gds-dtl.price-base     no-undo.
     2333   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     2334   define variable v-varsum           as decimal                  no-undo.
     2335   define variable varprice-salef as decimal   no-undo .
     2336   define buffer bf_trn-doc             for ub.trn-doc.
     2337   define buffer bf_doc-line            for ub.doc-line.
     2338   define buffer bf_gds-dtl             for ub.gds-dtl.
     2339   define buffer bf_goods               for ub.goods.
     2340   define buffer bf_parts               for ub.parts.
     2341   define buffer bf_sysconf             for ub.sysconf.
     2342   define buffer bf_tt-allsum-line      for tt-allsum-line.
     2343   define buffer bfs_tt-allsum-line     for tt-allsum-line.
     2344   define buffer bfo_tt-allsum-line     for tt-allsum-line.
     2345   define buffer bfos_tt-allsum-line    for tt-allsum-line.
     2346   define buffer buf_parts        for ub.parts.
     2347   v-calcbypart = no.
     2348   do on error undo, return error return-value :
     2349   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2350   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2351     (output varr-b
     2352     )  .
     2353     find first bf_doc-line where recid (bf_doc-line) = parrec-line no-lock.
     2354     find first bf_trn-doc where bf_trn-doc.doc-code = bf_doc-line.doc-code no-lock.
     2355     find first bf_goods where bf_goods.artic     = bf_doc-line.artic     and
     2356                               bf_goods.prod-type = bf_doc-line.prod-type and
     2357                               bf_goods.prod-code = bf_doc-line.prod-code no-lock.
     2358     if bf_trn-doc.fact-date <> ?        then do:
     2359       assign v-tax-date = bf_trn-doc.fact-date.
     2360     end.
     2361     else do:
     2362       assign v-tax-date = ?.
     2363     end.
     2364   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2365   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     2366     (input  bf_goods.gds-code
     2367     ,input  '1':U
     2368     ,input  v-tax-date
     2369     ,input  bf_trn-doc.host-code
     2370     ,input  bf_trn-doc.obj-type
     2371     ,input  bf_trn-doc.obj-code
     2372     ,output v-vat-pc
     2373     ) no-error .
     2374     if error-status :error
     2375     or v-vat-pc = ? then do:
     2376        return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     2377     end.
     2378     if bf_goods.gds-type = 'у':U or
     2379        bf_trn-doc.status_ = 'запрос':U then do:
     2380       for each bf_tt-allsum-line
     2381       on error undo, return error return-value
     2382        :
     2383         delete bf_tt-allsum-line.
     2384       end.
     2385       create bf_tt-allsum-line.
     2386       assign
     2387        bf_tt-allsum-line.sum-type = 'основная_сумма':U.
     2388       for each bf_gds-dtl where bf_gds-dtl.doc-code  = bf_doc-line.doc-code  and
     2389                                 bf_gds-dtl.artic     = bf_doc-line.artic     and
     2390                                 bf_gds-dtl.prod-type = bf_doc-line.prod-type and
     2391                                 bf_gds-dtl.prod-code = bf_doc-line.prod-code no-lock on error undo, return error return-value :
     2392         assign
     2393           bf_tt-allsum-line.fact-qnty            =  bf_tt-allsum-line.fact-qnty        + bf_gds-dtl.fact-qnty
     2394           bf_tt-allsum-line.sum-dsc-base-doc     =  bf_tt-allsum-line.sum-dsc-base-doc + (bf_gds-dtl.price-base - bf_gds-dtl.discnt-base) * bf_gds-dtl.fact-qnty
     2395           bf_tt-allsum-line.sum-dsc-rubl-doc     =  bf_tt-allsum-line.sum-dsc-rubl-doc + (bf_gds-dtl.price-rubl - bf_gds-dtl.discnt-rubl) * bf_gds-dtl.fact-qnty
     2396           bf_tt-allsum-line.dsc-base-doc         =  bf_tt-allsum-line.dsc-base-doc     + bf_gds-dtl.discnt-base * bf_gds-dtl.fact-qnty
     2397           bf_tt-allsum-line.dsc-rubl-doc         =  bf_tt-allsum-line.dsc-rubl-doc     + bf_gds-dtl.discnt-rubl * bf_gds-dtl.fact-qnty
     2398           bf_tt-allsum-line.sum-dsc-base-cur     =  bf_tt-allsum-line.sum-dsc-base-cur + (if varr-b = "base" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base / bf_trn-doc.exch-rate * bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     2399           bf_tt-allsum-line.sum-dsc-rubl-cur     =  bf_tt-allsum-line.sum-dsc-rubl-cur + (if varr-b = "rubl" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base * bf_trn-doc.exch-rate / bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     2400           bf_tt-allsum-line.sum-dsc-base-acc     =  bf_tt-allsum-line.sum-dsc-base-acc + bf_doc-line.price-base * bf_gds-dtl.fact-qnty
     2401           bf_tt-allsum-line.sum-dsc-rubl-acc     =  bf_tt-allsum-line.sum-dsc-rubl-acc + bf_doc-line.price-rubl * bf_gds-dtl.fact-qnty
     2402           bf_tt-allsum-line.sum-dsc-cli-acc      =  ?
     2403           bf_tt-allsum-line.vat-base-acc         =  bf_tt-allsum-line.vat-base-acc     + bf_doc-line.price-base * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     2404           bf_tt-allsum-line.vat-rubl-acc         =  bf_tt-allsum-line.vat-rubl-acc     + bf_doc-line.price-rubl * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     2405           bf_tt-allsum-line.vat-cli-acc          =  ?
     2406           .
     2407       end.
     2408       assign
     2409         bf_tt-allsum-line.cli-qnty             =  ?
     2410         bf_tt-allsum-line.slt-base-doc         =  bf_tt-allsum-line.sum-dsc-base-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     2411         bf_tt-allsum-line.slt-rubl-doc         =  bf_tt-allsum-line.sum-dsc-rubl-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     2412         bf_tt-allsum-line.vat-base-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-base-doc - bf_tt-allsum-line.slt-base-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     2413         bf_tt-allsum-line.vat-rubl-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-rubl-doc - bf_tt-allsum-line.slt-rubl-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     2414         bf_tt-allsum-line.road-tax-base-doc    =  0
     2415         bf_tt-allsum-line.road-tax-rubl-doc    =  0
     2416         bf_tt-allsum-line.excise-base-doc      =  0
     2417         bf_tt-allsum-line.excise-rubl-doc      =  0
     2418         bf_tt-allsum-line.vat-base-doc         =  bf_tt-allsum-line.vat-base-buyer-doc
     2419         bf_tt-allsum-line.vat-rubl-doc         =  bf_tt-allsum-line.vat-rubl-buyer-doc
     2420         bf_tt-allsum-line.dsc-base-cur         =  0
     2421         bf_tt-allsum-line.dsc-rubl-cur         =  0
     2422         bf_tt-allsum-line.slt-base-cur         =  bf_tt-allsum-line.sum-dsc-base-cur * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     2423         bf_tt-allsum-line.slt-rubl-cur         =  bf_tt-allsum-line.sum-dsc-rubl-cur * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     2424         bf_tt-allsum-line.vat-base-buyer-cur   =  (bf_tt-allsum-line.sum-dsc-base-cur - bf_tt-allsum-line.slt-base-cur) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     2425         bf_tt-allsum-line.vat-rubl-buyer-cur   =  (bf_tt-allsum-line.sum-dsc-rubl-cur - bf_tt-allsum-line.slt-rubl-cur) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     2426         bf_tt-allsum-line.road-tax-base-cur    =  0
     2427         bf_tt-allsum-line.road-tax-rubl-cur    =  0
     2428         bf_tt-allsum-line.excise-base-cur      =  0
     2429         bf_tt-allsum-line.excise-rubl-cur      =  0
     2430         bf_tt-allsum-line.vat-base-cur         =  bf_tt-allsum-line.vat-base-buyer-cur
     2431         bf_tt-allsum-line.vat-rubl-cur         =  bf_tt-allsum-line.vat-rubl-buyer-cur
     2432         bf_tt-allsum-line.dsc-base-acc         =  0
     2433         bf_tt-allsum-line.dsc-rubl-acc         =  0
     2434         bf_tt-allsum-line.dsc-cli-acc          =  0
     2435         bf_tt-allsum-line.slt-base-acc         =  0
     2436         bf_tt-allsum-line.slt-rubl-acc         =  0
     2437         bf_tt-allsum-line.slt-cli-acc          =  0
     2438         bf_tt-allsum-line.road-tax-base-acc    =  0
     2439         bf_tt-allsum-line.road-tax-rubl-acc    =  0
     2440         bf_tt-allsum-line.road-tax-cli-acc     =  0
     2441         bf_tt-allsum-line.excise-base-acc      =  0
     2442         bf_tt-allsum-line.excise-rubl-acc      =  0
     2443         bf_tt-allsum-line.excise-cli-acc       =  0
     2444         bf_tt-allsum-line.transport-base-acc   =  0
     2445         bf_tt-allsum-line.transport-rubl-acc   =  0
     2446         bf_tt-allsum-line.transport-cli-acc    =  0
     2447         bf_tt-allsum-line.other-base-acc       =  0
     2448         bf_tt-allsum-line.other-rubl-acc       =  0
     2449         bf_tt-allsum-line.other-cli-acc        =  0
     2450         .
     2451       create bfs_tt-allsum-line.
     2452       assign
     2453       bfs_tt-allsum-line.sum-type = 'основная_сумма_со_знаком':U.
     2454       if bf_trn-doc.doc-type = 'инв':U or
     2455          bf_trn-doc.doc-type = 'при':U    or
     2456          bf_trn-doc.doc-type = 'возврат':U    then do:
     2457          buffer-copy bf_tt-allsum-line except bf_tt-allsum-line.sum-type to bfs_tt-allsum-line.
     2458       end.
     2459       else do:
     2460         assign
     2461           bfs_tt-allsum-line.fact-qnty           =  - bf_tt-allsum-line.fact-qnty
     2462           bfs_tt-allsum-line.cli-qnty            =  - bf_tt-allsum-line.cli-qnty
     2463           bfs_tt-allsum-line.sum-dsc-base-doc    =  - bf_tt-allsum-line.sum-dsc-base-doc
     2464           bfs_tt-allsum-line.sum-dsc-rubl-doc    =  - bf_tt-allsum-line.sum-dsc-rubl-doc
     2465           bfs_tt-allsum-line.dsc-base-doc        =  - bf_tt-allsum-line.dsc-base-doc
     2466           bfs_tt-allsum-line.dsc-rubl-doc        =  - bf_tt-allsum-line.dsc-rubl-doc
     2467           bfs_tt-allsum-line.vat-base-doc        =  - bf_tt-allsum-line.vat-base-doc
     2468           bfs_tt-allsum-line.vat-rubl-doc        =  - bf_tt-allsum-line.vat-rubl-doc
     2469           bfs_tt-allsum-line.vat-base-buyer-doc  =  - bf_tt-allsum-line.vat-base-buyer-doc
     2470           bfs_tt-allsum-line.vat-rubl-buyer-doc  =  - bf_tt-allsum-line.vat-rubl-buyer-doc
     2471           bfs_tt-allsum-line.slt-base-doc        =  - bf_tt-allsum-line.slt-base-doc
     2472           bfs_tt-allsum-line.slt-rubl-doc        =  - bf_tt-allsum-line.slt-rubl-doc
     2473           bfs_tt-allsum-line.road-tax-base-doc   =  - bf_tt-allsum-line.road-tax-base-doc
     2474           bfs_tt-allsum-line.road-tax-rubl-doc   =  - bf_tt-allsum-line.road-tax-rubl-doc
     2475           bfs_tt-allsum-line.excise-base-doc     =  - bf_tt-allsum-line.excise-base-doc
     2476           bfs_tt-allsum-line.excise-rubl-doc     =  - bf_tt-allsum-line.excise-rubl-doc
     2477           bfs_tt-allsum-line.sum-dsc-base-cur    =  - bf_tt-allsum-line.sum-dsc-base-cur
     2478           bfs_tt-allsum-line.sum-dsc-rubl-cur    =  - bf_tt-allsum-line.sum-dsc-rubl-cur
     2479           bfs_tt-allsum-line.dsc-base-cur        =  - bf_tt-allsum-line.dsc-base-cur
     2480           bfs_tt-allsum-line.dsc-rubl-cur        =  - bf_tt-allsum-line.dsc-rubl-cur
     2481           bfs_tt-allsum-line.vat-base-cur        =  - bf_tt-allsum-line.vat-base-cur
     2482           bfs_tt-allsum-line.vat-rubl-cur        =  - bf_tt-allsum-line.vat-rubl-cur
     2483           bfs_tt-allsum-line.vat-base-buyer-cur  =  - bf_tt-allsum-line.vat-base-buyer-cur
     2484           bfs_tt-allsum-line.vat-rubl-buyer-cur  =  - bf_tt-allsum-line.vat-rubl-buyer-cur
     2485           bfs_tt-allsum-line.slt-base-cur        =  - bf_tt-allsum-line.slt-base-cur
     2486           bfs_tt-allsum-line.slt-rubl-cur        =  - bf_tt-allsum-line.slt-rubl-cur
     2487           bfs_tt-allsum-line.road-tax-base-cur   =  - bf_tt-allsum-line.road-tax-base-cur
     2488           bfs_tt-allsum-line.road-tax-rubl-cur   =  - bf_tt-allsum-line.road-tax-rubl-cur
     2489           bfs_tt-allsum-line.excise-base-cur     =  - bf_tt-allsum-line.excise-base-cur
     2490           bfs_tt-allsum-line.excise-rubl-cur     =  - bf_tt-allsum-line.excise-rubl-cur
     2491           bfs_tt-allsum-line.sum-dsc-base-acc    =  - bf_tt-allsum-line.sum-dsc-base-acc
     2492           bfs_tt-allsum-line.sum-dsc-rubl-acc    =  - bf_tt-allsum-line.sum-dsc-rubl-acc
     2493           bfs_tt-allsum-line.sum-dsc-cli-acc     =  - bf_tt-allsum-line.sum-dsc-cli-acc
     2494           bfs_tt-allsum-line.dsc-base-acc        =  - bf_tt-allsum-line.dsc-base-acc
     2495           bfs_tt-allsum-line.dsc-rubl-acc        =  - bf_tt-allsum-line.dsc-rubl-acc
     2496           bfs_tt-allsum-line.dsc-cli-acc         =  - bf_tt-allsum-line.dsc-cli-acc
     2497           bfs_tt-allsum-line.vat-base-acc        =  - bf_tt-allsum-line.vat-base-acc
     2498           bfs_tt-allsum-line.vat-rubl-acc        =  - bf_tt-allsum-line.vat-rubl-acc
     2499           bfs_tt-allsum-line.vat-cli-acc         =  - bf_tt-allsum-line.vat-cli-acc
     2500           bfs_tt-allsum-line.slt-base-acc        =  - bf_tt-allsum-line.slt-base-acc
     2501           bfs_tt-allsum-line.slt-rubl-acc        =  - bf_tt-allsum-line.slt-rubl-acc
     2502           bfs_tt-allsum-line.slt-cli-acc         =  - bf_tt-allsum-line.slt-cli-acc
     2503           bfs_tt-allsum-line.road-tax-base-acc   =  - bf_tt-allsum-line.road-tax-base-acc
     2504           bfs_tt-allsum-line.road-tax-rubl-acc   =  - bf_tt-allsum-line.road-tax-rubl-acc
     2505           bfs_tt-allsum-line.road-tax-cli-acc    =  - bf_tt-allsum-line.road-tax-cli-acc
     2506           bfs_tt-allsum-line.excise-base-acc     =  - bf_tt-allsum-line.excise-base-acc
     2507           bfs_tt-allsum-line.excise-rubl-acc     =  - bf_tt-allsum-line.excise-rubl-acc
     2508           bfs_tt-allsum-line.excise-cli-acc      =  - bf_tt-allsum-line.excise-cli-acc
     2509           bfs_tt-allsum-line.transport-base-acc  =  - bf_tt-allsum-line.transport-base-acc
     2510           bfs_tt-allsum-line.transport-rubl-acc  =  - bf_tt-allsum-line.transport-rubl-acc
     2511           bfs_tt-allsum-line.transport-cli-acc   =  - bf_tt-allsum-line.transport-cli-acc
     2512           bfs_tt-allsum-line.other-base-acc      =  - bf_tt-allsum-line.other-base-acc
     2513           bfs_tt-allsum-line.other-rubl-acc      =  - bf_tt-allsum-line.other-rubl-acc
