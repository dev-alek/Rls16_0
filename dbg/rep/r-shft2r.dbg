     2885   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2886   PROCEDURE create-treal-2.
     2887   DEFINE INPUT PARAMETER pgds-code like ub.goods.gds-code no-undo.
     2888   DEFINE INPUT PARAMETER pcpay-code like ub.cash-pay.cdpay-code no-undo.
     2889   DEFINE INPUT PARAMETER pcurr-code like ub.cash-pay.curr-code no-undo.
     2890   DEFINE INPUT PARAMETER pqnty1 as decimal no-undo.
     2891   DEFINE INPUT PARAMETER pqnty2 as decimal no-undo.
     2892   DEFINE INPUT PARAMETER pnetto as decimal no-undo.
     2893   DEFINE INPUT PARAMETER pout-name as character no-undo.
     2894   DEFINE INPUT PARAMETER pis-pay as logical no-undo.
     2895   DEFINE INPUT PARAMETER pii as integer no-undo.
     2896   _main:
     2897   DO ON ERROR UNDO _main, return error:
     2898       create treal-2.
     2899       assign
     2900       treal-2.gds-code = pgds-code
     2901       treal-2.cpay-code = pcpay-code
     2902       treal-2.curr-code = pcurr-code
     2903       treal-2.qnty1  =  pqnty1
     2904       treal-2.qnty2  = pqnty2
     2905       treal-2.netto = pnetto
     2906       treal-2.out-name = pout-name
     2907       treal-2.is-pay = pis-pay
     2908       treal-2.ii = pii
     2909       treal-2.discnt-type = -99
     2910       no-error
     2911       .
     2912       if error-status:error then undo _main, return error.
     2913   END.
     2914   END PROCEDURE.
     2915   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2916   procedure ot-lnrv:
     2917   define input  parameter parobj-type         like ub.clients.obj-type    no-undo.
     2918   define input  parameter parobj-code         like ub.clients.obj-code    no-undo.
     2919   define input  parameter parcli-type         like ub.clients.obj-type    no-undo.
     2920   define input  parameter parcli-code         like ub.clients.obj-code    no-undo.
     2921   define input  parameter parartic            like ub.goods.artic         no-undo.
     2922   define input  parameter parprod-type        like ub.goods.prod-type     no-undo.
     2923   define input  parameter parprod-code        like ub.goods.prod-code     no-undo.
     2924   define input  parameter parfact-order-start like ub.ot-line.fact-order no-undo.
     2925   define input  parameter parfact-order-end   like ub.ot-line.fact-order no-undo.
     2926   define input  parameter parsum-type         like ub.ot-line.sum-type   no-undo.
     2927   define input  parameter parcat-id           like ub.ot-line.cat-id     no-undo.
     2928   define output parameter table for tt-ot-line.
     2929   define variable varext-doc-type like ub.ot-line.ext-doc-type no-undo.
     2930     FOR EACH ub.ot-line No-LOCK WHERE
     2931               ub.ot-line.obj-type = parobj-type AND
     2932               ub.ot-line.obj-code = parobj-code AND
     2933               ub.ot-line.artic = parartic AND
     2934               ub.ot-line.prod-type = parprod-type AND
     2935               ub.ot-line.prod-code = parprod-code AND
     2936               ub.ot-line.fact-order >= parfact-order-start AND
     2937               ub.ot-line.fact-order <= parfact-order-end AND
     2938               ub.ot-line.sum-type = parsum-type AND
     2939               (parcat-id = ? OR ub.ot-line.cat-id = parcat-id),
     2940         FIRST ub.trn-doc where
     2941               ub.trn-doc.doc-code = ub.ot-line.doc-code AND
     2942               ub.trn-doc.cli-type = parcli-type AND
     2943               ub.trn-doc.cli-code = parcli-code:
     2944       FIND FIRST tt-ot-line where
     2945                   tt-ot-line.obj-type       = parobj-type AND
     2946                   tt-ot-line.obj-code       = parobj-code AND
     2947                   tt-ot-line.artic          = parartic AND
     2948                   tt-ot-line.prod-type      = parprod-type AND
     2949                   tt-ot-line.prod-code      = parprod-code AND
     2950                   tt-ot-line.fact-order     = 0 AND
     2951                   tt-ot-line.sum-type       = parsum-type AND
     2952                   tt-ot-line.cat-id         = parcat-id AND
     2953                   tt-ot-line.ext-doc-type   = ub.ot-line.ext-doc-type AND
     2954                   tt-ot-line.cli-type       = parcli-type AND
     2955                   tt-ot-line.cli-code       = parcli-code
     2956                   No-ERROR.
     2957       IF NOT AVAIL tt-ot-line  then do:
     2958         create tt-ot-line.
     2959         assign
     2960         tt-ot-line.obj-type       = parobj-type
     2961         tt-ot-line.obj-code       = parobj-code
     2962         tt-ot-line.artic          = parartic
     2963         tt-ot-line.prod-type      = parprod-type
     2964         tt-ot-line.prod-code      = parprod-code
     2965         tt-ot-line.cli-type       = parcli-type
     2966         tt-ot-line.cli-code       = parcli-code
     2967         tt-ot-line.sum-type       = parsum-type
     2968         tt-ot-line.cat-id         = parcat-id
     2969         tt-ot-line.ext-doc-type   = ub.ot-line.ext-doc-type
     2970         .
     2971       end.
     2972       assign
     2973       tt-ot-line.fact-qnty      = tt-ot-line.fact-qnty + ub.ot-line.fact-qnty
     2974       tt-ot-line.sum-base       = tt-ot-line.sum-base + ub.ot-line.sum-base
     2975       tt-ot-line.sum-rubl       = tt-ot-line.sum-rubl + ub.ot-line.sum-rubl
     2976       tt-ot-line.SLT-base       = tt-ot-line.SLT-base + ub.ot-line.SLT-base
     2977       tt-ot-line.SLT-rubl       = tt-ot-line.SLT-rubl + ub.ot-line.SLT-rubl
     2978       tt-ot-line.VAT-base       = tt-ot-line.VAT-base + ub.ot-line.VAT-base
     2979       tt-ot-line.VAT-rubl       = tt-ot-line.VAT-rubl + ub.ot-line.VAT-rubl
     2980       tt-ot-line.excise-base    = tt-ot-line.excise-base + ub.ot-line.excise-base
     2981       tt-ot-line.excise-rubl    = tt-ot-line.excise-rubl + ub.ot-line.excise-rubl
     2982       tt-ot-line.other-base     = tt-ot-line.other-base + ub.ot-line.other-base
     2983       tt-ot-line.other-rubl     = tt-ot-line.other-rubl + ub.ot-line.other-rubl
     2984       tt-ot-line.road-tax-base  = tt-ot-line.road-tax-base + ub.ot-line.road-tax-base
     2985       tt-ot-line.road-tax-rubl  = tt-ot-line.road-tax-rubl + ub.ot-line.road-tax-rubl
     2986       tt-ot-line.transport-base = tt-ot-line.transport-base + ub.ot-line.transport-base
     2987       tt-ot-line.transport-rubl = tt-ot-line.transport-rubl + ub.ot-line.transport-rubl
     2988       .
     2989      end.
     2990   end procedure.
