     2738   end.
     2739   procedure clcprtsl_calc-ttable :
     2740   define input parameter paris-doc           as   logical                 no-undo.
     2741   define input parameter paris-cur           as   logical                 no-undo.
     2742   define input parameter parroad-tax         like ub.doc-line.road-tax    no-undo.
     2743   define input parameter parexcise           like ub.doc-line.excise      no-undo.
     2744   define input parameter parvat-pc           like ub.doc-line.vat-pc      no-undo.
     2745   define input parameter parcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     2746   define input parameter parslt-pc           like ub.doc-line.slt-pc      no-undo.
     2747   define input parameter parbase-rate        like ub.trn-doc.base-rate    no-undo.
     2748   define input parameter parbase-scale       like ub.trn-doc.base-scale   no-undo.
     2749   define input parameter parr-b              as   character               no-undo.
     2750   define input parameter parcur-base         like ub.gds-dtl.cur-base     no-undo.
     2751   define input parameter parcur-road-tax     like ub.doc-line.road-tax    no-undo.
     2752   define input parameter parcur-excise       like ub.doc-line.excise      no-undo.
     2753   define input parameter parcur-vat-pc       like ub.doc-line.vat-pc      no-undo.
     2754   define input parameter parcurcons-vat-pc   like ub.doc-line.cons-vat-pc no-undo.
     2755   define input parameter parcurslt-pc        like ub.doc-line.slt-pc      no-undo.
     2756   define buffer bf_tt-allsum      for tt-allsum.
     2757   define buffer bf_tt-clcparts    for tt-clcparts.
     2758   define buffer bf_tt-allsum-line for tt-allsum-line.
     2759   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     2760   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     2761   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     2762   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     2763   define variable varexcise          like ub.price-list.excise     no-undo.
     2764   do on error undo, return error return-value :
     2765   for each bf_tt-allsum-line
     2766   on error undo, return error return-value
     2767    :
     2768     delete bf_tt-allsum-line.
     2769   end.
     2770   for each bf_tt-allsum
     2771   on error undo, return error return-value
     2772   :
     2773     delete bf_tt-allsum.
     2774   end.
     2775   for each bf_tt-clcparts
     2776   on error undo, return error return-value
     2777   :
     2778   if v-calcbypart then do:
     2779             assign
     2780             parcur-base =   bf_tt-clcparts.part-cur-base
     2781             parcur-road-tax = bf_tt-clcparts.part-cur-road-tax
     2782             parcur-excise =   bf_tt-clcparts.part-cur-excise
     2783             .
     2784   end.
     2785      run clcprtsl_calc-parts in this-procedure (
     2786        input recid(bf_tt-clcparts),
     2787        input paris-doc,
     2788        input paris-cur,
     2789        input parroad-tax,
     2790        input parexcise,
     2791        input parvat-pc,
     2792        input parcons-vat-pc,
     2793        input parslt-pc,
     2794        input parbase-rate,
     2795        input parbase-scale,
     2796        input parr-b,
     2797        input parcur-base,
     2798        input parcur-road-tax,
     2799        input parcur-excise,
     2800        input parcur-vat-pc,
     2801        input parcurcons-vat-pc,
     2802        input parcurslt-pc
     2803        ) no-error.
     2804     if error-status:error then do:
     2805       message
     2806         vss-workfile vss-revision vss-description skip
     2807         vss-include-info7 skip
     2808         "Ошибка при обсчете партии" skip
     2809         "Документ партии " bf_tt-clcparts.out-code skip
     2810         "Товар" bf_tt-clcparts.artic bf_tt-clcparts.prod-type bf_tt-clcparts.prod-code skip
     2811         return-value skip
     2812         error-status:get-message(1) skip
     2813         error-status:get-message(2) skip
     2814         error-status:get-message(3) skip
     2815         view-as alert-box error .
     2816       undo, return error .
     2817     end.
     2818     for each bf_tt-allsum on error undo, return error return-value :
     2819       find first bf_tt-allsum-line where bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type no-error.
     2820       if not available bf_tt-allsum-line then do:
     2821         create bf_tt-allsum-line.
     2822         assign
     2823           bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type.
     2824       end.
     2825       assign
     2826         bf_tt-allsum-line.fact-qnty              = bf_tt-allsum-line.fact-qnty            + bf_tt-allsum.fact-qnty
     2827         bf_tt-allsum-line.cli-qnty               = bf_tt-allsum-line.cli-qnty             + bf_tt-allsum.cli-qnty
     2828         bf_tt-allsum-line.sum-dsc-base-doc       = bf_tt-allsum-line.sum-dsc-base-doc     + bf_tt-allsum.sum-dsc-base-doc
     2829         bf_tt-allsum-line.sum-dsc-rubl-doc       = bf_tt-allsum-line.sum-dsc-rubl-doc     + bf_tt-allsum.sum-dsc-rubl-doc
     2830         bf_tt-allsum-line.dsc-base-doc           = bf_tt-allsum-line.dsc-base-doc         + bf_tt-allsum.dsc-base-doc
     2831         bf_tt-allsum-line.dsc-rubl-doc           = bf_tt-allsum-line.dsc-rubl-doc         + bf_tt-allsum.dsc-rubl-doc
     2832         bf_tt-allsum-line.vat-base-doc           = bf_tt-allsum-line.vat-base-doc         + bf_tt-allsum.vat-base-doc
     2833         bf_tt-allsum-line.vat-rubl-doc           = bf_tt-allsum-line.vat-rubl-doc         + bf_tt-allsum.vat-rubl-doc
     2834         bf_tt-allsum-line.vat-base-buyer-doc     = bf_tt-allsum-line.vat-base-buyer-doc   + bf_tt-allsum.vat-base-buyer-doc
     2835         bf_tt-allsum-line.vat-rubl-buyer-doc     = bf_tt-allsum-line.vat-rubl-buyer-doc   + bf_tt-allsum.vat-rubl-buyer-doc
     2836         bf_tt-allsum-line.slt-base-doc           = bf_tt-allsum-line.slt-base-doc         + bf_tt-allsum.slt-base-doc
     2837         bf_tt-allsum-line.slt-rubl-doc           = bf_tt-allsum-line.slt-rubl-doc         + bf_tt-allsum.slt-rubl-doc
     2838         bf_tt-allsum-line.road-tax-base-doc      = bf_tt-allsum-line.road-tax-base-doc    + bf_tt-allsum.road-tax-base-doc
     2839         bf_tt-allsum-line.road-tax-rubl-doc      = bf_tt-allsum-line.road-tax-rubl-doc    + bf_tt-allsum.road-tax-rubl-doc
     2840         bf_tt-allsum-line.excise-base-doc        = bf_tt-allsum-line.excise-base-doc      + bf_tt-allsum.excise-base-doc
     2841         bf_tt-allsum-line.excise-rubl-doc        = bf_tt-allsum-line.excise-rubl-doc      + bf_tt-allsum.excise-rubl-doc
     2842         bf_tt-allsum-line.sum-dsc-base-cur       = bf_tt-allsum-line.sum-dsc-base-cur     + bf_tt-allsum.sum-dsc-base-cur
     2843         bf_tt-allsum-line.sum-dsc-rubl-cur       = bf_tt-allsum-line.sum-dsc-rubl-cur     + bf_tt-allsum.sum-dsc-rubl-cur
     2844         bf_tt-allsum-line.dsc-base-cur           = bf_tt-allsum-line.dsc-base-cur         + bf_tt-allsum.dsc-base-cur
     2845         bf_tt-allsum-line.dsc-rubl-cur           = bf_tt-allsum-line.dsc-rubl-cur         + bf_tt-allsum.dsc-rubl-cur
     2846         bf_tt-allsum-line.vat-base-cur           = bf_tt-allsum-line.vat-base-cur         + bf_tt-allsum.vat-base-cur
     2847         bf_tt-allsum-line.vat-rubl-cur           = bf_tt-allsum-line.vat-rubl-cur         + bf_tt-allsum.vat-rubl-cur
     2848         bf_tt-allsum-line.vat-base-buyer-cur     = bf_tt-allsum-line.vat-base-buyer-cur   + bf_tt-allsum.vat-base-buyer-cur
     2849         bf_tt-allsum-line.vat-rubl-buyer-cur     = bf_tt-allsum-line.vat-rubl-buyer-cur   + bf_tt-allsum.vat-rubl-buyer-cur
     2850         bf_tt-allsum-line.slt-base-cur           = bf_tt-allsum-line.slt-base-cur         + bf_tt-allsum.slt-base-cur
     2851         bf_tt-allsum-line.slt-rubl-cur           = bf_tt-allsum-line.slt-rubl-cur         + bf_tt-allsum.slt-rubl-cur
     2852         bf_tt-allsum-line.road-tax-base-cur      = bf_tt-allsum-line.road-tax-base-cur    + bf_tt-allsum.road-tax-base-cur
     2853         bf_tt-allsum-line.road-tax-rubl-cur      = bf_tt-allsum-line.road-tax-rubl-cur    + bf_tt-allsum.road-tax-rubl-cur
     2854         bf_tt-allsum-line.excise-base-cur        = bf_tt-allsum-line.excise-base-cur      + bf_tt-allsum.excise-base-cur
