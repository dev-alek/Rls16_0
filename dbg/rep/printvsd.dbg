        1   block-level on error undo, throw.
        2   DEFINE VARIABLE vss-revision AS CHARACTER NO-UNDO INIT "$Revision: 41c4ffaaf087, 1404, rls $":U .
        3   DEFINE VARIABLE vss-author      AS CHARACTER NO-UNDO INIT "$Author: DARuban $":U .
        4   DEFINE VARIABLE vss-date        AS CHARACTER NO-UNDO INIT "$Date: Thu Jun 28 15:24:34 2018 +0300 $":U .
        5   DEFINE VARIABLE vss-workfile    AS CHARACTER NO-UNDO INIT "$Workfile: printvsd.p $":U .
        6   DEFINE VARIABLE vss-archive     AS CHARACTER NO-UNDO INIT "$Archive: rep/printvsd.p $":U .
        7   DEFINE VARIABLE vss-description AS CHARACTER NO-UNDO INIT "Отчет ВСД".
        8   DEFINE TEMP-TABLE t-obj-list NO-UNDO
        9       FIELD obj-type  AS CHARACTER
       10       FIELD obj-code  AS INTEGER
       11       FIELD host-code AS INTEGER
       12       INDEX pi IS UNIQUE PRIMARY obj-type  obj-code
       13       INDEX firm                 host-code.
       14   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       15   define  temp-table tt-gds-list no-undo like ub.goods
       16     field qnty   as decimal
       17     field to-del as logical
       18     field order-num as integer
       19     field to-sel as logical
       20     field promo-code as character
       21     field ActionId  as int64
       22     field db-num as integer
       23     index art  is primary unique artic prod-type prod-code
       24     index code is         unique gds-code
       25     index oi order-num
       26     index isel to-sel
       27     .
       28   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       29   define    temp-table tt-gds-list-hist no-undo
       30   field list-table as character
       31   field id as integer
       32   field line as integer
       33   field hist-mode as character
       34   field des as character
       35   field num-recs as integer
       36   field option_ as character
       37   field item_ as character
       38   field status_ as character
       39   field num-add as integer
       40   field num-ignored as integer
       41   field done as logical
       42   field err_ as logical
       43   field err-mes as character
       44   index pi is primary
       45   id
       46   line
       47   index isdone
       48   done
       49   .
       50   DEFINE TEMP-TABLE tt-vsd-filt NO-UNDO
       51   FIELD date-end AS DATE
       52   FIELD date-start AS DATE
       53   FIELD fTime  AS INTEGER
       54   FIELD FalExting AS LOGICAL
       55   FIELD FalVerif  AS LOGICAL
       56   FIELD Rep       AS LOGICAL
       57   FIELD ReqVerif  AS LOGICAL
       58   FIELD ToExtin   AS LOGICAL
       59   FIELD Sent      AS LOGICAL
       60   FIELD doc-code  AS CHARACTER
       61   .
       62   DEFINE DATASET ds-vsd-set
       63   FOR tt-vsd-filt, t-obj-list,  tt-gds-list .
       64   DEFINE TEMP-TABLE ttvsd NO-UNDO LIKE ub.vsd
       65           FIELD dateTTH     AS DATE
       66           FIELD NomTTH      AS CHAR
       67           FIELD NomTTHpost  AS CHAR
       68           FIELD NomAZS      AS CHAR
       69           FIELD Post        AS CHAR
       70           FIELD artic       AS CHAR
       71           FIELD gdsname     AS CHAR
       72           FIELD prod-code   AS CHAR
       73           FIELD COLobj      AS DEC
       74           FIELD unit-cli    AS CHAR
       75           FIELD unit-base   AS CHAR
       76           FIELD statusvsd   AS CHAR
       77           FIELD ojd         AS DEC
       78           FIELD gdsmercguid AS CHAR
       79           FIELD vsdtypelbl  AS CHAR
       80           FIELD vsdsubs     AS CLASS Progress.Lang.Object.
       81   DEFINE INPUT PARAMETER parparentproc AS WIDGET-HANDLE NO-UNDO .
       82   DEFINE INPUT PARAMETER p-date-start         AS DATE       NO-UNDO .
       83   DEFINE INPUT PARAMETER p-date-end           AS DATE       NO-UNDO .
       84   DEFINE INPUT PARAMETER  TABLE FOR  ttvsd.
       85   procedure vss-get-info :
       86     define output parameter p-vss-revision    like vss-revision    no-undo .
       87     define output parameter p-vss-author      like vss-author      no-undo .
       88     define output parameter p-vss-date        like vss-date        no-undo .
       89     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       90     define output parameter p-vss-archive     like vss-archive     no-undo .
       91     define output parameter p-vss-description like vss-description no-undo .
       92     assign
       93       p-vss-revision    = vss-revision
       94       p-vss-author      = vss-author
       95       p-vss-date        = vss-date
       96       p-vss-workfile    = vss-workfile
       97       p-vss-archive     = vss-archive
       98       p-vss-description = vss-description
       99     .
      100   end procedure.
      101   procedure vss-get-parameters :
      102     define output parameter p-vss-parameters as character no-undo .
      103   end procedure.
      104   define new global shared variable g#vssrevis-logger as handle    no-undo .
      105   define variable v-vssrevis-logevent                 as logical   no-undo init false .
      106   define variable v-vssrevis-logger                   as handle    no-undo .
      107   procedure vss-logevent :
      108     define input  parameter p-extra-paramters as character no-undo .
      109     define variable v-vssrevis-parameters as character no-undo .
      110     do
      111     on error undo, return error return-value
      112     :
      113       if  valid-handle(v-vssrevis-logger)
      114       and v-vssrevis-logger :get-signature("logevent") <> ""
      115       then do:
      116         run vss-get-parameters in this-procedure
      117           (output v-vssrevis-parameters
      118           ).
      119         run logevent in v-vssrevis-logger
      120           (input vss-workfile
      121           ,input vss-revision
      122           ,input v-vssrevis-parameters
      123           ,input p-extra-paramters
      124           ).
      125       end.
      126     end.
      127   end procedure.
      128   assign
      129     v-vssrevis-logger = g#vssrevis-logger
      130   .
      131   if  valid-handle(v-vssrevis-logger)
      132   and v-vssrevis-logger :get-signature("logevent") <> ""
      133   then do:
      134     assign
      135       v-vssrevis-logevent = true
      136     .
      137     run vss-logevent in this-procedure (input vss-description) .
      138   end.
      139   define new global shared variable g#language as character no-undo .
      140   if g#language <> '' and g#language <> 'rus':U then do:
      141     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      142   end.
      143   define new global shared variable g#library  as handle no-undo .
      144   define new global shared variable g#library2 as handle no-undo .
      145   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      146   define  stream PrnLibStream.
      147   procedure prn-lib-prn-file :
      148     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      149     define input parameter p-DIsabledoptions as integer no-undo .
      150     define variable v-report-name as character no-undo .
      151     define variable v-user-action as character no-undo .
      152     define variable v-printed     as logical   no-undo .
      153     define variable v-exist       as logical   no-undo .
      154     do
      155       on error undo, return error
      156       :
      157       run prn-lib-get-report-name  in this-procedure (
      158         input parParentProc
      159         ,output v-report-name
      160         ).
      161   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      162   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      163     (input  v-report-name
      164     ,input  2
      165     ,output v-exist
      166     )  .
      167       if NOT v-exist then
      168       DO:
      169         Message
      170           "Нет заданий на печать ! "
      171           view-as alert-box .
      172         Return  .
      173       End.
      174       run gbl/prnfilen.w
      175         (input  ""
      176         ,input  p-DisabledOptions
      177         ,input  string(v-report-name )
      178         ,input  7
      179         ,output v-user-action
      180         ,output v-printed
      181         ) .
      182       if v-printed then
      183       do:
      184         return "YES" .
      185       end.
      186       else
      187       do:
      188         return "NO" .
      189       end.
      190     end.
      191   end procedure.
      192   procedure prn-lib-open-stream :
      193     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      194     define input parameter p-page-size    as integer no-undo .
      195     define input parameter p-is-stream    as logical no-undo .
      196     define input parameter p-append       as logical no-undo .
      197     define variable v-report-name as character no-undo .
      198     do
      199       on error undo, return error
      200       :
      201       run prn-lib-get-report-name  in this-procedure (
      202         input parParentProc
      203         ,output v-report-name
      204         ).
      205       if p-is-stream then
      206       do:
      207         if p-append then
      208         do:
      209           output stream PrnLibStream to value( v-report-name )
      210             page-size value(p-page-size) append .
      211         end.
      212         if not p-append then
      213         do:
      214           output stream PrnLibStream to value( v-report-name )
      215             page-size value(p-page-size) .
      216         end.
      217       end.
      218       if not p-is-stream then
      219       do:
      220         if p-append then
      221         do:
      222           output to value( v-report-name )
      223             page-size value(p-page-size) append .
      224         end.
      225         if not p-append then
      226         do:
      227           output to value( v-report-name )
      228             page-size value(p-page-size) .
      229         end.
      230       end.
      231     end.
      232   end procedure.
      233   procedure prn-lib-open-exp :
      234     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      235     define input parameter p-is-stream    as logical no-undo .
      236     define input parameter p-is-append    as logical no-undo .
      237     define output parameter p-ReportFileName as char init "report" no-undo.
      238     define output parameter p-process as logical no-undo .
      239     define variable glog as logical no-undo .
      240     do
      241       on error undo, return error
      242       :
      243       SYSTEM-DIALOG GET-FILE p-ReportFileName
      244         TITLE      "Укажите путь"
      245         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      246         ASK-OVERWRITE
      247         CREATE-TEST-FILE
      248         SAVE-AS
      249         USE-FILENAME
      250         DEFAULT-EXTENSION "txt"
      251         UPDATE glog
      252         .
      253       if not glog then  return.
      254       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      255       if p-is-stream then
      256       do:
      257         if p-is-append then
      258         do:
      259           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      260         end.
      261         else
      262         do:
      263           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      264         end.
      265       end.
      266       else
      267       do:
      268         if p-is-append then
      269         do:
      270           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      271         end.
      272         else
      273         do:
      274           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      275         end.
      276       end.
      277       p-process = yes.
      278     end.
      279   end procedure.
      280   procedure prn-lib-get-report-name :
      281     define input parameter parParentProc  as widget-handle no-undo.
      282     define output parameter p-report-name as character no-undo .
      283     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      284   end procedure.
      285   procedure prn-lib-reportviewer-report-name :
      286     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      287     define input parameter p-report-name-html as character no-undo .
      288     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      289   end procedure.
      290   procedure prn-lib-reportviewer :
      291     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      292     define input parameter p-report-name-html as character no-undo .
      293     define input parameter p-param        as character no-undo .
      294     define variable v-excel           as character no-undo init 'TRUE' .
      295     define variable v-value-character as character no-undo .
      296     define variable v-value-integer   as character no-undo .
      297     define variable v-value-date      as date      no-undo .
      298     define variable v-value-decimal   as decimal   no-undo .
      299     define variable rep-excel         as logical   no-undo .
      300     define variable excel-string      as character no-undo .
      301     define variable v-param-type      as character no-undo .
      302     define variable v-tth             as handle    no-undo .
      303     run adm/shattri.p (
      304       input "get":U
      305       ,input  ""
      306       ,input  0
      307       ,input  'report-glob':U
      308       ,input  'rep-excel':U
      309       ,output v-value-character
      310       ,output v-value-date
      311       ,output v-value-decimal
      312       ,output v-value-integer
      313       ,output rep-excel
      314       ,output v-param-type
      315       ,INPUT-OUTPUT table-handle v-tth
      316       )  .
      317     if rep-excel then v-excel = "TRUE" .
      318     else v-excel = "FALSE" .
      319     if p-param eq ""
      320     then
      321        p-param = "EXCEL:" + v-excel.
      322     else
      323        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      324     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      325   end procedure.
      326   function fnc-convert-dot-to-colon returns character
      327       (input p-data as decimal, input p-accur as character, input p-num as integer) forward.
      328   function fnc-convert-dot-to-colon returns character
      329   (input p-data as decimal, input p-accur as character, input p-num as integer):
      330       define variable result as character no-undo.
      331       define variable v-str-result as character no-undo.
      332       if p-data = ? then p-data = 0 .
      333       p-data = round(p-data, p-num).
      334       v-str-result = trim(replace(string(p-data, p-accur), ".", ",")).
      335       return v-str-result.
      336   END FUNCTION.
      337   DEFINE VARIABLE v-report-name       AS CHARACTER NO-UNDO .
      338   DEFINE VARIABLE v-file-name-rep-htm AS CHARACTER NO-UNDO .
      339   DEFINE STREAM OutStr-html.
      340   DO:
      341       RUN prn-lib-get-report-name  IN this-procedure
      342       (INPUT parParentProc, OUTPUT v-report-name).
      343       v-file-name-rep-htm = v-report-name + ".html".
      344       OUTPUT stream OutStr-html to value(v-file-name-rep-htm) convert target 'UTF-8' .
      345       PUT STREAM OutStr-html UNFORMATTED
      346           "<!DOCTYPE HTML>"                                               SKIP
      347           '<html>'                                                        SKIP
      348           '<head>'                                                        SKIP
      349           '  <meta charset="utf-8">'                                      SKIP
      350           '  <style>'                                                     SKIP
      351           '      table ~{ '                                               SKIP
      352           '             border-collapse: collapse;'                       SKIP
      353           '             ~}'                                               SKIP
      354           '       tbody td, th ~{'                                        SKIP
      355           '                 border: 1px solid black;'                     SKIP
      356           '                    ~}'                                        SKIP
      357           '   </style>'                                                   SKIP
      358           '</head>'                                                       SKIP
      359           '<body>'                                                        SKIP
      360           '<TABLE name="1" fit_to_page="true" orientation="landscape">'   SKIP
      361           '<thead>'                                                       SKIP
      362           '  <tr>'                                SKIP
      363           '    <td style="width:  53px;"></td>'   SKIP
      364           '    <td style="width: 106px;"></td>'   SKIP
      365           '    <td style="width: 106px;"></td>'   SKIP
      366           '    <td style="width: 53px;"></td>'    SKIP
      367           '    <td style="width: 200px;"></td>'    SKIP
      368           '    <td style="width: 60px;"></td>'    SKIP
      369           '    <td style="width: 200px;"></td>'    SKIP
      370           '    <td style="width: 200px;"></td>'    SKIP
      371           '    <td style="width: 53px;"></td>'    SKIP
      372           '    <td style="width: 53px;"></td>'    SKIP
      373           '    <td style="width: 100px;"></td>'    SKIP
      374           '    <td style="width: 300px;"></td>'    SKIP
      375           '    <td style="width: 170px;"></td>'    SKIP
      376           '    <td style="width: 80px;"></td>'    SKIP
      377           '    <td style="width: 200px;"></td>'    SKIP
      378           '  </tr>'                               SKIP
      379           '  <tr>'                                                            SKIP
      380           '     <td colspan="13">Отчет с детализацией по накладным c ' + STRING (p-date-start, "99/99/9999")
      381           + " по " +  String(p-date-end,"99/99/9999") +
      382           '</td>'    SKIP
      383           '  </tr>'                                                           SKIP
      384           '</thead>'                                                          SKIP
      385           '<tbody>'                               SKIP
      386           '  <tr>'                                SKIP
      387           '    <th>Дата ТТН</th>'                 SKIP
      388           '    <th>Номер ТТН</th>'                SKIP
      389           '    <th>Номер ТТН поставщика</th>'     SKIP
      390           '    <th>№ АЗС</th>'                    SKIP
      391           '    <th>Поставщик</th>'                SKIP
      392           '    <th>Артикул товара</th>'           SKIP
      393           '    <th>Наименование товара</th>'      SKIP
      394           '    <th>Производитель</th>'            SKIP
      395           '    <th>Кол-во по ВСД</th>'            SKIP
      396           '    <th>Ед.изм.</th>'                  SKIP
      397           '    <th>Тип</th>'                      SKIP
      398           '    <th>Номер ВСД</th>'                SKIP
      399           '    <th>Статус ВСД</th>'               SKIP
      400           '    <th>Ожидает гашения (ч.)</th>'          SKIP
      401       '    <th>Описание ошибки</th>'          SKIP
      402           '  </tr>'                               SKIP
      403           .
      404           FOR EACH ttvsd:
      405               PUT STREAM OutStr-html UNFORMATTED
      406                   '  <tr>' SKIP
      407                   SUBSTITUTE('      <td>&1</td>',          STRING(ttvsd.dateTTH))              SKIP
      408                   SUBSTITUTE('      <td>&1</td>',                 ttvsd.NomTTH)                SKIP
      409                   SUBSTITUTE('      <td>&1</td>',                 ttvsd.NomTTHpost)            SKIP
      410                   SUBSTITUTE('      <td>&1</td>',                 ttvsd.NomAZS)                SKIP
      411                   SUBSTITUTE('      <td text_wrap="true">&1</td>',ttvsd.Post)                  SKIP
      412                   SUBSTITUTE('      <td>&1</td>',                 ttvsd.artic)                 SKIP
      413                   SUBSTITUTE('      <td text_wrap="true">&1</td>',ttvsd.gdsname)               SKIP
      414                   SUBSTITUTE('      <td text_wrap="true">&1</td>',ttvsd.prod-code)             SKIP
      415                   SUBSTITUTE('      <td>&1</td>',       trim( STRING(ttvsd.COLobj,">>>>>>9.999")))               SKIP
      416                   SUBSTITUTE('      <td num="0" val="&1">&1</td>',ttvsd.unit-cli)              SKIP
      417                   SUBSTITUTE('      <td text_wrap="true">&1</td>',ttvsd.vsdtypelbl )           SKIP
      418                   SUBSTITUTE('      <td>&1</td>',                 ttvsd.UUID)                  SKIP
      419                   SUBSTITUTE('      <td>&1</td>',                 ttvsd.statusvsd)             SKIP
      420                   SUBSTITUTE('      <td>&1</td>',                 ttvsd.ojd )                  SKIP
      421                   SUBSTITUTE('      <td text_wrap="true">&1</td>',ttvsd.msg-err )                 SKIP
      422               '</tr>' SKIP
      423               .
      424           END.
      425           PUT STREAM OutStr-html UNFORMATTED
      426           '</tbody>'              SKIP
      427           '<tfoot>' '</tfoot>'    SKIP
      428           '</table>'              SKIP
      429           '</body>'               SKIP
      430           '</html>'               SKIP
      431           .
      432       OUTPUT stream OutStr-html close.
      433       RUN prn-lib-reportviewer-report-name IN this-procedure
      434        (
      435           INPUT this-procedure
      436           ,INPUT v-file-name-rep-htm
      437           ).
      438   END.
