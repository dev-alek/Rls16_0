     3239          and out-vatp_doc-lineprl.artic      = varartic
     3240          and out-vatp_doc-lineprl.prod-type  = varprod-type
     3241          and out-vatp_doc-lineprl.prod-code  = varprod-code no-lock no-error.
     3242   if available out-vatp_doc-lineprl           and
     3243     (out-vatp_doc-lineprl.status_ = 'запрос':U or out-vatp_goodsprl.gds-type = 'у':U) then do:
     3244     assign
