     5595                                                           f-cost-pr   = if f-qnty = 0 then 0 else f-cost-sum / f-qnty
     5596                                                           f-sale-pr   = if f-qnty = 0 then 0 else f-sale-sum / f-qnty
     5597                                                           .
     5598                                           end.
     5599                                       f-sale-other = 100 * determined((f-sale-sum - f-cost-sum) / f-cost-sum).
