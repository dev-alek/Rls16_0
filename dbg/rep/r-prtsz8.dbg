     3204   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     3205   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     3206     (output varoutvprbprl
     3207     )  .
     3208   if varoutvprbprl = "base":u then do:
     3209     assign
     3210           road-tax-base-saleprl    =  (if varroad-tax = ? then 0 else varroad-tax * 1)
     3211       excise-base-saleprl      =  (if varexcise   = ? then 0 else varexcise   * 1)
     3212     .
     3213   end.
     3214   else do:
     3215     assign
     3216           road-tax-base-saleprl    =  (if varroad-tax = ? then 0 else varroad-tax / varbase-rate * varbase-scale)
     3217       excise-base-saleprl      =  (if varexcise   = ? then 0 else varexcise   / varbase-rate * varbase-scale)
     3218     .
     3219   end.
     3220   if varoutvprbprl = "rubl":u then do:
     3221     assign
     3222           road-tax-rubl-saleprl    = (if varroad-tax = ? then 0 else varroad-tax * 1)
     3223       excise-rubl-saleprl      = (if varexcise   = ? then 0 else varexcise   * 1) .
     3224   end.
     3225   else do:
     3226     assign
     3227           road-tax-rubl-saleprl    = (if varroad-tax = ? then 0 else varroad-tax * varbase-rate / varbase-scale)
     3228       excise-rubl-saleprl      = (if varexcise   = ? then 0 else varexcise   * varbase-rate / varbase-scale) .
     3229   end.
     3230   assign
     3231     varis-cons-parts-haveprl =  no.
     3232   assign
     3233     varfact-qntyprl       = 0
     3234     varcons-qntyprl       = 0
     3235     varprice-base-consprl = 0
     3236     varprice-rubl-consprl = 0.
