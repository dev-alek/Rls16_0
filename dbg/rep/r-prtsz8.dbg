     3369   price-rubl-without-tax-saleprl = price-rubl-with-tax-saleprl - vat-rubl-saleprl - slt-rubl-saleprl - road-tax-rubl-saleprl.
     3370     end.
     3371   end procedure.
     3372   define temp-table temp-font no-undo
     3373     field fontnum  as integer
     3374     field fontname as character
     3375     field fontsize as character
     3376     field fonttype as character
     3377     field font-h   as integer
     3378     field font-w   as integer
     3379     field v-row    as integer
     3380     field v-col    as integer
     3381     field v-row-lans as integer
     3382     field v-col-lans as integer
     3383   index pi fontnum
     3384   .
     3385   procedure get-font-ini :
     3386     do
     3387     on error undo, return error return-value
     3388     :
     3389   define variable ii as integer   no-undo .
     3390   define variable v-font7 as character no-undo .
     3391   define variable v-font as character no-undo .
     3392   define variable loc-name as character no-undo .
     3393   define variable loc-size as character no-undo .
     3394   define variable loc-type as character no-undo .
     3395   define variable old_H as integer   no-undo .
     3396   define variable old_w as integer   no-undo .
     3397   define variable old-row  as integer   no-undo .
     3398   define variable old-col  as integer   no-undo .
     3399   define variable old-row-lans  as integer   no-undo .
     3400   define variable old-col-lans  as integer   no-undo .
     3401   define variable vv as integer   no-undo .
     3402   empty temp-table temp-font.
     3403     GET-KEY-VALUE SECTION "fonts" KEY "font7" VALUE v-font7 .
     3404       case num-entries (v-font7) :
     3405         when 4 then do:
     3406             assign
     3407               loc-name = entry ( 1 , v-font7 )
     3408               loc-size = entry ( 2 , v-font7 )
     3409               loc-type = entry ( 3 , v-font7 ) + "," +  entry ( 4 , v-font7 )
     3410             .
     3411         end.
     3412         when 3 then do:
     3413             assign
     3414               loc-name = entry ( 1 , v-font7 )
     3415               loc-size = entry ( 2 , v-font7 )
     3416               loc-type = entry ( 3 , v-font7 )
     3417             .
     3418         end.
     3419         when 2 then  do:
     3420             assign
     3421               loc-name = entry ( 1 , v-font7 )
     3422               loc-size = entry ( 2 , v-font7 )
     3423               loc-type = ""
     3424             .
     3425         end.
     3426         when 1 then do:
     3427             assign
     3428               loc-name = trim(entry ( 1 , v-font7 ))
     3429               loc-size = ""
     3430               loc-type = ""
     3431             .
     3432         end.
     3433       end case.
     3434     create temp-font.
     3435     assign
     3436       temp-font.fontnum  = 7
     3437       temp-font.fontname = trim(loc-name)
     3438       temp-font.fontsize = trim(loc-size)
     3439       temp-font.fonttype = trim(loc-type)
     3440       temp-font.v-row    = 62
     3441       temp-font.v-col    = 136
     3442       temp-font.v-row-lans = 43
     3443       temp-font.v-col-lans = 198
     3444     .
     3445     repeat ii = 16 to 100 :
     3446       get-key-value section 'fonts' key 'font' + string(ii)   value v-font  .
     3447       if v-font = "" or v-font = ? then leave.
     3448       case num-entries (v-font) :
     3449         when 4 then do:
     3450             assign
     3451               loc-name = entry ( 1 , v-font )
     3452               loc-size = entry ( 2 , v-font )
     3453               loc-type = entry ( 3 , v-font ) + "," +  entry ( 4 , v-font )
     3454             .
     3455         end.
     3456         when 3 then do:
     3457             assign
     3458               loc-name = entry ( 1 , v-font )
     3459               loc-size = entry ( 2 , v-font )
     3460               loc-type = entry ( 3 , v-font )
     3461             .
     3462         end.
     3463         when 2 then do:
     3464             assign
     3465               loc-name = entry ( 1 , v-font )
     3466               loc-size = entry ( 2 , v-font )
     3467               loc-type = ""
     3468             .
     3469         end.
     3470         when 1 then do:
     3471             assign
     3472               loc-name = trim(entry ( 1 , v-font ))
     3473               loc-size = ""
     3474               loc-type = ""
     3475             .
     3476         end.
     3477       end case.
     3478     create temp-font.
     3479     assign
     3480       temp-font.fontnum  = ii
     3481       temp-font.fontname = trim(loc-name)
     3482       temp-font.fontsize = trim(loc-size)
     3483       temp-font.fonttype = trim(loc-type)
     3484     .
     3485     end.
     3486       for each temp-font :
     3487          vv = integer(entry(2,temp-font.fontsize, "=" )) no-error .
     3488          if  vv = ? then vv =  0 .
     3489           run rep/exfont.p (
     3490             input   temp-font.fontname ,
     3491             input   vv ,
     3492             input   temp-font.fonttype ,
     3493             output  temp-font.font-h   ,
     3494             output  temp-font.font-w   )
     3495           .
     3496       end.
     3497   find first temp-font where  temp-font.fontnum  = 7  .
     3498   old_H = temp-font.font-H .
     3499   old_w = temp-font.font-W .
     3500   old-row = temp-font.v-row .
     3501   old-col = temp-font.v-col .
     3502   old-row-lans = temp-font.v-row-lans .
     3503   old-col-lans = temp-font.v-col-lans .
     3504       for each temp-font where
     3505                temp-font.fontnum  <> 7 :
     3506           assign
     3507               temp-font.v-row    = old_H * old-row / temp-font.font-h
     3508               temp-font.v-col    = old_W * old-col / temp-font.font-W
     3509               temp-font.v-row-lans    = old_H * old-row-lans / temp-font.font-h
     3510               temp-font.v-col-lans    = old_W * old-col-lans / temp-font.font-W
     3511           .
     3512       end.
     3513     end.
     3514   end procedure.
     3515   PROCEDURE How-name :
     3516   define input  parameter h as integer no-undo .
     3517   define input  parameter w as integer no-undo .
     3518   define output parameter n as character  no-undo .
     3519   define variable A4port-H as integer   no-undo init 63.
     3520   define variable A4port-W as integer   no-undo init 136.
     3521   define variable A4lans-H as integer   no-undo init 43.
     3522   define variable A4lans-W as integer   no-undo init 198.
     3523   define variable Strim-W  as integer   no-undo init 278.
     3524   run define-a4-size (
     3525        input ReportFontNum
     3526       ,output A4port-H
     3527       ,output A4port-W
     3528       ,output A4lans-H
     3529       ,output A4lans-W ).
     3530   If w >= 1 and w <= A4port-W Then DO:
     3531     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     3532     If h > A4lans-H  and h <= A4port-H Then n = "A4-port":U.
     3533     If h > A4port-H              Then n = "to-file":U.
     3534   End.
     3535   If w > A4port-W and w <= A4lans-W Then DO:
     3536     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     3537     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     3538     If h > A4port-H              Then n = "to-file":U.
     3539   End.
     3540   If w > A4lans-W and w <= Strim-W Then DO:
     3541     If h >= 1  and h <= A4lans-H Then n = "to-file":U.
     3542     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     3543     If h > A4port-H              Then n = "to-file":U.
     3544   End.
     3545   If w > Strim-W Then DO:
     3546      n = "to-file":U.
     3547   End.
     3548   END PROCEDURE.
     3549   PROCEDURE define-a4-size :
     3550   define input  parameter p-ReportFontNum as integer   no-undo .
     3551   define output parameter A4port-H as integer   no-undo .
     3552   define output parameter A4port-W as integer   no-undo .
     3553   define output parameter A4lans-H as integer   no-undo .
     3554   define output parameter A4lans-W as integer   no-undo .
     3555   if not can-find (first temp-font ) then do:
     3556      run get-font-ini .
     3557   end.
     3558   find first temp-font where temp-font.fontnum = p-ReportFontNum no-error .
     3559   if available temp-font then do:
     3560   assign
     3561     A4port-H = temp-font.v-row
     3562     A4port-W = temp-font.v-col
     3563     A4lans-H = temp-font.v-row-lans
     3564     A4lans-W = temp-font.v-col-lans
     3565   .
     3566   end.
     3567   else do:
     3568   assign
     3569     A4port-H = 63
     3570     A4port-W = 136
     3571     A4lans-H = 43
     3572     A4lans-W = 198
     3573   .
     3574   end.
     3575   END PROCEDURE.
