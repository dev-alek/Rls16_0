     6946                                                 ub.doc-line.prod-code  = ub.goods.prod-code    and
     6947                                                 ub.doc-line.prod-type  = ub.goods.prod-type    :
     6948                                                     Assign
     6949                                                       f-wait-qnty   = f-wait-qnty     + ub.doc-line.fact-qnty.
     6950                                             end.
     6951                                         End.
     6952                                       End.
     6953                                     if itog = false and
     6954                                         not(f-qnty         = 0 and
     6955                                             f-cost-sum     = 0 and
     6956                                             f-sale-sum     = 0 and
     6957                                             f-sale-other   = 0 and
     6958                                             f-free-qnty    = 0 and
