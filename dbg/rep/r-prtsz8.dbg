     6902                                                         (input   ub.gds-obj.obj-code  ,
     6903                                                           input   ub.gds-obj.obj-type  ,
     6904                                                           INPUT   ub.gds-obj.artic     ,
     6905                                                           INPUT   ub.gds-obj.prod-code ,
     6906                                                           INPUT   ub.gds-obj.prod-type ,
     6907                                                           input   0                 ,
     6908                                                           INPUT   fact-order-2      ,
     6909                                                           input   'cost':U       ,
     6910                                                           input   '##,##':U    ,
     6911                                                           input   yes      ,
     6912                                                           output  Quantity1   ,
     6913                                                           output  Coast_R1  ,
     6914                                                           output  Coast_V1  ,
     6915                                                           output  VAT_R1    ,
     6916                                                           output  VAT_V1    ,
     6917                                                           output  SLT_R1    ,
     6918                                                           output  SLT_V1    ).
     6919                                                       Assign
     6920                                                           f-cost-sum   = if tprintrubl then Coast_R1 else Coast_V1
     6921                                                           f-cost-pr    = if Quantity1 = 0 then 0 else f-cost-sum / Quantity1
     6922                                                           .
     6923                                           end.
     6924                                           else do:
     6925                                                       Assign
     6926                                                           f-qnty       = ub.gds-obj.fact-qnty
     6927                                                           f-cost-sum   = determined(gds-obj.fact-base)
     6928                                                           f-sale-sum   = ub.gds-obj.fact-sale
     6929                                                           f-free-qnty  = ub.gds-obj.free-qnty
     6930                                                           f-cost-pr    = if f-qnty = 0 then 0 else f-cost-sum / f-qnty
     6931                                                           f-sale-pr    = if f-qnty = 0 then 0 else f-sale-sum / f-qnty
     6932                                                        .
     6933                                           end.
     6934                                       f-sale-other = 100 * determined((f-sale-sum - f-cost-sum) / f-cost-sum).
     6935                                       if c-f-wait-qnty <> ? Then DO :
     6936                                         for each ub.trn-doc no-lock  where
     6937                                             ub.trn-doc.obj-code        = obj-list.obj-code and
     6938                                             ub.trn-doc.obj-type        = obj-list.obj-type and
     6939                                             ub.trn-doc.status_         = 'накл':U           and
