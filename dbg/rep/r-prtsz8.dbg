     7394           dIsplay stream OutStream with FRAME Zapas no-error .
     7395           DOWN stream OutStream with FRAME Zapas.
     7396         run u-line in this-procedure.
     7397            if Make-Excel then  put   stream ForExcel unformatted
     7398            "ИТОГО"                       CHR(9)
     7399            "ПО ВСЕМ ОБЬЕКТАМ"            CHR(9) CHR(9) CHR(9)  CHR(9)
     7400            excel-qnty(accum TOTAL f-qnty           )   CHR(9)
     7401            CHR(9)
     7402            excel-sum (accum TOTAL f-cost-sum       )   CHR(9)
     7403            CHR(9)
     7404            excel-sum (accum TOTAL f-sale-sum       )   CHR(9)
     7405            excel-sum (accum TOTAL f-sale-other     )   CHR(9)
     7406            excel-sum (accum TOTAL f-free-qnty      )   CHR(9)
     7407            excel-sum (accum TOTAL f-wait-qnty      )   CHR(9)
     7408            chr(10) .
     7409       End.
     7410   end procedure.
     7411   procedure display-prt :
     7412   define variable pr-cursor as integer no-undo init 0.
     7413   define variable go-work   as logical no-undo init no.
     7414   define variable v-tmp-prt like gds-prt.node-code init -1.
     7415   IF goods.prt-root <> Prtroot Then DO:
     7416       If v-var = "no-today"  then do:
     7417   run  prdoclib-init-prt-obj-by-factord in this-procedure
     7418   ( input gds-obj.obj-type  ,
     7419     input gds-obj.obj-code  ,
     7420     input gds-obj.artic     ,
     7421     input gds-obj.prod-type ,
     7422     input gds-obj.prod-code ,
     7423     input fact-order-2 ,
     7424     input false ) .
     7425       end.
     7426     for each prt-obj where
     7427         prt-obj.artic     = goods.artic     and
     7428         prt-obj.prod-type = goods.prod-type and
     7429         prt-obj.prod-code = goods.prod-code and
     7430         prt-obj.obj-code  = obj-list.obj-code and
     7431         prt-obj.obj-type  = obj-list.obj-type and
     7432         prt-obj.is-term   =  true no-lock
     7433         BREAK BY prt-obj.prt-code with FRAME Zapas :
     7434         pr-cursor = 0.
     7435         go-work = false.
     7436         if v-prizn = "" then do:
     7437           go-work = true.
     7438         end.
     7439         else do:
     7440             do while pr-cursor < num-entries(v-prizn,","):
     7441                 pr-cursor = pr-cursor + 1.
     7442                 if entry(pr-cursor,v-prizn,",") <> "" then do:
     7443                     if integer(entry(pr-cursor,v-prizn,",")) = prt-obj.prt-code then do:
     7444                         pr-cursor = num-entries(v-prizn,",").
     7445                         go-work = true.
     7446                     end.
     7447                 end.
     7448             end.
     7449         end.
     7450         if go-work then do:
     7451             if v-var <> "no-today" then do:
     7452                 Assign
     7453                   p-qnty      = p-qnty       + prt-obj.fact-qnty
     7454                   p-free-qnty = p-free-qnty  + prt-obj.free-qnty
     7455                   p-sale-sum  = p-sale-sum   + prt-obj.fact-qnty * prt-obj.price-sale
     7456                   p-sale-pr   = if p-qnty = 0 then 0 else p-sale-sum / p-qnty
     7457                   .
     7458             End.
     7459             IF last-of(prt-obj.prt-code) THEN DO:
     7460   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     7461     (input  gds-obj.gds-code
     7462     ,input  prt-obj.prt-code
     7463     ,output v-bar-code
     7464     )  .
     7465                 if v-var = "no-today" then do:
     7466                   find first temp-prt-obj no-lock
     7467                        where temp-prt-obj.prt-obj-recid   = recid (prt-obj) no-error .
     7468                        if avail temp-prt-obj then do :
     7469                           run  calc-price-sale-for-prt in this-procedure  (output v-price-sale) .
     7470                           Assign
     7471                             p-qnty      = temp-prt-obj.fact-qnty
     7472                             p-free-qnty = 0
     7473                             p-sale-sum  = temp-prt-obj.fact-qnty * v-price-sale
     7474                             p-sale-pr   = if p-qnty = 0 then 0 else p-sale-sum / p-qnty
     7475                             .
     7476                         End.
     7477                         Else
     7478                           Assign
     7479                             p-qnty      = 0
     7480                             p-free-qnty = 0
     7481                             p-sale-sum  = 0   .
     7482                 End.
     7483           FIND first gds-prt  where gds-prt.node-code = prt-obj.prt-code NO-LOCK no-error .
     7484           if c-f-wait-qnty <> ? Then DO :
     7485             for each trn-doc no-lock  where
     7486                 trn-doc.obj-code        = obj-list.obj-code and
     7487                 trn-doc.obj-type        = obj-list.obj-type and
     7488                 trn-doc.status_         = 'накл':U           and
     7489                 trn-doc.flag_           = true              and
     7490                 trn-doc.ext-doc-type    = 'ie':U :
     7491                 for each gds-dtl no-lock where
     7492                     gds-dtl.doc-code   = trn-doc.doc-code   and
     7493                     gds-dtl.artic      = goods.artic        and
     7494                     gds-dtl.prod-code  = goods.prod-code    and
     7495                     gds-dtl.prod-type  = goods.prod-type    and
     7496                     gds-dtl.prt-code   = prt-obj.prt-code   and
     7497                     gds-dtl.obj-code   = obj-list.obj-code  and
     7498                     gds-dtl.obj-type   = obj-list.obj-type :
     7499                     Assign
     7500                     p-wait-qnty   = p-wait-qnty     + gds-dtl.fact-qnty.
     7501                 end.
     7502             End.
     7503           End.
     7504           if ( f-rez-qnty <> ? or
     7505               f-rez-cost <> ? or
     7506               f-rez-sale <> ? ) and  v-var <> "no-today"
     7507           then do:
     7508                 for each temp_gds-dtl where
     7509                           temp_gds-dtl.prt-code   = prt-obj.prt-code  :
     7510                     assign
     7511                       p-rez-qnty = p-rez-qnty  + temp_gds-dtl.doc-qnty
     7512                       p-rez-cost = p-rez-cost  + temp_gds-dtl.cost-sum
     7513                       p-rez-sale = p-rez-sale  + temp_gds-dtl.sale-sum
     7514                       p-rez-cost-pr = ( if p-rez-qnty = 0 then 0 else p-rez-cost / p-rez-qnty )
     7515                     .
     7516                 end.
     7517           end.
     7518           Assign
     7519           p-cost-sum     = determined( f-cost-sum * p-qnty  / f-qnty)
     7520           p-sale-other   = 100 * determined((p-sale-sum - p-cost-sum) / p-cost-sum)
     7521           p-cost-pr      = if p-qnty = 0 then 0 else p-cost-sum   / p-qnty
     7522           .
     7523           if not (p-zero = false  and
     7524                (p-qnty        =  0  and
     7525                 p-cost-sum    =  0  and
     7526                 p-sale-sum    =  0  and
     7527                 p-sale-other  =  0  and
     7528                 p-free-qnty   =  0  and
     7529                     p-wait-qnty  = 0  ) ) then do:
     7530     if c-nn <>  ?  then do :
     7531       c-nn:screen-value = string('') .
     7532       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7533           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7534           display STREAM OutStream    with frame top-frame .
     7535       End.
     7536     End.
     7537     if c-f-artic <>  ?  then do :
     7538       c-f-artic:screen-value = string('') .
     7539       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7540           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7541           display STREAM OutStream    with frame top-frame .
     7542       End.
     7543     End.
     7544     if c-f-b-code <>  ?  then do :
     7545       c-f-b-code:screen-value = string(string(v-bar-code,'999999999')) .
     7546       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7547           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7548           display STREAM OutStream    with frame top-frame .
     7549       End.
     7550     End.
     7551     if c-f-prt-name <>  ?  then do :
     7552       c-f-prt-name:screen-value = string(gds-prt.f-name) .
     7553       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7554           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7555           display STREAM OutStream    with frame top-frame .
     7556       End.
     7557     End.
     7558     if c-f-qnty <>  ?  then do :
     7559       c-f-qnty:screen-value = string(p-qnty) .
     7560       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7561           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7562           display STREAM OutStream    with frame top-frame .
     7563       End.
     7564     End.
     7565     if c-f-cost-pr <>  ?  then do :
     7566       c-f-cost-pr:screen-value = string(p-cost-pr) .
     7567       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7568           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7569           display STREAM OutStream    with frame top-frame .
     7570       End.
     7571     End.
     7572     if c-f-cost-sum <>  ?  then do :
     7573       c-f-cost-sum:screen-value = string(p-cost-sum) .
     7574       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7575           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7576           display STREAM OutStream    with frame top-frame .
     7577       End.
     7578     End.
     7579     if c-f-sale-pr <>  ?  then do :
     7580       c-f-sale-pr:screen-value = string(p-sale-pr) .
     7581       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7582           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7583           display STREAM OutStream    with frame top-frame .
     7584       End.
     7585     End.
     7586     if c-f-sale-sum <>  ?  then do :
     7587       c-f-sale-sum:screen-value = string(p-sale-sum) .
     7588       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7589           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7590           display STREAM OutStream    with frame top-frame .
     7591       End.
     7592     End.
     7593     if c-f-sale-other <>  ?  then do :
     7594       c-f-sale-other:screen-value = string(p-sale-other) .
     7595       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7596           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7597           display STREAM OutStream    with frame top-frame .
     7598       End.
     7599     End.
     7600     if c-f-free-qnty <>  ?  then do :
     7601       c-f-free-qnty:screen-value = string(p-free-qnty) .
     7602       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7603           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7604           display STREAM OutStream    with frame top-frame .
     7605       End.
     7606     End.
     7607     if c-f-wait-qnty <>  ?  then do :
     7608       c-f-wait-qnty:screen-value = string(p-wait-qnty) .
     7609       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7610           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7611           display STREAM OutStream    with frame top-frame .
     7612       End.
     7613     End.
     7614     if c-f-rez-qnty <>  ?  then do :
     7615       c-f-rez-qnty:screen-value = string(p-rez-qnty) .
     7616       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7617           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7618           display STREAM OutStream    with frame top-frame .
     7619       End.
     7620     End.
     7621     if c-f-rez-cost <>  ?  then do :
     7622       c-f-rez-cost:screen-value = string(p-rez-cost) .
     7623       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7624           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7625           display STREAM OutStream    with frame top-frame .
     7626       End.
     7627     End.
     7628     if c-f-rez-sale <>  ?  then do :
     7629       c-f-rez-sale:screen-value = string(p-rez-sale) .
     7630       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7631           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7632           display STREAM OutStream    with frame top-frame .
     7633       End.
     7634     End.
     7635     if c-f-rez-cost-pr <>  ?  then do :
     7636       c-f-rez-cost-pr:screen-value = string(p-rez-cost-pr) .
     7637       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7638           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7639           display STREAM OutStream    with frame top-frame .
     7640       End.
     7641     End.
     7642               Display stream OutStream no-error.
     7643               DOWN stream OutStream .
     7644               if Make-Excel then  put   stream ForExcel unformatted
     7645               CHR(9)
     7646               string(v-bar-code,"999999999") CHR(9)
     7647                            CHR(9)
     7648                            CHR(9)
     7649                gds-prt.f-name                    CHR(9)
     7650                excel-qnty(p-qnty)                            CHR(9)
     7651                excel-sum(p-cost-pr)                        CHR(9)
     7652                excel-sum(p-cost-sum)                        CHR(9)
     7653                excel-sum(p-sale-pr)                        CHR(9)
     7654                excel-sum(p-sale-sum)                        CHR(9)
     7655                excel-sum(p-sale-other)                      CHR(9)
     7656                excel-sum(p-free-qnty)                       CHR(9)
     7657               excel-sum(p-wait-qnty)   CHR(9)
     7658               excel-sum(p-rez-qnty   ) CHR(9)
     7659               excel-sum(p-rez-cost   ) CHR(9)
     7660               excel-sum(p-rez-sale   ) CHR(9)
     7661               excel-sum(p-rez-cost-pr) CHR(9)
     7662               chr(10) .
     7663           End.
     7664           Assign
     7665             p-qnty        =  0
     7666             p-cost-sum    =  0
     7667             p-sale-sum    =  0
     7668             p-sale-other  =  0
     7669             p-free-qnty   =  0
     7670             p-wait-qnty   =  0
     7671             p-rez-qnty     = 0
     7672             p-rez-cost     = 0
     7673             p-rez-sale     = 0
     7674             p-rez-cost-pr  = 0
     7675             .
     7676       End.
     7677     End.
     7678     end.
     7679   End.
     7680   end procedure.
     7681   PROCEDURE on-same-page :
     7682     define input parameter p-line-number as integer  no-undo .
     7683     if p-line-number > page-size( OutStream ) then do:
     7684       return .
     7685     end.
     7686     if line-counter( OutStream ) + p-line-number > page-size( OutStream ) then do:
     7687       page stream OutStream .
     7688     end.
     7689   end procedure.
     7690   PROCEDURE ostatok :
     7691   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
     7692   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
     7693   def input parameter x-tog-shift   as   logical             no-undo.
     7694   def input parameter x-date-start  like ub.stk-tot.Fact-date   no-undo.
     7695   def input parameter x-date-end    like ub.stk-tot.Fact-date   no-undo.
     7696   def input parameter x-shift-start as integer               no-undo.
     7697   def input parameter x-shift-end   as integer               no-undo.
     7698   def input parameter x-sum-type    like ub.stk-tot.sum-type    no-undo.
     7699   def input parameter x-cat-id      like ub.stk-tot.cat-id      no-undo.
     7700   def input parameter xTog-obj   as log no-undo.
     7701   def output parameter Quantity    like ub.stk-tot.fact-qnty   no-undo.
     7702   def output parameter Coast_R     like ub.stk-tot.sum-rubl    no-undo.
     7703   def output parameter Coast_V     like ub.stk-tot.sum-rubl    no-undo.
     7704   def output parameter VAT_R       like ub.stk-tot.sum-rubl    no-undo.
     7705   def output parameter VAT_V       like ub.stk-tot.sum-rubl    no-undo.
     7706   def output parameter Fact-order  like ub.stk-tot.Fact-order  no-undo.
     7707   def var              Fact-order#   like ub.stk-tot.Fact-order  no-undo.
     7708   def var              Fact-orderS   as char  no-undo.
     7709   def var x-date-start-t  like ub.stk-tot.shift-date   no-undo.
     7710      Assign
     7711         Fact-order   = 0
     7712         Quantity     = 0
     7713         Coast_R      = 0
     7714         Coast_V      = 0
     7715         VAT_R        = 0
     7716         VAT_V        = 0 .
     7717    x-date-start-t  = x-date-start + 1 .
     7718   IF x-date-end = date('') then DO:
     7719      Fact-order = 0 .
     7720      for each obj-list
     7721          where  ( not xtog-obj or
     7722                 ( x-store-type = obj-list.obj-type and x-store-code = obj-list.obj-code ))
     7723                 no-lock :
     7724         if  x-tog-shift = false then do:
     7725                          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     7726                               ub.stk-tot.Fact-date <=  x-date-start
     7727                               and ub.stk-tot.shift-num = 0
     7728                               USE-INDEX fact-date no-lock no-error .
     7729              if Available ub.stk-tot THEN  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     7730         End.
     7731         Else  DO :
     7732             find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     7733              (ub.stk-tot.shift-date  = x-date-start-t and
     7734               ub.stk-tot.shift-num  < x-shift-start or
     7735               ub.stk-tot.shift-date  < x-date-start-t  )
     7736               and ub.stk-tot.shift-num  > 0
     7737               USE-INDEX Shift-num no-lock no-error .
     7738            If Available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     7739           END.
     7740       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     7741     End.
     7742   End.
     7743   Else DO:
     7744     For each obj-list  WHERE
     7745        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
     7746         no-lock :
     7747      IF  x-TOG-Shift = False Then DO:
     7748          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     7749               ub.stk-tot.Fact-date <= x-date-end
     7750               and ub.stk-tot.shift-num = 0
     7751               USE-INDEX fact-date no-lock no-error.
     7752          if available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     7753      END.
     7754      Else DO:
     7755           find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     7756               (ub.stk-tot.shift-date  = x-date-end and
     7757               ub.stk-tot.shift-num  <= x-shift-end or
     7758               ub.stk-tot.shift-date  < x-date-end       ) and
     7759               ub.stk-tot.shift-num   > 0      use-index shift-num no-lock no-error.
     7760               if Available ub.stk-tot THEN Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     7761       End.
     7762       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     7763     End.
     7764   End.
     7765   END PROCEDURE.
     7766   procedure ost-line :
     7767     define input  parameter x-store-code like ub.clients.obj-code    no-undo .
     7768     define input  parameter x-store-type like ub.clients.obj-type    no-undo .
     7769     define input  parameter x-artic      like ub.stk-line.artic      no-undo .
     7770     define input  parameter x-prod-code  like ub.stk-line.prod-code  no-undo .
     7771     define input  parameter x-prod-type  like ub.stk-line.prod-type  no-undo .
     7772     define input  parameter x-tog-shift  as logical no-undo .
     7773     define input  parameter x-fact-order like ub.stk-line.fact-order no-undo .
     7774     define input  parameter x-sum-type   like ub.stk-line.sum-type   no-undo .
     7775     define input  parameter x-cat-id     like ub.stk-line.cat-id     no-undo .
     7776     define input  parameter xtog-obj     as logical no-undo .
     7777     define output parameter quantity     like ub.stk-line.fact-qnty  no-undo .
     7778     define output parameter coast_r      like ub.stk-line.sum-rubl   no-undo .
     7779     define output parameter coast_v      like ub.stk-line.sum-rubl   no-undo .
     7780     define output parameter vat_r        like ub.stk-line.sum-rubl   no-undo .
     7781     define output parameter vat_v        like ub.stk-line.sum-rubl   no-undo .
     7782     define output parameter slt_r        like ub.stk-line.sum-rubl   no-undo .
     7783     define output parameter slt_v        like ub.stk-line.sum-rubl   no-undo .
     7784     define buffer buff-obj-list  for obj-list .
     7785     define buffer buff-stk-line  for ub.stk-line .
     7786     assign
     7787       Quantity = 0
     7788       Coast_R  = 0
     7789       Coast_V  = 0
     7790       VAT_R    = 0
     7791       VAT_V    = 0
     7792       SLT_R    = 0
     7793       SLT_V    = 0
     7794     .
     7795     if  x-tog-shift = false then do:
     7796       for each buff-obj-list no-lock
     7797         where xtog-obj = false
     7798            or (buff-obj-list.obj-type = x-store-type
     7799               and buff-obj-list.obj-code = x-store-code
     7800               )
     7801       on error undo, return error
     7802       :
     7803       find last buff-stk-line no-lock
     7804         where buff-stk-line.obj-type   = buff-obj-list.obj-type
     7805           and buff-stk-line.obj-code   = buff-obj-list.obj-code
     7806           and buff-stk-line.artic      = x-artic
     7807           and buff-stk-line.prod-type  = x-prod-type
     7808           and buff-stk-line.prod-code  = x-prod-code
     7809           and buff-stk-line.sum-type   = x-sum-type
     7810           and buff-stk-line.cat-id     = '##,##':U
     7811           and buff-stk-line.fact-order <= x-fact-order
     7812           and buff-stk-line.shift-num  = 0
     7813         use-index category
     7814         no-error .
     7815       if available buff-stk-line then do:
     7816         assign
     7817           Quantity = Quantity + buff-stk-line.fact-qnty
     7818           Coast_R  = Coast_R  + buff-stk-line.sum-rubl
     7819           Coast_V  = Coast_V  + buff-stk-line.sum-base
     7820           VAT_R    = VAT_R    + buff-stk-line.VAT-rubl
     7821           VAT_V    = VAT_V    + buff-stk-line.VAT-base
     7822           SLT_R    = SLT_R    + buff-stk-line.SLT-rubl
     7823           SLT_V    = SLT_V    + buff-stk-line.SLT-base
     7824         .
     7825       end.
     7826      end.
     7827     end.
     7828     else do:
     7829       for each buff-obj-list no-lock
     7830         where xtog-obj = false
     7831            or (buff-obj-list.obj-type = x-store-type
     7832               and buff-obj-list.obj-code = x-store-code
     7833               )
     7834       on error undo, return error
     7835       :
     7836         find last buff-stk-line no-lock
     7837           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     7838             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     7839             and buff-stk-line.artic      = x-artic
     7840             and buff-stk-line.prod-type  = x-prod-type
     7841             and buff-stk-line.prod-code  = x-prod-code
     7842             and buff-stk-line.sum-type   = x-sum-type
     7843             and buff-stk-line.cat-id     = '##,##':U
     7844             and buff-stk-line.fact-order <= x-fact-order
     7845             and buff-stk-line.shift-num  > 0
     7846           use-index category
     7847           no-error .
     7848         if available buff-stk-line then do:
     7849           assign
     7850             Quantity = Quantity +  buff-stk-line.fact-qnty
     7851             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     7852             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     7853             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     7854             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     7855             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     7856             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     7857           .
     7858         end.
     7859       end.
     7860     end.
     7861   end procedure.
     7862   procedure ost-lineother-tax :
     7863     define input  parameter x-store-code like ub.clients.obj-code      no-undo.
     7864     define input  parameter x-store-type like ub.clients.obj-type      no-undo.
     7865     define input  parameter x-artic      like ub.stk-line.artic        no-undo.
     7866     define input  parameter x-prod-code  like ub.stk-line.prod-code    no-undo.
     7867     define input  parameter x-prod-type  like ub.stk-line.prod-type    no-undo.
     7868     define input  parameter x-tog-shift  as logical no-undo .
     7869     define input  parameter x-fact-order like ub.stk-line.fact-order   no-undo.
     7870     define input  parameter x-sum-type   like ub.stk-line.sum-type     no-undo.
     7871     define input  parameter x-type-id    like ub.stk-line.cat-id       no-undo.
     7872     define input  parameter xTog-obj     as logical no-undo .
     7873     define output parameter Quantity     like ub.stk-line.fact-qnty   no-undo.
     7874     define output parameter Coast_R      like ub.stk-line.sum-rubl    no-undo.
     7875     define output parameter Coast_V      like ub.stk-line.sum-rubl    no-undo.
     7876     define output parameter VAT_R        like ub.stk-line.sum-rubl    no-undo.
     7877     define output parameter VAT_V        like ub.stk-line.sum-rubl    no-undo.
     7878     define output parameter SLT_R        like ub.stk-line.sum-rubl    no-undo.
     7879     define output parameter SLT_V        like ub.stk-line.sum-rubl    no-undo.
     7880     define output parameter other_R      like ub.stk-line.sum-rubl    no-undo.
     7881     define output parameter other_V      like ub.stk-line.sum-rubl    no-undo.
     7882     define buffer buff-obj-list  for obj-list .
     7883     define buffer buff-stk-line  for ub.stk-line .
     7884     assign
     7885       Quantity = 0
     7886       Coast_R  = 0
     7887       Coast_V  = 0
     7888       VAT_R    = 0
     7889       VAT_V    = 0
     7890       SLT_R    = 0
     7891       SLT_V    = 0
     7892       other_R  = 0
     7893       other_V  = 0
     7894     .
     7895     if  x-tog-shift = false then do:
     7896       for each buff-obj-list no-lock
     7897         where xtog-obj = false
     7898            or (buff-obj-list.obj-type = x-store-type
     7899               and buff-obj-list.obj-code = x-store-code
     7900               )
     7901       on error undo, return error
     7902       :
     7903       find last buff-stk-line no-lock
     7904         where buff-stk-line.obj-type   = buff-obj-list.obj-type
     7905           and buff-stk-line.obj-code   = buff-obj-list.obj-code
     7906           and buff-stk-line.artic      = x-artic
     7907           and buff-stk-line.prod-type  = x-prod-type
     7908           and buff-stk-line.prod-code  = x-prod-code
     7909           and buff-stk-line.sum-type   = x-sum-type
     7910           and buff-stk-line.cat-id     = '##,##':U
     7911           and buff-stk-line.fact-order <= x-fact-order
     7912           and buff-stk-line.shift-num  = 0
     7913         use-index category
     7914         no-error .
     7915       if available buff-stk-line then do:
     7916         assign
     7917           Quantity = Quantity + buff-stk-line.fact-qnty
     7918           Coast_R  = Coast_R  + buff-stk-line.sum-rubl
     7919           Coast_V  = Coast_V  + buff-stk-line.sum-base
     7920           VAT_R    = VAT_R    + buff-stk-line.VAT-rubl
     7921           VAT_V    = VAT_V    + buff-stk-line.VAT-base
     7922           SLT_R    = SLT_R    + buff-stk-line.SLT-rubl
     7923           SLT_V    = SLT_V    + buff-stk-line.SLT-base
     7924           other_R  = other_R  + buff-stk-line.other-rubl
     7925           other_V  = other_V  + buff-stk-line.other-base
     7926         .
     7927       end.
     7928    end.
     7929     end.
     7930     else do:
     7931       for each buff-obj-list no-lock
     7932         where xtog-obj = false
     7933            or (buff-obj-list.obj-type = x-store-type
     7934               and buff-obj-list.obj-code = x-store-code
     7935               )
     7936       on error undo, return error
     7937       :
     7938         find last buff-stk-line no-lock
     7939           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     7940             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     7941             and buff-stk-line.artic      = x-artic
     7942             and buff-stk-line.prod-type  = x-prod-type
     7943             and buff-stk-line.prod-code  = x-prod-code
     7944             and buff-stk-line.sum-type   = x-sum-type
     7945             and buff-stk-line.cat-id     = '##,##':U
     7946             and buff-stk-line.fact-order <= x-fact-order
     7947             and buff-stk-line.shift-num  > 0
     7948           use-index category
     7949           no-error .
     7950         if available buff-stk-line then do:
     7951           assign
     7952             Quantity = Quantity +  buff-stk-line.fact-qnty
     7953             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     7954             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     7955             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     7956             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     7957             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     7958             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     7959             other_R = other_R   +  buff-stk-line.other-rubl
     7960             other_V = other_V   +  buff-stk-line.other-base
     7961           .
     7962         end.
     7963       end.
     7964     end.
     7965   end procedure.
     7966   procedure ost-line-kg :
     7967     define  input parameter p-obj-code    like ub.stk-line.obj-code   no-undo .
     7968     define  input parameter p-obj-type    like ub.stk-line.obj-type   no-undo .
     7969     define  input parameter p-artic       like ub.stk-line.artic      no-undo .
     7970     define  input parameter p-prod-code   like ub.stk-line.prod-code  no-undo .
     7971     define  input parameter p-prod-type   like ub.stk-line.prod-type  no-undo .
     7972     define  input parameter p-fact-order  like ub.stk-line.fact-order no-undo .
     7973     define output parameter p-quantity-kg like ub.stk-line.fact-qnty  no-undo initial 0.00 .
     7974     define buffer buff-obj-list  for obj-list .
     7975     define buffer buf_doc-line for ub.doc-line .
     7976     define buffer buf_inv-line for ub.inv-line .
     7977     do
     7978     on error undo, return error
     7979     :
     7980       for each buf_doc-line no-lock where
     7981                buf_doc-line.obj-type    = p-obj-type   and
     7982                buf_doc-line.obj-code    = p-obj-code   and
     7983                buf_doc-line.prod-type   = p-prod-type  and
     7984                buf_doc-line.prod-code   = p-prod-code  and
     7985                buf_doc-line.artic       = p-artic      and
     7986                buf_doc-line.status_     = 'факт':U      and
     7987                buf_doc-line.fact-order <= p-fact-order
     7988             by buf_doc-line.fact-order    descending
     7989       :
     7990         find first buf_inv-line no-lock where
     7991                    buf_inv-line.doc-code  = buf_doc-line.doc-code  and
     7992                    buf_inv-line.artic     = buf_doc-line.artic     and
     7993                    buf_inv-line.prod-type = buf_doc-line.prod-type and
     7994                    buf_inv-line.prod-code = buf_doc-line.prod-code no-error .
     7995         if available buf_inv-line
     7996         then do:
     7997           if buf_inv-line.after-cli-qnty <> ?
     7998           then do:
     7999             assign
     8000               p-quantity-kg = buf_inv-line.after-cli-qnty
     8001             .
     8002             leave .
     8003           end.
     8004         end.
     8005       end.
     8006       if p-quantity-kg = ?
     8007       then do:
     8008         assign
     8009           p-quantity-kg = 0
     8010         .
     8011       end.
     8012     end.
     8013   end procedure.
     8014   procedure calc-price-sale-for-prt :
     8015   define output parameter v-cur-base as decimal no-undo .
     8016   define variable v-cli-base-rate like ub.bar-code.cli-base-rate no-undo .
     8017   define var parrecid-prl as recid no-undo .
     8018       define  variable price-rubl-with-tax-sale-prl    like ub.doc-line.price-rubl no-undo.
     8019       define  variable price-base-with-tax-sale-prl    like ub.doc-line.price-base no-undo.
     8020       define  variable price-rubl-without-tax-sale-prl like ub.doc-line.price-rubl no-undo.
     8021       define  variable price-base-without-tax-sale-prl like ub.doc-line.price-base no-undo.
     8022       define  variable vat-base-sale-prl               like ub.doc-line.price-base no-undo.
     8023       define  variable vat-rubl-sale-prl               like ub.doc-line.price-rubl no-undo.
     8024       define  variable vat-base-buyer-prl              like ub.doc-line.price-base no-undo.
     8025       define  variable vat-rubl-buyer-prl              like ub.doc-line.price-rubl no-undo.
     8026       define  variable slt-base-sale-prl               like ub.doc-line.price-base no-undo.
     8027       define  variable slt-rubl-sale-prl               like ub.doc-line.price-rubl no-undo.
     8028       define  variable road-tax-base-sale-prl          like ub.doc-line.road-tax   no-undo.
     8029       define  variable road-tax-rubl-sale-prl          like ub.doc-line.road-tax   no-undo.
     8030       define  variable excise-base-sale-prl            like ub.doc-line.price-base no-undo.
     8031       define  variable excise-rubl-sale-prl            like ub.doc-line.price-rubl no-undo.
     8032       define  variable discnt-base-sale-prl            like ub.gds-dtl.discnt-base no-undo.
     8033       define  variable discnt-rubl-sale-prl            like ub.gds-dtl.discnt-rubl no-undo.
     8034       define buffer out-vatp_gds-dtl-prl     for ub.gds-dtl.
     8035       define buffer buf_out-vatp_gds-dtl-prl for ub.gds-dtl.
     8036       define buffer out-vatp_parts-prl       for ub.parts.
     8037       define buffer out-vatp_sysconf-prl     for ub.sysconf.
     8038       define buffer out-vatp_doc-line-prl    for ub.doc-line.
     8039       define buffer out-vatp_goods-prl       for ub.goods.
     8040       define buffer out-vatp_trn-doc-prl     for ub.trn-doc.
     8041       define buffer out-vatp_doc-attr-prl    for ub.doc-attr.
     8042       define variable varprice-base-cons-prl      like ub.doc-line.price-base initial 0.00 no-undo.
     8043       define variable varprice-rubl-cons-prl      like ub.doc-line.price-rubl initial 0.00 no-undo.
     8044       define variable varfrm-cnsv-type-prl         as   character                           no-undo.
     8045       define variable varfrm-cnsv-prl              as   character                           no-undo.
     8046       define variable varroot-node-prl             as   integer                             no-undo.
     8047       define variable varempty-scale-prl           as   logical                             no-undo.
     8048       define variable varis-cons-parts-have-prl    as   logical                             no-undo.
     8049       define variable varsum-base-factovp-prl      like ub.gds-dtl.price-base               no-undo.
     8050       define variable varslt-base-factovp-prl      like ub.gds-dtl.price-base               no-undo.
