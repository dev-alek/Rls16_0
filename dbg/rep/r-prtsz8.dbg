     7288           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7289           display STREAM OutStream    with frame top-frame .
     7290       End.
     7291     End.
     7292     if c-f-sale-sum <>  ?  then do :
     7293       c-f-sale-sum:screen-value = string(accum TOTAL f-sale-sum) .
     7294       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7295           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7296           display STREAM OutStream    with frame top-frame .
     7297       End.
     7298     End.
     7299     if c-f-sale-other <>  ?  then do :
     7300       c-f-sale-other:screen-value = string(accum TOTAL f-sale-other) .
     7301       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7302           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7303           display STREAM OutStream    with frame top-frame .
     7304       End.
     7305     End.
     7306     if c-f-free-qnty <>  ?  then do :
     7307       c-f-free-qnty:screen-value = string(accum TOTAL f-free-qnty) .
     7308       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7309           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7310           display STREAM OutStream    with frame top-frame .
     7311       End.
     7312     End.
     7313     if c-f-wait-qnty <>  ?  then do :
     7314       c-f-wait-qnty:screen-value = string(accum TOTAL f-wait-qnty) .
     7315       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7316           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7317           display STREAM OutStream    with frame top-frame .
     7318       End.
     7319     End.
     7320           Display stream OutStream no-error.
     7321           DOWN stream OutStream .
     7322           run u-line in this-procedure.
     7323           if Make-Excel then  put   stream ForExcel unformatted
     7324             "ИТОГО"                         CHR(9)
     7325             "по объекту"                    CHR(9)
     7326             obj-list.obj-name               CHR(9)  CHR(9)  CHR(9)
     7327             excel-qnty(accum TOTAL f-qnty           )  CHR(9)
     7328             CHR(9)
     7329             excel-sum (accum TOTAL f-cost-sum       )  CHR(9)
     7330             CHR(9)
     7331             excel-sum (accum TOTAL f-sale-sum       )  CHR(9)
     7332             excel-sum (accum TOTAL f-sale-other    )   CHR(9)
     7333             excel-sum (accum TOTAL f-free-qnty     )   CHR(9)
     7334             excel-sum (accum TOTAL f-wait-qnty     )   CHR(9)
     7335             chr(10) .
     7336   End.
     7337      if n-no > 1 then do:
     7338     if c-nn <>  ?  then do :
     7339       c-nn:screen-value = string('ИТОГО') .
     7340       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7341           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7342           display STREAM OutStream    with frame top-frame .
     7343       End.
     7344     End.
     7345     if c-f-artic <>  ?  then do :
     7346       c-f-artic:screen-value = string('ПО ВСЕМ ОБЬЕКТАМ') .
     7347       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7348           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7349           display STREAM OutStream    with frame top-frame .
     7350       End.
     7351     End.
     7352     if c-f-qnty <>  ?  then do :
     7353       c-f-qnty:screen-value = string(accum TOTAL f-qnty) .
     7354       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7355           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7356           display STREAM OutStream    with frame top-frame .
     7357       End.
     7358     End.
     7359     if c-f-cost-sum <>  ?  then do :
     7360       c-f-cost-sum:screen-value = string(accum TOTAL f-cost-sum) .
     7361       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7362           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7363           display STREAM OutStream    with frame top-frame .
     7364       End.
     7365     End.
     7366     if c-f-sale-sum <>  ?  then do :
     7367       c-f-sale-sum:screen-value = string(accum TOTAL f-sale-sum) .
     7368       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7369           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7370           display STREAM OutStream    with frame top-frame .
     7371       End.
     7372     End.
     7373     if c-f-sale-other <>  ?  then do :
