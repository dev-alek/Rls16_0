     7375       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7376           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7377           display STREAM OutStream    with frame top-frame .
     7378       End.
     7379     End.
     7380     if c-f-free-qnty <>  ?  then do :
     7381       c-f-free-qnty:screen-value = string(accum TOTAL f-free-qnty) .
     7382       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7383           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7384           display STREAM OutStream    with frame top-frame .
     7385       End.
     7386     End.
     7387     if c-f-wait-qnty <>  ?  then do :
