     5563                                                           f-sale-sum   = if tprintrubl then Coast_R1 else Coast_V1
     5564                                                           f-sale-pr    = if f-qnty = 0 then 0 else  f-sale-sum  / f-qnty
     5565                                                           .
     5566                                                         RUN ost-line in this-procedure
     5567                                                         (input   ub.gds-obj.obj-code  ,
     5568                                                           input   ub.gds-obj.obj-type  ,
     5569                                                           INPUT   ub.gds-obj.artic     ,
