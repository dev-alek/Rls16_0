     1484               , input 'egrip-num':U
     1485               , output v-torgconf-self-host-egrip-num
     1486               , output v-par-type
     1487           ).
     1488           run fmtcli-get-bank in this-procedure (
     1489                 input v-host-code
     1490               , input 'орг':U
     1491               , input v-torgconf-self-host-code
     1492               , input p-curr-code
     1493           ).
     1494       end.
     1495       assign
     1496           v-torgconf-self-schet-exists = v-fmtcli-schet-exists
     1497           v-torgconf-self-bank-exists  = v-fmtcli-bank-exists
     1498           v-torgconf-self-bank-r-schet = v-fmtcli-bank-r-schet
     1499           v-torgconf-self-bank-c-schet = v-fmtcli-bank-c-schet
     1500           v-torgconf-self-bank-bik     = v-fmtcli-bank-bik
     1501           v-torgconf-self-bank-name    = v-fmtcli-bank-name
     1502           v-torgconf-self-bank-addres  = v-fmtcli-bank-addres
     1503           v-torgconf-self-bank-city    = v-fmtcli-bank-city
     1504       .
     1505       assign
     1506           v-torgconf-self-obj-type = p-obj-type
     1507           v-torgconf-self-obj-code = p-obj-code
     1508       .
     1509       run fmtcli-get-client in this-procedure (
     1510             input p-obj-type
