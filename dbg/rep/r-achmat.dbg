     1524   procedure torgconf-get-recepient-param :
     1525   define input parameter torgconfdoc-code   as character                  no-undo.
     1526   define output parameter v-code-rec        as integer                    no-undo .
     1527   define output parameter v-type-rec        as character                  no-undo initial 'C':U.
     1528   define output parameter v-codefirm-rec    as integer                    no-undo .
     1529   define output parameter v-curcode-rec     as integer                    no-undo .
     1530        define variable  v-recipient-code  as character                  no-undo .
     1531        define variable  v-recipient       like ub.doc-attr.attr-value   no-undo.
     1532        define variable  v-trdcattr-type   as character                  no-undo initial 'C':U.
     1533   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input torgconfdoc-code ,
     1534                           input 'Recipient':U ,
     1535                          output v-recipient-code ,
     1536                          output v-trdcattr-type ) no-error .
     1537       if error-status :error then do:
     1538        message
     1539         vss-workfile vss-revision vss-description skip
     1540         "Ошибка при вызове процедуры tdat-val":U skip
     1541         "Документ: " torgconfdoc-code skip
     1542         "Атрибут: " 'Recipient':U skip
     1543         "Значение: " v-recipient skip
     1544         trim( error-status :get-message (1) ) skip
     1545         return-value skip
     1546         view-as alert-box error.
     1547       undo, return error return-value.
     1548       end.
     1549     assign
     1550       v-recipient  = v-recipient-code
     1551       v-type-rec = substring(v-recipient-code,1,3)
     1552       v-code-rec  = int(substring(v-recipient-code,4,15))
     1553       no-error
     1554     .
     1555     if v-type-rec = ? then v-type-rec = "" .
     1556     if v-code-rec  = ? then v-code-rec  =  0 .
     1557     end procedure.
