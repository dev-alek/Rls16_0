     1097   procedure wthcattr-sprcli :
     1098   define input parameter parparentproc  as widget-handle no-undo.
     1099   define input parameter p-mode  as character no-undo.
     1100   define input-output parameter p-value as character no-undo .
     1101   define output parameter p-setted as logical no-undo .
     1102     DEFINE VARIABLE v-value as character no-undo .
     1103     define variable v-cli-type as character no-undo .
     1104     define variable v-cli-code as integer no-undo .
     1105     define buffer buf_clients   for ub.clients.
     1106     define variable v_rid as character no-undo.
     1107     define variable ref-rec as recid no-undo .
     1108     do
     1109     on error undo, return error
     1110     :
     1111         v-value = p-value.
     1112      if p-value <> '':U then do:
     1113       assign
     1114       v-cli-type = substring(p-value, 1, 3)
     1115       v-cli-code = integer(substring(p-value, 4))
     1116       no-error.
     1117       if error-status:error then do:
     1118         assign
     1119         v-cli-type = '':U
     1120         v-cli-code = 0
     1121         .
     1122       end.
     1123      end.
     1124      FIND FIRST buf_clients NO-LOCK WHERE
     1125               buf_clients.obj-type = v-cli-type AND
     1126               buf_clients.obj-code = v-cli-code  NO-ERROR.
     1127      IF available(buf_clients) then do:
     1128       run ref/cli-all.w (
     1129                   input parparentproc
     1130                  ,input if p-mode = 'ИЗМЕНЕНИЕ':U then "b-sel":U else "":U
     1131                  ,input v-cli-type
     1132                  ,input 'все':U
     1133                  ,input 'все':U
     1134                  ,input RECID( buf_clients )
     1135                  ,input ",,,,,,NO"
     1136                  ,input ?
     1137                  ,OUTPUT v_rid ).
     1138     END.
     1139     ELSE if p-mode = 'ИЗМЕНЕНИЕ':U then DO:
     1140       run ref/cli-all.w (
     1141                    input parparentproc
     1142                   ,INPUT "b-sel":U
     1143                  ,input  v-cli-type
     1144                  ,input 'все':U
     1145                  ,input 'текущие':U
     1146                  ,input ?
     1147                  ,input ",,,,,,NO"
     1148                  ,input ?
     1149                  ,OUTPUT v_rid ).
     1150     END.
     1151     else do:
     1152       message
     1153       if p-value = "":U then 'Атрибут не задан!'
     1154       else substitute('Не найден клиент &1',p-value)
     1155       view-as alert-box warning.
     1156     end.
     1157     IF v_rid <> ? AND v_rid <> "":U THEN DO:
     1158       ASSIGN ref-rec = INT( v_rid ) NO-ERROR.
     1159       IF ERROR-STATUS:ERROR THEN DO:
     1160           RETURN NO-APPLY.
     1161       END.
     1162       FIND FIRST buf_clients NO-LOCK WHERE
     1163                  RECID( buf_clients ) = ref-rec NO-ERROR.
     1164       IF AVAIL buf_clients THEN DO:
     1165         v-value = buf_clients.obj-type + string(buf_clients.obj-code, ">>>>>>>>9").
     1166       end.
     1167     end.
     1168     if v-value <> p-value then do:
     1169       p-value = v-value.
     1170       p-setted = yes.
     1171     end.
     1172     end.
     1173   end procedure.
     1174     define new global shared variable g#wthcalib as handle no-undo.
     1175   procedure torgconf-read :
     1176   do
     1177   on error undo, return error
     1178   :
     1179       define input parameter p-form-name  as character    no-undo.
     1180       define input parameter p-host-code  as integer      no-undo.
     1181       define input parameter p-obj-type   as character    no-undo.
     1182       define input parameter p-obj-code   as integer      no-undo.
     1183       define variable v-outdate   as character     no-undo.
     1184       define variable v-outares   as character     no-undo.
     1185       define variable v-outsend   as character     no-undo.
     1186       define variable v-outasend  as character     no-undo.
     1187       define variable v-outprops  as character     no-undo.
     1188       define variable v-outnum    as character     no-undo.
     1189       define variable v-outprim   as character     no-undo.
     1190       define variable v-outdisc   as character     no-undo.
     1191       define variable v-outsubs   as character     no-undo.
     1192       define variable v-outrecv   as character     no-undo.
     1193       define variable v-outegrp   as character     no-undo.
     1194       define variable v-outt12    as character     no-undo.
     1195       define variable v-outappr   as character     no-undo.
     1196       define variable v-outrubl   as character     no-undo.
     1197       define variable v-outhold   as character     no-undo.
     1198       define variable v-outobj    as character     no-undo.
     1199       define variable v-outexlst  as character     no-undo.
     1200       define variable v-outprncd  as character     no-undo.
     1201       define variable v-par-type  as character     no-undo.
     1202       define variable v-outogr    as character     no-undo.
     1203       define variable v-outR      as character     no-undo.
     1204       define variable v-outB      as character     no-undo.
     1205       define variable v-outC      as character     no-undo.
     1206       assign
     1207           v-torgconf-outdate  = no
     1208           v-torgconf-outnum   = no
     1209           v-torgconf-outprim  = no
     1210           v-torgconf-outdisc  = no
     1211           v-torgconf-outsubs  = no
     1212           v-torgconf-outrecv  = no
     1213           v-torgconf-outegrp  = no
     1214           v-torgconf-outt12   = no
     1215           v-torgconf-outappr  = no
     1216           v-torgconf-outrubl  = no
     1217           v-torgconf-outhold  = no
     1218           v-torgconf-outobj   = no
     1219           v-torgconf-outexlst = no
     1220           v-torgconf-outexpas = "":U
     1221           v-torgconf-outprncd = yes
     1222           v-torgconf-outares  = no
     1223           v-torgconf-outsend  = no
     1224           v-torgconf-outasend  = no
     1225           v-torgconf-outprops  = no
     1226           v-form-name          = p-form-name
     1227       .
     1228   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1229   empty temp-table thbjattr_thbj-attr.
     1230   run adm/shattri.p (
     1231      input "get":U
     1232     ,input ''
     1233     ,input 0
     1234     ,input 'prt-glob':U
     1235     ,input  ""
     1236     ,output v-value-character
     1237     ,output v-value-date
     1238     ,output v-value-decimal
     1239     ,output v-value-integer
     1240     ,output v-value-logical
     1241     ,output par-type
