     3837   procedure torgconf-get-reason  :
     3838   define input parameter  p-doc-code       as character        no-undo.
     3839   define input parameter  p-reason-code    as integer          no-undo .
     3840   define input parameter  p-doc-type       as character        no-undo.
     3841       if p-reason-code > 0
     3842       then do:
     3843           define buffer buf_trn-reason for ub.trn-reason.
     3844           find first buf_trn-reason no-lock where buf_trn-reason.reason-code = p-reason-code no-error .
     3845           if available buf_trn-reason then assign v-torgconf-reason =  buf_trn-reason.reason-name .
     3846       end.
     3847       else do:
     3848           if p-doc-type = 'при':U
     3849           then  do:
     3850               define variable v-attr-type     as character    no-undo.
     3851               define variable v-attr-value    as character    no-undo.
     3852               run gbl/trdcat-v.p (input p-doc-code,input 'nids':U,output v-attr-value,output v-attr-type) .
     3853               assign v-torgconf-reason = v-attr-value .
     3854               run gbl/trdcat-v.p (input p-doc-code,input 'dids':U,output v-attr-value,output v-attr-type) .
     3855               assign v-torgconf-reason = v-torgconf-reason + " от " + v-attr-value .
     3856           end.
     3857       end.
     3858   end procedure.
     3859   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3860     define variable v-cntxp-doc-prt         like ub.store.doc-prt         no-undo.
     3861     define variable v-cntxp-price-calc      like ub.store.price-calc      no-undo.
     3862     define variable v-cntxp-inout-price     like ub.store.inout-price     no-undo.
     3863     define variable v-cntxp-unit-cli-perm   like ub.store.unit-cli-perm   no-undo.
     3864     define variable v-cntxp-out-rate        like ub.store.out-rate        no-undo.
     3865     define variable v-cntxp-out-line-discnt like ub.store.out-line-discnt no-undo.
     3866     define variable v-cntxp-in-ov           like ub.store.in-ov           no-undo.
     3867     define variable v-cntxp-in-perm         like ub.store.in-perm         no-undo.
     3868     define variable v-cntxp-no-eq           like ub.store.no-eq           no-undo.
     3869     define variable v-cntxp-rsrv-time       like ub.store.rsrv-time       no-undo.
     3870     define variable v-cntxp-load-time       like ub.store.load-time       no-undo.
     3871     define variable v-cntxp-holidays        like ub.store.holidays        no-undo.
     3872     define variable v-cntxp-in-pay          like ub.store.in-pay          no-undo.
     3873     define variable v-cntxp-out-pay         like ub.store.out-pay         no-undo.
     3874     define variable v-cntxp-ret-pay         like ub.store.ret-pay         no-undo.
     3875     define variable v-cntxp-ret-sup-pay     like ub.store.ret-sup-pay     no-undo.
     3876     define variable v-cntxp-down-pay        like ub.store.down-pay        no-undo.
     3877     define variable v-cntxp-inv-pay         like ub.store.inv-pay         no-undo.
     3878     define variable v-cntxp-chk-pay         like ub.store.chk-pay         no-undo.
     3879     define variable v-cntxp-retail          like ub.sysconf.ord-prt       no-undo.
     3880     define variable v-cntxp-osn-base        like ub.sysconf.osn-base      no-undo.
     3881     define variable v-cntxp-conf-par        as   character                no-undo.
     3882     define variable v-cntxp-par-type        as   character                no-undo.
     3883     define variable v-cntxp-curr-host-code  like ub.store.host-code       no-undo.
     3884     define variable v-cntxp-obj-type        like ub.clients.obj-type      no-undo.
     3885     define variable v-cntxp-obj-code        like ub.clients.obj-code      no-undo.
     3886     define variable v-cntxp-db-num          as integer   no-undo .
     3887     define variable v-cntxp-userid          as character no-undo .
     3888     define variable v-cntxp-level           as character no-undo .
     3889     define variable v-cntxp-db-num-obj      as integer   no-undo .
     3890     define variable v-cntxp-is-admin        as logical   no-undo .
     3891     define buffer bf-cntxp_store for ub.store.
     3892     define buffer bf-cntxp_shop  for ub.shop.
     3893     define buffer bf-cntxp_sysconf for ub.sysconf.
     3894   def var vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3895   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     3896   procedure paramls-clear :
     3897     define buffer buf_temp-param for temp-param .
     3898     do
     3899     on error undo, return error return-value
     3900     :
     3901       for each buf_temp-param
     3902       on error undo, return error
     3903       :
     3904         delete buf_temp-param .
     3905       end.
     3906     end.
     3907   end procedure.
     3908   procedure paramls-write :
     3909     define input  parameter p-code     as character no-undo .
     3910     define input  parameter p-sub-code as character no-undo .
     3911     define input  parameter p-value    as character no-undo .
     3912     define buffer buf_temp-param for temp-param .
     3913     do
     3914     on error undo, return error return-value
     3915     :
     3916       find first buf_temp-param
     3917         where buf_temp-param.param-code     = p-code
     3918           and buf_temp-param.param-sub-code = p-sub-code
     3919         no-error .
     3920       if not available buf_temp-param then do:
     3921         create buf_temp-param .
     3922         assign
     3923           buf_temp-param.param-code     = p-code
     3924           buf_temp-param.param-sub-code = p-sub-code
     3925         .
     3926       end.
     3927       assign
     3928         buf_temp-param.param-value = p-value
     3929       .
     3930     end.
     3931   end procedure.
     3932   procedure paramls-read :
     3933     define input  parameter p-code          as character no-undo .
     3934     define input  parameter p-sub-code      as character no-undo .
     3935     define input  parameter p-default-value as character no-undo .
     3936     define output parameter p-value         as character no-undo .
     3937     define buffer buf_temp-param for temp-param .
     3938     do
     3939     on error undo, return error return-value
     3940     :
     3941       find first buf_temp-param
     3942         where buf_temp-param.param-code     = p-code
     3943           and buf_temp-param.param-sub-code = p-sub-code
     3944         no-error .
     3945       if available buf_temp-param then do:
     3946         assign
     3947           p-value = buf_temp-param.param-value
     3948         .
     3949       end.
     3950       else do:
     3951         assign
     3952           p-value = p-default-value
     3953         .
     3954       end.
     3955     end.
     3956   end procedure.
     3957   procedure paramls-append :
     3958     define input  parameter p-code     as character no-undo .
     3959     define input  parameter p-sub-code as character no-undo .
     3960     define input  parameter p-value    as character no-undo .
     3961     define buffer buf_temp-param for temp-param .
     3962     do
     3963     on error undo, return error return-value
     3964     :
     3965       find first buf_temp-param
     3966            where buf_temp-param.param-code     = p-code
     3967              and buf_temp-param.param-sub-code = p-sub-code
     3968         no-error .
     3969       if not available buf_temp-param then do:
     3970         create buf_temp-param .
     3971         assign
     3972           buf_temp-param.param-code     = p-code
     3973           buf_temp-param.param-sub-code = p-sub-code
     3974           buf_temp-param.param-value    = p-value
     3975         .
     3976       end.
     3977       else do:
     3978           assign
     3979               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     3980           .
     3981       end.
     3982     end.
     3983   end procedure.
     3984   define stream excel-line.
     3985   define stream excel-cell.
     3986   define temp-table temp_cell-data no-undo
     3987       field data-key as character
     3988       field data-value as character
     3989       index pi is primary unique data-key
     3990   .
     3991   define variable v-acmxl-sheet1-cur-data-row     as integer      no-undo.
     3992   define variable v-acmxl-sheet2-cur-data-row     as integer      no-undo.
     3993   define variable v-acmxl-cell-file-name       as character    no-undo.
     3994   define variable v-acmxl-data-file-name       as character    no-undo.
     3995   procedure acmxl-init :
     3996       run gbl/_tmpfile.p (
     3997             input "xd"
     3998           , input ".txt"
     3999           , output v-acmxl-data-file-name
     4000       ).
     4001       output stream excel-line to value( v-acmxl-data-file-name ).
     4002       run gbl/_tmpfile.p (
     4003             input "xc"
     4004           , input ".txt"
     4005           , output v-acmxl-cell-file-name
     4006       ).
     4007       output stream excel-cell to value( v-acmxl-cell-file-name ).
     4008       run acmxl-write-cell-data in this-procedure (
     4009             input "sheetList":U
     4010           , input "Лист1":U
     4011       ).
     4012       run acmxl-write-cell-data in this-procedure (
     4013             input "Лист1_valutCode":U
     4014           , input "0":U
     4015       ).
     4016       run acmxl-write-cell-data in this-procedure (
     4017             input "Лист1_columnList":U
     4018           , input "pos,name,num,delivery_date,unit,fact_qnty,price,sum,description":U
     4019       ).
     4020       run acmxl-write-cell-data in this-procedure (
     4021             input "Лист1_columnType":U
     4022           , input "I,S,S,S,S,D,D,D,S":U
     4023       ).
     4024       run acmxl-write-cell-data in this-procedure (
     4025             input "Лист1_subtotalList":U
     4026           , input "":U
     4027       ).
     4028       run acmxl-write-cell-data in this-procedure (
     4029             input "Лист1_subtotalType":U
     4030           , input "":U
     4031       ).
     4032   end procedure.
     4033   procedure acmxl-sheet1-write-line-data :
     4034       define input parameter p-pos        as integer   no-undo.
     4035       define input parameter p-name       as character no-undo.
     4036       define input parameter p-num        as character no-undo.
     4037       define input parameter p-dv-date    as date      no-undo.
     4038       define input parameter p-unit       as character no-undo.
     4039       define input parameter p-fact-qnty  as decimal   no-undo.
     4040       define input parameter p-price      as decimal   no-undo.
     4041       define input parameter p-sum        as decimal   no-undo.
     4042       define input parameter p-desciption as character no-undo.
     4043       put stream excel-line UNFORMATTED
     4044           "Лист1":U
     4045           chr(9) "DTA":U
     4046           chr(9) p-pos
     4047           chr(9) p-name
     4048           chr(9) p-num
     4049           chr(9) p-dv-date
     4050           chr(9) p-unit
     4051           chr(9) p-fact-qnty
     4052           chr(9) p-price
     4053           chr(9) p-sum
     4054           chr(9) p-desciption
     4055           chr(10)
     4056       .
     4057   end procedure.
     4058   procedure acmxl-write-cell-data :
     4059       define input parameter p-key as character no-undo.
     4060       define input parameter p-val as character no-undo.
     4061       find first temp_cell-data
     4062           where temp_cell-data.data-key = p-key
     4063           no-lock no-error.
     4064       if avail temp_cell-data then
     4065           temp_cell-data.data-value = p-val.
     4066       else do:
     4067           create temp_cell-data.
     4068           assign
     4069               temp_cell-data.data-key = p-key
     4070               temp_cell-data.data-value = p-val
     4071           .
     4072       end.
     4073       put stream excel-cell UNFORMATTED
     4074           p-key chr(9) p-val chr(10)
     4075       .
     4076   end procedure.
     4077   procedure acmxl-close :
     4078       output stream excel-line close.
     4079       output stream excel-cell close.
     4080       output to value( string( session:temp-directory + "$" + string( g#report-num ) ) + ".txl" ) append.
     4081       export "exe/achmat.xlt":U.
     4082       export "exe/t_form.bas":U.
     4083       export v-acmxl-cell-file-name.
     4084       export v-acmxl-data-file-name.
     4085       output close.
     4086   end procedure.
     4087   run prepare-rep.
     4088   run write-lines.
     4089   run write-cells.
     4090   run close-rep.
     4091   define shared variable no-vat  as logical no-undo.
     4092   define shared variable CostPrice as logical no-undo.
     4093   procedure prepare-rep:
     4094       run get-gds-engl  in parParentProc ( output g#gds-engl ).
     4095       run get-quest-print in parParentProc ( output g#quest-print ).
     4096       run get-report-num  in parParentProc ( output g#report-num ).
     4097   output STREAM Out-Stream to value( string( session:temp-directory +
     4098                                        "rpt" + string( g#report-num ) ) )
     4099                                        page-size  value(43) .
     4100       run acmxl-init.
     4101       put stream Out-Stream UNFORMATTED
     4102           "Отчет доступен только в формате EXCEL"
     4103       .
     4104       find first bf_trn-doc
     4105           where recid(bf_trn-doc) = p-rec-id
     4106           no-lock.
     4107   end.
     4108   procedure close-rep:
     4109       run acmxl-close.
     4110       output stream Out-Stream CLOSE.
     4111   if g#quest-print = false
     4112   then do:
     4113     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
     4114                                         7, (if 8 >= 8 then 2 else 0), 0, 0,
     4115                                         OUTPUT g#log ).
     4116   end.
     4117   else do:
     4118     os-command silent
     4119       value( "COPY /b " +
     4120         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
     4121         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
     4122         string( session:temp-directory) +  "$" + string( g#report-num )
     4123                 ) .
     4124     os-command silent
     4125       value( "COPY /b " +
     4126         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
     4127         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
     4128         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
     4129                 ) .
     4130   end.
     4131   end.
     4132   procedure write-cells:
     4133       define variable v-host-code as integer no-undo.
     4134       define variable v-sum-str as character no-undo.
     4135       find first bf_clients
     4136           where bf_clients.obj-code = bf_trn-doc.obj-code
     4137           and bf_clients.obj-type = bf_trn-doc.obj-type
     4138           no-lock.
     4139       run acmxl-write-cell-data("h_obj_name":U, bf_clients.obj-name).
     4140       run acmxl-write-cell-data("h_obj_name_2":U, bf_clients.obj-name).
     4141       v-host-code = bf_clients.host-code.
     4142       find first bf_clients
     4143           where bf_clients.obj-code = v-host-code
     4144           and bf_clients.obj-type = 'орг':U
     4145           no-lock.
     4146       run acmxl-write-cell-data("h_firm_name":U, bf_clients.obj-name).
     4147       run acmxl-write-cell-data("h_doc_code":U,  bf_trn-doc.doc-code).
     4148       run acmxl-write-cell-data("h_doc_date":U, string(bf_trn-doc.doc-date, "99/99/99")).
     4149       if bf_trn-doc.wrkr <> ? then do:
     4150           find first bf_clients
     4151               where bf_clients.obj-code = bf_trn-doc.wrkr
     4152               and bf_clients.obj-type = 'чел':U
     4153               no-lock.
     4154           run acmxl-write-cell-data("h_mgr_name":U, bf_clients.obj-name).
     4155       end.
     4156       if bf_trn-doc.agnt <> ? then do:
     4157           find first bf_clients
     4158               where bf_clients.obj-code = bf_trn-doc.agnt
     4159               and bf_clients.obj-type = 'чел':U
     4160               no-lock.
     4161           run acmxl-write-cell-data("h_performer_name":U, bf_clients.obj-name).
     4162       end.
     4163       if bf_trn-doc.boss <> ? then do:
     4164           find first bf_clients
     4165               where bf_clients.obj-code = bf_trn-doc.boss
     4166               and bf_clients.obj-type = 'чел':U
     4167               no-lock.
     4168           run acmxl-write-cell-data("h_stock_name":U, bf_clients.obj-name).
     4169       end.
     4170       v-doc-sum = 0 - v-doc-sum.
     4171       run acmxl-write-cell-data("h_sum_all":U, v-doc-sum).
     4172       run rep/wp-rub.p(input v-doc-sum, output v-PropisSumall, output v-abbr).
     4173       run acmxl-write-cell-data("h_sum_str":U, v-PropisSumall).
     4174       v-doc-qnty = 0 - v-doc-qnty.
     4175       run acmxl-write-cell-data("h_qnty_all":U, v-doc-qnty).
     4176   end.
     4177   procedure write-lines:
     4178       define variable v-line-num as integer no-undo.
     4179       find first bf_trn-reason
     4180           where bf_trn-reason.reason-code = bf_trn-doc.reason-code
     4181           no-lock no-error.
     4182       for each bf_doc-line
     4183           where bf_doc-line.doc-code = bf_trn-doc.doc-code
     4184           no-lock:
     4185           find first bf_goods
     4186               where bf_goods.artic = bf_doc-line.artic
     4187               and bf_goods.prod-code = bf_doc-line.prod-code
     4188               and bf_goods.prod-type = bf_doc-line.prod-type
     4189               no-lock.
     4190           find first bf_doc-line-sum
     4191               where bf_doc-line-sum.doc-code = bf_trn-doc.doc-code
     4192               and bf_doc-line-sum.gds-code = bf_goods.gds-code
     4193               and bf_doc-line-sum.sum-type = 'gen':U
     4194               no-lock.
     4195           v-line-num = v-line-num + 1.
     4196           v-doc-qnty = v-doc-qnty + bf_doc-line.fact-qnty.
     4197           v-doc-sum = v-doc-sum + if no-vat then bf_doc-line-sum.cost-sum-rubl - bf_doc-line-sum.cost-VAT-rubl
     4198                                       else  if Costprice then bf_doc-line-sum.cost-sum-rubl
     4199                                                 else bf_doc-line-sum.crsa-sum-rubl.
     4200           run acmxl-sheet1-write-line-data(
     4201                   v-line-num,
     4202                   bf_goods.gds-name,
     4203                   bf_goods.artic,
     4204                   bf_trn-doc.fact-date,
     4205                   bf_goods.unit-base,
     4206                   0 - bf_doc-line.fact-qnty,
     4207                   if bf_doc-line.fact-qnty = 0 then 0
     4208                       else if no-vat then (bf_doc-line-sum.cost-sum-rubl - bf_doc-line-sum.cost-VAT-rubl) / bf_doc-line.fact-qnty
     4209                                else if Costprice then bf_doc-line-sum.cost-sum-rubl / bf_doc-line.fact-qnty
     4210                                         else bf_doc-line-sum.crsa-sum-rubl / bf_doc-line.fact-qnty ,
     4211                   if no-vat then 0 - (bf_doc-line-sum.cost-sum-rubl - bf_doc-line-sum.cost-VAT-rubl)
     4212                       else if Costprice then 0 - (bf_doc-line-sum.cost-sum-rubl)
     4213                                else 0 - (bf_doc-line-sum.crsa-sum-rubl),
     4214                   if avail bf_trn-reason then bf_trn-reason.reason-name else ""
     4215               ).
     4216       end.
     4217   end.
