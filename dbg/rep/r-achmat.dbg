     1753   procedure torgconf-get-sup-param :
     1754   define input parameter p-obj-type           as character        no-undo.
     1755   define input parameter p-obj-code           as integer          no-undo.
     1756   define input parameter p-curr-code          as integer          no-undo.
     1757       define variable v-host-code    as integer      no-undo.
     1758       define variable v-par-type     as character    no-undo.
     1759   do
     1760   on error undo, return error
     1761   :
     1762       assign
     1763          v-torgconf-sup-host-code = v-host-code
     1764       .
     1765       if v-torgconf-sup-host-code = 0
     1766       then do:
     1767           assign
     1768               v-torgconf-sup-host-name           = "":U
     1769               v-torgconf-sup-host-addres         = "":U
     1770               v-torgconf-sup-host-post-addres    = "":U
     1771               v-torgconf-sup-host-phone          = "":U
     1772               v-torgconf-sup-host-inn            = "":U
     1773               v-torgconf-sup-host-kpp            = "":U
     1774               v-torgconf-sup-host-okpo           = "":U
     1775               v-torgconf-sup-host-egrip-date     = "":U
     1776               v-torgconf-sup-host-egrip-num      = "":U
     1777           .
     1778       end.
     1779       else do:
     1780           run fmtcli-get-client in this-procedure (
     1781                 input 'орг':U
     1782               , input v-torgconf-sup-host-code
     1783           ).
     1784           assign
     1785               v-torgconf-sup-host-name        = v-fmtcli-name
     1786               v-torgconf-sup-host-engl-name   = v-fmtcli-engl-name
     1787               v-torgconf-sup-host-addres      = v-fmtcli-full-addres
     1788               v-torgconf-sup-host-post-addres = v-fmtcli-post-addres
     1789               v-torgconf-sup-host-phone       = v-fmtcli-phone
     1790               v-torgconf-sup-host-inn         = v-fmtcli-inn
     1791               v-torgconf-sup-host-kpp         = v-fmtcli-kpp
     1792               v-torgconf-sup-host-okpo        = v-fmtcli-okpo
     1793           .
     1794           run gbl/clntat-v.p (
     1795                 input 'орг':U
     1796               , input v-torgconf-sup-host-code
     1797               , input 'egrip-date':U
     1798               , output v-torgconf-sup-host-egrip-date
     1799               , output v-par-type
     1800           ).
     1801           run gbl/clntat-v.p (
     1802                 input 'орг':U
     1803               , input v-torgconf-sup-host-code
     1804               , input 'egrip-num':U
     1805               , output v-torgconf-sup-host-egrip-num
     1806               , output v-par-type
     1807           ).
     1808           run fmtcli-get-bank in this-procedure (
     1809                 input v-host-code
     1810               , input 'орг':U
     1811               , input v-torgconf-sup-host-code
     1812               , input p-curr-code
     1813           ).
     1814       end.
     1815       assign
     1816           v-torgconf-sup-schet-exists = v-fmtcli-schet-exists
     1817           v-torgconf-sup-bank-exists  = v-fmtcli-bank-exists
     1818           v-torgconf-sup-bank-r-schet = v-fmtcli-bank-r-schet
     1819           v-torgconf-sup-bank-c-schet = v-fmtcli-bank-c-schet
     1820           v-torgconf-sup-bank-bik     = v-fmtcli-bank-bik
     1821           v-torgconf-sup-bank-name    = v-fmtcli-bank-name
     1822           v-torgconf-sup-bank-addres  = v-fmtcli-bank-addres
     1823           v-torgconf-sup-bank-city    = v-fmtcli-bank-city
     1824       .
     1825       assign
     1826           v-torgconf-sup-obj-type = p-obj-type
     1827           v-torgconf-sup-obj-code = p-obj-code
     1828       .
     1829       if trim(p-obj-type) <> ""
     1830       and p-obj-code <> 0
     1831       then do:
     1832       run fmtcli-get-client in this-procedure (
     1833             input p-obj-type
     1834           , input p-obj-code
     1835       ).
     1836       assign
     1837           v-torgconf-sup-obj-name        = v-fmtcli-name
     1838           v-torgconf-sup-obj-engl-name   = v-fmtcli-engl-name
     1839           v-torgconf-sup-obj-addres      = v-fmtcli-full-addres
     1840           v-torgconf-temp-post-addres    = v-fmtcli-post-addres
     1841           v-torgconf-sup-obj-phone       = v-fmtcli-phone
     1842           v-torgconf-sup-obj-inn         = v-fmtcli-inn
     1843           v-torgconf-sup-obj-okpo        = v-fmtcli-okpo
     1844       .
     1845      end.
     1846      end.
     1847   end procedure.
     1848   procedure torgconf-get-cli-param :
     1849   define input parameter p-host-obj-code      as integer          no-undo.
     1850   define input parameter p-obj-type           as character        no-undo.
     1851   define input parameter p-obj-code           as integer          no-undo.
     1852   define input parameter p-curr-code          as integer          no-undo.
