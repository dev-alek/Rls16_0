     1864       ).
     1865       assign
     1866           v-torgconf-cli-name         = trim( v-fmtcli-name          )
     1867           v-torgconf-cli-engl-name    = trim( v-fmtcli-engl-name          )
     1868           v-torgconf-cli-addres       = trim( v-fmtcli-full-addres   )
     1869           v-torgconf-cli-post-addres  = trim( v-fmtcli-post-addres   )
     1870           v-torgconf-cli-phone        = trim( v-fmtcli-phone         )
     1871           v-torgconf-cli-inn          = trim( v-fmtcli-inn           )
     1872           v-torgconf-cli-kpp          = trim( v-fmtcli-kpp           )
     1873           v-torgconf-cli-okpo         = trim( v-fmtcli-okpo          )
     1874       .
     1875      run fmtcli-get-bank in this-procedure (
     1876             input p-host-obj-code
     1877           , input p-obj-type
     1878           , input p-obj-code
     1879           , input p-curr-code
     1880       ).
     1881       assign
     1882           v-torgconf-cli-schet-exists = v-fmtcli-schet-exists
     1883           v-torgconf-cli-bank-exists  = v-fmtcli-bank-exists
     1884           v-torgconf-cli-bank-r-schet = v-fmtcli-bank-r-schet
     1885           v-torgconf-cli-bank-c-schet = v-fmtcli-bank-c-schet
     1886           v-torgconf-cli-bank-bik     = v-fmtcli-bank-bik
     1887           v-torgconf-cli-bank-name    = v-fmtcli-bank-name
     1888           v-torgconf-cli-bank-addres  = v-fmtcli-bank-addres
     1889           v-torgconf-cli-bank-city    = v-fmtcli-bank-city
     1890       .
     1891   end.
     1892   end procedure.
     1893   procedure torgconf-get-ship-param :
     1894   define input parameter p-host-obj-code      as integer          no-undo.
     1895   define input parameter p-obj-type           as character        no-undo.
     1896   define input parameter p-obj-code           as integer          no-undo.
     1897   define input parameter p-curr-code          as integer          no-undo.
     1898       define variable v-host-code    as integer      no-undo.
     1899   do
     1900   on error undo, return error
     1901   :
     1902       assign
     1903           v-torgconf-ship-type = p-obj-type
     1904           v-torgconf-ship-code = p-obj-code
     1905       .
     1906       if trim(p-obj-type) = ""
     1907       and p-obj-code = 0
     1908       then do:
     1909       assign
     1910           v-torgconf-ship-name         = "":U
     1911           v-torgconf-ship-addres       = "":U
     1912           v-torgconf-ship-post-addres  = "":U
     1913           v-torgconf-ship-phone        = "":U
     1914           v-torgconf-ship-inn          = "":U
     1915           v-torgconf-ship-kpp          = "":U
     1916           v-torgconf-ship-okpo         = "":U
     1917       .
     1918       end.
     1919       else do:
     1920       run fmtcli-get-client in this-procedure (
     1921             input p-obj-type
     1922           , input p-obj-code
     1923       ).
     1924       assign
     1925           v-torgconf-ship-name         = trim( v-fmtcli-name          )
     1926           v-torgconf-ship-engl-name    = trim( v-fmtcli-engl-name          )
     1927           v-torgconf-ship-addres       = trim( v-fmtcli-full-addres   )
     1928           v-torgconf-ship-post-addres  = trim( v-fmtcli-post-addres   )
     1929           v-torgconf-ship-phone        = trim( v-fmtcli-phone         )
     1930           v-torgconf-ship-inn          = trim( v-fmtcli-inn           )
     1931           v-torgconf-ship-kpp          = trim( v-fmtcli-kpp           )
     1932           v-torgconf-ship-okpo         = trim( v-fmtcli-okpo          )
     1933       .
     1934       end.
     1935           run fmtcli-get-bank in this-procedure (
     1936             input p-host-obj-code
     1937           , input p-obj-type
     1938           , input p-obj-code
     1939           , input p-curr-code
     1940       ).
     1941       assign
     1942           v-torgconf-ship-schet-exists = v-fmtcli-schet-exists
     1943           v-torgconf-ship-bank-exists  = v-fmtcli-bank-exists
     1944           v-torgconf-ship-bank-r-schet = v-fmtcli-bank-r-schet
     1945           v-torgconf-ship-bank-c-schet = v-fmtcli-bank-c-schet
     1946           v-torgconf-ship-bank-bik     = v-fmtcli-bank-bik
     1947           v-torgconf-ship-bank-name    = v-fmtcli-bank-name
     1948           v-torgconf-ship-bank-addres  = v-fmtcli-bank-addres
     1949           v-torgconf-ship-bank-city    = v-fmtcli-bank-city
     1950       .
     1951   end.
     1952   end procedure.
     1953   procedure torgconf-get-holdfirm-code :
     1954   define input parameter p-obj-type   as character        no-undo.
     1955   define input parameter p-obj-code   as integer          no-undo.
     1956   define output parameter p-firm-code as integer          no-undo.
     1957       define variable v-firm-code-str     as character    no-undo.
     1958       define variable v-par-type          as character    no-undo.
     1959       define buffer buf_clients       for ub.clients.
     1960   do
     1961   for buf_clients
     1962   on error undo, return error
     1963   :
     1964       run gbl/clntat-v.p (
     1965             input p-obj-type
     1966           , input p-obj-code
     1967           , input 'holdfirm-code':U
     1968           , output v-firm-code-str
     1969           , output v-par-type
     1970       ).
     1971       assign
     1972           p-firm-code = integer( v-firm-code-str )
     1973       no-error.
     1974       if error-status :error
     1975       then do:
     1976           message
     1977               "Неверно задан код фирмы для печати накладных."
     1978           view-as alert-box warning.
     1979           assign
     1980               p-firm-code = 0
     1981           .
     1982       end.
     1983       else do:
     1984           find first buf_clients no-lock
     1985                where buf_clients.obj-type = 'орг':U
     1986                  and buf_clients.obj-code = p-firm-code
     1987           no-error.
     1988           if not available buf_clients
     1989           then do:
     1990               message
     1991                   "Включен параметр 'Список печатных форм, для которых должна быть задана фирма для печати накладных' (outhold)" skip
     1992                   "Не найдена фирма по заданному коду фирмы для печати накладных."
     1993               view-as alert-box warning.
     1994               assign
     1995                   p-firm-code = 0
     1996               .
     1997           end.
     1998       end.
     1999   end.
     2000   end procedure.
     2001   procedure torgconf-get-post-head:
     2002   define input  parameter p-obj-type             as character        no-undo.
     2003   define input  parameter p-obj-code             as integer          no-undo.
     2004   define output parameter p-torgconf-post-head   as character        no-undo.
     2005      define variable v-host-code         as integer      no-undo.
     2006      define buffer buf_sysconf     for ub.sysconf.
     2007        assign
     2008         p-torgconf-post-head  = ""
     2009        .
     2010   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2011   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2012     (input  p-obj-type
     2013     ,input  p-obj-code
     2014     ,output v-host-code
     2015     )  .
     2016      find first buf_sysconf no-lock
     2017      where buf_sysconf.host-code = v-host-code
     2018      no-error.
     2019      if available buf_sysconf
     2020      then do:
     2021         assign
     2022            p-torgconf-post-head = buf_sysconf.head-position
     2023         .
     2024      end.
     2025   end procedure.
     2026   procedure torgconf-get-storekeeper:
     2027   define input  parameter p-wrkr                   as integer          no-undo.
     2028   define output parameter p-torgconf-wrkr-name     as character        no-undo.
     2029   define output parameter p-torgconf-post          as character        no-undo.
     2030      define buffer buf_sysconf     for ub.sysconf.
     2031      define buffer buf_person      for ub.person.
     2032      define buffer buf_shop        for ub.shop .
     2033      define buffer buf_store       for ub.store .
     2034      if v-torgconf-outC = "no_print"
     2035      then do:
     2036         assign p-torgconf-post = ""
     2037                p-torgconf-wrkr-name = ""
     2038                .
     2039      end.
     2040      if v-torgconf-outC = "clad_doc"
     2041      then do:
     2042         run rep/get-psn.p
     2043               (input  p-wrkr
     2044               ,output p-torgconf-wrkr-name
     2045               ) .
     2046         find first buf_person no-lock
     2047         where buf_person.psn-code = p-wrkr
     2048         no-error.
     2049         if available buf_person
     2050         then do:
     2051           p-torgconf-post = buf_person.position.
     2052         end.
     2053         if p-torgconf-post = "?":U then p-torgconf-post = "".
     2054         if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2055      end.
     2056      if v-torgconf-outC = "clad_obj"
     2057      then do:
     2058         CASE v-torgconf-self-obj-type:
     2059         WHEN 'маг':U
     2060         THEN DO:
     2061            find first buf_shop no-lock
     2062            where buf_shop.obj-code = v-torgconf-self-obj-code
     2063            .
     2064            assign
     2065               p-torgconf-wrkr-name = buf_shop.store-man
     2066               p-torgconf-post = ""
     2067            .
     2068            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2069         END.
     2070         WHEN 'скл':U
     2071         THEN DO:
     2072            find first buf_store no-lock
     2073            where buf_store.obj-code = v-torgconf-self-obj-code
     2074            .
     2075            assign
     2076               p-torgconf-wrkr-name = buf_store.store-man
     2077               p-torgconf-post = ""
     2078            .
     2079            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2080         END.
     2081         OTHERWISE DO:
     2082            assign
     2083               p-torgconf-post = "":U
     2084               p-torgconf-wrkr-name = "":U
     2085            .
     2086         END.
     2087         END CASE.
     2088      end.
     2089    end procedure.
     2090   procedure torgconf-get-form-header :
     2091   define input parameter p-for-inverse    as logical          no-undo.
     2092   define input parameter p-doc-code       as character        no-undo.
     2093   define input parameter p-print-doc      as logical          no-undo.
     2094   define input parameter p-doc-date       as date             no-undo.
     2095   define input parameter p-fact-date      as date             no-undo.
     2096   define input parameter p-doc-type       as character        no-undo.
     2097   define input parameter p-status_        as character        no-undo.
     2098   define input parameter p-reverse        as logical          no-undo.
     2099   define input parameter p-sf-par         as logical          no-undo.
     2100       define variable v-attr-type         as character    no-undo.
     2101       define variable v-doc-code-standard as logical      no-undo.
     2102       define variable v-doc-date-standard as logical      no-undo.
     2103       define variable v-par-consignee-addres  as character    no-undo.
     2104       define variable v-host-code         as integer      no-undo.
     2105       define variable v-dcode-attr        as character    no-undo.
     2106       define variable v-ddate-attr        as character    no-undo.
     2107       define variable v-doc-date          as character    no-undo.
     2108       define variable v-doc-code          as character    no-undo.
     2109       define variable v-par-type          as character    no-undo.
     2110       define variable v-attr              as character    no-undo.
     2111       define buffer buf_firm          for ub.firm .
     2112       define buffer buf_clients       for ub.clients .
     2113       define buffer buf_sysconf       for ub.sysconf .
     2114       define buffer buf_shop          for ub.shop .
     2115       define buffer buf_store         for ub.store .
     2116       define buffer buf_person        for ub.person .
     2117       define buffer buf_trn-doc       for ub.trn-doc .
     2118       define buffer buf_wth-doc       for ub.wth-doc .
     2119       do
     2120   for buf_firm
     2121     , buf_clients
     2122     , buf_sysconf
     2123     , buf_shop
     2124     , buf_trn-doc
     2125     , buf_person
     2126     , buf_wth-doc
     2127   on error undo, return error
     2128   :
     2129       if p-doc-type = 'при':U
     2130       or p-doc-type = 'возврат':U
     2131       then do:
     2132           assign
     2133               v-torgconf-supplier         = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     2134                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     2135               v-torgconf-suppi            = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     2136                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     2137               v-torgconf-saler            = substitute( "&1&2&3&4&5", v-torgconf-self-host-name, ( if v-torgconf-self-host-addres = "":U then "":U else ", " ),
     2138                                             v-torgconf-self-host-addres, ( if v-torgconf-self-host-phone = "":U then "":U else ", " ),v-torgconf-self-host-phone )
     2139               v-torgconf-consignee        = substitute( "&1&2&3&4&5", v-torgconf-sup-host-name, ( if v-torgconf-sup-host-addres = "":U then "":U else ", " ),
     2140                                             v-torgconf-sup-host-addres, ( if v-torgconf-sup-host-phone = "":U then "":U else ", " ), v-torgconf-sup-host-phone  )
     2141               v-torgconf-supplier-okpo    = v-torgconf-cli-okpo
     2142               v-torgconf-saler-okpo       = v-torgconf-self-host-okpo
     2143               v-torgconf-consignee-okpo   = v-torgconf-sup-host-okpo
     2144               v-torgconf-supplier-code    = substitute( "&1", v-torgconf-cli-code         )
     2145               v-torgconf-supplier-type    = v-torgconf-cli-type
     2146               v-torgconf-saler-code       = substitute( "&1", v-torgconf-self-host-code   )
     2147               v-torgconf-saler-type       = v-torgconf-self-host-type
     2148               v-torgconf-consignee-code   = substitute( "&1", v-torgconf-sup-host-code   )
     2149               v-torgconf-consignee-type   = v-torgconf-sup-host-type
     2150               v-torgconf-supplier-name    = substitute( "&1", v-torgconf-cli-name         )
     2151               v-torgconf-saler-name       = substitute( "&1", v-torgconf-self-host-name   )
     2152               v-torgconf-consignee-name   = substitute( "&1", v-torgconf-sup-host-name   )
     2153               v-torgconf-supplier-addr    = substitute( "&1", v-torgconf-cli-addres       )
     2154               v-torgconf-saler-addr       = substitute( "&1", v-torgconf-self-host-addres )
     2155               v-torgconf-consignee-addr   = substitute( "&1", v-torgconf-sup-host-addres )
     2156               v-torgconf-supplier-inn     = substitute( "&1", v-torgconf-cli-inn          )
     2157               v-torgconf-supplier-engl-name     = substitute( "&1", v-torgconf-cli-engl-name          )
     2158               v-torgconf-saler-inn        = substitute( "&1", v-torgconf-self-host-inn    )
     2159               v-torgconf-consignee-inn    = substitute( "&1", v-torgconf-sup-host-inn    )
     2160               v-torgconf-supplier-kpp     = substitute( "&1", v-torgconf-cli-kpp          )
     2161               v-torgconf-saler-kpp        = substitute( "&1", v-torgconf-self-host-kpp    )
     2162               v-torgconf-consignee-kpp    = substitute( "&1", v-torgconf-sup-host-kpp    )
     2163           .
     2164           if v-torgconf-cli-schet-exists = yes
     2165           AND v-form-name                  = "torg12":U
     2166           then do:
     2167               assign
     2168                   v-torgconf-supplier = v-torgconf-supplier
     2169                       + substitute( ", р/с &1 к/с &2"
     2170                                   , v-torgconf-cli-bank-r-schet
     2171                                   , v-torgconf-cli-bank-c-schet
     2172                                   )
     2173                   v-torgconf-suppi = v-torgconf-supplier
     2174                       + substitute( ", р/с &1 к/с &2"
     2175                                   , v-torgconf-cli-bank-r-schet
     2176                                   , v-torgconf-cli-bank-c-schet
     2177                                   )
     2178               .
     2179               if v-torgconf-cli-bank-exists = yes
     2180               then do:
     2181                   assign
     2182                       v-torgconf-supplier = v-torgconf-supplier
     2183                           + substitute( " БИК &1 в &2 &3"
     2184                                       , v-torgconf-cli-bank-bik
     2185                                       , v-torgconf-cli-bank-name
     2186                                       ,(if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     2187                                       )
     2188                      v-torgconf-suppi = v-torgconf-supplier
     2189                           + substitute( " БИК &1 в &2 &3"
     2190                                       , v-torgconf-cli-bank-bik
     2191                                       , v-torgconf-cli-bank-name
     2192                                       ,(if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     2193                                       )
     2194                   .
     2195               end.
     2196           end.
     2197           if v-torgconf-self-schet-exists = yes
     2198           AND v-form-name                  = "torg12":U
     2199           then do:
     2200               assign
     2201                   v-torgconf-saler = v-torgconf-saler
     2202                       + substitute( ", р/с &1 к/с &2"
     2203                                   , v-torgconf-self-bank-r-schet
     2204                                   , v-torgconf-self-bank-c-schet
     2205                                   )
     2206               .
     2207               if v-torgconf-self-bank-exists = yes
     2208               then do:
     2209                   assign
     2210                       v-torgconf-saler = v-torgconf-saler
     2211                           + substitute( " БИК &1 в &2 &3"
     2212                                       , v-torgconf-self-bank-bik
     2213                                       , v-torgconf-self-bank-name
     2214                                       , v-torgconf-self-bank-addres
     2215                                       )
     2216                   .
     2217               end.
     2218           end.
     2219           if v-torgconf-sup-schet-exists = yes
     2220           AND v-form-name                  = "torg12":U
     2221           then do:
     2222               assign
     2223                   v-torgconf-consignee = v-torgconf-consignee
     2224                       + substitute( ", р/с &1 к/с &2"
     2225                                   , v-torgconf-sup-bank-r-schet
     2226                                   , v-torgconf-sup-bank-c-schet
     2227                                   )
     2228               .
     2229             if v-torgconf-sup-bank-exists = yes
     2230              then do:
     2231                assign
     2232                   v-torgconf-consignee = v-torgconf-consignee
     2233                           + substitute( " БИК &1 в &2 &3"
     2234                                       , v-torgconf-sup-bank-bik
     2235                                       , v-torgconf-sup-bank-name
     2236                                       , v-torgconf-sup-bank-addres
     2237                                       )
     2238                   .
     2239               end.
     2240           end.
     2241      if v-torgconf-outares = yes  AND v-form-name  = "torg12":U
     2242      then do:
     2243          assign
     2244            v-torgconf-supplier = substitute(  "&1&2&3 &4 &5&6"
     2245                                                   , IF v-form-name = "torg12":U THEN SUBSTITUTE("ИНН &1 КПП &2 ", v-torgconf-cli-inn, v-torgconf-cli-kpp) ELSE "":U
     2246                                                   , v-torgconf-cli-name
     2247                                                   , ( if v-torgconf-outprncd = yes
     2248                                                         then substitute( " (&1)", v-torgconf-cli-code )
     2249                                                         else "":U )
     2250                                                   , v-torgconf-cli-post-addres
     2251                                                   , v-torgconf-cli-phone
     2252                                                   , ( if v-torgconf-cli-bank-r-schet <> "":U
     2253                                                       AND v-form-name                  = "torg12":U
     2254                                                         then substitute( ", р/с &1 к/с &2, БИК &3 в &4, &5"
     2255                                                               , v-torgconf-cli-bank-r-schet
     2256                                                               , v-torgconf-cli-bank-c-schet
     2257                                                               , v-torgconf-cli-bank-bik
     2258                                                               , v-torgconf-cli-bank-name
     2259                                                               , (if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )     )
     2260                                                         else "":U )
     2261                                                )
     2262         .
     2263      end.
     2264       v-torgconf-suppi = substitute(  "&1&2&3 &4 &5&6"
     2265                                        , IF v-form-name = "torg12":U THEN SUBSTITUTE("ИНН &1 КПП &2 ", v-torgconf-cli-inn, v-torgconf-cli-kpp) ELSE "":U
     2266                                        , v-torgconf-cli-name
     2267                                        , ( if v-torgconf-outprncd = yes
     2268                                            then substitute( " (&1)", v-torgconf-cli-code )
     2269                                            else "":U )
     2270                                        , v-torgconf-cli-addres
     2271                                        , v-torgconf-cli-phone
     2272                                        , ( if v-torgconf-cli-bank-r-schet <> "":U
     2273                                            AND v-form-name                  = "torg12":U
     2274                                            then substitute( ", р/с &1 к/с &2, БИК &3 в &4, &5"
     2275                                                           , v-torgconf-cli-bank-r-schet
     2276                                                           , v-torgconf-cli-bank-c-schet
     2277                                                           , v-torgconf-cli-bank-bik
     2278                                                           , v-torgconf-cli-bank-name
     2279                                                           , (if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) ))
     2280                                                   else "":U )
     2281                                        ).
     2282       end.
     2283       else do:
     2284       v-torgconf-suppi = substitute(  "&1&2&3 &4 &5&6"
     2285                                        , IF v-form-name = "torg12":U THEN SUBSTITUTE("ИНН &1 КПП &2 ", v-torgconf-self-host-inn, v-torgconf-self-host-kpp) ELSE "":U
     2286                                        , v-torgconf-self-host-name
     2287                                        , ( if v-torgconf-outprncd = yes
     2288                                            then substitute( " (&1)", v-torgconf-self-host-code )
     2289                                            else "":U )
     2290                                        , v-torgconf-self-host-addres
     2291                                        , v-torgconf-self-host-phone
     2292                                        , ( if v-torgconf-self-bank-r-schet <> "":U
     2293                                            AND v-form-name                  = "torg12":U
     2294                                            then substitute( ", р/с &1 к/с &2, БИК &3 в &4, &5"
     2295                                                           , v-torgconf-self-bank-r-schet
     2296                                                           , v-torgconf-self-bank-c-schet
     2297                                                           , v-torgconf-self-bank-bik
     2298                                                           , v-torgconf-self-bank-name
     2299                                                           , (if v-torgconf-self-bank-city = "":U then "":U else ( "г. " + v-torgconf-self-bank-city) )     )
     2300                                                   else "":U )
     2301                                           ).
     2302         if v-torgconf-outares = yes
     2303         and p-reverse = no
     2304         then do:
     2305            assign
     2306               v-par-consignee-addres = v-torgconf-ship-post-addres
     2307            .
     2308         end.
     2309         if v-torgconf-outares = no
     2310         and p-reverse = no
     2311         then do:
     2312            assign
     2313               v-par-consignee-addres = v-torgconf-ship-addres
     2314            .
     2315         end.
     2316         if p-reverse = yes
     2317         then do:
     2318             assign
     2319               v-par-consignee-addres = v-torgconf-ship-addres
     2320             .
     2321         end.
     2322           assign
     2323               v-torgconf-supplier         = substitute( "&1&2&3&4&5", v-torgconf-self-host-name, ( if v-torgconf-self-host-addres = "":U then "":U else ", " ), v-torgconf-self-host-addres,
     2324                                             ( if v-torgconf-self-host-phone = "":U then "":U else ", " ), v-torgconf-self-host-phone )
     2325               v-torgconf-saler            = substitute( "&1&2&3&4&5", v-torgconf-cli-name      , ( if v-torgconf-cli-addres       = "":U then "":U else ", " ), v-torgconf-cli-addres,
     2326                                             ( if v-torgconf-cli-phone       = "":U then "":U else ", " ), v-torgconf-cli-phone )
     2327               v-torgconf-consignee        = substitute( "&1&2&3&4&5", v-torgconf-ship-name      , ( if v-par-consignee-addres   = "":U then "":U else ", " ), v-par-consignee-addres,
     2328                                              ( if v-torgconf-ship-phone   = "":U then "":U else ", " ), v-torgconf-ship-phone)
     2329               v-torgconf-supplier-okpo    = v-torgconf-self-host-okpo
     2330               v-torgconf-saler-okpo       = v-torgconf-cli-okpo
     2331               v-torgconf-consignee-okpo   = v-torgconf-ship-okpo
     2332               v-torgconf-supplier-code    = substitute( "&1", v-torgconf-self-host-code   )
     2333               v-torgconf-supplier-code    = v-torgconf-self-host-type
     2334               v-torgconf-saler-code       = substitute( "&1", v-torgconf-cli-code         )
     2335               v-torgconf-saler-type       = v-torgconf-cli-type
     2336               v-torgconf-consignee-code   = substitute( "&1", v-torgconf-ship-code         )
     2337               v-torgconf-consignee-type   = v-torgconf-ship-type
     2338               v-torgconf-supplier-name    = substitute( "&1", v-torgconf-self-host-name   )
     2339               v-torgconf-saler-name       = substitute( "&1", v-torgconf-cli-name         )
     2340               v-torgconf-consignee-name   = substitute( "&1", v-torgconf-ship-name         )
     2341               v-torgconf-supplier-addr    = substitute( "&1", v-torgconf-self-host-addres )
     2342               v-torgconf-saler-addr       = substitute( "&1", v-torgconf-cli-addres       )
     2343               v-torgconf-consignee-addr   = substitute( "&1", v-par-consignee-addres                )
     2344               v-torgconf-supplier-inn     = substitute( "&1", v-torgconf-self-host-inn    )
     2345               v-torgconf-supplier-engl-name     = substitute( "&1", v-torgconf-self-host-engl-name    )
     2346               v-torgconf-saler-inn        = substitute( "&1", v-torgconf-cli-inn          )
     2347               v-torgconf-consignee-inn    = substitute( "&1", v-torgconf-ship-inn          )
     2348               v-torgconf-supplier-kpp     = substitute( "&1", v-torgconf-self-host-kpp    )
     2349               v-torgconf-saler-kpp        = substitute( "&1", v-torgconf-cli-kpp          )
     2350               v-torgconf-consignee-kpp    = substitute( "&1", v-torgconf-ship-kpp          )
     2351               v-torgconf-sf-buyer-name    = v-torgconf-consignee-name
     2352               v-torgconf-sf-buyer-code    = v-torgconf-consignee-code
     2353               v-torgconf-sf-buyer-type    = v-torgconf-consignee-type
     2354               v-torgconf-sf-buyer-addr    = v-torgconf-consignee-addr
     2355           .
     2356           if v-torgconf-self-schet-exists = yes
     2357           AND v-form-name                  = "torg12":U
     2358           then do:
     2359               assign
     2360                   v-torgconf-supplier = v-torgconf-supplier
     2361                       + substitute( ", р/с &1 к/с &2"
     2362                                   , v-torgconf-self-bank-r-schet
     2363                                   , v-torgconf-self-bank-c-schet
     2364                                   )
     2365               .
     2366               if v-torgconf-self-bank-exists = yes
     2367               then do:
     2368                   assign
     2369                       v-torgconf-supplier = v-torgconf-supplier
     2370                           + substitute( " БИК &1 в &2 &3"
     2371                                       , v-torgconf-self-bank-bik
     2372                                       , v-torgconf-self-bank-name
     2373                                       , v-torgconf-self-bank-addres
     2374                                       )
     2375                   .
     2376               end.
     2377           end.
     2378           if v-torgconf-cli-schet-exists = yes
     2379           AND v-form-name                  = "torg12":U
     2380           then do:
     2381               assign
     2382                   v-torgconf-saler = v-torgconf-saler
     2383                       + substitute( ", р/с &1 к/с &2"
     2384                                   , v-torgconf-cli-bank-r-schet
     2385                                   , v-torgconf-cli-bank-c-schet
     2386                                   )
     2387               .
     2388               if v-torgconf-cli-bank-exists = yes
     2389               then do:
     2390                   assign
     2391                       v-torgconf-saler = v-torgconf-saler
     2392                           + substitute( " БИК &1 в &2 &3"
     2393                                       , v-torgconf-cli-bank-bik
     2394                                       , v-torgconf-cli-bank-name
     2395                                       , (if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     2396                                       )
     2397                   .
     2398               end.
     2399           end.
     2400           if v-torgconf-ship-schet-exists = yes
     2401           AND v-form-name                  = "torg12":U
     2402           then do:
     2403               assign
     2404                   v-torgconf-consignee = v-torgconf-consignee
     2405                       + substitute( ", р/с &1 к/с &2"
     2406                                   , v-torgconf-ship-bank-r-schet
     2407                                   , v-torgconf-ship-bank-c-schet
     2408                                   )
     2409               .
     2410               if v-torgconf-ship-bank-exists = yes
     2411               then do:
     2412                   assign
     2413                       v-torgconf-consignee = v-torgconf-consignee
     2414                           + substitute( " БИК &1 в &2  &3"
     2415                                       , v-torgconf-ship-bank-bik
     2416                                       , v-torgconf-ship-bank-name
     2417                                       , (if v-torgconf-ship-bank-city = "":U then "":U else ( "г. " + v-torgconf-ship-bank-city) )
     2418                                       )
     2419                   .
     2420               end.
     2421           end.
     2422      if p-reverse = yes
     2423         then do:
     2424          if  v-torgconf-outares = yes then v-torgconf-saler = substitute( "&1&2&3", v-torgconf-cli-name      , ( if v-torgconf-cli-post-addres       = "":U then "":U else ", " ), v-torgconf-cli-post-addres       )
     2425            .
     2426          else v-torgconf-saler = substitute( "&1&2&3", v-torgconf-cli-name      , ( if v-torgconf-cli-addres       = "":U then "":U else ", " ), v-torgconf-cli-addres       ) .
     2427                 if v-torgconf-cli-schet-exists = yes
     2428                 AND v-form-name                  = "torg12":U
     2429                     then do:
     2430                           assign
     2431                              v-torgconf-saler = v-torgconf-saler
     2432                                 + substitute( ", р/с &1 к/с &2"
