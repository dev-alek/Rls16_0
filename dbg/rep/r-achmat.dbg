      242   define variable v-fmtcli-bank-exists   as logical      no-undo.
      243   define variable v-fmtcli-bank-r-schet  as character    no-undo.
      244   define variable v-fmtcli-bank-c-schet  as character    no-undo.
      245   define variable v-fmtcli-bank-bik      as character    no-undo.
      246   define variable v-fmtcli-bank-name     as character    no-undo.
      247   define variable v-fmtcli-bank-addres   as character    no-undo.
      248   define variable v-fmtcli-bank-city     as character    no-undo.
      249   procedure fmtcli-get-bank :
      250   define input parameter p-host-code      as integer          no-undo.
      251   define input parameter p-obj-type       as character        no-undo.
      252   define input parameter p-obj-code       as integer          no-undo.
      253   define input parameter p-curr-code      as integer          no-undo.
      254       define buffer buf_fin-schet     for ub.fin-schet.
      255       define buffer buf_fin-bank      for ub.fin-bank.
      256   do
      257   for buf_fin-schet
      258     , buf_fin-bank
      259   on error undo, return error
      260   :
      261       assign
      262           v-fmtcli-schet-exists       = no
      263           v-fmtcli-bank-exists        = no
      264           v-fmtcli-bank-r-schet       = "":U
      265           v-fmtcli-bank-c-schet       = "":U
      266           v-fmtcli-bank-bik           = "":U
      267           v-fmtcli-bank-name          = "":U
      268           v-fmtcli-bank-addres        = "":U
      269           v-fmtcli-bank-city          = "":U
      270       .
      271       search-for-schet:
      272       for each buf_fin-schet no-lock
      273          where buf_fin-schet.host-code = p-host-code
      274            and buf_fin-schet.cli-type  = p-obj-type
      275            and buf_fin-schet.cli-code  = p-obj-code
      276            and buf_fin-schet.curr-code = p-curr-code
      277       on error undo, return error
      278       :
      279           if buf_fin-schet.status_   = 'удал':U
      280           then do:
      281           end.
      282           else do:
      283               assign
      284                   v-fmtcli-schet-exists   = yes
      285                   v-fmtcli-bank-r-schet   = trim( buf_fin-schet.r-schet )
      286                   v-fmtcli-bank-c-schet   = trim( buf_fin-schet.c-schet )
      287               .
      288               find first buf_fin-bank no-lock
      289                    where buf_fin-bank.host-code = p-host-code
      290                      and buf_fin-bank.code-bank = buf_fin-schet.code-bank
      291               no-error.
      292               if available buf_fin-bank
      293               then do:
      294                   assign
      295                       v-fmtcli-bank-exists      = yes
      296                       v-fmtcli-bank-bik         = trim( buf_fin-bank.bik )
      297                       v-fmtcli-bank-name        = trim( buf_fin-bank.bank-name )
      298                       v-fmtcli-bank-addres      = trim(buf_fin-bank.addres)
      299                       v-fmtcli-bank-city      = trim(buf_fin-bank.bank-city)
      300                   .
      301               end.
      302               else do:
      303                   assign
      304                       v-fmtcli-bank-exists    = no
      305                       v-fmtcli-bank-bik       = "":U
      306                       v-fmtcli-bank-name      = "":U
      307                       v-fmtcli-bank-addres    = "":U
      308                       v-fmtcli-bank-city      = "":U
      309                   .
      310               end.
      311               leave search-for-schet.
      312           end.
      313       end.
      314   end.
      315   end procedure.
      316   procedure fmtcli-get-client :
      317   define input parameter p-obj-type       as character    no-undo.
      318   define input parameter p-obj-code       as integer      no-undo.
      319       define variable v-temp-fmtcli-address      as character     no-undo.
      320       define variable v-num-country-city    as integer      no-undo.
      321       define buffer buf_clients   for ub.clients.
      322       define buffer buf_firm      for ub.firm.
      323       define buffer buf_store     for ub.store.
      324       define buffer buf_shop      for ub.shop.
      325       define buffer buf_person    for ub.person.
      326   do
      327   for buf_clients
      328     , buf_firm
      329     , buf_store
      330     , buf_shop
      331     , buf_person
      332   on error undo, return error
      333   :
      334       assign
      335           v-fmtcli-name           = "":U
      336           v-fmtcli-addres         = "":U
      337           v-fmtcli-post-addres    = "":U
      338           v-fmtcli-full-addres    = "":U
      339           v-fmtcli-phone          = "":U
      340           v-fmtcli-inn            = "":U
      341           v-fmtcli-kpp            = "":U
      342           v-fmtcli-okpo           = "":U
      343           v-fmtcli-city           = "":U
      344           v-fmtcli-index          = "":U
      345           v-fmtcli-country        = "":U
      346       .
      347       find first buf_clients no-lock
      348            where buf_clients.obj-type = p-obj-type
      349              and buf_clients.obj-code = p-obj-code
      350       .
      351       assign
      352           v-fmtcli-name = buf_clients.obj-name
      353       .
      354       case buf_clients.obj-type:
      355          when 'орг':U
      356          then do:
      357               find first buf_firm no-lock
      358                    where buf_firm.firm-code = buf_clients.obj-code
      359                    no-error
      360               .
      361               if available buf_firm
      362               then do:
      363                   assign
      364                       v-num-country-city = num-entries( buf_firm.city )
      365                       v-fmtcli-engl-name = buf_firm.engl-name
      366                   .
      367                   if v-num-country-city > 0
      368                   then do:
      369                       assign
      370                           v-fmtcli-country    = trim( entry( 1, buf_firm.city ) )
      371                       .
      372                   end.
      373                   if v-num-country-city > 1
      374                   then do:
      375                       assign
      376                           v-fmtcli-city       = trim( entry( 2, buf_firm.city ) )
      377                       .
      378                   end.
      379                   run fmtcli-concatenate-strings in this-procedure (
      380                         input v-fmtcli-full-addres
      381                       , input v-fmtcli-country
      382                       , input ", ":U
      383                       , input 50
      384                       , output v-fmtcli-full-addres
      385                   ).
      386                   run fmtcli-concatenate-strings in this-procedure (
      387                         input v-fmtcli-full-addres
      388                       , input v-fmtcli-city
      389                       , input ", ":U
      390                       , input 50
      391                       , output v-fmtcli-full-addres
      392                   ).
      393                   run fmtcli-concatenate-strings in this-procedure (
      394                         input v-fmtcli-full-addres
      395                       , input IF buf_firm.ind = 0 THEN "" ELSE string( buf_firm.ind )
      396                       , input ", ":U
      397                       , input 50
      398                       , output v-fmtcli-full-addres
      399                   ).
      400                   run fmtcli-concatenate-strings in this-procedure (
      401                         input v-fmtcli-post-addres
      402                       , input v-fmtcli-country
      403                       , input ", ":U
      404                       , input 50
      405                       , output v-fmtcli-post-addres
      406                   ).
      407                   run fmtcli-concatenate-strings in this-procedure (
      408                         input v-fmtcli-post-addres
      409                       , input v-fmtcli-city
      410                       , input ", ":U
      411                       , input 50
      412                       , output v-fmtcli-post-addres
      413                   ).
      414                   run fmtcli-concatenate-strings in this-procedure (
      415                         input v-fmtcli-post-addres
      416                       , input string( buf_firm.ind )
      417                       , input ", ":U
      418                       , input 50
      419                       , output v-fmtcli-post-addres
      420                   ).
      421                   run fmtcli-concatenate-strings in this-procedure (
      422                         input substring( buf_firm.addres1, 1, 50 )
      423                       , input buf_firm.addres2
      424                       , input " ":U
      425                       , input 50
      426                       , output v-temp-fmtcli-address
      427                   ).
      428                   run fmtcli-concatenate-strings in this-procedure (
      429                         input v-temp-fmtcli-address
      430                       , input substring( buf_firm.addres1, 51, 50 )
      431                       , input " ":U
      432                       , input 50
      433                       , output v-temp-fmtcli-address
      434                   ).
      435                   run fmtcli-concatenate-strings in this-procedure (
      436                         input v-temp-fmtcli-address
      437                       , input substring( buf_firm.addres1, 101, 50 )
      438                       , input " ":U
      439                       , input 50
      440                       , output v-temp-fmtcli-address
      441                   ).
      442                   assign
      443                       v-fmtcli-addres = v-temp-fmtcli-address
      444                   .
      445                   if buf_firm.addres1 <> ?
      446                   then do:
      447                       run fmtcli-concatenate-strings in this-procedure (
      448                             input v-fmtcli-full-addres
      449                           , input v-fmtcli-addres
      450                           , input ", ":U
      451                           , input 0
      452                           , output v-fmtcli-full-addres
      453                       ).
      454                   end.
      455                   run fmtcli-concatenate-strings in this-procedure (
      456                         input substring( buf_firm.post-addr1, 1, 50 )
      457                       , input buf_firm.post-addr2
      458                       , input " ":U
      459                       , input 50
      460                       , output v-fmtcli-post-addres
      461                   ).
      462                   run fmtcli-concatenate-strings in this-procedure (
      463                         input v-fmtcli-post-addres
      464                       , input substring( buf_firm.post-addr1, 51, 50 )
      465                       , input " ":U
      466                       , input 50
      467                       , output v-fmtcli-post-addres
      468                   ).
      469                   run fmtcli-concatenate-strings in this-procedure (
      470                         input v-fmtcli-post-addres
      471                       , input substring( buf_firm.post-addr1, 101, 50 )
      472                       , input " ":U
      473                       , input 50
      474                       , output v-fmtcli-post-addres
      475                   ).
      476                   assign
      477                       v-fmtcli-phone         = buf_firm.phone
      478                       v-fmtcli-inn           = buf_firm.inn
      479                       v-fmtcli-kpp           = buf_firm.kpp
      480                       v-fmtcli-okpo          = buf_firm.okpo
      481                       v-fmtcli-index         = string( buf_firm.ind )
      482                   .
      483               end.
      484          end.
      485          when 'маг':U
      486          then do:
      487               find first buf_shop no-lock
      488                    where buf_shop.obj-code = buf_clients.obj-code
      489               .
      490               if available buf_shop
      491               then do:
      492                   run fmtcli-concatenate-strings in this-procedure (
      493                         input buf_shop.addres1
      494                       , input buf_shop.addres2
      495                       , input " ":U
      496                       , input 50
      497                       , output v-fmtcli-addres
      498                   ).
      499                   assign
      500                       v-fmtcli-full-addres = v-fmtcli-addres
      501                       v-fmtcli-post-addres = v-fmtcli-addres
      502                       v-fmtcli-phone       = buf_shop.phone
      503                       v-fmtcli-inn         = "":U
      504                       v-fmtcli-kpp         = "":U
      505                       v-fmtcli-okpo        = "":U
      506                       v-fmtcli-city        = "":U
      507                       v-fmtcli-index       = "":U
      508                   .
      509               end.
      510          end.
      511          when 'скл':U
      512          then do:
      513               find first buf_store no-lock
      514                    where buf_store.obj-code = buf_clients.obj-code
      515               .
      516               if available buf_store
      517               then do:
      518                   run fmtcli-concatenate-strings in this-procedure (
      519                         input buf_store.addres1
      520                       , input buf_store.addres2
      521                       , input " ":U
      522                       , input 50
      523                       , output v-fmtcli-addres
      524                   ).
      525                   assign
      526                       v-fmtcli-full-addres = v-fmtcli-addres
      527                       v-fmtcli-phone       = buf_store.phone
      528                       v-fmtcli-inn         = "":U
      529                       v-fmtcli-kpp         = "":U
      530                       v-fmtcli-okpo        = "":U
      531                       v-fmtcli-city        = "":U
      532                       v-fmtcli-index       = "":U
      533                   .
      534               end.
      535          end.
      536          when 'чел':U
      537          then do:
      538               find first buf_person no-lock
      539                    where buf_person.psn-code = buf_clients.obj-code
      540               .
      541               if available buf_person
      542               then do:
      543                   run fmtcli-concatenate-strings in this-procedure (
      544                         input ( if buf_person.ind = 0 or buf_person.ind = ?
      545                                 then "":U
      546                                 else string( buf_person.ind, "999999")
      547                                 )
      548                       , input buf_person.city
      549                       , input ", ":U
      550                       , input 0
      551                       , output v-fmtcli-full-addres
      552                   ).
      553                   assign
      554                       v-fmtcli-addres = buf_person.address
      555                   .
      556                   run fmtcli-concatenate-strings in this-procedure (
      557                         input v-fmtcli-full-addres
      558                       , input v-fmtcli-addres
      559                       , input ", ":U
      560                       , input 0
      561                       , output v-fmtcli-full-addres
      562                   ).
      563                   assign
      564                       v-fmtcli-phone     = buf_person.phone1
      565                       v-fmtcli-inn       = buf_person.inn
      566                       v-fmtcli-kpp       = buf_person.kpp
      567                       v-fmtcli-okpo      = buf_person.okpo
      568                       v-fmtcli-city      = buf_person.city
      569                       v-fmtcli-index     = string( buf_person.ind )
      570                   .
      571               end.
      572          end.
      573       end case.
      574   end.
      575   end procedure.
      576   procedure fmtcli-concatenate-strings :
      577   define input parameter p-string-1       as character        no-undo.
      578   define input parameter p-string-2       as character        no-undo.
      579   define input parameter p-delimiter      as character        no-undo.
      580   define input parameter p-length         as integer          no-undo.
      581   define output parameter p-out-string    as character        no-undo.
      582   do
      583   on error undo, return error
      584   :
      585       assign
      586           p-out-string = ( if p-string-1 = ?
      587                            then "":U
      588                            else trim( p-string-1 ) )
      589       .
      590       assign
      591           p-out-string = p-out-string
      592                        + ( if p-out-string = "":U
      593                            or length( p-out-string ) = p-length
      594                            or p-string-2 = ?
      595                            or trim( p-string-2 ) = "":U
      596                            then "":U
      597                            else p-delimiter )
      598                        + ( if p-string-2 = ?
      599                            or trim( p-string-2 ) = "":U
      600                            then "":U
      601                            else trim( p-string-2 ) )
      602       .
      603   end.
      604   end procedure.
