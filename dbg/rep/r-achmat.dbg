     3466                  v-torgconf-main-boss = buf_store.store-boss
     3467                  v-torgconf-main-boss-post = "Директор"
     3468               .
     3469            END.
     3470            OTHERWISE DO:
     3471               assign
     3472                  v-torgconf-main-boss       = "":U
     3473                  v-torgconf-main-boss-post  = "":U
     3474               .
     3475            END.
     3476            END CASE.
     3477         end.
     3478      if  v-name <> 'wthtrg12':U
     3479      and v-name <> 'wthfct':U
     3480      and v-name <> 'wthm11':U
     3481      then do:
     3482       find first buf_trn-doc no-lock
     3483       where buf_trn-doc.doc-code = p-doc-code
     3484       no-error.
     3485       if available buf_trn-doc
     3486         then do:
     3487   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
