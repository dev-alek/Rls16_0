      227   define variable vss-include-info2 as character format "X(65)" no-undo
      228   initial "@(#)$Workfile$ $Revision$".
      229   define variable v-fmtcli-name          as character    no-undo.
      230   define variable v-fmtcli-engl-name     as character    no-undo.
      231   define variable v-fmtcli-addres        as character    no-undo.
      232   define variable v-fmtcli-post-addres   as character    no-undo.
      233   define variable v-fmtcli-full-addres   as character    no-undo.
      234   define variable v-fmtcli-phone         as character    no-undo.
      235   define variable v-fmtcli-inn           as character    no-undo.
      236   define variable v-fmtcli-kpp           as character    no-undo.
      237   define variable v-fmtcli-okpo          as character    no-undo.
