     1413   procedure torgconf-get-self-param :
     1414   define input parameter p-obj-type           as character        no-undo.
     1415   define input parameter p-obj-code           as integer          no-undo.
     1416   define input parameter p-curr-code          as integer          no-undo.
     1417       define variable v-host-code    as integer      no-undo.
     1418       define variable v-par-type     as character    no-undo.
     1419   do
     1420   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message(1))
     1421   :
     1422   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1423   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1424     (input  p-obj-type
     1425     ,input  p-obj-code
     1426     ,output v-host-code
     1427     )  .
     1428       if v-torgconf-outhold = yes
     1429       then do:
     1430           run torgconf-get-holdfirm-code in this-procedure (
     1431                 input p-obj-type
     1432               , input p-obj-code
     1433               , output v-torgconf-self-host-code
     1434           ).
     1435           if v-torgconf-self-host-code = 0
     1436           then do:
     1437               return error.
     1438           end.
     1439       end.
     1440       else do:
     1441           assign
     1442               v-torgconf-self-host-code = v-host-code
     1443           .
     1444       end.
     1445       if v-torgconf-self-host-code = 0
     1446       then do:
     1447           assign
     1448               v-torgconf-self-host-name           = "":U
     1449               v-torgconf-self-host-addres         = "":U
     1450               v-torgconf-self-host-post-addres    = "":U
     1451               v-torgconf-self-host-phone          = "":U
     1452               v-torgconf-self-host-inn            = "":U
     1453               v-torgconf-self-host-kpp            = "":U
     1454               v-torgconf-self-host-okpo           = "":U
     1455               v-torgconf-self-host-egrip-date     = "":U
     1456               v-torgconf-self-host-egrip-num      = "":U
     1457           .
     1458       end.
     1459       else do:
     1460           run fmtcli-get-client in this-procedure (
     1461                 input 'орг':U
     1462               , input v-torgconf-self-host-code
     1463           ).
     1464           assign
     1465               v-torgconf-self-host-name        = v-fmtcli-name
     1466               v-torgconf-self-host-engl-name   = v-fmtcli-engl-name
     1467               v-torgconf-self-host-addres      = v-fmtcli-full-addres
     1468               v-torgconf-self-host-post-addres = v-fmtcli-post-addres
     1469               v-torgconf-self-host-phone       = v-fmtcli-phone
     1470               v-torgconf-self-host-inn         = v-fmtcli-inn
     1471               v-torgconf-self-host-kpp         = v-fmtcli-kpp
     1472               v-torgconf-self-host-okpo        = v-fmtcli-okpo
     1473           .
     1474           run gbl/clntat-v.p (
     1475                 input 'орг':U
     1476               , input v-torgconf-self-host-code
     1477               , input 'egrip-date':U
     1478               , output v-torgconf-self-host-egrip-date
     1479               , output v-par-type
     1480           ).
     1481           run gbl/clntat-v.p (
     1482                 input 'орг':U
