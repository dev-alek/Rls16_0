     3323                                                   , if trim(v-ddate-attr) = "" then v-torgconf-doc-date else v-ddate-attr
     3324                                                   , ( if p-status_ <> 'факт':U
     3325                                                      then string( "(" + caps( p-status_ ) + ")" )
     3326                                                      else "":U )
     3327                                                )
     3328               .
     3329            end.
     3330            else do:
     3331            if trim(v-attr) = ""
     3332            then do:
     3333               assign
     3334                  v-torgconf-plat-rasch-doc   = substitute( "&1 от &2 &3",
     3335                                                           v-torgconf-doc-code,
     3336                                                           v-torgconf-doc-date,
     3337                                                            ( if p-status_ <> 'факт':U then string( "(" + caps( p-status_ ) + ")" ) else "":U )
     3338                                                           )
     3339               .
     3340            end.
     3341            else do:
     3342               assign
     3343                  v-torgconf-plat-rasch-doc = v-attr.
     3344            end.
     3345            end.
     3346        end.
     3347        otherwise do:
     3348            if  v-name <> 'wthtrg12'
     3349            and v-name <> 'wthfct'
     3350            and v-name <> 'wthm11'
     3351            then do:
     3352               IF v-dcode-attr <> "":U
     3353               OR v-ddate-attr <> "":U
     3354               THEN
     3355               assign
     3356                  v-torgconf-plat-rasch-doc   = substitute( "&1 от &2"
     3357                                                      , if trim(v-dcode-attr) = "" then "" else v-dcode-attr
     3358                                                      , if trim(v-ddate-attr) = "" then "" else v-ddate-attr
     3359                                                   )
     3360               .
     3361            end.
     3362            else do:
     3363               assign
     3364                  v-torgconf-plat-rasch-doc   = substitute( "&1", if trim(v-attr) = "" then "" else v-attr)
     3365               .
     3366            end.
     3367        end.
     3368       end case.
     3369      if v-torgconf-outB = "no_print"
     3370      then do:
     3371         assign v-torgconf-main-buh = "".
     3372      end.
     3373      if v-torgconf-outB = "glbuh_firm"
     3374      then do:
     3375            if v-torgconf-self-host-code = 0
     3376            then do:
     3377            end.
     3378            else do:
     3379               find first buf_sysconf no-lock
     3380                  where buf_sysconf.host-code = v-torgconf-self-host-code
     3381               .
     3382               assign
     3383                  v-torgconf-main-buh  = buf_sysconf.snr-accnt
     3384               .
     3385            end.
     3386      end.
     3387      if v-torgconf-outB = "buh_obj"
     3388      then do:
     3389         CASE v-torgconf-self-obj-type:
     3390         WHEN 'маг':U
     3391         THEN DO:
     3392            find first buf_shop no-lock
     3393            where buf_shop.obj-code = v-torgconf-self-obj-code
     3394            .
     3395            assign
     3396               v-torgconf-main-buh  = entry(1,buf_shop.acct,"|")
     3397            .
     3398         END.
     3399         WHEN 'скл':U
     3400         THEN DO:
     3401            find first buf_store no-lock
     3402            where buf_store.obj-code = v-torgconf-self-obj-code
     3403            .
     3404            assign
     3405               v-torgconf-main-buh  = buf_store.store-man
     3406            .
     3407         END.
     3408         OTHERWISE DO:
     3409            assign
     3410               v-torgconf-main-buh  = "":U
     3411            .
     3412         END.
     3413         END CASE.
     3414      end.
     3415      if v-torgconf-outR = "no_print"
     3416         then do:
     3417            assign
     3418               v-torgconf-main-boss = ""
     3419               v-torgconf-main-boss-post = ""
     3420            .
     3421         end.
     3422      if v-torgconf-outR = "ruk_firm"
     3423         then do:
     3424            find first buf_sysconf no-lock
     3425            where buf_sysconf.host-code = v-torgconf-self-host-code
     3426            no-error.
     3427            if available buf_sysconf
     3428            then do:
     3429               assign
     3430                  v-torgconf-main-boss-post = buf_sysconf.head-position
     3431               .
     3432            end.
     3433            find first buf_clients no-lock
     3434            where buf_clients.obj-type = 'орг':U
     3435            and buf_clients.obj-code = v-torgconf-self-host-code
     3436            .
     3437            find first buf_firm no-lock
     3438            where buf_firm.firm-code = buf_clients.obj-code
     3439            no-error.
     3440            if available buf_firm
     3441            then do:
     3442               assign
     3443                  v-torgconf-main-boss = buf_firm.director
     3444               .
     3445            end.
     3446         end.
     3447      if v-torgconf-outR = "dir_obj"
     3448         then do:
     3449            CASE v-torgconf-self-obj-type:
     3450            WHEN 'маг':U
     3451            THEN DO:
     3452               find first buf_shop no-lock
     3453               where buf_shop.obj-code = v-torgconf-self-obj-code
     3454               .
     3455               assign
     3456                  v-torgconf-main-boss = buf_shop.director
     3457                  v-torgconf-main-boss-post = "Директор"
     3458               .
     3459            END.
     3460            WHEN 'скл':U
     3461            THEN DO:
     3462               find first buf_store no-lock
     3463               where buf_store.obj-code = v-torgconf-self-obj-code
     3464               .
