      871   procedure clntattr-batch-edit :
      872     define input  parameter p-code           as character no-undo .
      873     define output parameter p-section-num    as integer no-undo .
      874     do
      875     on error undo, return error
      876     :
      877           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clntattr-batch-edit in g#attr-lib
      878         (input  p-code
      879         ,output p-section-num
      880         ) no-error .
      881       if error-status :error
      882       then do:
      883         undo, return error return-value .
      884       end.
      885     end.
      886   end procedure.
