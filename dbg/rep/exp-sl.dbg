        1   block-level on error undo, throw.
        2   define input parameter parparentproc    as widget-handle no-undo .
        3   define input parameter p-parent-handle  as widget-handle no-undo .
        4   define input parameter p-log-handle     as handle no-undo .
        5   define input parameter p-db-num-char    as character    no-undo.
        6   define input parameter p-task-type      as character    no-undo.
        7   define input parameter p-task-num       as integer      no-undo.
        8   define input parameter p-db-num         as integer      no-undo .
        9   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       10   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       11   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       12   define variable vss-workfile    as character no-undo init "$Workfile: exp-sl.p $":U .
       13   define variable vss-archive     as character no-undo init "$Archive: rep/exp-sl.p $":U .
       14   define variable vss-description as character no-undo init "Выгрузка продаж для Nielsen".
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   define new global shared variable g#library  as handle no-undo .
       74   define new global shared variable g#library2 as handle no-undo .
       75   procedure proc-alt-shift-f2:
       76     if not ibs.th.gbl.gbl-var:rcode
       77   then
       78     run gbl\inidebug.p .
       79   end.
       80   procedure proc-alt-shift-f3:
       81     run gbl/prvssinf.p
       82       ( input this-procedure
       83       ) .
       84   end.
       85   define variable v-inform-launched as logical no-undo initial false .
       86   procedure proc-alt-shift-f4:
       87     define variable v-action as character no-undo .
       88     if v-inform-launched = false then do:
       89       assign
       90         v-inform-launched = true
       91       .
       92       run gbl/d-inform.w
       93         (  input self
       94         ,  input this-procedure
       95         , output v-action
       96         ) no-error .
       97       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       98       assign
       99         v-inform-launched = false
      100       .
      101     end.
      102   end.
      103   procedure proc-alt-f1:
      104     run gbl/corrhelp.p
      105       (input this-procedure
      106       ) .
      107   end .
      108   on alt-shift-f2 anywhere do:
      109     run proc-alt-shift-f2.
      110   end.
      111   on alt-shift-f3 anywhere do:
      112     run proc-alt-shift-f3 in this-procedure .
      113   end.
      114   on alt-shift-f4 anywhere do:
      115     run proc-alt-shift-f4 in this-procedure.
      116   end.
      117   on alt-f1 anywhere do:
      118     run proc-alt-f1 in this-procedure .
      119   end.
      120   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      121     define variable v-cntxt-db-num        as integer   no-undo .
      122     define variable v-cntxt-userid        as character no-undo .
      123     define variable v-cntxt-level         as character no-undo .
      124     define variable v-cntxt-host-code-obj as integer   no-undo .
      125     define variable v-cntxt-obj-type      as character no-undo .
      126     define variable v-cntxt-obj-code      as integer   no-undo .
      127     define variable v-cntxt-db-num-obj    as integer   no-undo .
      128     define variable v-cntxt-is-admin      as logical   no-undo .
      129   define variable vss-include-info1 as character format "X(65)" no-undo
      130   initial "@(#)$Workfile$ $Revision$".
      131   DEFINE temp-table tt-obj no-undo
      132       field   obj-code    as integer
      133       field   obj-type    as character
      134       field   obj-name    as character
      135       field   host-code   as integer
      136       INDEX   pi          IS PRIMARY UNIQUE
      137               obj-type
      138               obj-code
      139     .
      140   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      141   define temp-table temp-schedule-free no-undo
      142   field free-id as character
      143   field free-task-name as character
      144   field proc-run-name as character
      145   field proc-param-edit-name as character
      146   field conf-param as character
      147   field is-gbd as logical
      148   field is-ubd as logical
      149   field enable-concurrent-0 as logical
      150   field enable-concurrent-db as logical
      151   field other-info as character
      152   field enc-key as character
      153   field is-rum as logical
      154   index pi is unique primary
      155   free-id.
      156   procedure schedule-attr-name :
      157   do
      158     on error undo, return error
      159     :
      160     define input  parameter p-code           as character no-undo .
      161     define output parameter p-type           as character no-undo .
      162     define output parameter p-format         as character no-undo .
      163     define output parameter p-label          as character no-undo .
      164     define output parameter p-user-can-edit  as logical   no-undo .
      165     define output parameter p-output-display as logical   no-undo .
      166     define output parameter p-other          as character no-undo .
      167       if index(p-code, chr(4)) > 0 then do:
      168         p-code = entry(1, p-code, chr(4)).
      169       end.
      170       case p-code :
      171               when 'schedule-param-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      172               when 'schedule-obj-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      173               when 'schedule-oss-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      174               when 'schedule-gds-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      175               when 'schedule-doc-type-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      176               when 'schedule-date-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      177               when 'schedule-filter':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      178               when 'schedule-filter-2':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      179               when 'schd-free-id':U then do:     assign     p-label = "Идентификатор произвольной задачи"     p-type = 'C':U      p-format = "X(30)"     p-label = "Идентификатор произвольной задачи"     p-user-can-edit  = false     p-output-display = false     p-other = ""      .   end.
      180         otherwise do:
      181           undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      182         end.
      183       end.
      184     end.
      185   end procedure.
      186   procedure schedule-attr-tooltip :
      187   do
      188     on error undo, return error
      189     :
      190       define input  parameter p-code    as character no-undo .
      191       define output parameter p-tooltip as character no-undo .
      192       define output parameter p-label   as character no-undo .
      193       if index(p-code, chr(4)) > 0 then do:
      194         p-code = entry(1, p-code, chr(4)).
      195       end.
      196       case p-code :
      197               when 'schedule-param-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      198               when 'schedule-obj-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      199               when 'schedule-oss-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      200               when 'schedule-gds-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      201               when 'schedule-doc-type-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      202               when 'schedule-date-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      203               when 'schedule-filter':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      204               when 'schedule-filter-2':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      205               when 'schd-free-id':U then do:     assign     p-tooltip = "Идентификатор произвольной задачи"     p-label = "Идентификатор произвольной задачи" .   end.
      206         otherwise do:
      207               undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      208         end.
      209       end.
      210     end.
      211   end procedure.
      212   procedure schedule-attr-value :
      213   do
      214   on error undo, return error return-value
      215   :
      216   define input parameter  p-cre-db-num as integer    no-undo.
      217   define input parameter  p-task-type  as character  no-undo.
      218   define input parameter  p-task-num   as integer    no-undo.
      219   define input parameter  p-code       as character  no-undo.
      220   define output parameter p-value      as character  no-undo.
      221   define output parameter p-type       as character  no-undo.
      222       define variable v-format         as character no-undo .
      223       define variable v-label          as character no-undo .
      224       define variable v-user-can-edit  as logical   no-undo .
      225       define variable v-output-display as logical   no-undo .
      226       define variable v-other          as character no-undo .
      227       define buffer buf_schedule-attr for ub.schedule-attr.
      228       run schedule-attr-name in this-procedure (
      229             input  p-code
      230           , output p-type
      231           , output v-format
      232           , output v-label
      233           , output v-user-can-edit
      234           , output v-output-display
      235           , output v-other
      236       ) no-error .
      237       if error-status :error
      238       then do:
      239           undo, return error return-value .
      240       end.
      241       if p-code begins ('schd-free-id':U + chr(4))
      242       and entry(2, p-code, chr(4)) = '':U then do:
      243         find first buf_schedule-attr no-lock
      244             where buf_schedule-attr.cre-db-num = p-cre-db-num
      245               and buf_schedule-attr.task-type  = p-task-type
      246               and buf_schedule-attr.task-num   = p-task-num
      247               and buf_schedule-attr.attr-code  begins p-code
      248         no-error .
      249       end.
      250       else do:
      251         find first buf_schedule-attr no-lock
      252             where buf_schedule-attr.cre-db-num = p-cre-db-num
      253               and buf_schedule-attr.task-type  = p-task-type
      254               and buf_schedule-attr.task-num   = p-task-num
      255               and buf_schedule-attr.attr-code  = p-code
      256         no-error .
      257       end.
      258       if available buf_schedule-attr
      259       then do:
      260           assign
      261               p-value = buf_schedule-attr.attr-value
      262           .
      263       end.
      264       else do:
      265         if p-code begins ('schd-free-id':U + chr(4) ) then do:
      266            run schedule-attr-get-free-props in this-procedure (input entry(2, p-code, chr(4)), output p-value).
      267         end.
      268         else do:
      269           assign
      270               p-value = if p-type = 'L':U then "no":U else ""
      271           .
      272         end.
      273       end.
      274   end.
      275   end procedure.
      276   procedure schedule-attr-write :
      277   do
      278   on error undo, return error
      279   :
      280   define input parameter p-cre-db-num  as integer   no-undo.
      281   define input parameter p-task-type   as character no-undo.
      282   define input parameter p-task-num    as integer   no-undo.
      283   define input parameter p-code        as character no-undo.
      284   define input parameter p-value       as character no-undo.
      285       define variable v-type              as character                no-undo.
      286       define variable v-format            as character                no-undo.
      287       define variable v-label             as character                no-undo.
      288       define variable v-user-can-edit     as logical                  no-undo.
      289       define variable v-output-display    as logical                  no-undo.
      290       define variable v-other             as character                no-undo.
      291       define buffer buf_schedule-attr for ub.schedule-attr .
      292       run schedule-attr-name in this-procedure (
      293             input  p-code
      294           , output v-type
      295           , output v-format
      296           , output v-label
      297           , output v-user-can-edit
      298           , output v-output-display
      299           , output v-other
      300       ) no-error.
      301       if error-status :error
      302       then do:
      303           undo, return error return-value.
      304       end.
      305       find first buf_schedule-attr exclusive-lock
      306            where buf_schedule-attr.cre-db-num = p-cre-db-num
      307              and buf_schedule-attr.task-type  = p-task-type
      308              and buf_schedule-attr.task-num   = p-task-num
      309              and buf_schedule-attr.attr-code  = p-code
      310       no-error.
      311       if not available buf_schedule-attr
      312       then do:
      313           create buf_schedule-attr.
      314           assign
      315             buf_schedule-attr.cre-db-num = p-cre-db-num
      316             buf_schedule-attr.task-type  = p-task-type
      317             buf_schedule-attr.task-num   = p-task-num
      318             buf_schedule-attr.attr-code  = p-code
      319             buf_schedule-attr.attr-value = p-value
      320           .
      321       end.
      322       else do:
      323           assign
      324               buf_schedule-attr.attr-value = p-value
      325           .
      326       end.
      327   end.
      328   end procedure.
      329   procedure schedule-attr-delete :
      330   do
      331   on error undo, return error
      332   :
      333   define input  parameter p-cre-db-num  as integer   no-undo.
      334   define input  parameter p-task-type   as character no-undo.
      335   define input  parameter p-task-num    as integer   no-undo.
      336   define input  parameter p-code        as character no-undo.
      337   define output parameter p-deleted     as logical   no-undo.
      338       define buffer buf_schedule-attr for ub.schedule-attr .
      339       define variable v-type              as character                no-undo.
      340       define variable v-format            as character                no-undo.
      341       define variable v-label             as character                no-undo.
      342       define variable v-user-can-edit     as logical                  no-undo.
      343       define variable v-output-display    as logical                  no-undo.
      344       define variable v-other             as character                no-undo.
      345       run schedule-attr-name in this-procedure (
      346             input p-code
      347           , output v-type
      348           , output v-format
      349           , output v-label
      350           , output v-user-can-edit
      351           , output v-output-display
      352           , output v-other
      353       ) no-error .
      354       if error-status :error
      355       then do:
      356           undo, return error return-value .
      357       end.
      358       find first buf_schedule-attr exclusive-lock
      359            where buf_schedule-attr.cre-db-num = p-cre-db-num
      360              and buf_schedule-attr.task-type  = p-task-type
      361              and buf_schedule-attr.task-num   = p-task-num
      362              and buf_schedule-attr.attr-code  = p-code
      363       no-error.
      364       if not available buf_schedule-attr
      365       then do:
      366           assign
      367               p-deleted = no
      368           .
      369       end.
      370       else do:
      371           delete buf_schedule-attr.
      372           assign
      373               p-deleted = yes
      374           .
      375       end.
      376   end.
      377   end procedure.
      378   procedure schedule-attr-news :
      379   do
      380   on error undo, return error
      381   :
      382       define input  parameter p-code           as character no-undo .
      383       define output parameter p-news           as logical   no-undo .
      384       if index(p-code, chr(4)) > 0 then do:
      385         p-code = entry(1, p-code, chr(4)).
      386       end.
      387       case p-code :
      388               when 'schedule-param-list':U then do:     assign     p-news = false.   end.
      389               when 'schedule-obj-list':U then do:     assign     p-news = false.   end.
      390               when 'schedule-oss-list':U then do:     assign     p-news = false.   end.
      391               when 'schedule-gds-list':U then do:     assign     p-news = false.   end.
      392               when 'schedule-doc-type-list':U then do:     assign     p-news = false.   end.
      393               when 'schedule-date-list':U then do:     assign     p-news = false.   end.
      394               when 'schedule-filter':U then do:     assign     p-news = false.   end.
      395               when 'schedule-filter-2':U then do:     assign     p-news = false.   end.
      396               when 'schd-free-id':U then do:     assign     p-news = false.   end.
      397         otherwise do:
      398           undo, return error "неизвестный атрибут строки расписания" + " " + p-code .
      399         end.
      400       end.
      401   end.
      402   end procedure.
      403   procedure schedule-attr-extract-logical :
      404   do
      405   on error undo, return error
      406   :
      407   define input  parameter p-parameter-number   as integer      no-undo.
      408   define input  parameter p-parameter-list     as character    no-undo.
      409   define output parameter p-parameter-value   as logical      no-undo.
      410       if num-entries( p-parameter-list ) > p-parameter-number - 1
      411       then do:
      412           assign
      413               p-parameter-value   = ( entry( p-parameter-number, p-parameter-list ) = "yes" )
      414           .
      415       end.
      416       else do:
      417           assign
      418               p-parameter-value   = no
      419           .
      420       end.
      421   end.
      422   end procedure.
      423   procedure schedule-attr-get-free-id :
      424   do
      425   on error undo, return error return-value
      426   :
      427     define input  parameter p-cre-db-num  as integer   no-undo.
      428     define input  parameter p-task-type   as character no-undo.
      429     define input  parameter p-task-num    as integer   no-undo.
      430     define output parameter p-free-id     as character no-undo.
      431     define buffer buf_schedule-attr for ub.schedule-attr.
      432     find first buf_schedule-attr no-lock
      433         where buf_schedule-attr.cre-db-num = p-cre-db-num
      434           and buf_schedule-attr.task-type  = p-task-type
      435           and buf_schedule-attr.task-num   = p-task-num
      436           and buf_schedule-attr.attr-code  begins  ('schd-free-id':U + chr(4))
      437     no-error .
      438     if available buf_schedule-attr then
      439     assign
      440     p-free-id = entry(2, buf_schedule-attr.attr-code, chr(4))
      441     no-error
      442     .
      443   end.
      444   end procedure.
      445   procedure schedule-attr-get-free-props :
      446     define input parameter p-free-id as character no-undo .
      447     define output parameter p-value as character no-undo .
      448     define buffer buf_temp-schedule-free for temp-schedule-free.
      449     do
      450     on error undo, return error return-value
      451     :
      452       find first buf_temp-schedule-free no-lock no-error .
      453       if not available buf_temp-schedule-free then do:
      454         run schedule-attr-fill-free-props in this-procedure .
      455       end.
      456       find first buf_temp-schedule-free where
      457               buf_temp-schedule-free.free-id = p-free-id no-error.
      458       if available buf_temp-schedule-free then do:
      459         assign
      460         p-value = buf_temp-schedule-free.free-task-name       + chr(4) +
      461                   buf_temp-schedule-free.proc-run-name        + chr(4) +
      462                   buf_temp-schedule-free.proc-param-edit-name + chr(4) +
      463                   buf_temp-schedule-free.conf-param           + chr(4) +
      464                   string(buf_temp-schedule-free.is-gbd)       + chr(4) +
      465                   string(buf_temp-schedule-free.is-ubd)       + chr(4) +
      466                   string(buf_temp-schedule-free.enable-concurrent-0) + chr(4) +
      467                   string(buf_temp-schedule-free.enable-concurrent-db) + chr(4) +
      468                   buf_temp-schedule-free.other-info
      469         .
      470       end.
      471       else do:
      472        if p-free-id <> '':U then return error substitute("&1 &2 &3&4Неопределены процедуры для работы с произвольной задачей по расписанию&4" +
      473                              "id произвольной задачи - &5"
      474                              ,vss-workfile
      475                              ,vss-revision
      476                              ,vss-description
      477                              ,chr(10)
      478                              ,p-free-id).
      479       end.
      480     end.
      481   end procedure.
      482   procedure schedule-attr-is-rum-free-id :
      483   define input parameter p-free-id as character no-undo .
      484   define output parameter p-is-rum as logical no-undo .
      485   define buffer buf_temp-schedule-free for temp-schedule-free.
      486   do
      487   on error undo, return error
      488   :
      489       find first buf_temp-schedule-free no-lock no-error .
      490       if not available buf_temp-schedule-free then do:
      491         run schedule-attr-fill-free-props in this-procedure .
      492       end.
      493       find first buf_temp-schedule-free where
      494               buf_temp-schedule-free.free-id = p-free-id no-error.
      495       if available buf_temp-schedule-free
      496       and buf_temp-schedule-free.is-rum
      497       then do:
      498         p-is-rum = yes.
      499       end.
      500   end.
      501   end procedure.
      502   procedure schedule-attr-fill-free-props :
      503   define variable v-path                    as character                no-undo .
      504   DEFINE VARIABLE v-full-path               as character                no-undo .
      505   DEFINE VARIABLE v-file-name               as character                no-undo .
      506   DEFINE VARIABLE v-file-name-no-ext        as character                no-undo .
      507   DEFINE VARIABLE v-file-name-ext           as character                no-undo .
      508   define buffer buf_temp-schedule-free for temp-schedule-free.
      509   define variable v-answer as logical no-undo .
      510     do
      511     on error undo, return error substitute("&1 &2 &3&4&5&4"
      512                                           ,vss-workfile
      513                                           ,vss-revision
      514                                           ,vss-description
      515                                           ,chr(10)
      516                                           ,error-status:get-message(1) )
      517     :
      518       run gbl/filename.p (
      519                       input 'cmp/shd-free.d'
      520                     ,output v-full-path
      521                     ,output v-path
      522                     ,output v-file-name
      523                     ,output v-file-name-no-ext
      524                     ,output v-file-name-ext
      525                     ) .
      526       input from value(v-full-path).
      527       repeat :
      528         create buf_temp-schedule-free.
      529         import buf_temp-schedule-free.
      530       END.
      531       input close.
      532       _ff:
      533       for each buf_temp-schedule-free :
      534         if buf_temp-schedule-free.free-id = '':U then do:
      535            delete buf_temp-schedule-free.
      536            next _ff.
      537          end.
      538          run schedule-attr-check-enc in this-procedure (
      539                                                       input  buf_temp-schedule-free.free-id
      540                                                      ,input  (buf_temp-schedule-free.proc-run-name +
      541                                                               buf_temp-schedule-free.proc-param-edit-name +
      542                                                               buf_temp-schedule-free.conf-param +
      543                                                               string(buf_temp-schedule-free.is-gbd) +
      544                                                               string(buf_temp-schedule-free.is-ubd) +
      545                                                               string(buf_temp-schedule-free.enable-concurrent-0) +
      546                                                               string(buf_temp-schedule-free.enable-concurrent-db) +
      547                                                               string(buf_temp-schedule-free.other-info)
      548                                                               )
      549                                                       ,input  buf_temp-schedule-free.enc-key
      550                                                       ,output v-answer    ) no-error .
      551          if error-status:error
      552          or not v-answer then delete buf_temp-schedule-free.
      553        end.
      554     end.
      555   end procedure.
      556   Function schedule-attr-reverse returns character (str as character).
      557      define variable rev_incl_s as character init "" no-undo .
      558      define variable rev_incl_i as integer no-undo .
      559      define variable rev_incl_l as integer no-undo .
      560      rev_incl_l = length(str).
      561      do rev_incl_i = 1 to rev_incl_l:
      562         rev_incl_s = rev_incl_s + substr(str,rev_incl_l - rev_incl_i + 1,1).
      563      end.
      564      return rev_incl_s.
      565   end.
      566   procedure schedule-attr-check-enc.
      567     define input  parameter p-free-id   as character no-undo .
      568     define input  parameter p-value     as character no-undo .
      569     define input  parameter p-enc-value as character no-undo .
      570     define output parameter p-answer    as logical   no-undo .
      571     define variable tmp         as character no-undo .
      572     define variable v-enc-value as character no-undo .
      573     assign
      574     tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value)) .
      575     .
      576     run schedule-attr-pswd-enc in this-procedure
      577       ( input tmp
      578        ,output v-enc-value
      579       ) no-error .
      580     if error-status:error then do:
      581       message
      582         vss-workfile vss-revision vss-description skip
      583         "Ошибка при вызове процедуры pswd-enc" skip
      584         return-value skip
      585         error-status :get-message(1) skip
      586         view-as alert-box error .
      587       undo, return error .
      588     end.
      589     if v-enc-value = p-enc-value then do:
      590       assign
      591         p-answer = true
      592       .
      593     end.
      594     else do:
      595       assign
      596         p-answer = false
      597       .
      598     end.
      599   end.
      600   procedure schedule-attr-conf-enc.
      601     define input  parameter p-free-id   as character no-undo .
      602     define input  parameter p-value     as character no-undo .
      603     define output parameter p-enc-value as character no-undo .
      604     define variable tmp         as character no-undo .
      605     assign
      606       tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value))
      607     .
      608     run schedule-attr-pswd-enc in this-procedure
      609       ( input tmp
      610        ,output p-enc-value
      611       ) no-error .
      612     if error-status:error then do:
      613       message
      614         vss-workfile vss-revision vss-description skip
      615         "Ошибка при вызове процедуры pswd-enc" skip
      616         return-value skip
      617         error-status :get-message(1) skip
      618         view-as alert-box error .
      619       undo, return error .
      620     end.
      621   end procedure.
      622   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      623   procedure schedule-attr-pswd-enc :
      624     define input parameter  pswd     as character no-undo .
      625     define output parameter enc-pswd as character no-undo .
      626     do
      627     on error undo, return error return-value
      628     :
      629       assign
      630         enc-pswd = encode(pswd + string(index(pswd, "k")))
      631       .
      632     end.
      633   end procedure.
      634   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      635   procedure factord :
      636     define input  parameter p-fact-date            as date    no-undo .
      637     define input  parameter p-fact-time            as integer no-undo .
      638     define input  parameter p-fact-num             as integer no-undo .
      639     define input  parameter p-shift-date           as date    no-undo .
      640     define input  parameter p-shift-num            as integer no-undo .
      641     define input  parameter p-shift-on             as logical no-undo .
      642     define output parameter p-fact-order           as decimal no-undo .
      643     define output parameter p-shift-end-fact-order as decimal no-undo .
      644     define output parameter p-day-end-fact-order   as decimal no-undo .
      645     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      646     if p-fact-date = ?
      647     then do:
      648       return error "Не указана фактическая дата" .
      649     end.
      650     define variable v-fact-date-num as integer no-undo .
      651     assign
      652       v-fact-date-num = integer(p-fact-date)
      653     .
      654     if p-fact-num = ?
      655     or p-fact-num = 0
      656     then do:
      657       return error "Не задан p-fact-num " + string(p-fact-num) .
      658     end.
      659     if p-fact-num < 0
      660     then do:
      661       return error "Отрицательный fact-num " + string(p-fact-num) .
      662     end.
      663     if p-fact-num >= 100000000
      664     then do:
      665       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      666     end.
      667     if p-shift-on = true
      668     then do:
      669       if p-shift-date = ?
      670       then do:
      671         return error "Не задана дата смены" .
      672       end.
      673       if p-shift-num = ?
      674       or p-shift-num = 0
      675       then do:
      676         return error "Не задан номер смены" .
      677       end.
      678     end.
      679     else do:
      680       assign
      681         p-shift-date = p-fact-date
      682         p-shift-num  = 24
      683       .
      684     end.
      685     define variable v-shift-offset as integer no-undo .
      686     if p-shift-date = p-fact-date
      687     then do:
      688       assign
      689         v-shift-offset = 1
      690       .
      691     end.
      692     if p-shift-date < p-fact-date
      693     then do:
      694       assign
      695         v-shift-offset = 0
      696       .
      697     end.
      698     if p-shift-date > p-fact-date
      699     then do:
      700       message
      701         vss-workfile vss-revision vss-description skip
      702         "Неправильная дата закрытия смены" skip
      703         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      704         view-as alert-box error .
      705       undo, return error
      706         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      707           ,string(p-fact-date, '99/99/9999':U)
      708           ,string(p-shift-date, '99/99/9999':U)
      709           )
      710       .
      711     end.
      712     if p-shift-num < 1
      713     or p-shift-num > 24
      714     then do:
      715       message
      716         vss-workfile vss-revision vss-description skip
      717         "Неправильный номер смены" skip
      718         "p-shift-num" p-shift-num skip
      719         view-as alert-box error .
      720       undo, return error return-value .
      721     end.
      722     assign
      723       p-fact-order           = v-fact-date-num
      724                              + v-shift-offset * 0.5
      725                              + p-shift-num    * 0.02 - 0.01
      726                              + p-fact-num     * 0.0000000001
      727       p-shift-end-fact-order = v-fact-date-num
      728                              + v-shift-offset * 0.5
      729                              + p-shift-num    * 0.02
      730       p-day-end-fact-order   = v-fact-date-num
      731                              + 0.99
      732     .
      733     if p-fact-order           <= v-fact-date-num
      734     or p-shift-end-fact-order <= v-fact-date-num
      735     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      736     or p-shift-end-fact-order >= p-day-end-fact-order
      737     then do:
      738       message
      739         vss-workfile vss-revision vss-description skip
      740         "Внутренняя ошибка при генерации фактического номера" skip
      741         "p-fact-date"            p-fact-date            skip
      742         "p-fact-time"            p-fact-time            skip
      743         "p-fact-num"             p-fact-num             skip
      744         "p-shift-date"           p-shift-date           skip
      745         "p-shift-num"            p-shift-num            skip
      746         "p-shift-on"             p-shift-on             skip
      747         "p-shift-end-fact-order" p-shift-end-fact-order skip
      748         "p-day-end-fact-order"   p-day-end-fact-order   skip
      749         "v-fact-date-num"        v-fact-date-num        skip
      750         view-as alert-box error .
      751       undo, return error return-value .
      752     end.
      753   end procedure.
      754   procedure day-begin-fact-order :
      755     define input  parameter p-fact-date            as date    no-undo .
      756     define output parameter p-day-begin-fact-order as decimal no-undo .
      757     do
      758     on error undo, return error return-value
      759     :
      760       if p-fact-date = ?
      761       then do:
      762         assign
      763           p-day-begin-fact-order = 0
      764         .
      765       end.
      766       else do:
      767         assign
      768           p-day-begin-fact-order = integer(p-fact-date)
      769         .
      770       end.
      771     end.
      772   end procedure.
      773   procedure factord-max-fact-order :
      774     define output parameter p-max-fact-order as decimal   no-undo .
      775     do
      776     on error undo, return error return-value
      777     :
      778       run day-begin-fact-order in this-procedure
      779         (input  date(1, 1, 5000)
      780         ,output p-max-fact-order
      781         ) .
      782     end.
      783   end procedure.
      784   procedure factord-cut-archive :
      785     define input  parameter p-obj-type             as character no-undo .
      786     define input  parameter p-obj-code             as integer   no-undo .
      787     define input  parameter p-fact-date            as date      no-undo .
      788     define output parameter p-shift-on             as logical   no-undo .
      789     define output parameter p-shift-date           as date      no-undo .
      790     define output parameter p-shift-num            as integer   no-undo .
      791     define output parameter p-day-end-fact-order   as decimal   no-undo .
      792     define output parameter p-shift-end-fact-order as decimal   no-undo .
      793     define variable v-fact-order as decimal   no-undo .
      794     define buffer buf_shift-obj for ub.shift-obj .
      795     do
      796     on error undo, return error return-value
      797     :
      798   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      799   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      800     (input  p-obj-type
      801     ,input  p-obj-code
      802     ,input  'shift-on=request'
      803     ,output p-shift-on
      804     ) no-error .
      805       if error-status :error
      806       then do:
      807         message
      808           vss-workfile vss-revision vss-description skip
      809           "Ошибка при определении атрибута объекта" skip
      810           "Объект" p-obj-type p-obj-code skip
      811           error-status :get-message(1) skip
      812           return-value skip
      813           view-as alert-box error .
      814         undo, return error return-value .
      815       end.
      816       if p-shift-on = false
      817       then do:
      818         assign
      819           p-shift-date               = ?
      820           p-shift-num                = 0
      821         .
      822       end.
      823       else do:
      824         find first buf_shift-obj share-lock
      825           where buf_shift-obj.obj-type   = p-obj-type
      826             and buf_shift-obj.obj-code   = p-obj-code
      827             and buf_shift-obj.shift-date > p-fact-date
      828           use-index pi
      829           no-error .
      830         if not available buf_shift-obj
      831         or buf_shift-obj.status_ <> 'зкр':U
      832         then do:
      833           message
      834             vss-workfile vss-revision vss-description skip
      835             "Невозможно вычислить последнюю смену" skip
      836             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      837             "Объект" p-obj-type p-obj-code skip
      838             "Дата" p-fact-date skip
      839             view-as alert-box error .
      840           undo, return error return-value .
      841         end.
      842         find last buf_shift-obj share-lock
      843           where buf_shift-obj.obj-type = p-obj-type
      844             and buf_shift-obj.obj-code = p-obj-code
      845             and buf_shift-obj.shift-date <= p-fact-date
      846           use-index pi
      847           no-error .
      848         if available buf_shift-obj
      849         then do:
      850           if  buf_shift-obj.status_ = 'зкр':U
      851           then do:
      852             assign
      853               p-shift-date = buf_shift-obj.shift-date
      854               p-shift-num  = buf_shift-obj.shift-num
      855             .
      856           end.
      857           else do:
      858             message
      859               vss-workfile vss-revision vss-description skip
      860               "Невозможно вычислить последнюю смену" skip
      861               "Статус смены отличен от статуса" 'зкр':U skip
      862               "Объект" p-obj-type p-obj-code skip
      863               "Дата" p-fact-date skip
      864               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      865               view-as alert-box error .
      866             undo, return error return-value .
      867           end.
      868         end.
      869         else do:
      870           assign
      871             p-shift-date = p-fact-date - 1
      872             p-shift-num  = 1
      873           .
      874         end.
      875       end.
      876       run factord in this-procedure
      877         (input  p-fact-date
      878         ,input  1
      879         ,input  1
      880         ,input  p-shift-date
      881         ,input  p-shift-num
      882         ,input  p-shift-on
      883         ,output v-fact-order
      884         ,output p-shift-end-fact-order
      885         ,output p-day-end-fact-order
      886         ) no-error .
      887       if error-status :error
      888       then do:
      889         message
      890           vss-workfile vss-revision vss-description skip
      891           "Ошибка при вызове процедуры factord"
      892           error-status :get-message(1) skip
      893           return-value skip
      894           view-as alert-box error .
      895         undo, return error return-value .
      896       end.
      897     end.
      898   end procedure.
      899   procedure factord-lock-shift :
      900     define input  parameter p-obj-type  as character no-undo .
      901     define input  parameter p-obj-code  as integer   no-undo .
      902     define input  parameter p-fact-date as date      no-undo .
      903     define parameter buffer buf_shift-obj for ub.shift-obj .
      904     define variable v-shift-on      as logical   no-undo .
      905     define variable v-extra-message as character no-undo .
      906     define variable v-error as character no-undo .
      907     do
      908     on error undo, return error return-value
      909     :
      910   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      911   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      912     (input  p-obj-type
      913     ,input  p-obj-code
      914     ,input  'shift-on=request'
      915     ,output v-shift-on
      916     ) no-error .
      917       if error-status :error
      918       then do:
      919         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      920         undo, return error v-error .
      921       end.
      922       if v-shift-on = true
      923       then do:
      924         find first buf_shift-obj share-lock
      925           where buf_shift-obj.obj-type   = p-obj-type
      926             and buf_shift-obj.obj-code   = p-obj-code
      927             and buf_shift-obj.shift-date > p-fact-date
      928           use-index pi
      929           no-error .
      930         if not available buf_shift-obj
      931         or buf_shift-obj.status_ <> 'зкр':U
      932         then do:
      933           find last buf_shift-obj
      934             where buf_shift-obj.obj-type = p-obj-type
      935               and buf_shift-obj.obj-code = p-obj-code
      936               and buf_shift-obj.status_  = 'зкр':U
      937             use-index stts
      938             no-error .
      939           if available buf_shift-obj
      940           then do:
      941             assign
      942               v-extra-message =
      943                     substitute("Дата начала последеней закрытой смены на объекте &1"
      944                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      945                               )
      946             .
      947           end.
      948           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      949           undo, return error v-error .
      950         end.
      951       end.
      952     end.
      953   end procedure.
      954   procedure factord-end-day :
      955     define input  parameter p-fact-date            as date    no-undo .
      956     define output parameter p-day-end-fact-order   as decimal no-undo .
      957     do
      958     on error undo, return error return-value
      959     :
      960       if p-fact-date = ?
      961       then do:
      962         return error "Не указана фактическая дата" .
      963       end.
      964       assign
      965         p-day-end-fact-order = integer(p-fact-date) + 0.99
      966       .
      967     end.
      968   end procedure.
      969   procedure factord-to-date :
      970     define input  parameter p-fact-order as decimal no-undo .
      971     define output parameter p-fact-date  as date    no-undo .
      972     define variable v-ref-date  as date      no-undo .
      973     define variable v-ref-delta as integer   no-undo .
      974     do
      975     on error undo, return error return-value
      976     :
      977       if p-fact-order = ?
      978       or p-fact-order = 0
      979       then do:
      980         return error "Не указан fact-order" .
      981       end.
      982       assign
      983         v-ref-date  = date(1, 1, 2000)
      984       .
      985       assign
      986         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      987       .
      988       assign
      989         p-fact-date = v-ref-date + v-ref-delta
      990       .
      991     end.
      992   end procedure.
      993   procedure factord-to-fact-num :
      994     define input  parameter p-fact-order as decimal no-undo .
      995     define output parameter p-fact-num   as integer no-undo .
      996     define variable v-fact-order-trunc as decimal no-undo .
      997     do
      998     on error undo, return error return-value
      999     :
     1000       if p-fact-order = ?
     1001       or p-fact-order = 0
     1002       then do:
     1003         return error "Не указан fact-order" .
     1004       end.
     1005       assign
     1006        v-fact-order-trunc = truncate(p-fact-order, 2)
     1007       .
     1008       assign
     1009         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1010       .
     1011     end.
     1012   end procedure.
     1013   procedure factord-to-shift-num :
     1014     define input  parameter p-fact-order as decimal no-undo .
     1015     define output parameter p-shift-num   as integer no-undo .
     1016     define variable  p-shift-numd  as decimal   no-undo .
     1017     define variable v-fact-order-trunc as decimal no-undo .
     1018     do
     1019     on error undo, return error return-value
     1020     :
     1021       if p-fact-order = ?
     1022       or p-fact-order = 0
     1023       then do:
     1024         return error "Не указан fact-order" .
     1025       end.
     1026       assign
     1027        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1028       .
     1029       if v-fact-order-trunc < 0.5 then do:
     1030         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1031       end.
     1032       assign
     1033         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1034         .
     1035        assign
     1036         p-shift-num = truncate (p-shift-numd , 0)
     1037       .
     1038     end.
     1039   end procedure.
     1040   define variable v-ftp-address   as character    no-undo.
     1041   define variable v-login         as character    no-undo.
     1042   define variable v-password      as character    no-undo.
     1043   define variable v-name          as character    no-undo.
     1044   define variable vHost-code_list as character    no-undo.
     1045   define variable v-task-num      as integer      no-undo.
     1046   define variable v-param-list    as character    no-undo.
     1047   define variable v-param-type    as character    no-undo.
     1048   define variable v-obj-list      as character    no-undo.
     1049   define variable v-ii1           as integer      no-undo.
     1050   define variable v-ii2           as integer      no-undo.
     1051   define variable vRadio-set-1    as integer      no-undo.
     1052   define buffer buf_tt-obj for tt-obj.
     1053   define buffer buf_schedule for ub.schedule.
     1054   define buffer buf_schedule-attr for ub.schedule-attr.
     1055   define variable v-par-val                 as character            no-undo .
     1056   define variable v-par-type                as character            no-undo .
     1057   define variable v-nielsen    as logical      no-undo.
     1058   do
     1059   on error undo, return error
     1060   :
     1061     run gbl/conf-rd.p ("nielsen":U, "":U, "":U, 0, "":U, "":U, "":U, no, output v-par-val, output v-par-type) no-error.
     1062     IF error-status:error then
     1063       v-nielsen = no.
     1064     else
     1065        ASSIGN
     1066          v-nielsen = LOGICAL( v-par-val )
     1067          NO-ERROR.
     1068     IF error-status:error
     1069     OR v-nielsen = FALSE
     1070     THEN DO:
     1071           run write-log-and-file in p-log-handle (           input 1                                                               , input "shd-free.log"                                                   , input 1                                                               , input "Запрещена выгрузка для Nielsen").
     1072       return.
     1073     END.
     1074     if p-task-num > 0
     1075     then do:
     1076       v-task-num = p-task-num.
     1077     end.
     1078     else do:
     1079       for each buf_schedule
     1080          where buf_schedule.task-type     = p-task-type
     1081            AND buf_schedule.cre-db-num    = INTEGER(p-db-num-char)
     1082          no-lock
     1083          ,
     1084          first buf_schedule-attr
     1085          where buf_schedule-attr.task-type   = p-task-type
     1086            AND buf_schedule-attr.cre-db-num  = INTEGER(p-db-num-char)
     1087            AND buf_schedule-attr.task-num    = buf_schedule.task-num
     1088            AND buf_schedule-attr.attr-code   = ('schd-free-id':U + chr(4) + 'exp-sale')
     1089          no-lock
     1090          :
     1091          ASSIGN
     1092             v-task-num = buf_schedule.task-num
     1093          .
     1094          leave .
     1095       end.
     1096     end.
     1097     if v-task-num > 0
     1098     then do:
     1099       run schedule-attr-value in this-procedure  ( input p-db-num-char
     1100                                                  , input p-task-type
     1101                                                  , input v-task-num
     1102                                                  , input 'schedule-param-list':U
     1103                                                  , output v-param-list
     1104                                                  , output v-param-type
     1105                                                  ) NO-ERROR .
     1106     end.
     1107     v-ii2 = num-entries( v-param-list, chr(4) ).
     1108     if v-ii2 < 6 THEN do:
     1109       do v-ii1 = v-ii2 to 6:
     1110         v-param-list = v-param-list
     1111                      + '':U
     1112                      + chr(4).
     1113       end.
     1114     end.
     1115     ASSIGN
     1116        v-ftp-address   = ENTRY(1, v-param-list, chr(4))
     1117        v-login         = ENTRY(2, v-param-list, chr(4))
     1118        v-password      = ENTRY(3, v-param-list, chr(4))
     1119        v-name          = ENTRY(4, v-param-list, chr(4))
     1120        vRadio-set-1    = INTEGER( ENTRY(5, v-param-list, chr(4)) )
     1121        vHost-code_list = ENTRY(6, v-param-list, chr(4))
     1122     .
     1123     EMPTY TEMP-TABLE buf_tt-obj.
     1124     if vRadio-set-1 <> 3  then do:
     1125       if v-task-num > 0 then
     1126         run schedule-attr-value in this-procedure  ( input p-db-num-char
     1127                                                    , input p-task-type
     1128                                                    , input v-task-num
     1129                                                    , input 'schedule-obj-list':U
     1130                                                    , output v-obj-list
     1131                                                    , output v-param-type
     1132                                                    ) NO-ERROR .
     1133         define variable ii    as integer      no-undo.
     1134         define variable v-entry  as character no-undo .
     1135         do ii = 1 to num-entries(v-obj-list, chr(4))
     1136         on error undo, next
     1137         :
     1138            assign
     1139               v-entry = entry(ii, v-obj-list, chr(4))
     1140            .
     1141            FIND FIRST ub.clients
     1142                 WHERE ub.clients.obj-type = ENTRY(1, v-entry, chr(44))
     1143                   AND ub.clients.obj-code = INTEGER(ENTRY(2, v-entry, chr(44)))
     1144                 NO-LOCK
     1145                 NO-ERROR
     1146                 .
     1147            IF AVAILABLE ub.clients
     1148            THEN DO:
     1149               create tt-obj.
     1150               ASSIGN
     1151                  tt-obj.obj-code  = ub.clients.obj-code
     1152                  tt-obj.obj-type  = ub.clients.obj-type
     1153                  tt-obj.obj-name  = ub.clients.obj-name
     1154                  tt-obj.host-code = ub.clients.host-code
     1155               .
     1156            END.
     1157         end.
     1158       end.
     1159       else do:
     1160         FOR EACH ub.clients NO-LOCK
     1161           WHERE ub.clients.obj-type = 'маг':U
     1162         :
     1163           if lookup( string( ub.clients.host-code ), vHost-code_list ) = 0 then
     1164             next.
     1165           CREATE tt-obj.
     1166           ASSIGN
     1167              tt-obj.obj-code  = ub.clients.obj-code
     1168              tt-obj.obj-type  = ub.clients.obj-type
     1169              tt-obj.obj-name  = ub.clients.obj-name
     1170              tt-obj.host-code = ub.clients.host-code
     1171           .
     1172         END.
     1173       end.
     1174     run rep/r-exp-sl.p ( INPUT ?
     1175                    , INPUT v-ftp-address
     1176                    , INPUT ""
     1177                    , INPUT ""
     1178                    , INPUT v-login
     1179                    , INPUT v-password
     1180                    , INPUT v-name
     1181                    , INPUT p-log-handle
     1182                    , INPUT TABLE tt-obj
     1183                    ) .
     1184   end.
