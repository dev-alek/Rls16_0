     2479   procedure display-title :
     2480      PUT stream  OutStream  UNFORMATTED  string( v-cntxt-host-name-obj +  " , " + x-store-type  +  " " + objname) at 50 format "x(85)" skip(2)
     2481             reportname  at 20 format "x(170)" skip
     2482             trim(str1)  at 35 format "x(75)" skip.
     2483        repeat i = 1 to num-entries(str2,chr(10)) :
     2484         PUT stream  OutStream  UNFORMATTED  entry(i,str2,chr(10))  at 1 format "x(170)" skip.
     2485        end.
     2486       i=0.
     2487         PUT stream  OutStream  UNFORMATTED  trim(str3)  at 35 format "x(75)" skip.
     2488        repeat i = 1 to num-entries(str4,chr(10)) :
     2489         PUT stream  OutStream  UNFORMATTED  entry(i,str4,chr(10))  at 1 format "x(170)" skip.
     2490        end.
     2491       i=0.
     2492        repeat i = 1 to num-entries(reportheader,chr(10)) :
     2493         PUT stream  OutStream  UNFORMATTED  entry(i,reportheader,chr(10))  at 1 format "x(170)" skip.
     2494        end.
     2495       i=0.
     2496       run rep/extitle.p (1) .
     2497   end procedure.
     2498   procedure report-exec1  :
     2499      find first a-clients where x-store-type = a-clients.obj-type and
     2500                                 x-store-code = a-clients.obj-code no-lock no-error.
     2501              if available a-clients then  objname = a-clients.obj-name .
     2502                                     else  objname = "объект не определен" .
     2503     run waitfram-show (objname) .
     2504     form with frame zapas .
     2505     if cli-art = "yes" then do:
     2506        gds-zap-artic:label in frame zapas = " Арт. Поставщика"  .
     2507     end.
     2508   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2509   form header
     2510     line format "x(194)" at 1 skip
     2511     "Продолжение - на следующей странице" at 30 skip
     2512     with frame bottomframe width 232 page-bottom no-labels no-box .
     2513   view stream outstream frame bottomframe .
     2514     run calcitog.
     2515     run print-header.
     2516     if xtogobj = false then do:
     2517        run rep/r-obpsd1.p (x-store-code, x-store-type, x-base-type , x-base-code ,x-type-itog, xshowgoods) .
     2518     end.
     2519     else do:
     2520       for each obj-list :
     2521          create all-obj-list.
     2522          buffer-copy obj-list to all-obj-list.
     2523       end.
     2524       for each all-obj-list :
     2525           for each obj-list : delete obj-list. end.
     2526           run create_obj-list (all-obj-list.obj-type, all-obj-list.obj-code) no-error .
     2527           find first obj-list .
     2528           PUT stream  OutStream  UNFORMATTED "ОБЪЕКТ (" + obj-list.obj-type + string(obj-list.obj-code) + ") " + obj-list.obj-name at 1 format "x(150)" skip.
     2529           run waitfram-show (obj-list.obj-name) .
     2530           run rep/r-obpsd1.p
     2531              (x-store-code, x-store-type, x-base-type , x-base-code ,x-type-itog, xshowgoods).
     2532       end.
     2533     end.
     2534   hide stream outstream frame bottomframe .
     2535   run print-footer.
     2536   end procedure.
     2537   procedure clear-item :
     2538   define variable kk as integer no-undo.
     2539    repeat kk = 1 to 6:
     2540    assign
     2541       prih             [kk]  = 0
     2542       rash             [kk]  = 0
     2543       kassa            [kk]  = 0
     2544       spis              [kk]  = 0
     2545       inv              [kk]  = 0
     2546       vzvr             [kk]  = 0
     2547       vzvr-post        [kk]  = 0
     2548       ostatok-end      [kk]  = 0
     2549       ostatok-start    [kk]  = 0   .
     2550          end.
     2551    end procedure.
     2552   procedure di :
     2553   define input parameter p1 as character no-undo.
     2554   define input parameter p2 as integer no-undo.
     2555   define input parameter p3 as character no-undo.
     2556   define input parameter p4 as character no-undo.
     2557   define input parameter p5 as character no-undo.
     2558   define input parameter p6 as character no-undo.
     2559   define input parameter p7 as character no-undo.
     2560    case caps(p7) :
     2561      when "bi":u then do:
     2562   if  not (
     2563      (bi-ostatok-start[1] = 0  and
     2564       bi-Prih         [1] = 0  AND
     2565       bi-RAsh         [1] = 0  AND
     2566       bi-KAssa        [1] = 0  AND
     2567       bi-Inv          [1] = 0  AND
     2568       bi-vzvr         [1] = 0  AND
     2569       bi-spis         [1] = 0  AND
     2570       bi-vzvr-post    [1] = 0  AND
     2571       bi-Ostatok-end  [1] = 0)) then DO:
     2572                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 sym11 sym12 sym13
     2573                   p3 @ gds-zap-b-code
     2574                   p4 @ gds-zap-artic
     2575                   p5 @ gds-zap-gds-name
     2576                   p6 @ gds-zap-unit-base
     2577                   p1 @ gds-type
     2578                   bi-ostatok-start[p2] when ( NOT( Show-SAle = true and p2 = 8 )) @  F-ostatok-start
     2579                   bi-Prih         [p2] when ( NOT( xShowgoods = true and p2 = 7 )) @  F-Prih
     2580                   bi-RAsh         [p2] when ( NOT( xShowgoods = true and p2 = 7 )) @  F-RAsh
     2581                   bi-KAssa        [p2] when ( NOT( xShowgoods = true and p2 = 7 )) @  F-KAssa
     2582                   bi-Inv          [p2] when ( NOT( xShowgoods = true and p2 = 7 )) @  F-Inv
     2583                   bi-spis         [p2] when ( NOT( xShowgoods = true and p2 = 7 )) @  F-spis
     2584                   bi-vzvr         [p2] when ( NOT( xShowgoods = true and p2 = 7 )) @  F-vzvr
     2585                   bi-vzvr-post    [p2] when ( NOT( xShowgoods = true and p2 = 7 )) @  F-vzvr-post
     2586                   bi-Ostatok-end  [p2] when ( NOT( Show-SAle = true and p2 = 8 ))  @  F-Ostatok-end
     2587                  with FRAME ZAPAS .
     2588                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     2589   end.
     2590       end.
     2591      end case.
     2592                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     2593    end procedure.
     2594   procedure di-qnty :
     2595   define input parameter p1 as character no-undo.
     2596   define input parameter p2 as integer no-undo.
     2597   define input parameter p3 as character no-undo.
     2598   define input parameter p4 as character no-undo.
     2599   define input parameter p5 as character no-undo.
     2600   define input parameter p6 as character no-undo.
     2601   define input parameter p7 as character no-undo.
     2602    case caps(p7) :
     2603      when "bi":u then  do :
     2604   if  not (
     2605      (bi-ostatok-start[1] = 0  and
     2606       bi-Prih         [1] = 0  AND
     2607       bi-RAsh         [1] = 0  AND
     2608       bi-KAssa        [1] = 0  AND
     2609       bi-Inv          [1] = 0  AND
     2610       bi-vzvr         [1] = 0  AND
     2611       bi-spis         [1] = 0  AND
     2612       bi-vzvr-post    [1] = 0  AND
     2613       bi-Ostatok-end  [1] = 0)) then DO:
     2614                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 sym11 sym12 sym13
     2615                   p3 @ gds-zap-b-code
     2616                   p4 @ gds-zap-artic
     2617                   p5 @ gds-zap-gds-name
     2618                   p6 @ gds-zap-unit-base
     2619                   p1 @ gds-type
     2620                   bi-ostatok-start[p2] when ( NOT( Show-SAle = true and p2 = 8 )) @  F-ostatok-start
     2621                   bi-Prih         [p2] when ( NOT( xShowgoods = true and p2 = 7 )) @  F-Prih
     2622                   bi-RAsh         [p2] when ( NOT( xShowgoods = true and p2 = 7 )) @  F-RAsh
     2623                   bi-KAssa        [p2] when ( NOT( xShowgoods = true and p2 = 7 )) @  F-KAssa
     2624                   bi-Inv          [p2] when ( NOT( xShowgoods = true and p2 = 7 )) @  F-Inv
     2625                   bi-spis         [p2] when ( NOT( xShowgoods = true and p2 = 7 )) @  F-spis
     2626                   bi-vzvr         [p2] when ( NOT( xShowgoods = true and p2 = 7 )) @  F-vzvr
     2627                   bi-vzvr-post    [p2] when ( NOT( xShowgoods = true and p2 = 7 )) @  F-vzvr-post
     2628                   bi-Ostatok-end  [p2] when ( NOT( Show-SAle = true and p2 = 8 ))  @  F-Ostatok-end
     2629                  with FRAME ZAPAS .
     2630                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     2631   end.
     2632   if  not (
     2633      (bi-ostatok-start[1] = 0  and
     2634       bi-Prih         [1] = 0  AND
     2635       bi-RAsh         [1] = 0  AND
     2636       bi-KAssa        [1] = 0  AND
     2637       bi-Inv          [1] = 0  AND
     2638       bi-vzvr         [1] = 0  AND
     2639       bi-spis         [1] = 0  AND
     2640       bi-vzvr-post    [1] = 0  AND
     2641       bi-Ostatok-end  [1] = 0)) then DO:
     2642       if Make-Excel then  put   stream ForExcel unformatted p3 CHR(9)
     2643                   p4 CHR(9)
     2644                   p5 CHR(9)
     2645                   p6 CHR(9)
     2646                      ( excel-qnty(bi-ostatok-start[1]) +  CHR(9))
     2647   if Show-cost  then  ( excel-sum(bi-ostatok-start[2]) +  CHR(9))   else ("")
     2648   if Show-sale  then  ( "" +                              CHR(9))   else ("")
     2649   if xShowgoods then  ( excel-qnty(bi-ostatok-start[7]) +  CHR(9))   else ("")
     2650                      ( excel-qnty(bi-Prih         [1]) +  CHR(9))
     2651   if Show-cost  then  ( excel-sum(bi-Prih         [2]) +  CHR(9))   else ("")
     2652   if Show-sale  then  ( excel-sum(bi-Prih         [8]) +  CHR(9))   else ("")
     2653                      ( excel-qnty(bi-RAsh         [1]) +  CHR(9))
     2654   if Show-cost  then  ( excel-sum(bi-RAsh         [2]) +  CHR(9))   else ("")
     2655   if Show-sale  then  ( excel-sum(bi-RAsh         [8]) +  CHR(9))   else ("")
     2656                      ( excel-qnty(bi-KAssa        [1]) +  CHR(9))
     2657   if Show-cost  then  ( excel-sum(bi-KAssa        [2]) +  CHR(9))   else ("")
     2658   if Show-sale  then  ( excel-sum(bi-KAssa        [8]) +  CHR(9))   else ("")
     2659                      ( excel-qnty(bi-Inv          [1]) +  CHR(9))
     2660   if Show-cost  then  ( excel-sum(bi-Inv          [2]) +  CHR(9))   else ("")
     2661   if Show-sale  then  ( excel-sum(bi-Inv          [8]) +  CHR(9))   else ("")
     2662                      ( excel-qnty(bi-spis         [1]) +  CHR(9))
     2663   if Show-cost  then  ( excel-sum(bi-spis         [2]) +  CHR(9))   else ("")
     2664   if Show-sale  then  ( excel-sum(bi-spis         [8]) +  CHR(9))   else ("")
     2665                      ( excel-qnty(bi-vzvr         [1]) +  CHR(9))
     2666   if Show-cost  then  ( excel-sum(bi-vzvr         [2]) +  CHR(9))   else ("")
     2667   if Show-sale  then  ( excel-sum(bi-vzvr         [8]) +  CHR(9))   else ("")
     2668                      ( excel-qnty(bi-vzvr-post    [1]) +  CHR(9))
     2669   if Show-cost  then  ( excel-sum(bi-vzvr-post    [2]) +  CHR(9))   else ("")
     2670   if Show-sale  then  ( excel-sum(bi-vzvr-post    [8]) +  CHR(9))   else ("")
     2671                      ( excel-qnty(bi-Ostatok-end  [1]) +  CHR(9))
     2672   if Show-cost  then  ( excel-sum(bi-Ostatok-end  [2]) +  CHR(9))   else ("")
     2673   if Show-sale  then  (  "" +                             CHR(9))   else ("")
     2674   if xShowgoods then  ( excel-qnty(bi-ostatok-end[7]) +  CHR(9))   else ("")
     2675      chr(10).
     2676   end.
     2677         end.
     2678      end case.
     2679                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     2680    end procedure.
     2681   procedure clear-itembi- :
     2682   define variable kk as integer no-undo.
     2683    repeat kk = 1 to 9:
     2684    assign
     2685      bi-prih             [kk]  = 0
     2686      bi-rash             [kk]  = 0
     2687      bi-kassa            [kk]  = 0
     2688      bi-spis             [kk]  = 0
     2689      bi-inv              [kk]  = 0
     2690      bi-vzvr             [kk]  = 0
     2691      bi-vzvr-post        [kk]  = 0
     2692      bi-ostatok-end      [kk]  = 0
     2693      bi-ostatok-start    [kk]  = 0
     2694      .
     2695      end.
     2696    end procedure.
