     1143   procedure proc-alt-shift-f2:
     1144     if not ibs.th.gbl.gbl-var:rcode
     1145   then
     1146     run gbl\inidebug.p .
     1147   end.
     1148   procedure proc-alt-shift-f3:
     1149     run gbl/prvssinf.p
     1150       ( input this-procedure
     1151       ) .
     1152   end.
     1153   define variable v-inform-launched as logical no-undo initial false .
     1154   procedure proc-alt-shift-f4:
     1155     define variable v-action as character no-undo .
     1156     if v-inform-launched = false then do:
     1157       assign
     1158         v-inform-launched = true
     1159       .
     1160       run gbl/d-inform.w
     1161         (  input self
     1162         ,  input this-procedure
     1163         , output v-action
     1164         ) no-error .
     1165       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
     1166       assign
     1167         v-inform-launched = false
     1168       .
     1169     end.
     1170   end.
     1171   procedure proc-alt-f1:
     1172     run gbl/corrhelp.p
     1173       (input this-procedure
     1174       ) .
     1175   end .
     1176   on alt-shift-f2 anywhere do:
     1177     run proc-alt-shift-f2.
     1178   end.
     1179   on alt-shift-f3 anywhere do:
     1180     run proc-alt-shift-f3 in this-procedure .
     1181   end.
     1182   on alt-shift-f4 anywhere do:
     1183     run proc-alt-shift-f4 in this-procedure.
     1184   end.
     1185   on alt-f1 anywhere do:
     1186     run proc-alt-f1 in this-procedure .
     1187   end.
