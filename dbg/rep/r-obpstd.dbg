      631     index ie2 obj-name
      632   .
      633   procedure create_obj-list :
      634      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      635      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      636      do
      637      on error undo, return error return-value
      638      :
      639         define buffer cli-obj for ub.clients .
      640         define variable p-var as integer no-undo .
      641         define buffer buf_obj-list for obj-list .
      642         find last buf_obj-list  use-index pi no-error .
      643         if available buf_obj-list
      644         then
      645            p-var = buf_obj-list.obj-id + 1.
      646         else
      647            p-var = 1.
      648         find first cli-obj where
      649                   cli-obj.obj-type = p-obj-type
      650               and cli-obj.obj-code = p-obj-code
      651         no-lock no-error.
      652         if available cli-obj
      653         then do:
      654            create buf_obj-list.
      655            assign
      656               buf_obj-list.obj-id   = p-var
      657               buf_obj-list.obj-code = cli-obj.obj-code
      658               buf_obj-list.obj-type = cli-obj.obj-type
      659               buf_obj-list.obj-name = cli-obj.obj-name
      660               buf_obj-list.db-num   = cli-obj.db-num
      661            .
      662         end.
      663      end.
      664   end.
