     1794   .
     1795        assign
     1796           i=0
     1797           xlavel        = xvar-lavel
     1798           select-good   = x-selectgood
     1799           paytype       = x-set_pay_type
     1800           retclassify   = xclassify
     1801           retsorttype   = xsorttype
     1802           sums-only     = if x-type-itog = 1  then true else false
     1803           show-negativ  = xshowzero
     1804           cli-art       = x-cli-art
     1805           postname      = x-postname
     1806           radpost       = x-radpost
     1807                 xtogobj = xtog-obj
     1808                 t-in    = xt-in
     1809           firstline     = false
     1810           line          = fill("-", 232)
     1811           type-stor     =  xtype-stor
     1812           valtype       = if (paytype = 1) then 0  else x-set_val_type.
     1813           xlavel = 0.
     1814   if  xtog-lavel    then  xlavel        =  xvar-lavel .
     1815   if  xtog-lavel-2  then  xlavel        =  xvar-lavel-2 .
     1816    if postname = 'все':U or postname = "" or postname = ?   then do:
     1817       for each g#post-f : delete g#post-f. end.
     1818       for each clients
     1819                 no-lock  :
     1820                       find first cli-grp where cli-grp.node-code = clients.grp-code no-lock no-error .
     1821                       if available cli-grp then do:
     1822                           create g#post-f.
     1823                           assign
     1824                             g#post-f.obj-type = clients.obj-type
     1825                             g#post-f.obj-code = clients.obj-code
     1826                             g#post-f.obj-name = clients.obj-name
     1827                             g#post-f.grp-code = clients.grp-code
     1828                             g#post-f.grp-name = clients.grp-name
     1829                             g#post-f.lvl-num  = cli-grp.lvl-num
     1830                           .
     1831                       end.
     1832       end.
     1833    end.
     1834    run report-execute.
     1835   function excel-format-dec-to-char returns char (input p-dec as decimal ).
     1836     if num-entries(string(p-dec), '.') = 2
     1837       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
     1838       else return( string(p-dec)) .
     1839   end function.
     1840   function format-point-to-comma returns char (input orig as char ) .
     1841   define variable rtext as character no-undo .
     1842   define variable strt as integer no-undo .
     1843   define variable leng as integer no-undo .
     1844   assign rtext = orig .
     1845   repeat:
     1846     strt =  index(rtext,'.').
     1847     if strt = 0 then leave.
     1848     leng = 1.
     1849     substring(rtext,strt,leng,"character") = v-delim .
     1850   end.
     1851   return rtext.
     1852   end function.
     1853   function format-excel-text returns char ( input start-text as char ) :
     1854   def var  i    as int no-undo.
     1855   def var  ch   as char no-undo.
     1856   def var  n    as int no-undo.
     1857   def var  ipos as int no-undo.
     1858     n = num-entries(trim(start-text), chr(10)) - 1 .
     1859     do i = 1 to n :
     1860       ipos = index( start-text, chr(10)).
     1861       if ipos > 0 then
     1862         substr( start-text, ipos, 1 ) = ' '.
     1863     end.
     1864     n = num-entries(trim(start-text), chr(13)) - 1 .
     1865     do i = 1 to n :
     1866       ipos = index( start-text, chr(13)).
     1867       if ipos > 0 then
     1868         substr( start-text, ipos, 1 ) = ' '.
     1869     end.
     1870     if index( start-text, '"' ) = 0 then
     1871       start-text =  '="'   + trim( start-text) + '"'   .
     1872       else do:
     1873         n = num-entries(trim(start-text), '"') - 1.
     1874         do i = 1 to n :
     1875           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1876         end.
     1877         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1878         start-text = '="'  + ch  + '"' .
     1879       end.
     1880     return start-text.
     1881   end.
     1882   function excel-sum returns char (input p-dec as decimal ).
     1883     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
     1884   end function.
     1885   function excel-qnty returns char (input p-dec as decimal ).
     1886     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
     1887   end function.
     1888   function format-excel-text-macr returns char ( input start-text as char ) :
     1889   def var  i    as int no-undo.
     1890   def var  ch   as char no-undo.
     1891   def var  n    as int no-undo.
     1892   def var  ipos as int no-undo.
     1893     n = num-entries(trim(start-text), chr(10)) - 1 .
     1894     do i = 1 to n :
     1895       ipos = index( start-text, chr(10)).
     1896       if ipos > 0 then
     1897         substring( start-text, ipos , 1 ) = ' '.
     1898     end.
     1899     n = num-entries(trim(start-text), chr(13)) - 1 .
     1900     do i = 1 to n :
     1901       ipos = index( start-text, chr(13)).
     1902       if ipos > 0 then
     1903         substring( start-text, ipos, 1 ) = ' '.
     1904     end.
     1905     if index( start-text, '"' ) = 0 then
     1906       start-text =  '"'   + trim( start-text) + '"'   .
     1907       else do:
     1908         n = num-entries(trim(start-text), '"') - 1.
     1909         do i = 1 to n :
     1910           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1911         end.
     1912         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1913         start-text = '"'  + ch  + '"' .
     1914       end.
     1915     n = num-entries(trim(start-text), chr(10)) - 1 .
     1916     do i = 1 to n :
     1917       ipos = index( start-text, chr(10)).
     1918       if ipos > 0 then
     1919         substring( start-text, ipos , 1 ) = ' '.
     1920     end.
     1921       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
     1922     return start-text.
     1923   end.
     1924   FUNCTION n-lavel RETURNS char (INPUT grp-name as char, INPUT lavel# as int ).
     1925   define variable  str  as char format "X(60)"  no-undo.
     1926   define variable  str2 as char no-undo.
     1927   define variable v-r as character no-undo init "" .
     1928   define variable  i#i as int no-undo.
     1929   STR = "".
     1930   repeat i#i =1 to lavel#:
     1931       if i#i =1 then str   = entry(1,grp-name, chr(47)) .
     1932       else do:
     1933           str2 = entry(i#i,grp-name, chr(47)) no-error.
     1934           if not error-status:error  and str2 <> "":u then
     1935                  str = str +  chr(47) +  entry(i#i,grp-name, chr(47)) no-error .
     1936           end.
     1937   end.
     1938   if str <> ? then do:
     1939   v-r = str + chr(47) .
     1940   end.
     1941   RETURN v-r .
     1942   END FUNCTION.
     1943   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1944   procedure factord :
     1945     define input  parameter p-fact-date            as date    no-undo .
     1946     define input  parameter p-fact-time            as integer no-undo .
     1947     define input  parameter p-fact-num             as integer no-undo .
     1948     define input  parameter p-shift-date           as date    no-undo .
     1949     define input  parameter p-shift-num            as integer no-undo .
     1950     define input  parameter p-shift-on             as logical no-undo .
     1951     define output parameter p-fact-order           as decimal no-undo .
     1952     define output parameter p-shift-end-fact-order as decimal no-undo .
     1953     define output parameter p-day-end-fact-order   as decimal no-undo .
     1954     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     1955     if p-fact-date = ?
     1956     then do:
     1957       return error "Не указана фактическая дата" .
     1958     end.
     1959     define variable v-fact-date-num as integer no-undo .
     1960     assign
     1961       v-fact-date-num = integer(p-fact-date)
     1962     .
     1963     if p-fact-num = ?
     1964     or p-fact-num = 0
     1965     then do:
     1966       return error "Не задан p-fact-num " + string(p-fact-num) .
     1967     end.
     1968     if p-fact-num < 0
     1969     then do:
     1970       return error "Отрицательный fact-num " + string(p-fact-num) .
     1971     end.
     1972     if p-fact-num >= 100000000
     1973     then do:
     1974       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     1975     end.
     1976     if p-shift-on = true
     1977     then do:
     1978       if p-shift-date = ?
     1979       then do:
     1980         return error "Не задана дата смены" .
     1981       end.
     1982       if p-shift-num = ?
     1983       or p-shift-num = 0
     1984       then do:
     1985         return error "Не задан номер смены" .
     1986       end.
     1987     end.
     1988     else do:
     1989       assign
     1990         p-shift-date = p-fact-date
     1991         p-shift-num  = 24
     1992       .
     1993     end.
     1994     define variable v-shift-offset as integer no-undo .
     1995     if p-shift-date = p-fact-date
     1996     then do:
     1997       assign
     1998         v-shift-offset = 1
     1999       .
     2000     end.
     2001     if p-shift-date < p-fact-date
     2002     then do:
     2003       assign
     2004         v-shift-offset = 0
     2005       .
     2006     end.
     2007     if p-shift-date > p-fact-date
     2008     then do:
     2009       message
     2010         vss-workfile vss-revision vss-description skip
     2011         "Неправильная дата закрытия смены" skip
     2012         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     2013         view-as alert-box error .
     2014       undo, return error
     2015         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     2016           ,string(p-fact-date, '99/99/9999':U)
     2017           ,string(p-shift-date, '99/99/9999':U)
     2018           )
     2019       .
     2020     end.
     2021     if p-shift-num < 1
     2022     or p-shift-num > 24
     2023     then do:
     2024       message
     2025         vss-workfile vss-revision vss-description skip
     2026         "Неправильный номер смены" skip
     2027         "p-shift-num" p-shift-num skip
     2028         view-as alert-box error .
     2029       undo, return error return-value .
     2030     end.
     2031     assign
     2032       p-fact-order           = v-fact-date-num
     2033                              + v-shift-offset * 0.5
     2034                              + p-shift-num    * 0.02 - 0.01
     2035                              + p-fact-num     * 0.0000000001
     2036       p-shift-end-fact-order = v-fact-date-num
     2037                              + v-shift-offset * 0.5
     2038                              + p-shift-num    * 0.02
     2039       p-day-end-fact-order   = v-fact-date-num
     2040                              + 0.99
     2041     .
     2042     if p-fact-order           <= v-fact-date-num
     2043     or p-shift-end-fact-order <= v-fact-date-num
     2044     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     2045     or p-shift-end-fact-order >= p-day-end-fact-order
     2046     then do:
     2047       message
     2048         vss-workfile vss-revision vss-description skip
     2049         "Внутренняя ошибка при генерации фактического номера" skip
     2050         "p-fact-date"            p-fact-date            skip
     2051         "p-fact-time"            p-fact-time            skip
     2052         "p-fact-num"             p-fact-num             skip
     2053         "p-shift-date"           p-shift-date           skip
     2054         "p-shift-num"            p-shift-num            skip
     2055         "p-shift-on"             p-shift-on             skip
     2056         "p-shift-end-fact-order" p-shift-end-fact-order skip
     2057         "p-day-end-fact-order"   p-day-end-fact-order   skip
     2058         "v-fact-date-num"        v-fact-date-num        skip
     2059         view-as alert-box error .
     2060       undo, return error return-value .
     2061     end.
     2062   end procedure.
     2063   procedure day-begin-fact-order :
     2064     define input  parameter p-fact-date            as date    no-undo .
     2065     define output parameter p-day-begin-fact-order as decimal no-undo .
     2066     do
     2067     on error undo, return error return-value
     2068     :
     2069       if p-fact-date = ?
     2070       then do:
     2071         assign
     2072           p-day-begin-fact-order = 0
     2073         .
     2074       end.
     2075       else do:
     2076         assign
     2077           p-day-begin-fact-order = integer(p-fact-date)
     2078         .
     2079       end.
     2080     end.
     2081   end procedure.
     2082   procedure factord-max-fact-order :
     2083     define output parameter p-max-fact-order as decimal   no-undo .
     2084     do
     2085     on error undo, return error return-value
     2086     :
     2087       run day-begin-fact-order in this-procedure
     2088         (input  date(1, 1, 5000)
     2089         ,output p-max-fact-order
     2090         ) .
     2091     end.
     2092   end procedure.
     2093   procedure factord-cut-archive :
     2094     define input  parameter p-obj-type             as character no-undo .
     2095     define input  parameter p-obj-code             as integer   no-undo .
     2096     define input  parameter p-fact-date            as date      no-undo .
     2097     define output parameter p-shift-on             as logical   no-undo .
     2098     define output parameter p-shift-date           as date      no-undo .
     2099     define output parameter p-shift-num            as integer   no-undo .
     2100     define output parameter p-day-end-fact-order   as decimal   no-undo .
     2101     define output parameter p-shift-end-fact-order as decimal   no-undo .
     2102     define variable v-fact-order as decimal   no-undo .
     2103     define buffer buf_shift-obj for ub.shift-obj .
     2104     do
     2105     on error undo, return error return-value
     2106     :
     2107   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2108   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     2109     (input  p-obj-type
     2110     ,input  p-obj-code
     2111     ,input  'shift-on=request'
     2112     ,output p-shift-on
     2113     ) no-error .
     2114       if error-status :error
     2115       then do:
     2116         message
     2117           vss-workfile vss-revision vss-description skip
     2118           "Ошибка при определении атрибута объекта" skip
     2119           "Объект" p-obj-type p-obj-code skip
     2120           error-status :get-message(1) skip
     2121           return-value skip
     2122           view-as alert-box error .
     2123         undo, return error return-value .
     2124       end.
     2125       if p-shift-on = false
     2126       then do:
     2127         assign
     2128           p-shift-date               = ?
     2129           p-shift-num                = 0
     2130         .
     2131       end.
     2132       else do:
     2133         find first buf_shift-obj share-lock
     2134           where buf_shift-obj.obj-type   = p-obj-type
     2135             and buf_shift-obj.obj-code   = p-obj-code
     2136             and buf_shift-obj.shift-date > p-fact-date
     2137           use-index pi
     2138           no-error .
     2139         if not available buf_shift-obj
     2140         or buf_shift-obj.status_ <> 'зкр':U
     2141         then do:
     2142           message
     2143             vss-workfile vss-revision vss-description skip
     2144             "Невозможно вычислить последнюю смену" skip
     2145             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     2146             "Объект" p-obj-type p-obj-code skip
     2147             "Дата" p-fact-date skip
     2148             view-as alert-box error .
     2149           undo, return error return-value .
     2150         end.
     2151         find last buf_shift-obj share-lock
     2152           where buf_shift-obj.obj-type = p-obj-type
     2153             and buf_shift-obj.obj-code = p-obj-code
     2154             and buf_shift-obj.shift-date <= p-fact-date
     2155           use-index pi
     2156           no-error .
     2157         if available buf_shift-obj
     2158         then do:
     2159           if  buf_shift-obj.status_ = 'зкр':U
     2160           then do:
     2161             assign
     2162               p-shift-date = buf_shift-obj.shift-date
     2163               p-shift-num  = buf_shift-obj.shift-num
     2164             .
     2165           end.
     2166           else do:
     2167             message
     2168               vss-workfile vss-revision vss-description skip
     2169               "Невозможно вычислить последнюю смену" skip
     2170               "Статус смены отличен от статуса" 'зкр':U skip
     2171               "Объект" p-obj-type p-obj-code skip
     2172               "Дата" p-fact-date skip
     2173               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     2174               view-as alert-box error .
     2175             undo, return error return-value .
     2176           end.
     2177         end.
     2178         else do:
     2179           assign
     2180             p-shift-date = p-fact-date - 1
     2181             p-shift-num  = 1
     2182           .
     2183         end.
     2184       end.
     2185       run factord in this-procedure
     2186         (input  p-fact-date
     2187         ,input  1
     2188         ,input  1
     2189         ,input  p-shift-date
     2190         ,input  p-shift-num
     2191         ,input  p-shift-on
     2192         ,output v-fact-order
     2193         ,output p-shift-end-fact-order
     2194         ,output p-day-end-fact-order
     2195         ) no-error .
     2196       if error-status :error
     2197       then do:
     2198         message
     2199           vss-workfile vss-revision vss-description skip
     2200           "Ошибка при вызове процедуры factord"
     2201           error-status :get-message(1) skip
     2202           return-value skip
     2203           view-as alert-box error .
     2204         undo, return error return-value .
     2205       end.
     2206     end.
     2207   end procedure.
     2208   procedure factord-lock-shift :
     2209     define input  parameter p-obj-type  as character no-undo .
     2210     define input  parameter p-obj-code  as integer   no-undo .
     2211     define input  parameter p-fact-date as date      no-undo .
     2212     define parameter buffer buf_shift-obj for ub.shift-obj .
     2213     define variable v-shift-on      as logical   no-undo .
     2214     define variable v-extra-message as character no-undo .
     2215     define variable v-error as character no-undo .
     2216     do
     2217     on error undo, return error return-value
     2218     :
     2219   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2220   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     2221     (input  p-obj-type
     2222     ,input  p-obj-code
     2223     ,input  'shift-on=request'
     2224     ,output v-shift-on
     2225     ) no-error .
     2226       if error-status :error
     2227       then do:
     2228         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     2229         undo, return error v-error .
     2230       end.
     2231       if v-shift-on = true
     2232       then do:
     2233         find first buf_shift-obj share-lock
     2234           where buf_shift-obj.obj-type   = p-obj-type
     2235             and buf_shift-obj.obj-code   = p-obj-code
     2236             and buf_shift-obj.shift-date > p-fact-date
     2237           use-index pi
     2238           no-error .
     2239         if not available buf_shift-obj
     2240         or buf_shift-obj.status_ <> 'зкр':U
     2241         then do:
     2242           find last buf_shift-obj
     2243             where buf_shift-obj.obj-type = p-obj-type
     2244               and buf_shift-obj.obj-code = p-obj-code
     2245               and buf_shift-obj.status_  = 'зкр':U
     2246             use-index stts
     2247             no-error .
     2248           if available buf_shift-obj
     2249           then do:
     2250             assign
     2251               v-extra-message =
     2252                     substitute("Дата начала последеней закрытой смены на объекте &1"
     2253                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     2254                               )
     2255             .
     2256           end.
     2257           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     2258           undo, return error v-error .
     2259         end.
     2260       end.
     2261     end.
     2262   end procedure.
     2263   procedure factord-end-day :
     2264     define input  parameter p-fact-date            as date    no-undo .
     2265     define output parameter p-day-end-fact-order   as decimal no-undo .
     2266     do
     2267     on error undo, return error return-value
     2268     :
     2269       if p-fact-date = ?
     2270       then do:
     2271         return error "Не указана фактическая дата" .
     2272       end.
     2273       assign
     2274         p-day-end-fact-order = integer(p-fact-date) + 0.99
     2275       .
     2276     end.
     2277   end procedure.
     2278   procedure factord-to-date :
     2279     define input  parameter p-fact-order as decimal no-undo .
     2280     define output parameter p-fact-date  as date    no-undo .
     2281     define variable v-ref-date  as date      no-undo .
     2282     define variable v-ref-delta as integer   no-undo .
     2283     do
     2284     on error undo, return error return-value
     2285     :
     2286       if p-fact-order = ?
     2287       or p-fact-order = 0
     2288       then do:
     2289         return error "Не указан fact-order" .
     2290       end.
     2291       assign
     2292         v-ref-date  = date(1, 1, 2000)
     2293       .
     2294       assign
     2295         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     2296       .
     2297       assign
     2298         p-fact-date = v-ref-date + v-ref-delta
     2299       .
     2300     end.
     2301   end procedure.
     2302   procedure factord-to-fact-num :
     2303     define input  parameter p-fact-order as decimal no-undo .
     2304     define output parameter p-fact-num   as integer no-undo .
     2305     define variable v-fact-order-trunc as decimal no-undo .
     2306     do
     2307     on error undo, return error return-value
     2308     :
     2309       if p-fact-order = ?
     2310       or p-fact-order = 0
     2311       then do:
     2312         return error "Не указан fact-order" .
     2313       end.
     2314       assign
     2315        v-fact-order-trunc = truncate(p-fact-order, 2)
     2316       .
     2317       assign
     2318         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     2319       .
     2320     end.
     2321   end procedure.
     2322   procedure factord-to-shift-num :
     2323     define input  parameter p-fact-order as decimal no-undo .
     2324     define output parameter p-shift-num   as integer no-undo .
     2325     define variable  p-shift-numd  as decimal   no-undo .
     2326     define variable v-fact-order-trunc as decimal no-undo .
     2327     do
     2328     on error undo, return error return-value
     2329     :
     2330       if p-fact-order = ?
     2331       or p-fact-order = 0
     2332       then do:
     2333         return error "Не указан fact-order" .
     2334       end.
     2335       assign
     2336        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     2337       .
     2338       if v-fact-order-trunc < 0.5 then do:
     2339         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     2340       end.
     2341       assign
     2342         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     2343         .
     2344        assign
     2345         p-shift-num = truncate (p-shift-numd , 0)
     2346       .
     2347     end.
     2348   end procedure.
     2349   procedure report-execute :
     2350     if ( valtype = 0 and x-base-code = 0)  or valtype = 1
     2351       then   assign tprintrubl = yes .
     2352       else   assign tprintrubl = no .
     2353     run waitfram-show ( 'Подождите ...' ) .
     2354   output stream outstream to value( string( session:temp-directory +
     2355                                        "rpt" + string( g#report-num ) ) )
     2356                                        page-size  value(reportpageheight) .
     2357     run report-exec1 in this-procedure .
     2358     hide   stream outstream frame zapas .
     2359     output stream outstream close.
     2360     run waitfram-hide .
     2361     if Make-Excel then output stream ForExcel close.
     2362     define variable v-user-action as character no-undo .
     2363     define variable v-printed as logical   no-undo .
     2364     define variable disabledoptions as integer   no-undo .
     2365     define variable v-orient-page as character no-undo .
     2366     run How-name in this-procedure (
     2367         input ReportPageHeight,
     2368         input ReportPageWidth,
     2369         output v-orient-page )
     2370         .
     2371     if v-orient-page = "A4-lans":U then DisabledOptions = 8 .
     2372                                    else DisabledOptions = 0 .
     2373     run gbl/prnfilen.w
     2374       (input  ""
     2375       ,input  disabledoptions
     2376       ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
     2377       ,input  reportFontNum
     2378       ,output v-user-action
     2379       ,output v-printed
     2380       ) .
     2381   end procedure.
     2382   procedure print-header :
     2383   if not firstline then  run display-title.
     2384       firstline = true .
     2385        form with FRAME ZAPAS .  DOWN stream   OutStream 1 with FRAME ZAPAS .
     2386        run clear-b1 .
     2387        run clear-b2.
     2388        run clear-bi .
     2389        break_group = true.
     2390        break_group1 = true.
     2391      end procedure.
     2392   procedure print-footer :
     2393         if retclassify = "no-classify":u  then run u-line.
     2394          gds-zap-artic = "ИТОГО" .
     2395          run display-bi.
     2396          run u-line.
     2397          end procedure.
     2398   procedure u-line :
     2399   underline stream outstream  sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 sym13
     2400     gds-zap-b-code
     2401     gds-zap-artic
     2402     gds-zap-gds-name
     2403     gds-zap-unit-base
     2404     gds-type
     2405     f-ostatok-start
     2406     f-prih
     2407     f-rash
     2408     f-kassa
     2409     f-spis
     2410     f-inv
     2411     f-vzvr
     2412     f-vzvr-post
     2413     f-ostatok-end
     2414     with FRAME ZAPAS .
     2415     DOWN stream   OutStream 1 with FRAME ZAPAS.
     2416     end procedure.
     2417   procedure p-line :
     2418   underline stream outstream
     2419     sym3
     2420     gds-zap-gds-name
     2421     sym4
     2422     gds-zap-unit-base
     2423     sym5
     2424     with FRAME ZAPAS.
     2425     DOWN stream   OutStream 1 with FRAME ZAPAS .
     2426     end procedure.
     2427   procedure calcitog :
     2428     run day-begin-fact-order ( input x-date-start , output fact-order-1).
     2429     run factord-end-day ( input x-date-end , output fact-order-2).
     2430   end procedure.
     2431   procedure display-bi  :
     2432     run di-qnty ("кол-во",1,  "", gds-zap-artic ,"" ,"", "bi":u).
     2433            if show-cost    then do: run di ("учет." , 2 , "","", "", "", "bi":u).  end.
     2434            if show-crsa    then do: run di ("прод." , 5, "","", "", "",  "bi":u).  end.
     2435            if xshowgoods    then do: run di ("в пути" , 7, "","", "", "",  "bi":u).  end.
     2436   end procedure.
     2437   procedure clear-b1  :
     2438    repeat kk = 1 to 6 :
     2439    assign
     2440       b1-prih                                            [kk]    = 0
     2441       b1-rash                                            [kk]    = 0
     2442       b1-kassa                                           [kk]    = 0
     2443       b1-spis                                            [kk]    = 0
     2444       b1-inv                                             [kk]    = 0
     2445       b1-vzvr                                            [kk]    = 0
     2446       b1-vzvr-post                                       [kk]    = 0
     2447       b1-ostatok-end                                     [kk]    = 0
     2448       b1-ostatok-start                                   [kk]    = 0   .
     2449      end.
     2450    end procedure.
     2451   procedure clear-b2  :
     2452    repeat kk = 1 to 6 :
     2453    assign
     2454       b2-prih                                            [kk]    = 0
     2455       b2-rash                                            [kk]    = 0
     2456       b2-kassa                                           [kk]    = 0
     2457       b2-spis                                            [kk]    = 0
     2458       b2-inv                                             [kk]    = 0
     2459       b2-vzvr                                            [kk]    = 0
     2460       b2-vzvr-post                                       [kk]    = 0
     2461       b2-ostatok-end                                     [kk]    = 0
     2462       b2-ostatok-start                                   [kk]    = 0   .
     2463      end.
     2464   end procedure.
     2465   procedure clear-bi  :
     2466    repeat kk = 1 to 6 :
     2467    assign
     2468       bi-prih                                            [kk]    = 0
     2469       bi-rash                                            [kk]    = 0
     2470       bi-kassa                                           [kk]    = 0
     2471       bi-inv                                             [kk]    = 0
     2472       bi-spis                                            [kk]    = 0
     2473       bi-vzvr                                            [kk]    = 0
     2474       bi-vzvr-post                                       [kk]    = 0
     2475       bi-ostatok-end                                     [kk]    = 0
     2476       bi-ostatok-start                                   [kk]    = 0   .
