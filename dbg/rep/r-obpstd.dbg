     1491   procedure create-temp-t-post-stk-line :
     1492       define variable str  as char      format "X(60)" no-undo.
     1493       define variable str2 as char      no-undo.
     1494       define variable v-r  as character no-undo init "" .
     1495       define variable i#i  as int       no-undo.
     1496    do
     1497    on error undo, return error return-value
     1498    :
     1499    if available ub.goods and
     1500       available ub.clients and
     1501       available prod-cli then do:
     1502     create temp-t-post-stk-line .
     1503     BUFFER-COPY post-stk-line  TO temp-t-post-stk-line
     1504     assign
     1505       temp-t-post-stk-line.goods-grp-name    = ub.goods.grp-name
     1506       temp-t-post-stk-line.gds-code          = ub.goods.gds-code
     1507       temp-t-post-stk-line.unit-base         = ub.goods.unit-base
     1508       temp-t-post-stk-line.prt-root          = ub.goods.prt-root
     1509       temp-t-post-stk-line.gds-type          = ub.goods.gds-type
     1510       temp-t-post-stk-line.gds-name          = if g#gds-engl then ub.goods.engl-name else ub.goods.gds-name
     1511       temp-t-post-stk-line.clients-grp-name  = ub.clients.grp-name
     1512       temp-t-post-stk-line.clients-obj-name  = ub.clients.obj-name
     1513       temp-t-post-stk-line.prod-cli-obj-name = prod-cli.obj-name
     1514       temp-t-post-stk-line.prod-cli-obj-code = prod-cli.obj-code
     1515       temp-t-post-stk-line.prod-cli-obj-type = prod-cli.obj-type
     1516     .
     1517               if xlavel > 0 then
     1518               do:
     1519                   repeat i#i =1 to xlavel:
     1520                       if i#i =1 then str   = entry(1,ub.goods.grp-name, chr(47)) .
     1521                       else
     1522                       do:
     1523                           str2 = entry(i#i,ub.goods.grp-name, chr(47)) no-error.
     1524                           if not error-status:error  and str2 <> "":u then
     1525                               str = str +  chr(47) +  entry(i#i,ub.goods.grp-name, chr(47)) no-error .
     1526                       end.
     1527                   end.
     1528                   if str <> ? then
     1529                   do:
     1530                       temp-t-post-stk-line.goods-grp-name = str + chr(47) .
     1531                   end.
     1532               end.
     1533               else
     1534               do :
     1535                   temp-t-post-stk-line.goods-grp-name = ub.goods.grp-name.
     1536               end.
     1537           end.
     1538    end.
     1539   end procedure.
     1540   define temp-table temp-font no-undo
     1541     field fontnum  as integer
     1542     field fontname as character
     1543     field fontsize as character
     1544     field fonttype as character
     1545     field font-h   as integer
     1546     field font-w   as integer
     1547     field v-row    as integer
     1548     field v-col    as integer
     1549     field v-row-lans as integer
     1550     field v-col-lans as integer
     1551   index pi fontnum
     1552   .
     1553   procedure get-font-ini :
     1554     do
     1555     on error undo, return error return-value
     1556     :
     1557   define variable ii as integer   no-undo .
     1558   define variable v-font7 as character no-undo .
     1559   define variable v-font as character no-undo .
     1560   define variable loc-name as character no-undo .
     1561   define variable loc-size as character no-undo .
     1562   define variable loc-type as character no-undo .
     1563   define variable old_H as integer   no-undo .
     1564   define variable old_w as integer   no-undo .
     1565   define variable old-row  as integer   no-undo .
     1566   define variable old-col  as integer   no-undo .
     1567   define variable old-row-lans  as integer   no-undo .
     1568   define variable old-col-lans  as integer   no-undo .
     1569   define variable vv as integer   no-undo .
     1570   empty temp-table temp-font.
     1571     GET-KEY-VALUE SECTION "fonts" KEY "font7" VALUE v-font7 .
     1572       case num-entries (v-font7) :
     1573         when 4 then do:
     1574             assign
     1575               loc-name = entry ( 1 , v-font7 )
     1576               loc-size = entry ( 2 , v-font7 )
     1577               loc-type = entry ( 3 , v-font7 ) + "," +  entry ( 4 , v-font7 )
     1578             .
     1579         end.
     1580         when 3 then do:
     1581             assign
     1582               loc-name = entry ( 1 , v-font7 )
     1583               loc-size = entry ( 2 , v-font7 )
     1584               loc-type = entry ( 3 , v-font7 )
     1585             .
     1586         end.
     1587         when 2 then  do:
     1588             assign
     1589               loc-name = entry ( 1 , v-font7 )
     1590               loc-size = entry ( 2 , v-font7 )
     1591               loc-type = ""
     1592             .
     1593         end.
     1594         when 1 then do:
     1595             assign
     1596               loc-name = trim(entry ( 1 , v-font7 ))
     1597               loc-size = ""
     1598               loc-type = ""
     1599             .
     1600         end.
     1601       end case.
     1602     create temp-font.
     1603     assign
     1604       temp-font.fontnum  = 7
     1605       temp-font.fontname = trim(loc-name)
     1606       temp-font.fontsize = trim(loc-size)
     1607       temp-font.fonttype = trim(loc-type)
     1608       temp-font.v-row    = 62
     1609       temp-font.v-col    = 136
     1610       temp-font.v-row-lans = 43
     1611       temp-font.v-col-lans = 198
     1612     .
     1613     repeat ii = 16 to 100 :
     1614       get-key-value section 'fonts' key 'font' + string(ii)   value v-font  .
     1615       if v-font = "" or v-font = ? then leave.
     1616       case num-entries (v-font) :
     1617         when 4 then do:
     1618             assign
     1619               loc-name = entry ( 1 , v-font )
     1620               loc-size = entry ( 2 , v-font )
     1621               loc-type = entry ( 3 , v-font ) + "," +  entry ( 4 , v-font )
     1622             .
     1623         end.
     1624         when 3 then do:
     1625             assign
     1626               loc-name = entry ( 1 , v-font )
     1627               loc-size = entry ( 2 , v-font )
     1628               loc-type = entry ( 3 , v-font )
     1629             .
     1630         end.
     1631         when 2 then do:
     1632             assign
     1633               loc-name = entry ( 1 , v-font )
     1634               loc-size = entry ( 2 , v-font )
     1635               loc-type = ""
     1636             .
     1637         end.
     1638         when 1 then do:
     1639             assign
     1640               loc-name = trim(entry ( 1 , v-font ))
     1641               loc-size = ""
     1642               loc-type = ""
     1643             .
     1644         end.
     1645       end case.
     1646     create temp-font.
     1647     assign
     1648       temp-font.fontnum  = ii
     1649       temp-font.fontname = trim(loc-name)
     1650       temp-font.fontsize = trim(loc-size)
     1651       temp-font.fonttype = trim(loc-type)
     1652     .
     1653     end.
     1654       for each temp-font :
     1655          vv = integer(entry(2,temp-font.fontsize, "=" )) no-error .
     1656          if  vv = ? then vv =  0 .
     1657           run rep/exfont.p (
     1658             input   temp-font.fontname ,
     1659             input   vv ,
     1660             input   temp-font.fonttype ,
     1661             output  temp-font.font-h   ,
     1662             output  temp-font.font-w   )
     1663           .
     1664       end.
     1665   find first temp-font where  temp-font.fontnum  = 7  .
     1666   old_H = temp-font.font-H .
     1667   old_w = temp-font.font-W .
     1668   old-row = temp-font.v-row .
     1669   old-col = temp-font.v-col .
     1670   old-row-lans = temp-font.v-row-lans .
     1671   old-col-lans = temp-font.v-col-lans .
     1672       for each temp-font where
     1673                temp-font.fontnum  <> 7 :
     1674           assign
     1675               temp-font.v-row    = old_H * old-row / temp-font.font-h
     1676               temp-font.v-col    = old_W * old-col / temp-font.font-W
     1677               temp-font.v-row-lans    = old_H * old-row-lans / temp-font.font-h
     1678               temp-font.v-col-lans    = old_W * old-col-lans / temp-font.font-W
     1679           .
     1680       end.
     1681     end.
     1682   end procedure.
     1683   PROCEDURE How-name :
     1684   define input  parameter h as integer no-undo .
     1685   define input  parameter w as integer no-undo .
     1686   define output parameter n as character  no-undo .
     1687   define variable A4port-H as integer   no-undo init 63.
     1688   define variable A4port-W as integer   no-undo init 136.
     1689   define variable A4lans-H as integer   no-undo init 43.
     1690   define variable A4lans-W as integer   no-undo init 198.
     1691   define variable Strim-W  as integer   no-undo init 278.
     1692   run define-a4-size (
     1693        input ReportFontNum
     1694       ,output A4port-H
     1695       ,output A4port-W
     1696       ,output A4lans-H
     1697       ,output A4lans-W ).
     1698   If w >= 1 and w <= A4port-W Then DO:
     1699     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     1700     If h > A4lans-H  and h <= A4port-H Then n = "A4-port":U.
     1701     If h > A4port-H              Then n = "to-file":U.
     1702   End.
     1703   If w > A4port-W and w <= A4lans-W Then DO:
     1704     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     1705     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     1706     If h > A4port-H              Then n = "to-file":U.
     1707   End.
     1708   If w > A4lans-W and w <= Strim-W Then DO:
     1709     If h >= 1  and h <= A4lans-H Then n = "to-file":U.
     1710     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     1711     If h > A4port-H              Then n = "to-file":U.
     1712   End.
     1713   If w > Strim-W Then DO:
     1714      n = "to-file":U.
     1715   End.
     1716   END PROCEDURE.
     1717   PROCEDURE define-a4-size :
     1718   define input  parameter p-ReportFontNum as integer   no-undo .
     1719   define output parameter A4port-H as integer   no-undo .
     1720   define output parameter A4port-W as integer   no-undo .
     1721   define output parameter A4lans-H as integer   no-undo .
     1722   define output parameter A4lans-W as integer   no-undo .
     1723   if not can-find (first temp-font ) then do:
     1724      run get-font-ini .
     1725   end.
     1726   find first temp-font where temp-font.fontnum = p-ReportFontNum no-error .
     1727   if available temp-font then do:
     1728   assign
     1729     A4port-H = temp-font.v-row
     1730     A4port-W = temp-font.v-col
     1731     A4lans-H = temp-font.v-row-lans
     1732     A4lans-W = temp-font.v-col-lans
     1733   .
     1734   end.
     1735   else do:
     1736   assign
     1737     A4port-H = 63
     1738     A4port-W = 136
     1739     A4lans-H = 43
     1740     A4lans-W = 198
     1741   .
     1742   end.
     1743   END PROCEDURE.
