        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: r-obpstd.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: rep/r-obpstd.p $":U .
        7   define variable vss-description as character no-undo init "Оборотная ведомость по поставщикам по дкументам ".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       63   define variable v-waitfram-action01         as character   no-undo .
       64   define variable v-waitfram-action02         as character   no-undo .
       65   define variable v-waitfram-action03         as character   no-undo .
       66   define variable mWaitFramTextBeg            as character   no-undo.
       67   define variable mWaitFramTextEnd            as character   no-undo.
       68   define variable mWaitFramView               as logical     no-undo.
       69   define variable mWaitProcEvent              as logical     no-undo init yes.
       70   define variable mWaitFramInterval           as integer     no-undo init 1 .
       71   define variable mWaitFramStop               as logical     no-undo.
       72   define variable mWaitFramStopUser           as logical     no-undo.
       73   define variable mWaitFramStopTimeOut        as logical     no-undo.
       74   define variable mWaitFramStartProc          as datetime-tz no-undo.
       75   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       76   define button B-WaitFramStop auto-end-key
       77        label "Стоп"
       78        size 10 by 1 tooltip "Остоновить процесс".
       79   define button B-viewProcInfo
       80        label "Информация"
       81        size 15 by 1 tooltip "Информация о процесс".
       82   define frame waitfram
       83     v-waitfram-action01 format "x(72)" no-label skip
       84     v-waitfram-action02 format "x(72)" no-label skip
       85     v-waitfram-action03 format "x(72)" no-label skip
       86     B-viewProcInfo
       87     B-WaitFramStop at row 4 col 30
       88     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       89     .
       90   define new global shared variable mBatchMode as logical no-undo init ?.
       91   define variable mFramBachModHandle as handle no-undo.
       92   mFramBachModHandle = frame waitfram:handle.
       93   define variable mFameOldVis as logical no-undo.
       94   define variable mVisCUrentVin as logical no-undo.
       95   if session:batch-mode
       96   then
       97      mBatchMode = yes.
       98   if mBatchMode = ? then do:
       99     mVisCUrentVin = current-window:visible.
      100     mFameOldVis = mFramBachModHandle:visible.
      101     mFramBachModHandle:visible  = yes.
      102     mBatchMode = mFramBachModHandle:visible ne yes.
      103     mFramBachModHandle:visible = mFameOldVis.
      104     current-window:visible = mVisCUrentVin.
      105   end.
      106    if  log-manager:logfile-name ne ?
      107     then DO:
      108         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      109         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      110         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      111     end.
      112   on choose of B-WaitFramStop in frame waitfram
      113   do:
      114     mWaitFramStop = yes.
      115     mWaitFramStopUser = yes.
      116   end.
      117   function waitfram-check-timeout returns logical():
      118      define variable vtime as int64 no-undo.
      119      if mWaitFramStopTimeOut
      120      then
      121         return yes.
      122      vtime = ( now - mWaitFramStartProc ) / 1000 .
      123      if     mWaitFramTimeOut ne ?
      124         and mWaitFramTimeOut ne 0
      125         and mWaitFramTimeOut lt vtime
      126      then do:
      127         mWaitFramStopTimeOut = yes.
      128      end.
      129      return mWaitFramStopTimeOut.
      130   end.
      131   procedure waitfram-hide :
      132     if not session:batch-mode
      133     then do
      134     on error undo, return error return-value
      135     :
      136       pause 0 before-hide .
      137       if not mBatchMode then
      138         hide frame waitfram .
      139     if     not mWaitFramView
      140        and mWaitProcEvent
      141     then
      142       process events .
      143     end.
      144   end procedure.
      145   procedure waitfram-show :
      146     define input  parameter p-message as character no-undo .
      147     define variable v-left-margin as integer   no-undo .
      148     if not session:batch-mode
      149     then do
      150     on error undo, return error return-value
      151     :
      152       if length(p-message) <= 70 then do:
      153         assign
      154           v-left-margin = integer((70 - length(p-message)) / 2)
      155         .
      156         assign
      157           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      158         .
      159         assign
      160           v-waitfram-action01 = " "
      161           v-waitfram-action02 = " "
      162                                    + fill(" ", v-left-margin)
      163                                    + p-message
      164           v-waitfram-action03 = " "
      165         .
      166       end.
      167       else do:
      168         define variable vRindex1 as integer no-undo.
      169         define variable vRindex2 as integer no-undo.
      170         vRindex1 = r-index(p-message," ",70).
      171         if vRindex1 = 0
      172         then
      173            vRindex1 = 70.
      174         if length(p-message)  <= vRindex1 + 70 then do:
      175           assign
      176             v-waitfram-action01 = " "
      177             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      178             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      179           .
      180         end.
      181         else do:
      182           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      183           if vRindex2 <= vRindex1
      184           then
      185              vRindex2 = vRindex1 + 70.
      186           assign
      187             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      188             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      189             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      190           .
      191         end.
      192       end.
      193       B-viewProcInfo:visible   in frame waitfram = no.
      194       B-viewProcInfo:sensitive in frame waitfram = no.
      195       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      196       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      197       if  (   mWaitFramView
      198          or  mWaitProcEvent)
      199          and not mBatchMode
      200       then
      201          display
      202             v-waitfram-action01 skip
      203             v-waitfram-action02 skip
      204             v-waitfram-action03 skip
      205          with frame waitfram .
      206       if     mWaitFramView
      207          then do:
      208             if     mWaitFramInterval ne ?
      209                and not mBatchMode
      210             then
      211                wait-for go of frame waitfram pause mWaitFramInterval.
      212          end.
      213          else
      214             if     mWaitProcEvent
      215                and not mBatchMode
      216             then
      217                process events .
      218     end.
      219   end procedure.
      220      procedure waitfram-show-this:
      221         define input  parameter iInterval as int64 no-undo.
      222         define variable vtime as int64 no-undo.
      223         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      224         mWaitFramInterval = iInterval.
      225         run waitfram-show (substitute("&1&2 &3&4" ,
      226                                       mWaitFramTextBeg ,
      227                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      228                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      229                                       mWaitFramTextEnd
      230                                      )
      231                           ).
      232      end.
      233      procedure WaitFramRunPause:
      234         define input  parameter iInterval as dec no-undo.
      235         define variable vStart  as datetime-tz no-undo.
      236         define variable vend    as datetime-tz no-undo.
      237         define variable vint as int64 no-undo.
      238         define variable vOk as logical no-undo.
      239         vStart = now.
      240         vend   = vStart.
      241         publish "WaitFramPause" (iInterval,output vOk).
      242         vend   =  now.
      243         vint = vend - vStart.
      244         vint = iInterval - vint / 1000.
      245         if     not mWaitFramStop
      246            and (   vint > 0
      247                 or (    not vOk
      248                     and iInterval eq ?
      249                     )
      250                 )
      251         then
      252            run waitfram-show-this (iInterval).
      253         vend   =  now.
      254         vint = vend - vStart.
      255         vint = iInterval - vint / 1000.
      256         if     not mWaitFramStop
      257            and vint > 0
      258         then do:
      259            run gbl/pause.p (vint * 1000).
      260         end.
      261         if iInterval ne ?
      262         then
      263            publish "WaitFramStop".
      264         waitfram-check-timeout().
      265      end.
      266      procedure WaitFramWaitFor:
      267         define input  parameter iInterval as dec no-undo.
      268         assign
      269            mWaitFramStartProc   = now
      270            mWaitFramStopUser    = no
      271            mWaitFramStopTimeOut = no
      272         .
      273         block-wait:
      274         do while not mWaitFramStop:
      275            run WaitFramRunPause (iInterval).
      276            if  waitfram-check-timeout()
      277            then do:
      278               leave block-wait.
      279            end.
      280         end.
      281         run waitfram-hide.
      282      end.
      283   procedure waitfram-join :
      284     define input  parameter p-line-1  as character no-undo .
      285     define input  parameter p-line-2  as character no-undo .
      286     define input  parameter p-line-3  as character no-undo .
      287     define output parameter p-message as character no-undo .
      288     do
      289     on error undo, return error return-value
      290     :
      291       assign
      292         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      293                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      294                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      295       .
      296     end.
      297   end procedure.
      298   function waitfram-join-function returns character
      299     (input p-line-1 as character
      300     ,input p-line-2 as character
      301     ,input p-line-3 as character
      302     ).
      303     define variable v-message as character no-undo .
      304     run waitfram-join in this-procedure
      305       (input  p-line-1
      306       ,input  p-line-2
      307       ,input  p-line-3
      308       ,output v-message
      309       ) .
      310     return v-message .
      311   end function .
      312   define input parameter x-store-code like  ub.clients.obj-code   no-undo.
      313   define input parameter x-store-type like  ub.clients.obj-type   no-undo.
      314   define input parameter x-base-type  like  ub.currency.curr-abbr no-undo.
      315   define input parameter x-base-code  like  ub.currency.curr-code no-undo.
      316   define input parameter x-cli-art    as character no-undo .
      317   define input parameter x-postname   as character no-undo .
      318   define input parameter x-radpost    as logical no-undo .
      319   define input parameter x-type-itog  as integer no-undo .
      320   define input parameter xclassify    as character no-undo.
      321   define input parameter xsorttype    as character no-undo.
      322   define input parameter xshowzero    as log  no-undo.
      323   define input parameter xtog-obj     as log no-undo.
      324   define input parameter xtype-stor   as integer no-undo.
      325   define input parameter xtog-lavel   as log no-undo.
      326   define input parameter xvar-lavel   as integer no-undo.
      327   define input parameter xtog-lavel-2 as log no-undo.
      328   define input parameter xvar-lavel-2 as integer no-undo.
      329   define input parameter xt-in        as log no-undo.
      330   define input parameter xshowgoods   as log  no-undo.
      331   define new global shared variable g#language as character no-undo .
      332   if g#language <> '' and g#language <> 'rus':U then do:
      333     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      334   end.
      335   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      336   procedure cur-time :
      337      define output parameter p-today as date      no-undo .
      338      define output parameter p-time  as integer   no-undo .
      339     do
      340     on error undo, return error
      341     :
      342       define variable v-date1 as date      no-undo .
      343       define variable v-date2 as date      no-undo .
      344       define variable v-time  as integer   no-undo .
      345       assign
      346         v-date1 = today
      347         v-time  = time
      348         v-date2 = today
      349       .
      350       if v-date1 <> v-date2
      351       then do:
      352         assign
      353           v-date1 = today
      354           v-time  = v-time
      355         .
      356       end.
      357       assign
      358         p-today = v-date1
      359         p-time  = v-time
      360       .
      361     end.
      362   end.
      363   function cur-time-date returns character
      364   :
      365     return string(today, '99/99/9999':U) .
      366   end.
      367   function cur-time-mjd returns decimal
      368   :
      369     define variable v-date as date      no-undo .
      370     define variable v-time as integer   no-undo .
      371     run cur-time in this-procedure
      372       (output v-date
      373       ,output v-time
      374       ) .
      375     return integer(v-date) - 2400002 + (v-time / 86400) .
      376   end.
      377   function cur-time-get-ending-index returns integer
      378   (input p-number as integer
      379   )
      380   :
      381     if p-number < 0
      382     or p-number = ?
      383     then do:
      384       return 1 .
      385     end.
      386     define variable v-rest as integer   no-undo .
      387     assign
      388       p-number = p-number modulo 100
      389     .
      390     if p-number < 20
      391     then do:
      392       assign
      393         v-rest = p-number
      394       .
      395     end.
      396     else do:
      397       assign
      398         v-rest = p-number modulo 10
      399       .
      400     end.
      401     case v-rest :
      402       when 1
      403       then do:
      404         return 2 .
      405       end.
      406       when 2 or
      407       when 3 or
      408       when 4
      409       then do:
      410         return 3 .
      411       end.
      412       otherwise do:
      413         return 1 .
      414       end.
      415     end case .
      416   end.
      417   procedure cur-time-mjd-to-date :
      418      define input  parameter i-mjd-diff as decimal no-undo.
      419      define output parameter o-Date     as date    no-undo.
      420      define output parameter o-Time     as integer no-undo.
      421      define variable v-day-number as integer   no-undo .
      422      if    i-mjd-diff < 0
      423         or i-mjd-diff = ?
      424      then do:
      425         return "?" .
      426      end.
      427      assign
      428         v-day-number = truncate(i-mjd-diff,0).
      429         o-Date = date(v-day-number + 2400002).
      430         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      431     .
      432   end.
      433   function cur-time-mjd-to-string returns character
      434   (input p-mjd-diff as decimal
      435   )
      436   :
      437     define variable v-day-number as integer   no-undo .
      438     define variable v-seconds    as integer   no-undo .
      439     define variable v-hour       as integer   no-undo .
      440     define variable v-min        as integer   no-undo .
      441     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      442     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      443     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      444     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      445     if p-mjd-diff < 0
      446     or p-mjd-diff = ?
      447     then do:
      448       return "?" .
      449     end.
      450     assign
      451       v-day-number = integer(truncate(p-mjd-diff,0))
      452       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      453     .
      454     if v-seconds > 86400
      455     then do:
      456       assign
      457         v-seconds = 86400 - 1
      458       .
      459     end.
      460     if v-seconds < 0
      461     then do:
      462       assign
      463         v-seconds = 0
      464       .
      465     end.
      466     assign
      467       v-hour = truncate(v-seconds / 3600, 0)
      468     .
      469     assign
      470       v-seconds = v-seconds modulo 3600
      471     .
      472     assign
      473       v-min = truncate(v-seconds / 60, 0)
      474     .
      475     assign
      476       v-seconds = v-seconds modulo 60
      477     .
      478     return
      479         (if v-day-number <> 0
      480           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      481           else ""
      482         )
      483       + (if v-day-number <> 0 or v-hour <> 0
      484           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      485           else ""
      486         )
      487       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      488           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      489           else ""
      490         )
      491       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      492       .
      493   end.
      494   function cur-time-string returns character
      495   :
      496     define variable v-date as date      no-undo .
      497     define variable v-time as integer   no-undo .
      498     run cur-time in this-procedure
      499       (output v-date
      500       ,output v-time
      501       ) .
      502     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      503   end.
      504   function cur-time-string-sec returns character
      505   :
      506     define variable v-date as date      no-undo .
      507     define variable v-time as integer   no-undo .
      508     run cur-time in this-procedure
      509       (output v-date
      510       ,output v-time
      511       ) .
      512     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      513   end.
      514   function cur-time-custom  returns character
      515   (input p-prefix as character
      516   ,input p-date-format as character
      517   ,input p-delimiter as character
      518   ,input p-time-format as character
      519   ,input p-suffix as character
      520   )
      521   :
      522     define variable v-date as date      no-undo .
      523     define variable v-time as integer   no-undo .
      524     run cur-time in this-procedure
      525       (output v-date
      526       ,output v-time
      527       ) .
      528     return
      529       p-prefix
      530       + string(v-date, p-date-format)
      531       + p-delimiter
      532       + string(v-time, p-time-format)
      533       + p-suffix
      534       .
      535   end.
      536   function cur-time-print  returns character
      537   :
      538     define variable v-date as date      no-undo .
      539     define variable v-time as integer   no-undo .
      540     run cur-time in this-procedure
      541       (output v-date
      542       ,output v-time
      543       ) .
      544     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      545   end.
      546   function cur-time-datetime returns datetime
      547   :
      548     define variable v-char as character no-undo .
      549     define variable v-datetime as datetime no-undo .
      550     v-char = cur-time-string().
      551     v-datetime = datetime(v-char).
      552     return  v-datetime.
      553   end.
      554   function cur-time-string-msec returns character
      555   :
      556     define variable v-date as datetime  no-undo .
      557     v-date = now.
      558     return string(v-date) .
      559   end.
      560   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      561   define  shared variable gdsgrp_recids      as character no-undo.
      562   define  shared variable fin-schet-recid    as character no-undo.
      563   define  shared variable v-d-report-handle  as handle    no-undo .
      564   define  shared temp-table g#customer no-undo
      565       field obj-type like ub.clients.obj-type
      566       field obj-code like ub.clients.obj-code
