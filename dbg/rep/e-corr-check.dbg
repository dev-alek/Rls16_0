      505   procedure create_obj-list :
      506      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      507      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      508      do
      509      on error undo, return error return-value
      510      :
      511         define buffer cli-obj for ub.clients .
      512         define variable p-var as integer no-undo .
      513         define buffer buf_obj-list for obj-list .
      514         find last buf_obj-list  use-index pi no-error .
      515         if available buf_obj-list
      516         then
      517            p-var = buf_obj-list.obj-id + 1.
      518         else
      519            p-var = 1.
      520         find first cli-obj where
      521                   cli-obj.obj-type = p-obj-type
      522               and cli-obj.obj-code = p-obj-code
      523         no-lock no-error.
      524         if available cli-obj
      525         then do:
      526            create buf_obj-list.
      527            assign
      528               buf_obj-list.obj-id   = p-var
      529               buf_obj-list.obj-code = cli-obj.obj-code
      530               buf_obj-list.obj-type = cli-obj.obj-type
      531               buf_obj-list.obj-name = cli-obj.obj-name
      532               buf_obj-list.db-num   = cli-obj.db-num
      533            .
      534         end.
      535      end.
      536   end.
