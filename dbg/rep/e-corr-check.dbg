     1000   DEFINE VARIABLE cb-check-type AS CHARACTER FORMAT "X(256)":U
     1001        LABEL "Тип чека"
     1002        VIEW-AS COMBO-BOX INNER-LINES 5
     1003        LIST-ITEM-PAIRS "Item 1","1"
     1004        DROP-DOWN-LIST
     1005        SIZE 16 BY 1 NO-UNDO.
     1006   DEFINE VARIABLE f-date-corr AS DATE FORMAT "99/99/9999":U
     1007        LABEL "Дата документа основания"
     1008        VIEW-AS FILL-IN
     1009        SIZE 14 BY 1 NO-UNDO.
     1010   DEFINE VARIABLE f-num-corr AS CHARACTER FORMAT "X(256)":U
     1011        LABEL "Номер документа основания"
     1012        VIEW-AS FILL-IN
     1013        SIZE 14 BY 1 NO-UNDO.
     1014   DEFINE VARIABLE v-doc-osnov AS CHARACTER FORMAT "X(256)":U
     1015        LABEL "Документ основания"
     1016        VIEW-AS FILL-IN
     1017        SIZE 26.25 BY 1 TOOLTIP "Для режима все по фирме - здесь должен быть указан список кодов фирм." NO-UNDO.
     1018   DEFINE VARIABLE r-shift AS INTEGER
     1019        VIEW-AS RADIO-SET VERTICAL
     1020        RADIO-BUTTONS
     1021             "Всем", 0,
     1022   "Закрытым", 1,
     1023   "Открытым", 2
     1024        SIZE 13.5 BY 3 NO-UNDO.
     1025   DEFINE FRAME F-Main
     1026        cb-check-type AT ROW 2.42 COL 30 COLON-ALIGNED WIDGET-ID 40
     1027        v-doc-osnov AT ROW 3.71 COL 30 COLON-ALIGNED WIDGET-ID 56
     1028        BUTTON-1 AT ROW 3.75 COL 59 WIDGET-ID 54
     1029        f-date-corr AT ROW 5 COL 30 COLON-ALIGNED WIDGET-ID 44
     1030        f-num-corr AT ROW 6.25 COL 30 COLON-ALIGNED WIDGET-ID 46
     1031        r-shift AT ROW 8 COL 48 NO-LABEL WIDGET-ID 48
     1032        "Выбор по сформированным чекам по сменам:" VIEW-AS TEXT
     1033             SIZE 41.5 BY .75 AT ROW 8.25 COL 4 WIDGET-ID 52
     1034       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
     1035            SIDE-LABELS NO-UNDERLINE THREE-D
     1036            AT COL 1 ROW 1 SCROLLABLE
     1037            BGCOLOR 8 .
