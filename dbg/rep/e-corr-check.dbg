     1255   PROCEDURE adm-enable-fields :
     1256       RETURN.
     1257   END PROCEDURE.
     1258   PROCEDURE adm-end-update :
     1259     RETURN.
     1260   END PROCEDURE.
     1261   PROCEDURE adm-reset-record :
     1262       RETURN.
     1263   END PROCEDURE.
     1264   PROCEDURE adm-update-record :
     1265       MESSAGE
     1266         "Object ":U THIS-PROCEDURE:FILE-NAME
     1267           "must have at least one Enabled Table to perform Update.":U
     1268             VIEW-AS ALERT-BOX ERROR.
     1269      RETURN.
     1270   END PROCEDURE.
     1271   PROCEDURE check-modified :
     1272   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1273   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1274   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1275   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1276     IF check-state = "check":U THEN
     1277     DO:
     1278       RUN get-link-handle IN adm-broker-hdl
     1279         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1280            OUTPUT group-target-list).
     1281       IF group-target-list NE "":U THEN
     1282       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1283         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1284         RUN check-modified IN curr-widget ('group-check':U).
     1285         IF RETURN-VALUE NE "":U THEN
     1286         DO:
     1287           RUN check-modified-message(RETURN-VALUE).
     1288           RETURN "":U.
     1289         END.
     1290       END.
     1291     END.
     1292     RETURN "":U.
     1293   END PROCEDURE.
     1294   PROCEDURE check-modified-message :
     1295     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1296        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1297           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1298        IF RETURN-VALUE = "YES":U THEN
     1299           RUN notify ('view,CONTAINER-SOURCE':U).
     1300        MESSAGE IF p-changed-table NE ? THEN
     1301           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1302           ELSE "Current values have been changed."
     1303           SKIP "  Do you wish to save those changes?"
     1304           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1305        IF ANS THEN
     1306        DO:
     1307           IF group-assign-target THEN
     1308             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1309           ELSE RUN dispatch('update-record':U).
     1310           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1311           DO:
     1312               MESSAGE "Changes to the previous record were not saved."
     1313                 VIEW-AS ALERT-BOX ERROR.
     1314               IF group-assign-target THEN
     1315                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1316               ELSE RUN dispatch ('cancel-record':U).
     1317           END.
     1318        END.
     1319        ELSE DO:
     1320          IF group-assign-target THEN
     1321             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1322          ELSE RUN dispatch('cancel-record':U).
     1323        END.
     1324        RETURN.
     1325   END PROCEDURE.
     1326   PROCEDURE get-rowid :
     1327       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1328       ASSIGN
     1329       p-table   =   adm-first-table.
     1330       RETURN.
     1331   END PROCEDURE.
     1332   PROCEDURE init-group-assign :
     1333       RUN request-attribute IN adm-broker-hdl
     1334         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1335       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1336         group-assign-target = yes.
     1337       ELSE group-assign-target = no.
     1338       RETURN.
     1339   END PROCEDURE.
     1340   PROCEDURE set-editors :
     1341       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1342       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1343       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1344       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1345       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1346       DO WHILE VALID-HANDLE (curr-widget):
     1347           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1348              curr-widget:HIDDEN = no THEN DO:
     1349             CASE p-field-setting:
     1350               WHEN "INITIALIZE":U THEN
     1351               DO:
     1352                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1353                     read-only-list +
     1354                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1355                        STRING(curr-widget).
     1356               END.
     1357               WHEN "DISABLE":U OR
     1358               WHEN "ENABLE":U THEN
     1359               DO:
     1360                   curr-widget:SENSITIVE = yes.
     1361                   RUN get-attribute ('Read-Only-Editors':U).
     1362                   IF RETURN-VALUE = ? OR
     1363                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1364                       curr-widget:READ-ONLY =
     1365                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1366               END.
     1367               WHEN "CLEAR":U THEN
     1368                   curr-widget:SCREEN-VALUE = "":U.
     1369             END CASE.
     1370           END.
     1371           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1372       END.
     1373       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1374         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1375           + '"':U).
     1376       RETURN.
     1377   END PROCEDURE.
     1378   PROCEDURE use-check-modified-all :
     1379    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1380     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1381     RETURN.
     1382   END PROCEDURE.
     1383   PROCEDURE use-create-on-add :
     1384   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1385      RETURN.
     1386   END PROCEDURE.
     1387   PROCEDURE use-initial-lock :
     1388     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1389     ASSIGN adm-initial-lock = p-attr-value.
     1390     RETURN.
     1391   END PROCEDURE.
     1392     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1393   ASSIGN
     1394          FRAME F-Main:SCROLLABLE       = FALSE
     1395          FRAME F-Main:HIDDEN           = TRUE.
     1396   ON CHOOSE OF BUTTON-1 IN FRAME F-Main
     1397   DO:
     1398     def var p-corr-osnov as character no-undo.
     1399     def var rid# as character no-undo .
     1400       run ref/codelayout.p('ВЫБОР':U,"","OsnovCorr", "Основание коррекции",output table tmprecid).
     1401       for first tmprecid where tmprecid.fTable = "code" no-lock:
     1402         find first ub.Code no-lock where recid (ub.Code) = integer(tmprecid.Frecid) no-error .
     1403         v-doc-osnov = ub.Code.CodeName.
     1404         v-corr-osnov = ub.Code.code .
     1405         display v-doc-osnov with frame F-Main .
     1406         apply "LEAVE":U to v-doc-osnov.
     1407       end.
     1408   END.
     1409   ON VALUE-CHANGED OF cb-check-type IN FRAME F-Main
     1410   DO:
     1411     assign cb-check-type .
     1412   END.
     1413   ON LEAVE OF f-date-corr IN FRAME F-Main
     1414   DO:
     1415     assign f-date-corr .
     1416   END.
     1417   ON LEAVE OF f-num-corr IN FRAME F-Main
     1418   DO:
     1419     assign f-num-corr .
     1420   END.
     1421   ON VALUE-CHANGED OF r-shift IN FRAME F-Main
     1422   DO:
     1423     assign r-shift .
     1424   END.
     1425   ON LEAVE OF v-doc-osnov IN FRAME F-Main
     1426   DO:
     1427   do with frame F-Main:
     1428     ASSIGN
     1429       v-doc-osnov
     1430     .
     1431   end.
     1432   END.
     1433   parparentproc = my-handle.
     1434   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1435     run mainmenu_getcntxt in parparentproc
     1436       (output v-cntxt-db-num
     1437       ,output v-cntxt-userid
     1438       ,output v-cntxt-level
     1439       ,output v-cntxt-host-code-obj
     1440       ,output v-cntxt-obj-type
     1441       ,output v-cntxt-obj-code
     1442       ,output v-cntxt-db-num-obj
     1443       ,output v-cntxt-is-admin
     1444       ) .
     1445   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1446   on ' ' of f-date-corr in frame F-Main
     1447   do:
     1448     if (can-query (self, "sensitive")
     1449        and
     1450        self :sensitive = true
     1451        )
     1452     or (can-query (self, "read-only")
     1453        and
     1454        self :read-only = false
     1455        )
     1456     then do:
     1457       assign
     1458         self :screen-value = ?
     1459       .
     1460     end.
     1461     return no-apply.
     1462   end.
     1463   on delete-character of f-date-corr in frame F-Main
     1464   do:
     1465     if (can-query (self, "sensitive")
     1466        and
     1467        self :sensitive = true
     1468        )
     1469     or (can-query (self, "read-only")
     1470        and
     1471        self :read-only = false
     1472        )
     1473     then do:
     1474       assign
     1475         self :screen-value = ?
     1476       .
     1477     end.
     1478     return no-apply.
     1479   end.
     1480   on ctrl-d of f-date-corr in frame F-Main
     1481   do:
     1482     define variable v-curr-sv-date as date no-undo .
     1483     if (can-query (self, "sensitive")
     1484        and
     1485        self :sensitive = true
     1486        )
     1487     or (can-query (self, "read-only")
     1488        and
     1489        self :read-only = false
     1490        )
     1491     then do:
     1492       if self :handle <> focus :handle
     1493       then do:
     1494         apply "entry":u to self .
     1495       end.
     1496       run gbl/getcurdt.p
     1497         (output v-curr-sv-date
     1498         ) .
     1499       assign
     1500         self :screen-value = string(v-curr-sv-date) .
     1501       .
     1502     end.
     1503     return no-apply.
     1504   end.
     1505   on ctrl-b of f-date-corr in frame F-Main
     1506   do:
     1507     if (can-query (self, "sensitive")
     1508        and
     1509        self :sensitive = true
     1510        )
     1511     or (can-query (self, "read-only")
     1512        and
     1513        self :read-only = false
     1514        )
     1515     then do:
     1516       if self :handle <> focus :handle
     1517       then do:
     1518         apply "entry":u to self .
     1519       end.
     1520       define variable v-curr-sv-date as date no-undo .
     1521       define variable v-new-sv-date  as date no-undo .
     1522       assign
     1523         v-curr-sv-date = date(self :screen-value) no-error
     1524       .
     1525       if v-curr-sv-date = ?
     1526       then do:
     1527         run gbl/getcurdt.p
     1528           (output v-curr-sv-date
     1529           ) .
     1530       end.
     1531       if v-curr-sv-date <> ?
     1532       then do:
     1533         assign
     1534           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     1535         .
     1536         assign
     1537           self :screen-value = string(v-new-sv-date) .
     1538         .
     1539       end.
     1540     end.
     1541     return no-apply .
     1542   end.
     1543   on ctrl-e of f-date-corr in frame F-Main
     1544   do:
     1545     if (can-query (self, "sensitive")
     1546        and
     1547        self :sensitive = true
     1548        )
     1549     or (can-query (self, "read-only")
     1550        and
     1551        self :read-only = false
     1552        )
     1553     then do:
     1554       if self :handle <> focus :handle
     1555       then do:
     1556         apply "entry":u to self .
     1557       end.
     1558       define variable v-curr-sv-date as date no-undo .
     1559       define variable v-new-sv-date  as date no-undo .
     1560       assign
     1561         v-curr-sv-date = date(self :screen-value) no-error
     1562       .
     1563       if v-curr-sv-date = ?
     1564       then do:
     1565         run gbl/getcurdt.p
     1566           (output v-curr-sv-date
     1567           ) .
     1568       end.
     1569       if v-curr-sv-date <> ?
     1570       then do:
     1571         run gbl/lastdate.p
     1572           (input  v-curr-sv-date
     1573           ,output v-new-sv-date
     1574           ).
     1575         assign
     1576           self :screen-value = string(v-new-sv-date) .
     1577         .
     1578       end.
     1579     end.
     1580     return no-apply .
     1581   end.
     1582   on ctrl-f of f-date-corr in frame F-Main
     1583   do:
     1584     if (can-query (self, "sensitive")
     1585        and
     1586        self :sensitive = true
     1587        )
     1588     or (can-query (self, "read-only")
     1589        and
     1590        self :read-only = false
     1591        )
     1592     then do:
     1593       if self :handle <> focus :handle
     1594       then do:
     1595         apply "entry":u to self .
     1596       end.
     1597       define variable v-ok            as logical   no-undo .
     1598       define variable v-curr-sv-date  as date      no-undo .
     1599       define variable v-description   as character no-undo .
     1600       assign
     1601         v-curr-sv-date = date(self :screen-value) no-error
     1602       .
     1603       if v-curr-sv-date = ?
     1604       then do:
     1605         run gbl/getcurdt.p
     1606           (output v-curr-sv-date
     1607           ) .
     1608       end.
     1609       if v-curr-sv-date <> ?
     1610       then do:
     1611         run gbl/d-inpday.w
     1612           (input ?
     1613           ,input "Выбор даты"
     1614           ,input v-description
     1615           ,input ""
     1616           ,input-output v-curr-sv-date
     1617           ,output v-ok
     1618           ).
     1619         if v-ok = true
     1620         then do:
     1621           assign
     1622             self :screen-value = string(v-curr-sv-date) .
     1623           .
     1624         end.
     1625       end.
     1626     end.
     1627     return no-apply .
     1628   end.
     1629     define MENU m-ed-date13
     1630       MENU-ITEM m-ed-date13-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
     1631       MENU-ITEM m-ed-date13-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
     1632       MENU-ITEM m-ed-date13-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
     1633       MENU-ITEM m-ed-date13-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
     1634       .
     1635     if f-date-corr :POPUP-MENU in frame F-Main = ?
     1636     then do:
     1637       ASSIGN
     1638         f-date-corr :POPUP-MENU in frame F-Main = MENU m-ed-date13 :HANDLE
     1639         f-date-corr :MENU-MOUSE in frame F-Main = 3
     1640       .
     1641     end.
     1642     define variable v-label-handle13 as handle no-undo .
     1643     assign
     1644       v-label-handle13 = f-date-corr :side-label-handle in frame F-Main
     1645     .
     1646     if valid-handle (v-label-handle13)
     1647     then do:
     1648       if v-label-handle13 :tooltip = ""
     1649       or v-label-handle13 :tooltip = ?
     1650       then do:
     1651         assign
     1652           v-label-handle13 :tooltip = "Ctrl-D - текущая, Ctrl-B - начало, Ctrl-E - конец, Ctrl-F - календарь, Прав.Клавиша Мыши - Popup Menu"
     1653         .
     1654       end.
     1655     end.
     1656     ON CHOOSE OF MENU-ITEM m-ed-date13-1 in menu m-ed-date13 DO:
     1657       apply "ctrl-b":U to f-date-corr in frame F-Main .
     1658     END.
     1659     ON CHOOSE OF MENU-ITEM m-ed-date13-2 in menu m-ed-date13 DO:
     1660       apply "ctrl-d":U to f-date-corr in frame F-Main .
     1661     END.
     1662     ON CHOOSE OF MENU-ITEM m-ed-date13-3 in menu m-ed-date13 DO:
     1663       apply "ctrl-e":U to f-date-corr in frame F-Main .
     1664     END.
     1665     ON CHOOSE OF MENU-ITEM m-ed-date13-4 in menu m-ed-date13 DO:
     1666       apply "ctrl-f":U to f-date-corr in frame F-Main .
     1667     END.
     1668   assign
     1669   cb-check-type:LIST-ITEM-PAIRS  in frame F-Main =  'Продажа,1,Возврат,6,ВзврСпис,96,СбросТрнзкц,14,Перелив,15,ПеревТрнзкц,16,РазблТрнзкц,36,ТехПролив,17,Списание,69,Аннуляция,8,Инвентаризация,11,Закрытие_смены,13,Открытие_смены,40,Z-отчет,12,_Продажа,101,_Возврат,106,_ВзврСпис,196,_СбросТрнзкц,114,_Перелив,115,_ПеревТрнзкц,116,_ТехПролив,117,_Списание,169,_Аннуляция,108,_Инвентаризация,111,_Z-отчет,112,_СбросТрнзкц,114,_РазблТрнзкц,136,_Закрытие_смены,113,>Продажа,201,>Возврат,206,>Аннуляция,208,>>Продажа,301,>>Возврат,306,Инкассация,2,Касс_фонд,3,Перевод_опл,4,Расход_кассы,5,Декл_ден_ящ,7,Приход_Корр,43,Расход_Корр,44':U
     1670   .
     1671   PROCEDURE disable_UI :
     1672     HIDE FRAME F-Main.
     1673     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1674   END PROCEDURE.
     1675   PROCEDURE enable_UI :
     1676     DISPLAY cb-check-type v-doc-osnov f-date-corr f-num-corr r-shift
     1677         WITH FRAME F-Main.
     1678     ENABLE cb-check-type v-doc-osnov BUTTON-1 f-date-corr f-num-corr r-shift
     1679         WITH FRAME F-Main.
     1680   END PROCEDURE.
     1681   PROCEDURE my-report :
     1682     do
     1683       on error undo, return error return-value
     1684       :
     1685       run rep/r-corr-check.p
     1686         (input my-handle
     1687         ,input cb-check-type
     1688         ,input v-corr-osnov
     1689         ,input f-date-corr
     1690         ,input f-num-corr
     1691         ,input r-shift
     1692         ) .
     1693     end.
     1694   END PROCEDURE.
     1695   PROCEDURE my-var :
     1696     assign frame F-Main v-doc-osnov .
     1697   END PROCEDURE.
