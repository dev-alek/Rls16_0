      943    define  temp-table tmprecid
      944       field Frecid as recid init ?
      945       field fnum as character
      946       field fTable as character
      947    index num  fnum Frecid
      948    index itable is primary unique fTable Frecid
      949    .
      950   define variable fSelect as logical no-undo format "*/" column-label "".
      951   function isSelect return logical
      952       (iBuffer as handle  ):
      953       define buffer tmprecid for tmprecid.
      954       if iBuffer:available
      955       then
      956          find first tmprecid where tmprecid.fTable = iBuffer:TABLE
      957                                and tmprecid.Frecid = iBuffer:recid
      958          no-lock no-error.
      959       return available tmprecid.
      960    end.
      961   function setSelect return logical
      962       (iBuffer as handle  ):
      963       define buffer tmprecid for tmprecid.
      964       if iBuffer:available
      965       then do:
      966          find first tmprecid where tmprecid.fTable = iBuffer:TABLE
      967                                and tmprecid.Frecid = iBuffer:recid
      968          no-lock no-error.
      969          if available tmprecid
      970          then
      971             delete tmprecid.
      972          else do:
      973             create tmprecid.
      974             assign
      975                tmprecid.fTable = iBuffer:TABLE
      976                tmprecid.Frecid = iBuffer:recid
      977             .
      978          end.
      979       end.
      980       return available tmprecid.
      981    end.
      982    procedure rid-keep :
      983        run gbl/rid-keep.p (input table tmprecid) no-error.
      984    end.
      985    procedure rid-rest :
      986         run gbl/rid-rest.p (output table tmprecid) no-error.
      987    end.
