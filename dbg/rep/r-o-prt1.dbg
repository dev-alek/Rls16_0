     7472   if Make-Excel then  put   stream ForExcel unformatted  obj-list.obj-name chr(10).
     7473     n-nn = 0.
     7474     n-no = n-no + 1 .
     7475    For Each gds-obj where
     7476             gds-obj.obj-code    = obj-list.obj-code and
     7477             gds-obj.obj-type    = obj-list.obj-type
     7478             and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     7479             no-lock,
     7480             first goods where   goods.gds-code    = gds-obj.gds-code  and
     7481                                 goods.gds-type    = 'т':U
     7482                                 no-lock
     7483             , First gds-list where   gds-list.prod-type = gds-obj.prod-type and
     7484                                      gds-list.prod-code = gds-obj.prod-code and
     7485                                      gds-list.artic     = gds-obj.artic
     7486               break
     7487                   by gds-obj.prod-type By gds-obj.prod-code by gds-obj.artic
     7488                   with FRAME Zapas :
     7489                IF first-of(gds-obj.artic) then DO:
     7490                   assign
     7491                     f-qnty         = 0
     7492                     f-cost-sum     = 0
     7493                     f-sale-sum     = 0
     7494                     f-sale-other   = 0
     7495                     f-crsa-sum     = 0
     7496                     f-qnty-all     = 0
     7497                     f-cost-sum-all = 0
     7498                     f-crsa-sum-all = 0
     7499                     f-qnty-o       = 0
     7500                     f-cost-sum-o   = 0
     7501                     f-crsa-sum-o   = 0.
     7502                 For Each temp-doc-code  : delete temp-doc-code . end.
     7503                 For Each ub.ot-line where
     7504                           ub.ot-line.fact-order <= fact-order-2 and
     7505                           ub.ot-line.fact-order >= fact-order-1 and
     7506                           ub.ot-line.obj-code    = obj-list.obj-code and
     7507                           ub.ot-line.obj-type    = obj-list.obj-type  and
     7508                           ub.ot-line.artic     = gds-obj.artic  and
     7509                           ub.ot-line.prod-type = gds-obj.prod-type and
     7510                           ub.ot-line.prod-code = gds-obj.prod-code and
     7511                           (ub.ot-line.sum-type = 'sale':U OR
     7512                             ub.ot-line.sum-type = 'crsa':U OR
     7513                             ub.ot-line.sum-type = 'cost':U ) no-lock :
     7514                       run in-proc.
     7515                 End.
     7516               End.
     7517             if first-of(gds-obj.prod-code) then DO:
     7518                 FIND FIRST clients-p where  gds-obj.prod-type = clients-p.obj-type AND
     7519                                             gds-obj.prod-code = clients-p.obj-code no-lock no-error.
     7520                  if avail clients-p then var-client = Clients-p.obj-name.
     7521                     if  Itog = false Then do:
     7522     if c-f-gds-name <>  ?  then do :
     7523       c-f-gds-name:screen-value = string(var-client) .
     7524       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7525           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7526           display STREAM OutStream    with frame top-frame .
     7527       End.
     7528     End.
     7529                       Display stream OutStream .
     7530                       DOWN stream OutStream .
     7531                       if Make-Excel then  put   stream ForExcel unformatted var-client chr(10) .
     7532                     End.
     7533             End.
     7534             if last-of(gds-obj.artic) then DO:
     7535             run last-of-artic.
     7536                 accumulate f-qnty           (TOTAL  by gds-obj.prod-code ) .
     7537                 accumulate f-cost-sum       (TOTAL  by gds-obj.prod-code ) .
     7538                 accumulate f-sale-sum       (TOTAL  by gds-obj.prod-code ) .
     7539                 accumulate f-sale-other     (TOTAL  by gds-obj.prod-code ) .
     7540                 accumulate f-crsa-sum       (TOTAL  by gds-obj.prod-code ) .
     7541                 accumulate f-qnty-all       (TOTAL  by gds-obj.prod-code ) .
     7542                 accumulate f-cost-sum-all   (TOTAL  by gds-obj.prod-code ) .
     7543                 accumulate f-crsa-sum-all   (TOTAL  by gds-obj.prod-code ) .
     7544                 accumulate f-qnty-o         (TOTAL  by gds-obj.prod-code ) .
     7545                 accumulate f-cost-sum-o     (TOTAL  by gds-obj.prod-code ) .
     7546                 accumulate f-crsa-sum-o     (TOTAL  by gds-obj.prod-code ) .
     7547                   Assign
     7548                     f-qnty          = 0
     7549                     f-crsa-sum      = 0
     7550                     f-qnty          = 0
     7551                     f-cost-sum      = 0
     7552                     f-sale-sum      = 0
     7553                     f-sale-other    = 0
     7554                     f-crsa-sum      = 0
     7555                     f-qnty-all      = 0
     7556                     f-cost-sum-all  = 0
     7557                     f-crsa-sum-all  = 0
     7558                     f-qnty-o        = 0
     7559                     f-cost-sum-o    = 0
     7560                     f-crsa-sum-o    = 0
     7561                    .
     7562             End.
     7563             if last-of(gds-obj.prod-code)  then do :
     7564               f-artic = 'по произв.' .
     7565     if c-nn <>  ?  then do :
     7566       c-nn:screen-value = string('Итого') .
     7567       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
