     4379                     f-qnty-all     = f-qnty-all     + ub.ot-line.fact-qnty .
     4380                   end.
     4381               end case.
     4382               create temp-doc-code-all .
     4383               assign
     4384                   temp-doc-code-all.doc-code = ub.ot-line.doc-code
     4385                   temp-doc-code-all.ext-doc-type = ub.ot-line.ext-doc-type
