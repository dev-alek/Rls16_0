     7013   if Make-Excel then  put   stream ForExcel unformatted  obj-list.obj-name chr(10).
     7014     n-nn = 0.
     7015     n-no = n-no + 1 .
     7016    For Each gds-obj where
     7017             gds-obj.obj-code    = obj-list.obj-code and
     7018             gds-obj.obj-type    = obj-list.obj-type
     7019             and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     7020             no-lock,
     7021             first goods where   goods.gds-code    = gds-obj.gds-code  and
     7022                                 goods.gds-type    = 'т':U
     7023                                 no-lock
     7024             , First gds-list where   gds-list.prod-type = gds-obj.prod-type and
     7025                                      gds-list.prod-code = gds-obj.prod-code and
     7026                                      gds-list.artic     = gds-obj.artic
     7027               break
     7028                   by ( gds-obj.artic + gds-obj.prod-type + string ( gds-obj.prod-code ))
     7029                   by gds-obj.prod-type By gds-obj.prod-code by gds-obj.artic
     7030                   with FRAME Zapas :
     7031                IF first-of(gds-obj.artic) then DO:
     7032                   assign
     7033                     f-qnty         = 0
     7034                     f-cost-sum     = 0
     7035                     f-sale-sum     = 0
     7036                     f-sale-other   = 0
     7037                     f-crsa-sum     = 0
     7038                     f-qnty-all     = 0
     7039                     f-cost-sum-all = 0
     7040                     f-crsa-sum-all = 0
     7041                     f-qnty-o       = 0
     7042                     f-cost-sum-o   = 0
     7043                     f-crsa-sum-o   = 0.
     7044                 For Each temp-doc-code  : delete temp-doc-code . end.
     7045                 For Each ub.ot-line where
     7046                           ub.ot-line.fact-order <= fact-order-2 and
     7047                           ub.ot-line.fact-order >= fact-order-1 and
     7048                           ub.ot-line.obj-code    = obj-list.obj-code and
     7049                           ub.ot-line.obj-type    = obj-list.obj-type  and
     7050                           ub.ot-line.artic     = gds-obj.artic  and
     7051                           ub.ot-line.prod-type = gds-obj.prod-type and
     7052                           ub.ot-line.prod-code = gds-obj.prod-code and
     7053                           (ub.ot-line.sum-type = 'sale':U OR
     7054                             ub.ot-line.sum-type = 'crsa':U OR
     7055                             ub.ot-line.sum-type = 'cost':U ) no-lock :
     7056                       run in-proc.
     7057                 End.
     7058               End.
     7059             if last-of(gds-obj.artic) then DO:
     7060             run last-of-artic.
     7061                 accumulate f-qnty           (TOTAL ) .
     7062                 accumulate f-cost-sum       (TOTAL ) .
     7063                 accumulate f-sale-sum       (TOTAL ) .
     7064                 accumulate f-sale-other     (TOTAL ) .
     7065                 accumulate f-crsa-sum       (TOTAL ) .
     7066                 accumulate f-qnty-all       (TOTAL ) .
     7067                 accumulate f-cost-sum-all   (TOTAL ) .
     7068                 accumulate f-crsa-sum-all   (TOTAL ) .
     7069                 accumulate f-qnty-o         (TOTAL ) .
     7070                 accumulate f-cost-sum-o     (TOTAL ) .
     7071                 accumulate f-crsa-sum-o     (TOTAL ) .
     7072                   Assign
     7073                     f-qnty          = 0
     7074                     f-crsa-sum      = 0
     7075                     f-qnty          = 0
     7076                     f-cost-sum      = 0
     7077                     f-sale-sum      = 0
     7078                     f-sale-other    = 0
     7079                     f-crsa-sum      = 0
     7080                     f-qnty-all      = 0
     7081                     f-cost-sum-all  = 0
     7082                     f-crsa-sum-all  = 0
     7083                     f-qnty-o        = 0
     7084                     f-cost-sum-o    = 0
     7085                     f-crsa-sum-o    = 0
     7086                    .
     7087             End.
     7088   End.
     7089    run u-line.
     7090     if c-nn <>  ?  then do :
     7091       c-nn:screen-value = string('ИТОГО') .
     7092       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7093           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
