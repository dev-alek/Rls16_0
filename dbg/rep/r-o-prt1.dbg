      885   .
      886   procedure get-font-ini :
      887     do
      888     on error undo, return error return-value
      889     :
      890   define variable ii as integer   no-undo .
      891   define variable v-font7 as character no-undo .
      892   define variable v-font as character no-undo .
      893   define variable loc-name as character no-undo .
      894   define variable loc-size as character no-undo .
      895   define variable loc-type as character no-undo .
      896   define variable old_H as integer   no-undo .
      897   define variable old_w as integer   no-undo .
      898   define variable old-row  as integer   no-undo .
      899   define variable old-col  as integer   no-undo .
      900   define variable old-row-lans  as integer   no-undo .
      901   define variable old-col-lans  as integer   no-undo .
      902   define variable vv as integer   no-undo .
      903   empty temp-table temp-font.
      904     GET-KEY-VALUE SECTION "fonts" KEY "font7" VALUE v-font7 .
      905       case num-entries (v-font7) :
      906         when 4 then do:
      907             assign
      908               loc-name = entry ( 1 , v-font7 )
      909               loc-size = entry ( 2 , v-font7 )
      910               loc-type = entry ( 3 , v-font7 ) + "," +  entry ( 4 , v-font7 )
      911             .
      912         end.
      913         when 3 then do:
      914             assign
      915               loc-name = entry ( 1 , v-font7 )
      916               loc-size = entry ( 2 , v-font7 )
      917               loc-type = entry ( 3 , v-font7 )
      918             .
      919         end.
      920         when 2 then  do:
      921             assign
      922               loc-name = entry ( 1 , v-font7 )
      923               loc-size = entry ( 2 , v-font7 )
      924               loc-type = ""
      925             .
      926         end.
      927         when 1 then do:
      928             assign
      929               loc-name = trim(entry ( 1 , v-font7 ))
      930               loc-size = ""
      931               loc-type = ""
      932             .
      933         end.
      934       end case.
      935     create temp-font.
      936     assign
      937       temp-font.fontnum  = 7
      938       temp-font.fontname = trim(loc-name)
      939       temp-font.fontsize = trim(loc-size)
      940       temp-font.fonttype = trim(loc-type)
      941       temp-font.v-row    = 62
      942       temp-font.v-col    = 136
      943       temp-font.v-row-lans = 43
      944       temp-font.v-col-lans = 198
      945     .
      946     repeat ii = 16 to 100 :
      947       get-key-value section 'fonts' key 'font' + string(ii)   value v-font  .
      948       if v-font = "" or v-font = ? then leave.
      949       case num-entries (v-font) :
      950         when 4 then do:
      951             assign
      952               loc-name = entry ( 1 , v-font )
      953               loc-size = entry ( 2 , v-font )
      954               loc-type = entry ( 3 , v-font ) + "," +  entry ( 4 , v-font )
      955             .
      956         end.
      957         when 3 then do:
      958             assign
      959               loc-name = entry ( 1 , v-font )
      960               loc-size = entry ( 2 , v-font )
      961               loc-type = entry ( 3 , v-font )
      962             .
      963         end.
      964         when 2 then do:
      965             assign
      966               loc-name = entry ( 1 , v-font )
      967               loc-size = entry ( 2 , v-font )
      968               loc-type = ""
      969             .
      970         end.
      971         when 1 then do:
      972             assign
      973               loc-name = trim(entry ( 1 , v-font ))
      974               loc-size = ""
      975               loc-type = ""
      976             .
      977         end.
      978       end case.
      979     create temp-font.
      980     assign
      981       temp-font.fontnum  = ii
      982       temp-font.fontname = trim(loc-name)
      983       temp-font.fontsize = trim(loc-size)
      984       temp-font.fonttype = trim(loc-type)
      985     .
      986     end.
      987       for each temp-font :
      988          vv = integer(entry(2,temp-font.fontsize, "=" )) no-error .
      989          if  vv = ? then vv =  0 .
      990           run rep/exfont.p (
      991             input   temp-font.fontname ,
      992             input   vv ,
      993             input   temp-font.fonttype ,
      994             output  temp-font.font-h   ,
      995             output  temp-font.font-w   )
      996           .
      997       end.
      998   find first temp-font where  temp-font.fontnum  = 7  .
      999   old_H = temp-font.font-H .
     1000   old_w = temp-font.font-W .
     1001   old-row = temp-font.v-row .
     1002   old-col = temp-font.v-col .
     1003   old-row-lans = temp-font.v-row-lans .
     1004   old-col-lans = temp-font.v-col-lans .
     1005       for each temp-font where
     1006                temp-font.fontnum  <> 7 :
     1007           assign
     1008               temp-font.v-row    = old_H * old-row / temp-font.font-h
     1009               temp-font.v-col    = old_W * old-col / temp-font.font-W
     1010               temp-font.v-row-lans    = old_H * old-row-lans / temp-font.font-h
     1011               temp-font.v-col-lans    = old_W * old-col-lans / temp-font.font-W
     1012           .
     1013       end.
     1014     end.
     1015   end procedure.
     1016   PROCEDURE How-name :
     1017   define input  parameter h as integer no-undo .
     1018   define input  parameter w as integer no-undo .
     1019   define output parameter n as character  no-undo .
     1020   define variable A4port-H as integer   no-undo init 63.
     1021   define variable A4port-W as integer   no-undo init 136.
     1022   define variable A4lans-H as integer   no-undo init 43.
     1023   define variable A4lans-W as integer   no-undo init 198.
     1024   define variable Strim-W  as integer   no-undo init 278.
     1025   run define-a4-size (
     1026        input ReportFontNum
     1027       ,output A4port-H
     1028       ,output A4port-W
     1029       ,output A4lans-H
     1030       ,output A4lans-W ).
     1031   If w >= 1 and w <= A4port-W Then DO:
     1032     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     1033     If h > A4lans-H  and h <= A4port-H Then n = "A4-port":U.
     1034     If h > A4port-H              Then n = "to-file":U.
     1035   End.
     1036   If w > A4port-W and w <= A4lans-W Then DO:
     1037     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     1038     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     1039     If h > A4port-H              Then n = "to-file":U.
     1040   End.
     1041   If w > A4lans-W and w <= Strim-W Then DO:
     1042     If h >= 1  and h <= A4lans-H Then n = "to-file":U.
     1043     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     1044     If h > A4port-H              Then n = "to-file":U.
     1045   End.
     1046   If w > Strim-W Then DO:
     1047      n = "to-file":U.
     1048   End.
     1049   END PROCEDURE.
     1050   PROCEDURE define-a4-size :
     1051   define input  parameter p-ReportFontNum as integer   no-undo .
     1052   define output parameter A4port-H as integer   no-undo .
     1053   define output parameter A4port-W as integer   no-undo .
     1054   define output parameter A4lans-H as integer   no-undo .
     1055   define output parameter A4lans-W as integer   no-undo .
     1056   if not can-find (first temp-font ) then do:
     1057      run get-font-ini .
     1058   end.
     1059   find first temp-font where temp-font.fontnum = p-ReportFontNum no-error .
     1060   if available temp-font then do:
     1061   assign
     1062     A4port-H = temp-font.v-row
     1063     A4port-W = temp-font.v-col
     1064     A4lans-H = temp-font.v-row-lans
     1065     A4lans-W = temp-font.v-col-lans
     1066   .
     1067   end.
     1068   else do:
     1069   assign
     1070     A4port-H = 63
     1071     A4port-W = 136
     1072     A4lans-H = 43
     1073     A4lans-W = 198
     1074   .
     1075   end.
     1076   END PROCEDURE.
