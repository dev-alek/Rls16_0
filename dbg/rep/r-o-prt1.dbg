     6105       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     6106           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     6107           display STREAM OutStream    with frame top-frame .
     6108       End.
     6109     End.
     6110     if c-f-crsa-sum-o <>  ?  then do :
