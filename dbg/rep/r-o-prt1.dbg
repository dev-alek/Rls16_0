     2400   procedure prdoclib-calc-prc :
     2401     define input  parameter p-price-doc-recid as   recid                  no-undo.
     2402     define input  parameter p-cons-pay        as   integer                no-undo.
     2403     define output parameter p-ov-cons         like ub.doc-line.price-base no-undo.
     2404     define output parameter p-ov-VAT-cons     like ub.doc-line.price-base no-undo.
     2405     define output parameter p-ov-SLT-cons     like ub.doc-line.price-base no-undo.
     2406     define output parameter p-ov-prch         like ub.doc-line.price-base no-undo.
     2407     define output parameter p-ov-VAT-prch     like ub.doc-line.price-base no-undo.
     2408     define output parameter p-ov-SLT-prch     like ub.doc-line.price-base no-undo.
     2409     do
     2410     on error undo, return error return-value
     2411     :
     2412       define buffer buf_price-doc       for ub.price-doc .
     2413       define buffer buf_price-list      for ub.price-list .
     2414       define buffer buf_parts           for ub.parts .
     2415       define variable v-ov-qnty     as decimal   no-undo .
     2416       define variable v-ov-base     as decimal   no-undo .
     2417       define variable v-ov-VAT-base as decimal   no-undo .
     2418       define variable v-ov-SLT-base as decimal   no-undo .
     2419       define variable v-cons-qnty   as decimal   no-undo .
     2420       define variable v-prch-qnty   as decimal   no-undo .
     2421       define variable v-cons-mult   as decimal   no-undo .
     2422       define variable v-prch-mult   as decimal   no-undo .
     2423       find first buf_price-doc no-lock
     2424         where recid(buf_price-doc) = p-price-doc-recid
     2425         no-error .
     2426       if not available buf_price-doc
     2427       then do:
     2428         message
     2429           vss-workfile vss-revision vss-description skip
     2430           vss-include-info16 skip
     2431           "Ошибка задания входных параметров" skip
     2432           "Не найден документ переоценки" skip
     2433           "Код записи (recid)" p-price-doc-recid skip
     2434           view-as alert-box error .
     2435         undo, return error .
     2436       end.
     2437       for each buf_price-list no-lock
     2438         where buf_price-list.doc-num    = buf_price-doc.doc-num
     2439           and buf_price-list.main-price = true
     2440       on error undo, return error return-value
     2441       :
     2442         run prdoclib-calc-ov
     2443           (input recid(buf_price-list)
     2444           ,output v-ov-qnty
     2445           ,output v-ov-base
     2446           ,output v-ov-VAT-base
     2447           ,output v-ov-SLT-base
     2448           ) no-error .
     2449         if error-status :error
     2450         then do:
     2451           if error-status :get-message(1) <> ""
     2452           then do:
     2453             message
     2454               vss-workfile vss-revision vss-description skip
     2455               vss-include-info16 skip
     2456               "Ошибка при вызове процедуры prdoclib-calc-ov" skip
     2457               error-status :get-message(1) skip
     2458               return-value skip
     2459               view-as alert-box error .
     2460           end.
     2461           undo, return error return-value .
     2462         end.
     2463         assign
     2464           v-cons-qnty = 0
     2465           v-prch-qnty = 0
     2466         .
     2467         for each buf_parts no-lock
     2468           where buf_parts.out-code  = buf_price-list.doc-num
     2469             and buf_parts.obj-type  = buf_price-list.obj-type
     2470             and buf_parts.obj-code  = buf_price-list.obj-code
     2471             and buf_parts.artic     = buf_price-list.artic
     2472             and buf_parts.prod-type = buf_price-list.prod-type
     2473             and buf_parts.prod-code = buf_price-list.prod-code
     2474         on error undo, return error return-value
     2475         :
     2476           if buf_parts.pay-code = p-cons-pay
     2477           then do:
     2478             assign
     2479               v-cons-qnty = v-cons-qnty + buf_parts.fact-qnty
     2480             .
     2481           end.
     2482           else do:
     2483             assign
     2484               v-prch-qnty = v-prch-qnty + buf_parts.fact-qnty
     2485             .
     2486           end.
     2487         end.
     2488         if (v-cons-qnty + v-prch-qnty) = 0
     2489         then do:
     2490           assign
     2491             v-cons-mult = 0
     2492             v-prch-mult = 1
     2493           .
     2494         end.
     2495         else do:
     2496           assign
     2497             v-cons-mult = v-cons-qnty / (v-cons-qnty + v-prch-qnty)
     2498             v-prch-mult = v-prch-qnty / (v-cons-qnty + v-prch-qnty)
     2499           .
     2500         end.
     2501         assign
     2502           p-ov-cons     = p-ov-cons     + v-ov-base     * v-cons-mult
     2503           p-ov-VAT-cons = p-ov-VAT-cons + v-ov-VAT-base * v-cons-mult
     2504           p-ov-SLT-cons = p-ov-SLT-cons + v-ov-SLT-base * v-cons-mult
     2505           p-ov-prch     = p-ov-prch     + v-ov-base     * v-prch-mult
     2506           p-ov-VAT-prch = p-ov-VAT-prch + v-ov-VAT-base * v-prch-mult
     2507           p-ov-SLT-prch = p-ov-SLT-prch + v-ov-SLT-base * v-prch-mult
     2508         .
     2509       end.
     2510     end.
     2511   end procedure.
     2512   procedure prdoclib-calc-ov :
     2513     define input  parameter p-price-list-recid as recid     no-undo .
     2514     define output parameter p-fact-qnty        as decimal   no-undo .
     2515     define output parameter p-ov-base          as decimal   no-undo .
     2516     define output parameter p-ov-VAT-base      as decimal   no-undo .
     2517     define output parameter p-ov-SLT-base      as decimal   no-undo .
     2518     do
     2519     on error undo, return error return-value
     2520     :
     2521       define buffer buf_main_price-list    for ub.price-list .
     2522       define buffer buf_prev_price-list    for ub.price-list .
     2523       define buffer buf_special_price-list for ub.price-list .
     2524       define buffer buf_goods              for ub.goods .
     2525       define variable v-fact-qnty             like ub.doc-line.price-base no-undo.
     2526       define variable v-cur-base              like ub.doc-line.price-base no-undo.
     2527       define variable v-cur-VAT-base          like ub.doc-line.price-base no-undo.
     2528       define variable v-cur-SLT-base          like ub.doc-line.price-base no-undo.
     2529       define variable v-cur-road-tax-base     like ub.doc-line.price-base no-undo.
     2530       define variable v-cur-excise-base       like ub.doc-line.price-base no-undo.
     2531       define variable v-prev-price-list-recid as   recid                  no-undo.
     2532       define variable v-prev-cli-base-rate    like ub.goods.cli-base-rate no-undo.
     2533       define variable v-prev-fact-qnty        like ub.doc-line.price-base no-undo.
     2534       define variable v-prev-cur-base         like ub.doc-line.price-base no-undo.
     2535       define variable v-prev-cur-VAT-base     like ub.doc-line.price-base no-undo.
     2536       define variable v-prev-cur-SLT-base     like ub.doc-line.price-base no-undo.
     2537       find first buf_main_price-list no-lock
     2538         where recid(buf_main_price-list) = p-price-list-recid
     2539         no-error .
     2540       if not available buf_main_price-list
     2541       then do:
     2542         message
     2543           vss-workfile vss-revision vss-description skip
     2544           vss-include-info16 skip
     2545           "Ошибка задания входных параметров" skip
     2546           "Не найдена строка переоценки" skip
     2547           "Код записи (recid)" p-price-list-recid skip
     2548           view-as alert-box error .
     2549         undo, return error .
     2550       end.
     2551       if buf_main_price-list.main-price <> true
     2552       then do:
     2553         message
     2554           vss-workfile vss-revision vss-description skip
     2555           vss-include-info16 skip
     2556           "Ошибка задания входных параметров" skip
     2557           "Строка переоценки не является основной" skip
     2558           "Код записи (recid)" p-price-list-recid skip
     2559           "Переоценка" buf_main_price-list.doc-num skip
     2560           "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     2561           "Бар-код" buf_main_price-list.b-code skip
     2562           view-as alert-box error .
     2563         undo, return error .
     2564       end.
     2565       run prdoclib-calc-fact-sale in this-procedure
     2566         (input  recid(buf_main_price-list)
     2567         ,output v-fact-qnty
     2568         ,output v-cur-base
     2569         ,output v-cur-VAT-base
     2570         ,output v-cur-SLT-base
     2571         ,output v-cur-road-tax-base
     2572         ,output v-cur-excise-base
     2573         ) no-error.
     2574       if error-status :error
     2575       then do:
     2576         message
     2577           vss-workfile vss-revision vss-description skip
     2578           vss-include-info16 skip
     2579           "Ошибка при расчете сумм переоценки." skip
     2580           "Документ переоценки" buf_main_price-list.doc-num skip
     2581           "Товар" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     2582           error-status :get-message(1) skip
     2583           return-value skip
     2584           view-as alert-box error .
     2585         undo, return error .
     2586       end.
     2587   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2588   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodepls in g#library
     2589     (input  buf_main_price-list.obj-type
     2590     ,input  buf_main_price-list.obj-code
     2591     ,input  buf_main_price-list.b-code
     2592     ,input  buf_main_price-list.b-code
     2593     ,input  buf_main_price-list.fact-order
     2594     ,output v-prev-price-list-recid
     2595     ,output v-prev-cli-base-rate
     2596     ) no-error .
     2597       if error-status :error
     2598       then do:
     2599         message
     2600           vss-workfile vss-revision vss-description skip
     2601           vss-include-info16 skip
     2602           "Ошибка при поиске предыдущей переоценки." skip
     2603           "Документ переоценки " buf_main_price-list.doc-num skip
     2604           "Товар " buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     2605           error-status :get-message(1) skip
     2606           return-value skip
     2607           view-as alert-box error .
     2608         undo, return error .
     2609       end.
     2610       if v-prev-price-list-recid <> ?
     2611       then do:
     2612         find first buf_prev_price-list no-lock
     2613           where recid(buf_prev_price-list) = v-prev-price-list-recid
     2614           .
     2615         find first buf_special_price-list no-lock
     2616           where buf_special_price-list.doc-num    = buf_prev_price-list.doc-num
     2617             and buf_special_price-list.main-price = false
     2618             and buf_special_price-list.artic      = buf_prev_price-list.artic
     2619             and buf_special_price-list.prod-type  = buf_prev_price-list.prod-type
     2620             and buf_special_price-list.prod-code  = buf_prev_price-list.prod-code
     2621             and buf_special_price-list.doc-qnty   <> ?
     2622           no-error .
     2623         if available buf_special_price-list
     2624         then do:
     2625           message
     2626             "Товар имеет специальные цены на признаки" skip
     2627             "Разбиение суммы переоценки по консигнации, выкупу невозможно" skip
     2628             "Переоценка" buf_prev_price-list.doc-num skip
     2629             "Товар" buf_prev_price-list.artic buf_prev_price-list.prod-type buf_prev_price-list.prod-code skip
     2630             view-as alert-box error .
     2631           undo, return error .
     2632         end.
     2633         find first buf_goods no-lock
     2634           where buf_goods.artic     = buf_main_price-list.artic
     2635             and buf_goods.prod-type = buf_main_price-list.prod-type
     2636             and buf_goods.prod-code = buf_main_price-list.prod-code
     2637           no-error .
     2638         if not available buf_goods
     2639         then do:
     2640           message
     2641             vss-workfile vss-revision vss-description skip
     2642             vss-include-info16 skip
     2643             "Не найден товар" skip
     2644             "Переоценка" buf_main_price-list.doc-num skip
     2645             "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     2646             view-as alert-box error .
     2647           undo, return error .
     2648         end.
     2649         if buf_prev_price-list.vat-pc = ?
     2650         or buf_prev_price-list.slt-pc = ?
     2651         then do:
     2652           message
     2653             "В переоценке не заданы налоги товара" skip
     2654             "Разбиение суммы переоценки по консигнации, выкупу невозможно" skip
     2655             "Переоценка" buf_prev_price-list.doc-num skip
     2656             "Товар" buf_prev_price-list.artic buf_prev_price-list.prod-type buf_prev_price-list.prod-code skip
     2657             "НДС" buf_prev_price-list.vat-pc skip
     2658             "НП" buf_prev_price-list.slt-pc skip
     2659             view-as alert-box error .
     2660           undo, return error return-value .
     2661         end.
     2662         define variable v-prev-cur-SLT-pc as decimal no-undo .
     2663         assign
     2664           v-prev-cur-SLT-pc   = buf_prev_price-list.price-sale * buf_prev_price-list.slt-pc / (100 + buf_prev_price-list.slt-pc)
     2665         .
     2666         assign
     2667           v-prev-cur-base     = v-fact-qnty * buf_prev_price-list.price-sale
     2668           v-prev-cur-VAT-base = v-fact-qnty
     2669                               * (buf_prev_price-list.price-sale - v-prev-cur-SLT-pc)
     2670                               * buf_prev_price-list.vat-pc / (100 + buf_prev_price-list.vat-pc)
     2671           v-prev-cur-SLT-base = v-fact-qnty * v-prev-cur-SLT-pc
     2672         .
     2673         assign
     2674           p-fact-qnty   = v-fact-qnty
     2675           p-ov-base     = v-cur-base     - v-prev-cur-base
     2676           p-ov-VAT-base = v-cur-VAT-base - v-prev-cur-VAT-base
     2677           p-ov-SLT-base = v-cur-SLT-base - v-prev-cur-SLT-base
     2678         .
     2679       end.
     2680       else do:
     2681         assign
     2682           v-prev-cur-base     = 0
     2683           v-prev-cur-VAT-base = 0
     2684           v-prev-cur-SLT-base = 0
     2685           .
     2686         assign
     2687           p-fact-qnty   = v-fact-qnty
     2688           p-ov-base     = v-cur-base     - v-prev-cur-base
     2689           p-ov-VAT-base = v-cur-VAT-base - v-prev-cur-VAT-base
     2690           p-ov-SLT-base = v-cur-SLT-base - v-prev-cur-SLT-base
     2691         .
     2692       end.
     2693     end.
     2694   end procedure.
     2695   procedure prdoclib-init-prt-obj-by-factord :
     2696     define input parameter p-obj-type           like ub.gds-obj.obj-type  no-undo .
     2697     define input parameter p-obj-code           like ub.gds-obj.obj-code  no-undo .
     2698     define input parameter p-artic              like ub.gds-obj.artic     no-undo .
     2699     define input parameter p-prod-type          like ub.gds-obj.prod-type no-undo .
     2700     define input parameter p-prod-code          like ub.gds-obj.prod-code no-undo .
     2701     define input parameter p-fact-order         as decimal   no-undo .
     2702     define input parameter p-include-fact-order as logical   no-undo .
     2703     define variable vss-description as character no-undo init "prdoclib-init-prt-obj-by-factord: определение остатков по признакам на любой момент времени".
     2704     define buffer buf_gds-obj      for ub.gds-obj .
     2705     define buffer buf_doc-line     for ub.doc-line .
     2706     define buffer buf_temp-prt-obj for temp-prt-obj .
     2707     define variable v-total-gds-dtl-qnty as decimal   no-undo .
     2708     do
     2709     on error undo, return error return-value
     2710     :
     2711       do transaction
     2712       on error undo, return error return-value
     2713       :
     2714   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2715   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     2716     (input  p-obj-type
     2717     ,input  p-obj-code
     2718     ,input  p-artic
     2719     ,input  p-prod-type
     2720     ,input  p-prod-code
     2721     ,buffer buf_gds-obj
     2722     ) no-error .
     2723         if error-status :error
     2724         then do:
     2725           message
     2726             vss-workfile vss-revision vss-description skip
     2727             vss-include-info16 skip
     2728             "Невозможно найти gds-obj" skip
     2729             error-status :get-message(1) skip
     2730             return-value skip
     2731             view-as alert-box error .
     2732           undo, return error .
     2733         end.
     2734         find current buf_gds-obj exclusive-lock .
     2735       end.
     2736       run prdoclib-init-temp-prt-obj in this-procedure
     2737         (input p-obj-type
     2738         ,input p-obj-code
     2739         ,input p-artic
     2740         ,input p-prod-type
     2741         ,input p-prod-code
     2742         ,input 0
     2743         ) .
     2744       for each buf_temp-prt-obj
     2745         where buf_temp-prt-obj.is-term <> true
     2746       on error undo, return error return-value
     2747       :
     2748         delete buf_temp-prt-obj .
     2749       end.
     2750       if p-include-fact-order = true
     2751       then do:
     2752         assign
     2753          p-fact-order = p-fact-order - 0.0000000001
     2754         .
     2755       end.
     2756       for each buf_doc-line no-lock
     2757         where buf_doc-line.obj-type   = p-obj-type
     2758           and buf_doc-line.obj-code   = p-obj-code
     2759           and buf_doc-line.artic      = p-artic
     2760           and buf_doc-line.prod-type  = p-prod-type
     2761           and buf_doc-line.prod-code  = p-prod-code
     2762           and buf_doc-line.status_    = 'факт':U
     2763           and buf_doc-line.fact-order >= p-fact-order
     2764       on error undo, return error return-value
     2765       :
     2766         run prdoclib-process-document in this-procedure
     2767           (input  buf_doc-line.doc-code
     2768           ,input  p-obj-type
     2769           ,input  p-obj-code
     2770           ,input  p-artic
     2771           ,input  p-prod-type
     2772           ,input  p-prod-code
     2773           ,output v-total-gds-dtl-qnty
     2774           ) .
     2775       end.
     2776     end.
     2777   end procedure.
     2778   procedure prdoclib-process-document :
     2779     define input  parameter p-doc-code           as character no-undo .
     2780     define input  parameter p-obj-type           as character no-undo .
     2781     define input  parameter p-obj-code           as integer   no-undo .
     2782     define input  parameter p-artic              as character no-undo .
     2783     define input  parameter p-prod-type          as character no-undo .
     2784     define input  parameter p-prod-code          as integer   no-undo .
     2785     define output parameter p-total-gds-dtl-qnty as decimal   no-undo .
     2786     define buffer buf_trn-doc      for ub.trn-doc .
     2787     define buffer buf_gds-dtl      for ub.gds-dtl .
     2788     define buffer buf_temp-prt-obj for temp-prt-obj .
     2789     do
     2790     on error undo, return error return-value
     2791     :
     2792       find first buf_trn-doc no-lock
     2793         where buf_trn-doc.doc-code = p-doc-code
     2794         no-error .
     2795       if not available buf_trn-doc then do:
     2796         message
     2797           vss-workfile vss-revision vss-description skip
     2798           vss-include-info16 skip
     2799           "Ошибка при поиске документа" skip
     2800           "Документ" p-doc-code skip
     2801           "Объект" p-obj-type p-obj-code skip
     2802           "Артикул" p-artic p-prod-type p-prod-code skip
     2803           view-as alert-box error .
     2804         undo, return error .
     2805       end.
     2806       assign
     2807         p-total-gds-dtl-qnty = 0
     2808       .
     2809       for each buf_gds-dtl no-lock
     2810         where buf_gds-dtl.doc-code  = p-doc-code
     2811           and buf_gds-dtl.artic     = p-artic
     2812           and buf_gds-dtl.prod-type = p-prod-type
     2813           and buf_gds-dtl.prod-code = p-prod-code
     2814       on error undo, return error
     2815       :
     2816         define variable v-term-node as integer   no-undo .
     2817   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run termnode in g#library
     2818     (input  buf_gds-dtl.prt-code
     2819     ,output v-term-node
     2820     )  .
     2821         run prdoclib-temp-prt-obj-by-prt-root in this-procedure
     2822           (input  v-term-node
     2823           ,buffer buf_temp-prt-obj
     2824           ) .
     2825         if buf_temp-prt-obj.is-term <> true then do:
     2826           undo, return error substitute("Документ ссылается на нетерминальный признак. Код признака &1"
     2827                                        ,buf_gds-dtl.prt-code
     2828                                        ) .
     2829         end.
     2830         case buf_trn-doc.doc-type :
     2831           when 'при':U or
     2832           when 'возврат':U
     2833           then do:
     2834             assign
     2835               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     2836                                           - buf_gds-dtl.fact-qnty
     2837               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     2838                                           - buf_gds-dtl.fact-qnty
     2839             .
     2840           end.
     2841           when 'рас':U or
     2842           when 'спи':U
     2843           then do:
     2844             assign
     2845               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     2846                                           + buf_gds-dtl.fact-qnty
     2847               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     2848                                           + buf_gds-dtl.fact-qnty
     2849             .
     2850           end.
     2851           when 'инв':U
     2852           then do:
     2853             assign
     2854               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     2855                                           - buf_gds-dtl.doc-qnty
     2856               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     2857                                           - buf_gds-dtl.doc-qnty
     2858             .
     2859           end.
     2860           otherwise do:
     2861             undo, return error substitute("Неизвестный тип документа &1"
     2862                                          ,buf_trn-doc.doc-type
     2863                                          ) .
     2864           end.
     2865         end.
     2866       end.
     2867     end.
     2868   end procedure.
     2869   procedure prdoclib-prc-pl-document :
     2870     define input  parameter p-doc-code              as character no-undo .
     2871     define input  parameter p-obj-type              as character no-undo .
     2872     define input  parameter p-obj-code              as integer   no-undo .
     2873     define input  parameter p-gds-code              as integer   no-undo .
     2874     define output parameter p-total-pl-gds-qnty     as decimal   no-undo .
     2875     define output parameter p-total-pl-gds-cli-qnty as decimal   no-undo .
     2876     do
     2877     on error undo, return error return-value
     2878     :
     2879       define buffer buf_trn-doc      for ub.trn-doc .
     2880       define buffer buf_doc-pl       for ub.doc-pl .
     2881       define buffer buf_temp-pl-gds for temp-pl-gds .
     2882       define variable v-sign as decimal   no-undo .
     2883       find first buf_trn-doc no-lock
     2884         where buf_trn-doc.doc-code = p-doc-code
     2885         no-error .
     2886       if not available buf_trn-doc then do:
     2887         message
     2888           vss-workfile vss-revision vss-description skip
     2889           vss-include-info16 skip
     2890           "Ошибка при поиске документа" skip
     2891           "Документ" p-doc-code skip
     2892           "Объект" p-obj-type p-obj-code skip
     2893           "Товар" p-gds-code skip
     2894           view-as alert-box error .
     2895         undo, return error .
     2896       end.
     2897       assign
     2898         p-total-pl-gds-qnty     = 0
     2899         p-total-pl-gds-cli-qnty = 0
     2900       .
     2901       for each buf_doc-pl no-lock
     2902         where buf_doc-pl.out-code  = p-doc-code
     2903           and buf_doc-pl.gds-code  = p-gds-code
     2904       on error undo, return error return-value
     2905       :
     2906         find first buf_temp-pl-gds
     2907           where buf_temp-pl-gds.obj-type = buf_trn-doc.obj-type
     2908             and buf_temp-pl-gds.obj-code = buf_trn-doc.obj-code
     2909             and buf_temp-pl-gds.pl-code  = buf_doc-pl.pl-code
     2910           .
     2911         case buf_trn-doc.doc-type :
     2912           when 'при':U
     2913           or when 'возврат':U
     2914           or when 'инв':U
     2915           then do:
     2916             assign
     2917               v-sign = -1.0
     2918             .
     2919           end.
     2920           when 'рас':U or
     2921           when 'спи':U
     2922           then do:
     2923             assign
     2924               v-sign = 1.0
     2925             .
     2926           end.
     2927           otherwise do:
     2928             undo, return error substitute("(prdoclib-prc-pl-document) Неизвестный тип документа &1", buf_trn-doc.doc-type ) .
     2929           end.
     2930         end case.
     2931         assign
     2932           p-total-pl-gds-qnty           = p-total-pl-gds-qnty           + buf_doc-pl.fact-qnty     * v-sign
     2933           p-total-pl-gds-cli-qnty       = p-total-pl-gds-cli-qnty       + buf_doc-pl.cli-fact-qnty * v-sign
     2934           buf_temp-pl-gds.fact-qnty     = buf_temp-pl-gds.fact-qnty     + buf_doc-pl.fact-qnty     * v-sign
     2935           buf_temp-pl-gds.cli-fact-qnty = buf_temp-pl-gds.cli-fact-qnty + buf_doc-pl.cli-fact-qnty * v-sign
     2936         .
     2937       end.
     2938     end.
     2939   end procedure.
     2940   procedure prdoclib-init-prt-obj-by-date :
     2941     define input parameter p-obj-type   like ub.gds-obj.obj-type  no-undo .
     2942     define input parameter p-obj-code   like ub.gds-obj.obj-code  no-undo .
     2943     define input parameter p-artic      like ub.gds-obj.artic     no-undo .
     2944     define input parameter p-prod-type  like ub.gds-obj.prod-type no-undo .
     2945     define input parameter p-prod-code  like ub.gds-obj.prod-code no-undo .
     2946     define input parameter p-fact-date  as date      no-undo .
     2947     define variable vss-description as character no-undo init "prdoclib-init-prt-obj-by-date: определение остатков по признакам на конец дня".
     2948     do
     2949     on error undo, return error return-value
     2950     :
     2951       define variable v-fact-order                as decimal   no-undo .
     2952       define variable v-shift-end-fact-order      as decimal   no-undo .
     2953       define variable v-day-end-fact-order        as decimal   no-undo .
     2954       run factord in this-procedure
     2955         (input  p-fact-date
     2956         ,input  1
     2957         ,input  1
     2958         ,input  ?
     2959         ,input  0
     2960         ,input  false
     2961         ,output v-fact-order
     2962         ,output v-shift-end-fact-order
     2963         ,output v-day-end-fact-order
     2964         ) no-error .
     2965       if error-status :error
     2966       then do:
     2967         message
     2968           vss-workfile vss-revision vss-description skip
     2969           vss-include-info16 skip
     2970           "Ошибка при определении момента времени, на который требуется остаток" skip
     2971           "Объект" p-obj-type p-obj-code skip
     2972           "Артикул" p-artic p-prod-type p-prod-code skip
     2973           "Дата" p-fact-date skip
     2974           view-as alert-box error .
     2975         undo, return error .
     2976       end.
     2977       run prdoclib-init-prt-obj-by-date-factord in this-procedure
     2978         (input p-obj-type
     2979         ,input p-obj-code
     2980         ,input p-artic
     2981         ,input p-prod-type
     2982         ,input p-prod-code
     2983         ,input v-day-end-fact-order
     2984         ,input false
     2985         ) no-error .
     2986       if error-status :error
     2987       then do:
     2988         message
     2989           vss-workfile vss-revision vss-description skip
     2990           vss-include-info16 skip
     2991           "Ошибка при вызове метода prdoclib-init-prt-obj-by-date-factord" skip
     2992           "Объект" p-obj-type p-obj-code skip
     2993           "Артикул" p-artic p-prod-type p-prod-code skip
     2994           "Дата" p-fact-date skip
     2995           view-as alert-box error .
     2996         undo, return error .
     2997       end.
     2998     end.
     2999   end procedure.
     3000   procedure prdoclib-calc-temp-fact-sale :
     3001     define input  parameter p-obj-type           as character no-undo .
     3002     define input  parameter p-obj-code           as integer   no-undo .
     3003     define input  parameter p-gds-code           as integer   no-undo .
     3004     define input  parameter p-day-end-fact-order as decimal   no-undo .
     3005     define input  parameter p-curr-r-b           as character no-undo .
     3006     define output parameter p-fact-qnty          as decimal   no-undo .
     3007     define output parameter p-cur-base           as decimal   no-undo .
     3008     define output parameter p-cur-VAT-base       as decimal   no-undo .
     3009     define output parameter p-cur-SLT-base       as decimal   no-undo .
     3010     define output parameter p-cur-road-tax-base  as decimal   no-undo .
     3011     define output parameter p-cur-excise-base    as decimal   no-undo .
     3012     define buffer buf_temp-prt-obj for temp-prt-obj .
     3013     define variable v-prt-b-code        like ub.bar-code.b-code no-undo .
     3014     define variable v-cli-base-rate     like ub.bar-code.cli-base-rate no-undo .
     3015     define variable parrecid-prl        as recid     no-undo .
     3016     define variable v-fact-qnty         as decimal   no-undo .
     3017     define variable v-cur-base          as decimal   no-undo .
     3018     define variable v-cur-VAT-base      as decimal   no-undo .
     3019     define variable v-cur-SLT-base      as decimal   no-undo .
     3020     define variable v-cur-road-tax-base as decimal   no-undo .
     3021     define variable v-cur-excise-base   as decimal   no-undo .
     3022     define variable price-rubl-with-tax-sale-prl    as decimal   no-undo .
     3023     define variable price-base-with-tax-sale-prl    as decimal   no-undo .
     3024     define variable price-rubl-without-tax-sale-prl as decimal   no-undo .
     3025     define variable price-base-without-tax-sale-prl as decimal   no-undo .
     3026     define variable vat-base-sale-prl               as decimal   no-undo .
     3027     define variable vat-rubl-sale-prl               as decimal   no-undo .
     3028     define variable vat-base-buyer-prl              as decimal   no-undo .
     3029     define variable vat-rubl-buyer-prl              as decimal   no-undo .
     3030     define variable slt-base-sale-prl               as decimal   no-undo .
