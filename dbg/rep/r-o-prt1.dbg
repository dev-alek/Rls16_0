       22   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       23   procedure cur-time :
       24      define output parameter p-today as date      no-undo .
       25      define output parameter p-time  as integer   no-undo .
       26     do
       27     on error undo, return error
       28     :
       29       define variable v-date1 as date      no-undo .
       30       define variable v-date2 as date      no-undo .
       31       define variable v-time  as integer   no-undo .
       32       assign
       33         v-date1 = today
       34         v-time  = time
       35         v-date2 = today
       36       .
       37       if v-date1 <> v-date2
       38       then do:
       39         assign
       40           v-date1 = today
       41           v-time  = v-time
       42         .
       43       end.
       44       assign
       45         p-today = v-date1
       46         p-time  = v-time
       47       .
       48     end.
       49   end.
       50   function cur-time-date returns character
       51   :
       52     return string(today, '99/99/9999':U) .
       53   end.
       54   function cur-time-mjd returns decimal
       55   :
       56     define variable v-date as date      no-undo .
       57     define variable v-time as integer   no-undo .
       58     run cur-time in this-procedure
       59       (output v-date
       60       ,output v-time
       61       ) .
       62     return integer(v-date) - 2400002 + (v-time / 86400) .
       63   end.
       64   function cur-time-get-ending-index returns integer
       65   (input p-number as integer
       66   )
       67   :
       68     if p-number < 0
       69     or p-number = ?
       70     then do:
       71       return 1 .
       72     end.
       73     define variable v-rest as integer   no-undo .
       74     assign
       75       p-number = p-number modulo 100
       76     .
       77     if p-number < 20
       78     then do:
       79       assign
       80         v-rest = p-number
       81       .
       82     end.
       83     else do:
       84       assign
       85         v-rest = p-number modulo 10
       86       .
       87     end.
       88     case v-rest :
       89       when 1
       90       then do:
       91         return 2 .
       92       end.
       93       when 2 or
       94       when 3 or
       95       when 4
       96       then do:
       97         return 3 .
       98       end.
       99       otherwise do:
      100         return 1 .
      101       end.
      102     end case .
      103   end.
      104   procedure cur-time-mjd-to-date :
      105      define input  parameter i-mjd-diff as decimal no-undo.
      106      define output parameter o-Date     as date    no-undo.
      107      define output parameter o-Time     as integer no-undo.
      108      define variable v-day-number as integer   no-undo .
      109      if    i-mjd-diff < 0
      110         or i-mjd-diff = ?
      111      then do:
      112         return "?" .
      113      end.
      114      assign
      115         v-day-number = truncate(i-mjd-diff,0).
      116         o-Date = date(v-day-number + 2400002).
      117         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      118     .
      119   end.
      120   function cur-time-mjd-to-string returns character
      121   (input p-mjd-diff as decimal
      122   )
      123   :
      124     define variable v-day-number as integer   no-undo .
      125     define variable v-seconds    as integer   no-undo .
      126     define variable v-hour       as integer   no-undo .
      127     define variable v-min        as integer   no-undo .
      128     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      129     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      130     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      131     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      132     if p-mjd-diff < 0
      133     or p-mjd-diff = ?
      134     then do:
      135       return "?" .
      136     end.
      137     assign
      138       v-day-number = integer(truncate(p-mjd-diff,0))
      139       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      140     .
      141     if v-seconds > 86400
      142     then do:
      143       assign
      144         v-seconds = 86400 - 1
      145       .
      146     end.
      147     if v-seconds < 0
      148     then do:
      149       assign
      150         v-seconds = 0
      151       .
      152     end.
      153     assign
      154       v-hour = truncate(v-seconds / 3600, 0)
      155     .
      156     assign
      157       v-seconds = v-seconds modulo 3600
      158     .
      159     assign
      160       v-min = truncate(v-seconds / 60, 0)
      161     .
      162     assign
      163       v-seconds = v-seconds modulo 60
      164     .
      165     return
      166         (if v-day-number <> 0
      167           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      168           else ""
      169         )
      170       + (if v-day-number <> 0 or v-hour <> 0
      171           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      172           else ""
      173         )
      174       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      175           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      176           else ""
      177         )
      178       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      179       .
      180   end.
      181   function cur-time-string returns character
      182   :
      183     define variable v-date as date      no-undo .
      184     define variable v-time as integer   no-undo .
      185     run cur-time in this-procedure
      186       (output v-date
      187       ,output v-time
      188       ) .
      189     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      190   end.
      191   function cur-time-string-sec returns character
      192   :
      193     define variable v-date as date      no-undo .
      194     define variable v-time as integer   no-undo .
      195     run cur-time in this-procedure
      196       (output v-date
      197       ,output v-time
      198       ) .
      199     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      200   end.
      201   function cur-time-custom  returns character
      202   (input p-prefix as character
      203   ,input p-date-format as character
      204   ,input p-delimiter as character
      205   ,input p-time-format as character
      206   ,input p-suffix as character
      207   )
      208   :
      209     define variable v-date as date      no-undo .
      210     define variable v-time as integer   no-undo .
      211     run cur-time in this-procedure
      212       (output v-date
      213       ,output v-time
      214       ) .
      215     return
      216       p-prefix
      217       + string(v-date, p-date-format)
      218       + p-delimiter
      219       + string(v-time, p-time-format)
      220       + p-suffix
      221       .
      222   end.
      223   function cur-time-print  returns character
      224   :
      225     define variable v-date as date      no-undo .
      226     define variable v-time as integer   no-undo .
      227     run cur-time in this-procedure
      228       (output v-date
      229       ,output v-time
      230       ) .
      231     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      232   end.
      233   function cur-time-datetime returns datetime
      234   :
      235     define variable v-char as character no-undo .
      236     define variable v-datetime as datetime no-undo .
      237     v-char = cur-time-string().
      238     v-datetime = datetime(v-char).
      239     return  v-datetime.
      240   end.
      241   function cur-time-string-msec returns character
      242   :
      243     define variable v-date as datetime  no-undo .
      244     v-date = now.
      245     return string(v-date) .
      246   end.
