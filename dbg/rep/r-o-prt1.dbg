     5510   Assign
     5511       l1f-qnty-o  = c-f-qnty-o:DATA-TYPE
     5512       l2f-qnty-o  = c-f-qnty-o:FORMAT
     5513       c-f-qnty-o:DATA-TYPE = "CHARACTER"
     5514       c-f-qnty-o:FORMAT    = "x(" + string(C-f-qnty-o:WIDTH-CHARS) + ")"
     5515       c-f-qnty-o:screen-value = string('')  .
     5516   End.
     5517   if c-f-cost-sum-o <>  ?  then do :
     5518   Assign
     5519       l1f-cost-sum-o  = c-f-cost-sum-o:DATA-TYPE
     5520       l2f-cost-sum-o  = c-f-cost-sum-o:FORMAT
     5521       c-f-cost-sum-o:DATA-TYPE = "CHARACTER"
     5522       c-f-cost-sum-o:FORMAT    = "x(" + string(C-f-cost-sum-o:WIDTH-CHARS) + ")"
     5523       c-f-cost-sum-o:screen-value = string('')  .
     5524   End.
     5525   if c-f-crsa-sum-o <>  ?  then do :
     5526   Assign
     5527       l1f-crsa-sum-o  = c-f-crsa-sum-o:DATA-TYPE
     5528       l2f-crsa-sum-o  = c-f-crsa-sum-o:FORMAT
     5529       c-f-crsa-sum-o:DATA-TYPE = "CHARACTER"
     5530       c-f-crsa-sum-o:FORMAT    = "x(" + string(C-f-crsa-sum-o:WIDTH-CHARS) + ")"
     5531       c-f-crsa-sum-o:screen-value = string('')  .
     5532   End.
     5533   display stream outstream no-error .
     5534   down stream outstream .
     5535   if c-f-qnty <>  ?  then do :
     5536   Assign
     5537       c-f-qnty:DATA-TYPE = l1f-qnty
     5538       c-f-qnty:FORMAT    = l2f-qnty.
     5539   End.
     5540   if c-f-cost-sum <>  ?  then do :
     5541   Assign
     5542       c-f-cost-sum:DATA-TYPE = l1f-cost-sum
     5543       c-f-cost-sum:FORMAT    = l2f-cost-sum.
     5544   End.
     5545   if c-f-sale-sum <>  ?  then do :
     5546   Assign
     5547       c-f-sale-sum:DATA-TYPE = l1f-sale-sum
     5548       c-f-sale-sum:FORMAT    = l2f-sale-sum.
     5549   End.
     5550   if c-f-sale-other <>  ?  then do :
     5551   Assign
     5552       c-f-sale-other:DATA-TYPE = l1f-sale-other
     5553       c-f-sale-other:FORMAT    = l2f-sale-other.
     5554   End.
     5555   if c-f-crsa-sum <>  ?  then do :
     5556   Assign
     5557       c-f-crsa-sum:DATA-TYPE = l1f-crsa-sum
     5558       c-f-crsa-sum:FORMAT    = l2f-crsa-sum.
     5559   End.
     5560   if c-f-qnty-all <>  ?  then do :
     5561   Assign
     5562       c-f-qnty-all:DATA-TYPE = l1f-qnty-all
     5563       c-f-qnty-all:FORMAT    = l2f-qnty-all.
     5564   End.
     5565   if c-f-cost-sum-all <>  ?  then do :
     5566   Assign
     5567       c-f-cost-sum-all:DATA-TYPE = l1f-cost-sum-all
     5568       c-f-cost-sum-all:FORMAT    = l2f-cost-sum-all.
     5569   End.
     5570   if c-f-crsa-sum-all <>  ?  then do :
     5571   Assign
     5572       c-f-crsa-sum-all:DATA-TYPE = l1f-crsa-sum-all
     5573       c-f-crsa-sum-all:FORMAT    = l2f-crsa-sum-all.
     5574   End.
     5575   if c-f-qnty-o <>  ?  then do :
     5576   Assign
     5577       c-f-qnty-o:DATA-TYPE = l1f-qnty-o
     5578       c-f-qnty-o:FORMAT    = l2f-qnty-o.
     5579   End.
     5580   if c-f-cost-sum-o <>  ?  then do :
     5581   Assign
     5582       c-f-cost-sum-o:DATA-TYPE = l1f-cost-sum-o
     5583       c-f-cost-sum-o:FORMAT    = l2f-cost-sum-o.
     5584   End.
     5585   if c-f-crsa-sum-o <>  ?  then do :
     5586   Assign
     5587       c-f-crsa-sum-o:DATA-TYPE = l1f-crsa-sum-o
     5588       c-f-crsa-sum-o:FORMAT    = l2f-crsa-sum-o.
     5589   End.
     5590   if Make-Excel then  put   stream ForExcel unformatted  obj-list.obj-name chr(10).
     5591   end.
     5592         n-nn = 0.
     5593         n-no = n-no + 1 .
     5594   for each ub.ot-line where
     5595         ub.ot-line.fact-order <= fact-order-2 and
     5596         ub.ot-line.fact-order >= fact-order-1 and
     5597         ub.ot-line.obj-code    = obj-list.obj-code and
     5598         ub.ot-line.obj-type    = obj-list.obj-type  and
     5599         ( ub.ot-line.sum-type = 'sale':U or
     5600           ub.ot-line.sum-type = 'crsa':U or
     5601           ub.ot-line.sum-type = 'cost':U )
     5602           no-lock ,
     5603         first goods where
     5604               goods.prod-type  = ub.ot-line.prod-type and
     5605               goods.prod-code  = ub.ot-line.prod-code and
     5606               goods.artic      = ub.ot-line.artic     and
     5607               goods.gds-type   = 'т':U
     5608               no-lock ,
     5609          first gds-list where  gds-list.prod-type  = ub.ot-line.prod-type and
     5610                                 gds-list.prod-code = ub.ot-line.prod-code and
     5611                                 gds-list.artic     = ub.ot-line.artic
     5612           break
     5613               by goods.grp-name by ( ub.ot-line.artic + ub.ot-line.prod-type + string ( ub.ot-line.prod-code ))
     5614               by ub.ot-line.artic
     5615               with frame zapas :
     5616              n-nm = n-nm + 1.
     5617           if first-of(ub.ot-line.artic) then do:
     5618               assign
     5619                 f-qnty         = 0
     5620                 f-cost-sum     = 0
     5621                 f-sale-sum     = 0
     5622                 f-sale-other   = 0
     5623                 f-crsa-sum     = 0
     5624                 f-qnty-all     = 0
     5625                 f-cost-sum-all = 0
     5626                 f-crsa-sum-all = 0
     5627                 f-qnty-o       = 0
     5628                 f-cost-sum-o   = 0
     5629                 f-crsa-sum-o   = 0.
     5630               for each temp-doc-code  : delete temp-doc-code . end.
     5631               for each temp-doc-code-all  : delete temp-doc-code-all . end.
     5632           end.
     5633           if can-find( first tdedt where  ub.ot-line.ext-doc-type = tdedt.id no-lock ) then do:
     5634               case  ub.ot-line.sum-type :
     5635                   when 'cost':U then do:
     5636                       f-cost-sum = f-cost-sum + ub.ot-line.sum-rubl .
     5637                   end.
     5638                   when 'sale':U then do:
     5639                       f-sale-sum   = f-sale-sum   +  ub.ot-line.sum-rubl .
     5640                       f-sale-other = f-sale-other + ub.ot-line.other-rubl .
     5641                   end.
     5642                   when  'crsa':U then do:
     5643                       f-crsa-sum = f-crsa-sum + ub.ot-line.sum-rubl  .
     5644                       f-qnty     = f-qnty     + ub.ot-line.fact-qnty .
     5645                       if itog = false then do:
     5646                           create temp-doc-code .
     5647                           assign
     5648                               temp-doc-code.doc-code     = ub.ot-line.doc-code
     5649                               temp-doc-code.ext-doc-type = ub.ot-line.ext-doc-type
     5650                               temp-doc-code.si  = if  ub.ot-line.fact-qnty < 0 then -1 else 1
     5651                               temp-doc-code.si2 = if  ub.ot-line.other-rubl < 0 then -1 else 1
     5652                               .
     5653                       end.
     5654                   end.
     5655               end case.
     5656             end.
     5657               case  ub.ot-line.sum-type :
     5658                   when 'cost':U then do:
     5659                     f-cost-sum-all = f-cost-sum-all + ub.ot-line.sum-rubl .
     5660                   end.
     5661                   when  'crsa':U then do:
     5662                     f-crsa-sum-all = f-crsa-sum-all + ub.ot-line.sum-rubl  .
     5663                     f-qnty-all     = f-qnty-all     + ub.ot-line.fact-qnty .
     5664                   end.
     5665               end case.
     5666               create temp-doc-code-all .
     5667               assign
     5668                   temp-doc-code-all.doc-code = ub.ot-line.doc-code
