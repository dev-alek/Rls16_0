     8637       c-f-qnty-o:DATA-TYPE = l1f-qnty-o
     8638       c-f-qnty-o:FORMAT    = l2f-qnty-o.
     8639   End.
     8640   if c-f-cost-sum-o <>  ?  then do :
     8641   Assign
     8642       c-f-cost-sum-o:DATA-TYPE = l1f-cost-sum-o
     8643       c-f-cost-sum-o:FORMAT    = l2f-cost-sum-o.
     8644   End.
     8645   if c-f-crsa-sum-o <>  ?  then do :
     8646   Assign
