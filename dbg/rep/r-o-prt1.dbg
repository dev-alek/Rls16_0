     9102   PROCEDURE Display-prt :
     9103   if goods.prt-root <> Prtroot Then DO:
     9104   If v-var = "no-today"  then
     9105   run prdoclib-init-prt-obj-by-factord in this-procedure
     9106   ( input gds-obj.obj-type  ,
     9107   input gds-obj.obj-code  ,
     9108   input gds-obj.artic     ,
     9109   input gds-obj.prod-type ,
     9110   input gds-obj.prod-code ,
     9111   input fact-order-2 ,
     9112   input false ) .
     9113   for each ub.prt-obj where
     9114     ub.prt-obj.artic     = goods.artic         and
     9115     ub.prt-obj.prod-type = goods.prod-type and
     9116     ub.prt-obj.prod-code = goods.prod-code and
     9117     ub.prt-obj.obj-code  = obj-list.obj-code   and
     9118     ub.prt-obj.obj-type  = obj-list.obj-type   and
     9119     ub.prt-obj.IS-term   =  true no-lock
     9120           BREAK BY ub.prt-obj.prt-code with FRAME Zapas:
     9121                 if v-var <> "no-today" then do:
     9122                   Assign
     9123                     p-qnty-o     = p-qnty-o     + ub.prt-obj.fact-qnty
     9124                     p-crsa-sum-o = p-crsa-sum-o + ub.prt-obj.fact-qnty * ub.prt-obj.price-sale .
     9125                 End.
     9126   IF last-of(prt-obj.prt-code) THEN DO:
     9127   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     9128     (input  gds-obj.gds-code
     9129     ,input  ub.prt-obj.prt-code
     9130     ,output v-bar-code
     9131     )  .
     9132             if v-var = "no-today" then do:
     9133               find first temp-prt-obj no-lock
     9134                     where temp-prt-obj.prt-obj-recid   = recid (prt-obj) no-error .
     9135                     if avail temp-prt-obj then do :
     9136                       run calc-price-sale-for-prt in this-procedure  (output v-price-sale) .
     9137                       Assign
     9138                         p-qnty-o      = temp-prt-obj.fact-qnty
     9139                         p-crsa-sum-o  = temp-prt-obj.fact-qnty * v-price-sale      .
     9140                     End.
     9141                     Else
     9142                       Assign
     9143                         p-qnty-o      = 0
     9144                         p-crsa-sum-o  = 0   .
     9145             End.
     9146       FIND first ub.gds-prt  where ub.gds-prt.node-code = ub.prt-obj.prt-code NO-LOCK no-error .
     9147       for each ub.gds-dtl no-lock where
     9148           ub.gds-dtl.artic      = goods.artic     and
     9149           ub.gds-dtl.prod-code  = goods.prod-code and
     9150           ub.gds-dtl.prod-type  = goods.prod-type and
     9151           ub.gds-dtl.prt-code   = ub.prt-obj.prt-code  and
     9152           ub.gds-dtl.obj-code   = obj-list.obj-code  and
     9153           ub.gds-dtl.obj-type   = obj-list.obj-type :
     9154               find first temp-doc-code where temp-doc-code.doc-code = ub.gds-dtl.doc-code no-lock no-error .
     9155                 if avail temp-doc-code then DO:
     9156                 Assign
     9157                     t-qnty = if temp-doc-code.ext-doc-type = 'vt':U
     9158                                 then ub.gds-dtl.doc-qnty
     9159                                 else ( ub.gds-dtl.fact-qnty * temp-doc-code.si )
     9160                     p-qnty       = p-qnty       + t-qnty
     9161                     p-sale-sum   = p-sale-sum   + (gds-dtl.price-rubl * t-qnty)
     9162                     p-sale-other = p-sale-other + (gds-dtl.discnt-rubl * temp-doc-code.si2)
     9163                     p-crsa-sum   = p-crsa-sum   + (gds-dtl.cur-base * t-qnty)
     9164                     .
     9165               End.
     9166               find first temp-doc-code-all where temp-doc-code-all.doc-code = ub.gds-dtl.doc-code no-lock no-error .
     9167                 if avail temp-doc-code-all then DO:
     9168                     Assign
     9169                     t-qnty-all = if temp-doc-code-all.ext-doc-type = 'vt':U
     9170                                       then ub.gds-dtl.doc-qnty
     9171                                       else ( ub.gds-dtl.fact-qnty * temp-doc-code-all.si )
     9172                       p-qnty-all       = p-qnty-all  + t-qnty-all
     9173                       p-crsa-sum-all   = p-crsa-sum-all   + (gds-dtl.cur-base * t-qnty-all ).
     9174                 End.
     9175       end.
     9176       if f-qnty <> ? and f-qnty <> 0 then
     9177           Assign
     9178             p-cost-sum     = f-cost-sum      * p-qnty     / f-qnty
     9179           .
     9180       else
     9181           Assign
     9182               p-cost-sum     = 0
     9183           .
     9184       if f-qnty-all <> ? and f-qnty-all <> 0 then
     9185           Assign
     9186             p-cost-sum-all = f-cost-sum-all  * p-qnty-all / f-qnty-all
     9187           .
     9188       else
     9189           Assign
     9190               p-cost-sum-all = 0
     9191             .
     9192       if f-qnty-o <> ? and f-qnty-o <> 0 then
     9193           Assign
     9194             p-cost-sum-o   = f-cost-sum-o    * p-qnty-o   / f-qnty-o
     9195           .
     9196       else
     9197           Assign
     9198               p-cost-sum-o   = 0
     9199           .
     9200       if  NOT(p-qnty      =  0 and
     9201             p-cost-sum    =  0     and
     9202             p-sale-sum    =  0     and
     9203             p-sale-other  =  0     and
     9204             p-crsa-sum    =  0     and
     9205             p-qnty-all    =  0     and
     9206             p-cost-sum-all = 0     and
     9207             p-crsa-sum-all=  0    ) then dO:
     9208     if c-nn <>  ?  then do :
     9209       c-nn:screen-value = string('') .
     9210       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9211           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9212           display STREAM OutStream    with frame top-frame .
     9213       End.
     9214     End.
     9215     if c-f-artic <>  ?  then do :
     9216       c-f-artic:screen-value = string('') .
     9217       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9218           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9219           display STREAM OutStream    with frame top-frame .
     9220       End.
     9221     End.
     9222     if c-f-b-code <>  ?  then do :
     9223       c-f-b-code:screen-value = string(string(v-bar-code,'999999999')) .
     9224       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9225           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9226           display STREAM OutStream    with frame top-frame .
     9227       End.
     9228     End.
     9229     if c-f-gds-name <>  ?  then do :
     9230       c-f-gds-name:screen-value = string(ub.gds-prt.f-name) .
     9231       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9232           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9233           display STREAM OutStream    with frame top-frame .
     9234       End.
     9235     End.
     9236     if c-f-qnty <>  ?  then do :
     9237       c-f-qnty:screen-value = string(p-qnty) .
     9238       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9239           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9240           display STREAM OutStream    with frame top-frame .
     9241       End.
     9242     End.
     9243     if c-f-cost-sum <>  ?  then do :
     9244       c-f-cost-sum:screen-value = string(p-cost-sum) .
     9245       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9246           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9247           display STREAM OutStream    with frame top-frame .
     9248       End.
     9249     End.
     9250     if c-f-sale-sum <>  ?  then do :
     9251       c-f-sale-sum:screen-value = string(p-sale-sum) .
     9252       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9253           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9254           display STREAM OutStream    with frame top-frame .
     9255       End.
     9256     End.
     9257     if c-f-sale-other <>  ?  then do :
     9258       c-f-sale-other:screen-value = string(p-sale-other) .
     9259       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9260           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9261           display STREAM OutStream    with frame top-frame .
     9262       End.
     9263     End.
     9264     if c-f-crsa-sum <>  ?  then do :
     9265       c-f-crsa-sum:screen-value = string(p-crsa-sum) .
     9266       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9267           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9268           display STREAM OutStream    with frame top-frame .
     9269       End.
     9270     End.
     9271     if c-f-qnty-all <>  ?  then do :
     9272       c-f-qnty-all:screen-value = string(p-qnty-all) .
     9273       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9274           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9275           display STREAM OutStream    with frame top-frame .
     9276       End.
     9277     End.
     9278     if c-f-cost-sum-all <>  ?  then do :
     9279       c-f-cost-sum-all:screen-value = string(p-cost-sum-all) .
     9280       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9281           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9282           display STREAM OutStream    with frame top-frame .
     9283       End.
     9284     End.
     9285     if c-f-crsa-sum-all <>  ?  then do :
     9286       c-f-crsa-sum-all:screen-value = string(p-crsa-sum-all) .
     9287       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9288           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9289           display STREAM OutStream    with frame top-frame .
     9290       End.
     9291     End.
     9292     if c-f-qnty-o <>  ?  then do :
     9293       c-f-qnty-o:screen-value = string(p-qnty-o) .
     9294       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9295           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9296           display STREAM OutStream    with frame top-frame .
     9297       End.
     9298     End.
     9299     if c-f-cost-sum-o <>  ?  then do :
     9300       c-f-cost-sum-o:screen-value = string(p-cost-sum-o) .
     9301       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9302           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9303           display STREAM OutStream    with frame top-frame .
     9304       End.
     9305     End.
     9306     if c-f-crsa-sum-o <>  ?  then do :
     9307       c-f-crsa-sum-o:screen-value = string(p-crsa-sum-o) .
     9308       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9309           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9310           display STREAM OutStream    with frame top-frame .
     9311       End.
     9312     End.
     9313           Display stream OutStream no-error.
     9314           DOWN stream OutStream .
     9315       if Make-Excel then  put   stream ForExcel unformatted
     9316             " "                             CHR(9)
     9317             " "                             CHR(9)
     9318             format-excel-text(string(v-bar-code,"999999999"))  CHR(9)
     9319             ub.gds-prt.f-name                 CHR(9)
     9320             round(p-qnty,3)                CHR(9)
     9321             round(p-cost-sum,2)            CHR(9)
     9322             round(p-sale-sum,2)            CHR(9)
     9323             round(p-sale-other,2)          CHR(9)
     9324             round(p-crsa-sum,2)            CHR(9)
     9325             round(p-qnty-all,3)            CHR(9)
     9326             round(p-cost-sum-all,2)        CHR(9)
     9327             round(p-crsa-sum-all,2)        CHR(9)
     9328             round(p-qnty-o,3)              CHR(9)
     9329             round(p-cost-sum-o,2)          CHR(9)
     9330             round(p-crsa-sum-o,2)          chr(10) .
     9331       End.
     9332       Assign
     9333         p-qnty        =  0
     9334         p-cost-sum    =  0
     9335         p-sale-sum    =  0
     9336         p-sale-other  =  0
     9337         p-crsa-sum    =  0
     9338         p-qnty-all    =  0
     9339         p-cost-sum-all = 0
     9340         p-crsa-sum-all=  0
     9341         p-qnty-o      =  0
     9342         p-cost-sum-o  =  0
     9343         p-crsa-sum-o  =  0 .
     9344   End.
     9345   End.
     9346   End.
     9347   END PROCEDURE.
     9348   PROCEDURE on-same-page :
     9349     define input parameter p-line-number as integer  no-undo .
     9350     if p-line-number > page-size( OutStream ) then do:
     9351       return .
     9352     end.
     9353     if line-counter ( OutStream ) + p-line-number > page-size ( OutStream ) then do:
     9354       page stream OutStream .
     9355     end.
     9356   end procedure.
     9357   procedure ost-line :
     9358     define input  parameter x-store-code like ub.clients.obj-code    no-undo .
     9359     define input  parameter x-store-type like ub.clients.obj-type    no-undo .
     9360     define input  parameter x-artic      like ub.stk-line.artic      no-undo .
     9361     define input  parameter x-prod-code  like ub.stk-line.prod-code  no-undo .
     9362     define input  parameter x-prod-type  like ub.stk-line.prod-type  no-undo .
     9363     define input  parameter x-tog-shift  as logical no-undo .
     9364     define input  parameter x-fact-order like ub.stk-line.fact-order no-undo .
     9365     define input  parameter x-sum-type   like ub.stk-line.sum-type   no-undo .
     9366     define input  parameter x-cat-id     like ub.stk-line.cat-id     no-undo .
     9367     define input  parameter xtog-obj     as logical no-undo .
     9368     define output parameter quantity     like ub.stk-line.fact-qnty  no-undo .
     9369     define output parameter coast_r      like ub.stk-line.sum-rubl   no-undo .
     9370     define output parameter coast_v      like ub.stk-line.sum-rubl   no-undo .
     9371     define output parameter vat_r        like ub.stk-line.sum-rubl   no-undo .
     9372     define output parameter vat_v        like ub.stk-line.sum-rubl   no-undo .
     9373     define output parameter slt_r        like ub.stk-line.sum-rubl   no-undo .
     9374     define output parameter slt_v        like ub.stk-line.sum-rubl   no-undo .
     9375     define buffer buff-obj-list  for obj-list .
     9376     define buffer buff-stk-line  for ub.stk-line .
     9377     assign
     9378       Quantity = 0
     9379       Coast_R  = 0
     9380       Coast_V  = 0
     9381       VAT_R    = 0
     9382       VAT_V    = 0
     9383       SLT_R    = 0
     9384       SLT_V    = 0
     9385     .
     9386     if  x-tog-shift = false then do:
     9387       for each buff-obj-list no-lock
     9388         where xtog-obj = false
     9389            or (buff-obj-list.obj-type = x-store-type
     9390               and buff-obj-list.obj-code = x-store-code
     9391               )
     9392       on error undo, return error
     9393       :
     9394       find last buff-stk-line no-lock
     9395         where buff-stk-line.obj-type   = buff-obj-list.obj-type
     9396           and buff-stk-line.obj-code   = buff-obj-list.obj-code
     9397           and buff-stk-line.artic      = x-artic
     9398           and buff-stk-line.prod-type  = x-prod-type
     9399           and buff-stk-line.prod-code  = x-prod-code
     9400           and buff-stk-line.sum-type   = x-sum-type
     9401           and buff-stk-line.cat-id     = '##,##':U
     9402           and buff-stk-line.fact-order <= x-fact-order
     9403           and buff-stk-line.shift-num  = 0
     9404         use-index category
     9405         no-error .
     9406       if available buff-stk-line then do:
     9407         assign
     9408           Quantity = Quantity + buff-stk-line.fact-qnty
     9409           Coast_R  = Coast_R  + buff-stk-line.sum-rubl
     9410           Coast_V  = Coast_V  + buff-stk-line.sum-base
     9411           VAT_R    = VAT_R    + buff-stk-line.VAT-rubl
     9412           VAT_V    = VAT_V    + buff-stk-line.VAT-base
     9413           SLT_R    = SLT_R    + buff-stk-line.SLT-rubl
     9414           SLT_V    = SLT_V    + buff-stk-line.SLT-base
     9415         .
     9416       end.
     9417      end.
     9418     end.
     9419     else do:
     9420       for each buff-obj-list no-lock
     9421         where xtog-obj = false
     9422            or (buff-obj-list.obj-type = x-store-type
     9423               and buff-obj-list.obj-code = x-store-code
     9424               )
     9425       on error undo, return error
     9426       :
     9427         find last buff-stk-line no-lock
     9428           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     9429             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     9430             and buff-stk-line.artic      = x-artic
     9431             and buff-stk-line.prod-type  = x-prod-type
     9432             and buff-stk-line.prod-code  = x-prod-code
     9433             and buff-stk-line.sum-type   = x-sum-type
     9434             and buff-stk-line.cat-id     = '##,##':U
     9435             and buff-stk-line.fact-order <= x-fact-order
     9436             and buff-stk-line.shift-num  > 0
     9437           use-index category
     9438           no-error .
     9439         if available buff-stk-line then do:
     9440           assign
     9441             Quantity = Quantity +  buff-stk-line.fact-qnty
     9442             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     9443             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     9444             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     9445             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     9446             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     9447             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     9448           .
     9449         end.
     9450       end.
     9451     end.
     9452   end procedure.
     9453   procedure ost-lineother-tax :
     9454     define input  parameter x-store-code like ub.clients.obj-code      no-undo.
     9455     define input  parameter x-store-type like ub.clients.obj-type      no-undo.
     9456     define input  parameter x-artic      like ub.stk-line.artic        no-undo.
     9457     define input  parameter x-prod-code  like ub.stk-line.prod-code    no-undo.
     9458     define input  parameter x-prod-type  like ub.stk-line.prod-type    no-undo.
     9459     define input  parameter x-tog-shift  as logical no-undo .
     9460     define input  parameter x-fact-order like ub.stk-line.fact-order   no-undo.
     9461     define input  parameter x-sum-type   like ub.stk-line.sum-type     no-undo.
     9462     define input  parameter x-type-id    like ub.stk-line.cat-id       no-undo.
     9463     define input  parameter xTog-obj     as logical no-undo .
     9464     define output parameter Quantity     like ub.stk-line.fact-qnty   no-undo.
     9465     define output parameter Coast_R      like ub.stk-line.sum-rubl    no-undo.
     9466     define output parameter Coast_V      like ub.stk-line.sum-rubl    no-undo.
     9467     define output parameter VAT_R        like ub.stk-line.sum-rubl    no-undo.
     9468     define output parameter VAT_V        like ub.stk-line.sum-rubl    no-undo.
     9469     define output parameter SLT_R        like ub.stk-line.sum-rubl    no-undo.
     9470     define output parameter SLT_V        like ub.stk-line.sum-rubl    no-undo.
     9471     define output parameter other_R      like ub.stk-line.sum-rubl    no-undo.
     9472     define output parameter other_V      like ub.stk-line.sum-rubl    no-undo.
     9473     define buffer buff-obj-list  for obj-list .
     9474     define buffer buff-stk-line  for ub.stk-line .
     9475     assign
     9476       Quantity = 0
     9477       Coast_R  = 0
     9478       Coast_V  = 0
     9479       VAT_R    = 0
     9480       VAT_V    = 0
     9481       SLT_R    = 0
     9482       SLT_V    = 0
     9483       other_R  = 0
     9484       other_V  = 0
     9485     .
     9486     if  x-tog-shift = false then do:
     9487       for each buff-obj-list no-lock
     9488         where xtog-obj = false
     9489            or (buff-obj-list.obj-type = x-store-type
     9490               and buff-obj-list.obj-code = x-store-code
     9491               )
     9492       on error undo, return error
     9493       :
     9494       find last buff-stk-line no-lock
     9495         where buff-stk-line.obj-type   = buff-obj-list.obj-type
     9496           and buff-stk-line.obj-code   = buff-obj-list.obj-code
     9497           and buff-stk-line.artic      = x-artic
     9498           and buff-stk-line.prod-type  = x-prod-type
     9499           and buff-stk-line.prod-code  = x-prod-code
     9500           and buff-stk-line.sum-type   = x-sum-type
     9501           and buff-stk-line.cat-id     = '##,##':U
     9502           and buff-stk-line.fact-order <= x-fact-order
     9503           and buff-stk-line.shift-num  = 0
     9504         use-index category
     9505         no-error .
     9506       if available buff-stk-line then do:
     9507         assign
     9508           Quantity = Quantity + buff-stk-line.fact-qnty
     9509           Coast_R  = Coast_R  + buff-stk-line.sum-rubl
     9510           Coast_V  = Coast_V  + buff-stk-line.sum-base
     9511           VAT_R    = VAT_R    + buff-stk-line.VAT-rubl
     9512           VAT_V    = VAT_V    + buff-stk-line.VAT-base
     9513           SLT_R    = SLT_R    + buff-stk-line.SLT-rubl
     9514           SLT_V    = SLT_V    + buff-stk-line.SLT-base
     9515           other_R  = other_R  + buff-stk-line.other-rubl
     9516           other_V  = other_V  + buff-stk-line.other-base
     9517         .
     9518       end.
     9519    end.
     9520     end.
     9521     else do:
     9522       for each buff-obj-list no-lock
     9523         where xtog-obj = false
     9524            or (buff-obj-list.obj-type = x-store-type
     9525               and buff-obj-list.obj-code = x-store-code
     9526               )
     9527       on error undo, return error
     9528       :
     9529         find last buff-stk-line no-lock
     9530           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     9531             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     9532             and buff-stk-line.artic      = x-artic
     9533             and buff-stk-line.prod-type  = x-prod-type
     9534             and buff-stk-line.prod-code  = x-prod-code
     9535             and buff-stk-line.sum-type   = x-sum-type
     9536             and buff-stk-line.cat-id     = '##,##':U
     9537             and buff-stk-line.fact-order <= x-fact-order
     9538             and buff-stk-line.shift-num  > 0
     9539           use-index category
     9540           no-error .
     9541         if available buff-stk-line then do:
     9542           assign
     9543             Quantity = Quantity +  buff-stk-line.fact-qnty
     9544             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     9545             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     9546             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     9547             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     9548             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     9549             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     9550             other_R = other_R   +  buff-stk-line.other-rubl
     9551             other_V = other_V   +  buff-stk-line.other-base
     9552           .
     9553         end.
     9554       end.
     9555     end.
     9556   end procedure.
     9557   procedure ost-line-kg :
     9558     define  input parameter p-obj-code    like ub.stk-line.obj-code   no-undo .
     9559     define  input parameter p-obj-type    like ub.stk-line.obj-type   no-undo .
     9560     define  input parameter p-artic       like ub.stk-line.artic      no-undo .
     9561     define  input parameter p-prod-code   like ub.stk-line.prod-code  no-undo .
     9562     define  input parameter p-prod-type   like ub.stk-line.prod-type  no-undo .
     9563     define  input parameter p-fact-order  like ub.stk-line.fact-order no-undo .
     9564     define output parameter p-quantity-kg like ub.stk-line.fact-qnty  no-undo initial 0.00 .
     9565     define buffer buff-obj-list  for obj-list .
     9566     define buffer buf_doc-line for ub.doc-line .
     9567     define buffer buf_inv-line for ub.inv-line .
     9568     do
     9569     on error undo, return error
     9570     :
     9571       for each buf_doc-line no-lock where
     9572                buf_doc-line.obj-type    = p-obj-type   and
     9573                buf_doc-line.obj-code    = p-obj-code   and
     9574                buf_doc-line.prod-type   = p-prod-type  and
     9575                buf_doc-line.prod-code   = p-prod-code  and
     9576                buf_doc-line.artic       = p-artic      and
     9577                buf_doc-line.status_     = 'факт':U      and
     9578                buf_doc-line.fact-order <= p-fact-order
     9579             by buf_doc-line.fact-order    descending
     9580       :
     9581         find first buf_inv-line no-lock where
     9582                    buf_inv-line.doc-code  = buf_doc-line.doc-code  and
     9583                    buf_inv-line.artic     = buf_doc-line.artic     and
     9584                    buf_inv-line.prod-type = buf_doc-line.prod-type and
     9585                    buf_inv-line.prod-code = buf_doc-line.prod-code no-error .
     9586         if available buf_inv-line
     9587         then do:
     9588           if buf_inv-line.after-cli-qnty <> ?
     9589           then do:
     9590             assign
     9591               p-quantity-kg = buf_inv-line.after-cli-qnty
     9592             .
     9593             leave .
     9594           end.
     9595         end.
     9596       end.
     9597       if p-quantity-kg = ?
     9598       then do:
     9599         assign
     9600           p-quantity-kg = 0
     9601         .
     9602       end.
     9603     end.
     9604   end procedure.
