      797   PROCEDURE ostatok :
      798   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
      799   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
      800   def input parameter x-tog-shift   as   logical             no-undo.
      801   def input parameter x-date-start  like ub.stk-tot.Fact-date   no-undo.
      802   def input parameter x-date-end    like ub.stk-tot.Fact-date   no-undo.
      803   def input parameter x-shift-start as integer               no-undo.
      804   def input parameter x-shift-end   as integer               no-undo.
      805   def input parameter x-sum-type    like ub.stk-tot.sum-type    no-undo.
      806   def input parameter x-cat-id      like ub.stk-tot.cat-id      no-undo.
      807   def input parameter xTog-obj   as log no-undo.
      808   def output parameter Quantity    like ub.stk-tot.fact-qnty   no-undo.
      809   def output parameter Coast_R     like ub.stk-tot.sum-rubl    no-undo.
      810   def output parameter Coast_V     like ub.stk-tot.sum-rubl    no-undo.
      811   def output parameter VAT_R       like ub.stk-tot.sum-rubl    no-undo.
      812   def output parameter VAT_V       like ub.stk-tot.sum-rubl    no-undo.
      813   def output parameter Fact-order  like ub.stk-tot.Fact-order  no-undo.
      814   def var              Fact-order#   like ub.stk-tot.Fact-order  no-undo.
      815   def var              Fact-orderS   as char  no-undo.
      816   def var x-date-start-t  like ub.stk-tot.shift-date   no-undo.
      817      Assign
      818         Fact-order   = 0
      819         Quantity     = 0
      820         Coast_R      = 0
      821         Coast_V      = 0
      822         VAT_R        = 0
      823         VAT_V        = 0 .
      824    x-date-start-t  = x-date-start + 1 .
      825   IF x-date-end = date('') then DO:
      826      Fact-order = 0 .
      827      for each obj-list
      828          where  ( not xtog-obj or
      829                 ( x-store-type = obj-list.obj-type and x-store-code = obj-list.obj-code ))
      830                 no-lock :
      831         if  x-tog-shift = false then do:
      832                          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
      833                               ub.stk-tot.Fact-date <=  x-date-start
      834                               and ub.stk-tot.shift-num = 0
      835                               USE-INDEX fact-date no-lock no-error .
      836              if Available ub.stk-tot THEN  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
      837         End.
      838         Else  DO :
      839             find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
      840              (ub.stk-tot.shift-date  = x-date-start-t and
      841               ub.stk-tot.shift-num  < x-shift-start or
      842               ub.stk-tot.shift-date  < x-date-start-t  )
      843               and ub.stk-tot.shift-num  > 0
      844               USE-INDEX Shift-num no-lock no-error .
      845            If Available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
      846           END.
      847       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
      848     End.
      849   End.
      850   Else DO:
      851     For each obj-list  WHERE
      852        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
      853         no-lock :
      854      IF  x-TOG-Shift = False Then DO:
      855          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
      856               ub.stk-tot.Fact-date <= x-date-end
      857               and ub.stk-tot.shift-num = 0
      858               USE-INDEX fact-date no-lock no-error.
      859          if available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
      860      END.
      861      Else DO:
      862           find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
      863               (ub.stk-tot.shift-date  = x-date-end and
      864               ub.stk-tot.shift-num  <= x-shift-end or
      865               ub.stk-tot.shift-date  < x-date-end       ) and
      866               ub.stk-tot.shift-num   > 0      use-index shift-num no-lock no-error.
      867               if Available ub.stk-tot THEN Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
      868       End.
      869       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
      870     End.
      871   End.
      872   END PROCEDURE.
      873   define temp-table temp-font no-undo
      874     field fontnum  as integer
      875     field fontname as character
      876     field fontsize as character
      877     field fonttype as character
