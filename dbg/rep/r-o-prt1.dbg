     3285           ( input  buf_doc-line.doc-code
     3286            ,input  p-obj-type
     3287            ,input  p-obj-code
     3288            ,input  buf_goods.gds-code
     3289            ,output v-total-pl-gds-qnty
     3290            ,output v-total-pl-gds-cli-qnty
     3291           ) .
     3292       end.
     3293     end.
     3294   end procedure.
     3295   function excel-format-dec-to-char returns char (input p-dec as decimal ).
     3296     if num-entries(string(p-dec), '.') = 2
     3297       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
     3298       else return( string(p-dec)) .
     3299   end function.
     3300   function format-point-to-comma returns char (input orig as char ) .
     3301   define variable rtext as character no-undo .
     3302   define variable strt as integer no-undo .
     3303   define variable leng as integer no-undo .
     3304   assign rtext = orig .
     3305   repeat:
     3306     strt =  index(rtext,'.').
     3307     if strt = 0 then leave.
     3308     leng = 1.
     3309     substring(rtext,strt,leng,"character") = v-delim .
     3310   end.
     3311   return rtext.
     3312   end function.
     3313   function format-excel-text returns char ( input start-text as char ) :
     3314   def var  i    as int no-undo.
     3315   def var  ch   as char no-undo.
     3316   def var  n    as int no-undo.
     3317   def var  ipos as int no-undo.
     3318     n = num-entries(trim(start-text), chr(10)) - 1 .
     3319     do i = 1 to n :
     3320       ipos = index( start-text, chr(10)).
     3321       if ipos > 0 then
     3322         substr( start-text, ipos, 1 ) = ' '.
     3323     end.
     3324     n = num-entries(trim(start-text), chr(13)) - 1 .
     3325     do i = 1 to n :
     3326       ipos = index( start-text, chr(13)).
     3327       if ipos > 0 then
     3328         substr( start-text, ipos, 1 ) = ' '.
     3329     end.
     3330     if index( start-text, '"' ) = 0 then
     3331       start-text =  '="'   + trim( start-text) + '"'   .
     3332       else do:
     3333         n = num-entries(trim(start-text), '"') - 1.
     3334         do i = 1 to n :
     3335           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     3336         end.
     3337         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     3338         start-text = '="'  + ch  + '"' .
     3339       end.
     3340     return start-text.
     3341   end.
     3342   function excel-sum returns char (input p-dec as decimal ).
     3343     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
     3344   end function.
     3345   function excel-qnty returns char (input p-dec as decimal ).
     3346     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
     3347   end function.
     3348   function format-excel-text-macr returns char ( input start-text as char ) :
     3349   def var  i    as int no-undo.
     3350   def var  ch   as char no-undo.
     3351   def var  n    as int no-undo.
     3352   def var  ipos as int no-undo.
     3353     n = num-entries(trim(start-text), chr(10)) - 1 .
     3354     do i = 1 to n :
     3355       ipos = index( start-text, chr(10)).
     3356       if ipos > 0 then
     3357         substring( start-text, ipos , 1 ) = ' '.
     3358     end.
     3359     n = num-entries(trim(start-text), chr(13)) - 1 .
     3360     do i = 1 to n :
     3361       ipos = index( start-text, chr(13)).
     3362       if ipos > 0 then
     3363         substring( start-text, ipos, 1 ) = ' '.
     3364     end.
     3365     if index( start-text, '"' ) = 0 then
     3366       start-text =  '"'   + trim( start-text) + '"'   .
     3367       else do:
     3368         n = num-entries(trim(start-text), '"') - 1.
     3369         do i = 1 to n :
     3370           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     3371         end.
     3372         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     3373         start-text = '"'  + ch  + '"' .
     3374       end.
     3375     n = num-entries(trim(start-text), chr(10)) - 1 .
     3376     do i = 1 to n :
     3377       ipos = index( start-text, chr(10)).
     3378       if ipos > 0 then
     3379         substring( start-text, ipos , 1 ) = ' '.
     3380     end.
     3381       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
     3382     return start-text.
     3383   end.
     3384   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3385   FUNCTION determined RETURNS DECIMAL (INPUT parundefine-var AS DECIMAL):
     3386      IF parundefine-var = ? THEN RETURN 0.00.
     3387                             ELSE RETURN parundefine-var.
     3388   END FUNCTION.
     3389   FUNCTION dtm-char RETURNS CHARACTER (INPUT p-undef-char AS CHARACTER):
     3390      IF p-undef-char = ? THEN do:
     3391        RETURN "?".
     3392      end.
     3393      ELSE do:
     3394        RETURN p-undef-char .
     3395      end.
     3396   END FUNCTION.
