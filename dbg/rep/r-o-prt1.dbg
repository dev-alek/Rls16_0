     6218       l1f-crsa-sum-all  = c-f-crsa-sum-all:DATA-TYPE
     6219       l2f-crsa-sum-all  = c-f-crsa-sum-all:FORMAT
     6220       c-f-crsa-sum-all:DATA-TYPE = "CHARACTER"
