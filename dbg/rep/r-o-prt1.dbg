     4443               assign
     4444                 f-qnty-o     = gds-obj.fact-qnty
     4445                 f-cost-sum-o = gds-obj.fact-rubl
     4446                 f-crsa-sum-o = gds-obj.fact-sale .
     4447             end.
     4448           end.
     4449             if itog = false and
     4450               not(f-qnty        = 0 and
     4451                   f-qnty-o      = 0 and
     4452                   f-cost-sum    = 0 and
     4453                   f-sale-sum    = 0 and
