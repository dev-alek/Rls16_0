     6243       l2f-crsa-sum-o  = c-f-crsa-sum-o:FORMAT
     6244       c-f-crsa-sum-o:DATA-TYPE = "CHARACTER"
     6245       c-f-crsa-sum-o:FORMAT    = "x(" + string(C-f-crsa-sum-o:WIDTH-CHARS) + ")"
     6246       c-f-crsa-sum-o:screen-value = string('')  .
     6247   End.
     6248   display stream outstream no-error .
     6249   down stream outstream .
     6250   if c-f-qnty <>  ?  then do :
     6251   Assign
     6252       c-f-qnty:DATA-TYPE = l1f-qnty
     6253       c-f-qnty:FORMAT    = l2f-qnty.
     6254   End.
     6255   if c-f-cost-sum <>  ?  then do :
     6256   Assign
     6257       c-f-cost-sum:DATA-TYPE = l1f-cost-sum
     6258       c-f-cost-sum:FORMAT    = l2f-cost-sum.
     6259   End.
     6260   if c-f-sale-sum <>  ?  then do :
     6261   Assign
     6262       c-f-sale-sum:DATA-TYPE = l1f-sale-sum
     6263       c-f-sale-sum:FORMAT    = l2f-sale-sum.
     6264   End.
