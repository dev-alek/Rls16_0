     6275   if c-f-qnty-all <>  ?  then do :
     6276   Assign
     6277       c-f-qnty-all:DATA-TYPE = l1f-qnty-all
     6278       c-f-qnty-all:FORMAT    = l2f-qnty-all.
     6279   End.
     6280   if c-f-cost-sum-all <>  ?  then do :
     6281   Assign
     6282       c-f-cost-sum-all:DATA-TYPE = l1f-cost-sum-all
     6283       c-f-cost-sum-all:FORMAT    = l2f-cost-sum-all.
     6284   End.
     6285   if c-f-crsa-sum-all <>  ?  then do :
     6286   Assign
     6287       c-f-crsa-sum-all:DATA-TYPE = l1f-crsa-sum-all
     6288       c-f-crsa-sum-all:FORMAT    = l2f-crsa-sum-all.
