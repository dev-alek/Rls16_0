     1261   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     1262   DEFINE BUTTON StopBtn AUTO-END-KEY
     1263        LABEL "Стоп"
     1264        SIZE 10 BY 1.
     1265   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     1266        LABEL "Обработано записей"
     1267         VIEW-AS TEXT
     1268        SIZE 14 BY .67 NO-UNDO.
     1269   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     1270         VIEW-AS TEXT
     1271        SIZE 53.25 BY .67
     1272        FGCOLOR 1  NO-UNDO.
     1273   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     1274         VIEW-AS TEXT
     1275        SIZE 53.25 BY .67
     1276        FGCOLOR 1  NO-UNDO.
     1277   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     1278         VIEW-AS TEXT
     1279        SIZE 53.25 BY .67
     1280        FGCOLOR 1  NO-UNDO.
     1281   DEFINE RECTANGLE RECT-1
     1282        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1283        SIZE 55.13 BY 4.46.
     1284   DEFINE FRAME InfoFrame
     1285        StopBtn AT ROW 4.25 COL 21.75
     1286        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     1287        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     1288        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     1289        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     1290        RECT-1 AT ROW 1 COL 1
     1291       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1292            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1293            TITLE "Процесс"
     1294            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     1295   define variable mFrameView      as logical   no-undo init yes.
     1296     define variable mFramHandle as handle no-undo.
     1297     mFramHandle = frame InfoFrame:handle.
     1298     if  log-manager:logfile-name ne ?
     1299     then DO:
     1300         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1301         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1302         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     1303     end.
     1304     mFrameView = not session:batch-mode and mFramHandle:visible.
     1305     if mFrameView
     1306     then do:
     1307       ASSIGN
     1308          FRAME InfoFrame:HIDDEN                           = TRUE
     1309          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     1310     end.
     1311   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     1312   DO:
     1313     IF not StopProcessing THEN
     1314       Message "Вы действительно хотите прервать" SKIP
     1315               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     1316                 UPDATE StopProcessing.
     1317     IF StopProcessing THEN do:
     1318        if mFrameView
     1319        then do:
     1320           HIDE FRAME InfoFrame.
     1321        end.
     1322     End.
     1323   END.
     1324   assign v-account = ( if integer( 100 ) = 0 then 100 else integer( 100 ) ).
     1325     if  log-manager:logfile-name ne ?
     1326     then DO:
     1327         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     1328     end.
     1329     if not session:batch-mode then
     1330     do:
     1331       VIEW FRAME InfoFrame.
     1332       mFrameView = true.
     1333     end.
