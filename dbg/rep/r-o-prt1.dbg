      320   procedure create_obj-list :
      321      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      322      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      323      do
      324      on error undo, return error return-value
      325      :
      326         define buffer cli-obj for ub.clients .
      327         define variable p-var as integer no-undo .
      328         define buffer buf_obj-list for obj-list .
      329         find last buf_obj-list  use-index pi no-error .
      330         if available buf_obj-list
      331         then
      332            p-var = buf_obj-list.obj-id + 1.
      333         else
      334            p-var = 1.
      335         find first cli-obj where
      336                   cli-obj.obj-type = p-obj-type
      337               and cli-obj.obj-code = p-obj-code
      338         no-lock no-error.
      339         if available cli-obj
      340         then do:
      341            create buf_obj-list.
      342            assign
      343               buf_obj-list.obj-id   = p-var
      344               buf_obj-list.obj-code = cli-obj.obj-code
      345               buf_obj-list.obj-type = cli-obj.obj-type
      346               buf_obj-list.obj-name = cli-obj.obj-name
      347               buf_obj-list.db-num   = cli-obj.db-num
      348            .
      349         end.
      350      end.
      351   end.
