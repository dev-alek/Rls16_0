     4127   PROCEDURE CalcItog :
     4128       run ostatok (
     4129           input x-store-code  ,
     4130           input x-store-type  , x-TOG-Shift,
     4131           input x-date-start - 1 ,
     4132           input date('')      , x-Shift-Start,x-Shift-End,
     4133           input 'crsa':U   ,
     4134           input '##,##':U,
     4135           input xTog-obj ,
     4136           output  Quantity1  ,
     4137           output  Coast_R1   ,
     4138           output  Coast_V1   ,
     4139           output  VAT_R1     ,
     4140           output  VAT_V1     ,
     4141           output  Fact-order-1 ).
     4142     for each ub.trn-doc no-lock where
     4143         ub.trn-doc.status_ = 'факт':U and
     4144         ub.trn-doc.flag_= true  and
     4145         ub.trn-doc.host-code = v-cntxt-host-code-obj
     4146         by ub.trn-doc.fact-order DESCENDING :
     4147           fact-order-2 = ub.trn-doc.fact-order  .
     4148           leave.
     4149     end.
     4150   END PROCEDURE.
