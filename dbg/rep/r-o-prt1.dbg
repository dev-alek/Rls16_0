     3540       end.
     3541       assign
     3542         varvat-pc = bf_price-list.vat-pc
     3543         varslt-pc = bf_price-list.slt-pc
     3544       .
     3545       if varvat-pc = ?
     3546       then do:
     3547         undo, return error substitute("В переоценке &1 для товара &2 &3 &4 не задан НДС",bf_price-list.doc-num,bf_price-list.artic,bf_price-list.prod-type,bf_price-list.prod-code).
     3548       end.
     3549       if varslt-pc = ?
     3550       then do:
     3551         undo, return error substitute("В переоценке &1 для товара &2 &3 &4 не задан НП",bf_price-list.doc-num,bf_price-list.artic,bf_price-list.prod-type,bf_price-list.prod-code).
     3552       end.
     3553       assign
     3554         varbase-rate   = 1
     3555         varbase-scale  = 1
     3556         varroad-tax    = bf_price-list.road-tax
     3557         varexcise      = bf_price-list.excise
