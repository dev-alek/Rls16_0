     6163       l2f-qnty  = c-f-qnty:FORMAT
     6164       c-f-qnty:DATA-TYPE = "CHARACTER"
     6165       c-f-qnty:FORMAT    = "x(" + string(C-f-qnty:WIDTH-CHARS) + ")"
     6166       c-f-qnty:screen-value = string('')  .
