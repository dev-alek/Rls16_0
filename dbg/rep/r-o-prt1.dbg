     2315               ,output price-rubl-without-tax-sale-prl
     2316               ,output price-base-without-tax-sale-prl
     2317               ,output vat-base-sale-prl
     2318               ,output vat-rubl-sale-prl
     2319               ,output vat-base-buyer-prl
     2320               ,output vat-rubl-buyer-prl
     2321               ,output slt-base-sale-prl
