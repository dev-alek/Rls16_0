     3697          and out-vatp_doc-lineprl.artic      = varartic
     3698          and out-vatp_doc-lineprl.prod-type  = varprod-type
     3699          and out-vatp_doc-lineprl.prod-code  = varprod-code no-lock no-error.
     3700   if available out-vatp_doc-lineprl           and
