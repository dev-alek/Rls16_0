     5434   END PROCEDURE.
     5435   PROCEDURE foreach3 :
     5436   for each obj-list no-lock with frame zapas :
     5437   if not( classify = 1 and itog = true) then do:
     5438     if c-f-gds-name <>  ?  then do :
     5439       c-f-gds-name:screen-value = string(obj-list.obj-name) .
     5440       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     5441           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     5442           display STREAM OutStream    with frame top-frame .
     5443       End.
     5444     End.
     5445   if c-f-qnty <>  ?  then do :
     5446   Assign
     5447       l1f-qnty  = c-f-qnty:DATA-TYPE
     5448       l2f-qnty  = c-f-qnty:FORMAT
     5449       c-f-qnty:DATA-TYPE = "CHARACTER"
     5450       c-f-qnty:FORMAT    = "x(" + string(C-f-qnty:WIDTH-CHARS) + ")"
     5451       c-f-qnty:screen-value = string('')  .
     5452   End.
     5453   if c-f-cost-sum <>  ?  then do :
