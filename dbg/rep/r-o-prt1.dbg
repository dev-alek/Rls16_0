     8648       c-f-crsa-sum-o:FORMAT    = l2f-crsa-sum-o.
     8649   End.
     8650   if Make-Excel then  put   stream ForExcel unformatted  obj-list.obj-name chr(10).
     8651     n-nn = 0.
     8652     n-no = n-no + 1 .
     8653    for each gds-obj where
     8654             gds-obj.obj-code    = obj-list.obj-code and
     8655             gds-obj.obj-type    = obj-list.obj-type
     8656             and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     8657             no-lock,
     8658             first goods where   goods.gds-code    = gds-obj.gds-code  and
     8659                                 goods.gds-type    = 'т':U
     8660                                 no-lock
     8661             , first gds-list where   gds-list.prod-type = gds-obj.prod-type and
     8662                                      gds-list.prod-code = gds-obj.prod-code and
     8663                                      gds-list.artic     = gds-obj.artic     :
     8664        gds-list.qnty = (func-vat(gds-obj.gds-code,gds-obj.obj-type,gds-obj.obj-code)) .
     8665     end.
     8666    For Each gds-obj where
     8667             gds-obj.obj-code    = obj-list.obj-code and
     8668             gds-obj.obj-type    = obj-list.obj-type
     8669             and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     8670             no-lock,
     8671             first goods where   goods.gds-code    = gds-obj.gds-code  and
     8672                                 goods.gds-type    = 'т':U
     8673                                 no-lock
     8674             , First gds-list where   gds-list.prod-type = gds-obj.prod-type and
     8675                                      gds-list.prod-code = gds-obj.prod-code and
     8676                                      gds-list.artic     = gds-obj.artic
     8677               break
     8678                   by gds-list.qnty
     8679                   by ( gds-obj.artic + gds-obj.prod-type + string ( gds-obj.prod-code ))
     8680                   by gds-obj.artic
     8681                   with FRAME Zapas :
     8682                IF first-of(gds-obj.artic) then DO:
     8683                   assign
     8684                     f-qnty         = 0
     8685                     f-cost-sum     = 0
     8686                     f-sale-sum     = 0
     8687                     f-sale-other   = 0
     8688                     f-crsa-sum     = 0
     8689                     f-qnty-all     = 0
     8690                     f-cost-sum-all = 0
     8691                     f-crsa-sum-all = 0
     8692                     f-qnty-o       = 0
     8693                     f-cost-sum-o   = 0
     8694                     f-crsa-sum-o   = 0.
     8695                 For Each temp-doc-code  : delete temp-doc-code . end.
     8696                 For Each ub.ot-line where
     8697                           ub.ot-line.fact-order <= fact-order-2 and
     8698                           ub.ot-line.fact-order >= fact-order-1 and
     8699                           ub.ot-line.obj-code    = obj-list.obj-code and
     8700                           ub.ot-line.obj-type    = obj-list.obj-type  and
     8701                           ub.ot-line.artic     = gds-obj.artic  and
     8702                           ub.ot-line.prod-type = gds-obj.prod-type and
     8703                           ub.ot-line.prod-code = gds-obj.prod-code and
     8704                           (ub.ot-line.sum-type = 'sale':U OR
     8705                             ub.ot-line.sum-type = 'crsa':U OR
     8706                             ub.ot-line.sum-type = 'cost':U ) no-lock :
     8707                       run in-proc.
     8708                 End.
     8709               End.
     8710             if first-of(gds-list.qnty) then DO:
     8711                var-client = string(gds-list.qnty) + '%'.
     8712                     if  Itog = false Then do:
     8713     if c-f-gds-name <>  ?  then do :
     8714       c-f-gds-name:screen-value = string('Ставка НДС ' + string(gds-list.qnty) + '%') .
     8715       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8716           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8717           display STREAM OutStream    with frame top-frame .
     8718       End.
     8719     End.
     8720                       Display stream OutStream .
     8721                       DOWN stream OutStream .
     8722                       if Make-Excel then  put   stream ForExcel unformatted 'Ставка НДС ' + string(gds-list.qnty) + '%' chr(10) .
     8723                     End.
     8724             End.
     8725             if last-of(gds-obj.artic) then DO:
     8726             run last-of-artic.
     8727                 accumulate f-qnty           (TOTAL  by gds-list.qnty ) .
     8728                 accumulate f-cost-sum       (TOTAL  by gds-list.qnty ) .
     8729                 accumulate f-sale-sum       (TOTAL  by gds-list.qnty ) .
     8730                 accumulate f-sale-other     (TOTAL  by gds-list.qnty ) .
     8731                 accumulate f-crsa-sum       (TOTAL  by gds-list.qnty ) .
     8732                 accumulate f-qnty-all       (TOTAL  by gds-list.qnty ) .
     8733                 accumulate f-cost-sum-all   (TOTAL  by gds-list.qnty ) .
     8734                 accumulate f-crsa-sum-all   (TOTAL  by gds-list.qnty ) .
     8735                 accumulate f-qnty-o         (TOTAL  by gds-list.qnty ) .
     8736                 accumulate f-cost-sum-o     (TOTAL  by gds-list.qnty ) .
     8737                 accumulate f-crsa-sum-o     (TOTAL  by gds-list.qnty ) .
     8738                   Assign
     8739                     f-qnty          = 0
     8740                     f-crsa-sum      = 0
     8741                     f-qnty          = 0
     8742                     f-cost-sum      = 0
     8743                     f-sale-sum      = 0
     8744                     f-sale-other    = 0
     8745                     f-crsa-sum      = 0
     8746                     f-qnty-all      = 0
     8747                     f-cost-sum-all  = 0
     8748                     f-crsa-sum-all  = 0
     8749                     f-qnty-o        = 0
     8750                     f-cost-sum-o    = 0
     8751                     f-crsa-sum-o    = 0
     8752                    .
     8753             End.
     8754             if last-of(gds-list.qnty)  then do :
     8755               f-artic = 'по ставке НДС ' .
     8756     if c-nn <>  ?  then do :
     8757       c-nn:screen-value = string('Итого') .
     8758       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8759           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8760           display STREAM OutStream    with frame top-frame .
     8761       End.
     8762     End.
     8763     if c-f-artic <>  ?  then do :
     8764       c-f-artic:screen-value = string(f-artic) .
     8765       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8766           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8767           display STREAM OutStream    with frame top-frame .
     8768       End.
     8769     End.
     8770     if c-f-gds-name <>  ?  then do :
     8771       c-f-gds-name:screen-value = string(var-client) .
     8772       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8773           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8774           display STREAM OutStream    with frame top-frame .
     8775       End.
     8776     End.
     8777     if c-f-qnty <>  ?  then do :
     8778       c-f-qnty:screen-value = string(accum TOTAL by gds-list.qnty f-qnty    ) .
     8779       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8780           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8781           display STREAM OutStream    with frame top-frame .
     8782       End.
     8783     End.
     8784     if c-f-cost-sum <>  ?  then do :
     8785       c-f-cost-sum:screen-value = string(accum TOTAL by gds-list.qnty f-cost-sum ) .
     8786       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8787           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8788           display STREAM OutStream    with frame top-frame .
     8789       End.
     8790     End.
     8791     if c-f-sale-sum <>  ?  then do :
     8792       c-f-sale-sum:screen-value = string(accum TOTAL  by gds-list.qnty  f-sale-sum) .
