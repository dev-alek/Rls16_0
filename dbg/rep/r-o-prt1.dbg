     4418               f-crsa-sum-o   = if tprintrubl then coast_r1 else coast_v1
     4419               .
     4420               run ost-line in this-procedure
     4421               (input   gds-obj.obj-code  ,
     4422               input   gds-obj.obj-type  ,
