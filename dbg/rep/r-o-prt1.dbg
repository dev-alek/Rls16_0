     1494     define variable v-gds-code             like ub.goods.gds-code    no-undo .
     1495     define variable v-root-node            like ub.prt-obj.prt-code  no-undo .
     1496     define variable v-root-b-code          like ub.bar-code.b-code   no-undo .
     1497     define variable v-total-term-fact-qnty like ub.prt-obj.fact-qnty no-undo .
     1498     define variable v-total-fact-sale      like ub.gds-obj.fact-sale no-undo .
     1499     define variable v-doc-num     like ub.price-list.doc-num    no-undo .
     1500     define variable v-price-sale  like ub.price-list.price-sale no-undo .
     1501     define variable v-road-tax    like ub.price-list.road-tax   no-undo .
     1502     define variable v-excise      like ub.price-list.excise     no-undo .
     1503     do
     1504     on error undo, return error return-value
     1505     :
     1506   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1507   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
     1508     (input  p-artic
     1509     ,input  p-prod-type
     1510     ,input  p-prod-code
     1511     ,output v-root-node
     1512     )  .
     1513   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1514   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdscr in g#library
     1515     (input  p-obj-type
     1516     ,input  p-obj-code
     1517     ,input  p-artic
