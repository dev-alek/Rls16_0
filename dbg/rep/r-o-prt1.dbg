     5456       l2f-cost-sum  = c-f-cost-sum:FORMAT
     5457       c-f-cost-sum:DATA-TYPE = "CHARACTER"
     5458       c-f-cost-sum:FORMAT    = "x(" + string(C-f-cost-sum:WIDTH-CHARS) + ")"
     5459       c-f-cost-sum:screen-value = string('')  .
     5460   End.
     5461   if c-f-sale-sum <>  ?  then do :
