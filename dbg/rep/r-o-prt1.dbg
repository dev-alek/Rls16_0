     6290   if c-f-qnty-o <>  ?  then do :
     6291   Assign
     6292       c-f-qnty-o:DATA-TYPE = l1f-qnty-o
     6293       c-f-qnty-o:FORMAT    = l2f-qnty-o.
     6294   End.
     6295   if c-f-cost-sum-o <>  ?  then do :
     6296   Assign
     6297       c-f-cost-sum-o:DATA-TYPE = l1f-cost-sum-o
     6298       c-f-cost-sum-o:FORMAT    = l2f-cost-sum-o.
     6299   End.
     6300   if c-f-crsa-sum-o <>  ?  then do :
     6301   Assign
     6302       c-f-crsa-sum-o:DATA-TYPE = l1f-crsa-sum-o
     6303       c-f-crsa-sum-o:FORMAT    = l2f-crsa-sum-o.
     6304   End.
     6305   if Make-Excel then  put   stream ForExcel unformatted  obj-list.obj-name chr(10).
     6306   end.
     6307         n-nn = 0.
     6308         n-no = n-no + 1 .
     6309   for each ub.ot-line where
     6310         ub.ot-line.fact-order <= fact-order-2 and
     6311         ub.ot-line.fact-order >= fact-order-1 and
     6312         ub.ot-line.obj-code    = obj-list.obj-code and
     6313         ub.ot-line.obj-type    = obj-list.obj-type  and
     6314         ( ub.ot-line.sum-type = 'sale':U or
     6315           ub.ot-line.sum-type = 'crsa':U or
     6316           ub.ot-line.sum-type = 'cost':U )
     6317           no-lock ,
     6318         first goods where
     6319               goods.prod-type  = ub.ot-line.prod-type and
     6320               goods.prod-code  = ub.ot-line.prod-code and
     6321               goods.artic      = ub.ot-line.artic     and
     6322               goods.gds-type   = 'т':U
     6323               no-lock ,
     6324          first gds-list where  gds-list.prod-type  = ub.ot-line.prod-type and
     6325                                 gds-list.prod-code = ub.ot-line.prod-code and
     6326                                 gds-list.artic     = ub.ot-line.artic
     6327           break
     6328               by  gds-list.qnty
     6329               by ( ub.ot-line.artic + ub.ot-line.prod-type + string ( ub.ot-line.prod-code ))
     6330               by ub.ot-line.artic
     6331               with frame zapas :
     6332              n-nm = n-nm + 1.
     6333           if first-of(ub.ot-line.artic) then do:
     6334               assign
     6335                 f-qnty         = 0
     6336                 f-cost-sum     = 0
     6337                 f-sale-sum     = 0
     6338                 f-sale-other   = 0
     6339                 f-crsa-sum     = 0
     6340                 f-qnty-all     = 0
     6341                 f-cost-sum-all = 0
     6342                 f-crsa-sum-all = 0
     6343                 f-qnty-o       = 0
     6344                 f-cost-sum-o   = 0
     6345                 f-crsa-sum-o   = 0.
     6346               for each temp-doc-code  : delete temp-doc-code . end.
     6347               for each temp-doc-code-all  : delete temp-doc-code-all . end.
     6348           end.
     6349           if can-find( first tdedt where  ub.ot-line.ext-doc-type = tdedt.id no-lock ) then do:
     6350               case  ub.ot-line.sum-type :
     6351                   when 'cost':U then do:
     6352                       f-cost-sum = f-cost-sum + ub.ot-line.sum-rubl .
     6353                   end.
     6354                   when 'sale':U then do:
     6355                       f-sale-sum   = f-sale-sum   +  ub.ot-line.sum-rubl .
     6356                       f-sale-other = f-sale-other + ub.ot-line.other-rubl .
     6357                   end.
     6358                   when  'crsa':U then do:
     6359                       f-crsa-sum = f-crsa-sum + ub.ot-line.sum-rubl  .
     6360                       f-qnty     = f-qnty     + ub.ot-line.fact-qnty .
     6361                       if itog = false then do:
     6362                           create temp-doc-code .
     6363                           assign
     6364                               temp-doc-code.doc-code     = ub.ot-line.doc-code
     6365                               temp-doc-code.ext-doc-type = ub.ot-line.ext-doc-type
     6366                               temp-doc-code.si  = if  ub.ot-line.fact-qnty < 0 then -1 else 1
     6367                               temp-doc-code.si2 = if  ub.ot-line.other-rubl < 0 then -1 else 1
     6368                               .
     6369                       end.
     6370                   end.
     6371               end case.
     6372             end.
     6373               case  ub.ot-line.sum-type :
     6374                   when 'cost':U then do:
     6375                     f-cost-sum-all = f-cost-sum-all + ub.ot-line.sum-rubl .
     6376                   end.
     6377                   when  'crsa':U then do:
     6378                     f-crsa-sum-all = f-crsa-sum-all + ub.ot-line.sum-rubl  .
     6379                     f-qnty-all     = f-qnty-all     + ub.ot-line.fact-qnty .
     6380                   end.
     6381               end case.
     6382               create temp-doc-code-all .
     6383               assign
     6384                   temp-doc-code-all.doc-code = ub.ot-line.doc-code
     6385                   temp-doc-code-all.ext-doc-type = ub.ot-line.ext-doc-type
     6386                   temp-doc-code-all.si  = if  ub.ot-line.fact-qnty < 0 then -1 else 1
     6387                   temp-doc-code-all.si2 = if  ub.ot-line.other-rubl < 0 then -1 else 1
     6388                   .
     6389         if first-of(gds-list.qnty) then do:
     6390             var-client = string(gds-list.qnty) + '%'.
     6391                 if  itog = false then do:
     6392     if c-f-gds-name <>  ?  then do :
     6393       c-f-gds-name:screen-value = string('Ставка НДС ' + string(gds-list.qnty) + '%') .
     6394       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     6395           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     6396           display STREAM OutStream    with frame top-frame .
     6397       End.
     6398     End.
     6399                   display stream outstream .
     6400                   down stream outstream .
     6401                   if Make-Excel then  put   stream ForExcel unformatted 'Ставка НДС ' + string(gds-list.qnty) + '%' chr(10) .
     6402                 end.
     6403         end.
     6404         if last-of(ub.ot-line.artic) then do:
     6405             find first gds-obj where  ub.ot-line.prod-type = gds-obj.prod-type and
     6406                                       ub.ot-line.prod-code = gds-obj.prod-code and
     6407                                       ub.ot-line.artic     = gds-obj.artic and
     6408                                       ub.ot-line.obj-code  = gds-obj.obj-code and
     6409                                       ub.ot-line.obj-type  = gds-obj.obj-type
     6410                                       no-lock no-error .
     6411           if avail gds-obj then do:
     6412             if v-var = "no-today" then do:
     6413               run ost-line in this-procedure
     6414               (input   gds-obj.obj-code  ,
     6415               input   gds-obj.obj-type  ,
     6416               input   gds-obj.artic     ,
     6417               input   gds-obj.prod-code ,
     6418               input   gds-obj.prod-type ,
     6419               input   0                 ,
     6420               input   fact-order-2      ,
     6421               input   'crsa':U       ,
     6422               input   '##,##':U    ,
     6423               input   yes      ,
     6424               output  quantity1   ,
     6425               output  coast_r1  ,
     6426               output  coast_v1  ,
     6427               output  vat_r1    ,
     6428               output  vat_v1    ,
     6429               output  slt_r1    ,
     6430               output  slt_v1     ).
     6431             assign
     6432               f-qnty-o       = quantity1
     6433               f-crsa-sum-o   = if tprintrubl then coast_r1 else coast_v1
     6434               .
     6435               run ost-line in this-procedure
     6436               (input   gds-obj.obj-code  ,
     6437               input   gds-obj.obj-type  ,
     6438               input   gds-obj.artic     ,
     6439               input   gds-obj.prod-code ,
     6440               input   gds-obj.prod-type ,
     6441               input   0                 ,
     6442               input   fact-order-2      ,
     6443               input   'cost':U       ,
     6444               input   '##,##':U    ,
     6445               input   yes      ,
     6446               output  quantity1   ,
     6447               output  coast_r1  ,
     6448               output  coast_v1  ,
     6449               output  vat_r1    ,
     6450               output  vat_v1    ,
     6451               output  slt_r1    ,
     6452               output  slt_v1    ).
     6453             assign
     6454               f-cost-sum-o   = if tprintrubl then coast_r1 else coast_v1
     6455               .
     6456             end.
     6457             else do:
     6458               assign
     6459                 f-qnty-o     = gds-obj.fact-qnty
     6460                 f-cost-sum-o = gds-obj.fact-rubl
     6461                 f-crsa-sum-o = gds-obj.fact-sale .
     6462             end.
     6463           end.
     6464             if itog = false and
     6465               not(f-qnty        = 0 and
     6466                   f-qnty-o      = 0 and
     6467                   f-cost-sum    = 0 and
     6468                   f-sale-sum    = 0 and
     6469                   f-sale-other  = 0 and
     6470                   f-crsa-sum    = 0 and
     6471                   f-qnty-all    = 0 and
     6472                   f-cost-sum-all =0 and
     6473                   f-crsa-sum-all =0      )
