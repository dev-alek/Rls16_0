     6112       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     6113           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     6114           display STREAM OutStream    with frame top-frame .
     6115       End.
     6116     End.
     6117       display stream outstream with frame zapas no-error .
     6118       down stream outstream with frame zapas.
     6119     run u-line.
     6120         if Make-Excel then  put   stream ForExcel unformatted
     6121         "ИТОГО"                       CHR(9)
     6122         "ПО ВСЕМ ОБЬЕКТАМ"            CHR(9)     CHR(9)
     6123         excel-qnty(accum total f-qnty           )   CHR(9)
     6124         excel-sum (accum total f-cost-sum       )   CHR(9)
     6125         excel-sum (accum total f-sale-sum       )   CHR(9)
     6126         excel-sum (accum total f-sale-other     )   CHR(9)
     6127         excel-sum (accum total f-crsa-sum       )   CHR(9)
     6128         excel-sum (accum total f-qnty-all       )   CHR(9)
     6129         excel-sum (accum total f-cost-sum-all   )   CHR(9)
     6130         excel-sum (accum total f-crsa-sum-all   )   CHR(9)
     6131         excel-sum (accum total f-qnty-o         )   CHR(9)
     6132         excel-sum (accum total f-cost-sum-o     )   CHR(9)
     6133         excel-sum (accum total f-crsa-sum-o     )   chr(10) .
     6134   end.
     6135   END PROCEDURE.
     6136   PROCEDURE foreach4 :
     6137   for each obj-list no-lock with frame zapas :
     6138       for each gds-obj where
     6139                gds-obj.obj-code    = obj-list.obj-code and
     6140                gds-obj.obj-type    = obj-list.obj-type
     6141                and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     6142                no-lock,
     6143                first goods where   goods.gds-code    = gds-obj.gds-code  and
     6144                                    goods.gds-type    = 'т':U
     6145                no-lock ,
     6146                first gds-list where   gds-list.prod-type = gds-obj.prod-type and
     6147                                       gds-list.prod-code = gds-obj.prod-code and
     6148                                       gds-list.artic     = gds-obj.artic
     6149           :
     6150           gds-list.qnty = (func-vat(gds-obj.gds-code,gds-obj.obj-type,gds-obj.obj-code)) .
     6151         end.
     6152   if not( classify = 1 and itog = true) then do:
     6153     if c-f-gds-name <>  ?  then do :
     6154       c-f-gds-name:screen-value = string(obj-list.obj-name) .
     6155       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     6156           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     6157           display STREAM OutStream    with frame top-frame .
     6158       End.
     6159     End.
     6160   if c-f-qnty <>  ?  then do :
     6161   Assign
