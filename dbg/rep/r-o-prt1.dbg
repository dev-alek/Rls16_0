     9733   procedure init-p2:
     9734   run cur-time in this-procedure ( output v-today
     9735                                  , output x-time
     9736                                  ).
     9737   find last ub.ot-tot  no-lock use-index pi .
     9738   if avail  ub.ot-tot then fix-doc-code = ub.ot-tot.doc-code.
     9739                    else fix-doc-code = "".
     9740      FIND first ub.clients where x-store-type = ub.clients.obj-type AND
     9741               x-store-code = ub.clients.obj-code no-lock no-error.
     9742              If available ub.clients then  ObjName = ub.clients.obj-name.
     9743                                            else  ObjName="объект не определен".
     9744        assign
     9745           i=0
     9746           startdate     = x-date-start
     9747           enddate       = x-date-end
     9748           PayType       = x-SET_PAY_TYPE
     9749           v-var         = string("")
     9750           ValType       = IF (PayType = 1) Then 0  else x-SET_val_TYPE.
     9751           Find first ub.gds-prt where ub.gds-prt.node-name = '_Пустая шкала':U no-lock no-error.
     9752           If available  ub.gds-prt then   Prtroot = ub.gds-prt.prt-root.
     9753                                 Else   Prtroot = 0.
     9754     end procedure.
     9755   procedure in-proc:
     9756     if can-find( first tdedt where  ub.ot-line.ext-doc-type = tdedt.id no-lock ) then DO:
     9757         Case  ub.ot-line.sum-type :
     9758             When 'cost':U then do:
     9759                 f-cost-sum = f-cost-sum + ub.ot-line.sum-rubl .
     9760             End.
     9761             When 'sale':U then do:
     9762                 f-sale-sum   = f-sale-sum   +  ub.ot-line.sum-rubl .
     9763                 f-sale-other = f-sale-other + ub.ot-line.other-rubl .
     9764             End.
     9765             When  'crsa':U then do:
     9766                 f-crsa-sum = f-crsa-sum + ub.ot-line.sum-rubl  .
     9767                 f-qnty     = f-qnty     + ub.ot-line.fact-qnty .
     9768                 IF itog = false then do:
     9769                     Create temp-doc-code .
     9770                     Assign
     9771                       temp-doc-code.doc-code = ub.ot-line.doc-code
     9772                       temp-doc-code.ext-doc-type = ub.ot-line.ext-doc-type
     9773                    .
     9774                 End.
     9775             End.
     9776         End case.
     9777       End.
     9778         Case  ub.ot-line.sum-type :
     9779             when 'cost':U then do:
     9780               f-cost-sum-all = f-cost-sum-all + ub.ot-line.sum-rubl .
     9781             end.
     9782             when  'crsa':U then do:
     9783               f-crsa-sum-all = f-crsa-sum-all + ub.ot-line.sum-rubl  .
     9784               f-qnty-all     = f-qnty-all     + ub.ot-line.fact-qnty .
     9785             end.
     9786         End case.
     9787     end procedure.
     9788   procedure last-of-artic :
     9789           n-nm = n-nm + 1.
     9790           Assign
     9791             f-qnty-o     = gds-obj.fact-qnty
     9792             f-cost-sum-o = gds-obj.fact-rubl
     9793             f-crsa-sum-o = gds-obj.fact-sale.
     9794           if itog = false and
     9795             ( x-zero  or
     9796             not(f-qnty        = 0 and
     9797                 f-cost-sum    = 0 and
     9798                 f-sale-sum    = 0 and
     9799                 f-sale-other  = 0 and
     9800                 f-crsa-sum    = 0 and
     9801                 f-qnty-all    = 0 and
     9802                 f-cost-sum-all =0 and
     9803                 f-crsa-sum-all =0 and
     9804                 f-qnty-o       =0 and
     9805                 f-cost-sum-o   =0 and
     9806                 f-crsa-sum-o   =0 ))
     9807             Then DO:
     9808             if x-zero = true and v-show-all-goods = false and
     9809                (f-qnty        = 0 and
     9810                 f-cost-sum    = 0 and
     9811                 f-sale-sum    = 0 and
     9812                 f-sale-other  = 0 and
     9813                 f-crsa-sum    = 0 and
     9814                 f-qnty-all    = 0 and
     9815                 f-cost-sum-all =0 and
     9816                 f-crsa-sum-all =0 and
     9817                 f-qnty-o       =0 and
     9818                 f-cost-sum-o   =0 and
     9819                 f-crsa-sum-o   =0 ) then next.
     9820                 n-nn = n-nn + 1 .
     9821   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
