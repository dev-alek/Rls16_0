     5496       l2f-cost-sum-all  = c-f-cost-sum-all:FORMAT
     5497       c-f-cost-sum-all:DATA-TYPE = "CHARACTER"
     5498       c-f-cost-sum-all:FORMAT    = "x(" + string(C-f-cost-sum-all:WIDTH-CHARS) + ")"
     5499       c-f-cost-sum-all:screen-value = string('')  .
     5500   End.
     5501   if c-f-crsa-sum-all <>  ?  then do :
     5502   Assign
     5503       l1f-crsa-sum-all  = c-f-crsa-sum-all:DATA-TYPE
     5504       l2f-crsa-sum-all  = c-f-crsa-sum-all:FORMAT
     5505       c-f-crsa-sum-all:DATA-TYPE = "CHARACTER"
     5506       c-f-crsa-sum-all:FORMAT    = "x(" + string(C-f-crsa-sum-all:WIDTH-CHARS) + ")"
     5507       c-f-crsa-sum-all:screen-value = string('')  .
