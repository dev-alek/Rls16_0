     4308         n-nn = 0.
     4309         n-no = n-no + 1 .
     4310   for each ub.ot-line where
     4311         ub.ot-line.fact-order <= fact-order-2 and
     4312         ub.ot-line.fact-order >= fact-order-1 and
     4313         ub.ot-line.obj-code    = obj-list.obj-code and
     4314         ub.ot-line.obj-type    = obj-list.obj-type  and
     4315         ( ub.ot-line.sum-type = 'sale':U or
     4316           ub.ot-line.sum-type = 'crsa':U or
     4317           ub.ot-line.sum-type = 'cost':U )
     4318           no-lock ,
     4319         first goods where
     4320               goods.prod-type  = ub.ot-line.prod-type and
     4321               goods.prod-code  = ub.ot-line.prod-code and
     4322               goods.artic      = ub.ot-line.artic     and
     4323               goods.gds-type   = 'т':U
     4324               no-lock ,
     4325          first gds-list where  gds-list.prod-type  = ub.ot-line.prod-type and
     4326                                 gds-list.prod-code = ub.ot-line.prod-code and
     4327                                 gds-list.artic     = ub.ot-line.artic
     4328           break
     4329               by ( ub.ot-line.artic + ub.ot-line.prod-type + string ( ub.ot-line.prod-code ))
     4330               by ub.ot-line.prod-type by ub.ot-line.prod-code by ub.ot-line.artic
     4331               with frame zapas :
     4332              n-nm = n-nm + 1.
     4333           if first-of(ub.ot-line.artic) then do:
     4334               assign
     4335                 f-qnty         = 0
     4336                 f-cost-sum     = 0
     4337                 f-sale-sum     = 0
     4338                 f-sale-other   = 0
     4339                 f-crsa-sum     = 0
     4340                 f-qnty-all     = 0
     4341                 f-cost-sum-all = 0
     4342                 f-crsa-sum-all = 0
     4343                 f-qnty-o       = 0
     4344                 f-cost-sum-o   = 0
     4345                 f-crsa-sum-o   = 0.
     4346               for each temp-doc-code  : delete temp-doc-code . end.
     4347               for each temp-doc-code-all  : delete temp-doc-code-all . end.
     4348           end.
     4349           if can-find( first tdedt where  ub.ot-line.ext-doc-type = tdedt.id no-lock ) then do:
     4350               case  ub.ot-line.sum-type :
     4351                   when 'cost':U then do:
     4352                       f-cost-sum = f-cost-sum + ub.ot-line.sum-rubl .
     4353                   end.
     4354                   when 'sale':U then do:
     4355                       f-sale-sum   = f-sale-sum   +  ub.ot-line.sum-rubl .
     4356                       f-sale-other = f-sale-other + ub.ot-line.other-rubl .
     4357                   end.
     4358                   when  'crsa':U then do:
     4359                       f-crsa-sum = f-crsa-sum + ub.ot-line.sum-rubl  .
     4360                       f-qnty     = f-qnty     + ub.ot-line.fact-qnty .
     4361                       if itog = false then do:
     4362                           create temp-doc-code .
     4363                           assign
     4364                               temp-doc-code.doc-code     = ub.ot-line.doc-code
     4365                               temp-doc-code.ext-doc-type = ub.ot-line.ext-doc-type
     4366                               temp-doc-code.si  = if  ub.ot-line.fact-qnty < 0 then -1 else 1
     4367                               temp-doc-code.si2 = if  ub.ot-line.other-rubl < 0 then -1 else 1
     4368                               .
     4369                       end.
     4370                   end.
     4371               end case.
     4372             end.
     4373               case  ub.ot-line.sum-type :
     4374                   when 'cost':U then do:
