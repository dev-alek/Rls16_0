     5464       l2f-sale-sum  = c-f-sale-sum:FORMAT
     5465       c-f-sale-sum:DATA-TYPE = "CHARACTER"
     5466       c-f-sale-sum:FORMAT    = "x(" + string(C-f-sale-sum:WIDTH-CHARS) + ")"
     5467       c-f-sale-sum:screen-value = string('')  .
