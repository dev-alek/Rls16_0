      715               when 'chkgdsfi':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Товарная строка чека - доп поля"     p-tooltip = "Товарная строка чека - доп поля "     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      716               when 'chkdocfi':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Чек - доп поля"     p-tooltip = "Чек - доп поля"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      717               when 'barcodfi':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Бар-код - доп поля"     p-tooltip = "Бар-код - доп поля"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      718                when 'UPD':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Настройки справочника Электронного документоборота"     p-tooltip = "Настройки справочника Электронного документоборота"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      719               when 'LK_RECEIPT':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Настройки справочника документов Вывода из оборота (ОСУ)"     p-tooltip = "Настройки справочника документов Вывода из оборота (ОСУ)"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      720         otherwise do:
      721           undo, return error "неизвестная настройка пользователя usr-flt" + " " + p-code .
      722         end.
      723       end CASE.
      724     end.
      725   end procedure.
      726   procedure uf-get :
      727     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      728     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
      729     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
      730     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
      731     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      732     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      733     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
      734     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
      735     do
      736     on error undo, return error
      737     :
      738       define buffer buf_usr-flt for ubflt.usr-flt .
      739       define variable v-use-List_     as logical   no-undo .
      740       define variable v-type-List_     as character no-undo .
      741       define variable v-format-List_   as character no-undo .
      742       define variable v-use-Naim      as logical   no-undo .
      743       define variable v-type-Naim      as character no-undo .
      744       define variable v-format-Naim    as character no-undo .
      745       define variable v-use-print-graft as logical   no-undo .
      746       define variable v-use-sort-gr     as logical   no-undo .
      747       define variable v-use-type-price  as logical   no-undo .
      748       define variable v-use-type-val    as logical   no-undo .
      749       define variable v-label          as character no-undo .
      750       define variable v-tooltip        as character no-undo .
      751       define variable v-user-can-edit  as logical   no-undo .
      752       define variable v-output-display as logical   no-undo .
      753       define variable v-other          as character no-undo .
      754       run uf-name in this-procedure
      755          (input  entry(1, p-code, chr(4))
      756         ,output v-use-List_
      757         ,output v-type-List_
      758         ,output v-format-List_
      759         ,output v-use-Naim
      760         ,output v-type-Naim
      761         ,output v-format-Naim
      762         ,output v-use-print-graft
      763         ,output v-use-sort-gr
      764         ,output v-use-type-price
      765         ,output v-use-type-val
      766         ,output v-label
      767         ,output v-tooltip
      768         ,output v-user-can-edit
      769         ,output v-output-display
      770         ,output v-other
      771         ) no-error .
      772       if error-status :error then do:
      773         undo, return error return-value .
      774       end.
      775       find first buf_usr-flt no-lock where
      776                  buf_usr-flt.Call-point     = p-code AND
      777                  buf_usr-flt.user-name       = p-user-name
      778         no-error .
      779       if avail buf_usr-flt then do:
      780         assign
      781         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
      782         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
      783         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
      784         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
      785         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
      786         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
      787         .
      788       end.
      789       else do:
      790         assign
      791         p-List_        = (if v-use-List_       then "":U                    else ?)
      792         p-Naim         = (if v-use-Naim        then "":U                    else ?)
      793         p-print-graft  = (if v-use-print-graft then no                      else ?)
      794         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
      795         p-type-price   = (if v-use-type-price  then no                      else ?)
      796         p-type-val     = (if v-use-List_       then no                      else ?)
      797         .
      798       end.
      799     end.
      800   end procedure.
      801   procedure uf-set :
      802     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      803     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
      804     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
      805     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
      806     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      807     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      808     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
      809     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
      810     do
      811     on error undo, return error
      812     :
      813       define buffer buf_usr-flt for ubflt.usr-flt .
      814       define variable v-use-List_     as logical   no-undo .
      815       define variable v-type-List_     as character no-undo .
      816       define variable v-format-List_   as character no-undo .
      817       define variable v-use-Naim      as logical   no-undo .
      818       define variable v-type-Naim      as character no-undo .
      819       define variable v-format-Naim    as character no-undo .
      820       define variable v-use-print-graft as logical   no-undo .
      821       define variable v-use-sort-gr   as logical   no-undo .
      822       define variable v-use-type-price as logical   no-undo .
      823       define variable v-use-type-val  as logical   no-undo .
      824       define variable v-tooltip        as character no-undo .
      825       define variable v-label          as character no-undo .
      826       define variable v-user-can-edit  as logical   no-undo .
      827       define variable v-output-display as logical   no-undo .
      828       define variable v-other          as character no-undo .
      829       run uf-name in this-procedure
      830         (input  entry(1, p-code, chr(4))
      831         ,output v-use-List_
      832         ,output v-type-List_
      833         ,output v-format-List_
      834         ,output v-use-Naim
      835         ,output v-type-Naim
      836         ,output v-format-Naim
      837         ,output v-use-print-graft
      838         ,output v-use-sort-gr
      839         ,output v-use-type-price
      840         ,output v-use-type-val
      841         ,output v-label
      842         ,output v-tooltip
      843         ,output v-user-can-edit
      844         ,output v-output-display
      845         ,output v-other
      846         ) no-error .
      847       if error-status :error then do:
      848         undo, return error return-value .
      849       end.
      850       find first buf_usr-flt where
      851                  buf_usr-flt.Call-point     = p-code AND
      852                  buf_usr-flt.user-name       = p-user-name
      853         no-error .
      854       if not avail buf_usr-flt then do:
      855           create buf_usr-flt .
      856           assign
      857           buf_usr-flt.call-point = p-code
      858           buf_usr-flt.user-name  = p-user-name
      859           .
      860       end.
      861       if avail buf_usr-flt then do:
      862        assign
      863        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
      864        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
      865        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
      866        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
      867        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
      868        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
      869       .
      870       release buf_usr-flt.
      871       end.
      872       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
      873     end.
      874   end procedure.
      875   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      876     define variable v-cntxt-db-num        as integer   no-undo .
      877     define variable v-cntxt-userid        as character no-undo .
      878     define variable v-cntxt-level         as character no-undo .
      879     define variable v-cntxt-host-code-obj as integer   no-undo .
      880     define variable v-cntxt-obj-type      as character no-undo .
      881     define variable v-cntxt-obj-code      as integer   no-undo .
      882     define variable v-cntxt-db-num-obj    as integer   no-undo .
      883     define variable v-cntxt-is-admin      as logical   no-undo .
      884   procedure placelib_write-attr:
      885   define input  parameter p-code     like ub.place-attr.attr-code .
      886   define input  parameter p-obj-code like ub.place-attr.obj-code .
      887   define input  parameter p-obj-type like ub.place-attr.obj-type .
      888   define input  parameter p-pl-code  like ub.place-attr.pl-code .
      889   define input  parameter p-value    like ub.place-attr.attr-value .
      890   define output parameter p-ok       as logical.
      891   define buffer buf_place-attr for ub.place-attr .
      892     do on error undo, return error return-value :
      893        p-ok = false.
      894        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
      895                                                   and buf_place-attr.obj-code    = p-obj-code
      896                                                   and buf_place-attr.obj-type    = p-obj-type
      897                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
      898        if not available buf_place-attr then do :
      899           create buf_place-attr.
      900           assign
      901             buf_place-attr.attr-code   = p-code
      902             buf_place-attr.attr-value  = p-value
      903             buf_place-attr.obj-code    = p-obj-code
      904             buf_place-attr.obj-type    = p-obj-type
      905             buf_place-attr.pl-code     = p-pl-code
      906           .
      907           p-ok = true.
      908        end.
      909        else do:
      910           buf_place-attr.attr-value  = p-value .
      911           p-ok = true.
      912        end.
      913     end.
      914   end.
      915   procedure placelib_get-attr:
      916   define input  parameter  p-code     like ub.place-attr.attr-code .
      917   define input  parameter  p-obj-code like ub.place-attr.obj-code .
      918   define input  parameter  p-obj-type like ub.place-attr.obj-type .
      919   define input  parameter  p-pl-code  like ub.place-attr.pl-code .
      920   define output parameter  p-value    like ub.place-attr.attr-value .
      921   define output parameter  p-ok       as logical.
      922   define buffer buf_place-attr for ub.place-attr .
      923     do on error undo, return error return-value :
      924        p-ok = false.
      925        find first buf_place-attr no-lock where buf_place-attr.attr-code   = p-code
      926                                                   and buf_place-attr.obj-code    = p-obj-code
      927                                                   and buf_place-attr.obj-type    = p-obj-type
      928                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
      929        if available buf_place-attr then do :
      930          p-value = buf_place-attr.attr-value.
      931          p-ok = true.
      932        end.
      933        else do :
      934          p-ok = false.
      935        end.
      936     end.
      937   end.
      938   procedure placelib_del-attr:
      939   define input parameter  p-code     like ub.place-attr.attr-code .
      940   define input parameter  p-obj-code like ub.place-attr.obj-code .
      941   define input parameter  p-obj-type like ub.place-attr.obj-type .
      942   define input parameter  p-pl-code  like ub.place-attr.pl-code .
      943   define input parameter  p-value    like ub.place-attr.attr-value .
      944   define output parameter p-ok       as logical.
      945   define buffer buf_place-attr for ub.place-attr .
      946     do on error undo, return error return-value :
      947        p-ok = false.
      948        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
      949                                                   and buf_place-attr.obj-code    = p-obj-code
      950                                                   and buf_place-attr.obj-type    = p-obj-type
      951                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
      952        if available buf_place-attr then do :
      953           delete buf_place-attr.
      954           p-ok = true.
      955        end.
      956     end.
      957   end.
      958   RUN set-attribute-list (
      959     'Keys-Accepted = "",
      960        Keys-Supplied = ""':U).
      961   DEFINE BUTTON btn-add
      962     LABEL "Выбор"
      963     SIZE 11 BY .95.
      964   DEFINE VARIABLE f-pl AS CHARACTER FORMAT "X(256)":U
      965     LABEL "Резервуары"
      966     VIEW-AS FILL-IN
      967     SIZE 53.8 BY 1 NO-UNDO.
      968   DEFINE FRAME F-Main
      969     f-pl AT ROW 1.71 COL 4.4 WIDGET-ID 18
      970     btn-add AT ROW 1.71 COL 73 WIDGET-ID 6
      971     WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      972     SIDE-LABELS NO-UNDERLINE THREE-D
      973     AT COL 1 ROW 1 SCROLLABLE
      974     BGCOLOR 8 .
      975   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      976   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      977   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      978   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      979   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      980   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      981   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      982   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      983         adm-object-hdl = FRAME F-Main:HANDLE.
      984   RUN ensure-broker.
      985   THIS-PROCEDURE:ADM-DATA =
      986        'ADM1.1~`':U +
      987        'SmartObject~`':U +
      988        '~`':U +
      989        'NO ~`':U +
      990        '~`':U +
      991        '~`':U +
      992        '~`':U +
      993        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      994           + "~`":U +
      995        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
      996        'Record-Source,Record-Target,TableIO-Target~`':U +
      997        '~`':U +
      998        '~`~`~`~`~`~`~`~`~`~`~`':U +
      999        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1000            THEN "^^":U
     1001        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1002             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1003   PROCEDURE adm-apply-entry :
     1004     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1005   END PROCEDURE.
     1006   PROCEDURE adm-destroy :
     1007    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1008   END PROCEDURE.
     1009   PROCEDURE adm-disable :
     1010       DISABLE f-pl btn-add WITH FRAME F-Main.
     1011       RUN dispatch ('disable-fields':U).
     1012       RUN set-attribute-list ('ENABLED=no':U).
     1013       RETURN.
     1014   END PROCEDURE.
     1015   PROCEDURE adm-edit-attribute-list :
     1016         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
     1017         RETURN.
     1018   END PROCEDURE.
     1019   PROCEDURE adm-enable :
     1020       ENABLE UNLESS-HIDDEN f-pl btn-add WITH FRAME F-Main.
     1021       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     1022       RUN set-attribute-list ('ENABLED=yes':U).
     1023       RETURN.
     1024   END PROCEDURE.
     1025   PROCEDURE adm-exit :
     1026        RUN notify ('exit':U).
     1027     RETURN.
     1028   END PROCEDURE.
     1029   PROCEDURE adm-hide :
     1030     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1031   END PROCEDURE.
     1032   PROCEDURE adm-initialize :
     1033     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1034   END PROCEDURE.
     1035   PROCEDURE adm-show-errors :
     1036       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1037       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1038           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1039       END.
     1040       RETURN.
     1041   END PROCEDURE.
     1042   PROCEDURE adm-UIB-mode :
     1043     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1044   END PROCEDURE.
     1045   PROCEDURE adm-view :
     1046     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1047   END PROCEDURE.
     1048   PROCEDURE dispatch :
     1049       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1050       RUN broker-dispatch IN adm-broker-hdl
     1051           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1052       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1053   END PROCEDURE.
     1054   PROCEDURE ensure-broker :
     1055   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1056   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1057   DO:
     1058       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1059       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1060   END.
     1061   END PROCEDURE.
     1062   PROCEDURE get-attribute :
     1063     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1064     RUN broker-get-attribute IN adm-broker-hdl
     1065         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1066     RETURN RETURN-VALUE.
     1067   END PROCEDURE.
     1068   PROCEDURE get-attribute-list :
     1069     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1070     RUN broker-get-attribute-list IN adm-broker-hdl
     1071         (INPUT THIS-PROCEDURE,
     1072          INPUT ?,
     1073          OUTPUT p-attr-list) NO-ERROR.
     1074     RETURN.
     1075   END PROCEDURE.
     1076   PROCEDURE new-state :
     1077     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1078     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1079     RETURN.
     1080   END PROCEDURE.
     1081   PROCEDURE notify :
     1082     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1083     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1084     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1085         RETURN "ADM-ERROR":U.
     1086     RETURN.
     1087   END PROCEDURE.
     1088   PROCEDURE set-attribute-list :
     1089     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1090     RUN ensure-broker.
     1091     RUN broker-set-attribute-list IN adm-broker-hdl
     1092         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1093     RETURN.
     1094   END PROCEDURE.
     1095   PROCEDURE set-position :
     1096       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1097       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1098       IF VALID-HANDLE(adm-object-hdl) THEN
     1099       DO:
     1100         ASSIGN adm-object-hdl:ROW    =   p-row
     1101                adm-object-hdl:COLUMN =   p-col.
     1102       END.
     1103       RETURN.
     1104   END PROCEDURE.
     1105   PROCEDURE adm-display-fields :
     1106       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
     1107       RETURN.
     1108   END PROCEDURE.
     1109   PROCEDURE adm-open-query :
     1110     RETURN.
     1111   END PROCEDURE.
     1112   PROCEDURE adm-row-changed :
     1113         IF VALID-HANDLE(adm-object-hdl) THEN
     1114           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1115         RUN notify ('row-available':U).
     1116         RETURN.
     1117   END PROCEDURE.
     1118   PROCEDURE reposition-query :
     1119       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
     1120       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
     1121       RETURN.
     1122   END PROCEDURE.
     1123     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
     1124     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
     1125     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
     1126     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
     1127     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
     1128     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
     1129     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
     1130     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
     1131     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1132     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
     1133     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1134     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
     1135     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
     1136     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
     1137     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
     1138     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
     1139     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
     1140     IF "":U = "":U THEN
     1141       RUN modify-list-attribute IN adm-broker-hdl
     1142         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
     1143     RUN use-create-on-add(?).
     1144   PROCEDURE adm-add-record :
     1145       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1146          "must have at least one Enabled Table to perform Add.":U
     1147          VIEW-AS ALERT-BOX ERROR.
