     1149   END PROCEDURE.
     1150   PROCEDURE adm-assign-record :
     1151    MESSAGE
     1152          "Object ":U THIS-PROCEDURE:FILE-NAME
     1153            "must have at least one Enabled Table to perform Assign.":U
     1154              VIEW-AS ALERT-BOX ERROR.
     1155      RETURN.
     1156     END PROCEDURE.
     1157   PROCEDURE adm-assign-statement :
     1158     RETURN.
     1159   END PROCEDURE.
     1160   PROCEDURE adm-cancel-record :
     1161      RETURN.
     1162     END PROCEDURE.
     1163   PROCEDURE adm-copy-record :
     1164       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1165        "must have at least one Enabled Table to perform Copy.":U
     1166          VIEW-AS ALERT-BOX ERROR.
     1167       RETURN.
     1168   END PROCEDURE.
     1169   PROCEDURE adm-create-record :
     1170      RETURN.
     1171   END PROCEDURE.
     1172   PROCEDURE adm-current-changed :
     1173     RETURN.
     1174   END PROCEDURE.
     1175   PROCEDURE adm-delete-record :
     1176    MESSAGE
     1177          "Object ":U THIS-PROCEDURE:FILE-NAME
     1178            "must have at least one Enabled Table to perform Delete.":U
     1179              VIEW-AS ALERT-BOX ERROR.
     1180       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
     1181       RETURN.
     1182   END PROCEDURE.
     1183   PROCEDURE adm-disable-fields :
     1184         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
     1185       RETURN.
