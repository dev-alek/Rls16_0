     1187   PROCEDURE adm-enable-fields :
     1188       RETURN.
     1189   END PROCEDURE.
     1190   PROCEDURE adm-end-update :
     1191     RETURN.
     1192   END PROCEDURE.
     1193   PROCEDURE adm-reset-record :
     1194       RETURN.
     1195   END PROCEDURE.
     1196   PROCEDURE adm-update-record :
     1197       MESSAGE
     1198         "Object ":U THIS-PROCEDURE:FILE-NAME
     1199           "must have at least one Enabled Table to perform Update.":U
     1200             VIEW-AS ALERT-BOX ERROR.
     1201      RETURN.
     1202   END PROCEDURE.
     1203   PROCEDURE check-modified :
     1204   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1205   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1206   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1207   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1208     IF check-state = "check":U THEN
     1209     DO:
     1210       RUN get-link-handle IN adm-broker-hdl
     1211         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1212            OUTPUT group-target-list).
     1213       IF group-target-list NE "":U THEN
     1214       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1215         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1216         RUN check-modified IN curr-widget ('group-check':U).
     1217         IF RETURN-VALUE NE "":U THEN
     1218         DO:
     1219           RUN check-modified-message(RETURN-VALUE).
     1220           RETURN "":U.
     1221         END.
     1222       END.
     1223     END.
     1224     RETURN "":U.
     1225   END PROCEDURE.
     1226   PROCEDURE check-modified-message :
     1227     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1228        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1229           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1230        IF RETURN-VALUE = "YES":U THEN
     1231           RUN notify ('view,CONTAINER-SOURCE':U).
     1232        MESSAGE IF p-changed-table NE ? THEN
     1233           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1234           ELSE "Current values have been changed."
     1235           SKIP "  Do you wish to save those changes?"
     1236           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1237        IF ANS THEN
     1238        DO:
     1239           IF group-assign-target THEN
     1240             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1241           ELSE RUN dispatch('update-record':U).
     1242           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1243           DO:
     1244               MESSAGE "Changes to the previous record were not saved."
     1245                 VIEW-AS ALERT-BOX ERROR.
     1246               IF group-assign-target THEN
     1247                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1248               ELSE RUN dispatch ('cancel-record':U).
     1249           END.
     1250        END.
     1251        ELSE DO:
     1252          IF group-assign-target THEN
     1253             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1254          ELSE RUN dispatch('cancel-record':U).
     1255        END.
     1256        RETURN.
     1257   END PROCEDURE.
     1258   PROCEDURE get-rowid :
     1259       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1260       ASSIGN
     1261       p-table   =   adm-first-table.
     1262       RETURN.
     1263   END PROCEDURE.
     1264   PROCEDURE init-group-assign :
     1265       RUN request-attribute IN adm-broker-hdl
     1266         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1267       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1268         group-assign-target = yes.
     1269       ELSE group-assign-target = no.
     1270       RETURN.
     1271   END PROCEDURE.
     1272   PROCEDURE set-editors :
     1273       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1274       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1275       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1276       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1277       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1278       DO WHILE VALID-HANDLE (curr-widget):
     1279           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1280              curr-widget:HIDDEN = no THEN DO:
     1281             CASE p-field-setting:
     1282               WHEN "INITIALIZE":U THEN
     1283               DO:
     1284                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1285                     read-only-list +
     1286                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1287                        STRING(curr-widget).
     1288               END.
     1289               WHEN "DISABLE":U OR
     1290               WHEN "ENABLE":U THEN
     1291               DO:
     1292                   curr-widget:SENSITIVE = yes.
     1293                   RUN get-attribute ('Read-Only-Editors':U).
     1294                   IF RETURN-VALUE = ? OR
     1295                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1296                       curr-widget:READ-ONLY =
     1297                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1298               END.
     1299               WHEN "CLEAR":U THEN
     1300                   curr-widget:SCREEN-VALUE = "":U.
     1301             END CASE.
     1302           END.
     1303           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1304       END.
     1305       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1306         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1307           + '"':U).
     1308       RETURN.
     1309   END PROCEDURE.
     1310   PROCEDURE use-check-modified-all :
     1311    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1312     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1313     RETURN.
     1314   END PROCEDURE.
     1315   PROCEDURE use-create-on-add :
     1316   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1317      RETURN.
     1318   END PROCEDURE.
     1319   PROCEDURE use-initial-lock :
     1320     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1321     ASSIGN adm-initial-lock = p-attr-value.
     1322     RETURN.
     1323   END PROCEDURE.
     1324     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1325   ASSIGN
     1326     FRAME F-Main:SCROLLABLE = FALSE
     1327     FRAME F-Main:HIDDEN     = TRUE.
     1328   ASSIGN
     1329     f-pl:READ-ONLY IN FRAME F-Main = TRUE.
     1330   ON CHOOSE OF btn-add IN FRAME F-Main
     1331      DO:
     1332         define buffer buf_place for ub.place .
     1333         define variable ii      as integer   no-undo .
     1334         define variable v-value as character no-undo.
     1335         define variable v-ok    as logical   no-undo.
     1336         f-pl = ''.
     1337         empty temp-table tt-place .
     1338         for each obj-list:
     1339            for each buf_place no-lock where buf_place.obj-code = obj-list.obj-code and
     1340               buf_place.obj-type = obj-list.obj-type and
     1341               buf_place.status_ <> 'удал':U:
     1342               create tt-place .
     1343               buffer-copy buf_place to tt-place .
     1344               tt-place.obj-name = obj-list.obj-name .
     1345            end.
     1346         end.
     1347         run ref/change-pl.w
     1348            (input parparentproc
     1349            ,output loc-ref-list
     1350            ).
     1351         do ii = 1 to num-entries(loc-ref-list, ","):
     1352            find first buf_place where recid(buf_place) = integer(entry(ii, loc-ref-list, ",")) no-lock.
     1353            if f-pl = '' then f-pl = string(buf_place.loc1) .
     1354            else f-pl = f-pl + ',' + string(buf_place.loc1).
     1355            run placelib_get-attr in this-procedure  (
     1356               input "place-twice-code"
     1357               ,input buf_place.obj-code
     1358               ,input buf_place.obj-type
     1359               ,input buf_place.pl-code
     1360               ,output v-value
     1361               ,output v-ok      ) no-error.
     1362            if v-ok and v-value <> "" then f-pl = f-pl + "(" + v-value + ")".
     1363         end.
     1364         display f-pl with frame F-Main.
     1365      END.
     1366   if not this-procedure :persistent
     1367   then do:
     1368     message
     1369       vss-workfile vss-revision vss-description skip
     1370       "Ошибка при запуске процедуры" skip
     1371       "Данную процедуру следует запускать только с параметром persistent" skip
     1372       view-as alert-box error .
     1373     undo, return error .
     1374   end.
     1375   assign
     1376     parparentproc = my-handle
     1377     .
     1378   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1379     run mainmenu_getcntxt in parparentproc
     1380       (output v-cntxt-db-num
     1381       ,output v-cntxt-userid
     1382       ,output v-cntxt-level
     1383       ,output v-cntxt-host-code-obj
     1384       ,output v-cntxt-obj-type
     1385       ,output v-cntxt-obj-code
     1386       ,output v-cntxt-db-num-obj
     1387       ,output v-cntxt-is-admin
     1388       ) .
     1389   PROCEDURE adm-row-available :
     1390     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
     1391     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
     1392     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
     1393     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
     1394     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
     1395     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
     1396     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
     1397     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
     1398     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
     1399     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
     1400     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
     1401     IF adm-updating-record THEN RETURN.
     1402     RUN get-attribute ('FIELDS-ENABLED':U).
     1403     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
     1404     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
     1405         OUTPUT link-handle) NO-ERROR.
     1406     IF link-handle = "":U THEN
     1407         RETURN.
     1408     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
     1409     IF NUM-ENTRIES(link-handle) > 1 THEN
     1410         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
     1411             "encountered more than one RECORD-SOURCE.":U SKIP
     1412             "The first - ":U record-source-hdl:file-name " - will be used.":U
     1413                VIEW-AS ALERT-BOX ERROR.
     1414     RUN get-attribute ('Key-Name':U).
     1415     key-name = RETURN-VALUE.
     1416     IF key-name = "":U THEN key-name = ?.
     1417     IF key-name NE ? THEN DO:
     1418       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
     1419         NO-ERROR.
     1420       IF key-value NE ? THEN
     1421         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
     1422     END.
     1423   IF VALID-HANDLE (adm-object-hdl) THEN
     1424       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1425   RUN notify IN THIS-PROCEDURE ('row-available':U).
     1426   END PROCEDURE.
     1427   PROCEDURE disable_UI :
     1428     HIDE FRAME F-Main.
     1429     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1430   END PROCEDURE.
     1431   PROCEDURE local-initialize :
     1432     run dispatch in this-procedure ( input 'initialize':u ) .
     1433   END PROCEDURE.
     1434   PROCEDURE my-report :
     1435     if x-shift-start = ? or x-shift-end = ?
     1436       then assign x-shift-start = ?
     1437         x-shift-end   = ? .
     1438     IF NOT CAN-FIND(FIRST obj-list) THEN
     1439     DO:
     1440       message "Вы не выбрали объект." view-as alert-box.
     1441       return.
     1442     END.
     1443     FIND FIRST obj-list.
     1444      run rep/r-indop_vol.p
     1445         ( input my-handle
     1446         , input loc-ref-list
     1447         , input f-pl
     1448         ).
     1449   END PROCEDURE.
     1450   PROCEDURE my-var :
     1451     define variable reportname   as char initial "Отчет по всем возвратным операциям" no-undo.
     1452     define variable reportheader as char no-undo.
     1453     assign frame F-Main
     1454       f-pl
     1455       .
     1456   END PROCEDURE.
     1457   PROCEDURE send-records :
     1458   END PROCEDURE.
     1459   PROCEDURE state-changed :
     1460     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     1461     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     1462     CASE p-state:
     1463       WHEN 'update-begin':U THEN DO:
     1464           RUN dispatch('enable-fields':U).
     1465           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1466           DO:
     1467             RUN new-state('update-failed,TABLEIO-SOURCE':U).
     1468             RUN new-state('update-complete':U).
     1469           END.
     1470           ELSE RUN new-state ('update':U).
     1471       END.
     1472       WHEN 'update-complete':U THEN DO:
     1473           RUN new-state ('update-complete':U).
     1474       END.
     1475     END CASE.
     1476   END PROCEDURE.
