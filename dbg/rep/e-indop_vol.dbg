      611   define new global shared variable g#library  as handle no-undo .
      612   define new global shared variable g#library2 as handle no-undo .
      613   define variable var-report-r-b as character no-undo .
      614   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      615   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      616     (output var-report-r-b
      617     )  .
      618   define variable state-source  as widget-handle.
      619   define variable parparentproc as widget-handle no-undo .
      620   define variable loc-ref-list  as character     no-undo .
      621   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      622   define variable v-uf-List_        like ubflt.usr-flt.List_        no-undo .
      623   define variable v-uf-Naim         like ubflt.usr-flt.Naim         no-undo .
      624   define variable v-uf-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      625   define variable v-uf-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      626   define variable v-uf-type-price   like ubflt.usr-flt.type-price   no-undo .
      627   define variable v-uf-type-val     like ubflt.usr-flt.type-val     no-undo .
      628   define temp-table usr-flt_custom-labels no-undo like ub.custom-labels.
      629   procedure uf-name :
      630     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      631     define output parameter p-use-List_     as logical   no-undo .
      632     define output parameter p-type-List_     as character no-undo .
      633     define output parameter p-format-List_   as character no-undo .
      634     define output parameter p-use-Naim      as logical   no-undo .
      635     define output parameter p-type-Naim      as character no-undo .
      636     define output parameter p-format-Naim    as character no-undo .
      637     define output parameter p-use-print-graft as logical   no-undo .
      638     define output parameter p-use-sort-gr   as logical   no-undo .
      639     define output parameter p-use-type-price as logical   no-undo .
      640     define output parameter p-use-type-val  as logical   no-undo .
      641     define output parameter p-label          as character no-undo .
      642     define output parameter p-tooltip        as character no-undo .
      643     define output parameter p-user-can-edit  as logical   no-undo .
      644     define output parameter p-output-display as logical   no-undo .
      645     define output parameter p-other          as character no-undo .
      646     do
      647     on error undo, return error
      648     :
      649       case p-code :
      650               when 'cli-all-p':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = yes      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Параметры вызова справочника клиентов"     p-tooltip = "Параметры по умолчанию, используемые для вызова справочника клиентов"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
