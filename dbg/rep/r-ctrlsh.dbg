     1902             tot-pol15 = 0.0
     1903             tot-pol16 = 0.0
     1904           .
     1905         end.
     1906         for each buf_shift-obj  no-lock
     1907           where buf_shift-obj.obj-code   =  obj-list.obj-code
     1908             and buf_shift-obj.obj-type   =  obj-list.obj-type
     1909             and buf_shift-obj.shift-date >= X-date-Start
     1910             and buf_shift-obj.shift-date <= X-date-End
     1911           break by buf_shift-obj.shift-date by buf_shift-obj.shift-num
     1912         :
     1913           if x-TOG-Shift = true
     1914             and ( ( buf_shift-obj.shift-date = X-date-Start
     1915                     and buf_shift-obj.shift-num < X-Shift-Start
     1916                   )
     1917                   or ( buf_shift-obj.shift-date = X-date-End
     1918                       and buf_shift-obj.shift-num > X-Shift-End
     1919                     )
     1920                 )
     1921           then do:
     1922             next .
     1923           end.
     1924           assign
     1925             pol1 = (if first-of( buf_shift-obj.shift-date ) then buf_shift-obj.shift-date else ? )
     1926             pol2 = buf_shift-obj.shift-name
     1927             pol3 = 0
     1928             pol4 = 0
     1929           .
     1930           find last previous_shift-obj
     1931             where previous_shift-obj.obj-type = buf_shift-obj.obj-type
     1932               and previous_shift-obj.obj-code = buf_shift-obj.obj-code
     1933               and (( previous_shift-obj.shift-date = buf_shift-obj.shift-date
     1934                     and previous_shift-obj.shift-num < buf_shift-obj.shift-num
     1935                   )
     1936                   or previous_shift-obj.shift-date < buf_shift-obj.shift-date
     1937                   )
     1938               use-index pi no-error.
     1939           if available previous_shift-obj then do:
     1940             find first previous_rvs-doc no-lock
     1941               where previous_rvs-doc.obj-type   = previous_shift-obj.obj-type
     1942                 and previous_rvs-doc.obj-code   = previous_shift-obj.obj-code
     1943                 and previous_rvs-doc.shift-date = previous_shift-obj.shift-date
     1944                 and previous_rvs-doc.shift-num  = previous_shift-obj.shift-num
     1945                 and previous_rvs-doc.status_    = 'факт':U
     1946                 and previous_rvs-doc.rvs-type   = 'смена':U
     1947               no-error .
     1948             if available previous_rvs-doc then do:
     1949               for each previous_rvs-line no-lock
     1950                 where previous_rvs-line.gds-code  = gds-list.gds-code
     1951                   and previous_rvs-line.rvs-code  = previous_rvs-doc.rvs-code
     1952                   and previous_rvs-line.obj-type  = previous_rvs-doc.obj-type
     1953                   and previous_rvs-line.obj-code  = previous_rvs-doc.obj-code
     1954               :
     1955                 assign
     1956                   pol3 = pol3 + previous_rvs-line.state-measure-qnty + previous_rvs-line.state-add-qnty
     1957                   pol4 = pol4 + previous_rvs-line.state-measure-cli-qnty + previous_rvs-line.state-add-qnty * previous_rvs-line.state-density
     1958                 .
     1959               end.
     1960             end.
     1961           end.
     1962           assign
     1963             pol7  = 0.0
     1964             pol11 = 0.0
     1965             pol12 = 0.0
     1966           .
     1967           for each buf_rvs-doc no-lock
     1968             where buf_rvs-doc.obj-type   = buf_shift-obj.obj-type
     1969               and buf_rvs-doc.obj-code   = buf_shift-obj.obj-code
     1970               and buf_rvs-doc.shift-date = buf_shift-obj.shift-date
     1971               and buf_rvs-doc.shift-num  = buf_shift-obj.shift-num
     1972               and buf_rvs-doc.status_    = 'факт':U
     1973               and buf_rvs-doc.rvs-type   = 'смена':U
     1974           :
     1975             for each buf_rvs-line no-lock
     1976               where buf_rvs-line.gds-code  = gds-list.gds-code
     1977                 and buf_rvs-line.rvs-code  = buf_rvs-doc.rvs-code
     1978                 and buf_rvs-line.obj-type  = buf_rvs-doc.obj-type
     1979                 and buf_rvs-line.obj-code  = buf_rvs-doc.obj-code
     1980             :
     1981               assign
     1982                 pol11 = pol11 + buf_rvs-line.state-measure-qnty + buf_rvs-line.state-add-qnty
     1983                 pol12 = pol12 + buf_rvs-line.state-measure-cli-qnty + buf_rvs-line.state-add-qnty * buf_rvs-line.state-density
     1984               .
     1985             end.
     1986             for each buf_rvs-line-pump no-lock
     1987               where buf_rvs-line-pump.rvs-code = buf_rvs-doc.rvs-code
     1988                 and buf_rvs-line-pump.obj-type = buf_shift-obj.obj-type
     1989                 and buf_rvs-line-pump.obj-code = buf_shift-obj.obj-code
     1990                 and buf_rvs-line-pump.gds-code = gds-list.gds-code
     1991               break by buf_rvs-line-pump.pump-code
     1992                     by buf_rvs-line-pump.nozzle-code
     1993             :
     1994                 assign
     1995                   pol7 = pol7 + buf_rvs-line-pump.state-mh-cnt
     1996                 .
     1997                 if available previous_rvs-doc then do:
     1998                   find first previous_rvs-line-pump  no-lock
     1999                     where previous_rvs-line-pump.rvs-code    = previous_rvs-doc.rvs-code
     2000                       and previous_rvs-line-pump.obj-code    = buf_shift-obj.obj-code
     2001                       and previous_rvs-line-pump.obj-type    = buf_shift-obj.obj-type
     2002                       and previous_rvs-line-pump.pump-code   = buf_rvs-line-pump.pump-code
     2003                       and previous_rvs-line-pump.nozzle-code = buf_rvs-line-pump.nozzle-code
     2004                     no-error.
     2005                   if available previous_rvs-line-pump then do:
     2006                     assign
     2007                       pol7 = pol7 - previous_rvs-line-pump.state-mh-cnt
     2008                     .
     2009                   end.
     2010                 end.
     2011                 if not available previous_rvs-doc
     2012                   or not available previous_rvs-line-pump
     2013                 then do:
     2014                   for each control_rvs-doc no-lock
     2015                     where control_rvs-doc.obj-type   = buf_shift-obj.obj-type
     2016                       and control_rvs-doc.obj-code   = buf_shift-obj.obj-code
     2017                       and control_rvs-doc.shift-date = buf_shift-obj.shift-date
     2018                       and control_rvs-doc.shift-num  = buf_shift-obj.shift-num
     2019                       and control_rvs-doc.status_    = 'факт':U
     2020                       and control_rvs-doc.rvs-type   = 'контроль':U
     2021                     ,first control_rvs-line-pump no-lock
     2022                     where control_rvs-line-pump.rvs-code    = control_rvs-doc.rvs-code
     2023                       and control_rvs-line-pump.gds-code    = gds-list.gds-code
     2024                       and control_rvs-line-pump.obj-code    = control_rvs-doc.obj-code
     2025                       and control_rvs-line-pump.obj-type    = control_rvs-doc.obj-type
     2026                       and control_rvs-line-pump.pump-code   = buf_rvs-line-pump.pump-code
     2027                       and control_rvs-line-pump.nozzle-code = buf_rvs-line-pump.nozzle-code
     2028                     by control_rvs-doc.fact-order
     2029                   :
     2030                     if control_rvs-line-pump.state-mh-cnt <> ? then do:
     2031                       assign
     2032                         pol7 = pol7 - control_rvs-line-pump.state-mh-cnt
     2033                       .
     2034                     end.
     2035                     leave.
     2036                   end.
     2037                 end.
     2038             end.
     2039           end.
     2040           assign
     2041             pol5  = 0.0
     2042             pol6  = 0.0
     2043             pol8  = 0.0
     2044             pol9  = 0.0
     2045             pol10 = 0.0
     2046             pol13 = pol3
     2047             pol14 = pol4
     2048           .
     2049           for each buf_trn-doc no-lock
     2050             where buf_trn-doc.obj-type   = buf_shift-obj.obj-type
     2051               and buf_trn-doc.obj-code   = buf_shift-obj.obj-code
     2052               and buf_trn-doc.shift-date = buf_shift-obj.shift-date
     2053               and buf_trn-doc.shift-num  = buf_shift-obj.shift-num
     2054               and buf_trn-doc.status_    = 'факт':U
     2055           on error undo, return error return-value
     2056           :
     2057             run clntattr-value in this-procedure
     2058               ( input buf_trn-doc.cli-type
     2059               , input buf_trn-doc.cli-code
     2060               , input 'shftrep2':U
     2061               , output v-shftrep2
     2062               , output v-attr-type
     2063               ).
     2064             for each buf_doc-pl no-lock
     2065               where buf_doc-pl.gds-code = gds-list.gds-code
     2066                 and buf_doc-pl.obj-code = buf_trn-doc.obj-code
     2067                 and buf_doc-pl.obj-type = buf_trn-doc.obj-type
     2068                 and buf_doc-pl.out-code = buf_trn-doc.doc-code
     2069             on error undo, return error return-value
     2070             :
     2071               if lookup( buf_trn-doc.ext-doc-type, 'ee,ep,es,we,ev,em,wm,eo':U ) > 0 then do:
     2072                 assign
     2073                   v-sign = -1.0
     2074                 .
     2075               end.
     2076               else do:
     2077                 assign
     2078                   v-sign = 1.0
     2079                 .
     2080                 if lookup( buf_trn-doc.ext-doc-type, 'ie,re,rs,vt,vp,ap,mp,pc,iv,rv,im,io':U ) = 0 then do:
     2081                   message
     2082                     vss-workfile vss-revision vss-description skip
     2083                     substitute( '&1. Тип "&2" не внесен в списки документов уменьшающих(увеличивающих) остатки!', vss-workfile, buf_trn-doc.ext-doc-type) skip
     2084                     view-as alert-box error .
     2085                 end.
     2086               end.
     2087               assign
     2088                 pol13 = pol13 + buf_doc-pl.fact-qnty * v-sign
     2089                 pol14 = pol14 + buf_doc-pl.cli-fact-qnty * v-sign
     2090               .
     2091               if buf_trn-doc.doc-type = 'при':U then do:
     2092                 assign
     2093                   pol5 = pol5 + buf_doc-pl.fact-qnty
     2094                   pol6 = pol6 + buf_doc-pl.cli-fact-qnty
     2095                 .
     2096               end.
     2097               else do:
     2098                 if v-shftrep2 = "yes" then do:
     2099                   assign
     2100                     pol8 = pol8 + buf_doc-pl.fact-qnty
     2101                   .
     2102                 end.
     2103                 if buf_trn-doc.ext-doc-type = 'es':U
     2104                   or buf_trn-doc.ext-doc-type = 'rs':U
     2105                 then do:
     2106                   assign
     2107                     pol9  = pol9  + buf_doc-pl.fact-qnty * v-sign * -1
     2108                     pol10 = pol10 + buf_doc-pl.cli-fact-qnty * v-sign * -1
     2109                   .
     2110                 end.
     2111               end.
     2112             end.
     2113           end.
     2114           assign
     2115             pol15 = pol11 - pol13
     2116             pol16 = pol12 - pol14
     2117           .
     2118           display stream PrnLibstream
     2119             sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 sym13 sym14 sym15 sym16 sym17
     2120             pol1  when pol1 <> ?
     2121             pol2
     2122             pol3
     2123             pol4
     2124             pol5  when pol5 <> 0
     2125             pol6  when pol6 <> 0
     2126             pol7  when pol7 <> 0
     2127             pol8  when pol8 <> 0
     2128             pol9  when pol9 <> 0
     2129             pol10 when pol10 <> 0
     2130             pol11
     2131             pol12
     2132             pol13
     2133             pol14
     2134             pol15 when pol15 <> 0
     2135             pol16 when pol16 <> 0
     2136             with frame frame-1
     2137           .
     2138           down stream PrnLibstream
     2139             with frame frame-1.
     2140           if Make-Excel then  put   stream ForExcel unformatted
     2141             (if pol1 <> ? then string( pol1, "99.99.9999" ) else "":U)  CHR(9)
     2142             pol2  CHR(9)
     2143             pol3  CHR(9)
     2144             pol4  CHR(9)
     2145             (if pol5  <> 0 then substitute( "&1", pol5  ) else "":U)  CHR(9)
     2146             (if pol6  <> 0 then substitute( "&1", pol6  ) else "":U)  CHR(9)
     2147             (if pol7  <> 0 then substitute( "&1", pol7  ) else "":U)  CHR(9)
     2148             (if pol8  <> 0 then substitute( "&1", pol8  ) else "":U)  CHR(9)
     2149             (if pol9  <> 0 then substitute( "&1", pol9  ) else "":U)  CHR(9)
     2150             (if pol10 <> 0 then substitute( "&1", pol10 ) else "":U)  CHR(9)
     2151             pol11 CHR(9)
     2152             pol12 CHR(9)
     2153             pol13 CHR(9)
     2154             pol14 CHR(9)
     2155             (if pol15 <> 0 then substitute( "&1", pol15 ) else "":U)  CHR(9)
     2156             (if pol16 <> 0 then substitute( "&1", pol16 ) else "":U)
     2157             chr(10)
     2158           .
     2159           assign
     2160             tot-pol5  = tot-pol5  + pol5
     2161             tot-pol6  = tot-pol6  + pol6
     2162             tot-pol7  = tot-pol7  + pol7
     2163             tot-pol8  = tot-pol8  + pol8
     2164             tot-pol9  = tot-pol9  + pol9
     2165             tot-pol10 = tot-pol10 + pol10
     2166             tot-pol15 = tot-pol15 + pol15
     2167             tot-pol16 = tot-pol16 + pol16
     2168           .
     2169         end.
     2170         if last-of( gds-list.artic ) then do:
     2171           display stream PrnLibstream
     2172             sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 sym13 sym14 sym15 sym16 sym17
     2173             "итого"   @ pol1
     2174             tot-pol5  @ pol5
     2175             tot-pol6  @ pol6
     2176             tot-pol7  @ pol7
     2177             tot-pol8  @ pol8
     2178             tot-pol9  @ pol9
     2179             tot-pol10 @ pol10
     2180             tot-pol15 @ pol15
     2181             tot-pol16 @ pol16
     2182             with frame frame-1
     2183           .
     2184           down stream PrnLibstream
     2185             with frame frame-1.
     2186           if Make-Excel then  put   stream ForExcel unformatted
     2187             "итого"  CHR(9)
     2188             CHR(9)
     2189             CHR(9)
     2190             CHR(9)
     2191             substitute( "&1", tot-pol5  ) CHR(9)
     2192             substitute( "&1", tot-pol6  ) CHR(9)
     2193             substitute( "&1", tot-pol7  ) CHR(9)
     2194             substitute( "&1", tot-pol8  ) CHR(9)
     2195             substitute( "&1", tot-pol9  ) CHR(9)
     2196             substitute( "&1", tot-pol10 ) CHR(9)
     2197             CHR(9)
     2198             CHR(9)
     2199             CHR(9)
     2200             CHR(9)
     2201             substitute( "&1", tot-pol15 ) CHR(9)
     2202             substitute( "&1", tot-pol16 )
     2203             chr(10)
     2204           .
     2205         end.
     2206       end.
     2207     end.
     2208     hide frame frame-1 .
     2209     if Make-Excel then output stream ForExcel close.
     2210     HIDE STREAM PrnLibStream FRAME BottomFrame .
     2211     Output stream PrnLibStream close.
     2212     run waitfram-hide in this-procedure .
     2213     run prn-lib-prn-file in this-procedure
     2214       ( input parParentProc
     2215       , input 8
     2216       ).
     2217   end.
     2218   procedure on-same-page :
     2219     define input parameter p-line-number as integer no-undo .
     2220     if p-line-number > page-size( PrnLibstream )
     2221     then do:
     2222       return .
     2223     end.
     2224     if line-counter( PrnLibstream ) + p-line-number > page-size( PrnLibstream )
     2225     then do:
     2226       page stream PrnLibstream .
     2227     end.
     2228   end procedure.
