     1687       v-cnt-obj = 0.
     1688       for each obj-list :
     1689         v-cnt-obj = v-cnt-obj + 1 .
     1690     end.
     1691     for each sheetf
     1692       where sheetf.sheet-num > 1
     1693     :
     1694       delete sheetf.
     1695     end.
