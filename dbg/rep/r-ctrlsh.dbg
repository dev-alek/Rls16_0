      831   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      832   procedure cur-time :
      833      define output parameter p-today as date      no-undo .
      834      define output parameter p-time  as integer   no-undo .
      835     do
      836     on error undo, return error
      837     :
      838       define variable v-date1 as date      no-undo .
      839       define variable v-date2 as date      no-undo .
      840       define variable v-time  as integer   no-undo .
      841       assign
      842         v-date1 = today
      843         v-time  = time
      844         v-date2 = today
      845       .
      846       if v-date1 <> v-date2
      847       then do:
      848         assign
      849           v-date1 = today
      850           v-time  = v-time
      851         .
      852       end.
      853       assign
      854         p-today = v-date1
      855         p-time  = v-time
      856       .
      857     end.
      858   end.
      859   function cur-time-date returns character
      860   :
      861     return string(today, '99/99/9999':U) .
      862   end.
      863   function cur-time-mjd returns decimal
      864   :
      865     define variable v-date as date      no-undo .
      866     define variable v-time as integer   no-undo .
      867     run cur-time in this-procedure
      868       (output v-date
      869       ,output v-time
      870       ) .
      871     return integer(v-date) - 2400002 + (v-time / 86400) .
      872   end.
      873   function cur-time-get-ending-index returns integer
      874   (input p-number as integer
      875   )
      876   :
      877     if p-number < 0
      878     or p-number = ?
      879     then do:
      880       return 1 .
      881     end.
      882     define variable v-rest as integer   no-undo .
      883     assign
      884       p-number = p-number modulo 100
      885     .
      886     if p-number < 20
      887     then do:
      888       assign
      889         v-rest = p-number
      890       .
      891     end.
      892     else do:
      893       assign
      894         v-rest = p-number modulo 10
      895       .
      896     end.
      897     case v-rest :
      898       when 1
      899       then do:
      900         return 2 .
      901       end.
      902       when 2 or
      903       when 3 or
      904       when 4
      905       then do:
      906         return 3 .
      907       end.
      908       otherwise do:
      909         return 1 .
      910       end.
      911     end case .
      912   end.
      913   procedure cur-time-mjd-to-date :
      914      define input  parameter i-mjd-diff as decimal no-undo.
      915      define output parameter o-Date     as date    no-undo.
      916      define output parameter o-Time     as integer no-undo.
      917      define variable v-day-number as integer   no-undo .
      918      if    i-mjd-diff < 0
      919         or i-mjd-diff = ?
      920      then do:
      921         return "?" .
      922      end.
      923      assign
      924         v-day-number = truncate(i-mjd-diff,0).
      925         o-Date = date(v-day-number + 2400002).
      926         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      927     .
      928   end.
      929   function cur-time-mjd-to-string returns character
      930   (input p-mjd-diff as decimal
      931   )
      932   :
      933     define variable v-day-number as integer   no-undo .
      934     define variable v-seconds    as integer   no-undo .
      935     define variable v-hour       as integer   no-undo .
      936     define variable v-min        as integer   no-undo .
      937     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      938     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      939     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      940     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      941     if p-mjd-diff < 0
      942     or p-mjd-diff = ?
      943     then do:
      944       return "?" .
      945     end.
      946     assign
      947       v-day-number = integer(truncate(p-mjd-diff,0))
      948       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      949     .
      950     if v-seconds > 86400
      951     then do:
      952       assign
      953         v-seconds = 86400 - 1
      954       .
      955     end.
      956     if v-seconds < 0
      957     then do:
      958       assign
      959         v-seconds = 0
      960       .
      961     end.
      962     assign
      963       v-hour = truncate(v-seconds / 3600, 0)
      964     .
      965     assign
      966       v-seconds = v-seconds modulo 3600
      967     .
      968     assign
      969       v-min = truncate(v-seconds / 60, 0)
      970     .
      971     assign
      972       v-seconds = v-seconds modulo 60
      973     .
      974     return
      975         (if v-day-number <> 0
      976           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      977           else ""
      978         )
      979       + (if v-day-number <> 0 or v-hour <> 0
      980           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      981           else ""
      982         )
      983       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      984           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      985           else ""
      986         )
      987       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      988       .
      989   end.
      990   function cur-time-string returns character
      991   :
      992     define variable v-date as date      no-undo .
      993     define variable v-time as integer   no-undo .
      994     run cur-time in this-procedure
      995       (output v-date
      996       ,output v-time
      997       ) .
      998     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      999   end.
     1000   function cur-time-string-sec returns character
     1001   :
     1002     define variable v-date as date      no-undo .
     1003     define variable v-time as integer   no-undo .
     1004     run cur-time in this-procedure
     1005       (output v-date
     1006       ,output v-time
     1007       ) .
     1008     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1009   end.
     1010   function cur-time-custom  returns character
     1011   (input p-prefix as character
     1012   ,input p-date-format as character
     1013   ,input p-delimiter as character
     1014   ,input p-time-format as character
     1015   ,input p-suffix as character
     1016   )
     1017   :
     1018     define variable v-date as date      no-undo .
     1019     define variable v-time as integer   no-undo .
     1020     run cur-time in this-procedure
     1021       (output v-date
     1022       ,output v-time
     1023       ) .
     1024     return
     1025       p-prefix
     1026       + string(v-date, p-date-format)
     1027       + p-delimiter
     1028       + string(v-time, p-time-format)
     1029       + p-suffix
     1030       .
     1031   end.
     1032   function cur-time-print  returns character
     1033   :
     1034     define variable v-date as date      no-undo .
     1035     define variable v-time as integer   no-undo .
     1036     run cur-time in this-procedure
     1037       (output v-date
     1038       ,output v-time
     1039       ) .
     1040     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1041   end.
     1042   function cur-time-datetime returns datetime
     1043   :
     1044     define variable v-char as character no-undo .
     1045     define variable v-datetime as datetime no-undo .
     1046     v-char = cur-time-string().
     1047     v-datetime = datetime(v-char).
     1048     return  v-datetime.
     1049   end.
     1050   function cur-time-string-msec returns character
     1051   :
     1052     define variable v-date as datetime  no-undo .
     1053     v-date = now.
     1054     return string(v-date) .
     1055   end.
     1056   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1057     define variable v-cntxt-db-num        as integer   no-undo .
     1058     define variable v-cntxt-userid        as character no-undo .
     1059     define variable v-cntxt-level         as character no-undo .
     1060     define variable v-cntxt-host-code-obj as integer   no-undo .
     1061     define variable v-cntxt-obj-type      as character no-undo .
     1062     define variable v-cntxt-obj-code      as integer   no-undo .
     1063     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1064     define variable v-cntxt-is-admin      as logical   no-undo .
     1065   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1066   define variable v-waitfram-action01         as character   no-undo .
     1067   define variable v-waitfram-action02         as character   no-undo .
     1068   define variable v-waitfram-action03         as character   no-undo .
     1069   define variable mWaitFramTextBeg            as character   no-undo.
     1070   define variable mWaitFramTextEnd            as character   no-undo.
     1071   define variable mWaitFramView               as logical     no-undo.
     1072   define variable mWaitProcEvent              as logical     no-undo init yes.
     1073   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1074   define variable mWaitFramStop               as logical     no-undo.
     1075   define variable mWaitFramStopUser           as logical     no-undo.
     1076   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1077   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1078   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1079   define button B-WaitFramStop auto-end-key
     1080        label "Стоп"
     1081        size 10 by 1 tooltip "Остоновить процесс".
     1082   define button B-viewProcInfo
     1083        label "Информация"
     1084        size 15 by 1 tooltip "Информация о процесс".
     1085   define frame waitfram
     1086     v-waitfram-action01 format "x(72)" no-label skip
     1087     v-waitfram-action02 format "x(72)" no-label skip
     1088     v-waitfram-action03 format "x(72)" no-label skip
     1089     B-viewProcInfo
     1090     B-WaitFramStop at row 4 col 30
     1091     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1092     .
     1093   define new global shared variable mBatchMode as logical no-undo init ?.
     1094   define variable mFramBachModHandle as handle no-undo.
     1095   mFramBachModHandle = frame waitfram:handle.
     1096   define variable mFameOldVis as logical no-undo.
     1097   define variable mVisCUrentVin as logical no-undo.
     1098   if session:batch-mode
     1099   then
     1100      mBatchMode = yes.
     1101   if mBatchMode = ? then do:
     1102     mVisCUrentVin = current-window:visible.
     1103     mFameOldVis = mFramBachModHandle:visible.
     1104     mFramBachModHandle:visible  = yes.
     1105     mBatchMode = mFramBachModHandle:visible ne yes.
     1106     mFramBachModHandle:visible = mFameOldVis.
     1107     current-window:visible = mVisCUrentVin.
     1108   end.
     1109    if  log-manager:logfile-name ne ?
     1110     then DO:
     1111         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1112         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1113         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1114     end.
     1115   on choose of B-WaitFramStop in frame waitfram
     1116   do:
     1117     mWaitFramStop = yes.
     1118     mWaitFramStopUser = yes.
     1119   end.
     1120   function waitfram-check-timeout returns logical():
     1121      define variable vtime as int64 no-undo.
     1122      if mWaitFramStopTimeOut
     1123      then
     1124         return yes.
     1125      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1126      if     mWaitFramTimeOut ne ?
     1127         and mWaitFramTimeOut ne 0
     1128         and mWaitFramTimeOut lt vtime
     1129      then do:
     1130         mWaitFramStopTimeOut = yes.
     1131      end.
     1132      return mWaitFramStopTimeOut.
     1133   end.
     1134   procedure waitfram-hide :
     1135     if not session:batch-mode
     1136     then do
     1137     on error undo, return error return-value
     1138     :
     1139       pause 0 before-hide .
     1140       if not mBatchMode then
     1141         hide frame waitfram .
     1142     if     not mWaitFramView
     1143        and mWaitProcEvent
     1144     then
     1145       process events .
     1146     end.
     1147   end procedure.
     1148   procedure waitfram-show :
     1149     define input  parameter p-message as character no-undo .
     1150     define variable v-left-margin as integer   no-undo .
     1151     if not session:batch-mode
     1152     then do
     1153     on error undo, return error return-value
     1154     :
     1155       if length(p-message) <= 70 then do:
     1156         assign
     1157           v-left-margin = integer((70 - length(p-message)) / 2)
     1158         .
     1159         assign
     1160           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1161         .
     1162         assign
     1163           v-waitfram-action01 = " "
     1164           v-waitfram-action02 = " "
     1165                                    + fill(" ", v-left-margin)
     1166                                    + p-message
     1167           v-waitfram-action03 = " "
     1168         .
     1169       end.
     1170       else do:
     1171         define variable vRindex1 as integer no-undo.
     1172         define variable vRindex2 as integer no-undo.
     1173         vRindex1 = r-index(p-message," ",70).
     1174         if vRindex1 = 0
     1175         then
     1176            vRindex1 = 70.
     1177         if length(p-message)  <= vRindex1 + 70 then do:
     1178           assign
     1179             v-waitfram-action01 = " "
     1180             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1181             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1182           .
     1183         end.
     1184         else do:
     1185           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1186           if vRindex2 <= vRindex1
     1187           then
     1188              vRindex2 = vRindex1 + 70.
     1189           assign
     1190             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1191             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1192             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1193           .
     1194         end.
     1195       end.
     1196       B-viewProcInfo:visible   in frame waitfram = no.
     1197       B-viewProcInfo:sensitive in frame waitfram = no.
     1198       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1199       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1200       if  (   mWaitFramView
     1201          or  mWaitProcEvent)
     1202          and not mBatchMode
     1203       then
     1204          display
     1205             v-waitfram-action01 skip
     1206             v-waitfram-action02 skip
     1207             v-waitfram-action03 skip
     1208          with frame waitfram .
     1209       if     mWaitFramView
     1210          then do:
     1211             if     mWaitFramInterval ne ?
     1212                and not mBatchMode
     1213             then
     1214                wait-for go of frame waitfram pause mWaitFramInterval.
     1215          end.
     1216          else
     1217             if     mWaitProcEvent
     1218                and not mBatchMode
     1219             then
     1220                process events .
     1221     end.
     1222   end procedure.
     1223      procedure waitfram-show-this:
     1224         define input  parameter iInterval as int64 no-undo.
     1225         define variable vtime as int64 no-undo.
     1226         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1227         mWaitFramInterval = iInterval.
     1228         run waitfram-show (substitute("&1&2 &3&4" ,
     1229                                       mWaitFramTextBeg ,
     1230                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1231                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1232                                       mWaitFramTextEnd
     1233                                      )
     1234                           ).
     1235      end.
     1236      procedure WaitFramRunPause:
     1237         define input  parameter iInterval as dec no-undo.
     1238         define variable vStart  as datetime-tz no-undo.
     1239         define variable vend    as datetime-tz no-undo.
     1240         define variable vint as int64 no-undo.
     1241         define variable vOk as logical no-undo.
     1242         vStart = now.
     1243         vend   = vStart.
     1244         publish "WaitFramPause" (iInterval,output vOk).
     1245         vend   =  now.
     1246         vint = vend - vStart.
     1247         vint = iInterval - vint / 1000.
     1248         if     not mWaitFramStop
     1249            and (   vint > 0
     1250                 or (    not vOk
     1251                     and iInterval eq ?
     1252                     )
     1253                 )
     1254         then
     1255            run waitfram-show-this (iInterval).
     1256         vend   =  now.
     1257         vint = vend - vStart.
     1258         vint = iInterval - vint / 1000.
     1259         if     not mWaitFramStop
     1260            and vint > 0
     1261         then do:
     1262            run gbl/pause.p (vint * 1000).
     1263         end.
     1264         if iInterval ne ?
     1265         then
     1266            publish "WaitFramStop".
     1267         waitfram-check-timeout().
     1268      end.
     1269      procedure WaitFramWaitFor:
     1270         define input  parameter iInterval as dec no-undo.
     1271         assign
     1272            mWaitFramStartProc   = now
     1273            mWaitFramStopUser    = no
     1274            mWaitFramStopTimeOut = no
     1275         .
     1276         block-wait:
     1277         do while not mWaitFramStop:
     1278            run WaitFramRunPause (iInterval).
     1279            if  waitfram-check-timeout()
     1280            then do:
     1281               leave block-wait.
     1282            end.
     1283         end.
     1284         run waitfram-hide.
     1285      end.
     1286   procedure waitfram-join :
     1287     define input  parameter p-line-1  as character no-undo .
     1288     define input  parameter p-line-2  as character no-undo .
     1289     define input  parameter p-line-3  as character no-undo .
     1290     define output parameter p-message as character no-undo .
     1291     do
     1292     on error undo, return error return-value
     1293     :
     1294       assign
     1295         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1296                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1297                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1298       .
     1299     end.
     1300   end procedure.
     1301   function waitfram-join-function returns character
     1302     (input p-line-1 as character
     1303     ,input p-line-2 as character
     1304     ,input p-line-3 as character
     1305     ).
     1306     define variable v-message as character no-undo .
     1307     run waitfram-join in this-procedure
     1308       (input  p-line-1
     1309       ,input  p-line-2
     1310       ,input  p-line-3
     1311       ,output v-message
     1312       ) .
     1313     return v-message .
     1314   end function .
