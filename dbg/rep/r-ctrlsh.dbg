      578   procedure prn-lib-prn-file :
      579     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      580     define input parameter p-DIsabledoptions as integer no-undo .
      581     define variable v-report-name as character no-undo .
      582     define variable v-user-action as character no-undo .
      583     define variable v-printed     as logical   no-undo .
      584     define variable v-exist       as logical   no-undo .
      585     do
      586       on error undo, return error
      587       :
      588       run prn-lib-get-report-name  in this-procedure (
      589         input parParentProc
      590         ,output v-report-name
      591         ).
      592   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      593   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      594     (input  v-report-name
      595     ,input  2
      596     ,output v-exist
      597     )  .
      598       if NOT v-exist then
      599       DO:
      600         Message
      601           "Нет заданий на печать ! "
      602           view-as alert-box .
      603         Return  .
      604       End.
      605       run gbl/prnfilen.w
      606         (input  ""
      607         ,input  p-DisabledOptions
      608         ,input  string(v-report-name )
      609         ,input  7
      610         ,output v-user-action
      611         ,output v-printed
      612         ) .
      613       if v-printed then
      614       do:
      615         return "YES" .
      616       end.
      617       else
      618       do:
      619         return "NO" .
      620       end.
      621     end.
      622   end procedure.
      623   procedure prn-lib-open-stream :
      624     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      625     define input parameter p-page-size    as integer no-undo .
      626     define input parameter p-is-stream    as logical no-undo .
      627     define input parameter p-append       as logical no-undo .
      628     define variable v-report-name as character no-undo .
      629     do
      630       on error undo, return error
      631       :
      632       run prn-lib-get-report-name  in this-procedure (
      633         input parParentProc
      634         ,output v-report-name
      635         ).
      636       if p-is-stream then
      637       do:
      638         if p-append then
      639         do:
      640           output stream PrnLibStream to value( v-report-name )
      641             page-size value(p-page-size) append .
      642         end.
      643         if not p-append then
      644         do:
      645           output stream PrnLibStream to value( v-report-name )
      646             page-size value(p-page-size) .
      647         end.
      648       end.
      649       if not p-is-stream then
      650       do:
      651         if p-append then
      652         do:
      653           output to value( v-report-name )
      654             page-size value(p-page-size) append .
      655         end.
      656         if not p-append then
      657         do:
      658           output to value( v-report-name )
      659             page-size value(p-page-size) .
      660         end.
      661       end.
      662     end.
      663   end procedure.
      664   procedure prn-lib-open-exp :
      665     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      666     define input parameter p-is-stream    as logical no-undo .
      667     define input parameter p-is-append    as logical no-undo .
      668     define output parameter p-ReportFileName as char init "report" no-undo.
      669     define output parameter p-process as logical no-undo .
      670     define variable glog as logical no-undo .
      671     do
      672       on error undo, return error
      673       :
      674       SYSTEM-DIALOG GET-FILE p-ReportFileName
      675         TITLE      "Укажите путь"
      676         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      677         ASK-OVERWRITE
      678         CREATE-TEST-FILE
      679         SAVE-AS
      680         USE-FILENAME
      681         DEFAULT-EXTENSION "txt"
      682         UPDATE glog
      683         .
      684       if not glog then  return.
      685       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      686       if p-is-stream then
      687       do:
      688         if p-is-append then
      689         do:
      690           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      691         end.
      692         else
      693         do:
      694           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      695         end.
      696       end.
      697       else
      698       do:
      699         if p-is-append then
      700         do:
      701           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      702         end.
      703         else
      704         do:
      705           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      706         end.
      707       end.
      708       p-process = yes.
      709     end.
      710   end procedure.
      711   procedure prn-lib-get-report-name :
      712     define input parameter parParentProc  as widget-handle no-undo.
      713     define output parameter p-report-name as character no-undo .
      714     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      715   end procedure.
      716   procedure prn-lib-reportviewer-report-name :
      717     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      718     define input parameter p-report-name-html as character no-undo .
      719     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      720   end procedure.
      721   procedure prn-lib-reportviewer :
      722     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      723     define input parameter p-report-name-html as character no-undo .
      724     define input parameter p-param        as character no-undo .
      725     define variable v-excel           as character no-undo init 'TRUE' .
      726     define variable v-value-character as character no-undo .
      727     define variable v-value-integer   as character no-undo .
      728     define variable v-value-date      as date      no-undo .
      729     define variable v-value-decimal   as decimal   no-undo .
      730     define variable rep-excel         as logical   no-undo .
      731     define variable excel-string      as character no-undo .
      732     define variable v-param-type      as character no-undo .
      733     define variable v-tth             as handle    no-undo .
      734     run adm/shattri.p (
      735       input "get":U
      736       ,input  ""
      737       ,input  0
      738       ,input  'report-glob':U
      739       ,input  'rep-excel':U
      740       ,output v-value-character
      741       ,output v-value-date
      742       ,output v-value-decimal
      743       ,output v-value-integer
      744       ,output rep-excel
      745       ,output v-param-type
      746       ,INPUT-OUTPUT table-handle v-tth
      747       )  .
      748     if rep-excel then v-excel = "TRUE" .
      749     else v-excel = "FALSE" .
      750     if p-param eq ""
      751     then
      752        p-param = "EXCEL:" + v-excel.
      753     else
      754        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      755     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      756   end procedure.
