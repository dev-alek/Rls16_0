     2921     or (can-query (self, "read-only")
     2922        and
     2923        self :read-only = false
     2924        )
     2925     then do:
     2926       if self :handle <> focus :handle
     2927       then do:
     2928         apply "entry":u to self .
     2929       end.
     2930       define variable v-curr-sv-date as date no-undo .
     2931       define variable v-new-sv-date  as date no-undo .
     2932       assign
     2933         v-curr-sv-date = date(self :screen-value) no-error
     2934       .
     2935       if v-curr-sv-date = ?
     2936       then do:
     2937         run gbl/getcurdt.p
     2938           (output v-curr-sv-date
     2939           ) .
     2940       end.
     2941       if v-curr-sv-date <> ?
     2942       then do:
     2943         run gbl/lastdate.p
     2944           (input  v-curr-sv-date
     2945           ,output v-new-sv-date
     2946           ).
     2947         assign
     2948           self :screen-value = string(v-new-sv-date) .
     2949         .
     2950       end.
     2951     end.
     2952     return no-apply .
     2953   end.
     2954   on ctrl-f of date-cred in frame F-Main
     2955   do:
     2956     if (can-query (self, "sensitive")
     2957        and
     2958        self :sensitive = true
     2959        )
     2960     or (can-query (self, "read-only")
     2961        and
     2962        self :read-only = false
     2963        )
     2964     then do:
     2965       if self :handle <> focus :handle
     2966       then do:
     2967         apply "entry":u to self .
     2968       end.
     2969       define variable v-ok            as logical   no-undo .
     2970       define variable v-curr-sv-date  as date      no-undo .
     2971       define variable v-description   as character no-undo .
     2972       assign
     2973         v-curr-sv-date = date(self :screen-value) no-error
     2974       .
     2975       if v-curr-sv-date = ?
     2976       then do:
     2977         run gbl/getcurdt.p
     2978           (output v-curr-sv-date
     2979           ) .
     2980       end.
     2981       if v-curr-sv-date <> ?
     2982       then do:
     2983         run gbl/d-inpday.w
     2984           (input ?
     2985           ,input "Выбор даты"
     2986           ,input v-description
     2987           ,input ""
     2988           ,input-output v-curr-sv-date
     2989           ,output v-ok
     2990           ).
     2991         if v-ok = true
     2992         then do:
     2993           assign
     2994             self :screen-value = string(v-curr-sv-date) .
     2995           .
     2996         end.
     2997       end.
     2998     end.
     2999     return no-apply .
     3000   end.
