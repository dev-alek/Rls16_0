     3244               buf_temp-parts.prod-code = gds-obj.prod-code AND
     3245               buf_temp-parts.obj-type = gds-obj.obj-type AND
     3246               buf_temp-parts.obj-code = gds-obj.obj-code
     3247                                               :
     3248         FIND FIRST buf_parts-attr No-LOCK WHERE
     3249                    buf_parts-attr.in-code = buf_temp-parts.in-code
     3250                AND buf_parts-attr.gds-code = gds-obj.gds-code
     3251                AND buf_parts-attr.part-code = buf_temp-parts.part-code
     3252                    No-ERROR.
