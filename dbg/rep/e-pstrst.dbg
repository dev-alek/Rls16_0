      837   define new global shared variable g#library  as handle no-undo .
      838   define new global shared variable g#library2 as handle no-undo .
      839   define variable var-report-r-b as character no-undo .
      840   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      841   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      842     (output var-report-r-b
      843     )  .
      844   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      845   define variable v-waitfram-action01         as character   no-undo .
      846   define variable v-waitfram-action02         as character   no-undo .
      847   define variable v-waitfram-action03         as character   no-undo .
      848   define variable mWaitFramTextBeg            as character   no-undo.
      849   define variable mWaitFramTextEnd            as character   no-undo.
      850   define variable mWaitFramView               as logical     no-undo.
      851   define variable mWaitProcEvent              as logical     no-undo init yes.
      852   define variable mWaitFramInterval           as integer     no-undo init 1 .
      853   define variable mWaitFramStop               as logical     no-undo.
      854   define variable mWaitFramStopUser           as logical     no-undo.
      855   define variable mWaitFramStopTimeOut        as logical     no-undo.
      856   define variable mWaitFramStartProc          as datetime-tz no-undo.
      857   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      858   define button B-WaitFramStop auto-end-key
      859        label "Стоп"
      860        size 10 by 1 tooltip "Остоновить процесс".
      861   define button B-viewProcInfo
      862        label "Информация"
      863        size 15 by 1 tooltip "Информация о процесс".
      864   define frame waitfram
      865     v-waitfram-action01 format "x(72)" no-label skip
      866     v-waitfram-action02 format "x(72)" no-label skip
      867     v-waitfram-action03 format "x(72)" no-label skip
      868     B-viewProcInfo
      869     B-WaitFramStop at row 4 col 30
      870     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      871     .
      872   define new global shared variable mBatchMode as logical no-undo init ?.
      873   define variable mFramBachModHandle as handle no-undo.
      874   mFramBachModHandle = frame waitfram:handle.
      875   define variable mFameOldVis as logical no-undo.
      876   define variable mVisCUrentVin as logical no-undo.
      877   if session:batch-mode
      878   then
      879      mBatchMode = yes.
      880   if mBatchMode = ? then do:
      881     mVisCUrentVin = current-window:visible.
      882     mFameOldVis = mFramBachModHandle:visible.
      883     mFramBachModHandle:visible  = yes.
      884     mBatchMode = mFramBachModHandle:visible ne yes.
      885     mFramBachModHandle:visible = mFameOldVis.
      886     current-window:visible = mVisCUrentVin.
      887   end.
      888    if  log-manager:logfile-name ne ?
      889     then DO:
      890         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      891         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      892         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      893     end.
      894   on choose of B-WaitFramStop in frame waitfram
      895   do:
      896     mWaitFramStop = yes.
      897     mWaitFramStopUser = yes.
      898   end.
      899   function waitfram-check-timeout returns logical():
      900      define variable vtime as int64 no-undo.
      901      if mWaitFramStopTimeOut
      902      then
      903         return yes.
      904      vtime = ( now - mWaitFramStartProc ) / 1000 .
      905      if     mWaitFramTimeOut ne ?
      906         and mWaitFramTimeOut ne 0
      907         and mWaitFramTimeOut lt vtime
      908      then do:
      909         mWaitFramStopTimeOut = yes.
      910      end.
      911      return mWaitFramStopTimeOut.
      912   end.
      913   procedure waitfram-hide :
      914     if not session:batch-mode
      915     then do
      916     on error undo, return error return-value
      917     :
      918       pause 0 before-hide .
      919       if not mBatchMode then
      920         hide frame waitfram .
      921     if     not mWaitFramView
      922        and mWaitProcEvent
      923     then
      924       process events .
      925     end.
      926   end procedure.
      927   procedure waitfram-show :
      928     define input  parameter p-message as character no-undo .
      929     define variable v-left-margin as integer   no-undo .
      930     if not session:batch-mode
      931     then do
      932     on error undo, return error return-value
      933     :
      934       if length(p-message) <= 70 then do:
      935         assign
      936           v-left-margin = integer((70 - length(p-message)) / 2)
      937         .
      938         assign
      939           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      940         .
      941         assign
      942           v-waitfram-action01 = " "
      943           v-waitfram-action02 = " "
      944                                    + fill(" ", v-left-margin)
      945                                    + p-message
      946           v-waitfram-action03 = " "
      947         .
      948       end.
      949       else do:
      950         define variable vRindex1 as integer no-undo.
      951         define variable vRindex2 as integer no-undo.
      952         vRindex1 = r-index(p-message," ",70).
      953         if vRindex1 = 0
      954         then
      955            vRindex1 = 70.
      956         if length(p-message)  <= vRindex1 + 70 then do:
      957           assign
      958             v-waitfram-action01 = " "
      959             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      960             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      961           .
      962         end.
      963         else do:
      964           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      965           if vRindex2 <= vRindex1
      966           then
      967              vRindex2 = vRindex1 + 70.
      968           assign
      969             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      970             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      971             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      972           .
      973         end.
      974       end.
      975       B-viewProcInfo:visible   in frame waitfram = no.
      976       B-viewProcInfo:sensitive in frame waitfram = no.
      977       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      978       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      979       if  (   mWaitFramView
      980          or  mWaitProcEvent)
      981          and not mBatchMode
      982       then
      983          display
      984             v-waitfram-action01 skip
      985             v-waitfram-action02 skip
      986             v-waitfram-action03 skip
      987          with frame waitfram .
      988       if     mWaitFramView
      989          then do:
      990             if     mWaitFramInterval ne ?
      991                and not mBatchMode
      992             then
      993                wait-for go of frame waitfram pause mWaitFramInterval.
      994          end.
      995          else
      996             if     mWaitProcEvent
      997                and not mBatchMode
      998             then
      999                process events .
     1000     end.
     1001   end procedure.
     1002      procedure waitfram-show-this:
     1003         define input  parameter iInterval as int64 no-undo.
     1004         define variable vtime as int64 no-undo.
     1005         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1006         mWaitFramInterval = iInterval.
     1007         run waitfram-show (substitute("&1&2 &3&4" ,
     1008                                       mWaitFramTextBeg ,
     1009                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1010                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1011                                       mWaitFramTextEnd
     1012                                      )
     1013                           ).
     1014      end.
     1015      procedure WaitFramRunPause:
     1016         define input  parameter iInterval as dec no-undo.
     1017         define variable vStart  as datetime-tz no-undo.
     1018         define variable vend    as datetime-tz no-undo.
     1019         define variable vint as int64 no-undo.
     1020         define variable vOk as logical no-undo.
     1021         vStart = now.
     1022         vend   = vStart.
     1023         publish "WaitFramPause" (iInterval,output vOk).
     1024         vend   =  now.
     1025         vint = vend - vStart.
     1026         vint = iInterval - vint / 1000.
     1027         if     not mWaitFramStop
     1028            and (   vint > 0
     1029                 or (    not vOk
     1030                     and iInterval eq ?
     1031                     )
     1032                 )
     1033         then
     1034            run waitfram-show-this (iInterval).
     1035         vend   =  now.
     1036         vint = vend - vStart.
     1037         vint = iInterval - vint / 1000.
     1038         if     not mWaitFramStop
     1039            and vint > 0
     1040         then do:
     1041            run gbl/pause.p (vint * 1000).
     1042         end.
     1043         if iInterval ne ?
     1044         then
     1045            publish "WaitFramStop".
     1046         waitfram-check-timeout().
     1047      end.
     1048      procedure WaitFramWaitFor:
     1049         define input  parameter iInterval as dec no-undo.
     1050         assign
     1051            mWaitFramStartProc   = now
     1052            mWaitFramStopUser    = no
     1053            mWaitFramStopTimeOut = no
     1054         .
     1055         block-wait:
     1056         do while not mWaitFramStop:
     1057            run WaitFramRunPause (iInterval).
     1058            if  waitfram-check-timeout()
     1059            then do:
     1060               leave block-wait.
     1061            end.
     1062         end.
     1063         run waitfram-hide.
     1064      end.
     1065   procedure waitfram-join :
     1066     define input  parameter p-line-1  as character no-undo .
     1067     define input  parameter p-line-2  as character no-undo .
     1068     define input  parameter p-line-3  as character no-undo .
     1069     define output parameter p-message as character no-undo .
     1070     do
     1071     on error undo, return error return-value
     1072     :
     1073       assign
     1074         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1075                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1076                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1077       .
     1078     end.
     1079   end procedure.
     1080   function waitfram-join-function returns character
     1081     (input p-line-1 as character
     1082     ,input p-line-2 as character
     1083     ,input p-line-3 as character
     1084     ).
     1085     define variable v-message as character no-undo .
     1086     run waitfram-join in this-procedure
     1087       (input  p-line-1
     1088       ,input  p-line-2
     1089       ,input  p-line-3
     1090       ,output v-message
     1091       ) .
     1092     return v-message .
     1093   end function .
     1094   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1095   procedure factord :
     1096     define input  parameter p-fact-date            as date    no-undo .
     1097     define input  parameter p-fact-time            as integer no-undo .
     1098     define input  parameter p-fact-num             as integer no-undo .
     1099     define input  parameter p-shift-date           as date    no-undo .
     1100     define input  parameter p-shift-num            as integer no-undo .
     1101     define input  parameter p-shift-on             as logical no-undo .
     1102     define output parameter p-fact-order           as decimal no-undo .
     1103     define output parameter p-shift-end-fact-order as decimal no-undo .
     1104     define output parameter p-day-end-fact-order   as decimal no-undo .
     1105     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     1106     if p-fact-date = ?
     1107     then do:
     1108       return error "Не указана фактическая дата" .
     1109     end.
     1110     define variable v-fact-date-num as integer no-undo .
     1111     assign
     1112       v-fact-date-num = integer(p-fact-date)
     1113     .
     1114     if p-fact-num = ?
     1115     or p-fact-num = 0
     1116     then do:
     1117       return error "Не задан p-fact-num " + string(p-fact-num) .
     1118     end.
     1119     if p-fact-num < 0
     1120     then do:
     1121       return error "Отрицательный fact-num " + string(p-fact-num) .
     1122     end.
     1123     if p-fact-num >= 100000000
     1124     then do:
     1125       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     1126     end.
     1127     if p-shift-on = true
     1128     then do:
     1129       if p-shift-date = ?
     1130       then do:
     1131         return error "Не задана дата смены" .
     1132       end.
     1133       if p-shift-num = ?
     1134       or p-shift-num = 0
     1135       then do:
     1136         return error "Не задан номер смены" .
     1137       end.
     1138     end.
     1139     else do:
     1140       assign
     1141         p-shift-date = p-fact-date
     1142         p-shift-num  = 24
     1143       .
     1144     end.
     1145     define variable v-shift-offset as integer no-undo .
     1146     if p-shift-date = p-fact-date
     1147     then do:
     1148       assign
     1149         v-shift-offset = 1
     1150       .
     1151     end.
     1152     if p-shift-date < p-fact-date
     1153     then do:
     1154       assign
     1155         v-shift-offset = 0
     1156       .
     1157     end.
     1158     if p-shift-date > p-fact-date
     1159     then do:
     1160       message
     1161         vss-workfile vss-revision vss-description skip
     1162         "Неправильная дата закрытия смены" skip
     1163         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     1164         view-as alert-box error .
     1165       undo, return error
     1166         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     1167           ,string(p-fact-date, '99/99/9999':U)
     1168           ,string(p-shift-date, '99/99/9999':U)
     1169           )
     1170       .
     1171     end.
     1172     if p-shift-num < 1
     1173     or p-shift-num > 24
     1174     then do:
     1175       message
     1176         vss-workfile vss-revision vss-description skip
     1177         "Неправильный номер смены" skip
     1178         "p-shift-num" p-shift-num skip
     1179         view-as alert-box error .
     1180       undo, return error return-value .
     1181     end.
     1182     assign
     1183       p-fact-order           = v-fact-date-num
     1184                              + v-shift-offset * 0.5
     1185                              + p-shift-num    * 0.02 - 0.01
     1186                              + p-fact-num     * 0.0000000001
     1187       p-shift-end-fact-order = v-fact-date-num
     1188                              + v-shift-offset * 0.5
     1189                              + p-shift-num    * 0.02
     1190       p-day-end-fact-order   = v-fact-date-num
     1191                              + 0.99
     1192     .
     1193     if p-fact-order           <= v-fact-date-num
     1194     or p-shift-end-fact-order <= v-fact-date-num
     1195     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     1196     or p-shift-end-fact-order >= p-day-end-fact-order
     1197     then do:
     1198       message
     1199         vss-workfile vss-revision vss-description skip
     1200         "Внутренняя ошибка при генерации фактического номера" skip
     1201         "p-fact-date"            p-fact-date            skip
     1202         "p-fact-time"            p-fact-time            skip
     1203         "p-fact-num"             p-fact-num             skip
     1204         "p-shift-date"           p-shift-date           skip
     1205         "p-shift-num"            p-shift-num            skip
     1206         "p-shift-on"             p-shift-on             skip
     1207         "p-shift-end-fact-order" p-shift-end-fact-order skip
     1208         "p-day-end-fact-order"   p-day-end-fact-order   skip
     1209         "v-fact-date-num"        v-fact-date-num        skip
     1210         view-as alert-box error .
     1211       undo, return error return-value .
     1212     end.
     1213   end procedure.
     1214   procedure day-begin-fact-order :
     1215     define input  parameter p-fact-date            as date    no-undo .
     1216     define output parameter p-day-begin-fact-order as decimal no-undo .
     1217     do
     1218     on error undo, return error return-value
     1219     :
     1220       if p-fact-date = ?
     1221       then do:
     1222         assign
     1223           p-day-begin-fact-order = 0
     1224         .
     1225       end.
     1226       else do:
     1227         assign
     1228           p-day-begin-fact-order = integer(p-fact-date)
     1229         .
     1230       end.
     1231     end.
     1232   end procedure.
     1233   procedure factord-max-fact-order :
     1234     define output parameter p-max-fact-order as decimal   no-undo .
     1235     do
     1236     on error undo, return error return-value
     1237     :
     1238       run day-begin-fact-order in this-procedure
     1239         (input  date(1, 1, 5000)
     1240         ,output p-max-fact-order
     1241         ) .
     1242     end.
     1243   end procedure.
     1244   procedure factord-cut-archive :
     1245     define input  parameter p-obj-type             as character no-undo .
     1246     define input  parameter p-obj-code             as integer   no-undo .
     1247     define input  parameter p-fact-date            as date      no-undo .
     1248     define output parameter p-shift-on             as logical   no-undo .
     1249     define output parameter p-shift-date           as date      no-undo .
     1250     define output parameter p-shift-num            as integer   no-undo .
     1251     define output parameter p-day-end-fact-order   as decimal   no-undo .
     1252     define output parameter p-shift-end-fact-order as decimal   no-undo .
     1253     define variable v-fact-order as decimal   no-undo .
     1254     define buffer buf_shift-obj for ub.shift-obj .
     1255     do
     1256     on error undo, return error return-value
     1257     :
     1258   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1259   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1260     (input  p-obj-type
     1261     ,input  p-obj-code
     1262     ,input  'shift-on=request'
     1263     ,output p-shift-on
     1264     ) no-error .
     1265       if error-status :error
     1266       then do:
     1267         message
     1268           vss-workfile vss-revision vss-description skip
     1269           "Ошибка при определении атрибута объекта" skip
     1270           "Объект" p-obj-type p-obj-code skip
     1271           error-status :get-message(1) skip
     1272           return-value skip
     1273           view-as alert-box error .
     1274         undo, return error return-value .
     1275       end.
     1276       if p-shift-on = false
     1277       then do:
     1278         assign
     1279           p-shift-date               = ?
     1280           p-shift-num                = 0
     1281         .
     1282       end.
     1283       else do:
     1284         find first buf_shift-obj share-lock
     1285           where buf_shift-obj.obj-type   = p-obj-type
     1286             and buf_shift-obj.obj-code   = p-obj-code
     1287             and buf_shift-obj.shift-date > p-fact-date
     1288           use-index pi
     1289           no-error .
     1290         if not available buf_shift-obj
     1291         or buf_shift-obj.status_ <> 'зкр':U
     1292         then do:
     1293           message
     1294             vss-workfile vss-revision vss-description skip
     1295             "Невозможно вычислить последнюю смену" skip
     1296             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1297             "Объект" p-obj-type p-obj-code skip
     1298             "Дата" p-fact-date skip
     1299             view-as alert-box error .
     1300           undo, return error return-value .
     1301         end.
     1302         find last buf_shift-obj share-lock
     1303           where buf_shift-obj.obj-type = p-obj-type
     1304             and buf_shift-obj.obj-code = p-obj-code
     1305             and buf_shift-obj.shift-date <= p-fact-date
     1306           use-index pi
     1307           no-error .
     1308         if available buf_shift-obj
     1309         then do:
     1310           if  buf_shift-obj.status_ = 'зкр':U
     1311           then do:
     1312             assign
     1313               p-shift-date = buf_shift-obj.shift-date
     1314               p-shift-num  = buf_shift-obj.shift-num
     1315             .
     1316           end.
     1317           else do:
     1318             message
     1319               vss-workfile vss-revision vss-description skip
     1320               "Невозможно вычислить последнюю смену" skip
     1321               "Статус смены отличен от статуса" 'зкр':U skip
     1322               "Объект" p-obj-type p-obj-code skip
     1323               "Дата" p-fact-date skip
     1324               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1325               view-as alert-box error .
     1326             undo, return error return-value .
     1327           end.
     1328         end.
     1329         else do:
     1330           assign
     1331             p-shift-date = p-fact-date - 1
     1332             p-shift-num  = 1
     1333           .
     1334         end.
     1335       end.
     1336       run factord in this-procedure
     1337         (input  p-fact-date
     1338         ,input  1
     1339         ,input  1
     1340         ,input  p-shift-date
     1341         ,input  p-shift-num
     1342         ,input  p-shift-on
     1343         ,output v-fact-order
     1344         ,output p-shift-end-fact-order
     1345         ,output p-day-end-fact-order
     1346         ) no-error .
     1347       if error-status :error
     1348       then do:
     1349         message
     1350           vss-workfile vss-revision vss-description skip
     1351           "Ошибка при вызове процедуры factord"
     1352           error-status :get-message(1) skip
     1353           return-value skip
     1354           view-as alert-box error .
     1355         undo, return error return-value .
     1356       end.
     1357     end.
     1358   end procedure.
     1359   procedure factord-lock-shift :
     1360     define input  parameter p-obj-type  as character no-undo .
     1361     define input  parameter p-obj-code  as integer   no-undo .
     1362     define input  parameter p-fact-date as date      no-undo .
     1363     define parameter buffer buf_shift-obj for ub.shift-obj .
     1364     define variable v-shift-on      as logical   no-undo .
     1365     define variable v-extra-message as character no-undo .
     1366     define variable v-error as character no-undo .
     1367     do
     1368     on error undo, return error return-value
     1369     :
     1370   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1371   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1372     (input  p-obj-type
     1373     ,input  p-obj-code
     1374     ,input  'shift-on=request'
     1375     ,output v-shift-on
     1376     ) no-error .
     1377       if error-status :error
     1378       then do:
     1379         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1380         undo, return error v-error .
     1381       end.
     1382       if v-shift-on = true
     1383       then do:
     1384         find first buf_shift-obj share-lock
     1385           where buf_shift-obj.obj-type   = p-obj-type
     1386             and buf_shift-obj.obj-code   = p-obj-code
     1387             and buf_shift-obj.shift-date > p-fact-date
     1388           use-index pi
     1389           no-error .
     1390         if not available buf_shift-obj
     1391         or buf_shift-obj.status_ <> 'зкр':U
     1392         then do:
     1393           find last buf_shift-obj
     1394             where buf_shift-obj.obj-type = p-obj-type
     1395               and buf_shift-obj.obj-code = p-obj-code
     1396               and buf_shift-obj.status_  = 'зкр':U
     1397             use-index stts
     1398             no-error .
     1399           if available buf_shift-obj
     1400           then do:
     1401             assign
     1402               v-extra-message =
     1403                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1404                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1405                               )
     1406             .
     1407           end.
     1408           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1409           undo, return error v-error .
     1410         end.
     1411       end.
     1412     end.
     1413   end procedure.
     1414   procedure factord-end-day :
     1415     define input  parameter p-fact-date            as date    no-undo .
     1416     define output parameter p-day-end-fact-order   as decimal no-undo .
     1417     do
     1418     on error undo, return error return-value
     1419     :
     1420       if p-fact-date = ?
     1421       then do:
     1422         return error "Не указана фактическая дата" .
     1423       end.
     1424       assign
     1425         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1426       .
     1427     end.
     1428   end procedure.
     1429   procedure factord-to-date :
     1430     define input  parameter p-fact-order as decimal no-undo .
     1431     define output parameter p-fact-date  as date    no-undo .
     1432     define variable v-ref-date  as date      no-undo .
     1433     define variable v-ref-delta as integer   no-undo .
     1434     do
     1435     on error undo, return error return-value
     1436     :
     1437       if p-fact-order = ?
     1438       or p-fact-order = 0
     1439       then do:
     1440         return error "Не указан fact-order" .
     1441       end.
     1442       assign
     1443         v-ref-date  = date(1, 1, 2000)
     1444       .
     1445       assign
     1446         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1447       .
     1448       assign
     1449         p-fact-date = v-ref-date + v-ref-delta
     1450       .
     1451     end.
     1452   end procedure.
     1453   procedure factord-to-fact-num :
     1454     define input  parameter p-fact-order as decimal no-undo .
     1455     define output parameter p-fact-num   as integer no-undo .
     1456     define variable v-fact-order-trunc as decimal no-undo .
     1457     do
     1458     on error undo, return error return-value
     1459     :
     1460       if p-fact-order = ?
     1461       or p-fact-order = 0
     1462       then do:
     1463         return error "Не указан fact-order" .
     1464       end.
     1465       assign
     1466        v-fact-order-trunc = truncate(p-fact-order, 2)
     1467       .
     1468       assign
     1469         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1470       .
     1471     end.
     1472   end procedure.
     1473   procedure factord-to-shift-num :
     1474     define input  parameter p-fact-order as decimal no-undo .
     1475     define output parameter p-shift-num   as integer no-undo .
     1476     define variable  p-shift-numd  as decimal   no-undo .
     1477     define variable v-fact-order-trunc as decimal no-undo .
     1478     do
     1479     on error undo, return error return-value
     1480     :
     1481       if p-fact-order = ?
     1482       or p-fact-order = 0
     1483       then do:
     1484         return error "Не указан fact-order" .
     1485       end.
     1486       assign
     1487        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1488       .
     1489       if v-fact-order-trunc < 0.5 then do:
     1490         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1491       end.
     1492       assign
     1493         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1494         .
     1495        assign
     1496         p-shift-num = truncate (p-shift-numd , 0)
     1497       .
     1498     end.
     1499   end procedure.
     1500   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1501   define temp-table temp-parts no-undo   like ub.parts   field free-qnty as decimal   field free-cli-qnty as decimal .
     1502   procedure partslib-clear-temp-parts :
     1503     define buffer buf_temp-parts for temp-parts .
     1504     do
     1505     on error undo, return error
     1506     :
     1507       for each buf_temp-parts
     1508       on error undo, return error
     1509       :
     1510         delete buf_temp-parts .
     1511       end.
     1512     end.
     1513   end procedure.
     1514   procedure partslib-create-temp-parts :
     1515     define parameter buffer buf_parts       for ub.parts .
     1516     define parameter buffer buf_temp-parts  for temp-parts .
     1517     define input  parameter p-goods-twounit as logical   no-undo .
     1518     define variable v-base-part-code as character no-undo .
     1519     do
     1520     on error undo, return error
     1521     :
     1522       if p-goods-twounit = true
     1523       then do:
     1524         assign
     1525           v-base-part-code = entry(1, buf_parts.part-code, '#':U)
     1526         .
     1527       end.
     1528       else do:
     1529         assign
     1530           v-base-part-code = buf_parts.part-code
     1531         .
     1532       end.
     1533       find first buf_temp-parts exclusive-lock
     1534         where buf_temp-parts.obj-type  = buf_parts.obj-type
     1535           and buf_temp-parts.obj-code  = buf_parts.obj-code
     1536           and buf_temp-parts.artic     = buf_parts.artic
     1537           and buf_temp-parts.prod-type = buf_parts.prod-type
     1538           and buf_temp-parts.prod-code = buf_parts.prod-code
     1539           and buf_temp-parts.in-code   = buf_parts.in-code
     1540           and buf_temp-parts.out-code  = 'free-zone':U
     1541           and buf_temp-parts.part-code = v-base-part-code
     1542         no-error.
     1543       if not available buf_temp-parts
     1544       then do:
     1545         create buf_temp-parts .
     1546         buffer-copy buf_parts to buf_temp-parts
     1547         assign
     1548           buf_temp-parts.out-code  = 'free-zone':U
     1549           buf_temp-parts.part-code = v-base-part-code
     1550           buf_temp-parts.rsrv-free = yes
     1551           buf_temp-parts.status_   = no
     1552           buf_temp-parts.qnty      = 0
     1553           buf_temp-parts.fact-qnty = 0
     1554           buf_temp-parts.real-qnty = 0
     1555           buf_temp-parts.cli-qnty  = 0
     1556         .
     1557       end.
     1558     end.
     1559   end procedure.
     1560   procedure partslib-init-temp-parts :
     1561     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
     1562     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
     1563     define input parameter p-artic           like ub.parts.artic     no-undo .
     1564     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
     1565     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
     1566     define buffer buf_parts      for ub.parts .
     1567     define buffer buf_temp-parts for temp-parts .
     1568     define variable v-goods-twounit    as logical   no-undo .
     1569     do
     1570     on error undo, return error
     1571     :
     1572   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1573   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1574     (input  p-artic
     1575     ,input  p-prod-type
     1576     ,input  p-prod-code
     1577     ,input  'twounit=request':u
     1578     ,output v-goods-twounit
     1579     ) no-error .
     1580       if error-status :error
     1581       then do:
     1582         message
     1583           vss-workfile vss-revision vss-description skip
     1584           vss-include-info13 skip
     1585           "Ошибка при определении атрибута товара" skip
     1586           "Артикул" p-artic p-prod-type p-prod-code skip
     1587           "twounit=request" skip
     1588           error-status :get-message(1) skip
     1589           return-value skip
     1590           view-as alert-box error .
     1591         undo, return error return-value .
     1592       end.
     1593       run partslib-clear-temp-parts in this-procedure .
     1594       for each buf_parts
     1595         where buf_parts.obj-type  = p-obj-type
     1596           and buf_parts.obj-code  = p-obj-code
     1597           and buf_parts.artic     = p-artic
     1598           and buf_parts.prod-type = p-prod-type
     1599           and buf_parts.prod-code = p-prod-code
     1600           and buf_parts.rsrv-free = yes
     1601           and buf_parts.status_   = no
     1602           and buf_parts.in-code   <> buf_parts.out-code
     1603       on error undo, return error
     1604       :
     1605         run partslib-create-temp-parts in this-procedure
     1606           (buffer buf_parts
     1607           ,buffer buf_temp-parts
     1608           ,input  v-goods-twounit
     1609           ) .
     1610         define variable v-parts-qnty          as decimal   no-undo .
     1611         define variable v-parts-cli-qnty      as decimal   no-undo .
     1612         define variable v-parts-free-qnty     as decimal   no-undo .
     1613         define variable v-parts-free-cli-qnty as decimal   no-undo .
     1614         if buf_parts.out-code = 'free-zone':U
     1615         then do:
     1616           assign
     1617             v-parts-qnty          = buf_parts.qnty
     1618             v-parts-cli-qnty      = buf_parts.cli-qnty
     1619             v-parts-free-qnty     = buf_parts.qnty
     1620             v-parts-free-cli-qnty = buf_parts.cli-qnty
     1621           .
     1622         end.
     1623         else do:
     1624           assign
     1625             v-parts-qnty          = abs(buf_parts.qnty)
     1626             v-parts-cli-qnty      = abs(buf_parts.cli-qnty)
     1627             v-parts-free-qnty     = 0
     1628             v-parts-free-cli-qnty = 0
     1629           .
     1630         end.
     1631         assign
     1632           buf_temp-parts.qnty          = buf_temp-parts.qnty          + v-parts-qnty
     1633           buf_temp-parts.fact-qnty     = buf_temp-parts.fact-qnty     + v-parts-qnty
     1634           buf_temp-parts.real-qnty     = 0
     1635           buf_temp-parts.cli-qnty      = buf_temp-parts.cli-qnty      + v-parts-cli-qnty
     1636           buf_temp-parts.free-qnty     = buf_temp-parts.free-qnty     + v-parts-free-qnty
     1637           buf_temp-parts.free-cli-qnty = buf_temp-parts.free-cli-qnty + v-parts-free-cli-qnty
     1638         .
     1639       end.
     1640     end.
     1641   end procedure.
     1642   procedure partslib-init-temp-parts-by-factord :
     1643     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
     1644     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
     1645     define input parameter p-artic              like ub.parts.artic     no-undo .
     1646     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
     1647     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
     1648     define input parameter p-fact-order         as decimal   no-undo .
     1649     define input parameter p-include-fact-order as logical   no-undo .
     1650     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
     1651     define buffer buf_gds-obj  for ub.gds-obj .
     1652     do
     1653     on error undo, return error
     1654     :
     1655       do transaction
     1656       on error undo, return error
     1657       :
     1658   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1659   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     1660     (input  p-obj-type
     1661     ,input  p-obj-code
     1662     ,input  p-artic
     1663     ,input  p-prod-type
     1664     ,input  p-prod-code
     1665     ,buffer buf_gds-obj
     1666     ) no-error .
     1667         if error-status :error
     1668         then do:
     1669           message
     1670             vss-workfile vss-revision vss-description skip
     1671             vss-include-info13 skip
     1672             "Невозможно найти товар на объекте" skip
     1673             "Объект" p-obj-type p-obj-code skip
     1674             "Артикул" p-artic p-prod-type p-prod-code skip
     1675             error-status :get-message(1) skip
     1676             return-value skip
     1677             view-as alert-box error .
     1678           undo, return error .
     1679         end.
     1680         find current buf_gds-obj exclusive-lock .
     1681       end.
     1682       run partslib-init-temp-parts in this-procedure
     1683         (input p-obj-type
     1684         ,input p-obj-code
     1685         ,input p-artic
     1686         ,input p-prod-type
     1687         ,input p-prod-code
     1688         ) no-error .
     1689       if error-status :error
     1690       then do:
     1691         message
     1692           vss-workfile vss-revision vss-description skip
     1693           vss-include-info13 skip
     1694           "Ошибка при инициализации текущего остатка по партиям свободной зоны" skip
     1695           "Объект" p-obj-type p-obj-code skip
     1696           "Артикул" p-artic p-prod-type p-prod-code skip
     1697           "p-fact-order" p-fact-order skip
     1698           view-as alert-box error .
     1699         undo, return error .
     1700       end.
     1701       if p-include-fact-order = true
     1702       then do:
     1703         assign
     1704           p-fact-order = p-fact-order - 0.0000000001
     1705         .
     1706       end.
     1707       define variable v-max-fact-order as character no-undo .
     1708       run factord-max-fact-order in this-procedure
     1709         (output v-max-fact-order
     1710         ) no-error .
     1711       if error-status :error
     1712       then do:
     1713         message
     1714           vss-workfile vss-revision vss-description skip
     1715           vss-include-info13 skip
     1716           "Ошибка при вызове процедуры factord-max-fact-order" skip
     1717           "Объект" p-obj-type p-obj-code skip
     1718           "Артикул" p-artic p-prod-type p-prod-code skip
     1719           "p-fact-order" p-fact-order skip
     1720           view-as alert-box error .
     1721         undo, return error .
     1722       end.
     1723       run partslib-update-by-factord in this-procedure
     1724         (input p-obj-type
     1725         ,input p-obj-code
     1726         ,input p-artic
     1727         ,input p-prod-type
     1728         ,input p-prod-code
     1729         ,input p-fact-order
     1730         ,input v-max-fact-order
     1731         ,input false
     1732         ) no-error .
     1733       if error-status :error
     1734       then do:
     1735         message
     1736           vss-workfile vss-revision vss-description skip
     1737           vss-include-info13 skip
     1738           "Ошибка при вызове процедуры partslib-update-by-factord" skip
     1739           "Объект" p-obj-type p-obj-code skip
     1740           "Артикул" p-artic p-prod-type p-prod-code skip
     1741           "p-fact-order" p-fact-order skip
     1742           "v-max-fact-order" v-max-fact-order skip
     1743           view-as alert-box error .
     1744         undo, return error .
     1745       end.
     1746     end.
     1747   end procedure.
     1748   procedure partslib-update-by-factord :
     1749     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
     1750     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
     1751     define input parameter p-artic              like ub.parts.artic     no-undo .
     1752     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
     1753     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
     1754     define input parameter p-start-fact-order   as decimal   no-undo .
     1755     define input parameter p-end-fact-order     as decimal   no-undo .
     1756     define input parameter p-lock-gds-obj       as logical   no-undo .
     1757     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
     1758     define buffer buf_gds-obj  for ub.gds-obj .
     1759     define buffer buf_doc-line for ub.doc-line .
     1760     define variable v-total-parts-qnty as decimal   no-undo .
     1761     define variable v-goods-gds-goods  as logical   no-undo .
     1762     define variable v-goods-twounit    as logical   no-undo .
     1763     do
     1764     on error undo, return error
     1765     :
     1766       if p-start-fact-order > p-end-fact-order
     1767       then do:
     1768         message
     1769           vss-workfile vss-revision vss-description skip
     1770           vss-include-info13 skip
     1771           "Ошибка задания входных параметров" skip
     1772           "Начало интервала превышает конец интервала" skip
     1773           "Объект" p-obj-type p-obj-code skip
     1774           "Артикул" p-artic p-prod-type p-prod-code skip
     1775           "p-start-fact-order" p-start-fact-order skip
     1776           "p-end-fact-order"   p-end-fact-order skip
     1777           view-as alert-box error .
     1778         undo, return error .
     1779       end.
     1780       if p-lock-gds-obj = true
     1781       then do:
     1782         do transaction
     1783         on error undo, return error
     1784         :
     1785   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1786   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     1787     (input  p-obj-type
     1788     ,input  p-obj-code
     1789     ,input  p-artic
     1790     ,input  p-prod-type
     1791     ,input  p-prod-code
     1792     ,buffer buf_gds-obj
     1793     ) no-error .
     1794           if error-status :error
     1795           then do:
     1796             message
     1797               vss-workfile vss-revision vss-description skip
     1798               vss-include-info13 skip
     1799               "Невозможно найти gds-obj" skip
     1800               error-status :get-message(1) skip
     1801               return-value skip
     1802               view-as alert-box error .
     1803             undo, return error .
     1804           end.
     1805           find current buf_gds-obj exclusive-lock .
     1806         end.
     1807       end.
     1808   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1809   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1810     (input  p-artic
     1811     ,input  p-prod-type
     1812     ,input  p-prod-code
     1813     ,input  'gds-goods=request':u
     1814     ,output v-goods-gds-goods
     1815     ) no-error .
     1816       if error-status :error
     1817       then do:
     1818         message
     1819           vss-workfile vss-revision vss-description skip
     1820           vss-include-info13 skip
     1821           "Ошибка при определении атрибута товара" skip
     1822           "Артикул" p-artic p-prod-type p-prod-code skip
     1823           "gds-goods=request" skip
     1824           error-status :get-message(1) skip
     1825           return-value skip
     1826           view-as alert-box error .
     1827         undo, return error return-value .
     1828       end.
     1829   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1830   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1831     (input  p-artic
     1832     ,input  p-prod-type
     1833     ,input  p-prod-code
     1834     ,input  'twounit=request':u
     1835     ,output v-goods-twounit
     1836     ) no-error .
     1837       if error-status :error
     1838       then do:
     1839         message
     1840           vss-workfile vss-revision vss-description skip
     1841           vss-include-info13 skip
     1842           "Ошибка при определении атрибута товара" skip
     1843           "Артикул" p-artic p-prod-type p-prod-code skip
     1844           "twounit=request" skip
     1845           error-status :get-message(1) skip
     1846           return-value skip
     1847           view-as alert-box error .
     1848         undo, return error return-value .
     1849       end.
     1850       for each buf_doc-line no-lock
     1851         where buf_doc-line.obj-type   = p-obj-type
     1852           and buf_doc-line.obj-code   = p-obj-code
     1853           and buf_doc-line.artic      = p-artic
     1854           and buf_doc-line.prod-type  = p-prod-type
     1855           and buf_doc-line.prod-code  = p-prod-code
     1856           and buf_doc-line.status_    = 'факт':U
     1857           and buf_doc-line.fact-order > p-start-fact-order
     1858           and buf_doc-line.fact-order <= p-end-fact-order
     1859       on error undo, return error
     1860       :
     1861         run partslib-process-document in this-procedure
     1862           (input  buf_doc-line.doc-code
     1863           ,input  p-obj-type
     1864           ,input  p-obj-code
     1865           ,input  p-artic
     1866           ,input  p-prod-type
     1867           ,input  p-prod-code
     1868           ,input  v-goods-gds-goods
     1869           ,input  v-goods-twounit
     1870           ,output v-total-parts-qnty
     1871           ) no-error .
     1872         if error-status :error
     1873         then do:
     1874           message
     1875             vss-workfile vss-revision vss-description skip
     1876             vss-include-info13 skip
     1877             "Ошибка при вызове процедуры partslib-process-document" skip
     1878             "Документ" buf_doc-line.doc-code skip
     1879             "Объект" p-obj-type p-obj-code skip
     1880             "Артикул" p-artic p-prod-type p-prod-code skip
     1881             "p-start-fact-order" p-start-fact-order skip
     1882             "p-end-fact-order" p-end-fact-order skip
     1883             error-status :get-message(1) skip
     1884             return-value skip
     1885             view-as alert-box error .
     1886           undo, return error return-value .
     1887         end.
     1888       end.
     1889     end.
     1890   end procedure.
     1891   procedure partslib-process-document :
     1892     define input  parameter p-doc-code         as character no-undo .
     1893     define input  parameter p-obj-type         as character no-undo .
     1894     define input  parameter p-obj-code         as integer   no-undo .
     1895     define input  parameter p-artic            as character no-undo .
     1896     define input  parameter p-prod-type        as character no-undo .
     1897     define input  parameter p-prod-code        as integer   no-undo .
     1898     define input  parameter p-goods-gds-goods  as logical   no-undo .
     1899     define input  parameter p-goods-twounit    as logical   no-undo .
     1900     define output parameter p-total-parts-qnty as decimal   no-undo .
     1901     define variable v-parts-sign as integer   no-undo .
     1902     define buffer buf_trn-doc    for ub.trn-doc .
     1903     define buffer buf_doc-line   for ub.doc-line .
     1904     define buffer buf_parts      for ub.parts .
     1905     define buffer buf_temp-parts for temp-parts .
     1906     do
     1907     on error undo, return error return-value
     1908     :
     1909       find first buf_trn-doc no-lock
     1910         where buf_trn-doc.doc-code = p-doc-code
     1911         no-error .
     1912       if not available buf_trn-doc
     1913       then do:
     1914         undo, return error substitute("Ошибка при поиске документа. Документ &1"
     1915                                      ,p-doc-code
     1916                                      ) .
     1917       end.
     1918       case buf_trn-doc.doc-type
     1919       :
     1920         when 'при':U or
     1921         when 'возврат':U or
     1922         when 'инв':U
     1923         then do:
     1924           assign
     1925             v-parts-sign = -1
     1926           .
     1927         end.
     1928         when 'рас':U or
     1929         when 'спи':U
     1930         then do:
     1931           assign
     1932             v-parts-sign = 1
     1933           .
     1934         end.
     1935         otherwise do:
     1936           undo, return error substitute("Неизвестный тип документа &1"
     1937                                       ,buf_trn-doc.doc-type
     1938                                       ) .
     1939         end.
     1940       end.
     1941       find first buf_doc-line no-lock
     1942         where buf_doc-line.doc-code  = p-doc-code
     1943           and buf_doc-line.artic     = p-artic
     1944           and buf_doc-line.prod-type = p-prod-type
     1945           and buf_doc-line.prod-code = p-prod-code
     1946         no-error .
     1947       if not available buf_doc-line
     1948       then do:
     1949         undo, return error substitute("Ошибка при поиске строки документа. Документ &1. Артикул &2 &3 &4"
     1950                                      ,p-doc-code
     1951                                      ,artic
     1952                                      ,prod-type
     1953                                      ,prod-code
     1954                                      ) .
     1955       end.
     1956       assign
     1957         p-total-parts-qnty = 0
     1958       .
     1959       if p-goods-gds-goods = true
     1960       then do:
     1961         for each buf_parts no-lock
     1962           where buf_parts.out-code  = p-doc-code
     1963             and buf_parts.obj-type  = p-obj-type
     1964             and buf_parts.obj-code  = p-obj-code
     1965             and buf_parts.artic     = p-artic
     1966             and buf_parts.prod-type = p-prod-type
     1967             and buf_parts.prod-code = p-prod-code
     1968         on error undo, return error
     1969         :
     1970           run partslib-create-temp-parts in this-procedure
     1971             (buffer buf_parts
     1972             ,buffer buf_temp-parts
     1973             ,input  p-goods-twounit
     1974             ) .
     1975           assign
     1976             p-total-parts-qnty        = p-total-parts-qnty
     1977                                       + v-parts-sign * buf_parts.fact-qnty
     1978             buf_temp-parts.qnty       = buf_temp-parts.qnty
     1979                                       + v-parts-sign * buf_parts.fact-qnty
     1980             buf_temp-parts.fact-qnty  = buf_temp-parts.fact-qnty
     1981                                       + v-parts-sign * buf_parts.fact-qnty
     1982             buf_temp-parts.cli-qnty   = buf_temp-parts.cli-qnty
     1983                                       + v-parts-sign * buf_parts.cli-qnty
     1984           .
     1985           if buf_temp-parts.qnty = 0
     1986           then do:
     1987             delete buf_temp-parts .
     1988           end.
     1989         end.
     1990       end.
     1991       else do:
     1992         assign
     1993           p-total-parts-qnty = p-total-parts-qnty
     1994                              + v-parts-sign * buf_doc-line.fact-qnty
     1995         .
     1996       end.
     1997     end.
     1998   end procedure.
     1999   procedure partslib-init-temp-parts-by-date :
     2000     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
     2001     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
     2002     define input parameter p-artic           like ub.parts.artic     no-undo .
     2003     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
     2004     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
     2005     define input parameter p-fact-date       as date      no-undo .
     2006     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-date: определение партий свободной зоны на любую дату".
     2007     do
     2008     on error undo, return error
     2009     :
     2010       define variable v-fact-order                as decimal   no-undo .
     2011       define variable v-shift-end-fact-order      as decimal   no-undo .
     2012       define variable v-day-end-fact-order        as decimal   no-undo .
     2013       run factord in this-procedure
     2014         (input  p-fact-date
     2015         ,input  1
     2016         ,input  1
     2017         ,input  ?
     2018         ,input  0
     2019         ,input  false
     2020         ,output v-fact-order
     2021         ,output v-shift-end-fact-order
     2022         ,output v-day-end-fact-order
     2023         ) no-error .
     2024       if error-status :error
     2025       then do:
     2026         message
     2027           vss-workfile vss-revision vss-description skip
     2028           vss-include-info13 skip
     2029           "Ошибка при определении момента времени, на который требуется остаток" skip
     2030           "Объект" p-obj-type p-obj-code skip
     2031           "Артикул" p-artic p-prod-type p-prod-code skip
     2032           "Дата" p-fact-date skip
     2033           view-as alert-box error .
     2034         undo, return error .
     2035       end.
     2036       run partslib-init-temp-parts-by-factord in this-procedure
     2037         (input p-obj-type
     2038         ,input p-obj-code
     2039         ,input p-artic
     2040         ,input p-prod-type
     2041         ,input p-prod-code
     2042         ,input v-day-end-fact-order
     2043         ,input false
     2044         ) no-error .
     2045       if error-status :error
     2046       then do:
     2047         message
     2048           vss-workfile vss-revision vss-description skip
     2049           vss-include-info13 skip
     2050           "Ошибка при вызове метода partslib-init-temp-parts-by-factord" skip
     2051           "Объект" p-obj-type p-obj-code skip
     2052           "Артикул" p-artic p-prod-type p-prod-code skip
     2053           "Дата" p-fact-date skip
     2054           view-as alert-box error .
     2055         undo, return error .
     2056       end.
     2057     end.
     2058   end procedure.
     2059   procedure partslib-calc-cost :
     2060     define output parameter p-fact-qnty      as decimal   no-undo .
     2061     define output parameter p-vat-pc         as decimal   no-undo .
     2062     define output parameter p-slt-pc         as decimal   no-undo .
     2063     define output parameter p-sum-base       as decimal   no-undo .
     2064     define output parameter p-sum-rubl       as decimal   no-undo .
     2065     define output parameter p-vat-base       as decimal   no-undo .
     2066     define output parameter p-vat-rubl       as decimal   no-undo .
     2067     define output parameter p-slt-base       as decimal   no-undo .
     2068     define output parameter p-slt-rubl       as decimal   no-undo .
     2069     define output parameter p-road-tax-base  as decimal   no-undo .
     2070     define output parameter p-road-tax-rubl  as decimal   no-undo .
     2071     define output parameter p-transport-base as decimal   no-undo .
     2072     define output parameter p-transport-rubl as decimal   no-undo .
     2073     define output parameter p-other-base     as decimal   no-undo .
     2074     define output parameter p-other-rubl     as decimal   no-undo .
     2075     define output parameter p-excise-base    as decimal   no-undo .
     2076     define output parameter p-excise-rubl    as decimal   no-undo .
     2077     define variable vss-description as character no-undo init "partslib-calc-cost: расчет сумм в учетных ценах".
     2078     do
     2079     on error undo, return error return-value
     2080     :
     2081       define buffer buf_temp-parts for temp-parts .
     2082       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     2083       define buffer   in-vatp-parts    for ub.parts   .
     2084       define buffer   in-vatp-doc      for ub.trn-doc .
     2085       define buffer   in-vatp-goods    for ub.goods   .
     2086       define buffer   in-vatp-sysconf  for ub.sysconf .
     2087       define buffer   in-vatp_doc-attr for ub.doc-attr.
     2088       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     2089       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     2090       define variable varinvprb                  as   character              no-undo.
     2091       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     2092       define variable cli-base-rate              as   decimal                no-undo.
     2093       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     2094       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     2095       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     2096       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     2097       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     2098       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     2099       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     2100       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     2101       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     2102       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     2103       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     2104       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     2105       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     2106       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     2107       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     2108       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     2109       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     2110       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     2111       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     2112       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     2113       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     2114       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     2115       define variable varinvatp-envd             as   character              no-undo.
     2116       define variable varinvatp-type             as   character              no-undo.
     2117       for each buf_temp-parts
     2118       on error undo, return error
     2119       :
     2120   assign
     2121     price-rubl-with-tax-loc = buf_temp-parts.price-rubl
     2122     price-base-with-tax-loc = buf_temp-parts.price-base
     2123   .
     2124   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2125   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2126     (output varinvprb
     2127     )  .
     2128     if buf_temp-parts.out-code = 'free-zone':U     or
     2129        buf_temp-parts.out-code = 'out-zone':U   or
     2130        buf_temp-parts.doc-type = 'акт':U then do:
     2131       assign
     2132         in-vatp-have-vat-slt = yes.
     2133     end.
     2134     else do:
     2135       find first in-vatp_doc-attr no-lock
     2136         where in-vatp_doc-attr.doc-code  = buf_temp-parts.out-code
     2137           and in-vatp_doc-attr.attr-code = 'envd':U
     2138         no-error .
     2139       if not available in-vatp_doc-attr then do:
     2140         assign
     2141           in-vatp-have-vat-slt = yes.
     2142       end.
     2143       else do:
     2144            in-vatp-have-vat-slt = no.
     2145       end.
     2146     end.
     2147     assign
     2148      price-cli-with-tax-loc = buf_temp-parts.price-cli
     2149      cli-base-rate          = buf_temp-parts.cli-base-rate.
     2150     ASSIGN   road-tax-base-loc  = (if buf_temp-parts.road-tax-base  = ? then 0 else buf_temp-parts.road-tax-base)
     2151              road-tax-rubl-loc  = (if buf_temp-parts.road-tax-rubl  = ? then 0 else buf_temp-parts.road-tax-rubl).
     2152     ASSIGN  transport-base-loc = (if buf_temp-parts.transport-base = ? then 0 else buf_temp-parts.transport-base)
     2153             transport-rubl-loc = (if buf_temp-parts.transport-rubl = ? then 0 else buf_temp-parts.transport-rubl)
     2154             other-base-loc     = (if buf_temp-parts.other-base     = ? then 0 else buf_temp-parts.other-base)
     2155             other-rubl-loc     = (if buf_temp-parts.other-rubl     = ? then 0 else buf_temp-parts.other-rubl)
     2156             vat-pc-loc         = (if buf_temp-parts.vat-pc         = ? then 0 else buf_temp-parts.vat-pc)
     2157             slt-pc-loc         = (if buf_temp-parts.slt-pc         = ? then 0 else buf_temp-parts.slt-pc).
     2158             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     2159       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     2160     assign
     2161       exch-rate-cli-loc = (buf_temp-parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_temp-parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_temp-parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_temp-parts.price-cli .
     2162     assign
     2163       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     2164       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     2165       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     2166       transport-cli-loc  = 0
     2167       other-cli-loc      = 0
     2168     .
     2169   ASSIGN
     2170             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     2171       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     2172   .
     2173         assign
     2174           p-fact-qnty      = p-fact-qnty      + buf_temp-parts.fact-qnty
     2175           p-vat-pc         = p-vat-pc         + vat-pc-loc
     2176           p-slt-pc         = p-slt-pc         + slt-pc-loc
     2177           p-sum-base       = p-sum-base       + price-base-with-tax-loc * buf_temp-parts.fact-qnty
     2178           p-sum-rubl       = p-sum-rubl       + price-rubl-with-tax-loc * buf_temp-parts.fact-qnty
     2179           p-vat-base       = p-vat-base       + vat-base-loc            * buf_temp-parts.fact-qnty
     2180           p-vat-rubl       = p-vat-rubl       + vat-rubl-loc            * buf_temp-parts.fact-qnty
     2181           p-slt-base       = p-slt-base       + slt-base-loc            * buf_temp-parts.fact-qnty
     2182           p-slt-rubl       = p-slt-rubl       + slt-rubl-loc            * buf_temp-parts.fact-qnty
     2183           p-road-tax-base  = p-road-tax-base  + road-tax-base-loc       * buf_temp-parts.fact-qnty
     2184           p-road-tax-rubl  = p-road-tax-rubl  + road-tax-rubl-loc       * buf_temp-parts.fact-qnty
     2185           p-transport-base = p-transport-base + transport-base-loc      * buf_temp-parts.fact-qnty
     2186           p-transport-rubl = p-transport-rubl + transport-rubl-loc      * buf_temp-parts.fact-qnty
     2187           p-other-base     = p-other-base     + other-base-loc          * buf_temp-parts.fact-qnty
     2188           p-other-rubl     = p-other-rubl     + other-rubl-loc          * buf_temp-parts.fact-qnty
     2189           p-excise-base    = p-excise-base    + 0
     2190           p-excise-rubl    = p-excise-rubl    + 0
     2191         .
     2192       end.
     2193       if p-fact-qnty      = ?
     2194       or p-sum-base       = ?
     2195       or p-sum-rubl       = ?
     2196       or p-vat-base       = ?
     2197       or p-vat-rubl       = ?
     2198       or p-slt-base       = ?
     2199       or p-slt-rubl       = ?
     2200       or p-road-tax-base  = ?
     2201       or p-road-tax-rubl  = ?
     2202       or p-transport-base = ?
     2203       or p-transport-rubl = ?
     2204       or p-other-base     = ?
     2205       or p-other-rubl     = ?
     2206       or p-excise-base    = ?
     2207       or p-excise-rubl    = ?
     2208       then do:
     2209         message
     2210           vss-workfile vss-revision vss-description skip
     2211           vss-include-info13 skip
     2212           "Программа in-vatp.i вернула неопределенные значения" skip
     2213           "p-fact-qnty"      p-fact-qnty      skip
     2214           "p-sum-base"       p-sum-base       skip
     2215           "p-sum-rubl"       p-sum-rubl       skip
     2216           "p-vat-base"       p-vat-base       skip
     2217           "p-vat-rubl"       p-vat-rubl       skip
     2218           "p-slt-base"       p-slt-base       skip
     2219           "p-slt-rubl"       p-slt-rubl       skip
     2220           "p-road-tax-base"  p-road-tax-base  skip
     2221           "p-road-tax-rubl"  p-road-tax-rubl  skip
     2222           "p-transport-base" p-transport-base skip
     2223           "p-transport-rubl" p-transport-rubl skip
     2224           "p-other-base"     p-other-base     skip
     2225           "p-other-rubl"     p-other-rubl     skip
     2226           "p-excise-base"    p-excise-base    skip
     2227           "p-excise-rubl"    p-excise-rubl    skip
     2228           view-as alert-box error .
     2229         undo, return error .
     2230       end.
     2231     end.
     2232   end procedure.
