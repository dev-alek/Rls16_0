      401   def
      402    shared
      403   temp-table  obj-list no-undo
      404     field obj-type like ub.clients.obj-type
      405     field obj-code like ub.clients.obj-code
      406     field obj-name like ub.clients.obj-name
      407     field obj-id   as integer
