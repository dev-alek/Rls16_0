     3044   PROCEDURE adm-create-objects :
     3045   END PROCEDURE.
     3046   PROCEDURE adm-row-available :
     3047     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
     3048     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
     3049     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
     3050     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
     3051     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
     3052     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
     3053     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
     3054     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
     3055     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
     3056     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
     3057     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
     3058     IF adm-updating-record THEN RETURN.
     3059     RUN get-attribute ('FIELDS-ENABLED':U).
     3060     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
     3061     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
     3062         OUTPUT link-handle) NO-ERROR.
     3063     IF link-handle = "":U THEN
     3064         RETURN.
     3065     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
     3066     IF NUM-ENTRIES(link-handle) > 1 THEN
     3067         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
     3068             "encountered more than one RECORD-SOURCE.":U SKIP
     3069             "The first - ":U record-source-hdl:file-name " - will be used.":U
     3070                VIEW-AS ALERT-BOX ERROR.
     3071     RUN get-attribute ('Key-Name':U).
     3072     key-name = RETURN-VALUE.
     3073     IF key-name = "":U THEN key-name = ?.
     3074     IF key-name NE ? THEN DO:
     3075       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
     3076         NO-ERROR.
     3077       IF key-value NE ? THEN
     3078         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
     3079     END.
     3080   IF VALID-HANDLE (adm-object-hdl) THEN
     3081       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     3082   RUN notify IN THIS-PROCEDURE ('row-available':U).
     3083   END PROCEDURE.
     3084   PROCEDURE disable_UI :
     3085     HIDE FRAME F-Main.
     3086     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     3087   END PROCEDURE.
     3088   PROCEDURE enable_UI :
     3089     DISPLAY T-cons T-supp T-parts date-calc date-cred
     3090         WITH FRAME F-Main.
     3091     ENABLE T-cons T-supp T-parts date-calc date-cred
     3092         WITH FRAME F-Main.
     3093   END PROCEDURE.
