        1   CREATE WIDGET-POOL.
        2   define variable vss-revision    as character no-undo initial "$Revision$":U .
        3   define variable vss-author      as character no-undo initial "$Author$":U .
        4   define variable vss-date        as character no-undo initial "$Date$":U .
        5   define variable vss-workfile    as character no-undo initial "$Workfile$":U .
        6   define variable vss-archive     as character no-undo initial "$Archive$":U .
        7   define variable vss-description as character no-undo initial "Остатки товаров на указанную дату, оприходованных до заданной даты":U .
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   procedure proc-alt-shift-f2:
       67     if not ibs.th.gbl.gbl-var:rcode
       68   then
       69     run gbl\inidebug.p .
       70   end.
       71   procedure proc-alt-shift-f3:
       72     run gbl/prvssinf.p
       73       ( input this-procedure
       74       ) .
       75   end.
       76   define variable v-inform-launched as logical no-undo initial false .
       77   procedure proc-alt-shift-f4:
       78     define variable v-action as character no-undo .
       79     if v-inform-launched = false then do:
       80       assign
       81         v-inform-launched = true
       82       .
       83       run gbl/d-inform.w
       84         (  input self
       85         ,  input this-procedure
       86         , output v-action
       87         ) no-error .
       88       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       89       assign
       90         v-inform-launched = false
       91       .
       92     end.
       93   end.
       94   procedure proc-alt-f1:
       95     run gbl/corrhelp.p
       96       (input this-procedure
       97       ) .
       98   end .
       99   on alt-shift-f2 anywhere do:
      100     run proc-alt-shift-f2.
      101   end.
      102   on alt-shift-f3 anywhere do:
      103     run proc-alt-shift-f3 in this-procedure .
      104   end.
      105   on alt-shift-f4 anywhere do:
      106     run proc-alt-shift-f4 in this-procedure.
      107   end.
      108   on alt-f1 anywhere do:
      109     run proc-alt-f1 in this-procedure .
      110   end.
      111   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      112   procedure cur-time :
      113      define output parameter p-today as date      no-undo .
      114      define output parameter p-time  as integer   no-undo .
      115     do
      116     on error undo, return error
      117     :
      118       define variable v-date1 as date      no-undo .
      119       define variable v-date2 as date      no-undo .
      120       define variable v-time  as integer   no-undo .
      121       assign
      122         v-date1 = today
      123         v-time  = time
      124         v-date2 = today
      125       .
      126       if v-date1 <> v-date2
      127       then do:
      128         assign
      129           v-date1 = today
      130           v-time  = v-time
      131         .
      132       end.
      133       assign
      134         p-today = v-date1
      135         p-time  = v-time
      136       .
      137     end.
      138   end.
      139   function cur-time-date returns character
      140   :
      141     return string(today, '99/99/9999':U) .
      142   end.
      143   function cur-time-mjd returns decimal
      144   :
      145     define variable v-date as date      no-undo .
      146     define variable v-time as integer   no-undo .
      147     run cur-time in this-procedure
      148       (output v-date
      149       ,output v-time
      150       ) .
      151     return integer(v-date) - 2400002 + (v-time / 86400) .
      152   end.
      153   function cur-time-get-ending-index returns integer
      154   (input p-number as integer
      155   )
      156   :
      157     if p-number < 0
      158     or p-number = ?
      159     then do:
      160       return 1 .
      161     end.
      162     define variable v-rest as integer   no-undo .
      163     assign
      164       p-number = p-number modulo 100
      165     .
      166     if p-number < 20
      167     then do:
      168       assign
      169         v-rest = p-number
      170       .
      171     end.
      172     else do:
      173       assign
      174         v-rest = p-number modulo 10
      175       .
      176     end.
      177     case v-rest :
      178       when 1
      179       then do:
      180         return 2 .
      181       end.
      182       when 2 or
      183       when 3 or
      184       when 4
      185       then do:
      186         return 3 .
      187       end.
      188       otherwise do:
      189         return 1 .
      190       end.
      191     end case .
      192   end.
      193   procedure cur-time-mjd-to-date :
      194      define input  parameter i-mjd-diff as decimal no-undo.
      195      define output parameter o-Date     as date    no-undo.
      196      define output parameter o-Time     as integer no-undo.
      197      define variable v-day-number as integer   no-undo .
      198      if    i-mjd-diff < 0
      199         or i-mjd-diff = ?
      200      then do:
      201         return "?" .
      202      end.
      203      assign
      204         v-day-number = truncate(i-mjd-diff,0).
      205         o-Date = date(v-day-number + 2400002).
      206         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      207     .
      208   end.
      209   function cur-time-mjd-to-string returns character
      210   (input p-mjd-diff as decimal
      211   )
      212   :
      213     define variable v-day-number as integer   no-undo .
      214     define variable v-seconds    as integer   no-undo .
      215     define variable v-hour       as integer   no-undo .
      216     define variable v-min        as integer   no-undo .
      217     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      218     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      219     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      220     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      221     if p-mjd-diff < 0
      222     or p-mjd-diff = ?
      223     then do:
      224       return "?" .
      225     end.
      226     assign
      227       v-day-number = integer(truncate(p-mjd-diff,0))
      228       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      229     .
      230     if v-seconds > 86400
      231     then do:
      232       assign
      233         v-seconds = 86400 - 1
      234       .
      235     end.
      236     if v-seconds < 0
      237     then do:
      238       assign
      239         v-seconds = 0
      240       .
      241     end.
      242     assign
      243       v-hour = truncate(v-seconds / 3600, 0)
      244     .
      245     assign
      246       v-seconds = v-seconds modulo 3600
      247     .
      248     assign
      249       v-min = truncate(v-seconds / 60, 0)
      250     .
      251     assign
      252       v-seconds = v-seconds modulo 60
      253     .
      254     return
      255         (if v-day-number <> 0
      256           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      257           else ""
      258         )
      259       + (if v-day-number <> 0 or v-hour <> 0
      260           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      261           else ""
      262         )
      263       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      264           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      265           else ""
      266         )
      267       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      268       .
      269   end.
      270   function cur-time-string returns character
      271   :
      272     define variable v-date as date      no-undo .
      273     define variable v-time as integer   no-undo .
      274     run cur-time in this-procedure
      275       (output v-date
      276       ,output v-time
      277       ) .
      278     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      279   end.
      280   function cur-time-string-sec returns character
      281   :
      282     define variable v-date as date      no-undo .
      283     define variable v-time as integer   no-undo .
      284     run cur-time in this-procedure
      285       (output v-date
      286       ,output v-time
      287       ) .
      288     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      289   end.
      290   function cur-time-custom  returns character
      291   (input p-prefix as character
      292   ,input p-date-format as character
      293   ,input p-delimiter as character
      294   ,input p-time-format as character
      295   ,input p-suffix as character
      296   )
      297   :
      298     define variable v-date as date      no-undo .
      299     define variable v-time as integer   no-undo .
      300     run cur-time in this-procedure
      301       (output v-date
      302       ,output v-time
      303       ) .
      304     return
      305       p-prefix
      306       + string(v-date, p-date-format)
      307       + p-delimiter
      308       + string(v-time, p-time-format)
      309       + p-suffix
      310       .
      311   end.
      312   function cur-time-print  returns character
      313   :
      314     define variable v-date as date      no-undo .
      315     define variable v-time as integer   no-undo .
      316     run cur-time in this-procedure
      317       (output v-date
      318       ,output v-time
      319       ) .
      320     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      321   end.
      322   function cur-time-datetime returns datetime
      323   :
      324     define variable v-char as character no-undo .
      325     define variable v-datetime as datetime no-undo .
      326     v-char = cur-time-string().
      327     v-datetime = datetime(v-char).
      328     return  v-datetime.
      329   end.
      330   function cur-time-string-msec returns character
      331   :
      332     define variable v-date as datetime  no-undo .
      333     v-date = now.
      334     return string(v-date) .
      335   end.
