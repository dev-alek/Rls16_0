     3718   "НДС" p-XL-delim
     3719   "НП" p-XL-delim
     3720   (IF T-supp then
     3721   ("Тип_поставщика" + p-XL-delim + "Код_поставщика" + p-XL-delim + "Поставщик" + p-XL-delim)
     3722   else "")
     3723   (IF T-cons then
     3724   ("Консигнационный_товар" + p-XL-delim)
     3725   else "")
     3726   (IF T-cons or T-parts
     3727   then
     3728   ("Тип оплаты"  + p-XL-DELIM)
     3729   else "":U)
     3730   "НДС_поставщ" p-XL-delim
     3731   "НП_поставщ" p-XL-delim
     3732   (if T-parts
     3733   then ("Тип_объекта" + p-XL-delim +
     3734         "Код_объекта" + p-XL-delim +
     3735         "Учетн.цена_с НДС_НП_баз.вал." + p-XL-delim +
     3736         "Учетн.цена_с НДС_НП_рубли" + p-XL-delim +
     3737         "N_прих.док-та" + p-XL-delim +
     3738         "Факт_дата" + p-XL-delim +
     3739         "ГТД" + p-XL-DELIM
     3740        )
     3741   else ""
     3742   )
     3743   "Номер приходной накладной поставщика" p-XL-delim
     3744   "Дата приходной накладной поставщика" p-XL-delim
     3745   "Номер счета-фактуры поставщика" p-XL-delim
     3746   "Дата счета-фактуры поставщика" p-XL-delim
     3747   "Остаток" p-XL-delim
     3748   "Сумма_учет_цен_баз.вал" p-XL-delim
     3749   "Сумма_учет_цен_баз.вал_без_НДС_НП" p-XL-delim
     3750   "Сумма_учет_цен_рубли" p-XL-delim
     3751   "Сумма_учет_цен_рубли_без_НДС_НП" p-XL-delim
     3752   (if v-curr-r-b = 'base':U
     3753    then "Сумма_продаж_цен_баз.вал"
     3754    else "Сумма_продаж_цен_рубли") p-XL-delim
     3755   SKIP(0).
     3756   FOR EACH sj-goods NO-LOCK
     3757   use-index p1
     3758   break by sj-goods.prod-type
     3759   by sj-goods.prod-code
     3760   by sj-goods.supp-type
     3761   BY sj-goods.supp-code:
     3762       IF FIRST-OF(sj-goods.supp-code) then do:
     3763           FIND FIRST supplier NO-LOCK WHERE
     3764                     supplier.obj-type = sj-goods.supp-type AND
     3765                     supplier.obj-code = sj-goods.supp-code NO-ERROR.
     3766          assign
     3767          v-supplier = (if available supplier
     3768                        then supplier.obj-name
     3769                        else "":U)
     3770          .
     3771       end.
     3772       IF FIRST-OF(sj-goods.prod-code) then do:
     3773           FIND FIRST clients NO-LOCK WHERE
     3774                     clients.obj-type = sj-goods.prod-type AND
     3775                     clients.obj-code = sj-goods.prod-code NO-ERROR.
     3776          assign
     3777          v-producer = (if available clients
     3778                        then clients.obj-name
     3779                        else "":U)
     3780          .
     3781       end.
     3782   if t-parts or T-cons then
     3783   find first buf_pay-type no-lock where
     3784             buf_pay-type.obj-code = sj-goods.pay-code no-error .
     3785       accumulate
     3786         sj-goods.uchet-price-base (TOTAL)
     3787         sj-goods.uchet-price-rubl (TOTAL)
     3788         sj-goods.qnty (TOTAL)
     3789         sj-goods.uchet-sum-base (TOTAL)
     3790         sj-goods.uchet-sum-base-without-tax (TOTAL)
     3791         sj-goods.uchet-sum-rubl (TOTAL)
     3792         sj-goods.uchet-sum-rubl-without-tax (TOTAL)
     3793         sj-goods.sale-sum-base (TOTAL)
     3794         sj-goods.sale-sum-rubl (TOTAL)
     3795       .
     3796       PUT stream Rest-Stream UNFORMATTED
     3797       sj-goods.prod-type p-XL-delim
     3798       sj-goods.prod-code p-XL-delim
     3799       REPLACE(v-producer, " ", "_") p-XL-delim
     3800       sj-goods.artic p-XL-delim
     3801       sj-goods.b-code p-XL-delim
     3802       sj-goods.gds-name p-XL-delim
     3803       sj-goods.engl-name p-XL-DELIM
     3804       sj-goods.unit p-XL-delim
     3805       sj-goods.VAT-pc p-XL-delim
     3806       sj-goods.SLT-pc p-XL-delim
     3807       (IF T-supp then
     3808       (sj-goods.SUPP-type + p-XL-delim +
     3809       string(sj-goods.SUPP-code) + p-XL-delim +
     3810       REPLACE(v-supplier, " ", "_") + p-XL-delim
     3811       )
     3812       ELSE "")
     3813       (IF T-cons then
     3814       (entry (lookup (string(sj-goods.purch-code), '1,2,3,4':U), 'выкуп,консигнация,ответственное хранение,старая консигнация':U) + p-XL-DELIM)
     3815       ELSE "")
     3816       (IF T-cons or T-parts
     3817       then
     3818       (if available buf_pay-type
     3819       then (buf_pay-type.obj-name + p-XL-DELIM)
     3820       else "":U)
     3821       ELSE "":U
     3822       )
     3823       sj-goods.VAT-supp p-XL-delim
     3824       sj-goods.SLT-supp p-XL-delim
     3825       (if T-parts then
     3826       (
     3827        sj-goods.obj-type +  p-XL-delim +
     3828        string(sj-goods.obj-code) +  p-XL-delim +
     3829        string(sj-goods.uchet-price-base) +  p-XL-delim +
     3830        string(sj-goods.uchet-price-rubl) +  p-XL-delim +
     3831        sj-goods.in-code + p-XL-delim +
     3832        (if sj-goods.fact-date = ? then "?" else string(sj-goods.fact-date, "99/99/9999")) + p-XL-delim +
     3833         sj-goods.cst-code + p-XL-DELIM
     3834       )
     3835        else ""
     3836        )
     3837       (if sj-goods.nids  = ? or sj-goods.nids = "" then " " else sj-goods.nids) p-XL-delim
     3838       (if sj-goods.dids  = ? then " " else string(sj-goods.dids, "99/99/9999")) p-XL-delim
     3839       (if sj-goods.nsf   = ? or sj-goods.nsf = "" then " " else sj-goods.nsf ) p-XL-delim
     3840       (if sj-goods.dsf   = ? then " " else string(sj-goods.dsf, "99/99/9999")) p-XL-delim
     3841       sj-goods.qnty p-XL-delim
     3842       sj-goods.uchet-sum-base p-XL-delim
     3843       sj-goods.uchet-sum-base-without-tax  p-XL-delim
     3844       sj-goods.uchet-sum-rubl p-XL-delim
     3845       sj-goods.uchet-sum-rubl-without-tax p-XL-delim
     3846       (if v-curr-r-b = 'base':U
     3847        then sj-goods.sale-sum-base
     3848        else sj-goods.sale-sum-rubl)   p-XL-delim
     3849       SKIP(0).
     3850       if Make-Excel then  put   stream ForExcel unformatted
     3851         sj-goods.prod-type            CHR(9)
     3852         sj-goods.prod-code            CHR(9)
     3853         REPLACE(v-producer, " ", "_") CHR(9)
     3854         sj-goods.artic                CHR(9)
     3855         sj-goods.b-code               CHR(9)
     3856         sj-goods.gds-name             CHR(9)
     3857         sj-goods.engl-name            CHR(9)
     3858         sj-goods.unit                 CHR(9)
     3859         sj-goods.VAT-pc               CHR(9)
     3860         sj-goods.SLT-pc               CHR(9)
     3861         if T-supp then string
     3862         (
     3863           sj-goods.SUPP-type + CHR(9) +
     3864           string(sj-goods.SUPP-code) + CHR(9) +
     3865           replace(v-supplier, " ", "_") + CHR(9)
     3866         )
     3867         else ""
     3868         IF T-cons then string
     3869         (
     3870             entry (lookup (string(sj-goods.purch-code), '1,2,3,4':U), 'выкуп,консигнация,ответственное хранение,старая консигнация':U) + CHR(9)
     3871         )
     3872         ELSE ""
     3873         IF T-cons or T-parts then string
     3874         (
     3875             if available buf_pay-type
     3876             then (buf_pay-type.obj-name + CHR(9))
     3877             else (" ":U + CHR(9))
     3878         )
     3879         ELSE "":U
     3880         sj-goods.VAT-supp CHR(9)
     3881         sj-goods.SLT-supp CHR(9)
     3882         (
     3883           if T-parts then
     3884           (
     3885             sj-goods.obj-type                 + CHR(9) +
     3886             string(sj-goods.obj-code)         + CHR(9) +
     3887             string(sj-goods.uchet-price-base) + CHR(9) +
     3888             string(sj-goods.uchet-price-rubl) + CHR(9) +
     3889             sj-goods.in-code                  + CHR(9) +
     3890             (if sj-goods.fact-date = ? then "?" else string(sj-goods.fact-date, "99/99/9999")) + CHR(9) +
     3891             sj-goods.cst-code                 + CHR(9)
     3892           )
     3893           else ("")
     3894         )
     3895         (if sj-goods.nids  = ? or sj-goods.nids = "" then " " else sj-goods.nids)  CHR(9)
     3896         (if sj-goods.dids  = ? then " " else string(sj-goods.dids, "99/99/9999"))  CHR(9)
     3897         (if sj-goods.nsf   = ? or sj-goods.nsf = "" then " " else sj-goods.nsf )   CHR(9)
     3898         (if sj-goods.dsf   = ? then " " else string(sj-goods.dsf, "99/99/9999"))   CHR(9)
     3899         sj-goods.qnty                                                              CHR(9)
     3900         sj-goods.uchet-sum-base                                                    CHR(9)
     3901         sj-goods.uchet-sum-base-without-tax                                        CHR(9)
     3902         sj-goods.uchet-sum-rubl                                                    CHR(9)
     3903         sj-goods.uchet-sum-rubl-without-tax                                        CHR(9)
     3904         (if v-curr-r-b = 'base':U then sj-goods.sale-sum-base else sj-goods.sale-sum-rubl)
     3905       SKIP.
     3906   END.
     3907       if Make-Excel then  put   stream ForExcel unformatted
     3908         skip(1)
     3909         " ИТОГО:"            CHR(9)
     3910         " "            CHR(9)
     3911         " "             CHR(9)
     3912         " "                CHR(9)
     3913         " "               CHR(9)
     3914         " "             CHR(9)
     3915         " "            CHR(9)
     3916         " "                 CHR(9)
     3917         " "               CHR(9)
     3918         " "               CHR(9)
     3919         if T-supp then string
     3920         (
     3921           " " + CHR(9) +
     3922           " " + CHR(9) +
     3923           " " + CHR(9)
     3924         )
     3925         else ""
     3926         IF T-cons then string
     3927         (
     3928             " " + CHR(9)
     3929         )
     3930         ELSE ""
     3931         IF T-cons or T-parts then string
     3932         (
     3933             " ":U + CHR(9)
     3934         )
     3935         ELSE "":U
     3936         " " CHR(9)
     3937         " " CHR(9)
     3938         (
     3939           if T-parts then
     3940           (
     3941             " "                 + CHR(9) +
     3942             " "         + CHR(9) +
     3943             string( accum TOTAL sj-goods.uchet-price-base ) + CHR(9) +
     3944             string( accum TOTAL sj-goods.uchet-price-rubl) + CHR(9) +
     3945             " "                  + CHR(9) +
     3946             " " + CHR(9) +
     3947             " "                 + CHR(9)
     3948           )
     3949           else ("")
     3950         )
     3951         " "  CHR(9)
     3952         " "  CHR(9)
     3953         " "   CHR(9)
     3954         " "   CHR(9)
     3955         accum TOTAL sj-goods.qnty                                                              CHR(9)
     3956         accum TOTAL sj-goods.uchet-sum-base                                                    CHR(9)
     3957         accum TOTAL sj-goods.uchet-sum-base-without-tax                                        CHR(9)
     3958         accum TOTAL sj-goods.uchet-sum-rubl                                                    CHR(9)
     3959         accum TOTAL sj-goods.uchet-sum-rubl-without-tax                                        CHR(9)
     3960         (if v-curr-r-b = 'base':U then accum TOTAL sj-goods.sale-sum-base else accum TOTAL sj-goods.sale-sum-rubl)
     3961       SKIP.
     3962   output stream Rest-Stream CLOSE .
     3963   run waitfram-hide in this-procedure .
     3964   if Make-Excel then output stream ForExcel close.
     3965   run rep/runexcel.p
     3966           (
     3967           input string(session :temp-directory) + "rpt" + string( g#report-num ) + ".txt"
     3968           ) no-error .
     3969   if error-status :error then do:
     3970           if session :set-wait-state("") then .
     3971   end.
     3972   message
     3973   "Отчет выведен в файл"
     3974   view-as alert-box.
     3975   END PROCEDURE.
     3976   PROCEDURE My-var :
     3977   assign
     3978   frame F-Main T-cons
     3979   frame F-Main T-supp
     3980   frame F-Main T-parts
     3981   frame F-Main date-calc
     3982   frame F-Main date-cred
     3983   .
     3984   str1 = "".
     3985   Assign
     3986    STR-obj-type = ''
     3987    STR-obj-code = ''
     3988    STR-obj-name = ''
     3989    STR-obj      = ''.
     3990   For each obj-list no-lock:
     3991    Assign
     3992    STR-obj-type = STR-obj-type + obj-list.obj-type + ','
     3993    STR-obj-code = STR-obj-code + String(obj-list.obj-code) + ','
     3994    STR-obj-name = STR-obj-name + obj-list.obj-name + ','
     3995    STR-obj = STR-obj +  obj-list.obj-type + '#' + string(obj-list.obj-code)  + ',' .
     3996   End.
     3997   ReportNAme = "Остатки на " + string( date-calc , "99/99/9999" ) + " по товарам, оприходованным до " + string( date-cred , "99/99/9999" ).
     3998   ReportHeader = (if T-cons
     3999                   then "Разделять консигнацию и выкуп "
     4000                   else "Не разделять консигнацию и выкуп ") + chr(10) +
     4001                  (if T-supp
     4002                   then "Указывать поставщика "
     4003                   else "Не указывать поставщика ") + chr(10) +
     4004                  (if T-parts
     4005                   then "Каждую партию отдельной строкой" + chr(10)
     4006                   else "")
     4007                  .
     4008   END PROCEDURE.
     4009   PROCEDURE send-records :
     4010   END PROCEDURE.
     4011   PROCEDURE state-changed :
     4012     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE NO-UNDO.
     4013     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     4014   END PROCEDURE.
     4015   PROCEDURE tree-prt :
     4016   define input parameter        c     like ub.gds-prt.node-code no-undo.
     4017   define       parameter buffer b-g-p for  ub.gds-prt.
     4018   define buffer b-gds-prt for ub.gds-prt.
     4019   define variable no-nodes as logical initial yes.
     4020   if odoc-prt = yes then
     4021       FOR EACH b-gds-prt where b-gds-prt.upper-code = c  NO-LOCK:
     4022           no-nodes = no.
     4023           RUN tree-prt( b-gds-prt.node-code, buffer b-gds-prt ).
     4024       END .
     4025   if no-nodes = yes then do:
     4026      FIND FIRST prt-obj No-LOCK WHERE
     4027                 prt-obj.artic = gds-obj.artic AND
     4028               prt-obj.prod-type = gds-obj.prod-type AND
     4029               prt-obj.prod-code = gds-obj.prod-code AND
     4030               prt-obj.prt-code = b-g-p.node-code No-ERROR.
     4031     sale-stoim = sale-stoim  + prt-obj.fact-qnty * prt-obj.price-sale.
     4032   end.
     4033   END PROCEDURE.
     4034   PROCEDURE verify-date :
     4035   IF DATE(date-cred:SCREEN-VALUE IN FRAME F-Main) > DATE(date-calc:SCREEN-VALUE IN FRAME F-Main) THEN DO:
     4036       BELL.
     4037       message "Интервал дат введен неверно !" view-as alert-box error TITLE "О Ш И Б К А !!!".
     4038       Return error.
     4039   END.
     4040   END PROCEDURE.
