     2367        T-cons AT ROW 2.14 COL 2.4
     2368        T-supp AT ROW 3.81 COL 2.4
     2369        T-parts AT ROW 5.76 COL 2.4
     2370        date-calc AT ROW 7.67 COL 19 COLON-ALIGNED
     2371        date-cred AT ROW 9.33 COL 19 COLON-ALIGNED
     2372       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
     2373            SIDE-LABELS NO-UNDERLINE THREE-D
     2374            AT COL 1 ROW 1
     2375            SIZE 37 BY 14.
     2376   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     2377   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     2378   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     2379   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     2380   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     2381   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     2382   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     2383   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     2384       ASSIGN adm-object-hdl = FRAME F-Main:HANDLE.
     2385   RUN ensure-broker.
     2386   THIS-PROCEDURE:ADM-DATA =
     2387        'ADM1.1~`':U +
     2388        'SmartObject~`':U +
     2389        'FRAME~`':U +
     2390        'NO ~`':U +
     2391        '~`':U +
     2392        '~`':U +
     2393        '~`':U +
     2394        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     2395           + "~`":U +
     2396        'Layout,Hide-on-Init~`':U +
     2397        '~`':U +
     2398        '~`':U +
     2399        '~`~`~`~`~`~`~`~`~`~`~`':U +
     2400        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     2401            THEN "^^":U
     2402        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     2403             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     2404   PROCEDURE adm-apply-entry :
     2405     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     2406   END PROCEDURE.
     2407   PROCEDURE adm-destroy :
     2408    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     2409   END PROCEDURE.
     2410   PROCEDURE adm-disable :
     2411       DISABLE T-cons T-supp T-parts date-calc date-cred WITH FRAME F-Main.
     2412       RUN dispatch ('disable-fields':U).
     2413       RUN set-attribute-list ('ENABLED=no':U).
     2414       RETURN.
     2415   END PROCEDURE.
     2416   PROCEDURE adm-edit-attribute-list :
     2417         RUN adm/support/contnrd.w (INPUT THIS-PROCEDURE).
     2418         RETURN.
     2419   END PROCEDURE.
     2420   PROCEDURE adm-enable :
     2421       ENABLE UNLESS-HIDDEN T-cons T-supp T-parts date-calc date-cred WITH FRAME F-Main.
     2422       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     2423       RUN set-attribute-list ('ENABLED=yes':U).
     2424       RETURN.
     2425   END PROCEDURE.
     2426   PROCEDURE adm-exit :
     2427        RUN notify ('exit':U).
     2428     RETURN.
     2429   END PROCEDURE.
     2430   PROCEDURE adm-hide :
     2431     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     2432   END PROCEDURE.
     2433   PROCEDURE adm-initialize :
     2434     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     2435   END PROCEDURE.
     2436   PROCEDURE adm-show-errors :
     2437       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     2438       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     2439           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     2440       END.
     2441       RETURN.
     2442   END PROCEDURE.
     2443   PROCEDURE adm-UIB-mode :
     2444     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     2445   END PROCEDURE.
     2446   PROCEDURE adm-view :
     2447     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     2448   END PROCEDURE.
     2449   PROCEDURE dispatch :
     2450       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     2451       RUN broker-dispatch IN adm-broker-hdl
     2452           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     2453       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     2454   END PROCEDURE.
     2455   PROCEDURE ensure-broker :
     2456   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     2457   IF RETURN-VALUE NE "ADM-Broker":U THEN
     2458   DO:
     2459       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     2460       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     2461   END.
     2462   END PROCEDURE.
     2463   PROCEDURE get-attribute :
     2464     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     2465     RUN broker-get-attribute IN adm-broker-hdl
     2466         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     2467     RETURN RETURN-VALUE.
     2468   END PROCEDURE.
     2469   PROCEDURE get-attribute-list :
     2470     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     2471     RUN broker-get-attribute-list IN adm-broker-hdl
     2472         (INPUT THIS-PROCEDURE,
     2473          INPUT ?,
     2474          OUTPUT p-attr-list) NO-ERROR.
     2475     RETURN.
     2476   END PROCEDURE.
     2477   PROCEDURE new-state :
     2478     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     2479     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     2480     RETURN.
     2481   END PROCEDURE.
     2482   PROCEDURE notify :
     2483     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     2484     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     2485     IF RETURN-VALUE = "ADM-ERROR":U THEN
     2486         RETURN "ADM-ERROR":U.
     2487     RETURN.
     2488   END PROCEDURE.
     2489   PROCEDURE set-attribute-list :
     2490     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     2491     RUN ensure-broker.
     2492     RUN broker-set-attribute-list IN adm-broker-hdl
     2493         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     2494     RETURN.
     2495   END PROCEDURE.
     2496   PROCEDURE set-position :
     2497       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     2498       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     2499       IF VALID-HANDLE(adm-object-hdl) THEN
     2500       DO:
     2501           DEFINE VARIABLE parent-hdl AS HANDLE NO-UNDO.
     2502           IF adm-object-hdl:TYPE = "WINDOW":U THEN
     2503           DO:
     2504             IF p-row = 0 THEN p-row =
     2505               (SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2.
     2506             IF p-col = 0 THEN p-col =
     2507               (SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2.
     2508           END.
     2509           ELSE IF adm-object-hdl:TYPE = "DIALOG-BOX":U THEN
     2510           DO:
     2511             parent-hdl = adm-object-hdl:PARENT.
     2512             IF p-row = 0 THEN p-row =
     2513               ((SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2) -
     2514                 parent-hdl:ROW.
     2515             IF p-col = 0 THEN p-col =
     2516               ((SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2) -
     2517                 parent-hdl:COL.
     2518           END.
     2519           IF p-row GE 0 AND p-row < 1 THEN p-row = 1.
     2520           IF p-col GE 0 AND p-col < 1 THEN p-col = 1.
     2521         ASSIGN adm-object-hdl:ROW    =   p-row
     2522                adm-object-hdl:COLUMN =   p-col.
     2523       END.
     2524       RETURN.
     2525   END PROCEDURE.
     2526   RUN set-attribute-list ("CURRENT-PAGE=0,ADM-OBJECT-HANDLE=":U +
     2527       STRING(adm-object-hdl)).
     2528   PAUSE 0 BEFORE-HIDE.
     2529   PROCEDURE adm-change-page :
     2530     RUN broker-change-page IN adm-broker-hdl (INPUT THIS-PROCEDURE) NO-ERROR.
     2531     END PROCEDURE.
     2532   PROCEDURE delete-page :
     2533     DEFINE INPUT PARAMETER p-page# AS INTEGER NO-UNDO.
     2534     RUN broker-delete-page IN adm-broker-hdl
     2535         (INPUT THIS-PROCEDURE, INPUT p-page#).
     2536     END PROCEDURE.
     2537   PROCEDURE init-object :
     2538     DEFINE INPUT PARAMETER  p-proc-name   AS CHARACTER NO-UNDO.
     2539     DEFINE INPUT PARAMETER  p-parent-hdl  AS HANDLE    NO-UNDO.
     2540     DEFINE INPUT PARAMETER  p-attr-list   AS CHARACTER NO-UNDO.
     2541     DEFINE OUTPUT PARAMETER p-proc-hdl    AS HANDLE    NO-UNDO.
     2542     RUN broker-init-object IN adm-broker-hdl
     2543         (INPUT THIS-PROCEDURE, INPUT p-proc-name, INPUT p-parent-hdl,
     2544          INPUT p-attr-list, OUTPUT p-proc-hdl) NO-ERROR.
     2545     RETURN.
     2546   END PROCEDURE.
     2547   PROCEDURE init-pages :
     2548     DEFINE INPUT PARAMETER p-page-list      AS CHARACTER NO-UNDO.
     2549     RUN broker-init-pages IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     2550         INPUT p-page-list) NO-ERROR.
     2551     END PROCEDURE.
     2552   PROCEDURE select-page :
     2553     DEFINE INPUT PARAMETER p-page#     AS INTEGER   NO-UNDO.
     2554     RUN broker-select-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     2555         INPUT p-page#) NO-ERROR.
     2556     END PROCEDURE.
     2557   PROCEDURE view-page :
     2558     DEFINE INPUT PARAMETER p-page#      AS INTEGER   NO-UNDO.
     2559     RUN broker-view-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     2560         INPUT p-page#).
     2561     END PROCEDURE.
     2562   ON LEAVE OF date-calc IN FRAME F-Main
     2563   DO:
     2564     RUN verify-date.
     2565   END.
     2566   ON LEAVE OF date-cred IN FRAME F-Main
     2567   DO:
     2568     RUN verify-date.
     2569   END.
     2570   ON VALUE-CHANGED OF T-parts IN FRAME F-Main
     2571   DO:
     2572     assign
     2573     T-parts.
     2574     if T-parts then do:
     2575       assign
     2576       T-cons = yes
     2577       T-supp = yes
     2578       .
     2579       DISPLAY
     2580       T-cons
     2581       T-supp
     2582       WITH FRAME F-Main.
     2583     end.
     2584   END.
     2585   if not this-procedure :persistent
     2586   then do:
     2587     message
     2588       vss-workfile vss-revision vss-description skip
     2589       "Ошибка при запуске процедуры" skip
     2590       "Данную процедуру следует запускать только с параметром persistent" skip
     2591       view-as alert-box error .
     2592     undo, return error .
     2593   end.
     2594   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2595   on ' ' of date-calc in frame F-Main
     2596   do:
     2597     if (can-query (self, "sensitive")
     2598        and
     2599        self :sensitive = true
     2600        )
     2601     or (can-query (self, "read-only")
     2602        and
     2603        self :read-only = false
     2604        )
     2605     then do:
     2606       assign
     2607         self :screen-value = ?
     2608       .
     2609     end.
     2610     return no-apply.
     2611   end.
     2612   on delete-character of date-calc in frame F-Main
     2613   do:
     2614     if (can-query (self, "sensitive")
     2615        and
     2616        self :sensitive = true
     2617        )
     2618     or (can-query (self, "read-only")
     2619        and
     2620        self :read-only = false
     2621        )
     2622     then do:
     2623       assign
     2624         self :screen-value = ?
     2625       .
     2626     end.
     2627     return no-apply.
     2628   end.
     2629   on ctrl-d of date-calc in frame F-Main
     2630   do:
     2631     define variable v-curr-sv-date as date no-undo .
     2632     if (can-query (self, "sensitive")
     2633        and
     2634        self :sensitive = true
     2635        )
     2636     or (can-query (self, "read-only")
     2637        and
     2638        self :read-only = false
     2639        )
     2640     then do:
     2641       if self :handle <> focus :handle
     2642       then do:
     2643         apply "entry":u to self .
     2644       end.
     2645       run gbl/getcurdt.p
     2646         (output v-curr-sv-date
     2647         ) .
     2648       assign
     2649         self :screen-value = string(v-curr-sv-date) .
     2650       .
     2651     end.
     2652     return no-apply.
     2653   end.
     2654   on ctrl-b of date-calc in frame F-Main
     2655   do:
     2656     if (can-query (self, "sensitive")
     2657        and
     2658        self :sensitive = true
     2659        )
     2660     or (can-query (self, "read-only")
     2661        and
     2662        self :read-only = false
     2663        )
     2664     then do:
     2665       if self :handle <> focus :handle
     2666       then do:
     2667         apply "entry":u to self .
     2668       end.
     2669       define variable v-curr-sv-date as date no-undo .
     2670       define variable v-new-sv-date  as date no-undo .
     2671       assign
     2672         v-curr-sv-date = date(self :screen-value) no-error
     2673       .
     2674       if v-curr-sv-date = ?
     2675       then do:
     2676         run gbl/getcurdt.p
     2677           (output v-curr-sv-date
     2678           ) .
     2679       end.
     2680       if v-curr-sv-date <> ?
     2681       then do:
     2682         assign
     2683           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     2684         .
     2685         assign
     2686           self :screen-value = string(v-new-sv-date) .
     2687         .
     2688       end.
     2689     end.
     2690     return no-apply .
     2691   end.
     2692   on ctrl-e of date-calc in frame F-Main
     2693   do:
     2694     if (can-query (self, "sensitive")
     2695        and
     2696        self :sensitive = true
     2697        )
     2698     or (can-query (self, "read-only")
     2699        and
     2700        self :read-only = false
     2701        )
     2702     then do:
     2703       if self :handle <> focus :handle
     2704       then do:
     2705         apply "entry":u to self .
     2706       end.
     2707       define variable v-curr-sv-date as date no-undo .
     2708       define variable v-new-sv-date  as date no-undo .
     2709       assign
     2710         v-curr-sv-date = date(self :screen-value) no-error
     2711       .
     2712       if v-curr-sv-date = ?
     2713       then do:
     2714         run gbl/getcurdt.p
     2715           (output v-curr-sv-date
     2716           ) .
     2717       end.
     2718       if v-curr-sv-date <> ?
     2719       then do:
     2720         run gbl/lastdate.p
     2721           (input  v-curr-sv-date
     2722           ,output v-new-sv-date
     2723           ).
     2724         assign
     2725           self :screen-value = string(v-new-sv-date) .
     2726         .
     2727       end.
     2728     end.
     2729     return no-apply .
     2730   end.
     2731   on ctrl-f of date-calc in frame F-Main
     2732   do:
     2733     if (can-query (self, "sensitive")
     2734        and
     2735        self :sensitive = true
     2736        )
     2737     or (can-query (self, "read-only")
     2738        and
     2739        self :read-only = false
     2740        )
     2741     then do:
     2742       if self :handle <> focus :handle
     2743       then do:
     2744         apply "entry":u to self .
     2745       end.
     2746       define variable v-ok            as logical   no-undo .
     2747       define variable v-curr-sv-date  as date      no-undo .
     2748       define variable v-description   as character no-undo .
     2749       assign
     2750         v-curr-sv-date = date(self :screen-value) no-error
     2751       .
     2752       if v-curr-sv-date = ?
     2753       then do:
     2754         run gbl/getcurdt.p
     2755           (output v-curr-sv-date
     2756           ) .
     2757       end.
     2758       if v-curr-sv-date <> ?
     2759       then do:
     2760         run gbl/d-inpday.w
     2761           (input ?
     2762           ,input "Выбор даты"
     2763           ,input v-description
     2764           ,input ""
     2765           ,input-output v-curr-sv-date
     2766           ,output v-ok
     2767           ).
     2768         if v-ok = true
     2769         then do:
     2770           assign
     2771             self :screen-value = string(v-curr-sv-date) .
     2772           .
     2773         end.
     2774       end.
     2775     end.
     2776     return no-apply .
     2777   end.
     2778     define MENU m-ed-date25
     2779       MENU-ITEM m-ed-date25-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
     2780       MENU-ITEM m-ed-date25-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
     2781       MENU-ITEM m-ed-date25-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
     2782       MENU-ITEM m-ed-date25-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
     2783       .
     2784     if date-calc :POPUP-MENU in frame F-Main = ?
     2785     then do:
     2786       ASSIGN
     2787         date-calc :POPUP-MENU in frame F-Main = MENU m-ed-date25 :HANDLE
     2788         date-calc :MENU-MOUSE in frame F-Main = 3
     2789       .
     2790     end.
     2791     define variable v-label-handle25 as handle no-undo .
     2792     assign
     2793       v-label-handle25 = date-calc :side-label-handle in frame F-Main
     2794     .
     2795     if valid-handle (v-label-handle25)
     2796     then do:
     2797       if v-label-handle25 :tooltip = ""
     2798       or v-label-handle25 :tooltip = ?
     2799       then do:
     2800         assign
     2801           v-label-handle25 :tooltip = "Ctrl-D - текущая, Ctrl-B - начало, Ctrl-E - конец, Ctrl-F - календарь, Прав.Клавиша Мыши - Popup Menu"
     2802         .
     2803       end.
     2804     end.
     2805     ON CHOOSE OF MENU-ITEM m-ed-date25-1 in menu m-ed-date25 DO:
     2806       apply "ctrl-b":U to date-calc in frame F-Main .
     2807     END.
     2808     ON CHOOSE OF MENU-ITEM m-ed-date25-2 in menu m-ed-date25 DO:
     2809       apply "ctrl-d":U to date-calc in frame F-Main .
     2810     END.
     2811     ON CHOOSE OF MENU-ITEM m-ed-date25-3 in menu m-ed-date25 DO:
     2812       apply "ctrl-e":U to date-calc in frame F-Main .
     2813     END.
     2814     ON CHOOSE OF MENU-ITEM m-ed-date25-4 in menu m-ed-date25 DO:
     2815       apply "ctrl-f":U to date-calc in frame F-Main .
     2816     END.
