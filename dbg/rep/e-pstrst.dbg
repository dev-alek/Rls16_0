      413   procedure create_obj-list :
      414      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      415      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      416      do
      417      on error undo, return error return-value
      418      :
      419         define buffer cli-obj for ub.clients .
      420         define variable p-var as integer no-undo .
      421         define buffer buf_obj-list for obj-list .
      422         find last buf_obj-list  use-index pi no-error .
      423         if available buf_obj-list
      424         then
      425            p-var = buf_obj-list.obj-id + 1.
      426         else
      427            p-var = 1.
      428         find first cli-obj where
      429                   cli-obj.obj-type = p-obj-type
      430               and cli-obj.obj-code = p-obj-code
      431         no-lock no-error.
      432         if available cli-obj
      433         then do:
      434            create buf_obj-list.
      435            assign
      436               buf_obj-list.obj-id   = p-var
      437               buf_obj-list.obj-code = cli-obj.obj-code
      438               buf_obj-list.obj-type = cli-obj.obj-type
      439               buf_obj-list.obj-name = cli-obj.obj-name
      440               buf_obj-list.db-num   = cli-obj.db-num
      441            .
      442         end.
      443      end.
      444   end.
