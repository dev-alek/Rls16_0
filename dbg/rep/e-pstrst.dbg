     3345         end.
     3346         else do:
     3347           assign
     3348             v-is-attr = no
     3349           .
     3350           if available buf_trn-doc and buf_trn-doc.fact-date > cdate then NEXT.
     3351           assign
     3352             v-parts-VAt-pc  = buf_temp-parts.vat-pc
     3353             v-parts-SLT-pc  = buf_temp-parts.SLT-pc
     3354             v-supp-type     = buf_temp-parts.supp-type
     3355             v-supp-code     = buf_temp-parts.supp-code
     3356             v-purch-code    = buf_temp-parts.purch-code
     3357             v-pay-code      = buf_temp-parts.pay-code
     3358             v-in-code       = buf_temp-parts.in-code
     3359             v-fact-date     = (if available buf_trn-doc then buf_trn-doc.fact-date else ?)
     3360             v-obj-type      = buf_temp-parts.obj-type
     3361             v-obj-code      = buf_temp-parts.obj-code
     3362             v-cst-code      = buf_temp-parts.cst-code
     3363           .
     3364         end.
     3365         IF NOT T-parts then do:
     3366           IF T-supp then
     3367           FIND FIRST sj-goods WHERE
     3368                     sj-goods.artic = gds-obj.artic AND
     3369                     sj-goods.prod-type = gds-obj.prod-type AND
     3370                     sj-goods.prod-code = gds-obj.prod-code AND
     3371                     sj-goods.VAT-supp = v-parts-VAT-pc AND
     3372                     sj-goods.SLT-supp = v-parts-SLT-pc AND
     3373                     sj-goods.supp-type = v-supp-type AND
     3374                     sj-goods.supp-code = v-supp-code AND
     3375                     (NOT T-cons OR
     3376                     (sj-goods.purch-code = v-purch-code
     3377                      AND
     3378                     sj-goods.pay-code = v-pay-code))
     3379                     No-error.
     3380           ELSE
     3381           FIND FIRST sj-goods WHERE
     3382                     sj-goods.artic = gds-obj.artic AND
     3383                     sj-goods.prod-type = gds-obj.prod-type AND
     3384                     sj-goods.prod-code = gds-obj.prod-code AND
     3385                     sj-goods.VAT-supp = v-parts-VAT-pc AND
     3386                     sj-goods.SLT-supp = v-parts-SLT-pc AND
     3387                     (NOT T-cons OR
     3388                     (sj-goods.purch-code = v-purch-code
     3389                      AND
     3390                     sj-goods.pay-code = v-pay-code))
     3391                     No-error.
     3392         END.
     3393         if not avail sj-goods or T-parts then do:
     3394           FIND FIRST goods No-LOCK WHERE
     3395                       goods.gds-code = gds-obj.gds-code  NO-ERROR.
     3396           FIND FIRST gds-prt where
     3397                       gds-prt.upper-code = goods.prt-root NO-LOCK .
     3398           FIND FIRST bar-code No-LOCK WHERE
     3399                       bar-code.gds-code = gds-obj.gds-code AND
     3400                       bar-code.in-code = "" AND
     3401                       bar-code.part-code = "" AND
     3402                       bar-code.node-code =  gds-prt.node-code  AND
     3403                       bar-code.unit-cli = goods.unit-base NO-ERROR.
     3404           create sj-goods.
     3405   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3406   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3407     (input  gds-obj.obj-type
     3408     ,input  gds-obj.obj-code
     3409     ,output v-host-code
     3410     )  .
     3411   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3412   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     3413     (input  goods.gds-code
     3414     ,input  '1':U
     3415     ,input  ?
     3416     ,input  v-host-code
     3417     ,input  gds-obj.obj-type
     3418     ,input  gds-obj.obj-code
     3419     ,output v-vat-pc
     3420     ) no-error .
     3421   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3422   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     3423     (input  goods.gds-code
     3424     ,input  '2':U
     3425     ,input  ?
     3426     ,input  v-host-code
     3427     ,input  gds-obj.obj-type
     3428     ,input  gds-obj.obj-code
     3429     ,output v-slt-pc
     3430     ) no-error .
     3431           assign
     3432           sj-goods.artic      = goods.artic
     3433           sj-goods.b-code     = bar-code.b-code
     3434           sj-goods.prod-type  = goods.prod-type
     3435           sj-goods.prod-code  = goods.prod-code
     3436           sj-goods.VAT-PC     = v-vat-pc
     3437           sj-goods.SLT-pc     = v-slt-pc
     3438           sj-goods.unit       = goods.unit-base
     3439           sj-goods.is-prt     = gds-prt.node-name <> '_Пустая шкала':U
     3440           sj-goods.prt-root   = goods.prt-root
     3441           sj-goods.gds-name   = REPLACE(goods.gds-name, " ", "_")
     3442           sj-goods.engl-name  = REPLACE(goods.engl-name, " ", "_")
     3443           sj-goods.VAT-supp   = v-parts-VAT-pc
     3444           sj-goods.SLT-supp   = v-parts-SLT-pc
     3445           sj-goods.supp-type  = IF T-supp OR T-parts then v-supp-type else ""
     3446           sj-goods.supp-code  = IF T-supp OR T-parts then v-supp-code else 0
     3447           sj-goods.purch-code = IF T-cons or T-parts
     3448                                   then v-purch-code
     3449                                   else 0
     3450           sj-goods.pay-code   = IF T-cons or T-parts
     3451                                   then v-pay-code
     3452                                   else 0
     3453           sj-goods.in-code    = if T-parts then v-in-code else ""
     3454           sj-goods.fact-date  = if T-parts then v-fact-date else ?
     3455           sj-goods.obj-type   = if T-parts then v-obj-type else "":U
     3456           sj-goods.obj-code   = if T-parts then v-obj-code else 0
     3457           sj-goods.cst-code   = if T-parts then v-cst-code else "":U
     3458           sj-goods.nids       = v-nids
     3459           sj-goods.dids       = v-dids
     3460           sj-goods.nsf        = v-nsf
     3461           sj-goods.dsf        = v-dsf
     3462           sj-goods.s-price    = gds-obj.fact-sale / gds-obj.fact-qnty
     3463           .
     3464           if sj-goods.s-price = ? then do:
     3465             assign
     3466               sj-goods.s-price = 0
     3467             .
     3468           end.
     3469         END.
     3470   assign
     3471     price-rubl-with-tax-loc = buf_temp-parts.price-rubl
     3472     price-base-with-tax-loc = buf_temp-parts.price-base
     3473   .
     3474   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     3475   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     3476     (output varinvprb
     3477     )  .
     3478     if buf_temp-parts.out-code = 'free-zone':U     or
     3479        buf_temp-parts.out-code = 'out-zone':U   or
     3480        buf_temp-parts.doc-type = 'акт':U then do:
     3481       assign
     3482         in-vatp-have-vat-slt = yes.
     3483     end.
     3484     else do:
     3485       find first in-vatp_doc-attr no-lock
     3486         where in-vatp_doc-attr.doc-code  = buf_temp-parts.out-code
     3487           and in-vatp_doc-attr.attr-code = 'envd':U
     3488         no-error .
     3489       if not available in-vatp_doc-attr then do:
     3490         assign
     3491           in-vatp-have-vat-slt = yes.
     3492       end.
     3493       else do:
     3494            in-vatp-have-vat-slt = no.
     3495       end.
     3496     end.
     3497     assign
     3498      price-cli-with-tax-loc = buf_temp-parts.price-cli
     3499      cli-base-rate          = buf_temp-parts.cli-base-rate.
     3500     ASSIGN   road-tax-base-loc  = (if buf_temp-parts.road-tax-base  = ? then 0 else buf_temp-parts.road-tax-base)
     3501              road-tax-rubl-loc  = (if buf_temp-parts.road-tax-rubl  = ? then 0 else buf_temp-parts.road-tax-rubl).
     3502     ASSIGN  transport-base-loc = (if buf_temp-parts.transport-base = ? then 0 else buf_temp-parts.transport-base)
     3503             transport-rubl-loc = (if buf_temp-parts.transport-rubl = ? then 0 else buf_temp-parts.transport-rubl)
     3504             other-base-loc     = (if buf_temp-parts.other-base     = ? then 0 else buf_temp-parts.other-base)
     3505             other-rubl-loc     = (if buf_temp-parts.other-rubl     = ? then 0 else buf_temp-parts.other-rubl)
     3506             vat-pc-loc         = (if buf_temp-parts.vat-pc         = ? then 0 else buf_temp-parts.vat-pc)
     3507             slt-pc-loc         = (if buf_temp-parts.slt-pc         = ? then 0 else buf_temp-parts.slt-pc).
     3508             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     3509       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     3510     assign
     3511       exch-rate-cli-loc = (buf_temp-parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_temp-parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_temp-parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_temp-parts.price-cli .
     3512     assign
     3513       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     3514       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     3515       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     3516       transport-cli-loc  = 0
     3517       other-cli-loc      = 0
     3518     .
     3519   ASSIGN
     3520             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     3521       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     3522   .
     3523         assign
     3524         prt-qnty =  (IF buf_temp-parts.out-code = 'free-zone':U
     3525                      then
     3526                      buf_temp-parts.qnty
     3527                      else abs(buf_temp-parts.qnty))
     3528         sj-goods.qnty = sj-goods.qnty +  prt-qnty
     3529         sj-goods.sale-sum-rubl = if v-curr-r-b = 'base':U
     3530                                  then sj-goods.sale-sum-rubl
     3531                                  else (sj-goods.sale-sum-rubl + sj-goods.s-price * prt-qnty)
     3532         sj-goods.sale-sum-base = if v-curr-r-b = 'base':U
     3533                                  then (sj-goods.sale-sum-base + sj-goods.s-price * prt-qnty)
     3534                                  else sj-goods.sale-sum-base
     3535         sj-goods.uchet-price-base = if T-parts then buf_temp-parts.price-base else 0
     3536         sj-goods.uchet-price-rubl = if T-parts then buf_temp-parts.price-rubl else 0
     3537         sj-goods.uchet-sum-base = sj-goods.uchet-sum-base + buf_temp-parts.price-base * prt-qnty
     3538         sj-goods.uchet-sum-rubl = sj-goods.uchet-sum-rubl + buf_temp-parts.price-rubl * prt-qnty
     3539         sj-goods.uchet-sum-base-without-tax = sj-goods.uchet-sum-base-without-tax +
     3540                                              (price-base-with-tax-loc - slt-base-loc - vat-base-loc) * prt-qnty
     3541         sj-goods.uchet-sum-rubl-without-tax = sj-goods.uchet-sum-rubl-without-tax +
     3542                                              (price-rubl-with-tax-loc  - slt-rubl-loc - vat-rubl-loc) * prt-qnty
     3543         .
     3544       END.
     3545     END.
     3546   END.
