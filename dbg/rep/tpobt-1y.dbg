     3717   procedure di :
     3718   def input parameter p1 as char no-undo.
     3719   def input parameter p2 as int no-undo.
     3720   def input parameter p3 as char no-undo.
     3721   def input parameter p4 as char no-undo.
     3722   def input parameter p5 as char no-undo.
     3723   def input parameter p6 as char no-undo.
     3724   def input parameter p7 as char no-undo.
     3725    case caps(p7) :
     3726      when "b1":u  then do:
     3727       DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     3728         p3 @ s-bar-code
     3729         p4 @ gds-zap-artic
     3730         p5 @ gds-zap-gds-name
     3731         p6 @ gds-zap-unit-base
     3732         p1 @ gds-type
     3733         b1-ostatok-start [p2] format "->>>>>>>>>>9.<<" @  F-ostatok-start
     3734         b1-Prih          [p2] format "->>>>>>>>>>9.<<" @  F-Prih
     3735         b1-RAsh          [p2] format "->>>>>>>>>>9.<<" @  F-RAsh
     3736         b1-KAssa         [p2] format "->>>>>>>>>>9.<<" @  F-KAssa
     3737         b1-Inv           [p2] format "->>>>>>>>>>9.<<" @  F-Inv
     3738         b1-Overturn      [p2] format "->>>>>>>>>>9.<<" @  F-Overturn
     3739         b1-Ostatok-end   [p2] format "->>>>>>>>>>9.<<" @  F-Ostatok-end
     3740         b1-gds-zap-other      format "->>>>>>>>>>9.<<" when (p2 = 1) @  gds-zap-other
     3741         with FRAME ZAPAS .
     3742                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     3743                   end.
     3744      when "b2":u  then  do:
     3745       DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     3746         p3 @ s-bar-code
     3747         p4 @ gds-zap-artic
     3748         p5 @ gds-zap-gds-name
     3749         p6 @ gds-zap-unit-base
     3750         p1 @ gds-type
     3751         b2-ostatok-start [p2] format "->>>>>>>>>>9.<<" @  F-ostatok-start
     3752         b2-Prih          [p2] format "->>>>>>>>>>9.<<" @  F-Prih
     3753         b2-RAsh          [p2] format "->>>>>>>>>>9.<<" @  F-RAsh
     3754         b2-KAssa         [p2] format "->>>>>>>>>>9.<<" @  F-KAssa
     3755         b2-Inv           [p2] format "->>>>>>>>>>9.<<" @  F-Inv
     3756         b2-Overturn      [p2] format "->>>>>>>>>>9.<<" @  F-Overturn
     3757         b2-Ostatok-end   [p2] format "->>>>>>>>>>9.<<" @  F-Ostatok-end
     3758         b2-gds-zap-other      format "->>>>>>>>>>9.<<" when (p2 = 1) @  gds-zap-other
     3759         with FRAME ZAPAS .
     3760                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     3761                 end.
     3762      when "bi":u then  do:
     3763       DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
