     3594                 then DO: Assign temp-str = string("ГРУППА : " + gds-zap-grp-name )         b1-name = gds-zap-grp-name . end.
     3595                 else DO: Assign temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name ) b1-name = gds-zap-prod-name. end.
     3596               if par-3 = "6"  then  dO:
     3597                  if xTog-obj = true then do:
     3598                    var-vat-pc = func-vat (input gds-zap-b-code , input x-store-type, input x-store-code)
     3599                     .
     3600                   end.
     3601                  else do:
     3602                   var-vat-pc = temp-gds-list.vat-pc .
     3603                   end.
     3604                   assign
     3605                       temp-str = string( "СТАВКА НДС : " + string(var-vat-pc) + "%" )
     3606                       b1-name = temp-str.
     3607                   end.
     3608               if NOT xSumsOnly or (par-3 = "4" Or par-3 = "5" ) THEN DO :
     3609                   fr0 = true .
     3610                   tmp#stroka0 = temp-str.
     3611               End.
     3612             End.
     3613               IF (par-3 = "4"  OR  par-3 = "5")  THEN DO:
     3614                 if par-3 = "4"
     3615                   then Assign temp-str = string("ГРУППА : " + gds-zap-grp-name )          b2-name = gds-zap-grp-name .
     3616                   else Assign temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name )  b2-name = gds-zap-prod-name.
     3617                 if NOT xSumsOnly THEN DO:
     3618                     fr = true .
     3619                 End.
     3620                 break_group1 = false.
     3621               END.
     3622          break_group = false.
     3623       End.
     3624       gds-zap-gds-name = string(old-gds-zap-gds-name,"x(28)") + "|"   + "Консиг".
     3625       run display-line.
     3626       x-type-pr = "s".
     3627       run foreach.
     3628   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     3629     (input  gds-zap-b-code
     3630     ,input  ?
     3631     ,output v-bar-code
     3632     )  .
     3633   s-bar-code = string (v-bar-code,"999999999").
     3634       If  break_group = true  and par-3 <> "1"  then DO :
     3635            FIND FIRST clients WHERE clients.obj-type = gds-zap-prod-type AND clients.obj-code = gds-zap-prod-code use-index pi NO-LOCK .
