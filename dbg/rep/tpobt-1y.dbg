     4168     excel-sum(bo-Overturn     [6  + f_e ])  CHR(9)
     4169     excel-sum(bo-Overturn     [9  + f_e ])  CHR(9)
     4170     excel-qnty(bo-Ostatok-end [1  + f_e ])  CHR(9)
     4171     excel-sum(bo-Ostatok-end  [2  + f_e ])  CHR(9)
     4172     excel-sum(bo-Ostatok-end  [5  + f_e ])  CHR(9)
     4173     excel-sum(bo-Ostatok-end  [8  + f_e ])  CHR(9)
     4174     excel-sum(bo-Ostatok-end  [3  + f_e ])  CHR(9)
     4175     excel-sum(bo-Ostatok-end  [6  + f_e ])  CHR(9)
     4176     excel-sum(bo-Ostatok-end  [9  + f_e ])  CHR(9)
     4177     g2
