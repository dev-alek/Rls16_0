     3402       bi-rash                                            [kk]    = 0
     3403       bi-kassa                                           [kk]    = 0
     3404       bi-inv                                             [kk]    = 0
     3405       bi-overturn                                        [kk]    = 0
     3406       bi-ostatok-end                                     [kk]    = 0
     3407       bi-ostatok-start                                   [kk]    = 0   .
     3408      end.
     3409   end procedure.
     3410   procedure display-title :
     3411   define variable v-nn as integer   no-undo .
     3412      PUT stream  OutStream  UNFORMATTED  string( v-cntxt-host-name-obj +  " , " + x-store-type  +  " " + objname) at 50 format "x(85)" skip(2)
     3413             reportname  at 20 format "x(170)" skip
     3414             trim(str1)  at 35 format "x(75)" skip.
     3415        v-nn = num-entries(str2,chr(10)) .
     3416        repeat i = 1 to v-nn :
     3417         PUT stream  OutStream  UNFORMATTED  entry(i,str2,chr(10))  at 1 format "x(170)" skip.
     3418        end.
     3419       i=0.
     3420        PUT stream  OutStream  UNFORMATTED  trim(str3)  at 35 format "x(75)" skip.
     3421        v-nn = num-entries(str4,chr(10)) .
     3422        repeat i = 1 to v-nn:
     3423          PUT stream  OutStream  UNFORMATTED  entry(i,str4,chr(10))  at 1 format "x(170)" skip.
     3424        end.
     3425       i=0.
     3426        v-nn = num-entries( reportheader,chr(10)) .
     3427        repeat i = 1 to v-nn :
     3428         PUT stream  OutStream  UNFORMATTED  entry(i,reportheader,chr(10))  at 1 format "x(170)" skip.
     3429        end.
     3430       i=0.
     3431       run rep/extitle.p (1) .
     3432   end procedure.
     3433   procedure report-exec1  :
     3434      find first clients where x-store-type = clients.obj-type and
     3435                               x-store-code = clients.obj-code no-lock no-error.
     3436     run calcitog.
     3437     run print-header.
     3438      case retclassify :
     3439         when "no-classify":u  then   run run1 in this-procedure .
     3440         otherwise do:
     3441           message "error" view-as alert-box error .
     3442         end.
     3443      end case.
     3444     run print-footer.
     3445     end procedure.
     3446   procedure calc-sub-itog :
     3447   define variable b  as int no-undo.
     3448   assign
     3449     b1-gds-zap-other = b1-gds-zap-other +  gds-zap-other
     3450     b2-gds-zap-other = b2-gds-zap-other +  gds-zap-other
     3451     bi-gds-zap-other = bi-gds-zap-other +  gds-zap-other
     3452     bo-gds-zap-other = bo-gds-zap-other +  gds-zap-other
     3453     .
     3454   repeat b = 1 to 20 :
     3455     assign
     3456     b1-ostatok-start[b ]    = b1-ostatok-start[b ]    +  ostatok-start[b ]
     3457     b1-ostatok-end  [b ]    = b1-ostatok-end  [b ]    +  ostatok-end  [b ]
     3458     b2-ostatok-start[b ]    = b2-ostatok-start[b ]    +  ostatok-start[b ]
     3459     b2-ostatok-end  [b ]    = b2-ostatok-end  [b ]    +  ostatok-end  [b ]
     3460     bi-ostatok-start[b ]    = bi-ostatok-start[b ]    +  ostatok-start[b ]
     3461     bi-ostatok-end  [b ]    = bi-ostatok-end  [b ]    +  ostatok-end  [b ]
     3462     bo-ostatok-start[b ]    = bo-ostatok-start[b ]    +  ostatok-start[b ]
     3463     bo-ostatok-end  [b ]    = bo-ostatok-end  [b ]    +  ostatok-end  [b ]
     3464     b1-prih[b ]    = b1-prih[b ]    +  prih[b ]
     3465     b2-prih[b ]    = b2-prih[b ]    +  prih[b ]
     3466     bi-prih[b ]    = bi-prih[b ]    +  prih[b ]
     3467     bo-prih[b ]    = bo-prih[b ]    +  prih[b ]
     3468     b1-rash[b ]    = b1-rash[b ]    +  rash[b ]
     3469     b2-rash[b ]    = b2-rash[b ]    +  rash[b ]
     3470     bi-rash[b ]    = bi-rash[b ]    +  rash[b ]
     3471     bo-rash[b ]    = bo-rash[b ]    +  rash[b ]
     3472     b1-kassa[b ]    = b1-kassa[b ]    +  kassa[b ]
     3473     b2-kassa[b ]    = b2-kassa[b ]    +  kassa[b ]
     3474     bi-kassa[b ]    = bi-kassa[b ]    +  kassa[b ]
     3475     bo-kassa[b ]    = bo-kassa[b ]    +  kassa[b ]
     3476     b1-inv[b ]    = b1-inv[b ]    +  inv[b ]
     3477     b2-inv[b ]    = b2-inv[b ]    +  inv[b ]
     3478     bi-inv[b ]    = bi-inv[b ]    +  inv[b ]
     3479     bo-inv[b ]    = bo-inv[b ]    +  inv[b ]
     3480     b1-overturn[b ]    = b1-overturn[b ]    +  overturn[b ]
     3481     b2-overturn[b ]    = b2-overturn[b ]    +  overturn[b ]
     3482     bi-overturn[b ]    = bi-overturn[b ]    +  overturn[b ]
     3483     bo-overturn[b ]    = bo-overturn[b ]    +  overturn[b ]
     3484     .
     3485   end.
     3486   end procedure.
     3487   procedure clear-item :
     3488   define variable kk as int no-undo.
     3489    gds-zap-other = 0 .
     3490    repeat kk = 1 to 20 :
     3491    assign
     3492       prih            [kk]    = 0
     3493       rash            [kk]    = 0
     3494       kassa           [kk]    = 0
     3495       inv             [kk]    = 0
     3496       overturn        [kk]    = 0
     3497       ostatok-end     [kk]    = 0
     3498       ostatok-start   [kk]    = 0 .
     3499          end.
     3500    end procedure.
     3501   procedure item-goods :
     3502      def input parameter  par-3 as char no-undo.
     3503      def input parameter  par-4 as char no-undo.
     3504        if par-4 = "goods":u  then do:
     3505           assign
     3506               gds-zap-unit-base  = goods.unit-base
     3507               gds-zap-prt-root   = goods.prt-root
     3508               gds-zap-prod-type  = goods.prod-type
     3509               gds-zap-prod-code  = goods.prod-code
     3510               gds-zap-artic      = goods.artic
     3511               gds-zap-grp-name   = goods.grp-name
     3512               gds-zap-b-code     = goods.gds-code
     3513               gds-zap-type       = goods.gds-type.
     3514           if g#gds-engl then
     3515               assign gds-zap-gds-name = goods.engl-name.
     3516           else
     3517               assign gds-zap-gds-name = goods.gds-name.
     3518        end.
     3519        if par-4 = "gds-list":u  then do:
     3520           assign
     3521               gds-zap-unit-base  = gds-list.unit-base
     3522               gds-zap-prt-root   = gds-list.prt-root
     3523               gds-zap-prod-type  = gds-list.prod-type
     3524               gds-zap-prod-code  = gds-list.prod-code
     3525               gds-zap-artic      = gds-list.artic
     3526               gds-zap-grp-name   = gds-list.grp-name
     3527               gds-zap-b-code     = gds-list.gds-code
     3528               gds-zap-type       = gds-list.gds-type.
     3529           if g#gds-engl then
     3530               assign gds-zap-gds-name = gds-list.engl-name.
     3531           else
     3532               assign gds-zap-gds-name = gds-list.gds-name.
     3533        end.
     3534       define variable old-gds-zap-gds-name as character no-undo .
     3535       old-gds-zap-gds-name = gds-zap-gds-name.
     3536       x-type-pr = "r".
     3537       run foreach.
     3538   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     3539     (input  gds-zap-b-code
     3540     ,input  ?
     3541     ,output v-bar-code
     3542     )  .
     3543   s-bar-code = string (v-bar-code,"999999999").
     3544       If  break_group = true  and par-3 <> "1"  then DO :
     3545            FIND FIRST clients WHERE clients.obj-type = gds-zap-prod-type AND clients.obj-code = gds-zap-prod-code use-index pi NO-LOCK .
     3546            gds-zap-prod-name  = clients.obj-name.
     3547             If break_group1 = true  THEN  DO :
     3548               if (par-3 = "3"  OR  par-3 = "5" ) and  par-3 <> "6"
     3549                 then DO: Assign temp-str = string("ГРУППА : " + gds-zap-grp-name )         b1-name = gds-zap-grp-name . end.
     3550                 else DO: Assign temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name ) b1-name = gds-zap-prod-name. end.
     3551               if par-3 = "6"  then  dO:
     3552                  if xTog-obj = true then do:
     3553                    var-vat-pc = func-vat (input gds-zap-b-code , input x-store-type, input x-store-code)
     3554                     .
     3555                   end.
     3556                  else do:
     3557                   var-vat-pc = temp-gds-list.vat-pc .
     3558                   end.
     3559                   assign
     3560                       temp-str = string( "СТАВКА НДС : " + string(var-vat-pc) + "%" )
     3561                       b1-name = temp-str.
     3562                   end.
     3563               if NOT xSumsOnly or (par-3 = "4" Or par-3 = "5" ) THEN DO :
     3564                   fr0 = true .
     3565                   tmp#stroka0 = temp-str.
     3566               End.
     3567             End.
     3568               IF (par-3 = "4"  OR  par-3 = "5")  THEN DO:
     3569                 if par-3 = "4"
     3570                   then Assign temp-str = string("ГРУППА : " + gds-zap-grp-name )          b2-name = gds-zap-grp-name .
     3571                   else Assign temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name )  b2-name = gds-zap-prod-name.
     3572                 if NOT xSumsOnly THEN DO:
     3573                     fr = true .
     3574                 End.
     3575                 break_group1 = false.
     3576               END.
     3577          break_group = false.
     3578       End.
     3579       gds-zap-gds-name = string(old-gds-zap-gds-name,"x(28)") + "|" + "Выкуп".
     3580       run display-line.
     3581       x-type-pr = "cb".
     3582       run foreach.
     3583   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     3584     (input  gds-zap-b-code
     3585     ,input  ?
     3586     ,output v-bar-code
     3587     )  .
