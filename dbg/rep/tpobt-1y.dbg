     3362           if xshowcrsa    then do: run di ("прод.", 15 ,"","", "", "", "b2":u).  end.
     3363           if xshowsale    then do: run di ("док.", 18 ,"","", "", "", "b2":u).  end.
     3364            if vat-cost    then do: run di ( "уч.НДС", 13,"","","","","b2":u ). end.
     3365            if vat-crsa    then do: run di ( "пр.НДС", 16,"","","","","b2":u ).  end.
     3366            if vat-sale    then do: run di ( "дк.НДС", 19,"","","","","b2":u ).  end.
