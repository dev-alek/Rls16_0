     3661                   else Assign temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name )  b2-name = gds-zap-prod-name.
     3662                 if NOT xSumsOnly THEN DO:
     3663                     fr = true .
