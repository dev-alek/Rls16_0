     4160     excel-sum(bo-Inv          [9  + f_e ])  CHR(9)
     4161     .
     4162     if Make-Excel then  put   stream ForExcel unformatted
     4163     excel-qnty(bo-Overturn    [1  + f_e ])  CHR(9)
     4164     excel-sum(bo-Overturn     [2  + f_e ])  CHR(9)
     4165     excel-sum(bo-Overturn     [5  + f_e ])  CHR(9)
     4166     excel-sum(bo-Overturn     [8  + f_e ])  CHR(9)
