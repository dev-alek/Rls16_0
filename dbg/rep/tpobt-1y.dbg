     3279   procedure display-b1  :
     3280         if not( not show-negativ-2 and
     3281            ( b1-prih          [1]   = 0 and
     3282              b1-rash          [1]   = 0 and
     3283              b1-kassa         [1]   = 0 and
     3284              b1-inv           [1]   = 0 and
     3285              b1-overturn      [1]   = 0 and
     3286              b1-overturn      [5]   = 0 and
     3287              b1-overturn      [8]   = 0 ) ) then do:
     3288           if  not (not show-negativ  and (
     3289                 b1-prih          [1]   = 0 and
     3290                 b1-rash          [1]   = 0 and
     3291                 b1-kassa         [1]   = 0 and
     3292                 b1-inv           [1]   = 0 and
     3293                 b1-overturn      [1]   = 0 and
     3294                 b1-overturn      [5]   = 0 and
     3295                 b1-ostatok-start [1]   = 0 and
     3296                 b1-ostatok-end   [1]   = 0   )) then do:
     3297                 if sums-only then do:
     3298                     if fr0 = true then do:
     3299                         put stream  outstream  tmp#stroka0 format "x(100)" skip.
     3300                         if Make-Excel then  put   stream ForExcel unformatted string(tmp#stroka0) skip.
     3301                         fr0 = false .
     3302                       end.
     3303                  end.
     3304      if p-tpsy = no  or ( p-tpsy = true and  p-type-tpsy-goods = 2 ) then do:
     3305           run di-qnty in this-procedure ("кол-во"  ,1, s-bar-code, gds-zap-artic, gds-zap-gds-name  ,"","b1":u).
     3306           if xshowcost    then do: run di in this-procedure ("учет." ,2 ,"","", "", "", "b1":u).  end.
     3307           if xshowcrsa    then do: run di in this-procedure ("прод." , 5, "","", "", "", "b1":u).  end.
     3308           if xshowsale    then do: run di in this-procedure ("док." , 8, "","", "", "", "b1":u).  end.
     3309           if vat-cost    then do: run di in this-procedure ( "уч.НДС", 3,"","","","","b1":u ). end.
     3310           if vat-crsa    then do: run di in this-procedure ( "пр.НДС", 6,"","","","","b1":u ).  end.
     3311           if vat-sale    then do: run di in this-procedure ( "дк.НДС", 9,"","","","","b1":u ).  end.
     3312      end.
     3313      if p-tpsy = true  then do:
     3314            if  p-type-tpsy-goods = 3 then
     3315                run di-qnty ("кол-во"  ,11, s-bar-code, gds-zap-artic, gds-zap-gds-name  ,"","b1":u).
     3316            else
     3317               run di-qnty in this-procedure ("кол-во"  ,11, "","", str_svoi, "","b1":u).
     3318           if xshowcost    then do: run di in this-procedure ("учет." ,12 ,"","", "", "", "b1":u).  end.
     3319           if xshowcrsa    then do: run di in this-procedure ("прод." ,15, "","", "", "", "b1":u).  end.
     3320           if xshowsale    then do: run di in this-procedure ("док." , 18, "","", "", "", "b1":u).  end.
     3321           if vat-cost    then do: run di in this-procedure ( "уч.НДС", 13,"","","","","b1":u ). end.
     3322           if vat-crsa    then do: run di in this-procedure ( "пр.НДС", 16,"","","","","b1":u ).  end.
     3323           if vat-sale    then do: run di in this-procedure ( "дк.НДС", 19,"","","","","b1":u ).  end.
     3324      end.
     3325          if not sums-only then run p-line.
     3326    end.
     3327    end.
     3328   end procedure.
