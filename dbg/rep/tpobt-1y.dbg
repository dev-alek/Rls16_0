     4266                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     4267    end procedure.
     4268   procedure ost-line-body :
     4269   do on error undo, return error return-value :
     4270   define input parameter p-num        as   integer   no-undo .
     4271   define input parameter p-store-type like ub.clients.obj-type no-undo .
     4272   define input parameter p-store-code like ub.clients.obj-code no-undo .
     4273    find last  ub.aht-stk-line where
     4274                           ub.aht-stk-line.gds-code   = gds-zap-b-code
     4275                     and   ub.aht-stk-line.fact-order <= fact-order-1
     4276                     and   ub.aht-stk-line.obj-code   = p-store-code
     4277                     and   ub.aht-stk-line.obj-type   = p-store-type
     4278                     and   ub.aht-stk-line.sum-type   = x-type-pr
     4279                           use-index category no-lock no-error.
     4280           if available ub.aht-stk-line then do:
     4281               if  tprintrubl  then
     4282                     assign
     4283                           ostatok-start[1 + p-num]  = ostatok-start[1 + p-num] +  (if ub.aht-stk-line.sum-type <> "b"
     4284                                                                   then round( ub.aht-stk-line.fact-qnty,3) else 0 )
     4285                           ostatok-start[2 + p-num]  =ostatok-start[2 + p-num] +  round( ub.aht-stk-line.cost-sum-rubl ,2)
     4286                           ostatok-start[3 + p-num]  =ostatok-start[3 + p-num] +  round( ub.aht-stk-line.cost-vat-rubl ,2)
     4287                           ostatok-start[4 + p-num]  =ostatok-start[4 + p-num] +  0
     4288                           ostatok-start[5 + p-num]  =ostatok-start[5 + p-num]  + round( ub.aht-stk-line.crsa-sum-rubl ,2)
     4289                           ostatok-start[6 + p-num]  =ostatok-start[6 + p-num]  + round( ub.aht-stk-line.crsa-vat-rubl ,2)
     4290                           ostatok-start[7 + p-num]  =ostatok-start[7 + p-num]  + round( ub.aht-stk-line.sale-discnt-rubl ,2)
     4291                           ostatok-start[8 + p-num]  =ostatok-start[8 + p-num]  + round( ub.aht-stk-line.crsa-sum-rubl ,2)
     4292                           ostatok-start[9 + p-num]  =ostatok-start[9 + p-num]  + round( ub.aht-stk-line.crsa-vat-rubl ,2)
     4293                           ostatok-start[10 + p-num] =ostatok-start[10 + p-num] + round( ub.aht-stk-line.crsa-slt-rubl ,2)
     4294                           .
     4295                 else
     4296                     assign
     4297                           ostatok-start[1 + p-num]  = ostatok-start[1 + p-num] + (if ub.aht-stk-line.sum-type <> "b"
     4298                                                                      then round( ub.aht-stk-line.fact-qnty,3) else 0 )
     4299                           ostatok-start[2 + p-num]  = ostatok-start[2 + p-num] +  round( ub.aht-stk-line.cost-sum-base ,2)
     4300                           ostatok-start[3 + p-num]  = ostatok-start[3 + p-num] +  round( ub.aht-stk-line.cost-vat-base ,2)
     4301                           ostatok-start[4 + p-num]  = ostatok-start[4 + p-num] +  0
     4302                           ostatok-start[5 + p-num]  = ostatok-start[5 + p-num]  + round( ub.aht-stk-line.crsa-sum-base ,2)
     4303                           ostatok-start[6 + p-num]  = ostatok-start[6 + p-num]  + round( ub.aht-stk-line.crsa-vat-base ,2)
     4304                           ostatok-start[7 + p-num]  = ostatok-start[7 + p-num]  + round( ub.aht-stk-line.sale-discnt-base ,2)
     4305                           ostatok-start[8 + p-num]  = ostatok-start[8 + p-num]  + round( ub.aht-stk-line.crsa-sum-base ,2)
     4306                           ostatok-start[9 + p-num]  = ostatok-start[9 + p-num]  + round( ub.aht-stk-line.crsa-vat-base ,2)
     4307                           ostatok-start[10 + p-num] = ostatok-start[10 + p-num] + round( ub.aht-stk-line.crsa-slt-base ,2)
     4308                     .
     4309                end.
     4310    find last  ub.aht-stk-line where
     4311                           ub.aht-stk-line.gds-code   = gds-zap-b-code
     4312                     and   ub.aht-stk-line.fact-order <= fact-order-2
     4313                     and   ub.aht-stk-line.obj-code   = p-store-code
     4314                     and   ub.aht-stk-line.obj-type   = p-store-type
     4315                     and   ub.aht-stk-line.sum-type   = x-type-pr
     4316                           use-index category no-lock no-error.
     4317           if available ub.aht-stk-line then do:
     4318               if  tprintrubl  then
     4319                     assign
     4320                           ostatok-end[1 + p-num]  = ostatok-end[1 + p-num] + (if ub.aht-stk-line.sum-type <> "b"
     4321                                                                  then round( ub.aht-stk-line.fact-qnty,3) else 0 )
     4322                           ostatok-end[2 + p-num]  = ostatok-end[2 + p-num] + round( ub.aht-stk-line.cost-sum-rubl ,2)
     4323                           ostatok-end[3 + p-num]  = ostatok-end[3 + p-num] + round( ub.aht-stk-line.cost-vat-rubl ,2)
     4324                           ostatok-end[4 + p-num]  = ostatok-end[4 + p-num] + 0
     4325                           ostatok-end[5 + p-num]  = ostatok-end[5 + p-num] + round( ub.aht-stk-line.crsa-sum-rubl ,2)
     4326                           ostatok-end[6 + p-num]  = ostatok-end[6 + p-num] + round( ub.aht-stk-line.crsa-vat-rubl ,2)
     4327                           ostatok-end[7 + p-num]  = ostatok-end[7 + p-num] + round( ub.aht-stk-line.sale-discnt-rubl ,2)
     4328                           ostatok-end[8 + p-num]  = ostatok-end[8 + p-num] + round( ub.aht-stk-line.crsa-sum-rubl ,2)
     4329                           ostatok-end[9 + p-num]  = ostatok-end[9 + p-num] + round( ub.aht-stk-line.crsa-vat-rubl ,2)
     4330                           ostatok-end[10 + p-num] = ostatok-end[10 + p-num] + round( ub.aht-stk-line.crsa-slt-rubl ,2)
     4331                           .
     4332                 else
     4333                     assign
     4334                           ostatok-end[1 + p-num]  = ostatok-end[1 + p-num] +  (if ub.aht-stk-line.sum-type <> "b"
     4335                                                                   then round( ub.aht-stk-line.fact-qnty,3) else 0 )
     4336                           ostatok-end[2 + p-num]  = ostatok-end[2 + p-num] +  round( ub.aht-stk-line.cost-sum-base ,2)
     4337                           ostatok-end[3 + p-num]  = ostatok-end[3 + p-num] +  round( ub.aht-stk-line.cost-vat-base ,2)
     4338                           ostatok-end[4 + p-num]  = ostatok-end[4 + p-num] +  0
     4339                           ostatok-end[5 + p-num]  = ostatok-end[5 + p-num] +  round( ub.aht-stk-line.crsa-sum-base ,2)
     4340                           ostatok-end[6 + p-num]  = ostatok-end[6 + p-num] +  round( ub.aht-stk-line.crsa-vat-base ,2)
     4341                           ostatok-end[7 + p-num]  = ostatok-end[7 + p-num] +  round( ub.aht-stk-line.sale-discnt-base ,2)
     4342                           ostatok-end[8 + p-num]  = ostatok-end[8 + p-num] +  round( ub.aht-stk-line.crsa-sum-base ,2)
     4343                           ostatok-end[9 + p-num]  = ostatok-end[9 + p-num] +  round( ub.aht-stk-line.crsa-vat-base ,2)
     4344                           ostatok-end[10 + p-num] = ostatok-end[10 + p-num] + round( ub.aht-stk-line.crsa-slt-base ,2)
     4345                     .
     4346                end.
     4347   end.
     4348   end procedure.
     4349   procedure ob-line  :
     4350   do on error undo, return error return-value :
     4351   def input  parameter x-store-code     like ub.clients.obj-code         no-undo .
     4352   def input  parameter x-store-type     like ub.clients.obj-type         no-undo .
     4353   def input  parameter x-gds-code       like ub.aht-ot-line.gds-code     no-undo .
     4354   def input  parameter x-fact-order-1   like ub.aht-ot-line.fact-order   no-undo .
     4355   def input  parameter x-fact-order-2   like ub.aht-ot-line.fact-order   no-undo .
     4356   def input  parameter x-sum-type       like ub.aht-ot-line.sum-type     no-undo .
     4357   def input  parameter xtog-obj         as logical no-undo .
     4358   define variable      tt#              as integer no-undo .
     4359   define variable x-type-pr1 as character no-undo .
     4360   define variable x-type-pr2 as character no-undo .
     4361   define variable p-ok as logical   no-undo .
     4362    if x-sum-type = arh-type-cost then tt# = 0 .
     4363    if x-sum-type = arh-type-crsa then tt# = 3 .
     4364    if x-sum-type = arh-type-sale then tt# = 6 .
     4365   if  x-sum-type = "cb" then
     4366    assign
     4367       x-type-pr1 = "c"
     4368       x-type-pr2 = "b"
     4369    .
     4370   else
     4371    assign
     4372       x-type-pr1 = x-sum-type
     4373       x-type-pr2 = x-sum-type
     4374    .
     4375        for each ub.aht-ot-line where
     4376                     (      ub.aht-ot-line.gds-code     = x-gds-code
     4377                     and   ub.aht-ot-line.fact-order   <= x-fact-order-2
     4378                     and   ub.aht-ot-line.fact-order   >= x-fact-order-1
     4379                     and   ub.aht-ot-line.obj-code     = x-store-code
     4380                     and   ub.aht-ot-line.obj-type     = x-store-type
     4381                     and   ub.aht-ot-line.sum-type     = x-type-pr1)
     4382                     or
     4383                     (     ub.aht-ot-line.gds-code     = x-gds-code
     4384                     and   ub.aht-ot-line.fact-order   <= x-fact-order-2
     4385                     and   ub.aht-ot-line.fact-order   >= x-fact-order-1
     4386                     and   ub.aht-ot-line.obj-code     = x-store-code
     4387                     and   ub.aht-ot-line.obj-type     = x-store-type
     4388                     and   ub.aht-ot-line.sum-type     = x-type-pr2 )
     4389                     no-lock :
     4390       if  p-tpsy = true then do:
     4391           run ver-owner2
     4392           ( input  ub.aht-ot-line.gds-code,
     4393             input  ub.aht-ot-line.obj-type,
     4394             input  ub.aht-ot-line.obj-code,
     4395             output p-ok ) .
     4396       end.
     4397       case ub.aht-ot-line.ext-doc-type:
     4398                 when        'ie':U  or
     4399                 when        're':U  or
     4400                 when        'iv':U    or
     4401                 when        'rv':U or
     4402                 when        'im':U     then
     4403                 do:
     4404                 assign
     4405                        prih[1 ]   = prih[1 ]   + (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     4406                        prih[2 ]   = prih[2 ]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     4407                        prih[3 ]   = prih[3 ]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     4408                        prih[4 ]   = prih[4 ]
     4409                        prih[5 ]   = prih[5 ]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     4410                        prih[6 ]   = prih[6 ]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     4411                        prih[7 ]   = prih[7 ]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4412                        prih[8 ]   = prih[8 ]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     4413                        prih[9 ]   = prih[9 ]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     4414                        gds-zap-other   = gds-zap-other  +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4415                  .
     4416        if p-ok = true then do:
     4417           assign
     4418             prih[11 ]   = prih[11 ]   + (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     4419             prih[12 ]   = prih[12 ]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     4420             prih[13 ]   = prih[13 ]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     4421             prih[14 ]   = prih[14 ]
     4422             prih[15 ]   = prih[15 ]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     4423             prih[16 ]   = prih[16 ]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     4424             prih[17 ]   = prih[17 ]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4425             prih[18 ]   = prih[18 ]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     4426             prih[19 ]   = prih[19 ]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     4427             .
     4428        end.
     4429                 end.
     4430                 when       'ee':U      or
     4431                 when       'ep':U    or
     4432                 when       'ev':U     or
     4433                 when       'em':U       or
     4434                 when       'wm':U       or
     4435                 when       'we':U     then
     4436                 do:
     4437                   assign
     4438                       rash[1  ]   = rash[1 ]   +  (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     4439                       rash[2  ]   = rash[2 ]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     4440                       rash[3 ]   = rash[3 ]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     4441                       rash[4 ]   = rash[4 ]
     4442                       rash[5 ]   = rash[5 ]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     4443                       rash[6 ]   = rash[6 ]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     4444                       rash[7 ]   = rash[7 ]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4445                       rash[8 ]   = rash[8 ]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     4446                       rash[9 ]   = rash[9 ]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     4447                       gds-zap-other   = gds-zap-other  +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4448                 .
     4449                   if p-ok = true then do:
     4450                     assign
     4451                       rash[11  ]   = rash[11 ]   +  (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     4452                       rash[12  ]   = rash[12 ]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     4453                       rash[13 ]   = rash[13 ]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     4454                       rash[14 ]   = rash[14 ]
     4455                       rash[15 ]   = rash[15 ]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     4456                       rash[16 ]   = rash[16 ]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     4457                       rash[17 ]   = rash[17 ]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4458                       rash[18 ]   = rash[18 ]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     4459                       rash[19 ]   = rash[19 ]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     4460                     .
     4461                   end.
     4462                 end.
     4463                 when       'es':U  or
     4464                 when       'rs':U then
     4465                 do:
     4466                     assign
     4467                       kassa[1  ]   = kassa[1 ]   +  (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     4468                       kassa[2  ]   = kassa[2 ]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     4469                       kassa[3  ]   = kassa[3 ]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     4470                       kassa[4  ]   = kassa[4 ]
     4471                       kassa[5  ]   = kassa[5 ]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     4472                       kassa[6  ]   = kassa[6 ]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     4473                       kassa[7  ]   = kassa[7 ]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4474                       kassa[8  ]   = kassa[8 ]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     4475                       kassa[9  ]   = kassa[9 ]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     4476                       gds-zap-other   = gds-zap-other  +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4477                       .
     4478                     if p-ok = true then
     4479                     assign
     4480                       kassa[11  ]   = kassa[11 ]   +  (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     4481                       kassa[12  ]   = kassa[12 ]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     4482                       kassa[13  ]   = kassa[13 ]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     4483                       kassa[14  ]   = kassa[14 ]
     4484                       kassa[15  ]   = kassa[15 ]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     4485                       kassa[16  ]   = kassa[16 ]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     4486                       kassa[17  ]   = kassa[17 ]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4487                       kassa[18  ]   = kassa[18 ]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     4488                       kassa[19  ]   = kassa[19 ]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     4489                       .
     4490                 end.
     4491             when       'vt':U            or
     4492             when       'pc':U or
     4493             when       'vp':U       then do:
     4494                 assign
     4495                   inv[1  ]   = inv[1 ]   +  (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     4496                   inv[2  ]   = inv[2 ]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     4497                   inv[3  ]   = inv[3 ]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     4498                   inv[4  ]   = inv[4 ]
     4499                   inv[5  ]   = inv[5 ]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     4500                   inv[6  ]   = inv[6 ]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     4501                   inv[7  ]   = inv[7 ]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4502                   inv[8  ]   = inv[8 ]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     4503                   inv[9  ]   = inv[9 ]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     4504                   gds-zap-other   = gds-zap-other  +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4505                   .
     4506                 if p-ok = true then
     4507                 assign
     4508                   inv[11  ]   = inv[11 ]   +  (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     4509                   inv[12  ]   = inv[12 ]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     4510                   inv[13  ]   = inv[13 ]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     4511                   inv[14  ]   = inv[14 ]
     4512                   inv[15  ]   = inv[15 ]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     4513                   inv[16  ]   = inv[16 ]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     4514                   inv[17  ]   = inv[17 ]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4515                   inv[18  ]   = inv[18 ]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     4516                   inv[19  ]   = inv[19 ]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     4517                   .
     4518                 end.
     4519             when       'ot':U or
     4520             when       'ap':U then
     4521                 do:
     4522                    assign
     4523                       overturn[1  ]   = overturn[1 ]   +  (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     4524                       overturn[2  ]   = overturn[2 ]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     4525                       overturn[3  ]   = overturn[3 ]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     4526                       overturn[4  ]   = overturn[4 ]
     4527                       overturn[5  ]   = overturn[5 ]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     4528                       overturn[6  ]   = overturn[6 ]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     4529                       overturn[7  ]   = overturn[7 ]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4530                       overturn[8  ]   = overturn[8 ]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     4531                       overturn[9  ]   = overturn[9 ]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     4532                       gds-zap-other   = gds-zap-other  +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4533                       .
     4534                    if p-ok = true then
     4535                    assign
     4536                       overturn[11  ]   = overturn[11 ]   +  (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     4537                       overturn[12  ]   = overturn[12 ]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     4538                       overturn[13  ]   = overturn[13 ]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     4539                       overturn[14  ]   = overturn[14 ]
     4540                       overturn[15  ]   = overturn[15 ]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     4541                       overturn[16  ]   = overturn[16 ]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     4542                       overturn[17  ]   = overturn[17 ]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4543                       overturn[18  ]   = overturn[18 ]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     4544                       overturn[19  ]   = overturn[19 ]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     4545                       .
     4546                 end.
     4547         end case.
     4548     end.
     4549     assign
     4550       tt# = 6
     4551       overturn[1 + tt# ]   = (ostatok-end[1 + tt# ]  - ostatok-start[1 + tt# ] )  -  (inv[1 + tt# ] + prih[1 + tt# ] + kassa[1 + tt# ] + rash[1 + tt# ]  )
     4552       overturn[2 + tt# ]   = (ostatok-end[2 + tt# ]  - ostatok-start[2 + tt# ] )  -  (inv[2 + tt# ] + prih[2 + tt# ] + kassa[2 + tt# ] + rash[2 + tt# ]  )
     4553       overturn[3 + tt# ]   = (ostatok-end[3 + tt# ]  - ostatok-start[3 + tt# ] )  -  (inv[3 + tt# ] + prih[3 + tt# ] + kassa[3 + tt# ] + rash[3 + tt# ]  )
     4554     .
     4555     if p-ok = true then
     4556     assign
     4557       tt# = 6
     4558       overturn[1 + tt# ]   = (ostatok-end[1 + tt# ]  - ostatok-start[1 + tt# ] )  -  (inv[1 + tt# ] + prih[1 + tt# ] + kassa[1 + tt# ] + rash[1 + tt# ]  )
     4559       overturn[2 + tt# ]   = (ostatok-end[2 + tt# ]  - ostatok-start[2 + tt# ] )  -  (inv[2 + tt# ] + prih[2 + tt# ] + kassa[2 + tt# ] + rash[2 + tt# ]  )
     4560       overturn[3 + tt# ]   = (ostatok-end[3 + tt# ]  - ostatok-start[3 + tt# ] )  -  (inv[3 + tt# ] + prih[3 + tt# ] + kassa[3 + tt# ] + rash[3 + tt# ]  )
     4561     .
     4562   end.
     4563   end procedure.
     4564   procedure ver-owner :
     4565     do
     4566     on error undo, return error return-value
     4567     :
     4568   define input  parameter p-gds-code like ub.goods.gds-code no-undo .
     4569   define input  parameter p-db-num as integer   no-undo .
     4570   define output parameter p-ok as logical   no-undo .
     4571   define variable  p-proprietor-host-code like ub.clients.host-code no-undo .
     4572   define variable  p-proprietor-obj-type  like ub.clients.obj-type no-undo .
     4573   define variable  p-proprietor-obj-code  like ub.clients.obj-code no-undo .
     4574   p-ok = false .
     4575   if  p-tpsy = false  then return.
     4576     run tpsi-gds-proprietor (
     4577         input  p-gds-code             ,
     4578         input  p-db-num               ,
     4579         output p-proprietor-host-code ,
     4580         output p-proprietor-obj-type  ,
     4581         output p-proprietor-obj-code )  .
     4582    if p-proprietor-host-code = v-cntxt-host-code-obj then p-ok = true  .
     4583   end.
     4584   end procedure.
     4585   procedure ver-owner2 :
     4586     do
     4587     on error undo, return error return-value
     4588     :
     4589   define input  parameter p-gds-code like ub.goods.gds-code no-undo .
     4590   define input  parameter p-obj-type  like ub.clients.obj-type no-undo .
     4591   define input  parameter p-obj-code  like ub.clients.obj-code no-undo .
     4592   define output parameter p-ok as logical   no-undo .
     4593   define variable  p-proprietor-host-code like ub.clients.host-code no-undo .
     4594   define variable  p-proprietor-obj-type  like ub.clients.obj-type no-undo .
     4595   define variable  p-proprietor-obj-code  like ub.clients.obj-code no-undo .
     4596   p-ok = false .
     4597   if  p-tpsy = false  then return.
     4598   define buffer buf_obj-list for obj-list.
     4599   find first buf_obj-list where
     4600         buf_obj-list.obj-type = p-obj-type and
     4601         buf_obj-list.obj-code = p-obj-code
     4602         no-error .
     4603   if error-status :error then return .
     4604     run tpsi-gds-proprietor (
     4605         input  p-gds-code             ,
     4606         input  buf_obj-list.db-num     ,
     4607         output p-proprietor-host-code ,
     4608         output p-proprietor-obj-type  ,
     4609         output p-proprietor-obj-code )  .
     4610    if p-proprietor-host-code = v-cntxt-host-code-obj then p-ok = true  .
     4611   end.
     4612   end procedure.
