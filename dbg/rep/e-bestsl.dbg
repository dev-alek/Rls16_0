     1208     apply "entry" to BSAmount in frame F-Main.
     1209     return.
     1210   end.
     1211    assign sheetf.Excel-Column-Lable = ""  sheetf.Sizes = "" .
     1212       if use-column[1]   = yes then assign sheetf.Excel-Column-Lable = sheetf.Excel-Column-Lable + "Код,"                     sheetf.Sizes              = sheetf.Sizes +  "10," .
     1213       if use-column[2]   = yes then assign sheetf.Excel-Column-Lable = sheetf.Excel-Column-Lable + "Артикул,"                 sheetf.Sizes              = sheetf.Sizes +  "16," .
     1214       if use-column[3]   = yes then assign sheetf.Excel-Column-Lable = sheetf.Excel-Column-Lable + "Название товара,"         sheetf.Sizes              = sheetf.Sizes +  "40," .
     1215       if use-column[4]   = yes then assign sheetf.Excel-Column-Lable = sheetf.Excel-Column-Lable + "Ед. изм,"                 sheetf.Sizes              = sheetf.Sizes +  "6," .
     1216       if use-column[5]   = yes then assign sheetf.Excel-Column-Lable = sheetf.Excel-Column-Lable + "Количество,"              sheetf.Sizes              = sheetf.Sizes +  "15," .
     1217       if use-column[6]   = yes then assign sheetf.Excel-Column-Lable = sheetf.Excel-Column-Lable + "в т.ч. Касса,"            sheetf.Sizes              = sheetf.Sizes +  "15," .
     1218       if use-column[7]   = yes then assign sheetf.Excel-Column-Lable = sheetf.Excel-Column-Lable + "Сумма в учетных ценах,"        sheetf.Sizes              = sheetf.Sizes +  "15," .
     1219       if use-column[8]   = yes then assign sheetf.Excel-Column-Lable = sheetf.Excel-Column-Lable + "в т.ч. Касса в учетных ценах,"          sheetf.Sizes              = sheetf.Sizes +  "15," .
