     1002   PROCEDURE check-modified :
     1003   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1004   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1005   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1006   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1007     IF check-state = "check":U THEN
     1008     DO:
     1009       RUN get-link-handle IN adm-broker-hdl
     1010         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1011            OUTPUT group-target-list).
     1012       IF group-target-list NE "":U THEN
     1013       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1014         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1015         RUN check-modified IN curr-widget ('group-check':U).
     1016         IF RETURN-VALUE NE "":U THEN
     1017         DO:
     1018           RUN check-modified-message(RETURN-VALUE).
     1019           RETURN "":U.
     1020         END.
     1021       END.
     1022     END.
     1023     RETURN "":U.
     1024   END PROCEDURE.
     1025   PROCEDURE check-modified-message :
     1026     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1027        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1028           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1029        IF RETURN-VALUE = "YES":U THEN
     1030           RUN notify ('view,CONTAINER-SOURCE':U).
     1031        MESSAGE IF p-changed-table NE ? THEN
     1032           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1033           ELSE "Current values have been changed."
     1034           SKIP "  Do you wish to save those changes?"
     1035           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1036        IF ANS THEN
     1037        DO:
     1038           IF group-assign-target THEN
     1039             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1040           ELSE RUN dispatch('update-record':U).
     1041           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1042           DO:
     1043               MESSAGE "Changes to the previous record were not saved."
     1044                 VIEW-AS ALERT-BOX ERROR.
     1045               IF group-assign-target THEN
     1046                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1047               ELSE RUN dispatch ('cancel-record':U).
     1048           END.
     1049        END.
     1050        ELSE DO:
     1051          IF group-assign-target THEN
     1052             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1053          ELSE RUN dispatch('cancel-record':U).
     1054        END.
     1055        RETURN.
     1056   END PROCEDURE.
     1057   PROCEDURE get-rowid :
     1058       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1059       ASSIGN
     1060       p-table   =   adm-first-table.
     1061       RETURN.
     1062   END PROCEDURE.
     1063   PROCEDURE init-group-assign :
     1064       RUN request-attribute IN adm-broker-hdl
     1065         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1066       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1067         group-assign-target = yes.
     1068       ELSE group-assign-target = no.
     1069       RETURN.
     1070   END PROCEDURE.
     1071   PROCEDURE set-editors :
     1072       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1073       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1074       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1075       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1076       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1077       DO WHILE VALID-HANDLE (curr-widget):
     1078           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1079              curr-widget:HIDDEN = no THEN DO:
     1080             CASE p-field-setting:
     1081               WHEN "INITIALIZE":U THEN
     1082               DO:
     1083                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1084                     read-only-list +
     1085                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1086                        STRING(curr-widget).
     1087               END.
     1088               WHEN "DISABLE":U OR
     1089               WHEN "ENABLE":U THEN
     1090               DO:
     1091                   curr-widget:SENSITIVE = yes.
     1092                   RUN get-attribute ('Read-Only-Editors':U).
     1093                   IF RETURN-VALUE = ? OR
     1094                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1095                       curr-widget:READ-ONLY =
     1096                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1097               END.
     1098               WHEN "CLEAR":U THEN
     1099                   curr-widget:SCREEN-VALUE = "":U.
     1100             END CASE.
     1101           END.
     1102           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1103       END.
     1104       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1105         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1106           + '"':U).
     1107       RETURN.
     1108   END PROCEDURE.
     1109   PROCEDURE use-check-modified-all :
     1110    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1111     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1112     RETURN.
     1113   END PROCEDURE.
     1114   PROCEDURE use-create-on-add :
     1115   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1116      RETURN.
     1117   END PROCEDURE.
     1118   PROCEDURE use-initial-lock :
     1119     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1120     ASSIGN adm-initial-lock = p-attr-value.
     1121     RETURN.
     1122   END PROCEDURE.
     1123     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1124   ON VALUE-CHANGED OF Scale IN FRAME F-Main
     1125   DO:
     1126       assign Scale .
     1127       Sc-node = 0.
     1128       Sc-Upper = 0 .
     1129       if Scale = "Choice-scala":U then
     1130       do:
     1131                run ref/gdsprts.w (my-handle, yes, output scale_recid).
     1132                if scale_recid = ? then
     1133                do:
     1134                     Scale:screen-value = 'все':U .
     1135                     Sc_Name:screen-value IN FRAME F-Main = 'все':U .
     1136                     Sc-node = 0.
     1137                     Sc-Upper = 0.
     1138                end.
     1139                else
     1140                do:
     1141                     find first gds-prt where recid (gds-prt) = scale_recid.
     1142                     Sc_Name:screen-value IN FRAME F-Main = gds-prt.node-name.
     1143                     Sc-node = gds-prt.node-code.
     1144                     Sc-Upper = gds-prt.upper-code.
     1145                end.
     1146       end.
     1147       else
     1148                Sc_Name:screen-value IN FRAME F-Main = 'все':U .
     1149    aSSIGN Sc_Name.
     1150   END.
     1151   ON VALUE-CHANGED OF Tog-Scale IN FRAME F-Main
     1152   DO:
     1153   Assign Tog-scale.
     1154   IF Tog-scale = TRUE then DO:
     1155      Enable Scale with frame F-Main .
     1156     End.
     1157     Else DO:
     1158      Disable Scale   with frame F-Main .
     1159      Display Scale  with frame F-Main .
     1160     End.
     1161   END.
     1162   PROCEDURE disable_UI :
     1163     HIDE FRAME F-Main.
     1164     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1165   END PROCEDURE.
     1166   PROCEDURE local-initialize :
     1167   def var Ret# as logical no-undo .
     1168     RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     1169     ASSIGN
     1170      BSAmount:screen-value IN FRAME F-Main = "10"
     1171      COMBO-crit:screen-value IN FRAME F-Main = "Макс. количество по кассе"
     1172      COMBO-Sort:screen-value IN FRAME F-Main = "Макс. количество по кассе"
     1173      FILL-IN-1:screen-value IN FRAME F-Main  = "Шкалы:"
     1174      Scale:screen-value IN FRAME F-Main      = 'все':U
     1175      Sc_Name:screen-value IN FRAME F-Main    = 'все':U
     1176     .
     1177   define variable vss-include-info13 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1178   do:
     1179     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1180       (input  v-cntxt-db-num
     1181       ,input  v-cntxt-userid
     1182       ,input  0
     1183       ,input  'actn_reports_lookup-cost':U
     1184       ,input  'object':U
     1185       ,input  v-cntxt-host-code-obj
     1186       ,input  v-cntxt-obj-type
     1187       ,input  v-cntxt-obj-code
     1188       ,input  0
     1189       ,input  0
     1190       ,input  0
     1191       ,input  false
     1192       ,output g#log
     1193       )  .
     1194   end.
     1195      if not g#log then do:
     1196         Ret# = COMBO-crit:Disable ("Макс. сумма продаж в учетных ценах") .
     1197         Ret# = COMBO-crit:Disable ("Макс. эффективность") .
     1198         Ret# = COMBO-sort:Disable ("Макс. сумма продаж в учетных ценах") .
     1199         Ret# = COMBO-sort:Disable ("Макс. эффективность") .
     1200      end.
     1201      ENABLE BSAmount COMBO-crit COMBO-Sort FILL-IN-1 Scale  with frame F-Main .
     1202      DISPLAY BSAmount COMBO-crit COMBO-Sort FILL-IN-1 Scale  with frame F-Main .
     1203   END PROCEDURE.
