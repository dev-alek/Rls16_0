      562   define new global shared variable g#library  as handle no-undo .
      563   define new global shared variable g#library2 as handle no-undo .
      564   define variable var-report-r-b as character no-undo .
      565   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      566   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      567     (output var-report-r-b
      568     )  .
      569   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      570   procedure proc-alt-shift-f2:
      571     if not ibs.th.gbl.gbl-var:rcode
      572   then
      573     run gbl\inidebug.p .
      574   end.
      575   procedure proc-alt-shift-f3:
      576     run gbl/prvssinf.p
      577       ( input this-procedure
      578       ) .
      579   end.
      580   define variable v-inform-launched as logical no-undo initial false .
      581   procedure proc-alt-shift-f4:
      582     define variable v-action as character no-undo .
      583     if v-inform-launched = false then do:
      584       assign
      585         v-inform-launched = true
      586       .
      587       run gbl/d-inform.w
      588         (  input self
      589         ,  input this-procedure
      590         , output v-action
      591         ) no-error .
      592       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      593       assign
      594         v-inform-launched = false
      595       .
      596     end.
      597   end.
      598   procedure proc-alt-f1:
      599     run gbl/corrhelp.p
      600       (input this-procedure
      601       ) .
      602   end .
      603   on alt-shift-f2 anywhere do:
      604     run proc-alt-shift-f2.
      605   end.
      606   on alt-shift-f3 anywhere do:
      607     run proc-alt-shift-f3 in this-procedure .
      608   end.
      609   on alt-shift-f4 anywhere do:
      610     run proc-alt-shift-f4 in this-procedure.
      611   end.
      612   on alt-f1 anywhere do:
      613     run proc-alt-f1 in this-procedure .
      614   end.
      615   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      616     define variable v-cntxt-db-num        as integer   no-undo .
      617     define variable v-cntxt-userid        as character no-undo .
      618     define variable v-cntxt-level         as character no-undo .
      619     define variable v-cntxt-host-code-obj as integer   no-undo .
      620     define variable v-cntxt-obj-type      as character no-undo .
      621     define variable v-cntxt-obj-code      as integer   no-undo .
      622     define variable v-cntxt-db-num-obj    as integer   no-undo .
      623     define variable v-cntxt-is-admin      as logical   no-undo .
      624   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      625     run mainmenu_getcntxt in my-handle
      626       (output v-cntxt-db-num
      627       ,output v-cntxt-userid
      628       ,output v-cntxt-level
      629       ,output v-cntxt-host-code-obj
      630       ,output v-cntxt-obj-type
      631       ,output v-cntxt-obj-code
      632       ,output v-cntxt-db-num-obj
      633       ,output v-cntxt-is-admin
      634       ) .
      635   define variable base-type as character no-undo .
      636   define variable base-code as integer   no-undo .
      637   define variable g#report-num as integer   no-undo .
      638   define variable g#gds-engl as logical   no-undo .
      639   define variable vv-exch-rate  as decimal   no-undo .
      640   define variable vv-exch-scale as decimal   no-undo .
      641   define variable v-cntxt-host-name-obj as character no-undo .
      642   if v-cntxt-level = 'object':U then do:
      643   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      644   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostname in g#library
      645     (input  v-cntxt-obj-type
      646     ,input  v-cntxt-obj-code
      647     ,output v-cntxt-host-code-obj
      648     ,output v-cntxt-host-name-obj
      649     )  .
      650   end.
      651   if v-cntxt-level = 'firm':U then do:
      652     find first ub.clients no-lock where
      653                ub.clients.obj-type = 'орг':U and
      654                ub.clients.obj-code = v-cntxt-host-code-obj no-error .
      655   if error-status :error then v-cntxt-host-name-obj = ? .
      656      else v-cntxt-host-name-obj = ub.clients.obj-name.
      657   end.
      658   if v-cntxt-level = 'object':U
      659   or v-cntxt-level = 'firm':U
      660   then do:
      661   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      662   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
      663     (input  v-cntxt-host-code-obj
      664     ,output base-code
      665     )  .
      666   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      667   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
      668     (input  base-code
      669     ,input  today
      670     ,output vv-exch-rate
      671     ,output vv-exch-scale
      672     ,output base-type
      673     )  .
      674   end.
      675   run get-report-num in my-handle ( output g#report-num ).
      676   run get-gds-engl in my-handle ( output g#gds-engl ) .
      677   CREATE WIDGET-POOL.
      678   def var State-source as  WIDGET-HANDLE.
      679   define variable g#log as logical   no-undo .
      680   def var     scale_recid       as  recid    no-undo.
      681   DEF var Sort as int no-undo.
      682   DEF var Crit as int no-undo.
      683   DEF var Sc-node like gds-prt.node-code no-undo.
      684   DEF var Sc-upper like gds-prt.upper-code no-undo.
      685   DEFINE VARIABLE Sc_Name AS CHARACTER
      686        VIEW-AS EDITOR NO-WORD-WRAP SCROLLBAR-HORIZONTAL
      687        SIZE 49 BY 1.83
      688        BGCOLOR 8 FONT 4 NO-UNDO.
      689   DEFINE VARIABLE BSAmount AS INTEGER FORMAT ">>>>9":U INITIAL 10
      690        LABEL "Сколько показать товаров"
      691        VIEW-AS FILL-IN
      692        SIZE 6.88 BY 1 NO-UNDO.
      693   DEFINE VARIABLE FILL-IN-1 AS CHARACTER FORMAT "X(256)":U INITIAL "Шкалы:"
      694         VIEW-AS TEXT
      695        SIZE 7.63 BY .67
      696        FGCOLOR 4  NO-UNDO.
      697   DEFINE VARIABLE COMBO-crit AS CHARACTER
      698        VIEW-AS RADIO-SET VERTICAL
      699        RADIO-BUTTONS
      700    "Макс. количество", "Макс. количество",
      701    "Макс. сумма продаж в учетных ценах", "Макс. сумма продаж в учетных ценах",
      702    "Макс. сумма продаж в ценах док-та", "Макс. сумма продаж в ценах док-та",
      703    "Макс. эффективность", "Макс. эффективность",
      704    "Макс. количество по кассе", "Макс. количество по кассе",
      705    "Макс. сумма по кассе в ценах док-та", "Макс. сумма по кассе в ценах док-та"
      706        SIZE 47.13 BY 5.17 NO-UNDO.
      707   DEFINE VARIABLE COMBO-Sort AS CHARACTER
      708        VIEW-AS RADIO-SET VERTICAL
      709        RADIO-BUTTONS
      710    "Макс. количество", "Макс. количество",
      711    "Макс. сумма продаж в учетных ценах", "Макс. сумма продаж в учетных ценах",
      712    "Макс. сумма продаж в ценах док-та", "Макс. сумма продаж в ценах док-та",
      713    "Макс. эффективность", "Макс. эффективность",
      714    "Макс. количество по кассе", "Макс. количество по кассе",
      715    "Макс. сумма по кассе в ценах док-та", "Макс. сумма по кассе в ценах док-та"
      716        SIZE 47.75 BY 5.13 NO-UNDO.
      717   DEFINE VARIABLE Scale AS CHARACTER
      718        VIEW-AS RADIO-SET VERTICAL
      719        RADIO-BUTTONS
      720             "все", 'все':U ,
      721   "Выбор шкалы", "Choice-scala":U
      722        SIZE 14.88 BY 1.58 NO-UNDO.
      723   DEFINE RECTANGLE RECT-10
      724        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      725        SIZE 67.63 BY 3.75.
      726   DEFINE RECTANGLE RECT-11
      727        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      728        SIZE 67.63 BY 12.
      729   DEFINE RECTANGLE RECT-12
      730        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      731        SIZE 67.63 BY 16.75.
      732   DEFINE VARIABLE Tog-Scale AS LOGICAL INITIAL no
      733        LABEL "По признакам"
      734        VIEW-AS TOGGLE-BOX
      735        SIZE 16 BY .83 NO-UNDO.
      736   DEFINE FRAME F-Main
      737        COMBO-crit AT ROW 1.79 COL 3 NO-LABEL
      738        COMBO-Sort AT ROW 7.79 COL 2.88 NO-LABEL
      739        Tog-Scale AT ROW 13.83 COL 2.5
      740        Sc_Name AT ROW 14.5 COL 19.88 NO-LABEL
      741        Scale AT ROW 14.83 COL 3 NO-LABEL
      742        BSAmount AT ROW 16.79 COL 26.63 COLON-ALIGNED
      743        FILL-IN-1 AT ROW 13.04 COL 4.38 COLON-ALIGNED NO-LABEL
      744        RECT-11 AT ROW 1 COL 1.38
      745        RECT-12 AT ROW 1.04 COL 1.38
      746        "Критерий отбора" VIEW-AS TEXT
      747             SIZE 29.13 BY .67 AT ROW 1.13 COL 3.25
      748             FGCOLOR 4
      749        "Сортировка" VIEW-AS TEXT
      750             SIZE 12.5 BY .67 AT ROW 7.08 COL 2.75
      751             FGCOLOR 4
      752        RECT-10 AT ROW 12.92 COL 1.38
      753       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      754            SIDE-LABELS NO-UNDERLINE THREE-D
      755            AT COL 1 ROW 1 SCROLLABLE .
      756   IF NOT THIS-PROCEDURE:PERSISTENT THEN DO:
      757     MESSAGE "should only be RUN PERSISTENT."
      758             VIEW-AS ALERT-BOX ERROR BUTTONS OK.
      759     RETURN.
      760   END.
      761   ASSIGN
      762          FRAME F-Main:SCROLLABLE       = FALSE
      763          FRAME F-Main:HIDDEN           = TRUE
      764          FRAME F-Main:PRIVATE-DATA     =
      765                   "DLGCLOSE".
      766   ASSIGN
      767          FILL-IN-1:HIDDEN IN FRAME F-Main           = false .
      768   ASSIGN
      769          Scale:HIDDEN IN FRAME F-Main           = false .
      770   ASSIGN
      771          Sc_Name:READ-ONLY IN FRAME F-Main        = false .
      772   ASSIGN
      773          Tog-Scale:HIDDEN IN FRAME F-Main            = false  .
      774   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      775   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      776   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      777   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      778   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      779   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      780   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      781   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      782         adm-object-hdl = FRAME F-Main:HANDLE.
      783   RUN ensure-broker.
      784   THIS-PROCEDURE:ADM-DATA =
      785        'ADM1.1~`':U +
      786        'SmartViewer~`':U +
      787        '~`':U +
      788        'NO ~`':U +
      789        '~`':U +
      790        '~`':U +
      791        '~`':U +
      792        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      793           + "~`":U +
      794        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
      795        'Record-Source,Record-Target,TableIO-Target~`':U +
      796        '~`':U +
      797        '~`~`~`~`~`~`~`~`~`~`~`':U +
      798        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      799            THEN "^^":U
      800        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      801             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      802   PROCEDURE adm-apply-entry :
      803     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      804   END PROCEDURE.
      805   PROCEDURE adm-destroy :
      806    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      807   END PROCEDURE.
      808   PROCEDURE adm-disable :
      809       DISABLE RECT-11 RECT-12 COMBO-crit COMBO-Sort RECT-10 Tog-Scale Sc_Name BSAmount FILL-IN-1 WITH FRAME F-Main.
      810       RUN dispatch ('disable-fields':U).
      811       RUN set-attribute-list ('ENABLED=no':U).
      812       RETURN.
      813   END PROCEDURE.
      814   PROCEDURE adm-edit-attribute-list :
      815         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
      816         RETURN.
      817   END PROCEDURE.
      818   PROCEDURE adm-enable :
      819       ENABLE UNLESS-HIDDEN RECT-11 RECT-12 COMBO-crit COMBO-Sort RECT-10 Tog-Scale Sc_Name BSAmount FILL-IN-1 WITH FRAME F-Main.
      820       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      821       RUN set-attribute-list ('ENABLED=yes':U).
      822       RETURN.
      823   END PROCEDURE.
      824   PROCEDURE adm-exit :
      825        RUN notify ('exit':U).
      826     RETURN.
      827   END PROCEDURE.
      828   PROCEDURE adm-hide :
      829     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      830   END PROCEDURE.
      831   PROCEDURE adm-initialize :
      832     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      833   END PROCEDURE.
      834   PROCEDURE adm-show-errors :
      835       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      836       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      837           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      838       END.
      839       RETURN.
      840   END PROCEDURE.
      841   PROCEDURE adm-UIB-mode :
      842     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      843   END PROCEDURE.
      844   PROCEDURE adm-view :
      845     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      846   END PROCEDURE.
      847   PROCEDURE dispatch :
      848       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      849       RUN broker-dispatch IN adm-broker-hdl
      850           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      851       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      852   END PROCEDURE.
      853   PROCEDURE ensure-broker :
      854   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      855   IF RETURN-VALUE NE "ADM-Broker":U THEN
      856   DO:
      857       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      858       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      859   END.
      860   END PROCEDURE.
      861   PROCEDURE get-attribute :
      862     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      863     RUN broker-get-attribute IN adm-broker-hdl
      864         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      865     RETURN RETURN-VALUE.
      866   END PROCEDURE.
      867   PROCEDURE get-attribute-list :
      868     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      869     RUN broker-get-attribute-list IN adm-broker-hdl
      870         (INPUT THIS-PROCEDURE,
      871          INPUT ?,
      872          OUTPUT p-attr-list) NO-ERROR.
      873     RETURN.
      874   END PROCEDURE.
      875   PROCEDURE new-state :
      876     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      877     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      878     RETURN.
      879   END PROCEDURE.
      880   PROCEDURE notify :
      881     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      882     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      883     IF RETURN-VALUE = "ADM-ERROR":U THEN
      884         RETURN "ADM-ERROR":U.
      885     RETURN.
      886   END PROCEDURE.
      887   PROCEDURE set-attribute-list :
      888     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      889     RUN ensure-broker.
      890     RUN broker-set-attribute-list IN adm-broker-hdl
      891         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      892     RETURN.
      893   END PROCEDURE.
      894   PROCEDURE set-position :
      895       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      896       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      897       IF VALID-HANDLE(adm-object-hdl) THEN
      898       DO:
      899         ASSIGN adm-object-hdl:ROW    =   p-row
      900                adm-object-hdl:COLUMN =   p-col.
      901       END.
      902       RETURN.
      903   END PROCEDURE.
      904   PROCEDURE adm-display-fields :
      905       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
      906       RETURN.
      907   END PROCEDURE.
      908   PROCEDURE adm-open-query :
      909     RETURN.
      910   END PROCEDURE.
      911   PROCEDURE adm-row-changed :
      912         IF VALID-HANDLE(adm-object-hdl) THEN
      913           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      914         RUN notify ('row-available':U).
      915         RETURN.
      916   END PROCEDURE.
      917   PROCEDURE reposition-query :
      918       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
      919       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
      920       RETURN.
      921   END PROCEDURE.
      922     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
      923     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
      924     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
      925     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
      926     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
      927     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
      928     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
      929     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
      930     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      931     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
      932     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      933     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
      934     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
      935     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
      936     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
      937     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
      938     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
