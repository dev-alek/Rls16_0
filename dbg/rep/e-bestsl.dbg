     1253   PROCEDURE my-var :
     1254   assign frame F-Main
     1255           BSAmount COMBO-crit COMBO-Sort FILL-IN-1
     1256           Sc_Name Scale Tog-Scale  .
     1257   v-show-all-goods  = false  .
     1258   Assign
     1259    STR-obj-type = ''
     1260    STR-obj-code = ''
     1261    STR-obj-name = ''
     1262    STR-obj      = ''.
     1263   For each obj-list no-lock:
     1264    Assign
     1265    STR-obj-type = STR-obj-type + obj-list.obj-type + ','
     1266    STR-obj-code = STR-obj-code + String(obj-list.obj-code) + ','
     1267    STR-obj-name = STR-obj-name + obj-list.obj-name + ','
     1268    STR-obj = STR-obj +  obj-list.obj-type + '#' + string(obj-list.obj-code)  + ',' .
     1269   End.
     1270    sheetf.Excel-Column-Lable =
     1271                 "Код        "
     1272         + "," + "Артикул         "
     1273         + "," + "Название товара "
     1274         + "," + "Ед.изм "
     1275         + "," + "Количество "
     1276         + "," + "в т.ч. Касса "
     1277         + "," + "Сумма в учетных ценах"
     1278         + "," + "в т.ч. Касса в учетных ценах"
     1279         + "," + "Сумма в ценах док-та"
     1280         + "," + "в т.ч. Касса в ценах док-та"
     1281         + "," + "Эффективность "
     1282         + "," + " % (по критерию отбора)"
     1283         + "," + "Количество (с учетом внеш.расходов)"
     1284         + "," + "Сумма продажи в уч.ценах (с учетом внеш.расходов)"
     1285         + "," + "Сумма продажи в ценах документа (с учетом внеш.расходов)"
     1286         + "," + "Доля в доходах"
     1287         + "," + "Остаток на начало"
     1288         + "," + "Остаток на конец"
     1289         + "," +  "Средняя учетная цена"
     1290         + "," + "Средняя цена продажи"
     1291         + "," + "Наценка в руб."
     1292         + "," + "Наценка в %"
     1293         + "," + "Оборачиваемость в днях"
     1294         + "," + "Срок реализации остатка".
     1295       sheetf.Sizes =  "10,16,40,6,15,15,15,15,15,15,16,12,16,16,16,16,16,16,16,16,16,16,16,16".
     1296       sheetf.ColFormat = "2=@;3=@;" .
     1297       Sheetf.make-correct = "false,false,false,false,true,true,treu,true,true,true,true,true,true,true,true,true,true,true,true,true,true,true,true,true" .
     1298   ReportNAme = "Б Е С Т С Е Л Л Е Р Ы ".
     1299               Case COMBO-crit:
     1300                   when "Макс. количество"                   then   crit = 1.
     1301                   when "Макс. сумма продаж в учетных ценах"                   then   crit = 2.
     1302                   when "Макс. сумма продаж в ценах док-та"                   then   crit = 3.
     1303                   when "Макс. эффективность"                   then   crit = 4.
     1304                   when "Макс. количество по кассе"                   then   crit = 5.
     1305                   when "Макс. сумма по кассе в ценах док-та"                   then   crit = 6.
     1306               End case.
     1307               Case COMBO-Sort:
     1308                   when "Макс. количество"                   then   Sort = 1.
     1309                   when "Макс. сумма продаж в учетных ценах"                   then   Sort = 2.
     1310                   when "Макс. сумма продаж в ценах док-та"                   then   Sort = 3.
     1311                   when "Макс. эффективность"                   then   Sort = 4.
     1312                   when "Макс. количество по кассе"                   then   Sort = 5.
     1313                   when "Макс. сумма по кассе в ценах док-та"                   then   Sort = 6.
     1314               End case.
     1315   ReportHeader = " Критерий отбора : " + COMBO-crit + chr(10) +
     1316                  " Сортировка по " + COMBO-Sort + chr(10) +
     1317                  " Показано " + StrinG(BSAmount) + " товаров"   .
     1318   If  Tog-Scale Then
     1319   ReportHeader = ReportHeader + chr(10) + " Шкалы : "  + Sc_Name .
     1320   END PROCEDURE.
     1321   PROCEDURE state-changed :
     1322     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     1323     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     1324     CASE p-state:
     1325     END CASE.
     1326   END PROCEDURE.
