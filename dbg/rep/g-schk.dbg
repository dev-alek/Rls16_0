       89   procedure create_obj-list :
       90      define input parameter p-obj-type like ub.clients.obj-type no-undo .
       91      define input parameter p-obj-code like ub.clients.obj-code no-undo .
       92      do
       93      on error undo, return error return-value
       94      :
       95         define buffer cli-obj for ub.clients .
       96         define variable p-var as integer no-undo .
       97         define buffer buf_obj-list for obj-list .
       98         find last buf_obj-list  use-index pi no-error .
       99         if available buf_obj-list
      100         then
      101            p-var = buf_obj-list.obj-id + 1.
      102         else
      103            p-var = 1.
      104         find first cli-obj where
      105                   cli-obj.obj-type = p-obj-type
      106               and cli-obj.obj-code = p-obj-code
      107         no-lock no-error.
      108         if available cli-obj
      109         then do:
      110            create buf_obj-list.
      111            assign
      112               buf_obj-list.obj-id   = p-var
      113               buf_obj-list.obj-code = cli-obj.obj-code
      114               buf_obj-list.obj-type = cli-obj.obj-type
      115               buf_obj-list.obj-name = cli-obj.obj-name
      116               buf_obj-list.db-num   = cli-obj.db-num
      117            .
      118         end.
      119      end.
      120   end.
