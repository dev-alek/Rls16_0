      523   end procedure.
      524   define variable var-report-r-b as character no-undo .
      525   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      526   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      527     (output var-report-r-b
      528     )  .
      529   procedure vss-get-info :
      530     define output parameter p-vss-revision    like vss-revision    no-undo .
      531     define output parameter p-vss-author      like vss-author      no-undo .
      532     define output parameter p-vss-date        like vss-date        no-undo .
      533     define output parameter p-vss-workfile    like vss-workfile    no-undo .
      534     define output parameter p-vss-archive     like vss-archive     no-undo .
      535     define output parameter p-vss-description like vss-description no-undo .
      536     assign
      537       p-vss-revision    = vss-revision
      538       p-vss-author      = vss-author
      539       p-vss-date        = vss-date
      540       p-vss-workfile    = vss-workfile
      541       p-vss-archive     = vss-archive
      542       p-vss-description = vss-description
      543     .
      544   end procedure.
      545   procedure vss-get-parameters :
      546     define output parameter p-vss-parameters as character no-undo .
      547   end procedure.
      548   define new global shared variable g#vssrevis-logger as handle    no-undo .
      549   define variable v-vssrevis-logevent                 as logical   no-undo init false .
      550   define variable v-vssrevis-logger                   as handle    no-undo .
      551   procedure vss-logevent :
      552     define input  parameter p-extra-paramters as character no-undo .
      553     define variable v-vssrevis-parameters as character no-undo .
      554     do
      555     on error undo, return error return-value
      556     :
      557       if  valid-handle(v-vssrevis-logger)
      558       and v-vssrevis-logger :get-signature("logevent") <> ""
      559       then do:
      560         run vss-get-parameters in this-procedure
      561           (output v-vssrevis-parameters
      562           ).
      563         run logevent in v-vssrevis-logger
      564           (input vss-workfile
      565           ,input vss-revision
      566           ,input v-vssrevis-parameters
      567           ,input p-extra-paramters
      568           ).
      569       end.
      570     end.
      571   end procedure.
      572   assign
      573     v-vssrevis-logger = g#vssrevis-logger
      574   .
      575   if  valid-handle(v-vssrevis-logger)
      576   and v-vssrevis-logger :get-signature("logevent") <> ""
      577   then do:
      578     assign
      579       v-vssrevis-logevent = true
      580     .
      581     run vss-logevent in this-procedure (input vss-description) .
      582   end.
      583   define new global shared variable g#lib-trn  as handle no-undo .
      584   define new global shared variable g#lib-trn2 as handle no-undo .
      585   define new global shared variable g#lib-trn3 as handle no-undo .
      586   define new global shared variable g#lib-trn4 as handle no-undo .
      587   define buffer buf_goods   for ub.goods.
      588   define variable is-petrol as logical no-undo .
      589   define variable is-pieces as logical no-undo .
      590   define temp-table tt-goods no-undo like ub.goods.
      591   custom-par = "all,2,8,3,1" + chr(44) + "TOG-Shift-2 = yes" + chr(44) + custom-par.
      592   run rep/d-report.w (
      593                   input parparentproc ,
      594                   input 'rep/r-schk.p',
      595                   " Отчет по всем сухим чекам продажи и возврата с топливом ",
      596                   input 4,
      597                   "4",
      598                   input "*",
      599                   input "",
      600                   input "",
      601                   input custom-par,
      602                   input yes).
