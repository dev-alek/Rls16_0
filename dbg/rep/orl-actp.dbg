      828             v-cntxp-out-pay         = bf-cntxp_shop.out-pay
      829             v-cntxp-ret-pay         = bf-cntxp_shop.ret-pay
      830             v-cntxp-ret-sup-pay     = bf-cntxp_shop.ret-sup-pay
      831             v-cntxp-down-pay        = bf-cntxp_shop.down-pay
