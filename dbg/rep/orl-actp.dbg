     1010   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     1011     (
     1012        input buf_doc-line.artic
     1013     ,  input buf_doc-line.prod-type
     1014     ,  input buf_doc-line.prod-code
     1015     , output v-is-petrol
     1016     , output v-is-pieces
     1017     ) no-error.
     1018       if v-is-petrol <> yes then do: next. end.
     1019       assign v-have-petrol = yes.
     1020     assign v-autoent-obj-code = "":U
     1021            v-autoent-obj-type = "":U
     1022            v-car-num          = "":U
     1023            v-car-vol          = "":U
     1024            v-item-pour        = "":U
     1025            v-tank-density     = "":U
     1026            v-tank-temp        = "":U
