      738     define variable v-cntxp-ret-pay         like ub.store.ret-pay         no-undo.
      739     define variable v-cntxp-ret-sup-pay     like ub.store.ret-sup-pay     no-undo.
      740     define variable v-cntxp-down-pay        like ub.store.down-pay        no-undo.
      741     define variable v-cntxp-inv-pay         like ub.store.inv-pay         no-undo.
      742     define variable v-cntxp-chk-pay         like ub.store.chk-pay         no-undo.
      743     define variable v-cntxp-retail          like ub.sysconf.ord-prt       no-undo.
      744     define variable v-cntxp-osn-base        like ub.sysconf.osn-base      no-undo.
      745     define variable v-cntxp-conf-par        as   character                no-undo.
      746     define variable v-cntxp-par-type        as   character                no-undo.
      747     define variable v-cntxp-curr-host-code  like ub.store.host-code       no-undo.
      748     define variable v-cntxp-obj-type        like ub.clients.obj-type      no-undo.
      749     define variable v-cntxp-obj-code        like ub.clients.obj-code      no-undo.
      750     define variable v-cntxp-db-num          as integer   no-undo .
      751     define variable v-cntxp-userid          as character no-undo .
      752     define variable v-cntxp-level           as character no-undo .
      753     define variable v-cntxp-db-num-obj      as integer   no-undo .
      754     define variable v-cntxp-is-admin        as logical   no-undo .
      755     define buffer bf-cntxp_store for ub.store.
      756     define buffer bf-cntxp_shop  for ub.shop.
      757     define buffer bf-cntxp_sysconf for ub.sysconf.
      758   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      759     run mainmenu_getcntxt in parparentproc
      760       (output v-cntxp-db-num
      761       ,output v-cntxp-userid
      762       ,output v-cntxp-level
      763       ,output v-cntxp-curr-host-code
      764       ,output v-cntxp-obj-type
      765       ,output v-cntxp-obj-code
      766       ,output v-cntxp-db-num-obj
      767       ,output v-cntxp-is-admin
      768       ) .
      769     if (v-cntxp-obj-type = 'маг':U or v-cntxp-obj-type = 'скл':U) and
      770        v-cntxp-obj-code <> 0 then do:
      771   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      772     (input  'is-prt'
      773     ,input  0
      774     ,input  ''
      775     ,input  0
      776     ,input  ''
      777     ,input  ''
      778     ,input  ''
      779     ,input  yes
      780     ,output v-cntxp-conf-par
      781     ,output v-cntxp-par-type
      782     ) no-error .
      783       case v-cntxp-obj-type :
      784         when 'скл':U then do:
      785           find first bf-cntxp_store where bf-cntxp_store.obj-code = v-cntxp-obj-code no-lock.
      786           find first bf-cntxp_sysconf where bf-cntxp_sysconf.host-code = bf-cntxp_store.host-code no-lock.
      787           assign
      788             v-cntxp-doc-prt         = (v-cntxp-conf-par = "yes") and bf-cntxp_store.doc-prt
      789             v-cntxp-price-calc      = bf-cntxp_store.price-calc
      790             v-cntxp-inout-price     = bf-cntxp_store.inout-price
      791             v-cntxp-unit-cli-perm   = bf-cntxp_store.unit-cli-perm
      792             v-cntxp-out-rate        = bf-cntxp_store.out-rate
      793             v-cntxp-out-line-discnt = bf-cntxp_store.out-line-discnt
      794             v-cntxp-in-ov           = bf-cntxp_store.in-ov
      795             v-cntxp-in-perm         = bf-cntxp_store.in-perm
      796             v-cntxp-no-eq           = bf-cntxp_store.no-eq
      797             v-cntxp-rsrv-time       = bf-cntxp_store.rsrv-time
      798             v-cntxp-load-time       = bf-cntxp_store.load-time
      799             v-cntxp-holidays        = bf-cntxp_store.holidays
      800             v-cntxp-in-pay          = bf-cntxp_store.in-pay
      801             v-cntxp-out-pay         = bf-cntxp_store.out-pay
      802             v-cntxp-ret-pay         = bf-cntxp_store.ret-pay
      803             v-cntxp-ret-sup-pay     = bf-cntxp_store.ret-sup-pay
      804             v-cntxp-down-pay        = bf-cntxp_store.down-pay
