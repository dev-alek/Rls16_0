     1096       find first buf_clients_ship no-lock where
     1097                  buf_clients_ship.obj-type =          v-autoent-obj-type   and
     1098                  buf_clients_ship.obj-code = integer( v-autoent-obj-code ) no-error.
     1099       assign v-ship-org = ( if available buf_clients then buf_clients.obj-name else "":U ).
     1100       run r-c-sale in this-procedure (  input buf_doc-line.doc-code
     1101                                      ,  input buf_doc-line.artic
     1102                                      ,  input buf_doc-line.prod-type
     1103                                      ,  input buf_doc-line.prod-code
     1104                                      , output v-fact-qnty
     1105                                      , output v-VAT-pc
     1106                                      , output v-SLT-pc
     1107                                      , output v-sum-price            ).
     1108       assign v-price        = ( if v-fact-qnty = 0 then 0 else v-sum-price / v-fact-qnty    )
     1109              v-fact-qnty-kg =
     1110       invlnsum_cli-qnty (
     1111                      buf_doc-line.doc-code
     1112                    , buf_doc-line.artic
     1113                    , buf_doc-line.prod-type
     1114                    , buf_doc-line.prod-code
     1115                    )
     1116              v-price-kg     = ( if v-fact-qnty = 0 then 0 else v-sum-price / v-fact-qnty-kg ).
     1117       put stream out-stream unformatted
     1118           skip( 1 ) "А К Т"                     at center-field( 14, 130, 5 ) format "x(5)":U skip
     1119           "приемки-передачи нефтепродуктов " + caps( trim( buf_host_clients.obj-name ) )
     1120                                                 at center-field( 14, 130, 32 + length( trim( buf_host_clients.obj-name ) ) )
     1121           skip "предпринимателю " + v-expl-name at center-field( 14, 130, 16 + length( v-expl-name ) ).
     1122       if buf_trn-doc.fact-date <> ? then do:
     1123         assign temp-string = '" '  + string( day(   buf_trn-doc.fact-date ) )
     1124                            + ' " ' + entry(  month( buf_trn-doc.fact-date ), 'января,февраля,марта,апреля,мая,июня,июля,августа,сентября,октября,ноября,декабря':U )
     1125                            + " "   + string( year(  buf_trn-doc.fact-date ), "9999" ) + " г.".
     1126         assign temp-position = center-field( 14, 130, length( temp-string ) )
     1127                temp-string   = fill( " ":U, temp-position ) + temp-string.
     1128       end.
     1129       else do:
     1130         assign temp-string = "":U.
     1131       end.
     1132       put stream out-stream
     1133           skip
     1134           temp-string                             format "x(130)":U
     1135           skip( 2 ) space( 14 )
     1136           "ТТН N " string( buf_trn-doc.doc-code ) + " от " + string( buf_trn-doc.doc-date )
     1137                                                   format "x(76)":U at 54
     1138           skip      space( 14 )
     1139           "Основание: накладная поставщика" string( "N " + v-nids + " от " + v-dids )
     1140                                                   format "x(76)":U at 54
     1141           skip      space( 14 )
     1142           "Гос.N автоцистерны "         v-car-num format "x(76)":U at 54
     1143           skip      space( 14 )
     1144           "Объем по паспорту в литрах " v-car-vol format "x(76)":U at 54
     1145           skip      space( 14 )
     1146           "Поставщик " buf_trn-doc.cli-name       format "x(76)":U at 54
     1147           skip      space( 14 )
     1148           ( if not ( buf_trn-doc.PS begins "@" ) then buf_trn-doc.PS else "":U )
     1149                                                   format "x(76)":U
     1150           skip      space( 14 )
     1151           "Нефтепродукт " buf_goods.gds-name      format "x(76)":U at 54.
     1152       put stream out-stream
     1153         skip( 2 ) single-line       format "x(119)":U at 15
     1154         skip      ":"               format "x(1)":U            at 15
     1155                   ":"               format "x(1)":U            at 15 + 25
     1156                   "Нефтепродукт"    format "x(12)":U           at center-field( 15 + 25, 15 + 84, 12 )
     1157                   ":"               format "x(1)":U            at 15 + 84
     1158                   ":"               format "x(1)":U            at 15 + 99
     1159                   ":"               format "x(1)":U            at 15 + 118
     1160         skip      ":"               format "x(1)":U            at 15
     1161                   ":"               format "x(1)":U            at 15 + 25
     1162                   single-line       format "x(58)":U
     1163                   ":"               format "x(1)":U            at 15 + 84
     1164                   "Цена"                                       at center-field( 15 + 84, 15 + 99, 4 )
     1165                   ":"               format "x(1)":U            at 15 + 99
     1166                   "Сумма"                                      at center-field( 15 + 99, 15 + 118, 5 )
     1167                   ":"               format "x(1)":U            at 15 + 118
     1168         skip      ":"               format "x(1)":U            at 15
     1169                   ":"               format "x(1)":U            at 15 + 25
     1170                   "Объем,"          format "x(6)":U            at center-field( 15 + 25, 15 + 41,  6 )
     1171                   ":"               format "x(1)":U            at 15 + 41
     1172                   "t,"              format "x(2)":U            at center-field( 15 + 41, 15 + 52,  2 )
     1173                   ":"               format "x(1)":U            at 15 + 52
     1174                   "Плотность,"      format "x(10)":U           at center-field( 15 + 52, 15 + 68, 10 )
     1175                   ":"               format "x(1)":U            at 15 + 68
     1176                   "Масса,"          format "x(6)":U            at center-field( 15 + 68, 15 + 84,  6 )
     1177                   ":"               format "x(1)":U            at 15 + 84
     1178                   "по объекту"      format "x(10)":U           at center-field( 15 + 84, 15 + 99, 10 )
     1179                   ":"               format "x(1)":U            at 15 + 99
     1180                   "по объекту"      format "x(10)":U           at center-field( 15 + 99, 15 + 118, 10 )
     1181                   ":"               format "x(1)":U            at 15 + 118
     1182         skip      ":"               format "x(1)":U            at 15
     1183                   ":"               format "x(1)":U            at 15 + 25
     1184                   "л"               format "x(1)":U            at center-field( 15 + 25, 15 + 41, 1 )
     1185                   ":"               format "x(1)":U            at 15 + 41
     1186                   "град.C"          format "x(6)":U            at center-field( 15 + 41, 15 + 52, 6 )
     1187                   ":"               format "x(1)":U            at 15 + 52
     1188                   "г/см.куб"        format "x(8)":U            at center-field( 15 + 52, 15 + 68, 8 )
     1189                   ":"               format "x(1)":U            at 15 + 68
     1190                   "кг"              format "x(2)":U            at center-field( 15 + 68, 15 + 84, 2 )
     1191                   ":"               format "x(1)":U            at 15 + 84
     1192                   "за л"            format "x(4)":U            at center-field( 15 + 84, 15 + 99, 4 )
     1193                   ":"               format "x(1)":U            at 15 + 99
     1194                   "(руб)":U format "x(5)":U            at center-field( 15 + 99, 15 + 118, 5 )
     1195                   ":"               format "x(1)":U            at 15 + 118
     1196         skip      ":"               format "x(1)":U            at 15
     1197                   single-line       format "x(117)":U
     1198                   ":"               format "x(1)":U.
     1199       put stream out-stream
     1200         skip ":"                                       format "x(1)":U             at 15
     1201              "По ТТН"                                  format "x(6)":U             at 15 + 2
     1202              ":"                                       format "x(1)":U             at 15 + 25
     1203           buf_doc-line.doc-qnty                        format "zz,zz9.999":U       at right-field( 15 + 41 - 1, 10 )
     1204              ":"                                       format "x(1)":U             at 15 + 41
     1205           buf_doc-line.temperature                     format "->>9.99":U          at right-field( 15 + 52 - 1,  7 )
     1206              ":"                                       format "x(1)":U             at 15 + 52
     1207           buf_doc-line.doc-density                     format "9.9999999999":U     at right-field( 15 + 68 - 1, 12 )
     1208              ":"                                       format "x(1)":U             at 15 + 68
     1209           buf_doc-line.cli-qnty                        format "zz,zzz,zz9.999":U   at right-field( 15 + 84, 14 )
     1210              ":"                                       format "x(1)":U             at 15 + 84
     1211              v-price                                   format "z,zzz,zz9.99":U     at right-field( 15 + 99, 12 )
     1212              ":"                                       format "x(1)":U             at 15 + 99
     1213              v-sum-price                               format "z,zzz,zzz,zz9.99":U at right-field( 15 + 118, 16 )
     1214              ":"                                       format "x(1)":U             at 15 + 118
     1215         skip ":"                                       format "x(1)":U             at 15
     1216              single-line                               format "x(117)":U
     1217              ":"                                       format "x(1)":U
     1218         skip ":"                                       format "x(1)":U             at 15
     1219              single-line                               format "x(117)":U
     1220              ":"                                       format "x(1)":U
     1221         skip ":"                                       format "x(1)":U             at 15
     1222              "По замеру в"                             format "x(11)":U            at 15 + 2
     1223              ":"                                       format "x(1)":U             at 15 + 25
     1224              ":"                                       format "x(1)":U             at 15 + 41
     1225              ":"                                       format "x(1)":U             at 15 + 52
     1226              ":"                                       format "x(1)":U             at 15 + 68
     1227              ":"                                       format "x(1)":U             at 15 + 84
     1228              ":"                                       format "x(1)":U             at 15 + 99
     1229              ":"                                       format "x(1)":U             at 15 + 118
     1230         skip ":"                                       format "x(1)":U             at 15
     1231              "автоцистерне"                            format "x(12)":U            at 15 + 2
     1232              ":"                                       format "x(1)":U             at 15 + 25.
     1233       if v-tank-vol-dec     <> ? then do:
     1234         put stream out-stream v-tank-vol-dec     format "zz,zz9.999":U     at right-field( 15 + 41 - 1, 10 ).
     1235       end.
     1236       put stream out-stream ":" format "x(1)":U at 15 + 41.
     1237       if v-tank-temp-dec    <> ? then do:
     1238         put stream out-stream v-tank-temp-dec    format "->>9.99":U        at right-field( 15 + 52 - 1,  7 ).
     1239       end.
     1240       put stream out-stream ":" format "x(1)":U at 15 + 52.
     1241       if v-tank-density-dec <> ? then do:
     1242         put stream out-stream v-tank-density-dec format "9.9999999999":U   at right-field( 15 + 68 - 1, 12 ).
     1243       end.
     1244       put stream out-stream ":" format "x(1)":U at 15 + 68.
     1245       if v-tank-weight-dec  <> ? then do:
     1246         put stream out-stream v-tank-weight-dec  format "zz,zzz,zz9.999":U at right-field( 15 + 84, 14 ).
     1247       end.
     1248       put stream out-stream
     1249              ":"                      format "x(1)":U       at 15 + 84
     1250              ":"                      format "x(1)":U       at 15 + 99
     1251              ":"                      format "x(1)":U       at 15 + 118
     1252         skip ":"                      format "x(1)":U       at 15
     1253              single-line              format "x(117)":U
     1254              ":"                      format "x(1)":U.
     1255     find first buf_rvs-doc_before no-lock where
     1256                buf_rvs-doc_before.out-code = buf_trn-doc.doc-code and
     1257                buf_rvs-doc_before.rvs-type = 'перед_док':U       no-error.
     1258     assign v-have-rvs-before = ( available buf_rvs-doc_before ).
     1259     if available buf_rvs-doc_before then do:
     1260       for each buf_rvs-line_before no-lock where
     1261                buf_rvs-line_before.rvs-code = buf_rvs-doc_before.rvs-code and
     1262                buf_rvs-line_before.obj-type = buf_trn-doc.obj-type     and
     1263                buf_rvs-line_before.obj-code = buf_trn-doc.obj-code     and
     1264                buf_rvs-line_before.gds-code = buf_goods.gds-code       :
     1265         assign
     1266           before_qnty        = before_qnty        + buf_rvs-line_before.state-measure-qnty
     1267           before_temperature = before_temperature + buf_rvs-line_before.state-temperature
     1268                                             * buf_rvs-line_before.state-measure-qnty
     1269           before_cli-qnty    = before_cli-qnty    + buf_rvs-line_before.state-measure-cli-qnty
     1270         .
     1271       put stream out-stream
     1272         skip ":"                      format "x(1)":U       at 15
     1273              single-line              format "x(117)":U
     1274              ":"                      format "x(1)":U
     1275         skip ":"                      format "x(1)":U       at 15
     1276              "По замеру в резервуаре" format "x(22)":U      at 15 + 2
     1277              ":"                      format "x(1)":U       at 15 + 25
     1278              ":"                      format "x(1)":U       at 15 + 41
     1279              ":"                      format "x(1)":U       at 15 + 52
     1280              ":"                      format "x(1)":U       at 15 + 68
     1281              ":"                      format "x(1)":U       at 15 + 84
     1282              ":"                      format "x(1)":U       at 15 + 99
     1283              ":"                      format "x(1)":U       at 15 + 118
     1284         skip ":"                      format "x(1)":U       at 15
     1285              "ДО слива"               format "x(8)":U       at 15 + 2
     1286              ":"                      format "x(1)":U       at 15 + 25.
     1287     if v-have-rvs-before = yes then do:
     1288         if buf_rvs-line_before.state-measure-qnty <> ? then do:
     1289       put stream out-stream buf_rvs-line_before.state-measure-qnty format "zz,zz9.999":U at right-field( 15 + 41 - 1, 10 ).
     1290         end.
     1291     end.
     1292     else do:
     1293       put stream out-stream "0" format "x(1)":U at right-field( 15 + 41 - 1, 1 ).
     1294     end.
     1295     put stream out-stream ":" format "x(1)":U at 15 + 41.
     1296     if v-have-rvs-before = yes then do:
     1297         if buf_rvs-line_before.state-temperature <> ? then do:
     1298       put stream out-stream buf_rvs-line_before.state-temperature format "->>9.99":U at right-field( 15 + 52 - 1, 7 ).
     1299         end.
     1300     end.
     1301     else do:
     1302       put stream out-stream "0" format "x(1)":U at right-field( 15 + 52 - 1, 1 ).
     1303     end.
     1304     put stream out-stream ":" format "x(1)":U at 15 + 52.
     1305     if v-have-rvs-before = yes then do:
     1306         if buf_rvs-line_before.state-density <> ? then do:
     1307       put stream out-stream buf_rvs-line_before.state-density format "9.9999999999":U at right-field( 15 + 68 - 1, 12 ).
     1308         end.
     1309     end.
     1310     else do:
     1311       put stream out-stream "0" format "x(1)":U at right-field( 15 + 68 - 1, 1 ).
     1312     end.
     1313     put stream out-stream ":" format "x(1)":U at 15 + 68.
     1314     if v-have-rvs-before = yes then do:
     1315         if buf_rvs-line_before.state-measure-cli-qnty <> ? then do:
     1316       put stream out-stream buf_rvs-line_before.state-measure-cli-qnty format "zz,zzz,zz9.999":U at right-field( 15 + 84 - 0, 14 ).
     1317         end.
     1318     end.
     1319     else do:
     1320       put stream out-stream "0" format "x(1)":U at right-field( 15 + 84 - 0, 1 ).
     1321     end.
     1322     put stream out-stream ":" format "x(1)":U at 15 + 84.
     1323       put stream out-stream
     1324              ":"                   format "x(1)":U       at 15 + 99
     1325              ":"                   format "x(1)":U       at 15 + 118
     1326         skip ":"                   format "x(1)":U       at 15
     1327              single-line           format "x(117)":U
     1328              ":"                   format "x(1)":U.
     1329       end.
     1330     end.
     1331     assign
     1332       before_temperature = before_temperature / before_qnty
     1333       before_density     = before_cli-qnty    / before_qnty
     1334     .
     1335     find first buf_rvs-doc_after no-lock where
     1336                buf_rvs-doc_after.out-code = buf_trn-doc.doc-code and
     1337                buf_rvs-doc_after.rvs-type = 'после_док':U       no-error.
     1338     assign v-have-rvs-after = ( available buf_rvs-doc_after ).
     1339     if available buf_rvs-doc_after then do:
     1340       for each buf_rvs-line_after no-lock where
     1341                buf_rvs-line_after.rvs-code = buf_rvs-doc_after.rvs-code and
     1342                buf_rvs-line_after.obj-type = buf_trn-doc.obj-type     and
     1343                buf_rvs-line_after.obj-code = buf_trn-doc.obj-code     and
     1344                buf_rvs-line_after.gds-code = buf_goods.gds-code       :
     1345         assign
     1346           after_qnty        = after_qnty        + buf_rvs-line_after.state-measure-qnty
     1347           after_temperature = after_temperature + buf_rvs-line_after.state-temperature
     1348                                             * buf_rvs-line_after.state-measure-qnty
     1349           after_cli-qnty    = after_cli-qnty    + buf_rvs-line_after.state-measure-cli-qnty
     1350         .
     1351       put stream out-stream
     1352         skip ":"                   format "x(1)":U       at 15
     1353           "По замеру в резервуаре" format "x(22)":U      at 15 + 2
     1354              ":"                   format "x(1)":U       at 15 + 25
     1355              ":"                   format "x(1)":U       at 15 + 41
     1356              ":"                   format "x(1)":U       at 15 + 52
     1357              ":"                   format "x(1)":U       at 15 + 68
     1358              ":"                   format "x(1)":U       at 15 + 84
     1359              ":"                   format "x(1)":U       at 15 + 99
     1360              ":"                   format "x(1)":U       at 15 + 118
     1361         skip ":"                   format "x(1)":U       at 15
     1362              "ПОСЛЕ слива"         format "x(11)":U      at 15 + 2
     1363              ":"                   format "x(1)":U       at 15 + 25.
     1364     if v-have-rvs-after = yes then do:
     1365         if buf_rvs-line_after.state-measure-qnty <> ? then do:
     1366       put stream out-stream buf_rvs-line_after.state-measure-qnty format "zz,zz9.999":U at right-field( 15 + 41 - 1, 10 ).
     1367         end.
     1368     end.
     1369     else do:
     1370       put stream out-stream "0" format "x(1)":U at right-field( 15 + 41 - 1, 1 ).
     1371     end.
     1372     put stream out-stream ":" format "x(1)":U at 15 + 41.
     1373     if v-have-rvs-after = yes then do:
     1374         if buf_rvs-line_after.state-temperature <> ? then do:
     1375       put stream out-stream buf_rvs-line_after.state-temperature format "->>9.99":U at right-field( 15 + 52 - 1, 7 ).
     1376         end.
     1377     end.
     1378     else do:
     1379       put stream out-stream "0" format "x(1)":U at right-field( 15 + 52 - 1, 1 ).
     1380     end.
     1381     put stream out-stream ":" format "x(1)":U at 15 + 52.
     1382     if v-have-rvs-after = yes then do:
     1383         if buf_rvs-line_after.state-density <> ? then do:
     1384       put stream out-stream buf_rvs-line_after.state-density format "9.9999999999":U at right-field( 15 + 68 - 1, 12 ).
     1385         end.
     1386     end.
     1387     else do:
     1388       put stream out-stream "0" format "x(1)":U at right-field( 15 + 68 - 1, 1 ).
     1389     end.
     1390     put stream out-stream ":" format "x(1)":U at 15 + 68.
     1391     if v-have-rvs-after = yes then do:
     1392         if buf_rvs-line_after.state-measure-cli-qnty <> ? then do:
     1393       put stream out-stream buf_rvs-line_after.state-measure-cli-qnty format "zz,zzz,zz9.999":U at right-field( 15 + 84 - 0, 14 ).
     1394         end.
     1395     end.
     1396     else do:
     1397       put stream out-stream "0" format "x(1)":U at right-field( 15 + 84 - 0, 1 ).
     1398     end.
     1399     put stream out-stream ":" format "x(1)":U at 15 + 84.
     1400       put stream out-stream
     1401              ":"         format "x(1)":U            at 15 + 99
     1402              ":"         format "x(1)":U            at 15 + 118
     1403         skip single-line format "x(119)":U at 15.
     1404       end.
     1405     end.
     1406     assign
     1407       after_temperature = after_temperature / after_qnty
     1408       after_density     = after_cli-qnty    / after_qnty
     1409     .
     1410       put stream out-stream
     1411         skip( 2 ) space( 14 ) "Объем принятого нефтепродукта "
     1412         buf_doc-line.fact-qnty format "zzz,zzz,zz9.999":U at right-field( 90, 15 ) " литров"
     1413         skip      space( 14 ) "Масса принятого нефтепродукта "
     1414         ( if available bf_inv-line then bf_inv-line.wast-cli-qnty else ? )
     1415                                format "zzz,zzz,zz9.999":U at right-field( 90, 15 ) " кг".
     1416       assign v-sum-string = Total-Word( v-sum-price, Roubles( v-sum-price ), Copecks( v-sum-price ) )
     1417              temp-string  = " руб.".
     1418       put stream out-stream
     1419         skip( 1 ) space( 14 ) "ИТОГО по акту передано на сумму     " +
     1420         caps( ( if trim( v-sum-string ) begins trim( temp-string ) then string( "0 " + v-sum-string ) else v-sum-string ) )
     1421                                                           format "x(126)":U.
     1422       put stream out-stream
     1423         skip( 1 ) space( 14 ) "От владельца : "
     1424                                           "От агента : "    at 80
     1425         v-store-man                     format "x(20)":U
     1426         skip( 1 ) space( 14 ) "Руководитель предприятия:                                             / "
     1427         string( v-main-boss  + " /" )   format "x(40)":U
     1428         skip( 1 ) space( 14 ) "Главный бухгалтер:                                                    / "
     1429         string( v-main-buh  + " /" )    format "x(40)":U.
     1430       page stream out-stream.
     1431     end.
     1432     output stream out-stream close.
     1433     if v-have-petrol = yes then do:
     1434   if g#quest-print = false
     1435   then do:
     1436     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
     1437                                         7, (if 4 >= 8 then 2 else 0), 0, 0,
     1438                                         OUTPUT g#log ).
     1439   end.
     1440   else do:
     1441     os-command silent
     1442       value( "COPY /b " +
     1443         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
     1444         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
     1445         string( session:temp-directory) +  "$" + string( g#report-num )
     1446                 ) .
     1447     os-command silent
     1448       value( "COPY /b " +
     1449         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
     1450         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
     1451         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
     1452                 ) .
     1453   end.
     1454     end.
     1455   end.
