     1034       find first buf_goods no-lock where
     1035                  buf_goods.artic     = buf_doc-line.artic     and
     1036                  buf_goods.prod-type = buf_doc-line.prod-type and
     1037                  buf_goods.prod-code = buf_doc-line.prod-code.
     1038       for each buf_doc-line-attr no-lock where
     1039                buf_doc-line-attr.doc-code = buf_trn-doc.doc-code and
     1040                buf_doc-line-attr.gds-code = buf_goods.gds-code   :
     1041         case buf_doc-line-attr.attr-code :
     1042     when "car-vol" then do: assign v-car-vol = trim( buf_doc-line-attr.attr-value ). end.
     1043     when "tank-density" then do: assign v-tank-density = trim( buf_doc-line-attr.attr-value ). end.
     1044     when "tank-temp" then do: assign v-tank-temp = trim( buf_doc-line-attr.attr-value ). end.
     1045     when "tank-vol" then do: assign v-tank-vol = trim( buf_doc-line-attr.attr-value ). end.
     1046     when "tank-water" then do: assign v-tank-water = trim( buf_doc-line-attr.attr-value ). end.
     1047     when "tank-weight" then do: assign v-tank-weight = trim( buf_doc-line-attr.attr-value ). end.
     1048     when "time-pour" then do: assign v-time-pour = trim( buf_doc-line-attr.attr-value ). end.
     1049     when "type-inp-vat" then do: assign v-type-inp-vat = trim( buf_doc-line-attr.attr-value ). end.
     1050         end case.
     1051       end.
     1052       for each buf_doc-attr no-lock where
     1053                buf_doc-attr.doc-code = buf_trn-doc.doc-code:
     1054         case buf_doc-attr.attr-code :
     1055               when 'autoent':U then do:
     1056                 assign
     1057                   v-autoent-obj-type = entry (1, buf_doc-attr.attr-value, ";")
     1058                   v-autoent-obj-code = entry (2, buf_doc-attr.attr-value, ";")
     1059                 no-error.
     1060               end.
     1061               when 'car-num':U then do: assign v-car-num = trim( buf_doc-attr.attr-value ). end.
     1062               when 'time-income':U then do: assign v-time-income = trim( buf_doc-attr.attr-value ). end.
     1063               when 'ptb-item-pour':U then do: assign v-item-pour = trim( buf_doc-attr.attr-value ). end.
     1064         end case.
     1065       end.
     1066     assign v-tank-vol-dec = decimal( v-tank-vol ) no-error.
     1067     if error-status :error then do:
     1068       message vss-workfile skip( 0 ) vss-date skip( 0 ) vss-revision skip( 1 ) vss-description skip( 1 )
     1069               'Ошибка преобразования параметра "tank-vol" в число.'
     1070       view-as alert-box error.
