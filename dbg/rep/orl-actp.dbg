     1001                                        "rpt" + string( g#report-num ) ) )
     1002                                        page-size  value(62) .
     1003     for each buf_doc-line no-lock where
     1004              buf_doc-line.doc-code = buf_trn-doc.doc-code :
     1005       find first bf_inv-line no-lock where
