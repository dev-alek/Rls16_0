      833             v-cntxp-chk-pay         = bf-cntxp_shop.chk-pay
      834             v-cntxp-retail          = bf-cntxp_sysconf.ord-prt
      835             v-cntxp-osn-base        = bf-cntxp_sysconf.osn-base
      836             .
      837         end.
      838       end case.
      839     end.
