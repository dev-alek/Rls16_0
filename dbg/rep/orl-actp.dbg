      732     define variable v-cntxp-no-eq           like ub.store.no-eq           no-undo.
      733     define variable v-cntxp-rsrv-time       like ub.store.rsrv-time       no-undo.
      734     define variable v-cntxp-load-time       like ub.store.load-time       no-undo.
      735     define variable v-cntxp-holidays        like ub.store.holidays        no-undo.
