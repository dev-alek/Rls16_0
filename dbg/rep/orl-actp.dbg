      448       define variable varinvatp-typeo             as   character              no-undo.
      449   define input parameter p-doc-code           like doc-line.doc-code          no-undo .
      450   define input parameter p-artic              like doc-line.artic             no-undo .
      451   define input parameter p-prod-type          like doc-line.prod-type         no-undo .
      452   define input parameter p-prod-code          like doc-line.prod-code         no-undo .
      453   define output parameter p-fact-qnty         like ub.ot-line.fact-qnty       no-undo .
      454   define output parameter p-vat-pc            like ub.doc-line.vat-pc         no-undo .
      455   define output parameter p-slt-pc            like ub.doc-line.slt-pc         no-undo .
      456   define output parameter p-sum-r-b           like ub.ot-line.sum-base        no-undo .
      457   def var v-gds-dtl-fact-qnty                 as decimal                      no-undo .
      458   define buffer buf_gds-dtl  for ub.gds-dtl.
      459   define buffer buf_goods    for ub.goods.
      460   define buffer buf_trn-doc  for ub.trn-doc.
      461   define buffer buf_doc-line for ub.doc-line.
      462   find first buf_doc-line no-lock
      463        where buf_doc-line.doc-code  = p-doc-code
      464          and buf_doc-line.artic     = p-artic
      465          and buf_doc-line.prod-type = p-prod-type
      466          and buf_doc-line.prod-code = p-prod-code
      467   no-error .
      468   if not available buf_doc-line then do:
      469       message "r-c-sale: Ошибка передачи параметров строки документа"
      470       view-as alert-box.
      471       undo, return error .
      472   end.
      473   find first buf_trn-doc no-lock
      474           where buf_trn-doc.doc-code = buf_doc-line.doc-code
      475   no-error .
      476   if not available buf_trn-doc then do:
      477       message "r-c-sale: Нет trn-doc для строки документа " string(buf_doc-line.doc-code)
      478       view-as alert-box.
      479       undo, return error .
      480   end.
      481   for each buf_gds-dtl no-lock
      482      where buf_gds-dtl.doc-code  = buf_doc-line.doc-code
      483        and buf_gds-dtl.artic     = buf_doc-line.artic
      484        and buf_gds-dtl.prod-type = buf_doc-line.prod-type
      485        and buf_gds-dtl.prod-code = buf_doc-line.prod-code
      486   on error undo, return error
      487   :
      488       if buf_trn-doc.doc-type <> 'инв':U
      489       then do:
      490           if buf_trn-doc.doc-type = 'при':U
      491           or buf_trn-doc.doc-type = 'возврат':U
      492           then do:
      493               assign
      494                   v-gds-dtl-fact-qnty = buf_gds-dtl.fact-qnty
      495               .
      496           end.
      497           else do:
      498               assign
      499                   v-gds-dtl-fact-qnty = - buf_gds-dtl.fact-qnty
      500               .
      501           end.
      502       end.
      503       else do:
      504           assign
      505               v-gds-dtl-fact-qnty = buf_gds-dtl.doc-qnty
      506           .
      507       end.
      508       if v-gds-dtl-fact-qnty <> 0
      509       then do:
      510           ASSIGN
      511               p-fact-qnty           = p-fact-qnty     + v-gds-dtl-fact-qnty
      512               p-sum-r-b             = p-sum-r-b       + buf_gds-dtl.cur-base  * v-gds-dtl-fact-qnty
      513           .
      514       end.
      515   end.
      516   assign
      517       p-vat-pc              = buf_doc-line.vat-pc
      518       p-slt-pc              = buf_doc-line.slt-pc
      519   .
      520   end.
      521   end procedure.
      522   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      523   define new global shared variable g#trdcalib as handle no-undo.
      524   define new global shared variable g#lib-trn  as handle no-undo .
      525   define new global shared variable g#lib-trn2 as handle no-undo .
      526   define new global shared variable g#lib-trn3 as handle no-undo .
      527   define new global shared variable g#lib-trn4 as handle no-undo .
      528       if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end.
      529         function invlnsum_cli-qnty returns decimal ( input p-doc-code  as character,
      530                                                          input p-artic     as character,
      531                                                          input p-prod-type as character,
      532                                                          input p-prod-code as integer     ) :
      533           define variable d_out-qnty-kg as decimal no-undo initial ?.
      534                   if valid-handle( g#lib-trn3 ) = yes then do on error undo, return error :
      535             run lib-trn3_invlnqty in g#lib-trn3 (
      536                                                    input p-doc-code
      537                                                 ,  input p-artic
      538                                                 ,  input p-prod-type
      539                                                 ,  input p-prod-code
      540                                                 ,  input no
      541                                                 , output d_out-qnty-kg
      542           ) .
      543             return ( if error-status :error then ? else d_out-qnty-kg ).
      544           end.
      545         end function.
      546   FUNCTION RedLine RETURNS CHARACTER ( INPUT i-str AS CHARACTER ) :
      547     DEFINE VARIABLE v-str AS CHARACTER NO-UNDO.
      548     RUN get-red-line IN THIS-PROCEDURE ( INPUT i-str, OUTPUT v-str ) NO-ERROR.
      549     RETURN ( IF ERROR-STATUS :ERROR THEN i-str ELSE v-str ).
      550   END FUNCTION.
      551   PROCEDURE get-red-line :
      552     DEFINE  INPUT PARAMETER p-str AS CHARACTER NO-UNDO.
      553     DEFINE OUTPUT PARAMETER p-res AS CHARACTER NO-UNDO.
      554     DO ON ERROR UNDO, RETURN ERROR :
      555       ASSIGN p-res = CAPS( SUBSTRING( p-str, 1, 1 ) ) + LC( SUBSTRING( p-str, 2 ) ).
      556     END.
      557   END PROCEDURE.
      558   FUNCTION Roubles RETURNS CHARACTER ( INPUT i-sum AS DECIMAL ) :
      559     DEFINE VARIABLE Rouble AS CHARACTER NO-UNDO.
      560     RUN get-roubles IN THIS-PROCEDURE ( INPUT i-sum, OUTPUT Rouble ) NO-ERROR.
      561     RETURN ( IF ERROR-STATUS :ERROR THEN "":U ELSE Rouble ).
      562   END FUNCTION.
      563   PROCEDURE get-roubles :
      564     DEFINE  INPUT PARAMETER p-sum AS DECIMAL   NO-UNDO.
      565     DEFINE OUTPUT PARAMETER p-rub AS CHARACTER NO-UNDO.
      566     DEFINE VARIABLE Word   AS CHARACTER NO-UNDO.
      567     DEFINE VARIABLE jj     AS INTEGER   NO-UNDO.
      568     DEFINE VARIABLE j_last AS INTEGER   NO-UNDO.
      569     DEFINE VARIABLE l_prev AS LOGICAL   NO-UNDO.
      570     DO ON ERROR UNDO, RETURN ERROR :
      571       ASSIGN Word   = STRING( ABS( p-sum ), "999999999999999999999999999999.99":U )
      572              jj     = LENGTH( Word )
      573              j_last = INTEGER( SUBSTRING( Word, jj - 3, 1 ) )
      574              l_prev =        ( SUBSTRING( Word, jj - 4, 1 ) = "1" ).
      575       IF      j_last = 1                THEN DO: ASSIGN p-rub = ( IF l_prev = YES THEN "рублей" ELSE "рубль" ).  END.
      576       ELSE IF j_last > 1 AND j_last < 5 THEN DO: ASSIGN p-rub = ( IF l_prev = YES THEN "рублей" ELSE "рубля" ). END.
      577                                         ELSE DO: ASSIGN p-rub = "рублей". END.
      578     END.
      579   END PROCEDURE.
      580   FUNCTION Copecks RETURNS CHARACTER ( INPUT i-sum AS DECIMAL ) :
      581     DEFINE VARIABLE Copeck AS CHARACTER NO-UNDO.
      582     RUN get-copecks IN THIS-PROCEDURE ( INPUT i-sum, OUTPUT Copeck ) NO-ERROR.
      583     RETURN ( IF ERROR-STATUS :ERROR THEN "":U ELSE Copeck ).
      584   END FUNCTION.
      585   PROCEDURE get-copecks :
      586     DEFINE  INPUT PARAMETER p-sum AS DECIMAL   NO-UNDO.
      587     DEFINE OUTPUT PARAMETER p-kop AS CHARACTER NO-UNDO.
      588     DEFINE VARIABLE Word   AS CHARACTER NO-UNDO.
      589     DEFINE VARIABLE jj     AS INTEGER   NO-UNDO.
      590     DEFINE VARIABLE j_last AS INTEGER   NO-UNDO.
      591     DEFINE VARIABLE l_prev AS LOGICAL   NO-UNDO.
      592     DO ON ERROR UNDO, RETURN ERROR :
      593       ASSIGN  Word   = STRING( ABS( p-sum ), "999999999999999999999999999999.99":U )
      594               jj     = LENGTH( Word )
      595               j_last = INTEGER( SUBSTRING( Word, jj,     1 ) )
      596               l_prev =        ( SUBSTRING( Word, jj - 1, 1 ) = "1" ).
      597       IF           j_last = 1                THEN DO:
      598         ASSIGN p-kop = ( IF l_prev = YES THEN "копеек" ELSE "копейка" ).
      599       END. ELSE IF j_last > 1 AND j_last < 5 THEN DO:
      600         ASSIGN p-kop = ( IF l_prev = YES THEN "копеек" ELSE "копейки" ).
      601       END.                                   ELSE DO:
      602         ASSIGN p-kop = "копеек".
      603       END.
      604     END.
      605   END PROCEDURE.
      606   FUNCTION get-decade-word RETURNS CHARACTER ( INPUT i-dec AS INTEGER, INPUT i-num AS INTEGER ) :
      607     DEFINE VARIABLE v-grade AS CHARACTER NO-UNDO.
      608     RUN get-number-grade IN THIS-PROCEDURE ( INPUT i-dec, INPUT i-num, OUTPUT v-grade ) NO-ERROR.
      609     RETURN ( IF ERROR-STATUS :ERROR THEN "":U ELSE v-grade ).
      610   END FUNCTION.
      611   FUNCTION Word-Sum RETURNS CHARACTER ( INPUT i-sum AS DECIMAL ) :
      612     DEFINE VARIABLE OutSum AS CHARACTER NO-UNDO.
      613     RUN conv-sum-to-word IN THIS-PROCEDURE ( INPUT i-sum, OUTPUT OutSum ) NO-ERROR.
      614     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE OutSum ).
      615   END FUNCTION.
      616   PROCEDURE get-number-grade :
      617     DEFINE  INPUT PARAMETER p-dec AS INTEGER   NO-UNDO.
      618     DEFINE  INPUT PARAMETER p-num AS INTEGER   NO-UNDO.
      619     DEFINE OUTPUT PARAMETER p-res AS CHARACTER NO-UNDO.
      620     DEFINE VARIABLE v-list AS CHARACTER NO-UNDO.
      621     DO ON ERROR UNDO, RETURN ERROR :
      622       IF      p-dec = 1 THEN DO: ASSIGN v-list = ",один,два,три,четыре,пять,шесть,семь,восемь,девять".    END.
      623       ELSE IF p-dec = 2 THEN DO: ASSIGN v-list = "десять,одиннадцать,двенадцать,тринадцать,четырнадцать,пятнадцать,шестнадцать,семнадцать,восемнадцать,девятнадцать".    END.
      624       ELSE IF p-dec = 3 THEN DO: ASSIGN v-list = ",,двадцать,тридцать,сорок,пятьдесят,шестьдесят,семьдесят,восемьдесят,девяносто".   END.
      625       ELSE IF p-dec = 4 THEN DO: ASSIGN v-list = ",сто,двести,триста,четыреста,пятьсот,шестьсот,семьсот,восемьсот,девятьсот".  END.
      626                         ELSE DO: ASSIGN v-list = ",,,,,,,,,". END.
      627       ASSIGN p-res = ENTRY( p-num + 1, v-list ).
      628     END.
      629   END PROCEDURE.
      630   PROCEDURE conv-sum-to-word :
      631     DEFINE  INPUT PARAMETER p-sum AS DECIMAL   NO-UNDO.
      632     DEFINE OUTPUT PARAMETER p-res AS CHARACTER NO-UNDO.
      633     DEFINE VARIABLE Formatted  AS CHARACTER NO-UNDO.
      634     DEFINE VARIABLE Word       AS CHARACTER NO-UNDO.
      635     DEFINE VARIABLE OutSum     AS CHARACTER NO-UNDO.
      636     DEFINE VARIABLE jj         AS INTEGER   NO-UNDO.
      637     DO ON ERROR UNDO, RETURN ERROR :
      638       ASSIGN Formatted = STRING( ABS( p-sum ), "999999999999999.99":U ) NO-ERROR.
      639       IF ERROR-STATUS :ERROR THEN DO:
      640         ASSIGN p-res = ?.
      641         UNDO, RETURN ERROR.
      642       END.
      643       DO jj = ( LENGTH( Formatted ) - 3 ) TO 3 BY -3 :
      644         IF SUBSTRING( Formatted, jj - 2, 3 ) = "000" THEN DO: NEXT. END.
      645         IF jj < 15 THEN DO:
      646           ASSIGN Word = ENTRY( jj, ",,триллион,,,миллиард,,,миллион,,,тысяч" ).
      647           IF SUBSTRING( Formatted, jj,     1 )  = "1" AND
      648              SUBSTRING( Formatted, jj - 1, 1 ) <> "1" AND jj = 12 THEN DO: ASSIGN Word = TRIM( Word ) + "а". END.
      649           IF SUBSTRING( Formatted, jj, 1 ) = "2" OR
      650              SUBSTRING( Formatted, jj, 1 ) = "3" OR
      651              SUBSTRING( Formatted, jj, 1 ) = "4" THEN DO:
      652             IF jj = 12 THEN DO:
      653               IF SUBSTRING( Formatted, jj - 1, 1 ) <> "1" THEN DO: ASSIGN Word = TRIM( Word ) + "и". END.
      654             END.       ELSE DO:
      655               IF SUBSTRING( Formatted, jj - 1, 1 ) <> "1" THEN DO: ASSIGN Word = TRIM( Word ) + "а". END.
      656             END.
      657           END.
      658           IF ( SUBSTRING( Formatted, jj,     1 ) <> "1" AND
      659                SUBSTRING( Formatted, jj,     1 ) <> "2" AND
      660                SUBSTRING( Formatted, jj,     1 ) <> "3" AND
      661                SUBSTRING( Formatted, jj,     1 ) <> "4" AND jj <> 12 ) OR
      662              ( SUBSTRING( Formatted, jj - 1, 1 )  = "1" AND jj <  12 ) THEN DO: ASSIGN Word = TRIM( Word ) + "ов". END.
      663           IF Word <> "":U THEN DO: ASSIGN OutSum = TRIM( Word ) + " ":U + TRIM( OutSum ). END.
      664         END.
      665         IF SUBSTRING( Formatted, jj - 1, 1 ) <> "1" THEN DO:
      666           IF      jj = 12 AND SUBSTRING( Formatted, jj, 1 ) = "1" THEN DO: ASSIGN Word = "одна". END.
      667           ELSE IF jj = 12 AND SUBSTRING( Formatted, jj, 1 ) = "2" THEN DO: ASSIGN Word = "две".  END.
      668           ELSE DO: ASSIGN Word = get-decade-word( 1, INTEGER( SUBSTRING( Formatted, jj, 1 ) ) ). END.
      669           IF Word <> "":U THEN DO: ASSIGN OutSum = TRIM( Word ) + " ":U + TRIM( OutSum ). END.
      670           ASSIGN Word = get-decade-word( 3, INTEGER( SUBSTRING( Formatted, jj - 1, 1 ) ) ).
      671         END.                                        ELSE DO:
      672           ASSIGN Word = get-decade-word( 2, INTEGER( SUBSTRING( Formatted, jj,     1 ) ) ).
      673         END.
      674         IF Word <> "":U THEN DO: ASSIGN OutSum = TRIM( Word ) + " ":U + TRIM( OutSum ). END.
      675         ASSIGN Word = get-decade-word( 4, INTEGER( SUBSTRING( Formatted, jj - 2, 1 ) ) ).
      676         IF Word <> "":U THEN DO: ASSIGN OutSum = TRIM( Word ) + " ":U + TRIM( OutSum ). END.
      677       END.
      678       ASSIGN OutSum = CAPS( SUBSTRING( OutSum, 1, 1 ) ) + SUBSTRING( OutSum, 2 ).
      679       IF OutSum = "":U AND TRUNCATE( p-sum, 0 ) = 0 THEN DO: ASSIGN OutSum = "Ноль". END.
      680       ASSIGN p-res = TRIM( OutSum ).
      681     END.
      682   END PROCEDURE.
      683   FUNCTION Total-Word RETURNS CHARACTER ( INPUT i-sum AS DECIMAL, INPUT i-curr AS CHARACTER, INPUT i-part AS CHARACTER ) :
      684     DEFINE VARIABLE word_sum AS CHARACTER NO-UNDO.
      685     RUN get-total-word IN THIS-PROCEDURE ( INPUT i-sum, INPUT i-curr, INPUT i-part, OUTPUT word_sum ) NO-ERROR.
      686     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE word_sum ).
      687   END FUNCTION.
      688   PROCEDURE get-total-word :
      689     DEFINE  INPUT PARAMETER p-sum  AS DECIMAL   NO-UNDO.
      690     DEFINE  INPUT PARAMETER p-curr AS CHARACTER NO-UNDO.
      691     DEFINE  INPUT PARAMETER p-part AS CHARACTER NO-UNDO.
      692     DEFINE OUTPUT PARAMETER p-word AS CHARACTER NO-UNDO.
      693     DO ON ERROR UNDO, RETURN ERROR :
      694       ASSIGN p-word = Word-Sum( p-sum ).
      695                  ASSIGN p-word = ( IF p-sum < 0 THEN "- " ELSE "":U ) + TRIM(
      696                         RedLine( p-word )
      697                  ) +
      698                         " ":U + p-curr + " ":U +
      699                         SUBSTRING( STRING( ABS( p-sum ), "999999999999999999999999999999.99" ), 32, 2 ) +
      700                         " ":U + p-part + ".".
      701                           END.
      702   END PROCEDURE.
