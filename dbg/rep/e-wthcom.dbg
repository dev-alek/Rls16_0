     1162                when 'UPD':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Настройки справочника Электронного документоборота"     p-tooltip = "Настройки справочника Электронного документоборота"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     1163               when 'LK_RECEIPT':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Настройки справочника документов Вывода из оборота (ОСУ)"     p-tooltip = "Настройки справочника документов Вывода из оборота (ОСУ)"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     1164         otherwise do:
     1165           undo, return error "неизвестная настройка пользователя usr-flt" + " " + p-code .
     1166         end.
     1167       end CASE.
     1168     end.
     1169   end procedure.
     1170   procedure uf-get :
     1171     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     1172     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     1173     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     1174     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     1175     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     1176     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     1177     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     1178     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     1179     do
     1180     on error undo, return error
     1181     :
     1182       define buffer buf_usr-flt for ubflt.usr-flt .
     1183       define variable v-use-List_     as logical   no-undo .
     1184       define variable v-type-List_     as character no-undo .
     1185       define variable v-format-List_   as character no-undo .
     1186       define variable v-use-Naim      as logical   no-undo .
     1187       define variable v-type-Naim      as character no-undo .
     1188       define variable v-format-Naim    as character no-undo .
     1189       define variable v-use-print-graft as logical   no-undo .
     1190       define variable v-use-sort-gr     as logical   no-undo .
     1191       define variable v-use-type-price  as logical   no-undo .
     1192       define variable v-use-type-val    as logical   no-undo .
     1193       define variable v-label          as character no-undo .
     1194       define variable v-tooltip        as character no-undo .
     1195       define variable v-user-can-edit  as logical   no-undo .
     1196       define variable v-output-display as logical   no-undo .
     1197       define variable v-other          as character no-undo .
     1198       run uf-name in this-procedure
     1199          (input  entry(1, p-code, chr(4))
     1200         ,output v-use-List_
     1201         ,output v-type-List_
     1202         ,output v-format-List_
     1203         ,output v-use-Naim
     1204         ,output v-type-Naim
     1205         ,output v-format-Naim
     1206         ,output v-use-print-graft
     1207         ,output v-use-sort-gr
     1208         ,output v-use-type-price
     1209         ,output v-use-type-val
     1210         ,output v-label
     1211         ,output v-tooltip
     1212         ,output v-user-can-edit
     1213         ,output v-output-display
     1214         ,output v-other
     1215         ) no-error .
     1216       if error-status :error then do:
     1217         undo, return error return-value .
     1218       end.
     1219       find first buf_usr-flt no-lock where
     1220                  buf_usr-flt.Call-point     = p-code AND
     1221                  buf_usr-flt.user-name       = p-user-name
     1222         no-error .
     1223       if avail buf_usr-flt then do:
     1224         assign
     1225         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
     1226         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
     1227         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
     1228         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
     1229         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
     1230         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
     1231         .
     1232       end.
     1233       else do:
     1234         assign
     1235         p-List_        = (if v-use-List_       then "":U                    else ?)
     1236         p-Naim         = (if v-use-Naim        then "":U                    else ?)
     1237         p-print-graft  = (if v-use-print-graft then no                      else ?)
     1238         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
     1239         p-type-price   = (if v-use-type-price  then no                      else ?)
     1240         p-type-val     = (if v-use-List_       then no                      else ?)
     1241         .
     1242       end.
     1243     end.
     1244   end procedure.
     1245   procedure uf-set :
     1246     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     1247     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     1248     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     1249     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     1250     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     1251     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     1252     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     1253     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     1254     do
     1255     on error undo, return error
     1256     :
     1257       define buffer buf_usr-flt for ubflt.usr-flt .
     1258       define variable v-use-List_     as logical   no-undo .
     1259       define variable v-type-List_     as character no-undo .
     1260       define variable v-format-List_   as character no-undo .
     1261       define variable v-use-Naim      as logical   no-undo .
     1262       define variable v-type-Naim      as character no-undo .
     1263       define variable v-format-Naim    as character no-undo .
     1264       define variable v-use-print-graft as logical   no-undo .
     1265       define variable v-use-sort-gr   as logical   no-undo .
     1266       define variable v-use-type-price as logical   no-undo .
     1267       define variable v-use-type-val  as logical   no-undo .
     1268       define variable v-tooltip        as character no-undo .
     1269       define variable v-label          as character no-undo .
     1270       define variable v-user-can-edit  as logical   no-undo .
     1271       define variable v-output-display as logical   no-undo .
     1272       define variable v-other          as character no-undo .
     1273       run uf-name in this-procedure
     1274         (input  entry(1, p-code, chr(4))
     1275         ,output v-use-List_
     1276         ,output v-type-List_
     1277         ,output v-format-List_
     1278         ,output v-use-Naim
     1279         ,output v-type-Naim
     1280         ,output v-format-Naim
     1281         ,output v-use-print-graft
     1282         ,output v-use-sort-gr
     1283         ,output v-use-type-price
     1284         ,output v-use-type-val
     1285         ,output v-label
     1286         ,output v-tooltip
     1287         ,output v-user-can-edit
     1288         ,output v-output-display
     1289         ,output v-other
     1290         ) no-error .
     1291       if error-status :error then do:
     1292         undo, return error return-value .
     1293       end.
     1294       find first buf_usr-flt where
     1295                  buf_usr-flt.Call-point     = p-code AND
     1296                  buf_usr-flt.user-name       = p-user-name
     1297         no-error .
     1298       if not avail buf_usr-flt then do:
     1299           create buf_usr-flt .
     1300           assign
     1301           buf_usr-flt.call-point = p-code
     1302           buf_usr-flt.user-name  = p-user-name
     1303           .
     1304       end.
     1305       if avail buf_usr-flt then do:
     1306        assign
     1307        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
     1308        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
     1309        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
     1310        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
     1311        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
     1312        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
     1313       .
     1314       release buf_usr-flt.
     1315       end.
     1316       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
     1317     end.
     1318   end procedure.
     1319   CREATE WIDGET-POOL.
     1320   define variable v-cli-grp-list     as character    no-undo.
     1321   define variable v-cli-grp-all      as character    no-undo.
     1322   define variable v-wth-list         as character    no-undo.
     1323   DEFINE BUTTON bt-cli-grp
     1324        IMAGE-UP FILE "btn-down-arrow":U
     1325        IMAGE-DOWN FILE "btn-down-arrow":U
     1326        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1327        LABEL "&Изменить"
     1328        SIZE 3 BY 1.
     1329   DEFINE BUTTON bt-wth
     1330        IMAGE-UP FILE "btn-down-arrow":U
     1331        IMAGE-DOWN FILE "btn-down-arrow":U
     1332        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1333        LABEL "&Изменить"
     1334        SIZE 3 BY 1.
     1335   DEFINE VARIABLE ed-grp-obj AS CHARACTER
     1336        VIEW-AS EDITOR NO-WORD-WRAP SCROLLBAR-HORIZONTAL SCROLLBAR-VERTICAL
     1337        SIZE 43.5 BY 7.25
     1338        FGCOLOR 4  NO-UNDO.
     1339   DEFINE VARIABLE ed-wth AS CHARACTER
     1340        VIEW-AS EDITOR NO-WORD-WRAP SCROLLBAR-HORIZONTAL SCROLLBAR-VERTICAL
     1341        SIZE 43.5 BY 7.25
     1342        FGCOLOR 4  NO-UNDO.
     1343   DEFINE VARIABLE rs-cli-grp AS INTEGER
     1344        VIEW-AS RADIO-SET VERTICAL
     1345        RADIO-BUTTONS
     1346             "Все", 1,
     1347   "Выборочно", 2
     1348        SIZE 12 BY 2 NO-UNDO.
     1349   DEFINE VARIABLE rs-wth AS INTEGER
     1350        VIEW-AS RADIO-SET VERTICAL
     1351        RADIO-BUTTONS
     1352             "Все", 1,
     1353   "Выборочно", 2
     1354        SIZE 12 BY 2 NO-UNDO.
     1355   DEFINE RECTANGLE RECT-7
     1356        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1357        SIZE 71.38 BY 16.25.
     1358   DEFINE FRAME F-Main
     1359        ed-grp-obj AT ROW 2 COL 28.5 NO-LABEL WIDGET-ID 20
     1360        rs-cli-grp AT ROW 3 COL 4 NO-LABEL WIDGET-ID 30
     1361        bt-cli-grp AT ROW 4 COL 16 WIDGET-ID 14
     1362        ed-wth AT ROW 10 COL 28.5 NO-LABEL WIDGET-ID 28
     1363        rs-wth AT ROW 11 COL 4 NO-LABEL WIDGET-ID 34
     1364        bt-wth AT ROW 12 COL 16 WIDGET-ID 18
     1365        "Материальные ценности:" VIEW-AS TEXT
     1366             SIZE 22.5 BY .67 AT ROW 10.25 COL 4
     1367             FGCOLOR 4
     1368        "Группы объектов:" VIEW-AS TEXT
     1369             SIZE 21 BY .67 AT ROW 2.25 COL 4 WIDGET-ID 2
     1370             FGCOLOR 4
     1371        RECT-7 AT ROW 1.25 COL 2
     1372       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
     1373            SIDE-LABELS NO-UNDERLINE THREE-D
     1374            AT COL 1 ROW 1 SCROLLABLE
     1375            BGCOLOR 8 .
     1376   IF NOT THIS-PROCEDURE:PERSISTENT THEN DO:
     1377     MESSAGE "c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\rep\e-wthcom.w should only be RUN PERSISTENT.":U
     1378             VIEW-AS ALERT-BOX ERROR BUTTONS OK.
     1379     RETURN.
     1380   END.
     1381   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     1382   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     1383   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     1384   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     1385   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     1386   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     1387   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     1388   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     1389         adm-object-hdl = FRAME F-Main:HANDLE.
     1390   RUN ensure-broker.
     1391   THIS-PROCEDURE:ADM-DATA =
     1392        'ADM1.1~`':U +
     1393        'SmartViewer~`':U +
     1394        '~`':U +
     1395        'NO ~`':U +
     1396        '~`':U +
     1397        '~`':U +
     1398        '~`':U +
     1399        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     1400           + "~`":U +
     1401        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
     1402        'Record-Source,Record-Target,TableIO-Target~`':U +
     1403        '~`':U +
     1404        '~`~`~`~`~`~`~`~`~`~`~`':U +
     1405        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1406            THEN "^^":U
     1407        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1408             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1409   PROCEDURE adm-apply-entry :
     1410     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1411   END PROCEDURE.
     1412   PROCEDURE adm-destroy :
     1413    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1414   END PROCEDURE.
     1415   PROCEDURE adm-disable :
     1416       DISABLE RECT-7 ed-grp-obj rs-cli-grp bt-cli-grp ed-wth rs-wth bt-wth WITH FRAME F-Main.
     1417       RUN dispatch ('disable-fields':U).
     1418       RUN set-attribute-list ('ENABLED=no':U).
     1419       RETURN.
     1420   END PROCEDURE.
     1421   PROCEDURE adm-edit-attribute-list :
     1422         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
     1423         RETURN.
     1424   END PROCEDURE.
     1425   PROCEDURE adm-enable :
     1426       ENABLE UNLESS-HIDDEN RECT-7 ed-grp-obj rs-cli-grp bt-cli-grp ed-wth rs-wth bt-wth WITH FRAME F-Main.
     1427       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     1428       RUN set-attribute-list ('ENABLED=yes':U).
     1429       RETURN.
     1430   END PROCEDURE.
     1431   PROCEDURE adm-exit :
     1432        RUN notify ('exit':U).
     1433     RETURN.
     1434   END PROCEDURE.
     1435   PROCEDURE adm-hide :
     1436     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1437   END PROCEDURE.
     1438   PROCEDURE adm-initialize :
     1439     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1440   END PROCEDURE.
     1441   PROCEDURE adm-show-errors :
     1442       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1443       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1444           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1445       END.
     1446       RETURN.
     1447   END PROCEDURE.
     1448   PROCEDURE adm-UIB-mode :
     1449     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1450   END PROCEDURE.
     1451   PROCEDURE adm-view :
     1452     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1453   END PROCEDURE.
     1454   PROCEDURE dispatch :
     1455       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1456       RUN broker-dispatch IN adm-broker-hdl
     1457           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1458       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1459   END PROCEDURE.
     1460   PROCEDURE ensure-broker :
     1461   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1462   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1463   DO:
     1464       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1465       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1466   END.
     1467   END PROCEDURE.
     1468   PROCEDURE get-attribute :
     1469     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1470     RUN broker-get-attribute IN adm-broker-hdl
     1471         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1472     RETURN RETURN-VALUE.
     1473   END PROCEDURE.
     1474   PROCEDURE get-attribute-list :
     1475     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1476     RUN broker-get-attribute-list IN adm-broker-hdl
     1477         (INPUT THIS-PROCEDURE,
     1478          INPUT ?,
     1479          OUTPUT p-attr-list) NO-ERROR.
     1480     RETURN.
     1481   END PROCEDURE.
     1482   PROCEDURE new-state :
     1483     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1484     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1485     RETURN.
     1486   END PROCEDURE.
     1487   PROCEDURE notify :
     1488     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1489     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1490     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1491         RETURN "ADM-ERROR":U.
     1492     RETURN.
     1493   END PROCEDURE.
     1494   PROCEDURE set-attribute-list :
     1495     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1496     RUN ensure-broker.
     1497     RUN broker-set-attribute-list IN adm-broker-hdl
     1498         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1499     RETURN.
     1500   END PROCEDURE.
     1501   PROCEDURE set-position :
     1502       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1503       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1504       IF VALID-HANDLE(adm-object-hdl) THEN
     1505       DO:
     1506         ASSIGN adm-object-hdl:ROW    =   p-row
     1507                adm-object-hdl:COLUMN =   p-col.
     1508       END.
     1509       RETURN.
     1510   END PROCEDURE.
     1511   PROCEDURE adm-display-fields :
     1512       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
     1513       RETURN.
     1514   END PROCEDURE.
     1515   PROCEDURE adm-open-query :
     1516     RETURN.
     1517   END PROCEDURE.
     1518   PROCEDURE adm-row-changed :
     1519         IF VALID-HANDLE(adm-object-hdl) THEN
     1520           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1521         RUN notify ('row-available':U).
     1522         RETURN.
     1523   END PROCEDURE.
     1524   PROCEDURE reposition-query :
     1525       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
     1526       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
     1527       RETURN.
     1528   END PROCEDURE.
     1529     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
     1530     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
     1531     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
     1532     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
     1533     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
     1534     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
     1535     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
     1536     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
     1537     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1538     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
     1539     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1540     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
     1541     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
     1542     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
     1543     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
     1544     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
     1545     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
     1546     IF "":U = "":U THEN
     1547       RUN modify-list-attribute IN adm-broker-hdl
     1548         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
     1549     RUN use-create-on-add(?).
     1550   PROCEDURE adm-add-record :
     1551       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1552          "must have at least one Enabled Table to perform Add.":U
     1553          VIEW-AS ALERT-BOX ERROR.
     1554       RETURN.
     1555   END PROCEDURE.
     1556   PROCEDURE adm-assign-record :
     1557    MESSAGE
     1558          "Object ":U THIS-PROCEDURE:FILE-NAME
     1559            "must have at least one Enabled Table to perform Assign.":U
     1560              VIEW-AS ALERT-BOX ERROR.
     1561      RETURN.
     1562     END PROCEDURE.
     1563   PROCEDURE adm-assign-statement :
     1564     RETURN.
     1565   END PROCEDURE.
     1566   PROCEDURE adm-cancel-record :
     1567      RETURN.
     1568     END PROCEDURE.
     1569   PROCEDURE adm-copy-record :
     1570       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1571        "must have at least one Enabled Table to perform Copy.":U
     1572          VIEW-AS ALERT-BOX ERROR.
     1573       RETURN.
     1574   END PROCEDURE.
     1575   PROCEDURE adm-create-record :
     1576      RETURN.
     1577   END PROCEDURE.
     1578   PROCEDURE adm-current-changed :
     1579     RETURN.
     1580   END PROCEDURE.
     1581   PROCEDURE adm-delete-record :
     1582    MESSAGE
     1583          "Object ":U THIS-PROCEDURE:FILE-NAME
     1584            "must have at least one Enabled Table to perform Delete.":U
     1585              VIEW-AS ALERT-BOX ERROR.
     1586       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
     1587       RETURN.
     1588   END PROCEDURE.
     1589   PROCEDURE adm-disable-fields :
     1590         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
     1591       RETURN.
     1592   END PROCEDURE.
     1593   PROCEDURE adm-enable-fields :
     1594       RETURN.
     1595   END PROCEDURE.
     1596   PROCEDURE adm-end-update :
     1597     RETURN.
     1598   END PROCEDURE.
     1599   PROCEDURE adm-reset-record :
     1600       RETURN.
     1601   END PROCEDURE.
     1602   PROCEDURE adm-update-record :
     1603       MESSAGE
     1604         "Object ":U THIS-PROCEDURE:FILE-NAME
     1605           "must have at least one Enabled Table to perform Update.":U
     1606             VIEW-AS ALERT-BOX ERROR.
     1607      RETURN.
     1608   END PROCEDURE.
     1609   PROCEDURE check-modified :
     1610   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1611   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1612   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1613   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1614     IF check-state = "check":U THEN
     1615     DO:
     1616       RUN get-link-handle IN adm-broker-hdl
     1617         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1618            OUTPUT group-target-list).
     1619       IF group-target-list NE "":U THEN
     1620       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1621         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1622         RUN check-modified IN curr-widget ('group-check':U).
     1623         IF RETURN-VALUE NE "":U THEN
     1624         DO:
     1625           RUN check-modified-message(RETURN-VALUE).
     1626           RETURN "":U.
     1627         END.
     1628       END.
     1629     END.
     1630     RETURN "":U.
     1631   END PROCEDURE.
     1632   PROCEDURE check-modified-message :
     1633     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1634        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1635           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1636        IF RETURN-VALUE = "YES":U THEN
     1637           RUN notify ('view,CONTAINER-SOURCE':U).
     1638        MESSAGE IF p-changed-table NE ? THEN
     1639           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1640           ELSE "Current values have been changed."
     1641           SKIP "  Do you wish to save those changes?"
     1642           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1643        IF ANS THEN
     1644        DO:
     1645           IF group-assign-target THEN
     1646             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1647           ELSE RUN dispatch('update-record':U).
     1648           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1649           DO:
     1650               MESSAGE "Changes to the previous record were not saved."
     1651                 VIEW-AS ALERT-BOX ERROR.
     1652               IF group-assign-target THEN
     1653                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1654               ELSE RUN dispatch ('cancel-record':U).
     1655           END.
     1656        END.
     1657        ELSE DO:
     1658          IF group-assign-target THEN
     1659             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1660          ELSE RUN dispatch('cancel-record':U).
     1661        END.
     1662        RETURN.
     1663   END PROCEDURE.
     1664   PROCEDURE get-rowid :
     1665       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1666       ASSIGN
     1667       p-table   =   adm-first-table.
     1668       RETURN.
     1669   END PROCEDURE.
     1670   PROCEDURE init-group-assign :
     1671       RUN request-attribute IN adm-broker-hdl
     1672         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1673       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1674         group-assign-target = yes.
     1675       ELSE group-assign-target = no.
     1676       RETURN.
     1677   END PROCEDURE.
     1678   PROCEDURE set-editors :
     1679       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1680       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1681       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1682       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1683       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1684       DO WHILE VALID-HANDLE (curr-widget):
     1685           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1686              curr-widget:HIDDEN = no THEN DO:
     1687             CASE p-field-setting:
     1688               WHEN "INITIALIZE":U THEN
     1689               DO:
     1690                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1691                     read-only-list +
     1692                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1693                        STRING(curr-widget).
     1694               END.
     1695               WHEN "DISABLE":U OR
     1696               WHEN "ENABLE":U THEN
     1697               DO:
     1698                   curr-widget:SENSITIVE = yes.
     1699                   RUN get-attribute ('Read-Only-Editors':U).
     1700                   IF RETURN-VALUE = ? OR
     1701                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1702                       curr-widget:READ-ONLY =
     1703                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1704               END.
     1705               WHEN "CLEAR":U THEN
     1706                   curr-widget:SCREEN-VALUE = "":U.
     1707             END CASE.
     1708           END.
     1709           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1710       END.
     1711       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1712         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1713           + '"':U).
     1714       RETURN.
     1715   END PROCEDURE.
     1716   PROCEDURE use-check-modified-all :
     1717    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1718     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1719     RETURN.
     1720   END PROCEDURE.
     1721   PROCEDURE use-create-on-add :
     1722   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1723      RETURN.
     1724   END PROCEDURE.
     1725   PROCEDURE use-initial-lock :
     1726     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1727     ASSIGN adm-initial-lock = p-attr-value.
     1728     RETURN.
     1729   END PROCEDURE.
     1730     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1731   ASSIGN
     1732          FRAME F-Main:SCROLLABLE       = FALSE
     1733          FRAME F-Main:HIDDEN           = TRUE.
     1734   ASSIGN
     1735          ed-grp-obj:READ-ONLY IN FRAME F-Main        = TRUE.
     1736   ASSIGN
     1737          ed-wth:READ-ONLY IN FRAME F-Main        = TRUE.
     1738   ON CHOOSE OF bt-cli-grp IN FRAME F-Main
     1739   DO:
     1740       assign
     1741         rs-cli-grp = 2
     1742       .
     1743       display
     1744         rs-cli-grp
     1745       with frame F-Main.
     1746       run select-cli-grp in this-procedure.
     1747   END.
     1748   ON CHOOSE OF bt-wth IN FRAME F-Main
     1749   DO:
     1750       assign
     1751         rs-wth = 2
     1752       .
     1753       display
     1754         rs-wth
     1755       with frame F-Main.
     1756       run select-wth in this-procedure.
     1757   END.
     1758   ON VALUE-CHANGED OF rs-cli-grp IN FRAME F-Main
     1759   DO:
     1760     assign
     1761       rs-cli-grp
     1762     .
     1763     case rs-cli-grp:
     1764       when 1 then do:
     1765         assign
     1766           ed-grp-obj      = "Все"
     1767           v-cli-grp-list = v-cli-grp-all
     1768         .
     1769         display
     1770           ed-grp-obj
     1771         with frame F-Main.
     1772       end.
     1773       when 2 then do:
     1774         apply "choose" to bt-cli-grp.
     1775       end.
     1776       otherwise do:
     1777         return no-apply.
     1778       end.
     1779     end case.
     1780   END.
     1781   ON VALUE-CHANGED OF rs-wth IN FRAME F-Main
     1782   DO:
     1783     define buffer buf_wealth for ub.wealth.
     1784     assign
     1785       rs-wth
     1786     .
     1787     case rs-wth :
     1788       when 1 then do:
     1789         assign
     1790           ed-wth      = "Все"
     1791           v-wth-list  = ""
     1792         .
     1793         for each buf_wealth
     1794           where buf_wealth.is-ser = 1
     1795             and buf_wealth.stts   = 0
     1796            no-lock
     1797         :
     1798           assign
     1799             v-wth-list = v-wth-list + string(buf_wealth.wth-code) + chr(44)
     1800           .
     1801         end.
     1802         display
     1803           ed-wth
     1804         with frame F-Main.
     1805       end.
     1806       when 2 then do:
     1807         apply "choose" to bt-wth.
     1808       end.
     1809       otherwise do:
     1810         return no-apply.
     1811       end.
     1812     end case.
     1813   END.
     1814   PROCEDURE convert-wth-code :
     1815     define input  parameter p-code-list   as character no-undo .
     1816     define output parameter p-recid-list  as character no-undo .
     1817     define buffer buf_wealth for ub.wealth.
     1818     define variable v-i               as integer   no-undo .
     1819     do
     1820     on error undo, return error return-value
     1821     :
     1822       do v-i = 1 to num-entries( p-code-list )
     1823       :
     1824         find first buf_wealth
     1825           where buf_wealth.wth-code = integer( entry( v-i, p-code-list ) )
     1826            no-lock
     1827            no-error
     1828            .
     1829         if available buf_wealth
     1830         then do:
     1831           assign
     1832             p-recid-list = p-recid-list + string( recid(buf_wealth) ) + chr(44)
     1833           .
     1834         end.
     1835       end.
     1836       assign
     1837         p-recid-list = trim( p-recid-list, chr(44) )
     1838       .
     1839     end.
     1840   END PROCEDURE.
     1841   PROCEDURE convert-wth-recid :
     1842     define input  parameter p-recid-list  as character no-undo .
     1843     define output parameter p-code-list   as character no-undo .
     1844     define buffer buf_wealth for ub.wealth.
     1845     define variable v-i               as integer   no-undo .
     1846     do
     1847     on error undo, return error return-value
     1848     :
     1849       do v-i = 1 to num-entries( p-recid-list )
     1850       :
     1851         find first buf_wealth no-lock
     1852           where recid(buf_wealth) = integer( entry( v-i, p-recid-list ) )
     1853         no-error .
     1854         if available buf_wealth
     1855         then do:
     1856           assign
     1857             p-code-list = p-code-list + string( buf_wealth.wth-code ) + chr(44)
     1858           .
     1859         end.
     1860       end.
     1861       assign
     1862         p-code-list = trim( p-code-list, chr(44) )
     1863       .
     1864     end.
     1865   END PROCEDURE.
     1866   PROCEDURE disable_UI :
     1867     HIDE FRAME F-Main.
     1868     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1869   END PROCEDURE.
     1870   PROCEDURE local-apply-layout :
     1871     RUN dispatch IN THIS-PROCEDURE ( INPUT 'apply-layout':U ) .
     1872   END PROCEDURE.
     1873   PROCEDURE local-initialize :
     1874       define buffer buf_wealth  for ub.wealth.
     1875       define buffer buf_cli-grp for ub.cli-grp.
     1876      define variable v-value-character as character no-undo .
     1877      define variable v-value-date as date no-undo .
     1878      define variable v-value-decimal as decimal no-undo .
     1879      define variable v-value-integer as INTEGER no-undo .
     1880      define variable v-value-logical AS LOGICAL no-undo .
     1881      define variable v-param-type as character no-undo .
     1882       define variable v-rs-cli-grp      as logical   no-undo.
     1883       define variable v-rs-wth          as logical   no-undo.
     1884       define variable v-void-logical-3        as logical      no-undo.
     1885       define variable v-void-logical-4        as logical      no-undo.
     1886       define variable v-found                 as logical      no-undo.
     1887       define variable v-i               as integer   no-undo .
     1888      define variable v-cli-grp-lst     as character    no-undo.
     1889      define variable v-wth-lst         as character    no-undo.
     1890   do
     1891   on error undo, return error
     1892   :
     1893      RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     1894      run adm/shattri.p ( input "get":U
     1895                        , input ""
     1896                        , input 0
     1897                        , input 'attr-wthrep':U
     1898                        , input  ""
     1899                        , output v-value-character
     1900                        , output v-value-date
     1901                        , output v-value-decimal
     1902                        , output v-value-integer
     1903                        , output v-value-logical
     1904                        , output v-param-type
     1905                        , INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1906                        ) no-error .
     1907      find first thbjattr_thbj-attr
     1908            where thbjattr_thbj-attr.obj-code  = 0
     1909               and thbjattr_thbj-attr.obj-type  = ""
     1910               and thbjattr_thbj-attr.prop-code = 'cligrplist':U
     1911               and thbjattr_thbj-attr.upper-prop-code = 'attr-wthrep':U
     1912            no-error
     1913            .
     1914      .
     1915      if error-status :error then do:
     1916            message
     1917            vss-workfile vss-revision vss-description skip
     1918            error-status :get-message(1) skip
     1919            return-value skip
     1920            ""
     1921            view-as alert-box error
     1922            .
     1923            return no-apply .
     1924      end.
     1925      assign
     1926         v-cli-grp-all = thbjattr_thbj-attr.property-value-character
     1927      .
     1928       run uf-get (
     1929             input "wthcom":U
     1930           , input v-cntxt-userid
     1931           , output v-wth-lst
     1932           , output v-rs-cli-grp
     1933           , output v-cli-grp-lst
     1934           , output v-rs-wth
     1935           , output v-void-logical-3
     1936           , output v-void-logical-4
     1937      ) .
     1938         if v-rs-cli-grp = no
     1939         then do:
     1940           assign
     1941             rs-cli-grp  = 1
     1942             ed-grp-obj  = "Все":u
     1943            v-cli-grp-list = v-cli-grp-all
     1944           .
     1945         end.
     1946         else do:
     1947           assign
     1948             rs-cli-grp = 2
     1949            v-cli-grp-list = "":U
     1950           .
     1951         _flt-grp-load:
     1952         do v-i = 1 to num-entries(v-cli-grp-lst)
     1953           :
     1954            IF LOOKUP(entry( v-i, v-cli-grp-lst, chr(44) ), v-cli-grp-all) = 0
     1955            THEN DO:
     1956               NEXT _flt-grp-load.
     1957            END.
     1958            find first buf_cli-grp
     1959                 where buf_cli-grp.node-code = integer( entry( v-i, v-cli-grp-lst, chr(44) ) )
     1960                 no-lock
     1961                 no-error
     1962                 .
     1963             if available buf_cli-grp
     1964             then do:
     1965               assign
     1966                 ed-grp-obj = ed-grp-obj + buf_cli-grp.node-name + chr(10)
     1967               v-cli-grp-list = IF v-cli-grp-list = "":U THEN entry( v-i, v-cli-grp-lst, chr(44) )
     1968                                                         ELSE v-cli-grp-list + chr(44) + entry( v-i, v-cli-grp-lst, chr(44) )
     1969               .
     1970             end.
     1971           end.
     1972         end.
     1973         if v-rs-wth = no
     1974         then do:
     1975           assign
     1976             rs-wth  = 1
     1977             ed-wth  = "Все":u
     1978            v-wth-list = "":U
     1979         .
     1980         for each buf_wealth
     1981            where buf_wealth.is-ser = 1
     1982            and  buf_wealth.stts   = 0
     1983            no-lock
     1984            :
     1985            assign
     1986               v-wth-list = v-wth-list + string(buf_wealth.wth-code) + chr(44)
     1987           .
     1988         end.
     1989      end.
     1990         else do:
     1991           assign
     1992             rs-wth = 2
     1993            v-wth-list = "":U
     1994           .
     1995         do v-i = 1 to num-entries(v-wth-lst)
     1996           :
     1997            find first buf_wealth
     1998                 where buf_wealth.wth-code = integer( entry( v-i, v-wth-lst, chr(44) ) )
     1999                 no-lock
     2000                 no-error
     2001                 .
     2002             if available buf_wealth
     2003             then do:
     2004               assign
     2005                 ed-wth = ed-wth + buf_wealth.wth-name + chr(10)
     2006               v-wth-list = IF v-wth-list = "":U THEN entry( v-i, v-wth-lst, chr(44) )
     2007                                                 ELSE v-wth-list + chr(44) + entry( v-i, v-wth-lst, chr(44) )
     2008               .
     2009             end.
     2010           end.
     2011         end.
     2012         display
     2013           rs-cli-grp
     2014           rs-wth
     2015           ed-grp-obj
     2016           ed-wth
     2017         with frame F-Main.
     2018       end.
     2019   END PROCEDURE.
     2020   PROCEDURE my-report :
     2021       define variable v-begin-date            as date         no-undo.
     2022       define variable v-end-date              as date         no-undo.
     2023       define variable v-begin-shift           as integer      no-undo.
     2024       define variable v-end-shift             as integer      no-undo.
     2025       define variable v-counter               as integer      no-undo.
     2026       define variable v-ext-doc-type-list     as character    no-undo.
     2027   do
     2028   on error undo, return error
     2029   :
     2030      IF v-cli-grp-list = "":U
     2031      THEN DO:
     2032         message
     2033            "Не выбран список групп объектов"
     2034            skip
     2035         view-as alert-box information.
     2036         return no-apply.
     2037      END.
     2038      IF v-wth-list = "":U
     2039      THEN DO:
     2040         message
     2041            "Не выбран список материальных ценностей"
     2042            skip
     2043         view-as alert-box information.
     2044         return no-apply.
     2045      END.
     2046      assign
     2047         v-begin-date  = x-Date-Start
     2048         v-end-date    = x-Date-End
     2049         v-begin-shift = x-Shift-Start
     2050         v-end-shift   = x-Shift-End
     2051      .
     2052      run uf-set IN THIS-PROCEDURE (
     2053           input 'wthcom':U
     2054         , input v-cntxt-userid
     2055         , input v-cli-grp-list
     2056         , input v-wth-list
     2057         , input ( if rs-cli-grp = 1 then no else yes )
     2058         , input ( if rs-wth     = 1 then no else yes )
     2059         , input no
     2060         , input no
     2061      ) .
     2062      run rep/r-wthcom.p  ( input my-handle
     2063                        , input v-begin-date
     2064                        , input v-end-date
     2065                        , input v-begin-shift
     2066                        , input v-end-shift
     2067                        , input v-cli-grp-list
     2068                        , input v-wth-list
     2069                        ) .
     2070   end.
     2071   END PROCEDURE.
     2072   PROCEDURE my-var :
     2073     assign
     2074       ReportHeader =  ReportHeader + "Группы объектов: " + chr(10) + ed-grp-obj + chr(10) + chr(10) +
     2075                       "Материальные ценности: " + chr(10) + ed-wth
     2076   .
     2077   END PROCEDURE.
     2078   PROCEDURE select-cli-grp :
     2079   define buffer buf_cli-grp     for ub.cli-grp .
     2080   define variable v-count    as integer      no-undo.
     2081      define variable v-value-character as character no-undo .
     2082      define variable v-value-date as date no-undo .
     2083      define variable v-value-decimal as decimal no-undo .
     2084      define variable v-value-integer as INTEGER no-undo .
     2085      define variable v-value-logical AS LOGICAL no-undo .
     2086      define variable v-param-type as character no-undo .
     2087      define variable v-cur-ext-key    as character    no-undo.
     2088      define variable v-accepted    as logical      no-undo.
     2089   do
     2090   on error undo, return error
     2091   :
     2092      run onewin_clear in this-procedure.
     2093      DO v-count = 1 TO NUM-ENTRIES(v-cli-grp-all)
     2094      on error undo, next
     2095      :
     2096         find first buf_cli-grp
     2097              where buf_cli-grp.node-code = INTEGER(ENTRY(v-count, v-cli-grp-all, chr(44)))
     2098              no-lock
     2099              no-error
     2100              .
     2101         IF AVAILABLE buf_cli-grp
     2102         THEN DO:
     2103           run onewin_add-item in this-procedure   ( input buf_cli-grp.node-code
     2104                                                   , INPUT buf_cli-grp.node-name
     2105                                                   , INPUT ""
     2106                                                   , input (LOOKUP(STRING(buf_cli-grp.node-code), v-cli-grp-list, chr(44)) <> 0)
     2107                                                   ) .
     2108         END.
     2109      END.
     2110      run gbl/onewin.w  ( input my-handle
     2111                        , input 1
     2112                        , input "Список групп объектов для сводных отчетов"
     2113                        , input "":U
     2114                        , input "":U
     2115                        , input  table temp_onewin_items
     2116                        , output table temp_onewin_itemsSelected
     2117                        , output v-cur-ext-key
     2118                        , output v-accepted
     2119                        ) .
     2120      assign
     2121         v-cli-grp-list = "":U
     2122         ed-grp-obj     = "":u
     2123      .
     2124      FOR EACH temp_onewin_itemsSelected
     2125         :
     2126         find first buf_cli-grp no-lock
     2127           where buf_cli-grp.node-code = integer(temp_onewin_itemsSelected.itmExtKey)
     2128         no-error .
     2129         if available buf_cli-grp
     2130         then do:
     2131         assign
     2132            v-cli-grp-list = IF v-cli-grp-list = "":U THEN temp_onewin_itemsSelected.itmExtKey
     2133                                                      ELSE v-cli-grp-list + chr(44) + temp_onewin_itemsSelected.itmExtKey
     2134             ed-grp-obj = ed-grp-obj + buf_cli-grp.node-name + chr(10)
     2135         .
     2136         end.
     2137      END.
     2138      display
     2139       ed-grp-obj
     2140      with frame F-Main.
     2141   end.
     2142   END PROCEDURE.
     2143   PROCEDURE select-wth :
     2144   do
     2145   on error undo, return error
     2146   :
     2147     define buffer buf_wealth for ub.wealth.
     2148     define variable v-wth-recid-list  as character no-undo .
     2149     define variable v-i               as integer   no-undo .
     2150     run convert-wth-code in this-procedure ( input v-wth-list
     2151                                            , output v-wth-recid-list
     2152                                            ).
     2153      run ref/wth-ref.w ( INPUT my-handle
     2154                        , INPUT "b-sel,b-mark"
     2155                        , INPUT v-cntxt-host-code-obj
     2156                        , INPUT v-cntxt-obj-type
     2157                        , INPUT v-cntxt-obj-code
     2158                        , INPUT 'wth-ser'
     2159                       , INPUT-OUTPUT v-wth-recid-list
     2160                       ) .
     2161     assign
     2162       ed-wth = "":u
     2163     .
     2164     do v-i = 1 to num-entries( v-wth-recid-list )
     2165     :
     2166       find first buf_wealth no-lock
     2167         where recid(buf_wealth) = integer( entry( v-i, v-wth-recid-list ) )
     2168       no-error .
     2169       if available buf_wealth
     2170       then do:
     2171         assign
     2172           ed-wth = ed-wth + buf_wealth.wth-name + chr(10)
     2173         .
     2174       end.
     2175     end.
     2176     run convert-wth-recid in this-procedure ( input v-wth-recid-list
     2177                                             , output v-wth-list
     2178                        ) .
     2179     display
     2180       ed-wth
     2181     with frame F-Main.
     2182   end.
     2183   END PROCEDURE.
