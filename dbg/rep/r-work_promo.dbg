     1495         '<TD text_wrap="true" style="text-align: center; font-weight: bold;">' + string(tt-promo-itog.promo-name) + '</TD>' skip
     1496         '<TD text_wrap="true" style="text-align: right; font-weight: bold;">' + if tt-promo-itog.object-qnty <> 0 then fnc-convert-dot-to-colon(tt-promo-itog.object-qnty,"->>>>>>>>>>>9",0) + '</TD>' else "0" + '</TD>' skip
     1497         '<TD text_wrap="true" style="text-align: right; font-weight: bold;">' + if tt-promo-itog.sale-qnty <> 0 then fnc-convert-dot-to-colon(tt-promo-itog.sale-qnty,"->>>>>>>>>>>9",0) + '</TD>' else "0" + '</TD>' skip
