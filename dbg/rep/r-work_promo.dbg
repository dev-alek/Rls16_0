     1417       assign
     1418         tt-promo-itog-obj.goods-qnty   = tt-promo-itog-obj.goods-qnty + tt-promo.goods-qnty
     1419         tt-promo-itog-obj.object-qnty  = tt-promo-itog-obj.object-qnty + tt-promo.object-qnty
     1420         tt-promo-itog-obj.discount-sum = tt-promo-itog-obj.discount-sum + tt-promo.discount-sum
     1421         tt-promo-itog-obj.itog-sum     = tt-promo-itog-obj.itog-sum + tt-promo.itog-sum
     1422         tt-promo-itog-obj.return-qnty  = tt-promo-itog-obj.return-qnty + tt-promo.return-qnty
     1423         tt-promo-itog-obj.sale-qnty    = tt-promo-itog-obj.sale-qnty + tt-promo.sale-qnty
     1424         tt-promo-itog-obj.change-BL  = tt-promo.change-BL
     1425         .
     1426     end.
     1427     v-first = true .
