     1052     field promo-id     as character
     1053     field promo-name   as character
     1054     field object-qnty  as integer
     1055     field goods-qnty   as integer
     1056     field discount-sum as decimal
     1057     field itog-sum     as decimal
     1058     field return-qnty  as integer
     1059     field sale-qnty    as integer
     1060     field change-BL    as character
     1061     Index pi promo-id
     1062     .
     1063   define variable v-report-name       as character no-undo .
     1064   define variable v-file-name-rep-htm as character no-undo .
     1065   define variable v-filt-1            as character no-undo .
     1066   define variable v-filt-2            as character no-undo .
     1067   define variable v-date-start        as date      no-undo .
     1068   define variable v-page-name         as character no-undo .
     1069   define variable v-obj-code          as integer   no-undo .
     1070   define variable v-wdaylist          as character no-undo .
     1071   define variable v-timelist          as character extent 7 no-undo .
     1072   define variable v-sdaynum           as character no-undo .
     1073   define variable v-idaynum           as integer   no-undo .
     1074   define variable v-timebeg           as character no-undo .
     1075   define variable v-timeend           as character no-undo .
     1076   define variable vi                  as integer   no-undo .
     1077   define variable vj                  as integer   no-undo .
     1078   define variable ii                  as integer   no-undo .
     1079   define variable kk                  as integer   no-undo .
     1080   define variable v-period            as character no-undo .
     1081   define variable v-list-obj          as character no-undo .
     1082   define variable v-obj-name          as character no-undo .
     1083   define variable v-first             as logical   no-undo .
     1084   define buffer buf_chk-discnt      for ub.chk-discnt .
     1085   define buffer buf_chk-discnt-attr for ub.chk-discnt-attr .
     1086   define buffer buf_chk-doc         for ub.chk-doc .
     1087   define buffer buf_tt-promo-itog   for tt-promo-itog .
     1088   define buffer buf_chk-gds         for ub.chk-gds .
     1089   define buffer bf_chk-discnt       for ub.chk-discnt .
     1090   define buffer bf_chk-discnt-attr  for ub.chk-discnt-attr .
     1091   define VARIABLE p-report-id as character no-undo .
     1092   function ChkPLLine returns logical
     1093       (input iDocCode as character,
     1094       input iLineNum as integer,
     1095       input iPromoId as character)
     1096       :
     1097       define buffer buf_chk-gds for ub.chk-gds.
     1098       define buffer bf_chk-discnt for ub.chk-discnt.
     1099       define buffer buf_bar-code for ub.bar-code.
     1100       define buffer buf_goods for ub.goods.
     1101       define buffer  buf_chk-discnt-attr for ub.chk-discnt-attr.
     1102       define variable vPromo as logical no-undo.
     1103       define variable is-petrolium         as logical   no-undo.
     1104       define variable is-pieces            as logical   no-undo.
     1105       vPromo = no.
     1106       find first buf_chk-gds no-lock where
     1107                  buf_chk-gds.doc-code = iDocCode
     1108              and buf_chk-gds.line-num  = iLineNum
     1109       no-error.
     1110       if avail buf_chk-gds
     1111       then do:
     1112          find first buf_bar-code no-lock where buf_bar-code.b-code = buf_chk-gds.b-code no-error .
     1113          if avail buf_bar-code then
     1114          find first buf_goods no-lock where buf_goods.gds-code = buf_bar-code.gds-code no-error .
     1115          if avail buf_bar-code and avail buf_goods then do:
     1116   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     1117     (
     1118        input buf_goods.artic
     1119     ,  input buf_goods.prod-type
     1120     ,  input buf_goods.prod-code
     1121     , output is-petrolium
     1122     , output is-pieces
     1123     ) no-error.
     1124               if is-petrolium then
     1125                vPromo = yes.
     1126           end.
     1127       end.
     1128       return vPromo.
     1129   end.
     1130   function ChkGoodLine returns logical
     1131       (input iDocCode as character,
     1132       input iPromoId as character)
     1133       :
     1134       define buffer buf_chk-gds for ub.chk-gds.
     1135       define buffer bf_chk-discnt for ub.chk-discnt.
     1136       define buffer buf_bar-code for ub.bar-code.
     1137       define buffer buf_goods for ub.goods.
     1138       define buffer  buf_chk-discnt-attr for ub.chk-discnt-attr.
     1139       define variable vGds as logical no-undo.
     1140       define variable is-petrolium         as logical   no-undo.
     1141       define variable is-pieces            as logical   no-undo.
     1142       define variable vRecordType         as integer   no-undo .
     1143       vGds = no.
     1144       if can-find(first bf_chk-discnt no-lock where
     1145                         bf_chk-discnt.doc-code = iDocCode and
     1146                         bf_chk-discnt.record-type = 1 and
     1147                         bf_chk-discnt.promo-id = iPromoId)
     1148       then vRecordType = 1.
     1149       else vRecordType = 0.
     1150       chkdisc:
     1151       for each bf_chk-discnt no-lock where
     1152                bf_chk-discnt.doc-code = iDocCode and
     1153                bf_chk-discnt.record-type = vRecordType and
     1154                bf_chk-discnt.promo-id = iPromoId,
     1155          first buf_chk-gds no-lock where
     1156                buf_chk-gds.doc-code = bf_chk-discnt.doc-code and
     1157                buf_chk-gds.line-num = bf_chk-discnt.object-line-num,
     1158          first buf_bar-code no-lock where buf_bar-code.b-code = buf_chk-gds.b-code,
     1159          first buf_goods no-lock where buf_goods.gds-code = buf_bar-code.gds-code:
     1160   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     1161     (
     1162        input buf_goods.artic
     1163     ,  input buf_goods.prod-type
     1164     ,  input buf_goods.prod-code
     1165     , output is-petrolium
     1166     , output is-pieces
     1167     ) no-error.
     1168           if not is-petrolium then
     1169           do:
     1170               vGds = yes.
     1171               leave chkdisc.
     1172           end.
     1173       end.
     1174       return vGds.
     1175   end.
     1176   if x-TOG-Shift then
     1177   do:
     1178     v-period = "Смены с " + string (x-Shift-Start) + " по " + string (x-Shift-End) + " За период с " + string (x-Date-Start,"99.99.9999") + " по " + string (x-Date-End,"99.99.9999") .
     1179   end.
     1180   else
     1181   do:
     1182     v-period = "За период с " + string (x-Date-Start,"99.99.9999") + " по " + string (x-Date-End,"99.99.9999") .
     1183   end.
     1184   run clients-write(INPUT v-cntxt-host-code-obj, INPUT 'орг':U, OUTPUT v-obj-name) no-error .
     1185   for each obj-list no-lock:
     1186     if v-list-obj = "" then v-list-obj = string(obj-list.obj-code).
     1187     else v-list-obj = v-list-obj + ", " + string(obj-list.obj-code).
     1188     if x-TOG-Shift then
     1189     do:
     1190       for each buf_chk-doc no-lock
     1191         where buf_chk-doc.obj-code = obj-list.obj-code
     1192         and buf_chk-doc.obj-type = obj-list.obj-type
     1193         and buf_chk-doc.chk-type <> 8
     1194         and buf_chk-doc.shift-date >= x-Date-Start
     1195         and buf_chk-doc.shift-date <= x-Date-End
     1196         and buf_chk-doc.out-code <> ?:
     1197         if (buf_chk-doc.shift-date = X-date-Start)
     1198           and (buf_chk-doc.shift-num < x-Shift-Start) then next.
     1199         if (buf_chk-doc.shift-date = X-date-End)
     1200           and (buf_chk-doc.shift-num > x-Shift-End) then next.
     1201         run report .
     1202       end.
     1203     end.
     1204     else
     1205     do:
     1206       for each buf_chk-doc no-lock
     1207         where buf_chk-doc.obj-code = obj-list.obj-code
     1208         and buf_chk-doc.obj-type = obj-list.obj-type
     1209         and buf_chk-doc.chk-type <> 8
     1210         and buf_chk-doc.chk-date >= x-Date-Start
     1211         and buf_chk-doc.chk-date <= x-Date-End
     1212         and buf_chk-doc.out-code <> ?:
     1213         run report .
     1214       end.
     1215     end.
     1216   end.
     1217   procedure report:
     1218     define variable vRecordType as integer   no-undo .
     1219     for each buf_chk-discnt-attr no-lock where buf_chk-discnt-attr.attr-code = "promo-id" and buf_chk-discnt-attr.doc-code = buf_chk-doc.doc-code:
     1220       if ChkGoodLine(buf_chk-discnt-attr.doc-code, buf_chk-discnt-attr.attr-value)
     1221       then
     1222       for first buf_chk-discnt no-lock where buf_chk-discnt.doc-code = buf_chk-discnt-attr.doc-code and buf_chk-discnt.record-type = 5
     1223         and buf_chk-discnt.discnt-id = buf_chk-discnt-attr.discnt-id:
     1224         find first tt-promo where
     1225                    tt-promo.obj-code = buf_chk-doc.obj-code and
     1226                    tt-promo.obj-type = buf_chk-doc.obj-type and
     1227                    tt-promo.promo-id = buf_chk-discnt-attr.attr-value and
     1228                    tt-promo.shift-date = buf_chk-doc.shift-date and
     1229                    tt-promo.shift-num = buf_chk-doc.shift-num
     1230         no-error .
     1231         if not available (tt-promo) then
     1232         do:
     1233           create tt-promo .
     1234           assign
     1235             tt-promo.obj-code   = buf_chk-doc.obj-code
     1236             tt-promo.obj-type   = buf_chk-doc.obj-type
     1237             tt-promo.promo-id   = buf_chk-discnt-attr.attr-value
     1238             tt-promo.shift-date = buf_chk-doc.shift-date
     1239             tt-promo.shift-num  = buf_chk-doc.shift-num
     1240             .
     1241           for first ub.clients no-lock where ub.clients.obj-code = tt-promo.obj-code and
     1242             ub.clients.obj-type = tt-promo.obj-type:
     1243             tt-promo.obj-name = ub.clients.obj-name .
     1244           end.
     1245           for first ub.PromoAction no-lock where ub.PromoAction.id = int64(tt-promo.promo-id):
     1246             tt-promo.promo-name = ub.PromoAction.nameAction .
     1247             tt-promo.methodCalc = ub.PromoAction.methodCalc .
     1248               find first ub.promoAttr where
     1249                 ub.promoAttr.attr-code = "charge-BL" and
     1250                 ub.promoAttr.tablename = "PromoPay" and
     1251                 ub.PromoAction.id = int64(entry(1,ub.PromoAttr.p-key,chr(3))) and
     1252                 ub.PromoAction.db-num = integer(entry(2,ub.PromoAttr.p-key,chr(3)))
     1253                 no-error.
     1254               if available (ub.PromoAttr) then do:
     1255                 if logical(ub.PromoAttr.attr-value) = true then tt-promo.change-BL = "да" .
     1256                 else tt-promo.change-BL = "нет" .
     1257               end.
     1258               else tt-promo.change-BL = "нет" .
     1259           end.
     1260         end.
     1261         assign
     1262           tt-promo.object-qnty = tt-promo.object-qnty + buf_chk-discnt.object-sum
     1263           .
     1264         if buf_chk-doc.chk-type = integer('6':U) or buf_chk-doc.chk-type = integer('96':U) then
     1265           tt-promo.return-qnty = tt-promo.return-qnty + buf_chk-discnt.object-sum .
     1266         if can-find(first bf_chk-discnt no-lock where
     1267                           bf_chk-discnt.doc-code =  buf_chk-doc.doc-code and
     1268                           bf_chk-discnt.record-type = 1 and
     1269                           bf_chk-discnt.promo-id = tt-promo.promo-id)
     1270         then vRecordType = 1.
     1271         else vRecordType = 0.
     1272         for each bf_chk-discnt no-lock where
     1273                  bf_chk-discnt.doc-code =  buf_chk-doc.doc-code and
     1274                  bf_chk-discnt.record-type = vRecordType and
     1275                  bf_chk-discnt.promo-id = tt-promo.promo-id,
     1276            first buf_chk-gds no-lock where
     1277                  buf_chk-gds.doc-code = bf_chk-discnt.doc-code and
     1278                  buf_chk-gds.line-num = bf_chk-discnt.object-line-num:
     1279               if not ChkPLLine(buf_chk-gds.doc-code, buf_chk-gds.line-num, tt-promo.promo-id)
     1280               then do:
     1281                   if tt-promo.methodCalc <> 6 then
     1282                   do:
     1283                     assign
     1284                       tt-promo.discount-sum = tt-promo.discount-sum + bf_chk-discnt.discnt-value-abs
     1285                       .
     1286                   end.
     1287                   assign
     1288                     tt-promo.goods-qnty = tt-promo.goods-qnty + buf_chk-gds.doc-qnty
     1289                     tt-promo.itog-sum   = tt-promo.itog-sum + buf_chk-gds.src-sum
     1290                     .
     1291               end.
     1292         end.
     1293         if tt-promo.goods-qnty > 0 or tt-promo.methodCalc = 6 then tt-promo.sale-qnty = tt-promo.object-qnty - (tt-promo.return-qnty * 2) .
     1294       end.
     1295     end.
     1296   end procedure .
     1297   run get-report-num (output p-report-id).
     1298   v-file-name-rep-htm = session:temp-directory + string(p-report-id) + ".html".
     1299   output stream OutStr-html to value(v-file-name-rep-htm) convert target 'UTF-8'.
     1300   put stream OutStr-html unformatted
     1301   "<!DOCTYPE HTML>" skip
     1302   ' <html>' skip
     1303   '  <head>' skip
     1304   '   <meta charset="utf-8">' skip
     1305   '    <style type="text/css">' skip
     1306   '      table ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     1307   '      .class1 ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     1308   '      tbody td, th ' + chr(123) + ' border-collapse: collapse; border: 1px solid black;' + chr(125) skip
     1309   '   </style>' skip
     1310   '  </head>' skip
     1311     .
     1312   put stream OutStr-html unformatted
     1313     '<body>' skip
     1314     '<TABLE name="1"  fit_to_page="true" orientation="portrait" CELLSPACING="0" BORDER="0">'skip
     1315     '<thead>' skip
     1316     .
     1317   put stream OutStr-html unformatted
     1318     '<tr class="set_columns">' skip
     1319     '<td style="width: 100px;"></td>' skip
     1320     '<td style="width: 80px;"></td>' skip
     1321     '<td style="width: 80px;"></td>' skip
     1322     '<td style="width: 150px;"></td>' skip
     1323     '<td style="width: 80px;"></td>' skip
     1324     '<td style="width: 80px;"></td>' skip
     1325     '<td style="width: 80px;"></td>' skip
     1326     '<td style="width: 80px;"></td>' skip
     1327     '<td style="width: 80px;"></td>' skip
     1328     '<td style="width: 80px;"></td>' skip
     1329     '<td style="width: 80px;"></td>' skip
     1330     '</tr>' skip
     1331     .
     1332   put stream OutStr-html unformatted
     1333     '<TR><TD colspan="11"></TD></TR>' skip
     1334     '<TR>' skip
     1335     '<TD colspan="11" style="font-weight: bold;">Отчет по реализации промоакций на СТ за период с ' + string(x-Date-Start,"99.99.99") + ' по ' + string(x-Date-End,"99.99.99") + '</TD>' skip
     1336     '</TR>'skip
     1337     '<TR>' skip
     1338     '<TD colspan="11">Выбор объекта:</TD>' skip
     1339     '</TR>'skip
     1340     '<TR>' skip
     1341     '<TD colspan="11">' + "АЗК №" + v-list-obj + " маг" + '</TD>' skip
     1342     '</TR>'skip
     1343     '</thead>' skip
     1344     '<tbody>' skip
     1345     .
     1346   put stream OutStr-html unformatted
     1347     '<TR>' skip
     1348     '<TD text_wrap="true" style="text-align: center; font-weight: bold; background-color: silver;">Дата смены</TD>' skip
     1349     '<TD text_wrap="true" style="text-align: center; font-weight: bold; background-color: silver;">№ смены</TD>' skip
     1350     '<TD text_wrap="true" style="text-align: center; font-weight: bold; background-color: silver;">№ промоакции</TD>' skip
     1351     '<TD text_wrap="true" style="text-align: center; font-weight: bold; background-color: silver;">Наименование промо-акции</TD>' skip
     1352     '<TD text_wrap="true" style="text-align: center; font-weight: bold; background-color: silver;">Кол-во срабатываний</TD>' skip
     1353     '<TD text_wrap="true" style="text-align: center; font-weight: bold; background-color: silver;">Кол-во продаж</TD>' skip
     1354     '<TD text_wrap="true" style="text-align: center; font-weight: bold; background-color: silver;">Кол-во возвратов</TD>' skip
     1355     '<TD text_wrap="true" style="text-align: center; font-weight: bold; background-color: silver;">Кол-во акционных товаров</TD>' skip
     1356     '<TD text_wrap="true" style="text-align: center; font-weight: bold; background-color: silver;">Сумма скидки</TD>' skip
     1357     '<TD text_wrap="true" style="text-align: center; font-weight: bold; background-color: silver;">Сумма без скидки</TD>' skip
     1358     '<TD text_wrap="true" style="text-align: center; font-weight: bold; background-color: silver;">Запрет начисления баллов лояльности</TD>' skip
     1359     '</TR>'skip
     1360     .
     1361   for each obj-list by obj-list.obj-code:
     1362     ii = 0 .
     1363     for each tt-promo where tt-promo.obj-code = obj-list.obj-code and tt-promo.obj-type = obj-list.obj-type:
     1364       if not can-find (first tt-promo-itog-obj where tt-promo-itog-obj.obj-code = tt-promo.obj-code and tt-promo-itog-obj.obj-type = tt-promo.obj-type) then
     1365       do:
     1366         if not p-itog then
     1367         do:
     1368           put stream OutStr-html unformatted
     1369             '<tr><TD colspan="11" text_wrap="true" style="text-align: left; font-weight: bold;">' + tt-promo.obj-name + '</TD></tr>' skip
     1370             .
     1371         end.
     1372         create tt-promo-itog-obj .
     1373         assign
     1374           tt-promo-itog-obj.obj-code   = tt-promo.obj-code
     1375           tt-promo-itog-obj.obj-type   = tt-promo.obj-type
     1376           tt-promo-itog-obj.obj-name   = tt-promo.obj-name
     1377           tt-promo-itog-obj.promo-id   = tt-promo.promo-id
     1378           tt-promo-itog-obj.promo-name = tt-promo.promo-name
     1379           .
     1380         ii = 1 .
     1381       end.
     1382       if not p-itog then
     1383       do:
     1384         put stream OutStr-html unformatted
     1385           '<TR>' skip
     1386           '<TD text_wrap="true" style="text-align: center;">' + if tt-promo.shift-date <> ? then string(tt-promo.shift-date,"99.99.9999") + '</TD>' else " "  + '</TD>' skip
     1387           '<TD text_wrap="true" style="text-align: center;">' + if tt-promo.shift-num <> 0 then string(tt-promo.shift-num) + '</TD>' else " "  + '</TD>' skip
     1388           '<TD text_wrap="true" style="text-align: center;">' + string(tt-promo.promo-id) + '</TD>' skip
     1389           '<TD text_wrap="true" style="text-align: center;">' + string(tt-promo.promo-name) + '</TD>' skip
     1390           '<TD text_wrap="true" style="text-align: right;">' + if tt-promo.object-qnty <> 0 then fnc-convert-dot-to-colon(tt-promo.object-qnty,"->>>>>>>>>>>9",0) + '</TD>' else "0" + '</TD>' skip
     1391           '<TD text_wrap="true" style="text-align: right;">' + if tt-promo.sale-qnty <> 0 then fnc-convert-dot-to-colon(tt-promo.sale-qnty,"->>>>>>>>>>>9",0) + '</TD>' else "0" + '</TD>' skip
     1392           '<TD text_wrap="true" style="text-align: right;">' + if tt-promo.return-qnty <> 0 then fnc-convert-dot-to-colon(tt-promo.return-qnty,"->>>>>>>>>>>9",0) + '</TD>' else "0" + '</TD>' skip
     1393           '<TD text_wrap="true" style="text-align: right;">' + if tt-promo.goods-qnty <> 0 then fnc-convert-dot-to-colon(tt-promo.goods-qnty,"->>>>>>>>>>>9",0) + '</TD>' else "0" + '</TD>' skip
     1394           '<TD text_wrap="true" style="text-align: right;">' + if tt-promo.discount-sum <> 0 then fnc-convert-dot-to-colon(tt-promo.discount-sum,"->>>>>>>>>>>9.99",2) + '</TD>' else "0.00" + '</TD>' skip
     1395           '<TD text_wrap="true" style="text-align: right;">' + if tt-promo.itog-sum <> 0 then fnc-convert-dot-to-colon(tt-promo.itog-sum,"->>>>>>>>>>>9.99",2) + '</TD>' else "0.00" + '</TD>' skip
     1396           '<TD text_wrap="true" style="text-align: center;">' + tt-promo.change-BL + '</TD>' skip
     1397           '</TR>' skip.
     1398       end.
     1399       find first tt-promo-itog-obj where tt-promo-itog-obj.obj-code = tt-promo.obj-code and
     1400         tt-promo-itog-obj.obj-type = tt-promo.obj-type and
     1401         tt-promo-itog-obj.obj-name = tt-promo.obj-name and
     1402         tt-promo-itog-obj.promo-id = tt-promo.promo-id and
