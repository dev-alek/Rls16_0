     1536     return .
     1537   end.
     1538   procedure clients-write:
     1539     DEFINE input PARAMETER   p-obj-code      as integer      no-undo .
     1540     DEFINE INPUT PARAMETER   p-obj-type      as character    no-undo .
     1541     DEFINE OUTPUT PARAMETER  p-obj-name      as character    no-undo .
     1542     define buffer buf_clients for ub.clients .
     1543     find first buf_clients no-lock where buf_clients.obj-code = p-obj-code
     1544       and buf_clients.obj-type = p-obj-type no-error .
     1545     if AVAILABLE buf_clients then
     1546     do:
     1547       p-obj-name = buf_clients.obj-name .
     1548     end.
     1549   end.
     1550   procedure ConvertStr-chk-type:
     1551     define input parameter p-chk-type as character no-undo.
     1552     define output parameter p-name-chk-type as character no-undo.
     1553     define variable v-num-element as integer no-undo.
     1554     v-num-element = lookup(p-chk-type, '1,6,8,69,96,14,15,16,36,17,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,43,44':U).
     1555     p-name-chk-type = entry(v-num-element, 'Продажа,Возврат,Аннуляция,Списание,ВзврСпис,СбросТрнзкц,Перелив,ПеревТрнзкц,РазблТрнзкц,ТехПролив,Инвентаризация,Z-отчет,Закрытие_смены,Открытие_смены,_Продажа,_Возврат,_Аннуляция,_Списание,_ВзврСпис,_СбросТрнзкц,_Перелив,_ПеревТрнзкц,_ТехПролив,_Инвентаризация,_Z-отчет,_РазблТрнзкц,_Закрытие_смены,>Продажа,>Возврат,>Аннуляция,>>Продажа,>>Возврат,Приход_Корр,Расход_Корр':U).
     1556     if p-chk-type <> "" and v-num-element = 0 then
     1557     do:
     1558       message "Ошибка 115." view-as alert-box.
     1559       return.
     1560     end.
     1561   end procedure.
     1562   procedure ConvertStr-pay-type:
     1563     define input parameter p-pay-code as integer no-undo.
     1564     define output parameter p-name-pay-type as character no-undo.
     1565     find first ub.cash-pay no-lock where ub.cash-pay.cdpay-code = p-pay-code and ub.cash-pay.status_ = 'тек':U no-error .
     1566     if available (ub.cash-pay) then p-name-pay-type = ub.cash-pay.obj-name .
     1567   end procedure.
     1568   PROCEDURE get-report-num :
     1569     define output parameter p-report-num as integer no-undo .
     1570     do
     1571       on error undo, return error return-value
     1572       :
     1573       run gbl/getrpnum.p (output p-report-num).
     1574     end.
     1575   END PROCEDURE.
