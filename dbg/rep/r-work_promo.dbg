      576   procedure cur-time :
      577      define output parameter p-today as date      no-undo .
      578      define output parameter p-time  as integer   no-undo .
      579     do
      580     on error undo, return error
      581     :
      582       define variable v-date1 as date      no-undo .
      583       define variable v-date2 as date      no-undo .
      584       define variable v-time  as integer   no-undo .
      585       assign
      586         v-date1 = today
      587         v-time  = time
      588         v-date2 = today
      589       .
      590       if v-date1 <> v-date2
      591       then do:
      592         assign
      593           v-date1 = today
      594           v-time  = v-time
      595         .
      596       end.
      597       assign
      598         p-today = v-date1
      599         p-time  = v-time
      600       .
      601     end.
      602   end.
      603   function cur-time-date returns character
      604   :
      605     return string(today, '99/99/9999':U) .
      606   end.
      607   function cur-time-mjd returns decimal
      608   :
      609     define variable v-date as date      no-undo .
      610     define variable v-time as integer   no-undo .
      611     run cur-time in this-procedure
      612       (output v-date
      613       ,output v-time
      614       ) .
      615     return integer(v-date) - 2400002 + (v-time / 86400) .
      616   end.
      617   function cur-time-get-ending-index returns integer
      618   (input p-number as integer
      619   )
      620   :
      621     if p-number < 0
      622     or p-number = ?
      623     then do:
      624       return 1 .
      625     end.
      626     define variable v-rest as integer   no-undo .
      627     assign
      628       p-number = p-number modulo 100
      629     .
      630     if p-number < 20
      631     then do:
      632       assign
      633         v-rest = p-number
      634       .
      635     end.
      636     else do:
      637       assign
      638         v-rest = p-number modulo 10
      639       .
      640     end.
      641     case v-rest :
      642       when 1
      643       then do:
      644         return 2 .
      645       end.
      646       when 2 or
      647       when 3 or
      648       when 4
      649       then do:
      650         return 3 .
      651       end.
      652       otherwise do:
      653         return 1 .
      654       end.
      655     end case .
      656   end.
      657   procedure cur-time-mjd-to-date :
      658      define input  parameter i-mjd-diff as decimal no-undo.
      659      define output parameter o-Date     as date    no-undo.
      660      define output parameter o-Time     as integer no-undo.
      661      define variable v-day-number as integer   no-undo .
      662      if    i-mjd-diff < 0
      663         or i-mjd-diff = ?
      664      then do:
      665         return "?" .
      666      end.
      667      assign
      668         v-day-number = truncate(i-mjd-diff,0).
      669         o-Date = date(v-day-number + 2400002).
      670         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      671     .
      672   end.
      673   function cur-time-mjd-to-string returns character
      674   (input p-mjd-diff as decimal
      675   )
      676   :
      677     define variable v-day-number as integer   no-undo .
      678     define variable v-seconds    as integer   no-undo .
      679     define variable v-hour       as integer   no-undo .
      680     define variable v-min        as integer   no-undo .
      681     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      682     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      683     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      684     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      685     if p-mjd-diff < 0
      686     or p-mjd-diff = ?
      687     then do:
      688       return "?" .
      689     end.
      690     assign
      691       v-day-number = integer(truncate(p-mjd-diff,0))
      692       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      693     .
      694     if v-seconds > 86400
      695     then do:
      696       assign
      697         v-seconds = 86400 - 1
      698       .
      699     end.
      700     if v-seconds < 0
      701     then do:
      702       assign
      703         v-seconds = 0
      704       .
      705     end.
      706     assign
      707       v-hour = truncate(v-seconds / 3600, 0)
      708     .
      709     assign
      710       v-seconds = v-seconds modulo 3600
      711     .
      712     assign
      713       v-min = truncate(v-seconds / 60, 0)
      714     .
      715     assign
      716       v-seconds = v-seconds modulo 60
      717     .
      718     return
      719         (if v-day-number <> 0
      720           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      721           else ""
      722         )
      723       + (if v-day-number <> 0 or v-hour <> 0
      724           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      725           else ""
      726         )
      727       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      728           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      729           else ""
      730         )
      731       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      732       .
      733   end.
      734   function cur-time-string returns character
      735   :
      736     define variable v-date as date      no-undo .
      737     define variable v-time as integer   no-undo .
      738     run cur-time in this-procedure
      739       (output v-date
      740       ,output v-time
      741       ) .
      742     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      743   end.
      744   function cur-time-string-sec returns character
      745   :
      746     define variable v-date as date      no-undo .
      747     define variable v-time as integer   no-undo .
      748     run cur-time in this-procedure
      749       (output v-date
      750       ,output v-time
      751       ) .
      752     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      753   end.
      754   function cur-time-custom  returns character
      755   (input p-prefix as character
      756   ,input p-date-format as character
      757   ,input p-delimiter as character
      758   ,input p-time-format as character
      759   ,input p-suffix as character
      760   )
      761   :
      762     define variable v-date as date      no-undo .
      763     define variable v-time as integer   no-undo .
      764     run cur-time in this-procedure
      765       (output v-date
      766       ,output v-time
      767       ) .
      768     return
      769       p-prefix
      770       + string(v-date, p-date-format)
      771       + p-delimiter
      772       + string(v-time, p-time-format)
      773       + p-suffix
      774       .
      775   end.
      776   function cur-time-print  returns character
      777   :
      778     define variable v-date as date      no-undo .
      779     define variable v-time as integer   no-undo .
      780     run cur-time in this-procedure
      781       (output v-date
      782       ,output v-time
      783       ) .
      784     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      785   end.
      786   function cur-time-datetime returns datetime
      787   :
      788     define variable v-char as character no-undo .
      789     define variable v-datetime as datetime no-undo .
      790     v-char = cur-time-string().
      791     v-datetime = datetime(v-char).
      792     return  v-datetime.
      793   end.
      794   function cur-time-string-msec returns character
      795   :
      796     define variable v-date as datetime  no-undo .
      797     v-date = now.
      798     return string(v-date) .
      799   end.
      800   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      801   define  stream PrnLibStream.
      802   procedure prn-lib-prn-file :
      803     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      804     define input parameter p-DIsabledoptions as integer no-undo .
      805     define variable v-report-name as character no-undo .
      806     define variable v-user-action as character no-undo .
      807     define variable v-printed     as logical   no-undo .
      808     define variable v-exist       as logical   no-undo .
      809     do
      810       on error undo, return error
      811       :
      812       run prn-lib-get-report-name  in this-procedure (
      813         input parParentProc
      814         ,output v-report-name
      815         ).
      816   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      817   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      818     (input  v-report-name
      819     ,input  2
      820     ,output v-exist
      821     )  .
      822       if NOT v-exist then
      823       DO:
      824         Message
      825           "Нет заданий на печать ! "
      826           view-as alert-box .
      827         Return  .
      828       End.
      829       run gbl/prnfilen.w
      830         (input  ""
      831         ,input  p-DisabledOptions
      832         ,input  string(v-report-name )
      833         ,input  7
      834         ,output v-user-action
      835         ,output v-printed
      836         ) .
      837       if v-printed then
      838       do:
      839         return "YES" .
      840       end.
      841       else
      842       do:
      843         return "NO" .
      844       end.
      845     end.
      846   end procedure.
      847   procedure prn-lib-open-stream :
      848     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      849     define input parameter p-page-size    as integer no-undo .
      850     define input parameter p-is-stream    as logical no-undo .
      851     define input parameter p-append       as logical no-undo .
      852     define variable v-report-name as character no-undo .
      853     do
      854       on error undo, return error
      855       :
      856       run prn-lib-get-report-name  in this-procedure (
      857         input parParentProc
      858         ,output v-report-name
      859         ).
      860       if p-is-stream then
      861       do:
      862         if p-append then
      863         do:
      864           output stream PrnLibStream to value( v-report-name )
      865             page-size value(p-page-size) append .
      866         end.
      867         if not p-append then
      868         do:
      869           output stream PrnLibStream to value( v-report-name )
      870             page-size value(p-page-size) .
      871         end.
      872       end.
      873       if not p-is-stream then
      874       do:
      875         if p-append then
      876         do:
      877           output to value( v-report-name )
      878             page-size value(p-page-size) append .
      879         end.
      880         if not p-append then
      881         do:
      882           output to value( v-report-name )
      883             page-size value(p-page-size) .
      884         end.
      885       end.
      886     end.
      887   end procedure.
      888   procedure prn-lib-open-exp :
      889     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      890     define input parameter p-is-stream    as logical no-undo .
      891     define input parameter p-is-append    as logical no-undo .
      892     define output parameter p-ReportFileName as char init "report" no-undo.
      893     define output parameter p-process as logical no-undo .
      894     define variable glog as logical no-undo .
      895     do
      896       on error undo, return error
      897       :
      898       SYSTEM-DIALOG GET-FILE p-ReportFileName
      899         TITLE      "Укажите путь"
      900         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      901         ASK-OVERWRITE
      902         CREATE-TEST-FILE
      903         SAVE-AS
      904         USE-FILENAME
      905         DEFAULT-EXTENSION "txt"
      906         UPDATE glog
      907         .
      908       if not glog then  return.
      909       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      910       if p-is-stream then
      911       do:
      912         if p-is-append then
      913         do:
      914           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      915         end.
      916         else
      917         do:
      918           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      919         end.
      920       end.
      921       else
      922       do:
      923         if p-is-append then
      924         do:
      925           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      926         end.
      927         else
      928         do:
      929           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      930         end.
      931       end.
      932       p-process = yes.
      933     end.
      934   end procedure.
      935   procedure prn-lib-get-report-name :
      936     define input parameter parParentProc  as widget-handle no-undo.
      937     define output parameter p-report-name as character no-undo .
      938     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      939   end procedure.
      940   procedure prn-lib-reportviewer-report-name :
      941     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      942     define input parameter p-report-name-html as character no-undo .
      943     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      944   end procedure.
      945   procedure prn-lib-reportviewer :
      946     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      947     define input parameter p-report-name-html as character no-undo .
      948     define input parameter p-param        as character no-undo .
      949     define variable v-excel           as character no-undo init 'TRUE' .
      950     define variable v-value-character as character no-undo .
      951     define variable v-value-integer   as character no-undo .
      952     define variable v-value-date      as date      no-undo .
      953     define variable v-value-decimal   as decimal   no-undo .
      954     define variable rep-excel         as logical   no-undo .
      955     define variable excel-string      as character no-undo .
      956     define variable v-param-type      as character no-undo .
      957     define variable v-tth             as handle    no-undo .
      958     run adm/shattri.p (
      959       input "get":U
      960       ,input  ""
      961       ,input  0
      962       ,input  'report-glob':U
      963       ,input  'rep-excel':U
      964       ,output v-value-character
      965       ,output v-value-date
      966       ,output v-value-decimal
      967       ,output v-value-integer
      968       ,output rep-excel
      969       ,output v-param-type
      970       ,INPUT-OUTPUT table-handle v-tth
      971       )  .
      972     if rep-excel then v-excel = "TRUE" .
      973     else v-excel = "FALSE" .
      974     if p-param eq ""
      975     then
      976        p-param = "EXCEL:" + v-excel.
      977     else
      978        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      979     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      980   end procedure.
      981   function fnc-convert-dot-to-colon returns character
      982       (input p-data as decimal, input p-accur as character, input p-num as integer) forward.
      983   function fnc-convert-dot-to-colon returns character
      984   (input p-data as decimal, input p-accur as character, input p-num as integer):
      985       define variable result as character no-undo.
      986       define variable v-str-result as character no-undo.
      987       if p-data = ? then p-data = 0 .
      988       p-data = round(p-data, p-num).
      989       v-str-result = trim(replace(string(p-data, p-accur), ".", ",")).
      990       return v-str-result.
      991   END FUNCTION.
