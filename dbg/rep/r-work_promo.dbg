     1500         '<TD text_wrap="true" style="text-align: right; font-weight: bold;">' + if tt-promo-itog.discount-sum <> 0 then fnc-convert-dot-to-colon(tt-promo-itog.discount-sum,"->>>>>>>>>>>9.99",2) + '</TD>' else "0.00" + '</TD>' skip
     1501         '<TD text_wrap="true" style="text-align: right; font-weight: bold;">' + if tt-promo-itog.itog-sum <> 0 then fnc-convert-dot-to-colon(tt-promo-itog.itog-sum,"->>>>>>>>>>>9.99",2) + '</TD>' else "0.00" + '</TD>' skip
