     1474       assign
     1475         tt-promo-itog.discount-sum = tt-promo-itog.discount-sum + tt-promo-itog-obj.discount-sum
     1476         tt-promo-itog.goods-qnty   = tt-promo-itog.goods-qnty + tt-promo-itog-obj.goods-qnty
     1477         tt-promo-itog.itog-sum     = tt-promo-itog.itog-sum + tt-promo-itog-obj.itog-sum
     1478         tt-promo-itog.object-qnty  = tt-promo-itog.object-qnty + tt-promo-itog-obj.object-qnty
     1479         tt-promo-itog.return-qnty  = tt-promo-itog.return-qnty + tt-promo-itog-obj.return-qnty
     1480         tt-promo-itog.sale-qnty    = tt-promo-itog.sale-qnty + tt-promo-itog-obj.sale-qnty
     1481         tt-promo-itog.change-BL = tt-promo-itog-obj.change-BL
     1482         .
     1483     end.
     1484   end.
     1485   v-first = true .
