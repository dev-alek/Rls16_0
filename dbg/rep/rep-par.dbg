      246   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      247   define variable v-waitfram-action01         as character   no-undo .
      248   define variable v-waitfram-action02         as character   no-undo .
      249   define variable v-waitfram-action03         as character   no-undo .
      250   define variable mWaitFramTextBeg            as character   no-undo.
      251   define variable mWaitFramTextEnd            as character   no-undo.
      252   define variable mWaitFramView               as logical     no-undo.
      253   define variable mWaitProcEvent              as logical     no-undo init yes.
      254   define variable mWaitFramInterval           as integer     no-undo init 1 .
      255   define variable mWaitFramStop               as logical     no-undo.
      256   define variable mWaitFramStopUser           as logical     no-undo.
      257   define variable mWaitFramStopTimeOut        as logical     no-undo.
      258   define variable mWaitFramStartProc          as datetime-tz no-undo.
      259   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      260   define button B-WaitFramStop auto-end-key
      261        label "Стоп"
      262        size 10 by 1 tooltip "Остоновить процесс".
      263   define button B-viewProcInfo
      264        label "Информация"
      265        size 15 by 1 tooltip "Информация о процесс".
      266   define frame waitfram
      267     v-waitfram-action01 format "x(72)" no-label skip
      268     v-waitfram-action02 format "x(72)" no-label skip
      269     v-waitfram-action03 format "x(72)" no-label skip
      270     B-viewProcInfo
      271     B-WaitFramStop at row 4 col 30
      272     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      273     .
      274   define new global shared variable mBatchMode as logical no-undo init ?.
      275   define variable mFramBachModHandle as handle no-undo.
      276   mFramBachModHandle = frame waitfram:handle.
      277   define variable mFameOldVis as logical no-undo.
      278   define variable mVisCUrentVin as logical no-undo.
      279   if session:batch-mode
      280   then
      281      mBatchMode = yes.
      282   if mBatchMode = ? then do:
      283     mVisCUrentVin = current-window:visible.
      284     mFameOldVis = mFramBachModHandle:visible.
      285     mFramBachModHandle:visible  = yes.
      286     mBatchMode = mFramBachModHandle:visible ne yes.
      287     mFramBachModHandle:visible = mFameOldVis.
      288     current-window:visible = mVisCUrentVin.
      289   end.
      290    if  log-manager:logfile-name ne ?
      291     then DO:
      292         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      293         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      294         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      295     end.
      296   on choose of B-WaitFramStop in frame waitfram
      297   do:
      298     mWaitFramStop = yes.
      299     mWaitFramStopUser = yes.
      300   end.
      301   function waitfram-check-timeout returns logical():
      302      define variable vtime as int64 no-undo.
      303      if mWaitFramStopTimeOut
      304      then
      305         return yes.
      306      vtime = ( now - mWaitFramStartProc ) / 1000 .
      307      if     mWaitFramTimeOut ne ?
      308         and mWaitFramTimeOut ne 0
      309         and mWaitFramTimeOut lt vtime
      310      then do:
      311         mWaitFramStopTimeOut = yes.
      312      end.
      313      return mWaitFramStopTimeOut.
      314   end.
      315   procedure waitfram-hide :
      316     if not session:batch-mode
      317     then do
      318     on error undo, return error return-value
      319     :
      320       pause 0 before-hide .
      321       if not mBatchMode then
      322         hide frame waitfram .
      323     if     not mWaitFramView
      324        and mWaitProcEvent
      325     then
      326       process events .
      327     end.
      328   end procedure.
      329   procedure waitfram-show :
      330     define input  parameter p-message as character no-undo .
      331     define variable v-left-margin as integer   no-undo .
      332     if not session:batch-mode
      333     then do
      334     on error undo, return error return-value
      335     :
      336       if length(p-message) <= 70 then do:
      337         assign
      338           v-left-margin = integer((70 - length(p-message)) / 2)
      339         .
      340         assign
      341           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      342         .
      343         assign
      344           v-waitfram-action01 = " "
      345           v-waitfram-action02 = " "
      346                                    + fill(" ", v-left-margin)
      347                                    + p-message
      348           v-waitfram-action03 = " "
      349         .
      350       end.
      351       else do:
      352         define variable vRindex1 as integer no-undo.
      353         define variable vRindex2 as integer no-undo.
      354         vRindex1 = r-index(p-message," ",70).
      355         if vRindex1 = 0
      356         then
      357            vRindex1 = 70.
      358         if length(p-message)  <= vRindex1 + 70 then do:
      359           assign
      360             v-waitfram-action01 = " "
      361             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      362             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      363           .
      364         end.
      365         else do:
      366           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      367           if vRindex2 <= vRindex1
      368           then
      369              vRindex2 = vRindex1 + 70.
      370           assign
      371             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      372             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      373             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      374           .
      375         end.
      376       end.
      377       B-viewProcInfo:visible   in frame waitfram = no.
      378       B-viewProcInfo:sensitive in frame waitfram = no.
      379       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      380       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      381       if  (   mWaitFramView
      382          or  mWaitProcEvent)
      383          and not mBatchMode
      384       then
      385          display
      386             v-waitfram-action01 skip
      387             v-waitfram-action02 skip
      388             v-waitfram-action03 skip
      389          with frame waitfram .
      390       if     mWaitFramView
      391          then do:
      392             if     mWaitFramInterval ne ?
      393                and not mBatchMode
      394             then
      395                wait-for go of frame waitfram pause mWaitFramInterval.
      396          end.
      397          else
      398             if     mWaitProcEvent
      399                and not mBatchMode
      400             then
      401                process events .
      402     end.
      403   end procedure.
      404      procedure waitfram-show-this:
      405         define input  parameter iInterval as int64 no-undo.
      406         define variable vtime as int64 no-undo.
      407         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      408         mWaitFramInterval = iInterval.
      409         run waitfram-show (substitute("&1&2 &3&4" ,
      410                                       mWaitFramTextBeg ,
      411                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      412                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      413                                       mWaitFramTextEnd
      414                                      )
      415                           ).
      416      end.
      417      procedure WaitFramRunPause:
      418         define input  parameter iInterval as dec no-undo.
      419         define variable vStart  as datetime-tz no-undo.
      420         define variable vend    as datetime-tz no-undo.
      421         define variable vint as int64 no-undo.
      422         define variable vOk as logical no-undo.
      423         vStart = now.
      424         vend   = vStart.
      425         publish "WaitFramPause" (iInterval,output vOk).
      426         vend   =  now.
      427         vint = vend - vStart.
      428         vint = iInterval - vint / 1000.
      429         if     not mWaitFramStop
      430            and (   vint > 0
      431                 or (    not vOk
      432                     and iInterval eq ?
      433                     )
      434                 )
      435         then
      436            run waitfram-show-this (iInterval).
      437         vend   =  now.
      438         vint = vend - vStart.
      439         vint = iInterval - vint / 1000.
      440         if     not mWaitFramStop
      441            and vint > 0
      442         then do:
      443            run gbl/pause.p (vint * 1000).
      444         end.
      445         if iInterval ne ?
      446         then
      447            publish "WaitFramStop".
      448         waitfram-check-timeout().
      449      end.
      450      procedure WaitFramWaitFor:
      451         define input  parameter iInterval as dec no-undo.
      452         assign
      453            mWaitFramStartProc   = now
      454            mWaitFramStopUser    = no
      455            mWaitFramStopTimeOut = no
      456         .
      457         block-wait:
      458         do while not mWaitFramStop:
      459            run WaitFramRunPause (iInterval).
      460            if  waitfram-check-timeout()
      461            then do:
      462               leave block-wait.
      463            end.
      464         end.
      465         run waitfram-hide.
      466      end.
      467   procedure waitfram-join :
      468     define input  parameter p-line-1  as character no-undo .
      469     define input  parameter p-line-2  as character no-undo .
      470     define input  parameter p-line-3  as character no-undo .
      471     define output parameter p-message as character no-undo .
      472     do
      473     on error undo, return error return-value
      474     :
      475       assign
      476         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      477                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      478                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      479       .
      480     end.
      481   end procedure.
      482   function waitfram-join-function returns character
      483     (input p-line-1 as character
      484     ,input p-line-2 as character
      485     ,input p-line-3 as character
      486     ).
      487     define variable v-message as character no-undo .
      488     run waitfram-join in this-procedure
      489       (input  p-line-1
      490       ,input  p-line-2
      491       ,input  p-line-3
      492       ,output v-message
      493       ) .
      494     return v-message .
      495   end function .
      496   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      497     define variable v-cntxt-db-num        as integer   no-undo .
      498     define variable v-cntxt-userid        as character no-undo .
      499     define variable v-cntxt-level         as character no-undo .
      500     define variable v-cntxt-host-code-obj as integer   no-undo .
      501     define variable v-cntxt-obj-type      as character no-undo .
      502     define variable v-cntxt-obj-code      as integer   no-undo .
      503     define variable v-cntxt-db-num-obj    as integer   no-undo .
      504     define variable v-cntxt-is-admin      as logical   no-undo .
      505   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      506     run mainmenu_getcntxt in parparentproc
      507       (output v-cntxt-db-num
      508       ,output v-cntxt-userid
      509       ,output v-cntxt-level
      510       ,output v-cntxt-host-code-obj
      511       ,output v-cntxt-obj-type
      512       ,output v-cntxt-obj-code
      513       ,output v-cntxt-db-num-obj
      514       ,output v-cntxt-is-admin
      515       ) .
      516   define variable base-type as character no-undo .
      517   define variable base-code as integer   no-undo .
      518   define variable g#report-num as integer   no-undo .
      519   define buffer buf_rep_currency for ub.currency.
      520   define variable v-cntxt-host-name-obj as character no-undo .
      521   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      522   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostname in g#library
      523     (input  v-cntxt-obj-type
      524     ,input  v-cntxt-obj-code
      525     ,output v-cntxt-host-code-obj
      526     ,output v-cntxt-host-name-obj
      527     )  .
      528   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      529   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
      530     (input  v-cntxt-host-code-obj
      531     ,output base-code
      532     )  .
      533   find first buf_rep_currency no-lock
      534     where buf_rep_currency.curr-code = base-code
      535     no-error .
      536     if available buf_rep_currency then base-type = buf_rep_currency.curr-abbr .
      537                  else base-type = "б.в." .
      538   run get-report-num  in parParentProc ( output g#report-num ).
      539   define buffer t-doc for ub.trn-doc  .
      540   define variable l as logical   no-undo .
      541   def var v-ind           as integer   no-undo .
      542   def var Log-Res1         as logical   no-undo .
      543   def var Log-Res2         as logical   no-undo .
      544   def buffer object for ub.clients .
      545   define variable v-continue as logical   no-undo .
      546   assign
      547     v-continue = true
      548   .
      549   DEFINE BUTTON b-help
      550        LABEL "&Помощь":L
      551        SIZE 10 BY 1
      552        BGCOLOR 8 .
      553   DEFINE BUTTON Btn_Cancel AUTO-END-KEY
      554        LABEL "В&ыход":L
      555        SIZE 12 BY 1
      556        BGCOLOR 8 .
      557   DEFINE BUTTON Btn_OK
      558        LABEL "&Выполнить ":L
      559        SIZE 12 BY 1
      560        BGCOLOR 8 .
      561   DEFINE VARIABLE RubText AS CHARACTER FORMAT "X(256)":U INITIAL ":"
      562         VIEW-AS TEXT
      563        SIZE 12.88 BY .83
      564        FGCOLOR 4  NO-UNDO.
      565   DEFINE VARIABLE SumText AS CHARACTER FORMAT "X(256)":U INITIAL "Суммы"
      566         VIEW-AS TEXT
      567        SIZE 7.88 BY .83 NO-UNDO.
      568   DEFINE VARIABLE ValText AS CHARACTER FORMAT "X(256)":U INITIAL "ВАЛЮТНЫЕ :"
      569         VIEW-AS TEXT
      570        SIZE 12.88 BY .83
      571        FGCOLOR 4  NO-UNDO.
      572   DEFINE IMAGE IMAGE-1
      573        FILENAME "cmp/blank":U
      574        SIZE 36.38 BY 11.29.
      575   DEFINE VARIABLE Discnt-PC AS LOGICAL INITIAL no
      576        LABEL "Процент скидки"
      577        VIEW-AS TOGGLE-BOX
      578        SIZE 22.13 BY .75 NO-UNDO.
      579   DEFINE VARIABLE IspName AS LOGICAL INITIAL no
      580        LABEL "Исполнитель"
      581        VIEW-AS TOGGLE-BOX
      582        SIZE 21.63 BY .75 NO-UNDO.
      583   DEFINE VARIABLE Kladov AS LOGICAL INITIAL no
      584        LABEL "Кладовщик"
      585        VIEW-AS TOGGLE-BOX
      586        SIZE 14.63 BY .75 NO-UNDO.
      587   DEFINE VARIABLE Kurs AS LOGICAL INITIAL no
      588        LABEL "Курс"
      589        VIEW-AS TOGGLE-BOX
      590        SIZE 8.63 BY .75 NO-UNDO.
      591   DEFINE VARIABLE NDS-Rubl AS LOGICAL INITIAL no
      592        LABEL "НДС"
      593        VIEW-AS TOGGLE-BOX
      594        SIZE 8.63 BY .75 NO-UNDO.
      595   DEFINE VARIABLE NDS-Val AS LOGICAL INITIAL no
      596        LABEL "НДС"
      597        VIEW-AS TOGGLE-BOX
      598        SIZE 8 BY .75 NO-UNDO.
      599   DEFINE VARIABLE Nums AS LOGICAL INITIAL no
      600        LABEL "Количество"
      601        VIEW-AS TOGGLE-BOX
      602        SIZE 16.38 BY .75 NO-UNDO.
      603   DEFINE VARIABLE Nums-doc AS LOGICAL INITIAL no
      604        LABEL "Количество (док)"
      605        VIEW-AS TOGGLE-BOX
      606        SIZE 21.5 BY .75 NO-UNDO.
      607   DEFINE VARIABLE Operator AS LOGICAL INITIAL no
      608        LABEL "Оператор"
      609        VIEW-AS TOGGLE-BOX
      610        SIZE 13 BY .75 NO-UNDO.
      611   DEFINE VARIABLE Our-Obj AS LOGICAL INITIAL no
      612        LABEL "Название своего объекта"
      613        VIEW-AS TOGGLE-BOX
      614        SIZE 29.25 BY .75 NO-UNDO.
      615   DEFINE VARIABLE PayType AS LOGICAL INITIAL no
      616        LABEL "Вид оплаты"
      617        VIEW-AS TOGGLE-BOX
      618        SIZE 19.25 BY .75 NO-UNDO.
      619   DEFINE VARIABLE ps AS LOGICAL INITIAL no
      620        LABEL "Примечание"
      621        VIEW-AS TOGGLE-BOX
      622        SIZE 29.25 BY .75 NO-UNDO.
      623   DEFINE VARIABLE Rubl-BruttoSaleSum AS LOGICAL INITIAL no
      624        LABEL "Продажных цен ( без скидки )"
      625        VIEW-AS TOGGLE-BOX
      626        SIZE 32.13 BY .83 NO-UNDO.
      627   DEFINE VARIABLE Rubl-CostSum AS LOGICAL INITIAL no
      628        LABEL "Учетных цен"
      629        VIEW-AS TOGGLE-BOX
      630        SIZE 17.25 BY .75 NO-UNDO.
      631   DEFINE VARIABLE Rubl-crsa-doc AS LOGICAL INITIAL no
      632        LABEL "Продажных цен (док)"
      633        VIEW-AS TOGGLE-BOX
      634        SIZE 31.38 BY .75 NO-UNDO.
      635   DEFINE VARIABLE Rubl-DiscntSum AS LOGICAL INITIAL no
      636        LABEL "Скидок"
      637        VIEW-AS TOGGLE-BOX
      638        SIZE 10.63 BY .75 NO-UNDO.
      639   DEFINE VARIABLE Rubl-Effect AS LOGICAL INITIAL no
      640        LABEL "Эффективности"
      641        VIEW-AS TOGGLE-BOX
      642        SIZE 20.88 BY .75 NO-UNDO.
      643   DEFINE VARIABLE Rubl-NettoSaleSum AS LOGICAL INITIAL no
      644        LABEL "Продажных цен ( со скидкой )"
      645        VIEW-AS TOGGLE-BOX
      646        SIZE 31.38 BY .75 NO-UNDO.
      647   DEFINE VARIABLE tg-vat-base AS LOGICAL INITIAL no
      648        LABEL "по ставкам"
      649        VIEW-AS TOGGLE-BOX
      650        SIZE 13.5 BY .83 NO-UNDO.
      651   DEFINE VARIABLE tg-vat-rubl AS LOGICAL INITIAL no
      652        LABEL "по ставкам"
      653        VIEW-AS TOGGLE-BOX
      654        SIZE 13.5 BY .83 NO-UNDO.
      655   DEFINE VARIABLE TorgPred AS LOGICAL INITIAL no
      656        LABEL "Торговый представитель"
      657        VIEW-AS TOGGLE-BOX
      658        SIZE 27.13 BY .75 NO-UNDO.
      659   DEFINE VARIABLE Up-PC AS LOGICAL INITIAL no
      660        LABEL "Процент фактической наценки"
      661        VIEW-AS TOGGLE-BOX
      662        SIZE 33.63 BY .75 NO-UNDO.
      663   DEFINE VARIABLE v-sale-base AS LOGICAL INITIAL no
      664        LABEL "Цен документа"
      665        VIEW-AS TOGGLE-BOX
      666        SIZE 32.13 BY .83 NO-UNDO.
      667   DEFINE VARIABLE v-sale-base-doc AS LOGICAL INITIAL no
      668        LABEL "Учет.Цен (док)"
      669        VIEW-AS TOGGLE-BOX
      670        SIZE 32.13 BY .83 NO-UNDO.
      671   DEFINE VARIABLE v-sale-rubl AS LOGICAL INITIAL no
      672        LABEL "Цен документа"
      673        VIEW-AS TOGGLE-BOX
      674        SIZE 32.13 BY .83 NO-UNDO.
      675   DEFINE VARIABLE v-sale-rubl-doc AS LOGICAL INITIAL no
      676        LABEL "Учет.Цен (док)"
      677        VIEW-AS TOGGLE-BOX
      678        SIZE 32.13 BY .83 NO-UNDO.
      679   DEFINE VARIABLE Val-BruttoSaleSum AS LOGICAL INITIAL no
      680        LABEL "Продажных цен ( без скидки )"
      681        VIEW-AS TOGGLE-BOX
      682        SIZE 32.13 BY .83 NO-UNDO.
      683   DEFINE VARIABLE Val-CostSum AS LOGICAL INITIAL no
      684        LABEL "Учетных цен"
      685        VIEW-AS TOGGLE-BOX
      686        SIZE 18.63 BY .75 NO-UNDO.
      687   DEFINE VARIABLE Val-crsa-doc AS LOGICAL INITIAL no
      688        LABEL "Продажных цен (док)"
      689        VIEW-AS TOGGLE-BOX
      690        SIZE 31.38 BY .75 NO-UNDO.
      691   DEFINE VARIABLE Val-DiscntSum AS LOGICAL INITIAL no
      692        LABEL "Скидок"
      693        VIEW-AS TOGGLE-BOX
      694        SIZE 10.63 BY .75 NO-UNDO.
      695   DEFINE VARIABLE Val-Effect AS LOGICAL INITIAL no
      696        LABEL "Эффективности"
      697        VIEW-AS TOGGLE-BOX
      698        SIZE 20.75 BY .75 NO-UNDO.
      699   DEFINE VARIABLE Val-NettoSaleSum AS LOGICAL INITIAL yes
      700        LABEL "Продажных цен ( со скидкой )"
      701        VIEW-AS TOGGLE-BOX
      702        SIZE 31.38 BY .75 NO-UNDO.
      703   DEFINE FRAME DLGOKCAN
      704        Btn_Cancel AT ROW 1 COL 1
      705        Btn_OK AT ROW 1 COL 13
      706        b-help AT ROW 1 COL 66
      707        v-sale-base AT ROW 3.58 COL 4.5
      708        v-sale-rubl AT ROW 3.58 COL 40.63
      709        v-sale-base-doc AT ROW 4.38 COL 4.5
      710        v-sale-rubl-doc AT ROW 4.38 COL 40.63
      711        Val-BruttoSaleSum AT ROW 5.67 COL 4.5
      712        Rubl-BruttoSaleSum AT ROW 5.67 COL 40.88
      713        Val-NettoSaleSum AT ROW 6.5 COL 4.5
      714        Rubl-NettoSaleSum AT ROW 6.5 COL 40.88
      715        Val-crsa-doc AT ROW 7.29 COL 4.5
      716        Rubl-crsa-doc AT ROW 7.29 COL 41
      717        Val-DiscntSum AT ROW 8.79 COL 4.5
      718        Rubl-DiscntSum AT ROW 8.79 COL 40.88
      719        Val-CostSum AT ROW 9.58 COL 4.5
      720        Rubl-CostSum AT ROW 9.58 COL 40.88
      721        Val-Effect AT ROW 10.38 COL 4.5
      722        Rubl-Effect AT ROW 10.38 COL 40.88
      723        NDS-Val AT ROW 11.17 COL 4.5
      724        tg-vat-base AT ROW 11.17 COL 14
      725        NDS-Rubl AT ROW 11.17 COL 40.88
      726        tg-vat-rubl AT ROW 11.17 COL 58
      727        Discnt-PC AT ROW 13.21 COL 4.5
      728        TorgPred AT ROW 13.21 COL 41.13
      729        Up-PC AT ROW 14.13 COL 4.5
      730        Operator AT ROW 14.13 COL 41.13
      731        PayType AT ROW 15 COL 4.5
      732        Kladov AT ROW 15 COL 41.13
      733        Kurs AT ROW 15.88 COL 4.5
      734        IspName AT ROW 15.88 COL 41.13
      735        Our-Obj AT ROW 16.83 COL 41.13
      736        Nums AT ROW 17.17 COL 4.5
      737        ps AT ROW 17.75 COL 41
      738        Nums-doc AT ROW 18 COL 4.5
      739        ValText AT ROW 2.42 COL 14.75 COLON-ALIGNED NO-LABEL
      740        SumText AT ROW 2.42 COL 41.88 COLON-ALIGNED NO-LABEL
      741        RubText AT ROW 2.42 COL 51.13 COLON-ALIGNED NO-LABEL
      742        "Суммы" VIEW-AS TEXT
      743             SIZE 7 BY .83 AT ROW 2.42 COL 8.88
      744             FGCOLOR 0
      745        IMAGE-1 AT ROW 1.96 COL 39.63
      746        SPACE(0.11) SKIP(6.45)
      747       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      748            SIDE-LABELS THREE-D  SCROLLABLE
      749            BGCOLOR 8 FGCOLOR 0
      750            TITLE BGCOLOR 8 FGCOLOR 0 "Параметры отчета по документам":L
      751            DEFAULT-BUTTON Btn_OK CANCEL-BUTTON Btn_Cancel.
      752   ASSIGN
      753          FRAME DLGOKCAN:SCROLLABLE       = FALSE.
      754   ON CHOOSE OF Btn_Cancel IN FRAME DLGOKCAN
      755   DO:
      756       return "NO" .
      757   END.
      758   ON CHOOSE OF Btn_OK IN FRAME DLGOKCAN
      759   DO:
      760     def var CurrWidth as integer no-undo .
      761     def var var-frame-width as integer no-undo .
      762     assign
      763       ps
      764       Nums
      765       Nums-doc
      766       Val-BruttoSaleSum
      767       Rubl-BruttoSaleSum
      768       Val-NettoSaleSum
      769       Rubl-NettoSaleSum
      770       Val-DiscntSum
      771       Rubl-DiscntSum
      772       Val-CostSum
      773       Rubl-CostSum
      774       Val-Effect
      775       Rubl-Effect
      776       Discnt-PC
      777       TorgPred
      778       Up-PC
      779       Operator
      780       PayType
      781       Kladov
      782       Kurs
      783       Our-Obj
      784       IspName
      785       NDS-Val
      786       tg-vat-base
      787       NDS-Rubl
      788       tg-vat-rubl
      789       v-sale-base
      790       v-sale-rubl
      791       Rubl-crsa-doc
      792       Val-crsa-doc
      793       v-sale-base-doc
      794       v-sale-rubl-doc
      795     .
      796       run waitfram-show in this-procedure ( "Обработка документов" ) .
      797       if not can-find( first wt-docs ) then do:
      798           l = qh:get-first() .
      799           find  t-doc no-lock where rowid(t-doc) =  bh:rowid no-error .
      800           assign
      801             v-ind = 0
      802           .
      803           DO WHILE available t-doc :
      804               FIND ub.pay-type NO-LOCK
      805                 WHERE ub.pay-type.obj-code = t-doc.pay-code no-error
      806                 .
      807               FIND Object NO-LOCK
      808                 WHERE Object.obj-type = t-doc.obj-type
      809                   AND Object.obj-code = t-doc.obj-code
      810                 .
      811               CREATE wt-docs .
      812               BUFFER-COPY t-doc TO wt-docs.
      813               assign
      814                 wt-docs.doc-attr = ( substr( t-doc.doc-type, 1, 1 ) +
      815                                 substr( t-doc.status_ , 1, 1 ) +
      816                                 ( if t-doc.flag_    then "+" else "-" ) +
      817                                 ( if t-doc.internal     then "в" else " " ) )
      818                 wt-docs.pay-name = if not available ub.pay-type then string(t-doc.pay-code) else ub.pay-type.obj-name
      819                 wt-docs.pay-waitdate = wt-docs.fact-date
      820                 wt-docs.Oper_Name = t-doc.creid
      821                 wt-docs.OurObjectName = Object.obj-name
      822               .
      823               if base-code <> 0 then
      824                   wt-docs.Course = t-doc.base-rate / t-doc.base-scale .
      825               run rep/get-psn.p ( input t-doc.boss, output wt-docs.Mngr_Name) .
      826               run rep/get-psn.p ( input t-doc.wrkr, output wt-docs.Wrkr_name) .
      827               run rep/get-psn.p ( input t-doc.agnt, output wt-docs.Isp-Name ) .
      828               assign
      829                 v-ind = v-ind + 1
      830               .
      831               if ( v-ind modulo 10 ) = 0
      832               then do:
      833                  run waitfram-show in this-procedure( "Обработка документов : " + string( v-ind ) ) .
      834               end.
      835               if v-ind modulo 1000 = 0
      836               and v-continue <> ?
      837               then do:
      838                 message
      839                   "Уже распечатано строк" v-ind skip
      840                   "Вы желаете продолжить формирование отчета?" skip
      841                   "Yes"    chr(9) "Продолжить формирование отчета" skip
      842                   "No"     chr(9) "Прервать отчет" skip
      843                   "Cancel" chr(9) "Продолжить формирование отчета" skip
      844                   ""       chr(9) "и больше не показывать это сообщение" skip
      845                   view-as alert-box question buttons yes-no-cancel update v-continue .
      846                 if v-continue = false then do:
      847                   leave .
      848                 end.
      849               end.
      850               l = qh:get-next() .
      851               find  t-doc no-lock where rowid(t-doc) =  bh:rowid no-error .
      852           end.
      853       end.
      854       run waitfram-hide in this-procedure .
      855       run rep/docs-rep.p
      856         ( input "Отчет по документам. " + p-title
      857         , input v-sale-base
      858         , input v-sale-rubl
      859         , input Val-crsa-doc
      860         , input Rubl-crsa-doc
      861         , input v-sale-base-doc
      862         , input v-sale-rubl-doc
      863         , input Val-BruttoSaleSum
      864         , input Rubl-BruttoSaleSum
      865         , input Val-NettoSaleSum
      866         , input Rubl-NettoSaleSum
      867         , input Val-DiscntSum
      868         , input Rubl-DiscntSum
      869         , input Val-CostSum
      870         , input Rubl-CostSum
      871         , input Val-Effect
      872         , input Rubl-Effect
      873         , input Discnt-PC
      874         , input TorgPred
      875         , input Up-PC
      876         , input Operator
      877         , input PayType
      878         , input Kurs
      879         , input Our-Obj
      880         , input Kladov
      881         , input IspName
      882         , input no
      883         , input NDS-Val
      884         , input ( if NDS-Val = yes and Val-CostSum = yes then tg-vat-base else no )
      885         , input NDS-Rubl
      886         , input ( if NDS-Rubl = yes and Rubl-CostSum = yes then tg-vat-rubl else no )
      887         , input Nums
      888         , input Nums-doc
      889         , input ps
      890         , input v-continue
      891         , input g#report-num
      892         , output var-frame-width
      893         ).
      894   END.
      895   ON VALUE-CHANGED OF NDS-Rubl IN FRAME DLGOKCAN
      896   DO:
      897       assign
      898           NDS-Rubl
      899           Rubl-CostSum
      900       .
      901       run manage-tg-vat in this-procedure (
      902           input no
      903       ).
      904   END.
      905   ON VALUE-CHANGED OF NDS-Val IN FRAME DLGOKCAN
      906   DO:
      907       assign
      908           NDS-Val
      909           Val-CostSum
      910       .
      911       run manage-tg-vat in this-procedure (
      912           input yes
      913       ).
      914   END.
      915   ON VALUE-CHANGED OF Rubl-CostSum IN FRAME DLGOKCAN
      916   DO:
      917       assign
      918           NDS-Rubl
      919           Rubl-CostSum
      920       .
      921       run manage-tg-vat in this-procedure (
      922           input no
      923       ).
      924   END.
      925   ON VALUE-CHANGED OF Val-CostSum IN FRAME DLGOKCAN
      926   DO:
      927       assign
      928           NDS-Val
      929           Val-CostSum
      930       .
      931       run manage-tg-vat in this-procedure (
      932           input yes
      933       ).
      934   END.
      935   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME DLGOKCAN:PARENT eq ?
      936   THEN FRAME DLGOKCAN:PARENT = ACTIVE-WINDOW.
      937   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      938   on help of frame DLGOKCAN
      939   do:
      940     run gbl/app_help.p
      941       (input this-procedure :file-name
      942       ,input ''
      943       ,input ?
      944       ) no-error.
      945     if error-status :error then do:
      946       message
      947         "Ошибка при вызове помощи"
      948         error-status :get-message(1)
      949         view-as alert-box .
      950     end.
      951   end.
      952   run minbtn-set in this-procedure .
      953   on choose of b-help in frame DLGOKCAN
      954   do:
      955     apply "help":u to frame DLGOKCAN .
      956   end.
      957   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      958   procedure minbtn-set :
      959       do
      960           on error undo, return error return-value
      961           :
      962           define variable ii              as integer       no-undo .
      963           define variable fh              as widget-handle no-undo .
      964           define variable hh              as widget-handle no-undo .
      965           define variable v-h             as handle        extent 4 no-undo .
      966           define variable v-name-button   as character     no-undo .
      967           define variable v-help-old-x    as decimal       no-undo .
      968           define variable v-help-old-y    as decimal       no-undo .
      969           define variable v-help-old-size as decimal       no-undo .
      970           define variable v-frame-width   as decimal       no-undo .
      971           define variable jj              as integer       no-undo .
      972           do
      973               on error undo, return error
      974               :
      975               assign
      976                   v-frame-width = frame DLGOKCAN:width - 0.3
      977                   fh            = frame DLGOKCAN:first-child
      978                   hh            = fh:first-child
      979                   ii            = 1
      980                   .
      981               do while valid-handle(hh):
      982                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      983                   do:
      984                       case lc(hh:name) :
      985                           when "b-help" then
      986                               do:
      987                                   hh:load-image-up("cmp/b-help.bmp":u) .
      988                                   hh:load-image-down("cmp/b-help.bmp":u) .
      989                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      990                                   hh:TOOLTIP = "Помощь" .
      991                                   v-help-old-x = hh:column .
      992                                   v-help-old-y = hh:row    .
      993                                   v-help-old-size = hh:width .
      994                                   hh:width-chars = 2.5 .
      995                               end.
      996                           when "b-print" then
      997                               do:
      998                                   hh:load-image("cmp/b-print.bmp":u) .
      999                                   hh:TOOLTIP = "Печать" .
     1000                                   v-h[ii] = hh:handle .
     1001                                   ii = ii + 1 .
     1002                                   hh:width-chars = 3 .
     1003                               end.
     1004                           when "b-history" or
     1005                           when "b-hist" then
     1006                               do:
     1007                                   hh:load-image("cmp/b-hist.bmp":u) .
     1008                                   hh:TOOLTIP = "История" .
     1009                                   v-h[ii] = hh:handle .
     1010                                   ii = ii + 1 .
     1011                                   hh:width-chars = 3 .
     1012                               end.
     1013                           when "b-sch" then
     1014                               do:
     1015                                   hh:load-image("cmp/b-sch.bmp":u) .
     1016                                   hh:TOOLTIP = "Установка Фильтра" .
     1017                                   v-h[ii] = hh:handle .
     1018                                   ii = ii + 1 .
     1019                                   hh:width-chars = 3 .
     1020                               end.
     1021                           when "b-hist-user" then
     1022                               do:
     1023                                   hh:load-image("cmp/b-hist.bmp":u) .
     1024                                   hh:TOOLTIP = "История пользователя" .
     1025                                   ii = ii + 1 .
     1026                               end.
     1027                       end case.
     1028                   end.
     1029                   hh = hh:next-sibling.
     1030               end.
     1031               b-help:column = v-frame-width - b-help:width-chars.
     1032               jj = 0.
     1033               repeat ii = 4 to 1 by -1 :
     1034                   if valid-handle (v-h[ii] ) then
     1035                   do:
     1036                       jj  = jj + 1 .
     1037                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1038                       v-h[ii]:row    = v-help-old-y .
     1039                   end.
     1040               end.
     1041           end.
     1042       end.
     1043   end procedure.
     1044   ON WINDOW-CLOSE OF FRAME DLGOKCAN APPLY "END-ERROR":U TO SELF.
     1045   MAIN-BLOCK:
     1046   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1047      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1048       RubText = "РУБЛЕВЫЕ :".
     1049       RUN enable_UI.
     1050       run manage-tg-vat in this-procedure (
     1051           input yes
     1052       ).
     1053       run manage-tg-vat in this-procedure (
     1054           input no
     1055       ).
     1056       if base-code = 0 then do:
     1057         HIDE
     1058           SumText RubText ValText Rubl-BruttoSaleSum
     1059           Rubl-NettoSaleSum Rubl-DiscntSum
     1060           Rubl-CostSum Rubl-Effect NDS-Rubl
     1061           Rubl-crsa-doc
     1062           v-sale-Rubl  v-sale-Rubl-doc
     1063           tg-vat-rubl
     1064           in frame DLGOKCAN .
     1065       end.
     1066       else do:
     1067         HIDE IMAGE-1    in frame DLGOKCAN .
     1068       end.
     1069   define variable vss-include-info9 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1070   do:
     1071     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1072       (input  v-cntxt-db-num
     1073       ,input  v-cntxt-userid
     1074       ,input  0
     1075       ,input  'actn_document-reports-sale_print':U
     1076       ,input  'firm':U
     1077       ,input  v-cntxt-host-code-obj
     1078       ,input  '':U
     1079       ,input  0
     1080       ,input  0
     1081       ,input  0
     1082       ,input  0
     1083       ,input  false
     1084       ,output Log-Res1
     1085       )  .
     1086   end.
     1087       if not Log-Res1 then do:
     1088         DISABLE
     1089           Nums Val-BruttoSaleSum Rubl-BruttoSaleSum Val-NettoSaleSum
     1090           Rubl-NettoSaleSum Val-DiscntSum Rubl-DiscntSum
     1091           Discnt-PC TorgPred Up-PC Operator
     1092           PayType Kladov Kurs Our-Obj IspName
     1093           WITH FRAME DLGOKCAN.
     1094       end.
     1095   define variable vss-include-info10 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1096   do:
     1097     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1098       (input  v-cntxt-db-num
     1099       ,input  v-cntxt-userid
     1100       ,input  0
     1101       ,input  'actn_document-reports-cost_print':U
     1102       ,input  'firm':U
     1103       ,input  v-cntxt-host-code-obj
     1104       ,input  '':U
     1105       ,input  0
     1106       ,input  0
     1107       ,input  0
     1108       ,input  0
     1109       ,input  false
     1110       ,output Log-Res2
     1111       )  .
     1112   end.
     1113       if not Log-Res2 then do:
     1114         DISABLE
     1115           Rubl-CostSum Val-CostSum Val-Effect Rubl-Effect
     1116           WITH FRAME DLGOKCAN.
     1117       end.
     1118       if not ( Log-Res1 OR Log-Res2 ) then do:
     1119         message
     1120           "У Вас недостаточно ПРАВ" skip
     1121           "для выполнения данного действия." skip
     1122           "Обратитесь к администратору системы."
     1123           view-as alert-box error.
     1124         LEAVE MAIN-BLOCK .
     1125       end.
     1126       if qh:num-results = 0 then do:
     1127         message "Список П У С Т !" view-as alert-box information .
     1128         LEAVE MAIN-BLOCK .
     1129       end.
     1130       WAIT-FOR GO OF FRAME DLGOKCAN.
     1131   END.
     1132   RUN disable_UI.
     1133   PROCEDURE disable_UI :
     1134     HIDE FRAME DLGOKCAN.
     1135   END PROCEDURE.
     1136   PROCEDURE enable_UI :
     1137     DISPLAY v-sale-base v-sale-rubl v-sale-base-doc v-sale-rubl-doc
     1138             Val-BruttoSaleSum Rubl-BruttoSaleSum Val-NettoSaleSum
     1139             Rubl-NettoSaleSum Val-crsa-doc Rubl-crsa-doc Val-DiscntSum
     1140             Rubl-DiscntSum Val-CostSum Rubl-CostSum Val-Effect Rubl-Effect NDS-Val
     1141             tg-vat-base NDS-Rubl tg-vat-rubl Discnt-PC TorgPred Up-PC Operator
     1142             PayType Kladov Kurs IspName Our-Obj Nums ps Nums-doc ValText SumText
     1143             RubText
     1144         WITH FRAME DLGOKCAN.
     1145     ENABLE Btn_Cancel Btn_OK b-help IMAGE-1 v-sale-base v-sale-rubl
     1146            v-sale-base-doc v-sale-rubl-doc Val-BruttoSaleSum Rubl-BruttoSaleSum
     1147            Val-NettoSaleSum Rubl-NettoSaleSum Val-crsa-doc Rubl-crsa-doc
     1148            Val-DiscntSum Rubl-DiscntSum Val-CostSum Rubl-CostSum Val-Effect
     1149            Rubl-Effect NDS-Val tg-vat-base NDS-Rubl tg-vat-rubl Discnt-PC
     1150            TorgPred Up-PC Operator PayType Kladov Kurs IspName Our-Obj Nums ps
     1151            Nums-doc ValText SumText RubText
     1152         WITH FRAME DLGOKCAN.
     1153   END PROCEDURE.
     1154   PROCEDURE manage-tg-vat :
     1155   define input parameter p-is-base as logical          no-undo.
     1156   do
     1157   on error undo, return error
     1158   :
     1159       if p-is-base = no
     1160       then do:
     1161           if NDS-Rubl = yes
     1162           and Rubl-CostSum = yes
     1163           then do:
     1164               assign
     1165                   tg-vat-rubl :sensitive in frame DLGOKCAN = yes
     1166               .
     1167           end.
     1168           else do:
     1169               assign
     1170                   tg-vat-rubl :sensitive in frame DLGOKCAN = no
     1171               .
     1172           end.
     1173       end.
     1174       else do:
     1175           if NDS-Val = yes
     1176           and Val-CostSum
     1177           then do:
     1178               assign
     1179                   tg-vat-base :sensitive in frame DLGOKCAN = yes
     1180               .
     1181           end.
     1182           else do:
     1183               assign
     1184                   tg-vat-base :sensitive in frame DLGOKCAN = no
     1185               .
     1186           end.
     1187       end.
     1188   end.
     1189   END PROCEDURE.
