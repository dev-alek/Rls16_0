      116   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      117   function breakstr returns character ( input        for-name    as character,
      118                                         input        line-length as integer,
      119                                         input-output line1       as character,
      120                                         input-output line2       as character ) :
      121     define variable ii as integer no-undo.
      122     if length( for-name ) > line-length then do:
      123       assign ii    = 1
      124              line1 = "":u
      125              line2 = "":u.
      126       if length( entry( ii, for-name , " ":u ) ) > line-length then do:
      127         assign line1 =       substring( for-name, 1, line-length     )
      128                line2 = trim( substring( for-name,    line-length + 1 ) ).
      129       end.                                                     else do:
      130         do while length( line1 + entry( ii, for-name, " ":u ) ) < ( line-length + 1 ) :
      131           assign line1 = line1 + entry( ii, for-name, " ":u ) + " ":u
      132                  ii    = ii    + 1.
      133           if length( entry( ii, for-name, " ":u ) ) > line-length then do:
      134             assign line1 = line1 + substring( for-name, length( line1 ), line-length - length( line1 ) + 1 ).
      135           end.
      136         end.
      137         assign line2 = trim( substring( for-name, length( line1 ) ) ).
      138       end.
      139     end.                                else do:
      140       assign line1 = for-name
      141              line2 = "":u.
      142     end.
      143     return ( line1 ).
      144   end function.
