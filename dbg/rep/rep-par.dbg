        1   define input  parameter parParentProc  as widget-handle no-undo.
        2   define input  parameter p-title as character no-undo .
        3   define input  parameter qh as handle no-undo .
        4   define input  parameter bh as handle no-undo .
        5   def var vss-revision    as character no-undo init "$Revision$":U .
        6   def var vss-author      as character no-undo init "$Author$":U .
        7   def var vss-date        as character no-undo init "$Date$":U .
        8   def var vss-workfile    as character no-undo init "$Workfile$":U .
        9   def var vss-archive     as character no-undo init "$Archive$":U .
       10   def var vss-description as character no-undo init "Форма настройки печати списка документов    ".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
