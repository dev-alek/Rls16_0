     3224              b2-inv           [1]   = 0 and
     3225              b2-gds-zap-other       = 0 and
     3226              b2-overturn      [1]   = 0 and
     3227              b2-overturn      [5]   = 0 and
     3228              b2-overturn      [8]   = 0 ) ) then do:
     3229           if  not (not show-negativ  and (
     3230                 b2-prih          [1]   = 0 and
     3231                 b2-rash          [1]   = 0 and
     3232                 b2-kassa         [1]   = 0 and
     3233                 b2-inv           [1]   = 0 and
     3234                 b2-gds-zap-other       = 0 and
     3235                 b2-overturn      [1]   = 0 and
     3236                 b2-overturn      [5]   = 0 and
     3237                 b2-ostatok-start [1]   = 0 and
     3238                 b2-ostatok-end   [1]   = 0   )) then do:
     3239           run di-qnty( "кол-во", 1 ,s-bar-code,gds-zap-artic, gds-zap-gds-name,"", "b2":u).
     3240           if xshowcost    then do: run di in this-procedure ("учет.", 2, "","", "", "", "b2":u).  end.
     3241           if xshowcrsa    then do: run di in this-procedure ("прод.", 5 ,"","", "", "", "b2":u).  end.
