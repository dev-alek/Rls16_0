     3064                     temp-gds-list.artic     = gds-obj.artic
     3065                     temp-gds-list.gds-name  = gds-list.gds-name
     3066                     .
     3067                     temp-gds-list.grp-name  = n-lavel(input gds-obj.grp-name, input xlavel )
     3068                     .
     3069               end.
     3070           end.
     3071    end.
     3072     for each temp-gds-list no-lock
     3073       , first gds-list  where gds-list.gds-code  = temp-gds-list.gds-code no-lock
     3074         break
     3075           by  temp-gds-list.grp-name
     3076           by gds-list.gds-name :
     3077           str = n-lavel(input gds-list.grp-name, input xlavel ) no-error .
     3078   find clients where clients.obj-type = gds-list.prod-type and
     3079                      clients.obj-code = gds-list.prod-code no-lock .
     3080     assign
     3081         gds-zap-unit-base  = gds-list.unit-base
     3082         gds-zap-prt-root   = gds-list.prt-root
     3083         gds-zap-prod-type  = gds-list.prod-type
     3084         gds-zap-prod-code  = gds-list.prod-code
     3085         gds-zap-artic      = gds-list.artic
     3086         gds-zap-type       = gds-list.gds-type
     3087         gds-zap-grp-name   = gds-list.grp-name
     3088         gds-zap-b-code     = gds-list.gds-code
     3089         gds-zap-prod-name  = clients.obj-name .
     3090     if g#gds-engl then
     3091         assign gds-zap-gds-name = gds-list.engl-name.
     3092     else
     3093         assign gds-zap-gds-name = gds-list.gds-name.
     3094   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     3095     (input  gds-zap-b-code
     3096     ,input  ?
     3097     ,output v-bar-code
     3098     )  .
     3099     s-bar-code = string (v-bar-code,"999999999").
     3100     run foreach in this-procedure .
     3101       if  first-of ( temp-gds-list.grp-name )  then do:
     3102           fr = true .
     3103           l-stroka = "ГРУППА : " + str .
     3104           temp-str = l-stroka.
     3105       end.
     3106      run display-line in this-procedure .
     3107      if last-of( temp-gds-list.grp-name ) then do:
     3108         s-bar-code = "Итого по " .
     3109         gds-zap-artic = substring(str,1,16) .
     3110         gds-zap-gds-name = substring(str,17,250) .
     3111         run display-b1 in this-procedure .
     3112         run clear-b1 in this-procedure .
     3113         run clear-b2 in this-procedure .
     3114      end.
     3115     end.
     3116                     end.
     3117                 end case.
     3118   end procedure.
     3119   procedure calcitog :
     3120       run ostatok  in this-procedure(
     3121           input x-store-code  ,
     3122           input x-store-type  ,x-tog-shift,
     3123           input x-date-start - 1 ,
     3124           input date('')      , x-shift-start,x-shift-end,
     3125           input 'crsa':U   ,
     3126           input '##,##':U,
     3127           input xtog-obj ,
     3128           output  quantity1  ,
     3129           output  coast_r1   ,
     3130           output  coast_v1   ,
     3131           output  vat_r1     ,
     3132           output  vat_v1     ,
     3133           output  fact-order-1 ).
     3134       run ostatok  in this-procedure (
     3135           input x-store-code  ,
     3136           input x-store-type  , x-tog-shift,
     3137           input x-date-start  ,
     3138           input x-date-end    , x-shift-start,x-shift-end,
     3139           input 'crsa':U   ,
     3140           input '##,##':U,
     3141           input xtog-obj ,
     3142           output  quantity1  ,
     3143           output  coast_r1   ,
     3144           output  coast_v1   ,
     3145           output  vat_r1     ,
     3146           output  vat_v1     ,
     3147           output  fact-order-2 ).
     3148             quantity1  = 0.
     3149             coast_r1   = 0.
     3150             coast_v1   = 0.
     3151             vat_r1     = 0.
     3152             vat_v1     = 0.
     3153   end procedure.
     3154   procedure display-str1  :
     3155              run di-qnty  in this-procedure("кол-во", 1, s-bar-code,gds-zap-artic,gds-zap-gds-name,gds-zap-unit-base,"").
     3156            if xshowcost    then do: run di  in this-procedure( "учет.", 2,"","","","",""). end.
     3157            if xshowcrsa    then do: run di  in this-procedure( "прод.", 5,"","","","","" ).  end.
     3158            if xshowsale    then do: run di  in this-procedure( "док." , 8,"","","","","" ).  end.
     3159            if vat-cost    then do: run di  in this-procedure( "уч.НДС", 3,"","","","","" ). end.
     3160            if vat-crsa    then do: run di  in this-procedure( "пр.НДС", 6,"","","","","" ).  end.
     3161            if vat-sale    then do: run di  in this-procedure( "дк.НДС", 9,"","","","","" ).  end.
     3162   end procedure.
