     2197                   output  vat_v       ,
     2198                   output  slt_r       ,
     2199                   output  slt_v       ).
     2200   assign
     2201     ostatok-end [4]        = round(ostatok-end [1] *  p-price-med , 2)
     2202    ostatok-end [2 + 3]   = if tprintrubl then coast_r else coast_v
