     3250   procedure clear-b1  :
     3251    b1-gds-zap-other           = 0.
     3252    repeat kk = 1 to 9 :
     3253    assign
     3254       b1-prih                                            [kk]    = 0
     3255       b1-rash                                            [kk]    = 0
     3256       b1-kassa                                           [kk]    = 0
     3257       b1-inv                                             [kk]    = 0
     3258       b1-overturn                                        [kk]    = 0
     3259       b1-ostatok-end                                     [kk]    = 0
     3260       b1-ostatok-start                                   [kk]    = 0   .
     3261      end.
     3262    end procedure.
     3263   procedure clear-b2  :
