     3181   procedure display-b1  :
     3182        if not( not show-negativ-2 and
     3183            ( b1-prih         [1]   = 0 and
     3184              b1-rash          [1]   = 0 and
     3185              b1-kassa         [1]   = 0 and
     3186              b1-inv           [1]   = 0 and
     3187              b1-overturn      [1]   = 0 and
     3188              b1-overturn      [5]   = 0 and
     3189              b1-gds-zap-other       = 0 and
     3190              b1-overturn      [8]   = 0 ) ) then do:
     3191           if  not (not show-negativ  and (
     3192                 b1-prih          [1]   = 0 and
     3193                 b1-rash          [1]   = 0 and
     3194                 b1-kassa         [1]   = 0 and
     3195                 b1-inv           [1]   = 0 and
     3196                 b1-gds-zap-other       = 0 and
     3197                 b1-overturn      [1]   = 0 and
     3198                 b1-overturn      [5]   = 0 and
     3199                 b1-ostatok-start [1]   = 0 and
     3200                 b1-ostatok-end   [1]   = 0   )) then do:
     3201                 if sums-only then do:
     3202                     if fr0 = true then do:
     3203                         put stream  outstream  tmp#stroka0 format "x(100)" skip.
     3204                         if Make-Excel then  put   stream ForExcel unformatted string(tmp#stroka0) skip.
     3205                         fr0 = false .
     3206                       end.
     3207                  end.
     3208           run di-qnty in this-procedure ("кол-во"  ,1, s-bar-code, gds-zap-artic, gds-zap-gds-name ,"","b1":u).
     3209           if xshowcost    then do: run di in this-procedure ("учет." ,2 ,"","", "", "", "b1":u).  end.
     3210           if xshowcrsa    then do: run di in this-procedure ("прод." , 5, "","", "", "", "b1":u).  end.
     3211           if xshowsale    then do: run di in this-procedure ("док." , 8, "","", "", "", "b1":u).  end.
     3212           if vat-cost    then do: run di in this-procedure ( "уч.НДС", 3,"","","","","b1":u ). end.
     3213           if vat-crsa    then do: run di in this-procedure ( "пр.НДС", 6,"","","","","b1":u ).  end.
     3214           if vat-sale    then do: run di in this-procedure ( "дк.НДС", 9,"","","","","b1":u ).  end.
     3215          if not sums-only then run p-line.
     3216    end.
     3217    end.
     3218   end procedure.
     3219   procedure display-b2  :
     3220        if not( not show-negativ-2 and
     3221            ( b2-prih         [1]   = 0 and
     3222              b2-rash          [1]   = 0 and
