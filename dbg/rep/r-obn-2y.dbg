     2454   procedure run2sort1 :
     2455       case select-good :
     2456           when 1  then do:
     2457   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2458   IF x-SelectObject = "currency":U  OR  xTog-obj THEN DO :
     2459       for each gds-obj  where
     2460             gds-obj.obj-type = x-store-type  and
     2461             gds-obj.obj-code = x-store-code
     2462             and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     2463                   no-lock,
     2464             First goods  where  gds-obj.gds-code   = goods.gds-code
     2465   no-lock
     2466   BREAK
     2467         BY (gds-obj.grp-name)
     2468       BY (goods.gds-name) :
     2469         run item-goods ( "3" , "goods" ) .
     2470         if return-value <> "" then NEXT.
     2471           If Last-of(gds-obj.grp-name) Then Do:
     2472           If String(Entry(2,"gds-obj.grp-name",".")) = "Grp-name"
     2473             Then  Assign
     2474                     S-bar-code   = " Итого по "
     2475                     Gds-zap-artic = Substring(
     2476                                         B1-name
     2477                                         ,1,16)
     2478                     Gds-zap-gds-name = Substring(
     2479                                         B1-name
     2480                                         ,17,40)
     2481                                   .
     2482             Else  Assign
     2483                     S-bar-code   = ""
     2484                     Gds-zap-artic = "        Итого по "
     2485                     Gds-zap-gds-name =  B1-name
     2486                                   .
     2487               Run Display-b1 In This-procedure .
     2488               Run Clear-b1 In This-procedure .
     2489               Assign Break_Group = True.
     2490           End.
     2491       End.
     2492     END.
     2493     Else DO:
     2494      For each obj-list no-lock :
     2495                     FOR EACH gds-obj where
     2496                   gds-obj.obj-type = obj-list.obj-type    and
     2497                   gds-obj.obj-code = obj-list.obj-code
     2498                   and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     2499                   no-lock :
     2500                   if NOT can-find(First temp-gds-list where temp-gds-list.gds-code = gds-obj.gds-code) Then do:
     2501                       find first goods no-lock  where goods.gds-code  = gds-obj.gds-code .
     2502                       Create temp-gds-list.
     2503                       Assign
     2504                         temp-gds-list.prod-code = gds-obj.prod-code
     2505                         temp-gds-list.grp-name  = gds-obj.grp-name
     2506                         temp-gds-list.gds-name  = goods.gds-name
     2507                         temp-gds-list.gds-code  = gds-obj.gds-code
     2508                         temp-gds-list.artic     = gds-obj.artic
     2509                       .
     2510                   End.
     2511               End.
     2512     End.
     2513     for each temp-gds-list no-lock
     2514       , First goods     where goods.gds-code  = temp-gds-list.gds-code no-lock
     2515         BREAK
     2516   BY (gds-obj.grp-name)
