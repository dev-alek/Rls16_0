     3243            if vat-cost    then do: run di in this-procedure ( "уч.НДС", 3,"","","","","b2":u ). end.
     3244            if vat-crsa    then do: run di in this-procedure ( "пр.НДС", 6,"","","","","b2":u ).  end.
     3245            if vat-sale    then do: run di in this-procedure ( "дк.НДС", 9,"","","","","b2":u ).  end.
