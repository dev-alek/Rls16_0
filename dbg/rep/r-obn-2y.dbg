     2588                 first goods       where gds-obj.gds-code   = goods.gds-code  no-lock :
     2589                       if not can-find(first temp-gds-list where temp-gds-list.gds-code = gds-obj.gds-code) then do:
     2590                           create temp-gds-list.
     2591                           assign
     2592                             temp-gds-list.prod-code = gds-obj.prod-code
     2593                             temp-gds-list.grp-name  = gds-obj.grp-name
     2594                             temp-gds-list.gds-name  = goods.grp-name
     2595                             temp-gds-list.gds-code  = gds-obj.gds-code
     2596                             temp-gds-list.artic     = gds-obj.artic
     2597                           .
     2598                       end.
     2599               end.
     2600       end.
     2601     for each temp-gds-list no-lock
     2602       , first goods  where goods.gds-code  = temp-gds-list.gds-code no-lock
     2603         break
     2604           by gds-obj.grp-name
     2605       by goods.gds-name :
     2606       run item-goods ( "3" , "goods" ) .
     2607         if return-value <> "" then next.
     2608           If Last-of(gds-obj.grp-name) Then Do:
     2609           If String(Entry(2,"gds-obj.grp-name",".")) = "Grp-name"
     2610             Then  Assign
     2611                     S-bar-code   = " Итого по "
