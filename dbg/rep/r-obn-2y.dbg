     3289   procedure display-title :
     3290      PUT stream  OutStream  UNFORMATTED  string( v-cntxt-host-name-obj +  " , " + x-store-type  +  " " + objname) at 50 format "x(85)" skip(2)
     3291             reportname  at 20 format "x(170)" skip
     3292             trim(str1)  at 35 format "x(75)" skip.
     3293        repeat i = 1 to num-entries(str2,chr(10)) :
     3294         PUT stream  OutStream  UNFORMATTED  entry(i,str2,chr(10))  at 1 format "x(170)" skip.
     3295        end.
     3296       i=0.
     3297          PUT stream  OutStream  UNFORMATTED  trim(str3)  at 35 format "x(75)" skip.
     3298        repeat i = 1 to num-entries(str4,chr(10)) :
     3299         PUT stream  OutStream  UNFORMATTED  entry(i,str4,chr(10))  at 1 format "x(170)" skip.
     3300        end.
     3301       i=0.
     3302        repeat i = 1 to num-entries(reportheader,chr(10)) :
     3303         PUT stream  OutStream  UNFORMATTED  entry(i,reportheader,chr(10))  at 1 format "x(170)" skip.
     3304        end.
     3305       i=0.
     3306       run rep/extitle.p (1) .
     3307   end procedure.
     3308   procedure ob-line  :
     3309   define input  parameter x-store-code   like ub.clients.obj-code     no-undo.
     3310   define input  parameter x-store-type   like ub.clients.obj-type     no-undo.
     3311   define input  parameter x-artic        like ub.ot-line.artic        no-undo.
     3312   define input  parameter x-prod-code    like ub.ot-line.prod-code    no-undo.
     3313   define input  parameter x-prod-type    like ub.ot-line.prod-type    no-undo.
     3314   define input  parameter x-fact-order-1   like ub.ot-line.fact-order   no-undo.
     3315   define input  parameter x-fact-order-2   like ub.ot-line.fact-order   no-undo.
     3316   define input  parameter x-sum-type       like ub.ot-line.sum-type     no-undo.
     3317   define input  parameter x-cat-id         like ub.ot-line.cat-id       no-undo.
     3318   define input  parameter x-ext-doc-type   like ub.ot-line.ext-doc-type no-undo.
     3319   define input  parameter xtog-obj           as log no-undo.
     3320   define variable  tt#          as   int                 no-undo.
     3321   define variable  quantity#1    like ub.stk-line.fact-qnty   no-undo.
     3322   define variable  coast_r#1     like ub.stk-line.sum-rubl    no-undo.
     3323   define variable  coast_v#1     like ub.stk-line.sum-rubl    no-undo.
     3324   define variable  vat_r#1       like ub.stk-line.sum-rubl    no-undo.
     3325   define variable  vat_v#1       like ub.stk-line.sum-rubl    no-undo.
     3326   define variable  slt_r#1       like ub.stk-line.sum-rubl    no-undo.
     3327   define variable  slt_v#1       like ub.stk-line.sum-rubl    no-undo.
     3328   define variable  other_r#1     like ub.stk-line.sum-rubl    no-undo.
     3329   define variable  other_v#1     like ub.stk-line.sum-rubl    no-undo.
     3330   define variable  l-sum-type as character no-undo .
     3331   define variable  l-cat-id   as character no-undo .
     3332   define variable v-s# as character no-undo .
     3333    if (x-sum-type = 'sale':U ) then assign tt# = 6 v-s# = 'sadt':U .
     3334    if (x-sum-type = 'crsa':U ) then assign tt# = 3 v-s# = 'cgdt':U .
     3335    if (x-sum-type = 'cost':U ) then assign tt# = 0 v-s# = 'csdt':U .
     3336    if (x-sum-type = 'sasr':U) then assign tt# = 6 v-s# = 'adsr':U .
     3337    if (x-sum-type = 'cgsr':U) then assign tt# = 3 v-s# = 'gdsr':U .
     3338    if (x-sum-type = 'cssr':U) then assign tt# = 0 v-s# = 'sdsr':U .
     3339   define variable v-i as integer no-undo .
     3340   repeat v-i = 1 to  extent(m-prih) :
     3341    run oborot-stk in this-procedure (input  x-store-code , input  x-store-type , input  x-artic ,input  x-prod-code  ,input  x-prod-type  ,input  x-tog-shift  ,input  fact-order-1 ,input  fact-order-2 , input v-s# + m-prih[v-i] , input l-cat-id , input xtog-obj     ,    output quantity#1   ,    output coast_r#1    ,    output coast_v#1    ,    output vat_r#1      ,    output vat_v#1      ,    output slt_r#1      ,    output slt_v#1      ,    output other_r#1    ,    output other_v#1    ) .
     3342       assign prih[1 + tt#]   = prih[1 + tt#] + quantity#1
     3343              prih[2 + tt#]   = prih[2 + tt#] + if tprintrubl then coast_r#1 else coast_v#1
     3344              prih[3 + tt#]   = prih[3 + tt#] + if tprintrubl then vat_r#1   else vat_v#1 .
     3345       if tt# = 6 then gds-zap-other  = gds-zap-other + if tprintrubl then other_r#1  else other_v#1  .
     3346   end.
     3347   repeat v-i = 1 to  extent(m-rash) :
     3348    run oborot-stk in this-procedure (input  x-store-code , input  x-store-type , input  x-artic ,input  x-prod-code  ,input  x-prod-type  ,input  x-tog-shift  ,input  fact-order-1 ,input  fact-order-2 , input  v-s# + m-rash[v-i] , input l-cat-id , input xtog-obj     ,    output quantity#1   ,    output coast_r#1    ,    output coast_v#1    ,    output vat_r#1      ,    output vat_v#1      ,    output slt_r#1      ,    output slt_v#1      ,    output other_r#1    ,    output other_v#1    ) .
     3349       assign rash[1 + tt#]   = rash[1 + tt#] +  quantity#1
     3350              rash[2 + tt#]   = rash[2 + tt#] +  if tprintrubl then coast_r#1 else coast_v#1
     3351              rash[3 + tt#]   = rash[3 + tt#] +  if tprintrubl then vat_r#1   else vat_v#1 .
     3352       if tt# = 6 then gds-zap-other  = gds-zap-other + if tprintrubl then other_r#1  else other_v#1  .
     3353   end.
     3354   repeat v-i = 1 to  extent(m-kassa) :
     3355    run oborot-stk in this-procedure (input  x-store-code , input  x-store-type , input  x-artic ,input  x-prod-code  ,input  x-prod-type  ,input  x-tog-shift  ,input  fact-order-1 ,input  fact-order-2 , input  v-s# + m-kassa[v-i] , input l-cat-id , input xtog-obj     ,    output quantity#1   ,    output coast_r#1    ,    output coast_v#1    ,    output vat_r#1      ,    output vat_v#1      ,    output slt_r#1      ,    output slt_v#1      ,    output other_r#1    ,    output other_v#1    ) .
     3356       assign kassa[1 + tt#]   = kassa[1 + tt#] + quantity#1
     3357              kassa[2 + tt#]   = kassa[2 + tt#] + if tprintrubl then coast_r#1 else coast_v#1
     3358              kassa[3 + tt#]   = kassa[3 + tt#] + if tprintrubl then vat_r#1   else vat_v#1 .
     3359       if tt# = 6 then gds-zap-other  = gds-zap-other + if tprintrubl then other_r#1  else other_v#1  .
     3360    end.
     3361   repeat v-i = 1 to  extent(m-inv) :
     3362    run oborot-stk in this-procedure (input  x-store-code , input  x-store-type , input  x-artic ,input  x-prod-code  ,input  x-prod-type  ,input  x-tog-shift  ,input  fact-order-1 ,input  fact-order-2 , input  v-s# + m-inv[v-i] , input l-cat-id , input xtog-obj     ,    output quantity#1   ,    output coast_r#1    ,    output coast_v#1    ,    output vat_r#1      ,    output vat_v#1      ,    output slt_r#1      ,    output slt_v#1      ,    output other_r#1    ,    output other_v#1    ) .
     3363       assign inv[1 + tt#]   = inv[1 + tt#] + quantity#1
     3364              inv[2 + tt#]   = inv[2 + tt#] + if tprintrubl then coast_r#1 else coast_v#1
     3365              inv[3 + tt#]   = inv[3 + tt#] + if tprintrubl then vat_r#1   else vat_v#1 .
     3366       if tt# = 6 then gds-zap-other  = gds-zap-other + if tprintrubl then other_r#1  else other_v#1  .
     3367   end.
     3368   repeat v-i = 1 to  extent(m-overturn) :
     3369    run oborot-stk in this-procedure (input  x-store-code , input  x-store-type , input  x-artic ,input  x-prod-code  ,input  x-prod-type  ,input  x-tog-shift  ,input  fact-order-1 ,input  fact-order-2 , input  v-s# + m-overturn[v-i] , input l-cat-id , input xtog-obj     ,    output quantity#1   ,    output coast_r#1    ,    output coast_v#1    ,    output vat_r#1      ,    output vat_v#1      ,    output slt_r#1      ,    output slt_v#1      ,    output other_r#1    ,    output other_v#1    ) .
     3370       assign overturn[1 + tt#]   = overturn[1 + tt#] + quantity#1
     3371              overturn[2 + tt#]   = overturn[2 + tt#] + if tprintrubl then coast_r#1 else coast_v#1
     3372              overturn[3 + tt#]   = overturn[3 + tt#] + if tprintrubl then vat_r#1   else vat_v#1 .
     3373       if tt# = 6 then gds-zap-other  = gds-zap-other + if tprintrubl then other_r#1  else other_v#1  .
     3374   end.
     3375     if tt# = 6 then do:
     3376          if (x-sum-type = 'sasr':U) then do:
     3377              assign
     3378              prih[1 ]   = prih[7 ]
     3379              rash[1 ]   = rash[7 ]
     3380              kassa[1]   = kassa[7]
     3381              inv[1]     = inv[7  ]
     3382              .
     3383              end.
     3384              assign overturn[1 + tt#]   = (ostatok-end[1 + tt#]  - ostatok-start[1 + tt#] )  -  (inv[1 + tt#] + prih[1 + tt#]   +  kassa[1 + tt#]  +  rash[1 + tt#]  )
     3385                     overturn[2 + tt#]   = (ostatok-end[2 + tt#]  - ostatok-start[2 + tt#] )  -  (inv[2 + tt#] + prih[2 + tt#]   +  kassa[2 + tt#]  +  rash[2 + tt#]  +  gds-zap-other )
     3386                     overturn[3 + tt#]   = (ostatok-end[3 + tt#]  - ostatok-start[3 + tt#] )  -  (inv[3 + tt#] + prih[3 + tt#]   +  kassa[3 + tt#]  +  rash[3 + tt#]  )  .
     3387     end.
     3388   end procedure.
     3389   procedure report-exec1  :
     3390      find first clients where x-store-type = clients.obj-type and
     3391                               x-store-code = clients.obj-code no-lock no-error.
     3392   IF ( i modulo v-account = 0 )  then DO:
     3393    Assign
     3394       v-kol-spice = (50 - LENGTH(clients.obj-name)) / 2
     3395       RecordsString = fill(' ',v-kol-spice) + string(clients.obj-name)
     3396       .
     3397             if  log-manager:logfile-name ne ?
     3398             then DO:
     3399                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     3400             end.
     3401              if mFrameView
     3402              then do:
     3403               DISPLAY
     3404                 i @ RecordsDone
     3405                 RecordsString   @ RecordsString
     3406                 WITH FRAME InfoFrame.
     3407              end.
     3408   End.
     3409      if v-button-stop then  DO:
     3410            if mFrameView
     3411            then
     3412               PROCESS EVENTS.
     3413            IF StopProcessing THEN DO:
     3414            RETURN error.
     3415            End.
     3416      end.
     3417     run calcitog.
     3418     run print-header.
     3419      case retclassify :
     3420        when "grp-goods":u then      run run2.
     3421      end case.
     3422     run print-footer.
     3423     end procedure.
     3424   procedure calc-sub-itog :
     3425   define input parameter tt as int no-undo.
     3426   define variable b as int no-undo.
     3427   if tt = 6  then assign
     3428     b1-gds-zap-other = b1-gds-zap-other +  gds-zap-other
     3429     b2-gds-zap-other = b2-gds-zap-other +  gds-zap-other
     3430     bi-gds-zap-other = bi-gds-zap-other +  gds-zap-other
     3431     bo-gds-zap-other = bo-gds-zap-other +  gds-zap-other
     3432     .
     3433   repeat b = 1 to 3:
     3434     assign
     3435     b1-prih[b + tt]    = b1-prih[b + tt]    +  prih[b + tt]
     3436     b2-prih[b + tt]    = b2-prih[b + tt]    +  prih[b + tt]
     3437     bi-prih[b + tt]    = bi-prih[b + tt]    +  prih[b + tt]
     3438     bo-prih[b + tt]    = bo-prih[b + tt]    +  prih[b + tt]
     3439     bo-ostatok-start[b + tt]    = bo-ostatok-start[b + tt]    +  ostatok-start[b + tt]
     3440     bo-ostatok-end[b + tt]      = bo-ostatok-end[b + tt]      +  ostatok-end[b + tt]
     3441     b1-rash[b + tt]    = b1-rash[b + tt]    +  rash[b + tt]
     3442     b2-rash[b + tt]    = b2-rash[b + tt]    +  rash[b + tt]
     3443     bi-rash[b + tt]    = bi-rash[b + tt]    +  rash[b + tt]
     3444     bo-rash[b + tt]    = bo-rash[b + tt]    +  rash[b + tt]
     3445     b1-kassa[b + tt]    = b1-kassa[b + tt]    +  kassa[b + tt]
     3446     b2-kassa[b + tt]    = b2-kassa[b + tt]    +  kassa[b + tt]
     3447     bi-kassa[b + tt]    = bi-kassa[b + tt]    +  kassa[b + tt]
     3448     bo-kassa[b + tt]    = bo-kassa[b + tt]    +  kassa[b + tt]
     3449     b1-inv[b + tt]    = b1-inv[b + tt]    +  inv[b + tt]
     3450     b2-inv[b + tt]    = b2-inv[b + tt]    +  inv[b + tt]
     3451     bi-inv[b + tt]    = bi-inv[b + tt]    +  inv[b + tt]
     3452     bo-inv[b + tt]    = bo-inv[b + tt]    +  inv[b + tt]
     3453     b1-overturn[b + tt]    = b1-overturn[b + tt]    +  overturn[b + tt]
     3454     b2-overturn[b + tt]    = b2-overturn[b + tt]    +  overturn[b + tt]
     3455     bi-overturn[b + tt]    = bi-overturn[b + tt]    +  overturn[b + tt]
     3456     bo-overturn[b + tt]    = bo-overturn[b + tt]    +  overturn[b + tt] .
     3457   end.
     3458   end procedure.
     3459   procedure clear-item :
     3460   define variable kk as int no-undo.
     3461    gds-zap-other = 0 .
     3462    repeat kk = 1 to 9 :
     3463    assign
     3464       prih            [kk]    = 0
     3465       rash            [kk]    = 0
     3466       kassa           [kk]    = 0
     3467       inv             [kk]    = 0
     3468       overturn        [kk]    = 0
     3469       ostatok-end     [kk]    = 0
     3470       ostatok-start   [kk]    = 0 .
     3471          end.
     3472    end procedure.
     3473   procedure item-goods :
     3474      define input parameter  par-3 as char no-undo.
     3475      define input parameter  par-4 as char no-undo.
     3476        if par-4 = "goods":u  then do:
     3477           assign
     3478               gds-zap-unit-base  = goods.unit-base
     3479               gds-zap-prt-root   = goods.prt-root
     3480               gds-zap-prod-type  = goods.prod-type
     3481               gds-zap-prod-code  = goods.prod-code
     3482               gds-zap-artic      = goods.artic
     3483               gds-zap-grp-name   = goods.grp-name
     3484               gds-zap-b-code     = goods.gds-code
     3485               gds-zap-type       = goods.gds-type.
     3486           if g#gds-engl then
     3487               assign gds-zap-gds-name = goods.engl-name.
     3488           else
     3489               assign gds-zap-gds-name = goods.gds-name.
     3490        end.
     3491        if par-4 = "gds-list":u  then do:
     3492           assign
     3493               gds-zap-unit-base  = gds-list.unit-base
     3494               gds-zap-prt-root   = gds-list.prt-root
     3495               gds-zap-prod-type  = gds-list.prod-type
     3496               gds-zap-prod-code  = gds-list.prod-code
     3497               gds-zap-artic      = gds-list.artic
     3498               gds-zap-grp-name   = gds-list.grp-name
     3499               gds-zap-b-code     = gds-list.gds-code
     3500               gds-zap-type       = gds-list.gds-type.
     3501           if g#gds-engl then
     3502               assign gds-zap-gds-name = gds-list.engl-name.
     3503           else
     3504               assign gds-zap-gds-name = gds-list.gds-name.
     3505       end.
     3506       run foreach  in this-procedure.
     3507   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     3508     (input  gds-zap-b-code
     3509     ,input  ?
     3510     ,output v-bar-code
     3511     )  .
     3512   s-bar-code = string (v-bar-code,"999999999").
     3513       If  break_group = true  and par-3 <> "1"  then DO :
     3514            FIND FIRST clients WHERE clients.obj-type = gds-zap-prod-type AND clients.obj-code = gds-zap-prod-code use-index pi NO-LOCK .
     3515            gds-zap-prod-name  = clients.obj-name.
     3516             If break_group1 = true  THEN  DO :
     3517               if (par-3 = "3"  OR  par-3 = "5" ) and  par-3 <> "6"
     3518                 then DO: Assign temp-str = string("ГРУППА : " + gds-zap-grp-name )         b1-name = gds-zap-grp-name . end.
     3519                 else DO: Assign temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name ) b1-name = gds-zap-prod-name. end.
     3520               if par-3 = "6"  then  dO:
     3521                  if xTog-obj = true then do:
     3522                    var-vat-pc = func-vat (input gds-zap-b-code , input x-store-type, input x-store-code)
     3523                     .
     3524                   end.
     3525                  else do:
     3526                   var-vat-pc = temp-gds-list.vat-pc .
     3527                   end.
     3528                   assign
     3529                       temp-str = string( "СТАВКА НДС : " + string(var-vat-pc) + "%" )
     3530                       b1-name = temp-str.
     3531                   end.
     3532               if NOT xSumsOnly or (par-3 = "4" Or par-3 = "5" ) THEN DO :
     3533                   fr0 = true .
     3534                   tmp#stroka0 = temp-str.
     3535               End.
     3536             End.
     3537               IF (par-3 = "4"  OR  par-3 = "5")  THEN DO:
     3538                 if par-3 = "4"
     3539                   then Assign temp-str = string("ГРУППА : " + gds-zap-grp-name )          b2-name = gds-zap-grp-name .
     3540                   else Assign temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name )  b2-name = gds-zap-prod-name.
     3541                 if NOT xSumsOnly THEN DO:
     3542                     fr = true .
     3543                 End.
     3544                 break_group1 = false.
     3545               END.
     3546          break_group = false.
     3547       End.
     3548       run display-line  in this-procedure.
     3549    end procedure.
     3550   procedure di :
     3551   define input parameter p1 as char no-undo.
     3552   define input parameter p2 as int no-undo.
     3553   define input parameter p3 as char no-undo.
     3554   define input parameter p4 as char no-undo.
     3555   define input parameter p5 as char no-undo.
     3556   define input parameter p6 as char no-undo.
     3557   define input parameter p7 as char no-undo.
     3558    case caps(p7) :
     3559      when "b1":u  then do:
     3560       DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     3561         p3 @ s-bar-code
     3562         p4 @ gds-zap-artic
     3563         p5 @ gds-zap-gds-name
     3564         p6 @ gds-zap-unit-base
     3565         p1 @ gds-type
     3566         b1-ostatok-start [p2] format "->>>>>>>>>>9.<<" @  F-ostatok-start
     3567         b1-Prih          [p2] format "->>>>>>>>>>9.<<" @  F-Prih
     3568         b1-RAsh          [p2] format "->>>>>>>>>>9.<<" @  F-RAsh
     3569         b1-KAssa         [p2] format "->>>>>>>>>>9.<<" @  F-KAssa
     3570         b1-Inv           [p2] format "->>>>>>>>>>9.<<" @  F-Inv
     3571         b1-Overturn      [p2] format "->>>>>>>>>>9.<<" @  F-Overturn
     3572         b1-Ostatok-end   [p2] format "->>>>>>>>>>9.<<" @  F-Ostatok-end
     3573         b1-gds-zap-other      format "->>>>>>>>>>9.<<" when (p2 = 1) @  gds-zap-other
     3574         with FRAME ZAPAS .
     3575                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     3576                   end.
     3577      when "b2":u  then  do:
     3578       DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     3579         p3 @ s-bar-code
     3580         p4 @ gds-zap-artic
     3581         p5 @ gds-zap-gds-name
     3582         p6 @ gds-zap-unit-base
     3583         p1 @ gds-type
     3584         b2-ostatok-start [p2] format "->>>>>>>>>>9.<<" @  F-ostatok-start
     3585         b2-Prih          [p2] format "->>>>>>>>>>9.<<" @  F-Prih
     3586         b2-RAsh          [p2] format "->>>>>>>>>>9.<<" @  F-RAsh
     3587         b2-KAssa         [p2] format "->>>>>>>>>>9.<<" @  F-KAssa
     3588         b2-Inv           [p2] format "->>>>>>>>>>9.<<" @  F-Inv
     3589         b2-Overturn      [p2] format "->>>>>>>>>>9.<<" @  F-Overturn
     3590         b2-Ostatok-end   [p2] format "->>>>>>>>>>9.<<" @  F-Ostatok-end
     3591         b2-gds-zap-other      format "->>>>>>>>>>9.<<" when (p2 = 1) @  gds-zap-other
     3592         with FRAME ZAPAS .
     3593                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     3594                 end.
     3595      when "bi":u then  do:
     3596       DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     3597         p3 @ s-bar-code
     3598         p4 @ gds-zap-artic
     3599         p5 @ gds-zap-gds-name
     3600         p6 @ gds-zap-unit-base
     3601         p1 @ gds-type
     3602         bi-ostatok-start [p2] format "->>>>>>>>>>9.<<" @  F-ostatok-start
     3603         bi-Prih          [p2] format "->>>>>>>>>>9.<<" @  F-Prih
     3604         bi-RAsh          [p2] format "->>>>>>>>>>9.<<" @  F-RAsh
     3605         bi-KAssa         [p2] format "->>>>>>>>>>9.<<" @  F-KAssa
     3606         bi-Inv           [p2] format "->>>>>>>>>>9.<<" @  F-Inv
     3607         bi-Overturn      [p2] format "->>>>>>>>>>9.<<" @  F-Overturn
     3608         bi-Ostatok-end   [p2] format "->>>>>>>>>>9.<<" @  F-Ostatok-end
     3609         bi-gds-zap-other      format "->>>>>>>>>>9.<<" when (p2 = 1) @  gds-zap-other
     3610         with FRAME ZAPAS .
     3611                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     3612                 end.
     3613      when "bo":u then  do:
     3614       DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     3615         p3 @ s-bar-code
     3616         p4 @ gds-zap-artic
     3617         p5 @ gds-zap-gds-name
     3618         p6 @ gds-zap-unit-base
     3619         p1 @ gds-type
     3620         bo-ostatok-start [p2] format "->>>>>>>>>>9.<<" @  F-ostatok-start
     3621         bo-Prih          [p2] format "->>>>>>>>>>9.<<" @  F-Prih
     3622         bo-RAsh          [p2] format "->>>>>>>>>>9.<<" @  F-RAsh
     3623         bo-KAssa         [p2] format "->>>>>>>>>>9.<<" @  F-KAssa
     3624         bo-Inv           [p2] format "->>>>>>>>>>9.<<" @  F-Inv
     3625         bo-Overturn      [p2] format "->>>>>>>>>>9.<<" @  F-Overturn
     3626         bo-Ostatok-end   [p2] format "->>>>>>>>>>9.<<" @  F-Ostatok-end
     3627         bo-gds-zap-other      format "->>>>>>>>>>9.<<" when (p2 = 1) @  gds-zap-other
     3628         with FRAME ZAPAS .
     3629                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     3630                 end.
     3631      when ""  then  do:
     3632       DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     3633         p3 @ s-bar-code
     3634         p4 @ gds-zap-artic
     3635         p5 @ gds-zap-gds-name
     3636         p6 @ gds-zap-unit-base
     3637         p1 @ gds-type
     3638         ostatok-start [p2] format "->>>>>>>>>>9.<<" @  F-ostatok-start
     3639         Prih          [p2] format "->>>>>>>>>>9.<<" @  F-Prih
     3640         RAsh          [p2] format "->>>>>>>>>>9.<<" @  F-RAsh
     3641         KAssa         [p2] format "->>>>>>>>>>9.<<" @  F-KAssa
     3642         Inv           [p2] format "->>>>>>>>>>9.<<" @  F-Inv
     3643         Overturn      [p2] format "->>>>>>>>>>9.<<" @  F-Overturn
     3644         Ostatok-end   [p2] format "->>>>>>>>>>9.<<" @  F-Ostatok-end
     3645         gds-zap-other      format "->>>>>>>>>>9.<<" when (p2 = 1) @  gds-zap-other
     3646         with FRAME ZAPAS .
     3647                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     3648                 end.
     3649      end case.
     3650    end procedure.
     3651   procedure di-qnty :
     3652   define input parameter p1 as char no-undo.
     3653   define input parameter p2 as int no-undo.
     3654   define input parameter p3 as char no-undo.
     3655   define input parameter p4 as char no-undo.
     3656   define input parameter p5 as char no-undo.
     3657   define input parameter p6 as char no-undo.
     3658   define input parameter p7 as char no-undo.
     3659    case caps(p7) :
     3660      when "b1":u  then do :
     3661       DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     3662         p3 @ s-bar-code
     3663         p4 @ gds-zap-artic
     3664         p5 @ gds-zap-gds-name
     3665         p6 @ gds-zap-unit-base
     3666         p1 @ gds-type
     3667         b1-ostatok-start [p2] format "->>>>>>>>>>9.<<<" @  F-ostatok-start
     3668         b1-Prih          [p2] format "->>>>>>>>>>9.<<<" @  F-Prih
     3669         b1-RAsh          [p2] format "->>>>>>>>>>9.<<<" @  F-RAsh
     3670         b1-KAssa         [p2] format "->>>>>>>>>>9.<<<" @  F-KAssa
     3671         b1-Inv           [p2] format "->>>>>>>>>>9.<<<" @  F-Inv
     3672         b1-Overturn      [p2] format "->>>>>>>>>>9.<<<" @  F-Overturn
     3673         b1-Ostatok-end   [p2] format "->>>>>>>>>>9.<<<" @  F-Ostatok-end
     3674         b1-gds-zap-other      format "->>>>>>>>>>9.<<<" when (p2 = 1) @  gds-zap-other
     3675         with FRAME ZAPAS .
     3676   if Make-Excel then  put   stream ForExcel unformatted
     3677     p3 CHR(9)
     3678     p4 CHR(9)
     3679     gds-zap-gds-name CHR(9)
     3680     p6 CHR(9)
     3681     gds-zap-type     CHR(9)
     3682     excel-sum(b1-gds-zap-other   )   CHR(9)
     3683     excel-qnty(b1-ostatok-start[1])  CHR(9)
     3684     excel-sum(b1-ostatok-start[2])  CHR(9)
     3685     excel-sum(b1-ostatok-start[5])  CHR(9)
     3686     excel-sum(b1-ostatok-start[8])  CHR(9)
     3687     excel-sum(b1-ostatok-start[3])  CHR(9)
     3688     excel-sum(b1-ostatok-start[6])  CHR(9)
     3689     excel-sum(b1-ostatok-start[9])  CHR(9)
     3690     excel-qnty(b1-Prih         [1])  CHR(9)
     3691     excel-sum(b1-Prih         [2])  CHR(9)
     3692     excel-sum(b1-Prih         [5])  CHR(9)
     3693     excel-sum(b1-Prih         [8])  CHR(9)
     3694     excel-sum(b1-Prih         [3])  CHR(9)
     3695     excel-sum(b1-Prih         [6])  CHR(9)
     3696     excel-sum(b1-Prih         [9])  CHR(9)
     3697     excel-qnty(b1-RAsh         [1])  CHR(9)
     3698     excel-sum(b1-RAsh         [2])  CHR(9)
     3699     excel-sum(b1-RAsh         [5])  CHR(9)
     3700     excel-sum(b1-RAsh         [8])  CHR(9)
     3701     excel-sum(b1-RAsh         [3])  CHR(9)
     3702     excel-sum(b1-RAsh         [6])  CHR(9)
     3703     excel-sum(b1-RAsh         [9])  CHR(9)
     3704     excel-qnty(b1-KAssa        [1])  CHR(9)
     3705     excel-sum(b1-KAssa        [2])  CHR(9)
     3706     excel-sum(b1-KAssa        [5])  CHR(9)
     3707     excel-sum(b1-KAssa        [8])  CHR(9)
     3708     excel-sum(b1-KAssa        [3])  CHR(9)
     3709     excel-sum(b1-KAssa        [6])  CHR(9)
     3710     excel-sum(b1-KAssa        [9])  CHR(9)
     3711     excel-qnty(b1-Inv          [1])  CHR(9)
     3712     excel-sum(b1-Inv          [2])  CHR(9)
     3713     excel-sum(b1-Inv          [5])  CHR(9)
     3714     excel-sum(b1-Inv          [8])  CHR(9)
     3715     excel-sum(b1-Inv          [3])  CHR(9)
     3716     excel-sum(b1-Inv          [6])  CHR(9)
     3717     excel-sum(b1-Inv          [9])  CHR(9)
     3718     excel-qnty(b1-Overturn     [1])  CHR(9)
     3719     excel-sum(b1-Overturn     [2])  CHR(9)
     3720     excel-sum(b1-Overturn     [5])  CHR(9)
