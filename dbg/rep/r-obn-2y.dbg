     3174            if xshowcost    then do: run di in this-procedure ("учет." , 2 , "","", "", "", "bo":u).  end.
     3175            if xshowcrsa    then do: run di in this-procedure ("прод." , 5, "","", "", "",  "bo":u).  end.
