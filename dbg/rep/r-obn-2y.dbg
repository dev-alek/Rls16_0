     3265    repeat kk = 1 to 9 :
     3266    assign
     3267       b2-prih                                            [kk]    = 0
     3268       b2-rash                                            [kk]    = 0
     3269       b2-kassa                                           [kk]    = 0
     3270       b2-inv                                             [kk]    = 0
     3271       b2-overturn                                        [kk]    = 0
