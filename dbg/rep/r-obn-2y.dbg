     2631           when 3 then do:
     2632   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2633   if x-selectobject = "currency":u  or  xtog-obj then do:
     2634     for  each gds-obj
