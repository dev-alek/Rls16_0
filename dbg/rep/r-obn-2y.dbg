     4033   procedure oborot-stk :
     4034   define input  parameter l-store-code   like ub.clients.obj-code      no-undo.
     4035   define input  parameter l-store-type   like ub.clients.obj-type      no-undo.
     4036   define input  parameter l-artic        like ub.stk-line.artic        no-undo.
     4037   define input  parameter l-prod-code    like ub.stk-line.prod-code    no-undo.
     4038   define input  parameter l-prod-type    like ub.stk-line.prod-type    no-undo.
     4039   define input  parameter l-tog-shift    as   logical                  no-undo.
     4040   define input  parameter l-fact-order-1   like ub.stk-line.fact-order   no-undo.
     4041   define input  parameter l-fact-order-2   like ub.stk-line.fact-order   no-undo.
     4042   define input  parameter l-sum-type     like ub.stk-line.sum-type     no-undo.
     4043   define input  parameter l-cat-id       like ub.stk-line.cat-id       no-undo.
     4044   define input  parameter l-tog-obj       as log no-undo.
     4045   define output parameter quantity    like ub.stk-line.fact-qnty   no-undo.
     4046   define output parameter coast_r     like ub.stk-line.sum-rubl    no-undo.
     4047   define output parameter coast_v     like ub.stk-line.sum-rubl    no-undo.
     4048   define output parameter vat_r       like ub.stk-line.sum-rubl    no-undo.
     4049   define output parameter vat_v       like ub.stk-line.sum-rubl    no-undo.
     4050   define output parameter slt_r       like ub.stk-line.sum-rubl    no-undo.
     4051   define output parameter slt_v       like ub.stk-line.sum-rubl    no-undo.
     4052   define output parameter other_r     like ub.stk-line.sum-rubl    no-undo.
     4053   define output parameter other_v     like ub.stk-line.sum-rubl    no-undo.
     4054   define variable  quantity#1    like ub.stk-line.fact-qnty   no-undo.
     4055   define variable  coast_r#1     like ub.stk-line.sum-rubl    no-undo.
     4056   define variable  coast_v#1     like ub.stk-line.sum-rubl    no-undo.
     4057   define variable  vat_r#1       like ub.stk-line.sum-rubl    no-undo.
     4058   define variable  vat_v#1       like ub.stk-line.sum-rubl    no-undo.
     4059   define variable  slt_r#1       like ub.stk-line.sum-rubl    no-undo.
     4060   define variable  slt_v#1       like ub.stk-line.sum-rubl    no-undo.
     4061   define variable  other_r#1     like ub.stk-line.sum-rubl    no-undo.
     4062   define variable  other_v#1     like ub.stk-line.sum-rubl    no-undo.
     4063   define variable  quantity#2    like ub.stk-line.fact-qnty   no-undo.
     4064   define variable  coast_r#2     like ub.stk-line.sum-rubl    no-undo.
     4065   define variable  coast_v#2     like ub.stk-line.sum-rubl    no-undo.
     4066   define variable  vat_r#2       like ub.stk-line.sum-rubl    no-undo.
     4067   define variable  vat_v#2       like ub.stk-line.sum-rubl    no-undo.
     4068   define variable  slt_r#2       like ub.stk-line.sum-rubl    no-undo.
     4069   define variable  slt_v#2       like ub.stk-line.sum-rubl    no-undo.
     4070   define variable  other_r#2     like ub.stk-line.sum-rubl    no-undo.
     4071   define variable  other_v#2     like ub.stk-line.sum-rubl    no-undo.
     4072   run ost-lineother-tax  in this-procedure
     4073    (  input   l-store-code  ,
     4074       input   l-store-type  ,
     4075       input   l-artic       ,
     4076       input   l-prod-code   ,
     4077       input   l-prod-type   ,
     4078       input   l-tog-shift   ,
     4079       input   l-fact-order-1,
     4080       input   l-sum-type    ,
     4081       input   l-cat-id      ,
     4082       input   l-tog-obj     ,
     4083       output  quantity#1 ,
     4084       output  coast_r#1  ,
     4085       output  coast_v#1  ,
     4086       output  vat_r#1    ,
     4087       output  vat_v#1    ,
     4088       output  slt_r#1    ,
     4089       output  slt_v#1    ,
     4090       output  other_r#1  ,
     4091       output  other_v#1  ).
     4092   run ost-lineother-tax  in this-procedure
     4093    (  input   l-store-code  ,
     4094       input   l-store-type  ,
     4095       input   l-artic       ,
     4096       input   l-prod-code   ,
     4097       input   l-prod-type   ,
     4098       input   l-tog-shift   ,
     4099       input   l-fact-order-2,
     4100       input   l-sum-type    ,
     4101       input   l-cat-id      ,
     4102       input   l-tog-obj     ,
     4103       output  quantity#2 ,
     4104       output  coast_r#2  ,
     4105       output  coast_v#2  ,
     4106       output  vat_r#2    ,
     4107       output  vat_v#2    ,
     4108       output  slt_r#2    ,
     4109       output  slt_v#2    ,
     4110       output  other_r#2  ,
     4111       output  other_v#2  ).
     4112       assign
     4113         quantity =   quantity#2 -  quantity#1
     4114         coast_r  =   coast_r#2  -  coast_r#1
     4115         coast_v  =   coast_v#2  -  coast_v#1
     4116         vat_r    =   vat_r#2    -  vat_r#1
     4117         vat_v    =   vat_v#2    -  vat_v#1
     4118         slt_r    =   slt_r#2    -  slt_r#1
     4119         slt_v    =   slt_v#2    -  slt_v#1
     4120         other_r  =   other_r#2  -  other_r#1
     4121         other_v  =   other_v#2  -  other_v#1
     4122         .
     4123    end procedure.
