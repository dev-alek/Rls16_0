      892          "Object ":U THIS-PROCEDURE:FILE-NAME
      893            "must have at least one Enabled Table to perform Assign.":U
      894              VIEW-AS ALERT-BOX ERROR.
      895      RETURN.
      896     END PROCEDURE.
      897   PROCEDURE adm-assign-statement :
      898     RETURN.
      899   END PROCEDURE.
      900   PROCEDURE adm-cancel-record :
      901      RETURN.
      902     END PROCEDURE.
      903   PROCEDURE adm-copy-record :
      904       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      905        "must have at least one Enabled Table to perform Copy.":U
      906          VIEW-AS ALERT-BOX ERROR.
      907       RETURN.
      908   END PROCEDURE.
      909   PROCEDURE adm-create-record :
      910      RETURN.
      911   END PROCEDURE.
      912   PROCEDURE adm-current-changed :
      913     RETURN.
      914   END PROCEDURE.
      915   PROCEDURE adm-delete-record :
      916    MESSAGE
      917          "Object ":U THIS-PROCEDURE:FILE-NAME
      918            "must have at least one Enabled Table to perform Delete.":U
      919              VIEW-AS ALERT-BOX ERROR.
      920       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
      921       RETURN.
      922   END PROCEDURE.
      923   PROCEDURE adm-disable-fields :
      924         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
      925       RETURN.
      926   END PROCEDURE.
      927   PROCEDURE adm-enable-fields :
      928       RETURN.
      929   END PROCEDURE.
      930   PROCEDURE adm-end-update :
      931     RETURN.
      932   END PROCEDURE.
      933   PROCEDURE adm-reset-record :
      934       RETURN.
      935   END PROCEDURE.
      936   PROCEDURE adm-update-record :
      937       MESSAGE
      938         "Object ":U THIS-PROCEDURE:FILE-NAME
      939           "must have at least one Enabled Table to perform Update.":U
      940             VIEW-AS ALERT-BOX ERROR.
      941      RETURN.
      942   END PROCEDURE.
      943   PROCEDURE check-modified :
      944   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
      945   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
      946   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
      947   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
      948     IF check-state = "check":U THEN
      949     DO:
      950       RUN get-link-handle IN adm-broker-hdl
      951         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
      952            OUTPUT group-target-list).
      953       IF group-target-list NE "":U THEN
      954       DO i = 1 TO NUM-ENTRIES(group-target-list):
      955         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
      956         RUN check-modified IN curr-widget ('group-check':U).
      957         IF RETURN-VALUE NE "":U THEN
      958         DO:
      959           RUN check-modified-message(RETURN-VALUE).
      960           RETURN "":U.
      961         END.
      962       END.
      963     END.
      964     RETURN "":U.
      965   END PROCEDURE.
      966   PROCEDURE check-modified-message :
      967     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
      968        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
      969           'CONTAINER-SOURCE':U, 'HIDDEN':U).
      970        IF RETURN-VALUE = "YES":U THEN
      971           RUN notify ('view,CONTAINER-SOURCE':U).
      972        MESSAGE IF p-changed-table NE ? THEN
      973           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
      974           ELSE "Current values have been changed."
      975           SKIP "  Do you wish to save those changes?"
      976           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
      977        IF ANS THEN
      978        DO:
      979           IF group-assign-target THEN
      980             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
      981           ELSE RUN dispatch('update-record':U).
      982           IF RETURN-VALUE = "ADM-ERROR":U THEN
      983           DO:
      984               MESSAGE "Changes to the previous record were not saved."
      985                 VIEW-AS ALERT-BOX ERROR.
      986               IF group-assign-target THEN
      987                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      988               ELSE RUN dispatch ('cancel-record':U).
      989           END.
      990        END.
      991        ELSE DO:
      992          IF group-assign-target THEN
      993             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      994          ELSE RUN dispatch('cancel-record':U).
      995        END.
      996        RETURN.
      997   END PROCEDURE.
      998   PROCEDURE get-rowid :
      999       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1000       ASSIGN
     1001       p-table   =   adm-first-table.
     1002       RETURN.
     1003   END PROCEDURE.
     1004   PROCEDURE init-group-assign :
     1005       RUN request-attribute IN adm-broker-hdl
     1006         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1007       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1008         group-assign-target = yes.
     1009       ELSE group-assign-target = no.
     1010       RETURN.
     1011   END PROCEDURE.
     1012   PROCEDURE set-editors :
     1013       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1014       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1015       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1016       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1017       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1018       DO WHILE VALID-HANDLE (curr-widget):
     1019           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1020              curr-widget:HIDDEN = no THEN DO:
     1021             CASE p-field-setting:
     1022               WHEN "INITIALIZE":U THEN
     1023               DO:
     1024                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1025                     read-only-list +
     1026                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1027                        STRING(curr-widget).
     1028               END.
     1029               WHEN "DISABLE":U OR
     1030               WHEN "ENABLE":U THEN
     1031               DO:
     1032                   curr-widget:SENSITIVE = yes.
     1033                   RUN get-attribute ('Read-Only-Editors':U).
     1034                   IF RETURN-VALUE = ? OR
     1035                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1036                       curr-widget:READ-ONLY =
     1037                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1038               END.
     1039               WHEN "CLEAR":U THEN
     1040                   curr-widget:SCREEN-VALUE = "":U.
     1041             END CASE.
     1042           END.
     1043           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1044       END.
     1045       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1046         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1047           + '"':U).
     1048       RETURN.
     1049   END PROCEDURE.
     1050   PROCEDURE use-check-modified-all :
     1051    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1052     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1053     RETURN.
     1054   END PROCEDURE.
     1055   PROCEDURE use-create-on-add :
     1056   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1057      RETURN.
     1058   END PROCEDURE.
     1059   PROCEDURE use-initial-lock :
     1060     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1061     ASSIGN adm-initial-lock = p-attr-value.
     1062     RETURN.
     1063   END PROCEDURE.
     1064     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1065   ASSIGN
     1066          FRAME F-Main:SCROLLABLE       = FALSE
     1067          FRAME F-Main:HIDDEN           = TRUE.
     1068   ON CHOOSE OF BUTTON-contr IN FRAME F-Main
     1069   DO:
     1070     run str/cont-all.w (input parParentProc, input v-cntxt-host-code-obj, input "b-sel", input 'фирма':U, input ?,
     1071                     input ?, input ?, input ?, input "current":u, input 'при':U, input-output contr-list).
     1072     if contr-list <> "" then do:
     1073       find first contract no-lock where RECID(contract) = int (contr-list) no-error .
     1074       if available contract then do:
     1075         assign
     1076           contr-code = contract.contract-code
     1077           snum    = contract.contract-prn-code + " от " + string(contract.contract-date,"99/99/9999")
     1078         .
     1079       end.
     1080       else assign  contr-code = 0   snum = "" .
     1081     end.
     1082     display contr-code snum with frame F-Main.
     1083     if not itog-only then do :
     1084       enable itog-contract with frame F-Main.
     1085     end.
     1086   END.
     1087   ON LEAVE OF contr-code IN FRAME F-Main
     1088   DO:
     1089     assign contr-code.
     1090     if contr-code <> 0 then do :
     1091       run  FindRec in this-procedure  ( input 0 ) .
     1092       if not itog-only then do :
     1093           enable itog-contract with frame F-Main.
     1094       end.
     1095     end.
     1096     if snum = "" and contr-code = 0 then do :
     1097       disable itog-contract with frame F-Main.
     1098     end.
     1099   END.
     1100   ON RETURN OF contr-code IN FRAME F-Main
     1101   DO:
     1102     assign contr-code.
     1103     if contr-code <> 0 then do :
     1104       run  FindRec in this-procedure  ( input 0 ) .
     1105       if not itog-only then do :
     1106           enable itog-contract with frame F-Main.
     1107       end.
     1108     end.
     1109     if snum = "" and contr-code = 0 then do :
     1110       disable itog-contract with frame F-Main.
     1111     end.
     1112   END.
     1113   ON VALUE-CHANGED OF itog-contract IN FRAME F-Main
     1114   DO:
     1115     assign itog-contract .
     1116     if itog-contract then do:
     1117       disable itog-only with frame F-Main.
     1118     end.
     1119     else do:
     1120       enable itog-only with frame F-Main.
     1121     end.
     1122   END.
     1123   ON VALUE-CHANGED OF itog-only IN FRAME F-Main
     1124   DO:
     1125     assign itog-only .
     1126     if itog-only then do:
     1127       disable itog-contract with frame F-Main.
     1128     end.
     1129     if not itog-only then do:
     1130       enable itog-contract with frame F-Main.
     1131     end.
     1132   END.
     1133   ON LEAVE OF snum IN FRAME F-Main
     1134   DO:
     1135     assign snum.
     1136     if snum <> "" and contr-code = 0 then do :
     1137       run FindRec in this-procedure (input 1) .
     1138       if not itog-only then do :
     1139           enable itog-contract with frame F-Main.
     1140       end.
     1141     end.
     1142     if snum = "" and contr-code = 0 then do :
     1143       disable itog-contract with frame F-Main.
     1144     end.
     1145   END.
     1146   ON RETURN OF snum IN FRAME F-Main
     1147   DO:
     1148     assign snum.
     1149     if snum <> "" then do :
     1150       run FindRec in this-procedure (input 1) .
     1151       if not itog-only then do :
     1152           enable itog-contract with frame F-Main.
     1153       end.
     1154     end.
     1155     if snum = "" and contr-code = 0 then do :
     1156       disable itog-contract with frame F-Main.
     1157     end.
     1158   END.
     1159   if not this-procedure :persistent
     1160   then do:
     1161     message
     1162       vss-workfile vss-revision vss-description skip
     1163       "Ошибка при запуске процедуры" skip
     1164       "Данную процедуру следует запускать только с параметром persistent" skip
     1165       view-as alert-box error .
     1166     undo, return error .
     1167   end.
     1168     assign  frame F-Main  is-real is-post is-fin is-fo .
     1169     display is-real is-post is-fin is-fo with frame F-Main.
     1170     enable itog-contract with frame F-Main.
     1171   PROCEDURE disable_UI :
     1172     HIDE FRAME F-Main.
     1173     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1174   END PROCEDURE.
     1175   PROCEDURE FindRec :
     1176   define input  parameter typ as integer   no-undo .
     1177     do on error undo, return error return-value :
     1178         if typ = 0 then find first contract no-lock where contract.contract-code = contr-code  and contract.host-code = v-cntxt-host-code-obj no-error .
     1179         else            find first contract no-lock where contract.contract-prn-code = snum and contract.host-code = v-cntxt-host-code-obj no-error .
     1180         if available contract then do:
     1181           assign
     1182             contr-code = contract.contract-code
     1183             snum    = contract.contract-prn-code + " от " + string(contract.contract-date,"99/99/9999")
     1184           .
     1185         end.
     1186         else assign  contr-code = 0    snum = "" .
     1187         display contr-code snum with frame F-Main.
     1188     end.
     1189   end procedure.
     1190   PROCEDURE local-apply-layout :
     1191     RUN dispatch IN THIS-PROCEDURE ( INPUT 'apply-layout':U ) .
     1192   END PROCEDURE.
     1193   PROCEDURE my-report :
     1194   if is-fin or is-fo or is-post or is-real then
     1195       run rep/r-ob-sal.p ( itog-only, itog-contract, contr-code, is-date, is-fin, is-fo, is-post, is-real ) .
     1196     else message
     1197       "Не выбраны данные для печати"
     1198       view-as alert-box.
     1199   END PROCEDURE.
     1200   PROCEDURE my-var :
     1201     Assign frame F-Main itog-only itog-contract is-date is-fin is-fo is-post is-real .
     1202     find first clients no-lock where clients.obj-type = 'орг':U and clients.obj-code = v-cntxt-host-code-obj .
     1203     assign str1 = "Фирма: " + clients.obj-name +  chr(10) .
     1204     if contr-code > 0  then  assign ReportNAme = "Оборотно-сальдовая ведомость по договору " + snum .
     1205     else assign ReportNAme = "Оборотно-сальдовая ведомость по поставщикам с: " + string(x-date-start,"99/99/9999") + "г. по: "  + string(x-date-end, "99/99/9999") + "г." .
     1206   END PROCEDURE.
     1207   PROCEDURE state-changed :
     1208     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     1209     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     1210     CASE p-state:
     1211       when "link-changed":U then  DO:
     1212            Run my-var.
     1213            End.
     1214     END CASE.
     1215   END PROCEDURE.
