      662        LABEL "с разбивкой по датам"
      663        VIEW-AS TOGGLE-BOX
      664        SIZE 22.88 BY .83 NO-UNDO.
      665   DEFINE VARIABLE is-fin AS LOGICAL INITIAL yes
      666        LABEL "платежи"
      667        VIEW-AS TOGGLE-BOX
      668        SIZE 19 BY .83 NO-UNDO.
      669   DEFINE VARIABLE is-fo AS LOGICAL INITIAL yes
      670        LABEL "фин.обязательства"
      671        VIEW-AS TOGGLE-BOX
      672        SIZE 20.5 BY .83 NO-UNDO.
      673   DEFINE VARIABLE is-post AS LOGICAL INITIAL yes
      674        LABEL "поставка"
      675        VIEW-AS TOGGLE-BOX
      676        SIZE 19 BY .83 NO-UNDO.
      677   DEFINE VARIABLE is-real AS LOGICAL INITIAL yes
      678        LABEL "реализация"
      679        VIEW-AS TOGGLE-BOX
      680        SIZE 19 BY .83 NO-UNDO.
      681   DEFINE VARIABLE itog-contract AS LOGICAL INITIAL no
      682        LABEL "Показать все док-ты по договору"
      683        VIEW-AS TOGGLE-BOX
      684        SIZE 33.5 BY .83 NO-UNDO.
      685   DEFINE VARIABLE itog-only AS LOGICAL INITIAL no
      686        LABEL "только итоги"
      687        VIEW-AS TOGGLE-BOX
      688        SIZE 22.88 BY .83 NO-UNDO.
      689   DEFINE FRAME F-Main
      690        contr-code AT ROW 3 COL 6.5 COLON-ALIGNED
      691        BUTTON-contr AT ROW 3 COL 33.5
      692        is-post AT ROW 3 COL 40
      693        is-real AT ROW 4 COL 40
      694        snum AT ROW 4.5 COL 3.5 COLON-ALIGNED
      695        is-fo AT ROW 5 COL 40
      696        itog-contract AT ROW 5.75 COL 3
      697        is-fin AT ROW 6 COL 40
      698        itog-only AT ROW 9.08 COL 3.5
      699        is-date AT ROW 10.33 COL 3.5
      700        "Договор:" VIEW-AS TEXT
      701             SIZE 10 BY 1 AT ROW 1.5 COL 2.5
      702             FGCOLOR 4
      703        "Показать:" VIEW-AS TEXT
      704             SIZE 18 BY 1 AT ROW 7.83 COL 2.5
      705             FGCOLOR 4
      706        "Данные:" VIEW-AS TEXT
      707             SIZE 13.5 BY 1 AT ROW 1.5 COL 40.5
      708             FGCOLOR 4
      709        RECT-6 AT ROW 7.33 COL 1.5
      710        RECT-7 AT ROW 1.25 COL 1.5
      711        RECT-8 AT ROW 1.25 COL 38.5
      712       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      713            SIDE-LABELS NO-UNDERLINE THREE-D
      714            AT COL 1 ROW 1 SCROLLABLE .
      715   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      716   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      717   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      718   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      719   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      720   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      721   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      722   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      723         adm-object-hdl = FRAME F-Main:HANDLE.
      724   RUN ensure-broker.
      725   THIS-PROCEDURE:ADM-DATA =
      726        'ADM1.1~`':U +
      727        'SmartObject~`':U +
      728        '~`':U +
      729        'NO ~`':U +
      730        '~`':U +
      731        '~`':U +
      732        '~`':U +
      733        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      734           + "~`":U +
      735        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
      736        'Record-Source,Record-Target,TableIO-Target~`':U +
      737        '~`':U +
      738        '~`~`~`~`~`~`~`~`~`~`~`':U +
      739        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      740            THEN "^^":U
      741        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      742             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      743   PROCEDURE adm-apply-entry :
      744     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      745   END PROCEDURE.
      746   PROCEDURE adm-destroy :
      747    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      748   END PROCEDURE.
      749   PROCEDURE adm-disable :
      750       DISABLE RECT-6 RECT-7 RECT-8 contr-code BUTTON-contr is-post is-real snum is-fo is-fin itog-only is-date WITH FRAME F-Main.
      751       RUN dispatch ('disable-fields':U).
      752       RUN set-attribute-list ('ENABLED=no':U).
      753       RETURN.
      754   END PROCEDURE.
      755   PROCEDURE adm-edit-attribute-list :
      756         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
      757         RETURN.
      758   END PROCEDURE.
      759   PROCEDURE adm-enable :
      760       ENABLE UNLESS-HIDDEN RECT-6 RECT-7 RECT-8 contr-code BUTTON-contr is-post is-real snum is-fo is-fin itog-only is-date WITH FRAME F-Main.
      761       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      762       RUN set-attribute-list ('ENABLED=yes':U).
      763       RETURN.
      764   END PROCEDURE.
      765   PROCEDURE adm-exit :
      766        RUN notify ('exit':U).
      767     RETURN.
      768   END PROCEDURE.
      769   PROCEDURE adm-hide :
      770     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      771   END PROCEDURE.
      772   PROCEDURE adm-initialize :
      773     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      774   END PROCEDURE.
      775   PROCEDURE adm-show-errors :
      776       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      777       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      778           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      779       END.
      780       RETURN.
      781   END PROCEDURE.
      782   PROCEDURE adm-UIB-mode :
      783     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      784   END PROCEDURE.
      785   PROCEDURE adm-view :
      786     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      787   END PROCEDURE.
      788   PROCEDURE dispatch :
      789       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      790       RUN broker-dispatch IN adm-broker-hdl
      791           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      792       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      793   END PROCEDURE.
      794   PROCEDURE ensure-broker :
      795   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      796   IF RETURN-VALUE NE "ADM-Broker":U THEN
      797   DO:
      798       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      799       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      800   END.
      801   END PROCEDURE.
      802   PROCEDURE get-attribute :
      803     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      804     RUN broker-get-attribute IN adm-broker-hdl
      805         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      806     RETURN RETURN-VALUE.
      807   END PROCEDURE.
      808   PROCEDURE get-attribute-list :
      809     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      810     RUN broker-get-attribute-list IN adm-broker-hdl
      811         (INPUT THIS-PROCEDURE,
      812          INPUT ?,
      813          OUTPUT p-attr-list) NO-ERROR.
      814     RETURN.
      815   END PROCEDURE.
      816   PROCEDURE new-state :
      817     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      818     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      819     RETURN.
      820   END PROCEDURE.
      821   PROCEDURE notify :
      822     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      823     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      824     IF RETURN-VALUE = "ADM-ERROR":U THEN
      825         RETURN "ADM-ERROR":U.
      826     RETURN.
      827   END PROCEDURE.
      828   PROCEDURE set-attribute-list :
      829     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      830     RUN ensure-broker.
      831     RUN broker-set-attribute-list IN adm-broker-hdl
      832         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      833     RETURN.
      834   END PROCEDURE.
      835   PROCEDURE set-position :
      836       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      837       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      838       IF VALID-HANDLE(adm-object-hdl) THEN
      839       DO:
      840         ASSIGN adm-object-hdl:ROW    =   p-row
      841                adm-object-hdl:COLUMN =   p-col.
      842       END.
      843       RETURN.
      844   END PROCEDURE.
      845   PROCEDURE adm-display-fields :
      846       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
      847       RETURN.
      848   END PROCEDURE.
      849   PROCEDURE adm-open-query :
      850     RETURN.
      851   END PROCEDURE.
      852   PROCEDURE adm-row-changed :
      853         IF VALID-HANDLE(adm-object-hdl) THEN
      854           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      855         RUN notify ('row-available':U).
      856         RETURN.
      857   END PROCEDURE.
      858   PROCEDURE reposition-query :
      859       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
      860       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
      861       RETURN.
      862   END PROCEDURE.
      863     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
      864     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
      865     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
      866     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
      867     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
      868     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
      869     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
      870     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
      871     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      872     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
      873     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      874     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
      875     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
      876     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
      877     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
      878     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
      879     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
      880     IF "":U = "":U THEN
      881       RUN modify-list-attribute IN adm-broker-hdl
      882         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
      883     RUN use-create-on-add(?).
      884   PROCEDURE adm-add-record :
      885       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      886          "must have at least one Enabled Table to perform Add.":U
      887          VIEW-AS ALERT-BOX ERROR.
      888       RETURN.
      889   END PROCEDURE.
      890   PROCEDURE adm-assign-record :
