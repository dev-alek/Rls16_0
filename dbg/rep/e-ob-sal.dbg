      563   define new global shared variable g#library  as handle no-undo .
      564   define new global shared variable g#library2 as handle no-undo .
      565   define variable var-report-r-b as character no-undo .
      566   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      567   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      568     (output var-report-r-b
      569     )  .
      570   procedure proc-alt-shift-f2:
      571     if not ibs.th.gbl.gbl-var:rcode
      572   then
      573     run gbl\inidebug.p .
      574   end.
      575   procedure proc-alt-shift-f3:
      576     run gbl/prvssinf.p
      577       ( input this-procedure
      578       ) .
      579   end.
      580   define variable v-inform-launched as logical no-undo initial false .
      581   procedure proc-alt-shift-f4:
      582     define variable v-action as character no-undo .
      583     if v-inform-launched = false then do:
      584       assign
      585         v-inform-launched = true
      586       .
      587       run gbl/d-inform.w
      588         (  input self
      589         ,  input this-procedure
      590         , output v-action
      591         ) no-error .
      592       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      593       assign
      594         v-inform-launched = false
      595       .
      596     end.
      597   end.
      598   procedure proc-alt-f1:
      599     run gbl/corrhelp.p
      600       (input this-procedure
      601       ) .
      602   end .
      603   on alt-shift-f2 anywhere do:
      604     run proc-alt-shift-f2.
      605   end.
      606   on alt-shift-f3 anywhere do:
      607     run proc-alt-shift-f3 in this-procedure .
      608   end.
      609   on alt-shift-f4 anywhere do:
      610     run proc-alt-shift-f4 in this-procedure.
      611   end.
      612   on alt-f1 anywhere do:
      613     run proc-alt-f1 in this-procedure .
      614   end.
      615   DEFINE VARIABLE parParentProc     AS WIDGET-HANDLE NO-UNDO.
      616   def var contr-list as char no-undo.
      617   ASSIGN parParentProc =  my-handle .
      618   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      619     define variable v-cntxt-db-num        as integer   no-undo .
      620     define variable v-cntxt-userid        as character no-undo .
      621     define variable v-cntxt-level         as character no-undo .
      622     define variable v-cntxt-host-code-obj as integer   no-undo .
      623     define variable v-cntxt-obj-type      as character no-undo .
      624     define variable v-cntxt-obj-code      as integer   no-undo .
      625     define variable v-cntxt-db-num-obj    as integer   no-undo .
      626     define variable v-cntxt-is-admin      as logical   no-undo .
      627   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      628     run mainmenu_getcntxt in parparentproc
      629       (output v-cntxt-db-num
      630       ,output v-cntxt-userid
      631       ,output v-cntxt-level
      632       ,output v-cntxt-host-code-obj
      633       ,output v-cntxt-obj-type
      634       ,output v-cntxt-obj-code
      635       ,output v-cntxt-db-num-obj
      636       ,output v-cntxt-is-admin
      637       ) .
      638   DEFINE BUTTON BUTTON-contr
      639        IMAGE-UP FILE "btn-down-arrow":U
      640        IMAGE-DOWN FILE "btn-down-arrow":U
      641        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      642        LABEL "2"
      643        SIZE 2.88 BY 1.
      644   DEFINE VARIABLE contr-code AS INTEGER FORMAT ">>>>>>>>>9":U INITIAL 0
      645        LABEL "Вн.№"
      646        VIEW-AS FILL-IN
      647        SIZE 24.5 BY 1 NO-UNDO.
      648   DEFINE VARIABLE snum AS CHARACTER FORMAT "X(256)":U
      649        LABEL "№"
      650        VIEW-AS FILL-IN
      651        SIZE 30.5 BY 1 NO-UNDO.
      652   DEFINE RECTANGLE RECT-6
      653        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      654        SIZE 27.5 BY 4.17.
      655   DEFINE RECTANGLE RECT-7
      656        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      657        SIZE 36 BY 5.75.
      658   DEFINE RECTANGLE RECT-8
      659        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      660        SIZE 23 BY 5.75.
