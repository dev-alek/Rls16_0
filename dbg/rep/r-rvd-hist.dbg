     1625         '         <th style="text-align: center;">' + tt-report.loc1 + '</th>' skip
     1626         '         <th style="text-align: center;">' + tt-report.pl-name + '</th>' skip
     1627         '         <th style="text-align: center;">' + tt-report.gds-name + '</th>' skip
     1628         '         <th style="text-align: center;">' + tt-report.corr-dt + '</th>' skip
     1629         '         <th style="text-align: center;">' + tt-report.corr-par + '</th>' skip
     1630         '         <th style="text-align: center;">' + tt-report.rvd-reason + '</th>' skip
     1631         '         <th style="text-align: center;">' + tt-report.pl-state + '</th>' skip
     1632         '         <th style="text-align: center;">' + tt-report.corr-period + '</th>' skip
     1633         '         <th style="text-align: center;">' + tt-report.temp-state + '</th>' skip
     1634         '         <th style="text-align: center;">' + tt-report.dens-state + '</th>' skip
     1635         '         <th style="text-align: center;">' + tt-report.level-state + '</th>' skip
     1636         '         <th style="text-align: center;">' + tt-report.shift-num + '</th>' skip
     1637         '         <th style="text-align: center;">' + tt-report.ITSM-num + '</th>' skip
     1638         '         <th style="text-align: center;">' + tt-report.executor + '</th>' skip
     1639         '         <th style="text-align: center;">' + tt-report.initiator + '</th>' skip
     1640         '       </tr>' skip
     1641       .
     1642     end .
     1643     put stream OutStr-html unformatted
     1644         '     </tbody>' skip
     1645         '   </table>' skip
     1646         '  </body>' skip
     1647         ' </html>' skip
     1648         .
     1649     output stream OutStr-html close.
     1650     run prn-lib-reportviewer-report-name in this-procedure (
     1651         input this-procedure
     1652         ,input v-file-name-rep-htm
     1653         ) no-error.
     1654     if error-status:error then
     1655     do:
     1656         message return-value view-as alert-box.
     1657         return .
     1658     end.
     1659   end procedure .
     1660   procedure define-full-path-Report:
     1661       define input parameter p-rep-num as integer no-undo.
     1662       define output parameter p-file-name-rep-htm as character no-undo.
     1663       p-file-name-rep-htm = session:temp-directory + "rpt" + string(p-rep-num) + ".html".
     1664   end procedure.
     1665   procedure create-file:
     1666       define input parameter p-file-name as character no-undo.
     1667       output to value(string(p-file-name)).
     1668       output close.
     1669   end procedure.
     1670   PROCEDURE write-to-log :
     1671   define input param p-str as char no-undo.
     1672   do
     1673   on error undo, return error
     1674   :
     1675      message
     1676         p-str
     1677         skip
     1678      view-as alert-box error.
     1679   end.
     1680   END PROCEDURE.
