     1578         '         <th rowspan="2" style="text-align: center; font-weight:bold; background-color: silver;">Дата/время изменения режима</th>' skip
     1579         '         <th rowspan="2" style="text-align: center; font-weight:bold; background-color: silver;">Изменяемый параметр</th>' skip
