      751   define variable var-report-r-b as character no-undo .
      752   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      753   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      754     (output var-report-r-b
      755     )  .
      756   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      757   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      758   define variable v-waitfram-action01         as character   no-undo .
      759   define variable v-waitfram-action02         as character   no-undo .
      760   define variable v-waitfram-action03         as character   no-undo .
      761   define variable mWaitFramTextBeg            as character   no-undo.
      762   define variable mWaitFramTextEnd            as character   no-undo.
      763   define variable mWaitFramView               as logical     no-undo.
      764   define variable mWaitProcEvent              as logical     no-undo init yes.
      765   define variable mWaitFramInterval           as integer     no-undo init 1 .
      766   define variable mWaitFramStop               as logical     no-undo.
      767   define variable mWaitFramStopUser           as logical     no-undo.
      768   define variable mWaitFramStopTimeOut        as logical     no-undo.
      769   define variable mWaitFramStartProc          as datetime-tz no-undo.
      770   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      771   define button B-WaitFramStop auto-end-key
      772        label "Стоп"
      773        size 10 by 1 tooltip "Остоновить процесс".
      774   define button B-viewProcInfo
      775        label "Информация"
      776        size 15 by 1 tooltip "Информация о процесс".
      777   define frame waitfram
      778     v-waitfram-action01 format "x(72)" no-label skip
      779     v-waitfram-action02 format "x(72)" no-label skip
      780     v-waitfram-action03 format "x(72)" no-label skip
      781     B-viewProcInfo
      782     B-WaitFramStop at row 4 col 30
      783     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      784     .
      785   define new global shared variable mBatchMode as logical no-undo init ?.
      786   define variable mFramBachModHandle as handle no-undo.
      787   mFramBachModHandle = frame waitfram:handle.
      788   define variable mFameOldVis as logical no-undo.
      789   define variable mVisCUrentVin as logical no-undo.
      790   if session:batch-mode
      791   then
      792      mBatchMode = yes.
      793   if mBatchMode = ? then do:
      794     mVisCUrentVin = current-window:visible.
      795     mFameOldVis = mFramBachModHandle:visible.
      796     mFramBachModHandle:visible  = yes.
      797     mBatchMode = mFramBachModHandle:visible ne yes.
      798     mFramBachModHandle:visible = mFameOldVis.
      799     current-window:visible = mVisCUrentVin.
      800   end.
      801    if  log-manager:logfile-name ne ?
      802     then DO:
      803         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      804         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      805         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      806     end.
      807   on choose of B-WaitFramStop in frame waitfram
      808   do:
      809     mWaitFramStop = yes.
      810     mWaitFramStopUser = yes.
      811   end.
      812   function waitfram-check-timeout returns logical():
      813      define variable vtime as int64 no-undo.
      814      if mWaitFramStopTimeOut
      815      then
      816         return yes.
      817      vtime = ( now - mWaitFramStartProc ) / 1000 .
      818      if     mWaitFramTimeOut ne ?
      819         and mWaitFramTimeOut ne 0
      820         and mWaitFramTimeOut lt vtime
      821      then do:
      822         mWaitFramStopTimeOut = yes.
      823      end.
      824      return mWaitFramStopTimeOut.
      825   end.
      826   procedure waitfram-hide :
      827     if not session:batch-mode
      828     then do
      829     on error undo, return error return-value
      830     :
      831       pause 0 before-hide .
      832       if not mBatchMode then
      833         hide frame waitfram .
      834     if     not mWaitFramView
      835        and mWaitProcEvent
      836     then
      837       process events .
      838     end.
      839   end procedure.
      840   procedure waitfram-show :
      841     define input  parameter p-message as character no-undo .
      842     define variable v-left-margin as integer   no-undo .
      843     if not session:batch-mode
      844     then do
      845     on error undo, return error return-value
      846     :
      847       if length(p-message) <= 70 then do:
      848         assign
      849           v-left-margin = integer((70 - length(p-message)) / 2)
      850         .
      851         assign
      852           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      853         .
      854         assign
      855           v-waitfram-action01 = " "
      856           v-waitfram-action02 = " "
      857                                    + fill(" ", v-left-margin)
      858                                    + p-message
      859           v-waitfram-action03 = " "
      860         .
      861       end.
      862       else do:
      863         define variable vRindex1 as integer no-undo.
      864         define variable vRindex2 as integer no-undo.
      865         vRindex1 = r-index(p-message," ",70).
      866         if vRindex1 = 0
      867         then
      868            vRindex1 = 70.
      869         if length(p-message)  <= vRindex1 + 70 then do:
      870           assign
      871             v-waitfram-action01 = " "
      872             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      873             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      874           .
      875         end.
      876         else do:
      877           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      878           if vRindex2 <= vRindex1
      879           then
      880              vRindex2 = vRindex1 + 70.
      881           assign
      882             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      883             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      884             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      885           .
      886         end.
      887       end.
      888       B-viewProcInfo:visible   in frame waitfram = no.
      889       B-viewProcInfo:sensitive in frame waitfram = no.
      890       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      891       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      892       if  (   mWaitFramView
      893          or  mWaitProcEvent)
      894          and not mBatchMode
      895       then
      896          display
      897             v-waitfram-action01 skip
      898             v-waitfram-action02 skip
      899             v-waitfram-action03 skip
      900          with frame waitfram .
      901       if     mWaitFramView
      902          then do:
      903             if     mWaitFramInterval ne ?
      904                and not mBatchMode
      905             then
      906                wait-for go of frame waitfram pause mWaitFramInterval.
      907          end.
      908          else
      909             if     mWaitProcEvent
      910                and not mBatchMode
      911             then
      912                process events .
      913     end.
      914   end procedure.
      915      procedure waitfram-show-this:
      916         define input  parameter iInterval as int64 no-undo.
      917         define variable vtime as int64 no-undo.
      918         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      919         mWaitFramInterval = iInterval.
      920         run waitfram-show (substitute("&1&2 &3&4" ,
      921                                       mWaitFramTextBeg ,
      922                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      923                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      924                                       mWaitFramTextEnd
      925                                      )
      926                           ).
      927      end.
      928      procedure WaitFramRunPause:
      929         define input  parameter iInterval as dec no-undo.
      930         define variable vStart  as datetime-tz no-undo.
      931         define variable vend    as datetime-tz no-undo.
      932         define variable vint as int64 no-undo.
      933         define variable vOk as logical no-undo.
      934         vStart = now.
      935         vend   = vStart.
      936         publish "WaitFramPause" (iInterval,output vOk).
      937         vend   =  now.
      938         vint = vend - vStart.
      939         vint = iInterval - vint / 1000.
      940         if     not mWaitFramStop
      941            and (   vint > 0
      942                 or (    not vOk
      943                     and iInterval eq ?
      944                     )
      945                 )
      946         then
      947            run waitfram-show-this (iInterval).
      948         vend   =  now.
      949         vint = vend - vStart.
      950         vint = iInterval - vint / 1000.
      951         if     not mWaitFramStop
      952            and vint > 0
      953         then do:
      954            run gbl/pause.p (vint * 1000).
      955         end.
      956         if iInterval ne ?
      957         then
      958            publish "WaitFramStop".
      959         waitfram-check-timeout().
      960      end.
      961      procedure WaitFramWaitFor:
      962         define input  parameter iInterval as dec no-undo.
      963         assign
      964            mWaitFramStartProc   = now
      965            mWaitFramStopUser    = no
      966            mWaitFramStopTimeOut = no
      967         .
      968         block-wait:
      969         do while not mWaitFramStop:
      970            run WaitFramRunPause (iInterval).
      971            if  waitfram-check-timeout()
      972            then do:
      973               leave block-wait.
      974            end.
      975         end.
      976         run waitfram-hide.
      977      end.
      978   procedure waitfram-join :
      979     define input  parameter p-line-1  as character no-undo .
      980     define input  parameter p-line-2  as character no-undo .
      981     define input  parameter p-line-3  as character no-undo .
      982     define output parameter p-message as character no-undo .
      983     do
      984     on error undo, return error return-value
      985     :
      986       assign
      987         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      988                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      989                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      990       .
      991     end.
      992   end procedure.
      993   function waitfram-join-function returns character
      994     (input p-line-1 as character
      995     ,input p-line-2 as character
      996     ,input p-line-3 as character
      997     ).
      998     define variable v-message as character no-undo .
      999     run waitfram-join in this-procedure
     1000       (input  p-line-1
     1001       ,input  p-line-2
     1002       ,input  p-line-3
     1003       ,output v-message
     1004       ) .
     1005     return v-message .
     1006   end function .
     1007   function fnc-convert-dot-to-colon returns character
     1008       (input p-data as decimal, input p-accur as character, input p-num as integer) forward.
     1009   function fnc-convert-dot-to-colon returns character
     1010   (input p-data as decimal, input p-accur as character, input p-num as integer):
     1011       define variable result as character no-undo.
     1012       define variable v-str-result as character no-undo.
     1013       if p-data = ? then p-data = 0 .
     1014       p-data = round(p-data, p-num).
     1015       v-str-result = trim(replace(string(p-data, p-accur), ".", ",")).
     1016       return v-str-result.
     1017   END FUNCTION.
     1018   define variable is-petrol   as logical   no-undo.
     1019   define variable is-pieces   as logical   no-undo.
     1020   define variable store-name as character no-undo.
     1021   define variable v-count as integer initial 0  no-undo .
     1022   define variable v-full-path-RepView as character no-undo.
     1023   define variable v-file-name-rep-htm as character no-undo.
     1024   define variable g#report-num        as integer   no-undo.
     1025   define variable v-report-name       as character no-undo.
     1026   define variable v-azk-list          as character no-undo .
     1027   define variable v-org-list          as character no-undo .
     1028   define variable v-period            as character no-undo .
     1029   define variable v-legend1           as character no-undo .
     1030   define variable v-legend2           as character no-undo .
     1031   define variable v-legend3           as character no-undo .
     1032   define variable x-Time-Start        as integer   no-undo init -1 .
     1033   define variable x-Time-End          as integer   no-undo init -1 .
     1034   define stream OutStr-html.
     1035   define buffer bf-gds-list for gds-list .
     1036   define buffer buf_clients for ub.clients .
     1037   define buffer buf_goods for ub.goods .
     1038   define buffer buf_units for ub.units  .
     1039   define buffer buf_shift-obj for ub.shift-obj .
     1040   define BUFFER bf_c-user-log for ub.c-user-log .
     1041   define temp-table tt-report no-undo
     1042     field firm-name     as character
     1043     field obj-type      as character
     1044     field obj-code      as integer
     1045     field host-code     as integer
     1046     field obj-name      as character
     1047     field pl-code       as integer
     1048     field loc1          as character
     1049     field pl-name       as character
     1050     field gds-code      as integer
     1051     field gds-name      as character
     1052     field corr-dt       as character
     1053     field corr-date     as date
     1054     field corr-time     as int64
     1055     field corr-par      as character
     1056     field rvd-reason    as character
     1057     field pl-state      as character
     1058     field corr-period   as character
     1059     field temp-state    as character
     1060     field dens-state    as character
     1061     field level-state   as character
     1062     field shift-num     as character
     1063     field ITSM-num      as character
     1064     field executor      as character
     1065     field initiator     as character
     1066   .
     1067   if not can-find( first obj-list ) then do:
     1068     message "Вы не выбрали объект." view-as alert-box error.
     1069     return.
     1070   end.
     1071   find first obj-list.
     1072   if not can-find( first gds-list )
     1073   then do:
     1074     for each buf_units no-lock where
     1075           lookup( 'топ':U, buf_units.type) > 0,
     1076       each buf_goods no-lock where
     1077             buf_goods.unit-base = buf_units.unit-name
     1078             :
     1079       create gds-list.
     1080       buffer-copy buf_goods to  gds-list .
     1081     end.
     1082   end.
     1083   find first gds-list.
     1084   for each bf-gds-list :
     1085     find first ub.goods no-lock where
     1086                 ub.goods.artic     = bf-gds-list.artic     and
     1087                 ub.goods.prod-type = bf-gds-list.prod-type and
     1088                 ub.goods.prod-code = bf-gds-list.prod-code no-error.
     1089     if not available ub.goods then do: next. end.
     1090   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     1091     (
     1092        input ub.goods.artic
     1093     ,  input ub.goods.prod-type
     1094     ,  input ub.goods.prod-code
     1095     , output is-petrol
     1096     , output is-pieces
     1097     ) no-error.
     1098     if error-status :error
     1099       or is-petrol <> yes
     1100       or is-pieces <> no
     1101     then do:
     1102       message
     1103         substitute("Отчет может быть запущен только для топливного товара") skip
     1104         view-as alert-box error .
     1105       return .
     1106     end.
     1107   end.
     1108   if x-TOG-Shift
     1109   then do :
     1110     for each obj-list no-lock :
     1111       find last buf_shift-obj no-lock where buf_shift-obj.obj-type = obj-list.obj-type
     1112                                         and buf_shift-obj.obj-code = obj-list.obj-code
     1113                                         and buf_shift-obj.shift-date <= x-Date-End
     1114                                         and buf_shift-obj.shift-num <= x-Shift-End
     1115                                         no-error .
     1116       if available buf_shift-obj
     1117       then do :
     1118         if buf_shift-obj.close-date = ?
     1119         then do :
     1120           x-Date-End = today .
     1121           x-Time-End = time .
     1122         end .
     1123         else do :
     1124           if buf_shift-obj.close-date >= x-Date-End
     1125           then do :
     1126             if (buf_shift-obj.close-date = x-Date-End and buf_shift-obj.close-time > x-Time-End)
     1127             or buf_shift-obj.close-date > x-Date-End
     1128             then x-Time-End = buf_shift-obj.close-time .
     1129             x-Date-End = buf_shift-obj.close-date .
     1130           end .
     1131         end .
     1132       end .
     1133       find first buf_shift-obj no-lock where buf_shift-obj.obj-type = obj-list.obj-type
     1134                                          and buf_shift-obj.obj-code = obj-list.obj-code
     1135                                          and buf_shift-obj.shift-date = x-Date-Start
     1136                                          and buf_shift-obj.shift-num >= x-Shift-Start
     1137                                          no-error .
     1138       if available buf_shift-obj
     1139       then do :
     1140         if x-Time-Start = -1
     1141         then x-Time-Start = buf_shift-obj.open-time .
     1142         if buf_shift-obj.open-time < x-Time-Start
     1143         then x-Time-Start = buf_shift-obj.open-time .
     1144       end .
     1145     end .
     1146   end .
     1147   if x-TOG-Shift
     1148   then do :
     1149     v-period = "Смены с " + string(x-Shift-Start) +
     1150                " по " + string(x-Shift-End) + chr(10) +
     1151                "За период с " + string(x-Date-Start) +
     1152                " по " + string(x-Date-End)
     1153                .
     1154   end .
     1155   else do :
     1156     v-period = "За период с " + string(x-Date-Start) +
     1157                " по " + string(x-Date-End)
     1158                .
     1159   end .
     1160   v-legend1 = "А – автоматический ввод данных; Р – ручной ввод данных; ПА – полуавтоматический ввод данных;" .
     1161   v-legend2 = "Расшифровка для столбца 9 - Указывается режим измерения для резервуара после его изменения - А: Если в системе установлен маркер «Измеряется приборами» и РВД по параметрам отключен;   Р: Если в системе не установлен маркер «Измеряется приборами или в системе установлен маркер «Измеряется приборами», но разрешение РВД установлено для всех трех параметров» ПА: Если в системе установлен маркер «Измеряется приборами», но разрешение РВД установлено для одного или двух параметров" .
     1162   v-legend3 = "Расшифровка для столбцов 7,11,12,13 - 7: Указывается режим измерения в который переводится параметр/параметры (А или Р); 11,12,13: Указывается режим измерения для параметров после его изменения (А или Р)" .
     1163   run waitfram-show in this-procedure ( "ЖДИТЕ... Формирование отчёта") .
     1164   run make-rep .
     1165   run print-rep .
     1166   run waitfram-hide in this-procedure .
     1167   procedure make-rep :
     1168     define variable v-shift-num as integer no-undo .
     1169     define variable v-shift-date as date no-undo .
     1170     define variable v-obj-type  as character no-undo .
     1171     define variable v-obj-code  as integer no-undo .
     1172     define variable v-pl-code   as integer no-undo .
     1173     define variable v-rvd-reason-code as character no-undo .
     1174     define variable v-host-code as integer no-undo .
     1175     define variable v-RVD-on    as logical no-undo .
     1176     define variable v-RVD-params as character no-undo .
     1177     define variable v-RVD-dens  as logical no-undo .
     1178     define variable v-RVD-temp  as logical no-undo .
     1179     define variable v-RVD-level as logical no-undo .
     1180     define variable v-date1 as date no-undo .
     1181     define variable v-date2 as date no-undo .
     1182     define variable v-date-diff as integer no-undo .
     1183     define variable v-time1 as integer no-undo .
     1184     define variable v-time2 as integer no-undo .
     1185     define variable v-time-diff as integer no-undo .
     1186     define variable v-is-meas as logical no-undo .
     1187     define variable v-found-next as logical no-undo .
     1188     define buffer buf_pl-gds for ub.pl-gds .
     1189     define buffer buf_ext-classif for ub.ext-classif .
     1190     define buffer buf_place for ub.place .
     1191     define buffer buf_goods for ub.goods .
     1192     define buffer buf_user-account for ub.user-account .
     1193     define buffer buf_c-user-log for ub.c-user-log .
     1194     define buffer buf_clients for ub.clients .
     1195     define buffer buf2_clients for ub.clients .
     1196     empty temp-table tt-report .
     1197     v-org-list = "" .
     1198     v-azk-list = "" .
     1199     for each buf_clients no-lock,
     1200     first obj-list no-lock where obj-list.obj-type = buf_clients.obj-type
     1201                              and obj-list.obj-code = buf_clients.obj-code
     1202                              break by buf_clients.host-code
     1203                              :
     1204       if first-of(buf_clients.host-code)
     1205       then do :
     1206         for first buf2_clients no-lock where buf2_clients.obj-type = 'орг':U
     1207                                          and buf2_clients.obj-code = buf_clients.host-code
     1208                                          :
     1209           v-org-list = v-org-list + buf2_clients.obj-name + ", " .
     1210         end .
     1211       end .
     1212       v-azk-list = v-azk-list + buf_clients.obj-name + ", " .
     1213     end .
     1214     v-org-list = trim(v-org-list, ", ") .
     1215     v-azk-list = trim(v-azk-list, ", ") .
     1216     user-log_ :
     1217     for each bf_c-user-log no-lock where bf_c-user-log.corr-date >= x-Date-Start
     1218                                      and bf_c-user-log.corr-date <= x-Date-End
     1219                                      and bf_c-user-log.head-table = 'rvd-reasons':U
     1220                                      break by bf_c-user-log.corr-date by bf_c-user-log.corr-time
     1221                                      :
     1222       if not p-inv-RVD
     1223       and num-entries(bf_c-user-log.head-table-key, chr(6)) = 23
     1224       and entry(15, bf_c-user-log.head-table-key, chr(6)) > ""
     1225       then next user-log_ .
     1226       v-obj-type = entry(1, bf_c-user-log.head-table-key, chr(6)) .
     1227       v-obj-code = integer(entry(2, bf_c-user-log.head-table-key, chr(6))) .
     1228       if not can-find( first obj-list where obj-list.obj-type = v-obj-type and obj-list.obj-code = v-obj-code )
     1229       then next user-log_ .
     1230       v-shift-date = date(entry(3, bf_c-user-log.head-table-key, chr(6))) .
     1231       v-shift-num = integer(entry(4, bf_c-user-log.head-table-key, chr(6))) .
     1232       if x-TOG-Shift
     1233       then do :
     1234         if v-shift-num = 0
     1235         then do :
     1236           if v-shift-date < x-Date-Start
     1237           or v-shift-date > x-Date-end
     1238           then next user-log_ .
     1239         end .
     1240         else do :
     1241           if (v-shift-date = x-Date-Start
     1242           and v-shift-num < x-Shift-Start)
     1243           or v-shift-date < x-Date-Start
     1244           then next user-log_ .
     1245           if (v-shift-date = x-Date-End
     1246           and v-shift-num > x-Shift-End)
     1247           or v-shift-date > x-Date-end
     1248           then next user-log_ .
     1249         end .
     1250         if x-Time-End >= 0
     1251         then do :
     1252           if bf_c-user-log.corr-date = x-Date-end
     1253           and bf_c-user-log.corr-time > (x-Time-End + 59)
     1254           then next user-log_ .
     1255         end .
     1256         if x-Time-Start >= 0
     1257         then do :
     1258           if bf_c-user-log.corr-date = x-Date-Start
     1259           and bf_c-user-log.corr-time < x-Time-Start
     1260           then next user-log_ .
     1261         end .
     1262       end .
     1263       v-pl-code = integer(entry(5, bf_c-user-log.head-table-key, chr(6))) .
     1264       find first buf_pl-gds no-lock where buf_pl-gds.obj-type = v-obj-type
     1265                                       and buf_pl-gds.obj-code = v-obj-code
     1266                                       and buf_pl-gds.pl-code  = v-pl-code
     1267                                       no-error .
     1268       if not available buf_pl-gds
     1269       then next user-log_ .
     1270       if not can-find( first gds-list where gds-list.gds-code = buf_pl-gds.gds-code )
     1271       then next user-log_ .
     1272       v-rvd-reason-code = entry(8, bf_c-user-log.head-table-key, chr(6)) .
     1273       find first buf_ext-classif no-lock where buf_ext-classif.CharKey_One = v-rvd-reason-code
     1274                                            and buf_ext-classif.classif-subject = 'rvd-reason':U
     1275                                            and buf_ext-classif.classif-name = 'rvd-reason':U
     1276                                            no-error .
     1277       if not available buf_ext-classif
     1278       then next user-log_ .
     1279       v-RVD-params = entry(6, bf_c-user-log.head-table-key, chr(6)) .
     1280       v-RVD-on = logical(entry(7, bf_c-user-log.head-table-key, chr(6))) .
     1281       v-RVD-temp = logical(entry(11, bf_c-user-log.head-table-key, chr(6))) .
     1282       v-RVD-dens = logical(entry(12, bf_c-user-log.head-table-key, chr(6))) .
     1283       v-RVD-level = logical(entry(13, bf_c-user-log.head-table-key, chr(6))) .
     1284       if num-entries(bf_c-user-log.head-table-key, chr(6)) > 13
     1285       then
     1286         v-is-meas = logical(entry(14, bf_c-user-log.head-table-key, chr(6))) .
     1287       create tt-report .
     1288       assign
     1289         tt-report.obj-type    = v-obj-type
     1290         tt-report.obj-code    = v-obj-code
     1291         tt-report.pl-code     = v-pl-code
     1292         tt-report.gds-code    = buf_pl-gds.gds-code
     1293         tt-report.rvd-reason  = buf_ext-classif.CharKey_Two
     1294         tt-report.corr-date   = bf_c-user-log.corr-date
     1295         tt-report.corr-time   = bf_c-user-log.corr-time
     1296         tt-report.corr-dt     = string(bf_c-user-log.corr-date, "99.99.9999") + " " + string(bf_c-user-log.corr-time, "hh:mm")
     1297         tt-report.corr-dt     = replace(tt-report.corr-dt, ":", "-")
     1298         tt-report.shift-num   = string(v-shift-num)
     1299         tt-report.ITSM-num    = entry(9, bf_c-user-log.head-table-key, chr(6))
     1300         tt-report.initiator   = entry(10, bf_c-user-log.head-table-key, chr(6))
     1301         tt-report.temp-state  = if v-RVD-temp then "Р" else "А"
     1302         tt-report.dens-state  = if v-RVD-dens then "Р" else "А"
     1303         tt-report.level-state = if v-RVD-level then "Р" else "А"
     1304       .
     1305       for first buf_user-account no-lock where buf_user-account.user-id = bf_c-user-log.corr-user-name :
     1306         assign tt-report.executor = buf_user-account.nik .
     1307       end .
     1308       for first buf_clients no-lock where buf_clients.obj-type = v-obj-type
     1309                                       and buf_clients.obj-code = v-obj-code
     1310                                       :
     1311         assign
     1312           v-host-code = buf_clients.host-code
     1313           tt-report.obj-name = buf_clients.obj-name
     1314           tt-report.host-code = v-host-code
     1315         .
     1316       end .
     1317       for first buf_clients no-lock where buf_clients.obj-type = 'орг':U
     1318                                       and buf_clients.obj-code = v-host-code
     1319                                       :
     1320         assign tt-report.firm-name = buf_clients.obj-name .
     1321       end .
     1322       for first buf_place no-lock where buf_place.obj-type = v-obj-type
     1323                                     and buf_place.obj-code = v-obj-code
     1324                                     and buf_place.pl-code  = v-pl-code
     1325                                     :
     1326         assign
     1327           tt-report.pl-name = buf_place.pl-name
     1328           tt-report.loc1    = buf_place.loc1
     1329         .
     1330       end .
     1331       for first buf_goods no-lock where buf_goods.gds-code = tt-report.gds-code :
     1332         assign tt-report.gds-name = buf_goods.gds-name .
     1333       end .
     1334       if can-do(v-RVD-params, 'p')
     1335       and can-do(v-RVD-params, 'T')
     1336       and can-do(v-RVD-params, 'l')
     1337       then do :
     1338         assign tt-report.corr-par = if v-RVD-on then "Р" else "А" .
     1339       end .
     1340       else
     1341       if can-do(v-RVD-params, 'p')
     1342       and can-do(v-RVD-params, 'T')
     1343       and not can-do(v-RVD-params, 'l')
     1344       then do :
     1345         assign tt-report.corr-par = if v-RVD-on then "Р(Температура, Плотность)" else "А(Температура, Плотность)" .
     1346       end .
     1347       else
     1348       if can-do(v-RVD-params, 'p')
     1349       and not can-do(v-RVD-params, 'T')
     1350       and not can-do(v-RVD-params, 'l')
     1351       then do :
     1352         assign tt-report.corr-par = if v-RVD-on then "Р(Плотность)" else "А(Плотность)" .
     1353       end .
     1354       else
     1355       if can-do(v-RVD-params, 'p')
     1356       and not can-do(v-RVD-params, 'T')
     1357       and can-do(v-RVD-params, 'l')
     1358       then do :
     1359         assign tt-report.corr-par = if v-RVD-on then "Р(Уровень, Плотность)" else "А(Уровень, Плотность)" .
     1360       end .
     1361       else
     1362       if not can-do(v-RVD-params, 'p')
     1363       and not can-do(v-RVD-params, 'T')
     1364       and can-do(v-RVD-params, 'l')
     1365       then do :
     1366         assign tt-report.corr-par = if v-RVD-on then "Р(Уровень)" else "А(Уровень)" .
     1367       end .
     1368       else
     1369       if not can-do(v-RVD-params, 'p')
     1370       and can-do(v-RVD-params, 'T')
     1371       and can-do(v-RVD-params, 'l')
     1372       then do :
     1373         assign tt-report.corr-par = if v-RVD-on then "Р(Уровень, Температура)" else "А(Уровень, Температура)" .
     1374       end .
     1375       else
     1376       if not can-do(v-RVD-params, 'p')
     1377       and can-do(v-RVD-params, 'T')
     1378       and not can-do(v-RVD-params, 'l')
     1379       then do :
     1380         assign tt-report.corr-par = if v-RVD-on then "Р(Температура)" else "А(Температура)" .
     1381       end .
     1382       if (v-RVD-dens
     1383       and v-RVD-level
     1384       and v-RVD-temp)
     1385       or
     1386       (not v-is-meas)
     1387       then do :
     1388         assign tt-report.pl-state = "Р" .
     1389       end .
     1390       else
     1391       if not v-RVD-dens
     1392       and not v-RVD-level
     1393       and not v-RVD-temp
     1394       then do :
     1395         assign tt-report.pl-state = "А" .
     1396       end .
     1397       else
     1398       if v-RVD-dens
     1399       and v-RVD-level
     1400       and not v-RVD-temp
     1401       then do :
     1402         assign tt-report.pl-state = "ПА(Уровень, Плотность)" .
     1403       end .
     1404       else
     1405       if v-RVD-dens
     1406       and not v-RVD-level
     1407       and v-RVD-temp
     1408       then do :
     1409         assign tt-report.pl-state = "ПА(Температура, Плотность)" .
     1410       end .
     1411       else
     1412       if not v-RVD-dens
     1413       and v-RVD-level
     1414       and v-RVD-temp
     1415       then do :
     1416         assign tt-report.pl-state = "ПА(Уровень, Температура)" .
     1417       end .
     1418       else
     1419       if v-RVD-dens
     1420       and not v-RVD-level
     1421       and not v-RVD-temp
     1422       then do :
     1423         assign tt-report.pl-state = "ПА(Плотность)" .
     1424       end .
     1425       else
     1426       if not v-RVD-dens
     1427       and v-RVD-level
     1428       and not v-RVD-temp
     1429       then do :
     1430         assign tt-report.pl-state = "ПА(Уровень)" .
     1431       end .
     1432       else
     1433       if not v-RVD-dens
     1434       and not v-RVD-level
     1435       and v-RVD-temp
     1436       then do :
     1437         assign tt-report.pl-state = "ПА(Температура)" .
     1438       end .
     1439       if num-entries(bf_c-user-log.head-table-key, chr(6)) = 23
     1440       and entry(15, bf_c-user-log.head-table-key, chr(6)) > ""
     1441       then do :
     1442         assign tt-report.corr-period = "0" .
     1443       end .
     1444       else do :
     1445         v-found-next = false .
     1446         v-date1 = bf_c-user-log.corr-date .
     1447         v-time1 = bf_c-user-log.corr-time .
     1448         find-next_ :
     1449         for each buf_c-user-log no-lock where buf_c-user-log.head-table = 'rvd-reasons':U
     1450                                           and (buf_c-user-log.corr-date > bf_c-user-log.corr-date
     1451                                             or (buf_c-user-log.corr-date = bf_c-user-log.corr-date
     1452                                             and buf_c-user-log.corr-time > bf_c-user-log.corr-time))
     1453                                             break by buf_c-user-log.corr-date by buf_c-user-log.corr-time
     1454                                             :
     1455           if num-entries(buf_c-user-log.head-table-key, chr(6)) = 23
     1456           and entry(15, buf_c-user-log.head-table-key, chr(6)) > ""
     1457           then next find-next_ .
     1458           if v-obj-type = entry(1, buf_c-user-log.head-table-key, chr(6))
     1459           and v-obj-code = integer(entry(2, buf_c-user-log.head-table-key, chr(6)))
     1460           and v-pl-code = integer(entry(5, buf_c-user-log.head-table-key, chr(6)))
     1461           then do :
     1462             v-date2 = buf_c-user-log.corr-date .
     1463             v-time2 = buf_c-user-log.corr-time .
     1464             v-found-next = true .
     1465             leave find-next_ .
     1466           end .
     1467         end .
     1468         if not v-found-next
     1469         then do :
     1470           v-date2 = today .
     1471           v-time2 = time .
     1472         end .
     1473         v-date-diff = v-date2 - v-date1 .
     1474         v-time-diff = v-time2 - v-time1 .
     1475         if v-time-diff < 0
     1476         then do :
     1477           v-date-diff = v-date-diff - 1 .
     1478           v-time-diff = v-time-diff + 86400 .
     1479         end .
     1480         assign tt-report.corr-period = string(v-date-diff) + "д. " + string(v-time-diff, "hh:mm:ss") .
     1481       end .
     1482     end .
     1483   end procedure .
     1484   procedure print-rep :
     1485     run gbl/getrpnum.p (output g#report-num).
     1486     run define-full-path-Report(input g#report-num, output v-file-name-rep-htm).
     1487     run create-file(v-file-name-rep-htm).
     1488     output stream OutStr-html to value(v-file-name-rep-htm) convert target 'UTF-8' .
     1489     put stream OutStr-html unformatted
     1490         "<!DOCTYPE HTML>" skip
     1491         ' <html>' skip
     1492         '  <head>' skip
     1493         '   <meta charset="utf-8">' skip
     1494         '    <style type="text/css">' skip
     1495         '      table ' + chr(123) + ' border-collapse: collapse; font-size: 9pt; table-layout: fixed; width: 500px; padding: 3px; ' + chr(125) skip
     1496         '      td ' + chr(123) ' border: 1px black ridge; word-wrap:break-word; ' + chr(125) skip
     1497         '      htm' skip
     1498         '      .rotate ' + chr(123) skip
     1499         '        -webkit-transform: rotate(-90deg);' skip
     1500         '        -moz-transform: rotate(-90deg);' skip
     1501         '        -ms-transform: rotate(-90deg);' skip
     1502         '        -o-transform: rotate(-90deg);' skip
     1503         '        transform: rotate(-90deg);' skip
     1504         '        -webkit-transform-origin: 50% 50%;' skip
     1505         '        -moz-transform-origin: 50% 50%;' skip
     1506         '        -ms-transform-origin: 50% 50%;' skip
     1507         '        -o-transform-origin: 50% 50%;' skip
     1508         '        transform-origin: 50% 50%;' skip
     1509         '        filter: progid:DXImageTransform.Microsoft.BasicImage(rotation=3);' skip
     1510         '          ' + chr(125) skip
     1511         '            th' + ' ' + chr(123) skip
     1512         '            border: 1px black solid;' skip
     1513         '            word-wrap: break-word;' skip
     1514         '          ' + chr(125) skip
     1515         '   </style>' skip
     1516         '  </head>' skip
     1517     .
     1518     put stream OutStr-html unformatted
     1519         '<body>' skip
     1520         '<table name="Лист1"  fit_to_page="true" orientation="landscape" CELLSPACING="0" BORDER="0">'skip
     1521         '<thead>' skip
     1522     .
     1523     put stream OutStr-html unformatted
     1524         '<tr class="set_columns">' skip
     1525         '<td style="width: 60px; border: none;"></td>' skip
     1526         '<td style="width: 60px; border: none;"></td>' skip
