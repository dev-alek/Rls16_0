       75   procedure prn-lib-prn-file :
       76     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
       77     define input parameter p-DIsabledoptions as integer no-undo .
       78     define variable v-report-name as character no-undo .
       79     define variable v-user-action as character no-undo .
       80     define variable v-printed     as logical   no-undo .
       81     define variable v-exist       as logical   no-undo .
       82     do
       83       on error undo, return error
       84       :
       85       run prn-lib-get-report-name  in this-procedure (
       86         input parParentProc
       87         ,output v-report-name
       88         ).
       89   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       90   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
       91     (input  v-report-name
       92     ,input  2
       93     ,output v-exist
       94     )  .
       95       if NOT v-exist then
       96       DO:
       97         Message
       98           "Нет заданий на печать ! "
       99           view-as alert-box .
      100         Return  .
      101       End.
      102       run gbl/prnfilen.w
      103         (input  ""
      104         ,input  p-DisabledOptions
      105         ,input  string(v-report-name )
      106         ,input  7
      107         ,output v-user-action
      108         ,output v-printed
      109         ) .
      110       if v-printed then
      111       do:
      112         return "YES" .
      113       end.
      114       else
      115       do:
      116         return "NO" .
      117       end.
      118     end.
      119   end procedure.
      120   procedure prn-lib-open-stream :
      121     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      122     define input parameter p-page-size    as integer no-undo .
      123     define input parameter p-is-stream    as logical no-undo .
      124     define input parameter p-append       as logical no-undo .
      125     define variable v-report-name as character no-undo .
      126     do
      127       on error undo, return error
      128       :
      129       run prn-lib-get-report-name  in this-procedure (
      130         input parParentProc
      131         ,output v-report-name
      132         ).
      133       if p-is-stream then
      134       do:
      135         if p-append then
      136         do:
      137           output stream PrnLibStream to value( v-report-name )
      138             page-size value(p-page-size) append .
      139         end.
      140         if not p-append then
      141         do:
      142           output stream PrnLibStream to value( v-report-name )
      143             page-size value(p-page-size) .
      144         end.
      145       end.
      146       if not p-is-stream then
      147       do:
      148         if p-append then
      149         do:
      150           output to value( v-report-name )
      151             page-size value(p-page-size) append .
      152         end.
      153         if not p-append then
      154         do:
      155           output to value( v-report-name )
      156             page-size value(p-page-size) .
      157         end.
      158       end.
      159     end.
      160   end procedure.
      161   procedure prn-lib-open-exp :
      162     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      163     define input parameter p-is-stream    as logical no-undo .
      164     define input parameter p-is-append    as logical no-undo .
      165     define output parameter p-ReportFileName as char init "report" no-undo.
      166     define output parameter p-process as logical no-undo .
      167     define variable glog as logical no-undo .
      168     do
      169       on error undo, return error
      170       :
      171       SYSTEM-DIALOG GET-FILE p-ReportFileName
      172         TITLE      "Укажите путь"
      173         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      174         ASK-OVERWRITE
      175         CREATE-TEST-FILE
      176         SAVE-AS
      177         USE-FILENAME
      178         DEFAULT-EXTENSION "txt"
      179         UPDATE glog
      180         .
      181       if not glog then  return.
      182       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      183       if p-is-stream then
      184       do:
      185         if p-is-append then
      186         do:
      187           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      188         end.
      189         else
      190         do:
      191           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      192         end.
      193       end.
      194       else
      195       do:
      196         if p-is-append then
      197         do:
      198           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      199         end.
      200         else
      201         do:
      202           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      203         end.
      204       end.
      205       p-process = yes.
      206     end.
      207   end procedure.
      208   procedure prn-lib-get-report-name :
      209     define input parameter parParentProc  as widget-handle no-undo.
      210     define output parameter p-report-name as character no-undo .
      211     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      212   end procedure.
      213   procedure prn-lib-reportviewer-report-name :
      214     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      215     define input parameter p-report-name-html as character no-undo .
      216     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      217   end procedure.
      218   procedure prn-lib-reportviewer :
      219     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      220     define input parameter p-report-name-html as character no-undo .
      221     define input parameter p-param        as character no-undo .
      222     define variable v-excel           as character no-undo init 'TRUE' .
      223     define variable v-value-character as character no-undo .
      224     define variable v-value-integer   as character no-undo .
      225     define variable v-value-date      as date      no-undo .
      226     define variable v-value-decimal   as decimal   no-undo .
      227     define variable rep-excel         as logical   no-undo .
      228     define variable excel-string      as character no-undo .
      229     define variable v-param-type      as character no-undo .
      230     define variable v-tth             as handle    no-undo .
      231     run adm/shattri.p (
      232       input "get":U
      233       ,input  ""
      234       ,input  0
      235       ,input  'report-glob':U
      236       ,input  'rep-excel':U
      237       ,output v-value-character
      238       ,output v-value-date
      239       ,output v-value-decimal
      240       ,output v-value-integer
      241       ,output rep-excel
      242       ,output v-param-type
      243       ,INPUT-OUTPUT table-handle v-tth
      244       )  .
      245     if rep-excel then v-excel = "TRUE" .
      246     else v-excel = "FALSE" .
      247     if p-param eq ""
      248     then
      249        p-param = "EXCEL:" + v-excel.
      250     else
      251        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      252     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      253   end procedure.
