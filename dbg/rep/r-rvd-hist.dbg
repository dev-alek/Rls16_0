        4   define variable vss-author      as character no-undo initial "$Author: SSlivenko $":U .
        5   define variable vss-date        as character no-undo initial "$Date: 2023/03/29 08:47:58 $":U .
        6   define variable vss-workfile    as character no-undo initial "$Workfile: r-RVD-hist.p $":U .
        7   define variable vss-archive     as character no-undo initial "$Archive: rep/r-RVD-hist.p $":U .
