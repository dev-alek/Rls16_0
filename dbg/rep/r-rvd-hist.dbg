     1583         '         <th rowspan="2" style="text-align: center; font-weight:bold; background-color: silver;">Номер заявки ITSM/Номер приказа о проведении инвентаризации</th>' skip
     1584         '         <th rowspan="2" style="text-align: center; font-weight:bold; background-color: silver;">Исполнитель заявки</th>' skip
     1585         '         <th rowspan="2" style="text-align: center; font-weight:bold; background-color: silver;">Инициатор заявки/Сотрудник Инв. Комиссии</th>' skip
     1586         '       </tr>' skip
     1587         '       <tr>' skip
     1588         '         <th style="text-align: center; font-weight:bold; background-color: silver;">Резервуар</th>' skip
     1589         '         <th style="text-align: center; font-weight:bold; background-color: silver;">Длительность состояния по резервуару</th>' skip
     1590         '         <th style="text-align: center; font-weight:bold; background-color: silver;">Температура</th>' skip
     1591         '         <th style="text-align: center; font-weight:bold; background-color: silver;">Плотность</th>' skip
     1592         '         <th style="text-align: center; font-weight:bold; background-color: silver;">Уровень</th>' skip
     1593         '       </tr>' skip
     1594         '       <tr>' skip
     1595         '         <th num="" style="text-align: center;  font-weight:bold; background-color: silver;">1</th>' skip
     1596         '         <th num="" style="text-align: center;  font-weight:bold; background-color: silver;">2</th>' skip
     1597         '         <th num="" style="text-align: center;  font-weight:bold; background-color: silver;">3</th>' skip
     1598         '         <th num="" style="text-align: center;  font-weight:bold; background-color: silver;">4</th>' skip
     1599         '         <th num="" style="text-align: center;  font-weight:bold; background-color: silver;">5</th>' skip
     1600         '         <th num="" style="text-align: center;  font-weight:bold; background-color: silver;">6</th>' skip
     1601         '         <th num="" style="text-align: center;  font-weight:bold; background-color: silver;">7</th>' skip
     1602         '         <th num="" style="text-align: center;  font-weight:bold; background-color: silver;">8</th>' skip
     1603         '         <th num="" style="text-align: center;  font-weight:bold; background-color: silver;">9</th>' skip
