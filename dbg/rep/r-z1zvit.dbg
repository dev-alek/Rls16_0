     1527   def
     1528    shared
     1529   temp-table  obj-list no-undo
     1530     field obj-type like ub.clients.obj-type
     1531     field obj-code like ub.clients.obj-code
     1532     field obj-name like ub.clients.obj-name
     1533     field obj-id   as integer
