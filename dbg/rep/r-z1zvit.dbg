      599     :
      600       define input  parameter p-code           as character no-undo .
      601       define output parameter p-hist           as logical   no-undo .
      602       case p-code :
      603               when 'paycard-export-prefix':U then do:     assign     p-hist = true.   end.
      604               when 'paycard-all-prefix':U then do:     assign     p-hist = true.   end.
      605               when 'paycard-edit-prefix':U then do:     assign     p-hist = true.   end.
      606               when 'form_km3':U then do:     assign     p-hist = true.   end.
      607               when 'bal_malina':U then do:     assign     p-hist = true.   end.
      608               when 'max_proc_sum':U then do:     assign     p-hist = true.   end.
      609               when 'mask_card_kup':U then do:     assign     p-hist = true.   end.
      610         otherwise do:
      611           p-hist = no.
      612         end.
      613       end.
      614     end.
      615   end procedure.
