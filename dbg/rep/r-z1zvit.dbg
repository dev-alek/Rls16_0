     3759         return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3 документ &4", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code, bf_trn-doc.doc-code).
     3760       end.
     3761       if varcur-slt-pc = ?
     3762       then do:
     3763         return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3 документ &4", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code, bf_trn-doc.doc-code).
     3764       end.
     3765       v-calcbypart = no.
     3766       if bf_doc-line.whole-send-news = integer('1':U)   then
     3767       v-calcbypart = yes.
