     4067   end procedure.
     4068   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4069   PROCEDURE create-treal-2.
     4070   DEFINE INPUT PARAMETER pgds-code like ub.goods.gds-code no-undo.
     4071   DEFINE INPUT PARAMETER pcpay-code like ub.cash-pay.cdpay-code no-undo.
     4072   DEFINE INPUT PARAMETER pcurr-code like ub.cash-pay.curr-code no-undo.
     4073   DEFINE INPUT PARAMETER pqnty1 as decimal no-undo.
     4074   DEFINE INPUT PARAMETER pqnty2 as decimal no-undo.
     4075   DEFINE INPUT PARAMETER pnetto as decimal no-undo.
     4076   DEFINE INPUT PARAMETER pout-name as character no-undo.
     4077   DEFINE INPUT PARAMETER pis-pay as logical no-undo.
     4078   DEFINE INPUT PARAMETER pii as integer no-undo.
     4079   _main:
     4080   DO ON ERROR UNDO _main, return error:
     4081       create treal-2.
     4082       assign
     4083       treal-2.gds-code = pgds-code
     4084       treal-2.cpay-code = pcpay-code
     4085       treal-2.curr-code = pcurr-code
     4086       treal-2.qnty1  =  pqnty1
     4087       treal-2.qnty2  = pqnty2
     4088       treal-2.netto = pnetto
     4089       treal-2.out-name = pout-name
     4090       treal-2.is-pay = pis-pay
     4091       treal-2.ii = pii
     4092       treal-2.discnt-type = -99
     4093       no-error
     4094       .
     4095       if error-status:error then undo _main, return error.
     4096   END.
     4097   END PROCEDURE.
     4098   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4099   define temp-table start-stk-line no-undo like ub.stk-line.
     4100   define temp-table end-stk-line   no-undo like ub.stk-line.
     4101   procedure stk-lnrv:
     4102   define input  parameter parobj-type         like ub.clients.obj-type       no-undo.
     4103   define input  parameter parobj-code         like ub.clients.obj-code       no-undo.
     4104   define input  parameter parartic            like ub.goods.artic            no-undo.
     4105   define input  parameter parprod-type        like ub.goods.prod-type        no-undo.
     4106   define input  parameter parprod-code        like ub.goods.prod-code        no-undo.
     4107   define input  parameter parfact-order-start like ub.stk-line.fact-order no-undo.
     4108   define input  parameter parfact-order-end   like ub.stk-line.fact-order no-undo.
     4109   define input  parameter parsum-type         like ub.stk-line.sum-type   no-undo.
     4110   define input  parameter parcat-id           like ub.stk-line.cat-id     no-undo.
     4111   define input  parameter paris-shift         as   logical                no-undo.
     4112   define output parameter table for tt-stk-line.
     4113   define variable i                as integer no-undo.
     4114   define variable varqnty-doc-type as integer no-undo.
     4115   define variable varsum-type like ub.stk-line.sum-type no-undo.
     4116   do on error undo, return error return-value :
     4117   assign varqnty-doc-type = num-entries('ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U).
     4118   do i = 1 to varqnty-doc-type:
     4119      assign varsum-type = parsum-type + ENTRY(i, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U).
     4120   if paris-shift then do:
     4121     for each start-stk-line:                                                                                        delete start-stk-line.                                                                                  end.                                                                                                                find last ub.stk-line where ub.stk-line.obj-type    = parobj-type                  and                                                             ub.stk-line.obj-code    = parobj-code                  and                                                             ub.stk-line.artic       = parartic                     and                                                             ub.stk-line.prod-type   = parprod-type                 and                                                             ub.stk-line.prod-code   = parprod-code                 and                                                             ub.stk-line.fact-order <= parfact-order-start  and                                                             ub.stk-line.sum-type    = varsum-type                  and                                                             ub.stk-line.cat-id      = parcat-id                    and                                                             ub.stk-line.shift-date <> ?                                                                                                    use-index category no-lock no-error .                                                       if available ub.stk-line then do:                                                                                         create start-stk-line.                                                                                      buffer-copy ub.stk-line to start-stk-line.                                                                  end.
     4122   end.
     4123   else do:
     4124     for each start-stk-line:                                                                                        delete start-stk-line.                                                                                  end.                                                                                                                find last ub.stk-line where ub.stk-line.obj-type    = parobj-type                  and                                                             ub.stk-line.obj-code    = parobj-code                  and                                                             ub.stk-line.artic       = parartic                     and                                                             ub.stk-line.prod-type   = parprod-type                 and                                                             ub.stk-line.prod-code   = parprod-code                 and                                                             ub.stk-line.fact-order <= parfact-order-start  and                                                             ub.stk-line.sum-type    = varsum-type                  and                                                             ub.stk-line.cat-id      = parcat-id                    and                                                             ub.stk-line.shift-date = ?                                                                                                    use-index category no-lock no-error .                                                       if available ub.stk-line then do:                                                                                         create start-stk-line.                                                                                      buffer-copy ub.stk-line to start-stk-line.                                                                  end.
     4125   end.
     4126   if paris-shift then do:
     4127     for each end-stk-line:                                                                                        delete end-stk-line.                                                                                  end.                                                                                                                find last ub.stk-line where ub.stk-line.obj-type    = parobj-type                  and                                                             ub.stk-line.obj-code    = parobj-code                  and                                                             ub.stk-line.artic       = parartic                     and                                                             ub.stk-line.prod-type   = parprod-type                 and                                                             ub.stk-line.prod-code   = parprod-code                 and                                                             ub.stk-line.fact-order <= parfact-order-end  and                                                             ub.stk-line.sum-type    = varsum-type                  and                                                             ub.stk-line.cat-id      = parcat-id                    and                                                             ub.stk-line.shift-date <> ?                                                                                                    use-index category no-lock no-error .                                                       if available ub.stk-line then do:                                                                                         create end-stk-line.                                                                                      buffer-copy ub.stk-line to end-stk-line.                                                                  end.
     4128   end.
     4129   else do:
     4130     for each end-stk-line:                                                                                        delete end-stk-line.                                                                                  end.                                                                                                                find last ub.stk-line where ub.stk-line.obj-type    = parobj-type                  and                                                             ub.stk-line.obj-code    = parobj-code                  and                                                             ub.stk-line.artic       = parartic                     and                                                             ub.stk-line.prod-type   = parprod-type                 and                                                             ub.stk-line.prod-code   = parprod-code                 and                                                             ub.stk-line.fact-order <= parfact-order-end  and                                                             ub.stk-line.sum-type    = varsum-type                  and                                                             ub.stk-line.cat-id      = parcat-id                    and                                                             ub.stk-line.shift-date = ?                                                                                                    use-index category no-lock no-error .                                                       if available ub.stk-line then do:                                                                                         create end-stk-line.                                                                                      buffer-copy ub.stk-line to end-stk-line.                                                                  end.
     4131   end.
     4132   if
     4133      available end-stk-line   and
     4134      (not available start-stk-line or
     4135      start-stk-line.fact-order <> end-stk-line.fact-order) then do:
     4136         create tt-stk-line.
     4137         assign
     4138         tt-stk-line.obj-type       = parobj-type
     4139         tt-stk-line.obj-code       = parobj-code
     4140         tt-stk-line.artic          = parartic
     4141         tt-stk-line.prod-type      = parprod-type
     4142         tt-stk-line.prod-code      = parprod-code
     4143         tt-stk-line.sum-type       = varsum-type
     4144         tt-stk-line.cat-id         = parcat-id
     4145         tt-stk-line.fact-qnty      = (if available end-stk-line then (end-stk-line.fact-qnty      - (if available start-stk-line then start-stk-line.fact-qnty      else 0)) else 0)
     4146         tt-stk-line.sum-base       = (if available end-stk-line then (end-stk-line.sum-base       - (if available start-stk-line then start-stk-line.sum-base       else 0)) else 0)
     4147         tt-stk-line.sum-rubl       = (if available end-stk-line then (end-stk-line.sum-rubl       - (if available start-stk-line then start-stk-line.sum-rubl       else 0)) else 0)
     4148         tt-stk-line.SLT-base       = (if available end-stk-line then (end-stk-line.SLT-base       - (if available start-stk-line then start-stk-line.SLT-base       else 0)) else 0)
     4149         tt-stk-line.SLT-rubl       = (if available end-stk-line then (end-stk-line.SLT-rubl       - (if available start-stk-line then start-stk-line.SLT-rubl       else 0)) else 0)
     4150         tt-stk-line.VAT-base       = (if available end-stk-line then (end-stk-line.VAT-base       - (if available start-stk-line then start-stk-line.VAT-base       else 0)) else 0)
     4151         tt-stk-line.VAT-rubl       = (if available end-stk-line then (end-stk-line.VAT-rubl       - (if available start-stk-line then start-stk-line.VAT-rubl       else 0)) else 0)
     4152         tt-stk-line.excise-base    = (if available end-stk-line then (end-stk-line.excise-base    - (if available start-stk-line then start-stk-line.excise-base    else 0)) else 0)
     4153         tt-stk-line.excise-rubl    = (if available end-stk-line then (end-stk-line.excise-rubl    - (if available start-stk-line then start-stk-line.excise-rubl    else 0)) else 0)
     4154         tt-stk-line.other-base     = (if available end-stk-line then (end-stk-line.other-base     - (if available start-stk-line then start-stk-line.other-base     else 0)) else 0)
     4155         tt-stk-line.other-rubl     = (if available end-stk-line then (end-stk-line.other-rubl     - (if available start-stk-line then start-stk-line.other-rubl     else 0)) else 0)
     4156         tt-stk-line.road-tax-base  = (if available end-stk-line then (end-stk-line.road-tax-base  - (if available start-stk-line then start-stk-line.road-tax-base  else 0)) else 0)
     4157         tt-stk-line.road-tax-rubl  = (if available end-stk-line then (end-stk-line.road-tax-rubl  - (if available start-stk-line then start-stk-line.road-tax-rubl  else 0)) else 0)
     4158         tt-stk-line.transport-base = (if available end-stk-line then (end-stk-line.transport-base - (if available start-stk-line then start-stk-line.transport-base else 0)) else 0)
     4159         tt-stk-line.transport-rubl = (if available end-stk-line then (end-stk-line.transport-rubl - (if available start-stk-line then start-stk-line.transport-rubl else 0)) else 0).
     4160      end.
     4161   end.
     4162   end.
     4163   end procedure.
     4164   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4165   procedure ot-lnrv:
     4166   define input  parameter parobj-type         like ub.clients.obj-type    no-undo.
     4167   define input  parameter parobj-code         like ub.clients.obj-code    no-undo.
     4168   define input  parameter parcli-type         like ub.clients.obj-type    no-undo.
     4169   define input  parameter parcli-code         like ub.clients.obj-code    no-undo.
     4170   define input  parameter parartic            like ub.goods.artic         no-undo.
     4171   define input  parameter parprod-type        like ub.goods.prod-type     no-undo.
     4172   define input  parameter parprod-code        like ub.goods.prod-code     no-undo.
     4173   define input  parameter parfact-order-start like ub.ot-line.fact-order no-undo.
     4174   define input  parameter parfact-order-end   like ub.ot-line.fact-order no-undo.
     4175   define input  parameter parsum-type         like ub.ot-line.sum-type   no-undo.
     4176   define input  parameter parcat-id           like ub.ot-line.cat-id     no-undo.
     4177   define output parameter table for tt-ot-line.
     4178   define variable varext-doc-type like ub.ot-line.ext-doc-type no-undo.
     4179     FOR EACH ub.ot-line No-LOCK WHERE
     4180               ub.ot-line.obj-type = parobj-type AND
     4181               ub.ot-line.obj-code = parobj-code AND
     4182               ub.ot-line.artic = parartic AND
     4183               ub.ot-line.prod-type = parprod-type AND
     4184               ub.ot-line.prod-code = parprod-code AND
     4185               ub.ot-line.fact-order >= parfact-order-start AND
     4186               ub.ot-line.fact-order <= parfact-order-end AND
     4187               ub.ot-line.sum-type = parsum-type AND
     4188               (parcat-id = ? OR ub.ot-line.cat-id = parcat-id),
     4189         FIRST ub.trn-doc where
     4190               ub.trn-doc.doc-code = ub.ot-line.doc-code AND
     4191               ub.trn-doc.cli-type = parcli-type AND
     4192               ub.trn-doc.cli-code = parcli-code:
     4193       FIND FIRST tt-ot-line where
     4194                   tt-ot-line.obj-type       = parobj-type AND
     4195                   tt-ot-line.obj-code       = parobj-code AND
     4196                   tt-ot-line.artic          = parartic AND
     4197                   tt-ot-line.prod-type      = parprod-type AND
     4198                   tt-ot-line.prod-code      = parprod-code AND
     4199                   tt-ot-line.fact-order     = 0 AND
     4200                   tt-ot-line.sum-type       = parsum-type AND
     4201                   tt-ot-line.cat-id         = parcat-id AND
     4202                   tt-ot-line.ext-doc-type   = ub.ot-line.ext-doc-type AND
     4203                   tt-ot-line.cli-type       = parcli-type AND
     4204                   tt-ot-line.cli-code       = parcli-code
     4205                   No-ERROR.
     4206       IF NOT AVAIL tt-ot-line  then do:
     4207         create tt-ot-line.
     4208         assign
     4209         tt-ot-line.obj-type       = parobj-type
     4210         tt-ot-line.obj-code       = parobj-code
     4211         tt-ot-line.artic          = parartic
     4212         tt-ot-line.prod-type      = parprod-type
     4213         tt-ot-line.prod-code      = parprod-code
     4214         tt-ot-line.cli-type       = parcli-type
     4215         tt-ot-line.cli-code       = parcli-code
     4216         tt-ot-line.sum-type       = parsum-type
     4217         tt-ot-line.cat-id         = parcat-id
     4218         tt-ot-line.ext-doc-type   = ub.ot-line.ext-doc-type
     4219         .
     4220       end.
     4221       assign
     4222       tt-ot-line.fact-qnty      = tt-ot-line.fact-qnty + ub.ot-line.fact-qnty
     4223       tt-ot-line.sum-base       = tt-ot-line.sum-base + ub.ot-line.sum-base
     4224       tt-ot-line.sum-rubl       = tt-ot-line.sum-rubl + ub.ot-line.sum-rubl
     4225       tt-ot-line.SLT-base       = tt-ot-line.SLT-base + ub.ot-line.SLT-base
     4226       tt-ot-line.SLT-rubl       = tt-ot-line.SLT-rubl + ub.ot-line.SLT-rubl
     4227       tt-ot-line.VAT-base       = tt-ot-line.VAT-base + ub.ot-line.VAT-base
     4228       tt-ot-line.VAT-rubl       = tt-ot-line.VAT-rubl + ub.ot-line.VAT-rubl
     4229       tt-ot-line.excise-base    = tt-ot-line.excise-base + ub.ot-line.excise-base
     4230       tt-ot-line.excise-rubl    = tt-ot-line.excise-rubl + ub.ot-line.excise-rubl
     4231       tt-ot-line.other-base     = tt-ot-line.other-base + ub.ot-line.other-base
     4232       tt-ot-line.other-rubl     = tt-ot-line.other-rubl + ub.ot-line.other-rubl
     4233       tt-ot-line.road-tax-base  = tt-ot-line.road-tax-base + ub.ot-line.road-tax-base
     4234       tt-ot-line.road-tax-rubl  = tt-ot-line.road-tax-rubl + ub.ot-line.road-tax-rubl
     4235       tt-ot-line.transport-base = tt-ot-line.transport-base + ub.ot-line.transport-base
     4236       tt-ot-line.transport-rubl = tt-ot-line.transport-rubl + ub.ot-line.transport-rubl
     4237       .
     4238      end.
     4239   end procedure.
     4240   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4241   define shared stream PrnLibStream.
     4242   procedure prn-lib-prn-file :
     4243     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     4244     define input parameter p-DIsabledoptions as integer no-undo .
     4245     define variable v-report-name as character no-undo .
     4246     define variable v-user-action as character no-undo .
     4247     define variable v-printed     as logical   no-undo .
     4248     define variable v-exist       as logical   no-undo .
     4249     do
     4250       on error undo, return error
     4251       :
     4252       run prn-lib-get-report-name  in this-procedure (
     4253         input parParentProc
     4254         ,output v-report-name
     4255         ).
     4256   define variable vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4257   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     4258     (input  v-report-name
     4259     ,input  2
     4260     ,output v-exist
     4261     )  .
     4262       if NOT v-exist then
     4263       DO:
     4264         Message
     4265           "Нет заданий на печать ! "
     4266           view-as alert-box .
     4267         Return  .
     4268       End.
     4269       run gbl/prnfilen.w
     4270         (input  ""
     4271         ,input  p-DisabledOptions
     4272         ,input  string(v-report-name )
     4273         ,input  7
     4274         ,output v-user-action
     4275         ,output v-printed
     4276         ) .
     4277       if v-printed then
     4278       do:
     4279         return "YES" .
     4280       end.
     4281       else
     4282       do:
     4283         return "NO" .
     4284       end.
     4285     end.
     4286   end procedure.
     4287   procedure prn-lib-open-stream :
     4288     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     4289     define input parameter p-page-size    as integer no-undo .
     4290     define input parameter p-is-stream    as logical no-undo .
     4291     define input parameter p-append       as logical no-undo .
     4292     define variable v-report-name as character no-undo .
     4293     do
     4294       on error undo, return error
     4295       :
     4296       run prn-lib-get-report-name  in this-procedure (
     4297         input parParentProc
     4298         ,output v-report-name
     4299         ).
     4300       if p-is-stream then
     4301       do:
     4302         if p-append then
     4303         do:
     4304           output stream PrnLibStream to value( v-report-name )
     4305             page-size value(p-page-size) append .
     4306         end.
     4307         if not p-append then
     4308         do:
     4309           output stream PrnLibStream to value( v-report-name )
     4310             page-size value(p-page-size) .
     4311         end.
     4312       end.
     4313       if not p-is-stream then
     4314       do:
     4315         if p-append then
     4316         do:
     4317           output to value( v-report-name )
     4318             page-size value(p-page-size) append .
     4319         end.
     4320         if not p-append then
     4321         do:
     4322           output to value( v-report-name )
     4323             page-size value(p-page-size) .
     4324         end.
     4325       end.
     4326     end.
     4327   end procedure.
     4328   procedure prn-lib-open-exp :
     4329     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     4330     define input parameter p-is-stream    as logical no-undo .
     4331     define input parameter p-is-append    as logical no-undo .
     4332     define output parameter p-ReportFileName as char init "report" no-undo.
     4333     define output parameter p-process as logical no-undo .
     4334     define variable glog as logical no-undo .
     4335     do
     4336       on error undo, return error
     4337       :
     4338       SYSTEM-DIALOG GET-FILE p-ReportFileName
     4339         TITLE      "Укажите путь"
     4340         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     4341         ASK-OVERWRITE
     4342         CREATE-TEST-FILE
     4343         SAVE-AS
     4344         USE-FILENAME
     4345         DEFAULT-EXTENSION "txt"
     4346         UPDATE glog
     4347         .
     4348       if not glog then  return.
     4349       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     4350       if p-is-stream then
     4351       do:
     4352         if p-is-append then
     4353         do:
     4354           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     4355         end.
     4356         else
     4357         do:
     4358           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     4359         end.
     4360       end.
     4361       else
     4362       do:
     4363         if p-is-append then
     4364         do:
     4365           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     4366         end.
     4367         else
     4368         do:
     4369           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     4370         end.
     4371       end.
     4372       p-process = yes.
     4373     end.
     4374   end procedure.
     4375   procedure prn-lib-get-report-name :
     4376     define input parameter parParentProc  as widget-handle no-undo.
     4377     define output parameter p-report-name as character no-undo .
     4378     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     4379   end procedure.
     4380   procedure prn-lib-reportviewer-report-name :
     4381     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     4382     define input parameter p-report-name-html as character no-undo .
     4383     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
     4384   end procedure.
     4385   procedure prn-lib-reportviewer :
     4386     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     4387     define input parameter p-report-name-html as character no-undo .
     4388     define input parameter p-param        as character no-undo .
     4389     define variable v-excel           as character no-undo init 'TRUE' .
     4390     define variable v-value-character as character no-undo .
     4391     define variable v-value-integer   as character no-undo .
     4392     define variable v-value-date      as date      no-undo .
     4393     define variable v-value-decimal   as decimal   no-undo .
     4394     define variable rep-excel         as logical   no-undo .
     4395     define variable excel-string      as character no-undo .
     4396     define variable v-param-type      as character no-undo .
     4397     define variable v-tth             as handle    no-undo .
     4398     run adm/shattri.p (
     4399       input "get":U
     4400       ,input  ""
     4401       ,input  0
     4402       ,input  'report-glob':U
     4403       ,input  'rep-excel':U
     4404       ,output v-value-character
     4405       ,output v-value-date
     4406       ,output v-value-decimal
     4407       ,output v-value-integer
     4408       ,output rep-excel
     4409       ,output v-param-type
     4410       ,INPUT-OUTPUT table-handle v-tth
     4411       )  .
     4412     if rep-excel then v-excel = "TRUE" .
     4413     else v-excel = "FALSE" .
     4414     if p-param eq ""
     4415     then
     4416        p-param = "EXCEL:" + v-excel.
     4417     else
     4418        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     4419     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     4420   end procedure.
