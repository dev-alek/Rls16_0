     5319           if treal-2.ii <> ?
     5320           then do:
     5321             find first ub.cash-pay no-lock where
     5322                        ub.cash-pay.cdpay-code = treal-2.cpay-code and
     5323                        ub.cash-pay.curr-code  = treal-2.curr-code no-error .
     5324             if available ub.cash-pay
     5325             then do:
     5326               assign
     5327                 cashpay-was-found = yes
     5328               .
     5329               find first ub.cash-pay-attr no-lock where
     5330                          ub.cash-pay-attr.cdpay-code = ub.cash-pay.cdpay-code and
     5331                          ub.cash-pay-attr.curr-code  = ub.cash-pay.curr-code  and
     5332                          ub.cash-pay-attr.host-code  = 0                      and
     5333                          ub.cash-pay-attr.obj-type   = "":U                   and
     5334                          ub.cash-pay-attr.obj-code   = 0                      and
     5335                          ub.cash-pay-attr.attr-code  = 'grp-code':U    no-error .
     5336               if not available ub.cash-pay-attr
     5337               then do:
     5338                 find first ub.cash-pay-attr no-lock where
     5339                            ub.cash-pay-attr.cdpay-code = ub.cash-pay.cdpay-code and
     5340                            ub.cash-pay-attr.curr-code  = ub.cash-pay.curr-code  and
     5341                            ub.cash-pay-attr.attr-code  = 'grp-code':U    no-error .
     5342               end.
     5343               if available ub.cash-pay-attr
     5344               then do:
     5345                 case entry( 1, ub.cash-pay-attr.attr-value, chr(4) ) :
     5346                   when "готівка" then do:
     5347                     assign
     5348                       tt-zz1.qnty-06   = tt-zz1.qnty-06   + treal-2.qnty1
     5349                       tt-zz1.sum-cash  = tt-zz1.sum-cash  + treal-2.netto
     5350                       group-was-found  = ( group-was-found <> no )
     5351                     .
     5352                   end.
     5353                   when "від/тал" then do:
     5354                     assign
     5355                       tt-zz1.qnty-07   = tt-zz1.qnty-07   + treal-2.qnty1
     5356                       tt-zz1.sum-other = tt-zz1.sum-other + treal-2.netto
     5357                       group-was-found  = ( group-was-found <> no )
     5358                     .
     5359                   end.
     5360                   when "ел.к."   then do:
     5361                     assign
     5362                       tt-zz1.qnty-08   = tt-zz1.qnty-08   + treal-2.qnty1
     5363                       tt-zz1.sum-other = tt-zz1.sum-other + treal-2.netto
     5364                       group-was-found  = ( group-was-found <> no )
     5365                     .
     5366                   end.
     5367                 end case.
     5368               end.
     5369             end.
     5370             else do:
     5371             end.
     5372             assign
     5373               group-was-found = ( group-was-found = yes )
     5374             .
     5375           end.
     5376         end.
     5377       end case.
     5378     end.
     5379   end.
     5380   if cashpay-was-found = yes and
     5381      group-was-found   = no
     5382   then do:
     5383     message "С кассы были получены платежи, которые не попали в гуппы:" skip( 0 )
     5384             CHR(9) '"' + "за готівку" + '"' skip( 0 )
     5385             CHR(9) '"' + "за від/тал" + '"' skip( 0 )
     5386             CHR(9) '"' + "за ел.к."   + '"' skip( 1 )
     5387             "Суммы этих платежей НЕ ВКЛЮЧЕНЫ в отчет."
     5388     view-as alert-box information.
     5389   end.
     5390   assign
     5391     group-was-found   = ?
     5392     cashpay-was-found = no
     5393   .
     5394   for each treal-3 no-lock
     5395   :
     5396     find first ub.cash-pay no-lock where
     5397                ub.cash-pay.cdpay-code = treal-3.cpay-code and
     5398                ub.cash-pay.curr-code  = treal-3.curr-code no-error .
     5399     if available ub.cash-pay
     5400     then do:
     5401       assign
     5402         cashpay-was-found = yes
     5403       .
     5404       find first ub.cash-pay-attr no-lock where
     5405                  ub.cash-pay-attr.cdpay-code = ub.cash-pay.cdpay-code and
     5406                  ub.cash-pay-attr.curr-code  = ub.cash-pay.curr-code  and
     5407                  ub.cash-pay-attr.host-code  = 0                      and
     5408                  ub.cash-pay-attr.obj-type   = "":U                   and
     5409                  ub.cash-pay-attr.obj-code   = 0                      and
     5410                  ub.cash-pay-attr.attr-code  = 'grp-code':U    no-error .
     5411       if not available ub.cash-pay-attr
     5412       then do:
     5413         find first ub.cash-pay-attr no-lock where
     5414                    ub.cash-pay-attr.cdpay-code = ub.cash-pay.cdpay-code and
     5415                    ub.cash-pay-attr.curr-code  = ub.cash-pay.curr-code  and
     5416                    ub.cash-pay-attr.attr-code  = 'grp-code':U    no-error .
     5417       end.
     5418       if available ub.cash-pay-attr
     5419       then do:
     5420         case entry( 1, ub.cash-pay-attr.attr-value, chr(4) ) :
     5421           when "готівка" then do:
     5422             assign
     5423               total-cash-other = total-cash-other + treal-3.netto
     5424               group-was-found  = ( group-was-found <> no )
     5425             .
     5426           end.
     5427           when "від/тал" then do:
     5428             assign
     5429               total-card-other = total-card-other + treal-3.netto
     5430               group-was-found  = ( group-was-found <> no )
     5431             .
     5432           end.
     5433           when "ел.к."   then do:
     5434             assign
     5435               total-card-other = total-card-other + treal-3.netto
     5436               group-was-found  = ( group-was-found <> no )
     5437             .
     5438           end.
     5439         end case.
     5440       end.
     5441     end.
     5442   end.
     5443   assign
     5444     total-other = total-cash-other + total-card-other
     5445   .
     5446   if cashpay-was-found = yes and
     5447      group-was-found   = no
     5448   then do:
     5449     message "За сопутствующие товары были получены платежи, которые не попали в итоги:" skip( 0 )
     5450             CHR(9) '"' + "готівкою"              + '"' skip( 0 )
     5451             CHR(9) '"' + "за від./тал./ел.карт." + '"' skip( 1 )
     5452             "Суммы этих платежей НЕ ВКЛЮЧЕНЫ в отчет."
     5453     view-as alert-box information.
     5454   end.
     5455   if cashpay-was-found = yes and
     5456      group-was-found   = no
     5457   then do:
     5458     message "За сопутствующие товары были получены платежи, которые не попали в итоги:" skip( 0 )
     5459             CHR(9) '"' + "готівкою"              + '"' skip( 0 )
     5460             CHR(9) '"' + "за від./тал./ел.карт." + '"' skip( 1 )
     5461             "Суммы этих платежей НЕ ВКЛЮЧЕНЫ в отчет."
     5462     view-as alert-box information.
     5463   end.
     5464   for each tt-zz1 no-lock
     5465   break by tt-zz1.gds-code
     5466   :
     5467     assign
     5468       pol1  = tt-zz1.gds-name
     5469       pol2  = tt-zz1.last-price
     5470       pol3  = tt-zz1.qnty-before
     5471       pol4  = tt-zz1.qnty-04
     5472       pol5  = tt-zz1.qnty-05
     5473       pol6  = tt-zz1.qnty-06
     5474       pol7  = tt-zz1.qnty-07
     5475       pol8  = tt-zz1.qnty-08
     5476       pol9  = ?
     5477       pol10 = ?
     5478       pol11 = tt-zz1.qnty-11
     5479       pol12 = tt-zz1.qnty-after
     5480       pol13 = tt-zz1.sum-cash
     5481       pol14 = tt-zz1.sum-other
     5482       pol15 = pol13 + pol14
     5483     .
     5484     assign
     5485       total-cash-petrol = total-cash-petrol + tt-zz1.sum-cash
     5486       total-card-petrol = total-card-petrol + tt-zz1.sum-other
     5487     .
     5488     if p-can-print = yes
     5489     then do:
     5490       display stream PrnLibStream pol1                  sym1
     5491                                   pol2  when pol2  <> ? sym2
     5492                                   pol3                  sym3
     5493                                   pol4                  sym4
     5494                                   pol5                  sym5
     5495                                   pol6                  sym6
     5496                                   pol7                  sym7
     5497                                   pol8                  sym8
     5498                                   pol9  when pol9  <> ? sym9
     5499                                   pol10 when pol10 <> ? sym10
     5500                                   pol11                 sym11
     5501                                   pol12                 sym12
     5502                                   pol13                 sym13
     5503                                   pol14                 sym14
     5504                                   pol15                 sym15 sym16
     5505       with frame FRAME-1 .
     5506       if Make-Excel then  put   stream ForExcel unformatted pol1  CHR(9)
     5507       .
     5508         if pol2 = ?
     5509         then do:
     5510       if Make-Excel then  put   stream ForExcel unformatted       CHR(9)
     5511       .
     5512         end.
     5513         else do:
     5514       if Make-Excel then  put   stream ForExcel unformatted pol2  CHR(9)
     5515       .
     5516         end.
     5517       if Make-Excel then  put   stream ForExcel unformatted pol3  CHR(9)
     5518                   pol4  CHR(9)
     5519                   pol5  CHR(9)
     5520                   pol6  CHR(9)
     5521                   pol7  CHR(9)
     5522                   pol8  CHR(9)
     5523                         CHR(9)
     5524                         CHR(9)
     5525                   pol11 CHR(9)
     5526                   pol12 CHR(9)
     5527                   pol13 CHR(9)
     5528                   pol14 CHR(9)
     5529                   pol15 skip
     5530       .
     5531       assign
     5532         j_Excel-line = j_Excel-line + 1
     5533       .
     5534     end.
     5535     if last( tt-zz1.gds-code )
     5536     then do:
     5537       if p-can-print = yes
     5538       then do:
     5539         underline stream PrnLibStream pol1  sym1
     5540                                       pol2  sym2
     5541                                       pol3  sym3
     5542                                       pol4  sym4
     5543                                       pol5  sym5
     5544                                       pol6  sym6
     5545                                       pol7  sym7
     5546                                       pol8  sym8
     5547                                       pol9  sym9
     5548                                       pol10 sym10
     5549                                       pol11 sym11
     5550                                       pol12 sym12
     5551                                       pol13 sym13
     5552                                       pol14 sym14
     5553                                       pol15 sym15 sym16
     5554         with frame FRAME-1 .
     5555       end.
     5556     end.
     5557   end.
     5558   assign
     5559     total-petrol = total-cash-petrol + total-card-petrol
     5560   .
     5561   assign
     5562     total-cash-total = total-cash-petrol + total-cash-other
     5563     total-card-total = total-card-petrol + total-card-other
     5564   .
     5565   assign
     5566     total-total = total-total + total-cash-total + total-card-total
     5567   .
     5568   if p-can-print = yes
     5569   then do:
     5570     put stream PrnLibStream unformatted
     5571       space( 91 ) "         Разом :  " string( string( total-cash-petrol, ">>>>9.99":U ), "x(8)":U ) " ":U
     5572                                        string( string( total-card-petrol, ">>>>9.99":U ), "x(8)":U ) " ":U
     5573                                        string( string( total-petrol,      ">>>>9.99":U ), "x(8)":U ) skip
     5574       space( 91 ) "Супутні товари :  " string( string( total-cash-other,  ">>>>9.99":U ), "x(8)":U ) " ":U
     5575                                        string( string( total-card-other,  ">>>>9.99":U ), "x(8)":U ) " ":U
     5576                                        string( string( total-other,       ">>>>9.99":U ), "x(8)":U ) skip
     5577       space( 91 ) "        Усього :  " string( string( total-cash-total,  ">>>>9.99":U ), "x(8)":U ) " ":U
     5578                                        string( string( total-card-total,  ">>>>9.99":U ), "x(8)":U ) " ":U
     5579                                        string( string( total-total,       ">>>>9.99":U ), "x(8)":U ) skip
     5580     .
     5581     assign
     5582       j_Excel-line = j_Excel-line + 12
     5583     .
     5584     if Make-Excel then  put   stream ForExcel unformatted skip
     5585     .
     5586     if Make-Excel then  put   stream ForExcel unformatted fill( " ":U, 92 )    +
     5587                 "         Разом :  " + string( total-cash-petrol, ">>>>9.99":U ) + " ":U +
     5588                                        string( total-card-petrol, ">>>>9.99":U ) + " ":U +
     5589                                        string( total-petrol,      ">>>>9.99":U )   skip
     5590                 fill( " ":U, 92 )    +
     5591                 "Супутні товари :  " + string( total-cash-other,  ">>>>9.99":U ) + " ":U +
     5592                                        string( total-card-other,  ">>>>9.99":U ) + " ":U +
     5593                                        string( total-other,       ">>>>9.99":U )   skip
     5594                 fill( " ":U, 92 )    +
     5595                 "        Усього :  " + string( total-cash-total,  ">>>>9.99":U ) + " ":U +
     5596                                        string( total-card-total,  ">>>>9.99":U ) + " ":U +
     5597                                        string( total-total,       ">>>>9.99":U )   skip
     5598     .
     5599   end.
     5600   assign
     5601     p-total-cash = total-cash-total
     5602     p-total-all  = total-total
     5603   .
