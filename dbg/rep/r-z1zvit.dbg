     2460     price-rubl-with-tax-loccl = cl_tt-clcparts.price-rubl
     2461     price-base-with-tax-loccl = cl_tt-clcparts.price-base
     2462   .
     2463   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2464   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2465     (output varinvprbcl
     2466     )  .
     2467     if cl_tt-clcparts.out-code = 'free-zone':U     or
     2468        cl_tt-clcparts.out-code = 'out-zone':U   or
     2469        cl_tt-clcparts.doc-type = 'акт':U then do:
     2470       assign
     2471         in-vatp-have-vat-sltcl = yes.
     2472     end.
     2473     else do:
     2474       find first in-vatp_doc-attrcl no-lock
     2475         where in-vatp_doc-attrcl.doc-code  = cl_tt-clcparts.out-code
     2476           and in-vatp_doc-attrcl.attr-code = 'envd':U
     2477         no-error .
     2478       if not available in-vatp_doc-attrcl then do:
     2479         assign
     2480           in-vatp-have-vat-sltcl = yes.
     2481       end.
     2482       else do:
     2483            in-vatp-have-vat-sltcl = no.
     2484       end.
     2485     end.
     2486     assign
     2487      price-cli-with-tax-loccl = cl_tt-clcparts.price-cli
