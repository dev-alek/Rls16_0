        1   block-level on error undo, throw.
        2   define  input parameter p-parent-proc         as   widget-handle           no-undo .
        3   define  input parameter pobj-code             like ub.clients.obj-code     no-undo .
        4   define  input parameter pobj-type             like ub.clients.obj-type     no-undo .
        5   define  input parameter p-base-type           like ub.currency.curr-abbr   no-undo .
        6   define  input parameter p-base-code           like ub.currency.curr-code   no-undo .
        7   define  input parameter p-can-print           as   logical                 no-undo .
        8   define  input parameter p-sort-type           as   character               no-undo .
        9   define  input parameter pshift-date           like ub.shift-obj.shift-date no-undo .
       10   define  input parameter pshift-num            like ub.shift-obj.shift-num  no-undo .
       11   define  input parameter p-previous-shift-date as   date                    no-undo .
       12   define output parameter p-total-cash          as   decimal                 no-undo .
       13   define output parameter p-total-all           as   decimal                 no-undo .
       14   define variable pshift-date1           like ub.shift-obj.shift-date no-undo.
       15   define variable pshift-num1            like ub.shift-obj.shift-num  no-undo.
       16   assign
       17     pshift-date1 = pshift-date
       18     pshift-num1  = pshift-num
       19   .
       20   define variable vss-revision    as character no-undo initial "$Revision: aea5316774be, 0, rls $":U .
       21   define variable vss-author      as character no-undo initial "$Author: expertek $":U .
       22   define variable vss-date        as character no-undo initial "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       23   define variable vss-workfile    as character no-undo initial "$Workfile: r-z1zvit.p $":U .
       24   define variable vss-archive     as character no-undo initial "$Archive: rep/r-z1zvit.p $":U .
       25   define variable vss-description as character no-undo initial "сменный отчет АЗС (Украина)":U .
       26   procedure vss-get-info :
       27     define output parameter p-vss-revision    like vss-revision    no-undo .
       28     define output parameter p-vss-author      like vss-author      no-undo .
       29     define output parameter p-vss-date        like vss-date        no-undo .
       30     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       31     define output parameter p-vss-archive     like vss-archive     no-undo .
       32     define output parameter p-vss-description like vss-description no-undo .
       33     assign
       34       p-vss-revision    = vss-revision
       35       p-vss-author      = vss-author
       36       p-vss-date        = vss-date
       37       p-vss-workfile    = vss-workfile
       38       p-vss-archive     = vss-archive
       39       p-vss-description = vss-description
       40     .
       41   end procedure.
       42   procedure vss-get-parameters :
       43     define output parameter p-vss-parameters as character no-undo .
       44   end procedure.
       45   define new global shared variable g#vssrevis-logger as handle    no-undo .
       46   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       47   define variable v-vssrevis-logger                   as handle    no-undo .
       48   procedure vss-logevent :
       49     define input  parameter p-extra-paramters as character no-undo .
       50     define variable v-vssrevis-parameters as character no-undo .
       51     do
       52     on error undo, return error return-value
       53     :
       54       if  valid-handle(v-vssrevis-logger)
       55       and v-vssrevis-logger :get-signature("logevent") <> ""
       56       then do:
       57         run vss-get-parameters in this-procedure
       58           (output v-vssrevis-parameters
       59           ).
       60         run logevent in v-vssrevis-logger
       61           (input vss-workfile
       62           ,input vss-revision
       63           ,input v-vssrevis-parameters
       64           ,input p-extra-paramters
       65           ).
       66       end.
       67     end.
       68   end procedure.
       69   assign
       70     v-vssrevis-logger = g#vssrevis-logger
       71   .
       72   if  valid-handle(v-vssrevis-logger)
       73   and v-vssrevis-logger :get-signature("logevent") <> ""
       74   then do:
       75     assign
       76       v-vssrevis-logevent = true
       77     .
       78     run vss-logevent in this-procedure (input vss-description) .
       79   end.
       80   define new global shared variable g#language as character no-undo .
       81   if g#language <> '' and g#language <> 'rus':U then do:
       82     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       83   end.
       84   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       85   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       86   procedure cur-time :
       87      define output parameter p-today as date      no-undo .
       88      define output parameter p-time  as integer   no-undo .
       89     do
       90     on error undo, return error
       91     :
       92       define variable v-date1 as date      no-undo .
       93       define variable v-date2 as date      no-undo .
       94       define variable v-time  as integer   no-undo .
       95       assign
       96         v-date1 = today
       97         v-time  = time
       98         v-date2 = today
       99       .
      100       if v-date1 <> v-date2
      101       then do:
      102         assign
      103           v-date1 = today
      104           v-time  = v-time
      105         .
      106       end.
      107       assign
      108         p-today = v-date1
      109         p-time  = v-time
      110       .
      111     end.
      112   end.
      113   function cur-time-date returns character
      114   :
      115     return string(today, '99/99/9999':U) .
      116   end.
      117   function cur-time-mjd returns decimal
      118   :
      119     define variable v-date as date      no-undo .
      120     define variable v-time as integer   no-undo .
      121     run cur-time in this-procedure
      122       (output v-date
      123       ,output v-time
      124       ) .
      125     return integer(v-date) - 2400002 + (v-time / 86400) .
      126   end.
      127   function cur-time-get-ending-index returns integer
      128   (input p-number as integer
      129   )
      130   :
      131     if p-number < 0
      132     or p-number = ?
      133     then do:
      134       return 1 .
      135     end.
      136     define variable v-rest as integer   no-undo .
      137     assign
      138       p-number = p-number modulo 100
      139     .
      140     if p-number < 20
      141     then do:
      142       assign
      143         v-rest = p-number
      144       .
      145     end.
      146     else do:
      147       assign
      148         v-rest = p-number modulo 10
      149       .
      150     end.
      151     case v-rest :
      152       when 1
      153       then do:
      154         return 2 .
      155       end.
      156       when 2 or
      157       when 3 or
      158       when 4
      159       then do:
      160         return 3 .
      161       end.
      162       otherwise do:
      163         return 1 .
      164       end.
      165     end case .
      166   end.
      167   procedure cur-time-mjd-to-date :
      168      define input  parameter i-mjd-diff as decimal no-undo.
      169      define output parameter o-Date     as date    no-undo.
      170      define output parameter o-Time     as integer no-undo.
      171      define variable v-day-number as integer   no-undo .
      172      if    i-mjd-diff < 0
      173         or i-mjd-diff = ?
      174      then do:
      175         return "?" .
      176      end.
      177      assign
      178         v-day-number = truncate(i-mjd-diff,0).
      179         o-Date = date(v-day-number + 2400002).
      180         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      181     .
      182   end.
      183   function cur-time-mjd-to-string returns character
      184   (input p-mjd-diff as decimal
      185   )
      186   :
      187     define variable v-day-number as integer   no-undo .
      188     define variable v-seconds    as integer   no-undo .
      189     define variable v-hour       as integer   no-undo .
      190     define variable v-min        as integer   no-undo .
      191     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      192     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      193     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      194     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      195     if p-mjd-diff < 0
      196     or p-mjd-diff = ?
      197     then do:
      198       return "?" .
      199     end.
      200     assign
      201       v-day-number = integer(truncate(p-mjd-diff,0))
      202       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      203     .
      204     if v-seconds > 86400
      205     then do:
      206       assign
      207         v-seconds = 86400 - 1
      208       .
      209     end.
      210     if v-seconds < 0
      211     then do:
      212       assign
      213         v-seconds = 0
      214       .
      215     end.
      216     assign
      217       v-hour = truncate(v-seconds / 3600, 0)
      218     .
      219     assign
      220       v-seconds = v-seconds modulo 3600
      221     .
      222     assign
      223       v-min = truncate(v-seconds / 60, 0)
      224     .
      225     assign
      226       v-seconds = v-seconds modulo 60
      227     .
      228     return
      229         (if v-day-number <> 0
      230           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      231           else ""
      232         )
      233       + (if v-day-number <> 0 or v-hour <> 0
      234           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      235           else ""
      236         )
      237       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      238           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      239           else ""
      240         )
      241       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      242       .
      243   end.
      244   function cur-time-string returns character
      245   :
      246     define variable v-date as date      no-undo .
      247     define variable v-time as integer   no-undo .
      248     run cur-time in this-procedure
      249       (output v-date
      250       ,output v-time
      251       ) .
      252     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      253   end.
      254   function cur-time-string-sec returns character
      255   :
      256     define variable v-date as date      no-undo .
      257     define variable v-time as integer   no-undo .
      258     run cur-time in this-procedure
      259       (output v-date
      260       ,output v-time
      261       ) .
      262     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      263   end.
      264   function cur-time-custom  returns character
      265   (input p-prefix as character
      266   ,input p-date-format as character
      267   ,input p-delimiter as character
      268   ,input p-time-format as character
      269   ,input p-suffix as character
      270   )
      271   :
      272     define variable v-date as date      no-undo .
      273     define variable v-time as integer   no-undo .
      274     run cur-time in this-procedure
      275       (output v-date
      276       ,output v-time
      277       ) .
      278     return
      279       p-prefix
      280       + string(v-date, p-date-format)
      281       + p-delimiter
      282       + string(v-time, p-time-format)
      283       + p-suffix
      284       .
      285   end.
      286   function cur-time-print  returns character
      287   :
      288     define variable v-date as date      no-undo .
      289     define variable v-time as integer   no-undo .
      290     run cur-time in this-procedure
      291       (output v-date
      292       ,output v-time
      293       ) .
      294     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      295   end.
      296   function cur-time-datetime returns datetime
      297   :
      298     define variable v-char as character no-undo .
      299     define variable v-datetime as datetime no-undo .
      300     v-char = cur-time-string().
      301     v-datetime = datetime(v-char).
      302     return  v-datetime.
      303   end.
      304   function cur-time-string-msec returns character
      305   :
      306     define variable v-date as datetime  no-undo .
      307     v-date = now.
      308     return string(v-date) .
      309   end.
      310   procedure cp-attr-code :
      311     do
      312     on error undo, return error
      313     :
      314       define input  parameter p-code           as character no-undo .
      315       define output parameter p-type           as character no-undo .
      316       define output parameter p-format         as character no-undo .
      317       define output parameter p-label          as character no-undo .
      318       define output parameter p-range          as integer   no-undo .
      319       define output parameter p-user-can-edit  as logical   no-undo .
      320       define output parameter p-output-display as logical   no-undo .
      321       define output parameter p-other          as character no-undo .
      322       case p-code :
      323               when 'paycard-export-prefix':U then do:     assign     p-label = "Префиксы платежных карт (для выгрузки в XML)"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт (для выгрузки в XML)"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
      324               when 'grp-code':U then do:     assign     p-label = "Группа платежа"     p-type = 'C':U      p-format = "X(45)"     p-label = "Группа платежа"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=grp-code':u      .   end.
      325               when 'is-use':U then do:     assign     p-label = "Используется"     p-type = 'C':U      p-format = "X(255)"     p-label = "Используется"     p-range = 4     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=is-use':u      .   end.
      326               when 'dop-doc':U then do:     assign     p-label = "Дополнительный документ"     p-type = 'C':U      p-format = "X(255)"     p-label = "Дополнительный документ"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=dop-doc':u      .   end.
      327               when 'paycard-all-prefix':U then do:     assign     p-label = "Префиксы платежных карт (для разбора чеков и т.д.)"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт (для разбора чеков и т.д.)"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
      328               when 'paycard-edit-prefix':U then do:     assign     p-label = "Префиксы платежных карт, разрешенных для редактирования"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт, разрешенных для редактирования"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
      329               when 'form_km3':U then do:     assign     p-label = "Формировать КМ-3 по чекам возврата"     p-type = 'L':U      p-format = "+/-"     p-label = "Формировать КМ-3 по чекам возврата"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
      330               when 'bal_malina':U then do:     assign     p-label = "Оплата баллами Малина"     p-type = 'L':U      p-format = "+/-"     p-label = "Оплата баллами Малина"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
      331               when 'max_proc_sum':U then do:     assign     p-label = "Максимальный % порог от суммы"     p-type = 'D':U      p-format = ">>9.99"     p-label = "Максимальный % порог от суммы"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
      332               when 'mask_card_kup':U then do:     assign     p-label = "Маска карты\купона"     p-type = 'C':U      p-format = "x(129)"     p-label = "Маска карты\купона"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
      333         otherwise do:
      334           undo, return error substitute("неизвестный атрибут типа кассового платежа &1", p-code ).
      335         end.
      336       end.
      337     end.
      338   end procedure.
      339   procedure cp-attr-tooltip :
      340     do
      341     on error undo, return error
      342     :
      343       define input  parameter p-code    as character no-undo .
      344       define output parameter p-tooltip as character no-undo .
      345       define output parameter p-label   as character no-undo .
      346       case p-code :
      347               when 'paycard-export-prefix':U then do:     assign     p-tooltip = "Префиксы платежных карт (для выгрузки в XML)"     p-label = "Префиксы платежных карт (для выгрузки в XML)" .   end.
      348               when 'grp-code':U then do:     assign     p-tooltip = "Группа платежа"     p-label = "Группа платежа" .   end.
      349               when 'is-use':U then do:     assign     p-tooltip = "Используется"     p-label = "Используется" .   end.
      350               when 'dop-doc':U then do:     assign     p-tooltip = "Дополнительный документ"     p-label = "Дополнительный документ" .   end.
      351               when 'paycard-all-prefix':U then do:     assign     p-tooltip = "Префиксы платежных карт (для разбора чеков и т.д.)"     p-label = "Префиксы платежных карт (для разбора чеков и т.д.)" .   end.
      352               when 'paycard-edit-prefix':U then do:     assign     p-tooltip = "Префиксы платежных карт, разрешенных для редактировани"     p-label = "Префиксы платежных карт, разрешенных для редактирования" .   end.
      353               when 'form_km3':U then do:     assign     p-tooltip = "Формировать КМ-3 по чекам возврата"     p-label = "Формировать КМ-3 по чекам возврата" .   end.
      354               when 'bal_malina':U then do:     assign     p-tooltip = "Оплата баллами Малина"     p-label = "Оплата баллами Малина" .   end.
      355               when 'max_proc_sum':U then do:     assign     p-tooltip = "Максимальный % порог от суммы"     p-label = "Максимальный % порог от суммы" .   end.
      356               when 'mask_card_kup':U then do:     assign     p-tooltip = "Маска карты\купона"     p-label = "Маска карты\купона" .   end.
      357         otherwise do:
      358           undo, return error substitute("неизвестный атрибут типа кассового платежа &1", p-code) .
      359         end.
      360       end.
      361     end.
      362   end procedure.
      363   procedure cp-attr-value :
      364     do
      365     on error undo, return error
      366     :
      367       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
      368       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
      369       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
      370       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
      371       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
      372       define input  parameter p-code        like ub.cash-pay-attr.attr-code      no-undo .
      373       define output parameter p-value       like ub.cash-pay-attr.attr-value    no-undo .
      374       define output parameter p-type        as character no-undo .
      375       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
      376       define variable v-format         as character no-undo .
      377       define variable v-label          as character no-undo .
      378       define variable v-range          as integer   no-undo .
      379       define variable v-user-can-edit  as logical   no-undo .
      380       define variable v-output-display as logical   no-undo .
      381       define variable v-other          as character no-undo .
      382       run cp-attr-code in this-procedure
      383         (input  p-code
      384         ,output p-type
      385         ,output v-format
      386         ,output v-label
      387         ,output v-range
      388         ,output v-user-can-edit
      389         ,output v-output-display
      390         ,output v-other
      391         ) no-error .
      392       if error-status :error then do:
      393         undo, return error return-value .
      394       end.
      395       find first buf_cash-pay-attr no-lock
      396         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
      397           and buf_cash-pay-attr.curr-code  = p-curr-code
      398           and buf_cash-pay-attr.host-code  = p-host-code
      399           and buf_cash-pay-attr.obj-type   = p-obj-type
      400           and buf_cash-pay-attr.obj-code   = p-obj-code
      401           and buf_cash-pay-attr.attr-code  = p-code
      402         no-error .
      403       if avail buf_cash-pay-attr then do:
      404         assign
      405           p-value =  buf_cash-pay-attr.attr-value
      406         .
      407       end.
      408       else do:
      409         assign
      410           p-value = if p-type = 'L':U then "no":U else ""
      411         .
      412       end.
      413     end.
      414   end procedure.
      415   procedure cp-attr-write :
      416     do
      417     on error undo, return error
      418     :
      419       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
      420       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
      421       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
      422       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
      423       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
      424       define input parameter p-code     like ub.cash-pay-attr.attr-code  no-undo .
      425       define input parameter p-value    like ub.cash-pay-attr.attr-value no-undo .
      426       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
      427       define buffer last_cash-pay-attr for ub.cash-pay-attr .
      428       define variable v-type           as character no-undo .
      429       define variable v-format         as character no-undo .
      430       define variable v-label          as character no-undo .
      431       define variable v-range          as integer   no-undo .
      432       define variable v-user-can-edit  as logical   no-undo .
      433       define variable v-output-display as logical   no-undo .
      434       define variable v-other          as character no-undo .
      435       run cp-attr-code in this-procedure
      436         (input  p-code
      437         ,output v-type
      438         ,output v-format
      439         ,output v-label
      440         ,output v-range
      441         ,output v-user-can-edit
      442         ,output v-output-display
      443         ,output v-other
      444         ) no-error .
      445       if error-status :error then do:
      446         undo, return error return-value .
      447       end.
      448       find first buf_cash-pay-attr exclusive-lock
      449         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
      450           and buf_cash-pay-attr.curr-code  = p-curr-code
      451           and buf_cash-pay-attr.host-code  = p-host-code
      452           and buf_cash-pay-attr.obj-type   = p-obj-type
      453           and buf_cash-pay-attr.obj-code   = p-obj-code
      454           and buf_cash-pay-attr.attr-code = p-code
      455         no-error .
      456       if not available buf_cash-pay-attr then do:
      457         create buf_cash-pay-attr .
      458         assign
      459         buf_cash-pay-attr.cdpay-code = p-cdpay-code
      460         buf_cash-pay-attr.curr-code  = p-curr-code
      461         buf_cash-pay-attr.host-code  = p-host-code
      462         buf_cash-pay-attr.obj-type   = p-obj-type
      463         buf_cash-pay-attr.obj-code   = p-obj-code
      464         buf_cash-pay-attr.attr-code = p-code
      465         .
      466       end.
      467       assign
      468         buf_cash-pay-attr.attr-value = p-value
      469       .
      470       release buf_cash-pay-attr no-error .
      471       if error-status:error then do:
      472         undo, return error return-value .
      473       end.
      474     end.
      475   end procedure.
      476   procedure cp-attr-exist :
      477     do
      478     on error undo, return error
      479     :
      480       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
      481       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
      482       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
      483       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
      484       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
      485       define input parameter p-code     like ub.cash-pay-attr.attr-code  no-undo .
      486       define output parameter p-exist   as logical  no-undo .
      487       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
      488       define variable v-type           as character no-undo .
      489       define variable v-format         as character no-undo .
      490       define variable v-label          as character no-undo .
      491       define variable v-range          as integer   no-undo .
      492       define variable v-user-can-edit  as logical   no-undo .
      493       define variable v-output-display as logical   no-undo .
      494       define variable v-other          as character no-undo .
      495       run cp-attr-code in this-procedure
      496         (input  p-code
      497         ,output v-type
      498         ,output v-format
      499         ,output v-label
      500         ,output v-range
      501         ,output v-user-can-edit
      502         ,output v-output-display
      503         ,output v-other
      504         ) no-error .
      505       if error-status :error then do:
      506         undo, return error return-value .
      507       end.
      508       find first buf_cash-pay-attr exclusive-lock
      509         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
      510           and buf_cash-pay-attr.curr-code  = p-curr-code
      511           and buf_cash-pay-attr.host-code  = p-host-code
      512           and buf_cash-pay-attr.obj-type   = p-obj-type
      513           and buf_cash-pay-attr.obj-code   = p-obj-code
      514           and buf_cash-pay-attr.attr-code = p-code
      515         no-error .
      516       if  available buf_cash-pay-attr then do:
      517         p-exist = yes.
      518       end.
      519     end.
      520   end procedure.
      521   procedure cp-attr-delete :
      522     do
      523     on error undo, return error
      524     :
      525       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
      526       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
      527       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
      528       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
      529       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
      530       define input parameter p-code     like ub.cash-pay-attr.attr-code  no-undo .
      531       define output parameter p-deleted  as logical no-undo.
      532       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
      533       define variable v-type           as character no-undo .
      534       define variable v-format         as character no-undo .
      535       define variable v-label          as character no-undo .
      536       define variable v-range          as integer   no-undo .
      537       define variable v-user-can-edit  as logical   no-undo .
      538       define variable v-output-display as logical   no-undo .
      539       define variable v-other          as character no-undo .
      540       run cp-attr-code in this-procedure
      541         (input  p-code
      542         ,output v-type
      543         ,output v-format
      544         ,output v-label
      545         ,output v-range
      546         ,output v-user-can-edit
      547         ,output v-output-display
      548         ,output v-other
      549         ) no-error .
      550       if error-status :error then do:
      551         undo, return error return-value .
      552       end.
      553       find first buf_cash-pay-attr exclusive-lock
      554         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
      555           and buf_cash-pay-attr.curr-code  = p-curr-code
      556           and buf_cash-pay-attr.host-code  = p-host-code
      557           and buf_cash-pay-attr.obj-type   = p-obj-type
      558           and buf_cash-pay-attr.obj-code   = p-obj-code
      559           and buf_cash-pay-attr.attr-code = p-code
      560         no-error NO-WAIT.
      561       if not available buf_cash-pay-attr then do:
      562         p-deleted = no.
      563       end.
      564       else do:
      565         delete buf_cash-pay-attr no-error .
      566         if error-status:error then do:
      567           undo, return error return-value .
      568         end.
      569         p-deleted = yes.
      570       end.
      571     end.
      572   end procedure.
      573   procedure cp-attr-news :
      574     do
      575     on error undo, return error
      576     :
      577       define input  parameter p-code           as character no-undo .
      578       define output parameter p-news           as logical   no-undo .
      579       case p-code :
      580               when 'paycard-export-prefix':U then do:     assign     p-news = true.   end.
      581               when 'grp-code':U then do:     assign     p-news = true.   end.
      582               when 'is-use':U then do:     assign     p-news = true.   end.
      583               when 'dop-doc':U then do:     assign     p-news = true.   end.
      584               when 'paycard-all-prefix':U then do:     assign     p-news = true.   end.
      585               when 'paycard-edit-prefix':U then do:     assign     p-news = true.   end.
      586               when 'form_km3':U then do:     assign     p-news = false.   end.
      587               when 'bal_malina':U then do:     assign     p-news = false.   end.
      588               when 'max_proc_sum':U then do:     assign     p-news = true.   end.
      589               when 'mask_card_kup':U then do:     assign     p-news = true.   end.
      590         otherwise do:
      591           p-news = no.
      592         end.
      593       end.
      594     end.
      595   end procedure.
      596   procedure cp-attr-hist :
