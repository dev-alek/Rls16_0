     3783     (input  bf_trn-doc.obj-type
     3784     ,input  bf_trn-doc.obj-code
     3785     ,input  varb-code
     3786     ,input  0
     3787     ,input  bf_trn-doc.fact-order
     3788     ,output vardoc-num
     3789     ,output varprice-sale
     3790     ,output varroad-tax
     3791     ,output varexcise
     3792     )  .
     3793             if varprice-sale = ?
     3794             then do:
     3795               assign
     3796                 varprice-sale = 0
     3797                 varroad-tax   = 0
     3798                 varexcise     = 0
     3799               .
     3800             end.
     3801             assign
     3802               varlastcur-base     = varprice-sale
     3803               varlastcur-road-tax = varroad-tax
     3804               varlastcur-excise   = varexcise
     3805               varcur-base         = varcur-base      + varprice-sale * bf_gds-dtl.fact-qnty
     3806               varcur-road-tax     = varcur-road-tax  + varroad-tax   * bf_gds-dtl.fact-qnty
     3807               varcur-excise       = varcur-excise    + varexcise     * bf_gds-dtl.fact-qnty
     3808               varcur-fact-qnty    = varcur-fact-qnty + bf_gds-dtl.fact-qnty
     3809             .
     3810         end.
     3811       end.
     3812       if varcur-fact-qnty = 0 then do:
     3813         assign
     3814           varcur-base      = varlastcur-base
     3815           varcur-road-tax  = varlastcur-road-tax
     3816           varcur-excise    = varlastcur-excise
     3817         .
     3818       end.
     3819       else do:
     3820         assign
     3821           varcur-base      = varcur-base      / varcur-fact-qnty
     3822           varcur-road-tax  = varcur-road-tax  / varcur-fact-qnty
     3823           varcur-excise    = varcur-excise    / varcur-fact-qnty
     3824         .
     3825       end.
     3826       if varcur-vat-pc = ?
