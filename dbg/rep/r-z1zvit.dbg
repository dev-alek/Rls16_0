     2900   if error-status :error then do:
     2901     message
     2902       vss-workfile vss-revision vss-description skip
     2903       "Ошибка при определении корневого признака товара" skip
     2904       "Артикул" parcurartic parcurprod-type parcurprod-code skip
     2905       error-status :get-message(1) skip
     2906       return-value skip
     2907       view-as alert-box error .
     2908     undo, return error .
     2909   end.
     2910   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtat in g#library
     2911     (input  varroot-nodecur
     2912     ,input  'empty-scale=request'
     2913     ,output varempty-scalecur
     2914     ) no-error .
     2915   if error-status :error then do:
     2916     message
     2917       vss-workfile vss-revision vss-description skip
     2918       "Ошибка при определении атрибута признака" skip
     2919       "Артикул" parcurartic parcurprod-type parcurprod-code skip
     2920       "Признак" varroot-nodecur skip
