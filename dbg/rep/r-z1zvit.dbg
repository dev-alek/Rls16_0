     3833       end.
     3834       find first bf_sysconf where bf_sysconf.host-code = bf_trn-doc.host-code no-lock.
     3835       assign
     3836         varcur-cons-vat-pc = bf_sysconf.cons-vat-pc.
     3837       if varcur-cons-vat-pc = ? then do:
     3838         return error substitute ("Нет текущего продажного консигнационного НДС по фирме &1", bf_trn-doc.host-code).
     3839       end.
     3840       define buffer buf_tt-clcparts for tt-clcparts .
     3841       for each buf_tt-clcparts
     3842       on error undo, return error return-value
     3843       :
     3844         delete buf_tt-clcparts.
     3845       end.
     3846       for each bf_parts no-lock
     3847         where bf_parts.out-code  = bf_doc-line.doc-code
     3848           and bf_parts.obj-type  = bf_doc-line.obj-type
     3849           and bf_parts.obj-code  = bf_doc-line.obj-code
     3850           and bf_parts.artic     = bf_doc-line.artic
     3851           and bf_parts.prod-type = bf_doc-line.prod-type
     3852           and bf_parts.prod-code = bf_doc-line.prod-code
     3853       on error undo, return error return-value
     3854       :
     3855         create buf_tt-clcparts .
     3856         buffer-copy bf_parts to buf_tt-clcparts .
     3857         if v-calcbypart = yes   then do:
     3858   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run partbcod in g#library
     3859     (buffer bf_parts
     3860     ,output v-b-pcode
     3861     ) no-error .
     3862   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3863   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     3864     (input  bf_parts.obj-type
     3865     ,input  bf_parts.obj-code
     3866     ,input  v-b-pcode
     3867     ,input  0
     3868     ,input  bf_trn-doc.fact-order
     3869     ,output vardoc-num
     3870     ,output varprice-salef
     3871     ,output varroad-tax
     3872     ,output varexcise
     3873     ) no-error .
     3874             if varprice-sale = ?
     3875             then do:
     3876               assign
     3877                 varprice-salef = 0
     3878                 varroad-tax   = 0
     3879                 varexcise     = 0
     3880               .
     3881             end.
     3882             assign
     3883             part-cur-base  = varprice-salef
     3884             part-cur-road-tax  = varroad-tax
     3885             part-cur-excise = varexcise.
     3886         end.
     3887       end.
     3888       run clcprtsl_calc-ttable in this-procedure
     3889         (input yes,
     3890          input yes,
     3891          input bf_doc-line.road-tax,
     3892          input bf_doc-line.excise,
     3893          input bf_doc-line.vat-pc,
     3894          input bf_doc-line.cons-vat-pc,
     3895          input bf_doc-line.slt-pc,
     3896          input bf_trn-doc.base-rate,
     3897          input bf_trn-doc.base-scale,
     3898          input varr-b,
     3899          input varcur-base,
     3900          input varcur-road-tax,
     3901          input varcur-excise,
     3902          input varcur-vat-pc,
     3903          input varcur-cons-vat-pc,
     3904          input varcur-slt-pc
     3905          ) no-error.
     3906       if error-status:error then do:
     3907         message
     3908           vss-workfile vss-revision vss-description skip
     3909           "Ошибка при вызове процедуры clcprtsl_calc-ttable." skip
     3910           return-value skip
     3911           trim(error-status :get-message(1))
     3912           trim(error-status :get-message(2))
     3913           trim(error-status :get-message(3))
     3914           trim(error-status :get-message(4))
     3915           trim(error-status :get-message(5)) skip
     3916           view-as alert-box error.
     3917         undo, return error .
     3918       end.
     3919     end.
     3920   end.
     3921   end.
     3922   procedure clcprtsl_calc-ttable :
     3923   define input parameter paris-doc           as   logical                 no-undo.
     3924   define input parameter paris-cur           as   logical                 no-undo.
     3925   define input parameter parroad-tax         like ub.doc-line.road-tax    no-undo.
     3926   define input parameter parexcise           like ub.doc-line.excise      no-undo.
     3927   define input parameter parvat-pc           like ub.doc-line.vat-pc      no-undo.
     3928   define input parameter parcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     3929   define input parameter parslt-pc           like ub.doc-line.slt-pc      no-undo.
     3930   define input parameter parbase-rate        like ub.trn-doc.base-rate    no-undo.
     3931   define input parameter parbase-scale       like ub.trn-doc.base-scale   no-undo.
     3932   define input parameter parr-b              as   character               no-undo.
     3933   define input parameter parcur-base         like ub.gds-dtl.cur-base     no-undo.
     3934   define input parameter parcur-road-tax     like ub.doc-line.road-tax    no-undo.
     3935   define input parameter parcur-excise       like ub.doc-line.excise      no-undo.
     3936   define input parameter parcur-vat-pc       like ub.doc-line.vat-pc      no-undo.
     3937   define input parameter parcurcons-vat-pc   like ub.doc-line.cons-vat-pc no-undo.
     3938   define input parameter parcurslt-pc        like ub.doc-line.slt-pc      no-undo.
     3939   define buffer bf_tt-allsum      for tt-allsum.
     3940   define buffer bf_tt-clcparts    for tt-clcparts.
     3941   define buffer bf_tt-allsum-line for tt-allsum-line.
