     2454   do on error undo, return error return-value :
     2455   find first cl_tt-clcparts where recid(cl_tt-clcparts) = parrec-parts no-lock.
     2456   for each bf_tt-allsum on error undo, return error return-value :
     2457     delete bf_tt-allsum.
     2458   end.
