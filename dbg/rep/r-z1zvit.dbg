     2922       error-status :get-message(1) skip
     2923       return-value skip
     2924       view-as alert-box error .
     2925     undo, return error .
     2926   end.
     2927   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2928   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2929     (output varoutvprbcur
     2930     )  .
     2931   if varoutvprbcur = "base":u then do:
     2932     assign
     2933           road-tax-base-salecur    =  (if parcurroad-tax = ? then 0 else parcurroad-tax * 1)
     2934       excise-base-salecur      =  (if parcurexcise   = ? then 0 else parcurexcise   * 1)
     2935     .
     2936   end.
     2937   else do:
     2938     assign
     2939           road-tax-base-salecur    =  (if parcurroad-tax = ? then 0 else parcurroad-tax / parcurbase-rate * parcurbase-scale)
     2940       excise-base-salecur      =  (if parcurexcise   = ? then 0 else parcurexcise   / parcurbase-rate * parcurbase-scale)
     2941     .
     2942   end.
     2943   if varoutvprbcur = "rubl":u then do:
     2944     assign
     2945           road-tax-rubl-salecur    = (if parcurroad-tax = ? then 0 else parcurroad-tax * 1)
     2946       excise-rubl-salecur      = (if parcurexcise   = ? then 0 else parcurexcise   * 1) .
     2947   end.
     2948   else do:
     2949     assign
     2950           road-tax-rubl-salecur    = (if parcurroad-tax = ? then 0 else parcurroad-tax * parcurbase-rate / parcurbase-scale)
     2951       excise-rubl-salecur      = (if parcurexcise   = ? then 0 else parcurexcise   * parcurbase-rate / parcurbase-scale) .
     2952   end.
     2953   assign
     2954     varis-cons-parts-havecur =  no.
     2955   assign
     2956     varfact-qntycur       = 0
     2957     varcons-qntycur       = 0
     2958     varprice-base-conscur = 0
     2959     varprice-rubl-conscur = 0.
     2960   if cl_tt-clcparts.purch-code = 2 then do:
     2961   assign
     2962     price-rubl-with-tax-lococur = cl_tt-clcparts.price-rubl
     2963     price-base-with-tax-lococur = cl_tt-clcparts.price-base
     2964   .
     2965   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2966   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2967     (output varinvprbocur
     2968     )  .
     2969     if cl_tt-clcparts.out-code = 'free-zone':U     or
     2970        cl_tt-clcparts.out-code = 'out-zone':U   or
     2971        cl_tt-clcparts.doc-type = 'акт':U then do:
     2972       assign
     2973         in-vatp-have-vat-sltocur = yes.
     2974     end.
     2975     else do:
     2976       find first in-vatp_doc-attrocur no-lock
     2977         where in-vatp_doc-attrocur.doc-code  = cl_tt-clcparts.out-code
     2978           and in-vatp_doc-attrocur.attr-code = 'envd':U
     2979         no-error .
     2980       if not available in-vatp_doc-attrocur then do:
     2981         assign
     2982           in-vatp-have-vat-sltocur = yes.
     2983       end.
     2984       else do:
     2985            in-vatp-have-vat-sltocur = no.
     2986       end.
     2987     end.
     2988     assign
     2989      price-cli-with-tax-lococur = cl_tt-clcparts.price-cli
     2990      cli-base-rateocur          = cl_tt-clcparts.cli-base-rate.
     2991     ASSIGN   road-tax-base-lococur  = (if cl_tt-clcparts.road-tax-base  = ? then 0 else cl_tt-clcparts.road-tax-base)
     2992              road-tax-rubl-lococur  = (if cl_tt-clcparts.road-tax-rubl  = ? then 0 else cl_tt-clcparts.road-tax-rubl).
     2993     ASSIGN  transport-base-lococur = (if cl_tt-clcparts.transport-base = ? then 0 else cl_tt-clcparts.transport-base)
     2994             transport-rubl-lococur = (if cl_tt-clcparts.transport-rubl = ? then 0 else cl_tt-clcparts.transport-rubl)
     2995             other-base-lococur     = (if cl_tt-clcparts.other-base     = ? then 0 else cl_tt-clcparts.other-base)
     2996             other-rubl-lococur     = (if cl_tt-clcparts.other-rubl     = ? then 0 else cl_tt-clcparts.other-rubl)
     2997             vat-pc-lococur         = (if cl_tt-clcparts.vat-pc         = ? then 0 else cl_tt-clcparts.vat-pc)
     2998             slt-pc-lococur         = (if cl_tt-clcparts.slt-pc         = ? then 0 else cl_tt-clcparts.slt-pc).
     2999             ASSIGN   slt-base-lococur    = (if in-vatp-have-vat-sltocur = no then 0 else (price-base-with-tax-lococur - ((if road-tax-base-lococur  = ? then 0 else road-tax-base-lococur) + (if transport-base-lococur = ? then 0 else transport-base-lococur) + (if other-base-lococur = ? then 0 else other-base-lococur)))                           * slt-pc-lococur / (100 + slt-pc-lococur))                        vat-base-lococur    = (if in-vatp-have-vat-sltocur = no then 0 else (price-base-with-tax-lococur - ((if road-tax-base-lococur  = ? then 0 else road-tax-base-lococur) + (if transport-base-lococur = ? then 0 else transport-base-lococur) + (if other-base-lococur = ? then 0 else other-base-lococur))) * (1 - slt-pc-lococur / (100 + slt-pc-lococur)) * vat-pc-lococur / (100 + vat-pc-lococur)).
     3000       ASSIGN   slt-rubl-lococur    = (if in-vatp-have-vat-sltocur = no then 0 else (price-rubl-with-tax-lococur - ((if road-tax-rubl-lococur  = ? then 0 else road-tax-rubl-lococur) + (if transport-rubl-lococur = ? then 0 else transport-rubl-lococur) + (if other-rubl-lococur = ? then 0 else other-rubl-lococur)))                           * slt-pc-lococur / (100 + slt-pc-lococur))                        vat-rubl-lococur    = (if in-vatp-have-vat-sltocur = no then 0 else (price-rubl-with-tax-lococur - ((if road-tax-rubl-lococur  = ? then 0 else road-tax-rubl-lococur) + (if transport-rubl-lococur = ? then 0 else transport-rubl-lococur) + (if other-rubl-lococur = ? then 0 else other-rubl-lococur))) * (1 - slt-pc-lococur / (100 + slt-pc-lococur)) * vat-pc-lococur / (100 + vat-pc-lococur)).
     3001     assign
     3002       exch-rate-cli-lococur = (cl_tt-clcparts.price-rubl - transport-rubl-lococur - other-rubl-lococur - road-tax-rubl-lococur - (if cl_tt-clcparts.vat-type <> 'в т. ч.':U then vat-rubl-lococur else 0) - (if cl_tt-clcparts.slt-type <> 'в т. ч.':U then slt-rubl-lococur else 0)) / cl_tt-clcparts.price-cli .
     3003     assign
     3004       slt-cli-lococur        = slt-rubl-lococur       / exch-rate-cli-lococur
     3005       vat-cli-lococur        = vat-rubl-lococur       / exch-rate-cli-lococur
     3006       road-tax-cli-lococur   = road-tax-rubl-lococur  / exch-rate-cli-lococur
     3007       transport-cli-lococur  = 0
     3008       other-cli-lococur      = 0
     3009     .
     3010   ASSIGN
     3011             price-base-without-tax-lococur = price-base-with-tax-lococur - vat-base-lococur - slt-base-lococur - ((if road-tax-base-lococur  = ? then 0 else road-tax-base-lococur) + (if transport-base-lococur = ? then 0 else transport-base-lococur) + (if other-base-lococur = ? then 0 else other-base-lococur))
     3012       price-rubl-without-tax-lococur = price-rubl-with-tax-lococur - vat-rubl-lococur - slt-rubl-lococur - ((if road-tax-rubl-lococur  = ? then 0 else road-tax-rubl-lococur) + (if transport-rubl-lococur = ? then 0 else transport-rubl-lococur) + (if other-rubl-lococur = ? then 0 else other-rubl-lococur))
     3013   .
     3014     assign
