     3495   procedure clcprtsl_calc-line :
     3496   define input  parameter parrec-line as recid no-undo.
     3497   define variable v-tax-date         as   date                     no-undo.
     3498   define variable v-vat-pc           like ub.doc-line.vat-pc       no-undo.
     3499   define variable varr-b             as   character                no-undo.
     3500   define variable varr-btype         as   character                no-undo.
     3501   define variable varcur-base        like ub.gds-dtl.price-base    no-undo.
     3502   define variable varcur-road-tax    like ub.doc-line.road-tax     no-undo.
     3503   define variable varcur-excise      like ub.doc-line.excise       no-undo.
     3504   define variable varcur-vat-pc      like ub.doc-line.vat-pc       no-undo.
     3505   define variable varcur-cons-vat-pc like ub.doc-line.cons-vat-pc  no-undo.
     3506   define variable varcur-slt-pc      like ub.doc-line.slt-pc       no-undo.
     3507   define variable varcur-fact-qnty   like ub.gds-dtl.fact-qnty     no-undo.
     3508   define variable varb-code          like ub.bar-code.b-code       no-undo.
     3509   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     3510   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     3511   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     3512   define variable varexcise          like ub.price-list.excise     no-undo.
     3513   define variable varlastcur-base        like ub.gds-dtl.price-base no-undo.
     3514   define variable varlastcur-road-tax    like ub.gds-dtl.price-base no-undo.
     3515   define variable varlastcur-excise      like ub.gds-dtl.price-base     no-undo.
     3516   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     3517   define variable v-varsum           as decimal                  no-undo.
     3518   define variable varprice-salef as decimal   no-undo .
     3519   define buffer bf_trn-doc             for ub.trn-doc.
     3520   define buffer bf_doc-line            for ub.doc-line.
     3521   define buffer bf_gds-dtl             for ub.gds-dtl.
     3522   define buffer bf_goods               for ub.goods.
     3523   define buffer bf_parts               for ub.parts.
     3524   define buffer bf_sysconf             for ub.sysconf.
     3525   define buffer bf_tt-allsum-line      for tt-allsum-line.
     3526   define buffer bfs_tt-allsum-line     for tt-allsum-line.
     3527   define buffer bfo_tt-allsum-line     for tt-allsum-line.
     3528   define buffer bfos_tt-allsum-line    for tt-allsum-line.
     3529   define buffer buf_parts        for ub.parts.
     3530   v-calcbypart = no.
     3531   do on error undo, return error return-value :
     3532   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     3533   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     3534     (output varr-b
     3535     )  .
     3536     find first bf_doc-line where recid (bf_doc-line) = parrec-line no-lock.
     3537     find first bf_trn-doc where bf_trn-doc.doc-code = bf_doc-line.doc-code no-lock.
     3538     find first bf_goods where bf_goods.artic     = bf_doc-line.artic     and
     3539                               bf_goods.prod-type = bf_doc-line.prod-type and
     3540                               bf_goods.prod-code = bf_doc-line.prod-code no-lock.
     3541     if bf_trn-doc.fact-date <> ?        then do:
     3542       assign v-tax-date = bf_trn-doc.fact-date.
     3543     end.
     3544     else do:
     3545       assign v-tax-date = ?.
     3546     end.
     3547   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3548   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     3549     (input  bf_goods.gds-code
     3550     ,input  '1':U
     3551     ,input  v-tax-date
     3552     ,input  bf_trn-doc.host-code
     3553     ,input  bf_trn-doc.obj-type
     3554     ,input  bf_trn-doc.obj-code
     3555     ,output v-vat-pc
     3556     ) no-error .
     3557     if error-status :error
     3558     or v-vat-pc = ? then do:
     3559        return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     3560     end.
     3561     if bf_goods.gds-type = 'у':U or
     3562        bf_trn-doc.status_ = 'запрос':U then do:
     3563       for each bf_tt-allsum-line
     3564       on error undo, return error return-value
     3565        :
     3566         delete bf_tt-allsum-line.
     3567       end.
     3568       create bf_tt-allsum-line.
     3569       assign
     3570        bf_tt-allsum-line.sum-type = 'основная_сумма':U.
     3571       for each bf_gds-dtl where bf_gds-dtl.doc-code  = bf_doc-line.doc-code  and
     3572                                 bf_gds-dtl.artic     = bf_doc-line.artic     and
     3573                                 bf_gds-dtl.prod-type = bf_doc-line.prod-type and
     3574                                 bf_gds-dtl.prod-code = bf_doc-line.prod-code no-lock on error undo, return error return-value :
     3575         assign
     3576           bf_tt-allsum-line.fact-qnty            =  bf_tt-allsum-line.fact-qnty        + bf_gds-dtl.fact-qnty
     3577           bf_tt-allsum-line.sum-dsc-base-doc     =  bf_tt-allsum-line.sum-dsc-base-doc + (bf_gds-dtl.price-base - bf_gds-dtl.discnt-base) * bf_gds-dtl.fact-qnty
     3578           bf_tt-allsum-line.sum-dsc-rubl-doc     =  bf_tt-allsum-line.sum-dsc-rubl-doc + (bf_gds-dtl.price-rubl - bf_gds-dtl.discnt-rubl) * bf_gds-dtl.fact-qnty
     3579           bf_tt-allsum-line.dsc-base-doc         =  bf_tt-allsum-line.dsc-base-doc     + bf_gds-dtl.discnt-base * bf_gds-dtl.fact-qnty
     3580           bf_tt-allsum-line.dsc-rubl-doc         =  bf_tt-allsum-line.dsc-rubl-doc     + bf_gds-dtl.discnt-rubl * bf_gds-dtl.fact-qnty
     3581           bf_tt-allsum-line.sum-dsc-base-cur     =  bf_tt-allsum-line.sum-dsc-base-cur + (if varr-b = "base" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base / bf_trn-doc.exch-rate * bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     3582           bf_tt-allsum-line.sum-dsc-rubl-cur     =  bf_tt-allsum-line.sum-dsc-rubl-cur + (if varr-b = "rubl" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base * bf_trn-doc.exch-rate / bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     3583           bf_tt-allsum-line.sum-dsc-base-acc     =  bf_tt-allsum-line.sum-dsc-base-acc + bf_doc-line.price-base * bf_gds-dtl.fact-qnty
     3584           bf_tt-allsum-line.sum-dsc-rubl-acc     =  bf_tt-allsum-line.sum-dsc-rubl-acc + bf_doc-line.price-rubl * bf_gds-dtl.fact-qnty
     3585           bf_tt-allsum-line.sum-dsc-cli-acc      =  ?
     3586           bf_tt-allsum-line.vat-base-acc         =  bf_tt-allsum-line.vat-base-acc     + bf_doc-line.price-base * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     3587           bf_tt-allsum-line.vat-rubl-acc         =  bf_tt-allsum-line.vat-rubl-acc     + bf_doc-line.price-rubl * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     3588           bf_tt-allsum-line.vat-cli-acc          =  ?
     3589           .
     3590       end.
     3591       assign
     3592         bf_tt-allsum-line.cli-qnty             =  ?
     3593         bf_tt-allsum-line.slt-base-doc         =  bf_tt-allsum-line.sum-dsc-base-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     3594         bf_tt-allsum-line.slt-rubl-doc         =  bf_tt-allsum-line.sum-dsc-rubl-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     3595         bf_tt-allsum-line.vat-base-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-base-doc - bf_tt-allsum-line.slt-base-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
