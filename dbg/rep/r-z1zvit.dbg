     1539   procedure create_obj-list :
     1540      define input parameter p-obj-type like ub.clients.obj-type no-undo .
     1541      define input parameter p-obj-code like ub.clients.obj-code no-undo .
     1542      do
     1543      on error undo, return error return-value
     1544      :
     1545         define buffer cli-obj for ub.clients .
     1546         define variable p-var as integer no-undo .
     1547         define buffer buf_obj-list for obj-list .
     1548         find last buf_obj-list  use-index pi no-error .
     1549         if available buf_obj-list
     1550         then
     1551            p-var = buf_obj-list.obj-id + 1.
     1552         else
     1553            p-var = 1.
     1554         find first cli-obj where
     1555                   cli-obj.obj-type = p-obj-type
     1556               and cli-obj.obj-code = p-obj-code
     1557         no-lock no-error.
     1558         if available cli-obj
     1559         then do:
     1560            create buf_obj-list.
     1561            assign
     1562               buf_obj-list.obj-id   = p-var
     1563               buf_obj-list.obj-code = cli-obj.obj-code
     1564               buf_obj-list.obj-type = cli-obj.obj-type
     1565               buf_obj-list.obj-name = cli-obj.obj-name
     1566               buf_obj-list.db-num   = cli-obj.db-num
     1567            .
     1568         end.
     1569      end.
     1570   end.
