      301   define  stream PrnLibStream.
      302   procedure prn-lib-prn-file :
      303     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      304     define input parameter p-DIsabledoptions as integer no-undo .
      305     define variable v-report-name as character no-undo .
      306     define variable v-user-action as character no-undo .
      307     define variable v-printed     as logical   no-undo .
      308     define variable v-exist       as logical   no-undo .
      309     do
      310       on error undo, return error
      311       :
      312       run prn-lib-get-report-name  in this-procedure (
      313         input parParentProc
      314         ,output v-report-name
      315         ).
      316   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      317   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      318     (input  v-report-name
      319     ,input  2
      320     ,output v-exist
      321     )  .
      322       if NOT v-exist then
      323       DO:
      324         Message
      325           "Нет заданий на печать ! "
      326           view-as alert-box .
      327         Return  .
      328       End.
      329       run gbl/prnfilen.w
      330         (input  ""
      331         ,input  p-DisabledOptions
      332         ,input  string(v-report-name )
      333         ,input  7
      334         ,output v-user-action
      335         ,output v-printed
      336         ) .
      337       if v-printed then
      338       do:
      339         return "YES" .
      340       end.
      341       else
      342       do:
      343         return "NO" .
      344       end.
      345     end.
      346   end procedure.
      347   procedure prn-lib-open-stream :
      348     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      349     define input parameter p-page-size    as integer no-undo .
      350     define input parameter p-is-stream    as logical no-undo .
      351     define input parameter p-append       as logical no-undo .
      352     define variable v-report-name as character no-undo .
      353     do
      354       on error undo, return error
      355       :
      356       run prn-lib-get-report-name  in this-procedure (
      357         input parParentProc
      358         ,output v-report-name
      359         ).
      360       if p-is-stream then
      361       do:
      362         if p-append then
      363         do:
      364           output stream PrnLibStream to value( v-report-name )
      365             page-size value(p-page-size) append .
      366         end.
      367         if not p-append then
      368         do:
      369           output stream PrnLibStream to value( v-report-name )
      370             page-size value(p-page-size) .
      371         end.
      372       end.
      373       if not p-is-stream then
      374       do:
      375         if p-append then
      376         do:
      377           output to value( v-report-name )
      378             page-size value(p-page-size) append .
      379         end.
      380         if not p-append then
      381         do:
      382           output to value( v-report-name )
      383             page-size value(p-page-size) .
      384         end.
      385       end.
      386     end.
      387   end procedure.
      388   procedure prn-lib-open-exp :
      389     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      390     define input parameter p-is-stream    as logical no-undo .
      391     define input parameter p-is-append    as logical no-undo .
      392     define output parameter p-ReportFileName as char init "report" no-undo.
      393     define output parameter p-process as logical no-undo .
      394     define variable glog as logical no-undo .
      395     do
      396       on error undo, return error
      397       :
      398       SYSTEM-DIALOG GET-FILE p-ReportFileName
      399         TITLE      "Укажите путь"
      400         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      401         ASK-OVERWRITE
      402         CREATE-TEST-FILE
      403         SAVE-AS
      404         USE-FILENAME
      405         DEFAULT-EXTENSION "txt"
      406         UPDATE glog
      407         .
      408       if not glog then  return.
      409       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      410       if p-is-stream then
      411       do:
      412         if p-is-append then
      413         do:
      414           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      415         end.
      416         else
      417         do:
      418           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      419         end.
      420       end.
      421       else
      422       do:
      423         if p-is-append then
      424         do:
      425           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      426         end.
      427         else
      428         do:
      429           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      430         end.
      431       end.
      432       p-process = yes.
      433     end.
      434   end procedure.
      435   procedure prn-lib-get-report-name :
      436     define input parameter parParentProc  as widget-handle no-undo.
      437     define output parameter p-report-name as character no-undo .
      438     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      439   end procedure.
      440   procedure prn-lib-reportviewer-report-name :
      441     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      442     define input parameter p-report-name-html as character no-undo .
      443     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      444   end procedure.
      445   procedure prn-lib-reportviewer :
      446     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      447     define input parameter p-report-name-html as character no-undo .
      448     define input parameter p-param        as character no-undo .
      449     define variable v-excel           as character no-undo init 'TRUE' .
      450     define variable v-value-character as character no-undo .
      451     define variable v-value-integer   as character no-undo .
      452     define variable v-value-date      as date      no-undo .
      453     define variable v-value-decimal   as decimal   no-undo .
      454     define variable rep-excel         as logical   no-undo .
      455     define variable excel-string      as character no-undo .
      456     define variable v-param-type      as character no-undo .
      457     define variable v-tth             as handle    no-undo .
      458     run adm/shattri.p (
      459       input "get":U
      460       ,input  ""
      461       ,input  0
      462       ,input  'report-glob':U
      463       ,input  'rep-excel':U
      464       ,output v-value-character
      465       ,output v-value-date
      466       ,output v-value-decimal
      467       ,output v-value-integer
      468       ,output rep-excel
      469       ,output v-param-type
      470       ,INPUT-OUTPUT table-handle v-tth
      471       )  .
      472     if rep-excel then v-excel = "TRUE" .
      473     else v-excel = "FALSE" .
      474     if p-param eq ""
      475     then
      476        p-param = "EXCEL:" + v-excel.
      477     else
      478        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      479     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      480   end procedure.
      481   define variable vss-include-info4 as character format "X(65)" no-undo
      482   initial "@(#)$Workfile$ $Revision$".
      483   define temp-table temp_cgrplib_grp no-undo
      484       field sel           as character
      485       field full-name     as character
      486       field sort-name     as character
      487       field node-code     as integer
      488       field upper-code    as integer
      489       field d-pcnt        as decimal
      490       field name          as character
      491       field level         as integer
      492       field mark          as character
      493       index pi is primary unique sort-name
      494       index fn full-name
      495       index nc is unique node-code
      496       index sl sel
      497       index uc upper-code
      498   .
      499   define temp-table temp_cgrplib_found-grp no-undo
      500       field full-name   as character
      501       field sort-name   as character
      502       field node-code   as integer
      503       field level       as integer
      504       field is-terminal as logical
      505       field d-pcnt      as decimal
      506       index pi is primary unique sort-name
      507       index fn full-name
      508       index lv level
      509       index it is-terminal
      510   .
      511   define temp-table temp_cfound-result-nodelist no-undo
      512       field node-code     as recid
      513       field processed     as logical
      514       field full-name     as character
      515       field sort-name     as character
      516       index pi is primary unique node-code
      517       index ps processed
      518   .
      519   procedure cli-grplib-get-sort-name :
      520   do
      521   on error undo, return error
      522   :
      523   define input parameter p-node-code  as integer      no-undo.
      524   define output parameter p-sort-name as character    no-undo.
      525       define variable v-upper-code    as integer           no-undo.
      526       define buffer buf_cli-grp       for ub.cli-grp.
      527       define buffer buf_upper_cli-grp for ub.cli-grp.
      528       find first buf_cli-grp no-lock
      529            where buf_cli-grp.node-code = p-node-code
      530       no-error.
      531       if not available buf_cli-grp
      532       then do:
      533           undo, return error "cli-grplib-get-sort-name: Не найдена группа клиентов с кодом " + string( p-node-code ).
      534       end.
      535       assign
      536           p-sort-name  = ""
      537           v-upper-code = 1
      538       .
      539       do while buf_cli-grp.upper-code <> 0
      540       on error undo, return error "cli-grplib-get-sort-name: Ошибка составления полного имени группы"
      541       :
      542           assign
      543               p-sort-name  = buf_cli-grp.node-name
      544                            + (if p-sort-name <> "" then chr(2) else "")
      545                            + p-sort-name
      546               v-upper-code = buf_cli-grp.upper-code
      547           .
      548           find first buf_cli-grp no-lock
      549                where buf_cli-grp.node-code = v-upper-code
      550           no-error.
      551           if not available buf_cli-grp
      552           then do:
      553               undo, return error "cli-grplib-get-sort-name: Не найдена группа клиентов с кодом "
      554                                   + string( v-upper-code )
      555                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      556           end.
      557       end.
      558   end.
      559   end procedure.
      560   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      561   procedure cli-grplib-get-full-name :
      562      define input parameter  p-node-code  as integer      no-undo.
      563      define output parameter p-full-name as character    no-undo.
      564   do
      565   on error undo, return error
      566   :
      567       define variable v-upper-code    as integer           no-undo.
      568       define buffer buf_cli-grp       for ub.cli-grp.
      569       define buffer buf_upper_cli-grp for ub.cli-grp.
      570       find first buf_cli-grp no-lock
      571            where buf_cli-grp.node-code = p-node-code
      572       no-error.
      573       if not available buf_cli-grp
      574       then do:
      575           undo, return error "cli-grplib-get-full-name: Не найдена группа клиентов с кодом " + string( p-node-code ).
      576       end.
      577       assign
      578           p-full-name  = ""
      579           v-upper-code = 1
      580       .
      581       do while buf_cli-grp.upper-code <> 0
      582       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
      583       :
      584           assign
      585               p-full-name  = buf_cli-grp.node-name
      586                            + (if p-full-name <> "" then chr(47) else "")
      587                            + p-full-name
      588               v-upper-code = buf_cli-grp.upper-code
      589           .
      590           find first buf_cli-grp no-lock
      591                where buf_cli-grp.node-code = v-upper-code
      592           no-error.
      593           if not available buf_cli-grp
      594           then do:
      595               undo, return error "cli-grplib-get-full-name: Не найдена группа клиентов с кодом "
      596                                   + string( v-upper-code )
      597                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      598           end.
      599       end.
      600       assign
      601       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      602       .
      603   end.
      604   end .
      605   procedure cgrplib-get-node-from-full-name :
      606   define input parameter p-full-name as character no-undo .
      607   define output parameter p-node-code as integer no-undo .
      608   define variable v-ii as integer no-undo .
      609   define variable v-upper-code as integer no-undo .
      610   define variable v-root-code as integer no-undo .
      611   define variable v-entry as character no-undo .
      612   define buffer buf_cli-grp       for ub.cli-grp.
      613   do
      614   on error undo, return error
      615   :
      616     find first buf_cli-grp no-lock
      617         where buf_cli-grp.upper-code = 0
      618     no-error .
      619     if not available buf_cli-grp
      620     then do:
      621         undo, return error substitute("Не найдена корневая группа клиентов (upper-code = 0)").
      622     end.
      623     else do:
      624       assign
      625       v-root-code = buf_cli-grp.node-code
      626       .
      627     end.
      628     v-upper-code = v-root-code.
      629     do v-ii = 1 to num-entries(p-full-name, chr(47)):
      630       assign
      631       v-entry = entry(v-ii, p-full-name, chr(47)).
      632       if v-entry = '' then leave.
      633       find first buf_cli-grp no-lock where
      634                 buf_cli-grp.node-name = v-entry
      635             and buf_cli-grp.upper-code = v-upper-code
      636             no-error.
      637       if not available buf_cli-grp then do:
      638         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
      639       end.
      640       else do:
      641         p-node-code = buf_cli-grp.node-code.
      642         v-upper-code = buf_cli-grp.node-code.
      643       end.
      644     end.
      645   end.
      646   end .
      647   procedure cgrplib-get-root-code :
      648   do
      649   on error undo, return error
      650   :
      651   define output parameter p-root-code as integer      no-undo.
      652       define buffer buf_cli-grp       for ub.cli-grp.
      653       find first buf_cli-grp no-lock
      654           where buf_cli-grp.upper-code = 0
      655       no-error .
      656       if not available buf_cli-grp
      657       then do:
      658           undo, return error .
      659       end.
      660       else do:
      661           assign
      662               p-root-code = buf_cli-grp.node-code
      663           .
      664       end.
      665   end.
      666   end procedure.
      667   procedure cgrplib-find-grp-by-full-name :
      668   do
      669   on error undo, return error
      670   :
      671   define input parameter p-search-name  as character    no-undo.
      672   define input parameter p-fill-path    as logical      no-undo.
      673       define variable v-upper-code    as integer          no-undo.
      674       define variable v-not-found     as logical init yes no-undo.
      675       define variable v-counter       as integer           no-undo.
      676       define variable v-level         as integer           no-undo.
      677       define variable v-full-name     as character         no-undo.
      678       define variable v-sort-name     as character         no-undo.
      679       define buffer buf_cli-grp       for ub.cli-grp.
      680       assign
      681           p-search-name = replace( p-search-name, chr(47), chr(2) )
      682       .
      683       run cgrplib-get-root-code ( output v-upper-code ) no-error .
      684       if error-status :error
      685       then do:
      686           undo, return error "cgrplib-expand-name: Ошибка при поиске корневого узла".
      687       end.
      688       assign
      689           v-full-name  = ""
      690           v-level      = num-entries( p-search-name, chr(2) )
      691       .
      692       for each temp_cgrplib_found-grp
      693       :
      694           delete temp_cgrplib_found-grp.
      695       end.
      696       start-name-analyze:
      697       do v-counter = 1 to v-level
      698       :
      699           if v-counter < v-level
      700           then do:
      701               find first buf_cli-grp no-lock
      702                    where buf_cli-grp.upper-code = v-upper-code
      703                      and buf_cli-grp.node-name  = entry( v-counter, p-search-name, chr(2) )
      704               no-error .
      705               if not available buf_cli-grp
      706               then do:
      707                   assign
      708                       v-full-name  = p-search-name
      709                       v-sort-name  = p-search-name
      710                   .
      711                   return error "cgrplib-expand-name: не найдена группа " + entry( v-level, p-search-name, chr(2) ).
      712               end.
      713               else do:
      714                   assign
      715                       v-full-name = v-full-name + (if v-full-name = "" then "" else chr(47) )         + buf_cli-grp.node-name
      716                       v-sort-name = v-sort-name + ( if v-sort-name = "" then "" else chr(2) ) + buf_cli-grp.node-name
      717                       v-upper-code = buf_cli-grp.node-code
      718                   .
      719                   if p-fill-path = yes
      720                   then do:
      721                       create temp_cgrplib_found-grp.
      722                       assign
      723                           temp_cgrplib_found-grp.full-name = v-full-name + chr(47)
      724                           temp_cgrplib_found-grp.sort-name = v-sort-name
      725                           temp_cgrplib_found-grp.node-code = v-upper-code
      726                           temp_cgrplib_found-grp.level     = v-counter
      727                       .
      728                   end.
      729               end.
      730           end.
      731           else do:
      732               for each buf_cli-grp no-lock
      733                  where buf_cli-grp.upper-code = v-upper-code
      734                    and buf_cli-grp.node-name begins entry( v-counter, p-search-name, chr(2) )
      735               :
      736                   assign
      737                       v-not-found = no
      738                   .
      739                   create temp_cgrplib_found-grp.
      740                   assign
      741                       temp_cgrplib_found-grp.full-name = v-full-name
      742                                                           + ( if v-full-name = "" then "" else chr(47) )
      743                                                           + buf_cli-grp.node-name + chr(47)
      744                       temp_cgrplib_found-grp.sort-name = v-sort-name
      745                                                           + ( if v-sort-name = "" then "" else chr(2) )
      746                                                           + buf_cli-grp.node-name
      747                       temp_cgrplib_found-grp.node-code = buf_cli-grp.node-code
      748                       temp_cgrplib_found-grp.level     = v-level
      749                   .
      750               end.
      751               if v-not-found = yes
      752               then do:
      753                   assign
      754                       v-full-name  = p-search-name
      755                       v-sort-name  = p-search-name
      756                   .
      757                   for each temp_cgrplib_found-grp
      758                   :
      759                       delete temp_cgrplib_found-grp.
      760                   end.
      761                   return error "cgrplib-expand-name: не найдена группа " + entry( v-level, p-search-name, chr(2) ).
      762               end.
      763           end.
      764       end.
      765   end.
      766   end procedure.
      767   procedure cgrplib-find-all-subgroup :
      768   do
      769   on error undo, return error
      770   :
      771   define input parameter p-start-node-code    as integer      no-undo.
      772   define input parameter p-terminal-only      as logical      no-undo.
      773       define variable v-start-full-name   as character     no-undo.
      774       define variable v-start-sort-name   as character     no-undo.
      775       define variable v-not-found         as logical       no-undo.
      776       define variable v-is-terminal       as logical       no-undo.
      777       define variable v-d-pcnt            as decimal       no-undo.
      778       define buffer buf_cli-grp           for ub.cli-grp.
      779       create temp_cfound-result-nodelist.
      780       assign
      781           temp_cfound-result-nodelist.node-code = p-start-node-code
      782           temp_cfound-result-nodelist.processed = no
      783       .
      784       run cli-grplib-get-full-name in this-procedure (
      785             input p-start-node-code
      786           , output v-start-full-name
      787       ).
      788       run cli-grplib-get-sort-name in this-procedure (
      789             input p-start-node-code
      790           , output v-start-sort-name
      791       ).
      792       process-nodes:
      793       do while yes
      794       :
      795           find first temp_cfound-result-nodelist
      796                where temp_cfound-result-nodelist.node-code = p-start-node-code
      797           .
      798           assign
      799               temp_cfound-result-nodelist.processed = yes
      800           .
      801           for each buf_cli-grp no-lock
      802              where buf_cli-grp.upper-code = p-start-node-code
      803           on error undo, return error
      804           :
      805               run cgrplib-is-terminal in this-procedure (
      806                     input buf_cli-grp.node-code
      807                   , output v-is-terminal
      808               ).
      809               if v-is-terminal = yes
      810               then do:
      811                   create temp_cgrplib_found-grp.
      812                   assign
      813                       temp_cgrplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
      814                                                           chr(47) + buf_cli-grp.node-name + chr(47)
      815                       temp_cgrplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
      816                                                           chr(2) + buf_cli-grp.node-name + chr(2)
      817                       temp_cgrplib_found-grp.node-code   = buf_cli-grp.node-code
      818                       temp_cgrplib_found-grp.is-terminal = yes
      819                   .
      820                  run cgrplib-get-pcnt-value in this-procedure ( input temp_cgrplib_found-grp.node-code , output v-d-pcnt) no-error .
      821                  if not error-status:error then do:
      822                    temp_cgrplib_found-grp.d-pcnt = v-d-pcnt.
      823                  end.
      824                  else do:
      825                    temp_cgrplib_found-grp.d-pcnt = ?.
      826                  end.
      827               end.
      828               else do:
      829                   create temp_cfound-result-nodelist.
      830                   assign
      831                       temp_cfound-result-nodelist.node-code = buf_cli-grp.node-code
      832                       temp_cfound-result-nodelist.full-name = right-trim(v-start-full-name, chr(47)) +
      833                                                              chr(47) + buf_cli-grp.node-name + chr(47)
      834                       temp_cfound-result-nodelist.sort-name = right-trim(v-start-sort-name, chr(2)) +
      835                                                              chr(2) + buf_cli-grp.node-name + chr(2)
      836                       temp_cfound-result-nodelist.processed = no
      837                   .
      838                   if p-terminal-only = no
      839                   then do:
      840                       create temp_cgrplib_found-grp.
      841                       assign
      842                           temp_cgrplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
      843                                                               chr(47) + buf_cli-grp.node-name + chr(47)
      844                           temp_cgrplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
      845                                                               chr(2) + buf_cli-grp.node-name + chr(2)
      846                           temp_cgrplib_found-grp.node-code   = buf_cli-grp.node-code
      847                           temp_cgrplib_found-grp.is-terminal = no
      848                       .
      849                   end.
      850               end.
      851           end.
      852           find first temp_cfound-result-nodelist
      853                where temp_cfound-result-nodelist.processed = no
      854           no-error.
      855           if not available temp_cfound-result-nodelist
      856           then do:
      857               leave process-nodes.
      858           end.
      859           else do:
      860               assign
      861                   p-start-node-code = temp_cfound-result-nodelist.node-code
      862                   v-start-full-name = temp_cfound-result-nodelist.full-name
      863                   v-start-sort-name = temp_cfound-result-nodelist.sort-name
      864               .
      865           end.
      866       end.
      867   end.
      868   end procedure.
      869   procedure cgrplib-expand-name :
      870   do
      871   on error undo, return error
      872   :
      873   define input parameter p-start-name as character        no-undo.
      874   define output parameter p-end-name  as character        no-undo.
      875       define variable v-is-terminal     as logical           no-undo.
      876       define buffer buf_temp_cgrplib_found-grp     for temp_cgrplib_found-grp.
      877       run cgrplib-find-grp-by-full-name in this-procedure (
      878             input p-start-name
      879           , input no
      880       ) no-error.
      881       run cgrplib-get-max-substring in this-procedure (
      882                   input length( p-start-name )
      883                 , output p-end-name
      884       ) no-error .
      885       if error-status :error
      886       then do:
      887           assign
      888               p-end-name = ""
      889           .
      890       end.
      891       else do:
      892           find first temp_cgrplib_found-grp
      893               where temp_cgrplib_found-grp.full-name = p-end-name
      894           no-error.
      895           if available temp_cgrplib_found-grp
      896           then do:
      897               find first buf_temp_cgrplib_found-grp
      898                   where buf_temp_cgrplib_found-grp.full-name begins p-end-name
      899                   and recid( buf_temp_cgrplib_found-grp ) <> recid( temp_cgrplib_found-grp )
      900               no-error.
      901               if not available buf_temp_cgrplib_found-grp
      902               then do:
      903                   run cgrplib-is-terminal in this-procedure (
      904                       input temp_cgrplib_found-grp.node-code
      905                       , output v-is-terminal
      906                   ).
      907               end.
      908           end.
      909       end.
      910   end.
      911   end procedure.
      912   procedure cgrplib-get-max-substring :
      913   do
      914   on error undo, return error
      915   :
      916   define input parameter p-min-substring-length   as integer      no-undo.
      917   define output parameter p-substring             as character    no-undo.
      918           define variable v-char-counter  as integer           no-undo.
      919           define variable v-current-char  as character         no-undo.
      920           define variable v-names-counter  as integer           no-undo.
      921           define variable v-base-string   as character         no-undo.
      922           assign
      923               v-char-counter  = p-min-substring-length
      924           .
      925           find first temp_cgrplib_found-grp no-error.
      926           if not available temp_cgrplib_found-grp
      927           then do:
      928               undo, return error "cgrplib-get-max-substring: Нет строк для вычисления общей подстроки".
      929           end.
      930           else do:
      931               assign
      932                   v-base-string = temp_cgrplib_found-grp.full-name
      933               .
      934               counter-block:
      935               do while yes
      936               on error undo, return error "cgrplib-get-max-substring: Ошибка вычисления продолжения имени группы."
      937               :
      938                   assign
      939                       v-char-counter  = v-char-counter + 1
      940                       v-current-char  = substring( v-base-string, v-char-counter, 1 )
      941                       v-names-counter = 0
      942                   .
      943                   compare-block:
      944                   for each temp_cgrplib_found-grp
      945                   :
      946                       assign
      947                           v-names-counter = v-names-counter + 1
      948                       .
      949                       if v-names-counter = 1
      950                       then do:
      951                           next compare-block.
      952                       end.
      953                       if substring( temp_cgrplib_found-grp.full-name, v-char-counter, 1 ) <> v-current-char
      954                       then do:
      955                           leave counter-block.
      956                       end.
      957                   end.
      958                   if v-names-counter = 1
      959                   then do:
      960                       assign
      961                           p-substring = v-base-string
      962                       .
      963                       return.
      964                   end.
      965               end.
      966               assign
      967                   p-substring = substring( v-base-string, 1, v-char-counter - 1 )
      968               .
      969           end.
      970   end.
      971   end procedure.
      972   procedure cgrplib-is-terminal :
      973   do
      974   on error undo, return error "Ошибка процедуры cgrplib-is-terminal"
      975   :
      976   define input parameter p-node-code      as integer      no-undo.
      977   define output parameter p-is-terminal   as logical      no-undo.
      978       define buffer buf_cli-grp       for ub.cli-grp.
      979       find first buf_cli-grp no-lock
      980           where buf_cli-grp.upper-code = p-node-code
      981       no-error .
      982       if not available buf_cli-grp
      983       then do:
      984           assign
      985               p-is-terminal = yes
      986           .
      987       end.
      988       else do:
      989           assign
      990               p-is-terminal = no
      991           .
      992       end.
      993   end.
      994   end procedure.
      995   procedure cgrplib-have-clients :
      996   do
      997   on error undo, return error
      998   :
      999   define input parameter p-node-code      as integer      no-undo.
     1000   define output parameter p-have-clients   as logical      no-undo.
     1001       define buffer buf_clients         for ub.clients.
     1002       find first buf_clients no-lock
     1003            where buf_clients.grp-code = p-node-code
     1004       no-error .
     1005       if available buf_clients
     1006       then do:
     1007           assign
     1008               p-have-clients = yes
     1009           .
     1010       end.
     1011       else do:
     1012           assign
     1013               p-have-clients = no
     1014           .
     1015       end.
     1016   end.
     1017   end procedure.
     1018   procedure cgrplib-find-by-substring :
     1019   do
     1020   on error undo, return error
     1021   :
     1022   define input parameter p-start-code         as integer      no-undo.
     1023   define input parameter p-full-search-string as character    no-undo.
     1024   define output parameter p-found-code        as integer      no-undo.
     1025   define output parameter p-full-name         as character    no-undo.
     1026       define variable v-start-code     as integer           no-undo.
     1027       define variable v-found          as logical  init no  no-undo.
     1028       define buffer buf_cli-grp       for ub.cli-grp.
     1029       search-grp:
     1030       for each buf_cli-grp no-lock
     1031           where buf_cli-grp.node-code > p-start-code
     1032       :
     1033           if index( buf_cli-grp.node-name, p-full-search-string ) <> 0
     1034           then do:
     1035               assign
     1036                   p-found-code = buf_cli-grp.node-code
     1037                   v-found      = yes
     1038               .
     1039               run cli-grplib-get-full-name in this-procedure (
     1040                     input p-found-code
     1041                   , output p-full-name
     1042               ) no-error .
     1043               if error-status :error
     1044               then do:
     1045                   undo, return error "cgrplib-find-by-substring: Ошибка вычисления полного имени группы." + chr(10) + return-value.
     1046               end.
     1047               leave search-grp.
     1048           end.
     1049       end.
     1050       if v-found = yes
     1051       then do:
     1052       end.
     1053       else do:
     1054           assign
     1055               p-full-name  = ""
     1056               p-found-code = 0
     1057           .
     1058       end.
     1059   end.
     1060   end procedure.
     1061   procedure cgrplib-analyze-grp-name :
     1062   do
     1063   on error undo, return error
     1064   :
     1065   define input parameter p-grp-name       as character            no-undo.
     1066   define input parameter p-upper-code     as integer              no-undo.
     1067   define output parameter p-error-message as character init ""    no-undo.
     1068       define variable v-char-list     as character    no-undo.
     1069       define variable v-char-counter  as integer      no-undo.
     1070       define variable v-full-name     as character    no-undo.
     1071       if p-grp-name = "" then do:
     1072           assign
     1073               p-error-message = "Название группы не может быть пустым.".
     1074           .
     1075       end.
     1076       else do:
     1077           assign
     1078               v-char-list = "47,92,58,63,34,60,62,171,187,183"
     1079           .
     1080           do v-char-counter = 1 to num-entries( v-char-list )
     1081           :
     1082               if index( p-grp-name, chr( integer( entry( v-char-counter, v-char-list ) ) ) ) <> 0
     1083               then do:
     1084                   assign
     1085                       p-error-message = 'Название группы не может содержать символы /\:*?"<>|«»·'
     1086                   .
     1087                   return.
     1088               end.
     1089           end.
     1090           run cli-grplib-get-full-name in this-procedure (
     1091                 input p-upper-code
     1092               , output v-full-name
     1093           ) no-error .
     1094           if error-status :error
     1095           then do:
     1096               undo, return error "cgrplib-analyze-grp-name: Не удалось вычислить полное имя группы." + chr(10) + return-value.
     1097           end.
     1098           if length( v-full-name ) + 1 + length( p-grp-name ) > 120
     1099           then do:
     1100               assign
     1101                   p-error-message = 'Полное название группы не может содержать более 120 символов.'
     1102               .
     1103           end.
     1104       end.
     1105   end.
     1106   end procedure.
     1107   procedure cgrplib-get-lvl-num :
     1108   define input parameter p-node-code  as integer      no-undo.
     1109   define output parameter p-lvl-num   as integer      no-undo.
     1110       define variable v-full-name    as character    no-undo.
     1111   do
     1112   on error undo, return error
     1113   :
     1114       run cli-grplib-get-full-name in this-procedure (
     1115             input p-node-code
     1116           , output v-full-name
     1117       ).
     1118       assign
     1119           p-lvl-num = num-entries( v-full-name, chr(47) ) - 1
     1120       .
     1121       if p-lvl-num = -1
     1122       then do:
     1123           assign
     1124               p-lvl-num = 0
     1125           .
     1126       end.
     1127   end.
     1128   end procedure.
     1129   PROCEDURE cgrplib-get-pcnt-value :
     1130   DEFINE INPUT PARAMETER p-node-code AS INTEGER NO-UNDO.
     1131   DEFINE output PARAMETER p-pcnt-value AS DECIMAL NO-UNDO.
     1132   define buffer buf_dis-grp-rule for ub.dis-grp-rule.
     1133   define buffer buf_dis-rule for ub.dis-rule.
     1134   find first buf_dis-grp-rule no-lock where
     1135             buf_dis-grp-rule.classif-type = 'cli-grp':U
     1136         and buf_dis-grp-rule.node-code = p-node-code
     1137         and buf_dis-grp-rule.host-code = 0
     1138         and buf_dis-grp-rule.obj-type = '':U
     1139         and buf_dis-grp-rule.obj-code = 0
     1140         and buf_dis-grp-rule.pos-type = '-':U
     1141         and buf_dis-grp-rule.discnt-role = 'cli-grp-pcnt':U no-error.
     1142   if available buf_dis-grp-rule then do:
     1143     find first buf_dis-rule no-lock where
     1144               buf_dis-rule.rule-num = buf_dis-grp-rule.rule-num no-error.
     1145     if available buf_dis-rule then do:
     1146       assign
     1147       p-pcnt-value        = buf_dis-rule.discnt-value.
     1148       .
     1149     end.
     1150   end.
     1151   END PROCEDURE.
     1152   do
     1153   on error undo, return error
     1154   :
     1155   define temp-table temp_clients no-undo
     1156   field obj-type as character
     1157   field obj-code as integer
     1158   field full-grp-name  as character
     1159   field cli-name  as character
     1160   index pi    is primary unique obj-type obj-code
     1161   index grp full-grp-name
     1162   .
     1163   define variable grp-path    like ub.clients.grp-name  no-undo.
     1164   define variable v-line              as character         no-undo.
     1165   define variable v-status            as character         no-undo.
     1166   define variable v-node-name         as character         no-undo.
     1167   define variable v-d-pcnt            as decimal           no-undo.
     1168   define variable v-start-node-name   as character     no-undo.
     1169   define variable v-is-terminal       as logical       no-undo.
     1170   define variable sym1 as character  init ":"   no-undo.
     1171   define variable sym2 as character  init ":"   no-undo.
     1172   define variable sym3 as character  init ":"   no-undo.
     1173   define variable sym4 as character  init ":"   no-undo.
     1174   define variable sym5 as character  init ":"   no-undo.
     1175   define buffer buf_start_cli-grp for ub.cli-grp.
     1176   define buffer buf_cli-grp       for ub.cli-grp.
     1177   define buffer buf_clients         for ub.clients.
     1178   define frame cliListRpt
     1179   sym1 column-label ":" format "x(1)"
     1180   buf_clients.obj-name column-label "Наименование" format "x(50)"
     1181   sym2 column-label ":" format "x(1)"
     1182   buf_clients.obj-type column-label "Тип" format "x(8)"
     1183   sym3 column-label ":" format "x(1)"
     1184   buf_clients.obj-code column-label "Код" format "999999999"
     1185   sym4 column-label ":" format "x(1)"
     1186   v-status column-label "Статус" format "x(14)"
     1187   sym5 column-label ":" format "x(1)"
     1188   header
     1189   cur-time-print() at 5 format "X(35)"
     1190   string( "Страница " + string( PAGE-NUMBER( PrnLibStream )  , ">>>>9") ) at 54 format "X(17)" skip
     1191   v-line format "X(94)" at 1
     1192   with width 235 down stream-io use-text .
     1193   define frame frmgrp
     1194   v-node-name column-label "Название"  format "X(122)"
     1195   v-d-pcnt column-label " Скидка " format ">9.99%"
     1196   with width 160 down stream-io use-text no-labels no-box .
     1197   find first buf_start_cli-grp no-lock
     1198        where recid( buf_start_cli-grp ) = p-cli-grp-recid
     1199   .
     1200   run cli-grplib-get-full-name in this-procedure( input buf_start_cli-grp.node-code, output grp-path ).
     1201   if session :set-wait-state( "compiler" ) then.
     1202   run prn-lib-open-stream  in this-procedure (
     1203                                                input parParentProc
     1204                                               ,input 62
     1205                                               ,input yes
     1206                                               ,input no
     1207                                               ).
     1208   assign
     1209   v-line = fill( "-", 94 )
     1210   .
     1211   put stream PrnLibStream space(20) "СПИСОК  ГРУПП  КЛИЕНТОВ." format "x(30)" skip(1).
     1212   form header
     1213   v-line format "X(94)"
     1214   skip "Продолжение - на следующей странице" at 30
     1215   skip
     1216   with frame cliBottomframe
     1217   width 235
     1218   page-bottom
     1219   no-labels
     1220   no-box
     1221   .
     1222   run cgrplib-find-all-subgroup in this-procedure (
     1223             input buf_start_cli-grp.node-code
     1224           , input no
     1225   ).
     1226   if p-print-option = "terminal":U
     1227   then do:
     1228       view stream PrnLibStream frame clibottomframe .
     1229       run cgrplib-is-terminal in this-procedure (
     1230             input buf_start_cli-grp.node-code
     1231           , output v-is-terminal
     1232       ).
     1233       if v-is-terminal = yes then do:
     1234           put stream PrnLibStream
     1235               space(2) string( "Группа: " + grp-path ) format "X(80)"
     1236               skip
     1237               v-line format "X(94)"
     1238               skip
     1239           .
     1240           view stream PrnLibStream frame cliListRpt.
     1241           for each buf_clients no-lock
     1242              where buf_clients.grp-code = buf_start_cli-grp.node-code
     1243           on error undo, return error
     1244           :
     1245               display stream PrnLibStream
     1246               sym1 buf_clients.obj-name
     1247               sym2 buf_clients.obj-type
     1248               sym3 buf_clients.obj-code
     1249               sym4
     1250               "--- УДАЛЕН ---" when buf_clients.stts <> 0 @ v-status
     1251               with frame cliListRpt.
     1252               down stream PrnLibStream 1 with frame cliListRpt .
     1253           end.
     1254           put stream PrnLibStream
     1255           v-line format "X(94)"
     1256           skip
     1257           .
     1258       end.
     1259       for each temp_cgrplib_found-grp
     1260          where temp_cgrplib_found-grp.is-terminal = yes
     1261       :
     1262           down stream PrnLibStream 1 with frame cliListRpt .
     1263           put stream PrnLibStream
     1264               space(2) string( "Группа: " + temp_cgrplib_found-grp.full-name ) format "X(80)"
     1265               skip
     1266               v-line format "X(94)"
     1267               skip
     1268           .
     1269           for each buf_clients no-lock
     1270              where buf_clients.grp-code = temp_cgrplib_found-grp.node-code
     1271           on error undo, return error
     1272           :
     1273               display stream PrnLibStream
     1274               sym1 buf_clients.obj-name
     1275               sym2 buf_clients.obj-type
     1276               sym3 buf_clients.obj-code
     1277               sym4
     1278               "--- УДАЛЕН ---" when buf_clients.stts <> 0 @ v-status
     1279               with frame cliListRpt.
     1280               down stream PrnLibStream 1
     1281               with frame cliListRpt .
     1282           end.
     1283           put stream PrnLibStream
     1284           v-line format "X(94)"
     1285           skip
     1286           .
     1287       end.
     1288       hide stream PrnLibStream frame cliBottomframe .
     1289       put stream PrnLibStream
     1290       v-line format "X(94)" skip.
     1291   end.
     1292   else do:
     1293       form with frame frmgrp .
     1294       display stream PrnLibStream
     1295       grp-path @ v-node-name
     1296       with frame frmgrp .
     1297       down stream PrnLibStream 1 with frame frmgrp .
     1298       for each temp_cgrplib_found-grp
     1299       :
     1300           display stream PrnLibStream
     1301           temp_cgrplib_found-grp.full-name     @ v-node-name
     1302           temp_cgrplib_found-grp.d-pcnt        @ v-d-pcnt
     1303           with frame frmgrp .
     1304           down stream PrnLibStream 1 with frame frmgrp .
     1305       end.
     1306       hide stream PrnLibStream frame cliBottomframe .
     1307   end.
     1308   if session :set-wait-state( "" ) then.
     1309   output stream PrnLibStream close.
     1310   run prn-lib-prn-file in this-procedure (
     1311                                             input parParentProc
     1312                                             ,input 0
     1313                                             ).
     1314   end.
