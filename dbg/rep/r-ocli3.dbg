      368   procedure create_obj-list :
      369      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      370      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      371      do
      372      on error undo, return error return-value
      373      :
      374         define buffer cli-obj for ub.clients .
      375         define variable p-var as integer no-undo .
      376         define buffer buf_obj-list for obj-list .
      377         find last buf_obj-list  use-index pi no-error .
      378         if available buf_obj-list
      379         then
      380            p-var = buf_obj-list.obj-id + 1.
      381         else
      382            p-var = 1.
      383         find first cli-obj where
      384                   cli-obj.obj-type = p-obj-type
      385               and cli-obj.obj-code = p-obj-code
      386         no-lock no-error.
      387         if available cli-obj
      388         then do:
      389            create buf_obj-list.
      390            assign
      391               buf_obj-list.obj-id   = p-var
      392               buf_obj-list.obj-code = cli-obj.obj-code
      393               buf_obj-list.obj-type = cli-obj.obj-type
      394               buf_obj-list.obj-name = cli-obj.obj-name
      395               buf_obj-list.db-num   = cli-obj.db-num
      396            .
      397         end.
      398      end.
      399   end.
