     4137   End procedure.
     4138   procedure Print-Header :
     4139   define input parameter N as integer no-undo .
     4140   define input parameter Name as char no-undo .
     4141   PUT stream  OutStream  UNFORMATTED trim(Name) AT ((N - 1) * 10 ) format "x(100)" skip.
     4142   if Make-Excel then  put   stream ForExcel unformatted fill(" " + CHR(9), N - 1) trim(Name) skip.
     4143   END PROCEDURE.
     4144   procedure run1-0 :
     4145          for each obj-list no-lock :
     4146             for each temp-t-post-stk-line : delete temp-t-post-stk-line. end.
     4147             for each post-stk-line  no-lock where
     4148                     post-stk-line.obj-type = obj-list.obj-type and
     4149                     post-stk-line.obj-code = obj-list.obj-code and
