     4156                      temp-t-post-stk-line.cli-type  = post-stk-line.cli-type  and
     4157                      temp-t-post-stk-line.cli-code  = post-stk-line.cli-code   and
     4158                      temp-t-post-stk-line.artic     = post-stk-line.artic     and
     4159                      temp-t-post-stk-line.prod-type = post-stk-line.prod-type and
     4160                      temp-t-post-stk-line.prod-code = post-stk-line.prod-code no-lock no-error .
     4161                      if not available temp-t-post-stk-line then do:
     4162                         find first  ub.goods no-lock where
     4163                                               ub.goods.artic     = post-stk-line.artic     and
     4164                                               ub.goods.prod-type = post-stk-line.prod-type and
     4165                                               ub.goods.prod-code = post-stk-line.prod-code no-error .
     4166                         find first  prod-cli no-lock  where
     4167                                                   prod-cli.obj-type = post-stk-line.prod-type and
     4168                                                   prod-cli.obj-code = post-stk-line.prod-code
     4169                                                   no-error .
     4170                         find first  ub.clients  no-lock  where
     4171                                                   ub.clients.obj-type = post-stk-line.cli-type and
     4172                                                   ub.clients.obj-code = post-stk-line.cli-code no-error .
     4173                           run create-temp-t-post-stk-line .
     4174                    end.
     4175                    else do:
     4176                            assign
     4177                              temp-t-post-stk-line.fact-order = post-stk-line.fact-order  .
     4178                            .
     4179                    end.
     4180             end.
     4181             for each temp-t-post-stk-line no-lock   ,
     4182                    last temp-post-stk-line  where
     4183                                               temp-post-stk-line.fact-order <=  fact-order-2 and
     4184                                               temp-post-stk-line.cat-id     =  t#cat-id                         and
     4185                                               temp-post-stk-line.sum-type   =  t#sum-type                       and
     4186                                               temp-post-stk-line.artic      =  temp-t-post-stk-line.artic       and
     4187                                               temp-post-stk-line.prod-type  =  temp-t-post-stk-line.prod-type   and
     4188                                               temp-post-stk-line.prod-code  =  temp-t-post-stk-line.prod-code   and
     4189                                               temp-post-stk-line.obj-type   =  temp-t-post-stk-line.obj-type    and
     4190                                               temp-post-stk-line.obj-code   =  temp-t-post-stk-line.obj-code    and
     4191                                               temp-post-stk-line.cli-type   =  temp-t-post-stk-line.cli-type    and
     4192                                               temp-post-stk-line.cli-code   =  temp-t-post-stk-line.cli-code
     4193                                               no-lock
     4194                                               break
     4195                                               by ((temp-t-post-stk-line.cli-type + string(temp-t-post-stk-line.cli-code)))
     4196                                               by ((temp-t-post-stk-line.artic + temp-t-post-stk-line.prod-type + string(temp-t-post-stk-line.prod-code)))
     4197                                               by temp-t-post-stk-line.fact-order :
     4198                                       if first-of( (temp-t-post-stk-line.artic + temp-t-post-stk-line.prod-type + string(temp-t-post-stk-line.prod-code)) ) then do : run goods-start. end .
