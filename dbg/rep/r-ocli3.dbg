     4463   procedure Goods-start :
     4464   END PROCEDURE.
     4465   procedure Goods-end :
     4466   END PROCEDURE.
     4467   PROCEDURE display-line :
     4468     i = i + 1.
     4469   If Integer(200) = 0 Then Temp1  = 100  .
     4470                         Else Temp1 = Integer(200) .
     4471        IF ( i modulo Temp1 = 0 ) AND ( i >= Temp1 ) then
     4472            RUN waitfram-show( "Обработано строк : " + string( i )) .
     4473     Run Clear-item.
     4474       assign
     4475             gds-zap-gds-name = if g#gds-engl then Goods.engl-name else Goods.gds-name
     4476             gds-zap-unit-base  = Goods.unit-base
     4477             gds-zap-prt-root   = Goods.prt-root
     4478             gds-zap-prod-type  = Goods.prod-type
     4479             gds-zap-prod-code  = Goods.prod-code
     4480             gds-zap-artic      = Goods.artic
     4481             gds-zap-grp-name   = Goods.grp-name
     4482             gds-zap-b-code     = Goods.gds-code
     4483             gds-zap-type       = Goods.gds-type
     4484             pos-cli-type       = ub.clients.obj-type
     4485             pos-cli-code       = ub.clients.obj-code
     4486             pos-cli-grp-name   = ub.clients.grp-name.
     4487      if Show-Cost Then  RUN ob-line (
     4488                post-stk-line.obj-code    ,
     4489                post-stk-line.obj-type    ,
     4490                post-stk-line.cli-code    ,
     4491                post-stk-line.cli-type    ,
     4492                post-stk-line.artic       ,
     4493                post-stk-line.prod-code   ,
     4494                post-stk-line.prod-type   ,
     4495                Fact-order-1   ,
     4496                Fact-order-2   ,
     4497                'cost':U    ,
     4498                '##,##':U ,
     4499                ""             ,
     4500                yes) .
     4501      if Show-Sale Then  RUN ob-line (
     4502                post-stk-line.obj-code    ,
     4503                post-stk-line.obj-type    ,
     4504                post-stk-line.cli-code    ,
     4505                post-stk-line.cli-type    ,
     4506                post-stk-line.artic       ,
     4507                post-stk-line.prod-code   ,
     4508                post-stk-line.prod-type   ,
     4509                Fact-order-1   ,
     4510                Fact-order-2   ,
     4511                'sale':U    ,
     4512                '##,##':U ,
     4513                ""             ,
     4514                yes) .
     4515            Run Display-str1.
     4516            Run Clear-item.
     4517     END PROCEDURE.
     4518   PROCEDURE display-str1  :
     4519        Run di-qnty ("кол-во", 1, gds-zap-b-code,gds-zap-artic,gds-zap-gds-name,gds-zap-unit-base,"").
     4520            if Show-Cost Then DO : Run di ( "учет." , 2, "","","","","" ).  End.
     4521            if Show-Sale Then DO : Run di ( "док-т.", 8, "","","","","" ).  End.
     4522   END PROCEDURE.
     4523   PROCEDURE Di :
     4524   define input parameter p1 as char no-undo.
     4525   define input parameter p2 as int no-undo.
     4526   define input parameter p3 as char no-undo.
     4527   define input parameter p4 as char no-undo.
     4528   define input parameter p5 as char no-undo.
     4529   define input parameter p6 as char no-undo.
     4530   define input parameter p7 as char no-undo.
     4531    CASE CAPS(p7) :
     4532      End case.
     4533                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     4534    END PROCEDURE.
     4535   PROCEDURE Di-qnty :
     4536   define input parameter p1 as char no-undo.
     4537   define input parameter p2 as int no-undo.
     4538   define input parameter p3 as char no-undo.
     4539   define input parameter p4 as char no-undo.
     4540   define input parameter p5 as char no-undo.
     4541   define input parameter p6 as char no-undo.
     4542   define input parameter p7 as char no-undo.
     4543    CASE CAPS(p7) :
     4544      End case.
     4545                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     4546    END PROCEDURE.
     4547   procedure Print-Footer :
     4548   define input parameter N as integer no-undo .
     4549   define input parameter Name as char no-undo .
     4550       PUT stream  OutStream  UNFORMATTED    "Итого по : " + trim(Name) AT ((N - 1) * 10 ) format "x(100)"  chr(10).
     4551       if Make-Excel then  put   stream ForExcel unformatted  "Итого по : " +  trim(Name) chr(10).
     4552    END PROCEDURE.
     4553   PROCEDURE Clear-item :
     4554    END PROCEDURE.
     4555   PROCEDURE ob-line :
     4556   define input  parameter x-store-code     like ub.clients.obj-code          no-undo.
     4557   define input  parameter x-store-type     like ub.clients.obj-type          no-undo.
     4558   define input  parameter x-cli-code       like ub.clients.obj-code          no-undo.
     4559   define input  parameter x-cli-type       like ub.clients.obj-type          no-undo.
     4560   define INPUT  parameter x-artic          like post-ot-line.artic        no-undo.
     4561   define INPUT  parameter x-prod-code      like post-ot-line.prod-code    no-undo.
     4562   define INPUT  parameter x-prod-type      like post-ot-line.prod-type    no-undo.
     4563   define INPUT  parameter x-Fact-order-1   like post-ot-line.Fact-order   no-undo.
     4564   define INPUT  parameter x-Fact-order-2   like post-ot-line.Fact-order   no-undo.
     4565   define input  parameter x-sum-type       like post-ot-line.sum-type     no-undo.
     4566   define input  parameter x-cat-id         like post-ot-line.cat-id       no-undo.
     4567   define input  parameter x-ext-doc-type   like post-ot-line.ext-doc-type no-undo.
     4568   define input  parameter xTog-obj         as logical no-undo .
     4569   define variable tt# as int no-undo .
     4570    if (x-sum-type = 'cost':U  or x-sum-type = 'cssr':U) then tt# = 0.
     4571    if (x-sum-type = 'crsa':U  or x-sum-type = 'cgsr':U) then tt# = 3.
     4572    if (x-sum-type = 'sale':U  or x-sum-type = 'sasr':U) then tt# = 6.
     4573        FOR each post-ot-line where
     4574                 post-ot-line.artic        = x-artic
     4575           AND   post-ot-line.fact-order  <= x-fact-order-2
     4576           AND   post-ot-line.fact-order  >= x-fact-order-1
     4577           AND   post-ot-line.obj-code     = x-store-code
     4578           AND   post-ot-line.obj-type     = x-store-type
     4579           AND   post-ot-line.prod-code    = x-prod-code
     4580           AND   post-ot-line.prod-type    = x-prod-type
     4581           AND   post-ot-line.cli-code     = x-cli-code
     4582           AND   post-ot-line.cli-type     = x-cli-type
     4583           AND   post-ot-line.sum-type     = x-sum-type   no-lock :
     4584       CASE post-ot-line.ext-doc-type:
     4585                WHEN        'ie':U      THEN     DO:
     4586              ASSIGN prih[1 + tt#]   = prih[1 + tt#]   +  post-ot-line.fact-qnty
     4587                     prih[2 + tt#]   = prih[2 + tt#]   +  if tprintrubl then post-ot-line.sum-rubl else post-ot-line.sum-base
     4588                     prih[3 + tt#]   = prih[3 + tt#]   +  if tprintrubl then post-ot-line.vat-rubl else post-ot-line.vat-base  .
     4589                    End.
     4590                WHEN       'ee':U       THEN     DO:
     4591              ASSIGN rash[1 + tt#]   = rash[1 + tt#]   +  post-ot-line.fact-qnty
     4592                     rash[2 + tt#]   = rash[2 + tt#]   +  if tprintrubl then post-ot-line.sum-rubl else post-ot-line.sum-base
     4593                     rash[3 + tt#]   = rash[3 + tt#]   +  if tprintrubl then post-ot-line.vat-rubl else post-ot-line.vat-base  .
     4594                    End.
     4595                WHEN        're':U  THEN     DO:
     4596              ASSIGN vzvr[1 + tt#]        = vzvr[1 + tt#]   +  post-ot-line.fact-qnty
     4597                     vzvr[2 + tt#]   = vzvr[2 + tt#]   +  if tprintrubl then post-ot-line.sum-rubl else post-ot-line.sum-base
     4598                     vzvr[3 + tt#]   = vzvr[3 + tt#]   +  if tprintrubl then post-ot-line.vat-rubl else post-ot-line.vat-base .
     4599                    End.
     4600                WHEN       'ep':U    THEN     DO:
     4601              ASSIGN vzvr-post[1 + tt#]   = vzvr-post[1 + tt#]   +  post-ot-line.fact-qnty
     4602                     vzvr-post[2 + tt#]   = vzvr-post[2 + tt#]   +  if tprintrubl then post-ot-line.sum-rubl else post-ot-line.sum-base
     4603                     vzvr-post[3 + tt#]   = vzvr-post[3 + tt#]   +  if tprintrubl then post-ot-line.vat-rubl else post-ot-line.vat-base  .
     4604                    End.
     4605                WHEN       'ot':U THEN   DO:
     4606                     End.
     4607             End CASE.
     4608      End.
     4609   END PROCEDURE.
     4610   procedure tmp-assign :
     4611   end procedure.
     4612   procedure tmp-clear :
     4613   end procedure.
     4614   procedure tmp-create :
     4615   define input parameter p-cli-code as integer   no-undo .
     4616   define input parameter p-cli-type as character no-undo .
     4617   define input parameter p-cli-name as character no-undo .
     4618   define input parameter p-obj-code as integer   no-undo .
     4619   define input parameter p-obj-type as character no-undo .
     4620   end procedure.
