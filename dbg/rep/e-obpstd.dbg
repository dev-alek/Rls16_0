      992             SIZE 11.5 BY .75 AT ROW 1.75 COL 53
      993             FGCOLOR 4
      994        "Классификация :" VIEW-AS TEXT
      995             SIZE 15 BY .75 AT ROW 4.83 COL 7.13
      996             FGCOLOR 4
      997        "Выбор поставщика:" VIEW-AS TEXT
      998             SIZE 19.38 BY .67 AT ROW 1.25 COL 7.13
      999             FGCOLOR 4
     1000        RECT-5 AT ROW 4.63 COL 1.75
     1001        RECT-7 AT ROW 1.04 COL 1.75
     1002        RECT-8 AT ROW 11.63 COL 1.75
     1003        RECT-9 AT ROW 1.25 COL 48.13
     1004       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
     1005            SIDE-LABELS NO-UNDERLINE THREE-D
     1006            AT COL 1 ROW 1 SCROLLABLE .
     1007   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     1008   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     1009   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     1010   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     1011   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     1012   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     1013   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     1014   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     1015         adm-object-hdl = FRAME F-Main:HANDLE.
     1016   RUN ensure-broker.
     1017   THIS-PROCEDURE:ADM-DATA =
     1018        'ADM1.1~`':U +
     1019        'SmartObject~`':U +
     1020        '~`':U +
     1021        'NO ~`':U +
     1022        '~`':U +
     1023        '~`':U +
     1024        '~`':U +
     1025        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     1026           + "~`":U +
     1027        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
     1028        'Record-Source,Record-Target,TableIO-Target~`':U +
     1029        '~`':U +
     1030        '~`~`~`~`~`~`~`~`~`~`~`':U +
     1031        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1032            THEN "^^":U
     1033        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1034             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1035   PROCEDURE adm-apply-entry :
     1036     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1037   END PROCEDURE.
     1038   PROCEDURE adm-destroy :
     1039    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1040   END PROCEDURE.
     1041   PROCEDURE adm-disable :
     1042       DISABLE RECT-5 RECT-7 RECT-8 RECT-9 RADPost PostName Showcost Showgoods type-stor Tog-obj Classify ShowZero RADIO-SET-1 t-in Cli-art WITH FRAME F-Main.
     1043       RUN dispatch ('disable-fields':U).
     1044       RUN set-attribute-list ('ENABLED=no':U).
     1045       RETURN.
     1046   END PROCEDURE.
     1047   PROCEDURE adm-edit-attribute-list :
     1048         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
     1049         RETURN.
     1050   END PROCEDURE.
     1051   PROCEDURE adm-enable :
     1052       ENABLE UNLESS-HIDDEN RECT-5 RECT-7 RECT-8 RECT-9 RADPost PostName Showcost Showgoods type-stor Tog-obj Classify ShowZero RADIO-SET-1 t-in Cli-art WITH FRAME F-Main.
     1053       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     1054       RUN set-attribute-list ('ENABLED=yes':U).
     1055       RETURN.
     1056   END PROCEDURE.
     1057   PROCEDURE adm-exit :
     1058        RUN notify ('exit':U).
     1059     RETURN.
     1060   END PROCEDURE.
     1061   PROCEDURE adm-hide :
     1062     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1063   END PROCEDURE.
     1064   PROCEDURE adm-initialize :
     1065     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1066   END PROCEDURE.
     1067   PROCEDURE adm-show-errors :
     1068       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1069       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1070           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1071       END.
     1072       RETURN.
     1073   END PROCEDURE.
     1074   PROCEDURE adm-UIB-mode :
     1075     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1076   END PROCEDURE.
     1077   PROCEDURE adm-view :
     1078     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1079   END PROCEDURE.
     1080   PROCEDURE dispatch :
     1081       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1082       RUN broker-dispatch IN adm-broker-hdl
     1083           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1084       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1085   END PROCEDURE.
     1086   PROCEDURE ensure-broker :
     1087   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1088   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1089   DO:
     1090       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1091       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1092   END.
     1093   END PROCEDURE.
     1094   PROCEDURE get-attribute :
     1095     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1096     RUN broker-get-attribute IN adm-broker-hdl
     1097         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1098     RETURN RETURN-VALUE.
     1099   END PROCEDURE.
     1100   PROCEDURE get-attribute-list :
     1101     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1102     RUN broker-get-attribute-list IN adm-broker-hdl
     1103         (INPUT THIS-PROCEDURE,
     1104          INPUT ?,
     1105          OUTPUT p-attr-list) NO-ERROR.
     1106     RETURN.
     1107   END PROCEDURE.
     1108   PROCEDURE new-state :
     1109     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1110     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1111     RETURN.
     1112   END PROCEDURE.
     1113   PROCEDURE notify :
     1114     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1115     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1116     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1117         RETURN "ADM-ERROR":U.
     1118     RETURN.
     1119   END PROCEDURE.
     1120   PROCEDURE set-attribute-list :
     1121     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1122     RUN ensure-broker.
     1123     RUN broker-set-attribute-list IN adm-broker-hdl
     1124         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1125     RETURN.
     1126   END PROCEDURE.
     1127   PROCEDURE set-position :
     1128       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1129       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1130       IF VALID-HANDLE(adm-object-hdl) THEN
     1131       DO:
     1132         ASSIGN adm-object-hdl:ROW    =   p-row
     1133                adm-object-hdl:COLUMN =   p-col.
     1134       END.
     1135       RETURN.
     1136   END PROCEDURE.
     1137   PROCEDURE adm-display-fields :
     1138       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
     1139       RETURN.
     1140   END PROCEDURE.
     1141   PROCEDURE adm-open-query :
     1142     RETURN.
     1143   END PROCEDURE.
     1144   PROCEDURE adm-row-changed :
     1145         IF VALID-HANDLE(adm-object-hdl) THEN
     1146           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1147         RUN notify ('row-available':U).
     1148         RETURN.
     1149   END PROCEDURE.
     1150   PROCEDURE reposition-query :
     1151       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
     1152       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
     1153       RETURN.
     1154   END PROCEDURE.
     1155     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
     1156     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
     1157     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
     1158     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
     1159     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
     1160     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
     1161     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
     1162     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
     1163     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1164     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
     1165     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1166     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
     1167     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
     1168     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
     1169     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
     1170     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
     1171     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
     1172     IF "":U = "":U THEN
     1173       RUN modify-list-attribute IN adm-broker-hdl
     1174         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
     1175     RUN use-create-on-add(?).
     1176   PROCEDURE adm-add-record :
     1177       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1178          "must have at least one Enabled Table to perform Add.":U
     1179          VIEW-AS ALERT-BOX ERROR.
     1180       RETURN.
     1181   END PROCEDURE.
     1182   PROCEDURE adm-assign-record :
     1183    MESSAGE
     1184          "Object ":U THIS-PROCEDURE:FILE-NAME
     1185            "must have at least one Enabled Table to perform Assign.":U
     1186              VIEW-AS ALERT-BOX ERROR.
     1187      RETURN.
     1188     END PROCEDURE.
     1189   PROCEDURE adm-assign-statement :
     1190     RETURN.
     1191   END PROCEDURE.
     1192   PROCEDURE adm-cancel-record :
     1193      RETURN.
     1194     END PROCEDURE.
     1195   PROCEDURE adm-copy-record :
     1196       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1197        "must have at least one Enabled Table to perform Copy.":U
     1198          VIEW-AS ALERT-BOX ERROR.
     1199       RETURN.
     1200   END PROCEDURE.
     1201   PROCEDURE adm-create-record :
     1202      RETURN.
     1203   END PROCEDURE.
     1204   PROCEDURE adm-current-changed :
     1205     RETURN.
     1206   END PROCEDURE.
     1207   PROCEDURE adm-delete-record :
     1208    MESSAGE
     1209          "Object ":U THIS-PROCEDURE:FILE-NAME
     1210            "must have at least one Enabled Table to perform Delete.":U
     1211              VIEW-AS ALERT-BOX ERROR.
     1212       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
     1213       RETURN.
     1214   END PROCEDURE.
     1215   PROCEDURE adm-disable-fields :
     1216         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
     1217       RETURN.
     1218   END PROCEDURE.
     1219   PROCEDURE adm-enable-fields :
     1220       RETURN.
     1221   END PROCEDURE.
     1222   PROCEDURE adm-end-update :
     1223     RETURN.
     1224   END PROCEDURE.
     1225   PROCEDURE adm-reset-record :
     1226       RETURN.
     1227   END PROCEDURE.
     1228   PROCEDURE adm-update-record :
     1229       MESSAGE
     1230         "Object ":U THIS-PROCEDURE:FILE-NAME
     1231           "must have at least one Enabled Table to perform Update.":U
     1232             VIEW-AS ALERT-BOX ERROR.
     1233      RETURN.
     1234   END PROCEDURE.
     1235   PROCEDURE check-modified :
     1236   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1237   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1238   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1239   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1240     IF check-state = "check":U THEN
     1241     DO:
     1242       RUN get-link-handle IN adm-broker-hdl
     1243         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1244            OUTPUT group-target-list).
     1245       IF group-target-list NE "":U THEN
     1246       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1247         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1248         RUN check-modified IN curr-widget ('group-check':U).
     1249         IF RETURN-VALUE NE "":U THEN
     1250         DO:
     1251           RUN check-modified-message(RETURN-VALUE).
     1252           RETURN "":U.
     1253         END.
     1254       END.
     1255     END.
     1256     RETURN "":U.
     1257   END PROCEDURE.
     1258   PROCEDURE check-modified-message :
     1259     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1260        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1261           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1262        IF RETURN-VALUE = "YES":U THEN
     1263           RUN notify ('view,CONTAINER-SOURCE':U).
     1264        MESSAGE IF p-changed-table NE ? THEN
     1265           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1266           ELSE "Current values have been changed."
     1267           SKIP "  Do you wish to save those changes?"
     1268           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1269        IF ANS THEN
     1270        DO:
     1271           IF group-assign-target THEN
     1272             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1273           ELSE RUN dispatch('update-record':U).
     1274           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1275           DO:
     1276               MESSAGE "Changes to the previous record were not saved."
     1277                 VIEW-AS ALERT-BOX ERROR.
     1278               IF group-assign-target THEN
     1279                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1280               ELSE RUN dispatch ('cancel-record':U).
     1281           END.
     1282        END.
     1283        ELSE DO:
     1284          IF group-assign-target THEN
     1285             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1286          ELSE RUN dispatch('cancel-record':U).
     1287        END.
     1288        RETURN.
     1289   END PROCEDURE.
     1290   PROCEDURE get-rowid :
     1291       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1292       ASSIGN
     1293       p-table   =   adm-first-table.
     1294       RETURN.
     1295   END PROCEDURE.
     1296   PROCEDURE init-group-assign :
     1297       RUN request-attribute IN adm-broker-hdl
     1298         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1299       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1300         group-assign-target = yes.
     1301       ELSE group-assign-target = no.
     1302       RETURN.
     1303   END PROCEDURE.
     1304   PROCEDURE set-editors :
     1305       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1306       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1307       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1308       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1309       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1310       DO WHILE VALID-HANDLE (curr-widget):
     1311           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1312              curr-widget:HIDDEN = no THEN DO:
     1313             CASE p-field-setting:
     1314               WHEN "INITIALIZE":U THEN
     1315               DO:
     1316                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1317                     read-only-list +
     1318                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1319                        STRING(curr-widget).
     1320               END.
     1321               WHEN "DISABLE":U OR
     1322               WHEN "ENABLE":U THEN
     1323               DO:
     1324                   curr-widget:SENSITIVE = yes.
     1325                   RUN get-attribute ('Read-Only-Editors':U).
     1326                   IF RETURN-VALUE = ? OR
     1327                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1328                       curr-widget:READ-ONLY =
     1329                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1330               END.
     1331               WHEN "CLEAR":U THEN
     1332                   curr-widget:SCREEN-VALUE = "":U.
     1333             END CASE.
     1334           END.
     1335           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1336       END.
     1337       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1338         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1339           + '"':U).
     1340       RETURN.
     1341   END PROCEDURE.
     1342   PROCEDURE use-check-modified-all :
     1343    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1344     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1345     RETURN.
     1346   END PROCEDURE.
     1347   PROCEDURE use-create-on-add :
     1348   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1349      RETURN.
     1350   END PROCEDURE.
     1351   PROCEDURE use-initial-lock :
     1352     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1353     ASSIGN adm-initial-lock = p-attr-value.
     1354     RETURN.
     1355   END PROCEDURE.
     1356     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1357   ASSIGN
     1358          FRAME F-Main:SCROLLABLE       = FALSE
     1359          FRAME F-Main:HIDDEN           = TRUE.
     1360   ASSIGN
     1361          FILL-IN-1:HIDDEN IN FRAME F-Main           = TRUE.
     1362   ASSIGN
     1363          PostName:READ-ONLY IN FRAME F-Main        = TRUE.
     1364   ASSIGN
     1365          SortType:HIDDEN IN FRAME F-Main           = TRUE.
     1366   ON VALUE-CHANGED OF Classify IN FRAME F-Main
     1367   DO:
     1368       Assign Classify.
     1369       g#log = RADIO-SET-1:enable (radio-label("2", RADIO-SET-1:radio-buttons)).
     1370       g#log = RADIO-SET-1:enable (radio-label("3", RADIO-SET-1:radio-buttons)).
     1371       TOG-lavel-2 = false .
     1372       TOG-lavel   = false .
     1373      if Classify = "post/grp-goods":U
     1374            Then do:
     1375               display TOG-lavel   with frame F-Main .
     1376               enable  TOG-lavel   with frame F-Main .
     1377           end.
     1378            Else do:
     1379               display  TOG-lavel  var-Lavel with frame F-Main .
     1380               disable  TOG-lavel  var-Lavel with frame F-Main .
     1381           end.
     1382    if Classify = "post":U
     1383            Then do:
     1384               display TOG-lavel-2   with frame F-Main .
     1385               enable  TOG-lavel-2   with frame F-Main .
     1386           end.
     1387            Else do:
     1388               display  TOG-lavel-2  var-Lavel-2 with frame F-Main .
     1389               disable  TOG-lavel-2  var-Lavel-2 with frame F-Main .
     1390           end.
     1391   END.
     1392   ON VALUE-CHANGED OF RADPost IN FRAME F-Main
     1393   DO:
     1394     Assign RadPost.
     1395     for each g#post-f : delete g#post-f. end.
     1396     Case RAdPost :
     1397     when 1 then DO:
     1398             Assign  Postname = 'все':U.
     1399             Display PostName with frame F-Main .
     1400          END.
     1401     when 2 then
     1402           do:
     1403               run ref/cli-all.w
     1404                            ( my-handle
     1405                            , "b-sel,b-mark"
     1406                            , 'все':U
     1407                            , 'все':U
     1408                            , 'текущие':U
     1409                            , ?
     1410                            , ",,,,,,NO,,"
     1411                            ,?
     1412                             , output post-grp_recids ) .
     1413               if post-grp_recids = "" then do:
     1414                    Assign  Postname = 'все':U radpost = 1.
     1415                    Display PostName radpost with frame F-Main .
     1416               end.
     1417               else do:
     1418                   Assign  Postname = ''.
     1419                   v-nn  = num-entries( post-grp_recids ) .
     1420                   DO ii = 1 TO v-nn :
     1421                       find cli-post where recid( cli-post ) = int(entry( ii, post-grp_recids )) no-lock no-error .
     1422                       find first cli-grp where cli-grp.node-code = cli-post.grp-code no-lock no-error .
     1423                       if available cli-post and available cli-grp then do:
     1424                           create g#post-f.
     1425                           assign
     1426                             g#post-f.obj-type = cli-post.obj-type
     1427                             g#post-f.obj-code = cli-post.obj-code
     1428                             g#post-f.obj-name = cli-post.obj-name
     1429                             g#post-f.grp-code = cli-post.grp-code
     1430                             g#post-f.grp-name = cli-post.grp-name
     1431                             g#post-f.lvl-num  = cli-grp.lvl-num
     1432                             Postname = PostName + cli-post.obj-name + chr(10)
     1433                           .
     1434                       end.
     1435                   END.
     1436                    Display PostName with frame F-Main .
     1437               end.
     1438           end.
     1439     End case.
     1440     END.
     1441   ON VALUE-CHANGED OF Tog-lavel IN FRAME F-Main
     1442   DO:
     1443      Assign tog-lavel.
     1444     if tog-lavel =TRUE
     1445           Then do:
     1446               display  var-Lavel  with frame F-Main .
     1447               enable   var-Lavel  with frame F-Main .
     1448               g#log = RADIO-SET-1:disable (radio-label("2", RADIO-SET-1:radio-buttons)).
     1449               g#log = RADIO-SET-1:disable (radio-label("3", RADIO-SET-1:radio-buttons)).
     1450           end.
     1451            Else do:
     1452               display    var-Lavel with frame F-Main .
     1453               disable    var-Lavel with frame F-Main .
     1454               g#log = RADIO-SET-1:enable (radio-label("2", RADIO-SET-1:radio-buttons)).
     1455               g#log = RADIO-SET-1:enable (radio-label("3", RADIO-SET-1:radio-buttons)).
     1456           end.
     1457   END.
     1458   ON VALUE-CHANGED OF Tog-lavel-2 IN FRAME F-Main
     1459   DO:
     1460   define variable g#log as log no-undo.
     1461      Assign tog-lavel-2.
     1462     if tog-lavel-2 = TRUE
     1463           Then do:
     1464               display  var-Lavel-2  with frame F-Main .
     1465               enable   var-Lavel-2  with frame F-Main .
     1466               g#log = RADIO-SET-1:disable (radio-label("2", RADIO-SET-1:radio-buttons)).
     1467               g#log = RADIO-SET-1:disable (radio-label("3", RADIO-SET-1:radio-buttons)).
     1468           end.
     1469            Else do:
     1470               display    var-Lavel-2 with frame F-Main .
     1471               disable    var-Lavel-2 with frame F-Main .
     1472               g#log = RADIO-SET-1:enable (radio-label("2", RADIO-SET-1:radio-buttons)).
     1473               g#log = RADIO-SET-1:enable (radio-label("3", RADIO-SET-1:radio-buttons)).
     1474           end.
     1475   END.
     1476   ON VALUE-CHANGED OF Tog-obj IN FRAME F-Main
     1477   DO:
     1478     assign Tog-obj.
     1479   END.
     1480   if not this-procedure :persistent
     1481   then do:
     1482     message
     1483       vss-workfile vss-revision vss-description skip
     1484       "Ошибка при запуске процедуры" skip
     1485       "Данную процедуру следует запускать только с параметром persistent" skip
     1486       view-as alert-box error .
     1487     undo, return error .
     1488   end.
     1489   PROCEDURE disable_UI :
     1490     HIDE FRAME F-Main.
     1491     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1492   END PROCEDURE.
     1493   PROCEDURE local-apply-layout :
     1494     RUN dispatch IN THIS-PROCEDURE ( INPUT 'apply-layout':U ) .
     1495       Tog-obj:screen-value in frame F-Main = 'yes':U.
     1496       var-lavel:screen-value in frame F-Main = '1'.
     1497       var-lavel-2:screen-value in frame F-Main = '1'.
     1498       g#log = Classify:disable (radio-label("post/grp-goods", Classify:radio-buttons)) .
     1499   define variable v-par-type as character no-undo .
     1500    g#log = type-stor:ADD-LAST("старая конс.", 5) .
     1501   END PROCEDURE.
     1502   PROCEDURE my-report :
     1503    run rep/r-obpstd.p
     1504       ( input v-cntxt-obj-code ,
     1505         input v-cntxt-obj-type ,
     1506         input base-type  ,
     1507         input base-code  ,
     1508         input cli-art    ,
     1509         input postname   ,
     1510         input radpost    ,
     1511         input radio-set-1,
     1512         input classify   ,
     1513         input sorttype   ,
     1514         input showzero   ,
     1515         input tog-obj    ,
     1516         input type-stor  ,
     1517         input tog-lavel  ,
     1518         input var-lavel  ,
     1519         input tog-lavel-2,
     1520         input var-lavel-2,
     1521         input t-in       ,
     1522         input showgoods
     1523         ) .
     1524   END PROCEDURE.
     1525   PROCEDURE my-var :
     1526   assign frame F-Main type-stor Cli-art.
     1527   assign frame F-Main PostName  RADPost   showcost showgoods .
     1528   assign frame F-Main ShowZero  Classify  Tog-obj  .
     1529   assign frame F-Main RADIO-SET-1 t-in.
     1530   assign frame F-Main Tog-lavel  var-lavel Tog-lavel-2  Var-lavel-2    .
     1531   Show-cost = showcost.
     1532   ReportNAme = "Оборотная ведомость по поставщикам (по док.) " .
     1533   def var t-class as char no-undo.
     1534   def var t-sort as char no-undo.
     1535     case classify:
     1536       when "no-classify":u    then t-class =   "Без классификации" .
     1537       when "prod":u           then t-class =   "Производители"   .
     1538       when "post":u           then t-class =   "Поставщики"   .
     1539       when "grp-goods":u      then t-class =   "Группы товаров"  .
     1540       when "post/grp-goods":u then t-class =   "Поставщики/Группы товаров" .
     1541       when "prod/grp-goods":u then t-class =   "Производители/Группы товаров" .
     1542       when "grp-goods/prod":u then t-class =   "Группы товаров/Производители" .
     1543       when "grp-goods/post":u then t-class =   "Группы товаров/Поставщики" .
     1544       when  "vat-ps":u        then t-class =   "Ставка НДС" .
     1545       when  "sort":u          then t-class =   "Проба(Сорт)" .
     1546       when  "n-level":u       then t-class =   "Группы с уровнем вложенности " .
     1547       when  "t-level":u       then t-class =   "Терминальные группы" .
     1548    end case.
     1549     case sorttype:
     1550       when "sort-pp":u               then t-sort =   "по порядку" .
     1551       when "sort-code":u             then t-sort =   "по коду" .
     1552       when "sort-artic":u            then t-sort =   "по артикулу"  .
     1553       when "sort-qunty":u            then t-sort =   "по реализации".
     1554       when "sort-name":u             then t-sort =   "по наименованию".
     1555       when "sort-type":u             then t-sort =   "по типу ткани".
     1556       when "sort-doc-code":u         then t-sort =   "по номеру документа".
     1557       when "sort-recipe-code":u      then t-sort =   "по номеру рецепта".
     1558    end case.
     1559   ReportHeader = "Поставщики : " + PostName + chr(10).
     1560   ReportHeader = ReportHeader + "Классификация : " + t-Class.
     1561   case RADIO-SET-1:
     1562       when 1 then do:
     1563         ReportHeader = ReportHeader + " Только итоги по поставщикам" .
     1564       end.
     1565       when 2 then do:
     1566         ReportHeader = ReportHeader + " Расшифровка по товарам" .
     1567       end.
     1568       when 3 then do:
     1569         ReportHeader = ReportHeader + " Расшифровка по партиям" .
     1570       end.
     1571   end case.
     1572   ReportHeader = ReportHeader +
     1573                  (if tog-lavel  then "    Итоги с уровня товаров "  + String(var-lavel)  else " "    ).
     1574   ReportHeader = ReportHeader +
     1575                  (if tog-lavel-2  then "    Итоги с уровня поставщика "  + String(var-lavel-2)  else " "    ).
     1576   ReportHeader = ReportHeader  + chr(10).
     1577   ReportHeader = ReportHeader +
     1578                  "Сортировка " + t-Sort + chr(10) +
     1579                  "Показать : " +
     1580                  (if Show-Cost     then "Суммы в учетных ценах, "    else " "  ) +
     1581                  (if Show-Crsa     then "Суммы в продажных ценах, "  else " "  ) +
     1582                  (if Show-Sale     then "Суммы в ценах документа, "  else " "  ) +
     1583                  (if Showgoods       then "Товары 'в пути', "  else " "  ) +
     1584                  (if t-in          then "Приход и Расход с внутренним перемещением, "  else " Приход и Расход внешние, "  ) +
     1585                  (if cli-art       then "Артикулы поставщика, "  else " "      ) +
     1586                  (if ShowZero      then "Показывать нулевые обороты "  else "Не показывать нулевые обороты" ) .
     1587   ReportHeader =  ReportHeader  + chr(10) + Caps(Entry(((type-stor * 2) - 1), type-stor:RADIO-BUTTONS)) .
     1588    sheetf.Excel-Column-Lable = "Код," +
     1589    ( if cli-art       then "Артикулы поставщика" else  "Артикул" )
     1590    + ",Название товара ,Ед.изм" +
     1591          ",Остаток на  начало" +  (if Show-Cost then "," else "" )  + (if  Showgoods then "," else "" )  +
     1592          ",Приход" +             (if Show-Cost then "," else "" )  + (if  Show-Sale then "," else "" )  +
     1593          ",Расход" +             (if Show-Cost then "," else "" )  + (if  Show-Sale then "," else "" )  +
     1594          ",Касса" +              (if Show-Cost then "," else "" )  + (if  Show-Sale then "," else "" )  +
     1595          ",Инвентаризация" +     (if Show-Cost then "," else "" )  + (if  Show-Sale then "," else "" )  +
     1596          ",Списание" +           (if Show-Cost then "," else "" )  + (if  Show-Sale then "," else "" )  +
     1597          ",Возврат внешний" +    (if Show-Cost then "," else "" )  + (if  Show-Sale then "," else "" )  +
     1598          ",Возврат поставщика" + (if Show-Cost then "," else "" )  + (if  Show-Sale then "," else "" )  +
     1599          ",Остаток на конец" +  (if Show-Cost then "," else "" )  + (if  Showgoods then "," else "" )  +
     1600           chr(10) .
     1601    sheetf.Excel-Column-Lable = sheetf.Excel-Column-Lable + ",,," +
     1602    ",кол-во" + (if Show-Cost then ",учет.сумма" else "" )  + ( if Showgoods then ",товары в пути" else "" )  +
     1603    ",кол-во" + (if Show-Cost then ",учет.сумма" else "" )  + ( if Show-Sale then ",сумма док." else "" )  +
     1604    ",кол-во" + (if Show-Cost then ",учет.сумма" else "" )  + ( if Show-Sale then ",сумма док." else "" )  +
     1605    ",кол-во" + (if Show-Cost then ",учет.сумма" else "" )  + ( if Show-Sale then ",сумма док." else "" )  +
     1606    ",кол-во" + (if Show-Cost then ",учет.сумма" else "" )  + ( if Show-Sale then ",сумма док." else "" )  +
     1607    ",кол-во" + (if Show-Cost then ",учет.сумма" else "" )  + ( if Show-Sale then ",сумма док." else "" )  +
     1608    ",кол-во" + (if Show-Cost then ",учет.сумма" else "" )  + ( if Show-Sale then ",сумма док." else "" )  +
     1609    ",кол-во" + (if Show-Cost then ",учет.сумма" else "" )  + ( if Show-Sale then ",сумма док." else "" )  +
     1610    ",кол-во" + (if Show-Cost then ",учет.сумма" else "" )  + ( if Showgoods then ",товары в пути" else "" )  .
     1611    sheetf.Sizes  = "10,16,60,7,13,13,13,13,13,13,13,13,13," +
     1612                              (if Show-Cost then "13,13,13,13,13,13,13,13,13," else "") +
     1613                              (if Showgoods then "13,13," else "") .
     1614    Sheetf.ColFOrmat = "2=@;3=@"  .
     1615   END PROCEDURE.
     1616   PROCEDURE state-changed :
     1617     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     1618     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     1619     CASE p-state:
     1620     END CASE.
     1621     END PROCEDURE.
