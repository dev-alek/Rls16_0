     6270     on error undo, return error return-value
     6271     :
     6272       find first buf_temp-param
     6273         where buf_temp-param.param-code     = p-code
     6274           and buf_temp-param.param-sub-code = p-sub-code
     6275         no-error .
     6276       if not available buf_temp-param then do:
     6277         create buf_temp-param .
     6278         assign
     6279           buf_temp-param.param-code     = p-code
     6280           buf_temp-param.param-sub-code = p-sub-code
     6281         .
     6282       end.
     6283       assign
     6284         buf_temp-param.param-value = p-value
     6285       .
     6286     end.
     6287   end procedure.
     6288   procedure paramls-read :
     6289     define input  parameter p-code          as character no-undo .
     6290     define input  parameter p-sub-code      as character no-undo .
     6291     define input  parameter p-default-value as character no-undo .
     6292     define output parameter p-value         as character no-undo .
     6293     define buffer buf_temp-param for temp-param .
     6294     do
     6295     on error undo, return error return-value
     6296     :
     6297       find first buf_temp-param
     6298         where buf_temp-param.param-code     = p-code
     6299           and buf_temp-param.param-sub-code = p-sub-code
     6300         no-error .
     6301       if available buf_temp-param then do:
     6302         assign
     6303           p-value = buf_temp-param.param-value
     6304         .
     6305       end.
     6306       else do:
     6307         assign
     6308           p-value = p-default-value
     6309         .
     6310       end.
     6311     end.
     6312   end procedure.
     6313   procedure paramls-append :
     6314     define input  parameter p-code     as character no-undo .
     6315     define input  parameter p-sub-code as character no-undo .
     6316     define input  parameter p-value    as character no-undo .
     6317     define buffer buf_temp-param for temp-param .
     6318     do
     6319     on error undo, return error return-value
     6320     :
     6321       find first buf_temp-param
     6322            where buf_temp-param.param-code     = p-code
     6323              and buf_temp-param.param-sub-code = p-sub-code
     6324         no-error .
