        1   block-level on error undo, throw.
        2   define input parameter parParentProc AS WIDGET-HANDLE NO-UNDO.
        3   define input parameter rec_id        as recid        no-undo.
        4   define input parameter is-chek       as logical   no-undo .
        5   define variable vss-revision    as character no-undo initial "$Revision: aea5316774be, 0, rls $":U .
        6   define variable vss-author      as character no-undo initial "$Author: expertek $":U .
        7   define variable vss-date        as character no-undo initial "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        8   define variable vss-workfile    as character no-undo initial "$Workfile: r-outrta.p $":U .
        9   define variable vss-archive     as character no-undo initial "$Archive: rep/r-outrta.p $":U .
       10   define variable vss-description as character no-undo initial "Документ расхода, возврата и списания  Для Аптеки":U .
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define new global shared variable g#library  as handle no-undo .
       70   define new global shared variable g#library2 as handle no-undo .
       71   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       72   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
       73   define  shared variable RepPathName        as character no-undo .
       74   define  shared variable PrintRubl          as logical   no-undo .
       75   define variable vss-include-info1 as character format "X(65)" no-undo
       76   initial "@(#)$Workfile$ $Revision$".
       77   define variable v-fmtcli-name          as character    no-undo.
       78   define variable v-fmtcli-engl-name     as character    no-undo.
       79   define variable v-fmtcli-addres        as character    no-undo.
       80   define variable v-fmtcli-post-addres   as character    no-undo.
       81   define variable v-fmtcli-full-addres   as character    no-undo.
       82   define variable v-fmtcli-phone         as character    no-undo.
       83   define variable v-fmtcli-inn           as character    no-undo.
       84   define variable v-fmtcli-kpp           as character    no-undo.
       85   define variable v-fmtcli-okpo          as character    no-undo.
       86   define variable v-fmtcli-country       as character    no-undo.
       87   define variable v-fmtcli-city          as character    no-undo.
       88   define variable v-fmtcli-index         as character    no-undo.
       89   define variable v-fmtcli-schet-exists  as logical      no-undo.
       90   define variable v-fmtcli-bank-exists   as logical      no-undo.
       91   define variable v-fmtcli-bank-r-schet  as character    no-undo.
       92   define variable v-fmtcli-bank-c-schet  as character    no-undo.
       93   define variable v-fmtcli-bank-bik      as character    no-undo.
       94   define variable v-fmtcli-bank-name     as character    no-undo.
       95   define variable v-fmtcli-bank-addres   as character    no-undo.
       96   define variable v-fmtcli-bank-city     as character    no-undo.
       97   procedure fmtcli-get-bank :
       98   define input parameter p-host-code      as integer          no-undo.
       99   define input parameter p-obj-type       as character        no-undo.
      100   define input parameter p-obj-code       as integer          no-undo.
      101   define input parameter p-curr-code      as integer          no-undo.
      102       define buffer buf_fin-schet     for ub.fin-schet.
      103       define buffer buf_fin-bank      for ub.fin-bank.
      104   do
      105   for buf_fin-schet
      106     , buf_fin-bank
      107   on error undo, return error
      108   :
      109       assign
      110           v-fmtcli-schet-exists       = no
      111           v-fmtcli-bank-exists        = no
      112           v-fmtcli-bank-r-schet       = "":U
      113           v-fmtcli-bank-c-schet       = "":U
      114           v-fmtcli-bank-bik           = "":U
      115           v-fmtcli-bank-name          = "":U
      116           v-fmtcli-bank-addres        = "":U
      117           v-fmtcli-bank-city          = "":U
      118       .
      119       search-for-schet:
      120       for each buf_fin-schet no-lock
      121          where buf_fin-schet.host-code = p-host-code
      122            and buf_fin-schet.cli-type  = p-obj-type
      123            and buf_fin-schet.cli-code  = p-obj-code
      124            and buf_fin-schet.curr-code = p-curr-code
      125       on error undo, return error
      126       :
      127           if buf_fin-schet.status_   = 'удал':U
      128           then do:
      129           end.
      130           else do:
      131               assign
      132                   v-fmtcli-schet-exists   = yes
      133                   v-fmtcli-bank-r-schet   = trim( buf_fin-schet.r-schet )
      134                   v-fmtcli-bank-c-schet   = trim( buf_fin-schet.c-schet )
      135               .
      136               find first buf_fin-bank no-lock
      137                    where buf_fin-bank.host-code = p-host-code
      138                      and buf_fin-bank.code-bank = buf_fin-schet.code-bank
      139               no-error.
      140               if available buf_fin-bank
      141               then do:
      142                   assign
      143                       v-fmtcli-bank-exists      = yes
      144                       v-fmtcli-bank-bik         = trim( buf_fin-bank.bik )
      145                       v-fmtcli-bank-name        = trim( buf_fin-bank.bank-name )
      146                       v-fmtcli-bank-addres      = trim(buf_fin-bank.addres)
      147                       v-fmtcli-bank-city      = trim(buf_fin-bank.bank-city)
      148                   .
      149               end.
      150               else do:
      151                   assign
      152                       v-fmtcli-bank-exists    = no
      153                       v-fmtcli-bank-bik       = "":U
      154                       v-fmtcli-bank-name      = "":U
      155                       v-fmtcli-bank-addres    = "":U
      156                       v-fmtcli-bank-city      = "":U
      157                   .
      158               end.
      159               leave search-for-schet.
      160           end.
      161       end.
      162   end.
      163   end procedure.
      164   procedure fmtcli-get-client :
      165   define input parameter p-obj-type       as character    no-undo.
      166   define input parameter p-obj-code       as integer      no-undo.
      167       define variable v-temp-fmtcli-address      as character     no-undo.
      168       define variable v-num-country-city    as integer      no-undo.
      169       define buffer buf_clients   for ub.clients.
      170       define buffer buf_firm      for ub.firm.
      171       define buffer buf_store     for ub.store.
      172       define buffer buf_shop      for ub.shop.
      173       define buffer buf_person    for ub.person.
      174   do
      175   for buf_clients
      176     , buf_firm
      177     , buf_store
      178     , buf_shop
      179     , buf_person
      180   on error undo, return error
      181   :
      182       assign
      183           v-fmtcli-name           = "":U
      184           v-fmtcli-addres         = "":U
      185           v-fmtcli-post-addres    = "":U
      186           v-fmtcli-full-addres    = "":U
      187           v-fmtcli-phone          = "":U
      188           v-fmtcli-inn            = "":U
      189           v-fmtcli-kpp            = "":U
      190           v-fmtcli-okpo           = "":U
      191           v-fmtcli-city           = "":U
      192           v-fmtcli-index          = "":U
      193           v-fmtcli-country        = "":U
      194       .
      195       find first buf_clients no-lock
      196            where buf_clients.obj-type = p-obj-type
      197              and buf_clients.obj-code = p-obj-code
      198       .
      199       assign
      200           v-fmtcli-name = buf_clients.obj-name
      201       .
      202       case buf_clients.obj-type:
      203          when 'орг':U
      204          then do:
      205               find first buf_firm no-lock
      206                    where buf_firm.firm-code = buf_clients.obj-code
      207                    no-error
      208               .
      209               if available buf_firm
      210               then do:
      211                   assign
      212                       v-num-country-city = num-entries( buf_firm.city )
      213                       v-fmtcli-engl-name = buf_firm.engl-name
      214                   .
      215                   if v-num-country-city > 0
      216                   then do:
      217                       assign
      218                           v-fmtcli-country    = trim( entry( 1, buf_firm.city ) )
      219                       .
      220                   end.
      221                   if v-num-country-city > 1
      222                   then do:
      223                       assign
      224                           v-fmtcli-city       = trim( entry( 2, buf_firm.city ) )
      225                       .
      226                   end.
      227                   run fmtcli-concatenate-strings in this-procedure (
      228                         input v-fmtcli-full-addres
      229                       , input v-fmtcli-country
      230                       , input ", ":U
      231                       , input 50
      232                       , output v-fmtcli-full-addres
      233                   ).
      234                   run fmtcli-concatenate-strings in this-procedure (
      235                         input v-fmtcli-full-addres
      236                       , input v-fmtcli-city
      237                       , input ", ":U
      238                       , input 50
      239                       , output v-fmtcli-full-addres
      240                   ).
      241                   run fmtcli-concatenate-strings in this-procedure (
      242                         input v-fmtcli-full-addres
      243                       , input IF buf_firm.ind = 0 THEN "" ELSE string( buf_firm.ind )
      244                       , input ", ":U
      245                       , input 50
      246                       , output v-fmtcli-full-addres
      247                   ).
      248                   run fmtcli-concatenate-strings in this-procedure (
      249                         input v-fmtcli-post-addres
      250                       , input v-fmtcli-country
      251                       , input ", ":U
      252                       , input 50
      253                       , output v-fmtcli-post-addres
      254                   ).
      255                   run fmtcli-concatenate-strings in this-procedure (
      256                         input v-fmtcli-post-addres
      257                       , input v-fmtcli-city
      258                       , input ", ":U
      259                       , input 50
      260                       , output v-fmtcli-post-addres
      261                   ).
      262                   run fmtcli-concatenate-strings in this-procedure (
      263                         input v-fmtcli-post-addres
      264                       , input string( buf_firm.ind )
      265                       , input ", ":U
      266                       , input 50
      267                       , output v-fmtcli-post-addres
      268                   ).
      269                   run fmtcli-concatenate-strings in this-procedure (
      270                         input substring( buf_firm.addres1, 1, 50 )
      271                       , input buf_firm.addres2
      272                       , input " ":U
      273                       , input 50
      274                       , output v-temp-fmtcli-address
      275                   ).
      276                   run fmtcli-concatenate-strings in this-procedure (
      277                         input v-temp-fmtcli-address
      278                       , input substring( buf_firm.addres1, 51, 50 )
      279                       , input " ":U
      280                       , input 50
      281                       , output v-temp-fmtcli-address
      282                   ).
      283                   run fmtcli-concatenate-strings in this-procedure (
      284                         input v-temp-fmtcli-address
      285                       , input substring( buf_firm.addres1, 101, 50 )
      286                       , input " ":U
      287                       , input 50
      288                       , output v-temp-fmtcli-address
      289                   ).
      290                   assign
      291                       v-fmtcli-addres = v-temp-fmtcli-address
      292                   .
      293                   if buf_firm.addres1 <> ?
      294                   then do:
      295                       run fmtcli-concatenate-strings in this-procedure (
      296                             input v-fmtcli-full-addres
      297                           , input v-fmtcli-addres
      298                           , input ", ":U
      299                           , input 0
      300                           , output v-fmtcli-full-addres
      301                       ).
      302                   end.
      303                   run fmtcli-concatenate-strings in this-procedure (
      304                         input substring( buf_firm.post-addr1, 1, 50 )
      305                       , input buf_firm.post-addr2
      306                       , input " ":U
      307                       , input 50
      308                       , output v-fmtcli-post-addres
      309                   ).
      310                   run fmtcli-concatenate-strings in this-procedure (
      311                         input v-fmtcli-post-addres
      312                       , input substring( buf_firm.post-addr1, 51, 50 )
      313                       , input " ":U
      314                       , input 50
      315                       , output v-fmtcli-post-addres
      316                   ).
      317                   run fmtcli-concatenate-strings in this-procedure (
      318                         input v-fmtcli-post-addres
      319                       , input substring( buf_firm.post-addr1, 101, 50 )
      320                       , input " ":U
      321                       , input 50
      322                       , output v-fmtcli-post-addres
      323                   ).
      324                   assign
      325                       v-fmtcli-phone         = buf_firm.phone
      326                       v-fmtcli-inn           = buf_firm.inn
      327                       v-fmtcli-kpp           = buf_firm.kpp
      328                       v-fmtcli-okpo          = buf_firm.okpo
      329                       v-fmtcli-index         = string( buf_firm.ind )
      330                   .
      331               end.
      332          end.
      333          when 'маг':U
      334          then do:
      335               find first buf_shop no-lock
      336                    where buf_shop.obj-code = buf_clients.obj-code
      337               .
      338               if available buf_shop
      339               then do:
      340                   run fmtcli-concatenate-strings in this-procedure (
      341                         input buf_shop.addres1
      342                       , input buf_shop.addres2
      343                       , input " ":U
      344                       , input 50
      345                       , output v-fmtcli-addres
      346                   ).
      347                   assign
      348                       v-fmtcli-full-addres = v-fmtcli-addres
      349                       v-fmtcli-post-addres = v-fmtcli-addres
      350                       v-fmtcli-phone       = buf_shop.phone
      351                       v-fmtcli-inn         = "":U
      352                       v-fmtcli-kpp         = "":U
      353                       v-fmtcli-okpo        = "":U
      354                       v-fmtcli-city        = "":U
      355                       v-fmtcli-index       = "":U
      356                   .
      357               end.
      358          end.
      359          when 'скл':U
      360          then do:
      361               find first buf_store no-lock
      362                    where buf_store.obj-code = buf_clients.obj-code
      363               .
      364               if available buf_store
      365               then do:
      366                   run fmtcli-concatenate-strings in this-procedure (
      367                         input buf_store.addres1
      368                       , input buf_store.addres2
      369                       , input " ":U
      370                       , input 50
      371                       , output v-fmtcli-addres
      372                   ).
      373                   assign
      374                       v-fmtcli-full-addres = v-fmtcli-addres
      375                       v-fmtcli-phone       = buf_store.phone
      376                       v-fmtcli-inn         = "":U
      377                       v-fmtcli-kpp         = "":U
      378                       v-fmtcli-okpo        = "":U
      379                       v-fmtcli-city        = "":U
      380                       v-fmtcli-index       = "":U
      381                   .
      382               end.
      383          end.
      384          when 'чел':U
      385          then do:
      386               find first buf_person no-lock
      387                    where buf_person.psn-code = buf_clients.obj-code
      388               .
      389               if available buf_person
      390               then do:
      391                   run fmtcli-concatenate-strings in this-procedure (
      392                         input ( if buf_person.ind = 0 or buf_person.ind = ?
      393                                 then "":U
      394                                 else string( buf_person.ind, "999999")
      395                                 )
      396                       , input buf_person.city
      397                       , input ", ":U
      398                       , input 0
      399                       , output v-fmtcli-full-addres
      400                   ).
      401                   assign
      402                       v-fmtcli-addres = buf_person.address
      403                   .
      404                   run fmtcli-concatenate-strings in this-procedure (
      405                         input v-fmtcli-full-addres
      406                       , input v-fmtcli-addres
      407                       , input ", ":U
      408                       , input 0
      409                       , output v-fmtcli-full-addres
      410                   ).
      411                   assign
      412                       v-fmtcli-phone     = buf_person.phone1
      413                       v-fmtcli-inn       = buf_person.inn
      414                       v-fmtcli-kpp       = buf_person.kpp
      415                       v-fmtcli-okpo      = buf_person.okpo
      416                       v-fmtcli-city      = buf_person.city
      417                       v-fmtcli-index     = string( buf_person.ind )
      418                   .
      419               end.
      420          end.
      421       end case.
      422   end.
      423   end procedure.
      424   procedure fmtcli-concatenate-strings :
      425   define input parameter p-string-1       as character        no-undo.
      426   define input parameter p-string-2       as character        no-undo.
      427   define input parameter p-delimiter      as character        no-undo.
      428   define input parameter p-length         as integer          no-undo.
      429   define output parameter p-out-string    as character        no-undo.
      430   do
      431   on error undo, return error
      432   :
      433       assign
      434           p-out-string = ( if p-string-1 = ?
      435                            then "":U
      436                            else trim( p-string-1 ) )
      437       .
      438       assign
      439           p-out-string = p-out-string
      440                        + ( if p-out-string = "":U
      441                            or length( p-out-string ) = p-length
      442                            or p-string-2 = ?
      443                            or trim( p-string-2 ) = "":U
      444                            then "":U
      445                            else p-delimiter )
      446                        + ( if p-string-2 = ?
      447                            or trim( p-string-2 ) = "":U
      448                            then "":U
      449                            else trim( p-string-2 ) )
      450       .
      451   end.
      452   end procedure.
      453   def var vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      454   define new global shared variable g#attr-lib  as handle no-undo .
      455   define variable v-attr-lib-variable as handle no-undo .
      456   procedure clntattr-code :
      457     define input  parameter p-code           as character no-undo .
      458     define output parameter p-type           as character no-undo .
      459     define output parameter p-format         as character no-undo .
      460     define output parameter p-label          as character no-undo .
      461     define output parameter p-user-can-edit  as logical   no-undo .
      462     define output parameter p-output-display as logical   no-undo .
      463     define output parameter p-other          as character no-undo .
      464     do
      465     on error undo, return error return-value
      466     :
      467           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clntattr-code in g#attr-lib
      468         (input  p-code
      469         ,output p-type
      470         ,output p-format
      471         ,output p-label
      472         ,output p-user-can-edit
      473         ,output p-output-display
      474         ,output p-other
      475         ) no-error .
      476       if error-status :error
      477       then do:
      478         undo, return error return-value .
      479       end.
      480     end.
      481   end procedure.
      482   procedure clntattr-tooltip :
      483     define input  parameter p-code    as character no-undo .
      484     define output parameter p-tooltip as character no-undo .
      485     define output parameter p-label   as character no-undo .
      486     do
      487     on error undo, return error return-value
      488     :
      489           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clntattr-tooltip in g#attr-lib
      490         (input  p-code
      491         ,output p-tooltip
      492         ,output p-label
      493         ) no-error .
      494       if error-status :error
      495       then do:
      496         undo, return error return-value .
      497       end.
      498     end.
      499   end procedure.
      500   procedure clntattr-value :
      501     define input  parameter p-obj-type like ub.clients-attr.obj-type   no-undo .
      502     define input  parameter p-obj-code like ub.clients-attr.obj-code   no-undo .
      503     define input  parameter p-code     like ub.clients-attr.attr-code  no-undo .
      504     define output parameter p-value    like ub.clients-attr.attr-value no-undo .
      505     define output parameter p-type     as character no-undo .
      506     do
      507     on error undo, return error return-value
      508     :
      509           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clntattr-value in g#attr-lib
      510         (input  p-obj-type
      511         ,input  p-obj-code
      512         ,input  p-code
      513         ,output p-value
      514         ,output p-type
      515         ) no-error .
      516       if error-status :error
      517       then do:
      518         undo, return error return-value .
      519       end.
      520     end.
      521   end procedure.
      522   procedure clntattr-write :
      523     define input  parameter p-obj-type like ub.clients-attr.obj-type   no-undo .
      524     define input  parameter p-obj-code like ub.clients-attr.obj-code   no-undo .
      525     define input  parameter p-code     like ub.clients-attr.attr-code  no-undo .
      526     define input  parameter p-value    like ub.clients-attr.attr-value no-undo .
      527     do
