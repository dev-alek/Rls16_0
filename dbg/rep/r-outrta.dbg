     5414     (input  bf_goods.gds-code
     5415     ,input  '1':U
     5416     ,input  bf_trn-doc.fact-date
     5417     ,input  bf_trn-doc.host-code
     5418     ,input  bf_trn-doc.obj-type
     5419     ,input  bf_trn-doc.obj-code
     5420     ,output varcur-vat-pc
     5421     ) no-error .
     5422       if varcur-vat-pc = ?
     5423       then do:
     5424         return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3 документ &4", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code, bf_trn-doc.doc-code).
     5425       end.
     5426       if varcur-slt-pc = ?
     5427       then do:
     5428         return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3 документ &4", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code, bf_trn-doc.doc-code).
     5429       end.
     5430       v-calcbypart = no.
