     1077       .
     1078   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1079   empty temp-table thbjattr_thbj-attr.
     1080   run adm/shattri.p (
     1081      input "get":U
     1082     ,input ''
     1083     ,input 0
     1084     ,input 'prt-glob':U
     1085     ,input  ""
     1086     ,output v-value-character
     1087     ,output v-value-date
