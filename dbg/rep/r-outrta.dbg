     1109     ,output v-value-decimal
     1110     ,output v-value-integer
     1111     ,output v-value-logical
     1112     ,output par-type
     1113     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1114     ) no-error .
     1115   for each thbjattr_thbj-attr :
     1116       if thbjattr_thbj-attr.prop-code = 'outdate':U  then v-outdate  =  thbjattr_thbj-attr.property-value-character .
     1117       if thbjattr_thbj-attr.prop-code = 'outares':U  then v-outares  =  thbjattr_thbj-attr.property-value-character .
     1118       if thbjattr_thbj-attr.prop-code = 'outnum':U   then v-outnum   =  thbjattr_thbj-attr.property-value-character .
     1119       if thbjattr_thbj-attr.prop-code = 'outprim':U  then v-outprim  =  thbjattr_thbj-attr.property-value-character .
     1120       if thbjattr_thbj-attr.prop-code = 'outdisc':U  then v-outdisc  =  thbjattr_thbj-attr.property-value-character .
     1121       if thbjattr_thbj-attr.prop-code = 'outsubs':U  then v-outsubs  =  thbjattr_thbj-attr.property-value-character .
     1122       if thbjattr_thbj-attr.prop-code = 'outegrp':U  then v-outegrp  =  thbjattr_thbj-attr.property-value-character .
     1123       if thbjattr_thbj-attr.prop-code = 'outt12':U   then v-outt12   =  thbjattr_thbj-attr.property-value-character .
     1124       if thbjattr_thbj-attr.prop-code = 'outappr':U  then v-outappr  =  thbjattr_thbj-attr.property-value-character .
     1125       if thbjattr_thbj-attr.prop-code = 'outrubl':U  then v-outrubl  =  thbjattr_thbj-attr.property-value-character .
     1126       if thbjattr_thbj-attr.prop-code = 'outhold':U  then v-outhold  =  thbjattr_thbj-attr.property-value-character .
     1127       if thbjattr_thbj-attr.prop-code = 'outobj':U   then v-outobj   =  thbjattr_thbj-attr.property-value-character .
     1128       if thbjattr_thbj-attr.prop-code = 'outsend':U  then v-outsend  =  thbjattr_thbj-attr.property-value-character .
     1129       if thbjattr_thbj-attr.prop-code = 'outasend':U then v-outasend =  thbjattr_thbj-attr.property-value-character .
     1130       if thbjattr_thbj-attr.prop-code = 'outogr':U   then v-torgconf-outogr   =  thbjattr_thbj-attr.property-value-character .
     1131       if thbjattr_thbj-attr.prop-code = 'outR':U     then v-torgconf-outR     =  thbjattr_thbj-attr.property-value-character .
     1132       if thbjattr_thbj-attr.prop-code = 'outB':U     then v-torgconf-outB     =  thbjattr_thbj-attr.property-value-character .
     1133       if thbjattr_thbj-attr.prop-code = 'outssdoc':U then v-torgconf-outssdoc =  thbjattr_thbj-attr.property-value-character .
     1134       if thbjattr_thbj-attr.prop-code = 'outC':U     then v-torgconf-outC     =  thbjattr_thbj-attr.property-value-character .
     1135   end.
     1136       run gbl/conf-rd.p ("outexpas", "":U, "":U, 0, "":U, "":U, "":U, no, output v-torgconf-outexpas, output v-par-type) no-error.
     1137       if error-status :error
     1138       then do:
     1139           assign
     1140               v-torgconf-outexpas = "":U
     1141           .
     1142       end.
     1143       assign
     1144           v-torgconf-outprncd = ( v-outprncd = "yes":U )
     1145       .
     1146       if p-form-name <> ""
     1147       and p-form-name <> ?
     1148       then do:
     1149           run gbl/conf-rd.p ("outexlst" , p-host-code, p-obj-type, p-obj-code, "", "", "", no, output v-outexlst , output v-par-type) no-error.
     1150           if error-status :error
     1151           then do:
     1152               assign
     1153                   v-outexlst           = ""
     1154               .
     1155           end.
     1156           if lookup( p-form-name, v-outdate ) <> 0
     1157           then do:
     1158               assign
     1159                   v-torgconf-outdate  = yes
     1160               .
     1161           end.
     1162           if lookup( p-form-name, v-outares ) <> 0
     1163           then do:
     1164               assign
     1165                   v-torgconf-outares  = yes
     1166               .
     1167           end.
     1168           if lookup( p-form-name, v-outnum  ) <> 0
     1169           then do:
     1170               assign
     1171                   v-torgconf-outnum   = yes
     1172               .
     1173           end.
     1174           if lookup( p-form-name, v-outprim ) <> 0
     1175           then do:
     1176               assign
     1177                   v-torgconf-outprim  = yes
     1178               .
     1179           end.
     1180           if lookup( p-form-name, v-outdisc ) <> 0
     1181           then do:
     1182               assign
     1183                   v-torgconf-outdisc  = yes
     1184               .
     1185           end.
     1186           if lookup( p-form-name, v-outsubs ) <> 0
     1187           then do:
     1188               assign
     1189                   v-torgconf-outsubs  = yes
     1190               .
     1191           end.
     1192           if lookup( p-form-name, v-outrecv ) <> 0
     1193           then do:
     1194               assign
     1195                   v-torgconf-outrecv  = yes
     1196               .
     1197           end.
     1198           if lookup( p-form-name, v-outegrp ) <> 0
     1199           then do:
     1200               assign
