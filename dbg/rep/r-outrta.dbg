     6673             v-cntxp-out-line-discnt = bf-cntxp_shop.out-line-discnt
     6674             v-cntxp-in-ov           = bf-cntxp_shop.in-ov
     6675             v-cntxp-in-perm         = bf-cntxp_shop.in-perm
