     6328           buf_temp-param.param-code     = p-code
     6329           buf_temp-param.param-sub-code = p-sub-code
     6330           buf_temp-param.param-value    = p-value
     6331         .
     6332       end.
     6333       else do:
     6334           assign
     6335               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     6336           .
     6337       end.
     6338     end.
     6339   end procedure.
     6340   define variable vss-include-info32 as character format "X(65)" no-undo
     6341   initial "@(#)$Workfile$ $Revision$".
     6342   define stream excel-line.
     6343   define stream excel-cell.
     6344   define temp-table temp_cell-data no-undo
     6345       field data-key as character
     6346       field data-value as character
     6347       index pi is primary unique data-key
     6348   .
     6349   define temp-table temp_line-data no-undo
     6350       field data-key     as character
     6351       field xl-line-id   as integer
     6352       field ID           as integer
     6353       field gdscode      as character
     6354       field artic        as character
     6355       field Name         as character
     6356       field part-code    as character
     6357       field price        as character
     6358       field qnty         as character
     6359       field sum          as character
     6360       index pi is primary unique xl-line-id
     6361   .
     6362   define variable v-outretxl-current-data-row     as integer      no-undo.
     6363   define variable v-outretxl-cell-file-name       as character    no-undo.
     6364   define variable v-outretxl-data-file-name       as character    no-undo.
     6365   procedure outretxl-init :
     6366       define buffer buf_temp_cell-data        for temp_cell-data.
     6367   do
     6368   for buf_temp_cell-data on error undo, return error :
     6369       assign
     6370           v-outretxl-current-data-row = 0
     6371       .
     6372       run gbl/_tmpfile.p
     6373         (input  "xd"
     6374         ,input  ".txt"
     6375         ,output v-outretxl-data-file-name
     6376         ).
     6377       output stream excel-line to value( v-outretxl-data-file-name ).
     6378       run gbl/_tmpfile.p
     6379         (input "xc"
     6380         ,input ".txt"
     6381         ,output v-outretxl-cell-file-name
     6382         ).
     6383       output stream excel-cell to value( v-outretxl-cell-file-name ).
     6384       if printrubl
     6385       then do:
     6386           run outretxl-write-cell-data in this-procedure
     6387             (input "valutCode":U
     6388             ,input "0":U
     6389             ).
     6390       end.
     6391       else do:
     6392           run outretxl-write-cell-data in this-procedure (
     6393                 input "valutCode":U
     6394               , input "1":U
     6395           ).
     6396       end.
     6397       run outretxl-write-cell-data in this-procedure (
     6398             input "regularExpressions":U
     6399           , input "1":U
     6400       ).
     6401       run outretxl-write-cell-data in this-procedure (
     6402             input "columnList":U
     6403           , input "ID,artic,gdscode,EI,Name,price,qnty,sum":U
     6404       ).
     6405       run outretxl-write-cell-data in this-procedure (
     6406             input "columnType":U
     6407           , input "I,I,S,S,S,D,D,D":U
     6408       ).
     6409       run outretxl-write-cell-data in this-procedure (
     6410             input "columnAmount":U
     6411           , input "8":U
     6412       ).
     6413       run outretxl-write-cell-data in this-procedure (
     6414             input "subtotalList":U
     6415           , input "qnty,sum":U
     6416       ).
     6417       run outretxl-write-cell-data in this-procedure (
     6418             input "subtotalType":U
     6419           , input "D,D":U
     6420       ).
     6421       run outretxl-write-cell-data in this-procedure (
     6422             input "subtotalAmount":U
     6423           , input "2":U
     6424       ).
     6425   end.
     6426   end procedure.
     6427   procedure outretxl-close :
     6428   do
     6429   on error undo, return error
     6430   :
     6431       output stream excel-line close.
     6432       output stream excel-cell close.
     6433       output to value( string( session:temp-directory + "$" + string( g#report-num ) ) + ".txl" ) append.
     6434           export "exe/ap_97.xlt":U.
     6435           export "exe/t_97.bas":U.
     6436           export v-outretxl-cell-file-name.
     6437           export v-outretxl-data-file-name.
     6438       output close.
     6439   end.
     6440   end procedure.
     6441   procedure outretxl-write-cell-data :
     6442   define input parameter p-data-key   as character        no-undo.
     6443   define input parameter p-data-value as character        no-undo.
     6444       define buffer buf_temp_cell-data     for temp_cell-data.
     6445   do
     6446   for buf_temp_cell-data
     6447   on error undo, return error
     6448   :
     6449       find first buf_temp_cell-data
     6450            where buf_temp_cell-data.data-key = p-data-key
     6451       no-error.
     6452       if not available buf_temp_cell-data
     6453       then do:
     6454           create buf_temp_cell-data.
     6455           assign
     6456               buf_temp_cell-data.data-key = p-data-key
     6457           .
     6458       end.
     6459       assign
     6460           buf_temp_cell-data.data-value = p-data-value
     6461       .
     6462       put stream excel-cell unformatted
     6463                           buf_temp_cell-data.data-key
     6464           chr(9)   buf_temp_cell-data.data-value
     6465           chr(10)
     6466       .
     6467   end.
     6468   end procedure.
     6469   procedure outretxl-write-line-data :
     6470   define input parameter p-ID             as integer          no-undo.
     6471   define input parameter p-gdscode        as character        no-undo.
     6472   define input parameter p-artic          as character        no-undo.
     6473   define input parameter p-Name           as character        no-undo.
     6474   define input parameter p-part-code      as character        no-undo.
     6475   define input parameter p-price          as character        no-undo.
     6476   define input parameter p-qnty           as character        no-undo.
     6477   define input parameter p-sum            as character        no-undo.
     6478       define buffer buf_temp_line-data        for temp_line-data.
     6479   do
     6480   for buf_temp_line-data
     6481   on error undo, return error
     6482   :
     6483       for each buf_temp_line-data
     6484       :
     6485           delete buf_temp_line-data.
     6486       end.
     6487       create buf_temp_line-data.
     6488       assign
     6489           v-outretxl-current-data-row = v-outretxl-current-data-row + 1
     6490       .
     6491       assign
     6492           buf_temp_line-data.data-key     = "LD":U
     6493           buf_temp_line-data.xl-line-id   = v-outretxl-current-data-row
     6494           buf_temp_line-data.id           = p-id
     6495           buf_temp_line-data.gdscode      = p-gdscode
     6496           buf_temp_line-data.artic        = p-artic
     6497           buf_temp_line-data.Name         = p-Name
     6498           buf_temp_line-data.part-code           = p-part-code
     6499           buf_temp_line-data.price        = p-price
     6500           buf_temp_line-data.qnty         = p-qnty
     6501           buf_temp_line-data.sum          = p-sum
     6502       .
     6503       put stream excel-line unformatted
     6504                           buf_temp_line-data.data-key
     6505           chr(9)   ( if buf_temp_line-data.id = 0 then "":U else string( buf_temp_line-data.id ) )
     6506           chr(9)   buf_temp_line-data.artic
     6507           chr(9)   buf_temp_line-data.gdscode
     6508           chr(9)   buf_temp_line-data.part-code
     6509           chr(9)   buf_temp_line-data.Name
     6510           chr(9)   buf_temp_line-data.price
     6511           chr(9)   buf_temp_line-data.qnty
     6512           chr(9)   buf_temp_line-data.sum
     6513           chr(10)
     6514       .
     6515   end.
     6516   end procedure.
     6517   procedure outretxl-run-excel :
     6518     define input parameter p-header-filename    as character        no-undo.
     6519     define input parameter p-data-filename      as character        no-undo.
     6520     define variable v-template-file-name    as character    no-undo.
     6521     define variable v-vb-file-name          as character    no-undo.
     6522     define buffer buf_temp-param for temp-param .
     6523     do for buf_temp-param on error undo, return error :
     6524       create buf_temp-param.
     6525       assign
     6526           v-template-file-name    = search( "exe/no_97.xlt" )
     6527           v-vb-file-name          = search( "exe/t_97.bas")
     6528       .
     6529       if v-template-file-name = ?  or v-template-file-name = "":U  then do:
     6530           message  "Ошибка имени файла шаблона." view-as alert-box error.
     6531       end.
     6532       if v-vb-file-name = ?  or v-vb-file-name = "":U then do:
     6533           message  "Ошибка имени файла кода обработки."   view-as alert-box error.
     6534       end.
     6535       run paramls-write in this-procedure (
     6536             input "template":U
     6537           , input "template-file-name":U
     6538           , input v-template-file-name
     6539       ).
     6540       run paramls-write in this-procedure (
     6541             input "template":U
     6542           , input "vb-file-name":U
     6543           , input v-vb-file-name
     6544       ).
     6545       run paramls-write in this-procedure (
     6546             input "data":U
     6547           , input "data-header-filename":U
     6548           , input p-header-filename
     6549       ).
     6550       run paramls-write in this-procedure (
     6551             input "data":U
     6552           , input "data-filename":U
     6553           , input p-data-filename
     6554       ).
     6555       run gbl/macroxlt.p (
     6556           input-output table buf_temp-param
     6557       ) no-error.
     6558       if error-status :error
     6559       then do:
     6560           message vss-workfile vss-revision vss-description skip(1)
     6561               skip "Ошибка создания файла Excel."
     6562               skip return-value
     6563               skip trim(error-status :get-message(1))
     6564                    trim(error-status :get-message(2))
     6565                    trim(error-status :get-message(3))
     6566           view-as alert-box error.
     6567           undo, return error .
     6568       end.
     6569     end.
     6570   end procedure.
