     7070             where buf_goods.artic      = buf_doc-line.artic
     7071               and buf_goods.prod-type  = buf_doc-line.prod-type
     7072               and buf_goods.prod-code  = buf_doc-line.prod-code
     7073             break by buf_goods.gds-name
     7074           :
     7075             run print-line in this-procedure .
     7076           end.
     7077         end.
     7078         else do:
     7079           if print-graft = yes then do:
     7080             for each buf_doc-line
     7081               where buf_doc-line.doc-code = t-doc.doc-code
     7082               , first buf_goods no-lock
     7083                 where buf_goods.artic      = buf_doc-line.artic
     7084                   and buf_goods.prod-type  = buf_doc-line.prod-type
     7085                   and buf_goods.prod-code  = buf_doc-line.prod-code
     7086               break by buf_doc-line.artic
     7087             :
     7088               run print-line in this-procedure .
     7089             end.
     7090           end.
     7091           else do:
     7092             for each buf_doc-line
     7093               where buf_doc-line.doc-code = t-doc.doc-code
     7094               , first buf_goods no-lock
     7095               where buf_goods.artic      = buf_doc-line.artic
     7096                   and buf_goods.prod-type  = buf_doc-line.prod-type
     7097                   and buf_goods.prod-code  = buf_doc-line.prod-code
     7098               break by buf_doc-line.line-num
     7099             :
     7100               run print-line in this-procedure .
     7101             end.
     7102           end.
     7103         end.
     7104       end.
     7105     end.
     7106     run print-itog in this-procedure .
     7107     output stream Out_stream close.
     7108     run outretxl-close in this-procedure .
     7109   if g#quest-print = false
     7110   then do:
     7111     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
     7112                                         7, (if 4 >= 8 then 2 else 0), 0, 0,
     7113                                         OUTPUT g#log ).
     7114   end.
     7115   else do:
     7116     os-command silent
     7117       value( "COPY /b " +
     7118         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
     7119         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
     7120         string( session:temp-directory) +  "$" + string( g#report-num )
     7121                 ) .
     7122     os-command silent
     7123       value( "COPY /b " +
     7124         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
     7125         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
     7126         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
     7127                 ) .
     7128   end.
     7129   end.
     7130   procedure Print-prod :
     7131     do on error undo, return error return-value :
     7132       find first buf_clients where buf_clients.obj-type = buf_goods.prod-type and buf_clients.obj-code = buf_goods.prod-code no-lock .
     7133       if not printrubl then do:
     7134         display stream out_stream sym1 "Производитель -" @ buf_goods.artic buf_clients.obj-name @ gds_name sym10 with frame val .
     7135         down stream out_stream 1 with frame val .
     7136         underline stream out_stream buf_goods.artic gds_name with frame val .
     7137       end.
     7138       else do:
     7139         display stream out_stream sym1 "Производитель -" @ buf_goods.artic buf_clients.obj-name @ gds_name sym10 with frame rubl .
     7140         down stream out_stream 1 with frame rubl .
     7141         underline stream out_stream buf_goods.artic gds_name with frame rubl .
     7142       end.
     7143     end.
     7144   end procedure.
     7145   procedure print-grp :
     7146     do on error undo, return error return-value :
     7147       if not printrubl then do:
     7148         display stream out_stream sym1 "Группа -" @ buf_goods.artic buf_goods.grp-name @ gds_name sym10 with frame val .
     7149         down stream out_stream 1 with frame val .
     7150         underline stream out_stream buf_goods.artic gds_name with frame val .
     7151       end.
     7152       else do:
     7153         display stream out_stream sym1 "Группа -" @ buf_goods.artic buf_goods.grp-name @ gds_name sym10 with frame rubl .
     7154         down stream out_stream 1 with frame rubl .
     7155         underline stream out_stream buf_goods.artic gds_name with frame rubl .
     7156       end.
     7157     end.
     7158   end procedure.
