     1059           v-torgconf-outprim  = no
     1060           v-torgconf-outdisc  = no
     1061           v-torgconf-outsubs  = no
     1062           v-torgconf-outrecv  = no
     1063           v-torgconf-outegrp  = no
     1064           v-torgconf-outt12   = no
     1065           v-torgconf-outappr  = no
     1066           v-torgconf-outrubl  = no
     1067           v-torgconf-outhold  = no
     1068           v-torgconf-outobj   = no
     1069           v-torgconf-outexlst = no
     1070           v-torgconf-outexpas = "":U
     1071           v-torgconf-outprncd = yes
     1072           v-torgconf-outares  = no
     1073           v-torgconf-outsend  = no
