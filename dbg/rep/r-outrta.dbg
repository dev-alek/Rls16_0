     7487         then do:
     7488         display stream out_stream
     7489           sym1  Lines_Counter sym2 tb-code sym3 buf_goods.artic sym4 gds_name sym5  sym6 sym7 sym8 sym10
     7490         with frame val.
     7491         display stream out_stream   with frame val.
     7492         down stream out_stream with frame val .
     7493           run outretxl-write-line-data in this-procedure (
     7494                     input Lines_Counter
     7495                   , input tb-code
     7496                   , input buf_goods.artic
     7497                   , input gds_name
     7498                   , input ""
     7499                   , input ""
     7500                   , input ""
     7501                   , input ""
     7502           ).
     7503         stoim = 0.
     7504           for each ub.parts no-lock
     7505             where ub.parts.out-code  = buf_doc-line.doc-code
     7506               and ub.parts.artic     = buf_doc-line.artic
     7507               and ub.parts.prod-type = buf_doc-line.prod-type
     7508               and ub.parts.prod-code = buf_doc-line.prod-code
     7509             :
     7510             find first ub.bar-code no-lock where
     7511                       ub.bar-code.gds-code  = buf_goods.gds-code and
     7512                       ub.bar-code.in-code   = ub.parts.in-code and
     7513                       ub.bar-code.part-code = ub.parts.part-code
     7514                       no-error .
     7515              find first buf1_clients no-lock  where
     7516                         buf1_clients.obj-code = ub.parts.supp-code and
     7517                         buf1_clients.obj-type = ub.parts.supp-type no-error .
     7518             if not CostPrice then do:
     7519               run lineattr-value-parts
     7520                 (  input t-doc.doc-code
     7521                  , input buf_goods.gds-code
     7522                  , input ub.parts.part-code
     7523                  , input ub.parts.in-code
     7524                  , input 'parts_price-sale':U
     7525                  , output Price
     7526                 ) no-error .
     7527             end.
     7528             else do:
     7529                 if PrintRubl then do:
     7530                   Price =  ub.parts.price-rubl.
     7531                 end.
     7532                 else do:
     7533                   Price =  ub.parts.price-base.
     7534                 end.
     7535             end.
     7536             stoim = stoim + ub.parts.fact-qnty * Price .
     7537             display stream out_stream
     7538               sym1
     7539               sym2 string(ub.bar-code.b-code) @ tb-code
     7540               sym3
     7541               sym4  ub.parts.part-code  @  buf_goods.unit-base
     7542               sym5  " " + buf1_clients.obj-name @ gds_name
     7543               sym6  Price
     7544               sym7  ub.parts.fact-qnty @ qnty
     7545               sym8 (ub.parts.fact-qnty * Price ) @ stoim
     7546               sym10
     7547             with frame val.
     7548             display stream out_stream    with frame val.
     7549             down stream out_stream with frame val .
     7550               run outretxl-write-line-data in this-procedure (
     7551                       input ""
     7552                     , input string(ub.bar-code.b-code)
     7553                     , input ""
     7554                     , input "__" + buf1_clients.obj-name
     7555                     , input ub.parts.part-code
     7556                     , input string( Price )
     7557                     , input string( ub.parts.fact-qnty )
     7558                     , input string( (ub.parts.fact-qnty * Price ) )
     7559               ).
     7560           end.
     7561         end.
     7562         else do:
     7563               display stream out_stream
     7564                 sym1 Lines_Counter
     7565                 sym2 tb-code
     7566                 sym3 buf_goods.artic
     7567                 sym4 gds_name
     7568                 sym5
     7569                 sym6 Price
     7570                 sym7 qnty
     7571                 sym8 stoim
     7572                 sym10
     7573               with frame val.
     7574               display stream out_stream  with frame val.
     7575               down stream out_stream with frame val .
     7576               display stream out_stream  with frame val.
     7577                 run outretxl-write-line-data in this-procedure (
     7578                           input Lines_Counter
     7579                         , input tb-code
     7580                         , input buf_goods.artic
     7581                         , input gds_name
     7582                         , input ""
     7583                         , input string( Price )
     7584                         , input string( qnty )
     7585                         , input string( stoim )
     7586                 ).
     7587         end.
     7588       end.
     7589       all-stoim   = all-stoim   + stoim.
     7590       end.
     7591     end.
     7592   end procedure.
     7593   procedure print-titul :
     7594         define variable v-firm-string    as character    no-undo.
     7595     do on error undo, return error return-value :
     7596     if is-chek then do:
     7597       put stream Out_stream  "Т О В А Р Н Ы Й  Ч Е К  N " at 32 format "X(30)" .
     7598       put stream Out_stream
     7599                     v-doc-code                                                                      format "X(14)"
     7600                     "  от  "
     7601                     v-doc-date-string                                                               format "X(28)"
     7602                     skip "Продавец : " at 10 format "X(20)"
     7603                     skip v-torgconf-self-host-inn + " " + Our_Host.obj-name + ", " + Our_Object.obj-name + "(" + string(Our_Object.obj-code) + ")"                     at 12   format "X(108)"
     7604                     skip "Адрес : " at 10 format "X(20)"
     7605                     skip v-torgconf-self-host-addres          at 12   format "X(108)"
     7606                     skip "Покупатель : " at 10 format "X(20)"
     7607                     skip clients.obj-name at 12 format "X(40)"
     7608                     skip(1)
     7609                 .
     7610       run outretxl-write-cell-data in this-procedure (
     7611             input "h_docName":U
     7612           , input string("Т О В А Р Н Ы Й  Ч Е К  N ")
     7613       ).
     7614       run outretxl-write-cell-data in this-procedure (
     7615             input "h_docCode":U
     7616           , input v-doc-code
     7617       ).
     7618       run outretxl-write-cell-data in this-procedure (
     7619             input "h_docDate":U
     7620           , input v-doc-date-string
     7621       ).
     7622       run outretxl-write-cell-data in this-procedure (
     7623             input "h_cliFrom":U
     7624           , input "Продавец : " + v-torgconf-self-host-inn + " " + Our_Host.obj-name + ", " + Our_Object.obj-name + "(" + string(Our_Object.obj-code) + ")"
     7625       ).
     7626       run outretxl-write-cell-data in this-procedure (
     7627             input "h_cliTo":U
     7628           , input "Покупатель : " + clients.obj-name
     7629       ).
     7630     end.
     7631     else do:
     7632       case t-doc.doc-type :
     7633         when 'возврат':U then do:
     7634           if t-doc.internal then put stream Out_stream  "В Н У Т Р Е Н Н Е Е  ПЕРЕМЕЩЕНИЕ - В О З В Р А Т  N " at 22 format "X(60)" .
     7635           else                   put stream Out_stream  "В О З В Р А Т Н А Я   Н А К Л А Д Н А Я   N " at 32 format "X(50)" .
     7636           put stream Out_stream
     7637                     v-doc-code                                                                      format "X(14)"
     7638                     "  от  "
     7639                     v-doc-date-string                                                               format "X(28)"
     7640                     skip(2) "Отправитель :"                                                 at 10   format "X(20)"
     7641                     skip string( clients.obj-name + "(" + string(clients.obj-code) + ")" )  at 12   format "X(108)"
     7642                     skip "Получатель  : " at 10 format "X(20)"
     7643                     skip Our_Host.obj-name + ", " + Our_Object.obj-name                     at 12   format "X(108)"
     7644                     skip(1)
     7645                 .
     7646           if t-doc.internal then
     7647             run outretxl-write-cell-data in this-procedure (
     7648                 input "h_docName":U
     7649               , input "В Н У Т Р Е Н Н Е Е  ПЕРЕМЕЩЕНИЕ - В О З В Р А Т  N "
     7650             ).
     7651           else
     7652             run outretxl-write-cell-data in this-procedure (
     7653                 input "h_docName":U
     7654               , input "В О З В Р А Т Н А Я   Н А К Л А Д Н А Я  N "
     7655             ).
     7656           run outretxl-write-cell-data in this-procedure (
     7657                 input "h_docCode":U
     7658               , input v-doc-code
     7659           ).
     7660           run outretxl-write-cell-data in this-procedure (
     7661                 input "h_docDate":U
     7662               , input v-doc-date-string
     7663           ).
     7664           run outretxl-write-cell-data in this-procedure (
     7665                 input "h_cliFrom":U
     7666               , input string( "Отправитель : " + clients.obj-name + "(" + string(clients.obj-code) + ")" )
     7667           ).
     7668           run outretxl-write-cell-data in this-procedure (
     7669                 input "h_cliTo":U
     7670               , input "Получатель  :" + Our_Host.obj-name + ", " + Our_Object.obj-name
     7671           ).
     7672           if CostPrice then do:
     7673             put stream Out_stream space(10) "Указаны УЧЕТНЫЕ цены"      format "X(50)"  skip(2) .
     7674             run outretxl-write-cell-data in this-procedure (
     7675                 input "h_CostPrice":U
     7676               , input "Указаны УЧЕТНЫЕ цены"
     7677             ).
     7678           end.
     7679         end.
     7680         when 'спи':U then do:
     7681           put stream Out_stream
     7682                     skip(1) "С П И С А Н И Е   N "                                          at 32   format "X(22)"
     7683                     v-doc-code                                                                      format "X(14)"
     7684                     "  от  "
     7685                     v-doc-date-string                                                               format "X(28)"
     7686                     skip(2) "Отправитель  :"                                                at 10   format "X(20)"
     7687                     skip Our_Host.obj-name + ", " + Our_Object.obj-name                     at 12   format "X(108)"
     7688                     skip "Получатель   :"                                                   at 10   format "X(20)"
     7689                     skip clients.obj-name                                                   at 12   format "X(108)"
     7690                 .
     7691           run outretxl-write-cell-data in this-procedure (
     7692                 input "h_docName":U
     7693               , input "С П И С А Н И Е  N "
     7694           ).
     7695           run outretxl-write-cell-data in this-procedure (
     7696                 input "h_docCode":U
     7697               , input v-doc-code
     7698           ).
     7699           run outretxl-write-cell-data in this-procedure (
     7700                 input "h_docDate":U
     7701               , input v-doc-date-string
     7702           ).
     7703           run outretxl-write-cell-data in this-procedure (
     7704                 input "h_cliFrom":U
     7705               , input string( "Отправитель : " + Our_Host.obj-name + ", " + Our_Object.obj-name )
     7706           ).
     7707           run outretxl-write-cell-data in this-procedure (
     7708                 input "h_cliTo":U
     7709               , input "Получатель  :" + clients.obj-name
     7710           ).
     7711         end.
     7712         when 'рас':U then do:
     7713           if  t-doc.internal then do:
     7714             assign
     7715               v-firm-string = substitute( "&1, ", Our_Host.obj-name )
     7716             .
     7717             put stream Out_stream "НАКЛАДНАЯ N " at 22 format "X(55)"  v-doc-code format "X(14)" .
     7718             run outretxl-write-cell-data in this-procedure (
     7719                 input "h_docName":U
     7720               , input "НАКЛАДНАЯ N "
     7721             ).
     7722           end.
     7723           else do:
     7724             assign
     7725               v-firm-string = "":U
     7726             .
     7727             if t-doc.office then do:
     7728               put stream Out_stream "А К Т  П Р И Е М К И - П Е Р Е Д А Ч И  Р А Б О Т / У С Л У Г   N " at 22 format "X(70)"  v-doc-code format "X(14)" .
     7729               run outretxl-write-cell-data in this-procedure (
     7730                   input "h_docName":U
     7731                 , input "А К Т  П Р И Е М К И - П Е Р Е Д А Ч И  Р А Б О Т / У С Л У Г  N "
     7732               ).
     7733             end.
     7734             else do:
     7735               put stream Out_stream "Н А К Л А Д Н А Я   N " at 32 format "X(45)" v-doc-code format "X(14)" .
     7736               run outretxl-write-cell-data in this-procedure (
     7737                   input "h_docName":U
     7738                 , input "Н А К Л А Д Н А Я  N "
     7739               ).
     7740             end.
     7741           end.
     7742           put stream Out_stream
     7743                     "  от  "  v-doc-date-string                                                     format "X(28)"
     7744                     skip "Получатель   :"                                                   at 10   format "X(20)"
     7745                     skip string( v-firm-string + clients.obj-name + "(" + string(clients.obj-code) + ")" )  at 12   format "X(108)"
     7746                     skip(1)
     7747                 .
     7748           run outretxl-write-cell-data in this-procedure (
     7749                 input "h_docCode":U
     7750               , input v-doc-code
     7751           ).
     7752           run outretxl-write-cell-data in this-procedure (
     7753                 input "h_docDate":U
     7754               , input v-doc-date-string
     7755           ).
     7756           run outretxl-write-cell-data in this-procedure (
     7757                 input "h_cliFrom":U
     7758               , input string( "Получатель : " + clients.obj-name + "(" + string(clients.obj-code) + ")" )
     7759           ).
     7760           if CostPrice then do:
     7761             put stream Out_stream space(10) "Указаны УЧЕТНЫЕ цены"      format "X(50)"  skip(2) .
     7762             run outretxl-write-cell-data in this-procedure (
     7763                 input "h_CostPrice":U
     7764               , input "Указаны УЧЕТНЫЕ цены"
     7765             ).
     7766           end.
     7767         end.
     7768         when 'при':U then do:
     7769           if  t-doc.internal then do:
     7770             assign
     7771               v-firm-string = substitute( "&1, ", Our_Host.obj-name )
     7772             .
     7773             put stream Out_stream "НАКЛАДНАЯ N " at 22 format "X(55)"  v-doc-code format "X(14)" .
     7774             run outretxl-write-cell-data in this-procedure (
     7775                 input "h_docName":U
     7776               , input "НАКЛАДНАЯ N "
     7777             ).
     7778           end.
     7779           else do:
     7780             assign
     7781               v-firm-string = "":U
     7782             .
     7783             if t-doc.office then do:
     7784               put stream Out_stream "А К Т  П Р И Е М К И - П Е Р Е Д А Ч И  Р А Б О Т / У С Л У Г   N " at 22 format "X(70)"  v-doc-code format "X(14)" .
     7785               run outretxl-write-cell-data in this-procedure (
     7786                   input "h_docName":U
     7787                 , input "А К Т  П Р И Е М К И - П Е Р Е Д А Ч И  Р А Б О Т / У С Л У Г  N "
     7788               ).
     7789             end.
     7790             else do:
     7791               put stream Out_stream "Н А К Л А Д Н А Я   N " at 32 format "X(45)" v-doc-code format "X(14)" .
     7792               run outretxl-write-cell-data in this-procedure (
     7793                   input "h_docName":U
     7794                 , input "Н А К Л А Д Н А Я  N "
     7795               ).
     7796             end.
     7797           end.
     7798           put stream Out_stream
     7799                     "  от  "  v-doc-date-string                                                     format "X(28)"
     7800                     skip "Получатель   :"                                                   at 10   format "X(20)"
     7801                     skip Our_Host.obj-name + ", " + Our_Object.obj-name                     at 12   format "X(108)"
     7802                     skip(1)
     7803                 .
     7804           run outretxl-write-cell-data in this-procedure (
     7805                 input "h_docCode":U
     7806               , input v-doc-code
     7807           ).
     7808           run outretxl-write-cell-data in this-procedure (
     7809                 input "h_docDate":U
     7810               , input v-doc-date-string
     7811           ).
     7812           run outretxl-write-cell-data in this-procedure (
     7813                 input "h_cliFrom":U
     7814               , input string( "Получатель : " + Our_Host.obj-name + ", " + Our_Object.obj-name )
     7815           ).
     7816           if CostPrice then do:
     7817             put stream Out_stream space(10) "Указаны УЧЕТНЫЕ цены"      format "X(50)"  skip(2) .
     7818             run outretxl-write-cell-data in this-procedure (
     7819                 input "h_CostPrice":U
     7820               , input "Указаны УЧЕТНЫЕ цены"
     7821             ).
     7822           end.
     7823         end.
     7824       end case .
     7825       Find Pay-type Where Pay-type.Obj-code = T-doc.Pay-code No-lock No-error.
     7826       Put Stream Out_Stream String( "Вид оплаты : " + ( If Available Pay-type Then Pay-type.Obj-name Else "?" ) ) At 10 Format "X(60)" Skip.
     7827       run outretxl-write-cell-data in this-procedure (
     7828           input "h_PayType":U
     7829         , input ( If Available Pay-type Then Pay-type.Obj-name Else "?" )
     7830       ).
     7831       If V-torgconf-outprim = No or t-doc.internal Then Do:
     7832         Put Stream Out_Stream  String( "Примечание : " + ( If ( Not Can-do( 'факт':U, T-doc.Status_ ) Or Logres ) And Not ( T-doc.Ps Begins "@" ) Then  T-doc.Ps Else " " ) ) At 10 Format "X(100)" Skip .
     7833         run outretxl-write-cell-data in this-procedure (
     7834             input "h_PS":U
     7835           , input Replace(( If ( Not Can-do( 'факт':U, T-doc.Status_ ) Or Logres ) And Not ( T-doc.Ps Begins "@" ) Then  T-doc.Ps Else " " ), chr(10), " ")
     7836         ).
     7837       End.
     7838       define variable v-osnov         as character initial "" no-undo .
     7839       define variable v-attr-type     as character    no-undo.
     7840       define variable v-attr-value    as character    no-undo.
     7841       if t-doc.doc-type = 'при':U
     7842       then  do:
     7843           run gbl/trdcat-v.p (input t-doc.doc-code,input 'nids':U,output v-attr-value,output v-attr-type) .
     7844           assign v-osnov = v-attr-value .
     7845           run gbl/trdcat-v.p (input t-doc.doc-code,input 'dids':U,output v-attr-value,output v-attr-type) .
     7846           assign v-osnov = v-osnov + " от " + v-attr-value .
     7847       end.
     7848       put stream Out_Stream
     7849           space(5) string( "Основание: " + v-osnov ) at 10 format "X(100)" skip
     7850       .
     7851       run outretxl-write-cell-data in this-procedure (
     7852             input "h_reason":U
     7853           , input v-osnov
     7854       ).
     7855     end.
     7856     end.
     7857   end procedure.
     7858   procedure print-itog :
     7859     do on error undo, return error return-value :
     7860         define variable v-oper-name    as character    no-undo.
     7861       put stream out_stream Line format "X(134)" skip .
     7862       if PrintRubl then do:
     7863         display stream out_stream
     7864           sym1 sym2 sym3 sym4 "ИТОГО: " @ gds_name sym5 sym6 sym7 all-qnty @ qnty sym8 all-stoim @ stoim  sym10
     7865         with frame rubl.
     7866         down stream out_stream with frame rubl .
     7867       end.
     7868       else do:
     7869         display stream out_stream
     7870           sym1 sym2 sym3 sym4 "ИТОГО: " @ gds_name sym5 sym6 sym7 all-qnty @ qnty sym8 all-stoim @ stoim  sym10
     7871         with frame val.
     7872         down stream out_stream with frame val .
     7873       end.
     7874       put stream out_stream Line format "X(134)" skip .
     7875       run outretxl-write-cell-data in this-procedure (
     7876             input "it_qnty":U
     7877           , input string( all-qnty )
     7878       ).
     7879       run outretxl-write-cell-data in this-procedure (
     7880             input "it_sum":U
     7881           , input string( all-stoim )
     7882       ).
     7883       if line-counter( Out_stream ) + 16 > page-size( Out_stream ) then  page stream Out_stream .
     7884       put stream Out_stream skip(1) space(5) "Всего " format "x(8)" all-qnty format ">,>>>,>>9.<<<"
     7885         space(2) "единицы" format "x(8)" space(2) Lines_Counter format ">,>>>,>>9" space(2) "наименований" format "x(13)"
     7886                                                 "на сумму"  all-stoim  format ">,>>>,>>>,>>>,>>9.99"  " "  ( if not PrintRubl then currency.curr-abbr else "РУБ" )
     7887         skip(1).
     7888       run outretxl-write-cell-data in this-procedure (
     7889             input "f_lineAmount":U
     7890           , input string( "Всего " + string(all-qnty,">,>>>,>>9.<<<") + " единицы " + string(Lines_Counter,">,>>>,>>9") + " наименований  на сумму " + string(all-stoim,">,>>>,>>>,>>>,>>9.99") + " " +  ( if not PrintRubl then currency.curr-abbr else "РУБ" ) )
     7891       ).
     7892       v-torgconf-outdisc = true .
     7893       if v-torgconf-outdisc = no and not CostPrice then do:
     7894         put stream Out_stream space(5) "Скидка " format "x(8)"
     7895           ( if t-doc.tot-calc <> 0 and t-doc.discnt-pc = 0 then " " else string( string( t-doc.discnt-pc, "->>9.9" ) + "%" ) )
     7896           space(2) "на сумму"                                                        format "x(10)"
     7897           space(2) ( if not PrintRubl then t-doc.tot-calc else t-doc.discnt-rubl )   format "->>>,>>>,>>>,>>9.99"
     7898           space(2) ( if not PrintRubl then currency.curr-abbr else "РУБ" )                    format "x(4)" skip(1)
     7899         .
     7900         if t-doc.discnt-pc <> 0 then
     7901           run outretxl-write-cell-data in this-procedure (
     7902                 input "f_Skidka":U
     7903               , input string( "Скидка " + string( t-doc.discnt-pc, "->>9.9" ) + "%  на сумму  "  + string(( if not PrintRubl then t-doc.tot-calc else t-doc.discnt-rubl ),"->>>,>>>,>>>,>>9.99") )
     7904           ).
     7905       end.
     7906       if can-do( 'факт':U , t-doc.status_ ) or
     7907          ( can-do( 'рас':U , t-doc.doc-type ) and can-do( 'накл,запрос':U , t-doc.status_ ) and
     7908          ( not t-doc.internal ) ) then do:
     7909         if not PrintRubl then run rep/wp.p (     input ParParentProc, input all-stoim, output s1, output s2 ) .
     7910         else                  run rep/wp-rub.p (                      input all-stoim, output s1, output s2 ) .
     7911         if can-do( 'возврат':U , t-doc.doc-type ) then put stream Out_stream space(5) "Итого " format "x(6)" .
     7912         else                                         put stream Out_stream space(5) "Итого к оплате " format "x(17)" .
     7913         if v-torgconf-outdisc = no and not CostPrice then put stream Out_stream "( с учетом скидки ) " format "x(22)" .
     7914         put stream Out_stream all-stoim format "->>>,>>>,>>>,>>9.99" space(1) trim(s2) format "x(4)".
     7915         run outretxl-write-cell-data in this-procedure (
     7916               input "f_SumAll":U
     7917             , input string( all-stoim,"->>>,>>>,>>>,>>9.99")
     7918         ).
     7919         run outretxl-write-cell-data in this-procedure (
     7920               input "f_SumAllLiteral":U
     7921             , input s1
     7922         ).
     7923         put stream Out_stream skip(1) space(10) caps(s1) format "x(126)" skip(1) .
     7924         if is-chek then do:
     7925           put stream Out_stream space(10)  "М П" format "x(60)"  "Подпись : " format "x(50)" skip(1) .
     7926         end.
     7927         else do:
     7928           if can-do( 'рас':U , t-doc.doc-type ) and ( not t-doc.internal )
     7929               and ( ( can-do( 'запрос':U , t-doc.status_ )
     7930               or ( can-do( 'накл':U , t-doc.status_ ) and t-doc.flag_ ) ) )
     7931               or t-doc.status_ = 'факт':U
     7932           then do:
     7933             if t-doc.office then do:
     7934               put stream Out_stream  "Заказчик :    ______________/_____________ / " space(20)  "Исполнитель : ______________/_____________ /"  .
     7935             end.
     7936             else do:
     7937               put stream Out_stream space(10)  "Сдал : " format "x(60)"  "Принял : " format "x(50)" skip(1) .
     7938             end.
     7939           end.
     7940           else do:
     7941             put stream Out_stream space(30) "--- Н Е   П О Д П И С Ы В А Т Ь ! ---" format "X(75)" skip(1) .
     7942           end.
     7943         end.
     7944       end.
     7945       run rep/get-psn.p
     7946         (input t-doc.boss
     7947         ,output boss-name
     7948         ) .
     7949       run rep/get-psn.p
     7950         (input t-doc.wrkr
     7951         ,output Wrkr_name
     7952         ) .
     7953   define variable vss-include-info44 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7954   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrnick in g#library
     7955     (input  t-doc.creid
     7956     ,output v-oper-name
     7957     )  .
     7958       if boss-name = ? then boss-name = " " .
     7959       if Wrkr_name = ? then Wrkr_name = " " .
     7960       put stream Out_stream unformatted "Документ оформил: " skip  "Оператор: "  v-oper-name  skip "Менеджер по приему товара: "  Wrkr_name skip "Менеджер: "  boss-name skip.
     7961       run outretxl-write-cell-data in this-procedure (
     7962             input "f_OperName":U
     7963           , input v-oper-name
     7964       ).
     7965       run outretxl-write-cell-data in this-procedure (
     7966             input "f_KladName":U
     7967           , input Wrkr_name
     7968       ).
     7969       run outretxl-write-cell-data in this-procedure (
     7970             input "f_MngrName":U
     7971           , input boss-name
     7972       ).
     7973       put stream Out_stream space(65) ( if v-torgconf-outdate = no then string( t-doc.fact-date, "99/99/9999" ) else "" )  format "X(10)"  skip .
     7974       run outretxl-write-cell-data in this-procedure (
     7975             input "f_Date":U
     7976           , input ( if v-torgconf-outdate = no then string( t-doc.fact-date, "99/99/9999" ) else "" )
     7977       ).
     7978       hide stream Out_stream frame Bottomframe .
     7979     end.
     7980   end procedure.
