     6657             v-cntxp-down-pay        = bf-cntxp_store.down-pay
     6658             v-cntxp-inv-pay         = bf-cntxp_store.inv-pay
     6659             v-cntxp-chk-pay         = bf-cntxp_store.chk-pay
     6660             v-cntxp-retail          = bf-cntxp_sysconf.ord-prt
     6661             v-cntxp-osn-base        = bf-cntxp_sysconf.osn-base
     6662             .
     6663         end.
     6664         when 'маг':U then do:
     6665           find first bf-cntxp_shop where bf-cntxp_shop.obj-code = v-cntxp-obj-code no-lock.
     6666           find first bf-cntxp_sysconf where bf-cntxp_sysconf.host-code = bf-cntxp_shop.host-code no-lock.
