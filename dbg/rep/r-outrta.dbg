     3452               find first buf_sysconf no-lock
     3453               where buf_sysconf.host-code = v-host-code
     3454               no-error.
     3455               if available buf_sysconf
     3456               then do:
     3457                  assign
     3458                     v-torgconf-ogr-post = buf_sysconf.head-position
     3459                  .
     3460               end.
     3461               find first buf_clients no-lock
     3462                  where buf_clients.obj-type = 'орг':U
     3463                  and buf_clients.obj-code = v-host-code
     3464               .
     3465               find first buf_firm no-lock
     3466                  where buf_firm.firm-code = buf_clients.obj-code
     3467               .
     3468               assign
     3469                  v-torgconf-ogr-name = buf_firm.director
     3470               .
     3471            end.
     3472            if v-torgconf-outogr = "dir_obj"
     3473               then do:
     3474               find first buf_wth-doc no-lock
     3475               where buf_wth-doc.doc-code = p-doc-code
     3476               no-error.
     3477                  find first buf_shop no-lock
     3478                  where buf_shop.obj-code = buf_wth-doc.obj-code
     3479                  .
     3480                  assign
     3481                     v-torgconf-ogr-name = buf_shop.director
     3482                     v-torgconf-ogr-post = "Директор"
     3483                  .
     3484               end.
     3485         if v-torgconf-outogr = "manag_doc"
     3486            then do:
     3487               find first buf_wth-doc no-lock
     3488               where buf_wth-doc.doc-code = p-doc-code
     3489               no-error.
     3490               if available buf_wth-doc
     3491               then do:
     3492                  run rep/get-psn.p
     3493                  (input buf_wth-doc.deliver
     3494                  ,output v-torgconf-ogr-name
     3495                  ) .
     3496               end.
     3497               find first buf_person no-lock
     3498               where buf_person.psn-code = buf_wth-doc.deliver
     3499               no-error.
     3500               if available buf_person
     3501               then do:
     3502                  v-torgconf-ogr-post = buf_person.position.
     3503               end.
     3504               if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     3505               if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     3506            end.
     3507      end.
     3508   end.
     3509   end procedure.
     3510   procedure torgconf-get-outogr-param:
     3511       define input parameter p-form-name  as character    no-undo.
     3512       define input parameter p-host-code  as integer      no-undo.
     3513       define input parameter p-obj-type   as character    no-undo.
     3514       define input parameter p-obj-code   as integer      no-undo.
     3515       define input parameter p-doc-code   as character      no-undo.
     3516       define buffer buf_firm          for ub.firm .
     3517       define buffer buf_clients       for ub.clients .
     3518       define buffer buf_sysconf       for ub.sysconf .
     3519       define buffer buf_shop          for ub.shop .
     3520       define buffer buf_store         for ub.store .
     3521       define buffer buf_person        for ub.person .
     3522       define buffer buf_trn-doc       for ub.trn-doc .
     3523       define buffer buf_wth-doc       for ub.wth-doc .
     3524      if  p-form-name <> 'wthtrg12':U
     3525      and p-form-name <> 'wthfct':U
     3526      and p-form-name <> 'wthm11':U
     3527      then do:
     3528       find first buf_trn-doc no-lock
     3529       where buf_trn-doc.doc-code = p-doc-code
     3530       no-error.
     3531       if v-torgconf-outogr = "no_print"
     3532         then do:
     3533            assign
     3534               v-torgconf-ogr-name = ""
     3535               v-torgconf-ogr-post = ""
     3536            .
     3537         end.
     3538      if v-torgconf-outogr  = "ruk_firm"
     3539            then do:
     3540            find first buf_sysconf no-lock
     3541            where buf_sysconf.host-code = p-host-code
     3542            no-error.
     3543            if available buf_sysconf
     3544            then do:
     3545               assign
     3546                  v-torgconf-ogr-post = buf_sysconf.head-position
     3547               .
     3548            end.
     3549            find first buf_clients no-lock
     3550                where buf_clients.obj-type = 'орг':U
     3551                and buf_clients.obj-code = p-host-code
     3552            .
     3553            find first buf_firm no-lock
     3554                where buf_firm.firm-code = buf_clients.obj-code
     3555            .
     3556            assign
     3557                v-torgconf-ogr-name = buf_firm.director
     3558            .
     3559         end.
     3560         if v-torgconf-outogr = "dir_obj"
     3561            then do:
     3562            find first buf_trn-doc no-lock
     3563            where buf_trn-doc.doc-code = p-doc-code
     3564            no-error.
     3565               CASE buf_trn-doc.obj-type:
     3566               WHEN 'маг':U
     3567               THEN DO:
     3568                  find first buf_shop no-lock
     3569                  where buf_shop.obj-code = buf_trn-doc.obj-code
     3570                  .
     3571                  assign
     3572                     v-torgconf-ogr-name = buf_shop.director
     3573                     v-torgconf-ogr-post = "Директор"
     3574                  .
     3575               END.
     3576               WHEN 'скл':U
     3577               THEN DO:
     3578                  find first buf_store no-lock
     3579                  where buf_store.obj-code = buf_trn-doc.obj-code
     3580                  .
     3581                  assign
     3582                     v-torgconf-ogr-name = buf_store.store-boss
     3583                     v-torgconf-ogr-post = "Директор"
     3584                  .
     3585               END.
     3586               OTHERWISE DO:
     3587                  assign
     3588                     v-torgconf-ogr-name = "":U
     3589                     v-torgconf-ogr-post = "":U
     3590                  .
     3591               END.
     3592               END CASE.
     3593            end.
     3594      if v-torgconf-outogr = "manag_doc"
     3595         then do:
     3596            find first buf_trn-doc no-lock
     3597            where buf_trn-doc.doc-code = p-doc-code
     3598            no-error.
     3599            if available buf_trn-doc
     3600            then do:
     3601               run rep/get-psn.p
     3602               (input buf_trn-doc.boss
     3603               ,output v-torgconf-ogr-name
     3604               ) .
     3605            end.
     3606            find first buf_person no-lock
     3607            where buf_person.psn-code = buf_trn-doc.boss
     3608            no-error.
     3609            if available buf_person
     3610            then do:
     3611               v-torgconf-ogr-post = buf_person.position.
     3612            end.
     3613            if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     3614            if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     3615         end.
     3616      end.
     3617      else do:
     3618      find first buf_wth-doc no-lock
     3619         where buf_wth-doc.doc-code = p-doc-code
     3620         no-error.
     3621         if v-torgconf-outogr = "no_print"
     3622            then do:
     3623               assign
     3624                  v-torgconf-ogr-name = ""
     3625                  v-torgconf-ogr-post = ""
     3626               .
     3627            end.
     3628         if v-torgconf-outogr  = "ruk_firm"
     3629               then do:
     3630               find first buf_sysconf no-lock
     3631               where buf_sysconf.host-code = p-host-code
     3632               no-error.
     3633               if available buf_sysconf
     3634               then do:
     3635                  assign
     3636                     v-torgconf-ogr-post = buf_sysconf.head-position
     3637                  .
     3638               end.
     3639               find first buf_clients no-lock
     3640                  where buf_clients.obj-type = 'орг':U
     3641                  and buf_clients.obj-code = p-host-code
     3642               .
     3643               find first buf_firm no-lock
     3644                  where buf_firm.firm-code = buf_clients.obj-code
     3645               .
     3646               assign
     3647                  v-torgconf-ogr-name = buf_firm.director
     3648               .
     3649            end.
     3650            if v-torgconf-outogr = "dir_obj"
     3651               then do:
     3652               find first buf_wth-doc no-lock
     3653               where buf_wth-doc.doc-code = p-doc-code
     3654               no-error.
     3655                  find first buf_shop no-lock
     3656                  where buf_shop.obj-code = buf_wth-doc.obj-code
     3657                  .
     3658                  assign
     3659                     v-torgconf-ogr-name = buf_shop.director
     3660                     v-torgconf-ogr-post = "Директор"
     3661                  .
     3662               end.
     3663         if v-torgconf-outogr = "manag_doc"
     3664            then do:
     3665               find first buf_wth-doc no-lock
     3666               where buf_wth-doc.doc-code = p-doc-code
     3667               no-error.
     3668               if available buf_wth-doc
     3669               then do:
     3670                  run rep/get-psn.p
     3671                  (input buf_wth-doc.deliver
     3672                  ,output v-torgconf-ogr-name
     3673                  ) .
     3674               end.
     3675               find first buf_person no-lock
     3676               where buf_person.psn-code = buf_wth-doc.deliver
     3677               no-error.
     3678               if available buf_person
     3679               then do:
     3680                  v-torgconf-ogr-post = buf_person.position.
     3681               end.
     3682               if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     3683               if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     3684            end.
     3685      end.
     3686   end.
     3687   procedure torgconf-get-reason  :
     3688   define input parameter  p-doc-code       as character        no-undo.
     3689   define input parameter  p-reason-code    as integer          no-undo .
     3690   define input parameter  p-doc-type       as character        no-undo.
     3691       if p-reason-code > 0
     3692       then do:
     3693           define buffer buf_trn-reason for ub.trn-reason.
     3694           find first buf_trn-reason no-lock where buf_trn-reason.reason-code = p-reason-code no-error .
     3695           if available buf_trn-reason then assign v-torgconf-reason =  buf_trn-reason.reason-name .
     3696       end.
     3697       else do:
     3698           if p-doc-type = 'при':U
     3699           then  do:
     3700               define variable v-attr-type     as character    no-undo.
     3701               define variable v-attr-value    as character    no-undo.
     3702               run gbl/trdcat-v.p (input p-doc-code,input 'nids':U,output v-attr-value,output v-attr-type) .
     3703               assign v-torgconf-reason = v-attr-value .
     3704               run gbl/trdcat-v.p (input p-doc-code,input 'dids':U,output v-attr-value,output v-attr-type) .
     3705               assign v-torgconf-reason = v-torgconf-reason + " от " + v-attr-value .
     3706           end.
     3707       end.
     3708   end procedure.
