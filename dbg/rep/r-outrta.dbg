     5733   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5734   define variable gp-doc-num    like ub.price-list.doc-num    no-undo.
     5735   define variable gp-price-sale like ub.price-list.price-sale no-undo.
     5736   define variable gp-road-tax   like ub.price-list.road-tax   no-undo.
     5737   define variable gp-excise     like ub.price-list.excise     no-undo.
     5738   define variable gp-b-code     like ub.bar-code.b-code       no-undo.
     5739   define variable gp-fact-order as decimal   no-undo .
     5740   define variable gp-price-sale-parts as decimal   no-undo .
     5741   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5742   procedure lineattr-value :
     5743     do
     5744     on error undo, return error return-value
     5745     :
     5746       define input  parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     5747       define input  parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     5748       define input  parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
     5749       define output parameter p-value    like ub.doc-line-attr.attr-value no-undo .
     5750       define output parameter p-type     as character no-undo .
     5751       define buffer buf_doc-line-attr for ub.doc-line-attr .
     5752       def var v-format         as character no-undo .
     5753       def var v-fillin_width   as integer   no-undo .
     5754       def var v-fillin_height  as integer   no-undo .
     5755       def var v-label          as character no-undo .
     5756       def var v-user-can-edit  as logical   no-undo .
     5757       def var v-output-display as logical   no-undo .
     5758       def var v-other          as character no-undo .
     5759       run lineattr-code in this-procedure
     5760         (input  p-code
     5761         ,output p-type
     5762         ,output v-format
     5763         ,output v-fillin_width
     5764         ,output v-fillin_height
     5765         ,output v-label
     5766         ,output v-user-can-edit
     5767         ,output v-output-display
     5768         ,output v-other
     5769         ) no-error .
     5770       if error-status :error then do:
     5771         undo, return error return-value .
     5772       end.
     5773       find first buf_doc-line-attr no-lock
     5774         where buf_doc-line-attr.doc-code  = p-doc-code
     5775           and buf_doc-line-attr.gds-code  = p-gds-code
     5776           and buf_doc-line-attr.attr-code = p-code
     5777         no-error .
     5778       if avail buf_doc-line-attr then do:
     5779         assign
     5780           p-value =  buf_doc-line-attr.attr-value
     5781         .
     5782       end.
     5783       else do:
     5784         assign
     5785           p-value = if p-type = 'L':U then "no":U else ""
     5786         .
     5787       end.
     5788     end.
     5789   end procedure.
     5790   procedure lineattr-write :
     5791     do
     5792     on error undo, return error return-value
     5793     :
     5794       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     5795       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     5796       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
     5797       define input parameter p-value    like ub.doc-line-attr.attr-value no-undo .
     5798       define buffer buf_doc-line-attr for ub.doc-line-attr .
     5799       def var v-type           as character no-undo .
     5800       def var v-format         as character no-undo .
     5801       def var v-fillin_width   as integer   no-undo .
     5802       def var v-fillin_height  as integer   no-undo .
     5803       def var v-label          as character no-undo .
     5804       def var v-user-can-edit  as logical   no-undo .
     5805       def var v-output-display as logical   no-undo .
     5806       def var v-other          as character no-undo .
     5807       run lineattr-code in this-procedure
     5808         (input  p-code
     5809         ,output v-type
     5810         ,output v-format
     5811         ,output v-fillin_width
     5812         ,output v-fillin_height
     5813         ,output v-label
     5814         ,output v-user-can-edit
     5815         ,output v-output-display
     5816         ,output v-other
     5817         ) no-error .
     5818       if error-status :error then do:
     5819         undo, return error return-value .
     5820       end.
     5821       find first buf_doc-line-attr exclusive-lock
     5822         where buf_doc-line-attr.doc-code  = p-doc-code
     5823           and buf_doc-line-attr.gds-code  = p-gds-code
     5824           and buf_doc-line-attr.attr-code = p-code
     5825         no-error .
     5826       if not available buf_doc-line-attr then do:
     5827         create buf_doc-line-attr .
     5828         assign
     5829           buf_doc-line-attr.doc-code  = p-doc-code
     5830           buf_doc-line-attr.gds-code = p-gds-code
     5831           buf_doc-line-attr.attr-code = p-code
     5832         .
     5833       end.
     5834       assign
     5835         buf_doc-line-attr.attr-value = p-value
     5836       .
     5837        release buf_doc-line-attr.
     5838     end.
     5839   end procedure.
     5840   procedure lineattr-exist :
     5841     do
     5842     on error undo, return error return-value
     5843     :
     5844       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     5845       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     5846       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
     5847       define output parameter p-exist   as logical  no-undo .
     5848       define buffer buf_doc-line-attr for ub.doc-line-attr .
     5849       def var v-type           as character no-undo .
     5850       def var v-format         as character no-undo .
     5851       def var v-fillin_width   as integer   no-undo .
     5852       def var v-fillin_height  as integer   no-undo .
     5853       def var v-label          as character no-undo .
     5854       def var v-user-can-edit  as logical   no-undo .
     5855       def var v-output-display as logical   no-undo .
     5856       def var v-other          as character no-undo .
     5857       run lineattr-code in this-procedure
     5858         (input  p-code
     5859         ,output v-type
     5860         ,output v-format
     5861         ,output v-fillin_width
     5862         ,output v-fillin_height
     5863         ,output v-label
     5864         ,output v-user-can-edit
     5865         ,output v-output-display
     5866         ,output v-other
     5867         ) no-error .
     5868       if error-status :error then do:
     5869         undo, return error return-value .
     5870       end.
     5871       find first buf_doc-line-attr no-lock
     5872         where buf_doc-line-attr.doc-code  = p-doc-code
     5873           and buf_doc-line-attr.gds-code = p-gds-code
     5874           and buf_doc-line-attr.attr-code = p-code
     5875         no-error .
     5876       if  available buf_doc-line-attr then do:
     5877         p-exist = yes.
     5878       end.
     5879     end.
     5880   end procedure.
     5881   procedure lineattr-delete :
     5882     do
     5883     on error undo, return error return-value
     5884     :
     5885       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     5886       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     5887       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
     5888       define output parameter p-deleted  as logical no-undo.
     5889       define buffer buf_doc-line-attr for ub.doc-line-attr .
     5890       def var v-type           as character no-undo .
     5891       def var v-format         as character no-undo .
     5892       def var v-fillin_width   as integer   no-undo .
     5893       def var v-fillin_height  as integer   no-undo .
     5894       def var v-label          as character no-undo .
     5895       def var v-user-can-edit  as logical   no-undo .
     5896       def var v-output-display as logical   no-undo .
     5897       def var v-other          as character no-undo .
     5898       run lineattr-code in this-procedure
     5899         (input  p-code
     5900         ,output v-type
     5901         ,output v-format
     5902         ,output v-fillin_width
     5903         ,output v-fillin_height
     5904         ,output v-label
     5905         ,output v-user-can-edit
     5906         ,output v-output-display
     5907         ,output v-other
     5908         ) no-error .
     5909       if error-status :error then do:
     5910         undo, return error return-value .
     5911       end.
     5912       find first buf_doc-line-attr exclusive-lock
     5913         where buf_doc-line-attr.doc-code  = p-doc-code
     5914           and buf_doc-line-attr.gds-code  = p-gds-code
     5915           and buf_doc-line-attr.attr-code = p-code
     5916         no-error NO-WAIT.
     5917       if not available buf_doc-line-attr then do:
     5918         p-deleted = no.
     5919       end.
     5920       else do:
     5921         delete buf_doc-line-attr.
     5922         p-deleted = yes.
     5923       end.
     5924     end.
     5925   end procedure.
     5926   procedure lineattr-code :
     5927     do on error undo, return error return-value
     5928     :
     5929       define input  parameter p-code           as character no-undo .
     5930       define output parameter p-type           as character no-undo .
     5931       define output parameter p-format         as character no-undo .
     5932       define output parameter p-fillin_width   as integer   no-undo .
     5933       define output parameter p-fillin_height  as integer   no-undo .
     5934       define output parameter p-label          as character no-undo .
     5935       define output parameter p-user-can-edit  as logical   no-undo .
     5936       define output parameter p-output-display as logical   no-undo .
     5937       define output parameter p-other          as character no-undo .
     5938       case p-code :
     5939               when 'parts_price-sale':U then do:     assign     p-label          = "Продажная цена партии"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Продажная цена партии"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     5940               when 'fl_gds-code':U then do:     assign     p-label          = "Количество по букету"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Количество по букету"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     5941               when 'old_other-ras':U then do:     assign     p-label          = " Первым способом из ПН Сумма дополнительных расходов по строке rubl base"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = " Первым способом из ПН Сумма дополнительных расходов по строке rubl base"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     5942               when 'new_other-ras':U then do:     assign     p-label          = " Способом из ДопРасх Сумма дополнительных расходов по строке rubl base"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = " Способом из ДопРасх Сумма дополнительных расходов по строке rubl base"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     5943               when 'flora_ps':U then do:     assign     p-label          = "Описание не товарной позиции"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Описание не товарной позиции"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
     5944               when 'country-code':U then do:     assign     p-label          = "Страна"     p-type           = 'I':U      p-format         = "->>>>>>>>9"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Страна"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     5945               when 'add-line-cli':U then do:     assign     p-label          = "Курс . шкала . сумма . НДС "     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Курс . шкала . сумма . НДС "     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     5946               when 'corr-price-sale':U then do:     assign     p-label          = "Продажная цена в строке ПН"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Продажная цена в строке ПН"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     5947               when 'reason-code':U then do:     assign     p-label          = "Причина отклонения"     p-type           = 'I':U      p-format         = "->>>>>>>>9"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Причина отклонения"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
     5948               when 'price-prod':U then do:     assign     p-label          = "Цена производителя Без НДС"     p-type           = 'D':U      p-format         = ">>>>>>>>9.99"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Цена производителя Без НДС"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
     5949               when 'price-prodvat':U then do:     assign     p-label          = "Цена производителя c НДС"     p-type           = 'D':U      p-format         = ">>>>>>>>9.99"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Цена производителя c НДС"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
     5950         otherwise do:
     5951           undo, return error "неизвестный атрибут строки документа" + " " + p-code .
     5952         end.
     5953       end.
     5954     end.
     5955   end procedure.
     5956   procedure lineattr-value-flora-gds :
     5957     do
     5958     on error undo, return error return-value
     5959     :
     5960       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
     5961       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
     5962       define input  parameter p-prt-code    as integer   no-undo .
     5963       define input  parameter p-bk-gds-code like  ub.doc-line-attr.gds-code   no-undo .
     5964       define input  parameter p-code        like  ub.doc-line-attr.attr-code  no-undo .
     5965       define output parameter p-value       as    decimal   no-undo .
     5966       define buffer buf_doc-line-attr for ub.doc-line-attr .
     5967       find first buf_doc-line-attr no-lock
     5968         where buf_doc-line-attr.doc-code  = p-doc-code
     5969           and buf_doc-line-attr.gds-code  = p-gds-code
     5970           and buf_doc-line-attr.attr-code = p-code  + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
     5971         no-error .
     5972       if avail buf_doc-line-attr then do:
     5973         assign
     5974           p-value = decimal( buf_doc-line-attr.attr-value)
     5975         .
     5976       end.
     5977       else do:
     5978         assign
     5979           p-value = 0
     5980         .
     5981       end.
     5982     end.
     5983   end procedure.
     5984   procedure lineattr-write-flora-gds :
     5985     do
     5986     on error undo, return error return-value
     5987     :
     5988       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     5989       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     5990       define input parameter p-prt-code    as integer   no-undo .
     5991       define input parameter p-bk-gds-code like ub.doc-line-attr.gds-code   no-undo .
     5992       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
     5993       define input parameter p-value    as decimal   no-undo .
     5994       define buffer buf_doc-line-attr for ub.doc-line-attr .
     5995       find first buf_doc-line-attr exclusive-lock
     5996         where buf_doc-line-attr.doc-code  = p-doc-code
     5997           and buf_doc-line-attr.gds-code  = p-gds-code
     5998           and buf_doc-line-attr.attr-code = p-code + chr(44)  + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
     5999         no-error .
     6000       if not available buf_doc-line-attr then do:
     6001         create buf_doc-line-attr .
     6002         assign
     6003           buf_doc-line-attr.doc-code  = p-doc-code
     6004           buf_doc-line-attr.gds-code  = p-gds-code
     6005           buf_doc-line-attr.attr-code = p-code  + chr(44)  + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
     6006         .
     6007       end.
     6008       assign
     6009         buf_doc-line-attr.attr-value = string( p-value )
     6010       .
     6011     end.
     6012   end procedure.
     6013   procedure lineattr-delete-flora-gds :
     6014     do
     6015     on error undo, return error return-value
     6016     :
     6017       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     6018       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     6019       define input  parameter p-prt-code    as integer   no-undo .
     6020       define input parameter p-bk-gds-code like ub.doc-line-attr.gds-code   no-undo .
     6021       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
     6022       define output parameter p-deleted  as logical no-undo.
     6023       define buffer buf_doc-line-attr for ub.doc-line-attr .
     6024       find first buf_doc-line-attr exclusive-lock
     6025         where buf_doc-line-attr.doc-code  = p-doc-code
     6026           and buf_doc-line-attr.gds-code  = p-gds-code
     6027           and buf_doc-line-attr.attr-code = p-code + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
     6028         no-error NO-WAIT.
     6029       if not available buf_doc-line-attr then do:
     6030         p-deleted = no.
     6031       end.
     6032       else do:
     6033         delete buf_doc-line-attr.
     6034         p-deleted = yes.
     6035       end.
     6036     end.
     6037   end procedure.
     6038   procedure lineattr-delete-flora-all :
     6039     do
     6040     on error undo, return error return-value
     6041     :
     6042       define input  parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     6043       define input  parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     6044       define input  parameter p-prt-code    as integer   no-undo .
     6045       define buffer buf_doc-line-attr for ub.doc-line-attr .
     6046       for each buf_doc-line-attr exclusive-lock
     6047         where buf_doc-line-attr.doc-code  = p-doc-code
     6048           and buf_doc-line-attr.gds-code  = p-gds-code
     6049           and buf_doc-line-attr.attr-code begins 'fl_gds-code':U + chr(44) + string(p-prt-code)  + chr(44)
     6050        :
     6051         delete buf_doc-line-attr.
     6052       end.
     6053    end.
     6054   end procedure.
     6055   procedure lineattr-exist-flora-gds :
     6056     do
     6057     on error undo, return error return-value
     6058     :
     6059       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
     6060       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
     6061       define input  parameter p-prt-code    as integer   no-undo .
     6062       define input  parameter p-bk-gds-code like  ub.doc-line-attr.gds-code   no-undo .
     6063       define output parameter p-exist as logical   no-undo .
     6064       define buffer buf_doc-line-attr for ub.doc-line-attr .
     6065       p-exist = false .
     6066       find first buf_doc-line-attr no-lock
     6067         where buf_doc-line-attr.doc-code  = p-doc-code
     6068           and buf_doc-line-attr.gds-code  = p-gds-code
     6069           and buf_doc-line-attr.attr-code = 'fl_gds-code':U  + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
     6070         no-error .
     6071       if avail buf_doc-line-attr then do:
     6072         assign
     6073          p-exist = true
     6074         .
     6075       end.
     6076     end.
     6077   end procedure.
     6078   procedure lineattr-write-add-line-cli :
     6079   define input  parameter p-doc-code      like  ub.doc-line-attr.doc-code   no-undo .
     6080   define input  parameter p-gds-code      like  ub.doc-line-attr.gds-code   no-undo .
     6081   define input  parameter p-cli-type      as character no-undo .
     6082   define input  parameter p-cli-code      as integer   no-undo .
     6083   define input  parameter p-contract-code as integer   no-undo .
     6084   define input  parameter p-host-code     as integer   no-undo .
     6085   define input  parameter p-exch-code     as integer   no-undo .
     6086   define input  parameter p-exch-rate     as decimal   no-undo .
     6087   define input  parameter p-exch-scale    as integer   no-undo .
     6088   define input  parameter p-sum-cli       as decimal   no-undo .
     6089   define input  parameter p-sum-vat       as decimal   no-undo .
     6090   define buffer buf_doc-line-attr for ub.doc-line-attr .
     6091     do
     6092     on error undo, return error return-value
     6093     :
     6094       find first buf_doc-line-attr exclusive-lock
     6095         where buf_doc-line-attr.doc-code  = p-doc-code
     6096           and buf_doc-line-attr.gds-code  = p-gds-code
     6097           and buf_doc-line-attr.attr-code = 'add-line-cli':U +
     6098                                             chr(4) + p-cli-type +
     6099                                             chr(4) + string(p-cli-code) +
     6100                                             chr(4) + string(p-contract-code) +
     6101                                             chr(4) + string(p-host-code)
     6102         no-error .
     6103       if not available buf_doc-line-attr then do:
     6104         create buf_doc-line-attr .
     6105         assign
     6106           buf_doc-line-attr.doc-code  = p-doc-code
     6107           buf_doc-line-attr.gds-code  = p-gds-code
     6108           buf_doc-line-attr.attr-code = 'add-line-cli':U  +
     6109                                         chr(4) + p-cli-type +
     6110                                         chr(4) + string(p-cli-code) +
     6111                                         chr(4) + string(p-contract-code) +
     6112                                         chr(4) + string(p-host-code)
     6113         .
     6114       end.
     6115       assign
     6116         buf_doc-line-attr.attr-value =
     6117         string(p-exch-code)  + chr(4) +
     6118         string(p-exch-rate)  + chr(4) +
     6119         string(p-exch-scale) + chr(4) +
     6120         string(p-sum-cli)    + chr(4) +
     6121         string(p-sum-vat)
     6122         .
     6123     end.
     6124   end procedure.
     6125   procedure lineattr-value-add-line-cli :
     6126   define input   parameter p-doc-code      like  ub.doc-line-attr.doc-code   no-undo .
     6127   define input   parameter p-gds-code      like  ub.doc-line-attr.gds-code   no-undo .
     6128   define input   parameter p-cli-type      as character no-undo .
     6129   define input   parameter p-cli-code      as integer   no-undo .
     6130   define input   parameter p-contract-code as integer   no-undo .
     6131   define input   parameter p-host-code     as integer   no-undo .
     6132   define output  parameter p-exch-code     as integer   no-undo .
     6133   define output  parameter p-exch-rate     as decimal   no-undo .
     6134   define output  parameter p-exch-scale    as integer   no-undo .
     6135   define output  parameter p-sum-cli       as decimal   no-undo .
     6136   define output  parameter p-sum-vat       as decimal   no-undo .
     6137   define buffer buf_doc-line-attr for ub.doc-line-attr .
     6138     do
     6139     on error undo, return error return-value
     6140     :
     6141       find first buf_doc-line-attr exclusive-lock
     6142         where buf_doc-line-attr.doc-code  = p-doc-code
     6143           and buf_doc-line-attr.gds-code  = p-gds-code
     6144           and buf_doc-line-attr.attr-code = 'add-line-cli':U +
     6145                                             chr(4) + p-cli-type +
     6146                                             chr(4) + string(p-cli-code) +
     6147                                             chr(4) + string(p-contract-code) +
     6148                                             chr(4) + string(p-host-code)
     6149         no-error .
     6150       if available buf_doc-line-attr then do:
     6151        assign
     6152           p-exch-code  = integer ( entry (1 , buf_doc-line-attr.attr-value,  chr(4) ))
     6153           p-exch-rate  = decimal ( entry (2 , buf_doc-line-attr.attr-value, chr(4) ))
     6154           p-exch-scale = integer ( entry (3 , buf_doc-line-attr.attr-value, chr(4) ))
     6155           p-sum-cli    = decimal ( entry (4 , buf_doc-line-attr.attr-value, chr(4) ))
     6156           p-sum-vat    = decimal ( entry (5 , buf_doc-line-attr.attr-value, chr(4) ))
     6157          .
     6158        end.
     6159     end.
     6160   end procedure.
     6161   function lineattr-get-reason returns character ( buffer local-doc-line for ub.doc-line ) :
     6162     define variable v-code as character no-undo .
     6163     define variable v-type as character no-undo .
     6164     define variable v-gds-code as integer   no-undo .
     6165   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6166   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     6167     (input  local-doc-line.artic
     6168     ,input  local-doc-line.prod-type
     6169     ,input  local-doc-line.prod-code
     6170     ,output v-gds-code
     6171     )  .
     6172     run lineattr-value (
     6173         input   local-doc-line.doc-code ,
     6174         input   v-gds-code              ,
     6175         input   'reason-code':U ,
     6176         output  v-code                  ,
     6177         output  v-type ) .
     6178     find first ub.trn-reason no-lock where
     6179                ub.trn-reason.reason-code = integer ( v-code ) no-error.
     6180     if not available ub.trn-reason then do:
     6181        return "" .
     6182     end.
     6183     else do:
     6184        return ub.trn-reason.reason-name .
     6185     end.
     6186   end function.
     6187   procedure lineattr-value-parts :
     6188     do
     6189     on error undo, return error return-value
     6190     :
     6191       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
     6192       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
     6193       define input  parameter p-part-code   as character no-undo .
     6194       define input  parameter p_in-code     as character no-undo .
     6195       define input  parameter p-code        like  ub.doc-line-attr.attr-code  no-undo .
     6196       define output parameter p-value       as    decimal   no-undo .
     6197       define buffer buf_doc-line-attr for ub.doc-line-attr .
     6198       find first buf_doc-line-attr no-lock
     6199         where buf_doc-line-attr.doc-code  = p-doc-code
     6200           and buf_doc-line-attr.gds-code  = p-gds-code
     6201           and buf_doc-line-attr.attr-code = p-code  + chr(4) + trim(p-part-code)  + chr(4) + trim(p_in-code)
     6202         no-error .
     6203       if avail buf_doc-line-attr then do:
     6204         assign
     6205           p-value = decimal( buf_doc-line-attr.attr-value)
     6206         .
     6207       end.
     6208       else do:
     6209         assign
     6210           p-value = 0
     6211         .
     6212       end.
     6213     end.
     6214   end procedure.
     6215   procedure lineattr-write-parts :
     6216     do
     6217     on error undo, return error return-value
     6218     :
     6219       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     6220       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     6221       define input parameter p-part-code  as character no-undo .
     6222       define input parameter p_in-code    as character no-undo .
     6223       define input parameter p-code       like ub.doc-line-attr.attr-code  no-undo .
     6224       define input parameter p-value      as decimal   no-undo .
     6225       define buffer buf_doc-line-attr for ub.doc-line-attr .
     6226       find first buf_doc-line-attr exclusive-lock
     6227         where buf_doc-line-attr.doc-code  = p-doc-code
     6228           and buf_doc-line-attr.gds-code  = p-gds-code
     6229           and buf_doc-line-attr.attr-code = p-code + chr(4)  + trim(p-part-code)  + chr(4) + trim(p_in-code)
     6230         no-error .
     6231       if not available buf_doc-line-attr then do:
     6232         create buf_doc-line-attr .
     6233         assign
     6234           buf_doc-line-attr.doc-code  = p-doc-code
     6235           buf_doc-line-attr.gds-code  = p-gds-code
     6236           buf_doc-line-attr.attr-code = p-code  + chr(4)  + trim(p-part-code)  + chr(4) + trim(p_in-code)
     6237         .
     6238       end.
     6239       assign
     6240         buf_doc-line-attr.attr-value = string( p-value )
     6241       .
     6242     end.
     6243   end procedure.
     6244   define buffer buf1_clients for ub.clients  .
     6245   do
     6246   on error undo, return error
     6247   :
     6248     define variable g#report-num as integer   no-undo .
