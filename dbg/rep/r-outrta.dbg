     6250   def var vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6251   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     6252   procedure paramls-clear :
     6253     define buffer buf_temp-param for temp-param .
     6254     do
     6255     on error undo, return error return-value
     6256     :
