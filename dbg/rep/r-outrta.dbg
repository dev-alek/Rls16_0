      946   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      947   procedure wthcattr-sprcli :
      948   define input parameter parparentproc  as widget-handle no-undo.
      949   define input parameter p-mode  as character no-undo.
      950   define input-output parameter p-value as character no-undo .
      951   define output parameter p-setted as logical no-undo .
      952     DEFINE VARIABLE v-value as character no-undo .
      953     define variable v-cli-type as character no-undo .
      954     define variable v-cli-code as integer no-undo .
      955     define buffer buf_clients   for ub.clients.
      956     define variable v_rid as character no-undo.
      957     define variable ref-rec as recid no-undo .
      958     do
      959     on error undo, return error
      960     :
      961         v-value = p-value.
      962      if p-value <> '':U then do:
      963       assign
      964       v-cli-type = substring(p-value, 1, 3)
      965       v-cli-code = integer(substring(p-value, 4))
      966       no-error.
      967       if error-status:error then do:
      968         assign
      969         v-cli-type = '':U
      970         v-cli-code = 0
      971         .
      972       end.
      973      end.
      974      FIND FIRST buf_clients NO-LOCK WHERE
      975               buf_clients.obj-type = v-cli-type AND
      976               buf_clients.obj-code = v-cli-code  NO-ERROR.
      977      IF available(buf_clients) then do:
      978       run ref/cli-all.w (
      979                   input parparentproc
      980                  ,input if p-mode = 'ИЗМЕНЕНИЕ':U then "b-sel":U else "":U
      981                  ,input v-cli-type
      982                  ,input 'все':U
      983                  ,input 'все':U
      984                  ,input RECID( buf_clients )
      985                  ,input ",,,,,,NO"
      986                  ,input ?
      987                  ,OUTPUT v_rid ).
      988     END.
      989     ELSE if p-mode = 'ИЗМЕНЕНИЕ':U then DO:
      990       run ref/cli-all.w (
      991                    input parparentproc
      992                   ,INPUT "b-sel":U
      993                  ,input  v-cli-type
      994                  ,input 'все':U
      995                  ,input 'текущие':U
      996                  ,input ?
      997                  ,input ",,,,,,NO"
      998                  ,input ?
      999                  ,OUTPUT v_rid ).
     1000     END.
     1001     else do:
     1002       message
     1003       if p-value = "":U then 'Атрибут не задан!'
     1004       else substitute('Не найден клиент &1',p-value)
     1005       view-as alert-box warning.
     1006     end.
     1007     IF v_rid <> ? AND v_rid <> "":U THEN DO:
     1008       ASSIGN ref-rec = INT( v_rid ) NO-ERROR.
     1009       IF ERROR-STATUS:ERROR THEN DO:
     1010           RETURN NO-APPLY.
     1011       END.
     1012       FIND FIRST buf_clients NO-LOCK WHERE
     1013                  RECID( buf_clients ) = ref-rec NO-ERROR.
     1014       IF AVAIL buf_clients THEN DO:
     1015         v-value = buf_clients.obj-type + string(buf_clients.obj-code, ">>>>>>>>9").
     1016       end.
     1017     end.
     1018     if v-value <> p-value then do:
     1019       p-value = v-value.
     1020       p-setted = yes.
     1021     end.
     1022     end.
     1023   end procedure.
     1024     define new global shared variable g#wthcalib as handle no-undo.
     1025   procedure torgconf-read :
