     7316                 end.
     7317                 else do:
     7318                   Price =  ub.parts.price-base.
     7319                 end.
     7320             end.
     7321             stoim = stoim + ub.parts.fact-qnty * Price .
     7322             display stream out_stream
     7323               sym1
     7324               sym2 string(ub.bar-code.b-code) @ tb-code
     7325               sym3
     7326               sym4  ub.parts.part-code  @  buf_goods.unit-base
     7327               sym5  " " + buf1_clients.obj-name @ gds_name
     7328               sym6  Price
