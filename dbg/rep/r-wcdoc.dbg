      214   procedure prn-lib-reportviewer-report-name :
      215     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      216     define input parameter p-report-name-html as character no-undo .
      217     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      218   end procedure.
      219   procedure prn-lib-reportviewer :
      220     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      221     define input parameter p-report-name-html as character no-undo .
      222     define input parameter p-param        as character no-undo .
      223     define variable v-excel           as character no-undo init 'TRUE' .
      224     define variable v-value-character as character no-undo .
      225     define variable v-value-integer   as character no-undo .
      226     define variable v-value-date      as date      no-undo .
      227     define variable v-value-decimal   as decimal   no-undo .
      228     define variable rep-excel         as logical   no-undo .
      229     define variable excel-string      as character no-undo .
      230     define variable v-param-type      as character no-undo .
      231     define variable v-tth             as handle    no-undo .
      232     run adm/shattri.p (
      233       input "get":U
      234       ,input  ""
      235       ,input  0
      236       ,input  'report-glob':U
      237       ,input  'rep-excel':U
      238       ,output v-value-character
      239       ,output v-value-date
      240       ,output v-value-decimal
      241       ,output v-value-integer
      242       ,output rep-excel
      243       ,output v-param-type
      244       ,INPUT-OUTPUT table-handle v-tth
      245       )  .
      246     if rep-excel then v-excel = "TRUE" .
      247     else v-excel = "FALSE" .
      248     if p-param eq ""
      249     then
      250        p-param = "EXCEL:" + v-excel.
      251     else
      252        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      253     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      254   end procedure.
      255   define variable vss-include-info3 as character format "X(65)" no-undo
      256   initial "@(#)$Workfile$ $Revision$".
      257   define temp-table temp_p-fmt_string-part no-undo
      258       field str-key       as integer
      259       field string-part   as character
      260       index pi is primary unique
      261           str-key
      262   .
      263   define variable v-p-fmt-3-str-key    as integer      no-undo.
      264   FUNCTION center-field RETURNS INTEGER (INPUT iStartPix AS INTEGER, iEndPix AS INTEGER,
      265                                     iInput AS INTEGER).
      266     def var v-start-print as integer no-undo .
      267     if (iStartPix < 0) or (iEndPix < iStartPix) then return 0.
      268     assign
      269       v-start-print = INTEGER(iStartPix + ((iEndPix - iStartPix) / 2) - (iInput / 2))
      270     .
      271     RETURN v-start-print .
      272   END FUNCTION.
      273   FUNCTION right-field RETURNS INTEGER ( iEndPix AS INTEGER,
      274                                     iInput AS INTEGER).
      275     def var v-start-print as integer no-undo .
      276     assign
      277       v-start-print = INTEGER(iEndPix - 1 - iInput)
      278     .
      279     if v-start-print < 0 then return 0.
      280     RETURN v-start-print .
      281   END FUNCTION.
      282   function p-fmt-align-string returns character (
      283         p-in-string      as character
      284       , p-page-width     as integer
      285       , p-align-type     as character
      286   ).
      287       define variable v-string-length     as integer      no-undo.
      288       define variable v-out-string        as character    no-undo.
      289       assign
      290           v-string-length = length( trim( p-in-string ) )
      291       .
      292       if v-string-length >= p-page-width
      293       then do:
      294           assign
      295               v-out-string = trim( p-in-string )
      296           .
      297       end.
      298       else do:
      299           case p-align-type
      300           :
      301               when 'left':U
      302               then do:
      303                   assign
      304                       v-out-string = trim( p-in-string )
      305                   .
      306               end.
      307               when 'right':U
      308               then do:
      309                   assign
      310                       v-out-string = fill( " ":U, p-page-width - v-string-length ) + trim( p-in-string )
      311                   .
      312               end.
      313               when 'center':U
      314               then do:
      315                   assign
      316                       v-out-string = fill( " ":U, integer( ( p-page-width - v-string-length ) / 2 ) ) + trim( p-in-string )
      317                   .
      318               end.
      319           end case.
      320       end.
      321       return v-out-string .
      322   end function.
      323   procedure p-fmt-split-string :
      324   define input parameter p-source-string  as character        no-undo.
      325   define input parameter p-split-length   as integer          no-undo.
      326   define output parameter p-string-1      as character        no-undo.
      327   define output parameter p-string-2      as character        no-undo.
      328   do
      329   on error undo, return error
      330   :
      331       define variable v-space-pos    as integer      no-undo.
      332       if length( p-source-string ) <= p-split-length
      333       then do:
      334           assign
      335               p-string-1 = p-source-string
      336           .
      337       end.
      338       else do:
      339           assign
      340               v-space-pos = r-index( p-source-string, " ":U, p-split-length )
      341           .
      342           if v-space-pos = 0
      343           then do:
      344               assign
      345                   v-space-pos = index( p-source-string, " ":U )
      346               .
      347           end.
      348           if v-space-pos = 0
      349           then do:
      350               assign
      351                   p-string-1 = substring( p-source-string, 1, p-split-length )
      352                   p-string-2 = trim( substring( p-source-string, p-split-length, p-split-length ) )
      353               .
      354           end.
      355           else do:
      356               assign
      357                   p-string-1 = substring( p-source-string, 1, v-space-pos )
      358                   p-string-2 = trim( substring( p-source-string, v-space-pos ) )
      359               .
      360           end.
      361       end.
      362   end.
      363   end procedure.
      364   procedure p-fmt-round :
      365   define input parameter p-qnty               as decimal          no-undo.
      366   define input parameter p-price-no-VAT       as decimal          no-undo.
      367   define input parameter p-VAT                as decimal          no-undo.
      368   define input parameter p-SLT                as decimal          no-undo.
      369   define input parameter p-road-tax           as decimal          no-undo.
      370   define output parameter p-new-price-no-VAT  as decimal          no-undo.
      371   define output parameter p-new-VAT           as decimal          no-undo.
      372   define output parameter p-new-SLT           as decimal          no-undo.
      373   define output parameter p-new-sum-VAT       as decimal          no-undo.
      374   define output parameter p-new-sum-SLT       as decimal          no-undo.
      375   define output parameter p-new-sum-road-tax  as decimal          no-undo.
      376   define output parameter p-new-sum-no-VAT    as decimal          no-undo.
      377   define output parameter p-new-sum-full      as decimal          no-undo.
      378       define variable v-vat-pc    as decimal      no-undo.
      379       define variable v-slt-pc    as decimal      no-undo.
      380   do
      381   on error undo, return error
      382   :
      383       if p-price-no-VAT = 0
      384       then do:
      385           assign
      386               p-new-price-no-VAT = 0.0
      387               p-new-VAT          = ?
      388               p-new-SLT          = ?
      389               p-new-sum-VAT      = 0.0
      390               p-new-sum-SLT      = 0.0
      391               p-new-sum-no-VAT   = 0.0
      392               p-new-sum-road-tax = 0.0
      393               p-new-sum-full     = 0.0
      394           .
      395       end.
      396       else do:
      397           assign
      398               v-vat-pc            = p-VAT / p-price-no-VAT
      399               v-slt-pc            = p-SLT / ( p-price-no-VAT + p-VAT )
      400               p-new-price-no-VAT  = round( p-price-no-VAT, 2 )
      401               p-new-VAT           = round( p-new-price-no-VAT * v-vat-pc, 2 )
      402               p-new-SLT           = round( ( p-new-price-no-VAT + p-new-VAT ) * v-slt-pc, 2 )
      403               p-new-sum-VAT       = round( p-new-VAT          * p-qnty, 2 )
      404               p-new-sum-SLT       = round( ( p-new-price-no-VAT + p-new-VAT ) * p-qnty * v-slt-pc, 2 )
      405               p-new-sum-no-VAT    = round( p-new-price-no-VAT * p-qnty, 2 )
      406               p-new-sum-road-tax  = round( p-road-tax * p-qnty, 2 )
      407               p-new-sum-full      = round( ( p-new-price-no-VAT + p-new-VAT + p-new-SLT + p-road-tax ) * p-qnty, 2 )
      408           .
      409       end.
      410   end.
      411   end procedure.
      412   procedure p-fmt-split :
      413   define input parameter p-in-string      as character        no-undo.
      414   define input parameter p-split-length   as integer          no-undo.
      415       define variable v-start-pos     as integer      no-undo.
      416       define variable v-end-pos       as integer      no-undo.
      417       define buffer buf_temp_p-fmt_string-part        for temp_p-fmt_string-part.
      418   do
      419   for buf_temp_p-fmt_string-part
      420   on error undo, return error
      421   :
      422       empty temp-table buf_temp_p-fmt_string-part.
      423       if p-split-length < 1
      424       then do:
      425           undo, return error substitute( "p-fmt-split: Строка не может быть разбита на &1 частей", p-split-length ).
      426       end.
      427       assign
      428           p-in-string                 = trim( p-in-string )
      429           v-p-fmt-3-str-key   = 0
      430           v-start-pos                 = 1
      431           v-end-pos                   = length( p-in-string )
      432       .
      433       run p-fmt-get-string-range in this-procedure (
      434             input p-in-string
      435           , input p-split-length
      436           , input v-start-pos
      437           , output v-start-pos
      438           , output v-end-pos
      439       ).
      440       do while v-end-pos <> 0
      441       :
      442           create buf_temp_p-fmt_string-part.
      443           assign
      444               v-p-fmt-3-str-key = v-p-fmt-3-str-key + 1
      445           .
      446           assign
      447               buf_temp_p-fmt_string-part.str-key      = v-p-fmt-3-str-key
      448               buf_temp_p-fmt_string-part.string-part  = substring( p-in-string, v-start-pos, v-end-pos - v-start-pos )
      449           .
      450           assign
      451               v-start-pos = v-end-pos + 1
      452           .
      453           run p-fmt-get-string-range in this-procedure (
      454                 input p-in-string
      455               , input p-split-length
      456               , input v-start-pos
      457               , output v-start-pos
      458               , output v-end-pos
      459           ).
      460       end.
      461   end.
      462   end procedure.
      463   procedure p-fmt-get-string-range :
      464   define input parameter p-in-string      as character        no-undo.
      465   define input parameter p-split-length   as integer          no-undo.
      466   define input parameter p-old-start-pos  as integer          no-undo.
      467   define output parameter p-start-pos     as integer          no-undo.
      468   define output parameter p-end-pos       as integer          no-undo.
      469       define variable v-init-string    as character    no-undo.
      470       define variable v-temp-char      as character    no-undo.
      471       define variable v-temp-pos       as integer      no-undo.
      472       define variable v-counter        as integer      no-undo.
      473   do
      474   on error undo, return error
      475   :
      476       assign
      477           p-start-pos   = p-old-start-pos
      478           v-init-string = substring( p-in-string, p-start-pos )
      479       no-error.
      480       if error-status :error
      481       or trim( v-init-string ) = "":U
      482       then do:
      483           assign
      484               p-end-pos = 0
      485           .
      486           undo, return .
      487       end.
      488       assign
      489           v-temp-char   = substring( v-init-string, 1, 1 )
      490       .
      491       do
      492       while trim( v-temp-char ) = "":U
      493       :
      494           assign
      495               p-start-pos     = p-start-pos + 1
      496               v-init-string   = substring( p-in-string, p-start-pos )
      497               v-temp-char     = substring( v-init-string, 1, 1 )
      498           .
      499       end.
      500       assign
      501           v-temp-pos  = p-split-length
      502           v-temp-char = substring( v-init-string, v-temp-pos, 1 )
      503           v-counter   = 0
      504       .
      505       search-word-end:
      506       do
      507       while trim( v-temp-char ) <> "":U
      508       :
      509           assign
      510               v-counter   = v-counter + 1
      511           .
      512           if v-counter > 20
      513           then do:
      514               assign
      515                   v-temp-pos  = p-split-length
      516               .
      517               leave search-word-end.
      518           end.
      519           assign
      520               v-temp-pos  = v-temp-pos - 1
      521               v-temp-char = substring( v-init-string, v-temp-pos, 1 )
      522           .
      523       end.
      524       assign
      525           p-end-pos = p-start-pos + v-temp-pos - 1
      526       .
      527   end.
      528   end procedure.
      529   do
      530   on error undo, return error
      531   :
      532   def buffer buf_c-wth-doc  for ub.c-wth-doc.
      533   def buffer buf_c-wth-line for ub.c-wth-line.
      534   def buffer buf_c-wth-dtl  for ub.c-wth-dtl.
      535   def buffer buf_clients  for ub.clients.
      536   define buffer buf_host for ub.clients.
      537   define variable v-organization  like ub.clients.obj-name no-undo.
      538   define variable v-org-to        as char no-undo.
      539   define variable v-org-from      as char no-undo.
      540   define variable v-operator      like ub.clients.obj-name no-undo.
      541   define variable v-deliver       like ub.clients.obj-name no-undo.
      542   define variable v-receiver      like ub.clients.obj-name no-undo.
      543   define variable v-temp-string   as char no-undo.
      544   define variable v-temp-position as int  no-undo.
      545   define variable v-single-line   as char no-undo.
      546   assign v-single-line = fill("-", 124).
      547   if session:set-wait-state("compiler") then.
      548   run prn-lib-open-stream  in this-procedure (
      549                                                input parParentProc
      550                                               ,input 62
      551                                               ,input yes
      552                                               ,input no
      553                                               ).
      554   find first buf_c-wth-doc no-lock
      555        where recid( buf_c-wth-doc ) = p-c-wth-doc-recid
      556   .
      557   find first buf_clients no-lock
      558       where buf_clients.obj-type = buf_c-wth-doc.obj-type
      559         and buf_clients.obj-code = buf_c-wth-doc.obj-code
      560   .
      561   find first buf_host no-lock
      562       where buf_host.obj-type = 'орг':U
      563         and buf_host.obj-code = buf_c-wth-doc.host-code
      564   .
      565   assign
      566     v-organization = buf_clients.obj-name
      567   .
      568   for each buf_c-wth-line no-lock
      569        where buf_c-wth-line.doc-code = buf_c-wth-doc.doc-code
      570          AND buf_c-wth-line.corr-user-db-num = buf_c-wth-doc.corr-user-db-num
      571          AND buf_c-wth-line.chip-num = buf_c-wth-doc.chip-num
      572   break by buf_c-wth-line.wth-code
      573   :
      574       if not first(buf_c-wth-line.wth-code)
      575       then do:
      576         FORM HEADER
      577             v-single-line format "X(124)" AT 1 SKIP
      578             "Продолжение - на следующей странице" AT 30 SKIP
      579             with FRAME BottomFrame width 235 PAGE-BOTTOM NO-LABELS NO-BOX .
      580         VIEW STREAM PrnLibStream FRAME BottomFrame .
      581         PAGE STREAM PrnLibStream.
      582       end.
      583       find first ub.wth-place
      584            where ub.wth-place.host-code = buf_c-wth-doc.host-code
      585              and ub.wth-place.obj-type  = buf_c-wth-doc.obj-type
      586              and ub.wth-place.obj-code  = buf_c-wth-doc.obj-code
      587              and ub.wth-place.w-p-code  = buf_c-wth-line.w-p-code
      588       no-error.
      589       find first buf_clients no-lock
      590           where buf_clients.obj-type = 'чел':U
      591             and buf_clients.obj-code = buf_c-wth-doc.operator
      592       .
      593       assign
      594         v-operator = buf_clients.obj-name
      595       .
      596       find first buf_clients no-lock
      597           where buf_clients.obj-type = 'чел':U
      598             and buf_clients.obj-code = buf_c-wth-doc.deliver
      599       .
      600       assign
      601         v-deliver = buf_clients.obj-name
      602       .
      603       find first buf_clients no-lock
      604           where buf_clients.obj-type = 'чел':U
      605             and buf_clients.obj-code = buf_c-wth-doc.receiver
      606       .
      607       assign
      608         v-receiver = buf_clients.obj-name
      609       .
      610       find first buf_clients no-lock
      611           where buf_clients.obj-type = buf_c-wth-doc.obj-type
      612             and buf_clients.obj-code = buf_c-wth-doc.obj-code
      613       .
      614       if buf_c-wth-doc.doc-type = 'при':U
      615       then assign
      616               v-org-from = buf_c-wth-doc.cli-name
      617               v-org-to   = buf_clients.obj-name + (if available wth-place
      618                                                       and wth-place.w-p-name <> ?
      619                                                    then ", " + wth-place.w-p-name else "")
      620       .
      621       else assign
      622               v-org-from = buf_clients.obj-name + (if available wth-place
      623                                                       and wth-place.w-p-name <> ?
      624                                                    then ", " + wth-place.w-p-name else "")
      625               v-org-to   = buf_c-wth-doc.cli-name
      626       .
      627       assign
      628           v-temp-string = "УДАЛЕННЫЙ Д О К У М Е Н Т   №  " + string(buf_c-wth-doc.doc-code)
      629       .
      630       assign v-temp-position = center-field( 5, 130, length(v-temp-string) )         v-temp-string   = fill(" ", v-temp-position - 1) + v-temp-string.
      631       put stream PrnLibStream
      632           skip
      633           buf_host.obj-name
      634           string( "Страница " + string( PAGE-NUMBER( PrnLibStream ), ">>9" ) )
      635                             format "X(12)"   at right-field(130 - 5, 12)
      636           skip
      637             buf_clients.obj-name
      638           skip(2)
      639               v-temp-string format "X(130)"
      640           skip
      641           "движения материальных ценностей"
      642                             format "X(31)"   at center-field( 5, 130, 31 )
      643           skip(2)
      644           space (5) "Смена: "
      645           buf_c-wth-doc.shift-name format "X(12)"
      646           " от "
      647           buf_c-wth-doc.shift-date format "99/99/9999"
      648       .
      649       find first ub.wealth no-lock
      650           where ub.wealth.wth-code = buf_c-wth-line.wth-code
      651       .
      652       put stream PrnLibStream
      653           skip(1)
      654           space (5) "Наименование материальных ценностей: "
      655           space(44 - 37) wealth.wth-name      format "X(65)"
      656           skip
      657           space (5) "Источник поступления: "
      658           space(44 - 22) v-org-from           format "X(65)"
      659           skip
      660           space (5) "Получатель: "
      661           space(44 - 12) v-org-to             format "X(65)"
      662           skip
      663           space (5) "Сумма движения материальных ценностей: "
      664           space(44 - 39) (if buf_c-wth-doc.status_ = 'факт':U
      665                                     then buf_c-wth-line.fact-sum
      666                                     else buf_c-wth-line.doc-sum)       format "z,zzz,zzz,zz9.99"
      667       .
      668           find first  buf_c-wth-dtl no-lock
      669               where buf_c-wth-dtl.doc-code = buf_c-wth-line.doc-code
      670                 and buf_c-wth-dtl.wth-code = buf_c-wth-line.wth-code
      671                 and buf_c-wth-dtl.corr-user-db-num = buf_c-wth-line.corr-user-db-num
      672                 and buf_c-wth-dtl.chip-num = buf_c-wth-line.chip-num
      673           no-error.
      674           if available buf_c-wth-dtl
      675           then do:
      676               put stream PrnLibStream
      677                   skip(1)
      678                   space (5) "Расшифровка суммы: "
      679               .
      680               for each ub.wth-par no-lock
      681                  where ub.wth-par.wth-code = buf_c-wth-line.wth-code
      682               break by ub.wth-par.par-feat
      683               :
      684                   find first buf_c-wth-dtl no-lock
      685                        where buf_c-wth-dtl.doc-code = buf_c-wth-line.doc-code
      686                          and buf_c-wth-dtl.wth-code = buf_c-wth-line.wth-code
      687                          and buf_c-wth-dtl.w-p-code = buf_c-wth-line.w-p-code
      688                          and buf_c-wth-dtl.par-code = ub.wth-par.par-code
      689                          and buf_c-wth-dtl.corr-user-db-num = buf_c-wth-line.corr-user-db-num
      690                          and buf_c-wth-dtl.chip-num = buf_c-wth-line.chip-num
      691                   no-error.
      692                   if first-of(ub.wth-par.par-feat)
      693                   then do:
      694                       if not first(ub.wth-par.par-feat)
      695                       then do:
      696                           put stream PrnLibStream
      697                             skip
      698                               v-single-line format "X(65)" at 40
      699                             skip(2)
      700                           .
      701                       end.
      702                       put stream PrnLibStream
      703                           skip
      704                           v-single-line format "X(65)" at 40
      705                         skip
      706                           space (5 + 15)
      707                           wth-par.par-feat format "X(15)"
      708                           "|" at 40
      709                           "Номинал" at center-field(40, 40 + 21, 7)
      710                           "|" at 40 + 21
      711                           "|" at 40 + 25
      712                           "Количество" at center-field(40 + 25, 40 + 38, 10)
      713                           "|" at 40 + 38
      714                           "|" at 40 + 42
      715                           "Сумма" at center-field(40 + 42, 40 + 64, 10)
      716                           "|" at 40 + 64
      717                       .
      718                   end.
      719                   put stream PrnLibStream
      720                     skip
      721                       "|"  at 40
      722                       v-single-line format "X(63)"
      723                       "|"
      724                     skip
      725                       "|" at 40
      726                       string(ub.wth-par.par-val, "z,zzz,zz9") + " " + string(ub.wth-par.par-unit)
      727                                           format "X(19)"
      728                       "|" at 40 + 21
      729                       "x" at center-field(40 + 21, 40 + 25, 1)
      730                       "|" at 40 + 25
      731                   .
      732                   if available buf_c-wth-dtl
      733                   then put stream PrnLibStream
      734                       buf_c-wth-dtl.doc-sum / ub.wth-par.par-rate at center-field(40 + 25, 40 + 38, 10)
      735                   .
      736                   put stream PrnLibStream
      737                       "|" at 40 + 38
      738                       "=" at center-field(40 + 38, 40 + 42, 1)
      739                       "|" at 40 + 42
      740                   .
      741                   if available buf_c-wth-dtl
      742                   then put stream PrnLibStream
      743                       buf_c-wth-dtl.doc-sum format "zzz,zzz,zz9.99" at center-field(40 + 42, 40 + 64, 15)
      744                   .
      745                   put stream PrnLibStream
      746                       "|" at 40 + 64
      747                   .
      748                   if available buf_c-wth-dtl
      749                   then accumulate
      750                     buf_c-wth-dtl.doc-sum (total)
      751                   .
      752               end.
      753               put stream PrnLibStream
      754                 skip
      755                   v-single-line format "X(65)" at 40
      756                   "Итого: " at right-field(40 + 42, 7)
      757                   space(5) (accum total buf_c-wth-dtl.doc-sum)
      758                                 format "z,zzz,zzz,zz9.99"
      759               .
      760           end.
      761       if line-counter( PrnLibStream ) + 8 > page-size( PrnLibStream )
      762       then page stream PrnLibStream.
      763       put stream PrnLibStream
      764           skip(2)
      765           space (5) "Документ составил:    "
      766           v-operator format "X(60)"
      767           "подпись _______________________________"
      768           skip(2)
      769           space (5) "ПЕРЕДАЛ          "
      770           v-deliver format "X(65)"
      771           "подпись _______________________________"
      772           skip(1)
      773           space (5) "ПОЛУЧИЛ          "
      774           v-receiver format "X(65)"
      775           "подпись _______________________________"
      776       .
      777   end.
      778   output stream PrnLibStream close.
      779   run prn-lib-prn-file in this-procedure (
      780                                             input parParentProc
      781                                             ,input 0
      782                                             ).
      783   end.
