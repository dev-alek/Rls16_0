     7029     with width 232 down stream-io no-box no-underline no-labels .
     7030   FUNCTION f-wp-qnty returns character ( input p-dec as decimal ) :
     7031     define variable pr as character no-undo .
     7032     define variable abbr as character no-undo.
     7033     run rep/wp-rub.p ( input p-dec, output Pr, output abbr).
     7034     if Pr = '' then do:
     7035        Pr = 'Ноль'.
     7036     end.
     7037     RETURN ( Pr ) .
     7038   END FUNCTION.
     7039   FUNCTION get-shift RETURNS DATE
     7040     ( BUFFER buf_fin-doc FOR ub.fin-doc, OUTPUT v-fin-doc-shift-name-num AS character)  FORWARD.
     7041   do on error undo, return error
     7042      :
     7043      if session:set-wait-state("compiler") then.
     7044   for each buf_cash-pay where buf_cash-pay.is-cash:
     7045       v-is-cash-list = v-is-cash-list + string(buf_cash-pay.cdpay-code) + ','.
     7046   end.
     7047   for each buf_obj-list
     7048     no-lock:
     7049      assign
     7050         v-obj-code = buf_obj-list.obj-code
     7051      .
     7052     for each tt-cash-desk  no-lock
     7053        where tt-cash-desk.obj-code = buf_obj-list.obj-code
     7054     break
     7055     by tt-cash-desk.db-num
     7056     by tt-cash-desk.obj-code
     7057     by tt-cash-desk.pos-type
     7058     by tt-cash-desk.cash-num
     7059       :
     7060   assign v-account = ( if integer( 25 ) = 0 then 100 else integer( 25 ) ).
     7061     if  log-manager:logfile-name ne ?
     7062     then DO:
     7063         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     7064     end.
     7065     if not session:batch-mode then
     7066     do:
     7067       VIEW FRAME InfoFrame.
     7068       mFrameView = true.
     7069     end.
     7070      v-button-stop = false .
     7071         if mFrameView
     7072         then do:
     7073         if v-button-stop then view STOPBTN in frame InfoFrame.
     7074                          else Hide STOPBTN in frame InfoFrame.
     7075         end.
     7076   define variable vss-include-info40 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7077   define variable chk-shift-open-time as logical no-undo init yes.
     7078   for each ub.inkas no-lock where ub.inkas.obj-code = tt-cash-desk.obj-code
     7079   and ub.inkas.obj-type =  'маг':U and ub.inkas.shift-date = x-date-start and ub.inkas.shift-num = x-shift-alone,
     7080    each buf_chk-doc
     7081       where buf_chk-doc.out-code    = ub.inkas.inkas-code and buf_chk-doc.pay-desk = tt-cash-desk.cash-num
     7082         no-lock use-index sale:
     7083           find first temp-str
     7084               where temp-str.cash-num = tt-cash-desk.cash-num
     7085                 no-error.
     7086             if available temp-str then do :
     7087               if buf_chk-doc.z-number > temp-str.z-number then do :
     7088                 assign temp-str.z-number = buf_chk-doc.z-number .
     7089               end.
     7090           end.
     7091             else do :
     7092           CREATE temp-str.
     7093           assign
     7094             temp-str.cash-num      = tt-cash-desk.cash-num
     7095             temp-str.z-number      = buf_chk-doc.z-number
     7096             temp-str.zero-counter  = 0
     7097             temp-str.chk-num       = buf_chk-doc.chk-num
     7098             temp-str.chk-shift-open-time = no.
     7099           for first buf_shift-cash
     7100              where buf_shift-cash.obj-type    = 'маг':U
     7101                and buf_shift-cash.obj-code    = tt-cash-desk.obj-code
     7102                and buf_shift-cash.shift-date  = x-date-start
     7103                and buf_shift-cash.shift-num   = x-shift-alone
     7104                and buf_shift-cash.cash-num    = tt-cash-desk.cash-num
     7105                :
     7106                   assign temp-str.chk-time-1 = buf_shift-cash.shift-open-time
     7107                          temp-str.chk-time-2 = buf_shift-cash.shift-close-time.
     7108                   if temp-str.chk-time-1 <> 0 then do:
     7109                       temp-str.chk-shift-open-time = yes.
     7110                   end.
     7111         end.
     7112           end.
     7113         if temp-str.chk-time-2 = 0 then do:
     7114             assign temp-str.chk-time-2 = buf_chk-doc.chk-time.
     7115         end.
     7116         if temp-str.chk-shift-open-time = no then do:
     7117             assign temp-str.chk-time-1 = buf_chk-doc.chk-time.
     7118         end.
     7119         if lookup(string(buf_chk-doc.chk-type), '1,69,14,15,16,36':U) > 0 then do :
     7120             for each buf_chk-pay no-lock where buf_chk-pay.doc-code = buf_chk-doc.doc-code:
     7121                 if lookup(string(buf_chk-pay.pay-code), v-is-cash-list) > 0 then do:
     7122                   temp-str.summ-nal = temp-str.summ-nal + buf_chk-pay.tot-rubl.
     7123                 end.
     7124                 for first buf_chk-pay-attr where buf_chk-pay-attr.doc-code = buf_chk-pay.doc-code
     7125                                                and buf_chk-pay-attr.line-num = buf_chk-pay.line-num
     7126                                                and buf_chk-pay-attr.attr-code = "autotank-sum-return" no-lock:
     7127                       temp-str.summ-nal = temp-str.summ-nal - decimal(buf_chk-pay-attr.attr-value).
     7128                   end.
     7129                 if not can-find(first buf_cash-pay-attr where buf_cash-pay-attr.cdpay-code = buf_chk-pay.pay-code
     7130                                            and buf_cash-pay-attr.curr-code = buf_chk-pay.curr-code
     7131                                            and buf_cash-pay-attr.attr-code = "kbo")
     7132                 and not can-find(first buf_cash-pay where buf_cash-pay.cdpay-code = buf_chk-pay.pay-code
     7133                                                       and buf_cash-pay.curr-code = buf_chk-pay.curr-code
     7134                                                       and buf_cash-pay.is-service-pay = yes) then do:
     7135                   temp-str.summ-sale = temp-str.summ-sale + buf_chk-pay.tot-rubl.
     7136                   for first buf_chk-pay-attr where buf_chk-pay-attr.doc-code = buf_chk-pay.doc-code
     7137                                                and buf_chk-pay-attr.line-num = buf_chk-pay.line-num
     7138                                                and buf_chk-pay-attr.attr-code = "autotank-sum-return" no-lock:
     7139                       temp-str.summ-sale = temp-str.summ-sale - decimal(buf_chk-pay-attr.attr-value).
     7140                   end.
     7141                 end.
     7142             end.
     7143         end.
     7144         if lookup(string(buf_chk-doc.chk-type), '6,96':U) > 0 then do :
     7145           for each buf_chk-pay no-lock
     7146                 where buf_chk-pay.doc-code = buf_chk-doc.doc-code :
     7147             find first buf_cash-pay-attr where  buf_cash-pay-attr.cdpay-code = buf_chk-pay.pay-code   and
     7148                                                 buf_cash-pay-attr.curr-code  = buf_chk-pay.curr-code  and
     7149                                                 buf_cash-pay-attr.attr-code  = "form_km3" no-lock no-error.
     7150             if available buf_cash-pay-attr and buf_cash-pay-attr.attr-value = "yes" then
     7151             assign
     7152                 temp-str.summ-return = temp-str.summ-return + ABS(buf_chk-pay.tot-rubl)
     7153                                       .
     7154         end.
     7155         end.
     7156         find first buf_sale-clients
     7157               where buf_sale-clients.obj-code = buf_chk-doc.cashier-psn-code
     7158                 and buf_sale-clients.obj-type = 'чел':U
     7159                 no-lock
     7160                 no-error.
     7161                 if available buf_sale-clients then do :
     7162                   assign
     7163                       temp-str.person = buf_sale-clients.obj-name
     7164            .
     7165                 end.
     7166                 else do:
     7167                       if temp-str.person begins "Продавец" then
     7168                       temp-str.person = "Продавец № " + string ( buf_chk-doc.cashier ) .
     7169                 end.
     7170   end.
     7171   find first temp-str
     7172        where temp-str.cash-num = tt-cash-desk.cash-num
     7173        no-error.
     7174        if not available temp-str then do :
     7175         find first buf_chk-doc
     7176             where buf_chk-doc.obj-type    = 'маг':U
     7177               and buf_chk-doc.obj-code    = tt-cash-desk.obj-code
     7178               and (buf_chk-doc.shift-date <= x-date-start
     7179                 or buf_chk-doc.chk-date   <= x-date-start)
     7180               and buf_chk-doc.pay-desk    = tt-cash-desk.cash-num
     7181               and buf_chk-doc.z-number    <> 0
     7182               use-index shift no-error .
     7183               if available buf_chk-doc then do :
     7184                   if X-tog-shift then do:
     7185                     if ( buf_chk-doc.shift-num >= x-shift-alone
     7186                       and buf_chk-doc.shift-date = x-date-start )
     7187                       then next.
     7188                   end.
     7189                   else do :
     7190                     if buf_chk-doc.chk-date >= x-date-start then next.
     7191                   end.
     7192                   create temp-str.
     7193                   assign
     7194                     temp-str.cash-num = tt-cash-desk.cash-num
     7195                     temp-str.z-number = buf_chk-doc.z-number
     7196                   .
     7197                end.
     7198        end.
     7199   release temp-str.
     7200       if not can-find(first temp-str where temp-str.cash-num = tt-cash-desk.cash-num) then next.
     7201       assign
     7202         sheet-list = sheet-list + (if sheet-list = '' then '' else chr(44)) + substitute("ККМ&1", tt-cash-desk.cash-num)
     7203         sheet-list-copy-from = sheet-list-copy-from + (if sheet-list-copy-from = '' then '' else chr(44)) + "Template"
     7204       .
     7205     end.
     7206   end.
     7207   find first temp-str no-error.
     7208   if not available temp-str then do:
     7209       if p-batch > 0 then do:
     7210       if p-batch > 0 then do:      run write-log-and-file in p-log-handle (                 input 1                                          , input p-log-file-name                              , input 1                                          , input "Не было чеков за выбранный период!!").    end.    else do:       run write-to-log in p-log-handle ( input "Не было чеков за выбранный период!!").    end.
     7211       run cb_write-report-error in p-parent-handle ( input p-rebh
     7212                                                     ,input p-report-id
     7213                                                     ,input ?
     7214                                                     ,input '3':U
     7215                                                     ,input "Не было чеков за выбранный период!!").
     7216       RETURN.
     7217     end.
     7218     else do:
     7219       if p-batch > 0 then do:      run write-log-and-file in p-log-handle (                 input 1                                          , input p-log-file-name                              , input 1                                          , input "Не было чеков за выбранный период!!").    end.    else do:       run write-to-log in p-log-handle ( input "Не было чеков за выбранный период!!").    end.
     7220       return.
     7221     end.
     7222   end.
     7223   output STREAM Out-Stream to value( string( session:temp-directory +
     7224                                        "rpt" + string( g#report-num ) ) )
     7225                                        page-size 62 .
     7226   for each tt-cash-desk
     7227         no-lock by tt-cash-desk.cash-num
     7228         :
     7229     if session:set-wait-state("compiler") then.
     7230       if not can-find(first temp-str where temp-str.cash-num = tt-cash-desk.cash-num) then next.
     7231       run km6xl-init in this-procedure (
     7232                                          input v-start
     7233                                         ,input substitute("ККМ&1", tt-cash-desk.cash-num)
     7234                                         ,input sheet-list
     7235                                         ,input sheet-list-copy-from
     7236                                         ).
     7237       v-start = no.
     7238      assign
     7239         UndLine = fill("_", 137)
     7240         Line    = fill("-", 137)
     7241         sum2-shift = 0
     7242         v-PrintTitul = 0
     7243         v-boss            = ""
     7244         PropisSumAll      = ""
     7245         PropisSumAll-2    = ""
     7246         v-kkm-code-reg    = ""
     7247         v-kkm-code-prod   = ""
     7248         v-kkm-model       = ""
     7249         v-kkm-type        = ""
     7250       .
     7251      FIND FIRST buf_cash-desk WHERE buf_cash-desk.cash-num = tt-cash-desk.cash-num
     7252                                 AND buf_cash-desk.db-num   = tt-cash-desk.db-num
     7253                                 AND buf_cash-desk.obj-code = tt-cash-desk.obj-code
     7254                                 AND buf_cash-desk.pos-type = tt-cash-desk.pos-type
     7255                               NO-LOCK
     7256                               NO-ERROR
     7257                               .
     7258      FIND first This_Object  WHERE This_Object.obj-type = 'маг':U
     7259                          AND This_Object.obj-code = tt-cash-desk.obj-code
     7260                        NO-LOCK.
     7261      FIND first ub.clients  WHERE ub.clients.obj-type   = 'орг':U
     7262                          AND ub.clients.obj-code     = This_Object.host-code
     7263                        NO-LOCK.
     7264      find first buf_firm where buf_firm.firm-code = ub.clients.obj-code
     7265                          no-lock
     7266                          .
     7267      assign
     7268         v-boss          = buf_firm.director
     7269         v-kkm-code-reg  = buf_cash-desk.registration-code
     7270         v-kkm-code-prod = buf_cash-desk.serial-code
     7271         v-kkm-model     = buf_cash-desk.fr-type
     7272         v-kkm-programm  = (if tt-cash-desk.pos-type = 'IBM-XML':U
     7273                            or tt-cash-desk.pos-type = 'IBM':U
     7274                           then  (if tt-cash-desk.cash-os = "LINUX"
     7275                                   then "UniFO-L V 4.0.K"
     7276                                   else "UniFO-IBS V 4.0.K" )
     7277                           else '')
     7278      .
     7279      form with frame km-frame .
     7280   assign v-account = ( if integer( 25 ) = 0 then 100 else integer( 25 ) ).
     7281     if  log-manager:logfile-name ne ?
     7282     then DO:
     7283         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     7284     end.
     7285     if not session:batch-mode then
     7286     do:
     7287       VIEW FRAME InfoFrame.
     7288       mFrameView = true.
     7289     end.
     7290      v-button-stop = false .
     7291         if mFrameView
     7292         then do:
     7293         if v-button-stop then view STOPBTN in frame InfoFrame.
     7294                          else Hide STOPBTN in frame InfoFrame.
     7295         end.
     7296      assign
     7297      v-itogo-sum = 0
     7298      v-itogo-sum-sale = 0
     7299      v-itogo-nal = 0.
     7300      for each temp-str no-lock
     7301         where temp-str.cash-num = tt-cash-desk.cash-num
     7302            by temp-str.z-number
     7303                        :
     7304      if v-PrintTitul = 0 then do:
     7305           run PrintTitul in this-procedure ( input substitute("ККМ&1", tt-cash-desk.cash-num)).
     7306         assign v-PrintTitul = 1.
     7307      end.
     7308         run print-line in this-procedure ( input substitute("ККМ&1", tt-cash-desk.cash-num)).
     7309         v-itogo-sum-sale = v-itogo-sum-sale + temp-str.summ-sale.
     7310         v-itogo-sum = v-itogo-sum + temp-str.summ-sale - temp-str.summ-return.
     7311         v-itogo-nal = v-itogo-nal + temp-str.summ-nal - temp-str.summ-return.
     7312      end.
     7313      display stream Out-Stream
     7314             "          ИТОГО" @ temp-str.summ-end
     7315             sym7 sym8 sym9
     7316             v-itogo-sum-sale @ temp-str.summ-sale
     7317             sum2-shift @ temp-str.summ-return
     7318      with FRAME km-frame.
     7319      PUT STREAM Out-Stream
     7320          "+---------------+---------------+"  AT 78 SKIP
     7321      .
     7322      run on-same-page in this-procedure (input 10) .
     7323      run PrintPodval in this-procedure ( input substitute("ККМ&1", tt-cash-desk.cash-num)).
     7324      page stream Out-Stream .
     7325   end.
     7326      output stream Out-Stream CLOSE .
     7327   if mFrameView
     7328   then do:
     7329      HIDE FRAME InfoFrame.
     7330   end.
     7331      run km6xl-close in this-procedure .
     7332      define variable disabledoptions as integer   no-undo .
     7333      define variable v-user-action   as character no-undo .
     7334      define variable v-printed       as logical   no-undo .
     7335      DisabledOptions = 7.
     7336      ReportFontNum = 7.
     7337     if p-batch > 0 then do:
     7338       run reprumpr_print-printer in this-procedure ( input ReportFontNum
     7339                                                     ,input 0
     7340                                                     ) no-error.
     7341       if error-status:error then do:
     7342               if p-batch > 0 then do:      run write-log-and-file in p-log-handle (                 input 1                                          , input p-log-file-name                              , input 1                                          , input "Печать на принтер завершилась ошибкой...").    end.    else do:       run write-to-log in p-log-handle ( input "Печать на принтер завершилась ошибкой...").    end.
     7343       end.
     7344       IF p-xls THEN DO:
     7345         if p-report-id = "73/2069" then do:
     7346           RUN reprumpr_print-xlt ( input p-dir-name
     7347                                   ,input ''
     7348                                   ,input substitute("km-6_&1&2_&3&4&5_&6.xls"
     7349                                                     , 'маг':U
     7350                                                     , v-obj-code
     7351                                                     , string(year(X-date-end), "9999")
     7352                                                     , string(month(X-date-end), "99")
     7353                                                     , string(day(X-date-end), "99")
     7354                                                     , X-shift-end)
     7355                                   ,input DisabledOptions
     7356                                   ,input ReportFontNum
     7357                                     ) .
     7358         end.
     7359         if error-status:error then do:
     7360                   if p-batch > 0 then do:      run write-log-and-file in p-log-handle (                 input 1                                          , input p-log-file-name                              , input 1                                          , input return-value).    end.    else do:       run write-to-log in p-log-handle ( input return-value).    end.
     7361         end.
     7362       END.
     7363       if p-plain-txt then do:
     7364         if p-report-id = "73/2069" then do:
     7365           run reprumpr_print-plain-text in this-procedure ( input p-dir-name
     7366                                                             ,input ''
     7367                                                             ,input substitute("km-6_&1&2_&3&4&5_&6.txt"
     7368                                                                             , 'маг':U
     7369                                                                             , v-obj-code
     7370                                                                             , string(year(X-date-end), "9999")
     7371                                                                             , string(month(X-date-end), "99")
     7372                                                                             , string(day(X-date-end), "99")
     7373                                                                             , X-shift-end)
     7374                                                             ,input DisabledOptions
     7375                                                             ,input ReportFontNum
     7376                                                             ) no-error.
     7377         end.
     7378         if error-status:error then do:
     7379                   if p-batch > 0 then do:      run write-log-and-file in p-log-handle (                 input 1                                          , input p-log-file-name                              , input 1                                          , input return-value).    end.    else do:       run write-to-log in p-log-handle ( input return-value).    end.
     7380         end.
     7381       end.
     7382     end.
     7383     else do:
     7384      os-delete value( string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )  .
     7385      os-rename
     7386        value( string( session:temp-directory ) + "$" + string( g#report-num ) + ".txl" )
     7387        value( string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )
     7388      .
     7389       run gbl/prnfilen.w
     7390           ( input  ""
     7391           , input  DisabledOptions
     7392                           , input string(session :temp-directory) + "rpt" + string( g#report-num )
     7393                           , input ReportFontNum
     7394                           , output v-user-action
     7395                           , output v-printed
     7396                           ) .
     7397      os-delete value( string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )  .
     7398     end.
     7399   end.
     7400   procedure print-line :
     7401     do on error undo, return error return-value :
     7402        define input parameter p-sheet-name as character no-undo .
     7403   define variable vss-include-info41 as character format "X(65)" no-undo
     7404   initial "@(#)$Workfile$ $Revision$".
     7405   DO:
     7406     ASSIGN
     7407       sum2-shift    = sum2-shift + temp-str.summ-return
     7408       Lines_Counter = Lines_Counter + 1
     7409     .
     7410     if line-counter( Out-Stream ) + 3 > page-size( Out-Stream )
     7411     then  PAGE STREAM Out-Stream.
     7412     display stream Out-Stream
     7413             sym1  temp-str.z-number
     7414             sym2  empty-str09-2
     7415             sym3  empty-str09-3
     7416             Sym4  temp-str.zero-counter
     7417             sym5  temp-str.summ-begin
     7418             sym6  temp-str.summ-end
     7419             sym7  temp-str.summ-sale
     7420             sym8  temp-str.summ-return
     7421             sym9  temp-str.person
     7422             sym10 empty-str09-10
     7423             sym11
     7424     with FRAME km-frame.
     7425     DOWN stream Out-Stream 1 with FRAME km-frame
     7426     .
     7427     run km6xl-write-line-data in this-procedure (
     7428           input p-sheet-name
     7429         , input temp-str.z-number
     7430         , input temp-str.summ-sale
     7431         , input temp-str.summ-return
     7432         , input temp-str.person
     7433     ).
     7434   end.
     7435     end.
     7436   end procedure.
     7437   procedure PrintTitul :
     7438   define input parameter p-sheet-name as character no-undo .
     7439   define variable v-organization  as character    no-undo.
     7440   define variable v-object        as character    no-undo.
     7441   define variable v-object-addr   as character    no-undo.
     7442   define variable v-shift-name    as character    no-undo.
     7443   do on error undo, return error return-value  :
     7444      for each thbjattr_thbj-attr :
     7445          if thbjattr_thbj-attr.prop-code = 'outprncd':U then v-outprncd  = string( thbjattr_thbj-attr.property-value-logical) .
     7446      end.
     7447       case clients.obj-type:
     7448          when 'орг':U
     7449          then do:
     7450               FIND ub.firm WHERE ub.firm.firm-code = clients.obj-code NO-LOCK .
     7451               if available ub.firm
     7452               then do:
     7453                   assign
     7454                       t-addres = ( if ub.firm.ind = 0 or ub.firm.ind = ? then "" else string( ub.firm.ind ) )
     7455                       t-addres = t-addres
     7456                           + ( if ub.firm.city = ? or trim(ub.firm.city) = ""
     7457                               then ""
     7458                               else ( (if t-addres = "" then "" else ", ") + trim( ub.firm.city ) )
     7459                             )
     7460                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 1, 50 ) ) )
     7461                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     7462                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     7463                           + ( if  ub.firm.addres2 = ? or trim(ub.firm.addres2) = "" then "" else ( ", " + trim( ub.firm.addres2 ) ) )
     7464                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 51, 50 ) ) )
     7465                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     7466                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     7467                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 101, 50 ) ) )
     7468                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     7469                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     7470                       t-phone = ub.firm.phone
     7471                       t-inn   = ub.firm.inn
     7472                       t-okpo  = ub.firm.okpo
     7473                   .
     7474               end.
     7475          end.
     7476          when 'маг':U
     7477          then do:
     7478               FIND ub.shop WHERE ub.shop.obj-code = clients.obj-code NO-LOCK .
     7479               if available ub.shop
     7480               then do:
     7481                   assign
     7482                       t-addres = ( if trim( shop.addres1 ) <> "" then ( trim( shop.addres1 ) ) else "" )
     7483                               + ( if trim( shop.addres2 ) <> "" then ( ", " + trim( shop.addres2 ) ) else "" )
     7484                       t-phone = shop.phone
     7485                       t-inn = ""
     7486                       t-okpo = ""
     7487                   .
     7488               end.
     7489          end.
     7490          when 'скл':U
     7491          then do:
     7492               FIND ub.store WHERE ub.store.obj-code = clients.obj-code NO-LOCK .
     7493               if available ub.store
     7494               then do:
     7495                   assign
     7496                       t-addres = ( if trim( ub.store.addres1 ) <> "" then ( trim( ub.store.addres1 ) ) else "" )
     7497                               + ( if trim( ub.store.addres2 ) <> "" then ( ", " + trim( ub.store.addres2 ) ) else "" )
     7498                       t-phone = ub.store.phone
     7499                       t-inn = ""
     7500                       t-okpo = ""
     7501                   .
     7502               end.
     7503          end.
     7504          when 'чел':U
     7505          then do:
     7506               find ub.person where ub.person.psn-code = clients.obj-code no-lock .
     7507               if available ub.person
     7508               then do:
     7509                   assign
     7510                       t-addres = ( if ub.person.ind <> 0 and ub.person.ind <> ? then string( ub.person.ind ) else "" )
     7511                                   + ( if  ub.person.city <> ? and trim(ub.person.city) <> "" then ( ", " + trim( ub.person.city ) ) else "" )
     7512                                   + ( if  ub.person.address <> ? and trim(ub.person.address) <> "" then ( ", " + trim( ub.person.address ) ) else "" )
     7513                       t-phone = ub.person.phone1
     7514                       t-inn = ub.person.inn
     7515                       t-okpo = ub.person.okpo
     7516                   .
     7517               end.
     7518          end.
     7519       end case.
     7520     Case This_Object.obj-type :
     7521       when 'маг':U then do:
     7522         find first ub.shop
     7523         where ub.shop.obj-code = This_Object.obj-code
     7524           no-error.
     7525           if available ub.shop then do:
     7526             assign v-object-addr = ub.shop.addres1.
     7527           end.
     7528       end.
     7529       when 'скл':U then do:
     7530         find first ub.store
     7531         where ub.store.obj-code = This_Object.obj-code
     7532           no-error.
     7533           if available ub.store then do:
     7534             assign v-object-addr = ub.store.addres1.
     7535           end.
     7536       end.
     7537     end case.
     7538     if x-tog-shift then do:
     7539       assign v-shift-name = substitute("№&1 от &2", string(x-shift-alone), string(x-date-start)) .
     7540     end.
     7541     if v-outprncd = "yes" then
     7542     do:
     7543      assign
     7544         v-organization = string( CAPS( ub.clients.obj-name )  + " (" + string(ub.clients.obj-code) + ") " ) + t-addres + " " + t-phone
     7545         v-object       = string( CAPS( This_Object.obj-name ) + " (" + string(This_Object.obj-code) + ") " ) + v-object-addr
     7546      .
     7547     end.
     7548     else do:
     7549       assign
     7550         v-organization = string( CAPS( ub.clients.obj-name ) ) + " " + t-addres + " " + t-phone
     7551         v-object       = string( CAPS( This_Object.obj-name ) ) + " " + v-object-addr
     7552       .
     7553     end.
     7554      assign
     7555          v-kkm-num = "(" + trim(string(temp-str.cash-num)) + ")"
     7556      .
     7557      v-ii = num-entries(v-organization, " ") + 1.
     7558      if v-ii = 1 then
     7559      do:
     7560        v-txt-1 = v-organization.
     7561      end.
     7562      else
     7563      do:
     7564        if length(v-organization) > 78 then
     7565        do:
     7566          do v-i = 1 to v-ii + 1:
     7567            v-txt-1 = v-txt-1 + (if v-txt-1 = "" then "" else " ") + entry(v-i, v-organization, " ").
     7568            if length(v-txt-1) + 1 + length(entry((v-i + 1), v-organization, " ")) > 78 then
     7569            do:
     7570              leave.
     7571            end.
     7572          end.
     7573          v-txt-2 = substring(v-organization, length(v-txt-1) + 2).
     7574        end.
     7575        else
     7576          do:
     7577            v-txt-1 = v-organization.
     7578          end.
     7579      end.
     7580      run km6xl-write-cell-data in this-procedure (
     7581          input substitute("&1_&2"
     7582                          , p-sheet-name
     7583                          , "h_organization":U
     7584                          )
     7585          , input  v-txt-1
     7586      ).
     7587      run km6xl-write-cell-data in this-procedure (
     7588          input substitute("&1_&2"
     7589                          , p-sheet-name
     7590                          , "h_organization2":U
     7591                          )
     7592          , input v-txt-2
     7593      ).
     7594      v-txt-1 = "".
     7595      v-txt-2 = "".
     7596      run km6xl-write-cell-data in this-procedure (
     7597          input substitute("&1_&2"
     7598                          , p-sheet-name
     7599                          , "h_object":U
     7600                          )
     7601          , input v-object
     7602      ).
     7603      run km6xl-write-cell-data in this-procedure (
     7604          input substitute("&1_&2"
     7605                          , p-sheet-name
     7606                          , "h_DocDate":U
     7607                          )
     7608          , input string(x-date-start, "99/99/9999")
     7609      ).
     7610      run km6xl-write-cell-data in this-procedure (
     7611          input substitute("&1_&2"
     7612                          , p-sheet-name
     7613                          , "h_DocTime1":U
     7614                          )
     7615          , input string( temp-str.chk-time-1, "HH:MM:SS")
     7616      ).
     7617      run km6xl-write-cell-data in this-procedure (
     7618          input substitute("&1_&2"
     7619                          , p-sheet-name
     7620                          , "h_DocTime2":U
     7621                          )
     7622          , input string( temp-str.chk-time-2, "HH:MM:SS")
     7623      ).
     7624      run km6xl-write-cell-data in this-procedure (
     7625          input substitute("&1_&2"
     7626                          , p-sheet-name
     7627                          , "h_deskname":U
     7628                          )
     7629          , input SUBSTITUTE((if v-kkm-model = "" then "&2"
     7630                                                  else "&1, &2"),
     7631                             v-kkm-model, v-kkm-num)
     7632      ).
     7633      run km6xl-write-cell-data in this-procedure (
     7634          input substitute("&1_&2"
     7635                          , p-sheet-name
     7636                          , "h_KKM_prog":U
     7637                          )
     7638          , input v-kkm-programm
     7639      ).
     7640      run km6xl-write-cell-data in this-procedure (
     7641          input substitute("&1_&2"
     7642                          , p-sheet-name
     7643                          , "h_KKM_reg":U
     7644                          )
     7645          , input v-kkm-code-reg
     7646      ).
     7647      run km6xl-write-cell-data in this-procedure (
     7648          input substitute("&1_&2"
     7649                          , p-sheet-name
     7650                          , "h_KKM_prod":U
     7651                          )
     7652          , input v-kkm-code-prod
     7653      ).
     7654      run km6xl-write-cell-data in this-procedure (
     7655          input substitute("&1_&2"
     7656                          , p-sheet-name
     7657                          , "h_OKPO":U
     7658                          )
     7659          , input t-okpo
     7660      ).
     7661      run km6xl-write-cell-data in this-procedure (
     7662          input substitute("&1_&2"
     7663                          , p-sheet-name
     7664                          , "h_INN":U
     7665                          )
     7666          , input t-inn
     7667      ).
     7668      run km6xl-write-cell-data in this-procedure (
     7669          input substitute("&1_&2"
     7670                          , p-sheet-name
     7671                          , "h_shift":U
     7672                          )
     7673          , input v-shift-name
     7674      ).
     7675      PUT STREAM Out-Stream
     7676                                                                                         "Унифицированная форма N КМ-6"              AT 100 skip
     7677                                                                                         "Утверждена постановлением Госкомстата"     AT 100 skip
     7678                                                                                         "России от 25.12.98 г. N 132      "         AT 100 skip
     7679                                                                                                            "+----------------+"     AT 120 skip
     7680                                                                                                            "|      Код       |"     AT 120 skip
     7681                                                                                                            "+----------------+"     AT 120 skip
     7682                                                                                               "Форма по ОКУД|     0330106    |"     AT 107 skip
     7683          space(5) v-organization format "X(100)"                                                           "+----------------+"     AT 120 skip
     7684          space(5) UndLine      format "X(100)" "по ОКРО" format "X(7)" AT 113 "|" AT 120 t-okpo format "X(16)" "|" AT 137 skip
     7685          space(35) "организация, адрес, номер телефона" format "X(80)"                                     "+----------------+"     AT 120 skip
     7686          space(5) v-object format "X(100)" "ИНН| " AT 117                                t-INN format "X(15)"  "|" AT 137 skip
     7687          space(5) UndLine format  "X(80)"                                                                  "+----------------+"     AT 120 skip
     7688          space(35) "структурное подразделение" format "x(45)"                                              "|                |"     AT 120 skip
     7689                                                                                                            "+----------------+"     AT 120 skip
     7690                                                                          "Вид деятельности по ОКДП"  AT 96 "| "      AT 120 "|"     AT 137 skip
     7691                                                                        "+----------------+----------------+"                        AT 103 skip
     7692         "Контрольно-кассовая машина " v-kkm-model v-kkm-num
     7693                                                                  "Номер | производителя  |"     AT 97 v-kkm-code-prod format "x(16)" "|"  skip
     7694                                                                        "+----------------+----------------+"                        AT 103 skip
     7695          substitute("Прикладная программа___&1&2", v-kkm-programm, fill("_", 32 - length(v-kkm-programm) )) format "X(55)"
     7696                                                                        "| регистрационный|"     AT 103 v-kkm-code-reg format "x(16)" "|"   skip
     7697                                                                        "+----------------+----------------+"                        AT 103 skip
     7698                                                                                                      "Кассир|                |"     AT 114 skip
     7699                                                                                                            "+----------------+"     AT 120 skip
     7700                                                                                 "Смена|" AT 115 v-shift-name format "X(16)" "|"            skip
     7701                                                                                                            "+----------------+"     AT 120 skip
     7702                                                                                                "Вид операции|                |"     AT 108 skip
     7703                                                                                                            "+----------------+"     AT 120 skip
     7704                                                                        "+-------------+----------------+-------------------------+" AT 80  skip
     7705                                                                        "|    Номер    |      Дата      |   Время работы, ч. мин  |" AT 80  skip
     7706                                                                        "|  документа  |   составления  |      с     |     по     |" AT 80  skip
     7707                                                                        "+-------------+----------------+------------+------------+" AT 80  skip
     7708    space(54) "СПРАВКА-ОТЧЕТ"                              "|" AT 80 "|" AT 94 x-date-start AT 98 "|" AT 111 STRING(temp-str.chk-time-1,"HH:MM:SS") AT 114
     7709                                                                                                  "|" AT 124 STRING(temp-str.chk-time-2,"HH:MM:SS") AT 127
     7710                                                                                                                                 "|" AT 137 skip
     7711    space(49) "КАССИРА-ОПЕРАЦИОНИСТА"                                   "+-------------+----------------+------------+------------+" AT 80  skip
     7712      .
     7713   END.
     7714   end procedure.
     7715   procedure PrintPodval :
     7716   do on error undo, return error return-value  :
     7717      define input parameter p-sheet-name AS character no-undo .
     7718      define variable mCashBook as class ibs.th.ref.cashbookstorage no-undo .
     7719      define variable o-head-position     AS character no-undo.
     7720      define variable o-director          AS character no-undo.
     7721      define variable v-head-position     AS character no-undo.
     7722      define variable v-director          AS character no-undo.
     7723      define variable o-cassir            AS integer no-undo.
     7724      define variable v-cassir            AS character no-undo.
     7725      define variable o-cassir-op         AS integer no-undo.
     7726      define variable v-cassir-op         AS character no-undo.
     7727      define buffer   buf_shop            FOR ub.shop.
     7728      define buffer   buf_store           FOR ub.store.
     7729      define buffer   buf_thbj-attr       FOR ub.thbj-attr.
     7730      define buffer   buf_sysconf         FOR ub.sysconf.
     7731      define buffer   buf_shift-staff     FOR ub.shift-staff.
     7732       for first buf_shift-staff
     7733       where buf_shift-staff.obj-type    = 'маг':U
     7734         and buf_shift-staff.obj-code    = This_Object.obj-code
     7735         and buf_shift-staff.shift-date  = x-date-start
     7736         and buf_shift-staff.shift-num   = x-shift-alone
     7737         and buf_shift-staff.staff-role  = yes
     7738       :
     7739           v-cassir = buf_shift-staff.name.
     7740       end.
     7741       if v-cassir = ""
     7742       then do:
     7743          for first buf_shift-staff
     7744          where buf_shift-staff.obj-type    = 'маг':U
     7745          and buf_shift-staff.obj-code    = This_Object.obj-code
     7746          and buf_shift-staff.shift-date  = x-date-start
     7747          and buf_shift-staff.shift-num   = x-shift-alone
     7748          and buf_shift-staff.staff-role  = no
     7749          :
     7750              v-cassir = buf_shift-staff.name.
     7751          end.
     7752       end.
     7753       for last buf_shift-staff
     7754          where buf_shift-staff.obj-type    = 'маг':U
     7755          and buf_shift-staff.obj-code    = This_Object.obj-code
     7756          and buf_shift-staff.shift-date  = x-date-start
     7757          and buf_shift-staff.shift-num   = x-shift-alone
     7758          and buf_shift-staff.staff-role  = no
     7759          :
     7760             v-cassir-op = buf_shift-staff.name.
     7761       end.
     7762       if v-cassir = v-cassir-op then v-cassir-op = "".
     7763         run km6xl-write-cell-data in this-procedure (
     7764               input substitute("&1_&2"
     7765                          , p-sheet-name
     7766                          , "f_cashier":U
     7767                          )
     7768          , input v-cassir-op
     7769      ).
     7770         run km6xl-write-cell-data in this-procedure (
     7771               input substitute("&1_&2"
     7772                          , p-sheet-name
     7773                          , "f_senior_cashier":U
     7774                          )
     7775          , input v-cassir
     7776      ).
     7777      run km6xl-write-cell-data in this-procedure (
     7778            input substitute("&1_&2"
     7779                          , p-sheet-name
     7780                          , "it_Summ":U
     7781                          )
     7782          , input v-itogo-sum-sale
     7783      ).
     7784      run km6xl-write-cell-data in this-procedure (
     7785            input substitute("&1_&2"
     7786                          , p-sheet-name
     7787                          , "it_Summ_return":U
     7788                          )
     7789          , input sum2-shift
     7790      ).
     7791      assign v-pko-num = "" .
     7792       run fostatok in this-procedure (
     7793            input   This_Object.host-code
     7794           ,input   This_Object.obj-code
     7795           ,input   This_Object.obj-type
     7796           ,input   x-tog-shift
     7797           ,input   x-date-start - 1
     7798           ,input   date('')
     7799           ,input   X-shift-alone
     7800           ,input   X-shift-alone
     7801           ,input   yes
     7802           ,input   0
     7803           ,input   0
     7804           ,output  v-sum-begin
     7805           ,output  Fact-order-1)
     7806           no-error .
     7807       run fostatok in this-procedure (
     7808            input   This_Object.host-code
     7809           ,input   This_Object.obj-code
     7810           ,input   This_Object.obj-type
     7811           ,input   x-tog-shift
     7812           ,input   x-date-start
     7813           ,input   x-date-start
     7814           ,input   X-shift-alone
     7815           ,input   X-shift-alone
     7816           ,input   yes
     7817           ,input   0
     7818           ,input   0
     7819           ,output  v-sum-end
     7820           ,output  Fact-order-2)
     7821           no-error .
     7822           for each buf_arh-fin-doc-schet-nal-obj no-lock
     7823           where buf_arh-fin-doc-schet-nal-obj.host-code         = This_Object.host-code
     7824             and buf_arh-fin-doc-schet-nal-obj.obj-type          = This_Object.obj-type
     7825             and buf_arh-fin-doc-schet-nal-obj.obj-code          = This_Object.obj-code
     7826             and buf_arh-fin-doc-schet-nal-obj.cli-type          = 'орг':U
     7827             and buf_arh-fin-doc-schet-nal-obj.cli-code          = This_Object.host-code
     7828             and buf_arh-fin-doc-schet-nal-obj.fin-code-acc      = 0
     7829             and buf_arh-fin-doc-schet-nal-obj.curr-code         = 0
     7830             and buf_arh-fin-doc-schet-nal-obj.fin-ext-doc-type  = "":U
     7831             and buf_arh-fin-doc-schet-nal-obj.calc-curr-code    = 0
     7832             and buf_arh-fin-doc-schet-nal-obj.sum-type          = (if x-tog-shift then 'shift-obj':U else 'obj':U )
     7833             and buf_arh-fin-doc-schet-nal-obj.fact-order       > fact-order-1
     7834             and buf_arh-fin-doc-schet-nal-obj.fact-order       <= fact-order-2
     7835             and x-date-start = ( if x-tog-shift then buf_arh-fin-doc-schet-nal-obj.shift-date else buf_arh-fin-doc-schet-nal-obj.fact-date )
     7836              use-index pi :
     7837             find first buf_fin-doc
     7838                     where buf_fin-doc.host-code         = This_Object.host-code
     7839                       and buf_fin-doc.fin-doc-code      = buf_arh-fin-doc-schet-nal-obj.fin-doc-code
     7840                       and buf_fin-doc.obj-type          = This_Object.obj-type
     7841                       and buf_fin-doc.obj-code          = This_Object.obj-code
     7842                       and buf_fin-doc.status_           = 'факт':U
     7843                       and buf_fin-doc.fin-ext-doc-type = 'пко':U
     7844                     no-error.
     7845                     if available buf_fin-doc then do :
     7846                       mCashBook = new ibs.th.ref.cashbookstorage () .
     7847                       o-head-position = mCashBook:getSinglRule(buf_fin-doc.CashBookId, buf_fin-doc.obj-type, buf_fin-doc.obj-code, "ManagerPosition") .
     7848                       o-director      = mCashBook:getSinglRule(buf_fin-doc.CashBookId, buf_fin-doc.obj-type, buf_fin-doc.obj-code, "ManagerFIO") .
     7849                       delete object mCashBook no-error .
     7850                       case o-head-position:
     7851                         when '0':U then do:
     7852                           for first buf_sysconf no-lock where buf_sysconf.host-code = This_Object.host-code :
     7853                             v-head-position = buf_sysconf.head-position.
     7854                           end.
     7855                         end.
     7856                         when '1':U then do:
     7857                           v-head-position = "Директор" .
     7858                         end.
     7859                         otherwise do :
     7860                           v-head-position = "Управляющий" .
     7861                         end.
     7862                       end case.
     7863                       case o-director:
     7864                         when '1':U then do:
     7865                           if This_Object.obj-type = 'маг':U then do:
     7866                             find first buf_shop no-lock where
     7867                                       buf_shop.obj-code = This_Object.obj-code no-error .
     7868                             if available buf_shop then do:
     7869                               v-director = buf_shop.director.
     7870                             end.
     7871                           end.
     7872                           if This_Object.obj-type = 'скл':U then do:
     7873                             find first buf_store no-lock where
     7874                                       buf_store.obj-code = This_Object.obj-code no-error .
     7875                             if available buf_store then do:
     7876                               v-director = buf_store.store-boss.
     7877                             end.
     7878                           end.
     7879                         end.
     7880                         when '0':U then do:
     7881                           v-director = buf_firm.director.
     7882                         end .
     7883                       end case.
     7884                       find first buf_sysconf no-lock
     7885                             where buf_sysconf.host-code = This_Object.host-code
     7886                             no-error.
     7887                         if available buf_sysconf
     7888                         and buf_fin-doc.payer-type = buf_sysconf.sale-type
     7889                         and buf_fin-doc.payer-code = buf_sysconf.sale-code
     7890                         then do:
     7891                         if v-pko-num = "" then
     7892                         do :
     7893                           assign
     7894                             v-pko-num = buf_fin-doc.prn-doc-code .
     7895                         end.
     7896                         else
     7897                         do :
     7898                           assign
     7899                             v-pko-num = v-pko-num + "," + buf_fin-doc.prn-doc-code .
     7900                         end.
     7901                             v-pko-date = get-shift(BUFFER buf_fin-doc, OUTPUT v-fin-doc-shift-name-num) .
     7902                       end.
     7903                     end.
     7904       end.
     7905      PUT STREAM Out-Stream
     7906          "Итого выручка в сумме " f-wp-qnty(v-itogo-nal) format "X(82)"  skip
     7907          "Принята и оприходована по кассе," SKIP
     7908          'по приходному кассовому ордеру № __' substitute("___&1&2", v-pko-num, fill("_", 32 - length(v-pko-num) )) format "X(35)"
     7909      .
     7910      run km6xl-write-cell-data in this-procedure (
     7911               input substitute("&1_&2"
     7912                          , p-sheet-name
     7913                          , "f_post":U
     7914                          )
     7915          , input v-head-position
     7916      ).
     7917            run km6xl-write-cell-data in this-procedure (
     7918               input substitute("&1_&2"
     7919                          , p-sheet-name
     7920                          , "f_boss":U
     7921                          )
     7922          , input v-director
     7923      ).
     7924      run km6xl-write-cell-data in this-procedure (
     7925            input substitute("&1_&2"
     7926                          , p-sheet-name
     7927                          , "it_s_Summ_1":U
     7928                          )
     7929          , input f-wp-qnty(v-itogo-nal)
     7930      ).
     7931      if v-pko-date <> ? then do :
     7932         PUT STREAM Out-Stream
     7933             ' от "' string(Day(v-pko-date)) format "x(2)" '" '
     7934             substitute("__&1&2", MonthNameRusGen(Month(v-pko-date)), fill("_", 9 - length(string(MonthNameRusGen(Month(v-pko-date)))) )) format "x(11)" ' '
     7935             string(Year(v-pko-date)) format "x(4)" ' г.' skip
     7936         .
     7937         run km6xl-write-cell-data in this-procedure (
     7938               input substitute("&1_&2"
     7939                             , p-sheet-name
     7940                             , "f_day_date":U
     7941                             )
     7942             , input Day(v-pko-date)
     7943         ).
     7944         run km6xl-write-cell-data in this-procedure (
     7945               input substitute("&1_&2"
     7946                             , p-sheet-name
     7947                             , "f_month_date":U
     7948                             )
     7949             , input MonthNameRusGen(Month(v-pko-date))
     7950         ).
     7951         run km6xl-write-cell-data in this-procedure (
     7952               input substitute("&1_&2"
     7953                             , p-sheet-name
     7954                             , "f_year_date":U
     7955                             )
     7956             , input Year(v-pko-date)
     7957         ).
     7958      end.
     7959      else do :
     7960         PUT STREAM Out-Stream
     7961             ' от ' '"___"___________ _______ г.' SKIP
     7962             .
     7963      end.
     7964   if v-head-position = "" then v-head-position = UndLine.
     7965   if v-director      = "" then v-director      = UndLine.
     7966   if v-cassir        = "" then v-cassir        = UndLine.
     7967   if v-cassir-op     = "" then v-cassir-op     = UndLine.
     7968      PUT STREAM Out-Stream
     7969          "Сдана в банк ________________________________________________________________________________" SKIP
     7970          '___________________________________________________________________ "___"___________ _______ ' SKIP
     7971          'Квитанция №__________________ от "___"___________ _______ г.' SKIP
     7972          "" SKIP
     7973          space(5) "Старший кассир"
     7974                                               UndLine format "X(20)" AT 39 v-cassir format "X(35)" AT 70 skip
     7975                                               "(подпись)" format "X(25)" AT 44 "(расшифровка подписи)" format "X(25)" AT 73 skip
     7976          space(5) "Кассир-операционист"
     7977                                               UndLine format "X(20)" AT 39 v-cassir-op format "X(35)" AT 70 skip
     7978                                               "(подпись)" format "X(20)" AT 44 "(расшифровка подписи)" format "X(25)" AT 73 skip
     7979          space(5) "Руководитель"
     7980          v-head-position format "X(15)" AT 21 UndLine format "X(20)" AT 39 v-director format "X(35)" AT 70 skip
     7981          "(должность)" format "X(15)" AT 21   "(подпись)" format "X(20)" AT 44 "(расшифровка подписи)" format "X(25)" AT 73 skip
     7982      .
     7983      run km6xl-write-cell-data in this-procedure (
     7984            input substitute("&1_&2"
     7985                          , p-sheet-name
     7986                          , "f_pko_num":U
     7987                          )
     7988          , input v-pko-num
     7989      ).
     7990   end.
     7991   end procedure.
     7992   FUNCTION get-shift RETURNS DATE
     7993     ( BUFFER buf_fin-doc FOR ub.fin-doc, OUTPUT p-shift-name-num AS CHARACTER) :
     7994   define variable v-fin-doc-shift-name-num as character no-undo.
     7995   define variable v-fin-doc-shift-name as character no-undo .
     7996   IF buf_fin-doc.shift-date = ? THEN DO:
     7997      RETURN ?.
     7998   END.
     7999   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_shiftnam in g#lib-trn3
     8000     (
     8001        input buf_fin-doc.obj-type
     8002     ,  input buf_fin-doc.obj-code
     8003     ,  input buf_fin-doc.shift-date
     8004     ,  input buf_fin-doc.shift-num
     8005     , output v-fin-doc-shift-name
     8006     , output v-fin-doc-shift-name-num
     8007     )        no-error .
     8008   ASSIGN
     8009   p-shift-name-num = v-fin-doc-shift-name-num
     8010    .
     8011   RETURN buf_fin-doc.shift-date.
     8012   END FUNCTION.
     8013   PROCEDURE on-same-page :
     8014     define input parameter p-line-number as integer  no-undo .
     8015     if p-line-number > page-size( Out-Stream ) then return .
     8016     if line-counter( Out-Stream ) + p-line-number > page-size( Out-Stream ) then  page stream Out-Stream .
     8017   end procedure.
