     2806   procedure torgconf-get-sup-param :
     2807   define input parameter p-obj-type           as character        no-undo.
     2808   define input parameter p-obj-code           as integer          no-undo.
     2809   define input parameter p-curr-code          as integer          no-undo.
     2810       define variable v-host-code    as integer      no-undo.
     2811       define variable v-par-type     as character    no-undo.
     2812   do
     2813   on error undo, return error
     2814   :
     2815       assign
     2816          v-torgconf-sup-host-code = v-host-code
     2817       .
     2818       if v-torgconf-sup-host-code = 0
     2819       then do:
     2820           assign
     2821               v-torgconf-sup-host-name           = "":U
     2822               v-torgconf-sup-host-addres         = "":U
     2823               v-torgconf-sup-host-post-addres    = "":U
     2824               v-torgconf-sup-host-phone          = "":U
     2825               v-torgconf-sup-host-inn            = "":U
     2826               v-torgconf-sup-host-kpp            = "":U
     2827               v-torgconf-sup-host-okpo           = "":U
     2828               v-torgconf-sup-host-egrip-date     = "":U
     2829               v-torgconf-sup-host-egrip-num      = "":U
     2830           .
     2831       end.
     2832       else do:
     2833           run fmtcli-get-client in this-procedure (
     2834                 input 'орг':U
     2835               , input v-torgconf-sup-host-code
     2836           ).
     2837           assign
     2838               v-torgconf-sup-host-name        = v-fmtcli-name
     2839               v-torgconf-sup-host-engl-name   = v-fmtcli-engl-name
     2840               v-torgconf-sup-host-addres      = v-fmtcli-full-addres
     2841               v-torgconf-sup-host-post-addres = v-fmtcli-post-addres
     2842               v-torgconf-sup-host-phone       = v-fmtcli-phone
     2843               v-torgconf-sup-host-inn         = v-fmtcli-inn
     2844               v-torgconf-sup-host-kpp         = v-fmtcli-kpp
     2845               v-torgconf-sup-host-okpo        = v-fmtcli-okpo
     2846           .
     2847           run gbl/clntat-v.p (
     2848                 input 'орг':U
     2849               , input v-torgconf-sup-host-code
     2850               , input 'egrip-date':U
     2851               , output v-torgconf-sup-host-egrip-date
     2852               , output v-par-type
     2853           ).
     2854           run gbl/clntat-v.p (
     2855                 input 'орг':U
     2856               , input v-torgconf-sup-host-code
     2857               , input 'egrip-num':U
     2858               , output v-torgconf-sup-host-egrip-num
     2859               , output v-par-type
     2860           ).
     2861           run fmtcli-get-bank in this-procedure (
     2862                 input v-host-code
     2863               , input 'орг':U
     2864               , input v-torgconf-sup-host-code
     2865               , input p-curr-code
     2866           ).
     2867       end.
     2868       assign
     2869           v-torgconf-sup-schet-exists = v-fmtcli-schet-exists
     2870           v-torgconf-sup-bank-exists  = v-fmtcli-bank-exists
     2871           v-torgconf-sup-bank-r-schet = v-fmtcli-bank-r-schet
     2872           v-torgconf-sup-bank-c-schet = v-fmtcli-bank-c-schet
     2873           v-torgconf-sup-bank-bik     = v-fmtcli-bank-bik
     2874           v-torgconf-sup-bank-name    = v-fmtcli-bank-name
     2875           v-torgconf-sup-bank-addres  = v-fmtcli-bank-addres
     2876           v-torgconf-sup-bank-city    = v-fmtcli-bank-city
     2877       .
     2878       assign
     2879           v-torgconf-sup-obj-type = p-obj-type
     2880           v-torgconf-sup-obj-code = p-obj-code
     2881       .
     2882       if trim(p-obj-type) <> ""
     2883       and p-obj-code <> 0
     2884       then do:
     2885       run fmtcli-get-client in this-procedure (
     2886             input p-obj-type
     2887           , input p-obj-code
     2888       ).
     2889       assign
     2890           v-torgconf-sup-obj-name        = v-fmtcli-name
     2891           v-torgconf-sup-obj-engl-name   = v-fmtcli-engl-name
     2892           v-torgconf-sup-obj-addres      = v-fmtcli-full-addres
     2893           v-torgconf-temp-post-addres    = v-fmtcli-post-addres
     2894           v-torgconf-sup-obj-phone       = v-fmtcli-phone
     2895           v-torgconf-sup-obj-inn         = v-fmtcli-inn
     2896           v-torgconf-sup-obj-okpo        = v-fmtcli-okpo
     2897       .
     2898      end.
     2899      end.
     2900   end procedure.
     2901   procedure torgconf-get-cli-param :
     2902   define input parameter p-host-obj-code      as integer          no-undo.
     2903   define input parameter p-obj-type           as character        no-undo.
     2904   define input parameter p-obj-code           as integer          no-undo.
     2905   define input parameter p-curr-code          as integer          no-undo.
     2906       define variable v-host-code    as integer      no-undo.
     2907   do
     2908   on error undo, return error
     2909   :
     2910       assign
     2911           v-torgconf-cli-type = p-obj-type
     2912           v-torgconf-cli-code = p-obj-code
     2913       .
     2914       run fmtcli-get-client in this-procedure (
     2915             input p-obj-type
     2916           , input p-obj-code
     2917       ).
     2918       assign
     2919           v-torgconf-cli-name         = trim( v-fmtcli-name          )
     2920           v-torgconf-cli-engl-name    = trim( v-fmtcli-engl-name          )
     2921           v-torgconf-cli-addres       = trim( v-fmtcli-full-addres   )
     2922           v-torgconf-cli-post-addres  = trim( v-fmtcli-post-addres   )
     2923           v-torgconf-cli-phone        = trim( v-fmtcli-phone         )
     2924           v-torgconf-cli-inn          = trim( v-fmtcli-inn           )
     2925           v-torgconf-cli-kpp          = trim( v-fmtcli-kpp           )
     2926           v-torgconf-cli-okpo         = trim( v-fmtcli-okpo          )
     2927       .
     2928      run fmtcli-get-bank in this-procedure (
     2929             input p-host-obj-code
     2930           , input p-obj-type
     2931           , input p-obj-code
     2932           , input p-curr-code
     2933       ).
     2934       assign
     2935           v-torgconf-cli-schet-exists = v-fmtcli-schet-exists
     2936           v-torgconf-cli-bank-exists  = v-fmtcli-bank-exists
     2937           v-torgconf-cli-bank-r-schet = v-fmtcli-bank-r-schet
     2938           v-torgconf-cli-bank-c-schet = v-fmtcli-bank-c-schet
     2939           v-torgconf-cli-bank-bik     = v-fmtcli-bank-bik
     2940           v-torgconf-cli-bank-name    = v-fmtcli-bank-name
     2941           v-torgconf-cli-bank-addres  = v-fmtcli-bank-addres
     2942           v-torgconf-cli-bank-city    = v-fmtcli-bank-city
     2943       .
     2944   end.
     2945   end procedure.
     2946   procedure torgconf-get-ship-param :
     2947   define input parameter p-host-obj-code      as integer          no-undo.
     2948   define input parameter p-obj-type           as character        no-undo.
     2949   define input parameter p-obj-code           as integer          no-undo.
     2950   define input parameter p-curr-code          as integer          no-undo.
     2951       define variable v-host-code    as integer      no-undo.
     2952   do
     2953   on error undo, return error
     2954   :
     2955       assign
     2956           v-torgconf-ship-type = p-obj-type
     2957           v-torgconf-ship-code = p-obj-code
     2958       .
     2959       if trim(p-obj-type) = ""
     2960       and p-obj-code = 0
     2961       then do:
     2962       assign
     2963           v-torgconf-ship-name         = "":U
     2964           v-torgconf-ship-addres       = "":U
     2965           v-torgconf-ship-post-addres  = "":U
     2966           v-torgconf-ship-phone        = "":U
     2967           v-torgconf-ship-inn          = "":U
     2968           v-torgconf-ship-kpp          = "":U
     2969           v-torgconf-ship-okpo         = "":U
     2970       .
     2971       end.
     2972       else do:
     2973       run fmtcli-get-client in this-procedure (
     2974             input p-obj-type
     2975           , input p-obj-code
     2976       ).
     2977       assign
     2978           v-torgconf-ship-name         = trim( v-fmtcli-name          )
     2979           v-torgconf-ship-engl-name    = trim( v-fmtcli-engl-name          )
     2980           v-torgconf-ship-addres       = trim( v-fmtcli-full-addres   )
     2981           v-torgconf-ship-post-addres  = trim( v-fmtcli-post-addres   )
     2982           v-torgconf-ship-phone        = trim( v-fmtcli-phone         )
     2983           v-torgconf-ship-inn          = trim( v-fmtcli-inn           )
     2984           v-torgconf-ship-kpp          = trim( v-fmtcli-kpp           )
     2985           v-torgconf-ship-okpo         = trim( v-fmtcli-okpo          )
     2986       .
     2987       end.
     2988           run fmtcli-get-bank in this-procedure (
     2989             input p-host-obj-code
     2990           , input p-obj-type
     2991           , input p-obj-code
     2992           , input p-curr-code
     2993       ).
     2994       assign
     2995           v-torgconf-ship-schet-exists = v-fmtcli-schet-exists
     2996           v-torgconf-ship-bank-exists  = v-fmtcli-bank-exists
     2997           v-torgconf-ship-bank-r-schet = v-fmtcli-bank-r-schet
     2998           v-torgconf-ship-bank-c-schet = v-fmtcli-bank-c-schet
     2999           v-torgconf-ship-bank-bik     = v-fmtcli-bank-bik
     3000           v-torgconf-ship-bank-name    = v-fmtcli-bank-name
     3001           v-torgconf-ship-bank-addres  = v-fmtcli-bank-addres
     3002           v-torgconf-ship-bank-city    = v-fmtcli-bank-city
     3003       .
     3004   end.
     3005   end procedure.
     3006   procedure torgconf-get-holdfirm-code :
     3007   define input parameter p-obj-type   as character        no-undo.
     3008   define input parameter p-obj-code   as integer          no-undo.
     3009   define output parameter p-firm-code as integer          no-undo.
     3010       define variable v-firm-code-str     as character    no-undo.
     3011       define variable v-par-type          as character    no-undo.
     3012       define buffer buf_clients       for ub.clients.
     3013   do
     3014   for buf_clients
     3015   on error undo, return error
     3016   :
     3017       run gbl/clntat-v.p (
     3018             input p-obj-type
     3019           , input p-obj-code
     3020           , input 'holdfirm-code':U
     3021           , output v-firm-code-str
     3022           , output v-par-type
     3023       ).
     3024       assign
     3025           p-firm-code = integer( v-firm-code-str )
     3026       no-error.
     3027       if error-status :error
     3028       then do:
     3029           message
     3030               "Неверно задан код фирмы для печати накладных."
     3031           view-as alert-box warning.
     3032           assign
     3033               p-firm-code = 0
     3034           .
     3035       end.
     3036       else do:
     3037           find first buf_clients no-lock
     3038                where buf_clients.obj-type = 'орг':U
     3039                  and buf_clients.obj-code = p-firm-code
     3040           no-error.
     3041           if not available buf_clients
     3042           then do:
     3043               message
     3044                   "Включен параметр 'Список печатных форм, для которых должна быть задана фирма для печати накладных' (outhold)" skip
     3045                   "Не найдена фирма по заданному коду фирмы для печати накладных."
     3046               view-as alert-box warning.
     3047               assign
     3048                   p-firm-code = 0
     3049               .
     3050           end.
     3051       end.
     3052   end.
     3053   end procedure.
     3054   procedure torgconf-get-post-head:
     3055   define input  parameter p-obj-type             as character        no-undo.
     3056   define input  parameter p-obj-code             as integer          no-undo.
     3057   define output parameter p-torgconf-post-head   as character        no-undo.
     3058      define variable v-host-code         as integer      no-undo.
     3059      define buffer buf_sysconf     for ub.sysconf.
     3060        assign
     3061         p-torgconf-post-head  = ""
     3062        .
     3063   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3064   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3065     (input  p-obj-type
     3066     ,input  p-obj-code
     3067     ,output v-host-code
     3068     )  .
     3069      find first buf_sysconf no-lock
     3070      where buf_sysconf.host-code = v-host-code
     3071      no-error.
     3072      if available buf_sysconf
     3073      then do:
     3074         assign
     3075            p-torgconf-post-head = buf_sysconf.head-position
     3076         .
     3077      end.
     3078   end procedure.
     3079   procedure torgconf-get-storekeeper:
     3080   define input  parameter p-wrkr                   as integer          no-undo.
     3081   define output parameter p-torgconf-wrkr-name     as character        no-undo.
     3082   define output parameter p-torgconf-post          as character        no-undo.
     3083      define buffer buf_sysconf     for ub.sysconf.
     3084      define buffer buf_person      for ub.person.
     3085      define buffer buf_shop        for ub.shop .
     3086      define buffer buf_store       for ub.store .
     3087      if v-torgconf-outC = "no_print"
     3088      then do:
     3089         assign p-torgconf-post = ""
     3090                p-torgconf-wrkr-name = ""
     3091                .
     3092      end.
     3093      if v-torgconf-outC = "clad_doc"
     3094      then do:
     3095         run rep/get-psn.p
     3096               (input  p-wrkr
     3097               ,output p-torgconf-wrkr-name
     3098               ) .
     3099         find first buf_person no-lock
     3100         where buf_person.psn-code = p-wrkr
     3101         no-error.
     3102         if available buf_person
     3103         then do:
     3104           p-torgconf-post = buf_person.position.
     3105         end.
     3106         if p-torgconf-post = "?":U then p-torgconf-post = "".
     3107         if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     3108      end.
     3109      if v-torgconf-outC = "clad_obj"
     3110      then do:
     3111         CASE v-torgconf-self-obj-type:
     3112         WHEN 'маг':U
     3113         THEN DO:
     3114            find first buf_shop no-lock
     3115            where buf_shop.obj-code = v-torgconf-self-obj-code
     3116            .
     3117            assign
     3118               p-torgconf-wrkr-name = buf_shop.store-man
     3119               p-torgconf-post = ""
     3120            .
     3121            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     3122         END.
     3123         WHEN 'скл':U
     3124         THEN DO:
     3125            find first buf_store no-lock
     3126            where buf_store.obj-code = v-torgconf-self-obj-code
     3127            .
     3128            assign
     3129               p-torgconf-wrkr-name = buf_store.store-man
     3130               p-torgconf-post = ""
     3131            .
     3132            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     3133         END.
     3134         OTHERWISE DO:
     3135            assign
     3136               p-torgconf-post = "":U
     3137               p-torgconf-wrkr-name = "":U
     3138            .
     3139         END.
     3140         END CASE.
     3141      end.
     3142    end procedure.
     3143   procedure torgconf-get-form-header :
     3144   define input parameter p-for-inverse    as logical          no-undo.
     3145   define input parameter p-doc-code       as character        no-undo.
     3146   define input parameter p-print-doc      as logical          no-undo.
     3147   define input parameter p-doc-date       as date             no-undo.
     3148   define input parameter p-fact-date      as date             no-undo.
     3149   define input parameter p-doc-type       as character        no-undo.
     3150   define input parameter p-status_        as character        no-undo.
     3151   define input parameter p-reverse        as logical          no-undo.
     3152   define input parameter p-sf-par         as logical          no-undo.
     3153       define variable v-attr-type         as character    no-undo.
     3154       define variable v-doc-code-standard as logical      no-undo.
     3155       define variable v-doc-date-standard as logical      no-undo.
     3156       define variable v-par-consignee-addres  as character    no-undo.
     3157       define variable v-host-code         as integer      no-undo.
     3158       define variable v-dcode-attr        as character    no-undo.
     3159       define variable v-ddate-attr        as character    no-undo.
     3160       define variable v-doc-date          as character    no-undo.
     3161       define variable v-doc-code          as character    no-undo.
     3162       define variable v-par-type          as character    no-undo.
     3163       define variable v-attr              as character    no-undo.
     3164       define buffer buf_firm          for ub.firm .
     3165       define buffer buf_clients       for ub.clients .
     3166       define buffer buf_sysconf       for ub.sysconf .
     3167       define buffer buf_shop          for ub.shop .
     3168       define buffer buf_store         for ub.store .
     3169       define buffer buf_person        for ub.person .
     3170       define buffer buf_trn-doc       for ub.trn-doc .
     3171       define buffer buf_wth-doc       for ub.wth-doc .
     3172       do
     3173   for buf_firm
     3174     , buf_clients
     3175     , buf_sysconf
     3176     , buf_shop
     3177     , buf_trn-doc
     3178     , buf_person
     3179     , buf_wth-doc
     3180   on error undo, return error
     3181   :
     3182       if p-doc-type = 'при':U
     3183       or p-doc-type = 'возврат':U
     3184       then do:
     3185           assign
     3186               v-torgconf-supplier         = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     3187                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     3188               v-torgconf-suppi            = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     3189                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     3190               v-torgconf-saler            = substitute( "&1&2&3&4&5", v-torgconf-self-host-name, ( if v-torgconf-self-host-addres = "":U then "":U else ", " ),
     3191                                             v-torgconf-self-host-addres, ( if v-torgconf-self-host-phone = "":U then "":U else ", " ),v-torgconf-self-host-phone )
     3192               v-torgconf-consignee        = substitute( "&1&2&3&4&5", v-torgconf-sup-host-name, ( if v-torgconf-sup-host-addres = "":U then "":U else ", " ),
     3193                                             v-torgconf-sup-host-addres, ( if v-torgconf-sup-host-phone = "":U then "":U else ", " ), v-torgconf-sup-host-phone  )
     3194               v-torgconf-supplier-okpo    = v-torgconf-cli-okpo
     3195               v-torgconf-saler-okpo       = v-torgconf-self-host-okpo
     3196               v-torgconf-consignee-okpo   = v-torgconf-sup-host-okpo
     3197               v-torgconf-supplier-code    = substitute( "&1", v-torgconf-cli-code         )
     3198               v-torgconf-supplier-type    = v-torgconf-cli-type
     3199               v-torgconf-saler-code       = substitute( "&1", v-torgconf-self-host-code   )
     3200               v-torgconf-saler-type       = v-torgconf-self-host-type
     3201               v-torgconf-consignee-code   = substitute( "&1", v-torgconf-sup-host-code   )
     3202               v-torgconf-consignee-type   = v-torgconf-sup-host-type
     3203               v-torgconf-supplier-name    = substitute( "&1", v-torgconf-cli-name         )
     3204               v-torgconf-saler-name       = substitute( "&1", v-torgconf-self-host-name   )
     3205               v-torgconf-consignee-name   = substitute( "&1", v-torgconf-sup-host-name   )
     3206               v-torgconf-supplier-addr    = substitute( "&1", v-torgconf-cli-addres       )
     3207               v-torgconf-saler-addr       = substitute( "&1", v-torgconf-self-host-addres )
     3208               v-torgconf-consignee-addr   = substitute( "&1", v-torgconf-sup-host-addres )
     3209               v-torgconf-supplier-inn     = substitute( "&1", v-torgconf-cli-inn          )
     3210               v-torgconf-supplier-engl-name     = substitute( "&1", v-torgconf-cli-engl-name          )
     3211               v-torgconf-saler-inn        = substitute( "&1", v-torgconf-self-host-inn    )
     3212               v-torgconf-consignee-inn    = substitute( "&1", v-torgconf-sup-host-inn    )
     3213               v-torgconf-supplier-kpp     = substitute( "&1", v-torgconf-cli-kpp          )
     3214               v-torgconf-saler-kpp        = substitute( "&1", v-torgconf-self-host-kpp    )
     3215               v-torgconf-consignee-kpp    = substitute( "&1", v-torgconf-sup-host-kpp    )
     3216           .
     3217           if v-torgconf-cli-schet-exists = yes
     3218           AND v-form-name                  = "torg12":U
     3219           then do:
     3220               assign
     3221                   v-torgconf-supplier = v-torgconf-supplier
     3222                       + substitute( ", р/с &1 к/с &2"
     3223                                   , v-torgconf-cli-bank-r-schet
     3224                                   , v-torgconf-cli-bank-c-schet
     3225                                   )
     3226                   v-torgconf-suppi = v-torgconf-supplier
     3227                       + substitute( ", р/с &1 к/с &2"
     3228                                   , v-torgconf-cli-bank-r-schet
     3229                                   , v-torgconf-cli-bank-c-schet
     3230                                   )
     3231               .
     3232               if v-torgconf-cli-bank-exists = yes
     3233               then do:
     3234                   assign
     3235                       v-torgconf-supplier = v-torgconf-supplier
     3236                           + substitute( " БИК &1 в &2 &3"
     3237                                       , v-torgconf-cli-bank-bik
     3238                                       , v-torgconf-cli-bank-name
     3239                                       ,(if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     3240                                       )
     3241                      v-torgconf-suppi = v-torgconf-supplier
     3242                           + substitute( " БИК &1 в &2 &3"
     3243                                       , v-torgconf-cli-bank-bik
     3244                                       , v-torgconf-cli-bank-name
     3245                                       ,(if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     3246                                       )
     3247                   .
     3248               end.
     3249           end.
     3250           if v-torgconf-self-schet-exists = yes
     3251           AND v-form-name                  = "torg12":U
     3252           then do:
     3253               assign
     3254                   v-torgconf-saler = v-torgconf-saler
     3255                       + substitute( ", р/с &1 к/с &2"
     3256                                   , v-torgconf-self-bank-r-schet
     3257                                   , v-torgconf-self-bank-c-schet
     3258                                   )
     3259               .
     3260               if v-torgconf-self-bank-exists = yes
     3261               then do:
     3262                   assign
     3263                       v-torgconf-saler = v-torgconf-saler
     3264                           + substitute( " БИК &1 в &2 &3"
     3265                                       , v-torgconf-self-bank-bik
     3266                                       , v-torgconf-self-bank-name
     3267                                       , v-torgconf-self-bank-addres
     3268                                       )
     3269                   .
     3270               end.
     3271           end.
     3272           if v-torgconf-sup-schet-exists = yes
     3273           AND v-form-name                  = "torg12":U
     3274           then do:
     3275               assign
     3276                   v-torgconf-consignee = v-torgconf-consignee
     3277                       + substitute( ", р/с &1 к/с &2"
     3278                                   , v-torgconf-sup-bank-r-schet
     3279                                   , v-torgconf-sup-bank-c-schet
     3280                                   )
     3281               .
     3282             if v-torgconf-sup-bank-exists = yes
     3283              then do:
     3284                assign
     3285                   v-torgconf-consignee = v-torgconf-consignee
     3286                           + substitute( " БИК &1 в &2 &3"
     3287                                       , v-torgconf-sup-bank-bik
     3288                                       , v-torgconf-sup-bank-name
     3289                                       , v-torgconf-sup-bank-addres
     3290                                       )
     3291                   .
     3292               end.
     3293           end.
     3294      if v-torgconf-outares = yes  AND v-form-name  = "torg12":U
     3295      then do:
     3296          assign
     3297            v-torgconf-supplier = substitute(  "&1&2&3 &4 &5&6"
     3298                                                   , IF v-form-name = "torg12":U THEN SUBSTITUTE("ИНН &1 КПП &2 ", v-torgconf-cli-inn, v-torgconf-cli-kpp) ELSE "":U
     3299                                                   , v-torgconf-cli-name
     3300                                                   , ( if v-torgconf-outprncd = yes
     3301                                                         then substitute( " (&1)", v-torgconf-cli-code )
     3302                                                         else "":U )
     3303                                                   , v-torgconf-cli-post-addres
     3304                                                   , v-torgconf-cli-phone
     3305                                                   , ( if v-torgconf-cli-bank-r-schet <> "":U
     3306                                                       AND v-form-name                  = "torg12":U
     3307                                                         then substitute( ", р/с &1 к/с &2, БИК &3 в &4, &5"
     3308                                                               , v-torgconf-cli-bank-r-schet
     3309                                                               , v-torgconf-cli-bank-c-schet
     3310                                                               , v-torgconf-cli-bank-bik
     3311                                                               , v-torgconf-cli-bank-name
     3312                                                               , (if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )     )
     3313                                                         else "":U )
     3314                                                )
     3315         .
     3316      end.
     3317       v-torgconf-suppi = substitute(  "&1&2&3 &4 &5&6"
     3318                                        , IF v-form-name = "torg12":U THEN SUBSTITUTE("ИНН &1 КПП &2 ", v-torgconf-cli-inn, v-torgconf-cli-kpp) ELSE "":U
     3319                                        , v-torgconf-cli-name
     3320                                        , ( if v-torgconf-outprncd = yes
     3321                                            then substitute( " (&1)", v-torgconf-cli-code )
     3322                                            else "":U )
     3323                                        , v-torgconf-cli-addres
     3324                                        , v-torgconf-cli-phone
     3325                                        , ( if v-torgconf-cli-bank-r-schet <> "":U
     3326                                            AND v-form-name                  = "torg12":U
     3327                                            then substitute( ", р/с &1 к/с &2, БИК &3 в &4, &5"
     3328                                                           , v-torgconf-cli-bank-r-schet
     3329                                                           , v-torgconf-cli-bank-c-schet
     3330                                                           , v-torgconf-cli-bank-bik
     3331                                                           , v-torgconf-cli-bank-name
     3332                                                           , (if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) ))
     3333                                                   else "":U )
     3334                                        ).
     3335       end.
     3336       else do:
     3337       v-torgconf-suppi = substitute(  "&1&2&3 &4 &5&6"
     3338                                        , IF v-form-name = "torg12":U THEN SUBSTITUTE("ИНН &1 КПП &2 ", v-torgconf-self-host-inn, v-torgconf-self-host-kpp) ELSE "":U
     3339                                        , v-torgconf-self-host-name
     3340                                        , ( if v-torgconf-outprncd = yes
     3341                                            then substitute( " (&1)", v-torgconf-self-host-code )
     3342                                            else "":U )
     3343                                        , v-torgconf-self-host-addres
     3344                                        , v-torgconf-self-host-phone
     3345                                        , ( if v-torgconf-self-bank-r-schet <> "":U
     3346                                            AND v-form-name                  = "torg12":U
     3347                                            then substitute( ", р/с &1 к/с &2, БИК &3 в &4, &5"
     3348                                                           , v-torgconf-self-bank-r-schet
     3349                                                           , v-torgconf-self-bank-c-schet
     3350                                                           , v-torgconf-self-bank-bik
     3351                                                           , v-torgconf-self-bank-name
     3352                                                           , (if v-torgconf-self-bank-city = "":U then "":U else ( "г. " + v-torgconf-self-bank-city) )     )
     3353                                                   else "":U )
     3354                                           ).
     3355         if v-torgconf-outares = yes
     3356         and p-reverse = no
     3357         then do:
     3358            assign
     3359               v-par-consignee-addres = v-torgconf-ship-post-addres
     3360            .
     3361         end.
     3362         if v-torgconf-outares = no
     3363         and p-reverse = no
     3364         then do:
     3365            assign
     3366               v-par-consignee-addres = v-torgconf-ship-addres
     3367            .
     3368         end.
     3369         if p-reverse = yes
     3370         then do:
     3371             assign
     3372               v-par-consignee-addres = v-torgconf-ship-addres
     3373             .
     3374         end.
     3375           assign
     3376               v-torgconf-supplier         = substitute( "&1&2&3&4&5", v-torgconf-self-host-name, ( if v-torgconf-self-host-addres = "":U then "":U else ", " ), v-torgconf-self-host-addres,
     3377                                             ( if v-torgconf-self-host-phone = "":U then "":U else ", " ), v-torgconf-self-host-phone )
     3378               v-torgconf-saler            = substitute( "&1&2&3&4&5", v-torgconf-cli-name      , ( if v-torgconf-cli-addres       = "":U then "":U else ", " ), v-torgconf-cli-addres,
     3379                                             ( if v-torgconf-cli-phone       = "":U then "":U else ", " ), v-torgconf-cli-phone )
     3380               v-torgconf-consignee        = substitute( "&1&2&3&4&5", v-torgconf-ship-name      , ( if v-par-consignee-addres   = "":U then "":U else ", " ), v-par-consignee-addres,
     3381                                              ( if v-torgconf-ship-phone   = "":U then "":U else ", " ), v-torgconf-ship-phone)
     3382               v-torgconf-supplier-okpo    = v-torgconf-self-host-okpo
     3383               v-torgconf-saler-okpo       = v-torgconf-cli-okpo
     3384               v-torgconf-consignee-okpo   = v-torgconf-ship-okpo
     3385               v-torgconf-supplier-code    = substitute( "&1", v-torgconf-self-host-code   )
     3386               v-torgconf-supplier-code    = v-torgconf-self-host-type
     3387               v-torgconf-saler-code       = substitute( "&1", v-torgconf-cli-code         )
     3388               v-torgconf-saler-type       = v-torgconf-cli-type
     3389               v-torgconf-consignee-code   = substitute( "&1", v-torgconf-ship-code         )
     3390               v-torgconf-consignee-type   = v-torgconf-ship-type
     3391               v-torgconf-supplier-name    = substitute( "&1", v-torgconf-self-host-name   )
     3392               v-torgconf-saler-name       = substitute( "&1", v-torgconf-cli-name         )
     3393               v-torgconf-consignee-name   = substitute( "&1", v-torgconf-ship-name         )
     3394               v-torgconf-supplier-addr    = substitute( "&1", v-torgconf-self-host-addres )
     3395               v-torgconf-saler-addr       = substitute( "&1", v-torgconf-cli-addres       )
     3396               v-torgconf-consignee-addr   = substitute( "&1", v-par-consignee-addres                )
     3397               v-torgconf-supplier-inn     = substitute( "&1", v-torgconf-self-host-inn    )
     3398               v-torgconf-supplier-engl-name     = substitute( "&1", v-torgconf-self-host-engl-name    )
     3399               v-torgconf-saler-inn        = substitute( "&1", v-torgconf-cli-inn          )
     3400               v-torgconf-consignee-inn    = substitute( "&1", v-torgconf-ship-inn          )
     3401               v-torgconf-supplier-kpp     = substitute( "&1", v-torgconf-self-host-kpp    )
     3402               v-torgconf-saler-kpp        = substitute( "&1", v-torgconf-cli-kpp          )
     3403               v-torgconf-consignee-kpp    = substitute( "&1", v-torgconf-ship-kpp          )
     3404               v-torgconf-sf-buyer-name    = v-torgconf-consignee-name
     3405               v-torgconf-sf-buyer-code    = v-torgconf-consignee-code
     3406               v-torgconf-sf-buyer-type    = v-torgconf-consignee-type
     3407               v-torgconf-sf-buyer-addr    = v-torgconf-consignee-addr
     3408           .
     3409           if v-torgconf-self-schet-exists = yes
     3410           AND v-form-name                  = "torg12":U
     3411           then do:
     3412               assign
     3413                   v-torgconf-supplier = v-torgconf-supplier
     3414                       + substitute( ", р/с &1 к/с &2"
     3415                                   , v-torgconf-self-bank-r-schet
     3416                                   , v-torgconf-self-bank-c-schet
     3417                                   )
     3418               .
     3419               if v-torgconf-self-bank-exists = yes
     3420               then do:
     3421                   assign
     3422                       v-torgconf-supplier = v-torgconf-supplier
     3423                           + substitute( " БИК &1 в &2 &3"
     3424                                       , v-torgconf-self-bank-bik
     3425                                       , v-torgconf-self-bank-name
     3426                                       , v-torgconf-self-bank-addres
     3427                                       )
     3428                   .
     3429               end.
     3430           end.
     3431           if v-torgconf-cli-schet-exists = yes
     3432           AND v-form-name                  = "torg12":U
     3433           then do:
     3434               assign
     3435                   v-torgconf-saler = v-torgconf-saler
     3436                       + substitute( ", р/с &1 к/с &2"
     3437                                   , v-torgconf-cli-bank-r-schet
     3438                                   , v-torgconf-cli-bank-c-schet
     3439                                   )
     3440               .
     3441               if v-torgconf-cli-bank-exists = yes
     3442               then do:
     3443                   assign
     3444                       v-torgconf-saler = v-torgconf-saler
     3445                           + substitute( " БИК &1 в &2 &3"
     3446                                       , v-torgconf-cli-bank-bik
     3447                                       , v-torgconf-cli-bank-name
     3448                                       , (if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     3449                                       )
     3450                   .
     3451               end.
     3452           end.
     3453           if v-torgconf-ship-schet-exists = yes
     3454           AND v-form-name                  = "torg12":U
     3455           then do:
     3456               assign
     3457                   v-torgconf-consignee = v-torgconf-consignee
     3458                       + substitute( ", р/с &1 к/с &2"
     3459                                   , v-torgconf-ship-bank-r-schet
     3460                                   , v-torgconf-ship-bank-c-schet
     3461                                   )
     3462               .
     3463               if v-torgconf-ship-bank-exists = yes
     3464               then do:
     3465                   assign
     3466                       v-torgconf-consignee = v-torgconf-consignee
     3467                           + substitute( " БИК &1 в &2  &3"
     3468                                       , v-torgconf-ship-bank-bik
     3469                                       , v-torgconf-ship-bank-name
     3470                                       , (if v-torgconf-ship-bank-city = "":U then "":U else ( "г. " + v-torgconf-ship-bank-city) )
     3471                                       )
     3472                   .
     3473               end.
     3474           end.
     3475      if p-reverse = yes
     3476         then do:
     3477          if  v-torgconf-outares = yes then v-torgconf-saler = substitute( "&1&2&3", v-torgconf-cli-name      , ( if v-torgconf-cli-post-addres       = "":U then "":U else ", " ), v-torgconf-cli-post-addres       )
     3478            .
