     5385                                     ,output v-format
     5386                                     ,output v-label
     5387                                     ,output v-user-can-edit
     5388                                     ,output v-output-display
     5389                                     ,output v-other
     5390                                     ) no-error .
     5391   if error-status :error then do:
     5392     undo, return error return-value .
