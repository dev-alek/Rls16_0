     4367        when "nacl":U
     4368        then do:
     4369            if  v-name <> 'wthtrg12'
     4370            and v-name <> 'wthfct'
     4371            and v-name <> 'wthm11'
     4372            then do:
     4373               assign
     4374                  v-torgconf-plat-rasch-doc   = substitute( "&1 от &2 &3"
     4375                                                   , if trim(v-dcode-attr) = "" then v-torgconf-doc-code else v-dcode-attr
     4376                                                   , if trim(v-ddate-attr) = "" then v-torgconf-doc-date else v-ddate-attr
     4377                                                   , ( if p-status_ <> 'факт':U
     4378                                                      then string( "(" + caps( p-status_ ) + ")" )
     4379                                                      else "":U )
     4380                                                )
     4381               .
     4382            end.
     4383            else do:
     4384            if trim(v-attr) = ""
     4385            then do:
     4386               assign
     4387                  v-torgconf-plat-rasch-doc   = substitute( "&1 от &2 &3",
     4388                                                           v-torgconf-doc-code,
     4389                                                           v-torgconf-doc-date,
     4390                                                            ( if p-status_ <> 'факт':U then string( "(" + caps( p-status_ ) + ")" ) else "":U )
     4391                                                           )
     4392               .
     4393            end.
     4394            else do:
     4395               assign
     4396                  v-torgconf-plat-rasch-doc = v-attr.
     4397            end.
     4398            end.
     4399        end.
     4400        otherwise do:
     4401            if  v-name <> 'wthtrg12'
     4402            and v-name <> 'wthfct'
     4403            and v-name <> 'wthm11'
     4404            then do:
     4405               IF v-dcode-attr <> "":U
     4406               OR v-ddate-attr <> "":U
     4407               THEN
     4408               assign
     4409                  v-torgconf-plat-rasch-doc   = substitute( "&1 от &2"
     4410                                                      , if trim(v-dcode-attr) = "" then "" else v-dcode-attr
     4411                                                      , if trim(v-ddate-attr) = "" then "" else v-ddate-attr
     4412                                                   )
     4413               .
     4414            end.
     4415            else do:
     4416               assign
     4417                  v-torgconf-plat-rasch-doc   = substitute( "&1", if trim(v-attr) = "" then "" else v-attr)
     4418               .
     4419            end.
     4420        end.
     4421       end case.
     4422      if v-torgconf-outB = "no_print"
     4423      then do:
     4424         assign v-torgconf-main-buh = "".
     4425      end.
     4426      if v-torgconf-outB = "glbuh_firm"
     4427      then do:
     4428            if v-torgconf-self-host-code = 0
     4429            then do:
     4430            end.
     4431            else do:
     4432               find first buf_sysconf no-lock
     4433                  where buf_sysconf.host-code = v-torgconf-self-host-code
     4434               .
     4435               assign
     4436                  v-torgconf-main-buh  = buf_sysconf.snr-accnt
     4437               .
     4438            end.
     4439      end.
     4440      if v-torgconf-outB = "buh_obj"
     4441      then do:
     4442         CASE v-torgconf-self-obj-type:
     4443         WHEN 'маг':U
     4444         THEN DO:
     4445            find first buf_shop no-lock
     4446            where buf_shop.obj-code = v-torgconf-self-obj-code
     4447            .
     4448            assign
     4449               v-torgconf-main-buh  = entry(1,buf_shop.acct,"|")
     4450            .
     4451         END.
     4452         WHEN 'скл':U
     4453         THEN DO:
     4454            find first buf_store no-lock
     4455            where buf_store.obj-code = v-torgconf-self-obj-code
     4456            .
     4457            assign
     4458               v-torgconf-main-buh  = buf_store.store-man
     4459            .
     4460         END.
     4461         OTHERWISE DO:
     4462            assign
     4463               v-torgconf-main-buh  = "":U
     4464            .
     4465         END.
     4466         END CASE.
     4467      end.
     4468      if v-torgconf-outR = "no_print"
     4469         then do:
     4470            assign
     4471               v-torgconf-main-boss = ""
     4472               v-torgconf-main-boss-post = ""
     4473            .
     4474         end.
     4475      if v-torgconf-outR = "ruk_firm"
     4476         then do:
     4477            find first buf_sysconf no-lock
     4478            where buf_sysconf.host-code = v-torgconf-self-host-code
     4479            no-error.
     4480            if available buf_sysconf
     4481            then do:
     4482               assign
     4483                  v-torgconf-main-boss-post = buf_sysconf.head-position
     4484               .
     4485            end.
     4486            find first buf_clients no-lock
     4487            where buf_clients.obj-type = 'орг':U
     4488            and buf_clients.obj-code = v-torgconf-self-host-code
     4489            .
     4490            find first buf_firm no-lock
     4491            where buf_firm.firm-code = buf_clients.obj-code
     4492            no-error.
     4493            if available buf_firm
     4494            then do:
     4495               assign
     4496                  v-torgconf-main-boss = buf_firm.director
     4497               .
     4498            end.
     4499         end.
     4500      if v-torgconf-outR = "dir_obj"
     4501         then do:
     4502            CASE v-torgconf-self-obj-type:
     4503            WHEN 'маг':U
     4504            THEN DO:
     4505               find first buf_shop no-lock
     4506               where buf_shop.obj-code = v-torgconf-self-obj-code
     4507               .
     4508               assign
     4509                  v-torgconf-main-boss = buf_shop.director
     4510                  v-torgconf-main-boss-post = "Директор"
     4511               .
     4512            END.
     4513            WHEN 'скл':U
     4514            THEN DO:
     4515               find first buf_store no-lock
     4516               where buf_store.obj-code = v-torgconf-self-obj-code
     4517               .
     4518               assign
     4519                  v-torgconf-main-boss = buf_store.store-boss
     4520                  v-torgconf-main-boss-post = "Директор"
     4521               .
     4522            END.
     4523            OTHERWISE DO:
     4524               assign
     4525                  v-torgconf-main-boss       = "":U
     4526                  v-torgconf-main-boss-post  = "":U
     4527               .
     4528            END.
     4529            END CASE.
     4530         end.
     4531      if  v-name <> 'wthtrg12':U
     4532      and v-name <> 'wthfct':U
     4533      and v-name <> 'wthm11':U
     4534      then do:
     4535       find first buf_trn-doc no-lock
     4536       where buf_trn-doc.doc-code = p-doc-code
     4537       no-error.
     4538       if available buf_trn-doc
     4539         then do:
     4540   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4541   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     4542     (input  buf_trn-doc.obj-type
