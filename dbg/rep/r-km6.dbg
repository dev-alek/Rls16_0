      204   procedure create_obj-list :
      205      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      206      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      207      do
      208      on error undo, return error return-value
      209      :
      210         define buffer cli-obj for ub.clients .
      211         define variable p-var as integer no-undo .
      212         define buffer buf_obj-list for obj-list .
      213         find last buf_obj-list  use-index pi no-error .
      214         if available buf_obj-list
      215         then
      216            p-var = buf_obj-list.obj-id + 1.
      217         else
      218            p-var = 1.
      219         find first cli-obj where
      220                   cli-obj.obj-type = p-obj-type
      221               and cli-obj.obj-code = p-obj-code
      222         no-lock no-error.
      223         if available cli-obj
      224         then do:
      225            create buf_obj-list.
      226            assign
      227               buf_obj-list.obj-id   = p-var
      228               buf_obj-list.obj-code = cli-obj.obj-code
      229               buf_obj-list.obj-type = cli-obj.obj-type
      230               buf_obj-list.obj-name = cli-obj.obj-name
      231               buf_obj-list.db-num   = cli-obj.db-num
      232            .
      233         end.
      234      end.
      235   end.
