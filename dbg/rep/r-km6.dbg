     4595                  where buf_store.obj-code = buf_trn-doc.obj-code
     4596                  .
     4597                  assign
     4598                     v-torgconf-ogr-name = buf_store.store-boss
     4599                     v-torgconf-ogr-post = "Директор"
     4600                  .
     4601               END.
     4602               OTHERWISE DO:
     4603                  assign
     4604                     v-torgconf-ogr-name = "":U
     4605                     v-torgconf-ogr-post = "":U
     4606                  .
     4607               END.
     4608               END CASE.
     4609            end.
     4610      if v-torgconf-outogr = "manag_doc"
     4611         then do:
     4612            find first buf_trn-doc no-lock
     4613            where buf_trn-doc.doc-code = p-doc-code
     4614            no-error.
     4615            if available buf_trn-doc
     4616            then do:
     4617               run rep/get-psn.p
     4618               (input buf_trn-doc.boss
     4619               ,output v-torgconf-ogr-name
     4620               ) .
     4621            end.
     4622            find first buf_person no-lock
     4623            where buf_person.psn-code = buf_trn-doc.boss
     4624            no-error.
     4625            if available buf_person
     4626            then do:
