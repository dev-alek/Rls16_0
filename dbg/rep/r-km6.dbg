     6934        FGCOLOR 1  NO-UNDO.
     6935   DEFINE RECTANGLE RECT-1
     6936        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     6937        SIZE 55.13 BY 4.46.
     6938   DEFINE FRAME InfoFrame
     6939        StopBtn AT ROW 4.25 COL 21.75
     6940        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     6941        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     6942        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     6943        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     6944        RECT-1 AT ROW 1 COL 1
     6945       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     6946            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     6947            TITLE "Процесс"
     6948            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     6949   define variable mFrameView      as logical   no-undo init yes.
     6950     define variable mFramHandle as handle no-undo.
     6951     mFramHandle = frame InfoFrame:handle.
     6952     if  log-manager:logfile-name ne ?
     6953     then DO:
     6954         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     6955         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     6956         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     6957     end.
     6958     mFrameView = not session:batch-mode and mFramHandle:visible.
     6959     if mFrameView
     6960     then do:
     6961       ASSIGN
     6962          FRAME InfoFrame:HIDDEN                           = TRUE
     6963          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     6964     end.
     6965   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     6966   DO:
     6967     IF not StopProcessing THEN
     6968       Message "Вы действительно хотите прервать" SKIP
     6969               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     6970                 UPDATE StopProcessing.
     6971     IF StopProcessing THEN do:
     6972        if mFrameView
     6973        then do:
     6974           HIDE FRAME InfoFrame.
     6975        end.
     6976     End.
     6977   END.
