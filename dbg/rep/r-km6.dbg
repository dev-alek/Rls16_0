     5694   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5695   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5696   define  stream PrnLibStream.
     5697   procedure prn-lib-prn-file :
     5698     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     5699     define input parameter p-DIsabledoptions as integer no-undo .
     5700     define variable v-report-name as character no-undo .
     5701     define variable v-user-action as character no-undo .
     5702     define variable v-printed     as logical   no-undo .
     5703     define variable v-exist       as logical   no-undo .
     5704     do
     5705       on error undo, return error
     5706       :
     5707       run prn-lib-get-report-name  in this-procedure (
     5708         input parParentProc
     5709         ,output v-report-name
     5710         ).
     5711   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5712   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     5713     (input  v-report-name
     5714     ,input  2
     5715     ,output v-exist
     5716     )  .
     5717       if NOT v-exist then
     5718       DO:
     5719         Message
     5720           "Нет заданий на печать ! "
     5721           view-as alert-box .
     5722         Return  .
     5723       End.
     5724       run gbl/prnfilen.w
     5725         (input  ""
     5726         ,input  p-DisabledOptions
     5727         ,input  string(v-report-name )
     5728         ,input  7
     5729         ,output v-user-action
     5730         ,output v-printed
     5731         ) .
     5732       if v-printed then
     5733       do:
     5734         return "YES" .
     5735       end.
     5736       else
     5737       do:
     5738         return "NO" .
     5739       end.
     5740     end.
     5741   end procedure.
     5742   procedure prn-lib-open-stream :
     5743     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     5744     define input parameter p-page-size    as integer no-undo .
     5745     define input parameter p-is-stream    as logical no-undo .
     5746     define input parameter p-append       as logical no-undo .
     5747     define variable v-report-name as character no-undo .
     5748     do
     5749       on error undo, return error
     5750       :
     5751       run prn-lib-get-report-name  in this-procedure (
     5752         input parParentProc
     5753         ,output v-report-name
     5754         ).
     5755       if p-is-stream then
     5756       do:
     5757         if p-append then
     5758         do:
     5759           output stream PrnLibStream to value( v-report-name )
     5760             page-size value(p-page-size) append .
     5761         end.
     5762         if not p-append then
     5763         do:
     5764           output stream PrnLibStream to value( v-report-name )
     5765             page-size value(p-page-size) .
     5766         end.
     5767       end.
     5768       if not p-is-stream then
     5769       do:
     5770         if p-append then
     5771         do:
     5772           output to value( v-report-name )
     5773             page-size value(p-page-size) append .
     5774         end.
     5775         if not p-append then
     5776         do:
     5777           output to value( v-report-name )
     5778             page-size value(p-page-size) .
     5779         end.
     5780       end.
     5781     end.
     5782   end procedure.
     5783   procedure prn-lib-open-exp :
     5784     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     5785     define input parameter p-is-stream    as logical no-undo .
     5786     define input parameter p-is-append    as logical no-undo .
     5787     define output parameter p-ReportFileName as char init "report" no-undo.
     5788     define output parameter p-process as logical no-undo .
     5789     define variable glog as logical no-undo .
     5790     do
     5791       on error undo, return error
     5792       :
     5793       SYSTEM-DIALOG GET-FILE p-ReportFileName
     5794         TITLE      "Укажите путь"
     5795         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     5796         ASK-OVERWRITE
     5797         CREATE-TEST-FILE
     5798         SAVE-AS
     5799         USE-FILENAME
     5800         DEFAULT-EXTENSION "txt"
     5801         UPDATE glog
     5802         .
     5803       if not glog then  return.
     5804       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     5805       if p-is-stream then
     5806       do:
     5807         if p-is-append then
     5808         do:
     5809           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     5810         end.
     5811         else
     5812         do:
     5813           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     5814         end.
     5815       end.
     5816       else
     5817       do:
     5818         if p-is-append then
     5819         do:
     5820           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     5821         end.
     5822         else
     5823         do:
     5824           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     5825         end.
     5826       end.
     5827       p-process = yes.
     5828     end.
     5829   end procedure.
     5830   procedure prn-lib-get-report-name :
     5831     define input parameter parParentProc  as widget-handle no-undo.
     5832     define output parameter p-report-name as character no-undo .
     5833     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     5834   end procedure.
     5835   procedure prn-lib-reportviewer-report-name :
     5836     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     5837     define input parameter p-report-name-html as character no-undo .
     5838     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
     5839   end procedure.
     5840   procedure prn-lib-reportviewer :
     5841     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     5842     define input parameter p-report-name-html as character no-undo .
     5843     define input parameter p-param        as character no-undo .
     5844     define variable v-excel           as character no-undo init 'TRUE' .
     5845     define variable v-value-character as character no-undo .
     5846     define variable v-value-integer   as character no-undo .
     5847     define variable v-value-date      as date      no-undo .
     5848     define variable v-value-decimal   as decimal   no-undo .
     5849     define variable rep-excel         as logical   no-undo .
     5850     define variable excel-string      as character no-undo .
     5851     define variable v-param-type      as character no-undo .
     5852     define variable v-tth             as handle    no-undo .
     5853     run adm/shattri.p (
     5854       input "get":U
     5855       ,input  ""
     5856       ,input  0
     5857       ,input  'report-glob':U
     5858       ,input  'rep-excel':U
     5859       ,output v-value-character
     5860       ,output v-value-date
     5861       ,output v-value-decimal
     5862       ,output v-value-integer
     5863       ,output rep-excel
     5864       ,output v-param-type
     5865       ,INPUT-OUTPUT table-handle v-tth
     5866       )  .
     5867     if rep-excel then v-excel = "TRUE" .
     5868     else v-excel = "FALSE" .
     5869     if p-param eq ""
     5870     then
     5871        p-param = "EXCEL:" + v-excel.
     5872     else
     5873        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     5874     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     5875   end procedure.
     5876   procedure reprumpr_print-plain-text :
     5877   define input parameter p-dir-name as character no-undo .
     5878   define input parameter p-subdir-name as character no-undo .
     5879   define input parameter p-custom-name as character no-undo .
     5880   define input parameter p-disable-option as integer no-undo .
     5881   define input parameter p-font-number as integer no-undo .
     5882   define variable v-file-name as character no-undo .
     5883   define variable v-report-name as character no-undo .
     5884   define variable v-err-status as integer no-undo .
     5885   define variable v-err-mess as character no-undo .
     5886   v-file-name = p-dir-name + (if p-subdir-name <> ''
     5887                               then (p-subdir-name + chr(47))
     5888                               else '') +
     5889                 p-custom-name.
     5890   run prn-lib-get-report-name  in this-procedure (
     5891                                                     input parParentProc
     5892                                                     ,output v-report-name
     5893                                                   ).
     5894   os-copy
     5895   value(v-report-name)
     5896   value(v-file-name)
     5897   .
     5898   assign
     5899   v-err-status = os-error
     5900   .
     5901   if v-err-status <> 0 then do:
     5902     run gbl/os-errnm.p ( input v-err-status
     5903                         ,output v-err-mess).
     5904     return error v-err-mess.
     5905   end.
     5906   else do:
     5907     run cb_fill-report-destination in p-parent-handle (  input p-rdbh
     5908                                                   ,input p-report-id
     5909                                                   ,input 'text':U
     5910                                                   ,input v-file-name
     5911                                                   ,input string(p-disable-option) + chr(4) + string(p-font-number)
     5912                                                   ).
     5913   end.
     5914   end procedure.
     5915   procedure reprumpr_print-printer :
     5916   define input parameter p-font-number as integer no-undo .
     5917   define input parameter p-flags as integer no-undo .
     5918   define variable v-quest-print as logical no-undo .
     5919   define variable lok as logical no-undo .
     5920   define variable v-report-name as character no-undo .
     5921   run get-quest-print in parparentproc ( output v-quest-print) .
     5922   if not v-quest-print then do:
     5923       .
     5924     run prn-lib-get-report-name  in this-procedure (
     5925                                                       input parParentProc
     5926                                                      ,output v-report-name
     5927                                                     ).
     5928     run adecomm/_osprint.p
     5929       (input  ?
     5930       ,input  v-report-name
     5931       ,input  p-font-number
     5932       ,input  p-flags
     5933       ,input  0
     5934       ,input  0
     5935       ,output lok
     5936       ).
     5937     if not lok then do:
     5938     end.
     5939   end.
     5940   end procedure.
     5941   define stream temp-stream.
     5942   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5943   procedure prnexldl_clear:
     5944   define input parameter p-txl-file-name as character no-undo .
     5945   define variable v-template-file-name as character no-undo .
     5946   define variable v-vb-file-name as character no-undo .
     5947   define variable v-data-header-filename as character no-undo .
     5948   define variable v-data-filename as character no-undo .
     5949   if search( p-txl-file-name ) <> ? then do:
     5950     input stream temp-stream from value( p-txl-file-name ).
     5951     repeat
     5952     :
     5953         import stream temp-stream v-template-file-name   .
     5954         import stream temp-stream v-vb-file-name         .
     5955         import stream temp-stream v-data-header-filename .
     5956         os-delete value(v-data-header-filename).
     5957         import stream temp-stream v-data-filename        .
     5958         os-delete value(v-data-filename).
     5959     end.
     5960     input stream temp-stream close.
     5961     os-delete value( p-txl-file-name ).
     5962   end.
     5963   end procedure .
     5964   define stream reprumpr_in.
     5965   procedure reprumpr_print-xlt :
     5966   define input parameter p-dir-name as character no-undo .
     5967   define input parameter p-subdir-name as character no-undo .
     5968   define input parameter p-custom-name as character no-undo .
     5969   define input parameter p-disable-option as integer no-undo .
     5970   define input parameter p-font-number as integer no-undo .
     5971   define buffer buf_temp-param for temp-param .
     5972   define variable v-report-num            as integer no-undo .
     5973   define variable v-filename              as character    no-undo .
     5974   define variable v-obj-dir               as character    no-undo .
     5975   define variable v-report-filename       as character    no-undo .
     5976   define variable v-home-dir-filename     as character    no-undo .
     5977   define variable v-error-num             as integer      no-undo .
     5978   define variable v-template-file-name    as character    no-undo .
     5979   define variable v-vb-file-name          as character    no-undo .
     5980   define variable v-data-header-filename  as character    no-undo .
     5981   define variable v-data-filename         as character    no-undo .
     5982   define variable v-excel-file-name       as character    no-undo .
     5983   define variable v-err-message           as character    no-undo .
     5984   define variable v-os-err-str            as character    no-undo .
     5985   define variable v-report-dir            as character    no-undo .
     5986   do for buf_temp-param
     5987   on error undo, return error return-value
     5988   :
     5989   assign
     5990     v-report-dir  = trim( replace( p-dir-name, '/' , '\' ) , '\' )
     5991   .
     5992     assign
     5993     v-report-num = g#report-num
     5994     v-obj-dir           = v-report-dir + chr(47) +
     5995                           (if p-subdir-name <> '' then (p-subdir-name + chr(47)) else '')
     5996     v-filename          = string( session:temp-directory ) + "rpt" + string( v-report-num )
     5997     v-excel-file-name   = string( session:temp-directory ) + "rpt" + string( v-report-num ) + ".xls"
     5998     v-home-dir-filename = v-obj-dir +  p-custom-name
     5999     .
     6000     os-delete value( v-filename + ".txl" )  .
     6001     os-rename
     6002       value( string( session:temp-directory ) + "$" + string( v-report-num ) + ".txl" )
     6003       value( v-filename + ".txl" )
     6004     .
     6005     assign
     6006       v-filename = search( v-filename + ".txl" )
     6007     .
     6008     if v-filename = "" or v-filename = ?
     6009     then do:
     6010       assign
     6011         v-err-message = v-err-message + substitute( "Не найден файл &1 для формирования Excel-файла по объекту p-custom-name"
     6012                                                   , string( session:temp-directory ) + "rpt" + string( v-report-num )
     6013                                                   )
     6014       .
     6015       return error v-err-message.
     6016     end.
     6017     input stream reprumpr_in from value( v-filename ).
     6018     import stream reprumpr_in v-template-file-name   no-error .
     6019     import stream reprumpr_in v-vb-file-name         no-error .
     6020     import stream reprumpr_in v-data-header-filename no-error .
     6021     import stream reprumpr_in v-data-filename        no-error .
     6022     input stream reprumpr_in close.
     6023     if search( v-template-file-name ) = ?
     6024     then do:
     6025       assign
     6026         v-err-message = v-err-message + substitute( "Не найден шаблон Excel для вывода данных.&2Указан файл шаблона:&1&2&2"
     6027                                                   , v-template-file-name
     6028                                                   , chr(10)
     6029                                                   )
     6030       .
     6031       return error v-err-message.
     6032     end.
     6033     if search( v-vb-file-name ) = ?
     6034     then do:
     6035       assign
     6036         v-err-message = v-err-message + substitute( "Не найден текст программы заполнения шаблона Excel.&3Файл шаблона:&1&3Указан файл программы:&2&3&3"
     6037                                                   , v-template-file-name
     6038                                                   , v-vb-file-name
     6039                                                   , chr(10)
     6040                                                   )
     6041       .
     6042       return error v-err-message.
     6043     end.
     6044     if v-data-header-filename <> "":U
     6045     and search( v-data-header-filename ) = ?
     6046     then do:
     6047       assign
     6048         v-err-message = v-err-message + substitute( "Не найден файл шапки.&3Файл шаблона:&1&3Указан файл шапки:&2&3&3"
     6049                                                   , v-template-file-name
     6050                                                   , v-data-header-filename
     6051                                                   , chr(10)
     6052                                                   )
     6053       .
     6054       return error v-err-message.
     6055     end.
     6056     if v-data-filename <> "":U
     6057     and search( v-data-filename )   = ?
     6058     then do:
     6059       assign
     6060         v-err-message = v-err-message + substitute( "Не найден файл строк данных.&3Файл шаблона:&1&3Указан файл строк данных:&2&3&3"
     6061                                                   , v-template-file-name
     6062                                                   , v-data-filename
     6063                                                   , chr(10)
     6064                                                   )
     6065       .
     6066       return error v-err-message.
     6067     end.
     6068     create buf_temp-param.
     6069     assign
     6070       v-template-file-name = search( v-template-file-name )
     6071       file-info :file-name = v-template-file-name
     6072       v-template-file-name = file-info :full-pathname
     6073       v-vb-file-name       = search( v-vb-file-name )
     6074       file-info :file-name = v-vb-file-name
     6075       v-vb-file-name       = file-info :full-pathname
     6076     .
     6077     if v-template-file-name = ? or v-template-file-name = "":U
     6078     then do:
     6079       RETURN error substitute("Не найден шаблон &1", v-template-file-name).
     6080     end.
     6081     run paramls-write in this-procedure ( input "template":U
     6082                                         , input "template-file-name":U
     6083                                         , input v-template-file-name
     6084                                         ).
     6085     run paramls-write in this-procedure ( input "template":U
     6086                                         , input "vb-file-name":U
     6087                                         , input v-vb-file-name
     6088                                         ).
     6089     run paramls-write in this-procedure ( input "data":U
     6090                                         , input "data-header-filename":U
     6091                                         , input v-data-header-filename
     6092                                         ).
     6093     run paramls-write in this-procedure ( input "data":U
     6094                                         , input "data-filename":U
     6095                                         , input v-data-filename
     6096                                         ).
     6097     run paramls-write in this-procedure ( input "saveas":U
     6098                                         , input "excel-file-name":U
     6099                                         , input v-excel-file-name
     6100                                         ).
     6101     run paramls-write in this-procedure ( input "file":U
     6102                                         , input "file-no-open":U
     6103                                         , input "yes":U
     6104                                         ).
     6105     run gbl/macroxlt.p ( input-output table buf_temp-param ) no-error.
     6106     if error-status :error
     6107     then do:
     6108       assign
     6109         v-err-message = v-err-message + substitute( "&1&2&3&4Ошибка создания файла Excel.&4&5&4&6&4&7&4&8&4&4"
     6110                                                   , vss-workfile
     6111                                                   , vss-revision
     6112                                                   , vss-description
     6113                                                   , chr(10)
     6114                                                   , return-value
     6115                                                   , trim(error-status :get-message(1))
     6116                                                   , trim(error-status :get-message(2))
     6117                                                   , trim(error-status :get-message(3))
     6118                                                   )
     6119       .
     6120       return error v-err-message.
     6121     end.
     6122     run prnexldl_clear in this-procedure ( input v-filename) no-error.
     6123     if error-status :error
     6124     then do:
     6125       assign
     6126         v-err-message = v-err-message + substitute( "Ошибка удаления файла &1: &2 &3&3"
     6127                                                   , v-filename
     6128                                                   , return-value
     6129                                                   , chr(10)
     6130                                                   )
     6131       .
     6132       return error v-err-message.
     6133     end.
     6134     run gbl/dir-cre.p ( input v-obj-dir ) no-error  .
     6135     if error-status :error
     6136     then do:
     6137       assign
     6138         v-err-message = v-err-message + substitute( "Ошибка создания директории &1: &2&4&3&4&4"
     6139                                                   , v-filename
     6140                                                   , return-value
     6141                                                   , trim(error-status :get-message(1))
     6142                                                   , chr(10)
     6143                                                   )
     6144       .
     6145     end.
     6146     run gbl/del-file.p ( input v-home-dir-filename ) no-error .
     6147     if error-status :error
     6148     then do:
     6149       assign
     6150         v-err-message = v-err-message + substitute( "Ошибка удаления файла &1: &2 &3&3"
     6151                                                   , v-home-dir-filename
     6152                                                   , return-value
     6153                                                   , chr(10)
     6154                                                   )
     6155       .
     6156       return error v-err-message.
     6157     end.
     6158     run gbl/ren-file.p ( input v-excel-file-name
     6159                     , input v-home-dir-filename
     6160                     ) no-error .
     6161     if error-status :error
     6162     then do:
     6163       assign
     6164         v-err-message = v-err-message + substitute( "Ошибка перемещения файла &1 -> &2: &3&4&4"
     6165                                                   , v-excel-file-name
     6166                                                   , v-home-dir-filename
     6167                                                   , return-value
     6168                                                   , chr(10)
     6169                                                   )
     6170       .
     6171       return error v-err-message.
     6172     end.
     6173     run cb_fill-report-destination in p-parent-handle (  input p-rdbh
     6174                                                   ,input p-report-id
     6175                                                   ,input 'excel':U
     6176                                                   ,input v-home-dir-filename
     6177                                                   ,input string(p-disable-option) + chr(4) + string(p-font-number)
     6178                                                   ).
     6179   end.
     6180   end procedure.
     6181   define variable sym1  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     6182   define variable sym2  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     6183   define variable sym3  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     6184   define variable sym4  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     6185   define variable sym5  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     6186   define variable sym6  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     6187   define variable sym7  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     6188   define variable sym8  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     6189   define variable sym9  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     6190   define variable sym10 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     6191   define variable sym11 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     6192   define variable sym12 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     6193   define variable sym13 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     6194   define variable sym14 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     6195   define variable sym15 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     6196   define variable sym16 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     6197   define variable sym17 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     6198   define variable sym18 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     6199   define variable sym19 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     6200   define variable sym20 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     6201   define variable sym21 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     6202   define variable sym22 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     6203   define variable sym23 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     6204   define variable sym24 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     6205   define variable sym25 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     6206   define variable sym26 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     6207   define variable sym27 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     6208   define variable temp1 as integer   no-undo.
     6209   define variable vss-include-info32 as character format "X(65)" no-undo
     6210   initial "@(#)$Workfile$ $Revision$".
     6211   define stream excel-line.
     6212   define stream excel-cell.
     6213   define temp-table temp_cell-data no-undo
     6214       field data-key as character
     6215       field data-value as character
     6216       index pi is primary unique data-key
     6217   .
     6218   define temp-table temp_line-data no-undo
     6219         field sheet-name       as character
     6220         field data-key         as character
     6221         field xl-line-id       as integer
     6222         FIELD d_znumber        as INTEGER
     6223         FIELD d_empty2         as character
     6224         FIELD d_empty3         as character
     6225         FIELD d_empty4         as character
     6226         FIELD d_empty5         as character
     6227         FIELD d_empty6         as character
     6228         FIELD d_summ-sale-7    as character
     6229         FIELD d_zerocounter    as INTEGER
     6230         FIELD d_summbegin      as DECIMAL
     6231         FIELD d_summend        as DECIMAL
     6232         FIELD d_summdelta      as DECIMAL
     6233         FIELD d_summreturn     as DECIMAL
     6234         FIELD d_person         as character
     6235         FIELD d_empty10        as character
     6236   .
     6237   define variable v-km6xl-cell-file-name       as character    no-undo.
     6238   define variable v-km6xl-data-file-name       as character    no-undo.
     6239   procedure km6xl-init :
     6240   define input parameter p-first-sheet          as logical no-undo .
     6241   define input parameter p-sheet-name           as character no-undo .
     6242   define input parameter p-sheet-list           as character no-undo .
     6243   define input parameter p-sheet-list-copy-from as character no-undo .
     6244   define buffer buf_temp_cell-data        for temp_cell-data.
     6245   define buffer buf_usr-flt               for ubflt.usr-flt.
     6246   do
     6247   for buf_temp_cell-data
     6248     , buf_usr-flt
     6249   on error undo, return error
     6250   :
     6251       if p-first-sheet then do:
     6252         run gbl/_tmpfile.p (
     6253               input "xd"
     6254             , input ".txt"
     6255             , output v-km6xl-data-file-name
     6256         ).
     6257         output stream excel-line to value( v-km6xl-data-file-name ).
     6258         run gbl/_tmpfile.p (
     6259               input "xc"
     6260             , input ".txt"
     6261             , output v-km6xl-cell-file-name
     6262         ).
     6263         output stream excel-cell to value( v-km6xl-cell-file-name ).
     6264         run km6xl-write-cell-data in this-procedure (
     6265               input "sheetListcopyfrom":U
     6266             , input p-sheet-list-copy-from
     6267         ).
     6268         run km6xl-write-cell-data in this-procedure (
     6269               input "sheetList":U
     6270             , input p-sheet-list
     6271         ).
     6272       end.
     6273       if printrubl = yes
     6274       then do:
     6275           run km6xl-write-cell-data in this-procedure (
     6276                 input substitute("&1_&2"
     6277                                  , p-sheet-name
     6278                                  , "valutCode":U
     6279                                  )
     6280               , input "0":U
     6281           ).
     6282       end.
     6283       else do:
     6284           run km6xl-write-cell-data in this-procedure (
     6285                 input substitute("&1_&2"
     6286                                  , p-sheet-name
     6287                                  , "valutCode":U
     6288                                  )
     6289               , input "1":U
     6290           ).
     6291       end.
     6292       run km6xl-write-cell-data in this-procedure (
     6293             input substitute("&1_&2"
     6294                             , p-sheet-name
     6295                             , "columnList":U
     6296                              )
     6297           , input "znumber,empty2,empty3,zerocounter,summbegin,summend,summdelta,summreturn,person,empty10":U
     6298       ).
     6299       run km6xl-write-cell-data in this-procedure (
     6300             input substitute("&1_&2"
     6301                             , p-sheet-name
     6302                             , "columnType":U
     6303                             )
     6304           , input "I,S,S,I,D,D,D,D,S,S":U
     6305       ).
     6306       run km6xl-write-cell-data in this-procedure (
     6307             input substitute("&1_&2"
     6308                             , p-sheet-name
     6309                             , "columnAmount":U
     6310                             )
     6311           , input "10":U
     6312       ).
     6313   end.
     6314   end procedure.
     6315   procedure km6xl-close :
     6316   do
     6317   on error undo, return error
     6318   :
     6319       output stream excel-line close.
     6320       output stream excel-cell close.
     6321       output to value( string( session:temp-directory + "$" + string( g#report-num ) ) + ".txl" ) .
     6322           export "exe/km6_97.xlt":U.
     6323           export "exe/t_form.bas":U.
     6324           export v-km6xl-cell-file-name.
     6325           export v-km6xl-data-file-name.
     6326       output close.
     6327   end.
     6328   end procedure.
     6329   procedure km6xl-write-cell-data :
     6330   define input parameter p-data-key   as character        no-undo.
     6331   define input parameter p-data-value as character        no-undo.
     6332       define buffer buf_temp_cell-data     for temp_cell-data.
     6333   do
     6334   for buf_temp_cell-data
     6335   on error undo, return error
     6336   :
     6337       find first buf_temp_cell-data
     6338            where buf_temp_cell-data.data-key = p-data-key
     6339       no-error.
     6340       if not available buf_temp_cell-data
     6341       then do:
     6342           create buf_temp_cell-data.
     6343           assign
     6344               buf_temp_cell-data.data-key = p-data-key
     6345           .
     6346       end.
     6347       assign
     6348           buf_temp_cell-data.data-value = p-data-value
     6349       .
     6350       put stream excel-cell unformatted
     6351                           buf_temp_cell-data.data-key
     6352           CHR(9)   buf_temp_cell-data.data-value
     6353           chr(10)
     6354       .
     6355   end.
     6356   end procedure.
     6357   procedure km6xl-write-line-data :
     6358   define input parameter p-sheet-name        as character   no-undo.
     6359   define input parameter p-d_z-number        as INTEGER     no-undo.
     6360   define input parameter p-d_summ-sale       as decimal     no-undo.
     6361   define input parameter p-d_summ-return     as DECIMAL     no-undo.
     6362   define input parameter p-d_person          as character   no-undo.
     6363   define buffer buf_temp_line-data        for temp_line-data.
     6364   do
     6365   for buf_temp_line-data
     6366   on error undo, return error
     6367   :
     6368       for each buf_temp_line-data
     6369       :
     6370           delete buf_temp_line-data.
     6371       end.
     6372       create buf_temp_line-data.
     6373       assign
     6374           buf_temp_line-data.sheet-name     = p-sheet-name
     6375           buf_temp_line-data.data-key       = "DTA":U
     6376           buf_temp_line-data.d_znumber      = p-d_z-number
     6377           buf_temp_line-data.d_empty2       = ""
     6378           buf_temp_line-data.d_empty3       = ""
     6379           buf_temp_line-data.d_empty4       = ""
     6380           buf_temp_line-data.d_empty5       = ""
     6381           buf_temp_line-data.d_empty6       = ""
     6382           buf_temp_line-data.d_summ-sale-7  = string(p-d_summ-sale)
     6383           buf_temp_line-data.d_summreturn   = p-d_summ-return
     6384           buf_temp_line-data.d_person       = p-d_person
     6385           buf_temp_line-data.d_empty10      = ""
     6386       .
     6387       put stream excel-line unformatted
     6388                           buf_temp_line-data.sheet-name
     6389           CHR(9)   buf_temp_line-data.data-key
     6390           CHR(9)   buf_temp_line-data.d_znumber
     6391           CHR(9)   buf_temp_line-data.d_empty2
     6392           CHR(9)   buf_temp_line-data.d_empty3
     6393           CHR(9)   buf_temp_line-data.d_empty4
     6394           CHR(9)   buf_temp_line-data.d_empty5
     6395           CHR(9)   buf_temp_line-data.d_empty6
     6396           CHR(9)   buf_temp_line-data.d_summ-sale-7
     6397           CHR(9)   buf_temp_line-data.d_summreturn
     6398           CHR(9)   buf_temp_line-data.d_person
     6399           CHR(9)   buf_temp_line-data.d_empty10
     6400           chr(10)
     6401       .
     6402   end.
     6403   end procedure.
     6404   procedure km6xl-run-excel :
     6405   define input parameter p-header-filename    as character        no-undo.
     6406   define input parameter p-data-filename      as character        no-undo.
     6407       define variable v-template-file-name    as character    no-undo.
     6408       define variable v-vb-file-name          as character    no-undo.
     6409       define buffer buf_temp-param for temp-param .
     6410   do
     6411   for buf_temp-param
     6412   on error undo, return error
     6413   :
     6414       create buf_temp-param.
     6415       assign
     6416           v-template-file-name    = search( "exe/km6_97.xlt" )
     6417           v-vb-file-name          = search( "exe/t_form.bas")
     6418       .
     6419       if v-template-file-name = ?
     6420       or v-template-file-name = "":U
     6421       then do:
     6422           message
     6423               "Ошибка имени файла шаблона."
     6424           view-as alert-box error.
     6425       end.
     6426       if v-vb-file-name = ?
     6427       or v-vb-file-name = "":U
     6428       then do:
     6429           message
     6430               "Ошибка имени файла кода обработки."
     6431           view-as alert-box error.
     6432       end.
     6433       run paramls-write in this-procedure (
     6434             input "template":U
     6435           , input "template-file-name":U
     6436           , input v-template-file-name
     6437       ).
     6438       run paramls-write in this-procedure (
     6439             input "template":U
     6440           , input "vb-file-name":U
     6441           , input v-vb-file-name
     6442       ).
     6443       run paramls-write in this-procedure (
     6444             input "data":U
     6445           , input "data-header-filename":U
     6446           , input p-header-filename
     6447       ).
     6448       run paramls-write in this-procedure (
     6449             input "data":U
     6450           , input "data-filename":U
     6451           , input p-data-filename
     6452       ).
     6453       run gbl/macroxlt.p (
     6454           input-output table buf_temp-param
     6455       ) no-error.
     6456       if error-status :error
     6457       then do:
     6458           message
     6459                    vss-workfile vss-revision vss-description
     6460               skip(1)
     6461               skip "Ошибка создания файла Excel."
     6462               skip return-value
     6463               skip trim(error-status :get-message(1))
     6464                    trim(error-status :get-message(2))
     6465                    trim(error-status :get-message(3))
     6466           view-as alert-box error.
     6467           undo, return error .
     6468       end.
     6469   end.
     6470   end procedure.
     6471   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6472   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6473   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6474   PROCEDURE fostatok :
     6475   define input parameter p-host-code   as integer no-undo .
     6476   define input parameter x-store-code  like ub.clients.obj-code    no-undo.
     6477   define input parameter x-store-type  like ub.clients.obj-type    no-undo.
     6478   define input parameter x-tog-shift   as   logical             no-undo.
     6479   define input parameter x-date-start  as date        no-undo.
     6480   define input parameter x-date-end    as date        no-undo.
     6481   define input parameter x-shift-start as integer     no-undo.
     6482   define input parameter x-shift-end   as integer     no-undo.
     6483   define input parameter xTog-obj   as logical no-undo.
     6484   define input parameter p-curr-code as integer no-undo .
     6485   define input parameter p-cashbookid as integer  no-undo .
     6486   define output parameter sum       as decimal   no-undo.
     6487   define output parameter Fact-order  as decimal  no-undo.
     6488   define variable Fact-order#   as decimal  no-undo.
     6489   define variable Fact-orderS   as character  no-undo.
     6490   define variable x-date-start-t  as date   no-undo.
     6491   define variable x-sum-type as character no-undo .
     6492       if x-tog-shift then do:
     6493         assign
     6494         x-sum-type = 'shift-obj':U.
     6495       end.
     6496       else do:
     6497         x-sum-type = 'obj':U.
     6498       end.
     6499   Assign
     6500   Fact-order   = 0
     6501   sum     = 0
     6502   x-date-start-t  = x-date-start + 1 .
     6503   IF x-date-end = date('') then DO:
     6504     Fact-order = 0 .
     6505     For each obj-list no-lock
     6506         WHERE  (NOT xTog-obj OR
     6507                 (x-store-type = obj-list.obj-type
     6508                 AND
     6509                 x-store-code = obj-list.obj-code))
     6510     :
     6511      fact-order# = 0.
     6512      IF  x-TOG-Shift = False Then DO:
     6513         find last arh-fin-doc-schet-nal-obj no-lock where     arh-fin-doc-schet-nal-obj.obj-type = obj-list.obj-type and arh-fin-doc-schet-nal-obj.obj-code = obj-list.obj-code and arh-fin-doc-schet-nal-obj.cli-code          = p-host-code and arh-fin-doc-schet-nal-obj.cli-type          = 'орг':U and arh-fin-doc-schet-nal-obj.calc-curr-code    = p-curr-code and arh-fin-doc-schet-nal-obj.cashbookid    = p-cashbookid and arh-fin-doc-schet-nal-obj.curr-code    = p-curr-code and arh-fin-doc-schet-nal-obj.sum-type = x-sum-type and
     6514             arh-fin-doc-schet-nal-obj.Fact-date <=  x-date-start
     6515             USE-INDEX fact-date  no-error .
     6516        if Available arh-fin-doc-schet-nal-obj THEN  do:
     6517          Assign                          sum     = arh-fin-doc-schet-nal-obj.income - arh-fin-doc-schet-nal-obj.expense                          Fact-order#  = arh-fin-doc-schet-nal-obj.Fact-order.
     6518        end.
     6519      End.
     6520      Else  DO :
     6521         find last arh-fin-doc-schet-nal-obj no-lock where     arh-fin-doc-schet-nal-obj.obj-type = obj-list.obj-type and arh-fin-doc-schet-nal-obj.obj-code = obj-list.obj-code and arh-fin-doc-schet-nal-obj.cli-code          = p-host-code and arh-fin-doc-schet-nal-obj.cli-type          = 'орг':U and arh-fin-doc-schet-nal-obj.calc-curr-code    = p-curr-code and arh-fin-doc-schet-nal-obj.cashbookid    = p-cashbookid and arh-fin-doc-schet-nal-obj.curr-code    = p-curr-code and arh-fin-doc-schet-nal-obj.sum-type = x-sum-type and
     6522              (arh-fin-doc-schet-nal-obj.shift-date  = x-date-start-t and
     6523               arh-fin-doc-schet-nal-obj.shift-num  < x-shift-start or
     6524               arh-fin-doc-schet-nal-obj.shift-date  < x-date-start-t  )
     6525               and arh-fin-doc-schet-nal-obj.shift-num  > 0
     6526               USE-INDEX Shift-num no-error .
     6527         if Available arh-fin-doc-schet-nal-obj THEN  do:
     6528           Assign                          sum     = arh-fin-doc-schet-nal-obj.income - arh-fin-doc-schet-nal-obj.expense                          Fact-order#  = arh-fin-doc-schet-nal-obj.Fact-order.
     6529         end.
     6530       END.
     6531       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     6532     End.
     6533   End.
     6534   Else DO:
     6535     For each obj-list  no-lock WHERE
     6536        (NOT xTog-obj
     6537         OR
     6538         (x-store-type = obj-list.obj-type
     6539         AND
     6540         x-store-code = obj-list.obj-code))
     6541      :
     6542      IF  x-TOG-Shift = False Then DO:
     6543         find last arh-fin-doc-schet-nal-obj no-lock where     arh-fin-doc-schet-nal-obj.obj-type = obj-list.obj-type and arh-fin-doc-schet-nal-obj.obj-code = obj-list.obj-code and arh-fin-doc-schet-nal-obj.cli-code          = p-host-code and arh-fin-doc-schet-nal-obj.cli-type          = 'орг':U and arh-fin-doc-schet-nal-obj.calc-curr-code    = p-curr-code and arh-fin-doc-schet-nal-obj.cashbookid    = p-cashbookid and arh-fin-doc-schet-nal-obj.curr-code    = p-curr-code and arh-fin-doc-schet-nal-obj.sum-type = x-sum-type and
     6544               arh-fin-doc-schet-nal-obj.Fact-date <= x-date-end
     6545               and arh-fin-doc-schet-nal-obj.shift-num = 0
     6546               USE-INDEX fact-date no-error.
     6547        if Available arh-fin-doc-schet-nal-obj THEN  do:
     6548          Assign                          sum     = arh-fin-doc-schet-nal-obj.income - arh-fin-doc-schet-nal-obj.expense                          Fact-order#  = arh-fin-doc-schet-nal-obj.Fact-order.
     6549        end.
     6550      END.
     6551      Else DO:
     6552         find last arh-fin-doc-schet-nal-obj no-lock where     arh-fin-doc-schet-nal-obj.obj-type = obj-list.obj-type and arh-fin-doc-schet-nal-obj.obj-code = obj-list.obj-code and arh-fin-doc-schet-nal-obj.cli-code          = p-host-code and arh-fin-doc-schet-nal-obj.cli-type          = 'орг':U and arh-fin-doc-schet-nal-obj.calc-curr-code    = p-curr-code and arh-fin-doc-schet-nal-obj.cashbookid    = p-cashbookid and arh-fin-doc-schet-nal-obj.curr-code    = p-curr-code and arh-fin-doc-schet-nal-obj.sum-type = x-sum-type and
     6553               (arh-fin-doc-schet-nal-obj.shift-date  = x-date-end and
     6554               arh-fin-doc-schet-nal-obj.shift-num  <= x-shift-end or
     6555               arh-fin-doc-schet-nal-obj.shift-date  < x-date-end       ) and
     6556               arh-fin-doc-schet-nal-obj.shift-num   > 0      use-index shift-num no-error.
     6557         if Available arh-fin-doc-schet-nal-obj THEN  do:
     6558           Assign                          sum     = arh-fin-doc-schet-nal-obj.income - arh-fin-doc-schet-nal-obj.expense                          Fact-order#  = arh-fin-doc-schet-nal-obj.Fact-order.
     6559         end.
     6560       End.
     6561       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     6562     End.
     6563   End.
     6564   END PROCEDURE.
     6565   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6566   FUNCTION LastMonthDate RETURNS DATE    ( INPUT i-date AS DATE ) :
     6567     DEFINE VARIABLE t_date AS DATE NO-UNDO.
     6568     RUN get-last-month-date IN THIS-PROCEDURE ( INPUT i-date, OUTPUT t_date ) NO-ERROR.
     6569     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE t_date ).
     6570   END FUNCTION.
     6571   PROCEDURE get-last-month-date :
     6572     DEFINE  INPUT PARAMETER p-curr-date AS DATE NO-UNDO.
     6573     DEFINE OUTPUT PARAMETER p-last-date AS DATE NO-UNDO.
     6574     DO ON ERROR UNDO, RETURN ERROR :
     6575       ASSIGN p-last-date = DATE( MONTH( p-curr-date ), 28,  YEAR( p-curr-date ) ).
     6576       ASSIGN p-last-date = p-last-date - DAY( p-last-date + 4 ) + 4.
     6577     END.
     6578   END PROCEDURE.
     6579   FUNCTION LastMonthDay  RETURNS INTEGER ( INPUT i-date AS DATE ) :
     6580     DEFINE VARIABLE j_day AS INTEGER NO-UNDO.
     6581     RUN get-last-month-day IN THIS-PROCEDURE ( INPUT i-date, OUTPUT j_day ) NO-ERROR.
     6582     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE j_day ).
     6583   END FUNCTION.
     6584   PROCEDURE get-last-month-day :
     6585     DEFINE  INPUT PARAMETER p-date AS DATE    NO-UNDO.
     6586     DEFINE OUTPUT PARAMETER p-day  AS INTEGER NO-UNDO.
     6587     DEFINE VARIABLE t_date AS DATE NO-UNDO.
     6588     DO ON ERROR UNDO, RETURN ERROR :
     6589       ASSIGN t_date = DATE( MONTH( p-date ), 28,  YEAR( p-date ) ).
     6590       ASSIGN p-day  = DAY( t_date - DAY( t_date + 4 ) + 4 ).
     6591     END.
     6592   END PROCEDURE.
     6593   FUNCTION LastDay-MY  RETURNS INTEGER ( INPUT i-month AS INTEGER, INPUT i-year AS INTEGER ) :
     6594     DEFINE VARIABLE j_day AS INTEGER NO-UNDO.
     6595     RUN get-last-day-MY IN THIS-PROCEDURE ( INPUT i-month, INPUT i-year, OUTPUT j_day ) NO-ERROR.
     6596     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE j_day ).
     6597   END FUNCTION.
     6598   PROCEDURE get-last-day-MY :
     6599     DEFINE  INPUT PARAMETER p-month AS INTEGER NO-UNDO.
     6600     DEFINE  INPUT PARAMETER p-year  AS INTEGER NO-UNDO.
     6601     DEFINE OUTPUT PARAMETER p-day   AS INTEGER NO-UNDO.
     6602     DEFINE VARIABLE t_date AS DATE NO-UNDO.
     6603     DO ON ERROR UNDO, RETURN ERROR :
     6604       ASSIGN t_date = DATE( p-month, 28, p-year ).
     6605       ASSIGN p-day  = DAY( t_date - DAY( t_date + 4 ) + 4 ).
     6606     END.
     6607   END PROCEDURE.
     6608   FUNCTION LastDate-MY RETURNS DATE    ( INPUT i-month AS INTEGER, INPUT i-year AS INTEGER ) :
     6609     DEFINE VARIABLE t_date AS DATE NO-UNDO.
     6610     RUN get-last-date-MY IN THIS-PROCEDURE ( INPUT i-month, INPUT i-year, OUTPUT t_date ) NO-ERROR.
     6611     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE t_date ).
     6612   END FUNCTION.
     6613   PROCEDURE get-last-date-MY :
     6614     DEFINE  INPUT PARAMETER p-month AS INTEGER NO-UNDO.
     6615     DEFINE  INPUT PARAMETER p-year  AS INTEGER NO-UNDO.
     6616     DEFINE OUTPUT PARAMETER p-date  AS DATE    NO-UNDO.
     6617     DO ON ERROR UNDO, RETURN ERROR :
     6618       ASSIGN p-date = DATE( p-month, 28, p-year ).
     6619       ASSIGN p-date = p-date - DAY( p-date + 4 ) + 4.
     6620     END.
     6621   END PROCEDURE.
     6622   FUNCTION NextMonth RETURNS INTEGER ( INPUT i-date AS DATE ) :
     6623     DEFINE VARIABLE j_month AS INTEGER NO-UNDO.
     6624     RUN get-next-month IN THIS-PROCEDURE ( INPUT i-date, OUTPUT j_month ) NO-ERROR.
     6625     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE j_month ).
     6626   END FUNCTION.
     6627   PROCEDURE get-next-month :
     6628     DEFINE  INPUT PARAMETER p-date  AS DATE    NO-UNDO.
     6629     DEFINE OUTPUT PARAMETER p-month AS INTEGER NO-UNDO.
     6630     DO ON ERROR UNDO, RETURN ERROR :
     6631       ASSIGN p-month = ( MONTH( p-date ) MODULO 12 ) + 1.
     6632     END.
     6633   END PROCEDURE.
     6634   FUNCTION NextYear  RETURNS INTEGER ( INPUT i-date AS DATE ) :
     6635     DEFINE VARIABLE j_year AS INTEGER NO-UNDO.
     6636     RUN get-next-year IN THIS-PROCEDURE ( INPUT i-date, OUTPUT j_year ) NO-ERROR.
     6637     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE j_year ).
     6638   END FUNCTION.
     6639   PROCEDURE get-next-year :
     6640     DEFINE  INPUT PARAMETER p-date AS DATE    NO-UNDO.
     6641     DEFINE OUTPUT PARAMETER p-year AS INTEGER NO-UNDO.
     6642     DO ON ERROR UNDO, RETURN ERROR :
     6643       ASSIGN p-year = YEAR( p-date ) + ( IF MONTH( p-date ) < 12 THEN 0 ELSE 1 ).
     6644     END.
     6645   END PROCEDURE.
     6646   FUNCTION PrevMonth RETURNS INTEGER ( INPUT i-date AS DATE ) :
     6647     DEFINE VARIABLE j_month AS INTEGER NO-UNDO.
     6648     RUN get-prev-month IN THIS-PROCEDURE ( INPUT i-date, OUTPUT j_month ) NO-ERROR.
     6649     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE j_month ).
     6650   END FUNCTION.
     6651   PROCEDURE get-prev-month :
     6652     DEFINE  INPUT PARAMETER p-date  AS DATE    NO-UNDO.
     6653     DEFINE OUTPUT PARAMETER p-month AS INTEGER NO-UNDO.
     6654     DO ON ERROR UNDO, RETURN ERROR :
     6655       ASSIGN p-month = ( ( ( MONTH( p-date ) + 10 ) MODULO 12 ) MODULO 12 ) + 1.
     6656     END.
     6657   END PROCEDURE.
     6658   FUNCTION PrevYear  RETURNS INTEGER ( INPUT i-date AS DATE ) :
     6659     DEFINE VARIABLE j_year AS INTEGER NO-UNDO.
     6660     RUN get-prev-year IN THIS-PROCEDURE ( INPUT i-date, OUTPUT j_year ) NO-ERROR.
     6661     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE j_year ).
     6662   END FUNCTION.
     6663   PROCEDURE get-prev-year :
     6664     DEFINE  INPUT PARAMETER p-date AS DATE    NO-UNDO.
     6665     DEFINE OUTPUT PARAMETER p-year AS INTEGER NO-UNDO.
     6666     DO ON ERROR UNDO, RETURN ERROR :
     6667       ASSIGN p-year = YEAR( p-date ) + ( IF MONTH( p-date ) = 1 THEN -1 ELSE 0 ).
     6668     END.
     6669   END PROCEDURE.
     6670   FUNCTION NextMonth-MY RETURNS INTEGER ( INPUT i-month AS INTEGER ) :
     6671     DEFINE VARIABLE j_month AS INTEGER NO-UNDO.
     6672     RUN get-next-month-MY IN THIS-PROCEDURE ( INPUT i-month, OUTPUT j_month ) NO-ERROR.
     6673     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE j_month ).
     6674   END FUNCTION.
     6675   PROCEDURE get-next-month-MY :
     6676     DEFINE  INPUT PARAMETER p-curr-month AS INTEGER NO-UNDO.
     6677     DEFINE OUTPUT PARAMETER p-next-month AS INTEGER NO-UNDO.
     6678     DO ON ERROR UNDO, RETURN ERROR :
     6679       ASSIGN p-next-month = ( p-curr-month MODULO 12 ) + 1.
     6680     END.
     6681   END PROCEDURE.
     6682   FUNCTION NextYear-MY  RETURNS INTEGER ( INPUT i-month AS INTEGER, INPUT i-year AS INTEGER ) :
     6683     DEFINE VARIABLE j_year AS INTEGER NO-UNDO.
     6684     RUN get-next-year-MY IN THIS-PROCEDURE ( INPUT i-month, INPUT i-year, OUTPUT j_year ) NO-ERROR.
     6685     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE j_year ).
     6686   END FUNCTION.
     6687   PROCEDURE get-next-year-MY :
     6688     DEFINE  INPUT PARAMETER p-curr-month AS INTEGER NO-UNDO.
     6689     DEFINE  INPUT PARAMETER p-curr-year  AS INTEGER NO-UNDO.
     6690     DEFINE OUTPUT PARAMETER p-next-year  AS INTEGER NO-UNDO.
     6691     DO ON ERROR UNDO, RETURN ERROR :
     6692       ASSIGN p-next-year = p-curr-year + ( IF p-curr-month < 12 THEN 0 ELSE 1 ).
     6693     END.
     6694   END PROCEDURE.
     6695   FUNCTION MonthNameRus RETURNS CHARACTER ( INPUT i-month AS INTEGER ) :
     6696     DEFINE VARIABLE v-name AS CHARACTER NO-UNDO.
     6697     RUN get-month-name-rus IN THIS-PROCEDURE ( INPUT i-month, OUTPUT v-name ) NO-ERROR.
     6698     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE v-name ).
     6699   END FUNCTION.
     6700   PROCEDURE get-month-name-rus :
     6701     DEFINE  INPUT PARAMETER p-month AS INTEGER   NO-UNDO.
     6702     DEFINE OUTPUT PARAMETER p-name  AS CHARACTER NO-UNDO.
     6703     DEFINE VARIABLE v-list AS CHARACTER NO-UNDO INITIAL "Январь,Февраль,Март,Апрель,Май,Июнь,Июль,Август,Сентябрь,Октябрь,Ноябрь,Декабрь".
     6704     DO ON ERROR UNDO, RETURN ERROR :
     6705       ASSIGN p-name = ( IF p-month >= 1 AND p-month <= 12 THEN ENTRY( p-month, v-list ) ELSE ? ).
     6706     END.
     6707   END PROCEDURE.
     6708   FUNCTION MonthNameRusGen RETURNS CHARACTER ( INPUT i-month AS INTEGER ) :
     6709     DEFINE VARIABLE v-name AS CHARACTER NO-UNDO.
     6710     RUN get-month-name-gen IN THIS-PROCEDURE ( INPUT i-month, OUTPUT v-name ) NO-ERROR.
     6711     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE v-name ).
     6712   END FUNCTION.
     6713   PROCEDURE get-month-name-gen :
     6714     DEFINE  INPUT PARAMETER p-month AS INTEGER   NO-UNDO.
     6715     DEFINE OUTPUT PARAMETER p-name  AS CHARACTER NO-UNDO.
     6716     DEFINE VARIABLE v-list AS CHARACTER NO-UNDO INITIAL "Января,Февраля,Марта,Апреля,Мая,Июня,Июля,Августа,Сентября,Октября,Ноября,Декабря".
     6717     DO ON ERROR UNDO, RETURN ERROR :
     6718       ASSIGN p-name = ( IF p-month >= 1 AND p-month <= 12 THEN ENTRY( p-month, v-list ) ELSE ? ).
     6719     END.
     6720   END PROCEDURE.
     6721   FUNCTION CalcMonthes  RETURNS INTEGER ( INPUT i-date-from AS DATE, INPUT i-date-till AS DATE ) :
     6722     DEFINE VARIABLE j_month-num AS INTEGER NO-UNDO.
     6723     RUN get-month-number IN THIS-PROCEDURE ( INPUT i-date-from, INPUT i-date-till, OUTPUT j_month-num ) NO-ERROR.
     6724     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE j_month-num ).
     6725   END FUNCTION.
     6726   PROCEDURE get-month-number :
     6727     DEFINE  INPUT PARAMETER p-date-from AS DATE    NO-UNDO.
     6728     DEFINE  INPUT PARAMETER p-date-till AS DATE    NO-UNDO.
     6729     DEFINE OUTPUT PARAMETER p-month-num AS INTEGER NO-UNDO.
     6730     DO ON ERROR UNDO, RETURN ERROR :
     6731       ASSIGN p-month-num = ( YEAR(  p-date-till ) - YEAR(  p-date-from ) ) * 12 +
     6732                              MONTH( p-date-till ) - MONTH( p-date-from )   +  1 .
     6733     END.
     6734   END PROCEDURE.
     6735   FUNCTION CalcMonth-MY RETURNS INTEGER ( INPUT i-year-from  AS INTEGER,
     6736                                           INPUT i-month-from AS INTEGER,
     6737                                           INPUT i-year-till  AS INTEGER,
     6738                                           INPUT i-month-till AS INTEGER  ) :
     6739     DEFINE VARIABLE j_month-num AS INTEGER NO-UNDO.
     6740     RUN get-month-num-MY IN THIS-PROCEDURE (  INPUT i-year-from,
     6741                                               INPUT i-month-from,
     6742                                               INPUT i-year-till,
     6743                                               INPUT i-month-till,
     6744                                              OUTPUT j_month-num   ) NO-ERROR.
     6745     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE j_month-num ).
     6746   END FUNCTION.
     6747   PROCEDURE get-month-num-MY :
     6748     DEFINE  INPUT PARAMETER p-year-from  AS INTEGER NO-UNDO.
     6749     DEFINE  INPUT PARAMETER p-month-from AS INTEGER NO-UNDO.
     6750     DEFINE  INPUT PARAMETER p-year-till  AS INTEGER NO-UNDO.
     6751     DEFINE  INPUT PARAMETER p-month-till AS INTEGER NO-UNDO.
     6752     DEFINE OUTPUT PARAMETER p-month-num  AS INTEGER NO-UNDO.
     6753     DO ON ERROR UNDO, RETURN ERROR :
     6754       ASSIGN p-month-num = ( p-year-till - p-year-from ) * 12 + p-month-till - p-month-from + 1.
     6755     END.
     6756   END PROCEDURE.
     6757   FUNCTION DateTimeHeader RETURNS CHARACTER ( INPUT i-date AS DATE ) :
     6758     DEFINE VARIABLE v-header AS CHARACTER NO-UNDO.
     6759     RUN get-date-time-header IN THIS-PROCEDURE ( INPUT i-date, OUTPUT v-header ) NO-ERROR.
     6760     RETURN ( IF ERROR-STATUS :ERROR THEN "":U ELSE v-header ).
     6761   END FUNCTION.
     6762   PROCEDURE get-date-time-header :
     6763     DEFINE  INPUT PARAMETER p-date AS DATE      NO-UNDO.
     6764     DEFINE OUTPUT PARAMETER p-head AS CHARACTER NO-UNDO.
     6765     DO ON ERROR UNDO, RETURN ERROR :
     6766       IF p-date = ? THEN DO: ASSIGN p-date = TODAY. END.
     6767       ASSIGN p-head = "Дата печати: " + STRING( p-date, "99.99.9999":U ) + ", ":U + STRING( TIME, "HH:MM":U ).
     6768     END.
     6769   END PROCEDURE.
     6770   FUNCTION Leap-Year RETURNS LOGICAL ( INPUT i-year AS INTEGER ) :
     6771     DEFINE VARIABLE bissextile AS LOGICAL NO-UNDO.
     6772     RUN get-leap-year-sign IN THIS-PROCEDURE ( INPUT i-year, OUTPUT bissextile ) NO-ERROR.
     6773     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE bissextile ).
     6774   END FUNCTION.
     6775   PROCEDURE get-leap-year-sign :
     6776     DEFINE  INPUT PARAMETER p-year AS INTEGER NO-UNDO.
     6777     DEFINE OUTPUT PARAMETER p-sign AS LOGICAL NO-UNDO.
     6778     DEFINE VARIABLE t_date AS DATE NO-UNDO.
     6779     DO ON ERROR UNDO, RETURN ERROR :
     6780       IF p-year = ? OR p-year = 0 THEN DO:
     6781         ASSIGN t_date = TODAY.
     6782         IF t_date <> TODAY THEN DO: ASSIGN t_date = TODAY. END.
     6783         ASSIGN p-year = YEAR( t_date ).
     6784       END.
     6785       ASSIGN p-sign = ( INTEGER( TRUNCATE( p-year * 0.25, 0 ) ) * 4 = p-year ).
     6786     END.
     6787   END PROCEDURE.
     6788   FUNCTION Leap-Year-d RETURNS LOGICAL ( INPUT i-date AS DATE ) :
     6789     DEFINE VARIABLE bissextile AS LOGICAL NO-UNDO.
     6790     RUN get-leap-year-sign-d IN THIS-PROCEDURE ( INPUT i-date, OUTPUT bissextile ) NO-ERROR.
     6791     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE bissextile ).
     6792   END FUNCTION.
     6793   PROCEDURE get-leap-year-sign-d :
     6794     DEFINE  INPUT PARAMETER p-date AS DATE    NO-UNDO.
     6795     DEFINE OUTPUT PARAMETER p-sign AS LOGICAL NO-UNDO.
     6796     DEFINE VARIABLE j-year AS INTEGER NO-UNDO.
     6797     DO ON ERROR UNDO, RETURN ERROR :
     6798       IF p-date = ? THEN DO:
     6799         ASSIGN p-date = TODAY.
     6800         IF p-date <> TODAY THEN DO: ASSIGN p-date = TODAY. END.
     6801       END.
     6802       ASSIGN j-year = YEAR( p-date ).
     6803       ASSIGN p-sign = ( INTEGER( TRUNCATE( j-year * 0.25, 0 ) ) * 4 = j-year ).
     6804     END.
     6805   END PROCEDURE.
