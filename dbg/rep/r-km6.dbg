     2149   define new global shared variable g#trdcalib as handle no-undo.
     2150   procedure wthcattr-sprcli :
     2151   define input parameter parparentproc  as widget-handle no-undo.
     2152   define input parameter p-mode  as character no-undo.
     2153   define input-output parameter p-value as character no-undo .
     2154   define output parameter p-setted as logical no-undo .
     2155     DEFINE VARIABLE v-value as character no-undo .
     2156     define variable v-cli-type as character no-undo .
     2157     define variable v-cli-code as integer no-undo .
     2158     define buffer buf_clients   for ub.clients.
     2159     define variable v_rid as character no-undo.
     2160     define variable ref-rec as recid no-undo .
     2161     do
     2162     on error undo, return error
     2163     :
     2164         v-value = p-value.
     2165      if p-value <> '':U then do:
     2166       assign
     2167       v-cli-type = substring(p-value, 1, 3)
     2168       v-cli-code = integer(substring(p-value, 4))
     2169       no-error.
     2170       if error-status:error then do:
     2171         assign
     2172         v-cli-type = '':U
     2173         v-cli-code = 0
     2174         .
     2175       end.
     2176      end.
     2177      FIND FIRST buf_clients NO-LOCK WHERE
     2178               buf_clients.obj-type = v-cli-type AND
     2179               buf_clients.obj-code = v-cli-code  NO-ERROR.
     2180      IF available(buf_clients) then do:
     2181       run ref/cli-all.w (
     2182                   input parparentproc
     2183                  ,input if p-mode = 'ИЗМЕНЕНИЕ':U then "b-sel":U else "":U
     2184                  ,input v-cli-type
     2185                  ,input 'все':U
     2186                  ,input 'все':U
     2187                  ,input RECID( buf_clients )
     2188                  ,input ",,,,,,NO"
     2189                  ,input ?
     2190                  ,OUTPUT v_rid ).
     2191     END.
     2192     ELSE if p-mode = 'ИЗМЕНЕНИЕ':U then DO:
     2193       run ref/cli-all.w (
     2194                    input parparentproc
     2195                   ,INPUT "b-sel":U
     2196                  ,input  v-cli-type
     2197                  ,input 'все':U
     2198                  ,input 'текущие':U
     2199                  ,input ?
     2200                  ,input ",,,,,,NO"
     2201                  ,input ?
     2202                  ,OUTPUT v_rid ).
     2203     END.
     2204     else do:
     2205       message
     2206       if p-value = "":U then 'Атрибут не задан!'
     2207       else substitute('Не найден клиент &1',p-value)
     2208       view-as alert-box warning.
     2209     end.
     2210     IF v_rid <> ? AND v_rid <> "":U THEN DO:
     2211       ASSIGN ref-rec = INT( v_rid ) NO-ERROR.
     2212       IF ERROR-STATUS:ERROR THEN DO:
     2213           RETURN NO-APPLY.
     2214       END.
     2215       FIND FIRST buf_clients NO-LOCK WHERE
     2216                  RECID( buf_clients ) = ref-rec NO-ERROR.
     2217       IF AVAIL buf_clients THEN DO:
     2218         v-value = buf_clients.obj-type + string(buf_clients.obj-code, ">>>>>>>>9").
     2219       end.
     2220     end.
     2221     if v-value <> p-value then do:
     2222       p-value = v-value.
     2223       p-setted = yes.
     2224     end.
     2225     end.
     2226   end procedure.
     2227     define new global shared variable g#wthcalib as handle no-undo.
     2228   procedure torgconf-read :
     2229   do
     2230   on error undo, return error
     2231   :
     2232       define input parameter p-form-name  as character    no-undo.
     2233       define input parameter p-host-code  as integer      no-undo.
     2234       define input parameter p-obj-type   as character    no-undo.
     2235       define input parameter p-obj-code   as integer      no-undo.
     2236       define variable v-outdate   as character     no-undo.
     2237       define variable v-outares   as character     no-undo.
     2238       define variable v-outsend   as character     no-undo.
     2239       define variable v-outasend  as character     no-undo.
     2240       define variable v-outprops  as character     no-undo.
     2241       define variable v-outnum    as character     no-undo.
     2242       define variable v-outprim   as character     no-undo.
     2243       define variable v-outdisc   as character     no-undo.
     2244       define variable v-outsubs   as character     no-undo.
     2245       define variable v-outrecv   as character     no-undo.
     2246       define variable v-outegrp   as character     no-undo.
     2247       define variable v-outt12    as character     no-undo.
     2248       define variable v-outappr   as character     no-undo.
     2249       define variable v-outrubl   as character     no-undo.
     2250       define variable v-outhold   as character     no-undo.
     2251       define variable v-outobj    as character     no-undo.
     2252       define variable v-outexlst  as character     no-undo.
     2253       define variable v-outprncd  as character     no-undo.
     2254       define variable v-par-type  as character     no-undo.
     2255       define variable v-outogr    as character     no-undo.
     2256       define variable v-outR      as character     no-undo.
     2257       define variable v-outB      as character     no-undo.
     2258       define variable v-outC      as character     no-undo.
     2259       assign
     2260           v-torgconf-outdate  = no
     2261           v-torgconf-outnum   = no
     2262           v-torgconf-outprim  = no
     2263           v-torgconf-outdisc  = no
     2264           v-torgconf-outsubs  = no
     2265           v-torgconf-outrecv  = no
     2266           v-torgconf-outegrp  = no
     2267           v-torgconf-outt12   = no
     2268           v-torgconf-outappr  = no
     2269           v-torgconf-outrubl  = no
     2270           v-torgconf-outhold  = no
     2271           v-torgconf-outobj   = no
     2272           v-torgconf-outexlst = no
     2273           v-torgconf-outexpas = "":U
     2274           v-torgconf-outprncd = yes
     2275           v-torgconf-outares  = no
     2276           v-torgconf-outsend  = no
     2277           v-torgconf-outasend  = no
     2278           v-torgconf-outprops  = no
     2279           v-form-name          = p-form-name
     2280       .
     2281   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2282   empty temp-table thbjattr_thbj-attr.
     2283   run adm/shattri.p (
     2284      input "get":U
     2285     ,input ''
     2286     ,input 0
     2287     ,input 'prt-glob':U
     2288     ,input  ""
     2289     ,output v-value-character
     2290     ,output v-value-date
     2291     ,output v-value-decimal
     2292     ,output v-value-integer
     2293     ,output v-value-logical
     2294     ,output par-type
     2295     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     2296     ) no-error .
