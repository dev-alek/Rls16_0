     5394   find first buf_fin-doc-attr  exclusive-lock  where
     5395             buf_fin-doc-attr.attr-code    = p-attr-code
     5396         AND buf_fin-doc-attr.host-code    = p-host-code
     5397         AND buf_fin-doc-attr.fin-doc-code     = p-fin-doc-code  no-error .
     5398     if not available  buf_fin-doc-attr then do:
     5399         create buf_fin-doc-attr.
     5400         assign
     5401         buf_fin-doc-attr.attr-code    = p-attr-code
     5402         buf_fin-doc-attr.attr-value   = p-attr-value
     5403         buf_fin-doc-attr.host-code    = p-host-code
     5404         buf_fin-doc-attr.fin-doc-code     = p-fin-doc-code
     5405         .
     5406     end.
     5407     else do:
     5408          assign
     5409          buf_fin-doc-attr.attr-value = p-attr-value.
     5410     end.
     5411    end.
     5412   end procedure.
