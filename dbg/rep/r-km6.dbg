     5541       case p-code :
     5542               when 'shift-date':U then do:     assign     p-news = no.   end.
     5543               when 'shift-num':U then do:     assign     p-news = no.   end.
     5544               when 'shift-name':U then do:     assign     p-news = no.   end.
     5545               when 'barcode':U then do:     assign     p-news = no.   end.
     5546               when 'lockid':U then do:     assign     p-news = no.   end.
     5547               when 'cover_sheet':U then do:     assign     p-news = no.   end.
     5548               when 'pre-vedom':U then do:     assign     p-news = no.   end.
     5549         otherwise do:
     5550           undo, return error "неизвестный атрибут платежа " + " " + p-code .
     5551         end.
     5552       end.
     5553     end.
     5554   end procedure.
