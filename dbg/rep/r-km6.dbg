     5376   define variable  v-label          as character no-undo .
     5377   define variable  v-user-can-edit  as logical   no-undo .
     5378   define variable  v-output-display as logical   no-undo .
     5379   define variable  v-other          as character no-undo .
     5380   define variable  v-type           as character no-undo .
