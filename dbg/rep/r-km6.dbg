     2604       v-type-rec = substring(v-recipient-code,1,3)
     2605       v-code-rec  = int(substring(v-recipient-code,4,15))
     2606       no-error
     2607     .
     2608     if v-type-rec = ? then v-type-rec = "" .
     2609     if v-code-rec  = ? then v-code-rec  =  0 .
