     6915   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     6916   DEFINE BUTTON StopBtn AUTO-END-KEY
     6917        LABEL "Стоп"
     6918        SIZE 10 BY 1.
     6919   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     6920        LABEL "Обработано записей"
     6921         VIEW-AS TEXT
     6922        SIZE 14 BY .67 NO-UNDO.
