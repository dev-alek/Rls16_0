     1361   procedure partslib-update-by-factord :
     1362     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
     1363     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
     1364     define input parameter p-artic              like ub.parts.artic     no-undo .
     1365     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
     1366     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
     1367     define input parameter p-start-fact-order   as decimal   no-undo .
