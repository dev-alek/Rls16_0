     1386           "Объект" p-obj-type p-obj-code skip
     1387           "Артикул" p-artic p-prod-type p-prod-code skip
     1388           "p-start-fact-order" p-start-fact-order skip
     1389           "p-end-fact-order"   p-end-fact-order skip
     1390           view-as alert-box error .
     1391         undo, return error .
     1392       end.
     1393       if p-lock-gds-obj = true
     1394       then do:
     1395         do transaction
     1396         on error undo, return error
     1397         :
     1398   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1399   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     1400     (input  p-obj-type
