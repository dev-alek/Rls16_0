     1288             error-status :get-message(1) skip
     1289             return-value skip
     1290             view-as alert-box error .
     1291           undo, return error .
     1292         end.
     1293         find current buf_gds-obj exclusive-lock .
     1294       end.
     1295       run partslib-init-temp-parts in this-procedure
     1296         (input p-obj-type
     1297         ,input p-obj-code
     1298         ,input p-artic
     1299         ,input p-prod-type
     1300         ,input p-prod-code
     1301         ) no-error .
     1302       if error-status :error
     1303       then do:
