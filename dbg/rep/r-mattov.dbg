     4669                 by temp-gds-post.post-code
     4670                 by if xSortType = "sort-article" then  temp-gds-post.artic      Else  temp-gds-post.gds-name :
     4671           if first-of(temp-gds-post.cgrp-name) then run PrintName ( "Гр. пост. " + temp-gds-post.cgrp-name ) .
     4672           if first-of(temp-gds-post.grp-name)  then run PrintName ( "  Группа " + temp-gds-post.grp-name ) .
     4673           if first-of(temp-gds-post.post-code) then do:
     4674             find first buf_clients no-lock where buf_clients.obj-type = temp-gds-post.post-type and buf_clients.obj-code = temp-gds-post.post-code no-error .
     4675             run PrintName ( "    Поставщик " + buf_clients.obj-name ) .
     4676           end.
     4677           run PrintLine  in this-procedure ( temp-gds-post.qnty1, temp-gds-post.qnty2, temp-gds-post.min-qnty, temp-gds-post.artic, temp-gds-post.gds-name, temp-gds-post.unit-base) .
     4678           if last-of(temp-gds-post.post-code)  then Run PrintItog ("    Всего по поставщику " + buf_clients.obj-name, 1).
     4679           if last-of(temp-gds-post.grp-name)   then Run PrintItog ("  Всего по группе " + temp-gds-post.grp-name, 2).
     4680           if last-of(temp-gds-post.cgrp-name)  then Run PrintItog ("Всего по гр. пост. " + temp-gds-post.cgrp-name, 3).
     4681         end.
     4682       end.
     4683     end.
     4684   end procedure.
     4685   procedure Run7 :
     4686     do on error undo, return error return-value :
     4687       if  p-Rad-Inter = 1  then do:
     4688         for each temp-gds-time-post
     4689           break by temp-gds-time-post.dt
     4690                 by temp-gds-time-post.tm
     4691                 by temp-gds-time-post.grp-name
     4692                 by temp-gds-time-post.cgrp-name
     4693                 by temp-gds-time-post.post-type
     4694                 by temp-gds-time-post.post-code
     4695                 by if xSortType = "sort-article" then  temp-gds-time-post.artic Else  temp-gds-time-post.gds-name :
     4696           if first-of(temp-gds-time-post.tm)        then run PrintTime ( string(temp-gds-time-post.dt,"99/99/99") + " " + string(temp-gds-time-post.tm,"99") + ".00" ) .
     4697           if first-of(temp-gds-time-post.grp-name)  then run PrintName ( "  Группа " + temp-gds-time-post.grp-name ) .
     4698           if first-of(temp-gds-time-post.cgrp-name) then run PrintName ( "    Гр. пост. " + temp-gds-time-post.cgrp-name ) .
     4699           if first-of(temp-gds-time-post.post-code) then do:
     4700             find first buf_clients no-lock where buf_clients.obj-type = temp-gds-time-post.post-type and buf_clients.obj-code = temp-gds-time-post.post-code no-error .
     4701             run PrintName ( "      Поставщик " + buf_clients.obj-name ) .
     4702           end.
     4703           run PrintLine  in this-procedure ( temp-gds-time-post.qnty1, temp-gds-time-post.qnty2, temp-gds-time-post.min-qnty, temp-gds-time-post.artic, temp-gds-time-post.gds-name, temp-gds-time-post.unit-base) .
     4704           if last-of(temp-gds-time-post.post-code)  then Run PrintItog ("      Всего по поставщику " + buf_clients.obj-name, 1).
     4705           if last-of(temp-gds-time-post.cgrp-name)  then Run PrintItog ("    Всего по гр. пост. " + temp-gds-time-post.cgrp-name, 2).
     4706           if last-of(temp-gds-time-post.grp-name)   then Run PrintItog ("  Всего по группе " + temp-gds-time-post.grp-name, 3).
     4707           if last-of(temp-gds-time-post.tm)  then Run PrintItog ("Всего ", 4).
     4708         end.
     4709       end.
     4710       else do:
     4711         for each temp-gds-post
     4712           break by temp-gds-post.grp-name
     4713                 by temp-gds-post.cgrp-name
     4714                 by temp-gds-post.post-type
     4715                 by temp-gds-post.post-code
     4716                 by if xSortType = "sort-article" then  temp-gds-post.artic      Else  temp-gds-post.gds-name :
     4717           if first-of(temp-gds-post.grp-name) then  run PrintName ( "Группа " + temp-gds-post.grp-name ) .
     4718           if first-of(temp-gds-post.cgrp-name) then run PrintName ( "  Гр. пост. " + temp-gds-post.cgrp-name ) .
     4719           if first-of(temp-gds-post.post-code) then do:
     4720             find first buf_clients no-lock where buf_clients.obj-type = temp-gds-post.post-type and buf_clients.obj-code = temp-gds-post.post-code no-error .
     4721             run PrintName ( "    Поставщик " + buf_clients.obj-name ) .
     4722           end.
     4723           run PrintLine  in this-procedure ( temp-gds-post.qnty1, temp-gds-post.qnty2, temp-gds-post.min-qnty, temp-gds-post.artic, temp-gds-post.gds-name, temp-gds-post.unit-base) .
     4724           if last-of(temp-gds-post.post-code)  then Run PrintItog ("    Всего по поставщику " + buf_clients.obj-name, 1).
     4725           if last-of(temp-gds-post.cgrp-name)  then Run PrintItog ("  Всего по гр. пост. " + temp-gds-post.cgrp-name, 2).
     4726           if last-of(temp-gds-post.grp-name)   then Run PrintItog ("Всего по группе " + temp-gds-post.grp-name, 3).
     4727         end.
     4728       end.
     4729     end.
     4730   end procedure.
     4731   procedure ColumnTitle :
     4732     do on error undo, return error return-value :
     4733       if v-table = 1 then do:
     4734         if  p-Rad-Inter = 1  then do:
     4735           put stream PrnLibStream   Line format frmt skip .
     4736           PUT stream PrnLibStream  "|"  "Час"                format "X(15)"  .
     4737         end.
     4738         else put stream PrnLibStream   Line format "X(107)" skip .
     4739         PUT stream PrnLibStream
     4740           "|"  " Всего товаров"     format "X(15)"
     4741           "|"  " С не 0 остатком"   format "X(17)"
     4742           "|"  " Разница"           format "X(15)"
     4743           "|"  "   %"               format "X(10)"
     4744           "|"  " С не 0 остатком"   format "X(17)"
     4745           "|"  " Разница"           format "X(15)"
     4746           "|"  "   %"               format "X(10)"
     4747          "|"   skip .
     4748         if  p-Rad-Inter = 1  then do:
     4749           PUT stream PrnLibStream  "|"  " "  format "X(15)"  .
     4750         end.
     4751         PUT stream PrnLibStream
     4752           "|"  ""                   format "X(15)"
     4753           "|"  string("на " + p-cli-type1 + string( p-cli-code1 ))                  format "X(17)"
     4754           "|"  ""                   format "X(15)"
     4755           "|"  ""                   format "X(10)"
     4756           "|"  string("на " + p-cli-type1 + string( p-cli-code1 ) + "+" + p-cli-type2 + string( p-cli-code2 ))         format "X(17)"
     4757           "|"  ""                   format "X(15)"
     4758           "|"  ""                   format "X(10)"
     4759           "|"   skip .
     4760         if  p-Rad-Inter = 1  then  put stream PrnLibStream   Line format frmt skip .
     4761         else put stream PrnLibStream   Line format "X(107)" skip .
     4762       end.
     4763       else do:
     4764         if  p-Rad-Inter = 1  then do:
     4765           put stream PrnLibStream   Line format "X(132)" skip .
     4766           PUT stream PrnLibStream
     4767             "|"  "  №"                  format "X(5)"
     4768             "|"  " Час"                 format "X(14)"
     4769           .
     4770         end.
     4771         else do:
     4772           put stream PrnLibStream   Line format "X(117)" skip
     4773             "|"  "  №"                  format "X(5)"
     4774           .
     4775         end.
     4776         PUT stream PrnLibStream
     4777           "|"  " Артикул"             format "X(16)"
     4778           "|"  " Наименование товара" format "X(40)"
     4779           "|"  "Ед."                  format "X(3)"
     4780           "|"  " мин. остаток"        format "X(15)"
     4781           "|"  " остаток на "         format "X(15)"
     4782           "|"  " остаток на "         format "X(15)"
     4783           "|"   skip .
     4784         if  p-Rad-Inter = 1  then do:
     4785           PUT stream PrnLibStream  "|"  " "  format "X(5)"  "|"  " "  format "X(14)"  .
     4786         end.
     4787         else PUT stream PrnLibStream  "|"  " "  format "X(5)"  .
     4788         PUT stream PrnLibStream
     4789           "|"  ""                   format "X(16)"
     4790           "|"  ""                   format "X(40)"
     4791           "|"  "изм"                format "X(3)"
     4792           "|"  string("на " + p-cli-type1 + string( p-cli-code1 ))    format "X(15)"
     4793           "|"  string( p-cli-type1 + string( p-cli-code1 ))           format "X(15)"
     4794           "|"  string( p-cli-type2 + string( p-cli-code2 ))           format "X(15)"
     4795           "|"   skip .
     4796         if  p-Rad-Inter = 1  then  put stream PrnLibStream   Line format "X(132)" skip .
     4797         else put stream PrnLibStream   Line format "X(117)" skip .
     4798       end.
     4799     end.
     4800   end procedure.
     4801   procedure is-page :
     4802     do on error undo, return error return-value :
     4803       if line-counter( PrnLibStream ) + 2 > page-size( PrnLibStream ) then do:
     4804         put stream PrnLibStream  skip Line format frmt skip "продолжение - на следующей странице" AT 30 SKIP .
     4805         page stream PrnLibStream .
     4806         run ColumnTitle .
     4807       end.
     4808     end.
     4809   end procedure.
     4810   procedure PrintLine :
     4811     do on error undo, return error return-value :
     4812       define input  parameter p-qnty1     as decimal   no-undo .
     4813       define input  parameter p-qnty2     as decimal   no-undo .
     4814       define input  parameter p-min-qnty  as decimal   no-undo .
     4815       define input  parameter p-artic     as character no-undo .
     4816       define input  parameter p-gds-name  as character no-undo .
     4817       define input  parameter p-unit-base as character no-undo .
     4818       if v-table = 1 then do:
     4819         find first temp-sum where temp-sum.num = 0 no-error .
     4820         if not available temp-sum then do:
     4821           create temp-sum .
     4822           assign temp-sum.num = 0 .
     4823         end.
     4824         assign temp-sum.qnty1 = temp-sum.qnty1 + 1 .
     4825         if p-qnty1 > 0 then assign temp-sum.qnty2 = temp-sum.qnty2 + 1 .
     4826         if p-qnty1 + p-qnty2 > 0 then assign temp-sum.qnty3 = temp-sum.qnty3 + 1 .
     4827         if  xtog-lavel or xtog-lavel-2 then do:
     4828           for each tt-grp-tree :
     4829             assign
     4830               tt-grp-tree.qnty1 = tt-grp-tree.qnty1 + 1
     4831               tt-grp-tree.qnty2 = tt-grp-tree.qnty2 + if p-qnty1 > 0 then 1 else 0
     4832               tt-grp-tree.qnty3 = tt-grp-tree.qnty3 + if p-qnty1 + p-qnty2 > 0 then 1 else 0
     4833             .
     4834           end.
     4835         end.
     4836       end.
     4837       else do:
     4838         if  xtog-lavel or xtog-lavel-2 then do:
     4839           for each tt-grp-tree :
     4840             assign
     4841               tt-grp-tree.qnty1 = tt-grp-tree.qnty1 + p-min-qnty
     4842               tt-grp-tree.qnty2 = tt-grp-tree.qnty2 + p-qnty1
     4843               tt-grp-tree.qnty3 = tt-grp-tree.qnty3 + p-qnty2
     4844             .
     4845           end.
     4846         end.
     4847         find first temp-sum where temp-sum.num = 0 no-error .
     4848         if not available temp-sum then do:
     4849           create temp-sum .
     4850           assign temp-sum.num = 0 .
     4851         end.
     4852         assign
     4853           temp-sum.qnty1 = temp-sum.qnty1 + p-min-qnty
     4854           temp-sum.qnty2 = temp-sum.qnty2 + p-qnty1
     4855           temp-sum.qnty3 = temp-sum.qnty3 + p-qnty2
     4856         .
     4857         if p-Rad-Goods = 1 or (p-Rad-Goods = 2 and p-qnty1 = 0)  then do:
     4858           assign num-line = num-line + 1 .
     4859           run is-page .
     4860           PUT stream PrnLibStream  "|"   num-line   format ">>>>9" .
     4861           if  p-Rad-Inter = 1  then   PUT stream PrnLibStream  "|"  " "  format "X(14)"  .
     4862           PUT stream PrnLibStream  "|"   p-artic       format "X(16)"
     4863                                 "|"   p-gds-name    format "X(40)"
     4864                                 "|"   p-unit-base   format "X(3)"
     4865                                 "|"   p-min-qnty    format "->>>>>>>>>9.999"
     4866                                 "|"   p-qnty1       format "->>>>>>>>>9.999"
     4867                                 "|"   p-qnty2       format "->>>>>>>>>9.999"
     4868           "|" skip .
     4869           assign  v-col = 1 .
     4870           run macr_excel_char(string(num-line), v-row, v-col) .    assign  v-col = v-col + 1 .
     4871           if  p-Rad-Inter = 1  then  assign  v-col = v-col + 1 .
     4872           run macr_excel_char (p-artic, v-row, v-col) .        assign  v-col = v-col + 1 .
     4873           run macr_excel_char (p-gds-name, v-row, v-col) .     assign  v-col = v-col + 1 .
     4874           run macr_excel_char (p-unit-base, v-row, v-col) .    assign  v-col = v-col + 1 .
     4875           run macr_excel_sum (p-min-qnty, v-row, v-col, 3) .   assign  v-col = v-col + 1 .
     4876           run macr_excel_sum (p-qnty1, v-row, v-col, 3) .      assign  v-col = v-col + 1 .
     4877           run macr_excel_sum (p-qnty2, v-row, v-col, 3) .
     4878           assign  v-row = v-row + 1 .
     4879         end.
     4880       end.
     4881     end.
     4882   end procedure.
     4883   procedure PrintName :
     4884     do on error undo, return error return-value :
     4885       define input  parameter str           as character no-undo .
     4886       run is-page .
     4887       if v-table = 1 then do:
     4888         if  p-Rad-Inter = 1  then do:
     4889           PUT stream PrnLibStream  "|" "|" at 17 str format "X(90)" "|" at 123 skip .
     4890           run macr_excel_char(str, v-row, 2) .
     4891         end.
     4892         else do:
     4893           PUT stream PrnLibStream  "|"  str format "X(100)" "|" at 107 skip .
     4894           run macr_excel_char(str, v-row, 1) .
     4895         end.
     4896       end.
     4897       else do:
     4898         if  p-Rad-Inter = 1  then do:
     4899           PUT stream PrnLibStream  "|" "|" at 7 "|" at 22 str format "X(100)" "|" at 132 skip .
     4900           run macr_excel_char(str, v-row, 3) .
     4901         end.
     4902         else do:
     4903           PUT stream PrnLibStream  "|" "|" at 7  str format "X(100)" "|" at 117 skip .
     4904           run macr_excel_char(str, v-row, 2) .
     4905         end.
     4906       end.
     4907       assign v-row = v-row + 1 .
     4908     end.
     4909   end procedure.
     4910   procedure PrintItog :
     4911     do on error undo, return error return-value :
     4912       define input  parameter str          as character no-undo .
     4913       define input  parameter level        as integer   no-undo .
     4914       define variable sum1 as decimal   no-undo .
     4915       define variable sum2 as decimal   no-undo .
     4916       define variable sum3 as decimal   no-undo .
     4917       if level = 0 then  find last  temp-sum use-index pi no-error  .
     4918       else               find first temp-sum where temp-sum.num = ( level - 1 ) no-error .
     4919       if available temp-sum then do:
     4920         assign
     4921           sum1 = temp-sum.qnty1
     4922           sum2 = temp-sum.qnty2
     4923           sum3 = temp-sum.qnty3
     4924           temp-sum.qnty1 = 0
     4925           temp-sum.qnty2 = 0
     4926           temp-sum.qnty3 = 0
     4927         .
     4928       end.
     4929       run is-page .
     4930       if v-table = 1 then do:
     4931         if  p-Rad-Inter = 1  then do:
     4932           if str = "Всего " then PUT stream PrnLibStream  "|"  str  format "X(15)"  .
     4933           else do:
     4934             if level <> 1 then PUT stream PrnLibStream  "|" "|"  at 17 str  format "X(100)" "|" at 123 skip  "|" " "  format "X(15)"  .
     4935             else               PUT stream PrnLibStream  "|" " "  format "X(15)"  .
     4936           end.
     4937         end.
     4938         else do:
     4939          if xClassify <> "no-classify":U  and level <> 1 then put stream PrnLibStream  "|" str format "X(100)" "|" at 107 skip .
     4940         end.
     4941         PUT stream PrnLibStream
     4942           "|"  sum1                 format "->>>>>>>>>>>>>9"
     4943           "|"  sum2                 format "->>>>>>>>>>>>>>>9"
     4944           "|"  sum1 - sum2          format "->>>>>>>>>>>>>9"
     4945           "|"  sum2 * 100 / sum1    format "->>>>>9.99"
     4946           "|"  sum3                 format "->>>>>>>>>>>>>>>9"
     4947           "|"  sum1 - sum3          format "->>>>>>>>>>>>>9"
     4948           "|"  sum3 * 100 / sum1    format "->>>>>9.99"
     4949           "|"   skip .
     4950           assign  v-col = 1 .
     4951           if  p-Rad-Inter = 1  and str = "Всего " then do:
     4952             run macr_excel_char (str, v-row, v-col) .
     4953             assign  v-col = v-col + 1 .
     4954           end.
     4955           else do:
     4956             run macr_excel_char (str, v-row, v-col) .
     4957             assign
     4958               v-row = v-row + 1
     4959               v-col = 1
     4960             .
     4961             if  p-Rad-Inter = 1 then assign  v-col = v-col + 1 .
     4962           end.
     4963           run macr_excel_sum (sum1, v-row, v-col, 0) .              assign  v-col = v-col + 1 .
     4964           run macr_excel_sum (sum2, v-row, v-col, 0) .              assign  v-col = v-col + 1 .
     4965           run macr_excel_sum ( sum1 - sum2, v-row, v-col, 0) .      assign  v-col = v-col + 1 .
     4966           run macr_excel_sum (sum2 * 100 / sum1, v-row, v-col, 2) . assign  v-col = v-col + 1 .
     4967           run macr_excel_sum (sum3, v-row, v-col, 0) .              assign  v-col = v-col + 1 .
     4968           run macr_excel_sum ( sum1 - sum3, v-row, v-col, 0) .      assign  v-col = v-col + 1 .
     4969           run macr_excel_sum (sum3 * 100 / sum1, v-row, v-col, 2) . assign  v-col = v-col + 1 .
     4970           assign  v-row = v-row + 1 .
     4971       end.
     4972       else do:
     4973         if  p-Rad-Inter = 1  then do:
     4974           if str = "Всего " then PUT stream PrnLibStream  "|" "|" at 7  str  format "X(14)" "|"  " " format "X(77)" .
     4975           else                   PUT stream PrnLibStream  "|" "|" at 7 "|"  at 22 str  format "X(77)"  .
     4976         end.
     4977         else  put stream PrnLibStream  "|" "|" at 7 str format "X(77)" .
     4978         PUT stream PrnLibStream
     4979           "|"  sum2   format "->>>>>>>>>9.999"
     4980           "|"  sum3   format "->>>>>>>>>9.999"
     4981           "|"   skip .
     4982           assign  v-col = 2 .
     4983           if p-Rad-Inter = 2 or str = "Всего " then do:
     4984             run macr_excel_char (str, v-row, v-col) .       assign  v-col = v-col + 4 .
     4985           end.
     4986                assign  v-col = v-col + 1 .
     4987           run macr_excel_sum (sum2, v-row, v-col, 3) .      assign  v-col = v-col + 1 .
     4988           run macr_excel_sum (sum3, v-row, v-col, 3) .
     4989           assign  v-row = v-row + 1 .
     4990       end.
     4991       if level > 0  then do:
     4992         run is-page .
     4993         if  p-Rad-Inter = 2 or str <> "Всего " then do:
     4994           find first temp-sum where temp-sum.num = level no-error .
     4995           if not available temp-sum then do:
     4996             create temp-sum .
     4997             assign temp-sum.num = level .
     4998           end.
     4999           assign
     5000             temp-sum.qnty1 = temp-sum.qnty1 + sum1
     5001             temp-sum.qnty2 = temp-sum.qnty2 + sum2
     5002             temp-sum.qnty3 = temp-sum.qnty3 + sum3
     5003           .
     5004         end.
     5005       end.
     5006     end.
     5007   end procedure.
     5008   procedure PrintItogGroup :
     5009     do on error undo, return error return-value :
     5010       define input  parameter str       as character no-undo .
     5011       define input  parameter sum1 as decimal   no-undo .
     5012       define input  parameter sum2 as decimal   no-undo .
     5013       define input  parameter sum3 as decimal   no-undo .
     5014       run is-page .
     5015       if v-table = 1 then do:
     5016         if  p-Rad-Inter = 1  then  PUT stream PrnLibStream  "|" "|"  at 17 str  format "X(100)" "|" at 123 skip  "|" " "  format "X(15)"  .
     5017         else                       put stream PrnLibStream  "|" str format "X(100)" "|" at 107 skip .
     5018         PUT stream PrnLibStream
     5019           "|"  sum1     format "->>>>>>>>>>>>>9"
     5020           "|"  sum2     format "->>>>>>>>>>>>>>>9"
     5021           "|"  sum1 - sum2  format "->>>>>>>>>>>>>9"
     5022           "|"  sum2 * 100 / sum1    format "->>>>>9.99"
     5023           "|"  sum3     format "->>>>>>>>>>>>>>>9"
     5024           "|"  sum1 - sum3  format "->>>>>>>>>>>>>9"
     5025           "|"  sum3 * 100 / sum1    format "->>>>>9.99"
     5026           "|"   skip .
     5027           if p-Rad-Inter = 1 then assign  v-col = 2 .
     5028           else                    assign  v-col = 1 .
     5029           run macr_excel_char (str, v-row, v-col) .
     5030           assign v-row = v-row + 1  .
     5031           if p-Rad-Inter = 1 then assign  v-col = 2 .
     5032           else                    assign  v-col = 1 .
     5033           run macr_excel_sum (sum1, v-row, v-col, 0) .              assign  v-col = v-col + 1 .
     5034           run macr_excel_sum (sum2, v-row, v-col, 0) .              assign  v-col = v-col + 1 .
     5035           run macr_excel_sum ( sum1 - sum2, v-row, v-col, 0) .      assign  v-col = v-col + 1 .
     5036           run macr_excel_sum (sum2 * 100 / sum1, v-row, v-col, 2) . assign  v-col = v-col + 1 .
     5037           run macr_excel_sum (sum3, v-row, v-col, 0) .              assign  v-col = v-col + 1 .
     5038           run macr_excel_sum ( sum1 - sum3, v-row, v-col, 0) .      assign  v-col = v-col + 1 .
     5039           run macr_excel_sum (sum3 * 100 / sum1, v-row, v-col, 2) . assign  v-col = v-col + 1 .
     5040           assign  v-row = v-row + 1 .
     5041       end.
     5042       else do:
     5043         if  p-Rad-Inter = 1  then  PUT stream PrnLibStream  "|" "|" at 7 "|"  at 22 str  format "X(77)"  .
     5044         else                       put stream PrnLibStream  "|" "|" at 7 str format "X(77)" .
     5045         PUT stream PrnLibStream
     5046           "|"  sum2   format "->>>>>>>>>9.999"
     5047           "|"  sum3   format "->>>>>>>>>9.999"
     5048           "|"   skip .
     5049         if p-Rad-Inter = 1 then assign  v-col = 3 .
     5050         else                    assign  v-col = 2 .
     5051         run macr_excel_char (str, v-row, v-col) .       assign  v-col = v-col + 3 .
     5052             assign  v-col = v-col + 1 .
     5053         run macr_excel_sum (sum2, v-row, v-col, 3) .    assign  v-col = v-col + 1 .
     5054         run macr_excel_sum (sum3, v-row, v-col, 3) .
     5055         assign  v-row = v-row + 1 .
     5056       end.
     5057     end.
     5058   end procedure.
     5059   procedure Find-fo :
     5060     do on error undo, return error return-value :
     5061       define input  parameter p-dt as date      no-undo .
     5062       define input  parameter p-tm as integer   no-undo .
     5063       define output parameter p-fo as decimal   no-undo .
     5064       define buffer buf_trn-doc for trn-doc.
     5065       find last buf_trn-doc no-lock
     5066         where buf_trn-doc.obj-type = p-cli-type1
     5067           and buf_trn-doc.obj-code = p-cli-code1
     5068           and buf_trn-doc.status_ = 'факт':U
     5069           and buf_trn-doc.fact-date < p-dt
     5070       USE-INDEX stat-fact  no-error .
     5071       if available buf_trn-doc then assign p-fo = buf_trn-doc.fact-order.
     5072       find last buf_trn-doc no-lock
     5073         where buf_trn-doc.obj-type = p-cli-type2
     5074           and buf_trn-doc.obj-code = p-cli-code2
     5075           and buf_trn-doc.status_ = 'факт':U
     5076           and buf_trn-doc.fact-date < p-dt
     5077       USE-INDEX stat-fact  no-error .
     5078       if available buf_trn-doc and buf_trn-doc.fact-order > p-fo then assign p-fo = buf_trn-doc.fact-order.
     5079       for each  buf_trn-doc no-lock
     5080         where buf_trn-doc.obj-type  = p-cli-type1
     5081           and buf_trn-doc.obj-code  = p-cli-code1
     5082           and buf_trn-doc.status_   = 'факт':U
     5083           and buf_trn-doc.fact-date = p-dt
     5084       :
     5085         if buf_trn-doc.fact-time <= p-tm and buf_trn-doc.fact-order > p-fo then assign p-fo = buf_trn-doc.fact-order .
     5086       end.
     5087       for each  buf_trn-doc no-lock
     5088         where buf_trn-doc.obj-type  = p-cli-type2
     5089           and buf_trn-doc.obj-code  = p-cli-code2
     5090           and buf_trn-doc.status_   = 'факт':U
     5091           and buf_trn-doc.fact-date = p-dt
     5092       :
     5093         if buf_trn-doc.fact-time <= p-tm and buf_trn-doc.fact-order > p-fo then assign p-fo = buf_trn-doc.fact-order .
     5094       end.
     5095     end.
     5096   end procedure.
     5097   procedure PutColumnTitulExcel :
     5098     do on error undo, return error return-value :
     5099       if v-table = 1 then do:
     5100         run macr_excel_char (ReportNAme, v-row, 3) .
     5101         run macr_cell_format ( 11, yes, no, ?, v-row, 3, v-row, 3) .
     5102         assign v-row = v-row + 1 .
     5103         run macr_excel_char (ReportHeader, v-row, 1) .
     5104         assign
     5105           v-row = v-row + 1
     5106           v-col = 1
     5107         .
     5108         if  p-Rad-Inter = 1  then do:
     5109           run macr_excel_char("Час", v-row, v-col) .
     5110           assign v-col = v-col + 1 .
     5111         end.
     5112         run macr_excel_char("Всего товаров", v-row, v-col) .
     5113         assign v-col = v-col + 1 .
     5114         run macr_excel_char("С не 0 остатком на " + p-cli-type1 + string( p-cli-code1 ), v-row, v-col) .
     5115         assign v-col = v-col + 1 .
     5116         run macr_excel_char("Разница", v-row, v-col) .
     5117         assign v-col = v-col + 1 .
     5118         run macr_excel_char("%", v-row, v-col) .
     5119         assign v-col = v-col + 1 .
     5120         run macr_excel_char("С не 0 остатком на " + p-cli-type1 + string( p-cli-code1 )  + "+" + p-cli-type2 + string( p-cli-code2 ), v-row, v-col) .
     5121         assign v-col = v-col + 1 .
     5122         run macr_excel_char("Разница", v-row, v-col) .
     5123         assign v-col = v-col + 1 .
     5124         run macr_excel_char("%", v-row, v-col) .
     5125       end.
     5126       else do:
     5127         assign
     5128           v-row = v-row + 2
     5129           v-col = 1
     5130         .
     5131         run macr_excel_char("№", v-row, v-col) .
     5132         assign v-col = v-col + 1 .
     5133         if  p-Rad-Inter = 1  then do:
     5134           run macr_excel_char("Час", v-row, v-col) .
     5135           assign v-col = v-col + 1 .
     5136         end.
     5137         run macr_excel_char("Артикул", v-row, v-col) .
     5138         assign v-col = v-col + 1 .
     5139         run macr_excel_char("Наименование товара", v-row, v-col) .
     5140         assign v-col = v-col + 1 .
     5141         run macr_excel_char("Ед. изм.", v-row, v-col) .
     5142         assign v-col = v-col + 1 .
     5143         run macr_excel_char("Мин. остаток на " + p-cli-type1 + string( p-cli-code1 ), v-row, v-col) .
     5144         assign v-col = v-col + 1 .
     5145         run macr_excel_char("Остаток на " + p-cli-type1 + string( p-cli-code1 ), v-row, v-col) .
     5146         assign v-col = v-col + 1 .
     5147         run macr_excel_char("Остаток на " + p-cli-type2 + string( p-cli-code2 ), v-row, v-col) .
     5148       end.
     5149       run macr_cell_bordur ( v-row, 1, v-row , v-col) .
     5150       run macr_cell_format ( 10, yes, no, 35, v-row, 1, v-row, v-col) .
     5151       assign v-row = v-row + 1 .
     5152     end.
     5153   end procedure.
     5154   procedure PrintTime :
     5155     do on error undo, return error return-value :
     5156       define input  parameter p-str as character no-undo .
     5157       if v-table = 1 then do:
     5158         PUT stream PrnLibStream  "|" p-str format "X(15)" "|" at 17  "|" at 123 skip .
     5159         run macr_excel_char (p-str, v-row, 1) .
     5160         assign v-row = v-row + 1 .
     5161       end.
     5162       else do:
     5163         PUT stream PrnLibStream  "|" "|" at 7 p-str format "X(14)" "|" at 22  "|" at 132 skip .
     5164         run macr_excel_char (p-str, v-row, 2) .
     5165         assign v-row = v-row + 1 .
     5166       end.
     5167     end.
     5168   end procedure.
