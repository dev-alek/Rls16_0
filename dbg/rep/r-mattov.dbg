     1313       end.
     1314       if p-include-fact-order = true
     1315       then do:
     1316         assign
     1317           p-fact-order = p-fact-order - 0.0000000001
     1318         .
     1319       end.
     1320       define variable v-max-fact-order as character no-undo .
