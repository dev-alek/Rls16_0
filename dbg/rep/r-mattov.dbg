      618   function excel-format-dec-to-char returns char (input p-dec as decimal ).
      619     if num-entries(string(p-dec), '.') = 2
      620       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
      621       else return( string(p-dec)) .
      622   end function.
      623   function format-point-to-comma returns char (input orig as char ) .
      624   define variable rtext as character no-undo .
      625   define variable strt as integer no-undo .
      626   define variable leng as integer no-undo .
      627   assign rtext = orig .
      628   repeat:
      629     strt =  index(rtext,'.').
      630     if strt = 0 then leave.
      631     leng = 1.
      632     substring(rtext,strt,leng,"character") = v-delim .
      633   end.
      634   return rtext.
      635   end function.
      636   function format-excel-text returns char ( input start-text as char ) :
      637   def var  i    as int no-undo.
      638   def var  ch   as char no-undo.
      639   def var  n    as int no-undo.
      640   def var  ipos as int no-undo.
      641     n = num-entries(trim(start-text), chr(10)) - 1 .
      642     do i = 1 to n :
      643       ipos = index( start-text, chr(10)).
      644       if ipos > 0 then
      645         substr( start-text, ipos, 1 ) = ' '.
      646     end.
      647     n = num-entries(trim(start-text), chr(13)) - 1 .
      648     do i = 1 to n :
      649       ipos = index( start-text, chr(13)).
      650       if ipos > 0 then
      651         substr( start-text, ipos, 1 ) = ' '.
      652     end.
      653     if index( start-text, '"' ) = 0 then
      654       start-text =  '="'   + trim( start-text) + '"'   .
      655       else do:
      656         n = num-entries(trim(start-text), '"') - 1.
      657         do i = 1 to n :
      658           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      659         end.
      660         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      661         start-text = '="'  + ch  + '"' .
      662       end.
      663     return start-text.
      664   end.
      665   function excel-sum returns char (input p-dec as decimal ).
      666     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
      667   end function.
      668   function excel-qnty returns char (input p-dec as decimal ).
      669     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
      670   end function.
      671   function format-excel-text-macr returns char ( input start-text as char ) :
      672   def var  i    as int no-undo.
      673   def var  ch   as char no-undo.
      674   def var  n    as int no-undo.
      675   def var  ipos as int no-undo.
      676     n = num-entries(trim(start-text), chr(10)) - 1 .
      677     do i = 1 to n :
      678       ipos = index( start-text, chr(10)).
      679       if ipos > 0 then
      680         substring( start-text, ipos , 1 ) = ' '.
      681     end.
      682     n = num-entries(trim(start-text), chr(13)) - 1 .
      683     do i = 1 to n :
      684       ipos = index( start-text, chr(13)).
      685       if ipos > 0 then
      686         substring( start-text, ipos, 1 ) = ' '.
      687     end.
      688     if index( start-text, '"' ) = 0 then
      689       start-text =  '"'   + trim( start-text) + '"'   .
      690       else do:
      691         n = num-entries(trim(start-text), '"') - 1.
      692         do i = 1 to n :
      693           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      694         end.
      695         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      696         start-text = '"'  + ch  + '"' .
      697       end.
      698     n = num-entries(trim(start-text), chr(10)) - 1 .
      699     do i = 1 to n :
      700       ipos = index( start-text, chr(10)).
      701       if ipos > 0 then
      702         substring( start-text, ipos , 1 ) = ' '.
      703     end.
      704       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
      705     return start-text.
      706   end.
      707   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      708   procedure factord :
      709     define input  parameter p-fact-date            as date    no-undo .
      710     define input  parameter p-fact-time            as integer no-undo .
      711     define input  parameter p-fact-num             as integer no-undo .
      712     define input  parameter p-shift-date           as date    no-undo .
      713     define input  parameter p-shift-num            as integer no-undo .
      714     define input  parameter p-shift-on             as logical no-undo .
      715     define output parameter p-fact-order           as decimal no-undo .
      716     define output parameter p-shift-end-fact-order as decimal no-undo .
      717     define output parameter p-day-end-fact-order   as decimal no-undo .
      718     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      719     if p-fact-date = ?
      720     then do:
      721       return error "Не указана фактическая дата" .
      722     end.
      723     define variable v-fact-date-num as integer no-undo .
      724     assign
      725       v-fact-date-num = integer(p-fact-date)
      726     .
      727     if p-fact-num = ?
      728     or p-fact-num = 0
      729     then do:
      730       return error "Не задан p-fact-num " + string(p-fact-num) .
      731     end.
      732     if p-fact-num < 0
      733     then do:
      734       return error "Отрицательный fact-num " + string(p-fact-num) .
      735     end.
      736     if p-fact-num >= 100000000
      737     then do:
      738       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      739     end.
      740     if p-shift-on = true
      741     then do:
      742       if p-shift-date = ?
      743       then do:
      744         return error "Не задана дата смены" .
      745       end.
      746       if p-shift-num = ?
      747       or p-shift-num = 0
      748       then do:
      749         return error "Не задан номер смены" .
      750       end.
      751     end.
      752     else do:
      753       assign
      754         p-shift-date = p-fact-date
      755         p-shift-num  = 24
      756       .
      757     end.
      758     define variable v-shift-offset as integer no-undo .
      759     if p-shift-date = p-fact-date
      760     then do:
      761       assign
      762         v-shift-offset = 1
      763       .
      764     end.
      765     if p-shift-date < p-fact-date
      766     then do:
      767       assign
      768         v-shift-offset = 0
      769       .
      770     end.
      771     if p-shift-date > p-fact-date
      772     then do:
      773       message
      774         vss-workfile vss-revision vss-description skip
      775         "Неправильная дата закрытия смены" skip
      776         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      777         view-as alert-box error .
      778       undo, return error
      779         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      780           ,string(p-fact-date, '99/99/9999':U)
      781           ,string(p-shift-date, '99/99/9999':U)
      782           )
      783       .
      784     end.
      785     if p-shift-num < 1
      786     or p-shift-num > 24
      787     then do:
      788       message
      789         vss-workfile vss-revision vss-description skip
      790         "Неправильный номер смены" skip
      791         "p-shift-num" p-shift-num skip
      792         view-as alert-box error .
      793       undo, return error return-value .
      794     end.
      795     assign
      796       p-fact-order           = v-fact-date-num
      797                              + v-shift-offset * 0.5
      798                              + p-shift-num    * 0.02 - 0.01
      799                              + p-fact-num     * 0.0000000001
      800       p-shift-end-fact-order = v-fact-date-num
      801                              + v-shift-offset * 0.5
      802                              + p-shift-num    * 0.02
      803       p-day-end-fact-order   = v-fact-date-num
      804                              + 0.99
      805     .
      806     if p-fact-order           <= v-fact-date-num
      807     or p-shift-end-fact-order <= v-fact-date-num
      808     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      809     or p-shift-end-fact-order >= p-day-end-fact-order
      810     then do:
      811       message
      812         vss-workfile vss-revision vss-description skip
      813         "Внутренняя ошибка при генерации фактического номера" skip
      814         "p-fact-date"            p-fact-date            skip
      815         "p-fact-time"            p-fact-time            skip
      816         "p-fact-num"             p-fact-num             skip
      817         "p-shift-date"           p-shift-date           skip
      818         "p-shift-num"            p-shift-num            skip
      819         "p-shift-on"             p-shift-on             skip
      820         "p-shift-end-fact-order" p-shift-end-fact-order skip
      821         "p-day-end-fact-order"   p-day-end-fact-order   skip
      822         "v-fact-date-num"        v-fact-date-num        skip
      823         view-as alert-box error .
      824       undo, return error return-value .
      825     end.
      826   end procedure.
      827   procedure day-begin-fact-order :
      828     define input  parameter p-fact-date            as date    no-undo .
      829     define output parameter p-day-begin-fact-order as decimal no-undo .
      830     do
      831     on error undo, return error return-value
      832     :
      833       if p-fact-date = ?
      834       then do:
      835         assign
      836           p-day-begin-fact-order = 0
      837         .
      838       end.
      839       else do:
      840         assign
      841           p-day-begin-fact-order = integer(p-fact-date)
      842         .
      843       end.
      844     end.
      845   end procedure.
      846   procedure factord-max-fact-order :
      847     define output parameter p-max-fact-order as decimal   no-undo .
      848     do
      849     on error undo, return error return-value
      850     :
      851       run day-begin-fact-order in this-procedure
      852         (input  date(1, 1, 5000)
      853         ,output p-max-fact-order
      854         ) .
      855     end.
      856   end procedure.
      857   procedure factord-cut-archive :
      858     define input  parameter p-obj-type             as character no-undo .
      859     define input  parameter p-obj-code             as integer   no-undo .
      860     define input  parameter p-fact-date            as date      no-undo .
      861     define output parameter p-shift-on             as logical   no-undo .
      862     define output parameter p-shift-date           as date      no-undo .
      863     define output parameter p-shift-num            as integer   no-undo .
      864     define output parameter p-day-end-fact-order   as decimal   no-undo .
      865     define output parameter p-shift-end-fact-order as decimal   no-undo .
      866     define variable v-fact-order as decimal   no-undo .
      867     define buffer buf_shift-obj for ub.shift-obj .
      868     do
      869     on error undo, return error return-value
      870     :
      871   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      872   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      873     (input  p-obj-type
      874     ,input  p-obj-code
      875     ,input  'shift-on=request'
      876     ,output p-shift-on
      877     ) no-error .
      878       if error-status :error
      879       then do:
      880         message
      881           vss-workfile vss-revision vss-description skip
      882           "Ошибка при определении атрибута объекта" skip
      883           "Объект" p-obj-type p-obj-code skip
      884           error-status :get-message(1) skip
      885           return-value skip
      886           view-as alert-box error .
      887         undo, return error return-value .
      888       end.
      889       if p-shift-on = false
      890       then do:
      891         assign
      892           p-shift-date               = ?
      893           p-shift-num                = 0
      894         .
      895       end.
      896       else do:
      897         find first buf_shift-obj share-lock
      898           where buf_shift-obj.obj-type   = p-obj-type
      899             and buf_shift-obj.obj-code   = p-obj-code
      900             and buf_shift-obj.shift-date > p-fact-date
      901           use-index pi
      902           no-error .
      903         if not available buf_shift-obj
      904         or buf_shift-obj.status_ <> 'зкр':U
      905         then do:
      906           message
      907             vss-workfile vss-revision vss-description skip
      908             "Невозможно вычислить последнюю смену" skip
      909             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      910             "Объект" p-obj-type p-obj-code skip
      911             "Дата" p-fact-date skip
      912             view-as alert-box error .
      913           undo, return error return-value .
      914         end.
      915         find last buf_shift-obj share-lock
      916           where buf_shift-obj.obj-type = p-obj-type
      917             and buf_shift-obj.obj-code = p-obj-code
      918             and buf_shift-obj.shift-date <= p-fact-date
      919           use-index pi
      920           no-error .
      921         if available buf_shift-obj
      922         then do:
      923           if  buf_shift-obj.status_ = 'зкр':U
      924           then do:
      925             assign
      926               p-shift-date = buf_shift-obj.shift-date
      927               p-shift-num  = buf_shift-obj.shift-num
      928             .
      929           end.
      930           else do:
      931             message
      932               vss-workfile vss-revision vss-description skip
      933               "Невозможно вычислить последнюю смену" skip
      934               "Статус смены отличен от статуса" 'зкр':U skip
      935               "Объект" p-obj-type p-obj-code skip
      936               "Дата" p-fact-date skip
      937               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      938               view-as alert-box error .
      939             undo, return error return-value .
      940           end.
      941         end.
      942         else do:
      943           assign
      944             p-shift-date = p-fact-date - 1
      945             p-shift-num  = 1
      946           .
      947         end.
      948       end.
      949       run factord in this-procedure
      950         (input  p-fact-date
      951         ,input  1
      952         ,input  1
      953         ,input  p-shift-date
      954         ,input  p-shift-num
      955         ,input  p-shift-on
      956         ,output v-fact-order
      957         ,output p-shift-end-fact-order
      958         ,output p-day-end-fact-order
      959         ) no-error .
      960       if error-status :error
      961       then do:
      962         message
      963           vss-workfile vss-revision vss-description skip
      964           "Ошибка при вызове процедуры factord"
      965           error-status :get-message(1) skip
      966           return-value skip
      967           view-as alert-box error .
      968         undo, return error return-value .
      969       end.
      970     end.
      971   end procedure.
      972   procedure factord-lock-shift :
      973     define input  parameter p-obj-type  as character no-undo .
      974     define input  parameter p-obj-code  as integer   no-undo .
      975     define input  parameter p-fact-date as date      no-undo .
      976     define parameter buffer buf_shift-obj for ub.shift-obj .
      977     define variable v-shift-on      as logical   no-undo .
      978     define variable v-extra-message as character no-undo .
      979     define variable v-error as character no-undo .
      980     do
      981     on error undo, return error return-value
      982     :
      983   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      984   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      985     (input  p-obj-type
      986     ,input  p-obj-code
      987     ,input  'shift-on=request'
      988     ,output v-shift-on
      989     ) no-error .
      990       if error-status :error
      991       then do:
      992         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      993         undo, return error v-error .
      994       end.
      995       if v-shift-on = true
      996       then do:
      997         find first buf_shift-obj share-lock
      998           where buf_shift-obj.obj-type   = p-obj-type
      999             and buf_shift-obj.obj-code   = p-obj-code
     1000             and buf_shift-obj.shift-date > p-fact-date
     1001           use-index pi
     1002           no-error .
     1003         if not available buf_shift-obj
     1004         or buf_shift-obj.status_ <> 'зкр':U
     1005         then do:
     1006           find last buf_shift-obj
     1007             where buf_shift-obj.obj-type = p-obj-type
     1008               and buf_shift-obj.obj-code = p-obj-code
     1009               and buf_shift-obj.status_  = 'зкр':U
     1010             use-index stts
     1011             no-error .
     1012           if available buf_shift-obj
     1013           then do:
     1014             assign
     1015               v-extra-message =
     1016                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1017                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1018                               )
     1019             .
     1020           end.
     1021           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1022           undo, return error v-error .
     1023         end.
     1024       end.
     1025     end.
     1026   end procedure.
     1027   procedure factord-end-day :
     1028     define input  parameter p-fact-date            as date    no-undo .
     1029     define output parameter p-day-end-fact-order   as decimal no-undo .
     1030     do
     1031     on error undo, return error return-value
     1032     :
     1033       if p-fact-date = ?
     1034       then do:
     1035         return error "Не указана фактическая дата" .
     1036       end.
     1037       assign
     1038         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1039       .
     1040     end.
     1041   end procedure.
     1042   procedure factord-to-date :
     1043     define input  parameter p-fact-order as decimal no-undo .
     1044     define output parameter p-fact-date  as date    no-undo .
     1045     define variable v-ref-date  as date      no-undo .
     1046     define variable v-ref-delta as integer   no-undo .
     1047     do
     1048     on error undo, return error return-value
     1049     :
     1050       if p-fact-order = ?
     1051       or p-fact-order = 0
     1052       then do:
     1053         return error "Не указан fact-order" .
     1054       end.
     1055       assign
     1056         v-ref-date  = date(1, 1, 2000)
     1057       .
     1058       assign
     1059         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1060       .
     1061       assign
     1062         p-fact-date = v-ref-date + v-ref-delta
     1063       .
     1064     end.
     1065   end procedure.
     1066   procedure factord-to-fact-num :
     1067     define input  parameter p-fact-order as decimal no-undo .
     1068     define output parameter p-fact-num   as integer no-undo .
     1069     define variable v-fact-order-trunc as decimal no-undo .
     1070     do
     1071     on error undo, return error return-value
     1072     :
     1073       if p-fact-order = ?
     1074       or p-fact-order = 0
     1075       then do:
     1076         return error "Не указан fact-order" .
     1077       end.
     1078       assign
     1079        v-fact-order-trunc = truncate(p-fact-order, 2)
     1080       .
     1081       assign
     1082         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1083       .
     1084     end.
     1085   end procedure.
     1086   procedure factord-to-shift-num :
     1087     define input  parameter p-fact-order as decimal no-undo .
     1088     define output parameter p-shift-num   as integer no-undo .
     1089     define variable  p-shift-numd  as decimal   no-undo .
     1090     define variable v-fact-order-trunc as decimal no-undo .
     1091     do
     1092     on error undo, return error return-value
     1093     :
     1094       if p-fact-order = ?
     1095       or p-fact-order = 0
     1096       then do:
     1097         return error "Не указан fact-order" .
     1098       end.
     1099       assign
     1100        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1101       .
     1102       if v-fact-order-trunc < 0.5 then do:
     1103         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1104       end.
     1105       assign
     1106         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1107         .
     1108        assign
     1109         p-shift-num = truncate (p-shift-numd , 0)
     1110       .
     1111     end.
     1112   end procedure.
     1113   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1114   define temp-table temp-parts no-undo   like ub.parts   field free-qnty as decimal   field free-cli-qnty as decimal .
     1115   procedure partslib-clear-temp-parts :
     1116     define buffer buf_temp-parts for temp-parts .
     1117     do
     1118     on error undo, return error
     1119     :
     1120       for each buf_temp-parts
     1121       on error undo, return error
     1122       :
     1123         delete buf_temp-parts .
     1124       end.
     1125     end.
     1126   end procedure.
     1127   procedure partslib-create-temp-parts :
     1128     define parameter buffer buf_parts       for ub.parts .
     1129     define parameter buffer buf_temp-parts  for temp-parts .
     1130     define input  parameter p-goods-twounit as logical   no-undo .
     1131     define variable v-base-part-code as character no-undo .
     1132     do
     1133     on error undo, return error
     1134     :
     1135       if p-goods-twounit = true
     1136       then do:
     1137         assign
     1138           v-base-part-code = entry(1, buf_parts.part-code, '#':U)
     1139         .
     1140       end.
     1141       else do:
     1142         assign
     1143           v-base-part-code = buf_parts.part-code
     1144         .
     1145       end.
     1146       find first buf_temp-parts exclusive-lock
     1147         where buf_temp-parts.obj-type  = buf_parts.obj-type
     1148           and buf_temp-parts.obj-code  = buf_parts.obj-code
     1149           and buf_temp-parts.artic     = buf_parts.artic
     1150           and buf_temp-parts.prod-type = buf_parts.prod-type
     1151           and buf_temp-parts.prod-code = buf_parts.prod-code
     1152           and buf_temp-parts.in-code   = buf_parts.in-code
     1153           and buf_temp-parts.out-code  = 'free-zone':U
     1154           and buf_temp-parts.part-code = v-base-part-code
     1155         no-error.
     1156       if not available buf_temp-parts
     1157       then do:
     1158         create buf_temp-parts .
     1159         buffer-copy buf_parts to buf_temp-parts
     1160         assign
     1161           buf_temp-parts.out-code  = 'free-zone':U
     1162           buf_temp-parts.part-code = v-base-part-code
     1163           buf_temp-parts.rsrv-free = yes
     1164           buf_temp-parts.status_   = no
     1165           buf_temp-parts.qnty      = 0
     1166           buf_temp-parts.fact-qnty = 0
     1167           buf_temp-parts.real-qnty = 0
     1168           buf_temp-parts.cli-qnty  = 0
     1169         .
     1170       end.
     1171     end.
     1172   end procedure.
     1173   procedure partslib-init-temp-parts :
     1174     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
     1175     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
     1176     define input parameter p-artic           like ub.parts.artic     no-undo .
     1177     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
     1178     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
     1179     define buffer buf_parts      for ub.parts .
     1180     define buffer buf_temp-parts for temp-parts .
     1181     define variable v-goods-twounit    as logical   no-undo .
     1182     do
     1183     on error undo, return error
     1184     :
     1185   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1186   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1187     (input  p-artic
     1188     ,input  p-prod-type
     1189     ,input  p-prod-code
     1190     ,input  'twounit=request':u
     1191     ,output v-goods-twounit
     1192     ) no-error .
     1193       if error-status :error
     1194       then do:
     1195         message
     1196           vss-workfile vss-revision vss-description skip
     1197           vss-include-info11 skip
     1198           "Ошибка при определении атрибута товара" skip
     1199           "Артикул" p-artic p-prod-type p-prod-code skip
     1200           "twounit=request" skip
     1201           error-status :get-message(1) skip
     1202           return-value skip
     1203           view-as alert-box error .
     1204         undo, return error return-value .
     1205       end.
     1206       run partslib-clear-temp-parts in this-procedure .
     1207       for each buf_parts
     1208         where buf_parts.obj-type  = p-obj-type
     1209           and buf_parts.obj-code  = p-obj-code
     1210           and buf_parts.artic     = p-artic
     1211           and buf_parts.prod-type = p-prod-type
     1212           and buf_parts.prod-code = p-prod-code
     1213           and buf_parts.rsrv-free = yes
     1214           and buf_parts.status_   = no
     1215           and buf_parts.in-code   <> buf_parts.out-code
     1216       on error undo, return error
     1217       :
     1218         run partslib-create-temp-parts in this-procedure
     1219           (buffer buf_parts
     1220           ,buffer buf_temp-parts
     1221           ,input  v-goods-twounit
     1222           ) .
     1223         define variable v-parts-qnty          as decimal   no-undo .
     1224         define variable v-parts-cli-qnty      as decimal   no-undo .
     1225         define variable v-parts-free-qnty     as decimal   no-undo .
     1226         define variable v-parts-free-cli-qnty as decimal   no-undo .
     1227         if buf_parts.out-code = 'free-zone':U
     1228         then do:
     1229           assign
     1230             v-parts-qnty          = buf_parts.qnty
     1231             v-parts-cli-qnty      = buf_parts.cli-qnty
     1232             v-parts-free-qnty     = buf_parts.qnty
     1233             v-parts-free-cli-qnty = buf_parts.cli-qnty
     1234           .
     1235         end.
     1236         else do:
     1237           assign
     1238             v-parts-qnty          = abs(buf_parts.qnty)
     1239             v-parts-cli-qnty      = abs(buf_parts.cli-qnty)
     1240             v-parts-free-qnty     = 0
     1241             v-parts-free-cli-qnty = 0
     1242           .
     1243         end.
     1244         assign
     1245           buf_temp-parts.qnty          = buf_temp-parts.qnty          + v-parts-qnty
     1246           buf_temp-parts.fact-qnty     = buf_temp-parts.fact-qnty     + v-parts-qnty
     1247           buf_temp-parts.real-qnty     = 0
     1248           buf_temp-parts.cli-qnty      = buf_temp-parts.cli-qnty      + v-parts-cli-qnty
     1249           buf_temp-parts.free-qnty     = buf_temp-parts.free-qnty     + v-parts-free-qnty
     1250           buf_temp-parts.free-cli-qnty = buf_temp-parts.free-cli-qnty + v-parts-free-cli-qnty
     1251         .
     1252       end.
     1253     end.
     1254   end procedure.
     1255   procedure partslib-init-temp-parts-by-factord :
     1256     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
     1257     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
     1258     define input parameter p-artic              like ub.parts.artic     no-undo .
     1259     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
     1260     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
