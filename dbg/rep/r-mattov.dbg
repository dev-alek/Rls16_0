     4288   define variable vss-include-info32 as character format "X(65)" no-undo
     4289   initial "@(#)$Workfile$ $Revision$".
     4290   procedure Run0 :
     4291     do on error undo, return error return-value :
     4292       if  p-Rad-Inter = 1  then do:
     4293         for each temp-gds-time
     4294           break by temp-gds-time.dt by temp-gds-time.tm by if xSortType = "sort-article" then  temp-gds-time.artic      Else  temp-gds-time.gds-name :
     4295           if first-of(temp-gds-time.tm) then run PrintTime ( string(temp-gds-time.dt,"99/99/99") + " " + string(temp-gds-time.tm,"99") + ".00" ) .
     4296           run PrintLine  in this-procedure ( temp-gds-time.qnty1, temp-gds-time.qnty2, temp-gds-time.min-qnty, temp-gds-time.artic, temp-gds-time.gds-name, temp-gds-time.unit-base) .
     4297           if last-of(temp-gds-time.tm)  then Run PrintItog ("Всего ", 1).
     4298         end.
     4299       end.
     4300       else do:
     4301         for each temp-gds break by if xSortType = "sort-article" then  temp-gds.artic           Else  temp-gds.gds-name :
     4302           run PrintLine  in this-procedure ( temp-gds.qnty1, temp-gds.qnty2, temp-gds.min-qnty, temp-gds.artic, temp-gds.gds-name, temp-gds.unit-base) .
     4303         end.
     4304       end.
     4305     end.
     4306   end procedure.
     4307   procedure Run1 :
     4308     do on error undo, return error return-value :
