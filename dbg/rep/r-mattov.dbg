     4310         for each temp-gds-time  break by temp-gds-time.dt by temp-gds-time.tm  by temp-gds-time.grp-name  by if xSortType = "sort-article" then  temp-gds-time.artic      Else  temp-gds-time.gds-name :
     4311           if first-of(temp-gds-time.tm) then  run PrintTime ( string(temp-gds-time.dt,"99/99/99") + " " + string(temp-gds-time.tm,"99") + ".00" ) .
     4312           if first-of(temp-gds-time.grp-name)  then run PrintName ( "  Группа " + temp-gds-time.grp-name ) .
     4313           run PrintLine  in this-procedure ( temp-gds-time.qnty1, temp-gds-time.qnty2, temp-gds-time.min-qnty, temp-gds-time.artic, temp-gds-time.gds-name, temp-gds-time.unit-base) .
     4314           if last-of(temp-gds-time.grp-name)   then Run PrintItog ("  Всего по группе " + temp-gds-time.grp-name, 1).
     4315           if last-of(temp-gds-time.tm)  then Run PrintItog ("Всего ", 2).
     4316         end.
     4317       end.
