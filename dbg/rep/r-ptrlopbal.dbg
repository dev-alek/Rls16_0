     1270   define stream OutStr-html.
     1271   DEFINE TEMP-TABLE tt-rep NO-UNDO
     1272       FIELD shift-date            like ub.trn-doc.shift-date
     1273       FIELD shift-num             like ub.trn-doc.shift-num
     1274       FIELD time-start            like ub.shift-obj.open-time
     1275       FIELD time-end              like ub.shift-obj.close-time
