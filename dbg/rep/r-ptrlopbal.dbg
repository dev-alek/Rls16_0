        7   def var vss-author      as character no-undo init "$Author: EShklyar $":U .
        8   def var vss-date        as character no-undo init "$Date: Fri Oct 06 18:34:13 2017 +0300 $":U .
        9   def var vss-workfile    as character no-undo init "$Workfile: r-ptrlopbal.p $":U .
       10   def var vss-archive     as character no-undo init "$Archive: rep/r-ptrlopbal.p $":U .
