     1279       FIELD goods-name            LIKE ub.goods.gds-name
     1280       FIELD rest_start_measure-kg LIKE ub.rvs-line.state-measure-qnty
     1281       FIELD rest_start_book-kg    LIKE ub.rvs-line.system-qnty
     1282       FIELD rest_start_measure-l  LIKE ub.rvs-line.state-measure-qnty
     1283       FIELD rest_start_book-l     LIKE ub.rvs-line.system-qnty
     1284       FIELD wayb_fact-kg          LIKE ub.trn-doc.cli-qnty
     1285       FIELD wayb_fact-l           LIKE ub.trn-doc.fact-qnty
     1286       FIELD exp-kg                LIKE ub.trn-doc.cli-qnty
     1287       FIELD exp-l                 LIKE ub.trn-doc.fact-qnty
     1288       FIELD rest_end_measure-kg   LIKE ub.rvs-line.state-measure-cli-qnty
     1289       FIELD rest_end_book-kg      LIKE ub.rvs-line.system-qnty
     1290       FIELD rest_end_measure-l    LIKE ub.rvs-line.state-measure-qnty
     1291       FIELD rest_end_book-l       LIKE ub.rvs-line.system-qnty
     1292       FIELD rest_end_balans-kg    LIKE ub.rvs-line.state-measure-cli-qnty
     1293       FIELD rest_end_balans-l     LIKE ub.rvs-line.system-qnty
     1294       field state-el-cnt          like icnt-line.state-el-cnt
     1295       field state-mh-cnt          like icnt-line.state-mh-cnt
     1296       FIELD err-kg                LIKE ub.rvs-line.state-measure-qnty
     1297       FIELD err-l                 LIKE ub.rvs-line.system-qnty
     1298       FIELD staff                 like ub.shift-staff.name
     1299       FIELD place_loc1            like ub.place.loc1
     1300       field density               like ub.rvs-line.density
     1301       INDEX pi AS UNIQUE PRIMARY gds-code pl-code shift-date shift-num
     1302    .
     1303   define variable var-gds-rest_start_measure-kg  LIKE ub.rvs-line.state-measure-qnty  no-undo.
     1304   define variable var-gds-rest_start_book-kg     LIKE ub.rvs-line.system-qnty no-undo.
     1305   define variable var-gds-rest_start_measure-l   LIKE ub.rvs-line.state-measure-qnty no-undo.
     1306   define variable var-gds-rest_start_book-l      LIKE ub.rvs-line.system-qnty no-undo.
     1307   define variable var-gds-wayb_fact-kg           LIKE ub.trn-doc.cli-qnty no-undo.
     1308   define variable var-gds-wayb_fact-l            LIKE ub.trn-doc.fact-qnty no-undo.
     1309   define variable var-gds-exp-kg                 LIKE ub.trn-doc.cli-qnty no-undo.
     1310   define variable var-gds-exp-l                  LIKE ub.trn-doc.fact-qnty no-undo.
     1311   define variable var-gds-rest_end_measure-kg   LIKE ub.rvs-line.state-measure-cli-qnty no-undo.
     1312   define variable var-gds-rest_end_book-kg      LIKE ub.rvs-line.system-qnty no-undo.
     1313   define variable var-gds-rest_end_measure-l    LIKE ub.rvs-line.state-measure-qnty no-undo.
     1314   define variable var-gds-rest_end_book-l       LIKE ub.rvs-line.system-qnty no-undo.
     1315   define variable var-gds-rest_end_balans-kg    LIKE ub.rvs-line.state-measure-cli-qnty no-undo.
     1316   define variable var-gds-rest_end_balans-l     LIKE ub.rvs-line.system-qnty no-undo.
     1317   define variable var-pl-rest_start_measure-kg  LIKE ub.rvs-line.state-measure-qnty  no-undo.
     1318   define variable var-pl-rest_start_book-kg     LIKE ub.rvs-line.system-qnty no-undo.
     1319   define variable var-pl-rest_start_measure-l   LIKE ub.rvs-line.state-measure-qnty no-undo.
     1320   define variable var-pl-rest_start_book-l      LIKE ub.rvs-line.system-qnty no-undo.
     1321   define variable var-pl-wayb_fact-kg           LIKE ub.trn-doc.cli-qnty no-undo.
     1322   define variable var-pl-wayb_fact-l            LIKE ub.trn-doc.fact-qnty no-undo.
     1323   define variable var-pl-exp-kg                 LIKE ub.trn-doc.cli-qnty no-undo.
     1324   define variable var-pl-exp-l                  LIKE ub.trn-doc.fact-qnty no-undo.
     1325   if not can-find(first gds-list) then do:
     1326     message
     1327       "Не заданы товары для формирования опреративного баланса."
     1328       view-as alert-box error.
     1329     return.
     1330   end.
     1331   find first buf_clients no-lock
     1332     where buf_clients.obj-type = parobj-type
     1333       and buf_clients.obj-code = parobj-code
     1334     .
     1335   assign
     1336     v-obj-name = buf_clients.obj-name
     1337   .
     1338   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1339   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1340     (input  parobj-type
     1341     ,input  parobj-code
     1342     ,output varhost-code
     1343     )  .
     1344   find first buf_clients no-lock
     1345     where buf_clients.obj-type = 'орг':U
     1346       and buf_clients.obj-code = varhost-code
     1347     .
     1348   assign
     1349     v-host-name = buf_clients.obj-name
     1350   .
     1351               find last previous-shift-obj share-lock
     1352               where previous-shift-obj.obj-type = parobj-type
     1353               and previous-shift-obj.obj-code = parobj-code
     1354               and (( previous-shift-obj.shift-date = X-date-Start
     1355                      and previous-shift-obj.shift-num < X-Shift-Start
     1356                    )
     1357                    or previous-shift-obj.shift-date < X-date-Start
     1358                   )
     1359               use-index pi no-error.
     1360               if available previous-shift-obj then do:
     1361                   var-prev-shift-num = previous-shift-obj.shift-num.
     1362                   var-prev-shift-date = previous-shift-obj.shift-date.
     1363               end.
     1364       for each ub.shift-obj  no-lock
     1365       where ub.shift-obj.obj-code   =  parobj-code
     1366         and ub.shift-obj.obj-type   =  parobj-type
     1367         and ub.shift-obj.shift-date >= X-date-Start
     1368         and ub.shift-obj.shift-date <= X-date-End
     1369           :
     1370           if ub.shift-obj.shift-date = X-date-Start and ub.shift-obj.shift-num < X-Shift-Start then next .
     1371           if ub.shift-obj.shift-date = X-date-End   and ub.shift-obj.shift-num > X-Shift-End then next .
     1372           var-shift-staff  = ''.
     1373           for first ub.shift-staff where
     1374            ub.shift-staff.shift-num = ub.shift-obj.shift-num
     1375            and ub.shift-staff.shift-date = ub.shift-obj.shift-date
     1376            and ub.shift-staff.obj-type = ub.shift-obj.obj-type
     1377            and ub.shift-staff.obj-code = ub.shift-obj.obj-code
     1378            and ub.shift-staff.staff-role = yes no-lock:
     1379                var-shift-staff = ub.shift-staff.name.
     1380           end.
     1381           find first buf_rvs-doc no-lock
     1382             where buf_rvs-doc.obj-type   = parobj-type
     1383             and buf_rvs-doc.obj-code   = parobj-code
     1384             and buf_rvs-doc.shift-date = ub.shift-obj.shift-date
     1385             and buf_rvs-doc.shift-num  = ub.shift-obj.shift-num
     1386             and buf_rvs-doc.status_    = 'факт':U
     1387             and buf_rvs-doc.rvs-type   = 'смена':U
     1388             no-error.
     1389           if not available buf_rvs-doc then next.
     1390             for each buf_rvs-line where buf_rvs-line.rvs-code = buf_rvs-doc.rvs-code no-lock, first gds-list where gds-list.gds-code = buf_rvs-line.gds-code no-lock,
     1391             first ub.goods no-lock where ub.goods.gds-code = buf_rvs-line.gds-code  :
     1392                 create tt-rep.
     1393                 assign
     1394                 tt-rep.shift-date   = ub.shift-obj.shift-date
     1395                 tt-rep.shift-num    = ub.shift-obj.shift-num
     1396                 tt-rep.gds-code    = buf_rvs-line.gds-code
     1397                 tt-rep.goods-name    = goods.gds-name
     1398                 tt-rep.pl-code     = buf_rvs-line.pl-code
     1399                 tt-rep.place_loc1  = string(buf_rvs-line.pl-code)
     1400                 tt-rep.rest_end_measure-kg  =  buf_rvs-line.state-measure-cli-qnty + buf_rvs-line.state-add-qnty * buf_rvs-line.state-density
     1401                 tt-rep.rest_end_book-kg    = buf_rvs-line.system-cli-qnty
     1402                 tt-rep.rest_end_measure-l  =  buf_rvs-line.state-measure-qnty + buf_rvs-line.state-add-qnty
     1403                 tt-rep.rest_end_book-l     = buf_rvs-line.system-qnty
     1404                 tt-rep.rest_end_balans-kg  = tt-rep.rest_end_measure-kg - tt-rep.rest_end_book-kg
     1405                 tt-rep.rest_end_balans-l   = tt-rep.rest_end_measure-l - tt-rep.rest_end_book-l
     1406                 tt-rep.staff               = var-shift-staff
     1407                 tt-rep.time-start          = ub.shift-obj.open-time
     1408                 tt-rep.time-end            = ub.shift-obj.close-time
     1409                 tt-rep.date-end            = ub.shift-obj.close-date
     1410                 .
     1411                 for first ub.place no-lock
     1412                   where ub.place.obj-code = parobj-code
     1413                     and ub.place.obj-type = parobj-type
     1414                     and ub.place.pl-code  = tt-rep.pl-code
     1415                    :
     1416                    if ub.place.loc1 > ''  then assign
     1417                    tt-rep.place_loc1 = ub.place.loc1
     1418                   .
     1419                 end.
     1420             end.
     1421             for each ub.trn-doc no-lock
     1422                 where ub.trn-doc.obj-type   = ub.shift-obj.obj-type
     1423                   and ub.trn-doc.obj-code   = ub.shift-obj.obj-code
     1424                   and ub.trn-doc.shift-date = ub.shift-obj.shift-date
     1425                   and ub.trn-doc.shift-num  = ub.shift-obj.shift-num
     1426                   and ub.trn-doc.status_    = 'факт':U
     1427                   and ub.trn-doc.doc-type   = 'при':U
     1428               on error undo, return error return-value
     1429               :
     1430                 for each ub.doc-pl no-lock
     1431                   where ub.doc-pl.out-code = ub.trn-doc.doc-code,
     1432                     first tt-rep where tt-rep.shift-date   = ub.shift-obj.shift-date
     1433                     and tt-rep.shift-num    = ub.shift-obj.shift-num
     1434                     and tt-rep.gds-code    = ub.doc-pl.gds-code
     1435                     and tt-rep.pl-code     = ub.doc-pl.pl-code
     1436                 on error undo, return error return-value
     1437                 :
     1438                   assign
     1439                     tt-rep.wayb_fact-l = tt-rep.wayb_fact-l + ub.doc-pl.fact-qnty
     1440                     tt-rep.wayb_fact-kg = tt-rep.wayb_fact-kg + ub.doc-pl.cli-fact-qnty
     1441                     tt-rep.density = tt-rep.wayb_fact-kg / tt-rep.wayb_fact-l
     1442                   .
     1443                 end.
     1444               end.
     1445               for each ub.trn-doc no-lock
     1446                 where ub.trn-doc.obj-type   = ub.shift-obj.obj-type
     1447                   and ub.trn-doc.obj-code   = ub.shift-obj.obj-code
     1448                   and ub.trn-doc.shift-date = ub.shift-obj.shift-date
     1449                   and ub.trn-doc.shift-num  = ub.shift-obj.shift-num
     1450                   and ub.trn-doc.status_    = 'факт':U
     1451                   and ub.trn-doc.doc-type   = 'рас':U
     1452               on error undo, return error return-value
     1453               :
     1454                 for each ub.doc-pl no-lock
     1455                   where ub.doc-pl.out-code = ub.trn-doc.doc-code,
     1456                     first tt-rep where tt-rep.shift-date   = ub.shift-obj.shift-date
     1457                     and tt-rep.shift-num    = ub.shift-obj.shift-num
     1458                     and tt-rep.gds-code    = ub.doc-pl.gds-code
     1459                     and tt-rep.pl-code     = ub.doc-pl.pl-code
     1460                 on error undo, return error return-value
     1461                 :
     1462                   assign
     1463                     tt-rep.exp-l = tt-rep.exp-l + ub.doc-pl.fact-qnty
     1464                     tt-rep.exp-kg = tt-rep.exp-kg + ub.doc-pl.cli-fact-qnty
     1465                   .
     1466                 end.
     1467               end.
     1468                           for each ub.trn-doc no-lock
     1469                 where ub.trn-doc.obj-type   = ub.shift-obj.obj-type
     1470                   and ub.trn-doc.obj-code   = ub.shift-obj.obj-code
     1471                   and ub.trn-doc.shift-date = ub.shift-obj.shift-date
     1472                   and ub.trn-doc.shift-num  = ub.shift-obj.shift-num
     1473                   and ub.trn-doc.status_    = 'факт':U
     1474                   and ub.trn-doc.doc-type   = 'возврат':U
     1475               on error undo, return error return-value
     1476               :
     1477                 for each ub.doc-pl no-lock
     1478                   where ub.doc-pl.out-code = ub.trn-doc.doc-code,
     1479                     first tt-rep where tt-rep.shift-date   = ub.shift-obj.shift-date
     1480                     and tt-rep.shift-num    = ub.shift-obj.shift-num
     1481                     and tt-rep.gds-code    = ub.doc-pl.gds-code
     1482                     and tt-rep.pl-code     = ub.doc-pl.pl-code
     1483                 on error undo, return error return-value
     1484                 :
     1485                   assign
     1486                     tt-rep.exp-l = tt-rep.exp-l - ub.doc-pl.fact-qnty
     1487                     tt-rep.exp-kg = tt-rep.exp-kg - ub.doc-pl.cli-fact-qnty
     1488                   .
     1489                 end.
     1490               end.
     1491                           for each ub.trn-doc no-lock
     1492                 where ub.trn-doc.obj-type   = ub.shift-obj.obj-type
     1493                   and ub.trn-doc.obj-code   = ub.shift-obj.obj-code
     1494                   and ub.trn-doc.shift-date = ub.shift-obj.shift-date
     1495                   and ub.trn-doc.shift-num  = ub.shift-obj.shift-num
     1496                   and ub.trn-doc.status_    = 'факт':U
     1497                   and ub.trn-doc.doc-type   = 'спи':U
     1498               on error undo, return error return-value
     1499               :
     1500                 for each ub.doc-pl no-lock
     1501                   where ub.doc-pl.out-code = ub.trn-doc.doc-code,
     1502                     first tt-rep where tt-rep.shift-date   = ub.shift-obj.shift-date
     1503                     and tt-rep.shift-num    = ub.shift-obj.shift-num
     1504                     and tt-rep.gds-code    = ub.doc-pl.gds-code
     1505                     and tt-rep.pl-code     = ub.doc-pl.pl-code
     1506                 on error undo, return error return-value
     1507                 :
     1508                   assign
     1509                     tt-rep.exp-l = tt-rep.exp-l + ub.doc-pl.fact-qnty
     1510                     tt-rep.exp-kg = tt-rep.exp-kg + ub.doc-pl.cli-fact-qnty
     1511                   .
     1512                 end.
     1513               end.
     1514               for first previous-rvs-doc no-lock
     1515                     where previous-rvs-doc.obj-type = parobj-type
     1516                     and previous-rvs-doc.obj-code   = parobj-code
     1517                     and previous-rvs-doc.shift-date = var-prev-shift-date
     1518                     and previous-rvs-doc.shift-num  = var-prev-shift-num
     1519                     and previous-rvs-doc.status_    = 'факт':U
     1520                     and previous-rvs-doc.rvs-type   = 'смена':U,
     1521                     each buf_rvs-line where buf_rvs-line.rvs-code = previous-rvs-doc.rvs-code no-lock,
     1522                     first tt-rep where tt-rep.shift-date   = ub.shift-obj.shift-date
     1523                                 and tt-rep.shift-num    = ub.shift-obj.shift-num
     1524                                 and tt-rep.gds-code    = buf_rvs-line.gds-code
     1525                                 and tt-rep.pl-code     = buf_rvs-line.pl-code
     1526                     :
     1527                     assign
     1528                        tt-rep.rest_start_book-kg       = buf_rvs-line.system-cli-qnty
     1529                        tt-rep.rest_start_book-l       = buf_rvs-line.system-qnty
     1530                        .
     1531                end.
     1532                for each buf_icnt-doc no-lock
     1533                 where buf_icnt-doc.obj-type     = parobj-type
     1534                   and buf_icnt-doc.obj-code     = parobj-code
     1535                   and buf_icnt-doc.doc-type     = 'сч-трк-погр':U
     1536                   and buf_icnt-doc.ext-doc-type = 'em':U
     1537                   and buf_icnt-doc.status_      = 'факт':U
     1538                   and buf_icnt-doc.shift-num = ub.shift-obj.shift-num
     1539                   and buf_icnt-doc.shift-date = ub.shift-obj.shift-date
     1540               on error undo, return error return-value
     1541               :
     1542                 for each buf_icnt-line no-lock
     1543                   where buf_icnt-line.doc-code = buf_icnt-doc.doc-code
     1544                     and buf_icnt-line.obj-code = buf_icnt-doc.obj-code
     1545                     and buf_icnt-line.obj-type = buf_icnt-doc.obj-type:
     1546                     find first ub.pl-gds-pump where ub.pl-gds-pump.obj-code = buf_icnt-line.obj-code
     1547                                               and ub.pl-gds-pump.obj-type = buf_icnt-line.obj-type
     1548                                               and ub.pl-gds-pump.pump-code = buf_icnt-line.pump-code
     1549                                               and ub.pl-gds-pump.status_ <> 'блок':U
     1550                                               and ub.pl-gds-pump.gds-code = buf_icnt-line.gds-code no-error .
     1551                       if not AVAILABLE ub.pl-gds-pump then do:
     1552                          find first ub.pl-gds-pump where ub.pl-gds-pump.obj-code = buf_icnt-line.obj-code
     1553                                               and ub.pl-gds-pump.obj-type = buf_icnt-line.obj-type
     1554                                               and ub.pl-gds-pump.pump-code = buf_icnt-line.pump-code
     1555                                               and ub.pl-gds-pump.gds-code = buf_icnt-line.gds-code no-error .
     1556                       end.
     1557                  find first tt-rep where tt-rep.shift-date   = ub.shift-obj.shift-date
     1558                                 and tt-rep.shift-num    = ub.shift-obj.shift-num
     1559                                 and tt-rep.gds-code    = buf_icnt-line.gds-code
     1560                                 and tt-rep.pl-code     = ub.pl-gds-pump.pl-code
     1561                 no-error .
     1562                   if AVAILABLE tt-rep then do:
     1563                    assign
     1564                        tt-rep.state-el-cnt       = buf_icnt-line.state-el-cnt
     1565                        tt-rep.state-mh-cnt       = buf_icnt-line.state-mh-cnt
     1566                        tt-rep.err-l = tt-rep.err-l + (tt-rep.state-el-cnt - tt-rep.state-mh-cnt)
     1567                        tt-rep.err-kg = tt-rep.err-l * tt-rep.density
     1568                        .
     1569                    end.
     1570                 end.
     1571               end.
     1572               var-prev-shift-num = ub.shift-obj.shift-num.
     1573               var-prev-shift-date = ub.shift-obj.shift-date.
     1574       end.
     1575       run get-report-num in parParentProc (
     1576       output var-report-num
     1577           ).
     1578           v-file-name-rep-htm = session:temp-directory + "rpt" + string(var-report-num) + ".html".
     1579               output to value(v-file-name-rep-htm).
     1580               output close.
     1581           if search("exe\ReportViewer\reportviewer.exe") <> ? then
     1582               do:
     1583                   v-fill-path-RepView = search("exe\ReportViewer\reportviewer.exe").
     1584               end.
     1585           else
     1586               do:
     1587                   message "Не найдена программа просмотра отчёта!" view-as alert-box error.
     1588               end.
     1589    def var v-first-time as int no-undo.
     1590    def var v-first-date as date no-undo.
     1591    def var v-last-date as date no-undo.
     1592    def var v-last-time as int no-undo.
     1593         for first tt-rep by tt-rep.shift-date by tt-rep.shift-num :
     1594             v-first-date = tt-rep.shift-date.
     1595             v-first-time = tt-rep.time-start.
     1596         end.
     1597        for last tt-rep by tt-rep.shift-date by tt-rep.shift-num :
     1598             v-last-date = tt-rep.date-end.
     1599             v-last-time = tt-rep.time-end.
     1600         end.
     1601         output stream OutStr-html to value(v-file-name-rep-htm) convert target 'UTF-8' .
     1602         put stream OutStr-html unformatted
     1603           substitute ('
     1604           <!DOCTYPE HTML>
     1605                 <html>
     1606                   <head>
     1607                   <meta charset="UTF-8">
     1608                       <!-- Стили документа -->
     1609                   <style>
     1610                        table ~{
     1611                            border-collapse: collapse; 
     1612                        ~}
     1613                        tbody td, th ~{
     1614                            border: 1px solid black;
     1615                            border-collapse: collapse;
     1616                      height: 14px;
     1617                        ~}
     1618               
     1619                   </style>
     1620                   </head>
     1621                     <body>
     1622                       <table orientation="landscape" name="Контр.накопит. ведомость" fit_to_page="true">  <!-- таблица, в которой содержится весь отчет -->
     1623                         <thead>  <!-- Шапка отчета -->
     1624                         <!-- Обязательно создаётся строка таблицы, в которой находятся размеры колонок в px-->
     1625                           <tr class="set_columns">
     1626                             <td style="width:50px"></td>
     1627                             <td style="width:85px"></td>
     1628                             <td style="width:85px"></td>
     1629                             <td style="width:50px"></td>
     1630                             <td style="width:50px"></td>
     1631                             <td style="width:50px"></td>
     1632                             <td style="width:50px"></td>
     1633                             <td style="width:50px"></td>
     1634                             <td style="width:50px"></td>
     1635                             <td style="width:50px"></td>
     1636                             <td style="width:50px"></td>
     1637                             <td style="width:50px"></td>
     1638                             <td style="width:50px"></td>
     1639                             <td style="width:50px"></td>
     1640                             <td style="width:50px"></td>
     1641                             <td style="width:50px"></td>
     1642                             <td style="width:50px"></td>
     1643                             <td style="width:50px"></td>
     1644                             <td style="width:60px"></td>
     1645                             <td style="width:136px"></td>
     1646                           </tr>
     1647                         <tr>
     1648                           <td colspan="20"></td>
     1649                         </tr>
     1650                         <tr style="height:30px;">  
     1651                           <td colspan="5" style="border-bottom: 1px solid black; text-align: center;">&1</td>
     1652                           <td colspan="15"></td>
     1653                         </tr>
     1654                         <tr>
     1655                           <td colspan="5" style="font-size:10px; text-align: center;">наименование организации</td>
     1656                           <td colspan="15"></td>
     1657                         </tr>
     1658                         <tr>
     1659                           <td colspan="20" style="font-size:16px;font-weight:bold; text-align: center;">Контрольно-накопительная ведомость учета излишек и недостач нефтепродуктов по  &2</td>
     1660                         </tr>
     1661                         <tr>
     1662                           <td colspan="20" style="text-align:center;"> за период с &3 по &4</td>
     1663                         </tr>
     1664                         <tr>
     1665                           <td colspan="20"></td>
     1666                         </tr>          
     1667                       </thead>
     1668               
     1669                   
     1670                 <tbody> <!-- Здесь начинается таблица отчета -->
     1671                       <tr> <!-- Первые строки – шапка таблицы с тэгами tr -->
     1672                       <th rowspan="3" style="text-align: center;">Номер сменного отчета</th>
     1673                       <th rowspan="2" colspan="2" style="text-align: center;">Дата, время (дд.мм.гг чч:мм)</th>
     1674                       <th rowspan="3" style="text-align: center;">Номер резервуара</th>
     1675                       <th rowspan="2" colspan="2" style="text-align: center;">Расчетный остаток на начало смены</th>
     1676                       <th rowspan="2" colspan="2" style="text-align: center;">Поступило за смену</th>
     1677                       <th rowspan="2" colspan="2" style="text-align: center;">Расход за смену</th>
     1678                       <th rowspan="2" colspan="2" style="text-align: center;">Фактический остаток на конец смены</th>
     1679                       <th rowspan="2" colspan="2" style="text-align: center;">Расчетный остаток на конец смены</th>
     1680                       <th rowspan="2" colspan="2" style="text-align: center;">Результат ("+" - излишки, "-" - недостача)</th>
     1681                       <th rowspan="2" colspan="2" style="text-align: center;">Погрешность ТРК по резервуару за смену</th>
     1682                       <th rowspan="3" style="text-align: center;">Подпись</th>
     1683                       <th rowspan="3" style="text-align: center;">Инициалы, Фамилия</th>
     1684                   </tr>
     1685                   <tr>
     1686                   </tr>
     1687                   <tr>
     1688                       <th style="text-align: center;">начала смены</th>
     1689                       <th style="text-align: center;">окончания смены</th>
     1690                       <th style="text-align: center;">л</th>
     1691                       <th style="text-align: center;">кг</th>
     1692                       <th style="text-align: center;">л</th>
     1693                       <th style="text-align: center;">кг</th>
     1694                       <th style="text-align: center;">л</th>
     1695                       <th style="text-align: center;">кг</th>
     1696                       <th style="text-align: center;">л</th>
     1697                       <th style="text-align: center;">кг</th>
     1698                       <th style="text-align: center;">л</th>
     1699                       <th style="text-align: center;">кг</th>
     1700                       <th style="text-align: center;">л</th>
     1701                       <th style="text-align: center;">кг</th>
     1702                       <th style="text-align: center;">л</th>
     1703                       <th style="text-align: center;">кг</th>
     1704                   </tr>
     1705                   <tr>
     1706                       <th style="text-align: center;">1</th>
     1707                       <th style="text-align: center;">2</th>
     1708                       <th style="text-align: center;">3</th>
     1709                       <th style="text-align: center;">4</th>
     1710                       <th style="text-align: center;">5</th>
     1711                       <th style="text-align: center;">6</th>
     1712                       <th style="text-align: center;">7</th>
     1713                       <th style="text-align: center;">8</th>
     1714                       <th style="text-align: center;">9</th>
     1715                       <th style="text-align: center;">10</th>
     1716                       <th style="text-align: center;">11</th>
     1717                       <th style="text-align: center;">12</th>
     1718                       <th style="text-align: center;">13</th>
     1719                       <th style="text-align: center;">14</th>
     1720                       <th style="text-align: center;">15</th>
     1721                       <th style="text-align: center;">16</th>
     1722                       <th style="text-align: center;">17</th>
     1723                       <th style="text-align: center;">18</th>
     1724                       <th style="text-align: center;">19</th>
     1725                       <th style="text-align: center;">20</th>
     1726                   </tr>'
     1727                   ,
     1728                   string(v-host-name),
     1729                   string(v-obj-name),
     1730                   string(v-first-date, "99.99.9999") + ' ' + string(v-first-time,"HH:MM") ,
     1731                   string(v-last-date, "99.99.9999") + ' ' + string(v-last-time,"HH:MM")
     1732           ).
     1733           for each tt-rep break by tt-rep.gds-code by tt-rep.pl-code on error undo, return error return-value:
     1734               if first-of(tt-rep.gds-code) then do:
     1735                   ASSIGN
     1736                   var-gds-rest_start_measure-kg  = 0
     1737                   var-gds-rest_start_book-kg     = 0
     1738                   var-gds-rest_start_measure-l   = 0
     1739                   var-gds-rest_start_book-l      = 0
     1740                   var-gds-wayb_fact-kg           = 0
     1741                   var-gds-wayb_fact-l            = 0
     1742                   var-gds-exp-kg                 = 0
     1743                   var-gds-exp-l                  = 0
     1744                   var-gds-rest_end_measure-kg   = 0
     1745                   var-gds-rest_end_book-kg      = 0
     1746                   var-gds-rest_end_measure-l    = 0
     1747                   var-gds-rest_end_book-l       = 0
     1748                   var-gds-rest_end_balans-kg    = 0
     1749                   var-gds-rest_end_balans-l     = 0
     1750                   .
     1751                 put stream OutStr-html unformatted
     1752                   substitute ('
     1753                           <tr> <!-- Затем идёт наполнение таблицы -->
     1754                               <th colspan="3" style="text-align:right;">Вид, марка нефтепродукта:</th>
     1755                               <th colspan="17" style="text-align:left;">&1</th>
     1756                           </tr>'
     1757                   ,
     1758                   tt-rep.goods-name
     1759                   ).
     1760          end.
     1761               if first-of(tt-rep.pl-code) then do:
     1762                   ASSIGN
     1763                   var-pl-rest_start_book-kg  = tt-rep.rest_start_book-kg
     1764                   var-pl-rest_start_book-l      = tt-rep.rest_start_book-l
     1765                   var-pl-wayb_fact-kg           = 0
     1766                   var-pl-wayb_fact-l            = 0
     1767                   var-pl-exp-kg                 = 0
     1768                   var-pl-exp-l                  = 0
     1769                   .
     1770                   put stream OutStr-html unformatted
     1771                   substitute ('
     1772                           <tr>
     1773                               <th colspan="3" style="text-align:right;">Резервуар:</th>
     1774                               <th colspan="17" style="text-align:left;">&1</th>
     1775                           </tr>'
     1776                   ,
     1777                   tt-rep.place_loc1
     1778                   ).
     1779               end.
     1780               assign
     1781               var-pl-wayb_fact-kg = var-pl-wayb_fact-kg + tt-rep.wayb_fact-kg
     1782               var-pl-wayb_fact-l = var-pl-wayb_fact-l + tt-rep.wayb_fact-l
     1783               var-pl-exp-kg = var-pl-exp-kg + tt-rep.exp-kg
     1784               var-pl-exp-l = var-pl-exp-l + tt-rep.exp-l
     1785               .
     1786                   put stream OutStr-html unformatted
     1787                   substitute ('
     1788                           <tr> 
     1789                           <td style="text-align:center;"></td>
     1790                           <td style="text-align:center;">&1</td>
     1791                           <td style="text-align:center;">&2</td>
     1792                           <td style="text-align:center;">&3</td>
     1793                           <td style="text-align:right;">&4</td>
     1794                           <td style="text-align:right;">&5</td>
     1795                           <td style="text-align:right;">&6</td>
     1796                           <td style="text-align:right;">&7</td>'
     1797                   ,
     1798                   string(tt-rep.shift-date, "99.99.9999") + ' ' + string (tt-rep.time-start,"hh:mm"),
     1799                   string(tt-rep.date-end, "99.99.9999") + ' ' + string (tt-rep.time-end,"hh:mm"),
     1800                   tt-rep.place_loc1,
     1801                   string(tt-rep.rest_start_book-l,"->>>>>>>>>>>9.99"),
     1802                   string(tt-rep.rest_start_book-kg,"->>>>>>>>>>>9.99"),
     1803                   string(tt-rep.wayb_fact-l,"->>>>>>>>>>>9.99"),
     1804                   string(tt-rep.wayb_fact-kg,"->>>>>>>>>>>9.99")
     1805                   ).
     1806                   put stream OutStr-html unformatted
     1807                   substitute ('
     1808                           <td style="text-align:right;">&1</td>
     1809                           <td style="text-align:right;">&2</td>
     1810                           <td style="text-align:right;">&3</td>
     1811                           <td style="text-align:right;">&4</td>
     1812                           <td style="text-align:right;">&5</td>
     1813                           <td style="text-align:right;">&6</td>
     1814                           <td style="text-align:right;">&7</td>
     1815                           <td style="text-align:right;">&8</td>
     1816                           <td style="text-align:right;">&9</td>
     1817                   '
     1818                   ,
     1819                   string(tt-rep.exp-l,"->>>>>>>>>>>9.99"),
     1820                   string(tt-rep.exp-kg,"->>>>>>>>>>>9.99"),
     1821                   if tt-rep.rest_end_measure-l <> ? then string(tt-rep.rest_end_measure-l,"->>>>>>>>>>>9.99") else '',
     1822                   if tt-rep.rest_end_measure-kg <> ? then string(tt-rep.rest_end_measure-kg,"->>>>>>>>>>>9.99") else '',
     1823                   string(tt-rep.rest_end_book-l,"->>>>>>>>>>>9.99"),
     1824                   string(tt-rep.rest_end_book-kg,"->>>>>>>>>>>9.99"),
     1825                   if tt-rep.rest_end_balans-l <> ? then string(tt-rep.rest_end_balans-l,"->>>>>>>>>>>9.99") else '',
     1826                   if tt-rep.rest_end_balans-kg <> ? then string(tt-rep.rest_end_balans-kg,"->>>>>>>>>>>9.99") else '',
     1827                   string(tt-rep.err-l,"->>>>>>>>>>>9.99")
     1828                   ).
     1829                  put stream OutStr-html unformatted
     1830                   substitute ('
     1831                           <td style="text-align:right;">&1</td>
     1832                           <td style="text-align:center;"></td>
     1833                           <td style="text-align:left;">&2</td>
     1834                           </tr>
     1835                           '
     1836                   ,
     1837                   string(tt-rep.err-kg,"->>>>>>>>>>>9.99"),
     1838                   tt-rep.staff
     1839                   ).
     1840               if last-of(tt-rep.pl-code) then do:
     1841                  ASSIGN
     1842                   var-gds-rest_start_book-kg     = var-gds-rest_start_book-kg + var-pl-rest_start_book-kg
     1843                   var-gds-rest_start_book-l      = var-gds-rest_start_book-l + var-pl-rest_start_book-l
     1844                   var-gds-wayb_fact-kg           = var-gds-wayb_fact-kg + var-pl-wayb_fact-kg
     1845                   var-gds-wayb_fact-l           = var-gds-wayb_fact-l + var-pl-wayb_fact-l
     1846                   var-gds-exp-kg           = var-gds-exp-kg + var-pl-exp-kg
     1847                   var-gds-exp-l           = var-gds-exp-l + var-pl-exp-l
     1848                   var-gds-rest_end_measure-kg   = var-gds-rest_end_measure-kg + tt-rep.rest_end_measure-kg
     1849                   var-gds-rest_end_book-kg      =  var-gds-rest_end_book-kg + tt-rep.rest_end_book-kg
     1850                   var-gds-rest_end_measure-l    =  var-gds-rest_end_measure-l + tt-rep.rest_end_measure-l
     1851                   var-gds-rest_end_book-l       = var-gds-rest_end_book-l + tt-rep.rest_end_book-l
     1852                   var-gds-rest_end_balans-kg    = var-gds-rest_end_balans-kg + tt-rep.rest_end_balans-kg
     1853                   var-gds-rest_end_balans-l     = var-gds-rest_end_balans-l + tt-rep.rest_end_balans-l
     1854                   .
     1855         put stream OutStr-html unformatted
     1856           substitute ('
     1857                   <tr> 
     1858                   <th colspan="3" style="text-align:center">Итого по резервуару номер:</th>
     1859                   <th style="text-align:center;">&1</th>
     1860                   <th style="text-align:right;">&2</th>
     1861                   <th style="text-align:right;">&3</th>
     1862                   <th style="text-align:right;">&4</th>
     1863                   <th style="text-align:right;">&5</th>
     1864                   <th style="text-align:right;">&6</th>
     1865                   <th style="text-align:right;">&7</th>
     1866                  '
     1867           ,
     1868           tt-rep.place_loc1,
     1869           string(var-pl-rest_start_book-l,"->>>>>>>>>>>9.99"),
     1870           string(var-pl-rest_start_book-kg,"->>>>>>>>>>>9.99"),
     1871           string(var-pl-wayb_fact-l,"->>>>>>>>>>>9.99"),
     1872           string(var-pl-wayb_fact-kg,"->>>>>>>>>>>9.99"),
     1873           string(var-pl-exp-l,"->>>>>>>>>>>9.99"),
     1874           string(var-pl-exp-kg,"->>>>>>>>>>>9.99")
     1875           ).
     1876                   put stream OutStr-html unformatted
     1877                   substitute ('
     1878                           <th style="text-align:right;">&1</th>
     1879                           <th style="text-align:right;">&2</th>
     1880                           <th style="text-align:right;">&3</th>
     1881                           <th style="text-align:right;">&4</th>
     1882                           <th style="text-align:right;">&5</th>
     1883                           <th style="text-align:right;">&6</th>
     1884                           <th style="text-align:right;">&7</th>
     1885                           <th style="text-align:right;">&8</th>
     1886                           <th colspan="2" style="text-align:center;"></th>
     1887                           </tr>
     1888                           '
     1889                   ,
     1890                   if tt-rep.rest_end_measure-l <> ? then string(tt-rep.rest_end_measure-l,"->>>>>>>>>>>9.99") else '',
     1891                   if tt-rep.rest_end_measure-kg <> ? then string(tt-rep.rest_end_measure-kg,"->>>>>>>>>>>9.99") else '',
     1892                   string(tt-rep.rest_end_book-l,"->>>>>>>>>>>9.99"),
     1893                   string(tt-rep.rest_end_book-kg,"->>>>>>>>>>>9.99"),
     1894                   if tt-rep.rest_end_balans-l <> ? then string(tt-rep.rest_end_balans-l,"->>>>>>>>>>>9.99") else '',
     1895                   if tt-rep.rest_end_balans-kg <> ? then string(tt-rep.rest_end_balans-kg,"->>>>>>>>>>>9.99") else '',
     1896                   string(tt-rep.err-l,"->>>>>>>>>>>9.99"),
     1897                   string(tt-rep.err-kg,"->>>>>>>>>>>9.99")
     1898                   ).
     1899               end.
     1900               if LAST-of(tt-rep.gds-code) then do:
     1901         put stream OutStr-html unformatted
     1902           substitute ('
     1903                   <tr> 
     1904                   <th colspan="3" style="text-align:center;">Итого по виду, марке нефтепродукта:</th>
     1905                   <th style="text-align:center;">&1</th>
     1906                   <th style="text-align:right;">&2</th>
     1907                   <th style="text-align:right;">&3</th>
     1908                   <th style="text-align:right;">&4</th>
     1909                   <th style="text-align:right;">&5</th>
     1910                   <th style="text-align:right;">&6</th>
     1911                   <th style="text-align:right;">&7</th>
     1912                   <th style="text-align:right;">&8</th>
     1913                   <th style="text-align:right;">&9</th>
     1914                   '
     1915           ,
     1916           '',
     1917           string(var-gds-rest_start_book-l,"->>>>>>>>>>>9.99"),
     1918           string(var-gds-rest_start_book-kg,"->>>>>>>>>>>9.99"),
     1919           string(var-gds-wayb_fact-l,"->>>>>>>>>>>9.99"),
     1920           string(var-gds-wayb_fact-kg,"->>>>>>>>>>>9.99"),
     1921           string(var-gds-exp-l,"->>>>>>>>>>>9.99"),
     1922           string(var-gds-exp-kg,"->>>>>>>>>>>9.99"),
     1923           if var-gds-rest_end_measure-l <> ? then string(var-gds-rest_end_measure-l,"->>>>>>>>>>>9.99") else '',
     1924           if var-gds-rest_end_measure-kg <> ? then string(var-gds-rest_end_measure-kg,"->>>>>>>>>>>9.99") else ''
     1925           ).
     1926         put stream OutStr-html unformatted
     1927           substitute ('
     1928                   <th style="text-align:right;">&1</th>
     1929                   <th style="text-align:right;">&2</th>
     1930                   <th style="text-align:right;">&3</th>
     1931                   <th style="text-align:right;">&4</th>
     1932                   <th style="text-align:right;">&5</th>
     1933                   <th style="text-align:right;">&6</th>
     1934                   <th colspan="2" style="text-align:center;"></th>
     1935                   </tr>
     1936             '
     1937           ,
     1938           string(var-gds-rest_end_book-l,"->>>>>>>>>>>9.99"),
     1939           string(var-gds-rest_end_book-kg,"->>>>>>>>>>>9.99"),
     1940           if var-gds-rest_end_balans-l <> ? then string(var-gds-rest_end_balans-l,"->>>>>>>>>>>9.99") else '',
     1941           if var-gds-rest_end_balans-kg <> ? then string(var-gds-rest_end_balans-kg,"->>>>>>>>>>>9.99") else '',
     1942           string(tt-rep.err-l,"->>>>>>>>>>>9.99"),
     1943           string(tt-rep.err-kg,"->>>>>>>>>>>9.99")
     1944           ).
     1945               end.
     1946           end.
     1947      put stream OutStr-html unformatted
     1948           substitute ('
     1949               
     1950                
     1951               </table>
     1952               </body>
     1953               </html>
     1954               '
     1955               ).
     1956     output stream OutStr-html close.
     1957     run prn-lib-reportviewer-report-name in this-procedure (
     1958                                                             input parParentProc
     1959                                                             ,input v-file-name-rep-htm
     1960                                                             ).
