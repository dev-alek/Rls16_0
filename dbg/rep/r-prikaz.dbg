      958                       v-not-main-b-code         = bar-code.b-code
      959                   .
      960               end.
      961               find first gds-prt no-lock
      962                    where gds-prt.node-code = bar-code.node-code
      963               .
      964               assign
      965                 v-gds-prt-node-name =
      966                 ( if gds-prt.upper-code = goods.prt-root
      967                   then if bar-code.in-code = ''
      968                       then goods.gds-name
      969                       else bar-code.in-code + '    ' + bar-code.part-code
      970                   else
      971                           '    ' + gds-prt.f-name
      972                 )
      973               .
      974               run writelog in this-procedure (log-file-name, 4, "R-AKT.i   Определили имя товара со шкалой ( "
      975                                                   + dtm-char(v-gds-prt-node-name)
      976                                                   + " )").
      977               find first gds-obj no-lock
      978                    where gds-obj.obj-type  = price-list.obj-type
      979                      and gds-obj.obj-code  = price-list.obj-code
      980                      and gds-obj.prod-type = price-list.prod-type
      981                      and gds-obj.prod-code = price-list.prod-code
      982                      and gds-obj.artic     = price-list.artic
      983               no-error.
      984               if available gds-obj
      985               then do:
      986                   assign
      987                       v-gds-obj-last-price = ( if v-rb-is-base = yes then gds-obj.last-base else gds-obj.last-rubl )
      988                   .
      989                   if v-gds-obj-last-price = ?
      990                   then do:
      991                       assign
      992                           v-gds-obj-last-price = 0
      993                       .
      994                   end.
      995                   run writelog in this-procedure (log-file-name, 4, "R-AKT.i   Нашли товар ( "
      996                                   + string(gds-obj.artic) + " )" + " на объекте ( "
      997                                   + price-list.obj-type + string(price-list.obj-code) + " ). Определили цену закупки ( "
      998                                   + dtm-char(string(v-gds-obj-last-price)) + " )"
      999                                                       ).
     1000               end.
     1001               else do:
     1002                   assign
     1003                       v-gds-obj-last-price = 0
     1004                   .
     1005                   run writelog in this-procedure (log-file-name, 4, "R-AKT.i   Не нашли товара ( "
     1006                                   + string(price-list.artic) + " )" + " на объекте ( "
     1007                                   + price-list.obj-type + string(price-list.obj-code) + " ). Назначили цену закупки ( 0 )"
     1008                                                       ).
     1009               end.
     1010               find first gds-prt no-lock
     1011                    where gds-prt.upper-code = goods.prt-root
     1012               .
     1013               assign
     1014                   v-gds-prt-node-code = gds-prt.node-code
     1015               .
