      395   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      396       def var log-file-name as char no-undo.
      397       assign
      398           log-file-name = 'r-akt.log'
      399       .
      400       if log-file-name <> "":U
      401       then do:
      402           if search( 'r-akt.log' ) = ?
      403           then do:
      404               output to value( 'r-akt.log' ).
      405               output close.
      406           end.
      407       end.
      408       DEF STREAM stm-log.
      409       PROCEDURE writelog:
      410       DEF INPUT PARAMETER p-file-name AS CHAR     NO-UNDO.
      411       DEF INPUT PARAMETER p-log-level AS INTEGER  NO-UNDO.
      412       DEF INPUT PARAMETER p-log-string  AS CHAR     NO-UNDO.
      413       if p-file-name <> ""
      414       then do:
      415       OUTPUT STREAM stm-log TO VALUE(p-file-name) APPEND.
      416           PUT STREAM stm-log UNFORMATTED chr(10).
      417           PUT STREAM stm-log UNFORMATTED (IF (p-log-level = 0 OR p-log-string = "&DLine"
      418                                           OR p-log-string = "&Line") THEN "" ELSE
      419                                           cur-time-string-sec() + " ").
      420           PUT STREAM stm-log UNFORMATTED
      421                   (IF p-log-string = "&Line" THEN FILL("-", 80)
      422                   ELSE IF p-log-string = "&DLine" THEN FILL("=", 80)
      423                   ELSE fill(" ", p-log-level * 2) + p-log-string).
      424       OUTPUT STREAM stm-log CLOSE.
      425       end.
      426       END PROCEDURE.
