        8   define variable vss-revision    as character no-undo init "$Revision: a8e2cf75ddf6, 2506, rls $":U .
        9   define variable vss-author      as character no-undo init "$Author: EShklyar $":U .
       10   define variable vss-date        as character no-undo init "$Date: Ср июл 08 17:09:06 2020 +0300 $":U .
