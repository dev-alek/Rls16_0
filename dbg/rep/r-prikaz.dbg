     1134   procedure print-line-no-fact :
     1135       if not can-find( first gds-prt where gds-prt.upper-code = v-gds-prt-node-code)
     1136           then
     1137       do:
     1138           if v-print-cost-price = no then     p-procent =    ( price-list.price-sale - v-price-list-price-sale_old )  / v-price-list-price-sale_old * 100.
     1139           else     p-procent =  ( 100 * ( price-list.price-sale - v-gds-obj-last-price ) / v-gds-obj-last-price ).
     1140       end.
     1141       else
     1142       do  :
     1143           if     v-print-cost-price = no then  p-procent = ( price-list.price-sale - v-gds-obj-last-price ) / v-gds-obj-last-price * 100.
     1144           else  p-procent =  ( price-list.price-sale - v-price-list-price-sale_old ) / v-price-list-price-sale_old * 100.
     1145       end.
     1146       assign
     1147           v-line-counter      = v-line-counter + 1
     1148           v-good-line-counter = v-good-line-counter + 1
     1149           .
     1150       if v-print-cost-price = no
     1151           then
     1152       do:
     1153           p-number = p-number + 1.
     1154           if p-sort-by-group = yes
     1155               then
     1156           do:
     1157               if v-print-group = yes          then
     1158               do:
     1159                   put stream OutStr-html unformatted
     1160                       '       <tr level="1">' skip
     1161                   '         <td colspan="8" style="border: none; height: 14px;  text-align: left; font-size: 10pt; font-weight: bold">' +  goods.grp-name  + '</td>' skip
     1162                   '</tr>' skip
     1163                   .
     1164               end.
     1165               put stream OutStr-html unformatted
     1166                   '       <tr level="2">' skip
     1167                   '         <td style="display: yes; text-align: center ">'  + if p-number  <> ?  then fnc-convert-dot-to-colon( p-number , "->>>>>>>9") + '</td>' else "?" + '</td>' skip
     1168                   '         <td style="display: yes; text-align: center ">'  + if goods.gds-code  <> ?  then fnc-convert-dot-to-colon( goods.gds-code , "->>>>>>>9") + '</td>' else "?" + '</td>' skip
     1169                   '         <td style="display: yes; text-align:  right ">'  +  price-list.artic   + '</td>'  skip
     1170                   '         <td style="display: yes; text-align:  right ">'  +        goods.gds-name + '</td>' skip
     1171                   '         <td style="display: yes; text-align:  right ">'  + if      price-list.doc-qnty  <> ?  then fnc-convert-dot-to-colon( price-list.doc-qnty , "->>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     1172                   '         <td style="display: yes; text-align:  right ">'  + if    v-price-list-price-sale_old   <> ?  then fnc-convert-dot-to-colon( v-price-list-price-sale_old  , "->>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     1173                   '         <td style="display: yes; text-align:  right ">'  + if     price-list.price-sale   <> ?  then fnc-convert-dot-to-colon(  price-list.price-sale  , "->>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     1174                   '         <td style="display: yes; text-align:  right ">'  + if     p-procent   <> ?  then fnc-convert-dot-to-colon(   p-procent  , "->>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     1175                   '       </tr>' skip
     1176                   .
     1177           end.
     1178           else
     1179           do:
     1180               put stream OutStr-html unformatted
     1181                   '       <tr level="1">' skip
     1182                   '         <td style="display: yes; text-align: center ">'  + if p-number  <> ?  then fnc-convert-dot-to-colon( p-number , "->>>>>>>9") + '</td>' else "?" + '</td>' skip
     1183                   '         <td style="display: yes; text-align: center ">'  + if goods.gds-code  <> ?  then fnc-convert-dot-to-colon( goods.gds-code , "->>>>>>>9") + '</td>' else "?" + '</td>' skip
     1184                   '         <td style="display: yes; text-align:  right ">'  +  price-list.artic   + '</td>'  skip
     1185                   '         <td style="display: yes; text-align:  right ">'  +   goods.gds-name + '</td>' skip
     1186                   '         <td style="display: yes; text-align:  right ">'  + if      price-list.doc-qnty  <> ?  then fnc-convert-dot-to-colon( price-list.doc-qnty , "->>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     1187                   '         <td style="display: yes; text-align:  right ">'  + if    v-price-list-price-sale_old   <> ?  then fnc-convert-dot-to-colon( v-price-list-price-sale_old  , "->>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     1188                   '         <td style="display: yes; text-align:  right ">'  + if     price-list.price-sale   <> ?  then fnc-convert-dot-to-colon(  price-list.price-sale  , "->>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     1189                   '         <td style="display: yes; text-align:  right ">'  + if     p-procent   <> ?  then fnc-convert-dot-to-colon(   p-procent  , "->>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     1190                   '       </tr>' skip
     1191                   .
     1192           end.
     1193       end.
     1194       else
     1195       do:
     1196           p-number = p-number + 1.
     1197           if p-sort-by-group = yes
     1198               then
     1199           do:
     1200               if v-print-group = yes          then
     1201               do:
     1202                   put stream OutStr-html unformatted
     1203                       '       <tr level="1">' skip
     1204                       '         <td colspan="7" style="border: none; height: 14px;  text-align: left; font-size: 10pt; font-weight: bold">' +  goods.grp-name  + '</td>' skip
     1205                       '</tr>' skip
     1206                       .
     1207               end.
     1208               put stream OutStr-html unformatted
     1209                   '       <tr level="2">' skip
     1210                   '         <td style="display: yes; text-align: center ">'  + if goods.gds-code  <> ?  then fnc-convert-dot-to-colon( goods.gds-code , "->>>>>>>9") + '</td>' else "?" + '</td>' skip
     1211                   '         <td style="display: yes; text-align:  right ">'  +  price-list.artic   + '</td>'  skip
     1212                   '         <td style="display: yes; text-align:  right ">'  +        goods.gds-name + '</td>' skip
     1213                   '         <td style="display: yes; text-align:  right ">'  + if      price-list.doc-qnty  <> ?  then fnc-convert-dot-to-colon( price-list.doc-qnty , "->>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     1214                   '         <td style="display: yes; text-align:  right ">'  + if    v-gds-obj-last-price   <> ?  then fnc-convert-dot-to-colon( v-gds-obj-last-price  , "->>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     1215                   '         <td style="display: yes; text-align:  right ">'  + if     price-list.price-sale   <> ?  then fnc-convert-dot-to-colon(  price-list.price-sale  , "->>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     1216                   '         <td style="display: yes; text-align:  right ">'  + if     p-procent   <> ?  then fnc-convert-dot-to-colon(   p-procent  , "->>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     1217                   '       </tr>' skip
     1218                   .
     1219           end.
     1220           else
     1221           do:
     1222               put stream OutStr-html unformatted
     1223                   '       <tr level="1">' skip
     1224                   '         <td style="display: yes; text-align: center ">'  + if goods.gds-code  <> ?  then fnc-convert-dot-to-colon( goods.gds-code , "->>>>>>>9") + '</td>' else "?" + '</td>' skip
     1225                   '         <td style="display: yes; text-align:  right ">'  +  price-list.artic   + '</td>'  skip
     1226                   '         <td style="display: yes; text-align:  right ">'  +        goods.gds-name + '</td>' skip
     1227                   '         <td style="display: yes; text-align:  right ">'  + if      price-list.doc-qnty  <> ?  then fnc-convert-dot-to-colon( price-list.doc-qnty , "->>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     1228                   '         <td style="display: yes; text-align:  right ">'  + if    v-gds-obj-last-price   <> ?  then fnc-convert-dot-to-colon( v-gds-obj-last-price  , "->>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     1229                   '         <td style="display: yes; text-align:  right ">'  + if     price-list.price-sale   <> ?  then fnc-convert-dot-to-colon(  price-list.price-sale  , "->>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     1230                   '         <td style="display: yes; text-align:  right ">'  + if     p-procent   <> ?  then fnc-convert-dot-to-colon(   p-procent  , "->>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     1231                   '       </tr>' skip
     1232                   .
     1233           end.
     1234       end.
     1235   end procedure.
     1236   run search-full-path-Report(input v-report-name-html).
     1237   run Report-Viewer(input v-full-path-RepView, input v-report-name-html).
     1238    function fnc-DD-MM-YYYY returns character
     1239   (input p-dat-date as date):
     1240       define variable result as character no-undo.
     1241       define variable p-str-date as character no-undo.
     1242       p-str-date = replace(string(p-dat-date,'99.99.9999'), "/", ".").
     1243           return p-str-date.
     1244   end function.
     1245   function fnc-convert-dot-to-colon returns character
     1246       (input p-data as decimal, input p-accur as character):
     1247       define variable result       as character no-undo.
     1248       define variable v-str-result as character no-undo.
     1249       p-data = round(p-data, 2).
     1250       v-str-result = trim(replace(string(p-data, p-accur), ".", ",")).
     1251       return v-str-result.
     1252   end function.
     1253   procedure create-file:
     1254       define input parameter p-file-name as character no-undo.
     1255       output to value(string(p-file-name)).
     1256       output close.
     1257   end procedure.
     1258   procedure search-full-path-Report:
     1259       define input parameter p-file-name as character no-undo.
     1260       if search(p-file-name) = ? then
     1261       do:
     1262           message "Не найден файл отчёта: " p-file-name view-as alert-box error.
     1263       end.
     1264       else
     1265       do:
     1266           p-file-name = search(p-file-name).
     1267       end.
     1268   end procedure.
     1269   procedure define-full-path-Report:
     1270       define input parameter p-rep-num as integer no-undo.
     1271       define output parameter p-file-name-rep-htm as character no-undo.
     1272       p-file-name-rep-htm = session:temp-directory + "rpt" + string(p-rep-num) + ".html".
     1273   end procedure.
     1274   procedure Report-Viewer:
     1275       define input parameter p-full-path-RepView as character no-undo.
     1276       define input parameter p-file-name-rep-htm as character no-undo.
     1277       os-command no-wait value(p-full-path-RepView + " true " + search(p-file-name-rep-htm)).
     1278   end procedure.
     1279   procedure get-full-path-RepViewer:
     1280       define output parameter p-fill-path-RepView as character no-undo.
     1281       if search("exe\ReportViewer\reportviewer.exe") <> ? then
     1282       do:
     1283           p-fill-path-RepView = search("exe\ReportViewer\reportviewer.exe").
     1284       end.
     1285       else
     1286       do:
     1287           message "Не найдена программа просмотра отчёта!" view-as alert-box error.
     1288       end.
     1289   end procedure.
