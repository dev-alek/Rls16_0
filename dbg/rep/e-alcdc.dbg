     3507   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     3508   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     3509   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     3510   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     3511   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     3512   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     3513   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     3514   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     3515         adm-object-hdl = FRAME F-Main:HANDLE.
     3516   RUN ensure-broker.
     3517   THIS-PROCEDURE:ADM-DATA =
     3518        'ADM1.1~`':U +
     3519        'SmartObject~`':U +
     3520        '~`':U +
     3521        'NO ~`':U +
     3522        '~`':U +
     3523        '~`':U +
     3524        '~`':U +
     3525        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     3526           + "~`":U +
     3527        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
     3528        'Record-Source,Record-Target,TableIO-Target~`':U +
     3529        '~`':U +
     3530        '~`~`~`~`~`~`~`~`~`~`~`':U +
     3531        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     3532            THEN "^^":U
     3533        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     3534             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     3535   PROCEDURE adm-apply-entry :
     3536     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     3537   END PROCEDURE.
     3538   PROCEDURE adm-destroy :
     3539    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     3540   END PROCEDURE.
     3541   PROCEDURE adm-disable :
     3542       DISABLE RECT-13 RADIO-SET-ver FILL-IN-kor RADIO-SET-form FILL-IN-exp-date RADIO-ALC-PRODUCER EDITOR-ALC-PRODUCER RADIO-SUPPLIER EDITOR-SUPPLIER RADIO-ALC-TYPE EDITOR-ALC-TYPE TOGGLE-Excel TOGGLE-XML TOGGLE-KPP WITH FRAME F-Main.
     3543       RUN dispatch ('disable-fields':U).
     3544       RUN set-attribute-list ('ENABLED=no':U).
     3545       RETURN.
     3546   END PROCEDURE.
     3547   PROCEDURE adm-edit-attribute-list :
     3548         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
     3549         RETURN.
     3550   END PROCEDURE.
     3551   PROCEDURE adm-enable :
     3552       ENABLE UNLESS-HIDDEN RECT-13 RADIO-SET-ver FILL-IN-kor RADIO-SET-form FILL-IN-exp-date RADIO-ALC-PRODUCER EDITOR-ALC-PRODUCER RADIO-SUPPLIER EDITOR-SUPPLIER RADIO-ALC-TYPE EDITOR-ALC-TYPE TOGGLE-Excel TOGGLE-XML TOGGLE-KPP WITH FRAME F-Main.
     3553       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     3554       RUN set-attribute-list ('ENABLED=yes':U).
     3555       RETURN.
     3556   END PROCEDURE.
     3557   PROCEDURE adm-exit :
     3558        RUN notify ('exit':U).
     3559     RETURN.
     3560   END PROCEDURE.
     3561   PROCEDURE adm-hide :
     3562     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     3563   END PROCEDURE.
     3564   PROCEDURE adm-initialize :
     3565     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     3566   END PROCEDURE.
     3567   PROCEDURE adm-show-errors :
     3568       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     3569       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     3570           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     3571       END.
     3572       RETURN.
     3573   END PROCEDURE.
     3574   PROCEDURE adm-UIB-mode :
     3575     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     3576   END PROCEDURE.
     3577   PROCEDURE adm-view :
     3578     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     3579   END PROCEDURE.
     3580   PROCEDURE dispatch :
     3581       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     3582       RUN broker-dispatch IN adm-broker-hdl
     3583           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     3584       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     3585   END PROCEDURE.
     3586   PROCEDURE ensure-broker :
     3587   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     3588   IF RETURN-VALUE NE "ADM-Broker":U THEN
     3589   DO:
     3590       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     3591       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     3592   END.
     3593   END PROCEDURE.
     3594   PROCEDURE get-attribute :
     3595     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     3596     RUN broker-get-attribute IN adm-broker-hdl
     3597         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     3598     RETURN RETURN-VALUE.
     3599   END PROCEDURE.
     3600   PROCEDURE get-attribute-list :
     3601     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     3602     RUN broker-get-attribute-list IN adm-broker-hdl
     3603         (INPUT THIS-PROCEDURE,
     3604          INPUT ?,
     3605          OUTPUT p-attr-list) NO-ERROR.
     3606     RETURN.
     3607   END PROCEDURE.
     3608   PROCEDURE new-state :
     3609     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     3610     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     3611     RETURN.
     3612   END PROCEDURE.
     3613   PROCEDURE notify :
     3614     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     3615     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     3616     IF RETURN-VALUE = "ADM-ERROR":U THEN
     3617         RETURN "ADM-ERROR":U.
     3618     RETURN.
     3619   END PROCEDURE.
     3620   PROCEDURE set-attribute-list :
     3621     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     3622     RUN ensure-broker.
     3623     RUN broker-set-attribute-list IN adm-broker-hdl
     3624         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     3625     RETURN.
     3626   END PROCEDURE.
     3627   PROCEDURE set-position :
     3628       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     3629       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     3630       IF VALID-HANDLE(adm-object-hdl) THEN
     3631       DO:
     3632         ASSIGN adm-object-hdl:ROW    =   p-row
     3633                adm-object-hdl:COLUMN =   p-col.
     3634       END.
     3635       RETURN.
     3636   END PROCEDURE.
     3637   PROCEDURE adm-display-fields :
     3638       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
     3639       RETURN.
     3640   END PROCEDURE.
     3641   PROCEDURE adm-open-query :
     3642     RETURN.
     3643   END PROCEDURE.
     3644   PROCEDURE adm-row-changed :
     3645         IF VALID-HANDLE(adm-object-hdl) THEN
     3646           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     3647         RUN notify ('row-available':U).
     3648         RETURN.
     3649   END PROCEDURE.
     3650   PROCEDURE reposition-query :
     3651       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
     3652       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
     3653       RETURN.
     3654   END PROCEDURE.
     3655     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
     3656     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
     3657     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
     3658     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
     3659     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
     3660     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
     3661     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
     3662     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
     3663     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     3664     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
     3665     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     3666     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
     3667     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
     3668     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
     3669     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
     3670     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
     3671     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
     3672     IF "":U = "":U THEN
     3673       RUN modify-list-attribute IN adm-broker-hdl
     3674         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
     3675     RUN use-create-on-add(?).
     3676   PROCEDURE adm-add-record :
     3677       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     3678          "must have at least one Enabled Table to perform Add.":U
     3679          VIEW-AS ALERT-BOX ERROR.
     3680       RETURN.
     3681   END PROCEDURE.
     3682   PROCEDURE adm-assign-record :
     3683    MESSAGE
     3684          "Object ":U THIS-PROCEDURE:FILE-NAME
     3685            "must have at least one Enabled Table to perform Assign.":U
     3686              VIEW-AS ALERT-BOX ERROR.
     3687      RETURN.
     3688     END PROCEDURE.
     3689   PROCEDURE adm-assign-statement :
     3690     RETURN.
     3691   END PROCEDURE.
     3692   PROCEDURE adm-cancel-record :
     3693      RETURN.
     3694     END PROCEDURE.
     3695   PROCEDURE adm-copy-record :
     3696       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     3697        "must have at least one Enabled Table to perform Copy.":U
     3698          VIEW-AS ALERT-BOX ERROR.
     3699       RETURN.
     3700   END PROCEDURE.
     3701   PROCEDURE adm-create-record :
     3702      RETURN.
     3703   END PROCEDURE.
     3704   PROCEDURE adm-current-changed :
     3705     RETURN.
     3706   END PROCEDURE.
     3707   PROCEDURE adm-delete-record :
     3708    MESSAGE
     3709          "Object ":U THIS-PROCEDURE:FILE-NAME
     3710            "must have at least one Enabled Table to perform Delete.":U
     3711              VIEW-AS ALERT-BOX ERROR.
     3712       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
     3713       RETURN.
     3714   END PROCEDURE.
     3715   PROCEDURE adm-disable-fields :
     3716         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
     3717       RETURN.
     3718   END PROCEDURE.
     3719   PROCEDURE adm-enable-fields :
     3720       RETURN.
     3721   END PROCEDURE.
     3722   PROCEDURE adm-end-update :
     3723     RETURN.
     3724   END PROCEDURE.
     3725   PROCEDURE adm-reset-record :
     3726       RETURN.
     3727   END PROCEDURE.
     3728   PROCEDURE adm-update-record :
     3729       MESSAGE
     3730         "Object ":U THIS-PROCEDURE:FILE-NAME
     3731           "must have at least one Enabled Table to perform Update.":U
     3732             VIEW-AS ALERT-BOX ERROR.
     3733      RETURN.
     3734   END PROCEDURE.
     3735   PROCEDURE check-modified :
     3736   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     3737   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     3738   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     3739   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     3740     IF check-state = "check":U THEN
     3741     DO:
     3742       RUN get-link-handle IN adm-broker-hdl
     3743         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     3744            OUTPUT group-target-list).
     3745       IF group-target-list NE "":U THEN
     3746       DO i = 1 TO NUM-ENTRIES(group-target-list):
     3747         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     3748         RUN check-modified IN curr-widget ('group-check':U).
     3749         IF RETURN-VALUE NE "":U THEN
     3750         DO:
     3751           RUN check-modified-message(RETURN-VALUE).
     3752           RETURN "":U.
     3753         END.
     3754       END.
     3755     END.
     3756     RETURN "":U.
     3757   END PROCEDURE.
     3758   PROCEDURE check-modified-message :
     3759     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     3760        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     3761           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     3762        IF RETURN-VALUE = "YES":U THEN
     3763           RUN notify ('view,CONTAINER-SOURCE':U).
     3764        MESSAGE IF p-changed-table NE ? THEN
     3765           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     3766           ELSE "Current values have been changed."
     3767           SKIP "  Do you wish to save those changes?"
     3768           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     3769        IF ANS THEN
     3770        DO:
     3771           IF group-assign-target THEN
     3772             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     3773           ELSE RUN dispatch('update-record':U).
     3774           IF RETURN-VALUE = "ADM-ERROR":U THEN
     3775           DO:
     3776               MESSAGE "Changes to the previous record were not saved."
     3777                 VIEW-AS ALERT-BOX ERROR.
     3778               IF group-assign-target THEN
     3779                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     3780               ELSE RUN dispatch ('cancel-record':U).
     3781           END.
     3782        END.
     3783        ELSE DO:
     3784          IF group-assign-target THEN
     3785             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     3786          ELSE RUN dispatch('cancel-record':U).
     3787        END.
     3788        RETURN.
     3789   END PROCEDURE.
     3790   PROCEDURE get-rowid :
     3791       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     3792       ASSIGN
     3793       p-table   =   adm-first-table.
     3794       RETURN.
     3795   END PROCEDURE.
     3796   PROCEDURE init-group-assign :
     3797       RUN request-attribute IN adm-broker-hdl
     3798         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     3799       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     3800         group-assign-target = yes.
     3801       ELSE group-assign-target = no.
     3802       RETURN.
     3803   END PROCEDURE.
     3804   PROCEDURE set-editors :
     3805       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     3806       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     3807       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     3808       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     3809       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     3810       DO WHILE VALID-HANDLE (curr-widget):
     3811           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     3812              curr-widget:HIDDEN = no THEN DO:
     3813             CASE p-field-setting:
     3814               WHEN "INITIALIZE":U THEN
     3815               DO:
     3816                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     3817                     read-only-list +
     3818                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     3819                        STRING(curr-widget).
     3820               END.
     3821               WHEN "DISABLE":U OR
     3822               WHEN "ENABLE":U THEN
     3823               DO:
     3824                   curr-widget:SENSITIVE = yes.
     3825                   RUN get-attribute ('Read-Only-Editors':U).
     3826                   IF RETURN-VALUE = ? OR
     3827                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     3828                       curr-widget:READ-ONLY =
     3829                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     3830               END.
     3831               WHEN "CLEAR":U THEN
     3832                   curr-widget:SCREEN-VALUE = "":U.
     3833             END CASE.
     3834           END.
     3835           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     3836       END.
     3837       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     3838         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     3839           + '"':U).
     3840       RETURN.
     3841   END PROCEDURE.
     3842   PROCEDURE use-check-modified-all :
     3843    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     3844     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     3845     RETURN.
     3846   END PROCEDURE.
     3847   PROCEDURE use-create-on-add :
     3848   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     3849      RETURN.
     3850   END PROCEDURE.
     3851   PROCEDURE use-initial-lock :
     3852     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     3853     ASSIGN adm-initial-lock = p-attr-value.
     3854     RETURN.
     3855   END PROCEDURE.
     3856     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     3857   ASSIGN
     3858          FRAME F-Main:SCROLLABLE       = FALSE
     3859          FRAME F-Main:HIDDEN           = TRUE
     3860          FRAME F-Main:PRIVATE-DATA     =
     3861                   "DLGCLOSE".
     3862   ASSIGN
     3863          EDITOR-ALC-PRODUCER:READ-ONLY IN FRAME F-Main        = TRUE.
     3864   ASSIGN
     3865          EDITOR-ALC-TYPE:READ-ONLY IN FRAME F-Main        = TRUE.
     3866   ASSIGN
     3867          EDITOR-SUPPLIER:READ-ONLY IN FRAME F-Main        = TRUE.
     3868   ON VALUE-CHANGED OF RADIO-ALC-PRODUCER IN FRAME F-Main
     3869   DO:
     3870       assign RADIO-ALC-PRODUCER.
     3871       for each alc-producers:
     3872           delete alc-producers.
     3873       end.
     3874       case RADIO-ALC-PRODUCER:
     3875          when 1 then do:
     3876              assign  EDITOR-ALC-PRODUCER = "По всем производителям".
     3877              display EDITOR-ALC-PRODUCER with frame F-Main.
     3878          end.
     3879          when 2 then do:
     3880              run ref/cli-all.w ( my-handle
     3881                           , "b-sel,b-mark"
     3882                           , 'орг':U
     3883                           , 'все':U
     3884                           , ?
     3885                           , ?
     3886                           , ",,,,,,NO,,"
     3887                           , ?
     3888                           , output alc-producers_recids).
     3889              if alc-producers_recids = "" then do:
     3890                   assign  EDITOR-ALC-PRODUCER = "По всем производителям" RADIO-ALC-PRODUCER = 1.
     3891                   display EDITOR-ALC-PRODUCER RADIO-ALC-PRODUCER with frame F-Main.
     3892              end.
     3893              else do:
     3894                  assign  EDITOR-ALC-PRODUCER = ''.
     3895                  do ii = 1 to num-entries( alc-producers_recids ):
     3896                      find first buf_clients where recid( buf_clients ) = int(entry( ii, alc-producers_recids )) no-lock no-error.
     3897                        if available buf_clients then do:
     3898                            create alc-producers.
     3899                            assign
     3900                              alc-producers.obj-type = buf_clients.obj-type
     3901                              alc-producers.obj-code = buf_clients.obj-code
     3902                              alc-producers.obj-name = buf_clients.obj-name.
     3903                            EDITOR-ALC-PRODUCER = EDITOR-ALC-PRODUCER + alc-producers.obj-name + chr(10).
     3904                        end.
     3905                  end.
     3906                   display EDITOR-ALC-PRODUCER with frame F-Main .
     3907              end.
     3908          end.
     3909       end case.
     3910   END.
     3911   ON VALUE-CHANGED OF RADIO-ALC-TYPE IN FRAME F-Main
     3912   DO:
     3913       assign RADIO-ALC-TYPE.
     3914       for each alc-types : delete alc-types. end.
     3915       case RADIO-ALC-TYPE:
     3916          when 1 then do:
     3917              assign  EDITOR-ALC-TYPE = "По всем типам продукции".
     3918              display EDITOR-ALC-TYPE with frame F-Main.
     3919          end.
     3920          when 2 then do:
     3921              run ref/alc-type.w ( my-handle
     3922                                 , "b-sel,b-mark,alc"
     3923                                 , input-output alc-types_recids
     3924                                 , output l-ok).
     3925              if alc-types_recids = "" then do:
     3926                   assign  EDITOR-ALC-TYPE = "По всем типам продукции" RADIO-ALC-TYPE = 1.
     3927                   display EDITOR-ALC-TYPE RADIO-ALC-TYPE with frame F-Main.
     3928              end.
     3929              else do:
     3930                  for each alc-types exclusive-lock:
     3931                      delete alc-types.
     3932                  end.
     3933                  assign  EDITOR-ALC-TYPE = ''.
     3934                  do ii = 1 to num-entries(alc-types_recids):
     3935                      find first buf_alc-type where recid( buf_alc-type ) = int(entry( ii, alc-types_recids)) no-lock no-error.
     3936                        if available buf_alc-type then do:
     3937                            create alc-types.
     3938                            assign
     3939                              alc-types.type-code     = buf_alc-type.alc-type-inner-code
     3940                              alc-types.alc-type-name = buf_alc-type.alc-type-name
     3941                              alc-types.alc-type-code = buf_alc-type.alc-type-code
     3942                              EDITOR-ALC-TYPE = EDITOR-ALC-TYPE + alc-types.alc-type-name + chr(10).
     3943                        end.
     3944                  end.
     3945                   display EDITOR-ALC-TYPE with frame F-Main .
     3946              end.
     3947          end.
     3948       end case.
     3949   END.
     3950   ON VALUE-CHANGED OF RADIO-SET-form IN FRAME F-Main
     3951   DO:
     3952       assign RADIO-SET-form.
     3953       case RADIO-SET-form:
     3954           when 1 then
     3955               assign FILL-IN-kor:hidden in frame F-Main = true.
     3956           when 2 then
     3957               assign FILL-IN-kor:hidden in frame F-Main = false.
     3958       end case.
     3959   END.
     3960   ON VALUE-CHANGED OF RADIO-SUPPLIER IN FRAME F-Main
     3961   DO:
     3962       assign RADIO-SUPPLIER.
     3963       for each alc-suppliers:
     3964           delete alc-suppliers.
     3965       end.
     3966       case RADIO-SUPPLIER:
     3967           when 1 then do:
     3968               assign  EDITOR-SUPPLIER = "По всем поставщикам".
     3969                   display EDITOR-SUPPLIER with frame F-Main.
     3970           end.
     3971           when 2 then do:
     3972               run ref/cli-all.w ( my-handle
     3973                                 , "b-sel,b-mark"
     3974                                 , 'орг':U
     3975                                 , 'все':U
     3976                                 , ?
     3977                                 , ?
     3978                                 , ",,,,,,NO,,"
     3979                                 , ?
     3980                                 , output alc-suppliers_recids).
     3981               if alc-suppliers_recids = "" then do:
     3982                   assign  EDITOR-SUPPLIER = "По всем поставщикам" RADIO-SUPPLIER = 1.
     3983                   display EDITOR-SUPPLIER RADIO-SUPPLIER with frame F-Main.
     3984               end.
     3985               else do:
     3986                   assign  EDITOR-SUPPLIER = ''.
     3987                   do ii = 1 to num-entries( alc-suppliers_recids ):
     3988                       find first buf_clients where recid( buf_clients ) = int(entry( ii, alc-suppliers_recids )) no-lock no-error.
     3989                       if available buf_clients then do:
     3990                           create alc-suppliers.
     3991                           assign
     3992                               alc-suppliers.obj-type = buf_clients.obj-type
     3993                               alc-suppliers.obj-code = buf_clients.obj-code
     3994                               alc-suppliers.obj-name = buf_clients.obj-name
     3995                               EDITOR-SUPPLIER = EDITOR-SUPPLIER + alc-suppliers.obj-name + chr(10).
     3996                       end.
     3997                   end.
     3998                   display EDITOR-SUPPLIER with frame F-Main .
     3999               end.
     4000           end.
     4001       end case.
     4002   END.
     4003   if not this-procedure :persistent
     4004   then do:
     4005     message
     4006       vss-workfile vss-revision vss-description skip
     4007       "Ошибка при запуске процедуры" skip
     4008       "Данную процедуру следует запускать только с параметром persistent" skip
     4009       view-as alert-box error .
     4010     undo, return error .
     4011   end.
     4012   PROCEDURE disable_UI :
     4013     HIDE FRAME F-Main.
     4014     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     4015   END PROCEDURE.
     4016   PROCEDURE my-report :
     4017   define variable fact-order-start as decimal   no-undo.
     4018   define variable fact-order-end   as decimal   no-undo.
     4019   define variable wait-message     as character no-undo.
     4020   define variable imp-or-prod-type as character no-undo.
     4021   define variable imp-or-prod-code as integer   no-undo.
     4022   define variable v-attr-val       as character no-undo.
     4023   define variable v-attr-type      as character no-undo.
     4024   define variable v-obj-code as integer no-undo.
     4025   define variable v-obj-type as character no-undo.
     4026   assign frame F-Main RADIO-ALC-PRODUCER RADIO-ALC-TYPE RADIO-SUPPLIER TOGGLE-Excel
     4027       TOGGLE-XML TOGGLE-KPP RADIO-SET-ver RADIO-SET-form FILL-IN-kor FILL-IN-exp-date.
     4028   for each part-1 exclusive-lock:
     4029       delete part-1.
     4030   end.
     4031   for each part-1 exclusive-lock:
     4032       delete part-2.
     4033   end.
     4034   quarter = 1.
     4035   l-ok = yes.
     4036   if day(x-date-start) = 1 and month(x-date-end + 1) <> month(x-date-end) then do:
     4037       if month(x-date-start) = 1  and month(x-date-end) = 3  then quarter = 3.
     4038       if month(x-date-start) = 4  and month(x-date-end) = 6  then quarter = 6.
     4039       if month(x-date-start) = 7  and month(x-date-end) = 9  then quarter = 9.
     4040       if month(x-date-start) = 10 and month(x-date-end) = 12 then quarter = 0.
     4041   end.
     4042   if quarter = 1 then message "Даты не совпадают с кварталом" skip "Продолжить?" view-as alert-box buttons yes-no update l-OK.
     4043   if l-ok = no then return.
     4044   run day-begin-fact-order(input x-date-start, output fact-order-start).
     4045   run factord-end-day(input x-date-end, output fact-order-end).
     4046   if RADIO-ALC-PRODUCER = 2 then do:
     4047       for each alc-producers exclusive-lock :
     4048           find first buf_clients-attr no-lock where buf_clients-attr.obj-code = alc-producers.obj-code
     4049                                                 and buf_clients-attr.obj-type = alc-producers.obj-type
     4050                                                 and buf_clients-attr.attr-code = 'cli-alc-producer':U no-error.
     4051           if not available (buf_clients-attr) then delete alc-producers.
     4052       end.
     4053   end.
     4054   if TOGGLE-Excel = no and TOGGLE-XML = no then do:
     4055       message "Выберите формат вывода" view-as alert-box warning buttons ok.
     4056       return.
     4057   end.
     4058   case RADIO-ALC-TYPE:
     4059       when 1 then do:
     4060           for each alc-types exclusive-lock:
     4061               delete alc-types.
     4062           end.
     4063           for each buf_alc-type exclusive-lock:
     4064               find first buf_alc-type-attr where buf_alc-type-attr.attr-code = "alc-type"
     4065                                        and buf_alc-type-attr.attr-value = "2"
     4066                                        and buf_alc-type-attr.alc-type-inner-code = buf_alc-type.alc-type-inner-code no-error .
     4067               if not available buf_alc-type-attr then do:
     4068               create alc-types.
     4069               assign
     4070               alc-types.type-code     = buf_alc-type.alc-type-inner-code
     4071               alc-types.alc-type-name = buf_alc-type.alc-type-name
     4072               alc-types.alc-type-code = buf_alc-type.alc-type-code.
     4073               end.
     4074           end.
     4075       end.
     4076   end case.
     4077   case x-SelectGood:
     4078       when 1 then do:
     4079           for each alc-goods exclusive-lock:
     4080               delete alc-goods.
     4081           end.
     4082         for each alc-types no-lock:
     4083           for each buf_alc-type-gds no-lock
     4084                                     where buf_alc-type-gds.alc-type-inner-code = alc-types.type-code:
     4085               for first buf_goods no-lock where buf_goods.gds-code = buf_alc-type-gds.gds-code
     4086                                           and buf_goods.stts = 0:
     4087                   if RADIO-ALC-PRODUCER = 2 and
     4088                   not can-find(first alc-producers where alc-producers.obj-type = buf_goods.prod-type
     4089                                                      and alc-producers.obj-code = buf_goods.prod-code)
     4090                   then next.
     4091                   create alc-goods.
     4092                   assign
     4093                   alc-goods.gds-code  = buf_alc-type-gds.gds-code
     4094                   alc-goods.type-code = buf_alc-type-gds.alc-type-inner-code
     4095                   alc-goods.artic     = buf_goods.artic
     4096                   alc-goods.prod-type = buf_goods.prod-type
     4097                   alc-goods.prod-code = buf_goods.prod-code
     4098                   alc-goods.alpha1    = buf_goods.alpha1
     4099                   alc-goods.vol       = buf_goods.ms-base.
     4100               end.
     4101           end.
     4102         end.
     4103       end.
     4104   end case.
     4105   for first buf_clients no-lock where buf_clients.obj-code = v-cntxt-host-code-obj
     4106                                 and   buf_clients.obj-type = 'орг':U:
     4107       run fmtcli-get-client in this-procedure ( input buf_clients.obj-type, input  buf_clients.obj-code ).
     4108   end.
     4109   for first buf_clients-attr no-lock where buf_clients-attr.obj-type = 'орг':U
     4110                                      and   buf_clients-attr.obj-code = v-cntxt-host-code-obj
     4111                                      and   buf_clients-attr.attr-code = 'requisite-alc-decl':U:
     4112       assign
     4113           v-fmtcli-name         = entry( 1, buf_clients-attr.attr-value, "|")
     4114           firm-country-code     = entry( 3, buf_clients-attr.attr-value, "|")
     4115           firm-post-code        = entry( 4, buf_clients-attr.attr-value, "|")
     4116           firm-reg-code         = entry( 5, buf_clients-attr.attr-value, "|")
     4117           firm-district         = entry( 6, buf_clients-attr.attr-value, "|")
     4118           firm-city             = entry( 7, buf_clients-attr.attr-value, "|")
     4119           firm-settlement       = entry( 8, buf_clients-attr.attr-value, "|")
     4120           firm-street           = entry( 9, buf_clients-attr.attr-value, "|")
     4121           firm-house-number     = entry (10,buf_clients-attr.attr-value, "|")
