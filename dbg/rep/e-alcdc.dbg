     3207   define stream OutStr-html.
     3208   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3209   define  stream PrnLibStream.
     3210   procedure prn-lib-prn-file :
     3211     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     3212     define input parameter p-DIsabledoptions as integer no-undo .
     3213     define variable v-report-name as character no-undo .
     3214     define variable v-user-action as character no-undo .
     3215     define variable v-printed     as logical   no-undo .
     3216     define variable v-exist       as logical   no-undo .
     3217     do
     3218       on error undo, return error
     3219       :
     3220       run prn-lib-get-report-name  in this-procedure (
     3221         input parParentProc
     3222         ,output v-report-name
     3223         ).
     3224   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3225   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     3226     (input  v-report-name
     3227     ,input  2
     3228     ,output v-exist
     3229     )  .
     3230       if NOT v-exist then
     3231       DO:
     3232         Message
     3233           "Нет заданий на печать ! "
     3234           view-as alert-box .
     3235         Return  .
     3236       End.
     3237       run gbl/prnfilen.w
     3238         (input  ""
     3239         ,input  p-DisabledOptions
     3240         ,input  string(v-report-name )
     3241         ,input  7
     3242         ,output v-user-action
     3243         ,output v-printed
     3244         ) .
     3245       if v-printed then
     3246       do:
     3247         return "YES" .
     3248       end.
     3249       else
     3250       do:
     3251         return "NO" .
     3252       end.
     3253     end.
     3254   end procedure.
     3255   procedure prn-lib-open-stream :
     3256     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     3257     define input parameter p-page-size    as integer no-undo .
     3258     define input parameter p-is-stream    as logical no-undo .
     3259     define input parameter p-append       as logical no-undo .
     3260     define variable v-report-name as character no-undo .
     3261     do
     3262       on error undo, return error
     3263       :
     3264       run prn-lib-get-report-name  in this-procedure (
     3265         input parParentProc
     3266         ,output v-report-name
     3267         ).
     3268       if p-is-stream then
     3269       do:
     3270         if p-append then
     3271         do:
     3272           output stream PrnLibStream to value( v-report-name )
     3273             page-size value(p-page-size) append .
     3274         end.
     3275         if not p-append then
     3276         do:
     3277           output stream PrnLibStream to value( v-report-name )
     3278             page-size value(p-page-size) .
     3279         end.
     3280       end.
     3281       if not p-is-stream then
     3282       do:
     3283         if p-append then
     3284         do:
     3285           output to value( v-report-name )
     3286             page-size value(p-page-size) append .
     3287         end.
     3288         if not p-append then
     3289         do:
     3290           output to value( v-report-name )
     3291             page-size value(p-page-size) .
     3292         end.
     3293       end.
     3294     end.
     3295   end procedure.
     3296   procedure prn-lib-open-exp :
     3297     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     3298     define input parameter p-is-stream    as logical no-undo .
     3299     define input parameter p-is-append    as logical no-undo .
     3300     define output parameter p-ReportFileName as char init "report" no-undo.
     3301     define output parameter p-process as logical no-undo .
     3302     define variable glog as logical no-undo .
     3303     do
     3304       on error undo, return error
     3305       :
     3306       SYSTEM-DIALOG GET-FILE p-ReportFileName
     3307         TITLE      "Укажите путь"
     3308         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     3309         ASK-OVERWRITE
     3310         CREATE-TEST-FILE
     3311         SAVE-AS
     3312         USE-FILENAME
     3313         DEFAULT-EXTENSION "txt"
     3314         UPDATE glog
     3315         .
     3316       if not glog then  return.
     3317       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     3318       if p-is-stream then
     3319       do:
     3320         if p-is-append then
     3321         do:
     3322           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     3323         end.
     3324         else
     3325         do:
     3326           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     3327         end.
     3328       end.
     3329       else
     3330       do:
     3331         if p-is-append then
     3332         do:
     3333           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     3334         end.
     3335         else
     3336         do:
     3337           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     3338         end.
     3339       end.
     3340       p-process = yes.
     3341     end.
     3342   end procedure.
     3343   procedure prn-lib-get-report-name :
     3344     define input parameter parParentProc  as widget-handle no-undo.
     3345     define output parameter p-report-name as character no-undo .
     3346     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     3347   end procedure.
     3348   procedure prn-lib-reportviewer-report-name :
     3349     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     3350     define input parameter p-report-name-html as character no-undo .
     3351     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
     3352   end procedure.
     3353   procedure prn-lib-reportviewer :
     3354     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     3355     define input parameter p-report-name-html as character no-undo .
     3356     define input parameter p-param        as character no-undo .
     3357     define variable v-excel           as character no-undo init 'TRUE' .
     3358     define variable v-value-character as character no-undo .
     3359     define variable v-value-integer   as character no-undo .
     3360     define variable v-value-date      as date      no-undo .
     3361     define variable v-value-decimal   as decimal   no-undo .
     3362     define variable rep-excel         as logical   no-undo .
     3363     define variable excel-string      as character no-undo .
     3364     define variable v-param-type      as character no-undo .
     3365     define variable v-tth             as handle    no-undo .
     3366     run adm/shattri.p (
     3367       input "get":U
     3368       ,input  ""
     3369       ,input  0
     3370       ,input  'report-glob':U
     3371       ,input  'rep-excel':U
     3372       ,output v-value-character
     3373       ,output v-value-date
     3374       ,output v-value-decimal
     3375       ,output v-value-integer
     3376       ,output rep-excel
     3377       ,output v-param-type
     3378       ,INPUT-OUTPUT table-handle v-tth
     3379       )  .
     3380     if rep-excel then v-excel = "TRUE" .
     3381     else v-excel = "FALSE" .
     3382     if p-param eq ""
     3383     then
     3384        p-param = "EXCEL:" + v-excel.
     3385     else
     3386        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     3387     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     3388   end procedure.
