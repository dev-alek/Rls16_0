     4481                                                                          ,input alc-goods.prod-type
     4482                                                                          ,input alc-goods.prod-code
     4483                                                                          ,input fact-order-start
     4484                                                                          ,input true).
     4485          end.
     4486          for each temp-parts no-lock where temp-parts.fact-qnty <> 0:
     4487             if RADIO-SUPPLIER = 2 and
     4488             not can-find(first alc-suppliers where alc-suppliers.obj-type = temp-parts.supp-type
     4489                                                and alc-suppliers.obj-code = temp-parts.supp-code)
     4490             then next.
     4491             v-inner-code = ? .
     4492             if num-entries(temp-parts.alc-ref-ab-path) = 4 and entry(4, temp-parts.alc-ref-ab-path) <> "" then do :
     4493               find first alc-types no-lock where trim(alc-types.alc-type-code) = trim(entry(4, temp-parts.alc-ref-ab-path)) no-error .
     4494               if available alc-types then v-inner-code = alc-types.type-code .
     4495               else next .
     4496             end.
     4497             if v-inner-code = ? then v-inner-code = alc-goods.type-code .
     4498              find first tt-parts-info exclusive-lock where tt-parts-info.obj-type         = obj-list.obj-type
     4499                                                        and tt-parts-info.obj-code         = obj-list.obj-code
     4500                                                        and tt-parts-info.artic            = alc-goods.artic
     4501                                                        and tt-parts-info.prod-type        = alc-goods.prod-type
     4502                                                        and tt-parts-info.prod-code        = alc-goods.prod-code
     4503                                                        and tt-parts-info.in-code          = temp-parts.in-code
     4504                                                        and tt-parts-info.out-code         = temp-parts.out-code
     4505                                                        and tt-parts-info.part-code        = temp-parts.part-code no-error .
     4506              if not available tt-parts-info then do :
     4507                  create tt-parts-info .
     4508                  assign
     4509                   tt-parts-info.obj-type         = obj-list.obj-type
     4510                   tt-parts-info.obj-code         = obj-list.obj-code
     4511                   tt-parts-info.artic            = alc-goods.artic
     4512                   tt-parts-info.prod-type        = alc-goods.prod-type
     4513                   tt-parts-info.prod-code        = alc-goods.prod-code
     4514                   tt-parts-info.in-code          = temp-parts.in-code
     4515                   tt-parts-info.out-code         = temp-parts.out-code
     4516                   tt-parts-info.part-code        = temp-parts.part-code
     4517                  .
     4518              end.
     4519               v-kpp = "" .
     4520               for first buf_clients-attr no-lock where buf_clients-attr.obj-code  = obj-list.obj-code
     4521                                                  and   buf_clients-attr.obj-type  = obj-list.obj-type
     4522                                                  and   buf_clients-attr.attr-code = 'kpp':U:
     4523                   v-kpp = buf_clients-attr.attr-value.
     4524               end.
     4525               if v-kpp = "" then  v-kpp = v-fmtcli-kpp.
     4526               ext-FormF1:Release_() .
     4527               if num-entries(temp-parts.alc-ref-ab-path) = 4 and entry(1, temp-parts.alc-ref-ab-path) <> "" then do :
     4528                   ext-FormF1:OpenQueryExtFormF1(entry(1, temp-parts.alc-ref-ab-path)) .
     4529               end.
     4530               ext-cl:Release_() .
     4531               if num-entries(temp-parts.alc-ref-ab-path) = 4 and entry(3, temp-parts.alc-ref-ab-path) <> "" then do :
     4532                   ext-cl:OpenQueryExtGds(alc-goods.gds-code, entry(3, temp-parts.alc-ref-ab-path)) .
     4533                   tt-parts-info.alc-code =  entry(3, temp-parts.alc-ref-ab-path) .
     4534               end.
     4535               if temp-parts.alc-imp-code <> 0 then assign
     4536                       imp-or-prod-type = temp-parts.alc-imp-type
     4537                       imp-or-prod-code = temp-parts.alc-imp-code
     4538                       tt-parts-info.importer = 'Импортер из алк.атр. партии' .
     4539               else
     4540               if ext-FormF1:NumBundles > 0
     4541               and ext-FormF1:GetExtFormF1Value():CliRegIdOrigCli <> ""
     4542               and ext-FormF1:GetExtFormF1Value():CliRegIdOrigCli <> ?
     4543               then do :
     4544                   imp-or-prod-type = ext-FormF1:GetExtFormF1Value():CliRegIdOrigCli .
     4545                   imp-or-prod-code = 0 .
     4546                   tt-parts-info.importer = 'ЕГАИС. Оригинальный клиент из Справки А (Справки 1)' .
     4547               end.
     4548               else
     4549               if ext-cl:NumBundles > 0
     4550               and ext-cl:GetExtGdsValue(1):CliRegIdProd <> ""
     4551               and ext-cl:GetExtGdsValue(1):CliRegIdProd <> ?
     4552               then do :
     4553                   if ext-cl:GetExtGdsValue(1):CliRegIdImpor <> ""
     4554                   and ext-cl:GetExtGdsValue(1):CliRegIdImpor <> ?
