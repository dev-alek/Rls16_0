     4169                                          and   buf_clients-attr.obj-type  = obj-list.obj-type
     4170                                          and   buf_clients-attr.attr-code = 'requisite-alc-decl':U:
     4171           assign
     4172           page-2.obj-name     = entry( 1, buf_clients-attr.attr-value, "|")
     4173           page-2.country-code = entry( 3, buf_clients-attr.attr-value, "|")
     4174           page-2.post-code    = entry( 4, buf_clients-attr.attr-value, "|")
     4175           page-2.reg-code     = entry( 5, buf_clients-attr.attr-value, "|")
     4176           page-2.district     = entry( 6, buf_clients-attr.attr-value, "|")
     4177           page-2.city         = entry( 7, buf_clients-attr.attr-value, "|")
     4178           page-2.settlement   = entry( 8, buf_clients-attr.attr-value, "|")
     4179           page-2.street       = entry( 9, buf_clients-attr.attr-value, "|")
     4180           page-2.house-number = entry( 10,buf_clients-attr.attr-value, "|")
     4181           page-2.house-case   = entry (11,buf_clients-attr.attr-value, "|")
     4182           page-2.apartment    = entry (12,buf_clients-attr.attr-value, "|")
     4183           page-2.house-litera = entry (13,buf_clients-attr.attr-value, "|") no-error.
     4184       end.
     4185       release page-2 .
