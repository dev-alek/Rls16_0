     4575                   assign
     4576                       imp-or-prod-type = ext-cl:GetExtGdsValue(1):CliRegIdProd
     4577                       imp-or-prod-code = 0
     4578                       tt-parts-info.importer = 'ЕГАИС. Производитель'
     4579                   .
