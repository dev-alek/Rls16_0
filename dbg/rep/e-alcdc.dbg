      622     define variable v-cntxt-level         as character no-undo .
      623     define variable v-cntxt-host-code-obj as integer   no-undo .
      624     define variable v-cntxt-obj-type      as character no-undo .
      625     define variable v-cntxt-obj-code      as integer   no-undo .
      626     define variable v-cntxt-db-num-obj    as integer   no-undo .
      627     define variable v-cntxt-is-admin      as logical   no-undo .
      628   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      629     run mainmenu_getcntxt in my-handle
      630       (output v-cntxt-db-num
      631       ,output v-cntxt-userid
      632       ,output v-cntxt-level
      633       ,output v-cntxt-host-code-obj
      634       ,output v-cntxt-obj-type
      635       ,output v-cntxt-obj-code
      636       ,output v-cntxt-db-num-obj
      637       ,output v-cntxt-is-admin
      638       ) .
      639   define variable base-type as character no-undo .
      640   define variable base-code as integer   no-undo .
      641   define variable g#report-num as integer   no-undo .
      642   define variable g#gds-engl as logical   no-undo .
      643   define variable vv-exch-rate  as decimal   no-undo .
      644   define variable vv-exch-scale as decimal   no-undo .
      645   define variable v-cntxt-host-name-obj as character no-undo .
      646   if v-cntxt-level = 'object':U then do:
      647   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      648   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostname in g#library
      649     (input  v-cntxt-obj-type
