     4757                                                                and tt-parts-info.obj-code         = obj-list.obj-code
     4758                                                                and tt-parts-info.artic            = alc-goods.artic
     4759                                                                and tt-parts-info.prod-type        = alc-goods.prod-type
     4760                                                                and tt-parts-info.prod-code        = alc-goods.prod-code
