     4739                for each buf_parts no-lock where   buf_parts.prod-type = alc-goods.prod-type
     4740                                             and   buf_parts.prod-code = alc-goods.prod-code
     4741                                             and   buf_parts.artic     = alc-goods.artic
     4742                                             and   buf_parts.out-code  = buf_doc-line.doc-code:
     4743                       if buf_parts.fact-qnty = 0
     4744                       then next .
