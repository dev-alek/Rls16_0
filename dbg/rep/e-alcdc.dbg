     4226                                                        and tt-parts-info.obj-code         = obj-list.obj-code
     4227                                                        and tt-parts-info.artic            = alc-goods.artic
     4228                                                        and tt-parts-info.prod-type        = alc-goods.prod-type
     4229                                                        and tt-parts-info.prod-code        = alc-goods.prod-code
     4230                                                        and tt-parts-info.in-code          = temp-parts.in-code
     4231                                                        and tt-parts-info.out-code         = temp-parts.out-code
     4232                                                        and tt-parts-info.part-code        = temp-parts.part-code no-error .
     4233              if not available tt-parts-info then do :
