     5691       accumulate part-1.remain-21 (total by part-1.alc-type-code).
     5692       if last-of (part-1.alc-type-code) then do:
     5693         hSAXWriter:start-element ("row").
     5694           nn = nn + 1.
     5695           hSAXWriter:write-data-element("n", string(nn)).
     5696           hSAXWriter:write-data-element("c01" ,part-1.alc-type-name).
     5697           hSAXWriter:write-data-element("c02" ,part-1.alc-type-code).
     5698           hSAXWriter:write-data-element("c03" ,"").
     5699           hSAXWriter:write-data-element("c04" ,"").
     5700           hSAXWriter:write-data-element("c05" ,"").
