     2769   procedure thbjattr_code_reg :
     2770   define input  parameter p-upper-code     as character no-undo .
     2771   define input  parameter p-code           as character no-undo .
     2772   define output parameter p-label          as character no-undo .
     2773   define output parameter p-user-can-edit  as logical   no-undo .
     2774   define output parameter p-output-display as logical   no-undo .
     2775   define output parameter p-other          as character no-undo .
     2776   define output parameter p-prop-list      as character no-undo .
     2777   define output parameter p-prop-type-list as character no-undo .
     2778   define output parameter p-prop-label-list as character no-undo .
     2779   define output parameter p-global          as logical no-undo .
     2780   define output parameter p-host           as logical no-undo .
     2781   define output parameter p-shop           as logical no-undo .
     2782   define output parameter p-store          as logical no-undo .
     2783   define output parameter p-db             as logical no-undo .
     2784   define output parameter p-region         as logical no-undo .
     2785   do
