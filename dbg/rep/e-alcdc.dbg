     4602                 part-1.type-code = v-inner-code
     4603                 part-1.prod-code = imp-or-prod-code
     4604                 part-1.prod-type = imp-or-prod-type
     4605                 part-1.obj-code  = obj-list.obj-code
     4606                 part-1.obj-type  = obj-list.obj-type
     4607                 part-1.obj-kpp   = v-kpp .
