     4310                       imp-or-prod-code = temp-parts.prod-code
     4311                       tt-parts-info.importer = 'Производитель из карточки товара' .
     4312             release part-1 no-error.
     4313             if TOGGLE-KPP then do :
     4314                 find first part-1 where part-1.type-code = v-inner-code
     4315                                   and   part-1.prod-code = imp-or-prod-code
     4316                                   and   part-1.prod-type = imp-or-prod-type
     4317                                   and   part-1.obj-kpp   = v-kpp no-error.
     4318             end.
     4319             else do :
     4320                 find first part-1 where part-1.type-code = v-inner-code
     4321                                   and   part-1.prod-code = imp-or-prod-code
     4322                                   and   part-1.prod-type = imp-or-prod-type
     4323                                   and   part-1.obj-code  = obj-list.obj-code
     4324                                   and   part-1.obj-type  = obj-list.obj-type no-error.
     4325             end.
     4326             if not available (part-1) then do:
     4327                 create part-1.
     4328                 assign
     4329                 part-1.type-code = v-inner-code
     4330                 part-1.prod-code = imp-or-prod-code
     4331                 part-1.prod-type = imp-or-prod-type
     4332                 part-1.obj-code  = obj-list.obj-code
     4333                 part-1.obj-type  = obj-list.obj-type
     4334                 part-1.obj-kpp   = v-kpp .
     4335             for first buf_clients-attr no-lock where buf_clients-attr.obj-type  = temp-parts.prod-type
     4336                                                and   buf_clients-attr.obj-code  = temp-parts.prod-code
     4337                                                and   buf_clients-attr.attr-code = 'foreign-producer':U
     4338                                                and   buf_clients-attr.attr-value = "yes":
     4339                 part-1.foreign = yes.
     4340             end.
     4341             if num-entries(temp-parts.alc-ref-ab-path) = 4 and entry(4, temp-parts.alc-ref-ab-path) <> "" then do :
     4342                 part-1.alc-type-code = trim(entry(4, temp-parts.alc-ref-ab-path)) .
     4343                 for first alc-types no-lock where trim(alc-types.alc-type-code) = trim(entry(4, temp-parts.alc-ref-ab-path)) :
     4344                     part-1.alc-type-name = alc-types.alc-type-name .
     4345                 end.
     4346             end.
     4347             else
     4348             for first alc-types no-lock where alc-types.type-code = alc-goods.type-code:
     4349                 assign
     4350                 part-1.alc-type-code = alc-types.alc-type-code
     4351                 part-1.alc-type-name = alc-types.alc-type-name.
     4352             end.
     4353             case imp-or-prod-type:
     4354                 when 'орг':U then do:
     4355                     find first buf_firm no-lock where buf_firm.firm-code = imp-or-prod-code.
     4356                     find first buf_clients no-lock where buf_clients.obj-code = imp-or-prod-code
     4357                                                    and   buf_clients.obj-type = imp-or-prod-type.
     4358                     assign
     4359                     part-1.producer-obj-name = buf_clients.obj-name
     4360                     part-1.producer-inn = buf_firm.inn
     4361                     part-1.producer-kpp = buf_firm.kpp.
     4362                 end.
     4363                 when 'маг':U or when 'скл':U then do:
     4364                 find first buf_clients no-lock where buf_clients.obj-code = imp-or-prod-code
     4365                                                and   buf_clients.obj-type = imp-or-prod-type.
     4366                 find first buf_firm no-lock where buf_firm.firm-code = buf_clients.host-code.
     4367                 release buf_clients-attr.
     4368                 find first buf_clients-attr no-lock where buf_clients-attr.obj-code  = imp-or-prod-code
     4369                                                     and   buf_clients-attr.obj-type  = imp-or-prod-type
     4370                                                     and   buf_clients-attr.attr-code = 'kpp':U no-error.
     4371                 if available buf_clients-attr then do:
     4372                 assign
     4373                     part-1.producer-obj-name = buf_clients.obj-name
     4374                     part-1.producer-inn = buf_firm.inn
     4375                     part-1.producer-kpp = (if buf_clients-attr.attr-value <> ""
     4376                                           and buf_clients-attr.attr-value <> ?
     4377                                           then buf_clients-attr.attr-value else buf_firm.kpp).
     4378                 end.
     4379                 end.
     4380                 when 'чел':U then do:
     4381                     find first buf_person no-lock where buf_person.psn-code = imp-or-prod-code.
     4382                     find first buf_clients no-lock where buf_clients.obj-code = imp-or-prod-code
     4383                                                    and   buf_clients.obj-type = imp-or-prod-type.
     4384                     assign
     4385                     part-1.producer-obj-name = buf_clients.obj-name
     4386                     part-1.producer-inn = buf_person.inn
     4387                     part-1.producer-kpp = buf_person.kpp.
     4388                 end.
