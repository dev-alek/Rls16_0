     4410                               part-1.producer-inn = ext-cl:GetExtGdsValue(1):INNProd
     4411                               part-1.producer-kpp = ext-cl:GetExtGdsValue(1):KPPProd
     4412                           .
     4413                           else
     4414                           assign
     4415                               part-1.producer-obj-name = ext-cl:GetExtGdsValue(1):FullNameImpor
     4416                               part-1.producer-inn = ext-cl:GetExtGdsValue(1):INNImpor
     4417                               part-1.producer-kpp = ext-cl:GetExtGdsValue(1):KPPImpor
     4418                           .
