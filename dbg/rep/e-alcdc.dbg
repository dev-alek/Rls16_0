     5905           hSAXWriter:write-data-element("c16", string(part-2.total)).
     5906       hSAXWriter:end-element ("row").
     5907       if last-of (part-2.obj-code) then do:
     5908           hSAXWriter:start-element ("row").
     5909               nn = nn + 1.
     5910               hSAXWriter:write-data-element ("n", string(nn)).
     5911               hSAXWriter:write-data-element("c01", "ИТОГО").
     5912               hSAXWriter:write-data-element("c02", "").
     5913               hSAXWriter:write-data-element("c03", "").
     5914               hSAXWriter:write-data-element("c04", "").
     5915               hSAXWriter:write-data-element("c05", "").
     5916               hSAXWriter:write-data-element("c06", "").
     5917               hSAXWriter:write-data-element("c07", "").
     5918               hSAXWriter:write-data-element("c08", "").
     5919               hSAXWriter:write-data-element("c09", "").
     5920               hSAXWriter:write-data-element("c10", "").
     5921               hSAXWriter:write-data-element("c11", "").
     5922               hSAXWriter:write-data-element("c12", "").
     5923               hSAXWriter:write-data-element("c13", "").
     5924               hSAXWriter:write-data-element("c14", "").
     5925               hSAXWriter:write-data-element("c15", "").
     5926               hSAXWriter:write-data-element("c16", string(accum total by part-2.obj-code part-2.total)).
     5927           hSAXWriter:end-element ("row").
     5928          hSAXWriter:end-element ("object").
     5929       end.
     5930   end.
     5931   hSAXWriter:end-element ("part-2").
     5932   hSAXWriter:end-element ("report").
     5933   hSAXWriter:end-document().
     5934   delete object hSAXWriter no-error.
     5935   xslt = search("exe\alcdc-pril11.xsl").
     5936   Report-out = new Rep-Out().
     5937   Report-out:office(xml_tmp, xslt).
     5938   delete object Report-out.
     5939   end procedure.
     5940   PROCEDURE xml-output :
     5941   define variable hSAXWriter as handle no-undo.
     5942   define variable xml        as character no-undo.
     5943   define variable ii-ob   as integer no-undo.
     5944   define variable ii-impr as integer no-undo.
     5945   define variable ii-pos  as integer no-undo.
     5946   define variable ii-dv   as integer no-undo.
     5947   define variable MyUUID as raw       no-undo.
     5948   define variable vGUID  as character no-undo.
     5949   assign
     5950     MyUUID = generate-uuid
     5951     vGUID  = guid(MyUUID).
     5952     ii = 0.
     5953   for each part-2 no-lock break by part-2.supplier-serial-number:
     5954       if last-of(part-2.supplier-serial-number) then do:
     5955           create alc-supp-licenses.
     5956           ii = ii + 1.
     5957           assign
     5958           alc-supp-licenses.id = ii
     5959           alc-supp-licenses.supplier-code = part-2.supplier-code
     5960           alc-supp-licenses.supplier-type = part-2.supplier-type
     5961           alc-supp-licenses.serial-number = part-2.supplier-serial-number
     5962           alc-supp-licenses.date-get      = part-2.supplier-date-get
     5963           alc-supp-licenses.date-to       = part-2.supplier-date-to
     5964           alc-supp-licenses.get-from      = part-2.supplier-get-from.
     5965       end.
     5966   end.
     5967   xml = session:temp-directory + "R1_" + v-fmtcli-inn + "_" + string(quarter, "99") + substring(string(year(today)), 4, 1) + "_" +
     5968         string(day(today), "99") + string(month(today), "99") + string(year(today), "9999") + "_" + vGUID + ".xml".
     5969   create sax-writer hSAXWriter.
     5970   hSAXWriter:formatted = true.
     5971   hSAXWriter:encoding = "windows-1251":U.
     5972   hSAXWriter:set-output-destination("file":U, xml).
     5973   hSAXWriter:start-document().
     5974   hSAXWriter:start-element ("Файл").
     5975       hSAXWriter:insert-attribute ("ДатаДок", string(day(today), "99") + "." + string(month(today), "99")  + "." + string(year(today), "9999")).
     5976       case RADIO-SET-ver:
     5977           when 3 then hSAXWriter:insert-attribute ("ВерсФорм", "4.30").
     5978           when 1 then hSAXWriter:insert-attribute ("ВерсФорм", "4.31").
     5979           when 2 then hSAXWriter:insert-attribute ("ВерсФорм", "4.20").
     5980       end case.
     5981       hSAXWriter:insert-attribute ("НаимПрог", "Trade House").
     5982       hSAXWriter:start-element ("ФормаОтч").
     5983           case RADIO-SET-ver:
     5984               when 1 then do:
     5985                   hSAXWriter:insert-attribute ("НомФорм", "11").
     5986                   hSAXWriter:insert-attribute ("ПризПериодОтч", string(quarter)).
     5987                   hSAXWriter:insert-attribute ("ГодПериодОтч", string(year(x-date-start))).
     5988               end.
     5989               when 3 then do:
     5990                   hSAXWriter:insert-attribute ("НомФорм", "11").
     5991                   hSAXWriter:insert-attribute ("ПризПериодОтч", string(quarter)).
     5992                   hSAXWriter:insert-attribute ("ГодПериодОтч", string(year(x-date-start))).
     5993               end.
     5994               when 2 then do:
     5995                   hSAXWriter:insert-attribute ("ГодПериодОтч", string(year(x-date-start))).
     5996                   hSAXWriter:insert-attribute ("НомФорм", "11-о").
     5997                   hSAXWriter:insert-attribute ("ПризПериодОтч", string(quarter)).
     5998                   hSAXWriter:insert-attribute ("ПризФОтч", "4").
     5999               end.
     6000           end case.
     6001           case RADIO-SET-form:
     6002               when 1 then do:
     6003                   hSAXWriter:write-empty-element("Первичная").
     6004               end.
     6005               when 2 then do:
     6006                   hSAXWriter:write-empty-element("Корректирующая").
     6007                       hSAXWriter:insert-attribute ("НомерКорр", string(FILL-IN-kor)).
     6008               end.
     6009           end case.
     6010       hSAXWriter:end-element ("ФормаОтч").
     6011       hSAXWriter:start-element ("Справочники").
     6012           ii = 0.
     6013           for each part-1 no-lock break by part-1.prod-type by part-1.prod-code:
     6014               if last-of(part-1.prod-code) then do:
     6015               ii = ii + 1.
     6016               hSAXWriter:write-empty-element ("ПроизводителиИмпортеры").
     6017                   hSAXWriter:insert-attribute ("ИДПроизвИмп", if part-1.prod-type = 'чел':U then string(part-1.prod-code + 1000) else string(part-1.prod-code)).
     6018                   hSAXWriter:insert-attribute ("П000000000004", part-1.producer-obj-name).
     6019                   hSAXWriter:insert-attribute ("П000000000005", part-1.producer-inn).
     6020                   hSAXWriter:insert-attribute ("П000000000006", part-1.producer-kpp).
     6021               end.
     6022           end.
     6023           for each part-2 no-lock break by part-2.supplier-type by part-2.supplier-code:
     6024               if first-of(part-2.supplier-code) then do:
     6025                   ii = ii + 1.
     6026                   hSAXWriter:start-element ("Поставщики").
     6027                       hSAXWriter:insert-attribute ("ИдПостав", if part-2.supplier-type = 'чел':U then string(part-2.supplier-code + 1000) else string(part-2.supplier-code)).
     6028                       hSAXWriter:insert-attribute ("П000000000007", part-2.supplier-obj-name).
     6029                       hSAXWriter:start-element ("Лицензии").
     6030                           for each alc-supp-licenses no-lock where alc-supp-licenses.supplier-code = part-2.supplier-code
     6031                                                              and   alc-supp-licenses.supplier-type = part-2.supplier-type :
     6032                               hSAXWriter:write-empty-element ("Лицензия").
     6033                                   ii = ii + 1.
     6034                                   hSAXWriter:insert-attribute ("ИдЛицензии", string(alc-supp-licenses.id)).
     6035                                   hSAXWriter:insert-attribute ("П000000000011", right-trim(alc-supp-licenses.serial-number)).
     6036                                   hSAXWriter:insert-attribute ("П000000000012", alc-supp-licenses.date-get).
     6037                                   hSAXWriter:insert-attribute ("П000000000013", alc-supp-licenses.date-to).
     6038                                   hSAXWriter:insert-attribute ("П000000000014", alc-supp-licenses.get-from).
     6039                       end.
     6040                       hSAXWriter:end-element ("Лицензии").
     6041                           hSAXWriter:write-empty-element ("ЮЛ").
     6042                               hSAXWriter:insert-attribute ("П000000000009", part-2.supplier-inn).
     6043                               hSAXWriter:insert-attribute ("П000000000010", part-2.supplier-kpp).
     6044                   hSAXWriter:end-element ("Поставщики").
     6045               end.
     6046           end.
     6047       hSAXWriter:end-element ("Справочники").
     6048       hSAXWriter:start-element ("Документ").
     6049           hSAXWriter:start-element ("Организация").
     6050               hSAXWriter:start-element ("Реквизиты").
     6051   case RADIO-SET-form:
     6052               when 1 then do:
     6053                   hSAXWriter:insert-attribute ("Наим", v-fmtcli-name).
     6054               end.
     6055               when 2 then do:
     6056                   hSAXWriter:insert-attribute ("НаимЮЛ", v-fmtcli-name).
     6057                   hSAXWriter:insert-attribute ("ИННЮЛ", v-fmtcli-inn).
     6058                   hSAXWriter:insert-attribute ("КППЮЛ", v-fmtcli-kpp).
     6059               end.
     6060               when 3 then do:
     6061                   hSAXWriter:insert-attribute ("НаимЮЛ", v-fmtcli-name).
     6062                   hSAXWriter:insert-attribute ("ИННЮЛ", v-fmtcli-inn).
     6063                   hSAXWriter:insert-attribute ("КППЮЛ", v-fmtcli-kpp).
     6064               end.
     6065   end case.
     6066                   hSAXWriter:insert-attribute ("ТелОрг", v-fmtcli-phone).
     6067                   hSAXWriter:insert-attribute ("EmailОтпр", firm-e-mail).
     6068                   hSAXWriter:start-element ("АдрОрг").
     6069                       hSAXWriter:write-data-element ("КодСтраны", firm-country-code).
     6070                       hSAXWriter:write-data-element ("Индекс", firm-post-code).
     6071                       hSAXWriter:write-data-element ("КодРегион", string(integer(firm-reg-code), "99")).
     6072                       hSAXWriter:write-data-element ("Район", firm-district).
     6073                       hSAXWriter:write-data-element ("Город", firm-city).
     6074                       hSAXWriter:write-data-element ("НаселПункт", firm-settlement).
     6075                       hSAXWriter:write-data-element ("Улица", firm-street).
     6076                       hSAXWriter:write-data-element ("Дом", firm-house-number).
     6077                       hSAXWriter:write-data-element ("Корпус", firm-house-case).
     6078                       hSAXWriter:write-data-element ("Литера", firm-house-litera).
     6079                       hSAXWriter:write-data-element ("Кварт", firm-house-apartment).
     6080                   hSAXWriter:end-element ("АдрОрг").
     6081   case RADIO-SET-form:
     6082       when 1 then do:
     6083                   hSAXWriter:write-empty-element ("ЮЛ").
     6084                           hSAXWriter:insert-attribute ("ИННЮЛ", v-fmtcli-inn).
     6085                           hSAXWriter:insert-attribute ("КППЮЛ", v-fmtcli-kpp).
     6086       end.
     6087   end case.
     6088               hSAXWriter:end-element ("Реквизиты").
     6089               hSAXWriter:start-element ("ОтветЛицо").
     6090                   hSAXWriter:start-element ("Руководитель").
     6091                       hSAXWriter:write-data-element ("Фамилия", firm-director-f).
     6092                       hSAXWriter:write-data-element ("Имя", firm-director-i).
     6093                       hSAXWriter:write-data-element ("Отчество", firm-director-o).
     6094                   hSAXWriter:end-element ("Руководитель").
     6095                   hSAXWriter:start-element ("Главбух").
     6096                       hSAXWriter:write-data-element ("Фамилия", firm-accountant-f).
     6097                       hSAXWriter:write-data-element ("Имя", firm-accountant-i).
     6098                       hSAXWriter:write-data-element ("Отчество", firm-accountant-o).
     6099                   hSAXWriter:end-element ("Главбух").
     6100               hSAXWriter:end-element ("ОтветЛицо").
     6101               case RADIO-SET-ver:
     6102                   when 1 then do:
     6103                       hSAXWriter:start-element ("Деятельность").
     6104                           hSAXWriter:start-element ("Лицензируемая").
     6105                               for each alc-sale-licenses no-lock:
     6106                                   hSAXWriter:write-empty-element ("Лицензия").
     6107                                   hSAXWriter:insert-attribute ("ВидДеят", "06").
     6108                                   hSAXWriter:insert-attribute ("ДатаНачЛиц", alc-sale-licenses.date-from).
     6109                                   hSAXWriter:insert-attribute ("ДатаОконЛиц", alc-sale-licenses.date-to).
     6110                                   hSAXWriter:insert-attribute ("СерНомЛиц", alc-sale-licenses.seria + alc-sale-licenses.number).
     6111                               end.
     6112                           hSAXWriter:end-element ("Лицензируемая").
     6113                           if can-find(first part-1 where index(part-1.alc-type-code, '481,482,483,484,485') > 0)
     6114                               or can-find(first part-2 where index(part-2.alc-type-code, '481,482,483,484,485') > 0) then do:
     6115                               hSAXWriter:start-element ("Нелицензируемая").
     6116                                   hSAXWriter:insert-attribute ("ВидДеят", "12").
     6117                               hSAXWriter:end-element ("Нелицензируемая").
     6118                           end.
     6119                       hSAXWriter:end-element ("Деятельность").
     6120                   end.
     6121                   when 3 then do:
     6122                       hSAXWriter:start-element ("Деятельность").
     6123                           hSAXWriter:start-element ("Лицензируемая").
     6124                               for each alc-sale-licenses no-lock:
     6125                                   hSAXWriter:write-empty-element ("Лицензия").
     6126                                   hSAXWriter:insert-attribute ("ВидДеят", "06").
     6127                                   hSAXWriter:insert-attribute ("ДатаНачЛиц", alc-sale-licenses.date-from).
     6128                                   hSAXWriter:insert-attribute ("ДатаОконЛиц", alc-sale-licenses.date-to).
     6129                                   hSAXWriter:insert-attribute ("СерНомЛиц", alc-sale-licenses.seria + alc-sale-licenses.number).
     6130                               end.
     6131                           hSAXWriter:end-element ("Лицензируемая").
     6132                           if can-find(first part-1 where index(part-1.alc-type-code, '481,482,483,484,485') > 0)
     6133                               or can-find(first part-2 where index(part-2.alc-type-code, '481,482,483,484,485') > 0) then do:
     6134                               hSAXWriter:start-element ("Нелицензируемая").
     6135                                   hSAXWriter:insert-attribute ("ВидДеят", "12").
     6136                               hSAXWriter:end-element ("Нелицензируемая").
     6137                           end.
     6138                       hSAXWriter:end-element ("Деятельность").
     6139                   end.
     6140                   when 2 then do:
     6141                       hSAXWriter:start-element ("Лицензии").
     6142                           for each alc-sale-licenses no-lock:
     6143                               hSAXWriter:write-empty-element ("Лицензия").
     6144                               hSAXWriter:insert-attribute ("ВидДеят", "14").
     6145                               hSAXWriter:insert-attribute ("ДатаНачЛиц", alc-sale-licenses.date-from).
     6146                               hSAXWriter:insert-attribute ("ДатаОконЛиц", alc-sale-licenses.date-to).
     6147                               hSAXWriter:insert-attribute ("НомерЛиц", alc-sale-licenses.number).
     6148                               hSAXWriter:insert-attribute ("СерЛиц", alc-sale-licenses.seria).
     6149                           end.
     6150                       hSAXWriter:end-element ("Лицензии").
     6151                   end.
     6152               end.
     6153           hSAXWriter:end-element ("Организация").
     6154           for each page-2 no-lock:
     6155               hSAXWriter:start-element ("ОбъемОборота").
     6156                   hSAXWriter:insert-attribute ("КППЮЛ", page-2.kpp).
     6157                   case RADIO-SET-form:
     6158                               when 1 then do:
     6159                                   hSAXWriter:insert-attribute ("Наим", page-2.obj-name).
     6160                               end.
     6161                               when 2 then do:
     6162                                   hSAXWriter:insert-attribute ("НаимЮЛ", page-2.obj-name).
     6163                               end.
     6164                               when 3 then do:
     6165                                   hSAXWriter:insert-attribute ("НаимЮЛ", page-2.obj-name).
     6166                               end.
     6167                   end case.
     6168                   if can-find (first part-1 where part-1.obj-type = page-2.obj-type
     6169                                             and   part-1.obj-code = page-2.obj-code
     6170                                             and   (part-1.inc-14 <> 0 or part-1.exp-19 <> 0 ))
     6171                   then do:
     6172                       hSAXWriter:insert-attribute ("НаличиеОборота", "true").
     6173                   end.
     6174                   else do:
     6175                       hSAXWriter:insert-attribute ("НаличиеОборота", "false").
     6176                   end.
     6177                   hSAXWriter:start-element ("АдрОрг").
     6178                       hSAXWriter:write-data-element ("КодСтраны", page-2.country-code).
     6179                       hSAXWriter:write-data-element ("Индекс", page-2.post-code).
     6180                       hSAXWriter:write-data-element ("КодРегион", string(integer(page-2.reg-code), "99")).
     6181                       hSAXWriter:write-data-element ("Район", page-2.district).
     6182                       hSAXWriter:write-data-element ("Город", page-2.city).
     6183                       hSAXWriter:write-data-element ("НаселПункт", page-2.settlement).
     6184                       hSAXWriter:write-data-element ("Улица", page-2.street).
     6185                       hSAXWriter:write-data-element ("Дом", page-2.house-number).
     6186                       hSAXWriter:write-data-element ("Корпус", page-2.house-case).
     6187                       hSAXWriter:write-data-element ("Литера", page-2.house-litera).
     6188                       hSAXWriter:write-data-element ("Кварт", page-2.apartment).
     6189                   hSAXWriter:end-element ("АдрОрг").
     6190                   ii-ob = 0.
     6191                   for each part-1 no-lock where part-1.obj-code = page-2.obj-code
     6192                                           and   part-1.obj-type = page-2.obj-type
     6193                                           break by part-1.alc-type-code:
     6194                       if first-of(part-1.alc-type-code) then do:
     6195                           ii-impr = 0.
     6196                           ii-ob = ii-ob + 1.
     6197                           hSAXWriter:start-element ("Оборот").
     6198                               hSAXWriter:insert-attribute ("ПN", string(ii-ob)).
     6199                               hSAXWriter:insert-attribute ("П000000000003", part-1.alc-type-code).
     6200                       end.
     6201                       hSAXWriter:start-element ("СведПроизвИмпорт").
     6202                           ii-impr = ii-impr + 1.
     6203                           hSAXWriter:insert-attribute ("ПN", string(ii-impr)).
     6204                           hSAXWriter:insert-attribute ("ИдПроизвИмп", if part-1.prod-type = 'чел':U then string(part-1.prod-code + 1000) else string(part-1.prod-code)).
     6205                           ii-pos = 0.
     6206                           for each part-2 where part-2.alc-type-code = part-1.alc-type-code
     6207                                           and  (
     6208                                                 (part-2.prod-code = part-1.prod-code and part-2.prod-type = part-1.prod-type)
     6209                                              or (part-2.producer-inn = part-1.producer-inn and part-2.producer-kpp = part-1.producer-kpp)
     6210                                                   )
     6211                                           and   part-2.obj-code  = part-1.obj-code
     6212                                           and   part-2.obj-type  = part-1.obj-type
     6213                                           break by part-2.supplier-code:
     6214                               if first-of(part-2.supplier-code) then do:
     6215                                   ii-pos = ii-pos + 1.
     6216                                   hSAXWriter:start-element ("Поставщик").
     6217                                       find first alc-supp-licenses no-lock where alc-supp-licenses.serial-number = part-2.supplier-serial-number no-error.
     6218                                       hSAXWriter:insert-attribute ("ПN", string(ii-impr)).
     6219                                       hSAXWriter:insert-attribute ("ИдПоставщика", if part-2.supplier-type = 'чел':U then string(part-2.supplier-code + 1000) else string(part-2.supplier-code)).
     6220                                       hSAXWriter:insert-attribute ("ИдЛицензии", string(alc-supp-licenses.id)).
     6221                               end.
     6222                               hSAXWriter:write-empty-element ("Продукция").
     6223                                   hSAXWriter:insert-attribute ("П200000000013", string(part-2.purchase-date, "99.99.9999")).
     6224                                   hSAXWriter:insert-attribute ("П200000000014", part-2.TTN).
     6225                                   hSAXWriter:insert-attribute ("П200000000015", part-2.GTD).
     6226                                   hSAXWriter:insert-attribute ("П200000000016", string(part-2.total)).
     6227                               if last-of(part-2.supplier-code) then do:
     6228                                   hSAXWriter:end-element ("Поставщик").
     6229                               end.
     6230                           end.
     6231                           hSAXWriter:write-empty-element ("Движение").
     6232                               hSAXWriter:insert-attribute ("ПN", "1").
     6233                               hSAXWriter:insert-attribute ("П100000000006", string(part-1.remain-6) ).
     6234                               hSAXWriter:insert-attribute ("П100000000007", string(part-1.inc-7)    ).
     6235                               hSAXWriter:insert-attribute ("П100000000008", string(part-1.inc-8)    ).
     6236                               hSAXWriter:insert-attribute ("П100000000009", string(part-1.inc-9)    ).
     6237                               hSAXWriter:insert-attribute ("П100000000010", string(part-1.inc-10)   ).
     6238                               hSAXWriter:insert-attribute ("П100000000011", string(part-1.inc-11)   ).
     6239                               hSAXWriter:insert-attribute ("П100000000012", string(part-1.inc-12)   ).
     6240                               hSAXWriter:insert-attribute ("П100000000013", string(part-1.inc-13)   ).
     6241                               hSAXWriter:insert-attribute ("П100000000014", string(part-1.inc-14)   ).
     6242                               hSAXWriter:insert-attribute ("П100000000015", string(part-1.exp-15)   ).
     6243                               hSAXWriter:insert-attribute ("П100000000016", string(part-1.exp-16)   ).
     6244                               hSAXWriter:insert-attribute ("П100000000017", string(part-1.exp-17)   ).
     6245                               hSAXWriter:insert-attribute ("П100000000018", string(part-1.exp-18)   ).
     6246                               hSAXWriter:insert-attribute ("П100000000019", string(part-1.exp-19)   ).
     6247                               hSAXWriter:insert-attribute ("П100000000020", string(part-1.remain-20)).
     6248                               hSAXWriter:insert-attribute ("П100000000021", string(part-1.remain-21)).
     6249                       hSAXWriter:end-element ("СведПроизвИмпорт").
     6250                       if last-of(part-1.alc-type-code) then do:
     6251                           hSAXWriter:end-element ("Оборот").
     6252                       end.
     6253                   end.
     6254               hSAXWriter:end-element ("ОбъемОборота").
     6255           end.
     6256       hSAXWriter:end-element ("Документ").
     6257   hSAXWriter:end-element ("Файл").
     6258   hSAXWriter:end-document().
     6259   delete object hSAXWriter no-error.
     6260   message "Вывод в XML завершен." skip
     6261           "Путь к сформированному файлу: " skip
     6262           xml
     6263   view-as alert-box information.
     6264   end procedure.
     6265   PROCEDURE local-initialize :
     6266     RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     6267       assign
     6268       EDITOR-ALC-PRODUCER = "По всем производителям"
     6269       EDITOR-SUPPLIER = "По всем поставщикам"
     6270       EDITOR-ALC-TYPE = "По всем типам продукции"
     6271       TOGGLE-Excel    = yes
     6272       TOGGLE-XML      = yes
     6273       TOGGLE-KPP      = no
     6274       FILL-IN-exp-date =  12/01/14.
     6275       display EDITOR-ALC-PRODUCER EDITOR-SUPPLIER EDITOR-ALC-TYPE TOGGLE-Excel TOGGLE-XML TOGGLE-KPP FILL-IN-exp-date with frame F-Main.
     6276       assign FILL-IN-kor:hidden in frame F-Main = true.
     6277   END PROCEDURE.
     6278   PROCEDURE my-params :
     6279   END PROCEDURE.
     6280   PROCEDURE my-var :
     6281   END PROCEDURE.
     6282   PROCEDURE write-to-log :
     6283   define input param p-str as char no-undo.
     6284   do
     6285   on error undo, return error:
     6286      message
     6287         p-str
     6288         skip
     6289      view-as alert-box error.
     6290   end.
     6291   END PROCEDURE.
     6292   procedure my-init-temp-parts-by-factord :
     6293     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
     6294     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
     6295     define input parameter p-artic              like ub.parts.artic     no-undo .
     6296     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
     6297     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
     6298     define input parameter p-fact-order         as decimal   no-undo .
     6299     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
     6300     define buffer buf_gds-obj  for ub.gds-obj .
     6301     do
     6302     on error undo, return error
     6303     :
     6304       do transaction
     6305       on error undo, return error
     6306       :
     6307   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6308   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     6309     (input  p-obj-type
     6310     ,input  p-obj-code
     6311     ,input  p-artic
     6312     ,input  p-prod-type
     6313     ,input  p-prod-code
     6314     ,buffer buf_gds-obj
     6315     ) no-error .
     6316         if error-status :error
     6317         then do:
     6318           message
     6319             vss-workfile vss-revision vss-description skip
     6320             "Невозможно найти товар на объекте" skip
     6321             "Объект" p-obj-type p-obj-code skip
     6322             "Артикул" p-artic p-prod-type p-prod-code skip
     6323             error-status :get-message(1) skip
     6324             return-value skip
     6325             view-as alert-box error .
     6326           undo, return error .
     6327         end.
     6328         find current buf_gds-obj exclusive-lock .
     6329       end.
     6330       run partslib-init-temp-parts in this-procedure
     6331         (input p-obj-type
     6332         ,input p-obj-code
     6333         ,input p-artic
     6334         ,input p-prod-type
     6335         ,input p-prod-code
     6336         ) no-error .
     6337       if error-status :error
     6338       then do:
     6339         message
     6340           vss-workfile vss-revision vss-description skip
     6341           "Ошибка при инициализации текущего остатка по партиям свободной зоны" skip
     6342           "Объект" p-obj-type p-obj-code skip
     6343           "Артикул" p-artic p-prod-type p-prod-code skip
     6344           "p-fact-order" p-fact-order skip
     6345           view-as alert-box error .
     6346         undo, return error .
     6347       end.
     6348       assign
     6349         p-fact-order = p-fact-order - 0.0000000001
     6350       .
     6351       define variable v-max-fact-order as character no-undo .
     6352       run factord-max-fact-order in this-procedure
     6353         (output v-max-fact-order
     6354         ) no-error .
     6355       if error-status :error
     6356       then do:
     6357         message
     6358           vss-workfile vss-revision vss-description skip
     6359           "Ошибка при вызове процедуры factord-max-fact-order" skip
     6360           "Объект" p-obj-type p-obj-code skip
     6361           "Артикул" p-artic p-prod-type p-prod-code skip
     6362           "p-fact-order" p-fact-order skip
     6363           view-as alert-box error .
     6364         undo, return error .
     6365       end.
     6366       run my-update-by-factord in this-procedure
     6367         (input p-obj-type
     6368         ,input p-obj-code
     6369         ,input p-artic
     6370         ,input p-prod-type
     6371         ,input p-prod-code
     6372         ,input p-fact-order
     6373         ,input v-max-fact-order
     6374         ) no-error .
     6375       if error-status :error
     6376       then do:
     6377         message
     6378           vss-workfile vss-revision vss-description skip
     6379           "Ошибка при вызове процедуры partslib-update-by-factord" skip
     6380           "Объект" p-obj-type p-obj-code skip
     6381           "Артикул" p-artic p-prod-type p-prod-code skip
     6382           "p-fact-order" p-fact-order skip
     6383           "v-max-fact-order" v-max-fact-order skip
     6384           view-as alert-box error .
     6385         undo, return error .
     6386       end.
     6387     end.
     6388   end procedure.
     6389   procedure my-update-by-factord :
     6390     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
     6391     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
     6392     define input parameter p-artic              like ub.parts.artic     no-undo .
     6393     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
     6394     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
     6395     define input parameter p-start-fact-order   as decimal   no-undo .
     6396     define input parameter p-end-fact-order     as decimal   no-undo .
     6397     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
     6398     define buffer buf_gds-obj  for ub.gds-obj .
     6399     define buffer buf_doc-line for ub.doc-line .
     6400     define variable v-total-parts-qnty as decimal   no-undo .
     6401     define variable v-goods-gds-goods  as logical   no-undo .
     6402     define variable v-goods-twounit    as logical   no-undo .
     6403     define variable v-kpp2            as character no-undo .
     6404     do
     6405     on error undo, return error
     6406     :
     6407       if p-start-fact-order > p-end-fact-order
     6408       then do:
     6409         message
     6410           vss-workfile vss-revision vss-description skip
     6411           "Ошибка задания входных параметров" skip
     6412           "Начало интервала превышает конец интервала" skip
     6413           "Объект" p-obj-type p-obj-code skip
     6414           "Артикул" p-artic p-prod-type p-prod-code skip
     6415           "p-start-fact-order" p-start-fact-order skip
     6416           "p-end-fact-order"   p-end-fact-order skip
     6417           view-as alert-box error .
     6418         undo, return error .
     6419       end.
     6420   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6421   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     6422     (input  p-artic
     6423     ,input  p-prod-type
     6424     ,input  p-prod-code
     6425     ,input  'gds-goods=request':u
     6426     ,output v-goods-gds-goods
     6427     ) no-error .
     6428       if error-status :error
     6429       then do:
     6430         message
     6431           vss-workfile vss-revision vss-description skip
     6432           "Ошибка при определении атрибута товара" skip
     6433           "Артикул" p-artic p-prod-type p-prod-code skip
     6434           "gds-goods=request" skip
     6435           error-status :get-message(1) skip
     6436           return-value skip
     6437           view-as alert-box error .
     6438         undo, return error return-value .
     6439       end.
     6440   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6441   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     6442     (input  p-artic
     6443     ,input  p-prod-type
     6444     ,input  p-prod-code
     6445     ,input  'twounit=request':u
     6446     ,output v-goods-twounit
     6447     ) no-error .
     6448       if error-status :error
     6449       then do:
     6450         message
     6451           vss-workfile vss-revision vss-description skip
     6452           "Ошибка при определении атрибута товара" skip
     6453           "Артикул" p-artic p-prod-type p-prod-code skip
     6454           "twounit=request" skip
     6455           error-status :get-message(1) skip
     6456           return-value skip
     6457           view-as alert-box error .
     6458         undo, return error return-value .
     6459       end.
     6460       for each buf_doc-line no-lock
     6461         where buf_doc-line.obj-type   = p-obj-type
     6462           and buf_doc-line.obj-code   = p-obj-code
     6463           and buf_doc-line.artic      = p-artic
     6464           and buf_doc-line.prod-type  = p-prod-type
     6465           and buf_doc-line.prod-code  = p-prod-code
     6466           and buf_doc-line.status_    = 'факт':U
     6467           and buf_doc-line.fact-order > p-start-fact-order
     6468           and buf_doc-line.fact-order <= p-end-fact-order
     6469       on error undo, return error
     6470       :
     6471         if (buf_doc-line.ext-doc-type = 'iv' or buf_doc-line.ext-doc-type = 'ev' or buf_doc-line.ext-doc-type = 'rv')
     6472         then do :
     6473           for first buf_trn-doc no-lock where buf_trn-doc.doc-code = buf_doc-line.doc-code :
     6474               v-kpp = "" .
     6475               for first buf_clients-attr no-lock where buf_clients-attr.obj-code  = buf_trn-doc.cli-code
     6476                                                  and   buf_clients-attr.obj-type  = buf_trn-doc.cli-type
     6477                                                  and   buf_clients-attr.attr-code = 'kpp':U:
     6478                   v-kpp = buf_clients-attr.attr-value.
     6479               end.
     6480               if v-kpp = "" then  v-kpp = v-fmtcli-kpp.
     6481               v-kpp2 = "" .
     6482               for first buf_clients-attr no-lock where buf_clients-attr.obj-code  = buf_trn-doc.obj-code
     6483                                                  and   buf_clients-attr.obj-type  = buf_trn-doc.obj-type
     6484                                                  and   buf_clients-attr.attr-code = 'kpp':U:
     6485                   v-kpp2 = buf_clients-attr.attr-value.
     6486               end.
     6487               if v-kpp2 = "" then  v-kpp2 = v-fmtcli-kpp.
     6488               if v-kpp = v-kpp2 then next .
     6489           end.
     6490         end.
     6491         run partslib-process-document in this-procedure
     6492           (input  buf_doc-line.doc-code
     6493           ,input  p-obj-type
     6494           ,input  p-obj-code
     6495           ,input  p-artic
     6496           ,input  p-prod-type
     6497           ,input  p-prod-code
     6498           ,input  v-goods-gds-goods
     6499           ,input  v-goods-twounit
     6500           ,output v-total-parts-qnty
     6501           ) no-error .
     6502         if error-status :error
     6503         then do:
     6504           message
     6505             vss-workfile vss-revision vss-description skip
     6506             "Ошибка при вызове процедуры partslib-process-document" skip
     6507             "Документ" buf_doc-line.doc-code skip
     6508             "Объект" p-obj-type p-obj-code skip
     6509             "Артикул" p-artic p-prod-type p-prod-code skip
     6510             "p-start-fact-order" p-start-fact-order skip
     6511             "p-end-fact-order" p-end-fact-order skip
     6512             error-status :get-message(1) skip
     6513             return-value skip
     6514             view-as alert-box error .
     6515           undo, return error return-value .
     6516         end.
     6517       end.
     6518     end.
     6519   end procedure.
