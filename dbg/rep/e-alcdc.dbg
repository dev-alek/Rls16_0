     4471                                                                          ,input obj-list.obj-code
     4472                                                                          ,input alc-goods.artic
     4473                                                                          ,input alc-goods.prod-type
     4474                                                                          ,input alc-goods.prod-code
     4475                                                                          ,input fact-order-start).
