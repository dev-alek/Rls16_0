     4583                       imp-or-prod-code = temp-parts.prod-code
     4584                       tt-parts-info.importer = 'Производитель из карточки товара' .
     4585             release part-1 no-error.
     4586             if TOGGLE-KPP then do :
     4587                 find first part-1 where part-1.type-code = v-inner-code
     4588                                   and   part-1.prod-code = imp-or-prod-code
     4589                                   and   part-1.prod-type = imp-or-prod-type
     4590                                   and   part-1.obj-kpp   = v-kpp no-error.
     4591             end.
     4592             else do :
     4593                 find first part-1 where part-1.type-code = v-inner-code
     4594                                   and   part-1.prod-code = imp-or-prod-code
     4595                                   and   part-1.prod-type = imp-or-prod-type
     4596                                   and   part-1.obj-code  = obj-list.obj-code
     4597                                   and   part-1.obj-type  = obj-list.obj-type no-error.
     4598             end.
