     4716             assign
     4717               tt-parts-info.alc-type-code     = part-1.alc-type-code
     4718               tt-parts-info.producer-obj-name = part-1.producer-obj-name
     4719               tt-parts-info.producer-inn      = part-1.producer-inn
     4720               tt-parts-info.producer-kpp      = part-1.producer-kpp
     4721             no-error .
     4722             tt-parts-info.remain-6 = temp-parts.fact-qnty * alc-goods.vol / 10.
     4723          end.
     4724       end.
     4725   end.
     4726   for each obj-list no-lock:
