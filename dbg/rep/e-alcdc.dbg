     4274               end.
     4275               else
     4276               if ext-cl:NumBundles > 0
     4277               and ext-cl:GetExtGdsValue(1):CliRegIdProd <> ""
     4278               and ext-cl:GetExtGdsValue(1):CliRegIdProd <> ?
     4279               then do :
     4280                   if ext-cl:GetExtGdsValue(1):CliRegIdImpor <> ""
     4281                   and ext-cl:GetExtGdsValue(1):CliRegIdImpor <> ?
     4282                   then do :
     4283                           if trim(ext-cl:GetExtGdsValue(1):CountryProd) = "643"
     4284                           or trim(ext-cl:GetExtGdsValue(1):CountryProd) = "051"
     4285                           or trim(ext-cl:GetExtGdsValue(1):CountryProd) = "398"
