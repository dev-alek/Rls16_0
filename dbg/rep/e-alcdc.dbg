     5793           hSAXWriter:write-data-element("c20" ,string(part-1.remain-20)).
     5794           hSAXWriter:write-data-element("c21" ,string(part-1.remain-21)).
     5795       hSAXWriter:end-element ("row").
     5796       if last-of (part-1.obj-code) then do:
     5797           hSAXWriter:start-element ("row").
     5798               nn = nn + 1.
