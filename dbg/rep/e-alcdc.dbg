     4259                   ext-cl:OpenQueryExtGds(alc-goods.gds-code, entry(3, temp-parts.alc-ref-ab-path)) .
     4260                   tt-parts-info.alc-code =  entry(3, temp-parts.alc-ref-ab-path) .
     4261               end.
     4262               if temp-parts.alc-imp-code <> 0 then assign
     4263                       imp-or-prod-type = temp-parts.alc-imp-type
     4264                       imp-or-prod-code = temp-parts.alc-imp-code
     4265                       tt-parts-info.importer = 'Импортер из алк.атр. партии' .
     4266               else
     4267               if ext-FormF1:NumBundles > 0
     4268               and ext-FormF1:GetExtFormF1Value():CliRegIdOrigCli <> ""
     4269               and ext-FormF1:GetExtFormF1Value():CliRegIdOrigCli <> ?
     4270               then do :
     4271                   imp-or-prod-type = ext-FormF1:GetExtFormF1Value():CliRegIdOrigCli .
