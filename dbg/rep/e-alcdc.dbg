     5702           hSAXWriter:write-data-element("c07" ,string(accum total by part-1.alc-type-code part-1.inc-7    )).
     5703           hSAXWriter:write-data-element("c08" ,string(accum total by part-1.alc-type-code part-1.inc-8    )).
     5704           hSAXWriter:write-data-element("c09" ,string(accum total by part-1.alc-type-code part-1.inc-9    )).
     5705           hSAXWriter:write-data-element("c10" ,string(accum total by part-1.alc-type-code part-1.inc-10   )).
     5706           hSAXWriter:write-data-element("c11" ,string(accum total by part-1.alc-type-code part-1.inc-11   )).
     5707           hSAXWriter:write-data-element("c12" ,string(accum total by part-1.alc-type-code part-1.inc-12   )).
     5708           hSAXWriter:write-data-element("c13" ,string(accum total by part-1.alc-type-code part-1.inc-13   )).
     5709           hSAXWriter:write-data-element("c14" ,string(accum total by part-1.alc-type-code part-1.inc-14   )).
     5710           hSAXWriter:write-data-element("c15" ,string(accum total by part-1.alc-type-code part-1.exp-15   )).
     5711           hSAXWriter:write-data-element("c16" ,string(accum total by part-1.alc-type-code part-1.exp-16   )).
     5712           hSAXWriter:write-data-element("c17" ,string(accum total by part-1.alc-type-code part-1.exp-17   )).
     5713           hSAXWriter:write-data-element("c18" ,string(accum total by part-1.alc-type-code part-1.exp-18   )).
     5714           hSAXWriter:write-data-element("c19" ,string(accum total by part-1.alc-type-code part-1.exp-19   )).
     5715           hSAXWriter:write-data-element("c20" ,string(accum total by part-1.alc-type-code part-1.remain-20)).
     5716           hSAXWriter:write-data-element("c21" ,string(accum total by part-1.alc-type-code part-1.remain-21)).
     5717         hSAXWriter:end-element ("row").
     5718       end.
     5719   end.
     5720         hSAXWriter:start-element ("row").
     5721           nn = nn + 1.
     5722           hSAXWriter:write-data-element("n", string(nn)).
     5723           hSAXWriter:write-data-element("c01" ,"ИТОГО").
     5724           hSAXWriter:write-data-element("c02" ,"").
     5725           hSAXWriter:write-data-element("c03" ,"").
