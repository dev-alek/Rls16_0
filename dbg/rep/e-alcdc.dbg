     4395                           part-1.producer-inn = ext-FormF1:GetExtFormF1Value():INNOrigCli .
     4396                           part-1.producer-kpp = ext-FormF1:GetExtFormF1Value():KPPOrigCli .
     4397                       end.
     4398                       else
