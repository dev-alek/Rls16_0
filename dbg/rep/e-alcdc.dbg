     4569                               imp-or-prod-type = ext-cl:GetExtGdsValue(1):CliRegIdImpor
     4570                               imp-or-prod-code = 0
     4571                               tt-parts-info.importer = 'ЕГАИС. Импортер'
     4572                           .
     4573                   end.
