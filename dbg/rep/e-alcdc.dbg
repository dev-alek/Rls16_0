     5220                           if v-attr-val <> "" then do:
     5221                               find first buf_alc-supp-lic where buf_alc-supp-lic.cli-type = substring(v-attr-val, 1, 3)
     5222                                                             and buf_alc-supp-lic.cli-code = integer(substring(v-attr-val, 4))
     5223                                                             and buf_alc-supp-lic.date-from <= buf_trn-doc.fact-date
     5224                                                             and buf_alc-supp-lic.date-to   >= buf_trn-doc.fact-date no-lock no-error.
     5225                               if not available(buf_alc-supp-lic) then do:
     5226                                   run clntattr-value in this-procedure (
     5227                                                input substring(v-attr-val, 1, 3)
     5228                                               ,input integer(substring(v-attr-val, 4))
     5229                                               ,input 'main-accholder':U
     5230                                               ,output v-attr-val
     5231                                               ,output v-attr-type) no-error.
     5232                                   find first buf_alc-supp-lic where buf_alc-supp-lic.cli-type = entry(1, v-attr-val, ',')
     5233                                                             and buf_alc-supp-lic.cli-code = integer(entry(2, v-attr-val, ','))
     5234                                                             and buf_alc-supp-lic.date-from <= buf_trn-doc.fact-date
     5235                                                             and buf_alc-supp-lic.date-to   >= buf_trn-doc.fact-date no-lock no-error.
     5236                               end.
     5237                           end.
     5238                           if not available(buf_alc-supp-lic) then do:
     5239                               find first buf_alc-supp-lic where buf_alc-supp-lic.cli-type = buf_trn-doc.cli-type
     5240                                                             and buf_alc-supp-lic.cli-code = buf_trn-doc.cli-code
     5241                                                             and buf_alc-supp-lic.date-from <= buf_trn-doc.fact-date
     5242                                                             and buf_alc-supp-lic.date-to   >= buf_trn-doc.fact-date no-lock no-error.
     5243                               if not available(buf_alc-supp-lic) then do:
     5244                                   run clntattr-value in this-procedure (
     5245                                                 input buf_trn-doc.cli-type
     5246                                               ,input buf_trn-doc.cli-code
     5247                                               ,input 'main-accholder':U
     5248                                               ,output v-attr-val
     5249                                               ,output v-attr-type) no-error.
     5250                                   find first buf_alc-supp-lic where buf_alc-supp-lic.cli-type = entry(1, v-attr-val, ',')
     5251                                                             and buf_alc-supp-lic.cli-code = integer(entry(2, v-attr-val, ','))
     5252                                                             and buf_alc-supp-lic.date-from <= buf_trn-doc.fact-date
     5253                                                             and buf_alc-supp-lic.date-to   >= buf_trn-doc.fact-date no-lock no-error.
     5254                               end.
     5255                           end.
     5256                           if available(buf_alc-supp-lic) then do:
     5257                               assign
     5258                               part-2.supplier-serial-number = buf_alc-supp-lic.seria + " " +  buf_alc-supp-lic.number
     5259                               part-2.supplier-date-get = string(buf_alc-supp-lic.date-get, "99.99.9999")
     5260                               part-2.supplier-date-to = string(buf_alc-supp-lic.date-to, "99.99.9999")
     5261                               part-2.supplier-get-from = buf_alc-supp-lic.who-are-got.
     5262                               assign
     5263                               v-obj-code = buf_alc-supp-lic.cli-code
     5264                               v-obj-type = buf_alc-supp-lic.cli-type.
     5265                               find first buf_part-2 no-lock where buf_part-2.supplier-serial-number = part-2.supplier-serial-number
     5266                                                               and buf_part-2.supplier-code <> v-obj-code no-error .
     5267                               if available buf_part-2
     5268                               then do :
     5269                                   part-2.supplier-serial-number = part-2.supplier-serial-number + " " .
     5270                               end.
     5271                           end.
     5272                           else do:
     5273                           end.
     5274                           assign
     5275                           part-2.supplier-code = v-obj-code
     5276                           part-2.supplier-type = v-obj-type.
     5277                           for first buf_clients where buf_clients.obj-type = part-2.supplier-type
     5278                                                   and buf_clients.obj-code = part-2.supplier-code no-lock:
     5279                               part-2.supplier-obj-name = buf_clients.obj-name.
     5280                           end.
     5281                           case part-2.supplier-type:
     5282                               when 'орг':U then do:
     5283                                   find first buf_firm no-lock where buf_firm.firm-code = part-2.supplier-code.
     5284                                   assign
     5285                                   part-2.supplier-inn = buf_firm.inn
     5286                                   part-2.supplier-kpp = buf_firm.kpp.
     5287                               end.
     5288                               when 'маг':U or when 'скл':U then do:
     5289                               find first buf_clients no-lock where buf_clients.obj-code = part-2.supplier-code
     5290                                                              and   buf_clients.obj-type = part-2.supplier-type.
     5291                               find first buf_firm no-lock where buf_firm.firm-code = buf_clients.host-code.
     5292                               release buf_clients-attr.
     5293                               find first buf_clients-attr no-lock where buf_clients-attr.obj-code  = part-2.supplier-code
     5294                                                                   and   buf_clients-attr.obj-type  = part-2.supplier-type
     5295                                                                   and   buf_clients-attr.attr-code = 'kpp':U no-error.
     5296                               assign
     5297                                   part-2.supplier-inn = buf_firm.inn
     5298                                   part-2.supplier-kpp = (if buf_clients-attr.attr-value <> ""
     5299                                                         and buf_clients-attr.attr-value <> ?
     5300                                                         then buf_clients-attr.attr-value else buf_firm.kpp).
     5301                               end.
     5302                               when 'чел':U then do:
     5303                                   find first buf_person  no-lock where buf_person.psn-code = part-2.supplier-code.
     5304                                   find first buf_clients no-lock where buf_clients.obj-code = part-2.supplier-code
     5305                                                                  and   buf_clients.obj-type = part-2.supplier-type.
     5306                                   assign
     5307                                   part-2.supplier-obj-name = buf_clients.obj-name
     5308                                   part-2.supplier-inn = buf_person.inn
     5309                                   part-2.supplier-kpp = buf_person.kpp.
     5310                               end.
     5311                           end case.
     5312                           run gbl/trdcat-v.p   ( input buf_trn-doc.doc-code
     5313                              , input 'dids':U
     5314                              , output v-attr-val
     5315                              , output v-attr-type
     5316                              ) no-error.
     5317                              part-2.purchase-date = (if v-attr-val <> "" then date(v-attr-val) else buf_trn-doc.fact-date).
     5318                           run gbl/trdcat-v.p   ( input buf_trn-doc.doc-code
     5319                              , input 'nids':U
     5320                              , output v-attr-val
     5321                              , output v-attr-type
     5322                              ) no-error.
     5323                              part-2.TTN = (if v-attr-val <> "" then v-attr-val else "Не определено").
     5324                       end.
     5325                   end.
     5326               end.
     5327           end.
     5328       end.
     5329   end.
     5330   delete object ext-cl no-error .
     5331   delete object ext-FormF1 no-error .
     5332   output stream logStr close .
     5333   define buffer buf_part-1 for part-1 .
     5334   for each part-1 exclusive-lock where part-1.producer-inn <> "" :
     5335       if TOGGLE-KPP then do :
     5336           find first buf_part-1 exclusive-lock where buf_part-1.alc-type-code = part-1.alc-type-code
     5337                                                  and buf_part-1.producer-inn  = part-1.producer-inn
     5338                                                  and buf_part-1.producer-kpp  = part-1.producer-kpp
     5339                                                  and buf_part-1.obj-kpp       = part-1.obj-kpp
     5340                                                  and rowid(buf_part-1) <> rowid(part-1) no-error.
     5341       end.
     5342       else do :
     5343           find first buf_part-1 exclusive-lock where buf_part-1.alc-type-code = part-1.alc-type-code
     5344                                                  and buf_part-1.producer-inn  = part-1.producer-inn
     5345                                                  and buf_part-1.producer-kpp  = part-1.producer-kpp
     5346                                                  and buf_part-1.obj-type      = part-1.obj-type
     5347                                                  and buf_part-1.obj-code      = part-1.obj-code
     5348                                                  and rowid(buf_part-1) <> rowid(part-1) no-error.
     5349       end.
     5350       if available buf_part-1 then do :
     5351           if part-1.prod-code = 0 then do :
     5352               assign
     5353                   buf_part-1.inc-7  = buf_part-1.inc-7  + part-1.inc-7
     5354                   buf_part-1.inc-8  = buf_part-1.inc-8  + part-1.inc-8
     5355                   buf_part-1.inc-9  = buf_part-1.inc-9  + part-1.inc-9
     5356                   buf_part-1.inc-10 = buf_part-1.inc-10 + part-1.inc-10
     5357                   buf_part-1.inc-11 = buf_part-1.inc-11 + part-1.inc-11
     5358                   buf_part-1.inc-12 = buf_part-1.inc-12 + part-1.inc-12
     5359                   buf_part-1.inc-13 = buf_part-1.inc-13 + part-1.inc-13
     5360                   buf_part-1.inc-14 = buf_part-1.inc-14 + part-1.inc-14
     5361                   buf_part-1.exp-15 = buf_part-1.exp-15 + part-1.exp-15
     5362                   buf_part-1.exp-16 = buf_part-1.exp-16 + part-1.exp-16
     5363                   buf_part-1.exp-17 = buf_part-1.exp-17 + part-1.exp-17
     5364                   buf_part-1.exp-18 = buf_part-1.exp-18 + part-1.exp-18
     5365                   buf_part-1.exp-19 = buf_part-1.exp-19 + part-1.exp-19
     5366                   buf_part-1.remain-6 = buf_part-1.remain-6 + part-1.remain-6
     5367                   buf_part-1.remain-20 = buf_part-1.remain-20 + part-1.remain-20
     5368                   buf_part-1.remain-21 = buf_part-1.remain-21 + part-1.remain-21
     5369               .
     5370               delete part-1.
     5371               next.
     5372           end.
     5373           if buf_part-1.prod-code = 0 then do :
     5374               assign
     5375                   part-1.inc-7  = part-1.inc-7  + buf_part-1.inc-7
     5376                   part-1.inc-8  = part-1.inc-8  + buf_part-1.inc-8
     5377                   part-1.inc-9  = part-1.inc-9  + buf_part-1.inc-9
     5378                   part-1.inc-10 = part-1.inc-10 + buf_part-1.inc-10
     5379                   part-1.inc-11 = part-1.inc-11 + buf_part-1.inc-11
     5380                   part-1.inc-12 = part-1.inc-12 + buf_part-1.inc-12
     5381                   part-1.inc-13 = part-1.inc-13 + buf_part-1.inc-13
     5382                   part-1.inc-14 = part-1.inc-14 + buf_part-1.inc-14
     5383                   part-1.exp-15 = part-1.exp-15 + buf_part-1.exp-15
     5384                   part-1.exp-16 = part-1.exp-16 + buf_part-1.exp-16
     5385                   part-1.exp-17 = part-1.exp-17 + buf_part-1.exp-17
     5386                   part-1.exp-18 = part-1.exp-18 + buf_part-1.exp-18
     5387                   part-1.exp-19 = part-1.exp-19 + buf_part-1.exp-19
     5388                   part-1.remain-6 = part-1.remain-6 + buf_part-1.remain-6
     5389                   part-1.remain-20 = part-1.remain-20 + buf_part-1.remain-20
     5390                   part-1.remain-21 = part-1.remain-21 + buf_part-1.remain-21
     5391               .
     5392               delete buf_part-1.
     5393               next.
     5394           end.
     5395       end.
     5396   end.
     5397   for each part-2 exclusive-lock :
     5398       if TOGGLE-KPP then do :
     5399           find first buf_part-2 exclusive-lock where buf_part-2.alc-type-code = part-2.alc-type-code
     5400                                                  and buf_part-2.producer-inn  = part-2.producer-inn
     5401                                                  and buf_part-2.producer-kpp  = part-2.producer-kpp
     5402                                                  and buf_part-2.obj-kpp       = part-2.obj-kpp
     5403                                                  and buf_part-2.TTN           = part-2.TTN
     5404                                                  and buf_part-2.supplier-type = part-2.supplier-type
     5405                                                  and buf_part-2.supplier-code = part-2.supplier-code
     5406                                                  and rowid(buf_part-2) <> rowid(part-2) no-error.
     5407       end.
     5408       else do :
     5409           find first buf_part-2 exclusive-lock where buf_part-2.alc-type-code = part-2.alc-type-code
     5410                                                  and buf_part-2.producer-inn  = part-2.producer-inn
     5411                                                  and buf_part-2.producer-kpp  = part-2.producer-kpp
     5412                                                  and buf_part-2.obj-type      = part-2.obj-type
     5413                                                  and buf_part-2.obj-code      = part-2.obj-code
     5414                                                  and buf_part-2.TTN           = part-2.TTN
     5415                                                  and buf_part-2.supplier-type = part-2.supplier-type
     5416                                                  and buf_part-2.supplier-code = part-2.supplier-code
     5417                                                  and rowid(buf_part-2) <> rowid(part-2) no-error.
     5418       end.
     5419       if available buf_part-2 then do :
     5420           if part-2.prod-code = 0 then do :
     5421               assign
     5422                   buf_part-2.total = buf_part-2.total + part-2.total
     5423               .
     5424               delete part-2.
     5425               next.
     5426           end.
     5427           if buf_part-2.prod-code = 0 then do :
     5428               assign
     5429                   part-2.total = part-2.total + buf_part-2.total
     5430               .
     5431               delete buf_part-2.
     5432               next.
     5433           end.
     5434       end.
     5435   end.
     5436   define variable new-prod-code as integer no-undo .
     5437   assign new-prod-code = 1 .
     5438   for each part-1 exclusive-lock where part-1.prod-code = 0 break by part-1.prod-type :
     5439       for each part-2 exclusive-lock where part-2.alc-type-code = part-1.alc-type-code
     5440                                        and part-2.prod-code = part-1.prod-code
     5441                                        and part-2.prod-type = part-1.prod-type
     5442                                        and part-2.obj-code  = part-1.obj-code
     5443                                        and part-2.obj-type  = part-1.obj-type :
     5444           assign part-2.prod-code = 10000 + new-prod-code .
     5445       end.
     5446       assign part-1.prod-code = 10000 + new-prod-code .
     5447       if last-of(part-1.prod-type) then assign new-prod-code = new-prod-code + 1 .
     5448   end.
     5449   wait-message = string("Идёт формирование отчета").
     5450   run waitfram-show in this-procedure (input wait-message).
     5451   run print-info .
     5452   if TOGGLE-Excel = yes then run excel-output.
     5453   if TOGGLE-XML = yes then run xml-output.
     5454   run waitfram-hide.
     5455   if v-inn-err
     5456   then do :
     5457       define variable v-user-action    as character no-undo.
     5458       define variable v-printed        as logical   no-undo.
     5459       message "Есть замечания по формированию декларации" view-as alert-box.
     5460       run gbl/prnfilen.w
     5461          (input  "Ошибки алкогольной декларации"
     5462          ,input  0
     5463          ,input  "alc-dec_errors.txt"
     5464          ,input  7
     5465          ,output v-user-action
     5466          ,output v-printed
     5467          ).
     5468   end.
     5469   apply "go".
     5470   END PROCEDURE.
     5471   procedure print-info :
     5472       define var v-act-file as char no-undo.
     5473       v-act-file  = session:temp-directory + "rpt" +  "alc-dec_parts-info.html".
     5474       output stream OutStr-html to value(v-act-file) convert target 'UTF-8'.
     5475       put stream OutStr-html unformatted
     5476           substitute(
     5477           '<!doctype html>
     5478                    <html>
     5479                 <head>
     5480                 <meta charset="UTF-8">
     5481                    <!-- Стили документа -->
     5482                 <style>
     5483                   table ~{border-collapse: collapse; ~}
     5484                   tbody td, th ~{border: 1px solid black;~}
     5485                   #myid ~{font-weight: bold;~}
     5486                   .class1 ~{font-style: italic;~}
     5487                   .class2 ~{font-family: Arial;~}
     5488                 </style>
     5489                 </head>
     5490                     <body>
     5491                     <table orientation="landscape" name="лист1" repeat_rows="1:1" hide_zero="True">
     5492                     <thead>
     5493                     <!-- Обязательно создаётся строка таблицы, в которой находятся размеры колонок в px-->
     5494                     <tr class="set_columns">
     5495                           <td style="width:40px"></td>
     5496                           <td style="width:50px"></td>
     5497                           <td style="width:50px"></td>
     5498                           <td style="width:80px"></td>
     5499                           <td style="width:80px"></td>
     5500                           <td style="width:80px"></td>
     5501                           <td style="width:80px"></td>
     5502                           <td style="width:120px"></td>
     5503                           <td style="width:180px"></td>
     5504                           <td style="width:80px"></td>
     5505                           <td style="width:80px"></td>
     5506                           <td style="width:120px"></td>
     5507                           <td style="width:90px"></td>
     5508                           <td style="width:90px"></td>
     5509                           <td style="width:90px"></td>
     5510                           <td style="width:90px"></td>
     5511                           <td style="width:90px"></td>
     5512                           <td style="width:90px"></td>
     5513                           <td style="width:90px"></td>
     5514                           <td style="width:90px"></td>
     5515                           <td style="width:90px"></td>
     5516                           <td style="width:90px"></td>
     5517                           <td style="width:90px"></td>
     5518                           <td style="width:90px"></td>
     5519                           <td style="width:90px"></td>
     5520                           <td style="width:90px"></td>
     5521                           <td style="width:90px"></td>
     5522                           <td style="width:90px"></td>
     5523                     </tr>
     5524                     <tr>
     5525                           <td colspan="28" style="front-weight: bold; text-align: center;">Информация по партиям для алкогольной декларации</td>
     5526                     </tr>
     5527           </thead>
     5528               <tbody>
     5529                   <tr>
     5530                   <th>Код объекта</th>
     5531                   <th>Тип объекта</th>
     5532                   <th>Код АП</th>
     5533                   <th>Номер приходного документа (in-code)</th>
     5534                   <th>Номер документа (out-code)</th>
     5535                   <th>Номер партии (part-code)</th>
     5536                   <th>Артикул</th>
     5537                   <th>Алк. Код</th>
     5538                   <th>Имя произв.</th>
     5539                   <th>ИНН произв.</th>
     5540                   <th>КПП произв.</th>
     5541                   <th>Откуда</th>
     5542                   <th>6</th>
     5543                   <th>7</th>
     5544                   <th>8</th>
     5545                   <th>9</th>
     5546                   <th>10</th>
     5547                   <th>11</th>
     5548                   <th>12</th>
     5549                   <th>13</th>
     5550                   <th>14</th>
     5551                   <th>15</th>
     5552                   <th>16</th>
     5553                   <th>17</th>
     5554                   <th>18</th>
     5555                   <th>19</th>
     5556                   <th>20</th>
     5557                   <th>21</th>
     5558                   </tr>').
     5559       for each tt-parts-info break by tt-parts-info.obj-type by tt-parts-info.obj-code by tt-parts-info.alc-type-code :
     5560           put stream OutStr-html unformatted
     5561               '<tr style="height: 50px;">' skip
     5562                '<td text_wrap="true">' + string(tt-parts-info.obj-type) + '</td>' skip
     5563                '<td text_wrap="true">' + string(tt-parts-info.obj-code) + '</td>' skip
     5564                '<td text_wrap="true">' + string(tt-parts-info.alc-type-code) + '</td>' skip
     5565                '<td text_wrap="true">' + string(tt-parts-info.in-code) + '</td>' skip
     5566                '<td text_wrap="true">' + string(tt-parts-info.out-code) + '</td>' skip
     5567                '<td text_wrap="true">' + string(tt-parts-info.part-code) + '</td>' skip
     5568                '<td text_wrap="true">' + string(tt-parts-info.artic) + '</td>' skip
     5569                '<td text_wrap="true">' + string(tt-parts-info.alc-code) + '</td>' skip
     5570                '<td text_wrap="true">' + string(tt-parts-info.producer-obj-name) + '</td>' skip
     5571                '<td text_wrap="true">' + string(tt-parts-info.producer-inn) + '</td>' skip
     5572                '<td text_wrap="true">' + string(tt-parts-info.producer-kpp) + '</td>' skip
     5573                '<td text_wrap="true">' + string(tt-parts-info.importer) + '</td>' skip
     5574                '<td text_wrap="true">' + string(tt-parts-info.remain-6) + '</td>' skip
     5575                '<td text_wrap="true">' + string(tt-parts-info.inc-7) + '</td>' skip
     5576                '<td text_wrap="true">' + string(tt-parts-info.inc-8) + '</td>' skip
     5577                '<td text_wrap="true">' + string(tt-parts-info.inc-9) + '</td>' skip
     5578                '<td text_wrap="true">' + string(tt-parts-info.inc-10) + '</td>' skip
     5579                '<td text_wrap="true">' + string(tt-parts-info.inc-11) + '</td>' skip
     5580                '<td text_wrap="true">' + string(tt-parts-info.inc-12) + '</td>' skip
     5581                '<td text_wrap="true">' + string(tt-parts-info.inc-13) + '</td>' skip
     5582                '<td text_wrap="true">' + string(tt-parts-info.inc-14) + '</td>' skip
     5583                '<td text_wrap="true">' + string(tt-parts-info.exp-15) + '</td>' skip
     5584                '<td text_wrap="true">' + string(tt-parts-info.exp-16) + '</td>' skip
     5585                '<td text_wrap="true">' + string(tt-parts-info.exp-17) + '</td>' skip
     5586                '<td text_wrap="true">' + string(tt-parts-info.exp-18) + '</td>' skip
     5587                '<td text_wrap="true">' + string(tt-parts-info.exp-19) + '</td>' skip
     5588                '<td text_wrap="true">' + string(tt-parts-info.remain-20) + '</td>' skip
     5589                '<td text_wrap="true">' + string(tt-parts-info.remain-21) + '</td>' skip
     5590                '</tr>' skip
     5591                '</tbody>' skip
     5592             .
     5593       end.
     5594       output stream OutStr-html close.
     5595   end.
     5596   PROCEDURE excel-output:
     5597   define variable hSAXWriter as handle no-undo.
     5598   define variable xml_tmp    as character no-undo.
     5599   define variable xslt       as character no-undo.
     5600   define variable nn         as integer no-undo.
     5601   define variable Report-out as class Rep-Out no-undo.
     5602   xml_tmp = session:temp-directory + "alc-decl-tmp.xml".
     5603   create sax-writer hSAXWriter.
     5604   hSAXWriter:formatted = true.
     5605   hSAXWriter:encoding = "utf-8":U.
     5606   hSAXWriter:set-output-destination("file":U, xml_tmp).
     5607   hSAXWriter:start-document().
     5608   hSAXWriter:start-element ("report").
     5609   hSAXWriter:start-element ("page-1").
     5610       hSAXWriter:write-data-element ("inn",v-fmtcli-inn).
     5611       hSAXWriter:write-data-element ("kpp",v-fmtcli-kpp).
     5612       hSAXWriter:write-data-element ("quarter",string(quarter)).
     5613       if quarter <> 1 then hSAXWriter:write-data-element ("year",string(year(x-date-start))).
     5614       hSAXWriter:write-data-element ("name",v-fmtcli-name).
     5615       hSAXWriter:write-data-element ("post-code",firm-post-code).
     5616       hSAXWriter:write-data-element ("region",firm-reg-code).
     5617       hSAXWriter:write-data-element ("district",firm-district).
     5618       hSAXWriter:write-data-element ("city", if firm-city <> "" then firm-city else firm-settlement).
     5619       hSAXWriter:write-data-element ("street",firm-street).
     5620       hSAXWriter:write-data-element ("house",if firm-house-number <> "" then "д. " + firm-house-number + firm-house-litera else ""
     5621                                             + if firm-house-case <> "" then " кор. " + firm-house-case  else ""
     5622                                             + if firm-house-apartment <> "" then " кв. " + firm-house-apartment else "").
     5623       hSAXWriter:write-data-element ("phone",v-fmtcli-phone).
     5624       hSAXWriter:write-data-element ("e-mail",firm-e-mail).
     5625       hSAXWriter:write-data-element ("director",firm-director-f + " " + firm-director-i + " " + firm-director-o).
     5626       hSAXWriter:write-data-element ("accountant",firm-accountant-f + " " + firm-accountant-i + " " + firm-accountant-o).
     5627       hSAXWriter:write-data-element ("date",string(day(today), "99") + string(month(today), "99") + string(year(today), "9999")).
     5628   hSAXWriter:end-element ("page-1").
     5629   hSAXWriter:start-element ("page-2").
     5630       hSAXWriter:insert-attribute ("inn",v-fmtcli-inn).
     5631       hSAXWriter:insert-attribute ("kpp",v-fmtcli-kpp).
     5632       for each alc-sale-licenses no-lock:
     5633           hSAXWriter:start-element ("licenses").
     5634               hSAXWriter:write-data-element("l1", alc-sale-licenses.seria).
     5635               hSAXWriter:write-data-element("l2", alc-sale-licenses.number).
     5636               hSAXWriter:write-data-element("l3", alc-sale-licenses.date-from).
     5637               hSAXWriter:write-data-element("l4", alc-sale-licenses.date-to).
     5638               hSAXWriter:write-data-element("l5", alc-sale-licenses.lic-type).
     5639           hSAXWriter:end-element ("licenses").
     5640       end.
     5641       for each page-2 no-lock:
     5642           hSAXWriter:start-element ("objects").
     5643               hSAXWriter:write-data-element("o1", page-2.kpp).
     5644               hSAXWriter:write-data-element("o2", page-2.post-code).
     5645               hSAXWriter:write-data-element("o3", page-2.reg-code).
     5646               hSAXWriter:write-data-element("o4", page-2.district).
     5647               hSAXWriter:write-data-element("o5", if page-2.city <> "" then page-2.city else page-2.settlement ).
     5648               hSAXWriter:write-data-element("o6", page-2.street).
     5649               hSAXWriter:write-data-element("o7", if page-2.house-number <> "" then "д. " + page-2.house-number + page-2.house-litera else ""
     5650                                                   + if page-2.house-case <> "" then " кор. " + page-2.house-case  else ""
     5651                                                   + if page-2.apartment <> "" then " кв. " + page-2.apartment else "").
     5652           hSAXWriter:end-element ("objects").
     5653       end.
     5654   hSAXWriter:end-element ("page-2").
     5655   hSAXWriter:start-element ("part-1").
     5656   hSAXWriter:start-element ("firm").
     5657       nn = 1.
     5658       hSAXWriter:write-data-element("header", v-fmtcli-name).
     5659   for each part-1 no-lock break by part-1.alc-type-code:
     5660       accumulate part-1.remain-6  (total).
     5661       accumulate part-1.inc-7     (total).
     5662       accumulate part-1.inc-8     (total).
     5663       accumulate part-1.inc-9     (total).
