     4216                                                and alc-suppliers.obj-code = temp-parts.supp-code)
     4217             then next.
     4218             v-inner-code = ? .
     4219             if num-entries(temp-parts.alc-ref-ab-path) = 4 and entry(4, temp-parts.alc-ref-ab-path) <> "" then do :
     4220               find first alc-types no-lock where trim(alc-types.alc-type-code) = trim(entry(4, temp-parts.alc-ref-ab-path)) no-error .
     4221               if available alc-types then v-inner-code = alc-types.type-code .
     4222               else next .
     4223             end.
     4224             if v-inner-code = ? then v-inner-code = alc-goods.type-code .
