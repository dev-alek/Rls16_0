     4423                               part-1.producer-inn = ext-cl:GetExtGdsValue(1):INNProd
     4424                               part-1.producer-kpp = ext-cl:GetExtGdsValue(1):KPPProd
     4425                           .
     4426                       end.
     4427                 end.
     4428             end case.
