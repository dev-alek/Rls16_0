     4453               where buf_ex-mark-attr.db-num = temp-parts.mark-db-num
     4454               and buf_ex-mark-attr.mark-code = temp-parts.mark-code
     4455               and buf_ex-mark-attr.attr-code = "exp-date" no-error.
     4456             if available(buf_ex-mark-attr) and buf_ex-mark-attr.attr-value <> ? then do:
     4457                 if date(buf_ex-mark-attr.attr-value) <= FILL-IN-exp-date then assign
     4458                   part-1.remain-21 = part-1.remain-21 + temp-parts.fact-qnty * alc-goods.vol / 10
     4459                   tt-parts-info.remain-21 = temp-parts.fact-qnty * alc-goods.vol / 10 .
     4460             end.
     4461          end.
     4462       end.
     4463   end.
     4464   for each obj-list no-lock:
     4465       wait-message = string("Идёт расчет остатков на начало периода по объекту " + obj-list.obj-name).
     4466       run waitfram-show in this-procedure (input wait-message).
