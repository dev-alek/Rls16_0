     4556                           if trim(ext-cl:GetExtGdsValue(1):CountryProd) = "643"
     4557                           or trim(ext-cl:GetExtGdsValue(1):CountryProd) = "051"
     4558                           or trim(ext-cl:GetExtGdsValue(1):CountryProd) = "398"
     4559                           or trim(ext-cl:GetExtGdsValue(1):CountryProd) = "417"
     4560                           or trim(ext-cl:GetExtGdsValue(1):CountryProd) = "112"
     4561                           then
     4562                           assign
     4563                               imp-or-prod-type = ext-cl:GetExtGdsValue(1):CliRegIdProd
     4564                               imp-or-prod-code = 0
     4565                               tt-parts-info.importer = 'ЕГАИС. Производитель из Таможенного Союза'
     4566                           .
     4567                           else
