     4236                   tt-parts-info.obj-type         = obj-list.obj-type
     4237                   tt-parts-info.obj-code         = obj-list.obj-code
     4238                   tt-parts-info.artic            = alc-goods.artic
     4239                   tt-parts-info.prod-type        = alc-goods.prod-type
     4240                   tt-parts-info.prod-code        = alc-goods.prod-code
     4241                   tt-parts-info.in-code          = temp-parts.in-code
     4242                   tt-parts-info.out-code         = temp-parts.out-code
     4243                   tt-parts-info.part-code        = temp-parts.part-code
     4244                  .
     4245              end.
     4246               v-kpp = "" .
