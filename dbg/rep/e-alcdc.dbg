     4144       alc-sale-licenses.date-to   = string(buf_alc-sale-lic.date-to, "99.99.9999")
     4145       alc-sale-licenses.lic-type  = "Продажа".
     4146   end.
     4147   for each obj-list no-lock break by obj-list.obj-type :
     4148       v-kpp = "" .
     4149       for first buf_clients-attr no-lock where buf_clients-attr.obj-code  = obj-list.obj-code
     4150                                          and   buf_clients-attr.obj-type  = obj-list.obj-type
     4151                                          and   buf_clients-attr.attr-code = 'kpp':U:
