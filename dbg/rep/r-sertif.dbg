      527   define variable v-kol-spice3 as integer no-undo .
      528   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
      529   DEFINE BUTTON StopBtn AUTO-END-KEY
      530        LABEL "Стоп"
      531        SIZE 10 BY 1.
      532   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
      533        LABEL "Обработано записей"
      534         VIEW-AS TEXT
      535        SIZE 14 BY .67 NO-UNDO.
      536   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
      537         VIEW-AS TEXT
      538        SIZE 53.25 BY .67
      539        FGCOLOR 1  NO-UNDO.
      540   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
      541         VIEW-AS TEXT
      542        SIZE 53.25 BY .67
      543        FGCOLOR 1  NO-UNDO.
      544   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
      545         VIEW-AS TEXT
      546        SIZE 53.25 BY .67
      547        FGCOLOR 1  NO-UNDO.
      548   DEFINE RECTANGLE RECT-1
      549        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      550        SIZE 55.13 BY 4.46.
      551   DEFINE FRAME InfoFrame
      552        StopBtn AT ROW 4.25 COL 21.75
      553        RecordsString AT ROW 1.21 COL 2 NO-LABEL
      554        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
      555        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
      556        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
      557        RECT-1 AT ROW 1 COL 1
      558       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      559            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      560            TITLE "Процесс"
      561            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
      562   define variable mFrameView      as logical   no-undo init yes.
      563     define variable mFramHandle as handle no-undo.
      564     mFramHandle = frame InfoFrame:handle.
      565     if  log-manager:logfile-name ne ?
      566     then DO:
      567         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      568         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      569         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
      570     end.
      571     mFrameView = not session:batch-mode and mFramHandle:visible.
      572     if mFrameView
      573     then do:
      574       ASSIGN
      575          FRAME InfoFrame:HIDDEN                           = TRUE
      576          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
      577     end.
      578   ON CHOOSE OF StopBtn IN FRAME InfoFrame
      579   DO:
      580     IF not StopProcessing THEN
      581       Message "Вы действительно хотите прервать" SKIP
      582               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
      583                 UPDATE StopProcessing.
      584     IF StopProcessing THEN do:
      585        if mFrameView
      586        then do:
      587           HIDE FRAME InfoFrame.
      588        end.
      589     End.
      590   END.
