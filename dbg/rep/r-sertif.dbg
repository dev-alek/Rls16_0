     1087   end procedure.
     1088   define variable var-report-r-b as character no-undo .
     1089   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1090   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1091     (output var-report-r-b
     1092     )  .
     1093   do
     1094   on error undo, return error :
     1095     run prn-lib-open-stream  in this-procedure
     1096       ( input parParentProc
     1097       , input 43
     1098       , input yes
     1099       , input no
     1100       ).
     1101     jj = 0 .
     1102     for each sheetf :
     1103       delete sheetf.
     1104     end.
     1105     assign  Counter1 = 0 .
     1106   assign v-account = ( if integer( 25 ) = 0 then 100 else integer( 25 ) ).
     1107     if  log-manager:logfile-name ne ?
     1108     then DO:
     1109         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     1110     end.
     1111     if not session:batch-mode then
     1112     do:
     1113       VIEW FRAME InfoFrame.
     1114       mFrameView = true.
     1115     end.
     1116      v-button-stop = false .
     1117         if mFrameView
     1118         then do:
     1119         if v-button-stop then view STOPBTN in frame InfoFrame.
     1120                          else Hide STOPBTN in frame InfoFrame.
     1121         end.
     1122     assign
     1123       v-tot-chk-sum   = 0
     1124       v-tot-discount  = 0
     1125       v-tot-sum-netto = 0
     1126       v-tot-chk       = 0
     1127       v-log = yes
     1128     .
     1129     if x-date-start > today or x-date-end > today then do :
     1130       message
     1131         "Отчет по сертификатам не может быть снят за будущий период"
     1132       view-as alert-box error.
     1133       undo.
     1134     end.
     1135   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1136     run mainmenu_getcntxt in parparentproc
     1137       (output v-cntxt-db-num
     1138       ,output v-cntxt-userid
     1139       ,output v-cntxt-level
     1140       ,output v-cntxt-host-code-obj
     1141       ,output v-cntxt-obj-type
     1142       ,output v-cntxt-obj-code
     1143       ,output v-cntxt-db-num-obj
     1144       ,output v-cntxt-is-admin
     1145       ) .
     1146     for each obj-list no-lock :
     1147       if v-cntxt-db-num = 0 then do :
     1148         find first buf_clients no-lock
     1149             where buf_clients.obj-type = obj-list.obj-type
     1150               and buf_clients.obj-code = obj-list.obj-code no-error.
     1151         if available buf_clients and buf_clients.db-num <> 0 then do :
     1152           find first ub.db no-lock
     1153               where ub.db.db-num = buf_clients.db-num no-error.
     1154           if available ub.db and ub.db.send-check = no then do :
     1155             message
     1156               "По БД №" buf_clients.db-num " отключена пересылка чеков." skip
     1157               "Данные по объекту " obj-list.obj-type obj-list.obj-code " будут нулевыми." skip
     1158               "Продолжить формирование отчета?" skip
     1159               view-as alert-box question buttons yes-no update v-log
     1160             .
     1161           end.
     1162         end.
     1163       end.
     1164       if v-log = no then do :
     1165         undo.
     1166       end.
     1167        do ii = 1 to num-entries(p-str-nominal):
     1168          if entry(ii,p-str-nominal) = "100%" then do :
     1169                                                v-log-2 = true .
     1170                                              end.
     1171                                              else do :
     1172                                                v-log-2 = false .
     1173                                              end.
     1174          for each buf_chk-doc where
     1175                  buf_chk-doc.obj-code = obj-list.obj-code
     1176              and buf_chk-doc.obj-type = obj-list.obj-type
     1177              and buf_chk-doc.chk-type = 1
     1178              and buf_chk-doc.chk-date >= x-date-start
     1179              and buf_chk-doc.chk-date <= x-date-end no-lock
     1180              :
     1181                if v-log-2 = true then do :
     1182                   find first buf_chk-discnt no-lock
     1183                         where buf_chk-discnt.doc-code = buf_chk-doc.doc-code
     1184                           and buf_chk-discnt.discnt-type = 2
     1185                           and ( buf_chk-discnt.pass-discnt = 0 or buf_chk-discnt.pass-discnt = 1 )
     1186                           and buf_chk-discnt.value-type = 1
     1187                           and buf_chk-discnt.discnt-value-pcnt = 100 no-error.
     1188                end.
     1189                else do :
     1190                   find first buf_chk-discnt no-lock
     1191                         where buf_chk-discnt.doc-code = buf_chk-doc.doc-code
     1192                           and buf_chk-discnt.discnt-type = 2
     1193                           and ( buf_chk-discnt.pass-discnt = 0 or buf_chk-discnt.pass-discnt = 1 )
     1194                           and buf_chk-discnt.value-type  = 2
     1195                           and buf_chk-discnt.discnt-value-abs = decimal(entry(ii,p-str-nominal)) no-error.
     1196                end.
     1197                if available buf_chk-discnt then do :
     1198                   find first buf_clients no-lock
     1199                       where buf_clients.obj-code = buf_chk-doc.cashier-psn-code
     1200                         and buf_clients.obj-type = 'чел':U no-error.
     1201                   create tt-sertif.
     1202                   assign
     1203                     tt-sertif.obj-type        = buf_chk-doc.obj-type
     1204                     tt-sertif.obj-code        = buf_chk-doc.obj-code
     1205                     tt-sertif.cash-num        = buf_chk-doc.pay-desk
     1206                     tt-sertif.cash-chk-num    = buf_chk-doc.chk-num
     1207                     tt-sertif.chk-date        = buf_chk-doc.chk-date
     1208                     tt-sertif.th-chk-num      = buf_chk-doc.doc-code
     1209                     tt-sertif.cashier         = buf_clients.obj-name
     1210                     tt-sertif.chk-sum         = buf_chk-doc.tot-doc
     1211                     tt-sertif.discount        = buf_chk-discnt.discnt-value-abs
     1212                     tt-sertif.other-discount  = buf_chk-doc.discnt - buf_chk-discnt.discnt-value-abs
     1213                     tt-sertif.sum-netto       = buf_chk-doc.netto
     1214                   .
     1215                end.
     1216           end.
     1217        end.
     1218     end.
     1219     for each obj-list no-lock :
     1220       jj = jj + 1.
     1221       find first sheetf where sheetf.sheet-num = jj no-error.
     1222       if not available sheetf then do :
     1223         create sheetf.
     1224         assign
     1225           sheetf.sheet-num = jj
     1226         .
     1227         run print-header(input jj).
     1228         case xsorttype :
     1229           when "sort-cahs-num" then do :
     1230             for each tt-sertif
     1231                 where tt-sertif.obj-code = obj-list.obj-code
     1232                   and tt-sertif.obj-type = obj-list.obj-type
     1233                   break by tt-sertif.obj-code by tt-sertif.obj-type by tt-sertif.cash-num :
     1234                   assign
     1235                     v-tot-chk-sum = v-tot-chk-sum + tt-sertif.chk-sum
     1236                     v-tot-discount = v-tot-discount + tt-sertif.discount
     1237                     v-tot-sum-netto = v-tot-sum-netto + tt-sertif.sum-netto
     1238                     v-tot-chk = v-tot-chk + 1
     1239                   .
     1240               run print-line.
     1241             end.
     1242           end.
     1243           when "sort-cashier" then do :
     1244             for each tt-sertif
     1245                 where tt-sertif.obj-code = obj-list.obj-code
     1246                   and tt-sertif.obj-type = obj-list.obj-type
     1247                   break by tt-sertif.obj-code by tt-sertif.obj-type by tt-sertif.cashier :
     1248                   assign
     1249                     v-tot-chk-sum = v-tot-chk-sum + tt-sertif.chk-sum
     1250                     v-tot-discount = v-tot-discount + tt-sertif.discount
     1251                     v-tot-sum-netto = v-tot-sum-netto + tt-sertif.sum-netto
     1252                     v-tot-chk = v-tot-chk + 1
     1253                   .
     1254               run print-line.
     1255             end.
     1256           end.
     1257           when "sort-disc" then do :
     1258             for each tt-sertif
     1259                 where tt-sertif.obj-code = obj-list.obj-code
     1260                   and tt-sertif.obj-type = obj-list.obj-type
     1261                   break by tt-sertif.obj-code by tt-sertif.obj-type by tt-sertif.discount :
     1262                   assign
     1263                     v-tot-chk-sum   = v-tot-chk-sum + tt-sertif.chk-sum
     1264                     v-tot-discount  = v-tot-discount + tt-sertif.discount
     1265                     v-tot-sum-netto = v-tot-sum-netto + tt-sertif.sum-netto
     1266                     v-tot-chk       = v-tot-chk + 1
     1267                   .
     1268               run print-line.
     1269             end.
     1270           end.
     1271         end case.
     1272         if Make-Excel then  put   stream ForExcel unformatted
     1273               CHR(9)
     1274               CHR(9)
     1275               CHR(9)
     1276               CHR(9)
     1277           "Итого:"             CHR(9)
     1278           v-tot-chk-sum        CHR(9)
     1279           v-tot-discount       CHR(9)
     1280                                CHR(9)
     1281           v-tot-sum-netto      CHR(9)
     1282           skip.
     1283           if Make-Excel then  put   stream ForExcel unformatted
     1284           skip.
     1285           if Make-Excel then  put   stream ForExcel unformatted
     1286           skip.
     1287           if Make-Excel then  put   stream ForExcel unformatted
     1288           "Всего оплачено сертификатами " + string(v-tot-chk) + " чеков" skip.
     1289           if Make-Excel then  put   stream ForExcel unformatted
     1290           "Скидка на общую сумму " + string(v-tot-discount) + " рублей" skip.
     1291         if   Make-Excel Then  do:   Output stream ForExcel close.   assign   number-list = number-list + 1   .   os-delete value( v-excel-file + ".":U + string(number-list)).   Output Stream ForExcel to value( v-excel-file + ".":U + string(number-list ) ) . end.
     1292         assign
     1293           v-tot-chk-sum   = 0
     1294           v-tot-discount  = 0
     1295           v-tot-sum-netto = 0
     1296           v-tot-chk       = 0
     1297         .
     1298       end.
     1299     end.
     1300     if Make-Excel then output stream ForExcel close.
     1301     output stream PrnLibStream close.
     1302   if session :set-wait-state( "" ) then.
     1303     run prn-lib-prn-file in this-procedure (
     1304                                             input parParentProc
     1305                                             ,input 20
     1306                                             ).
     1307   end.
     1308   procedure print-header :
     1309   define input parameter p-page-num as integer no-undo.
     1310   find first sheetf where sheet-num = p-page-num .
     1311       assign
     1312       Sheetf.MergeCellsH = ""
     1313       Sheetf.MergeCellsV = ""
     1314       Sheetf.Excel-Column-Lable = "№ ККМ" + chr(44) +
     1315                            "№ чека по ККМ" + chr(44) +
     1316                            "Дата" + chr(44) +
     1317                            "№ чека в Trade House" + chr(44) +
     1318                            "Кассир" + chr(44) +
     1319                            "Сумма по чеку" + chr(44) +
     1320                            "Сертификат(Скидка)" + chr(44) +
     1321                            "Прочие скидки" + chr(44) +
     1322                            "Сумма оплат (нетто)"
     1323       Sheetf.Sizes = "8,8,14,20,25,25,25,25,25"
     1324       Sheetf.colformat = "1=0;2=0;3=dd/mm/yyyy;4=0;5=@;6=0,00;7=0,00;8=0,00;9=0,00"
     1325       .
     1326     str4 = "По объекту: " + obj-list.obj-type + string(obj-list.obj-code) + " " + obj-list.obj-name.
     1327     RUN rep/extitle.p (p-page-num).
     1328     if p-page-num = 1 then do :
     1329       put stream PrnLibStream unformatted
     1330       reportNAme  + chr(10)
     1331                   + str1 + str4 chr(10)
     1332                   + ReportHeader.
     1333     end.
     1334   end.
     1335   procedure print-line.
     1336   if Make-Excel then  put   stream ForExcel unformatted
     1337      tt-sertif.cash-num        CHR(9)
     1338      tt-sertif.cash-chk-num    CHR(9)
     1339      tt-sertif.chk-date        CHR(9)
     1340      tt-sertif.th-chk-num      CHR(9)
     1341      tt-sertif.cashier         CHR(9)
     1342      tt-sertif.chk-sum         CHR(9)
     1343      tt-sertif.discount        CHR(9)
     1344      tt-sertif.other-discount  CHR(9)
     1345      tt-sertif.sum-netto       CHR(9)
     1346      skip.
     1347   end.
