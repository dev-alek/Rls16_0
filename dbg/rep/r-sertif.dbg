      260   function breakstr returns character ( input        for-name    as character,
      261                                         input        line-length as integer,
      262                                         input-output line1       as character,
      263                                         input-output line2       as character ) :
      264     define variable ii as integer no-undo.
      265     if length( for-name ) > line-length then do:
      266       assign ii    = 1
      267              line1 = "":u
      268              line2 = "":u.
      269       if length( entry( ii, for-name , " ":u ) ) > line-length then do:
      270         assign line1 =       substring( for-name, 1, line-length     )
      271                line2 = trim( substring( for-name,    line-length + 1 ) ).
      272       end.                                                     else do:
      273         do while length( line1 + entry( ii, for-name, " ":u ) ) < ( line-length + 1 ) :
      274           assign line1 = line1 + entry( ii, for-name, " ":u ) + " ":u
      275                  ii    = ii    + 1.
      276           if length( entry( ii, for-name, " ":u ) ) > line-length then do:
      277             assign line1 = line1 + substring( for-name, length( line1 ), line-length - length( line1 ) + 1 ).
      278           end.
      279         end.
      280         assign line2 = trim( substring( for-name, length( line1 ) ) ).
      281       end.
      282     end.                                else do:
      283       assign line1 = for-name
      284              line2 = "":u.
      285     end.
      286     return ( line1 ).
      287   end function.
      288   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      289   procedure cur-time :
      290      define output parameter p-today as date      no-undo .
      291      define output parameter p-time  as integer   no-undo .
      292     do
      293     on error undo, return error
      294     :
      295       define variable v-date1 as date      no-undo .
      296       define variable v-date2 as date      no-undo .
      297       define variable v-time  as integer   no-undo .
      298       assign
      299         v-date1 = today
      300         v-time  = time
      301         v-date2 = today
      302       .
      303       if v-date1 <> v-date2
      304       then do:
      305         assign
      306           v-date1 = today
      307           v-time  = v-time
      308         .
      309       end.
      310       assign
      311         p-today = v-date1
      312         p-time  = v-time
      313       .
      314     end.
      315   end.
      316   function cur-time-date returns character
      317   :
      318     return string(today, '99/99/9999':U) .
      319   end.
      320   function cur-time-mjd returns decimal
      321   :
      322     define variable v-date as date      no-undo .
      323     define variable v-time as integer   no-undo .
      324     run cur-time in this-procedure
      325       (output v-date
      326       ,output v-time
      327       ) .
      328     return integer(v-date) - 2400002 + (v-time / 86400) .
      329   end.
      330   function cur-time-get-ending-index returns integer
      331   (input p-number as integer
      332   )
      333   :
      334     if p-number < 0
      335     or p-number = ?
      336     then do:
      337       return 1 .
      338     end.
      339     define variable v-rest as integer   no-undo .
      340     assign
      341       p-number = p-number modulo 100
      342     .
      343     if p-number < 20
      344     then do:
      345       assign
      346         v-rest = p-number
      347       .
      348     end.
      349     else do:
      350       assign
      351         v-rest = p-number modulo 10
      352       .
      353     end.
      354     case v-rest :
      355       when 1
      356       then do:
      357         return 2 .
      358       end.
      359       when 2 or
      360       when 3 or
      361       when 4
      362       then do:
      363         return 3 .
      364       end.
      365       otherwise do:
      366         return 1 .
      367       end.
      368     end case .
      369   end.
      370   procedure cur-time-mjd-to-date :
      371      define input  parameter i-mjd-diff as decimal no-undo.
      372      define output parameter o-Date     as date    no-undo.
      373      define output parameter o-Time     as integer no-undo.
      374      define variable v-day-number as integer   no-undo .
      375      if    i-mjd-diff < 0
      376         or i-mjd-diff = ?
      377      then do:
      378         return "?" .
      379      end.
      380      assign
      381         v-day-number = truncate(i-mjd-diff,0).
      382         o-Date = date(v-day-number + 2400002).
      383         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      384     .
      385   end.
      386   function cur-time-mjd-to-string returns character
      387   (input p-mjd-diff as decimal
      388   )
      389   :
      390     define variable v-day-number as integer   no-undo .
      391     define variable v-seconds    as integer   no-undo .
      392     define variable v-hour       as integer   no-undo .
      393     define variable v-min        as integer   no-undo .
      394     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      395     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      396     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      397     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      398     if p-mjd-diff < 0
      399     or p-mjd-diff = ?
      400     then do:
      401       return "?" .
      402     end.
      403     assign
      404       v-day-number = integer(truncate(p-mjd-diff,0))
      405       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      406     .
      407     if v-seconds > 86400
      408     then do:
      409       assign
      410         v-seconds = 86400 - 1
      411       .
      412     end.
      413     if v-seconds < 0
      414     then do:
      415       assign
      416         v-seconds = 0
      417       .
      418     end.
      419     assign
      420       v-hour = truncate(v-seconds / 3600, 0)
      421     .
      422     assign
      423       v-seconds = v-seconds modulo 3600
      424     .
      425     assign
      426       v-min = truncate(v-seconds / 60, 0)
      427     .
      428     assign
      429       v-seconds = v-seconds modulo 60
      430     .
      431     return
      432         (if v-day-number <> 0
      433           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      434           else ""
      435         )
      436       + (if v-day-number <> 0 or v-hour <> 0
      437           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      438           else ""
      439         )
      440       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      441           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      442           else ""
      443         )
      444       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      445       .
      446   end.
      447   function cur-time-string returns character
      448   :
      449     define variable v-date as date      no-undo .
      450     define variable v-time as integer   no-undo .
      451     run cur-time in this-procedure
      452       (output v-date
      453       ,output v-time
      454       ) .
      455     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      456   end.
      457   function cur-time-string-sec returns character
      458   :
      459     define variable v-date as date      no-undo .
      460     define variable v-time as integer   no-undo .
      461     run cur-time in this-procedure
      462       (output v-date
      463       ,output v-time
      464       ) .
      465     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      466   end.
      467   function cur-time-custom  returns character
      468   (input p-prefix as character
      469   ,input p-date-format as character
      470   ,input p-delimiter as character
      471   ,input p-time-format as character
      472   ,input p-suffix as character
      473   )
      474   :
      475     define variable v-date as date      no-undo .
      476     define variable v-time as integer   no-undo .
      477     run cur-time in this-procedure
      478       (output v-date
      479       ,output v-time
      480       ) .
      481     return
      482       p-prefix
      483       + string(v-date, p-date-format)
      484       + p-delimiter
      485       + string(v-time, p-time-format)
      486       + p-suffix
      487       .
      488   end.
      489   function cur-time-print  returns character
      490   :
      491     define variable v-date as date      no-undo .
      492     define variable v-time as integer   no-undo .
      493     run cur-time in this-procedure
      494       (output v-date
      495       ,output v-time
      496       ) .
      497     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      498   end.
      499   function cur-time-datetime returns datetime
      500   :
      501     define variable v-char as character no-undo .
      502     define variable v-datetime as datetime no-undo .
      503     v-char = cur-time-string().
      504     v-datetime = datetime(v-char).
      505     return  v-datetime.
      506   end.
      507   function cur-time-string-msec returns character
      508   :
      509     define variable v-date as datetime  no-undo .
      510     v-date = now.
      511     return string(v-date) .
      512   end.
