       52   procedure prn-lib-prn-file :
       53     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
       54     define input parameter p-DIsabledoptions as integer no-undo .
       55     define variable v-report-name as character no-undo .
       56     define variable v-user-action as character no-undo .
       57     define variable v-printed     as logical   no-undo .
       58     define variable v-exist       as logical   no-undo .
       59     do
       60       on error undo, return error
       61       :
       62       run prn-lib-get-report-name  in this-procedure (
       63         input parParentProc
       64         ,output v-report-name
       65         ).
       66   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       67   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
       68     (input  v-report-name
       69     ,input  2
       70     ,output v-exist
       71     )  .
       72       if NOT v-exist then
       73       DO:
       74         Message
       75           "Нет заданий на печать ! "
       76           view-as alert-box .
       77         Return  .
       78       End.
       79       run gbl/prnfilen.w
       80         (input  ""
       81         ,input  p-DisabledOptions
       82         ,input  string(v-report-name )
       83         ,input  7
       84         ,output v-user-action
       85         ,output v-printed
       86         ) .
       87       if v-printed then
       88       do:
       89         return "YES" .
       90       end.
       91       else
       92       do:
       93         return "NO" .
       94       end.
       95     end.
       96   end procedure.
       97   procedure prn-lib-open-stream :
       98     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
       99     define input parameter p-page-size    as integer no-undo .
      100     define input parameter p-is-stream    as logical no-undo .
      101     define input parameter p-append       as logical no-undo .
      102     define variable v-report-name as character no-undo .
      103     do
      104       on error undo, return error
      105       :
      106       run prn-lib-get-report-name  in this-procedure (
      107         input parParentProc
      108         ,output v-report-name
      109         ).
      110       if p-is-stream then
      111       do:
      112         if p-append then
      113         do:
      114           output stream PrnLibStream to value( v-report-name )
      115             page-size value(p-page-size) append .
      116         end.
      117         if not p-append then
      118         do:
      119           output stream PrnLibStream to value( v-report-name )
      120             page-size value(p-page-size) .
      121         end.
      122       end.
      123       if not p-is-stream then
      124       do:
      125         if p-append then
      126         do:
      127           output to value( v-report-name )
      128             page-size value(p-page-size) append .
      129         end.
      130         if not p-append then
      131         do:
      132           output to value( v-report-name )
      133             page-size value(p-page-size) .
      134         end.
      135       end.
      136     end.
      137   end procedure.
      138   procedure prn-lib-open-exp :
      139     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      140     define input parameter p-is-stream    as logical no-undo .
      141     define input parameter p-is-append    as logical no-undo .
      142     define output parameter p-ReportFileName as char init "report" no-undo.
      143     define output parameter p-process as logical no-undo .
      144     define variable glog as logical no-undo .
      145     do
      146       on error undo, return error
      147       :
      148       SYSTEM-DIALOG GET-FILE p-ReportFileName
      149         TITLE      "Укажите путь"
      150         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      151         ASK-OVERWRITE
      152         CREATE-TEST-FILE
      153         SAVE-AS
      154         USE-FILENAME
      155         DEFAULT-EXTENSION "txt"
      156         UPDATE glog
      157         .
      158       if not glog then  return.
      159       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      160       if p-is-stream then
      161       do:
      162         if p-is-append then
      163         do:
      164           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      165         end.
      166         else
      167         do:
      168           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      169         end.
      170       end.
      171       else
      172       do:
      173         if p-is-append then
      174         do:
      175           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      176         end.
      177         else
      178         do:
      179           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      180         end.
      181       end.
      182       p-process = yes.
      183     end.
      184   end procedure.
      185   procedure prn-lib-get-report-name :
