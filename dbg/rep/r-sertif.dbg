      663   .
      664   procedure create_obj-list :
      665      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      666      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      667      do
      668      on error undo, return error return-value
      669      :
      670         define buffer cli-obj for ub.clients .
      671         define variable p-var as integer no-undo .
      672         define buffer buf_obj-list for obj-list .
      673         find last buf_obj-list  use-index pi no-error .
      674         if available buf_obj-list
      675         then
      676            p-var = buf_obj-list.obj-id + 1.
      677         else
      678            p-var = 1.
      679         find first cli-obj where
      680                   cli-obj.obj-type = p-obj-type
      681               and cli-obj.obj-code = p-obj-code
      682         no-lock no-error.
      683         if available cli-obj
      684         then do:
      685            create buf_obj-list.
      686            assign
      687               buf_obj-list.obj-id   = p-var
      688               buf_obj-list.obj-code = cli-obj.obj-code
      689               buf_obj-list.obj-type = cli-obj.obj-type
      690               buf_obj-list.obj-name = cli-obj.obj-name
      691               buf_obj-list.db-num   = cli-obj.db-num
      692            .
      693         end.
      694      end.
      695   end.
