      195   procedure prn-lib-reportviewer :
      196     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      197     define input parameter p-report-name-html as character no-undo .
      198     define input parameter p-param        as character no-undo .
      199     define variable v-excel           as character no-undo init 'TRUE' .
      200     define variable v-value-character as character no-undo .
      201     define variable v-value-integer   as character no-undo .
      202     define variable v-value-date      as date      no-undo .
      203     define variable v-value-decimal   as decimal   no-undo .
      204     define variable rep-excel         as logical   no-undo .
      205     define variable excel-string      as character no-undo .
      206     define variable v-param-type      as character no-undo .
      207     define variable v-tth             as handle    no-undo .
      208     run adm/shattri.p (
      209       input "get":U
      210       ,input  ""
      211       ,input  0
      212       ,input  'report-glob':U
      213       ,input  'rep-excel':U
      214       ,output v-value-character
      215       ,output v-value-date
      216       ,output v-value-decimal
      217       ,output v-value-integer
      218       ,output rep-excel
      219       ,output v-param-type
      220       ,INPUT-OUTPUT table-handle v-tth
      221       )  .
      222     if rep-excel then v-excel = "TRUE" .
      223     else v-excel = "FALSE" .
      224     if p-param eq ""
      225     then
      226        p-param = "EXCEL:" + v-excel.
      227     else
      228        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      229     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      230   end procedure.
