      652   def
      653    shared
      654   temp-table  obj-list no-undo
      655     field obj-type like ub.clients.obj-type
      656     field obj-code like ub.clients.obj-code
      657     field obj-name like ub.clients.obj-name
      658     field obj-id   as integer
