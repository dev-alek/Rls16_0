      608   define new global shared variable g#library  as handle no-undo .
      609   define new global shared variable g#library2 as handle no-undo .
      610   define variable var-report-r-b as character no-undo .
      611   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      612   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      613     (output var-report-r-b
      614     )  .
      615   define variable State-Source as widget-handle no-undo .
      616   define variable Tog-Total as logical   no-undo initial yes label "Только итоги"
      617     view-as toggle-box size-chars 38.25 by 1.00 .
      618   define variable Tog-Obj   as logical   no-undo initial yes label "Раздельно по объектам"
      619     view-as toggle-box size-chars 38.25 by 1.00 .
      620   define variable Tog-Excel as logical   no-undo initial  no label "Только в Excel"
      621     view-as toggle-box size-chars 19.00 by 1.00 fgcolor 4 .
      622   define frame F-Main
      623     Tog-Obj   at row  2.50 col  2.75
      624     Tog-Total at row  4.00 col  2.75
      625     Tog-Excel at row 17.50 col 51.38
      626   with 1 down no-box keep-tab-order overlay side-labels no-underline three-d at col 1 row 1 scrollable .
      627   assign
      628     frame F-Main :scrollable = no
      629     frame F-Main :hidden     = yes
      630   .
      631   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      632   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      633   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      634   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      635   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      636   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      637   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      638   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      639         adm-object-hdl = FRAME F-Main:HANDLE.
      640   RUN ensure-broker.
      641   THIS-PROCEDURE:ADM-DATA =
      642        'ADM1.1~`':U +
      643        'SmartObject~`':U +
      644        '~`':U +
      645        'NO ~`':U +
      646        '~`':U +
      647        '~`':U +
      648        '~`':U +
      649        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      650           + "~`":U +
      651        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
      652        'Record-Source,Record-Target,TableIO-Target~`':U +
      653        '~`':U +
      654        '~`~`~`~`~`~`~`~`~`~`~`':U +
      655        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      656            THEN "^^":U
      657        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      658             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      659   PROCEDURE adm-apply-entry :
      660     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      661   END PROCEDURE.
      662   PROCEDURE adm-destroy :
      663    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      664   END PROCEDURE.
      665   PROCEDURE adm-disable :
      666       DISABLE Tog-Obj Tog-Total WITH FRAME F-Main.
      667       RUN dispatch ('disable-fields':U).
      668       RUN set-attribute-list ('ENABLED=no':U).
      669       RETURN.
      670   END PROCEDURE.
      671   PROCEDURE adm-edit-attribute-list :
      672         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
      673         RETURN.
      674   END PROCEDURE.
      675   PROCEDURE adm-enable :
      676       ENABLE UNLESS-HIDDEN Tog-Obj Tog-Total WITH FRAME F-Main.
      677       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      678       RUN set-attribute-list ('ENABLED=yes':U).
      679       RETURN.
      680   END PROCEDURE.
      681   PROCEDURE adm-exit :
      682        RUN notify ('exit':U).
      683     RETURN.
      684   END PROCEDURE.
      685   PROCEDURE adm-hide :
      686     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      687   END PROCEDURE.
      688   PROCEDURE adm-initialize :
      689     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      690   END PROCEDURE.
      691   PROCEDURE adm-show-errors :
      692       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      693       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      694           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      695       END.
      696       RETURN.
      697   END PROCEDURE.
      698   PROCEDURE adm-UIB-mode :
      699     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      700   END PROCEDURE.
      701   PROCEDURE adm-view :
      702     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      703   END PROCEDURE.
      704   PROCEDURE dispatch :
      705       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      706       RUN broker-dispatch IN adm-broker-hdl
      707           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      708       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      709   END PROCEDURE.
      710   PROCEDURE ensure-broker :
      711   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      712   IF RETURN-VALUE NE "ADM-Broker":U THEN
      713   DO:
      714       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      715       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      716   END.
      717   END PROCEDURE.
      718   PROCEDURE get-attribute :
      719     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      720     RUN broker-get-attribute IN adm-broker-hdl
      721         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      722     RETURN RETURN-VALUE.
      723   END PROCEDURE.
      724   PROCEDURE get-attribute-list :
      725     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      726     RUN broker-get-attribute-list IN adm-broker-hdl
      727         (INPUT THIS-PROCEDURE,
      728          INPUT ?,
      729          OUTPUT p-attr-list) NO-ERROR.
      730     RETURN.
      731   END PROCEDURE.
      732   PROCEDURE new-state :
      733     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      734     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      735     RETURN.
      736   END PROCEDURE.
      737   PROCEDURE notify :
      738     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      739     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      740     IF RETURN-VALUE = "ADM-ERROR":U THEN
      741         RETURN "ADM-ERROR":U.
      742     RETURN.
      743   END PROCEDURE.
      744   PROCEDURE set-attribute-list :
      745     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      746     RUN ensure-broker.
      747     RUN broker-set-attribute-list IN adm-broker-hdl
      748         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      749     RETURN.
      750   END PROCEDURE.
      751   PROCEDURE set-position :
      752       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      753       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      754       IF VALID-HANDLE(adm-object-hdl) THEN
      755       DO:
      756         ASSIGN adm-object-hdl:ROW    =   p-row
      757                adm-object-hdl:COLUMN =   p-col.
      758       END.
      759       RETURN.
      760   END PROCEDURE.
      761   PROCEDURE adm-display-fields :
      762       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
      763       RETURN.
      764   END PROCEDURE.
      765   PROCEDURE adm-open-query :
      766     RETURN.
      767   END PROCEDURE.
      768   PROCEDURE adm-row-changed :
      769         IF VALID-HANDLE(adm-object-hdl) THEN
      770           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      771         RUN notify ('row-available':U).
      772         RETURN.
      773   END PROCEDURE.
      774   PROCEDURE reposition-query :
      775       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
      776       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
      777       RETURN.
      778   END PROCEDURE.
      779     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
      780     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
      781     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
      782     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
      783     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
      784     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
      785     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
      786     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
      787     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      788     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
      789     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      790     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
      791     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
      792     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
      793     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
      794     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
      795     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
      796     IF "":U = "":U THEN
      797       RUN modify-list-attribute IN adm-broker-hdl
      798         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
      799     RUN use-create-on-add(?).
      800   PROCEDURE adm-add-record :
      801       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      802          "must have at least one Enabled Table to perform Add.":U
      803          VIEW-AS ALERT-BOX ERROR.
      804       RETURN.
      805   END PROCEDURE.
      806   PROCEDURE adm-assign-record :
      807    MESSAGE
      808          "Object ":U THIS-PROCEDURE:FILE-NAME
      809            "must have at least one Enabled Table to perform Assign.":U
      810              VIEW-AS ALERT-BOX ERROR.
      811      RETURN.
      812     END PROCEDURE.
      813   PROCEDURE adm-assign-statement :
      814     RETURN.
      815   END PROCEDURE.
      816   PROCEDURE adm-cancel-record :
      817      RETURN.
      818     END PROCEDURE.
      819   PROCEDURE adm-copy-record :
      820       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      821        "must have at least one Enabled Table to perform Copy.":U
      822          VIEW-AS ALERT-BOX ERROR.
      823       RETURN.
      824   END PROCEDURE.
      825   PROCEDURE adm-create-record :
      826      RETURN.
      827   END PROCEDURE.
      828   PROCEDURE adm-current-changed :
      829     RETURN.
      830   END PROCEDURE.
      831   PROCEDURE adm-delete-record :
      832    MESSAGE
      833          "Object ":U THIS-PROCEDURE:FILE-NAME
      834            "must have at least one Enabled Table to perform Delete.":U
      835              VIEW-AS ALERT-BOX ERROR.
      836       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
      837       RETURN.
      838   END PROCEDURE.
      839   PROCEDURE adm-disable-fields :
      840         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
      841       RETURN.
      842   END PROCEDURE.
      843   PROCEDURE adm-enable-fields :
      844       RETURN.
      845   END PROCEDURE.
      846   PROCEDURE adm-end-update :
      847     RETURN.
      848   END PROCEDURE.
      849   PROCEDURE adm-reset-record :
      850       RETURN.
      851   END PROCEDURE.
      852   PROCEDURE adm-update-record :
      853       MESSAGE
      854         "Object ":U THIS-PROCEDURE:FILE-NAME
      855           "must have at least one Enabled Table to perform Update.":U
      856             VIEW-AS ALERT-BOX ERROR.
      857      RETURN.
      858   END PROCEDURE.
      859   PROCEDURE check-modified :
      860   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
      861   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
      862   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
      863   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
      864     IF check-state = "check":U THEN
      865     DO:
      866       RUN get-link-handle IN adm-broker-hdl
      867         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
      868            OUTPUT group-target-list).
      869       IF group-target-list NE "":U THEN
      870       DO i = 1 TO NUM-ENTRIES(group-target-list):
      871         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
      872         RUN check-modified IN curr-widget ('group-check':U).
      873         IF RETURN-VALUE NE "":U THEN
      874         DO:
      875           RUN check-modified-message(RETURN-VALUE).
      876           RETURN "":U.
      877         END.
      878       END.
      879     END.
      880     RETURN "":U.
      881   END PROCEDURE.
      882   PROCEDURE check-modified-message :
      883     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
      884        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
      885           'CONTAINER-SOURCE':U, 'HIDDEN':U).
      886        IF RETURN-VALUE = "YES":U THEN
      887           RUN notify ('view,CONTAINER-SOURCE':U).
      888        MESSAGE IF p-changed-table NE ? THEN
      889           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
      890           ELSE "Current values have been changed."
      891           SKIP "  Do you wish to save those changes?"
      892           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
      893        IF ANS THEN
      894        DO:
      895           IF group-assign-target THEN
      896             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
      897           ELSE RUN dispatch('update-record':U).
      898           IF RETURN-VALUE = "ADM-ERROR":U THEN
      899           DO:
      900               MESSAGE "Changes to the previous record were not saved."
      901                 VIEW-AS ALERT-BOX ERROR.
      902               IF group-assign-target THEN
      903                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      904               ELSE RUN dispatch ('cancel-record':U).
      905           END.
      906        END.
      907        ELSE DO:
      908          IF group-assign-target THEN
      909             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      910          ELSE RUN dispatch('cancel-record':U).
      911        END.
      912        RETURN.
      913   END PROCEDURE.
      914   PROCEDURE get-rowid :
      915       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
      916       ASSIGN
      917       p-table   =   adm-first-table.
      918       RETURN.
      919   END PROCEDURE.
      920   PROCEDURE init-group-assign :
      921       RUN request-attribute IN adm-broker-hdl
      922         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
      923       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
      924         group-assign-target = yes.
      925       ELSE group-assign-target = no.
      926       RETURN.
      927   END PROCEDURE.
      928   PROCEDURE set-editors :
      929       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
      930       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
      931       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
      932       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
      933       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
      934       DO WHILE VALID-HANDLE (curr-widget):
      935           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
      936              curr-widget:HIDDEN = no THEN DO:
      937             CASE p-field-setting:
      938               WHEN "INITIALIZE":U THEN
      939               DO:
      940                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
      941                     read-only-list +
      942                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
      943                        STRING(curr-widget).
      944               END.
      945               WHEN "DISABLE":U OR
      946               WHEN "ENABLE":U THEN
      947               DO:
      948                   curr-widget:SENSITIVE = yes.
      949                   RUN get-attribute ('Read-Only-Editors':U).
      950                   IF RETURN-VALUE = ? OR
      951                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
      952                       curr-widget:READ-ONLY =
      953                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
      954               END.
      955               WHEN "CLEAR":U THEN
      956                   curr-widget:SCREEN-VALUE = "":U.
      957             END CASE.
      958           END.
      959           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
      960       END.
      961       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
      962         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
      963           + '"':U).
      964       RETURN.
      965   END PROCEDURE.
      966   PROCEDURE use-check-modified-all :
      967    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
      968     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
      969     RETURN.
      970   END PROCEDURE.
      971   PROCEDURE use-create-on-add :
      972   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
      973      RETURN.
      974   END PROCEDURE.
      975   PROCEDURE use-initial-lock :
      976     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
      977     ASSIGN adm-initial-lock = p-attr-value.
      978     RETURN.
      979   END PROCEDURE.
      980     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
      981   if not this-procedure :persistent
      982   then do:
      983     message
      984       vss-workfile vss-revision vss-description skip
      985       "Ошибка при запуске процедуры" skip
      986       "Данную процедуру следует запускать только с параметром persistent" skip
      987       view-as alert-box error .
      988     undo, return error .
      989   end.
      990   procedure disable_UI :
      991     hide frame F-Main no-pause .
      992     if this-procedure :persistent
      993     then do:
      994       delete procedure this-procedure .
      995     end.
      996   end procedure.
      997   procedure local-initialize :
      998     run dispatch in this-procedure
      999       ( input 'initialize':U
     1000       ) .
     1001     assign
     1002       Tog-Obj   = yes
     1003       Tog-Total = no
     1004     .
     1005     display
     1006       Tog-Obj
     1007       Tog-Total
     1008     with frame F-Main .
     1009   end procedure.
     1010   procedure my-report :
     1011     run rep/r-wth-dc.p
     1012       ( input my-handle
     1013       , input Tog-Obj
     1014       , input Tog-Total
     1015       ) no-error .
     1016     if error-status :error
     1017     then do:
     1018       message vss-workfile skip( 0 ) vss-date skip( 0 ) vss-revision skip( 1 ) vss-description skip( 1 )
     1019               "Ошибка выполнения отчета" skip( 0 )
     1020               return-value skip( 0 )
     1021               error-status :get-message( 1 ) skip( 1 )
     1022       view-as alert-box error .
     1023     end.
     1024   end procedure.
     1025   procedure my-var :
     1026     define variable l_shift-on as logical no-undo .
     1027     assign frame F-Main Tog-Excel
     1028                                Tog-Obj
     1029                                Tog-Total
     1030     .
     1031     assign
     1032       STR-obj-type = "":U
     1033       STR-obj-code = "":U
     1034       STR-obj-name = "":U
     1035       STR-obj      = "":U
     1036     .
     1037     for each obj-list
     1038     :
     1039   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1040   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1041     (input  obj-list.obj-type
     1042     ,input  obj-list.obj-code
     1043     ,input  'shift-on=request'
     1044     ,output l_shift-on
     1045     ) no-error .
     1046       if error-status :error or
     1047          l_shift-on <> yes
     1048       then do:
     1049         delete obj-list .
     1050         next .
     1051       end.
     1052       assign
     1053         STR-obj-type = STR-obj-type + obj-list.obj-type + ","
     1054         STR-obj-code = STR-obj-code + string( obj-list.obj-code ) + ","
     1055         STR-obj-name = STR-obj-name + obj-list.obj-name + ","
     1056         STR-obj      = STR-obj      + obj-list.obj-type + "#" + string( obj-list.obj-code ) + ","
     1057       .
     1058     end.
     1059     assign
     1060       ReportName   = "Отчет о движении материальных ценностей"
     1061       ReportHeader = "":U
     1062     .
     1063   end procedure.
     1064   procedure state-changed :
     1065     define input parameter p-issuer-hdl as handle    no-undo .
     1066     define input parameter p-state      as character no-undo .
     1067     case p-state :
     1068       when "link-changed":U
     1069       then do:
     1070         run my-var in this-procedure .
     1071       end.
     1072     end case.
     1073   end procedure.
