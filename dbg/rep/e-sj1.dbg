     6457        END CASE .
     6458        if ( namebuf2 <> "" ) OR ( prodbuf2 <> "" ) then
     6459        CASE my-Set_val_type :
     6460          when 2 then  do:
     6461           DISPLAY STREAM PrnLibStream
     6462           namebuf2 @ sj-goods.name
     6463           prodbuf2 @ sj-goods.prod-name
     6464           with FRAME sj-base .
     6465           DOWN STREAM PrnLibStream 1 with FRAME sj-base .
