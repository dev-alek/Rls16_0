     4880             if my-set_val_type = 3  then
     4881             ACCUMULATE
     4882             sj-tots.brutto-sum-r (TOTAL BY sj-tots.prod-name)
     4883             sj-tots.netto-sum-r (TOTAL BY sj-tots.prod-name).
     4884             IF LAST-OF(sj-tots.prod-name) then do:
     4885               CASE my-set_val_type :
