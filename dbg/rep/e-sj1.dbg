     3042             create sj-tots.
     3043             assign
     3044             sj-tots.obj-attr = sj-goods.obj-attr
     3045             sj-tots.grp-name = sj-goods.grp-name
     3046             sj-tots.qnty = ACCUM SUB-TOTAL BY sj-goods.grp-name sj-adv.qnty
     3047             sj-tots.qnty-2 = ACCUM SUB-TOTAL BY sj-goods.grp-name sj-adv.qnty-2
     3048             sj-tots.qnty-3 = ACCUM SUB-TOTAL BY sj-goods.grp-name sj-adv.qnty-3
