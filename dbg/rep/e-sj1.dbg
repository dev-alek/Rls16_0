     6684             ACCUM TOTAL sj-adv.qnty @ sj-adv.qnty
     6685             ACCUM TOTAL sj-adv.brutto-sum @ sj-adv.brutto-sum
     6686             ACCUM TOTAL sj-adv.discnt-sum @ sj-adv.discnt-sum
     6687             (IF (ACCUM TOTAL sj-adv.qnty) <> 0
     6688             THEN
     6689             round( ( ACCUM TOTAL sj-adv.discnt-sum ) /
     6690             ( ACCUM TOTAL sj-adv.brutto-sum ) * 100 , 1 )
     6691             ELSE 0) @ pcnt
     6692             ACCUM TOTAL sj-adv.netto-sum @ sj-adv.netto-sum
     6693             with FRAME sj-base .
