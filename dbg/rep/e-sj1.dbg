     6514           ACCUM SUB-TOTAL BY sj-goods.saleman sj-adv.discnt-sum      @ sj-adv.discnt-sum
     6515           (IF (ACCUM SUB-TOTAL BY sj-goods.saleman sj-adv.qnty) <> 0
     6516           THEN
     6517           round( ( ACCUM SUB-TOTAL BY sj-goods.saleman sj-adv.discnt-sum ) /
     6518           ( ACCUM SUB-TOTAL BY sj-goods.saleman sj-adv.brutto-sum) * 100 , 1 )
     6519           ELSE 0 ) @ pcnt
     6520           ACCUM SUB-TOTAL BY sj-goods.saleman sj-adv.netto-sum   @ sj-adv.netto-sum
     6521           with FRAME sj-base .
