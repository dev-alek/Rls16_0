      979   procedure cur-time :
      980      define output parameter p-today as date      no-undo .
      981      define output parameter p-time  as integer   no-undo .
      982     do
      983     on error undo, return error
      984     :
      985       define variable v-date1 as date      no-undo .
      986       define variable v-date2 as date      no-undo .
      987       define variable v-time  as integer   no-undo .
      988       assign
      989         v-date1 = today
      990         v-time  = time
      991         v-date2 = today
      992       .
      993       if v-date1 <> v-date2
      994       then do:
      995         assign
      996           v-date1 = today
      997           v-time  = v-time
      998         .
      999       end.
     1000       assign
     1001         p-today = v-date1
     1002         p-time  = v-time
     1003       .
     1004     end.
     1005   end.
     1006   function cur-time-date returns character
     1007   :
     1008     return string(today, '99/99/9999':U) .
     1009   end.
     1010   function cur-time-mjd returns decimal
     1011   :
     1012     define variable v-date as date      no-undo .
     1013     define variable v-time as integer   no-undo .
     1014     run cur-time in this-procedure
     1015       (output v-date
     1016       ,output v-time
     1017       ) .
     1018     return integer(v-date) - 2400002 + (v-time / 86400) .
     1019   end.
     1020   function cur-time-get-ending-index returns integer
     1021   (input p-number as integer
     1022   )
     1023   :
     1024     if p-number < 0
     1025     or p-number = ?
     1026     then do:
     1027       return 1 .
     1028     end.
     1029     define variable v-rest as integer   no-undo .
     1030     assign
     1031       p-number = p-number modulo 100
     1032     .
     1033     if p-number < 20
     1034     then do:
     1035       assign
     1036         v-rest = p-number
     1037       .
     1038     end.
     1039     else do:
     1040       assign
     1041         v-rest = p-number modulo 10
     1042       .
     1043     end.
     1044     case v-rest :
     1045       when 1
     1046       then do:
     1047         return 2 .
     1048       end.
     1049       when 2 or
     1050       when 3 or
     1051       when 4
     1052       then do:
     1053         return 3 .
     1054       end.
     1055       otherwise do:
     1056         return 1 .
     1057       end.
     1058     end case .
     1059   end.
     1060   procedure cur-time-mjd-to-date :
     1061      define input  parameter i-mjd-diff as decimal no-undo.
     1062      define output parameter o-Date     as date    no-undo.
     1063      define output parameter o-Time     as integer no-undo.
     1064      define variable v-day-number as integer   no-undo .
     1065      if    i-mjd-diff < 0
     1066         or i-mjd-diff = ?
     1067      then do:
     1068         return "?" .
     1069      end.
     1070      assign
     1071         v-day-number = truncate(i-mjd-diff,0).
     1072         o-Date = date(v-day-number + 2400002).
     1073         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1074     .
     1075   end.
     1076   function cur-time-mjd-to-string returns character
     1077   (input p-mjd-diff as decimal
     1078   )
     1079   :
     1080     define variable v-day-number as integer   no-undo .
     1081     define variable v-seconds    as integer   no-undo .
     1082     define variable v-hour       as integer   no-undo .
     1083     define variable v-min        as integer   no-undo .
     1084     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1085     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1086     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1087     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1088     if p-mjd-diff < 0
     1089     or p-mjd-diff = ?
     1090     then do:
     1091       return "?" .
     1092     end.
     1093     assign
     1094       v-day-number = integer(truncate(p-mjd-diff,0))
     1095       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1096     .
     1097     if v-seconds > 86400
     1098     then do:
     1099       assign
     1100         v-seconds = 86400 - 1
     1101       .
     1102     end.
     1103     if v-seconds < 0
     1104     then do:
     1105       assign
     1106         v-seconds = 0
     1107       .
     1108     end.
     1109     assign
     1110       v-hour = truncate(v-seconds / 3600, 0)
     1111     .
     1112     assign
     1113       v-seconds = v-seconds modulo 3600
     1114     .
     1115     assign
     1116       v-min = truncate(v-seconds / 60, 0)
     1117     .
     1118     assign
     1119       v-seconds = v-seconds modulo 60
     1120     .
     1121     return
     1122         (if v-day-number <> 0
     1123           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1124           else ""
     1125         )
     1126       + (if v-day-number <> 0 or v-hour <> 0
     1127           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1128           else ""
     1129         )
     1130       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1131           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1132           else ""
     1133         )
     1134       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1135       .
     1136   end.
     1137   function cur-time-string returns character
     1138   :
     1139     define variable v-date as date      no-undo .
     1140     define variable v-time as integer   no-undo .
     1141     run cur-time in this-procedure
     1142       (output v-date
     1143       ,output v-time
     1144       ) .
     1145     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1146   end.
     1147   function cur-time-string-sec returns character
     1148   :
     1149     define variable v-date as date      no-undo .
     1150     define variable v-time as integer   no-undo .
     1151     run cur-time in this-procedure
     1152       (output v-date
     1153       ,output v-time
     1154       ) .
     1155     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1156   end.
     1157   function cur-time-custom  returns character
     1158   (input p-prefix as character
     1159   ,input p-date-format as character
     1160   ,input p-delimiter as character
     1161   ,input p-time-format as character
     1162   ,input p-suffix as character
     1163   )
     1164   :
     1165     define variable v-date as date      no-undo .
     1166     define variable v-time as integer   no-undo .
     1167     run cur-time in this-procedure
     1168       (output v-date
     1169       ,output v-time
     1170       ) .
     1171     return
     1172       p-prefix
     1173       + string(v-date, p-date-format)
     1174       + p-delimiter
     1175       + string(v-time, p-time-format)
     1176       + p-suffix
     1177       .
     1178   end.
     1179   function cur-time-print  returns character
     1180   :
     1181     define variable v-date as date      no-undo .
     1182     define variable v-time as integer   no-undo .
     1183     run cur-time in this-procedure
     1184       (output v-date
     1185       ,output v-time
     1186       ) .
     1187     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1188   end.
     1189   function cur-time-datetime returns datetime
     1190   :
     1191     define variable v-char as character no-undo .
     1192     define variable v-datetime as datetime no-undo .
     1193     v-char = cur-time-string().
     1194     v-datetime = datetime(v-char).
     1195     return  v-datetime.
     1196   end.
     1197   function cur-time-string-msec returns character
     1198   :
     1199     define variable v-date as datetime  no-undo .
     1200     v-date = now.
     1201     return string(v-date) .
     1202   end.
     1203   procedure lhistprex-print-gds-list-hist-excel :
     1204   define input parameter p-text  as logical no-undo .
     1205   define input parameter p-excel as logical no-undo .
     1206   define input parameter p-sheet-num as integer no-undo .
     1207   define buffer buf_lh-sheetf for sheetf.
     1208   define buffer buf_gds-list-hist for gds-list-hist.
     1209     do
     1210     on error undo, return error
     1211     :
     1212       find first buf_gds-list-hist no-lock where buf_gds-list-hist.id = 0 no-error .
     1213       if p-excel then do:
     1214         if   Make-Excel Then  do:   Output stream ForExcel close.   assign   number-list = number-list + 1   .   os-delete value( v-excel-file + ".":U + string(number-list)).   Output Stream ForExcel to value( v-excel-file + ".":U + string(number-list ) ) . end.
     1215         FInd first buf_lh-Sheetf where
     1216                   buf_lh-Sheetf.sheet-num = p-sheet-num No-ERROR.
     1217         if not avail buf_lh-sheetf then
     1218         create buf_lh-sheetf.
     1219         assign
     1220         buf_lh-Sheetf.Sheet-num = 2
     1221         buf_lh-sheetf.Excel-Column-Lable =  "№ п/п,Действие,Записей,итого,Множество"
     1222         buf_lh-sheetf.sizes = "9,9,9,12,155"
     1223         .
     1224         run rep/extitlee.p (input p-sheet-num
     1225                       , input  substitute("История создания списка &1 &2"
     1226                                   ,
     1227   ''
     1228                                   ,(if available buf_gds-list-hist
     1229                                   then buf_gds-list-hist.des
     1230                                   else "БЕЗЫМЯННЫЙ"))
     1231                       ) .
     1232       end.
     1233       if p-text then do:
     1234         Page stream PrnLibStream.
     1235         PUT  STREAM PrnLibStream unformatted
     1236         SPACE(25) substitute("История создания списка &1 &2"
     1237                             , ''
     1238                             ,(if available buf_gds-list-hist
     1239                             then buf_gds-list-hist.des
     1240                             else "БЕЗЫМЯННЫЙ")) skip(0)
     1241         space(25) cur-time-print() skip(1)
     1242         .
     1243         put stream PrnLibStream unformatted
     1244         string("№", "X(9)") chr(32)
     1245         string("Действие", "X(9)") chr(32)
     1246         string("записей", "X(9)") chr(32)
     1247         string(" = итого", "X(12)") chr(32)
     1248         (if page-size(PrnLibStream) > 43
     1249         then string("Множество", "X(" + string(136 - 43) + ")")
     1250         else string("Множество", "X(" + string(198 - 43) + ")")
     1251         )
     1252         skip(0)
     1253         fill('-':U, 9) chr(32)
     1254         fill('-':U, 9) chr(32)
     1255         fill('-':U, 9) chr(32)
     1256         fill('-':U, 12) chr(32)
     1257         (if page-size(PrnLibStream) > 43
     1258         then fill('-':U, 136 - 43)
     1259         else fill('-':U, 198 - 43))
     1260         skip(0)
     1261         .
     1262       end.
     1263       for each buf_gds-list-hist where buf_gds-list-hist.id > 0
     1264       by buf_gds-list-hist.id
     1265       :
     1266         if p-text then do:
     1267           put stream PrnLibStream unformatted
     1268           (if buf_gds-list-hist.line = 0
     1269           then string(buf_gds-list-hist.id, ">>>>>>>>9")
     1270           else fill(chr(32) , 9)
     1271           )  chr(32)
     1272           (if buf_gds-list-hist.item_ <> '':U
     1273           then string(buf_gds-list-hist.hist-mode, "X(8)")
     1274           else fill( chr(32), 8)) chr(32)
     1275           string(buf_gds-list-hist.num-add, ">>>>>>>>9") chr(32) chr(32) chr(32) chr(32)
     1276           string(buf_gds-list-hist.num-recs, ">>>>>>>>9")  chr(32)
     1277           (if page-size(PrnLibStream) > 43
     1278           then string(buf_gds-list-hist.des, "X(" + string(136 - 43) + ")")
     1279           else string(buf_gds-list-hist.des, "X(" + string(198 - 43) + ")"))
     1280           skip.
     1281         end.
     1282         if p-excel then do:
     1283           if Make-Excel then  put   stream ForExcel unformatted
     1284           (if buf_gds-list-hist.line = 0
     1285           then string(buf_gds-list-hist.id, ">>>>>>>>9")
     1286           else '':U)
     1287           CHR(9)
     1288           (if buf_gds-list-hist.item_ <> '':U
     1289           then buf_gds-list-hist.hist-mode
     1290           else '':U)  CHR(9)
     1291           (if buf_gds-list-hist.item_ <> '':U
     1292           then string(buf_gds-list-hist.num-add, "->>>>>>>>9")
     1293           else '':U)  CHR(9)
     1294           (if buf_gds-list-hist.item_ <> '':U
     1295           then string(buf_gds-list-hist.num-recs, ">>>>>>>>9")
     1296           else '':U)  CHR(9)
     1297           buf_gds-list-hist.des
     1298           skip.
     1299         end.
     1300       end.
     1301     end.
     1302   end procedure.
