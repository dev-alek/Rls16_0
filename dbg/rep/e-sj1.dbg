     4940       if ( line-counter(PrnLibStream) + 7 ) > page-size(PrnLibStream) then page stream PrnLibStream.
     4941       CASE my-set_val_type :
     4942         when 2 then do:
     4943           if OneLinePrinted then
     4944           PUT STREAM PrnLibStream  LINE format ("X(" + string(138) + ")") SKIP.
     4945           DISPLAY STREAM PrnLibStream
     4946           substitute("ИТОГО ч- &1", v-num-chk) @ sj-goods.name
     4947           ACCUM TOTAL sj-adv.qnty @ sj-adv.qnty
     4948           ACCUM TOTAL sj-adv.brutto-sum @ sj-adv.brutto-sum
     4949           ACCUM TOTAL sj-adv.discnt-sum @ sj-adv.discnt-sum
     4950           (IF (ACCUM TOTAL sj-adv.qnty) <> 0 THEN
     4951           round( ( ACCUM TOTAL sj-adv.discnt-sum ) /
     4952                       ( ACCUM TOTAL sj-adv.brutto-sum ) * 100 , 1 ) ELSE 0) @ pcnt
     4953           ACCUM TOTAL sj-adv.netto-sum @ sj-adv.netto-sum
     4954               with FRAME sj-base .
     4955           DOWN STREAM PrnLibStream 1 with FRAME sj-base .
     4956           DISPLAY STREAM PrnLibStream
     4957           (string(round((ACCUM TOTAL sj-adv.qnty) / v-num-chk, 2)) + "/ч")  @ sj-adv.qnty
     4958           with FRAME sj-base .
     4959           DOWN STREAM PrnLibStream 1 with FRAME sj-base .
     4960           UNDERLINE STREAM PrnLibStream
     4961           sj-goods.b-code
     4962           sj-goods.artic
     4963           sj-goods.name
     4964           sj-adv.qnty
     4965           sj-adv.brutto-sum
     4966           sj-adv.discnt-sum
     4967           pcnt
     4968           sj-adv.netto-sum
     4969           with FRAME sj-base .
     4970         end.
     4971         when 3 then do:
     4972           if OneLinePrinted then
     4973           PUT STREAM PrnLibStream LINE  SKIP.
     4974           DISPLAY STREAM PrnLibStream
     4975           substitute("ИТОГО ч- &1", v-num-chk) @ sj-goods.name
     4976           ACCUM TOTAL sj-adv.qnty @ sj-adv.qnty
     4977           ACCUM TOTAL sj-adv.brutto-sum @ sj-adv.brutto-sum
     4978           ACCUM TOTAL sj-adv.brutto-sum-r @ sj-adv.brutto-sum-r
     4979           ACCUM TOTAL sj-adv.discnt-sum @ sj-adv.discnt-sum
     4980           (IF (ACCUM TOTAL sj-adv.qnty) <> 0 THEN
     4981           round( ( ACCUM TOTAL sj-adv.discnt-sum ) /
     4982                       ( ACCUM TOTAL sj-adv.brutto-sum ) * 100 , 1 ) ELSE 0) @ pcnt
     4983           ACCUM TOTAL sj-adv.netto-sum @ sj-adv.netto-sum
     4984           ACCUM TOTAL sj-adv.netto-sum-r @ sj-adv.netto-sum-r
     4985           with FRAME sj-full .
     4986           DOWN STREAM PrnLibStream 1 with FRAME sj-full .
     4987           DISPLAY STREAM PrnLibStream
     4988           (string(round((ACCUM TOTAL sj-adv.qnty) / v-num-chk, 2)) + "/ч") @ sj-adv.qnty
     4989           with FRAME sj-full .
     4990           DOWN STREAM PrnLibStream 1 with FRAME sj-full .
     4991           UNDERLINE STREAM PrnLibStream
     4992           sj-goods.b-code
     4993           sj-goods.artic
     4994           sj-goods.name
     4995           sj-adv.qnty
     4996           sj-adv.brutto-sum
     4997           sj-adv.brutto-sum-r
     4998           sj-adv.discnt-sum pcnt
     4999           sj-adv.netto-sum
     5000           sj-adv.netto-sum-r
     5001           with FRAME sj-full .
     5002         end.
     5003       END CASE .
     5004       if ObjsQnty = 1 then
     5005       PUT STREAM PrnLibStream
     5006       " " SKIP(1) space(10)
     5007       "Директор ______________" format "X(50)"
     5008       "Кассир ___________________" format "X(50)" SKIP .
     5009     end.
     5010     END.
     5011   end.
     5012   END PROCEDURE.
     5013   PROCEDURE SimpleProc.
     5014   define variable v-salesman-name as character no-undo .
     5015   define buffer buf_saleman for ub.clients.
     5016   define variable vss-include-info44 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5017   if SHRs-sort = "Article":U then do:
     5018     if SHBySalers then do:
     5019         FOR EACH sj-goods NO-LOCK,
     5020             EACH sj-adv NO-LOCK WHERE
     5021                   sj-adv.obj-attr = sj-goods.obj-attr AND
     5022                   sj-adv.b-code = sj-goods.b-code AND
     5023                   sj-adv.saleman = sj-goods.saleman
     5024             BREAK BY sj-goods.obj-attr
     5025                   BY sj-goods.saleman
     5026                   BY sj-goods.artic
     5027                   BY sj-goods.b-code
     5028                   BY sj-adv.price
     5029                   :
     5030   define variable vss-include-info45 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5031   if first( sj-goods.obj-attr ) then do:
     5032     if v-curr-r-b = 'base':U then do:
     5033                           if my-set_val_type = 2  then
     5034                               DOWN STREAM PrnLibStream 1 with FRAME sj-base .
     5035                           else
     5036                               DOWN STREAM PrnLibStream 1 with FRAME sj-full .
     5037     end.
     5038     else do:
     5039                               DOWN STREAM PrnLibStream 1 with FRAME sj-base .
     5040     end.
     5041   end.
     5042                   if first-of( sj-goods.obj-attr ) AND ( ObjsQnty > 1 ) then  do:
     5043                           assign
     5044                           strbuf1 = substr( sj-goods.obj-attr, 1, 3 )
     5045                           intbuf1 = integer( substr( sj-goods.obj-attr, 4 ) ) .
     5046                           FIND FIRST cli-obj WHERE
     5047                                      cli-obj.obj-type = strbuf1 AND
     5048                                      cli-obj.obj-code = intbuf1 NO-LOCK .
     5049                           PUT STREAM PrnLibStream
     5050                           cli-obj.obj-name format "x(120)" SKIP.
     5051   if v-curr-r-b = 'base':U then do:
     5052                           if my-set_val_type = 2  then
     5053                           UNDERLINE STREAM PrnLibStream
     5054                           sj-goods.artic
     5055                           sj-goods.name
     5056                           with FRAME sj-base .
     5057                           else
     5058                           UNDERLINE STREAM PrnLibStream
     5059                           sj-goods.artic
     5060                           sj-goods.name
     5061                           with FRAME sj-full .
     5062   end.
     5063   else do:
     5064                           UNDERLINE STREAM PrnLibStream
     5065                           sj-goods.artic
     5066                           sj-goods.name
     5067                           with FRAME sj-base .
     5068   end.
     5069                       end.
     5070   define variable vss-include-info46 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5071       ACCUMULATE
     5072       sj-adv.qnty (TOTAL)
     5073       sj-adv.qnty-2 (TOTAL)
     5074       sj-adv.qnty-3 (TOTAL)
     5075       sj-adv.brutto-sum (TOTAL)
     5076       sj-adv.discnt-sum (TOTAL)
     5077       sj-adv.netto-sum (TOTAL)
     5078       sj-adv.brutto-sum-r (TOTAL)
     5079       sj-adv.netto-sum-r (TOTAL)
     5080       sj-adv.num-docs (TOTAL)
     5081       sj-adv.num-lines (TOTAL)
     5082       sj-adv.qnty ( SUB-TOTAL BY sj-goods.obj-attr )
     5083       sj-adv.qnty-2 ( SUB-TOTAL BY sj-goods.obj-attr )
     5084       sj-adv.qnty-3 ( SUB-TOTAL BY sj-goods.obj-attr )
     5085       sj-adv.brutto-sum ( SUB-TOTAL BY sj-goods.obj-attr )
     5086       sj-adv.discnt-sum ( SUB-TOTAL BY sj-goods.obj-attr )
     5087       sj-adv.netto-sum ( SUB-TOTAL BY sj-goods.obj-attr )
     5088       sj-adv.brutto-sum-r ( SUB-TOTAL BY sj-goods.obj-attr )
     5089       sj-adv.netto-sum-r ( SUB-TOTAL BY sj-goods.obj-attr )
     5090       sj-adv.qnty ( SUB-TOTAL BY sj-adv.price )
     5091       sj-adv.qnty-2 ( SUB-TOTAL BY sj-adv.price )
     5092       sj-adv.qnty-3 ( SUB-TOTAL BY sj-adv.price )
     5093       sj-adv.brutto-sum ( SUB-TOTAL BY sj-adv.price )
     5094       sj-adv.discnt-sum ( SUB-TOTAL BY sj-adv.price )
     5095       sj-adv.netto-sum ( SUB-TOTAL BY sj-adv.price )
     5096       sj-adv.brutto-sum-r ( SUB-TOTAL BY sj-adv.price )
     5097       sj-adv.netto-sum-r ( SUB-TOTAL BY sj-adv.price )
     5098       sj-adv.qnty ( SUB-TOTAL BY sj-goods.saleman )
     5099       sj-adv.qnty-2 ( SUB-TOTAL BY sj-goods.saleman )
     5100       sj-adv.qnty-3 ( SUB-TOTAL BY sj-goods.saleman )
     5101       sj-adv.brutto-sum ( SUB-TOTAL BY sj-goods.saleman )
     5102       sj-adv.discnt-sum ( SUB-TOTAL BY sj-goods.saleman )
     5103       sj-adv.netto-sum ( SUB-TOTAL BY sj-goods.saleman )
     5104       sj-adv.brutto-sum-r ( SUB-TOTAL BY sj-goods.saleman )
     5105       sj-adv.netto-sum-r ( SUB-TOTAL BY sj-goods.saleman )
     5106       sj-adv.num-docs (SUB-TOTAL BY sj-goods.saleman )
     5107       sj-adv.num-lines (SUB-TOTAL BY sj-goods.saleman )
     5108       .
     5109   if sj-goods.twounit = 0 then do:
     5110     if last-of ( sj-adv.price ) AND SHRs-by <> 0 then do:
     5111       namebuf1 = get-strokes(buffer sj-goods, 18, 21,
     5112                              input-output namebuf1,
     5113                              input-output namebuf2,
     5114                              input-output prodbuf1,
     5115                              input-output prodbuf2).
     5116       CASE my-Set_val_type :
     5117       when 2 then  do:
     5118         DISPLAY STREAM PrnLibStream
     5119         sj-goods.b-code
     5120         sj-goods.artic
     5121         namebuf1 @ sj-goods.name
     5122         prodbuf1 @ sj-goods.prod-name
     5123         ACCUM SUB-TOTAL BY sj-adv.price sj-adv.qnty @ sj-adv.qnty
     5124         sj-adv.price
     5125         ACCUM SUB-TOTAL BY sj-adv.price sj-adv.brutto-sum @ sj-adv.brutto-sum
     5126         ACCUM SUB-TOTAL BY sj-adv.price sj-adv.discnt-sum @ sj-adv.discnt-sum
     5127         (IF (ACCUM SUB-TOTAL BY sj-adv.price sj-adv.qnty) <> 0
     5128         THEN
     5129         round( ( ACCUM SUB-TOTAL BY sj-adv.price sj-adv.discnt-sum ) /
     5130         ( ACCUM SUB-TOTAL BY sj-adv.price sj-adv.brutto-sum ) * 100 , 1 )
     5131         else 0)  @ pcnt
     5132         ACCUM SUB-TOTAL BY sj-adv.price sj-adv.netto-sum @ sj-adv.netto-sum
     5133         with FRAME sj-base .
     5134         DOWN STREAM PrnLibStream 1 with FRAME sj-base .
     5135        end.
     5136        when 3 then do:
     5137         DISPLAY STREAM PrnLibStream
     5138         sj-goods.b-code
     5139         sj-goods.artic
     5140         namebuf1 @ sj-goods.name
     5141         prodbuf1 @ sj-goods.prod-name
     5142         ACCUM SUB-TOTAL BY  sj-adv.price  sj-adv.qnty @ sj-adv.qnty
     5143         sj-adv.price
     5144         ACCUM SUB-TOTAL BY  sj-adv.price  sj-adv.brutto-sum @ sj-adv.brutto-sum
     5145         ACCUM SUB-TOTAL BY  sj-adv.price  sj-adv.brutto-sum-r @ sj-adv.brutto-sum-r
     5146         ACCUM SUB-TOTAL BY  sj-adv.price  sj-adv.discnt-sum @ sj-adv.discnt-sum
     5147         (IF (ACCUM SUB-TOTAL BY  sj-adv.price  sj-adv.qnty) <> 0
     5148         THEN
     5149         round( ( ACCUM SUB-TOTAL BY  sj-adv.price  sj-adv.discnt-sum ) /
     5150         ( ACCUM SUB-TOTAL BY  sj-adv.price  sj-adv.brutto-sum ) * 100, 1 )
     5151         ELSE 0 ) @ pcnt
     5152         ACCUM SUB-TOTAL BY  sj-adv.price  sj-adv.netto-sum @ sj-adv.netto-sum
     5153         ACCUM SUB-TOTAL BY  sj-adv.price  sj-adv.netto-sum-r @ sj-adv.netto-sum-r
     5154         with FRAME sj-full .
     5155         DOWN STREAM PrnLibStream 1 with FRAME sj-full .
     5156        end.
     5157        END CASE .
     5158        if ( namebuf2 <> "" ) OR ( prodbuf2 <> "" ) then
     5159        CASE my-Set_val_type :
     5160          when 2 then  do:
     5161           DISPLAY STREAM PrnLibStream
     5162           namebuf2 @ sj-goods.name
     5163           prodbuf2 @ sj-goods.prod-name
     5164           with FRAME sj-base .
     5165           DOWN STREAM PrnLibStream 1 with FRAME sj-base .
     5166         end.
     5167         when 3 then do:
     5168           DISPLAY STREAM PrnLibStream
     5169           namebuf2 @ sj-goods.name
     5170           prodbuf2 @ sj-goods.prod-name
     5171           with FRAME sj-full .
     5172           DOWN STREAM PrnLibStream 1 with FRAME sj-full .
     5173         end.
     5174       END CASE .
     5175       OneLinePrinted = TRUE .
     5176     end .
     5177   end.
     5178     if last-of( sj-goods.saleman ) AND SHBySalers then do:
     5179       v-salesman-name = '':U.
     5180       if entry(2, sj-goods.saleman, chr(4)) <> string(0) then do:
     5181         find first buf_saleman where
     5182                   buf_saleman.obj-type = 'чел':U
     5183               AND buf_saleman.obj-code = integer(entry(2, sj-goods.saleman, chr(4))) no-error .
     5184         if not available buf_saleman then do:
     5185           v-salesman-name = '':U.
     5186         end.
     5187         else do:
     5188           v-salesman-name = buf_saleman.obj-name.
     5189         end.
     5190       end.
     5191       CASE my-Set_val_type :
