     3035     if last-of( sj-goods.grp-name ) AND grouptot_flag then do:
     3036       IF AllObjsTotalsBy  then do:
     3037         FIND FIRST sj-tots WHERE
     3038                    sj-tots.obj-attr = sj-goods.obj-attr AND
