     4898                   sj-tots.prod-name  @ sj-goods.name
     4899                   ACCUM TOTAL BY sj-tots.prod-name sj-tots.qnty    @ sj-adv.qnty
     4900                   ACCUM TOTAL BY sj-tots.prod-name sj-tots.brutto-sum      @ sj-adv.brutto-sum
     4901                   ACCUM TOTAL BY sj-tots.prod-name sj-tots.discnt-sum      @ sj-adv.discnt-sum
     4902                   round( ( ACCUM TOTAL BY sj-tots.prod-name sj-tots.discnt-sum ) /
     4903                          ( ACCUM TOTAL BY sj-tots.prod-name sj-tots.brutto-sum) * 100 , 1 )
     4904                                   @ pcnt
     4905                   ACCUM TOTAL BY sj-tots.prod-name sj-tots.netto-sum   @ sj-adv.netto-sum
     4906                   with FRAME sj-base .
