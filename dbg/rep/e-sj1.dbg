     6491       CASE my-Set_val_type :
     6492         when 2 then  do:
     6493           UNDERLINE STREAM PrnLibStream
     6494           sj-goods.b-code
     6495           sj-goods.artic
     6496           sj-goods.name
     6497           sj-adv.qnty
     6498           sj-adv.brutto-sum
     6499           sj-adv.discnt-sum
     6500           pcnt
     6501           sj-adv.netto-sum
