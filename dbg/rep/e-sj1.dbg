     2589     end.
     2590   end.
     2591                   if first-of( sj-goods.obj-attr ) AND ( ObjsQnty > 1 ) then  do:
     2592                           assign
     2593                           strbuf1 = substr( sj-goods.obj-attr, 1, 3 )
     2594                           intbuf1 = integer( substr( sj-goods.obj-attr, 4 ) ) .
     2595                           FIND FIRST cli-obj WHERE
