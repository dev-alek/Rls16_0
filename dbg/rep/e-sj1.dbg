     6678         end.
     6679         if ( line-counter(PrnLibStream) + 7 ) > page-size(PrnLibStream) then page stream PrnLibStream .
     6680         CASE my-Set_val_type :
     6681           when 2 then do:
     6682             DISPLAY STREAM PrnLibStream
