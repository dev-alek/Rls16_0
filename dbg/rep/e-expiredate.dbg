     1783        SelectGood AT ROW 5.5 COL 3.25 NO-LABEL WIDGET-ID 390
     1784        period-control AT ROW 5.5 COL 50 NO-LABEL WIDGET-ID 418
     1785        BUTTON-node AT ROW 6.58 COL 43 WIDGET-ID 402
     1786        BUTTON-prod AT ROW 7.63 COL 43 WIDGET-ID 406
     1787        f-period AT ROW 8.5 COL 69 COLON-ALIGNED NO-LABEL WIDGET-ID 428
     1788        BUTTON-gds AT ROW 8.67 COL 43 WIDGET-ID 398
     1789        Goods-Editor AT ROW 10.67 COL 3.25 NO-LABEL WIDGET-ID 412
     1790        expired-goods AT ROW 11.79 COL 49 WIDGET-ID 92
     1791        F-button-1 AT ROW 2.75 COL 1 COLON-ALIGNED NO-LABEL WIDGET-ID 372
     1792        TEXT-1 AT ROW 4.25 COL 11 COLON-ALIGNED NO-LABEL WIDGET-ID 414
     1793        TEXT-2 AT ROW 4.25 COL 49.75 COLON-ALIGNED NO-LABEL WIDGET-ID 426
     1794        Goods-count AT ROW 9.92 COL 3.25 NO-LABEL WIDGET-ID 432
     1795        RECT-8 AT ROW 4.5 COL 2 WIDGET-ID 416
     1796        RECT-9 AT ROW 4.5 COL 48.5 WIDGET-ID 430
     1797        SPACE(2.99) SKIP(2.07)
     1798       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1799            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1800            TITLE "Отчёт по срокам годности маркированного товара" WIDGET-ID 100.
     1801   FUNCTION stat-line RETURNS CHARACTER
     1802       (input p-status-chr as character )  FORWARD.
     1803   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     1804   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     1805   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     1806   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     1807   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     1808   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     1809   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     1810   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     1811         adm-object-hdl = FRAME Dialog-Frame:HANDLE.
     1812   RUN ensure-broker.
     1813   THIS-PROCEDURE:ADM-DATA =
     1814        'ADM1.1~`':U +
     1815        'Dialog-Box~`':U +
     1816        '~`':U +
     1817        'NO ~`':U +
     1818        '~`':U +
     1819        '~`':U +
     1820        '~`':U +
     1821        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     1822           + "~`":U +
     1823        '?~`':U +
     1824        '~`':U +
     1825        '~`':U +
     1826        '~`~`~`~`~`~`~`~`~`~`~`':U +
     1827        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1828            THEN "^^":U
     1829        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1830             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1831   PROCEDURE adm-apply-entry :
     1832     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1833   END PROCEDURE.
     1834   PROCEDURE adm-destroy :
     1835    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1836   END PROCEDURE.
     1837   PROCEDURE adm-disable :
     1838       DISABLE b-exit RECT-8 RECT-9 BUTTON-1 Btn_OK i-exit SelectGood period-control BUTTON-node BUTTON-prod BUTTON-gds Goods-Editor expired-goods F-button-1 TEXT-1 TEXT-2 Goods-count WITH FRAME Dialog-Frame.
     1839       RUN dispatch ('disable-fields':U).
     1840       RUN set-attribute-list ('ENABLED=no':U).
     1841       RETURN.
     1842   END PROCEDURE.
     1843   PROCEDURE adm-edit-attribute-list :
     1844      MESSAGE "There is no attribute list dialog for this object.":U
     1845             VIEW-AS ALERT-BOX WARNING.
     1846         RETURN.
     1847   END PROCEDURE.
     1848   PROCEDURE adm-enable :
     1849       ENABLE UNLESS-HIDDEN b-exit RECT-8 RECT-9 BUTTON-1 Btn_OK i-exit SelectGood period-control BUTTON-node BUTTON-prod BUTTON-gds Goods-Editor expired-goods F-button-1 TEXT-1 TEXT-2 Goods-count WITH FRAME Dialog-Frame.
     1850       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     1851       RUN set-attribute-list ('ENABLED=yes':U).
     1852       RETURN.
     1853   END PROCEDURE.
     1854   PROCEDURE adm-exit :
     1855        RUN notify ('exit':U).
     1856     RETURN.
     1857   END PROCEDURE.
     1858   PROCEDURE adm-hide :
     1859     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1860   END PROCEDURE.
     1861   PROCEDURE adm-initialize :
     1862     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1863   END PROCEDURE.
     1864   PROCEDURE adm-show-errors :
     1865       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1866       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1867           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1868       END.
     1869       RETURN.
     1870   END PROCEDURE.
     1871   PROCEDURE adm-UIB-mode :
     1872     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1873   END PROCEDURE.
     1874   PROCEDURE adm-view :
     1875     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1876   END PROCEDURE.
     1877   PROCEDURE dispatch :
     1878       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1879       RUN broker-dispatch IN adm-broker-hdl
     1880           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1881       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1882   END PROCEDURE.
     1883   PROCEDURE ensure-broker :
     1884   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1885   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1886   DO:
     1887       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1888       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1889   END.
     1890   END PROCEDURE.
     1891   PROCEDURE get-attribute :
     1892     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1893     RUN broker-get-attribute IN adm-broker-hdl
     1894         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1895     RETURN RETURN-VALUE.
     1896   END PROCEDURE.
     1897   PROCEDURE get-attribute-list :
     1898     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1899     RUN broker-get-attribute-list IN adm-broker-hdl
     1900         (INPUT THIS-PROCEDURE,
     1901          INPUT ?,
     1902          OUTPUT p-attr-list) NO-ERROR.
     1903     RETURN.
     1904   END PROCEDURE.
     1905   PROCEDURE new-state :
     1906     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1907     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1908     RETURN.
     1909   END PROCEDURE.
     1910   PROCEDURE notify :
     1911     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1912     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1913     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1914         RETURN "ADM-ERROR":U.
     1915     RETURN.
     1916   END PROCEDURE.
     1917   PROCEDURE set-attribute-list :
     1918     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1919     RUN ensure-broker.
     1920     RUN broker-set-attribute-list IN adm-broker-hdl
     1921         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1922     RETURN.
     1923   END PROCEDURE.
     1924   PROCEDURE set-position :
     1925       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1926       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1927       IF VALID-HANDLE(adm-object-hdl) THEN
     1928       DO:
     1929         ASSIGN adm-object-hdl:ROW    =   p-row
     1930                adm-object-hdl:COLUMN =   p-col.
     1931       END.
     1932       RETURN.
     1933   END PROCEDURE.
     1934   PROCEDURE adm-display-fields :
     1935       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
     1936       RETURN.
     1937   END PROCEDURE.
     1938   PROCEDURE adm-open-query :
     1939     RETURN.
     1940   END PROCEDURE.
     1941   PROCEDURE adm-row-changed :
     1942         IF VALID-HANDLE(adm-object-hdl) THEN
     1943           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1944         RUN notify ('row-available':U).
     1945         RETURN.
     1946   END PROCEDURE.
     1947   PROCEDURE reposition-query :
     1948       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
     1949       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
     1950       RETURN.
     1951   END PROCEDURE.
     1952     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
     1953     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
     1954     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
     1955     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
     1956     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
     1957     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
     1958     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
     1959     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
     1960     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1961     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
     1962     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1963     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
     1964     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
     1965     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
     1966     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
     1967     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
     1968     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
     1969     IF "":U = "":U THEN
     1970       RUN modify-list-attribute IN adm-broker-hdl
     1971         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
     1972     RUN use-create-on-add(?).
     1973   PROCEDURE adm-add-record :
     1974       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1975          "must have at least one Enabled Table to perform Add.":U
     1976          VIEW-AS ALERT-BOX ERROR.
     1977       RETURN.
     1978   END PROCEDURE.
     1979   PROCEDURE adm-assign-record :
     1980    MESSAGE
     1981          "Object ":U THIS-PROCEDURE:FILE-NAME
     1982            "must have at least one Enabled Table to perform Assign.":U
     1983              VIEW-AS ALERT-BOX ERROR.
     1984      RETURN.
     1985     END PROCEDURE.
     1986   PROCEDURE adm-assign-statement :
     1987     RETURN.
     1988   END PROCEDURE.
     1989   PROCEDURE adm-cancel-record :
     1990      RETURN.
     1991     END PROCEDURE.
     1992   PROCEDURE adm-copy-record :
     1993       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1994        "must have at least one Enabled Table to perform Copy.":U
     1995          VIEW-AS ALERT-BOX ERROR.
     1996       RETURN.
     1997   END PROCEDURE.
     1998   PROCEDURE adm-create-record :
     1999      RETURN.
     2000   END PROCEDURE.
     2001   PROCEDURE adm-current-changed :
     2002     RETURN.
     2003   END PROCEDURE.
     2004   PROCEDURE adm-delete-record :
     2005    MESSAGE
     2006          "Object ":U THIS-PROCEDURE:FILE-NAME
     2007            "must have at least one Enabled Table to perform Delete.":U
     2008              VIEW-AS ALERT-BOX ERROR.
     2009       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
     2010       RETURN.
     2011   END PROCEDURE.
     2012   PROCEDURE adm-disable-fields :
     2013         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
     2014       RETURN.
     2015   END PROCEDURE.
     2016   PROCEDURE adm-enable-fields :
     2017       RETURN.
     2018   END PROCEDURE.
     2019   PROCEDURE adm-end-update :
     2020     RETURN.
     2021   END PROCEDURE.
     2022   PROCEDURE adm-reset-record :
     2023       RETURN.
     2024   END PROCEDURE.
     2025   PROCEDURE adm-update-record :
     2026       MESSAGE
     2027         "Object ":U THIS-PROCEDURE:FILE-NAME
     2028           "must have at least one Enabled Table to perform Update.":U
     2029             VIEW-AS ALERT-BOX ERROR.
     2030      RETURN.
     2031   END PROCEDURE.
     2032   PROCEDURE check-modified :
     2033   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     2034   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     2035   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     2036   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     2037     IF check-state = "check":U THEN
     2038     DO:
     2039       RUN get-link-handle IN adm-broker-hdl
     2040         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     2041            OUTPUT group-target-list).
     2042       IF group-target-list NE "":U THEN
     2043       DO i = 1 TO NUM-ENTRIES(group-target-list):
     2044         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     2045         RUN check-modified IN curr-widget ('group-check':U).
     2046         IF RETURN-VALUE NE "":U THEN
     2047         DO:
     2048           RUN check-modified-message(RETURN-VALUE).
     2049           RETURN "":U.
     2050         END.
     2051       END.
     2052     END.
     2053     RETURN "":U.
     2054   END PROCEDURE.
     2055   PROCEDURE check-modified-message :
     2056     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     2057        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     2058           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     2059        IF RETURN-VALUE = "YES":U THEN
     2060           RUN notify ('view,CONTAINER-SOURCE':U).
     2061        MESSAGE IF p-changed-table NE ? THEN
     2062           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     2063           ELSE "Current values have been changed."
     2064           SKIP "  Do you wish to save those changes?"
     2065           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     2066        IF ANS THEN
     2067        DO:
     2068           IF group-assign-target THEN
     2069             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     2070           ELSE RUN dispatch('update-record':U).
     2071           IF RETURN-VALUE = "ADM-ERROR":U THEN
     2072           DO:
     2073               MESSAGE "Changes to the previous record were not saved."
     2074                 VIEW-AS ALERT-BOX ERROR.
     2075               IF group-assign-target THEN
     2076                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     2077               ELSE RUN dispatch ('cancel-record':U).
     2078           END.
     2079        END.
     2080        ELSE DO:
     2081          IF group-assign-target THEN
     2082             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     2083          ELSE RUN dispatch('cancel-record':U).
     2084        END.
     2085        RETURN.
     2086   END PROCEDURE.
     2087   PROCEDURE get-rowid :
     2088       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     2089       ASSIGN
     2090       p-table   =   adm-first-table.
     2091       RETURN.
     2092   END PROCEDURE.
     2093   PROCEDURE init-group-assign :
     2094       RUN request-attribute IN adm-broker-hdl
     2095         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     2096       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     2097         group-assign-target = yes.
     2098       ELSE group-assign-target = no.
     2099       RETURN.
     2100   END PROCEDURE.
     2101   PROCEDURE set-editors :
     2102       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     2103       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     2104       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     2105       ASSIGN curr-widget = FRAME Dialog-Frame:CURRENT-ITERATION.
     2106       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     2107       DO WHILE VALID-HANDLE (curr-widget):
     2108           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     2109              curr-widget:HIDDEN = no THEN DO:
     2110             CASE p-field-setting:
     2111               WHEN "INITIALIZE":U THEN
     2112               DO:
     2113                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     2114                     read-only-list +
     2115                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     2116                        STRING(curr-widget).
     2117               END.
     2118               WHEN "DISABLE":U OR
     2119               WHEN "ENABLE":U THEN
     2120               DO:
     2121                   curr-widget:SENSITIVE = yes.
     2122                   RUN get-attribute ('Read-Only-Editors':U).
     2123                   IF RETURN-VALUE = ? OR
     2124                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     2125                       curr-widget:READ-ONLY =
     2126                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     2127               END.
     2128               WHEN "CLEAR":U THEN
     2129                   curr-widget:SCREEN-VALUE = "":U.
     2130             END CASE.
     2131           END.
     2132           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     2133       END.
     2134       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     2135         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     2136           + '"':U).
     2137       RETURN.
     2138   END PROCEDURE.
     2139   PROCEDURE use-check-modified-all :
     2140    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     2141     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     2142     RETURN.
     2143   END PROCEDURE.
     2144   PROCEDURE use-create-on-add :
     2145   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     2146      RETURN.
     2147   END PROCEDURE.
     2148   PROCEDURE use-initial-lock :
     2149     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     2150     ASSIGN adm-initial-lock = p-attr-value.
     2151     RETURN.
     2152   END PROCEDURE.
     2153   ASSIGN
     2154          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     2155          FRAME Dialog-Frame:HIDDEN           = TRUE.
     2156   ASSIGN
     2157          BUTTON-gds:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     2158   ASSIGN
     2159          BUTTON-node:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     2160   ASSIGN
     2161          Goods-Editor:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     2162   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     2163   DO:
     2164           APPLY "END-ERROR":U TO SELF.
     2165       END.
     2166   ON CHOOSE OF Btn_OK IN FRAME Dialog-Frame
     2167   DO:
     2168               assign
     2169                   SelectGood
     2170                   expired-goods
     2171                   .
     2172                run rep/r-expireDate.p(input parParentProc,
     2173                   input SelectGood,
     2174                   input integer(f-period),
     2175                   input expired-goods
     2176                   ) .
     2177       END.
     2178   ON CHOOSE OF BUTTON-gds IN FRAME Dialog-Frame
     2179   DO:
     2180           define variable ref-list       as character no-undo.
     2181           define variable vRecId         as recid     no-undo.
     2182           define variable vAnswer        as logical   no-undo.
     2183           define variable vI             as integer   no-undo.
     2184           define variable v-seq          as integer   no-undo .
     2185           define variable num-rec        as integer   init 0 no-undo.
     2186           define variable v-bh           as handle    no-undo .
     2187           define variable v-recs         as integer   no-undo .
     2188           define variable v-temp-seq     as integer   no-undo .
     2189           define variable v-line         as integer   no-undo .
     2190           define variable v-item         as character no-undo .
     2191           define variable v-tot-lns      as integer   no-undo .
     2192           define variable v-ref-rec      as recid     no-undo .
     2193           define variable dsp-rs         as character no-undo .
     2194           define variable rs-status      as character no-undo init 'текущие':U.
     2195           define variable v-tbl-name     as character no-undo .
     2196           define variable rs-list-method as character no-undo init "goods".
     2197           define variable tot-lns        as integer   init ? no-undo.
     2198           define variable v-no-hist      as integer   no-undo init -1.
     2199           define variable v-first        as logical   no-undo .
     2200               run ref/gds-ref.p (
     2201                   input parParentProc
     2202                   ,input "b-mark,b-sel"
     2203                   ,input 'все':U
     2204                   ,input 'все':U
     2205                   ,input ?
     2206                   ,input ?
     2207                   ,input ?
     2208                   ,input ?
     2209                   ,input ?
     2210                   ,input v-cntxt-obj-type
     2211                   ,input v-cntxt-obj-code
     2212                   ,input ?
     2213                   ,output ref-list).
     2214               if ref-list = "" and can-find(first gds-list) then
     2215               do:
     2216                   message
     2217                       "Не было выбрано ни одного товара. Очистить список ранее выбранных товаров?"
     2218                       view-as alert-box QUESTION buttons YES-NO update vAnswer.
     2219                   if not vAnswer then return.
     2220                   else do:
     2221                       empty temp-table gds-list .
     2222                       empty temp-table gds-list-hist .
     2223                   end.
     2224               end.
     2225               find first gds-list no-error .
     2226               if available (gds-list) then v-first = true .
     2227               if ref-list <> "" then
     2228               do:
     2229                   empty temp-table gds-list .
     2230                   empty temp-table gds-list-hist .
     2231                   v-recs = num-entries (ref-list).
     2232                   _next:
     2233                   do num-rec = 0 to v-recs:
     2234                       if v-recs = 1 then
     2235                       do:
     2236                           num-rec = 1 .
     2237                       end.
     2238                       if num-rec > 0 then
     2239                       do:
     2240                           v-ref-rec = integer (entry (num-rec, ref-list)).
     2241                           find goods where recid (goods) = v-ref-rec no-lock.
     2242                           find first gds-list where gds-list.gds-code = goods.gds-code no-error .
     2243                           if not available (gds-list) then do:
     2244                           create gds-list .
     2245                           buffer-copy goods to gds-list .
     2246                           end.
     2247                           else next _next .
     2248                       end.
     2249                       if v-recs = 1 then
     2250                       do:
     2251                           assign
     2252                               v-temp-seq = v-seq
     2253                               v-line     = 0
     2254                               v-item     = '':U
     2255                               v-tbl-name = 'goods':U
     2256                               v-bh       = buffer goods:handle
     2257                               v-tot-lns  = tot-lns
     2258                               .
     2259                               if not v-first then dsp-rs     = substitute("Товар :&1 &2", goods.gds-name, stat-line(rs-status)) .
     2260                               else dsp-rs     = substitute("Товар :&1 ", goods.gds-name) .
     2261                       end.
     2262                       else
     2263                       do:
     2264                           if num-rec = 0 then
     2265                           do:
     2266                               if not v-first then do:
     2267                               assign
     2268                                   v-temp-seq = v-seq
     2269                                   v-line     = 0
     2270                                   v-item     = '':U
     2271                                   v-tbl-name = '':U
     2272                                   v-bh       = ?
     2273                                   v-tot-lns  = tot-lns
     2274                                   .
     2275                                   dsp-rs     = substitute("Товары : &1", stat-line(rs-status)) .
     2276                               end.
     2277                           end.
     2278                           else
     2279                           do:
     2280                               assign
     2281                                   v-temp-seq = v-seq - 1
     2282                                   v-line     = num-rec
     2283                                   dsp-rs     = substitute("&1 ", goods.gds-name)
     2284                                   v-item     = '':U
     2285                                   v-tbl-name = 'goods':U
     2286                                   v-bh       = buffer goods:handle
     2287                                   v-tot-lns  = tot-lns + num-rec
     2288                                   .
     2289                           end.
     2290                       end.
     2291                       v-no-hist = (if num-rec = 1 then 0 else num-rec).
     2292                       if dsp-rs <> "" then do:
     2293                       run create-gds-list-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     2294                           , input-output v-temp-seq
     2295                           , input v-line
     2296                           , input '':U
     2297                           , input dsp-rs
     2298                           , input v-tot-lns
     2299                           , input rs-list-method
     2300                           , input rs-status
     2301                           , input v-item
     2302                           , input v-tbl-name
     2303                           , input v-bh
     2304                           ).
     2305                       if num-rec = 0 or v-recs = 1 then v-seq  = v-temp-seq.
     2306                       end.
     2307                   end.
     2308               end.
     2309           lns-cnt = 0 .
     2310           for each gds-list :
     2311               lns-cnt = lns-cnt + 1 .
     2312           end.
     2313           define variable v-i as integer no-undo .
     2314           s-notes =  "" .
     2315           for each gds-list-hist :
     2316               v-i = v-i + 1 .
     2317               s-notes = s-notes + chr(10) + gds-list-hist.hist-mode +  gds-list-hist.des .
     2318               if v-i > 10 then
     2319               do:
     2320                   s-notes = s-notes + " ... " .
     2321                   leave.
     2322               end.
     2323           end.
     2324           run display-count-other in this-procedure .
     2325       END.
     2326   ON CHOOSE OF BUTTON-node IN FRAME Dialog-Frame
     2327   DO:
     2328           run ref/gds-grp.w
     2329               (             input my-handle
     2330               ,input "b-sel,b-mark"
     2331               ,input v-cntxt-obj-type
     2332               ,input v-cntxt-obj-code
     2333               ,input-output gdsgrp_recids ).
     2334           run display-count-other in this-procedure .
     2335       END.
     2336   ON CHOOSE OF BUTTON-prod IN FRAME Dialog-Frame
     2337   DO:
     2338           define variable v-ind as integer no-undo .
     2339           define buffer cli-prod for ub.clients .
     2340           define variable cli-grp_recids as character no-undo .
     2341           FOR EACH g#cli :
     2342               delete g#cli .
     2343           END .
     2344           if SelectGood:screen-value = "3" then
     2345           do:
     2346               run ref/cli-all.w
     2347                   ( my-handle
     2348                   , "b-sel,b-mark"
     2349                   , 'про':U
     2350                   , 'все':U
     2351                   , 'текущие':U
     2352                   , ?
     2353                   , ",,,,,,NO,,"
     2354                   , ?
     2355                   , output cli-grp_recids ) no-error .
     2356               if error-status :error then
     2357                   message vss-workfile vss-revision vss-description skip
     2358                       error-status :get-message(1) skip
     2359                       "Ошибка вызова cli-all.w"
     2360                       view-as alert-box error .
     2361               if cli-grp_recids = "" then
     2362               do:
     2363                   Assign
     2364                       goods-count  = ''
     2365                       Goods-Editor = ''.
     2366                   Display goods-count Goods-Editor with frame Dialog-Frame .
     2367               end.
     2368               else
     2369               do:
     2370                   DO v-ind = 1 TO num-entries( cli-grp_recids )
     2371                       :
     2372                       FIND cli-prod WHERE recid( cli-prod ) = int( entry(v-ind, cli-grp_recids ) ) NO-LOCK.
     2373                       create g#cli.
     2374                       assign
     2375                           g#cli.obj-type = cli-prod.obj-type
     2376                           g#cli.obj-code = cli-prod.obj-code
     2377                           g#cli.obj-name = cli-prod.obj-name.
     2378                   END.
     2379               end.
     2380           end.
     2381           else
     2382           do:
     2383               FOR EACH g#cli :
     2384                   delete g#cli .
     2385               END .
     2386               cli-grp_recids = "" .
     2387           end.
     2388           run display-count-other in this-procedure .
     2389       END.
     2390   ON VALUE-CHANGED OF f-period IN FRAME Dialog-Frame
     2391   DO:
     2392           assign f-period .
     2393       END.
     2394   ON CHOOSE OF i-exit IN FRAME Dialog-Frame
     2395   DO:
     2396           APPLY "choose" TO btn_ok.
     2397       END.
     2398   ON VALUE-CHANGED OF period-control IN FRAME Dialog-Frame
     2399   DO:
     2400           assign period-control .
     2401           case period-control:
     2402               when 0 then
     2403                   do:
     2404                       hide f-period in frame Dialog-Frame .
     2405                       f-period = "3" .
     2406                   end.
     2407               when 1 then
     2408                   do:
     2409                       hide f-period in frame Dialog-Frame .
     2410                       f-period = "7" .
     2411                   end.
     2412               when 2 then
     2413                   do:
     2414                       hide f-period in frame Dialog-Frame .
     2415                       f-period = "14" .
     2416                   end.
     2417               when 3 then
     2418                   do:
     2419                       enable f-period with frame Dialog-Frame .
     2420                   end.
     2421           end case .
     2422       END.
     2423   ON VALUE-CHANGED OF SelectGood IN FRAME Dialog-Frame
     2424   DO:
     2425           run val-goods in this-procedure .
     2426           RUN new-state ("SELECTGOOD="  + String(SelectGood:screen-value)).
     2427       END.
     2428     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     2429   MAIN-BLOCK:
     2430   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2431       ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2432       RUN enable_UI.
     2433       hide BUTTON-node button-gds BUTTON-prod in frame Dialog-Frame .
     2434       WAIT-FOR GO OF FRAME Dialog-Frame.
     2435   END.
     2436   RUN disable_UI.
     2437   PROCEDURE disable_UI :
     2438       HIDE FRAME Dialog-Frame.
     2439   END PROCEDURE.
     2440   PROCEDURE enable_UI :
     2441       DISPLAY SelectGood period-control expired-goods Goods-Editor F-button-1
     2442           TEXT-1 TEXT-2
     2443           WITH FRAME Dialog-Frame.
     2444       ENABLE b-exit Btn_OK BUTTON-1 i-exit RECT-8 RECT-9 SelectGood period-control
     2445           expired-goods Goods-Editor F-button-1
     2446           TEXT-1 TEXT-2
     2447           WITH FRAME Dialog-Frame.
     2448       VIEW FRAME Dialog-Frame.
     2449   END PROCEDURE.
     2450   FUNCTION customerName RETURNS CHARACTER
     2451       ( p-dogovor as character) :
     2452       define variable ii    as integer   no-undo .
     2453       define variable name_ as character no-undo .
     2454       define buffer buf_contract for ub.contract .
     2455       do ii = 1 to num-entries(p-dogovor):
     2456           find first buf_contract no-lock where buf_contract.contract-code = integer(entry(ii,p-dogovor,",")) no-error .
     2457           if available (buf_contract) then
     2458           do:
     2459               name_ = name_ + ", " + buf_contract.contract-prn-code .
     2460           end.
     2461       end.
     2462       if name_ <> "" then name_ = trim(name_,",") .
     2463       RETURN name_ .
     2464   END FUNCTION.
     2465   PROCEDURE val-goods :
     2466       If temp-param-goods <> "" THEN
     2467       DO:
     2468           assign
     2469               Goods-Editor = ''
     2470               goods-count = ''
     2471               .
     2472           Case Integer(SelectGood:screen-value IN frame Dialog-Frame):
     2473               When 1 then
     2474                   DO:
     2475                       hide BUTTON-gds BUTTON-node BUTTON-prod in frame Dialog-Frame .
     2476                       Goods-Editor = " По всем товарам ".
     2477                   End.
     2478               When 2 then
     2479                   DO:
     2480                       hide BUTTON-gds BUTTON-prod in frame Dialog-Frame .
     2481                       enable BUTTON-node  with frame Dialog-Frame .
     2482                   End.
     2483                When 4 then
     2484                   DO:
     2485                       hide BUTTON-node BUTTON-prod in frame Dialog-Frame .
     2486                       enable BUTTON-gds with frame Dialog-Frame .
     2487                   END.
     2488                When 3 then
     2489                   DO:
     2490                       hide BUTTON-node BUTTON-gds in frame Dialog-Frame .
     2491                       enable BUTTON-prod with frame Dialog-Frame .
     2492                   END.
     2493           End case.
     2494           enable Goods-Editor  with frame Dialog-Frame.
     2495           display Goods-Editor goods-count with frame Dialog-Frame.
     2496       End.
     2497       Else  hide Goods-Editor in frame Dialog-Frame.
     2498   END PROCEDURE.
     2499   FUNCTION stat-line RETURNS CHARACTER(input p-status-chr as character):
     2500       DEFINE VARIABLE var-stat-line as character no-undo .
     2501       CASE p-status-chr:
     2502           when 'все':U then
     2503               do:
     2504                   assign
     2505                       var-stat-line = "(текущие и неактивные товары)"
     2506                       .
     2507               end.
     2508           when 'текущие':U then
     2509               do:
     2510                   assign
     2511                       var-stat-line = "(текущие товары)"
     2512                       .
     2513               end.
     2514           when 'удаленные':U then
     2515               do:
     2516                   assign
     2517                       var-stat-line = "(неактивные товары)"
     2518                       .
     2519               end.
     2520       END CASE.
     2521       return var-stat-line .
     2522   END.
     2523   PROCEDURE Display-count :
     2524   if SelectGood = 6 then
     2525       do:
     2526           Assign
     2527               goods-count  = '(Выбрано ' + string(lns-cnt) + ' список)'
     2528               Goods-Editor = s-notes
     2529               .
     2530       end.
     2531       else
     2532       do:
     2533           If can-find (First gds-list no-lock)
     2534               then
     2535               Assign
     2536                   goods-count  = '(Выбрано ' + string(lns-cnt) + ' товаров)'
     2537                   Goods-Editor = s-notes
     2538                   .
     2539           else
     2540               Assign
     2541                   goods-count  = ''
     2542                   Goods-Editor = ''
     2543                   .
     2544       end.
     2545       Display goods-count Goods-Editor with frame Dialog-Frame .
     2546       x-Goods-Editor = Goods-Editor.
     2547   END PROCEDURE.
     2548   PROCEDURE Display-count-OTHER :
     2549       x-SelectGood = Integer(SelectGood:screen-value IN frame Dialog-Frame).
     2550       run sel-x-selectgood in this-procedure .
     2551       if LENGTH (t-str) > 6000 then
     2552       do:
     2553           Assign
     2554               Goods-Editor = substring(T-str ,1, 6000) + chr(10) + "выборка для просмотра обрезана - слишком много записей " .
     2555       end.
     2556       else Assign  Goods-Editor = T-str  .
     2557       Display goods-count Goods-Editor with frame Dialog-Frame .
     2558       x-Goods-Editor = Goods-Editor.
     2559   END PROCEDURE.
     2560   PROCEDURE sel-x-SelectGood :
     2561       define variable grp_name as char.
     2562       define buffer buf_gds-grp for ub.gds-grp .
     2563       define variable my-c as int no-undo.
     2564       IF temp-param-goods <> "" THEN
     2565       DO:
     2566           Case x-SelectGood :
     2567               When 1 then
     2568                   t-str = " По всем товарам ".
     2569               When 2 then
     2570                   DO:
     2571                       t-str = " По группам "  .
     2572                       For each  tmp#grp :
     2573                           delete tmp#grp.
     2574                       End.
     2575                       define variable v-ind as integer no-undo .
     2576                       Repeat v-ind = 1 To num-entries( gdsgrp_recids )
     2577                           :
     2578                           find first buf_gds-grp WHERE recid ( buf_gds-grp ) = integer ( Entry(v-ind,gdsgrp_recids )) NO-LOCK.
     2579                           RUN grplib-get-full-name in this-procedure( input buf_gds-grp.node-code, output Grp_Name ).
     2580                           if Grp_Name <> ? Then
     2581                               if LENGTH(t-str) <= 6000 then t-str = t-str + chr(10) + "     " + Grp_Name .
     2582                           Create tmp#grp.
     2583                           Assign
     2584                               tmp#grp.node-code = buf_gds-grp.node-code
     2585                               tmp#grp.grp-name  = Grp_Name
     2586                               tmp#grp.is-term   = buf_gds-grp.is-term
     2587                               tmp#grp.lvl-num   = buf_gds-grp.lvl-num
     2588                               .
     2589                       end.
     2590                       if num-entries( gdsgrp_recids ) > 0 THEN
     2591                           goods-count = "выбрано " + string(num-entries( gdsgrp_recids )) + " групп " .
     2592                       ELSE goods-count = "НЕ выбрано !!!".
     2593                   End.
     2594               When 3 then
     2595                   DO:
     2596                       t-str = ''.
     2597                       t-str = " По производителям " .
     2598                       my-c = 0.
     2599                       for each g#cli no-lock:
     2600                           if LENGTH(t-str) <= 6000 then t-str = t-str + chr(10) + "     " + g#cli.obj-name .
     2601                           my-c =  my-c + 1 .
     2602                       End.
     2603                       if my-c > 0 THEN
     2604                           goods-count = "выбрано " + String(my-c) .
     2605                       ELSE goods-count = "НЕ выбрано !!!".
     2606                   END.
     2607               When 4 then
     2608                   DO:
     2609                       if can-find (first gds-list no-lock ) then
     2610                       DO:
     2611                           t-str = " По списку товаров " +  s-Notes.
     2612                           goods-count = "выбрано " + String(lns-cnt) .
     2613                       End.
     2614                       Else Assign goods-count = "НЕ выбрано !!!" t-str       = "" lns-cnt     = 0 .
     2615                   End.
     2616               When  6  then
     2617                   DO:
     2618                       if  keep-spis <> "" then
     2619                       DO:
     2620                           t-str = s-Notes.
     2621                           goods-count = "выбрано списков : " + String(lns-cnt) .
     2622                       End.
     2623                       Else Assign goods-count = "НЕ выбрано !!!" t-str       = "" lns-cnt     = 0 .
     2624                   End.
     2625               When 5 then
     2626                   DO:
     2627                       find first gds-list no-lock no-error.
     2628                       if available gds-list THEN  Assign t-str       = " " +  gds-list.gds-name goods-count = "выбран 1 товар".
     2629                       ELSE Assign t-str       = "" goods-count = "НЕ выбрано !!!" lns-cnt     = 0 .
     2630                   END.
     2631               When 7 then
     2632                   DO:
     2633                       t-str = " По группам "  .
     2634                       For each  tmp#grp :
     2635                           delete tmp#grp.
     2636                       End.
     2637                       Repeat v-ind = 1 To num-entries( gdsgrp_recids ):
     2638                           find first buf_gds-grp WHERE recid ( buf_gds-grp ) = integer ( Entry(v-ind,gdsgrp_recids )) NO-LOCK.
     2639                           run grplib-get-full-name in this-procedure ( input buf_gds-grp.node-code, output Grp_Name ).
     2640                           if Grp_Name <> ? Then
     2641                               if LENGTH(t-str) <= 6000 then t-str = t-str + chr(10) + "     " + Grp_Name .
     2642                           Create tmp#grp.
     2643                           Assign
     2644                               tmp#grp.node-code = buf_gds-grp.node-code
     2645                               tmp#grp.grp-name  = Grp_Name
     2646                               tmp#grp.is-term   = buf_gds-grp.is-term
     2647                               tmp#grp.lvl-num   = buf_gds-grp.lvl-num
     2648                               .
     2649                       end.
     2650                       t-str = t-str + chr(10) +  " По производителям " .
     2651                       my-c = 0.
     2652                       for each g#cli no-lock:
     2653                           t-str = t-str + chr(10) + "     " + g#cli.obj-name no-error .
     2654                           my-c =  my-c + 1 .
     2655                       End.
     2656                       if num-entries( gdsgrp_recids ) > 0  and my-c > 0 THEN
     2657                       DO:
     2658                           goods-count = "выбрано " + string(num-entries( gdsgrp_recids )) + " групп "
     2659                               + string(my-c) + " производителей " .
     2660                       End.
     2661                       ELSE goods-count = "НЕ выбрано !!!".
     2662                   End.
     2663           End case.
     2664       END.
     2665   END PROCEDURE.
     2666   PROCEDURE select-keep-spis :
     2667       define input  parameter p-keep-spis as character no-undo .
     2668       define buffer buf_clob-bind for ub.clob-bind  .
     2669       keep-spis = p-keep-spis.
     2670       find first buf_clob-bind no-lock where
     2671           buf_clob-bind.field-name_ = keep-spis no-error .
     2672       if available buf_clob-bind then
     2673       do:
     2674           keep-spis = buf_clob-bind.field-name_ .
     2675           lns-cnt = 1 .
     2676           s-notes = substitute("Хранимый Файл списка : &1 &2", buf_clob-bind.field-name, buf_clob-bind.descr ).
     2677       end.
     2678       else
     2679       do:
     2680           keep-spis = "".
     2681           lns-cnt = 0 .
     2682           s-notes = " " .
     2683       end.
     2684       run display-count       in this-procedure .
     2685       run display-count-other in this-procedure .
     2686       selectgood    = 6 .
     2687       x-selectgood  = 6 .
     2688       run val-goods in this-procedure .
     2689   END PROCEDURE.
