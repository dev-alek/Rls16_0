      587   procedure grplib-get-full-name :
      588      define input parameter p-node-code  as integer      no-undo.
      589      define output parameter p-full-name as character    no-undo.
      590      do
      591   on error undo, return error
      592   :
      593       define variable v-upper-code    as integer           no-undo.
      594       define buffer buf_gds-grp       for ub.gds-grp.
      595       define buffer buf_upper_gds-grp for ub.gds-grp.
      596       find first buf_gds-grp no-lock
      597            where buf_gds-grp.node-code = p-node-code
      598       no-error.
      599       if not available buf_gds-grp
      600       then do:
      601           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      602       end.
      603       assign
      604           p-full-name  = ""
      605           v-upper-code = 1
      606       .
      607       do while buf_gds-grp.upper-code <> 0
      608       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
      609       :
      610           assign
      611               p-full-name  = buf_gds-grp.node-name
      612                            + (if p-full-name <> "" then chr(47) else "")
      613                            + p-full-name
      614               v-upper-code = buf_gds-grp.upper-code
      615           .
      616           find first buf_gds-grp no-lock
      617                where buf_gds-grp.node-code = v-upper-code
      618           no-error.
      619           if not available buf_gds-grp
      620           then do:
      621               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
      622                                   + string( v-upper-code )
      623                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      624           end.
      625       end.
      626       assign
      627       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      628       .
      629   end.
      630   end .
      631   procedure grplib-get-node-from-full-name :
      632   define input parameter p-full-name as character no-undo .
      633   define output parameter p-node-code as integer no-undo .
      634   define variable v-ii as integer no-undo .
      635   define variable v-upper-code as integer no-undo .
      636   define variable v-root-code as integer no-undo .
      637   define variable v-entry as character no-undo .
      638   define buffer buf_gds-grp       for ub.gds-grp.
      639   do
      640   on error undo, return error
      641   :
      642     find first buf_gds-grp no-lock
      643         where buf_gds-grp.upper-code = 0
      644     no-error .
      645     if not available buf_gds-grp
      646     then do:
      647         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
      648     end.
      649     else do:
      650       assign
      651       v-root-code = buf_gds-grp.node-code
      652       .
      653     end.
      654     v-upper-code = v-root-code.
      655     do v-ii = 1 to num-entries(p-full-name, chr(47)):
      656       assign
      657       v-entry = entry(v-ii, p-full-name, chr(47)).
      658       if v-entry = '' then leave.
      659       find first buf_gds-grp no-lock where
      660                 buf_gds-grp.node-name = v-entry
      661             and buf_gds-grp.upper-code = v-upper-code
      662             no-error.
      663       if not available buf_gds-grp then do:
      664         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
      665       end.
      666       else do:
      667         p-node-code = buf_gds-grp.node-code.
      668         v-upper-code = buf_gds-grp.node-code.
      669       end.
      670     end.
      671   end.
      672   end .
