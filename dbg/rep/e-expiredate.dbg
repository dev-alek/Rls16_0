     1722   DEFINE BUTTON i-exit
     1723        IMAGE-UP FILE "cmp/i-run.bmp":U
     1724        IMAGE-DOWN FILE "cmp/i-run.bmp":U
     1725        IMAGE-INSENSITIVE FILE "cmp/i-rund.bmp":U
     1726        LABEL ""
