     1728   DEFINE VARIABLE Goods-Editor AS CHARACTER
     1729        VIEW-AS EDITOR MAX-CHARS 32000 SCROLLBAR-VERTICAL
     1730        SIZE 42.75 BY 1.96
     1731        FONT 4 NO-UNDO.
     1732   DEFINE VARIABLE F-button-1 AS CHARACTER FORMAT "X(256)":U INITIAL "Параметры"
     1733         VIEW-AS TEXT
     1734        SIZE 13 BY .67 TOOLTIP "Параметры" NO-UNDO.
     1735   DEFINE VARIABLE f-period AS CHARACTER FORMAT "X(256)":U initial "7"
     1736        VIEW-AS FILL-IN
     1737        SIZE 5 BY 1 NO-UNDO.
     1738   DEFINE VARIABLE Goods-count AS CHARACTER FORMAT "X(30)":U
     1739         VIEW-AS TEXT
     1740        SIZE 42.75 BY .67
     1741        FGCOLOR 1 FONT 4 NO-UNDO.
     1742   DEFINE VARIABLE TEXT-1 AS CHARACTER FORMAT "X(256)":U INITIAL "Выбор товара"
     1743         VIEW-AS TEXT
     1744        SIZE 14 BY .67
     1745        FGCOLOR 4  NO-UNDO.
     1746   DEFINE VARIABLE TEXT-2 AS CHARACTER FORMAT "X(256)":U INITIAL "Период контроля"
     1747         VIEW-AS TEXT
     1748        SIZE 16.5 BY .67
     1749        FGCOLOR 4  NO-UNDO.
     1750   DEFINE VARIABLE period-control AS INTEGER INITIAL 1
     1751        VIEW-AS RADIO-SET VERTICAL
     1752        RADIO-BUTTONS
     1753             "3 дня", 0,
     1754   "7 дней", 1,
     1755   "14 дней", 2,
     1756   "Свой вариант", 3
