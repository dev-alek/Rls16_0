      995           , input i-host-code
      996           , input-output p-rid-list ) no-error .
      997   end.
      998   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      999   def var vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1000   procedure gen-key-rec :
     1001     define input  parameter p-tbl-name    as character no-undo.
     1002     define input  parameter p-bh_tbl-name as handle    no-undo.
     1003     define output parameter p-key-rec     as character no-undo.
     1004     do
     1005     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1006     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     1007     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     1008     :
     1009       define variable fh               as handle    no-undo .
     1010       define variable v-ok             as logical   no-undo .
     1011       define variable v-inform         as character no-undo .
     1012       define variable v-ind            as integer   no-undo .
     1013       define variable v-idx-field-qnty as integer   no-undo .
     1014       if p-tbl-name = ?
     1015         or p-tbl-name = "":U
     1016       then do:
     1017         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info18 ).
     1018       end.
     1019       if not p-bh_tbl-name:available then do:
     1020         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info18, p-tbl-name ).
     1021       end.
     1022       assign
     1023         p-key-rec = p-tbl-name
     1024         v-inform  = p-bh_tbl-name:index-information(1)
     1025         v-ind     = 2
     1026       .
     1027       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1028       on error undo, return error
     1029       :
     1030         assign
     1031           v-inform = p-bh_tbl-name:index-information( v-ind )
     1032           v-ind    = v-ind + 1
     1033         .
     1034       end.
     1035       if v-inform = ?
     1036         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1037         or entry( 3, v-inform, ",":U ) <> "1":U
     1038       then do:
     1039         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info18, p-tbl-name ).
     1040       end.
     1041       else do:
     1042         assign
     1043           v-idx-field-qnty = num-entries( v-inform ) - 4
     1044         .
     1045         if v-idx-field-qnty < 2 then do:
     1046           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info18, v-inform, p-tbl-name ).
     1047         end.
     1048         do v-ind = 1 to v-idx-field-qnty by 2
     1049         on error undo, return error
     1050         :
     1051           assign
     1052             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     1053             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     1054           .
     1055         end.
     1056       end.
     1057       if p-key-rec = ? then do:
     1058         assign
     1059           p-key-rec = "":U
     1060         .
     1061         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info18, p-tbl-name ).
     1062       end.
     1063     end.
     1064     return.
     1065   end procedure.
     1066   procedure gen-where-keyr-tab :
     1067     define input  parameter i-tableSerach as character no-undo.
     1068     define input  parameter i-tablekey   as character  no-undo.
     1069     define input  parameter p-key-rec    as character  no-undo.
     1070     define input  parameter p-key-handle as handle     no-undo .
     1071     define input  parameter p-db-name    as character  no-undo .
     1072     define input  parameter p-tt-handle  as handle     no-undo .
     1073     define output parameter o-Where      as character  no-undo.
     1074     do
     1075     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1076     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1077     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     1078     :
     1079       define variable v-full-tbl-name  as character no-undo .
     1080       define variable bh_tbl-name      as handle    no-undo .
     1081       define variable fh_key           as handle    no-undo .
     1082       define variable fh_search        as handle    no-undo .
     1083       define variable v-field-num      as integer   no-undo .
     1084       define variable v-count-fld      as integer   no-undo .
     1085       define variable v-inform         as character no-undo .
     1086       define variable v-ind            as integer   no-undo .
     1087       define variable v-idx-field-qnty as integer   no-undo .
     1088       define variable v-field-name     as character no-undo .
     1089       define variable v-field-val      as character no-undo .
     1090       define variable v-word-link      as character no-undo .
     1091       define variable vTable           as character no-undo.
     1092       define variable bh_tbl-key       as handle    no-undo .
     1093       assign
     1094         p-key-rec = trim( p-key-rec )
     1095       .
     1096       if p-key-handle <> ? then do:
     1097         if not valid-handle(p-key-handle)
     1098            or p-key-handle:type <> "buffer"
     1099         then do:
     1100           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info18 ).
     1101         end.
     1102         if num-entries( p-key-rec, chr(3) ) > 1
     1103           or p-key-rec = ?
     1104           or p-key-rec = "":U
     1105         then do:
     1106           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info18, p-key-rec ).
     1107         end.
     1108       end.
     1109       else do:
     1110         if p-key-rec = ?
     1111           or p-key-rec = "":U
     1112         then do:
     1113           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info18 ).
     1114         end.
     1115       end.
     1116       assign
     1117         vTable = entry( 1 , p-key-rec, chr(3) )
     1118       .
     1119       if p-tt-handle <> ?
     1120         and ( not valid-handle(p-tt-handle)
     1121               or p-tt-handle:type <> "buffer"
     1122             )
     1123       then do:
     1124         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info18, vTable, chr(10) ).
     1125       end.
     1126       if p-tt-handle = ? then do:
     1127         assign
     1128           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     1129         .
     1130         create buffer bh_tbl-name for table v-full-tbl-name .
     1131       end.
     1132       else do:
     1133         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1134       end.
     1135       assign
     1136         v-inform = bh_tbl-name:index-information(1)
     1137         v-ind    = 2
     1138       .
     1139       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1140       on error undo, return error
     1141       :
     1142         assign
     1143           v-inform = bh_tbl-name:index-information( v-ind )
     1144           v-ind    = v-ind + 1
     1145         .
     1146       end.
     1147       if v-inform = ?
     1148         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1149         or entry( 3, v-inform, ",":U ) <> "1":U
     1150       then do:
     1151         delete object bh_tbl-name no-error.
     1152         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info18, vTable ).
     1153       end.
     1154       assign
     1155         v-idx-field-qnty = num-entries( v-inform ) - 4
     1156       .
     1157       if v-idx-field-qnty < 2 then do:
     1158         delete object bh_tbl-name no-error.
     1159         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info18, v-inform, vTable ).
     1160       end.
     1161       assign
     1162         o-where     = "where":U
     1163         v-word-link = "":U
     1164         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     1165         v-count-fld = 0
     1166       .
     1167       if i-tablekey ne "" and i-tablekey ne ?
     1168       then do:
     1169         assign
     1170           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     1171         .
     1172         create buffer bh_tbl-key for table v-full-tbl-name .
     1173       end.
     1174       if i-tableSerach ne "" and i-tableSerach ne ?
     1175       then do:
     1176         delete object bh_tbl-name no-error.
     1177         assign
     1178           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     1179         .
     1180         create buffer bh_tbl-name for table v-full-tbl-name .
     1181       end.
     1182       block_where:
     1183       do v-ind = 1 to v-idx-field-qnty by 2
     1184       on error undo, return error
     1185       :
     1186         assign
     1187           v-count-fld = v-count-fld + 1
     1188         .
     1189         if p-key-handle = ?
     1190           and v-count-fld > v-field-num
     1191         then do:
     1192           leave block_where.
     1193         end.
     1194         define variable VfieldKeyTable as handle no-undo.
     1195         assign
     1196           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1197           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     1198         .
     1199         if     bh_tbl-key ne ?
     1200         then do:
     1201            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     1202            if VfieldKeyTable eq ?
     1203            then next block_where.
     1204         end.
     1205         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     1206         then
     1207            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     1208         else
     1209            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     1210         if p-key-handle = ? then do:
     1211           assign
     1212             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     1213           .
     1214         end.
     1215         else do:
     1216           assign
     1217             fh_key = p-key-handle:buffer-field( v-field-name )
     1218           .
     1219           if fh_key = ?
     1220             or not valid-handle( fh_key )
     1221           then do:
     1222             delete object bh_tbl-name.
     1223             if     bh_tbl-key ne ?
     1224             then
     1225                delete object bh_tbl-key.
     1226             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info18, p-key-handle:name, v-field-name ).
     1227           end.
     1228           assign
     1229             v-field-val = fh_key:buffer-value
     1230           .
     1231         end.
     1232         if fh_search:data-type ="character":U then do:
     1233           assign
     1234             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     1235             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     1236             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     1237             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     1238             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     1239             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     1240             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     1241             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     1242             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     1243             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     1244             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     1245             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     1246             v-field-val = substitute( '"&1"', v-field-val )
     1247           .
     1248         end.
     1249         assign
     1250           o-where = substitute( "&1 &2", o-where, v-field-val )
     1251         .
     1252         if v-word-link = "":U then do:
     1253           assign
     1254             v-word-link = "and":U
     1255           .
     1256         end.
     1257       end.
     1258       delete object bh_tbl-name.
     1259       if     bh_tbl-key ne ?
     1260       then
     1261          delete object bh_tbl-key.
     1262       if p-key-handle = ?
     1263         and v-count-fld <> v-field-num
     1264       then do:
     1265         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info18, vTable ).
     1266       end.
     1267     end.
     1268   end procedure.
     1269   procedure gen-hn-keyr-tab :
     1270     define input  parameter i-tableSerach as character no-undo.
     1271     define input  parameter i-tablekey   as character no-undo.
     1272     define input  parameter p-key-rec    as character no-undo.
     1273     define input  parameter p-key-handle as handle    no-undo .
     1274     define input  parameter p-db-name    as character no-undo .
     1275     define input  parameter p-tt-handle  as handle    no-undo .
     1276     define input  parameter p-stts-lock  as integer   no-undo .
     1277     define output parameter o-hn         as handle    no-undo.
     1278     define variable v-full-tbl-name as character no-undo.
     1279     define variable v-where         as character no-undo.
     1280     define variable bh_tbl-name     as handle    no-undo.
     1281     define variable vTable          as character no-undo.
     1282     do
     1283     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1284     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1285     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     1286         run gen-where-keyr-tab(i-tableSerach,
     1287                                i-tablekey,
     1288                                p-key-rec,
     1289                                p-key-handle,
     1290                                p-db-name,
     1291                                p-tt-handle,
     1292                                output v-where).
     1293         if i-tableSerach ne "" and i-tableSerach ne ?
     1294         then do:
     1295            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     1296            create buffer bh_tbl-name for table v-full-tbl-name .
     1297         end.
     1298         else do:
     1299            if p-tt-handle = ? then do:
     1300               assign
     1301                  vTable = entry( 1 , p-key-rec, chr(3) )
     1302               .
     1303               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     1304               create buffer bh_tbl-name for table v-full-tbl-name .
     1305            end.
     1306            else do:
     1307               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1308            end.
     1309         end.
     1310         if p-tt-handle = ? then do:
     1311            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     1312         end.
     1313         else do:
     1314            bh_tbl-name:find-first( v-where ) no-error .
     1315         end.
     1316         o-hn = bh_tbl-name.
     1317      end.
     1318   end procedure.
     1319   procedure gen-hn-keyr :
     1320     define input  parameter p-key-rec    as character no-undo.
     1321     define input  parameter p-key-handle as handle    no-undo .
     1322     define input  parameter p-db-name    as character no-undo .
     1323     define input  parameter p-tt-handle  as handle    no-undo .
     1324     define input  parameter p-stts-lock  as integer   no-undo .
     1325     define output parameter o-hn         as handle    no-undo.
     1326     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     1327   end.
     1328   procedure gen-row-keyr :
     1329     define input  parameter p-key-rec    as character no-undo.
     1330     define input  parameter p-key-handle as handle    no-undo .
     1331     define input  parameter p-db-name    as character no-undo .
     1332     define input  parameter p-tt-handle  as handle    no-undo .
     1333     define input  parameter p-stts-lock  as integer   no-undo .
     1334     define output parameter p-tbl-row    as rowid     no-undo.
     1335     define output parameter p-tbl-name   as character no-undo.
     1336     define variable vHn as handle no-undo.
     1337       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     1338       p-tbl-row = if vHn:available then vHn:rowid else ?.
     1339       p-tbl-name =  vHn:table.
     1340       delete object vHn no-error.
     1341     if p-tbl-row = ? then do:
     1342       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info18, p-tbl-name, p-key-rec ).
     1343     end.
     1344     else do:
     1345       return.
     1346     end.
     1347   end procedure.
     1348   procedure gen-key-fv :
     1349     define input  parameter p-key-rec    as character no-undo .
     1350     define output parameter p-field-list as character no-undo .
     1351     define output parameter p-value-list as character no-undo.
     1352     do
     1353     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1354     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1355     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1356     :
     1357       define variable v-full-tbl-name  as character no-undo .
     1358       define variable bh_tbl-name      as handle    no-undo .
     1359       define variable v-tbl-name       as character no-undo .
     1360       define variable v-field-num      as integer   no-undo .
     1361       define variable v-count-fld      as integer   no-undo .
     1362       define variable v-inform         as character no-undo .
     1363       define variable v-ind            as integer   no-undo .
     1364       define variable v-idx-field-qnty as integer   no-undo .
     1365       define variable v-delim-key      as character no-undo .
     1366       if p-key-rec = ?
     1367         or p-key-rec = "":U
     1368       then do:
     1369         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info18 ).
     1370       end.
     1371       assign
     1372         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1373         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1374       .
     1375       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1376       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info18 ).
     1377       assign
     1378         v-inform = bh_tbl-name:index-information(1)
     1379         v-ind    = 2
     1380       .
     1381       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1382       on error undo, return error
     1383       :
     1384         assign
     1385           v-inform = bh_tbl-name:index-information( v-ind )
     1386           v-ind    = v-ind + 1
     1387         .
     1388       end.
     1389       if v-inform = ?
     1390         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1391         or entry( 3, v-inform, ",":U ) <> "1":U
     1392       then do:
     1393         delete object bh_tbl-name no-error.
     1394         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info18, v-tbl-name ).
     1395       end.
     1396       assign
     1397         v-idx-field-qnty = num-entries( v-inform ) - 4
     1398       .
     1399       if v-idx-field-qnty < 2 then do:
     1400         delete object bh_tbl-name no-error.
     1401         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info18, v-inform, v-tbl-name ).
     1402       end.
     1403       assign
     1404         p-field-list = "":U
     1405         p-value-list = "":U
     1406         v-delim-key  = "":U
     1407         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     1408         v-count-fld  = 0
     1409       .
     1410       block_where:
     1411       do v-ind = 1 to v-idx-field-qnty by 2
     1412       on error undo, return error
     1413       :
     1414         assign
     1415           v-count-fld = v-count-fld + 1
     1416         .
     1417         if v-count-fld > v-field-num then do:
     1418           leave block_where.
     1419         end.
     1420         assign
     1421           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1422           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1423         .
     1424         if v-ind = 1 then do:
     1425           assign
     1426             v-delim-key = chr(3)
     1427           .
     1428         end.
     1429       end.
     1430       delete object bh_tbl-name.
     1431       if v-count-fld <> v-field-num then do:
     1432         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info18, v-tbl-name ).
     1433       end.
     1434     end.
     1435   end procedure.
     1436   procedure gen-key-field :
     1437     define input  parameter p-table      as character no-undo .
     1438     define output parameter p-field-list as character no-undo .
     1439     do
     1440     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1441     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1442     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1443     :
     1444       define variable v-full-tbl-name  as character no-undo .
     1445       define variable bh_tbl-name      as handle    no-undo .
     1446       define variable v-tbl-name       as character no-undo .
     1447       define variable v-field-num      as integer   no-undo .
     1448       define variable v-count-fld      as integer   no-undo .
     1449       define variable v-inform         as character no-undo .
     1450       define variable v-ind            as integer   no-undo .
     1451       define variable v-idx-field-qnty as integer   no-undo .
     1452       define variable v-delim-key      as character no-undo .
     1453       if p-table = ?
     1454         or p-table = "":U
     1455       then do:
     1456         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info18 ).
     1457       end.
     1458       assign
     1459         v-tbl-name      = p-table
     1460         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1461       .
     1462       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1463       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info18 ).
     1464       assign
     1465         v-inform = bh_tbl-name:index-information(1)
     1466         v-ind    = 2
     1467       .
     1468       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1469       on error undo, return error
     1470       :
     1471         assign
     1472           v-inform = bh_tbl-name:index-information( v-ind )
     1473           v-ind    = v-ind + 1
     1474         .
     1475       end.
     1476       if v-inform = ?
     1477         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1478         or entry( 3, v-inform, ",":U ) <> "1":U
     1479       then do:
     1480         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info18, v-tbl-name ).
     1481       end.
     1482       assign
     1483         v-idx-field-qnty = num-entries( v-inform ) - 4
     1484       .
     1485       if v-idx-field-qnty < 2 then do:
     1486         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info18, v-inform, v-tbl-name ).
     1487       end.
     1488       assign
     1489         p-field-list = "":U
     1490         v-delim-key  = "":U
     1491         v-count-fld  = 0
     1492       .
     1493       block_where:
     1494       do v-ind = 1 to v-idx-field-qnty by 2
     1495       on error undo, return error
     1496       :
     1497         assign
     1498           v-count-fld = v-count-fld + 1
     1499         .
     1500         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1501         if v-ind = 1 then do:
     1502           assign
     1503             v-delim-key = chr(3)
     1504           .
     1505         end.
     1506       end.
     1507       delete object bh_tbl-name.
     1508     end.
     1509   end procedure.
     1510   procedure create-gds-list-hist :
     1511   define input parameter p-mode as character no-undo .
     1512   define input-output parameter p-seq as integer no-undo .
     1513   define input parameter p-line as integer no-undo .
     1514   define variable p-list-table as character no-undo .
     1515   define input parameter p-hist-mode as character no-undo .
     1516   define input parameter p-des as character no-undo .
     1517   define input parameter p-num-recs as integer no-undo .
     1518   define input parameter p-option as character no-undo .
     1519   define input parameter p-status_ as character no-undo .
     1520   define input parameter p-item as character no-undo .
     1521   define input parameter p-tbl-name as character no-undo .
     1522   define input parameter p-bh_tbl-name as handle no-undo .
     1523   define variable v-num-add as integer no-undo .
     1524   define variable v-num-ignored as integer no-undo .
     1525   define buffer buf_gds-list-hist for gds-list-hist.
     1526     do
     1527     on error undo, return error
     1528     :
     1529       CASE p-mode:
     1530         when 'title' then do:
     1531           find first buf_gds-list-hist where
     1532                      buf_gds-list-hist.id = 0   no-error.
     1533           if not available buf_gds-list-hist then do:
     1534             create buf_gds-list-hist.
     1535             assign
     1536             buf_gds-list-hist.id = 0
     1537             buf_gds-list-hist.line = 0
     1538             buf_gds-list-hist.list-table = '':U
     1539             .
     1540           end.
     1541           assign
     1542           buf_gds-list-hist.des =  p-des
     1543           buf_gds-list-hist.num-recs = p-num-recs
     1544           buf_gds-list-hist.option_  = p-option
     1545           buf_gds-list-hist.item_ = p-item
     1546           .
     1547         end.
     1548         when 'ДОБАВЛЕНИЕ':U then do:
     1549           if p-option begins 'single' then do:
     1550             CASE p-hist-mode:
     1551               when '+':U then do:
     1552                 assign
     1553                 v-num-add = 1
     1554                 v-num-ignored  = 0
     1555                 .
     1556               end.
     1557               when '-':U then do:
     1558                 assign
     1559                 v-num-add = 1
     1560                 v-num-ignored  = 0
     1561                 .
     1562               end.
     1563               when '*':U then do:
     1564                 assign
     1565                 v-num-add = p-num-recs - 1
     1566                 p-num-recs = 1
     1567                 v-num-ignored  = 0
     1568                 .
     1569               end.
     1570             END CASE.
     1571           end.
     1572           create buf_gds-list-hist.
     1573           assign
     1574           buf_gds-list-hist.id = p-seq
     1575           buf_gds-list-hist.list-table = p-list-table
     1576            p-seq = (if p-line = 0 then (p-seq + 1) else p-seq)
     1577           buf_gds-list-hist.des =  p-des
     1578           buf_gds-list-hist.line = p-line
     1579           buf_gds-list-hist.num-recs = p-num-recs
     1580           buf_gds-list-hist.option_  = p-option
     1581           buf_gds-list-hist.item_ = p-item
     1582           buf_gds-list-hist.hist-mode =  p-hist-mode
     1583           buf_gds-list-hist.status_ =  p-status_
     1584           buf_gds-list-hist.num-add = v-num-add
     1585           buf_gds-list-hist.num-ignored = v-num-ignored
     1586           .
     1587         end.
     1588         when 'ИЗМЕНЕНИЕ':U + chr(4) + 'des' then do:
     1589           find first buf_gds-list-hist where
     1590                     buf_gds-list-hist.id = p-seq
     1591                 and buf_gds-list-hist.line = p-line no-error .
     1592           if  available buf_gds-list-hist then do:
     1593             assign
     1594             buf_gds-list-hist.des =  p-des
     1595             buf_gds-list-hist.num-recs = p-num-recs
     1596             buf_gds-list-hist.option_  = p-option
     1597             buf_gds-list-hist.item_ = p-item
     1598             buf_gds-list-hist.list-table = (if p-list-table <> '':U and p-list-table <> ?
     1599                                        then p-list-table
     1600                                        else buf_gds-list-hist.list-table)
     1601             .
     1602           end.
     1603         end.
     1604         when 'ИЗМЕНЕНИЕ':U + chr(4) + 'mode' then do:
     1605           find first buf_gds-list-hist where
     1606                     buf_gds-list-hist.id = p-seq
     1607                 and buf_gds-list-hist.line = p-line  no-error .
     1608           if available buf_gds-list-hist then do:
     1609             assign
     1610             buf_gds-list-hist.hist-mode =  p-hist-mode
     1611             buf_gds-list-hist.num-recs  = (if buf_gds-list-hist.line = 0 then p-num-recs else buf_gds-list-hist.num-recs)
     1612             buf_gds-list-hist.list-table = (if p-list-table <> '':U and p-list-table <> ?
     1613                                        then p-list-table
     1614                                        else buf_gds-list-hist.list-table)
     1615             .
     1616           end.
     1617         end.
     1618       END CASE.
     1619       if p-tbl-name <> "":U
     1620       and valid-handle(p-bh_tbl-name)
     1621       then do:
     1622         run gen-key-rec  in this-procedure (
     1623                                               input  p-tbl-name
     1624                                              ,input  p-bh_tbl-name
     1625                                              ,output p-item) no-error .
     1626         if not error-status:error then do:
     1627           assign
     1628           buf_gds-list-hist.item_ = p-item
     1629           .
     1630         end.
     1631         else do:
     1632           assign
     1633           buf_gds-list-hist.item_ = "!ERROR"
     1634           .
     1635         end.
     1636       end.
     1637     end.
     1638   end procedure.
     1639   FUNCTION get-line-mode returns character(input p-hist-mode as character):
     1640   case p-hist-mode:
     1641     when '+':U then
     1642       return  'ДОБАВЛЕНИЕ':U.
     1643     when '-':U then
     1644       return  'удаление':U.
     1645     when '*':U then
     1646       return  'ОСТАВИТЬ':U.
     1647   end CASE.
     1648   END FUNCTION.
     1649   FUNCTION get-hist-mode returns character(input p-line-mode as character):
     1650   case p-line-mode:
     1651     when 'ДОБАВЛЕНИЕ':U then
     1652       return  "+".
     1653     when 'удаление':U then
     1654       return  "-".
     1655     when 'ОСТАВИТЬ':U then
     1656       return  "*".
     1657   end CASE.
     1658   END FUNCTION.
     1659   procedure proc-write-filter-expression :
     1660   define input parameter p-filter-expression as character no-undo .
     1661   define variable v-ii as integer no-undo .
     1662   output to value(string(g#report-num) + ".whr").
     1663   put .
     1664   if num-entries(p-filter-expression) > 0 then do:
     1665      put unformatted 'and ('.
     1666      do v-ii = 1 to num-entries(p-filter-expression):
     1667        put unformatted entry(v-ii, p-filter-expression) skip.
     1668      end.
     1669      put unformatted ')'.
     1670   end.
     1671   output close.
     1672   end procedure.
     1673   procedure proc-write-filter-expression-var :
     1674   define input parameter p-filter-expression as character no-undo .
     1675   define output parameter p-string as character no-undo .
     1676   define variable v-ii as integer no-undo .
     1677   if num-entries(p-filter-expression) > 0 then do:
     1678      p-string = 'and ('.
     1679      do v-ii = 1 to num-entries(p-filter-expression):
     1680        p-string = p-string + entry(v-ii, p-filter-expression) + chr(10).
     1681      end.
     1682      p-string = p-string + ')'.
     1683   end.
     1684   end procedure.
     1685   define shared variable lns-cnt                 as integer   no-undo .
     1686   define shared variable s-notes                 as character no-undo .
     1687   define        variable keep-spis               as character no-undo .
     1688   FUNCTION customerName RETURNS CHARACTER
     1689       ( p-dogovor as character)  FORWARD.
     1690   DEFINE BUTTON b-exit AUTO-END-KEY
     1691        LABEL "&Выход"
