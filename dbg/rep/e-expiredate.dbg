      815   procedure userobjs_clear :
      816     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      817     do
      818     on error undo, return error return-value
      819     :
      820       for each buf_userobjs_temp-user-obj
      821       on error undo, return error return-value
      822       :
      823         delete buf_userobjs_temp-user-obj .
      824       end.
      825     end.
      826   end .
      827   procedure userobjs_object-count :
      828     define output parameter p-total-count as integer   no-undo .
      829     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      830     do
      831     on error undo, return error return-value
      832     :
      833       assign
      834         p-total-count = 0
      835       .
      836       for each buf_userobjs_temp-user-obj
      837       on error undo, return error return-value
      838       :
      839         assign
      840           p-total-count = p-total-count + 1
      841         .
      842       end.
      843     end.
      844   end.
      845   procedure userobjs_append :
      846      define input  parameter p-obj-type as character no-undo .
      847      define input  parameter p-obj-code as integer   no-undo .
      848     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      849     do
      850     on error undo, return error return-value
      851     :
      852       find first buf_userobjs_temp-user-obj
      853         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
      854           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
      855         no-error .
      856       if not available buf_userobjs_temp-user-obj
      857       then do:
      858         create buf_userobjs_temp-user-obj .
      859         assign
      860           buf_userobjs_temp-user-obj.obj-type = p-obj-type
      861           buf_userobjs_temp-user-obj.obj-code = p-obj-code
      862         .
      863       end.
      864     end.
      865   end.
      866   procedure userobjs_object-exist :
      867     define output parameter p-object-exist as logical   no-undo .
      868     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      869     do
      870     on error undo, return error return-value
      871     :
      872       find first buf_userobjs_temp-user-obj
      873         no-error .
      874       if not available buf_userobjs_temp-user-obj
      875       then do:
      876         assign
      877           p-object-exist = false
      878         .
      879       end.
      880       else do:
      881         assign
      882           p-object-exist = true
      883         .
      884       end.
      885     end.
      886   end.
      887   procedure userobjs_transfer :
      888     define input  parameter p-callback-handle as handle no-undo .
      889     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
      890     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      891     do
      892     on error undo, return error return-value
      893     :
      894       if valid-handle(p-callback-handle) <> true
      895       then do:
      896         message
      897           vss-workfile vss-revision vss-description skip
      898           "Ошибка задания входных параметров" skip
      899           "Неизвестный указатель на процедуру" skip
      900           view-as alert-box error .
      901         undo, return error return-value .
      902       end.
      903       if p-callback-handle :get-signature("userobjs_append") = ""
      904       then do:
      905         message
      906           vss-workfile vss-revision vss-description skip
      907           "Ошибка задания входных параметров" skip
      908           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
      909                     ,p-callback-handle :file-name
      910                     ) skip
      911           view-as alert-box error .
      912         undo, return error return-value .
      913       end.
      914       for each buf_userobjs_temp-user-obj
      915       on error undo, return error return-value
      916       :
      917         run userobjs_append in p-callback-handle
      918           (input  buf_userobjs_temp-user-obj.obj-type
      919           ,input  buf_userobjs_temp-user-obj.obj-code
      920           ) .
      921       end.
      922     end.
      923   end procedure.
