     1760        RADIO-BUTTONS
     1761             "Все", 1,
     1762   "Группы товаров", 2,
     1763   "Производители", 3,
     1764   "Выборочно", 4
     1765        SIZE 39.25 BY 4.13
     1766        FGCOLOR 0  NO-UNDO.
     1767   DEFINE RECTANGLE RECT-8
     1768        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1769        SIZE 45.5 BY 8.5.
     1770   DEFINE RECTANGLE RECT-9
