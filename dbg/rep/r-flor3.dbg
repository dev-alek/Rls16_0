     1161   define variable sum  as decimal   no-undo .
     1162   define variable num-ln as integer   no-undo .
     1163   define variable gds-str as character no-undo.
     1164   define variable gds-str1 as character no-undo.
     1165   define variable gds-str2 as character no-undo.
     1166   define variable i as int no-undo.
     1167   define variable j as int no-undo.
     1168   define variable Counter1 as integer init 0  no-undo .
