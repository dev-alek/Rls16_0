     1176   define variable  abbr              as  character no-undo.
     1177   define variable  pp                as  character no-undo.
     1178   define variable sym1 as character   init ":!:"   no-undo.
     1179   define variable sym2 as character   init ":!:"   no-undo.
     1180   define variable sym3 as character   init ":!:"   no-undo.
     1181   define variable sym4 as character   init ":!:"   no-undo.
     1182   define variable sym5 as character   init ":!:"   no-undo.
     1183   define variable sym6 as character   init ":!:"   no-undo.
     1184   define variable sym7 as character   init ":!:"   no-undo.
     1185   define variable sym8 as character   init ":!:"   no-undo.
     1186   define variable sym9 as character   init ":!:"   no-undo.
     1187   define variable sym10 as character  init ":!:"   no-undo.
     1188   DEFINE FRAME zakaz
     1189       temp-str.doc-numn  COLUMN-LABEL "Номер!заказа":C10 format "X(10)" space(0)
     1190       sym1 column-label ":!:"  format "X(1)" space(0)
     1191       temp-str.date-fact COLUMN-LABEL "Дата!выполнения":C11 format "99/99/9999" space(0)
     1192       sym2 column-label ":!:"  format "X(1)" space(0)
     1193       temp-str.cli-code  COLUMN-LABEL "Код!заказчика":C9 format "X(9)" space(0)
     1194       sym3 column-label ":!:"  format "X(1)" space(0)
     1195       temp-str.cli-name  COLUMN-LABEL "Заказчик":C20 format "X(20)" space(0)
     1196       sym4 column-label ":!:"  format "X(1)" space(0)
     1197       temp-str.status_   COLUMN-LABEL "Статус!заказа":C10     format "X(10)" space(0)
     1198       sym5 column-label ":!:"  format "X(1)" space(0)
     1199       temp-str.sum1      COLUMN-LABEL "Сумма !в розн.ценах":C13 format "->>>>>>>>9.99" space(0)
     1200       sym6 column-label ":!:"  format "X(1)" space(0)
     1201       temp-str.sum2      COLUMN-LABEL "Сумма скидки!/наценки":C13 format "->>>>>>>>9.99" space(0)
     1202       sym7 column-label ":!:"  format "X(1)" space(0)
     1203       temp-str.sum3      COLUMN-LABEL "Сумма!доставки":C13 format "->>>>>>>>9.99" space(0)
     1204       sym8 column-label ":!:"  format "X(1)" space(0)
     1205       temp-str.sum4      COLUMN-LABEL "Сумма!к оплате":C13 format "->>>>>>>>9.99" space(0)
     1206       sym9 column-label ":!:"  format "X(1)" space(0)
     1207       temp-str.sum5      COLUMN-LABEL "Сумма!предоплаты":C13 format "->>>>>>>>9.99" space(0)
     1208       sym10 column-label ":!:"  format "X(1)" space(0)
     1209       temp-str.sum6      COLUMN-LABEL "Сумма!доплаты":C13 format "->>>>>>>>9.99" space(0)
     1210       HEADER
     1211       string( "Лист " + string( PAGE-NUMBER(OutStream) , ">>>>9") ) AT 70 format "X(13)" SKIP
     1212       Line format "X(148)" AT 1
     1213       with width 232 down stream-io use-text NO-BOX.
     1214     if session:set-wait-state("compiler") then.
     1215   output STREAM OutStream to value( string( session:temp-directory +
     1216                                        "rpt" + string( g#report-num ) ) )
     1217                                        page-size  value(43) .
     1218     define variable v-prn0 as character no-undo .
     1219     assign
     1220       Line    = fill("-", 230)
     1221       UndLine = fill("_", 230)
     1222       LineBuf = fill("_", 240)
     1223     .
     1224     IF var-report-r-b = "rubl" THEN Assign PP = "Цены руб.".
     1225                          Else Assign PP = "Цены  баз.вал." .
     1226   define variable v-account as integer init 0 no-undo .
     1227   define variable v-account-lavel as character no-undo .
     1228   define variable v-button-stop as logical no-undo .
     1229   define variable v-kol-spice as integer no-undo .
     1230   define variable v-kol-spice2 as integer no-undo .
     1231   define variable v-kol-spice3 as integer no-undo .
     1232   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     1233   DEFINE BUTTON StopBtn AUTO-END-KEY
     1234        LABEL "Стоп"
     1235        SIZE 10 BY 1.
     1236   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     1237        LABEL "Обработано записей"
     1238         VIEW-AS TEXT
     1239        SIZE 14 BY .67 NO-UNDO.
     1240   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     1241         VIEW-AS TEXT
     1242        SIZE 53.25 BY .67
     1243        FGCOLOR 1  NO-UNDO.
     1244   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     1245         VIEW-AS TEXT
     1246        SIZE 53.25 BY .67
     1247        FGCOLOR 1  NO-UNDO.
     1248   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     1249         VIEW-AS TEXT
     1250        SIZE 53.25 BY .67
     1251        FGCOLOR 1  NO-UNDO.
     1252   DEFINE RECTANGLE RECT-1
     1253        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1254        SIZE 55.13 BY 4.46.
     1255   DEFINE FRAME InfoFrame
     1256        StopBtn AT ROW 4.25 COL 21.75
     1257        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     1258        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     1259        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     1260        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     1261        RECT-1 AT ROW 1 COL 1
     1262       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1263            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1264            TITLE "Процесс"
     1265            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     1266   define variable mFrameView      as logical   no-undo init yes.
     1267     define variable mFramHandle as handle no-undo.
     1268     mFramHandle = frame InfoFrame:handle.
     1269     if  log-manager:logfile-name ne ?
     1270     then DO:
     1271         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1272         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1273         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     1274     end.
     1275     mFrameView = not session:batch-mode and mFramHandle:visible.
     1276     if mFrameView
     1277     then do:
     1278       ASSIGN
     1279          FRAME InfoFrame:HIDDEN                           = TRUE
     1280          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     1281     end.
     1282   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     1283   DO:
     1284     IF not StopProcessing THEN
     1285       Message "Вы действительно хотите прервать" SKIP
     1286               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     1287                 UPDATE StopProcessing.
     1288     IF StopProcessing THEN do:
     1289        if mFrameView
     1290        then do:
     1291           HIDE FRAME InfoFrame.
     1292        end.
     1293     End.
     1294   END.
     1295   assign v-account = ( if integer( 25 ) = 0 then 100 else integer( 25 ) ).
     1296     if  log-manager:logfile-name ne ?
     1297     then DO:
     1298         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     1299     end.
     1300     if not session:batch-mode then
     1301     do:
     1302       VIEW FRAME InfoFrame.
     1303       mFrameView = true.
     1304     end.
     1305      v-button-stop = false .
     1306         if mFrameView
     1307         then do:
     1308         if v-button-stop then view STOPBTN in frame InfoFrame.
     1309                          else Hide STOPBTN in frame InfoFrame.
     1310         end.
     1311   v-ind = 0    .
     1312   FORM with frame zakaz .
     1313   for each obj-list :
     1314       Output stream Macr_Excel  close .
     1315       num#str# = 0 .
     1316       run gbl/_tmpfile.p ( "wb", ".txt", output v-file-name) .
     1317       output stream macr_excel to value(v-file-name)   .
     1318       v-ind = v-ind + 1.
     1319     FIND This_Object  WHERE This_Object.obj-type = obj-list.obj-type AND This_Object.obj-code = obj-list.obj-code  NO-LOCK.
     1320     FIND ub.clients      WHERE ub.clients.obj-type     = 'орг':U           AND ub.clients.obj-code     = v-cntxt-host-code-obj NO-LOCK.
     1321     run PrintTitul in this-procedure .
     1322     run make-tt in this-procedure ( obj-list.obj-type , obj-list.obj-code)  .
     1323         for each temp-str no-lock :
     1324           run print-line in this-procedure .
     1325         end.
     1326     run print-all-itog in this-procedure .
     1327     run on-same-page in this-procedure (input 1) .
     1328     run PrintPodval in this-procedure .
     1329     page stream OutStream .
     1330     run paramls-write in this-procedure
     1331       (input "file"
     1332       ,input string(v-ind) + obj-list.obj-name
     1333       ,input v-file-name
     1334       ) .
     1335   end.
     1336   HIDE STREAM OutStream FRAME zakaz.
     1337   HIDE stream OutStream FRAME BottomFrame .
     1338   HIDE stream OutStream FRAME BottomFrame2 .
     1339   output stream OutStream CLOSE .
     1340   Output stream Macr_Excel  close .
     1341   if mFrameView
     1342   then do:
     1343      HIDE FRAME InfoFrame.
     1344   end.
     1345       run paramls-write in this-procedure
     1346           (input "charcol"
     1347           ,input ""
     1348           ,input "1,4,5"
     1349           ) .
     1350     run end-proc in this-procedure .
     1351     define variable v-user-action as character no-undo .
     1352     define variable v-printed as logical   no-undo .
     1353     define variable DisabledOptions as integer   no-undo .
     1354     DisabledOptions = 8 .
     1355     run gbl/prnfilen.w
     1356       (input  ""
     1357       ,input  DisabledOptions
     1358       ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
     1359       ,input  7
     1360       ,output v-user-action
     1361       ,output v-printed
     1362       ) .
     1363   end.
     1364   procedure print-line :
     1365     do on error undo, return error return-value :
     1366     assign
     1367        Lines_Counter = Lines_Counter + 1
     1368         ssum4 = ssum4 + temp-str.sum4
     1369         ssum5 = ssum5 + temp-str.sum5
     1370         ssum6 = ssum6 + temp-str.sum6
     1371       .
     1372     if line-counter( OutStream ) + 2 > page-size( OutStream ) then page stream OutStream.
     1373     if line-counter( OutStream ) < Tmp_Counter then
     1374       assign
     1375       .
     1376     assign
     1377       Tmp_Counter  = line-counter( OutStream )
     1378       num-ln = num-ln + 1
     1379     .
     1380     if line-counter( OutStream ) + j > page-size( OutStream ) then  PAGE STREAM OutStream.
     1381   num#str# = num#str# + 1.
     1382   num#col# = 1.
     1383       run macr_excel_char ( temp-str.doc-numn  , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1384       run macr_excel_char ( temp-str.date-fact , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1385       run macr_excel_char ( temp-str.cli-code  , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1386       run macr_excel_char ( temp-str.cli-name  , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1387       run macr_excel_char ( temp-str.status_   , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1388       run macr_excel_char ( temp-str.sum1      , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1389       run macr_excel_char ( temp-str.sum2      , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1390       run macr_excel_char ( temp-str.sum3      , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1391       run macr_excel_char ( temp-str.sum4      , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1392       run macr_excel_char ( temp-str.sum5      , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1393       run macr_excel_char ( temp-str.sum6      , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1394     display stream OutStream
     1395       temp-str.doc-numn
     1396       temp-str.date-fact
     1397       temp-str.cli-code
     1398       temp-str.cli-name
     1399       temp-str.status_
     1400       temp-str.sum1
     1401       temp-str.sum2
     1402       temp-str.sum3
     1403       temp-str.sum4
     1404       temp-str.sum5
     1405       temp-str.sum6
     1406       sym1 sym2 sym3 sym4 sym5  sym6
     1407       sym7 sym8 sym9 sym10
     1408       with FRAME zakaz.
     1409       DOWN stream OutStream 1 with FRAME zakaz.
     1410     end.
     1411   end procedure.
     1412   procedure print-grp-itog :
     1413     do on error undo, return error return-value :
     1414     end.
     1415   end procedure.
     1416   procedure print-all-itog :
     1417     underline stream OutStream
     1418       temp-str.doc-numn
     1419       temp-str.date-fact
     1420       temp-str.cli-code
     1421       temp-str.cli-name
     1422       temp-str.status_
     1423       temp-str.sum1
     1424       temp-str.sum2
     1425       temp-str.sum3
     1426       temp-str.sum4
     1427       temp-str.sum5
     1428       temp-str.sum6
     1429       sym1 sym2 sym3 sym4 sym5  sym6
     1430       sym7 sym8 sym9 sym10
     1431       with FRAME zakaz.
     1432     DOWN stream OutStream 1 with FRAME zakaz.
     1433     display stream OutStream
     1434      "ИТОГО:" @ temp-str.status_
     1435       ssum4 @  temp-str.sum4
     1436       ssum5 @  temp-str.sum5
     1437       ssum6 @  temp-str.sum6
     1438       sym4 sym5  sym6
     1439       sym7 sym8 sym9 sym10
     1440       with FRAME zakaz.
     1441       DOWN stream OutStream 1 with FRAME zakaz.
     1442   end procedure.
     1443   procedure PrintTitul :
     1444     do  on error undo, return error return-value  :
     1445     define variable cc as integer no-undo .
     1446     define variable tt as integer no-undo .
     1447       case ub.clients.obj-type:
     1448          when 'орг':U
     1449          then do:
     1450               FIND ub.firm WHERE ub.firm.firm-code = ub.clients.obj-code NO-LOCK .
     1451               if available ub.firm
     1452               then do:
     1453                   assign
     1454                       t-addres = ( if ub.firm.ind = 0 or ub.firm.ind = ? then "" else string( ub.firm.ind ) )
     1455                       t-addres = t-addres
     1456                           + ( if ub.firm.city = ? or trim(ub.firm.city) = ""
     1457                               then ""
     1458                               else ( (if t-addres = "" then "" else ", ") + trim( ub.firm.city ) )
     1459                             )
     1460                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 1, 50 ) ) )
     1461                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     1462                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     1463                           + ( if  ub.firm.addres2 = ? or trim(ub.firm.addres2) = "" then "" else ( ", " + trim( ub.firm.addres2 ) ) )
     1464                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 51, 50 ) ) )
     1465                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     1466                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     1467                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 101, 50 ) ) )
     1468                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     1469                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     1470                       t-phone = ub.firm.phone
     1471                       t-inn   = ub.firm.inn
     1472                       t-okpo  = ub.firm.okpo
     1473                   .
     1474               end.
     1475          end.
     1476          when 'маг':U
     1477          then do:
     1478               FIND ub.shop WHERE ub.shop.obj-code = ub.clients.obj-code NO-LOCK .
     1479               if available ub.shop
     1480               then do:
     1481                   assign
     1482                       t-addres = ( if trim( shop.addres1 ) <> "" then ( trim( shop.addres1 ) ) else "" )
     1483                               + ( if trim( shop.addres2 ) <> "" then ( ", " + trim( shop.addres2 ) ) else "" )
     1484                       t-phone = shop.phone
     1485                       t-inn = ""
     1486                       t-okpo = ""
     1487                   .
     1488               end.
     1489          end.
     1490          when 'скл':U
     1491          then do:
     1492               FIND ub.store WHERE ub.store.obj-code = ub.clients.obj-code NO-LOCK .
     1493               if available ub.store
     1494               then do:
     1495                   assign
     1496                       t-addres = ( if trim( ub.store.addres1 ) <> "" then ( trim( ub.store.addres1 ) ) else "" )
     1497                               + ( if trim( ub.store.addres2 ) <> "" then ( ", " + trim( ub.store.addres2 ) ) else "" )
     1498                       t-phone = ub.store.phone
     1499                       t-inn = ""
     1500                       t-okpo = ""
     1501                   .
     1502               end.
     1503          end.
     1504          when 'чел':U
     1505          then do:
     1506               find ub.person where ub.person.psn-code = ub.clients.obj-code no-lock .
     1507               if available ub.person
     1508               then do:
     1509                   assign
     1510                       t-addres = ( if ub.person.ind <> 0 and ub.person.ind <> ? then string( ub.person.ind ) else "" )
     1511                                   + ( if  ub.person.city <> ? and trim(ub.person.city) <> "" then ( ", " + trim( ub.person.city ) ) else "" )
     1512                                   + ( if  ub.person.address <> ? and trim(ub.person.address) <> "" then ( ", " + trim( ub.person.address ) ) else "" )
     1513                       t-phone = ub.person.phone1
     1514                       t-inn = ub.person.inn
     1515                       t-okpo = ub.person.okpo
     1516                   .
     1517               end.
     1518          end.
     1519       end case.
     1520         PUT STREAM OutStream
     1521           space(5) cur-time-date() format "X(20)"
     1522           string( "ОТЧЕТ ПО ОПЛАТЕ ЗАКАЗОВ НА ИЗГОТОВЛЕНИЕ по " ) format  "X(100)"  skip
     1523           space(5) string( CAPS( This_Object.obj-name ) + " (" + string(This_Object.obj-code) + ")" ) format "X(160)"   skip
     1524           space(5) "За период с "  x-date-start " по "  x-date-end   skip .
     1525         .
     1526       num#str# = num#str# + 1.
     1527       num#col# = 2.
     1528       cc = num#str# .
     1529       run macr_excel_char ( "ОТЧЕТ ПО ОПЛАТЕ ЗАКАЗОВ НА ИЗГОТОВЛЕНИЕ по"    , num#str# , num#col#   ) .
     1530       num#str# = num#str# + 1.
     1531       num#col# = 2.
     1532       run macr_excel_char ( string( CAPS( This_Object.obj-name ) + " (" + string(This_Object.obj-code) + ") За период с " + string ( x-date-start, "99/99/9999" ) + " по " + string(x-date-end , "99/99/9999" ) )   , num#str# , num#col#   ) .
     1533       num#str# = num#str# + 1.
     1534       num#col# = 2.
     1535       run macr_excel_char ( cur-time-date()   , num#str# , num#col#   ) .
     1536       run macr_cell_format
     1537       ( 20    ,
     1538         true  ,
     1539         false  ,
     1540         ?    ,
     1541         cc ,
     1542         2 ,
     1543         num#str# ,
     1544         2 ) .
     1545       num#str# = num#str# + 1.
     1546       num#col# = 1.
     1547       tt = num#str#  .
     1548       num#col# = 1. run macr_excel_char ("Номер заказа"         , num#str# , num#col#) . run macr_cell_size ( 10 , ? , num#str# , num#col# , ?, ? ) .
     1549       num#col# = 2. run macr_excel_char ("Дата выполнения"      , num#str# , num#col#) . run macr_cell_size ( 11 , ? , num#str# , num#col# , ?, ? ) .
     1550       num#col# = 3. run macr_excel_char ("Код заказчика"        , num#str# , num#col#) . run macr_cell_size ( 10 , ? , num#str# , num#col# , ?, ? ) .
     1551       num#col# = 4. run macr_excel_char ("Заказчик"             , num#str# , num#col#) . run macr_cell_size ( 10 , ? , num#str# , num#col# , ?, ? ) .
     1552       num#col# = 5. run macr_excel_char ("Статус заказа"        , num#str# , num#col#) . run macr_cell_size ( 10 , ? , num#str# , num#col# , ?, ? ) .
     1553       num#col# = 6. run macr_excel_char ("Сумма в розн.ценах"   , num#str# , num#col#) . run macr_cell_size ( 15 , ? , num#str# , num#col# , ?, ? ) .
     1554       num#col# = 7. run macr_excel_char ("Сумма скидки /наценки", num#str# , num#col#) . run macr_cell_size ( 15 , ? , num#str# , num#col# , ?, ? ) .
     1555       num#col# = 8. run macr_excel_char ("Сумма доставки"       , num#str# , num#col#) . run macr_cell_size ( 15 , ? , num#str# , num#col# , ?, ? ) .
     1556       num#col# = 9. run macr_excel_char ("Сумма к оплате"       , num#str# , num#col#) . run macr_cell_size ( 15 , ? , num#str# , num#col# , ?, ? ) .
     1557      num#col# = 10. run macr_excel_char ("Сумма предоплаты"     , num#str# , num#col#) . run macr_cell_size ( 15 , ? , num#str# , num#col# , ?, ? ) .
     1558      num#col# = 11. run macr_excel_char ("Сумма доплаты"        , num#str# , num#col#) . run macr_cell_size ( 15 , ? , num#str# , num#col# , ?, ? ) .
     1559       run macr_cell_format
     1560       ( 12    ,
     1561         true  ,
     1562         false  ,
     1563         ?    ,
     1564         num#str# ,
     1565         1 ,
     1566         num#str# ,
     1567         11 ) .
     1568        put  stream macr_excel unformatted
     1569          substitute('select("r&1c&2:r&3c&4 ")' , tt , 1 , num#str# ,  num#col# ) + chr(10)  +
     1570          'BORDER( 2 , 2 , 2 , 2 , 2 , ,0,0,0,0,0) '  + chr(10) +
     1571          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     1572          .
     1573     end.
     1574   end procedure.
     1575   procedure PrintPodval :
     1576     do on error undo, return error return-value  :
     1577     PUT  STREAM OutStream " "
     1578     skip skip skip
     1579   " Руководитель _______________________ " skip
     1580         .
     1581       num#str# = num#str# + 3.
     1582       num#col# = 2.
     1583       run macr_excel_char ( "Руководитель"   , num#str# , num#col#   ) .
     1584     end.
     1585   end procedure.
     1586   PROCEDURE on-same-page :
     1587     define input parameter p-line-number as integer  no-undo .
     1588     if p-line-number > page-size( OutStream ) then return .
     1589     if line-counter( OutStream ) + p-line-number > page-size( OutStream ) then  page stream OutStream .
     1590   end procedure.
     1591   procedure make-tt :
     1592     do
     1593     on error undo, return error return-value
     1594    :
     1595   define input  parameter v-obj-type as character no-undo .
     1596   define input  parameter v-obj-code as integer   no-undo .
     1597   define variable  v-befpay     as character no-undo .
     1598   define variable  v-deliv      as character no-undo .
     1599   define variable  v-sumwrk     as character no-undo .
     1600   define variable  v-type       as character no-undo .
     1601   define variable  v-postpay    as character no-undo .
     1602   define variable v-itogo as character no-undo .
     1603   define variable v-sum-opl as decimal   no-undo init 0 .
     1604   define variable v-tot-sale as decimal   no-undo .
     1605   define variable v-status_ as character no-undo .
     1606   define variable v-prc as decimal   no-undo .
     1607   define variable v-pr as character no-undo .
     1608   define variable v-postpay-date as character no-undo .
     1609   define variable v-before-date  as character no-undo .
     1610   define variable v-postpay-date0 as character no-undo .
     1611   define variable v-before-date0  as character no-undo .
     1612    assign
     1613     ssum4 = 0
     1614     ssum5 = 0
     1615     ssum6 = 0
     1616    .
     1617   for each temp-str :
     1618       delete temp-str.
     1619   end.
     1620   define buffer ready_trn-doc for ub.trn-doc.
     1621   define buffer nakl_trn-doc for ub.trn-doc.
     1622   define variable v-nabor  as logical   no-undo .
     1623   define buffer buf_doc-attr for ub.doc-attr.
     1624   for each ready_trn-doc no-lock where
     1625                         ready_trn-doc.obj-type     = v-obj-type and
     1626                         ready_trn-doc.obj-code     = v-obj-code and
     1627                         ready_trn-doc.out-code     = ? and
     1628                         ( ready_trn-doc.status_ = 'готов':U or
     1629                         ready_trn-doc.status_ = 'отказ':U or
     1630                         ready_trn-doc.status_ = 'запрос':U )
     1631                         and
     1632                         ready_trn-doc.doc-type = 'рас':U and
     1633                         ready_trn-doc.internal = false   and
     1634                         ready_trn-doc.ext-doc-type = 'ee':U and
     1635                         ((
     1636                           ready_trn-doc.doc-date >= x-date-start and
     1637                           ready_trn-doc.doc-date <= x-date-end  )
     1638                         or  (
     1639                           ready_trn-doc.flora-pay-date >= x-date-start and
     1640                           ready_trn-doc.flora-pay-date <= x-date-end
     1641                         )) :
     1642     if ready_trn-doc.status_ = 'запрос':U then do:
     1643   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1644   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_resv-inqv in g#lib-trn3
     1645   (input  ready_trn-doc.doc-code,
     1646    output v-nabor
     1647   )
     1648   .
     1649        if v-nabor = true  then  next.
     1650     end.
     1651   v-ord_date = "" . run trn-doc-attr_value in this-procedure (  input ready_trn-doc.doc-code                                           ,  input '0rsrv-date':U                                             , output v-ord_date                                             , output v-type ).
     1652   v-befpay = "" . run trn-doc-attr_value in this-procedure (  input ready_trn-doc.doc-code                                           ,  input '2befpay':U                                             , output v-befpay                                             , output v-type ).
     1653   v-deliv = "" . run trn-doc-attr_value in this-procedure (  input ready_trn-doc.doc-code                                           ,  input '5deliv':U                                             , output v-deliv                                             , output v-type ).
     1654   v-postpay-date0 = "" . run trn-doc-attr_value in this-procedure (  input ready_trn-doc.doc-code                                           ,  input '3postdchek':U                                             , output v-postpay-date0                                             , output v-type ).
     1655   v-before-date0 = "" . run trn-doc-attr_value in this-procedure (  input ready_trn-doc.doc-code                                           ,  input '4dchek':U                                             , output v-before-date0                                             , output v-type ).
     1656   define buffer cl_clients for  ub.clients.
     1657   find cl_clients no-lock  where cl_clients.obj-type = ready_trn-doc.cli-type
     1658                              and cl_clients.obj-code = ready_trn-doc.cli-code no-error .
     1659   v-tot-sale = 0 .
     1660   v-sum-opl = 0 .
     1661   v-postpay = "" .
     1662   v-itogo = "".
     1663   v-before-date = "" .
     1664   if ready_trn-doc.status_ = 'отказ':U  then  v-status_ = ready_trn-doc.status_ .
     1665   if ready_trn-doc.status_ = 'запрос':U and ready_trn-doc.flag_ = false  then  v-status_ = "Новый" .
     1666   if ready_trn-doc.status_ = 'запрос':U and ready_trn-doc.flag_ = true   then  v-status_ = "Создан" .
     1667   find first  nakl_trn-doc no-lock where  nakl_trn-doc.out-code = ready_trn-doc.doc-code no-error .
     1668   if available  nakl_trn-doc then do:
     1669               v-postpay-date = "" .     run trn-doc-attr_value in this-procedure (  input nakl_trn-doc.doc-code                                               ,  input '3postdchek':U                                                 , output v-postpay-date                                                 , output v-type ).
     1670               v-before-date = "" .     run trn-doc-attr_value in this-procedure (  input nakl_trn-doc.doc-code                                               ,  input '4dchek':U                                                 , output v-before-date                                                 , output v-type ).
     1671               v-postpay = "" .     run trn-doc-attr_value in this-procedure (  input nakl_trn-doc.doc-code                                               ,  input '1postpay':U                                                 , output v-postpay                                                 , output v-type ).
     1672               v-itogo = "" .     run trn-doc-attr_value in this-procedure (  input nakl_trn-doc.doc-code                                               ,  input 'discnt-stop':U                                                 , output v-itogo                                                 , output v-type ).
     1673       v-sum-opl = decimal (v-itogo) no-error .
     1674       v-tot-sale = ((v-sum-opl  - decimal ( v-deliv )) + ( nakl_trn-doc.discnt-pc * (v-sum-opl  - decimal ( v-deliv )) / (100 - nakl_trn-doc.discnt-pc ))) * 100 / ( 100 + v-prc ) .
     1675       if v-sum-opl = 0 then v-sum-opl =  v-tot-sale - nakl_trn-doc.discnt-rubl.
     1676       if v-sum-opl =  ? then v-sum-opl =0 .
     1677       case nakl_trn-doc.Status_ :
     1678         when 'накл':U   then do:
     1679           if nakl_trn-doc.flag_ = false  then  v-status_ = "На исполнении" .
     1680                                          else  v-status_ = "Готов" .
     1681         end.
     1682         when 'разрешен':U  then do:
     1683             v-status_ = "Выполнен-" .
     1684         end.
     1685         when 'факт':U  then do:
     1686             v-status_ = "Выполнен+" .
     1687         end.
     1688       end case.
     1689   end.
     1690   if  v-before-date =  "" then v-before-date = v-before-date0.
     1691   if  v-before-date <> "" then do:
     1692   if not ( date(v-before-date) >= x-date-start and
     1693            date(v-before-date) <= x-date-end ) then v-befpay = "" .
     1694   end.
     1695   else do:
     1696     v-befpay = "" .
     1697   end.
     1698   if  v-postpay-date = "" then v-postpay-date = v-postpay-date0 .
     1699   if  v-postpay-date <> "" then do:
     1700   if not ( date(v-postpay-date) >= x-date-start and
     1701            date(v-postpay-date) <= x-date-end ) then v-postpay = "" .
     1702   end.
     1703   else do:
     1704     v-postpay = "" .
     1705   end.
     1706   create temp-str.
     1707   assign
     1708     temp-str.doc-numn   = ready_trn-doc.doc-code
     1709     temp-str.date-fact  = date(v-ord_date)
     1710     temp-str.cli-code   = string(ready_trn-doc.cli-code)
     1711     temp-str.cli-name   = cl_clients.obj-name
     1712     temp-str.status_    = v-status_
     1713     temp-str.sum1       = v-tot-sale
     1714     temp-str.sum3       = decimal ( v-deliv )
     1715     temp-str.sum4       = v-sum-opl
     1716     temp-str.sum2       = if temp-str.sum1 = 0 then 0 else (temp-str.sum4 - ( temp-str.sum1 + temp-str.sum3 ))
     1717     temp-str.sum5       = decimal ( v-befpay  )
     1718     temp-str.sum6       = decimal ( v-postpay )
     1719     no-error
     1720     .
     1721   end.
     1722     end.
     1723    end procedure.
     1724   def var vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1725   procedure macr_excel_char :
     1726    do
     1727    on error undo, return error return-value
     1728    :
     1729    define input parameter  p-val as character no-undo .
     1730    define input parameter  p-row as integer no-undo .
     1731    define input parameter  p-col as integer no-undo .
     1732    if p-val = ? then p-val = "" .
     1733       put stream macr_excel unformatted
     1734             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     1735    end.
     1736   end procedure.
     1737   procedure macr_excel_char_with_format :
     1738    do
     1739    on error undo, return error return-value
     1740    :
     1741    define input parameter  p-val as character no-undo .
     1742    define input parameter  p-row as integer no-undo .
     1743    define input parameter  p-col as integer no-undo .
     1744    if p-val = ? then p-val = "" .
     1745       put stream macr_excel unformatted
     1746             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     1747       put stream macr_excel unformatted 'format.number("@")' + chr(10) .
     1748       put stream macr_excel unformatted
     1749             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     1750    end.
     1751   end procedure.
     1752   procedure macr_excel_cell_format :
     1753    do
     1754    on error undo, return error return-value
     1755    :
     1756    define input parameter  p-val    as character no-undo .
     1757    define input parameter  p-row    as integer   no-undo .
     1758    define input parameter  p-col    as integer   no-undo .
     1759    define input parameter  p-format as character no-undo .
     1760    if p-val = ? then p-val = "" .
     1761       put stream macr_excel unformatted
     1762             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     1763       put stream macr_excel unformatted substitute('format.number("&1")', p-format) + chr(10) .
     1764       put stream macr_excel unformatted
     1765             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     1766    end.
     1767   end procedure.
     1768   procedure macr_excel_sum :
     1769    do
     1770    on error undo, return error return-value
     1771    :
     1772    define input parameter  p-row as integer no-undo .
     1773    define input parameter  p-col as integer no-undo .
     1774    define input parameter  p-row1 as integer no-undo .
     1775    define input parameter  p-col1 as integer no-undo .
     1776    define input parameter  p-row2 as integer no-undo .
     1777    define input parameter  p-col2 as integer no-undo .
     1778       put stream macr_excel unformatted
     1779             substitute('formula("=sum(r&3c&4:r&5c&6)","r&1c&2")', p-row , p-col , p-row1 , p-col1 ,p-row2 , p-col2 ) + chr(10)  .
     1780    end.
     1781   end procedure.
     1782   procedure macr_excel_dec :
     1783    do
     1784    on error undo, return error return-value
     1785    :
     1786    define input parameter  p-val as character no-undo .
     1787    define input parameter  p-row as integer   no-undo .
     1788    define input parameter  p-col as integer   no-undo .
     1789     if p-val = ? then p-val =  "" .
     1790      put  stream macr_excel unformatted
     1791           substitute('formula(&3,"r&1c&2")', p-row , p-col ,  p-val )  + chr(10) .
     1792    end.
     1793   end procedure.
     1794   procedure macr_cell_format :
     1795    do
     1796    on error undo, return error return-value
     1797    :
     1798    define input parameter  p-size   as integer   no-undo .
     1799    define input parameter  p-bold   as logical   no-undo .
     1800    define input parameter  p-italic as logical   no-undo .
     1801    define input parameter  p-color  as integer   no-undo .
     1802    define input parameter  p-row    as integer   no-undo .
     1803    define input parameter  p-col    as integer   no-undo .
     1804    define input parameter  p-row-2  as integer   no-undo .
     1805    define input parameter  p-col-2  as integer   no-undo .
     1806     if p-size = ? then p-size = 10 .
     1807     if p-bold = ? then p-bold = false .
     1808     if p-italic = ? then p-italic = false .
     1809     if p-row-2 = ? then p-row-2 = p-row .
     1810     if p-col-2 = ? then p-col-2 = p-col .
     1811     put  stream macr_excel unformatted
     1812      substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 ) + chr(10) .
     1813     if p-color <> ? then do:
     1814        put  stream macr_excel unformatted
     1815          substitute('patterns(1,,&1,true)', p-color ) + chr(10)  .
     1816     end.
     1817     put  stream macr_excel unformatted
     1818          substitute('format.font(,&1,&2,&3)' , p-size,
     1819                                           string ( p-bold  , "true/false" ) ,
     1820                                           string ( p-italic , "true/false" )
     1821                                           ) + chr(10) .
     1822    end.
     1823   end procedure.
     1824   procedure macr_cell_size :
     1825    do
     1826    on error undo, return error return-value
     1827    :
     1828    define input parameter  p-w   as integer   no-undo .
     1829    define input parameter  p-l   as integer   no-undo .
     1830    define input parameter  p-row    as integer   no-undo .
     1831    define input parameter  p-col    as integer   no-undo .
     1832    define input parameter  p-row-2  as integer   no-undo .
     1833    define input parameter  p-col-2  as integer   no-undo .
     1834     if p-row-2 = ? then p-row-2 = p-row .
     1835     if p-col-2 = ? then p-col-2 = p-col .
     1836     if p-w = ? then    p-w = 0 .
     1837     if p-l = ? then    p-l = 0 .
     1838    define variable s-w as character no-undo .
     1839    define variable s-l as character no-undo .
     1840    if p-w = 0 then s-w = "" .
     1841               else s-w = string(p-w)  .
     1842    if p-l = 0 then s-l = "" .
     1843               else s-l = string(p-l)  .
     1844   put  stream macr_excel unformatted
     1845        substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 )  skip .
     1846   put  stream macr_excel unformatted
     1847        substitute('COLUMN.WIDTH(&1,,,,)' , s-w  )  skip.
     1848   put  stream macr_excel unformatted
     1849        'FORMAT.TEXT(2,2,0,,,,,)'  skip.
     1850    end.
     1851   end procedure.
     1852   procedure proc-print-header :
     1853    do
     1854    on error undo, return error return-value
     1855    :
     1856      find first sheetf .
     1857        sheetf.excel-row-heder =  num-entries( c-str ,chr(10)) + 1.
     1858        sheetf.excel-row-title =  num-entries( sheetf.excel-column-lable , chr(10) ).
     1859        var-1 =  num#str# .
     1860        repeat c-c = 1 to sheetf.excel-row-title :
     1861        num#str# = num#str# + 1 .
     1862        p-var = num-entries( entry (c-c, sheetf.excel-column-lable, chr(10)) , chr(44) ) .
     1863        do c-i = 1 to p-var :
     1864           str--1 = entry( c-i, entry (c-c,sheetf.excel-column-lable, chr(10)) , chr(44)) .
     1865           str--2 = integer(entry( c-i, sheetf.sizes )) .
     1866           num#col# = c-i .
     1867           run macr_excel_char_with_format ( str--1  , num#str# , num#col#  ) .
     1868           run macr_cell_size ( str--2 , ? , num#str# , num#col# , ?, ? ) .
     1869        end.
     1870       c-i = 0.
     1871       end.
     1872       run macr_cell_format (
     1873           10       ,
     1874           true     ,
     1875           false    ,
     1876           35       ,
     1877           var-1 + 1,
     1878           1        ,
     1879           num#str# ,
     1880           num#col# )
     1881           .
     1882     put  stream macr_excel unformatted
     1883          substitute('select("r&1c&2:r&3c&4 ")' , var-1 + 1 , 1 , num#str# ,  num#col# ) + chr(10)  +
     1884          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     1885          .
     1886    end.
     1887   end procedure.
     1888   procedure end-proc :
     1889    do
     1890    on error undo, return error return-value
     1891    :
     1892     v-file-name = ( string( session:temp-directory + "rpt" + string( g#report-num ) ) + ".t-t").
     1893     OUTPUT to VALUE (v-file-name) .
     1894     for each temp-param :
     1895       export  temp-param  .
     1896     end.
     1897    end.
     1898   end procedure.
     1899   procedure trn-doc-attr_value :
     1900     define  input parameter p-doc-code like ub.doc-attr.doc-code   no-undo.
     1901     define  input parameter p-code     like ub.doc-attr.attr-code  no-undo.
     1902     define output parameter p-value    like ub.doc-attr.attr-value no-undo.
     1903     define output parameter p-type     as   character              no-undo.
     1904     do on error undo, return error return-value :
     1905   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input p-doc-code ,
     1906                           input p-code ,
     1907                          output p-value ,
     1908                          output p-type ) no-error .
     1909     end.
     1910   end procedure.
