     1039         , output v-action
     1040         ) no-error .
     1041       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
     1042       assign
     1043         v-inform-launched = false
     1044       .
     1045     end.
     1046   end.
     1047   procedure proc-alt-f1:
     1048     run gbl/corrhelp.p
     1049       (input this-procedure
     1050       ) .
     1051   end .
     1052   on alt-shift-f2 anywhere do:
     1053     run proc-alt-shift-f2.
     1054   end.
     1055   on alt-shift-f3 anywhere do:
     1056     run proc-alt-shift-f3 in this-procedure .
     1057   end.
     1058   on alt-shift-f4 anywhere do:
     1059     run proc-alt-shift-f4 in this-procedure.
     1060   end.
     1061   on alt-f1 anywhere do:
     1062     run proc-alt-f1 in this-procedure .
     1063   end.
     1064   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1065     define variable v-cntxt-db-num        as integer   no-undo .
     1066     define variable v-cntxt-userid        as character no-undo .
     1067     define variable v-cntxt-level         as character no-undo .
