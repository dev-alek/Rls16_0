     1073   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1074     run mainmenu_getcntxt in my-handle
     1075       (output v-cntxt-db-num
     1076       ,output v-cntxt-userid
     1077       ,output v-cntxt-level
     1078       ,output v-cntxt-host-code-obj
     1079       ,output v-cntxt-obj-type
     1080       ,output v-cntxt-obj-code
     1081       ,output v-cntxt-db-num-obj
     1082       ,output v-cntxt-is-admin
     1083       ) .
     1084   define variable base-type as character no-undo .
     1085   define variable base-code as integer   no-undo .
     1086   define variable g#report-num as integer   no-undo .
     1087   define variable g#gds-engl as logical   no-undo .
     1088   define variable vv-exch-rate  as decimal   no-undo .
     1089   define variable vv-exch-scale as decimal   no-undo .
     1090   define variable v-cntxt-host-name-obj as character no-undo .
     1091   if v-cntxt-level = 'object':U then do:
     1092   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1093   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostname in g#library
     1094     (input  v-cntxt-obj-type
     1095     ,input  v-cntxt-obj-code
     1096     ,output v-cntxt-host-code-obj
     1097     ,output v-cntxt-host-name-obj
     1098     )  .
     1099   end.
     1100   if v-cntxt-level = 'firm':U then do:
     1101     find first ub.clients no-lock where
     1102                ub.clients.obj-type = 'орг':U and
     1103                ub.clients.obj-code = v-cntxt-host-code-obj no-error .
     1104   if error-status :error then v-cntxt-host-name-obj = ? .
     1105      else v-cntxt-host-name-obj = ub.clients.obj-name.
     1106   end.
     1107   if v-cntxt-level = 'object':U
     1108   or v-cntxt-level = 'firm':U
     1109   then do:
     1110   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1111   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     1112     (input  v-cntxt-host-code-obj
     1113     ,output base-code
     1114     )  .
     1115   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1116   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     1117     (input  base-code
     1118     ,input  today
     1119     ,output vv-exch-rate
     1120     ,output vv-exch-scale
     1121     ,output base-type
     1122     )  .
     1123   end.
     1124   run get-report-num in my-handle ( output g#report-num ).
     1125   run get-gds-engl in my-handle ( output g#gds-engl ) .
     1126    do
     1127    on error undo, return error return-value
     1128    :
     1129   DEFINE temp-table temp-str no-undo
     1130     field   doc-numn           as char
     1131     field   date-fact         as  date
     1132     field   cli-code          as  char
     1133     field   cli-name          as character
