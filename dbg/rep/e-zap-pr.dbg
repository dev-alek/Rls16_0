      886   PROCEDURE adm-update-record :
      887       MESSAGE
      888         "Object ":U THIS-PROCEDURE:FILE-NAME
      889           "must have at least one Enabled Table to perform Update.":U
      890             VIEW-AS ALERT-BOX ERROR.
      891      RETURN.
      892   END PROCEDURE.
      893   PROCEDURE check-modified :
      894   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
      895   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
      896   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
      897   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
      898     IF check-state = "check":U THEN
      899     DO:
      900       RUN get-link-handle IN adm-broker-hdl
      901         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
      902            OUTPUT group-target-list).
      903       IF group-target-list NE "":U THEN
      904       DO i = 1 TO NUM-ENTRIES(group-target-list):
      905         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
      906         RUN check-modified IN curr-widget ('group-check':U).
      907         IF RETURN-VALUE NE "":U THEN
      908         DO:
      909           RUN check-modified-message(RETURN-VALUE).
      910           RETURN "":U.
      911         END.
      912       END.
      913     END.
      914     RETURN "":U.
      915   END PROCEDURE.
      916   PROCEDURE check-modified-message :
      917     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
      918        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
      919           'CONTAINER-SOURCE':U, 'HIDDEN':U).
      920        IF RETURN-VALUE = "YES":U THEN
      921           RUN notify ('view,CONTAINER-SOURCE':U).
      922        MESSAGE IF p-changed-table NE ? THEN
      923           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
      924           ELSE "Current values have been changed."
      925           SKIP "  Do you wish to save those changes?"
      926           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
      927        IF ANS THEN
      928        DO:
      929           IF group-assign-target THEN
      930             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
      931           ELSE RUN dispatch('update-record':U).
      932           IF RETURN-VALUE = "ADM-ERROR":U THEN
      933           DO:
      934               MESSAGE "Changes to the previous record were not saved."
      935                 VIEW-AS ALERT-BOX ERROR.
      936               IF group-assign-target THEN
      937                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      938               ELSE RUN dispatch ('cancel-record':U).
      939           END.
      940        END.
      941        ELSE DO:
      942          IF group-assign-target THEN
      943             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      944          ELSE RUN dispatch('cancel-record':U).
      945        END.
      946        RETURN.
      947   END PROCEDURE.
      948   PROCEDURE get-rowid :
      949       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
      950       ASSIGN
      951       p-table   =   adm-first-table.
      952       RETURN.
      953   END PROCEDURE.
      954   PROCEDURE init-group-assign :
      955       RUN request-attribute IN adm-broker-hdl
      956         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
      957       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
      958         group-assign-target = yes.
      959       ELSE group-assign-target = no.
      960       RETURN.
      961   END PROCEDURE.
      962   PROCEDURE set-editors :
      963       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
      964       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
      965       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
      966       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
      967       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
      968       DO WHILE VALID-HANDLE (curr-widget):
      969           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
      970              curr-widget:HIDDEN = no THEN DO:
      971             CASE p-field-setting:
      972               WHEN "INITIALIZE":U THEN
      973               DO:
      974                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
      975                     read-only-list +
      976                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
      977                        STRING(curr-widget).
      978               END.
      979               WHEN "DISABLE":U OR
      980               WHEN "ENABLE":U THEN
      981               DO:
      982                   curr-widget:SENSITIVE = yes.
      983                   RUN get-attribute ('Read-Only-Editors':U).
      984                   IF RETURN-VALUE = ? OR
      985                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
      986                       curr-widget:READ-ONLY =
      987                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
      988               END.
      989               WHEN "CLEAR":U THEN
      990                   curr-widget:SCREEN-VALUE = "":U.
      991             END CASE.
      992           END.
      993           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
      994       END.
      995       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
      996         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
      997           + '"':U).
      998       RETURN.
      999   END PROCEDURE.
     1000   PROCEDURE use-check-modified-all :
     1001    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1002     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1003     RETURN.
     1004   END PROCEDURE.
     1005   PROCEDURE use-create-on-add :
     1006   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1007      RETURN.
     1008   END PROCEDURE.
     1009   PROCEDURE use-initial-lock :
     1010     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1011     ASSIGN adm-initial-lock = p-attr-value.
     1012     RETURN.
     1013   END PROCEDURE.
     1014     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1015   ASSIGN
     1016          FRAME F-Main:SCROLLABLE       = FALSE
     1017          FRAME F-Main:HIDDEN           = TRUE.
     1018   ASSIGN
     1019          B-columns:HIDDEN IN FRAME F-Main           = TRUE.
     1020   ON CHOOSE OF B-columns IN FRAME F-Main
     1021   DO:
     1022   END.
     1023   PROCEDURE disable_UI :
     1024     HIDE FRAME F-Main.
     1025     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1026   END PROCEDURE.
     1027   PROCEDURE local-apply-layout :
     1028     RUN dispatch IN THIS-PROCEDURE ( INPUT 'apply-layout':U ) .
     1029   END PROCEDURE.
     1030   PROCEDURE local-initialize :
     1031   def var  l-ind as integer no-undo .
     1032     RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     1033   END PROCEDURE.
     1034   PROCEDURE my-report :
     1035   if x-SelectGood = 1 then do:
     1036     if x-SET_val_TYPE = 1
     1037     then do:
     1038       run rep/r-zap-p1.p  (input classify ,
     1039                         input RADIO-SET-1 ,
     1040                         input ShowZero ,
     1041                         input ShowZero-2 ) .
     1042     end.
     1043     else do:
     1044       run rep/r-zap-p2.p  (input classify,
     1045                         input RADIO-SET-1 ,
     1046                         input ShowZero ,
     1047                         input ShowZero-2 ) .
     1048     end.
     1049   end.
     1050   else do:
     1051     if x-SET_val_TYPE = 1
     1052     then do:
     1053       run rep/r-zap-p3.p  (input classify,
     1054                         input RADIO-SET-1 ,
     1055                         input ShowZero ,
     1056                         input ShowZero-2 ) .
     1057     end.
     1058     else do:
     1059       run rep/r-zap-p4.p  (input classify,
     1060                         input RADIO-SET-1 ,
     1061                         input ShowZero ,
     1062                         input ShowZero-2 ) .
     1063     End.
     1064   End.
     1065   END PROCEDURE.
     1066   PROCEDURE my-var :
     1067   Assign frame F-Main ShowZero Classify ShowZero-2 RADIO-SET-1 .
     1068   Assign
     1069    STR-obj-type = ''
     1070    STR-obj-code = ''
     1071    STR-obj-name = ''
     1072    STR-obj      = '' .
     1073   For each obj-list no-lock:
     1074     Assign
     1075       STR-obj-type = STR-obj-type + obj-list.obj-type + ','
     1076       STR-obj-code = STR-obj-code + String(obj-list.obj-code) + ','
     1077       STR-obj-name = STR-obj-name + obj-list.obj-name + ','
     1078       STR-obj = STR-obj +  obj-list.obj-type + '#' + string(obj-list.obj-code)  + ','
     1079     .
     1080   End.
     1081   ReportNAme = "О Т Ч Е Т   О   С О С Т О Я Н И И   З А П А С А   И   П Р О Д А Ж А Х ".
     1082   def var t-class as char no-undo.
     1083     CASE Classify:
     1084       WHEN "no-classify":U    THEN t-class =   "Без классификации" .
     1085       WHEN "prod":U           THEN t-class =   "Производители"   .
     1086       WHEN "post":U           THEN t-class =   "Поставщики"   .
     1087       WHEN "grp-goods":U      THEN t-class =   "Группы товаров"  .
     1088       WHEN "prod/grp-goods":U THEN t-class =   "Производители/Группы товаров" .
     1089       WHEN "grp-goods/prod":U THEN t-class =   "Группы товаров/Производители" .
     1090       WHEN  "vat-ps":U        THEN t-class =   "Ставка НДС" .
     1091       WHEN  "sort":U          THEN t-class =   "Проба(Сорт)" .
     1092       WHEN  "n-level":U       THEN t-class =   "Группы с уровнем вложенности " .
     1093       WHEN  "t-level":U       THEN t-class =   "Терминальные группы" .
     1094    End case.
     1095   ReportHeader = "Классификация : " + t-Class + chr(10) .
     1096   ReportHeader = ReportHeader +
     1097                  "Показать : " +
     1098                  (if RADIO-SET-1 = 1    then " Суммы в продажных ценах "  else " Суммы в учетных ценах " ) +
     1099                  (if x-SET_val_TYPE = 1 then "в рублях, "  else "в валюте, " ) +
     1100                  (if ShowZero           then " Показывать нулевые остатки "  else " Не показывать нулевые остатки " ) +
     1101                  (if ShowZero-2         then " Показывать нулевые обороты "  else " Не показывать нулевые обороты " )
     1102                .
     1103   Sheetf.Excel-Column-Lable = "Артикул,Название товара,".
     1104   Sheetf.Sizes = "16,60,".
     1105   for each obj-list no-lock :
     1106        Sheetf.Excel-Column-Lable = Sheetf.Excel-Column-Lable + " Объект " + obj-list.obj-type + " " + string(obj-list.obj-code) + ",,,,," .
     1107        Sheetf.Sizes = Sheetf.Sizes + Fill("15,", 5)  .
     1108   End.
     1109        Sheetf.Excel-Column-Lable = Sheetf.Excel-Column-Lable  + chr(10) +  ",,".
     1110   for each obj-list no-lock :
     1111        Sheetf.Excel-Column-Lable = Sheetf.Excel-Column-Lable + "Цена на конец периода,Остаток на начало - кол-во,Реализация - кол-во,Остаток на конец - кол-во, Остаток на конец - сумма," .
     1112   End.
     1113   sheetf.make-correct =  "".
     1114   END PROCEDURE.
     1115   PROCEDURE state-changed :
     1116     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     1117     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     1118     CASE p-state:
     1119       when "link-changed":U then  DO:
     1120            Run my-var.
     1121            End.
     1122     END CASE.
     1123   END PROCEDURE.
