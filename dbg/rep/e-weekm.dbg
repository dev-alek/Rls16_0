     1463     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1464     define variable v-cntxt-is-admin      as logical   no-undo .
     1465   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1466   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1467   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
