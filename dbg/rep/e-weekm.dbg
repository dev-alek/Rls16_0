      415   procedure create_obj-list :
      416      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      417      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      418      do
      419      on error undo, return error return-value
      420      :
      421         define buffer cli-obj for ub.clients .
      422         define variable p-var as integer no-undo .
      423         define buffer buf_obj-list for obj-list .
      424         find last buf_obj-list  use-index pi no-error .
      425         if available buf_obj-list
      426         then
      427            p-var = buf_obj-list.obj-id + 1.
      428         else
      429            p-var = 1.
      430         find first cli-obj where
      431                   cli-obj.obj-type = p-obj-type
      432               and cli-obj.obj-code = p-obj-code
      433         no-lock no-error.
      434         if available cli-obj
      435         then do:
      436            create buf_obj-list.
      437            assign
      438               buf_obj-list.obj-id   = p-var
      439               buf_obj-list.obj-code = cli-obj.obj-code
      440               buf_obj-list.obj-type = cli-obj.obj-type
      441               buf_obj-list.obj-name = cli-obj.obj-name
      442               buf_obj-list.db-num   = cli-obj.db-num
      443            .
      444         end.
      445      end.
      446   end.
