     2399           then ENTRY(1, SUBSTR(stroka-uchet, (INDEX(stroka-uchet, "4/") + 2)), "@")
     2400           else "0")  p-XL-delim
     2401          (IF INDEX(stroka-uchet, "5/") > 0
     2402           then ENTRY(1, SUBSTR(stroka-uchet, (INDEX(stroka-uchet, "5/") + 2)), "@")
     2403           else "0")  p-XL-delim
     2404          (IF INDEX(stroka-uchet, "6/") > 0
     2405           then ENTRY(1, SUBSTR(stroka-uchet, (INDEX(stroka-uchet, "6/") + 2)), "@")
     2406           else "0")  p-XL-delim
     2407          (IF INDEX(stroka-uchet, "7/") > 0
     2408           then ENTRY(1, SUBSTR(stroka-uchet, (INDEX(stroka-uchet, "7/") + 2)), "@")
     2409           else "0")  p-XL-delim
     2410          (IF INDEX(stroka-uchet, "1/") > 0
     2411           then ENTRY(1, SUBSTR(stroka-uchet, (INDEX(stroka-uchet, "1/") + 2)), "@")
     2412           else "0")  p-XL-delim
     2413          tot-uchet
     2414          skip(0).
     2415       END.
     2416       current-date = current-date + 7.
     2417   END.
     2418   IF RS-method = "ARTIC":U THEN DO:
     2419       PUT STREAM PrnLibStream UNFORMATTED
     2420       (IF X-SelectGood = 4
     2421        then "ИТОГО_ПО_ВСЕМ_ВЫБРАННЫМ_ТОВАРАМ"
     2422        ELSE "ИТОГО_ПО_ВСЕМ_ТОВАРАМ") p-XL-delim
     2423       "" p-XL-delim
     2424       "" p-XL-delim
     2425       "" p-XL-delim.
     2426   END.
     2427   ELSE
     2428   PUT STREAM PrnLibStream UNFORMATTED
     2429   (IF X-SelectGood = 4
     2430    then "ИТОГО_ПО_ВСЕМ_ВЫБРАННЫМ_ТОВАРАМ"
     2431    ELSE "ИТОГО_ПО_ВСЕМ_ТОВАРАМ") p-XL-delim.
     2432   PUT STREAM PrnLibStream UNFORMATTED
     2433   column-qnty[2] p-XL-delim
     2434   column-qnty[3] p-XL-delim
     2435   column-qnty[4] p-XL-delim
     2436   column-qnty[5] p-XL-delim
     2437   column-qnty[6] p-XL-delim
     2438   column-qnty[7] p-XL-delim
     2439   column-qnty[1] p-XL-delim
     2440   column-qnty[8] p-XL-delim
     2441   "" p-XL-delim
     2442   column-netto[2] p-XL-delim
     2443   column-netto[3] p-XL-delim
     2444   column-netto[4] p-XL-delim
     2445   column-netto[5] p-XL-delim
     2446   column-netto[6] p-XL-delim
     2447   column-netto[7] p-XL-delim
     2448   column-netto[1] p-XL-delim
     2449   column-netto[8] p-XL-delim
     2450   "" p-XL-delim
     2451   column-uchet[2] p-XL-delim
     2452   column-uchet[3] p-XL-delim
     2453   column-uchet[4] p-XL-delim
     2454   column-uchet[5] p-XL-delim
     2455   column-uchet[6] p-XL-delim
     2456   column-uchet[7] p-XL-delim
     2457   column-uchet[1] p-XL-delim
     2458   column-uchet[8] SKIP(0).
     2459   output STREAM PrnLibStream CLOSE.
     2460   if X-selectGood = 1 then do:
     2461       for each gds-list:
     2462           delete gds-list.
     2463       end.
     2464   end.
     2465   run waitfram-hide in this-procedure .
     2466   END PROCEDURE.
     2467   PROCEDURE send-records :
     2468   END PROCEDURE.
     2469   PROCEDURE state-changed :
     2470     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE NO-UNDO.
     2471     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     2472     run ini-from-SelectGood.
     2473   END PROCEDURE.
