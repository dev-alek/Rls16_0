     1487   define variable my-x-date-start as date no-undo.
     1488   define variable my-x-date-end as date no-undo.
     1489   define variable State-source as Widget-Handle.
     1490   define variable v-curr-r-b as character no-undo .
     1491   define variable p-XL-delim as character no-undo .
     1492   DEFINE VARIABLE RS-method AS CHARACTER
     1493        VIEW-AS RADIO-SET VERTICAL
     1494        RADIO-BUTTONS
     1495             "С товарами":L, "ARTIC":U,
     1496   "Без товаров":L, "TOTALS":U
     1497        SIZE 22.88 BY 2.21 NO-UNDO.
     1498   DEFINE RECTANGLE RECT-1
     1499        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1500        SIZE 29.13 BY 4.21.
     1501   DEFINE FRAME F-Main
     1502        RS-method AT ROW 3.25 COL 3.88 NO-LABEL
     1503        "Детализация" VIEW-AS TEXT
     1504             SIZE 23.38 BY .71 AT ROW 2.13 COL 4
     1505             FGCOLOR 4
     1506        RECT-1 AT ROW 1.92 COL 2
     1507       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
     1508            SIDE-LABELS NO-UNDERLINE THREE-D
     1509            AT COL 1 ROW 1
     1510            SIZE 32.25 BY 11.88.
     1511   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     1512   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     1513   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     1514   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     1515   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     1516   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     1517   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     1518   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     1519       ASSIGN adm-object-hdl = FRAME F-Main:HANDLE.
     1520   RUN ensure-broker.
     1521   THIS-PROCEDURE:ADM-DATA =
     1522        'ADM1.1~`':U +
     1523        'SmartObject~`':U +
     1524        'FRAME~`':U +
     1525        'NO ~`':U +
     1526        '~`':U +
     1527        '~`':U +
     1528        '~`':U +
     1529        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     1530           + "~`":U +
     1531        'Layout,Hide-on-Init~`':U +
     1532        '~`':U +
     1533        '~`':U +
     1534        '~`~`~`~`~`~`~`~`~`~`~`':U +
     1535        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1536            THEN "^^":U
     1537        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1538             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1539   PROCEDURE adm-apply-entry :
     1540     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1541   END PROCEDURE.
     1542   PROCEDURE adm-destroy :
     1543    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1544   END PROCEDURE.
     1545   PROCEDURE adm-disable :
     1546       DISABLE RECT-1 RS-method WITH FRAME F-Main.
     1547       RUN dispatch ('disable-fields':U).
     1548       RUN set-attribute-list ('ENABLED=no':U).
     1549       RETURN.
     1550   END PROCEDURE.
     1551   PROCEDURE adm-edit-attribute-list :
     1552         RUN adm/support/contnrd.w (INPUT THIS-PROCEDURE).
     1553         RETURN.
     1554   END PROCEDURE.
     1555   PROCEDURE adm-enable :
     1556       ENABLE UNLESS-HIDDEN RECT-1 RS-method WITH FRAME F-Main.
     1557       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     1558       RUN set-attribute-list ('ENABLED=yes':U).
     1559       RETURN.
     1560   END PROCEDURE.
     1561   PROCEDURE adm-exit :
     1562        RUN notify ('exit':U).
     1563     RETURN.
     1564   END PROCEDURE.
     1565   PROCEDURE adm-hide :
     1566     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1567   END PROCEDURE.
     1568   PROCEDURE adm-initialize :
     1569     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1570   END PROCEDURE.
     1571   PROCEDURE adm-show-errors :
     1572       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1573       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1574           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1575       END.
     1576       RETURN.
     1577   END PROCEDURE.
     1578   PROCEDURE adm-UIB-mode :
     1579     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1580   END PROCEDURE.
     1581   PROCEDURE adm-view :
     1582     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1583   END PROCEDURE.
     1584   PROCEDURE dispatch :
     1585       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1586       RUN broker-dispatch IN adm-broker-hdl
     1587           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1588       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1589   END PROCEDURE.
     1590   PROCEDURE ensure-broker :
     1591   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1592   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1593   DO:
     1594       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1595       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1596   END.
     1597   END PROCEDURE.
     1598   PROCEDURE get-attribute :
     1599     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1600     RUN broker-get-attribute IN adm-broker-hdl
     1601         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1602     RETURN RETURN-VALUE.
     1603   END PROCEDURE.
     1604   PROCEDURE get-attribute-list :
     1605     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1606     RUN broker-get-attribute-list IN adm-broker-hdl
     1607         (INPUT THIS-PROCEDURE,
     1608          INPUT ?,
     1609          OUTPUT p-attr-list) NO-ERROR.
     1610     RETURN.
     1611   END PROCEDURE.
     1612   PROCEDURE new-state :
     1613     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1614     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1615     RETURN.
     1616   END PROCEDURE.
     1617   PROCEDURE notify :
     1618     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1619     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1620     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1621         RETURN "ADM-ERROR":U.
     1622     RETURN.
     1623   END PROCEDURE.
     1624   PROCEDURE set-attribute-list :
     1625     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1626     RUN ensure-broker.
     1627     RUN broker-set-attribute-list IN adm-broker-hdl
     1628         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1629     RETURN.
     1630   END PROCEDURE.
     1631   PROCEDURE set-position :
     1632       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1633       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1634       IF VALID-HANDLE(adm-object-hdl) THEN
     1635       DO:
     1636           DEFINE VARIABLE parent-hdl AS HANDLE NO-UNDO.
     1637           IF adm-object-hdl:TYPE = "WINDOW":U THEN
     1638           DO:
     1639             IF p-row = 0 THEN p-row =
     1640               (SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2.
     1641             IF p-col = 0 THEN p-col =
     1642               (SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2.
     1643           END.
     1644           ELSE IF adm-object-hdl:TYPE = "DIALOG-BOX":U THEN
     1645           DO:
     1646             parent-hdl = adm-object-hdl:PARENT.
     1647             IF p-row = 0 THEN p-row =
     1648               ((SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2) -
     1649                 parent-hdl:ROW.
     1650             IF p-col = 0 THEN p-col =
     1651               ((SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2) -
     1652                 parent-hdl:COL.
     1653           END.
     1654           IF p-row GE 0 AND p-row < 1 THEN p-row = 1.
     1655           IF p-col GE 0 AND p-col < 1 THEN p-col = 1.
     1656         ASSIGN adm-object-hdl:ROW    =   p-row
     1657                adm-object-hdl:COLUMN =   p-col.
     1658       END.
     1659       RETURN.
     1660   END PROCEDURE.
     1661   RUN set-attribute-list ("CURRENT-PAGE=0,ADM-OBJECT-HANDLE=":U +
     1662       STRING(adm-object-hdl)).
     1663   PAUSE 0 BEFORE-HIDE.
     1664   PROCEDURE adm-change-page :
     1665     RUN broker-change-page IN adm-broker-hdl (INPUT THIS-PROCEDURE) NO-ERROR.
     1666     END PROCEDURE.
     1667   PROCEDURE delete-page :
     1668     DEFINE INPUT PARAMETER p-page# AS INTEGER NO-UNDO.
     1669     RUN broker-delete-page IN adm-broker-hdl
     1670         (INPUT THIS-PROCEDURE, INPUT p-page#).
     1671     END PROCEDURE.
     1672   PROCEDURE init-object :
     1673     DEFINE INPUT PARAMETER  p-proc-name   AS CHARACTER NO-UNDO.
     1674     DEFINE INPUT PARAMETER  p-parent-hdl  AS HANDLE    NO-UNDO.
     1675     DEFINE INPUT PARAMETER  p-attr-list   AS CHARACTER NO-UNDO.
     1676     DEFINE OUTPUT PARAMETER p-proc-hdl    AS HANDLE    NO-UNDO.
     1677     RUN broker-init-object IN adm-broker-hdl
     1678         (INPUT THIS-PROCEDURE, INPUT p-proc-name, INPUT p-parent-hdl,
     1679          INPUT p-attr-list, OUTPUT p-proc-hdl) NO-ERROR.
     1680     RETURN.
     1681   END PROCEDURE.
     1682   PROCEDURE init-pages :
     1683     DEFINE INPUT PARAMETER p-page-list      AS CHARACTER NO-UNDO.
     1684     RUN broker-init-pages IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1685         INPUT p-page-list) NO-ERROR.
     1686     END PROCEDURE.
     1687   PROCEDURE select-page :
     1688     DEFINE INPUT PARAMETER p-page#     AS INTEGER   NO-UNDO.
     1689     RUN broker-select-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1690         INPUT p-page#) NO-ERROR.
     1691     END PROCEDURE.
     1692   PROCEDURE view-page :
     1693     DEFINE INPUT PARAMETER p-page#      AS INTEGER   NO-UNDO.
     1694     RUN broker-view-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1695         INPUT p-page#).
     1696     END PROCEDURE.
     1697   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1698     run mainmenu_getcntxt in my-handle
     1699       (output v-cntxt-db-num
     1700       ,output v-cntxt-userid
     1701       ,output v-cntxt-level
     1702       ,output v-cntxt-host-code-obj
     1703       ,output v-cntxt-obj-type
     1704       ,output v-cntxt-obj-code
     1705       ,output v-cntxt-db-num-obj
     1706       ,output v-cntxt-is-admin
     1707       ) .
     1708   if not this-procedure :persistent
     1709   then do:
     1710     message
     1711       vss-workfile vss-revision vss-description skip
     1712       "Ошибка при запуске процедуры" skip
     1713       "Данную процедуру следует запускать только с параметром persistent" skip
     1714       view-as alert-box error .
     1715     undo, return error .
     1716   end.
     1717   PROCEDURE adm-create-objects :
     1718   END PROCEDURE.
     1719   PROCEDURE adm-row-available :
     1720     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
     1721     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
     1722     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
     1723     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
     1724     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
     1725     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
     1726     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
     1727     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
     1728     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
     1729     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
     1730     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
     1731     IF adm-updating-record THEN RETURN.
     1732     RUN get-attribute ('FIELDS-ENABLED':U).
     1733     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
     1734     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
     1735         OUTPUT link-handle) NO-ERROR.
     1736     IF link-handle = "":U THEN
     1737         RETURN.
     1738     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
     1739     IF NUM-ENTRIES(link-handle) > 1 THEN
     1740         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
     1741             "encountered more than one RECORD-SOURCE.":U SKIP
     1742             "The first - ":U record-source-hdl:file-name " - will be used.":U
     1743                VIEW-AS ALERT-BOX ERROR.
     1744     RUN get-attribute ('Key-Name':U).
     1745     key-name = RETURN-VALUE.
     1746     IF key-name = "":U THEN key-name = ?.
     1747     IF key-name NE ? THEN DO:
     1748       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
     1749         NO-ERROR.
     1750       IF key-value NE ? THEN
     1751         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
     1752     END.
     1753   IF VALID-HANDLE (adm-object-hdl) THEN
     1754       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1755   RUN notify IN THIS-PROCEDURE ('row-available':U).
     1756   END PROCEDURE.
     1757   PROCEDURE check-dates :
     1758   DEFINE INPUT-OUTPUT PARAMETER p-Date-Start as date no-undo.
     1759   DEFINE INPUT-OUTPUT PARAMETER p-Date-END as date no-undo.
     1760   DEFINE INPUT PARAMETER loud as logical no-undo.
     1761   define variable new-X-date-start as date no-undo.
     1762   define variable new-X-date-end as date no-undo.
     1763   IF weekday(p-date-start)  <> 2 then do:
     1764       if weekday(p-date-start) = 1 then
     1765       new-X-date-start = p-date-start + 1.
     1766       else
     1767       new-X-date-start = p-date-start - (weekday(p-date-start)  - 2).
     1768       if loud then
     1769       message "Дата начала периода должна быть понедельником!" skip
     1770               "Заменяем" p-date-start " на " new-x-date-start
     1771       view-as alert-box ERROR.
     1772       p-date-start = new-X-date-start.
     1773   end.
     1774   IF weekday(p-date-end)  <> 1 then do:
     1775       new-X-date-end = p-date-end + (8 - weekday(p-date-end)).
     1776       if loud then
     1777       message "Дата конца периода должна быть воскресеньем!" skip
     1778               "Заменяем" p-date-end " на " new-x-date-end
     1779       view-as alert-box ERROR.
     1780       p-date-end = new-X-date-end.
     1781   end.
     1782   END PROCEDURE.
     1783   PROCEDURE disable_UI :
     1784     HIDE FRAME F-Main.
     1785     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1786   END PROCEDURE.
     1787   PROCEDURE enable_UI :
     1788     DISPLAY RS-method
     1789         WITH FRAME F-Main.
     1790     ENABLE RECT-1 RS-method
     1791         WITH FRAME F-Main.
     1792   END PROCEDURE.
     1793   PROCEDURE ini-from-SelectGood :
     1794   define variable glog as logical no-undo .
     1795   CASE X-SelectGood:
     1796       WHEN 1 then do:
     1797           assign
     1798           RS-method = "TOTALS":U
     1799           .
     1800           glog = RS-Method:disable(radio-label("ARTIC":U, RS-method:radio-buttons))
     1801                        in frame F-Main.
     1802           Display
     1803           RS-MEthod
     1804           With frame F-Main
     1805           .
     1806       end.
     1807       WHEN 4 then do:
     1808           glog = RS-Method:enable(radio-label("ARTIC":U, RS-method:radio-buttons))
     1809                        in frame F-Main.
     1810           DISPLAY
     1811           RS-method
     1812           With frame F-Main
     1813           .
     1814       end.
     1815   END CASE.
     1816   END PROCEDURE.
     1817   PROCEDURE local-initialize :
     1818     RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     1819   END PROCEDURE.
     1820   PROCEDURE My-Report :
     1821   define variable glog as logical no-undo .
     1822   glog = no.
     1823   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1824   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1825     (output v-curr-r-b
     1826     )  .
     1827   define variable type-par1 as character no-undo .
     1828   define variable tmp-var1  as character no-undo .
     1829   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1830   empty temp-table thbjattr_thbj-attr.
     1831   run adm/shattri.p (
     1832      input "get":U
     1833     ,input v-cntxt-obj-type
     1834     ,input v-cntxt-obj-code
     1835     ,input 'report-firm':U
     1836     ,input  ""
     1837     ,output v-value-character
     1838     ,output v-value-date
     1839     ,output v-value-decimal
     1840     ,output v-value-integer
     1841     ,output v-value-logical
     1842     ,output par-type
     1843     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1844     ) no-error .
     1845   for each thbjattr_thbj-attr :
     1846       if thbjattr_thbj-attr.prop-code = 'XL-delim'  then tmp-var1   = thbjattr_thbj-attr.property-value-character.
     1847   end.
     1848   IF tmp-var1 = "" then p-XL-delim = ";".
     1849   else p-XL-delim = tmp-var1.
     1850   FOR EACH obj-list NO-LOCK,
     1851           FIRST ub.inkas where ub.inkas.doc-date >= my-X-Date-Start AND
     1852                      ub.inkas.doc-date <= my-X-Date-End AND
     1853                      ub.inkas.obj-type = obj-list.obj-type AND
     1854                      ub.inkas.obj-code = obj-list.obj-code NO-LOCK:
     1855                      glog = yes.
     1856   END.
     1857   if NOT glog then do:
     1858       message "Не было никаких закрытых продаж на выбранных объектах в течение заданного Вами периода времени." view-as alert-box.
     1859       return.
     1860   end.
     1861   run waitfram-show in this-procedure ('Подождите ...' ) .
     1862   RUN Print-Proc.
     1863   run waitfram-hide in this-procedure .
     1864   END PROCEDURE.
     1865   PROCEDURE My-var :
     1866   define variable State-source as handle.
     1867   define variable my#x-date-start  like  x-date-start no-undo.
     1868   define variable my#x-date-end    like  x-date-end   no-undo.
     1869   Assign FRAME F-Main Rs-Method .
     1870   Assign
     1871    STR-obj-type = ''
     1872    STR-obj-code = ''
     1873    STR-obj-name = ''
     1874    STR-obj      = ''.
     1875   For each obj-list no-lock:
     1876    Assign
     1877    STR-obj-type = STR-obj-type + obj-list.obj-type + ','
     1878    STR-obj-code = STR-obj-code + String(obj-list.obj-code) + ','
     1879    STR-obj-name = STR-obj-name + obj-list.obj-name + ','
     1880    STR-obj = STR-obj +  obj-list.obj-type + '#' + string(obj-list.obj-code)  + ',' .
     1881   End.
     1882   ReportNAme = "Понедельный отчет по товарам".
     1883   ReportHeader =  radio-label(RS-method, RS-method:radio-buttons).
     1884   assign
     1885   my-x-date-start = x-date-start
     1886   my-x-date-end = x-date-end
     1887   my#x-date-start = x-date-start
     1888   my#x-date-end = x-date-end
     1889   .
     1890   run check-dates(input-output my-X-date-Start, input-output my-X-date-End, yes).
     1891   x-date-start = my-x-date-start  .
     1892   x-date-end   = my-x-date-end    .
     1893    IF ( my#x-date-start <> my-x-date-start
     1894      OR my#x-date-end <> my-x-date-end) THEN DO:
     1895     RUN get-attribute IN THIS-PROCEDURE ('UIB-MODE').
     1896     IF RETURN-VALUE NE "DESIGN" THEN DO:
     1897       RUN get-link-handle IN adm-broker-hdl ( THIS-PROCEDURE, 'State':U , OUTPUT source-str ).
     1898       State-source = WIDGET-HANDLE ( source-str ).
     1899       IF not VALID-HANDLE ( State-source ) THEN
     1900         Message "Не определен линк " 'State':U view-as alert-box error.
     1901     END.
     1902      Run Select1 IN State-source.
     1903      Return error 'First-page':U.
     1904   End.
     1905   END PROCEDURE.
     1906   PROCEDURE Print-Proc :
     1907   define variable is-out as integer init 1.
     1908   def buffer ret-doc for ub.trn-doc.
     1909   define variable doc-num like ub.trn-doc.doc-code no-undo.
     1910   define variable doc-date like ub.trn-doc.doc-date no-undo.
     1911   define variable jj as integer no-undo.
     1912   define variable cur-quant like ub.gds-dtl.doc-qnty no-undo.
     1913   define variable tot-qnty as decimal.
     1914   define variable tot-netto as decimal.
     1915   define variable tot-uchet as decimal.
     1916   define variable column-qnty as decimal extent 8.
     1917   define variable column-netto as decimal extent 8.
     1918   define variable column-uchet as decimal extent 8.
     1919   define variable current-date as date format "99/99/9999" no-undo.
     1920   define variable stroka-qnty as char.
     1921   define variable stroka-netto as char.
     1922   define variable stroka-uchet as char.
     1923   define variable i as integer no-undo .
     1924   define variable date_string     as      char    no-undo.
     1925   define variable tdoc-code     as      char    no-undo.
     1926   define variable s-price as decimal no-undo .
     1927   define variable cur-discnt as decimal no-undo .
     1928   define variable g#log as logical no-undo .
     1929   ASSIGN
     1930   frame F-Main RS-METHOD.
     1931   run waitfram-show in this-procedure ( "Подождите ..." ).
     1932   FOR EACH sj-goods :
     1933       delete sj-goods .
     1934   END .
     1935   IF X-SelectGood = 1 then do:
     1936       create gds-list.
     1937   END.
     1938   FOR EACH obj-list NO-LOCK,
     1939       EACH ub.inkas WHERE
     1940            ub.inkas.doc-date >= my-X-Date-Start and
     1941            ub.inkas.doc-date <= my-X-Date-End AND
     1942            ub.inkas.obj-code = obj-list.obj-code and
     1943            ub.inkas.obj-type = obj-list.obj-type AND
     1944            ub.inkas.status_ = 'факт':U NO-LOCK:
     1945       FIND FIRST ub.trn-doc WHERE ub.trn-doc.doc-code = ub.inkas.inkas-code NO-LOCK NO-ERROR.
     1946       FIND FIRST ret-doc WHERE ret-doc.doc-code = ub.trn-doc.out-code NO-LOCK NO-ERROR.
     1947       assign
     1948       doc-num = ub.trn-doc.doc-code
     1949       doc-date = ub.inkas.doc-date
     1950       is-out = 1.
     1951   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1952      FOR EACH ub.doc-line WHERE ub.doc-line.doc-code = doc-num NO-LOCK,
     1953               EACH ub.gds-dtl WHERE ub.gds-dtl.doc-code = doc-num AND
     1954                                                   ub.gds-dtl.artic = ub.doc-line.artic AND
     1955                                                   ub.gds-dtl.prod-type = ub.doc-line.prod-type AND
     1956                                                   ub.gds-dtl.prod-code = ub.doc-line.prod-code
     1957                                                   NO-LOCK:
     1958           PROCESS EVENTS.
     1959           jj = jj + 1 .
     1960           if ( jj  modulo 10 ) = 0  then
     1961               run waitfram-show in this-procedure (input ( "Обработано строк накладных : " +
     1962                                           string(  jj ) ) ).
     1963              IF X-SelectGood = 4  AND NOT (can-find(FIRST gds-list WHERE
     1964                                                gds-list.artic = ub.doc-line.artic AND
     1965                                                gds-list.prod-type = ub.doc-line.prod-type AND
     1966                                                gds-list.prod-code = ub.doc-line.prod-code)) THEN NEXT.
     1967           assign
     1968           s-price = (if v-curr-r-b = 'rubl':U then ub.gds-dtl.price-rubl else ub.gds-dtl.price-base)
     1969           cur-discnt = (if v-curr-r-b = 'rubl':U then  ub.gds-dtl.discnt-rubl else ub.gds-dtl.discnt-base)
     1970           cur-quant = is-out * ub.gds-dtl.doc-qnty.
     1971           IF RS-method = "artic":U THEN
     1972           FIND FIRST sj-goods WHERE
     1973                               sj-goods.artic = ub.doc-line.artic AND
     1974                               sj-goods.prod-type = ub.doc-line.prod-type AND
     1975                               sj-goods.prod-code = ub.doc-line.prod-code AND
     1976                               sj-goods.date_ = doc-date NO-ERROR .
     1977           ELSE
     1978           FIND FIRST sj-goods WHERE
     1979                               sj-goods.date_ = doc-date
     1980                                                  NO-ERROR .
     1981           if NOT available sj-goods then
     1982               do:
     1983                   CREATE sj-goods.
     1984                   CASE RS-method:
     1985                       WHEN "artic":U then do:
     1986                           assign
     1987                           sj-goods.date_ = doc-date
     1988                           sj-goods.weekn = TRUNCATE(decimal(sj-goods.date_ - my-X-date-Start) / 7 , 0)
     1989                           sj-goods.artic = ub.doc-line.artic
     1990                           sj-goods.prod-type = ub.doc-line.prod-type
     1991                           sj-goods.prod-code = ub.doc-line.prod-code.
     1992                       end.
     1993                       WHEN "TOTALS":U then
     1994                           assign
     1995                           sj-goods.date_ = doc-date
     1996                           sj-goods.weekn = TRUNCATE(decimal(sj-goods.date_ - my-X-date-Start) /  7 , 0)
     1997                           .
     1998                 END CASE.
     1999               end.
     2000               assign
     2001               sj-goods.qnty = sj-goods.qnty + cur-quant
     2002               sj-goods.brutto-sum = sj-goods.brutto-sum + ( cur-quant * s-price )
     2003               sj-goods.discnt-sum = sj-goods.discnt-sum + ( cur-discnt * cur-quant )
     2004               sj-goods.uchet-sum = sj-goods.uchet-sum +
     2005                                    (if v-curr-r-b = 'rubl':U
     2006                                    then ub.doc-line.price-rubl
     2007                                    else ub.doc-line.price-base) * cur-quant
     2008               .
     2009           END.
     2010         if available ret-doc then do:
     2011         assign
     2012         doc-num = ret-doc.doc-code
     2013         is-out = -1.
     2014   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2015      FOR EACH ub.doc-line WHERE ub.doc-line.doc-code = doc-num NO-LOCK,
     2016               EACH ub.gds-dtl WHERE ub.gds-dtl.doc-code = doc-num AND
     2017                                                   ub.gds-dtl.artic = ub.doc-line.artic AND
     2018                                                   ub.gds-dtl.prod-type = ub.doc-line.prod-type AND
     2019                                                   ub.gds-dtl.prod-code = ub.doc-line.prod-code
     2020                                                   NO-LOCK:
     2021           PROCESS EVENTS.
     2022           jj = jj + 1 .
     2023           if ( jj  modulo 10 ) = 0  then
     2024               run waitfram-show in this-procedure (input ( "Обработано строк накладных : " +
     2025                                           string(  jj ) ) ).
     2026              IF X-SelectGood = 4  AND NOT (can-find(FIRST gds-list WHERE
     2027                                                gds-list.artic = ub.doc-line.artic AND
     2028                                                gds-list.prod-type = ub.doc-line.prod-type AND
     2029                                                gds-list.prod-code = ub.doc-line.prod-code)) THEN NEXT.
     2030           assign
     2031           s-price = (if v-curr-r-b = 'rubl':U then ub.gds-dtl.price-rubl else ub.gds-dtl.price-base)
     2032           cur-discnt = (if v-curr-r-b = 'rubl':U then  ub.gds-dtl.discnt-rubl else ub.gds-dtl.discnt-base)
     2033           cur-quant = is-out * ub.gds-dtl.doc-qnty.
     2034           IF RS-method = "artic":U THEN
     2035           FIND FIRST sj-goods WHERE
     2036                               sj-goods.artic = ub.doc-line.artic AND
     2037                               sj-goods.prod-type = ub.doc-line.prod-type AND
     2038                               sj-goods.prod-code = ub.doc-line.prod-code AND
     2039                               sj-goods.date_ = doc-date NO-ERROR .
     2040           ELSE
     2041           FIND FIRST sj-goods WHERE
     2042                               sj-goods.date_ = doc-date
     2043                                                  NO-ERROR .
     2044           if NOT available sj-goods then
     2045               do:
     2046                   CREATE sj-goods.
     2047                   CASE RS-method:
     2048                       WHEN "artic":U then do:
     2049                           assign
     2050                           sj-goods.date_ = doc-date
     2051                           sj-goods.weekn = TRUNCATE(decimal(sj-goods.date_ - my-X-date-Start) / 7 , 0)
     2052                           sj-goods.artic = ub.doc-line.artic
     2053                           sj-goods.prod-type = ub.doc-line.prod-type
     2054                           sj-goods.prod-code = ub.doc-line.prod-code.
     2055                       end.
     2056                       WHEN "TOTALS":U then
     2057                           assign
     2058                           sj-goods.date_ = doc-date
     2059                           sj-goods.weekn = TRUNCATE(decimal(sj-goods.date_ - my-X-date-Start) /  7 , 0)
     2060                           .
     2061                 END CASE.
     2062               end.
     2063               assign
     2064               sj-goods.qnty = sj-goods.qnty + cur-quant
     2065               sj-goods.brutto-sum = sj-goods.brutto-sum + ( cur-quant * s-price )
     2066               sj-goods.discnt-sum = sj-goods.discnt-sum + ( cur-discnt * cur-quant )
     2067               sj-goods.uchet-sum = sj-goods.uchet-sum +
     2068                                    (if v-curr-r-b = 'rubl':U
     2069                                    then ub.doc-line.price-rubl
     2070                                    else ub.doc-line.price-base) * cur-quant
     2071               .
     2072           END.
     2073      end.
     2074   END.
