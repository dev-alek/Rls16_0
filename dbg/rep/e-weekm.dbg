     1056   define variable mFameOldVis as logical no-undo.
     1057   define variable mVisCUrentVin as logical no-undo.
     1058   if session:batch-mode
     1059   then
     1060      mBatchMode = yes.
     1061   if mBatchMode = ? then do:
     1062     mVisCUrentVin = current-window:visible.
     1063     mFameOldVis = mFramBachModHandle:visible.
     1064     mFramBachModHandle:visible  = yes.
     1065     mBatchMode = mFramBachModHandle:visible ne yes.
     1066     mFramBachModHandle:visible = mFameOldVis.
     1067     current-window:visible = mVisCUrentVin.
     1068   end.
     1069    if  log-manager:logfile-name ne ?
     1070     then DO:
     1071         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1072         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1073         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1074     end.
     1075   on choose of B-WaitFramStop in frame waitfram
     1076   do:
     1077     mWaitFramStop = yes.
     1078     mWaitFramStopUser = yes.
     1079   end.
     1080   function waitfram-check-timeout returns logical():
     1081      define variable vtime as int64 no-undo.
     1082      if mWaitFramStopTimeOut
     1083      then
     1084         return yes.
     1085      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1086      if     mWaitFramTimeOut ne ?
     1087         and mWaitFramTimeOut ne 0
     1088         and mWaitFramTimeOut lt vtime
     1089      then do:
     1090         mWaitFramStopTimeOut = yes.
     1091      end.
     1092      return mWaitFramStopTimeOut.
     1093   end.
     1094   procedure waitfram-hide :
     1095     if not session:batch-mode
     1096     then do
     1097     on error undo, return error return-value
     1098     :
     1099       pause 0 before-hide .
     1100       if not mBatchMode then
     1101         hide frame waitfram .
     1102     if     not mWaitFramView
     1103        and mWaitProcEvent
     1104     then
     1105       process events .
     1106     end.
     1107   end procedure.
     1108   procedure waitfram-show :
     1109     define input  parameter p-message as character no-undo .
     1110     define variable v-left-margin as integer   no-undo .
     1111     if not session:batch-mode
     1112     then do
     1113     on error undo, return error return-value
     1114     :
     1115       if length(p-message) <= 70 then do:
     1116         assign
     1117           v-left-margin = integer((70 - length(p-message)) / 2)
     1118         .
     1119         assign
     1120           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1121         .
     1122         assign
     1123           v-waitfram-action01 = " "
     1124           v-waitfram-action02 = " "
     1125                                    + fill(" ", v-left-margin)
     1126                                    + p-message
     1127           v-waitfram-action03 = " "
     1128         .
     1129       end.
     1130       else do:
     1131         define variable vRindex1 as integer no-undo.
     1132         define variable vRindex2 as integer no-undo.
     1133         vRindex1 = r-index(p-message," ",70).
     1134         if vRindex1 = 0
     1135         then
     1136            vRindex1 = 70.
     1137         if length(p-message)  <= vRindex1 + 70 then do:
     1138           assign
     1139             v-waitfram-action01 = " "
     1140             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1141             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1142           .
     1143         end.
     1144         else do:
     1145           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1146           if vRindex2 <= vRindex1
     1147           then
     1148              vRindex2 = vRindex1 + 70.
     1149           assign
     1150             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1151             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1152             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1153           .
     1154         end.
     1155       end.
     1156       B-viewProcInfo:visible   in frame waitfram = no.
     1157       B-viewProcInfo:sensitive in frame waitfram = no.
     1158       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1159       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1160       if  (   mWaitFramView
     1161          or  mWaitProcEvent)
     1162          and not mBatchMode
     1163       then
     1164          display
     1165             v-waitfram-action01 skip
     1166             v-waitfram-action02 skip
     1167             v-waitfram-action03 skip
     1168          with frame waitfram .
     1169       if     mWaitFramView
     1170          then do:
     1171             if     mWaitFramInterval ne ?
     1172                and not mBatchMode
     1173             then
     1174                wait-for go of frame waitfram pause mWaitFramInterval.
     1175          end.
     1176          else
     1177             if     mWaitProcEvent
     1178                and not mBatchMode
     1179             then
     1180                process events .
     1181     end.
     1182   end procedure.
     1183      procedure waitfram-show-this:
     1184         define input  parameter iInterval as int64 no-undo.
     1185         define variable vtime as int64 no-undo.
     1186         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1187         mWaitFramInterval = iInterval.
     1188         run waitfram-show (substitute("&1&2 &3&4" ,
     1189                                       mWaitFramTextBeg ,
     1190                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1191                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1192                                       mWaitFramTextEnd
     1193                                      )
     1194                           ).
     1195      end.
     1196      procedure WaitFramRunPause:
     1197         define input  parameter iInterval as dec no-undo.
     1198         define variable vStart  as datetime-tz no-undo.
     1199         define variable vend    as datetime-tz no-undo.
     1200         define variable vint as int64 no-undo.
     1201         define variable vOk as logical no-undo.
     1202         vStart = now.
     1203         vend   = vStart.
     1204         publish "WaitFramPause" (iInterval,output vOk).
     1205         vend   =  now.
     1206         vint = vend - vStart.
     1207         vint = iInterval - vint / 1000.
     1208         if     not mWaitFramStop
     1209            and (   vint > 0
     1210                 or (    not vOk
     1211                     and iInterval eq ?
     1212                     )
     1213                 )
     1214         then
     1215            run waitfram-show-this (iInterval).
     1216         vend   =  now.
     1217         vint = vend - vStart.
     1218         vint = iInterval - vint / 1000.
     1219         if     not mWaitFramStop
     1220            and vint > 0
     1221         then do:
     1222            run gbl/pause.p (vint * 1000).
     1223         end.
     1224         if iInterval ne ?
     1225         then
     1226            publish "WaitFramStop".
     1227         waitfram-check-timeout().
     1228      end.
     1229      procedure WaitFramWaitFor:
     1230         define input  parameter iInterval as dec no-undo.
     1231         assign
     1232            mWaitFramStartProc   = now
     1233            mWaitFramStopUser    = no
     1234            mWaitFramStopTimeOut = no
     1235         .
     1236         block-wait:
     1237         do while not mWaitFramStop:
     1238            run WaitFramRunPause (iInterval).
     1239            if  waitfram-check-timeout()
     1240            then do:
     1241               leave block-wait.
     1242            end.
     1243         end.
     1244         run waitfram-hide.
     1245      end.
     1246   procedure waitfram-join :
     1247     define input  parameter p-line-1  as character no-undo .
     1248     define input  parameter p-line-2  as character no-undo .
     1249     define input  parameter p-line-3  as character no-undo .
     1250     define output parameter p-message as character no-undo .
     1251     do
     1252     on error undo, return error return-value
     1253     :
     1254       assign
     1255         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1256                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1257                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1258       .
     1259     end.
     1260   end procedure.
     1261   function waitfram-join-function returns character
     1262     (input p-line-1 as character
     1263     ,input p-line-2 as character
     1264     ,input p-line-3 as character
     1265     ).
     1266     define variable v-message as character no-undo .
     1267     run waitfram-join in this-procedure
     1268       (input  p-line-1
     1269       ,input  p-line-2
     1270       ,input  p-line-3
     1271       ,output v-message
     1272       ) .
     1273     return v-message .
     1274   end function .
     1275   function diff-list returns character (
     1276     input parfirst-list  as character,
     1277     input parsecond-list as character,
     1278     input pardelim       as character).
     1279     if pardelim = ""
     1280     or pardelim = ?
     1281     then do:
     1282       assign
     1283         pardelim = ","
     1284       .
     1285     end.
     1286     def var ind as integer no-undo .
     1287     def var v-elem as character no-undo .
     1288     def var v-result-list as character no-undo init "".
     1289     def var v-num-parfirst-list as integer no-undo .
     1290     assign
     1291       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
     1292     .
     1293     do ind = 1 to v-num-parfirst-list
     1294     :
     1295       assign
     1296         v-elem = entry(ind, parfirst-list, pardelim)
     1297       .
     1298       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
     1299         assign
     1300           v-result-list = v-result-list
     1301                         + (if v-result-list > "" then pardelim else "")
     1302                         + v-elem
     1303         .
     1304       end.
     1305     end.
     1306     return v-result-list .
     1307   end function.
     1308   function add-list returns character (
     1309    input parfirst-list  as character,
     1310    input parsecond-list as character,
     1311    input pardelim       as character).
     1312     if pardelim = ""
     1313     or pardelim = ?
     1314     then do:
     1315       assign
     1316         pardelim = ","
     1317       .
     1318     end.
     1319     def var ind as integer no-undo .
     1320     def var v-elem as character no-undo .
     1321     def var v-result-list as character no-undo init "".
     1322     def var v-num-parfirst-list as integer no-undo .
     1323     assign
     1324       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
     1325     .
     1326     do ind = 1 to v-num-parfirst-list
     1327     :
     1328       assign
     1329         v-elem = entry(ind, parfirst-list, pardelim)
     1330       .
     1331       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
     1332         assign
     1333           v-result-list = v-result-list
     1334                         + (if v-result-list > "" then pardelim else "")
     1335                         + v-elem
     1336         .
     1337       end.
     1338     end.
     1339     def var v-num-parsecond-list as integer no-undo .
     1340     assign
     1341       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
     1342     .
     1343     do ind = 1 to v-num-parsecond-list
     1344     :
     1345       assign
     1346         v-elem = entry(ind, parsecond-list, pardelim)
     1347       .
     1348       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
     1349         assign
     1350           v-result-list = v-result-list
     1351                         + (if v-result-list > "" then pardelim else "")
     1352                         + v-elem
     1353         .
     1354       end.
     1355     end.
     1356     return v-result-list .
     1357   end function.
     1358   function cross-list returns character (
     1359    input parfirst-list  as character,
     1360    input parsecond-list as character,
     1361    input pardelim       as character).
     1362     if pardelim = ""
     1363     or pardelim = ?
     1364     then do:
     1365       assign
     1366         pardelim = ","
     1367       .
     1368     end.
     1369     def var ind as integer no-undo .
     1370     def var v-elem as character no-undo .
     1371     def var v-result-list as character no-undo init "".
     1372     def var v-num-parfirst-list as integer no-undo .
     1373     assign
     1374       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
     1375     .
     1376     do ind = 1 to v-num-parfirst-list
     1377     :
     1378       assign
     1379         v-elem = entry(ind, parfirst-list, pardelim)
     1380       .
     1381       if lookup(v-elem, v-result-list, pardelim) = 0
     1382       and lookup(v-elem, parsecond-list, pardelim) > 0
     1383       then do:
     1384         assign
     1385           v-result-list = v-result-list
     1386                         + (if v-result-list > "" then pardelim else "")
     1387                         + v-elem
     1388         .
     1389       end.
     1390     end.
     1391     return v-result-list .
     1392   end function.
     1393   function radio-label returns character (
     1394    input par-rs-value  as character,
     1395    input par-rs-radio-buttons as character)
     1396    .
     1397    DEFINE variable v-result-label as character no-undo.
     1398    assign
     1399    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
     1400                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
     1401                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
     1402                             ), par-rs-radio-buttons
     1403                           )
     1404    v-result-label = REPLACE(v-result-label, "&":U, "":U)
     1405    .
     1406   return v-result-label.
     1407   end function.
     1408   function m-radio-label returns character (
     1409    input par-rs-value  as character,
     1410    input par-rs-radio-buttons as character,
     1411    input par-delim as character
     1412    )
     1413    .
     1414    DEFINE variable v-result-label as character no-undo.
     1415    assign
     1416    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
     1417                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
     1418                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
     1419                             ), par-rs-radio-buttons, par-delim
     1420                           )
     1421    v-result-label = REPLACE(v-result-label, "&":U, "":U)
     1422    .
     1423   return v-result-label.
     1424   end function.
     1425   FUNCTION mixlist returns character
     1426   (
     1427    input parfirst-list  as character
     1428    ,input parsecond-list as character
     1429    ,input pardelim       as character
     1430    ,input pardelim-result as character ) :
     1431     if pardelim = ""
     1432     or pardelim = ?
     1433     then do:
     1434       assign
     1435         pardelim = ","
     1436       .
     1437     end.
     1438     def var ind as integer no-undo .
     1439     def var v-elem1 as character no-undo .
     1440     def var v-elem2 as character no-undo .
     1441     def var v-result-list as character no-undo init "".
     1442     do ind = 1 to num-entries(parfirst-list, pardelim)
     1443     :
     1444       assign
     1445         v-elem1 = entry(ind, parfirst-list, pardelim)
     1446         v-elem2 = entry(ind, parsecond-list, pardelim)
     1447       .
     1448         assign
     1449           v-result-list = v-result-list
     1450                         + (if v-result-list > "" then pardelim-result else "")
     1451                         + v-elem1 + pardelim-result + v-elem2
     1452         .
     1453     end.
     1454     return v-result-list .
     1455   END FUNCTION.
     1456   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1457     define variable v-cntxt-db-num        as integer   no-undo .
