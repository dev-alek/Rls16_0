      822   def var vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      823   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
      824   procedure paramls-clear :
      825     define buffer buf_temp-param for temp-param .
      826     do
      827     on error undo, return error return-value
      828     :
      829       for each buf_temp-param
      830       on error undo, return error
      831       :
      832         delete buf_temp-param .
      833       end.
      834     end.
      835   end procedure.
      836   procedure paramls-write :
      837     define input  parameter p-code     as character no-undo .
      838     define input  parameter p-sub-code as character no-undo .
      839     define input  parameter p-value    as character no-undo .
      840     define buffer buf_temp-param for temp-param .
      841     do
      842     on error undo, return error return-value
      843     :
      844       find first buf_temp-param
      845         where buf_temp-param.param-code     = p-code
      846           and buf_temp-param.param-sub-code = p-sub-code
      847         no-error .
      848       if not available buf_temp-param then do:
      849         create buf_temp-param .
      850         assign
      851           buf_temp-param.param-code     = p-code
      852           buf_temp-param.param-sub-code = p-sub-code
      853         .
      854       end.
      855       assign
      856         buf_temp-param.param-value = p-value
      857       .
      858     end.
      859   end procedure.
      860   procedure paramls-read :
      861     define input  parameter p-code          as character no-undo .
      862     define input  parameter p-sub-code      as character no-undo .
      863     define input  parameter p-default-value as character no-undo .
      864     define output parameter p-value         as character no-undo .
      865     define buffer buf_temp-param for temp-param .
      866     do
      867     on error undo, return error return-value
      868     :
      869       find first buf_temp-param
      870         where buf_temp-param.param-code     = p-code
      871           and buf_temp-param.param-sub-code = p-sub-code
      872         no-error .
      873       if available buf_temp-param then do:
      874         assign
      875           p-value = buf_temp-param.param-value
      876         .
      877       end.
      878       else do:
      879         assign
      880           p-value = p-default-value
      881         .
      882       end.
      883     end.
      884   end procedure.
      885   procedure paramls-append :
      886     define input  parameter p-code     as character no-undo .
      887     define input  parameter p-sub-code as character no-undo .
      888     define input  parameter p-value    as character no-undo .
      889     define buffer buf_temp-param for temp-param .
      890     do
      891     on error undo, return error return-value
      892     :
      893       find first buf_temp-param
      894            where buf_temp-param.param-code     = p-code
      895              and buf_temp-param.param-sub-code = p-sub-code
      896         no-error .
      897       if not available buf_temp-param then do:
      898         create buf_temp-param .
      899         assign
      900           buf_temp-param.param-code     = p-code
      901           buf_temp-param.param-sub-code = p-sub-code
      902           buf_temp-param.param-value    = p-value
      903         .
      904       end.
      905       else do:
      906           assign
      907               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
      908           .
      909       end.
      910     end.
      911   end procedure.
      912   function excel-format-dec-to-char returns char (input p-dec as decimal ).
      913     if num-entries(string(p-dec), '.') = 2
      914       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
      915       else return( string(p-dec)) .
      916   end function.
      917   function format-point-to-comma returns char (input orig as char ) .
      918   define variable rtext as character no-undo .
      919   define variable strt as integer no-undo .
      920   define variable leng as integer no-undo .
      921   assign rtext = orig .
      922   repeat:
      923     strt =  index(rtext,'.').
      924     if strt = 0 then leave.
      925     leng = 1.
      926     substring(rtext,strt,leng,"character") = v-delim .
      927   end.
      928   return rtext.
      929   end function.
      930   function format-excel-text returns char ( input start-text as char ) :
      931   def var  i    as int no-undo.
      932   def var  ch   as char no-undo.
      933   def var  n    as int no-undo.
      934   def var  ipos as int no-undo.
      935     n = num-entries(trim(start-text), chr(10)) - 1 .
      936     do i = 1 to n :
      937       ipos = index( start-text, chr(10)).
      938       if ipos > 0 then
      939         substr( start-text, ipos, 1 ) = ' '.
      940     end.
      941     n = num-entries(trim(start-text), chr(13)) - 1 .
      942     do i = 1 to n :
      943       ipos = index( start-text, chr(13)).
      944       if ipos > 0 then
      945         substr( start-text, ipos, 1 ) = ' '.
      946     end.
      947     if index( start-text, '"' ) = 0 then
      948       start-text =  '="'   + trim( start-text) + '"'   .
      949       else do:
      950         n = num-entries(trim(start-text), '"') - 1.
      951         do i = 1 to n :
      952           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      953         end.
      954         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      955         start-text = '="'  + ch  + '"' .
      956       end.
      957     return start-text.
      958   end.
      959   function excel-sum returns char (input p-dec as decimal ).
      960     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
      961   end function.
      962   function excel-qnty returns char (input p-dec as decimal ).
      963     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
      964   end function.
      965   function format-excel-text-macr returns char ( input start-text as char ) :
      966   def var  i    as int no-undo.
      967   def var  ch   as char no-undo.
      968   def var  n    as int no-undo.
      969   def var  ipos as int no-undo.
      970     n = num-entries(trim(start-text), chr(10)) - 1 .
      971     do i = 1 to n :
      972       ipos = index( start-text, chr(10)).
      973       if ipos > 0 then
      974         substring( start-text, ipos , 1 ) = ' '.
      975     end.
      976     n = num-entries(trim(start-text), chr(13)) - 1 .
      977     do i = 1 to n :
      978       ipos = index( start-text, chr(13)).
      979       if ipos > 0 then
      980         substring( start-text, ipos, 1 ) = ' '.
      981     end.
      982     if index( start-text, '"' ) = 0 then
      983       start-text =  '"'   + trim( start-text) + '"'   .
      984       else do:
      985         n = num-entries(trim(start-text), '"') - 1.
      986         do i = 1 to n :
      987           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      988         end.
      989         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      990         start-text = '"'  + ch  + '"' .
      991       end.
      992     n = num-entries(trim(start-text), chr(10)) - 1 .
      993     do i = 1 to n :
      994       ipos = index( start-text, chr(10)).
      995       if ipos > 0 then
      996         substring( start-text, ipos , 1 ) = ' '.
      997     end.
      998       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
      999     return start-text.
     1000   end.
     1001   def var vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1002   function func-get-name-from-ext-type   returns char
     1003     ( p-ext-type as character   ,
     1004       p-caps     as logical ).
     1005   define variable v-ext-name as character no-undo .
     1006   run get-name-from-ext-type in this-procedure (
     1007       input p-ext-type  ,
     1008       input p-caps  ,
     1009       output v-ext-name )
     1010       no-error .
     1011       if error-status :error then do:
     1012          assign
     1013            v-ext-name = p-ext-type
     1014          .
     1015       end.
     1016    return (v-ext-name) .
     1017   end.
     1018   procedure get-name-from-ext-type :
     1019    do
     1020    on error undo, return error return-value
     1021    :
     1022   define input  parameter p-ext-type as character no-undo .
     1023   define input  parameter p-caps     as logical no-undo   .
     1024   define output parameter p-ext-name as character no-undo .
     1025   define variable v-num as integer no-undo .
     1026     if lookup ( p-ext-type , 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ) = 0 then do :
     1027       message
     1028         vss-include-info10 skip
     1029         "Неправильно задано значение входящего параметра! "
     1030         "Нет такого типа документов " p-ext-type
     1031         view-as alert-box error .
     1032         undo, return error .
     1033     end.
     1034     v-num      = lookup ( p-ext-type , 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ) .
     1035     p-ext-name = entry  ( v-num , 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U ) .
     1036     if p-caps  = true then do :
     1037        p-ext-name = caps(substring(p-ext-name,1,1) ) + substring(p-ext-name, 2 , length (p-ext-name) - 1 ) .
     1038     end .
     1039     end.
     1040   end procedure.
     1041   Make-Excel      = true.
     1042   Make-Excel-com  = false .
     1043   define buffer buf_abc-analysis            for ub.abc-analysis.
     1044   define buffer buf_abc-analysis-goods      for ub.abc-analysis-goods.
     1045   define buffer buf_abc-analysis-gds-obj    for ub.abc-analysis-gds-obj.
     1046   define buffer buf_abc-analysis-obj        for ub.abc-analysis-obj.
     1047   define buffer buf_assortment-matrix       for ub.assortment-matrix.
     1048   define buffer buf_assortment-matrix-goods for ub.assortment-matrix-goods.
     1049   define buffer buf_gds-obj-prop            for ub.gds-obj-prop .
     1050   define buffer buf_criterion-analysis      for ub.criterion-analysis .
     1051   define buffer buf_abc-analysis-prod       for ub.abc-analysis-prod  .
     1052   define buffer buf_clients for ub.clients  .
     1053   DEFINE temp-table temp-str no-undo
     1054     field   gds-code    as integer
     1055     field   artic       as char
     1056     field   gds-name    as char
     1057     field   grp-code    as int
     1058     field   grp-name    as char
     1059     field   prod-name   as char
     1060     field   prod-type   as char
     1061     field   prod-code   as int
     1062     field   prc         as char
     1063   index  pi  IS PRIMARY  prc
     1064   .
     1065   DEFINE temp-table temp-prod no-undo
     1066     field prc          as char
     1067     field prod-type    as char
     1068     field prod-code    as integer
     1069     field prod-name    as char
     1070   index  pi  IS PRIMARY  prc
     1071   index  pi1 prod-type prod-code
     1072   .
     1073   define temp-table temp-abc no-undo
     1074     field  nn         as integer
     1075     field  id         as integer
     1076     field  db-num      like ub.abc-analysis.db-num
     1077     field  type        as character
     1078     field  name        like ub.abc-analysis.abc-name
     1079     field  des         like ub.abc-analysis.abc-des
     1080     field  name-cral   like ub.criterion-analysis.cral-name
     1081     field  A           like ub.abc-analysis.abc-a
     1082     field  B           like ub.abc-analysis.abc-b
     1083     field  C           like ub.abc-analysis.abc-c
     1084     field  D           like ub.abc-analysis.abc-d
     1085     field  E           like ub.abc-analysis.abc-E
     1086     field  F           like ub.abc-analysis.abc-F
     1087     field  date-cr     like ub.abc-analysis.abc-date-create
     1088     field  period       as character
     1089     field  ext-doc-type as character
     1090     field  obj          as character
     1091     index pi nn
     1092     index pi2 id db-num
     1093   .
     1094   define variable var-i as integer   no-undo .
     1095   define variable var-kol as integer   no-undo .
     1096   define variable number-group as character no-undo .
     1097   define variable i-numb as integer   no-undo .
     1098   var-kol = num-entries (p-rez).
     1099   repeat var-i = 1 to var-kol :
     1100      find first buf_abc-analysis no-lock where recid(buf_abc-analysis) = int(entry(var-i,p-rez )) no-error .
     1101      if not available buf_abc-analysis  then next.
     1102      find first  buf_criterion-analysis no-lock where buf_criterion-analysis.cral-id = buf_abc-analysis.cral-id no-error .
     1103      if not available buf_criterion-analysis  then next.
     1104       create temp-abc.
     1105       assign
     1106       temp-abc.nn          = var-i
     1107       temp-abc.id          = buf_abc-analysis.abc-id
     1108       temp-abc.db-num      = buf_abc-analysis.db-num
     1109       temp-abc.type        = if buf_abc-analysis.abc-type = "2"  then "Двухпроходный, ограничение Е <= " + string(buf_abc-analysis.le-proc)  else " "
     1110       temp-abc.name        = buf_abc-analysis.abc-name
     1111       temp-abc.des         = buf_abc-analysis.abc-des
     1112       temp-abc.name-cral   = buf_criterion-analysis.cral-name
     1113       temp-abc.A           = buf_abc-analysis.abc-a
     1114       temp-abc.B           = buf_abc-analysis.abc-b
     1115       temp-abc.C           = buf_abc-analysis.abc-c
     1116       temp-abc.D           = buf_abc-analysis.abc-d
     1117       temp-abc.E           = buf_abc-analysis.abc-E
     1118       temp-abc.F           = buf_abc-analysis.abc-F
     1119       temp-abc.date-cr     = buf_abc-analysis.abc-date-create
     1120       temp-abc.period      = buf_abc-analysis.abc-string-period
     1121       temp-abc.ext-doc-type = ""
     1122       .
     1123       define buffer buf_abc-analysis-doc for ub.abc-analysis-doc.
     1124        for each buf_abc-analysis-doc no-lock where
     1125                 buf_abc-analysis-doc.abc-id = buf_abc-analysis.abc-id and
     1126                 buf_abc-analysis-doc.db-num = buf_abc-analysis.db-num
     1127        :
     1128        temp-abc.ext-doc-type = temp-abc.ext-doc-type + func-get-name-from-ext-type (buf_abc-analysis-doc.abcd-ext-doc-type , true ) + "," .
     1129        end.
     1130        for each buf_abc-analysis-obj no-lock where
     1131                 buf_abc-analysis-obj.abc-id = buf_abc-analysis.abc-id and
     1132                 buf_abc-analysis-obj.db-num = buf_abc-analysis.db-num
     1133        :
     1134        temp-abc.obj = temp-abc.obj +  buf_abc-analysis-obj.obj-type + " " + string(buf_abc-analysis-obj.obj-code) + "," .
     1135        end.
     1136   end.
     1137   define stream  macr_excel .
     1138   define variable g#report-num  as integer   no-undo .
     1139   define variable v-file-name as character no-undo .
     1140   define variable p-file-name as character no-undo .
     1141   define variable v-ind       as integer   no-undo .
     1142   define variable num#col#    as integer no-undo .
     1143   define variable C-c         as integer no-undo .
     1144   define variable C-str       as character no-undo .
     1145   define variable str--1      as character Format "x(60)" no-undo.
     1146   define variable str--2      as integer no-undo .
     1147   define variable C-i         as integer no-undo .
     1148   define variable p-var       as integer no-undo .
     1149   define variable var-1       as integer no-undo .
     1150   define variable var-2       as integer no-undo .
     1151   def buffer This_Object for ub.clients .
     1152   def buffer buf_goods   for ub.goods .
     1153   define variable qnty as decimal   no-undo .
     1154   define variable sum  as decimal   no-undo .
     1155   define variable vv-qnty1 as decimal   no-undo .
     1156   define variable vv-qnty2 as decimal   no-undo .
     1157   define variable num-ln as integer   no-undo .
     1158   def var i as int no-undo.
     1159   def var j as int no-undo.
     1160   define variable Counter1 as integer init 0  no-undo .
     1161   def var LineBuf       as char    no-undo.
     1162   def var Line       as char    no-undo.
     1163   def var UndLine    as char    no-undo.
     1164   def var Lines_Counter as   int  init 0  no-undo.
     1165   def var Tmp_Counter   as   int  init 0  no-undo.
     1166   def var tdoc-date     like ub.fbr-pln.doc-date no-undo.
     1167   def var tdoc-code     like ub.fbr-pln.doc-code no-undo.
     1168   def var  abbr              as  char no-undo.
     1169   def var  pp                as  char no-undo.
     1170     if session:set-wait-state("compiler") then.
     1171     define variable v-prn0 as character no-undo .
     1172     if var-report-r-b = "rubl" then assign pp = "Цены руб.".
     1173                                else assign pp = "Цены  баз.вал." .
     1174   define variable v-account as integer init 0 no-undo .
     1175   define variable v-account-lavel as character no-undo .
     1176   define variable v-button-stop as logical no-undo .
     1177   define variable v-kol-spice as integer no-undo .
     1178   define variable v-kol-spice2 as integer no-undo .
     1179   define variable v-kol-spice3 as integer no-undo .
     1180   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     1181   DEFINE BUTTON StopBtn AUTO-END-KEY
     1182        LABEL "Стоп"
     1183        SIZE 10 BY 1.
     1184   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     1185        LABEL "Обработано записей"
     1186         VIEW-AS TEXT
     1187        SIZE 14 BY .67 NO-UNDO.
     1188   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     1189         VIEW-AS TEXT
     1190        SIZE 53.25 BY .67
     1191        FGCOLOR 1  NO-UNDO.
     1192   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     1193         VIEW-AS TEXT
     1194        SIZE 53.25 BY .67
     1195        FGCOLOR 1  NO-UNDO.
     1196   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     1197         VIEW-AS TEXT
     1198        SIZE 53.25 BY .67
     1199        FGCOLOR 1  NO-UNDO.
     1200   DEFINE RECTANGLE RECT-1
     1201        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1202        SIZE 55.13 BY 4.46.
     1203   DEFINE FRAME InfoFrame
     1204        StopBtn AT ROW 4.25 COL 21.75
     1205        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     1206        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     1207        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     1208        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     1209        RECT-1 AT ROW 1 COL 1
     1210       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1211            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1212            TITLE "Процесс"
     1213            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     1214   define variable mFrameView      as logical   no-undo init yes.
     1215     define variable mFramHandle as handle no-undo.
     1216     mFramHandle = frame InfoFrame:handle.
     1217     if  log-manager:logfile-name ne ?
     1218     then DO:
     1219         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1220         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1221         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     1222     end.
     1223     mFrameView = not session:batch-mode and mFramHandle:visible.
     1224     if mFrameView
     1225     then do:
     1226       ASSIGN
     1227          FRAME InfoFrame:HIDDEN                           = TRUE
     1228          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     1229     end.
     1230   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     1231   DO:
     1232     IF not StopProcessing THEN
     1233       Message "Вы действительно хотите прервать" SKIP
     1234               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     1235                 UPDATE StopProcessing.
     1236     IF StopProcessing THEN do:
     1237        if mFrameView
     1238        then do:
     1239           HIDE FRAME InfoFrame.
     1240        end.
     1241     End.
     1242   END.
     1243   assign v-account = ( if integer( 25 ) = 0 then 100 else integer( 25 ) ).
     1244     if  log-manager:logfile-name ne ?
     1245     then DO:
     1246         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     1247     end.
     1248     if not session:batch-mode then
     1249     do:
     1250       VIEW FRAME InfoFrame.
     1251       mFrameView = true.
     1252     end.
     1253      v-button-stop = false .
     1254         if mFrameView
     1255         then do:
     1256         if v-button-stop then view STOPBTN in frame InfoFrame.
     1257                          else Hide STOPBTN in frame InfoFrame.
     1258         end.
     1259   v-ind = 0    .
     1260    run paramls-clear in this-procedure .
     1261    run paramls-write in this-procedure
     1262       (input 'rowsgroup-enable':u
     1263       ,input '':u
     1264       ,input 'yes':u
     1265       ) .
     1266       Output stream Macr_Excel  close .
     1267       num#str# = 0 .
     1268       run gbl/_tmpfile.p ( "wb", ".txt", output v-file-name) .
     1269       output stream macr_excel to value(v-file-name)   .
     1270       v-ind = v-ind + 1.
     1271    run get-report-num  in parParentProc(output g#report-num).
     1272       define stream  Stream-rpt .
     1273       p-file-name =  string( session:temp-directory +
     1274                     "rpt" + string( g#report-num ) + ".txt" ) .
     1275       output stream stream-rpt to value(p-file-name)   .
     1276       output stream stream-rpt close  .
     1277     run PrintTitul in this-procedure .
     1278     for each temp-str :  delete temp-str.  end.
     1279     run make-tt in this-procedure .
     1280     define variable v-row as integer   no-undo .
     1281     for each temp-prod :
     1282        i-numb = i-numb + 1 .
     1283        number-group = string(i-numb,"99999") .
     1284         run print-prod-name ( output v-row ) .
     1285         for each temp-str where temp-str.prod-code =  temp-prod.prod-code and temp-str.prod-type =  temp-prod.prod-type no-lock
     1286             break by temp-str.prc
     1287             :
     1288             run print-line in this-procedure .
     1289         end.
     1290         run print-prod-itogo (input v-row ) .
     1291      end.
     1292     run PrintPodval in this-procedure .
     1293     run paramls-write in this-procedure
     1294       (input "file"
     1295       ,input string(v-ind)
     1296       ,input v-file-name
     1297       ) .
     1298   Output stream Macr_Excel  close .
     1299   if mFrameView
     1300   then do:
     1301      HIDE FRAME InfoFrame.
     1302   end.
     1303       run paramls-write in this-procedure
     1304           (input "charcol"
     1305           ,input ""
     1306           ,input "1,3,4,5,6"
     1307           ) .
     1308     run end-proc in this-procedure  .
     1309     run rep/runexcel.p (p-file-name ).
     1310   procedure print-line :
     1311     do on error undo, return error return-value :
     1312   num#str# = num#str# + 1.
     1313   num#col# = 1.
     1314   run macr_excel_char ( temp-str.artic     , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1315   run macr_excel_char ( temp-str.gds-code  , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1316   run macr_excel_char ( temp-str.gds-name  , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1317   run macr_excel_char ( temp-str.grp-name  , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1318   run macr_excel_char ( temp-str.prod-name , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1319   for each temp-abc:
     1320     find first ub.abc-analysis-goods no-lock where
     1321                ub.abc-analysis-goods.abc-id = temp-abc.id and
     1322                ub.abc-analysis-goods.db-num = temp-abc.db-num and
     1323                ub.abc-analysis-goods.gds-code = temp-STR.gds-code no-error .
     1324     if available ub.abc-analysis-goods then do:
     1325        run macr_excel_char ( ub.abc-analysis-goods.abcg-abc + string(ub.abc-analysis-goods.rating) , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1326        run macr_excel_DEC ( ub.abc-analysis-goods.proc-from-all , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1327        run macr_excel_DEC ( ub.abc-analysis-goods.abcg-sum-for-estimate   , num#str# , num#col#   ) .
     1328   define variable v-color as integer   no-undo .
     1329       if ub.abc-analysis-goods.abcg-abc = "A" then
     1330          assign
     1331            v-color = 3
     1332          .
     1333       if ub.abc-analysis-goods.abcg-abc = "C" then
     1334          assign
     1335            v-color = 0
     1336          .
     1337       if ub.abc-analysis-goods.abcg-abc = "B" then
     1338          assign
     1339             v-color = 41
     1340          .
     1341       if ub.abc-analysis-goods.abcg-abc = "D" then
     1342          assign
     1343            v-color = 14
     1344          .
     1345       if ub.abc-analysis-goods.abcg-abc = "E" then
     1346          assign
     1347            v-color = 13
     1348          .
     1349       if ub.abc-analysis-goods.abcg-abc = "F" then
     1350          assign
     1351             v-color = 48
     1352          .
     1353      put  stream macr_excel unformatted
     1354           substitute('select("r&1c&2:r&3c&4 ")' , num#str# , num#col# - 2 , num#str# , num#col# ) + chr(10)
     1355           substitute('font.properties(,,,,,,,,,&1,,,)', v-color ) + chr(10) .
     1356        assign    num#col# = num#col# + 1 .
     1357     end.
     1358     ELSE
     1359     num#col# = num#col# + 3 .
     1360   end.
     1361     end.
     1362   end procedure.
     1363   procedure print-all-itog :
     1364   end procedure.
     1365   procedure PrintTitul :
     1366     do  on error undo, return error return-value  :
     1367     define variable cc as integer no-undo .
     1368     define variable tt as integer no-undo .
     1369       num#str# = num#str# + 1.
     1370       num#col# = 2.
     1371       cc = num#str# .
     1372       run macr_excel_char ( "Сравнение ABC анализов по производителям"  , num#str# , num#col#   ) .
     1373       num#str# = num#str# + 1.
     1374       num#col# = 2.
     1375       run macr_excel_char ("Печать " + cur-time-date()  , num#str# , num#col#   ) .
     1376       run macr_cell_format
     1377           ( 12     ,
     1378             true   ,
     1379             false  ,
     1380             ?      ,
     1381             cc     ,
     1382             2      ,
     1383             num#str# ,
     1384             2 ) .
     1385       run pshap in this-procedure .
     1386        num#str# = num#str# + 1.
     1387       num#col# = 1.
     1388       run macr_excel_char ( "Артикул товара"   , num#str# , num#col#   ) .
     1389       run macr_cell_size ( 10 , ? , num#str# , num#col# , ?, ? ) .
     1390       num#col# = 2.
     1391       run macr_excel_char ( "Код"   , num#str# , num#col#   ) .
     1392       run macr_cell_size ( 10 , ? , num#str# , num#col# , ?, ? ) .
     1393       num#col# = 3.
     1394       run macr_excel_char ( "ТМЦ"   , num#str# , num#col#   ) .
     1395       run macr_cell_size ( 25 , ? , num#str# , num#col# , ?, ? ) .
     1396       num#col# = 4.
     1397       run macr_excel_char ( "Группа"   , num#str# , num#col#   ) .
     1398       run macr_cell_size ( 32 , ? , num#str# , num#col# , ?, ? ) .
     1399       num#col# = 5.
     1400       run macr_excel_char ( "Производитель"   , num#str# , num#col#   ) .
     1401       run macr_cell_size ( 20 , ? , num#str# , num#col# , ?, ? ) .
     1402       for each temp-abc :
     1403           num#col# = num#col# + 1.
     1404           run macr_excel_char ( "Анализ № " + string(temp-abc.nn) , num#str# , num#col#   ) .
     1405           run macr_cell_size ( 10 , ? , num#str# , num#col# , ?, ? ) .
     1406           num#col# = num#col# + 1.
     1407           run macr_excel_char (  "%"  , num#str# , num#col#   ) .
     1408           run macr_cell_size ( 5 , ? , num#str# , num#col# , ?, ? ) .
     1409           num#col# = num#col# + 1.
     1410           run macr_excel_char ( "Сумма по критерию"  , num#str# , num#col#   ) .
     1411           run macr_cell_size ( 15 , ? , num#str# , num#col# , ?, ? ) .
     1412           if temp-abc.nn modulo 2 = 0 then do:
     1413               run macr_cell_format
     1414               ( 10    ,
     1415                 true  ,
     1416                 false  ,
     1417                 33    ,
     1418                 num#str# ,
     1419                 num#col# - 2 ,
     1420                 num#str# ,
     1421                 num#col# ) .
     1422           end.
     1423           else do:
     1424               run macr_cell_format
     1425               ( 10    ,
     1426                 true  ,
     1427                 false  ,
     1428                 34    ,
     1429                 num#str# ,
     1430                 num#col# - 2 ,
     1431                 num#str# ,
     1432                 num#col# ) .
     1433           end.
     1434       end.
     1435       run macr_cell_format
     1436       ( 10    ,
     1437         true  ,
     1438         false  ,
     1439         ?    ,
     1440         num#str# ,
     1441         1 ,
     1442         num#str# ,
     1443         14 ) .
     1444        put  stream macr_excel unformatted
     1445          substitute('select("r&1c&2:r&3c&4 ")' , num#str# , 1 , num#str# ,  num#col# ) + chr(10)  +
     1446          'BORDER( 2 , 2 , 2 , 2 , 2 , ,0,0,0,0,0) '  + chr(10) +
     1447          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     1448          .
     1449     end.
     1450   end procedure.
     1451   procedure PrintPodval :
     1452     do on error undo, return error return-value  :
     1453       num#str# = num#str# + 3.
     1454       num#col# = 1.
     1455       run macr_excel_char ( "Исполнитель"   , num#str# , num#col#   ) .
     1456       num#col# = 3.
     1457       run macr_excel_char ( p-user-name  , num#str# , num#col#   ) .
     1458     end.
     1459   end procedure.
     1460   procedure make-tt :
     1461     do
     1462     on error undo, return error return-value
     1463     :
     1464   define buffer buf_abc-analysis-goods  for ub.abc-analysis-goods.
     1465   define buffer buf_goods               for ub.goods.
     1466   define buffer buf_clients             for ub.clients  .
     1467   define variable  v-izt      as character no-undo .
     1468   define variable  v-acc-mat as character no-undo .
     1469   define variable  v-Amin    as character no-undo .
     1470   define variable  counter        as integer   no-undo init 0 .
     1471   define variable  v-repfrm-title as character no-undo .
     1472   v-repfrm-title = "Сбор данных ABC анализа" .
     1473   for each temp-abc :
     1474     for each buf_abc-analysis-goods no-lock where
     1475              buf_abc-analysis-goods.abc-id = temp-abc.id  and
     1476              buf_abc-analysis-goods.db-num = temp-abc.db-num :
     1477       if not can-find ( first temp-str where temp-str.gds-code  = buf_abc-analysis-goods.gds-code) then do:
     1478           find first buf_goods no-lock where buf_goods.gds-code =  buf_abc-analysis-goods.gds-code no-error .
     1479           find first buf_clients no-lock where buf_clients.obj-type = buf_goods.prod-type and buf_clients.obj-code = buf_goods.prod-code no-error .
     1480         if available buf_goods and available buf_clients  then do:
     1481               assign
     1482                 counter = counter + 1
     1483               .
     1484   IF ( counter modulo v-account = 0 )  then DO:
     1485    Assign
     1486       v-kol-spice = (50 - LENGTH(v-repfrm-title)) / 2
     1487       RecordsString = fill(' ',v-kol-spice) + string(v-repfrm-title)
     1488       .
     1489             if  log-manager:logfile-name ne ?
     1490             then DO:
     1491                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     1492             end.
     1493              if mFrameView
     1494              then do:
     1495               DISPLAY
     1496                 counter @ RecordsDone
     1497                 RecordsString   @ RecordsString
     1498                 WITH FRAME InfoFrame.
     1499              end.
     1500   End.
     1501      if v-button-stop then  DO:
     1502            if mFrameView
     1503            then
     1504               PROCESS EVENTS.
     1505            IF StopProcessing THEN DO:
     1506            RETURN error.
     1507            End.
     1508      end.
     1509               create temp-str .
     1510               assign
     1511                   temp-str.prc       = buf_abc-analysis-goods.abcg-abc + string( buf_abc-analysis-goods.rating,"999999999999")
     1512                   temp-str.gds-code  = buf_abc-analysis-goods.gds-code
     1513                   temp-str.artic     = buf_goods.artic
     1514                   temp-str.gds-name  = buf_goods.gds-name
     1515                   temp-str.prod-type = buf_goods.prod-type
     1516                   temp-str.prod-code = buf_goods.prod-code
     1517                   temp-str.grp-code  = buf_goods.grp-code
     1518                   temp-str.grp-name  = buf_goods.grp-name
     1519                   temp-str.prod-name = buf_clients.obj-name
     1520               .
     1521         end.
     1522       end.
     1523     end.
     1524     v-repfrm-title = "Сбор по производителям товаров" .
     1525     counter = 0 .
     1526     for each buf_abc-analysis-prod no-lock where
     1527              buf_abc-analysis-prod.abc-id = temp-abc.id  and
     1528              buf_abc-analysis-prod.db-num = temp-abc.db-num :
     1529       if not can-find ( first temp-prod where temp-prod.prod-code  = buf_abc-analysis-prod.prod-code and temp-prod.prod-type  = buf_abc-analysis-prod.prod-type) then do:
     1530           find first buf_clients no-lock where buf_clients.obj-code =  buf_abc-analysis-prod.prod-code and buf_clients.obj-type =  buf_abc-analysis-prod.prod-type no-error .
     1531           assign
     1532             counter = counter + 1
     1533           .
     1534   IF ( counter modulo v-account = 0 )  then DO:
     1535    Assign
     1536       v-kol-spice = (50 - LENGTH(v-repfrm-title)) / 2
     1537       RecordsString = fill(' ',v-kol-spice) + string(v-repfrm-title)
     1538       .
     1539             if  log-manager:logfile-name ne ?
     1540             then DO:
     1541                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     1542             end.
     1543              if mFrameView
     1544              then do:
     1545               DISPLAY
     1546                 counter @ RecordsDone
     1547                 RecordsString   @ RecordsString
     1548                 WITH FRAME InfoFrame.
     1549              end.
     1550   End.
     1551      if v-button-stop then  DO:
     1552            if mFrameView
     1553            then
     1554               PROCESS EVENTS.
     1555            IF StopProcessing THEN DO:
     1556            RETURN error.
     1557            End.
     1558      end.
     1559           create temp-prod .
     1560           assign
     1561               temp-prod.prc        = buf_abc-analysis-prod.abcg-abc + string ( buf_abc-analysis-prod.rating , "999999999999" )
     1562               temp-prod.prod-type  = buf_clients.obj-type
     1563               temp-prod.prod-code  = buf_clients.obj-code
     1564               temp-prod.prod-name  = buf_clients.obj-name
     1565           .
     1566       end.
     1567     end.
     1568   end.
     1569     end.
     1570    end procedure.
     1571   procedure pshap :
     1572     do
     1573     on error undo, return error return-value
     1574     :
     1575     define variable tt as integer   no-undo .
     1576       num#str# = num#str# + 1.
     1577       num#col# = 1.
     1578       tt = num#str# .
     1579       for each temp-abc :
     1580           run macr_excel_char ( "Анализ № " + string(temp-abc.nn )                , num#str# , num#col#   ) .
     1581               run macr_cell_format
     1582               ( 10    ,
     1583                 true  ,
     1584                 false  ,
     1585                 ?    ,
     1586                 num#str# ,
     1587                 num#col#  ,
     1588                 num#str# ,
     1589                 num#col# ) .
     1590           num#str# = num#str# + 1.
     1591           run macr_excel_char ( temp-abc.name               , num#str# , num#col#   ) . num#str# = num#str# + 1.
     1592           if temp-abc.des <> "" then do:  run macr_excel_char ( temp-abc.des                , num#str# , num#col#   ) . num#str# = num#str# + 1. end.
     1593           run macr_excel_char ( temp-abc.name-cral          , num#str# , num#col#   ) . num#str# = num#str# + 1.
     1594           run macr_excel_char ( "A=" + string( temp-abc.A )                 , num#str# , num#col#   ) . num#str# = num#str# + 1.
     1595           run macr_excel_char ( "B=" + string( temp-abc.B )                 , num#str# , num#col#   ) . num#str# = num#str# + 1.
     1596           run macr_excel_char ( "C=" + string( temp-abc.C )                 , num#str# , num#col#   ) . num#str# = num#str# + 1.
     1597           if temp-abc.D > 0 then do:  run macr_excel_char ( "D=" + string(temp-abc.D )   , num#str# , num#col#   ) .    num#str# = num#str# + 1. end.
     1598           if temp-abc.E > 0 then do:  run macr_excel_char ( "E=" + string(temp-abc.E )   , num#str# , num#col#   ) .    num#str# = num#str# + 1. end.
     1599           if temp-abc.F > 0 then do:  run macr_excel_char ( "F=" + string(temp-abc.F )   , num#str# , num#col#   ) .    num#str# = num#str# + 1. end.
     1600           if temp-abc.type <> " " then do: run macr_excel_char ( temp-abc.type          , num#str# , num#col#   ) .  num#str# = num#str# + 1.    end.
     1601           run macr_excel_char ( "создан : " + string(temp-abc.date-cr , "99/99/9999")            , num#str# , num#col#   ) . num#str# = num#str# + 1.
     1602           run macr_excel_char ( temp-abc.period             , num#str# , num#col#   ) .  num#str# = num#str# + 1.
     1603           run macr_excel_char ( temp-abc.ext-doc-type       , num#str# , num#col#   ) .  num#str# = num#str# + 1.
     1604           run macr_excel_char ( temp-abc.obj                , num#str# , num#col#   ) .  num#str# = num#str# + 1.
     1605       end.
     1606     end.
     1607   end procedure.
     1608   procedure print-prod-name :
     1609   define output parameter p-row as integer   no-undo .
     1610     do
     1611     on error undo, return error return-value
     1612     :
     1613   num#str# = num#str# + 1.
     1614   num#col# = 1.
     1615   run macr_excel_char (  temp-prod.prod-name   , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1616    assign    num#col# = num#col# + 1 .
     1617    assign    num#col# = num#col# + 1 .
     1618   run macr_excel_char ( "Производитель"     , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1619       run macr_cell_format
     1620           ( 12     ,
     1621             true   ,
     1622             false  ,
     1623             48      ,
     1624             num#str# ,
     1625             1      ,
     1626             num#str# ,
     1627             5 + ( var-kol * 3 ) ) .
     1628   p-row =  num#str# .
     1629     end.
     1630   end procedure.
     1631   procedure print-prod-itogo :
     1632   define input  parameter p-row as integer   no-undo .
     1633     do
     1634     on error undo, return error return-value
     1635     :
     1636     run paramls-write in this-procedure
     1637       (input "rowsgroup"
     1638       ,input string(v-ind) + ',':u + number-group
     1639       ,input substitute('&1:&2' ,  p-row, num#str# )
     1640       ) .
     1641   num#str# = num#str# + 1.
     1642   num#col# = 1.
     1643       run macr_cell_format
     1644           ( ?     ,
     1645             true   ,
     1646             false  ,
     1647             ?      ,
     1648             num#str# ,
     1649             1      ,
     1650             num#str# ,
     1651             5 + ( var-kol * 3 ) ) .
     1652   run macr_excel_char ( temp-prod.prod-name  , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1653    assign    num#col# = num#col# + 1 .
     1654    assign    num#col# = num#col# + 1 .
     1655   run macr_excel_char ( "Итого по ПРОИЗВОДИТЕЛЮ"   , num#str# , num#col#   ) . assign num#col# = num#col# + 1 .
     1656   run macr_excel_char ( ""                  , num#str# , num#col#   ) . assign num#col# = num#col# + 1 .
     1657   for each temp-abc:
     1658     find first ub.abc-analysis-prod no-lock where
     1659                ub.abc-analysis-prod.abc-id   = temp-abc.id and
     1660                ub.abc-analysis-prod.db-num   = temp-abc.db-num and
     1661                ub.abc-analysis-prod.prod-type = temp-prod.prod-type and
     1662                ub.abc-analysis-prod.prod-code = temp-prod.prod-code
     1663                no-error .
     1664     if available ub.abc-analysis-prod then do:
     1665        run macr_excel_char ( ub.abc-analysis-prod.abcg-abc + string(ub.abc-analysis-prod.rating) , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1666        run macr_excel_DEC ( ub.abc-analysis-prod.proc-from-all , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1667        run macr_excel_DEC ( ub.abc-analysis-prod.abcg-sum-for-estimate   , num#str# , num#col#   ) .
     1668   define variable v-color as integer   no-undo .
     1669       if ub.abc-analysis-prod.abcg-abc = "A" then
     1670          assign
     1671            v-color = 3
     1672          .
     1673       if ub.abc-analysis-prod.abcg-abc = "C" then
     1674          assign
     1675            v-color = 0
     1676          .
     1677       if ub.abc-analysis-prod.abcg-abc = "B" then
     1678          assign
     1679             v-color = 41
     1680          .
     1681       if ub.abc-analysis-prod.abcg-abc = "D" then
     1682          assign
     1683            v-color = 14
     1684          .
     1685       if ub.abc-analysis-prod.abcg-abc = "E" then
     1686          assign
     1687            v-color = 13
     1688          .
     1689       if ub.abc-analysis-prod.abcg-abc = "F" then
     1690          assign
     1691             v-color = 48
     1692          .
     1693      put  stream macr_excel unformatted
     1694           substitute('select("r&1c&2:r&3c&4 ")' , num#str# , num#col# - 2 , num#str# , num#col# ) + chr(10)
     1695           substitute('font.properties(,,,,,,,,,&1,,,)', v-color ) + chr(10)
     1696           .
     1697        assign    num#col# = num#col# + 1 .
     1698     end.
     1699     ELSE
     1700     num#col# = num#col# + 3 .
     1701   end.
     1702     end.
     1703   end procedure.
     1704   def var vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1705   procedure macr_excel_char :
     1706    do
     1707    on error undo, return error return-value
     1708    :
     1709    define input parameter  p-val as character no-undo .
     1710    define input parameter  p-row as integer no-undo .
     1711    define input parameter  p-col as integer no-undo .
     1712    if p-val = ? then p-val = "" .
     1713       put stream macr_excel unformatted
     1714             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     1715    end.
     1716   end procedure.
     1717   procedure macr_excel_char_with_format :
     1718    do
     1719    on error undo, return error return-value
     1720    :
     1721    define input parameter  p-val as character no-undo .
     1722    define input parameter  p-row as integer no-undo .
     1723    define input parameter  p-col as integer no-undo .
     1724    if p-val = ? then p-val = "" .
     1725       put stream macr_excel unformatted
     1726             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     1727       put stream macr_excel unformatted 'format.number("@")' + chr(10) .
     1728       put stream macr_excel unformatted
     1729             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     1730    end.
     1731   end procedure.
     1732   procedure macr_excel_cell_format :
     1733    do
     1734    on error undo, return error return-value
     1735    :
     1736    define input parameter  p-val    as character no-undo .
     1737    define input parameter  p-row    as integer   no-undo .
     1738    define input parameter  p-col    as integer   no-undo .
     1739    define input parameter  p-format as character no-undo .
     1740    if p-val = ? then p-val = "" .
     1741       put stream macr_excel unformatted
     1742             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     1743       put stream macr_excel unformatted substitute('format.number("&1")', p-format) + chr(10) .
     1744       put stream macr_excel unformatted
     1745             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     1746    end.
     1747   end procedure.
     1748   procedure macr_excel_sum :
     1749    do
     1750    on error undo, return error return-value
     1751    :
     1752    define input parameter  p-row as integer no-undo .
     1753    define input parameter  p-col as integer no-undo .
     1754    define input parameter  p-row1 as integer no-undo .
     1755    define input parameter  p-col1 as integer no-undo .
     1756    define input parameter  p-row2 as integer no-undo .
     1757    define input parameter  p-col2 as integer no-undo .
     1758       put stream macr_excel unformatted
     1759             substitute('formula("=sum(r&3c&4:r&5c&6)","r&1c&2")', p-row , p-col , p-row1 , p-col1 ,p-row2 , p-col2 ) + chr(10)  .
     1760    end.
     1761   end procedure.
     1762   procedure macr_excel_dec :
     1763    do
     1764    on error undo, return error return-value
     1765    :
     1766    define input parameter  p-val as character no-undo .
     1767    define input parameter  p-row as integer   no-undo .
     1768    define input parameter  p-col as integer   no-undo .
     1769     if p-val = ? then p-val =  "" .
     1770      put  stream macr_excel unformatted
     1771           substitute('formula(&3,"r&1c&2")', p-row , p-col ,  p-val )  + chr(10) .
     1772    end.
     1773   end procedure.
     1774   procedure macr_cell_format :
     1775    do
     1776    on error undo, return error return-value
     1777    :
     1778    define input parameter  p-size   as integer   no-undo .
     1779    define input parameter  p-bold   as logical   no-undo .
     1780    define input parameter  p-italic as logical   no-undo .
     1781    define input parameter  p-color  as integer   no-undo .
     1782    define input parameter  p-row    as integer   no-undo .
     1783    define input parameter  p-col    as integer   no-undo .
     1784    define input parameter  p-row-2  as integer   no-undo .
     1785    define input parameter  p-col-2  as integer   no-undo .
     1786     if p-size = ? then p-size = 10 .
     1787     if p-bold = ? then p-bold = false .
     1788     if p-italic = ? then p-italic = false .
     1789     if p-row-2 = ? then p-row-2 = p-row .
     1790     if p-col-2 = ? then p-col-2 = p-col .
     1791     put  stream macr_excel unformatted
     1792      substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 ) + chr(10) .
     1793     if p-color <> ? then do:
     1794        put  stream macr_excel unformatted
     1795          substitute('patterns(1,,&1,true)', p-color ) + chr(10)  .
     1796     end.
     1797     put  stream macr_excel unformatted
     1798          substitute('format.font(,&1,&2,&3)' , p-size,
     1799                                           string ( p-bold  , "true/false" ) ,
     1800                                           string ( p-italic , "true/false" )
     1801                                           ) + chr(10) .
     1802    end.
     1803   end procedure.
     1804   procedure macr_cell_size :
     1805    do
     1806    on error undo, return error return-value
     1807    :
     1808    define input parameter  p-w   as integer   no-undo .
     1809    define input parameter  p-l   as integer   no-undo .
     1810    define input parameter  p-row    as integer   no-undo .
     1811    define input parameter  p-col    as integer   no-undo .
     1812    define input parameter  p-row-2  as integer   no-undo .
     1813    define input parameter  p-col-2  as integer   no-undo .
     1814     if p-row-2 = ? then p-row-2 = p-row .
     1815     if p-col-2 = ? then p-col-2 = p-col .
     1816     if p-w = ? then    p-w = 0 .
     1817     if p-l = ? then    p-l = 0 .
     1818    define variable s-w as character no-undo .
     1819    define variable s-l as character no-undo .
     1820    if p-w = 0 then s-w = "" .
     1821               else s-w = string(p-w)  .
     1822    if p-l = 0 then s-l = "" .
     1823               else s-l = string(p-l)  .
     1824   put  stream macr_excel unformatted
     1825        substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 )  skip .
     1826   put  stream macr_excel unformatted
     1827        substitute('COLUMN.WIDTH(&1,,,,)' , s-w  )  skip.
     1828   put  stream macr_excel unformatted
     1829        'FORMAT.TEXT(2,2,0,,,,,)'  skip.
     1830    end.
     1831   end procedure.
     1832   procedure proc-print-header :
     1833    do
     1834    on error undo, return error return-value
     1835    :
     1836      find first sheetf .
     1837        sheetf.excel-row-heder =  num-entries( c-str ,chr(10)) + 1.
     1838        sheetf.excel-row-title =  num-entries( sheetf.excel-column-lable , chr(10) ).
     1839        var-1 =  num#str# .
     1840        repeat c-c = 1 to sheetf.excel-row-title :
     1841        num#str# = num#str# + 1 .
     1842        p-var = num-entries( entry (c-c, sheetf.excel-column-lable, chr(10)) , chr(44) ) .
     1843        do c-i = 1 to p-var :
     1844           str--1 = entry( c-i, entry (c-c,sheetf.excel-column-lable, chr(10)) , chr(44)) .
     1845           str--2 = integer(entry( c-i, sheetf.sizes )) .
     1846           num#col# = c-i .
     1847           run macr_excel_char_with_format ( str--1  , num#str# , num#col#  ) .
     1848           run macr_cell_size ( str--2 , ? , num#str# , num#col# , ?, ? ) .
     1849        end.
     1850       c-i = 0.
     1851       end.
     1852       run macr_cell_format (
     1853           10       ,
     1854           true     ,
     1855           false    ,
     1856           35       ,
     1857           var-1 + 1,
     1858           1        ,
     1859           num#str# ,
     1860           num#col# )
     1861           .
     1862     put  stream macr_excel unformatted
     1863          substitute('select("r&1c&2:r&3c&4 ")' , var-1 + 1 , 1 , num#str# ,  num#col# ) + chr(10)  +
     1864          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     1865          .
     1866    end.
     1867   end procedure.
     1868   procedure end-proc :
     1869    do
     1870    on error undo, return error return-value
     1871    :
     1872     v-file-name = ( string( session:temp-directory + "rpt" + string( g#report-num ) ) + ".t-t").
     1873     OUTPUT to VALUE (v-file-name) .
     1874     for each temp-param :
     1875       export  temp-param  .
     1876     end.
     1877    end.
     1878   end procedure.
