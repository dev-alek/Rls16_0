        1   block-level on error undo, throw.
        2   define input parameter parParentProc      AS WIDGET-HANDLE NO-UNDO.
        3   define input parameter rec_id   as recid.
        4   define variable vss-revision    as character no-undo initial "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo initial "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo initial "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo initial "$Workfile: inv-8l.p $":U .
        8   define variable vss-archive     as character no-undo initial "$Archive: rep/inv-8l.p $":U .
        9   define variable vss-description as character no-undo initial "Акт инвентаризации по форме ИНВ-8".
