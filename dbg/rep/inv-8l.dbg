      750   define buffer buf_gds-dtl      for gds-dtl .
      751   define buffer buf_gds-prt      for gds-prt .
      752   define buffer bf_doc-attr      for doc-attr .
      753   define buffer buf_prod-bc      for prod-bc .
      754   define variable sum1-qntyFact   as decimal initial 0     no-undo .
      755   define variable sum1-qntyBuh    as decimal initial 0     no-undo .
      756   define variable sum1-weightFact-l as decimal initial 0     no-undo .
      757   define variable sum1-weightBuh-l  as decimal initial 0     no-undo .
      758   define variable sum1-weightFact-c as decimal initial 0     no-undo .
      759   define variable sum1-weightBuh-c  as decimal initial 0     no-undo .
      760   define variable weightitem      as decimal initial 0     no-undo .
      761   define variable PgQnty          as decimal               no-undo .
      762   define variable PgWeight-l        as decimal               no-undo .
      763   define variable PgWeight-c        as decimal               no-undo .
      764   define variable PgQntyBuh       as decimal               no-undo .
      765   define variable PgWeightBuh-l     as decimal               no-undo .
      766   define variable PgWeightBuh-c     as decimal               no-undo .
      767   define variable PgNPP           as integer               no-undo .
      768   define variable v-b-code        as integer               no-undo .
      769   define variable num-ln          as integer               no-undo .
      770    define variable i as integer no-undo.
      771    define variable j as integer no-undo.
      772   define variable Counter1        as integer initial 0     no-undo .
      773   define variable Lines_Counter   as integer initial 0     no-undo .
      774   define variable Tmp_Counter     as integer initial 0     no-undo .
      775   define variable Line            as character             no-undo .
      776   define variable LineBuf         as character             no-undo .
      777   define variable UndLine         as character             no-undo .
      778   define variable PropisQnty      as character             no-undo .
      779   define variable PropisSumall-l  as character             no-undo .
      780   define variable PropisSumall-c  as character             no-undo .
      781   define variable Propiscount     as character             no-undo .
      782   define variable sym1            as character initial ":" no-undo .
      783   define variable sym2            as character initial ":" no-undo .
      784   define variable sym3            as character initial ":" no-undo .
      785   define variable sym4            as character initial ":" no-undo .
      786   define variable sym5            as character initial ":" no-undo .
      787   define variable sym6            as character initial ":" no-undo .
      788   define variable sym7            as character initial ":" no-undo .
      789   define variable sym8            as character initial ":" no-undo .
      790   define variable sym9            as character initial ":" no-undo .
      791   define variable sym10           as character initial ":" no-undo .
      792   define variable sym11           as character initial ":" no-undo .
      793   define variable sym12           as character initial ":" no-undo .
      794   define variable v-prn0          as character             no-undo .
      795   define variable v-par-type      as character             no-undo .
      796   define variable tdoc-date       like trn-doc.doc-date    no-undo .
      797   define variable tdoc-code       like trn-doc.doc-code    no-undo .
      798   DEFINE FRAME invent-gold
      799         sym1                 column-label ":!:!:!:!:"                           format "X(1)"  space(0)
      800         num-ln               column-label "N!по!поряк!ку!":C5                   format ">>>>9" space(0)
      801         sym3                 column-label ":!:!:!:!:"                           format "X(1)" space(0)
      802         temp-str.gds-name    column-label " Драгоченные металлы и изделия из них !----------------------------------------! ! Наименование ! ":C40           format "X(40)" space(0)
      803         sym2                 column-label " !-!:!:!:"                           format "X(1)" space(0)
      804         temp-str.artic       column-label " !-----------------! ! код ! ":C17                     format "X(17)" space(0)
      805         Sym4                 column-label " !-!:!:!:"                           format "X(1)" space(0)
      806         temp-str.b-code      column-label " !-------------! ! бар-код ! ":C13                  format "X(13)" space(0)
