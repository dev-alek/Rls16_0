      339   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
      340   procedure paramls-clear :
      341     define buffer buf_temp-param for temp-param .
      342     do
      343     on error undo, return error return-value
      344     :
      345       for each buf_temp-param
      346       on error undo, return error
      347       :
      348         delete buf_temp-param .
      349       end.
      350     end.
      351   end procedure.
      352   procedure paramls-write :
      353     define input  parameter p-code     as character no-undo .
      354     define input  parameter p-sub-code as character no-undo .
      355     define input  parameter p-value    as character no-undo .
      356     define buffer buf_temp-param for temp-param .
      357     do
      358     on error undo, return error return-value
      359     :
      360       find first buf_temp-param
      361         where buf_temp-param.param-code     = p-code
      362           and buf_temp-param.param-sub-code = p-sub-code
      363         no-error .
      364       if not available buf_temp-param then do:
      365         create buf_temp-param .
      366         assign
      367           buf_temp-param.param-code     = p-code
      368           buf_temp-param.param-sub-code = p-sub-code
      369         .
      370       end.
      371       assign
      372         buf_temp-param.param-value = p-value
      373       .
      374     end.
      375   end procedure.
      376   procedure paramls-read :
      377     define input  parameter p-code          as character no-undo .
      378     define input  parameter p-sub-code      as character no-undo .
      379     define input  parameter p-default-value as character no-undo .
      380     define output parameter p-value         as character no-undo .
      381     define buffer buf_temp-param for temp-param .
      382     do
      383     on error undo, return error return-value
      384     :
      385       find first buf_temp-param
      386         where buf_temp-param.param-code     = p-code
      387           and buf_temp-param.param-sub-code = p-sub-code
      388         no-error .
      389       if available buf_temp-param then do:
      390         assign
      391           p-value = buf_temp-param.param-value
      392         .
      393       end.
      394       else do:
      395         assign
      396           p-value = p-default-value
      397         .
      398       end.
      399     end.
      400   end procedure.
      401   procedure paramls-append :
      402     define input  parameter p-code     as character no-undo .
      403     define input  parameter p-sub-code as character no-undo .
      404     define input  parameter p-value    as character no-undo .
      405     define buffer buf_temp-param for temp-param .
      406     do
      407     on error undo, return error return-value
      408     :
      409       find first buf_temp-param
      410            where buf_temp-param.param-code     = p-code
      411              and buf_temp-param.param-sub-code = p-sub-code
      412         no-error .
      413       if not available buf_temp-param then do:
      414         create buf_temp-param .
      415         assign
      416           buf_temp-param.param-code     = p-code
      417           buf_temp-param.param-sub-code = p-sub-code
      418           buf_temp-param.param-value    = p-value
      419         .
      420       end.
      421       else do:
      422           assign
      423               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
      424           .
      425       end.
      426     end.
      427   end procedure.
      428   define new global shared variable g#lib-trn  as handle no-undo .
      429   define new global shared variable g#lib-trn2 as handle no-undo .
      430   define new global shared variable g#lib-trn3 as handle no-undo .
      431   define new global shared variable g#lib-trn4 as handle no-undo .
      432     function valid-density returns logical ( input p-density as decimal, input p-unit-base-cli-eq as logical ) :
      433       define variable v-answ as logical no-undo .
      434       if ( p-unit-base-cli-eq = true
      435            and p-density = 1.0
      436          )
      437         or ( p-unit-base-cli-eq = false
      438              and p-density <> ?
      439              and p-density > 0.0
      440              and p-density < 1.0
      441            )
      442       then do:
      443         assign
      444           v-answ = true
      445         .
      446       end.
      447       else do:
      448         assign
      449           v-answ = false
      450         .
      451       end.
      452       return v-answ.
      453     end function.
      454   define variable vss-include-info5 as character format "X(65)" no-undo
      455   initial "@(#)$Workfile$ $Revision$".
      456   define stream excel-line.
      457   define stream excel-cell.
      458   define temp-table temp_cell-data no-undo
      459       field data-key as character
      460       field data-value as character
      461       index pi is primary unique data-key
      462   .
      463   define temp-table temp_line-data no-undo
      464       field data-key       as character
      465       field xl-line-id     as integer
      466       field num            as integer
      467       field name           as character
      468       field artic          as character
      469       field b-code         as character
      470       field EI             as character
      471       field qntyFact       as character
      472       field qntyBuh        as character
      473       field WeightFact     as character
      474       field WeightItemFact as character
      475       field WeightItemBuh  as character
      476       field WeightBuh      as character
