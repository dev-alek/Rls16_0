      809         sym6                 column-label ":!:!:!:!:"                           format "X(1)" space(0)
      810         temp-str.qntyFact    column-label "Фактическое !--------------! !Количество! ":C14 format "->>>>>>>9.<<<" space(0)
      811         sym7                 column-label " !-!:!:!:"                           format "X(1)" space(0)
      812         sum1-weightfact-l    column-label " наличие!---------------! Масса !---------------!Лигатурная":C15   format "->>>,>>>,>>9.99" space(0)
      813         sym8                 column-label " !-! !-!:"                           format "X(1)" space(0)
      814         sum1-weightfact-c    column-label "!---------------! !---------------! чистая ":C15   format "->>>,>>>,>>9.99" space(0)
      815         sym9                 column-label ":!:!:!:!:"                           format "X(1)" space(0)
      816         temp-str.qntyBuh     column-label " Числится !--------------! ! Количество ! ":C14 format "->>>>>>>9.<<<" space(0)
      817         sym10                column-label " !-!:!:!:"                           format "X(1)" space(0)
      818         sum1-weightbuh-l     column-label " по данным !---------------! Масса !---------------!лигатурная":C15   format "->>>,>>>,>>9.99" space(0)
      819         sym11                column-label " !-! !-!:"                           format "X(1)" space(0)
      820         sum1-weightbuh-c     column-label " учета !---------------! !---------------! чистая ":C15   format "->>>,>>>,>>9.99" space(0)
      821         sym12                column-label ":!:!:!:!:"                           format "X(1)" space(0)
      822        HEADER
      823         Line format "X(183)" AT 1
      824         with width 232 down stream-io use-text NO-BOX.
      825   FUNCTION f-wp-qnty returns character ( INPUT p-dec as decimal ) :
      826     define variable pr as character no-undo .
      827     run rep/wp-qnty.p ( input p-dec, output Pr ).
      828     if Pr = '' then do:
      829        Pr = 'Ноль'.
      830     end.
      831     RETURN ( Pr ) .
      832   END FUNCTION.
      833   do on error undo, return error
      834      :
      835      run get-report-num  in parParentProc ( output g#report-num ).
      836      run get-quest-print in parParentProc ( output g#quest-print ).
      837      FIND trn-doc WHERE recid(trn-doc) = rec_id NO-LOCK .
      838      assign
      839        tdoc-date = (if trn-doc.status_ <> 'факт':U then trn-doc.doc-date else trn-doc.fact-date)
      840        tdoc-code = trn-doc.doc-code
      841      .
      842   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      843   empty temp-table thbjattr_thbj-attr.
      844   run adm/shattri.p (
      845      input "get":U
      846     ,input ''
      847     ,input 0
      848     ,input 'prt-glob':U
      849     ,input  ""
      850     ,output v-value-character
      851     ,output v-value-date
      852     ,output v-value-decimal
      853     ,output v-value-integer
      854     ,output v-value-logical
      855     ,output par-type
      856     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
      857     ) no-error .
      858     for each thbjattr_thbj-attr :
      859         if thbjattr_thbj-attr.prop-code = 'invprn0'  then v-prn0      = string( thbjattr_thbj-attr.property-value-logical) .
      860     end.
      861      if session:set-wait-state("compiler") then.
      862   output STREAM Out-Stream to value( string( session:temp-directory +
      863                                        "rpt" + string( g#report-num ) ) )
      864                                        page-size  value(43) .
      865      run inv8xl-init in this-procedure .
      866      assign
      867        UndLine = fill("_", 230)
      868        Line    = fill("-", 230)
      869        LineBuf = fill("_", 240)
      870      .
      871      FIND This_Object  WHERE This_Object.obj-type = trn-doc.obj-type AND This_Object.obj-code = trn-doc.obj-code  NO-LOCK.
      872      FIND clients      WHERE clients.obj-type     = 'орг':U           AND clients.obj-code     = trn-doc.host-code NO-LOCK.
      873      run PrintTitul in this-procedure .
      874      FORM with frame invent-gold .
      875   define variable v-account as integer init 0 no-undo .
      876   define variable v-account-lavel as character no-undo .
      877   define variable v-button-stop as logical no-undo .
      878   define variable v-kol-spice as integer no-undo .
      879   define variable v-kol-spice2 as integer no-undo .
      880   define variable v-kol-spice3 as integer no-undo .
      881   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
      882   DEFINE BUTTON StopBtn AUTO-END-KEY
      883        LABEL "Стоп"
      884        SIZE 10 BY 1.
      885   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
      886        LABEL "Обработано записей"
      887         VIEW-AS TEXT
      888        SIZE 14 BY .67 NO-UNDO.
      889   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
      890         VIEW-AS TEXT
      891        SIZE 53.25 BY .67
      892        FGCOLOR 1  NO-UNDO.
      893   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
      894         VIEW-AS TEXT
      895        SIZE 53.25 BY .67
      896        FGCOLOR 1  NO-UNDO.
      897   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
      898         VIEW-AS TEXT
      899        SIZE 53.25 BY .67
      900        FGCOLOR 1  NO-UNDO.
      901   DEFINE RECTANGLE RECT-1
      902        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      903        SIZE 55.13 BY 4.46.
      904   DEFINE FRAME InfoFrame
      905        StopBtn AT ROW 4.25 COL 21.75
      906        RecordsString AT ROW 1.21 COL 2 NO-LABEL
      907        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
      908        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
      909        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
      910        RECT-1 AT ROW 1 COL 1
      911       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      912            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      913            TITLE "Процесс"
      914            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
      915   define variable mFrameView      as logical   no-undo init yes.
      916     define variable mFramHandle as handle no-undo.
      917     mFramHandle = frame InfoFrame:handle.
      918     if  log-manager:logfile-name ne ?
      919     then DO:
      920         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      921         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      922         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
      923     end.
      924     mFrameView = not session:batch-mode and mFramHandle:visible.
      925     if mFrameView
      926     then do:
      927       ASSIGN
      928          FRAME InfoFrame:HIDDEN                           = TRUE
      929          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
      930     end.
      931   ON CHOOSE OF StopBtn IN FRAME InfoFrame
      932   DO:
      933     IF not StopProcessing THEN
      934       Message "Вы действительно хотите прервать" SKIP
      935               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
      936                 UPDATE StopProcessing.
      937     IF StopProcessing THEN do:
      938        if mFrameView
      939        then do:
      940           HIDE FRAME InfoFrame.
      941        end.
      942     End.
      943   END.
      944   assign v-account = ( if integer( 25 ) = 0 then 100 else integer( 25 ) ).
      945     if  log-manager:logfile-name ne ?
      946     then DO:
      947         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
      948     end.
      949     if not session:batch-mode then
      950     do:
      951       VIEW FRAME InfoFrame.
      952       mFrameView = true.
      953     end.
      954      v-button-stop = false .
      955         if mFrameView
      956         then do:
      957         if v-button-stop then view STOPBTN in frame InfoFrame.
      958                          else Hide STOPBTN in frame InfoFrame.
      959         end.
      960   define variable vss-include-info9 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      961   assign
      962      counter1 = 0
      963   .
      964   for each buf_doc-line where buf_doc-line.doc-code = trn-doc.doc-code
      965                         no-lock
      966                         :
      967     find first buf_goods where buf_goods.prod-type = buf_doc-line.prod-type
      968                            and buf_goods.prod-code = buf_doc-line.prod-code
      969                            and buf_goods.artic     = buf_doc-line.artic
      970                          no-lock
      971                          no-error
      972                          .
      973     find first buf_doc-line-sum no-lock where
      974                buf_doc-line-sum.doc-code = buf_doc-line.doc-code and
      975                buf_doc-line-sum.gds-code = buf_goods.gds-code    and
      976                buf_doc-line-sum.sum-type = 'bd':U     no-error.
      977   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
      978     (input  buf_goods.gds-code
      979     ,input  ?
      980     ,output v-b-code
      981     ) no-error .
      982     if error-status :error then do:
      983       message vss-workfile skip vss-date skip vss-revision skip( 1 ) vss-description skip( 1 )
      984               "Ошибка при определении бар-кода товара"     skip
      985               "Артикул товара:" buf_goods.artic            skip
      986               "Производитель:"  buf_goods.prod-type buf_goods.prod-code skip
      987               error-status :get-message( 1 ) skip
      988               error-status :get-message( 2 ) skip
      989               return-value                   skip( 1 )
      990       view-as alert-box error.
      991     end.
      992     find first buf_prod-bc where buf_prod-bc.b-code = v-b-code
      993                        no-lock
      994                        no-error
      995                        .
      996     assign
      997        Counter1 = Counter1 + 1
      998     .
      999   IF ( Counter1 modulo v-account = 0 )  then DO:
     1000             if  log-manager:logfile-name ne ?
     1001             then DO:
     1002                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     1003             end.
     1004              if mFrameView
     1005              then do:
     1006               DISPLAY
     1007                 Counter1 @ RecordsDone
     1008                 WITH FRAME InfoFrame.
     1009              end.
     1010   End.
     1011      if v-button-stop then  DO:
     1012            if mFrameView
     1013            then
     1014               PROCESS EVENTS.
     1015            IF StopProcessing THEN DO:
     1016            RETURN error.
     1017            End.
     1018      end.
     1019     if v-prn0 = "no" then do:
     1020       if  buf_doc-line-sum.fact-qnty = 0
     1021       and buf_doc-line.fact-qnty     = 0
     1022       then do:
     1023            NEXT.
     1024       end.
     1025     end.
     1026     create temp-str.
     1027     assign temp-str.b-code          = if not available buf_prod-bc then string( v-b-code )
     1028                                                                    else buf_prod-bc.b-str
     1029            temp-str.artic           = buf_goods.artic
     1030            temp-str.prod-type       = buf_goods.prod-type
     1031            temp-str.prod-code       = buf_goods.prod-code
     1032            temp-str.gds-name        = trim( buf_goods.gds-name )
     1033            temp-str.EI              = buf_goods.sort
     1034            temp-str.qntyBuh         = buf_doc-line-sum.fact-qnty
     1035            temp-str.qntyFact        = temp-str.qntyBuh  + buf_doc-line.fact-qnty
     1036            temp-str.WeightItemLigat = buf_goods.wt-base
     1037     .
     1038     assign
     1039        temp-str.WeightItemClear = decimal(buf_goods.Destin)
     1040     no-error.
     1041     if error-status :error then do:
     1042        assign
     1043           temp-str.WeightItemClear = 0.0
     1044        .
     1045     end.
     1046   end.
     1047      for each temp-str no-lock
     1048                        :
     1049          run print-line in this-procedure .
     1050      end.
     1051      display stream Out-Stream
     1052            Line format "X(183)" AT 1 skip
     1053            String("Итого"
     1054                   + sym6
     1055                   + String(PgQnty ,     "->>>>>>>>9.999"    )
     1056                   + sym7
     1057                   + String(PgWeight-l ,   "->>>>>>>>>9.999"    )
     1058                   + sym8
     1059                   + String(PgWeight-c ,   "->>>>>>>>>9.999"    )
     1060                   + sym9
     1061                   + String(PgQntyBuh,   "->>>>>>>>9.999"     )
     1062                   + sym10
     1063                   + String(PgWeightBuh-l, "->>>>>>>>>9.999" )
     1064                   + sym11
     1065                   + String(PgWeightBuh-c, "->>>>>>>>>9.999" )
     1066                   + sym12)  at 84 Format "x(100)"
     1067                   skip
     1068            String("Всего по акту"
     1069                   + sym6
     1070                   + String(sum1-qntyFact ,     "->>>>>>>>9.999"    )
     1071                   + sym7
     1072                   + String(sum1-weightFact-l ,   "->>>>>>>>>9.999"    )
     1073                   + sym8
     1074                   + String(sum1-weightFact-c ,   "->>>>>>>>>9.999"    )
     1075                   + sym9
     1076                   + String(sum1-qntyBuh ,   "->>>>>>>>9.999"     )
     1077                   + sym10
     1078                   + String(sum1-weightBuh-l , "->>>>>>>>>9.999" )
     1079                   + sym11
     1080                   + String(sum1-weightBuh-c , "->>>>>>>>>9.999" )
     1081                   + sym12)  at 76 Format "x(108)"
     1082                   skip
     1083            UndLine format "X(183)" AT 1 skip
     1084            "Итого по странице : " skip
     1085            "а) количество порядковых номеров "           AT 18 "(" STRING(PgNPP)    ")" f-wp-qnty (decimal(PgNPP)) FORMAT "x(90)"   SKIP
     1086            "б) общее количество единиц фактически "      AT 18 "(" STRING(PgQnty)   ")" f-wp-qnty (decimal(PgQnty)) FORMAT "x(90)"   SKIP
     1087            "в) масса драгоценных металлов фактически: "  AT 18                               SKIP
     1088            "лигатурная "                                 AT 25 "(" STRING(PgWeight-l) ")" f-wp-qnty (decimal(PgWeight-l)) FORMAT "x(90)"  SKIP
     1089            "чистая "                                     AT 25 "(" STRING(PgWeight-c) ")" f-wp-qnty (decimal(PgWeight-c)) FORMAT "x(90)"  SKIP
     1090      with FRAME PageFrame2 width 232 NO-LABELS NO-BOX .
     1091      DOWN stream Out-Stream 1 with FRAME PageFrame.
     1092      page stream out-stream.
     1093      run on-same-page in this-procedure (input 14) .
     1094      run PrintPodval in this-procedure .
     1095      output stream Out-Stream CLOSE .
     1096   if mFrameView
     1097   then do:
     1098      HIDE FRAME InfoFrame.
     1099   end.
     1100      run inv8xl-close in this-procedure .
     1101   if g#quest-print = false
     1102   then do:
     1103     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
     1104                                         7, (if 8 >= 8 then 2 else 0), 0, 0,
     1105                                         OUTPUT g#log ).
     1106   end.
     1107   else do:
     1108     os-command silent
     1109       value( "COPY /b " +
     1110         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
     1111         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
     1112         string( session:temp-directory) +  "$" + string( g#report-num )
     1113                 ) .
     1114     os-command silent
     1115       value( "COPY /b " +
     1116         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
     1117         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
     1118         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
     1119                 ) .
     1120   end.
     1121   end.
     1122   procedure print-line :
     1123     do on error undo, return error return-value :
     1124   define variable vss-include-info10 as character format "X(65)" no-undo
     1125   initial "@(#)$Workfile$ $Revision$".
     1126   DO:
     1127     assign Lines_Counter = Lines_Counter + 1  .
     1128     if line-counter( out-stream ) + 9 > page-size( out-stream ) then do:
     1129        display stream Out-Stream
     1130           Line format "X(183)" AT 1
     1131           String("Итого"
     1132                  + sym6
     1133                  + String(PgQnty ,     "->>>>>>>>9.999"    )
     1134                  + sym7
     1135                  + String(PgWeight-l ,   "->>>>>>>>>9.999"    )
     1136                  + sym8
     1137                  + String(PgWeight-c ,   "->>>>>>>>>9.999"    )
     1138                  + sym9
     1139                  + String(PgQntyBuh,   "->>>>>>>>9.999"     )
     1140                  + sym10
     1141                  + String(PgWeightBuh-l, "->>>>>>>>>9.999" )
     1142                  + sym11
     1143                  + String(PgWeightBuh-c, "->>>>>>>>>9.999" )
     1144                  + sym12)  at 84 Format "x(100)"
     1145                  skip
     1146           "Итого по странице : " skip
     1147           "а) количество порядковых номеров "           AT 18 "(" STRING(PgNPP)    ")" f-wp-qnty (decimal(PgNPP)) FORMAT "x(90)"   SKIP
     1148           "б) общее количество единиц фактически "      AT 18 "(" STRING(PgQnty)   ")" f-wp-qnty (decimal(PgQnty)) FORMAT "x(90)"   SKIP
     1149           "в) масса драгоценных металлов фактически: "  AT 18                               SKIP
     1150           "лигатурная "                                 AT 25 "(" STRING(PgWeight-l) ")" f-wp-qnty (decimal(PgWeight-l)) FORMAT "x(90)"  SKIP
     1151           "чистая "                                     AT 25 "(" STRING(PgWeight-c) ")" f-wp-qnty (decimal(PgWeight-c)) FORMAT "x(90)"  SKIP
     1152        with FRAME PageFrame width 232 NO-LABELS NO-BOX .
     1153        DOWN stream Out-Stream 1 with FRAME PageFrame.
     1154        page stream out-stream.
     1155     end.
     1156     if line-counter( Out-Stream ) < Tmp_Counter then DO:
     1157        assign
     1158           PgNPP         = 0
     1159           PgQnty        = 0
     1160           PgWeight-l    = 0
     1161           PgWeight-c    = 0
     1162           PgQntyBuh     = 0
     1163           PgWeightBuh-l = 0
     1164           PgWeightBuh-c = 0
     1165        .
     1166     END.
     1167     assign
     1168       Tmp_Counter     = line-counter( Out-Stream )
     1169       PgNPP           = PgNPP           + 1
     1170       PgQnty          = PgQnty          + temp-str.qntyFact
     1171       PgQntyBuh       = PgQntyBuh       + temp-str.qntyBuh
     1172       PgWeight-l      = PgWeight-l      + temp-str.weightItemLigat * temp-str.qntyFact
     1173       PgWeightBuh-l   = PgWeightBuh-l   + temp-str.weightItemLigat * temp-str.qntyBuh
     1174       PgWeight-c      = PgWeight-c      + temp-str.weightItemClear * temp-str.qntyFact
     1175       PgWeightBuh-c   = PgWeightBuh-c   + temp-str.weightItemClear * temp-str.qntyBuh
     1176       num-ln          = num-ln          + 1
     1177       sum1-qntyFact   = sum1-qntyFact   + temp-str.qntyFact
     1178       sum1-qntyBuh    = sum1-qntyBuh    + temp-str.qntyBuh
     1179       sum1-weightFact-l = sum1-weightFact-l + temp-str.weightItemLigat * temp-str.qntyFact
     1180       sum1-weightBuh-l  = sum1-weightBuh-l  + temp-str.weightItemLigat * temp-str.qntyBuh
     1181       sum1-weightFact-c = sum1-weightFact-c + temp-str.weightItemClear * temp-str.qntyFact
     1182       sum1-weightBuh-c  = sum1-weightBuh-c  + temp-str.weightItemClear * temp-str.qntyBuh
     1183     .
     1184     if line-counter( Out-Stream ) + j > page-size( Out-Stream )
     1185     then  PAGE STREAM Out-Stream.
     1186     display stream Out-Stream
     1187       sym1     num-ln
     1188       sym2     temp-str.artic
     1189       sym3     temp-str.gds-name
     1190       sym4     temp-str.b-code
     1191       sym5     temp-str.EI
     1192       sym6     temp-str.qntyFact
     1193       sym7     temp-str.weightItemLigat * temp-str.qntyFact @ sum1-weightFact-l
     1194       sym8     temp-str.weightItemClear * temp-str.qntyFact @ sum1-weightFact-c
     1195       sym9     temp-str.qntyBuh
     1196       sym10     temp-str.weightItemLigat * temp-str.qntyBuh  @ sum1-weightBuh-l
     1197       sym11     temp-str.weightItemClear * temp-str.qntyBuh  @ sum1-weightBuh-c
     1198       sym12
     1199     with FRAME invent-gold.
     1200     DOWN stream Out-Stream 1 with FRAME invent-gold
     1201     .
     1202     run inv8xl-write-line-data in this-procedure (
     1203         input num-ln
     1204         , input temp-str.gds-name
     1205         , input temp-str.artic
     1206         , input temp-str.b-code
     1207         , input temp-str.EI
     1208         , input temp-str.QntyFact
     1209         , input temp-str.WeightItemLigat * Qntyfact
     1210         , input temp-str.WeightItemClear * Qntyfact
     1211         , input temp-str.QntyBuh
     1212         , input temp-str.WeightItemLigat * QntyBuh
     1213         , input temp-str.WeightItemClear * QntyBuh
     1214     ).
     1215   end.
     1216     end.
     1217   end procedure.
     1218   procedure PrintTitul :
     1219   define variable v-organization  as character    no-undo.
     1220   define variable v-object        as character    no-undo.
     1221   do on error undo, return error return-value  :
     1222       case clients.obj-type:
     1223          when 'орг':U
     1224          then do:
     1225               FIND ub.firm WHERE ub.firm.firm-code = clients.obj-code NO-LOCK .
     1226               if available ub.firm
     1227               then do:
     1228                   assign
     1229                       t-addres = ( if ub.firm.ind = 0 or ub.firm.ind = ? then "" else string( ub.firm.ind ) )
     1230                       t-addres = t-addres
     1231                           + ( if ub.firm.city = ? or trim(ub.firm.city) = ""
     1232                               then ""
     1233                               else ( (if t-addres = "" then "" else ", ") + trim( ub.firm.city ) )
     1234                             )
     1235                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 1, 50 ) ) )
     1236                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     1237                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     1238                           + ( if  ub.firm.addres2 = ? or trim(ub.firm.addres2) = "" then "" else ( ", " + trim( ub.firm.addres2 ) ) )
     1239                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 51, 50 ) ) )
     1240                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     1241                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     1242                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 101, 50 ) ) )
     1243                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     1244                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     1245                       t-phone = ub.firm.phone
     1246                       t-inn   = ub.firm.inn
     1247                       t-okpo  = ub.firm.okpo
     1248                   .
     1249               end.
     1250          end.
     1251          when 'маг':U
     1252          then do:
     1253               FIND ub.shop WHERE ub.shop.obj-code = clients.obj-code NO-LOCK .
     1254               if available ub.shop
     1255               then do:
     1256                   assign
     1257                       t-addres = ( if trim( shop.addres1 ) <> "" then ( trim( shop.addres1 ) ) else "" )
     1258                               + ( if trim( shop.addres2 ) <> "" then ( ", " + trim( shop.addres2 ) ) else "" )
     1259                       t-phone = shop.phone
     1260                       t-inn = ""
     1261                       t-okpo = ""
     1262                   .
     1263               end.
     1264          end.
     1265          when 'скл':U
     1266          then do:
     1267               FIND ub.store WHERE ub.store.obj-code = clients.obj-code NO-LOCK .
     1268               if available ub.store
     1269               then do:
     1270                   assign
     1271                       t-addres = ( if trim( ub.store.addres1 ) <> "" then ( trim( ub.store.addres1 ) ) else "" )
     1272                               + ( if trim( ub.store.addres2 ) <> "" then ( ", " + trim( ub.store.addres2 ) ) else "" )
     1273                       t-phone = ub.store.phone
     1274                       t-inn = ""
     1275                       t-okpo = ""
     1276                   .
     1277               end.
     1278          end.
     1279          when 'чел':U
     1280          then do:
     1281               find ub.person where ub.person.psn-code = clients.obj-code no-lock .
     1282               if available ub.person
     1283               then do:
     1284                   assign
     1285                       t-addres = ( if ub.person.ind <> 0 and ub.person.ind <> ? then string( ub.person.ind ) else "" )
     1286                                   + ( if  ub.person.city <> ? and trim(ub.person.city) <> "" then ( ", " + trim( ub.person.city ) ) else "" )
     1287                                   + ( if  ub.person.address <> ? and trim(ub.person.address) <> "" then ( ", " + trim( ub.person.address ) ) else "" )
     1288                       t-phone = ub.person.phone1
     1289                       t-inn = ub.person.inn
     1290                       t-okpo = ub.person.okpo
     1291                   .
     1292               end.
     1293          end.
     1294       end case.
     1295      assign
     1296          v-organization = string( "ИНН " + t-inn + " " + CAPS( clients.obj-name ) + " (" + string(clients.obj-code) + ")"
     1297                                + t-addres + t-phone)
     1298          v-object       = string( CAPS( This_Object.obj-name ) + " (" + string(This_Object.obj-code) + ")" )
     1299      .
     1300      run inv8xl-write-cell-data in this-procedure (
     1301          input "h_organization":U
     1302          , input v-organization
     1303      ).
     1304      run inv8xl-write-cell-data in this-procedure (
     1305          input "h_object":U
     1306          , input v-object
     1307      ).
     1308      run inv8xl-write-cell-data in this-procedure (
     1309          input "h_docCode":U
     1310          , input tdoc-code
     1311      ).
     1312      run inv8xl-write-cell-data in this-procedure (
     1313          input "h_docDate":U
     1314          , input string( tdoc-date, "99/99/9999")
     1315      ).
     1316      PUT STREAM Out-Stream
     1317          "Унифицированная форма N ИНВ-8"             AT 138 skip
     1318          "Утверждена постановлением Госкомстата РФ"  AT 138 skip
     1319          "от 18 августа 1998 г. N 88"                AT 138 skip
     1320          "+----------------+"                        AT 166 skip
     1321          "|      Код       |"                        AT 166 skip
     1322          "+----------------+"                        AT 166 skip
     1323          "Форма по ОКУД|     0317008    |"           AT 153 skip
     1324          space(5) v-organization format "X(140)" "+----------------+" AT 166 skip
     1325          space(5) Line           format "X(140)" "по ОКПО" format "X(7)" AT 156 "|" AT 166 t-okpo format "X(16)" "|" AT 183 skip
     1326          space(35) "организация" format "X(120)" "+----------------+" AT 166 skip
     1327          space(5) v-object format "X(120)" "| " AT 166  "|" AT 183 skip
     1328          space(5) Line format  "X(120)"  "+----------------+" AT 166 skip
     1329          space(35) "структурное подразделение" format "x(85)" "Вид деятельности" AT 150 "| " AT 166 "|" AT 183 skip
     1330          "+--------+----------------+"                         AT 157 skip
     1331          "Основание для     приказ, постановление, распоряжение    |  номер |                |" AT 100 skip
     1332          "проведения        -----------------------------------    +--------+----------------+" AT 100 skip
     1333          "инвентаризации:           ненужное зачеркнуть            |  дата  |                |" AT 100 skip
     1334          "+--------+----------------+"         AT 157 skip
     1335          "Вид операции| инвентаризация |"      AT 154 skip
     1336          "+----------------+"                  AT 166 skip
     1337                            "+----------------+----------------+" AT 132 skip
     1338          space(54) " АКТ " "| Номер документа|Дата составления|" AT 132 skip
     1339          space(34) "инвентаризации драгоценных металлов и изделий из них"  "+----------------+----------------+" AT 132 skip
     1340          "|" AT 132 STRING(tdoc-code,"X(14)")  AT 134 "|   " AT 149 STRING(tdoc-date, "99/99/9999") AT 153 "   |" AT 163 skip
     1341          space(54) "РАСПИСКА" format "X(8)" "+----------------+----------------+" AT 132 skip
     1342          space(15) "К началу проведения инвентаризации все расходные и  приходные  документы на драгоценные металлы и изделия из них сданы в бухгалтерию, и все " SKIP
     1343          space(10) "драгоценные металлы и изделия из них, поступившие на мою (нашу)  ответственность, оприходованы, а выбывшие списаны в расход." SKIP(1)
     1344          space(15) "Материально ответственное (ые) лицо (а): " format "X(41)" skip(1)
     1345          UndLine format "X(25)" AT 50 UndLine format "X(25)" AT 80 UndLine format "X(50)" AT 110 SKIP
     1346          "должность" format "X(25)" AT 50 "подпись" format "X(25)" AT 80 "расшифровка подписи" format "X(50)" AT 110 SKIP(1)
     1347          UndLine format "X(25)" AT 50 UndLine format "X(25)" AT 80 UndLine format "X(50)" AT 110 SKIP
     1348          "должность" format "X(25)" AT 50 "подпись" format "X(25)" AT 80 "расшифровка подписи" format "X(50)" AT 110 SKIP(1)
     1349          UndLine format "X(25)" AT 50 UndLine format "X(25)" AT 80 UndLine format "X(50)" AT 110 SKIP
     1350          "должность" format "X(25)" AT 50 "подпись" format "X(25)" AT 80 "расшифровка подписи" format "X(50)" AT 110 SKIP(1)
     1351          space(15) "Акт составлен  комиссией  о  том,   что   проведена   инвентаризаци драгоценных металлов и изделий из них по состоянию на <<       >> _________________        г." SKIP(1)
     1352          space(15) "При инвентаризации установлено следующее:" SKIP
     1353      .
     1354      PAGE stream Out-Stream.
     1355      PUT STREAM Out-Stream
     1356      "+------------+--------------+-------------+"  AT 141 skip
     1357      ":            :      Единица измерения     :"  AT 141 skip
     1358      "+            +--------------+-------------+"  AT 141 skip
     1359      ":            : наименование : код по ОКЕИ :"  AT 141 skip
     1360      "+------------+--------------+-------------+"  AT 141 skip
     1361      ": количество :              :             :"  AT 141 skip
     1362      "+------------+--------------+-------------+"  AT 141 skip
     1363      ":   масса    :    грамм     :     163     :"  AT 141 skip
     1364      "+------------+--------------+-------------+"  AT 141 skip
     1365      .
     1366   end.
     1367   end procedure.
     1368   procedure PrintPodval :
     1369   do on error undo, return error return-value  :
     1370      run rep/wp-qnty.p ( num-ln , output PropisCount).
     1371      if PropisCount = '' Then PropisCount = 'Ноль'.
     1372      PAGE stream Out-Stream.
     1373      HIDE stream Out-Stream FRAME BottomFrame .
     1374      HIDE stream Out-Stream FRAME BottomFrame2 .
     1375      run rep/wp-qnty.p ( sum1-qntyFact , output PropisQnty).
     1376      if PropisQnty = ''
     1377      Then PropisQnty = 'Ноль'.
     1378      run rep/wp-qnty.p ( sum1-weightFact-l, output PropisSumall-l).
     1379      if PropisQnty = ''
     1380      Then PropisQnty = 'Ноль'.
     1381      run rep/wp-qnty.p ( sum1-weightFact-c, output PropisSumall-c).
     1382      if PropisQnty = ''
     1383      Then PropisQnty = 'Ноль'.
     1384      run inv8xl-write-cell-data in this-procedure (
     1385            input "it_s_Num":U
     1386          , input PropisCount
     1387      ).
     1388      run inv8xl-write-cell-data in this-procedure (
     1389            input "it_s_qntyFact":U
     1390          , input PropisQnty
     1391      ).
     1392      run inv8xl-write-cell-data in this-procedure (
     1393            input "it_s_WeightFact":U
     1394          , input PropisSumall-l
     1395      ).
     1396      run inv8xl-write-cell-data in this-procedure (
     1397            input "it_qntyFact":U
     1398          , input string( sum1-qntyFact )
     1399      ).
     1400      run inv8xl-write-cell-data in this-procedure (
     1401            input "it_WeightFact":U
     1402          , input string( sum1-weightFact-l )
     1403      ).
     1404      run inv8xl-write-cell-data in this-procedure (
     1405            input "it_qntyBuh":U
     1406          , input string( sum1-qntyBuh )
     1407      ).
     1408      run inv8xl-write-cell-data in this-procedure (
     1409            input "it_WeightBuh":U
     1410          , input string( sum1-weightBuh-l )
     1411      ).
     1412      PAGE STREAM Out-Stream.
     1413      PUT STREAM Out-Stream
     1414          "Итого по акту:" Skip
     1415            "а) количество порядковых номеров: " + string( num-ln ) + " (" + PropisCount + ")"  format "x(179)"                         at 18 SKIP
     1416            "б) общее количество единиц фактически: " + string( sum1-qntyFact ) + " (" + PropisQnty + ")"  format "x(179)"  at 18 SKIP
     1417            "в) масса драгоценных металлов фактически: "  AT 18                               SKIP
     1418            "лигатурная "                                 AT 25 "(" STRING(sum1-weightFact-l) ")" f-wp-qnty (decimal(sum1-weightFact-l)) FORMAT "x(90)"  SKIP
     1419            "чистая "                                     AT 25 "(" STRING(sum1-weightFact-c) ")" f-wp-qnty (decimal(sum1-weightFact-c)) FORMAT "x(90)"  SKIP
     1420          space(15) "Все подсчеты итогов по строкам, страницам и в целом по акту инвентаризации проверены." SKIP
     1421          space(15) "Председатель комиссии: " SKIP(1)
     1422          UndLine format "X(25)" AT 50 UndLine format "X(25)" AT 80 UndLine format "X(50)" AT 110 SKIP
     1423          "должность" format "X(25)" AT 50 "подпись" format "X(25)" AT 80 "расшифровка подписи" format "X(50)" AT 110 SKIP(1)
     1424          space(15) "Члены комиссии: " format "X(25)" SKIP
     1425          UndLine format "X(25)" AT 50 UndLine format "X(25)" AT 80 UndLine format "X(50)" AT 110 SKIP
