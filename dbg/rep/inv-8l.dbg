     1447   end.
     1448   end procedure.
     1449   PROCEDURE on-same-page :
     1450     define input parameter p-line-number as integer  no-undo .
     1451     if p-line-number > page-size( Out-Stream ) then return .
     1452     if line-counter( Out-Stream ) + p-line-number > page-size( Out-Stream ) then  page stream Out-Stream .
     1453   end procedure.
