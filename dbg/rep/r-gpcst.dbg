      750   define variable var-report-r-b as character no-undo .
      751   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      752   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      753     (output var-report-r-b
      754     )  .
      755   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      756   procedure cur-time :
      757      define output parameter p-today as date      no-undo .
      758      define output parameter p-time  as integer   no-undo .
      759     do
      760     on error undo, return error
      761     :
      762       define variable v-date1 as date      no-undo .
      763       define variable v-date2 as date      no-undo .
      764       define variable v-time  as integer   no-undo .
      765       assign
      766         v-date1 = today
      767         v-time  = time
      768         v-date2 = today
      769       .
      770       if v-date1 <> v-date2
      771       then do:
      772         assign
      773           v-date1 = today
      774           v-time  = v-time
      775         .
      776       end.
      777       assign
      778         p-today = v-date1
      779         p-time  = v-time
      780       .
      781     end.
      782   end.
      783   function cur-time-date returns character
      784   :
      785     return string(today, '99/99/9999':U) .
      786   end.
      787   function cur-time-mjd returns decimal
      788   :
      789     define variable v-date as date      no-undo .
      790     define variable v-time as integer   no-undo .
      791     run cur-time in this-procedure
      792       (output v-date
      793       ,output v-time
      794       ) .
      795     return integer(v-date) - 2400002 + (v-time / 86400) .
      796   end.
      797   function cur-time-get-ending-index returns integer
      798   (input p-number as integer
      799   )
      800   :
      801     if p-number < 0
      802     or p-number = ?
      803     then do:
      804       return 1 .
      805     end.
      806     define variable v-rest as integer   no-undo .
      807     assign
      808       p-number = p-number modulo 100
      809     .
      810     if p-number < 20
      811     then do:
      812       assign
      813         v-rest = p-number
      814       .
      815     end.
      816     else do:
      817       assign
      818         v-rest = p-number modulo 10
      819       .
      820     end.
      821     case v-rest :
      822       when 1
      823       then do:
      824         return 2 .
      825       end.
      826       when 2 or
      827       when 3 or
      828       when 4
      829       then do:
      830         return 3 .
      831       end.
      832       otherwise do:
      833         return 1 .
      834       end.
      835     end case .
      836   end.
      837   procedure cur-time-mjd-to-date :
      838      define input  parameter i-mjd-diff as decimal no-undo.
      839      define output parameter o-Date     as date    no-undo.
      840      define output parameter o-Time     as integer no-undo.
      841      define variable v-day-number as integer   no-undo .
      842      if    i-mjd-diff < 0
      843         or i-mjd-diff = ?
      844      then do:
      845         return "?" .
      846      end.
      847      assign
      848         v-day-number = truncate(i-mjd-diff,0).
      849         o-Date = date(v-day-number + 2400002).
      850         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      851     .
      852   end.
      853   function cur-time-mjd-to-string returns character
      854   (input p-mjd-diff as decimal
      855   )
      856   :
      857     define variable v-day-number as integer   no-undo .
      858     define variable v-seconds    as integer   no-undo .
      859     define variable v-hour       as integer   no-undo .
      860     define variable v-min        as integer   no-undo .
      861     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      862     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      863     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      864     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      865     if p-mjd-diff < 0
      866     or p-mjd-diff = ?
      867     then do:
      868       return "?" .
      869     end.
      870     assign
      871       v-day-number = integer(truncate(p-mjd-diff,0))
      872       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      873     .
      874     if v-seconds > 86400
      875     then do:
      876       assign
      877         v-seconds = 86400 - 1
      878       .
      879     end.
      880     if v-seconds < 0
      881     then do:
      882       assign
      883         v-seconds = 0
      884       .
      885     end.
      886     assign
      887       v-hour = truncate(v-seconds / 3600, 0)
      888     .
      889     assign
      890       v-seconds = v-seconds modulo 3600
      891     .
      892     assign
      893       v-min = truncate(v-seconds / 60, 0)
      894     .
      895     assign
      896       v-seconds = v-seconds modulo 60
      897     .
      898     return
      899         (if v-day-number <> 0
      900           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      901           else ""
      902         )
      903       + (if v-day-number <> 0 or v-hour <> 0
      904           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      905           else ""
      906         )
      907       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      908           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      909           else ""
      910         )
      911       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      912       .
      913   end.
      914   function cur-time-string returns character
      915   :
      916     define variable v-date as date      no-undo .
      917     define variable v-time as integer   no-undo .
      918     run cur-time in this-procedure
      919       (output v-date
      920       ,output v-time
      921       ) .
      922     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      923   end.
      924   function cur-time-string-sec returns character
      925   :
      926     define variable v-date as date      no-undo .
      927     define variable v-time as integer   no-undo .
      928     run cur-time in this-procedure
      929       (output v-date
      930       ,output v-time
      931       ) .
      932     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      933   end.
      934   function cur-time-custom  returns character
      935   (input p-prefix as character
      936   ,input p-date-format as character
      937   ,input p-delimiter as character
      938   ,input p-time-format as character
      939   ,input p-suffix as character
      940   )
      941   :
      942     define variable v-date as date      no-undo .
      943     define variable v-time as integer   no-undo .
      944     run cur-time in this-procedure
      945       (output v-date
      946       ,output v-time
      947       ) .
      948     return
      949       p-prefix
      950       + string(v-date, p-date-format)
      951       + p-delimiter
      952       + string(v-time, p-time-format)
      953       + p-suffix
      954       .
      955   end.
      956   function cur-time-print  returns character
      957   :
      958     define variable v-date as date      no-undo .
      959     define variable v-time as integer   no-undo .
      960     run cur-time in this-procedure
      961       (output v-date
      962       ,output v-time
      963       ) .
      964     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      965   end.
      966   function cur-time-datetime returns datetime
      967   :
      968     define variable v-char as character no-undo .
      969     define variable v-datetime as datetime no-undo .
      970     v-char = cur-time-string().
      971     v-datetime = datetime(v-char).
      972     return  v-datetime.
      973   end.
      974   function cur-time-string-msec returns character
      975   :
      976     define variable v-date as datetime  no-undo .
      977     v-date = now.
      978     return string(v-date) .
      979   end.
      980   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      981   define variable v-waitfram-action01         as character   no-undo .
      982   define variable v-waitfram-action02         as character   no-undo .
      983   define variable v-waitfram-action03         as character   no-undo .
      984   define variable mWaitFramTextBeg            as character   no-undo.
      985   define variable mWaitFramTextEnd            as character   no-undo.
      986   define variable mWaitFramView               as logical     no-undo.
      987   define variable mWaitProcEvent              as logical     no-undo init yes.
      988   define variable mWaitFramInterval           as integer     no-undo init 1 .
      989   define variable mWaitFramStop               as logical     no-undo.
      990   define variable mWaitFramStopUser           as logical     no-undo.
      991   define variable mWaitFramStopTimeOut        as logical     no-undo.
      992   define variable mWaitFramStartProc          as datetime-tz no-undo.
      993   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      994   define button B-WaitFramStop auto-end-key
      995        label "Стоп"
      996        size 10 by 1 tooltip "Остоновить процесс".
      997   define button B-viewProcInfo
      998        label "Информация"
      999        size 15 by 1 tooltip "Информация о процесс".
     1000   define frame waitfram
     1001     v-waitfram-action01 format "x(72)" no-label skip
     1002     v-waitfram-action02 format "x(72)" no-label skip
     1003     v-waitfram-action03 format "x(72)" no-label skip
     1004     B-viewProcInfo
     1005     B-WaitFramStop at row 4 col 30
     1006     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1007     .
     1008   define new global shared variable mBatchMode as logical no-undo init ?.
     1009   define variable mFramBachModHandle as handle no-undo.
     1010   mFramBachModHandle = frame waitfram:handle.
     1011   define variable mFameOldVis as logical no-undo.
     1012   define variable mVisCUrentVin as logical no-undo.
     1013   if session:batch-mode
     1014   then
     1015      mBatchMode = yes.
     1016   if mBatchMode = ? then do:
     1017     mVisCUrentVin = current-window:visible.
     1018     mFameOldVis = mFramBachModHandle:visible.
     1019     mFramBachModHandle:visible  = yes.
     1020     mBatchMode = mFramBachModHandle:visible ne yes.
     1021     mFramBachModHandle:visible = mFameOldVis.
     1022     current-window:visible = mVisCUrentVin.
     1023   end.
     1024    if  log-manager:logfile-name ne ?
     1025     then DO:
     1026         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1027         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1028         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1029     end.
     1030   on choose of B-WaitFramStop in frame waitfram
     1031   do:
     1032     mWaitFramStop = yes.
     1033     mWaitFramStopUser = yes.
     1034   end.
     1035   function waitfram-check-timeout returns logical():
     1036      define variable vtime as int64 no-undo.
     1037      if mWaitFramStopTimeOut
     1038      then
     1039         return yes.
     1040      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1041      if     mWaitFramTimeOut ne ?
     1042         and mWaitFramTimeOut ne 0
     1043         and mWaitFramTimeOut lt vtime
     1044      then do:
     1045         mWaitFramStopTimeOut = yes.
     1046      end.
     1047      return mWaitFramStopTimeOut.
     1048   end.
     1049   procedure waitfram-hide :
     1050     if not session:batch-mode
     1051     then do
     1052     on error undo, return error return-value
     1053     :
     1054       pause 0 before-hide .
     1055       if not mBatchMode then
     1056         hide frame waitfram .
     1057     if     not mWaitFramView
     1058        and mWaitProcEvent
     1059     then
     1060       process events .
     1061     end.
     1062   end procedure.
     1063   procedure waitfram-show :
     1064     define input  parameter p-message as character no-undo .
     1065     define variable v-left-margin as integer   no-undo .
     1066     if not session:batch-mode
     1067     then do
     1068     on error undo, return error return-value
     1069     :
     1070       if length(p-message) <= 70 then do:
     1071         assign
     1072           v-left-margin = integer((70 - length(p-message)) / 2)
     1073         .
     1074         assign
     1075           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1076         .
     1077         assign
     1078           v-waitfram-action01 = " "
     1079           v-waitfram-action02 = " "
     1080                                    + fill(" ", v-left-margin)
     1081                                    + p-message
     1082           v-waitfram-action03 = " "
     1083         .
     1084       end.
     1085       else do:
     1086         define variable vRindex1 as integer no-undo.
     1087         define variable vRindex2 as integer no-undo.
     1088         vRindex1 = r-index(p-message," ",70).
     1089         if vRindex1 = 0
     1090         then
     1091            vRindex1 = 70.
     1092         if length(p-message)  <= vRindex1 + 70 then do:
     1093           assign
     1094             v-waitfram-action01 = " "
     1095             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1096             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1097           .
     1098         end.
     1099         else do:
     1100           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1101           if vRindex2 <= vRindex1
     1102           then
     1103              vRindex2 = vRindex1 + 70.
     1104           assign
     1105             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1106             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1107             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1108           .
     1109         end.
     1110       end.
     1111       B-viewProcInfo:visible   in frame waitfram = no.
     1112       B-viewProcInfo:sensitive in frame waitfram = no.
     1113       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1114       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1115       if  (   mWaitFramView
     1116          or  mWaitProcEvent)
     1117          and not mBatchMode
     1118       then
     1119          display
     1120             v-waitfram-action01 skip
     1121             v-waitfram-action02 skip
     1122             v-waitfram-action03 skip
     1123          with frame waitfram .
     1124       if     mWaitFramView
     1125          then do:
     1126             if     mWaitFramInterval ne ?
     1127                and not mBatchMode
     1128             then
     1129                wait-for go of frame waitfram pause mWaitFramInterval.
     1130          end.
     1131          else
     1132             if     mWaitProcEvent
     1133                and not mBatchMode
     1134             then
     1135                process events .
     1136     end.
     1137   end procedure.
     1138      procedure waitfram-show-this:
     1139         define input  parameter iInterval as int64 no-undo.
     1140         define variable vtime as int64 no-undo.
     1141         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1142         mWaitFramInterval = iInterval.
     1143         run waitfram-show (substitute("&1&2 &3&4" ,
     1144                                       mWaitFramTextBeg ,
     1145                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1146                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1147                                       mWaitFramTextEnd
     1148                                      )
     1149                           ).
     1150      end.
     1151      procedure WaitFramRunPause:
     1152         define input  parameter iInterval as dec no-undo.
     1153         define variable vStart  as datetime-tz no-undo.
     1154         define variable vend    as datetime-tz no-undo.
     1155         define variable vint as int64 no-undo.
     1156         define variable vOk as logical no-undo.
     1157         vStart = now.
     1158         vend   = vStart.
     1159         publish "WaitFramPause" (iInterval,output vOk).
     1160         vend   =  now.
     1161         vint = vend - vStart.
     1162         vint = iInterval - vint / 1000.
     1163         if     not mWaitFramStop
     1164            and (   vint > 0
     1165                 or (    not vOk
     1166                     and iInterval eq ?
     1167                     )
     1168                 )
     1169         then
     1170            run waitfram-show-this (iInterval).
     1171         vend   =  now.
     1172         vint = vend - vStart.
     1173         vint = iInterval - vint / 1000.
     1174         if     not mWaitFramStop
     1175            and vint > 0
     1176         then do:
     1177            run gbl/pause.p (vint * 1000).
     1178         end.
     1179         if iInterval ne ?
     1180         then
     1181            publish "WaitFramStop".
     1182         waitfram-check-timeout().
     1183      end.
     1184      procedure WaitFramWaitFor:
     1185         define input  parameter iInterval as dec no-undo.
     1186         assign
     1187            mWaitFramStartProc   = now
     1188            mWaitFramStopUser    = no
     1189            mWaitFramStopTimeOut = no
     1190         .
     1191         block-wait:
     1192         do while not mWaitFramStop:
     1193            run WaitFramRunPause (iInterval).
     1194            if  waitfram-check-timeout()
     1195            then do:
     1196               leave block-wait.
     1197            end.
     1198         end.
     1199         run waitfram-hide.
     1200      end.
     1201   procedure waitfram-join :
     1202     define input  parameter p-line-1  as character no-undo .
     1203     define input  parameter p-line-2  as character no-undo .
     1204     define input  parameter p-line-3  as character no-undo .
     1205     define output parameter p-message as character no-undo .
     1206     do
     1207     on error undo, return error return-value
     1208     :
     1209       assign
     1210         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1211                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1212                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1213       .
     1214     end.
     1215   end procedure.
     1216   function waitfram-join-function returns character
     1217     (input p-line-1 as character
     1218     ,input p-line-2 as character
     1219     ,input p-line-3 as character
     1220     ).
     1221     define variable v-message as character no-undo .
     1222     run waitfram-join in this-procedure
     1223       (input  p-line-1
     1224       ,input  p-line-2
     1225       ,input  p-line-3
     1226       ,output v-message
     1227       ) .
     1228     return v-message .
     1229   end function .
     1230   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1231   define new global shared variable g#trdcalib as handle no-undo.
     1232   define variable sheets              as integer   no-undo.
     1233   define variable Line                as character no-undo .
     1234   define variable g#report-num        as integer   no-undo .
     1235   define variable varline-num         as integer   no-undo.
     1236   define variable v-curr-r-b as character no-undo .
     1237   define temp-table tt-gds no-undo
     1238   field out-code    like ub.chk-doc.out-code
     1239   field doc-code    like ub.chk-doc.doc-code
     1240   field gds-code    like ub.goods.gds-code
     1241   field obj-type    like ub.inkas.obj-type
     1242   field obj-code    like ub.inkas.obj-code
     1243   field artic       like ub.goods.artic
     1244   field prod-type   like ub.goods.prod-type
     1245   field prod-code   like ub.goods.prod-code
     1246   field gds-name    like ub.goods.gds-name
     1247   field prod-name   like ub.clients.obj-name
     1248   field price-base  like ub.chk-gds.price-base
     1249   field price       like ub.chk-gds.price-base
     1250   field discnt-base like ub.chk-gds.discnt
     1251   field discnt      like ub.chk-gds.discnt
     1252   field doc-qnty    like ub.chk-gds.doc-qnty initial 0.00
     1253   field sum-netto   as   decimal
     1254   field sum-brutto  as   decimal
     1255   field sum-discnt  as   decimal
     1256   field nofind-qnty as   decimal
     1257   field parts-f     as   logical
     1258   index pi is unique primary
     1259   out-code doc-code gds-code price-base discnt-base
     1260   index qnty
     1261   doc-qnty
     1262   index ret
     1263   out-code gds-code price-base discnt-base.
     1264   define temp-table tt-inkas     no-undo like ub.inkas .
     1265   define temp-table tt-exp-parts no-undo like ub.parts .
     1266   define temp-table tt-ret-parts no-undo like ub.parts .
     1267   define temp-table tt-gds-parts no-undo
     1268   field out-code    like ub.chk-doc.out-code
     1269   field doc-code    like ub.chk-doc.doc-code
     1270   field gds-code    like ub.goods.gds-code
     1271   field artic       like ub.goods.artic
     1272   field gds-name    like ub.goods.gds-name
     1273   field prod-name   like ub.clients.obj-name
     1274   field doc-qnty    like ub.chk-gds.doc-qnty initial 0.00
     1275   field price       like ub.chk-gds.price-base
     1276   field sum-brutto  as   decimal format "->,>>>,>>>,>>9.99"
     1277   field sum-discnt  as   decimal format "->,>>>,>>>,>>9.99"
     1278   field prc-discnt  as   decimal format "->9.9<%"
     1279   field sum-netto   as   decimal format "->,>>>,>>>,>>9.99"
     1280   field num-doc     as   character
     1281   field date-doc    as   date
     1282   field cst-code    like ub.parts.cst-code
     1283   field line-num    as integer
     1284   index pi is unique primary
     1285   line-num
     1286   index print-order
     1287   gds-code line-num
     1288   .
     1289   define variable varsum-qnty   like tt-gds-parts.doc-qnty   initial 0.00 no-undo.
     1290   define variable varsum-brutto like tt-gds-parts.sum-brutto no-undo.
     1291   define variable varsum-discnt like tt-gds-parts.sum-discnt no-undo.
     1292   define variable varsum-netto  like tt-gds-parts.sum-netto  no-undo.
     1293   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1294   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1295     (output v-curr-r-b
     1296     )  .
     1297   run prn-lib-open-stream  in this-procedure ( input my-handle
     1298                                               ,input 62
     1299                                               ,input yes
     1300                                               ,input no
     1301                                               ).
     1302   run fill-tt in this-procedure.
     1303   run waitfram-show in this-procedure ( 'Подождите ...' ) .
     1304   FOR EACH sheetf where sheetf.sheet-num > 1:
     1305     delete sheetf.
     1306   end.
     1307   FIND FIRST sheetf where
     1308               sheetf.sheet-num = 1 No-ERROR.
     1309   sheetf.sizes = "".
     1310   assign
     1311   Sheetf.Excel-Column-Lable = "Код"                        + chr(44) +
     1312                               "Артикул"                    + chr(44) +
     1313                               "Название"                   + chr(44) +
     1314                               "Производитель"              + chr(44) +
     1315                               "Кол-во"                     + chr(44) +
     1316                               "Цена"                       + chr(44) +
     1317                               "Сумма"                      + chr(44) +
     1318                               "Сумма скидки"               + chr(44) +
     1319                               "%Скидки"                    + chr(44) +
     1320                               "Выручка"                    + chr(44) +
     1321                               "Номер документа поставщика" + chr(44) +
     1322                               "Дата документа поставщика"  + chr(44) +
     1323                               "ГТД"
     1324   Sheetf.Sizes = "9,16,30,30,10,12,17,17,5,17,20,11,32"
     1325   sheetf.colformat = "1=@;2=@;12=dd/mm/yy":U
     1326   .
     1327   run rep/extitle.p (1) no-error.
     1328   for each tt-gds-parts use-index print-order:
     1329     if Make-Excel then  put   stream ForExcel unformatted
     1330     tt-gds-parts.gds-code    CHR(9)
     1331     tt-gds-parts.artic       CHR(9)
     1332     tt-gds-parts.gds-name    CHR(9)
     1333     tt-gds-parts.prod-name   CHR(9)
     1334     tt-gds-parts.doc-qnty    CHR(9)
     1335     tt-gds-parts.price       CHR(9)
     1336     tt-gds-parts.sum-brutto  CHR(9)
     1337     tt-gds-parts.sum-discnt  CHR(9)
     1338     tt-gds-parts.prc-discnt  CHR(9)
     1339     tt-gds-parts.sum-netto   CHR(9)
     1340     tt-gds-parts.num-doc     CHR(9)
     1341     if tt-gds-parts.date-doc  = ? then "" else string(tt-gds-parts.date-doc, "99/99/9999" )  CHR(9)
     1342     tt-gds-parts.cst-code    CHR(9)
     1343     skip.
     1344     assign
     1345       varsum-qnty   = varsum-qnty   + tt-gds-parts.doc-qnty
     1346       varsum-brutto = varsum-brutto + tt-gds-parts.sum-brutto
     1347       varsum-discnt = varsum-discnt + tt-gds-parts.sum-discnt
     1348       varsum-netto  = varsum-netto  + tt-gds-parts.sum-netto.
     1349   END.
     1350     if Make-Excel then  put   stream ForExcel unformatted
     1351     "Итого"        CHR(9)
     1352     ""             CHR(9)
     1353     ""             CHR(9)
     1354     ""             CHR(9)
     1355     varsum-qnty    CHR(9)
     1356     ""             CHR(9)
     1357     varsum-brutto  CHR(9)
     1358     varsum-discnt  CHR(9)
     1359     ""             CHR(9)
     1360     varsum-netto   CHR(9)
     1361     ""             CHR(9)
     1362     ""             CHR(9)
     1363     ""             CHR(9)
     1364     skip.
     1365   output stream prnlibstream close .
     1366   if Make-Excel then output stream ForExcel close.
     1367   run waitfram-hide in this-procedure .
     1368   run get-report-num in my-handle (output g#report-num).
     1369   run rep/runexcel.p (string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txt").
     1370   procedure fill-tt:
     1371   define buffer bf_inkas                for ub.inkas.
     1372   define buffer bf_chk-doc              for ub.chk-doc.
     1373   define buffer bf_chk-gds              for ub.chk-gds.
     1374   define buffer bf_chk-pay              for ub.chk-pay.
     1375   define buffer bf-exp_trn-doc          for ub.trn-doc.
     1376   define buffer bf-ret_trn-doc          for ub.trn-doc.
     1377   define buffer bf-exp_parts            for ub.parts.
     1378   define buffer bf-ret_parts            for ub.parts.
     1379   define buffer bf_bar-code             for ub.bar-code.
     1380   define buffer bf_goods                for ub.goods.
     1381   define buffer bf_clients              for ub.clients.
     1382   define buffer bf-in_trn-doc           for ub.trn-doc.
     1383   define buffer bf-ret_tt-gds           for tt-gds.
     1384   define variable v-attr-value-nids as character no-undo.
     1385   define variable v-attr-value-dids as character no-undo.
     1386   define variable v-attr-type       as character no-undo.
     1387   define variable v-rate as decimal no-undo.
     1388   for each tt-gds :
     1389     delete tt-gds.
     1390   end.
     1391   for each tt-gds-parts :
     1392     delete tt-gds-parts.
     1393   end.
     1394   for each tt-inkas:
     1395     delete tt-inkas.
     1396   end.
     1397   for each tt-exp-parts:
     1398     delete tt-exp-parts.
     1399   end.
     1400   for each tt-ret-parts:
     1401     delete tt-ret-parts.
     1402   end.
     1403   for each obj-list :
     1404     _chk-doc:
     1405     for each bf_chk-doc where
     1406           bf_chk-doc.obj-type =  obj-list.obj-type and
     1407           bf_chk-doc.obj-code =  obj-list.obj-code and
     1408           bf_chk-doc.chk-date >= x-date-start      and
     1409           bf_chk-doc.chk-date <= x-date-end        use-index obj-date no-lock :
     1410       if lookup(string(bf_chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0 then next _chk-doc.
     1411       find first bf_inkas where bf_inkas.inkas-code = bf_chk-doc.out-code no-lock no-error.
     1412       if not available bf_inkas or bf_inkas.status_ <> 'факт':U then next _chk-doc.
     1413       find first tt-inkas where tt-inkas.inkas-code = bf_inkas.inkas-code no-error.
     1414       if not available tt-inkas then do:
     1415         create tt-inkas.
     1416         buffer-copy bf_inkas to tt-inkas.
     1417         find first bf-exp_trn-doc where bf-exp_trn-doc.doc-code = bf_inkas.inkas-code no-lock no-error.
     1418         if available bf-exp_trn-doc then do:
     1419           for each bf-exp_parts where bf-exp_parts.out-code = bf-exp_trn-doc.doc-code no-lock :
     1420             create tt-exp-parts.
     1421             buffer-copy bf-exp_parts to tt-exp-parts.
     1422           end.
     1423         end.
     1424         find first bf-ret_trn-doc where bf-ret_trn-doc.out-code = bf_inkas.inkas-code no-lock no-error.
     1425         if available bf-ret_trn-doc then do:
     1426           for each bf-ret_parts where bf-ret_parts.out-code = bf-ret_trn-doc.doc-code no-lock :
     1427             create tt-ret-parts.
     1428             buffer-copy bf-ret_parts to tt-ret-parts.
     1429           end.
     1430         end.
     1431       end.
     1432       if v-curr-r-b = 'base':U then do:
     1433         assign
     1434           v-rate = bf_chk-doc.cash-rate / bf_chk-doc.cash-scale no-error .
     1435         if error-status:error or
     1436            v-rate = 0         or
     1437            v-rate = ?         then do:
     1438           find first bf_chk-pay where bf_chk-pay.doc-code = bf_chk-doc.doc-code no-lock no-error.
     1439           if not available bf_chk-pay then next _chk-doc.
     1440           assign
     1441             v-rate = bf_chk-pay.tot-rubl / bf_chk-pay.tot-base.
     1442         end.
     1443       end.
     1444       for each bf_chk-gds where
     1445                bf_chk-gds.doc-code = bf_chk-doc.doc-code no-lock :
     1446          find first bf_bar-code where bf_bar-code.b-code  = bf_chk-gds.b-code    no-lock.
     1447          find first bf_goods    where bf_goods.gds-code   = bf_bar-code.gds-code no-lock.
     1448          find first bf_clients  where bf_clients.obj-type = bf_goods.prod-type   and
     1449                                       bf_clients.obj-code = bf_goods.prod-code   no-lock.
     1450          find first tt-gds where tt-gds.out-code    = bf_chk-doc.out-code    and
     1451                                  tt-gds.doc-code    = bf_chk-doc.doc-code    and
     1452                                  tt-gds.gds-code    = bf_goods.gds-code      and
     1453                                  tt-gds.price-base  = bf_chk-gds.price-base  and
     1454                                  tt-gds.discnt-base = bf_chk-gds.discnt      no-error.
     1455          if not available tt-gds then do:
     1456            create tt-gds.
     1457            assign
     1458              tt-gds.out-code    = bf_chk-doc.out-code
     1459              tt-gds.doc-code    = bf_chk-doc.doc-code
     1460              tt-gds.gds-code    = bf_goods.gds-code
     1461              tt-gds.obj-type    = bf_inkas.obj-type
     1462              tt-gds.obj-code    = bf_inkas.obj-code
     1463              tt-gds.artic       = bf_goods.artic
     1464              tt-gds.prod-type   = bf_goods.prod-type
     1465              tt-gds.prod-code   = bf_goods.prod-code
     1466              tt-gds.gds-name    = bf_goods.gds-name
     1467              tt-gds.prod-name   = bf_clients.obj-name
     1468              tt-gds.price-base  = bf_chk-gds.price-base
     1469              tt-gds.discnt-base = bf_chk-gds.discnt
     1470              tt-gds.price       = (if v-curr-r-b = 'base':U then round(bf_chk-gds.price-base * v-rate, 2) else bf_chk-gds.price-base)
     1471              tt-gds.discnt      = (if v-curr-r-b = 'base':U then round(bf_chk-gds.discnt     * v-rate, 2) else bf_chk-gds.discnt)
     1472              .
     1473          end.
     1474          assign
     1475            tt-gds.doc-qnty    = tt-gds.doc-qnty   + bf_chk-gds.doc-qnty
     1476            tt-gds.nofind-qnty = tt-gds.doc-qnty
     1477            tt-gds.parts-f     = no
     1478            tt-gds.sum-brutto  = tt-gds.sum-brutto + tt-gds.price                   * bf_chk-gds.doc-qnty
     1479            tt-gds.sum-discnt  = tt-gds.sum-discnt + tt-gds.discnt                  * bf_chk-gds.doc-qnty
     1480            tt-gds.sum-netto   = tt-gds.sum-netto  + (tt-gds.price - tt-gds.discnt) * bf_chk-gds.doc-qnty
     1481          .
     1482       end.
     1483     end.
     1484   end.
     1485   for each tt-gds where tt-gds.doc-qnty = 0 :
     1486     delete tt-gds.
     1487   end.
     1488   assign
     1489     varline-num = 0.
     1490   for each tt-gds no-lock :
     1491     if tt-gds.doc-qnty > 0 then do:
     1492       _tt-exp-parts:
     1493       for each tt-exp-parts where tt-exp-parts.out-code  = tt-gds.out-code  and
     1494                                   tt-exp-parts.obj-type  = tt-gds.obj-type  and
     1495                                   tt-exp-parts.obj-code  = tt-gds.obj-code  and
     1496                                   tt-exp-parts.artic     = tt-gds.artic     and
     1497                                   tt-exp-parts.prod-type = tt-gds.prod-type and
     1498                                   tt-exp-parts.prod-code = tt-gds.prod-code :
     1499         assign
     1500           v-attr-value-nids = ""
     1501           v-attr-value-dids = ""
     1502           v-attr-type       = "".
     1503         find first bf-in_trn-doc where bf-in_trn-doc.doc-code = tt-exp-parts.in-code no-lock no-error.
     1504         if available bf-in_trn-doc then do:
     1505   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input bf-in_trn-doc.doc-code ,
     1506                           input 'nids':U ,
     1507                          output v-attr-value-nids ,
     1508                          output v-attr-type )  .
     1509   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input bf-in_trn-doc.doc-code ,
     1510                           input 'dids':U ,
     1511                          output v-attr-value-dids ,
     1512                          output v-attr-type )  .
     1513         end.
     1514         if tt-gds.nofind-qnty >= tt-exp-parts.fact-qnty then do:
     1515           assign
     1516             varline-num = varline-num + 1.
     1517           create tt-gds-parts.
     1518           assign
     1519             tt-gds-parts.out-code    = tt-gds.out-code
     1520             tt-gds-parts.doc-code    = tt-gds.doc-code
     1521             tt-gds-parts.gds-code    = tt-gds.gds-code
     1522             tt-gds-parts.artic       = tt-gds.artic
     1523             tt-gds-parts.gds-name    = tt-gds.gds-name
     1524             tt-gds-parts.prod-name   = tt-gds.prod-name
     1525             tt-gds-parts.doc-qnty    = tt-exp-parts.fact-qnty
     1526             tt-gds-parts.price       = tt-gds.price
     1527             tt-gds-parts.sum-brutto  = tt-gds.sum-brutto * (if tt-exp-parts.fact-qnty = tt-gds.doc-qnty then 1 else tt-exp-parts.fact-qnty / tt-gds.doc-qnty)
     1528             tt-gds-parts.sum-discnt  = tt-gds.sum-discnt * (if tt-exp-parts.fact-qnty = tt-gds.doc-qnty then 1 else tt-exp-parts.fact-qnty / tt-gds.doc-qnty)
     1529             tt-gds-parts.prc-discnt  = tt-gds-parts.sum-discnt / tt-gds-parts.sum-brutto * 100
     1530             tt-gds-parts.sum-netto   = tt-gds.sum-netto  * (if tt-exp-parts.fact-qnty = tt-gds.doc-qnty then 1 else tt-exp-parts.fact-qnty / tt-gds.doc-qnty)
     1531             tt-gds-parts.num-doc     = (if available bf-in_trn-doc then v-attr-value-nids else "Нет ВПН")
     1532             tt-gds-parts.date-doc    = (if available bf-in_trn-doc then DATE(v-attr-value-dids) else ?)
     1533             tt-gds-parts.cst-code    = tt-exp-parts.cst-code
     1534             tt-gds-parts.line-num    = varline-num
     1535           .
     1536           assign
     1537             tt-gds.nofind-qnty = tt-gds.nofind-qnty - tt-exp-parts.fact-qnty.
     1538           delete tt-exp-parts.
     1539           if tt-gds.nofind-qnty = 0 then do:
     1540             delete tt-gds.
     1541             leave _tt-exp-parts.
     1542           end.
     1543         end.
     1544         else do:
     1545           assign
     1546             varline-num = varline-num + 1.
     1547           create tt-gds-parts.
     1548           assign
     1549             tt-gds-parts.out-code    = tt-gds.out-code
     1550             tt-gds-parts.doc-code    = tt-gds.doc-code
     1551             tt-gds-parts.gds-code    = tt-gds.gds-code
     1552             tt-gds-parts.artic       = tt-gds.artic
     1553             tt-gds-parts.gds-name    = tt-gds.gds-name
     1554             tt-gds-parts.prod-name   = tt-gds.prod-name
     1555             tt-gds-parts.doc-qnty    = tt-gds.nofind-qnty
     1556             tt-gds-parts.price       = tt-gds.price
     1557             tt-gds-parts.sum-brutto  = tt-gds.sum-brutto * (if tt-gds.nofind-qnty = tt-gds.doc-qnty then 1 else tt-gds.nofind-qnty / tt-gds.doc-qnty)
     1558             tt-gds-parts.sum-discnt  = tt-gds.sum-discnt * (if tt-gds.nofind-qnty = tt-gds.doc-qnty then 1 else tt-gds.nofind-qnty / tt-gds.doc-qnty)
     1559             tt-gds-parts.prc-discnt  = tt-gds-parts.sum-discnt / tt-gds-parts.sum-brutto * 100
     1560             tt-gds-parts.sum-netto   = tt-gds.sum-netto  * (if tt-gds.nofind-qnty = tt-gds.doc-qnty then 1 else tt-gds.nofind-qnty / tt-gds.doc-qnty)
     1561             tt-gds-parts.num-doc     = (if available bf-in_trn-doc then v-attr-value-nids else "Нет ВПН")
     1562             tt-gds-parts.date-doc    = (if available bf-in_trn-doc then DATE(v-attr-value-dids) else ?  )
     1563             tt-gds-parts.cst-code    = tt-exp-parts.cst-code
     1564             tt-gds-parts.line-num    = varline-num
     1565           .
     1566           assign
     1567             tt-exp-parts.fact-qnty = tt-exp-parts.fact-qnty - tt-gds.nofind-qnty.
     1568           delete tt-gds.
     1569           leave _tt-exp-parts.
     1570         end.
     1571       end.
     1572     end.
     1573     else do:
     1574       find first bf-ret_trn-doc where bf-ret_trn-doc.out-code = tt-gds.out-code no-lock no-error.
     1575       if not available bf-ret_trn-doc then do:
     1576         message "Есть возвратная партия по товару " tt-gds.artic " " tt-gds.prod-type " " tt-gds.prod-code " в количестве " tt-gds.doc-qnty " из журнала продаж " tt-gds.out-code ". Не найдена накладная возврата."
     1577         view-as alert-box error.
     1578         return error.
     1579       end.
     1580       _tt-ret-parts:
     1581       for each tt-ret-parts where tt-ret-parts.out-code  = bf-ret_trn-doc.doc-code  and
     1582                                   tt-ret-parts.obj-type  = tt-gds.obj-type          and
     1583                                   tt-ret-parts.obj-code  = tt-gds.obj-code          and
     1584                                   tt-ret-parts.artic     = tt-gds.artic             and
     1585                                   tt-ret-parts.prod-type = tt-gds.prod-type         and
     1586                                   tt-ret-parts.prod-code = tt-gds.prod-code         :
     1587         assign
     1588           v-attr-value-nids = ""
     1589           v-attr-value-dids = ""
     1590           v-attr-type       = "".
     1591         find first bf-in_trn-doc where bf-in_trn-doc.doc-code = tt-ret-parts.in-code no-lock no-error.
     1592         if available bf-in_trn-doc then do:
     1593   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input bf-in_trn-doc.doc-code ,
     1594                           input 'nids':U ,
     1595                          output v-attr-value-nids ,
     1596                          output v-attr-type )  .
     1597   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input bf-in_trn-doc.doc-code ,
     1598                           input 'dids':U ,
     1599                          output v-attr-value-dids ,
     1600                          output v-attr-type )  .
     1601         end.
     1602         if - tt-gds.nofind-qnty >= tt-ret-parts.fact-qnty then do:
     1603           assign
     1604             varline-num = varline-num + 1.
     1605           create tt-gds-parts.
     1606           assign
     1607             tt-gds-parts.out-code    = tt-gds.out-code
     1608             tt-gds-parts.doc-code    = tt-gds.doc-code
     1609             tt-gds-parts.gds-code    = tt-gds.gds-code
     1610             tt-gds-parts.artic       = tt-gds.artic
     1611             tt-gds-parts.gds-name    = tt-gds.gds-name
     1612             tt-gds-parts.prod-name   = tt-gds.prod-name
     1613             tt-gds-parts.doc-qnty    = - tt-ret-parts.fact-qnty
     1614             tt-gds-parts.price       = tt-gds.price
     1615             tt-gds-parts.sum-brutto  = tt-gds.sum-brutto * (if tt-ret-parts.fact-qnty = - tt-gds.doc-qnty then 1 else tt-ret-parts.fact-qnty / - tt-gds.doc-qnty)
     1616             tt-gds-parts.sum-discnt  = tt-gds.sum-discnt * (if tt-ret-parts.fact-qnty = - tt-gds.doc-qnty then 1 else tt-ret-parts.fact-qnty / - tt-gds.doc-qnty)
     1617             tt-gds-parts.prc-discnt  = tt-gds-parts.sum-discnt / tt-gds-parts.sum-brutto * 100
     1618             tt-gds-parts.sum-netto   = tt-gds.sum-netto  * (if tt-ret-parts.fact-qnty = - tt-gds.doc-qnty then 1 else tt-ret-parts.fact-qnty / - tt-gds.doc-qnty)
     1619             tt-gds-parts.num-doc     = (if available bf-in_trn-doc then v-attr-value-nids       else "Нет ВПН")
     1620             tt-gds-parts.date-doc    = (if available bf-in_trn-doc then DATE(v-attr-value-dids) else ?        )
     1621             tt-gds-parts.cst-code    = tt-ret-parts.cst-code
     1622             tt-gds-parts.line-num    = varline-num
     1623           .
     1624           assign
     1625             tt-gds.nofind-qnty = tt-gds.nofind-qnty + tt-ret-parts.fact-qnty.
     1626           delete tt-ret-parts.
     1627           if tt-gds.nofind-qnty = 0 then do:
     1628             delete tt-gds.
     1629             leave _tt-ret-parts.
     1630           end.
     1631         end.
     1632         else do:
     1633           assign
     1634             varline-num = varline-num + 1.
     1635           create tt-gds-parts.
     1636           assign
     1637             tt-gds-parts.out-code    = tt-gds.out-code
     1638             tt-gds-parts.doc-code    = tt-gds.doc-code
     1639             tt-gds-parts.gds-code    = tt-gds.gds-code
     1640             tt-gds-parts.artic       = tt-gds.artic
     1641             tt-gds-parts.gds-name    = tt-gds.gds-name
     1642             tt-gds-parts.prod-name   = tt-gds.prod-name
     1643             tt-gds-parts.doc-qnty    = tt-gds.nofind-qnty
     1644             tt-gds-parts.price       = tt-gds.price
     1645             tt-gds-parts.sum-brutto  = tt-gds.sum-brutto * (if tt-gds.nofind-qnty = tt-gds.doc-qnty then 1 else tt-gds.nofind-qnty / tt-gds.doc-qnty)
     1646             tt-gds-parts.sum-discnt  = tt-gds.sum-discnt * (if tt-gds.nofind-qnty = tt-gds.doc-qnty then 1 else tt-gds.nofind-qnty / tt-gds.doc-qnty)
     1647             tt-gds-parts.prc-discnt  = tt-gds-parts.sum-discnt / tt-gds-parts.sum-brutto * 100
     1648             tt-gds-parts.sum-netto   = tt-gds.sum-netto  * (if tt-gds.nofind-qnty = tt-gds.doc-qnty then 1 else tt-gds.nofind-qnty / tt-gds.doc-qnty)
     1649             tt-gds-parts.num-doc     = (if available bf-in_trn-doc then v-attr-value-nids       else "Нет ВПН")
     1650             tt-gds-parts.date-doc    = (if available bf-in_trn-doc then DATE(v-attr-value-dids) else ?        )
     1651             tt-gds-parts.cst-code    = tt-ret-parts.cst-code
     1652             tt-gds-parts.line-num    = varline-num
     1653           .
     1654           assign
     1655             tt-ret-parts.fact-qnty = tt-ret-parts.fact-qnty + tt-gds.nofind-qnty.
     1656           delete tt-gds.
     1657           leave _tt-ret-parts.
     1658         end.
     1659       end.
     1660     end.
     1661   end.
     1662   define variable varerror as logical no-undo.
     1663   for each tt-gds where tt-gds.doc-qnty >   0.01 and
     1664                          tt-gds.doc-qnty < - 0.01 :
     1665     message "Остались непогашенные чеки по товару " tt-gds.artic " " tt-gds.prod-type " " tt-gds.prod-code " в количестве " tt-gds.doc-qnty " из журнала продаж " tt-gds.out-code skip
     1666     view-as alert-box error.
     1667     assign
     1668       varerror = yes.
     1669   end.
     1670   for each tt-exp-parts where tt-exp-parts.fact-qnty > 0.01 :
     1671     message "Остались непогашенные расходные партии по товару " tt-exp-parts.artic " " tt-exp-parts.prod-type " " tt-exp-parts.prod-code " в количестве " tt-exp-parts.fact-qnty " из журнала продаж " tt-exp-parts.out-code skip
     1672     view-as alert-box error.
     1673     assign
     1674       varerror = yes.
     1675   end.
     1676   for each tt-ret-parts where tt-ret-parts.fact-qnty < -0.01 :
     1677     message "Остались непогашенные возвратные партии по товару " tt-ret-parts.artic " " tt-ret-parts.prod-type " " tt-ret-parts.prod-code " в количестве " tt-ret-parts.fact-qnty " из журнала продаж " tt-ret-parts.out-code skip
     1678     view-as alert-box error.
     1679     assign
     1680       varerror = yes.
     1681   end.
     1682   if varerror = yes then do:
     1683     return error.
     1684   end.
     1685   end procedure.
