     1028         undo, return error return-value .
     1029       end.
     1030       find first buf_cash-pay-attr exclusive-lock
     1031         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
     1032           and buf_cash-pay-attr.curr-code  = p-curr-code
     1033           and buf_cash-pay-attr.host-code  = p-host-code
