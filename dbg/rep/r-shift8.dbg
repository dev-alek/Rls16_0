     1145   define variable v-prev-page as integer no-undo .
     1146   define variable v-curr-page as integer no-undo .
     1147   define buffer cli-treal-8 for treal-8 .
     1148   define buffer cli-gds-treal-8 for treal-8 .
     1149   define buffer gds-treal-8 for treal-8 .
     1150   define buffer cp-gds-treal-8 for treal-8 .
     1151   define buffer cp-treal-8 for treal-8 .
     1152   define buffer buf_cash-pay for ub.cash-pay.
