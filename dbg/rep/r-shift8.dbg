     1053       define output parameter p-deleted  as logical no-undo.
     1054       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
     1055       define variable v-type           as character no-undo .
     1056       define variable v-format         as character no-undo .
     1057       define variable v-label          as character no-undo .
     1058       define variable v-range          as integer   no-undo .
     1059       define variable v-user-can-edit  as logical   no-undo .
     1060       define variable v-output-display as logical   no-undo .
