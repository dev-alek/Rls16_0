     1095   procedure cp-attr-news :
     1096     do
     1097     on error undo, return error
     1098     :
     1099       define input  parameter p-code           as character no-undo .
     1100       define output parameter p-news           as logical   no-undo .
     1101       case p-code :
     1102               when 'paycard-export-prefix':U then do:     assign     p-news = true.   end.
     1103               when 'grp-code':U then do:     assign     p-news = true.   end.
     1104               when 'is-use':U then do:     assign     p-news = true.   end.
     1105               when 'dop-doc':U then do:     assign     p-news = true.   end.
     1106               when 'paycard-all-prefix':U then do:     assign     p-news = true.   end.
     1107               when 'paycard-edit-prefix':U then do:     assign     p-news = true.   end.
     1108               when 'form_km3':U then do:     assign     p-news = false.   end.
     1109               when 'bal_malina':U then do:     assign     p-news = false.   end.
     1110               when 'max_proc_sum':U then do:     assign     p-news = true.   end.
     1111               when 'mask_card_kup':U then do:     assign     p-news = true.   end.
     1112         otherwise do:
     1113           p-news = no.
     1114         end.
     1115       end.
     1116     end.
     1117   end procedure.
