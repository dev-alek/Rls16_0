     1138   define shared stream PrnLibstream.
     1139   define variable accum-qnty1 as decimal no-undo .
     1140   define variable accum-netto-rubl as decimal no-undo .
     1141   define variable v-ii as integer no-undo .
     1142   define variable v-jj as integer no-undo .
