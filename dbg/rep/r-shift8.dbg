     1080           and buf_cash-pay-attr.obj-code   = p-obj-code
     1081           and buf_cash-pay-attr.attr-code = p-code
     1082         no-error NO-WAIT.
     1083       if not available buf_cash-pay-attr then do:
     1084         p-deleted = no.
     1085       end.
     1086       else do:
     1087         delete buf_cash-pay-attr no-error .
