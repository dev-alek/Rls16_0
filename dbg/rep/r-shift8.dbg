     1398       gds-treal-8.netto-rubl format "->>>,>>9.99"  ':':U
     1399       .
     1400     end.
     1401     if Make-Excel then  put   stream ForExcel unformatted
     1402     gds-treal-8.qnty1  CHR(9)
     1403     gds-treal-8.netto-rubl CHR(9)
     1404     .
     1405     assign
     1406     accum-qnty1 = accum-qnty1 + gds-treal-8.qnty1
     1407     accum-netto-rubl = accum-netto-rubl + gds-treal-8.netto-rubl
     1408     .
     1409   end.
     1410   if v-text then do:
     1411     put stream PrnLibstream unformatted
     1412     accum-qnty1 format  "->>,>>>,>>9.99" ':':U
     1413     accum-netto-rubl format "->>,>>>,>>9.99"
     1414     skip.
     1415     if Make-Excel then  put   stream ForExcel unformatted
     1416     accum-qnty1  CHR(9)
     1417     accum-netto-rubl
     1418     skip
     1419     .
     1420   end.
     1421   procedure print-header :
     1422   define input parameter p-col1-name as character no-undo .
     1423     do
     1424     on error undo, return error
     1425     :
     1426       if v-text then do:                       put stream PrnLibstream unformatted        fill('-':U, 29 + 1)        .                                        do v-jj = 1 to v-ii:                       put stream PrnLibstream unformatted         fill('-':U, 23 + 2)         .                                         end.                                         put stream PrnLibstream unformatted             fill('-':U, 29 + 1)       skip.                                   end.
     1427       if v-text then do:
     1428         put stream PrnLibstream unformatted
     1429         string(p-col1-name, "X(29)") ":"
     1430         .
     1431       end.
     1432       for each gds-treal-8 where
     1433               gds-treal-8.gds-code > 0
     1434           and gds-treal-8.cpay-code = 0
     1435           and gds-treal-8.curr-code = 0
     1436           and gds-treal-8.cli-type = '':U
     1437           and gds-treal-8.cli-code = 0
     1438           ,
     1439           first buf_goods no-lock where
     1440                 buf_goods.gds-code = gds-treal-8.gds-code:
     1441         if v-text then do:
     1442           put stream PrnLibstream unformatted
     1443           string(buf_goods.chk-name, "X(23)")  ":"
     1444           .
     1445         end.
     1446       end.
     1447       if v-text then do:
     1448         put stream PrnLibstream unformatted
     1449         string( "ИТОГО",  "X(29)")
     1450         skip
     1451         .
     1452       end.
     1453       if v-text then do:
     1454         put stream PrnLibstream unformatted
     1455         fill( chr(32),  29) ":"
     1456         .
     1457       end.
     1458       for each gds-treal-8 where
     1459             gds-treal-8.gds-code > 0
     1460         and gds-treal-8.cpay-code = 0
     1461         and gds-treal-8.curr-code = 0
     1462         and gds-treal-8.cli-type = '':U
     1463         and gds-treal-8.cli-code = 0
     1464         :
     1465         if v-text then do:
     1466           put stream PrnLibstream unformatted
     1467           string(" литры",  "X(11)") ':':U
     1468           string(" рубли",  "X(11)") ':':U
     1469           .
     1470         end.
     1471       end.
     1472       if v-text then do:
     1473         put stream PrnLibstream unformatted
     1474         string( "литры",  "X(14)")  ':'
     1475         string(" рубли",  "X(15)")
     1476         skip
     1477         .
     1478       end.
     1479       if v-text then do:                       put stream PrnLibstream unformatted        fill('-':U, 29 + 1)        .                                        do v-jj = 1 to v-ii:                       put stream PrnLibstream unformatted         fill('-':U, 23 + 2)         .                                         end.                                         put stream PrnLibstream unformatted             fill('-':U, 29 + 1)       skip.                                   end.
     1480     end.
     1481   end procedure.
