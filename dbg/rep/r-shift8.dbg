     1154   define buffer buf_clients for ub.clients.
     1155     procedure on-same-page :
     1156       define input parameter p-line-number as integer no-undo .
     1157       if p-line-number > page-size( PrnLibstream )
     1158       then do:
     1159         return .
     1160       end.
     1161       if line-counter( PrnLibstream ) + p-line-number > page-size( PrnLibstream )
     1162       then do:
     1163         page stream PrnLibstream .
     1164       end.
     1165     end procedure.
     1166   FORM HEADER
     1167     ''
     1168   WITH FRAME TopFrame WIDTH 232 PAGE-TOP NO-LABELS NO-BOX.
     1169   VIEW STREAM PrnLibstream FRAME TOpFrame.
     1170   for each gds-treal-8 where
     1171         gds-treal-8.gds-code > 0
     1172     and gds-treal-8.cpay-code = 0
     1173     and gds-treal-8.curr-code = 0
     1174     and gds-treal-8.cli-type = '':U
     1175     and gds-treal-8.cli-code = 0
     1176     :
     1177     v-ii = v-ii + 1.
     1178   end.
     1179   if 29 + 1 + (v-ii * (23 + 2)) + 29 + 1 > 232 then do:
     1180     put stream PrnLibstream unformatted
     1181     "Слишком широкий отчет - смотрите в EXCEL"
     1182     skip.
     1183     v-text = no.
     1184   end.
     1185   else v-text = yes.
     1186   output to jj.txt.
     1187   for each treal-8:
     1188     export treal-8.
     1189   end.
     1190   output close.
     1191   FOR EACH cp-treal-8 where
     1192            cp-treal-8.gds-code = 0
     1193        and cp-treal-8.cpay-code > 0
     1194        and cp-treal-8.cli-type = '':U
     1195        and cp-treal-8.cli-code = 0,
     1196      first buf_cash-pay no-lock where
     1197           buf_cash-pay.cdpay-code = cp-treal-8.cpay-code
     1198       and buf_cash-pay.curr-code = cp-treal-8.curr-code
     1199   break
     1200   by cp-treal-8.cpay-code
     1201   by cp-treal-8.curr-code
     1202   :
     1203     if first-of( cp-treal-8.curr-code) then do:
     1204       run print-header in this-procedure ( input " Тип кассового платежа ").
     1205     end.
     1206     if v-text then do:
     1207       put stream PrnLibstream unformatted
     1208       string(buf_cash-pay.obj-name, "X(29)") ":"
     1209       .
     1210     end.
     1211     if Make-Excel then  put   stream ForExcel unformatted
     1212     buf_cash-pay.obj-name CHR(9)
     1213     .
     1214     for each gds-treal-8 where
     1215           gds-treal-8.gds-code > 0
     1216       and gds-treal-8.cpay-code = 0
     1217       and gds-treal-8.curr-code = 0
     1218       and gds-treal-8.cli-type = '':U
     1219       and gds-treal-8.cli-code = 0
     1220       :
     1221       find first cp-gds-treal-8 where
     1222             cp-gds-treal-8.gds-code = gds-treal-8.gds-code
     1223         and cp-gds-treal-8.cpay-code = cp-treal-8.cpay-code
     1224         and cp-gds-treal-8.curr-code = cp-treal-8.curr-code
     1225         and cp-gds-treal-8.cli-type = '':U
     1226         and cp-gds-treal-8.cli-code = 0
     1227         no-error.
     1228       if available cp-gds-treal-8 then do:
     1229         if v-text then do:
     1230           put stream PrnLibstream unformatted
     1231           cp-gds-treal-8.qnty1 format  "->>>,>>9.99" ':':U
     1232           cp-gds-treal-8.netto-rubl format "->>>,>>9.99" ':':U
     1233           .
     1234         end.
     1235         if Make-Excel then  put   stream ForExcel unformatted
     1236         cp-gds-treal-8.qnty1      CHR(9)
     1237         cp-gds-treal-8.netto-rubl CHR(9)
     1238         .
     1239       end.
     1240       else do:
     1241         if v-text then do:
     1242           put stream PrnLibstream unformatted
     1243           0.0 format "->>>,>>9.99" ':':U
     1244           0.0 format "->>>,>>9.99" ':':U
     1245           .
     1246         end.
     1247         if Make-Excel then  put   stream ForExcel unformatted
     1248         0.0 CHR(9)
     1249         0.0 CHR(9)
     1250         .
     1251       end.
     1252     end.
     1253     if v-text then do:
     1254       put stream PrnLibstream unformatted
     1255       cp-treal-8.qnty1      format "->>,>>>,>>9.99" ':':U
     1256       cp-treal-8.netto-rubl format "->>,>>>,>>9.99"
     1257       skip
     1258       .
     1259     end.
     1260     if Make-Excel then  put   stream ForExcel unformatted
     1261     cp-treal-8.qnty1      CHR(9)
     1262     cp-treal-8.netto-rubl  CHR(9)
     1263     skip
     1264     .
     1265   end.
     1266   if v-text then do:                       put stream PrnLibstream unformatted        fill('-':U, 29 + 1)        .                                        do v-jj = 1 to v-ii:                       put stream PrnLibstream unformatted         fill('-':U, 23 + 2)         .                                         end.                                         put stream PrnLibstream unformatted             fill('-':U, 29 + 1)       skip.                                   end.
     1267   if v-text then do:
     1268     put stream PrnLibstream unformatted
     1269     "В том числе по контрагентам"
     1270     skip.
     1271   end.
     1272   if Make-Excel then  put   stream ForExcel unformatted
     1273   "В том числе по контрагентам"
     1274   skip.
     1275   if v-text then do:                       put stream PrnLibstream unformatted        fill('-':U, 29 + 1)        .                                        do v-jj = 1 to v-ii:                       put stream PrnLibstream unformatted         fill('-':U, 23 + 2)         .                                         end.                                         put stream PrnLibstream unformatted             fill('-':U, 29 + 1)       skip.                                   end.
     1276   for each treal-8
     1277   where treal-8.cli-type > '':U
     1278   break
     1279   by treal-8.cli-type
     1280   by treal-8.cli-code:
     1281      if last-of (treal-8.cli-code) then do:
     1282        v-prev-page = page-number( PrnLibstream).
     1283        run on-same-page in this-procedure ( input 1 + 1 ).
     1284        v-curr-page = page-number( PrnLibstream).
     1285        if v-curr-page > v-prev-page then do:
     1286           run print-header in this-procedure ( input " Наименование контрагента ").
     1287        end.
     1288        find first buf_clients no-lock where
     1289                 buf_clients.obj-type = treal-8.cli-type
     1290             and buf_clients.obj-code = treal-8.cli-code.
     1291         if v-text then do:
     1292           put stream PrnLibstream unformatted
     1293           string(buf_clients.obj-name, "X(29)") ":"
     1294           .
     1295         end.
     1296         if Make-Excel then  put   stream ForExcel unformatted
     1297         buf_clients.obj-name CHR(9).
     1298         for each gds-treal-8 where
     1299               gds-treal-8.gds-code > 0
     1300           and gds-treal-8.cpay-code = 0
     1301           and gds-treal-8.curr-code = 0
     1302           and gds-treal-8.cli-type = '':U
     1303           and gds-treal-8.cli-code = 0:
     1304           find first cli-gds-treal-8 where
     1305                     cli-gds-treal-8.gds-code = gds-treal-8.gds-code
     1306                 and cli-gds-treal-8.cpay-code = gds-treal-8.cpay-code
     1307                 and cli-gds-treal-8.curr-code = gds-treal-8.curr-code
     1308                 and cli-gds-treal-8.cli-type = treal-8.cli-type
     1309                 and cli-gds-treal-8.cli-code = treal-8.cli-code no-error .
     1310           if available cli-gds-treal-8 then do:
     1311             if v-text then do:
     1312               put stream PrnLibstream unformatted
     1313               cli-gds-treal-8.qnty1      format "->>>,>>9.99" ':':U
     1314               cli-gds-treal-8.netto-rubl format "->>>,>>9.99" ':':U
     1315               .
     1316             end.
     1317             if Make-Excel then  put   stream ForExcel unformatted
     1318             cli-gds-treal-8.qnty1      CHR(9)
     1319             cli-gds-treal-8.netto-rubl CHR(9)
     1320             .
     1321           end.
     1322           else do:
     1323             if v-text then do:
     1324               put stream PrnLibstream unformatted
     1325               0.0 format "->>>,>>9.99" ':':U
     1326               0.0 format "->>>,>>9.99" ':':U
     1327               .
     1328             end.
     1329             if Make-Excel then  put   stream ForExcel unformatted
     1330             0.0 CHR(9)
     1331             0.0 CHR(9)
     1332             .
     1333           end.
     1334         end.
     1335         find first cli-treal-8 where
     1336                   cli-treal-8.gds-code = 0
     1337               and cli-treal-8.cpay-code = 0
     1338               and cli-treal-8.curr-code = 0
     1339               and cli-treal-8.cli-type = treal-8.cli-type
     1340               and cli-treal-8.cli-code = treal-8.cli-code no-error .
     1341         if available cli-treal-8 then do:
     1342           if v-text then do:
     1343             put stream PrnLibstream unformatted
     1344             cli-treal-8.qnty1 format  "->>,>>>,>>9.99" ':':U
     1345             cli-treal-8.netto-rubl format "->>,>>>,>>9.99"
     1346             skip
     1347             .
     1348           end.
     1349           if Make-Excel then  put   stream ForExcel unformatted
