       15   define variable vss-revision    as character no-undo initial "$Revision: aea5316774be, 0, rls $":U.
       16   define variable vss-author      as character no-undo initial "$Author: expertek $":U.
       17   define variable vss-date        as character no-undo initial "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U.
