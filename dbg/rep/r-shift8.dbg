      606   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      607   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      608   procedure cur-time :
      609      define output parameter p-today as date      no-undo .
      610      define output parameter p-time  as integer   no-undo .
      611     do
      612     on error undo, return error
      613     :
      614       define variable v-date1 as date      no-undo .
      615       define variable v-date2 as date      no-undo .
      616       define variable v-time  as integer   no-undo .
      617       assign
      618         v-date1 = today
      619         v-time  = time
      620         v-date2 = today
      621       .
      622       if v-date1 <> v-date2
      623       then do:
      624         assign
      625           v-date1 = today
      626           v-time  = v-time
      627         .
      628       end.
      629       assign
      630         p-today = v-date1
      631         p-time  = v-time
      632       .
      633     end.
      634   end.
      635   function cur-time-date returns character
      636   :
      637     return string(today, '99/99/9999':U) .
      638   end.
      639   function cur-time-mjd returns decimal
      640   :
      641     define variable v-date as date      no-undo .
      642     define variable v-time as integer   no-undo .
      643     run cur-time in this-procedure
      644       (output v-date
      645       ,output v-time
      646       ) .
      647     return integer(v-date) - 2400002 + (v-time / 86400) .
      648   end.
      649   function cur-time-get-ending-index returns integer
      650   (input p-number as integer
      651   )
      652   :
      653     if p-number < 0
      654     or p-number = ?
      655     then do:
      656       return 1 .
      657     end.
      658     define variable v-rest as integer   no-undo .
      659     assign
      660       p-number = p-number modulo 100
      661     .
      662     if p-number < 20
      663     then do:
      664       assign
      665         v-rest = p-number
      666       .
      667     end.
      668     else do:
      669       assign
      670         v-rest = p-number modulo 10
      671       .
      672     end.
      673     case v-rest :
      674       when 1
      675       then do:
      676         return 2 .
      677       end.
      678       when 2 or
      679       when 3 or
      680       when 4
      681       then do:
      682         return 3 .
      683       end.
      684       otherwise do:
      685         return 1 .
      686       end.
      687     end case .
      688   end.
      689   procedure cur-time-mjd-to-date :
      690      define input  parameter i-mjd-diff as decimal no-undo.
      691      define output parameter o-Date     as date    no-undo.
      692      define output parameter o-Time     as integer no-undo.
      693      define variable v-day-number as integer   no-undo .
      694      if    i-mjd-diff < 0
      695         or i-mjd-diff = ?
      696      then do:
      697         return "?" .
      698      end.
      699      assign
      700         v-day-number = truncate(i-mjd-diff,0).
      701         o-Date = date(v-day-number + 2400002).
      702         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      703     .
      704   end.
      705   function cur-time-mjd-to-string returns character
      706   (input p-mjd-diff as decimal
      707   )
      708   :
      709     define variable v-day-number as integer   no-undo .
      710     define variable v-seconds    as integer   no-undo .
      711     define variable v-hour       as integer   no-undo .
      712     define variable v-min        as integer   no-undo .
      713     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      714     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      715     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      716     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      717     if p-mjd-diff < 0
      718     or p-mjd-diff = ?
      719     then do:
      720       return "?" .
      721     end.
      722     assign
      723       v-day-number = integer(truncate(p-mjd-diff,0))
      724       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      725     .
      726     if v-seconds > 86400
      727     then do:
      728       assign
      729         v-seconds = 86400 - 1
      730       .
      731     end.
      732     if v-seconds < 0
      733     then do:
      734       assign
      735         v-seconds = 0
      736       .
      737     end.
      738     assign
      739       v-hour = truncate(v-seconds / 3600, 0)
      740     .
      741     assign
      742       v-seconds = v-seconds modulo 3600
      743     .
      744     assign
      745       v-min = truncate(v-seconds / 60, 0)
      746     .
      747     assign
      748       v-seconds = v-seconds modulo 60
      749     .
      750     return
      751         (if v-day-number <> 0
      752           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      753           else ""
      754         )
      755       + (if v-day-number <> 0 or v-hour <> 0
      756           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      757           else ""
      758         )
      759       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      760           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      761           else ""
      762         )
      763       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      764       .
      765   end.
      766   function cur-time-string returns character
      767   :
      768     define variable v-date as date      no-undo .
      769     define variable v-time as integer   no-undo .
      770     run cur-time in this-procedure
      771       (output v-date
      772       ,output v-time
      773       ) .
      774     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      775   end.
      776   function cur-time-string-sec returns character
      777   :
      778     define variable v-date as date      no-undo .
      779     define variable v-time as integer   no-undo .
      780     run cur-time in this-procedure
      781       (output v-date
      782       ,output v-time
      783       ) .
      784     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      785   end.
      786   function cur-time-custom  returns character
      787   (input p-prefix as character
      788   ,input p-date-format as character
      789   ,input p-delimiter as character
      790   ,input p-time-format as character
      791   ,input p-suffix as character
      792   )
      793   :
      794     define variable v-date as date      no-undo .
      795     define variable v-time as integer   no-undo .
      796     run cur-time in this-procedure
      797       (output v-date
      798       ,output v-time
      799       ) .
      800     return
      801       p-prefix
      802       + string(v-date, p-date-format)
      803       + p-delimiter
      804       + string(v-time, p-time-format)
      805       + p-suffix
      806       .
      807   end.
      808   function cur-time-print  returns character
      809   :
      810     define variable v-date as date      no-undo .
      811     define variable v-time as integer   no-undo .
      812     run cur-time in this-procedure
      813       (output v-date
      814       ,output v-time
      815       ) .
      816     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      817   end.
      818   function cur-time-datetime returns datetime
      819   :
      820     define variable v-char as character no-undo .
      821     define variable v-datetime as datetime no-undo .
      822     v-char = cur-time-string().
      823     v-datetime = datetime(v-char).
      824     return  v-datetime.
      825   end.
      826   function cur-time-string-msec returns character
      827   :
      828     define variable v-date as datetime  no-undo .
      829     v-date = now.
      830     return string(v-date) .
      831   end.
      832   procedure cp-attr-code :
      833     do
      834     on error undo, return error
      835     :
      836       define input  parameter p-code           as character no-undo .
      837       define output parameter p-type           as character no-undo .
      838       define output parameter p-format         as character no-undo .
      839       define output parameter p-label          as character no-undo .
      840       define output parameter p-range          as integer   no-undo .
      841       define output parameter p-user-can-edit  as logical   no-undo .
      842       define output parameter p-output-display as logical   no-undo .
      843       define output parameter p-other          as character no-undo .
      844       case p-code :
      845               when 'paycard-export-prefix':U then do:     assign     p-label = "Префиксы платежных карт (для выгрузки в XML)"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт (для выгрузки в XML)"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
      846               when 'grp-code':U then do:     assign     p-label = "Группа платежа"     p-type = 'C':U      p-format = "X(45)"     p-label = "Группа платежа"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=grp-code':u      .   end.
      847               when 'is-use':U then do:     assign     p-label = "Используется"     p-type = 'C':U      p-format = "X(255)"     p-label = "Используется"     p-range = 4     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=is-use':u      .   end.
      848               when 'dop-doc':U then do:     assign     p-label = "Дополнительный документ"     p-type = 'C':U      p-format = "X(255)"     p-label = "Дополнительный документ"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=dop-doc':u      .   end.
      849               when 'paycard-all-prefix':U then do:     assign     p-label = "Префиксы платежных карт (для разбора чеков и т.д.)"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт (для разбора чеков и т.д.)"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
      850               when 'paycard-edit-prefix':U then do:     assign     p-label = "Префиксы платежных карт, разрешенных для редактирования"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт, разрешенных для редактирования"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
      851               when 'form_km3':U then do:     assign     p-label = "Формировать КМ-3 по чекам возврата"     p-type = 'L':U      p-format = "+/-"     p-label = "Формировать КМ-3 по чекам возврата"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
      852               when 'bal_malina':U then do:     assign     p-label = "Оплата баллами Малина"     p-type = 'L':U      p-format = "+/-"     p-label = "Оплата баллами Малина"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
      853               when 'max_proc_sum':U then do:     assign     p-label = "Максимальный % порог от суммы"     p-type = 'D':U      p-format = ">>9.99"     p-label = "Максимальный % порог от суммы"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
      854               when 'mask_card_kup':U then do:     assign     p-label = "Маска карты\купона"     p-type = 'C':U      p-format = "x(129)"     p-label = "Маска карты\купона"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
      855         otherwise do:
      856           undo, return error substitute("неизвестный атрибут типа кассового платежа &1", p-code ).
      857         end.
      858       end.
      859     end.
      860   end procedure.
      861   procedure cp-attr-tooltip :
      862     do
      863     on error undo, return error
      864     :
      865       define input  parameter p-code    as character no-undo .
      866       define output parameter p-tooltip as character no-undo .
      867       define output parameter p-label   as character no-undo .
      868       case p-code :
      869               when 'paycard-export-prefix':U then do:     assign     p-tooltip = "Префиксы платежных карт (для выгрузки в XML)"     p-label = "Префиксы платежных карт (для выгрузки в XML)" .   end.
      870               when 'grp-code':U then do:     assign     p-tooltip = "Группа платежа"     p-label = "Группа платежа" .   end.
      871               when 'is-use':U then do:     assign     p-tooltip = "Используется"     p-label = "Используется" .   end.
      872               when 'dop-doc':U then do:     assign     p-tooltip = "Дополнительный документ"     p-label = "Дополнительный документ" .   end.
      873               when 'paycard-all-prefix':U then do:     assign     p-tooltip = "Префиксы платежных карт (для разбора чеков и т.д.)"     p-label = "Префиксы платежных карт (для разбора чеков и т.д.)" .   end.
      874               when 'paycard-edit-prefix':U then do:     assign     p-tooltip = "Префиксы платежных карт, разрешенных для редактировани"     p-label = "Префиксы платежных карт, разрешенных для редактирования" .   end.
      875               when 'form_km3':U then do:     assign     p-tooltip = "Формировать КМ-3 по чекам возврата"     p-label = "Формировать КМ-3 по чекам возврата" .   end.
      876               when 'bal_malina':U then do:     assign     p-tooltip = "Оплата баллами Малина"     p-label = "Оплата баллами Малина" .   end.
      877               when 'max_proc_sum':U then do:     assign     p-tooltip = "Максимальный % порог от суммы"     p-label = "Максимальный % порог от суммы" .   end.
      878               when 'mask_card_kup':U then do:     assign     p-tooltip = "Маска карты\купона"     p-label = "Маска карты\купона" .   end.
      879         otherwise do:
      880           undo, return error substitute("неизвестный атрибут типа кассового платежа &1", p-code) .
      881         end.
      882       end.
      883     end.
      884   end procedure.
      885   procedure cp-attr-value :
      886     do
      887     on error undo, return error
      888     :
      889       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
      890       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
      891       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
      892       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
      893       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
      894       define input  parameter p-code        like ub.cash-pay-attr.attr-code      no-undo .
      895       define output parameter p-value       like ub.cash-pay-attr.attr-value    no-undo .
      896       define output parameter p-type        as character no-undo .
      897       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
      898       define variable v-format         as character no-undo .
      899       define variable v-label          as character no-undo .
      900       define variable v-range          as integer   no-undo .
      901       define variable v-user-can-edit  as logical   no-undo .
      902       define variable v-output-display as logical   no-undo .
      903       define variable v-other          as character no-undo .
      904       run cp-attr-code in this-procedure
      905         (input  p-code
      906         ,output p-type
      907         ,output v-format
      908         ,output v-label
      909         ,output v-range
      910         ,output v-user-can-edit
      911         ,output v-output-display
      912         ,output v-other
      913         ) no-error .
      914       if error-status :error then do:
      915         undo, return error return-value .
      916       end.
      917       find first buf_cash-pay-attr no-lock
      918         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
      919           and buf_cash-pay-attr.curr-code  = p-curr-code
      920           and buf_cash-pay-attr.host-code  = p-host-code
      921           and buf_cash-pay-attr.obj-type   = p-obj-type
      922           and buf_cash-pay-attr.obj-code   = p-obj-code
      923           and buf_cash-pay-attr.attr-code  = p-code
      924         no-error .
      925       if avail buf_cash-pay-attr then do:
      926         assign
      927           p-value =  buf_cash-pay-attr.attr-value
      928         .
      929       end.
      930       else do:
      931         assign
      932           p-value = if p-type = 'L':U then "no":U else ""
      933         .
      934       end.
      935     end.
      936   end procedure.
      937   procedure cp-attr-write :
      938     do
      939     on error undo, return error
      940     :
      941       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
      942       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
      943       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
      944       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
      945       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
      946       define input parameter p-code     like ub.cash-pay-attr.attr-code  no-undo .
      947       define input parameter p-value    like ub.cash-pay-attr.attr-value no-undo .
      948       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
      949       define buffer last_cash-pay-attr for ub.cash-pay-attr .
      950       define variable v-type           as character no-undo .
      951       define variable v-format         as character no-undo .
      952       define variable v-label          as character no-undo .
      953       define variable v-range          as integer   no-undo .
      954       define variable v-user-can-edit  as logical   no-undo .
      955       define variable v-output-display as logical   no-undo .
      956       define variable v-other          as character no-undo .
      957       run cp-attr-code in this-procedure
      958         (input  p-code
      959         ,output v-type
      960         ,output v-format
      961         ,output v-label
      962         ,output v-range
      963         ,output v-user-can-edit
      964         ,output v-output-display
      965         ,output v-other
      966         ) no-error .
      967       if error-status :error then do:
      968         undo, return error return-value .
      969       end.
      970       find first buf_cash-pay-attr exclusive-lock
      971         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
      972           and buf_cash-pay-attr.curr-code  = p-curr-code
      973           and buf_cash-pay-attr.host-code  = p-host-code
      974           and buf_cash-pay-attr.obj-type   = p-obj-type
      975           and buf_cash-pay-attr.obj-code   = p-obj-code
      976           and buf_cash-pay-attr.attr-code = p-code
      977         no-error .
      978       if not available buf_cash-pay-attr then do:
      979         create buf_cash-pay-attr .
      980         assign
      981         buf_cash-pay-attr.cdpay-code = p-cdpay-code
      982         buf_cash-pay-attr.curr-code  = p-curr-code
      983         buf_cash-pay-attr.host-code  = p-host-code
      984         buf_cash-pay-attr.obj-type   = p-obj-type
      985         buf_cash-pay-attr.obj-code   = p-obj-code
      986         buf_cash-pay-attr.attr-code = p-code
      987         .
      988       end.
      989       assign
      990         buf_cash-pay-attr.attr-value = p-value
      991       .
      992       release buf_cash-pay-attr no-error .
      993       if error-status:error then do:
      994         undo, return error return-value .
      995       end.
      996     end.
      997   end procedure.
      998   procedure cp-attr-exist :
