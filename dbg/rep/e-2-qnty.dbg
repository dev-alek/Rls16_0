     1011        SIZE 27.63 BY .75 NO-UNDO.
     1012   DEFINE VARIABLE ot AS LOGICAL INITIAL no
     1013        LABEL "переоценка":L27
     1014        VIEW-AS TOGGLE-BOX
     1015        SIZE 27.63 BY .75 NO-UNDO.
     1016   DEFINE VARIABLE re AS LOGICAL INITIAL yes
     1017        LABEL "возврат внешний":L
     1018        VIEW-AS TOGGLE-BOX
     1019        SIZE 27.63 BY .75 NO-UNDO.
     1020   DEFINE VARIABLE rs AS LOGICAL INITIAL yes
     1021        LABEL "касса возврат":L
     1022        VIEW-AS TOGGLE-BOX
     1023        SIZE 27.63 BY .75 NO-UNDO.
     1024   DEFINE VARIABLE rv AS LOGICAL INITIAL yes
