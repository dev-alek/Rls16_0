     1029        LABEL "Нулевые обороты"
     1030        VIEW-AS TOGGLE-BOX
     1031        SIZE 28.88 BY .83 NO-UNDO.
     1032   DEFINE VARIABLE vt AS LOGICAL INITIAL yes
     1033        LABEL "инвентаризация":L
     1034        VIEW-AS TOGGLE-BOX
     1035        SIZE 27.63 BY .75 NO-UNDO.
