     1659   run cur-time in this-procedure ( output v-today
     1660                                  , output v-time
     1661                                  ).
     1662     if x-SelectGood = 1 Then DO:
     1663               run rep/r-2-prt1.p
     1664                      (input v-cntxt-obj-code ,  input v-cntxt-obj-type ,  input base-type ,  input base-code ,  input Classify,  input Itog,   input tog-zero,  input ost-1,    input ost-2   ).
     1665     End.
     1666     Else DO:
     1667               run rep/r-2-prt3.p
     1668                      (input v-cntxt-obj-code ,  input v-cntxt-obj-type ,  input base-type ,  input base-code ,  input Classify,  input Itog,   input tog-zero,  input ost-1,    input ost-2   ).
     1669     End.
     1670   END PROCEDURE.
     1671   PROCEDURE my-var :
     1672   assign frame F-Main
     1673    ie
     1674    ee
     1675    ep
     1676    es
     1677    re
     1678    rs
     1679    we
     1680    vt
     1681    iv
     1682    ev
     1683    rv
     1684    em
     1685    wm
     1686    im
     1687    ot
     1688    Classify itog tog-zero
     1689    ost-1 ost-2
     1690    .
     1691   define variable t-class as char no-undo.
     1692     CASE Classify:
     1693       WHEN 1    THEN t-class =   "Без классификации" .
     1694       WHEN 2    THEN t-class =   "Производители"   .
     1695       WHEN 3    THEN t-class =   "Группы товаров"  .
     1696    End case.
     1697   ReportHeader = "Классификация : " + t-Class.
     1698   ReportHeader = (ReportHeader) + "Оборот (выборочно) по типам документов : "  + chr(10).
     1699   ReportHeader = (ReportHeader) + IF  ie THen      String(ie:label) + ","  else "" .
     1700   ReportHeader = (ReportHeader) + IF  ee then      String(ee:label) + ","  else "".
     1701   ReportHeader = (ReportHeader) + IF  ep then      String(ep:label) + ","  else "".
     1702   ReportHeader = (ReportHeader) + IF  es THen      String(es:label) + ","  else "".
     1703   ReportHeader = (ReportHeader) + IF  re then      String(re:label) + ","  else "".
     1704   ReportHeader = (ReportHeader) + IF  rs then      String(rs:label) + ","  else "".
     1705   ReportHeader = (ReportHeader) + IF  we THen      String(we:label) + ","  else "".
     1706   ReportHeader = (ReportHeader) + IF  vt then      String(vt:label) + ","  else "".
     1707   ReportHeader = (ReportHeader) + IF  iv then      String(iv:label) + ","  else "".
     1708   ReportHeader = (ReportHeader) + IF  ev THen      String(ev:label) + ","  else "".
     1709   ReportHeader = (ReportHeader) + chr(10).
     1710   ReportHeader = (ReportHeader) + IF  rv then      String(rv:label) + ","  else "".
     1711   ReportHeader = (ReportHeader) + IF  em then      String(em:label) + ","  else "" .
     1712   ReportHeader = (ReportHeader) + IF  wm THen      wm:label + ","  else "" .
     1713   ReportHeader = (ReportHeader) + IF  im then      im:label + ","  else "".
     1714   ReportHeader = (ReportHeader) + IF  ot then      ot:label        else "" .
     1715   ReportHeader = (ReportHeader)  + chr(10)  + IF  ost-1 then      ost-1:label        else "" .
     1716   ReportHeader = (ReportHeader)  + IF  ost-2 then      ost-2:label        else "" .
     1717   if tog-zero then ReportHeader = (ReportHeader)+  chr(10) + 'с нулевыми оборотами '.
     1718   if itog then ReportHeader = (ReportHeader)+  chr(10) + 'только итоги'.
     1719    ReportHeader = (ReportHeader) +  chr(10) + '*** ТОЛЬКО товары со шкалами и со вложенностью до 2го уровня *** '.
     1720   Sheetf.Excel-Column-Lable =
     1721        "N п\п,Артикул,Код,Название товара,".
     1722   Sheetf.Sizes = "6,10,16,25,".
     1723    make-correct = Fill("true,", 4).
     1724   END PROCEDURE.
     1725   PROCEDURE state-changed :
     1726     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     1727     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     1728     if  x-date-end <> today then do:
     1729       tog-zero = false .
     1730       disable  tog-zero with frame F-Main.
     1731     end.
     1732     CASE p-state:
     1733     END CASE.
     1734   END PROCEDURE.
