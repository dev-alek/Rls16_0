        1   block-level on error undo, throw.
        2   define input  parameter Prt_Root   like doc-line.prt-root.
        3   define input  parameter NodeCode   like gds-prt.node-code.
        4   define input  parameter level      as   integer.
        5   define input  parameter NodeName   like gds-prt.node-name.
        6   define input  parameter GdsName    like goods.gds-name.
        7   define input  parameter GdsArtic   like goods.artic.
        8   define output parameter Last_Level as   logical.
        9   def var vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       10   def var vss-author      as character no-undo init "$Author: expertek $":U .
       11   def var vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       12   def var vss-workfile    as character no-undo init "$Workfile: tl_tree.p $":U .
       13   def var vss-archive     as character no-undo init "$Archive: rep/tl_tree.p $":U .
       14   def var vss-description as character no-undo init "Строит дерево признаков для r-protcl.p".
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   define variable vss-include-info0 as character format "X(65)" no-undo
       74   initial "@(#)$Workfile$ $Revision$".
       75   def    shared    work-table  tl-tree     no-undo
       76       field   upper-code              like    gds-prt.upper-code
       77       field   node-code               like    gds-prt.node-code
       78       field   node-name              like    gds-prt.node-name
       79       field   uppernode-name     like    gds-prt.node-name
       80       field   price-base               like    gds-dtl.price-base
       81       field   price-rubl                 like    gds-dtl.price-rubl
       82       field   discnt-base              like    gds-dtl.discnt-base
       83       field   discnt-rubl               like    gds-dtl.discnt-rubl
       84       field   b-code                     as       char
       85       field   gds-amount             as      integer
       86       field   level-number           as      integer
       87       field   prt-num                   like    gds-prt.prt-num
       88       field   gds-name                like    goods.gds-name
       89       field   gds-artic                  like    goods.artic
       90       field   LastLevel                as      logical     init    no
       91       .
       92   def     var                         Last_Level_Work   as      logical.
       93   def     var                         Item_Count             as      integer.
       94   def     var                         rec_id                     as     RECID    NO-UNDO.
       95   Item_Count = 0.
       96   FOR EACH gds-prt WHERE gds-prt.upper-code = NodeCode NO-LOCK:
       97       Item_Count = Item_Count + 1.
       98       FIND LAST tl-tree NO-ERROR.
       99       create  tl-tree.
      100       assign
      101           tl-tree.upper-code = gds-prt.upper-code
      102           tl-tree.node-code = gds-prt.node-code
      103           tl-tree.node-name = gds-prt.node-name
      104           tl-tree.prt-num = gds-prt.prt-num
      105           tl-tree.uppernode-name = NodeName
      106           tl-tree.gds-amount = 0
      107           tl-tree.level-number = level
      108           tl-tree.gds-name = GdsName
      109           tl-tree.gds-artic = GdsArtic.
      110       rec_id = recid(tl-tree).
      111       if level < 2 then
      112           run rep/tl_tree.p (INPUT Prt_Root, INPUT gds-prt.node-code, INPUT  (level + 1),
      113                               INPUT gds-prt.node-name, INPUT  GdsName, INPUT  GdsArtic,
      114                               OUTPUT Last_Level_Work).
      115       else
      116           Last_Level_Work = yes.
      117       FIND FIRST tl-tree WHERE recid(tl-tree) = rec_id NO-ERROR.
      118       if available tl-tree then
      119           tl-tree.LastLevel = Last_Level_Work.
      120   END.
      121   if Item_Count = 0 then
      122       Last_Level = yes.
      123   else
      124       Last_Level = no.
