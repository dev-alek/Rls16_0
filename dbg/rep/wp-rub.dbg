        1   block-level on error undo, throw.
        2   DEFINE  INPUT PARAMETER p-InSum  AS DECIMAL   NO-UNDO.
        3   DEFINE OUTPUT PARAMETER p-OutSum AS CHARACTER NO-UNDO.
        4   DEFINE OUTPUT PARAMETER p-abbr   AS CHARACTER NO-UNDO.
        5   DEFINE VARIABLE vss-revision    AS CHARACTER NO-UNDO INITIAL "$Revision: aea5316774be, 0, rls $":U.
        6   DEFINE VARIABLE vss-author      AS CHARACTER NO-UNDO INITIAL "$Author: expertek $":U.
        7   DEFINE VARIABLE vss-date        AS CHARACTER NO-UNDO INITIAL "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U.
        8   DEFINE VARIABLE vss-workfile    AS CHARACTER NO-UNDO INITIAL "$Workfile: wp-rub.p $":U.
        9   DEFINE VARIABLE vss-archive     AS CHARACTER NO-UNDO INITIAL "$Archive: rep/wp-rub.p $":U.
       10   DEFINE VARIABLE vss-description AS CHARACTER NO-UNDO INITIAL "сумма прописью в  р у б л я х":U.
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   FUNCTION RedLine RETURNS CHARACTER ( INPUT i-str AS CHARACTER ) :
       70     DEFINE VARIABLE v-str AS CHARACTER NO-UNDO.
       71     RUN get-red-line IN THIS-PROCEDURE ( INPUT i-str, OUTPUT v-str ) NO-ERROR.
       72     RETURN ( IF ERROR-STATUS :ERROR THEN i-str ELSE v-str ).
       73   END FUNCTION.
       74   PROCEDURE get-red-line :
       75     DEFINE  INPUT PARAMETER p-str AS CHARACTER NO-UNDO.
       76     DEFINE OUTPUT PARAMETER p-res AS CHARACTER NO-UNDO.
       77     DO ON ERROR UNDO, RETURN ERROR :
       78       ASSIGN p-res = CAPS( SUBSTRING( p-str, 1, 1 ) ) + LC( SUBSTRING( p-str, 2 ) ).
       79     END.
       80   END PROCEDURE.
       81   FUNCTION Roubles RETURNS CHARACTER ( INPUT i-sum AS DECIMAL ) :
       82     DEFINE VARIABLE Rouble AS CHARACTER NO-UNDO.
       83     RUN get-roubles IN THIS-PROCEDURE ( INPUT i-sum, OUTPUT Rouble ) NO-ERROR.
       84     RETURN ( IF ERROR-STATUS :ERROR THEN "":U ELSE Rouble ).
       85   END FUNCTION.
       86   PROCEDURE get-roubles :
       87     DEFINE  INPUT PARAMETER p-sum AS DECIMAL   NO-UNDO.
       88     DEFINE OUTPUT PARAMETER p-rub AS CHARACTER NO-UNDO.
       89     DEFINE VARIABLE Word   AS CHARACTER NO-UNDO.
       90     DEFINE VARIABLE jj     AS INTEGER   NO-UNDO.
       91     DEFINE VARIABLE j_last AS INTEGER   NO-UNDO.
       92     DEFINE VARIABLE l_prev AS LOGICAL   NO-UNDO.
       93     DO ON ERROR UNDO, RETURN ERROR :
       94       ASSIGN Word   = STRING( ABS( p-sum ), "999999999999999999999999999999.99":U )
       95              jj     = LENGTH( Word )
       96              j_last = INTEGER( SUBSTRING( Word, jj - 3, 1 ) )
       97              l_prev =        ( SUBSTRING( Word, jj - 4, 1 ) = "1" ).
       98       IF      j_last = 1                THEN DO: ASSIGN p-rub = ( IF l_prev = YES THEN "рублей" ELSE "рубль" ).  END.
       99       ELSE IF j_last > 1 AND j_last < 5 THEN DO: ASSIGN p-rub = ( IF l_prev = YES THEN "рублей" ELSE "рубля" ). END.
      100                                         ELSE DO: ASSIGN p-rub = "рублей". END.
      101     END.
      102   END PROCEDURE.
      103   FUNCTION Copecks RETURNS CHARACTER ( INPUT i-sum AS DECIMAL ) :
      104     DEFINE VARIABLE Copeck AS CHARACTER NO-UNDO.
      105     RUN get-copecks IN THIS-PROCEDURE ( INPUT i-sum, OUTPUT Copeck ) NO-ERROR.
      106     RETURN ( IF ERROR-STATUS :ERROR THEN "":U ELSE Copeck ).
      107   END FUNCTION.
      108   PROCEDURE get-copecks :
      109     DEFINE  INPUT PARAMETER p-sum AS DECIMAL   NO-UNDO.
      110     DEFINE OUTPUT PARAMETER p-kop AS CHARACTER NO-UNDO.
      111     DEFINE VARIABLE Word   AS CHARACTER NO-UNDO.
      112     DEFINE VARIABLE jj     AS INTEGER   NO-UNDO.
      113     DEFINE VARIABLE j_last AS INTEGER   NO-UNDO.
      114     DEFINE VARIABLE l_prev AS LOGICAL   NO-UNDO.
      115     DO ON ERROR UNDO, RETURN ERROR :
      116       ASSIGN  Word   = STRING( ABS( p-sum ), "999999999999999999999999999999.99":U )
      117               jj     = LENGTH( Word )
      118               j_last = INTEGER( SUBSTRING( Word, jj,     1 ) )
      119               l_prev =        ( SUBSTRING( Word, jj - 1, 1 ) = "1" ).
      120       IF           j_last = 1                THEN DO:
      121         ASSIGN p-kop = ( IF l_prev = YES THEN "копеек" ELSE "копейка" ).
      122       END. ELSE IF j_last > 1 AND j_last < 5 THEN DO:
      123         ASSIGN p-kop = ( IF l_prev = YES THEN "копеек" ELSE "копейки" ).
      124       END.                                   ELSE DO:
      125         ASSIGN p-kop = "копеек".
      126       END.
      127     END.
      128   END PROCEDURE.
      129   FUNCTION get-decade-word RETURNS CHARACTER ( INPUT i-dec AS INTEGER, INPUT i-num AS INTEGER ) :
      130     DEFINE VARIABLE v-grade AS CHARACTER NO-UNDO.
      131     RUN get-number-grade IN THIS-PROCEDURE ( INPUT i-dec, INPUT i-num, OUTPUT v-grade ) NO-ERROR.
      132     RETURN ( IF ERROR-STATUS :ERROR THEN "":U ELSE v-grade ).
      133   END FUNCTION.
      134   FUNCTION Word-Sum RETURNS CHARACTER ( INPUT i-sum AS DECIMAL ) :
      135     DEFINE VARIABLE OutSum AS CHARACTER NO-UNDO.
      136     RUN conv-sum-to-word IN THIS-PROCEDURE ( INPUT i-sum, OUTPUT OutSum ) NO-ERROR.
      137     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE OutSum ).
      138   END FUNCTION.
      139   PROCEDURE get-number-grade :
      140     DEFINE  INPUT PARAMETER p-dec AS INTEGER   NO-UNDO.
      141     DEFINE  INPUT PARAMETER p-num AS INTEGER   NO-UNDO.
      142     DEFINE OUTPUT PARAMETER p-res AS CHARACTER NO-UNDO.
      143     DEFINE VARIABLE v-list AS CHARACTER NO-UNDO.
      144     DO ON ERROR UNDO, RETURN ERROR :
      145       IF      p-dec = 1 THEN DO: ASSIGN v-list = ",один,два,три,четыре,пять,шесть,семь,восемь,девять".    END.
      146       ELSE IF p-dec = 2 THEN DO: ASSIGN v-list = "десять,одиннадцать,двенадцать,тринадцать,четырнадцать,пятнадцать,шестнадцать,семнадцать,восемнадцать,девятнадцать".    END.
      147       ELSE IF p-dec = 3 THEN DO: ASSIGN v-list = ",,двадцать,тридцать,сорок,пятьдесят,шестьдесят,семьдесят,восемьдесят,девяносто".   END.
      148       ELSE IF p-dec = 4 THEN DO: ASSIGN v-list = ",сто,двести,триста,четыреста,пятьсот,шестьсот,семьсот,восемьсот,девятьсот".  END.
      149                         ELSE DO: ASSIGN v-list = ",,,,,,,,,". END.
      150       ASSIGN p-res = ENTRY( p-num + 1, v-list ).
      151     END.
      152   END PROCEDURE.
      153   PROCEDURE conv-sum-to-word :
      154     DEFINE  INPUT PARAMETER p-sum AS DECIMAL   NO-UNDO.
      155     DEFINE OUTPUT PARAMETER p-res AS CHARACTER NO-UNDO.
      156     DEFINE VARIABLE Formatted  AS CHARACTER NO-UNDO.
      157     DEFINE VARIABLE Word       AS CHARACTER NO-UNDO.
      158     DEFINE VARIABLE OutSum     AS CHARACTER NO-UNDO.
      159     DEFINE VARIABLE jj         AS INTEGER   NO-UNDO.
      160     DO ON ERROR UNDO, RETURN ERROR :
      161       ASSIGN Formatted = STRING( ABS( p-sum ), "999999999999999.99":U ) NO-ERROR.
      162       IF ERROR-STATUS :ERROR THEN DO:
      163         ASSIGN p-res = ?.
      164         UNDO, RETURN ERROR.
      165       END.
      166       DO jj = ( LENGTH( Formatted ) - 3 ) TO 3 BY -3 :
      167         IF SUBSTRING( Formatted, jj - 2, 3 ) = "000" THEN DO: NEXT. END.
      168         IF jj < 15 THEN DO:
      169           ASSIGN Word = ENTRY( jj, ",,триллион,,,миллиард,,,миллион,,,тысяч" ).
      170           IF SUBSTRING( Formatted, jj,     1 )  = "1" AND
      171              SUBSTRING( Formatted, jj - 1, 1 ) <> "1" AND jj = 12 THEN DO: ASSIGN Word = TRIM( Word ) + "а". END.
      172           IF SUBSTRING( Formatted, jj, 1 ) = "2" OR
      173              SUBSTRING( Formatted, jj, 1 ) = "3" OR
      174              SUBSTRING( Formatted, jj, 1 ) = "4" THEN DO:
      175             IF jj = 12 THEN DO:
      176               IF SUBSTRING( Formatted, jj - 1, 1 ) <> "1" THEN DO: ASSIGN Word = TRIM( Word ) + "и". END.
      177             END.       ELSE DO:
      178               IF SUBSTRING( Formatted, jj - 1, 1 ) <> "1" THEN DO: ASSIGN Word = TRIM( Word ) + "а". END.
      179             END.
      180           END.
      181           IF ( SUBSTRING( Formatted, jj,     1 ) <> "1" AND
      182                SUBSTRING( Formatted, jj,     1 ) <> "2" AND
      183                SUBSTRING( Formatted, jj,     1 ) <> "3" AND
      184                SUBSTRING( Formatted, jj,     1 ) <> "4" AND jj <> 12 ) OR
      185              ( SUBSTRING( Formatted, jj - 1, 1 )  = "1" AND jj <  12 ) THEN DO: ASSIGN Word = TRIM( Word ) + "ов". END.
      186           IF Word <> "":U THEN DO: ASSIGN OutSum = TRIM( Word ) + " ":U + TRIM( OutSum ). END.
      187         END.
      188         IF SUBSTRING( Formatted, jj - 1, 1 ) <> "1" THEN DO:
      189           IF      jj = 12 AND SUBSTRING( Formatted, jj, 1 ) = "1" THEN DO: ASSIGN Word = "одна". END.
      190           ELSE IF jj = 12 AND SUBSTRING( Formatted, jj, 1 ) = "2" THEN DO: ASSIGN Word = "две".  END.
      191           ELSE DO: ASSIGN Word = get-decade-word( 1, INTEGER( SUBSTRING( Formatted, jj, 1 ) ) ). END.
      192           IF Word <> "":U THEN DO: ASSIGN OutSum = TRIM( Word ) + " ":U + TRIM( OutSum ). END.
      193           ASSIGN Word = get-decade-word( 3, INTEGER( SUBSTRING( Formatted, jj - 1, 1 ) ) ).
      194         END.                                        ELSE DO:
      195           ASSIGN Word = get-decade-word( 2, INTEGER( SUBSTRING( Formatted, jj,     1 ) ) ).
      196         END.
      197         IF Word <> "":U THEN DO: ASSIGN OutSum = TRIM( Word ) + " ":U + TRIM( OutSum ). END.
      198         ASSIGN Word = get-decade-word( 4, INTEGER( SUBSTRING( Formatted, jj - 2, 1 ) ) ).
      199         IF Word <> "":U THEN DO: ASSIGN OutSum = TRIM( Word ) + " ":U + TRIM( OutSum ). END.
      200       END.
      201       ASSIGN OutSum = CAPS( SUBSTRING( OutSum, 1, 1 ) ) + SUBSTRING( OutSum, 2 ).
      202       IF OutSum = "":U AND TRUNCATE( p-sum, 0 ) = 0 THEN DO: ASSIGN OutSum = "Ноль". END.
      203       ASSIGN p-res = TRIM( OutSum ).
      204     END.
      205   END PROCEDURE.
      206   FUNCTION Total-Word RETURNS CHARACTER ( INPUT i-sum AS DECIMAL, INPUT i-curr AS CHARACTER, INPUT i-part AS CHARACTER ) :
      207     DEFINE VARIABLE word_sum AS CHARACTER NO-UNDO.
      208     RUN get-total-word IN THIS-PROCEDURE ( INPUT i-sum, INPUT i-curr, INPUT i-part, OUTPUT word_sum ) NO-ERROR.
      209     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE word_sum ).
      210   END FUNCTION.
      211   PROCEDURE get-total-word :
      212     DEFINE  INPUT PARAMETER p-sum  AS DECIMAL   NO-UNDO.
      213     DEFINE  INPUT PARAMETER p-curr AS CHARACTER NO-UNDO.
      214     DEFINE  INPUT PARAMETER p-part AS CHARACTER NO-UNDO.
      215     DEFINE OUTPUT PARAMETER p-word AS CHARACTER NO-UNDO.
      216     DO ON ERROR UNDO, RETURN ERROR :
      217       ASSIGN p-word = Word-Sum( p-sum ).
      218                  ASSIGN p-word = ( IF p-sum < 0 THEN "- " ELSE "":U ) + TRIM(
      219                         RedLine( p-word )
      220                  ) +
      221                         " ":U + p-curr + " ":U +
      222                         SUBSTRING( STRING( ABS( p-sum ), "999999999999999999999999999999.99" ), 32, 2 ) +
      223                         " ":U + p-part + ".".
      224                           END.
      225   END PROCEDURE.
      226   ASSIGN p-OutSum = Total-Word( p-InSum, Roubles( p-InSum ), Copecks( p-InSum ) )
      227          p-abbr   = " руб.".
