     1010   initial "@(#)$Workfile$ $Revision$".
     1011   procedure grplib-get-full-name :
     1012      define input parameter p-node-code  as integer      no-undo.
     1013      define output parameter p-full-name as character    no-undo.
     1014      do
     1015   on error undo, return error
     1016   :
     1017       define variable v-upper-code    as integer           no-undo.
     1018       define buffer buf_gds-grp       for ub.gds-grp.
     1019       define buffer buf_upper_gds-grp for ub.gds-grp.
     1020       find first buf_gds-grp no-lock
     1021            where buf_gds-grp.node-code = p-node-code
     1022       no-error.
     1023       if not available buf_gds-grp
     1024       then do:
     1025           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     1026       end.
     1027       assign
     1028           p-full-name  = ""
     1029           v-upper-code = 1
     1030       .
     1031       do while buf_gds-grp.upper-code <> 0
     1032       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     1033       :
     1034           assign
     1035               p-full-name  = buf_gds-grp.node-name
     1036                            + (if p-full-name <> "" then chr(47) else "")
     1037                            + p-full-name
     1038               v-upper-code = buf_gds-grp.upper-code
     1039           .
     1040           find first buf_gds-grp no-lock
     1041                where buf_gds-grp.node-code = v-upper-code
     1042           no-error.
     1043           if not available buf_gds-grp
     1044           then do:
     1045               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
     1046                                   + string( v-upper-code )
     1047                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     1048           end.
     1049       end.
     1050       assign
     1051       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     1052       .
     1053   end.
     1054   end .
     1055   procedure grplib-get-node-from-full-name :
     1056   define input parameter p-full-name as character no-undo .
     1057   define output parameter p-node-code as integer no-undo .
     1058   define variable v-ii as integer no-undo .
     1059   define variable v-upper-code as integer no-undo .
     1060   define variable v-root-code as integer no-undo .
     1061   define variable v-entry as character no-undo .
     1062   define buffer buf_gds-grp       for ub.gds-grp.
     1063   do
     1064   on error undo, return error
     1065   :
     1066     find first buf_gds-grp no-lock
     1067         where buf_gds-grp.upper-code = 0
     1068     no-error .
     1069     if not available buf_gds-grp
     1070     then do:
     1071         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
     1072     end.
     1073     else do:
     1074       assign
     1075       v-root-code = buf_gds-grp.node-code
     1076       .
     1077     end.
     1078     v-upper-code = v-root-code.
     1079     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     1080       assign
     1081       v-entry = entry(v-ii, p-full-name, chr(47)).
     1082       if v-entry = '' then leave.
     1083       find first buf_gds-grp no-lock where
     1084                 buf_gds-grp.node-name = v-entry
     1085             and buf_gds-grp.upper-code = v-upper-code
     1086             no-error.
     1087       if not available buf_gds-grp then do:
     1088         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     1089       end.
     1090       else do:
     1091         p-node-code = buf_gds-grp.node-code.
     1092         v-upper-code = buf_gds-grp.node-code.
     1093       end.
     1094     end.
     1095   end.
     1096   end .
