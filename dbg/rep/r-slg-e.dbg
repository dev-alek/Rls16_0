     2333     run macr_cell_format( 11, yes, no, ?, 1, 3, 1, 3) .
     2334     for each obj-list no-lock:
     2335       run macr_excel_char ( string("Выбор объекта: " + obj-list.obj-name + " (" + obj-list.obj-type + '#' + string(obj-list.obj-code)  + "), ") , v-row, v-col) .
     2336       assign v-col = v-col + 1 .
     2337     end.
     2338     assign
     2339       v-col = 1
     2340       v-row = v-row + 1
     2341     .
     2342     case x-SelectGood :
     2343       when 1       then run macr_excel_char ("Выбор товара: по всем товарам" , v-row, v-col) .
     2344       when 2       then run macr_excel_char ("Выбор товара: по группам" , v-row, v-col) .
     2345       when 3      then run macr_excel_char ("Выбор товара: по производителям" , v-row, v-col) .
     2346       when 4    then run macr_excel_char ("Выбор товара: выборочно" , v-row, v-col) .
     2347       when 5       then run macr_excel_char ("Выбор товара: выборочно" , v-row, v-col) .
     2348       when 6      then run macr_excel_char ("Выбор товара: хранимый список" , v-row, v-col) .
     2349       when 7  then run macr_excel_char ("Выбор товара: по группам и по производителям" , v-row, v-col) .
     2350     end case .
     2351     assign  v-row = v-row + 1 .
     2352     run macr_excel_char("Артикул", v-row, v-col) .
     2353     run macr_cell_size (12,?, v-row, v-col,?,?).       assign v-col = v-col + 1 .
     2354     run macr_excel_char("Производитель", v-row, v-col) .
     2355     run macr_cell_size (15,?, v-row, v-col,?,?).       assign v-col = v-col + 1 .
     2356     run macr_excel_char("Наименование товара", v-row, v-col) .
     2357     run macr_cell_size (40,?, v-row, v-col,?,?).      assign v-col = v-col + 1 .
     2358     run macr_excel_char("Дни без товара.", v-row, v-col) .
     2359     run macr_cell_size (14,?, v-row, v-col,?,?).      assign v-col = v-col + 1 .
     2360     run macr_excel_char("Послед. поставка", v-row, v-col) .
     2361     run macr_cell_size (14,?, v-row, v-col,?,?).      assign v-col = v-col + 1 .
     2362     run macr_cell_bordur ( v-row , 1, v-row, 5) .
     2363     run macr_cell_format ( 10, yes, no, 35, v-row , 1, v-row, 5) .
     2364     assign
     2365       v-row = v-row + 1
     2366       v-col = 1
     2367     .
     2368     end.
     2369   end procedure.
