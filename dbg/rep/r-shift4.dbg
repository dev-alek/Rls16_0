       99   def
      100    shared
      101   temp-table  obj-list no-undo
      102     field obj-type like ub.clients.obj-type
      103     field obj-code like ub.clients.obj-code
      104     field obj-name like ub.clients.obj-name
      105     field obj-id   as integer
      106     field db-num   as integer
      107     index pi is primary unique obj-id
      108     index ie1 obj-type obj-code
      109     index ie2 obj-name
      110   .
      111   procedure create_obj-list :
      112      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      113      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      114      do
      115      on error undo, return error return-value
      116      :
      117         define buffer cli-obj for ub.clients .
      118         define variable p-var as integer no-undo .
      119         define buffer buf_obj-list for obj-list .
      120         find last buf_obj-list  use-index pi no-error .
      121         if available buf_obj-list
      122         then
      123            p-var = buf_obj-list.obj-id + 1.
      124         else
      125            p-var = 1.
      126         find first cli-obj where
      127                   cli-obj.obj-type = p-obj-type
      128               and cli-obj.obj-code = p-obj-code
      129         no-lock no-error.
      130         if available cli-obj
      131         then do:
      132            create buf_obj-list.
      133            assign
      134               buf_obj-list.obj-id   = p-var
      135               buf_obj-list.obj-code = cli-obj.obj-code
      136               buf_obj-list.obj-type = cli-obj.obj-type
      137               buf_obj-list.obj-name = cli-obj.obj-name
      138               buf_obj-list.db-num   = cli-obj.db-num
      139            .
      140         end.
      141      end.
      142   end.
