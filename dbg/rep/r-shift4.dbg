      703   .
      704   define shared stream  PrnLibstream.
      705   define variable pol1 as character no-undo .
      706   define variable pol2 as integer no-undo .
      707   define variable pol3 as decimal no-undo .
      708   define variable pol4 as character no-undo .
      709   define variable pol5 as decimal no-undo .
      710   define variable pol6 as decimal no-undo .
      711   define variable line as character no-undo .
      712   DEFINE VARIABLE  areal-is-pay-qnty1 as decimal no-undo.
      713   DEFINE VARIABLE  areal-is-pay-netto as decimal no-undo.
      714   DEFINE VARIABLE  areal-no-pay-qnty1 as decimal no-undo.
      715   DEFINE VARIABLE  areal-no-pay-netto as decimal no-undo.
      716   DEFINE VARIABLE  areal-qnty1 as decimal no-undo.
      717   DEFINE VARIABLE  areal-netto as decimal no-undo.
      718   DEFINE VARIABLE  a-qnty1 as decimal no-undo.
      719   DEFINE VARIABLE  a-netto as decimal no-undo.
      720   DEFINE VARIABLE  loc-real-ii as integer no-undo.
      721   DEFINE VARIABLE  curr-real-ii as integer no-undo.
      722   DEFINE VARIABLE  jj as integer no-undo.
      723   DEFINE VARIABLE  loc-jj as integer no-undo.
      724   DEFINE VARIABLE main-line as logical no-undo.
      725   DEFINE VARIABLE mat-line as logical no-undo.
      726   DEFINE VARIABLE pay-line as logical no-undo.
      727   DEFINE VARIABLE a-line as logical no-undo.
      728   DEFINE VARIABLE max-line as integer no-undo.
      729   DEFINE VARIABLE max-real as integer no-undo.
      730   DEFINE VARIABLE rc as recid no-undo.
      731   DEFINE VARIABLE acii as integer no-undo .
      732     procedure on-same-page :
      733       define input parameter p-line-number as integer no-undo .
      734       if p-line-number > page-size( PrnLibstream )
      735       then do:
      736         return .
      737       end.
      738       if line-counter( PrnLibstream ) + p-line-number > page-size( PrnLibstream )
      739       then do:
      740         page stream PrnLibstream .
      741       end.
      742     end procedure.
      743   DEFINE FRAME FRAME-4
      744     pol1  column-label "4.1":C32                                FORMAT "x(32)"       space(0)
      745     sym1 column-label ":" format "x(1)" space(0)
      746     pol2 column-label   "4.2":C9                                FORMAT  ">>>>>>>>9"  space(0)
      747     sym2 column-label ":" format "x(1)" space(0)
      748     pol3 column-label    "4.3":C8                               FORMAT  ">>>>9.99"  space(0)
      749     sym3 column-label ":" format "x(1)" space(0)
      750     pol4 column-label     "4.4":C19                             FORMAT "x(19)"    space(0)
      751     sym4 column-label ":" format "x(1)" space(0)
      752     pol5 column-label "4.5":C8                                  FORMAT "->>>>>>>9"          space(0)
      753     sym5 column-label ":" format "x(1)" space(0)
      754     pol6 column-label     "4.6":C14                             FORMAT "->>>,>>>,>>9.99"  space(0)
      755   with width 232 down stream-io use-text NO-BOX.
      756   run rep/r-shft4r.p
      757                   (input p-obj-type,
      758                    input p-obj-code,
      759                    input X-date-Start,
      760                    input X-Shift-Start,
      761                    input X-date-End,
      762                    input X-Shift-End,
      763   input p-previous-shift-date
      764                    ) no-error.
      765   FORM HEADER
      766   string( p-z-number-list, "x(198)":U ) format "x(198)":U skip "-------------------------------------------------------------------------------------------------"  skip "              »Õ‘Œ–Ã¿÷»ﬂ Œ¡ ”—À”√≈                 :        –¿—ÿ»‘–Œ¬ ¿ –≈¿À»«¿÷»» ”—À”√         "  skip "---------------------------------------------------:---------------------------------------------"  skip "           Õ¿»Ã≈ÕŒ¬¿Õ»≈         :    Œƒ   :÷≈Õ¿    :    “»œ –¿—’Œƒ¿    :   ŒÀ-¬Œ :     —”ÃÃ¿     "  skip "              ÛÒÎÛ„Ë            :  ÛÒÎÛ„Ë :ÓÁÌË˜Ì :   (ÚËÔ ÔÎ‡ÚÂÊ‡)   :         :               "  skip "                                :         :Ì‡ ÍÓÌÂˆ:                   :         :               "  skip "                                :         :ÒÏÂÌ˚   :                   :         :               "  skip "-------------------------------------------------------------------------------------------------"
      767   with FRAME TopFrame width 232 PAGE-Top NO-LABELS NO-BOX .
      768   VIEW STREAM PrnLibstream FRAME TOpFrame .
      769   for each actreal-4:
      770     delete actreal-4.
      771   end.
      772   FOR EACH t-4 use-index pi:
      773     assign
      774     areal-is-pay-qnty1 = 0
      775     areal-is-pay-netto = 0
      776     areal-no-pay-qnty1 = 0
      777     areal-no-pay-netto = 0
      778     areal-qnty1 = 0
      779     areal-netto = 0
      780     loc-real-ii = 1
      781     curr-real-ii = 1
      782     .
      783     FIND LAST treal-4 No-LOCK WHERE
      784               treal-4.gds-code = t-4.gds-code AND
      785               treal-4.is-pay = yes use-index vi No-ERROR.
      786     if avail treal-4 then
      787     assign
      788     loc-real-ii = treal-4.ii + 1
      789     curr-real-ii = treal-4.ii + 1
      790     .
      791     IF can-find(first treal-4 WHERE
      792                       treal-4.gds-code = t-4.gds-code) then do:
      793       FOR EACh  treal-4 where
      794                 treal-4.gds-code = t-4.gds-code use-index pi:
      795         assign
      796         areal-qnty1 = areal-qnty1 + treal-4.qnty1
      797         areal-netto = areal-netto + treal-4.netto
      798         .
      799         if treal-4.is-pay then
      800         assign
      801         areal-is-pay-qnty1 = areal-is-pay-qnty1 + treal-4.qnty1
      802         areal-is-pay-netto = areal-is-pay-netto + treal-4.netto
      803         .
      804        else
      805         assign
      806         rc = recid(treal-4)
      807         curr-real-ii = (if curr-real-ii = loc-real-ii AND
      808                            (loc-real-ii > 1   OR
      809                             can-find(first treal-4 No-LOCK WHERE
      810                                            treal-4.gds-code = t-4.gds-code AND
      811                                            treal-4.is-pay = no AND
      812                                            recid(treal-4) <> rc)
      813                             )
      814                         then (curr-real-ii + 1)
      815                         else curr-real-ii
      816                        )
      817         treal-4.ii = curr-real-ii
      818         curr-real-ii = curr-real-ii + 1
      819         areal-no-pay-qnty1 = areal-no-pay-qnty1 + treal-4.qnty1
      820         areal-no-pay-netto = areal-no-pay-netto + treal-4.netto
      821         .
      822       END.
      823       if curr-real-ii > 2 then do:
      824         run create-treal-4 (
      825                             INPUT t-4.gds-code,
      826                             INPUT 0,
      827                             INPUT 0,
      828                             INPUT areal-is-pay-qnty1,
      829                             INPUT areal-is-pay-netto,
      830                             INPUT "»“Œ√Œ ŒœÀ¿◊.–¿—’Œƒ",
      831                             INPUT yes,
      832                             INPUT loc-real-ii) no-error.
      833         if loc-real-ii = curr-real-ii then
      834         curr-real-ii = curr-real-ii + 1.
      835         run create-treal-4 (
      836                             INPUT t-4.gds-code,
      837                             INPUT 0,
      838                             INPUT 0,
      839                             INPUT areal-no-pay-qnty1,
      840                             INPUT areal-no-pay-netto,
      841                             INPUT "»“Œ√Œ œ–Œ◊.–¿—’ŒƒŒ¬",
      842                             INPUT no,
      843                             INPUT curr-real-ii) no-error.
      844         curr-real-ii = curr-real-ii + 1.
      845         run create-treal-4 (
      846                             INPUT t-4.gds-code,
      847                             INPUT 0,
      848                             INPUT 0,
      849                             INPUT areal-qnty1,
      850                             INPUT areal-netto,
      851                             INPUT "¬—≈√Œ  –¿—’Œƒ",
      852                             INPUT ?,
      853                             INPUT curr-real-ii) no-error.
      854       END.
      855     END.
      856     assign
      857     t-4.lines = MAX(curr-real-ii, 1)
      858     .
      859   END.
      860   if Make-Excel then  put   stream ForExcel unformatted skip.
      861   FOR EACH t-4 No-LOCK,
      862       EACH treal-4 No-LOCK WHERE
      863            treal-4.gds-code = t-4.gds-code
      864      BREAK BY treal-4.gds-code
      865            BY treal-4.is-pay descending
      866            BY treal-4.ii:
      867       assign
      868       pol1 = ""
      869       pol2 = 0
      870       pol3 = 0
      871       pol4 = ""
      872       pol5 = 0
      873       pol6 = 0
      874       main-line = no
      875       pay-line = no
      876       .
      877      IF FIRST-OF(treal-4.gds-code) then do:
      878         assign
      879         pol1 = t-4.gds-name
      880         pol2 = t-4.main-code
      881         pol3 = t-4.last-price
      882         main-line = yes
      883         .
      884         if Make-Excel then  put   stream ForExcel unformatted
      885         pol1 CHR(9)
      886         pol2 CHR(9)
      887         pol3 CHR(9)
      888         .
      889      END.
      890      ELSE
      891       if Make-Excel then  put   stream ForExcel unformatted
      892       CHR(9)
      893       CHR(9)
      894       CHR(9)
      895       .
      896      assign
      897      pol4 = treal-4.out-name
      898      pol5 = treal-4.qnty1
      899      pol6 = treal-4.netto
      900      .
      901      if treal-4.discnt-type = -99 then do:
      902           assign
      903         a-netto = a-netto + treal-4.netto
      904         a-qnty1 = a-qnty1 + treal-4.qnty1
      905           .
      906       end.
      907      if treal-4.cpay-code <> 0 then dO:
      908       FIND FIRST actreal-4 WHERE
      909                     actreal-4.gds-code = 0 AND
      910                     actreal-4.cpay-code = treal-4.cpay-code AND
      911                     actreal-4.curr-code = treal-4.curr-code AND
      912                     actreal-4.is-pay = treal-4.is-pay NO-ERROR.
      913           if not avail actreal-4 then do:
      914             acii = acii + 1.
      915             run create-actreal-4 (
      916                                 INPUT 0,
      917                                 INPUT treal-4.cpay-code,
      918                                 INPUT treal-4.curr-code,
      919                                 INPUT treal-4.qnty1,
      920                                 INPUT treal-4.netto,
      921                                 INPUT treal-4.out-name,
      922                                 INPUT treal-4.is-pay,
      923                                 INPUT acii) no-error.
      924           end.
      925           else
      926           assign
      927           actreal-4.qnty1 = actreal-4.qnty1 + treal-4.qnty1
      928           actreal-4.netto = actreal-4.netto + treal-4.netto
      929           .
      930      end.
      931      DISPLAY stream PrnLibstream
      932      pol1 when main-line
      933      pol2 when main-line
      934      pol3 when main-line
      935      pol4
      936      pol5
      937      pol6
      938      sym1 sym2 sym3 sym4 sym5
      939      WITH FRAME FRAME-4.
      940      DOWN STREAM PrnLibstream
      941      WITH FRAME FRAME-4.
      942      if Make-Excel then  put   stream ForExcel unformatted
      943       pol4 CHR(9)
