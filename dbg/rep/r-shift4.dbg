      639   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      640   PROCEDURE create-treal-4.
      641   DEFINE INPUT PARAMETER pgds-code like ub.goods.gds-code no-undo.
      642   DEFINE INPUT PARAMETER pcpay-code like ub.cash-pay.cdpay-code no-undo.
      643   DEFINE INPUT PARAMETER pcurr-code like ub.cash-pay.curr-code no-undo.
      644   DEFINE INPUT PARAMETER pqnty1 as decimal no-undo.
      645   DEFINE INPUT PARAMETER pnetto as decimal no-undo.
      646   DEFINE INPUT PARAMETER pout-name as character no-undo.
      647   DEFINE INPUT PARAMETER pis-pay as logical no-undo.
      648   DEFINE INPUT PARAMETER pii as integer no-undo.
      649   _main:
      650   DO ON ERROR UNDO _main, return error:
      651       create treal-4.
      652       assign
      653       treal-4.gds-code = pgds-code
      654       treal-4.cpay-code = pcpay-code
      655       treal-4.curr-code = pcurr-code
      656       treal-4.qnty1  =  pqnty1
      657       treal-4.netto = pnetto
      658       treal-4.out-name = pout-name
      659       treal-4.is-pay = pis-pay
      660       treal-4.ii = pii
      661       no-error
      662       .
      663       if error-status:error then undo _main, return error.
      664   END.
      665   END PROCEDURE.
      666   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      667   PROCEDURE create-actreal-4.
      668   DEFINE INPUT PARAMETER pgds-code like ub.goods.gds-code no-undo.
      669   DEFINE INPUT PARAMETER pcpay-code like ub.cash-pay.cdpay-code no-undo.
      670   DEFINE INPUT PARAMETER pcurr-code like ub.cash-pay.curr-code no-undo.
      671   DEFINE INPUT PARAMETER pqnty1 as decimal no-undo.
      672   DEFINE INPUT PARAMETER pnetto as decimal no-undo.
      673   DEFINE INPUT PARAMETER pout-name as character no-undo.
      674   DEFINE INPUT PARAMETER pis-pay as logical no-undo.
      675   DEFINE INPUT PARAMETER pii as integer no-undo.
      676   _main:
      677   DO ON ERROR UNDO _main, return error:
      678       create actreal-4.
      679       assign
      680       actreal-4.gds-code = pgds-code
      681       actreal-4.cpay-code = pcpay-code
      682       actreal-4.curr-code = pcurr-code
      683       actreal-4.qnty1  =  pqnty1
      684       actreal-4.netto = pnetto
      685       actreal-4.out-name = pout-name
      686       actreal-4.is-pay = pis-pay
      687       actreal-4.ii = pii
      688       no-error
      689       .
      690       if error-status:error then undo _main, return error.
      691   END.
      692   END PROCEDURE.
      693   define NEW SHARED temp-table tmat-4 no-undo
      694     field netto-before as decimal   format "-999,999,999.99":U
