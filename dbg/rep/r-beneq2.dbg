      666   define variable v-curr-r-b as character no-undo .
      667   define variable v-host-code as integer no-undo .
      668   define variable acc-day-base as decimal no-undo .
      669   define variable acc-day-rubl as decimal no-undo .
      670   define variable acc-day-cnt as integer no-undo .
      671   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      672   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      673     (output v-curr-r-b
      674     )  .
      675   CASE  X-Radio-Task > 1:
      676     WHEN YES THEN DO:
      677       FOR EACH obj-list WHERE
      678                obj-list.obj-type = 'маг':U:
      679         v-host-code = 0.
      680         assign
      681         acc-day-base = 0
      682         acc-day-rubl = 0
      683         acc-day-cnt = 0
      684         .
      685   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      686   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      687     (input  obj-list.obj-type
      688     ,input  obj-list.obj-code
      689     ,output v-host-code
      690     ) no-error .
      691         for EACH ub.inkas WHERE
      692             ub.inkas.host-code = v-host-code AND
      693             ub.inkas.obj-type = obj-list.obj-type AND
      694             ub.inkas.obj-code = obj-list.obj-code AND
      695             ub.inkas.status_ = 'факт':U AND
      696               (
      697               ub.inkas.shift-date >= x-date-start AND
      698               ub.inkas.shift-date <= x-date-end) NO-LOCK:
      699         if can-find(first ub.inkas-pay-desk  NO-LOCK WHERE
      700                           ub.inkas-pay-desk.inkas-code = ub.inkas.inkas-code) then.
      701         else do:
      702           run trg/inkpdcr.p (
      703                          ub.inkas.inkas-code
      704                         ,ub.inkas.obj-type
      705                         ,ub.inkas.obj-code) no-error .
      706           if error-status:error then do:
      707             return error .
      708           end.
      709         end.
      710         FOR EACH ub.inkas-pay-desk WHERE
      711                ub.inkas-pay-desk.inkas-code = ub.inkas.inkas-code AND
      712         (IF cas-num > 0 then ub.inkas-pay-desk.pay-desk = cas-num else TRUE)
      713                NO-LOCK:
      714           IF X-Radio-Task = 3 AND
      715           ((inkas.shift-date = x-date-start AND ub.inkas.shift-num < X-shift-start) OR
      716           (inkas.shift-date = x-date-end AND  ub.inkas.shift-num > X-shift-end) ) THEN NEXT.
      717           IF X-Radio-Task = 4 AND ub.inkas.shift-num <> x-shift-alone then next.
      718           FIND FIRST inkas-num where inkas-num.inkas-code = inkas.inkas-code No-ERROR.
      719           if not avail inkas-num then do:
      720               create inkas-num.
      721               assign
      722               inkas-num.inkas-code = ub.inkas.inkas-code
      723               acc-day-cnt  = acc-day-cnt + inkas.num-chk
      724               .
      725           end.
      726             assign
      727             acc-day-base = acc-day-base + inkas-pay-desk.tot-base
      728             acc-day-rubl = acc-day-rubl + inkas-pay-desk.tot-rubl
      729             .
      730           ACCUMULATE
      731           ub.inkas-pay-desk.tot-base ( TOTAL )
      732           ub.inkas-pay-desk.tot-rubl ( TOTAL ) .
      733       END .
      734         end.
      735         CREATE all-days_sum .
      736         assign
      737         all-days_sum.obj-type = obj-list.obj-type
      738         all-days_sum.obj-code = obj-list.obj-code
      739         all-days_sum.tot-base = acc-day-base
      740         all-days_sum.tot-rubl = acc-day-rubl
      741         all-days_sum.tot-r-b  = (if v-curr-r-b = 'base':U
      742                                 then all-days_sum.tot-base
      743                                 else all-days_sum.tot-rubl)
      744         .
      745         release all-days_sum.
      746       END .
      747     END.
      748     WHEN NO THEN DO:
      749       FOR EACH obj-list WHERE
      750                obj-list.obj-type = 'маг':U:
      751         assign
      752         acc-day-base = 0
      753         acc-day-rubl = 0
      754         acc-day-cnt = 0
      755         .
      756         FOR EACH ub.inkas WHERE
      757               ub.inkas.obj-type = obj-list.obj-type AND
      758               ub.inkas.obj-code = obj-list.obj-code AND
      759               ub.inkas.status_ = 'факт':U AND
      760               ub.inkas.doc-date >= x-date-start AND
      761               ub.inkas.doc-date <= x-date-end NO-LOCK:
      762         if can-find(first ub.inkas-pay-desk  NO-LOCK WHERE
      763                           ub.inkas-pay-desk.inkas-code = ub.inkas.inkas-code) then.
      764         else do:
      765           run trg/inkpdcr.p (
      766                          ub.inkas.inkas-code
      767                         ,ub.inkas.obj-type
      768                         ,ub.inkas.obj-code) no-error .
      769           if error-status:error then do:
      770             return error .
      771           end.
      772         end.
      773         FOR EACH ub.inkas-pay-desk WHERE
      774                ub.inkas-pay-desk.inkas-code = ub.inkas.inkas-code AND
      775           (IF cas-num > 0 then ub.inkas-pay-desk.pay-desk = cas-num else TRUE)
      776                NO-LOCK:
      777           FIND FIRST inkas-num where inkas-num.inkas-code = ub.inkas.inkas-code No-ERROR.
      778           if not avail inkas-num then do:
      779               create inkas-num.
      780               assign
      781               inkas-num.inkas-code = ub.inkas.inkas-code
      782               acc-day-cnt  = acc-day-cnt + inkas.num-chk
      783               .
      784           end.
      785             assign
      786             acc-day-base = acc-day-base + inkas-pay-desk.tot-base
      787             acc-day-rubl = acc-day-rubl + inkas-pay-desk.tot-rubl
      788             .
      789           ACCUMULATE
      790           ub.inkas-pay-desk.tot-base ( TOTAL )
      791           ub.inkas-pay-desk.tot-rubl ( TOTAL ) .
      792         END.
      793         end.
      794         CREATE all-days_sum .
      795         assign
      796         all-days_sum.obj-type = obj-list.obj-type
      797         all-days_sum.obj-code = obj-list.obj-code
      798         all-days_sum.tot-base = acc-day-base
      799         all-days_sum.tot-rubl = acc-day-rubl
      800         all-days_sum.tot-r-b  = (if v-curr-r-b = 'base':U
      801                                 then all-days_sum.tot-base
      802                                 else all-days_sum.tot-rubl)
      803         .
      804         release all-days_sum.
      805       END .
      806     END.
      807   END CASE.
      808   assign
      809   AllDay-BaseSum = ACCUM TOTAL ub.inkas-pay-desk.tot-base
      810   AllDay-RublSum = ACCUM TOTAL ub.inkas-pay-desk.tot-rubl .
