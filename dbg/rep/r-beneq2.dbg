      574   define shared temp-table benefits no-undo
      575   field obj-type  like    clients.obj-type
      576   field obj-code  like    clients.obj-code
      577   field date_      like    chk-pay.chk-date
      578   field pay-code   like    cash-pay.cdpay-code
      579   field pay-name   like    cash-pay.obj-name
      580   field curr-code  like    currency.curr-code
      581   field curr-name  like    currency.curr-name
      582   field tot-sum    like    chk-pay.tot-sum
      583   field tot-base   like    chk-pay.tot-base
      584   field tot-rubl   like    chk-pay.tot-rubl
      585   field tot-r-b     like    chk-pay.tot-rubl
      586   field pcnt          as      decimal
      587   field pay-desk like chk-doc.pay-desk
      588   INDEX pi IS PRIMARY     obj-type obj-code date_  pay-desk ASCENDING
      589   INDEX pc                         pay-code curr-code
      590   .
      591   define shared temp-table inkas-num no-undo
