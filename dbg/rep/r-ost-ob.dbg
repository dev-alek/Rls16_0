      567   define new global shared variable g#library  as handle no-undo .
      568   define new global shared variable g#library2 as handle no-undo .
      569   define variable var-report-r-b as character no-undo .
      570   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      571   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      572     (output var-report-r-b
      573     )  .
      574   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      575   procedure factord :
      576     define input  parameter p-fact-date            as date    no-undo .
      577     define input  parameter p-fact-time            as integer no-undo .
      578     define input  parameter p-fact-num             as integer no-undo .
      579     define input  parameter p-shift-date           as date    no-undo .
      580     define input  parameter p-shift-num            as integer no-undo .
      581     define input  parameter p-shift-on             as logical no-undo .
      582     define output parameter p-fact-order           as decimal no-undo .
      583     define output parameter p-shift-end-fact-order as decimal no-undo .
      584     define output parameter p-day-end-fact-order   as decimal no-undo .
      585     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      586     if p-fact-date = ?
      587     then do:
      588       return error "Не указана фактическая дата" .
      589     end.
      590     define variable v-fact-date-num as integer no-undo .
      591     assign
      592       v-fact-date-num = integer(p-fact-date)
      593     .
      594     if p-fact-num = ?
      595     or p-fact-num = 0
      596     then do:
      597       return error "Не задан p-fact-num " + string(p-fact-num) .
      598     end.
      599     if p-fact-num < 0
      600     then do:
      601       return error "Отрицательный fact-num " + string(p-fact-num) .
      602     end.
      603     if p-fact-num >= 100000000
      604     then do:
      605       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      606     end.
      607     if p-shift-on = true
      608     then do:
      609       if p-shift-date = ?
      610       then do:
      611         return error "Не задана дата смены" .
      612       end.
      613       if p-shift-num = ?
      614       or p-shift-num = 0
      615       then do:
      616         return error "Не задан номер смены" .
      617       end.
      618     end.
      619     else do:
      620       assign
      621         p-shift-date = p-fact-date
      622         p-shift-num  = 24
      623       .
      624     end.
      625     define variable v-shift-offset as integer no-undo .
      626     if p-shift-date = p-fact-date
      627     then do:
      628       assign
      629         v-shift-offset = 1
      630       .
      631     end.
      632     if p-shift-date < p-fact-date
      633     then do:
      634       assign
      635         v-shift-offset = 0
      636       .
      637     end.
      638     if p-shift-date > p-fact-date
      639     then do:
      640       message
      641         vss-workfile vss-revision vss-description skip
      642         "Неправильная дата закрытия смены" skip
      643         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      644         view-as alert-box error .
      645       undo, return error
      646         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      647           ,string(p-fact-date, '99/99/9999':U)
      648           ,string(p-shift-date, '99/99/9999':U)
      649           )
      650       .
      651     end.
      652     if p-shift-num < 1
      653     or p-shift-num > 24
      654     then do:
      655       message
      656         vss-workfile vss-revision vss-description skip
      657         "Неправильный номер смены" skip
      658         "p-shift-num" p-shift-num skip
      659         view-as alert-box error .
      660       undo, return error return-value .
      661     end.
      662     assign
      663       p-fact-order           = v-fact-date-num
      664                              + v-shift-offset * 0.5
      665                              + p-shift-num    * 0.02 - 0.01
      666                              + p-fact-num     * 0.0000000001
      667       p-shift-end-fact-order = v-fact-date-num
      668                              + v-shift-offset * 0.5
      669                              + p-shift-num    * 0.02
      670       p-day-end-fact-order   = v-fact-date-num
      671                              + 0.99
      672     .
      673     if p-fact-order           <= v-fact-date-num
      674     or p-shift-end-fact-order <= v-fact-date-num
      675     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      676     or p-shift-end-fact-order >= p-day-end-fact-order
      677     then do:
      678       message
      679         vss-workfile vss-revision vss-description skip
      680         "Внутренняя ошибка при генерации фактического номера" skip
      681         "p-fact-date"            p-fact-date            skip
      682         "p-fact-time"            p-fact-time            skip
      683         "p-fact-num"             p-fact-num             skip
      684         "p-shift-date"           p-shift-date           skip
      685         "p-shift-num"            p-shift-num            skip
      686         "p-shift-on"             p-shift-on             skip
      687         "p-shift-end-fact-order" p-shift-end-fact-order skip
      688         "p-day-end-fact-order"   p-day-end-fact-order   skip
      689         "v-fact-date-num"        v-fact-date-num        skip
      690         view-as alert-box error .
      691       undo, return error return-value .
      692     end.
      693   end procedure.
      694   procedure day-begin-fact-order :
      695     define input  parameter p-fact-date            as date    no-undo .
      696     define output parameter p-day-begin-fact-order as decimal no-undo .
      697     do
      698     on error undo, return error return-value
      699     :
      700       if p-fact-date = ?
      701       then do:
      702         assign
      703           p-day-begin-fact-order = 0
      704         .
      705       end.
      706       else do:
      707         assign
      708           p-day-begin-fact-order = integer(p-fact-date)
      709         .
      710       end.
      711     end.
      712   end procedure.
      713   procedure factord-max-fact-order :
      714     define output parameter p-max-fact-order as decimal   no-undo .
      715     do
      716     on error undo, return error return-value
      717     :
      718       run day-begin-fact-order in this-procedure
      719         (input  date(1, 1, 5000)
      720         ,output p-max-fact-order
      721         ) .
      722     end.
      723   end procedure.
      724   procedure factord-cut-archive :
      725     define input  parameter p-obj-type             as character no-undo .
      726     define input  parameter p-obj-code             as integer   no-undo .
      727     define input  parameter p-fact-date            as date      no-undo .
      728     define output parameter p-shift-on             as logical   no-undo .
      729     define output parameter p-shift-date           as date      no-undo .
      730     define output parameter p-shift-num            as integer   no-undo .
      731     define output parameter p-day-end-fact-order   as decimal   no-undo .
      732     define output parameter p-shift-end-fact-order as decimal   no-undo .
      733     define variable v-fact-order as decimal   no-undo .
      734     define buffer buf_shift-obj for ub.shift-obj .
      735     do
      736     on error undo, return error return-value
      737     :
      738   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      739   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      740     (input  p-obj-type
      741     ,input  p-obj-code
      742     ,input  'shift-on=request'
      743     ,output p-shift-on
      744     ) no-error .
      745       if error-status :error
      746       then do:
      747         message
      748           vss-workfile vss-revision vss-description skip
      749           "Ошибка при определении атрибута объекта" skip
      750           "Объект" p-obj-type p-obj-code skip
      751           error-status :get-message(1) skip
      752           return-value skip
      753           view-as alert-box error .
      754         undo, return error return-value .
      755       end.
      756       if p-shift-on = false
      757       then do:
      758         assign
      759           p-shift-date               = ?
      760           p-shift-num                = 0
      761         .
      762       end.
      763       else do:
      764         find first buf_shift-obj share-lock
      765           where buf_shift-obj.obj-type   = p-obj-type
      766             and buf_shift-obj.obj-code   = p-obj-code
      767             and buf_shift-obj.shift-date > p-fact-date
      768           use-index pi
      769           no-error .
      770         if not available buf_shift-obj
      771         or buf_shift-obj.status_ <> 'зкр':U
      772         then do:
      773           message
      774             vss-workfile vss-revision vss-description skip
      775             "Невозможно вычислить последнюю смену" skip
      776             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      777             "Объект" p-obj-type p-obj-code skip
      778             "Дата" p-fact-date skip
      779             view-as alert-box error .
      780           undo, return error return-value .
      781         end.
      782         find last buf_shift-obj share-lock
      783           where buf_shift-obj.obj-type = p-obj-type
      784             and buf_shift-obj.obj-code = p-obj-code
      785             and buf_shift-obj.shift-date <= p-fact-date
      786           use-index pi
      787           no-error .
      788         if available buf_shift-obj
      789         then do:
      790           if  buf_shift-obj.status_ = 'зкр':U
      791           then do:
      792             assign
      793               p-shift-date = buf_shift-obj.shift-date
      794               p-shift-num  = buf_shift-obj.shift-num
      795             .
      796           end.
      797           else do:
      798             message
      799               vss-workfile vss-revision vss-description skip
      800               "Невозможно вычислить последнюю смену" skip
      801               "Статус смены отличен от статуса" 'зкр':U skip
      802               "Объект" p-obj-type p-obj-code skip
      803               "Дата" p-fact-date skip
      804               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      805               view-as alert-box error .
      806             undo, return error return-value .
      807           end.
      808         end.
      809         else do:
      810           assign
      811             p-shift-date = p-fact-date - 1
      812             p-shift-num  = 1
      813           .
      814         end.
      815       end.
      816       run factord in this-procedure
      817         (input  p-fact-date
      818         ,input  1
      819         ,input  1
      820         ,input  p-shift-date
      821         ,input  p-shift-num
      822         ,input  p-shift-on
      823         ,output v-fact-order
      824         ,output p-shift-end-fact-order
      825         ,output p-day-end-fact-order
      826         ) no-error .
      827       if error-status :error
      828       then do:
      829         message
      830           vss-workfile vss-revision vss-description skip
      831           "Ошибка при вызове процедуры factord"
      832           error-status :get-message(1) skip
      833           return-value skip
      834           view-as alert-box error .
      835         undo, return error return-value .
      836       end.
      837     end.
      838   end procedure.
      839   procedure factord-lock-shift :
      840     define input  parameter p-obj-type  as character no-undo .
      841     define input  parameter p-obj-code  as integer   no-undo .
      842     define input  parameter p-fact-date as date      no-undo .
      843     define parameter buffer buf_shift-obj for ub.shift-obj .
      844     define variable v-shift-on      as logical   no-undo .
      845     define variable v-extra-message as character no-undo .
      846     define variable v-error as character no-undo .
      847     do
      848     on error undo, return error return-value
      849     :
      850   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      851   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      852     (input  p-obj-type
      853     ,input  p-obj-code
      854     ,input  'shift-on=request'
      855     ,output v-shift-on
      856     ) no-error .
      857       if error-status :error
      858       then do:
      859         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      860         undo, return error v-error .
      861       end.
      862       if v-shift-on = true
      863       then do:
      864         find first buf_shift-obj share-lock
      865           where buf_shift-obj.obj-type   = p-obj-type
      866             and buf_shift-obj.obj-code   = p-obj-code
      867             and buf_shift-obj.shift-date > p-fact-date
      868           use-index pi
      869           no-error .
      870         if not available buf_shift-obj
      871         or buf_shift-obj.status_ <> 'зкр':U
      872         then do:
      873           find last buf_shift-obj
      874             where buf_shift-obj.obj-type = p-obj-type
      875               and buf_shift-obj.obj-code = p-obj-code
      876               and buf_shift-obj.status_  = 'зкр':U
      877             use-index stts
      878             no-error .
      879           if available buf_shift-obj
      880           then do:
      881             assign
      882               v-extra-message =
      883                     substitute("Дата начала последеней закрытой смены на объекте &1"
      884                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      885                               )
      886             .
      887           end.
      888           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      889           undo, return error v-error .
      890         end.
      891       end.
      892     end.
      893   end procedure.
      894   procedure factord-end-day :
      895     define input  parameter p-fact-date            as date    no-undo .
      896     define output parameter p-day-end-fact-order   as decimal no-undo .
      897     do
      898     on error undo, return error return-value
      899     :
      900       if p-fact-date = ?
      901       then do:
      902         return error "Не указана фактическая дата" .
      903       end.
      904       assign
      905         p-day-end-fact-order = integer(p-fact-date) + 0.99
      906       .
      907     end.
      908   end procedure.
      909   procedure factord-to-date :
      910     define input  parameter p-fact-order as decimal no-undo .
      911     define output parameter p-fact-date  as date    no-undo .
      912     define variable v-ref-date  as date      no-undo .
      913     define variable v-ref-delta as integer   no-undo .
      914     do
      915     on error undo, return error return-value
      916     :
      917       if p-fact-order = ?
      918       or p-fact-order = 0
      919       then do:
      920         return error "Не указан fact-order" .
      921       end.
      922       assign
      923         v-ref-date  = date(1, 1, 2000)
      924       .
      925       assign
      926         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      927       .
      928       assign
      929         p-fact-date = v-ref-date + v-ref-delta
      930       .
      931     end.
      932   end procedure.
      933   procedure factord-to-fact-num :
      934     define input  parameter p-fact-order as decimal no-undo .
      935     define output parameter p-fact-num   as integer no-undo .
      936     define variable v-fact-order-trunc as decimal no-undo .
      937     do
      938     on error undo, return error return-value
      939     :
      940       if p-fact-order = ?
      941       or p-fact-order = 0
      942       then do:
      943         return error "Не указан fact-order" .
      944       end.
      945       assign
      946        v-fact-order-trunc = truncate(p-fact-order, 2)
      947       .
      948       assign
      949         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      950       .
      951     end.
      952   end procedure.
      953   procedure factord-to-shift-num :
      954     define input  parameter p-fact-order as decimal no-undo .
      955     define output parameter p-shift-num   as integer no-undo .
      956     define variable  p-shift-numd  as decimal   no-undo .
      957     define variable v-fact-order-trunc as decimal no-undo .
      958     do
      959     on error undo, return error return-value
      960     :
      961       if p-fact-order = ?
      962       or p-fact-order = 0
      963       then do:
      964         return error "Не указан fact-order" .
      965       end.
      966       assign
      967        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      968       .
      969       if v-fact-order-trunc < 0.5 then do:
      970         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      971       end.
      972       assign
      973         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      974         .
      975        assign
      976         p-shift-num = truncate (p-shift-numd , 0)
      977       .
      978     end.
      979   end procedure.
      980   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      981   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      982   define  shared variable RepPathName        as character no-undo .
      983   define  shared variable PrintRubl          as logical   no-undo .
      984   define variable sym1  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      985   define variable sym2  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      986   define variable sym3  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      987   define variable sym4  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      988   define variable sym5  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      989   define variable sym6  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      990   define variable sym7  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      991   define variable sym8  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      992   define variable sym9  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      993   define variable sym10 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      994   define variable sym11 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      995   define variable sym12 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      996   define variable sym13 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      997   define variable sym14 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      998   define variable sym15 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      999   define variable sym16 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1000   define variable sym17 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1001   define variable sym18 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1002   define variable sym19 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1003   define variable sym20 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1004   define variable sym21 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     1005   define variable sym22 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     1006   define variable sym23 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     1007   define variable sym24 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     1008   define variable sym25 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     1009   define variable sym26 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     1010   define variable sym27 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     1011   define variable temp1 as integer   no-undo.
     1012   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1013   procedure proc-alt-shift-f2:
     1014     if not ibs.th.gbl.gbl-var:rcode
     1015   then
     1016     run gbl\inidebug.p .
     1017   end.
     1018   procedure proc-alt-shift-f3:
     1019     run gbl/prvssinf.p
     1020       ( input this-procedure
     1021       ) .
     1022   end.
     1023   define variable v-inform-launched as logical no-undo initial false .
     1024   procedure proc-alt-shift-f4:
     1025     define variable v-action as character no-undo .
     1026     if v-inform-launched = false then do:
     1027       assign
     1028         v-inform-launched = true
     1029       .
     1030       run gbl/d-inform.w
     1031         (  input self
     1032         ,  input this-procedure
     1033         , output v-action
     1034         ) no-error .
     1035       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
     1036       assign
     1037         v-inform-launched = false
     1038       .
     1039     end.
     1040   end.
     1041   procedure proc-alt-f1:
     1042     run gbl/corrhelp.p
     1043       (input this-procedure
     1044       ) .
     1045   end .
     1046   on alt-shift-f2 anywhere do:
     1047     run proc-alt-shift-f2.
     1048   end.
     1049   on alt-shift-f3 anywhere do:
     1050     run proc-alt-shift-f3 in this-procedure .
     1051   end.
     1052   on alt-shift-f4 anywhere do:
     1053     run proc-alt-shift-f4 in this-procedure.
     1054   end.
     1055   on alt-f1 anywhere do:
     1056     run proc-alt-f1 in this-procedure .
     1057   end.
     1058   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1059     define variable v-cntxt-db-num        as integer   no-undo .
     1060     define variable v-cntxt-userid        as character no-undo .
     1061     define variable v-cntxt-level         as character no-undo .
     1062     define variable v-cntxt-host-code-obj as integer   no-undo .
     1063     define variable v-cntxt-obj-type      as character no-undo .
     1064     define variable v-cntxt-obj-code      as integer   no-undo .
     1065     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1066     define variable v-cntxt-is-admin      as logical   no-undo .
     1067   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1068     run mainmenu_getcntxt in my-handle
     1069       (output v-cntxt-db-num
     1070       ,output v-cntxt-userid
     1071       ,output v-cntxt-level
     1072       ,output v-cntxt-host-code-obj
     1073       ,output v-cntxt-obj-type
     1074       ,output v-cntxt-obj-code
     1075       ,output v-cntxt-db-num-obj
     1076       ,output v-cntxt-is-admin
     1077       ) .
     1078   define variable base-type as character no-undo .
     1079   define variable base-code as integer   no-undo .
     1080   define variable g#report-num as integer   no-undo .
     1081   define variable g#gds-engl as logical   no-undo .
     1082   define variable vv-exch-rate  as decimal   no-undo .
     1083   define variable vv-exch-scale as decimal   no-undo .
     1084   define variable v-cntxt-host-name-obj as character no-undo .
     1085   if v-cntxt-level = 'object':U then do:
     1086   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1087   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostname in g#library
     1088     (input  v-cntxt-obj-type
     1089     ,input  v-cntxt-obj-code
     1090     ,output v-cntxt-host-code-obj
     1091     ,output v-cntxt-host-name-obj
     1092     )  .
     1093   end.
     1094   if v-cntxt-level = 'firm':U then do:
     1095     find first ub.clients no-lock where
     1096                ub.clients.obj-type = 'орг':U and
     1097                ub.clients.obj-code = v-cntxt-host-code-obj no-error .
     1098   if error-status :error then v-cntxt-host-name-obj = ? .
     1099      else v-cntxt-host-name-obj = ub.clients.obj-name.
     1100   end.
     1101   if v-cntxt-level = 'object':U
     1102   or v-cntxt-level = 'firm':U
     1103   then do:
     1104   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1105   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     1106     (input  v-cntxt-host-code-obj
     1107     ,output base-code
     1108     )  .
     1109   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1110   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     1111     (input  base-code
     1112     ,input  today
     1113     ,output vv-exch-rate
     1114     ,output vv-exch-scale
     1115     ,output base-type
     1116     )  .
     1117   end.
     1118   run get-report-num in my-handle ( output g#report-num ).
     1119   run get-gds-engl in my-handle ( output g#gds-engl ) .
     1120     define buffer buf_clients  for clients.
     1121     define buffer buf_stk-tot for stk-tot.
     1122     define variable  v-fact-order           as decimal   no-undo .
     1123     run day-begin-fact-order in this-procedure ( input x-Date-Alone + 1 ,              output v-fact-order ).
     1124     define variable Counter1 as integer initial 0   no-undo .
     1125     define variable Line     as character no-undo .
     1126     define variable name     as character no-undo .
     1127     define variable summ     as decimal   no-undo .
     1128     define variable NDS      as decimal   no-undo .
     1129     define variable NP       as decimal   no-undo .
     1130     define variable sum-qnty     as decimal   no-undo .
     1131     define variable sum-summ     as decimal   no-undo .
     1132     define variable sum-NDS      as decimal   no-undo .
     1133     define variable sum-NP       as decimal   no-undo .
     1134   define variable v-account as integer init 0 no-undo .
     1135   define variable v-account-lavel as character no-undo .
     1136   define variable v-button-stop as logical no-undo .
     1137   define variable v-kol-spice as integer no-undo .
     1138   define variable v-kol-spice2 as integer no-undo .
     1139   define variable v-kol-spice3 as integer no-undo .
     1140   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     1141   DEFINE BUTTON StopBtn AUTO-END-KEY
     1142        LABEL "Стоп"
     1143        SIZE 10 BY 1.
     1144   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     1145        LABEL "Обработано записей"
     1146         VIEW-AS TEXT
     1147        SIZE 14 BY .67 NO-UNDO.
     1148   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     1149         VIEW-AS TEXT
     1150        SIZE 53.25 BY .67
     1151        FGCOLOR 1  NO-UNDO.
     1152   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     1153         VIEW-AS TEXT
     1154        SIZE 53.25 BY .67
     1155        FGCOLOR 1  NO-UNDO.
     1156   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     1157         VIEW-AS TEXT
     1158        SIZE 53.25 BY .67
     1159        FGCOLOR 1  NO-UNDO.
     1160   DEFINE RECTANGLE RECT-1
     1161        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1162        SIZE 55.13 BY 4.46.
     1163   DEFINE FRAME InfoFrame
     1164        StopBtn AT ROW 4.25 COL 21.75
     1165        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     1166        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     1167        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     1168        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     1169        RECT-1 AT ROW 1 COL 1
     1170       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1171            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1172            TITLE "Процесс"
     1173            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     1174   define variable mFrameView      as logical   no-undo init yes.
     1175     define variable mFramHandle as handle no-undo.
     1176     mFramHandle = frame InfoFrame:handle.
     1177     if  log-manager:logfile-name ne ?
     1178     then DO:
     1179         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1180         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1181         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     1182     end.
     1183     mFrameView = not session:batch-mode and mFramHandle:visible.
     1184     if mFrameView
     1185     then do:
     1186       ASSIGN
     1187          FRAME InfoFrame:HIDDEN                           = TRUE
     1188          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     1189     end.
     1190   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     1191   DO:
     1192     IF not StopProcessing THEN
     1193       Message "Вы действительно хотите прервать" SKIP
     1194               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     1195                 UPDATE StopProcessing.
     1196     IF StopProcessing THEN do:
     1197        if mFrameView
     1198        then do:
     1199           HIDE FRAME InfoFrame.
     1200        end.
     1201     End.
     1202   END.
     1203   assign v-account = ( if integer( 1 ) = 0 then 100 else integer( 1 ) ).
     1204     if  log-manager:logfile-name ne ?
     1205     then DO:
     1206         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     1207     end.
     1208     if not session:batch-mode then
     1209     do:
     1210       VIEW FRAME InfoFrame.
     1211       mFrameView = true.
     1212     end.
     1213      v-button-stop = false .
     1214         if mFrameView
     1215         then do:
     1216         if v-button-stop then view STOPBTN in frame InfoFrame.
     1217                          else Hide STOPBTN in frame InfoFrame.
     1218         end.
     1219   if session :set-wait-state( "compiler" ) then.
     1220     Line = fill("-", 250).
     1221     DEFINE frame f-doc
     1222         sym1  name                   column-label " Объект "   format "X(49)"                 space(0)
     1223         sym2  buf_stk-tot.fact-qnty  column-label " Кол-во "   format "->>,>>>,>>>,>>9.999"   space(0)
     1224         sym3  summ                   column-label " Сумма  "   format "->>>,>>>,>>>,>>9.99"   space(0)
     1225         sym4  NDS                    column-label " НДС  "     format "->>>,>>>,>>>,>>9.99"   space(0)
     1226         sym5  NP                     column-label " НП  "      format "->,>>>,>>>,>>9.99"     space(0)
     1227         sym6
     1228       HEADER
     1229         string( "Дата печати : " + string(TODAY , "99.99.9999") + " , " + string(TIME, "HH:MM") ) AT 5 format "X(60)"
     1230         string( "Страница " + string( PAGE-NUMBER( OutStream )  , ">>9") ) AT 100 format "X(15)" SKIP
     1231         Line format "X(134)" AT 1
     1232     with width 160 down stream-io.
     1233   output stream OutStream to value( string( session:temp-directory +
     1234                                        "rpt" + string( g#report-num ) ) )
     1235                                        page-size 62 .
     1236     FORM HEADER
     1237         Line format "X(134)" AT 1 SKIP
     1238         "Продолжение - на следующей странице" AT 30 SKIP
     1239         with FRAME BottomFrame width 160 PAGE-BOTTOM NO-LABELS NO-BOX .
     1240     VIEW stream OutStream FRAME BottomFrame .
     1241     FORM with FRAME f-doc .
     1242     PUT stream OutStream SPACE(20) "Отчет о суммарных остатках на объектах на " format "X(45)"  x-Date-Alone format "99/99/9999" SKIP .
     1243     if x-SET_PAY_TYPE = 1 then do:
     1244       PUT stream OutStream "Суммы в продажных ценах." format "X(100)" SKIP .
     1245     end.
     1246     else do:
     1247       if x-SET_val_TYPE = 1 then PUT stream OutStream "Суммы в учетных ценах в рублях." format "X(100)" SKIP .
     1248       else                       PUT stream OutStream "Суммы в учетных ценах в валюте."          format "X(100)" SKIP .
     1249     end.
     1250     for each obj-list :
     1251       assign Counter1 = Counter1 + 1.
     1252   IF ( Counter1 modulo v-account = 0 )  then DO:
     1253             if  log-manager:logfile-name ne ?
     1254             then DO:
     1255                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     1256             end.
     1257              if mFrameView
     1258              then do:
     1259               DISPLAY
     1260                 Counter1 @ RecordsDone
     1261                 WITH FRAME InfoFrame.
     1262              end.
     1263   End.
     1264      if v-button-stop then  DO:
     1265            if mFrameView
     1266            then
     1267               PROCESS EVENTS.
     1268            IF StopProcessing THEN DO:
     1269            RETURN error.
     1270            End.
     1271      end.
     1272       find first buf_clients no-lock
     1273         where buf_clients.obj-type  = obj-list.obj-type
     1274           and buf_clients.obj-code  = obj-list.obj-code
     1275       no-error .
     1276       assign name = buf_clients.obj-name + " (" + buf_clients.obj-type + '#' + string(buf_clients.obj-code) + ")"  .
     1277       if x-SET_PAY_TYPE = 1 then do:
     1278         find last buf_stk-tot no-lock
     1279           where buf_stk-tot.obj-type   = obj-list.obj-type
     1280             and buf_stk-tot.obj-code   = obj-list.obj-code
     1281             and buf_stk-tot.fact-order < v-fact-order
     1282             and buf_stk-tot.sum-type   = 'crsa':U
     1283             and buf_stk-tot.cat-id     = '##,##':U
     1284         no-error .
     1285         if not available buf_stk-tot then next .
     1286         if var-report-r-b = "rubl" then
     1287           assign
     1288             summ = buf_stk-tot.sum-rubl
     1289             NDS  = buf_stk-tot.VAT-rubl
     1290             NP   = buf_stk-tot.SLT-rubl
     1291           .
     1292         else
     1293           assign
     1294             summ = buf_stk-tot.sum-base
     1295             NDS  = buf_stk-tot.VAT-base
     1296             NP   = buf_stk-tot.SLT-base
     1297           .
     1298       end.
     1299       else do:
     1300         find last buf_stk-tot no-lock
     1301           where buf_stk-tot.obj-type   = obj-list.obj-type
     1302             and buf_stk-tot.obj-code   = obj-list.obj-code
     1303             and buf_stk-tot.fact-order < v-fact-order
     1304             and buf_stk-tot.sum-type   = 'cost':U
     1305             and buf_stk-tot.cat-id     = '##,##':U
     1306         no-error .
     1307         if not available buf_stk-tot then next .
     1308         if x-SET_val_TYPE = 1 then
     1309           assign
     1310             summ = buf_stk-tot.sum-rubl
     1311             NDS  = buf_stk-tot.VAT-rubl
     1312             NP   = buf_stk-tot.SLT-rubl
     1313           .
     1314         else
     1315           assign
     1316             summ = buf_stk-tot.sum-base
     1317             NDS  = buf_stk-tot.VAT-base
     1318             NP   = buf_stk-tot.SLT-base
     1319           .
     1320       end.
     1321       display stream outstream sym1 name sym2  buf_stk-tot.fact-qnty  sym3 summ sym4  NDS sym5  NP sym6 with frame f-doc.
     1322       down stream outstream with frame f-doc .
     1323       assign
     1324         sum-qnty = sum-qnty + buf_stk-tot.fact-qnty
     1325         sum-summ = sum-summ + summ
     1326         sum-NDS  = sum-NDS  + NDS
     1327         sum-NP   = sum-NP   + NP
     1328       .
     1329     end.
     1330     PUT STREAM OutStream Line format "X(134)" skip .
     1331     display stream outstream
     1332       sym1 "Итого: " @  name
     1333       sym2 sum-qnty  @  buf_stk-tot.fact-qnty
     1334       sym3 sum-summ  @  summ
     1335       sym4 sum-NDS   @  NDS
     1336       sym5 sum-NP    @  NP
     1337       sym6
     1338     with frame f-doc.
     1339     down stream outstream with frame f-doc .
     1340     PUT STREAM OutStream Line format "X(134)"  .
     1341     HIDE stream OutStream FRAME BottomFrame .
     1342     OUTPUT stream OutStream CLOSE.
     1343   if mFrameView
     1344   then do:
     1345      HIDE FRAME InfoFrame.
     1346   end.
     1347   if session :set-wait-state( "" ) then.
     1348     define variable v-user-action as character no-undo .
     1349     define variable v-printed as logical   no-undo .
     1350     run gbl/prnfilen.w
     1351       (input  ""
     1352       ,input  0
     1353       ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
     1354       ,input 7
     1355       ,output v-user-action
     1356       ,output v-printed
     1357       ) .
     1358   end.
