        1   define input parameter parparentproc as widget-handle no-undo .
        2   define input parameter p-curr-obj-type like ub.clients.obj-type no-undo .
        3   define input parameter p-curr-obj-code like ub.clients.obj-code no-undo .
        4   define input parameter p-prt-rec as recid no-undo .
        5   def var vss-revision    as character no-undo init "$Revision$":U .
        6   def var vss-author      as character no-undo init "$Author$":U .
        7   def var vss-date        as character no-undo init "$Date$":U .
        8   def var vss-workfile    as character no-undo init "$Workfile$":U .
        9   def var vss-archive     as character no-undo init "$Archive$":U .
       10   def var vss-description as character no-undo init "Остатки по объекту для всех товаров, где есть данный узел шкалы".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define new global shared variable g#library  as handle no-undo .
       70   define new global shared variable g#library2 as handle no-undo .
       71   define   shared variable g#auto as logical no-undo.
       72   define   shared variable g#news as logical no-undo.
       73   define   shared variable g#oxml as logical no-undo.
       74   define   shared variable g#esys as logical no-undo.
       75   define   shared variable g#news-source-db as integer no-undo.
       76   define   shared variable g#esys-source-esys as integer no-undo.
       77   define   shared variable g#db-num as integer   no-undo .
       78   define   shared variable g#userid as character no-undo .
       79   define   shared variable g#passwd as character no-undo .
       80   procedure proc-alt-shift-f2:
       81     if not ibs.th.gbl.gbl-var:rcode
       82   then
       83     run gbl\inidebug.p .
       84   end.
       85   procedure proc-alt-shift-f3:
       86     run gbl/prvssinf.p
       87       ( input this-procedure
       88       ) .
       89   end.
       90   define variable v-inform-launched as logical no-undo initial false .
       91   procedure proc-alt-shift-f4:
       92     define variable v-action as character no-undo .
       93     if v-inform-launched = false then do:
       94       assign
       95         v-inform-launched = true
       96       .
       97       run gbl/d-inform.w
       98         (  input self
       99         ,  input this-procedure
      100         , output v-action
      101         ) no-error .
      102       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      103       assign
      104         v-inform-launched = false
      105       .
      106     end.
      107   end.
      108   procedure proc-alt-f1:
      109     run gbl/corrhelp.p
      110       (input this-procedure
      111       ) .
      112   end .
      113   on alt-shift-f2 anywhere do:
      114     run proc-alt-shift-f2.
      115   end.
      116   on alt-shift-f3 anywhere do:
      117     run proc-alt-shift-f3 in this-procedure .
      118   end.
      119   on alt-shift-f4 anywhere do:
      120     run proc-alt-shift-f4 in this-procedure.
      121   end.
      122   on alt-f1 anywhere do:
      123     run proc-alt-f1 in this-procedure .
      124   end.
      125   DEFINE BUTTON b-help
      126        LABEL "Помо&щь"
      127        SIZE 7.75 BY 1.17.
      128   DEFINE BUTTON b-quit AUTO-GO DEFAULT
      129        LABEL "&Выход"
      130        SIZE 10 BY 1
      131        BGCOLOR 8 .
      132   DEFINE VARIABLE fact-qnty_ AS DECIMAL FORMAT "->>,>>>,>>9.99" INITIAL 0
      133        LABEL "По всем товарам ФАКТ"
      134        FGCOLOR 4
      135        VIEW-AS FILL-IN
      136        SIZE 14 BY 1
      137        NO-UNDO.
      138   DEFINE  VARIABLE free-qnty_ AS DECIMAL FORMAT "->>,>>>,>>9.999":U INITIAL 0
      139        LABEL "По всем товарам СВОБОДНО"
      140        FGCOLOR 4
      141        VIEW-AS FILL-IN
      142        SIZE 14 BY 1 NO-UNDO.
      143   DEFINE QUERY br-rest FOR prt-obj, goods SCROLLING.
      144   DEFINE BROWSE br-rest QUERY br-rest NO-LOCK DISPLAY
      145         prt-obj.artic COLUMN-LABEL "Артикул" FORMAT "x(12)"
      146         goods.gds-name COLUMN-LABEL "Название" FORMAT "x(36)"
      147         prt-obj.fact-qnty COLUMN-LABEL "Факт" FORMAT "->>,>>>,>>>.<<"
      148         prt-obj.free-qnty COLUMN-LABEL "Свободно" FORMAT "->>,>>>,>>>.<<"
      149         prt-obj.price-sale COLUMN-LABEL "Цена продажи" FORMAT "->>,>>>.<<"
      150       WITH SEPARATORS SIZE 90 BY 13.25.
      151   DEFINE FRAME d-prt-obj
      152        b-quit AT ROW 1 COL 1
      153        b-help AT ROW 1 COL 14
      154        br-rest AT ROW 5 COL 1.5
      155        fact-qnty_ AT ROW 3.25 COL 26.5 COLON-ALIGNED
      156        free-qnty_ AT ROW 3.25 COL 60 COLON-ALIGNED
      157        SPACE(3.24) SKIP(0.45)
      158       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      159            SIDE-LABELS NO-UNDERLINE THREE-D SCROLLABLE
      160            TITLE ""
      161            DEFAULT-BUTTON b-quit.
      162   ASSIGN
      163          FRAME d-prt-obj:SCROLLABLE       = FALSE
      164          br-rest:NUM-LOCKED-COLUMNS IN FRAME d-prt-obj = 1.
      165   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      166   on help of frame d-prt-obj
      167   do:
      168     run gbl/app_help.p
      169       (input this-procedure :file-name
      170       ,input ''
      171       ,input ?
      172       ) no-error.
      173     if error-status :error then do:
      174       message
      175         "Ошибка при вызове помощи"
      176         error-status :get-message(1)
      177         view-as alert-box .
      178     end.
      179   end.
      180   run minbtn-set in this-procedure .
      181   on choose of b-help in frame d-prt-obj
      182   do:
      183     apply "help":u to frame d-prt-obj .
      184   end.
      185   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      186   procedure minbtn-set :
      187       do
      188           on error undo, return error return-value
      189           :
      190           define variable ii              as integer       no-undo .
      191           define variable fh              as widget-handle no-undo .
      192           define variable hh              as widget-handle no-undo .
      193           define variable v-h             as handle        extent 4 no-undo .
      194           define variable v-name-button   as character     no-undo .
      195           define variable v-help-old-x    as decimal       no-undo .
      196           define variable v-help-old-y    as decimal       no-undo .
      197           define variable v-help-old-size as decimal       no-undo .
      198           define variable v-frame-width   as decimal       no-undo .
      199           define variable jj              as integer       no-undo .
      200           do
      201               on error undo, return error
      202               :
      203               assign
      204                   v-frame-width = frame d-prt-obj:width - 0.3
      205                   fh            = frame d-prt-obj:first-child
      206                   hh            = fh:first-child
      207                   ii            = 1
      208                   .
      209               do while valid-handle(hh):
      210                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      211                   do:
      212                       case lc(hh:name) :
      213                           when "b-help" then
      214                               do:
      215                                   hh:load-image-up("cmp/b-help.bmp":u) .
      216                                   hh:load-image-down("cmp/b-help.bmp":u) .
      217                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      218                                   hh:TOOLTIP = "Помощь" .
      219                                   v-help-old-x = hh:column .
      220                                   v-help-old-y = hh:row    .
      221                                   v-help-old-size = hh:width .
      222                                   hh:width-chars = 2.5 .
      223                               end.
      224                           when "b-print" then
      225                               do:
      226                                   hh:load-image("cmp/b-print.bmp":u) .
      227                                   hh:TOOLTIP = "Печать" .
      228                                   v-h[ii] = hh:handle .
      229                                   ii = ii + 1 .
      230                                   hh:width-chars = 3 .
      231                               end.
      232                           when "b-history" or
      233                           when "b-hist" then
      234                               do:
      235                                   hh:load-image("cmp/b-hist.bmp":u) .
      236                                   hh:TOOLTIP = "История" .
      237                                   v-h[ii] = hh:handle .
      238                                   ii = ii + 1 .
      239                                   hh:width-chars = 3 .
      240                               end.
      241                           when "b-sch" then
      242                               do:
      243                                   hh:load-image("cmp/b-sch.bmp":u) .
      244                                   hh:TOOLTIP = "Установка Фильтра" .
      245                                   v-h[ii] = hh:handle .
      246                                   ii = ii + 1 .
      247                                   hh:width-chars = 3 .
      248                               end.
      249                           when "b-hist-user" then
      250                               do:
      251                                   hh:load-image("cmp/b-hist.bmp":u) .
      252                                   hh:TOOLTIP = "История пользователя" .
      253                                   ii = ii + 1 .
      254                               end.
      255                       end case.
      256                   end.
      257                   hh = hh:next-sibling.
      258               end.
      259               b-help:column = v-frame-width - b-help:width-chars.
      260               jj = 0.
      261               repeat ii = 4 to 1 by -1 :
      262                   if valid-handle (v-h[ii] ) then
      263                   do:
      264                       jj  = jj + 1 .
      265                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      266                       v-h[ii]:row    = v-help-old-y .
      267                   end.
      268               end.
      269           end.
      270       end.
      271   end procedure.
      272   MAIN-BLOCK:
      273   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      274      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      275     find gds-prt where recid (gds-prt) = p-prt-rec no-lock.
      276     for each prt-obj where prt-obj.prt-code = gds-prt.node-code
      277                                         and prt-obj.obj-type = p-curr-obj-type
      278                                         and prt-obj.obj-code = p-curr-obj-code no-lock:
      279       assign
      280           fact-qnty_ = fact-qnty_ + prt-obj.fact-qnty
      281           free-qnty_ = free-qnty_ + prt-obj.free-qnty
      282           .
      283     end.
      284     RUN enable_UI.
      285     WAIT-FOR GO OF FRAME d-prt-obj.
      286   END.
      287   RUN disable_UI.
      288   PROCEDURE disable_UI :
      289     HIDE FRAME d-prt-obj.
      290   END PROCEDURE.
      291   PROCEDURE enable_UI :
      292     frame d-prt-obj:title = substitute('ОСТАТКИ ПО ТОВАРАМ &1 &2       ДЛЯ ПРИЗНАКА : &3'
      293                                             ,p-curr-obj-type
      294                                             ,p-curr-obj-code
      295                                             ,gds-prt.f-name).
      296     DISPLAY fact-qnty_ free-qnty_ WITH FRAME d-prt-obj.
      297     ENABLE br-rest b-quit b-help WITH FRAME d-prt-obj.
      298     open query br-rest for each prt-obj where prt-obj.prt-code = gds-prt.node-code
      299                                           and prt-obj.obj-type = p-curr-obj-type
      300                                           and prt-obj.obj-code = p-curr-obj-code no-lock,
      301                                         each goods where goods.artic = prt-obj.artic
      302                                                                 and goods.prod-type = prt-obj.prod-type
      303                                                                 and goods.prod-code = prt-obj.prod-code no-lock.
      304   END PROCEDURE.
