      797   define temp-table temp_onewin_items no-undo
      798       field itm-key       as integer
      799       field itmExtKey     as character
      800       field itmName       as character
      801       field itmDesc       as character
      802       field itmSelected   as logical
      803       index pi is primary unique
      804           itm-key
      805       index ie
      806           itmExtKey
      807   .
      808   define temp-table temp_onewin_itemsSelected no-undo
      809       field its-key   as integer
      810       field itm-key   as integer
      811       field itmExtKey as character
      812       index pi is primary unique
      813           its-key
      814       index im
      815           itm-key
      816   .
      817   define variable v-onewin7-itm-key    as integer      no-undo.
      818   procedure onewin_clear :
      819       define buffer buf_temp_onewin_items        for temp_onewin_items.
      820   do
      821   for buf_temp_onewin_items
      822   on error undo, return error
      823   :
      824       empty temp-table buf_temp_onewin_items.
      825   end.
      826   end procedure.
      827   procedure onewin_add-item :
      828   define input parameter p-ext-key   as character        no-undo.
      829   define input parameter p-item-name as character        no-undo.
      830   define input parameter p-item-desc as character        no-undo.
      831   define input parameter p-selected  as logical          no-undo.
      832       define buffer buf_temp_onewin_items        for temp_onewin_items.
      833   do
      834   for buf_temp_onewin_items
      835   on error undo, return error
      836   :
      837       find last buf_temp_onewin_items no-error.
      838       if available buf_temp_onewin_items then do:
      839         v-onewin7-itm-key = buf_temp_onewin_items.itm-key.
      840       end.
      841       else do:
      842         v-onewin7-itm-key = 0.
      843       end.
      844       assign
      845           v-onewin7-itm-key = v-onewin7-itm-key + 1
      846       .
      847       create buf_temp_onewin_items.
      848       assign
      849       buf_temp_onewin_items.itm-key      = v-onewin7-itm-key
      850       buf_temp_onewin_items.itmExtKey    = p-ext-key
      851       buf_temp_onewin_items.itmName      = p-item-name
      852       buf_temp_onewin_items.itmDesc      = p-item-desc
      853       buf_temp_onewin_items.itmSelected  = p-selected
      854       .
      855   end.
      856   end procedure.
      857   procedure onewin_create-selection :
      858   define input parameter p-itm-key as integer no-undo .
      859   define input parameter p-itmextkey as character no-undo .
      860   define variable v-counter as integer no-undo .
      861   define buffer buf_temp_onewin_itemsSelected for temp_onewin_itemsSelected .
      862   do
      863   on error undo, return error
      864   :
      865     find last buf_temp_onewin_itemsSelected use-index pi no-error.
      866     if available buf_temp_onewin_itemsSelected then do:
      867       v-counter = buf_temp_onewin_itemsSelected.its-key.
      868     end.
      869     find first buf_temp_onewin_itemsSelected where
      870          buf_temp_onewin_itemsSelected.itm-key = p-itm-key no-error.
      871     if not available buf_temp_onewin_itemsSelected then do:
      872       create buf_temp_onewin_itemsSelected.
      873       assign
      874       buf_temp_onewin_itemsSelected.its-key   = v-counter + 1
      875       v-counter = v-counter + 1
      876       buf_temp_onewin_itemsSelected.itm-key   = p-itm-key
      877       buf_temp_onewin_itemsSelected.itmExtKey = p-itmExtKey
      878       .
      879     end.
      880   end.
      881   end procedure.
      882   procedure onewin_check-item :
      883   define input parameter p-ext-key   as character        no-undo.
      884   define output parameter p-exists as logical no-undo .
      885   define buffer buf_temp_onewin_items for temp_onewin_items.
      886   find first buf_temp_onewin_items where
      887   buf_temp_onewin_items.itmExtKey    = p-ext-key no-error.
      888   if available buf_temp_onewin_items then do:
      889     p-exists = yes.
      890   end.
      891   end procedure.
