     1029        RADIO-BUTTONS
     1030             "Все", 1,
     1031   "Выборочно", 2
     1032        SIZE 12 BY 1.75 NO-UNDO.
     1033   DEFINE VARIABLE rb-events AS INTEGER
     1034        VIEW-AS RADIO-SET VERTICAL
     1035        RADIO-BUTTONS
     1036             "Все", 1,
     1037   "Выборочно", 2
     1038        SIZE 12 BY 1.5 NO-UNDO.
     1039   DEFINE FRAME F-Main
     1040        ed-EventsName AT ROW 2 COL 15.5 NO-LABEL
     1041        event-type AT ROW 2.08 COL 52 COLON-ALIGNED WIDGET-ID 20
     1042        rb-events AT ROW 2.13 COL 3 NO-LABEL
     1043        b-user-sellect AT ROW 4.13 COL 67.5 WIDGET-ID 24
     1044        v-user-name AT ROW 4.17 COL 47 COLON-ALIGNED NO-LABEL WIDGET-ID 90
     1045        rb-cd AT ROW 4.63 COL 3 NO-LABEL WIDGET-ID 2
     1046        ed-cd-names AT ROW 4.63 COL 15.5 NO-LABEL WIDGET-ID 12
     1047        v-doc-num AT ROW 6.13 COL 47 COLON-ALIGNED NO-LABEL WIDGET-ID 92
     1048        b-doc-select AT ROW 6.13 COL 67.5 WIDGET-ID 46
     1049        v-cd-supmode AT ROW 6.75 COL 13.5 COLON-ALIGNED WIDGET-ID 100
     1050        b-cd-mode-select AT ROW 6.75 COL 43 WIDGET-ID 84
     1051        b-dc-sellect AT ROW 8.04 COL 67.5 WIDGET-ID 80
     1052        v-dc-num AT ROW 8.13 COL 47 COLON-ALIGNED NO-LABEL WIDGET-ID 94
     1053        rb-b-codes AT ROW 8.75 COL 3 NO-LABEL WIDGET-ID 16
     1054        ed-b-codes AT ROW 8.75 COL 15.5 NO-LABEL WIDGET-ID 14
     1055        v-bc-num AT ROW 9.88 COL 47 COLON-ALIGNED NO-LABEL WIDGET-ID 96
     1056        v-h-start AT ROW 11.33 COL 10.38 COLON-ALIGNED WIDGET-ID 28
     1057        v-m-start AT ROW 11.33 COL 16.25 COLON-ALIGNED WIDGET-ID 30
     1058        v-h-end AT ROW 11.33 COL 30.25 COLON-ALIGNED WIDGET-ID 32
