      569   procedure proc-alt-shift-f2:
      570     if not ibs.th.gbl.gbl-var:rcode
      571   then
      572     run gbl\inidebug.p .
      573   end.
      574   procedure proc-alt-shift-f3:
      575     run gbl/prvssinf.p
      576       ( input this-procedure
      577       ) .
      578   end.
      579   define variable v-inform-launched as logical no-undo initial false .
      580   procedure proc-alt-shift-f4:
      581     define variable v-action as character no-undo .
      582     if v-inform-launched = false then do:
      583       assign
      584         v-inform-launched = true
      585       .
      586       run gbl/d-inform.w
      587         (  input self
      588         ,  input this-procedure
      589         , output v-action
      590         ) no-error .
      591       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      592       assign
      593         v-inform-launched = false
      594       .
      595     end.
      596   end.
      597   procedure proc-alt-f1:
      598     run gbl/corrhelp.p
      599       (input this-procedure
      600       ) .
      601   end .
      602   on alt-shift-f2 anywhere do:
      603     run proc-alt-shift-f2.
      604   end.
      605   on alt-shift-f3 anywhere do:
      606     run proc-alt-shift-f3 in this-procedure .
      607   end.
      608   on alt-shift-f4 anywhere do:
      609     run proc-alt-shift-f4 in this-procedure.
      610   end.
      611   on alt-f1 anywhere do:
      612     run proc-alt-f1 in this-procedure .
      613   end.
      614   function diff-list returns character (
      615     input parfirst-list  as character,
      616     input parsecond-list as character,
      617     input pardelim       as character).
      618     if pardelim = ""
      619     or pardelim = ?
      620     then do:
      621       assign
      622         pardelim = ","
      623       .
      624     end.
      625     def var ind as integer no-undo .
      626     def var v-elem as character no-undo .
      627     def var v-result-list as character no-undo init "".
      628     def var v-num-parfirst-list as integer no-undo .
      629     assign
      630       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      631     .
      632     do ind = 1 to v-num-parfirst-list
      633     :
      634       assign
      635         v-elem = entry(ind, parfirst-list, pardelim)
      636       .
      637       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
      638         assign
      639           v-result-list = v-result-list
      640                         + (if v-result-list > "" then pardelim else "")
      641                         + v-elem
      642         .
      643       end.
      644     end.
      645     return v-result-list .
      646   end function.
      647   function add-list returns character (
      648    input parfirst-list  as character,
      649    input parsecond-list as character,
      650    input pardelim       as character).
      651     if pardelim = ""
      652     or pardelim = ?
      653     then do:
      654       assign
      655         pardelim = ","
      656       .
      657     end.
      658     def var ind as integer no-undo .
      659     def var v-elem as character no-undo .
      660     def var v-result-list as character no-undo init "".
      661     def var v-num-parfirst-list as integer no-undo .
      662     assign
      663       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      664     .
      665     do ind = 1 to v-num-parfirst-list
      666     :
      667       assign
      668         v-elem = entry(ind, parfirst-list, pardelim)
      669       .
      670       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      671         assign
      672           v-result-list = v-result-list
      673                         + (if v-result-list > "" then pardelim else "")
      674                         + v-elem
      675         .
      676       end.
      677     end.
      678     def var v-num-parsecond-list as integer no-undo .
      679     assign
      680       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
      681     .
      682     do ind = 1 to v-num-parsecond-list
      683     :
      684       assign
      685         v-elem = entry(ind, parsecond-list, pardelim)
      686       .
      687       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      688         assign
      689           v-result-list = v-result-list
      690                         + (if v-result-list > "" then pardelim else "")
      691                         + v-elem
      692         .
      693       end.
      694     end.
      695     return v-result-list .
      696   end function.
      697   function cross-list returns character (
      698    input parfirst-list  as character,
      699    input parsecond-list as character,
      700    input pardelim       as character).
      701     if pardelim = ""
      702     or pardelim = ?
      703     then do:
      704       assign
      705         pardelim = ","
      706       .
      707     end.
      708     def var ind as integer no-undo .
      709     def var v-elem as character no-undo .
      710     def var v-result-list as character no-undo init "".
      711     def var v-num-parfirst-list as integer no-undo .
      712     assign
      713       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      714     .
      715     do ind = 1 to v-num-parfirst-list
      716     :
      717       assign
      718         v-elem = entry(ind, parfirst-list, pardelim)
      719       .
      720       if lookup(v-elem, v-result-list, pardelim) = 0
      721       and lookup(v-elem, parsecond-list, pardelim) > 0
      722       then do:
      723         assign
      724           v-result-list = v-result-list
      725                         + (if v-result-list > "" then pardelim else "")
      726                         + v-elem
      727         .
      728       end.
      729     end.
      730     return v-result-list .
      731   end function.
      732   function radio-label returns character (
      733    input par-rs-value  as character,
      734    input par-rs-radio-buttons as character)
      735    .
      736    DEFINE variable v-result-label as character no-undo.
      737    assign
      738    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
      739                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
      740                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
      741                             ), par-rs-radio-buttons
      742                           )
      743    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      744    .
      745   return v-result-label.
      746   end function.
      747   function m-radio-label returns character (
      748    input par-rs-value  as character,
      749    input par-rs-radio-buttons as character,
      750    input par-delim as character
      751    )
      752    .
      753    DEFINE variable v-result-label as character no-undo.
      754    assign
      755    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
      756                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
      757                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
      758                             ), par-rs-radio-buttons, par-delim
      759                           )
      760    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      761    .
      762   return v-result-label.
      763   end function.
      764   FUNCTION mixlist returns character
      765   (
      766    input parfirst-list  as character
      767    ,input parsecond-list as character
      768    ,input pardelim       as character
      769    ,input pardelim-result as character ) :
      770     if pardelim = ""
      771     or pardelim = ?
      772     then do:
      773       assign
      774         pardelim = ","
      775       .
      776     end.
      777     def var ind as integer no-undo .
      778     def var v-elem1 as character no-undo .
      779     def var v-elem2 as character no-undo .
      780     def var v-result-list as character no-undo init "".
      781     do ind = 1 to num-entries(parfirst-list, pardelim)
      782     :
      783       assign
      784         v-elem1 = entry(ind, parfirst-list, pardelim)
      785         v-elem2 = entry(ind, parsecond-list, pardelim)
      786       .
      787         assign
      788           v-result-list = v-result-list
      789                         + (if v-result-list > "" then pardelim-result else "")
      790                         + v-elem1 + pardelim-result + v-elem2
      791         .
      792     end.
      793     return v-result-list .
      794   END FUNCTION.
