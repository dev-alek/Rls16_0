     1060        v-summ-min AT ROW 12.83 COL 18.38 COLON-ALIGNED WIDGET-ID 38
     1061        v-summ-max AT ROW 12.83 COL 35.13 COLON-ALIGNED WIDGET-ID 40
     1062        v-qnty-min AT ROW 14.29 COL 18.38 COLON-ALIGNED WIDGET-ID 44
     1063        v-qnty-max AT ROW 14.29 COL 35.13 COLON-ALIGNED WIDGET-ID 42
     1064        v-disc-min AT ROW 15.75 COL 18.38 COLON-ALIGNED WIDGET-ID 72
     1065        v-disc-max AT ROW 15.75 COL 35.13 COLON-ALIGNED WIDGET-ID 70
     1066        v-disc-type AT ROW 15.79 COL 49 COLON-ALIGNED NO-LABEL WIDGET-ID 102
     1067        "мин." VIEW-AS TEXT
     1068             SIZE 4.38 BY .67 AT ROW 11.54 COL 42.13 WIDGET-ID 36
     1069        "Список событий:" VIEW-AS TEXT
     1070             SIZE 19.38 BY .67 AT ROW 1.25 COL 7.13
     1071             FGCOLOR 4
     1072        "Список касс:" VIEW-AS TEXT
     1073             SIZE 13.5 BY .67 AT ROW 3.88 COL 6.5 WIDGET-ID 8
     1074             FGCOLOR 4
     1075        "Список штрихкодов:" VIEW-AS TEXT
     1076             SIZE 19.38 BY .67 AT ROW 8 COL 6.5 WIDGET-ID 10
     1077             FGCOLOR 4
     1078        "Пользователь:" VIEW-AS TEXT
     1079             SIZE 13.5 BY .67 AT ROW 3.42 COL 49.38 WIDGET-ID 22
     1080             FGCOLOR 4
     1081        "Дисконтная карта:" VIEW-AS TEXT
     1082             SIZE 21.5 BY .67 AT ROW 7.38 COL 49 WIDGET-ID 76
     1083             FGCOLOR 4
     1084        "Тип скидки:" VIEW-AS TEXT
     1085             SIZE 13.5 BY .67 AT ROW 15.13 COL 51 WIDGET-ID 74
     1086             FGCOLOR 4
     1087        "Тип и номер документа:" VIEW-AS TEXT
     1088             SIZE 21.5 BY .75 AT ROW 5.38 COL 49 WIDGET-ID 48
     1089             FGCOLOR 4
     1090        "Банковская карта:" VIEW-AS TEXT
     1091             SIZE 18 BY .75 AT ROW 9.13 COL 49.5 WIDGET-ID 78
     1092             FGCOLOR 4
     1093       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
     1094            SIDE-LABELS NO-UNDERLINE THREE-D
     1095            AT COL 1 ROW 1 SCROLLABLE .
     1096   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     1097   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     1098   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     1099   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     1100   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     1101   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     1102   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     1103   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     1104         adm-object-hdl = FRAME F-Main:HANDLE.
     1105   RUN ensure-broker.
     1106   THIS-PROCEDURE:ADM-DATA =
     1107        'ADM1.1~`':U +
     1108        'SmartObject~`':U +
     1109        '~`':U +
     1110        'NO ~`':U +
     1111        '~`':U +
     1112        '~`':U +
     1113        '~`':U +
     1114        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     1115           + "~`":U +
     1116        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
     1117        'Record-Source,Record-Target,TableIO-Target~`':U +
     1118        '~`':U +
     1119        '~`~`~`~`~`~`~`~`~`~`~`':U +
     1120        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1121            THEN "^^":U
     1122        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1123             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1124   PROCEDURE adm-apply-entry :
     1125     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1126   END PROCEDURE.
     1127   PROCEDURE adm-destroy :
     1128    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1129   END PROCEDURE.
     1130   PROCEDURE adm-disable :
     1131       DISABLE ed-EventsName event-type rb-events b-user-sellect rb-cd ed-cd-names b-doc-select b-cd-mode-select b-dc-sellect rb-b-codes ed-b-codes v-bc-num v-h-start v-m-start v-h-end v-m-end v-summ-min v-summ-max v-qnty-min v-qnty-max v-disc-min v-disc-max v-disc-type WITH FRAME F-Main.
     1132       RUN dispatch ('disable-fields':U).
     1133       RUN set-attribute-list ('ENABLED=no':U).
     1134       RETURN.
     1135   END PROCEDURE.
     1136   PROCEDURE adm-edit-attribute-list :
     1137         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
     1138         RETURN.
     1139   END PROCEDURE.
     1140   PROCEDURE adm-enable :
     1141       ENABLE UNLESS-HIDDEN ed-EventsName event-type rb-events b-user-sellect rb-cd ed-cd-names b-doc-select b-cd-mode-select b-dc-sellect rb-b-codes ed-b-codes v-bc-num v-h-start v-m-start v-h-end v-m-end v-summ-min v-summ-max v-qnty-min v-qnty-max v-disc-min v-disc-max v-disc-type WITH FRAME F-Main.
     1142       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     1143       RUN set-attribute-list ('ENABLED=yes':U).
     1144       RETURN.
     1145   END PROCEDURE.
     1146   PROCEDURE adm-exit :
     1147        RUN notify ('exit':U).
     1148     RETURN.
     1149   END PROCEDURE.
     1150   PROCEDURE adm-hide :
     1151     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1152   END PROCEDURE.
     1153   PROCEDURE adm-initialize :
     1154     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1155   END PROCEDURE.
     1156   PROCEDURE adm-show-errors :
     1157       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1158       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1159           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1160       END.
     1161       RETURN.
     1162   END PROCEDURE.
     1163   PROCEDURE adm-UIB-mode :
     1164     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1165   END PROCEDURE.
     1166   PROCEDURE adm-view :
     1167     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1168   END PROCEDURE.
     1169   PROCEDURE dispatch :
     1170       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1171       RUN broker-dispatch IN adm-broker-hdl
     1172           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1173       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1174   END PROCEDURE.
     1175   PROCEDURE ensure-broker :
     1176   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1177   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1178   DO:
     1179       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1180       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1181   END.
     1182   END PROCEDURE.
     1183   PROCEDURE get-attribute :
     1184     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1185     RUN broker-get-attribute IN adm-broker-hdl
     1186         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1187     RETURN RETURN-VALUE.
     1188   END PROCEDURE.
     1189   PROCEDURE get-attribute-list :
     1190     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1191     RUN broker-get-attribute-list IN adm-broker-hdl
     1192         (INPUT THIS-PROCEDURE,
     1193          INPUT ?,
     1194          OUTPUT p-attr-list) NO-ERROR.
     1195     RETURN.
     1196   END PROCEDURE.
     1197   PROCEDURE new-state :
     1198     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1199     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1200     RETURN.
     1201   END PROCEDURE.
     1202   PROCEDURE notify :
     1203     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1204     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1205     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1206         RETURN "ADM-ERROR":U.
     1207     RETURN.
     1208   END PROCEDURE.
     1209   PROCEDURE set-attribute-list :
     1210     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1211     RUN ensure-broker.
     1212     RUN broker-set-attribute-list IN adm-broker-hdl
     1213         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1214     RETURN.
     1215   END PROCEDURE.
     1216   PROCEDURE set-position :
     1217       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1218       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1219       IF VALID-HANDLE(adm-object-hdl) THEN
     1220       DO:
     1221         ASSIGN adm-object-hdl:ROW    =   p-row
     1222                adm-object-hdl:COLUMN =   p-col.
     1223       END.
     1224       RETURN.
     1225   END PROCEDURE.
     1226   PROCEDURE adm-display-fields :
     1227       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
     1228       RETURN.
     1229   END PROCEDURE.
     1230   PROCEDURE adm-open-query :
     1231     RETURN.
     1232   END PROCEDURE.
     1233   PROCEDURE adm-row-changed :
     1234         IF VALID-HANDLE(adm-object-hdl) THEN
     1235           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1236         RUN notify ('row-available':U).
     1237         RETURN.
     1238   END PROCEDURE.
     1239   PROCEDURE reposition-query :
     1240       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
     1241       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
     1242       RETURN.
     1243   END PROCEDURE.
     1244     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
     1245     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
     1246     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
     1247     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
     1248     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
     1249     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
     1250     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
     1251     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
     1252     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1253     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
     1254     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1255     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
     1256     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
     1257     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
     1258     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
     1259     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
     1260     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
     1261     IF "":U = "":U THEN
     1262       RUN modify-list-attribute IN adm-broker-hdl
     1263         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
     1264     RUN use-create-on-add(?).
     1265   PROCEDURE adm-add-record :
     1266       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1267          "must have at least one Enabled Table to perform Add.":U
     1268          VIEW-AS ALERT-BOX ERROR.
     1269       RETURN.
     1270   END PROCEDURE.
     1271   PROCEDURE adm-assign-record :
     1272    MESSAGE
     1273          "Object ":U THIS-PROCEDURE:FILE-NAME
     1274            "must have at least one Enabled Table to perform Assign.":U
     1275              VIEW-AS ALERT-BOX ERROR.
     1276      RETURN.
     1277     END PROCEDURE.
     1278   PROCEDURE adm-assign-statement :
     1279     RETURN.
     1280   END PROCEDURE.
     1281   PROCEDURE adm-cancel-record :
     1282      RETURN.
     1283     END PROCEDURE.
     1284   PROCEDURE adm-copy-record :
     1285       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1286        "must have at least one Enabled Table to perform Copy.":U
     1287          VIEW-AS ALERT-BOX ERROR.
     1288       RETURN.
     1289   END PROCEDURE.
     1290   PROCEDURE adm-create-record :
     1291      RETURN.
     1292   END PROCEDURE.
     1293   PROCEDURE adm-current-changed :
     1294     RETURN.
     1295   END PROCEDURE.
     1296   PROCEDURE adm-delete-record :
     1297    MESSAGE
     1298          "Object ":U THIS-PROCEDURE:FILE-NAME
     1299            "must have at least one Enabled Table to perform Delete.":U
     1300              VIEW-AS ALERT-BOX ERROR.
     1301       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
     1302       RETURN.
     1303   END PROCEDURE.
     1304   PROCEDURE adm-disable-fields :
     1305         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
     1306       RETURN.
     1307   END PROCEDURE.
     1308   PROCEDURE adm-enable-fields :
     1309       RETURN.
     1310   END PROCEDURE.
     1311   PROCEDURE adm-end-update :
     1312     RETURN.
     1313   END PROCEDURE.
     1314   PROCEDURE adm-reset-record :
     1315       RETURN.
     1316   END PROCEDURE.
     1317   PROCEDURE adm-update-record :
     1318       MESSAGE
     1319         "Object ":U THIS-PROCEDURE:FILE-NAME
     1320           "must have at least one Enabled Table to perform Update.":U
     1321             VIEW-AS ALERT-BOX ERROR.
     1322      RETURN.
     1323   END PROCEDURE.
     1324   PROCEDURE check-modified :
     1325   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1326   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1327   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1328   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1329     IF check-state = "check":U THEN
     1330     DO:
     1331       RUN get-link-handle IN adm-broker-hdl
     1332         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1333            OUTPUT group-target-list).
     1334       IF group-target-list NE "":U THEN
     1335       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1336         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1337         RUN check-modified IN curr-widget ('group-check':U).
     1338         IF RETURN-VALUE NE "":U THEN
     1339         DO:
     1340           RUN check-modified-message(RETURN-VALUE).
     1341           RETURN "":U.
     1342         END.
     1343       END.
     1344     END.
     1345     RETURN "":U.
     1346   END PROCEDURE.
     1347   PROCEDURE check-modified-message :
     1348     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1349        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1350           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1351        IF RETURN-VALUE = "YES":U THEN
     1352           RUN notify ('view,CONTAINER-SOURCE':U).
     1353        MESSAGE IF p-changed-table NE ? THEN
     1354           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1355           ELSE "Current values have been changed."
     1356           SKIP "  Do you wish to save those changes?"
     1357           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1358        IF ANS THEN
     1359        DO:
     1360           IF group-assign-target THEN
     1361             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1362           ELSE RUN dispatch('update-record':U).
     1363           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1364           DO:
     1365               MESSAGE "Changes to the previous record were not saved."
     1366                 VIEW-AS ALERT-BOX ERROR.
     1367               IF group-assign-target THEN
     1368                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1369               ELSE RUN dispatch ('cancel-record':U).
     1370           END.
     1371        END.
     1372        ELSE DO:
     1373          IF group-assign-target THEN
     1374             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1375          ELSE RUN dispatch('cancel-record':U).
     1376        END.
     1377        RETURN.
     1378   END PROCEDURE.
     1379   PROCEDURE get-rowid :
     1380       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1381       ASSIGN
     1382       p-table   =   adm-first-table.
     1383       RETURN.
     1384   END PROCEDURE.
     1385   PROCEDURE init-group-assign :
     1386       RUN request-attribute IN adm-broker-hdl
     1387         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1388       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1389         group-assign-target = yes.
     1390       ELSE group-assign-target = no.
     1391       RETURN.
     1392   END PROCEDURE.
     1393   PROCEDURE set-editors :
     1394       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1395       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1396       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1397       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1398       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1399       DO WHILE VALID-HANDLE (curr-widget):
     1400           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1401              curr-widget:HIDDEN = no THEN DO:
     1402             CASE p-field-setting:
     1403               WHEN "INITIALIZE":U THEN
     1404               DO:
     1405                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1406                     read-only-list +
     1407                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1408                        STRING(curr-widget).
     1409               END.
     1410               WHEN "DISABLE":U OR
     1411               WHEN "ENABLE":U THEN
     1412               DO:
     1413                   curr-widget:SENSITIVE = yes.
     1414                   RUN get-attribute ('Read-Only-Editors':U).
     1415                   IF RETURN-VALUE = ? OR
     1416                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1417                       curr-widget:READ-ONLY =
     1418                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1419               END.
     1420               WHEN "CLEAR":U THEN
     1421                   curr-widget:SCREEN-VALUE = "":U.
     1422             END CASE.
     1423           END.
     1424           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1425       END.
     1426       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1427         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1428           + '"':U).
     1429       RETURN.
     1430   END PROCEDURE.
     1431   PROCEDURE use-check-modified-all :
     1432    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1433     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1434     RETURN.
     1435   END PROCEDURE.
     1436   PROCEDURE use-create-on-add :
     1437   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1438      RETURN.
     1439   END PROCEDURE.
     1440   PROCEDURE use-initial-lock :
     1441     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1442     ASSIGN adm-initial-lock = p-attr-value.
     1443     RETURN.
     1444   END PROCEDURE.
     1445     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1446   ASSIGN
     1447          FRAME F-Main:SCROLLABLE                      = FALSE
     1448          FRAME F-Main:HIDDEN                          = TRUE.
     1449   ASSIGN
     1450          ed-b-codes:READ-ONLY IN FRAME F-Main         = TRUE.
     1451   ASSIGN
     1452          ed-cd-names:READ-ONLY IN FRAME F-Main        = TRUE.
     1453   ASSIGN
     1454          ed-EventsName:READ-ONLY IN FRAME F-Main      = TRUE.
     1455   ASSIGN
     1456          v-cd-supmode:READ-ONLY IN FRAME F-Main       = TRUE.
     1457   ASSIGN
     1458          v-dc-num:READ-ONLY IN FRAME F-Main           = TRUE.
     1459   ASSIGN
     1460          v-doc-num:READ-ONLY IN FRAME F-Main          = TRUE.
     1461   ASSIGN
     1462          v-user-name:READ-ONLY IN FRAME F-Main        = TRUE.
     1463   ON CHOOSE OF b-cd-mode-select IN FRAME F-Main
     1464   DO:
     1465      define variable v-rid    as character    no-undo.
     1466      define buffer buf_wi-mode     for ub.wi-mode .
     1467      run adm/wi-modes.w   ( INPUT parparentproc
     1468                           , INPUT 'b-sel':U
     1469                           , input 'все':U
     1470                           , input ""
     1471                           , INPUT-OUTPUT v-rid
     1472                           ) NO-ERROR.
     1473      if v-rid = ""
     1474      then do:
     1475         RETURN.
     1476      end.
     1477      find first buf_wi-mode
     1478         where recid( buf_wi-mode ) = INTEGER(ENTRY(1, v-rid))
     1479         NO-LOCK
     1480         no-error.
     1481      IF AVAILABLE buf_wi-mode THEN DO:
     1482         ASSIGN
     1483            v-supmode-id =  buf_wi-mode.mode-id
     1484            v-cd-supmode =  buf_wi-mode.mode-name
     1485         .
     1486      END.
     1487      Display
     1488         v-cd-supmode
     1489      with frame F-Main
     1490      .
     1491   END.
     1492   ON CHOOSE OF b-dc-sellect IN FRAME F-Main
     1493   DO:
     1494      define variable v-rid    as character    no-undo.
     1495      define buffer buf_dis-card    for ub.dis-card .
     1496      run ref/discards.w
     1497         ( parParentProc
     1498         , "b-sel"
     1499         , 'все':U
     1500         , v-cntxt-host-code-obj
     1501         , v-cntxt-obj-type
     1502         , v-cntxt-obj-code
     1503         , ?
     1504         , ?
     1505         , output v-rid
     1506         ) .
     1507      if v-rid = ""
     1508      then do:
     1509         RETURN.
     1510      end.
     1511      find first buf_dis-card
     1512         where recid( buf_dis-card ) = INTEGER(ENTRY(1, v-rid))
     1513         NO-LOCK
     1514         no-error.
     1515      IF AVAILABLE buf_dis-card THEN DO:
     1516         ASSIGN
     1517            v-dc-num = STRING(buf_dis-card.d-card)
     1518         .
     1519      END.
     1520      Display
     1521         v-dc-num
     1522      with frame F-Main
     1523      .
     1524   END.
     1525   ON CHOOSE OF b-doc-select IN FRAME F-Main
     1526   DO:
     1527      define variable v-rid    as character    no-undo.
     1528      define buffer buf_chk-doc     for ub.chk-doc .
     1529      run str/chk-docs.w   ( input parparentproc
     1530                           , input "b-sel,b-mark"
     1531                           , input 'объект':U
     1532                           , input ?
     1533                           , input v-cntxt-obj-type
     1534                           , input v-cntxt-obj-code
     1535                           , input '':U
     1536                           , input '':U
     1537                           , input 0
     1538                           , input ?
     1539                           , input ?
     1540                           , input 0
     1541                           , output v-rid
     1542                           ) NO-ERROR.
     1543      IF v-rid = "":U
     1544      THEN DO:
     1545         RETURN.
     1546      END.
     1547      FIND FIRST buf_chk-doc
     1548         where RECID(buf_chk-doc) = INTEGER(ENTRY(1, v-rid))
     1549         no-lock
     1550         NO-ERROR
     1551         .
     1552      IF AVAILABLE buf_chk-doc
     1553      THEN DO:
     1554         ASSIGN
     1555            v-doc-num = buf_chk-doc.doc-code
     1556         .
     1557      END.
     1558      Display
     1559         v-doc-num
     1560      with frame F-Main
     1561      .
     1562   END.
     1563   ON CHOOSE OF b-user-sellect IN FRAME F-Main
     1564   DO:
     1565      define buffer buf_user-account      for ub.user-account .
     1566      define variable v-accepted      as logical      no-undo.
     1567      run onewin_clear in this-procedure.
     1568      for each buf_user-account
     1569      :
     1570         run onewin_add-item in this-procedure ( input buf_user-account.user-id
     1571                                               , input substitute ( "&1 &2 &3 (&4)"
     1572                                                                  , buf_user-account.last-Name
     1573                                                                  , buf_user-account.first-Name
     1574                                                                  , buf_user-account.second-Name
     1575                                                                  , buf_user-account.user-id
     1576                                                                  )
     1577                                               , input substitute ( "&1 &2 &3 (&4)"
     1578                                                                  , buf_user-account.last-Name
     1579                                                                  , buf_user-account.first-Name
     1580                                                                  , buf_user-account.second-Name
     1581                                                                  , buf_user-account.user-id
     1582                                                                  )
     1583                                               , input no
     1584                                             ).
     1585      end.
     1586      run gbl/onewin.w  ( input my-handle
     1587                        , input  0
     1588                        , input  "Список пользователей"
     1589                        , input  "":U
     1590                        , input  "&Тест"
     1591                        , input  table temp_onewin_items
     1592                        , output table temp_onewin_itemsSelected
     1593                        , output v-user-id
     1594                        , output v-accepted
     1595                        ) .
     1596       if v-accepted then do:
     1597           find first buf_user-account where buf_user-account.user-id = v-user-id
     1598                                       no-error.
     1599               assign v-user-name = buf_user-account.last-Name
     1600               .
     1601           display v-user-name with frame F-Main.
     1602       end.
     1603   END.
     1604   ON VALUE-CHANGED OF rb-b-codes IN FRAME F-Main
     1605   DO:
     1606      ASSIGN
     1607         rb-b-codes
     1608      .
     1609      CASE rb-b-codes :
     1610         when 1
     1611         then DO:
     1612             Assign
     1613               ed-b-codes
     1614               v-b-codes   = ed-b-codes
     1615               ed-b-codes  = 'все':U
     1616               ed-b-codes:READ-ONLY = TRUE
     1617             .
     1618         END.
     1619         when 2
     1620         then DO:
     1621            Assign
     1622               ed-b-codes     = v-b-codes
     1623               ed-b-codes:READ-ONLY = FALSE
     1624            .
     1625         END.
     1626         OTHERWISE DO:
     1627         END.
     1628      END CASE.
     1629      Display
     1630         ed-b-codes
     1631      with frame F-Main
     1632      .
     1633      APPLY "ENTRY" TO ed-b-codes.
     1634   END.
     1635   ON VALUE-CHANGED OF rb-cd IN FRAME F-Main
     1636   DO:
     1637      define buffer buf_cash-desk      for ub.cash-desk .
     1638      ASSIGN
     1639         rb-cd
     1640      .
     1641      CASE rb-cd :
     1642         when 1
     1643         then DO:
     1644             Assign
     1645               ed-cd-names = 'все':U
     1646               cd_recids = "":U
     1647             .
     1648             Display
     1649               ed-cd-names
     1650             with frame F-Main
     1651             .
     1652             FOR EACH  buf_cash-desk
     1653                 NO-LOCK
     1654                 :
     1655                     ASSIGN
     1656                        cd_recids = IF cd_recids = "":U THEN STRING(RECID(buf_cash-desk))
     1657                                                        ELSE cd_recids + "," + STRING(RECID(buf_cash-desk))
     1658                     .
     1659             END.
     1660          END.
     1661         when 2
     1662         then DO:
     1663            define variable v-rec    as recid        no-undo.
     1664            IF x-SelectObject = STRING(2)
     1665            THEN DO:
     1666               run ref/cashlist.w   ( INPUT my-handle
     1667                                    , INPUT "b-sel,b-mark":U
     1668                                    , INPUT 'объект':U
     1669                                    , INPUT 0
     1670                                    , INPUT 0
     1671                                    , INPUT v-cntxt-obj-type
     1672                                    , INPUT v-cntxt-obj-code
     1673                                    , INPUT v-rec
     1674                                    , output cd_recids
     1675                                    ) .
     1676            END.
     1677            ELSE DO:
     1678               run ref/cashlist.w   ( INPUT my-handle
     1679                                    , INPUT "b-sel,b-mark":U
     1680                                    , INPUT 'все':U
     1681                                    , INPUT 0
     1682                                    , INPUT 0
     1683                                    , INPUT v-cntxt-obj-type
     1684                                    , INPUT v-cntxt-obj-code
     1685                                    , INPUT v-rec
     1686                                    , output cd_recids
     1687                                    ) .
     1688            END.
     1689            if cd_recids = ""
     1690            then do:
     1691               Assign
     1692                  ed-cd-names = 'все':U
     1693                  rb-cd = 1
     1694               .
     1695               Display
     1696                  ed-cd-names
     1697                  rb-cd
     1698               with frame F-Main
     1699               .
     1700               end.
     1701               else do:
     1702               Assign
     1703                  ed-cd-names = "":U
     1704               .
     1705               DO ii = 1 TO num-entries( cd_recids ) :
     1706                  FIND FIRST buf_cash-desk
     1707                       WHERE recid( buf_cash-desk ) = int(entry( ii, cd_recids ))
     1708                       NO-LOCK
     1709                       .
     1710                  ASSIGN
     1711                     ed-cd-names = ed-cd-names
     1712                                 + SUBSTITUTE ( "Маг. &1 &2 &3"
     1713                                              , buf_cash-desk.obj-code
     1714                                              , buf_cash-desk.pos-type
     1715                                              , buf_cash-desk.cash-num
     1716                                              )
     1717                                 + chr(10)
     1718                  .
     1719                  END.
     1720               Display
     1721                  ed-cd-names
     1722               with frame F-Main
     1723               .
     1724               end.
     1725         END.
     1726         OTHERWISE DO:
     1727         END.
     1728      END CASE.
     1729     END.
     1730   ON VALUE-CHANGED OF rb-events IN FRAME F-Main
     1731   DO:
     1732      define buffer buf_cd-events      for ub.cd-events .
     1733      define variable v-ok    as logical      no-undo.
     1734      ASSIGN
     1735         rb-events
     1736      .
     1737      CASE rb-events :
     1738         when 1
     1739         then DO:
     1740             Assign
     1741               ed-EventsName = 'все':U
     1742               events_recids = "":U
     1743             .
     1744             Display
     1745               ed-EventsName
     1746             with frame F-Main
     1747             .
     1748             FOR EACH  buf_cd-events
     1749                 NO-LOCK
     1750                 :
     1751                     ASSIGN
     1752                        events_recids = IF events_recids = "":U THEN STRING(recid(buf_cd-events))
     1753                                                                ELSE events_recids + "," + STRING(recid(buf_cd-events))
     1754                     .
     1755             END.
     1756         END.
     1757         when 2
     1758         then DO:
     1759            run ref/cd-event.w  ( INPUT my-handle
     1760                                , INPUT "b-mark"
     1761                                , input-output events_recids
     1762                                , OUTPUT v-ok
     1763                                 ) .
     1764            if events_recids = ""
     1765            OR NOT v-ok
     1766            then do:
     1767               Assign
     1768                  ed-EventsName = 'все':U
     1769                  rb-events = 1
     1770               .
     1771               Display
     1772                  ed-EventsName
     1773                  rb-events
     1774               with frame F-Main
     1775               .
     1776            end.
     1777            else do:
     1778               Assign
     1779                  ed-EventsName = "":U
     1780               .
     1781               DO ii = 1 TO num-entries( events_recids ) :
     1782                  FIND FIRST buf_cd-events
     1783                       WHERE recid( buf_cd-events ) = int(entry( ii, events_recids ))
     1784                       NO-LOCK
     1785                       .
     1786               ASSIGN
     1787                     ed-EventsName = ed-EventsName + buf_cd-events.event-name + chr(10)
     1788                  .
     1789               END.
     1790               Display
     1791                  ed-EventsName
     1792               with frame F-Main
     1793      .
     1794            end.
     1795         END.
     1796         OTHERWISE DO:
     1797         END.
     1798      END CASE.
     1799   END.
     1800   ON LEAVE OF v-bc-num IN FRAME F-Main
     1801   DO:
     1802     ASSIGN
     1803       v-bc-num
     1804     .
     1805   END.
     1806   ON LEAVE OF v-disc-max IN FRAME F-Main
     1807   DO:
     1808       ASSIGN
     1809       v-disc-max
     1810       v-disc-min
     1811     .
     1812     IF v-disc-max < v-disc-min
     1813     THEN DO:
     1814         message
     1815            "Неправильно указаны границы диапазона"
     1816            skip
     1817         view-as alert-box error.
     1818         RETURN NO-APPLY.
     1819     END.
     1820   END.
     1821   ON VALUE-CHANGED OF v-disc-type IN FRAME F-Main
     1822   DO:
     1823     ASSIGN
     1824       v-disc-type
     1825     .
     1826   END.
     1827   ON LEAVE OF v-h-end IN FRAME F-Main
     1828   DO:
     1829         ASSIGN
     1830        v-h-end
     1831      .
     1832      RUN mandatory-24 IN THIS-PROCEDURE
     1833         (INPUT-OUTPUT v-h-end ) .
     1834      ASSIGN
     1835         v-time-end = v-h-end * 60 * 60 + v-m-end * 60
     1836      .
     1837      display v-h-end  with frame F-Main .
     1838   END.
     1839   ON LEAVE OF v-h-start IN FRAME F-Main
     1840   DO:
     1841       ASSIGN
     1842        v-h-start
     1843      .
     1844      RUN mandatory-24 IN THIS-PROCEDURE
     1845         (INPUT-OUTPUT v-h-start ) .
     1846      ASSIGN
     1847         v-time-start = v-h-start * 60 * 60 + v-m-start * 60
     1848      .
     1849      display v-h-start  with frame F-Main .
     1850   END.
     1851   ON LEAVE OF v-m-end IN FRAME F-Main
     1852   DO:
     1853          ASSIGN
     1854        v-m-end
     1855      .
     1856      RUN mandatory-60 IN THIS-PROCEDURE
     1857         (INPUT-OUTPUT v-m-end ) .
     1858      ASSIGN
     1859           v-time-end = v-h-end * 60 * 60 + v-m-end * 60
     1860      .
     1861      display v-m-end  with frame F-Main .
     1862   END.
     1863   ON LEAVE OF v-m-start IN FRAME F-Main
     1864   DO:
     1865        ASSIGN
     1866        v-m-start
     1867      .
     1868      RUN mandatory-60 IN THIS-PROCEDURE
     1869         (INPUT-OUTPUT v-m-start ) .
     1870      ASSIGN
     1871           v-time-start = v-h-start * 60 * 60 + v-m-start * 60
     1872      .
     1873      display v-m-start  with frame F-Main .
     1874   END.
     1875   ON LEAVE OF v-qnty-max IN FRAME F-Main
     1876   DO:
     1877      ASSIGN
     1878       v-qnty-max
     1879       v-qnty-min
     1880     .
     1881     IF v-qnty-max < v-qnty-min
     1882     THEN DO:
     1883         message
     1884            "Неправильно указаны границы диапазона"
     1885            skip
     1886         view-as alert-box error.
     1887         RETURN NO-APPLY .
     1888     END.
     1889   END.
     1890   ON LEAVE OF v-summ-max IN FRAME F-Main
     1891   DO:
     1892     ASSIGN
     1893       v-summ-max
     1894       v-summ-min
     1895     .
     1896     IF v-summ-max < v-summ-min
     1897     THEN DO:
     1898         message
     1899            "Неправильно указаны границы диапазона"
     1900            skip
     1901         view-as alert-box error.
     1902         RETURN NO-APPLY .
     1903     END.
     1904   END.
     1905   if not this-procedure :persistent
     1906   then do:
     1907     message
     1908       vss-workfile vss-revision vss-description skip
     1909       "Ошибка при запуске процедуры" skip
     1910       "Данную процедуру следует запускать только с параметром persistent" skip
     1911       view-as alert-box error .
     1912     undo, return error .
     1913   end.
     1914      assign
     1915         parparentproc = my-handle
     1916      .
     1917      DISPLAY
     1918         event-type
     1919         v-disc-type
     1920         v-h-start v-m-start v-h-end v-m-end
     1921      with frame F-Main.
     1922   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1923     run mainmenu_getcntxt in parparentproc
     1924       (output v-cntxt-db-num
     1925       ,output v-cntxt-userid
     1926       ,output v-cntxt-level
     1927       ,output v-cntxt-host-code-obj
     1928       ,output v-cntxt-obj-type
     1929       ,output v-cntxt-obj-code
     1930       ,output v-cntxt-db-num-obj
     1931       ,output v-cntxt-is-admin
     1932       ) .
     1933   PROCEDURE disable_UI :
     1934     HIDE FRAME F-Main.
     1935     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1936   END PROCEDURE.
     1937   PROCEDURE local-initialize :
     1938     RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     1939   END PROCEDURE.
     1940   PROCEDURE mandatory-24 :
     1941   DEFINE INPUT-OUTPUT PARAMETER p-time AS INTEGER NO-UNDO .
     1942   DO
     1943   ON error undo, RETURN:
     1944      IF p-time > 23 THEN DO:
     1945          ASSIGN
     1946              p-time = 23
     1947          .
     1948          RETURN .
     1949      END.
     1950      IF p-time < 0 THEN DO:
     1951          ASSIGN
     1952              p-time = 0
     1953          .
     1954          RETURN .
     1955      END.
     1956   END.
     1957   END PROCEDURE.
     1958   PROCEDURE mandatory-60 :
     1959   DEFINE INPUT-OUTPUT PARAMETER p-time AS INTEGER NO-UNDO .
     1960   DO
     1961   ON error undo, RETURN:
     1962      IF p-time > 59 THEN DO:
     1963          ASSIGN
     1964              p-time = 59
     1965          .
     1966          RETURN .
     1967      END.
     1968      IF p-time < 0 THEN DO:
     1969          ASSIGN
     1970              p-time = 0
     1971          .
     1972          RETURN .
     1973      END.
     1974   END.
     1975   END PROCEDURE.
     1976   PROCEDURE my-report :
     1977   FIND FIRST tmp#grp NO-ERROR.
     1978    DO WITH frame F-Main:
     1979      ASSIGN
     1980         event-type
     1981         rb-events
     1982         rb-cd
     1983         rb-b-codes
     1984         ed-b-codes
     1985         v-bc-num v-h-start v-m-start v-h-end v-m-end
     1986         v-summ-min v-summ-max
     1987         v-qnty-min v-qnty-max
     1988         v-disc-min v-disc-max
     1989         v-disc-type
     1990      .
     1991    END.
     1992   IF x-SelectObject = "currency":U
     1993   THEN DO:
     1994      define variable v-new-rec     as character    no-undo .
     1995      define variable v-new-name    as character    no-undo .
     1996      define variable v-err         as logical      no-undo .
     1997      define buffer buf_cash-desk      for ub.cash-desk .
     1998      FIND FIRST obj-list .
     1999      DO ii = 1 TO num-entries( cd_recids ) :
     2000         FIND FIRST buf_cash-desk
     2001               WHERE recid( buf_cash-desk ) = int(entry( ii, cd_recids ))
     2002               NO-LOCK
     2003               .
     2004         IF buf_cash-desk.obj-code = obj-list.obj-code
     2005         THEN DO:
     2006            ASSIGN
     2007               v-new-rec  = IF v-new-rec = "":U THEN STRING(RECID(buf_cash-desk))
     2008                                                ELSE v-new-rec + "," + STRING(RECID(buf_cash-desk))
     2009               v-new-name = v-new-name
     2010                           + SUBSTITUTE ( "Маг. &1 &2 &3"
     2011                                          , buf_cash-desk.obj-code
     2012                                          , buf_cash-desk.pos-type
     2013                                          , buf_cash-desk.cash-num
     2014                                          )
     2015                           + chr(10)
     2016            .
     2017         END.
     2018         ELSE DO:
     2019            ASSIGN
     2020               v-err = TRUE
     2021            .
     2022         END.
     2023      END.
     2024      IF v-err
     2025      THEN DO:
     2026         ASSIGN
     2027            cd_recids   = v-new-rec
     2028            ed-cd-names = v-new-name
     2029         .
     2030         Display
     2031            ed-cd-names
     2032         with frame F-Main.
     2033         message
     2034            "Выбранные кассы не принадлежат текущему объекту"
     2035            skip "Список был ограничен."
     2036         view-as alert-box information.
     2037         RETURN.
     2038      END.
     2039   end.
     2040    IF rb-b-codes = 1
     2041    THEN DO:
     2042      ASSIGN
     2043         v-b-codes = "":U
     2044      .
     2045    END.
     2046    else do:
     2047      ASSIGN
     2048         v-b-codes = ed-b-codes
     2049      .
     2050    end.
     2051   ASSIGN
     2052         v-time-start = v-h-start * 60 * 60 + v-m-start * 60
     2053   .
     2054   ASSIGN
     2055         v-time-end = v-h-end * 60 * 60 + v-m-end * 60
     2056   .
     2057    run rep/r-evlog.p ( INPUT my-handle
     2058                      , INPUT events_recids
     2059                      , INPUT cd_recids
     2060                      , INPUT v-user-id
     2061                      , INPUT v-time-start
     2062                      , INPUT v-time-end
     2063                      , INPUT event-type
     2064                      , INPUT v-supmode-id
     2065                      , INPUT v-doc-num
     2066                      , INPUT v-b-codes
     2067                      , INPUT v-summ-min
     2068                      , INPUT v-summ-max
     2069                      , INPUT v-qnty-min
     2070                      , INPUT v-qnty-max
     2071                      , INPUT v-dc-num
     2072                      , INPUT v-bc-num
     2073                      , INPUT v-disc-type
     2074                      , INPUT v-disc-min
     2075                      , INPUT v-disc-max
     2076                      ) .
     2077   END PROCEDURE.
     2078   PROCEDURE my-var :
     2079   END PROCEDURE.
     2080   PROCEDURE state-changed :
     2081     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     2082     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     2083     CASE p-state:
     2084     END CASE.
     2085     END PROCEDURE.
