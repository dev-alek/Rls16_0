     3713                find first goods where  ub.ot-line.prod-type = goods.prod-type and
     3714                                          ub.ot-line.prod-code = goods.prod-code and
     3715                                          ub.ot-line.artic     = goods.artic no-lock no-error .
     3716                f-cost-sum-novat = f-cost-sum - f-cost-vat .
     3717                f-disc = f-sale-sum - f-sale-vat - f-sale-slt - f-cost-sum-novat.
     3718                f-disc-prc = (f-disc / f-cost-sum-novat * 100)  .
     3719                if itog = false
     3720                   AND NOT (f-qnty=0 and f-crsa-sum =0  and f-sale-sum =0  and  f-cost-sum =0  and  f-disc =0  )
     3721                   Then DO:
     3722                   n-nn = n-nn + 1.
     3723     if c-nn <>  ?  then do :
