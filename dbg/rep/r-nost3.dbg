     6050       c-f-disc:DATA-TYPE = l1f-disc
     6051       c-f-disc:FORMAT    = l2f-disc.
     6052   End.
     6053   if c-f-disc-prc <>  ?  then do :
     6054   Assign
     6055       c-f-disc-prc:DATA-TYPE = l1f-disc-prc
     6056       c-f-disc-prc:FORMAT    = l2f-disc-prc.
