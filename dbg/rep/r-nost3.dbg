     5864   PROCEDURE foreach5 :
     5865   IF ( n-nm modulo v-account = 0 )  then DO:
     5866    Assign
     5867       v-kol-spice = (50 - LENGTH(reportname)) / 2
     5868       RecordsString = fill(' ',v-kol-spice) + string(reportname)
     5869       .
     5870    Assign
     5871       v-kol-spice = (50 - LENGTH(objname)) / 2
     5872       RecordsString2 = fill(' ',v-kol-spice) + string(objname)
     5873       .
     5874             if  log-manager:logfile-name ne ?
     5875             then DO:
     5876                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     5877             end.
     5878              if mFrameView
     5879              then do:
     5880               DISPLAY
     5881                 n-nm @ RecordsDone
     5882                 RecordsString   @ RecordsString
     5883                 RecordsString2  @ RecordsString2
     5884                 WITH FRAME InfoFrame.
     5885              end.
     5886   End.
     5887      if v-button-stop then  DO:
     5888            if mFrameView
     5889            then
     5890               PROCESS EVENTS.
     5891            IF StopProcessing THEN DO:
     5892            RETURN error.
     5893            End.
     5894      end.
     5895      Assign
     5896       ff-qnty           = 0
     5897       ff-crsa-sum       = 0
     5898       ff-sale-sum       = 0
     5899       ff-cost-sum       = 0
     5900       ff-cost-vat       = 0
     5901       ff-cost-sum-novat = 0
     5902       ff-sale-vat       = 0
     5903       ff-sale-slt       = 0
     5904       ff-sale-other     = 0
     5905       ff-disc           = 0
     5906       ff-disc-prc       = 0
     5907       .
     5908     For each obj-list no-lock break by obj-list.obj-type by obj-list.obj-code
     5909      with FRAME Zapas :
     5910         if NOT (itog = true and classify = 1) Then DO :
     5911     if c-f-gds-name <>  ?  then do :
