     2976             , First gds-list where  ub.ot-line.prod-type = gds-list.prod-type and
     2977                                     ub.ot-line.prod-code = gds-list.prod-code and
     2978                                     ub.ot-line.artic     = gds-list.artic no-lock
     2979               break
     2980                   by ( ub.ot-line.artic + ub.ot-line.prod-type + string ( ub.ot-line.prod-code ))
     2981                   by ub.ot-line.prod-type By ub.ot-line.prod-code by ub.ot-line.artic
     2982                   by ub.ot-line.sum-type
     2983                   with FRAME Zapas :
     2984             accumulate ub.ot-line.fact-qnty  (TOTAL BY ub.ot-line.sum-type ).
     2985             accumulate ub.ot-line.sum-rubl    (TOTAL BY ub.ot-line.sum-type ).
     2986             accumulate ub.ot-line.vat-rubl   (TOTAL BY ub.ot-line.sum-type ).
