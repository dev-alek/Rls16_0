     5744     run u-line.
     5745     if Make-Excel then  put   stream ForExcel unformatted
     5746             "ИТОГО"                                             CHR(9)
     5747             "по объекту"                                        CHR(9)
     5748             obj-list.obj-name                                   CHR(9)
     5749             excel-qnty(accum TOTAL by obj-list.obj-code ff-qnty          )  CHR(9)
