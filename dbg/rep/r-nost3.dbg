     5993       l2f-disc-prc  = c-f-disc-prc:FORMAT
     5994       c-f-disc-prc:DATA-TYPE = "CHARACTER"
     5995       c-f-disc-prc:FORMAT    = "x(" + string(C-f-disc-prc:WIDTH-CHARS) + ")"
     5996       c-f-disc-prc:screen-value = string('')  .
     5997   End.
     5998   if c-f-qnty <>  ?  then do :
     5999   Assign
     6000       l1f-qnty  = c-f-qnty:DATA-TYPE
     6001       l2f-qnty  = c-f-qnty:FORMAT
     6002       c-f-qnty:DATA-TYPE = "CHARACTER"
