     2989             if last-of(ub.ot-line.sum-type) then DO :
     2990             Case  ub.ot-line.sum-type :
     2991                 when 'cost':U then do:
     2992                   f-cost-sum = accum TOTAL BY ub.ot-line.sum-type ub.ot-line.sum-rubl .
     2993                   f-cost-vat = accum TOTAL BY ub.ot-line.sum-type ub.ot-line.vat-rubl .
     2994                 end.
