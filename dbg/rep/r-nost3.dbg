     1378        FGCOLOR 1  NO-UNDO.
     1379   DEFINE RECTANGLE RECT-1
     1380        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1381        SIZE 55.13 BY 4.46.
     1382   DEFINE FRAME InfoFrame
     1383        StopBtn AT ROW 4.25 COL 21.75
     1384        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     1385        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     1386        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     1387        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     1388        RECT-1 AT ROW 1 COL 1
     1389       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1390            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1391            TITLE "Процесс"
     1392            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     1393   define variable mFrameView      as logical   no-undo init yes.
     1394     define variable mFramHandle as handle no-undo.
     1395     mFramHandle = frame InfoFrame:handle.
     1396     if  log-manager:logfile-name ne ?
     1397     then DO:
     1398         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1399         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1400         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     1401     end.
     1402     mFrameView = not session:batch-mode and mFramHandle:visible.
     1403     if mFrameView
     1404     then do:
     1405       ASSIGN
     1406          FRAME InfoFrame:HIDDEN                           = TRUE
     1407          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     1408     end.
     1409   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     1410   DO:
     1411     IF not StopProcessing THEN
     1412       Message "Вы действительно хотите прервать" SKIP
     1413               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     1414                 UPDATE StopProcessing.
     1415     IF StopProcessing THEN do:
     1416        if mFrameView
     1417        then do:
     1418           HIDE FRAME InfoFrame.
     1419        end.
     1420     End.
     1421   END.
     1422   assign v-account = ( if integer( 100 ) = 0 then 100 else integer( 100 ) ).
     1423     if  log-manager:logfile-name ne ?
     1424     then DO:
     1425         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     1426     end.
     1427     if not session:batch-mode then
     1428     do:
     1429       VIEW FRAME InfoFrame.
     1430       mFrameView = true.
     1431     end.
     1432      v-button-stop = false .
     1433         if mFrameView
     1434         then do:
     1435         if v-button-stop then view STOPBTN in frame InfoFrame.
     1436                          else Hide STOPBTN in frame InfoFrame.
     1437         end.
     1438   def  var l-col-type         as character no-undo .
     1439   def  var l-col-pos          as integer no-undo .
     1440   def  var l-row-pos           as integer no-undo init 1.
     1441   def  var l-col-len          as integer no-undo .
     1442   def  var l-col-format       as character no-undo .
     1443   def  var l-col-lable        as character no-undo .
     1444   DEFINE VARIABLE t-1 AS CHARACTER INITIAL "||||"
     1445        VIEW-AS EDITOR
     1446        SIZE 1 BY 4 NO-UNDO.
     1447   DEFINE FRAME top-frame
     1448       t-1       AT ROW 1 COL 1 no-label
     1449       HEADER
     1450           cur-time-print() AT 5 format "X(35)"
     1451           "Цены указаны в" (if tPrintRubl then "РУБ" else x-base-type )
     1452           string( "Страница " + string( PAGE-NUMBER( OutStream ), ">>>>>>9") ) AT 110 format "X(16)" SKIP
     1453        WITH 300 DOWN stream-io
     1454            NO-UNDERLINE use-text NO-BOX no-label
     1455            AT COL 1 ROW 1
     1456            SIZE 300 BY 35  .
     1457   DEFINE FRAME zapas
     1458      with width 300 down stream-io use-text NO-BOX no-label.
     1459   CREATE WIDGET-POOL "My-pool" PERSISTENT no-error .
     1460   l-col-pos = 1.
     1461   Assign l-col-type="CHARACTER" l-col-len=6  l-col-format= "X(6)"         l-col-lable="N/N"                      .
