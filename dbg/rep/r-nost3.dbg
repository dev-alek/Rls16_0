     6063         End.
     6064             n-nn = 0.
     6065             n-no = n-no + 1 .
     6066    For Each ub.ot-line where
     6067             ub.ot-line.fact-order <= fact-order-2 and
     6068             ub.ot-line.fact-order >= fact-order-1 and
     6069             ub.ot-line.obj-code    = obj-list.obj-code and
     6070             ub.ot-line.obj-type    = obj-list.obj-type and
     6071             (
     6072             ub.ot-line.sum-type    = string('sale':U) + String('')
     6073             OR
     6074             ub.ot-line.sum-type    =
     6075              'sasr':U + String('')
     6076             )
     6077             no-lock ,
     6078             First tdedt where ub.ot-line.ext-doc-type   = tdedt.id  no-lock
     6079             , First gds-list where  ub.ot-line.prod-type = gds-list.prod-type and
     6080                                     ub.ot-line.prod-code = gds-list.prod-code and
     6081                                     ub.ot-line.artic     = gds-list.artic no-lock
     6082               break
     6083                   by   entry(2,ub.ot-line.cat-id)
     6084                   by ( ub.ot-line.artic + ub.ot-line.prod-type + string ( ub.ot-line.prod-code ))
     6085                   by ub.ot-line.prod-type By ub.ot-line.prod-code by ub.ot-line.artic
     6086                   with FRAME Zapas :
     6087               accumulate ub.ot-line.fact-qnty     (TOTAL by  ub.ot-line.artic ) .
