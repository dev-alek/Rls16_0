     2371      FIND first ub.clients where x-store-type = ub.clients.obj-type AND
     2372               x-store-code = ub.clients.obj-code no-lock no-error.
     2373              If available ub.clients then  ObjName = ub.clients.obj-name.
     2374                                            else  ObjName="объект не определен".
     2375        assign
     2376           i             = 0
     2377           startdate     = x-date-start
     2378           enddate       = x-date-end
     2379           PayType       = x-SET_PAY_TYPE
     2380           ValType       = IF (PayType = 1) Then 0  else x-SET_val_TYPE.
     2381           run report-execute.
     2382   function excel-format-dec-to-char returns char (input p-dec as decimal ).
     2383     if num-entries(string(p-dec), '.') = 2
     2384       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
     2385       else return( string(p-dec)) .
     2386   end function.
     2387   function format-point-to-comma returns char (input orig as char ) .
     2388   define variable rtext as character no-undo .
     2389   define variable strt as integer no-undo .
     2390   define variable leng as integer no-undo .
     2391   assign rtext = orig .
     2392   repeat:
     2393     strt =  index(rtext,'.').
     2394     if strt = 0 then leave.
     2395     leng = 1.
     2396     substring(rtext,strt,leng,"character") = v-delim .
     2397   end.
     2398   return rtext.
     2399   end function.
     2400   function format-excel-text returns char ( input start-text as char ) :
     2401   def var  i    as int no-undo.
     2402   def var  ch   as char no-undo.
     2403   def var  n    as int no-undo.
     2404   def var  ipos as int no-undo.
     2405     n = num-entries(trim(start-text), chr(10)) - 1 .
     2406     do i = 1 to n :
     2407       ipos = index( start-text, chr(10)).
     2408       if ipos > 0 then
     2409         substr( start-text, ipos, 1 ) = ' '.
     2410     end.
     2411     n = num-entries(trim(start-text), chr(13)) - 1 .
     2412     do i = 1 to n :
     2413       ipos = index( start-text, chr(13)).
     2414       if ipos > 0 then
     2415         substr( start-text, ipos, 1 ) = ' '.
     2416     end.
     2417     if index( start-text, '"' ) = 0 then
     2418       start-text =  '="'   + trim( start-text) + '"'   .
     2419       else do:
     2420         n = num-entries(trim(start-text), '"') - 1.
     2421         do i = 1 to n :
     2422           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     2423         end.
     2424         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     2425         start-text = '="'  + ch  + '"' .
     2426       end.
     2427     return start-text.
     2428   end.
     2429   function excel-sum returns char (input p-dec as decimal ).
     2430     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
     2431   end function.
     2432   function excel-qnty returns char (input p-dec as decimal ).
     2433     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
     2434   end function.
     2435   function format-excel-text-macr returns char ( input start-text as char ) :
     2436   def var  i    as int no-undo.
     2437   def var  ch   as char no-undo.
     2438   def var  n    as int no-undo.
     2439   def var  ipos as int no-undo.
     2440     n = num-entries(trim(start-text), chr(10)) - 1 .
     2441     do i = 1 to n :
     2442       ipos = index( start-text, chr(10)).
     2443       if ipos > 0 then
     2444         substring( start-text, ipos , 1 ) = ' '.
     2445     end.
     2446     n = num-entries(trim(start-text), chr(13)) - 1 .
     2447     do i = 1 to n :
     2448       ipos = index( start-text, chr(13)).
     2449       if ipos > 0 then
     2450         substring( start-text, ipos, 1 ) = ' '.
     2451     end.
     2452     if index( start-text, '"' ) = 0 then
     2453       start-text =  '"'   + trim( start-text) + '"'   .
     2454       else do:
     2455         n = num-entries(trim(start-text), '"') - 1.
     2456         do i = 1 to n :
     2457           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     2458         end.
     2459         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     2460         start-text = '"'  + ch  + '"' .
     2461       end.
     2462     n = num-entries(trim(start-text), chr(10)) - 1 .
     2463     do i = 1 to n :
     2464       ipos = index( start-text, chr(10)).
     2465       if ipos > 0 then
     2466         substring( start-text, ipos , 1 ) = ' '.
     2467     end.
     2468       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
     2469     return start-text.
     2470   end.
     2471   PROCEDURE report-execute :
     2472     If (ValType=0 and x-base-code=0)  Or ValType=1
     2473                                   then   assign tPrintRubl = yes .
     2474                                   else   assign tPrintRubl = no .
     2475      NO-PRISE = true .
     2476     if var-report-r-b = "rubl"  Then do:
     2477       if  x-base-code <> 0 and ValType = 2  then NO-PRISE = false  .
     2478      end.
     2479     else do:
     2480       if  x-base-code <> 0 and ValType = 1  then NO-PRISE = false  .
     2481     end .
     2482   output stream OutStream to value( string( session:temp-directory +
     2483                                        "rpt" + string( g#report-num ) ) )
     2484                                        page-size  value(ReportPageHeight) .
     2485     FORM with FRAME Zapas .
     2486   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2487   form header
     2488     line format "x(198)" at 1 skip
     2489     "Продолжение - на следующей странице" at 30 skip
     2490     with frame bottomframe width 232 page-bottom no-labels no-box .
     2491   view stream outstream frame bottomframe .
     2492      Line = fill("-", 198).
     2493     run CalcItog in this-procedure.
     2494     run Print-Header in this-procedure.
     2495     CAse classify :
     2496       when 1 then do:
     2497         run Foreach1 in this-procedure.
     2498       end.
     2499       when 2 then do:
     2500         run Foreach2 in this-procedure.
     2501       end.
     2502       when 3 then do:
     2503         run Foreach3 in this-procedure.
     2504       end.
     2505       when 4 then do:
     2506         run Foreach4 in this-procedure.
     2507       end.
     2508       when 5 then do:
     2509         run Foreach5 in this-procedure.
     2510       end.
     2511     End case.
     2512     HIDE stream OutStream FRAME BottomFrame .
     2513     run  Print-footer in this-procedure.
     2514     HIDE STREAM OutStream FRAME Zapas .
     2515     HIDE   STREAM OutStream FRAME top-Frame .
     2516     DELETE WIDGET-POOL "My-pool".
     2517     Output stream OutStream close.
     2518     if Make-Excel then output stream ForExcel close.
     2519   if mFrameView
     2520   then do:
     2521      HIDE FRAME InfoFrame.
     2522   end.
     2523     define variable v-user-action as character no-undo .
     2524     define variable v-printed as logical   no-undo .
     2525     define variable DisabledOptions as integer   no-undo .
     2526     define variable v-orient-page as character no-undo .
     2527     run How-name in this-procedure (
     2528         input ReportPageHeight,
     2529         input ReportPageWidth,
     2530         output v-orient-page )
     2531         .
     2532     if v-orient-page = "A4-lans":U then DisabledOptions = 8 .
     2533                                    else DisabledOptions = 0 .
     2534     run gbl/prnfilen.w
     2535       (input  ""
     2536       ,input  DisabledOptions
     2537       ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
     2538       ,input  ReportFontNum
     2539       ,output v-user-action
     2540       ,output v-printed
     2541       ) .
     2542   END PROCEDURE.
     2543   PROCEDURE print-header :
     2544      PUT stream OutStream  string( v-cntxt-host-name-obj +  " , " + x-store-type  +  " " + ObjName)
     2545            AT 10 format "X(85)" SKIP(2)
     2546            REPORTNAME
     2547            AT 10  format "X(100)" skip.
     2548        Repeat i = 1 to NUM-ENTRIES(STR1,chr(10)) :
     2549           PUT stream OutStream  Entry(i,STR1,chr(10))  AT 1 format "X(100)" SKIP.
     2550        End.
     2551        Repeat i = 1 to NUM-ENTRIES(STR2,chr(10)) :
     2552           PUT stream OutStream  Entry(i,STR2,chr(10))  AT 1 format "X(100)" SKIP.
     2553        End.
     2554        Repeat i = 1 to NUM-ENTRIES(STR3,chr(10)) :
     2555           PUT stream OutStream  Entry(i,STR3,chr(10))  AT 1 format "X(100)" SKIP.
     2556        End.
     2557        Repeat i = 1 to NUM-ENTRIES(STR4,chr(10)) :
     2558           PUT stream OutStream  Entry(i,STR4,chr(10))  AT 1 format "X(100)" SKIP.
     2559        End.
     2560        Repeat i = 1 to NUM-ENTRIES(ReportHeader,chr(10)) :
     2561           PUT stream OutStream  Entry(i,ReportHeader,chr(10))  AT 1 format "X(100)" SKIP.
     2562        End.
     2563       i=0.
     2564       run rep/extitle.p (1) .
     2565     display STREAM OutStream     with frame top-Frame .
     2566      END PROCEDURE.
     2567   PROCEDURE Print-Footer :
     2568     run on-same-page in this-procedure (input 1) .
     2569   PUT STREAM OutStream " " SKIP(3)
     2570        SKIP .
     2571      run on-same-page in this-procedure (input 1) .
     2572      END PROCEDURE.
