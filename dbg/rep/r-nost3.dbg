     5913       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     5914           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     5915           display STREAM OutStream    with frame top-frame .
     5916       End.
     5917     End.
     5918   if c-f-crsa-sum <>  ?  then do :
     5919   Assign
     5920       l1f-crsa-sum  = c-f-crsa-sum:DATA-TYPE
     5921       l2f-crsa-sum  = c-f-crsa-sum:FORMAT
     5922       c-f-crsa-sum:DATA-TYPE = "CHARACTER"
     5923       c-f-crsa-sum:FORMAT    = "x(" + string(C-f-crsa-sum:WIDTH-CHARS) + ")"
     5924       c-f-crsa-sum:screen-value = string('')  .
     5925   End.
