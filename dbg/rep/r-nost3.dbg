     5320                  f-sale-sum   = accum  TOTAL by  ub.ot-line.artic ub.ot-line.sum-rubl   .
     5321                  f-sale-vat   = accum  TOTAL by  ub.ot-line.artic ub.ot-line.vat-rubl   .
     5322                  f-sale-slt   = accum  TOTAL by  ub.ot-line.artic ub.ot-line.slt-rubl   .
     5323                  f-sale-other = accum  TOTAL by  ub.ot-line.artic ub.ot-line.other-rubl .
     5324                   f-crsa-sum = 0.
     5325                   For each crsa-ot-line where
     5326                       crsa-ot-line.fact-order >= fact-order-1 and
     5327                       crsa-ot-line.fact-order <= fact-order-2 and
     5328                       crsa-ot-line.obj-code    = ub.ot-line.obj-code and
     5329                       crsa-ot-line.obj-type    = ub.ot-line.obj-type and
     5330                       crsa-ot-line.prod-type   = ub.ot-line.prod-type and
     5331                       crsa-ot-line.prod-code   = ub.ot-line.prod-code and
     5332                       crsa-ot-line.artic       = ub.ot-line.artic and
     5333                       (crsa-ot-line.sum-type    = 'crsa':U OR
     5334                       crsa-ot-line.sum-type    = 'cgsr':U )
     5335                       no-lock ,
     5336                          First buf-tdedt where  buf-tdedt.id = crsa-ot-line.ext-doc-type  no-lock,
     5337                          first wt where wt.doc-code = crsa-ot-line.doc-code
     5338                       no-lock :
     5339                     f-crsa-sum   = f-crsa-sum + crsa-ot-line.sum-rubl   .
     5340                   End.
     5341                   f-cost-sum   = 0 .
     5342                   f-cost-vat   = 0 .
     5343                   For each alt-ot-line where
     5344                       alt-ot-line.fact-order >= fact-order-1 and
     5345                       alt-ot-line.fact-order <= fact-order-2 and
     5346                       alt-ot-line.obj-code    = ub.ot-line.obj-code and
