     3608      if Make-Excel then  put   stream ForExcel unformatted  obj-list.obj-name chr(10).
     3609      End.
     3610             n-nn = 0.
     3611             n-no = n-no + 1 .
     3612    For Each ub.ot-line where
     3613             ub.ot-line.fact-order <= fact-order-2 and
     3614             ub.ot-line.fact-order >= fact-order-1 and
     3615             ub.ot-line.obj-code    = obj-list.obj-code and
     3616             ub.ot-line.obj-type    = obj-list.obj-type  no-lock ,
     3617             First tdedt where ub.ot-line.ext-doc-type   = tdedt.id  no-lock
     3618             , First gds-list where  ub.ot-line.prod-type = gds-list.prod-type and
     3619                                     ub.ot-line.prod-code = gds-list.prod-code and
     3620                                     ub.ot-line.artic     = gds-list.artic no-lock
     3621               break
     3622                   by ub.ot-line.prod-type By ub.ot-line.prod-code by ub.ot-line.artic
     3623                   by ub.ot-line.sum-type
     3624                   with FRAME Zapas :
     3625             accumulate ub.ot-line.fact-qnty  (TOTAL BY ub.ot-line.sum-type ).
     3626             accumulate ub.ot-line.sum-rubl    (TOTAL BY ub.ot-line.sum-type ).
     3627             accumulate ub.ot-line.vat-rubl   (TOTAL BY ub.ot-line.sum-type ).
     3628             accumulate ub.ot-line.slt-rubl   (TOTAL BY ub.ot-line.sum-type ).
     3629             accumulate ub.ot-line.other-rubl (TOTAL BY ub.ot-line.sum-type ).
     3630             if first-of(ub.ot-line.prod-code)  and classify = 2 then DO:
     3631                 FIND FIRST clients-p where  ub.ot-line.prod-type = clients-p.obj-type AND
     3632                                             ub.ot-line.prod-code = clients-p.obj-code no-lock no-error.
     3633                  if avail clients-p then var-client = Clients-p.obj-name.
     3634                     if  Itog = false Then do:
     3635     if c-f-gds-name <>  ?  then do :
     3636       c-f-gds-name:screen-value = string(var-client) .
     3637       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     3638           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     3639           display STREAM OutStream    with frame top-frame .
     3640       End.
     3641     End.
     3642                       Display stream OutStream .
     3643                       DOWN stream OutStream .
     3644                       if Make-Excel then  put   stream ForExcel unformatted var-client chr(10) .
     3645                     End.
     3646             End.
     3647             if last-of(ub.ot-line.sum-type) then DO :
     3648             Case  ub.ot-line.sum-type :
     3649                 when 'cost':U then do:
     3650                   f-cost-sum = accum TOTAL BY ub.ot-line.sum-type ub.ot-line.sum-rubl .
     3651                   f-cost-vat = accum TOTAL BY ub.ot-line.sum-type ub.ot-line.vat-rubl .
     3652                 end.
     3653                 when 'sale':U then do:
     3654                    f-sale-sum = accum TOTAL BY ub.ot-line.sum-type ub.ot-line.sum-rubl .
     3655                    f-sale-other = accum TOTAL BY ub.ot-line.sum-type ub.ot-line.other-rubl .
     3656                    f-sale-vat = accum TOTAL BY ub.ot-line.sum-type ub.ot-line.vat-rubl .
     3657                    f-sale-slt = accum TOTAL BY ub.ot-line.sum-type ub.ot-line.slt-rubl .
     3658                 end.
     3659                 when  'crsa':U then do:
     3660                   f-crsa-sum1 = accum TOTAL BY ub.ot-line.sum-type ub.ot-line.sum-rubl .
     3661                   f-qnty1 = accum TOTAL BY  ub.ot-line.sum-type ub.ot-line.fact-qnty.
     3662                 end.
     3663                 when 'cssr':U then do:
     3664                   f-cost-sum = accum TOTAL BY ub.ot-line.sum-type ub.ot-line.sum-rubl .
     3665                   f-cost-vat = accum TOTAL BY ub.ot-line.sum-type ub.ot-line.vat-rubl .
     3666                 end.
     3667                 when 'sasr':U then do:
     3668                    f-sale-sum = accum TOTAL BY ub.ot-line.sum-type ub.ot-line.sum-rubl .
     3669                    f-sale-other = accum TOTAL BY ub.ot-line.sum-type ub.ot-line.other-rubl .
     3670                    f-sale-vat = accum TOTAL BY ub.ot-line.sum-type ub.ot-line.vat-rubl .
     3671                    f-sale-slt = accum TOTAL BY ub.ot-line.sum-type ub.ot-line.slt-rubl .
     3672                 end.
     3673                 when 'cgsr':U then do:
     3674                   f-crsa-sum2 = accum TOTAL BY ub.ot-line.sum-type ub.ot-line.sum-rubl .
     3675                   f-qnty2 = accum TOTAL BY  ub.ot-line.sum-type ub.ot-line.fact-qnty.
     3676                 end.
     3677             End case.
     3678             f-qnty = f-qnty2 + f-qnty1.
     3679             f-crsa-sum = f-crsa-sum2 + f-crsa-sum1.
     3680             End.
     3681             if last-of(ub.ot-line.artic) then DO:
     3682                n-nm = n-nm + 1.
     3683   IF ( n-nm modulo v-account = 0 )  then DO:
     3684    Assign
     3685       v-kol-spice = (50 - LENGTH(reportname)) / 2
     3686       RecordsString = fill(' ',v-kol-spice) + string(reportname)
     3687       .
     3688    Assign
     3689       v-kol-spice = (50 - LENGTH(objname)) / 2
     3690       RecordsString2 = fill(' ',v-kol-spice) + string(objname)
     3691       .
     3692             if  log-manager:logfile-name ne ?
     3693             then DO:
     3694                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     3695             end.
     3696              if mFrameView
     3697              then do:
     3698               DISPLAY
     3699                 n-nm @ RecordsDone
     3700                 RecordsString   @ RecordsString
     3701                 RecordsString2  @ RecordsString2
     3702                 WITH FRAME InfoFrame.
