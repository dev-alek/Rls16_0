     4405             , First gds-list where  ub.ot-line.prod-type = gds-list.prod-type and
     4406                                     ub.ot-line.prod-code = gds-list.prod-code and
     4407                                     ub.ot-line.artic     = gds-list.artic no-lock
     4408               break
     4409                   by   entry(1,ub.ot-line.cat-id)
     4410                   by ( ub.ot-line.artic + ub.ot-line.prod-type + string ( ub.ot-line.prod-code ))
