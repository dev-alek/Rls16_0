     5276                          DOWN stream OutStream .
     5277                          if Make-Excel then  put   stream ForExcel unformatted
     5278                                 "Ставка НДС"  CHR(9)
     5279                                  entry(1,ub.ot-line.cat-id) + "%"  chr(10) .
     5280                     End.
     5281         End.
     5282         Create WT.
