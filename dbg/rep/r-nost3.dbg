     2996                    f-sale-sum = accum TOTAL BY ub.ot-line.sum-type ub.ot-line.sum-rubl .
     2997                    f-sale-other = accum TOTAL BY ub.ot-line.sum-type ub.ot-line.other-rubl .
     2998                    f-sale-vat = accum TOTAL BY ub.ot-line.sum-type ub.ot-line.vat-rubl .
