      801   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      802   procedure proc-alt-shift-f2:
      803     if not ibs.th.gbl.gbl-var:rcode
      804   then
      805     run gbl\inidebug.p .
      806   end.
      807   procedure proc-alt-shift-f3:
      808     run gbl/prvssinf.p
      809       ( input this-procedure
      810       ) .
      811   end.
      812   define variable v-inform-launched as logical no-undo initial false .
      813   procedure proc-alt-shift-f4:
      814     define variable v-action as character no-undo .
      815     if v-inform-launched = false then do:
      816       assign
      817         v-inform-launched = true
      818       .
      819       run gbl/d-inform.w
      820         (  input self
      821         ,  input this-procedure
      822         , output v-action
      823         ) no-error .
      824       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      825       assign
      826         v-inform-launched = false
      827       .
      828     end.
      829   end.
      830   procedure proc-alt-f1:
      831     run gbl/corrhelp.p
      832       (input this-procedure
      833       ) .
      834   end .
      835   on alt-shift-f2 anywhere do:
      836     run proc-alt-shift-f2.
      837   end.
      838   on alt-shift-f3 anywhere do:
      839     run proc-alt-shift-f3 in this-procedure .
      840   end.
      841   on alt-shift-f4 anywhere do:
      842     run proc-alt-shift-f4 in this-procedure.
      843   end.
      844   on alt-f1 anywhere do:
