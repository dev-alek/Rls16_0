     5961       l2f-sale-vat  = c-f-sale-vat:FORMAT
     5962       c-f-sale-vat:DATA-TYPE = "CHARACTER"
     5963       c-f-sale-vat:FORMAT    = "x(" + string(C-f-sale-vat:WIDTH-CHARS) + ")"
