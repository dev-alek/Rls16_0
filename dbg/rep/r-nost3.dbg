     6008   if c-f-crsa-sum <>  ?  then do :
     6009   Assign
     6010       c-f-crsa-sum:DATA-TYPE = l1f-crsa-sum
     6011       c-f-crsa-sum:FORMAT    = l2f-crsa-sum.
     6012   End.
     6013   if c-f-sale-sum <>  ?  then do :
     6014   Assign
