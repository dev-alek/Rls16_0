     6699   END PROCEDURE.
     6700   PROCEDURE on-same-page :
     6701     define input parameter p-line-number as integer  no-undo .
     6702     if p-line-number > page-size( OutStream ) then do:
     6703       return .
     6704     end.
     6705     if line-counter( OutStream ) + p-line-number > page-size( OutStream ) then do:
     6706       page stream OutStream .
     6707     end.
     6708   end procedure.
     6709   PROCEDURE ostatok :
     6710   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
     6711   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
     6712   def input parameter x-tog-shift   as   logical             no-undo.
     6713   def input parameter x-date-start  like ub.stk-tot.Fact-date   no-undo.
     6714   def input parameter x-date-end    like ub.stk-tot.Fact-date   no-undo.
     6715   def input parameter x-shift-start as integer               no-undo.
     6716   def input parameter x-shift-end   as integer               no-undo.
     6717   def input parameter x-sum-type    like ub.stk-tot.sum-type    no-undo.
     6718   def input parameter x-cat-id      like ub.stk-tot.cat-id      no-undo.
     6719   def input parameter xTog-obj   as log no-undo.
     6720   def output parameter Quantity    like ub.stk-tot.fact-qnty   no-undo.
     6721   def output parameter Coast_R     like ub.stk-tot.sum-rubl    no-undo.
     6722   def output parameter Coast_V     like ub.stk-tot.sum-rubl    no-undo.
     6723   def output parameter VAT_R       like ub.stk-tot.sum-rubl    no-undo.
     6724   def output parameter VAT_V       like ub.stk-tot.sum-rubl    no-undo.
     6725   def output parameter Fact-order  like ub.stk-tot.Fact-order  no-undo.
     6726   def var              Fact-order#   like ub.stk-tot.Fact-order  no-undo.
     6727   def var              Fact-orderS   as char  no-undo.
     6728   def var x-date-start-t  like ub.stk-tot.shift-date   no-undo.
     6729      Assign
     6730         Fact-order   = 0
     6731         Quantity     = 0
     6732         Coast_R      = 0
     6733         Coast_V      = 0
     6734         VAT_R        = 0
     6735         VAT_V        = 0 .
     6736    x-date-start-t  = x-date-start + 1 .
     6737   IF x-date-end = date('') then DO:
     6738      Fact-order = 0 .
     6739      for each obj-list
     6740          where  ( not xtog-obj or
     6741                 ( x-store-type = obj-list.obj-type and x-store-code = obj-list.obj-code ))
     6742                 no-lock :
     6743         if  x-tog-shift = false then do:
     6744                          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     6745                               ub.stk-tot.Fact-date <=  x-date-start
     6746                               and ub.stk-tot.shift-num = 0
     6747                               USE-INDEX fact-date no-lock no-error .
     6748              if Available ub.stk-tot THEN  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     6749         End.
     6750         Else  DO :
     6751             find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     6752              (ub.stk-tot.shift-date  = x-date-start-t and
     6753               ub.stk-tot.shift-num  < x-shift-start or
     6754               ub.stk-tot.shift-date  < x-date-start-t  )
     6755               and ub.stk-tot.shift-num  > 0
     6756               USE-INDEX Shift-num no-lock no-error .
     6757            If Available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     6758           END.
     6759       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     6760     End.
     6761   End.
     6762   Else DO:
     6763     For each obj-list  WHERE
     6764        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
     6765         no-lock :
     6766      IF  x-TOG-Shift = False Then DO:
     6767          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     6768               ub.stk-tot.Fact-date <= x-date-end
     6769               and ub.stk-tot.shift-num = 0
     6770               USE-INDEX fact-date no-lock no-error.
     6771          if available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     6772      END.
     6773      Else DO:
     6774           find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     6775               (ub.stk-tot.shift-date  = x-date-end and
     6776               ub.stk-tot.shift-num  <= x-shift-end or
     6777               ub.stk-tot.shift-date  < x-date-end       ) and
     6778               ub.stk-tot.shift-num   > 0      use-index shift-num no-lock no-error.
     6779               if Available ub.stk-tot THEN Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     6780       End.
     6781       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     6782     End.
     6783   End.
     6784   END PROCEDURE.
