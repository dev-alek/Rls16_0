     5228             n-nn = 0.
     5229             n-no = n-no + 1 .
     5230    For Each ub.ot-line where
     5231             ub.ot-line.fact-order <= fact-order-2 and
     5232             ub.ot-line.fact-order >= fact-order-1 and
     5233             ub.ot-line.obj-code    = obj-list.obj-code and
     5234             ub.ot-line.obj-type    = obj-list.obj-type and
     5235             (
     5236             ub.ot-line.sum-type    = string('sale':U) + String('')
     5237             OR
     5238             ub.ot-line.sum-type    =
     5239              'sasr':U + String('')
     5240             )
     5241             no-lock ,
     5242             First tdedt where ub.ot-line.ext-doc-type   = tdedt.id  no-lock
     5243             , First gds-list where  ub.ot-line.prod-type = gds-list.prod-type and
     5244                                     ub.ot-line.prod-code = gds-list.prod-code and
     5245                                     ub.ot-line.artic     = gds-list.artic no-lock
     5246               break
     5247                   by   entry(1,ub.ot-line.cat-id)
     5248                   by ( ub.ot-line.artic + ub.ot-line.prod-type + string ( ub.ot-line.prod-code ))
     5249                   by ub.ot-line.prod-type By ub.ot-line.prod-code by ub.ot-line.artic
     5250                   with FRAME Zapas :
     5251               accumulate ub.ot-line.fact-qnty     (TOTAL by  ub.ot-line.artic ) .
     5252               accumulate ub.ot-line.sum-rubl       (TOTAL by  ub.ot-line.artic ) .
     5253               accumulate ub.ot-line.vat-rubl       (TOTAL by  ub.ot-line.artic ) .
     5254               accumulate ub.ot-line.slt-rubl       (TOTAL by  ub.ot-line.artic ) .
     5255               accumulate ub.ot-line.other-rubl     (TOTAL by  ub.ot-line.artic ) .
     5256         if first-of( entry(1,ub.ot-line.cat-id) ) then DO:
     5257          for each wt share-lock : delete wt. end.
     5258                     if  Itog = false Then do:
     5259                         f-artic  =  "Ставка НДС"  .
     5260                         f-gds-name =  entry(1,ub.ot-line.cat-id) + '%' .
     5261     if c-f-artic <>  ?  then do :
     5262       c-f-artic:screen-value = string(f-artic) .
     5263       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     5264           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     5265           display STREAM OutStream    with frame top-frame .
