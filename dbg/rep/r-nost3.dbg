     5284         if last-of(ub.ot-line.artic) then DO:
     5285                   n-nm = n-nm + 1.
     5286   IF ( n-nm modulo v-account = 0 )  then DO:
     5287    Assign
     5288       v-kol-spice = (50 - LENGTH(reportname)) / 2
