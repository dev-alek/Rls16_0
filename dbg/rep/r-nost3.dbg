     2746   PROCEDURE CalcItog :
     2747       run ostatok (
     2748           input x-store-code  ,
     2749           input x-store-type  , x-TOG-Shift,
     2750           input x-date-start - 1 ,
     2751           input date('')      , x-Shift-Start,x-Shift-End,
     2752           input 'crsa':U   ,
     2753           input '##,##':U,
     2754           input xTog-obj ,
     2755           output  Quantity1  ,
     2756           output  Coast_R1   ,
     2757           output  Coast_V1   ,
     2758           output  VAT_R1     ,
     2759           output  VAT_V1     ,
     2760           output  Fact-order-1 ).
     2761       run ostatok (
     2762           input x-store-code  ,
     2763           input x-store-type  , x-TOG-Shift,
     2764           input x-date-start  ,
     2765           input x-date-end    , x-Shift-Start,x-Shift-End,
     2766           input 'crsa':U   ,
     2767           input '##,##':U,
     2768           input xTog-obj ,
     2769           output  Quantity1  ,
     2770           output  Coast_R1   ,
     2771           output  Coast_V1   ,
     2772           output  VAT_R1     ,
     2773           output  VAT_V1     ,
     2774           output  Fact-order-2 ).
     2775             Quantity1  = 0.
     2776             Coast_R1   = 0.
     2777             Coast_V1   = 0.
     2778             VAT_R1     = 0.
     2779             VAT_V1     = 0.
     2780   END PROCEDURE.
     2781   PROCEDURE foreach1 :
     2782   IF ( n-nm modulo v-account = 0 )  then DO:
     2783    Assign
     2784       v-kol-spice = (50 - LENGTH(reportname)) / 2
     2785       RecordsString = fill(' ',v-kol-spice) + string(reportname)
     2786       .
     2787    Assign
     2788       v-kol-spice = (50 - LENGTH(objname)) / 2
     2789       RecordsString2 = fill(' ',v-kol-spice) + string(objname)
     2790       .
     2791             if  log-manager:logfile-name ne ?
     2792             then DO:
     2793                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     2794             end.
     2795              if mFrameView
     2796              then do:
     2797               DISPLAY
     2798                 n-nm @ RecordsDone
     2799                 RecordsString   @ RecordsString
     2800                 RecordsString2  @ RecordsString2
     2801                 WITH FRAME InfoFrame.
     2802              end.
     2803   End.
     2804      if v-button-stop then  DO:
     2805            if mFrameView
     2806            then
     2807               PROCESS EVENTS.
     2808            IF StopProcessing THEN DO:
     2809            RETURN error.
     2810            End.
     2811      end.
     2812     for each obj-list no-lock with FRAME Zapas :
     2813       if NOT( classify = 1 and Itog = true) then dO:
     2814     if c-f-gds-name <>  ?  then do :
     2815       c-f-gds-name:screen-value = string(obj-list.obj-name) .
     2816       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     2817           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
