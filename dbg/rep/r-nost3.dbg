     5357                         f-cost-vat   = f-cost-vat + alt-ot-line.vat-rubl   .
     5358                       End.
     5359                   f-cost-sum-novat = f-cost-sum - f-cost-vat .
     5360                   f-disc = f-sale-sum - f-sale-vat - f-sale-slt - f-cost-sum-novat.
     5361                   f-disc-prc = (f-disc / f-cost-sum-novat * 100)  .
