     6016       c-f-sale-sum:FORMAT    = l2f-sale-sum.
     6017   End.
     6018   if c-f-cost-sum <>  ?  then do :
     6019   Assign
     6020       c-f-cost-sum:DATA-TYPE = l1f-cost-sum
     6021       c-f-cost-sum:FORMAT    = l2f-cost-sum.
     6022   End.
     6023   if c-f-cost-vat <>  ?  then do :
     6024   Assign
     6025       c-f-cost-vat:DATA-TYPE = l1f-cost-vat
     6026       c-f-cost-vat:FORMAT    = l2f-cost-vat.
     6027   End.
     6028   if c-f-cost-sum-novat <>  ?  then do :
     6029   Assign
     6030       c-f-cost-sum-novat:DATA-TYPE = l1f-cost-sum-novat
     6031       c-f-cost-sum-novat:FORMAT    = l2f-cost-sum-novat.
