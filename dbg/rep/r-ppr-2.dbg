     2947   procedure run3 :
     2948   CASE RetClassify :
     2949     when "no-classify":U  then   DO:
     2950          For each obj-list no-lock :
     2951            for each temp-t-post-stk-line : delete temp-t-post-stk-line. end.
     2952            if t#kol-rec-obj > 1 THEN run print-header (1, '(' + obj-list.obj-type + ' ' + trim(string(obj-list.obj-code)) + ') ' + obj-list.obj-name).
     2953             For each post-stk-line  no-lock where
     2954                                               post-stk-line.obj-type = obj-list.obj-type and
     2955                                               post-stk-line.obj-code = obj-list.obj-code and
     2956                                               post-stk-line.fact-order >= null-fact-order   and
     2957                                               post-stk-line.fact-order <= fact-order-2   and
     2958                                               post-stk-line.sum-type    = 'cost':U    and
