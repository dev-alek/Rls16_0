     1212   procedure create-temp-t-post-stk-line :
     1213       define variable str  as char      format "X(60)" no-undo.
     1214       define variable str2 as char      no-undo.
     1215       define variable v-r  as character no-undo init "" .
     1216       define variable i#i  as int       no-undo.
     1217    do
     1218    on error undo, return error return-value
     1219    :
     1220    if available ub.goods and
     1221       available ub.clients and
     1222       available prod-cli then do:
     1223     create temp-t-post-stk-line .
     1224     BUFFER-COPY post-stk-line  TO temp-t-post-stk-line
     1225     assign
     1226       temp-t-post-stk-line.goods-grp-name    = ub.goods.grp-name
     1227       temp-t-post-stk-line.gds-code          = ub.goods.gds-code
     1228       temp-t-post-stk-line.unit-base         = ub.goods.unit-base
     1229       temp-t-post-stk-line.prt-root          = ub.goods.prt-root
     1230       temp-t-post-stk-line.gds-type          = ub.goods.gds-type
     1231       temp-t-post-stk-line.gds-name          = if g#gds-engl then ub.goods.engl-name else ub.goods.gds-name
     1232       temp-t-post-stk-line.clients-grp-name  = ub.clients.grp-name
     1233       temp-t-post-stk-line.clients-obj-name  = ub.clients.obj-name
     1234       temp-t-post-stk-line.prod-cli-obj-name = prod-cli.obj-name
     1235       temp-t-post-stk-line.prod-cli-obj-code = prod-cli.obj-code
     1236       temp-t-post-stk-line.prod-cli-obj-type = prod-cli.obj-type
     1237     .
     1238               if xlavel > 0 then
     1239               do:
     1240                   repeat i#i =1 to xlavel:
     1241                       if i#i =1 then str   = entry(1,ub.goods.grp-name, chr(47)) .
     1242                       else
     1243                       do:
     1244                           str2 = entry(i#i,ub.goods.grp-name, chr(47)) no-error.
     1245                           if not error-status:error  and str2 <> "":u then
     1246                               str = str +  chr(47) +  entry(i#i,ub.goods.grp-name, chr(47)) no-error .
     1247                       end.
     1248                   end.
     1249                   if str <> ? then
     1250                   do:
     1251                       temp-t-post-stk-line.goods-grp-name = str + chr(47) .
     1252                   end.
     1253               end.
     1254               else
     1255               do :
     1256                   temp-t-post-stk-line.goods-grp-name = ub.goods.grp-name.
     1257               end.
     1258           end.
     1259    end.
     1260   end procedure.
     1261   function excel-format-dec-to-char returns char (input p-dec as decimal ).
     1262     if num-entries(string(p-dec), '.') = 2
     1263       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
     1264       else return( string(p-dec)) .
     1265   end function.
     1266   function format-point-to-comma returns char (input orig as char ) .
     1267   define variable rtext as character no-undo .
     1268   define variable strt as integer no-undo .
     1269   define variable leng as integer no-undo .
     1270   assign rtext = orig .
     1271   repeat:
     1272     strt =  index(rtext,'.').
     1273     if strt = 0 then leave.
     1274     leng = 1.
     1275     substring(rtext,strt,leng,"character") = v-delim .
     1276   end.
     1277   return rtext.
     1278   end function.
     1279   function format-excel-text returns char ( input start-text as char ) :
     1280   def var  i    as int no-undo.
     1281   def var  ch   as char no-undo.
     1282   def var  n    as int no-undo.
     1283   def var  ipos as int no-undo.
     1284     n = num-entries(trim(start-text), chr(10)) - 1 .
     1285     do i = 1 to n :
     1286       ipos = index( start-text, chr(10)).
     1287       if ipos > 0 then
     1288         substr( start-text, ipos, 1 ) = ' '.
     1289     end.
     1290     n = num-entries(trim(start-text), chr(13)) - 1 .
     1291     do i = 1 to n :
     1292       ipos = index( start-text, chr(13)).
     1293       if ipos > 0 then
     1294         substr( start-text, ipos, 1 ) = ' '.
     1295     end.
     1296     if index( start-text, '"' ) = 0 then
     1297       start-text =  '="'   + trim( start-text) + '"'   .
     1298       else do:
     1299         n = num-entries(trim(start-text), '"') - 1.
     1300         do i = 1 to n :
     1301           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1302         end.
     1303         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1304         start-text = '="'  + ch  + '"' .
     1305       end.
     1306     return start-text.
     1307   end.
     1308   function excel-sum returns char (input p-dec as decimal ).
     1309     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
     1310   end function.
     1311   function excel-qnty returns char (input p-dec as decimal ).
     1312     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
     1313   end function.
     1314   function format-excel-text-macr returns char ( input start-text as char ) :
     1315   def var  i    as int no-undo.
     1316   def var  ch   as char no-undo.
     1317   def var  n    as int no-undo.
     1318   def var  ipos as int no-undo.
     1319     n = num-entries(trim(start-text), chr(10)) - 1 .
     1320     do i = 1 to n :
     1321       ipos = index( start-text, chr(10)).
     1322       if ipos > 0 then
     1323         substring( start-text, ipos , 1 ) = ' '.
     1324     end.
     1325     n = num-entries(trim(start-text), chr(13)) - 1 .
     1326     do i = 1 to n :
     1327       ipos = index( start-text, chr(13)).
     1328       if ipos > 0 then
     1329         substring( start-text, ipos, 1 ) = ' '.
     1330     end.
     1331     if index( start-text, '"' ) = 0 then
     1332       start-text =  '"'   + trim( start-text) + '"'   .
     1333       else do:
     1334         n = num-entries(trim(start-text), '"') - 1.
     1335         do i = 1 to n :
     1336           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1337         end.
     1338         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1339         start-text = '"'  + ch  + '"' .
     1340       end.
     1341     n = num-entries(trim(start-text), chr(10)) - 1 .
     1342     do i = 1 to n :
     1343       ipos = index( start-text, chr(10)).
     1344       if ipos > 0 then
     1345         substring( start-text, ipos , 1 ) = ' '.
     1346     end.
     1347       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
     1348     return start-text.
     1349   end.
     1350   FUNCTION n-lavel RETURNS char (INPUT grp-name as char, INPUT lavel# as int ).
     1351   define variable  str  as char format "X(60)"  no-undo.
     1352   define variable  str2 as char no-undo.
     1353   define variable v-r as character no-undo init "" .
     1354   define variable  i#i as int no-undo.
     1355   STR = "".
     1356   repeat i#i =1 to lavel#:
     1357       if i#i =1 then str   = entry(1,grp-name, chr(47)) .
     1358       else do:
     1359           str2 = entry(i#i,grp-name, chr(47)) no-error.
     1360           if not error-status:error  and str2 <> "":u then
     1361                  str = str +  chr(47) +  entry(i#i,grp-name, chr(47)) no-error .
     1362           end.
     1363   end.
     1364   if str <> ? then do:
     1365   v-r = str + chr(47) .
     1366   end.
     1367   RETURN v-r .
     1368   END FUNCTION.
     1369   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1370   define variable v-waitfram-action01         as character   no-undo .
     1371   define variable v-waitfram-action02         as character   no-undo .
     1372   define variable v-waitfram-action03         as character   no-undo .
     1373   define variable mWaitFramTextBeg            as character   no-undo.
     1374   define variable mWaitFramTextEnd            as character   no-undo.
     1375   define variable mWaitFramView               as logical     no-undo.
     1376   define variable mWaitProcEvent              as logical     no-undo init yes.
     1377   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1378   define variable mWaitFramStop               as logical     no-undo.
     1379   define variable mWaitFramStopUser           as logical     no-undo.
     1380   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1381   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1382   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1383   define button B-WaitFramStop auto-end-key
     1384        label "Стоп"
     1385        size 10 by 1 tooltip "Остоновить процесс".
     1386   define button B-viewProcInfo
     1387        label "Информация"
     1388        size 15 by 1 tooltip "Информация о процесс".
     1389   define frame waitfram
     1390     v-waitfram-action01 format "x(72)" no-label skip
     1391     v-waitfram-action02 format "x(72)" no-label skip
     1392     v-waitfram-action03 format "x(72)" no-label skip
     1393     B-viewProcInfo
     1394     B-WaitFramStop at row 4 col 30
     1395     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1396     .
     1397   define new global shared variable mBatchMode as logical no-undo init ?.
     1398   define variable mFramBachModHandle as handle no-undo.
     1399   mFramBachModHandle = frame waitfram:handle.
     1400   define variable mFameOldVis as logical no-undo.
     1401   define variable mVisCUrentVin as logical no-undo.
     1402   if session:batch-mode
     1403   then
     1404      mBatchMode = yes.
     1405   if mBatchMode = ? then do:
     1406     mVisCUrentVin = current-window:visible.
     1407     mFameOldVis = mFramBachModHandle:visible.
     1408     mFramBachModHandle:visible  = yes.
     1409     mBatchMode = mFramBachModHandle:visible ne yes.
     1410     mFramBachModHandle:visible = mFameOldVis.
     1411     current-window:visible = mVisCUrentVin.
     1412   end.
     1413    if  log-manager:logfile-name ne ?
     1414     then DO:
     1415         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1416         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1417         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1418     end.
     1419   on choose of B-WaitFramStop in frame waitfram
     1420   do:
     1421     mWaitFramStop = yes.
     1422     mWaitFramStopUser = yes.
     1423   end.
     1424   function waitfram-check-timeout returns logical():
     1425      define variable vtime as int64 no-undo.
     1426      if mWaitFramStopTimeOut
     1427      then
     1428         return yes.
     1429      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1430      if     mWaitFramTimeOut ne ?
     1431         and mWaitFramTimeOut ne 0
     1432         and mWaitFramTimeOut lt vtime
     1433      then do:
     1434         mWaitFramStopTimeOut = yes.
     1435      end.
     1436      return mWaitFramStopTimeOut.
     1437   end.
     1438   procedure waitfram-hide :
     1439     if not session:batch-mode
     1440     then do
     1441     on error undo, return error return-value
     1442     :
     1443       pause 0 before-hide .
     1444       if not mBatchMode then
     1445         hide frame waitfram .
     1446     if     not mWaitFramView
     1447        and mWaitProcEvent
     1448     then
     1449       process events .
     1450     end.
     1451   end procedure.
     1452   procedure waitfram-show :
     1453     define input  parameter p-message as character no-undo .
     1454     define variable v-left-margin as integer   no-undo .
     1455     if not session:batch-mode
     1456     then do
     1457     on error undo, return error return-value
     1458     :
     1459       if length(p-message) <= 70 then do:
     1460         assign
     1461           v-left-margin = integer((70 - length(p-message)) / 2)
     1462         .
     1463         assign
     1464           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1465         .
     1466         assign
     1467           v-waitfram-action01 = " "
     1468           v-waitfram-action02 = " "
     1469                                    + fill(" ", v-left-margin)
     1470                                    + p-message
     1471           v-waitfram-action03 = " "
     1472         .
     1473       end.
     1474       else do:
     1475         define variable vRindex1 as integer no-undo.
     1476         define variable vRindex2 as integer no-undo.
     1477         vRindex1 = r-index(p-message," ",70).
     1478         if vRindex1 = 0
     1479         then
     1480            vRindex1 = 70.
     1481         if length(p-message)  <= vRindex1 + 70 then do:
     1482           assign
     1483             v-waitfram-action01 = " "
     1484             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1485             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1486           .
     1487         end.
     1488         else do:
     1489           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1490           if vRindex2 <= vRindex1
     1491           then
     1492              vRindex2 = vRindex1 + 70.
     1493           assign
     1494             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1495             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1496             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1497           .
     1498         end.
     1499       end.
     1500       B-viewProcInfo:visible   in frame waitfram = no.
     1501       B-viewProcInfo:sensitive in frame waitfram = no.
     1502       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1503       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1504       if  (   mWaitFramView
     1505          or  mWaitProcEvent)
     1506          and not mBatchMode
     1507       then
     1508          display
     1509             v-waitfram-action01 skip
     1510             v-waitfram-action02 skip
     1511             v-waitfram-action03 skip
     1512          with frame waitfram .
     1513       if     mWaitFramView
     1514          then do:
     1515             if     mWaitFramInterval ne ?
     1516                and not mBatchMode
     1517             then
     1518                wait-for go of frame waitfram pause mWaitFramInterval.
     1519          end.
     1520          else
     1521             if     mWaitProcEvent
     1522                and not mBatchMode
     1523             then
     1524                process events .
     1525     end.
     1526   end procedure.
     1527      procedure waitfram-show-this:
     1528         define input  parameter iInterval as int64 no-undo.
     1529         define variable vtime as int64 no-undo.
     1530         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1531         mWaitFramInterval = iInterval.
     1532         run waitfram-show (substitute("&1&2 &3&4" ,
     1533                                       mWaitFramTextBeg ,
     1534                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1535                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1536                                       mWaitFramTextEnd
     1537                                      )
     1538                           ).
     1539      end.
     1540      procedure WaitFramRunPause:
     1541         define input  parameter iInterval as dec no-undo.
     1542         define variable vStart  as datetime-tz no-undo.
     1543         define variable vend    as datetime-tz no-undo.
     1544         define variable vint as int64 no-undo.
     1545         define variable vOk as logical no-undo.
     1546         vStart = now.
     1547         vend   = vStart.
     1548         publish "WaitFramPause" (iInterval,output vOk).
     1549         vend   =  now.
     1550         vint = vend - vStart.
     1551         vint = iInterval - vint / 1000.
     1552         if     not mWaitFramStop
     1553            and (   vint > 0
     1554                 or (    not vOk
     1555                     and iInterval eq ?
     1556                     )
     1557                 )
     1558         then
     1559            run waitfram-show-this (iInterval).
     1560         vend   =  now.
     1561         vint = vend - vStart.
     1562         vint = iInterval - vint / 1000.
     1563         if     not mWaitFramStop
     1564            and vint > 0
     1565         then do:
     1566            run gbl/pause.p (vint * 1000).
     1567         end.
     1568         if iInterval ne ?
     1569         then
     1570            publish "WaitFramStop".
     1571         waitfram-check-timeout().
     1572      end.
     1573      procedure WaitFramWaitFor:
     1574         define input  parameter iInterval as dec no-undo.
     1575         assign
     1576            mWaitFramStartProc   = now
     1577            mWaitFramStopUser    = no
     1578            mWaitFramStopTimeOut = no
     1579         .
     1580         block-wait:
     1581         do while not mWaitFramStop:
     1582            run WaitFramRunPause (iInterval).
     1583            if  waitfram-check-timeout()
     1584            then do:
     1585               leave block-wait.
     1586            end.
     1587         end.
     1588         run waitfram-hide.
     1589      end.
     1590   procedure waitfram-join :
     1591     define input  parameter p-line-1  as character no-undo .
     1592     define input  parameter p-line-2  as character no-undo .
     1593     define input  parameter p-line-3  as character no-undo .
     1594     define output parameter p-message as character no-undo .
     1595     do
     1596     on error undo, return error return-value
     1597     :
     1598       assign
     1599         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1600                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1601                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1602       .
     1603     end.
     1604   end procedure.
     1605   function waitfram-join-function returns character
     1606     (input p-line-1 as character
     1607     ,input p-line-2 as character
     1608     ,input p-line-3 as character
     1609     ).
     1610     define variable v-message as character no-undo .
     1611     run waitfram-join in this-procedure
     1612       (input  p-line-1
     1613       ,input  p-line-2
     1614       ,input  p-line-3
     1615       ,output v-message
     1616       ) .
     1617     return v-message .
     1618   end function .
     1619   define buffer goods   for ub.goods  .
     1620   define buffer gds-obj for ub.gds-obj  .
     1621   define buffer clients for ub.clients  .
     1622   define variable ii like i init 0 no-undo .
     1623   define variable t#cat-id like stk-line.cat-id no-undo .
     1624   define variable t#Sum-type like stk-line.Sum-type no-undo .
     1625   define variable t#kol-rec-obj like i init 0  no-undo .
     1626   if Show-Negativ then null-fact-order = 0 .
     1627      else  null-fact-order = fact-order-1 .
     1628   for each obj-list no-lock :
     1629     t#kol-rec-obj = t#kol-rec-obj + 1.
     1630   End.
     1631   case type-stor  :
     1632     when 1 then  do:
     1633       Assign
     1634         t#cat-id   = '##':U
     1635         t#sum-type = 'cost':U  .
     1636     end.
     1637     when 2 then do:
     1638       Assign
     1639         t#cat-id   = 'prch':U
     1640         t#sum-type = 'cost':U + 'p':U .
     1641     end.
     1642     when 3 then do:
     1643       Assign
     1644         t#cat-id   = 'cacc':U
     1645         t#sum-type = 'cost':U + 'p':U .
     1646     end.
     1647     when 4 then do:
     1648       Assign
     1649         t#cat-id   = 'stor':U
     1650         t#sum-type = 'cost':U + 'p':U .
     1651     end.
     1652     when 5 then do:
     1653       Assign
     1654         t#cat-id   = 'cons':U
     1655         t#sum-type = 'cost':U + 'p':U .
     1656     end.
     1657   End case.
     1658   if xTogobj = false  then DO:
     1659     Case Select-Good :
     1660       when 1   then    RUN Run1-0.
     1661       when 2   then    run run2-0.
     1662       when 3  then    run run3-0.
     1663       otherwise do:
     1664           run run45-0.
     1665       end.
     1666     End case.
     1667   End.
     1668   Else do:
     1669     Case Select-Good :
     1670       when 1  then    RUN Run1.
     1671       when 2  then    run run2.
     1672       when 3 then    run run3.
     1673       otherwise do:
     1674         run run45.
     1675       end.
     1676     End case.
     1677   End.
     1678   procedure run1 :
     1679   CASE RetClassify :
     1680     when "no-classify":U then  DO:
     1681          For each obj-list no-lock :
     1682            for each temp-t-post-stk-line : delete temp-t-post-stk-line. end.
     1683            if t#kol-rec-obj > 1 THEN run print-header (1, '(' + obj-list.obj-type + ' ' + trim(string(obj-list.obj-code)) + ') ' + obj-list.obj-name).
     1684             For each post-stk-line  no-lock where
     1685                                               post-stk-line.obj-type = obj-list.obj-type and
     1686                                               post-stk-line.obj-code = obj-list.obj-code and
     1687                                               post-stk-line.fact-order >= null-fact-order   and
     1688                                               post-stk-line.fact-order <= fact-order-2   and
     1689                                               post-stk-line.sum-type    = 'cost':U    and
     1690                                               post-stk-line.cat-id      = '##':U
     1691                                               and can-find(first g#post  where  post-stk-line.cli-type = g#post.obj-type and  post-stk-line.cli-code = g#post.obj-code ) = TRUE
     1692                                               :
     1693                    find first  temp-t-post-stk-line where
     1694                      temp-t-post-stk-line.cli-type  = post-stk-line.cli-type  and
     1695                      temp-t-post-stk-line.cli-code  = post-stk-line.cli-code   and
     1696                      temp-t-post-stk-line.artic     = post-stk-line.artic     and
     1697                      temp-t-post-stk-line.prod-type = post-stk-line.prod-type and
     1698                      temp-t-post-stk-line.prod-code = post-stk-line.prod-code no-lock no-error .
     1699                      if not available  temp-t-post-stk-line then do:
     1700                         find first  ub.goods no-lock where
     1701                                               ub.goods.artic     = post-stk-line.artic     and
     1702                                               ub.goods.prod-type = post-stk-line.prod-type and
     1703                                               ub.goods.prod-code = post-stk-line.prod-code no-error .
     1704                         find first  prod-cli no-lock  where
     1705                                                   prod-cli.obj-type = post-stk-line.prod-type and
     1706                                                   prod-cli.obj-code = post-stk-line.prod-code
     1707                                                   no-error .
     1708                         find first  ub.clients  no-lock  where
     1709                                                   ub.clients.obj-type = post-stk-line.cli-type and
     1710                                                   ub.clients.obj-code = post-stk-line.cli-code no-error .
     1711                           run create-temp-t-post-stk-line .
     1712                    end.
     1713                    else do:
     1714                            assign
     1715                              temp-t-post-stk-line.fact-order = post-stk-line.fact-order  .
     1716                            .
     1717                    end.
     1718             end.
     1719             For each temp-t-post-stk-line no-lock   ,
     1720                    Last temp-post-stk-line  where
     1721                         temp-post-stk-line.fact-order <= fact-order-2   and
     1722                         temp-post-stk-line.cat-id     =  t#cat-id      and
     1723                         temp-post-stk-line.Sum-type   =  t#sum-type    and
     1724                         temp-post-stk-line.artic      =  temp-t-post-stk-line.artic       and
     1725                         temp-post-stk-line.prod-type  =  temp-t-post-stk-line.prod-type   and
     1726                         temp-post-stk-line.prod-code  =  temp-t-post-stk-line.prod-code   and
     1727                         temp-post-stk-line.obj-type   =  temp-t-post-stk-line.obj-type    and
     1728                         temp-post-stk-line.obj-code   =  temp-t-post-stk-line.obj-code and
     1729                         temp-post-stk-line.cli-type   =  temp-t-post-stk-line.cli-type  and
     1730                         temp-post-stk-line.cli-code   =  temp-t-post-stk-line.cli-code
     1731                         no-lock
     1732                         on error undo , next
     1733                         break
     1734                         By ((temp-t-post-stk-line.cli-type + string(temp-t-post-stk-line.cli-code)))
     1735                         By temp-t-post-stk-line.artic
     1736                         By ((temp-t-post-stk-line.artic + temp-t-post-stk-line.prod-type + string(temp-t-post-stk-line.prod-code)))
     1737                         By Temp-t-post-stk-line.Fact-order
     1738                        :
     1739                 if NOT(Sums-Only = true ) then DO:
     1740                     if first-of( (temp-t-post-stk-line.cli-type + string(temp-t-post-stk-line.cli-code)) ) Then DO : run print-header ( 3,temp-t-post-stk-line.clients-obj-name). end.
     1741                 End.
     1742                                       if first-of( (temp-t-post-stk-line.artic + temp-t-post-stk-line.prod-type + string(temp-t-post-stk-line.prod-code)) ) then do : run goods-start. end .
     1743                                       if last-of ( (temp-t-post-stk-line.artic + temp-t-post-stk-line.prod-type + string(temp-t-post-stk-line.prod-code)) ) then do : run goods-end.
     1744                                            run display-line .
     1745                                       End.
     1746                     if last-of( (temp-t-post-stk-line.cli-type + string(temp-t-post-stk-line.cli-code)) ) Then DO : run print-footer ( 3 , temp-t-post-stk-line.clients-obj-name). end.
     1747             End.
     1748            if t#kol-rec-obj > 1 THEN run print-footer ( 0, '(' + obj-list.obj-type + ' ' + trim(string(obj-list.obj-code)) + ') ' + obj-list.obj-name).
     1749           .
     1750          End.
     1751     End.
     1752     when "grp-goods":U  then     DO:
     1753       if xLavel = 0 THEN  DO:
     1754          For each obj-list no-lock :
     1755            for each temp-t-post-stk-line : delete temp-t-post-stk-line. end.
     1756            if t#kol-rec-obj > 1 THEN run print-header (1, '(' + obj-list.obj-type + ' ' + trim(string(obj-list.obj-code)) + ') ' + obj-list.obj-name).
     1757             For each post-stk-line  no-lock where
     1758                                               post-stk-line.obj-type = obj-list.obj-type and
     1759                                               post-stk-line.obj-code = obj-list.obj-code and
     1760                                               post-stk-line.fact-order >= null-fact-order   and
     1761                                               post-stk-line.fact-order <= fact-order-2   and
     1762                                               post-stk-line.sum-type    = 'cost':U    and
     1763                                               post-stk-line.cat-id      = '##':U
     1764                                               and can-find(first g#post  where  post-stk-line.cli-type = g#post.obj-type and  post-stk-line.cli-code = g#post.obj-code ) = TRUE
     1765                                               :
     1766                    find first  temp-t-post-stk-line where
     1767                      temp-t-post-stk-line.cli-type  = post-stk-line.cli-type  and
     1768                      temp-t-post-stk-line.cli-code  = post-stk-line.cli-code   and
     1769                      temp-t-post-stk-line.artic     = post-stk-line.artic     and
     1770                      temp-t-post-stk-line.prod-type = post-stk-line.prod-type and
     1771                      temp-t-post-stk-line.prod-code = post-stk-line.prod-code no-lock no-error .
     1772                      if not available  temp-t-post-stk-line then do:
