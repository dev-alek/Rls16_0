     5074       prih             [kk]  = 0
     5075       rash             [kk]  = 0
     5076       kassa            [kk]  = 0
     5077       Inv              [kk]  = 0
     5078       vzvr-post        [kk]  = 0
     5079       vzvr             [kk]  = 0
     5080       sm               [kk]  = 0
     5081       spis             [kk]  = 0 .
     5082          End.
     5083    END PROCEDURE.
     5084   PROCEDURE ob-line :
     5085   def input  parameter x-gds-code     like goods.gds-code     no-undo.
     5086   def input  parameter x-store-code   like ub.clients.obj-code     no-undo.
     5087   def input  parameter x-store-type   like ub.clients.obj-type     no-undo.
     5088   def input  parameter x-cli-code     like ub.clients.obj-code     no-undo.
     5089   def input  parameter x-cli-type     like ub.clients.obj-type     no-undo.
     5090   def INPUT  parameter x-artic        like post-ot-line.artic        no-undo.
     5091   def INPUT  parameter x-prod-code    like post-ot-line.prod-code    no-undo.
     5092   def INPUT  parameter x-prod-type    like post-ot-line.prod-type    no-undo.
     5093   def INPUT  parameter x-Fact-order-1   like post-ot-line.Fact-order   no-undo.
     5094   def INPUT  parameter x-Fact-order-2   like post-ot-line.Fact-order   no-undo.
     5095   def input  parameter x-sum-type       like post-ot-line.sum-type     no-undo.
     5096   def input  parameter x-cat-id         like post-ot-line.cat-id       no-undo.
     5097   def input  parameter x-ext-doc-type   like post-ot-line.ext-doc-type no-undo.
     5098   def input  parameter xTog-obj           as log no-undo .
     5099   def var  tt#          as   int                 no-undo .
     5100   def var tt-cost like  ub.gds-dtl.price-rubl no-undo .
     5101   def var tt-sale like  ub.gds-dtl.price-rubl no-undo .
     5102   define buffer a-supp         for ub.ot-supp-line .
     5103   define buffer buf_parts-attr for ub.parts-attr .
     5104    if x-sum-type = 'cost':U   then tt# = 0.
     5105    if x-sum-type = 'sale':U   then tt# = 3.
     5106    if x-sum-type = 'crsa':U   then tt# = 6.
     5107        FOR each post-ot-line where
     5108                 post-ot-line.artic        = x-artic
     5109           AND   post-ot-line.fact-order  <= x-fact-order-2  AND   post-ot-line.fact-order  >= x-fact-order-1
     5110           AND   post-ot-line.obj-code     = x-store-code
     5111           AND   post-ot-line.obj-type     = x-store-type
     5112           AND   post-ot-line.prod-code    = x-prod-code
     5113           AND   post-ot-line.prod-type    = x-prod-type
     5114           AND   post-ot-line.cli-code     = x-cli-code
     5115           AND   post-ot-line.cli-type     = x-cli-type
     5116           AND   post-ot-line.sum-type     = x-sum-type
     5117           AND   post-ot-line.cat-id       = x-cat-id
     5118           and   post-ot-line.ext-doc-type  =  'ie':U
     5119           no-lock :
     5120              ASSIGN prih[1 + tt#]   = prih[1 + tt#]   +  post-ot-line.fact-qnty
     5121                     prih[2 + tt#]   = prih[2 + tt#]   +  if tprintrubl then post-ot-line.sum-rubl else post-ot-line.sum-base
     5122                     prih[3 + tt#]   = prih[3 + tt#]   +  if tprintrubl then post-ot-line.vat-rubl else post-ot-line.vat-base  .
     5123                    .
     5124        End.
     5125        FOR each post-ot-line where
     5126                 post-ot-line.artic        = x-artic
     5127           AND   post-ot-line.fact-order  <= fact-order-4  AND   post-ot-line.fact-order  >= fact-order-3
     5128           AND   post-ot-line.obj-code     = x-store-code
     5129           AND   post-ot-line.obj-type     = x-store-type
     5130           AND   post-ot-line.prod-code    = x-prod-code
     5131           AND   post-ot-line.prod-type    = x-prod-type
     5132           AND   post-ot-line.cli-code     = x-cli-code
     5133           AND   post-ot-line.cli-type     = x-cli-type
     5134           AND   post-ot-line.sum-type     = x-sum-type
     5135           AND   post-ot-line.cat-id       = x-cat-id
     5136           and   post-ot-line.ext-doc-type <> 'ie':U
     5137           no-lock :
     5138           For each ub.parts no-lock where
     5139                      ub.parts.artic      =  post-ot-line.artic
     5140                 AND  ub.parts.prod-code  =  post-ot-line.prod-code
     5141                 AND  ub.parts.prod-type  =  post-ot-line.prod-type
     5142                 AND  ub.parts.supp-code  =  post-ot-line.cli-code
     5143                 AND  ub.parts.supp-type  =  post-ot-line.cli-type
     5144                 AND  ub.parts.obj-code   =  post-ot-line.obj-code
     5145                 AND  ub.parts.obj-type   =  post-ot-line.obj-type
     5146                 AND  ub.parts.out-code   =  post-ot-line.doc-code
     5147                 and  ub.parts.out-code   <>  ub.parts.in-code
     5148                 ,
     5149          first buf_parts-attr no-lock where
     5150                 buf_parts-attr.in-code   = ub.parts.in-code
     5151             and buf_parts-attr.gds-code  = x-gds-code
     5152             and buf_parts-attr.part-code = ub.parts.part-code        ,
     5153          first a-supp no-lock  where
     5154               a-supp.doc-code     = buf_parts-attr.income-in-code and
     5155               a-supp.artic        = x-artic        and
     5156               a-supp.fact-order  <= fact-order-2   AND
     5157               a-supp.fact-order  >= fact-order-1   and
     5158               a-supp.obj-code     = x-store-code   and
     5159               a-supp.obj-type     = x-store-type   and
     5160               a-supp.prod-code    = x-prod-code    and
     5161               a-supp.prod-type    = x-prod-type    and
     5162               a-supp.cli-code     = x-cli-code     and
     5163               a-supp.cli-type     = x-cli-type     and
     5164               a-supp.sum-type     = x-sum-type     and
     5165               a-supp.cat-id       = x-cat-id      and
     5166                (  a-supp.ext-doc-type = 'ie':U  or
     5167                   a-supp.ext-doc-type = 'vt':U        or
     5168                   a-supp.ext-doc-type = 'vp':U      )                 :
     5169                 if tt# = 0  then DO:  end.
     5170                 if tt# = 3  then DO:  end.
     5171                 if tt# = 6  then DO:  end.
     5172           CASE post-ot-line.ext-doc-type:
     5173                WHEN         're':U      THEN DO :
     5174              ASSIGN vzvr[1 + tt#]   = vzvr[1 + tt#]   +  ub.parts.fact-qnty
     5175                     vzvr[2 + tt#]   = vzvr[2 + tt#]   +  if tprintrubl then  ( ub.parts.fact-qnty / post-ot-line.fact-qnty) * post-ot-line.sum-rubl else   ( ub.parts.fact-qnty / post-ot-line.fact-qnty) * post-ot-line.sum-base
     5176                     vzvr[3 + tt#]   = vzvr[3 + tt#]   +  if tprintrubl then  ( ub.parts.fact-qnty / post-ot-line.fact-qnty) * post-ot-line.vat-rubl else   ( ub.parts.fact-qnty / post-ot-line.fact-qnty) * post-ot-line.vat-base  .
     5177                    End.
     5178                WHEN       'ep':U    Then DO:
     5179              ASSIGN vzvr-post[1 + tt#]   = vzvr-post[1 + tt#]   +  ub.parts.fact-qnty
     5180                     vzvr-post[2 + tt#]   = vzvr-post[2 + tt#]   +  if tprintrubl then  ( ub.parts.fact-qnty / post-ot-line.fact-qnty) * post-ot-line.sum-rubl else  ( ub.parts.fact-qnty / post-ot-line.fact-qnty) * post-ot-line.sum-base
     5181                     vzvr-post[3 + tt#]   = vzvr-post[3 + tt#]   +  if tprintrubl then  ( ub.parts.fact-qnty / post-ot-line.fact-qnty) * post-ot-line.vat-rubl else   ( ub.parts.fact-qnty / post-ot-line.fact-qnty) * post-ot-line.vat-base  .
     5182                     End.
     5183                WHEN       'ee':U       THEN  DO:
     5184              ASSIGN rash[1 + tt#]   = rash[1 + tt#]   +  ub.parts.fact-qnty
     5185                     rash[2 + tt#]   = rash[2 + tt#]   +  if tprintrubl then   ( ub.parts.fact-qnty / post-ot-line.fact-qnty) * post-ot-line.sum-rubl else  ( ub.parts.fact-qnty / post-ot-line.fact-qnty) *  post-ot-line.sum-base
     5186                     rash[3 + tt#]   = rash[3 + tt#]   +  if tprintrubl then   ( ub.parts.fact-qnty / post-ot-line.fact-qnty) * post-ot-line.vat-rubl else  ( ub.parts.fact-qnty / post-ot-line.fact-qnty) *  post-ot-line.vat-base  .
     5187                    End.
     5188                WHEN      'we':U       THEN  DO:
     5189              ASSIGN spis[1 + tt#]   = spis[1 + tt#]   +  ub.parts.fact-qnty
     5190                     spis[2 + tt#]   = spis[2 + tt#]   +  if tprintrubl then  ( ub.parts.fact-qnty / post-ot-line.fact-qnty) *  post-ot-line.sum-rubl else  ( ub.parts.fact-qnty / post-ot-line.fact-qnty) *  post-ot-line.sum-base
     5191                     spis[3 + tt#]   = spis[3 + tt#]   +  if tprintrubl then  ( ub.parts.fact-qnty / post-ot-line.fact-qnty) *  post-ot-line.vat-rubl else  ( ub.parts.fact-qnty / post-ot-line.fact-qnty) *  post-ot-line.vat-base  .
     5192                    End.
     5193                WHEN       'es':U  OR
     5194                WHEN       'rs':U THEN  DO:
     5195              ASSIGN kassa[1 + tt#]   = kassa[1 + tt#]   +  ub.parts.fact-qnty
     5196                     kassa[2 + tt#]   = kassa[2 + tt#]   +  if tprintrubl then  ( ub.parts.fact-qnty / post-ot-line.fact-qnty) *  post-ot-line.sum-rubl else  ( ub.parts.fact-qnty / post-ot-line.fact-qnty) *  post-ot-line.sum-base
     5197                     kassa[3 + tt#]   = kassa[3 + tt#]   +  if tprintrubl then  ( ub.parts.fact-qnty / post-ot-line.fact-qnty) *  post-ot-line.vat-rubl else  ( ub.parts.fact-qnty / post-ot-line.fact-qnty) *  post-ot-line.vat-base .
     5198                    End.
     5199                when       'vt':U              or
     5200                when       'vp':U         or
     5201                when       'ap':U   or
     5202                when       'mp':U then  do:
     5203              ASSIGN INV[1 + tt#]   = INV[1 + tt#]   +  ub.parts.fact-qnty
     5204                     inv[2 + tt#]   = inv[2 + tt#]   +  if tprintrubl then  ( ub.parts.fact-qnty / post-ot-line.fact-qnty) *  post-ot-line.sum-rubl else  ( ub.parts.fact-qnty / post-ot-line.fact-qnty) *  post-ot-line.sum-base
     5205                     Inv[3 + tt#]   = Inv[3 + tt#]   +  if tprintrubl then  ( ub.parts.fact-qnty / post-ot-line.fact-qnty) *  post-ot-line.vat-rubl else  ( ub.parts.fact-qnty / post-ot-line.fact-qnty) *  post-ot-line.vat-base  .
     5206                    End.
     5207             WHEN   'pc':U      THEN  DO:
     5208              ASSIGN sm[1 + tt#]   = sm[1 + tt#]   +  ub.parts.fact-qnty
     5209                     sm[2 + tt#]   = sm[2 + tt#]   +  if tprintrubl then  ( ub.parts.fact-qnty / post-ot-line.fact-qnty) *  post-ot-line.sum-rubl else  ( ub.parts.fact-qnty / post-ot-line.fact-qnty) *  post-ot-line.sum-base
     5210                     sm[3 + tt#]   = sm[3 + tt#]   +  if tprintrubl then  ( ub.parts.fact-qnty / post-ot-line.fact-qnty) *  post-ot-line.vat-rubl else  ( ub.parts.fact-qnty / post-ot-line.fact-qnty) *  post-ot-line.vat-base  .
     5211                end.
     5212             End CASE.
     5213        End.
     5214      End.
     5215   END PROCEDURE.
     5216   PROCEDURE Calc-Sub-itog :
     5217   def input parameter tt as int no-undo.
     5218   def var b as int init 0 no-undo.
     5219   repeat b = 1 to 3 :
     5220     Assign
     5221     B1-sm[b + TT]    = B1-sm[b + TT]    +  sm[b + TT]
     5222     B2-sm[b + TT]    = B2-sm[b + TT]    +  sm[b + TT]
     5223     Bi-sm[b + TT]    = Bi-sm[b + TT]    +  sm[b + TT]
     5224      p-sm[b + TT]    =  p-sm[b + TT]    +  sm[b + TT]
     5225      o-sm[b + TT]    =  o-sm[b + TT]    +  sm[b + TT]
     5226     B1-Prih[b + TT]    = B1-Prih[b + TT]    +  Prih[b + TT]
     5227     B2-Prih[b + TT]    = B2-Prih[b + TT]    +  Prih[b + TT]
     5228     Bi-Prih[b + TT]    = Bi-Prih[b + TT]    +  Prih[b + TT]
     5229     p-Prih[b + TT]     = p-Prih[b + TT]     +  Prih[b + TT]
     5230     o-Prih[b + TT]     = o-Prih[b + TT]     +  Prih[b + TT]
     5231     B1-RAsh[b + TT]    = B1-RAsh[b + TT]    +  RAsh[b + TT]
     5232     B2-RAsh[b + TT]    = B2-RAsh[b + TT]    +  RAsh[b + TT]
     5233     Bi-RAsh[b + TT]    = Bi-RAsh[b + TT]    +  RAsh[b + TT]
     5234     p-RAsh[b + TT]     = p-RAsh[b + TT]      +  RAsh[b + TT]
     5235     o-RAsh[b + TT]     = o-RAsh[b + TT]      +  RAsh[b + TT]
     5236     B1-KAssa[b + TT]    = B1-KAssa[b + TT]    +  KAssa[b + TT]
     5237     B2-kassa[b + TT]    = B2-kassa[b + TT]    +  kassa[b + TT]
     5238     Bi-kassa[b + TT]    = Bi-kassa[b + TT]     +  kassa[b + TT]
     5239     p-kassa[b + TT]     = p-kassa[b + TT]      +  kassa[b + TT]
     5240     o-kassa[b + TT]     = o-kassa[b + TT]      +  kassa[b + TT]
     5241     B1-Inv[b + TT]    = B1-Inv[b + TT]    +  Inv[b + TT]
     5242     B2-Inv[b + TT]    = B2-Inv[b + TT]    +  Inv[b + TT]
     5243     Bi-Inv[b + TT]    = Bi-Inv[b + TT]    +  Inv[b + TT]
     5244     p-Inv[b + TT]    = p-Inv[b + TT]    +  Inv[b + TT]
     5245     o-Inv[b + TT]    = o-Inv[b + TT]    +  Inv[b + TT]
     5246     B1-vzvr[b + TT]    = B1-vzvr[b + TT]    + vzvr[b + TT]
     5247     B2-vzvr[b + TT]    = B2-vzvr[b + TT]    + vzvr[b + TT]
     5248     Bi-vzvr[b + TT]    = Bi-vzvr[b + TT]    + vzvr[b + TT]
     5249     p-vzvr[b + TT]    = p-vzvr[b + TT]    + vzvr[b + TT]
     5250     o-vzvr[b + TT]    = o-vzvr[b + TT]    + vzvr[b + TT]
     5251     B1-vzvr-post[b + TT]    = B1-vzvr-post[b + TT]    + vzvr-post[b + TT]
     5252     B2-vzvr-post[b + TT]    = B2-vzvr-post[b + TT]    + vzvr-post[b + TT]
     5253     Bi-vzvr-post[b + TT]    = Bi-vzvr-post[b + TT]    + vzvr-post[b + TT]
     5254     p-vzvr-post[b + TT]    = p-vzvr-post[b + TT]    + vzvr-post[b + TT]
     5255     o-vzvr-post[b + TT]    = o-vzvr-post[b + TT]    + vzvr-post[b + TT]
     5256   .
     5257   End.
     5258   END PROCEDURE.
     5259   PROCEDURE U-LINE :
     5260   UNDERLINE stream OutStream  sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 sym13
     5261           gds-zap-b-code
     5262           gds-zap-artic
     5263           gds-zap-gds-name
     5264           gds-zap-unit-base
     5265           gds-type
     5266           F-Prih
     5267           F-Rash
     5268           F-KAssa
     5269           F-Inv
     5270           F-vzvr
     5271           F-vzvr-post
     5272           F-spis
     5273           F-sm
     5274           with FRAME ZAPAS .
     5275           DOWN stream   OutStream 1 with FRAME ZAPAS.
     5276           END PROCEDURE.
     5277   procedure Print-Footer :
     5278   define input parameter Nx as integer no-undo .
     5279   define input parameter Name as char no-undo .
     5280       if Nx = 1 Then DO:
     5281            run di-qnty  ( "кол-во", 1,"","Итого по : ",trim ( name),"","b1").
     5282            if show-cost then do :     run di  (  "учет." , 2, "","","","","b1" ).  end.
     5283            if show-cost-vat then do : run di  (  "уч.НДС", 3, "","","","","b1" ).  end.
     5284            if show-sale then do :     run di  (  "док-т.", 5, "","","","","b1" ).  end.
     5285            if show-sale-vat then do : run di  (  "д. НДС", 6, "","","","","b1" ).  end.
     5286            if not sums-only then run u-line.
     5287            run clear-itemb1-.
     5288            end.
     5289    if nx = 2 then do:
     5290            run di-qnty  ( "кол-во", 1,"","","Итого по : " + trim ( name),"","b2").
     5291            if show-cost then do :      run di  (  "учет." , 2, "","","","","b2" ).  end.
     5292            if show-cost-vat  then do : run di  (  "уч.НДС", 3, "","","","","b2" ).  end.
     5293            if show-sale then do :      run di  (  "док-т.", 5, "","","","","b2" ).  end.
     5294            if show-sale-vat  then do : run di  (  "д. НДС", 6, "","","","","b2" ).  end.
     5295            if not sums-only then run u-line.
     5296            run clear-itemb2-.
     5297           end.
     5298    if nx = 3 then do:
     5299            if not sums-only then run u-line.
     5300            run di-qnty  ( "кол-во", 1,"","Итого по пост-ку" , trim ( name),"","p").
     5301            if show-cost then do :      run di  (  "учет." , 2, "","","","","p" ).  end.
     5302            if show-cost-vat  then do : run di  (  "уч.НДС", 3, "","","","","p" ).  end.
     5303            if show-sale then do :      run di  (  "док-т.", 5, "","","","","p" ).  end.
     5304            if show-sale-vat  then do : run di  (  "д. НДС", 6, "","","","","p" ).  end.
     5305            if not sums-only then run u-line.
     5306            run clear-itemp-.
     5307             end.
     5308    if nx = 0 then do:
     5309            run di-qnty  ( "кол-во", 1,"","Итого  объект: " , trim ( name),"","o").
     5310            if show-cost then do :      run di  (  "учет." , 2, "","","","","o" ).  end.
     5311            if show-cost-vat  then do : run di  (  "уч.НДС", 3, "","","","","o" ).  end.
     5312            if show-sale then do :      run di  (  "док-т.", 5, "","","","","o" ).  end.
     5313            if show-sale-vat  then do : run di  (  "д. НДС", 6, "","","","","o" ).  end.
     5314            if not sums-only then run u-line.
     5315            run clear-itemo-.
     5316             end.
     5317    END PROCEDURE.
     5318   PROCEDURE Clear-itemb1- :
     5319   def var kk as int no-undo.
     5320    REPEAT kk = 1 to 9:
     5321    Assign
     5322      b1-prih             [kk]  = 0
     5323      b1-rash             [kk]  = 0
     5324      b1-kassa            [kk]  = 0
     5325      b1-Inv              [kk]  = 0
     5326      b1-vzvr             [kk]  = 0
     5327      b1-vzvr-post        [kk]  = 0
     5328      b1-sm        [kk]  = 0
     5329      .
     5330          End.
     5331    END PROCEDURE.
     5332   PROCEDURE Clear-itemb2- :
     5333   def var kk as int no-undo.
     5334    REPEAT kk = 1 to 9:
     5335    Assign
     5336      b2-prih             [kk]  = 0
     5337      b2-rash             [kk]  = 0
     5338      b2-kassa            [kk]  = 0
     5339      b2-Inv              [kk]  = 0
     5340      b2-vzvr             [kk]  = 0
     5341      b2-vzvr-post        [kk]  = 0
     5342      b2-sm        [kk]  = 0
     5343      .
     5344      End.
     5345    END PROCEDURE.
     5346   PROCEDURE Clear-itemp- :
     5347   def var kk as int no-undo.
     5348    REPEAT kk = 1 to 9:
     5349    Assign
     5350      p-prih             [kk]  = 0
     5351      p-rash             [kk]  = 0
     5352      p-kassa            [kk]  = 0
     5353      p-Inv              [kk]  = 0
     5354      p-vzvr             [kk]  = 0
     5355      p-vzvr-post        [kk]  = 0
     5356      p-sm               [kk]  = 0
     5357      .
     5358      End.
     5359    END PROCEDURE.
     5360   PROCEDURE Clear-itemo- :
     5361   def var kk as int no-undo.
     5362    REPEAT kk = 1 to 9:
     5363    Assign
     5364      o-prih             [kk]  = 0
     5365      o-rash             [kk]  = 0
     5366      o-kassa            [kk]  = 0
     5367      o-Inv              [kk]  = 0
     5368      o-vzvr             [kk]  = 0
     5369      o-vzvr-post        [kk]  = 0
     5370      o-sm        [kk]  = 0
     5371      .
     5372      End.
     5373    END PROCEDURE.
     5374   Procedure Tmp-create :
     5375   define input parameter p1   like ub.clients.obj-code  no-undo .
     5376   define input parameter p2   like ub.clients.obj-type  no-undo .
     5377   define input parameter Name like ub.clients.obj-name  no-undo .
     5378   define input parameter p3   like obj-list.obj-code no-undo .
     5379   define input parameter p4   like obj-list.obj-type no-undo .
     5380     Create tmp-cli-gds.
     5381    def var kk as int no-undo.
     5382    REPEAT kk = 1 to 9 :
     5383      Assign
     5384         tmp-cli-gds.p-prih[kk]           = p-prih[kk]
     5385         tmp-cli-gds.p-rash[kk]           = p-rash[kk]
     5386         tmp-cli-gds.p-kassa[kk]          = p-kassa[kk]
     5387         tmp-cli-gds.p-Inv[kk]            = p-Inv[kk]
     5388         tmp-cli-gds.p-spis[kk]           = p-spis[kk]
     5389         tmp-cli-gds.p-vzvr[kk]           = p-vzvr[kk]
     5390         tmp-cli-gds.p-vzvr-post[kk]      = p-vzvr-post[kk]
     5391         tmp-cli-gds.p-sm[kk]             = p-sm[kk]
     5392         .
     5393    end.
     5394         assign
     5395         tmp-cli-gds.cli-code         = p1
     5396         tmp-cli-gds.cli-type         = p2
     5397         tmp-cli-gds.Name             = Name
     5398         tmp-cli-gds.obj-code         = p3
     5399         tmp-cli-gds.obj-type         = p4
     5400         .
     5401    END PROCEDURE.
     5402   Procedure Tmp-clear :
     5403    def var kk as int no-undo.
     5404    REPEAT kk = 1 to 9 :
     5405    Assign
     5406        p-prih[kk]          = 0
     5407        p-rash[kk]          = 0
     5408        p-kassa[kk]         = 0
     5409        p-Inv[kk]           = 0
     5410        p-spis[kk]          = 0
     5411        p-vzvr[kk]          = 0
     5412        p-vzvr-post[kk]     = 0
     5413        p-sm[kk]     = 0
     5414       .
     5415       end.
     5416   END PROCEDURE.
     5417   Procedure Tmp-assign :
     5418    def var kk as int no-undo.
     5419    REPEAT kk = 1 to 9 :
     5420       Assign
     5421       p-prih[kk]           = p-prih[kk]            + tmp-cli-gds.p-prih[kk]
     5422       p-rash[kk]           = p-rash[kk]            + tmp-cli-gds.p-rash[kk]
     5423       p-kassa[kk]          = p-kassa[kk]           + tmp-cli-gds.p-kassa[kk]
     5424       p-Inv[kk]            = p-Inv[kk]             + tmp-cli-gds.p-Inv[kk]
     5425       p-spis[kk]           = p-spis[kk]            + tmp-cli-gds.p-spis[kk]
     5426       p-vzvr[kk]           = p-vzvr[kk]            + tmp-cli-gds.p-vzvr[kk]
     5427       p-vzvr-post[kk]      = p-vzvr-post[kk]       + tmp-cli-gds.p-vzvr-post[kk]
     5428       p-sm[kk]             = p-sm[kk]       + tmp-cli-gds.p-sm[kk]
     5429       .
     5430    end.
     5431   END PROCEDURE.
