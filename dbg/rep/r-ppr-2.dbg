     4451                                               by temp-t-post-stk-line.fact-order :
     4452                                       if first-of( (temp-t-post-stk-line.artic + temp-t-post-stk-line.prod-type + string(temp-t-post-stk-line.prod-code)) ) then do : run goods-start. end .
     4453                                       if last-of ( (temp-t-post-stk-line.artic + temp-t-post-stk-line.prod-type + string(temp-t-post-stk-line.prod-code)) ) then do : run goods-end.
     4454                                          run display-line .
     4455                                       end.
     4456                                       if last-of( (temp-t-post-stk-line.cli-type + string(temp-t-post-stk-line.cli-code)) ) then do :
     4457                                          run tmp-create (temp-t-post-stk-line.cli-code,
     4458                                                          temp-t-post-stk-line.cli-type,
     4459                                                          temp-t-post-stk-line.clients-obj-name,
     4460                                                          obj-list.obj-code,
     4461                                                          obj-list.obj-type ) .
     4462                                          run tmp-clear.
     4463                                       end.
     4464             end.
     4465          end.
     4466          for each tmp-cli-gds no-lock
     4467              break
     4468              by tmp-cli-gds.name
     4469              by (tmp-cli-gds.cli-type + string(tmp-cli-gds.cli-code)) :
     4470              if first-of(tmp-cli-gds.cli-type + string(tmp-cli-gds.cli-code)) then run tmp-clear.
     4471               run tmp-assign.
     4472              if last-of((tmp-cli-gds.cli-type + string(tmp-cli-gds.cli-code))) then do:
     4473                  run print-footer ( 3 ,tmp-cli-gds.name).
     4474              end.
     4475          end.
     4476   End procedure.
     4477   procedure run45-0 :
     4478          for each obj-list no-lock :
     4479             for each temp-t-post-stk-line : delete temp-t-post-stk-line. end.
     4480             for each post-stk-line  no-lock where
     4481                     post-stk-line.obj-type = obj-list.obj-type and
     4482                     post-stk-line.obj-code = obj-list.obj-code and
     4483                     post-stk-line.fact-order >= null-fact-order   and
     4484                     post-stk-line.fact-order <= fact-order-2   and
     4485                     post-stk-line.sum-type    = 'cost':U    and
     4486                     post-stk-line.cat-id      = '##':U
     4487                     and can-find(first g#post  where  post-stk-line.cli-type = g#post.obj-type and  post-stk-line.cli-code = g#post.obj-code ) = TRUE
     4488                     ,
     4489                    each ub.goods no-lock where
     4490                         ub.goods.artic     = post-stk-line.artic     and
     4491                         ub.goods.prod-type = post-stk-line.prod-type and
     4492                         ub.goods.prod-code = post-stk-line.prod-code  and  can-find(first gds-list where  ub.goods.gds-code = gds-list.gds-code ) = TRUE
     4493                         :
     4494                    find first  temp-t-post-stk-line where
     4495                      temp-t-post-stk-line.cli-type  = post-stk-line.cli-type  and
     4496                      temp-t-post-stk-line.cli-code  = post-stk-line.cli-code   and
     4497                      temp-t-post-stk-line.artic     = post-stk-line.artic     and
     4498                      temp-t-post-stk-line.prod-type = post-stk-line.prod-type and
     4499                      temp-t-post-stk-line.prod-code = post-stk-line.prod-code no-lock no-error .
     4500                      if not available temp-t-post-stk-line then do:
     4501                         find first  prod-cli no-lock  where
     4502                                                   prod-cli.obj-type = post-stk-line.prod-type and
     4503                                                   prod-cli.obj-code = post-stk-line.prod-code
     4504                                                   no-error .
     4505                         find first  ub.clients  no-lock  where
     4506                                                   ub.clients.obj-type = post-stk-line.cli-type and
     4507                                                   ub.clients.obj-code = post-stk-line.cli-code no-error .
     4508                           run create-temp-t-post-stk-line .
     4509                    end.
     4510                    else do:
     4511                            assign
     4512                              temp-t-post-stk-line.fact-order = post-stk-line.fact-order  .
     4513                            .
     4514                    end.
     4515             end.
     4516             for each temp-t-post-stk-line no-lock   ,
     4517                    last temp-post-stk-line  where
     4518                                               temp-post-stk-line.fact-order <=  fact-order-2 and
     4519                                               temp-post-stk-line.cat-id     =  t#cat-id                         and
     4520                                               temp-post-stk-line.sum-type   =  t#sum-type                       and
     4521                                               temp-post-stk-line.artic      =  temp-t-post-stk-line.artic       and
     4522                                               temp-post-stk-line.prod-type  =  temp-t-post-stk-line.prod-type   and
     4523                                               temp-post-stk-line.prod-code  =  temp-t-post-stk-line.prod-code   and
     4524                                               temp-post-stk-line.obj-type   =  temp-t-post-stk-line.obj-type    and
     4525                                               temp-post-stk-line.obj-code   =  temp-t-post-stk-line.obj-code    and
     4526                                               temp-post-stk-line.cli-type   =  temp-t-post-stk-line.cli-type    and
     4527                                               temp-post-stk-line.cli-code   =  temp-t-post-stk-line.cli-code
     4528                                               no-lock
     4529                                               break
     4530                                               by ((temp-t-post-stk-line.cli-type + string(temp-t-post-stk-line.cli-code)))
     4531                                               by ((temp-t-post-stk-line.artic + temp-t-post-stk-line.prod-type + string(temp-t-post-stk-line.prod-code)))
     4532                                               by temp-t-post-stk-line.fact-order :
     4533                                       if first-of( (temp-t-post-stk-line.artic + temp-t-post-stk-line.prod-type + string(temp-t-post-stk-line.prod-code)) ) then do : run goods-start. end .
     4534                                       if last-of ( (temp-t-post-stk-line.artic + temp-t-post-stk-line.prod-type + string(temp-t-post-stk-line.prod-code)) ) then do : run goods-end.
     4535                                          run display-line .
     4536                                       end.
     4537                                       if last-of( (temp-t-post-stk-line.cli-type + string(temp-t-post-stk-line.cli-code)) ) then do :
     4538                                          run tmp-create (temp-t-post-stk-line.cli-code,
     4539                                                          temp-t-post-stk-line.cli-type,
     4540                                                          temp-t-post-stk-line.clients-obj-name,
     4541                                                          obj-list.obj-code,
     4542                                                          obj-list.obj-type ) .
     4543                                          run tmp-clear.
     4544                                       end.
     4545             end.
     4546          end.
     4547          for each tmp-cli-gds no-lock
     4548              break
     4549              by tmp-cli-gds.name
     4550              by (tmp-cli-gds.cli-type + string(tmp-cli-gds.cli-code)) :
     4551              if first-of(tmp-cli-gds.cli-type + string(tmp-cli-gds.cli-code)) then run tmp-clear.
     4552               run tmp-assign.
     4553              if last-of((tmp-cli-gds.cli-type + string(tmp-cli-gds.cli-code))) then do:
     4554                  run print-footer ( 3 ,tmp-cli-gds.name).
     4555              end.
     4556          end.
     4557   End procedure.
     4558   procedure Goods-start :
     4559   END PROCEDURE.
     4560   procedure Goods-end :
     4561   END PROCEDURE.
     4562   PROCEDURE display-line :
     4563     i = i + 1.
     4564   If Integer(10) = 0 Then Temp1  = 100  .
     4565                         Else Temp1 = Integer(10) .
     4566        IF ( i modulo Temp1 = 0 ) AND ( i >= Temp1 ) then
     4567            RUN waitfram-show( "Обработано строк : " + string( i )) .
     4568     run clear-item in this-procedure .
     4569       assign
     4570             gds-zap-gds-name   = temp-t-post-stk-line.gds-name
     4571             gds-zap-unit-base  = temp-t-post-stk-line.unit-base
     4572             gds-zap-prt-root   = temp-t-post-stk-line.prt-root
     4573             gds-zap-prod-type  = temp-t-post-stk-line.prod-type
     4574             gds-zap-prod-code  = temp-t-post-stk-line.prod-code
     4575             gds-zap-artic      = temp-t-post-stk-line.artic
     4576             gds-zap-grp-name   = temp-t-post-stk-line.Goods-grp-name
     4577             gds-zap-b-code     = temp-t-post-stk-line.gds-code
     4578             gds-zap-type       = temp-t-post-stk-line.gds-type
     4579             pos-cli-type       = temp-t-post-stk-line.Cli-type
     4580             pos-cli-code       = temp-t-post-stk-line.Cli-code
     4581             pos-cli-grp-name   = temp-t-post-stk-line.Clients-grp-name.
     4582        run ob-line  in this-procedure
     4583             (  temp-t-post-stk-line.gds-code,
     4584                temp-t-post-stk-line.obj-code    ,
     4585                temp-t-post-stk-line.obj-type    ,
     4586                temp-t-post-stk-line.cli-code    ,
     4587                temp-t-post-stk-line.cli-type    ,
     4588                temp-t-post-stk-line.artic       ,
     4589                temp-t-post-stk-line.prod-code   ,
     4590                temp-t-post-stk-line.prod-type   ,
     4591                Fact-order-1   ,
     4592                Fact-order-2   ,
     4593                t#sum-type     ,
     4594                t#cat-id       ,
     4595                ""             ,
     4596                yes) .
     4597      if Show-Sale or Show-Sale-vat Then  run ob-line  in this-procedure (
     4598                temp-t-post-stk-line.gds-code    ,
     4599                temp-t-post-stk-line.obj-code    ,
     4600                temp-t-post-stk-line.obj-type    ,
     4601                temp-t-post-stk-line.cli-code    ,
     4602                temp-t-post-stk-line.cli-type    ,
     4603                temp-t-post-stk-line.artic       ,
     4604                temp-t-post-stk-line.prod-code   ,
     4605                temp-t-post-stk-line.prod-type   ,
     4606                Fact-order-1   ,
     4607                Fact-order-2   ,
     4608                'sale':U    ,
     4609                '##':U ,
     4610                ""             ,
     4611                yes) .
     4612            run calc-sub-itog in this-procedure  ( 0 ).
     4613               if Show-Sale Then run calc-sub-itog in this-procedure ( 3 ).
     4614              IF NOT Sums-Only then DO:
     4615                 run display-str1 in this-procedure .
     4616              End.
     4617     END PROCEDURE.
     4618   PROCEDURE display-str1  :
     4619        run di-qnty ( "кол-во", 1, gds-zap-b-code,gds-zap-artic,gds-zap-gds-name,gds-zap-unit-base,"").
     4620            if show-cost        then do: run di ( "учет."  , 2 , "","", "", "", "":u).  end.
     4621            if show-cost-vat    then do: run di ( "уч.НДС" , 3 , "","", "", "", "":u).  end.
     4622            if show-sale        then do: run di ( "док-т." , 5 , "","", "", "", "":u).  end.
     4623            if show-sale-vat    then do: run di ( "д. НДС" , 6 , "","", "", "", "":u).  end.
     4624   END PROCEDURE.
     4625   PROCEDURE Di :
     4626   def input parameter p1 as char no-undo.
     4627   def input parameter p2 as int no-undo.
     4628   def input parameter p3 as char no-undo.
     4629   def input parameter p4 as char no-undo.
     4630   def input parameter p5 as char no-undo.
     4631   def input parameter p6 as char no-undo.
     4632   def input parameter p7 as char no-undo.
     4633    CASE CAPS ( p7) :
     4634      WHEN "P":U  Then
     4635                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 sym13
     4636                   p3 @ gds-zap-b-code
     4637                   p4 @ gds-zap-artic
     4638                   p5 @ gds-zap-gds-name
     4639                   p6 @ gds-zap-unit-base
     4640                   p1 @ gds-type
     4641                  p-vzvr      [p2]    @  F-vzvr
     4642                  p-vzvr-post [p2]    @  F-vzvr-post
     4643                  p-Prih      [p2]    @  F-Prih
     4644                  p-RAsh      [p2]    @  F-RAsh
     4645                  p-KAssa     [p2]    @  F-KAssa
     4646                  p-Inv       [p2]    @  F-Inv
     4647                  p-spis      [p2]    @  F-spis
     4648                  p-sm        [p2]    @  F-sm
     4649                  with FRAME ZAPAS .
     4650      WHEN "O":U  Then
     4651                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 sym13
     4652                   p3 @ gds-zap-b-code
     4653                   p4 @ gds-zap-artic
     4654                   p5 @ gds-zap-gds-name
     4655                   p6 @ gds-zap-unit-base
     4656                   p1 @ gds-type
     4657                  o-vzvr      [p2]    @  F-vzvr
     4658                  o-vzvr-post [p2]    @  F-vzvr-post
     4659                  o-Prih      [p2]    @  F-Prih
     4660                  o-RAsh      [p2]    @  F-RAsh
     4661                  o-KAssa     [p2]    @  F-KAssa
     4662                  o-Inv       [p2]    @  F-Inv
     4663                  o-spis      [p2]    @  F-spis
     4664                  o-sm        [p2]    @  F-sm
     4665                  with FRAME ZAPAS .
     4666      WHEN "B1":U  Then
     4667                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 sym13
     4668                   p3 @ gds-zap-b-code
     4669                   p4 @ gds-zap-artic
     4670                   p5 @ gds-zap-gds-name
     4671                   p6 @ gds-zap-unit-base
     4672                   p1 @ gds-type
     4673                  b1-vzvr      [p2]    @  F-vzvr
     4674                  b1-vzvr-post [p2]    @  F-vzvr-post
     4675                  b1-Prih      [p2]    @  F-Prih
     4676                  b1-RAsh      [p2]    @  F-RAsh
     4677                  b1-KAssa     [p2]    @  F-KAssa
     4678                  b1-Inv       [p2]    @  F-Inv
     4679                  b1-spis      [p2]    @  F-spis
     4680                  b1-sm        [p2]    @  F-sm
     4681                  with FRAME ZAPAS .
     4682      WHEN "B2":U  Then
     4683                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 sym13
     4684                   p3 @ gds-zap-b-code
     4685                   p4 @ gds-zap-artic
     4686                   p5 @ gds-zap-gds-name
     4687                   p6 @ gds-zap-unit-base
     4688                   p1 @ gds-type
     4689                  b2-vzvr      [p2]    @  F-vzvr
     4690                  b2-vzvr-post [p2]    @  F-vzvr-post
     4691                  b2-Prih      [p2]    @  F-Prih
     4692                  b2-RAsh      [p2]    @  F-RAsh
     4693                  b2-KAssa     [p2]    @  F-KAssa
     4694                  b2-Inv       [p2]    @  F-Inv
     4695                  b2-spis      [p2]    @  F-spis
     4696                  b2-sm        [p2]    @  F-sm
     4697                  with FRAME ZAPAS .
     4698      WHEN "BI":U Then
     4699                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 sym13
     4700                   p3 @ gds-zap-b-code
     4701                   p4 @ gds-zap-artic
     4702                   p5 @ gds-zap-gds-name
     4703                   p6 @ gds-zap-unit-base
     4704                   p1 @ gds-type
     4705                  bi-vzvr      [p2]    @  F-vzvr
     4706                  bi-vzvr-post [p2]    @  F-vzvr-post
     4707                  bi-Prih      [p2]    @  F-Prih
     4708                  bi-RAsh      [p2]    @  F-RAsh
     4709                  bi-KAssa     [p2]    @  F-KAssa
     4710                  bi-Inv       [p2]    @  F-Inv
     4711                  bi-spis      [p2]    @  F-spis
     4712                  bi-sm        [p2]    @  F-sm
     4713                  with FRAME ZAPAS .
     4714      WHEN ""  Then DO:
     4715                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 sym13
     4716                   p3 @ gds-zap-b-code
     4717                   p4 @ gds-zap-artic
     4718                   p5 @ gds-zap-gds-name
     4719                   p6 @ gds-zap-unit-base
     4720                   p1 @ gds-type
     4721                  vzvr      [p2]    @  F-vzvr
     4722                  vzvr-post [p2]    @  F-vzvr-post
     4723                  Prih      [p2]    @  F-Prih
     4724                  RAsh      [p2]    @  F-RAsh
     4725                  KAssa     [p2]    @  F-KAssa
     4726                  Inv       [p2]    @  F-Inv
     4727                  spis      [p2]    @  F-spis
     4728                  sm        [p2]    @  F-sm
     4729                  with FRAME ZAPAS .
     4730                 End.
     4731      End case.
     4732                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     4733    END PROCEDURE.
     4734   PROCEDURE Di-qnty :
     4735   def input parameter p1 as char no-undo.
     4736   def input parameter p2 as int no-undo.
     4737   def input parameter p3 as char no-undo.
     4738   def input parameter p4 as char no-undo.
     4739   def input parameter p5 as char no-undo.
     4740   def input parameter p6 as char no-undo.
     4741   def input parameter p7 as char no-undo.
     4742    CASE CAPS ( p7) :
     4743      WHEN "P":U  Then DO :
     4744                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 sym13
     4745                   p3 @ gds-zap-b-code
     4746                   p4 @ gds-zap-artic
     4747                   p5 @ gds-zap-gds-name
     4748                   p6 @ gds-zap-unit-base
     4749                   p1 @ gds-type
     4750                  p-vzvr      [p2]    @  F-vzvr
     4751                  p-vzvr-post [p2]    @  F-vzvr-post
     4752                  p-Prih      [p2]    @  F-Prih
     4753                  p-RAsh      [p2]    @  F-RAsh
     4754                  p-KAssa     [p2]    @  F-KAssa
     4755                  p-Inv       [p2]    @  F-Inv
     4756                  p-spis      [p2]    @  F-spis
     4757                  p-sm        [p2]    @  F-sm
     4758                  with FRAME ZAPAS .
     4759       if Make-Excel then  put   stream ForExcel unformatted p3 CHR(9)
     4760                   p4 CHR(9)
     4761                   p5 CHR(9)
     4762                   p6 CHR(9)
     4763                   gds-zap-type CHR(9)
     4764                   p-Prih[1]  CHR(9)
     4765   if Showcost       then (     excel-sum(p-Prih [2]) + CHR(9)   ) else ("")
     4766   if Show-cost-vat  then (     excel-sum  (   p-Prih [3]) + CHR(9)   ) else ("")
     4767   if Showsale       then (     excel-sum  (   p-Prih [5]) + CHR(9)   ) else ("")
     4768   if Show-sale-vat  then (     excel-sum  (   p-Prih [6]) + CHR(9)   ) else ("")
     4769                     p-RAsh         [1] FORMAT "->>>>>>>>>>>9.<<<"  CHR(9)
     4770   if Showcost       then (     excel-sum  (   p-RAsh[2] )  + CHR(9)   ) else ("")
     4771   if Show-cost-vat  then (     excel-sum  (   p-RAsh[3] )  + CHR(9)   ) else ("")
     4772   if Showsale       then (     excel-sum  (   p-RAsh[5] )  + CHR(9)   ) else ("")
     4773   if Show-sale-vat  then (     excel-sum  (   p-RAsh[6] )  + CHR(9)   ) else ("")
     4774                    p-KAssa        [1] FORMAT "->>>>>>>>>>>9.<<<"  CHR(9)
     4775   if Showcost       then (     excel-sum  (   p-KAssa[2])  + CHR(9)    ) else ("")
     4776   if Show-cost-vat  then (     excel-sum  (   p-KAssa[3])  + CHR(9)    ) else ("")
     4777   if Showsale       then (     excel-sum  (   p-KAssa[5])  + CHR(9)    ) else ("")
     4778   if Show-sale-vat  then (     excel-sum  (   p-KAssa[6])  + CHR(9)    ) else ("")
     4779   .
     4780   if Make-Excel then  put   stream ForExcel unformatted     p-Inv            [1] FORMAT "->>>>>>>>>>>9.<<<"  CHR(9)
     4781   if Showcost       then (     excel-sum  (   p-Inv [2] ) + CHR(9)    ) else ("")
     4782   if Show-cost-vat  then (     excel-sum  (   p-Inv [3] ) + CHR(9)    ) else ("")
     4783   if Showsale       then (     excel-sum  (   p-Inv [5] ) + CHR(9)    ) else ("")
     4784   if Show-sale-vat  then (     excel-sum  (   p-Inv [6] ) + CHR(9)    ) else ("")
     4785                    p-vzvr         [1] FORMAT "->>>>>>>>>>>9.<<<"  CHR(9)
     4786   if Showcost       then (     excel-sum  (   p-vzvr [2] ) + CHR(9)    ) else ("")
     4787   if Show-cost-vat  then (     excel-sum  (   p-vzvr [3] ) + CHR(9)    ) else ("")
     4788   if Showsale       then (     excel-sum  (   p-vzvr [5] ) + CHR(9)    ) else ("")
     4789   if Show-sale-vat  then (     excel-sum  (   p-vzvr [6] ) + CHR(9)    ) else ("")
     4790                   p-vzvr-post    [1] FORMAT "->>>>>>>>>>>9.<<<"  CHR(9)
     4791   if Showcost       then (     excel-sum  (   p-vzvr-post[2] ) + CHR(9)     ) else ("")
     4792   if Show-cost-vat  then (     excel-sum  (   p-vzvr-post[3] ) + CHR(9)     ) else ("")
     4793   if Showsale       then (     excel-sum  (   p-vzvr-post[5] ) + CHR(9)     ) else ("")
     4794   if Show-sale-vat  then (     excel-sum  (   p-vzvr-post[6] ) + CHR(9)     ) else ("")
     4795            chr(10).
     4796                   End.
     4797      WHEN "O":U  Then DO :
     4798                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 sym13
     4799                   p3 @ gds-zap-b-code
     4800                   p4 @ gds-zap-artic
     4801                   p5 @ gds-zap-gds-name
     4802                   p6 @ gds-zap-unit-base
