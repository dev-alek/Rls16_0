     4220                 if last-of( temp-t-post-stk-line.goods-grp-name )  then do : run print-footer ( 1, temp-t-post-stk-line.goods-grp-name ). end.
     4221             End.
     4222            if t#kol-rec-obj > 1 THEN run print-footer ( 0, '(' + obj-list.obj-type + ' ' + trim(string(obj-list.obj-code)) + ') ' + obj-list.obj-name).
     4223           .
     4224          End.
     4225     .
     4226     End.
     4227   End case.
     4228   End procedure.
     4229   procedure Print-Header :
     4230   define input parameter N as integer no-undo .
     4231   define input parameter Name as char no-undo .
     4232   PUT stream  OutStream  UNFORMATTED trim(Name) AT ((N - 1) * 10 ) format "x(100)" skip.
     4233   if Make-Excel then  put   stream ForExcel unformatted fill(" " + CHR(9), N - 1) trim(Name) skip.
     4234   END PROCEDURE.
