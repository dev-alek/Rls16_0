     1486           Line format "X(194)" AT 1
     1487      with width 232 down stream-io use-text NO-BOX.
     1488   procedure create-temp-t-post-stk-line :
     1489       define variable str  as char      format "X(60)" no-undo.
     1490       define variable str2 as char      no-undo.
     1491       define variable v-r  as character no-undo init "" .
     1492       define variable i#i  as int       no-undo.
     1493    do
     1494    on error undo, return error return-value
     1495    :
     1496    if available ub.goods and
     1497       available ub.clients and
     1498       available prod-cli then do:
     1499     create temp-t-post-stk-line .
     1500     BUFFER-COPY post-stk-line  TO temp-t-post-stk-line
     1501     assign
     1502       temp-t-post-stk-line.goods-grp-name    = ub.goods.grp-name
     1503       temp-t-post-stk-line.gds-code          = ub.goods.gds-code
     1504       temp-t-post-stk-line.unit-base         = ub.goods.unit-base
     1505       temp-t-post-stk-line.prt-root          = ub.goods.prt-root
     1506       temp-t-post-stk-line.gds-type          = ub.goods.gds-type
     1507       temp-t-post-stk-line.gds-name          = if g#gds-engl then ub.goods.engl-name else ub.goods.gds-name
     1508       temp-t-post-stk-line.clients-grp-name  = ub.clients.grp-name
     1509       temp-t-post-stk-line.clients-obj-name  = ub.clients.obj-name
     1510       temp-t-post-stk-line.prod-cli-obj-name = prod-cli.obj-name
     1511       temp-t-post-stk-line.prod-cli-obj-code = prod-cli.obj-code
     1512       temp-t-post-stk-line.prod-cli-obj-type = prod-cli.obj-type
     1513     .
     1514               if xlavel > 0 then
     1515               do:
     1516                   repeat i#i =1 to xlavel:
     1517                       if i#i =1 then str   = entry(1,ub.goods.grp-name, chr(47)) .
     1518                       else
     1519                       do:
     1520                           str2 = entry(i#i,ub.goods.grp-name, chr(47)) no-error.
     1521                           if not error-status:error  and str2 <> "":u then
     1522                               str = str +  chr(47) +  entry(i#i,ub.goods.grp-name, chr(47)) no-error .
     1523                       end.
     1524                   end.
     1525                   if str <> ? then
     1526                   do:
     1527                       temp-t-post-stk-line.goods-grp-name = str + chr(47) .
     1528                   end.
     1529               end.
     1530               else
     1531               do :
     1532                   temp-t-post-stk-line.goods-grp-name = ub.goods.grp-name.
     1533               end.
     1534           end.
     1535    end.
     1536   end procedure.
     1537   define temp-table temp-font no-undo
     1538     field fontnum  as integer
     1539     field fontname as character
     1540     field fontsize as character
     1541     field fonttype as character
     1542     field font-h   as integer
     1543     field font-w   as integer
     1544     field v-row    as integer
     1545     field v-col    as integer
     1546     field v-row-lans as integer
     1547     field v-col-lans as integer
     1548   index pi fontnum
     1549   .
     1550   procedure get-font-ini :
     1551     do
     1552     on error undo, return error return-value
     1553     :
     1554   define variable ii as integer   no-undo .
     1555   define variable v-font7 as character no-undo .
     1556   define variable v-font as character no-undo .
     1557   define variable loc-name as character no-undo .
     1558   define variable loc-size as character no-undo .
     1559   define variable loc-type as character no-undo .
     1560   define variable old_H as integer   no-undo .
     1561   define variable old_w as integer   no-undo .
     1562   define variable old-row  as integer   no-undo .
     1563   define variable old-col  as integer   no-undo .
     1564   define variable old-row-lans  as integer   no-undo .
     1565   define variable old-col-lans  as integer   no-undo .
     1566   define variable vv as integer   no-undo .
     1567   empty temp-table temp-font.
     1568     GET-KEY-VALUE SECTION "fonts" KEY "font7" VALUE v-font7 .
     1569       case num-entries (v-font7) :
     1570         when 4 then do:
     1571             assign
     1572               loc-name = entry ( 1 , v-font7 )
     1573               loc-size = entry ( 2 , v-font7 )
     1574               loc-type = entry ( 3 , v-font7 ) + "," +  entry ( 4 , v-font7 )
     1575             .
     1576         end.
     1577         when 3 then do:
     1578             assign
     1579               loc-name = entry ( 1 , v-font7 )
     1580               loc-size = entry ( 2 , v-font7 )
     1581               loc-type = entry ( 3 , v-font7 )
     1582             .
     1583         end.
     1584         when 2 then  do:
     1585             assign
     1586               loc-name = entry ( 1 , v-font7 )
     1587               loc-size = entry ( 2 , v-font7 )
     1588               loc-type = ""
     1589             .
     1590         end.
     1591         when 1 then do:
     1592             assign
     1593               loc-name = trim(entry ( 1 , v-font7 ))
     1594               loc-size = ""
     1595               loc-type = ""
     1596             .
     1597         end.
     1598       end case.
     1599     create temp-font.
     1600     assign
     1601       temp-font.fontnum  = 7
     1602       temp-font.fontname = trim(loc-name)
     1603       temp-font.fontsize = trim(loc-size)
     1604       temp-font.fonttype = trim(loc-type)
     1605       temp-font.v-row    = 62
     1606       temp-font.v-col    = 136
     1607       temp-font.v-row-lans = 43
     1608       temp-font.v-col-lans = 198
     1609     .
     1610     repeat ii = 16 to 100 :
     1611       get-key-value section 'fonts' key 'font' + string(ii)   value v-font  .
     1612       if v-font = "" or v-font = ? then leave.
     1613       case num-entries (v-font) :
     1614         when 4 then do:
     1615             assign
     1616               loc-name = entry ( 1 , v-font )
     1617               loc-size = entry ( 2 , v-font )
     1618               loc-type = entry ( 3 , v-font ) + "," +  entry ( 4 , v-font )
     1619             .
     1620         end.
     1621         when 3 then do:
     1622             assign
     1623               loc-name = entry ( 1 , v-font )
     1624               loc-size = entry ( 2 , v-font )
     1625               loc-type = entry ( 3 , v-font )
     1626             .
     1627         end.
     1628         when 2 then do:
     1629             assign
     1630               loc-name = entry ( 1 , v-font )
     1631               loc-size = entry ( 2 , v-font )
     1632               loc-type = ""
     1633             .
     1634         end.
     1635         when 1 then do:
     1636             assign
     1637               loc-name = trim(entry ( 1 , v-font ))
     1638               loc-size = ""
     1639               loc-type = ""
     1640             .
     1641         end.
     1642       end case.
     1643     create temp-font.
     1644     assign
     1645       temp-font.fontnum  = ii
     1646       temp-font.fontname = trim(loc-name)
     1647       temp-font.fontsize = trim(loc-size)
     1648       temp-font.fonttype = trim(loc-type)
     1649     .
     1650     end.
     1651       for each temp-font :
     1652          vv = integer(entry(2,temp-font.fontsize, "=" )) no-error .
     1653          if  vv = ? then vv =  0 .
     1654           run rep/exfont.p (
     1655             input   temp-font.fontname ,
     1656             input   vv ,
     1657             input   temp-font.fonttype ,
     1658             output  temp-font.font-h   ,
     1659             output  temp-font.font-w   )
     1660           .
     1661       end.
     1662   find first temp-font where  temp-font.fontnum  = 7  .
     1663   old_H = temp-font.font-H .
     1664   old_w = temp-font.font-W .
     1665   old-row = temp-font.v-row .
     1666   old-col = temp-font.v-col .
     1667   old-row-lans = temp-font.v-row-lans .
     1668   old-col-lans = temp-font.v-col-lans .
     1669       for each temp-font where
     1670                temp-font.fontnum  <> 7 :
     1671           assign
     1672               temp-font.v-row    = old_H * old-row / temp-font.font-h
     1673               temp-font.v-col    = old_W * old-col / temp-font.font-W
     1674               temp-font.v-row-lans    = old_H * old-row-lans / temp-font.font-h
     1675               temp-font.v-col-lans    = old_W * old-col-lans / temp-font.font-W
     1676           .
     1677       end.
     1678     end.
     1679   end procedure.
     1680   PROCEDURE How-name :
     1681   define input  parameter h as integer no-undo .
     1682   define input  parameter w as integer no-undo .
     1683   define output parameter n as character  no-undo .
     1684   define variable A4port-H as integer   no-undo init 63.
     1685   define variable A4port-W as integer   no-undo init 136.
     1686   define variable A4lans-H as integer   no-undo init 43.
     1687   define variable A4lans-W as integer   no-undo init 198.
     1688   define variable Strim-W  as integer   no-undo init 278.
     1689   run define-a4-size (
     1690        input ReportFontNum
     1691       ,output A4port-H
     1692       ,output A4port-W
     1693       ,output A4lans-H
     1694       ,output A4lans-W ).
     1695   If w >= 1 and w <= A4port-W Then DO:
     1696     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     1697     If h > A4lans-H  and h <= A4port-H Then n = "A4-port":U.
     1698     If h > A4port-H              Then n = "to-file":U.
     1699   End.
     1700   If w > A4port-W and w <= A4lans-W Then DO:
     1701     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     1702     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     1703     If h > A4port-H              Then n = "to-file":U.
     1704   End.
     1705   If w > A4lans-W and w <= Strim-W Then DO:
     1706     If h >= 1  and h <= A4lans-H Then n = "to-file":U.
     1707     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     1708     If h > A4port-H              Then n = "to-file":U.
     1709   End.
     1710   If w > Strim-W Then DO:
     1711      n = "to-file":U.
     1712   End.
     1713   END PROCEDURE.
     1714   PROCEDURE define-a4-size :
     1715   define input  parameter p-ReportFontNum as integer   no-undo .
     1716   define output parameter A4port-H as integer   no-undo .
     1717   define output parameter A4port-W as integer   no-undo .
     1718   define output parameter A4lans-H as integer   no-undo .
     1719   define output parameter A4lans-W as integer   no-undo .
     1720   if not can-find (first temp-font ) then do:
     1721      run get-font-ini .
     1722   end.
     1723   find first temp-font where temp-font.fontnum = p-ReportFontNum no-error .
     1724   if available temp-font then do:
     1725   assign
     1726     A4port-H = temp-font.v-row
     1727     A4port-W = temp-font.v-col
     1728     A4lans-H = temp-font.v-row-lans
     1729     A4lans-W = temp-font.v-col-lans
     1730   .
     1731   end.
     1732   else do:
     1733   assign
     1734     A4port-H = 63
     1735     A4port-W = 136
     1736     A4lans-H = 43
     1737     A4lans-W = 198
     1738   .
     1739   end.
     1740   END PROCEDURE.
     1741   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1742   procedure factord :
     1743     define input  parameter p-fact-date            as date    no-undo .
     1744     define input  parameter p-fact-time            as integer no-undo .
     1745     define input  parameter p-fact-num             as integer no-undo .
     1746     define input  parameter p-shift-date           as date    no-undo .
     1747     define input  parameter p-shift-num            as integer no-undo .
     1748     define input  parameter p-shift-on             as logical no-undo .
     1749     define output parameter p-fact-order           as decimal no-undo .
     1750     define output parameter p-shift-end-fact-order as decimal no-undo .
     1751     define output parameter p-day-end-fact-order   as decimal no-undo .
     1752     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     1753     if p-fact-date = ?
     1754     then do:
     1755       return error "Не указана фактическая дата" .
     1756     end.
     1757     define variable v-fact-date-num as integer no-undo .
     1758     assign
     1759       v-fact-date-num = integer(p-fact-date)
     1760     .
     1761     if p-fact-num = ?
     1762     or p-fact-num = 0
     1763     then do:
     1764       return error "Не задан p-fact-num " + string(p-fact-num) .
     1765     end.
     1766     if p-fact-num < 0
     1767     then do:
     1768       return error "Отрицательный fact-num " + string(p-fact-num) .
     1769     end.
     1770     if p-fact-num >= 100000000
     1771     then do:
     1772       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     1773     end.
     1774     if p-shift-on = true
     1775     then do:
     1776       if p-shift-date = ?
     1777       then do:
     1778         return error "Не задана дата смены" .
     1779       end.
     1780       if p-shift-num = ?
     1781       or p-shift-num = 0
     1782       then do:
     1783         return error "Не задан номер смены" .
     1784       end.
     1785     end.
     1786     else do:
     1787       assign
     1788         p-shift-date = p-fact-date
     1789         p-shift-num  = 24
     1790       .
     1791     end.
     1792     define variable v-shift-offset as integer no-undo .
     1793     if p-shift-date = p-fact-date
     1794     then do:
     1795       assign
     1796         v-shift-offset = 1
     1797       .
     1798     end.
     1799     if p-shift-date < p-fact-date
     1800     then do:
     1801       assign
     1802         v-shift-offset = 0
     1803       .
     1804     end.
     1805     if p-shift-date > p-fact-date
     1806     then do:
     1807       message
     1808         vss-workfile vss-revision vss-description skip
     1809         "Неправильная дата закрытия смены" skip
     1810         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     1811         view-as alert-box error .
     1812       undo, return error
     1813         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     1814           ,string(p-fact-date, '99/99/9999':U)
     1815           ,string(p-shift-date, '99/99/9999':U)
     1816           )
     1817       .
     1818     end.
     1819     if p-shift-num < 1
     1820     or p-shift-num > 24
     1821     then do:
     1822       message
     1823         vss-workfile vss-revision vss-description skip
     1824         "Неправильный номер смены" skip
     1825         "p-shift-num" p-shift-num skip
     1826         view-as alert-box error .
     1827       undo, return error return-value .
     1828     end.
     1829     assign
     1830       p-fact-order           = v-fact-date-num
     1831                              + v-shift-offset * 0.5
     1832                              + p-shift-num    * 0.02 - 0.01
     1833                              + p-fact-num     * 0.0000000001
     1834       p-shift-end-fact-order = v-fact-date-num
     1835                              + v-shift-offset * 0.5
     1836                              + p-shift-num    * 0.02
     1837       p-day-end-fact-order   = v-fact-date-num
     1838                              + 0.99
     1839     .
     1840     if p-fact-order           <= v-fact-date-num
     1841     or p-shift-end-fact-order <= v-fact-date-num
     1842     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     1843     or p-shift-end-fact-order >= p-day-end-fact-order
     1844     then do:
     1845       message
     1846         vss-workfile vss-revision vss-description skip
     1847         "Внутренняя ошибка при генерации фактического номера" skip
     1848         "p-fact-date"            p-fact-date            skip
     1849         "p-fact-time"            p-fact-time            skip
     1850         "p-fact-num"             p-fact-num             skip
     1851         "p-shift-date"           p-shift-date           skip
     1852         "p-shift-num"            p-shift-num            skip
     1853         "p-shift-on"             p-shift-on             skip
     1854         "p-shift-end-fact-order" p-shift-end-fact-order skip
     1855         "p-day-end-fact-order"   p-day-end-fact-order   skip
     1856         "v-fact-date-num"        v-fact-date-num        skip
     1857         view-as alert-box error .
     1858       undo, return error return-value .
     1859     end.
     1860   end procedure.
     1861   procedure day-begin-fact-order :
     1862     define input  parameter p-fact-date            as date    no-undo .
     1863     define output parameter p-day-begin-fact-order as decimal no-undo .
     1864     do
     1865     on error undo, return error return-value
     1866     :
     1867       if p-fact-date = ?
     1868       then do:
     1869         assign
     1870           p-day-begin-fact-order = 0
     1871         .
     1872       end.
     1873       else do:
     1874         assign
     1875           p-day-begin-fact-order = integer(p-fact-date)
     1876         .
     1877       end.
     1878     end.
     1879   end procedure.
     1880   procedure factord-max-fact-order :
     1881     define output parameter p-max-fact-order as decimal   no-undo .
     1882     do
     1883     on error undo, return error return-value
     1884     :
     1885       run day-begin-fact-order in this-procedure
     1886         (input  date(1, 1, 5000)
     1887         ,output p-max-fact-order
     1888         ) .
     1889     end.
     1890   end procedure.
     1891   procedure factord-cut-archive :
     1892     define input  parameter p-obj-type             as character no-undo .
     1893     define input  parameter p-obj-code             as integer   no-undo .
     1894     define input  parameter p-fact-date            as date      no-undo .
     1895     define output parameter p-shift-on             as logical   no-undo .
     1896     define output parameter p-shift-date           as date      no-undo .
     1897     define output parameter p-shift-num            as integer   no-undo .
     1898     define output parameter p-day-end-fact-order   as decimal   no-undo .
     1899     define output parameter p-shift-end-fact-order as decimal   no-undo .
     1900     define variable v-fact-order as decimal   no-undo .
     1901     define buffer buf_shift-obj for ub.shift-obj .
     1902     do
     1903     on error undo, return error return-value
     1904     :
     1905   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1906   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1907     (input  p-obj-type
     1908     ,input  p-obj-code
     1909     ,input  'shift-on=request'
     1910     ,output p-shift-on
     1911     ) no-error .
     1912       if error-status :error
     1913       then do:
     1914         message
     1915           vss-workfile vss-revision vss-description skip
     1916           "Ошибка при определении атрибута объекта" skip
     1917           "Объект" p-obj-type p-obj-code skip
     1918           error-status :get-message(1) skip
     1919           return-value skip
     1920           view-as alert-box error .
     1921         undo, return error return-value .
     1922       end.
     1923       if p-shift-on = false
     1924       then do:
     1925         assign
     1926           p-shift-date               = ?
     1927           p-shift-num                = 0
     1928         .
     1929       end.
     1930       else do:
     1931         find first buf_shift-obj share-lock
     1932           where buf_shift-obj.obj-type   = p-obj-type
     1933             and buf_shift-obj.obj-code   = p-obj-code
     1934             and buf_shift-obj.shift-date > p-fact-date
     1935           use-index pi
     1936           no-error .
     1937         if not available buf_shift-obj
     1938         or buf_shift-obj.status_ <> 'зкр':U
     1939         then do:
     1940           message
     1941             vss-workfile vss-revision vss-description skip
     1942             "Невозможно вычислить последнюю смену" skip
     1943             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1944             "Объект" p-obj-type p-obj-code skip
     1945             "Дата" p-fact-date skip
     1946             view-as alert-box error .
     1947           undo, return error return-value .
     1948         end.
     1949         find last buf_shift-obj share-lock
     1950           where buf_shift-obj.obj-type = p-obj-type
     1951             and buf_shift-obj.obj-code = p-obj-code
     1952             and buf_shift-obj.shift-date <= p-fact-date
     1953           use-index pi
     1954           no-error .
     1955         if available buf_shift-obj
     1956         then do:
     1957           if  buf_shift-obj.status_ = 'зкр':U
     1958           then do:
     1959             assign
     1960               p-shift-date = buf_shift-obj.shift-date
     1961               p-shift-num  = buf_shift-obj.shift-num
     1962             .
     1963           end.
     1964           else do:
     1965             message
     1966               vss-workfile vss-revision vss-description skip
     1967               "Невозможно вычислить последнюю смену" skip
     1968               "Статус смены отличен от статуса" 'зкр':U skip
     1969               "Объект" p-obj-type p-obj-code skip
     1970               "Дата" p-fact-date skip
     1971               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1972               view-as alert-box error .
     1973             undo, return error return-value .
     1974           end.
     1975         end.
     1976         else do:
     1977           assign
     1978             p-shift-date = p-fact-date - 1
     1979             p-shift-num  = 1
     1980           .
     1981         end.
     1982       end.
     1983       run factord in this-procedure
     1984         (input  p-fact-date
     1985         ,input  1
     1986         ,input  1
     1987         ,input  p-shift-date
     1988         ,input  p-shift-num
     1989         ,input  p-shift-on
     1990         ,output v-fact-order
     1991         ,output p-shift-end-fact-order
     1992         ,output p-day-end-fact-order
     1993         ) no-error .
     1994       if error-status :error
     1995       then do:
     1996         message
     1997           vss-workfile vss-revision vss-description skip
     1998           "Ошибка при вызове процедуры factord"
     1999           error-status :get-message(1) skip
     2000           return-value skip
     2001           view-as alert-box error .
     2002         undo, return error return-value .
     2003       end.
     2004     end.
     2005   end procedure.
     2006   procedure factord-lock-shift :
     2007     define input  parameter p-obj-type  as character no-undo .
     2008     define input  parameter p-obj-code  as integer   no-undo .
     2009     define input  parameter p-fact-date as date      no-undo .
     2010     define parameter buffer buf_shift-obj for ub.shift-obj .
     2011     define variable v-shift-on      as logical   no-undo .
     2012     define variable v-extra-message as character no-undo .
     2013     define variable v-error as character no-undo .
     2014     do
     2015     on error undo, return error return-value
     2016     :
     2017   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2018   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     2019     (input  p-obj-type
     2020     ,input  p-obj-code
     2021     ,input  'shift-on=request'
     2022     ,output v-shift-on
     2023     ) no-error .
     2024       if error-status :error
     2025       then do:
     2026         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     2027         undo, return error v-error .
     2028       end.
     2029       if v-shift-on = true
     2030       then do:
     2031         find first buf_shift-obj share-lock
     2032           where buf_shift-obj.obj-type   = p-obj-type
     2033             and buf_shift-obj.obj-code   = p-obj-code
     2034             and buf_shift-obj.shift-date > p-fact-date
     2035           use-index pi
     2036           no-error .
     2037         if not available buf_shift-obj
     2038         or buf_shift-obj.status_ <> 'зкр':U
     2039         then do:
     2040           find last buf_shift-obj
     2041             where buf_shift-obj.obj-type = p-obj-type
     2042               and buf_shift-obj.obj-code = p-obj-code
     2043               and buf_shift-obj.status_  = 'зкр':U
     2044             use-index stts
     2045             no-error .
     2046           if available buf_shift-obj
     2047           then do:
     2048             assign
     2049               v-extra-message =
     2050                     substitute("Дата начала последеней закрытой смены на объекте &1"
     2051                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     2052                               )
     2053             .
     2054           end.
     2055           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     2056           undo, return error v-error .
     2057         end.
     2058       end.
     2059     end.
     2060   end procedure.
     2061   procedure factord-end-day :
     2062     define input  parameter p-fact-date            as date    no-undo .
     2063     define output parameter p-day-end-fact-order   as decimal no-undo .
     2064     do
     2065     on error undo, return error return-value
     2066     :
     2067       if p-fact-date = ?
     2068       then do:
     2069         return error "Не указана фактическая дата" .
     2070       end.
     2071       assign
     2072         p-day-end-fact-order = integer(p-fact-date) + 0.99
     2073       .
     2074     end.
     2075   end procedure.
     2076   procedure factord-to-date :
     2077     define input  parameter p-fact-order as decimal no-undo .
     2078     define output parameter p-fact-date  as date    no-undo .
     2079     define variable v-ref-date  as date      no-undo .
     2080     define variable v-ref-delta as integer   no-undo .
     2081     do
     2082     on error undo, return error return-value
     2083     :
     2084       if p-fact-order = ?
     2085       or p-fact-order = 0
     2086       then do:
     2087         return error "Не указан fact-order" .
     2088       end.
     2089       assign
     2090         v-ref-date  = date(1, 1, 2000)
     2091       .
     2092       assign
     2093         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     2094       .
     2095       assign
     2096         p-fact-date = v-ref-date + v-ref-delta
     2097       .
     2098     end.
     2099   end procedure.
     2100   procedure factord-to-fact-num :
     2101     define input  parameter p-fact-order as decimal no-undo .
     2102     define output parameter p-fact-num   as integer no-undo .
     2103     define variable v-fact-order-trunc as decimal no-undo .
     2104     do
     2105     on error undo, return error return-value
     2106     :
     2107       if p-fact-order = ?
     2108       or p-fact-order = 0
     2109       then do:
     2110         return error "Не указан fact-order" .
     2111       end.
     2112       assign
     2113        v-fact-order-trunc = truncate(p-fact-order, 2)
     2114       .
     2115       assign
     2116         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     2117       .
     2118     end.
     2119   end procedure.
     2120   procedure factord-to-shift-num :
     2121     define input  parameter p-fact-order as decimal no-undo .
     2122     define output parameter p-shift-num   as integer no-undo .
     2123     define variable  p-shift-numd  as decimal   no-undo .
     2124     define variable v-fact-order-trunc as decimal no-undo .
     2125     do
     2126     on error undo, return error return-value
     2127     :
     2128       if p-fact-order = ?
     2129       or p-fact-order = 0
     2130       then do:
     2131         return error "Не указан fact-order" .
     2132       end.
     2133       assign
     2134        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     2135       .
     2136       if v-fact-order-trunc < 0.5 then do:
     2137         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     2138       end.
     2139       assign
     2140         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     2141         .
     2142        assign
     2143         p-shift-num = truncate (p-shift-numd , 0)
     2144       .
     2145     end.
     2146   end procedure.
