      341   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      342   procedure cur-time :
      343      define output parameter p-today as date      no-undo .
      344      define output parameter p-time  as integer   no-undo .
      345     do
      346     on error undo, return error
      347     :
      348       define variable v-date1 as date      no-undo .
      349       define variable v-date2 as date      no-undo .
      350       define variable v-time  as integer   no-undo .
      351       assign
      352         v-date1 = today
      353         v-time  = time
      354         v-date2 = today
      355       .
      356       if v-date1 <> v-date2
      357       then do:
      358         assign
      359           v-date1 = today
      360           v-time  = v-time
      361         .
      362       end.
      363       assign
      364         p-today = v-date1
      365         p-time  = v-time
      366       .
      367     end.
      368   end.
      369   function cur-time-date returns character
      370   :
      371     return string(today, '99/99/9999':U) .
      372   end.
      373   function cur-time-mjd returns decimal
      374   :
      375     define variable v-date as date      no-undo .
      376     define variable v-time as integer   no-undo .
      377     run cur-time in this-procedure
      378       (output v-date
      379       ,output v-time
      380       ) .
      381     return integer(v-date) - 2400002 + (v-time / 86400) .
      382   end.
      383   function cur-time-get-ending-index returns integer
      384   (input p-number as integer
      385   )
      386   :
      387     if p-number < 0
      388     or p-number = ?
      389     then do:
      390       return 1 .
      391     end.
      392     define variable v-rest as integer   no-undo .
      393     assign
      394       p-number = p-number modulo 100
      395     .
      396     if p-number < 20
      397     then do:
      398       assign
      399         v-rest = p-number
      400       .
      401     end.
      402     else do:
      403       assign
      404         v-rest = p-number modulo 10
      405       .
      406     end.
      407     case v-rest :
      408       when 1
      409       then do:
      410         return 2 .
      411       end.
      412       when 2 or
      413       when 3 or
      414       when 4
      415       then do:
      416         return 3 .
      417       end.
      418       otherwise do:
      419         return 1 .
      420       end.
      421     end case .
      422   end.
      423   procedure cur-time-mjd-to-date :
      424      define input  parameter i-mjd-diff as decimal no-undo.
      425      define output parameter o-Date     as date    no-undo.
      426      define output parameter o-Time     as integer no-undo.
      427      define variable v-day-number as integer   no-undo .
      428      if    i-mjd-diff < 0
      429         or i-mjd-diff = ?
      430      then do:
      431         return "?" .
      432      end.
      433      assign
      434         v-day-number = truncate(i-mjd-diff,0).
      435         o-Date = date(v-day-number + 2400002).
      436         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      437     .
      438   end.
      439   function cur-time-mjd-to-string returns character
      440   (input p-mjd-diff as decimal
      441   )
      442   :
      443     define variable v-day-number as integer   no-undo .
      444     define variable v-seconds    as integer   no-undo .
      445     define variable v-hour       as integer   no-undo .
      446     define variable v-min        as integer   no-undo .
      447     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      448     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      449     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      450     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      451     if p-mjd-diff < 0
      452     or p-mjd-diff = ?
      453     then do:
      454       return "?" .
      455     end.
      456     assign
      457       v-day-number = integer(truncate(p-mjd-diff,0))
      458       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      459     .
      460     if v-seconds > 86400
      461     then do:
      462       assign
      463         v-seconds = 86400 - 1
      464       .
      465     end.
      466     if v-seconds < 0
      467     then do:
      468       assign
      469         v-seconds = 0
      470       .
      471     end.
      472     assign
      473       v-hour = truncate(v-seconds / 3600, 0)
      474     .
      475     assign
      476       v-seconds = v-seconds modulo 3600
      477     .
      478     assign
      479       v-min = truncate(v-seconds / 60, 0)
      480     .
      481     assign
      482       v-seconds = v-seconds modulo 60
      483     .
      484     return
      485         (if v-day-number <> 0
      486           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      487           else ""
      488         )
      489       + (if v-day-number <> 0 or v-hour <> 0
      490           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      491           else ""
      492         )
      493       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      494           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      495           else ""
      496         )
      497       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      498       .
      499   end.
      500   function cur-time-string returns character
      501   :
      502     define variable v-date as date      no-undo .
      503     define variable v-time as integer   no-undo .
      504     run cur-time in this-procedure
      505       (output v-date
      506       ,output v-time
      507       ) .
      508     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      509   end.
      510   function cur-time-string-sec returns character
      511   :
      512     define variable v-date as date      no-undo .
      513     define variable v-time as integer   no-undo .
      514     run cur-time in this-procedure
      515       (output v-date
      516       ,output v-time
      517       ) .
      518     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      519   end.
      520   function cur-time-custom  returns character
      521   (input p-prefix as character
      522   ,input p-date-format as character
      523   ,input p-delimiter as character
      524   ,input p-time-format as character
      525   ,input p-suffix as character
      526   )
      527   :
      528     define variable v-date as date      no-undo .
      529     define variable v-time as integer   no-undo .
      530     run cur-time in this-procedure
      531       (output v-date
      532       ,output v-time
      533       ) .
      534     return
      535       p-prefix
      536       + string(v-date, p-date-format)
      537       + p-delimiter
      538       + string(v-time, p-time-format)
      539       + p-suffix
      540       .
      541   end.
      542   function cur-time-print  returns character
      543   :
      544     define variable v-date as date      no-undo .
      545     define variable v-time as integer   no-undo .
      546     run cur-time in this-procedure
      547       (output v-date
      548       ,output v-time
      549       ) .
      550     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      551   end.
      552   function cur-time-datetime returns datetime
      553   :
      554     define variable v-char as character no-undo .
      555     define variable v-datetime as datetime no-undo .
      556     v-char = cur-time-string().
      557     v-datetime = datetime(v-char).
      558     return  v-datetime.
      559   end.
      560   function cur-time-string-msec returns character
      561   :
      562     define variable v-date as datetime  no-undo .
      563     v-date = now.
      564     return string(v-date) .
      565   end.
      566   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
