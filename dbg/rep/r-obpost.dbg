     1149   procedure proc-alt-shift-f2:
     1150     if not ibs.th.gbl.gbl-var:rcode
     1151   then
     1152     run gbl\inidebug.p .
     1153   end.
     1154   procedure proc-alt-shift-f3:
     1155     run gbl/prvssinf.p
     1156       ( input this-procedure
     1157       ) .
     1158   end.
     1159   define variable v-inform-launched as logical no-undo initial false .
     1160   procedure proc-alt-shift-f4:
     1161     define variable v-action as character no-undo .
     1162     if v-inform-launched = false then do:
     1163       assign
     1164         v-inform-launched = true
     1165       .
     1166       run gbl/d-inform.w
     1167         (  input self
     1168         ,  input this-procedure
     1169         , output v-action
     1170         ) no-error .
     1171       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
     1172       assign
     1173         v-inform-launched = false
     1174       .
     1175     end.
     1176   end.
     1177   procedure proc-alt-f1:
     1178     run gbl/corrhelp.p
     1179       (input this-procedure
     1180       ) .
     1181   end .
