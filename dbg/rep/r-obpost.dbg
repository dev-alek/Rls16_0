      627   def
      628    shared
      629   temp-table  obj-list no-undo
      630     field obj-type like ub.clients.obj-type
      631     field obj-code like ub.clients.obj-code
      632     field obj-name like ub.clients.obj-name
      633     field obj-id   as integer
      634     field db-num   as integer
