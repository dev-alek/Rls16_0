      636     index ie1 obj-type obj-code
      637     index ie2 obj-name
      638   .
      639   procedure create_obj-list :
      640      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      641      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      642      do
      643      on error undo, return error return-value
      644      :
      645         define buffer cli-obj for ub.clients .
      646         define variable p-var as integer no-undo .
      647         define buffer buf_obj-list for obj-list .
      648         find last buf_obj-list  use-index pi no-error .
      649         if available buf_obj-list
      650         then
      651            p-var = buf_obj-list.obj-id + 1.
      652         else
      653            p-var = 1.
      654         find first cli-obj where
      655                   cli-obj.obj-type = p-obj-type
      656               and cli-obj.obj-code = p-obj-code
      657         no-lock no-error.
      658         if available cli-obj
      659         then do:
      660            create buf_obj-list.
      661            assign
      662               buf_obj-list.obj-id   = p-var
      663               buf_obj-list.obj-code = cli-obj.obj-code
      664               buf_obj-list.obj-type = cli-obj.obj-type
      665               buf_obj-list.obj-name = cli-obj.obj-name
      666               buf_obj-list.db-num   = cli-obj.db-num
      667            .
      668         end.
      669      end.
      670   end.
