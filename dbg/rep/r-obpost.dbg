     2215   function excel-format-dec-to-char returns char (input p-dec as decimal ).
     2216     if num-entries(string(p-dec), '.') = 2
     2217       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
     2218       else return( string(p-dec)) .
     2219   end function.
     2220   function format-point-to-comma returns char (input orig as char ) .
     2221   define variable rtext as character no-undo .
     2222   define variable strt as integer no-undo .
     2223   define variable leng as integer no-undo .
     2224   assign rtext = orig .
     2225   repeat:
     2226     strt =  index(rtext,'.').
     2227     if strt = 0 then leave.
     2228     leng = 1.
     2229     substring(rtext,strt,leng,"character") = v-delim .
     2230   end.
     2231   return rtext.
     2232   end function.
     2233   function format-excel-text returns char ( input start-text as char ) :
     2234   def var  i    as int no-undo.
     2235   def var  ch   as char no-undo.
     2236   def var  n    as int no-undo.
     2237   def var  ipos as int no-undo.
     2238     n = num-entries(trim(start-text), chr(10)) - 1 .
     2239     do i = 1 to n :
     2240       ipos = index( start-text, chr(10)).
     2241       if ipos > 0 then
     2242         substr( start-text, ipos, 1 ) = ' '.
     2243     end.
     2244     n = num-entries(trim(start-text), chr(13)) - 1 .
     2245     do i = 1 to n :
     2246       ipos = index( start-text, chr(13)).
     2247       if ipos > 0 then
     2248         substr( start-text, ipos, 1 ) = ' '.
     2249     end.
     2250     if index( start-text, '"' ) = 0 then
     2251       start-text =  '="'   + trim( start-text) + '"'   .
     2252       else do:
     2253         n = num-entries(trim(start-text), '"') - 1.
     2254         do i = 1 to n :
     2255           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     2256         end.
     2257         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     2258         start-text = '="'  + ch  + '"' .
     2259       end.
     2260     return start-text.
     2261   end.
     2262   function excel-sum returns char (input p-dec as decimal ).
     2263     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
     2264   end function.
     2265   function excel-qnty returns char (input p-dec as decimal ).
     2266     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
     2267   end function.
     2268   function format-excel-text-macr returns char ( input start-text as char ) :
     2269   def var  i    as int no-undo.
     2270   def var  ch   as char no-undo.
     2271   def var  n    as int no-undo.
     2272   def var  ipos as int no-undo.
     2273     n = num-entries(trim(start-text), chr(10)) - 1 .
     2274     do i = 1 to n :
     2275       ipos = index( start-text, chr(10)).
     2276       if ipos > 0 then
     2277         substring( start-text, ipos , 1 ) = ' '.
     2278     end.
     2279     n = num-entries(trim(start-text), chr(13)) - 1 .
     2280     do i = 1 to n :
     2281       ipos = index( start-text, chr(13)).
     2282       if ipos > 0 then
     2283         substring( start-text, ipos, 1 ) = ' '.
     2284     end.
     2285     if index( start-text, '"' ) = 0 then
     2286       start-text =  '"'   + trim( start-text) + '"'   .
     2287       else do:
     2288         n = num-entries(trim(start-text), '"') - 1.
     2289         do i = 1 to n :
     2290           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     2291         end.
     2292         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     2293         start-text = '"'  + ch  + '"' .
     2294       end.
     2295     n = num-entries(trim(start-text), chr(10)) - 1 .
     2296     do i = 1 to n :
     2297       ipos = index( start-text, chr(10)).
     2298       if ipos > 0 then
     2299         substring( start-text, ipos , 1 ) = ' '.
     2300     end.
     2301       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
     2302     return start-text.
     2303   end.
     2304   FUNCTION n-lavel RETURNS char (INPUT grp-name as char, INPUT lavel# as int ).
     2305   define variable  str  as char format "X(60)"  no-undo.
     2306   define variable  str2 as char no-undo.
     2307   define variable v-r as character no-undo init "" .
     2308   define variable  i#i as int no-undo.
     2309   STR = "".
     2310   repeat i#i =1 to lavel#:
     2311       if i#i =1 then str   = entry(1,grp-name, chr(47)) .
     2312       else do:
     2313           str2 = entry(i#i,grp-name, chr(47)) no-error.
     2314           if not error-status:error  and str2 <> "":u then
     2315                  str = str +  chr(47) +  entry(i#i,grp-name, chr(47)) no-error .
     2316           end.
     2317   end.
     2318   if str <> ? then do:
     2319   v-r = str + chr(47) .
     2320   end.
     2321   RETURN v-r .
     2322   END FUNCTION.
     2323   procedure report-execute :
     2324     if (valtype=0 and x-base-code=0)  or valtype=1
     2325       then   assign tprintrubl = yes .
     2326       else   assign tprintrubl = no .
     2327     run waitfram-show ( 'Подождите ...' ) .
     2328   output stream outstream to value( string( session:temp-directory +
     2329                                        "rpt" + string( g#report-num ) ) )
     2330                                        page-size  value(reportpageheight) .
     2331     run report-exec1.
     2332     hide   stream outstream frame zapas .
     2333     output stream outstream close.
     2334     run waitfram-hide .
     2335     if Make-Excel then output stream ForExcel close.
     2336     define variable v-user-action as character no-undo .
     2337     define variable v-printed as logical   no-undo .
     2338     define variable disabledoptions as integer   no-undo .
     2339     define variable v-orient-page as character no-undo .
     2340     run How-name in this-procedure (
     2341         input ReportPageHeight,
     2342         input ReportPageWidth,
     2343         output v-orient-page )
     2344         .
     2345     if v-orient-page = "A4-lans":U then DisabledOptions = 8 .
     2346                                    else DisabledOptions = 0 .
     2347     run gbl/prnfilen.w
     2348       (input  ""
     2349       ,input  disabledoptions
     2350       ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
     2351       ,input ReportFontNum
     2352       ,output v-user-action
     2353       ,output v-printed
     2354       ) .
     2355   end procedure.
     2356   procedure print-header :
     2357   if not firstline then  run display-title.
     2358       firstline = true .
     2359        form with FRAME ZAPAS .  DOWN stream   OutStream 1 with FRAME ZAPAS .
     2360        run clear-b1 .
     2361        run clear-b2.
     2362        run clear-bi .
     2363        break_group = true.
     2364        break_group1 = true.
     2365      end procedure.
     2366   procedure print-footer :
     2367         if retclassify = "no-classify":u  then run u-line.
     2368          gds-zap-artic = "ИТОГО" .
     2369          run display-bi.
     2370          run u-line.
     2371          end procedure.
     2372   procedure u-line :
     2373   underline stream outstream  sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 sym13
     2374     gds-zap-b-code
     2375     gds-zap-artic
     2376     gds-zap-gds-name
     2377     gds-zap-unit-base
     2378     gds-type
     2379     f-ostatok-start
     2380     f-prih
     2381     f-rash
     2382     f-kassa
     2383     f-spis
     2384     f-inv
     2385     f-vzvr
     2386     f-vzvr-post
     2387     f-ostatok-end
     2388     with FRAME ZAPAS .
     2389     DOWN stream   OutStream 1 with FRAME ZAPAS.
     2390     end procedure.
     2391   procedure p-line :
     2392   underline stream outstream
     2393     sym3
     2394     gds-zap-gds-name
     2395     sym4
     2396     gds-zap-unit-base
     2397     sym5
     2398     with FRAME ZAPAS.
     2399     DOWN stream   OutStream 1 with FRAME ZAPAS .
     2400     end procedure.
     2401   procedure calcitog :
     2402        xtog-obj = false .
     2403         run factord-end-day (input x-date-start - 1 , output fact-order-1 ) .
     2404         run factord-end-day (input x-date-end,        output fact-order-2 ) .
     2405         xtog-obj = xtogobj.
     2406   end procedure.
     2407   procedure display-bi  :
     2408     run di-qnty ("кол-во",1,  "", gds-zap-artic ,"" ,"", "bi":u).
     2409            if show-cost    then do: run di ("учет." , 2 , "","", "", "", "bi":u).  end.
     2410            if show-crsa    then do: run di ("прод." , 5, "","", "", "",  "bi":u).  end.
     2411            if show-sale    then do: run di ("док-т." , 8, "","", "", "",  "bi":u).  end.
     2412   end procedure.
     2413   procedure clear-b1  :
     2414    repeat kk = 1 to 6 :
     2415    assign
     2416       b1-prih                                            [kk]    = 0
     2417       b1-rash                                            [kk]    = 0
     2418       b1-kassa                                           [kk]    = 0
     2419       b1-spis                                            [kk]    = 0
     2420       b1-inv                                             [kk]    = 0
     2421       b1-vzvr                                            [kk]    = 0
     2422       b1-vzvr-post                                       [kk]    = 0
     2423       b1-ostatok-end                                     [kk]    = 0
     2424       b1-ostatok-start                                   [kk]    = 0   .
     2425      end.
     2426    end procedure.
     2427   procedure clear-b2  :
     2428    repeat kk = 1 to 6 :
     2429    assign
     2430       b2-prih                                            [kk]    = 0
     2431       b2-rash                                            [kk]    = 0
     2432       b2-kassa                                           [kk]    = 0
     2433       b2-spis                                            [kk]    = 0
     2434       b2-inv                                             [kk]    = 0
     2435       b2-vzvr                                            [kk]    = 0
     2436       b2-vzvr-post                                       [kk]    = 0
     2437       b2-ostatok-end                                     [kk]    = 0
     2438       b2-ostatok-start                                   [kk]    = 0   .
     2439      end.
     2440   end procedure.
     2441   procedure clear-bi  :
     2442    repeat kk = 1 to 6 :
     2443    assign
     2444       bi-prih                                            [kk]    = 0
     2445       bi-rash                                            [kk]    = 0
     2446       bi-kassa                                           [kk]    = 0
     2447       bi-inv                                             [kk]    = 0
     2448       bi-spis                                            [kk]    = 0
     2449       bi-vzvr                                            [kk]    = 0
     2450       bi-vzvr-post                                       [kk]    = 0
     2451       bi-ostatok-end                                     [kk]    = 0
     2452       bi-ostatok-start                                   [kk]    = 0   .
     2453      end.
     2454   end procedure.
     2455   procedure display-title :
     2456      PUT stream  OutStream  UNFORMATTED  string( v-cntxt-host-name-obj +  " , " + x-store-type  +  " " + objname) at 50 format "x(85)" skip(2)
     2457             reportname  at 20 format "x(170)" skip
     2458             trim(str1)  at 35 format "x(75)" skip.
     2459        repeat i = 1 to num-entries(str2,chr(10)) :
     2460         PUT stream  OutStream  UNFORMATTED  entry(i,str2,chr(10))  at 1 format "x(170)" skip.
     2461        end.
     2462       i=0.
     2463          PUT stream  OutStream  UNFORMATTED  trim(str3)  at 35 format "x(75)" skip.
     2464        repeat i = 1 to num-entries(str4,chr(10)) :
     2465         PUT stream  OutStream  UNFORMATTED  entry(i,str4,chr(10))  at 1 format "x(170)" skip.
     2466        end.
     2467       i=0.
     2468        repeat i = 1 to num-entries(reportheader,chr(10)) :
     2469         PUT stream  OutStream  UNFORMATTED  entry(i,reportheader,chr(10))  at 1 format "x(170)" skip.
     2470        end.
     2471       i=0.
     2472       run rep/extitle.p (1) .
     2473   end procedure.
     2474   PROCEDURE ostatok :
     2475   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
     2476   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
     2477   def input parameter x-tog-shift   as   logical             no-undo.
     2478   def input parameter x-date-start  like ub.stk-tot.Fact-date   no-undo.
     2479   def input parameter x-date-end    like ub.stk-tot.Fact-date   no-undo.
     2480   def input parameter x-shift-start as integer               no-undo.
     2481   def input parameter x-shift-end   as integer               no-undo.
     2482   def input parameter x-sum-type    like ub.stk-tot.sum-type    no-undo.
     2483   def input parameter x-cat-id      like ub.stk-tot.cat-id      no-undo.
     2484   def input parameter xTog-obj   as log no-undo.
     2485   def output parameter Quantity    like ub.stk-tot.fact-qnty   no-undo.
     2486   def output parameter Coast_R     like ub.stk-tot.sum-rubl    no-undo.
     2487   def output parameter Coast_V     like ub.stk-tot.sum-rubl    no-undo.
     2488   def output parameter VAT_R       like ub.stk-tot.sum-rubl    no-undo.
     2489   def output parameter VAT_V       like ub.stk-tot.sum-rubl    no-undo.
     2490   def output parameter Fact-order  like ub.stk-tot.Fact-order  no-undo.
     2491   def var              Fact-order#   like ub.stk-tot.Fact-order  no-undo.
     2492   def var              Fact-orderS   as char  no-undo.
     2493   def var x-date-start-t  like ub.stk-tot.shift-date   no-undo.
     2494      Assign
     2495         Fact-order   = 0
     2496         Quantity     = 0
     2497         Coast_R      = 0
     2498         Coast_V      = 0
     2499         VAT_R        = 0
     2500         VAT_V        = 0 .
     2501    x-date-start-t  = x-date-start + 1 .
     2502   IF x-date-end = date('') then DO:
     2503      Fact-order = 0 .
     2504      for each obj-list
     2505          where  ( not xtog-obj or
     2506                 ( x-store-type = obj-list.obj-type and x-store-code = obj-list.obj-code ))
     2507                 no-lock :
     2508         if  x-tog-shift = false then do:
     2509                          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2510                               ub.stk-tot.Fact-date <=  x-date-start
     2511                               and ub.stk-tot.shift-num = 0
     2512                               USE-INDEX fact-date no-lock no-error .
     2513              if Available ub.stk-tot THEN  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2514         End.
     2515         Else  DO :
     2516             find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2517              (ub.stk-tot.shift-date  = x-date-start-t and
     2518               ub.stk-tot.shift-num  < x-shift-start or
     2519               ub.stk-tot.shift-date  < x-date-start-t  )
     2520               and ub.stk-tot.shift-num  > 0
     2521               USE-INDEX Shift-num no-lock no-error .
     2522            If Available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2523           END.
     2524       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     2525     End.
     2526   End.
     2527   Else DO:
     2528     For each obj-list  WHERE
     2529        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
     2530         no-lock :
     2531      IF  x-TOG-Shift = False Then DO:
     2532          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2533               ub.stk-tot.Fact-date <= x-date-end
     2534               and ub.stk-tot.shift-num = 0
     2535               USE-INDEX fact-date no-lock no-error.
     2536          if available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2537      END.
     2538      Else DO:
     2539           find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2540               (ub.stk-tot.shift-date  = x-date-end and
     2541               ub.stk-tot.shift-num  <= x-shift-end or
     2542               ub.stk-tot.shift-date  < x-date-end       ) and
     2543               ub.stk-tot.shift-num   > 0      use-index shift-num no-lock no-error.
     2544               if Available ub.stk-tot THEN Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2545       End.
     2546       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     2547     End.
     2548   End.
     2549   END PROCEDURE.
     2550   procedure report-exec1  :
     2551      find first a-clients where x-store-type = a-clients.obj-type and
     2552                                 x-store-code = a-clients.obj-code no-lock no-error.
     2553     if available a-clients then  objname = a-clients.obj-name. else  objname = "объект не определен".
     2554     run waitfram-show (objname) .
     2555     form with frame zapas .
     2556   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2557   form header
     2558     line format "x(194)" at 1 skip
     2559     "Продолжение - на следующей странице" at 30 skip
     2560     with frame bottomframe width 232 page-bottom no-labels no-box .
     2561   view stream outstream frame bottomframe .
     2562     run calcitog.
     2563     run print-header.
     2564   if xtogobj = true  then do:
     2565     case retsorttype :
     2566         when "sort-article":u  or when "sort-artic":u  then
     2567         if not can-find(first g#post no-lock)
     2568             then   run rep/r-pst-1.p (x-store-code, x-store-type, x-base-type , x-base-code ).
     2569             else   run rep/r-pst-2.p (x-store-code, x-store-type, x-base-type , x-base-code ).
     2570         when "sort-code":u  then
     2571         if not can-find(first g#post no-lock)
     2572             then   run rep/r-pst-3.p (x-store-code, x-store-type, x-base-type , x-base-code ).
     2573             else   run rep/r-pst-4.p (x-store-code, x-store-type, x-base-type , x-base-code ).
     2574         when "sort-name":u  then
     2575         if not can-find(first g#post no-lock)
     2576             then   run rep/r-pst-5.p (x-store-code, x-store-type, x-base-type , x-base-code ).
     2577             else   run rep/r-pst-6.p (x-store-code, x-store-type, x-base-type , x-base-code ).
     2578     end case.
     2579   end.
     2580   else do:
     2581     case retsorttype :
     2582         when "sort-article":u  or when "sort-artic":u  then
     2583         if not can-find(first g#post no-lock)
     2584             then   run rep/r-pst-10.p (x-store-code, x-store-type, x-base-type , x-base-code ).
     2585             else   run rep/r-pst-20.p (x-store-code, x-store-type, x-base-type , x-base-code ).
     2586         when "sort-code":u  then
     2587         if not can-find(first g#post no-lock)
     2588             then   run rep/r-pst-30.p (x-store-code, x-store-type, x-base-type , x-base-code ).
     2589             else   run rep/r-pst-40.p (x-store-code, x-store-type, x-base-type , x-base-code ).
     2590         when "sort-name":u  then
     2591         if not can-find(first g#post no-lock)
     2592             then   run rep/r-pst-50.p (x-store-code, x-store-type, x-base-type , x-base-code ).
     2593             else   run rep/r-pst-60.p (x-store-code, x-store-type, x-base-type , x-base-code ).
     2594     end case.
     2595   end.
     2596     hide stream outstream frame bottomframe .
     2597     run print-footer.
     2598     end procedure.
     2599   procedure clear-item :
     2600   define variable kk as int no-undo.
     2601    repeat kk = 1 to 6:
     2602    assign
     2603       prih             [kk]  = 0
     2604       rash             [kk]  = 0
     2605       kassa            [kk]  = 0
     2606       spis              [kk]  = 0
     2607       inv              [kk]  = 0
     2608       vzvr             [kk]  = 0
     2609       vzvr-post        [kk]  = 0
     2610       ostatok-end      [kk]  = 0
     2611       ostatok-start    [kk]  = 0   .
     2612          end.
     2613    end procedure.
     2614   procedure di :
     2615   define input parameter p1 as char no-undo.
     2616   define input parameter p2 as int no-undo.
     2617   define input parameter p3 as char no-undo.
     2618   define input parameter p4 as char no-undo.
     2619   define input parameter p5 as char no-undo.
     2620   define input parameter p6 as char no-undo.
     2621   define input parameter p7 as char no-undo.
     2622    case caps(p7) :
     2623      when "bi":u then do:
     2624                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 sym11 sym12 sym13
     2625                   p3 @ gds-zap-b-code
     2626                   p4 @ gds-zap-artic
     2627                   p5 @ gds-zap-gds-name
     2628                   p6 @ gds-zap-unit-base
     2629                   p1 @ gds-type
     2630                   bi-ostatok-start[p2] when ( NOT( Show-SAle = true and p2 = 8 )) @  F-ostatok-start
     2631                   bi-Prih         [p2]  @  F-Prih
     2632                   bi-RAsh         [p2]  @  F-RAsh
     2633                   bi-KAssa        [p2]  @  F-KAssa
     2634                   bi-Inv          [p2]  @  F-Inv
     2635                   bi-spis         [p2]  @  F-spis
     2636                   bi-vzvr         [p2]  @  F-vzvr
     2637                   bi-vzvr-post    [p2]  @  F-vzvr-post
     2638                   bi-Ostatok-end  [p2] when ( NOT( Show-SAle = true and p2 = 8 ))  @  F-Ostatok-end
     2639                  with FRAME ZAPAS .
     2640       end.
     2641      end case.
     2642                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     2643    end procedure.
     2644   procedure di-qnty :
     2645   define input parameter p1 as char no-undo.
     2646   define input parameter p2 as int no-undo.
     2647   define input parameter p3 as char no-undo.
     2648   define input parameter p4 as char no-undo.
     2649   define input parameter p5 as char no-undo.
     2650   define input parameter p6 as char no-undo.
     2651   define input parameter p7 as char no-undo.
     2652    case caps(p7) :
     2653      when "bi":u then  do :
     2654                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 sym11 sym12 sym13
     2655                   p3 @ gds-zap-b-code
     2656                   p4 @ gds-zap-artic
     2657                   p5 @ gds-zap-gds-name
     2658                   p6 @ gds-zap-unit-base
     2659                   p1 @ gds-type
     2660                   bi-ostatok-start[p2] when ( NOT( Show-SAle = true and p2 = 8 )) @  F-ostatok-start
     2661                   bi-Prih         [p2]  @  F-Prih
     2662                   bi-RAsh         [p2]  @  F-RAsh
     2663                   bi-KAssa        [p2]  @  F-KAssa
     2664                   bi-Inv          [p2]  @  F-Inv
     2665                   bi-spis         [p2]  @  F-spis
     2666                   bi-vzvr         [p2]  @  F-vzvr
     2667                   bi-vzvr-post    [p2]  @  F-vzvr-post
     2668                   bi-Ostatok-end  [p2] when ( NOT( Show-SAle = true and p2 = 8 ))  @  F-Ostatok-end
     2669                  with FRAME ZAPAS .
     2670       if Make-Excel then  put   stream ForExcel unformatted p3 CHR(9)
     2671                   p4 CHR(9)
     2672                   p5 CHR(9)
     2673                   p6 CHR(9)
     2674                      ( excel-qnty(bi-ostatok-start[1]) +  CHR(9))
     2675   if Show-cost  then  ( excel-sum(bi-ostatok-start[2]) +  CHR(9))   else ("")
     2676   if Show-sale  then  ( "" +                              CHR(9))   else ("")
     2677                      ( excel-qnty(bi-Prih         [1]) +  CHR(9))
     2678   if Show-cost  then  ( excel-sum(bi-Prih         [2]) +  CHR(9))   else ("")
     2679   if Show-sale  then  ( excel-sum(bi-Prih         [8]) +  CHR(9))   else ("")
     2680                      ( excel-qnty(bi-RAsh         [1]) +  CHR(9))
     2681   if Show-cost  then  ( excel-sum(bi-RAsh         [2]) +  CHR(9))   else ("")
     2682   if Show-sale  then  ( excel-sum(bi-RAsh         [8]) +  CHR(9))   else ("")
     2683                      ( excel-qnty(bi-KAssa        [1]) +  CHR(9))
     2684   if Show-cost  then  ( excel-sum(bi-KAssa        [2]) +  CHR(9))   else ("")
     2685   if Show-sale  then  ( excel-sum(bi-KAssa        [8]) +  CHR(9))   else ("")
     2686                      ( excel-qnty(bi-Inv          [1]) +  CHR(9))
     2687   if Show-cost  then  ( excel-sum(bi-Inv          [2]) +  CHR(9))   else ("")
     2688   if Show-sale  then  ( excel-sum(bi-Inv          [8]) +  CHR(9))   else ("")
     2689                      ( excel-qnty(bi-spis         [1]) +  CHR(9))
     2690   if Show-cost  then  ( excel-sum(bi-spis         [2]) +  CHR(9))   else ("")
     2691   if Show-sale  then  ( excel-sum(bi-spis         [8]) +  CHR(9))   else ("")
     2692                      ( excel-qnty(bi-vzvr         [1]) +  CHR(9))
     2693   if Show-cost  then  ( excel-sum(bi-vzvr         [2]) +  CHR(9))   else ("")
     2694   if Show-sale  then  ( excel-sum(bi-vzvr         [8]) +  CHR(9))   else ("")
     2695                      ( excel-qnty(bi-vzvr-post    [1]) +  CHR(9))
     2696   if Show-cost  then  ( excel-sum(bi-vzvr-post    [2]) +  CHR(9))   else ("")
     2697   if Show-sale  then  ( excel-sum(bi-vzvr-post    [8]) +  CHR(9))   else ("")
     2698                      ( excel-qnty(bi-Ostatok-end  [1]) +  CHR(9))
     2699   if Show-cost  then  ( excel-sum(bi-Ostatok-end  [2]) +  CHR(9))   else ("")
     2700   if Show-sale  then  (  "" +                             CHR(9))   else ("")
     2701      chr(10).
     2702         end.
     2703      end case.
     2704                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     2705    end procedure.
     2706   procedure clear-itembi- :
     2707   define variable kk as int no-undo.
     2708    repeat kk = 1 to 9:
     2709    assign
     2710      bi-prih             [kk]  = 0
     2711      bi-rash             [kk]  = 0
     2712      bi-kassa            [kk]  = 0
     2713      bi-spis             [kk]  = 0
     2714      bi-inv              [kk]  = 0
     2715      bi-vzvr             [kk]  = 0
     2716      bi-vzvr-post        [kk]  = 0
     2717      bi-ostatok-end      [kk]  = 0
     2718      bi-ostatok-start    [kk]  = 0
     2719      .
     2720      end.
     2721    end procedure.
