     1958         run PrintTitul in this-procedure .
     1959   define variable p-sort-pole as character no-undo .
     1960   define variable p-sort-pole2 as character no-undo .
     1961   define variable p-sort-pole-a as character no-undo .
     1962   define variable p-query-prepare as character no-undo .
     1963   define variable p-table-name as character no-undo .
     1964   p-table-name = "temp-pdf" .
     1965   case v-sort :
     1966     when "sort-code":U  then do:
     1967       p-sort-pole-a = "temp-pdf.b-code" .
     1968     end.
     1969     when "sort-artic":U then do:
     1970         p-sort-pole-a = "temp-pdf.artic" .
     1971     end.
     1972     when "sort-name":U then do:
     1973         p-sort-pole-a = "temp-pdf.gds-name" .
     1974     end.
     1975   end case.
     1976   case v-clas:
     1977       when "no-classify":U then do:
     1978          p-query-prepare  = substitute( "for each temp-pdf by &1 " , p-sort-pole-a ).
     1979          p-sort-pole   = "nul" .
     1980          p-sort-pole2  = "nul" .
     1981       end.
     1982       when "prod":U        then do:
     1983          p-query-prepare  = substitute( "for each temp-pdf by &1 by &2 " , "temp-pdf.prod-typecode" , p-sort-pole-a).
     1984          p-sort-pole   = "prod-typecode" .
     1985          p-sort-pole2  = "nul" .
     1986       end.
     1987       when "grp-goods":U   then do:
     1988          p-query-prepare  = substitute( "for each temp-pdf by &1 by &2 " , "temp-pdf.grp-code" , p-sort-pole-a).
     1989          p-sort-pole   = "grp-code" .
     1990          p-sort-pole2  = "nul" .
     1991       end.
     1992       when "prod/grp-goods":U then do:
     1993          p-query-prepare  = substitute( "for each temp-pdf by &1 by &2 by &3 " , "temp-pdf.prod-typecode" , "temp-pdf.grp-code" , p-sort-pole-a) .
     1994          p-sort-pole   = "prod-typecode" .
     1995          p-sort-pole2  = "grp-code" .
     1996       end.
     1997       when "grp-goods/prod":U then do:
     1998          p-query-prepare  = substitute( "for each temp-pdf by &1 by &2 by &3 " , "temp-pdf.grp-code" , "temp-pdf.prod-typecode" , p-sort-pole-a) .
     1999          p-sort-pole   = "grp-code" .
     2000          p-sort-pole2  = "prod-typecode" .
     2001       end.
     2002   end case.
     2003        run din-tt-go (
     2004             p-table-name    ,
     2005             P-query-prepare ,
     2006             p-sort-pole ,
     2007             p-sort-pole2
     2008             ).
     2009         run print-all-itog in this-procedure .
     2010         run on-same-page in this-procedure (input 1) .
     2011         run PrintPodval in this-procedure .
     2012         run paramls-write in this-procedure
     2013         (input "file"
     2014         ,input string(v-ind) + obj-list.obj-name
     2015         ,input v-file-name
     2016         ) .
     2017         page stream OutStream .
     2018       end.
     2019   HIDE STREAM OutStream FRAME plan-menu.
     2020   HIDE stream OutStream FRAME BottomFrame .
     2021   HIDE stream OutStream FRAME BottomFrame2 .
     2022   output stream OutStream CLOSE .
     2023   Output stream Macr_Excel  close .
     2024   if mFrameView
     2025   then do:
     2026      HIDE FRAME InfoFrame.
     2027   end.
     2028       run paramls-write in this-procedure
     2029           (input "charcol"
     2030           ,input ""
     2031           ,input "1,2,3"
     2032           ) .
     2033     define variable v-user-action as character no-undo .
     2034     define variable v-printed as logical   no-undo .
     2035     define variable DisabledOptions as integer   no-undo .
     2036     run end-proc in this-procedure .
     2037     define variable v-orient-page as character no-undo .
     2038     run How-name in this-procedure (
     2039         input ReportPageHeight,
     2040         input ReportPageWidth,
     2041         output v-orient-page )
     2042         .
     2043     if v-orient-page = "A4-lans":U then DisabledOptions = 8 .
     2044                                    else DisabledOptions = 0 .
     2045     run gbl/prnfilen.w
     2046       (input  ""
     2047       ,input  DisabledOptions
     2048       ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
     2049       ,input  7
     2050       ,output v-user-action
     2051       ,output v-printed
     2052       ) .
     2053   procedure print-line :
     2054   do on error undo, return error return-value :
     2055   define input  parameter p-recid as recid no-undo .
     2056   define buffer buf_temp-pdf for temp-pdf  .
     2057   find first buf_temp-pdf where recid(buf_temp-pdf) = p-recid no-error .
     2058   define variable  p-code  as character no-undo .
     2059   define variable  p-artic as character no-undo .
     2060   define variable  p-name  as character no-undo .
     2061   p-code  = string(buf_temp-pdf.b-code,"9999999999" ) .
     2062   p-artic = buf_temp-pdf.artic   .
     2063   p-name  = buf_temp-pdf.gds-name + string(buf_temp-pdf.plt-id) + "(" + string(buf_temp-pdf.plt-db-num) + ")" .
     2064     assign
     2065        Lines_Counter = Lines_Counter + 1
     2066       .
     2067     if line-counter( OutStream ) + 2 > page-size( OutStream ) then do:
     2068        run p-line in this-procedure.
     2069        page stream OutStream.
     2070        PUT STREAM OutStream UNFORMATTED
     2071            string( "Лист " + string( PAGE-NUMBER(OutStream) , ">>>>9") ) AT 100 format "X(13)" SKIP .
     2072        run print-1 in this-procedure.
     2073        end.
     2074     if line-counter( OutStream ) < Tmp_Counter then
     2075       assign
     2076       .
     2077     assign
     2078       Tmp_Counter  = line-counter( OutStream )
     2079       num-ln = num-ln + 1
     2080     .
     2081     if line-counter( OutStream ) + j > page-size( OutStream ) then  PAGE STREAM OutStream.
     2082   define variable ii as integer   no-undo .
     2083   define variable v-price-sale as decimal   no-undo .
     2084       PUT STREAM OutStream UNFORMATTED
     2085           sym1                format "X(1)" space(0)
     2086           p-code              format "X(10)" space(0)
     2087           sym2                format "X(1)" space(0)
     2088           p-artic             format "X(16)" space(0)
     2089           sym3                format "X(1)" space(0)
     2090           p-name              format "X(30)" space(0)
     2091       .
     2092       num#col# = 1.
     2093       num#str# = num#str# + 1.
     2094       run macr_excel_char in this-procedure(p-code  , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     2095       run macr_excel_char in this-procedure(p-artic , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     2096       run macr_excel_char in this-procedure(p-name  , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     2097         repeat ii = 1 to v-kol-price :
     2098           find first  temp-price where
     2099                       temp-price.plt-id     = buf_temp-pdf.plt-id     and
     2100                       temp-price.plt-db-num = buf_temp-pdf.plt-db-num and
     2101                       temp-price.gds-code   = int(p-code) and
     2102                       temp-price.id = ii
     2103                       no-error .
     2104                       if available temp-price then  v-price-sale = temp-price.price-sale .
     2105                                               else  v-price-sale = 0 .
     2106           put stream outstream unformatted
     2107               sym1                                        format "x(1)"  space(0)
     2108               string(v-price-sale,">>>>>>>9.99")          format "x(11)" space(0)
     2109               .
     2110           run macr_excel_dec in this-procedure( v-price-sale , num#str# , num#col# ).
     2111               assign  num#col# = num#col# + 1 .
     2112         end.
     2113       PUT STREAM OutStream UNFORMATTED skip.
     2114   end.
     2115   end procedure.
     2116   procedure print-all-itog :
     2117   end procedure.
     2118   procedure PrintTitul :
     2119     do  on error undo, return error return-value  :
     2120     define variable cc as integer no-undo .
     2121     define variable tt as integer no-undo .
     2122     define variable pp as integer no-undo .
     2123     define variable ii as integer   no-undo .
     2124   if v-curr-code = ? then
     2125      find first ub.currency no-lock where ub.currency.curr-code = new-curr-code no-error .
     2126   else find first ub.currency no-lock where ub.currency.curr-code = v-curr-code no-error .
     2127    if available ub.currency then v-curr-abbr = ub.currency.curr-abbr .
     2128   PUT STREAM OutStream UNFORMATTED
     2129   space(1)
     2130      ub.clients.obj-name skip
     2131      v-ReportNAme skip
     2132      str1 skip
     2133      "Дата печати " + cur-time-date()  skip
     2134      "Цены указаны в " + v-curr-abbr skip
     2135         .
     2136     define variable i as integer no-undo .
     2137     Repeat i = 1 to NUM-ENTRIES(ReportHeader,chr(10)) :
     2138       PUT STREAM OutStream UNFORMATTED  Entry(i,ReportHeader,chr(10))  AT 1 format "X(90)" SKIP.
     2139     End.
     2140       num#str# = 1.
     2141       num#col# = 1.
     2142       run macr_excel_char in this-procedure( "по фирме " + CAPS( ub.clients.obj-name)   , num#str# , num#col#   ) .
     2143       num#str# = num#str# + 1.
     2144       run macr_excel_char in this-procedure( v-Reportname , num#str# , num#col#   ) .
     2145       num#str# = num#str# + 1.
     2146       run macr_excel_char in this-procedure( str1 , num#str# , num#col#   ) .
     2147       num#str# = num#str# + 1.
     2148       run macr_excel_char in this-procedure("Дата печати " + cur-time-date()   , num#str# , num#col#   ) .
     2149       num#str# = num#str# + 1.
     2150       run macr_excel_char in this-procedure("Цены указаны в " + v-curr-abbr   , num#str# , num#col#   ) .
     2151       num#str# = num#str# + 1.
     2152       run macr_excel_char in this-procedure("Код"  , num#str# , num#col#   ) .    run macr_cell_size ( 10 , ? , num#str# , num#col# , ?, ? ) .
     2153       num#col# = 2.
     2154       run macr_excel_char in this-procedure("Артикул"  , num#str# , num#col#   ) .  run macr_cell_size ( 16 , ? , num#str# , num#col# , ?, ? ) .
     2155       num#col# = 3.
     2156       run macr_excel_char in this-procedure("Наименование"  , num#str# , num#col#   ) . run macr_cell_size ( 30 , ? , num#str# , num#col# , ?, ? ) .
     2157       run print-1 in this-procedure .
     2158       repeat ii = 1 to v-kol-price :
     2159         find first  temp-header where temp-header.id = ii no-error .
     2160         num#col# = num#col# + 1.
     2161         run macr_excel_char in this-procedure( temp-header.name , num#str# , num#col#   ) .
     2162       end.
     2163       run macr_cell_format in this-procedure
     2164       ( 10    ,
     2165         true  ,
     2166         false ,
     2167         ?     ,
     2168         1     ,
     2169         1     ,
     2170         num#str# ,
     2171         num#col# ) .
     2172        put  stream macr_excel unformatted
     2173          substitute('select("r&1c&2:r&3c&4 ")' , num#str# , 1 , num#str# ,  num#col# ) + chr(10)  +
     2174          'BORDER( 2 , 2 , 2 , 2 , 2 , ,0,0,0,0,0) '  + chr(10) +
     2175          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     2176          .
     2177       put  stream macr_excel unformatted
     2178          substitute('select("r&1c&2:r&3c&4 ")' , num#str# , 1 , num#str# ,  3 ) + chr(10)  +
     2179          'BORDER( 2, , , , , , , , , , ) '  + chr(10) .
     2180     end.
     2181   end procedure.
     2182   procedure PrintPodval :
     2183     do on error undo, return error return-value  :
     2184     define variable pp as integer no-undo .
     2185     define variable rr as integer no-undo .
     2186       run p-line in this-procedure.
     2187     end.
     2188   end procedure.
     2189   PROCEDURE on-same-page :
     2190     define input parameter p-line-number as integer  no-undo .
     2191     if p-line-number > page-size( OutStream ) then return .
     2192     if line-counter( OutStream ) + p-line-number > page-size( OutStream ) then do:
     2193       run p-line in this-procedure.
     2194       page stream OutStream .
     2195       end.
     2196   end procedure.
     2197   procedure print-1 :
     2198   define variable ii as integer   no-undo .
     2199     do
     2200     on error undo, return error return-value
     2201     :
     2202       run p-line in this-procedure.
     2203       PUT STREAM OutStream UNFORMATTED  ":Код"  AT 1 format "X(11)" .
     2204       PUT STREAM OutStream UNFORMATTED  ":Артикул"  format "X(17)" .
     2205       PUT STREAM OutStream UNFORMATTED  ":Наименование"  format "X(31)" .
     2206         repeat ii = 1 to v-kol-price :
     2207           find first  temp-header where temp-header.id = ii no-error .
     2208           put stream outstream unformatted   ":от " + string(temp-header.first_)    format "x(12)" space(0)  .
     2209         end.
     2210       put stream outstream unformatted skip .
     2211       run p-line in this-procedure.
     2212     end.
     2213   end procedure.
     2214   procedure p-line :
     2215   define variable ii as integer   no-undo .
     2216     do
     2217     on error undo, return error return-value
     2218     :
     2219       PUT STREAM OutStream UNFORMATTED  fill("-",11)  AT 1 format "X(11)" .
     2220       PUT STREAM OutStream UNFORMATTED  fill("-",17)  format "X(17)" .
     2221       PUT STREAM OutStream UNFORMATTED  fill("-",31)  format "X(31)" .
     2222         repeat ii = 1 to v-kol-price :
     2223           put stream outstream unformatted   fill("-",12)  format "x(12)" space(0)  .
     2224         end.
     2225       PUT STREAM OutStream UNFORMATTED  skip .
     2226     end.
     2227   end procedure.
     2228   procedure make-header :
     2229   define buffer buf_sum-in-sum-group for ub.sum-in-sum-group  .
     2230   define buffer last_sum-in-sum-group for ub.sum-in-sum-group  .
     2231   define output parameter ii as integer   no-undo  .
     2232     do
     2233     on error undo, return error return-value
     2234     :
     2235       ii = 0 .
     2236       for each buf_sum-in-sum-group no-lock where
     2237                 buf_sum-in-sum-group.sgr-db-num  = buf_sum-group.sgr-db-num  and
     2238                 buf_sum-in-sum-group.sgr-id      = buf_sum-group.sgr-id       and
     2239                 buf_sum-in-sum-group.stts        = 0
     2240                 break by buf_sum-in-sum-group.ssg-sum
     2241                 :
     2242                 find first  last_sum-in-sum-group no-lock  where
     2243                             last_sum-in-sum-group.stts       = 0 and
     2244                             last_sum-in-sum-group.sgr-db-num = buf_sum-in-sum-group.sgr-db-num and
     2245                             last_sum-in-sum-group.sgr-id     = buf_sum-in-sum-group.sgr-id      and
     2246                             last_sum-in-sum-group.ssg-sum   > buf_sum-in-sum-group.ssg-sum
     2247                             use-index pi no-error .
     2248           ii = ii + 1.
     2249           create  temp-header.
     2250             assign
     2251             temp-header.id     = ii
     2252             temp-header.first_ = buf_sum-in-sum-group.ssg-sum
     2253             temp-header.to_  = if available last_sum-in-sum-group then  last_sum-in-sum-group.ssg-sum   else ?
     2254             temp-header.last_  = if available last_sum-in-sum-group then ( last_sum-in-sum-group.ssg-sum - 1 )  else ?
     2255             temp-header.name   = "не менее " + string( buf_sum-in-sum-group.ssg-sum )
     2256             temp-header.name   = "c " + string (temp-header.first_) +
     2257             (if temp-header.last_ = ? then ""
     2258                                       else " по " + string (temp-header.last_))
     2259             .
     2260       end.
     2261     end.
     2262   end procedure.
     2263   procedure make-tt :
     2264   define input  parameter p-obj-type as character no-undo .
     2265   define input  parameter p-obj-code as integer no-undo .
     2266   define buffer buf_bar-code for ub.bar-code  .
     2267   define buffer buf_clients  for ub.clients  .
     2268   define variable v-i as integer   no-undo .
     2269     do
     2270     on error undo, return error return-value
     2271     :
     2272     define buffer buf_price-all for ub.price-all.
     2273     v-i = 0.
     2274     for each temp-price : delete temp-price. end.
     2275     for each temp-pdf   : delete temp-pdf  . end.
     2276     for each buf_price-all no-lock where
     2277             buf_price-all.obj-type = p-obj-type and
     2278             buf_price-all.obj-code = p-obj-code and
     2279             buf_price-all.main-indication = v-type and
     2280             (( buf_price-all.fact-order-sys-from = 0 ) or (buf_price-all.fact-order-sys-from <= v-fact-order)) and
     2281             (( buf_price-all.fact-order-sys-to = 0 )   or (buf_price-all.fact-order-sys-to >= v-fact-order)) and
     2282             (( v-curr-code = ?) or (buf_price-all.curr-code = v-curr-code ))
     2283             by buf_price-all.fact-order desc
     2284             :
     2285             if buf_price-all.main-indication = 3 then do:
     2286                find first temp-header where
     2287                           temp-header.first_ = buf_price-all.sum-from and
     2288                           temp-header.to_    = buf_price-all.sum-to   no-error .
     2289                if error-status :error then do:
     2290                   next.
     2291                end.
     2292                find first buf_bar-code no-lock where buf_bar-code.b-code = buf_price-all.b-code no-error .
     2293                find first buf_goods    no-lock where buf_goods.gds-code = buf_bar-code.gds-code no-error .
     2294                find first buf_clients  no-lock where buf_clients.obj-type = buf_goods.prod-type and
     2295                                                      buf_clients.obj-code = buf_goods.prod-code no-error.
     2296                  v-i = v-i + 1.
     2297   IF ( v-i modulo v-account = 0 )  then DO:
     2298    Assign
     2299       v-kol-spice = (50 - LENGTH(buf_goods.gds-name)) / 2
     2300       RecordsString = fill(' ',v-kol-spice) + string(buf_goods.gds-name)
     2301       .
     2302             if  log-manager:logfile-name ne ?
     2303             then DO:
     2304                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     2305             end.
     2306              if mFrameView
     2307              then do:
     2308               DISPLAY
     2309                 v-i @ RecordsDone
     2310                 RecordsString   @ RecordsString
     2311                 WITH FRAME InfoFrame.
     2312              end.
     2313   End.
     2314      if v-button-stop then  DO:
     2315            if mFrameView
     2316            then
     2317               PROCESS EVENTS.
     2318            IF StopProcessing THEN DO:
     2319            RETURN error.
     2320            End.
     2321      end.
     2322                new-curr-code = buf_price-all.curr-code.
     2323                create temp-price .
     2324                assign
     2325                   temp-price.b-code     = buf_price-all.b-code
     2326                   temp-price.gds-code   = buf_bar-code.gds-code
     2327                   temp-price.id         = temp-header.id
     2328                   temp-price.price-sale = buf_price-all.price-sale
     2329                   temp-price.plt-id     = buf_price-all.plt-id
     2330                   temp-price.plt-db-num = buf_price-all.plt-db-num
     2331                .
     2332               find first temp-pdf where
     2333                          temp-pdf.b-code     = buf_price-all.b-code     and
     2334                          temp-pdf.plt-id     = buf_price-all.plt-id     and
     2335                          temp-pdf.plt-db-num = buf_price-all.plt-db-num  no-error .
     2336               if not available temp-pdf then do:
     2337                   create temp-pdf.
     2338                   assign
     2339                       temp-pdf.gds-code   = buf_bar-code.gds-code
     2340                       temp-pdf.prior      = buf_price-all.plt-priority
     2341                       temp-pdf.date1      = buf_price-all.start-date
     2342                       temp-pdf.date2      = buf_price-all.end-date
     2343                       temp-pdf.b-code     = buf_price-all.b-code
     2344                       temp-pdf.plt-id     = buf_price-all.plt-id
     2345                       temp-pdf.plt-db-num = buf_price-all.plt-db-num
     2346                       temp-pdf.gds-name   = buf_goods.gds-name
     2347                       temp-pdf.artic      = buf_goods.artic
     2348                       temp-pdf.prod-typecode  = buf_goods.prod-type + string(buf_goods.prod-code)
     2349                       temp-pdf.prod-name  = buf_clients.obj-name
     2350                       temp-pdf.grp-code   = buf_goods.grp-code
     2351                       temp-pdf.grp-name   = buf_goods.grp-name
     2352                   .
     2353               end.
     2354             end.
     2355     end.
     2356   end.
     2357   end procedure.
     2358   procedure din-tt-go :
     2359   define input  parameter p-table-name    as character no-undo .
     2360   define input  parameter P-query-prepare as character no-undo .
     2361   define input  parameter p-sort-pole  as character no-undo .
     2362   define input  parameter p-sort-pole2 as character no-undo .
     2363   define variable qh as widget-handle no-undo .
     2364   define variable bh as widget-handle no-undo .
     2365   define variable old-sort-pole as character no-undo .
     2366   define variable new-sort-pole as character no-undo .
     2367   define variable old-sort-pole2 as character no-undo .
     2368   define variable new-sort-pole2 as character no-undo .
     2369     do
     2370     on error undo, return error return-value
     2371     :
     2372       create buffer bh for table p-table-name.
     2373       create query qh.
     2374         qh:set-buffers (bh).
     2375         qh:query-prepare (p-query-prepare).
     2376         qh:query-open ().
     2377         qh:get-first ().
     2378         if bh:available <> true then do:
     2379            qh:query-close() .
     2380            delete object qh.
     2381            delete object bh.
     2382            return.
     2383          end.
     2384          old-sort-pole  = bh:buffer-field ( p-sort-pole  ):buffer-value .
     2385          old-sort-pole2 = bh:buffer-field ( p-sort-pole2 ):buffer-value .
     2386          run print-grp-header  ( bh:recid , old-sort-pole ) .
     2387          run print-grp-header2 ( bh:recid , old-sort-pole2 ) .
     2388         do while qh:query-off-end = false :
     2389             new-sort-pole  = bh:buffer-field ( p-sort-pole ):buffer-value .
     2390             new-sort-pole2 = bh:buffer-field ( p-sort-pole2):buffer-value .
     2391             if old-sort-pole <> new-sort-pole then do:
     2392               run print-grp-header ( bh:recid , new-sort-pole ) .
     2393             end.
     2394                 if old-sort-pole2 <> new-sort-pole2 or old-sort-pole <> new-sort-pole
     2395                 then do:
     2396                   run print-grp-header2 ( bh:recid , new-sort-pole2 ) .
     2397                 end.
     2398             run print-line ( bh:recid ) .
     2399             qh:get-next().
     2400             old-sort-pole  = new-sort-pole.
     2401             old-sort-pole2 = new-sort-pole2.
     2402         end.
     2403       qh:query-close() .
     2404       delete object qh.
     2405       delete object bh.
     2406     end.
     2407   end procedure.
     2408   procedure print-grp-header :
     2409   define input  parameter p-recid as recid no-undo .
     2410   define input  parameter p-sort-pole as character no-undo .
     2411   define buffer buf_temp-pdf for temp-pdf  .
     2412   define variable v-name as character no-undo .
     2413   define variable v-val as character no-undo .
     2414     do
     2415     on error undo, return error return-value
     2416     :
     2417       find first buf_temp-pdf where recid(buf_temp-pdf) = p-recid no-error .
     2418       case v-clas:
     2419           when "no-classify":U then do:
     2420               return.
     2421           end.
     2422           when "prod":U        then do:
     2423             v-name = "По производителю " .
     2424             if available buf_temp-pdf then v-val = buf_temp-pdf.prod-name .
     2425             else      v-val = p-sort-pole.
     2426           end.
     2427           when "grp-goods":U   then do:
     2428             v-name = "По группе " .
     2429             if available buf_temp-pdf then v-val = buf_temp-pdf.grp-name .
     2430             else      v-val = p-sort-pole.
     2431           end.
     2432           when "prod/grp-goods":U then do:
     2433             v-name = "По производителю " .
     2434             if available buf_temp-pdf then v-val = buf_temp-pdf.prod-name .
     2435             else      v-val = p-sort-pole.
     2436           end.
     2437           when "grp-goods/prod":U then do:
     2438             v-name = "По группе " .
     2439             if available buf_temp-pdf then v-val = buf_temp-pdf.grp-name .
     2440             else      v-val = p-sort-pole.
     2441           end.
     2442       end case.
     2443       put stream outstream unformatted  ( v-name + v-val ) at 1 skip .
     2444       num#col# = 1 .
     2445       num#str# = num#str# + 1 .
     2446       run macr_cell_format in this-procedure
     2447           ( 10    ,
     2448             true  ,
     2449             false ,
     2450             ?     ,
     2451             num#str# ,
     2452             num#col# ,
     2453             num#str# ,
     2454             num#col# ) .
     2455       run macr_excel_char in this-procedure( v-name + v-val  , num#str# , num#col#   ) .
     2456     end.
     2457   end procedure.
     2458   procedure print-grp-header2 :
     2459   define input  parameter p-recid as recid no-undo .
     2460   define input  parameter p-sort-pole as character no-undo .
     2461   define buffer buf_temp-pdf for temp-pdf  .
     2462   define variable v-name as character no-undo .
     2463   define variable v-val as character no-undo .
     2464     do
     2465     on error undo, return error return-value
     2466     :
     2467       find first buf_temp-pdf where recid(buf_temp-pdf) = p-recid no-error .
     2468       case v-clas:
     2469           when "no-classify":U then do:
     2470               return.
     2471           end.
     2472           when "prod":U        then do:
     2473              return.
     2474           end.
     2475           when "grp-goods":U   then do:
     2476              return.
     2477           end.
     2478           when "prod/grp-goods":U then do:
     2479             v-name = "По группе " .
     2480             if available buf_temp-pdf then v-val = buf_temp-pdf.grp-name .
     2481                                       else v-val = p-sort-pole.
     2482           end.
     2483           when "grp-goods/prod":U then do:
     2484             v-name = "По производителю " .
     2485             if available buf_temp-pdf then v-val = buf_temp-pdf.prod-name .
     2486                                       else v-val = p-sort-pole.
     2487           end.
     2488       end case.
     2489       put stream outstream unformatted  ( v-name + v-val ) at 10 skip .
     2490       num#col# = 2 .
     2491       num#str# = num#str# + 1 .
     2492       run macr_cell_format in this-procedure
     2493           ( 10    ,
     2494             true  ,
     2495             false ,
     2496             ?     ,
     2497             num#str# ,
     2498             num#col# ,
     2499             num#str# ,
     2500             num#col# ) .
     2501       run macr_excel_char in this-procedure ( v-name + v-val  , num#str# , num#col# ) .
     2502     end.
     2503   end procedure.
     2504   def var vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2505   procedure macr_excel_char :
     2506    do
     2507    on error undo, return error return-value
     2508    :
     2509    define input parameter  p-val as character no-undo .
     2510    define input parameter  p-row as integer no-undo .
     2511    define input parameter  p-col as integer no-undo .
     2512    if p-val = ? then p-val = "" .
     2513       put stream macr_excel unformatted
     2514             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     2515    end.
     2516   end procedure.
     2517   procedure macr_excel_char_with_format :
     2518    do
     2519    on error undo, return error return-value
     2520    :
     2521    define input parameter  p-val as character no-undo .
     2522    define input parameter  p-row as integer no-undo .
     2523    define input parameter  p-col as integer no-undo .
     2524    if p-val = ? then p-val = "" .
     2525       put stream macr_excel unformatted
     2526             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     2527       put stream macr_excel unformatted 'format.number("@")' + chr(10) .
     2528       put stream macr_excel unformatted
     2529             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     2530    end.
     2531   end procedure.
     2532   procedure macr_excel_cell_format :
     2533    do
     2534    on error undo, return error return-value
     2535    :
     2536    define input parameter  p-val    as character no-undo .
     2537    define input parameter  p-row    as integer   no-undo .
     2538    define input parameter  p-col    as integer   no-undo .
     2539    define input parameter  p-format as character no-undo .
     2540    if p-val = ? then p-val = "" .
     2541       put stream macr_excel unformatted
     2542             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     2543       put stream macr_excel unformatted substitute('format.number("&1")', p-format) + chr(10) .
     2544       put stream macr_excel unformatted
     2545             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     2546    end.
     2547   end procedure.
     2548   procedure macr_excel_sum :
     2549    do
     2550    on error undo, return error return-value
     2551    :
     2552    define input parameter  p-row as integer no-undo .
     2553    define input parameter  p-col as integer no-undo .
     2554    define input parameter  p-row1 as integer no-undo .
     2555    define input parameter  p-col1 as integer no-undo .
     2556    define input parameter  p-row2 as integer no-undo .
     2557    define input parameter  p-col2 as integer no-undo .
     2558       put stream macr_excel unformatted
     2559             substitute('formula("=sum(r&3c&4:r&5c&6)","r&1c&2")', p-row , p-col , p-row1 , p-col1 ,p-row2 , p-col2 ) + chr(10)  .
     2560    end.
     2561   end procedure.
     2562   procedure macr_excel_dec :
     2563    do
     2564    on error undo, return error return-value
     2565    :
     2566    define input parameter  p-val as character no-undo .
     2567    define input parameter  p-row as integer   no-undo .
     2568    define input parameter  p-col as integer   no-undo .
     2569     if p-val = ? then p-val =  "" .
     2570      put  stream macr_excel unformatted
     2571           substitute('formula(&3,"r&1c&2")', p-row , p-col ,  p-val )  + chr(10) .
     2572    end.
     2573   end procedure.
     2574   procedure macr_cell_format :
     2575    do
     2576    on error undo, return error return-value
     2577    :
     2578    define input parameter  p-size   as integer   no-undo .
     2579    define input parameter  p-bold   as logical   no-undo .
     2580    define input parameter  p-italic as logical   no-undo .
     2581    define input parameter  p-color  as integer   no-undo .
     2582    define input parameter  p-row    as integer   no-undo .
     2583    define input parameter  p-col    as integer   no-undo .
     2584    define input parameter  p-row-2  as integer   no-undo .
     2585    define input parameter  p-col-2  as integer   no-undo .
     2586     if p-size = ? then p-size = 10 .
     2587     if p-bold = ? then p-bold = false .
     2588     if p-italic = ? then p-italic = false .
     2589     if p-row-2 = ? then p-row-2 = p-row .
     2590     if p-col-2 = ? then p-col-2 = p-col .
     2591     put  stream macr_excel unformatted
     2592      substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 ) + chr(10) .
     2593     if p-color <> ? then do:
     2594        put  stream macr_excel unformatted
     2595          substitute('patterns(1,,&1,true)', p-color ) + chr(10)  .
     2596     end.
     2597     put  stream macr_excel unformatted
     2598          substitute('format.font(,&1,&2,&3)' , p-size,
     2599                                           string ( p-bold  , "true/false" ) ,
     2600                                           string ( p-italic , "true/false" )
     2601                                           ) + chr(10) .
     2602    end.
     2603   end procedure.
     2604   procedure macr_cell_size :
     2605    do
     2606    on error undo, return error return-value
     2607    :
     2608    define input parameter  p-w   as integer   no-undo .
     2609    define input parameter  p-l   as integer   no-undo .
     2610    define input parameter  p-row    as integer   no-undo .
     2611    define input parameter  p-col    as integer   no-undo .
     2612    define input parameter  p-row-2  as integer   no-undo .
     2613    define input parameter  p-col-2  as integer   no-undo .
     2614     if p-row-2 = ? then p-row-2 = p-row .
     2615     if p-col-2 = ? then p-col-2 = p-col .
     2616     if p-w = ? then    p-w = 0 .
     2617     if p-l = ? then    p-l = 0 .
     2618    define variable s-w as character no-undo .
     2619    define variable s-l as character no-undo .
     2620    if p-w = 0 then s-w = "" .
     2621               else s-w = string(p-w)  .
     2622    if p-l = 0 then s-l = "" .
     2623               else s-l = string(p-l)  .
     2624   put  stream macr_excel unformatted
     2625        substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 )  skip .
     2626   put  stream macr_excel unformatted
     2627        substitute('COLUMN.WIDTH(&1,,,,)' , s-w  )  skip.
     2628   put  stream macr_excel unformatted
     2629        'FORMAT.TEXT(2,2,0,,,,,)'  skip.
     2630    end.
     2631   end procedure.
     2632   procedure proc-print-header :
     2633    do
     2634    on error undo, return error return-value
     2635    :
     2636      find first sheetf .
     2637        sheetf.excel-row-heder =  num-entries( c-str ,chr(10)) + 1.
     2638        sheetf.excel-row-title =  num-entries( sheetf.excel-column-lable , chr(10) ).
     2639        var-1 =  num#str# .
     2640        repeat c-c = 1 to sheetf.excel-row-title :
     2641        num#str# = num#str# + 1 .
     2642        p-var = num-entries( entry (c-c, sheetf.excel-column-lable, chr(10)) , chr(44) ) .
     2643        do c-i = 1 to p-var :
     2644           str--1 = entry( c-i, entry (c-c,sheetf.excel-column-lable, chr(10)) , chr(44)) .
     2645           str--2 = integer(entry( c-i, sheetf.sizes )) .
     2646           num#col# = c-i .
     2647           run macr_excel_char_with_format ( str--1  , num#str# , num#col#  ) .
     2648           run macr_cell_size ( str--2 , ? , num#str# , num#col# , ?, ? ) .
     2649        end.
     2650       c-i = 0.
     2651       end.
     2652       run macr_cell_format (
     2653           10       ,
     2654           true     ,
     2655           false    ,
     2656           35       ,
     2657           var-1 + 1,
     2658           1        ,
     2659           num#str# ,
     2660           num#col# )
     2661           .
     2662     put  stream macr_excel unformatted
     2663          substitute('select("r&1c&2:r&3c&4 ")' , var-1 + 1 , 1 , num#str# ,  num#col# ) + chr(10)  +
     2664          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     2665          .
     2666    end.
     2667   end procedure.
     2668   procedure end-proc :
     2669    do
     2670    on error undo, return error return-value
     2671    :
     2672     v-file-name = ( string( session:temp-directory + "rpt" + string( g#report-num ) ) + ".t-t").
     2673     OUTPUT to VALUE (v-file-name) .
     2674     for each temp-param :
     2675       export  temp-param  .
     2676     end.
     2677    end.
     2678   end procedure.
