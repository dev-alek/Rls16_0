      372   procedure create_obj-list :
      373      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      374      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      375      do
      376      on error undo, return error return-value
      377      :
      378         define buffer cli-obj for ub.clients .
      379         define variable p-var as integer no-undo .
      380         define buffer buf_obj-list for obj-list .
      381         find last buf_obj-list  use-index pi no-error .
      382         if available buf_obj-list
      383         then
      384            p-var = buf_obj-list.obj-id + 1.
      385         else
      386            p-var = 1.
      387         find first cli-obj where
      388                   cli-obj.obj-type = p-obj-type
      389               and cli-obj.obj-code = p-obj-code
      390         no-lock no-error.
      391         if available cli-obj
      392         then do:
      393            create buf_obj-list.
      394            assign
      395               buf_obj-list.obj-id   = p-var
      396               buf_obj-list.obj-code = cli-obj.obj-code
      397               buf_obj-list.obj-type = cli-obj.obj-type
      398               buf_obj-list.obj-name = cli-obj.obj-name
      399               buf_obj-list.db-num   = cli-obj.db-num
      400            .
      401         end.
      402      end.
      403   end.
