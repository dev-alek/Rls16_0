     1160   DEFINE FRAME F-Main
     1161       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
     1162            SIDE-LABELS NO-UNDERLINE THREE-D
     1163            AT COL 1 ROW 1
     1164            SIZE 32 BY 11.88.
     1165   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     1166   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     1167   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     1168   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     1169   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     1170   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     1171   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     1172   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     1173       ASSIGN adm-object-hdl = FRAME F-Main:HANDLE.
     1174   RUN ensure-broker.
     1175   THIS-PROCEDURE:ADM-DATA =
     1176        'ADM1.1~`':U +
     1177        'SmartObject~`':U +
     1178        'FRAME~`':U +
     1179        'NO ~`':U +
     1180        '~`':U +
     1181        '~`':U +
     1182        '~`':U +
     1183        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     1184           + "~`":U +
     1185        'Layout,Hide-on-Init~`':U +
     1186        '~`':U +
     1187        '~`':U +
     1188        '~`~`~`~`~`~`~`~`~`~`~`':U +
     1189        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1190            THEN "^^":U
     1191        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1192             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1193   PROCEDURE adm-apply-entry :
     1194     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1195   END PROCEDURE.
     1196   PROCEDURE adm-destroy :
     1197    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1198   END PROCEDURE.
     1199   PROCEDURE adm-disable :
     1200       DISABLE  WITH FRAME F-Main.
     1201       RUN dispatch ('disable-fields':U).
     1202       RUN set-attribute-list ('ENABLED=no':U).
     1203       RETURN.
     1204   END PROCEDURE.
     1205   PROCEDURE adm-edit-attribute-list :
     1206         RUN adm/support/contnrd.w (INPUT THIS-PROCEDURE).
     1207         RETURN.
     1208   END PROCEDURE.
     1209   PROCEDURE adm-enable :
     1210       ENABLE UNLESS-HIDDEN  WITH FRAME F-Main.
     1211       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     1212       RUN set-attribute-list ('ENABLED=yes':U).
     1213       RETURN.
     1214   END PROCEDURE.
     1215   PROCEDURE adm-exit :
     1216        RUN notify ('exit':U).
     1217     RETURN.
     1218   END PROCEDURE.
     1219   PROCEDURE adm-hide :
     1220     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1221   END PROCEDURE.
     1222   PROCEDURE adm-initialize :
     1223     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1224   END PROCEDURE.
     1225   PROCEDURE adm-show-errors :
     1226       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1227       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1228           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1229       END.
     1230       RETURN.
     1231   END PROCEDURE.
     1232   PROCEDURE adm-UIB-mode :
     1233     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1234   END PROCEDURE.
     1235   PROCEDURE adm-view :
     1236     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1237   END PROCEDURE.
     1238   PROCEDURE dispatch :
     1239       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1240       RUN broker-dispatch IN adm-broker-hdl
     1241           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1242       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1243   END PROCEDURE.
     1244   PROCEDURE ensure-broker :
     1245   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1246   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1247   DO:
     1248       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1249       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1250   END.
     1251   END PROCEDURE.
     1252   PROCEDURE get-attribute :
     1253     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1254     RUN broker-get-attribute IN adm-broker-hdl
     1255         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1256     RETURN RETURN-VALUE.
     1257   END PROCEDURE.
     1258   PROCEDURE get-attribute-list :
     1259     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1260     RUN broker-get-attribute-list IN adm-broker-hdl
     1261         (INPUT THIS-PROCEDURE,
     1262          INPUT ?,
     1263          OUTPUT p-attr-list) NO-ERROR.
     1264     RETURN.
     1265   END PROCEDURE.
     1266   PROCEDURE new-state :
     1267     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1268     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1269     RETURN.
     1270   END PROCEDURE.
     1271   PROCEDURE notify :
     1272     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1273     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1274     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1275         RETURN "ADM-ERROR":U.
     1276     RETURN.
     1277   END PROCEDURE.
     1278   PROCEDURE set-attribute-list :
     1279     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1280     RUN ensure-broker.
     1281     RUN broker-set-attribute-list IN adm-broker-hdl
     1282         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1283     RETURN.
     1284   END PROCEDURE.
     1285   PROCEDURE set-position :
     1286       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1287       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1288       IF VALID-HANDLE(adm-object-hdl) THEN
     1289       DO:
     1290           DEFINE VARIABLE parent-hdl AS HANDLE NO-UNDO.
     1291           IF adm-object-hdl:TYPE = "WINDOW":U THEN
     1292           DO:
     1293             IF p-row = 0 THEN p-row =
     1294               (SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2.
     1295             IF p-col = 0 THEN p-col =
     1296               (SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2.
     1297           END.
     1298           ELSE IF adm-object-hdl:TYPE = "DIALOG-BOX":U THEN
     1299           DO:
     1300             parent-hdl = adm-object-hdl:PARENT.
     1301             IF p-row = 0 THEN p-row =
     1302               ((SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2) -
     1303                 parent-hdl:ROW.
     1304             IF p-col = 0 THEN p-col =
     1305               ((SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2) -
     1306                 parent-hdl:COL.
     1307           END.
     1308           IF p-row GE 0 AND p-row < 1 THEN p-row = 1.
     1309           IF p-col GE 0 AND p-col < 1 THEN p-col = 1.
     1310         ASSIGN adm-object-hdl:ROW    =   p-row
     1311                adm-object-hdl:COLUMN =   p-col.
     1312       END.
     1313       RETURN.
     1314   END PROCEDURE.
     1315   RUN set-attribute-list ("CURRENT-PAGE=0,ADM-OBJECT-HANDLE=":U +
     1316       STRING(adm-object-hdl)).
     1317   PAUSE 0 BEFORE-HIDE.
     1318   PROCEDURE adm-change-page :
     1319     RUN broker-change-page IN adm-broker-hdl (INPUT THIS-PROCEDURE) NO-ERROR.
     1320     END PROCEDURE.
     1321   PROCEDURE delete-page :
     1322     DEFINE INPUT PARAMETER p-page# AS INTEGER NO-UNDO.
     1323     RUN broker-delete-page IN adm-broker-hdl
     1324         (INPUT THIS-PROCEDURE, INPUT p-page#).
     1325     END PROCEDURE.
     1326   PROCEDURE init-object :
     1327     DEFINE INPUT PARAMETER  p-proc-name   AS CHARACTER NO-UNDO.
     1328     DEFINE INPUT PARAMETER  p-parent-hdl  AS HANDLE    NO-UNDO.
     1329     DEFINE INPUT PARAMETER  p-attr-list   AS CHARACTER NO-UNDO.
     1330     DEFINE OUTPUT PARAMETER p-proc-hdl    AS HANDLE    NO-UNDO.
     1331     RUN broker-init-object IN adm-broker-hdl
     1332         (INPUT THIS-PROCEDURE, INPUT p-proc-name, INPUT p-parent-hdl,
     1333          INPUT p-attr-list, OUTPUT p-proc-hdl) NO-ERROR.
     1334     RETURN.
     1335   END PROCEDURE.
     1336   PROCEDURE init-pages :
     1337     DEFINE INPUT PARAMETER p-page-list      AS CHARACTER NO-UNDO.
     1338     RUN broker-init-pages IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1339         INPUT p-page-list) NO-ERROR.
     1340     END PROCEDURE.
     1341   PROCEDURE select-page :
     1342     DEFINE INPUT PARAMETER p-page#     AS INTEGER   NO-UNDO.
     1343     RUN broker-select-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1344         INPUT p-page#) NO-ERROR.
     1345     END PROCEDURE.
     1346   PROCEDURE view-page :
     1347     DEFINE INPUT PARAMETER p-page#      AS INTEGER   NO-UNDO.
     1348     RUN broker-view-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1349         INPUT p-page#).
     1350     END PROCEDURE.
     1351   if not this-procedure :persistent
     1352   then do:
     1353     message
     1354       vss-workfile vss-revision vss-description skip
