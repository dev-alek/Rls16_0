     1360   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1361     run mainmenu_getcntxt in my-handle
     1362       (output v-cntxt-db-num
     1363       ,output v-cntxt-userid
     1364       ,output v-cntxt-level
     1365       ,output v-cntxt-host-code-obj
     1366       ,output v-cntxt-obj-type
     1367       ,output v-cntxt-obj-code
     1368       ,output v-cntxt-db-num-obj
