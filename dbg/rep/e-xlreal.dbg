     1371   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1372   PROCEDURE no-benq.
     1373   DEFINE OUTPUT PARAMETER found as logical init no.
     1374   define buffer buf_chk-doc for ub.chk-doc.
     1375   FOR EACH obj-list WHERE
     1376           obj-list.obj-type = 'маг':U NO-LOCK :
     1377     CASE X-Radio-Task > 1 :
     1378       WHEN YES THEN DO:
     1379         FOR EACH buf_chk-doc NO-LOCK WHERE
     1380                 buf_chk-doc.obj-type = obj-list.obj-type AND
     1381                 buf_chk-doc.obj-code = obj-list.obj-code AND
     1382                 (
     1383                   buf_chk-doc.shift-date >= X-date-start AND
     1384                   buf_chk-doc.shift-date <= X-date-end)
     1385                   AND
     1386                   (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1387           IF X-Radio-Task = 3 AND
     1388           ((buf_chk-doc.shift-date = X-date-start AND buf_chk-doc.shift-num < X-shift-Start) OR
     1389             (buf_chk-doc.shift-date = X-date-end AND  buf_chk-doc.shift-num > X-shift-End) ) THEN NEXT.
     1390           IF X-Radio-Task = 4 AND
     1391           (buf_chk-doc.shift-num <> X-shift-Alone ) THEN NEXT.
     1392           found = yes.
     1393           return.
     1394         END.
     1395       END.
     1396       WHEN NO THEN DO:
     1397         FOR EACH buf_chk-doc NO-LOCK WHERE
     1398               buf_chk-doc.obj-type = obj-list.obj-type AND
     1399               buf_chk-doc.obj-code = obj-list.obj-code AND
     1400               buf_chk-doc.chk-date >= X-date-start AND
     1401               buf_chk-doc.chk-date <= X-date-end   AND
     1402               (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1403           found = yes.
     1404           return.
     1405         END.
     1406        END.
     1407      END CASE.
     1408    END.
     1409   END PROCEDURE.
     1410   PROCEDURE no-benqi.
     1411   DEFINE OUTPUT PARAMETER found as logical init no.
     1412   define buffer buf_chk-doc for ub.chk-doc.
     1413   define buffer buf_inkas for ub.inkas.
     1414   FOR EACH obj-list WHERE
     1415         obj-list.obj-type = 'маг':U NO-LOCK :
     1416     CASE X-Radio-Task > 1 :
     1417       WHEN YES THEN DO:
     1418         FOR EACH buf_chk-doc No-LOCK WHERE
     1419                 buf_chk-doc.obj-type = obj-list.obj-type AND
     1420                 buf_chk-doc.obj-code = obj-list.obj-code AND
     1421                 (
     1422                   buf_chk-doc.shift-date >= X-date-start AND
     1423                   buf_chk-doc.shift-date <= X-date-end)
     1424                   AND
     1425                   buf_Chk-doc.out-code = ? AND
     1426                   (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1427           IF X-Radio-Task = 3 AND
     1428           ((buf_chk-doc.shift-date = X-date-start AND buf_chk-doc.shift-num < X-shift-Start) OR
     1429             (buf_chk-doc.shift-date = X-date-end AND  buf_chk-doc.shift-num > X-shift-End) ) THEN NEXT.
     1430           IF X-Radio-Task = 4 AND
     1431           (buf_chk-doc.shift-num <> X-shift-Alone ) THEN NEXT.
     1432           found = yes.
     1433           return.
     1434         END.
     1435         FOR EACH buf_inkas No-LOCK WHERE
     1436                   buf_inkas.obj-type = obj-list.obj-type AND
     1437                   buf_inkas.obj-code = obj-list.obj-code AND
     1438                   (
     1439                   buf_inkas.shift-date >= X-date-start AND
     1440                   buf_inkas.shift-date <= X-date-end):
     1441           if buf_inkas.status_ = 'факт':U
     1442           or buf_inkas.status_ = 'запрос':U then next.
     1443           IF X-Radio-Task = 3 AND
     1444           ((buf_inkas.shift-date = X-date-start AND buf_inkas.shift-num < X-shift-Start) OR
     1445             (buf_inkas.shift-date = X-date-end AND  buf_inkas.shift-num > X-shift-End) ) THEN NEXT.
     1446           IF X-Radio-Task = 4 AND
     1447           (buf_inkas.shift-num <> X-shift-Alone ) THEN NEXT.
     1448           found = yes.
     1449           return.
     1450         END.
     1451       END.
     1452       WHEN NO THEN DO:
     1453         FOR EACH buf_chk-doc NO-LOCK WHERE
     1454                 buf_chk-doc.obj-type = obj-list.obj-type AND
     1455                 buf_chk-doc.obj-code = obj-list.obj-code AND
     1456                 buf_chk-doc.chk-date >= X-date-start AND
     1457                 buf_chk-doc.chk-date <= X-date-end   AND
     1458                 buf_Chk-doc.out-code = ? AND
     1459                 (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1460           found = yes.
     1461           return.
     1462         END.
     1463         FOR EACH buf_inkas NO-LOCK WHERE
     1464                 buf_inkas.obj-type = obj-list.obj-type AND
     1465                 buf_inkas.obj-code = obj-list.obj-code AND
     1466                 buf_inkas.doc-date >= X-date-start AND
     1467                 buf_inkas.doc-date <= X-date-end :
     1468           if buf_inkas.status_ = 'факт':U
     1469           or buf_inkas.status_ = 'запрос':U then next.
     1470           found = yes.
     1471           return.
     1472         END.
     1473       END.
     1474     END CASE.
     1475   END.
     1476   END PROCEDURE.
     1477   PROCEDURE no-benq-i.
     1478   DEFINE OUTPUT PARAMETER found as logical init no.
     1479   define buffer buf_inkas for ub.inkas.
     1480   CASE X-Radio-Task > 1:
     1481     WHEN YES then do:
     1482       FOR EACH obj-list WHERE
     1483               obj-list.obj-type = 'маг':U NO-LOCK :
     1484         FOR EACH buf_inkas NO-LOCK WHERE
     1485                 buf_inkas.obj-type = obj-list.obj-type AND
     1486                 buf_inkas.obj-code = obj-list.obj-code AND
     1487                 buf_inkas.status_ = 'факт':U AND
     1488                 (
     1489                 buf_inkas.shift-date >= X-date-start AND
     1490                 buf_inkas.shift-date <= X-date-end):
     1491           IF X-Radio-Task = 3 AND
     1492           ((buf_inkas.shift-date = X-date-start AND buf_inkas.shift-num < X-shift-Start) OR
     1493             (buf_inkas.shift-date = X-date-end AND  buf_inkas.shift-num > X-shift-End) ) THEN NEXT.
     1494           IF X-Radio-Task = 4 AND
     1495           (buf_inkas.shift-num <> X-shift-Alone ) THEN NEXT.
     1496           found = yes.
     1497           return.
     1498         END.
     1499     END.
     1500     END.
     1501     WHEN NO THEN DO:
     1502       FOR EACH obj-list WHERE
     1503               obj-list.obj-type = 'маг':U NO-LOCK :
     1504         FOR EACH buf_inkas NO-LOCK WHERE
     1505                 buf_inkas.obj-type = obj-list.obj-type AND
     1506                 buf_inkas.obj-code = obj-list.obj-code AND
     1507                 buf_inkas.status_ = 'факт':U AND
     1508                 buf_inkas.doc-date >= X-date-start AND
     1509                 buf_inkas.doc-date <= X-date-end :
     1510            found = yes.
     1511            return.
     1512         END.
     1513       END.
     1514     END.
     1515   END CASE.
     1516   END PROCEDURE.
     1517   PROCEDURE no-benq-i-office.
     1518   DEFINE OUTPUT PARAMETER found as logical init no.
     1519   define buffer buf_sale-doc for ub.sale-doc.
     1520   CASE X-Radio-Task > 1:
     1521     WHEN YES then do:
     1522       FOR EACH obj-list WHERE
     1523               obj-list.obj-type = 'маг':U NO-LOCK :
     1524         FOR EACH buf_sale-doc NO-LOCK WHERE
     1525                  buf_Sale-doc.obj-type = obj-list.obj-type
     1526              AND buf_sale-doc.obj-code = obj-list.obj-code
     1527              AND buf_sale-doc.status_ = 'факт':U
     1528              AND buf_sale-doc.chr-office = 'у':U
     1529              AND (
     1530                 buf_sale-doc.shift-date >= X-date-start
     1531                 AND
     1532                 buf_sale-doc.shift-date <= X-date-end):
     1533           IF X-Radio-Task = 3 AND
     1534           ((buf_sale-doc.shift-date = X-date-start AND buf_sale-doc.shift-num < X-shift-Start) OR
     1535             (buf_sale-doc.shift-date = X-date-end AND  buf_sale-doc.shift-num > X-shift-End) ) THEN NEXT.
     1536           IF X-Radio-Task = 4 AND
     1537           (buf_sale-doc.shift-num <> X-shift-Alone ) THEN NEXT.
     1538           found = yes.
     1539           return.
     1540         END.
     1541       END.
     1542     END.
     1543     WHEN NO THEN DO:
     1544       FOR EACH obj-list WHERE
     1545               obj-list.obj-type = 'маг':U NO-LOCK :
     1546         FOR EACH buf_sale-doc NO-LOCK WHERE
     1547                 buf_sale-doc.obj-type = obj-list.obj-type
     1548            AND  buf_sale-doc.obj-code = obj-list.obj-code
     1549            AND  buf_sale-doc.status_ = 'факт':U
     1550            AND  buf_sale-doc.chr-office = 'у':U
     1551            AND  buf_sale-doc.doc-date >= X-date-start
     1552            AND  buf_sale-doc.doc-date <= X-date-end :
     1553           found = yes.
     1554           return.
     1555         END.
     1556       END.
     1557     END.
     1558   END CASE.
     1559   END PROCEDURE.
     1560   PROCEDURE adm-create-objects :
     1561     DEFINE VARIABLE adm-current-page  AS INTEGER NO-UNDO.
     1562     RUN get-attribute IN THIS-PROCEDURE ('Current-Page':U).
     1563     ASSIGN adm-current-page = INTEGER(RETURN-VALUE).
     1564     CASE adm-current-page:
     1565       WHEN 0 THEN DO:
     1566          RUN init-object IN THIS-PROCEDURE (
     1567                INPUT  'rep/s-month.w':U ,
     1568                INPUT  FRAME F-Main:HANDLE ,
     1569                INPUT  '':U ,
     1570                OUTPUT h_s-month ).
     1571       END.
     1572     END CASE.
     1573   END PROCEDURE.
     1574   PROCEDURE adm-row-available :
     1575     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
     1576     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
     1577     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
     1578     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
     1579     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
     1580     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
     1581     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
     1582     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
     1583     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
     1584     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
     1585     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
     1586     IF adm-updating-record THEN RETURN.
     1587     RUN get-attribute ('FIELDS-ENABLED':U).
     1588     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
     1589     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
     1590         OUTPUT link-handle) NO-ERROR.
     1591     IF link-handle = "":U THEN
     1592         RETURN.
     1593     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
     1594     IF NUM-ENTRIES(link-handle) > 1 THEN
     1595         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
     1596             "encountered more than one RECORD-SOURCE.":U SKIP
     1597             "The first - ":U record-source-hdl:file-name " - will be used.":U
     1598                VIEW-AS ALERT-BOX ERROR.
     1599     RUN get-attribute ('Key-Name':U).
     1600     key-name = RETURN-VALUE.
     1601     IF key-name = "":U THEN key-name = ?.
     1602     IF key-name NE ? THEN DO:
     1603       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
     1604         NO-ERROR.
     1605       IF key-value NE ? THEN
     1606         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
     1607     END.
     1608   IF VALID-HANDLE (adm-object-hdl) THEN
     1609       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1610   RUN notify IN THIS-PROCEDURE ('row-available':U).
     1611   END PROCEDURE.
     1612   PROCEDURE disable_UI :
     1613     HIDE FRAME F-Main.
     1614     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1615   END PROCEDURE.
     1616   PROCEDURE enable_UI :
     1617   END PROCEDURE.
     1618   PROCEDURE My-report :
     1619   define variable     SaleChk-Amount      as  integer     no-undo.
     1620   define variable     ii                              as  integer     no-undo.
     1621   define variable     CurrDay                 as  integer     no-undo.
     1622   define variable     StrBuf              as char         no-undo.
     1623   define variable     NotInc          as  log     no-undo.
     1624   DEFINE VAR XLStrBuf as char no-undo.
     1625   DEFINE VARIABLE v-today as date no-undo .
     1626   DEFINE VARIABLE v-time as integer no-undo .
     1627   define variable v-curr-r-b as character no-undo .
     1628   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1629   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1630     (output v-curr-r-b
     1631     )  .
     1632   define variable p-XL-delim as character no-undo .
     1633   define variable type-par1 as character no-undo .
     1634   define variable tmp-var1  as character no-undo .
     1635   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1636   empty temp-table thbjattr_thbj-attr.
     1637   run adm/shattri.p (
     1638      input "get":U
     1639     ,input v-cntxt-obj-type
     1640     ,input v-cntxt-obj-code
     1641     ,input 'report-firm':U
     1642     ,input  ""
     1643     ,output v-value-character
     1644     ,output v-value-date
     1645     ,output v-value-decimal
     1646     ,output v-value-integer
     1647     ,output v-value-logical
     1648     ,output par-type
     1649     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1650     ) no-error .
     1651   for each thbjattr_thbj-attr :
     1652       if thbjattr_thbj-attr.prop-code = 'XL-delim'  then tmp-var1   = thbjattr_thbj-attr.property-value-character.
     1653   end.
     1654   IF tmp-var1 = "" then p-XL-delim = ";".
     1655   else p-XL-delim = tmp-var1.
     1656   Run Assign-Frame in h_s-month.
     1657   for each day_sum:
     1658       delete day_sum.
     1659   end.
     1660   for each chk-day:
     1661       delete chk-day.
     1662   end.
     1663   for each prods:
     1664       delete prods.
     1665   end.
     1666   for each obj-list No-LOCK:
     1667       accumulate obj-list.obj-code (COUNT).
     1668   END.
     1669   if (accum count obj-list.obj-code) > 1 then do:
     1670       message "Выбрано больше одного объекта для отчета!"
     1671       view-as alert-box ERROR.
     1672       return.
     1673   end.
     1674   run waitfram-show in this-procedure ( "Подождите ..." ) .
     1675   run no-benqi(OUTPUT NotInc).
     1676   FIND FIRST obj-list .
     1677   FOR EACH ub.inkas WHERE
     1678            ub.inkas.obj-type = obj-list.obj-type AND
     1679            ub.inkas.obj-code = obj-list.obj-code AND
     1680            ub.inkas.doc-date >= vStartPoint AND
     1681            ub.inkas.doc-date <= vEndPoint AND
     1682            ub.inkas.status_ = 'факт':U      NO-LOCK
     1683            BREAK BY ub.inkas.obj-type
     1684                  BY ub.inkas.obj-code
     1685                  BY ub.inkas.doc-date :
     1686       FIND FIRST ub.trn-doc where ub.trn-doc.doc-code = ub.inkas.inkas-code no-lock no-error.
     1687       FIND FIRST ret-doc where ret-doc.doc-code = trn-doc.out-code no-lock no-error.
     1688       if first-of( ub.inkas.doc-date ) then
     1689       assign
     1690       SaleChk-Amount = 0
     1691       CurrDay = day( inkas.doc-date )
     1692       .
     1693       _chk-doc:
     1694       FOR EACH ub.chk-doc where ub.chk-doc.out-code = ub.inkas.inkas-code NO-LOCK:
     1695          if lookup(string(ub.chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0 then next _chk-doc.
     1696          SaleChk-Amount = SaleChk-Amount + ( if ub.chk-doc.tot-doc > 0 then 1 else ( -1 ) ) .
     1697       END.
     1698       ACCUMULATE
     1699       SaleChk-Amount ( SUB-TOTAL BY ub.inkas.doc-date )
     1700       inkas.inkas-code ( COUNT )
     1701       .
     1702       FOR EACH ub.gds-dtl NO-LOCK WHERE ub.gds-dtl.doc-code = ub.trn-doc.doc-code
     1703           BREAK BY ub.gds-dtl.prod-type BY ub.gds-dtl.prod-code:
     1704           FIND FIRST day_sum WHERE
     1705                      day_sum.day_ = CurrDay AND
     1706                      day_sum.prod-type = ub.gds-dtl.prod-type AND
     1707                      day_sum.prod-code = ub.gds-dtl.prod-code NO-ERROR .
     1708           if NOT available day_sum then do:
     1709               FIND FIRST ub.clients WHERE ub.clients.obj-type = ub.gds-dtl.prod-type AND
     1710                                        ub.clients.obj-code = ub.gds-dtl.prod-code NO-LOCK .
     1711               CREATE day_sum .
     1712               assign
     1713               day_sum.day_ = CurrDay
     1714               day_sum.prod-type = ub.gds-dtl.prod-type
     1715               day_sum.prod-code = ub.gds-dtl.prod-code
     1716               day_sum.prod-attr = ub.gds-dtl.prod-type + string( gds-dtl.prod-code )
     1717               day_sum.prod-qnty = ub.gds-dtl.doc-qnty
     1718               day_sum.prod-sum = ub.gds-dtl.doc-qnty * ub.gds-dtl.cur-base
     1719               day_sum.sale-sum = ub.gds-dtl.doc-qnty * (if v-curr-r-b = 'base':U then  ub.gds-dtl.price-base else ub.gds-dtl.price-rubl)
     1720               day_sum.discnt-sum = gds-dtl.doc-qnty * (if v-curr-r-b = 'base':U then  ub.gds-dtl.discnt-base else ub.gds-dtl.discnt-rubl)
     1721               .
     1722               FOR EACH ub.chk-gds where
     1723                        ub.chk-gds.out-code = ub.inkas.inkas-code,
     1724                   FIRST ub.bar-code No-LOCK where
     1725                         ub.bar-code.b-code = ub.chk-gds.b-code,
     1726                   FIRST ub.goods No-LOCK WHERE
     1727                         ub.goods.gds-code = ub.bar-code.gds-code AND
     1728                         ub.goods.prod-type = day_sum.prod-type AND
     1729                         ub.goods.prod-code = day_sum.prod-code:
     1730                   day_sum.str-qnty = day_sum.str-qnty +
     1731                                      ( if ub.chk-gds.doc-qnty > 0 then 1 else -1 ).
     1732               END.
     1733               FIND FIRST prods WHERE
     1734                         prods.prod-type = ub.gds-dtl.prod-type AND
     1735                         prods.prod-code = ub.gds-dtl.prod-code NO-ERROR .
     1736               if NOT available prods then do:
     1737                   CREATE prods .
     1738                   assign
     1739                   prods.prod-type = ub.gds-dtl.prod-type
     1740                   prods.prod-code = ub.gds-dtl.prod-code
     1741                   prods.prod-attr = ub.gds-dtl.prod-type + string( ub.gds-dtl.prod-code )
     1742                   prods.prod-name = ub.clients.obj-name
     1743                   .
     1744               end.
     1745            end.
     1746            else
     1747            assign
     1748            day_sum.prod-qnty = day_sum.prod-qnty + ub.gds-dtl.doc-qnty
     1749            day_sum.prod-sum = day_sum.prod-sum + ub.gds-dtl.doc-qnty * ub.gds-dtl.cur-base
     1750            day_sum.sale-sum = day_sum.sale-sum + ub.gds-dtl.doc-qnty * (if v-curr-r-b = 'base':U then  ub.gds-dtl.price-base else gds-dtl.price-rubl)
     1751            day_sum.discnt-sum = day_sum.discnt-sum + ub.gds-dtl.doc-qnty * (if v-curr-r-b = 'base':U then  ub.gds-dtl.discnt-base else gds-dtl.discnt-rubl)
     1752            .
     1753         END.
     1754         if available ret-doc then do:
     1755           FOR EACH ub.gds-dtl NO-LOCK WHERE ub.gds-dtl.doc-code = ret-doc.doc-code
     1756               BREAK BY ub.gds-dtl.prod-type
     1757                     BY ub.gds-dtl.prod-code:
     1758               FIND FIRST day_sum WHERE
     1759                         day_sum.day_ = CurrDay AND
     1760                         day_sum.prod-type = ub.gds-dtl.prod-type AND
     1761                         day_sum.prod-code = ub.gds-dtl.prod-code NO-ERROR .
     1762               if NOT available day_sum then do:
     1763                   FIND FIRST clients WHERE ub.clients.obj-type = ub.gds-dtl.prod-type AND
     1764                                           ub.clients.obj-code = ub.gds-dtl.prod-code NO-LOCK .
     1765                   CREATE day_sum .
     1766                   assign
     1767                   day_sum.day_ = CurrDay
     1768                   day_sum.prod-type = ub.gds-dtl.prod-type
     1769                   day_sum.prod-code = ub.gds-dtl.prod-code
     1770                   day_sum.prod-attr = ub.gds-dtl.prod-type + string( ub.gds-dtl.prod-code )
     1771                   day_sum.prod-qnty = - ub.gds-dtl.doc-qnty
     1772                   day_sum.prod-sum = - ub.gds-dtl.doc-qnty * ub.gds-dtl.cur-base
     1773                   day_sum.sale-sum = - ub.gds-dtl.doc-qnty * (if v-curr-r-b = 'base':U then  ub.gds-dtl.price-base else ub.gds-dtl.price-rubl)
     1774                   day_sum.discnt-sum = - ub.gds-dtl.doc-qnty * (if v-curr-r-b = 'base':U then  ub.gds-dtl.discnt-base else ub.gds-dtl.discnt-rubl)
     1775                   .
     1776                   FOR EACH ub.chk-gds where
     1777                           ub.chk-gds.out-code = ub.inkas.inkas-code,
     1778                       FIRST ub.bar-code No-LOCK where
     1779                             ub.bar-code.b-code = ub.chk-gds.b-code,
     1780                       FIRST ub.goods No-LOCK WHERE
     1781                             ub.goods.gds-code = ub.bar-code.gds-code AND
     1782                             ub.goods.prod-type = day_sum.prod-type AND
     1783                             ub.goods.prod-code = day_sum.prod-code:
     1784                       day_sum.str-qnty = day_sum.str-qnty +  ( if ub.chk-gds.doc-qnty > 0 then 1 else -1 ).
     1785                   END.
     1786                   FIND FIRST prods WHERE
     1787                             prods.prod-type = ub.gds-dtl.prod-type AND
     1788                             prods.prod-code = ub.gds-dtl.prod-code NO-ERROR .
     1789                   if NOT available prods then do:
     1790                       CREATE prods .
     1791                       assign
     1792                       prods.prod-type = ub.gds-dtl.prod-type
     1793                       prods.prod-code = ub.gds-dtl.prod-code
     1794                       prods.prod-attr = ub.gds-dtl.prod-type + string( ub.gds-dtl.prod-code )
     1795                       prods.prod-name = ub.clients.obj-name
     1796                       .
     1797                   end.
     1798               end.
     1799               else
     1800               assign
     1801               day_sum.prod-qnty = day_sum.prod-qnty -  ub.gds-dtl.doc-qnty
     1802               day_sum.prod-sum = day_sum.prod-sum -  ub.gds-dtl.doc-qnty * ub.gds-dtl.cur-base
     1803               day_sum.sale-sum = day_sum.sale-sum -  ub.gds-dtl.doc-qnty * (if v-curr-r-b = 'base':U then  ub.gds-dtl.price-base else ub.gds-dtl.price-rubl)
     1804               day_sum.discnt-sum = day_sum.discnt-sum - ub.gds-dtl.doc-qnty * (if v-curr-r-b = 'base':U then  ub.gds-dtl.discnt-base else ub.gds-dtl.discnt-rubl)
     1805               .
     1806           END.
     1807         end.
     1808         if ( ( ACCUM COUNT ub.inkas.inkas-code ) modulo 5 ) = 0 AND
     1809              ( ACCUM COUNT ub.inkas.inkas-code ) >= 5
     1810         then
     1811         run waitfram-show in this-procedure ( obj-list.obj-type + " N" + string( obj-list.obj-code ) +
     1812                         ", обработано отчетов по продаже : " + string( ACCUM COUNT ub.inkas.inkas-code ) ) .
     1813         if last-of( inkas.doc-date ) then  do:
     1814             CREATE chk-day .
     1815             assign
     1816             chk-day.day_ = CurrDay
     1817             chk-day.chk-qnty = ( ACCUM SUB-TOTAL BY ub.inkas.doc-date     SaleChk-Amount )
     1818             .
     1819         end.
     1820     END .
     1821     run waitfram-hide in this-procedure .
     1822     if can-find( first day_sum where day_sum.prod-sum <> 0 ) then do:
     1823         DO ii = 1 TO vEndLastDay :
     1824             FOR EACH prods :
     1825                 FIND FIRST day_sum WHERE
     1826                            day_sum.day_ = ii AND
     1827                            day_sum.prod-type = prods.prod-type AND
     1828                            day_sum.prod-code = prods.prod-code NO-ERROR .
     1829                 if NOT available day_sum then do:
     1830                     CREATE day_sum .
     1831                     assign
     1832                     day_sum.day_ = ii
     1833                     day_sum.prod-type = prods.prod-type
     1834                     day_sum.prod-code = prods.prod-code
     1835                     day_sum.prod-attr = prods.prod-type + string( prods.prod-code )
     1836                     .
     1837                 end.
     1838              END .
     1839              FIND FIRST chk-day WHERE chk-day.day_ = ii NO-ERROR .
     1840              if NOT available chk-day then do:
     1841                  CREATE chk-day .
     1842                  chk-day.day_ = ii .
     1843              end.
     1844           END .
     1845           FIND FIRST cli-obj WHERE
     1846                      cli-obj.obj-type = obj-list.obj-type AND
     1847                      cli-obj.obj-code = obj-list.obj-code NO-LOCK .
     1848           FIND FIRST ub.db WHERE ub.db.db-num = cli-obj.db-num NO-LOCK .
     1849           run gbl/numtomon.p ( month( vStartPoint ), output StrBuf ) .
     1850           run prn-lib-open-stream  in this-procedure (
     1851                                                       input my-handle
     1852                                                       ,input 0
     1853                                                       ,input yes
     1854                                                       ,input no
     1855                                                       ).
     1856           PUT stream PrnLibStream space(40)
     1857           "Отчет по реализации" skip(1)
     1858           space(20) "Магазин " db.db-name format "x(40)" AT 41 skip
     1859           space(20) "Салон " cli-obj.obj-name format "x(40)" AT 41 skip
     1860           space(20) "Отчетный период "
     1861           StrBuf format "x(9)" AT 41 string( year( vStartPoint ), ">>>9" ) format "x(4)"
     1862           skip(1)
     1863           space(20) ( if NotInc then "( сформирован НЕ ПО ВСЕМ ЧЕКАМ )" else " " ) format "x(40)" skip
     1864           .
     1865           assign
     1866           StrBuf = p-XL-delim + string( "   Дата", "x(15)" ) + p-XL-delim
     1867           sheetf.Excel-COlumn-Lable = string( "   Дата", "x(15)" ) + chr(44)
     1868           sheetf.sizes = "10" + chr(44)
     1869           .
     1870           FOR EACH prods BY prods.prod-attr :
     1871             assign
