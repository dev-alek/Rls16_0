     1883        sheetf.Excel-Column-Lable = sheetf.Excel-Column-Lable + fill( " ", 6 ) + "ИТОГО" + fill( " ", 6 )  + chr(44) +
     1884                             fill( " ", 17 ) + chr(44) +
     1885                             fill( " ", 8 ) + chr(44)
     1886        sheetf.sizes = sheetf.sizes + "17" + chr(44) + "17" + chr(44) + "8" + chr(44)
     1887        str2 = " "
     1888        str3 = " "
     1889        .
     1890        EXPORT stream PrnLibStream StrBuf .
     1891        assign
     1892        StrBuf = p-XL-delim + fill( " ", 15 ) + p-XL-delim
     1893        sheetf.Excel-Column-Lable = sheetf.Excel-Column-Lable + chr(10) + fill( " ", 5 ) + "(День" + fill ( " ", 6) + chr(44)
     1894        .
     1895        FOR EACH prods :
     1896           assign
     1897           StrBuf = StrBuf + fill( " ", 5 ) + "шт" + fill( " ", 5 ) + p-XL-delim +
     1898                    fill( " ", 4 ) + "Стоимость" + fill( " ", 4 ) + p-XL-delim
     1899           sheetf.Excel-COlumn-Lable = sheetf.Excel-Column-Lable + string("Количество", "X(12)") + chr(44) +
     1900                                fill( " ", 4 ) + "Стоимость" + fill( " ", 4 ) + chr(44)
     1901           .
     1902        END .
     1903        assign
     1904        StrBuf = StrBuf + fill( " ", 5 ) + "шт" + fill( " ", 5 ) + p-XL-delim +
     1905                 fill( " ", 4 ) + "Стоимость" + fill( " ", 4 ) + p-XL-delim +
     1906                 " " + "Кол-во" + fill( " ", 1 ) + p-XL-delim
     1907        sheetf.Excel-Column-Lable = sheetf.Excel-COlumn-Lable + string("Количество", "X(12)") + chr(44) +
     1908                             fill( " ", 4 ) + "Стоимость" + fill( " ", 4 ) + chr(44) +
     1909                             " " + "Кол-во" + fill( " ", 1 ) + chr(44)
     1910        .
     1911        EXPORT stream PrnLibStream StrBuf .
     1912        assign
     1913        StrBuf = p-XL-delim + fill( " ", 15 ) + p-XL-delim
     1914        sheetf.Excel-Column-Lable =  sheetf.Excel-Column-Lable + chr(10) + string("месяца)", "X(15)") + chr(44)
     1915        .
     1916        FOR EACH prods :
     1917         assign
     1918          StrBuf = StrBuf + fill( " ", 12 ) + p-XL-delim + fill( " ", 6 ) +
     1919          (if v-curr-r-b = 'rubl':U
     1920          then "РУБ"
     1921          else  string( caps( trim( base-type ) ), "x(3)" ))
     1922                  + fill( " ", 8 ) + p-XL-delim
     1923          sheetf.Excel-Column-Lable = sheetf.Excel-Column-Lable + fill( " ", 5 ) + "шт" + fill( " ", 5 ) + chr(44) +
     1924                               fill( " ", 6 ) +
     1925          (if v-curr-r-b = 'rubl':U
     1926          then "РУБ"
     1927          else  string( caps( trim( base-type ) ), "x(3)" ))
     1928                               + fill( " ", 8 ) + chr(44)
     1929          .
     1930        END .
     1931        assign
     1932        StrBuf = StrBuf + fill( " ", 12 ) + p-XL-delim + fill( " ", 6 ) +
     1933       (if v-curr-r-b = 'rubl':U
     1934       then "РУБ"
     1935       else  string( caps( trim( base-type ) ), "x(3)" ))
     1936                + fill( " ", 8 ) + p-XL-delim + "  " + "чеков" + fill( " ", 1 ) + p-XL-delim
     1937        sheetf.Excel-Column-Lable = sheetf.Excel-Column-Lable + fill( " ", 5 ) + "шт" + fill( " ", 5 ) + chr(44) +
     1938                             fill( " ", 6 ) +
     1939       (if v-curr-r-b = 'rubl':U
     1940       then "РУБ"
     1941       else  string( caps( trim( base-type ) ), "x(3)" ))
     1942       + fill( " ", 8 ) + chr(44) +
     1943                "  " + "чеков" + fill( " ", 1 ) + chr(44)
     1944        str3 = " "
     1945        str2 = " "
     1946        .
     1947        run rep/extitle.p (1).
     1948        EXPORT stream PrnLibStream StrBuf .
     1949        PUT stream PrnLibStream "" skip .
     1950        FOR EACH day_sum
     1951            BREAK BY day_sum.day BY day_sum.prod-attr :
     1952            if first-of( day_sum.day_ )
     1953            then
     1954            assign
     1955            StrBuf = p-XL-delim + string( day_sum.day_, ">>>>9" ) + fill( " ", 10 ) +  p-XL-delim
     1956            XLStrBuf = string( day_sum.day_, ">>>>9" ) + fill( " ", 10 ) +  CHR(9)
     1957            .
     1958            ACCUMULATE
     1959            day_sum.sale-sum ( SUB-TOTAL BY day_sum.day_ )
     1960            day_sum.discnt-sum ( SUB-TOTAL BY day_sum.day_ )
     1961            day_sum.prod-sum ( SUB-TOTAL BY day_sum.day_ )
     1962            day_sum.prod-qnty ( SUB-TOTAL BY day_sum.day_ )
     1963            .
     1964            assign
     1965            StrBuf = StrBuf + ( if day_sum.prod-qnty <> 0
     1966                                then string( string( day_sum.prod-qnty, "->>>,>>9.<<<" ) , "x(12)" )
     1967                                 else fill( " ", 12 ) ) + p-XL-delim +
     1968                                 ( if day_sum.prod-sum <> 0
     1969                                   then string( day_sum.prod-sum - day_sum.discnt-sum, "->,>>>,>>>,>>9.99" )
     1970                                   else fill( " ", 17 ) ) + p-XL-delim
     1971            XLStrBuf = XLStrBuf + ( if day_sum.prod-qnty <> 0
     1972                                then string( string( day_sum.prod-qnty, "->>>,>>9.<<<" ) , "x(12)" )
     1973                                 else fill( " ", 12 ) ) + CHR(9) +
     1974                                 ( if day_sum.prod-sum <> 0
     1975                                   then string( day_sum.prod-sum - day_sum.discnt-sum, "->,>>>,>>>,>>9.99" )
     1976                                   else fill( " ", 17 ) ) + CHR(9)
     1977            .
     1978            if last-of( day_sum.day_ ) then do:
     1979                FIND FIRST chk-day WHERE chk-day.day = day_sum.day_ .
     1980                ACCUMULATE      chk-day.chk-qnty ( TOTAL ) .
     1981                assign
     1982                StrBuf = StrBuf + ( if ( ACCUM SUB-TOTAL BY day_sum.day_  day_sum.prod-qnty ) <> 0
     1983                                    then string( string( ( ACCUM SUB-TOTAL BY day_sum.day_
     1984                                                        day_sum.prod-qnty ), "->>>,>>9.<<<" ), "x(12)" )
     1985                                    else fill( " ", 12 ) ) + p-XL-delim +
     1986                                  ( if ( ACCUM SUB-TOTAL BY day_sum.day_ day_sum.prod-sum ) <> 0
     1987                                    then string( ( ACCUM SUB-TOTAL BY day_sum.day_
     1988                                                    day_sum.prod-sum ) -
     1989                                                 ( ACCUM SUB-TOTAL BY day_sum.day_
     1990                                                   day_sum.discnt-sum ), "->,>>>,>>>,>>9.99" )
     1991                                    else fill( " ", 17 ) ) + p-XL-delim +
     1992                                 ( if chk-day.chk-qnty <> 0
     1993                                   then string( chk-day.chk-qnty, ">>>>>>>9" )
     1994                                   else fill( " ", 8 ) ) + p-XL-delim
     1995                XlStrBuf = XLStrBuf + ( if ( ACCUM SUB-TOTAL BY day_sum.day_  day_sum.prod-qnty ) <> 0
     1996                                    then string( string( ( ACCUM SUB-TOTAL BY day_sum.day_
     1997                                                        day_sum.prod-qnty ), "->>>,>>9.<<<" ), "x(12)" )
     1998                                    else fill( " ", 12 ) ) + CHR(9) +
     1999                                  ( if ( ACCUM SUB-TOTAL BY day_sum.day_ day_sum.prod-sum ) <> 0
     2000                                    then string( ( ACCUM SUB-TOTAL BY day_sum.day_
     2001                                                    day_sum.prod-sum ) -
     2002                                                 ( ACCUM SUB-TOTAL BY day_sum.day_
     2003                                                   day_sum.discnt-sum ), "->,>>>,>>>,>>9.99" )
     2004                                    else fill( " ", 17 ) ) + CHR(9) +
     2005                                 ( if chk-day.chk-qnty <> 0
     2006                                   then string( chk-day.chk-qnty, ">>>>>>>9" )
     2007                                   else fill( " ", 8 ) ) + CHR(9)
     2008                .
     2009                EXPORT stream PrnLibStream StrBuf .
     2010                if Make-Excel then  put   stream ForExcel unformatted
     2011                XlStrBuf
     2012                SKIP.
     2013             end.
     2014          END.
     2015          assign
     2016          StrBuf = p-XL-delim + string( "Итого( нетто )", "x(15)" ) + p-XL-delim
     2017          XLStrBuf = string( "Итого( нетто )", "x(15)" ) + CHR(9)
     2018          .
     2019          FOR EACH day_sum BREAK BY day_sum.prod-attr :
     2020              ACCUMULATE
     2021              day_sum.discnt-sum ( SUB-TOTAL BY day_sum.prod-attr )
     2022              day_sum.prod-sum ( SUB-TOTAL BY day_sum.prod-attr )
     2023              day_sum.prod-qnty ( SUB-TOTAL BY day_sum.prod-attr )
     2024              day_sum.discnt-sum ( TOTAL )
     2025              day_sum.prod-sum ( TOTAL )
     2026              day_sum.prod-qnty ( TOTAL )
     2027              day_sum.str-qnty ( TOTAL )
     2028              .
     2029          if last-of( day_sum.prod-attr )
     2030          then
     2031          assign
     2032          StrBuf = StrBuf +
     2033                   string( string( ACCUM SUB-TOTAL BY day_sum.prod-attr day_sum.prod-qnty,
     2034                                     "->>>,>>9.<<<" ), "x(12)" ) + p-XL-delim +
     2035                   string( ( ACCUM SUB-TOTAL BY day_sum.prod-attr day_sum.prod-sum ) -
     2036                           ( ACCUM SUB-TOTAL BY day_sum.prod-attr day_sum.discnt-sum ) ,
     2037                           "->,>>>,>>>,>>9.99" ) + p-XL-delim
     2038          XLStrBuf = XLStrBuf +
     2039                   string( string( ACCUM SUB-TOTAL BY day_sum.prod-attr day_sum.prod-qnty,
     2040                                     "->>>,>>9.<<<" ), "x(12)" ) + CHR(9) +
     2041                   string( ( ACCUM SUB-TOTAL BY day_sum.prod-attr day_sum.prod-sum ) -
     2042                           ( ACCUM SUB-TOTAL BY day_sum.prod-attr day_sum.discnt-sum ) ,
     2043                           "->,>>>,>>>,>>9.99" ) + CHR(9)
     2044          .
     2045        END.
     2046        assign
     2047        StrBuf = StrBuf +
     2048                 string( string( ACCUM TOTAL day_sum.prod-qnty, "->>>,>>9.<<<" ), "x(12)" )
     2049                      + p-XL-delim +
     2050                 string( ( ACCUM TOTAL day_sum.prod-sum ) -
     2051                            ( ACCUM TOTAL day_sum.discnt-sum ) , "->,>>>,>>>,>>9.99" ) + p-XL-delim +
     2052                 string( ACCUM TOTAL chk-day.chk-qnty, ">>>>>>>9" ) + p-XL-delim
     2053        XLStrBuf = XLStrBuf +
     2054                 string( string( ACCUM TOTAL day_sum.prod-qnty, "->>>,>>9.<<<" ), "x(12)" )
     2055                      + CHR(9) +
     2056                 string( ( ACCUM TOTAL day_sum.prod-sum ) -
     2057                            ( ACCUM TOTAL day_sum.discnt-sum ) , "->,>>>,>>>,>>9.99" ) + CHR(9) +
     2058                 string( ACCUM TOTAL chk-day.chk-qnty, ">>>>>>>9" ) + CHR(9)
     2059        .
     2060        EXPORT stream PrnLibStream StrBuf .
     2061        PUT stream PrnLibStream "" skip .
     2062        if Make-Excel then  put   stream ForExcel unformatted
     2063        XlStrbuf
     2064        SKIP.
     2065        assign
     2066        StrBuf = p-XL-delim + string( "Ошибки по кассе", "x(15)" ) + p-XL-delim
     2067        XLStrBuf = string( "Ошибки по кассе", "x(15)" ) + CHR(9)
     2068        .
     2069        FOR EACH day_sum BREAK BY day_sum.prod-attr :
     2070           ACCUMULATE
     2071           day_sum.discnt-sum ( SUB-TOTAL BY day_sum.prod-attr )
     2072           day_sum.discnt-sum ( TOTAL )
     2073           .
     2074           if last-of( day_sum.prod-attr )
     2075           then
     2076           assign
     2077           StrBuf = StrBuf + fill( " ", 12 ) + p-XL-delim +
     2078                    string( ACCUM SUB-TOTAL BY day_sum.prod-attr day_sum.discnt-sum,
     2079                            "->,>>>,>>>,>>9.99" ) + p-XL-delim
     2080           XLStrBuf = XlStrBuf + fill( " ", 12 ) + CHR(9) +
     2081                    string( ACCUM SUB-TOTAL BY day_sum.prod-attr day_sum.discnt-sum,
     2082                            "->,>>>,>>>,>>9.99" ) + CHR(9)
     2083           .
     2084        END.
     2085        assign
     2086        StrBuf = StrBuf + fill( " ", 12 ) + p-XL-delim +
     2087                 string( ACCUM TOTAL day_sum.discnt-sum, "->,>>>,>>>,>>9.99" ) + p-XL-delim
     2088        StrBuf = StrBuf + fill( " ", 8 ) + p-XL-delim
     2089        XLStrBuf = XLStrBuf + fill( " ", 12 ) + CHR(9) +
     2090                 string( ACCUM TOTAL day_sum.discnt-sum, "->,>>>,>>>,>>9.99" ) + CHR(9)
     2091        StrBuf = StrBuf + fill( " ", 8 ) + CHR(9)
     2092        .
     2093        EXPORT stream PrnLibStream StrBuf .
     2094        PUT stream PrnLibStream "" SKIP.
     2095        if Make-Excel then  put   stream ForExcel unformatted
     2096        XlStrBuf
     2097        SKIP.
     2098        assign
     2099        StrBuf = p-XL-delim + string( "   ИТОГО", "x(15)" ) + p-XL-delim
     2100        XLStrBuf = string( "   ИТОГО", "x(15)" ) + CHR(9)
     2101        .
     2102        FOR EACH day_sum BREAK BY day_sum.prod-attr :
     2103           ACCUMULATE
     2104           day_sum.prod-qnty ( SUB-TOTAL BY day_sum.prod-attr )
     2105           day_sum.prod-sum ( SUB-TOTAL BY day_sum.prod-attr )
     2106           day_sum.discnt-sum ( TOTAL )
     2107           day_sum.str-qnty ( TOTAL )
     2108           .
     2109           if last-of( day_sum.prod-attr )
     2110           then
     2111           assign
     2112           StrBuf = StrBuf +
     2113                    string( string( ACCUM SUB-TOTAL BY day_sum.prod-attr day_sum.prod-qnty,
     2114                                       "->>>,>>9.<<<" ), "x(12)" ) + p-XL-delim +
     2115                    string(( ACCUM SUB-TOTAL BY day_sum.prod-attr day_sum.prod-sum ) ,
     2116                                       "->,>>>,>>>,>>9.99" ) + p-XL-delim
     2117           XLStrBuf = XLStrBuf +
     2118                    string( string( ACCUM SUB-TOTAL BY day_sum.prod-attr day_sum.prod-qnty,
     2119                                       "->>>,>>9.<<<" ), "x(12)" ) + CHR(9) +
     2120                    string(( ACCUM SUB-TOTAL BY day_sum.prod-attr day_sum.prod-sum ) ,
     2121                                       "->,>>>,>>>,>>9.99" ) + CHR(9)
     2122           .
     2123        END.
     2124        assign
     2125        StrBuf = StrBuf +
     2126                 string( string( ACCUM TOTAL day_sum.prod-qnty, "->>>,>>9.<<<" ), "x(12)" ) +
     2127                 p-XL-delim +
     2128                 string( ( ACCUM TOTAL day_sum.prod-sum ), "->,>>>,>>>,>>9.99" ) + p-XL-delim +
     2129                 string( ACCUM TOTAL chk-day.chk-qnty, ">>>>>>>9" ) + p-XL-delim
     2130        XLStrBuf = XLStrBuf +
     2131                 string( string( ACCUM TOTAL day_sum.prod-qnty, "->>>,>>9.<<<" ), "x(12)" ) +
     2132                 CHR(9) +
     2133                 string( ( ACCUM TOTAL day_sum.prod-sum ), "->,>>>,>>>,>>9.99" ) + CHR(9) +
     2134                 string( ACCUM TOTAL chk-day.chk-qnty, ">>>>>>>9" ) + CHR(9)
     2135        .
     2136        EXPORT stream PrnLibStream StrBuf .
     2137        PUT stream PrnLibStream "" SKIP .
     2138        if Make-Excel then  put   stream ForExcel unformatted
     2139        XlStrBuf
     2140        SKIP.
     2141        run cur-time in this-procedure(output v-today, output v-time).
     2142        PUT stream PrnLibStream space(70)
     2143        "Итоговое кол-во покупок, шт "
     2144        string( ACCUM TOTAL day_sum.prod-qnty, "->>>,>>9.<<<" ) AT 100 format "x(20)" skip
     2145        space(58) "Коэффициент эффективности работы продавцов"
     2146        string(round( ( ACCUM TOTAL chk-day.chk-qnty ) / ( ACCUM TOTAL day_sum.str-qnty ), 1 ),
     2147               "->>>9.9" ) AT 103 format "x(20)" skip(2)
     2148        space(10) "Директор магазина"   "Дата составления отчета" AT 60
     2149        v-today format "99.99.9999" AT 90 skip(1)
     2150        space(10) "Управляющий салоном"
     2151        skip.
     2152        output stream PrnLibStream CLOSE .
     2153        if Make-Excel then output stream ForExcel close.
     2154        run prn-lib-prn-file in this-procedure (
     2155                                             input my-handle
     2156                                             ,input 11
     2157                                             ).
     2158     end.
     2159     else do:
     2160         message "Не было никакой выручки на выбранных объектах" skip
     2161                 "в течение заданного Вами периода времени."
     2162         view-as alert-box INFORMATION .
     2163     end.
     2164     FOR EACH day_sum :
     2165         delete day_sum .
     2166     END.
     2167     FOR EACH prods  :
     2168       delete prods .
     2169     END.
     2170     FOR EACH chk-day :
     2171       delete chk-day  .
     2172     END.
     2173   END PROCEDURE.
     2174   PROCEDURE My-var :
     2175   DEFINE VAR StrBuf as char no-undo.
     2176   define variable     NotInc          as  log     no-undo.
     2177   run Assign-Frame in h_s-month.
     2178   Assign
     2179    STR-obj-type = ''
     2180    STR-obj-code = ''
     2181    STR-obj-name = ''
     2182    STR-obj      = ''.
     2183   For each obj-list no-lock:
     2184    accumulate obj-list.obj-code (COUNT).
     2185    Assign
     2186    STR-obj-type = STR-obj-type + obj-list.obj-type + ','
     2187    STR-obj-code = STR-obj-code + String(obj-list.obj-code) + ','
     2188    STR-obj-name = STR-obj-name + obj-list.obj-name + ','
     2189    STR-obj = STR-obj +  obj-list.obj-type + '#' + string(obj-list.obj-code)  + ',' .
     2190   End.
     2191   if (accum count obj-list.obj-code) > 1 then do:
     2192       message "Выбрано больше одного объекта для отчета!"
     2193       view-as alert-box ERROR.
     2194       return.
     2195   end.
     2196   ReportNAme = "Помесячная реализация в магазине".
     2197   run gbl/numtomon.p ( month( vStartPoint ), output StrBuf ) .
     2198   run no-benqi(OUTPUT NotInc).
     2199   ReportHeader = "За " + StrBuf  + " " + ENTRY(NUm-entries(vStrBuf, " "), vStrBuf, " ")  + chr(10) +
     2200                   if NotInc then "( сформирован НЕ ПО ВСЕМ ЧЕКАМ )" else " ".
     2201   END PROCEDURE.
     2202   PROCEDURE send-records :
     2203   END PROCEDURE.
     2204   PROCEDURE state-changed :
     2205     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE NO-UNDO.
     2206     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     2207   END PROCEDURE.
