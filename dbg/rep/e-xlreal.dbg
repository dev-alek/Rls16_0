      585   define  stream PrnLibStream.
      586   procedure prn-lib-prn-file :
      587     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      588     define input parameter p-DIsabledoptions as integer no-undo .
      589     define variable v-report-name as character no-undo .
      590     define variable v-user-action as character no-undo .
      591     define variable v-printed     as logical   no-undo .
      592     define variable v-exist       as logical   no-undo .
      593     do
      594       on error undo, return error
      595       :
      596       run prn-lib-get-report-name  in this-procedure (
      597         input parParentProc
      598         ,output v-report-name
      599         ).
      600   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      601   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      602     (input  v-report-name
      603     ,input  2
      604     ,output v-exist
      605     )  .
      606       if NOT v-exist then
      607       DO:
      608         Message
      609           "Нет заданий на печать ! "
      610           view-as alert-box .
      611         Return  .
      612       End.
      613       run gbl/prnfilen.w
      614         (input  ""
      615         ,input  p-DisabledOptions
      616         ,input  string(v-report-name )
      617         ,input  7
      618         ,output v-user-action
      619         ,output v-printed
      620         ) .
      621       if v-printed then
      622       do:
      623         return "YES" .
      624       end.
      625       else
      626       do:
      627         return "NO" .
      628       end.
      629     end.
      630   end procedure.
      631   procedure prn-lib-open-stream :
      632     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      633     define input parameter p-page-size    as integer no-undo .
      634     define input parameter p-is-stream    as logical no-undo .
      635     define input parameter p-append       as logical no-undo .
      636     define variable v-report-name as character no-undo .
      637     do
      638       on error undo, return error
      639       :
      640       run prn-lib-get-report-name  in this-procedure (
      641         input parParentProc
      642         ,output v-report-name
      643         ).
      644       if p-is-stream then
      645       do:
      646         if p-append then
      647         do:
      648           output stream PrnLibStream to value( v-report-name )
      649             page-size value(p-page-size) append .
      650         end.
      651         if not p-append then
      652         do:
      653           output stream PrnLibStream to value( v-report-name )
      654             page-size value(p-page-size) .
      655         end.
      656       end.
      657       if not p-is-stream then
      658       do:
      659         if p-append then
      660         do:
      661           output to value( v-report-name )
      662             page-size value(p-page-size) append .
      663         end.
      664         if not p-append then
      665         do:
      666           output to value( v-report-name )
      667             page-size value(p-page-size) .
      668         end.
      669       end.
      670     end.
      671   end procedure.
      672   procedure prn-lib-open-exp :
      673     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      674     define input parameter p-is-stream    as logical no-undo .
      675     define input parameter p-is-append    as logical no-undo .
      676     define output parameter p-ReportFileName as char init "report" no-undo.
      677     define output parameter p-process as logical no-undo .
      678     define variable glog as logical no-undo .
      679     do
      680       on error undo, return error
      681       :
      682       SYSTEM-DIALOG GET-FILE p-ReportFileName
      683         TITLE      "Укажите путь"
      684         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      685         ASK-OVERWRITE
      686         CREATE-TEST-FILE
      687         SAVE-AS
      688         USE-FILENAME
      689         DEFAULT-EXTENSION "txt"
      690         UPDATE glog
      691         .
      692       if not glog then  return.
      693       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      694       if p-is-stream then
      695       do:
      696         if p-is-append then
      697         do:
      698           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      699         end.
      700         else
      701         do:
      702           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      703         end.
      704       end.
      705       else
      706       do:
      707         if p-is-append then
      708         do:
      709           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      710         end.
      711         else
      712         do:
      713           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      714         end.
      715       end.
      716       p-process = yes.
      717     end.
      718   end procedure.
      719   procedure prn-lib-get-report-name :
      720     define input parameter parParentProc  as widget-handle no-undo.
      721     define output parameter p-report-name as character no-undo .
      722     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      723   end procedure.
      724   procedure prn-lib-reportviewer-report-name :
      725     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      726     define input parameter p-report-name-html as character no-undo .
      727     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      728   end procedure.
      729   procedure prn-lib-reportviewer :
      730     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      731     define input parameter p-report-name-html as character no-undo .
      732     define input parameter p-param        as character no-undo .
      733     define variable v-excel           as character no-undo init 'TRUE' .
      734     define variable v-value-character as character no-undo .
      735     define variable v-value-integer   as character no-undo .
      736     define variable v-value-date      as date      no-undo .
      737     define variable v-value-decimal   as decimal   no-undo .
      738     define variable rep-excel         as logical   no-undo .
      739     define variable excel-string      as character no-undo .
      740     define variable v-param-type      as character no-undo .
      741     define variable v-tth             as handle    no-undo .
      742     run adm/shattri.p (
      743       input "get":U
      744       ,input  ""
      745       ,input  0
      746       ,input  'report-glob':U
      747       ,input  'rep-excel':U
      748       ,output v-value-character
      749       ,output v-value-date
      750       ,output v-value-decimal
      751       ,output v-value-integer
      752       ,output rep-excel
      753       ,output v-param-type
      754       ,INPUT-OUTPUT table-handle v-tth
      755       )  .
      756     if rep-excel then v-excel = "TRUE" .
      757     else v-excel = "FALSE" .
      758     if p-param eq ""
      759     then
      760        p-param = "EXCEL:" + v-excel.
      761     else
      762        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      763     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      764   end procedure.
      765   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      766   define variable v-waitfram-action01         as character   no-undo .
      767   define variable v-waitfram-action02         as character   no-undo .
      768   define variable v-waitfram-action03         as character   no-undo .
      769   define variable mWaitFramTextBeg            as character   no-undo.
      770   define variable mWaitFramTextEnd            as character   no-undo.
      771   define variable mWaitFramView               as logical     no-undo.
      772   define variable mWaitProcEvent              as logical     no-undo init yes.
      773   define variable mWaitFramInterval           as integer     no-undo init 1 .
      774   define variable mWaitFramStop               as logical     no-undo.
      775   define variable mWaitFramStopUser           as logical     no-undo.
      776   define variable mWaitFramStopTimeOut        as logical     no-undo.
      777   define variable mWaitFramStartProc          as datetime-tz no-undo.
      778   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      779   define button B-WaitFramStop auto-end-key
      780        label "Стоп"
      781        size 10 by 1 tooltip "Остоновить процесс".
      782   define button B-viewProcInfo
      783        label "Информация"
      784        size 15 by 1 tooltip "Информация о процесс".
      785   define frame waitfram
      786     v-waitfram-action01 format "x(72)" no-label skip
      787     v-waitfram-action02 format "x(72)" no-label skip
      788     v-waitfram-action03 format "x(72)" no-label skip
      789     B-viewProcInfo
      790     B-WaitFramStop at row 4 col 30
      791     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      792     .
      793   define new global shared variable mBatchMode as logical no-undo init ?.
      794   define variable mFramBachModHandle as handle no-undo.
      795   mFramBachModHandle = frame waitfram:handle.
      796   define variable mFameOldVis as logical no-undo.
      797   define variable mVisCUrentVin as logical no-undo.
      798   if session:batch-mode
      799   then
      800      mBatchMode = yes.
      801   if mBatchMode = ? then do:
      802     mVisCUrentVin = current-window:visible.
      803     mFameOldVis = mFramBachModHandle:visible.
      804     mFramBachModHandle:visible  = yes.
      805     mBatchMode = mFramBachModHandle:visible ne yes.
      806     mFramBachModHandle:visible = mFameOldVis.
      807     current-window:visible = mVisCUrentVin.
      808   end.
      809    if  log-manager:logfile-name ne ?
      810     then DO:
      811         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      812         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      813         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      814     end.
      815   on choose of B-WaitFramStop in frame waitfram
      816   do:
      817     mWaitFramStop = yes.
      818     mWaitFramStopUser = yes.
      819   end.
      820   function waitfram-check-timeout returns logical():
      821      define variable vtime as int64 no-undo.
      822      if mWaitFramStopTimeOut
      823      then
      824         return yes.
      825      vtime = ( now - mWaitFramStartProc ) / 1000 .
      826      if     mWaitFramTimeOut ne ?
      827         and mWaitFramTimeOut ne 0
      828         and mWaitFramTimeOut lt vtime
      829      then do:
      830         mWaitFramStopTimeOut = yes.
      831      end.
      832      return mWaitFramStopTimeOut.
      833   end.
      834   procedure waitfram-hide :
      835     if not session:batch-mode
      836     then do
      837     on error undo, return error return-value
      838     :
      839       pause 0 before-hide .
      840       if not mBatchMode then
      841         hide frame waitfram .
      842     if     not mWaitFramView
      843        and mWaitProcEvent
      844     then
      845       process events .
      846     end.
      847   end procedure.
      848   procedure waitfram-show :
      849     define input  parameter p-message as character no-undo .
      850     define variable v-left-margin as integer   no-undo .
      851     if not session:batch-mode
      852     then do
      853     on error undo, return error return-value
      854     :
      855       if length(p-message) <= 70 then do:
      856         assign
      857           v-left-margin = integer((70 - length(p-message)) / 2)
      858         .
      859         assign
      860           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      861         .
      862         assign
      863           v-waitfram-action01 = " "
      864           v-waitfram-action02 = " "
      865                                    + fill(" ", v-left-margin)
      866                                    + p-message
      867           v-waitfram-action03 = " "
      868         .
      869       end.
      870       else do:
      871         define variable vRindex1 as integer no-undo.
      872         define variable vRindex2 as integer no-undo.
      873         vRindex1 = r-index(p-message," ",70).
      874         if vRindex1 = 0
      875         then
      876            vRindex1 = 70.
      877         if length(p-message)  <= vRindex1 + 70 then do:
      878           assign
      879             v-waitfram-action01 = " "
      880             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      881             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      882           .
      883         end.
      884         else do:
      885           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      886           if vRindex2 <= vRindex1
      887           then
      888              vRindex2 = vRindex1 + 70.
      889           assign
      890             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      891             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      892             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      893           .
      894         end.
      895       end.
      896       B-viewProcInfo:visible   in frame waitfram = no.
      897       B-viewProcInfo:sensitive in frame waitfram = no.
      898       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      899       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      900       if  (   mWaitFramView
      901          or  mWaitProcEvent)
      902          and not mBatchMode
      903       then
      904          display
      905             v-waitfram-action01 skip
      906             v-waitfram-action02 skip
      907             v-waitfram-action03 skip
      908          with frame waitfram .
      909       if     mWaitFramView
      910          then do:
      911             if     mWaitFramInterval ne ?
      912                and not mBatchMode
      913             then
      914                wait-for go of frame waitfram pause mWaitFramInterval.
      915          end.
      916          else
      917             if     mWaitProcEvent
      918                and not mBatchMode
      919             then
      920                process events .
      921     end.
      922   end procedure.
      923      procedure waitfram-show-this:
      924         define input  parameter iInterval as int64 no-undo.
      925         define variable vtime as int64 no-undo.
      926         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      927         mWaitFramInterval = iInterval.
      928         run waitfram-show (substitute("&1&2 &3&4" ,
      929                                       mWaitFramTextBeg ,
      930                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      931                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      932                                       mWaitFramTextEnd
      933                                      )
      934                           ).
      935      end.
      936      procedure WaitFramRunPause:
      937         define input  parameter iInterval as dec no-undo.
      938         define variable vStart  as datetime-tz no-undo.
      939         define variable vend    as datetime-tz no-undo.
      940         define variable vint as int64 no-undo.
      941         define variable vOk as logical no-undo.
      942         vStart = now.
      943         vend   = vStart.
      944         publish "WaitFramPause" (iInterval,output vOk).
      945         vend   =  now.
      946         vint = vend - vStart.
      947         vint = iInterval - vint / 1000.
      948         if     not mWaitFramStop
      949            and (   vint > 0
      950                 or (    not vOk
      951                     and iInterval eq ?
      952                     )
      953                 )
      954         then
      955            run waitfram-show-this (iInterval).
      956         vend   =  now.
      957         vint = vend - vStart.
      958         vint = iInterval - vint / 1000.
      959         if     not mWaitFramStop
      960            and vint > 0
      961         then do:
      962            run gbl/pause.p (vint * 1000).
      963         end.
      964         if iInterval ne ?
      965         then
      966            publish "WaitFramStop".
      967         waitfram-check-timeout().
      968      end.
      969      procedure WaitFramWaitFor:
      970         define input  parameter iInterval as dec no-undo.
      971         assign
      972            mWaitFramStartProc   = now
      973            mWaitFramStopUser    = no
      974            mWaitFramStopTimeOut = no
      975         .
      976         block-wait:
      977         do while not mWaitFramStop:
      978            run WaitFramRunPause (iInterval).
      979            if  waitfram-check-timeout()
      980            then do:
      981               leave block-wait.
      982            end.
      983         end.
      984         run waitfram-hide.
      985      end.
      986   procedure waitfram-join :
      987     define input  parameter p-line-1  as character no-undo .
      988     define input  parameter p-line-2  as character no-undo .
      989     define input  parameter p-line-3  as character no-undo .
      990     define output parameter p-message as character no-undo .
      991     do
      992     on error undo, return error return-value
      993     :
      994       assign
      995         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      996                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      997                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      998       .
      999     end.
     1000   end procedure.
     1001   function waitfram-join-function returns character
     1002     (input p-line-1 as character
     1003     ,input p-line-2 as character
     1004     ,input p-line-3 as character
     1005     ).
     1006     define variable v-message as character no-undo .
     1007     run waitfram-join in this-procedure
     1008       (input  p-line-1
     1009       ,input  p-line-2
     1010       ,input  p-line-3
     1011       ,output v-message
     1012       ) .
     1013     return v-message .
     1014   end function .
     1015   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1016   procedure proc-alt-shift-f2:
     1017     if not ibs.th.gbl.gbl-var:rcode
     1018   then
     1019     run gbl\inidebug.p .
     1020   end.
     1021   procedure proc-alt-shift-f3:
     1022     run gbl/prvssinf.p
     1023       ( input this-procedure
     1024       ) .
     1025   end.
     1026   define variable v-inform-launched as logical no-undo initial false .
     1027   procedure proc-alt-shift-f4:
     1028     define variable v-action as character no-undo .
     1029     if v-inform-launched = false then do:
     1030       assign
     1031         v-inform-launched = true
     1032       .
     1033       run gbl/d-inform.w
     1034         (  input self
