     1873                      string( " " + prods.prod-name, "x(17)" ) + p-XL-delim
     1874             sheetf.Excel-Column-Lable = sheetf.Excel-Column-Lable + string(replace(prods.prod-name, chr(44), "":U), "x(17)" ) + chr(44) +
     1875                                  fill (" ", 17) + chr(44)
     1876             sheetf.sizes = sheetf.sizes + "17" + chr(44) + "17" + chr(44)
     1877             .
     1878           END .
     1879        assign
     1880        StrBuf = StrBuf + fill( " ", 5 ) + "  " + fill( " ", 5 ) + p-XL-delim +
     1881                 fill( " ", 4 ) + "  ИТОГО  " + fill( " ", 4 ) + p-XL-delim +
