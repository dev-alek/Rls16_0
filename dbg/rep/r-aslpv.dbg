     1166   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1167   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1168   procedure cur-time :
     1169      define output parameter p-today as date      no-undo .
     1170      define output parameter p-time  as integer   no-undo .
     1171     do
     1172     on error undo, return error
     1173     :
     1174       define variable v-date1 as date      no-undo .
     1175       define variable v-date2 as date      no-undo .
     1176       define variable v-time  as integer   no-undo .
     1177       assign
     1178         v-date1 = today
     1179         v-time  = time
     1180         v-date2 = today
     1181       .
     1182       if v-date1 <> v-date2
     1183       then do:
     1184         assign
     1185           v-date1 = today
     1186           v-time  = v-time
     1187         .
     1188       end.
     1189       assign
     1190         p-today = v-date1
     1191         p-time  = v-time
     1192       .
     1193     end.
     1194   end.
     1195   function cur-time-date returns character
     1196   :
     1197     return string(today, '99/99/9999':U) .
     1198   end.
     1199   function cur-time-mjd returns decimal
     1200   :
     1201     define variable v-date as date      no-undo .
     1202     define variable v-time as integer   no-undo .
     1203     run cur-time in this-procedure
     1204       (output v-date
     1205       ,output v-time
     1206       ) .
     1207     return integer(v-date) - 2400002 + (v-time / 86400) .
     1208   end.
     1209   function cur-time-get-ending-index returns integer
     1210   (input p-number as integer
     1211   )
     1212   :
     1213     if p-number < 0
     1214     or p-number = ?
     1215     then do:
     1216       return 1 .
     1217     end.
     1218     define variable v-rest as integer   no-undo .
     1219     assign
     1220       p-number = p-number modulo 100
     1221     .
     1222     if p-number < 20
     1223     then do:
     1224       assign
     1225         v-rest = p-number
     1226       .
     1227     end.
     1228     else do:
     1229       assign
     1230         v-rest = p-number modulo 10
     1231       .
     1232     end.
     1233     case v-rest :
     1234       when 1
     1235       then do:
     1236         return 2 .
     1237       end.
     1238       when 2 or
     1239       when 3 or
     1240       when 4
     1241       then do:
     1242         return 3 .
     1243       end.
     1244       otherwise do:
     1245         return 1 .
     1246       end.
     1247     end case .
     1248   end.
     1249   procedure cur-time-mjd-to-date :
     1250      define input  parameter i-mjd-diff as decimal no-undo.
     1251      define output parameter o-Date     as date    no-undo.
     1252      define output parameter o-Time     as integer no-undo.
     1253      define variable v-day-number as integer   no-undo .
     1254      if    i-mjd-diff < 0
     1255         or i-mjd-diff = ?
     1256      then do:
     1257         return "?" .
     1258      end.
     1259      assign
     1260         v-day-number = truncate(i-mjd-diff,0).
     1261         o-Date = date(v-day-number + 2400002).
     1262         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1263     .
     1264   end.
     1265   function cur-time-mjd-to-string returns character
     1266   (input p-mjd-diff as decimal
     1267   )
     1268   :
     1269     define variable v-day-number as integer   no-undo .
     1270     define variable v-seconds    as integer   no-undo .
     1271     define variable v-hour       as integer   no-undo .
     1272     define variable v-min        as integer   no-undo .
     1273     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1274     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1275     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1276     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1277     if p-mjd-diff < 0
     1278     or p-mjd-diff = ?
     1279     then do:
     1280       return "?" .
     1281     end.
     1282     assign
     1283       v-day-number = integer(truncate(p-mjd-diff,0))
     1284       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1285     .
     1286     if v-seconds > 86400
     1287     then do:
     1288       assign
     1289         v-seconds = 86400 - 1
     1290       .
     1291     end.
     1292     if v-seconds < 0
     1293     then do:
     1294       assign
     1295         v-seconds = 0
     1296       .
     1297     end.
     1298     assign
     1299       v-hour = truncate(v-seconds / 3600, 0)
     1300     .
     1301     assign
     1302       v-seconds = v-seconds modulo 3600
     1303     .
     1304     assign
     1305       v-min = truncate(v-seconds / 60, 0)
     1306     .
     1307     assign
     1308       v-seconds = v-seconds modulo 60
     1309     .
     1310     return
     1311         (if v-day-number <> 0
     1312           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1313           else ""
     1314         )
     1315       + (if v-day-number <> 0 or v-hour <> 0
     1316           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1317           else ""
     1318         )
     1319       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1320           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1321           else ""
     1322         )
     1323       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1324       .
     1325   end.
     1326   function cur-time-string returns character
     1327   :
     1328     define variable v-date as date      no-undo .
     1329     define variable v-time as integer   no-undo .
     1330     run cur-time in this-procedure
     1331       (output v-date
     1332       ,output v-time
     1333       ) .
     1334     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1335   end.
     1336   function cur-time-string-sec returns character
     1337   :
     1338     define variable v-date as date      no-undo .
     1339     define variable v-time as integer   no-undo .
     1340     run cur-time in this-procedure
     1341       (output v-date
     1342       ,output v-time
     1343       ) .
     1344     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1345   end.
     1346   function cur-time-custom  returns character
     1347   (input p-prefix as character
     1348   ,input p-date-format as character
     1349   ,input p-delimiter as character
     1350   ,input p-time-format as character
     1351   ,input p-suffix as character
     1352   )
     1353   :
     1354     define variable v-date as date      no-undo .
     1355     define variable v-time as integer   no-undo .
     1356     run cur-time in this-procedure
     1357       (output v-date
     1358       ,output v-time
     1359       ) .
     1360     return
     1361       p-prefix
     1362       + string(v-date, p-date-format)
     1363       + p-delimiter
     1364       + string(v-time, p-time-format)
     1365       + p-suffix
     1366       .
     1367   end.
     1368   function cur-time-print  returns character
     1369   :
     1370     define variable v-date as date      no-undo .
     1371     define variable v-time as integer   no-undo .
     1372     run cur-time in this-procedure
     1373       (output v-date
     1374       ,output v-time
     1375       ) .
     1376     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1377   end.
     1378   function cur-time-datetime returns datetime
     1379   :
     1380     define variable v-char as character no-undo .
     1381     define variable v-datetime as datetime no-undo .
     1382     v-char = cur-time-string().
     1383     v-datetime = datetime(v-char).
     1384     return  v-datetime.
     1385   end.
     1386   function cur-time-string-msec returns character
     1387   :
     1388     define variable v-date as datetime  no-undo .
     1389     v-date = now.
     1390     return string(v-date) .
     1391   end.
     1392   procedure cp-attr-code :
     1393     do
     1394     on error undo, return error
     1395     :
     1396       define input  parameter p-code           as character no-undo .
     1397       define output parameter p-type           as character no-undo .
     1398       define output parameter p-format         as character no-undo .
     1399       define output parameter p-label          as character no-undo .
     1400       define output parameter p-range          as integer   no-undo .
     1401       define output parameter p-user-can-edit  as logical   no-undo .
     1402       define output parameter p-output-display as logical   no-undo .
     1403       define output parameter p-other          as character no-undo .
     1404       case p-code :
     1405               when 'paycard-export-prefix':U then do:     assign     p-label = "Префиксы платежных карт (для выгрузки в XML)"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт (для выгрузки в XML)"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
     1406               when 'grp-code':U then do:     assign     p-label = "Группа платежа"     p-type = 'C':U      p-format = "X(45)"     p-label = "Группа платежа"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=grp-code':u      .   end.
     1407               when 'is-use':U then do:     assign     p-label = "Используется"     p-type = 'C':U      p-format = "X(255)"     p-label = "Используется"     p-range = 4     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=is-use':u      .   end.
     1408               when 'dop-doc':U then do:     assign     p-label = "Дополнительный документ"     p-type = 'C':U      p-format = "X(255)"     p-label = "Дополнительный документ"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=dop-doc':u      .   end.
     1409               when 'paycard-all-prefix':U then do:     assign     p-label = "Префиксы платежных карт (для разбора чеков и т.д.)"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт (для разбора чеков и т.д.)"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
     1410               when 'paycard-edit-prefix':U then do:     assign     p-label = "Префиксы платежных карт, разрешенных для редактирования"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт, разрешенных для редактирования"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
     1411               when 'form_km3':U then do:     assign     p-label = "Формировать КМ-3 по чекам возврата"     p-type = 'L':U      p-format = "+/-"     p-label = "Формировать КМ-3 по чекам возврата"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
     1412               when 'bal_malina':U then do:     assign     p-label = "Оплата баллами Малина"     p-type = 'L':U      p-format = "+/-"     p-label = "Оплата баллами Малина"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
     1413               when 'max_proc_sum':U then do:     assign     p-label = "Максимальный % порог от суммы"     p-type = 'D':U      p-format = ">>9.99"     p-label = "Максимальный % порог от суммы"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
     1414               when 'mask_card_kup':U then do:     assign     p-label = "Маска карты\купона"     p-type = 'C':U      p-format = "x(129)"     p-label = "Маска карты\купона"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
     1415         otherwise do:
     1416           undo, return error substitute("неизвестный атрибут типа кассового платежа &1", p-code ).
     1417         end.
     1418       end.
     1419     end.
     1420   end procedure.
     1421   procedure cp-attr-tooltip :
     1422     do
     1423     on error undo, return error
     1424     :
     1425       define input  parameter p-code    as character no-undo .
     1426       define output parameter p-tooltip as character no-undo .
     1427       define output parameter p-label   as character no-undo .
     1428       case p-code :
     1429               when 'paycard-export-prefix':U then do:     assign     p-tooltip = "Префиксы платежных карт (для выгрузки в XML)"     p-label = "Префиксы платежных карт (для выгрузки в XML)" .   end.
     1430               when 'grp-code':U then do:     assign     p-tooltip = "Группа платежа"     p-label = "Группа платежа" .   end.
     1431               when 'is-use':U then do:     assign     p-tooltip = "Используется"     p-label = "Используется" .   end.
     1432               when 'dop-doc':U then do:     assign     p-tooltip = "Дополнительный документ"     p-label = "Дополнительный документ" .   end.
     1433               when 'paycard-all-prefix':U then do:     assign     p-tooltip = "Префиксы платежных карт (для разбора чеков и т.д.)"     p-label = "Префиксы платежных карт (для разбора чеков и т.д.)" .   end.
     1434               when 'paycard-edit-prefix':U then do:     assign     p-tooltip = "Префиксы платежных карт, разрешенных для редактировани"     p-label = "Префиксы платежных карт, разрешенных для редактирования" .   end.
     1435               when 'form_km3':U then do:     assign     p-tooltip = "Формировать КМ-3 по чекам возврата"     p-label = "Формировать КМ-3 по чекам возврата" .   end.
     1436               when 'bal_malina':U then do:     assign     p-tooltip = "Оплата баллами Малина"     p-label = "Оплата баллами Малина" .   end.
     1437               when 'max_proc_sum':U then do:     assign     p-tooltip = "Максимальный % порог от суммы"     p-label = "Максимальный % порог от суммы" .   end.
     1438               when 'mask_card_kup':U then do:     assign     p-tooltip = "Маска карты\купона"     p-label = "Маска карты\купона" .   end.
     1439         otherwise do:
     1440           undo, return error substitute("неизвестный атрибут типа кассового платежа &1", p-code) .
     1441         end.
     1442       end.
     1443     end.
     1444   end procedure.
     1445   procedure cp-attr-value :
     1446     do
     1447     on error undo, return error
     1448     :
     1449       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
     1450       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
     1451       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
     1452       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
     1453       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
     1454       define input  parameter p-code        like ub.cash-pay-attr.attr-code      no-undo .
     1455       define output parameter p-value       like ub.cash-pay-attr.attr-value    no-undo .
     1456       define output parameter p-type        as character no-undo .
     1457       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
     1458       define variable v-format         as character no-undo .
     1459       define variable v-label          as character no-undo .
     1460       define variable v-range          as integer   no-undo .
     1461       define variable v-user-can-edit  as logical   no-undo .
     1462       define variable v-output-display as logical   no-undo .
     1463       define variable v-other          as character no-undo .
     1464       run cp-attr-code in this-procedure
     1465         (input  p-code
     1466         ,output p-type
     1467         ,output v-format
     1468         ,output v-label
     1469         ,output v-range
     1470         ,output v-user-can-edit
     1471         ,output v-output-display
     1472         ,output v-other
     1473         ) no-error .
     1474       if error-status :error then do:
     1475         undo, return error return-value .
     1476       end.
     1477       find first buf_cash-pay-attr no-lock
     1478         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
     1479           and buf_cash-pay-attr.curr-code  = p-curr-code
     1480           and buf_cash-pay-attr.host-code  = p-host-code
     1481           and buf_cash-pay-attr.obj-type   = p-obj-type
     1482           and buf_cash-pay-attr.obj-code   = p-obj-code
     1483           and buf_cash-pay-attr.attr-code  = p-code
     1484         no-error .
     1485       if avail buf_cash-pay-attr then do:
     1486         assign
     1487           p-value =  buf_cash-pay-attr.attr-value
     1488         .
     1489       end.
     1490       else do:
     1491         assign
     1492           p-value = if p-type = 'L':U then "no":U else ""
     1493         .
     1494       end.
     1495     end.
     1496   end procedure.
     1497   procedure cp-attr-write :
     1498     do
     1499     on error undo, return error
     1500     :
     1501       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
     1502       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
     1503       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
     1504       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
     1505       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
     1506       define input parameter p-code     like ub.cash-pay-attr.attr-code  no-undo .
     1507       define input parameter p-value    like ub.cash-pay-attr.attr-value no-undo .
     1508       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
     1509       define buffer last_cash-pay-attr for ub.cash-pay-attr .
     1510       define variable v-type           as character no-undo .
     1511       define variable v-format         as character no-undo .
     1512       define variable v-label          as character no-undo .
     1513       define variable v-range          as integer   no-undo .
     1514       define variable v-user-can-edit  as logical   no-undo .
     1515       define variable v-output-display as logical   no-undo .
     1516       define variable v-other          as character no-undo .
     1517       run cp-attr-code in this-procedure
     1518         (input  p-code
     1519         ,output v-type
     1520         ,output v-format
     1521         ,output v-label
     1522         ,output v-range
     1523         ,output v-user-can-edit
     1524         ,output v-output-display
     1525         ,output v-other
     1526         ) no-error .
     1527       if error-status :error then do:
     1528         undo, return error return-value .
     1529       end.
     1530       find first buf_cash-pay-attr exclusive-lock
     1531         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
     1532           and buf_cash-pay-attr.curr-code  = p-curr-code
     1533           and buf_cash-pay-attr.host-code  = p-host-code
     1534           and buf_cash-pay-attr.obj-type   = p-obj-type
     1535           and buf_cash-pay-attr.obj-code   = p-obj-code
     1536           and buf_cash-pay-attr.attr-code = p-code
     1537         no-error .
     1538       if not available buf_cash-pay-attr then do:
     1539         create buf_cash-pay-attr .
     1540         assign
     1541         buf_cash-pay-attr.cdpay-code = p-cdpay-code
     1542         buf_cash-pay-attr.curr-code  = p-curr-code
     1543         buf_cash-pay-attr.host-code  = p-host-code
     1544         buf_cash-pay-attr.obj-type   = p-obj-type
     1545         buf_cash-pay-attr.obj-code   = p-obj-code
     1546         buf_cash-pay-attr.attr-code = p-code
     1547         .
     1548       end.
     1549       assign
     1550         buf_cash-pay-attr.attr-value = p-value
     1551       .
     1552       release buf_cash-pay-attr no-error .
     1553       if error-status:error then do:
     1554         undo, return error return-value .
     1555       end.
     1556     end.
     1557   end procedure.
     1558   procedure cp-attr-exist :
     1559     do
     1560     on error undo, return error
     1561     :
     1562       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
     1563       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
     1564       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
     1565       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
     1566       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
     1567       define input parameter p-code     like ub.cash-pay-attr.attr-code  no-undo .
     1568       define output parameter p-exist   as logical  no-undo .
     1569       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
     1570       define variable v-type           as character no-undo .
     1571       define variable v-format         as character no-undo .
     1572       define variable v-label          as character no-undo .
     1573       define variable v-range          as integer   no-undo .
     1574       define variable v-user-can-edit  as logical   no-undo .
     1575       define variable v-output-display as logical   no-undo .
     1576       define variable v-other          as character no-undo .
     1577       run cp-attr-code in this-procedure
     1578         (input  p-code
     1579         ,output v-type
     1580         ,output v-format
     1581         ,output v-label
     1582         ,output v-range
     1583         ,output v-user-can-edit
     1584         ,output v-output-display
     1585         ,output v-other
     1586         ) no-error .
     1587       if error-status :error then do:
     1588         undo, return error return-value .
     1589       end.
     1590       find first buf_cash-pay-attr exclusive-lock
     1591         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
     1592           and buf_cash-pay-attr.curr-code  = p-curr-code
     1593           and buf_cash-pay-attr.host-code  = p-host-code
     1594           and buf_cash-pay-attr.obj-type   = p-obj-type
     1595           and buf_cash-pay-attr.obj-code   = p-obj-code
     1596           and buf_cash-pay-attr.attr-code = p-code
     1597         no-error .
     1598       if  available buf_cash-pay-attr then do:
     1599         p-exist = yes.
     1600       end.
     1601     end.
     1602   end procedure.
     1603   procedure cp-attr-delete :
     1604     do
     1605     on error undo, return error
     1606     :
     1607       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
     1608       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
     1609       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
     1610       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
     1611       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
     1612       define input parameter p-code     like ub.cash-pay-attr.attr-code  no-undo .
     1613       define output parameter p-deleted  as logical no-undo.
     1614       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
     1615       define variable v-type           as character no-undo .
     1616       define variable v-format         as character no-undo .
     1617       define variable v-label          as character no-undo .
     1618       define variable v-range          as integer   no-undo .
     1619       define variable v-user-can-edit  as logical   no-undo .
     1620       define variable v-output-display as logical   no-undo .
     1621       define variable v-other          as character no-undo .
     1622       run cp-attr-code in this-procedure
     1623         (input  p-code
     1624         ,output v-type
     1625         ,output v-format
     1626         ,output v-label
     1627         ,output v-range
     1628         ,output v-user-can-edit
     1629         ,output v-output-display
     1630         ,output v-other
     1631         ) no-error .
     1632       if error-status :error then do:
     1633         undo, return error return-value .
     1634       end.
     1635       find first buf_cash-pay-attr exclusive-lock
     1636         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
     1637           and buf_cash-pay-attr.curr-code  = p-curr-code
     1638           and buf_cash-pay-attr.host-code  = p-host-code
     1639           and buf_cash-pay-attr.obj-type   = p-obj-type
     1640           and buf_cash-pay-attr.obj-code   = p-obj-code
     1641           and buf_cash-pay-attr.attr-code = p-code
     1642         no-error NO-WAIT.
     1643       if not available buf_cash-pay-attr then do:
     1644         p-deleted = no.
     1645       end.
     1646       else do:
     1647         delete buf_cash-pay-attr no-error .
     1648         if error-status:error then do:
     1649           undo, return error return-value .
     1650         end.
     1651         p-deleted = yes.
     1652       end.
     1653     end.
     1654   end procedure.
     1655   procedure cp-attr-news :
     1656     do
     1657     on error undo, return error
     1658     :
     1659       define input  parameter p-code           as character no-undo .
     1660       define output parameter p-news           as logical   no-undo .
     1661       case p-code :
     1662               when 'paycard-export-prefix':U then do:     assign     p-news = true.   end.
     1663               when 'grp-code':U then do:     assign     p-news = true.   end.
     1664               when 'is-use':U then do:     assign     p-news = true.   end.
     1665               when 'dop-doc':U then do:     assign     p-news = true.   end.
     1666               when 'paycard-all-prefix':U then do:     assign     p-news = true.   end.
     1667               when 'paycard-edit-prefix':U then do:     assign     p-news = true.   end.
     1668               when 'form_km3':U then do:     assign     p-news = false.   end.
     1669               when 'bal_malina':U then do:     assign     p-news = false.   end.
     1670               when 'max_proc_sum':U then do:     assign     p-news = true.   end.
     1671               when 'mask_card_kup':U then do:     assign     p-news = true.   end.
     1672         otherwise do:
     1673           p-news = no.
     1674         end.
     1675       end.
     1676     end.
     1677   end procedure.
