     2343   function fnc-ban-bonus returns logical
     2344   (input p-gds-code as integer):
     2345       define variable result as logical no-undo.
     2346       define variable v-ban-bonus as logical no-undo.
     2347       define variable v-attr-value as character no-undo.
     2348       define variable v-attr-type as character no-undo.
     2349       run gds-attr-value (input p-gds-code,
     2350                           input  'ban-bonus':U,
     2351                           output v-attr-value,
     2352                           output v-attr-type).
     2353       return logical(v-attr-value).
     2354   end function.
     2355   function fnc-DD-MM-YYYY returns character
     2356   (input p-dat-date as date):
     2357       define variable result as character no-undo.
     2358       define variable p-str-date as character no-undo.
     2359       p-str-date = replace(string(p-dat-date,'99.99.9999'), "/", ".").
     2360           return p-str-date.
     2361   end function.
     2362   function fnc-convert-dot-to-colon returns character
     2363   (input p-data as decimal, input p-accur as character):
     2364       define variable result as character no-undo.
     2365       define variable v-str-result as character no-undo.
     2366       if p-data = ? then
     2367       do:
     2368           v-str-result = "?".
     2369       end.
     2370       else
     2371       do:
     2372           p-data = round(p-data, 2).
     2373           v-str-result = trim(replace(string(p-data, p-accur), ".", ",")).
     2374       end.
     2375       return v-str-result.
     2376   end function.
     2377   function last-of-condition returns logical
     2378   (
     2379    input obj-type   as character,
     2380    input obj-code   as integer,
     2381    input chk-date   as date,
     2382    input shift-date as date):
     2383       define variable v-log-result as logical no-undo.
     2384       if
     2385          v-obj-type1 = "" and
     2386          v-obj-code1 = 0 and
     2387          v-chk-date1 = ? and
     2388          v-shift-date1 = ? then
     2389       do:
     2390           v-log-result = no.
     2391       end.
     2392       else
     2393       do:
     2394           if
     2395              obj-type = v-obj-type1 and
     2396              obj-code = v-obj-code1 and
     2397              chk-date = v-chk-date1 and
     2398              shift-date = v-shift-date1 then
     2399           do:
     2400               v-log-result = no.
     2401           end.
     2402           else
     2403           do:
     2404               v-log-result = yes.
     2405           end.
     2406       end.
     2407       v-obj-type1 = obj-type.
     2408       v-obj-code1 = obj-code.
     2409       v-chk-date1 = chk-date.
     2410       v-shift-date1 = shift-date.
     2411       return v-log-result.
     2412   end function.
     2413   function last-of-condition2 returns logical
     2414   (input obj-type   as character,
     2415    input obj-code   as integer
     2416    ):
