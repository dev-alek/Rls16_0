     1736       field chk-type          like ub.chk-doc.chk-type
     1737       field chk-date          like ub.chk-doc.chk-date
     1738       field shift-date        like ub.chk-doc.shift-date
     1739       field discnt            like ub.chk-doc.discnt
     1740       field out-code          like ub.chk-doc.out-code
     1741       field office            like ub.chk-doc.office
     1742       field d-card            like ub.chk-doc.d-card
     1743       field netto             like ub.chk-doc.netto
     1744       field sub-discnt        like ub.chk-doc.sub-discnt
     1745       field d-pcnt            like ub.chk-doc.d-pcnt
     1746       field ban-bonus_        as logical
     1747       field obj-name_         as character
     1748       field sum-netto         as decimal
     1749       field sum_              as decimal
     1750       field note_             as character
     1751       field b-code_           like ub.bar-code.b-code
     1752       field sale-price_       like ub.chk-gds.price-base
     1753       field sum-gds-ban-bonus_ as decimal
     1754       field sum-bonus-malina_ as decimal
     1755       field sum-contribution_ as decimal
     1756       index pi    is primary obj-type obj-code
     1757       index dates chk-date shift-date
     1758       index note  note_
     1759   .
     1760   define temp-table my-table no-undo
     1761       field obj-type as character
     1762       field obj-code as character
     1763       field sum-netto as character
     1764       field sum-gds-ban-bonus_ as character
     1765       field list-ban-bonus as character
     1766       field sum_ as character
     1767       field list-v-sum_ as character
     1768       field list-sum-netto as character
     1769       field list-tot-r-b as character
     1770       field sum-contribution_ as character
     1771       field doc-code as character
     1772       field list-doc-code as character
     1773       field list-chk-gds-pay as character
     1774       field list-b-code as character
     1775       field list-chk-date as character
     1776       field list-shift-date as character
     1777       field sum-bonus-malina_ as character
     1778       field list-bonus-malina as character
     1779       field list-sum_ as character
     1780   .
     1781   define temp-table my-table2 no-undo
     1782       field obj-type as character
     1783       field obj-code as character
     1784       field doc-code as character
     1785       field chk-date as character
     1786       field sum_ as character
     1787       field sum-contribution_ as character
     1788   .
     1789   define buffer buf1_tt-chk for tt-chk.
     1790   define buffer buf2_tt-chk for tt-chk.
     1791   define stream OutStr-html.
     1792   define stream MyWatch-strm.
     1793   function fnc-ban-bonus returns logical
     1794   (input p-gds-code as integer) forward.
     1795   function fnc-DD-MM-YYYY returns character
     1796   (input p-dat-date as date) forward.
     1797   function fnc-convert-dot-to-colon returns character
     1798   (input p-data as decimal, input p-accur as character) forward.
     1799   function last-of-condition returns logical
     1800   (
     1801    input obj-type   as character,
     1802    input obj-code   as integer,
     1803    input chk-date   as date,
     1804    input shift-date as date) forward.
     1805   function last-of-condition2 returns logical
     1806   (input obj-type   as character,
     1807    input obj-code   as integer
     1808    ) forward.
     1809   run My-Rep.
     1810   procedure My-Rep:
     1811       run get-full-path-RepViewer(output v-full-path-RepView).
     1812       run get-report-num in parParentProc(output g#report-num).
     1813       run define-full-path-Report(input g#report-num, output v-file-name-rep-htm).
     1814       run create-file(v-file-name-rep-htm).
     1815       v-report-name = "Отчет об отчислениях в ЛПВ".
     1816       v-period = str1.
     1817       run get-pay-codes-bonus-malina.
     1818       run create-fill-tt-chk.
     1819       run proc-create-HTML(
     1820                                input v-file-name-rep-htm
     1821                               ,input v-report-name
     1822                               ,input v-period
     1823                               ,input v-short-obj-list
     1824                           ).
     1825       run search-full-path-Report(input v-file-name-rep-htm).
     1826       run Report-Viewer(input v-full-path-RepView, input v-file-name-rep-htm).
     1827   end procedure.
     1828   procedure create-fill-tt-chk:
     1829       for each obj-list
     1830       :
     1831           if x-TOG-Shift = yes then
     1832           do:
     1833               _c-d: for each ub.chk-doc where
     1834                              ub.chk-doc.obj-type = obj-list.obj-type and
     1835                              ub.chk-doc.obj-code = obj-list.obj-code and
     1836                              (ub.chk-doc.shift-date > X-date-Start or (ub.chk-doc.shift-date = X-date-Start and ub.chk-doc.shift-num >= x-Shift-Start)) and
     1837                              (ub.chk-doc.shift-date < X-date-End or (ub.chk-doc.shift-date = X-date-End and ub.chk-doc.shift-num <= x-Shift-End)) and
     1838                              ub.chk-doc.out-code <> ? and
     1839                              (ub.chk-doc.chk-type = integer('1':U) or ub.chk-doc.chk-type = integer('6':U)) and
     1840                              (string(ub.chk-doc.d-card) begins "639300" or ub.chk-doc.d-card begins "275")
     1841               :
     1842                   run chk-calc.
     1843               end.
     1844           end.
     1845           else
     1846           do:
     1847               _c-d: for each ub.chk-doc where
     1848                              ub.chk-doc.obj-type = obj-list.obj-type and
     1849                              ub.chk-doc.obj-code = obj-list.obj-code and
     1850                              ub.chk-doc.chk-date >= X-date-Start and
     1851                              ub.chk-doc.chk-date <= X-date-End and
     1852                              ub.chk-doc.out-code <> ? and
     1853                              (ub.chk-doc.chk-type = integer('1':U) or ub.chk-doc.chk-type = integer('6':U)) and
     1854                              (string(ub.chk-doc.d-card) begins "639300" or ub.chk-doc.d-card begins "275")
     1855               :
     1856                   run chk-calc.
     1857               end.
     1858           end.
     1859       end.
     1860   end procedure.
     1861   procedure chk-calc:
     1862       find first tt-chk where
     1863                  tt-chk.obj-type      = ub.chk-doc.obj-type and
     1864                  tt-chk.obj-code      = ub.chk-doc.obj-code and
     1865                  tt-chk.chk-date      = ub.chk-doc.chk-date and
     1866                  tt-chk.shift-date    = ub.chk-doc.shift-date
     1867        no-error.
     1868       if not available tt-chk then
     1869       do:
     1870           create tt-chk.
     1871           assign
     1872               tt-chk.doc-code     = ub.chk-doc.doc-code
     1873               tt-chk.obj-type     = ub.chk-doc.obj-type
     1874               tt-chk.obj-code     = ub.chk-doc.obj-code
     1875               tt-chk.obj-name_    = obj-list.obj-name
     1876               tt-chk.shift-date   = ub.chk-doc.shift-date
     1877               tt-chk.chk-date     = ub.chk-doc.chk-date
     1878               tt-chk.d-card       = ub.chk-doc.d-card
     1879           .
     1880       end.
     1881       do:
     1882               v-ban-bonus = 0.
     1883               v-bonus-malina = 0.
     1884               v-sum_ = 0.
     1885               v-sum-contribution_ = 0.
     1886           do:
     1887                   for each ub.chk-gds-pay no-lock where
     1888                             ub.chk-gds-pay.doc-code = ub.chk-doc.doc-code
     1889                   :
     1890                       v-calc-ban-bonus = no.
     1891                       do v-iiii = 1 to num-entries(v-pay-codes-bonus-malina, ","):
     1892                           if ub.chk-gds-pay.pay-code = integer(entry(v-iiii, v-pay-codes-bonus-malina, ",")) then
     1893                           do:
     1894                               v-bonus-malina = v-bonus-malina + ub.chk-gds-pay.tot-r-b.
     1895                               v-calc-ban-bonus = yes.
     1896                           end.
     1897                       end.
     1898                       for first ub.bar-code where
     1899                                 ub.bar-code.b-code = ub.chk-gds-pay.b-code no-lock
     1900                       :
     1901                           if fnc-ban-bonus(ub.bar-code.gds-code ) = yes then
     1902                           do:
     1903                               if v-calc-ban-bonus = no then
     1904                               do:
     1905                                   v-ban-bonus = v-ban-bonus + ub.chk-gds-pay.tot-r-b.  .
     1906                               end.
     1907                           end.
     1908                       end.
     1909                   end.
     1910           end.
     1911           tt-chk.sum-netto = tt-chk.sum-netto + ub.chk-doc.netto.
     1912           tt-chk.sum-gds-ban-bonus_ = tt-chk.sum-gds-ban-bonus_ + v-ban-bonus.
     1913           v-sum_ = ub.chk-doc.netto - v-ban-bonus - v-bonus-malina.
     1914           tt-chk.sum_ = tt-chk.sum_ + v-sum_.
     1915           v-sum-contribution_ = round(((v-sum_) * 0.01), 2).
     1916           tt-chk.sum-contribution_ = tt-chk.sum-contribution_ + v-sum-contribution_.
     1917           tt-chk.sum-bonus-malina_ = tt-chk.sum-bonus-malina_ + v-bonus-malina.
     1918       end.
     1919       find first buf1_tt-chk where
     1920              buf1_tt-chk.obj-type      = ub.chk-doc.obj-type and
     1921              buf1_tt-chk.obj-code      = ub.chk-doc.obj-code and
     1922              buf1_tt-chk.note_         = "sum-object"
     1923       no-lock no-error.
     1924       if not available buf1_tt-chk then
     1925       do:
     1926           create buf1_tt-chk.
     1927           buf1_tt-chk.obj-type      = ub.chk-doc.obj-type.
     1928           buf1_tt-chk.obj-code      = ub.chk-doc.obj-code.
     1929           buf1_tt-chk.obj-name_     = obj-list.obj-name.
     1930           buf1_tt-chk.note_         = "sum-object".
     1931       end.
     1932           buf1_tt-chk.sum_ = buf1_tt-chk.sum_ + v-sum_.
     1933           buf1_tt-chk.sum-contribution_ = buf1_tt-chk.sum-contribution_ + v-sum-contribution_.
     1934       find first buf2_tt-chk where
     1935           buf2_tt-chk.note_ = "sum-report"
     1936       no-lock no-error.
     1937       if not available buf2_tt-chk then
     1938       do:
     1939           create buf2_tt-chk.
     1940           buf2_tt-chk.obj-type = ub.chk-doc.obj-type.
     1941           buf2_tt-chk.obj-code = ub.chk-doc.obj-code.
     1942           buf2_tt-chk.obj-name_ = obj-list.obj-name.
     1943           buf2_tt-chk.note_ = "sum-report".
     1944       end.
     1945           buf2_tt-chk.sum_ = buf2_tt-chk.sum_ + v-sum_.
     1946           buf2_tt-chk.sum-contribution_ = buf2_tt-chk.sum-contribution_ + v-sum-contribution_.
     1947   end procedure.
     1948   procedure proc-create-HTML:
     1949       define input parameter p-file-name-rep-htm as character no-undo.
     1950       define input parameter p-report-name as character no-undo.
     1951       define input parameter p-period as character no-undo.
     1952       define input parameter p-short-obj-list as character no-undo.
     1953       define variable v-message as character no-undo.
     1954       define buffer buf-html_clients for ub.clients.
     1955       do:
     1956           output stream OutStr-html to value(p-file-name-rep-htm) append convert target 'UTF-8'.
     1957               put stream OutStr-html unformatted
     1958                   "<!DOCTYPE HTML>" skip
     1959                   ' <html>' skip
     1960                   '  <head>' skip
     1961                   '   <meta charset="utf-8">' skip
     1962                   '    <style type="text/css">' skip
     1963                   '      table ' + chr(123) + ' border-collapse: collapse; font-size: 9pt; table-layout: fixed; width: 1157px; padding: 14px; ' + chr(125) skip
     1964                   '      td ' + chr(123) ' border: 1px black ridge; word-wrap:break-word; ' + chr(125) skip
     1965                   '      htm' skip
     1966                   '      .rotate ' + chr(123) skip
     1967                   '        -webkit-transform: rotate(-90deg);' skip
     1968                   '        -moz-transform: rotate(-90deg);' skip
     1969                   '        -ms-transform: rotate(-90deg);' skip
     1970                   '        -o-transform: rotate(-90deg);' skip
     1971                   '        transform: rotate(-90deg);' skip
     1972                   '        -webkit-transform-origin: 50% 50%;' skip
     1973                   '        -moz-transform-origin: 50% 50%;' skip
     1974                   '        -ms-transform-origin: 50% 50%;' skip
     1975                   '        -o-transform-origin: 50% 50%;' skip
     1976                   '        transform-origin: 50% 50%;' skip
     1977                   '        filter: progid:DXImageTransform.Microsoft.BasicImage(rotation=3);' skip
     1978                   '          ' + chr(125) skip
     1979                   '            th' + ' ' + chr(123) skip
     1980                   '            border: 1px black solid;' skip
     1981                   '            word-wrap: break-word;' skip
     1982                   '          ' + chr(125) skip
     1983                   '   </style>' skip
     1984                   '  </head>' skip
     1985               .
     1986       end.
     1987       do:
     1988               put stream OutStr-html unformatted
     1989                   ' <body>' skip
     1990                   '   <table name="Лист1" outline_below="false">' skip
     1991                   '     <thead>' skip
     1992                   '       <tr class="set_columns">' skip
     1993                   '         <td style="width: 220px; border: none;"></td>' skip
     1994                   '         <td style="width: 68px; border: none;"></td>' skip
     1995                   '         <td style="width: 68px; border: none;"></td>' skip
     1996                   '         <td style="width: 80px; border: none;"></td>' skip
     1997                   '         <td style="width: 80px; border: none;"></td>' skip
     1998                   '       </tr>' skip
     1999               .
     2000       end.
     2001       do:
     2002               put stream OutStr-html unformatted
     2003                   '       <tr>' skip
     2004                   '         <td style="border: none; height: 14px"></td>' skip
     2005                   '         <td style="border: none"></td>' skip
     2006                   '         <td style="border: none"></td>' skip
     2007                   '         <td style="border: none"></td>' skip
     2008                   '         <td style="border: none"></td>' skip
     2009                   '       </tr>' skip
     2010                   '       <tr>' skip
     2011                   '         <td colspan="5" style="border: none; height: 14px; font-weight: bold; text-align: center">' + p-report-name + '</td>' skip
     2012                   '         <td style="border: none"></td>' skip
     2013                   '         <td style="border: none"></td>' skip
     2014                   '         <td style="border: none"></td>' skip
     2015                   '         <td style="border: none"></td>' skip
     2016                   '       </tr>' skip
     2017                   '       <tr>' skip
     2018                   '         <td colspan="5" style="border: none; height: 14px; font-weight: bold; text-align: center">' + p-period + '</td>' skip
     2019                   '         <td style="border: none"></td>' skip
     2020                   '         <td style="border: none"></td>' skip
     2021                   '         <td style="border: none"></td>' skip
     2022                   '         <td style="border: none"></td>' skip
     2023                   '       </tr>' skip
     2024                   '       <tr>' skip
     2025                   '         <td style="border: none; height: 14px; font-weight: bold"></td>' skip
     2026                   '         <td style="border: none"></td>' skip
     2027                   '         <td style="border: none"></td>' skip
     2028                   '         <td style="border: none"></td>' skip
     2029                   '         <td style="border: none"></td>' skip
     2030                   '       </tr>' skip
     2031               .
     2032       end.
     2033       do:
     2034               put stream OutStr-html unformatted
     2035                   '     <tbody>' skip
     2036                   '       <tr>' skip
     2037                   '         <th style="text-align: center; height: 30px">Станция</th>' skip
     2038                   '         <th style="text-align: center;">Смена (дата)</th>' skip
     2039                   '         <th style="text-align: center;">Дата (чека)</th>' skip
     2040                   '         <th style="text-align: center;">Сумма чека</th>' skip
     2041                   '         <th style="text-align: center;">Сумма отчислений (гр.4*1%)</th>' skip
     2042                   '       </tr>' skip
     2043                   '       <tr>' skip
     2044                   '         <th num="" style="text-align: center">1</th>' skip
     2045                   '         <th num="" style="text-align: center">2</th>' skip
     2046                   '         <th num="" style="text-align: center">3</th>' skip
     2047                   '         <th num="" style="text-align: center">4</th>' skip
     2048                   '         <th num="" style="text-align: center">5</th>' skip
     2049                   '       </tr>' skip
     2050               .
     2051           output stream OutStr-html close.
     2052       end.
     2053       do:
     2054           output stream OutStr-html to value(p-file-name-rep-htm) append convert target 'UTF-8'.
     2055           for first tt-chk where
     2056                    tt-chk.note_ = "sum-report"
     2057           no-lock:
     2058               do:
     2059                   put stream OutStr-html unformatted
     2060                       '       <tr level="1">' skip
     2061                       '         <td style="display: yes; text-align: left; height: 20px; font-weight: bold; padding-left: 0px">' +
     2062                                   "Итого по всем Объектам:" + '</td>' skip
     2063                       '         <td style="display: yes; text-align: center; font-weight: bold">' +
     2064                                   if tt-chk.shift-date <> ? then fnc-DD-MM-YYYY(tt-chk.shift-date) + '</td>' else "" + '</td>' skip
     2065                       '         <td style="display: yes; text-align: center; font-weight: bold">' +
     2066                                   if tt-chk.chk-date <> ? then fnc-DD-MM-YYYY(tt-chk.chk-date) + '</td>' else "" + '</td>' skip
     2067                       '         <td num="0.00" style="display: yes; text-align: right; font-weight: bold" val="' + string(tt-chk.sum_) + '"' + '>' +
     2068                                   fnc-convert-dot-to-colon(tt-chk.sum_, v-accur-13) + '</td>' skip
     2069                       '         <td num="0.00" style="display: yes; text-align: right; font-weight: bold" val="' + string(tt-chk.sum-contribution_) + '"' + '>' +
     2070                                   fnc-convert-dot-to-colon(tt-chk.sum-contribution_, v-accur-13) + '</td>' skip
     2071                       '       </tr>' skip
     2072                   .
     2073               end.
     2074               for each buf1_tt-chk no-lock where
     2075                        buf1_tt-chk.note_ = "sum-object"
     2076                   by buf1_tt-chk.obj-code
     2077               :
     2078                   do:
     2079                       put stream OutStr-html unformatted
     2080                           '       <tr level="2">' skip
     2081                           '         <td style="display: yes; text-align: left; height: 20px; font-weight: bold; padding-left: 10px">' +
     2082                                       "Итого по Объекту:" + string(buf1_tt-chk.obj-code) + " " + buf1_tt-chk.obj-name_  + '</td>' skip
     2083                           '         <td style="display: yes; text-align: center; font-weight: bold">' +
     2084                                       if buf1_tt-chk.shift-date <> ? then fnc-DD-MM-YYYY(buf1_tt-chk.shift-date) + '</td>' else "" + '</td>' skip
     2085                           '         <td style="display: yes; text-align: center; font-weight: bold">' +
     2086                                       if buf1_tt-chk.chk-date <> ? then fnc-DD-MM-YYYY(buf1_tt-chk.chk-date) + '</td>' else "" + '</td>' skip
     2087                           '         <td num="0.00" style="display: yes; text-align: right; font-weight: bold" val="' + string(buf1_tt-chk.sum_) + '"' + '>' +
     2088                                       fnc-convert-dot-to-colon(buf1_tt-chk.sum_, v-accur-13) + '</td>' skip
     2089                           '         <td num="0.00" style="display: yes; text-align: right; font-weight: bold" val="' + string(buf1_tt-chk.sum-contribution_) + '"' + '>' +
     2090                                       fnc-convert-dot-to-colon(buf1_tt-chk.sum-contribution_, v-accur-13) + '</td>' skip
     2091                           '       </tr>' skip
     2092                       .
     2093                   end.
     2094                   for each buf2_tt-chk no-lock where
     2095                            buf2_tt-chk.obj-type = buf1_tt-chk.obj-type and
     2096                            buf2_tt-chk.obj-code = buf1_tt-chk.obj-code and
     2097                            buf2_tt-chk.note_ <> "sum-report" and
     2098                            buf2_tt-chk.note_ <> "sum-object"
     2099                       by buf2_tt-chk.obj-type
     2100                       by buf2_tt-chk.obj-code
     2101                       by buf2_tt-chk.shift-date
     2102                       by buf2_tt-chk.chk-date
     2103                   :
     2104                       do:
     2105                           put stream OutStr-html unformatted
     2106                               '       <tr level="3">' skip
     2107                               '         <td style="display: none; text-align: left; height: 20px; font-weight: normal; padding-left: 20px">' +
     2108                                           string(buf2_tt-chk.obj-code) + " " + buf2_tt-chk.obj-name_ + '</td>' skip
     2109                               '         <td style="display: none; text-align: center; font-weight: normal">' +
     2110                                           if buf2_tt-chk.shift-date <> ? then fnc-DD-MM-YYYY(buf2_tt-chk.shift-date) + '</td>' else "?" + '</td>' skip
     2111                               '         <td style="display: none; text-align: center; font-weight: normal">' +
     2112                                           if buf2_tt-chk.chk-date <> ? then fnc-DD-MM-YYYY(buf2_tt-chk.chk-date) + '</td>' else "?" + '</td>' skip
     2113                               '         <td num="0.00" style="display: none; text-align: right; font-weight: normal" val="' + string(buf2_tt-chk.sum_) + '"' + '>' +
     2114                                           fnc-convert-dot-to-colon(buf2_tt-chk.sum_, v-accur-13) + '</td>' skip
     2115                               '         <td num="0.00" style="display: none; text-align: right; font-weight: normal" val="' + string(buf2_tt-chk.sum-contribution_) + '"' + '>' +
     2116                                           fnc-convert-dot-to-colon(buf2_tt-chk.sum-contribution_, v-accur-13) + '</td>' skip
     2117                               '       </tr>' skip
     2118                           .
     2119                       end.
     2120                   end.
     2121               end.
     2122           end.
     2123       end.
     2124       do:
     2125                   put stream OutStr-html unformatted
     2126                   '     </tbody>' skip
     2127                   '   </table>' skip
     2128                   '  </body>' skip
     2129                   ' </html>' skip
     2130                   .
     2131           output stream OutStr-html close.
     2132       end.
     2133   end procedure.
     2134   procedure get-full-path-RepViewer:
     2135       define output parameter p-fill-path-RepView as character no-undo.
     2136       if search("exe\ReportViewer\reportviewer.exe") <> ? then
     2137       do:
     2138           p-fill-path-RepView = search("exe\ReportViewer\reportviewer.exe").
     2139       end.
     2140       else
     2141       do:
     2142           message "Не найдена программа просмотра отчёта!" view-as alert-box error.
     2143       end.
     2144   end procedure.
     2145   procedure define-full-path-Report:
     2146       define input parameter p-rep-num as integer no-undo.
     2147       define output parameter p-file-name-rep-htm as character no-undo.
     2148       p-file-name-rep-htm = session:temp-directory + "rpt" + string(p-rep-num) + ".html".
     2149   end procedure.
     2150   procedure search-full-path-Report:
     2151       define input parameter p-file-name as character no-undo.
     2152       if search(p-file-name) = ? then
     2153           do:
     2154               message "Не найден файл отчёта: " p-file-name view-as alert-box error.
     2155           end.
     2156       else
     2157           do:
     2158               p-file-name = search(p-file-name).
     2159           end.
     2160   end procedure.
     2161   procedure Report-Viewer:
     2162       define input parameter p-full-path-RepView as character no-undo.
     2163       define input parameter p-file-name-rep-htm as character no-undo.
     2164       os-command no-wait value(p-full-path-RepView + " true " + search(p-file-name-rep-htm)).
     2165   end procedure.
     2166   procedure create-file:
     2167       define input parameter p-file-name as character no-undo.
     2168       output to value(string(p-file-name)).
     2169       output close.
     2170   end procedure.
     2171   procedure get-pay-codes-bonus-malina:
     2172   define buffer buf_cash-pay-attr for ub.cash-pay-attr.
     2173   define buffer buf_chk-gds for ub.chk-gds.
     2174       for each buf_cash-pay-attr no-lock where
     2175                buf_cash-pay-attr.attr-code    = 'bal_malina':U and
     2176                buf_cash-pay-attr.attr-value   = "yes"
     2177       :
     2178           v-pay-codes-bonus-malina = (if v-pay-codes-bonus-malina = "" then v-pay-codes-bonus-malina else v-pay-codes-bonus-malina + ",") + string(buf_cash-pay-attr.cdpay-code).
     2179       end.
     2180   end procedure.
     2181   procedure my-watch-table:
     2182       define variable v-full-file-name as character no-undo.
     2183       define variable v-message as character no-undo.
     2184       define variable v-table-handle as handle no-undo.
     2185       define variable v-cnt-field as integer no-undo.
     2186       define variable v-list-field-name as character no-undo.
     2187       define variable v-list-field-label as character no-undo.
     2188       define variable v-list-field-type as character no-undo.
     2189       define variable v-ii as integer no-undo.
     2190       define buffer tt-chk for tt-chk.
     2191       v-table-handle = buffer tt-chk:handle.
     2192       v-cnt-field = v-table-handle:num-fields.
     2193       do v-ii = 1 to v-cnt-field:
     2194           v-list-field-name =
     2195               (if v-list-field-name <> "" then
     2196                  v-list-field-name + "$" + v-table-handle:buffer-field(v-ii):name
     2197               else
     2198                   v-table-handle:buffer-field(v-ii):name).
     2199           v-list-field-label =
     2200               (if v-list-field-label <> "" then
     2201                  v-list-field-label + "$" + v-table-handle:buffer-field(v-ii):label
     2202               else
     2203                   v-table-handle:buffer-field(v-ii):label).
     2204           v-list-field-type =
     2205               (if v-list-field-type <> "" then
     2206                  v-list-field-type + "$" + v-table-handle:buffer-field(v-ii):data-type
     2207               else
     2208                   v-table-handle:buffer-field(v-ii):data-type).
     2209       end.
     2210       v-full-file-name = "C:\work15_0\my-watch-table.txt".
     2211       if search(v-full-file-name) = ? then
     2212           do:
     2213               message "Не найден файл отчёта: " v-full-file-name view-as alert-box error.
     2214           end.
     2215       output stream MyWatch-strm to value(v-full-file-name)   convert target "utf-8".
     2216           put stream MyWatch-strm unformatted
     2217               today format "99.99.9999" " " string(time, "HH:MM") " " "Исследуемая таблица: " "tt-chk" "." skip
     2218               v-list-field-label skip
     2219               v-list-field-name skip
     2220               v-list-field-type skip
     2221           .
     2222           if not can-find(first tt-chk) then
     2223           do:
     2224               v-message = "Исследуемая таблица tt-chk пуста!".
     2225               put stream MyWatch-strm unformatted
     2226                   v-message
     2227               .
     2228               message "My-watch-table: " v-message view-as alert-box information.
     2229           end.
     2230               for each  tt-chk no-lock:
     2231                   export stream MyWatch-strm delimiter "$"  tt-chk.
     2232               end.
     2233       output stream MyWatch-strm close.
     2234   end procedure.
