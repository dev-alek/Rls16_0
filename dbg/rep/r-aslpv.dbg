     1687               when 'paycard-edit-prefix':U then do:     assign     p-hist = true.   end.
     1688               when 'form_km3':U then do:     assign     p-hist = true.   end.
     1689               when 'bal_malina':U then do:     assign     p-hist = true.   end.
     1690               when 'max_proc_sum':U then do:     assign     p-hist = true.   end.
     1691               when 'mask_card_kup':U then do:     assign     p-hist = true.   end.
     1692         otherwise do:
     1693           p-hist = no.
     1694         end.
     1695       end.
     1696     end.
     1697   end procedure.
