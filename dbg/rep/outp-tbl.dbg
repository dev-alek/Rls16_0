        1   block-level on error undo, throw.
        2   define input parameter parParentProc     AS WIDGET-HANDLE NO-UNDO.
        3   define input parameter rec_id         as recid        no-undo.
        4   define input parameter type-prn       as character    no-undo.
        5   define input parameter p-form-name    as character    no-undo.
        6   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        7   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        8   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile: outp-tbl.p $":U .
       10   define variable vss-archive     as character no-undo init "$Archive: rep/outp-tbl.p $":U .
       11   define variable vss-description as character no-undo init "Печать строк накладных (старая)".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define new global shared variable g#lib-trn  as handle no-undo .
       73   define new global shared variable g#lib-trn2 as handle no-undo .
       74   define new global shared variable g#lib-trn3 as handle no-undo .
       75   define new global shared variable g#lib-trn4 as handle no-undo .
       76   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       77   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
       78   define  shared variable RepPathName        as character no-undo .
       79   define  shared variable PrintRubl          as logical   no-undo .
       80   define variable vss-include-info1 as character format "X(65)" no-undo
       81   initial "@(#)$Workfile$ $Revision$".
       82   define variable v-fmtcli-name          as character    no-undo.
       83   define variable v-fmtcli-engl-name     as character    no-undo.
       84   define variable v-fmtcli-addres        as character    no-undo.
       85   define variable v-fmtcli-post-addres   as character    no-undo.
       86   define variable v-fmtcli-full-addres   as character    no-undo.
       87   define variable v-fmtcli-phone         as character    no-undo.
       88   define variable v-fmtcli-inn           as character    no-undo.
       89   define variable v-fmtcli-kpp           as character    no-undo.
       90   define variable v-fmtcli-okpo          as character    no-undo.
       91   define variable v-fmtcli-country       as character    no-undo.
       92   define variable v-fmtcli-city          as character    no-undo.
       93   define variable v-fmtcli-index         as character    no-undo.
       94   define variable v-fmtcli-schet-exists  as logical      no-undo.
       95   define variable v-fmtcli-bank-exists   as logical      no-undo.
       96   define variable v-fmtcli-bank-r-schet  as character    no-undo.
       97   define variable v-fmtcli-bank-c-schet  as character    no-undo.
       98   define variable v-fmtcli-bank-bik      as character    no-undo.
       99   define variable v-fmtcli-bank-name     as character    no-undo.
      100   define variable v-fmtcli-bank-addres   as character    no-undo.
      101   define variable v-fmtcli-bank-city     as character    no-undo.
      102   procedure fmtcli-get-bank :
      103   define input parameter p-host-code      as integer          no-undo.
      104   define input parameter p-obj-type       as character        no-undo.
      105   define input parameter p-obj-code       as integer          no-undo.
      106   define input parameter p-curr-code      as integer          no-undo.
      107       define buffer buf_fin-schet     for ub.fin-schet.
      108       define buffer buf_fin-bank      for ub.fin-bank.
      109   do
      110   for buf_fin-schet
      111     , buf_fin-bank
      112   on error undo, return error
      113   :
      114       assign
      115           v-fmtcli-schet-exists       = no
      116           v-fmtcli-bank-exists        = no
      117           v-fmtcli-bank-r-schet       = "":U
      118           v-fmtcli-bank-c-schet       = "":U
      119           v-fmtcli-bank-bik           = "":U
      120           v-fmtcli-bank-name          = "":U
      121           v-fmtcli-bank-addres        = "":U
      122           v-fmtcli-bank-city          = "":U
      123       .
      124       search-for-schet:
      125       for each buf_fin-schet no-lock
      126          where buf_fin-schet.host-code = p-host-code
      127            and buf_fin-schet.cli-type  = p-obj-type
      128            and buf_fin-schet.cli-code  = p-obj-code
      129            and buf_fin-schet.curr-code = p-curr-code
      130       on error undo, return error
      131       :
      132           if buf_fin-schet.status_   = 'удал':U
      133           then do:
      134           end.
      135           else do:
      136               assign
      137                   v-fmtcli-schet-exists   = yes
      138                   v-fmtcli-bank-r-schet   = trim( buf_fin-schet.r-schet )
      139                   v-fmtcli-bank-c-schet   = trim( buf_fin-schet.c-schet )
      140               .
      141               find first buf_fin-bank no-lock
      142                    where buf_fin-bank.host-code = p-host-code
      143                      and buf_fin-bank.code-bank = buf_fin-schet.code-bank
      144               no-error.
      145               if available buf_fin-bank
      146               then do:
      147                   assign
      148                       v-fmtcli-bank-exists      = yes
      149                       v-fmtcli-bank-bik         = trim( buf_fin-bank.bik )
      150                       v-fmtcli-bank-name        = trim( buf_fin-bank.bank-name )
      151                       v-fmtcli-bank-addres      = trim(buf_fin-bank.addres)
      152                       v-fmtcli-bank-city      = trim(buf_fin-bank.bank-city)
      153                   .
      154               end.
      155               else do:
      156                   assign
      157                       v-fmtcli-bank-exists    = no
      158                       v-fmtcli-bank-bik       = "":U
      159                       v-fmtcli-bank-name      = "":U
      160                       v-fmtcli-bank-addres    = "":U
      161                       v-fmtcli-bank-city      = "":U
      162                   .
      163               end.
      164               leave search-for-schet.
      165           end.
      166       end.
      167   end.
      168   end procedure.
      169   procedure fmtcli-get-client :
      170   define input parameter p-obj-type       as character    no-undo.
      171   define input parameter p-obj-code       as integer      no-undo.
      172       define variable v-temp-fmtcli-address      as character     no-undo.
      173       define variable v-num-country-city    as integer      no-undo.
      174       define buffer buf_clients   for ub.clients.
      175       define buffer buf_firm      for ub.firm.
      176       define buffer buf_store     for ub.store.
      177       define buffer buf_shop      for ub.shop.
      178       define buffer buf_person    for ub.person.
      179   do
      180   for buf_clients
      181     , buf_firm
      182     , buf_store
      183     , buf_shop
      184     , buf_person
      185   on error undo, return error
      186   :
      187       assign
      188           v-fmtcli-name           = "":U
      189           v-fmtcli-addres         = "":U
      190           v-fmtcli-post-addres    = "":U
      191           v-fmtcli-full-addres    = "":U
      192           v-fmtcli-phone          = "":U
      193           v-fmtcli-inn            = "":U
      194           v-fmtcli-kpp            = "":U
      195           v-fmtcli-okpo           = "":U
      196           v-fmtcli-city           = "":U
      197           v-fmtcli-index          = "":U
      198           v-fmtcli-country        = "":U
      199       .
      200       find first buf_clients no-lock
      201            where buf_clients.obj-type = p-obj-type
      202              and buf_clients.obj-code = p-obj-code
      203       .
      204       assign
      205           v-fmtcli-name = buf_clients.obj-name
      206       .
      207       case buf_clients.obj-type:
      208          when 'орг':U
      209          then do:
      210               find first buf_firm no-lock
      211                    where buf_firm.firm-code = buf_clients.obj-code
      212                    no-error
      213               .
      214               if available buf_firm
      215               then do:
      216                   assign
      217                       v-num-country-city = num-entries( buf_firm.city )
      218                       v-fmtcli-engl-name = buf_firm.engl-name
      219                   .
      220                   if v-num-country-city > 0
      221                   then do:
      222                       assign
      223                           v-fmtcli-country    = trim( entry( 1, buf_firm.city ) )
      224                       .
      225                   end.
      226                   if v-num-country-city > 1
      227                   then do:
      228                       assign
      229                           v-fmtcli-city       = trim( entry( 2, buf_firm.city ) )
      230                       .
      231                   end.
      232                   run fmtcli-concatenate-strings in this-procedure (
      233                         input v-fmtcli-full-addres
      234                       , input v-fmtcli-country
      235                       , input ", ":U
      236                       , input 50
      237                       , output v-fmtcli-full-addres
      238                   ).
      239                   run fmtcli-concatenate-strings in this-procedure (
      240                         input v-fmtcli-full-addres
      241                       , input v-fmtcli-city
      242                       , input ", ":U
      243                       , input 50
      244                       , output v-fmtcli-full-addres
      245                   ).
      246                   run fmtcli-concatenate-strings in this-procedure (
      247                         input v-fmtcli-full-addres
      248                       , input IF buf_firm.ind = 0 THEN "" ELSE string( buf_firm.ind )
      249                       , input ", ":U
      250                       , input 50
      251                       , output v-fmtcli-full-addres
      252                   ).
      253                   run fmtcli-concatenate-strings in this-procedure (
      254                         input v-fmtcli-post-addres
      255                       , input v-fmtcli-country
      256                       , input ", ":U
      257                       , input 50
      258                       , output v-fmtcli-post-addres
      259                   ).
      260                   run fmtcli-concatenate-strings in this-procedure (
      261                         input v-fmtcli-post-addres
      262                       , input v-fmtcli-city
      263                       , input ", ":U
      264                       , input 50
      265                       , output v-fmtcli-post-addres
      266                   ).
      267                   run fmtcli-concatenate-strings in this-procedure (
      268                         input v-fmtcli-post-addres
      269                       , input string( buf_firm.ind )
      270                       , input ", ":U
      271                       , input 50
      272                       , output v-fmtcli-post-addres
      273                   ).
      274                   run fmtcli-concatenate-strings in this-procedure (
      275                         input substring( buf_firm.addres1, 1, 50 )
      276                       , input buf_firm.addres2
      277                       , input " ":U
      278                       , input 50
      279                       , output v-temp-fmtcli-address
      280                   ).
      281                   run fmtcli-concatenate-strings in this-procedure (
      282                         input v-temp-fmtcli-address
      283                       , input substring( buf_firm.addres1, 51, 50 )
      284                       , input " ":U
      285                       , input 50
      286                       , output v-temp-fmtcli-address
      287                   ).
      288                   run fmtcli-concatenate-strings in this-procedure (
      289                         input v-temp-fmtcli-address
      290                       , input substring( buf_firm.addres1, 101, 50 )
      291                       , input " ":U
      292                       , input 50
      293                       , output v-temp-fmtcli-address
      294                   ).
      295                   assign
      296                       v-fmtcli-addres = v-temp-fmtcli-address
      297                   .
      298                   if buf_firm.addres1 <> ?
      299                   then do:
      300                       run fmtcli-concatenate-strings in this-procedure (
      301                             input v-fmtcli-full-addres
      302                           , input v-fmtcli-addres
      303                           , input ", ":U
      304                           , input 0
      305                           , output v-fmtcli-full-addres
      306                       ).
      307                   end.
      308                   run fmtcli-concatenate-strings in this-procedure (
      309                         input substring( buf_firm.post-addr1, 1, 50 )
      310                       , input buf_firm.post-addr2
      311                       , input " ":U
      312                       , input 50
      313                       , output v-fmtcli-post-addres
      314                   ).
      315                   run fmtcli-concatenate-strings in this-procedure (
      316                         input v-fmtcli-post-addres
      317                       , input substring( buf_firm.post-addr1, 51, 50 )
      318                       , input " ":U
      319                       , input 50
      320                       , output v-fmtcli-post-addres
      321                   ).
      322                   run fmtcli-concatenate-strings in this-procedure (
      323                         input v-fmtcli-post-addres
      324                       , input substring( buf_firm.post-addr1, 101, 50 )
      325                       , input " ":U
      326                       , input 50
      327                       , output v-fmtcli-post-addres
      328                   ).
      329                   assign
      330                       v-fmtcli-phone         = buf_firm.phone
      331                       v-fmtcli-inn           = buf_firm.inn
      332                       v-fmtcli-kpp           = buf_firm.kpp
      333                       v-fmtcli-okpo          = buf_firm.okpo
      334                       v-fmtcli-index         = string( buf_firm.ind )
      335                   .
      336               end.
      337          end.
      338          when 'маг':U
      339          then do:
      340               find first buf_shop no-lock
      341                    where buf_shop.obj-code = buf_clients.obj-code
      342               .
      343               if available buf_shop
      344               then do:
      345                   run fmtcli-concatenate-strings in this-procedure (
      346                         input buf_shop.addres1
      347                       , input buf_shop.addres2
      348                       , input " ":U
      349                       , input 50
      350                       , output v-fmtcli-addres
      351                   ).
      352                   assign
      353                       v-fmtcli-full-addres = v-fmtcli-addres
      354                       v-fmtcli-post-addres = v-fmtcli-addres
      355                       v-fmtcli-phone       = buf_shop.phone
      356                       v-fmtcli-inn         = "":U
      357                       v-fmtcli-kpp         = "":U
      358                       v-fmtcli-okpo        = "":U
      359                       v-fmtcli-city        = "":U
      360                       v-fmtcli-index       = "":U
      361                   .
      362               end.
      363          end.
      364          when 'скл':U
      365          then do:
      366               find first buf_store no-lock
      367                    where buf_store.obj-code = buf_clients.obj-code
      368               .
      369               if available buf_store
      370               then do:
      371                   run fmtcli-concatenate-strings in this-procedure (
      372                         input buf_store.addres1
      373                       , input buf_store.addres2
      374                       , input " ":U
      375                       , input 50
      376                       , output v-fmtcli-addres
      377                   ).
      378                   assign
      379                       v-fmtcli-full-addres = v-fmtcli-addres
      380                       v-fmtcli-phone       = buf_store.phone
      381                       v-fmtcli-inn         = "":U
      382                       v-fmtcli-kpp         = "":U
      383                       v-fmtcli-okpo        = "":U
      384                       v-fmtcli-city        = "":U
      385                       v-fmtcli-index       = "":U
      386                   .
      387               end.
      388          end.
      389          when 'чел':U
      390          then do:
      391               find first buf_person no-lock
      392                    where buf_person.psn-code = buf_clients.obj-code
      393               .
      394               if available buf_person
      395               then do:
      396                   run fmtcli-concatenate-strings in this-procedure (
      397                         input ( if buf_person.ind = 0 or buf_person.ind = ?
      398                                 then "":U
      399                                 else string( buf_person.ind, "999999")
      400                                 )
      401                       , input buf_person.city
      402                       , input ", ":U
      403                       , input 0
      404                       , output v-fmtcli-full-addres
      405                   ).
      406                   assign
      407                       v-fmtcli-addres = buf_person.address
      408                   .
      409                   run fmtcli-concatenate-strings in this-procedure (
      410                         input v-fmtcli-full-addres
      411                       , input v-fmtcli-addres
      412                       , input ", ":U
      413                       , input 0
      414                       , output v-fmtcli-full-addres
      415                   ).
      416                   assign
      417                       v-fmtcli-phone     = buf_person.phone1
      418                       v-fmtcli-inn       = buf_person.inn
      419                       v-fmtcli-kpp       = buf_person.kpp
      420                       v-fmtcli-okpo      = buf_person.okpo
      421                       v-fmtcli-city      = buf_person.city
      422                       v-fmtcli-index     = string( buf_person.ind )
      423                   .
      424               end.
      425          end.
      426       end case.
      427   end.
      428   end procedure.
      429   procedure fmtcli-concatenate-strings :
      430   define input parameter p-string-1       as character        no-undo.
      431   define input parameter p-string-2       as character        no-undo.
      432   define input parameter p-delimiter      as character        no-undo.
      433   define input parameter p-length         as integer          no-undo.
      434   define output parameter p-out-string    as character        no-undo.
      435   do
      436   on error undo, return error
      437   :
      438       assign
      439           p-out-string = ( if p-string-1 = ?
      440                            then "":U
      441                            else trim( p-string-1 ) )
      442       .
      443       assign
      444           p-out-string = p-out-string
      445                        + ( if p-out-string = "":U
      446                            or length( p-out-string ) = p-length
      447                            or p-string-2 = ?
      448                            or trim( p-string-2 ) = "":U
      449                            then "":U
      450                            else p-delimiter )
      451                        + ( if p-string-2 = ?
      452                            or trim( p-string-2 ) = "":U
      453                            then "":U
      454                            else trim( p-string-2 ) )
      455       .
      456   end.
      457   end procedure.
      458   def var vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      459   define new global shared variable g#attr-lib  as handle no-undo .
      460   define variable v-attr-lib-variable as handle no-undo .
      461   procedure clntattr-code :
      462     define input  parameter p-code           as character no-undo .
      463     define output parameter p-type           as character no-undo .
      464     define output parameter p-format         as character no-undo .
      465     define output parameter p-label          as character no-undo .
      466     define output parameter p-user-can-edit  as logical   no-undo .
      467     define output parameter p-output-display as logical   no-undo .
      468     define output parameter p-other          as character no-undo .
      469     do
      470     on error undo, return error return-value
      471     :
      472           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clntattr-code in g#attr-lib
      473         (input  p-code
      474         ,output p-type
      475         ,output p-format
      476         ,output p-label
      477         ,output p-user-can-edit
      478         ,output p-output-display
      479         ,output p-other
      480         ) no-error .
      481       if error-status :error
      482       then do:
      483         undo, return error return-value .
      484       end.
      485     end.
      486   end procedure.
      487   procedure clntattr-tooltip :
      488     define input  parameter p-code    as character no-undo .
      489     define output parameter p-tooltip as character no-undo .
      490     define output parameter p-label   as character no-undo .
      491     do
      492     on error undo, return error return-value
      493     :
      494           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clntattr-tooltip in g#attr-lib
      495         (input  p-code
      496         ,output p-tooltip
      497         ,output p-label
      498         ) no-error .
      499       if error-status :error
      500       then do:
      501         undo, return error return-value .
      502       end.
      503     end.
      504   end procedure.
      505   procedure clntattr-value :
      506     define input  parameter p-obj-type like ub.clients-attr.obj-type   no-undo .
      507     define input  parameter p-obj-code like ub.clients-attr.obj-code   no-undo .
      508     define input  parameter p-code     like ub.clients-attr.attr-code  no-undo .
      509     define output parameter p-value    like ub.clients-attr.attr-value no-undo .
      510     define output parameter p-type     as character no-undo .
      511     do
      512     on error undo, return error return-value
      513     :
      514           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clntattr-value in g#attr-lib
      515         (input  p-obj-type
      516         ,input  p-obj-code
      517         ,input  p-code
      518         ,output p-value
      519         ,output p-type
      520         ) no-error .
      521       if error-status :error
      522       then do:
      523         undo, return error return-value .
      524       end.
      525     end.
      526   end procedure.
      527   procedure clntattr-write :
      528     define input  parameter p-obj-type like ub.clients-attr.obj-type   no-undo .
      529     define input  parameter p-obj-code like ub.clients-attr.obj-code   no-undo .
      530     define input  parameter p-code     like ub.clients-attr.attr-code  no-undo .
      531     define input  parameter p-value    like ub.clients-attr.attr-value no-undo .
      532     do
