     1107      input "get":U
     1108     ,input p-obj-type
     1109     ,input p-obj-code
     1110     ,input 'prt-obj':U
     1111     ,input  ""
     1112     ,output v-value-character
     1113     ,output v-value-date
     1114     ,output v-value-decimal
     1115     ,output v-value-integer
     1116     ,output v-value-logical
     1117     ,output par-type
     1118     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1119     ) no-error .
     1120   for each thbjattr_thbj-attr :
     1121       if thbjattr_thbj-attr.prop-code = 'outdate':U  then v-outdate  =  thbjattr_thbj-attr.property-value-character .
     1122       if thbjattr_thbj-attr.prop-code = 'outares':U  then v-outares  =  thbjattr_thbj-attr.property-value-character .
     1123       if thbjattr_thbj-attr.prop-code = 'outnum':U   then v-outnum   =  thbjattr_thbj-attr.property-value-character .
     1124       if thbjattr_thbj-attr.prop-code = 'outprim':U  then v-outprim  =  thbjattr_thbj-attr.property-value-character .
     1125       if thbjattr_thbj-attr.prop-code = 'outdisc':U  then v-outdisc  =  thbjattr_thbj-attr.property-value-character .
     1126       if thbjattr_thbj-attr.prop-code = 'outsubs':U  then v-outsubs  =  thbjattr_thbj-attr.property-value-character .
     1127       if thbjattr_thbj-attr.prop-code = 'outegrp':U  then v-outegrp  =  thbjattr_thbj-attr.property-value-character .
     1128       if thbjattr_thbj-attr.prop-code = 'outt12':U   then v-outt12   =  thbjattr_thbj-attr.property-value-character .
     1129       if thbjattr_thbj-attr.prop-code = 'outappr':U  then v-outappr  =  thbjattr_thbj-attr.property-value-character .
     1130       if thbjattr_thbj-attr.prop-code = 'outrubl':U  then v-outrubl  =  thbjattr_thbj-attr.property-value-character .
     1131       if thbjattr_thbj-attr.prop-code = 'outhold':U  then v-outhold  =  thbjattr_thbj-attr.property-value-character .
     1132       if thbjattr_thbj-attr.prop-code = 'outobj':U   then v-outobj   =  thbjattr_thbj-attr.property-value-character .
     1133       if thbjattr_thbj-attr.prop-code = 'outsend':U  then v-outsend  =  thbjattr_thbj-attr.property-value-character .
     1134       if thbjattr_thbj-attr.prop-code = 'outasend':U then v-outasend =  thbjattr_thbj-attr.property-value-character .
     1135       if thbjattr_thbj-attr.prop-code = 'outogr':U   then v-torgconf-outogr   =  thbjattr_thbj-attr.property-value-character .
     1136       if thbjattr_thbj-attr.prop-code = 'outR':U     then v-torgconf-outR     =  thbjattr_thbj-attr.property-value-character .
     1137       if thbjattr_thbj-attr.prop-code = 'outB':U     then v-torgconf-outB     =  thbjattr_thbj-attr.property-value-character .
     1138       if thbjattr_thbj-attr.prop-code = 'outssdoc':U then v-torgconf-outssdoc =  thbjattr_thbj-attr.property-value-character .
     1139       if thbjattr_thbj-attr.prop-code = 'outC':U     then v-torgconf-outC     =  thbjattr_thbj-attr.property-value-character .
     1140   end.
     1141       run gbl/conf-rd.p ("outexpas", "":U, "":U, 0, "":U, "":U, "":U, no, output v-torgconf-outexpas, output v-par-type) no-error.
     1142       if error-status :error
     1143       then do:
     1144           assign
     1145               v-torgconf-outexpas = "":U
     1146           .
     1147       end.
     1148       assign
     1149           v-torgconf-outprncd = ( v-outprncd = "yes":U )
     1150       .
     1151       if p-form-name <> ""
     1152       and p-form-name <> ?
     1153       then do:
     1154           run gbl/conf-rd.p ("outexlst" , p-host-code, p-obj-type, p-obj-code, "", "", "", no, output v-outexlst , output v-par-type) no-error.
     1155           if error-status :error
     1156           then do:
     1157               assign
     1158                   v-outexlst           = ""
     1159               .
     1160           end.
     1161           if lookup( p-form-name, v-outdate ) <> 0
     1162           then do:
     1163               assign
     1164                   v-torgconf-outdate  = yes
     1165               .
     1166           end.
     1167           if lookup( p-form-name, v-outares ) <> 0
     1168           then do:
     1169               assign
     1170                   v-torgconf-outares  = yes
     1171               .
     1172           end.
     1173           if lookup( p-form-name, v-outnum  ) <> 0
     1174           then do:
     1175               assign
     1176                   v-torgconf-outnum   = yes
     1177               .
     1178           end.
     1179           if lookup( p-form-name, v-outprim ) <> 0
     1180           then do:
     1181               assign
     1182                   v-torgconf-outprim  = yes
     1183               .
     1184           end.
     1185           if lookup( p-form-name, v-outdisc ) <> 0
     1186           then do:
     1187               assign
     1188                   v-torgconf-outdisc  = yes
     1189               .
     1190           end.
     1191           if lookup( p-form-name, v-outsubs ) <> 0
     1192           then do:
     1193               assign
     1194                   v-torgconf-outsubs  = yes
     1195               .
     1196           end.
     1197           if lookup( p-form-name, v-outrecv ) <> 0
     1198           then do:
     1199               assign
     1200                   v-torgconf-outrecv  = yes
     1201               .
     1202           end.
     1203           if lookup( p-form-name, v-outegrp ) <> 0
     1204           then do:
     1205               assign
     1206                   v-torgconf-outegrp  = yes
     1207               .
     1208           end.
     1209           if lookup( p-form-name, v-outt12  ) <> 0
     1210           then do:
     1211               assign
     1212                   v-torgconf-outt12   = yes
     1213               .
     1214           end.
     1215           if lookup( p-form-name, v-outappr  ) <> 0
     1216           then do:
     1217               assign
     1218                   v-torgconf-outappr   = yes
     1219               .
     1220           end.
     1221           if lookup( p-form-name, v-outrubl  ) <> 0
     1222           then do:
     1223               assign
     1224                   v-torgconf-outrubl   = yes
     1225               .
     1226           end.
     1227           if lookup( p-form-name, v-outhold  ) <> 0
     1228           then do:
     1229               assign
     1230                   v-torgconf-outhold   = yes
     1231               .
     1232           end.
     1233           if lookup( p-form-name, v-outobj   ) <> 0
     1234           then do:
     1235               assign
     1236                   v-torgconf-outobj    = yes
     1237               .
     1238           end.
     1239           if lookup( p-form-name, v-outsend   ) <> 0
     1240           then do:
     1241               assign
     1242                   v-torgconf-outsend    = yes
     1243               .
     1244           end.
     1245           if lookup( p-form-name, v-outasend   ) <> 0
     1246           then do:
     1247               assign
     1248                   v-torgconf-outasend    = yes
     1249               .
     1250           end.
     1251           if lookup( p-form-name, v-outprops   ) <> 0
     1252           then do:
     1253               assign
     1254                   v-torgconf-outprops    = yes
     1255               .
     1256           end.
     1257           if lookup( p-form-name, v-outexlst ) <> 0
     1258           then do:
     1259               assign
     1260                   v-torgconf-outexlst  = yes
     1261               .
     1262           end.
     1263        assign
     1264         v-name = p-form-name.
     1265   end.
     1266   end.
     1267   end procedure.
     1268   procedure torgconf-get-self-param :
     1269   define input parameter p-obj-type           as character        no-undo.
     1270   define input parameter p-obj-code           as integer          no-undo.
     1271   define input parameter p-curr-code          as integer          no-undo.
     1272       define variable v-host-code    as integer      no-undo.
     1273       define variable v-par-type     as character    no-undo.
     1274   do
     1275   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message(1))
     1276   :
     1277   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1278   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1279     (input  p-obj-type
     1280     ,input  p-obj-code
     1281     ,output v-host-code
     1282     )  .
     1283       if v-torgconf-outhold = yes
     1284       then do:
     1285           run torgconf-get-holdfirm-code in this-procedure (
     1286                 input p-obj-type
     1287               , input p-obj-code
     1288               , output v-torgconf-self-host-code
     1289           ).
     1290           if v-torgconf-self-host-code = 0
     1291           then do:
     1292               return error.
     1293           end.
     1294       end.
     1295       else do:
     1296           assign
     1297               v-torgconf-self-host-code = v-host-code
     1298           .
     1299       end.
     1300       if v-torgconf-self-host-code = 0
     1301       then do:
     1302           assign
     1303               v-torgconf-self-host-name           = "":U
     1304               v-torgconf-self-host-addres         = "":U
     1305               v-torgconf-self-host-post-addres    = "":U
     1306               v-torgconf-self-host-phone          = "":U
     1307               v-torgconf-self-host-inn            = "":U
     1308               v-torgconf-self-host-kpp            = "":U
     1309               v-torgconf-self-host-okpo           = "":U
     1310               v-torgconf-self-host-egrip-date     = "":U
     1311               v-torgconf-self-host-egrip-num      = "":U
     1312           .
     1313       end.
     1314       else do:
     1315           run fmtcli-get-client in this-procedure (
     1316                 input 'орг':U
     1317               , input v-torgconf-self-host-code
     1318           ).
     1319           assign
     1320               v-torgconf-self-host-name        = v-fmtcli-name
     1321               v-torgconf-self-host-engl-name   = v-fmtcli-engl-name
     1322               v-torgconf-self-host-addres      = v-fmtcli-full-addres
     1323               v-torgconf-self-host-post-addres = v-fmtcli-post-addres
     1324               v-torgconf-self-host-phone       = v-fmtcli-phone
     1325               v-torgconf-self-host-inn         = v-fmtcli-inn
     1326               v-torgconf-self-host-kpp         = v-fmtcli-kpp
     1327               v-torgconf-self-host-okpo        = v-fmtcli-okpo
     1328           .
     1329           run gbl/clntat-v.p (
     1330                 input 'орг':U
