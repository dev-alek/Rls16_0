     6199                                         OUTPUT g#log ).
     6200   end.
     6201   else do:
     6202     os-command silent
     6203       value( "COPY /b " +
     6204         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
     6205         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
     6206         string( session:temp-directory) +  "$" + string( g#report-num )
     6207                 ) .
