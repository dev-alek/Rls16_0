     5998             where buf_doc-line.doc-code = t-doc.doc-code
     5999             , first buf_goods no-lock
     6000             where buf_goods.artic      = buf_doc-line.artic
     6001               and buf_goods.prod-type  = buf_doc-line.prod-type
