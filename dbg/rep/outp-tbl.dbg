     6087     if prn_NP then do:
     6088       put stream out_stream Line format "X(134)" skip .
     6089       if PrintRubl then do:
     6090         display stream out_stream
     6091           sym1 sym2 sym3 sym4 "ИТОГО: " @ gds_name sym5 sym6 sym7 all-qnty @ qnty sym8 all-stoim @ stoim sym9 all-SLT-sum @ SLT-sum sym10
     6092         with frame rubl.
     6093         down stream out_stream with frame rubl .
     6094       end.
     6095       else do:
     6096         display stream out_stream
     6097           sym1 sym2 sym3 sym4 "ИТОГО: " @ gds_name sym5 sym6 sym7 all-qnty @ qnty sym8 all-stoim @ stoim sym9 all-SLT-sum @ SLT-sum sym10
     6098         with frame val.
     6099         down stream out_stream with frame val .
     6100       end.
     6101       put stream out_stream Line format "X(134)" skip .
     6102     end.
     6103     else do:
     6104       put stream out_stream Line format "X(119)" skip .
     6105       if PrintRubl then do:
     6106         display stream out_stream
     6107           sym1 sym2 sym3 sym4 "ИТОГО: " @ gds_name sym5 sym6 sym7 all-qnty @ qnty sym8 all-stoim @ stoim sym10
     6108         with frame rubl1.
     6109         down stream out_stream with frame rubl1 .
     6110       end.
     6111       else do:
     6112         display stream out_stream
     6113           sym1 sym2 sym3 sym4 "ИТОГО: " @ gds_name sym5 sym6 sym7 all-qnty @ qnty sym8 all-stoim @ stoim sym10
     6114         with frame val1.
