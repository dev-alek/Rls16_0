     6116       end.
     6117       put stream out_stream Line format "X(119)" skip .
     6118     end.
     6119     if line-counter( Out_stream ) + 12 > page-size( Out_stream ) then  page stream Out_stream .
     6120     put stream Out_stream skip space(5) "Всего " format "x(8)"  all-qnty format ">,>>>,>>9.<<<"
     6121           space(2) "единицы" format "x(8)"  space(2) ( Lines_Counter ) format ">,>>>,>>9" space(2)
     6122           "наименований" format "x(13)" skip.
     6123     if v-torgconf-outdisc = no then do:
     6124       put stream Out_stream space(5) "Скидка " format "x(8)"
     6125         ( if t-doc.tot-calc <> 0 and t-doc.discnt-pc = 0 then " " else string( string( t-doc.discnt-pc, "->>9.9" ) + "%" ) )
     6126         space(2) "на сумму"                                                        format "x(10)"
     6127         space(2) ( if not PrintRubl then t-doc.tot-calc else t-doc.discnt-rubl )   format "->>>,>>>,>>>,>>9.99"
     6128         space(2) ( if not PrintRubl then base-type else "РУБ" )                    format "x(4)" skip
     6129       .
     6130     end.
     6131     if can-do( 'факт':U , t-doc.status_ ) or
     6132        ( can-do( 'рас':U , t-doc.doc-type ) and can-do( 'накл,запрос':U , t-doc.status_ ) and
     6133        ( not t-doc.internal ) ) then do:
     6134       if not PrintRubl then run rep/wp.p ( parparentproc, all-stoim, output s1, output s2 ) .
     6135       else                  run rep/wp-rub.p ( all-stoim, output s1, output s2 ) .
     6136       if can-do( 'возврат':U , t-doc.doc-type ) then put stream Out_stream space(5) "Итого " format "x(6)" .
     6137       else                                         put stream Out_stream space(5) "Итого к оплате " format "x(17)" .
     6138       if v-torgconf-outdisc = no then put stream Out_stream "( с учетом скидки ) " format "x(22)" .
     6139       put stream Out_stream  all-stoim format "->>>,>>>,>>>,>>9.99" space(1) trim(s2) format "x(4)".
     6140       if not t-doc.internal then  do:
     6141         put stream Out_stream  skip space(5) "в том числе: " format "x(25)" skip.
     6142         put stream Out_stream string( ": Сумма  налога :   Сумма НДС   :" ) at 60 format "X(40)" skip.
     6143         for each temp-nalog break by temp-nalog.slt-prc by temp-nalog.vat-prc:
     6144           put stream Out_stream
     6145             string( "Налог с продаж" + string( temp-nalog.slt-prc, ">>9.<<%")
     6146             + string( ", НДС" + string( temp-nalog.vat-prc, ">>9.<<%") ) ) at 20 format "X(40)"
     6147             string( ":"  + string( temp-nalog.SLT-sum , "->>>,>>>,>>9.99" )
     6148             + ":"  + string( temp-nalog.VAT-sum , "->>>,>>>,>>9.99" ) + ":" ) at 60 format "X(40)"  skip
     6149           .
     6150         end.
     6151         put stream Out_stream line at 20 format "X(73)" skip string( "Итого" ) at 20 format "X(40)"
     6152           string( ":" + string( all-SLT-sum, "->>>,>>>,>>9.99" ) + ":" + string( all-VAT-sum, "->>>,>>>,>>9.99" ) + ":" ) at 60 format "X(40)" skip
     6153         .
     6154       end.
     6155       put stream Out_stream skip(1) space(10) caps(s1) format "x(126)" skip(2) .
     6156       find first buf_clients no-lock where buf_clients.obj-type = 'орг':U and buf_clients.obj-code = t-doc.host-code .
     6157       find first buf_firm    no-lock where buf_firm.firm-code = buf_clients.obj-code .
