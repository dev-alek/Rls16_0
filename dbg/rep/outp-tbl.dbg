     5950     form header
     5951       Line format "X(134)" at 1 skip  "Продолжение - на следующей странице" at 30 skip
     5952       with frame Bottomframe width 232 page-bottom no-labels no-box .
     5953     view stream Out_stream frame Bottomframe .
     5954     if can-do( 'накл':U , t-doc.status_ ) and ( not t-doc.flag_ ) then
     5955       put stream Out_stream "----------   Т Е С Т О В А Я   П Е Ч А Т Ь   ----------"  at 31 format "X(60)" skip(1) .
     5956     if v-sort-prod = "yes" then do:
     5957       if sort-gr = yes then do:
     5958         if sort-name = yes then do:
     5959           for each buf_doc-line no-lock
     5960             where buf_doc-line.doc-code = t-doc.doc-code
     5961             , first buf_goods no-lock
     5962               where buf_goods.artic      = buf_doc-line.artic
     5963                 and buf_goods.prod-type  = buf_doc-line.prod-type
     5964                 and buf_goods.prod-code  = buf_doc-line.prod-code
     5965             break by buf_doc-line.prod-type by buf_doc-line.prod-code by buf_goods.grp-name  by buf_goods.gds-name
     5966           :
     5967             if  first-of( buf_doc-line.prod-code) then do:
     5968               run print-prod in this-procedure .
     5969             end.
     5970             if  first-of( buf_goods.grp-name) then do:
     5971               run print-grp in this-procedure .
     5972             end.
     5973             run print-line in this-procedure .
     5974           end.
     5975         end.
     5976         else do:
     5977           for each buf_doc-line
     5978             where buf_doc-line.doc-code = t-doc.doc-code
     5979             , first buf_goods no-lock
     5980               where buf_goods.artic      = buf_doc-line.artic
     5981                 and buf_goods.prod-type  = buf_doc-line.prod-type
     5982                 and buf_goods.prod-code  = buf_doc-line.prod-code
     5983             break by buf_doc-line.prod-type by buf_doc-line.prod-code by buf_goods.grp-name  by buf_doc-line.num-place
     5984           :
     5985             if  first-of( buf_doc-line.prod-code) then do:
     5986               run print-prod in this-procedure .
     5987             end.
