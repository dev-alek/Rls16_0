      943   define variable v-doc-code-attr                 as character no-undo.
      944   define variable v-torgconf-doc-date-attr        as character no-undo.
      945   define variable v-torgconf-vdoc-date            as character no-undo.
      946   define variable v-torgconf-main-boss-post       as character no-undo.
      947   define variable v-torgconf-ogr-name             as character no-undo.
