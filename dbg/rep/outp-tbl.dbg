      951   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      952   procedure wthcattr-sprcli :
      953   define input parameter parparentproc  as widget-handle no-undo.
      954   define input parameter p-mode  as character no-undo.
      955   define input-output parameter p-value as character no-undo .
      956   define output parameter p-setted as logical no-undo .
      957     DEFINE VARIABLE v-value as character no-undo .
      958     define variable v-cli-type as character no-undo .
      959     define variable v-cli-code as integer no-undo .
      960     define buffer buf_clients   for ub.clients.
      961     define variable v_rid as character no-undo.
      962     define variable ref-rec as recid no-undo .
      963     do
      964     on error undo, return error
      965     :
      966         v-value = p-value.
      967      if p-value <> '':U then do:
      968       assign
      969       v-cli-type = substring(p-value, 1, 3)
      970       v-cli-code = integer(substring(p-value, 4))
      971       no-error.
      972       if error-status:error then do:
      973         assign
      974         v-cli-type = '':U
      975         v-cli-code = 0
      976         .
      977       end.
      978      end.
      979      FIND FIRST buf_clients NO-LOCK WHERE
      980               buf_clients.obj-type = v-cli-type AND
      981               buf_clients.obj-code = v-cli-code  NO-ERROR.
      982      IF available(buf_clients) then do:
      983       run ref/cli-all.w (
      984                   input parparentproc
      985                  ,input if p-mode = 'ИЗМЕНЕНИЕ':U then "b-sel":U else "":U
      986                  ,input v-cli-type
      987                  ,input 'все':U
      988                  ,input 'все':U
      989                  ,input RECID( buf_clients )
      990                  ,input ",,,,,,NO"
      991                  ,input ?
      992                  ,OUTPUT v_rid ).
      993     END.
      994     ELSE if p-mode = 'ИЗМЕНЕНИЕ':U then DO:
      995       run ref/cli-all.w (
      996                    input parparentproc
      997                   ,INPUT "b-sel":U
      998                  ,input  v-cli-type
      999                  ,input 'все':U
     1000                  ,input 'текущие':U
     1001                  ,input ?
     1002                  ,input ",,,,,,NO"
     1003                  ,input ?
     1004                  ,OUTPUT v_rid ).
     1005     END.
     1006     else do:
     1007       message
     1008       if p-value = "":U then 'Атрибут не задан!'
     1009       else substitute('Не найден клиент &1',p-value)
     1010       view-as alert-box warning.
     1011     end.
     1012     IF v_rid <> ? AND v_rid <> "":U THEN DO:
     1013       ASSIGN ref-rec = INT( v_rid ) NO-ERROR.
     1014       IF ERROR-STATUS:ERROR THEN DO:
     1015           RETURN NO-APPLY.
     1016       END.
     1017       FIND FIRST buf_clients NO-LOCK WHERE
     1018                  RECID( buf_clients ) = ref-rec NO-ERROR.
     1019       IF AVAIL buf_clients THEN DO:
     1020         v-value = buf_clients.obj-type + string(buf_clients.obj-code, ">>>>>>>>9").
     1021       end.
     1022     end.
     1023     if v-value <> p-value then do:
     1024       p-value = v-value.
     1025       p-setted = yes.
     1026     end.
     1027     end.
     1028   end procedure.
     1029     define new global shared variable g#wthcalib as handle no-undo.
     1030   procedure torgconf-read :
     1031   do
