     1608   procedure torgconf-get-sup-param :
     1609   define input parameter p-obj-type           as character        no-undo.
     1610   define input parameter p-obj-code           as integer          no-undo.
     1611   define input parameter p-curr-code          as integer          no-undo.
     1612       define variable v-host-code    as integer      no-undo.
     1613       define variable v-par-type     as character    no-undo.
     1614   do
     1615   on error undo, return error
     1616   :
     1617       assign
     1618          v-torgconf-sup-host-code = v-host-code
     1619       .
     1620       if v-torgconf-sup-host-code = 0
     1621       then do:
     1622           assign
     1623               v-torgconf-sup-host-name           = "":U
     1624               v-torgconf-sup-host-addres         = "":U
     1625               v-torgconf-sup-host-post-addres    = "":U
     1626               v-torgconf-sup-host-phone          = "":U
     1627               v-torgconf-sup-host-inn            = "":U
     1628               v-torgconf-sup-host-kpp            = "":U
     1629               v-torgconf-sup-host-okpo           = "":U
     1630               v-torgconf-sup-host-egrip-date     = "":U
     1631               v-torgconf-sup-host-egrip-num      = "":U
     1632           .
     1633       end.
     1634       else do:
     1635           run fmtcli-get-client in this-procedure (
     1636                 input 'орг':U
     1637               , input v-torgconf-sup-host-code
     1638           ).
     1639           assign
     1640               v-torgconf-sup-host-name        = v-fmtcli-name
     1641               v-torgconf-sup-host-engl-name   = v-fmtcli-engl-name
     1642               v-torgconf-sup-host-addres      = v-fmtcli-full-addres
     1643               v-torgconf-sup-host-post-addres = v-fmtcli-post-addres
     1644               v-torgconf-sup-host-phone       = v-fmtcli-phone
     1645               v-torgconf-sup-host-inn         = v-fmtcli-inn
     1646               v-torgconf-sup-host-kpp         = v-fmtcli-kpp
     1647               v-torgconf-sup-host-okpo        = v-fmtcli-okpo
     1648           .
     1649           run gbl/clntat-v.p (
     1650                 input 'орг':U
     1651               , input v-torgconf-sup-host-code
     1652               , input 'egrip-date':U
     1653               , output v-torgconf-sup-host-egrip-date
     1654               , output v-par-type
     1655           ).
     1656           run gbl/clntat-v.p (
     1657                 input 'орг':U
     1658               , input v-torgconf-sup-host-code
     1659               , input 'egrip-num':U
     1660               , output v-torgconf-sup-host-egrip-num
     1661               , output v-par-type
     1662           ).
     1663           run fmtcli-get-bank in this-procedure (
     1664                 input v-host-code
     1665               , input 'орг':U
     1666               , input v-torgconf-sup-host-code
     1667               , input p-curr-code
     1668           ).
     1669       end.
     1670       assign
     1671           v-torgconf-sup-schet-exists = v-fmtcli-schet-exists
     1672           v-torgconf-sup-bank-exists  = v-fmtcli-bank-exists
     1673           v-torgconf-sup-bank-r-schet = v-fmtcli-bank-r-schet
     1674           v-torgconf-sup-bank-c-schet = v-fmtcli-bank-c-schet
     1675           v-torgconf-sup-bank-bik     = v-fmtcli-bank-bik
     1676           v-torgconf-sup-bank-name    = v-fmtcli-bank-name
     1677           v-torgconf-sup-bank-addres  = v-fmtcli-bank-addres
     1678           v-torgconf-sup-bank-city    = v-fmtcli-bank-city
     1679       .
     1680       assign
     1681           v-torgconf-sup-obj-type = p-obj-type
     1682           v-torgconf-sup-obj-code = p-obj-code
     1683       .
     1684       if trim(p-obj-type) <> ""
     1685       and p-obj-code <> 0
     1686       then do:
     1687       run fmtcli-get-client in this-procedure (
     1688             input p-obj-type
     1689           , input p-obj-code
     1690       ).
     1691       assign
     1692           v-torgconf-sup-obj-name        = v-fmtcli-name
     1693           v-torgconf-sup-obj-engl-name   = v-fmtcli-engl-name
     1694           v-torgconf-sup-obj-addres      = v-fmtcli-full-addres
     1695           v-torgconf-temp-post-addres    = v-fmtcli-post-addres
     1696           v-torgconf-sup-obj-phone       = v-fmtcli-phone
     1697           v-torgconf-sup-obj-inn         = v-fmtcli-inn
     1698           v-torgconf-sup-obj-okpo        = v-fmtcli-okpo
     1699       .
     1700      end.
     1701      end.
     1702   end procedure.
     1703   procedure torgconf-get-cli-param :
     1704   define input parameter p-host-obj-code      as integer          no-undo.
     1705   define input parameter p-obj-type           as character        no-undo.
     1706   define input parameter p-obj-code           as integer          no-undo.
     1707   define input parameter p-curr-code          as integer          no-undo.
     1708       define variable v-host-code    as integer      no-undo.
     1709   do
     1710   on error undo, return error
     1711   :
     1712       assign
     1713           v-torgconf-cli-type = p-obj-type
     1714           v-torgconf-cli-code = p-obj-code
     1715       .
     1716       run fmtcli-get-client in this-procedure (
     1717             input p-obj-type
     1718           , input p-obj-code
     1719       ).
     1720       assign
     1721           v-torgconf-cli-name         = trim( v-fmtcli-name          )
     1722           v-torgconf-cli-engl-name    = trim( v-fmtcli-engl-name          )
     1723           v-torgconf-cli-addres       = trim( v-fmtcli-full-addres   )
     1724           v-torgconf-cli-post-addres  = trim( v-fmtcli-post-addres   )
     1725           v-torgconf-cli-phone        = trim( v-fmtcli-phone         )
     1726           v-torgconf-cli-inn          = trim( v-fmtcli-inn           )
     1727           v-torgconf-cli-kpp          = trim( v-fmtcli-kpp           )
     1728           v-torgconf-cli-okpo         = trim( v-fmtcli-okpo          )
     1729       .
     1730      run fmtcli-get-bank in this-procedure (
     1731             input p-host-obj-code
     1732           , input p-obj-type
     1733           , input p-obj-code
     1734           , input p-curr-code
     1735       ).
     1736       assign
     1737           v-torgconf-cli-schet-exists = v-fmtcli-schet-exists
     1738           v-torgconf-cli-bank-exists  = v-fmtcli-bank-exists
     1739           v-torgconf-cli-bank-r-schet = v-fmtcli-bank-r-schet
     1740           v-torgconf-cli-bank-c-schet = v-fmtcli-bank-c-schet
     1741           v-torgconf-cli-bank-bik     = v-fmtcli-bank-bik
     1742           v-torgconf-cli-bank-name    = v-fmtcli-bank-name
     1743           v-torgconf-cli-bank-addres  = v-fmtcli-bank-addres
     1744           v-torgconf-cli-bank-city    = v-fmtcli-bank-city
     1745       .
     1746   end.
     1747   end procedure.
     1748   procedure torgconf-get-ship-param :
     1749   define input parameter p-host-obj-code      as integer          no-undo.
     1750   define input parameter p-obj-type           as character        no-undo.
     1751   define input parameter p-obj-code           as integer          no-undo.
     1752   define input parameter p-curr-code          as integer          no-undo.
     1753       define variable v-host-code    as integer      no-undo.
     1754   do
     1755   on error undo, return error
     1756   :
     1757       assign
     1758           v-torgconf-ship-type = p-obj-type
     1759           v-torgconf-ship-code = p-obj-code
     1760       .
     1761       if trim(p-obj-type) = ""
     1762       and p-obj-code = 0
     1763       then do:
     1764       assign
     1765           v-torgconf-ship-name         = "":U
     1766           v-torgconf-ship-addres       = "":U
     1767           v-torgconf-ship-post-addres  = "":U
     1768           v-torgconf-ship-phone        = "":U
     1769           v-torgconf-ship-inn          = "":U
     1770           v-torgconf-ship-kpp          = "":U
     1771           v-torgconf-ship-okpo         = "":U
     1772       .
     1773       end.
     1774       else do:
     1775       run fmtcli-get-client in this-procedure (
     1776             input p-obj-type
     1777           , input p-obj-code
     1778       ).
     1779       assign
     1780           v-torgconf-ship-name         = trim( v-fmtcli-name          )
     1781           v-torgconf-ship-engl-name    = trim( v-fmtcli-engl-name          )
     1782           v-torgconf-ship-addres       = trim( v-fmtcli-full-addres   )
     1783           v-torgconf-ship-post-addres  = trim( v-fmtcli-post-addres   )
     1784           v-torgconf-ship-phone        = trim( v-fmtcli-phone         )
     1785           v-torgconf-ship-inn          = trim( v-fmtcli-inn           )
     1786           v-torgconf-ship-kpp          = trim( v-fmtcli-kpp           )
     1787           v-torgconf-ship-okpo         = trim( v-fmtcli-okpo          )
     1788       .
     1789       end.
     1790           run fmtcli-get-bank in this-procedure (
     1791             input p-host-obj-code
     1792           , input p-obj-type
     1793           , input p-obj-code
     1794           , input p-curr-code
     1795       ).
     1796       assign
     1797           v-torgconf-ship-schet-exists = v-fmtcli-schet-exists
     1798           v-torgconf-ship-bank-exists  = v-fmtcli-bank-exists
     1799           v-torgconf-ship-bank-r-schet = v-fmtcli-bank-r-schet
     1800           v-torgconf-ship-bank-c-schet = v-fmtcli-bank-c-schet
     1801           v-torgconf-ship-bank-bik     = v-fmtcli-bank-bik
     1802           v-torgconf-ship-bank-name    = v-fmtcli-bank-name
     1803           v-torgconf-ship-bank-addres  = v-fmtcli-bank-addres
     1804           v-torgconf-ship-bank-city    = v-fmtcli-bank-city
     1805       .
     1806   end.
     1807   end procedure.
     1808   procedure torgconf-get-holdfirm-code :
     1809   define input parameter p-obj-type   as character        no-undo.
     1810   define input parameter p-obj-code   as integer          no-undo.
     1811   define output parameter p-firm-code as integer          no-undo.
     1812       define variable v-firm-code-str     as character    no-undo.
     1813       define variable v-par-type          as character    no-undo.
     1814       define buffer buf_clients       for ub.clients.
     1815   do
     1816   for buf_clients
     1817   on error undo, return error
     1818   :
     1819       run gbl/clntat-v.p (
     1820             input p-obj-type
     1821           , input p-obj-code
     1822           , input 'holdfirm-code':U
     1823           , output v-firm-code-str
     1824           , output v-par-type
     1825       ).
     1826       assign
     1827           p-firm-code = integer( v-firm-code-str )
     1828       no-error.
     1829       if error-status :error
     1830       then do:
     1831           message
     1832               "Неверно задан код фирмы для печати накладных."
     1833           view-as alert-box warning.
     1834           assign
     1835               p-firm-code = 0
     1836           .
     1837       end.
     1838       else do:
     1839           find first buf_clients no-lock
     1840                where buf_clients.obj-type = 'орг':U
     1841                  and buf_clients.obj-code = p-firm-code
     1842           no-error.
     1843           if not available buf_clients
     1844           then do:
     1845               message
     1846                   "Включен параметр 'Список печатных форм, для которых должна быть задана фирма для печати накладных' (outhold)" skip
     1847                   "Не найдена фирма по заданному коду фирмы для печати накладных."
     1848               view-as alert-box warning.
     1849               assign
     1850                   p-firm-code = 0
     1851               .
     1852           end.
     1853       end.
     1854   end.
     1855   end procedure.
     1856   procedure torgconf-get-post-head:
     1857   define input  parameter p-obj-type             as character        no-undo.
     1858   define input  parameter p-obj-code             as integer          no-undo.
     1859   define output parameter p-torgconf-post-head   as character        no-undo.
     1860      define variable v-host-code         as integer      no-undo.
     1861      define buffer buf_sysconf     for ub.sysconf.
     1862        assign
     1863         p-torgconf-post-head  = ""
     1864        .
     1865   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1866   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1867     (input  p-obj-type
     1868     ,input  p-obj-code
     1869     ,output v-host-code
     1870     )  .
     1871      find first buf_sysconf no-lock
     1872      where buf_sysconf.host-code = v-host-code
     1873      no-error.
     1874      if available buf_sysconf
     1875      then do:
     1876         assign
     1877            p-torgconf-post-head = buf_sysconf.head-position
     1878         .
     1879      end.
     1880   end procedure.
     1881   procedure torgconf-get-storekeeper:
     1882   define input  parameter p-wrkr                   as integer          no-undo.
     1883   define output parameter p-torgconf-wrkr-name     as character        no-undo.
     1884   define output parameter p-torgconf-post          as character        no-undo.
     1885      define buffer buf_sysconf     for ub.sysconf.
     1886      define buffer buf_person      for ub.person.
     1887      define buffer buf_shop        for ub.shop .
     1888      define buffer buf_store       for ub.store .
     1889      if v-torgconf-outC = "no_print"
     1890      then do:
     1891         assign p-torgconf-post = ""
     1892                p-torgconf-wrkr-name = ""
     1893                .
     1894      end.
     1895      if v-torgconf-outC = "clad_doc"
     1896      then do:
     1897         run rep/get-psn.p
     1898               (input  p-wrkr
     1899               ,output p-torgconf-wrkr-name
     1900               ) .
     1901         find first buf_person no-lock
     1902         where buf_person.psn-code = p-wrkr
     1903         no-error.
     1904         if available buf_person
     1905         then do:
     1906           p-torgconf-post = buf_person.position.
     1907         end.
     1908         if p-torgconf-post = "?":U then p-torgconf-post = "".
     1909         if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     1910      end.
     1911      if v-torgconf-outC = "clad_obj"
     1912      then do:
     1913         CASE v-torgconf-self-obj-type:
     1914         WHEN 'маг':U
     1915         THEN DO:
     1916            find first buf_shop no-lock
     1917            where buf_shop.obj-code = v-torgconf-self-obj-code
     1918            .
     1919            assign
     1920               p-torgconf-wrkr-name = buf_shop.store-man
     1921               p-torgconf-post = ""
     1922            .
     1923            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     1924         END.
     1925         WHEN 'скл':U
     1926         THEN DO:
     1927            find first buf_store no-lock
     1928            where buf_store.obj-code = v-torgconf-self-obj-code
     1929            .
     1930            assign
     1931               p-torgconf-wrkr-name = buf_store.store-man
     1932               p-torgconf-post = ""
     1933            .
     1934            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     1935         END.
     1936         OTHERWISE DO:
     1937            assign
     1938               p-torgconf-post = "":U
     1939               p-torgconf-wrkr-name = "":U
     1940            .
     1941         END.
     1942         END CASE.
     1943      end.
     1944    end procedure.
     1945   procedure torgconf-get-form-header :
     1946   define input parameter p-for-inverse    as logical          no-undo.
     1947   define input parameter p-doc-code       as character        no-undo.
     1948   define input parameter p-print-doc      as logical          no-undo.
     1949   define input parameter p-doc-date       as date             no-undo.
     1950   define input parameter p-fact-date      as date             no-undo.
     1951   define input parameter p-doc-type       as character        no-undo.
     1952   define input parameter p-status_        as character        no-undo.
     1953   define input parameter p-reverse        as logical          no-undo.
     1954   define input parameter p-sf-par         as logical          no-undo.
     1955       define variable v-attr-type         as character    no-undo.
     1956       define variable v-doc-code-standard as logical      no-undo.
     1957       define variable v-doc-date-standard as logical      no-undo.
     1958       define variable v-par-consignee-addres  as character    no-undo.
     1959       define variable v-host-code         as integer      no-undo.
     1960       define variable v-dcode-attr        as character    no-undo.
     1961       define variable v-ddate-attr        as character    no-undo.
     1962       define variable v-doc-date          as character    no-undo.
     1963       define variable v-doc-code          as character    no-undo.
     1964       define variable v-par-type          as character    no-undo.
     1965       define variable v-attr              as character    no-undo.
     1966       define buffer buf_firm          for ub.firm .
     1967       define buffer buf_clients       for ub.clients .
     1968       define buffer buf_sysconf       for ub.sysconf .
     1969       define buffer buf_shop          for ub.shop .
     1970       define buffer buf_store         for ub.store .
     1971       define buffer buf_person        for ub.person .
     1972       define buffer buf_trn-doc       for ub.trn-doc .
     1973       define buffer buf_wth-doc       for ub.wth-doc .
     1974       do
     1975   for buf_firm
     1976     , buf_clients
     1977     , buf_sysconf
     1978     , buf_shop
     1979     , buf_trn-doc
     1980     , buf_person
     1981     , buf_wth-doc
     1982   on error undo, return error
     1983   :
     1984       if p-doc-type = 'при':U
     1985       or p-doc-type = 'возврат':U
     1986       then do:
     1987           assign
     1988               v-torgconf-supplier         = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     1989                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     1990               v-torgconf-suppi            = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     1991                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     1992               v-torgconf-saler            = substitute( "&1&2&3&4&5", v-torgconf-self-host-name, ( if v-torgconf-self-host-addres = "":U then "":U else ", " ),
     1993                                             v-torgconf-self-host-addres, ( if v-torgconf-self-host-phone = "":U then "":U else ", " ),v-torgconf-self-host-phone )
     1994               v-torgconf-consignee        = substitute( "&1&2&3&4&5", v-torgconf-sup-host-name, ( if v-torgconf-sup-host-addres = "":U then "":U else ", " ),
     1995                                             v-torgconf-sup-host-addres, ( if v-torgconf-sup-host-phone = "":U then "":U else ", " ), v-torgconf-sup-host-phone  )
     1996               v-torgconf-supplier-okpo    = v-torgconf-cli-okpo
     1997               v-torgconf-saler-okpo       = v-torgconf-self-host-okpo
     1998               v-torgconf-consignee-okpo   = v-torgconf-sup-host-okpo
     1999               v-torgconf-supplier-code    = substitute( "&1", v-torgconf-cli-code         )
     2000               v-torgconf-supplier-type    = v-torgconf-cli-type
     2001               v-torgconf-saler-code       = substitute( "&1", v-torgconf-self-host-code   )
     2002               v-torgconf-saler-type       = v-torgconf-self-host-type
     2003               v-torgconf-consignee-code   = substitute( "&1", v-torgconf-sup-host-code   )
     2004               v-torgconf-consignee-type   = v-torgconf-sup-host-type
     2005               v-torgconf-supplier-name    = substitute( "&1", v-torgconf-cli-name         )
     2006               v-torgconf-saler-name       = substitute( "&1", v-torgconf-self-host-name   )
     2007               v-torgconf-consignee-name   = substitute( "&1", v-torgconf-sup-host-name   )
     2008               v-torgconf-supplier-addr    = substitute( "&1", v-torgconf-cli-addres       )
     2009               v-torgconf-saler-addr       = substitute( "&1", v-torgconf-self-host-addres )
     2010               v-torgconf-consignee-addr   = substitute( "&1", v-torgconf-sup-host-addres )
     2011               v-torgconf-supplier-inn     = substitute( "&1", v-torgconf-cli-inn          )
     2012               v-torgconf-supplier-engl-name     = substitute( "&1", v-torgconf-cli-engl-name          )
     2013               v-torgconf-saler-inn        = substitute( "&1", v-torgconf-self-host-inn    )
     2014               v-torgconf-consignee-inn    = substitute( "&1", v-torgconf-sup-host-inn    )
     2015               v-torgconf-supplier-kpp     = substitute( "&1", v-torgconf-cli-kpp          )
     2016               v-torgconf-saler-kpp        = substitute( "&1", v-torgconf-self-host-kpp    )
     2017               v-torgconf-consignee-kpp    = substitute( "&1", v-torgconf-sup-host-kpp    )
     2018           .
     2019           if v-torgconf-cli-schet-exists = yes
     2020           AND v-form-name                  = "torg12":U
     2021           then do:
     2022               assign
     2023                   v-torgconf-supplier = v-torgconf-supplier
     2024                       + substitute( ", р/с &1 к/с &2"
     2025                                   , v-torgconf-cli-bank-r-schet
     2026                                   , v-torgconf-cli-bank-c-schet
     2027                                   )
     2028                   v-torgconf-suppi = v-torgconf-supplier
     2029                       + substitute( ", р/с &1 к/с &2"
     2030                                   , v-torgconf-cli-bank-r-schet
     2031                                   , v-torgconf-cli-bank-c-schet
     2032                                   )
     2033               .
     2034               if v-torgconf-cli-bank-exists = yes
     2035               then do:
     2036                   assign
     2037                       v-torgconf-supplier = v-torgconf-supplier
     2038                           + substitute( " БИК &1 в &2 &3"
     2039                                       , v-torgconf-cli-bank-bik
     2040                                       , v-torgconf-cli-bank-name
     2041                                       ,(if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     2042                                       )
     2043                      v-torgconf-suppi = v-torgconf-supplier
     2044                           + substitute( " БИК &1 в &2 &3"
     2045                                       , v-torgconf-cli-bank-bik
     2046                                       , v-torgconf-cli-bank-name
     2047                                       ,(if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     2048                                       )
     2049                   .
     2050               end.
     2051           end.
     2052           if v-torgconf-self-schet-exists = yes
     2053           AND v-form-name                  = "torg12":U
     2054           then do:
     2055               assign
     2056                   v-torgconf-saler = v-torgconf-saler
     2057                       + substitute( ", р/с &1 к/с &2"
     2058                                   , v-torgconf-self-bank-r-schet
     2059                                   , v-torgconf-self-bank-c-schet
     2060                                   )
     2061               .
     2062               if v-torgconf-self-bank-exists = yes
     2063               then do:
     2064                   assign
     2065                       v-torgconf-saler = v-torgconf-saler
     2066                           + substitute( " БИК &1 в &2 &3"
     2067                                       , v-torgconf-self-bank-bik
     2068                                       , v-torgconf-self-bank-name
     2069                                       , v-torgconf-self-bank-addres
     2070                                       )
     2071                   .
     2072               end.
     2073           end.
     2074           if v-torgconf-sup-schet-exists = yes
     2075           AND v-form-name                  = "torg12":U
     2076           then do:
     2077               assign
     2078                   v-torgconf-consignee = v-torgconf-consignee
     2079                       + substitute( ", р/с &1 к/с &2"
     2080                                   , v-torgconf-sup-bank-r-schet
     2081                                   , v-torgconf-sup-bank-c-schet
     2082                                   )
     2083               .
     2084             if v-torgconf-sup-bank-exists = yes
     2085              then do:
     2086                assign
     2087                   v-torgconf-consignee = v-torgconf-consignee
     2088                           + substitute( " БИК &1 в &2 &3"
     2089                                       , v-torgconf-sup-bank-bik
     2090                                       , v-torgconf-sup-bank-name
     2091                                       , v-torgconf-sup-bank-addres
     2092                                       )
     2093                   .
     2094               end.
     2095           end.
     2096      if v-torgconf-outares = yes  AND v-form-name  = "torg12":U
     2097      then do:
     2098          assign
     2099            v-torgconf-supplier = substitute(  "&1&2&3 &4 &5&6"
     2100                                                   , IF v-form-name = "torg12":U THEN SUBSTITUTE("ИНН &1 КПП &2 ", v-torgconf-cli-inn, v-torgconf-cli-kpp) ELSE "":U
     2101                                                   , v-torgconf-cli-name
     2102                                                   , ( if v-torgconf-outprncd = yes
     2103                                                         then substitute( " (&1)", v-torgconf-cli-code )
     2104                                                         else "":U )
     2105                                                   , v-torgconf-cli-post-addres
     2106                                                   , v-torgconf-cli-phone
     2107                                                   , ( if v-torgconf-cli-bank-r-schet <> "":U
     2108                                                       AND v-form-name                  = "torg12":U
