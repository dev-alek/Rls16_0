     1059       define variable v-outB      as character     no-undo.
     1060       define variable v-outC      as character     no-undo.
     1061       assign
     1062           v-torgconf-outdate  = no
     1063           v-torgconf-outnum   = no
     1064           v-torgconf-outprim  = no
     1065           v-torgconf-outdisc  = no
     1066           v-torgconf-outsubs  = no
     1067           v-torgconf-outrecv  = no
     1068           v-torgconf-outegrp  = no
     1069           v-torgconf-outt12   = no
     1070           v-torgconf-outappr  = no
     1071           v-torgconf-outrubl  = no
     1072           v-torgconf-outhold  = no
     1073           v-torgconf-outobj   = no
     1074           v-torgconf-outexlst = no
     1075           v-torgconf-outexpas = "":U
     1076           v-torgconf-outprncd = yes
     1077           v-torgconf-outares  = no
     1078           v-torgconf-outsend  = no
     1079           v-torgconf-outasend  = no
     1080           v-torgconf-outprops  = no
     1081           v-form-name          = p-form-name
     1082       .
     1083   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1084   empty temp-table thbjattr_thbj-attr.
     1085   run adm/shattri.p (
     1086      input "get":U
     1087     ,input ''
     1088     ,input 0
     1089     ,input 'prt-glob':U
     1090     ,input  ""
     1091     ,output v-value-character
     1092     ,output v-value-date
     1093     ,output v-value-decimal
     1094     ,output v-value-integer
     1095     ,output v-value-logical
     1096     ,output par-type
     1097     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1098     ) no-error .
     1099   for each thbjattr_thbj-attr :
     1100       if thbjattr_thbj-attr.prop-code = 'outprncd':U then v-outprncd =  string(thbjattr_thbj-attr.property-value-logical) .
     1101       if thbjattr_thbj-attr.prop-code = 'outrecv':U  then v-outrecv  =  thbjattr_thbj-attr.property-value-character .
