     3457               find first buf_sysconf no-lock
     3458               where buf_sysconf.host-code = v-host-code
     3459               no-error.
     3460               if available buf_sysconf
     3461               then do:
     3462                  assign
     3463                     v-torgconf-ogr-post = buf_sysconf.head-position
     3464                  .
     3465               end.
     3466               find first buf_clients no-lock
     3467                  where buf_clients.obj-type = 'орг':U
     3468                  and buf_clients.obj-code = v-host-code
     3469               .
     3470               find first buf_firm no-lock
     3471                  where buf_firm.firm-code = buf_clients.obj-code
     3472               .
     3473               assign
     3474                  v-torgconf-ogr-name = buf_firm.director
     3475               .
     3476            end.
     3477            if v-torgconf-outogr = "dir_obj"
     3478               then do:
     3479               find first buf_wth-doc no-lock
     3480               where buf_wth-doc.doc-code = p-doc-code
     3481               no-error.
     3482                  find first buf_shop no-lock
     3483                  where buf_shop.obj-code = buf_wth-doc.obj-code
     3484                  .
     3485                  assign
     3486                     v-torgconf-ogr-name = buf_shop.director
     3487                     v-torgconf-ogr-post = "Директор"
     3488                  .
     3489               end.
     3490         if v-torgconf-outogr = "manag_doc"
     3491            then do:
     3492               find first buf_wth-doc no-lock
     3493               where buf_wth-doc.doc-code = p-doc-code
     3494               no-error.
     3495               if available buf_wth-doc
     3496               then do:
     3497                  run rep/get-psn.p
     3498                  (input buf_wth-doc.deliver
     3499                  ,output v-torgconf-ogr-name
     3500                  ) .
     3501               end.
     3502               find first buf_person no-lock
     3503               where buf_person.psn-code = buf_wth-doc.deliver
     3504               no-error.
     3505               if available buf_person
     3506               then do:
     3507                  v-torgconf-ogr-post = buf_person.position.
     3508               end.
     3509               if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     3510               if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     3511            end.
     3512      end.
     3513   end.
     3514   end procedure.
     3515   procedure torgconf-get-outogr-param:
     3516       define input parameter p-form-name  as character    no-undo.
     3517       define input parameter p-host-code  as integer      no-undo.
     3518       define input parameter p-obj-type   as character    no-undo.
     3519       define input parameter p-obj-code   as integer      no-undo.
     3520       define input parameter p-doc-code   as character      no-undo.
     3521       define buffer buf_firm          for ub.firm .
     3522       define buffer buf_clients       for ub.clients .
     3523       define buffer buf_sysconf       for ub.sysconf .
     3524       define buffer buf_shop          for ub.shop .
     3525       define buffer buf_store         for ub.store .
     3526       define buffer buf_person        for ub.person .
     3527       define buffer buf_trn-doc       for ub.trn-doc .
     3528       define buffer buf_wth-doc       for ub.wth-doc .
     3529      if  p-form-name <> 'wthtrg12':U
     3530      and p-form-name <> 'wthfct':U
     3531      and p-form-name <> 'wthm11':U
     3532      then do:
     3533       find first buf_trn-doc no-lock
     3534       where buf_trn-doc.doc-code = p-doc-code
     3535       no-error.
     3536       if v-torgconf-outogr = "no_print"
     3537         then do:
     3538            assign
     3539               v-torgconf-ogr-name = ""
     3540               v-torgconf-ogr-post = ""
     3541            .
     3542         end.
     3543      if v-torgconf-outogr  = "ruk_firm"
     3544            then do:
     3545            find first buf_sysconf no-lock
     3546            where buf_sysconf.host-code = p-host-code
     3547            no-error.
     3548            if available buf_sysconf
     3549            then do:
     3550               assign
     3551                  v-torgconf-ogr-post = buf_sysconf.head-position
     3552               .
     3553            end.
     3554            find first buf_clients no-lock
     3555                where buf_clients.obj-type = 'орг':U
     3556                and buf_clients.obj-code = p-host-code
     3557            .
     3558            find first buf_firm no-lock
     3559                where buf_firm.firm-code = buf_clients.obj-code
     3560            .
     3561            assign
     3562                v-torgconf-ogr-name = buf_firm.director
     3563            .
     3564         end.
     3565         if v-torgconf-outogr = "dir_obj"
     3566            then do:
     3567            find first buf_trn-doc no-lock
     3568            where buf_trn-doc.doc-code = p-doc-code
     3569            no-error.
     3570               CASE buf_trn-doc.obj-type:
     3571               WHEN 'маг':U
     3572               THEN DO:
     3573                  find first buf_shop no-lock
     3574                  where buf_shop.obj-code = buf_trn-doc.obj-code
     3575                  .
     3576                  assign
     3577                     v-torgconf-ogr-name = buf_shop.director
     3578                     v-torgconf-ogr-post = "Директор"
     3579                  .
     3580               END.
     3581               WHEN 'скл':U
     3582               THEN DO:
     3583                  find first buf_store no-lock
     3584                  where buf_store.obj-code = buf_trn-doc.obj-code
     3585                  .
     3586                  assign
     3587                     v-torgconf-ogr-name = buf_store.store-boss
     3588                     v-torgconf-ogr-post = "Директор"
     3589                  .
     3590               END.
     3591               OTHERWISE DO:
     3592                  assign
     3593                     v-torgconf-ogr-name = "":U
     3594                     v-torgconf-ogr-post = "":U
     3595                  .
     3596               END.
     3597               END CASE.
     3598            end.
     3599      if v-torgconf-outogr = "manag_doc"
     3600         then do:
     3601            find first buf_trn-doc no-lock
     3602            where buf_trn-doc.doc-code = p-doc-code
     3603            no-error.
     3604            if available buf_trn-doc
     3605            then do:
     3606               run rep/get-psn.p
     3607               (input buf_trn-doc.boss
     3608               ,output v-torgconf-ogr-name
     3609               ) .
     3610            end.
     3611            find first buf_person no-lock
     3612            where buf_person.psn-code = buf_trn-doc.boss
     3613            no-error.
     3614            if available buf_person
     3615            then do:
     3616               v-torgconf-ogr-post = buf_person.position.
     3617            end.
     3618            if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     3619            if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     3620         end.
     3621      end.
     3622      else do:
     3623      find first buf_wth-doc no-lock
     3624         where buf_wth-doc.doc-code = p-doc-code
     3625         no-error.
     3626         if v-torgconf-outogr = "no_print"
     3627            then do:
     3628               assign
     3629                  v-torgconf-ogr-name = ""
     3630                  v-torgconf-ogr-post = ""
     3631               .
     3632            end.
     3633         if v-torgconf-outogr  = "ruk_firm"
     3634               then do:
     3635               find first buf_sysconf no-lock
     3636               where buf_sysconf.host-code = p-host-code
     3637               no-error.
     3638               if available buf_sysconf
     3639               then do:
     3640                  assign
     3641                     v-torgconf-ogr-post = buf_sysconf.head-position
     3642                  .
     3643               end.
     3644               find first buf_clients no-lock
     3645                  where buf_clients.obj-type = 'орг':U
     3646                  and buf_clients.obj-code = p-host-code
     3647               .
     3648               find first buf_firm no-lock
     3649                  where buf_firm.firm-code = buf_clients.obj-code
     3650               .
     3651               assign
     3652                  v-torgconf-ogr-name = buf_firm.director
     3653               .
     3654            end.
     3655            if v-torgconf-outogr = "dir_obj"
     3656               then do:
     3657               find first buf_wth-doc no-lock
     3658               where buf_wth-doc.doc-code = p-doc-code
     3659               no-error.
     3660                  find first buf_shop no-lock
     3661                  where buf_shop.obj-code = buf_wth-doc.obj-code
     3662                  .
     3663                  assign
     3664                     v-torgconf-ogr-name = buf_shop.director
     3665                     v-torgconf-ogr-post = "Директор"
     3666                  .
     3667               end.
     3668         if v-torgconf-outogr = "manag_doc"
     3669            then do:
     3670               find first buf_wth-doc no-lock
     3671               where buf_wth-doc.doc-code = p-doc-code
     3672               no-error.
     3673               if available buf_wth-doc
     3674               then do:
     3675                  run rep/get-psn.p
     3676                  (input buf_wth-doc.deliver
     3677                  ,output v-torgconf-ogr-name
     3678                  ) .
     3679               end.
     3680               find first buf_person no-lock
     3681               where buf_person.psn-code = buf_wth-doc.deliver
     3682               no-error.
     3683               if available buf_person
     3684               then do:
     3685                  v-torgconf-ogr-post = buf_person.position.
     3686               end.
     3687               if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     3688               if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     3689            end.
     3690      end.
     3691   end.
     3692   procedure torgconf-get-reason  :
     3693   define input parameter  p-doc-code       as character        no-undo.
     3694   define input parameter  p-reason-code    as integer          no-undo .
     3695   define input parameter  p-doc-type       as character        no-undo.
     3696       if p-reason-code > 0
     3697       then do:
     3698           define buffer buf_trn-reason for ub.trn-reason.
     3699           find first buf_trn-reason no-lock where buf_trn-reason.reason-code = p-reason-code no-error .
     3700           if available buf_trn-reason then assign v-torgconf-reason =  buf_trn-reason.reason-name .
     3701       end.
     3702       else do:
     3703           if p-doc-type = 'при':U
     3704           then  do:
     3705               define variable v-attr-type     as character    no-undo.
     3706               define variable v-attr-value    as character    no-undo.
     3707               run gbl/trdcat-v.p (input p-doc-code,input 'nids':U,output v-attr-value,output v-attr-type) .
     3708               assign v-torgconf-reason = v-attr-value .
     3709               run gbl/trdcat-v.p (input p-doc-code,input 'dids':U,output v-attr-value,output v-attr-type) .
     3710               assign v-torgconf-reason = v-torgconf-reason + " от " + v-attr-value .
     3711           end.
     3712       end.
     3713   end procedure.
