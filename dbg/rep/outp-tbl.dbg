     5897           sym8 column-label ":!:" format "X(1)" space(0)
     5898           stoim column-label "Стоимость!(РУБ) " format "->>>,>>>,>>>,>>9.99" space(0)
     5899           sym9 column-label ":!:" format "X(1)" space(0)
     5900           SLT-sum column-label "Сумма налога!с продаж (РУБ)" format "->>>>>>>>>9.99" space(0)
     5901           sym10 column-label ":!:" format "X(1)" space(0)
     5902       header
     5903           string( "Дата печати : " + string(TODAY,"99.99.9999") +  " , " + string(TIME, "HH:MM") ) at 5 format "X(35)"
     5904           tdoc-code at 70 format "X(10)" " от " v-doc-date-string format "X(10)"
     5905           string( "Страница " + string( PAGE-NUMBER( Out_stream ), ">>9" ) ) at 110 format "X(13)" skip
     5906           Line format "X(134)" at 1
     5907     with width 232 down stream-io.
     5908     define variable v-host-code  as integer   no-undo.
     5909     define variable v-exch-rate  as decimal   no-undo .
     5910     define variable v-exch-scale as decimal   no-undo .
     5911     define variable base-code    as integer   no-undo .
     5912     define variable base-type    as character no-undo.
     5913   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5914   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     5915     (input  t-doc.obj-type
     5916     ,input  t-doc.obj-code
     5917     ,output v-host-code
     5918     )  .
     5919   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5920   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     5921     (input  v-host-code
     5922     ,output base-code
     5923     )  .
     5924   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5925   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     5926     (input  base-code
     5927     ,input  today
     5928     ,output v-exch-rate
     5929     ,output v-exch-scale
     5930     ,output base-type
     5931     )  .
     5932     run torgconf-read in this-procedure ( input p-form-name, input v-host-code, input t-doc.obj-type, input t-doc.obj-code) no-error.
     5933     if error-status :error then do:
     5934       message  vss-workfile vss-revision vss-description skip "Ошибка чтения параметров печати формы."
     5935         skip "Форма будет напечатана с параметрами по умолчанию."  skip return-value
     5936         skip trim(error-status :get-message(1))  trim(error-status :get-message(2))  trim(error-status :get-message(3))
     5937       view-as alert-box error.
     5938     end.
     5939     if session:set-wait-state("compiler") then.
     5940     assign
     5941       Line = fill( "-", 232 )
     5942       Lines_Counter = 0
     5943     .
     5944     if v-torgconf-outnum = yes then  assign tdoc-code = fill( " ", 10 ) .
     5945     else                             assign tdoc-code = t-doc.doc-code .
