     6970                     </tr>
     6971                     <tr> 
     6972                       <td colspan="8"> СМЕНУ ПРИНЯЛ: </td>
     6973                     </tr>
     6974               </tfoot>
     6975           </table>
     6976           '
     6977            ,
     6978            rep-shift-for-mng-next
     6979            ).
     6980         put stream OutStr-html unformatted
     6981            substitute (
     6982            '
     6983           </body>
     6984           </html>
     6985           '
     6986            , chr(123), chr(125)
     6987            ).
     6988         output stream OutStr-html close.
     6989      end.
     6990      else
