     1759   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1760   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1761   def var vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1762   procedure gen-key-rec :
     1763     define input  parameter p-tbl-name    as character no-undo.
     1764     define input  parameter p-bh_tbl-name as handle    no-undo.
     1765     define output parameter p-key-rec     as character no-undo.
     1766     do
     1767     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1768     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     1769     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     1770     :
     1771       define variable fh               as handle    no-undo .
     1772       define variable v-ok             as logical   no-undo .
     1773       define variable v-inform         as character no-undo .
     1774       define variable v-ind            as integer   no-undo .
     1775       define variable v-idx-field-qnty as integer   no-undo .
     1776       if p-tbl-name = ?
     1777         or p-tbl-name = "":U
     1778       then do:
     1779         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info26 ).
     1780       end.
     1781       if not p-bh_tbl-name:available then do:
     1782         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info26, p-tbl-name ).
     1783       end.
     1784       assign
     1785         p-key-rec = p-tbl-name
     1786         v-inform  = p-bh_tbl-name:index-information(1)
     1787         v-ind     = 2
     1788       .
     1789       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1790       on error undo, return error
     1791       :
     1792         assign
     1793           v-inform = p-bh_tbl-name:index-information( v-ind )
     1794           v-ind    = v-ind + 1
     1795         .
     1796       end.
     1797       if v-inform = ?
     1798         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1799         or entry( 3, v-inform, ",":U ) <> "1":U
     1800       then do:
     1801         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info26, p-tbl-name ).
     1802       end.
     1803       else do:
     1804         assign
     1805           v-idx-field-qnty = num-entries( v-inform ) - 4
     1806         .
     1807         if v-idx-field-qnty < 2 then do:
     1808           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info26, v-inform, p-tbl-name ).
     1809         end.
     1810         do v-ind = 1 to v-idx-field-qnty by 2
     1811         on error undo, return error
     1812         :
     1813           assign
     1814             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     1815             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     1816           .
     1817         end.
     1818       end.
     1819       if p-key-rec = ? then do:
     1820         assign
     1821           p-key-rec = "":U
     1822         .
     1823         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info26, p-tbl-name ).
     1824       end.
     1825     end.
     1826     return.
     1827   end procedure.
     1828   procedure gen-where-keyr-tab :
     1829     define input  parameter i-tableSerach as character no-undo.
     1830     define input  parameter i-tablekey   as character  no-undo.
     1831     define input  parameter p-key-rec    as character  no-undo.
     1832     define input  parameter p-key-handle as handle     no-undo .
     1833     define input  parameter p-db-name    as character  no-undo .
     1834     define input  parameter p-tt-handle  as handle     no-undo .
     1835     define output parameter o-Where      as character  no-undo.
     1836     do
     1837     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1838     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1839     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     1840     :
     1841       define variable v-full-tbl-name  as character no-undo .
     1842       define variable bh_tbl-name      as handle    no-undo .
     1843       define variable fh_key           as handle    no-undo .
     1844       define variable fh_search        as handle    no-undo .
     1845       define variable v-field-num      as integer   no-undo .
     1846       define variable v-count-fld      as integer   no-undo .
     1847       define variable v-inform         as character no-undo .
     1848       define variable v-ind            as integer   no-undo .
     1849       define variable v-idx-field-qnty as integer   no-undo .
     1850       define variable v-field-name     as character no-undo .
     1851       define variable v-field-val      as character no-undo .
     1852       define variable v-word-link      as character no-undo .
     1853       define variable vTable           as character no-undo.
     1854       define variable bh_tbl-key       as handle    no-undo .
     1855       assign
     1856         p-key-rec = trim( p-key-rec )
     1857       .
     1858       if p-key-handle <> ? then do:
     1859         if not valid-handle(p-key-handle)
     1860            or p-key-handle:type <> "buffer"
     1861         then do:
     1862           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info26 ).
     1863         end.
     1864         if num-entries( p-key-rec, chr(3) ) > 1
     1865           or p-key-rec = ?
     1866           or p-key-rec = "":U
     1867         then do:
     1868           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info26, p-key-rec ).
     1869         end.
     1870       end.
     1871       else do:
     1872         if p-key-rec = ?
     1873           or p-key-rec = "":U
     1874         then do:
     1875           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info26 ).
     1876         end.
     1877       end.
     1878       assign
     1879         vTable = entry( 1 , p-key-rec, chr(3) )
     1880       .
     1881       if p-tt-handle <> ?
     1882         and ( not valid-handle(p-tt-handle)
     1883               or p-tt-handle:type <> "buffer"
     1884             )
     1885       then do:
     1886         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info26, vTable, chr(10) ).
     1887       end.
     1888       if p-tt-handle = ? then do:
     1889         assign
     1890           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     1891         .
     1892         create buffer bh_tbl-name for table v-full-tbl-name .
     1893       end.
     1894       else do:
     1895         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1896       end.
     1897       assign
     1898         v-inform = bh_tbl-name:index-information(1)
     1899         v-ind    = 2
     1900       .
     1901       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1902       on error undo, return error
     1903       :
     1904         assign
     1905           v-inform = bh_tbl-name:index-information( v-ind )
     1906           v-ind    = v-ind + 1
     1907         .
     1908       end.
     1909       if v-inform = ?
     1910         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1911         or entry( 3, v-inform, ",":U ) <> "1":U
     1912       then do:
     1913         delete object bh_tbl-name no-error.
     1914         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info26, vTable ).
     1915       end.
     1916       assign
     1917         v-idx-field-qnty = num-entries( v-inform ) - 4
     1918       .
     1919       if v-idx-field-qnty < 2 then do:
     1920         delete object bh_tbl-name no-error.
     1921         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info26, v-inform, vTable ).
     1922       end.
     1923       assign
     1924         o-where     = "where":U
     1925         v-word-link = "":U
     1926         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     1927         v-count-fld = 0
     1928       .
     1929       if i-tablekey ne "" and i-tablekey ne ?
     1930       then do:
     1931         assign
     1932           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     1933         .
     1934         create buffer bh_tbl-key for table v-full-tbl-name .
     1935       end.
     1936       if i-tableSerach ne "" and i-tableSerach ne ?
     1937       then do:
     1938         delete object bh_tbl-name no-error.
     1939         assign
     1940           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     1941         .
     1942         create buffer bh_tbl-name for table v-full-tbl-name .
     1943       end.
     1944       block_where:
     1945       do v-ind = 1 to v-idx-field-qnty by 2
     1946       on error undo, return error
     1947       :
     1948         assign
     1949           v-count-fld = v-count-fld + 1
     1950         .
     1951         if p-key-handle = ?
     1952           and v-count-fld > v-field-num
     1953         then do:
     1954           leave block_where.
     1955         end.
     1956         define variable VfieldKeyTable as handle no-undo.
     1957         assign
     1958           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1959           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     1960         .
     1961         if     bh_tbl-key ne ?
     1962         then do:
     1963            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     1964            if VfieldKeyTable eq ?
     1965            then next block_where.
     1966         end.
     1967         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     1968         then
     1969            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     1970         else
     1971            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     1972         if p-key-handle = ? then do:
     1973           assign
     1974             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     1975           .
     1976         end.
     1977         else do:
     1978           assign
     1979             fh_key = p-key-handle:buffer-field( v-field-name )
     1980           .
     1981           if fh_key = ?
     1982             or not valid-handle( fh_key )
     1983           then do:
     1984             delete object bh_tbl-name.
     1985             if     bh_tbl-key ne ?
     1986             then
     1987                delete object bh_tbl-key.
     1988             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info26, p-key-handle:name, v-field-name ).
     1989           end.
     1990           assign
     1991             v-field-val = fh_key:buffer-value
     1992           .
     1993         end.
     1994         if fh_search:data-type ="character":U then do:
     1995           assign
     1996             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     1997             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     1998             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     1999             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     2000             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     2001             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     2002             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     2003             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     2004             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     2005             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     2006             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     2007             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     2008             v-field-val = substitute( '"&1"', v-field-val )
     2009           .
     2010         end.
     2011         assign
     2012           o-where = substitute( "&1 &2", o-where, v-field-val )
     2013         .
     2014         if v-word-link = "":U then do:
     2015           assign
     2016             v-word-link = "and":U
     2017           .
     2018         end.
     2019       end.
     2020       delete object bh_tbl-name.
     2021       if     bh_tbl-key ne ?
     2022       then
     2023          delete object bh_tbl-key.
     2024       if p-key-handle = ?
     2025         and v-count-fld <> v-field-num
     2026       then do:
     2027         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info26, vTable ).
     2028       end.
     2029     end.
     2030   end procedure.
     2031   procedure gen-hn-keyr-tab :
     2032     define input  parameter i-tableSerach as character no-undo.
     2033     define input  parameter i-tablekey   as character no-undo.
     2034     define input  parameter p-key-rec    as character no-undo.
     2035     define input  parameter p-key-handle as handle    no-undo .
     2036     define input  parameter p-db-name    as character no-undo .
     2037     define input  parameter p-tt-handle  as handle    no-undo .
     2038     define input  parameter p-stts-lock  as integer   no-undo .
     2039     define output parameter o-hn         as handle    no-undo.
     2040     define variable v-full-tbl-name as character no-undo.
     2041     define variable v-where         as character no-undo.
     2042     define variable bh_tbl-name     as handle    no-undo.
     2043     define variable vTable          as character no-undo.
     2044     do
     2045     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2046     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     2047     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     2048         run gen-where-keyr-tab(i-tableSerach,
     2049                                i-tablekey,
     2050                                p-key-rec,
     2051                                p-key-handle,
     2052                                p-db-name,
     2053                                p-tt-handle,
     2054                                output v-where).
     2055         if i-tableSerach ne "" and i-tableSerach ne ?
     2056         then do:
     2057            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     2058            create buffer bh_tbl-name for table v-full-tbl-name .
     2059         end.
     2060         else do:
     2061            if p-tt-handle = ? then do:
     2062               assign
     2063                  vTable = entry( 1 , p-key-rec, chr(3) )
     2064               .
     2065               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     2066               create buffer bh_tbl-name for table v-full-tbl-name .
     2067            end.
     2068            else do:
     2069               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     2070            end.
     2071         end.
     2072         if p-tt-handle = ? then do:
     2073            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     2074         end.
     2075         else do:
     2076            bh_tbl-name:find-first( v-where ) no-error .
     2077         end.
     2078         o-hn = bh_tbl-name.
     2079      end.
     2080   end procedure.
     2081   procedure gen-hn-keyr :
     2082     define input  parameter p-key-rec    as character no-undo.
     2083     define input  parameter p-key-handle as handle    no-undo .
     2084     define input  parameter p-db-name    as character no-undo .
     2085     define input  parameter p-tt-handle  as handle    no-undo .
     2086     define input  parameter p-stts-lock  as integer   no-undo .
     2087     define output parameter o-hn         as handle    no-undo.
     2088     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     2089   end.
     2090   procedure gen-row-keyr :
     2091     define input  parameter p-key-rec    as character no-undo.
     2092     define input  parameter p-key-handle as handle    no-undo .
     2093     define input  parameter p-db-name    as character no-undo .
     2094     define input  parameter p-tt-handle  as handle    no-undo .
     2095     define input  parameter p-stts-lock  as integer   no-undo .
     2096     define output parameter p-tbl-row    as rowid     no-undo.
     2097     define output parameter p-tbl-name   as character no-undo.
     2098     define variable vHn as handle no-undo.
     2099       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     2100       p-tbl-row = if vHn:available then vHn:rowid else ?.
     2101       p-tbl-name =  vHn:table.
     2102       delete object vHn no-error.
     2103     if p-tbl-row = ? then do:
     2104       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info26, p-tbl-name, p-key-rec ).
     2105     end.
     2106     else do:
     2107       return.
     2108     end.
     2109   end procedure.
     2110   procedure gen-key-fv :
     2111     define input  parameter p-key-rec    as character no-undo .
     2112     define output parameter p-field-list as character no-undo .
     2113     define output parameter p-value-list as character no-undo.
     2114     do
     2115     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2116     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     2117     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     2118     :
     2119       define variable v-full-tbl-name  as character no-undo .
     2120       define variable bh_tbl-name      as handle    no-undo .
     2121       define variable v-tbl-name       as character no-undo .
     2122       define variable v-field-num      as integer   no-undo .
     2123       define variable v-count-fld      as integer   no-undo .
     2124       define variable v-inform         as character no-undo .
     2125       define variable v-ind            as integer   no-undo .
     2126       define variable v-idx-field-qnty as integer   no-undo .
     2127       define variable v-delim-key      as character no-undo .
     2128       if p-key-rec = ?
     2129         or p-key-rec = "":U
     2130       then do:
     2131         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info26 ).
     2132       end.
     2133       assign
     2134         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     2135         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     2136       .
     2137       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     2138       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info26 ).
     2139       assign
     2140         v-inform = bh_tbl-name:index-information(1)
     2141         v-ind    = 2
     2142       .
     2143       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2144       on error undo, return error
     2145       :
     2146         assign
     2147           v-inform = bh_tbl-name:index-information( v-ind )
     2148           v-ind    = v-ind + 1
     2149         .
     2150       end.
     2151       if v-inform = ?
     2152         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2153         or entry( 3, v-inform, ",":U ) <> "1":U
     2154       then do:
     2155         delete object bh_tbl-name no-error.
     2156         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info26, v-tbl-name ).
     2157       end.
     2158       assign
     2159         v-idx-field-qnty = num-entries( v-inform ) - 4
     2160       .
     2161       if v-idx-field-qnty < 2 then do:
     2162         delete object bh_tbl-name no-error.
     2163         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info26, v-inform, v-tbl-name ).
     2164       end.
     2165       assign
     2166         p-field-list = "":U
     2167         p-value-list = "":U
     2168         v-delim-key  = "":U
     2169         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     2170         v-count-fld  = 0
     2171       .
     2172       block_where:
     2173       do v-ind = 1 to v-idx-field-qnty by 2
     2174       on error undo, return error
     2175       :
     2176         assign
     2177           v-count-fld = v-count-fld + 1
     2178         .
     2179         if v-count-fld > v-field-num then do:
     2180           leave block_where.
     2181         end.
     2182         assign
     2183           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     2184           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     2185         .
     2186         if v-ind = 1 then do:
     2187           assign
     2188             v-delim-key = chr(3)
     2189           .
     2190         end.
     2191       end.
     2192       delete object bh_tbl-name.
     2193       if v-count-fld <> v-field-num then do:
     2194         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info26, v-tbl-name ).
     2195       end.
     2196     end.
     2197   end procedure.
     2198   procedure gen-key-field :
     2199     define input  parameter p-table      as character no-undo .
     2200     define output parameter p-field-list as character no-undo .
     2201     do
     2202     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2203     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     2204     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     2205     :
     2206       define variable v-full-tbl-name  as character no-undo .
     2207       define variable bh_tbl-name      as handle    no-undo .
     2208       define variable v-tbl-name       as character no-undo .
     2209       define variable v-field-num      as integer   no-undo .
     2210       define variable v-count-fld      as integer   no-undo .
     2211       define variable v-inform         as character no-undo .
     2212       define variable v-ind            as integer   no-undo .
     2213       define variable v-idx-field-qnty as integer   no-undo .
     2214       define variable v-delim-key      as character no-undo .
     2215       if p-table = ?
     2216         or p-table = "":U
     2217       then do:
     2218         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info26 ).
     2219       end.
     2220       assign
     2221         v-tbl-name      = p-table
     2222         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     2223       .
     2224       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     2225       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info26 ).
     2226       assign
     2227         v-inform = bh_tbl-name:index-information(1)
     2228         v-ind    = 2
     2229       .
     2230       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2231       on error undo, return error
     2232       :
     2233         assign
     2234           v-inform = bh_tbl-name:index-information( v-ind )
     2235           v-ind    = v-ind + 1
     2236         .
     2237       end.
     2238       if v-inform = ?
     2239         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2240         or entry( 3, v-inform, ",":U ) <> "1":U
     2241       then do:
     2242         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info26, v-tbl-name ).
     2243       end.
     2244       assign
     2245         v-idx-field-qnty = num-entries( v-inform ) - 4
     2246       .
     2247       if v-idx-field-qnty < 2 then do:
     2248         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info26, v-inform, v-tbl-name ).
     2249       end.
     2250       assign
     2251         p-field-list = "":U
     2252         v-delim-key  = "":U
     2253         v-count-fld  = 0
     2254       .
     2255       block_where:
     2256       do v-ind = 1 to v-idx-field-qnty by 2
     2257       on error undo, return error
     2258       :
     2259         assign
     2260           v-count-fld = v-count-fld + 1
     2261         .
     2262         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     2263         if v-ind = 1 then do:
     2264           assign
     2265             v-delim-key = chr(3)
     2266           .
     2267         end.
     2268       end.
     2269       delete object bh_tbl-name.
     2270     end.
     2271   end procedure.
     2272   procedure get-gate-file-name :
     2273   define input parameter p-gate-rec as character no-undo .
     2274   define output  parameter p-gate-file-name as character no-undo .
     2275   define buffer buf_clob-data for ub.clob-data.
     2276   define variable v-tbl-row as rowid no-undo .
     2277   define variable v-tbl-name as character no-undo .
     2278   run gen-row-keyr in this-procedure ( input p-gate-rec
     2279                                       ,input ?
     2280                                       ,input "ub"
     2281                                       ,input ?
     2282                                       ,input no-lock
     2283                                       ,output v-tbl-row
     2284                                       ,output v-tbl-name) no-error.
     2285   if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
     2286                                                           ,vss-include-info24
     2287                                                           ,p-gate-rec).
     2288   find first buf_clob-data no-lock where
     2289             rowid(buf_clob-data) = v-tbl-row no-error.
     2290   if not available buf_clob-data then do:
     2291     if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
     2292                                                             ,vss-include-info24
     2293                                                             ,p-gate-rec).
     2294   end.
     2295   p-gate-file-name = buf_clob-data.file-name.
     2296   end procedure.
     2297   procedure get-gate-rec :
     2298   define input  parameter p-gate-name as character no-undo .
     2299   define output parameter p-gate-rec as character no-undo .
     2300   define buffer buf_clob-bind for ub.clob-bind.
     2301   define buffer buf_clob-data for ub.clob-data.
     2302   main-block:
     2303   do
     2304   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info24, return-value, chr(10), error-status :get-message (1))
     2305   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info24 )
     2306   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info24 )
     2307   :
     2308       find first buf_clob-bind no-lock where
     2309                 buf_clob-bind.uniq-key-rec = p-gate-name
     2310             and buf_clob-bind.field-name = '':U
     2311             and buf_clob-bind.part-num = 1
     2312             and buf_clob-bind.resource-type = 'gate':U
     2313             no-error.
     2314       if not available buf_clob-bind then do:
     2315         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
     2316                                         , p-gate-name
     2317                                         ).
     2318       end.
     2319       find first buf_clob-data no-lock where
     2320                 buf_clob-data.db-num = buf_clob-bind.db-num
     2321             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
     2322       if not available buf_clob-data then do:
     2323         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     2324                                         , buf_clob-bind.db-num
     2325                                         , buf_clob-bind.int64-id
     2326                                         , p-gate-name
     2327                                         ).
     2328       end.
     2329       run gen-key-rec in this-procedure ( input 'clob-data':U
     2330                                 ,input buffer buf_clob-data:handle
     2331                                 ,output p-gate-rec).
     2332   end.
     2333   end procedure.
     2334   procedure get-gate-by-name :
     2335   define input  parameter p-gate-name as character no-undo .
     2336   define output parameter p-gate-rec as character no-undo .
     2337   define output parameter p-dsh as handle no-undo .
     2338   define input-output  parameter p-xmlh as handle no-undo .
     2339   define variable v-ii as integer   no-undo .
     2340   define variable glog as logical   no-undo .
     2341   define variable v-longchar as longchar no-undo .
     2342   define variable v-txmlh as handle no-undo .
     2343   define variable v-db-num as integer no-undo .
     2344   define variable v-int64-id as int64 no-undo .
     2345   define buffer buf_clob-bind for ub.clob-bind.
     2346   define buffer buf_clob-data for ub.clob-data.
     2347   main-block:
     2348   do
     2349   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info24, return-value, chr(10), error-status :get-message (1))
     2350   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info24 )
     2351   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info24 )
     2352   :
     2353       find first buf_clob-bind no-lock where
     2354                 buf_clob-bind.uniq-key-rec = p-gate-name
     2355             and buf_clob-bind.field-name = '':U
     2356             and buf_clob-bind.part-num = 1
     2357             and buf_clob-bind.resource-type = 'gate':U
     2358             no-error.
     2359       if not available buf_clob-bind then do:
     2360         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
     2361                                         , p-gate-name
     2362                                         ).
     2363       end.
     2364       find first buf_clob-data no-lock where
     2365                 buf_clob-data.db-num = buf_clob-bind.db-num
     2366             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
     2367       if not available buf_clob-data then do:
     2368         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     2369                                         , buf_clob-bind.db-num
     2370                                         , buf_clob-bind.int64-id
     2371                                         , p-gate-name
     2372                                         ).
     2373       end.
     2374       assign
     2375       v-longchar = buf_clob-data.cdata
     2376       .
     2377       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     2378       if error-status :error then do:
     2379         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     2380       end.
     2381       create dataset p-dsh .
     2382       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     2383                                     , v-longchar
     2384                                     , ?
     2385                                     , ?
     2386                                     , ?
     2387                                     ) no-error.
     2388       v-longchar = '':U.
     2389       if error-status :error
     2390       or not glog
     2391       then do:
     2392         undo, return error substitute("Не удалось прочитать XML-схему &1 из БД:&2&3", p-gate-name, chr(10), error-status:get-message(1) ).
     2393       end.
     2394       if not valid-handle(p-xmlh)
     2395       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     2396         create temp-table v-txmlh.
     2397         v-txmlh:create-like(buffer temp-xml-tables:handle).
     2398         v-txmlh:temp-table-prepare("temp-xml-tables").
     2399         p-xmlh = v-txmlh:default-buffer-handle.
     2400       end.
     2401       run gen-key-rec in this-procedure ( input 'clob-data':U
     2402                                 ,input buffer buf_clob-data:handle
     2403                                 ,output p-gate-rec).
     2404       do v-ii = 1 to p-dsh:num-buffers:
     2405         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     2406         if not p-xmlh:available then do:
     2407           p-xmlh:buffer-create().
     2408           assign
     2409           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     2410           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     2411           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     2412           p-xmlh::gate-handle_ = p-dsh
     2413           p-xmlh::uniq-gate-rec = p-gate-rec
     2414           p-xmlh::gate-name = p-dsh:name
     2415           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     2416           .
     2417           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     2418             assign
     2419             p-xmlh::order = -3.
     2420           end.
     2421         end.
     2422       end.
     2423   end.
     2424   end procedure.
     2425   procedure get-gate-by-rec :
     2426   define input  parameter p-gate-rec as character no-undo .
     2427   define output parameter p-dsh as handle no-undo .
     2428   define input-output  parameter p-xmlh as handle no-undo .
     2429   define input-output parameter p-longchar  as longchar no-undo .
     2430   define variable v-ii as integer   no-undo .
     2431   define variable glog as logical   no-undo .
     2432   define variable v-rowid as rowid no-undo .
     2433   define variable v-tbl-name as character no-undo .
     2434   define variable v-longchar as longchar no-undo .
     2435   define variable v-txmlh as handle no-undo .
     2436   define buffer buf_clob-data for ub.clob-data.
     2437   main-block:
     2438   do
     2439   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info24, return-value, chr(10), error-status :get-message (1))
     2440   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info24 )
     2441   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info24 )
     2442   :
     2443     run gen-row-keyr in this-procedure (
     2444                                           input  p-gate-rec
     2445                                           ,input  ?
     2446                                           ,input  "ub"
     2447                                           ,input  ?
     2448                                           ,input  NO-LOCK
     2449                                           ,output v-rowid
     2450                                           ,output v-tbl-name   ) no-error.
     2451       find first buf_clob-data no-lock where
     2452                 rowid(buf_clob-data) = v-rowid  no-error.
     2453       if not available buf_clob-data then do:
     2454         undo, return error substitute("Не найден CLOB  &1"
     2455                                         , p-gate-rec
     2456                                         ).
     2457       end.
     2458       assign
     2459       v-longchar = buf_clob-data.cdata
     2460       .
     2461       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     2462       if error-status :error then do:
     2463         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     2464       end.
     2465       create dataset p-dsh .
     2466       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     2467                                     , v-longchar
     2468                                     , ?
     2469                                     , ?
     2470                                     , ?
     2471                                     ) no-error.
     2472       define variable v-esm as character no-undo .
     2473       v-esm = error-status:get-message(1) .
     2474       if p-longchar <> ? then do:
     2475         p-longchar = v-longchar.
     2476       end.
     2477       v-longchar = '':U.
     2478       if error-status :error
     2479       or not glog
     2480       then do:
     2481         undo, return error substitute("Не удалось прочитать XML-схему &1 (&2) из БД&3&4"
     2482                                      , p-gate-rec
     2483                                      , p-gate-rec
     2484                                      , v-esm
     2485                                      ).
     2486       end.
     2487       p-dsh:private-data = buf_clob-data.file-name_ + chr(4) + p-gate-rec.
     2488       if not valid-handle(p-xmlh)
     2489       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     2490         create temp-table v-txmlh.
     2491         v-txmlh:create-like(buffer temp-xml-tables:handle).
     2492         v-txmlh:temp-table-prepare("temp-xml-tables").
     2493         p-xmlh = v-txmlh:default-buffer-handle.
     2494       end.
     2495       do v-ii = 1 to p-dsh:num-buffers:
     2496         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     2497         if not p-xmlh:available then do:
     2498           p-xmlh:buffer-create().
     2499           assign
     2500           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     2501           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     2502           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     2503           p-xmlh::gate-handle_ = p-dsh
     2504           p-xmlh::uniq-gate-rec = p-gate-rec
     2505           p-xmlh::gate-name = p-dsh:name
     2506           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     2507           .
     2508           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     2509             assign
     2510             p-xmlh::order = -3.
     2511           end.
     2512           p-xmlh:buffer-release().
     2513         end.
     2514       end.
     2515   end.
     2516   end procedure.
     2517   procedure get-gate-by-file :
     2518   define input  parameter p-schema-file-name as character no-undo .
     2519   define input  parameter p-gate-rec as character no-undo .
     2520   define output parameter p-dsh as handle no-undo .
     2521   define input-output  parameter p-xmlh as handle no-undo .
     2522   define variable v-ii as integer   no-undo .
     2523   define variable glog as logical   no-undo .
     2524   define variable v-rowid as rowid no-undo .
     2525   define variable v-tbl-name as character no-undo .
     2526   define variable v-longchar as longchar no-undo .
     2527   define variable v-txmlh as handle no-undo .
     2528   main-block:
     2529   do
     2530   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info24, return-value, chr(10), error-status :get-message (1))
     2531   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info24 )
     2532   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info24 )
     2533   :
     2534       COPY-LOB
     2535       FROM  FILE p-schema-file-name
     2536       TO  OBJECT v-longchar
     2537       no-convert
     2538       NO-ERROR .
     2539       if error-status :error then do:
     2540           undo, return error substitute("Не удалось считать файл схемы &1 в память&2&3"
     2541                                     , p-schema-file-name
     2542                                 , chr(10)
     2543                                 , error-status:get-message(1) ).
     2544       end.
     2545       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     2546       if error-status :error then do:
     2547         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, p-schema-file-name, chr(10), error-status:get-message(1) , return-value ).
     2548       end.
     2549       create dataset p-dsh .
     2550       glog = p-dsh:READ-XMLSCHEMA( "longchar"
     2551                                     , v-longchar
     2552                                     , ?
     2553                                     , ?
     2554                                     , ?
     2555                                     ) no-error.
     2556       v-longchar = ''.
     2557       if error-status :error
     2558       or not glog
     2559       then do:
     2560         undo, return error substitute("Не удалось прочитать XML-схему из файла &1&2&3"
     2561                                      , p-schema-file-name
     2562                                      ,chr(10)
     2563                                      , error-status:get-message(1)
     2564                                      ).
     2565       end.
     2566       if not valid-handle(p-xmlh)
     2567       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     2568         create temp-table v-txmlh.
     2569         v-txmlh:create-like(buffer temp-xml-tables:handle).
     2570         v-txmlh:temp-table-prepare("temp-xml-tables").
     2571         p-xmlh = v-txmlh:default-buffer-handle.
     2572       end.
     2573       do v-ii = 1 to p-dsh:num-buffers:
     2574         p-xmlh:find-first(substitute(' where tbl-name = "&1" and  uniq-gate-rec = "&2" '
     2575                                      ,p-dsh:get-buffer-handle(v-ii):name
     2576                                      ,p-gate-rec
     2577                                      )) no-error.
     2578         if not p-xmlh:available then do:
     2579           p-xmlh:buffer-create().
     2580           assign
     2581           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):table
     2582           p-xmlh::uniq-gate-rec = p-gate-rec
     2583           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     2584           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     2585           p-xmlh::gate-handle_ = p-dsh
     2586           p-xmlh::gate-name = p-dsh:name
     2587           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     2588           .
     2589           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     2590             assign
     2591             p-xmlh::order = -3.
     2592           end.
     2593           p-xmlh:buffer-release().
     2594         end.
     2595       end.
     2596   end.
     2597   end procedure.
     2598   procedure gate-clear :
     2599   define input  parameter p-dsh as handle no-undo .
     2600   define input  parameter p-xmlh as handle no-undo .
     2601   define variable v-dsh as handle no-undo .
     2602   define variable v-th as handle no-undo .
     2603     do
     2604     on error undo, return error return-value
     2605     :
     2606       if valid-handle(p-dsh) then do:
     2607         delete object p-dsh.
     2608         v-dsh = p-dsh.
     2609         p-dsh = ?.
     2610       end.
     2611       repeat while true:
     2612         p-xmlh:find-first( substitute( " where gate-handle_ = &1 ", v-dsh)
     2613                            , share-lock) no-error.
     2614         if p-xmlh:available then do:
     2615           assign
     2616           v-th = p-xmlh:buffer-field("table-handle_"):buffer-value.
     2617           if valid-handle(p-xmlh:buffer-field("table-handle_"))
     2618           and valid-handle(v-th)
     2619           and v-th:dynamic = yes
     2620           then do:
     2621             delete object p-xmlh:buffer-field("table-handle_"):buffer-value.
     2622             p-xmlh:buffer-field("table-handle_"):buffer-value = ?.
     2623           end.
     2624           p-xmlh:buffer-delete().
     2625         end.
     2626         else do:
     2627           leave.
     2628         end.
     2629       end.
     2630       if p-xmlh:dynamic = yes
     2631       and valid-handle(p-xmlh)
     2632       then do:
     2633         delete object p-xmlh:table-handle.
     2634         p-xmlh = ?.
     2635       end.
     2636       v-dsh = ?.
     2637     end.
     2638   end procedure.
     2639   procedure all-gates-clear :
     2640   define parameter buffer buf_temp-xml-tables for temp-xml-tables.
     2641   do
     2642   on error undo, return error
     2643   :
     2644     for each buf_temp-xml-tables
     2645     break
     2646     by buf_temp-xml-tables.uniq-gate-rec
     2647     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2648     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     2649     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     2650     :
     2651         if first-of(buf_temp-xml-tables.uniq-gate-rec) then do:
     2652           delete object buf_temp-xml-tables.gate-handle_.
     2653           buf_temp-xml-tables.gate-handle_ = ?.
     2654         end.
     2655         if valid-handle(buf_temp-xml-tables.table-handle_)
     2656         and buf_temp-xml-tables.table-handle_:dynamic = no
     2657         then do:
     2658           delete object buf_temp-xml-tables.table-handle_.
     2659           buf_temp-xml-tables.table-handle_ = ?.
     2660         end.
     2661         delete buf_temp-xml-tables.
     2662     end.
     2663   end.
     2664   end procedure.
     2665   procedure fix-schemalocation :
     2666   define input-output  parameter p-longchar as longchar no-undo .
     2667   DEFINE VARIABLE hdoc AS HANDLE.
     2668   DEFINE VARIABLE hroot AS HANDLE.
     2669   DEFINE VARIABLE hnode-child AS HANDLE.
     2670   DEFINE VARIABLE hnode-attr AS HANDLE.
     2671   define variable v-jj as integer   no-undo .
     2672   define variable ok as logical   no-undo .
     2673   define variable v-path1                    as character                no-undo .
     2674   DEFINE VARIABLE v-full-path1               as character                no-undo .
     2675   DEFINE VARIABLE v-file-name1               as character                no-undo .
     2676   DEFINE VARIABLE v-file-name-no-ext1        as character                no-undo .
     2677   DEFINE VARIABLE v-file-name-ext1           as character                no-undo .
     2678   define variable v-schema-location          as character                no-undo .
     2679   do
     2680   on error undo, return error return-value
     2681   :
     2682     CREATE X-DOCUMENT hdoc.
     2683     CREATE X-noderef hroot.
     2684     CREATE X-noderef hnode-child.
     2685     CREATE X-noderef hnode-attr.
     2686     hdoc:load("longchar", p-longchar, no) no-error.
     2687     iF ERROR-STATUS:GET-MESSAGE(1) <> '' THEN message ERROR-STATUS:GET-MESSAGE(1) view-as alert-box .
     2688     hdoc:get-document-element(hroot).
     2689     _repeat:
     2690     REPEAT v-jj = 1 TO hroot:NUM-CHILDREN:
     2691       ok = hroot:GET-CHILD(hNode-Child, v-jj).
     2692       if not ok then next.
     2693       if hNode-Child:local-name = "include"
     2694       then do:
     2695         ok = hNode-Child:GET-ATTRIBUTE-NODE( hnode-attr, "schemaLocation" ).
     2696           v-schema-location = hnode-attr:node-value.
     2697           run gbl/filename.p (
     2698                           input "exe/" + hnode-attr:node-value
     2699                         ,output v-full-path1
     2700                         ,output v-path1
     2701                         ,output v-file-name1
     2702                         ,output v-file-name-no-ext1
     2703                         ,output v-file-name-ext1
     2704                         ) no-error .
     2705           if error-status :error then do:
     2706             delete object hnode-attr.
     2707             delete object hnode-child.
     2708             delete object hroot.
     2709             delete object hdoc.
     2710             undo, return error substitute("Не удалось определить расположение схемы &1", v-schema-location).
     2711           end.
     2712         ok = hNode-Child:sET-ATTRIBUTE(  "schemaLocation", v-full-path1 ).
     2713         leave  _repeat.
     2714       end.
     2715     END.
     2716     hdoc:save("longchar", p-longchar).
     2717     delete object hnode-attr.
     2718     delete object hnode-child.
     2719     delete object hroot.
     2720     delete object hdoc.
     2721   end.
     2722   end procedure.
     2723   procedure gate-clb_fill-xml-tables :
     2724   define input parameter p-dsh as handle no-undo .
     2725   define input-output parameter p-xmlh as handle no-undo .
     2726   define variable v-ii as integer no-undo .
     2727     do
     2728     on error undo, return error
     2729     :
     2730       do v-ii = 1 to p-dsh:num-buffers:
     2731         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     2732         if not p-xmlh:available then do:
     2733           p-xmlh:buffer-create().
     2734           assign
     2735           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     2736           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     2737           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     2738           p-xmlh::gate-handle_ = p-dsh
     2739           p-xmlh::uniq-gate-rec = entry(2, p-dsh:private-data, chr(4))
     2740           p-xmlh::gate-name = p-dsh:name
     2741           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     2742           .
     2743           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     2744             assign
     2745             p-xmlh::order = -3.
     2746           end.
     2747           p-xmlh:buffer-release().
     2748         end.
     2749       end.
     2750     end.
     2751   end procedure.
     2752   procedure all-gates-empty :
     2753   define buffer buf_temp-xml-tables for temp-xml-tables.
     2754   do
     2755   on error undo, return error
     2756   :
     2757     for each buf_temp-xml-tables
     2758     break
     2759     by buf_temp-xml-tables.uniq-gate-rec
     2760     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2761     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     2762     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     2763     :
     2764       if valid-handle(buf_temp-xml-tables.tbl-handle_) then do:
     2765         buf_temp-xml-tables.tbl-handle_:empty-temp-table().
     2766       end.
     2767     end.
     2768   end.
     2769   end procedure.
     2770   define variable vss-include-info27 as character format "X(65)" no-undo
     2771   initial "@(#)$Workfile$ $Revision$".
     2772   define variable v-fmtcli-name          as character    no-undo.
     2773   define variable v-fmtcli-engl-name     as character    no-undo.
     2774   define variable v-fmtcli-addres        as character    no-undo.
     2775   define variable v-fmtcli-post-addres   as character    no-undo.
     2776   define variable v-fmtcli-full-addres   as character    no-undo.
     2777   define variable v-fmtcli-phone         as character    no-undo.
     2778   define variable v-fmtcli-inn           as character    no-undo.
     2779   define variable v-fmtcli-kpp           as character    no-undo.
     2780   define variable v-fmtcli-okpo          as character    no-undo.
     2781   define variable v-fmtcli-country       as character    no-undo.
     2782   define variable v-fmtcli-city          as character    no-undo.
     2783   define variable v-fmtcli-index         as character    no-undo.
     2784   define variable v-fmtcli-schet-exists  as logical      no-undo.
     2785   define variable v-fmtcli-bank-exists   as logical      no-undo.
     2786   define variable v-fmtcli-bank-r-schet  as character    no-undo.
     2787   define variable v-fmtcli-bank-c-schet  as character    no-undo.
     2788   define variable v-fmtcli-bank-bik      as character    no-undo.
     2789   define variable v-fmtcli-bank-name     as character    no-undo.
     2790   define variable v-fmtcli-bank-addres   as character    no-undo.
     2791   define variable v-fmtcli-bank-city     as character    no-undo.
     2792   procedure fmtcli-get-bank :
     2793   define input parameter p-host-code      as integer          no-undo.
     2794   define input parameter p-obj-type       as character        no-undo.
     2795   define input parameter p-obj-code       as integer          no-undo.
     2796   define input parameter p-curr-code      as integer          no-undo.
     2797       define buffer buf_fin-schet     for ub.fin-schet.
     2798       define buffer buf_fin-bank      for ub.fin-bank.
     2799   do
     2800   for buf_fin-schet
     2801     , buf_fin-bank
     2802   on error undo, return error
     2803   :
     2804       assign
     2805           v-fmtcli-schet-exists       = no
     2806           v-fmtcli-bank-exists        = no
     2807           v-fmtcli-bank-r-schet       = "":U
     2808           v-fmtcli-bank-c-schet       = "":U
     2809           v-fmtcli-bank-bik           = "":U
     2810           v-fmtcli-bank-name          = "":U
     2811           v-fmtcli-bank-addres        = "":U
     2812           v-fmtcli-bank-city          = "":U
     2813       .
     2814       search-for-schet:
     2815       for each buf_fin-schet no-lock
     2816          where buf_fin-schet.host-code = p-host-code
     2817            and buf_fin-schet.cli-type  = p-obj-type
     2818            and buf_fin-schet.cli-code  = p-obj-code
     2819            and buf_fin-schet.curr-code = p-curr-code
     2820       on error undo, return error
     2821       :
     2822           if buf_fin-schet.status_   = 'удал':U
     2823           then do:
     2824           end.
     2825           else do:
     2826               assign
     2827                   v-fmtcli-schet-exists   = yes
     2828                   v-fmtcli-bank-r-schet   = trim( buf_fin-schet.r-schet )
     2829                   v-fmtcli-bank-c-schet   = trim( buf_fin-schet.c-schet )
     2830               .
     2831               find first buf_fin-bank no-lock
     2832                    where buf_fin-bank.host-code = p-host-code
     2833                      and buf_fin-bank.code-bank = buf_fin-schet.code-bank
     2834               no-error.
     2835               if available buf_fin-bank
     2836               then do:
     2837                   assign
     2838                       v-fmtcli-bank-exists      = yes
     2839                       v-fmtcli-bank-bik         = trim( buf_fin-bank.bik )
     2840                       v-fmtcli-bank-name        = trim( buf_fin-bank.bank-name )
     2841                       v-fmtcli-bank-addres      = trim(buf_fin-bank.addres)
     2842                       v-fmtcli-bank-city      = trim(buf_fin-bank.bank-city)
     2843                   .
     2844               end.
     2845               else do:
     2846                   assign
     2847                       v-fmtcli-bank-exists    = no
     2848                       v-fmtcli-bank-bik       = "":U
     2849                       v-fmtcli-bank-name      = "":U
     2850                       v-fmtcli-bank-addres    = "":U
     2851                       v-fmtcli-bank-city      = "":U
     2852                   .
     2853               end.
     2854               leave search-for-schet.
     2855           end.
     2856       end.
     2857   end.
     2858   end procedure.
     2859   procedure fmtcli-get-client :
     2860   define input parameter p-obj-type       as character    no-undo.
     2861   define input parameter p-obj-code       as integer      no-undo.
     2862       define variable v-temp-fmtcli-address      as character     no-undo.
     2863       define variable v-num-country-city    as integer      no-undo.
     2864       define buffer buf_clients   for ub.clients.
     2865       define buffer buf_firm      for ub.firm.
     2866       define buffer buf_store     for ub.store.
     2867       define buffer buf_shop      for ub.shop.
     2868       define buffer buf_person    for ub.person.
     2869   do
     2870   for buf_clients
     2871     , buf_firm
     2872     , buf_store
     2873     , buf_shop
     2874     , buf_person
     2875   on error undo, return error
     2876   :
     2877       assign
     2878           v-fmtcli-name           = "":U
     2879           v-fmtcli-addres         = "":U
     2880           v-fmtcli-post-addres    = "":U
     2881           v-fmtcli-full-addres    = "":U
     2882           v-fmtcli-phone          = "":U
     2883           v-fmtcli-inn            = "":U
     2884           v-fmtcli-kpp            = "":U
     2885           v-fmtcli-okpo           = "":U
     2886           v-fmtcli-city           = "":U
     2887           v-fmtcli-index          = "":U
     2888           v-fmtcli-country        = "":U
     2889       .
     2890       find first buf_clients no-lock
     2891            where buf_clients.obj-type = p-obj-type
     2892              and buf_clients.obj-code = p-obj-code
     2893       .
     2894       assign
     2895           v-fmtcli-name = buf_clients.obj-name
     2896       .
     2897       case buf_clients.obj-type:
     2898          when 'орг':U
     2899          then do:
     2900               find first buf_firm no-lock
     2901                    where buf_firm.firm-code = buf_clients.obj-code
     2902                    no-error
     2903               .
     2904               if available buf_firm
     2905               then do:
     2906                   assign
     2907                       v-num-country-city = num-entries( buf_firm.city )
     2908                       v-fmtcli-engl-name = buf_firm.engl-name
     2909                   .
     2910                   if v-num-country-city > 0
     2911                   then do:
     2912                       assign
     2913                           v-fmtcli-country    = trim( entry( 1, buf_firm.city ) )
     2914                       .
     2915                   end.
     2916                   if v-num-country-city > 1
     2917                   then do:
     2918                       assign
     2919                           v-fmtcli-city       = trim( entry( 2, buf_firm.city ) )
     2920                       .
     2921                   end.
     2922                   run fmtcli-concatenate-strings in this-procedure (
     2923                         input v-fmtcli-full-addres
     2924                       , input v-fmtcli-country
     2925                       , input ", ":U
     2926                       , input 50
     2927                       , output v-fmtcli-full-addres
     2928                   ).
     2929                   run fmtcli-concatenate-strings in this-procedure (
     2930                         input v-fmtcli-full-addres
     2931                       , input v-fmtcli-city
     2932                       , input ", ":U
     2933                       , input 50
     2934                       , output v-fmtcli-full-addres
     2935                   ).
     2936                   run fmtcli-concatenate-strings in this-procedure (
     2937                         input v-fmtcli-full-addres
     2938                       , input IF buf_firm.ind = 0 THEN "" ELSE string( buf_firm.ind )
     2939                       , input ", ":U
     2940                       , input 50
     2941                       , output v-fmtcli-full-addres
     2942                   ).
     2943                   run fmtcli-concatenate-strings in this-procedure (
     2944                         input v-fmtcli-post-addres
     2945                       , input v-fmtcli-country
     2946                       , input ", ":U
     2947                       , input 50
     2948                       , output v-fmtcli-post-addres
     2949                   ).
     2950                   run fmtcli-concatenate-strings in this-procedure (
     2951                         input v-fmtcli-post-addres
     2952                       , input v-fmtcli-city
     2953                       , input ", ":U
     2954                       , input 50
     2955                       , output v-fmtcli-post-addres
     2956                   ).
     2957                   run fmtcli-concatenate-strings in this-procedure (
     2958                         input v-fmtcli-post-addres
     2959                       , input string( buf_firm.ind )
     2960                       , input ", ":U
     2961                       , input 50
     2962                       , output v-fmtcli-post-addres
     2963                   ).
     2964                   run fmtcli-concatenate-strings in this-procedure (
     2965                         input substring( buf_firm.addres1, 1, 50 )
     2966                       , input buf_firm.addres2
     2967                       , input " ":U
     2968                       , input 50
     2969                       , output v-temp-fmtcli-address
     2970                   ).
     2971                   run fmtcli-concatenate-strings in this-procedure (
     2972                         input v-temp-fmtcli-address
     2973                       , input substring( buf_firm.addres1, 51, 50 )
     2974                       , input " ":U
     2975                       , input 50
     2976                       , output v-temp-fmtcli-address
     2977                   ).
     2978                   run fmtcli-concatenate-strings in this-procedure (
     2979                         input v-temp-fmtcli-address
     2980                       , input substring( buf_firm.addres1, 101, 50 )
     2981                       , input " ":U
     2982                       , input 50
     2983                       , output v-temp-fmtcli-address
     2984                   ).
     2985                   assign
     2986                       v-fmtcli-addres = v-temp-fmtcli-address
     2987                   .
     2988                   if buf_firm.addres1 <> ?
     2989                   then do:
     2990                       run fmtcli-concatenate-strings in this-procedure (
     2991                             input v-fmtcli-full-addres
     2992                           , input v-fmtcli-addres
     2993                           , input ", ":U
     2994                           , input 0
     2995                           , output v-fmtcli-full-addres
     2996                       ).
     2997                   end.
     2998                   run fmtcli-concatenate-strings in this-procedure (
     2999                         input substring( buf_firm.post-addr1, 1, 50 )
     3000                       , input buf_firm.post-addr2
     3001                       , input " ":U
     3002                       , input 50
     3003                       , output v-fmtcli-post-addres
     3004                   ).
     3005                   run fmtcli-concatenate-strings in this-procedure (
     3006                         input v-fmtcli-post-addres
     3007                       , input substring( buf_firm.post-addr1, 51, 50 )
     3008                       , input " ":U
     3009                       , input 50
     3010                       , output v-fmtcli-post-addres
     3011                   ).
     3012                   run fmtcli-concatenate-strings in this-procedure (
     3013                         input v-fmtcli-post-addres
     3014                       , input substring( buf_firm.post-addr1, 101, 50 )
     3015                       , input " ":U
     3016                       , input 50
     3017                       , output v-fmtcli-post-addres
     3018                   ).
     3019                   assign
     3020                       v-fmtcli-phone         = buf_firm.phone
     3021                       v-fmtcli-inn           = buf_firm.inn
     3022                       v-fmtcli-kpp           = buf_firm.kpp
     3023                       v-fmtcli-okpo          = buf_firm.okpo
     3024                       v-fmtcli-index         = string( buf_firm.ind )
     3025                   .
     3026               end.
     3027          end.
     3028          when 'маг':U
     3029          then do:
     3030               find first buf_shop no-lock
     3031                    where buf_shop.obj-code = buf_clients.obj-code
     3032               .
     3033               if available buf_shop
     3034               then do:
     3035                   run fmtcli-concatenate-strings in this-procedure (
     3036                         input buf_shop.addres1
     3037                       , input buf_shop.addres2
     3038                       , input " ":U
     3039                       , input 50
     3040                       , output v-fmtcli-addres
     3041                   ).
     3042                   assign
     3043                       v-fmtcli-full-addres = v-fmtcli-addres
     3044                       v-fmtcli-post-addres = v-fmtcli-addres
     3045                       v-fmtcli-phone       = buf_shop.phone
     3046                       v-fmtcli-inn         = "":U
     3047                       v-fmtcli-kpp         = "":U
     3048                       v-fmtcli-okpo        = "":U
     3049                       v-fmtcli-city        = "":U
     3050                       v-fmtcli-index       = "":U
     3051                   .
     3052               end.
     3053          end.
     3054          when 'скл':U
     3055          then do:
     3056               find first buf_store no-lock
     3057                    where buf_store.obj-code = buf_clients.obj-code
     3058               .
     3059               if available buf_store
     3060               then do:
     3061                   run fmtcli-concatenate-strings in this-procedure (
     3062                         input buf_store.addres1
     3063                       , input buf_store.addres2
     3064                       , input " ":U
     3065                       , input 50
     3066                       , output v-fmtcli-addres
     3067                   ).
     3068                   assign
     3069                       v-fmtcli-full-addres = v-fmtcli-addres
     3070                       v-fmtcli-phone       = buf_store.phone
     3071                       v-fmtcli-inn         = "":U
     3072                       v-fmtcli-kpp         = "":U
     3073                       v-fmtcli-okpo        = "":U
     3074                       v-fmtcli-city        = "":U
     3075                       v-fmtcli-index       = "":U
     3076                   .
     3077               end.
     3078          end.
     3079          when 'чел':U
     3080          then do:
     3081               find first buf_person no-lock
     3082                    where buf_person.psn-code = buf_clients.obj-code
     3083               .
     3084               if available buf_person
     3085               then do:
     3086                   run fmtcli-concatenate-strings in this-procedure (
     3087                         input ( if buf_person.ind = 0 or buf_person.ind = ?
     3088                                 then "":U
     3089                                 else string( buf_person.ind, "999999")
     3090                                 )
     3091                       , input buf_person.city
     3092                       , input ", ":U
     3093                       , input 0
     3094                       , output v-fmtcli-full-addres
     3095                   ).
     3096                   assign
     3097                       v-fmtcli-addres = buf_person.address
     3098                   .
     3099                   run fmtcli-concatenate-strings in this-procedure (
     3100                         input v-fmtcli-full-addres
     3101                       , input v-fmtcli-addres
     3102                       , input ", ":U
     3103                       , input 0
     3104                       , output v-fmtcli-full-addres
     3105                   ).
     3106                   assign
     3107                       v-fmtcli-phone     = buf_person.phone1
     3108                       v-fmtcli-inn       = buf_person.inn
     3109                       v-fmtcli-kpp       = buf_person.kpp
     3110                       v-fmtcli-okpo      = buf_person.okpo
     3111                       v-fmtcli-city      = buf_person.city
     3112                       v-fmtcli-index     = string( buf_person.ind )
     3113                   .
     3114               end.
     3115          end.
     3116       end case.
     3117   end.
     3118   end procedure.
     3119   procedure fmtcli-concatenate-strings :
     3120   define input parameter p-string-1       as character        no-undo.
     3121   define input parameter p-string-2       as character        no-undo.
     3122   define input parameter p-delimiter      as character        no-undo.
     3123   define input parameter p-length         as integer          no-undo.
     3124   define output parameter p-out-string    as character        no-undo.
     3125   do
     3126   on error undo, return error
     3127   :
     3128       assign
     3129           p-out-string = ( if p-string-1 = ?
     3130                            then "":U
     3131                            else trim( p-string-1 ) )
     3132       .
     3133       assign
     3134           p-out-string = p-out-string
     3135                        + ( if p-out-string = "":U
     3136                            or length( p-out-string ) = p-length
     3137                            or p-string-2 = ?
     3138                            or trim( p-string-2 ) = "":U
     3139                            then "":U
     3140                            else p-delimiter )
     3141                        + ( if p-string-2 = ?
     3142                            or trim( p-string-2 ) = "":U
     3143                            then "":U
     3144                            else trim( p-string-2 ) )
     3145       .
     3146   end.
     3147   end procedure.
     3148   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3149   procedure reprumpr_print-plain-text :
