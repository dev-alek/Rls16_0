      903   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      904   function breakstr returns character ( input        for-name    as character,
      905                                         input        line-length as integer,
      906                                         input-output line1       as character,
      907                                         input-output line2       as character ) :
      908     define variable ii as integer no-undo.
      909     if length( for-name ) > line-length then do:
      910       assign ii    = 1
      911              line1 = "":u
      912              line2 = "":u.
      913       if length( entry( ii, for-name , " ":u ) ) > line-length then do:
      914         assign line1 =       substring( for-name, 1, line-length     )
      915                line2 = trim( substring( for-name,    line-length + 1 ) ).
      916       end.                                                     else do:
      917         do while length( line1 + entry( ii, for-name, " ":u ) ) < ( line-length + 1 ) :
      918           assign line1 = line1 + entry( ii, for-name, " ":u ) + " ":u
      919                  ii    = ii    + 1.
      920           if length( entry( ii, for-name, " ":u ) ) > line-length then do:
      921             assign line1 = line1 + substring( for-name, length( line1 ), line-length - length( line1 ) + 1 ).
      922           end.
      923         end.
      924         assign line2 = trim( substring( for-name, length( line1 ) ) ).
      925       end.
      926     end.                                else do:
      927       assign line1 = for-name
      928              line2 = "":u.
      929     end.
      930     return ( line1 ).
      931   end function.
      932   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      933   procedure cur-time :
      934      define output parameter p-today as date      no-undo .
      935      define output parameter p-time  as integer   no-undo .
      936     do
      937     on error undo, return error
      938     :
      939       define variable v-date1 as date      no-undo .
      940       define variable v-date2 as date      no-undo .
      941       define variable v-time  as integer   no-undo .
      942       assign
      943         v-date1 = today
      944         v-time  = time
      945         v-date2 = today
      946       .
      947       if v-date1 <> v-date2
      948       then do:
      949         assign
      950           v-date1 = today
      951           v-time  = v-time
      952         .
      953       end.
      954       assign
      955         p-today = v-date1
      956         p-time  = v-time
      957       .
      958     end.
      959   end.
      960   function cur-time-date returns character
      961   :
      962     return string(today, '99/99/9999':U) .
      963   end.
      964   function cur-time-mjd returns decimal
      965   :
      966     define variable v-date as date      no-undo .
      967     define variable v-time as integer   no-undo .
      968     run cur-time in this-procedure
      969       (output v-date
      970       ,output v-time
      971       ) .
      972     return integer(v-date) - 2400002 + (v-time / 86400) .
      973   end.
      974   function cur-time-get-ending-index returns integer
      975   (input p-number as integer
      976   )
      977   :
      978     if p-number < 0
      979     or p-number = ?
      980     then do:
      981       return 1 .
      982     end.
      983     define variable v-rest as integer   no-undo .
      984     assign
      985       p-number = p-number modulo 100
      986     .
      987     if p-number < 20
      988     then do:
      989       assign
      990         v-rest = p-number
      991       .
      992     end.
      993     else do:
      994       assign
      995         v-rest = p-number modulo 10
      996       .
      997     end.
      998     case v-rest :
      999       when 1
     1000       then do:
     1001         return 2 .
     1002       end.
     1003       when 2 or
     1004       when 3 or
     1005       when 4
     1006       then do:
     1007         return 3 .
     1008       end.
     1009       otherwise do:
     1010         return 1 .
     1011       end.
     1012     end case .
     1013   end.
     1014   procedure cur-time-mjd-to-date :
     1015      define input  parameter i-mjd-diff as decimal no-undo.
     1016      define output parameter o-Date     as date    no-undo.
     1017      define output parameter o-Time     as integer no-undo.
     1018      define variable v-day-number as integer   no-undo .
     1019      if    i-mjd-diff < 0
     1020         or i-mjd-diff = ?
     1021      then do:
     1022         return "?" .
     1023      end.
     1024      assign
     1025         v-day-number = truncate(i-mjd-diff,0).
     1026         o-Date = date(v-day-number + 2400002).
     1027         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1028     .
     1029   end.
     1030   function cur-time-mjd-to-string returns character
     1031   (input p-mjd-diff as decimal
     1032   )
     1033   :
     1034     define variable v-day-number as integer   no-undo .
     1035     define variable v-seconds    as integer   no-undo .
     1036     define variable v-hour       as integer   no-undo .
     1037     define variable v-min        as integer   no-undo .
     1038     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1039     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1040     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1041     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1042     if p-mjd-diff < 0
     1043     or p-mjd-diff = ?
     1044     then do:
     1045       return "?" .
     1046     end.
     1047     assign
     1048       v-day-number = integer(truncate(p-mjd-diff,0))
     1049       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1050     .
     1051     if v-seconds > 86400
     1052     then do:
     1053       assign
     1054         v-seconds = 86400 - 1
     1055       .
     1056     end.
     1057     if v-seconds < 0
     1058     then do:
     1059       assign
     1060         v-seconds = 0
     1061       .
     1062     end.
     1063     assign
     1064       v-hour = truncate(v-seconds / 3600, 0)
     1065     .
     1066     assign
     1067       v-seconds = v-seconds modulo 3600
     1068     .
     1069     assign
     1070       v-min = truncate(v-seconds / 60, 0)
     1071     .
     1072     assign
     1073       v-seconds = v-seconds modulo 60
     1074     .
     1075     return
     1076         (if v-day-number <> 0
     1077           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1078           else ""
     1079         )
     1080       + (if v-day-number <> 0 or v-hour <> 0
     1081           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1082           else ""
     1083         )
     1084       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1085           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1086           else ""
     1087         )
     1088       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1089       .
     1090   end.
     1091   function cur-time-string returns character
     1092   :
     1093     define variable v-date as date      no-undo .
     1094     define variable v-time as integer   no-undo .
     1095     run cur-time in this-procedure
     1096       (output v-date
     1097       ,output v-time
     1098       ) .
     1099     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1100   end.
     1101   function cur-time-string-sec returns character
     1102   :
     1103     define variable v-date as date      no-undo .
     1104     define variable v-time as integer   no-undo .
     1105     run cur-time in this-procedure
     1106       (output v-date
     1107       ,output v-time
     1108       ) .
     1109     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1110   end.
     1111   function cur-time-custom  returns character
     1112   (input p-prefix as character
     1113   ,input p-date-format as character
     1114   ,input p-delimiter as character
     1115   ,input p-time-format as character
     1116   ,input p-suffix as character
     1117   )
     1118   :
     1119     define variable v-date as date      no-undo .
     1120     define variable v-time as integer   no-undo .
     1121     run cur-time in this-procedure
     1122       (output v-date
     1123       ,output v-time
     1124       ) .
     1125     return
     1126       p-prefix
     1127       + string(v-date, p-date-format)
     1128       + p-delimiter
     1129       + string(v-time, p-time-format)
     1130       + p-suffix
     1131       .
     1132   end.
     1133   function cur-time-print  returns character
     1134   :
     1135     define variable v-date as date      no-undo .
     1136     define variable v-time as integer   no-undo .
     1137     run cur-time in this-procedure
     1138       (output v-date
     1139       ,output v-time
     1140       ) .
     1141     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1142   end.
     1143   function cur-time-datetime returns datetime
     1144   :
     1145     define variable v-char as character no-undo .
     1146     define variable v-datetime as datetime no-undo .
     1147     v-char = cur-time-string().
     1148     v-datetime = datetime(v-char).
     1149     return  v-datetime.
     1150   end.
     1151   function cur-time-string-msec returns character
     1152   :
     1153     define variable v-date as datetime  no-undo .
     1154     v-date = now.
     1155     return string(v-date) .
     1156   end.
