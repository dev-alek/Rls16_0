      215   procedure create_obj-list :
      216      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      217      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      218      do
      219      on error undo, return error return-value
      220      :
      221         define buffer cli-obj for ub.clients .
      222         define variable p-var as integer no-undo .
      223         define buffer buf_obj-list for obj-list .
      224         find last buf_obj-list  use-index pi no-error .
      225         if available buf_obj-list
      226         then
      227            p-var = buf_obj-list.obj-id + 1.
      228         else
      229            p-var = 1.
      230         find first cli-obj where
      231                   cli-obj.obj-type = p-obj-type
      232               and cli-obj.obj-code = p-obj-code
      233         no-lock no-error.
      234         if available cli-obj
      235         then do:
      236            create buf_obj-list.
      237            assign
      238               buf_obj-list.obj-id   = p-var
      239               buf_obj-list.obj-code = cli-obj.obj-code
      240               buf_obj-list.obj-type = cli-obj.obj-type
      241               buf_obj-list.obj-name = cli-obj.obj-name
      242               buf_obj-list.db-num   = cli-obj.db-num
      243            .
      244         end.
      245      end.
      246   end.
