      649   define new shared stream PrnLibStream.
      650   procedure prn-lib-prn-file :
      651     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      652     define input parameter p-DIsabledoptions as integer no-undo .
      653     define variable v-report-name as character no-undo .
      654     define variable v-user-action as character no-undo .
      655     define variable v-printed     as logical   no-undo .
      656     define variable v-exist       as logical   no-undo .
      657     do
      658       on error undo, return error
      659       :
      660       run prn-lib-get-report-name  in this-procedure (
      661         input parParentProc
      662         ,output v-report-name
      663         ).
      664   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      665   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      666     (input  v-report-name
      667     ,input  2
      668     ,output v-exist
      669     )  .
      670       if NOT v-exist then
      671       DO:
      672         Message
      673           "Нет заданий на печать ! "
      674           view-as alert-box .
      675         Return  .
      676       End.
      677       run gbl/prnfilen.w
      678         (input  ""
      679         ,input  p-DisabledOptions
      680         ,input  string(v-report-name )
      681         ,input  7
      682         ,output v-user-action
      683         ,output v-printed
      684         ) .
      685       if v-printed then
      686       do:
      687         return "YES" .
      688       end.
      689       else
      690       do:
      691         return "NO" .
      692       end.
      693     end.
      694   end procedure.
      695   procedure prn-lib-open-stream :
      696     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      697     define input parameter p-page-size    as integer no-undo .
      698     define input parameter p-is-stream    as logical no-undo .
      699     define input parameter p-append       as logical no-undo .
      700     define variable v-report-name as character no-undo .
      701     do
      702       on error undo, return error
      703       :
      704       run prn-lib-get-report-name  in this-procedure (
      705         input parParentProc
      706         ,output v-report-name
      707         ).
      708       if p-is-stream then
      709       do:
      710         if p-append then
      711         do:
      712           output stream PrnLibStream to value( v-report-name )
      713             page-size value(p-page-size) append .
      714         end.
      715         if not p-append then
      716         do:
      717           output stream PrnLibStream to value( v-report-name )
      718             page-size value(p-page-size) .
      719         end.
      720       end.
      721       if not p-is-stream then
      722       do:
      723         if p-append then
      724         do:
      725           output to value( v-report-name )
      726             page-size value(p-page-size) append .
      727         end.
      728         if not p-append then
      729         do:
      730           output to value( v-report-name )
      731             page-size value(p-page-size) .
      732         end.
      733       end.
      734     end.
      735   end procedure.
      736   procedure prn-lib-open-exp :
      737     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      738     define input parameter p-is-stream    as logical no-undo .
      739     define input parameter p-is-append    as logical no-undo .
      740     define output parameter p-ReportFileName as char init "report" no-undo.
      741     define output parameter p-process as logical no-undo .
      742     define variable glog as logical no-undo .
      743     do
      744       on error undo, return error
      745       :
      746       SYSTEM-DIALOG GET-FILE p-ReportFileName
      747         TITLE      "Укажите путь"
      748         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      749         ASK-OVERWRITE
      750         CREATE-TEST-FILE
      751         SAVE-AS
      752         USE-FILENAME
      753         DEFAULT-EXTENSION "txt"
      754         UPDATE glog
      755         .
      756       if not glog then  return.
      757       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      758       if p-is-stream then
      759       do:
      760         if p-is-append then
      761         do:
      762           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      763         end.
      764         else
      765         do:
      766           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      767         end.
      768       end.
      769       else
      770       do:
      771         if p-is-append then
      772         do:
      773           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      774         end.
      775         else
      776         do:
      777           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      778         end.
      779       end.
      780       p-process = yes.
      781     end.
      782   end procedure.
      783   procedure prn-lib-get-report-name :
      784     define input parameter parParentProc  as widget-handle no-undo.
      785     define output parameter p-report-name as character no-undo .
      786     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      787   end procedure.
      788   procedure prn-lib-reportviewer-report-name :
      789     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      790     define input parameter p-report-name-html as character no-undo .
      791     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      792   end procedure.
      793   procedure prn-lib-reportviewer :
      794     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      795     define input parameter p-report-name-html as character no-undo .
      796     define input parameter p-param        as character no-undo .
      797     define variable v-excel           as character no-undo init 'TRUE' .
      798     define variable v-value-character as character no-undo .
      799     define variable v-value-integer   as character no-undo .
      800     define variable v-value-date      as date      no-undo .
      801     define variable v-value-decimal   as decimal   no-undo .
      802     define variable rep-excel         as logical   no-undo .
      803     define variable excel-string      as character no-undo .
      804     define variable v-param-type      as character no-undo .
      805     define variable v-tth             as handle    no-undo .
      806     run adm/shattri.p (
      807       input "get":U
      808       ,input  ""
      809       ,input  0
      810       ,input  'report-glob':U
      811       ,input  'rep-excel':U
      812       ,output v-value-character
      813       ,output v-value-date
      814       ,output v-value-decimal
      815       ,output v-value-integer
      816       ,output rep-excel
      817       ,output v-param-type
      818       ,INPUT-OUTPUT table-handle v-tth
      819       )  .
      820     if rep-excel then v-excel = "TRUE" .
      821     else v-excel = "FALSE" .
      822     if p-param eq ""
      823     then
      824        p-param = "EXCEL:" + v-excel.
      825     else
      826        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      827     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      828   end procedure.
