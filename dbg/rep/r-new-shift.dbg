     3461                   ,input p-report-id
     3462                   ,input ?
     3463                   ,input '3':U
     3464                   ,input substitute("На объекте &1 смена &2 с датой начала &3&4"  +                                  "еще не закрыта!&4Сменный отчет сделать нельзя!"                                  , rep-shift-store-name                                 ,ub.shift-obj.shift-num                                 ,string(ub.shift-obj.shift-date,"99/99/9999")                                 , chr(10))).
     3465         end.
     3466         RETURN.
     3467      end.
     3468      create temp-shift-obj .
     3469      assign
     3470         v-count = v-count + 1 .
     3471      assign
     3472         temp-shift-obj.num = v-count .
     3473      buffer-copy ub.shift-obj to temp-shift-obj .
     3474      if p-batch > 0
     3475         then
     3476      do:
     3477         find first buf_shift where
     3478            buf_shift.obj-type = p-obj-type
     3479            and buf_shift.obj-code = p-obj-code
     3480            and buf_shift.shift-date = x-date-end
     3481            and buf_shift.shift-num = x-shift-end no-error.
     3482         if not available buf_shift then
     3483         do:
     3484            create buf_shift.
     3485            assign
     3486               buf_shift.obj-type    = p-obj-type
     3487               buf_shift.obj-code    = p-obj-code
     3488               buf_shift.shift-date  = ub.shift-obj.shift-date
     3489               buf_shift.shift-num   = ub.shift-obj.shift-num
     3490               buf_shift.db-num      = ub.clients.db-num
     3491               buf_shift.obj-name    = ub.clients.obj-name
     3492               buf_shift.obj-address = v-obj-address
     3493               buf_shift.obj-phone   = v-obj-phone
     3494               buf_shift.db-num      = ub.clients.db-num
     3495               buf_shift.shift-name  = ub.shift-obj.shift-name
     3496               buf_shift.base-code   = p-base-code
     3497               buf_shift.curr-abbr   = p-curr-abbr
     3498               .
     3499            release buf_shift.
     3500         end.
     3501               if p-batch > 0 then do:      run write-log-and-file in p-log-handle (                 input 1                                          , input p-log-file-name                              , input 1                                          , input substitute("&1&2 cмена &3 П.&4", p-obj-type, p-obj-code, string(x-date-end, "99/99/9999"), x-shift-end)).    end.    else do:       run write-to-log in p-log-handle ( input substitute("&1&2 cмена &3 П.&4", p-obj-type, p-obj-code, string(x-date-end, "99/99/9999"), x-shift-end)).    end.
     3502      end.
     3503      FOR EACH ub.shift-staff No-LOCK WHERE
     3504         ub.shift-staff.obj-type   = p-obj-type AND
     3505         ub.shift-staff.obj-code   = p-obj-code AND
     3506         ub.shift-staff.shift-date = ub.shift-obj.shift-date AND
     3507         ub.shift-staff.shift-num  = ub.shift-obj.shift-num AND
     3508         ub.shift-staff.next-shift = no AND
     3509         ub.shift-staff.staff-role = no and
     3510         ub.shift-staff.psn-num    >= 0 :
     3511         if lookup( chr(32) + ub.shift-staff.name, rep-shift-for-opers ) = 0 then
     3512         do:
     3513            assign
     3514               rep-shift-for-opers = rep-shift-for-opers + (if rep-shift-for-opers > '' then chr(44) else "")  + ub.shift-staff.name
     3515               .
     3516         end.
     3517      end.
     3518      if rep-shift-for-opers > '' then
     3519         assign
     3520            rep-shift-for-opers1 = entry (1, rep-shift-for-opers, chr(44))
     3521            rep-shift-rol-oper   = "Оператор"
     3522                 no-error.
     3523      if num-entries (rep-shift-for-opers, chr(44)) >= 2 then
     3524         assign
     3525            rep-shift-for-opers2 = entry (2, rep-shift-for-opers, chr(44))
     3526            rep-shift-rol-oper2  = "Оператор"
     3527                 no-error.
     3528      FOR EACH ub.shift-staff No-LOCK WHERE
     3529         ub.shift-staff.obj-type = p-obj-type AND
     3530         ub.shift-staff.obj-code = p-obj-code AND
     3531         ub.shift-staff.shift-date = temp-shift-obj.shift-date AND
     3532         ub.shift-staff.shift-num  = temp-shift-obj.shift-num AND
     3533         ub.shift-staff.next-shift = no AND
     3534         ub.shift-staff.staff-role = yes and
     3535         ub.shift-staff.psn-num    >= 0 :
     3536         if lookup( chr(32) + ub.shift-staff.name, rep-shift-for-mng ) = 0 then
     3537         do:
     3538            assign
     3539               rep-shift-for-mng = rep-shift-for-mng + (if rep-shift-for-mng > '' then chr(44) else "")  + ub.shift-staff.name
     3540               .
     3541         end.
     3542      end.
     3543      if rep-shift-for-mng > '' then
     3544         assign
     3545            rep-shift-for-mng1 = entry (1, rep-shift-for-mng, chr(44))
     3546            rep-shift-rol-mng  = "Старший оператор"
     3547                 no-error.
     3548      if num-entries (rep-shift-for-mng, chr(44)) >= 2 then
     3549         assign
     3550            rep-shift-for-mng2 = entry (2, rep-shift-for-mng, chr(44))
     3551            rep-shift-rol-mng2 = "Старший оператор"
     3552                 no-error.
     3553   end.
     3554   rep-shift-for-opers =  breakstr(rep-shift-for-opers, 44, input-output rep-shift-for-opers1, input-output rep-shift-for-opers2).
     3555   find first temp-shift-obj where temp-shift-obj.num = 1 no-error .
     3556   if not available temp-shift-obj Then
     3557   DO:
