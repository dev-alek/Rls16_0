     1303   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1304   define variable v-waitfram-action01         as character   no-undo .
     1305   define variable v-waitfram-action02         as character   no-undo .
     1306   define variable v-waitfram-action03         as character   no-undo .
     1307   define variable mWaitFramTextBeg            as character   no-undo.
     1308   define variable mWaitFramTextEnd            as character   no-undo.
     1309   define variable mWaitFramView               as logical     no-undo.
     1310   define variable mWaitProcEvent              as logical     no-undo init yes.
     1311   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1312   define variable mWaitFramStop               as logical     no-undo.
     1313   define variable mWaitFramStopUser           as logical     no-undo.
     1314   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1315   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1316   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1317   define button B-WaitFramStop auto-end-key
     1318        label "Стоп"
     1319        size 10 by 1 tooltip "Остоновить процесс".
     1320   define button B-viewProcInfo
     1321        label "Информация"
     1322        size 15 by 1 tooltip "Информация о процесс".
     1323   define frame waitfram
     1324     v-waitfram-action01 format "x(72)" no-label skip
     1325     v-waitfram-action02 format "x(72)" no-label skip
     1326     v-waitfram-action03 format "x(72)" no-label skip
     1327     B-viewProcInfo
     1328     B-WaitFramStop at row 4 col 30
     1329     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1330     .
     1331   define new global shared variable mBatchMode as logical no-undo init ?.
     1332   define variable mFramBachModHandle as handle no-undo.
     1333   mFramBachModHandle = frame waitfram:handle.
     1334   define variable mFameOldVis as logical no-undo.
     1335   define variable mVisCUrentVin as logical no-undo.
     1336   if session:batch-mode
     1337   then
     1338      mBatchMode = yes.
     1339   if mBatchMode = ? then do:
     1340     mVisCUrentVin = current-window:visible.
     1341     mFameOldVis = mFramBachModHandle:visible.
     1342     mFramBachModHandle:visible  = yes.
     1343     mBatchMode = mFramBachModHandle:visible ne yes.
     1344     mFramBachModHandle:visible = mFameOldVis.
     1345     current-window:visible = mVisCUrentVin.
     1346   end.
     1347    if  log-manager:logfile-name ne ?
     1348     then DO:
     1349         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1350         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1351         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1352     end.
     1353   on choose of B-WaitFramStop in frame waitfram
     1354   do:
     1355     mWaitFramStop = yes.
     1356     mWaitFramStopUser = yes.
     1357   end.
     1358   function waitfram-check-timeout returns logical():
     1359      define variable vtime as int64 no-undo.
     1360      if mWaitFramStopTimeOut
     1361      then
     1362         return yes.
     1363      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1364      if     mWaitFramTimeOut ne ?
     1365         and mWaitFramTimeOut ne 0
     1366         and mWaitFramTimeOut lt vtime
     1367      then do:
     1368         mWaitFramStopTimeOut = yes.
     1369      end.
     1370      return mWaitFramStopTimeOut.
     1371   end.
     1372   procedure waitfram-hide :
     1373     if not session:batch-mode
     1374     then do
     1375     on error undo, return error return-value
     1376     :
     1377       pause 0 before-hide .
     1378       if not mBatchMode then
     1379         hide frame waitfram .
     1380     if     not mWaitFramView
     1381        and mWaitProcEvent
     1382     then
     1383       process events .
     1384     end.
     1385   end procedure.
     1386   procedure waitfram-show :
     1387     define input  parameter p-message as character no-undo .
     1388     define variable v-left-margin as integer   no-undo .
     1389     if not session:batch-mode
     1390     then do
     1391     on error undo, return error return-value
     1392     :
     1393       if length(p-message) <= 70 then do:
     1394         assign
     1395           v-left-margin = integer((70 - length(p-message)) / 2)
     1396         .
     1397         assign
     1398           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1399         .
     1400         assign
     1401           v-waitfram-action01 = " "
     1402           v-waitfram-action02 = " "
     1403                                    + fill(" ", v-left-margin)
     1404                                    + p-message
     1405           v-waitfram-action03 = " "
     1406         .
     1407       end.
     1408       else do:
     1409         define variable vRindex1 as integer no-undo.
     1410         define variable vRindex2 as integer no-undo.
     1411         vRindex1 = r-index(p-message," ",70).
     1412         if vRindex1 = 0
     1413         then
     1414            vRindex1 = 70.
     1415         if length(p-message)  <= vRindex1 + 70 then do:
     1416           assign
     1417             v-waitfram-action01 = " "
     1418             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1419             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1420           .
     1421         end.
     1422         else do:
     1423           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1424           if vRindex2 <= vRindex1
     1425           then
     1426              vRindex2 = vRindex1 + 70.
     1427           assign
     1428             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1429             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1430             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1431           .
     1432         end.
     1433       end.
     1434       B-viewProcInfo:visible   in frame waitfram = no.
     1435       B-viewProcInfo:sensitive in frame waitfram = no.
     1436       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1437       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1438       if  (   mWaitFramView
     1439          or  mWaitProcEvent)
     1440          and not mBatchMode
     1441       then
     1442          display
     1443             v-waitfram-action01 skip
     1444             v-waitfram-action02 skip
     1445             v-waitfram-action03 skip
     1446          with frame waitfram .
     1447       if     mWaitFramView
     1448          then do:
     1449             if     mWaitFramInterval ne ?
     1450                and not mBatchMode
     1451             then
     1452                wait-for go of frame waitfram pause mWaitFramInterval.
     1453          end.
     1454          else
     1455             if     mWaitProcEvent
     1456                and not mBatchMode
     1457             then
     1458                process events .
     1459     end.
     1460   end procedure.
     1461      procedure waitfram-show-this:
     1462         define input  parameter iInterval as int64 no-undo.
     1463         define variable vtime as int64 no-undo.
     1464         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1465         mWaitFramInterval = iInterval.
     1466         run waitfram-show (substitute("&1&2 &3&4" ,
     1467                                       mWaitFramTextBeg ,
     1468                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1469                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1470                                       mWaitFramTextEnd
     1471                                      )
     1472                           ).
     1473      end.
     1474      procedure WaitFramRunPause:
     1475         define input  parameter iInterval as dec no-undo.
     1476         define variable vStart  as datetime-tz no-undo.
     1477         define variable vend    as datetime-tz no-undo.
     1478         define variable vint as int64 no-undo.
     1479         define variable vOk as logical no-undo.
     1480         vStart = now.
     1481         vend   = vStart.
     1482         publish "WaitFramPause" (iInterval,output vOk).
     1483         vend   =  now.
     1484         vint = vend - vStart.
     1485         vint = iInterval - vint / 1000.
     1486         if     not mWaitFramStop
     1487            and (   vint > 0
     1488                 or (    not vOk
     1489                     and iInterval eq ?
     1490                     )
     1491                 )
     1492         then
     1493            run waitfram-show-this (iInterval).
     1494         vend   =  now.
     1495         vint = vend - vStart.
     1496         vint = iInterval - vint / 1000.
     1497         if     not mWaitFramStop
     1498            and vint > 0
     1499         then do:
     1500            run gbl/pause.p (vint * 1000).
     1501         end.
     1502         if iInterval ne ?
     1503         then
     1504            publish "WaitFramStop".
     1505         waitfram-check-timeout().
     1506      end.
     1507      procedure WaitFramWaitFor:
     1508         define input  parameter iInterval as dec no-undo.
     1509         assign
     1510            mWaitFramStartProc   = now
     1511            mWaitFramStopUser    = no
     1512            mWaitFramStopTimeOut = no
     1513         .
     1514         block-wait:
     1515         do while not mWaitFramStop:
     1516            run WaitFramRunPause (iInterval).
     1517            if  waitfram-check-timeout()
     1518            then do:
     1519               leave block-wait.
     1520            end.
     1521         end.
     1522         run waitfram-hide.
     1523      end.
     1524   procedure waitfram-join :
     1525     define input  parameter p-line-1  as character no-undo .
     1526     define input  parameter p-line-2  as character no-undo .
     1527     define input  parameter p-line-3  as character no-undo .
     1528     define output parameter p-message as character no-undo .
     1529     do
     1530     on error undo, return error return-value
     1531     :
     1532       assign
     1533         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1534                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1535                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1536       .
     1537     end.
     1538   end procedure.
     1539   function waitfram-join-function returns character
     1540     (input p-line-1 as character
     1541     ,input p-line-2 as character
     1542     ,input p-line-3 as character
     1543     ).
     1544     define variable v-message as character no-undo .
     1545     run waitfram-join in this-procedure
     1546       (input  p-line-1
     1547       ,input  p-line-2
     1548       ,input  p-line-3
     1549       ,output v-message
     1550       ) .
     1551     return v-message .
     1552   end function .
