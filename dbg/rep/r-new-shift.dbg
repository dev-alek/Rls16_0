     3559      if v-write-xml-error then
     3560      do:
     3561         run cb_write-report-error in p-parent-handle ( input p-rebh
     3562            ,input p-report-id
     3563            ,input ?
     3564            ,input '3':U
     3565            ,input substitute("На объекте &1 нет смены &2 с датой начала &3&4" +                                 "Исправьте запрашиваемые данные!"                                 , rep-shift-store-name                                 , X-shift-start                                 ,string(X-date-start,"99/99/9999")                                 , chr(10) )).
     3566      end.
     3567      RETURN.
     3568   End.
     3569   assign
     3570      x-date-Start          = temp-shift-obj.shift-date
     3571      X-Shift-Start         = temp-shift-obj.shift-num
     3572      v-rep-shift-open-date = temp-shift-obj.open-date
     3573      v-rep-shift-open-time = temp-shift-obj.open-time
