     3433   end.
     3434   if v-param_shft-qty = "" then v-param_shft-qty = "system" .
     3435   define temp-table temp-shift-obj no-undo like ub.shift-obj
     3436      FIELD num as integer
     3437      INDEX ii IS UNIQUE num
     3438      .
     3439   RUN fmtcli-get-client IN THIS-PROCEDURE ( INPUT  p-obj-type
     3440      , INPUT  p-obj-code
     3441      ) .
     3442   assign
     3443      v-obj-address = ( if v-fmtcli-index <> '':U then ( v-fmtcli-index ) else '':U )
     3444                               + ( if v-fmtcli-full-addres <> '':U then ( v-fmtcli-full-addres ) else '':U )
     3445      v-obj-phone   = ( if v-fmtcli-phone <> '':U then v-fmtcli-phone else '':U )
     3446      .
     3447   for each ub.shift-obj  no-lock
     3448      where ub.shift-obj.obj-code   =  p-obj-code
     3449      and ub.shift-obj.obj-type   =  p-obj-type
     3450      and ub.shift-obj.shift-date >= X-date-Start
     3451      and ub.shift-obj.shift-date <= X-date-End
     3452      :
     3453      if ub.shift-obj.shift-date = X-date-Start and ub.shift-obj.shift-num < X-Shift-Start then next .
     3454      if ub.shift-obj.shift-date = X-date-End   and ub.shift-obj.shift-num > X-Shift-End then next .
     3455      if ub.shift-obj.status_ <> 'зкр':U then
     3456      do:
     3457               if p-batch > 0 then do:      run write-log-and-file in p-log-handle (                 input 1                                          , input p-log-file-name                              , input 1                                          , input substitute("На объекте &1 смена &2 с датой начала &3&4"  +                                  "еще не закрыта!&4Сменный отчет сделать нельзя!"                                  , rep-shift-store-name                                 ,ub.shift-obj.shift-num                                 ,string(ub.shift-obj.shift-date,"99/99/9999")                                 , chr(10))).    end.    else do:       run write-to-log in p-log-handle ( input substitute("На объекте &1 смена &2 с датой начала &3&4"  +                                  "еще не закрыта!&4Сменный отчет сделать нельзя!"                                  , rep-shift-store-name                                 ,ub.shift-obj.shift-num                                 ,string(ub.shift-obj.shift-date,"99/99/9999")                                 , chr(10))).    end.
     3458         if v-write-xml-error then
