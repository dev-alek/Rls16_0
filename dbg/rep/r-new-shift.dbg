     3788                  ,input '3':U
     3789                  ,input substitute("&1 &2 &3&4Ошибка при вызове программы chk-ahz.p&4&5&4&6"                                    ,vss-workfile                                    ,vss-revision                                    ,vss-description                                    ,chr(10)                                   ,error-status :get-message(1)                                    ,return-value )).
     3790            end.
     3791            return error .
     3792         end.
     3793         if X-date-start < v-previous-shift-date
