     6935   procedure last-line-tog-html :
     6936      define input parameter v-report-name-html     as character no-undo .
     6937      find first temp-shift-obj  where temp-shift-obj.num = v-count no-error .
     6938      if available temp-shift-obj then
     6939      do:
     6940         assign
     6941            x-date-End             = temp-shift-obj.shift-date
     6942            X-Shift-End            = temp-shift-obj.shift-num
     6943            v-rep-shift-close-date = temp-shift-obj.close-date
     6944            v-rep-shift-close-time = temp-shift-obj.close-time
     6945            .
     6946      end.
     6947      FIND FIRST ub.shift-staff No-LOCK WHERE
     6948         ub.shift-staff.obj-type   = p-obj-type AND
     6949         ub.shift-staff.obj-code   = p-obj-code AND
     6950         ub.shift-staff.shift-date = x-date-End AND
     6951         ub.shift-staff.shift-num  = X-Shift-End AND
     6952         ub.shift-staff.staff-role = yes and
     6953         ub.shift-staff.psn-num    >= 0 No-ERROR.
     6954      assign
     6955         rep-shift-for-mng-end = if available ub.shift-staff then string(ub.shift-staff.name, "X(30)") else "".
     6956      rep-shift-rol-mng-end = "Старший оператор"
     6957         .
     6958      if v-param-code = 1 then
     6959      do:
     6960         output stream OutStr-html to value(v-report-name-html) append convert target 'UTF-8' .
     6961         put stream OutStr-html unformatted
     6962            substitute (
     6963            '
     6964                 <tfoot>
