     1354       string( word-sum-buf-1, "x(97)":U  ) skip
     1355       string( word-sum-buf-2, "x(125)":U ) skip
     1356       string( word-sum-buf-3, "x(125)":U ) skip
     1357     .
     1358     if word-sum-buf-2 <> '':U
     1359     then do:
     1360       put stream text_out unformatted
     1361         skip
     1362       .
     1363       if word-sum-buf-3 <> '':U
     1364       then do:
     1365         put stream text_out unformatted
     1366           skip
     1367         .
     1368       end.
     1369     end.
     1370     put stream text_out unformatted
     1371       '    МОЛ:        _________________________     _________________________     _________________________'                         skip
     1372       '                       должность                       подпись                 расшифровка подписи   '                         skip( 1 )
     1373       '    Бухгалтер:  _________________________     _________________________'                                                       skip
     1374       '                       подпись                    расшифровка подписи  '                                                       skip( 1 )
     1375     .
     1376     run r-resort-write-cell-data in this-procedure
     1377       ( input "h_SaleTot":U
     1378       , input trim( string( sum-sale-total, "->>>>>>9.99":U ) )
     1379       ) .
     1380     run r-resort-write-cell-data in this-procedure
     1381       ( input "h_CostTot":U
     1382       , input trim( string( sum-cost-total, "->>>>>>9.99":U ) )
     1383       ) .
     1384     run r-resort-write-cell-data in this-procedure
     1385       ( input "h_WordTot":U
     1386       , input 'Разница сумма розничная: ' + word-sum-total
     1387       ) .
     1388     run waitfram-hide  in this-procedure .
     1389     run r-resort-close in this-procedure .
     1390     output stream text_out close .
     1391   if g#quest-print = false
     1392   then do:
     1393     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
     1394                                         7, (if 2 >= 8 then 2 else 0), 0, 0,
     1395                                         OUTPUT g#log ).
     1396   end.
     1397   else do:
     1398     os-command silent
     1399       value( "COPY /b " +
     1400         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
     1401         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
     1402         string( session:temp-directory) +  "$" + string( g#report-num )
     1403                 ) .
     1404     os-command silent
     1405       value( "COPY /b " +
     1406         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
     1407         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
     1408         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
     1409                 ) .
     1410   end.
     1411   end.
     1412   procedure get-center-line :
     1413     define  input parameter p-in-string  as character no-undo .
     1414     define  input parameter p-rep-width  as integer   no-undo .
     1415     define output parameter p-out-string as character no-undo .
     1416     do
     1417     on error undo, return error return-value
     1418     :
     1419       if length( p-in-string ) < p-rep-width
     1420       then do:
     1421         assign
     1422           p-out-string = fill( ' ':U, integer( ( p-rep-width - length( p-in-string ) ) * 0.5 ) ) + p-in-string
     1423         .
     1424       end.
     1425       else do:
     1426         assign
     1427           p-out-string = p-in-string
     1428         .
     1429       end.
     1430     end.
     1431   end procedure.
