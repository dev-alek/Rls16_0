     1109   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1110   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     1111     (input  bf_trn-doc.obj-type
     1112     ,input  bf_trn-doc.obj-code
     1113     ,input  bf_goods-out.gds-code
     1114     ,input  0
     1115     ,input  bf_trn-doc.fact-order
     1116     ,output v-doc-num
     1117     ,output price-sale-out
     1118     ,output d-road-tax
     1119     ,output d-excise
     1120     ) no-error .
     1121       if error-status :error
     1122       then do:
     1123         run waitfram-hide in this-procedure .
     1124         message
     1125           'Не могу определить текущие продажные цены для оприходованного товара.' skip
     1126           bf_goods-in.artic bf_goods-in.prod-type bf_goods-in.prod-code '.'
     1127         view-as alert-box error .
     1128         undo, return error .
     1129       end.
     1130        for each bf_parts-out no-lock where
     1131           bf_parts-out.out-code  = bf_trn-doc.doc-code          and
     1132           bf_parts-out.obj-type  = bf_trn-doc.obj-type          and
     1133           bf_parts-out.obj-code  = bf_trn-doc.obj-code          and
     1134           bf_parts-out.artic     = bf_goods-out.artic           and
     1135           bf_parts-out.prod-type = bf_goods-out.prod-type       and
     1136           bf_parts-out.prod-code = bf_goods-out.prod-code       and
     1137           bf_parts-out.fact-qnty < 0  on error undo, return error return-value :
     1138           if bf_parts-out.part-code = bf_parts-root.orig-part-code then
     1139           do:
     1140              assign
     1141                 sum-sale-out  = sum-sale-out  + price-sale-out          * bf_parts-out.fact-qnty
     1142                 sum-cost-out  = sum-cost-out  + bf_parts-out.price-rubl * bf_parts-out.fact-qnty
     1143                 fact-qnty-out = fact-qnty-out + bf_parts-out.fact-qnty
     1144                 .
     1145           end.
     1146           else
     1147           do:
     1148              if bf_parts-out.out-code   = bf_parts-root.in-code then
     1149              do:
     1150                 assign
     1151                    sum-sale-out  = sum-sale-out  + price-sale-out          * bf_parts-out.fact-qnty
     1152                    sum-cost-out  = sum-cost-out  + bf_parts-out.price-rubl * bf_parts-out.fact-qnty
     1153                    fact-qnty-out = fact-qnty-out + bf_parts-out.fact-qnty
     1154                    .
     1155              end.
     1156           end.
     1157        end.
     1158        for each bf_parts-in   no-lock where
     1159           bf_parts-in.out-code   = bf_trn-doc.doc-code         and
     1160           bf_parts-in.obj-type   = bf_trn-doc.obj-type         and
     1161           bf_parts-in.obj-code   = bf_trn-doc.obj-code         and
     1162           bf_parts-in.artic      = bf_goods-in.artic           and
     1163           bf_parts-in.prod-type  = bf_goods-in.prod-type       and
     1164           bf_parts-in.prod-code  = bf_goods-in.prod-code       and
     1165           bf_parts-in.fact-qnty > 0     on error undo, return error return-value :
     1166           if bf_parts-in.part-code  = bf_parts-root.part-code then
     1167           do:
     1168              assign
