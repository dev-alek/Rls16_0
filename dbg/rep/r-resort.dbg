     1016                                                   + '|' skip
     1017       space( 59 ) '-----------------------------------' skip( 1 )
     1018       'Примечание: ' substring( replace( bf_trn-doc.PS, chr(10), ' ':U ), 1, 125 ) skip
     1019       'Дата проведения: ' string( t_inv-date, "99/99/9999":U ) skip
     1020     .
     1021     put stream text_out unformatted
     1022       '-----------------------------------------------------------------------------------------------------------------------------------' skip
     1023       '|  N | Номенклатурный |     Наименование, сорт,                        |Ед.|Количест-|  Цена   |   Сумма   |     %     |   Сумма   |' skip
     1024       '| п/п|     номер      |        размер                                  |изм|   во    |Розничная| Розничная | Отклонения|  Учетная  |' skip
     1025     .
     1026     run r-resort-init            in this-procedure .
     1027         v-doc-date =     string( entry(2,string(bf_trn-doc.doc-date),"/") + "/" +
     1028       entry(1,string(bf_trn-doc.doc-date),"/") + "/" +
     1029       entry(3,string(bf_trn-doc.doc-date),"/"))
     1030       .
