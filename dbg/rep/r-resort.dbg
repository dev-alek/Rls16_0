     1261           , input trim( string( tt-resort-out.price-sale,   ">>>>>9.99":U ) )
     1262           , input trim( string( tt-resort-out.sum-sale,     "->>>>>>9.99":U ) )
     1263           , input trim( string( tt-resort-out.d-per-cent,   "->>>>>>9.<<":U ) )
     1264           , input trim( string( tt-resort-out.sum-cost,     "->>>>>>9.99":U ) )
     1265           ) .
