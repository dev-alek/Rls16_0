      756   .
      757   FUNCTION Roubles RETURNS CHARACTER ( INPUT i-sum AS DECIMAL ) :
      758     DEFINE VARIABLE Rouble AS CHARACTER NO-UNDO.
      759     RUN get-roubles IN THIS-PROCEDURE ( INPUT i-sum, OUTPUT Rouble ) NO-ERROR.
      760     RETURN ( IF ERROR-STATUS :ERROR THEN "":U ELSE Rouble ).
      761   END FUNCTION.
      762   PROCEDURE get-roubles :
      763     DEFINE  INPUT PARAMETER p-sum AS DECIMAL   NO-UNDO.
      764     DEFINE OUTPUT PARAMETER p-rub AS CHARACTER NO-UNDO.
      765     DEFINE VARIABLE Word   AS CHARACTER NO-UNDO.
      766     DEFINE VARIABLE jj     AS INTEGER   NO-UNDO.
      767     DEFINE VARIABLE j_last AS INTEGER   NO-UNDO.
      768     DEFINE VARIABLE l_prev AS LOGICAL   NO-UNDO.
      769     DO ON ERROR UNDO, RETURN ERROR :
      770       ASSIGN Word   = STRING( ABS( p-sum ), "999999999999999999999999999999.99":U )
      771              jj     = LENGTH( Word )
      772              j_last = INTEGER( SUBSTRING( Word, jj - 3, 1 ) )
      773              l_prev =        ( SUBSTRING( Word, jj - 4, 1 ) = "1" ).
      774       IF      j_last = 1                THEN DO: ASSIGN p-rub = ( IF l_prev = YES THEN "рублей" ELSE "рубль" ).  END.
      775       ELSE IF j_last > 1 AND j_last < 5 THEN DO: ASSIGN p-rub = ( IF l_prev = YES THEN "рублей" ELSE "рубля" ). END.
      776                                         ELSE DO: ASSIGN p-rub = "рублей". END.
      777     END.
      778   END PROCEDURE.
      779   FUNCTION Copecks RETURNS CHARACTER ( INPUT i-sum AS DECIMAL ) :
      780     DEFINE VARIABLE Copeck AS CHARACTER NO-UNDO.
      781     RUN get-copecks IN THIS-PROCEDURE ( INPUT i-sum, OUTPUT Copeck ) NO-ERROR.
      782     RETURN ( IF ERROR-STATUS :ERROR THEN "":U ELSE Copeck ).
      783   END FUNCTION.
      784   PROCEDURE get-copecks :
      785     DEFINE  INPUT PARAMETER p-sum AS DECIMAL   NO-UNDO.
      786     DEFINE OUTPUT PARAMETER p-kop AS CHARACTER NO-UNDO.
      787     DEFINE VARIABLE Word   AS CHARACTER NO-UNDO.
      788     DEFINE VARIABLE jj     AS INTEGER   NO-UNDO.
      789     DEFINE VARIABLE j_last AS INTEGER   NO-UNDO.
      790     DEFINE VARIABLE l_prev AS LOGICAL   NO-UNDO.
      791     DO ON ERROR UNDO, RETURN ERROR :
      792       ASSIGN  Word   = STRING( ABS( p-sum ), "999999999999999999999999999999.99":U )
      793               jj     = LENGTH( Word )
      794               j_last = INTEGER( SUBSTRING( Word, jj,     1 ) )
      795               l_prev =        ( SUBSTRING( Word, jj - 1, 1 ) = "1" ).
      796       IF           j_last = 1                THEN DO:
      797         ASSIGN p-kop = ( IF l_prev = YES THEN "копеек" ELSE "копейка" ).
      798       END. ELSE IF j_last > 1 AND j_last < 5 THEN DO:
      799         ASSIGN p-kop = ( IF l_prev = YES THEN "копеек" ELSE "копейки" ).
      800       END.                                   ELSE DO:
      801         ASSIGN p-kop = "копеек".
      802       END.
      803     END.
      804   END PROCEDURE.
      805   FUNCTION get-decade-word RETURNS CHARACTER ( INPUT i-dec AS INTEGER, INPUT i-num AS INTEGER ) :
      806     DEFINE VARIABLE v-grade AS CHARACTER NO-UNDO.
      807     RUN get-number-grade IN THIS-PROCEDURE ( INPUT i-dec, INPUT i-num, OUTPUT v-grade ) NO-ERROR.
      808     RETURN ( IF ERROR-STATUS :ERROR THEN "":U ELSE v-grade ).
      809   END FUNCTION.
      810   FUNCTION Word-Sum RETURNS CHARACTER ( INPUT i-sum AS DECIMAL ) :
      811     DEFINE VARIABLE OutSum AS CHARACTER NO-UNDO.
      812     RUN conv-sum-to-word IN THIS-PROCEDURE ( INPUT i-sum, OUTPUT OutSum ) NO-ERROR.
      813     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE OutSum ).
      814   END FUNCTION.
      815   PROCEDURE get-number-grade :
      816     DEFINE  INPUT PARAMETER p-dec AS INTEGER   NO-UNDO.
      817     DEFINE  INPUT PARAMETER p-num AS INTEGER   NO-UNDO.
      818     DEFINE OUTPUT PARAMETER p-res AS CHARACTER NO-UNDO.
      819     DEFINE VARIABLE v-list AS CHARACTER NO-UNDO.
      820     DO ON ERROR UNDO, RETURN ERROR :
      821       IF      p-dec = 1 THEN DO: ASSIGN v-list = ",один,два,три,четыре,пять,шесть,семь,восемь,девять".    END.
      822       ELSE IF p-dec = 2 THEN DO: ASSIGN v-list = "десять,одиннадцать,двенадцать,тринадцать,четырнадцать,пятнадцать,шестнадцать,семнадцать,восемнадцать,девятнадцать".    END.
      823       ELSE IF p-dec = 3 THEN DO: ASSIGN v-list = ",,двадцать,тридцать,сорок,пятьдесят,шестьдесят,семьдесят,восемьдесят,девяносто".   END.
      824       ELSE IF p-dec = 4 THEN DO: ASSIGN v-list = ",сто,двести,триста,четыреста,пятьсот,шестьсот,семьсот,восемьсот,девятьсот".  END.
      825                         ELSE DO: ASSIGN v-list = ",,,,,,,,,". END.
      826       ASSIGN p-res = ENTRY( p-num + 1, v-list ).
      827     END.
      828   END PROCEDURE.
      829   PROCEDURE conv-sum-to-word :
      830     DEFINE  INPUT PARAMETER p-sum AS DECIMAL   NO-UNDO.
      831     DEFINE OUTPUT PARAMETER p-res AS CHARACTER NO-UNDO.
      832     DEFINE VARIABLE Formatted  AS CHARACTER NO-UNDO.
      833     DEFINE VARIABLE Word       AS CHARACTER NO-UNDO.
      834     DEFINE VARIABLE OutSum     AS CHARACTER NO-UNDO.
      835     DEFINE VARIABLE jj         AS INTEGER   NO-UNDO.
      836     DO ON ERROR UNDO, RETURN ERROR :
      837       ASSIGN Formatted = STRING( ABS( p-sum ), "999999999999999.99":U ) NO-ERROR.
      838       IF ERROR-STATUS :ERROR THEN DO:
      839         ASSIGN p-res = ?.
      840         UNDO, RETURN ERROR.
      841       END.
      842       DO jj = ( LENGTH( Formatted ) - 3 ) TO 3 BY -3 :
      843         IF SUBSTRING( Formatted, jj - 2, 3 ) = "000" THEN DO: NEXT. END.
      844         IF jj < 15 THEN DO:
      845           ASSIGN Word = ENTRY( jj, ",,триллион,,,миллиард,,,миллион,,,тысяч" ).
      846           IF SUBSTRING( Formatted, jj,     1 )  = "1" AND
      847              SUBSTRING( Formatted, jj - 1, 1 ) <> "1" AND jj = 12 THEN DO: ASSIGN Word = TRIM( Word ) + "а". END.
      848           IF SUBSTRING( Formatted, jj, 1 ) = "2" OR
      849              SUBSTRING( Formatted, jj, 1 ) = "3" OR
      850              SUBSTRING( Formatted, jj, 1 ) = "4" THEN DO:
      851             IF jj = 12 THEN DO:
      852               IF SUBSTRING( Formatted, jj - 1, 1 ) <> "1" THEN DO: ASSIGN Word = TRIM( Word ) + "и". END.
      853             END.       ELSE DO:
      854               IF SUBSTRING( Formatted, jj - 1, 1 ) <> "1" THEN DO: ASSIGN Word = TRIM( Word ) + "а". END.
      855             END.
      856           END.
      857           IF ( SUBSTRING( Formatted, jj,     1 ) <> "1" AND
      858                SUBSTRING( Formatted, jj,     1 ) <> "2" AND
      859                SUBSTRING( Formatted, jj,     1 ) <> "3" AND
      860                SUBSTRING( Formatted, jj,     1 ) <> "4" AND jj <> 12 ) OR
      861              ( SUBSTRING( Formatted, jj - 1, 1 )  = "1" AND jj <  12 ) THEN DO: ASSIGN Word = TRIM( Word ) + "ов". END.
      862           IF Word <> "":U THEN DO: ASSIGN OutSum = TRIM( Word ) + " ":U + TRIM( OutSum ). END.
      863         END.
      864         IF SUBSTRING( Formatted, jj - 1, 1 ) <> "1" THEN DO:
      865           IF      jj = 12 AND SUBSTRING( Formatted, jj, 1 ) = "1" THEN DO: ASSIGN Word = "одна". END.
      866           ELSE IF jj = 12 AND SUBSTRING( Formatted, jj, 1 ) = "2" THEN DO: ASSIGN Word = "две".  END.
      867           ELSE DO: ASSIGN Word = get-decade-word( 1, INTEGER( SUBSTRING( Formatted, jj, 1 ) ) ). END.
      868           IF Word <> "":U THEN DO: ASSIGN OutSum = TRIM( Word ) + " ":U + TRIM( OutSum ). END.
      869           ASSIGN Word = get-decade-word( 3, INTEGER( SUBSTRING( Formatted, jj - 1, 1 ) ) ).
      870         END.                                        ELSE DO:
      871           ASSIGN Word = get-decade-word( 2, INTEGER( SUBSTRING( Formatted, jj,     1 ) ) ).
      872         END.
      873         IF Word <> "":U THEN DO: ASSIGN OutSum = TRIM( Word ) + " ":U + TRIM( OutSum ). END.
      874         ASSIGN Word = get-decade-word( 4, INTEGER( SUBSTRING( Formatted, jj - 2, 1 ) ) ).
      875         IF Word <> "":U THEN DO: ASSIGN OutSum = TRIM( Word ) + " ":U + TRIM( OutSum ). END.
      876       END.
      877       ASSIGN OutSum = CAPS( SUBSTRING( OutSum, 1, 1 ) ) + SUBSTRING( OutSum, 2 ).
      878       IF OutSum = "":U AND TRUNCATE( p-sum, 0 ) = 0 THEN DO: ASSIGN OutSum = "Ноль". END.
      879       ASSIGN p-res = TRIM( OutSum ).
      880     END.
      881   END PROCEDURE.
      882   FUNCTION Total-Word RETURNS CHARACTER ( INPUT i-sum AS DECIMAL, INPUT i-curr AS CHARACTER, INPUT i-part AS CHARACTER ) :
      883     DEFINE VARIABLE word_sum AS CHARACTER NO-UNDO.
      884     RUN get-total-word IN THIS-PROCEDURE ( INPUT i-sum, INPUT i-curr, INPUT i-part, OUTPUT word_sum ) NO-ERROR.
      885     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE word_sum ).
      886   END FUNCTION.
      887   PROCEDURE get-total-word :
      888     DEFINE  INPUT PARAMETER p-sum  AS DECIMAL   NO-UNDO.
      889     DEFINE  INPUT PARAMETER p-curr AS CHARACTER NO-UNDO.
      890     DEFINE  INPUT PARAMETER p-part AS CHARACTER NO-UNDO.
      891     DEFINE OUTPUT PARAMETER p-word AS CHARACTER NO-UNDO.
      892     DO ON ERROR UNDO, RETURN ERROR :
      893       ASSIGN p-word = Word-Sum( p-sum ).
      894                  ASSIGN p-word = ( IF p-sum < 0 THEN "- " ELSE "":U ) + TRIM(
      895                   p-word
      896                  ) +
      897                         " ":U + p-curr + " ":U +
      898                         SUBSTRING( STRING( ABS( p-sum ), "999999999999999999999999999999.99" ), 32, 2 ) +
      899                         " ":U + p-part + ".".
      900                           END.
      901   END PROCEDURE.
      902   FUNCTION Sparse RETURNS CHARACTER ( INPUT p-instring AS CHARACTER ) :
      903     DEFINE VARIABLE v-outstring AS CHARACTER NO-UNDO.
      904     RUN get-sparsed-string IN THIS-PROCEDURE ( INPUT p-instring, OUTPUT v-outstring ) NO-ERROR.
      905     RETURN ( IF ERROR-STATUS :ERROR THEN p-instring ELSE v-outstring ).
      906   END FUNCTION.
      907   PROCEDURE get-sparsed-string :
      908     DEFINE  INPUT PARAMETER p-instring  AS CHARACTER NO-UNDO.
      909     DEFINE OUTPUT PARAMETER p-outstring AS CHARACTER NO-UNDO INITIAL "":U.
      910     DEFINE VARIABLE jj AS INTEGER NO-UNDO.
      911     DO ON ERROR UNDO, RETURN ERROR :
      912       DO jj = 1 TO LENGTH( p-instring ) :
      913         ASSIGN p-outstring = p-outstring + ( IF p-outstring = "":U THEN "":U ELSE " ":U ) + SUBSTRING( p-instring, jj, 1 ).
      914       END.
      915       ASSIGN p-outstring = CAPS( TRIM( p-outstring ) ).
      916     END.
      917   END PROCEDURE.
      918   function CenterLine returns character ( input p-in-string as character
      919                                         , input p-rep-width as integer ) :
      920     define variable v-out-string as character no-undo .
      921     run get-center-line in this-procedure
      922       (  input p-in-string
      923       ,  input p-rep-width
      924       , output v-out-string
      925       ) no-error .
      926     return ( if error-status :error then '':U else v-out-string ) .
      927   end function.
      928   define stream text_out .
      929   do
      930   on error undo, return error return-value
      931   :
      932     run WaitFram-Show in this-procedure
      933       ( input 'Идет формирование отчета, ждите...'
      934       ) .
      935     run get-report-num  in p-parent-proc
      936       (
      937         output g#report-num
      938       ) .
      939     run get-quest-print in p-parent-proc
      940       (
      941         output g#quest-print
      942       ) .
      943     find first bf_trn-doc no-lock where
      944         recid( bf_trn-doc ) = p-rec-trn-doc no-error .
      945     if not available bf_trn-doc
      946     then do:
      947       run waitfram-hide in this-procedure .
      948       message substitute( 'Не найден документ пересортицы с идентификатором &1.'
      949                         , p-rec-trn-doc
      950                         )
      951       view-as alert-box error .
      952       undo, return error .
      953     end.
      954     if bf_trn-doc.doc-type     <> 'инв':U or
      955        bf_trn-doc.ext-doc-type <> 'vp':U
      956     then do:
      957       run waitfram-hide in this-procedure .
      958       message
      959         'Данная форма только для печати документа пересортицы.'
      960       view-as alert-box error .
      961       undo, return error .
      962     end.
      963     find first bf_object no-lock where
      964                bf_object.obj-type = bf_trn-doc.obj-type and
      965                bf_object.obj-code = bf_trn-doc.obj-code .
      966   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      967   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostname in g#library
      968     (input  bf_trn-doc.obj-type
      969     ,input  bf_trn-doc.obj-code
      970     ,output p-host-code
      971     ,output v-host-name
      972     ) no-error .
      973     if error-status :error
      974     then do:
      975       run waitfram-hide in this-procedure .
      976       message
      977         'Не могу определить текущую фирму.'
      978       view-as alert-box error .
      979       undo, return error .
      980     end.
      981     if bf_trn-doc.host-code <> p-host-code
      982     then do:
      983       run waitfram-hide in this-procedure .
      984       message
      985         'Ошибка определения текущей фирмы.'
      986       view-as alert-box error .
      987       undo, return error .
      988     end.
      989     assign
      990       t_inv-date = ( if bf_trn-doc.status_ = 'факт':U then bf_trn-doc.fact-date else bf_trn-doc.doc-date )
      991     .
      992   output stream text_out to value( string( session:temp-directory +
      993                                        "rpt" + string( g#report-num ) ) )
      994                                        page-size  value(43) .
      995     put stream text_out unformatted
      996       '-----------------------------------------------------------------------' skip
      997       '|     Предприятие, организация     |            Со склада             |' skip
      998       '-----------------------------------------------------------------------' skip
      999       '|' +
     1000       substring( string( CenterLine( v-host-name,        34 ) + fill( ' ':U, 34 ), "x(34)":U ), 1, 34 )
     1001           +                              '|' +
     1002       substring( string( CenterLine( bf_object.obj-name, 34 ) + fill( ' ':U, 34 ), "x(34)":U ), 1, 34 )
     1003                                                                           + '|' skip
     1004       '-----------------------------------------------------------------------' skip( 4 )
     1005       space( 59 ) '-----------------------------------' skip
     1006       space( 59 ) '|Номер документа |Дата составления|' skip
     1007       space( 59 ) '-----------------------------------' skip
     1008       caps(
     1009       substring( string( CenterLine( entry( lookup( bf_trn-doc.ext-doc-type, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ), 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U ), 59 )
     1010                        + fill( ' ':U, 59 ), "x(59)":U )
     1011                        , 1, 59 )
     1012           ) +     '|' +
     1013       substring( string( CenterLine(         bf_trn-doc.doc-code,                   16 ) + fill( ' ':U, 16 ), "x(34)":U ), 1, 16 )
     1014                                  + '|' +
