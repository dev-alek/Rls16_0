     1062       ) .
     1063     assign
     1064       j_LineCount    = 0
     1065       sum-sale-total = 0.00
     1066       sum-cost-total = 0.00
     1067     .
     1068     for each  bf_parts-root no-lock where
     1069               bf_parts-root.doc-code = bf_trn-doc.doc-code
     1070       , first bf_goods-out  no-lock where
     1071               bf_goods-out.gds-code  = bf_parts-root.orig-gds-code
     1072       , first bf_goods-in   no-lock where
     1073               bf_goods-in.gds-code   = bf_parts-root.gds-code
     1074      break by bf_parts-root.doc-code
     1075            by bf_parts-root.orig-gds-code
     1076            by bf_parts-root.gds-code
     1077     :
     1078       if first-of (bf_parts-root.gds-code) then do:
     1079         assign
     1080           sum-sale-in    = 0.00
     1081           sum-sale-out   = 0.00
     1082           sum-cost-in    = 0.00
     1083           sum-cost-out   = 0.00
     1084           fact-qnty-in   = 0.00
     1085           v-sum-sale-in  = 0.00
     1086           fact-qnty-out  = 0.00.
     1087       end.
     1088   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1089   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     1090     (input  bf_trn-doc.obj-type
     1091     ,input  bf_trn-doc.obj-code
     1092     ,input  bf_goods-in.gds-code
     1093     ,input  0
     1094     ,input  bf_trn-doc.fact-order
     1095     ,output v-doc-num
     1096     ,output price-sale-in
     1097     ,output d-road-tax
     1098     ,output d-excise
     1099     ) no-error .
     1100       if error-status :error
     1101       then do:
     1102         run waitfram-hide in this-procedure .
     1103         message
     1104           'Не могу определить текущие продажные цены для оприходованного товара.' skip
     1105           bf_goods-in.artic bf_goods-in.prod-type bf_goods-in.prod-code '.'
