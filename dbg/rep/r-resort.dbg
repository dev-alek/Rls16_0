     1295       run r-resort-write-line-data in this-procedure
     1296         (
     1297           input ?
     1298           , input tt-resort-in.artic
     1299           , input tt-resort-in.gds-name
     1300           , input tt-resort-in.unit-base
     1301           , input trim( string( tt-resort-in.fact-qnty,    "->>>>9.<<":U ) )
     1302           , input trim( string( tt-resort-in.price-sale,   ">>>>>9.99":U ) )
     1303           , input trim( string( tt-resort-in.sum-sale,     "->>>>>>9.99":U ) )
     1304         , input ?
