     1341         word-sum-buf-2 = '':U
     1342         word-sum-buf-3 = '':U
     1343       .
     1344     end.
     1345     put stream text_out unformatted
     1346       '------------------------------------------------------------------------------------------------------------------------------------' skip
     1347       '                                                              Итого:                           |'
