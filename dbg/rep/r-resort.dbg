     1236           string( string( v-stroka-out,                 ">>>9":U  ), "x(4)":U  )       '|'
     1237           string( tt-resort-out.artic,                  "x(16)":U  )                   '|'
     1238           string( tt-resort-out.gds-name,               "x(48)":U )                    '|'
     1239           string( tt-resort-out.unit-base,              "x(3)":U  )                    '|'
     1240           string( string( tt-resort-out.fact-qnty,      "->>>>9.<<":U ), "x(9)":U  )   '|'
     1241           string( string( tt-resort-out.price-sale,     ">>>>>9.99":U ), "x(9)":U  )   '|'
     1242           string( string( tt-resort-out.sum-sale,       "->>>>>>9.99":U ), "x(11)":U ) '|'
     1243           string( string( tt-resort-out.d-per-cent,     "->>>>>9.<<%":U ), "x(11)":U ) '|'
     1244           string( string( tt-resort-out.sum-cost,       "->>>>>>9.99":U ), "x(11)":U ) '|' skip
     1245         .
