     1254         run r-resort-write-line-data in this-procedure
     1255           (
     1256             input v-stroka-out
     1257           , input "'" + tt-resort-out.artic
     1258           , input tt-resort-out.gds-name
     1259           , input tt-resort-out.unit-base
