     1309     assign
     1310       sum-sale-total = sum-sale-total + itog-sum-sale-in + itog-sum-sale-out
     1311       sum-cost-total = sum-cost-total + itog-sum-cost-in + itog-sum-cost-out
     1312     .
     1313     assign
     1314       word-sum-total = Total-Word( sum-sale-total, Roubles( sum-sale-total ), Copecks( sum-sale-total ) )
     1315       word-sum-buf-1 = '':U
     1316       word-sum-buf-2 = '':U
     1317       word-sum-buf-3 = '':U
     1318     .
     1319     if length( word-sum-total ) > 97
     1320     then do:
     1321       assign
     1322         word-sum-temp1 = breakstr( word-sum-total, 97, input-output word-sum-buf-1, input-output word-sum-buf-2 )
     1323         word-sum-temp2 = word-sum-buf-2
     1324       .
     1325       if length( word-sum-temp2 ) > 125
     1326       then do:
     1327         assign
     1328           word-sum-temp1 = breakstr( word-sum-temp2, 125, input-output word-sum-buf-2, input-output word-sum-buf-3 )
     1329         .
     1330       end.
     1331       else do:
     1332         assign
     1333           word-sum-buf-2 = word-sum-temp2
     1334           word-sum-buf-3 = '':U
     1335         .
     1336       end.
     1337     end.
     1338     else do:
     1339       assign
