       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       71   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
       72   define  shared variable RepPathName        as character no-undo .
       73   define  shared variable PrintRubl          as logical   no-undo .
       74   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       75   define variable v-waitfram-action01         as character   no-undo .
       76   define variable v-waitfram-action02         as character   no-undo .
       77   define variable v-waitfram-action03         as character   no-undo .
       78   define variable mWaitFramTextBeg            as character   no-undo.
       79   define variable mWaitFramTextEnd            as character   no-undo.
       80   define variable mWaitFramView               as logical     no-undo.
       81   define variable mWaitProcEvent              as logical     no-undo init yes.
       82   define variable mWaitFramInterval           as integer     no-undo init 1 .
       83   define variable mWaitFramStop               as logical     no-undo.
       84   define variable mWaitFramStopUser           as logical     no-undo.
       85   define variable mWaitFramStopTimeOut        as logical     no-undo.
       86   define variable mWaitFramStartProc          as datetime-tz no-undo.
       87   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       88   define button B-WaitFramStop auto-end-key
       89        label "Стоп"
       90        size 10 by 1 tooltip "Остоновить процесс".
       91   define button B-viewProcInfo
       92        label "Информация"
       93        size 15 by 1 tooltip "Информация о процесс".
       94   define frame waitfram
       95     v-waitfram-action01 format "x(72)" no-label skip
       96     v-waitfram-action02 format "x(72)" no-label skip
       97     v-waitfram-action03 format "x(72)" no-label skip
       98     B-viewProcInfo
       99     B-WaitFramStop at row 4 col 30
      100     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      101     .
      102   define new global shared variable mBatchMode as logical no-undo init ?.
      103   define variable mFramBachModHandle as handle no-undo.
      104   mFramBachModHandle = frame waitfram:handle.
      105   define variable mFameOldVis as logical no-undo.
      106   define variable mVisCUrentVin as logical no-undo.
      107   if session:batch-mode
      108   then
      109      mBatchMode = yes.
      110   if mBatchMode = ? then do:
      111     mVisCUrentVin = current-window:visible.
      112     mFameOldVis = mFramBachModHandle:visible.
      113     mFramBachModHandle:visible  = yes.
      114     mBatchMode = mFramBachModHandle:visible ne yes.
      115     mFramBachModHandle:visible = mFameOldVis.
      116     current-window:visible = mVisCUrentVin.
      117   end.
      118    if  log-manager:logfile-name ne ?
      119     then DO:
      120         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      121         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      122         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      123     end.
      124   on choose of B-WaitFramStop in frame waitfram
      125   do:
      126     mWaitFramStop = yes.
      127     mWaitFramStopUser = yes.
      128   end.
      129   function waitfram-check-timeout returns logical():
      130      define variable vtime as int64 no-undo.
      131      if mWaitFramStopTimeOut
      132      then
      133         return yes.
      134      vtime = ( now - mWaitFramStartProc ) / 1000 .
      135      if     mWaitFramTimeOut ne ?
      136         and mWaitFramTimeOut ne 0
      137         and mWaitFramTimeOut lt vtime
      138      then do:
      139         mWaitFramStopTimeOut = yes.
      140      end.
      141      return mWaitFramStopTimeOut.
      142   end.
      143   procedure waitfram-hide :
      144     if not session:batch-mode
      145     then do
      146     on error undo, return error return-value
      147     :
      148       pause 0 before-hide .
      149       if not mBatchMode then
      150         hide frame waitfram .
      151     if     not mWaitFramView
      152        and mWaitProcEvent
      153     then
      154       process events .
      155     end.
      156   end procedure.
      157   procedure waitfram-show :
      158     define input  parameter p-message as character no-undo .
      159     define variable v-left-margin as integer   no-undo .
      160     if not session:batch-mode
      161     then do
      162     on error undo, return error return-value
      163     :
      164       if length(p-message) <= 70 then do:
      165         assign
      166           v-left-margin = integer((70 - length(p-message)) / 2)
      167         .
      168         assign
      169           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      170         .
      171         assign
      172           v-waitfram-action01 = " "
      173           v-waitfram-action02 = " "
      174                                    + fill(" ", v-left-margin)
      175                                    + p-message
      176           v-waitfram-action03 = " "
      177         .
      178       end.
      179       else do:
      180         define variable vRindex1 as integer no-undo.
      181         define variable vRindex2 as integer no-undo.
      182         vRindex1 = r-index(p-message," ",70).
      183         if vRindex1 = 0
      184         then
      185            vRindex1 = 70.
      186         if length(p-message)  <= vRindex1 + 70 then do:
      187           assign
      188             v-waitfram-action01 = " "
      189             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      190             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      191           .
      192         end.
      193         else do:
      194           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      195           if vRindex2 <= vRindex1
      196           then
      197              vRindex2 = vRindex1 + 70.
      198           assign
      199             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      200             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      201             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      202           .
      203         end.
      204       end.
      205       B-viewProcInfo:visible   in frame waitfram = no.
      206       B-viewProcInfo:sensitive in frame waitfram = no.
      207       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      208       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      209       if  (   mWaitFramView
      210          or  mWaitProcEvent)
      211          and not mBatchMode
      212       then
      213          display
      214             v-waitfram-action01 skip
      215             v-waitfram-action02 skip
      216             v-waitfram-action03 skip
      217          with frame waitfram .
      218       if     mWaitFramView
      219          then do:
      220             if     mWaitFramInterval ne ?
      221                and not mBatchMode
      222             then
      223                wait-for go of frame waitfram pause mWaitFramInterval.
      224          end.
      225          else
      226             if     mWaitProcEvent
      227                and not mBatchMode
      228             then
      229                process events .
      230     end.
      231   end procedure.
      232      procedure waitfram-show-this:
      233         define input  parameter iInterval as int64 no-undo.
      234         define variable vtime as int64 no-undo.
      235         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      236         mWaitFramInterval = iInterval.
      237         run waitfram-show (substitute("&1&2 &3&4" ,
      238                                       mWaitFramTextBeg ,
      239                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      240                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      241                                       mWaitFramTextEnd
      242                                      )
      243                           ).
      244      end.
      245      procedure WaitFramRunPause:
      246         define input  parameter iInterval as dec no-undo.
      247         define variable vStart  as datetime-tz no-undo.
      248         define variable vend    as datetime-tz no-undo.
      249         define variable vint as int64 no-undo.
      250         define variable vOk as logical no-undo.
      251         vStart = now.
      252         vend   = vStart.
      253         publish "WaitFramPause" (iInterval,output vOk).
      254         vend   =  now.
      255         vint = vend - vStart.
      256         vint = iInterval - vint / 1000.
      257         if     not mWaitFramStop
      258            and (   vint > 0
      259                 or (    not vOk
      260                     and iInterval eq ?
      261                     )
      262                 )
      263         then
      264            run waitfram-show-this (iInterval).
      265         vend   =  now.
      266         vint = vend - vStart.
      267         vint = iInterval - vint / 1000.
      268         if     not mWaitFramStop
      269            and vint > 0
      270         then do:
      271            run gbl/pause.p (vint * 1000).
      272         end.
      273         if iInterval ne ?
      274         then
      275            publish "WaitFramStop".
      276         waitfram-check-timeout().
      277      end.
      278      procedure WaitFramWaitFor:
      279         define input  parameter iInterval as dec no-undo.
      280         assign
      281            mWaitFramStartProc   = now
      282            mWaitFramStopUser    = no
      283            mWaitFramStopTimeOut = no
      284         .
      285         block-wait:
      286         do while not mWaitFramStop:
      287            run WaitFramRunPause (iInterval).
      288            if  waitfram-check-timeout()
      289            then do:
      290               leave block-wait.
      291            end.
      292         end.
      293         run waitfram-hide.
      294      end.
      295   procedure waitfram-join :
      296     define input  parameter p-line-1  as character no-undo .
      297     define input  parameter p-line-2  as character no-undo .
      298     define input  parameter p-line-3  as character no-undo .
      299     define output parameter p-message as character no-undo .
      300     do
      301     on error undo, return error return-value
      302     :
      303       assign
      304         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      305                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      306                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      307       .
      308     end.
      309   end procedure.
      310   function waitfram-join-function returns character
      311     (input p-line-1 as character
      312     ,input p-line-2 as character
      313     ,input p-line-3 as character
      314     ).
      315     define variable v-message as character no-undo .
      316     run waitfram-join in this-procedure
      317       (input  p-line-1
      318       ,input  p-line-2
      319       ,input  p-line-3
      320       ,output v-message
      321       ) .
      322     return v-message .
      323   end function .
      324   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      325   function breakstr returns character ( input        for-name    as character,
      326                                         input        line-length as integer,
      327                                         input-output line1       as character,
      328                                         input-output line2       as character ) :
      329     define variable ii as integer no-undo.
      330     if length( for-name ) > line-length then do:
      331       assign ii    = 1
      332              line1 = "":u
      333              line2 = "":u.
      334       if length( entry( ii, for-name , " ":u ) ) > line-length then do:
      335         assign line1 =       substring( for-name, 1, line-length     )
      336                line2 = trim( substring( for-name,    line-length + 1 ) ).
      337       end.                                                     else do:
      338         do while length( line1 + entry( ii, for-name, " ":u ) ) < ( line-length + 1 ) :
      339           assign line1 = line1 + entry( ii, for-name, " ":u ) + " ":u
      340                  ii    = ii    + 1.
      341           if length( entry( ii, for-name, " ":u ) ) > line-length then do:
      342             assign line1 = line1 + substring( for-name, length( line1 ), line-length - length( line1 ) + 1 ).
      343           end.
      344         end.
      345         assign line2 = trim( substring( for-name, length( line1 ) ) ).
      346       end.
      347     end.                                else do:
      348       assign line1 = for-name
      349              line2 = "":u.
      350     end.
      351     return ( line1 ).
      352   end function.
      353   define variable g#report-num  as integer no-undo .
      354   define variable g#quest-print as logical no-undo initial yes .
      355   define variable g#log         as logical no-undo .
      356   def var vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      357   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
      358   procedure paramls-clear :
      359     define buffer buf_temp-param for temp-param .
      360     do
      361     on error undo, return error return-value
      362     :
      363       for each buf_temp-param
      364       on error undo, return error
      365       :
      366         delete buf_temp-param .
      367       end.
      368     end.
      369   end procedure.
      370   procedure paramls-write :
      371     define input  parameter p-code     as character no-undo .
      372     define input  parameter p-sub-code as character no-undo .
      373     define input  parameter p-value    as character no-undo .
      374     define buffer buf_temp-param for temp-param .
      375     do
      376     on error undo, return error return-value
      377     :
      378       find first buf_temp-param
      379         where buf_temp-param.param-code     = p-code
      380           and buf_temp-param.param-sub-code = p-sub-code
      381         no-error .
      382       if not available buf_temp-param then do:
      383         create buf_temp-param .
      384         assign
      385           buf_temp-param.param-code     = p-code
      386           buf_temp-param.param-sub-code = p-sub-code
      387         .
      388       end.
      389       assign
      390         buf_temp-param.param-value = p-value
      391       .
      392     end.
      393   end procedure.
      394   procedure paramls-read :
      395     define input  parameter p-code          as character no-undo .
      396     define input  parameter p-sub-code      as character no-undo .
      397     define input  parameter p-default-value as character no-undo .
      398     define output parameter p-value         as character no-undo .
      399     define buffer buf_temp-param for temp-param .
      400     do
      401     on error undo, return error return-value
      402     :
      403       find first buf_temp-param
      404         where buf_temp-param.param-code     = p-code
      405           and buf_temp-param.param-sub-code = p-sub-code
      406         no-error .
      407       if available buf_temp-param then do:
      408         assign
      409           p-value = buf_temp-param.param-value
      410         .
      411       end.
      412       else do:
      413         assign
      414           p-value = p-default-value
      415         .
      416       end.
      417     end.
      418   end procedure.
      419   procedure paramls-append :
      420     define input  parameter p-code     as character no-undo .
      421     define input  parameter p-sub-code as character no-undo .
      422     define input  parameter p-value    as character no-undo .
      423     define buffer buf_temp-param for temp-param .
      424     do
      425     on error undo, return error return-value
      426     :
      427       find first buf_temp-param
      428            where buf_temp-param.param-code     = p-code
      429              and buf_temp-param.param-sub-code = p-sub-code
      430         no-error .
      431       if not available buf_temp-param then do:
      432         create buf_temp-param .
      433         assign
      434           buf_temp-param.param-code     = p-code
      435           buf_temp-param.param-sub-code = p-sub-code
      436           buf_temp-param.param-value    = p-value
      437         .
      438       end.
      439       else do:
      440           assign
      441               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
      442           .
      443       end.
      444     end.
      445   end procedure.
      446   define variable vss-include-info4 as character no-undo format "x(65)":U
      447     initial "@(#)$Workfile$ $Revision$":U .
      448   define stream excel-line .
      449   define stream excel-cell .
      450   define temp-table temp_cell-data no-undo
      451     field data-key   as character
      452     field data-value as character
      453     index pi         is primary   unique data-key
      454   .
      455   define temp-table temp_line-data no-undo
      456     field data-key   as character
      457     field xl-line-id as integer
      458     field Num        as integer
      459     field Artic      as character
      460     field Name       as character
      461     field EdIzm      as character
      462     field Qnty       as character
      463     field Price      as character
      464     field Sum        as character
      465     field PerCent    as character
      466     field Cost       as character
      467     index pi         is primary   unique xl-line-id
      468   .
      469   define variable v-r-resort-current-data-row as integer   no-undo .
      470   define variable v-r-resort-cell-file-name   as character no-undo .
      471   define variable v-r-resort-data-file-name   as character no-undo .
      472   procedure r-resort-init :
      473     define buffer buf_temp_cell-data for temp_cell-data .
      474     define buffer buf_usr-flt        for ubflt.usr-flt .
      475     do
      476     for buf_temp_cell-data
      477       , buf_usr-flt
      478     on error undo, return error
      479     :
      480       assign
      481         v-r-resort-current-data-row = 0
      482       .
      483       run gbl/_tmpfile.p
      484         ( input "xd"
      485         , input ".txt"
      486         , output v-r-resort-data-file-name
      487         ) .
      488       output stream excel-line to value( v-r-resort-data-file-name ) .
      489       run gbl/_tmpfile.p
      490         ( input "xc"
      491         , input ".txt"
      492         , output v-r-resort-cell-file-name
      493         ) .
      494       output stream excel-cell to value( v-r-resort-cell-file-name ) .
      495       run r-resort-write-cell-data in this-procedure
      496         ( input "valutCode":U
      497         , input "0":U
      498         ) .
      499       run r-resort-write-cell-data in this-procedure
      500         ( input "columnList":U
      501         , input "Num,Artic,Name,EdIzm,Qnty,Price,Sum,PerCent,Cost"
      502         ) .
      503       run r-resort-write-cell-data in this-procedure
      504         ( input "columnType":U
      505         , input "I,S,S,S,D,D,D,D,D":U
      506         ) .
      507       run r-resort-write-cell-data in this-procedure
      508         ( input "columnAmount":U
      509         , input "9":U
      510         ) .
      511     end.
      512   end procedure.
      513   procedure r-resort-close :
      514     do
      515     on error undo, return error
      516     :
      517       output stream excel-line close .
      518       output stream excel-cell close .
      519       output to value( string( session :temp-directory + "$" + string( g#report-num ) ) + ".txl" ) append .
      520       export string ("exe/" + "peresort.xlt":U) .
      521       export "exe/t_97.bas":U .
      522       export v-r-resort-cell-file-name .
      523       export v-r-resort-data-file-name .
      524       output close .
      525     end.
      526   end procedure.
      527   procedure r-resort-write-cell-data :
      528     define input parameter p-data-key   as character no-undo .
      529     define input parameter p-data-value as character no-undo .
      530     define buffer buf_temp_cell-data for temp_cell-data .
      531     do
      532     for buf_temp_cell-data
      533     on error undo, return error
      534     :
      535       find first buf_temp_cell-data where
      536                  buf_temp_cell-data.data-key = p-data-key no-error.
      537       if not available buf_temp_cell-data
      538       then do:
      539         create buf_temp_cell-data .
      540         assign
      541           buf_temp_cell-data.data-key = p-data-key
      542         .
      543       end.
      544       assign
      545         buf_temp_cell-data.data-value = p-data-value
      546       .
      547       put stream excel-cell unformatted
      548         buf_temp_cell-data.data-key   chr(9)
      549         buf_temp_cell-data.data-value chr(10)
      550       .
      551     end.
      552   end procedure.
      553   procedure r-resort-write-line-data :
      554     define input parameter p-Num     as integer   no-undo .
      555     define input parameter p-Artic   as character no-undo .
      556     define input parameter p-Name    as character no-undo .
      557     define input parameter p-EdIzm   as character no-undo .
      558     define input parameter p-Qnty    as character no-undo .
      559     define input parameter p-Price   as character no-undo .
      560     define input parameter p-Sum     as character no-undo .
      561     define input parameter p-PerCent as character no-undo .
      562     define input parameter p-Cost    as character no-undo .
      563     define buffer buf_temp_line-data for temp_line-data .
      564     do
      565     for buf_temp_line-data
      566     on error undo, return error
      567     :
      568       for each buf_temp_line-data
      569       :
      570         delete buf_temp_line-data .
      571       end.
      572       create buf_temp_line-data .
      573       assign
      574         v-r-resort-current-data-row = v-r-resort-current-data-row + 1
      575       .
      576       assign
      577         buf_temp_line-data.data-key   = "LD":U
      578         buf_temp_line-data.xl-line-id = v-r-resort-current-data-row
      579         buf_temp_line-data.Num        = p-Num
      580         buf_temp_line-data.Artic      = p-Artic
      581         buf_temp_line-data.Name       = p-Name
      582         buf_temp_line-data.EdIzm      = p-EdIzm
      583         buf_temp_line-data.Qnty       = p-Qnty
      584         buf_temp_line-data.Price      = p-Price
      585         buf_temp_line-data.Sum        = p-Sum
      586         buf_temp_line-data.PerCent    = p-PerCent
      587         buf_temp_line-data.Cost       = p-Cost
      588       .
      589       put stream excel-line unformatted
      590         buf_temp_line-data.data-key chr(9)
      591       .
      592       if buf_temp_line-data.Num = ?
      593       then do:
      594         put stream excel-line unformatted
      595           chr(9)
      596         .
      597       end.
      598       else do:
      599         put stream excel-line unformatted
      600           buf_temp_line-data.Num    chr(9)
      601         .
      602       end.
      603       put stream excel-line unformatted
      604         buf_temp_line-data.Artic    chr(9)
      605         buf_temp_line-data.Name     chr(9)
      606         buf_temp_line-data.EdIzm    chr(9)
      607         buf_temp_line-data.Qnty     chr(9)
      608         buf_temp_line-data.Price    chr(9)
      609         buf_temp_line-data.Sum      chr(9)
      610       .
      611       if buf_temp_line-data.PerCent = ?
      612       then do:
      613         put stream excel-line unformatted
      614           chr(9)
      615         .
      616       end.
      617       else do:
      618         put stream excel-line unformatted
      619           buf_temp_line-data.PerCent chr(9)
      620         .
      621       end.
      622       .
      623       put stream excel-line unformatted
      624         buf_temp_line-data.Cost     chr(10)
      625       .
      626     end.
      627   end procedure.
      628   procedure r-resort-run-excel :
      629     define input parameter p-header-filename as character no-undo .
      630     define input parameter p-data-filename   as character no-undo .
      631     define variable v-template-file-name as character no-undo .
      632     define variable v-vb-file-name       as character no-undo .
      633     define buffer buf_temp-param for temp-param .
      634     do
      635     for buf_temp-param
      636     on error undo, return error
      637     :
      638       create buf_temp-param.
      639       assign
      640         v-template-file-name = search( string ("exe/" + "peresort.xlt":U) )
      641         v-vb-file-name       = search( "exe/t_97.bas" )
      642       .
      643       if v-template-file-name = ? or
      644          v-template-file-name = "":U
      645       then do:
      646         message
      647           "Ошибка имени файла шаблона."
      648         view-as alert-box error .
      649       end.
      650       if v-vb-file-name = ? or
      651          v-vb-file-name = "":U
      652       then do:
      653         message
      654           "Ошибка имени файла кода обработки."
      655         view-as alert-box error .
      656       end.
      657       run paramls-write in this-procedure
      658         ( input "template":U
      659         , input "template-file-name":U
      660         , input v-template-file-name
      661         ) .
      662       run paramls-write in this-procedure
      663         ( input "template":U
      664         , input "vb-file-name":U
      665         , input v-vb-file-name
      666         ) .
      667       run paramls-write in this-procedure
      668         ( input "data":U
      669         , input "data-header-filename":U
      670         , input p-header-filename
      671         ) .
      672       run paramls-write in this-procedure
      673         ( input "data":U
      674         , input "data-filename":U
      675         , input p-data-filename
      676         ) .
      677       run gbl/macroxlt.p
      678         ( input-output table buf_temp-param
      679         ) no-error .
      680       if error-status :error
      681       then do:
      682         message vss-workfile skip( 0 ) vss-date skip( 0 ) vss-revision skip( 1 ) vss-description skip( 1 )
      683                 "Ошибка создания файла Excel."  skip( 0 )
      684                 return-value                    skip( 0 )
      685                 trim( error-status :get-message( 1 ) )
      686                 trim( error-status :get-message( 2 ) )
      687                 trim( error-status :get-message( 3 ) )
      688         view-as alert-box error .
      689         undo, return error .
      690       end.
      691     end.
      692   end procedure.
