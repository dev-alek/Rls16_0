      746   define temp-table tt-resort-in no-undo
      747     field j_LineCount as integer
      748     field artic       like ub.goods.artic
      749     field gds-name    like ub.goods.gds-name
      750     field gds-code    like ub.goods.gds-code
      751     field unit-base   like ub.goods.unit-base
