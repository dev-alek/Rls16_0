     1170                 sum-cost-in  = sum-cost-in  + bf_parts-in.price-rubl * bf_parts-in.fact-qnty
     1171                 fact-qnty-in = fact-qnty-in + bf_parts-in.fact-qnty
     1172                 .
     1173           end.
     1174           else
     1175           do:
     1176              if bf_parts-in.in-code    = bf_parts-root.in-code then
     1177              do:
     1178                 assign
     1179                    sum-sale-in  = sum-sale-in  + price-sale-in          * bf_parts-in.fact-qnty
     1180                    sum-cost-in  = sum-cost-in  + bf_parts-in.price-rubl * bf_parts-in.fact-qnty
     1181                    fact-qnty-in = fact-qnty-in + bf_parts-in.fact-qnty
     1182                    .
     1183              end.
     1184           end.
     1185        end.
     1186       find first tt-resort-out where tt-resort-out.artic = bf_goods-out.artic no-error .
     1187       if not available tt-resort-out then do :
     1188           create tt-resort-out .
     1189         assign
     1190           j_LineCount    = j_LineCount + 1
     1191             tt-resort-out.j_LineCount     = j_LineCount
     1192             tt-resort-out.artic           = bf_goods-out.artic
     1193             tt-resort-out.gds-name        = bf_goods-out.gds-name
     1194             tt-resort-out.unit-base       = bf_goods-out.unit-base
     1195             tt-resort-out.fact-qnty       = fact-qnty-out
     1196             tt-resort-out.price-sale      = price-sale-out
     1197             tt-resort-out.sum-sale        = sum-sale-out
     1198             tt-resort-out.sum-cost        = sum-cost-out
     1199             v-sum-sale-in                 = 0
     1200         .
     1201       end .
     1202       find first tt-resort-in where tt-resort-in.artic = bf_goods-in.artic no-error .
     1203       if not available tt-resort-in then do :
     1204          create tt-resort-in .
     1205          assign
     1206             j_LineCount                = j_LineCount + 1
     1207             tt-resort-in.j_LineCount   = j_LineCount
     1208             tt-resort-in.artic         = bf_goods-in.artic
     1209             tt-resort-in.gds-name      = bf_goods-in.gds-name
     1210             tt-resort-in.unit-base     = bf_goods-in.unit-base
     1211             tt-resort-in.fact-qnty     = fact-qnty-in
     1212             tt-resort-in.price-sale    = price-sale-in
     1213             tt-resort-in.sum-sale      = sum-sale-in
     1214             tt-resort-in.sum-cost      = sum-cost-in
     1215             v-sum-sale-in              = v-sum-sale-in + sum-sale-in
     1216           .
     1217       end .
     1218       find first tt-resort-out where tt-resort-out.artic = bf_goods-out.artic no-error .
     1219       if available tt-resort-out then do :
     1220          assign tt-resort-out.d-per-cent = (( v-sum-sale-in + tt-resort-out.sum-sale) / v-sum-sale-in ) * 100.00 .
     1221       end .
     1222     end.
     1223     do while v-stroka ne j_LineCount :
     1224       v-stroka = v-stroka + 1 .
     1225       find first tt-resort-out where tt-resort-out.j_LineCount = v-stroka no-error .
     1226       if available tt-resort-out then do :
     1227         assign
     1228           itog-sum-cost-out = itog-sum-cost-out + tt-resort-out.sum-cost
     1229           itog-sum-sale-out = itog-sum-sale-out + tt-resort-out.sum-sale
     1230           v-stroka-out      = v-stroka-out      + 1
     1231         .
     1232         put stream text_out unformatted
     1233           '|----|----------------|------------------------------------------------|---|---------|---------|-----------|-----------|-----------|' skip
     1234         .
