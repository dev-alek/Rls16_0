     1277                                                                                '    |'
     1278           string( tt-resort-in.artic,               "x(16)":U  )                   '|'
     1279           string( tt-resort-in.gds-name,            "x(48)":U )                    '|'
     1280           string( tt-resort-in.unit-base,           "x(3)":U  )                    '|'
     1281           string( string ( tt-resort-in.fact-qnty,  "->>>>9.<<":U ), "x(9)":U  )   '|'
     1282           string( string ( tt-resort-in.price-sale, ">>>>>9.99":U ), "x(9)":U  )   '|'
