        1   define input parameter parparentproc as widget-handle no-undo .
        2   define variable vss-revision    as character no-undo init "$Revision$":u .
        3   define variable vss-author      as character no-undo init "$Author$":u .
        4   define variable vss-date        as character no-undo init "$Date$":u .
        5   define variable vss-workfile    as character no-undo init "$Workfile$":u .
        6   define variable vss-archive     as character no-undo init "$Archive$":u .
        7   define variable vss-description as character no-undo init "Отчет по покупателям товаров (выкуп)" .
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   procedure proc-alt-shift-f2:
       69     if not ibs.th.gbl.gbl-var:rcode
       70   then
       71     run gbl\inidebug.p .
       72   end.
       73   procedure proc-alt-shift-f3:
       74     run gbl/prvssinf.p
       75       ( input this-procedure
       76       ) .
       77   end.
       78   define variable v-inform-launched as logical no-undo initial false .
       79   procedure proc-alt-shift-f4:
       80     define variable v-action as character no-undo .
       81     if v-inform-launched = false then do:
       82       assign
       83         v-inform-launched = true
       84       .
       85       run gbl/d-inform.w
       86         (  input self
       87         ,  input this-procedure
       88         , output v-action
       89         ) no-error .
       90       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       91       assign
       92         v-inform-launched = false
       93       .
       94     end.
       95   end.
       96   procedure proc-alt-f1:
       97     run gbl/corrhelp.p
       98       (input this-procedure
       99       ) .
      100   end .
      101   on alt-shift-f2 anywhere do:
      102     run proc-alt-shift-f2.
      103   end.
      104   on alt-shift-f3 anywhere do:
      105     run proc-alt-shift-f3 in this-procedure .
      106   end.
      107   on alt-shift-f4 anywhere do:
      108     run proc-alt-shift-f4 in this-procedure.
      109   end.
      110   on alt-f1 anywhere do:
      111     run proc-alt-f1 in this-procedure .
      112   end.
      113   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      114   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      115   define new shared variable RepPathName        as character no-undo .
      116   define new shared variable PrintRubl          as logical   no-undo .
      117   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      118   define  stream PrnLibStream.
      119   procedure prn-lib-prn-file :
      120     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      121     define input parameter p-DIsabledoptions as integer no-undo .
      122     define variable v-report-name as character no-undo .
      123     define variable v-user-action as character no-undo .
      124     define variable v-printed     as logical   no-undo .
      125     define variable v-exist       as logical   no-undo .
      126     do
      127       on error undo, return error
      128       :
      129       run prn-lib-get-report-name  in this-procedure (
      130         input parParentProc
      131         ,output v-report-name
      132         ).
      133   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      134   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      135     (input  v-report-name
      136     ,input  2
      137     ,output v-exist
      138     )  .
      139       if NOT v-exist then
      140       DO:
      141         Message
      142           "Нет заданий на печать ! "
      143           view-as alert-box .
      144         Return  .
      145       End.
      146       run gbl/prnfilen.w
      147         (input  ""
      148         ,input  p-DisabledOptions
      149         ,input  string(v-report-name )
      150         ,input  7
      151         ,output v-user-action
      152         ,output v-printed
      153         ) .
      154       if v-printed then
      155       do:
      156         return "YES" .
      157       end.
      158       else
      159       do:
      160         return "NO" .
      161       end.
      162     end.
      163   end procedure.
      164   procedure prn-lib-open-stream :
      165     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      166     define input parameter p-page-size    as integer no-undo .
      167     define input parameter p-is-stream    as logical no-undo .
      168     define input parameter p-append       as logical no-undo .
      169     define variable v-report-name as character no-undo .
      170     do
      171       on error undo, return error
      172       :
      173       run prn-lib-get-report-name  in this-procedure (
      174         input parParentProc
      175         ,output v-report-name
      176         ).
      177       if p-is-stream then
      178       do:
      179         if p-append then
      180         do:
      181           output stream PrnLibStream to value( v-report-name )
      182             page-size value(p-page-size) append .
      183         end.
      184         if not p-append then
      185         do:
      186           output stream PrnLibStream to value( v-report-name )
      187             page-size value(p-page-size) .
      188         end.
      189       end.
      190       if not p-is-stream then
      191       do:
      192         if p-append then
      193         do:
      194           output to value( v-report-name )
      195             page-size value(p-page-size) append .
      196         end.
      197         if not p-append then
      198         do:
      199           output to value( v-report-name )
      200             page-size value(p-page-size) .
      201         end.
      202       end.
      203     end.
      204   end procedure.
      205   procedure prn-lib-open-exp :
      206     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      207     define input parameter p-is-stream    as logical no-undo .
      208     define input parameter p-is-append    as logical no-undo .
      209     define output parameter p-ReportFileName as char init "report" no-undo.
      210     define output parameter p-process as logical no-undo .
      211     define variable glog as logical no-undo .
      212     do
      213       on error undo, return error
      214       :
      215       SYSTEM-DIALOG GET-FILE p-ReportFileName
      216         TITLE      "Укажите путь"
      217         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      218         ASK-OVERWRITE
      219         CREATE-TEST-FILE
      220         SAVE-AS
      221         USE-FILENAME
      222         DEFAULT-EXTENSION "txt"
      223         UPDATE glog
      224         .
      225       if not glog then  return.
      226       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      227       if p-is-stream then
      228       do:
      229         if p-is-append then
      230         do:
      231           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      232         end.
      233         else
      234         do:
      235           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      236         end.
      237       end.
      238       else
      239       do:
      240         if p-is-append then
      241         do:
      242           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      243         end.
      244         else
      245         do:
      246           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      247         end.
      248       end.
      249       p-process = yes.
      250     end.
      251   end procedure.
      252   procedure prn-lib-get-report-name :
      253     define input parameter parParentProc  as widget-handle no-undo.
      254     define output parameter p-report-name as character no-undo .
      255     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      256   end procedure.
      257   procedure prn-lib-reportviewer-report-name :
      258     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      259     define input parameter p-report-name-html as character no-undo .
      260     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      261   end procedure.
      262   procedure prn-lib-reportviewer :
      263     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      264     define input parameter p-report-name-html as character no-undo .
      265     define input parameter p-param        as character no-undo .
      266     define variable v-excel           as character no-undo init 'TRUE' .
      267     define variable v-value-character as character no-undo .
      268     define variable v-value-integer   as character no-undo .
      269     define variable v-value-date      as date      no-undo .
      270     define variable v-value-decimal   as decimal   no-undo .
      271     define variable rep-excel         as logical   no-undo .
      272     define variable excel-string      as character no-undo .
      273     define variable v-param-type      as character no-undo .
      274     define variable v-tth             as handle    no-undo .
      275     run adm/shattri.p (
      276       input "get":U
      277       ,input  ""
      278       ,input  0
      279       ,input  'report-glob':U
      280       ,input  'rep-excel':U
      281       ,output v-value-character
      282       ,output v-value-date
      283       ,output v-value-decimal
      284       ,output v-value-integer
      285       ,output rep-excel
      286       ,output v-param-type
      287       ,INPUT-OUTPUT table-handle v-tth
      288       )  .
      289     if rep-excel then v-excel = "TRUE" .
      290     else v-excel = "FALSE" .
      291     if p-param eq ""
      292     then
      293        p-param = "EXCEL:" + v-excel.
      294     else
      295        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      296     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      297   end procedure.
      298   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      299   procedure cli-grplib-get-full-name :
      300      define input parameter  p-node-code  as integer      no-undo.
      301      define output parameter p-full-name as character    no-undo.
      302   do
      303   on error undo, return error
      304   :
      305       define variable v-upper-code    as integer           no-undo.
      306       define buffer buf_cli-grp       for ub.cli-grp.
      307       define buffer buf_upper_cli-grp for ub.cli-grp.
      308       find first buf_cli-grp no-lock
      309            where buf_cli-grp.node-code = p-node-code
      310       no-error.
      311       if not available buf_cli-grp
      312       then do:
      313           undo, return error "cli-grplib-get-full-name: Не найдена группа клиентов с кодом " + string( p-node-code ).
      314       end.
      315       assign
      316           p-full-name  = ""
      317           v-upper-code = 1
      318       .
      319       do while buf_cli-grp.upper-code <> 0
      320       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
      321       :
      322           assign
      323               p-full-name  = buf_cli-grp.node-name
      324                            + (if p-full-name <> "" then chr(47) else "")
      325                            + p-full-name
      326               v-upper-code = buf_cli-grp.upper-code
      327           .
      328           find first buf_cli-grp no-lock
      329                where buf_cli-grp.node-code = v-upper-code
      330           no-error.
      331           if not available buf_cli-grp
      332           then do:
      333               undo, return error "cli-grplib-get-full-name: Не найдена группа клиентов с кодом "
      334                                   + string( v-upper-code )
      335                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      336           end.
      337       end.
      338       assign
      339       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      340       .
      341   end.
      342   end .
      343   procedure cgrplib-get-node-from-full-name :
      344   define input parameter p-full-name as character no-undo .
      345   define output parameter p-node-code as integer no-undo .
      346   define variable v-ii as integer no-undo .
      347   define variable v-upper-code as integer no-undo .
      348   define variable v-root-code as integer no-undo .
      349   define variable v-entry as character no-undo .
      350   define buffer buf_cli-grp       for ub.cli-grp.
      351   do
      352   on error undo, return error
      353   :
      354     find first buf_cli-grp no-lock
      355         where buf_cli-grp.upper-code = 0
      356     no-error .
      357     if not available buf_cli-grp
      358     then do:
      359         undo, return error substitute("Не найдена корневая группа клиентов (upper-code = 0)").
      360     end.
      361     else do:
      362       assign
      363       v-root-code = buf_cli-grp.node-code
      364       .
      365     end.
      366     v-upper-code = v-root-code.
      367     do v-ii = 1 to num-entries(p-full-name, chr(47)):
      368       assign
      369       v-entry = entry(v-ii, p-full-name, chr(47)).
      370       if v-entry = '' then leave.
      371       find first buf_cli-grp no-lock where
      372                 buf_cli-grp.node-name = v-entry
      373             and buf_cli-grp.upper-code = v-upper-code
      374             no-error.
      375       if not available buf_cli-grp then do:
      376         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
      377       end.
      378       else do:
      379         p-node-code = buf_cli-grp.node-code.
      380         v-upper-code = buf_cli-grp.node-code.
      381       end.
      382     end.
      383   end.
      384   end .
      385   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      386     define variable v-cntxt-db-num        as integer   no-undo .
      387     define variable v-cntxt-userid        as character no-undo .
      388     define variable v-cntxt-level         as character no-undo .
      389     define variable v-cntxt-host-code-obj as integer   no-undo .
      390     define variable v-cntxt-obj-type      as character no-undo .
      391     define variable v-cntxt-obj-code      as integer   no-undo .
      392     define variable v-cntxt-db-num-obj    as integer   no-undo .
      393     define variable v-cntxt-is-admin      as logical   no-undo .
      394   define output parameter p-classify  as character    no-undo .
      395   define output parameter p-tog-level as logical      no-undo .
      396   define output parameter p-var-level as integer      no-undo .
      397   define output parameter p-ok        as logical      no-undo .
      398   DEFINE BUTTON Btn_OK AUTO-END-KEY
      399        LABEL "&Отмена":L
      400        SIZE 10 BY 1
      401        BGCOLOR 8 .
      402   DEFINE BUTTON Btn_Print
      403        LABEL "&Ввод ":L
      404        SIZE 10 BY 1
      405        BGCOLOR 8 .
      406   DEFINE VARIABLE var-level AS INTEGER FORMAT ">>9":U INITIAL 1
      407        VIEW-AS FILL-IN NATIVE
      408        SIZE 5 BY .75
      409        BGCOLOR 8 FGCOLOR 0  NO-UNDO.
      410   DEFINE VARIABLE Classify AS CHARACTER
      411        VIEW-AS RADIO-SET VERTICAL
      412        RADIO-BUTTONS
      413             "Группы 1-го уровня", "no-classify":U,
      414   "Группы с n-уровнeм вложенности", "n-level":U,
      415   "Терминальные группы", "t-level":U
      416        SIZE 33 BY 3.42
      417        BGCOLOR 8 FGCOLOR 0  NO-UNDO.
      418   DEFINE VARIABLE Tog-level AS LOGICAL INITIAL no
      419        LABEL "с уровня":L
      420        VIEW-AS TOGGLE-BOX
      421        SIZE 11 BY .75
      422        BGCOLOR 8 FGCOLOR 0  NO-UNDO.
      423   DEFINE FRAME DLGOKCAN
      424        Btn_Print AT ROW 1 COL 1
      425        Btn_OK AT ROW 1 COL 11
      426        Classify AT ROW 2.75 COL 5 NO-LABEL WIDGET-ID 2
      427        Tog-level AT ROW 4 COL 38.5 WIDGET-ID 8
      428        var-level AT ROW 4 COL 48 COLON-ALIGNED NO-LABEL WIDGET-ID 10
      429        SPACE(3.24) SKIP(1.99)
      430       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      431            SIDE-LABELS THREE-D  SCROLLABLE
      432            BGCOLOR 8 FGCOLOR 0
      433            TITLE BGCOLOR 8 FGCOLOR 0 "Выбор групп товаров":L.
      434   ASSIGN
      435          FRAME DLGOKCAN:SCROLLABLE       = FALSE
      436          FRAME DLGOKCAN:PRIVATE-DATA     =
      437                   "DLGCLOSE".
      438   ASSIGN
      439          Tog-level:HIDDEN IN FRAME DLGOKCAN           = TRUE.
      440   ASSIGN
      441          var-level:HIDDEN IN FRAME DLGOKCAN           = TRUE.
      442   ON CHOOSE OF Btn_OK IN FRAME DLGOKCAN
      443   DO:
      444       return "NO" .
      445   END.
      446   ON CHOOSE OF Btn_Print IN FRAME DLGOKCAN
      447   DO:
      448     assign
      449         classify
      450         tog-level
      451         var-level
      452     .
      453     if Classify = "n-level":U and tog-level = true then do :
      454         assign
      455           p-classify  = Classify
      456           p-tog-level = tog-level
      457           p-var-level = var-level
      458           p-ok = true
      459         .
      460     end.
      461     else do :
      462         assign
      463           p-classify  = Classify
      464           p-tog-level = tog-level
      465           p-var-level = var-level
      466           p-ok = true
      467          .
      468     end.
      469   apply "GO" TO FRAME DLGOKCAN .
      470   END.
      471   ON VALUE-CHANGED OF Classify IN FRAME DLGOKCAN
      472   DO:
      473     ASSIGN Classify.
      474     if classify = "n-level":u
      475     then do:
      476       enable  tog-level  var-level with frame DLGOKCAN .
      477       display tog-level  var-level with frame DLGOKCAN .
      478     end.
      479     else do:
      480       hide    tog-level  var-level   in frame DLGOKCAN .
      481     end.
      482   END.
      483   ON VALUE-CHANGED OF Tog-level IN FRAME DLGOKCAN
      484   DO:
      485     assign tog-level.
      486     if tog-level = true then do:
      487       display var-level with frame DLGOKCAN .
      488       enable  var-level with frame DLGOKCAN .
      489     end.
      490     else do:
      491       display var-level with frame DLGOKCAN .
      492       disable var-level with frame DLGOKCAN .
      493     end.
      494   END.
      495   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME DLGOKCAN:PARENT eq ?
      496   THEN FRAME DLGOKCAN:PARENT = ACTIVE-WINDOW.
      497   ON WINDOW-CLOSE OF FRAME DLGOKCAN APPLY "END-ERROR":U TO SELF.
      498   MAIN-BLOCK:
      499   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      500           ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      501     RUN enable_UI.
      502     WAIT-FOR GO OF FRAME DLGOKCAN.
      503   END.
      504   RUN disable_UI.
      505   PROCEDURE disable_UI :
      506     HIDE FRAME DLGOKCAN.
      507   END PROCEDURE.
      508   PROCEDURE enable_UI :
      509     DISPLAY Classify
      510         WITH FRAME DLGOKCAN.
      511     ENABLE Btn_Print Btn_OK Classify
      512         WITH FRAME DLGOKCAN.
      513   END PROCEDURE.
