      265   procedure grp-obj-notcorr-value :
      266   do
      267   on error undo, return error
      268   :
      269   define input parameter p-node-code             as integer      no-undo.
      270   define input parameter p-obj-type              as character    no-undo.
      271   define input parameter p-obj-code              as integer      no-undo.
      272   define output parameter p-notcorr              as character    no-undo init ?.
      273   define output parameter p-range-notcorr     as integer      no-undo.
      274   define output parameter p-exists-notcorr    as logical      no-undo.
      275   define variable v-host-code as integer      no-undo.
      276   DEFINE VARIABLE v-found as logical no-undo .
      277   DEFINE VARIABLE v-exists as logical no-undo .
      278   DEFINE VARIABLE v-range as integer no-undo .
      279   DEFINE VARIABLE jj as integer no-undo .
      280   DEFINE VARIABLE v-notcorr-found as logical no-undo .
      281   DEFINE VARIABLE v-notcorr-value as char      no-undo.
      282   define buffer buf_gds-grp for ub.gds-grp.
      283   define buffer buf_gds-grp-obj-attr for ub.gds-grp-obj-attr  .
      284   find first buf_gds-grp no-lock where
      285              buf_gds-grp.node-code = p-node-code no-error .
      286   if not avail buf_gds-grp and p-node-code <> 0 then do:
      287     message
      288       vss-workfile vss-revision vss-description
      289       skip "Не удалось найти группу товаров с кодом" p-node-code
      290       view-as alert-box error .
      291     undo, return error .
      292   end.
      293   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      294   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      295     (input  p-obj-type
      296     ,input  p-obj-code
      297     ,output v-host-code
      298     ) no-error .
      299   if error-status :error
      300   then do:
      301       message
      302         vss-workfile vss-revision vss-description
      303         skip "Не удалось найти фирму объекта"
      304         skip p-obj-type p-obj-code
      305         skip return-value
      306         skip trim(error-status :get-message(1))
      307       view-as alert-box error.
      308       undo, return error .
      309   end.
      310   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
      311   do while v-found = no and jj < 2:
      312     if v-range <> 3 then do:
      313       find first buf_gds-grp-obj no-lock
      314           where buf_gds-grp-obj.node-code = p-node-code
      315             and buf_gds-grp-obj.host-code = v-host-code
      316             and buf_gds-grp-obj.obj-type  = p-obj-type
      317             and buf_gds-grp-obj.obj-code  = p-obj-code
      318       no-error .
      319     end.
      320     if v-range = 3 or not available buf_gds-grp-obj
      321     then do:
      322        if v-range <> 2 then do:
      323           find first buf_gds-grp-obj no-lock
      324               where buf_gds-grp-obj.node-code = p-node-code
      325                 and buf_gds-grp-obj.host-code = v-host-code
      326                 and buf_gds-grp-obj.obj-type  = ""
      327                 and buf_gds-grp-obj.obj-code  = 0
      328           no-error .
      329         end.
      330         if v-range = 2 or not available buf_gds-grp-obj
      331         then do:
      332             if v-range <> 1 then do:
      333               find first buf_gds-grp-obj no-lock
      334                   where buf_gds-grp-obj.node-code = p-node-code
      335                   and buf_gds-grp-obj.host-code = 0
      336                   and buf_gds-grp-obj.obj-type  = ""
      337                   and buf_gds-grp-obj.obj-code  = 0
      338               no-error .
      339             end.
      340             if v-range = 1 or not available buf_gds-grp-obj
      341             then do:
      342                 assign
      343                     v-exists = no
      344                 .
      345             end.
      346             else do:
      347                 assign
      348                     v-exists = yes
      349                     v-range = 1
      350                 .
      351             end.
      352         end.
      353         else do:
      354             assign
      355                 v-exists = yes
      356                 v-range  = 2
      357             .
      358         end.
      359     end.
      360     else do:
      361         assign
      362             v-exists = yes
      363             v-range  = 3
      364         .
      365     end.
      366     if available buf_gds-grp-obj
      367     then do:
      368       find first buf_gds-grp-obj-attr no-lock
      369         where buf_gds-grp-obj-attr.node-code   = p-node-code
      370           and buf_gds-grp-obj-attr.host-code   = buf_gds-grp-obj.host-code
      371           and buf_gds-grp-obj-attr.obj-type    = buf_gds-grp-obj.obj-type
      372           and buf_gds-grp-obj-attr.obj-code    = buf_gds-grp-obj.obj-code
      373           and buf_gds-grp-obj-attr.attr-code   = 'NotCorrOP':U
      374         no-error .
      375       if available buf_gds-grp-obj-attr then do:
      376         assign
      377           v-notcorr-value = (if buf_gds-grp-obj-attr.attr-value = '' then ? else buf_gds-grp-obj-attr.attr-value)
      378         .
      379       end.
      380       else do:
      381         assign
      382           v-notcorr-value = ?
      383         .
      384       end.
      385       assign
      386       p-exists-notcorr = (if v-notcorr-value <> ? and p-notcorr = ?
      387                           then yes
      388                           else p-exists-notcorr)
      389       p-range-notcorr = if p-exists-notcorr and p-notcorr = ?
      390                         then v-range
      391                         else p-range-notcorr
      392       p-notcorr   =  if p-exists-notcorr and  p-notcorr = ?
      393                         then v-notcorr-value
      394                         else p-notcorr
      395       v-found =  (p-exists-notcorr ) or (v-range <= 1)
      396       jj = jj + 1
      397       .
      398     end.
      399     else do:
      400       assign
      401       v-found =  (p-exists-notcorr  ) or (v-range <= 1)
      402       jj = jj + 1
      403       .
      404     end.
      405   end.
      406   end.
      407   end procedure.
      408   define variable vss-include-info2 as character format "X(65)" no-undo
      409   initial "@(#)$Workfile$ $Revision$".
      410   procedure grplib-get-full-name :
      411      define input parameter p-node-code  as integer      no-undo.
      412      define output parameter p-full-name as character    no-undo.
      413      do
      414   on error undo, return error
      415   :
      416       define variable v-upper-code    as integer           no-undo.
      417       define buffer buf_gds-grp       for ub.gds-grp.
      418       define buffer buf_upper_gds-grp for ub.gds-grp.
      419       find first buf_gds-grp no-lock
      420            where buf_gds-grp.node-code = p-node-code
      421       no-error.
      422       if not available buf_gds-grp
      423       then do:
      424           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      425       end.
      426       assign
      427           p-full-name  = ""
      428           v-upper-code = 1
      429       .
      430       do while buf_gds-grp.upper-code <> 0
      431       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
      432       :
      433           assign
      434               p-full-name  = buf_gds-grp.node-name
      435                            + (if p-full-name <> "" then chr(47) else "")
      436                            + p-full-name
      437               v-upper-code = buf_gds-grp.upper-code
      438           .
      439           find first buf_gds-grp no-lock
      440                where buf_gds-grp.node-code = v-upper-code
      441           no-error.
      442           if not available buf_gds-grp
      443           then do:
      444               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
      445                                   + string( v-upper-code )
      446                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      447           end.
      448       end.
      449       assign
      450       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      451       .
      452   end.
      453   end .
      454   procedure grplib-get-node-from-full-name :
      455   define input parameter p-full-name as character no-undo .
      456   define output parameter p-node-code as integer no-undo .
      457   define variable v-ii as integer no-undo .
      458   define variable v-upper-code as integer no-undo .
      459   define variable v-root-code as integer no-undo .
      460   define variable v-entry as character no-undo .
      461   define buffer buf_gds-grp       for ub.gds-grp.
      462   do
      463   on error undo, return error
      464   :
      465     find first buf_gds-grp no-lock
      466         where buf_gds-grp.upper-code = 0
      467     no-error .
      468     if not available buf_gds-grp
      469     then do:
      470         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
      471     end.
      472     else do:
      473       assign
      474       v-root-code = buf_gds-grp.node-code
      475       .
      476     end.
      477     v-upper-code = v-root-code.
      478     do v-ii = 1 to num-entries(p-full-name, chr(47)):
      479       assign
      480       v-entry = entry(v-ii, p-full-name, chr(47)).
      481       if v-entry = '' then leave.
      482       find first buf_gds-grp no-lock where
      483                 buf_gds-grp.node-name = v-entry
      484             and buf_gds-grp.upper-code = v-upper-code
      485             no-error.
      486       if not available buf_gds-grp then do:
      487         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
      488       end.
      489       else do:
      490         p-node-code = buf_gds-grp.node-code.
      491         v-upper-code = buf_gds-grp.node-code.
      492       end.
      493     end.
      494   end.
      495   end .
