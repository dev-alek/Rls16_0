      597   procedure create_obj-list :
      598      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      599      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      600      do
      601      on error undo, return error return-value
      602      :
      603         define buffer cli-obj for ub.clients .
      604         define variable p-var as integer no-undo .
      605         define buffer buf_obj-list for obj-list .
      606         find last buf_obj-list  use-index pi no-error .
      607         if available buf_obj-list
      608         then
      609            p-var = buf_obj-list.obj-id + 1.
      610         else
      611            p-var = 1.
      612         find first cli-obj where
      613                   cli-obj.obj-type = p-obj-type
      614               and cli-obj.obj-code = p-obj-code
      615         no-lock no-error.
      616         if available cli-obj
      617         then do:
      618            create buf_obj-list.
      619            assign
      620               buf_obj-list.obj-id   = p-var
      621               buf_obj-list.obj-code = cli-obj.obj-code
      622               buf_obj-list.obj-type = cli-obj.obj-type
      623               buf_obj-list.obj-name = cli-obj.obj-name
      624               buf_obj-list.db-num   = cli-obj.db-num
      625            .
      626         end.
      627      end.
      628   end.
