       81     define output parameter p-output-display as logical   no-undo .
       82     define output parameter p-other          as character no-undo .
       83     do
       84     on error undo, return error
       85     :
       86           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run ggoattr-code in g#attr-lib
       87         (input  p-code
       88         ,output p-type
       89         ,output p-format
       90         ,output p-label
       91         ,output p-user-can-edit
       92         ,output p-output-display
       93         ,output p-other
       94         ) no-error .
       95       if error-status :error
       96       then do:
       97         undo, return error return-value .
       98       end.
       99     end.
