     1021   define variable var-report-r-b as character no-undo .
     1022   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1023   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1024     (output var-report-r-b
     1025     )  .
     1026   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1027   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
     1028   define  shared variable RepPathName        as character no-undo .
     1029   define  shared variable PrintRubl          as logical   no-undo .
     1030   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1031   procedure factord :
     1032     define input  parameter p-fact-date            as date    no-undo .
     1033     define input  parameter p-fact-time            as integer no-undo .
     1034     define input  parameter p-fact-num             as integer no-undo .
     1035     define input  parameter p-shift-date           as date    no-undo .
     1036     define input  parameter p-shift-num            as integer no-undo .
     1037     define input  parameter p-shift-on             as logical no-undo .
     1038     define output parameter p-fact-order           as decimal no-undo .
     1039     define output parameter p-shift-end-fact-order as decimal no-undo .
     1040     define output parameter p-day-end-fact-order   as decimal no-undo .
     1041     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     1042     if p-fact-date = ?
     1043     then do:
     1044       return error "Не указана фактическая дата" .
     1045     end.
     1046     define variable v-fact-date-num as integer no-undo .
     1047     assign
     1048       v-fact-date-num = integer(p-fact-date)
     1049     .
     1050     if p-fact-num = ?
     1051     or p-fact-num = 0
     1052     then do:
     1053       return error "Не задан p-fact-num " + string(p-fact-num) .
     1054     end.
     1055     if p-fact-num < 0
     1056     then do:
     1057       return error "Отрицательный fact-num " + string(p-fact-num) .
     1058     end.
     1059     if p-fact-num >= 100000000
     1060     then do:
     1061       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     1062     end.
     1063     if p-shift-on = true
     1064     then do:
     1065       if p-shift-date = ?
     1066       then do:
     1067         return error "Не задана дата смены" .
     1068       end.
     1069       if p-shift-num = ?
     1070       or p-shift-num = 0
     1071       then do:
     1072         return error "Не задан номер смены" .
     1073       end.
     1074     end.
     1075     else do:
     1076       assign
     1077         p-shift-date = p-fact-date
     1078         p-shift-num  = 24
     1079       .
     1080     end.
     1081     define variable v-shift-offset as integer no-undo .
     1082     if p-shift-date = p-fact-date
     1083     then do:
     1084       assign
     1085         v-shift-offset = 1
     1086       .
     1087     end.
     1088     if p-shift-date < p-fact-date
     1089     then do:
     1090       assign
     1091         v-shift-offset = 0
     1092       .
     1093     end.
     1094     if p-shift-date > p-fact-date
     1095     then do:
     1096       message
     1097         vss-workfile vss-revision vss-description skip
     1098         "Неправильная дата закрытия смены" skip
     1099         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     1100         view-as alert-box error .
     1101       undo, return error
     1102         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     1103           ,string(p-fact-date, '99/99/9999':U)
     1104           ,string(p-shift-date, '99/99/9999':U)
     1105           )
     1106       .
     1107     end.
     1108     if p-shift-num < 1
     1109     or p-shift-num > 24
     1110     then do:
     1111       message
     1112         vss-workfile vss-revision vss-description skip
     1113         "Неправильный номер смены" skip
     1114         "p-shift-num" p-shift-num skip
     1115         view-as alert-box error .
     1116       undo, return error return-value .
     1117     end.
     1118     assign
     1119       p-fact-order           = v-fact-date-num
     1120                              + v-shift-offset * 0.5
     1121                              + p-shift-num    * 0.02 - 0.01
     1122                              + p-fact-num     * 0.0000000001
     1123       p-shift-end-fact-order = v-fact-date-num
     1124                              + v-shift-offset * 0.5
     1125                              + p-shift-num    * 0.02
     1126       p-day-end-fact-order   = v-fact-date-num
     1127                              + 0.99
     1128     .
     1129     if p-fact-order           <= v-fact-date-num
     1130     or p-shift-end-fact-order <= v-fact-date-num
     1131     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     1132     or p-shift-end-fact-order >= p-day-end-fact-order
     1133     then do:
     1134       message
     1135         vss-workfile vss-revision vss-description skip
     1136         "Внутренняя ошибка при генерации фактического номера" skip
     1137         "p-fact-date"            p-fact-date            skip
     1138         "p-fact-time"            p-fact-time            skip
     1139         "p-fact-num"             p-fact-num             skip
     1140         "p-shift-date"           p-shift-date           skip
     1141         "p-shift-num"            p-shift-num            skip
     1142         "p-shift-on"             p-shift-on             skip
     1143         "p-shift-end-fact-order" p-shift-end-fact-order skip
     1144         "p-day-end-fact-order"   p-day-end-fact-order   skip
     1145         "v-fact-date-num"        v-fact-date-num        skip
     1146         view-as alert-box error .
     1147       undo, return error return-value .
     1148     end.
     1149   end procedure.
     1150   procedure day-begin-fact-order :
     1151     define input  parameter p-fact-date            as date    no-undo .
     1152     define output parameter p-day-begin-fact-order as decimal no-undo .
     1153     do
     1154     on error undo, return error return-value
     1155     :
     1156       if p-fact-date = ?
     1157       then do:
     1158         assign
     1159           p-day-begin-fact-order = 0
     1160         .
     1161       end.
     1162       else do:
     1163         assign
     1164           p-day-begin-fact-order = integer(p-fact-date)
     1165         .
     1166       end.
     1167     end.
     1168   end procedure.
     1169   procedure factord-max-fact-order :
     1170     define output parameter p-max-fact-order as decimal   no-undo .
     1171     do
     1172     on error undo, return error return-value
     1173     :
     1174       run day-begin-fact-order in this-procedure
     1175         (input  date(1, 1, 5000)
     1176         ,output p-max-fact-order
     1177         ) .
     1178     end.
     1179   end procedure.
     1180   procedure factord-cut-archive :
     1181     define input  parameter p-obj-type             as character no-undo .
     1182     define input  parameter p-obj-code             as integer   no-undo .
     1183     define input  parameter p-fact-date            as date      no-undo .
     1184     define output parameter p-shift-on             as logical   no-undo .
     1185     define output parameter p-shift-date           as date      no-undo .
     1186     define output parameter p-shift-num            as integer   no-undo .
     1187     define output parameter p-day-end-fact-order   as decimal   no-undo .
     1188     define output parameter p-shift-end-fact-order as decimal   no-undo .
     1189     define variable v-fact-order as decimal   no-undo .
     1190     define buffer buf_shift-obj for ub.shift-obj .
     1191     do
     1192     on error undo, return error return-value
     1193     :
     1194   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1195   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1196     (input  p-obj-type
     1197     ,input  p-obj-code
     1198     ,input  'shift-on=request'
     1199     ,output p-shift-on
     1200     ) no-error .
     1201       if error-status :error
     1202       then do:
     1203         message
     1204           vss-workfile vss-revision vss-description skip
     1205           "Ошибка при определении атрибута объекта" skip
     1206           "Объект" p-obj-type p-obj-code skip
     1207           error-status :get-message(1) skip
     1208           return-value skip
     1209           view-as alert-box error .
     1210         undo, return error return-value .
     1211       end.
     1212       if p-shift-on = false
     1213       then do:
     1214         assign
     1215           p-shift-date               = ?
     1216           p-shift-num                = 0
     1217         .
     1218       end.
     1219       else do:
     1220         find first buf_shift-obj share-lock
     1221           where buf_shift-obj.obj-type   = p-obj-type
     1222             and buf_shift-obj.obj-code   = p-obj-code
     1223             and buf_shift-obj.shift-date > p-fact-date
     1224           use-index pi
     1225           no-error .
     1226         if not available buf_shift-obj
     1227         or buf_shift-obj.status_ <> 'зкр':U
     1228         then do:
     1229           message
     1230             vss-workfile vss-revision vss-description skip
     1231             "Невозможно вычислить последнюю смену" skip
     1232             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1233             "Объект" p-obj-type p-obj-code skip
     1234             "Дата" p-fact-date skip
     1235             view-as alert-box error .
     1236           undo, return error return-value .
     1237         end.
     1238         find last buf_shift-obj share-lock
     1239           where buf_shift-obj.obj-type = p-obj-type
     1240             and buf_shift-obj.obj-code = p-obj-code
     1241             and buf_shift-obj.shift-date <= p-fact-date
     1242           use-index pi
     1243           no-error .
     1244         if available buf_shift-obj
     1245         then do:
     1246           if  buf_shift-obj.status_ = 'зкр':U
     1247           then do:
     1248             assign
     1249               p-shift-date = buf_shift-obj.shift-date
     1250               p-shift-num  = buf_shift-obj.shift-num
     1251             .
     1252           end.
     1253           else do:
     1254             message
     1255               vss-workfile vss-revision vss-description skip
     1256               "Невозможно вычислить последнюю смену" skip
     1257               "Статус смены отличен от статуса" 'зкр':U skip
     1258               "Объект" p-obj-type p-obj-code skip
     1259               "Дата" p-fact-date skip
     1260               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1261               view-as alert-box error .
     1262             undo, return error return-value .
     1263           end.
     1264         end.
     1265         else do:
     1266           assign
     1267             p-shift-date = p-fact-date - 1
     1268             p-shift-num  = 1
     1269           .
     1270         end.
     1271       end.
     1272       run factord in this-procedure
     1273         (input  p-fact-date
     1274         ,input  1
     1275         ,input  1
     1276         ,input  p-shift-date
     1277         ,input  p-shift-num
     1278         ,input  p-shift-on
     1279         ,output v-fact-order
     1280         ,output p-shift-end-fact-order
     1281         ,output p-day-end-fact-order
     1282         ) no-error .
     1283       if error-status :error
     1284       then do:
     1285         message
     1286           vss-workfile vss-revision vss-description skip
     1287           "Ошибка при вызове процедуры factord"
     1288           error-status :get-message(1) skip
     1289           return-value skip
     1290           view-as alert-box error .
     1291         undo, return error return-value .
     1292       end.
     1293     end.
     1294   end procedure.
     1295   procedure factord-lock-shift :
     1296     define input  parameter p-obj-type  as character no-undo .
     1297     define input  parameter p-obj-code  as integer   no-undo .
     1298     define input  parameter p-fact-date as date      no-undo .
     1299     define parameter buffer buf_shift-obj for ub.shift-obj .
     1300     define variable v-shift-on      as logical   no-undo .
     1301     define variable v-extra-message as character no-undo .
     1302     define variable v-error as character no-undo .
     1303     do
     1304     on error undo, return error return-value
     1305     :
     1306   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1307   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1308     (input  p-obj-type
     1309     ,input  p-obj-code
     1310     ,input  'shift-on=request'
     1311     ,output v-shift-on
     1312     ) no-error .
     1313       if error-status :error
     1314       then do:
     1315         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1316         undo, return error v-error .
     1317       end.
     1318       if v-shift-on = true
     1319       then do:
     1320         find first buf_shift-obj share-lock
     1321           where buf_shift-obj.obj-type   = p-obj-type
     1322             and buf_shift-obj.obj-code   = p-obj-code
     1323             and buf_shift-obj.shift-date > p-fact-date
     1324           use-index pi
     1325           no-error .
     1326         if not available buf_shift-obj
     1327         or buf_shift-obj.status_ <> 'зкр':U
     1328         then do:
     1329           find last buf_shift-obj
     1330             where buf_shift-obj.obj-type = p-obj-type
     1331               and buf_shift-obj.obj-code = p-obj-code
     1332               and buf_shift-obj.status_  = 'зкр':U
     1333             use-index stts
     1334             no-error .
     1335           if available buf_shift-obj
     1336           then do:
     1337             assign
     1338               v-extra-message =
     1339                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1340                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1341                               )
     1342             .
     1343           end.
     1344           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1345           undo, return error v-error .
     1346         end.
     1347       end.
     1348     end.
     1349   end procedure.
     1350   procedure factord-end-day :
     1351     define input  parameter p-fact-date            as date    no-undo .
     1352     define output parameter p-day-end-fact-order   as decimal no-undo .
     1353     do
     1354     on error undo, return error return-value
     1355     :
     1356       if p-fact-date = ?
     1357       then do:
     1358         return error "Не указана фактическая дата" .
     1359       end.
     1360       assign
     1361         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1362       .
     1363     end.
     1364   end procedure.
     1365   procedure factord-to-date :
     1366     define input  parameter p-fact-order as decimal no-undo .
     1367     define output parameter p-fact-date  as date    no-undo .
     1368     define variable v-ref-date  as date      no-undo .
     1369     define variable v-ref-delta as integer   no-undo .
     1370     do
     1371     on error undo, return error return-value
     1372     :
     1373       if p-fact-order = ?
     1374       or p-fact-order = 0
     1375       then do:
     1376         return error "Не указан fact-order" .
     1377       end.
     1378       assign
     1379         v-ref-date  = date(1, 1, 2000)
     1380       .
     1381       assign
     1382         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1383       .
     1384       assign
     1385         p-fact-date = v-ref-date + v-ref-delta
     1386       .
     1387     end.
     1388   end procedure.
     1389   procedure factord-to-fact-num :
     1390     define input  parameter p-fact-order as decimal no-undo .
     1391     define output parameter p-fact-num   as integer no-undo .
     1392     define variable v-fact-order-trunc as decimal no-undo .
     1393     do
     1394     on error undo, return error return-value
     1395     :
     1396       if p-fact-order = ?
     1397       or p-fact-order = 0
     1398       then do:
     1399         return error "Не указан fact-order" .
     1400       end.
     1401       assign
     1402        v-fact-order-trunc = truncate(p-fact-order, 2)
     1403       .
     1404       assign
     1405         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1406       .
     1407     end.
     1408   end procedure.
     1409   procedure factord-to-shift-num :
     1410     define input  parameter p-fact-order as decimal no-undo .
     1411     define output parameter p-shift-num   as integer no-undo .
     1412     define variable  p-shift-numd  as decimal   no-undo .
     1413     define variable v-fact-order-trunc as decimal no-undo .
     1414     do
     1415     on error undo, return error return-value
     1416     :
     1417       if p-fact-order = ?
     1418       or p-fact-order = 0
     1419       then do:
     1420         return error "Не указан fact-order" .
     1421       end.
     1422       assign
     1423        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1424       .
     1425       if v-fact-order-trunc < 0.5 then do:
     1426         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1427       end.
     1428       assign
     1429         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1430         .
     1431        assign
     1432         p-shift-num = truncate (p-shift-numd , 0)
     1433       .
     1434     end.
     1435   end procedure.
     1436   PROCEDURE ostatok :
     1437   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
     1438   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
     1439   def input parameter x-tog-shift   as   logical             no-undo.
     1440   def input parameter x-date-start  like ub.stk-tot.Fact-date   no-undo.
     1441   def input parameter x-date-end    like ub.stk-tot.Fact-date   no-undo.
     1442   def input parameter x-shift-start as integer               no-undo.
     1443   def input parameter x-shift-end   as integer               no-undo.
     1444   def input parameter x-sum-type    like ub.stk-tot.sum-type    no-undo.
     1445   def input parameter x-cat-id      like ub.stk-tot.cat-id      no-undo.
     1446   def input parameter xTog-obj   as log no-undo.
     1447   def output parameter Quantity    like ub.stk-tot.fact-qnty   no-undo.
     1448   def output parameter Coast_R     like ub.stk-tot.sum-rubl    no-undo.
     1449   def output parameter Coast_V     like ub.stk-tot.sum-rubl    no-undo.
     1450   def output parameter VAT_R       like ub.stk-tot.sum-rubl    no-undo.
     1451   def output parameter VAT_V       like ub.stk-tot.sum-rubl    no-undo.
     1452   def output parameter Fact-order  like ub.stk-tot.Fact-order  no-undo.
     1453   def var              Fact-order#   like ub.stk-tot.Fact-order  no-undo.
     1454   def var              Fact-orderS   as char  no-undo.
     1455   def var x-date-start-t  like ub.stk-tot.shift-date   no-undo.
     1456      Assign
     1457         Fact-order   = 0
     1458         Quantity     = 0
     1459         Coast_R      = 0
     1460         Coast_V      = 0
     1461         VAT_R        = 0
     1462         VAT_V        = 0 .
     1463    x-date-start-t  = x-date-start + 1 .
     1464   IF x-date-end = date('') then DO:
     1465      Fact-order = 0 .
     1466      for each obj-list
     1467          where  ( not xtog-obj or
     1468                 ( x-store-type = obj-list.obj-type and x-store-code = obj-list.obj-code ))
     1469                 no-lock :
     1470         if  x-tog-shift = false then do:
     1471                          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     1472                               ub.stk-tot.Fact-date <=  x-date-start
     1473                               and ub.stk-tot.shift-num = 0
     1474                               USE-INDEX fact-date no-lock no-error .
     1475              if Available ub.stk-tot THEN  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     1476         End.
     1477         Else  DO :
     1478             find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     1479              (ub.stk-tot.shift-date  = x-date-start-t and
     1480               ub.stk-tot.shift-num  < x-shift-start or
     1481               ub.stk-tot.shift-date  < x-date-start-t  )
     1482               and ub.stk-tot.shift-num  > 0
     1483               USE-INDEX Shift-num no-lock no-error .
     1484            If Available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     1485           END.
     1486       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     1487     End.
     1488   End.
     1489   Else DO:
     1490     For each obj-list  WHERE
     1491        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
     1492         no-lock :
     1493      IF  x-TOG-Shift = False Then DO:
     1494          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     1495               ub.stk-tot.Fact-date <= x-date-end
     1496               and ub.stk-tot.shift-num = 0
     1497               USE-INDEX fact-date no-lock no-error.
     1498          if available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     1499      END.
     1500      Else DO:
     1501           find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     1502               (ub.stk-tot.shift-date  = x-date-end and
     1503               ub.stk-tot.shift-num  <= x-shift-end or
     1504               ub.stk-tot.shift-date  < x-date-end       ) and
     1505               ub.stk-tot.shift-num   > 0      use-index shift-num no-lock no-error.
     1506               if Available ub.stk-tot THEN Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     1507       End.
     1508       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     1509     End.
     1510   End.
     1511   END PROCEDURE.
     1512   def var vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1513   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     1514   procedure paramls-clear :
     1515     define buffer buf_temp-param for temp-param .
     1516     do
     1517     on error undo, return error return-value
     1518     :
     1519       for each buf_temp-param
     1520       on error undo, return error
     1521       :
     1522         delete buf_temp-param .
     1523       end.
     1524     end.
     1525   end procedure.
     1526   procedure paramls-write :
     1527     define input  parameter p-code     as character no-undo .
     1528     define input  parameter p-sub-code as character no-undo .
     1529     define input  parameter p-value    as character no-undo .
     1530     define buffer buf_temp-param for temp-param .
     1531     do
     1532     on error undo, return error return-value
     1533     :
     1534       find first buf_temp-param
     1535         where buf_temp-param.param-code     = p-code
     1536           and buf_temp-param.param-sub-code = p-sub-code
     1537         no-error .
     1538       if not available buf_temp-param then do:
     1539         create buf_temp-param .
     1540         assign
     1541           buf_temp-param.param-code     = p-code
     1542           buf_temp-param.param-sub-code = p-sub-code
     1543         .
     1544       end.
     1545       assign
     1546         buf_temp-param.param-value = p-value
     1547       .
     1548     end.
     1549   end procedure.
     1550   procedure paramls-read :
     1551     define input  parameter p-code          as character no-undo .
     1552     define input  parameter p-sub-code      as character no-undo .
     1553     define input  parameter p-default-value as character no-undo .
     1554     define output parameter p-value         as character no-undo .
     1555     define buffer buf_temp-param for temp-param .
     1556     do
     1557     on error undo, return error return-value
     1558     :
     1559       find first buf_temp-param
     1560         where buf_temp-param.param-code     = p-code
     1561           and buf_temp-param.param-sub-code = p-sub-code
     1562         no-error .
     1563       if available buf_temp-param then do:
     1564         assign
     1565           p-value = buf_temp-param.param-value
     1566         .
     1567       end.
     1568       else do:
     1569         assign
     1570           p-value = p-default-value
     1571         .
     1572       end.
     1573     end.
     1574   end procedure.
     1575   procedure paramls-append :
     1576     define input  parameter p-code     as character no-undo .
     1577     define input  parameter p-sub-code as character no-undo .
     1578     define input  parameter p-value    as character no-undo .
     1579     define buffer buf_temp-param for temp-param .
     1580     do
     1581     on error undo, return error return-value
     1582     :
     1583       find first buf_temp-param
     1584            where buf_temp-param.param-code     = p-code
     1585              and buf_temp-param.param-sub-code = p-sub-code
     1586         no-error .
     1587       if not available buf_temp-param then do:
     1588         create buf_temp-param .
     1589         assign
     1590           buf_temp-param.param-code     = p-code
     1591           buf_temp-param.param-sub-code = p-sub-code
     1592           buf_temp-param.param-value    = p-value
     1593         .
     1594       end.
     1595       else do:
     1596           assign
     1597               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     1598           .
     1599       end.
     1600     end.
     1601   end procedure.
     1602   define stream excel-line.
     1603   define stream excel-cell.
     1604   define variable v-mdtcxl-sheet1-cur-data-row     as integer      no-undo.
     1605   define variable v-mdtcxl-sheet2-cur-data-row     as integer      no-undo.
     1606   define variable v-mdtcxl-cell-file-name       as character    no-undo.
     1607   define variable v-mdtcxl-data-file-name       as character    no-undo.
     1608   procedure mdtcxl-init :
     1609       run gbl/_tmpfile.p (
     1610             input "xd"
     1611           , input ".txt"
     1612           , output v-mdtcxl-data-file-name
     1613       ).
     1614       output stream excel-line to value( v-mdtcxl-data-file-name ).
     1615       run gbl/_tmpfile.p (
     1616             input "xc"
     1617           , input ".txt"
     1618           , output v-mdtcxl-cell-file-name
     1619       ).
     1620       output stream excel-cell to value( v-mdtcxl-cell-file-name ).
     1621       run mdtcxl-write-cell-data in this-procedure (
     1622             input "sheetList":U
     1623           , input "Sheet1":U
     1624       ).
     1625       run mdtcxl-write-cell-data in this-procedure (
     1626             input "Sheet1_valutCode":U
     1627           , input "0":U
     1628       ).
     1629       run mdtcxl-write-cell-data in this-procedure (
     1630             input "Sheet1_columnList":U
     1631           , input "gds_name,start_qnty,all_rcv_qnty,all_spent_qnty,end_qnty":U
     1632       ).
     1633       run mdtcxl-write-cell-data in this-procedure (
     1634             input "Sheet1_columnType":U
     1635           , input "S,D,D,D,D":U
     1636       ).
     1637       run mdtcxl-write-cell-data in this-procedure (
     1638             input "Sheet1_subtotalList":U
     1639           , input "":U
     1640       ).
     1641       run mdtcxl-write-cell-data in this-procedure (
     1642             input "Sheet1_subtotalType":U
     1643           , input "":U
     1644       ).
     1645   end procedure.
     1646   procedure mdtcxl-sheet1-write-line-data :
     1647       define input parameter p-gds-name       as character    no-undo.
     1648       define input parameter p-unit-base      as character    no-undo.
     1649       define input parameter p-start-qnty     as decimal      no-undo.
     1650       define input parameter p-all-rcv-qnty   as decimal      no-undo.
     1651       define input parameter p-all-spent-qnty as decimal      no-undo.
     1652       define input parameter p-end-qnty       as decimal      no-undo.
     1653       put stream excel-line UNFORMATTED
     1654           "Sheet1":U
     1655           CHR(9) "DTA":U
     1656           CHR(9) subst("&1, &2", p-gds-name, p-unit-base)
     1657           CHR(9) p-start-qnty
     1658           CHR(9) p-all-rcv-qnty
     1659           CHR(9) p-all-spent-qnty
     1660           CHR(9) p-end-qnty
     1661           chr(10)
     1662       .
     1663   end procedure.
     1664   procedure mdtcxl-write-cell-data :
     1665       define input parameter p-key as character no-undo.
     1666       define input parameter p-val as character no-undo.
     1667       put stream excel-cell UNFORMATTED
     1668           p-key CHR(9) p-val chr(10)
     1669       .
     1670   end procedure.
     1671   procedure mdtcxl-close :
     1672       output to value( string( session:temp-directory + "rpt" + string( g#report-num ) ) + ".txl" ) append.
     1673       export "exe/mdtc.xlt":U.
     1674       export "exe/t_form.bas":U.
     1675       export v-mdtcxl-cell-file-name.
     1676       export v-mdtcxl-data-file-name.
     1677       output stream excel-line close.
     1678       output stream excel-cell close.
     1679   end procedure.
     1680   define variable v-all-units as character no-undo.
     1681   define stream Out-Stream.
     1682   define temp-table tt-line no-undo
     1683       field artic as character
     1684       field prod-type as character
     1685       field prod-code as integer
     1686       field obj-type as character
     1687       field obj-code as integer
     1688       field gds-name as character
     1689       field unit-base as character
     1690       field start-qnty as decimal
     1691       field end-qnty as decimal
     1692       field all-rcv-qnty as decimal
     1693       field all-spent-qnty as decimal
     1694       index pi as unique artic prod-type prod-code obj-type obj-code
     1695   .
     1696   define frame frm1
     1697           sym1
     1698           tt-line.gds-name        format "x(50)"
     1699           sym2
     1700           tt-line.start-qnty      format "      ->>>,>>>,>>9.99"
     1701           sym3
     1702           tt-line.all-rcv-qnty    format "      ->>>,>>>,>>9.99"
     1703           sym4
     1704           tt-line.all-spent-qnty  format "      ->>>,>>>,>>9.99"
     1705           sym5
     1706           tt-line.end-qnty        format "      ->>>,>>>,>>9.99"
     1707           sym6
     1708       header
     1709           fill("-", 150) format "x(150)" skip
     1710           subst(
     1711               ": НАИМЕНОВАНИЕ                                       : Остаток на &1 :              Получено :         Израсходовано : Остаток на &2 :",
     1712               string(x-Date-Start, "99/99/9999"),
     1713               string(x-Date-End, "99/99/9999")
     1714           ) format "x(150)"
     1715   with width 150 down stream-io use-text NO-BOX NO-LABELS
     1716   .
     1717   run prepare-rep.
     1718   run fill-goods.
     1719   run fill-info.
     1720   run calc.
     1721   run format-rep.
     1722   run close-rep.
     1723   procedure prepare-rep:
     1724       run get-gds-engl    in my-handle ( output g#gds-engl ).
     1725       run get-quest-print in my-handle ( output g#quest-print ).
     1726       run get-report-num  in my-handle ( output g#report-num ).
     1727   output STREAM Out-Stream to value( string( session:temp-directory +
     1728                                        "rpt" + string( g#report-num ) ) )
     1729                                        page-size  value(43) .
     1730   end.
     1731   procedure close-rep:
     1732       define variable v-user-action   as character no-undo .
     1733       define variable v-printed       as logical   no-undo .
     1734       define variable ReportFontNum   as integer   no-undo .
     1735       output stream Out-Stream close.
     1736       run gbl/prnfilen.w
     1737           ( input  ""
     1738           , input  8
     1739           , input  string(session :temp-directory) + "rpt" + string( g#report-num )
     1740           , input  ReportFontNum
     1741           , output v-user-action
     1742           , output v-printed
     1743           ) .
     1744       os-delete value( string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )  .
     1745   end.
     1746   function gds-in-grp returns logical(
     1747                                       p-artic as character,
     1748                                       p-prod-type as character,
     1749                                       p-prod-code as integer
     1750                                   ):
     1751       define variable v-upper-code as integer no-undo.
     1752       define variable v-value as character no-undo.
     1753       define variable v-type as character no-undo.
     1754       define buffer lc_goods for ub.goods.
     1755       define buffer lc_gds-grp for ub.gds-grp.
     1756       find first lc_goods
     1757           where lc_goods.artic = p-artic
     1758           and lc_goods.prod-type = p-prod-type
     1759           and lc_goods.prod-code = p-prod-code
     1760           no-lock.
     1761       v-upper-code = lc_goods.grp-code.
     1762       do while v-upper-code > 0 :
     1763           find first lc_gds-grp
     1764               where lc_gds-grp.node-code = v-upper-code
     1765               no-lock.
     1766           run ggoattr-value(
     1767             input lc_gds-grp.node-code,
     1768             input 0,
     1769             input "",
     1770             input 0,
     1771             input 'no-inc-auto-rep':U,
     1772             output v-value,
     1773             output v-type
     1774           ).
     1775           if v-value = "yes" then
     1776               return true.
     1777           else
     1778               v-upper-code = lc_gds-grp.upper-code.
     1779       end.
     1780       return false.
     1781   end.
     1782   procedure fill-info:
     1783       define buffer lc_goods for ub.goods.
     1784       for each tt-line no-lock:
     1785           find first lc_goods no-lock
     1786               where lc_goods.artic = tt-line.artic
     1787               and lc_goods.prod-type = tt-line.prod-type
     1788               and lc_goods.prod-code = tt-line.prod-code.
     1789           assign
     1790               tt-line.gds-name = lc_goods.gds-name
     1791               tt-line.unit-base = lc_goods.unit-base
     1792           .
     1793           if lookup(tt-line.unit-base, v-all-units) = 0 then do:
     1794               v-all-units = v-all-units + (if v-all-units = "" then "" else ", ") + tt-line.unit-base.
     1795           end.
     1796       end.
     1797   end.
     1798   procedure fill-goods:
     1799       define variable v-grp-fullname as character no-undo.
     1800       define buffer lc_goods for ub.goods.
     1801       define buffer lc_gds-obj for ub.gds-obj.
     1802       for each obj-list no-lock:
     1803           case x-SelectGood:
     1804               when 1 then do:
     1805                    for each lc_gds-obj no-lock
     1806                       where lc_gds-obj.obj-type = obj-list.obj-type
     1807                       and lc_gds-obj.obj-code = obj-list.obj-code
     1808                       :
     1809                           run create-line(
     1810                               lc_gds-obj.artic,
     1811                               lc_gds-obj.prod-type,
     1812                               lc_gds-obj.prod-code,
     1813                               lc_gds-obj.obj-type,
     1814                               lc_gds-obj.obj-code
     1815                           ).
     1816                    end.
     1817               end.
     1818               when 3 then do:
     1819                   for each g#cli no-lock:
     1820                       for each lc_gds-obj no-lock
     1821                           where lc_gds-obj.obj-type = obj-list.obj-type
     1822                           and lc_gds-obj.obj-code = obj-list.obj-code
     1823                           and lc_gds-obj.prod-type = g#cli.obj-type
     1824                           and lc_gds-obj.prod-code = g#cli.obj-code
     1825                           :
     1826                               run create-line(
     1827                                   lc_gds-obj.artic,
     1828                                   lc_gds-obj.prod-type,
     1829                                   lc_gds-obj.prod-code,
     1830                                   lc_gds-obj.obj-type,
     1831                                   lc_gds-obj.obj-code
     1832                               ).
     1833                       end.
     1834                   end.
     1835               end.
     1836               when 2 then do:
     1837                   for each tmp#grp no-lock:
     1838                       run grplib-get-full-name(tmp#grp.node-code, output v-grp-fullname).
     1839                       for each lc_gds-obj no-lock
     1840                           where lc_gds-obj.obj-type = obj-list.obj-type
     1841                           and lc_gds-obj.obj-code = obj-list.obj-code
     1842                           and lc_gds-obj.grp-name begins v-grp-fullname
     1843                           :
     1844                               run create-line(
     1845                                   lc_gds-obj.artic,
     1846                                   lc_gds-obj.prod-type,
     1847                                   lc_gds-obj.prod-code,
     1848                                   lc_gds-obj.obj-type,
     1849                                   lc_gds-obj.obj-code
     1850                               ).
     1851                       end.
     1852                   end.
     1853               end.
     1854               otherwise do:
     1855                   for each gds-list no-lock:
     1856                       for each lc_gds-obj no-lock
     1857                           where lc_gds-obj.obj-type = obj-list.obj-type
     1858                           and lc_gds-obj.obj-code = obj-list.obj-code
     1859                           and lc_gds-obj.artic = gds-list.artic
     1860                           and lc_gds-obj.prod-type = gds-list.prod-type
     1861                           and lc_gds-obj.prod-code = gds-list.prod-code
     1862                           :
     1863                               run create-line(
     1864                                   lc_gds-obj.artic,
     1865                                   lc_gds-obj.prod-type,
     1866                                   lc_gds-obj.prod-code,
     1867                                   lc_gds-obj.obj-type,
     1868                                   lc_gds-obj.obj-code
     1869                               ).
     1870                       end.
     1871                   end.
     1872               end.
     1873           end.
     1874       end.
     1875   end.
     1876   procedure calc:
     1877       define variable v-factord-start as decimal no-undo.
     1878       define variable v-factord-end   as decimal no-undo.
     1879       define variable tmp             as decimal no-undo.
     1880       define variable v-has-ob        as logical no-undo.
     1881       define buffer lc_stk-line for ub.stk-line.
     1882       define buffer lc_ot-line for ub.ot-line.
     1883       if not x-TOG-Shift then do:
     1884           run day-begin-fact-order(x-Date-Start, output v-factord-start).
     1885           run factord-end-day(x-Date-End, output v-factord-end).
     1886       end.
     1887       for each tt-line:
     1888           if x-TOG-Shift then do:
     1889               run ostatok(
     1890                   tt-line.obj-code,
     1891                   tt-line.obj-type,
     1892                   x-TOG-Shift,
     1893                   x-Date-Start - 1,
     1894                   date(''),
     1895                   x-Shift-Start,
     1896                   x-Shift-End,
     1897                   'cost':U,
     1898                   '##,##':U,
     1899                   true,
     1900                   output tmp,
     1901                   output tmp,
     1902                   output tmp,
     1903                   output tmp,
     1904                   output tmp,
     1905                   output v-factord-start
     1906               ).
     1907               run ostatok(
     1908                   tt-line.obj-code,
     1909                   tt-line.obj-type,
     1910                   x-TOG-Shift,
     1911                   x-Date-Start,
     1912                   x-Date-End,
     1913                   x-Shift-Start,
     1914                   x-Shift-End,
     1915                   'cost':U,
     1916                   '##,##':U,
     1917                   true,
     1918                   output tmp,
     1919                   output tmp,
     1920                   output tmp,
     1921                   output tmp,
     1922                   output tmp,
     1923                   output v-factord-end
     1924               ).
     1925           end.
     1926           find last lc_stk-line
     1927               where lc_stk-line.obj-code = tt-line.obj-code
     1928               and lc_stk-line.obj-type = tt-line.obj-type
     1929               and lc_stk-line.fact-order <= v-factord-start
     1930               and lc_stk-line.cat-id = '##,##':U
     1931               and lc_stk-line.sum-type = 'cost':U
     1932               and lc_stk-line.artic = tt-line.artic
     1933               and lc_stk-line.prod-type = tt-line.prod-type
     1934               and lc_stk-line.prod-code = tt-line.prod-code
     1935               no-lock no-error.
     1936           if not avail lc_stk-line then
     1937               tt-line.start-qnty = 0.
     1938           else
     1939               tt-line.start-qnty = lc_stk-line.fact-qnty.
     1940           find last lc_stk-line
     1941               where lc_stk-line.obj-code = tt-line.obj-code
     1942               and lc_stk-line.obj-type = tt-line.obj-type
     1943               and lc_stk-line.fact-order <= v-factord-end
     1944               and lc_stk-line.cat-id = '##,##':U
     1945               and lc_stk-line.sum-type = 'cost':U
     1946               and lc_stk-line.artic = tt-line.artic
     1947               and lc_stk-line.prod-type = tt-line.prod-type
     1948               and lc_stk-line.prod-code = tt-line.prod-code
     1949               no-lock no-error.
     1950           if not avail lc_stk-line then
     1951               tt-line.end-qnty = 0.
     1952           else
     1953               tt-line.end-qnty = lc_stk-line.fact-qnty.
     1954           v-has-ob = false.
     1955           for each lc_ot-line no-lock
     1956               where lc_ot-line.artic = tt-line.artic
     1957               and lc_ot-line.prod-type = tt-line.prod-type
     1958               and lc_ot-line.prod-code = tt-line.prod-code
     1959               and lc_ot-line.obj-type = tt-line.obj-type
     1960               and lc_ot-line.obj-code = tt-line.obj-code
     1961               and lc_ot-line.cat-id = '##,##':U
     1962               and lc_ot-line.sum-type = 'cost':U
     1963               and lc_ot-line.fact-order >= v-factord-start
     1964               and lc_ot-line.fact-order <= v-factord-end
     1965               :
     1966                   v-has-ob = true.
     1967                   case lc_ot-line.ext-doc-type:
     1968                      when 'ie':U           or
     1969                      when 'iv':U           or
     1970                      when 'rv':U       or
     1971                      when 'im':U then do:
     1972                          tt-line.all-rcv-qnty = tt-line.all-rcv-qnty + lc_ot-line.fact-qnty.
     1973                      end.
     1974                      when 'ee':U           or
     1975                      when 'es':U      or
     1976                      when 'ep':U        or
     1977                      when 'we':U           or
     1978                      when 'ev':U           or
     1979                      when 'em':U            or
     1980                      when 'wm':U then do:
     1981                          tt-line.all-spent-qnty = tt-line.all-spent-qnty - lc_ot-line.fact-qnty.
     1982                      end.
     1983                      otherwise do:
     1984                           if lc_ot-line.ext-doc-type = 'vt':U and  lc_ot-line.fact-qnty > 0 then
     1985                           tt-line.all-rcv-qnty = tt-line.all-rcv-qnty + lc_ot-line.fact-qnty.
     1986                           else if lc_ot-line.ext-doc-type = 'vt':U and lc_ot-line.fact-qnty <= 0 then
     1987                           tt-line.all-spent-qnty = tt-line.all-spent-qnty - lc_ot-line.fact-qnty.
     1988                      end.
     1989                  end.
     1990           end.
     1991           if not v-has-ob then
     1992               delete tt-line.
     1993       end.
     1994   end.
     1995   procedure create-line:
     1996       define input parameter p-artic as character no-undo.
     1997       define input parameter p-prod-type as character no-undo.
     1998       define input parameter p-prod-code as integer no-undo.
     1999       define input parameter p-obj-type as character no-undo.
     2000       define input parameter p-obj-code as integer no-undo.
     2001       if not gds-in-grp(p-artic, p-prod-type, p-prod-code) then
     2002           return.
     2003       find first tt-line
     2004           where tt-line.artic = p-artic
     2005           and tt-line.prod-type = p-prod-type
     2006           and tt-line.prod-code = p-prod-code
     2007           and tt-line.obj-type = p-obj-type
     2008           and tt-line.obj-code = p-obj-code
     2009           no-error.
     2010       if not avail tt-line then do:
     2011           create tt-line.
     2012           assign
     2013               tt-line.artic = p-artic
     2014               tt-line.prod-type = p-prod-type
     2015               tt-line.prod-code = p-prod-code
     2016               tt-line.obj-type = p-obj-type
     2017               tt-line.obj-code = p-obj-code
     2018           .
     2019       end.
     2020   end.
     2021   procedure format-rep:
     2022       define variable v-sum-start-qnty as decimal no-undo.
     2023       define variable v-sum-all-rcv-qnty as decimal no-undo.
     2024       define variable v-sum-all-spent-qnty as decimal no-undo.
     2025       define variable v-sum-end-qnty as decimal no-undo.
     2026       for each obj-list:
     2027           run mdtcxl-init.
     2028           run mdtcxl-write-cell-data(
     2029               "obj_num_1":U,
     2030               "движение одноразовой посуды по кафе АЗК № " + string(obj-list.obj-code)
     2031           ).
     2032           run mdtcxl-write-cell-data(
     2033               "obj_num_2":U,
     2034               "Количество одноразовой посуды, полученной в кафе на АЗК № " + string(obj-list.obj-code)
     2035           ).
     2036           run mdtcxl-write-cell-data(
     2037               "date_interval":U,
     2038               subst("период с &1 по &2г.", string(x-Date-Start, "99/99/9999"), string(x-Date-End, "99/99/9999"))
     2039           ).
     2040           run mdtcxl-write-cell-data(
     2041               "start_date_header":U,
     2042               "Остаток на " + string(x-Date-Start, "99/99/99")
     2043           ).
     2044           run mdtcxl-write-cell-data(
     2045               "end_date_header":U,
     2046               "Остаток на " + string(x-Date-End, "99/99/99")
     2047           ).
     2048           put stream Out-Stream unformatted
     2049           skip
     2050           fill(" ", 100) "ОАО 'РН-Москва' " skip(2)
     2051           fill(" ", 74) "Отчет " skip
     2052           fill(" ", 55) "Движение одноразовой посуды по кафе АЗК № " obj-list.obj-code skip
     2053           fill(" ", 50) "Количество одноразовой посуды, полученной в кафе на АЗК № " obj-list.obj-code skip
     2054           fill(" ", 60) "период с " string(x-Date-Start, "99/99/9999") " по " string(x-Date-End, "99/99/9999") "г." skip
     2055           .
     2056           assign
     2057               v-sum-start-qnty = 0
     2058               v-sum-all-rcv-qnty = 0
     2059               v-sum-all-spent-qnty = 0
     2060               v-sum-end-qnty = 0
     2061           .
     2062           for each tt-line no-lock
     2063               where tt-line.obj-code = obj-list.obj-code
     2064               and tt-line.obj-type = obj-list.obj-type
     2065               :
     2066                   v-sum-start-qnty = v-sum-start-qnty + tt-line.start-qnty.
     2067                   v-sum-all-rcv-qnty = v-sum-all-rcv-qnty + tt-line.all-rcv-qnty.
     2068                   v-sum-all-spent-qnty = v-sum-all-spent-qnty + tt-line.all-spent-qnty.
     2069                   v-sum-end-qnty = v-sum-end-qnty + tt-line.end-qnty.
     2070                   run mdtcxl-sheet1-write-line-data(
     2071                       tt-line.gds-name,
     2072                       tt-line.unit-base,
     2073                       tt-line.start-qnty,
     2074                       tt-line.all-rcv-qnty,
     2075                       tt-line.all-spent-qnty,
     2076                       tt-line.end-qnty
     2077                   ).
     2078                   disp stream Out-Stream
     2079                       sym1
     2080                       subst("&1, &2", tt-line.gds-name, tt-line.unit-base) @ tt-line.gds-name
     2081                       sym2
     2082                       "" @ tt-line.start-qnty
     2083                       sym3
     2084                       "" @ tt-line.all-rcv-qnty
     2085                       sym4
     2086                       "" @ tt-line.all-spent-qnty
     2087                       sym5
     2088                       "" @ tt-line.end-qnty
     2089                       sym6
     2090                   with frame frm1.
     2091                   down stream Out-Stream with frame frm1.
     2092                   disp stream Out-Stream
     2093                       sym1
     2094                       "Кол-во" @ tt-line.gds-name
     2095                       sym2
     2096                       tt-line.start-qnty
     2097                       sym3
     2098                       tt-line.all-rcv-qnty
     2099                       sym4
     2100                       tt-line.all-spent-qnty
     2101                       sym5
     2102                       tt-line.end-qnty
     2103                       sym6
     2104                   with frame frm1.
     2105                   down stream Out-Stream with frame frm1.
     2106           end.
     2107           run mdtcxl-write-cell-data(
     2108               "Sheet1_it_start_qnty":U,
     2109               v-sum-start-qnty
     2110           ).
     2111           run mdtcxl-write-cell-data(
     2112               "Sheet1_it_all_rcv_qnty":U,
     2113               v-sum-all-rcv-qnty
     2114           ).
     2115           run mdtcxl-write-cell-data(
     2116               "Sheet1_it_all_spent_qnty":U,
     2117               v-sum-all-spent-qnty
     2118           ).
     2119           run mdtcxl-write-cell-data(
     2120               "Sheet1_it_end_qnty":U,
     2121               v-sum-end-qnty
     2122           ).
     2123           put stream Out-Stream unformatted fill("-", 150) format "x(150)" skip.
     2124           disp stream Out-Stream
     2125               sym1
     2126               "Итого" @ tt-line.gds-name
     2127               sym2
     2128               "" @ tt-line.start-qnty
     2129               sym3
     2130               "" @ tt-line.all-rcv-qnty
     2131               sym4
     2132               "" @ tt-line.all-spent-qnty
     2133               sym5
     2134               "" @ tt-line.end-qnty
     2135               sym6
     2136           with frame frm1.
     2137           down stream Out-Stream with frame frm1.
     2138           disp stream Out-Stream
     2139               sym1
     2140               "Количество" @ tt-line.gds-name
     2141               sym2
     2142               v-sum-start-qnty @ tt-line.start-qnty
     2143               sym3
     2144               v-sum-all-rcv-qnty @ tt-line.all-rcv-qnty
     2145               sym4
     2146               v-sum-all-spent-qnty @ tt-line.all-spent-qnty
     2147               sym5
     2148               v-sum-end-qnty @ tt-line.end-qnty
     2149               sym6
     2150           with frame frm1.
     2151           down stream Out-Stream with frame frm1.
     2152           put stream Out-Stream unformatted fill("-", 150) format "x(150)" skip.
     2153           run mdtcxl-write-cell-data(
     2154               "obj_num_3":U,
     2155               subst("Произвели снятие остатков одноразовой посуды в кафе на АЗК № &1  &2", string(obj-list.obj-code), string(today, "99/99/9999"))
     2156           ).
     2157           put stream Out-Stream unformatted
     2158           skip(2)
     2159           "Комиссия в составе: " space(20) "Администратор т/з" space(20) fill("_", 30) skip
     2160           space(40) "Старший оператор" space(21) fill("_", 30) skip
     2161           space(40) "Оператор-продавец" space(20) fill("_", 30) skip(2)
     2162           subst("Произвели снятие остатков одноразовой посуды в кафе на АЗК № &1    &2", obj-list.obj-code, string(today, "99/99/9999")) skip(2)
     2163           "Подпись членов комиссии:" space(16) "Администратор т/з" space(20) fill("_", 30) skip
     2164           space(40) "Старший оператор" space(21) fill("_", 30) skip
     2165           space(40) "Оператор-продавец" space(20) fill("_", 30) skip(2)
     2166           .
     2167           page stream Out-Stream.
     2168           run mdtcxl-close.
     2169       end.
     2170   end.
