        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: 0ce804be5b42, 140, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: EShklyar $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Feb 16 20:48:28 2015 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: r-mdtc.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: rep/r-mdtc.p $":U .
        7   define variable vss-description as character no-undo init "Движение одноразовой посуды по кафе (Роснефть)".
        8   define variable g#gds-engl       as logical    no-undo .
