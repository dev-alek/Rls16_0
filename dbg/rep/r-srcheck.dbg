     1984       do:
     1985           output stream OutStr-html to value(p-file-name-rep-htm) append convert target 'UTF-8'.
     1986           find first buf-html-temp-chk no-lock no-error.
     1987           if not error-status:error and available buf-html-temp-chk then
     1988           do:
     1989               for each buf-html-temp-chk where
     1990                   buf-html-temp-chk.grp-code = 0 and buf-html-temp-chk.upper-code = -1 and buf-html-temp-chk.gds-code = 0 no-lock
     1991                   by buf-html-temp-chk.obj-type by buf-html-temp-chk.obj-code
     1992                   :
     1993                   put stream OutStr-html unformatted
     1994                       '       <tr level="1">' skip
     1995                       '         <td colspan="3" style="display: yes; text-align: left; font-weight: bold">' +  buf-html-temp-chk.gds-name + '</td>' skip
     1996                       '         <td style="display: yes; text-align:  right; font-weight: bold">'  + if buf-html-temp-chk.qnty <> ?  then fnc-convert-dot-to-colon( buf-html-temp-chk.qnty, "->>>>>>>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     1997                       '         <td style="display: yes; text-align:  right; font-weight: bold">'   + if buf-html-temp-chk.sum-unbase <> ? then fnc-convert-dot-to-colon( buf-html-temp-chk.sum-unbase, "->>>>>>>>>>>>9.99")   + '</td>' else "?" + '</td>' skip
     1998                       '         <td style="display: yes; text-align:  right; font-weight: bold">'   + if buf-html-temp-chk.sum-base <> ? then fnc-convert-dot-to-colon( buf-html-temp-chk.sum-base, "->>>>>>>>>>>>>9.99")  + '</td>' else "?" + '</td>' skip
     1999                       '         <td style="display: yes; text-align:  right; font-weight: bold">'   + if buf-html-temp-chk.doc-qnty <> ? then fnc-convert-dot-to-colon( buf-html-temp-chk.doc-qnty, "->>>>>>>>>>>>>>9") + '</td>' else "?" + '</td>' skip
     2000                       '         <td style="display: yes; text-align:  right; font-weight: bold">'   + if buf-html-temp-chk.pok-qnty <> ? then fnc-convert-dot-to-colon( buf-html-temp-chk.pok-qnty, "->>>>>>>>>>>>>9") + '</td>' else "?" + '</td>' skip
     2001                       '         <td style="display: yes; text-align:  right; font-weight: bold">'   + if buf-html-temp-chk.srchk-kol-tov <> ?  then fnc-convert-dot-to-colon( buf-html-temp-chk.srchk-kol-tov, "->>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     2002                       '         <td style="display: yes; text-align:  right; font-weight: bold">'   + if buf-html-temp-chk.srchk-sum <> ?  then fnc-convert-dot-to-colon( buf-html-temp-chk.srchk-sum, "->>>>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     2003                       '         <td style="display: yes; text-align:  right; font-weight: bold">'   + if buf-html-temp-chk.srchk-uch <> ? then  fnc-convert-dot-to-colon( buf-html-temp-chk.srchk-uch , "->>>>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     2004                       '         <td style="display: yes; text-align:  right; font-weight: bold">'   + if buf-html-temp-chk.srchk-base-sum <> ?  then fnc-convert-dot-to-colon( buf-html-temp-chk.srchk-base-sum, "->>>>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     2005                       '         <td style="display: yes; text-align:  right; font-weight: bold">'   + if  buf-html-temp-chk.srchk-base-uch <> ?  then fnc-convert-dot-to-colon(  buf-html-temp-chk.srchk-base-uch, "->>>>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     2006                       '         <td style="display: yes; text-align:  right; font-weight: bold">'   + if  buf-html-temp-chk.srchk-kol-tov-pokup <> ?  then fnc-convert-dot-to-colon(  buf-html-temp-chk.srchk-kol-tov-pokup, "->>>>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     2007                       '         <td style="display: yes; text-align:  right; font-weight: bold">'   + if  buf-html-temp-chk.srchk-kol-tov-uch   <> ?  then fnc-convert-dot-to-colon( buf-html-temp-chk.srchk-kol-tov-uch, "->>>>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     2008                       '       </tr>' skip
     2009                       .
     2010                   if p-tog-prod = yes then run tt-print-line (input buf-html-temp-chk.obj-type, input buf-html-temp-chk.obj-code, input -2 , input 2).
     2011                   if p-tog-prod = no then run tt-print-line (input buf-html-temp-chk.obj-type, input buf-html-temp-chk.obj-code, input 1 , input 2).
     2012               end.
     2013           end.
     2014           else
     2015           do:
     2016               put stream OutStr-html unformatted
     2017                   '       <tr>' skip
     2018                   '         <td style="display: yes; text-align: center; font-weight: bold">'    '</td>' skip
     2019                   '         <td style="display: yes; text-align: center; font-weight: bold">'    '</td>' skip
     2020                   '         <td style="display: yes; text-align:  right; font-weight: bold">'    '</td>' skip
     2021                   '         <td style="display: yes; text-align:  right; font-weight: bold">'    '</td>' skip
     2022                   '         <td style="display: yes; text-align:  right; font-weight: bold">'    '</td>' skip
     2023                   '         <td style="display: yes; text-align:  right; font-weight: bold">'    '</td>' skip
     2024                   '         <td style="display: yes; text-align:  right; font-weight: bold">'    '</td>' skip
     2025                   '         <td style="display: yes; text-align:  right; font-weight: bold">'    '</td>' skip
     2026                   '         <td style="display: yes; text-align:  right; font-weight: bold">'    '</td>' skip
     2027                   '         <td style="display: yes; text-align:  right; font-weight: bold">'    '</td>' skip
     2028                   '         <td style="display: yes; text-align:  right; font-weight: bold">'    '</td>' skip
     2029                   '         <td style="display: yes; text-align:  right; font-weight: bold">'    '</td>' skip
     2030                   '         <td style="display: yes; text-align:  right; font-weight: bold">'    '</td>' skip
     2031                   '         <td style="display: yes; text-align:  right; font-weight: bold">'    '</td>' skip
     2032                   '         <td style="display: yes; text-align:  right; font-weight: bold">'    '</td>' skip
     2033                   '       </tr>' skip
     2034                   .
     2035           end.
     2036       end.
     2037           do:
     2038                   put stream OutStr-html unformatted
     2039                   '     </tbody>' skip
     2040                   '   </table>' skip
     2041                   '  </body>' skip
     2042                   ' </html>' skip
     2043                   .
     2044           output stream OutStr-html close.
     2045       end.
     2046   end procedure.
     2047   procedure transform-tt-level  :
     2048   define input parameter v-obj-code as integer no-undo.
     2049   define input parameter v-obj-type as character no-undo.
     2050   define variable v-eff-doc-qnty as decimal   no-undo.
     2051   define variable v-object-sum   as decimal   no-undo.
     2052   define variable v-tot-r-b      as decimal   no-undo.
     2053   define variable v-pok-qnty     as integer   no-undo.
     2054   define variable v-gds-name     as character no-undo.
     2055   define variable v-cur-lvl      as integer   no-undo.
     2056   define variable v-upper-code   as integer   initial ? no-undo.
     2057   define variable v-find-grp-lvl  as integer no-undo.
     2058   define buffer buf_gds-grp     for ub.gds-grp .
     2059   define buffer buftt_temp-chk  for temp-chk .
     2060   define buffer buf2_help-chk   for help-chk .
     2061   define buffer buftt2_temp-chk for temp-chk .
     2062     do while v-upper-code <> 0:
     2063       v-upper-code = 0.
     2064       for each temp-chk
     2065          where temp-chk.grp-lvl  = v-cur-lvl
     2066            and temp-chk.obj-type = v-obj-type
     2067            and temp-chk.obj-code = v-obj-code
     2068            and temp-chk.upper-code <> -1
     2069       use-index tt-grp
     2070       break by temp-chk.grp-code :
     2071         if first-of (temp-chk.grp-code) then do:
     2072           assign
     2073             v-eff-doc-qnty = 0
     2074             v-object-sum   = 0
     2075             v-tot-r-b      = 0
     2076             v-pok-qnty     = 0
     2077           .
     2078           find first buf_gds-grp no-lock where buf_gds-grp.node-code = temp-chk.grp-code no-error.
     2079           if available buf_gds-grp then assign
     2080             v-upper-code = buf_gds-grp.upper-code
     2081             v-gds-name   = buf_gds-grp.node-name
     2082           .
     2083           else v-gds-name = ''.
     2084         end.
     2085         assign
     2086           v-eff-doc-qnty = v-eff-doc-qnty + temp-chk.qnty
     2087           v-object-sum   = v-object-sum   + temp-chk.sum-unbase
     2088           v-tot-r-b      = v-tot-r-b      + temp-chk.sum-base
     2089           v-pok-qnty     = v-pok-qnty     + temp-chk.pok-qnty
     2090         .
     2091         assign
     2092           temp-chk.srchk-kol-tov-uch = temp-chk.pok-qnty   * 100 / obj-temp-chk.pok-qnty
     2093           temp-chk.srchk-base-uch    = temp-chk.sum-base   * 100 / obj-temp-chk.sum-base
     2094           temp-chk.srchk-uch         = temp-chk.sum-unbase * 100 / obj-temp-chk.sum-unbase
     2095         .
     2096         if temp-chk.grp-lvl = 0 then assign
     2097           temp-chk.upper-code = temp-chk.grp-code
     2098         .
     2099         else assign
     2100           temp-chk.upper-code = v-upper-code
     2101           temp-chk.gds-name   = v-gds-name
     2102         .
     2103         if last-of (temp-chk.grp-code) and v-upper-code <> 0 then do :
     2104           v-find-grp-lvl = temp-chk.grp-lvl + 1 .
     2105           find first buftt_temp-chk
     2106                where buftt_temp-chk.grp-lvl  = v-find-grp-lvl
     2107                  and buftt_temp-chk.obj-type = v-obj-type
     2108                  and buftt_temp-chk.obj-code = v-obj-code
     2109                  and buftt_temp-chk.grp-code = temp-chk.upper-code no-error.
     2110           if not available buftt_temp-chk then do:
     2111             create buftt_temp-chk .
     2112             assign
     2113               buftt_temp-chk.grp-lvl  = v-find-grp-lvl
     2114               buftt_temp-chk.obj-type = v-obj-type
     2115               buftt_temp-chk.obj-code = v-obj-code
     2116               buftt_temp-chk.grp-code = temp-chk.upper-code
     2117               buftt_temp-chk.gds-name = v-gds-name
     2118             .
     2119           end.
     2120           assign
     2121             buftt_temp-chk.qnty       = buftt_temp-chk.qnty       + v-eff-doc-qnty
     2122             buftt_temp-chk.sum-unbase = buftt_temp-chk.sum-unbase + v-object-sum
     2123             buftt_temp-chk.sum-base   = buftt_temp-chk.sum-base   + v-tot-r-b
     2124             buftt_temp-chk.pok-qnty   = buftt_temp-chk.pok-qnty   + v-pok-qnty
     2125           .
     2126           for each help-chk where help-chk.group-chk = temp-chk.grp-code
     2127                               and help-chk.obj-code  = v-obj-code
     2128                               and help-chk.obj-type  = v-obj-type:
     2129             if not can-find (first buf2_help-chk where buf2_help-chk.doc-code  = help-chk.doc-code
     2130                                                    and buf2_help-chk.group-chk = temp-chk.upper-code
     2131                                                    and buf2_help-chk.obj-code  = v-obj-code
     2132                                                    and buf2_help-chk.obj-type  = v-obj-type) then do:
     2133               create buf2_help-chk.
     2134               assign
     2135                 buf2_help-chk.doc-code  = help-chk.doc-code
     2136                 buf2_help-chk.group-chk = temp-chk.upper-code
     2137                 buf2_help-chk.obj-code  = v-obj-code
     2138                 buf2_help-chk.obj-type  = v-obj-type
     2139               .
     2140             end.
     2141           end.
     2142           buftt_temp-chk.doc-qnty = 0 .
     2143           for each buf2_help-chk where buf2_help-chk.group-chk = temp-chk.upper-code
     2144                                    and buf2_help-chk.obj-code  = v-obj-code
     2145                                    and buf2_help-chk.obj-type  = v-obj-type :
     2146             buftt_temp-chk.doc-qnty = buftt_temp-chk.doc-qnty + 1 .
     2147           end .
     2148           assign
     2149             buftt_temp-chk.srchk-kol-tov       = buftt_temp-chk.qnty       / buftt_temp-chk.doc-qnty
     2150             buftt_temp-chk.srchk-sum           = buftt_temp-chk.sum-unbase / buftt_temp-chk.doc-qnty
     2151             buftt_temp-chk.srchk-base-sum      = buftt_temp-chk.sum-base   / buftt_temp-chk.doc-qnty
     2152             buftt_temp-chk.srchk-kol-tov-pokup = buftt_temp-chk.pok-qnty   / buftt_temp-chk.doc-qnty
     2153           .
     2154         end.
     2155       end.
     2156       v-cur-lvl = v-cur-lvl + 1.
     2157     end.
     2158     for each buftt2_temp-chk
     2159        where buftt2_temp-chk.gds-code = 0
     2160          and buftt2_temp-chk.obj-code = v-obj-code
     2161          and buftt2_temp-chk.obj-type = v-obj-type
     2162          and buftt2_temp-chk.grp-code <> 0
     2163          and buftt2_temp-chk.grp-lvl  > 1 :
     2164       if can-find (first buftt_temp-chk
     2165                    where buftt_temp-chk.gds-code = 0
     2166                      and buftt_temp-chk.obj-code = buftt2_temp-chk.obj-code
     2167                      and buftt_temp-chk.obj-type = buftt2_temp-chk.obj-type
     2168                      and buftt_temp-chk.grp-code = buftt2_temp-chk.grp-code
     2169                      and buftt_temp-chk.grp-lvl  > 0
     2170                      and buftt_temp-chk.grp-lvl <> buftt2_temp-chk.grp-lvl) then do :
     2171         for each buftt_temp-chk
     2172            where buftt_temp-chk.gds-code = 0
     2173              and buftt_temp-chk.obj-code = buftt2_temp-chk.obj-code
     2174              and buftt_temp-chk.obj-type = buftt2_temp-chk.obj-type
     2175              and buftt_temp-chk.grp-code = buftt2_temp-chk.grp-code
     2176              and buftt_temp-chk.grp-lvl  > 0
     2177              and buftt_temp-chk.grp-lvl <> buftt2_temp-chk.grp-lvl :
     2178           assign
     2179             buftt2_temp-chk.qnty       = buftt_temp-chk.qnty       + buftt2_temp-chk.qnty
     2180             buftt2_temp-chk.sum-unbase = buftt_temp-chk.sum-unbase + buftt2_temp-chk.sum-unbase
     2181             buftt2_temp-chk.sum-base   = buftt_temp-chk.sum-base   + buftt2_temp-chk.sum-base
     2182             buftt2_temp-chk.pok-qnty   = buftt_temp-chk.pok-qnty   + buftt2_temp-chk.pok-qnty
     2183           .
     2184           delete buftt_temp-chk.
     2185         end .
     2186         buftt2_temp-chk.doc-qnty = 0 .
     2187         for each help-chk where help-chk.group-chk = buftt2_temp-chk.grp-code
     2188                             and help-chk.obj-code  = buftt2_temp-chk.obj-code
     2189                             and help-chk.obj-type  = buftt2_temp-chk.obj-type:
     2190           buftt2_temp-chk.doc-qnty = buftt2_temp-chk.doc-qnty + 1.
     2191         end.
     2192       end .
     2193     end.
     2194   end procedure.
     2195   procedure tt-print-line:
     2196       define input parameter v-obj-type as character no-undo.
     2197       define input parameter v-obj-code as integer no-undo.
     2198       define input parameter v-upper-code like ub.gds-grp.upper-code no-undo.
     2199       define input parameter v-print-lvl as integer no-undo.
     2200   define variable v-display as character no-undo.
     2201       define buffer buf-grp_temp-chk for temp-chk.
     2202       for each buf-grp_temp-chk where
     2203           buf-grp_temp-chk.upper-code = v-upper-code and
     2204           buf-grp_temp-chk.obj-type = v-obj-type and
     2205           buf-grp_temp-chk.obj-code = v-obj-code
     2206           no-lock:
     2207             if v-print-lvl < 3 then
     2208           do:
     2209               v-display = "yes".
     2210           end.
     2211           else
     2212           do:
     2213               v-display = "none".
     2214           end.
     2215           do:
     2216               if buf-grp_temp-chk.grp-lvl <> 0 then
     2217               do:
     2218                   put stream OutStr-html unformatted
     2219                       '       <tr level="' + string(v-print-lvl) + '">' skip
     2220                       '         <td colspan = "3" style="display: yes; text-align: left; font-weight: bold ; padding-left:  '
     2221                       + string((v-print-lvl - 1) * 10) + 'px">'
     2222                       + string(fill(" ", ((v-print-lvl - 2) * 4)))
     2223                       + buf-grp_temp-chk.gds-name       + '</td>' skip
     2224                       '         <td style="display: yes; text-align: right; font-weight: bold">'  + if buf-grp_temp-chk.qnty <> ?  then fnc-convert-dot-to-colon(buf-grp_temp-chk.qnty, "->>>>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     2225                       '         <td style="display: yes; text-align: right; font-weight: bold" >'  + if buf-grp_temp-chk.sum-unbase <> ? then fnc-convert-dot-to-colon(buf-grp_temp-chk.sum-unbase, "->>>>>>>>>>>9.99")   + '</td>' else "?" + '</td>' skip
     2226                       '         <td style="display: yes; text-align: right; font-weight: bold" >'   + if buf-grp_temp-chk.sum-base <> ? then fnc-convert-dot-to-colon(buf-grp_temp-chk.sum-base, "->>>>>>>>>>>9.99")  + '</td>' else "?" + '</td>' skip
     2227                       '         <td style="display: yes; text-align: right; font-weight: bold" >'    + if buf-grp_temp-chk.doc-qnty <> ? then fnc-convert-dot-to-colon( buf-grp_temp-chk.doc-qnty, "->>>>>>>>>>>9") + '</td>' else "?" + '</td>' skip
     2228                       '         <td style="display: yes; text-align: right; font-weight: bold" >' + if buf-grp_temp-chk.pok-qnty <> ? then fnc-convert-dot-to-colon( buf-grp_temp-chk.pok-qnty, "->>>>>>>>>>>9") + '</td>' else "?" + '</td>' skip
     2229                       '         <td style="display: yes; text-align: right; font-weight: bold" >' + if buf-grp_temp-chk.srchk-kol-tov <> ?  then fnc-convert-dot-to-colon( buf-grp_temp-chk.srchk-kol-tov, "->>>>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     2230                       '         <td style="display: yes; text-align: right; font-weight: bold" >' + if buf-grp_temp-chk.srchk-sum <> ?  then fnc-convert-dot-to-colon( buf-grp_temp-chk.srchk-sum, "->>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     2231                       '         <td style="display: yes; text-align: right; font-weight: bold" >'    +  if buf-grp_temp-chk.srchk-uch  <> ?  then fnc-convert-dot-to-colon(buf-grp_temp-chk.srchk-uch, "->>>>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     2232                       '         <td style="display: yes; text-align: right; font-weight: bold" >'     + if buf-grp_temp-chk.srchk-base-sum <> ?  then fnc-convert-dot-to-colon( buf-grp_temp-chk.srchk-base-sum, "->>>>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     2233                       '         <td style="display: yes; text-align: right; font-weight: bold" >'        + if  buf-grp_temp-chk.srchk-base-uch <>?   then fnc-convert-dot-to-colon( buf-grp_temp-chk.srchk-base-uch , "->>>>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     2234                       '         <td style="display: yes; text-align: right; font-weight: bold" >'    + if  buf-grp_temp-chk.srchk-kol-tov-pokup <> ?  then fnc-convert-dot-to-colon(  buf-grp_temp-chk.srchk-kol-tov-pokup, "->>>>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     2235                       '          <td style="display: yes; text-align:  right; font-weight: bold"  >'     +  if   buf-grp_temp-chk.srchk-kol-tov-uch   <> ?  then fnc-convert-dot-to-colon(buf-grp_temp-chk.srchk-kol-tov-uch, "->>>>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     2236                       '       </tr>' skip
     2237                       .
     2238               end.
     2239               else
     2240               do:
     2241                   put stream OutStr-html unformatted
     2242                       '       <tr level="' + string(v-print-lvl) + '">' skip
     2243                       '         <td style="display: yes ;text-align: right">' +  fnc-convert-dot-to-colon(buf-grp_temp-chk.gds-code, "->>>>>>>>>999999") + '</td>' skip
     2244                       '         <td num="0.00" style="display: yes;text-align: left;   padding-left: ' + string((v-print-lvl - 1) * 10) + 'px">'
     2245                       + string(fill(" ", ((v-print-lvl - 2) * 4))) + buf-grp_temp-chk.gds-name
     2246                       + '</td>' skip
     2247                       '         <td  num="0.00" style="display: yes ;text-align: right">'  + buf-grp_temp-chk.unit +      '</td>'  skip
     2248                       '         <td num="0.00" style="display: yes ;text-align: right" >' + if buf-grp_temp-chk.qnty <> ?  then fnc-convert-dot-to-colon( buf-grp_temp-chk.qnty, "->>>>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     2249                       '         <td num="0.00" style="display: yes ;text-align: right">'  + if buf-grp_temp-chk.sum-unbase <> ? then fnc-convert-dot-to-colon( buf-grp_temp-chk.sum-unbase, "->>>>>>>>>9.99")   + '</td>' else "?" + '</td>' skip
     2250                       '         <td num="0.00" style="display: yes ;text-align: right">'   + if buf-grp_temp-chk.sum-base <> ? then fnc-convert-dot-to-colon( buf-grp_temp-chk.sum-base, "->>>>>>>>>9.99")  + '</td>' else "?" + '</td>' skip
     2251                       '         <td  style="display: yes ;text-align: right" >'    + if buf-grp_temp-chk.doc-qnty <> ? then fnc-convert-dot-to-colon( buf-grp_temp-chk.doc-qnty, "->>>>>>>>>9") + '</td>' else "?" + '</td>' skip
     2252                       '         <td  style="display: yes ;text-align: right" >' + if buf-grp_temp-chk.pok-qnty <> ? then fnc-convert-dot-to-colon( buf-grp_temp-chk.pok-qnty, "->>>>>>>>>9") + '</td>' else "?" + '</td>' skip
     2253                       '         <td num="0.00" style="display: yes ;text-align: right" >' + if buf-grp_temp-chk.srchk-kol-tov <> ?  then fnc-convert-dot-to-colon( buf-grp_temp-chk.srchk-kol-tov, "->>>>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     2254                       '         <td num="0.00" style="display: yes ;text-align: right" >' + if buf-grp_temp-chk.srchk-sum <> ?  then fnc-convert-dot-to-colon( buf-grp_temp-chk.srchk-sum, "->>>>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     2255                       '         <td num="0.00" style="display: yes ;text-align: right" >'  +  if buf-grp_temp-chk.srchk-uch  <> ?     then fnc-convert-dot-to-colon( buf-grp_temp-chk.srchk-uch,  "->>>>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     2256                       '         <td num="0.00" style="display: yes ;text-align: right">'     + if buf-grp_temp-chk.srchk-base-sum <> ?  then fnc-convert-dot-to-colon(buf-grp_temp-chk.srchk-base-sum, "->>>>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     2257                       '         <td num="0.00" style="display: yes ;text-align: right" >'      +  if buf-grp_temp-chk.srchk-base-uch  <> ?  then fnc-convert-dot-to-colon( buf-grp_temp-chk.srchk-base-uch, "->>>>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     2258                       '         <td num="0.00" style="display: yes ;text-align: right" >'     + if  buf-grp_temp-chk.srchk-kol-tov-pokup <> ?  then fnc-convert-dot-to-colon(buf-grp_temp-chk.srchk-kol-tov-pokup, "->>>>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     2259                       '         <td num="0.00" style="display: yes ;text-align: right" >'  +  if buf-grp_temp-chk.srchk-kol-tov-uch  <> ?  then fnc-convert-dot-to-colon(buf-grp_temp-chk.srchk-kol-tov-uch, "->>>>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     2260                       '       </tr>' skip
     2261                       .
     2262               end.
     2263           end.
     2264           if buf-grp_temp-chk.grp-lvl <> 0 then run tt-print-line (input v-obj-type, input v-obj-code, input buf-grp_temp-chk.grp-code, input v-print-lvl + 1 ).
     2265       end.
     2266   end procedure.
     2267   procedure prod-level:
     2268   define input parameter v-obj-code as integer no-undo.
     2269   define input parameter v-obj-type as character no-undo.
     2270       define variable v-eff-doc-qnty as decimal   no-undo.
     2271       define variable v-object-sum   as decimal   no-undo.
     2272       define variable v-tot-r-b      as decimal   no-undo.
     2273       define variable v-pok-qnty     as integer   no-undo.
     2274     for each temp-chk
     2275        where temp-chk.obj-type = v-obj-type
     2276          and temp-chk.obj-code = v-obj-code
     2277          and temp-chk.gds-code > 0
     2278     break by temp-chk.grp-code :
     2279       if first-of (temp-chk.grp-code) then do:
     2280         assign
     2281           v-eff-doc-qnty = 0
     2282           v-object-sum   = 0
     2283           v-tot-r-b      = 0
     2284           v-pok-qnty     = 0
     2285         .
     2286       end.
     2287       assign
     2288         v-eff-doc-qnty = v-eff-doc-qnty + temp-chk.qnty
     2289         v-object-sum   = v-object-sum   + temp-chk.sum-unbase
     2290         v-tot-r-b      = v-tot-r-b      + temp-chk.sum-base
     2291         v-pok-qnty     = v-pok-qnty     + temp-chk.pok-qnty
     2292       .
     2293       assign
     2294         temp-chk.srchk-kol-tov-uch = temp-chk.pok-qnty   * 100 / obj-temp-chk.pok-qnty
     2295         temp-chk.srchk-base-uch    = temp-chk.sum-base   * 100 / obj-temp-chk.sum-base
     2296         temp-chk.srchk-uch         = temp-chk.sum-unbase * 100 / obj-temp-chk.sum-unbase
     2297         temp-chk.upper-code        = temp-chk.grp-code
     2298       .
     2299       if last-of (temp-chk.grp-code) then do:
     2300         find first prod-temp-chk
     2301              where prod-temp-chk.gds-code = 0
     2302                and prod-temp-chk.obj-code = temp-chk.obj-code
     2303                and prod-temp-chk.obj-type = temp-chk.obj-type
     2304                and prod-temp-chk.grp-code = temp-chk.grp-code
     2305                and prod-temp-chk.grp-lvl  = 1
     2306         use-index tt no-error .
     2307         if available prod-temp-chk then do:
     2308           assign
     2309             prod-temp-chk.qnty       = v-eff-doc-qnty
     2310             prod-temp-chk.sum-unbase = v-object-sum
     2311             prod-temp-chk.sum-base   = v-tot-r-b
     2312             prod-temp-chk.pok-qnty   = v-pok-qnty
     2313           .
     2314           assign
     2315             prod-temp-chk.srchk-kol-tov       = prod-temp-chk.qnty       / prod-temp-chk.doc-qnty
     2316             prod-temp-chk.srchk-sum           = prod-temp-chk.sum-unbase / prod-temp-chk.doc-qnty
     2317             prod-temp-chk.srchk-base-sum      = prod-temp-chk.sum-base   / prod-temp-chk.doc-qnty
     2318             prod-temp-chk.srchk-kol-tov-pokup = prod-temp-chk.pok-qnty   / prod-temp-chk.doc-qnty
     2319           .
     2320           assign
     2321             prod-temp-chk.srchk-base-uch    = prod-temp-chk.sum-base   * 100 / obj-temp-chk.sum-base
     2322             prod-temp-chk.srchk-kol-tov-uch = prod-temp-chk.pok-qnty   * 100 / obj-temp-chk.pok-qnty
     2323             prod-temp-chk.srchk-uch         = prod-temp-chk.sum-unbase * 100 / obj-temp-chk.sum-unbase
     2324           .
     2325           obj-temp-chk.doc-qnty = obj-temp-chk.doc-qnty + prod-temp-chk.doc-qnty.
     2326         end.
     2327       end.
     2328     end.
     2329   end procedure.
     2330   function fnc-DD-MM-YYYY returns character
     2331   (input p-dat-date as date):
     2332       define variable result as character no-undo.
     2333       define variable p-str-date as character no-undo.
     2334       p-str-date = replace(string(p-dat-date,'99.99.9999'), "/", ".").
     2335           return p-str-date.
     2336   end function.
     2337   function fnc-convert-dot-to-colon returns character
     2338   (input p-data as decimal, input p-accur as character):
     2339       define variable result as character no-undo.
     2340       define variable v-str-result as character no-undo.
     2341       p-data = round(p-data, 2).
     2342       v-str-result = trim(replace(string(p-data, p-accur), ".", ",")).
     2343       return v-str-result.
     2344   end function.
