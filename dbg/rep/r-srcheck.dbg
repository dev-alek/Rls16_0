      817   function fnc-DD-MM-YYYY returns character
      818   (input p-dat-date as date) forward.
      819   function fnc-convert-dot-to-colon returns character
      820   (input p-data as decimal, input p-accur as character) forward.
      821   function ChkGdsPromo returns logical
      822       (input iDocCode as character)
      823       :
      824       define buffer buf_chk-gds for ub.chk-gds.
      825       define buffer buf_chk-gds-attr for ub.chk-gds-attr.
      826       define variable vPromo as logical no-undo.
      827       vPromo = no.
      828       cspr:
      829       for each buf_chk-gds no-lock where
      830                    buf_chk-gds.doc-code = iDocCode,
      831              first buf_chk-gds-attr no-lock where
      832                    buf_chk-gds-attr.doc-code = buf_chk-gds.doc-code
      833                and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
      834                and buf_chk-gds-attr.attr-code = "CSPromo"
      835                and buf_chk-gds-attr.attr-value <> "0":
      836          vPromo = yes.
      837          leave cspr.
      838       end.
      839       return vPromo.
      840   end.
      841   function ChkPromoLine returns logical
      842       (input iDocCode as character,
      843       input iLineNum as integer)
      844       :
      845       define buffer buf_chk-gds for ub.chk-gds.
      846       define buffer buf_chk-gds-attr for ub.chk-gds-attr.
      847       define variable vPromo as logical no-undo.
      848       vPromo = no.
      849       find first buf_chk-gds-attr no-lock where
      850                    buf_chk-gds-attr.doc-code = iDocCode
      851                and buf_chk-gds-attr.line-num  = iLineNum
      852                and buf_chk-gds-attr.attr-code = "CSPromo"
      853                and buf_chk-gds-attr.attr-value <> "0"
      854       no-error.
      855       if avail buf_chk-gds-attr then vPromo = yes.
      856       return vPromo.
      857   end.
      858   function ChkPromoSum returns decimal
      859       (input iDocCode as character,
      860        input iLineNum as integer)
      861       :
      862      define buffer buf_chk-gds-attr for ub.chk-gds-attr.
      863      define variable vSumPromo as decimal no-undo.
      864      find first buf_chk-gds-attr no-lock where
      865                 buf_chk-gds-attr.doc-code = iDocCode
      866             and buf_chk-gds-attr.line-num  = iLineNum
      867             and buf_chk-gds-attr.attr-code = "CSPromoSum"
      868         no-error.
      869      if avail buf_chk-gds-attr then
      870         vSumPromo = DEC(buf_chk-gds-attr.attr-value) no-error.
      871      return vSumPromo.
      872   end function.
      873   function ChkPromoPrice returns logical
      874       (input iDocCode as character,
      875        input iLineNum as integer)
      876       :
      877      define buffer buf_chk-gds-attr for ub.chk-gds-attr.
      878      define variable v-is-promo as logical no-undo.
      879      v-is-promo = no.
      880      find first buf_chk-gds-attr no-lock where
      881                 buf_chk-gds-attr.doc-code = iDocCode
      882             and buf_chk-gds-attr.line-num  = iLineNum
      883             and buf_chk-gds-attr.attr-code = "CSPromo"
      884         no-error.
      885      if avail buf_chk-gds-attr
      886        and can-do("2,4,5,7", buf_chk-gds-attr.attr-value)
      887      then v-is-promo = yes.
      888      return v-is-promo.
      889   end function.
      890   function ChkDopLitr returns logical
      891       (input iDocCode as character,
      892        input iLineNum as integer)
      893       :
      894      define buffer buf_chk-gds-attr for ub.chk-gds-attr.
      895      define variable v-is-promo as logical no-undo.
      896      v-is-promo = no.
      897      find first buf_chk-gds-attr no-lock where
      898                 buf_chk-gds-attr.doc-code = iDocCode
      899             and buf_chk-gds-attr.line-num  = iLineNum
      900             and buf_chk-gds-attr.attr-code = "CSPromo"
      901         no-error.
      902      if avail buf_chk-gds-attr and
      903        buf_chk-gds-attr.attr-value = "3"
      904      then v-is-promo = yes.
      905      return v-is-promo.
      906   end function.
      907   function RoundUp return decimal
      908       (input iQnty as decimal,
      909        input iPrice as decimal):
      910       def var vSum  as decimal no-undo.
      911       def var vSumR as decimal no-undo.
      912       vSum = ABSOLUTE(iQnty) * iPrice.
      913       vSumR = Round(vSum,2).
      914       if vSumR < vSum then vSumR = vSumR + 0.01.
      915       if iQnty < 0 then vSumR = - vSumR.
      916       return vSumR.
      917   end function.
      918   function GetPromoSum returns decimal
      919       (input iDocCode as character)
      920       :
      921       define buffer buf_chk-doc for ub.chk-doc.
      922       define buffer buf2_chk-doc for ub.chk-doc.
      923       define buffer buf_chk-gds for ub.chk-gds.
      924       define buffer buf_chk-gds-attr for ub.chk-gds-attr.
      925       define buffer buf2_chk-gds for ub.chk-gds.
      926       define buffer buf2_chk-gds-attr for ub.chk-gds-attr.
      927       define variable v-price-base as decimal no-undo.
      928       define variable v-doc-qnty as decimal no-undo.
      929       define variable v-sum-base as decimal no-undo.
      930       define variable v-sum-all as decimal no-undo.
      931       define variable v-sum-promo as decimal no-undo.
      932       define variable v-sum-chk as decimal no-undo.
      933       assign
      934          v-price-base = 0
      935          v-doc-qnty = 0
      936          v-sum-all = 0
      937          v-sum-chk = 0
      938          v-sum-promo = 0
      939          .
      940       for each buf_chk-gds no-lock where
      941                buf_chk-gds.doc-code = iDocCode,
      942          first buf_chk-gds-attr no-lock where
      943                buf_chk-gds-attr.doc-code = buf_chk-gds.doc-code
      944            and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
      945            and buf_chk-gds-attr.attr-code = "CSPromoSum"
      946          :
      947          v-sum-promo = Dec(buf_chk-gds-attr.attr-value).
      948       end.
      949       if v-sum-promo = 0 then do:
      950           for each buf_chk-gds no-lock where
      951                    buf_chk-gds.doc-code = iDocCode,
      952              first buf_chk-gds-attr no-lock where
      953                    buf_chk-gds-attr.doc-code = buf_chk-gds.doc-code
      954                and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
      955                and buf_chk-gds-attr.attr-code = "CSPromo"
      956                and can-do("1,6", buf_chk-gds-attr.attr-value)
      957              :
      958              assign
      959                v-price-base = buf_chk-gds.price-base
      960                v-doc-qnty   = if buf_chk-gds.doc-qnty = ? then buf_chk-gds.src-qnty else buf_chk-gds.doc-qnty
      961                v-sum-base = if buf_chk-gds.sum-base = ? then round(v-doc-qnty * v-price-base, 2) else buf_chk-gds.sum-base
      962                .
      963           end.
      964           for each buf_chk-gds no-lock where
      965                    buf_chk-gds.doc-code = iDocCode,
      966              first buf_chk-gds-attr no-lock where
      967                    buf_chk-gds-attr.doc-code = buf_chk-gds.doc-code
      968                and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
      969                and buf_chk-gds-attr.attr-code = "CSPromo"
      970                and can-do("2,4,5,7", buf_chk-gds-attr.attr-value)
      971              :
      972              if v-price-base = 0 then do:
      973                 find first buf_chk-doc no-lock where
      974                            buf_chk-doc.doc-code = iDocCode
      975                     no-error.
      976                 if avail buf_chk-doc and
      977                    buf_chk-doc.chk-type = int('6':U) and
      978                    buf_chk-doc.doc-num2 > ""  and
      979                    num-entries(buf_chk-doc.doc-num2,":") = 2
      980                 then
      981                 for first buf2_chk-doc no-lock where
      982                           buf2_chk-doc.obj-code = buf_chk-doc.obj-code
      983                       and buf2_chk-doc.obj-type = buf_chk-doc.obj-type
      984                       and buf2_chk-doc.chk-type = int('1':U)
      985                       and buf2_chk-doc.chk-num = int(entry(1,buf_chk-doc.doc-num2,":"))
      986                       and buf2_chk-doc.z-number = int(entry(2, buf_chk-doc.doc-num2,":"))
      987                       :
      988                   for each buf2_chk-gds no-lock where
      989                            buf2_chk-gds.doc-code = buf2_chk-doc.doc-code,
      990                      first buf2_chk-gds-attr no-lock where
      991                            buf2_chk-gds-attr.doc-code = buf2_chk-gds.doc-code
      992                        and buf2_chk-gds-attr.line-num  = buf2_chk-gds.line-num
      993                        and buf2_chk-gds-attr.attr-code = "CSPromo"
      994                        and can-do("1,6", buf2_chk-gds-attr.attr-value)
      995                      :
      996                       v-price-base = buf2_chk-gds.price-base.
      997                   end.
      998                 end.
      999              end.
     1000              if buf_chk-gds.sum-base = ? or buf_chk-gds.src-qnty = 0 then do:
     1001                  assign
     1002                     v-sum-all = (buf_chk-gds.src-qnty + v-doc-qnty) * v-price-base
     1003                     v-sum-chk = v-sum-base + RoundUp(buf_chk-gds.src-qnty, buf_chk-gds.src-price)
     1004                     .
     1005              end.
     1006              else do:
     1007                 assign
     1008                 v-sum-all = (buf_chk-gds.doc-qnty + v-doc-qnty ) * v-price-base
     1009                 v-sum-chk = v-sum-base + buf_chk-gds.sum-base
     1010                 .
     1011              end.
     1012           end.
     1013           v-sum-promo = Round(v-sum-all, 2) - Round(v-sum-chk, 2).
     1014       end.
     1015       return v-sum-promo.
     1016   end function.
     1017   function GetUnBaseSum returns decimal
     1018       (input iDocCode as character,
     1019        input iLineNum as integer,
     1020        input iQnty as decimal,
     1021        input iPrice as decimal):
     1022      define buffer buf_chk-gds-attr for ub.chk-gds-attr.
     1023      define variable vBaseSum as decimal no-undo.
     1024      define variable vDiscSum as decimal no-undo.
     1025      vDiscSum = 0.
     1026      find first buf_chk-gds-attr no-lock where
     1027                        buf_chk-gds-attr.doc-code = iDocCode
     1028                    and buf_chk-gds-attr.line-num  = iLineNum
     1029                    and buf_chk-gds-attr.attr-code = "CSPromoSum"
     1030             no-error.
     1031      if avail buf_chk-gds-attr then
     1032         vDiscSum = dec(buf_chk-gds-attr.attr-value) no-error.
     1033      vBaseSum = iQnty * iPrice + vDiscSum.
     1034      if vDiscSum = 0 and ChkPromoPrice(iDocCode, iLineNum) then
     1035         vBaseSum = RoundUp(iQnty, iPrice).
     1036      return vBaseSum.
     1037   end function.
     1038   function GetRoundSum returns decimal
     1039       (input iDocCode as character,
     1040        input iLineNum as integer,
     1041        input iQnty as decimal,
     1042        input iPrice as decimal):
     1043      define buffer buf_chk-gds-attr for ub.chk-gds-attr.
     1044      define variable vBaseSum as decimal no-undo.
     1045      if ChkPromoPrice(iDocCode, iLineNum) then
     1046         vBaseSum = RoundUp(iQnty, iPrice).
     1047      else vBaseSum = iQnty * iPrice.
     1048      return vBaseSum.
     1049   end function.
     1050   function GetRoundSumChkDel returns decimal
     1051       (input iDocCode as character,
     1052        input iLineNum as integer,
     1053        input iChipNum as integer,
     1054        input iQnty as decimal,
     1055        input iPrice as decimal):
     1056      define buffer  buf_c-chk-doc-attr for ub.c-chk-doc-attr.
     1057      define variable vBaseSum as decimal no-undo.
     1058      define variable vIsPromo as logical no-undo.
     1059      for each buf_c-chk-doc-attr no-lock where
     1060               buf_c-chk-doc-attr.doc-code = iDocCode
     1061           and buf_c-chk-doc-attr.chip-num = iChipNum
     1062          :
     1063          if num-entries(buf_c-chk-doc-attr.attr-code, chr(4)) > 1
     1064          then do :
     1065            if entry(1, buf_c-chk-doc-attr.attr-code, chr(4)) begins "gds="
     1066            and entry(2, buf_c-chk-doc-attr.attr-code, chr(4)) = "CSPromo"
     1067            and entry(2, entry(1, buf_c-chk-doc-attr.attr-code, chr(4)), "=") = String(iLineNum)
     1068            and can-do("2,4,5,7", buf_c-chk-doc-attr.attr-value)
     1069            then vIsPromo = yes.
     1070          end.
     1071      end.
     1072      if ChkPromoPrice(iDocCode, iLineNum) then
     1073         vBaseSum = RoundUp(iQnty, iPrice).
     1074      else vBaseSum = iQnty * iPrice.
     1075      return vBaseSum.
     1076   end function.
     1077   function GetSaleRetDisc returns decimal
     1078       (input iDocCode as character,
     1079        input iSaleCode as character):
     1080      define buffer buf_chk-gds-attr for ub.chk-gds-attr.
     1081      define buffer buf_chk-gds for ub.chk-gds.
     1082      define variable vQntyPromoRet as decimal no-undo.
     1083      define variable vQntyPromoSel as decimal no-undo.
     1084      define variable vDiscSumRet   as decimal no-undo.
     1085      define variable vDiscSumSale  as decimal no-undo.
     1086      vDiscSumRet = 0.
     1087      cspr:
     1088      for each  buf_chk-gds no-lock where
     1089                buf_chk-gds.doc-code = iDocCode,
     1090          first buf_chk-gds-attr no-lock where
     1091                buf_chk-gds-attr.doc-code  = buf_chk-gds.doc-code
     1092            and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
     1093            and buf_chk-gds-attr.attr-code = "CSPromo"
     1094            and can-do("2,4,5,7", buf_chk-gds-attr.attr-value)
     1095          :
     1096          vQntyPromoRet = buf_chk-gds.src-qnty.
     1097          leave cspr.
     1098      end.
     1099      if vQntyPromoRet <> 0 then
     1100      for each  buf_chk-gds no-lock where
     1101                buf_chk-gds.doc-code = iSaleCode:
     1102          find first buf_chk-gds-attr no-lock where
     1103                     buf_chk-gds-attr.doc-code  = buf_chk-gds.doc-code
     1104                 and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
     1105                 and buf_chk-gds-attr.attr-code = "CSPromo"
     1106          no-error.
     1107          if avail buf_chk-gds-attr
     1108               and can-do("2,4,5,7", buf_chk-gds-attr.attr-value)
     1109          then
     1110            vQntyPromoSel = buf_chk-gds.src-qnty.
     1111          find first buf_chk-gds-attr no-lock where
     1112                    buf_chk-gds-attr.doc-code  = buf_chk-gds.doc-code
     1113                and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
     1114                and buf_chk-gds-attr.attr-code = "CSPromoSum"
     1115          no-error.
     1116          if avail buf_chk-gds-attr then
     1117             vDiscSumSale = dec(buf_chk-gds-attr.attr-value) no-error.
     1118      end.
     1119      if vQntyPromoRet <> 0 and
     1120         vQntyPromoSel = -1 * vQntyPromoRet
     1121      then vDiscSumRet = -1 * vDiscSumSale.
     1122      return vDiscSumRet.
     1123   end function.
     1124   function SetPromoDisc return logical
     1125    (input iDocCode as character,
     1126        input iLineNum as integer
     1127        )
     1128       :
     1129      define buffer buf_chk-doc for ub.chk-doc.
     1130      define buffer buf2_chk-doc for ub.chk-doc.
     1131      define buffer buf_chk-gds for ub.chk-gds.
     1132      define buffer buf2_chk-gds for ub.chk-gds.
     1133      define buffer buf_chk-gds-attr for ub.chk-gds-attr.
     1134      define buffer buf2_chk-gds-attr for ub.chk-gds-attr.
     1135      define buffer buf_chk-discnt for ub.chk-discnt.
     1136      define buffer buf2_chk-discnt for ub.chk-discnt.
     1137      define buffer buf_chk-discnt-attr for ub.chk-discnt-attr.
     1138      define buffer buf2_chk-discnt-attr for ub.chk-discnt-attr.
     1139      define variable v-promo-sum as decimal no-undo.
     1140      define variable v-disc-promo-id as character no-undo.
     1141      define variable var-discnt-id as integer no-undo.
     1142      define variable v-chk-sale as character no-undo.
     1143      find first buf_chk-gds-attr no-lock where
     1144                 buf_chk-gds-attr.doc-code = iDocCode
     1145             and buf_chk-gds-attr.line-num  = iLineNum
     1146             and buf_chk-gds-attr.attr-code = "CSPromo"
     1147         no-error.
     1148      if avail buf_chk-gds-attr
     1149        then do:
     1150        find first buf_chk-discnt no-lock where
     1151                   buf_chk-discnt.doc-code = buf_chk-gds-attr.doc-code
     1152               and buf_chk-discnt.line-num = buf_chk-gds-attr.line-num
     1153               and buf_chk-discnt.record-type = 0
     1154               and buf_chk-discnt.promo-id > ""
     1155               no-error.
     1156        if not avail buf_chk-discnt then do:
     1157           find first buf_chk-doc no-lock where
     1158                      buf_chk-doc.doc-code = iDocCode
     1159              no-error.
     1160           find first buf_chk-gds no-lock where
     1161                      buf_chk-gds.doc-code = iDocCode
     1162                 and  buf_chk-gds.line-num = iLineNum
     1163              no-error.
     1164          for first buf2_chk-doc no-lock where
     1165                    buf2_chk-doc.obj-code = buf_chk-doc.obj-code
     1166                and buf2_chk-doc.obj-type = buf_chk-doc.obj-type
     1167                and buf2_chk-doc.pay-desk = buf_chk-doc.pay-desk
     1168                and buf2_chk-doc.chk-type = int('1':U)
     1169                and buf2_chk-doc.chk-num  = int(entry(1,buf_chk-doc.doc-num2,":"))
     1170                and buf2_chk-doc.z-number = int(entry(2, buf_chk-doc.doc-num2,":"))
     1171              :
     1172              find first buf2_chk-gds no-lock where
     1173                         buf2_chk-gds.doc-code = buf2_chk-doc.doc-code
     1174                    and  buf2_chk-gds.b-code   = buf_chk-gds.b-code
     1175              no-error.
     1176              if not avail buf2_chk-gds then return no.
     1177              v-chk-sale = buf2_chk-doc.doc-code.
     1178              find first buf_chk-discnt no-lock where
     1179                         buf_chk-discnt.doc-code =  buf2_chk-doc.doc-code and
     1180                         buf_chk-discnt.record-type = 1 and
     1181                         buf_chk-discnt.object-line-num = buf2_chk-gds.line-num and
     1182                         buf_chk-discnt.promo-id > ""
     1183              no-error .
     1184              if avail buf_chk-discnt
     1185              then do:
     1186                 v-disc-promo-id = buf_chk-discnt.promo-id.
     1187                 find first buf2_chk-discnt no-lock where
     1188                   buf2_chk-discnt.doc-code = iDocCode and
     1189                   buf2_chk-discnt.record-type = 5 and
     1190                   buf2_chk-discnt.line-num = 0 and
     1191                   buf2_chk-discnt.promo-id =  v-disc-promo-id
     1192                 no-error.
     1193                 find first buf2_chk-discnt-attr no-lock where
     1194                            buf2_chk-discnt-attr.doc-code = iDocCode and
     1195                            buf2_chk-discnt-attr.record-type = 5 and
     1196                            buf2_chk-discnt-attr.line-num = 0 and
     1197                            buf2_chk-discnt-attr.attr-code = "promo-id" and
     1198                            buf2_chk-discnt-attr.attr-value = v-disc-promo-id
     1199                       no-error .
     1200                 if not avail buf2_chk-discnt
     1201                 then do:
     1202                     for each buf_chk-discnt no-lock where
     1203                              buf_chk-discnt.doc-code = buf_chk-gds-attr.doc-code
     1204                          and buf_chk-discnt.record-type = 5:
     1205                          var-discnt-id  = var-discnt-id + 1.
     1206                     end.
     1207                     create buf2_chk-discnt.
     1208                     assign
     1209                       buf2_chk-discnt.doc-code = iDocCode
     1210                       buf2_chk-discnt.record-type = 5
     1211                       buf2_chk-discnt.line-num = 0
     1212                       buf2_chk-discnt.promo-id = v-disc-promo-id
     1213                       buf2_chk-discnt.object-sum = 0
     1214                       buf2_chk-discnt.discnt-id = if avail buf2_chk-discnt-attr
     1215                                                      then buf2_chk-discnt-attr.discnt-id
     1216                                                      else (var-discnt-id + 1)
     1217                       var-discnt-id = 0
     1218                       buf2_chk-discnt.object-line-num = 0
     1219                       buf2_chk-discnt.pay-desk = buf_chk-doc.pay-desk
     1220                       buf2_chk-discnt.obj-code = buf_chk-doc.obj-code
     1221                       buf2_chk-discnt.obj-type = buf_chk-doc.obj-type
     1222                       buf2_chk-discnt.chk-date = buf_chk-doc.chk-date
     1223                       buf2_chk-discnt.shift-date = buf_chk-doc.shift-date
     1224                       buf2_chk-discnt.shift-num = buf_chk-doc.shift-num
     1225                       buf2_chk-discnt.chk-time = buf_chk-doc.chk-time
     1226                       .
     1227                 end.
     1228                 if avail buf2_chk-discnt and
     1229                    not avail buf2_chk-discnt-attr
     1230                 then do:
     1231                    create buf2_chk-discnt-attr.
     1232                    assign
     1233                       buf2_chk-discnt-attr.doc-code = iDocCode
     1234                       buf2_chk-discnt-attr.discnt-id = buf2_chk-discnt.discnt-id
     1235                       buf2_chk-discnt-attr.record-type     = 5
     1236                       buf2_chk-discnt-attr.line-num        = 0
     1237                       buf2_chk-discnt-attr.object-line-num = 0
     1238                       buf2_chk-discnt-attr.attr-code       = "promo-id"
     1239                       buf2_chk-discnt-attr.attr-value      = v-disc-promo-id
     1240                       .
     1241                 end.
     1242              end.
     1243          end.
     1244           v-promo-sum = 0.
     1245           if can-do("1,6,7", buf_chk-gds-attr.attr-value)
     1246           then do:
     1247              if v-chk-sale <> ? and v-chk-sale <> "" then
     1248                 v-promo-sum = GetSaleRetDisc(iDocCode,v-chk-sale).
     1249              v-promo-sum = if v-promo-sum = 0 then GetPromoSum(iDocCode) else v-promo-sum.
     1250              if v-promo-sum <> 0 then do:
     1251                  find first buf2_chk-gds-attr no-lock where
     1252                             buf2_chk-gds-attr.doc-code = iDocCode
     1253                         and buf2_chk-gds-attr.line-num  = iLineNum
     1254                         and buf2_chk-gds-attr.attr-code = "CSPromoSum"
     1255                     no-error.
     1256                  if not avail buf2_chk-gds-attr then do:
     1257                      create buf2_chk-gds-attr.
     1258                      assign
     1259                         buf2_chk-gds-attr.doc-code = iDocCode
     1260                         buf2_chk-gds-attr.line-num  = iLineNum
     1261                         buf2_chk-gds-attr.attr-code = "CSPromoSum"
     1262                         buf2_chk-gds-attr.attr-value = string(Round(v-promo-sum,2))
     1263                         .
     1264                  end.
     1265              end.
     1266           end.
     1267           for each buf_chk-discnt no-lock where
     1268                   buf_chk-discnt.doc-code = buf_chk-gds-attr.doc-code
     1269               and buf_chk-discnt.record-type = 0:
     1270              var-discnt-id  = var-discnt-id + 1.
     1271           end.
     1272           create buf_chk-discnt.
     1273           assign
     1274               buf_chk-discnt.doc-code = iDocCode
     1275               buf_chk-discnt.line-num = iLineNum
     1276               buf_chk-discnt.record-type = 0
     1277               buf_chk-discnt.discnt-id = (var-discnt-id + 1)
     1278               buf_chk-discnt.time-oper = buf_chk-gds.time-oper
     1279               buf_chk-discnt.line-type = integer('1':U)
     1280               buf_chk-discnt.line-sign = no
     1281               buf_chk-discnt.pass-discnt = integer('0':U)
     1282               buf_chk-discnt.value-type = integer('2':U)
     1283               buf_chk-discnt.src-d-card = buf_chk-gds.src-d-card
     1284               buf_chk-discnt.d-card = buf_chk-gds.d-card
     1285               buf_chk-discnt.discnt-value-abs = 0
     1286               buf_chk-discnt.discnt-value-pcnt = 0
     1287               buf_chk-discnt.object-line-num = iLineNum
     1288               buf_chk-discnt.pay-desk = buf_chk-doc.pay-desk
     1289               buf_chk-discnt.obj-code = buf_chk-doc.obj-code
     1290               buf_chk-discnt.obj-type = buf_chk-doc.obj-type
     1291               buf_chk-discnt.chk-date = buf_chk-doc.chk-date
     1292               buf_chk-discnt.chk-time = buf_chk-doc.chk-time
     1293               buf_chk-discnt.shift-date = buf_chk-doc.shift-date
     1294               buf_chk-discnt.shift-num = buf_chk-doc.shift-num
     1295               buf_chk-discnt.object-qnty = buf_chk-gds.src-qnty
     1296               buf_chk-discnt.object-sum = buf_chk-gds.src-sum
     1297               var-discnt-id = var-discnt-id + 1
     1298               buf_chk-discnt.promo-id = v-disc-promo-id
     1299               buf_chk-discnt.discnt-type = integer('7':U)
     1300               .
     1301           find first buf_chk-discnt-attr no-lock where
     1302                      buf_chk-discnt-attr.attr-code = "promo-id"
     1303                  and buf_chk-discnt-attr.discnt-id = buf_chk-discnt.discnt-id
     1304                  and buf_chk-discnt-attr.doc-code = buf_chk-discnt.doc-code
     1305                  and buf_chk-discnt-attr.line-num = buf_chk-discnt.line-num
     1306                  no-error.
     1307           if not avail buf_chk-discnt-attr then
     1308           do:
     1309               create buf_chk-discnt-attr .
     1310               assign
     1311                   buf_chk-discnt-attr.attr-code = "promo-id"
     1312                   buf_chk-discnt-attr.attr-value = buf_chk-discnt.promo-id
     1313                   buf_chk-discnt-attr.discnt-id = buf_chk-discnt.discnt-id
     1314                   buf_chk-discnt-attr.doc-code = buf_chk-discnt.doc-code
     1315                   buf_chk-discnt-attr.line-num = buf_chk-discnt.line-num
     1316                   buf_chk-discnt-attr.object-line-num = buf_chk-discnt.object-line-num
     1317                   buf_chk-discnt-attr.record-type = buf_chk-discnt.record-type
     1318                   .
     1319            end.
     1320        end.
     1321      end.
     1322      return yes.
     1323   end function.
     1324   function GetPromoPriceSum returns decimal
     1325       (input iDocCode as character)
     1326       :
     1327       define buffer buf_chk-gds for ub.chk-gds.
     1328       define buffer buf_chk-gds-attr for ub.chk-gds-attr.
     1329       define variable vPromoSum as decimal no-undo.
     1330       vPromoSum = 0.
     1331       cspr:
     1332       for each buf_chk-gds no-lock where
     1333                    buf_chk-gds.doc-code = iDocCode,
     1334              first buf_chk-gds-attr no-lock where
     1335                    buf_chk-gds-attr.doc-code = buf_chk-gds.doc-code
     1336                and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
     1337                and buf_chk-gds-attr.attr-code = "CSPromo"
     1338                and can-do("2,4,5,7", buf_chk-gds-attr.attr-value):
     1339          vPromoSum = RoundUp(buf_chk-gds.src-qnty, buf_chk-gds.src-price).
     1340          leave cspr.
     1341       end.
     1342       return vPromoSum.
     1343   end.
     1344   function GetPromoPriceLine returns integer
     1345       (input iDocCode as character)
     1346       :
     1347       define buffer buf_chk-gds for ub.chk-gds.
     1348       define buffer buf_chk-gds-attr for ub.chk-gds-attr.
     1349       define variable vPromoLine as integer no-undo.
     1350       vPromoLine = 0.
     1351       cspr:
     1352       for each buf_chk-gds no-lock where
     1353                    buf_chk-gds.doc-code = iDocCode,
     1354              first buf_chk-gds-attr no-lock where
     1355                    buf_chk-gds-attr.doc-code = buf_chk-gds.doc-code
     1356                and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
     1357                and buf_chk-gds-attr.attr-code = "CSPromo"
     1358                and can-do("2,4,5,7", buf_chk-gds-attr.attr-value):
     1359          vPromoLine = buf_chk-gds-attr.line-num.
     1360          leave cspr.
     1361       end.
     1362       return vPromoLine.
     1363   end.
     1364     v-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt") .
     1365     assign
     1366       v-file-name-rep-htm = v-report-name + ".html"
     1367     .
     1368     output to value(v-file-name-rep-htm).
     1369     output close.
     1370   run create-fill-tt-chk.
     1371     v-report-name = "Отчет по среднему чеку".
     1372     str1 = substitute(
     1373       (if X-TOG-Shift then "С &1, смена №&2 по &3, смена №&4" else "За период с &1 по &3")
     1374       , fnc-DD-MM-YYYY(X-Date-Start)
     1375       , X-Shift-Start
     1376       , fnc-DD-MM-YYYY(X-Date-End)
     1377       , X-Shift-End
     1378     ) .
     1379     if X-selectGood = 4 or
     1380        X-selectGood = 6   or
     1381        X-selectGood = 5 then do:
     1382       v-choice-gds = "По списку товаров: " + x-Goods-Editor.
     1383       if length(v-choice-gds) > 115 then
     1384         v-choice-gds = substring(v-choice-gds, 1, 115) + "..." .
     1385     end.
     1386     v-choice-gds = if length(str2) > 115 then ( substring(str2, 1, 115) + "..." ) else str2.
     1387     str4 = replace(str4, chr(10), " ").
     1388     str4 = replace(str4, chr(13), " ").
     1389     str4 = replace(str4, chr(9),  " ").
     1390     str4 = trim(str4, " ").
     1391     str4 = replace(str4, "  ",  " ").
     1392     v-choice-obj = if length(str4) > 115 then ( substring(str4, 1, 115) + "..." ) else str4.
     1393     tog-uchet-html = if p-tog-uchet then "Нет" else "Да"  .
     1394     tog-raz-html   = if p-tog-raz   then "Да"  else "Нет" .
     1395    run proc-create-HTML(       input v-file-name-rep-htm
     1396                               ,input v-report-name
     1397                               ,input str1
     1398                               ,input v-choice-gds
     1399                               ,input v-choice-obj
     1400                               ,input tog-uchet-html
     1401                               ,input tog-raz-html
     1402                           ).
     1403         run prn-lib-reportviewer-report-name in this-procedure (
     1404           input THIS-PROCEDURE
     1405           ,input v-file-name-rep-htm
     1406           ).
     1407   procedure chk-calc:
     1408   define input parameter p-obj-code as integer no-undo.
     1409   define input parameter p-obj-type as character no-undo.
     1410   define input parameter p-doc-code as character no-undo.
     1411   define input parameter p-sales-man as integer no-undo.
     1412   define input parameter p-salesman-psn-code as integer no-undo.
     1413   define input parameter p-chk-type as integer no-undo.
     1414   define variable v-prod as logical no-undo .
     1415   define variable v-gds-code as integer no-undo .
     1416   define variable v-grp-code as integer no-undo .
     1417   define variable v-grp-name like ub.goods.grp-name no-undo.
     1418   define variable v-found as logical no-undo.
     1419   define variable v-use-line as logical no-undo.
     1420   define variable ii-grp as integer no-undo.
     1421   define variable v-name         as char      no-undo.
     1422   define variable vSumUnBase as decimal no-undo.
     1423   define buffer buf_chk-gds-pay for ub.chk-gds-pay .
     1424   define buffer buf_bar-code for ub.bar-code .
     1425   define buffer buf_goods    for ub.goods .
     1426   define buffer buf_person   for ub.person .
     1427   define buffer buf-qnty-temp-chk for temp-chk .
     1428     if p-tog-prod = yes then do:
     1429       find first buf-qnty-temp-chk
     1430            where buf-qnty-temp-chk.gds-code = 0
     1431              and buf-qnty-temp-chk.obj-code = p-obj-code
     1432              and buf-qnty-temp-chk.obj-type = p-obj-type
     1433   // 23/VIII-2018
     1434   //           and buf-qnty-temp-chk.grp-code = p-sales-man
     1435   //           and buf-qnty-temp-chk.sales-man-psn = p-salesman-psn-code
     1436              and buf-qnty-temp-chk.grp-code = p-salesman-psn-code
     1437       use-index tt no-error .
     1438       if not available buf-qnty-temp-chk then do:
     1439         if p-sales-man <> 0 then do:
     1440           run rep/get-psn.p (input p-salesman-psn-code, output v-name ).
     1441           for first buf_person no-lock where buf_person.psn-code = p-salesman-psn-code :
     1442             v-name = v-name + '  ' + buf_person.name1 + ' ':U + buf_person.name2.
     1443           end.
     1444         end.
     1445         else v-name = "Продавец не указан".
     1446         create buf-qnty-temp-chk.
     1447         assign
     1448           buf-qnty-temp-chk.gds-code  = 0
     1449           buf-qnty-temp-chk.obj-code  = p-obj-code
     1450           buf-qnty-temp-chk.obj-type  = p-obj-type
     1451   // 23/VIII-2018
     1452   //        buf-qnty-temp-chk.grp-code  = p-sales-man
     1453   //        buf-qnty-temp-chk.sales-man-psn = p-salesman-psn-code
     1454           buf-qnty-temp-chk.grp-code  = p-salesman-psn-code
     1455           buf-qnty-temp-chk.grp-lvl     = 1  // по продавцам - где используется ?
     1456           buf-qnty-temp-chk.upper-code  = -2 // по продавцам - где используется ?
     1457           buf-qnty-temp-chk.gds-name    = v-name
     1458           buf-qnty-temp-chk.doc-qnty    = 0
     1459         .
     1460       end.
     1461     end .
     1462     v-prod = no.
     1463     _chk:
     1464     for each buf_chk-gds-pay no-lock
     1465        where buf_chk-gds-pay.doc-code = p-doc-code
     1466          and buf_chk-gds-pay.algo-num = "1.8"
     1467     break by buf_chk-gds-pay.b-code
     1468           by buf_chk-gds-pay.line-num :
     1469       if first-of (buf_chk-gds-pay.b-code) then do :
     1470         v-use-line = false .
     1471         find first buf_bar-code no-lock
     1472              where buf_bar-code.b-code = buf_chk-gds-pay.b-code no-error .
     1473         if available buf_bar-code then do :
     1474           v-gds-code = buf_bar-code.gds-code .
     1475           find first buf_goods no-lock where buf_goods.gds-code = v-gds-code no-error .
     1476           if available buf_goods then do:
     1477             v-grp-code = buf_goods.grp-code .
     1478           end .
     1479           else v-grp-code = ? .
     1480         end .
     1481         else assign
     1482           v-gds-code = ?
     1483           v-grp-code = ?
     1484         .
     1485         if v-grp-code = ? then next .
     1486         case x-SelectGood:
     1487           when 4 or
     1488           when 6 or
     1489           when 5 then do:
     1490             find first gds-list
     1491                  where gds-list.artic     = buf_goods.artic
     1492                    and gds-list.prod-type = buf_goods.prod-type
     1493                    and gds-list.prod-code = buf_goods.prod-code no-error .
     1494             if not available gds-list then next.
     1495           end.
     1496           when 1 then .
     1497           when 2 then do :
     1498             assign
     1499               v-grp-name = ""
     1500               v-found = no
     1501             .
     1502             _ii-grp:
     1503             do ii-grp = 1 to num-entries(buf_goods.grp-name, chr(47)) - 1 :
     1504               v-grp-name = v-grp-name + entry(ii-grp, buf_goods.grp-name, chr(47)) + chr(47) .
     1505               if can-find(first tmp#grp where tmp#grp.grp-name = v-grp-name) then do:
     1506                 v-found = yes.
     1507                 leave _ii-grp.
     1508               end.
     1509             end.
     1510             if not v-found then next _chk.
     1511           end.
     1512           otherwise next .
     1513         end case.
     1514         v-use-line = true .
     1515         if (p-chk-type = 1) then do :
     1516         if not can-find (first help-chk where help-chk.doc-code  = buf_chk-gds-pay.doc-code
     1517                                           and help-chk.group-chk = v-grp-code
     1518                                           and help-chk.obj-code  = p-obj-code
     1519                                           and help-chk.obj-type  = p-obj-type) then do:
     1520           create help-chk.
     1521           assign
     1522             help-chk.doc-code  = buf_chk-gds-pay.doc-code
     1523             help-chk.group-chk = v-grp-code
     1524             help-chk.obj-code  = p-obj-code
     1525             help-chk.obj-type  = p-obj-type
     1526           .
     1527         end.
     1528         end .
     1529         if p-tog-prod = yes then do:
     1530           if not v-prod then assign
     1531             buf-qnty-temp-chk.doc-qnty = buf-qnty-temp-chk.doc-qnty + 1 when (p-chk-type = 1)
     1532             v-prod = yes
     1533           .
     1534           find first temp-chk
     1535                where temp-chk.gds-code = v-gds-code
     1536                  and temp-chk.obj-code = p-obj-code
     1537                  and temp-chk.obj-type = p-obj-type
     1538   // 23/VIII-2018
     1539   //               and temp-chk.grp-code = p-sales-man
     1540   //               and temp-chk.sales-man-psn = p-salesman-psn-code
     1541                  and temp-chk.grp-code = p-salesman-psn-code
     1542           use-index tt no-error .
     1543           if not available temp-chk then do:
     1544             create temp-chk.
     1545             assign
     1546               temp-chk.gds-code = v-gds-code
     1547               temp-chk.obj-code = p-obj-code
     1548               temp-chk.obj-type = p-obj-type
     1549   // 23/VIII-2018
     1550   //            temp-chk.grp-code = p-sales-man
     1551   //            temp-chk.sales-man-psn = p-salesman-psn-code
     1552               temp-chk.grp-code = p-salesman-psn-code
     1553               temp-chk.gds-name    = buf_goods.gds-name
     1554               temp-chk.unit        = buf_goods.unit-base
     1555               temp-chk.doc-qnty    = 0
     1556             .
     1557           end.
     1558         end.
     1559         else do:
     1560           if not v-prod then assign
     1561             obj-temp-chk.doc-qnty = obj-temp-chk.doc-qnty + 1 when (p-chk-type = 1)
     1562             v-prod = yes
     1563           .
     1564           find first temp-chk
     1565                where temp-chk.gds-code = v-gds-code
     1566                  and temp-chk.obj-code = p-obj-code
     1567                  and temp-chk.obj-type = p-obj-type
     1568           use-index tt no-error .
     1569           if not available temp-chk then do:
     1570             create temp-chk.
     1571             assign
     1572               temp-chk.gds-code = v-gds-code
     1573               temp-chk.obj-code = p-obj-code
     1574               temp-chk.obj-type = p-obj-type
     1575               temp-chk.gds-name = buf_goods.gds-name
     1576               temp-chk.unit     = buf_goods.unit-base
     1577               temp-chk.grp-code = buf_goods.grp-code
     1578               temp-chk.doc-qnty = 0
     1579             .
     1580           end.
     1581         end.
     1582         if p-chk-type = 1 then assign
     1583           temp-chk.doc-qnty = temp-chk.doc-qnty + 1
     1584         .
     1585       end .
     1586       if not v-use-line then next .
     1587       if p-chk-type = 1 then do:
     1588         if first-of(buf_chk-gds-pay.line-num) then assign
     1589           temp-chk.pok-qnty     = temp-chk.pok-qnty     + 1
     1590           obj-temp-chk.pok-qnty = obj-temp-chk.pok-qnty + 1
     1591         .
     1592       end .
     1593       assign
     1594         vSumUnBase = GetUnBaseSum(buf_chk-gds-pay.doc-code, buf_chk-gds-pay.line-num, buf_chk-gds-pay.eff-doc-qnty, buf_chk-gds-pay.price-base)
     1595         temp-chk.qnty       = temp-chk.qnty       + buf_chk-gds-pay.eff-doc-qnty
     1596         temp-chk.sum-unbase = temp-chk.sum-unbase + vSumUnBase
     1597         temp-chk.sum-base   = temp-chk.sum-base   + buf_chk-gds-pay.tot-r-b
     1598         obj-temp-chk.qnty       = obj-temp-chk.qnty       + buf_chk-gds-pay.eff-doc-qnty
     1599         obj-temp-chk.sum-unbase = obj-temp-chk.sum-unbase + vSumUnBase
     1600         obj-temp-chk.sum-base   = obj-temp-chk.sum-base   + buf_chk-gds-pay.tot-r-b
     1601       .
     1602       assign
     1603         temp-chk.srchk-kol-tov       = temp-chk.qnty       / temp-chk.doc-qnty
     1604         temp-chk.srchk-sum           = temp-chk.sum-unbase / temp-chk.doc-qnty
     1605         temp-chk.srchk-base-sum      = temp-chk.sum-base   / temp-chk.doc-qnty
     1606         temp-chk.srchk-kol-tov-pokup = temp-chk.pok-qnty   / temp-chk.doc-qnty
     1607       .
     1608     end.
     1609   end procedure.
     1610   procedure create-fill-tt-chk:
     1611   define variable v-chk-type-list as character no-undo .
     1612   define variable v-obj-type as character no-undo .
     1613   define variable v-obj-code as integer no-undo .
     1614   define buffer buf_chk-doc for ub.chk-doc .
     1615     if not p-tog-raz then do:
     1616       create obj-temp-chk.
     1617       assign
     1618         obj-temp-chk.obj-code = 0
     1619         obj-temp-chk.obj-type = ''
     1620         obj-temp-chk.gds-name = 'Итого по всем объектам'
     1621         obj-temp-chk.upper-code = -1
     1622         obj-temp-chk.grp-code   = 0
     1623         v-obj-type = ''
     1624         v-obj-code = 0
     1625       .
     1626     end.
     1627     v-chk-type-list = '1':U .
     1628     if p-tog-uchet = no then v-chk-type-list = v-chk-type-list + "," + '6':U .
     1629     for each obj-list :
     1630       do:
     1631         run rep/rpychk0.p (input "r-shftc2"
     1632                           ,input obj-list.obj-type
     1633                           ,input obj-list.obj-code
     1634                           ,input ?
     1635                           ,input ?
     1636                           ,input X-date-start
     1637                           ,input X-date-end
     1638                           ,input 0
     1639                           ,input 99
     1640                           ,input ?
     1641         ) no-error.
     1642         if error-status:error then do:
     1643             message
     1644               substitute( "*** Ошибка вызова rpychk0 по объекту &1 &2. &3. &4. &5."
     1645                       , obj-list.obj-type
     1646                       , obj-list.obj-code
     1647                       , return-value
     1648                       , error-status:get-message(1)
     1649                       , error-status:get-message(2)
     1650                       )
     1651               view-as alert-box .
     1652         end.
     1653       end.
     1654       if p-tog-raz then do:
     1655         create obj-temp-chk.
     1656         assign
     1657           obj-temp-chk.obj-code = obj-list.obj-code
     1658           obj-temp-chk.obj-type = obj-list.obj-type
     1659           obj-temp-chk.gds-name = obj-list.obj-name
     1660           obj-temp-chk.upper-code = -1
     1661           obj-temp-chk.grp-code   = 0
     1662           v-obj-type = obj-list.obj-type
     1663           v-obj-code = obj-list.obj-code
     1664         .
     1665       end.
     1666       if x-TOG-Shift = yes then do:
     1667         for each buf_chk-doc no-lock
     1668            where buf_chk-doc.obj-type = obj-list.obj-type
     1669              and buf_chk-doc.obj-code = obj-list.obj-code
     1670              and buf_chk-doc.shift-date >= X-date-Start
     1671              and buf_chk-doc.shift-date <= X-date-End
     1672              and buf_chk-doc.out-code <> ?
     1673              and can-do(v-chk-type-list, string(buf_chk-doc.chk-type))
     1674         :
     1675           if (buf_chk-doc.shift-date = X-date-Start)
     1676          and (buf_chk-doc.shift-num < x-Shift-Start) then next.
     1677           if (buf_chk-doc.shift-date = X-date-End)
     1678          and (buf_chk-doc.shift-num > x-Shift-End) then next.
     1679           run chk-calc in this-procedure
     1680           ( input v-obj-code
     1681           , input v-obj-type
     1682           , input buf_chk-doc.doc-code
     1683           , input buf_chk-doc.sales-man
     1684           , input buf_chk-doc.salesman-psn-code
     1685           , input buf_chk-doc.chk-type
     1686           ) .
     1687         end .
     1688       end.
     1689       else do:
     1690         for each buf_chk-doc no-lock
     1691            where buf_chk-doc.obj-type = obj-list.obj-type
     1692              and buf_chk-doc.obj-code = obj-list.obj-code
     1693              and buf_chk-doc.chk-date >= X-date-Start
     1694              and buf_chk-doc.chk-date <= X-date-End
     1695              and buf_chk-doc.out-code <> ?
     1696              and can-do(v-chk-type-list, string(buf_chk-doc.chk-type))
     1697         :
     1698           run chk-calc in this-procedure
     1699           ( input v-obj-code
     1700           , input v-obj-type
     1701           , input buf_chk-doc.doc-code
     1702           , input buf_chk-doc.sales-man
     1703           , input buf_chk-doc.salesman-psn-code
     1704           , input buf_chk-doc.chk-type
     1705           ) .
     1706         end .
     1707       end.
     1708       if p-tog-raz = yes then do:
     1709         if p-tog-prod = yes then run prod-level         ( input obj-list.obj-code, input obj-list.obj-type).
     1710                             else run transform-tt-level ( input obj-list.obj-code, input obj-list.obj-type).
     1711         assign
     1712           obj-temp-chk.srchk-uch         = 100
     1713           obj-temp-chk.srchk-base-uch    = 100
     1714           obj-temp-chk.srchk-kol-tov-uch = 100
     1715           obj-temp-chk.srchk-kol-tov       = obj-temp-chk.qnty       / obj-temp-chk.doc-qnty
     1716           obj-temp-chk.srchk-sum           = obj-temp-chk.sum-unbase / obj-temp-chk.doc-qnty
     1717           obj-temp-chk.srchk-base-sum      = obj-temp-chk.sum-base   / obj-temp-chk.doc-qnty
     1718           obj-temp-chk.srchk-kol-tov-pokup = obj-temp-chk.pok-qnty   / obj-temp-chk.doc-qnty
     1719         .
     1720       end .
     1721     end.
     1722     if p-tog-raz = no then do:
     1723       if p-tog-prod = yes then run prod-level        ( input 0, input '').
     1724                           else run transform-tt-level( input 0, input '').
     1725       assign
     1726         obj-temp-chk.srchk-uch         = 100
     1727         obj-temp-chk.srchk-base-uch    = 100
     1728         obj-temp-chk.srchk-kol-tov-uch = 100
     1729         obj-temp-chk.srchk-kol-tov       = obj-temp-chk.qnty       / obj-temp-chk.doc-qnty
     1730         obj-temp-chk.srchk-sum           = obj-temp-chk.sum-unbase / obj-temp-chk.doc-qnty
     1731         obj-temp-chk.srchk-base-sum      = obj-temp-chk.sum-base   / obj-temp-chk.doc-qnty
     1732         obj-temp-chk.srchk-kol-tov-pokup = obj-temp-chk.pok-qnty   / obj-temp-chk.doc-qnty
     1733       .
     1734     end .
     1735   end procedure.
     1736   procedure proc-create-HTML:
     1737   define input parameter p-file-name-rep-htm as character no-undo.
     1738   define input parameter p-report-name as character no-undo.
     1739   define input parameter p-period-date as char no-undo.
     1740   define input parameter v-choice-gds as char no-undo.
     1741   define input parameter v-choice-obj as char no-undo.
     1742   define input parameter tog-uchet-html as char no-undo.
     1743   define input parameter tog-raz-html as char no-undo.
     1744       define buffer buf-html-temp-chk for temp-chk.
     1745     for first obj-list :
     1746   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1747   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostname in g#library
     1748     (input  obj-list.obj-type
     1749     ,input  obj-list.obj-code
     1750     ,output v-cntxt-host-code-obj
     1751     ,output v-cntxt-host-name-obj
     1752     )  .
     1753     end .
     1754     output stream OutStr-html to value(p-file-name-rep-htm) append convert target 'UTF-8'.
     1755     do:
     1756       put stream OutStr-html unformatted
     1757       "<!DOCTYPE HTML>" skip
     1758       ' <html>' skip
     1759       '  <head>' skip
     1760       '   <meta charset="utf-8">' skip
     1761       '    <style type="text/css">' skip
     1762       '      table ' + chr(123) + ' border-collapse: collapse; font-size: 9pt; table-layout: fixed; width: 1157px; padding: 14px; ' + chr(125) skip
     1763                   '      td ' + chr(123) ' border: 1px black ridge; word-wrap:break-word; ' + chr(125) skip
     1764                   '      htm' skip
     1765                   '      .rotate ' + chr(123) skip
     1766                   '        -webkit-transform: rotate(-90deg);' skip
     1767                   '        -moz-transform: rotate(-90deg);' skip
     1768                   '        -ms-transform: rotate(-90deg);' skip
     1769                   '        -o-transform: rotate(-90deg);' skip
     1770                   '        transform: rotate(-90deg);' skip
     1771                   '        -webkit-transform-origin: 50% 50%;' skip
     1772                   '        -moz-transform-origin: 50% 50%;' skip
     1773                   '        -ms-transform-origin: 50% 50%;' skip
     1774                   '        -o-transform-origin: 50% 50%;' skip
     1775                   '        transform-origin: 50% 50%;' skip
     1776                   '        filter: progid:DXImageTransform.Microsoft.BasicImage(rotation=3);' skip
     1777                   '          ' + chr(125) skip
     1778                   '            th' + ' ' + chr(123) skip
     1779                   '            border: 1px black solid;' skip
     1780                   '            word-wrap: break-word;' skip
     1781                   '          ' + chr(125) skip
     1782                   '   </style>' skip
     1783                   '  </head>' skip
     1784               .
     1785       end.
     1786    do:
     1787        put stream OutStr-html unformatted
     1788            ' <body>' skip
     1789            '   <table name="Лист1" fit_to_page="true" orientation="landscape" outline_below="false">' skip
     1790            '     <thead>' skip
     1791            '       <tr class="set_columns">' skip
     1792            '         <td style="width: 60px; border: none;"></td>' skip
     1793            '         <td style="width: 200px; border: none;"></td>' skip
     1794            '         <td style="width: 78px; border: none;"></td>' skip
     1795            '         <td style="width: 78px; border: none;"></td>' skip
     1796            '         <td style="width: 78px; border: none;"></td>' skip
