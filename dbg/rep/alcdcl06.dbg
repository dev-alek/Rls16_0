     2719           CHR(9)   buf_temp_sheet2_line-data.alctypename2
     2720           CHR(9)   buf_temp_sheet2_line-data.alctypecode2
     2721           CHR(9)   buf_temp_sheet2_line-data.ostbeg2
     2722           CHR(9)   buf_temp_sheet2_line-data.pritot2
     2723           CHR(9)   buf_temp_sheet2_line-data.proprod2
     2724           CHR(9)   buf_temp_sheet2_line-data.proiorg2
     2725           CHR(9)   buf_temp_sheet2_line-data.saletot2
     2726           CHR(9)   buf_temp_sheet2_line-data.salelocprod2
     2727           CHR(9)   buf_temp_sheet2_line-data.ostend2
     2728           chr(10)
