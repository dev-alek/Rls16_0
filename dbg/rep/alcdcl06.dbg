     2747   procedure alc06xl-write-cell-data :
     2748   define input parameter p-data-key   as character        no-undo.
     2749   define input parameter p-data-value as character        no-undo.
     2750       define buffer buf_temp_cell-data     for temp_cell-data.
     2751   do
     2752   for buf_temp_cell-data
     2753   on error undo, return error
     2754   :
     2755       find first buf_temp_cell-data
     2756            where buf_temp_cell-data.data-key = p-data-key
     2757       no-error.
     2758       if not available buf_temp_cell-data
     2759       then do:
     2760           create buf_temp_cell-data.
     2761           assign
     2762               buf_temp_cell-data.data-key = p-data-key
     2763           .
     2764       end.
     2765       assign
     2766           buf_temp_cell-data.data-value = p-data-value
     2767       .
     2768       put stream excel-cell unformatted
     2769                           buf_temp_cell-data.data-key
     2770           CHR(9)   buf_temp_cell-data.data-value
     2771           chr(10)
     2772       .
     2773   end.
     2774   end procedure.
     2775   procedure alc06xl-run-excel :
     2776   define input parameter p-header-filename    as character        no-undo.
     2777   define input parameter p-data-filename      as character        no-undo.
     2778       define variable v-Template-file-name    as character    no-undo.
     2779       define variable v-vb-file-name          as character    no-undo.
     2780       define buffer buf_temp-param for temp-param .
     2781   do
     2782   for buf_temp-param
     2783   on error undo, return error
     2784   :
     2785       create buf_temp-param.
     2786       assign
     2787           v-Template-file-name    = search( "exe/alcdcl06.xlt" )
     2788           v-vb-file-name          = search( "exe/t_form.bas")
     2789       .
     2790       if v-Template-file-name = ?
     2791       or v-Template-file-name = "":U
     2792       then do:
     2793           message
     2794               "Ошибка имени файла шаблона."
     2795           view-as alert-box error.
     2796       end.
     2797       if v-vb-file-name = ?
     2798       or v-vb-file-name = "":U
     2799       then do:
     2800           message
     2801               "Ошибка имени файла кода обработки."
     2802           view-as alert-box error.
     2803       end.
     2804       run paramls-write in this-procedure (
     2805             input "template":U
     2806           , input "template-file-name":U
     2807           , input v-Template-file-name
     2808       ).
     2809       run paramls-write in this-procedure (
     2810             input "template":U
     2811           , input "vb-file-name":U
     2812           , input v-vb-file-name
     2813       ).
     2814       run paramls-write in this-procedure (
     2815             input "data":U
     2816           , input "data-header-filename":U
     2817           , input p-header-filename
     2818       ).
     2819       run paramls-write in this-procedure (
     2820             input "data":U
     2821           , input "data-filename":U
     2822           , input p-data-filename
     2823       ).
     2824       run gbl/macroxlt.p (
     2825           input-output table buf_temp-param
     2826       ) no-error.
     2827       if error-status :error
     2828       then do:
     2829           message
     2830                    vss-workfile vss-revision vss-description
     2831               skip(1)
     2832               skip "Ошибка создания файла Excel."
     2833               skip return-value
     2834               skip trim(error-status :get-message(1))
     2835                    trim(error-status :get-message(2))
     2836                    trim(error-status :get-message(3))
     2837           view-as alert-box error.
     2838           undo, return error .
     2839       end.
     2840   end.
     2841   end procedure.
     2842   procedure alc06xl-close :
     2843   do
     2844   on error undo, return error
     2845   :
     2846       output stream excel-line close.
     2847       output stream excel-cell close.
     2848       output to value( string( session:temp-directory + "$" + string( g#report-num ) ) + ".txl" ) append.
     2849           export "exe/alcdcl06.xlt":U.
     2850           export "exe/t_form.bas":U.
     2851           export v-alc06xl-cell-file-name.
     2852           export v-alc06xl-data-file-name.
     2853       output close.
     2854   end.
     2855   end procedure.
