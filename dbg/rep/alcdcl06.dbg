     3911   procedure load-head-info :
     3912   define buffer buf_alc-sale-lic  for ub.alc-sale-lic.
     3913   define buffer buf_obj-list      for obj-list.
     3914   do for
     3915   buf_obj-list,
     3916   buf_alc-sale-lic
     3917   on error undo, return error return-value
     3918   :
     3919     define variable v-i as integer   no-undo .
     3920     find first buf_alc-sale-lic no-lock
     3921       where buf_alc-sale-lic.cli-type   = 'орг':U
     3922         and buf_alc-sale-lic.cli-code   = v-host-code
     3923         and buf_alc-sale-lic.date-from  < v-begin-date
     3924         and buf_alc-sale-lic.date-to    > v-end-date
     3925     no-error .
     3926     if not available buf_alc-sale-lic
     3927     then do:
     3928       find first buf_alc-sale-lic no-lock
     3929         where buf_alc-sale-lic.cli-type = 'орг':U
     3930           and buf_alc-sale-lic.cli-code = v-host-code
     3931           and buf_alc-sale-lic.date-to  > v-end-date
     3932       no-error .
     3933     end.
     3934     if available buf_alc-sale-lic
     3935     then do:
     3936       assign
     3937         v-lic-info = substitute( "&1 рег. №&2 от &3 г."
     3938                                , buf_alc-sale-lic.seria
     3939                                , buf_alc-sale-lic.number
     3940                                , string(buf_alc-sale-lic.date-get, "99.99.99":U)
     3941                                )
     3942       .
     3943     end.
     3944     else do:
     3945       assign
     3946         v-lic-info = '?':U
     3947       .
     3948     end.
     3949     for each buf_obj-list :
     3950       assign
     3951         v-i = v-i + 1
     3952       .
     3953     end.
     3954     run fmtcli-get-client in this-procedure ( input 'орг':U , v-host-code ) .
     3955     assign
     3956       v-firm-name     = v-fmtcli-name
     3957       v-firm-inn      = v-fmtcli-inn
     3958       v-firm-address  = v-fmtcli-addres
     3959       v-obj-count     = string(v-i)
     3960       v-activity      = "Розничная продажа алкогольной продукции":U
     3961       v-date-range    = substitute( " с &1 по &2"
     3962                                   , string( v-begin-date, "99.99.99":U)
     3963                                   , string( v-end-date  , "99.99.99":U)
     3964                                   )
     3965     .
     3966   end.
     3967   end procedure.
