     2706           buf_temp_sheet2_line-data.alctypecode2  = p-alctypecode2
     2707           buf_temp_sheet2_line-data.ostbeg2       = p-ostbeg2
     2708           buf_temp_sheet2_line-data.pritot2       = p-pritot2
     2709           buf_temp_sheet2_line-data.proprod2      = p-proprod2
     2710           buf_temp_sheet2_line-data.proiorg2      = p-proiorg2
