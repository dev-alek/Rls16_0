     2530   procedure alc06xl-init :
     2531   do
     2532   on error undo, return error
     2533   :
     2534       assign
     2535           v-alc06xl-sheet1-cur-data-row = 0
     2536           v-alc06xl-sheet2-cur-data-row = 0
     2537       .
     2538       run gbl/_tmpfile.p (
     2539             input "xd"
     2540           , input ".txt"
     2541           , output v-alc06xl-data-file-name
     2542       ).
     2543       output stream excel-line to value( v-alc06xl-data-file-name ).
     2544       run gbl/_tmpfile.p (
     2545             input "xc"
     2546           , input ".txt"
     2547           , output v-alc06xl-cell-file-name
     2548       ).
     2549       output stream excel-cell to value( v-alc06xl-cell-file-name ).
     2550       run alc06xl-write-cell-data in this-procedure (
     2551             input "sheetList":U
     2552           , input "Закупка,Продажа":U
     2553       ).
     2554       if printrubl
     2555       then do:
     2556           run alc06xl-write-cell-data in this-procedure (
     2557                 input "Закупка_valutCode":U
     2558               , input "0":U
     2559           ).
     2560       end.
     2561       else do:
     2562           run alc06xl-write-cell-data in this-procedure (
     2563                 input "Закупка_valutCode":U
     2564               , input "1":U
     2565           ).
     2566       end.
     2567       run alc06xl-write-cell-data in this-procedure (
     2568             input "Закупка_columnList":U
     2569           , input "npp,alctypename,alctypecode,cliname,cliinn,cliaddress,licnum,licgive,quantity":U
     2570       ).
     2571       run alc06xl-write-cell-data in this-procedure (
     2572             input "Закупка_columnType":U
     2573           , input "S,S,S,S,S,S,S,S,S":U
     2574       ).
     2575       run alc06xl-write-cell-data in this-procedure (
     2576             input "Закупка_subtotalList":U
     2577           , input "":U
     2578       ).
     2579       run alc06xl-write-cell-data in this-procedure (
     2580             input "Закупка_subtotalType":U
     2581           , input "":U
     2582       ).
     2583       if printrubl
     2584       then do:
     2585           run alc06xl-write-cell-data in this-procedure (
     2586                 input "Продажа_valutCode":U
     2587               , input "0":U
     2588           ).
     2589       end.
     2590       else do:
     2591           run alc06xl-write-cell-data in this-procedure (
     2592                 input "Продажа_valutCode":U
     2593               , input "1":U
     2594           ).
     2595       end.
     2596       run alc06xl-write-cell-data in this-procedure (
     2597             input "Продажа_columnList":U
     2598           , input "npp2,alctypename2,alctypecode2,ostbeg2,pritot2,proprod2,proiorg2,saletot2,salelocprod2,ostend2":U
     2599       ).
     2600       run alc06xl-write-cell-data in this-procedure (
     2601             input "Продажа_columnType":U
     2602           , input "S,S,S,S,S,S,S,S,S,S":U
     2603       ).
     2604       run alc06xl-write-cell-data in this-procedure (
     2605             input "Продажа_subtotalList":U
     2606           , input "":U
     2607       ).
     2608       run alc06xl-write-cell-data in this-procedure (
     2609             input "Продажа_subtotalType":U
     2610           , input "":U
     2611       ).
     2612   end.
     2613   end procedure.
     2614   procedure alc06xl-sheet1-write-line-data :
     2615     define input parameter p-npp           as character  no-undo .
     2616     define input parameter p-alctypename   as character  no-undo .
     2617     define input parameter p-alctypecode   as character  no-undo .
     2618     define input parameter p-cliname       as character  no-undo .
     2619     define input parameter p-cliinn        as character  no-undo .
     2620     define input parameter p-cliaddress    as character  no-undo .
     2621     define input parameter p-licnum        as character  no-undo .
     2622     define input parameter p-licgive       as character  no-undo .
     2623     define input parameter p-quantity      as character  no-undo .
     2624   define buffer buf_temp_sheet1_line-data  for temp_sheet1_line-data.
     2625   do
     2626   for buf_temp_sheet1_line-data
     2627   on error undo, return error
     2628   :
     2629       for each buf_temp_sheet1_line-data
     2630       :
     2631           delete buf_temp_sheet1_line-data.
     2632       end.
     2633       create buf_temp_sheet1_line-data.
     2634       assign
     2635           v-alc06xl-sheet1-cur-data-row         = v-alc06xl-sheet1-cur-data-row + 1
     2636           buf_temp_sheet1_line-data.sheet-name  = "Закупка":U
     2637           buf_temp_sheet1_line-data.xl-line-id  = v-alc06xl-sheet1-cur-data-row
     2638           buf_temp_sheet1_line-data.npp         = p-npp
     2639           buf_temp_sheet1_line-data.alctypename = p-alctypename
     2640           buf_temp_sheet1_line-data.alctypecode = p-alctypecode
     2641           buf_temp_sheet1_line-data.cliname     = p-cliname
     2642           buf_temp_sheet1_line-data.cliinn      = p-cliinn
     2643           buf_temp_sheet1_line-data.cliaddress  = p-cliaddress
     2644           buf_temp_sheet1_line-data.licnum      = p-licnum
     2645           buf_temp_sheet1_line-data.licgive     = p-licgive
     2646           buf_temp_sheet1_line-data.quantity    = p-quantity
     2647       .
     2648       put stream excel-line unformatted
     2649                           buf_temp_sheet1_line-data.sheet-name
     2650           CHR(9)   "DTA":U
     2651           CHR(9)   buf_temp_sheet1_line-data.npp
     2652           CHR(9)   buf_temp_sheet1_line-data.alctypename
     2653           CHR(9)   buf_temp_sheet1_line-data.alctypecode
     2654           CHR(9)   buf_temp_sheet1_line-data.cliname
     2655           CHR(9)   buf_temp_sheet1_line-data.cliinn
     2656           CHR(9)   buf_temp_sheet1_line-data.cliaddress
     2657           CHR(9)   buf_temp_sheet1_line-data.licnum
     2658           CHR(9)   buf_temp_sheet1_line-data.licgive
     2659           CHR(9)   buf_temp_sheet1_line-data.quantity
     2660           chr(10)
     2661       .
     2662   end.
     2663   end procedure.
     2664   procedure alc06xl-sheet1-write-line-format :
     2665   define input parameter p-fmt-label       as character  no-undo.
     2666       define buffer buf_temp_sheet1_line-data        for temp_sheet1_line-data.
