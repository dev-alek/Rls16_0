     2385   def var vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2386   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     2387   procedure paramls-clear :
     2388     define buffer buf_temp-param for temp-param .
     2389     do
     2390     on error undo, return error return-value
     2391     :
     2392       for each buf_temp-param
     2393       on error undo, return error
     2394       :
     2395         delete buf_temp-param .
     2396       end.
     2397     end.
     2398   end procedure.
     2399   procedure paramls-write :
     2400     define input  parameter p-code     as character no-undo .
     2401     define input  parameter p-sub-code as character no-undo .
     2402     define input  parameter p-value    as character no-undo .
     2403     define buffer buf_temp-param for temp-param .
     2404     do
     2405     on error undo, return error return-value
     2406     :
     2407       find first buf_temp-param
     2408         where buf_temp-param.param-code     = p-code
     2409           and buf_temp-param.param-sub-code = p-sub-code
     2410         no-error .
     2411       if not available buf_temp-param then do:
     2412         create buf_temp-param .
     2413         assign
     2414           buf_temp-param.param-code     = p-code
     2415           buf_temp-param.param-sub-code = p-sub-code
     2416         .
     2417       end.
     2418       assign
     2419         buf_temp-param.param-value = p-value
     2420       .
     2421     end.
     2422   end procedure.
     2423   procedure paramls-read :
     2424     define input  parameter p-code          as character no-undo .
     2425     define input  parameter p-sub-code      as character no-undo .
     2426     define input  parameter p-default-value as character no-undo .
     2427     define output parameter p-value         as character no-undo .
     2428     define buffer buf_temp-param for temp-param .
     2429     do
     2430     on error undo, return error return-value
     2431     :
     2432       find first buf_temp-param
     2433         where buf_temp-param.param-code     = p-code
     2434           and buf_temp-param.param-sub-code = p-sub-code
     2435         no-error .
     2436       if available buf_temp-param then do:
     2437         assign
     2438           p-value = buf_temp-param.param-value
     2439         .
     2440       end.
     2441       else do:
     2442         assign
     2443           p-value = p-default-value
     2444         .
     2445       end.
     2446     end.
     2447   end procedure.
     2448   procedure paramls-append :
     2449     define input  parameter p-code     as character no-undo .
     2450     define input  parameter p-sub-code as character no-undo .
     2451     define input  parameter p-value    as character no-undo .
     2452     define buffer buf_temp-param for temp-param .
     2453     do
     2454     on error undo, return error return-value
     2455     :
     2456       find first buf_temp-param
     2457            where buf_temp-param.param-code     = p-code
     2458              and buf_temp-param.param-sub-code = p-sub-code
     2459         no-error .
     2460       if not available buf_temp-param then do:
     2461         create buf_temp-param .
     2462         assign
     2463           buf_temp-param.param-code     = p-code
     2464           buf_temp-param.param-sub-code = p-sub-code
     2465           buf_temp-param.param-value    = p-value
     2466         .
     2467       end.
     2468       else do:
     2469           assign
     2470               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     2471           .
     2472       end.
     2473     end.
     2474   end procedure.
     2475   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2476   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2477   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
