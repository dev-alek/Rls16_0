     2932   define variable v-gds-count               as integer    no-undo .
     2933   define variable v-fact-order-start        as decimal    no-undo .
     2934   define variable v-fact-order-end          as decimal    no-undo .
     2935   define variable v-firm-name     as character no-undo .
     2936   define variable v-firm-inn      as character no-undo .
     2937   define variable v-firm-address  as character no-undo .
     2938   define variable v-obj-count     as character no-undo .
     2939   define variable v-lic-info      as character no-undo .
     2940   define variable v-activity      as character no-undo .
     2941   define variable v-date-range    as character no-undo .
     2942   main-block:
     2943   do
     2944   on error undo, return error return-value
     2945   :
     2946   if session :set-wait-state( "compiler" ) then.
     2947   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2948     define variable v-cntxt-db-num        as integer   no-undo .
     2949     define variable v-cntxt-userid        as character no-undo .
     2950     define variable v-cntxt-level         as character no-undo .
     2951     define variable v-cntxt-host-code-obj as integer   no-undo .
     2952     define variable v-cntxt-obj-type      as character no-undo .
     2953     define variable v-cntxt-obj-code      as integer   no-undo .
     2954     define variable v-cntxt-db-num-obj    as integer   no-undo .
     2955     define variable v-cntxt-is-admin      as logical   no-undo .
     2956   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2957     run mainmenu_getcntxt in my-handle
     2958       (output v-cntxt-db-num
     2959       ,output v-cntxt-userid
     2960       ,output v-cntxt-level
     2961       ,output v-cntxt-host-code-obj
     2962       ,output v-cntxt-obj-type
     2963       ,output v-cntxt-obj-code
     2964       ,output v-cntxt-db-num-obj
     2965       ,output v-cntxt-is-admin
     2966       ) .
     2967   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2968   empty temp-table thbjattr_thbj-attr.
     2969   run adm/shattri.p (
     2970      input "get":U
     2971     ,input ''
     2972     ,input 0
     2973     ,input 'report-glob':U
     2974     ,input  ""
     2975     ,output v-value-character
     2976     ,output v-value-date
     2977     ,output v-value-decimal
     2978     ,output v-value-integer
     2979     ,output v-value-logical
     2980     ,output par-type
     2981     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     2982     ) no-error .
     2983     for each thbjattr_thbj-attr :
     2984         if thbjattr_thbj-attr.prop-code = 'ardecldt' then v-begin-date = thbjattr_thbj-attr.property-value-date .
     2985     end.
     2986     find first obj-list no-lock no-error .
     2987     if not available obj-list then do:
     2988       message
     2989         "Нет ни одного объекта для формирования отчета!"
     2990       view-as alert-box error.
     2991       return error return-value.
     2992     end.
     2993   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2994   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2995     (input  obj-list.obj-type
     2996     ,input  obj-list.obj-code
     2997     ,output v-host-code
     2998     )  .
     2999     for each obj-list :
     3000   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3001   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3002     (input  obj-list.obj-type
     3003     ,input  obj-list.obj-code
     3004     ,output v-host-code-2
     3005     )  .
     3006       if v-host-code <> v-host-code-2 then do:
     3007         message
     3008           "Отчет формируется только по объектам одной фирмы."
     3009         view-as alert-box error.
     3010         return error return-value.
     3011       end.
     3012     end.
     3013     run alc06xl-init in this-procedure .
     3014   output stream out-stream to value( string( session:temp-directory +
     3015                                        "rpt" + string( g#report-num ) ) )
     3016                                        page-size  value(43) .
     3017     put stream out-stream "Отчет выводится только в Excel..." skip.
     3018     assign
     3019       v-end-date    = x-Date-Alone
     3020       v-line        = fill( "-" , 300 )
     3021     .
     3022     run day-begin-fact-order in this-procedure ( input v-begin-date, output v-fact-order-start ).
     3023     run day-begin-fact-order in this-procedure ( input ( v-end-date + 1 ),   output v-fact-order-end ).
     3024     run clear-all in this-procedure .
     3025     run prg-bar_init-cb-handle in this-procedure (v-d-report-handle) .
     3026     run find-alc-goods in this-procedure ( output v-gds-count ).
     3027     run fill-tt-alc-pri in this-procedure .
     3028     run fill-tt-alc-retail in this-procedure .
     3029     run load-head-info in this-procedure .
     3030     run print-alc-pri in this-procedure .
     3031     run print-alc-retail in this-procedure .
     3032     output stream out-stream close.
     3033     if Make-Excel then output stream ForExcel close.
     3034     run alc06xl-close in this-procedure .
     3035   if session :set-wait-state( "" ) then.
     3036     run clear-all in this-procedure .
     3037     os-delete value( string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )  .
     3038     os-rename
     3039       value( string( session:temp-directory ) + "$" + string( g#report-num ) + ".txl" )
     3040       value( string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )
     3041     .
     3042     define variable v-user-action   as character no-undo .
     3043     define variable v-printed       as logical   no-undo .
     3044     run gbl/prnfilen.w
     3045         (input  ""
     3046         ,input  20
     3047         ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
     3048         ,input  ReportFontNum
     3049         ,output v-user-action
     3050         ,output v-printed
     3051         ) .
     3052     os-delete value( string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )  .
     3053   end.
     3054   procedure clear-all :
     3055   do
     3056   on error undo, return error return-value
     3057   :
     3058     empty temp-table tt-gds.
     3059     empty temp-table tt-alc-pri.
     3060     empty temp-table tt-alc-pri-tmp.
     3061     empty temp-table tt-alc-retail.
     3062   end.
     3063   end procedure.
     3064   procedure find-alc-goods :
     3065     define output parameter p-gds-count as integer   no-undo .
     3066   do
     3067   on error undo, return error return-value
     3068   :
     3069     define buffer buf_alc-type      for ub.alc-type.
     3070     define buffer buf_alc-type-gds  for ub.alc-type-gds.
     3071     define buffer buf_goods         for ub.goods.
     3072     define variable v-gds-type as integer   no-undo .
     3073     empty temp-table tt-gds.
     3074     for each buf_alc-type no-lock
     3075           where buf_alc-type.alc-type-status = 0
     3076     :
     3077       _gds:
     3078       for each buf_alc-type-gds no-lock
     3079             where buf_alc-type-gds.alc-type-inner-code = buf_alc-type.alc-type-inner-code
     3080               AND buf_alc-type-gds.create-user-db-num  = buf_alc-type.create-user-db-num
     3081         , first buf_goods no-lock
     3082             where buf_goods.gds-code = buf_alc-type-gds.gds-code
     3083       :
     3084         find first tt-gds no-lock where tt-gds.gds-code = buf_goods.gds-code no-error .
     3085         if not available tt-gds then do:
     3086           create tt-gds.
     3087           buffer-copy buf_goods to tt-gds
     3088           assign
     3089             tt-gds.alc-type-inner-code = buf_alc-type.alc-type-inner-code
     3090             tt-gds.create-user-db-num  = buf_alc-type.create-user-db-num
     3091             tt-gds.alc-type-code       = buf_alc-type.alc-type-code
     3092             tt-gds.alc-type-name       = buf_alc-type.alc-type-name
     3093             v-alc-type-count           = v-alc-type-count + 1
     3094             p-gds-count                = p-gds-count + 1
     3095           .
     3096         end.
     3097       end.
     3098     end.
     3099   end.
     3100   end procedure.
     3101   procedure fill-tt-alc-pri :
     3102   do
     3103   on error undo, return error return-value
     3104   :
     3105     define buffer buf_doc-line    for ub.doc-line.
     3106     define buffer buf_trn-doc     for ub.trn-doc.
     3107     define buffer buf_parts       for ub.parts.
     3108     define buffer buf_clients     for ub.clients.
     3109     define buffer buf_tt-gds          for tt-gds.
     3110     define buffer buf_tt-alc-pri      for tt-alc-pri.
     3111     define buffer buf_tt-alc-pri-tmp  for tt-alc-pri-tmp.
     3112     define variable v-sert            as character no-undo .
     3113     define variable v-sert-give       as character no-undo .
     3114     run prg-bar_new in this-procedure (1 , v-gds-count).
     3115     run prg-bar_title in this-procedure ( input substitute( "Обработка документов типа: &1...":U
     3116                                                           ,
     3117                                                           entry(lookup('ie':U, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U), 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U)
     3118                                                           )
     3119                                         ).
     3120     run prg-bar_show in this-procedure .
     3121     for each buf_tt-gds
     3122     :
     3123       run prg-bar_increment in this-procedure .
     3124       for each obj-list no-lock
     3125       :
     3126         for each buf_doc-line no-lock
     3127           where buf_doc-line.artic        = buf_tt-gds.artic
     3128             and buf_doc-line.prod-type    = buf_tt-gds.prod-type
     3129             and buf_doc-line.prod-code    = buf_tt-gds.prod-code
     3130             and buf_doc-line.obj-type     = obj-list.obj-type
     3131             and buf_doc-line.obj-code     = obj-list.obj-code
     3132             and buf_doc-line.status_      = 'факт':U
     3133             and buf_doc-line.ext-doc-type = 'ie':U
     3134             and buf_doc-line.fact-order   >= v-fact-order-start
     3135             and buf_doc-line.fact-order   <  v-fact-order-end,
     3136           first buf_trn-doc no-lock
     3137             where buf_trn-doc.doc-code    = buf_doc-line.doc-code
     3138         :
     3139           find first buf_tt-alc-pri-tmp
     3140             where buf_tt-alc-pri-tmp.alc-type-inner-code = buf_tt-gds.alc-type-inner-code
     3141               and buf_tt-alc-pri-tmp.cli-type            = buf_trn-doc.cli-type
     3142               and buf_tt-alc-pri-tmp.cli-code            = buf_trn-doc.cli-code
     3143               and buf_tt-alc-pri-tmp.doc-code            = buf_trn-doc.doc-code
     3144               and buf_tt-alc-pri-tmp.gds-code            = buf_tt-gds.gds-code
     3145           no-error .
     3146           if not available buf_tt-alc-pri-tmp
     3147           then do:
     3148             create buf_tt-alc-pri-tmp.
     3149             assign
     3150               buf_tt-alc-pri-tmp.alc-type-inner-code  = buf_tt-gds.alc-type-inner-code
     3151               buf_tt-alc-pri-tmp.alc-type-code        = buf_tt-gds.alc-type-code
     3152               buf_tt-alc-pri-tmp.alc-type-name        = buf_tt-gds.alc-type-name
     3153               buf_tt-alc-pri-tmp.cli-type             = buf_trn-doc.cli-type
     3154               buf_tt-alc-pri-tmp.cli-code             = buf_trn-doc.cli-code
     3155               buf_tt-alc-pri-tmp.doc-code             = buf_trn-doc.doc-code
     3156               buf_tt-alc-pri-tmp.gds-code             = buf_tt-gds.gds-code
     3157               buf_tt-alc-pri-tmp.quantity             = ( buf_doc-line.fact-qnty * buf_tt-gds.ms-base / 10 )
     3158             .
     3159           end.
     3160         end.
     3161       end.
     3162     end.
     3163     run prg-bar_delete in this-procedure .
     3164     run calc-ext-type-pri in this-procedure ( input 'iv':U    ) .
     3165     run calc-ext-type-pri in this-procedure ( input 'rv':U) .
     3166     for each buf_tt-alc-pri-tmp
     3167       break by buf_tt-alc-pri-tmp.cli-type
     3168             by buf_tt-alc-pri-tmp.cli-code
     3169             by buf_tt-alc-pri-tmp.alc-type-code
     3170     :
     3171       find first buf_tt-alc-pri
     3172         where buf_tt-alc-pri.alc-type-code  = buf_tt-alc-pri-tmp.alc-type-code
     3173           and buf_tt-alc-pri.cli-type       = buf_tt-alc-pri-tmp.cli-type
     3174           and buf_tt-alc-pri.cli-code       = buf_tt-alc-pri-tmp.cli-code
     3175       no-error .
     3176       if    first-of(buf_tt-alc-pri-tmp.cli-type)
     3177         or  first-of(buf_tt-alc-pri-tmp.cli-code)
     3178         or  first-of(buf_tt-alc-pri-tmp.alc-type-code)
     3179       then do:
     3180         if     first-of(buf_tt-alc-pri-tmp.cli-type)
     3181            or  first-of(buf_tt-alc-pri-tmp.cli-code)
     3182         then do:
     3183           run fmtcli-get-client in this-procedure ( input buf_tt-alc-pri-tmp.cli-type, input buf_tt-alc-pri-tmp.cli-code ) .
     3184           run find-sert in this-procedure ( input buf_tt-alc-pri-tmp.cli-type
     3185                                           , input buf_tt-alc-pri-tmp.cli-code
     3186                                           , input buf_tt-alc-pri-tmp.alc-type-inner-code
     3187                                           , output v-sert
     3188                                           , output v-sert-give ) .
     3189         end.
     3190         if not available buf_tt-alc-pri
     3191         then do:
     3192           create buf_tt-alc-pri.
     3193           assign
     3194             buf_tt-alc-pri.alc-type-code  = buf_tt-alc-pri-tmp.alc-type-code
     3195             buf_tt-alc-pri.alc-type-name  = buf_tt-alc-pri-tmp.alc-type-name
     3196             buf_tt-alc-pri.cli-type       = buf_tt-alc-pri-tmp.cli-type
     3197             buf_tt-alc-pri.cli-code       = buf_tt-alc-pri-tmp.cli-code
     3198             buf_tt-alc-pri.cli-name       = v-fmtcli-name
     3199             buf_tt-alc-pri.cli-inn        = v-fmtcli-inn
     3200             buf_tt-alc-pri.cli-address    = v-fmtcli-addres
     3201             buf_tt-alc-pri.lic-num        = v-sert
     3202             buf_tt-alc-pri.lic-give       = v-sert-give
     3203           .
     3204         end.
     3205       end.
     3206       assign
     3207         buf_tt-alc-pri.quantity = buf_tt-alc-pri.quantity + buf_tt-alc-pri-tmp.quantity
     3208       .
     3209     end.
     3210   end.
     3211   end procedure.
     3212   procedure calc-ext-type-pri :
     3213     define input  parameter p-ext-doc-type as character no-undo .
     3214   do
     3215   on error undo, return error return-value
     3216   :
     3217     define buffer buf_doc-line  for ub.doc-line .
     3218     define buffer buf_parts     for ub.parts .
     3219     define buffer buf_trn-doc   for ub.trn-doc .
     3220     define buffer sch_trn-doc   for ub.trn-doc.
     3221     define buffer buf_obj-list        for obj-list.
     3222     define buffer buf_tt-gds          for tt-gds.
     3223     define buffer buf_tt-alc-pri-tmp  for tt-alc-pri-tmp.
     3224     define variable v-income-doc-code as character no-undo .
     3225     define variable v-ext-doc-type    like ub.parts-attr.ext-doc-type no-undo .
     3226     define variable v-obj-type        like ub.parts-attr.obj-type     no-undo .
     3227     define variable v-obj-code        like ub.parts-attr.obj-code     no-undo .
     3228     define variable v-supp-type       like ub.parts-attr.supp-type    no-undo .
     3229     define variable v-supp-code       like ub.parts-attr.supp-code    no-undo .
     3230     define variable v-fact-order      like ub.parts-attr.fact-order   no-undo .
     3231     run prg-bar_new in this-procedure (1 , v-gds-count).
     3232     run prg-bar_title in this-procedure ( input substitute( "Обработка документов типа: &1...":U
     3233                                                           ,
     3234                                                           entry(lookup(p-ext-doc-type, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U), 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U)
     3235                                                           )
     3236                                         ).
     3237     run prg-bar_show in this-procedure .
     3238     for each buf_tt-gds
     3239     :
     3240       run prg-bar_increment in this-procedure .
     3241       for each obj-list no-lock
     3242       :
     3243         for each buf_doc-line no-lock
     3244           where buf_doc-line.artic      = buf_tt-gds.artic
     3245             and buf_doc-line.prod-type  = buf_tt-gds.prod-type
     3246             and buf_doc-line.prod-code  = buf_tt-gds.prod-code
     3247             and buf_doc-line.obj-type   = obj-list.obj-type
     3248             and buf_doc-line.obj-code   = obj-list.obj-code
     3249             and buf_doc-line.status_    = 'факт':U
     3250             and buf_doc-line.ext-doc-type = p-ext-doc-type
     3251             and buf_doc-line.fact-order >= v-fact-order-start
     3252             and buf_doc-line.fact-order <  v-fact-order-end
     3253         :
     3254             parts-cycle:
     3255             for each buf_parts no-lock
     3256               where buf_parts.out-code  = buf_doc-line.doc-code
     3257                 and buf_parts.obj-type  = obj-list.obj-type
     3258                 and buf_parts.obj-code  = obj-list.obj-code
     3259                 and buf_parts.artic     = buf_doc-line.artic
     3260                 and buf_parts.prod-type = buf_doc-line.prod-type
     3261                 and buf_parts.prod-code = buf_doc-line.prod-code
     3262             :
     3263               run find-income-doc-code in this-procedure ( input buf_parts.in-code
     3264                                                         , input buf_tt-gds.gds-code
     3265                                                         , input buf_parts.part-code
     3266                                                         , output v-income-doc-code
     3267                                                          , output v-ext-doc-type
     3268                                                          , output v-fact-order
     3269                                                          , output v-obj-type
     3270                                                          , output v-obj-code
     3271                                                          , output v-supp-type
     3272                                                          , output v-supp-code
     3273                                                         ).
     3274               if v-income-doc-code = ?
     3275               then do:
     3276                 message
     3277                   substitute("Не могу найти приходную накладную с номером: &1", buf_parts.in-code) skip
     3278                   "Отчет будет сформирован некорректно":U
     3279                 view-as alert-box error .
     3280                 next parts-cycle.
     3281               end.
     3282               if    v-ext-doc-type = 'ie':U
     3283                 and v-fact-order   >= v-fact-order-start
     3284                 and v-fact-order   <  v-fact-order-end
     3285               then do:
     3286                 find first buf_obj-list no-lock
     3287                   where buf_obj-list.obj-type = v-obj-type
     3288                     and buf_obj-list.obj-code = v-obj-code
     3289                 no-error .
     3290                 if available buf_obj-list then do :
     3291                   next parts-cycle.
     3292                 end.
     3293               end.
     3294               find first buf_tt-alc-pri-tmp
     3295                 where buf_tt-alc-pri-tmp.alc-type-inner-code = buf_tt-gds.alc-type-inner-code
     3296                   and buf_tt-alc-pri-tmp.cli-type            = v-supp-type
     3297                   and buf_tt-alc-pri-tmp.cli-code            = v-supp-code
     3298                   and buf_tt-alc-pri-tmp.doc-code            = v-income-doc-code
     3299                   and buf_tt-alc-pri-tmp.gds-code            = buf_tt-gds.gds-code
     3300               no-error .
     3301               if not available buf_tt-alc-pri-tmp
     3302               then do:
     3303                 create buf_tt-alc-pri-tmp.
     3304                 assign
     3305                   buf_tt-alc-pri-tmp.alc-type-inner-code = buf_tt-gds.alc-type-inner-code
     3306                   buf_tt-alc-pri-tmp.alc-type-code       = buf_tt-gds.alc-type-code
     3307                   buf_tt-alc-pri-tmp.alc-type-name        = buf_tt-gds.alc-type-name
     3308                   buf_tt-alc-pri-tmp.cli-type            = v-supp-type
     3309                   buf_tt-alc-pri-tmp.cli-code            = v-supp-code
     3310                   buf_tt-alc-pri-tmp.doc-code            = v-income-doc-code
     3311                   buf_tt-alc-pri-tmp.gds-code            = buf_tt-gds.gds-code
     3312                 .
     3313               end.
     3314               assign
     3315                 buf_tt-alc-pri-tmp.quantity = buf_tt-alc-pri-tmp.quantity + ( buf_parts.fact-qnty * buf_tt-gds.ms-base / 10 )
     3316               .
     3317             end.
     3318         end.
     3319       end.
     3320     end.
     3321     run prg-bar_delete in this-procedure .
     3322   end.
     3323   end procedure.
     3324   procedure find-income-doc-code :
     3325     define input  parameter p-in-code         like ub.parts.in-code           no-undo .
     3326     define input  parameter p-gds-code        like ub.goods.gds-code          no-undo .
     3327     define input  parameter p-part-code       like ub.parts.part-code         no-undo .
     3328     define output parameter p-income-doc-code like ub.parts.in-code           no-undo .
     3329     define output parameter p-ext-doc-type    like ub.parts-attr.ext-doc-type no-undo .
     3330     define output parameter p-fact-order      like ub.parts-attr.fact-order   no-undo .
     3331     define output parameter p-obj-type        like ub.parts-attr.obj-type     no-undo .
     3332     define output parameter p-obj-code        like ub.parts-attr.obj-code     no-undo .
     3333     define output parameter p-supp-type       like ub.parts-attr.supp-type    no-undo .
     3334     define output parameter p-supp-code       like ub.parts-attr.supp-code    no-undo .
     3335   define buffer buf_parts-attr        for ub.parts-attr .
     3336   define buffer buf_income_parts-attr for ub.parts-attr .
     3337   do on error undo, return error return-value :
     3338     assign
     3339       p-income-doc-code = ?
     3340       p-ext-doc-type    = ?
     3341       p-fact-order      = ?
     3342       p-obj-type        = ?
     3343       p-obj-code        = ?
     3344       p-supp-type       = ?
     3345       p-supp-code       = ?
     3346     .
     3347     find first buf_parts-attr no-lock
     3348       where buf_parts-attr.in-code   = p-in-code
     3349         and buf_parts-attr.gds-code  = p-gds-code
     3350         and buf_parts-attr.part-code = p-part-code
     3351     no-error .
     3352     if available buf_parts-attr
     3353     then do:
     3354       find first buf_income_parts-attr no-lock
     3355         where buf_income_parts-attr.in-code   = buf_parts-attr.income-in-code
     3356           and buf_income_parts-attr.gds-code  = buf_parts-attr.income-gds-code
     3357           and buf_income_parts-attr.part-code = buf_parts-attr.income-part-code
     3358         no-error .
     3359       if available buf_income_parts-attr
     3360       then do:
     3361         assign
     3362           p-income-doc-code = buf_parts-attr.income-in-code
     3363           p-ext-doc-type    = buf_parts-attr.ext-doc-type
     3364           p-fact-order      = buf_parts-attr.fact-order
     3365           p-obj-type        = buf_parts-attr.obj-type
     3366           p-obj-code        = buf_parts-attr.obj-code
     3367           p-supp-type       = buf_parts-attr.supp-type
     3368           p-supp-code       = buf_parts-attr.supp-code
     3369         .
     3370       end.
     3371       else do:
     3372         return .
     3373       end.
     3374     end.
     3375     else do:
     3376       return .
     3377     end.
     3378   end.
     3379   end procedure.
     3380   procedure find-sert :
     3381     define input  parameter p-cli-type            like ub.trn-doc.cli-type no-undo .
     3382     define input  parameter p-cli-code            like ub.trn-doc.cli-code no-undo .
     3383     define input  parameter p-alc-type-inner-code like ub.alc-type.alc-type-inner-code no-undo .
     3384     define output parameter p-sert      as character          no-undo .
     3385     define output parameter p-sert-give as character          no-undo .
     3386   define buffer buf_alc-supp-lic      for ub.alc-supp-lic.
     3387   define buffer buf_alc-supp-lic-type for ub.alc-supp-lic-type.
     3388   do
     3389   on error undo, return error return-value
     3390   :
     3391     assign
     3392       p-sert       = "":U
     3393       p-sert-give  = "":U
     3394     .
     3395     for each buf_alc-supp-lic no-lock
     3396       where buf_alc-supp-lic.cli-type = p-cli-type
     3397         and buf_alc-supp-lic.cli-code = p-cli-code
     3398         and buf_alc-supp-lic.date-to  > v-end-date
     3399     :
     3400       if buf_alc-supp-lic.all-type = 0
     3401       then do:
     3402         find first buf_alc-supp-lic-type no-lock
     3403           where buf_alc-supp-lic-type.alc-supp-lic-code   = buf_alc-supp-lic.alc-supp-lic-code
     3404             and buf_alc-supp-lic-type.alc-type-inner-code = p-alc-type-inner-code
     3405         no-error.
     3406         if not available buf_alc-supp-lic-type
     3407         then do:
     3408             next.
     3409         end.
     3410       end.
     3411       assign
     3412         p-sert       =  substitute( "&1 &2 от &3"
     3413                                   , buf_alc-supp-lic.seria
     3414                                   , buf_alc-supp-lic.number
     3415                                   , buf_alc-supp-lic.date-from
     3416                                   )
     3417         p-sert-give  = substitute( "&1" , buf_alc-supp-lic.who-are-got )
     3418       .
     3419       return.
     3420     end.
     3421   end.
     3422   end procedure.
     3423   procedure fill-tt-alc-retail :
     3424   do
     3425   on error undo, return error return-value
     3426   :
     3427     define buffer buf_alc-type  for ub.alc-type.
     3428     define buffer buf_ot-line   for ub.ot-line.
     3429     define buffer buf_trn-doc   for ub.trn-doc.
     3430     define buffer sch_trn-doc   for ub.trn-doc.
     3431     define buffer buf_parts     for ub.parts.
     3432     define buffer buf_tt-gds        for tt-gds.
     3433     define buffer buf_obj-list      for obj-list.
     3434     define buffer buf_tt-alc-retail for tt-alc-retail.
     3435     define variable var-x-store-code    like ub.clients.obj-code    no-undo.
     3436     define variable var-x-store-type    like ub.clients.obj-type    no-undo.
     3437     define variable var-x-date-start    like ub.stk-tot.Fact-date   no-undo.
     3438     define variable var-x-date-endt     like ub.stk-tot.Fact-date   no-undo.
     3439     define variable var-x-sum-type      like ub.stk-tot.sum-type    no-undo.
     3440     define variable var-x-ost-sum-type  like ub.stk-tot.sum-type    no-undo.
     3441     define variable var-x-cat-id        like ub.stk-tot.cat-id      no-undo.
     3442     define variable var-xTog-obj        as   logical             no-undo.
     3443     define variable var-x-artic         like ub.stk-line.artic        no-undo.
     3444     define variable var-x-prod-code     like ub.stk-line.prod-code    no-undo.
     3445     define variable var-x-prod-type     like ub.stk-line.prod-type    no-undo.
     3446     define variable var-Quantity        like ub.stk-tot.fact-qnty   initial ? no-undo.
     3447     define variable var-Coast_R         like ub.stk-tot.sum-rubl    no-undo.
     3448     define variable var-Coast_V         like ub.stk-tot.sum-rubl    no-undo.
     3449     define variable var-VAT_R           like ub.stk-tot.sum-rubl    no-undo.
     3450     define variable var-VAT_V           like ub.stk-tot.sum-rubl    no-undo.
     3451     define variable var-SLT_R           like ub.stk-tot.sum-rubl    no-undo.
     3452     define variable var-SLT_V           like ub.stk-tot.sum-rubl    no-undo.
     3453     define variable v-ost-begin-qnty          as decimal               no-undo .
     3454     define variable v-ost-end-qnty            as decimal               no-undo .
     3455     define variable v-ot-line-qnty            as decimal               no-undo .
     3456     define variable v-parts-line-qnty         as decimal               no-undo .
     3457     define variable v-retail-ost-beg          as decimal               no-undo .
     3458     define variable v-retail-pri-prod         as decimal               no-undo .
     3459     define variable v-retail-pri-org          as decimal               no-undo .
     3460     define variable v-retail-pri-tot          as decimal               no-undo .
     3461     define variable v-retail-sale-loc-prod    as decimal               no-undo .
     3462     define variable v-retail-sale-tot         as decimal               no-undo .
     3463     define variable v-retail-ost-end          as decimal               no-undo .
     3464     define variable v-income-doc-code         as character             no-undo .
     3465     define variable v-ext-doc-type    like ub.parts-attr.ext-doc-type  no-undo .
     3466     define variable v-obj-type        like ub.parts-attr.obj-type      no-undo .
     3467     define variable v-obj-code        like ub.parts-attr.obj-code      no-undo .
     3468     define variable v-supp-type       like ub.parts-attr.supp-type     no-undo .
     3469     define variable v-supp-code       like ub.parts-attr.supp-code     no-undo .
     3470     define variable v-fact-order      like ub.parts-attr.fact-order    no-undo .
     3471     define variable v-attr-val                as character             no-undo .
     3472     define variable v-attr-type               as character             no-undo .
     3473     define variable v-is-local-producer       as logical               no-undo .
     3474     run prg-bar_new in this-procedure (1 , v-gds-count).
     3475     run prg-bar_title in this-procedure ( input "Обработка...":U ).
     3476     run prg-bar_show in this-procedure .
     3477     for each buf_alc-type no-lock
     3478           where buf_alc-type.alc-type-status = 0
     3479     :
     3480       find first buf_tt-alc-retail
     3481         where buf_tt-alc-retail.alc-type-code = buf_alc-type.alc-type-code
     3482       no-error .
     3483       if not available buf_tt-alc-retail
     3484       then do:
     3485         create buf_tt-alc-retail.
     3486         assign
     3487           buf_tt-alc-retail.alc-type-code = buf_alc-type.alc-type-code
     3488           buf_tt-alc-retail.alc-type-name = buf_alc-type.alc-type-name
     3489         .
     3490       end.
     3491       assign
     3492         v-ost-begin-qnty        = 0
     3493         v-ost-end-qnty          = 0
     3494         v-ot-line-qnty          = 0
     3495         v-retail-ost-beg        = 0
     3496         v-retail-pri-prod       = 0
     3497         v-retail-pri-org        = 0
     3498         v-retail-pri-tot        = 0
     3499         v-retail-sale-loc-prod  = 0
     3500         v-retail-sale-tot       = 0
     3501         v-retail-ost-end        = 0
     3502       .
     3503       for each buf_tt-gds
     3504         where buf_tt-gds.alc-type-inner-code = buf_alc-type.alc-type-inner-code
     3505           and buf_tt-gds.create-user-db-num  = buf_alc-type.create-user-db-num
     3506       :
     3507         run prg-bar_increment in this-procedure .
     3508         run clntattr-value in this-procedure  ( input buf_tt-gds.prod-type
     3509                                               , input buf_tt-gds.prod-code
     3510                                               , input 'cli-local':U
     3511                                               , output v-attr-val
     3512                                               , output v-attr-type
     3513                                               ).
     3514         assign
     3515           v-is-local-producer = logical(v-attr-val)
     3516         no-error .
     3517         if error-status :error
     3518         then do:
     3519           assign
     3520             v-is-local-producer = false
     3521           .
     3522         end.
     3523         for each obj-list
     3524         :
     3525           assign
     3526             var-x-store-code    = obj-list.obj-code
     3527             var-x-store-type    = obj-list.obj-type
     3528             var-x-artic         = buf_tt-gds.artic
     3529             var-x-prod-code     = buf_tt-gds.prod-code
     3530             var-x-prod-type     = buf_tt-gds.prod-type
     3531             var-x-cat-id        = '##,##':U
     3532             var-xTog-obj        = yes
     3533             v-ost-begin-qnty    = 0
     3534             v-ost-end-qnty      = 0
     3535             var-x-sum-type      = 'cost':U
     3536             var-x-ost-sum-type  = 'cost':U
     3537           .
     3538           run ost-line  (
     3539               input   var-x-store-code    ,
     3540               input   var-x-store-type    ,
     3541               INPUT   var-x-artic         ,
     3542               INPUT   var-x-prod-code     ,
     3543               INPUT   var-x-prod-type     ,
     3544               input   no                  ,
     3545               input   v-fact-order-start  ,
     3546               input   var-x-ost-sum-type  ,
     3547               input   var-x-cat-id        ,
     3548               input   var-xTog-obj        ,
     3549               output  var-Quantity        ,
     3550               output  var-Coast_R         ,
     3551               output  var-Coast_V         ,
     3552               output  var-VAT_R           ,
     3553               output  var-VAT_V           ,
     3554               output  var-SLT_R           ,
     3555               output  var-SLT_V           ).
     3556           assign
     3557             v-ost-begin-qnty = ( var-Quantity * buf_tt-gds.ms-base ) / 10
     3558           .
     3559           run ost-line  (
     3560               input   var-x-store-code    ,
     3561               input   var-x-store-type    ,
     3562               INPUT   var-x-artic         ,
     3563               INPUT   var-x-prod-code     ,
     3564               INPUT   var-x-prod-type     ,
     3565               input   no                  ,
     3566               input   v-fact-order-end    ,
     3567               input   var-x-ost-sum-type  ,
     3568               input   var-x-cat-id        ,
     3569               input   var-xTog-obj        ,
     3570               output  var-Quantity        ,
     3571               output  var-Coast_R         ,
     3572               output  var-Coast_V         ,
     3573               output  var-VAT_R           ,
     3574               output  var-VAT_V           ,
     3575               output  var-SLT_R           ,
     3576               output  var-SLT_V           ).
     3577           assign
     3578             v-ost-end-qnty = ( var-Quantity * buf_tt-gds.ms-base ) / 10
     3579           .
     3580           ot-line-cycle:
     3581           for each buf_ot-line no-lock
     3582             where buf_ot-line.artic        = buf_tt-gds.artic
     3583               and buf_ot-line.prod-code    = buf_tt-gds.prod-code
     3584               and buf_ot-line.prod-type    = buf_tt-gds.prod-type
     3585               and buf_ot-line.fact-order   < v-fact-order-end
     3586               and buf_ot-line.fact-order   >= v-fact-order-start
     3587               and buf_ot-line.obj-code     = obj-list.obj-code
     3588               and buf_ot-line.obj-type     = obj-list.obj-type
     3589               and buf_ot-line.sum-type     = var-x-sum-type
     3590           :
     3591             find first buf_trn-doc no-lock
     3592               where buf_trn-doc.doc-code = buf_ot-line.doc-code
     3593             no-error .
     3594             if not available buf_trn-doc then do:
     3595               message
     3596                 vss-workfile vss-revision vss-description skip
     3597                 substitute( "Не найден складской документ &1.&2Документ не будет учтен в отчете." , buf_ot-line.doc-code , chr(10) )
     3598               view-as alert-box error .
     3599               next ot-line-cycle.
     3600             end.
     3601             assign
     3602               v-ot-line-qnty  = abs( buf_ot-line.fact-qnty * buf_tt-gds.ms-base ) / 10
     3603             .
     3604             case buf_ot-line.ext-doc-type
     3605             :
     3606               when 'ie':U  then do :
     3607                 if ( buf_trn-doc.cli-type = buf_tt-gds.prod-type ) and
     3608                    ( buf_trn-doc.cli-code = buf_tt-gds.prod-code )
     3609                 then do:
     3610                   assign
     3611                     v-retail-pri-prod = v-retail-pri-prod + v-ot-line-qnty
     3612                   .
     3613                 end.
     3614                 else do:
     3615                   assign
     3616                     v-retail-pri-org = v-retail-pri-org + v-ot-line-qnty
     3617                   .
     3618                 end.
     3619                 assign
     3620                   v-retail-pri-tot = v-retail-pri-tot + v-ot-line-qnty
     3621                 .
     3622               end.
     3623               when 'iv':U     or
     3624               when 'rv':U
     3625               then do :
     3626                 _buf_parts:
     3627                 for each buf_parts no-lock
     3628                       where buf_parts.out-code  = buf_ot-line.doc-code
     3629                         and buf_parts.obj-type  = buf_ot-line.obj-type
     3630                         and buf_parts.obj-code  = buf_ot-line.obj-code
     3631                         and buf_parts.artic     = buf_ot-line.artic
     3632                         and buf_parts.prod-type = buf_ot-line.prod-type
     3633                         and buf_parts.prod-code = buf_ot-line.prod-code
     3634                 :
     3635                   run find-income-doc-code in this-procedure ( input buf_parts.in-code
     3636                                                              , input buf_tt-gds.gds-code
     3637                                                              , input buf_parts.part-code
     3638                                                              , output v-income-doc-code
     3639                                                              , output v-ext-doc-type
     3640                                                              , output v-fact-order
     3641                                                              , output v-obj-type
     3642                                                              , output v-obj-code
     3643                                                              , output v-supp-type
     3644                                                              , output v-supp-code
     3645                                                              ).
     3646                   if v-income-doc-code = ?
     3647                   then do:
     3648                     message
     3649                       substitute("Не могу найти приходную накладную с номером: &1", buf_parts.in-code) skip
     3650                       "Отчет будет сформирован некорректно":U
     3651                     view-as alert-box error .
     3652                     next _buf_parts.
     3653                   end.
     3654                   assign
     3655                     v-parts-line-qnty = ( buf_parts.fact-qnty * buf_tt-gds.ms-base ) / 10
     3656                   .
     3657                   if    v-ext-doc-type = 'ie':U
     3658                     and v-fact-order   >= v-fact-order-start
     3659                     and v-fact-order   <= v-fact-order-end
     3660                   then do:
     3661                     find first buf_obj-list no-lock
     3662                       where buf_obj-list.obj-type = v-obj-type
     3663                         and buf_obj-list.obj-code = v-obj-code
     3664                     no-error .
     3665                     if available buf_obj-list then do :
     3666                       next _buf_parts.
     3667                     end.
     3668                   end.
     3669                   if ( v-supp-type = buf_tt-gds.prod-type ) and
     3670                      ( v-supp-code = buf_tt-gds.prod-code )
     3671                   then do:
     3672                     assign
     3673                       v-retail-pri-prod = v-retail-pri-prod + v-parts-line-qnty
     3674                     .
     3675                   end.
     3676                   else do:
     3677                     assign
     3678                       v-retail-pri-org = v-retail-pri-org + v-parts-line-qnty
     3679                     .
     3680                   end.
     3681                   assign
     3682                     v-retail-pri-tot = v-retail-pri-tot + v-parts-line-qnty
     3683                   .
     3684                 end.
     3685               end.
     3686               when 'es':U  then do :
     3687                 if(v-is-local-producer)
     3688                 then do:
     3689                   assign
     3690                     v-retail-sale-loc-prod  = v-retail-sale-loc-prod + v-ot-line-qnty
     3691                   .
     3692                 end.
     3693                 assign
     3694                   v-retail-sale-tot = v-retail-sale-tot + v-ot-line-qnty
     3695                 .
     3696               end.
     3697             end case.
     3698           end.
     3699           assign
     3700             v-retail-ost-beg = v-retail-ost-beg + v-ost-begin-qnty
     3701             v-retail-ost-end = v-retail-ost-end + v-ost-end-qnty
     3702           .
     3703         end.
     3704       end.
     3705       assign
     3706         buf_tt-alc-retail.ost-beg       = buf_tt-alc-retail.ost-beg       + v-retail-ost-beg
     3707         buf_tt-alc-retail.pri-prod      = buf_tt-alc-retail.pri-prod      + v-retail-pri-prod
     3708         buf_tt-alc-retail.pri-org       = buf_tt-alc-retail.pri-org       + v-retail-pri-org
     3709         buf_tt-alc-retail.pri-tot       = buf_tt-alc-retail.pri-tot       + v-retail-pri-tot
     3710         buf_tt-alc-retail.sale-loc-prod = buf_tt-alc-retail.sale-loc-prod + v-retail-sale-loc-prod
     3711         buf_tt-alc-retail.sale-tot      = buf_tt-alc-retail.sale-tot      + v-retail-sale-tot
     3712         buf_tt-alc-retail.ost-end       = buf_tt-alc-retail.ost-end       + v-retail-ost-end
     3713       .
     3714     end.
     3715     run prg-bar_delete in this-procedure .
     3716   end.
     3717   end procedure.
     3718   procedure print-alc-pri :
     3719     define buffer buf_tt-alc-pri for tt-alc-pri.
     3720     define variable v-npp         as integer   no-undo .
     3721     define variable v-subtot-qnty as decimal   no-undo .
     3722     define variable v-tot-qnty    as decimal   no-undo .
     3723   do
     3724   on error undo, return error return-value
     3725   :
     3726     run print-alc-pri-header in this-procedure .
     3727     for each buf_tt-alc-pri
     3728       break by buf_tt-alc-pri.cli-type
     3729             by buf_tt-alc-pri.cli-code
     3730             by buf_tt-alc-pri.alc-type-code
     3731     :
     3732       if   first-of(buf_tt-alc-pri.cli-type)
     3733         or first-of(buf_tt-alc-pri.cli-code)
     3734       then do:
     3735         assign
     3736           v-npp         = 0
     3737           v-subtot-qnty = 0
     3738         .
     3739         run alc06xl-sheet1-write-line-data in this-procedure ( input "":U
     3740                                                              , input "":U
     3741                                                              , input "":U
     3742                                                              , input buf_tt-alc-pri.cli-name
     3743                                                              , input buf_tt-alc-pri.cli-inn
     3744                                                              , input buf_tt-alc-pri.cli-address
     3745                                                              , input buf_tt-alc-pri.lic-num
     3746                                                              , input buf_tt-alc-pri.lic-give
     3747                                                              , input "":U
     3748                                                              ) .
     3749       end.
     3750       assign
     3751         v-npp         = v-npp + 1
     3752         v-subtot-qnty = v-subtot-qnty + buf_tt-alc-pri.quantity
     3753         v-tot-qnty    = v-tot-qnty + buf_tt-alc-pri.quantity
     3754       .
     3755       run alc06xl-sheet1-write-line-data in this-procedure ( input string(v-npp)
     3756                                                            , input buf_tt-alc-pri.alc-type-name
     3757                                                            , input string(buf_tt-alc-pri.alc-type-code)
     3758                                                            , input "":U
     3759                                                            , input "":U
     3760                                                            , input "":U
     3761                                                            , input "":U
     3762                                                            , input "":U
     3763                                                            , input string(buf_tt-alc-pri.quantity)
     3764                                                            ) .
     3765       if   last-of(buf_tt-alc-pri.cli-type)
     3766         or last-of(buf_tt-alc-pri.cli-code)
     3767       then do:
     3768         run alc06xl-sheet1-write-line-data in this-procedure ( input "":U
     3769                                                              , input "Итого":U
     3770                                                              , input "":U
     3771                                                              , input "":U
     3772                                                              , input "":U
     3773                                                              , input "":U
     3774                                                              , input "":U
     3775                                                              , input "":U
     3776                                                              , input string(v-subtot-qnty)
     3777                                                              ) .
     3778       end.
     3779     end.
     3780     run alc06xl-sheet1-write-line-data in this-procedure ( input "":U
     3781                                                          , input "Всего":U
     3782                                                          , input "":U
     3783                                                          , input "":U
     3784                                                          , input "":U
     3785                                                          , input "":U
     3786                                                          , input "":U
     3787                                                          , input "":U
     3788                                                          , input string(v-tot-qnty)
     3789                                                          ) .
     3790     run print-alc-pri-footer in this-procedure .
     3791   end.
     3792   end procedure.
     3793   procedure print-alc-pri-header :
