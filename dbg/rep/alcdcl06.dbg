      574   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      575   define  stream PrnLibStream.
      576   procedure prn-lib-prn-file :
      577     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      578     define input parameter p-DIsabledoptions as integer no-undo .
      579     define variable v-report-name as character no-undo .
      580     define variable v-user-action as character no-undo .
      581     define variable v-printed     as logical   no-undo .
      582     define variable v-exist       as logical   no-undo .
      583     do
      584       on error undo, return error
      585       :
      586       run prn-lib-get-report-name  in this-procedure (
      587         input parParentProc
      588         ,output v-report-name
      589         ).
      590   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      591   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      592     (input  v-report-name
      593     ,input  2
      594     ,output v-exist
      595     )  .
      596       if NOT v-exist then
      597       DO:
      598         Message
      599           "Нет заданий на печать ! "
      600           view-as alert-box .
      601         Return  .
      602       End.
      603       run gbl/prnfilen.w
      604         (input  ""
      605         ,input  p-DisabledOptions
      606         ,input  string(v-report-name )
      607         ,input  7
      608         ,output v-user-action
      609         ,output v-printed
      610         ) .
      611       if v-printed then
      612       do:
      613         return "YES" .
      614       end.
      615       else
      616       do:
      617         return "NO" .
      618       end.
      619     end.
      620   end procedure.
      621   procedure prn-lib-open-stream :
      622     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      623     define input parameter p-page-size    as integer no-undo .
      624     define input parameter p-is-stream    as logical no-undo .
      625     define input parameter p-append       as logical no-undo .
      626     define variable v-report-name as character no-undo .
      627     do
      628       on error undo, return error
      629       :
      630       run prn-lib-get-report-name  in this-procedure (
      631         input parParentProc
      632         ,output v-report-name
      633         ).
      634       if p-is-stream then
      635       do:
      636         if p-append then
      637         do:
      638           output stream PrnLibStream to value( v-report-name )
      639             page-size value(p-page-size) append .
      640         end.
      641         if not p-append then
      642         do:
      643           output stream PrnLibStream to value( v-report-name )
      644             page-size value(p-page-size) .
      645         end.
      646       end.
      647       if not p-is-stream then
      648       do:
      649         if p-append then
      650         do:
      651           output to value( v-report-name )
      652             page-size value(p-page-size) append .
      653         end.
      654         if not p-append then
      655         do:
      656           output to value( v-report-name )
      657             page-size value(p-page-size) .
      658         end.
      659       end.
      660     end.
      661   end procedure.
      662   procedure prn-lib-open-exp :
      663     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      664     define input parameter p-is-stream    as logical no-undo .
      665     define input parameter p-is-append    as logical no-undo .
      666     define output parameter p-ReportFileName as char init "report" no-undo.
      667     define output parameter p-process as logical no-undo .
      668     define variable glog as logical no-undo .
      669     do
      670       on error undo, return error
      671       :
      672       SYSTEM-DIALOG GET-FILE p-ReportFileName
      673         TITLE      "Укажите путь"
      674         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      675         ASK-OVERWRITE
      676         CREATE-TEST-FILE
      677         SAVE-AS
      678         USE-FILENAME
      679         DEFAULT-EXTENSION "txt"
      680         UPDATE glog
      681         .
      682       if not glog then  return.
      683       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      684       if p-is-stream then
      685       do:
      686         if p-is-append then
      687         do:
      688           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      689         end.
      690         else
      691         do:
      692           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      693         end.
      694       end.
      695       else
      696       do:
      697         if p-is-append then
      698         do:
      699           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      700         end.
      701         else
      702         do:
      703           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      704         end.
      705       end.
      706       p-process = yes.
      707     end.
      708   end procedure.
      709   procedure prn-lib-get-report-name :
      710     define input parameter parParentProc  as widget-handle no-undo.
      711     define output parameter p-report-name as character no-undo .
      712     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      713   end procedure.
      714   procedure prn-lib-reportviewer-report-name :
      715     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      716     define input parameter p-report-name-html as character no-undo .
      717     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      718   end procedure.
      719   procedure prn-lib-reportviewer :
      720     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      721     define input parameter p-report-name-html as character no-undo .
      722     define input parameter p-param        as character no-undo .
      723     define variable v-excel           as character no-undo init 'TRUE' .
      724     define variable v-value-character as character no-undo .
      725     define variable v-value-integer   as character no-undo .
      726     define variable v-value-date      as date      no-undo .
      727     define variable v-value-decimal   as decimal   no-undo .
      728     define variable rep-excel         as logical   no-undo .
      729     define variable excel-string      as character no-undo .
      730     define variable v-param-type      as character no-undo .
      731     define variable v-tth             as handle    no-undo .
      732     run adm/shattri.p (
      733       input "get":U
      734       ,input  ""
      735       ,input  0
      736       ,input  'report-glob':U
      737       ,input  'rep-excel':U
      738       ,output v-value-character
      739       ,output v-value-date
      740       ,output v-value-decimal
      741       ,output v-value-integer
      742       ,output rep-excel
      743       ,output v-param-type
      744       ,INPUT-OUTPUT table-handle v-tth
      745       )  .
      746     if rep-excel then v-excel = "TRUE" .
      747     else v-excel = "FALSE" .
      748     if p-param eq ""
      749     then
      750        p-param = "EXCEL:" + v-excel.
      751     else
      752        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      753     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      754   end procedure.
