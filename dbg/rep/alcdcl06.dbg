     1849   procedure ost-line :
     1850     define input  parameter x-store-code like ub.clients.obj-code    no-undo .
     1851     define input  parameter x-store-type like ub.clients.obj-type    no-undo .
     1852     define input  parameter x-artic      like ub.stk-line.artic      no-undo .
     1853     define input  parameter x-prod-code  like ub.stk-line.prod-code  no-undo .
     1854     define input  parameter x-prod-type  like ub.stk-line.prod-type  no-undo .
     1855     define input  parameter x-tog-shift  as logical no-undo .
     1856     define input  parameter x-fact-order like ub.stk-line.fact-order no-undo .
     1857     define input  parameter x-sum-type   like ub.stk-line.sum-type   no-undo .
     1858     define input  parameter x-cat-id     like ub.stk-line.cat-id     no-undo .
     1859     define input  parameter xtog-obj     as logical no-undo .
     1860     define output parameter quantity     like ub.stk-line.fact-qnty  no-undo .
     1861     define output parameter coast_r      like ub.stk-line.sum-rubl   no-undo .
     1862     define output parameter coast_v      like ub.stk-line.sum-rubl   no-undo .
     1863     define output parameter vat_r        like ub.stk-line.sum-rubl   no-undo .
     1864     define output parameter vat_v        like ub.stk-line.sum-rubl   no-undo .
     1865     define output parameter slt_r        like ub.stk-line.sum-rubl   no-undo .
     1866     define output parameter slt_v        like ub.stk-line.sum-rubl   no-undo .
     1867     define buffer buff-obj-list  for obj-list .
     1868     define buffer buff-stk-line  for ub.stk-line .
     1869     assign
     1870       Quantity = 0
     1871       Coast_R  = 0
     1872       Coast_V  = 0
     1873       VAT_R    = 0
     1874       VAT_V    = 0
     1875       SLT_R    = 0
     1876       SLT_V    = 0
     1877     .
     1878     if  x-tog-shift = false then do:
     1879       for each buff-obj-list no-lock
     1880         where xtog-obj = false
     1881            or (buff-obj-list.obj-type = x-store-type
     1882               and buff-obj-list.obj-code = x-store-code
     1883               )
     1884       on error undo, return error
     1885       :
     1886         find last buff-stk-line no-lock
     1887           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     1888             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     1889             and buff-stk-line.artic      = x-artic
     1890             and buff-stk-line.prod-type  = x-prod-type
     1891             and buff-stk-line.prod-code  = x-prod-code
     1892             and buff-stk-line.sum-type   = x-sum-type
     1893             and buff-stk-line.cat-id     = '##,##':U
     1894             and buff-stk-line.fact-order <= x-fact-order
     1895             and buff-stk-line.shift-num  = 0
     1896           use-index category
     1897           no-error .
     1898         if available buff-stk-line then do:
     1899           assign
     1900             Quantity = Quantity +  buff-stk-line.fact-qnty
     1901             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     1902             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     1903             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     1904             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     1905             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     1906             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     1907           .
     1908         end.
     1909       end.
     1910     end.
     1911     else do:
     1912       for each buff-obj-list no-lock
     1913         where xtog-obj = false
     1914            or (buff-obj-list.obj-type = x-store-type
     1915               and buff-obj-list.obj-code = x-store-code
     1916               )
     1917       on error undo, return error
     1918       :
     1919         find last buff-stk-line no-lock
     1920           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     1921             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     1922             and buff-stk-line.artic      = x-artic
     1923             and buff-stk-line.prod-type  = x-prod-type
     1924             and buff-stk-line.prod-code  = x-prod-code
     1925             and buff-stk-line.sum-type   = x-sum-type
     1926             and buff-stk-line.cat-id     = '##,##':U
     1927             and buff-stk-line.fact-order <= x-fact-order
     1928             and buff-stk-line.shift-num  > 0
     1929           use-index category
     1930           no-error .
     1931         if available buff-stk-line then do:
     1932           assign
     1933             Quantity = Quantity +  buff-stk-line.fact-qnty
     1934             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     1935             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     1936             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     1937             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     1938             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     1939             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     1940           .
     1941         end.
     1942       end.
     1943     end.
     1944   end procedure.
     1945   procedure ost-lineother-tax :
     1946     define input  parameter x-store-code like ub.clients.obj-code      no-undo.
     1947     define input  parameter x-store-type like ub.clients.obj-type      no-undo.
     1948     define input  parameter x-artic      like ub.stk-line.artic        no-undo.
     1949     define input  parameter x-prod-code  like ub.stk-line.prod-code    no-undo.
     1950     define input  parameter x-prod-type  like ub.stk-line.prod-type    no-undo.
     1951     define input  parameter x-tog-shift  as logical no-undo .
     1952     define input  parameter x-fact-order like ub.stk-line.fact-order   no-undo.
     1953     define input  parameter x-sum-type   like ub.stk-line.sum-type     no-undo.
     1954     define input  parameter x-type-id    like ub.stk-line.cat-id       no-undo.
     1955     define input  parameter xTog-obj     as logical no-undo .
     1956     define output parameter Quantity     like ub.stk-line.fact-qnty   no-undo.
     1957     define output parameter Coast_R      like ub.stk-line.sum-rubl    no-undo.
     1958     define output parameter Coast_V      like ub.stk-line.sum-rubl    no-undo.
     1959     define output parameter VAT_R        like ub.stk-line.sum-rubl    no-undo.
     1960     define output parameter VAT_V        like ub.stk-line.sum-rubl    no-undo.
     1961     define output parameter SLT_R        like ub.stk-line.sum-rubl    no-undo.
     1962     define output parameter SLT_V        like ub.stk-line.sum-rubl    no-undo.
     1963     define output parameter other_R      like ub.stk-line.sum-rubl    no-undo.
     1964     define output parameter other_V      like ub.stk-line.sum-rubl    no-undo.
     1965     define buffer buff-obj-list  for obj-list .
     1966     define buffer buff-stk-line  for ub.stk-line .
     1967     assign
     1968       Quantity = 0
     1969       Coast_R  = 0
     1970       Coast_V  = 0
     1971       VAT_R    = 0
     1972       VAT_V    = 0
     1973       SLT_R    = 0
     1974       SLT_V    = 0
     1975       other_R  = 0
     1976       other_V  = 0
     1977     .
     1978     if  x-tog-shift = false then do:
     1979       for each buff-obj-list no-lock
     1980         where xtog-obj = false
     1981            or (buff-obj-list.obj-type = x-store-type
     1982               and buff-obj-list.obj-code = x-store-code
     1983               )
     1984       on error undo, return error
     1985       :
     1986         find last buff-stk-line no-lock
     1987           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     1988             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     1989             and buff-stk-line.artic      = x-artic
     1990             and buff-stk-line.prod-type  = x-prod-type
     1991             and buff-stk-line.prod-code  = x-prod-code
     1992             and buff-stk-line.sum-type   = x-sum-type
     1993             and buff-stk-line.cat-id     = '##,##':U
     1994             and buff-stk-line.fact-order <= x-fact-order
     1995             and buff-stk-line.shift-num  = 0
     1996           use-index category
     1997           no-error .
     1998         if available buff-stk-line then do:
     1999           assign
     2000             Quantity = Quantity +  buff-stk-line.fact-qnty
     2001             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     2002             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     2003             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     2004             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     2005             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     2006             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     2007             other_R  = other_R  +  buff-stk-line.other-rubl
     2008             other_V  = other_V  +  buff-stk-line.other-base
     2009           .
     2010         end.
     2011       end.
     2012     end.
     2013     else do:
     2014       for each buff-obj-list no-lock
     2015         where xtog-obj = false
     2016            or (buff-obj-list.obj-type = x-store-type
     2017               and buff-obj-list.obj-code = x-store-code
     2018               )
     2019       on error undo, return error
     2020       :
     2021         find last buff-stk-line no-lock
     2022           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     2023             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     2024             and buff-stk-line.artic      = x-artic
     2025             and buff-stk-line.prod-type  = x-prod-type
     2026             and buff-stk-line.prod-code  = x-prod-code
     2027             and buff-stk-line.sum-type   = x-sum-type
     2028             and buff-stk-line.cat-id     = '##,##':U
     2029             and buff-stk-line.fact-order <= x-fact-order
     2030             and buff-stk-line.shift-num  > 0
     2031           use-index category
     2032           no-error .
     2033         if available buff-stk-line then do:
     2034           assign
     2035             Quantity = Quantity +  buff-stk-line.fact-qnty
     2036             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     2037             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     2038             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     2039             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     2040             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     2041             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     2042             other_R = other_R   +  buff-stk-line.other-rubl
     2043             other_V = other_V   +  buff-stk-line.other-base
     2044           .
     2045         end.
     2046       end.
     2047     end.
     2048   end procedure.
     2049   procedure ost-line-kg :
     2050     define  input parameter p-obj-code    like ub.stk-line.obj-code   no-undo .
     2051     define  input parameter p-obj-type    like ub.stk-line.obj-type   no-undo .
     2052     define  input parameter p-artic       like ub.stk-line.artic      no-undo .
     2053     define  input parameter p-prod-code   like ub.stk-line.prod-code  no-undo .
     2054     define  input parameter p-prod-type   like ub.stk-line.prod-type  no-undo .
     2055     define  input parameter p-fact-order  like ub.stk-line.fact-order no-undo .
     2056     define output parameter p-quantity-kg like ub.stk-line.fact-qnty  no-undo initial 0.00 .
     2057     define buffer buff-obj-list  for obj-list .
     2058     define buffer buf_doc-line for ub.doc-line .
     2059     define buffer buf_inv-line for ub.inv-line .
     2060     do
     2061     on error undo, return error
     2062     :
     2063       for each buf_doc-line no-lock where
     2064                buf_doc-line.obj-type    = p-obj-type   and
     2065                buf_doc-line.obj-code    = p-obj-code   and
     2066                buf_doc-line.prod-type   = p-prod-type  and
     2067                buf_doc-line.prod-code   = p-prod-code  and
     2068                buf_doc-line.artic       = p-artic      and
     2069                buf_doc-line.status_     = 'факт':U      and
     2070                buf_doc-line.fact-order <= p-fact-order
     2071             by buf_doc-line.fact-order    descending
     2072       :
     2073         find first buf_inv-line no-lock where
     2074                    buf_inv-line.doc-code  = buf_doc-line.doc-code  and
     2075                    buf_inv-line.artic     = buf_doc-line.artic     and
     2076                    buf_inv-line.prod-type = buf_doc-line.prod-type and
     2077                    buf_inv-line.prod-code = buf_doc-line.prod-code no-error .
     2078         if available buf_inv-line
     2079         then do:
     2080           if buf_inv-line.after-cli-qnty <> ?
     2081           then do:
     2082             assign
     2083               p-quantity-kg = buf_inv-line.after-cli-qnty
     2084             .
     2085             leave .
     2086           end.
     2087         end.
     2088       end.
     2089       if p-quantity-kg = ?
     2090       then do:
     2091         assign
     2092           p-quantity-kg = 0
     2093         .
     2094       end.
     2095     end.
     2096   end procedure.
     2097   define temp-table temp-font no-undo
     2098     field fontnum  as integer
     2099     field fontname as character
     2100     field fontsize as character
     2101     field fonttype as character
     2102     field font-h   as integer
     2103     field font-w   as integer
     2104     field v-row    as integer
     2105     field v-col    as integer
     2106     field v-row-lans as integer
     2107     field v-col-lans as integer
     2108   index pi fontnum
     2109   .
     2110   procedure get-font-ini :
     2111     do
     2112     on error undo, return error return-value
     2113     :
     2114   define variable ii as integer   no-undo .
     2115   define variable v-font7 as character no-undo .
     2116   define variable v-font as character no-undo .
     2117   define variable loc-name as character no-undo .
     2118   define variable loc-size as character no-undo .
     2119   define variable loc-type as character no-undo .
     2120   define variable old_H as integer   no-undo .
     2121   define variable old_w as integer   no-undo .
     2122   define variable old-row  as integer   no-undo .
     2123   define variable old-col  as integer   no-undo .
     2124   define variable old-row-lans  as integer   no-undo .
     2125   define variable old-col-lans  as integer   no-undo .
     2126   define variable vv as integer   no-undo .
     2127   empty temp-table temp-font.
     2128     GET-KEY-VALUE SECTION "fonts" KEY "font7" VALUE v-font7 .
     2129       case num-entries (v-font7) :
     2130         when 4 then do:
     2131             assign
     2132               loc-name = entry ( 1 , v-font7 )
     2133               loc-size = entry ( 2 , v-font7 )
     2134               loc-type = entry ( 3 , v-font7 ) + "," +  entry ( 4 , v-font7 )
     2135             .
     2136         end.
     2137         when 3 then do:
     2138             assign
     2139               loc-name = entry ( 1 , v-font7 )
     2140               loc-size = entry ( 2 , v-font7 )
     2141               loc-type = entry ( 3 , v-font7 )
     2142             .
     2143         end.
     2144         when 2 then  do:
     2145             assign
     2146               loc-name = entry ( 1 , v-font7 )
     2147               loc-size = entry ( 2 , v-font7 )
     2148               loc-type = ""
     2149             .
     2150         end.
     2151         when 1 then do:
     2152             assign
     2153               loc-name = trim(entry ( 1 , v-font7 ))
     2154               loc-size = ""
     2155               loc-type = ""
     2156             .
     2157         end.
     2158       end case.
     2159     create temp-font.
     2160     assign
     2161       temp-font.fontnum  = 7
     2162       temp-font.fontname = trim(loc-name)
     2163       temp-font.fontsize = trim(loc-size)
     2164       temp-font.fonttype = trim(loc-type)
     2165       temp-font.v-row    = 62
     2166       temp-font.v-col    = 136
     2167       temp-font.v-row-lans = 43
     2168       temp-font.v-col-lans = 198
     2169     .
     2170     repeat ii = 16 to 100 :
     2171       get-key-value section 'fonts' key 'font' + string(ii)   value v-font  .
     2172       if v-font = "" or v-font = ? then leave.
     2173       case num-entries (v-font) :
     2174         when 4 then do:
     2175             assign
     2176               loc-name = entry ( 1 , v-font )
     2177               loc-size = entry ( 2 , v-font )
     2178               loc-type = entry ( 3 , v-font ) + "," +  entry ( 4 , v-font )
     2179             .
     2180         end.
     2181         when 3 then do:
     2182             assign
     2183               loc-name = entry ( 1 , v-font )
     2184               loc-size = entry ( 2 , v-font )
     2185               loc-type = entry ( 3 , v-font )
     2186             .
     2187         end.
     2188         when 2 then do:
     2189             assign
     2190               loc-name = entry ( 1 , v-font )
     2191               loc-size = entry ( 2 , v-font )
     2192               loc-type = ""
     2193             .
     2194         end.
     2195         when 1 then do:
     2196             assign
     2197               loc-name = trim(entry ( 1 , v-font ))
     2198               loc-size = ""
     2199               loc-type = ""
     2200             .
     2201         end.
     2202       end case.
     2203     create temp-font.
     2204     assign
     2205       temp-font.fontnum  = ii
     2206       temp-font.fontname = trim(loc-name)
     2207       temp-font.fontsize = trim(loc-size)
     2208       temp-font.fonttype = trim(loc-type)
     2209     .
     2210     end.
     2211       for each temp-font :
     2212          vv = integer(entry(2,temp-font.fontsize, "=" )) no-error .
     2213          if  vv = ? then vv =  0 .
     2214           run rep/exfont.p (
     2215             input   temp-font.fontname ,
     2216             input   vv ,
     2217             input   temp-font.fonttype ,
     2218             output  temp-font.font-h   ,
     2219             output  temp-font.font-w   )
     2220           .
     2221       end.
     2222   find first temp-font where  temp-font.fontnum  = 7  .
     2223   old_H = temp-font.font-H .
     2224   old_w = temp-font.font-W .
     2225   old-row = temp-font.v-row .
     2226   old-col = temp-font.v-col .
     2227   old-row-lans = temp-font.v-row-lans .
     2228   old-col-lans = temp-font.v-col-lans .
     2229       for each temp-font where
     2230                temp-font.fontnum  <> 7 :
     2231           assign
     2232               temp-font.v-row    = old_H * old-row / temp-font.font-h
     2233               temp-font.v-col    = old_W * old-col / temp-font.font-W
     2234               temp-font.v-row-lans    = old_H * old-row-lans / temp-font.font-h
     2235               temp-font.v-col-lans    = old_W * old-col-lans / temp-font.font-W
     2236           .
     2237       end.
     2238     end.
     2239   end procedure.
     2240   PROCEDURE How-name :
     2241   define input  parameter h as integer no-undo .
     2242   define input  parameter w as integer no-undo .
     2243   define output parameter n as character  no-undo .
     2244   define variable A4port-H as integer   no-undo init 63.
     2245   define variable A4port-W as integer   no-undo init 136.
     2246   define variable A4lans-H as integer   no-undo init 43.
     2247   define variable A4lans-W as integer   no-undo init 198.
     2248   define variable Strim-W  as integer   no-undo init 278.
     2249   run define-a4-size (
     2250        input ReportFontNum
     2251       ,output A4port-H
     2252       ,output A4port-W
     2253       ,output A4lans-H
     2254       ,output A4lans-W ).
     2255   If w >= 1 and w <= A4port-W Then DO:
     2256     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     2257     If h > A4lans-H  and h <= A4port-H Then n = "A4-port":U.
     2258     If h > A4port-H              Then n = "to-file":U.
     2259   End.
     2260   If w > A4port-W and w <= A4lans-W Then DO:
     2261     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     2262     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     2263     If h > A4port-H              Then n = "to-file":U.
     2264   End.
     2265   If w > A4lans-W and w <= Strim-W Then DO:
     2266     If h >= 1  and h <= A4lans-H Then n = "to-file":U.
     2267     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     2268     If h > A4port-H              Then n = "to-file":U.
     2269   End.
     2270   If w > Strim-W Then DO:
     2271      n = "to-file":U.
     2272   End.
     2273   END PROCEDURE.
     2274   PROCEDURE define-a4-size :
     2275   define input  parameter p-ReportFontNum as integer   no-undo .
     2276   define output parameter A4port-H as integer   no-undo .
     2277   define output parameter A4port-W as integer   no-undo .
     2278   define output parameter A4lans-H as integer   no-undo .
     2279   define output parameter A4lans-W as integer   no-undo .
     2280   if not can-find (first temp-font ) then do:
     2281      run get-font-ini .
     2282   end.
     2283   find first temp-font where temp-font.fontnum = p-ReportFontNum no-error .
     2284   if available temp-font then do:
     2285   assign
     2286     A4port-H = temp-font.v-row
     2287     A4port-W = temp-font.v-col
     2288     A4lans-H = temp-font.v-row-lans
     2289     A4lans-W = temp-font.v-col-lans
     2290   .
     2291   end.
     2292   else do:
     2293   assign
     2294     A4port-H = 63
     2295     A4port-W = 136
     2296     A4lans-H = 43
     2297     A4lans-W = 198
     2298   .
     2299   end.
     2300   END PROCEDURE.
