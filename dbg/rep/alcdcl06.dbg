     3826   procedure print-alc-retail :
     3827     define buffer buf_tt-alc-retail for tt-alc-retail.
     3828     define variable v-npp               as integer   no-undo .
     3829     define variable v-tot-ost-beg       as decimal   no-undo .
     3830     define variable v-tot-pri-prod      as decimal   no-undo .
     3831     define variable v-tot-pri-org       as decimal   no-undo .
     3832     define variable v-tot-pri-tot       as decimal   no-undo .
     3833     define variable v-tot-sale-loc-prod as decimal   no-undo .
     3834     define variable v-tot-sale-tot      as decimal   no-undo .
     3835     define variable v-tot-ost-end       as decimal   no-undo .
     3836   do
     3837   on error undo, return error return-value
     3838   :
     3839     run print-alc-retail-header in this-procedure .
     3840     for each buf_tt-alc-retail
     3841     :
     3842       assign
     3843         v-npp               = v-npp + 1
     3844         v-tot-ost-beg       = v-tot-ost-beg       + buf_tt-alc-retail.ost-beg
     3845         v-tot-pri-prod      = v-tot-pri-prod      + buf_tt-alc-retail.pri-prod
     3846         v-tot-pri-org       = v-tot-pri-org       + buf_tt-alc-retail.pri-org
     3847         v-tot-pri-tot       = v-tot-pri-tot       + buf_tt-alc-retail.pri-tot
     3848         v-tot-sale-loc-prod = v-tot-sale-loc-prod + buf_tt-alc-retail.sale-loc-prod
     3849         v-tot-sale-tot      = v-tot-sale-tot      + buf_tt-alc-retail.sale-tot
     3850         v-tot-ost-end       = v-tot-ost-end       + buf_tt-alc-retail.ost-end
     3851       .
     3852       run alc06xl-sheet2-write-line-data in this-procedure ( input string(v-npp)
     3853                                                            , input buf_tt-alc-retail.alc-type-name
     3854                                                            , input string(buf_tt-alc-retail.alc-type-code)
     3855                                                            , input string(buf_tt-alc-retail.ost-beg)
     3856                                                            , input string(buf_tt-alc-retail.pri-tot)
     3857                                                            , input string(buf_tt-alc-retail.pri-prod)
     3858                                                            , input string(buf_tt-alc-retail.pri-org)
     3859                                                            , input string(buf_tt-alc-retail.sale-tot)
     3860                                                            , input string(buf_tt-alc-retail.sale-loc-prod)
     3861                                                            , input string(buf_tt-alc-retail.ost-end)
     3862                                                            ) .
     3863     end.
     3864     run alc06xl-sheet2-write-line-data in this-procedure ( input "":u
     3865                                                          , input "Всего":U
     3866                                                          , input ""
     3867                                                          , input string(v-tot-ost-beg)
     3868                                                          , input string(v-tot-pri-tot)
     3869                                                          , input string(v-tot-pri-prod)
     3870                                                          , input string(v-tot-pri-org)
     3871                                                          , input string(v-tot-sale-tot)
     3872                                                          , input string(v-tot-sale-loc-prod)
     3873                                                          , input string(v-tot-ost-end)
     3874                                                          ) .
     3875     run print-alc-retail-footer in this-procedure .
     3876   end.
     3877   end procedure.
