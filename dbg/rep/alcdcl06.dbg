      783   define variable vss-include-info10 as character format "X(65)" no-undo
      784   initial "@(#)$Workfile$ $Revision$".
      785   define variable v-fmtcli-name          as character    no-undo.
      786   define variable v-fmtcli-engl-name     as character    no-undo.
      787   define variable v-fmtcli-addres        as character    no-undo.
      788   define variable v-fmtcli-post-addres   as character    no-undo.
      789   define variable v-fmtcli-full-addres   as character    no-undo.
      790   define variable v-fmtcli-phone         as character    no-undo.
      791   define variable v-fmtcli-inn           as character    no-undo.
      792   define variable v-fmtcli-kpp           as character    no-undo.
      793   define variable v-fmtcli-okpo          as character    no-undo.
      794   define variable v-fmtcli-country       as character    no-undo.
      795   define variable v-fmtcli-city          as character    no-undo.
      796   define variable v-fmtcli-index         as character    no-undo.
      797   define variable v-fmtcli-schet-exists  as logical      no-undo.
      798   define variable v-fmtcli-bank-exists   as logical      no-undo.
      799   define variable v-fmtcli-bank-r-schet  as character    no-undo.
      800   define variable v-fmtcli-bank-c-schet  as character    no-undo.
      801   define variable v-fmtcli-bank-bik      as character    no-undo.
      802   define variable v-fmtcli-bank-name     as character    no-undo.
      803   define variable v-fmtcli-bank-addres   as character    no-undo.
      804   define variable v-fmtcli-bank-city     as character    no-undo.
      805   procedure fmtcli-get-bank :
      806   define input parameter p-host-code      as integer          no-undo.
      807   define input parameter p-obj-type       as character        no-undo.
      808   define input parameter p-obj-code       as integer          no-undo.
      809   define input parameter p-curr-code      as integer          no-undo.
      810       define buffer buf_fin-schet     for ub.fin-schet.
      811       define buffer buf_fin-bank      for ub.fin-bank.
      812   do
      813   for buf_fin-schet
      814     , buf_fin-bank
      815   on error undo, return error
      816   :
      817       assign
      818           v-fmtcli-schet-exists       = no
      819           v-fmtcli-bank-exists        = no
      820           v-fmtcli-bank-r-schet       = "":U
      821           v-fmtcli-bank-c-schet       = "":U
      822           v-fmtcli-bank-bik           = "":U
      823           v-fmtcli-bank-name          = "":U
      824           v-fmtcli-bank-addres        = "":U
      825           v-fmtcli-bank-city          = "":U
      826       .
      827       search-for-schet:
      828       for each buf_fin-schet no-lock
      829          where buf_fin-schet.host-code = p-host-code
      830            and buf_fin-schet.cli-type  = p-obj-type
      831            and buf_fin-schet.cli-code  = p-obj-code
      832            and buf_fin-schet.curr-code = p-curr-code
      833       on error undo, return error
      834       :
      835           if buf_fin-schet.status_   = 'удал':U
      836           then do:
      837           end.
      838           else do:
      839               assign
      840                   v-fmtcli-schet-exists   = yes
      841                   v-fmtcli-bank-r-schet   = trim( buf_fin-schet.r-schet )
      842                   v-fmtcli-bank-c-schet   = trim( buf_fin-schet.c-schet )
      843               .
      844               find first buf_fin-bank no-lock
      845                    where buf_fin-bank.host-code = p-host-code
      846                      and buf_fin-bank.code-bank = buf_fin-schet.code-bank
      847               no-error.
      848               if available buf_fin-bank
      849               then do:
      850                   assign
      851                       v-fmtcli-bank-exists      = yes
      852                       v-fmtcli-bank-bik         = trim( buf_fin-bank.bik )
      853                       v-fmtcli-bank-name        = trim( buf_fin-bank.bank-name )
      854                       v-fmtcli-bank-addres      = trim(buf_fin-bank.addres)
      855                       v-fmtcli-bank-city      = trim(buf_fin-bank.bank-city)
      856                   .
      857               end.
      858               else do:
      859                   assign
      860                       v-fmtcli-bank-exists    = no
      861                       v-fmtcli-bank-bik       = "":U
      862                       v-fmtcli-bank-name      = "":U
      863                       v-fmtcli-bank-addres    = "":U
      864                       v-fmtcli-bank-city      = "":U
      865                   .
      866               end.
      867               leave search-for-schet.
      868           end.
      869       end.
      870   end.
      871   end procedure.
      872   procedure fmtcli-get-client :
      873   define input parameter p-obj-type       as character    no-undo.
      874   define input parameter p-obj-code       as integer      no-undo.
      875       define variable v-temp-fmtcli-address      as character     no-undo.
      876       define variable v-num-country-city    as integer      no-undo.
      877       define buffer buf_clients   for ub.clients.
      878       define buffer buf_firm      for ub.firm.
      879       define buffer buf_store     for ub.store.
      880       define buffer buf_shop      for ub.shop.
      881       define buffer buf_person    for ub.person.
      882   do
      883   for buf_clients
      884     , buf_firm
      885     , buf_store
      886     , buf_shop
      887     , buf_person
      888   on error undo, return error
      889   :
      890       assign
      891           v-fmtcli-name           = "":U
      892           v-fmtcli-addres         = "":U
      893           v-fmtcli-post-addres    = "":U
      894           v-fmtcli-full-addres    = "":U
      895           v-fmtcli-phone          = "":U
      896           v-fmtcli-inn            = "":U
      897           v-fmtcli-kpp            = "":U
      898           v-fmtcli-okpo           = "":U
      899           v-fmtcli-city           = "":U
      900           v-fmtcli-index          = "":U
      901           v-fmtcli-country        = "":U
      902       .
      903       find first buf_clients no-lock
      904            where buf_clients.obj-type = p-obj-type
      905              and buf_clients.obj-code = p-obj-code
      906       .
      907       assign
      908           v-fmtcli-name = buf_clients.obj-name
      909       .
      910       case buf_clients.obj-type:
      911          when 'орг':U
      912          then do:
      913               find first buf_firm no-lock
      914                    where buf_firm.firm-code = buf_clients.obj-code
      915                    no-error
      916               .
      917               if available buf_firm
      918               then do:
      919                   assign
      920                       v-num-country-city = num-entries( buf_firm.city )
      921                       v-fmtcli-engl-name = buf_firm.engl-name
      922                   .
      923                   if v-num-country-city > 0
      924                   then do:
      925                       assign
      926                           v-fmtcli-country    = trim( entry( 1, buf_firm.city ) )
      927                       .
      928                   end.
      929                   if v-num-country-city > 1
      930                   then do:
      931                       assign
      932                           v-fmtcli-city       = trim( entry( 2, buf_firm.city ) )
      933                       .
      934                   end.
      935                   run fmtcli-concatenate-strings in this-procedure (
      936                         input v-fmtcli-full-addres
      937                       , input v-fmtcli-country
      938                       , input ", ":U
      939                       , input 50
      940                       , output v-fmtcli-full-addres
      941                   ).
      942                   run fmtcli-concatenate-strings in this-procedure (
      943                         input v-fmtcli-full-addres
      944                       , input v-fmtcli-city
      945                       , input ", ":U
      946                       , input 50
      947                       , output v-fmtcli-full-addres
      948                   ).
      949                   run fmtcli-concatenate-strings in this-procedure (
      950                         input v-fmtcli-full-addres
      951                       , input IF buf_firm.ind = 0 THEN "" ELSE string( buf_firm.ind )
      952                       , input ", ":U
      953                       , input 50
      954                       , output v-fmtcli-full-addres
      955                   ).
      956                   run fmtcli-concatenate-strings in this-procedure (
      957                         input v-fmtcli-post-addres
      958                       , input v-fmtcli-country
      959                       , input ", ":U
      960                       , input 50
      961                       , output v-fmtcli-post-addres
      962                   ).
      963                   run fmtcli-concatenate-strings in this-procedure (
      964                         input v-fmtcli-post-addres
      965                       , input v-fmtcli-city
      966                       , input ", ":U
      967                       , input 50
      968                       , output v-fmtcli-post-addres
      969                   ).
      970                   run fmtcli-concatenate-strings in this-procedure (
      971                         input v-fmtcli-post-addres
      972                       , input string( buf_firm.ind )
      973                       , input ", ":U
      974                       , input 50
      975                       , output v-fmtcli-post-addres
      976                   ).
      977                   run fmtcli-concatenate-strings in this-procedure (
      978                         input substring( buf_firm.addres1, 1, 50 )
      979                       , input buf_firm.addres2
      980                       , input " ":U
      981                       , input 50
      982                       , output v-temp-fmtcli-address
      983                   ).
      984                   run fmtcli-concatenate-strings in this-procedure (
      985                         input v-temp-fmtcli-address
      986                       , input substring( buf_firm.addres1, 51, 50 )
      987                       , input " ":U
      988                       , input 50
      989                       , output v-temp-fmtcli-address
      990                   ).
      991                   run fmtcli-concatenate-strings in this-procedure (
      992                         input v-temp-fmtcli-address
      993                       , input substring( buf_firm.addres1, 101, 50 )
      994                       , input " ":U
      995                       , input 50
      996                       , output v-temp-fmtcli-address
      997                   ).
      998                   assign
      999                       v-fmtcli-addres = v-temp-fmtcli-address
     1000                   .
     1001                   if buf_firm.addres1 <> ?
     1002                   then do:
     1003                       run fmtcli-concatenate-strings in this-procedure (
     1004                             input v-fmtcli-full-addres
     1005                           , input v-fmtcli-addres
     1006                           , input ", ":U
     1007                           , input 0
     1008                           , output v-fmtcli-full-addres
     1009                       ).
     1010                   end.
     1011                   run fmtcli-concatenate-strings in this-procedure (
     1012                         input substring( buf_firm.post-addr1, 1, 50 )
     1013                       , input buf_firm.post-addr2
     1014                       , input " ":U
     1015                       , input 50
     1016                       , output v-fmtcli-post-addres
     1017                   ).
     1018                   run fmtcli-concatenate-strings in this-procedure (
     1019                         input v-fmtcli-post-addres
     1020                       , input substring( buf_firm.post-addr1, 51, 50 )
     1021                       , input " ":U
     1022                       , input 50
     1023                       , output v-fmtcli-post-addres
     1024                   ).
     1025                   run fmtcli-concatenate-strings in this-procedure (
     1026                         input v-fmtcli-post-addres
     1027                       , input substring( buf_firm.post-addr1, 101, 50 )
     1028                       , input " ":U
     1029                       , input 50
     1030                       , output v-fmtcli-post-addres
     1031                   ).
     1032                   assign
     1033                       v-fmtcli-phone         = buf_firm.phone
     1034                       v-fmtcli-inn           = buf_firm.inn
     1035                       v-fmtcli-kpp           = buf_firm.kpp
     1036                       v-fmtcli-okpo          = buf_firm.okpo
     1037                       v-fmtcli-index         = string( buf_firm.ind )
     1038                   .
     1039               end.
     1040          end.
     1041          when 'маг':U
     1042          then do:
     1043               find first buf_shop no-lock
     1044                    where buf_shop.obj-code = buf_clients.obj-code
     1045               .
     1046               if available buf_shop
     1047               then do:
     1048                   run fmtcli-concatenate-strings in this-procedure (
     1049                         input buf_shop.addres1
     1050                       , input buf_shop.addres2
     1051                       , input " ":U
     1052                       , input 50
     1053                       , output v-fmtcli-addres
     1054                   ).
     1055                   assign
     1056                       v-fmtcli-full-addres = v-fmtcli-addres
     1057                       v-fmtcli-post-addres = v-fmtcli-addres
     1058                       v-fmtcli-phone       = buf_shop.phone
     1059                       v-fmtcli-inn         = "":U
     1060                       v-fmtcli-kpp         = "":U
     1061                       v-fmtcli-okpo        = "":U
     1062                       v-fmtcli-city        = "":U
     1063                       v-fmtcli-index       = "":U
     1064                   .
     1065               end.
     1066          end.
     1067          when 'скл':U
     1068          then do:
     1069               find first buf_store no-lock
     1070                    where buf_store.obj-code = buf_clients.obj-code
     1071               .
     1072               if available buf_store
     1073               then do:
     1074                   run fmtcli-concatenate-strings in this-procedure (
     1075                         input buf_store.addres1
     1076                       , input buf_store.addres2
     1077                       , input " ":U
     1078                       , input 50
     1079                       , output v-fmtcli-addres
     1080                   ).
     1081                   assign
     1082                       v-fmtcli-full-addres = v-fmtcli-addres
     1083                       v-fmtcli-phone       = buf_store.phone
     1084                       v-fmtcli-inn         = "":U
     1085                       v-fmtcli-kpp         = "":U
     1086                       v-fmtcli-okpo        = "":U
     1087                       v-fmtcli-city        = "":U
     1088                       v-fmtcli-index       = "":U
     1089                   .
     1090               end.
     1091          end.
     1092          when 'чел':U
     1093          then do:
     1094               find first buf_person no-lock
     1095                    where buf_person.psn-code = buf_clients.obj-code
     1096               .
     1097               if available buf_person
     1098               then do:
     1099                   run fmtcli-concatenate-strings in this-procedure (
     1100                         input ( if buf_person.ind = 0 or buf_person.ind = ?
     1101                                 then "":U
     1102                                 else string( buf_person.ind, "999999")
     1103                                 )
     1104                       , input buf_person.city
     1105                       , input ", ":U
     1106                       , input 0
     1107                       , output v-fmtcli-full-addres
     1108                   ).
     1109                   assign
     1110                       v-fmtcli-addres = buf_person.address
     1111                   .
     1112                   run fmtcli-concatenate-strings in this-procedure (
     1113                         input v-fmtcli-full-addres
     1114                       , input v-fmtcli-addres
     1115                       , input ", ":U
     1116                       , input 0
     1117                       , output v-fmtcli-full-addres
     1118                   ).
     1119                   assign
     1120                       v-fmtcli-phone     = buf_person.phone1
     1121                       v-fmtcli-inn       = buf_person.inn
     1122                       v-fmtcli-kpp       = buf_person.kpp
     1123                       v-fmtcli-okpo      = buf_person.okpo
     1124                       v-fmtcli-city      = buf_person.city
     1125                       v-fmtcli-index     = string( buf_person.ind )
     1126                   .
     1127               end.
     1128          end.
     1129       end case.
     1130   end.
     1131   end procedure.
     1132   procedure fmtcli-concatenate-strings :
     1133   define input parameter p-string-1       as character        no-undo.
     1134   define input parameter p-string-2       as character        no-undo.
     1135   define input parameter p-delimiter      as character        no-undo.
     1136   define input parameter p-length         as integer          no-undo.
     1137   define output parameter p-out-string    as character        no-undo.
     1138   do
     1139   on error undo, return error
     1140   :
     1141       assign
     1142           p-out-string = ( if p-string-1 = ?
     1143                            then "":U
     1144                            else trim( p-string-1 ) )
     1145       .
     1146       assign
     1147           p-out-string = p-out-string
     1148                        + ( if p-out-string = "":U
     1149                            or length( p-out-string ) = p-length
     1150                            or p-string-2 = ?
     1151                            or trim( p-string-2 ) = "":U
     1152                            then "":U
     1153                            else p-delimiter )
     1154                        + ( if p-string-2 = ?
     1155                            or trim( p-string-2 ) = "":U
     1156                            then "":U
     1157                            else trim( p-string-2 ) )
     1158       .
     1159   end.
     1160   end procedure.
     1161   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1162   procedure factord :
     1163     define input  parameter p-fact-date            as date    no-undo .
     1164     define input  parameter p-fact-time            as integer no-undo .
     1165     define input  parameter p-fact-num             as integer no-undo .
     1166     define input  parameter p-shift-date           as date    no-undo .
     1167     define input  parameter p-shift-num            as integer no-undo .
     1168     define input  parameter p-shift-on             as logical no-undo .
     1169     define output parameter p-fact-order           as decimal no-undo .
     1170     define output parameter p-shift-end-fact-order as decimal no-undo .
     1171     define output parameter p-day-end-fact-order   as decimal no-undo .
     1172     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     1173     if p-fact-date = ?
     1174     then do:
     1175       return error "Не указана фактическая дата" .
     1176     end.
     1177     define variable v-fact-date-num as integer no-undo .
     1178     assign
     1179       v-fact-date-num = integer(p-fact-date)
     1180     .
     1181     if p-fact-num = ?
     1182     or p-fact-num = 0
     1183     then do:
     1184       return error "Не задан p-fact-num " + string(p-fact-num) .
     1185     end.
     1186     if p-fact-num < 0
     1187     then do:
     1188       return error "Отрицательный fact-num " + string(p-fact-num) .
     1189     end.
     1190     if p-fact-num >= 100000000
     1191     then do:
     1192       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     1193     end.
     1194     if p-shift-on = true
     1195     then do:
     1196       if p-shift-date = ?
     1197       then do:
     1198         return error "Не задана дата смены" .
     1199       end.
     1200       if p-shift-num = ?
     1201       or p-shift-num = 0
     1202       then do:
     1203         return error "Не задан номер смены" .
     1204       end.
     1205     end.
     1206     else do:
     1207       assign
     1208         p-shift-date = p-fact-date
     1209         p-shift-num  = 24
     1210       .
     1211     end.
     1212     define variable v-shift-offset as integer no-undo .
     1213     if p-shift-date = p-fact-date
     1214     then do:
     1215       assign
     1216         v-shift-offset = 1
     1217       .
     1218     end.
     1219     if p-shift-date < p-fact-date
     1220     then do:
     1221       assign
     1222         v-shift-offset = 0
     1223       .
     1224     end.
     1225     if p-shift-date > p-fact-date
     1226     then do:
     1227       message
     1228         vss-workfile vss-revision vss-description skip
     1229         "Неправильная дата закрытия смены" skip
     1230         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     1231         view-as alert-box error .
     1232       undo, return error
     1233         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     1234           ,string(p-fact-date, '99/99/9999':U)
     1235           ,string(p-shift-date, '99/99/9999':U)
     1236           )
     1237       .
     1238     end.
     1239     if p-shift-num < 1
     1240     or p-shift-num > 24
     1241     then do:
     1242       message
     1243         vss-workfile vss-revision vss-description skip
     1244         "Неправильный номер смены" skip
     1245         "p-shift-num" p-shift-num skip
     1246         view-as alert-box error .
     1247       undo, return error return-value .
     1248     end.
     1249     assign
     1250       p-fact-order           = v-fact-date-num
     1251                              + v-shift-offset * 0.5
     1252                              + p-shift-num    * 0.02 - 0.01
     1253                              + p-fact-num     * 0.0000000001
     1254       p-shift-end-fact-order = v-fact-date-num
     1255                              + v-shift-offset * 0.5
     1256                              + p-shift-num    * 0.02
     1257       p-day-end-fact-order   = v-fact-date-num
     1258                              + 0.99
     1259     .
     1260     if p-fact-order           <= v-fact-date-num
     1261     or p-shift-end-fact-order <= v-fact-date-num
     1262     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     1263     or p-shift-end-fact-order >= p-day-end-fact-order
     1264     then do:
     1265       message
     1266         vss-workfile vss-revision vss-description skip
     1267         "Внутренняя ошибка при генерации фактического номера" skip
     1268         "p-fact-date"            p-fact-date            skip
     1269         "p-fact-time"            p-fact-time            skip
     1270         "p-fact-num"             p-fact-num             skip
     1271         "p-shift-date"           p-shift-date           skip
     1272         "p-shift-num"            p-shift-num            skip
     1273         "p-shift-on"             p-shift-on             skip
     1274         "p-shift-end-fact-order" p-shift-end-fact-order skip
     1275         "p-day-end-fact-order"   p-day-end-fact-order   skip
     1276         "v-fact-date-num"        v-fact-date-num        skip
     1277         view-as alert-box error .
     1278       undo, return error return-value .
     1279     end.
     1280   end procedure.
     1281   procedure day-begin-fact-order :
     1282     define input  parameter p-fact-date            as date    no-undo .
     1283     define output parameter p-day-begin-fact-order as decimal no-undo .
     1284     do
     1285     on error undo, return error return-value
     1286     :
     1287       if p-fact-date = ?
     1288       then do:
     1289         assign
     1290           p-day-begin-fact-order = 0
     1291         .
     1292       end.
     1293       else do:
     1294         assign
     1295           p-day-begin-fact-order = integer(p-fact-date)
     1296         .
     1297       end.
     1298     end.
     1299   end procedure.
     1300   procedure factord-max-fact-order :
     1301     define output parameter p-max-fact-order as decimal   no-undo .
     1302     do
     1303     on error undo, return error return-value
     1304     :
     1305       run day-begin-fact-order in this-procedure
     1306         (input  date(1, 1, 5000)
     1307         ,output p-max-fact-order
     1308         ) .
     1309     end.
     1310   end procedure.
     1311   procedure factord-cut-archive :
     1312     define input  parameter p-obj-type             as character no-undo .
     1313     define input  parameter p-obj-code             as integer   no-undo .
     1314     define input  parameter p-fact-date            as date      no-undo .
     1315     define output parameter p-shift-on             as logical   no-undo .
     1316     define output parameter p-shift-date           as date      no-undo .
     1317     define output parameter p-shift-num            as integer   no-undo .
     1318     define output parameter p-day-end-fact-order   as decimal   no-undo .
     1319     define output parameter p-shift-end-fact-order as decimal   no-undo .
     1320     define variable v-fact-order as decimal   no-undo .
     1321     define buffer buf_shift-obj for ub.shift-obj .
     1322     do
     1323     on error undo, return error return-value
     1324     :
     1325   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1326   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1327     (input  p-obj-type
     1328     ,input  p-obj-code
     1329     ,input  'shift-on=request'
     1330     ,output p-shift-on
     1331     ) no-error .
     1332       if error-status :error
     1333       then do:
     1334         message
     1335           vss-workfile vss-revision vss-description skip
     1336           "Ошибка при определении атрибута объекта" skip
     1337           "Объект" p-obj-type p-obj-code skip
     1338           error-status :get-message(1) skip
     1339           return-value skip
     1340           view-as alert-box error .
     1341         undo, return error return-value .
     1342       end.
     1343       if p-shift-on = false
     1344       then do:
     1345         assign
     1346           p-shift-date               = ?
     1347           p-shift-num                = 0
     1348         .
     1349       end.
     1350       else do:
     1351         find first buf_shift-obj share-lock
     1352           where buf_shift-obj.obj-type   = p-obj-type
     1353             and buf_shift-obj.obj-code   = p-obj-code
     1354             and buf_shift-obj.shift-date > p-fact-date
     1355           use-index pi
     1356           no-error .
     1357         if not available buf_shift-obj
     1358         or buf_shift-obj.status_ <> 'зкр':U
     1359         then do:
     1360           message
     1361             vss-workfile vss-revision vss-description skip
     1362             "Невозможно вычислить последнюю смену" skip
     1363             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1364             "Объект" p-obj-type p-obj-code skip
     1365             "Дата" p-fact-date skip
     1366             view-as alert-box error .
     1367           undo, return error return-value .
     1368         end.
     1369         find last buf_shift-obj share-lock
     1370           where buf_shift-obj.obj-type = p-obj-type
     1371             and buf_shift-obj.obj-code = p-obj-code
     1372             and buf_shift-obj.shift-date <= p-fact-date
     1373           use-index pi
     1374           no-error .
     1375         if available buf_shift-obj
     1376         then do:
     1377           if  buf_shift-obj.status_ = 'зкр':U
     1378           then do:
     1379             assign
     1380               p-shift-date = buf_shift-obj.shift-date
     1381               p-shift-num  = buf_shift-obj.shift-num
     1382             .
     1383           end.
     1384           else do:
     1385             message
     1386               vss-workfile vss-revision vss-description skip
     1387               "Невозможно вычислить последнюю смену" skip
     1388               "Статус смены отличен от статуса" 'зкр':U skip
     1389               "Объект" p-obj-type p-obj-code skip
     1390               "Дата" p-fact-date skip
     1391               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1392               view-as alert-box error .
     1393             undo, return error return-value .
     1394           end.
     1395         end.
     1396         else do:
     1397           assign
     1398             p-shift-date = p-fact-date - 1
     1399             p-shift-num  = 1
     1400           .
     1401         end.
     1402       end.
     1403       run factord in this-procedure
     1404         (input  p-fact-date
     1405         ,input  1
     1406         ,input  1
     1407         ,input  p-shift-date
     1408         ,input  p-shift-num
     1409         ,input  p-shift-on
     1410         ,output v-fact-order
     1411         ,output p-shift-end-fact-order
     1412         ,output p-day-end-fact-order
     1413         ) no-error .
     1414       if error-status :error
     1415       then do:
     1416         message
     1417           vss-workfile vss-revision vss-description skip
     1418           "Ошибка при вызове процедуры factord"
     1419           error-status :get-message(1) skip
     1420           return-value skip
     1421           view-as alert-box error .
     1422         undo, return error return-value .
     1423       end.
     1424     end.
     1425   end procedure.
     1426   procedure factord-lock-shift :
     1427     define input  parameter p-obj-type  as character no-undo .
     1428     define input  parameter p-obj-code  as integer   no-undo .
     1429     define input  parameter p-fact-date as date      no-undo .
     1430     define parameter buffer buf_shift-obj for ub.shift-obj .
     1431     define variable v-shift-on      as logical   no-undo .
     1432     define variable v-extra-message as character no-undo .
     1433     define variable v-error as character no-undo .
     1434     do
     1435     on error undo, return error return-value
     1436     :
     1437   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1438   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1439     (input  p-obj-type
     1440     ,input  p-obj-code
     1441     ,input  'shift-on=request'
     1442     ,output v-shift-on
     1443     ) no-error .
     1444       if error-status :error
     1445       then do:
     1446         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1447         undo, return error v-error .
     1448       end.
     1449       if v-shift-on = true
     1450       then do:
     1451         find first buf_shift-obj share-lock
     1452           where buf_shift-obj.obj-type   = p-obj-type
     1453             and buf_shift-obj.obj-code   = p-obj-code
     1454             and buf_shift-obj.shift-date > p-fact-date
     1455           use-index pi
     1456           no-error .
     1457         if not available buf_shift-obj
     1458         or buf_shift-obj.status_ <> 'зкр':U
     1459         then do:
     1460           find last buf_shift-obj
     1461             where buf_shift-obj.obj-type = p-obj-type
     1462               and buf_shift-obj.obj-code = p-obj-code
     1463               and buf_shift-obj.status_  = 'зкр':U
     1464             use-index stts
     1465             no-error .
     1466           if available buf_shift-obj
     1467           then do:
     1468             assign
     1469               v-extra-message =
     1470                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1471                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1472                               )
     1473             .
     1474           end.
     1475           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1476           undo, return error v-error .
     1477         end.
     1478       end.
     1479     end.
     1480   end procedure.
     1481   procedure factord-end-day :
     1482     define input  parameter p-fact-date            as date    no-undo .
     1483     define output parameter p-day-end-fact-order   as decimal no-undo .
     1484     do
     1485     on error undo, return error return-value
     1486     :
     1487       if p-fact-date = ?
     1488       then do:
     1489         return error "Не указана фактическая дата" .
     1490       end.
     1491       assign
     1492         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1493       .
     1494     end.
     1495   end procedure.
     1496   procedure factord-to-date :
     1497     define input  parameter p-fact-order as decimal no-undo .
     1498     define output parameter p-fact-date  as date    no-undo .
     1499     define variable v-ref-date  as date      no-undo .
     1500     define variable v-ref-delta as integer   no-undo .
     1501     do
     1502     on error undo, return error return-value
     1503     :
     1504       if p-fact-order = ?
     1505       or p-fact-order = 0
     1506       then do:
     1507         return error "Не указан fact-order" .
     1508       end.
     1509       assign
     1510         v-ref-date  = date(1, 1, 2000)
     1511       .
     1512       assign
     1513         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1514       .
     1515       assign
     1516         p-fact-date = v-ref-date + v-ref-delta
     1517       .
     1518     end.
     1519   end procedure.
     1520   procedure factord-to-fact-num :
     1521     define input  parameter p-fact-order as decimal no-undo .
     1522     define output parameter p-fact-num   as integer no-undo .
     1523     define variable v-fact-order-trunc as decimal no-undo .
     1524     do
     1525     on error undo, return error return-value
     1526     :
     1527       if p-fact-order = ?
     1528       or p-fact-order = 0
     1529       then do:
     1530         return error "Не указан fact-order" .
     1531       end.
     1532       assign
     1533        v-fact-order-trunc = truncate(p-fact-order, 2)
     1534       .
     1535       assign
     1536         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1537       .
     1538     end.
     1539   end procedure.
     1540   procedure factord-to-shift-num :
     1541     define input  parameter p-fact-order as decimal no-undo .
     1542     define output parameter p-shift-num   as integer no-undo .
     1543     define variable  p-shift-numd  as decimal   no-undo .
     1544     define variable v-fact-order-trunc as decimal no-undo .
     1545     do
     1546     on error undo, return error return-value
     1547     :
     1548       if p-fact-order = ?
     1549       or p-fact-order = 0
     1550       then do:
     1551         return error "Не указан fact-order" .
     1552       end.
     1553       assign
     1554        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1555       .
     1556       if v-fact-order-trunc < 0.5 then do:
     1557         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1558       end.
     1559       assign
     1560         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1561         .
     1562        assign
     1563         p-shift-num = truncate (p-shift-numd , 0)
     1564       .
     1565     end.
     1566   end procedure.
