     1344     end.
     1345     else do:
     1346       for each out-vatp_gds-dtl where out-vatp_gds-dtl.doc-code  = trn-doc.doc-code  and
     1347                                          out-vatp_gds-dtl.artic     = doc-line.artic     and
     1348                                          out-vatp_gds-dtl.prod-type = doc-line.prod-type and
     1349                                          out-vatp_gds-dtl.prod-code = doc-line.prod-code no-lock :
     1350         if varoutvprb = "base":u then do:
     1351           assign
     1352             varcurprice-base = out-vatp_gds-dtl.cur-base
     1353             varcurprice-rubl = out-vatp_gds-dtl.cur-base * ((out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl) / (out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base)).
     1354         end.
     1355         else do:
     1356           assign
     1357             varcurprice-base = out-vatp_gds-dtl.cur-base / ((out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl) / (out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base))
     1358             varcurprice-rubl = out-vatp_gds-dtl.cur-base.
     1359         end.
     1360         assign
     1361                varsum-base-factovp = varsum-base-factovp + (out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base)                 * out-vatp_gds-dtl.fact-qnty
     1362          varslt-base-factovp = varslt-base-factovp + (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base                - road-tax-base-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc)                   * out-vatp_gds-dtl.fact-qnty
     1363          varvat-base-factovp = varvat-base-factovp + (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base                - road-tax-base-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-base-sale) * doc-line.vat-pc / (100 + doc-line.vat-pc)                   * out-vatp_gds-dtl.fact-qnty
     1364          varvatcons-base-factovp = varvatcons-base-factovp + (((out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base                - road-tax-base-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-base-sale - varprice-base-cons) * doc-line.cons-vat-pc / (100 + doc-line.cons-vat-pc) * out-vatp_gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base                - road-tax-base-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-base-sale) * doc-line.vat-pc / (100 + doc-line.vat-pc) * out-vatp_gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty)
     1365          vardsc-base-factovp = vardsc-base-factovp + out-vatp_gds-dtl.discnt-base * out-vatp_gds-dtl.fact-qnty
     1366          varsum-base-docovp  = varsum-base-docovp  + (out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base)                 * out-vatp_gds-dtl.doc-qnty
     1367          varslt-base-docovp  = varslt-base-docovp  + (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base                - road-tax-base-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc)                   * out-vatp_gds-dtl.doc-qnty
     1368          varvat-base-docovp  = varvat-base-docovp  + (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base                - road-tax-base-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-base-sale) * doc-line.vat-pc / (100 + doc-line.vat-pc)                   * out-vatp_gds-dtl.doc-qnty
     1369          varvatcons-base-docovp  = varvatcons-base-docovp  + (((out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base                - road-tax-base-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-base-sale - varprice-base-cons) * doc-line.cons-vat-pc / (100 + doc-line.cons-vat-pc) * out-vatp_gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-base - out-vatp_gds-dtl.discnt-base                - road-tax-base-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-base-sale) * doc-line.vat-pc / (100 + doc-line.vat-pc) * out-vatp_gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty)
     1370          vardsc-base-docovp  = vardsc-base-docovp  + out-vatp_gds-dtl.discnt-base * out-vatp_gds-dtl.doc-qnty
     1371         .
     1372         assign
     1373                varsum-rubl-factovp = varsum-rubl-factovp + (out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl)                 * out-vatp_gds-dtl.fact-qnty
     1374          varslt-rubl-factovp = varslt-rubl-factovp + (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc)                   * out-vatp_gds-dtl.fact-qnty
     1375          varvat-rubl-factovp = varvat-rubl-factovp + (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-rubl-sale) * doc-line.vat-pc / (100 + doc-line.vat-pc)                   * out-vatp_gds-dtl.fact-qnty
     1376          varvatcons-rubl-factovp = varvatcons-rubl-factovp + (((out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * doc-line.cons-vat-pc / (100 + doc-line.cons-vat-pc) * out-vatp_gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-rubl-sale) * doc-line.vat-pc / (100 + doc-line.vat-pc) * out-vatp_gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty)
     1377          vardsc-rubl-factovp = vardsc-rubl-factovp + out-vatp_gds-dtl.discnt-rubl * out-vatp_gds-dtl.fact-qnty
     1378          varsum-rubl-docovp  = varsum-rubl-docovp  + (out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl)                 * out-vatp_gds-dtl.doc-qnty
     1379          varslt-rubl-docovp  = varslt-rubl-docovp  + (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc)                   * out-vatp_gds-dtl.doc-qnty
     1380          varvat-rubl-docovp  = varvat-rubl-docovp  + (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-rubl-sale) * doc-line.vat-pc / (100 + doc-line.vat-pc)                   * out-vatp_gds-dtl.doc-qnty
     1381          varvatcons-rubl-docovp  = varvatcons-rubl-docovp  + (((out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * doc-line.cons-vat-pc / (100 + doc-line.cons-vat-pc) * out-vatp_gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-rubl-sale) * doc-line.vat-pc / (100 + doc-line.vat-pc) * out-vatp_gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty)
     1382          vardsc-rubl-docovp  = vardsc-rubl-docovp  + out-vatp_gds-dtl.discnt-rubl * out-vatp_gds-dtl.doc-qnty   .
     1383       end.
     1384       if trn-doc.doc-type = 'инв':U then do:
     1385         ASSIGN
     1386                   price-base-with-tax-sale    = varsum-base-docovp / varfact-qnty
     1387           slt-base-sale               = varslt-base-docovp / varfact-qnty
     1388           vat-base-buyer              = varvat-base-docovp / varfact-qnty
     1389           discnt-base-sale            = vardsc-base-docovp / varfact-qnty
     1390           vat-base-sale               = varvatcons-base-docovp / varfact-qnty
     1391                   price-rubl-with-tax-sale    = varsum-rubl-docovp / varfact-qnty
     1392           slt-rubl-sale               = varslt-rubl-docovp / varfact-qnty
     1393           vat-rubl-buyer              = varvat-rubl-docovp / varfact-qnty
     1394           discnt-rubl-sale            = vardsc-rubl-docovp / varfact-qnty
     1395           vat-rubl-sale               = varvatcons-rubl-docovp / varfact-qnty.
     1396       end.
     1397       else do:
     1398         ASSIGN
     1399                   price-base-with-tax-sale    = varsum-base-factovp / varfact-qnty
     1400           slt-base-sale               = varslt-base-factovp / varfact-qnty
     1401           vat-base-buyer              = varvat-base-factovp / varfact-qnty
     1402           discnt-base-sale            = vardsc-base-factovp / varfact-qnty
     1403           vat-base-sale               = varvatcons-base-factovp / varfact-qnty
     1404                   price-rubl-with-tax-sale    = varsum-rubl-factovp / varfact-qnty
     1405           slt-rubl-sale               = varslt-rubl-factovp / varfact-qnty
     1406           vat-rubl-buyer              = varvat-rubl-factovp / varfact-qnty
     1407           discnt-rubl-sale            = vardsc-rubl-factovp / varfact-qnty
     1408           vat-rubl-sale               = varvatcons-rubl-factovp / varfact-qnty.
     1409       end.
     1410     end.
     1411   end.
     1412   assign
     1413     price-base-without-tax-sale = price-base-with-tax-sale - vat-base-sale - slt-base-sale - road-tax-base-sale
     1414     price-rubl-without-tax-sale = price-rubl-with-tax-sale - vat-rubl-sale - slt-rubl-sale - road-tax-rubl-sale.
     1415                                                                                        ~
     1416   end procedure.
     1417   procedure cr-tt-doc-line:
     1418   find first tt-doc-line where tt-doc-line.artic     = doc-line.artic     and
     1419                                tt-doc-line.prod-type = doc-line.prod-type and
     1420                                tt-doc-line.prod-code = doc-line.prod-code no-error.
     1421   if not available tt-doc-line then do:
     1422        create tt-doc-line.
     1423        ASSIGN tt-doc-line.artic             =  doc-line.artic
     1424               tt-doc-line.prod-type         =  doc-line.prod-type
     1425               tt-doc-line.prod-code         =  doc-line.prod-code
     1426               tt-doc-line.gds-type          =  goods.gds-type
     1427               tt-doc-line.grp-code          =  goods.grp-code
     1428               tt-doc-line.gds-name          =  goods.gds-name
     1429               tt-doc-line.gds-unit-base     =  goods.unit-base.
     1430   end.
     1431   end procedure.
     1432   procedure as1-tt-doc-line:
     1433   ASSIGN    tt-doc-line.vat-acc            = tt-doc-line.vat-acc          + doc-line.fact-qnty * vat-pc-loc
     1434             tt-doc-line.vat-sale           = tt-doc-line.vat-sale         + doc-line.fact-qnty * doc-line.vat-pc
     1435             tt-doc-line.sum-road-tax       = tt-doc-line.sum-road-tax     + doc-line.fact-qnty * road-tax-rubl-sale
     1436             tt-doc-line.qnty               = tt-doc-line.qnty             + doc-line.fact-qnty
     1437             tt-doc-line.sum-vat-acc        = tt-doc-line.sum-vat-acc      + doc-line.fact-qnty * vat-rubl-loc
     1438             tt-doc-line.sum-vat-sale       = tt-doc-line.sum-vat-sale     + doc-line.fact-qnty * vat-rubl-sale
     1439             tt-doc-line.sum-acc            = tt-doc-line.sum-acc          + doc-line.fact-qnty * price-rubl-with-tax-loc
     1440             tt-doc-line.sum-sale           = tt-doc-line.sum-sale         + doc-line.fact-qnty * price-rubl-with-tax-sale.
     1441   end procedure.
     1442   procedure as2-tt-doc-line :
     1443   ASSIGN    tt-doc-line.vat-acc            = tt-doc-line.vat-acc          + doc-line.fact-qnty * vat-pc-loc
     1444             tt-doc-line.vat-sale           = tt-doc-line.vat-sale         + doc-line.fact-qnty * doc-line.vat-pc
     1445             tt-doc-line.sum-road-tax       = tt-doc-line.sum-road-tax     + doc-line.fact-qnty * road-tax-base-sale
     1446             tt-doc-line.qnty               = tt-doc-line.qnty             + doc-line.fact-qnty
     1447             tt-doc-line.sum-vat-acc        = tt-doc-line.sum-vat-acc      + doc-line.fact-qnty * vat-base-loc
     1448             tt-doc-line.sum-vat-sale       = tt-doc-line.sum-vat-sale     + doc-line.fact-qnty * vat-base-sale
     1449             tt-doc-line.sum-acc            = tt-doc-line.sum-acc          + doc-line.fact-qnty * price-base-with-tax-loc
     1450             tt-doc-line.sum-sale           = tt-doc-line.sum-sale         + doc-line.fact-qnty * price-base-with-tax-sale.
     1451   end procedure.
     1452   procedure as3-tt-doc-line:
     1453   for each tt-doc-line:
     1454      ASSIGN
     1455      tt-doc-line.sum-acc-out-vat    = tt-doc-line.sum-acc            - tt-doc-line.sum-vat-acc
     1456      tt-doc-line.sum-sale-out-vat   = tt-doc-line.sum-sale           - tt-doc-line.sum-vat-sale
     1457      tt-doc-line.increase           = tt-doc-line.sum-sale-out-vat   - tt-doc-line.sum-road-tax
     1458      tt-doc-line.vat-acc            = tt-doc-line.vat-acc            / tt-doc-line.qnty
     1459      tt-doc-line.vat-sale           = tt-doc-line.vat-sale           / tt-doc-line.qnty
     1460      tt-doc-line.road-tax           = tt-doc-line.sum-road-tax       / tt-doc-line.qnty
     1461      tt-doc-line.price-acc          = tt-doc-line.sum-acc            / tt-doc-line.qnty
     1462      tt-doc-line.price-acc-out-vat  = tt-doc-line.sum-acc-out-vat    / tt-doc-line.qnty
     1463      tt-doc-line.price-sale         = tt-doc-line.sum-sale           / tt-doc-line.qnty
     1464      tt-doc-line.price-sale-out-vat = tt-doc-line.sum-sale-out-vat   / tt-doc-line.qnty
     1465      .
     1466   end.
     1467   end procedure.
     1468   PROCEDURE calc-gds-grp :
     1469     define input  parameter pardisp-all         as   integer               no-undo.
     1470     define input  parameter parnode-code        like gds-grp.node-code     no-undo.
     1471     define input  parameter pargrp-name         like goods.grp-name        no-undo.
     1472     define output parameter parsum-vat-acc      like doc-line.price-rubl no-undo.
     1473     define output parameter parsum-vat-sale     like doc-line.price-rubl no-undo.
     1474     define output parameter parsum-acc-out-vat  like doc-line.price-rubl no-undo.
     1475     define output parameter parsum-sale-out-vat like doc-line.price-rubl no-undo.
     1476     define output parameter parsum-sale         like doc-line.price-rubl no-undo.
     1477     define output parameter parsum-road-tax     like doc-line.price-rubl no-undo.
     1478     define output parameter parsum-qnty         like doc-line.fact-qnty    no-undo.
     1479     define variable vargrp-name-loc like goods.grp-name no-undo.
     1480     find first gds-grp where gds-grp.node-code = parnode-code no-lock.
     1481     vargrp-name-loc = pargrp-name + "\" + gds-grp.node-name.
     1482     if length(vargrp-name-loc) > 37 then vargrp-name-loc = "..." +
     1483                                          SUBSTRING(vargrp-name-loc, length(vargrp-name-loc) - 36, 37).
     1484     if can-find(first gds-grp where gds-grp.upper-code = parnode-code no-lock) then do:
     1485        for each gds-grp where gds-grp.upper-code = parnode-code no-lock:
     1486            RUN calc-gds-grp (input  pardisp-all,
     1487                              input  gds-grp.node-code,
     1488                              input  vargrp-name-loc,
     1489                              output varsum-vat-acc,
     1490                              output varsum-vat-sale,
     1491                              output varsum-acc-out-vat,
     1492                              output varsum-sale-out-vat,
     1493                              output varsum-sale,
     1494                              output varsum-road-tax,
     1495                              output varsum-qnty).
     1496            ACCUMULATE varsum-vat-acc      (total)
     1497                       varsum-vat-sale     (total)
     1498                       varsum-acc-out-vat  (total)
     1499                       varsum-sale-out-vat (total)
     1500                       varsum-sale         (total)
     1501                       varsum-road-tax     (total)
     1502                       varsum-qnty         (total).
     1503        end.
     1504        ASSIGN
     1505          parsum-vat-acc      = (ACCUM TOTAL varsum-vat-acc     )
     1506          parsum-vat-sale     = (ACCUM TOTAL varsum-vat-sale    )
     1507          parsum-acc-out-vat  = (ACCUM TOTAL varsum-acc-out-vat )
     1508          parsum-sale-out-vat = (ACCUM TOTAL varsum-sale-out-vat)
     1509          parsum-sale         = (ACCUM TOTAL varsum-sale        )
     1510          parsum-road-tax     = (ACCUM TOTAL varsum-road-tax    )
     1511          parsum-qnty         = (ACCUM TOTAL varsum-qnty        ).
     1512          if parsum-vat-acc       > 0 OR
     1513             parsum-vat-sale      > 0 OR
     1514             parsum-acc-out-vat   > 0 OR
     1515             parsum-sale-out-vat  > 0 OR
     1516             parsum-sale          > 0 OR
     1517             parsum-road-tax      > 0 OR
     1518             parsum-qnty          > 0 THEN DO:
     1519             if (pardisp-all <> 2 OR parnode-code = varroot) AND
     1520                (pardisp-all <> 4 OR parnode-code = varroot) AND
     1521                (pardisp-all <> 5 OR parnode-code = varroot) THEN
     1522             run disp-total(input vargrp-name-loc    ,
     1523                            input parsum-vat-acc     ,
     1524                            input parsum-vat-sale    ,
     1525                            input parsum-acc-out-vat ,
     1526                            input parsum-sale-out-vat,
     1527                            input parsum-sale        ,
     1528                            input parsum-road-tax    ,
     1529                            input parsum-qnty).
     1530          END.
     1531     end.
     1532     else do:
     1533          if can-find(first tt-doc-line where tt-doc-line.grp-code = gds-grp.node-code) and
     1534             pardisp-all <> 2 and
     1535             pardisp-all <> 3 and
     1536             pardisp-all <> 5 then run disp-grp-name(input vargrp-name-loc).
     1537          for each tt-doc-line where tt-doc-line.grp-code = gds-grp.node-code:
     1538              if pardisp-all <> 3 and
     1539                 pardisp-all <> 5 then run disp-tt-doc-line.
     1540              ACCUMULATE tt-doc-line.sum-vat-acc      (total)
     1541                         tt-doc-line.sum-vat-sale     (total)
     1542                         tt-doc-line.sum-acc-out-vat  (total)
     1543                         tt-doc-line.sum-sale-out-vat (total)
     1544                         tt-doc-line.sum-sale         (total)
     1545                         tt-doc-line.sum-road-tax     (total)
     1546                         tt-doc-line.qnty             (total).
     1547          end.
     1548          ASSIGN
     1549          parsum-vat-acc      = (ACCUM TOTAL tt-doc-line.sum-vat-acc     )
     1550          parsum-vat-sale     = (ACCUM TOTAL tt-doc-line.sum-vat-sale    )
     1551          parsum-acc-out-vat  = (ACCUM TOTAL tt-doc-line.sum-acc-out-vat )
     1552          parsum-sale-out-vat = (ACCUM TOTAL tt-doc-line.sum-sale-out-vat)
     1553          parsum-sale         = (ACCUM TOTAL tt-doc-line.sum-sale        )
     1554          parsum-road-tax     = (ACCUM TOTAL tt-doc-line.sum-road-tax    )
     1555          parsum-qnty         = (ACCUM TOTAL tt-doc-line.qnty            ).
     1556          find first tt-doc-line where tt-doc-line.grp-code = gds-grp.node-code no-error.
     1557          if available tt-doc-line then do:
     1558              if pardisp-all <> 2       OR
     1559                 parnode-code = varroot then
     1560              run disp-total(input vargrp-name-loc    ,
     1561                             input parsum-vat-acc     ,
     1562                             input parsum-vat-sale    ,
     1563                             input parsum-acc-out-vat ,
     1564                             input parsum-sale-out-vat,
     1565                             input parsum-sale        ,
     1566                             input parsum-road-tax    ,
     1567                             input parsum-qnty).
     1568         end.
     1569     end.
     1570   END PROCEDURE.
     1571   RUN calc-sale
     1572     (INPUT parobj-type,
     1573      INPUT parobj-code,
     1574      INPUT pardate-shift,
     1575      INPUT parstart_date,
     1576      INPUT parend_date  ,
     1577      INPUT parstart_shift_num,
     1578      INPUT parend_shift_num).
     1579   find first clients where clients.obj-code = parobj-code and
     1580                            clients.obj-type = parobj-type no-lock.
     1581   DEFINE FRAME gds-grp
     1582         sym1                          column-label ":!:"      format "X(1)"       space(0)
     1583         global-line-print             COLUMN-LABEL "Nr.crt"   format "x(10)"      space(0)
     1584         sym2                          column-label ":!:"      format "X(1)"       space(0)
     1585         tt-doc-line.artic             COLUMN-LABEL "Articol"                      space(0)
     1586         sym3                          column-label ":!:"      format "X(1)"       space(0)
     1587         tt-doc-line.gds-name          COLUMN-label "Explicatii"                   space(0)
     1588         sym4                          column-label ":!:" format "X(1)"            space(0)
     1589         tt-doc-line.gds-unit-base     column-label "UM"  format "X(3)"            space(0)
     1590         sym5                          column-label ":!:" format "X(1)"            space(0)
     1591         tt-doc-line.qnty              COLUMN-LABEL "cant."  format ">>>,>>>,>>9.<<<"        space(0)
     1592         sym6                          column-label ":!:" format "X(1)"            space(0)
     1593         tt-doc-line.increase          COLUMN-LABEL "Venit+Acciza" format ">>>,>>>,>>>,>>9.99" space(0)
     1594         sym7                          column-label ":!:" format "X(1)"            space(0)
     1595         tt-doc-line.sum-road-tax      COLUMN-LABEL "Taxa drum"                    space(0)
     1596         sym8                          column-label ":!:" format "X(1)"            space(0)
     1597         tt-doc-line.sum-sale-out-vat  column-label "Val.vanzare fara TVA" format ">>>,>>>,>>>,>>9.99" space(0)
     1598         sym9                          column-label ":!:" format "X(1)" space(0)
     1599         tt-doc-line.sum-vat-sale      COLUMN-LABEL "TVA" format ">>>,>>>,>>>,>>9.99" space(0)
     1600         sym10                         column-label ":!:" format "X(1)"         space(0)
     1601         tt-doc-line.sum-sale          column-label "Total vanzare cu TVA" format ">>>,>>>,>>>,>>9.99" space(0)
     1602         sym11                         column-label ":!:" format "X(1)" space(0)
     1603       HEADER
     1604           cur-time-print() AT 5 format "X(35)"
     1605           string( "Statia " + string(parobj-code) + " " + parobj-type + " " + clients.obj-name)   AT 40 format "X(40)"
     1606           string( "Raport vanzare marfa si carburant la date de " + string(parstart_date) + (if parstart_shift_num <> ? then ":" + string(parstart_shift_num) else " ") + " " + string(parend_date) + (if parend_shift_num <> ? then ":" + string(parend_shift_num) else " ")) AT 85 format "X(87)"
     1607           string( "Pagina " + string( PAGE-NUMBER( PrnLibStream ), ">>9" ) ) AT 180 format "X(13)" SKIP
     1608           Line format "X(184)" AT 1
     1609       with width 232 down stream-io.
     1610   if session:set-wait-state("COMPILER") then.
     1611   assign Line = fill("-", 184).
     1612   run prn-lib-open-stream  in this-procedure (
     1613                                                input parParentProc
     1614                                               ,input 43
     1615                                               ,input yes
     1616                                               ,input no
     1617                                               ).
     1618   FORM with FRAME gds-grp.
     1619   FORM HEADER
     1620       Line format "X(184)" AT 1 SKIP
     1621       "Продолжение - на следующей странице" AT 60 SKIP
     1622       with FRAME BottomFrame width 232
     1623       PAGE-BOTTOM no-labels no-box.
     1624   VIEW STREAM PrnLibStream FRAME BottomFrame .
     1625   if trim(pargdsgrp_recids) = "" then do:
     1626      message "Вы не выбрали группу товаров." view-as alert-box error.
     1627      return error.
     1628   end.
     1629   DO i = 1 TO NUM-ENTRIES(pargdsgrp_recids):
     1630      ASSIGN vargds-grp-recids = INTEGER(ENTRY(i, pargdsgrp_recids)).
     1631      find first gds-grp where recid(gds-grp) = vargds-grp-recids no-lock no-error.
     1632      if not available gds-grp then do:
     1633        message "Ошибка при опрделении групп товаров." view-as alert-box.
     1634        return error.
     1635      end.
     1636      CASE parkind:
     1637         WHEN 1 THEN ASSIGN varkind = 4.
     1638         WHEN 2 THEN ASSIGN varkind = 2.
     1639         WHEN 3 THEN ASSIGN varkind = 5.
     1640      END.
     1641      assign varroot = gds-grp.node-code.
     1642      RUN calc-gds-grp
     1643        (input  varkind,
     1644         input  gds-grp.node-code,
     1645         input  " ",
     1646         output varsum-vat-acc,
     1647         output varsum-vat-sale,
     1648         output varsum-acc-out-vat,
     1649         output varsum-sale-out-vat,
     1650         output varsum-sale,
     1651         output varsum-road-tax,
     1652         output varsum-qnty).
     1653   END.
     1654   HIDE STREAM PrnLibStream FRAME BottomFrame .
     1655   OUTPUT STREAM PrnLibStream CLOSE.
     1656   if session:set-wait-state("") then.
     1657   run prn-lib-prn-file in this-procedure (
     1658                                             input parParentProc
     1659                                             ,input 8
     1660                                             ).
     1661   PROCEDURE disp-tt-doc-line:
     1662       assign  global-line-num = global-line-num + 1.
     1663       display stream PrnLibStream
     1664         sym1                          column-label ":!:" format "X(1)"            space(0)
     1665         string(global-line-num) @     global-line-print
     1666                                       COLUMN-LABEL "Nr.crt"   format "x(10)"      space(0)
     1667         sym2                          column-label ":!:"      format "X(1)"       space(0)
     1668         tt-doc-line.artic             COLUMN-LABEL "Articol"                      space(0)
     1669         sym3                          column-label ":!:"      format "X(1)"       space(0)
     1670         tt-doc-line.gds-name          COLUMN-label "Explicatii"                   space(0)
     1671         sym4                          column-label ":!:" format "X(1)"            space(0)
     1672         tt-doc-line.gds-unit-base     column-label "UM"  format "X(3)"            space(0)
     1673         sym5                          column-label ":!:" format "X(1)"            space(0)
     1674         tt-doc-line.qnty              COLUMN-LABEL "cant."  format ">>>,>>>,>>9.<<<"        space(0)
     1675         sym6                          column-label ":!:" format "X(1)"            space(0)
     1676         tt-doc-line.increase          COLUMN-LABEL "Venit+Acciza" format ">>>,>>>,>>>,>>9.99" space(0)
     1677         sym7                          column-label ":!:" format "X(1)"            space(0)
     1678         tt-doc-line.sum-road-tax      COLUMN-LABEL "Taxa drum"                    space(0)
     1679         sym8                          column-label ":!:" format "X(1)"            space(0)
     1680         tt-doc-line.sum-sale-out-vat  column-label "Val.vanzare fara TVA" format ">>>,>>>,>>>,>>9.99" space(0)
     1681         sym9                          column-label ":!:" format "X(1)" space(0)
     1682         tt-doc-line.sum-vat-sale      COLUMN-LABEL "TVA" format ">>>,>>>,>>>,>>9.99" space(0)
     1683         sym10                         column-label ":!:" format "X(1)"         space(0)
     1684         tt-doc-line.sum-sale          column-label "Total vanzare cu TVA" format ">>>,>>>,>>>,>>9.99" space(0)
     1685         sym11                         column-label ":!:" format "X(1)" space(0)
     1686         with frame gds-grp.
     1687   DOWN STREAM PrnLibStream 1 with FRAME gds-grp.
     1688   PUT STREAM PrnLibStream Line format "X(184)" SKIP.
     1689   END PROCEDURE.
     1690   PROCEDURE disp-total:
     1691   define input parameter pardispgrp-name         as   character             no-undo.
     1692   define input parameter pardispsum-vat-acc      like doc-line.price-rubl   no-undo.
     1693   define input parameter pardispsum-vat-sale     like doc-line.price-rubl   no-undo.
     1694   define input parameter pardispsum-acc-out-vat  like doc-line.price-rubl   no-undo.
     1695   define input parameter pardispsum-sale-out-vat like doc-line.price-rubl   no-undo.
     1696   define input parameter pardispsum-sale         like doc-line.price-rubl   no-undo.
     1697   define input parameter pardispsum-road-tax     like doc-line.price-rubl   no-undo.
     1698   define input parameter pardispsum-qnty         like doc-line.fact-qnty    no-undo.
     1699   display stream PrnLibStream
     1700         sym1                          column-label ":!:" format "X(1)"            space(0)
     1701         "TOTAL" @ global-line-print   COLUMN-LABEL "Nr.crt"   format "x(10)"      space(0)
     1702         sym2                          column-label ":!:"      format "X(1)"       space(0)
     1703         sym3                          column-label ":!:"      format "X(1)"       space(0)
     1704         pardispgrp-name         @
     1705         tt-doc-line.gds-name          COLUMN-label "Explicatii"                   space(0)
     1706         sym4                          column-label ":!:" format "X(1)"            space(0)
     1707         sym5                          column-label ":!:" format "X(1)"            space(0)
     1708         pardispsum-qnty         @
     1709         tt-doc-line.qnty              COLUMN-LABEL "cant."  format ">>>,>>>,>>9.<<<"        space(0)
     1710         sym6                          column-label ":!:" format "X(1)"            space(0)
     1711         pardispsum-sale     -
     1712         pardispsum-vat-sale -
     1713         pardispsum-road-tax     @
     1714         tt-doc-line.increase          COLUMN-LABEL "Venit+Acciza" format ">>>,>>>,>>>,>>9.99" space(0)
     1715         sym7                          column-label ":!:" format "X(1)"            space(0)
     1716         pardispsum-road-tax     @
     1717         tt-doc-line.sum-road-tax      COLUMN-LABEL "Taxa drum"                    space(0)
     1718         sym8                          column-label ":!:" format "X(1)"            space(0)
     1719         pardispsum-sale-out-vat @
     1720         tt-doc-line.sum-sale-out-vat  column-label "Val.vanzare fara TVA" format ">>>,>>>,>>>,>>9.99" space(0)
     1721         sym9                          column-label ":!:" format "X(1)" space(0)
     1722         pardispsum-vat-sale     @
     1723         tt-doc-line.sum-vat-sale       COLUMN-LABEL "TVA" format ">>>,>>>,>>>,>>9.99" space(0)
     1724         sym10                         column-label ":!:" format "X(1)"         space(0)
     1725         pardispsum-sale         @
     1726         tt-doc-line.sum-sale          column-label "Total vanzare cu TVA" format ">>>,>>>,>>>,>>9.99" space(0)
     1727         sym11                         column-label ":!:" format "X(1)" space(0)
     1728   with frame gds-grp.
     1729   DOWN STREAM PrnLibStream 1 with FRAME gds-grp.
     1730   PUT STREAM PrnLibStream Line format "X(184)" SKIP.
     1731   END PROCEDURE.
     1732   PROCEDURE disp-grp-name:
     1733   define input parameter pargrp-name like goods.grp-name no-undo.
     1734   display stream PrnLibStream
     1735         sym1                          column-label ":!:"      format "X(1)"   space(0)
     1736         "ГРУППА" @ global-line-print  COLUMN-LABEL "Nr.crt"   format "x(10)"  space(0)
     1737         sym2                          column-label ":!:"      format "X(1)"   space(0)
     1738         sym3                          column-label ":!:"      format "X(1)"   space(0)
     1739         pargrp-name             @
     1740         tt-doc-line.gds-name          COLUMN-label "Explicatii"               space(0)
     1741         sym4                          column-label ":!:" format "X(1)"        space(0)
     1742         sym5                          column-label ":!:" format "X(1)"        space(0)
     1743         sym6                          column-label ":!:" format "X(1)"        space(0)
     1744         sym7                          column-label ":!:" format "X(1)"        space(0)
     1745         sym8                          column-label ":!:" format "X(1)"        space(0)
     1746         sym9                          column-label ":!:" format "X(1)"        space(0)
     1747         sym10                         column-label ":!:" format "X(1)"        space(0)
     1748         sym11                         column-label ":!:" format "X(1)"        space(0)
     1749   with frame gds-grp.
     1750   DOWN STREAM PrnLibStream 1 with FRAME gds-grp.
     1751   PUT STREAM PrnLibStream Line format "X(184)" SKIP.
     1752   END PROCEDURE.
