        1   block-level on error undo, throw.
        2   define input parameter parparentproc      as widget-handle no-undo .
        3   define input parameter parobj-type        like trn-doc.obj-type no-undo.
        4   define input parameter parobj-code        like trn-doc.obj-code no-undo.
        5   define input parameter pargdsgrp_recids   as char               no-undo.
        6   define input parameter pardate-shift      as integer            no-undo.
        7   define input parameter parstart_date      as date               no-undo.
        8   define input parameter parstart_shift_num as integer            no-undo.
        9   define input parameter parend_date        as date               no-undo.
       10   define input parameter parend_shift_num   as integer            no-undo.
       11   define input parameter parkind            as integer            no-undo.
       12   def var vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       13   def var vss-author      as character no-undo init "$Author: expertek $":U .
       14   def var vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
