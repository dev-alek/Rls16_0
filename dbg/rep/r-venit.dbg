      929   PROCEDURE calc-sale :
      930   DEFINE INPUT PARAMETER parobj-type   LIKE ub.clients.obj-type NO-UNDO.
      931   DEFINE INPUT PARAMETER parobj-code   LIKE ub.clients.obj-code NO-UNDO.
      932   DEFINE INPUT PARAMETER pardate-shift AS   INTEGER    NO-UNDO.
      933   DEFINE INPUT PARAMETER parstart-date AS   DATE       NO-UNDO.
      934   DEFINE INPUT PARAMETER parend-date   AS   DATE       NO-UNDO.
      935   DEFINE INPUT PARAMETER parstart_shift_num AS INTEGER NO-UNDO.
      936   DEFINE INPUT PARAMETER parend_shift_num   AS INTEGER NO-UNDO.
      937   define variable varr-b as character no-undo.
      938   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      939   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      940     (output varr-b
      941     )  .
      942   run waitfram-show in this-procedure ("Сбор данных о продажах").
      943   CASE pardate-shift:
      944   WHEN 1 THEN DO:
      945      for each trn-doc where trn-doc.obj-type    = parobj-type   and                                           trn-doc.obj-code    = parobj-code   and                                           trn-doc.status_     = 'факт':U       and
      946      trn-doc.fact-date  >= parstart-date   and
      947      trn-doc.fact-date  <= parend-date     and
      948      trn-doc.internal    = no           and                                                                                              trn-doc.doc-type    = 'рас':U   and                                                                                              trn-doc.discnt-type = 'касс':U no-lock ,                                                                         each doc-line where doc-line.doc-code = trn-doc.doc-code no-lock,                                                                        first goods where goods.artic     = doc-line.artic     and                                                                                            goods.prod-type = doc-line.prod-type and                                                                                            goods.prod-code = doc-line.prod-code no-lock:                                                               run calc-in-out in this-procedure.        run cr-tt-doc-line in this-procedure.                                                                                             if varr-b = "rubl":u then do:          run as1-tt-doc-line in this-procedure.        end.        else do:          run as2-tt-doc-line in this-procedure.        end. end.
      949   END.
      950   WHEN 2 THEN DO:
      951      for each trn-doc where trn-doc.obj-type    = parobj-type   and                                           trn-doc.obj-code    = parobj-code   and                                           trn-doc.status_     = 'факт':U       and
      952      trn-doc.shift-date >= parstart-date   and
      953      trn-doc.shift-date <= parend-date     and
      954      trn-doc.internal    = no           and                                                                                              trn-doc.doc-type    = 'рас':U   and                                                                                              trn-doc.discnt-type = 'касс':U no-lock ,                                                                         each doc-line where doc-line.doc-code = trn-doc.doc-code no-lock,                                                                        first goods where goods.artic     = doc-line.artic     and                                                                                            goods.prod-type = doc-line.prod-type and                                                                                            goods.prod-code = doc-line.prod-code no-lock:                                                               run calc-in-out in this-procedure.        run cr-tt-doc-line in this-procedure.                                                                                             if varr-b = "rubl":u then do:          run as1-tt-doc-line in this-procedure.        end.        else do:          run as2-tt-doc-line in this-procedure.        end. end.
      955   END.
      956   WHEN 3 THEN DO:
      957      for each trn-doc where trn-doc.obj-type    = parobj-type   and                                           trn-doc.obj-code    = parobj-code   and                                           trn-doc.status_     = 'факт':U       and
      958      (trn-doc.shift-date  > parstart-date       or
      959       trn-doc.shift-date  = parstart-date       and
      960       trn-doc.shift-num  >= parstart_shift_num) and
      961      (trn-doc.shift-date  < parend-date         or
      962       trn-doc.shift-date  = parend-date         and
      963       trn-doc.shift-num  <= parend_shift_num)   and
      964      trn-doc.internal    = no           and                                                                                              trn-doc.doc-type    = 'рас':U   and                                                                                              trn-doc.discnt-type = 'касс':U no-lock ,                                                                         each doc-line where doc-line.doc-code = trn-doc.doc-code no-lock,                                                                        first goods where goods.artic     = doc-line.artic     and                                                                                            goods.prod-type = doc-line.prod-type and                                                                                            goods.prod-code = doc-line.prod-code no-lock:                                                               run calc-in-out in this-procedure.        run cr-tt-doc-line in this-procedure.                                                                                             if varr-b = "rubl":u then do:          run as1-tt-doc-line in this-procedure.        end.        else do:          run as2-tt-doc-line in this-procedure.        end. end.
      965   END.
      966   WHEN 4 THEN DO:
      967      for each trn-doc where trn-doc.obj-type    = parobj-type   and                                           trn-doc.obj-code    = parobj-code   and                                           trn-doc.status_     = 'факт':U       and
      968      trn-doc.shift-date >= parstart-date      and
      969      trn-doc.shift-num   = parstart_shift_num and
      970      trn-doc.shift-date <= parend-date        and
      971      trn-doc.shift-num   = parend_shift_num   and
      972      trn-doc.internal    = no           and                                                                                              trn-doc.doc-type    = 'рас':U   and                                                                                              trn-doc.discnt-type = 'касс':U no-lock ,                                                                         each doc-line where doc-line.doc-code = trn-doc.doc-code no-lock,                                                                        first goods where goods.artic     = doc-line.artic     and                                                                                            goods.prod-type = doc-line.prod-type and                                                                                            goods.prod-code = doc-line.prod-code no-lock:                                                               run calc-in-out in this-procedure.        run cr-tt-doc-line in this-procedure.                                                                                             if varr-b = "rubl":u then do:          run as1-tt-doc-line in this-procedure.        end.        else do:          run as2-tt-doc-line in this-procedure.        end. end.
      973   END.
      974   END CASE.
      975   run as3-tt-doc-line in this-procedure.
      976   run waitfram-hide in this-procedure .
      977   END PROCEDURE.
      978   procedure calc-in-out :
      979   assign
      980     price-rubl-with-tax-loc = doc-line.price-rubl
      981     price-base-with-tax-loc = doc-line.price-base
      982   .
      983   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      984   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      985     (output varinvprb
      986     )  .
      987      find first in-vatp_doc-attr no-lock
      988       where in-vatp_doc-attr.doc-code  = trn-doc.doc-code
      989         and in-vatp_doc-attr.attr-code = 'envd':U
      990       no-error .
      991       if available in-vatp_doc-attr
      992          then do:
      993          assign
      994            in-vatp-have-vat-slt = no.
      995      end.
      996      else do:
      997        assign
      998          in-vatp-have-vat-slt = yes.
      999      end.
     1000      find first in-vatp-goods where in-vatp-goods.artic     = doc-line.artic     and
     1001                                        in-vatp-goods.prod-type = doc-line.prod-type and
     1002                                        in-vatp-goods.prod-code = doc-line.prod-code no-lock.
     1003      if (not trn-doc.internal and
     1004              trn-doc.doc-type = 'при':U) or
     1005         in-vatp-goods.gds-type = 'у':U then do:
     1006         if varinvprb = "base":u then do:
     1007           assign
     1008             road-tax-base-loc = doc-line.road-tax
     1009             road-tax-rubl-loc = doc-line.road-tax * trn-doc.base-rate / trn-doc.base-scale.
     1010         end.
     1011         else do:
     1012           ASSIGN
     1013             road-tax-rubl-loc = doc-line.road-tax
     1014             road-tax-base-loc = doc-line.road-tax / trn-doc.base-rate * trn-doc.base-scale.
     1015         end.
     1016         if road-tax-base-loc = ? then road-tax-base-loc = 0.
     1017         if road-tax-rubl-loc = ? then road-tax-rubl-loc = 0.
     1018         assign
     1019           road-tax-cli-loc = ?.
     1020         ASSIGN
     1021           transport-base-loc = (if doc-line.transport-base = ? then 0 else doc-line.transport-base)
     1022           transport-rubl-loc = (if doc-line.transport-rubl = ? then 0 else doc-line.transport-rubl)
     1023           transport-cli-loc  = 0
     1024           other-base-loc     = (if doc-line.other-base     = ? then 0 else doc-line.other-base)
     1025           other-rubl-loc     = (if doc-line.other-rubl     = ? then 0 else doc-line.other-rubl)
     1026           other-cli-loc      = 0
     1027           vat-pc-loc         = (if doc-line.vat-pc         = ? then 0 else doc-line.vat-pc)
     1028           slt-pc-loc         = (if doc-line.slt-pc         = ? then 0 else doc-line.slt-pc).
     1029                                 ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1030               ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1031         assign
     1032           vat-cli-loc            = ?
     1033           slt-cli-loc            = ?
     1034           price-cli-with-tax-loc = ?.
     1035      end.
     1036      else do:
     1037                                                   for each in-vatp-parts where in-vatp-parts.out-code  = doc-line.doc-code  and
     1038                                         in-vatp-parts.obj-type  = doc-line.obj-type  and
     1039                                         in-vatp-parts.obj-code  = doc-line.obj-code  and
     1040                                         in-vatp-parts.artic     = doc-line.artic     and
     1041                                         in-vatp-parts.prod-type = doc-line.prod-type and
     1042                                         in-vatp-parts.prod-code = doc-line.prod-code
     1043                            use-index out-code no-lock:
     1044             accumulate  in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty (total)
     1045                         in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty (total)
     1046                         in-vatp-parts.transport-base * in-vatp-parts.fact-qnty (total)
     1047                         in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty (total)
     1048                         in-vatp-parts.other-base     * in-vatp-parts.fact-qnty (total)
     1049                         in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty (total)
     1050                                                                                                                 (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  (total)
     1051                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
     1052                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))  (total)
     1053                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc))  (total)
     1054                                               (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  (total)
     1055                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
     1056                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))  (total)
     1057                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc))  (total)
     1058                         .
     1059         end.
     1060         ASSIGN
     1061           road-tax-base-loc   = if doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty) / doc-line.fact-qnty  else 0
     1062           road-tax-rubl-loc   = if doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty) / doc-line.fact-qnty  else 0
     1063           transport-base-loc  = if doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-base * in-vatp-parts.fact-qnty) / doc-line.fact-qnty  else 0
     1064           transport-rubl-loc  = if doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty) / doc-line.fact-qnty  else 0
     1065           other-base-loc      = if doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-base     * in-vatp-parts.fact-qnty) / doc-line.fact-qnty  else 0
     1066           other-rubl-loc      = if doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty) / doc-line.fact-qnty  else 0
     1067                                           vat-base-loc        = if doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / doc-line.fact-qnty   else 0
     1068           slt-base-loc        = if doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / doc-line.fact-qnty   else 0
     1069                   vat-rubl-loc        = if doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / doc-line.fact-qnty   else 0
     1070           slt-rubl-loc        = if doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / doc-line.fact-qnty   else 0
     1071           vat-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc)))
     1072           slt-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))).
     1073         if road-tax-base-loc  = ? then road-tax-base-loc  = 0.
     1074         if road-tax-rubl-loc  = ? then road-tax-rubl-loc  = 0.
     1075         if transport-base-loc = ? then transport-base-loc = 0.
     1076         if transport-rubl-loc = ? then transport-rubl-loc = 0.
     1077         if other-base-loc     = ? then other-base-loc     = 0.
     1078         if other-rubl-loc     = ? then other-rubl-loc     = 0.
     1079         assign
     1080           transport-cli-loc      = 0
     1081           other-cli-loc          = 0
     1082           road-tax-cli-loc       = ?
     1083           vat-cli-loc            = ?
     1084           slt-cli-loc            = ?
     1085           price-cli-with-tax-loc = ?.
     1086      end.
     1087   ASSIGN
     1088             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     1089       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     1090   .
     1091                                                                                        ~
     1092   if trn-doc.ext-doc-type = 'ot':U or
     1093      trn-doc.ext-doc-type = ?                 then do:
     1094     assign
     1095      out-vatp-have-vat-slt = yes.
     1096   end.
     1097   else do:
     1098     find first out-vatp_doc-attr no-lock
     1099       where out-vatp_doc-attr.doc-code  = trn-doc.doc-code
     1100         and out-vatp_doc-attr.attr-code = 'envd':U
     1101         no-error .
     1102     if not available out-vatp_doc-attr then do:
     1103       assign
     1104         out-vatp-have-vat-slt = yes.
     1105     end.
     1106     else do:
     1107        out-vatp-have-vat-slt = no.
     1108     end.
     1109   end.
     1110   find first out-vatp_goods where out-vatp_goods.artic     = doc-line.artic     and
     1111                                      out-vatp_goods.prod-type = doc-line.prod-type and
     1112                                      out-vatp_goods.prod-code = doc-line.prod-code no-lock.
     1113   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
