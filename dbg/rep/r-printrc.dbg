        1   block-level on error undo, throw.
        2   define input parameter parparentproc  as widget-handle no-undo .
        3   define input parameter p-date_from    as date          no-undo.
        4   define input parameter p-date_to      as date          no-undo .
        5   define input parameter p-db-list      as character     no-undo.
        6   define input parameter p-log          as logical       no-undo .
        7   define variable vss-revision          as character no-undo init "$Revision$":U .
        8   define variable vss-author            as character no-undo init "$Author$":U .
        9   define variable vss-date              as character no-undo init "$Date$":U .
       10   define variable vss-workfile          as character no-undo init "$Workfile$":U .
       11   define variable vss-archive           as character no-undo init "$Archive$":U .
       12   define variable vss-description       as character no-undo init "Отчет по версиям RC на УБД.".
       13   define variable v-report-name-html    as CHARACTER no-undo .
       14   define variable v-report-name-html-RC as CHARACTER no-undo .
       15   define variable v-file-date           as character no-undo .
       16   define variable v-file-time           as character no-undo .
       17   define variable v-today               as date      no-undo.
       18   define variable v-time                as integer   no-undo.
       19   define variable p-report-id           as integer   no-undo .
       20   define stream out-stream.
       21   define stream OutStr-html.
       22   define variable ii         as integer   no-undo.
       23   define variable jj         as integer   no-undo.
       24   define variable v-menedger as character no-undo.
       25   define variable v-name     as character no-undo.
       26   define buffer buf_db            for ub.db .
       27   define buffer buf_upgrade       for ub.upgrade .
       28   define buffer buf_upgrade-attr  for ub.upgrade-attr .
       29   define buffer buf_person        for ub.person .
       30   define buffer buf_user-account  for ub.user-account .
       31   define buffer buf_code          for ub.code .
       32   define buffer buf_rvs-line-attr for ub.rvs-line-attr .
       33   define temp-table temp_db-list no-undo
       34     field db-num as integer
       35     index pi is primary unique db-num
       36     .
       37   procedure vss-get-info :
       38     define output parameter p-vss-revision    like vss-revision    no-undo .
       39     define output parameter p-vss-author      like vss-author      no-undo .
       40     define output parameter p-vss-date        like vss-date        no-undo .
       41     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       42     define output parameter p-vss-archive     like vss-archive     no-undo .
       43     define output parameter p-vss-description like vss-description no-undo .
       44     assign
       45       p-vss-revision    = vss-revision
       46       p-vss-author      = vss-author
       47       p-vss-date        = vss-date
       48       p-vss-workfile    = vss-workfile
       49       p-vss-archive     = vss-archive
       50       p-vss-description = vss-description
       51     .
       52   end procedure.
       53   procedure vss-get-parameters :
       54     define output parameter p-vss-parameters as character no-undo .
       55   end procedure.
       56   define new global shared variable g#vssrevis-logger as handle    no-undo .
       57   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       58   define variable v-vssrevis-logger                   as handle    no-undo .
       59   procedure vss-logevent :
       60     define input  parameter p-extra-paramters as character no-undo .
       61     define variable v-vssrevis-parameters as character no-undo .
       62     do
       63     on error undo, return error return-value
       64     :
       65       if  valid-handle(v-vssrevis-logger)
       66       and v-vssrevis-logger :get-signature("logevent") <> ""
       67       then do:
       68         run vss-get-parameters in this-procedure
       69           (output v-vssrevis-parameters
       70           ).
       71         run logevent in v-vssrevis-logger
       72           (input vss-workfile
       73           ,input vss-revision
       74           ,input v-vssrevis-parameters
       75           ,input p-extra-paramters
       76           ).
       77       end.
       78     end.
       79   end procedure.
       80   assign
       81     v-vssrevis-logger = g#vssrevis-logger
       82   .
       83   if  valid-handle(v-vssrevis-logger)
       84   and v-vssrevis-logger :get-signature("logevent") <> ""
       85   then do:
       86     assign
       87       v-vssrevis-logevent = true
       88     .
       89     run vss-logevent in this-procedure (input vss-description) .
       90   end.
       91   define new global shared variable g#language as character no-undo .
       92   if g#language <> '' and g#language <> 'rus':U then do:
       93     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       94   end.
       95   define new global shared variable g#library  as handle no-undo .
       96   define new global shared variable g#library2 as handle no-undo .
       97   procedure proc-alt-shift-f2:
       98     if not ibs.th.gbl.gbl-var:rcode
       99   then
      100     run gbl\inidebug.p .
      101   end.
      102   procedure proc-alt-shift-f3:
      103     run gbl/prvssinf.p
      104       ( input this-procedure
      105       ) .
      106   end.
      107   define variable v-inform-launched as logical no-undo initial false .
      108   procedure proc-alt-shift-f4:
      109     define variable v-action as character no-undo .
      110     if v-inform-launched = false then do:
      111       assign
      112         v-inform-launched = true
      113       .
      114       run gbl/d-inform.w
      115         (  input self
      116         ,  input this-procedure
      117         , output v-action
      118         ) no-error .
      119       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      120       assign
      121         v-inform-launched = false
      122       .
      123     end.
      124   end.
      125   procedure proc-alt-f1:
      126     run gbl/corrhelp.p
      127       (input this-procedure
      128       ) .
      129   end .
      130   on alt-shift-f2 anywhere do:
      131     run proc-alt-shift-f2.
      132   end.
      133   on alt-shift-f3 anywhere do:
      134     run proc-alt-shift-f3 in this-procedure .
      135   end.
      136   on alt-shift-f4 anywhere do:
      137     run proc-alt-shift-f4 in this-procedure.
      138   end.
      139   on alt-f1 anywhere do:
      140     run proc-alt-f1 in this-procedure .
      141   end.
      142   define variable vss-include-info0 as character format "X(65)" no-undo
      143   initial "@(#)$Workfile$ $Revision$".
      144   define variable v-fmtcli-name          as character    no-undo.
      145   define variable v-fmtcli-engl-name     as character    no-undo.
      146   define variable v-fmtcli-addres        as character    no-undo.
      147   define variable v-fmtcli-post-addres   as character    no-undo.
      148   define variable v-fmtcli-full-addres   as character    no-undo.
      149   define variable v-fmtcli-phone         as character    no-undo.
      150   define variable v-fmtcli-inn           as character    no-undo.
      151   define variable v-fmtcli-kpp           as character    no-undo.
      152   define variable v-fmtcli-okpo          as character    no-undo.
      153   define variable v-fmtcli-country       as character    no-undo.
      154   define variable v-fmtcli-city          as character    no-undo.
      155   define variable v-fmtcli-index         as character    no-undo.
      156   define variable v-fmtcli-schet-exists  as logical      no-undo.
      157   define variable v-fmtcli-bank-exists   as logical      no-undo.
      158   define variable v-fmtcli-bank-r-schet  as character    no-undo.
      159   define variable v-fmtcli-bank-c-schet  as character    no-undo.
      160   define variable v-fmtcli-bank-bik      as character    no-undo.
      161   define variable v-fmtcli-bank-name     as character    no-undo.
      162   define variable v-fmtcli-bank-addres   as character    no-undo.
      163   define variable v-fmtcli-bank-city     as character    no-undo.
      164   procedure fmtcli-get-bank :
      165   define input parameter p-host-code      as integer          no-undo.
      166   define input parameter p-obj-type       as character        no-undo.
      167   define input parameter p-obj-code       as integer          no-undo.
      168   define input parameter p-curr-code      as integer          no-undo.
      169       define buffer buf_fin-schet     for ub.fin-schet.
      170       define buffer buf_fin-bank      for ub.fin-bank.
      171   do
      172   for buf_fin-schet
      173     , buf_fin-bank
      174   on error undo, return error
      175   :
      176       assign
      177           v-fmtcli-schet-exists       = no
      178           v-fmtcli-bank-exists        = no
      179           v-fmtcli-bank-r-schet       = "":U
      180           v-fmtcli-bank-c-schet       = "":U
      181           v-fmtcli-bank-bik           = "":U
      182           v-fmtcli-bank-name          = "":U
      183           v-fmtcli-bank-addres        = "":U
      184           v-fmtcli-bank-city          = "":U
      185       .
      186       search-for-schet:
      187       for each buf_fin-schet no-lock
      188          where buf_fin-schet.host-code = p-host-code
      189            and buf_fin-schet.cli-type  = p-obj-type
      190            and buf_fin-schet.cli-code  = p-obj-code
      191            and buf_fin-schet.curr-code = p-curr-code
      192       on error undo, return error
      193       :
      194           if buf_fin-schet.status_   = 'удал':U
      195           then do:
      196           end.
      197           else do:
      198               assign
      199                   v-fmtcli-schet-exists   = yes
      200                   v-fmtcli-bank-r-schet   = trim( buf_fin-schet.r-schet )
      201                   v-fmtcli-bank-c-schet   = trim( buf_fin-schet.c-schet )
      202               .
      203               find first buf_fin-bank no-lock
      204                    where buf_fin-bank.host-code = p-host-code
      205                      and buf_fin-bank.code-bank = buf_fin-schet.code-bank
      206               no-error.
      207               if available buf_fin-bank
      208               then do:
      209                   assign
      210                       v-fmtcli-bank-exists      = yes
      211                       v-fmtcli-bank-bik         = trim( buf_fin-bank.bik )
      212                       v-fmtcli-bank-name        = trim( buf_fin-bank.bank-name )
      213                       v-fmtcli-bank-addres      = trim(buf_fin-bank.addres)
      214                       v-fmtcli-bank-city      = trim(buf_fin-bank.bank-city)
      215                   .
      216               end.
      217               else do:
      218                   assign
      219                       v-fmtcli-bank-exists    = no
      220                       v-fmtcli-bank-bik       = "":U
      221                       v-fmtcli-bank-name      = "":U
      222                       v-fmtcli-bank-addres    = "":U
      223                       v-fmtcli-bank-city      = "":U
      224                   .
      225               end.
      226               leave search-for-schet.
      227           end.
      228       end.
      229   end.
      230   end procedure.
      231   procedure fmtcli-get-client :
      232   define input parameter p-obj-type       as character    no-undo.
      233   define input parameter p-obj-code       as integer      no-undo.
      234       define variable v-temp-fmtcli-address      as character     no-undo.
      235       define variable v-num-country-city    as integer      no-undo.
      236       define buffer buf_clients   for ub.clients.
      237       define buffer buf_firm      for ub.firm.
      238       define buffer buf_store     for ub.store.
      239       define buffer buf_shop      for ub.shop.
      240       define buffer buf_person    for ub.person.
      241   do
      242   for buf_clients
      243     , buf_firm
      244     , buf_store
      245     , buf_shop
      246     , buf_person
      247   on error undo, return error
      248   :
      249       assign
      250           v-fmtcli-name           = "":U
      251           v-fmtcli-addres         = "":U
      252           v-fmtcli-post-addres    = "":U
      253           v-fmtcli-full-addres    = "":U
      254           v-fmtcli-phone          = "":U
      255           v-fmtcli-inn            = "":U
      256           v-fmtcli-kpp            = "":U
      257           v-fmtcli-okpo           = "":U
      258           v-fmtcli-city           = "":U
      259           v-fmtcli-index          = "":U
      260           v-fmtcli-country        = "":U
      261       .
      262       find first buf_clients no-lock
      263            where buf_clients.obj-type = p-obj-type
      264              and buf_clients.obj-code = p-obj-code
      265       .
      266       assign
      267           v-fmtcli-name = buf_clients.obj-name
      268       .
      269       case buf_clients.obj-type:
      270          when 'орг':U
      271          then do:
      272               find first buf_firm no-lock
      273                    where buf_firm.firm-code = buf_clients.obj-code
      274                    no-error
      275               .
      276               if available buf_firm
      277               then do:
      278                   assign
      279                       v-num-country-city = num-entries( buf_firm.city )
      280                       v-fmtcli-engl-name = buf_firm.engl-name
      281                   .
      282                   if v-num-country-city > 0
      283                   then do:
      284                       assign
      285                           v-fmtcli-country    = trim( entry( 1, buf_firm.city ) )
      286                       .
      287                   end.
      288                   if v-num-country-city > 1
      289                   then do:
      290                       assign
      291                           v-fmtcli-city       = trim( entry( 2, buf_firm.city ) )
      292                       .
      293                   end.
      294                   run fmtcli-concatenate-strings in this-procedure (
      295                         input v-fmtcli-full-addres
      296                       , input v-fmtcli-country
      297                       , input ", ":U
      298                       , input 50
      299                       , output v-fmtcli-full-addres
      300                   ).
      301                   run fmtcli-concatenate-strings in this-procedure (
      302                         input v-fmtcli-full-addres
      303                       , input v-fmtcli-city
      304                       , input ", ":U
      305                       , input 50
      306                       , output v-fmtcli-full-addres
      307                   ).
      308                   run fmtcli-concatenate-strings in this-procedure (
      309                         input v-fmtcli-full-addres
      310                       , input IF buf_firm.ind = 0 THEN "" ELSE string( buf_firm.ind )
      311                       , input ", ":U
      312                       , input 50
      313                       , output v-fmtcli-full-addres
      314                   ).
      315                   run fmtcli-concatenate-strings in this-procedure (
      316                         input v-fmtcli-post-addres
      317                       , input v-fmtcli-country
      318                       , input ", ":U
      319                       , input 50
      320                       , output v-fmtcli-post-addres
      321                   ).
      322                   run fmtcli-concatenate-strings in this-procedure (
      323                         input v-fmtcli-post-addres
      324                       , input v-fmtcli-city
      325                       , input ", ":U
      326                       , input 50
      327                       , output v-fmtcli-post-addres
      328                   ).
      329                   run fmtcli-concatenate-strings in this-procedure (
      330                         input v-fmtcli-post-addres
      331                       , input string( buf_firm.ind )
      332                       , input ", ":U
      333                       , input 50
      334                       , output v-fmtcli-post-addres
      335                   ).
      336                   run fmtcli-concatenate-strings in this-procedure (
      337                         input substring( buf_firm.addres1, 1, 50 )
      338                       , input buf_firm.addres2
      339                       , input " ":U
      340                       , input 50
      341                       , output v-temp-fmtcli-address
      342                   ).
      343                   run fmtcli-concatenate-strings in this-procedure (
      344                         input v-temp-fmtcli-address
      345                       , input substring( buf_firm.addres1, 51, 50 )
      346                       , input " ":U
      347                       , input 50
      348                       , output v-temp-fmtcli-address
      349                   ).
      350                   run fmtcli-concatenate-strings in this-procedure (
      351                         input v-temp-fmtcli-address
      352                       , input substring( buf_firm.addres1, 101, 50 )
      353                       , input " ":U
      354                       , input 50
      355                       , output v-temp-fmtcli-address
      356                   ).
      357                   assign
      358                       v-fmtcli-addres = v-temp-fmtcli-address
      359                   .
      360                   if buf_firm.addres1 <> ?
      361                   then do:
      362                       run fmtcli-concatenate-strings in this-procedure (
      363                             input v-fmtcli-full-addres
      364                           , input v-fmtcli-addres
      365                           , input ", ":U
      366                           , input 0
      367                           , output v-fmtcli-full-addres
      368                       ).
      369                   end.
      370                   run fmtcli-concatenate-strings in this-procedure (
      371                         input substring( buf_firm.post-addr1, 1, 50 )
      372                       , input buf_firm.post-addr2
      373                       , input " ":U
      374                       , input 50
      375                       , output v-fmtcli-post-addres
      376                   ).
      377                   run fmtcli-concatenate-strings in this-procedure (
      378                         input v-fmtcli-post-addres
      379                       , input substring( buf_firm.post-addr1, 51, 50 )
      380                       , input " ":U
      381                       , input 50
      382                       , output v-fmtcli-post-addres
      383                   ).
      384                   run fmtcli-concatenate-strings in this-procedure (
      385                         input v-fmtcli-post-addres
      386                       , input substring( buf_firm.post-addr1, 101, 50 )
      387                       , input " ":U
      388                       , input 50
      389                       , output v-fmtcli-post-addres
      390                   ).
      391                   assign
      392                       v-fmtcli-phone         = buf_firm.phone
      393                       v-fmtcli-inn           = buf_firm.inn
      394                       v-fmtcli-kpp           = buf_firm.kpp
      395                       v-fmtcli-okpo          = buf_firm.okpo
      396                       v-fmtcli-index         = string( buf_firm.ind )
      397                   .
      398               end.
      399          end.
      400          when 'маг':U
      401          then do:
      402               find first buf_shop no-lock
      403                    where buf_shop.obj-code = buf_clients.obj-code
      404               .
      405               if available buf_shop
      406               then do:
      407                   run fmtcli-concatenate-strings in this-procedure (
      408                         input buf_shop.addres1
      409                       , input buf_shop.addres2
      410                       , input " ":U
      411                       , input 50
      412                       , output v-fmtcli-addres
      413                   ).
      414                   assign
      415                       v-fmtcli-full-addres = v-fmtcli-addres
      416                       v-fmtcli-post-addres = v-fmtcli-addres
      417                       v-fmtcli-phone       = buf_shop.phone
      418                       v-fmtcli-inn         = "":U
      419                       v-fmtcli-kpp         = "":U
      420                       v-fmtcli-okpo        = "":U
      421                       v-fmtcli-city        = "":U
      422                       v-fmtcli-index       = "":U
      423                   .
      424               end.
      425          end.
      426          when 'скл':U
      427          then do:
      428               find first buf_store no-lock
      429                    where buf_store.obj-code = buf_clients.obj-code
      430               .
      431               if available buf_store
      432               then do:
      433                   run fmtcli-concatenate-strings in this-procedure (
      434                         input buf_store.addres1
      435                       , input buf_store.addres2
      436                       , input " ":U
      437                       , input 50
      438                       , output v-fmtcli-addres
      439                   ).
      440                   assign
      441                       v-fmtcli-full-addres = v-fmtcli-addres
      442                       v-fmtcli-phone       = buf_store.phone
      443                       v-fmtcli-inn         = "":U
      444                       v-fmtcli-kpp         = "":U
      445                       v-fmtcli-okpo        = "":U
      446                       v-fmtcli-city        = "":U
      447                       v-fmtcli-index       = "":U
      448                   .
      449               end.
      450          end.
      451          when 'чел':U
      452          then do:
      453               find first buf_person no-lock
      454                    where buf_person.psn-code = buf_clients.obj-code
      455               .
      456               if available buf_person
      457               then do:
      458                   run fmtcli-concatenate-strings in this-procedure (
      459                         input ( if buf_person.ind = 0 or buf_person.ind = ?
      460                                 then "":U
      461                                 else string( buf_person.ind, "999999")
      462                                 )
      463                       , input buf_person.city
      464                       , input ", ":U
      465                       , input 0
      466                       , output v-fmtcli-full-addres
      467                   ).
      468                   assign
      469                       v-fmtcli-addres = buf_person.address
      470                   .
      471                   run fmtcli-concatenate-strings in this-procedure (
      472                         input v-fmtcli-full-addres
      473                       , input v-fmtcli-addres
      474                       , input ", ":U
      475                       , input 0
      476                       , output v-fmtcli-full-addres
      477                   ).
      478                   assign
      479                       v-fmtcli-phone     = buf_person.phone1
      480                       v-fmtcli-inn       = buf_person.inn
      481                       v-fmtcli-kpp       = buf_person.kpp
      482                       v-fmtcli-okpo      = buf_person.okpo
      483                       v-fmtcli-city      = buf_person.city
      484                       v-fmtcli-index     = string( buf_person.ind )
      485                   .
      486               end.
      487          end.
      488       end case.
      489   end.
      490   end procedure.
      491   procedure fmtcli-concatenate-strings :
      492   define input parameter p-string-1       as character        no-undo.
      493   define input parameter p-string-2       as character        no-undo.
      494   define input parameter p-delimiter      as character        no-undo.
      495   define input parameter p-length         as integer          no-undo.
      496   define output parameter p-out-string    as character        no-undo.
      497   do
      498   on error undo, return error
      499   :
      500       assign
      501           p-out-string = ( if p-string-1 = ?
      502                            then "":U
      503                            else trim( p-string-1 ) )
      504       .
      505       assign
      506           p-out-string = p-out-string
      507                        + ( if p-out-string = "":U
      508                            or length( p-out-string ) = p-length
      509                            or p-string-2 = ?
      510                            or trim( p-string-2 ) = "":U
      511                            then "":U
      512                            else p-delimiter )
      513                        + ( if p-string-2 = ?
      514                            or trim( p-string-2 ) = "":U
      515                            then "":U
      516                            else trim( p-string-2 ) )
      517       .
      518   end.
      519   end procedure.
      520   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      521   define variable v-waitfram-action01         as character   no-undo .
      522   define variable v-waitfram-action02         as character   no-undo .
      523   define variable v-waitfram-action03         as character   no-undo .
      524   define variable mWaitFramTextBeg            as character   no-undo.
      525   define variable mWaitFramTextEnd            as character   no-undo.
      526   define variable mWaitFramView               as logical     no-undo.
      527   define variable mWaitProcEvent              as logical     no-undo init yes.
      528   define variable mWaitFramInterval           as integer     no-undo init 1 .
      529   define variable mWaitFramStop               as logical     no-undo.
      530   define variable mWaitFramStopUser           as logical     no-undo.
      531   define variable mWaitFramStopTimeOut        as logical     no-undo.
      532   define variable mWaitFramStartProc          as datetime-tz no-undo.
      533   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      534   define button B-WaitFramStop auto-end-key
      535        label "Стоп"
      536        size 10 by 1 tooltip "Остоновить процесс".
      537   define button B-viewProcInfo
      538        label "Информация"
      539        size 15 by 1 tooltip "Информация о процесс".
      540   define frame waitfram
      541     v-waitfram-action01 format "x(72)" no-label skip
      542     v-waitfram-action02 format "x(72)" no-label skip
      543     v-waitfram-action03 format "x(72)" no-label skip
      544     B-viewProcInfo
      545     B-WaitFramStop at row 4 col 30
      546     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      547     .
      548   define new global shared variable mBatchMode as logical no-undo init ?.
      549   define variable mFramBachModHandle as handle no-undo.
      550   mFramBachModHandle = frame waitfram:handle.
      551   define variable mFameOldVis as logical no-undo.
      552   define variable mVisCUrentVin as logical no-undo.
      553   if session:batch-mode
      554   then
      555      mBatchMode = yes.
      556   if mBatchMode = ? then do:
      557     mVisCUrentVin = current-window:visible.
      558     mFameOldVis = mFramBachModHandle:visible.
      559     mFramBachModHandle:visible  = yes.
      560     mBatchMode = mFramBachModHandle:visible ne yes.
      561     mFramBachModHandle:visible = mFameOldVis.
      562     current-window:visible = mVisCUrentVin.
      563   end.
      564    if  log-manager:logfile-name ne ?
      565     then DO:
      566         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      567         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      568         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      569     end.
      570   on choose of B-WaitFramStop in frame waitfram
      571   do:
      572     mWaitFramStop = yes.
      573     mWaitFramStopUser = yes.
      574   end.
      575   function waitfram-check-timeout returns logical():
      576      define variable vtime as int64 no-undo.
      577      if mWaitFramStopTimeOut
      578      then
      579         return yes.
      580      vtime = ( now - mWaitFramStartProc ) / 1000 .
      581      if     mWaitFramTimeOut ne ?
      582         and mWaitFramTimeOut ne 0
      583         and mWaitFramTimeOut lt vtime
      584      then do:
      585         mWaitFramStopTimeOut = yes.
      586      end.
      587      return mWaitFramStopTimeOut.
      588   end.
      589   procedure waitfram-hide :
      590     if not session:batch-mode
      591     then do
      592     on error undo, return error return-value
      593     :
      594       pause 0 before-hide .
      595       if not mBatchMode then
      596         hide frame waitfram .
      597     if     not mWaitFramView
      598        and mWaitProcEvent
      599     then
      600       process events .
      601     end.
      602   end procedure.
      603   procedure waitfram-show :
      604     define input  parameter p-message as character no-undo .
      605     define variable v-left-margin as integer   no-undo .
      606     if not session:batch-mode
      607     then do
      608     on error undo, return error return-value
      609     :
      610       if length(p-message) <= 70 then do:
      611         assign
      612           v-left-margin = integer((70 - length(p-message)) / 2)
      613         .
      614         assign
      615           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      616         .
      617         assign
      618           v-waitfram-action01 = " "
      619           v-waitfram-action02 = " "
      620                                    + fill(" ", v-left-margin)
      621                                    + p-message
      622           v-waitfram-action03 = " "
      623         .
      624       end.
      625       else do:
      626         define variable vRindex1 as integer no-undo.
      627         define variable vRindex2 as integer no-undo.
      628         vRindex1 = r-index(p-message," ",70).
      629         if vRindex1 = 0
      630         then
      631            vRindex1 = 70.
      632         if length(p-message)  <= vRindex1 + 70 then do:
      633           assign
      634             v-waitfram-action01 = " "
      635             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      636             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      637           .
      638         end.
      639         else do:
      640           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      641           if vRindex2 <= vRindex1
      642           then
      643              vRindex2 = vRindex1 + 70.
      644           assign
      645             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      646             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      647             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      648           .
      649         end.
      650       end.
      651       B-viewProcInfo:visible   in frame waitfram = no.
      652       B-viewProcInfo:sensitive in frame waitfram = no.
      653       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      654       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      655       if  (   mWaitFramView
      656          or  mWaitProcEvent)
      657          and not mBatchMode
      658       then
      659          display
      660             v-waitfram-action01 skip
      661             v-waitfram-action02 skip
      662             v-waitfram-action03 skip
      663          with frame waitfram .
      664       if     mWaitFramView
      665          then do:
      666             if     mWaitFramInterval ne ?
      667                and not mBatchMode
      668             then
      669                wait-for go of frame waitfram pause mWaitFramInterval.
      670          end.
      671          else
      672             if     mWaitProcEvent
      673                and not mBatchMode
      674             then
      675                process events .
      676     end.
      677   end procedure.
      678      procedure waitfram-show-this:
      679         define input  parameter iInterval as int64 no-undo.
      680         define variable vtime as int64 no-undo.
      681         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      682         mWaitFramInterval = iInterval.
      683         run waitfram-show (substitute("&1&2 &3&4" ,
      684                                       mWaitFramTextBeg ,
      685                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      686                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      687                                       mWaitFramTextEnd
      688                                      )
      689                           ).
      690      end.
      691      procedure WaitFramRunPause:
      692         define input  parameter iInterval as dec no-undo.
      693         define variable vStart  as datetime-tz no-undo.
      694         define variable vend    as datetime-tz no-undo.
      695         define variable vint as int64 no-undo.
      696         define variable vOk as logical no-undo.
      697         vStart = now.
      698         vend   = vStart.
      699         publish "WaitFramPause" (iInterval,output vOk).
      700         vend   =  now.
      701         vint = vend - vStart.
      702         vint = iInterval - vint / 1000.
      703         if     not mWaitFramStop
      704            and (   vint > 0
      705                 or (    not vOk
      706                     and iInterval eq ?
      707                     )
      708                 )
      709         then
      710            run waitfram-show-this (iInterval).
      711         vend   =  now.
      712         vint = vend - vStart.
      713         vint = iInterval - vint / 1000.
      714         if     not mWaitFramStop
      715            and vint > 0
      716         then do:
      717            run gbl/pause.p (vint * 1000).
      718         end.
      719         if iInterval ne ?
      720         then
      721            publish "WaitFramStop".
      722         waitfram-check-timeout().
      723      end.
      724      procedure WaitFramWaitFor:
      725         define input  parameter iInterval as dec no-undo.
      726         assign
      727            mWaitFramStartProc   = now
      728            mWaitFramStopUser    = no
      729            mWaitFramStopTimeOut = no
      730         .
      731         block-wait:
      732         do while not mWaitFramStop:
      733            run WaitFramRunPause (iInterval).
      734            if  waitfram-check-timeout()
      735            then do:
      736               leave block-wait.
      737            end.
      738         end.
      739         run waitfram-hide.
      740      end.
      741   procedure waitfram-join :
      742     define input  parameter p-line-1  as character no-undo .
      743     define input  parameter p-line-2  as character no-undo .
      744     define input  parameter p-line-3  as character no-undo .
      745     define output parameter p-message as character no-undo .
      746     do
      747     on error undo, return error return-value
      748     :
      749       assign
      750         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      751                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      752                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      753       .
      754     end.
      755   end procedure.
      756   function waitfram-join-function returns character
      757     (input p-line-1 as character
      758     ,input p-line-2 as character
      759     ,input p-line-3 as character
      760     ).
      761     define variable v-message as character no-undo .
      762     run waitfram-join in this-procedure
      763       (input  p-line-1
      764       ,input  p-line-2
      765       ,input  p-line-3
      766       ,output v-message
      767       ) .
      768     return v-message .
      769   end function .
      770   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      771   define  stream PrnLibStream.
      772   procedure prn-lib-prn-file :
      773     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      774     define input parameter p-DIsabledoptions as integer no-undo .
      775     define variable v-report-name as character no-undo .
      776     define variable v-user-action as character no-undo .
      777     define variable v-printed     as logical   no-undo .
      778     define variable v-exist       as logical   no-undo .
      779     do
      780       on error undo, return error
      781       :
      782       run prn-lib-get-report-name  in this-procedure (
      783         input parParentProc
      784         ,output v-report-name
      785         ).
      786   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      787   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      788     (input  v-report-name
      789     ,input  2
      790     ,output v-exist
      791     )  .
      792       if NOT v-exist then
      793       DO:
      794         Message
      795           "Нет заданий на печать ! "
      796           view-as alert-box .
      797         Return  .
      798       End.
      799       run gbl/prnfilen.w
      800         (input  ""
      801         ,input  p-DisabledOptions
      802         ,input  string(v-report-name )
      803         ,input  7
      804         ,output v-user-action
      805         ,output v-printed
      806         ) .
      807       if v-printed then
      808       do:
      809         return "YES" .
      810       end.
      811       else
      812       do:
      813         return "NO" .
      814       end.
      815     end.
      816   end procedure.
      817   procedure prn-lib-open-stream :
      818     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      819     define input parameter p-page-size    as integer no-undo .
      820     define input parameter p-is-stream    as logical no-undo .
      821     define input parameter p-append       as logical no-undo .
      822     define variable v-report-name as character no-undo .
      823     do
      824       on error undo, return error
      825       :
      826       run prn-lib-get-report-name  in this-procedure (
      827         input parParentProc
      828         ,output v-report-name
      829         ).
      830       if p-is-stream then
      831       do:
      832         if p-append then
      833         do:
      834           output stream PrnLibStream to value( v-report-name )
      835             page-size value(p-page-size) append .
      836         end.
      837         if not p-append then
      838         do:
      839           output stream PrnLibStream to value( v-report-name )
      840             page-size value(p-page-size) .
      841         end.
      842       end.
      843       if not p-is-stream then
      844       do:
      845         if p-append then
      846         do:
      847           output to value( v-report-name )
      848             page-size value(p-page-size) append .
      849         end.
      850         if not p-append then
      851         do:
      852           output to value( v-report-name )
      853             page-size value(p-page-size) .
      854         end.
      855       end.
      856     end.
      857   end procedure.
      858   procedure prn-lib-open-exp :
      859     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      860     define input parameter p-is-stream    as logical no-undo .
      861     define input parameter p-is-append    as logical no-undo .
      862     define output parameter p-ReportFileName as char init "report" no-undo.
      863     define output parameter p-process as logical no-undo .
      864     define variable glog as logical no-undo .
      865     do
      866       on error undo, return error
      867       :
      868       SYSTEM-DIALOG GET-FILE p-ReportFileName
      869         TITLE      "Укажите путь"
      870         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      871         ASK-OVERWRITE
      872         CREATE-TEST-FILE
      873         SAVE-AS
      874         USE-FILENAME
      875         DEFAULT-EXTENSION "txt"
      876         UPDATE glog
      877         .
      878       if not glog then  return.
      879       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      880       if p-is-stream then
      881       do:
      882         if p-is-append then
      883         do:
      884           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      885         end.
      886         else
      887         do:
      888           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      889         end.
      890       end.
      891       else
      892       do:
      893         if p-is-append then
      894         do:
      895           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      896         end.
      897         else
      898         do:
      899           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      900         end.
      901       end.
      902       p-process = yes.
      903     end.
      904   end procedure.
      905   procedure prn-lib-get-report-name :
      906     define input parameter parParentProc  as widget-handle no-undo.
      907     define output parameter p-report-name as character no-undo .
      908     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      909   end procedure.
      910   procedure prn-lib-reportviewer-report-name :
      911     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      912     define input parameter p-report-name-html as character no-undo .
      913     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      914   end procedure.
      915   procedure prn-lib-reportviewer :
      916     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      917     define input parameter p-report-name-html as character no-undo .
      918     define input parameter p-param        as character no-undo .
      919     define variable v-excel           as character no-undo init 'TRUE' .
      920     define variable v-value-character as character no-undo .
      921     define variable v-value-integer   as character no-undo .
      922     define variable v-value-date      as date      no-undo .
      923     define variable v-value-decimal   as decimal   no-undo .
      924     define variable rep-excel         as logical   no-undo .
      925     define variable excel-string      as character no-undo .
      926     define variable v-param-type      as character no-undo .
      927     define variable v-tth             as handle    no-undo .
      928     run adm/shattri.p (
      929       input "get":U
      930       ,input  ""
      931       ,input  0
      932       ,input  'report-glob':U
      933       ,input  'rep-excel':U
      934       ,output v-value-character
      935       ,output v-value-date
      936       ,output v-value-decimal
      937       ,output v-value-integer
      938       ,output rep-excel
      939       ,output v-param-type
      940       ,INPUT-OUTPUT table-handle v-tth
      941       )  .
      942     if rep-excel then v-excel = "TRUE" .
      943     else v-excel = "FALSE" .
      944     if p-param eq ""
      945     then
      946        p-param = "EXCEL:" + v-excel.
      947     else
      948        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      949     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      950   end procedure.
      951   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      952   procedure cur-time :
      953      define output parameter p-today as date      no-undo .
      954      define output parameter p-time  as integer   no-undo .
      955     do
      956     on error undo, return error
      957     :
      958       define variable v-date1 as date      no-undo .
      959       define variable v-date2 as date      no-undo .
      960       define variable v-time  as integer   no-undo .
      961       assign
      962         v-date1 = today
      963         v-time  = time
      964         v-date2 = today
      965       .
      966       if v-date1 <> v-date2
      967       then do:
      968         assign
      969           v-date1 = today
      970           v-time  = v-time
      971         .
      972       end.
      973       assign
      974         p-today = v-date1
      975         p-time  = v-time
      976       .
      977     end.
      978   end.
      979   function cur-time-date returns character
      980   :
      981     return string(today, '99/99/9999':U) .
      982   end.
      983   function cur-time-mjd returns decimal
      984   :
      985     define variable v-date as date      no-undo .
      986     define variable v-time as integer   no-undo .
      987     run cur-time in this-procedure
      988       (output v-date
      989       ,output v-time
      990       ) .
      991     return integer(v-date) - 2400002 + (v-time / 86400) .
      992   end.
      993   function cur-time-get-ending-index returns integer
      994   (input p-number as integer
      995   )
      996   :
      997     if p-number < 0
      998     or p-number = ?
      999     then do:
     1000       return 1 .
     1001     end.
     1002     define variable v-rest as integer   no-undo .
     1003     assign
     1004       p-number = p-number modulo 100
     1005     .
     1006     if p-number < 20
     1007     then do:
     1008       assign
     1009         v-rest = p-number
     1010       .
     1011     end.
     1012     else do:
     1013       assign
     1014         v-rest = p-number modulo 10
     1015       .
     1016     end.
     1017     case v-rest :
     1018       when 1
     1019       then do:
     1020         return 2 .
     1021       end.
     1022       when 2 or
     1023       when 3 or
     1024       when 4
     1025       then do:
     1026         return 3 .
     1027       end.
     1028       otherwise do:
     1029         return 1 .
     1030       end.
     1031     end case .
     1032   end.
     1033   procedure cur-time-mjd-to-date :
     1034      define input  parameter i-mjd-diff as decimal no-undo.
     1035      define output parameter o-Date     as date    no-undo.
     1036      define output parameter o-Time     as integer no-undo.
     1037      define variable v-day-number as integer   no-undo .
     1038      if    i-mjd-diff < 0
     1039         or i-mjd-diff = ?
     1040      then do:
     1041         return "?" .
     1042      end.
     1043      assign
     1044         v-day-number = truncate(i-mjd-diff,0).
     1045         o-Date = date(v-day-number + 2400002).
     1046         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1047     .
     1048   end.
     1049   function cur-time-mjd-to-string returns character
     1050   (input p-mjd-diff as decimal
     1051   )
     1052   :
     1053     define variable v-day-number as integer   no-undo .
     1054     define variable v-seconds    as integer   no-undo .
     1055     define variable v-hour       as integer   no-undo .
     1056     define variable v-min        as integer   no-undo .
     1057     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1058     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1059     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1060     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1061     if p-mjd-diff < 0
     1062     or p-mjd-diff = ?
     1063     then do:
     1064       return "?" .
     1065     end.
     1066     assign
     1067       v-day-number = integer(truncate(p-mjd-diff,0))
     1068       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1069     .
     1070     if v-seconds > 86400
     1071     then do:
     1072       assign
     1073         v-seconds = 86400 - 1
     1074       .
     1075     end.
     1076     if v-seconds < 0
     1077     then do:
     1078       assign
     1079         v-seconds = 0
     1080       .
     1081     end.
     1082     assign
     1083       v-hour = truncate(v-seconds / 3600, 0)
     1084     .
     1085     assign
     1086       v-seconds = v-seconds modulo 3600
     1087     .
     1088     assign
     1089       v-min = truncate(v-seconds / 60, 0)
     1090     .
     1091     assign
     1092       v-seconds = v-seconds modulo 60
     1093     .
     1094     return
     1095         (if v-day-number <> 0
     1096           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1097           else ""
     1098         )
     1099       + (if v-day-number <> 0 or v-hour <> 0
     1100           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1101           else ""
     1102         )
     1103       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1104           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1105           else ""
     1106         )
     1107       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1108       .
     1109   end.
     1110   function cur-time-string returns character
     1111   :
     1112     define variable v-date as date      no-undo .
     1113     define variable v-time as integer   no-undo .
     1114     run cur-time in this-procedure
     1115       (output v-date
     1116       ,output v-time
     1117       ) .
     1118     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1119   end.
     1120   function cur-time-string-sec returns character
     1121   :
     1122     define variable v-date as date      no-undo .
     1123     define variable v-time as integer   no-undo .
     1124     run cur-time in this-procedure
     1125       (output v-date
     1126       ,output v-time
     1127       ) .
     1128     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1129   end.
     1130   function cur-time-custom  returns character
     1131   (input p-prefix as character
     1132   ,input p-date-format as character
     1133   ,input p-delimiter as character
     1134   ,input p-time-format as character
     1135   ,input p-suffix as character
     1136   )
     1137   :
     1138     define variable v-date as date      no-undo .
     1139     define variable v-time as integer   no-undo .
     1140     run cur-time in this-procedure
     1141       (output v-date
     1142       ,output v-time
     1143       ) .
     1144     return
     1145       p-prefix
     1146       + string(v-date, p-date-format)
     1147       + p-delimiter
     1148       + string(v-time, p-time-format)
     1149       + p-suffix
     1150       .
     1151   end.
     1152   function cur-time-print  returns character
     1153   :
     1154     define variable v-date as date      no-undo .
     1155     define variable v-time as integer   no-undo .
     1156     run cur-time in this-procedure
     1157       (output v-date
     1158       ,output v-time
     1159       ) .
     1160     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1161   end.
     1162   function cur-time-datetime returns datetime
     1163   :
     1164     define variable v-char as character no-undo .
     1165     define variable v-datetime as datetime no-undo .
     1166     v-char = cur-time-string().
     1167     v-datetime = datetime(v-char).
     1168     return  v-datetime.
     1169   end.
     1170   function cur-time-string-msec returns character
     1171   :
     1172     define variable v-date as datetime  no-undo .
     1173     v-date = now.
     1174     return string(v-date) .
     1175   end.
     1176   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1177     define variable v-cntxt-db-num        as integer   no-undo .
     1178     define variable v-cntxt-userid        as character no-undo .
     1179     define variable v-cntxt-level         as character no-undo .
     1180     define variable v-cntxt-host-code-obj as integer   no-undo .
     1181     define variable v-cntxt-obj-type      as character no-undo .
     1182     define variable v-cntxt-obj-code      as integer   no-undo .
     1183     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1184     define variable v-cntxt-is-admin      as logical   no-undo .
     1185   FUNCTION get-infodb-date RETURNS Character
     1186     ( INPUT p-db-num as integer)  FORWARD.
     1187   FUNCTION get-time RETURNS Character
     1188     ( INPUT p-time as integer)  FORWARD.
     1189   FUNCTION get-infodb-ver RETURNS character
     1190     ( INPUT p-db-num as integer)  FORWARD.
     1191   define variable v-rep-list as character no-undo.
     1192   DEFINE STREAM out-stream.
     1193   define buffer buf_clients for ub.clients .
     1194   do
     1195     on error  undo , return error return-value
     1196     on endkey undo , return error return-value
     1197     on stop   undo , return error return-value
     1198     :
     1199     run get-report-num in parParentProc (
     1200       output p-report-id
     1201       ).
     1202       run cur-time in this-procedure ( output v-today
     1203       , output v-time
     1204       ).
     1205   define variable v-account as integer init 0 no-undo .
     1206   define variable v-account-lavel as character no-undo .
     1207   define variable v-button-stop as logical no-undo .
     1208   define variable v-kol-spice as integer no-undo .
     1209   define variable v-kol-spice2 as integer no-undo .
     1210   define variable v-kol-spice3 as integer no-undo .
     1211   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     1212   DEFINE BUTTON StopBtn AUTO-END-KEY
     1213        LABEL "Стоп"
     1214        SIZE 10 BY 1.
     1215   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     1216        LABEL "Обработано записей"
     1217         VIEW-AS TEXT
     1218        SIZE 14 BY .67 NO-UNDO.
     1219   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     1220         VIEW-AS TEXT
     1221        SIZE 53.25 BY .67
     1222        FGCOLOR 1  NO-UNDO.
     1223   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     1224         VIEW-AS TEXT
     1225        SIZE 53.25 BY .67
     1226        FGCOLOR 1  NO-UNDO.
     1227   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     1228         VIEW-AS TEXT
     1229        SIZE 53.25 BY .67
     1230        FGCOLOR 1  NO-UNDO.
     1231   DEFINE RECTANGLE RECT-1
     1232        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1233        SIZE 55.13 BY 4.46.
     1234   DEFINE FRAME InfoFrame
     1235        StopBtn AT ROW 4.25 COL 21.75
     1236        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     1237        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     1238        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     1239        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     1240        RECT-1 AT ROW 1 COL 1
     1241       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1242            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1243            TITLE "Процесс"
     1244            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     1245   define variable mFrameView      as logical   no-undo init yes.
     1246     define variable mFramHandle as handle no-undo.
     1247     mFramHandle = frame InfoFrame:handle.
     1248     if  log-manager:logfile-name ne ?
     1249     then DO:
     1250         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1251         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1252         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     1253     end.
     1254     mFrameView = not session:batch-mode and mFramHandle:visible.
     1255     if mFrameView
     1256     then do:
     1257       ASSIGN
     1258          FRAME InfoFrame:HIDDEN                           = TRUE
     1259          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     1260     end.
     1261   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     1262   DO:
     1263     IF not StopProcessing THEN
     1264       Message "Вы действительно хотите прервать" SKIP
     1265               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     1266                 UPDATE StopProcessing.
     1267     IF StopProcessing THEN do:
     1268        if mFrameView
     1269        then do:
     1270           HIDE FRAME InfoFrame.
     1271        end.
     1272     End.
     1273   END.
     1274   assign v-account = ( if integer( 10 ) = 0 then 100 else integer( 10 ) ).
     1275     if  log-manager:logfile-name ne ?
     1276     then DO:
     1277         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     1278     end.
     1279     if not session:batch-mode then
     1280     do:
     1281       VIEW FRAME InfoFrame.
     1282       mFrameView = true.
     1283     end.
     1284      v-button-stop = false .
     1285         if mFrameView
     1286         then do:
     1287         if v-button-stop then view STOPBTN in frame InfoFrame.
     1288                          else Hide STOPBTN in frame InfoFrame.
     1289         end.
     1290     ii = 0 .
     1291   define variable v-date_from as character no-undo .
     1292   define variable v-date_to   as character no-undo .
     1293     if string(entry(3,string(p-date_from),"/")) >= "90" then v-date_from = "19" + string(entry(3,string(p-date_from),"/")) + "_" + string(entry(2,string(p-date_from),"/")) + "_" + string(entry(1,string(p-date_from),"/")) .
     1294     else v-date_from = "20" + string(entry(3,string(p-date_from),"/")) + "_" + string(entry(2,string(p-date_from),"/")) + "_" + string(entry(1,string(p-date_from),"/")) .
     1295     if string(entry(3,string(p-date_to),"/")) >= "90" then v-date_to = "19" + string(entry(3,string(p-date_to),"/")) + "_" + string(entry(2,string(p-date_to),"/")) + "_" + string(entry(1,string(p-date_to),"/")) .
     1296     else v-date_to = "20" + string(entry(3,string(p-date_to),"/")) + "_" + string(entry(2,string(p-date_to),"/")) + "_" + string(entry(1,string(p-date_to),"/")) .
     1297     find first ub.db no-lock no-error .
     1298     v-report-name-html = session:temp-directory + "VERRC_" + string(substring (ub.db.db-key,1,4)) + "_TH_16_0_" + string(v-today,"99.99.99") + "_" +  replace (string(time,"HH:MM:SS"),":","") + ".html".
     1299     output stream OutStr-html to value(v-report-name-html) convert target 'UTF-8' .
     1300     put stream OutStr-html unformatted
     1301   "<!DOCTYPE HTML>" skip
     1302   ' <html>' skip
     1303   '  <head>' skip
     1304   '   <meta charset="utf-8">' skip
     1305   '    <style type="text/css">' skip
     1306   '      table ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     1307   '      .class1 ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     1308   '      tbody td, th ' + chr(123) + ' border-collapse: collapse; border: 1px solid black;' + chr(125) skip
     1309   '   </style>' skip
     1310   '  </head>' skip
     1311       .
     1312     put stream OutStr-html unformatted
     1313       '<body>' skip
     1314       '<TABLE name="1"  fit_to_page="true" orientation="landscape" CELLSPACING="0" BORDER="0">'skip
     1315       '<thead>' skip
     1316       .
     1317     put stream OutStr-html unformatted
     1318       '<tr>' skip
     1319       '<td style="width: 40px;"></td>' skip
     1320       '<td style="width: 60px;"></td>' skip
     1321       '<td style="width: 60px;"></td>' skip
     1322       '<td style="width: 80px;"></td>' skip
     1323       '<td style="width: 60px;"></td>' skip
     1324       '<td style="width: 60px;"></td>' skip
     1325       '<td style="width: 120px;"></td>' skip
     1326       '<td style="width: 80px;"></td>' skip
     1327       '<td style="width: 120px;"></td>' skip
     1328       '<td style="width: 120px;"></td>' skip
     1329       '<td style="width: 120px;"></td>' skip
     1330       '<td style="width: 150px;"></td>' skip
     1331       '</tr>' skip
     1332       .
     1333     put stream OutStr-html unformatted
     1334       '<TR>' skip
     1335       '<TD colspan="12" style="font-weight: bold;">Отчет по версиям RC на БД</TD>' skip
     1336       '</TR>' skip
     1337       '<TR>' skip
     1338       '<TD colspan="12" style="font-weight: bold;">Дата: ' + string (v-today,"99.99.9999") + '</TD>' skip
     1339       '</TR>'skip
     1340       '<TR>' skip
     1341       '<TD colspan="12" style="font-weight: bold;">Время: ' + get-time(v-time) + '</TD>' skip
     1342       '</TR>'skip
     1343       '<TR>' skip
     1344       '<TD colspan="12" style="font-weight: bold;">Фильтры: с ' + string (p-date_from,"99.99.9999") + " по " + string(p-date_to,"99.99.9999") + '</TD>' skip
     1345       '</TR>'skip
     1346       '<TR>' skip
     1347       '<TD colspan="12" style="font-weight: bold;">БД: ' + if p-db-list = "" then "Все" + '</TD>' else string(p-db-list) + '</TD>' skip
     1348       '</TR>'skip
     1349       .
     1350     put stream OutStr-html unformatted
     1351       '</thead>' skip
     1352       '<tbody>' skip
     1353       .
     1354     put stream OutStr-html unformatted
     1355       '<tr>' skip
     1356       '<th text_wrap="true" style="align: center;">№</th>' skip
     1357       '<th text_wrap="true" style="align: center;">Номер БД</th>' skip
     1358       '<th text_wrap="true" style="align: center;">Наименование БД</th>' skip
     1359       '<th text_wrap="true" style="align: center;">Ключ БД</th>' skip
     1360       '<th text_wrap="true" style="align: center;">Дата актуальности информации о БД и RC</th>' skip
     1361       '<th text_wrap="true" style="align: center;">Версия структуры БД</th>' skip
     1362       '<th text_wrap="true" style="align: center;">Индентификатор версии RC</th>' skip
     1363       '<th text_wrap="true" style="align: center;">Дата и время компиляции RC</th>' skip
     1364       '<th text_wrap="true" style="align: center;">Дата и время копирования индентификатора версии RC на ПК</th>' skip
     1365       '<th text_wrap="true" style="align: center;">Дата и время записи данных о версии в БД</th>' skip
     1366       '<th text_wrap="true" style="align: center;">Дата и время версии конфигурации типов маркировки</th>' skip
     1367       '<th text_wrap="true" style="align: center;">Имя пользователя</th>' skip
     1368       '</tr>' skip
     1369       .
     1370     if p-db-list = "" then
     1371     do:
     1372       empty temp-table temp_db-list .
     1373       if v-cntxt-db-num = 0 then
     1374       do:
     1375         for each ub.db no-lock:
     1376           create temp_db-list .
     1377           temp_db-list.db-num = ub.db.db-num .
     1378         end.
     1379       end.
     1380       else
     1381       do:
     1382         for each ub.db no-lock where ub.db.db-num = v-cntxt-db-num:
     1383           create temp_db-list .
     1384           temp_db-list.db-num = ub.db.db-num .
     1385         end.
     1386       end.
     1387     end.
     1388     else
     1389     do:
     1390       empty temp-table temp_db-list .
     1391       do jj = 1 to num-entries (p-db-list,chr(44)):
     1392         create temp_db-list .
     1393         temp_db-list.db-num = integer(entry (jj,p-db-list, chr(44))) .
     1394       end.
     1395     end.
     1396     for each temp_db-list,
     1397       last buf_db no-lock where buf_db.db-num = temp_db-list.db-num by buf_db.db-num :
     1398       _next:
     1399       for each buf_upgrade where buf_upgrade.db-num = buf_db.db-num and entry(1,buf_upgrade.version-num," ") >= v-date_from and entry(1,buf_upgrade.version-num," ") <= v-date_to
     1400       and (lookup ("Rel",buf_upgrade.version-num," ") > 0 or buf_upgrade.version-num = "v16_0000.000.000")
     1401       by buf_upgrade.UpgDate desc by buf_upgrade.UpgTime desc:
     1402         ii = ii + 1 .
     1403         put stream OutStr-html unformatted
     1404           '<tr>' skip
     1405           '<td style="align: center;">' + string(ii) + '</td>' skip
     1406           '<td text_wrap="true" style="align: center;">' + string(buf_db.db-num) + '</td>' skip
     1407           '<td text_wrap="true" style="align: center;">' + string(buf_db.db-name) + '</td>' skip
     1408           '<td text_wrap="true" style="align: center;">' + string(buf_db.db-key) + '</td>' skip
     1409           '<td text_wrap="true" style="align: center;">' + string(get-infodb-date(buf_db.db-num) ) + '</td>' skip
     1410           '<td text_wrap="true" style="align: center;">' + string(buf_db.reserve1-char) + '</td>' skip
     1411           '<td text_wrap="true" style="align: center;">' + string(entry(1,buf_upgrade.version-num,chr(4))) + '</td>' skip
     1412           .
     1413         find first buf_upgrade-attr no-lock where
     1414           buf_upgrade-attr.db-num = buf_upgrade.db-num and
     1415           buf_upgrade-attr.version-num = buf_upgrade.version-num and
     1416           buf_upgrade-attr.attr-code = "compile-date" no-error .
     1417         put stream OutStr-html unformatted
     1418           '<td text_wrap="true" style="align: center;">' + if available (buf_upgrade-attr) and string(buf_upgrade-attr.attr-value) <> ? then string(buf_upgrade-attr.attr-value) + '</td>' else " " + '</td>' skip
     1419           .
     1420         v-file-date = "" .
     1421         v-file-time = "" .
     1422         v-menedger = "" .
     1423         for first buf_upgrade-attr no-lock where
     1424           buf_upgrade-attr.db-num = buf_upgrade.db-num and
     1425           buf_upgrade-attr.version-num = buf_upgrade.version-num and
     1426           buf_upgrade-attr.attr-code = "file-date" :
     1427           v-file-date = buf_upgrade-attr.attr-value .
     1428         end.
     1429         for first buf_upgrade-attr no-lock where
     1430           buf_upgrade-attr.db-num = buf_upgrade.db-num and
     1431           buf_upgrade-attr.version-num = buf_upgrade.version-num and
     1432           buf_upgrade-attr.attr-code = "file-time" :
     1433           v-file-time = get-time(integer(buf_upgrade-attr.attr-value)) .
     1434         end.
     1435         put stream OutStr-html unformatted
     1436           '<td text_wrap="true" style="align: center;">' + if v-file-date = "" or v-file-time = "" then "" + '</td>' else string(v-file-date) + "_" + string (v-file-time) + '</td>' skip
     1437           .
     1438         put stream OutStr-html unformatted
     1439           '<td text_wrap="true" style="align: center;">' + string(buf_upgrade.UpgDate) + "_" + string(buf_upgrade.UpgTime) + '</td>' skip  .
     1440         find first buf_code where
     1441                    buf_code.parent = substitute("Versions&1&2",chr(4),buf_db.db-num)
     1442                and buf_code.code = "MarkType"
     1443              no-lock no-error.
     1444         put stream OutStr-html unformatted
     1445           '<td text_wrap="true" style="align: center;">' if avail buf_code then buf_code.codevalue else '' '</td>' skip.
     1446         for first buf_upgrade-attr no-lock where
     1447           buf_upgrade-attr.db-num = buf_upgrade.db-num and
     1448           buf_upgrade-attr.version-num = buf_upgrade.version-num and
     1449           buf_upgrade-attr.attr-code = "user" ,
     1450           first ub.user-login no-lock where ub.user-login.db-num = buf_upgrade.db-num
     1451           and ub.user-login.user-login = buf_upgrade-attr.attr-value,
     1452           first buf_user-account no-lock where buf_user-account.user-id = ub.user-login.user-id:
     1453           v-menedger = buf_user-account.last-name + '  ' + buf_user-account.first-name + ' ':U + buf_user-account.second-name.
     1454          end.
     1455           put stream OutStr-html unformatted
     1456             '<td text_wrap="true" style="align: center;">' + string(v-menedger) + '</td>' skip.
     1457            put stream OutStr-html unformatted                  '</tr>' skip.
     1458           leave _next .
     1459       end.
     1460     end.
     1461     put stream OutStr-html unformatted
     1462       '</tbody>' skip
     1463       '</table>' skip
     1464       .
     1465     put stream OutStr-html unformatted
     1466       '</body>' skip
     1467       '</html>' skip
     1468       .
     1469     output stream OutStr-html close.
     1470   end.
     1471   if p-log then do:
     1472     run prn-lib-reportviewer-report-name in this-procedure (
     1473       input parParentProc
     1474       ,input v-report-name-html
     1475       ).
     1476   end.
     1477   else do:
     1478     define variable v-report-name       as character no-undo .
     1479     define variable v-fill-path-RepView as character no-undo.
     1480       if search("exe\ReportViewer\reportviewer.exe") <> ? then
     1481     do:
     1482       v-fill-path-RepView = search("exe\ReportViewer\reportviewer.exe").
     1483     end.
     1484     else
     1485     do:
     1486       message "Не найдена программа просмотра отчёта!" view-as alert-box error.
     1487     end.
     1488     os-command no-wait value(v-fill-path-RepView + " false " + v-report-name-html).
     1489   end.
     1490   FUNCTION get-infodb-date RETURNS character
     1491     ( INPUT p-db-num as integer) :
     1492     DEFINE BUFFER buf_db-info FOR ub.db-info.
     1493     find last buf_db-info no-lock where
     1494       buf_db-info.db-num = p-db-num use-index  pi no-error.
     1495     IF AVAILABLE buf_db-info  THEN RETURN string(buf_db-info.date-info).
     1496     RETURN "".
     1497   END FUNCTION.
     1498   FUNCTION get-time RETURNS character
     1499     ( INPUT p-time as integer) :
     1500     define variable v-time_ as character no-undo .
     1501     v-time_ = string(truncate (p-time / 3600, 0)) + ":" + string((p-time modulo 3600) / 60,"99") .
     1502     RETURN v-time_.
     1503   END FUNCTION.
     1504   FUNCTION get-infodb-ver RETURNS character
     1505     ( INPUT p-db-num as integer) :
     1506     DEFINE BUFFER upgrade FOR upgrade.
     1507     block-step:
     1508     for each upgrade where upgrade.db-num   eq p-db-num
     1509       no-lock by upgrade.db-num descending
     1510       by upgrade.step-num descending :
     1511       leave block-step.
     1512     end.
     1513     return if available upgrade then  entry(1,upgrade.version-num,chr(4)) else "?".
     1514   END FUNCTION.
     1515   PROCEDURE get-report-num :
     1516     define output parameter p-report-num as integer no-undo .
     1517     do
     1518       on error undo, return error return-value
     1519       :
     1520       run gbl/getrpnum.p (output p-report-num).
     1521     end.
     1522   END PROCEDURE.
