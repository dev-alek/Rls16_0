     1607   def var vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1608   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     1609   procedure paramls-clear :
     1610     define buffer buf_temp-param for temp-param .
     1611     do
     1612     on error undo, return error return-value
     1613     :
     1614       for each buf_temp-param
     1615       on error undo, return error
     1616       :
     1617         delete buf_temp-param .
     1618       end.
     1619     end.
     1620   end procedure.
     1621   procedure paramls-write :
     1622     define input  parameter p-code     as character no-undo .
     1623     define input  parameter p-sub-code as character no-undo .
     1624     define input  parameter p-value    as character no-undo .
     1625     define buffer buf_temp-param for temp-param .
     1626     do
     1627     on error undo, return error return-value
     1628     :
     1629       find first buf_temp-param
     1630         where buf_temp-param.param-code     = p-code
     1631           and buf_temp-param.param-sub-code = p-sub-code
     1632         no-error .
     1633       if not available buf_temp-param then do:
     1634         create buf_temp-param .
     1635         assign
     1636           buf_temp-param.param-code     = p-code
     1637           buf_temp-param.param-sub-code = p-sub-code
     1638         .
     1639       end.
     1640       assign
     1641         buf_temp-param.param-value = p-value
     1642       .
     1643     end.
     1644   end procedure.
     1645   procedure paramls-read :
     1646     define input  parameter p-code          as character no-undo .
     1647     define input  parameter p-sub-code      as character no-undo .
     1648     define input  parameter p-default-value as character no-undo .
     1649     define output parameter p-value         as character no-undo .
     1650     define buffer buf_temp-param for temp-param .
     1651     do
     1652     on error undo, return error return-value
     1653     :
     1654       find first buf_temp-param
     1655         where buf_temp-param.param-code     = p-code
     1656           and buf_temp-param.param-sub-code = p-sub-code
     1657         no-error .
     1658       if available buf_temp-param then do:
     1659         assign
     1660           p-value = buf_temp-param.param-value
     1661         .
     1662       end.
     1663       else do:
     1664         assign
     1665           p-value = p-default-value
     1666         .
     1667       end.
     1668     end.
     1669   end procedure.
     1670   procedure paramls-append :
     1671     define input  parameter p-code     as character no-undo .
     1672     define input  parameter p-sub-code as character no-undo .
     1673     define input  parameter p-value    as character no-undo .
     1674     define buffer buf_temp-param for temp-param .
     1675     do
     1676     on error undo, return error return-value
     1677     :
     1678       find first buf_temp-param
     1679            where buf_temp-param.param-code     = p-code
     1680              and buf_temp-param.param-sub-code = p-sub-code
     1681         no-error .
     1682       if not available buf_temp-param then do:
     1683         create buf_temp-param .
     1684         assign
     1685           buf_temp-param.param-code     = p-code
     1686           buf_temp-param.param-sub-code = p-sub-code
     1687           buf_temp-param.param-value    = p-value
     1688         .
     1689       end.
     1690       else do:
