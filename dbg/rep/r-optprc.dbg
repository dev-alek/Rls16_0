     2145           , input p-data-filename
     2146       ).
     2147       run gbl/macroxlt.p (
     2148           input-output table buf_temp-param
     2149       ) no-error.
     2150       if error-status :error
     2151       then do:
     2152           message
     2153                    vss-workfile vss-revision vss-description
     2154               skip(1)
     2155               skip "Ошибка создания файла Excel."
     2156               skip return-value
     2157               skip trim(error-status :get-message(1))
     2158                    trim(error-status :get-message(2))
     2159                    trim(error-status :get-message(3))
     2160           view-as alert-box error.
     2161           undo, return error .
     2162       end.
     2163   end.
     2164   end procedure.
     2165   procedure optprcxl-close :
     2166   do
     2167   on error undo, return error
     2168   :
     2169       output stream excel-line close.
     2170       output stream excel-cell close.
     2171       output to value( string( session:temp-directory + "$" + string( g#report-num ) ) + ".txl" ) append.
     2172           export "exe/optprice.xlt":U.
     2173           export "exe/t_form.bas":U.
     2174           export v-optprcxl-cell-file-name.
     2175           export v-optprcxl-data-file-name.
     2176       output close.
     2177   end.
     2178   end procedure.
     2179   define stream out-stream.
     2180   define temp-table tt-goods no-undo like ub.goods.
     2181   define temp-table tt-optprc no-undo
     2182     field gds-code like ub.goods.gds-code
     2183     field artic    like ub.goods.artic
     2184     field b-code   like ub.bar-code.b-code
     2185     field b-code-str  as character
     2186     field gds-name as character
     2187     field grp-code as integer
     2188     field grp-name as character
     2189     field prod-type as character
     2190     field prod-code as integer
     2191     field prod-name as character
     2192     field unit-name as character
     2193     field price     as decimal
     2194     field price-str as character
     2195     field unit-qnty as decimal
     2196     field unit-qnty-str as character
     2197     field unit-price as decimal
     2198     field unit-price-str as character
     2199     field is-root-code   as logical
     2200   index pi is primary unique
     2201     gds-code
     2202     b-code
     2203   index grp
     2204     grp-name
     2205     artic
     2206     is-root-code descending
     2207     unit-qnty
     2208   .
     2209   define buffer buf_currency for ub.currency .
     2210   define variable v-base-code              as integer   no-undo .
     2211   define variable v-curr-abbr              as character no-undo .
     2212   define variable v-print-rubl             as logical   no-undo .
     2213   define variable v-host-code              as integer   no-undo .
     2214   define variable v-line                   as character no-undo .
     2215   define frame optprc
     2216     sym1                            no-label format "X(1)"                          space(0)
     2217     tt-optprc.artic                 no-label format "X(16)":U                   space(0)
     2218     sym2                            no-label format "X(1)"                          space(0)
     2219     tt-optprc.b-code-str            no-label format "X(10)":U                   space(0)
     2220     sym3                            no-label format "X(1)"                          space(0)
     2221     tt-optprc.gds-name              no-label format "X(30)":U                   space(0)
     2222     sym4                            no-label format "X(1)"                          space(0)
     2223     tt-optprc.prod-name             no-label format "X(20)":U                   space(0)
     2224     sym5                            no-label format "X(1)"                          space(0)
     2225     tt-optprc.unit-name             no-label format "X(4)":U                   space(0)
     2226     sym6                            no-label format "X(1)"                          space(0)
     2227     tt-optprc.price-str             no-label format "X(14)":U                   space(0)
     2228     sym7                            no-label format "X(1)"                          space(0)
     2229     tt-optprc.unit-qnty-str         no-label format "X(14)":U                   space(0)
     2230     sym8                            no-label format "X(1)"                          space(0)
     2231     tt-optprc.unit-price-str        no-label format "X(14)":U                   space(0)
     2232     sym9                            no-label format "X(1)"                          space(0)
     2233   with width 131 down stream-io no-label no-box.
     2234   form header
     2235         ":----------------:----------:------------------------------:--------------------:----:--------------:--------------:--------------:":U skip
     2236         ":       1        :    2     :               3              :           4        : 5  :      6       :      7       :      8       :":U skip
     2237         ":----------------:----------:------------------------------:--------------------:----:--------------:--------------:--------------:":U
     2238   with frame HeaderFrame width 198 PAGE-TOP NO-LABELS NO-BOX .
     2239   form header
     2240           v-line format "X(131)" at 1 SKIP
     2241           "Продолжение - на следующей странице" at 1 SKIP
     2242   with frame BottomFrame width 198 PAGE-BOTTOM NO-LABELS NO-BOX .
     2243   function get-unit-qnty-str returns character (p-unit-qnty as decimal) forward.
     2244   do
     2245   on error undo, return error return-value
     2246   :
     2247   if session :set-wait-state( "compiler" ) then.
     2248     run clear-tt in this-procedure .
     2249     assign
     2250       v-line = fill( "-" , 300 )
     2251     .
     2252     find first obj-list no-error .
     2253     if not available obj-list then do:
     2254       message
     2255         "Не указан объект для формирования отчета!"
     2256       view-as alert-box error.
     2257       undo, return error.
     2258     end.
     2259   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2260   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2261     (input  obj-list.obj-type
     2262     ,input  obj-list.obj-code
     2263     ,output v-host-code
     2264     )  .
     2265   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2266   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     2267     (input  v-host-code
     2268     ,output v-base-code
     2269     )  .
     2270     find buf_currency no-lock
     2271       where buf_currency.curr-code = v-base-code
     2272     no-error .
     2273     if not available buf_currency
     2274     then do:
     2275       message
     2276         substitute( "Не найдена базовая валюта для фирмы &1" , v-host-code )
     2277       view-as alert-box information.
     2278       undo, return error.
     2279     end.
     2280     assign
     2281       v-curr-abbr =  buf_currency.curr-abbr
     2282     .
     2283   output stream out-stream to value( string( session:temp-directory +
     2284                                        "rpt" + string( g#report-num ) ) )
     2285                                        page-size 62 .
     2286     run optprcxl-init in this-procedure .
     2287     run prg-bar_init-cb-handle in this-procedure (v-d-report-handle) .
     2288     run fill-tt in this-procedure .
     2289     run print-report in this-procedure .
     2290     output stream out-stream close.
     2291     run optprcxl-close in this-procedure .
     2292     run clear-tt in this-procedure .
     2293     os-delete value( string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )  .
     2294     os-rename
     2295       value( string( session:temp-directory ) + "$" + string( g#report-num ) + ".txl" )
     2296       value( string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )
     2297     .
     2298     define variable v-user-action   as character no-undo .
     2299     define variable v-printed       as logical   no-undo .
     2300     define variable DisabledOptions as integer   no-undo .
     2301     define variable v-orient-page as character no-undo .
     2302     run How-name in this-procedure ( input ReportPageHeight
     2303                                    , input ReportPageWidth
     2304                                    , output v-orient-page
     2305                                    ) .
     2306     if v-orient-page = "A4-lans":U then DisabledOptions = 8 .
     2307                                    else DisabledOptions = 0 .
     2308     run gbl/prnfilen.w
     2309         ( input  ""
     2310         , input  DisabledOptions
     2311         , input  string(session :temp-directory) + "rpt" + string( g#report-num )
     2312         , input  ReportFontNum
     2313         , output v-user-action
     2314         , output v-printed
     2315         ) .
     2316     os-delete value( string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )  .
     2317   end.
     2318   procedure fill-tt-goods :
     2319     define buffer buf_goods     for ub.goods.
     2320     define buffer buf_tt-goods  for tt-goods.
     2321   do
     2322   on error undo, return error return-value
     2323   :
     2324     define variable v-curr-grp-name as character no-undo .
     2325     run waitfram-show in this-procedure (input "Построение списка товаров":U ) .
     2326     case x-SelectGood :
     2327       when 1 then do:
     2328         for each buf_goods no-lock
     2329           where buf_goods.stts = 0
     2330         :
     2331           create buf_tt-goods.
     2332           buffer-copy buf_goods to buf_tt-goods.
     2333         end.
     2334       end.
     2335       when 2 then do:
     2336         for each tmp#grp no-lock
     2337         :
     2338           run grplib-get-full-name in this-procedure( input tmp#grp.node-code, output v-curr-grp-name ) .
     2339           for each buf_goods no-lock
     2340                 where buf_goods.grp-name begins v-curr-grp-name
     2341           :
     2342             find first buf_tt-goods no-lock
     2343               where buf_tt-goods.gds-code = buf_goods.gds-code
     2344             no-error .
     2345             if not available buf_tt-goods
     2346             then do:
     2347               create buf_tt-goods.
     2348               buffer-copy buf_goods to buf_tt-goods.
     2349             end.
     2350           end.
     2351         end.
     2352       end.
     2353       when 3 then do:
     2354         for each g#cli no-lock,
     2355             each buf_goods no-lock
     2356               where buf_goods.prod-type = g#cli.obj-type
     2357                 and buf_goods.prod-code = g#cli.obj-code
     2358                 and buf_goods.stts      = 0
     2359         :
     2360           find first buf_tt-goods
     2361             where buf_tt-goods.gds-code = buf_goods.gds-code
     2362           no-error .
     2363           if not available buf_tt-goods
     2364           then do:
     2365             create buf_tt-goods .
     2366             buffer-copy buf_goods to buf_tt-goods.
     2367           end.
     2368         end.
     2369       end.
     2370       when 4 then do:
     2371         for each gds-list
     2372         :
     2373           find first buf_tt-goods
     2374             where buf_tt-goods.gds-code = gds-list.gds-code
     2375           no-error .
     2376           if not available buf_tt-goods
     2377           then do:
     2378             create buf_tt-goods .
     2379             buffer-copy gds-list
     2380               except
     2381                 qnty
     2382                 to-del
     2383                 order-num
     2384                 to-sel
     2385               to buf_tt-goods
     2386             .
     2387           end.
     2388         end.
     2389       end.
     2390       when 5 then do:
     2391         for each gds-list
     2392         :
     2393           find first buf_tt-goods
     2394             where buf_tt-goods.gds-code = gds-list.gds-code
     2395           no-error .
     2396           if not available buf_tt-goods
     2397           then do:
     2398             create buf_tt-goods .
     2399             buffer-copy gds-list
     2400               except
     2401                 qnty
     2402                 to-del
     2403                 order-num
     2404                 to-sel
     2405               to buf_tt-goods
     2406             .
     2407           end.
     2408         end.
     2409       end.
     2410       when 7 then do:
     2411         for each gds-list
     2412         :
     2413           find first buf_tt-goods
     2414             where buf_tt-goods.gds-code = gds-list.gds-code
     2415           no-error .
     2416           if not available buf_tt-goods
     2417           then do:
     2418             create buf_tt-goods .
     2419             buffer-copy gds-list
     2420               except
     2421                 qnty
     2422                 to-del
     2423                 order-num
     2424                 to-sel
     2425               to buf_tt-goods
     2426             .
     2427           end.
     2428         end.
     2429       end.
     2430     end case.
     2431     run waitfram-hide in this-procedure .
     2432   end.
     2433   end procedure.
     2434   procedure clear-tt :
     2435     define buffer buf_tt-optprc for tt-optprc.
     2436   do  for buf_tt-optprc
     2437   on error undo, return error return-value
     2438   :
     2439     empty temp-table buf_tt-optprc.
     2440   end.
     2441   end procedure.
     2442   procedure fill-tt :
     2443     define buffer buf_gds-obj   for ub.gds-obj.
     2444     define buffer buf_goods     for ub.goods.
     2445     define buffer base-bar-code for ub.bar-code.
     2446     define buffer buf_bar-code  for ub.bar-code.
     2447     define buffer buf_clients   for ub.clients.
     2448     define buffer buf_units     for ub.units.
     2449     define buffer buf_price-list  for ub.price-list .
     2450     define buffer buf_tt-goods  for tt-goods.
     2451     define buffer buf_tt-optprc for tt-optprc.
     2452   do
     2453   on error undo, return error return-value
     2454   :
     2455     define variable v-bar-code    like ub.bar-code.b-code  no-undo .
     2456     define variable v-tot-gds-obj as integer            no-undo .
     2457     define variable v-str         as character          no-undo .
     2458     define variable v-prod-name   as character          no-undo .
     2459     define variable v-artic       as character          no-undo .
     2460     define variable v-doc-num     as character          no-undo .
     2461     define variable v-price-sale  as decimal            no-undo .
     2462     define variable v-road-tax    as decimal            no-undo .
     2463     define variable v-excise      as decimal            no-undo .
     2464     run fill-tt-goods in this-procedure .
     2465     find first obj-list no-error .
     2466     for each buf_gds-obj no-lock
     2467       where buf_gds-obj.obj-type = obj-list.obj-type
     2468         and buf_gds-obj.obj-code = obj-list.obj-code
     2469     , first buf_tt-goods no-lock
     2470         where buf_tt-goods.artic     = buf_gds-obj.artic
     2471           and buf_tt-goods.prod-type = buf_gds-obj.prod-type
     2472           and buf_tt-goods.prod-code = buf_gds-obj.prod-code
     2473     :
     2474       assign
     2475         v-tot-gds-obj = v-tot-gds-obj + 1
     2476       .
     2477     end.
     2478     run prg-bar_new in this-procedure ( 1, v-tot-gds-obj).
     2479     run prg-bar_title in this-procedure ( input "Обработка товаров...":U).
     2480     run prg-bar_show in this-procedure .
     2481     goods-cycle:
     2482     for each buf_gds-obj no-lock
     2483       where buf_gds-obj.obj-type = obj-list.obj-type
     2484         and buf_gds-obj.obj-code = obj-list.obj-code
     2485     , first buf_tt-goods no-lock
     2486         where buf_tt-goods.artic     = buf_gds-obj.artic
     2487           and buf_tt-goods.prod-type = buf_gds-obj.prod-type
     2488           and buf_tt-goods.prod-code = buf_gds-obj.prod-code
     2489     :
     2490       run prg-bar_increment in this-procedure .
     2491   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     2492     (input  buf_tt-goods.gds-code
     2493     ,input  ?
     2494     ,output v-bar-code
     2495     ) no-error .
     2496       if error-status :error
     2497       then do:
     2498         next goods-cycle.
     2499       end.
     2500       find base-bar-code no-lock
     2501         where base-bar-code.b-code = v-bar-code
     2502       no-error .
     2503       if not available base-bar-code then do:
     2504         next goods-cycle.
     2505       end.
     2506       find first buf_clients no-lock
     2507         where buf_clients.obj-type = buf_tt-goods.prod-type
     2508           and buf_clients.obj-code = buf_tt-goods.prod-code
     2509       no-error .
     2510       assign
     2511         v-prod-name = if available buf_clients then buf_clients.obj-name else "?":U
     2512       .
     2513   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2514   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     2515     (input  buf_gds-obj.obj-type
     2516     ,input  buf_gds-obj.obj-code
     2517     ,input  base-bar-code.b-code
     2518     ,input  0
     2519     ,input  0
     2520     ,output v-doc-num
     2521     ,output v-price-sale
     2522     ,output v-road-tax
     2523     ,output v-excise
     2524     )  .
     2525       if v-price-sale = ?
     2526       then do:
     2527         next goods-cycle.
     2528       end.
     2529       find first buf_tt-optprc
     2530         where buf_tt-optprc.gds-code = buf_tt-goods.gds-code
     2531           and buf_tt-optprc.b-code   = base-bar-code.b-code
     2532       no-error.
     2533       if not available buf_tt-optprc
     2534       then do:
     2535         create buf_tt-optprc.
     2536         assign
     2537           buf_tt-optprc.gds-code       = buf_tt-goods.gds-code
     2538           buf_tt-optprc.artic          = buf_tt-goods.artic
     2539           buf_tt-optprc.b-code         = base-bar-code.b-code
     2540           buf_tt-optprc.is-root-code   = true
     2541           buf_tt-optprc.b-code-str     = string(base-bar-code.b-code, "999999999":U)
     2542           buf_tt-optprc.gds-name       = buf_tt-goods.gds-name
     2543           buf_tt-optprc.grp-code       = buf_tt-goods.grp-code
     2544           buf_tt-optprc.grp-name       = buf_tt-goods.grp-name
     2545           buf_tt-optprc.prod-type      = buf_tt-goods.prod-type
     2546           buf_tt-optprc.prod-code      = buf_tt-goods.prod-code
     2547           buf_tt-optprc.prod-name      = v-prod-name
     2548           buf_tt-optprc.unit-name      = base-bar-code.unit-cli
     2549           buf_tt-optprc.price          = v-price-sale
     2550           buf_tt-optprc.price-str      = string(v-price-sale, ">>>,>>>,>>9.99":U)
     2551           buf_tt-optprc.unit-qnty      = base-bar-code.cli-base-rate
     2552           buf_tt-optprc.unit-price     = v-price-sale
     2553           buf_tt-optprc.unit-price-str = string(v-price-sale, ">>>,>>>,>>9.99":U)
     2554         .
     2555         assign
     2556           buf_tt-optprc.unit-qnty-str  = get-unit-qnty-str(buf_tt-optprc.unit-qnty)
     2557         .
     2558       end.
     2559       bc-cycle:
     2560       for each buf_bar-code no-lock
     2561         where buf_bar-code.gds-code  = base-bar-code.gds-code
     2562           and buf_bar-code.node-code = base-bar-code.node-code
     2563           and buf_bar-code.part-code = base-bar-code.part-code
     2564           and buf_bar-code.in-code   = base-bar-code.in-code
     2565       :
     2566         find first buf_tt-optprc
     2567           where buf_tt-optprc.gds-code = buf_tt-goods.gds-code
     2568             and buf_tt-optprc.b-code   = buf_bar-code.b-code
     2569         no-error.
     2570         if not available buf_tt-optprc
     2571         then do:
     2572   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2573   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     2574     (input  buf_gds-obj.obj-type
     2575     ,input  buf_gds-obj.obj-code
     2576     ,input  buf_bar-code.b-code
     2577     ,input  0
     2578     ,input  0
     2579     ,output v-doc-num
     2580     ,output v-price-sale
     2581     ,output v-road-tax
     2582     ,output v-excise
     2583     )  .
     2584           if v-price-sale = ? or v-doc-num = ?
     2585           then do:
     2586             next bc-cycle.
     2587           end.
     2588           find first buf_price-list no-lock
     2589             where buf_price-list.doc-num    = v-doc-num
     2590               and buf_price-list.b-code     = buf_bar-code.b-code
     2591               and buf_price-list.price-type = ""
     2592             no-error.
     2593           if not available buf_price-list and not p-show-without-price-doc
     2594           then do:
     2595             next bc-cycle.
     2596           end.
     2597           create buf_tt-optprc.
     2598           assign
     2599             buf_tt-optprc.gds-code       = buf_tt-goods.gds-code
     2600             buf_tt-optprc.artic          = buf_tt-goods.artic
     2601             buf_tt-optprc.b-code         = buf_bar-code.b-code
     2602             buf_tt-optprc.is-root-code   = false
     2603             buf_tt-optprc.b-code-str     = string(buf_bar-code.b-code, "999999999":U)
     2604             buf_tt-optprc.gds-name       = buf_tt-goods.gds-name
     2605             buf_tt-optprc.grp-code       = buf_tt-goods.grp-code
     2606             buf_tt-optprc.grp-name       = buf_tt-goods.grp-name
     2607             buf_tt-optprc.prod-type      = buf_tt-goods.prod-type
     2608             buf_tt-optprc.prod-code      = buf_tt-goods.prod-code
     2609             buf_tt-optprc.prod-name      = v-prod-name
     2610             buf_tt-optprc.unit-name      = buf_bar-code.unit-cli
     2611             buf_tt-optprc.price          = v-price-sale / buf_bar-code.cli-base-rate
     2612             buf_tt-optprc.price-str      = string(buf_tt-optprc.price, ">>>,>>>,>>9.99":U)
     2613             buf_tt-optprc.unit-qnty      = buf_bar-code.cli-base-rate
     2614             buf_tt-optprc.unit-price     = v-price-sale
     2615             buf_tt-optprc.unit-price-str = string(buf_tt-optprc.unit-price, ">>>,>>>,>>9.99":U)
     2616           .
     2617           assign
     2618             buf_tt-optprc.unit-qnty-str  = get-unit-qnty-str(buf_tt-optprc.unit-qnty)
     2619           .
     2620         end.
     2621       end.
     2622     end.
     2623     run prg-bar_delete in this-procedure .
     2624   end.
     2625   end procedure.
     2626   procedure print-report :
     2627     define buffer buf_tt-optprc for tt-optprc.
     2628   do
     2629   on error undo, return error return-value
     2630   :
     2631     define variable v-gds-name-lines  as decimal   no-undo .
     2632     define variable v-prod-name-lines as decimal   no-undo .
     2633     define variable v-grp-name-lines  as decimal   no-undo .
     2634     define variable v-tot-lines       as integer   no-undo .
     2635     define variable v-i               as integer   no-undo .
     2636     define variable v-gds-name        as character no-undo .
     2637     define variable v-prod-name       as character no-undo .
     2638     define variable v-grp-name        as character no-undo .
     2639     define variable v-grp-name-str    as character no-undo .
     2640     run waitfram-show in this-procedure (input "Печать отчета":U ) .
     2641     run print-header in this-procedure .
     2642     view stream out-stream frame BottomFrame .
     2643     view stream out-stream frame HeaderFrame .
     2644     for each tt-optprc
     2645       break by tt-optprc.grp-name
     2646             by tt-optprc.artic
     2647             by tt-optprc.is-root-code descending
     2648             by tt-optprc.unit-qnty
     2649     :
     2650       if first-of(tt-optprc.grp-name)
     2651       then do:
     2652         assign
     2653           v-grp-name = trim( tt-optprc.grp-name , "/":U )
     2654         .
     2655         if line-counter( out-stream ) + 3 > page-size( out-stream ) then do:
     2656           page stream out-stream .
     2657         end.
     2658         if not first(tt-optprc.grp-name) and line-counter( out-stream ) > 3
     2659         then do:
     2660           put stream out-stream unformatted substitute( ":&1:" , fill('-',129)) skip .
     2661         end.
     2662         assign
     2663           v-grp-name-lines = length(v-grp-name) / 129
     2664         .
     2665         if v-grp-name-lines > 1
     2666         then do:
     2667           assign
     2668             v-tot-lines = round( v-grp-name-lines + 0.5 , 0 )
     2669           .
     2670         end.
     2671         else do:
     2672           assign
     2673             v-tot-lines = 1
     2674           .
     2675         end.
     2676         do v-i = 1 to v-tot-lines
     2677         :
     2678           assign
     2679             v-grp-name-str  = substring(v-grp-name, 127 * (v-i - 1) + 1, 127)
     2680           .
     2681           put stream out-stream unformatted ": " v-grp-name-str format "X(127)" " :" skip .
     2682         end.
     2683         put stream out-stream unformatted substitute( ":&1:" , fill('-',129)) skip .
     2684         run optprcxl-sheet1-write-line-data in this-procedure ( input v-grp-name
     2685                                                               , input "":U
     2686                                                               , input "":U
     2687                                                               , input "":U
     2688                                                               , input "":U
     2689                                                               , input "":U
     2690                                                               , input 0
     2691                                                               , input "":U
     2692                                                               ).
     2693         run optprcxl-sheet1-write-line-format in this-procedure ( "GroupName" ).
     2694       end.
     2695       run optprcxl-sheet1-write-line-data in this-procedure ( input (if tt-optprc.is-root-code then tt-optprc.artic else "":U)
     2696                                                             , input (if not tt-optprc.is-root-code then tt-optprc.b-code-str else "":U)
     2697                                                             , input tt-optprc.gds-name
     2698                                                             , input tt-optprc.prod-name
     2699                                                             , input tt-optprc.unit-name
     2700                                                             , input tt-optprc.price
     2701                                                             , input (if not tt-optprc.is-root-code then trim(tt-optprc.unit-qnty-str) else "":U)
     2702                                                             , input (if not tt-optprc.is-root-code then trim(tt-optprc.unit-price-str) else "":U)
     2703                                                             ).
     2704       assign
     2705         v-gds-name-lines  = length(tt-optprc.gds-name)  / 30
     2706         v-prod-name-lines = length(tt-optprc.prod-name) / 20
     2707       .
     2708       if (v-gds-name-lines > 1) or (v-prod-name-lines > 1)
     2709       then do:
     2710         assign
     2711           v-tot-lines  = round( (if v-gds-name-lines > v-prod-name-lines then v-gds-name-lines else v-prod-name-lines) + 0.5 , 0)
     2712         .
     2713         do v-i = 1 to v-tot-lines
     2714         :
     2715           assign
     2716             v-gds-name  = substring(tt-optprc.gds-name, 30 * (v-i - 1) + 1, 30)
     2717             v-prod-name = substring(tt-optprc.prod-name, 20 * (v-i - 1) + 1, 20)
     2718           .
     2719           display stream out-stream
     2720             sym1
     2721             tt-optprc.artic when tt-optprc.is-root-code and v-i = 1
     2722             sym2
     2723             tt-optprc.b-code-str when not tt-optprc.is-root-code and v-i = 1
     2724             sym3
     2725             v-gds-name @ tt-optprc.gds-name
     2726             sym4
     2727             v-prod-name @ tt-optprc.prod-name
     2728             sym5
     2729             tt-optprc.unit-name when v-i = 1
     2730             sym6
     2731             tt-optprc.price-str when v-i = 1
     2732             sym7
     2733             tt-optprc.unit-qnty-str when not tt-optprc.is-root-code and v-i = 1
     2734             sym8
     2735             tt-optprc.unit-price-str when not tt-optprc.is-root-code and v-i = 1
     2736             sym9
     2737           with frame optprc .
     2738           down stream out-stream with frame optprc.
     2739         end.
     2740       end.
     2741       else do:
     2742         display stream out-stream
     2743           sym1
     2744           tt-optprc.artic when tt-optprc.is-root-code
     2745           sym2
     2746           tt-optprc.b-code-str when not tt-optprc.is-root-code
     2747           sym3
     2748           tt-optprc.gds-name
     2749           sym4
     2750           tt-optprc.prod-name
     2751           sym5
     2752           tt-optprc.unit-name
     2753           sym6
     2754           tt-optprc.price-str
     2755           sym7
     2756           tt-optprc.unit-qnty-str when not tt-optprc.is-root-code
     2757           sym8
     2758           tt-optprc.unit-price-str when not tt-optprc.is-root-code
     2759           sym9
     2760         with frame optprc .
     2761       end.
     2762       down stream out-stream with frame optprc.
     2763     end.
     2764     put stream out-stream unformatted v-line format "X(131)" skip.
     2765     run print-footer in this-procedure .
     2766     hide stream out-stream frame BottomFrame .
     2767     run waitfram-hide in this-procedure .
     2768   end.
     2769   end procedure.
     2770   procedure print-header :
     2771   do
     2772   on error undo, return error return-value
     2773   :
     2774     define variable v-org-str as character no-undo .
     2775     define variable v-curr-time-str as character no-undo .
     2776     run fmtcli-get-client in this-procedure
     2777               ( input  'орг':U
     2778               , input  v-host-code
     2779               ) .
     2780     assign
     2781       v-curr-time-str = cur-time-string()
     2782     .
     2783     assign
     2784       v-org-str = substitute("&1 &2", v-fmtcli-name , obj-list.obj-name )
     2785     .
     2786     put stream out-stream unformatted
     2787       "ПРАЙС-ЛИСТ":U skip
     2788        v-curr-time-str skip
     2789       v-org-str skip
     2790       "Валюта: " v-curr-abbr skip(1)
     2791     .
     2792     put stream out-stream unformatted
     2793       "-----------------------------------------------------------------------------------------------------------------------------------":U skip
     2794       ":    Артикул     : Артикул  :        Наименование          :    Производитель   : Ед.: Цена за ед.  :   Кол-во в   :  Стоимость   :":U skip
     2795       ":    основной    :неосновной:                              :                    :изм.:              :   упаковке   :  упаковки    :":U skip
     2796       ":----------------:----------:------------------------------:--------------------:----:--------------:--------------:--------------:":U skip
     2797       ":       1        :    2     :               3              :           4        :  5 :      6       :      7       :      8       :":U skip
     2798       ":----------------:----------:------------------------------:--------------------:----:--------------:--------------:--------------:":U skip
     2799    .
     2800     run optprcxl-write-cell-data in this-procedure ( input "h_org":U
     2801                                                    , input v-org-str
     2802                                                    ).
     2803     run optprcxl-write-cell-data in this-procedure ( input "h_time":U
     2804                                                    , input v-curr-time-str
     2805                                                    ).
     2806     run optprcxl-write-cell-data in this-procedure ( input "h_currency":U
     2807                                                    , input substitute("Валюта : &1" , v-curr-abbr)
     2808                                                    ).
     2809   end.
     2810   end procedure.
     2811   procedure print-footer :
     2812   do
     2813   on error undo, return error return-value
     2814   :
     2815   end.
     2816   end procedure.
     2817   function get-unit-qnty-str returns character (p-unit-qnty as decimal):
     2818     define variable v-qnty-int  as integer   no-undo .
     2819     define variable v-str       as character no-undo .
     2820     if( p-unit-qnty <> 0)
     2821     then do:
     2822       assign
     2823         v-qnty-int = truncate( p-unit-qnty, 0 )
     2824       .
     2825       if( p-unit-qnty = v-qnty-int )
     2826       then do:
     2827           assign
     2828             v-str = string(v-qnty-int , ">,>>>,>>>,>>>9":U)
     2829           .
     2830       end.
     2831       else do:
     2832           assign
     2833             v-str = string(p-unit-qnty , ">>>,>>>,>>9.99":U)
     2834           .
     2835       end.
     2836     end.
     2837     else do:
     2838       assign
     2839         v-str = string(p-unit-qnty , ">,>>>,>>>,>>>9":U)
     2840       .
     2841     end.
     2842     return v-str.
     2843   end.
