     1696   end procedure.
     1697   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1698   procedure cur-time :
     1699      define output parameter p-today as date      no-undo .
     1700      define output parameter p-time  as integer   no-undo .
     1701     do
     1702     on error undo, return error
     1703     :
     1704       define variable v-date1 as date      no-undo .
     1705       define variable v-date2 as date      no-undo .
     1706       define variable v-time  as integer   no-undo .
     1707       assign
     1708         v-date1 = today
     1709         v-time  = time
     1710         v-date2 = today
     1711       .
     1712       if v-date1 <> v-date2
     1713       then do:
     1714         assign
     1715           v-date1 = today
     1716           v-time  = v-time
     1717         .
     1718       end.
     1719       assign
     1720         p-today = v-date1
     1721         p-time  = v-time
     1722       .
     1723     end.
     1724   end.
     1725   function cur-time-date returns character
     1726   :
     1727     return string(today, '99/99/9999':U) .
     1728   end.
     1729   function cur-time-mjd returns decimal
     1730   :
     1731     define variable v-date as date      no-undo .
     1732     define variable v-time as integer   no-undo .
     1733     run cur-time in this-procedure
     1734       (output v-date
     1735       ,output v-time
     1736       ) .
     1737     return integer(v-date) - 2400002 + (v-time / 86400) .
     1738   end.
     1739   function cur-time-get-ending-index returns integer
     1740   (input p-number as integer
     1741   )
     1742   :
     1743     if p-number < 0
     1744     or p-number = ?
     1745     then do:
     1746       return 1 .
     1747     end.
     1748     define variable v-rest as integer   no-undo .
     1749     assign
     1750       p-number = p-number modulo 100
     1751     .
     1752     if p-number < 20
     1753     then do:
     1754       assign
     1755         v-rest = p-number
     1756       .
     1757     end.
     1758     else do:
     1759       assign
     1760         v-rest = p-number modulo 10
     1761       .
     1762     end.
     1763     case v-rest :
     1764       when 1
     1765       then do:
     1766         return 2 .
     1767       end.
     1768       when 2 or
     1769       when 3 or
     1770       when 4
     1771       then do:
     1772         return 3 .
     1773       end.
     1774       otherwise do:
     1775         return 1 .
     1776       end.
     1777     end case .
     1778   end.
     1779   procedure cur-time-mjd-to-date :
     1780      define input  parameter i-mjd-diff as decimal no-undo.
     1781      define output parameter o-Date     as date    no-undo.
     1782      define output parameter o-Time     as integer no-undo.
     1783      define variable v-day-number as integer   no-undo .
     1784      if    i-mjd-diff < 0
     1785         or i-mjd-diff = ?
     1786      then do:
     1787         return "?" .
     1788      end.
     1789      assign
     1790         v-day-number = truncate(i-mjd-diff,0).
     1791         o-Date = date(v-day-number + 2400002).
     1792         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1793     .
     1794   end.
     1795   function cur-time-mjd-to-string returns character
     1796   (input p-mjd-diff as decimal
     1797   )
     1798   :
     1799     define variable v-day-number as integer   no-undo .
     1800     define variable v-seconds    as integer   no-undo .
     1801     define variable v-hour       as integer   no-undo .
     1802     define variable v-min        as integer   no-undo .
     1803     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1804     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1805     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1806     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1807     if p-mjd-diff < 0
     1808     or p-mjd-diff = ?
     1809     then do:
     1810       return "?" .
     1811     end.
     1812     assign
     1813       v-day-number = integer(truncate(p-mjd-diff,0))
     1814       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1815     .
     1816     if v-seconds > 86400
     1817     then do:
     1818       assign
     1819         v-seconds = 86400 - 1
     1820       .
     1821     end.
     1822     if v-seconds < 0
     1823     then do:
     1824       assign
     1825         v-seconds = 0
     1826       .
     1827     end.
     1828     assign
     1829       v-hour = truncate(v-seconds / 3600, 0)
     1830     .
     1831     assign
     1832       v-seconds = v-seconds modulo 3600
     1833     .
     1834     assign
     1835       v-min = truncate(v-seconds / 60, 0)
     1836     .
     1837     assign
     1838       v-seconds = v-seconds modulo 60
     1839     .
     1840     return
     1841         (if v-day-number <> 0
     1842           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1843           else ""
     1844         )
     1845       + (if v-day-number <> 0 or v-hour <> 0
     1846           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1847           else ""
     1848         )
     1849       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1850           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1851           else ""
     1852         )
     1853       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1854       .
     1855   end.
     1856   function cur-time-string returns character
     1857   :
     1858     define variable v-date as date      no-undo .
     1859     define variable v-time as integer   no-undo .
     1860     run cur-time in this-procedure
     1861       (output v-date
     1862       ,output v-time
     1863       ) .
     1864     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1865   end.
     1866   function cur-time-string-sec returns character
     1867   :
     1868     define variable v-date as date      no-undo .
     1869     define variable v-time as integer   no-undo .
     1870     run cur-time in this-procedure
     1871       (output v-date
     1872       ,output v-time
     1873       ) .
     1874     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1875   end.
     1876   function cur-time-custom  returns character
     1877   (input p-prefix as character
     1878   ,input p-date-format as character
     1879   ,input p-delimiter as character
     1880   ,input p-time-format as character
     1881   ,input p-suffix as character
     1882   )
     1883   :
     1884     define variable v-date as date      no-undo .
     1885     define variable v-time as integer   no-undo .
     1886     run cur-time in this-procedure
     1887       (output v-date
     1888       ,output v-time
     1889       ) .
     1890     return
     1891       p-prefix
     1892       + string(v-date, p-date-format)
     1893       + p-delimiter
     1894       + string(v-time, p-time-format)
     1895       + p-suffix
     1896       .
     1897   end.
     1898   function cur-time-print  returns character
     1899   :
     1900     define variable v-date as date      no-undo .
     1901     define variable v-time as integer   no-undo .
     1902     run cur-time in this-procedure
     1903       (output v-date
     1904       ,output v-time
     1905       ) .
     1906     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1907   end.
     1908   function cur-time-datetime returns datetime
     1909   :
     1910     define variable v-char as character no-undo .
     1911     define variable v-datetime as datetime no-undo .
     1912     v-char = cur-time-string().
     1913     v-datetime = datetime(v-char).
     1914     return  v-datetime.
     1915   end.
     1916   function cur-time-string-msec returns character
     1917   :
     1918     define variable v-date as datetime  no-undo .
     1919     v-date = now.
     1920     return string(v-date) .
     1921   end.
     1922   define variable parparentproc  as handle  no-undo .
     1923   define variable g#report-num   as integer no-undo .
     1924   assign
     1925     parparentproc = my-handle
     1926   .
     1927   run get-report-num in my-handle (output g#report-num).
     1928   define variable vss-include-info14 as character format "X(65)" no-undo
     1929   initial "@(#)$Workfile$ $Revision$".
     1930   define stream excel-line.
     1931   define stream excel-cell.
     1932   define temp-table temp_cell-data no-undo
     1933       field data-key as character
     1934       field data-value as character
     1935       index pi is primary unique data-key
     1936   .
     1937   define temp-table temp_sheet1_line-data no-undo
     1938       field sheet-name    as character
     1939       field xl-line-id    as integer
     1940       field artic         as character
     1941       field barcode       as character
     1942       field gdsname       as character
     1943       field prodname      as character
     1944       field unitname      as character
     1945       field price         as decimal
     1946       field unitqnty      as character
     1947       field unitprice     as character
     1948       index pi is primary unique
     1949           xl-line-id
     1950   .
     1951   define variable v-optprcxl-sheet1-cur-data-row     as integer      no-undo.
     1952   define variable v-optprcxl-cell-file-name       as character    no-undo.
     1953   define variable v-optprcxl-data-file-name       as character    no-undo.
     1954   procedure optprcxl-init :
     1955   do
     1956   on error undo, return error
     1957   :
     1958       assign
     1959           v-optprcxl-sheet1-cur-data-row = 0
     1960       .
     1961       run gbl/_tmpfile.p (
     1962             input "xd"
     1963           , input ".txt"
     1964           , output v-optprcxl-data-file-name
     1965       ).
     1966       output stream excel-line to value( v-optprcxl-data-file-name ).
     1967       run gbl/_tmpfile.p (
     1968             input "xc"
     1969           , input ".txt"
     1970           , output v-optprcxl-cell-file-name
     1971       ).
     1972       output stream excel-cell to value( v-optprcxl-cell-file-name ).
     1973       run optprcxl-write-cell-data in this-procedure (
     1974             input "sheetList":U
     1975           , input "Template":U
     1976       ).
     1977       if printrubl
     1978       then do:
     1979           run optprcxl-write-cell-data in this-procedure (
     1980                 input "Template_valutCode":U
     1981               , input "0":U
     1982           ).
     1983       end.
     1984       else do:
     1985           run optprcxl-write-cell-data in this-procedure (
     1986                 input "Template_valutCode":U
     1987               , input "1":U
     1988           ).
     1989       end.
     1990       run optprcxl-write-cell-data in this-procedure (
     1991             input "Template_columnList":U
     1992           , input "artic,barcode,gdsname,prodname,unitname,price,unitqnty,unitprice":U
     1993       ).
     1994       run optprcxl-write-cell-data in this-procedure (
     1995             input "Template_columnType":U
     1996           , input "S,S,S,S,S,D,S,S":U
     1997       ).
     1998       run optprcxl-write-cell-data in this-procedure (
     1999             input "Template_subtotalList":U
     2000           , input "":U
     2001       ).
     2002       run optprcxl-write-cell-data in this-procedure (
     2003             input "Template_subtotalType":U
     2004           , input "":U
     2005       ).
     2006   end.
     2007   end procedure.
     2008   procedure optprcxl-sheet1-write-line-data :
     2009     define input  parameter p-artic         as character no-undo .
     2010     define input  parameter p-barcode       as character no-undo .
     2011     define input  parameter p-gdsname       as character no-undo .
     2012     define input  parameter p-prodname      as character no-undo .
     2013     define input  parameter p-unitname      as character no-undo .
     2014     define input  parameter p-price         as decimal   no-undo .
     2015     define input  parameter p-unitqnty      as character no-undo .
     2016     define input  parameter p-unitprice     as character no-undo .
     2017     define buffer buf_temp_sheet1_line-data        for temp_sheet1_line-data.
     2018   do
     2019   for buf_temp_sheet1_line-data
     2020   on error undo, return error
     2021   :
     2022       for each buf_temp_sheet1_line-data
     2023       :
     2024           delete buf_temp_sheet1_line-data.
     2025       end.
     2026       create buf_temp_sheet1_line-data.
     2027       assign
     2028           v-optprcxl-sheet1-cur-data-row = v-optprcxl-sheet1-cur-data-row + 1
     2029           buf_temp_sheet1_line-data.sheet-name = "Template":U
     2030           buf_temp_sheet1_line-data.xl-line-id = v-optprcxl-sheet1-cur-data-row
     2031           buf_temp_sheet1_line-data.artic     = p-artic
     2032           buf_temp_sheet1_line-data.barcode   = p-barcode
     2033           buf_temp_sheet1_line-data.gdsname   = p-gdsname
     2034           buf_temp_sheet1_line-data.prodname  = p-prodname
     2035           buf_temp_sheet1_line-data.unitname  = p-unitname
     2036           buf_temp_sheet1_line-data.price     = p-price
     2037           buf_temp_sheet1_line-data.unitqnty  = p-unitqnty
     2038           buf_temp_sheet1_line-data.unitprice = p-unitprice
     2039       .
     2040       put stream excel-line unformatted
     2041                           buf_temp_sheet1_line-data.sheet-name
     2042           CHR(9)   "DTA":U
     2043           CHR(9)   buf_temp_sheet1_line-data.artic
     2044           CHR(9)   buf_temp_sheet1_line-data.barcode
     2045           CHR(9)   buf_temp_sheet1_line-data.gdsname
     2046           CHR(9)   buf_temp_sheet1_line-data.prodname
     2047           CHR(9)   buf_temp_sheet1_line-data.unitname
     2048           CHR(9)   buf_temp_sheet1_line-data.price
     2049           CHR(9)   buf_temp_sheet1_line-data.unitqnty
     2050           CHR(9)   buf_temp_sheet1_line-data.unitprice
     2051           chr(10)
     2052       .
     2053   end.
     2054   end procedure.
     2055   procedure optprcxl-sheet1-write-line-format :
     2056     define input parameter p-fmt-label  as character  no-undo.
     2057     define buffer buf_temp_sheet1_line-data        for temp_sheet1_line-data.
     2058   do
     2059   for buf_temp_sheet1_line-data
     2060   on error undo, return error
     2061   :
     2062       put stream excel-line unformatted
     2063                           "Template":U
     2064           CHR(9)   "FMT":U
     2065           CHR(9)   p-fmt-label
     2066           chr(10)
     2067       .
     2068   end.
     2069   end procedure.
     2070   procedure optprcxl-write-cell-data :
     2071   define input parameter p-data-key   as character        no-undo.
     2072   define input parameter p-data-value as character        no-undo.
     2073       define buffer buf_temp_cell-data     for temp_cell-data.
     2074   do
     2075   for buf_temp_cell-data
     2076   on error undo, return error
     2077   :
     2078       find first buf_temp_cell-data
     2079            where buf_temp_cell-data.data-key = p-data-key
     2080       no-error.
     2081       if not available buf_temp_cell-data
     2082       then do:
     2083           create buf_temp_cell-data.
     2084           assign
     2085               buf_temp_cell-data.data-key = p-data-key
     2086           .
     2087       end.
     2088       assign
     2089           buf_temp_cell-data.data-value = p-data-value
     2090       .
     2091       put stream excel-cell unformatted
     2092                           buf_temp_cell-data.data-key
     2093           CHR(9)   buf_temp_cell-data.data-value
     2094           chr(10)
     2095       .
     2096   end.
     2097   end procedure.
     2098   procedure optprcxl-run-excel :
     2099   define input parameter p-header-filename    as character        no-undo.
     2100   define input parameter p-data-filename      as character        no-undo.
     2101       define variable v-Template-file-name    as character    no-undo.
     2102       define variable v-vb-file-name          as character    no-undo.
     2103       define buffer buf_temp-param for temp-param .
     2104   do
     2105   for buf_temp-param
     2106   on error undo, return error
     2107   :
     2108       create buf_temp-param.
     2109       assign
     2110           v-Template-file-name    = search( "exe/optprice.xlt" )
     2111           v-vb-file-name          = search( "exe/t_form.bas")
     2112       .
     2113       if v-Template-file-name = ?
     2114       or v-Template-file-name = "":U
     2115       then do:
     2116           message
     2117               "Ошибка имени файла шаблона."
     2118           view-as alert-box error.
     2119       end.
     2120       if v-vb-file-name = ?
     2121       or v-vb-file-name = "":U
     2122       then do:
     2123           message
     2124               "Ошибка имени файла кода обработки."
     2125           view-as alert-box error.
     2126       end.
     2127       run paramls-write in this-procedure (
     2128             input "template":U
     2129           , input "template-file-name":U
     2130           , input v-Template-file-name
     2131       ).
     2132       run paramls-write in this-procedure (
     2133             input "template":U
     2134           , input "vb-file-name":U
     2135           , input v-vb-file-name
     2136       ).
     2137       run paramls-write in this-procedure (
     2138             input "data":U
     2139           , input "data-header-filename":U
     2140           , input p-header-filename
     2141       ).
