      602   define variable temp1 as integer   no-undo.
      603   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      604   define variable v-waitfram-action01         as character   no-undo .
      605   define variable v-waitfram-action02         as character   no-undo .
      606   define variable v-waitfram-action03         as character   no-undo .
      607   define variable mWaitFramTextBeg            as character   no-undo.
      608   define variable mWaitFramTextEnd            as character   no-undo.
      609   define variable mWaitFramView               as logical     no-undo.
      610   define variable mWaitProcEvent              as logical     no-undo init yes.
      611   define variable mWaitFramInterval           as integer     no-undo init 1 .
      612   define variable mWaitFramStop               as logical     no-undo.
      613   define variable mWaitFramStopUser           as logical     no-undo.
      614   define variable mWaitFramStopTimeOut        as logical     no-undo.
      615   define variable mWaitFramStartProc          as datetime-tz no-undo.
      616   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      617   define button B-WaitFramStop auto-end-key
      618        label "Стоп"
      619        size 10 by 1 tooltip "Остоновить процесс".
      620   define button B-viewProcInfo
      621        label "Информация"
      622        size 15 by 1 tooltip "Информация о процесс".
      623   define frame waitfram
      624     v-waitfram-action01 format "x(72)" no-label skip
      625     v-waitfram-action02 format "x(72)" no-label skip
      626     v-waitfram-action03 format "x(72)" no-label skip
      627     B-viewProcInfo
      628     B-WaitFramStop at row 4 col 30
      629     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      630     .
      631   define new global shared variable mBatchMode as logical no-undo init ?.
      632   define variable mFramBachModHandle as handle no-undo.
      633   mFramBachModHandle = frame waitfram:handle.
      634   define variable mFameOldVis as logical no-undo.
      635   define variable mVisCUrentVin as logical no-undo.
      636   if session:batch-mode
      637   then
      638      mBatchMode = yes.
      639   if mBatchMode = ? then do:
      640     mVisCUrentVin = current-window:visible.
      641     mFameOldVis = mFramBachModHandle:visible.
      642     mFramBachModHandle:visible  = yes.
      643     mBatchMode = mFramBachModHandle:visible ne yes.
      644     mFramBachModHandle:visible = mFameOldVis.
      645     current-window:visible = mVisCUrentVin.
      646   end.
      647    if  log-manager:logfile-name ne ?
      648     then DO:
      649         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      650         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      651         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      652     end.
      653   on choose of B-WaitFramStop in frame waitfram
      654   do:
      655     mWaitFramStop = yes.
      656     mWaitFramStopUser = yes.
      657   end.
      658   function waitfram-check-timeout returns logical():
      659      define variable vtime as int64 no-undo.
      660      if mWaitFramStopTimeOut
      661      then
      662         return yes.
      663      vtime = ( now - mWaitFramStartProc ) / 1000 .
      664      if     mWaitFramTimeOut ne ?
      665         and mWaitFramTimeOut ne 0
      666         and mWaitFramTimeOut lt vtime
      667      then do:
      668         mWaitFramStopTimeOut = yes.
      669      end.
      670      return mWaitFramStopTimeOut.
      671   end.
      672   procedure waitfram-hide :
      673     if not session:batch-mode
      674     then do
      675     on error undo, return error return-value
      676     :
      677       pause 0 before-hide .
      678       if not mBatchMode then
      679         hide frame waitfram .
      680     if     not mWaitFramView
      681        and mWaitProcEvent
      682     then
      683       process events .
      684     end.
      685   end procedure.
      686   procedure waitfram-show :
      687     define input  parameter p-message as character no-undo .
      688     define variable v-left-margin as integer   no-undo .
      689     if not session:batch-mode
      690     then do
      691     on error undo, return error return-value
      692     :
      693       if length(p-message) <= 70 then do:
      694         assign
      695           v-left-margin = integer((70 - length(p-message)) / 2)
      696         .
      697         assign
      698           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      699         .
      700         assign
      701           v-waitfram-action01 = " "
      702           v-waitfram-action02 = " "
      703                                    + fill(" ", v-left-margin)
      704                                    + p-message
      705           v-waitfram-action03 = " "
      706         .
      707       end.
      708       else do:
      709         define variable vRindex1 as integer no-undo.
      710         define variable vRindex2 as integer no-undo.
      711         vRindex1 = r-index(p-message," ",70).
      712         if vRindex1 = 0
      713         then
      714            vRindex1 = 70.
      715         if length(p-message)  <= vRindex1 + 70 then do:
      716           assign
      717             v-waitfram-action01 = " "
      718             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      719             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      720           .
      721         end.
      722         else do:
      723           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      724           if vRindex2 <= vRindex1
      725           then
      726              vRindex2 = vRindex1 + 70.
      727           assign
      728             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      729             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      730             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      731           .
      732         end.
      733       end.
      734       B-viewProcInfo:visible   in frame waitfram = no.
      735       B-viewProcInfo:sensitive in frame waitfram = no.
      736       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      737       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      738       if  (   mWaitFramView
      739          or  mWaitProcEvent)
      740          and not mBatchMode
      741       then
      742          display
      743             v-waitfram-action01 skip
      744             v-waitfram-action02 skip
      745             v-waitfram-action03 skip
      746          with frame waitfram .
      747       if     mWaitFramView
      748          then do:
      749             if     mWaitFramInterval ne ?
      750                and not mBatchMode
      751             then
      752                wait-for go of frame waitfram pause mWaitFramInterval.
      753          end.
      754          else
      755             if     mWaitProcEvent
      756                and not mBatchMode
      757             then
      758                process events .
      759     end.
      760   end procedure.
      761      procedure waitfram-show-this:
      762         define input  parameter iInterval as int64 no-undo.
      763         define variable vtime as int64 no-undo.
      764         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      765         mWaitFramInterval = iInterval.
      766         run waitfram-show (substitute("&1&2 &3&4" ,
      767                                       mWaitFramTextBeg ,
      768                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      769                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      770                                       mWaitFramTextEnd
      771                                      )
      772                           ).
      773      end.
      774      procedure WaitFramRunPause:
      775         define input  parameter iInterval as dec no-undo.
      776         define variable vStart  as datetime-tz no-undo.
      777         define variable vend    as datetime-tz no-undo.
      778         define variable vint as int64 no-undo.
      779         define variable vOk as logical no-undo.
      780         vStart = now.
      781         vend   = vStart.
      782         publish "WaitFramPause" (iInterval,output vOk).
      783         vend   =  now.
      784         vint = vend - vStart.
      785         vint = iInterval - vint / 1000.
      786         if     not mWaitFramStop
      787            and (   vint > 0
      788                 or (    not vOk
      789                     and iInterval eq ?
      790                     )
      791                 )
      792         then
      793            run waitfram-show-this (iInterval).
      794         vend   =  now.
      795         vint = vend - vStart.
      796         vint = iInterval - vint / 1000.
      797         if     not mWaitFramStop
      798            and vint > 0
      799         then do:
      800            run gbl/pause.p (vint * 1000).
      801         end.
      802         if iInterval ne ?
      803         then
      804            publish "WaitFramStop".
      805         waitfram-check-timeout().
      806      end.
      807      procedure WaitFramWaitFor:
      808         define input  parameter iInterval as dec no-undo.
      809         assign
      810            mWaitFramStartProc   = now
      811            mWaitFramStopUser    = no
      812            mWaitFramStopTimeOut = no
      813         .
      814         block-wait:
      815         do while not mWaitFramStop:
      816            run WaitFramRunPause (iInterval).
      817            if  waitfram-check-timeout()
      818            then do:
      819               leave block-wait.
      820            end.
      821         end.
      822         run waitfram-hide.
      823      end.
      824   procedure waitfram-join :
      825     define input  parameter p-line-1  as character no-undo .
      826     define input  parameter p-line-2  as character no-undo .
      827     define input  parameter p-line-3  as character no-undo .
      828     define output parameter p-message as character no-undo .
      829     do
      830     on error undo, return error return-value
      831     :
      832       assign
      833         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      834                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      835                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      836       .
      837     end.
      838   end procedure.
      839   function waitfram-join-function returns character
      840     (input p-line-1 as character
      841     ,input p-line-2 as character
      842     ,input p-line-3 as character
      843     ).
      844     define variable v-message as character no-undo .
      845     run waitfram-join in this-procedure
      846       (input  p-line-1
      847       ,input  p-line-2
      848       ,input  p-line-3
      849       ,output v-message
      850       ) .
      851     return v-message .
      852   end function .
      853   define temp-table temp-font no-undo
      854     field fontnum  as integer
      855     field fontname as character
      856     field fontsize as character
      857     field fonttype as character
      858     field font-h   as integer
      859     field font-w   as integer
      860     field v-row    as integer
      861     field v-col    as integer
      862     field v-row-lans as integer
      863     field v-col-lans as integer
      864   index pi fontnum
      865   .
      866   procedure get-font-ini :
      867     do
      868     on error undo, return error return-value
      869     :
      870   define variable ii as integer   no-undo .
      871   define variable v-font7 as character no-undo .
      872   define variable v-font as character no-undo .
      873   define variable loc-name as character no-undo .
      874   define variable loc-size as character no-undo .
      875   define variable loc-type as character no-undo .
      876   define variable old_H as integer   no-undo .
      877   define variable old_w as integer   no-undo .
      878   define variable old-row  as integer   no-undo .
      879   define variable old-col  as integer   no-undo .
      880   define variable old-row-lans  as integer   no-undo .
      881   define variable old-col-lans  as integer   no-undo .
      882   define variable vv as integer   no-undo .
      883   empty temp-table temp-font.
      884     GET-KEY-VALUE SECTION "fonts" KEY "font7" VALUE v-font7 .
      885       case num-entries (v-font7) :
      886         when 4 then do:
      887             assign
      888               loc-name = entry ( 1 , v-font7 )
      889               loc-size = entry ( 2 , v-font7 )
      890               loc-type = entry ( 3 , v-font7 ) + "," +  entry ( 4 , v-font7 )
      891             .
      892         end.
      893         when 3 then do:
      894             assign
      895               loc-name = entry ( 1 , v-font7 )
      896               loc-size = entry ( 2 , v-font7 )
      897               loc-type = entry ( 3 , v-font7 )
      898             .
      899         end.
      900         when 2 then  do:
      901             assign
      902               loc-name = entry ( 1 , v-font7 )
      903               loc-size = entry ( 2 , v-font7 )
      904               loc-type = ""
      905             .
      906         end.
      907         when 1 then do:
      908             assign
      909               loc-name = trim(entry ( 1 , v-font7 ))
      910               loc-size = ""
      911               loc-type = ""
      912             .
      913         end.
      914       end case.
      915     create temp-font.
      916     assign
      917       temp-font.fontnum  = 7
      918       temp-font.fontname = trim(loc-name)
      919       temp-font.fontsize = trim(loc-size)
      920       temp-font.fonttype = trim(loc-type)
      921       temp-font.v-row    = 62
      922       temp-font.v-col    = 136
      923       temp-font.v-row-lans = 43
      924       temp-font.v-col-lans = 198
      925     .
      926     repeat ii = 16 to 100 :
      927       get-key-value section 'fonts' key 'font' + string(ii)   value v-font  .
      928       if v-font = "" or v-font = ? then leave.
      929       case num-entries (v-font) :
      930         when 4 then do:
      931             assign
      932               loc-name = entry ( 1 , v-font )
      933               loc-size = entry ( 2 , v-font )
      934               loc-type = entry ( 3 , v-font ) + "," +  entry ( 4 , v-font )
      935             .
      936         end.
      937         when 3 then do:
      938             assign
      939               loc-name = entry ( 1 , v-font )
      940               loc-size = entry ( 2 , v-font )
      941               loc-type = entry ( 3 , v-font )
      942             .
      943         end.
      944         when 2 then do:
      945             assign
      946               loc-name = entry ( 1 , v-font )
      947               loc-size = entry ( 2 , v-font )
      948               loc-type = ""
      949             .
      950         end.
      951         when 1 then do:
      952             assign
      953               loc-name = trim(entry ( 1 , v-font ))
      954               loc-size = ""
      955               loc-type = ""
      956             .
      957         end.
      958       end case.
      959     create temp-font.
      960     assign
      961       temp-font.fontnum  = ii
      962       temp-font.fontname = trim(loc-name)
      963       temp-font.fontsize = trim(loc-size)
      964       temp-font.fonttype = trim(loc-type)
      965     .
      966     end.
      967       for each temp-font :
      968          vv = integer(entry(2,temp-font.fontsize, "=" )) no-error .
      969          if  vv = ? then vv =  0 .
      970           run rep/exfont.p (
      971             input   temp-font.fontname ,
      972             input   vv ,
      973             input   temp-font.fonttype ,
      974             output  temp-font.font-h   ,
      975             output  temp-font.font-w   )
      976           .
      977       end.
      978   find first temp-font where  temp-font.fontnum  = 7  .
      979   old_H = temp-font.font-H .
      980   old_w = temp-font.font-W .
      981   old-row = temp-font.v-row .
      982   old-col = temp-font.v-col .
      983   old-row-lans = temp-font.v-row-lans .
      984   old-col-lans = temp-font.v-col-lans .
      985       for each temp-font where
      986                temp-font.fontnum  <> 7 :
      987           assign
      988               temp-font.v-row    = old_H * old-row / temp-font.font-h
      989               temp-font.v-col    = old_W * old-col / temp-font.font-W
      990               temp-font.v-row-lans    = old_H * old-row-lans / temp-font.font-h
      991               temp-font.v-col-lans    = old_W * old-col-lans / temp-font.font-W
      992           .
      993       end.
      994     end.
      995   end procedure.
      996   PROCEDURE How-name :
      997   define input  parameter h as integer no-undo .
      998   define input  parameter w as integer no-undo .
      999   define output parameter n as character  no-undo .
     1000   define variable A4port-H as integer   no-undo init 63.
     1001   define variable A4port-W as integer   no-undo init 136.
     1002   define variable A4lans-H as integer   no-undo init 43.
     1003   define variable A4lans-W as integer   no-undo init 198.
     1004   define variable Strim-W  as integer   no-undo init 278.
     1005   run define-a4-size (
     1006        input ReportFontNum
     1007       ,output A4port-H
     1008       ,output A4port-W
     1009       ,output A4lans-H
     1010       ,output A4lans-W ).
     1011   If w >= 1 and w <= A4port-W Then DO:
     1012     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     1013     If h > A4lans-H  and h <= A4port-H Then n = "A4-port":U.
     1014     If h > A4port-H              Then n = "to-file":U.
     1015   End.
     1016   If w > A4port-W and w <= A4lans-W Then DO:
     1017     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     1018     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     1019     If h > A4port-H              Then n = "to-file":U.
     1020   End.
     1021   If w > A4lans-W and w <= Strim-W Then DO:
     1022     If h >= 1  and h <= A4lans-H Then n = "to-file":U.
     1023     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     1024     If h > A4port-H              Then n = "to-file":U.
     1025   End.
     1026   If w > Strim-W Then DO:
     1027      n = "to-file":U.
     1028   End.
     1029   END PROCEDURE.
     1030   PROCEDURE define-a4-size :
     1031   define input  parameter p-ReportFontNum as integer   no-undo .
     1032   define output parameter A4port-H as integer   no-undo .
     1033   define output parameter A4port-W as integer   no-undo .
     1034   define output parameter A4lans-H as integer   no-undo .
     1035   define output parameter A4lans-W as integer   no-undo .
     1036   if not can-find (first temp-font ) then do:
     1037      run get-font-ini .
     1038   end.
     1039   find first temp-font where temp-font.fontnum = p-ReportFontNum no-error .
     1040   if available temp-font then do:
     1041   assign
     1042     A4port-H = temp-font.v-row
     1043     A4port-W = temp-font.v-col
     1044     A4lans-H = temp-font.v-row-lans
     1045     A4lans-W = temp-font.v-col-lans
     1046   .
     1047   end.
     1048   else do:
     1049   assign
     1050     A4port-H = 63
     1051     A4port-W = 136
     1052     A4lans-H = 43
     1053     A4lans-W = 198
     1054   .
     1055   end.
     1056   END PROCEDURE.
     1057   define variable vss-include-info9 as character format "X(65)" no-undo
     1058   initial "@(#)$Workfile$ $Revision$".
     1059   procedure grplib-get-full-name :
     1060      define input parameter p-node-code  as integer      no-undo.
     1061      define output parameter p-full-name as character    no-undo.
     1062      do
     1063   on error undo, return error
     1064   :
     1065       define variable v-upper-code    as integer           no-undo.
     1066       define buffer buf_gds-grp       for ub.gds-grp.
     1067       define buffer buf_upper_gds-grp for ub.gds-grp.
     1068       find first buf_gds-grp no-lock
     1069            where buf_gds-grp.node-code = p-node-code
     1070       no-error.
     1071       if not available buf_gds-grp
     1072       then do:
     1073           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     1074       end.
     1075       assign
     1076           p-full-name  = ""
     1077           v-upper-code = 1
     1078       .
     1079       do while buf_gds-grp.upper-code <> 0
     1080       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     1081       :
     1082           assign
     1083               p-full-name  = buf_gds-grp.node-name
     1084                            + (if p-full-name <> "" then chr(47) else "")
     1085                            + p-full-name
     1086               v-upper-code = buf_gds-grp.upper-code
     1087           .
     1088           find first buf_gds-grp no-lock
     1089                where buf_gds-grp.node-code = v-upper-code
     1090           no-error.
     1091           if not available buf_gds-grp
     1092           then do:
     1093               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
     1094                                   + string( v-upper-code )
     1095                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     1096           end.
     1097       end.
     1098       assign
     1099       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     1100       .
     1101   end.
     1102   end .
     1103   procedure grplib-get-node-from-full-name :
     1104   define input parameter p-full-name as character no-undo .
     1105   define output parameter p-node-code as integer no-undo .
     1106   define variable v-ii as integer no-undo .
     1107   define variable v-upper-code as integer no-undo .
     1108   define variable v-root-code as integer no-undo .
     1109   define variable v-entry as character no-undo .
     1110   define buffer buf_gds-grp       for ub.gds-grp.
     1111   do
     1112   on error undo, return error
     1113   :
     1114     find first buf_gds-grp no-lock
     1115         where buf_gds-grp.upper-code = 0
     1116     no-error .
     1117     if not available buf_gds-grp
     1118     then do:
     1119         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
     1120     end.
     1121     else do:
     1122       assign
     1123       v-root-code = buf_gds-grp.node-code
     1124       .
     1125     end.
     1126     v-upper-code = v-root-code.
     1127     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     1128       assign
     1129       v-entry = entry(v-ii, p-full-name, chr(47)).
     1130       if v-entry = '' then leave.
     1131       find first buf_gds-grp no-lock where
     1132                 buf_gds-grp.node-name = v-entry
     1133             and buf_gds-grp.upper-code = v-upper-code
     1134             no-error.
     1135       if not available buf_gds-grp then do:
     1136         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     1137       end.
     1138       else do:
     1139         p-node-code = buf_gds-grp.node-code.
     1140         v-upper-code = buf_gds-grp.node-code.
     1141       end.
     1142     end.
     1143   end.
     1144   end .
     1145   define variable vss-include-info10 as character format "X(65)" no-undo
     1146   initial "@(#)$Workfile$ $Revision$".
     1147   define variable v-fmtcli-name          as character    no-undo.
     1148   define variable v-fmtcli-engl-name     as character    no-undo.
     1149   define variable v-fmtcli-addres        as character    no-undo.
     1150   define variable v-fmtcli-post-addres   as character    no-undo.
     1151   define variable v-fmtcli-full-addres   as character    no-undo.
     1152   define variable v-fmtcli-phone         as character    no-undo.
     1153   define variable v-fmtcli-inn           as character    no-undo.
     1154   define variable v-fmtcli-kpp           as character    no-undo.
     1155   define variable v-fmtcli-okpo          as character    no-undo.
     1156   define variable v-fmtcli-country       as character    no-undo.
     1157   define variable v-fmtcli-city          as character    no-undo.
     1158   define variable v-fmtcli-index         as character    no-undo.
     1159   define variable v-fmtcli-schet-exists  as logical      no-undo.
     1160   define variable v-fmtcli-bank-exists   as logical      no-undo.
     1161   define variable v-fmtcli-bank-r-schet  as character    no-undo.
     1162   define variable v-fmtcli-bank-c-schet  as character    no-undo.
     1163   define variable v-fmtcli-bank-bik      as character    no-undo.
     1164   define variable v-fmtcli-bank-name     as character    no-undo.
     1165   define variable v-fmtcli-bank-addres   as character    no-undo.
     1166   define variable v-fmtcli-bank-city     as character    no-undo.
     1167   procedure fmtcli-get-bank :
     1168   define input parameter p-host-code      as integer          no-undo.
     1169   define input parameter p-obj-type       as character        no-undo.
     1170   define input parameter p-obj-code       as integer          no-undo.
     1171   define input parameter p-curr-code      as integer          no-undo.
     1172       define buffer buf_fin-schet     for ub.fin-schet.
     1173       define buffer buf_fin-bank      for ub.fin-bank.
     1174   do
     1175   for buf_fin-schet
     1176     , buf_fin-bank
     1177   on error undo, return error
     1178   :
     1179       assign
     1180           v-fmtcli-schet-exists       = no
     1181           v-fmtcli-bank-exists        = no
     1182           v-fmtcli-bank-r-schet       = "":U
     1183           v-fmtcli-bank-c-schet       = "":U
     1184           v-fmtcli-bank-bik           = "":U
     1185           v-fmtcli-bank-name          = "":U
     1186           v-fmtcli-bank-addres        = "":U
     1187           v-fmtcli-bank-city          = "":U
     1188       .
     1189       search-for-schet:
     1190       for each buf_fin-schet no-lock
     1191          where buf_fin-schet.host-code = p-host-code
     1192            and buf_fin-schet.cli-type  = p-obj-type
     1193            and buf_fin-schet.cli-code  = p-obj-code
     1194            and buf_fin-schet.curr-code = p-curr-code
     1195       on error undo, return error
     1196       :
     1197           if buf_fin-schet.status_   = 'удал':U
     1198           then do:
     1199           end.
     1200           else do:
     1201               assign
     1202                   v-fmtcli-schet-exists   = yes
     1203                   v-fmtcli-bank-r-schet   = trim( buf_fin-schet.r-schet )
     1204                   v-fmtcli-bank-c-schet   = trim( buf_fin-schet.c-schet )
     1205               .
     1206               find first buf_fin-bank no-lock
     1207                    where buf_fin-bank.host-code = p-host-code
     1208                      and buf_fin-bank.code-bank = buf_fin-schet.code-bank
     1209               no-error.
     1210               if available buf_fin-bank
     1211               then do:
     1212                   assign
     1213                       v-fmtcli-bank-exists      = yes
     1214                       v-fmtcli-bank-bik         = trim( buf_fin-bank.bik )
     1215                       v-fmtcli-bank-name        = trim( buf_fin-bank.bank-name )
     1216                       v-fmtcli-bank-addres      = trim(buf_fin-bank.addres)
     1217                       v-fmtcli-bank-city      = trim(buf_fin-bank.bank-city)
     1218                   .
     1219               end.
     1220               else do:
     1221                   assign
     1222                       v-fmtcli-bank-exists    = no
     1223                       v-fmtcli-bank-bik       = "":U
     1224                       v-fmtcli-bank-name      = "":U
     1225                       v-fmtcli-bank-addres    = "":U
     1226                       v-fmtcli-bank-city      = "":U
     1227                   .
     1228               end.
     1229               leave search-for-schet.
     1230           end.
     1231       end.
     1232   end.
     1233   end procedure.
     1234   procedure fmtcli-get-client :
     1235   define input parameter p-obj-type       as character    no-undo.
     1236   define input parameter p-obj-code       as integer      no-undo.
     1237       define variable v-temp-fmtcli-address      as character     no-undo.
     1238       define variable v-num-country-city    as integer      no-undo.
     1239       define buffer buf_clients   for ub.clients.
     1240       define buffer buf_firm      for ub.firm.
     1241       define buffer buf_store     for ub.store.
     1242       define buffer buf_shop      for ub.shop.
     1243       define buffer buf_person    for ub.person.
     1244   do
     1245   for buf_clients
     1246     , buf_firm
     1247     , buf_store
     1248     , buf_shop
     1249     , buf_person
     1250   on error undo, return error
     1251   :
     1252       assign
     1253           v-fmtcli-name           = "":U
     1254           v-fmtcli-addres         = "":U
     1255           v-fmtcli-post-addres    = "":U
     1256           v-fmtcli-full-addres    = "":U
     1257           v-fmtcli-phone          = "":U
     1258           v-fmtcli-inn            = "":U
     1259           v-fmtcli-kpp            = "":U
     1260           v-fmtcli-okpo           = "":U
     1261           v-fmtcli-city           = "":U
     1262           v-fmtcli-index          = "":U
     1263           v-fmtcli-country        = "":U
     1264       .
     1265       find first buf_clients no-lock
     1266            where buf_clients.obj-type = p-obj-type
     1267              and buf_clients.obj-code = p-obj-code
     1268       .
     1269       assign
     1270           v-fmtcli-name = buf_clients.obj-name
     1271       .
     1272       case buf_clients.obj-type:
     1273          when 'орг':U
     1274          then do:
     1275               find first buf_firm no-lock
     1276                    where buf_firm.firm-code = buf_clients.obj-code
     1277                    no-error
     1278               .
     1279               if available buf_firm
     1280               then do:
     1281                   assign
     1282                       v-num-country-city = num-entries( buf_firm.city )
     1283                       v-fmtcli-engl-name = buf_firm.engl-name
     1284                   .
     1285                   if v-num-country-city > 0
     1286                   then do:
     1287                       assign
     1288                           v-fmtcli-country    = trim( entry( 1, buf_firm.city ) )
     1289                       .
     1290                   end.
     1291                   if v-num-country-city > 1
     1292                   then do:
     1293                       assign
     1294                           v-fmtcli-city       = trim( entry( 2, buf_firm.city ) )
     1295                       .
     1296                   end.
     1297                   run fmtcli-concatenate-strings in this-procedure (
     1298                         input v-fmtcli-full-addres
     1299                       , input v-fmtcli-country
     1300                       , input ", ":U
     1301                       , input 50
     1302                       , output v-fmtcli-full-addres
     1303                   ).
     1304                   run fmtcli-concatenate-strings in this-procedure (
     1305                         input v-fmtcli-full-addres
     1306                       , input v-fmtcli-city
     1307                       , input ", ":U
     1308                       , input 50
     1309                       , output v-fmtcli-full-addres
     1310                   ).
     1311                   run fmtcli-concatenate-strings in this-procedure (
     1312                         input v-fmtcli-full-addres
     1313                       , input IF buf_firm.ind = 0 THEN "" ELSE string( buf_firm.ind )
     1314                       , input ", ":U
     1315                       , input 50
     1316                       , output v-fmtcli-full-addres
     1317                   ).
     1318                   run fmtcli-concatenate-strings in this-procedure (
     1319                         input v-fmtcli-post-addres
     1320                       , input v-fmtcli-country
     1321                       , input ", ":U
     1322                       , input 50
     1323                       , output v-fmtcli-post-addres
     1324                   ).
     1325                   run fmtcli-concatenate-strings in this-procedure (
     1326                         input v-fmtcli-post-addres
     1327                       , input v-fmtcli-city
     1328                       , input ", ":U
     1329                       , input 50
     1330                       , output v-fmtcli-post-addres
     1331                   ).
     1332                   run fmtcli-concatenate-strings in this-procedure (
     1333                         input v-fmtcli-post-addres
     1334                       , input string( buf_firm.ind )
     1335                       , input ", ":U
     1336                       , input 50
     1337                       , output v-fmtcli-post-addres
     1338                   ).
     1339                   run fmtcli-concatenate-strings in this-procedure (
     1340                         input substring( buf_firm.addres1, 1, 50 )
     1341                       , input buf_firm.addres2
     1342                       , input " ":U
     1343                       , input 50
     1344                       , output v-temp-fmtcli-address
     1345                   ).
     1346                   run fmtcli-concatenate-strings in this-procedure (
     1347                         input v-temp-fmtcli-address
     1348                       , input substring( buf_firm.addres1, 51, 50 )
     1349                       , input " ":U
     1350                       , input 50
     1351                       , output v-temp-fmtcli-address
     1352                   ).
     1353                   run fmtcli-concatenate-strings in this-procedure (
     1354                         input v-temp-fmtcli-address
     1355                       , input substring( buf_firm.addres1, 101, 50 )
     1356                       , input " ":U
     1357                       , input 50
     1358                       , output v-temp-fmtcli-address
     1359                   ).
     1360                   assign
     1361                       v-fmtcli-addres = v-temp-fmtcli-address
     1362                   .
     1363                   if buf_firm.addres1 <> ?
     1364                   then do:
     1365                       run fmtcli-concatenate-strings in this-procedure (
     1366                             input v-fmtcli-full-addres
     1367                           , input v-fmtcli-addres
     1368                           , input ", ":U
     1369                           , input 0
     1370                           , output v-fmtcli-full-addres
     1371                       ).
     1372                   end.
     1373                   run fmtcli-concatenate-strings in this-procedure (
     1374                         input substring( buf_firm.post-addr1, 1, 50 )
     1375                       , input buf_firm.post-addr2
     1376                       , input " ":U
     1377                       , input 50
     1378                       , output v-fmtcli-post-addres
     1379                   ).
     1380                   run fmtcli-concatenate-strings in this-procedure (
     1381                         input v-fmtcli-post-addres
     1382                       , input substring( buf_firm.post-addr1, 51, 50 )
     1383                       , input " ":U
     1384                       , input 50
     1385                       , output v-fmtcli-post-addres
     1386                   ).
     1387                   run fmtcli-concatenate-strings in this-procedure (
     1388                         input v-fmtcli-post-addres
     1389                       , input substring( buf_firm.post-addr1, 101, 50 )
     1390                       , input " ":U
     1391                       , input 50
     1392                       , output v-fmtcli-post-addres
     1393                   ).
     1394                   assign
     1395                       v-fmtcli-phone         = buf_firm.phone
     1396                       v-fmtcli-inn           = buf_firm.inn
     1397                       v-fmtcli-kpp           = buf_firm.kpp
     1398                       v-fmtcli-okpo          = buf_firm.okpo
     1399                       v-fmtcli-index         = string( buf_firm.ind )
     1400                   .
     1401               end.
     1402          end.
     1403          when 'маг':U
     1404          then do:
     1405               find first buf_shop no-lock
     1406                    where buf_shop.obj-code = buf_clients.obj-code
     1407               .
     1408               if available buf_shop
     1409               then do:
     1410                   run fmtcli-concatenate-strings in this-procedure (
     1411                         input buf_shop.addres1
     1412                       , input buf_shop.addres2
     1413                       , input " ":U
     1414                       , input 50
     1415                       , output v-fmtcli-addres
     1416                   ).
     1417                   assign
     1418                       v-fmtcli-full-addres = v-fmtcli-addres
     1419                       v-fmtcli-post-addres = v-fmtcli-addres
     1420                       v-fmtcli-phone       = buf_shop.phone
     1421                       v-fmtcli-inn         = "":U
     1422                       v-fmtcli-kpp         = "":U
     1423                       v-fmtcli-okpo        = "":U
     1424                       v-fmtcli-city        = "":U
     1425                       v-fmtcli-index       = "":U
     1426                   .
     1427               end.
     1428          end.
     1429          when 'скл':U
     1430          then do:
     1431               find first buf_store no-lock
     1432                    where buf_store.obj-code = buf_clients.obj-code
     1433               .
     1434               if available buf_store
     1435               then do:
     1436                   run fmtcli-concatenate-strings in this-procedure (
     1437                         input buf_store.addres1
     1438                       , input buf_store.addres2
     1439                       , input " ":U
     1440                       , input 50
     1441                       , output v-fmtcli-addres
     1442                   ).
     1443                   assign
     1444                       v-fmtcli-full-addres = v-fmtcli-addres
     1445                       v-fmtcli-phone       = buf_store.phone
     1446                       v-fmtcli-inn         = "":U
     1447                       v-fmtcli-kpp         = "":U
     1448                       v-fmtcli-okpo        = "":U
     1449                       v-fmtcli-city        = "":U
     1450                       v-fmtcli-index       = "":U
     1451                   .
     1452               end.
     1453          end.
     1454          when 'чел':U
     1455          then do:
     1456               find first buf_person no-lock
     1457                    where buf_person.psn-code = buf_clients.obj-code
     1458               .
     1459               if available buf_person
     1460               then do:
     1461                   run fmtcli-concatenate-strings in this-procedure (
     1462                         input ( if buf_person.ind = 0 or buf_person.ind = ?
     1463                                 then "":U
     1464                                 else string( buf_person.ind, "999999")
     1465                                 )
     1466                       , input buf_person.city
     1467                       , input ", ":U
     1468                       , input 0
     1469                       , output v-fmtcli-full-addres
     1470                   ).
     1471                   assign
     1472                       v-fmtcli-addres = buf_person.address
     1473                   .
     1474                   run fmtcli-concatenate-strings in this-procedure (
     1475                         input v-fmtcli-full-addres
     1476                       , input v-fmtcli-addres
     1477                       , input ", ":U
     1478                       , input 0
     1479                       , output v-fmtcli-full-addres
     1480                   ).
     1481                   assign
     1482                       v-fmtcli-phone     = buf_person.phone1
     1483                       v-fmtcli-inn       = buf_person.inn
     1484                       v-fmtcli-kpp       = buf_person.kpp
     1485                       v-fmtcli-okpo      = buf_person.okpo
     1486                       v-fmtcli-city      = buf_person.city
     1487                       v-fmtcli-index     = string( buf_person.ind )
     1488                   .
     1489               end.
     1490          end.
     1491       end case.
     1492   end.
     1493   end procedure.
     1494   procedure fmtcli-concatenate-strings :
     1495   define input parameter p-string-1       as character        no-undo.
     1496   define input parameter p-string-2       as character        no-undo.
     1497   define input parameter p-delimiter      as character        no-undo.
     1498   define input parameter p-length         as integer          no-undo.
     1499   define output parameter p-out-string    as character        no-undo.
     1500   do
     1501   on error undo, return error
     1502   :
     1503       assign
     1504           p-out-string = ( if p-string-1 = ?
     1505                            then "":U
     1506                            else trim( p-string-1 ) )
     1507       .
     1508       assign
     1509           p-out-string = p-out-string
     1510                        + ( if p-out-string = "":U
     1511                            or length( p-out-string ) = p-length
     1512                            or p-string-2 = ?
     1513                            or trim( p-string-2 ) = "":U
     1514                            then "":U
     1515                            else p-delimiter )
     1516                        + ( if p-string-2 = ?
     1517                            or trim( p-string-2 ) = "":U
     1518                            then "":U
     1519                            else trim( p-string-2 ) )
     1520       .
     1521   end.
     1522   end procedure.
     1523   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1524     define variable v-prg-bar_cb-handle     as handle             no-undo .
     1525     procedure prg-bar_init-cb-handle :
     1526       define input  parameter p-cb-handle as handle    no-undo .
     1527     do
     1528     on error undo, return error return-value
     1529     :
