     1211   procedure paramls-write :
     1212     define input  parameter p-code     as character no-undo .
     1213     define input  parameter p-sub-code as character no-undo .
     1214     define input  parameter p-value    as character no-undo .
     1215     define buffer buf_temp-param for temp-param .
     1216     do
     1217     on error undo, return error return-value
     1218     :
     1219       find first buf_temp-param
     1220         where buf_temp-param.param-code     = p-code
     1221           and buf_temp-param.param-sub-code = p-sub-code
     1222         no-error .
     1223       if not available buf_temp-param then do:
     1224         create buf_temp-param .
     1225         assign
     1226           buf_temp-param.param-code     = p-code
     1227           buf_temp-param.param-sub-code = p-sub-code
     1228         .
     1229       end.
     1230       assign
     1231         buf_temp-param.param-value = p-value
     1232       .
     1233     end.
     1234   end procedure.
     1235   procedure paramls-read :
     1236     define input  parameter p-code          as character no-undo .
     1237     define input  parameter p-sub-code      as character no-undo .
     1238     define input  parameter p-default-value as character no-undo .
     1239     define output parameter p-value         as character no-undo .
     1240     define buffer buf_temp-param for temp-param .
     1241     do
     1242     on error undo, return error return-value
     1243     :
     1244       find first buf_temp-param
     1245         where buf_temp-param.param-code     = p-code
     1246           and buf_temp-param.param-sub-code = p-sub-code
     1247         no-error .
     1248       if available buf_temp-param then do:
     1249         assign
     1250           p-value = buf_temp-param.param-value
     1251         .
     1252       end.
     1253       else do:
     1254         assign
     1255           p-value = p-default-value
     1256         .
     1257       end.
     1258     end.
     1259   end procedure.
     1260   procedure paramls-append :
     1261     define input  parameter p-code     as character no-undo .
     1262     define input  parameter p-sub-code as character no-undo .
     1263     define input  parameter p-value    as character no-undo .
     1264     define buffer buf_temp-param for temp-param .
     1265     do
     1266     on error undo, return error return-value
     1267     :
     1268       find first buf_temp-param
     1269            where buf_temp-param.param-code     = p-code
     1270              and buf_temp-param.param-sub-code = p-sub-code
     1271         no-error .
     1272       if not available buf_temp-param then do:
     1273         create buf_temp-param .
     1274         assign
     1275           buf_temp-param.param-code     = p-code
     1276           buf_temp-param.param-sub-code = p-sub-code
     1277           buf_temp-param.param-value    = p-value
     1278         .
     1279       end.
     1280       else do:
     1281           assign
     1282               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     1283           .
     1284       end.
     1285     end.
     1286   end procedure.
