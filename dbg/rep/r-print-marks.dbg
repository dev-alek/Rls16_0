     1357   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1358   procedure base64-encode :
     1359     define input  parameter v-string        as character no-undo .
     1360     define output parameter v-base64-encode as character no-undo .
     1361     do
     1362     on error undo, return error return-value
     1363     :
     1364       define variable v-raw     as raw       no-undo .
     1365       define variable v-raw-str as character no-undo .
     1366       if v-string = ?
     1367       then do:
     1368         undo, return error "base64-encode: строка имеет неопределенное значение" .
     1369       end.
     1370       assign
     1371         length(v-raw) = length(v-string) + 1
     1372       .
     1373       assign
     1374         put-string(v-raw, 1) = v-string
     1375       .
     1376       assign
     1377         v-raw-str = string(v-raw)
     1378       .
     1379       assign
     1380         length(v-raw) = 0
     1381       .
     1382       assign
     1383         v-base64-encode = substring(v-raw-str, 7)
     1384       .
     1385     end.
     1386   end.
     1387   define variable qr-code     as character no-undo.
     1388   define variable qr-code-out as character no-undo.
     1389   define variable v-arc       as character no-undo .
     1390   define variable v-cmd       as character no-undo .
     1391   jj = 0 .
     1392   for each bf_doc-line no-lock where bf_doc-line.doc-code = bf_trn-doc.doc-code:
     1393     find first bf_goods no-lock where bf_goods.artic = bf_doc-line.artic and bf_goods.prod-code = bf_doc-line.prod-code and
     1394       bf_goods.prod-type = bf_doc-line.prod-type no-error .
     1395     if available (bf_goods) then
     1396     do:
     1397       for each buf_marking-lines no-lock where buf_marking-lines.gds-code = bf_goods.gds-code and buf_marking-lines.out-code = 'free-zone':U,
     1398       first buf_marking no-lock where buf_marking.sts = Marking:FreeZone:KeyIntDB:
     1399         find first buf_marking-attr no-lock where buf_marking-attr.mark = buf_marking-lines.mark and buf_marking-attr.attr-code begins "inv-doc" no-error .
     1400         if available (buf_marking-attr) then do:
     1401           next .
     1402         end.
     1403         create tt-marks .
     1404         assign
     1405           tt-marks.ii         = jj + 1
     1406           tt-marks.mark       = buf_marking-lines.mark
     1407           .
     1408           find first ub.marking-attr no-lock where ub.marking-attr.attr-code = "MRC" and ub.marking-attr.mark = buf_marking-lines.mark no-error .
     1409           if available (ub.marking-attr) then tt-marks.mrc = ub.marking-attr.attr-value .
     1410           if buf_marking.mark-parent <> "" then do:
     1411             if tt-marks.mrc <> "" then do:
     1412               tt-marks.datamatrix = buf_marking-lines.mark + "x3R:iv+8005" + string(tt-marks.mrc,"999999") + "93xVn+24010089720" .
     1413             end.
     1414             else do:
     1415               tt-marks.datamatrix = buf_marking-lines.mark + "x3R:iv+8005173000" + "93xVn+24010089720" .
     1416             end.
     1417           end.
     1418           else tt-marks.datamatrix = buf_marking-lines.mark + "8?0DthAAB68eFj3" .
     1419           if buf_marking.unit-ext <> "UNIT" then tt-marks.unit = bf_goods.unit-cli .
     1420           else tt-marks.unit = bf_goods.unit-base .
     1421           tt-marks.mark-name  = GdsName(buf_marking-lines.gds-code) .
     1422         assign
     1423           v-arc = search( "exe/qrgen.exe":U )
     1424           .
     1425         if v-arc = ? then
     1426         do:
     1427           return error "Не найдена программа qrgen.exe" .
     1428         end.
     1429         os-command silent value (v-arc + ' -size=128 -content="' + tt-marks.datamatrix + '"' + ' -filename="c:\temp\qr-code"' + string(tt-marks.ii)) .
     1430         tt-marks.mark-level = "c:\temp\qr-code" + string(tt-marks.ii) + ".png" .
     1431         jj = jj + 1 .
     1432       end.
     1433     end.
     1434   end.
     1435   run get-report-num (output p-report-id).
     1436   v-file-name-rep-htm = session:temp-directory + string(p-report-id) + ".html".
     1437   output stream OutStr-html to value(v-file-name-rep-htm) convert target 'UTF-8'.
     1438   put stream OutStr-html unformatted
     1439     "<!DOCTYPE HTML>" skip
     1440     ' <html>' skip
     1441     '  <head>' skip
     1442     '   <meta charset="utf-8">' skip
     1443     '    <style type="text/css">' skip
     1444     '      table ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     1445     '      .class1 ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     1446     '      tbody td, th ' + chr(123) + ' border-collapse: collapse; border: 1px solid black; height: 14px;' + chr(125) skip
     1447     '   </style>' skip
     1448     '  </head>' skip
     1449     .
     1450   put stream OutStr-html unformatted
     1451     '<body>' skip
     1452     '<TABLE name="1"  fit_to_page="true" orientation="portrait" CELLSPACING="0" BORDER="0">'skip
     1453     '<thead>' skip
     1454     .
     1455   put stream OutStr-html unformatted
     1456     '<tr>' skip
     1457     '<td style="width: 10px;"></td>' skip
     1458     '<td style="width: 30px;"></td>' skip
     1459     '<td style="width: 50px;"></td>' skip
     1460     '<td style="width: 20px;"></td>' skip
     1461     '<td style="width: 20px;"></td>' skip
     1462     '<td style="width: 50px;"></td>' skip
     1463     '</tr>'
     1464     '<TR><TD colspan = "6" style="height: 14px;"></TD></TR>' skip
     1465     '<TR><TD colspan = "6" style="text-align: center;">Печать датаматриксов по излишкам</TD></TR>' skip
     1466     '<TR><TD colspan = "6" style="text-align: center;">№: ' + string(bf_trn-doc.doc-code) + '</TD></TR>' skip
     1467     '</Thead>' skip
     1468     '<tbody>' skip
     1469     .
     1470   put stream OutStr-html unformatted
     1471     '<TR>' skip
     1472     '<TD text_wrap="true" style="text-align: center; font-weight: bold;">№</TD>' skip
     1473     '<TD text_wrap="true" style="text-align: center; font-weight: bold;">Наименование товара</TD>' skip
     1474     '<TD text_wrap="true" style="text-align: center; font-weight: bold;">Датаматрикс</TD>' skip
     1475     '<TD text_wrap="true" style="text-align: center; font-weight: bold;">МРЦ</TD>' skip
     1476     '<TD text_wrap="true" style="text-align: center; font-weight: bold;">Ед.изм.</TD>' skip
     1477     '<TD text_wrap="true" style="text-align: center; font-weight: bold;">QR код</TD>' skip
     1478     '</TR>'skip
     1479     .
     1480   for each tt-marks no-lock by tt-marks.ii:
     1481     put stream OutStr-html unformatted
     1482       '<TR>' skip
     1483       '<TD text_wrap="true" style="text-align: center;">' + string(tt-marks.ii) + '</TD>' skip
     1484       '<TD text_wrap="true" style="text-align: left;">' + string(tt-marks.mark-name) + '</TD>' skip
     1485       '<TD text_wrap="true" style="text-align: center;">' + string (tt-marks.mark) + '</TD>' skip
     1486       '<TD text_wrap="true" style="text-align: center;">' + string (tt-marks.mrc) + '</TD>' skip
     1487       '<TD text_wrap="true" style="text-align: center;">' + string (tt-marks.unit) + '</TD>' skip
     1488       .
     1489     if search(tt-marks.mark-level) <> ? then
     1490     do:
     1491       put stream OutStr-html unformatted
     1492         '<TD text_wrap="true" style="text-align: center;"><img src="' + string(tt-marks.mark-level)+ '" width="130" height="130" alt=""/></TD>' skip
     1493         .
     1494     end.
     1495     else
     1496     do:
     1497       put stream OutStr-html unformatted
     1498         '<TD text_wrap="true" style="text-align: center;"></TD>' skip
     1499         .
     1500     end.
     1501     put stream OutStr-html unformatted
     1502       '</TR>'.
     1503   end.
     1504   put stream OutStr-html unformatted
     1505     '</tbody>' skip
     1506     '</table>' skip
     1507     '</body>' skip
     1508     '</html>' skip
     1509     .
     1510   output stream OutStr-html close.
     1511   run prn-lib-reportviewer-report-name in this-procedure (
     1512     input THIS-PROCEDURE
     1513     ,input v-file-name-rep-htm
     1514     ).
     1515   PROCEDURE get-report-num :
     1516     define output parameter p-report-num as integer no-undo .
     1517     do
     1518       on error undo, return error return-value
     1519       :
     1520       run gbl/getrpnum.p (output p-report-num).
     1521     end.
     1522   END PROCEDURE.
     1523   FUNCTION GdsName RETURNS CHARACTER
     1524     ( input p-gds-code as integer) :
     1525     define variable v-gds-name as character no-undo .
     1526     define buffer buf_goods for ub.goods .
     1527     find first buf_goods no-lock where buf_goods.gds-code = p-gds-code no-error .
     1528     if available (buf_goods) then v-gds-name = buf_goods.gds-name .
     1529     RETURN v-gds-name.
     1530   END FUNCTION.
