     1058   procedure prn-lib-reportviewer :
     1059     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1060     define input parameter p-report-name-html as character no-undo .
     1061     define input parameter p-param        as character no-undo .
     1062     define variable v-excel           as character no-undo init 'TRUE' .
     1063     define variable v-value-character as character no-undo .
     1064     define variable v-value-integer   as character no-undo .
     1065     define variable v-value-date      as date      no-undo .
     1066     define variable v-value-decimal   as decimal   no-undo .
     1067     define variable rep-excel         as logical   no-undo .
     1068     define variable excel-string      as character no-undo .
     1069     define variable v-param-type      as character no-undo .
     1070     define variable v-tth             as handle    no-undo .
     1071     run adm/shattri.p (
     1072       input "get":U
     1073       ,input  ""
     1074       ,input  0
     1075       ,input  'report-glob':U
     1076       ,input  'rep-excel':U
     1077       ,output v-value-character
     1078       ,output v-value-date
     1079       ,output v-value-decimal
     1080       ,output v-value-integer
     1081       ,output rep-excel
     1082       ,output v-param-type
     1083       ,INPUT-OUTPUT table-handle v-tth
     1084       )  .
     1085     if rep-excel then v-excel = "TRUE" .
     1086     else v-excel = "FALSE" .
     1087     if p-param eq ""
     1088     then
     1089        p-param = "EXCEL:" + v-excel.
     1090     else
     1091        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1092     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1093   end procedure.
     1094   function fnc-convert-dot-to-colon returns character
     1095       (input p-data as decimal, input p-accur as character, input p-num as integer) forward.
     1096   function fnc-convert-dot-to-colon returns character
     1097   (input p-data as decimal, input p-accur as character, input p-num as integer):
     1098       define variable result as character no-undo.
     1099       define variable v-str-result as character no-undo.
     1100       if p-data = ? then p-data = 0 .
     1101       p-data = round(p-data, p-num).
     1102       v-str-result = trim(replace(string(p-data, p-accur), ".", ",")).
     1103       return v-str-result.
     1104   END FUNCTION.
     1105   function is-sug returns logical
     1106           (input p-gds-code as integer):
     1107   define variable result as logical no-undo.
     1108   define variable c-value as character no-undo.
     1109   define variable c-type as character no-undo.
     1110   do on error undo, return error:
     1111           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     1112         (input  p-gds-code
     1113         ,input  'fuel-type':U
     1114         ,output c-value
     1115         ,output c-type) no-error.
     1116   end.
     1117   result = logical(c-value = 'lgas':U) no-error.
     1118   return result.
     1119   end function.
     1120   procedure placelib_write-attr:
     1121   define input  parameter p-code     like ub.place-attr.attr-code .
     1122   define input  parameter p-obj-code like ub.place-attr.obj-code .
     1123   define input  parameter p-obj-type like ub.place-attr.obj-type .
     1124   define input  parameter p-pl-code  like ub.place-attr.pl-code .
     1125   define input  parameter p-value    like ub.place-attr.attr-value .
     1126   define output parameter p-ok       as logical.
     1127   define buffer buf_place-attr for ub.place-attr .
     1128     do on error undo, return error return-value :
     1129        p-ok = false.
     1130        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
     1131                                                   and buf_place-attr.obj-code    = p-obj-code
     1132                                                   and buf_place-attr.obj-type    = p-obj-type
     1133                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
     1134        if not available buf_place-attr then do :
     1135           create buf_place-attr.
     1136           assign
     1137             buf_place-attr.attr-code   = p-code
     1138             buf_place-attr.attr-value  = p-value
     1139             buf_place-attr.obj-code    = p-obj-code
     1140             buf_place-attr.obj-type    = p-obj-type
     1141             buf_place-attr.pl-code     = p-pl-code
     1142           .
     1143           p-ok = true.
     1144        end.
     1145        else do:
     1146           buf_place-attr.attr-value  = p-value .
     1147           p-ok = true.
     1148        end.
     1149     end.
     1150   end.
     1151   procedure placelib_get-attr:
     1152   define input  parameter  p-code     like ub.place-attr.attr-code .
     1153   define input  parameter  p-obj-code like ub.place-attr.obj-code .
     1154   define input  parameter  p-obj-type like ub.place-attr.obj-type .
     1155   define input  parameter  p-pl-code  like ub.place-attr.pl-code .
     1156   define output parameter  p-value    like ub.place-attr.attr-value .
     1157   define output parameter  p-ok       as logical.
     1158   define buffer buf_place-attr for ub.place-attr .
     1159     do on error undo, return error return-value :
     1160        p-ok = false.
     1161        find first buf_place-attr no-lock where buf_place-attr.attr-code   = p-code
     1162                                                   and buf_place-attr.obj-code    = p-obj-code
     1163                                                   and buf_place-attr.obj-type    = p-obj-type
     1164                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
     1165        if available buf_place-attr then do :
     1166          p-value = buf_place-attr.attr-value.
     1167          p-ok = true.
     1168        end.
     1169        else do :
     1170          p-ok = false.
     1171        end.
     1172     end.
     1173   end.
     1174   procedure placelib_del-attr:
     1175   define input parameter  p-code     like ub.place-attr.attr-code .
     1176   define input parameter  p-obj-code like ub.place-attr.obj-code .
     1177   define input parameter  p-obj-type like ub.place-attr.obj-type .
     1178   define input parameter  p-pl-code  like ub.place-attr.pl-code .
     1179   define input parameter  p-value    like ub.place-attr.attr-value .
     1180   define output parameter p-ok       as logical.
     1181   define buffer buf_place-attr for ub.place-attr .
     1182     do on error undo, return error return-value :
     1183        p-ok = false.
     1184        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
     1185                                                   and buf_place-attr.obj-code    = p-obj-code
     1186                                                   and buf_place-attr.obj-type    = p-obj-type
     1187                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
     1188        if available buf_place-attr then do :
     1189           delete buf_place-attr.
     1190           p-ok = true.
     1191        end.
     1192     end.
     1193   end.
