     2074         input   gds-zap-prod-type ,
     2075         input   fact-order-1               ,
     2076         output  quantity    ) .
     2077   assign
     2078     ostatok-start [11]   = ostatok-start [11] +  quantity
     2079    b1-ostatok-start [11] =  b1-ostatok-start [11] + quantity
     2080    b2-ostatok-start [11] =  b2-ostatok-start [11] + quantity
     2081    bo-ostatok-start [11] =  bo-ostatok-start [11] + quantity
     2082    .
