     2044                   output  vat_v       ,
     2045                   output  slt_r       ,
     2046                   output  slt_v       ).
     2047   assign
     2048     ostatok-start [1 + 0]   = quantity
     2049    ostatok-start [2 + 0]   = if tprintrubl then coast_r else coast_v
     2050    ostatok-start [3 + 0]   = if tprintrubl then vat_r   else vat_v
     2051    b1-ostatok-start [1 + 0] =  b1-ostatok-start [1 + 0] + ostatok-start [1 + 0]
     2052    b1-ostatok-start [2 + 0] =  b1-ostatok-start [2 + 0] + ostatok-start [2 + 0]
     2053    b1-ostatok-start [3 + 0] =  b1-ostatok-start [3 + 0] + ostatok-start [3 + 0]
     2054    b2-ostatok-start [1 + 0] =  b2-ostatok-start [1 + 0] + ostatok-start [1 + 0]
     2055    b2-ostatok-start [2 + 0] =  b2-ostatok-start [2 + 0] + ostatok-start [2 + 0]
     2056    b2-ostatok-start [3 + 0] =  b2-ostatok-start [3 + 0] + ostatok-start [3 + 0]
     2057    .
     2058    assign
     2059     bi-ostatok-start [1 + 0] =  bi-ostatok-start [1 + 0] + ostatok-start [1 + 0]
     2060     bi-ostatok-start [2 + 0] =  bi-ostatok-start [2 + 0] + ostatok-start [2 + 0]
     2061     bi-ostatok-start [3 + 0] =  bi-ostatok-start [3 + 0] + ostatok-start [3 + 0]
     2062    .
     2063     if p-is-petrol then do:
     2064   quantity = 0 .
