     3030                         temp-gds-list.prod-code = gds-obj.prod-code
     3031                         temp-gds-list.grp-name  = gds-obj.grp-name
     3032                         temp-gds-list.gds-name  = goods.gds-name
     3033                         temp-gds-list.gds-code  = gds-obj.gds-code
     3034                         temp-gds-list.artic     = gds-obj.artic
     3035                       .
     3036                   End.
     3037               End.
     3038     End.
     3039     for each temp-gds-list no-lock
     3040       , First gds-list  where gds-list.gds-code  = temp-gds-list.gds-code no-lock
     3041                                        , First clients   where  clients.obj-code = gds-list.prod-code and
     3042                                                                 clients.obj-type = gds-list.prod-type
     3043         BREAK
     3044   BY (substring(clients.obj-name,1,10) + string(gds-list.prod-code))
     3045   BY (gds-list.grp-name)
     3046       BY gds-list.gds-code :
     3047       run item-goods ( "4" , "gds-list" ) .
     3048         if return-value <> "" then NEXT.
     3049           If Last-of(gds-list.grp-name) Then Do:
     3050           If String(Entry(2,"gds-list.grp-name",".")) = "Grp-name"
     3051             Then  Assign
     3052                     S-bar-code   = " Итого по "
     3053                     Gds-zap-artic = Substring(
     3054                                          B2-name
     3055                                         ,1,16)
     3056                     Gds-zap-gds-name = Substring(
     3057                                          B2-name
     3058                                         ,17,40)
     3059                                   .
     3060             Else  Assign
     3061                     S-bar-code   = ""
     3062                     Gds-zap-artic = "        Итого по "
     3063                     Gds-zap-gds-name =   B2-name
     3064                                   .
     3065               Run Display-b1 In This-procedure .
     3066               Run Clear-b1 In This-procedure .
     3067               Assign Break_Group = True.
     3068           End.
     3069           If Last-of((substring(clients.obj-name,1,10) + string(gds-list.prod-code))) Then Do:
     3070           If String(Entry(2,"(substring(clients.obj-name,1,10) + string(gds-list.prod-code))",".")) = "Grp-name"
     3071             Then  Assign
     3072                 S-bar-code   = "Итого по "
     3073                 Gds-zap-artic = Substring(
     3074                                      B1-name
     3075                                     ,1,16)
     3076                 Gds-zap-gds-name = Substring(
     3077                                      B1-name
     3078                                     ,17,40)
     3079                               .
     3080             Else Assign
     3081                 S-bar-code = ""
     3082                 Gds-zap-artic = If  ("4" = "4"  Or  "4" = "5") Then "Итого по "
     3083                                                                    Else "  Итого по "
     3084                 Gds-zap-gds-name =   B1-name
     3085                 .
     3086             Run Display-b2 In This-procedure .
     3087             Run Clear-b2 In This-procedure .
     3088             Run Clear-b1 In This-procedure .
     3089             Assign  Break_Group1 = True.
     3090           End.
     3091     End.
     3092   End.
     3093            end.
     3094         end case.
     3095   end procedure.
     3096   procedure calcitog :
     3097       run ostatok  in this-procedure (
     3098           input x-store-code  ,
     3099           input x-store-type  , x-tog-shift ,
     3100           input x-date-start - 1 ,
     3101           input date('')      , x-Shift-Start,x-Shift-End,
     3102           input 'crsa':U   ,
     3103           input '##,##':U,
     3104           input xtog-obj ,
     3105           output  quantity1  ,
     3106           output  coast_r1   ,
     3107           output  coast_v1   ,
     3108           output  vat_r1     ,
     3109           output  vat_v1     ,
     3110           output  fact-order-1 ).
     3111       run ostatok  in this-procedure (
     3112           input x-store-code  ,
     3113           input x-store-type  , x-tog-shift ,
     3114           input x-date-start  ,
     3115           input x-date-end    , x-Shift-Start,x-Shift-End,
     3116           input 'crsa':U   ,
     3117           input '##,##':U,
     3118           input xtog-obj ,
     3119           output  quantity1  ,
     3120           output  coast_r1   ,
     3121           output  coast_v1   ,
     3122           output  vat_r1     ,
     3123           output  vat_v1     ,
     3124           output  fact-order-2 ).
     3125             quantity1  = 0.
     3126             coast_r1   = 0.
     3127             coast_v1   = 0.
     3128             vat_r1     = 0.
     3129             vat_v1     = 0.
     3130   end procedure.
     3131   procedure display-str1  :
     3132   define variable ll as int no-undo.
     3133     assign
     3134       num#str# = num#str# + 1
     3135       num#col# = 0
     3136       v-gds-num = v-gds-num + 1
     3137     .
     3138     if use-column[28] then do: assign num#col#  = num#col# + 1 .   run macr_excel_dec ( v-gds-num , num#str# , num#col#   ) .   end.
     3139     if use-column[1]  then do: assign num#col#  = num#col# + 1 .   run macr_excel_dec ( gds-zap-b-code , num#str# , num#col#   ) .   end.
     3140     if use-column[2]  then do: assign num#col#  = num#col# + 1 .   run macr_excel_char ( gds-zap-artic, num#str# , num#col#   )   .   end.
     3141     if use-column[3]  then do: assign num#col#  = num#col# + 1 .   run macr_excel_char ( if xlongName then gds-zap-gds-long-name else gds-zap-gds-name, num#str# , num#col#   ) .  end.
     3142     if use-column[4]  then do: assign num#col#  = num#col# + 1 .   run macr_excel_char ( gds-zap-unit-base, num#str# , num#col#   ) . end.
     3143     if use-column[5]  then do: assign num#col#  = num#col# + 1 .   run macr_excel_char ( gds-zap-type, num#str# , num#col#   ) .      end.
     3144   if use-column[21] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(oborot-disc [1],2 ), num#str# , num#col#   ).     end.
     3145   if use-column[23] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(oborot-eff  [1],2 ), num#str# , num#col#   ).     end.
     3146   if use-column[24] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(oborot-prc  [1],2 ), num#str# , num#col#   ).     end.
     3147   def var l-nk as integer no-undo .
     3148     Assign
     3149       LL = 0
     3150       KK = 1
     3151     .
     3152     if xShowCost      Then DO: KK = KK + 1. End.
     3153     if xShowCostNDS   Then DO: KK = KK + 1. End.
     3154     if xShowCrsa      Then DO: KK = KK + 1. End.
     3155     if xShowCrsaNds   Then DO: KK = KK + 1. End.
     3156     if xShowSale      Then DO: KK = KK + 1. End.
     3157     if xShowSaleNds   Then DO: KK = KK + 1. End.
     3158     if xShowSaleslt   Then DO: KK = KK + 1. End.
     3159     if xShowmediator  Then DO: KK = KK + 1. End.
     3160     if x-tog-wt       then do: KK = KK + 1. End.
     3161     if x-tog-ms       then do: KK = KK + 1. End.
     3162     if xDens          then do: KK = KK + 1. End.
     3163     repeat i = 1 to 13 :
     3164       if i = 7 then next.
     3165       if NOT xShowCost      and i = 2   Then  next.
     3166       if NOT xShowCostNDS   and i = 3   Then  next.
     3167       if NOT xShowCrsa      and i = 5   Then  next.
     3168       if NOT xShowCrsaNds   and i = 6   Then  next.
     3169       if NOT xShowSale      and i = 8   Then  next.
     3170       if NOT xShowSaleNds   and i = 9   Then  next.
     3171       if NOT xShowSaleSlt   and i = 10  Then  next.
     3172       if NOT xShowmediator  and i = 4   Then  next.
     3173       if not x-tog-wt       and i = 11  then  next.
     3174       if not x-tog-ms       and i = 12  then  next.
     3175       if not xDens          and i = 13  then  next.
     3176       assign
     3177         LL = LL + 1
     3178         l-nk = mp-1
     3179       .
     3180     if x-vat or i <> 2  then do:
     3181     if use-column[6]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , ostatok-start                          [i] ,  i). end.
     3182     if use-column[7]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-ie          [i] ,  i). end.
     3183     if use-column[8]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-iv          [i] ,  i). end.
     3184     if use-column[9]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-im           [i] ,  i). end.
     3185     if use-column[10] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-ee          [i] ,  i). end.
     3186     if use-column[11] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-ev          [i] ,  i). end.
     3187     if use-column[12] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-em           [i] ,  i). end.
     3188     if use-column[13] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-we          [i] ,  i). end.
     3189     if use-column[14] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-es     [i] ,  i). end.
     3190     if use-column[15] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-rs [i] ,  i). end.
     3191     if use-column[16] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-re      [i] ,  i). end.
     3192     if use-column[17] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-ep       [i] ,  i). end.
     3193     if use-column[18] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-rv      [i] ,  i). end.
     3194     if use-column[19] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-vt                [i] ,  i). end.
     3195     if use-column[20] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-ot           [i] ,  i). end.
     3196     if use-column[22] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , ostatok-end                            [i] ,  i). end.
     3197     if use-column[25] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-ap [i] ,  i). end.
     3198     if use-column[26] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-pc [i] ,  i). end.
     3199     if i = 13 then do:
     3200       if "" = "b1-" or "" = "b2-" or "" = "bi-" or "" = "bo-" then do:
     3201          if use-column[27] then do: l-nk = l-nk + 1 .  run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , 0 ,  i). end.
     3202       end.
     3203       else do:
     3204         if use-column[27] then do: l-nk = l-nk + 1 .  run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , ( if ABS(oborot-ee         [1] +
     3205                                                                                                                                       oborot-re     [1] +
     3206                                                                                                                                       oborot-es    [1] +
     3207                                                                                                                                       oborot-rs[1] ) <> 0
     3208                                                                                                                               then
     3209                                                                                                                                   ABS(oborot-ee         [11] +
     3210                                                                                                                                       oborot-re     [11] +
     3211                                                                                                                                       oborot-es    [11] +
     3212                                                                                                                                       oborot-rs[11] )
     3213                                                                                                                                   /
     3214                                                                                                                                   ABS(oborot-ee         [1] +
     3215                                                                                                                                       oborot-re     [1] +
     3216                                                                                                                                       oborot-es    [1] +
     3217                                                                                                                                       oborot-rs[1] )
     3218                                                                                                                               else 0 )
     3219         ,  i). end.
     3220       end.
     3221     end.
     3222     else do:
     3223     if use-column[27] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , (oborot-ee         [i] +
     3224                                                                                                                           oborot-re     [i] +
     3225                                                                                                                           oborot-es    [i] +
     3226                                                                                                                           oborot-rs[i] )
     3227     ,  i). end.
     3228     end.
     3229     end.
     3230     if x-vat = false  and i = 2 then do:
     3231     if use-column[6]  then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( ostatok-start                          [i] -  ostatok-start                          [3] ),  i). end.
     3232     if use-column[7]  then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( oborot-ie          [i] -  oborot-ie          [3] ),  i). end.
     3233     if use-column[8]  then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( oborot-iv          [i] -  oborot-iv          [3] ),  i). end.
     3234     if use-column[9]  then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( oborot-im           [i] -  oborot-im           [3] ),  i). end.
     3235     if use-column[10] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( oborot-ee          [i] -  oborot-ee          [3] ),  i). end.
     3236     if use-column[11] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( oborot-ev          [i] -  oborot-ev          [3] ),  i). end.
     3237     if use-column[12] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( oborot-em           [i] -  oborot-em           [3] ),  i). end.
     3238     if use-column[13] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( oborot-we          [i] -  oborot-we          [3] ),  i). end.
     3239     if use-column[14] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( oborot-es     [i] -  oborot-es     [3] ),  i). end.
     3240     if use-column[15] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( oborot-rs [i] -  oborot-rs [3] ),  i). end.
     3241     if use-column[16] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( oborot-re      [i] -  oborot-re      [3] ),  i). end.
     3242     if use-column[17] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( oborot-ep       [i] -  oborot-ep       [3] ),  i). end.
     3243     if use-column[18] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( oborot-rv      [i] -  oborot-rv      [3] ),  i). end.
     3244     if use-column[19] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( oborot-vt                [i] -  oborot-vt                [3] ),  i). end.
     3245     if use-column[20] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( oborot-ot           [i] -  oborot-ot           [3] ),  i). end.
     3246     if use-column[22] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( ostatok-end                            [i] -  ostatok-end                            [3] ),  i). end.
     3247     if use-column[25] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( oborot-ap [i] -  oborot-ap[3] ),  i). end.
     3248     if use-column[26] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( oborot-pc [i] -  oborot-pc[3] ),  i). end.
     3249     if i = 13 then do :
     3250       if use-column[27] then do: l-nk = l-nk + 1 . run ex-display in this-procedure (mp-1 + ll + (kk * (l-nk - mp))  , 0  , i ). end.
     3251     end.
     3252     else do:
     3253       if use-column[27] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,
     3254       (                                                                                      (oborot-ee         [i] +
     3255                                                                                               oborot-re     [i] +
     3256                                                                                               oborot-es    [i] +
     3257                                                                                               oborot-rs[i]) -
     3258                                                                                             (oborot-ee         [3] +
     3259                                                                                               oborot-re     [3] +
     3260                                                                                               oborot-es    [3] +
     3261                                                                                               oborot-rs[3] ) ) , i ). end.
     3262     end.
     3263     end.
     3264     end.
     3265    run new-tmp-page .
     3266   end procedure.
     3267   procedure display-bi  :
     3268   define variable ll as int no-undo.
     3269   define variable kk as int no-undo.
     3270     num#col#  = 0 .
     3271     if use-column[28] then assign num#col#  = num#col#  + 1 .
     3272     if use-column[1] then  assign num#col#  = num#col#  + 1 .
     3273     if use-column[2] then  assign num#col#  = num#col#  + 1 .
     3274     if use-column[3] then  assign num#col#  = num#col#  + 1 .
     3275     if use-column[4] then  assign num#col#  = num#col#  + 1 .
     3276     if use-column[5] then  assign num#col#  = num#col#  + 1 .
     3277     run macr_cell_format
     3278                                 ( 10    ,
     3279                                   true  ,
     3280                                   false ,
     3281                                   ?    ,
     3282                                   num#str# ,
     3283                                   1 ,
     3284                                   num#str# ,
     3285                                   (mp + ll + (kk * (27 - 8)))
     3286                                   ) .
     3287   if use-column[21] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(bi-oborot-disc [1],2 ), num#str# , num#col#   ).     end.
     3288   if use-column[23] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(bi-oborot-eff  [1],2 ), num#str# , num#col#   ).     end.
     3289   if use-column[24] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(bi-oborot-prc  [1],2 ), num#str# , num#col#   ).     end.
     3290   def var l-nk as integer no-undo .
     3291     Assign
     3292       LL = 0
     3293       KK = 1
     3294     .
     3295     if xShowCost      Then DO: KK = KK + 1. End.
     3296     if xShowCostNDS   Then DO: KK = KK + 1. End.
     3297     if xShowCrsa      Then DO: KK = KK + 1. End.
     3298     if xShowCrsaNds   Then DO: KK = KK + 1. End.
     3299     if xShowSale      Then DO: KK = KK + 1. End.
     3300     if xShowSaleNds   Then DO: KK = KK + 1. End.
     3301     if xShowSaleslt   Then DO: KK = KK + 1. End.
     3302     if xShowmediator  Then DO: KK = KK + 1. End.
     3303     if x-tog-wt       then do: KK = KK + 1. End.
     3304     if x-tog-ms       then do: KK = KK + 1. End.
     3305     if xDens          then do: KK = KK + 1. End.
     3306     repeat i = 1 to 13 :
     3307       if i = 7 then next.
     3308       if NOT xShowCost      and i = 2   Then  next.
     3309       if NOT xShowCostNDS   and i = 3   Then  next.
     3310       if NOT xShowCrsa      and i = 5   Then  next.
     3311       if NOT xShowCrsaNds   and i = 6   Then  next.
     3312       if NOT xShowSale      and i = 8   Then  next.
     3313       if NOT xShowSaleNds   and i = 9   Then  next.
     3314       if NOT xShowSaleSlt   and i = 10  Then  next.
     3315       if NOT xShowmediator  and i = 4   Then  next.
     3316       if not x-tog-wt       and i = 11  then  next.
     3317       if not x-tog-ms       and i = 12  then  next.
     3318       if not xDens          and i = 13  then  next.
     3319       assign
     3320         LL = LL + 1
     3321         l-nk = mp-1
     3322       .
     3323     if x-vat or i <> 2  then do:
     3324     if use-column[6]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bi-ostatok-start                          [i] ,  i). end.
