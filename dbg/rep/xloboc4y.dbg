     3981   procedure ob-line  :
     3982   define input  parameter x-store-code     like ub.clients.obj-code     no-undo.
     3983   define input  parameter x-store-type     like ub.clients.obj-type     no-undo.
     3984   define input  parameter x-artic          like ub.ot-line.artic        no-undo.
     3985   define input  parameter x-prod-code      like ub.ot-line.prod-code    no-undo.
     3986   define input  parameter x-prod-type      like ub.ot-line.prod-type    no-undo.
     3987   define input  parameter x-fact-order-1   like ub.ot-line.fact-order   no-undo.
     3988   define input  parameter x-fact-order-2   like ub.ot-line.fact-order   no-undo.
     3989   define input  parameter x-sum-type       like ub.ot-line.sum-type     no-undo.
     3990   define input  parameter x-cat-id         like ub.ot-line.cat-id       no-undo.
     3991   define input  parameter x-ext-doc-type   like ub.ot-line.ext-doc-type no-undo.
     3992   define input  parameter xtog-obj           as log no-undo.
     3993   define variable  quantity#    like ub.ot-line.fact-qnty   no-undo.
     3994   define variable  coast_r#     like ub.ot-line.sum-rubl    no-undo.
     3995   define variable  coast_v#     like ub.ot-line.sum-rubl    no-undo.
     3996   define variable  vat_r#       like ub.ot-line.sum-rubl    no-undo.
     3997   define variable  vat_v#       like ub.ot-line.sum-rubl    no-undo.
     3998   define variable  slt_r#       like ub.ot-line.sum-rubl    no-undo.
     3999   define variable  slt_v#       like ub.ot-line.sum-rubl    no-undo.
     4000   define variable  v-summa  as decimal extent 4 no-undo .
     4001   define variable  tt#          as int no-undo.
     4002   define variable v-ii as integer no-undo .
     4003   define variable slt  as decimal no-undo .
     4004   define variable disc  as decimal no-undo .
     4005   define variable xi as integer no-undo .
     4006   define variable v-tt as integer no-undo .
     4007    if (x-sum-type = 'cost':U  or x-sum-type = 'cssr':U) then assign tt# = 0 v-tt = 0.
     4008       else
     4009       if (x-sum-type = 'crsa':U  or x-sum-type = 'cgsr':U) then assign tt# = 3  v-tt = 100.
     4010       else
     4011       assign tt# = 6  v-tt = 200.
     4012     if long-p = false then do :
     4013     for each obj-list no-lock:
     4014      if  xtog-obj then
     4015          if   not(x-store-type     = obj-list.obj-type
     4016               and x-store-code    = obj-list.obj-code ) then next.
     4017           for each ub.ot-line where
     4018                     ub.ot-line.artic         = x-artic
     4019               and   ub.ot-line.prod-code    = x-prod-code
     4020               and   ub.ot-line.prod-type    = x-prod-type
     4021               and   ub.ot-line.fact-order   <= x-fact-order-2
     4022               and   ub.ot-line.fact-order   >= x-fact-order-1
     4023               and   ub.ot-line.obj-code     = obj-list.obj-code
     4024               and   ub.ot-line.obj-type     = obj-list.obj-type
     4025               and   ub.ot-line.sum-type     = x-sum-type
     4026               no-lock :
     4027               case ub.ot-line.ext-doc-type:
     4028     WHEN 'ie':U THEN DO:
     4029       ASSIGN oborot-ie[1 + tt#]   = oborot-ie[1 + tt#]   +  ub.ot-line.fact-qnty
     4030             oborot-ie[2 + tt#]   = oborot-ie[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     4031             oborot-ie[3 + tt#]   = oborot-ie[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     4032         if tt# = 6 Then   assign
     4033             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     4034             oborot-ie[10]   = oborot-ie[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     4035             End.
     4036     WHEN 'ee':U THEN DO:
     4037       ASSIGN oborot-ee[1 + tt#]   = oborot-ee[1 + tt#]   +  ub.ot-line.fact-qnty
     4038             oborot-ee[2 + tt#]   = oborot-ee[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     4039             oborot-ee[3 + tt#]   = oborot-ee[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     4040         if tt# = 6 Then   assign
     4041             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     4042             oborot-ee[10]   = oborot-ee[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     4043             End.
     4044     WHEN 'ep':U THEN DO:
     4045       ASSIGN oborot-ep[1 + tt#]   = oborot-ep[1 + tt#]   +  ub.ot-line.fact-qnty
     4046             oborot-ep[2 + tt#]   = oborot-ep[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     4047             oborot-ep[3 + tt#]   = oborot-ep[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     4048         if tt# = 6 Then   assign
     4049             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     4050             oborot-ep[10]   = oborot-ep[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     4051             End.
     4052     WHEN 'es':U THEN DO:
     4053       ASSIGN oborot-es[1 + tt#]   = oborot-es[1 + tt#]   +  ub.ot-line.fact-qnty
     4054             oborot-es[2 + tt#]   = oborot-es[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     4055             oborot-es[3 + tt#]   = oborot-es[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     4056         if tt# = 6 Then   assign
     4057             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     4058             oborot-es[10]   = oborot-es[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     4059             End.
