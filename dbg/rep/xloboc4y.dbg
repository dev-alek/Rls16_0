     3867       (                                                                                      (b2-oborot-ee         [i] +
     3868                                                                                               b2-oborot-re     [i] +
     3869                                                                                               b2-oborot-es    [i] +
     3870                                                                                               b2-oborot-rs[i]) -
     3871                                                                                             (b2-oborot-ee         [3] +
     3872                                                                                               b2-oborot-re     [3] +
     3873                                                                                               b2-oborot-es    [3] +
     3874                                                                                               b2-oborot-rs[3] ) ) , i ). end.
