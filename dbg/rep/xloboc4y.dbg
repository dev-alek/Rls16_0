     5129   procedure ex-display :
     5130   define input parameter par-1 as int no-undo.
     5131   define input parameter par-2 like  ostatok-start[1] no-undo.
     5132   define input parameter par-i as int no-undo.
     5133     assign num#col#  = par-1.
     5134     if par-i = 13 then do:
     5135       run macr_excel_dec ( round (par-2 ,4)  , num#str# , num#col#   ).
     5136     end.
     5137     else do:
     5138       if par-i = 1 or par-i = 11 or par-i = 12 then do :
     5139         run macr_excel_dec ( round (par-2 ,3)  , num#str# , num#col#   ).
     5140       end.
     5141       else do :
     5142         run macr_excel_dec ( round (par-2 ,2)  , num#str# , num#col#   ).
     5143       end.
     5144     end.
     5145   end procedure.
     5146   procedure u-line:
     5147   end procedure.
     5148   procedure p-line:
     5149   end procedure.
     5150   procedure make-col :
     5151    define variable l#1 as int  no-undo.
     5152    define variable l#2 as int  no-undo.
     5153    define variable l as int  no-undo.
     5154     assign
     5155       nk = 0
     5156       kk = 0
     5157     .
     5158     if xshowcost     then do: kk = kk + 1. end.
     5159     if xshowcostnds  then do: kk = kk + 1. end.
     5160     if xshowcrsa     then do: kk = kk + 1. end.
     5161     if xshowcrsands  then do: kk = kk + 1. end.
     5162     if xshowsale     then do: kk = kk + 1. end.
     5163     if xshowsalends  then do: kk = kk + 1. end.
     5164     if xshowsaleslt  then do: kk = kk + 1. end.
     5165     if xshowmediator then do: kk = kk + 1. end.
     5166     if x-tog-wt      then do: kk = kk + 1. end.
     5167     if x-tog-ms      then do: kk = kk + 1. end.
     5168     if xDens         then do: kk = kk + 1. end.
     5169    assign
     5170     num#str# = num#str# + 1
     5171     num#col#  = 0
     5172    .
     5173    if use-column[28] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format( "№ "              , num#str# , num#col# ) . run macr_cell_size (10, ? , num#str# , num#col# , num#str# , num#col# ). end.
     5174    if use-column[1]  then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format( "Код "            , num#str# , num#col# ) . run macr_cell_size (10, ? , num#str# , num#col# , num#str# , num#col# ). end.
     5175    if use-column[2]  then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format( "Артикул"         , num#str# , num#col# ) . run macr_cell_size (16, ? , num#str# , num#col# , num#str# , num#col# ). end.
     5176    if use-column[3]  then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format( "Название товара" , num#str# , num#col# ) . run macr_cell_size (60, ? , num#str# , num#col# , num#str# , num#col# ). end.
     5177    if use-column[4]  then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format( "Ед.изм "         , num#str# , num#col# ) . run macr_cell_size (7 , ? , num#str# , num#col# , num#str# , num#col# ). end.
     5178    if use-column[5]  then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format( "т/у"             , num#str# , num#col# ) . run macr_cell_size (4 , ? , num#str# , num#col# , num#str# , num#col# ). end.
     5179    if use-column[21] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format( "Скидка"          , num#str# , num#col# ) . run macr_cell_size (15, ? , num#str# , num#col# , num#str# , num#col# ). end.
     5180    if use-column[23] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format( "Эффективность"   , num#str# , num#col# ) . run macr_cell_size (16, ? , num#str# , num#col# , num#str# , num#col# ). end.
     5181    if use-column[24] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format( "% наценки"       , num#str# , num#col# ) . run macr_cell_size (13, ? , num#str# , num#col# , num#str# , num#col# ). end.
     5182       mp = num#col#  + 1.
     5183       mp-1 = num#col#  .
     5184    if use-column[6]  then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Остаток на начало "               , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5185    if use-column[7]  then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот приход внешний"            , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5186    if use-column[8]  then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот приход перемещение"        , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5187    if use-column[9]  then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот приход производство"       , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5188    if use-column[10] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот расход внешний"            , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5189    if use-column[11] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот расход перемещение"        , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5190    if use-column[12] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот расход производство"       , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5191    if use-column[13] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот  списание"                 , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5192    if use-column[14] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот касса продажа "            , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5193    if use-column[15] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот касса возврат"             , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5194    if use-column[16] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот возврат внешний"           , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5195    if use-column[17] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот возврат поставщику"        , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5196    if use-column[18] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот возврат перемещение"       , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5197    if use-column[19] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот  инвентаризация"           , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5198    if use-column[20] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот  переоценка"               , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5199    if use-column[22] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Остаток на конец "                , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5200    if use-column[25] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format('коррекция учетных цен':U       , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5201    if use-column[26] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format('смена типа приобретения':U       , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5202    if use-column[27] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Расход-Возврат"                   , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5203       run macr_cell_size (16, ? , num#str# , mp, num#str# , (num#col#  + (kk * (num#col#  - mp)) + kk) ).
     5204      num#str# = num#str# + 1.
     5205      repeat l#1 = mp to nk :
     5206            l#2 = 0.
     5207                num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2  . run macr_excel_char_with_format( "количество"  , num#str# , num#col#  ) .
     5208            if xshowcost    then do:
     5209                l#2 = l#2 + 1.
     5210                num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2  . run macr_excel_char_with_format( "учетн. сумма"  , num#str# , num#col#  ) .
     5211                end.
     5212            if xshowcostnds then do:
     5213                l#2 = l#2 + 1.
     5214                num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2  . run macr_excel_char_with_format( "учетн.НДС"  , num#str# , num#col#  ) .
     5215               end.
     5216            if xshowmediator then do:
     5217               l#2 = l#2 + 1.
     5218               num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2  . run macr_excel_char_with_format( "цены поср."  , num#str# , num#col#  ) .
     5219               end.
     5220            if xshowcrsa    then do:
     5221               l#2 = l#2 + 1.
     5222               num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2  . run macr_excel_char_with_format( "продаж. сумма"  , num#str# , num#col#  ) .
     5223               end.
     5224            if xshowcrsands then do:
     5225               l#2 = l#2 + 1.
     5226               num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2  . run macr_excel_char_with_format( "продаж.НДС"  , num#str# , num#col#  ) .
     5227               end.
     5228             if xshowsale    then do:
     5229               l#2 = l#2 + 1.
     5230               num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2  . run macr_excel_char_with_format( "док. сумма"  , num#str# , num#col#  ) .
     5231               end.
     5232            if xshowsalends then do:
     5233               l#2 = l#2 + 1.
     5234               num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2  . run macr_excel_char_with_format( "док.НДС"  , num#str# , num#col#  ) .
     5235               end.
     5236            if xshowsaleslt then do:
     5237               l#2 = l#2 + 1.
     5238               num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2  . run macr_excel_char_with_format( "док.НсП"  , num#str# , num#col#  ) .
     5239            end.
     5240            if x-tog-wt then do:
     5241             assign
     5242               l#2 = l#2 + 1
     5243               num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2
     5244             .
     5245             run macr_excel_char_with_format( "вес"  , num#str# , num#col#  ) .
     5246            end.
     5247            if x-tog-ms then do:
     5248             assign
     5249               l#2 = l#2 + 1
     5250               num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2
     5251             .
     5252             run macr_excel_char_with_format( "объем"  , num#str# , num#col#  ) .
     5253            end.
     5254            if xDens then do:
     5255             assign
     5256               l#2 = l#2 + 1
     5257               num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2
     5258             .
     5259             run macr_excel_char_with_format( "плотность"  , num#str# , num#col#  ) .
     5260            end.
     5261        end.
     5262   end procedure .
     5263   procedure make-tt-ed :
     5264   create temp#sum-type.
     5265   assign temp#sum-type.sum-type = 'csdt':U + 'ie':U temp#sum-type.xi = 1 . create temp#sum-type.
     5266   assign temp#sum-type.sum-type = 'csdt':U + 'ee':U temp#sum-type.xi = 2 . create temp#sum-type.
     5267   assign temp#sum-type.sum-type = 'csdt':U + 'ep':U temp#sum-type.xi = 3 . create temp#sum-type.
     5268   assign temp#sum-type.sum-type = 'csdt':U + 'es':U temp#sum-type.xi = 4 . create temp#sum-type.
     5269   assign temp#sum-type.sum-type = 'csdt':U + 're':U temp#sum-type.xi = 5 . create temp#sum-type.
     5270   assign temp#sum-type.sum-type = 'csdt':U + 'rs':U temp#sum-type.xi = 6 . create temp#sum-type.
     5271   assign temp#sum-type.sum-type = 'csdt':U + 'we':U temp#sum-type.xi = 7 . create temp#sum-type.
     5272   assign temp#sum-type.sum-type = 'csdt':U + 'vt':U temp#sum-type.xi = 8 . create temp#sum-type.
     5273   assign temp#sum-type.sum-type = 'csdt':U + 'iv':U temp#sum-type.xi = 9 . create temp#sum-type.
     5274   assign temp#sum-type.sum-type = 'csdt':U + 'ev':U temp#sum-type.xi = 10. create temp#sum-type.
     5275   assign temp#sum-type.sum-type = 'csdt':U + 'rv':U temp#sum-type.xi = 11. create temp#sum-type.
     5276   assign temp#sum-type.sum-type = 'csdt':U + 'em':U temp#sum-type.xi = 12 . create temp#sum-type.
     5277   assign temp#sum-type.sum-type = 'csdt':U + 'wm':U temp#sum-type.xi = 12 . create temp#sum-type.
     5278   assign temp#sum-type.sum-type = 'csdt':U + 'im':U temp#sum-type.xi = 13 . create temp#sum-type.
     5279   assign temp#sum-type.sum-type = 'csdt':U + 'ot':U temp#sum-type.xi = 14 .
     5280   create temp#sum-type.
     5281   assign temp#sum-type.sum-type = 'csdt':U + 'ap':U temp#sum-type.xi = 15 . create temp#sum-type.
     5282   assign temp#sum-type.sum-type = 'csdt':U + 'pc':U temp#sum-type.xi = 16 .
     5283   create temp#sum-type.
     5284   assign temp#sum-type.sum-type = 'cgdt':U + 'ie':U temp#sum-type.xi = 101 . create temp#sum-type.
     5285   assign temp#sum-type.sum-type = 'cgdt':U + 'ee':U temp#sum-type.xi = 102 . create temp#sum-type.
     5286   assign temp#sum-type.sum-type = 'cgdt':U + 'ep':U temp#sum-type.xi = 103 . create temp#sum-type.
     5287   assign temp#sum-type.sum-type = 'cgdt':U + 'es':U temp#sum-type.xi = 104 . create temp#sum-type.
     5288   assign temp#sum-type.sum-type = 'cgdt':U + 're':U temp#sum-type.xi = 105 . create temp#sum-type.
     5289   assign temp#sum-type.sum-type = 'cgdt':U + 'rs':U temp#sum-type.xi = 106 . create temp#sum-type.
     5290   assign temp#sum-type.sum-type = 'cgdt':U + 'we':U temp#sum-type.xi = 107 . create temp#sum-type.
     5291   assign temp#sum-type.sum-type = 'cgdt':U + 'vt':U temp#sum-type.xi = 108 . create temp#sum-type.
     5292   assign temp#sum-type.sum-type = 'cgdt':U + 'iv':U temp#sum-type.xi = 109 . create temp#sum-type.
     5293   assign temp#sum-type.sum-type = 'cgdt':U + 'ev':U temp#sum-type.xi = 110 . create temp#sum-type.
     5294   assign temp#sum-type.sum-type = 'cgdt':U + 'rv':U temp#sum-type.xi = 111 . create temp#sum-type.
     5295   assign temp#sum-type.sum-type = 'cgdt':U + 'em':U temp#sum-type.xi = 112 . create temp#sum-type.
     5296   assign temp#sum-type.sum-type = 'cgdt':U + 'wm':U temp#sum-type.xi = 112 . create temp#sum-type.
     5297   assign temp#sum-type.sum-type = 'cgdt':U + 'im':U temp#sum-type.xi = 113 . create temp#sum-type.
     5298   assign temp#sum-type.sum-type = 'cgdt':U + 'ot':U temp#sum-type.xi = 114 .
     5299   create temp#sum-type.
     5300   assign temp#sum-type.sum-type = 'cgdt':U + 'ap':U temp#sum-type.xi = 115 . create temp#sum-type.
     5301   assign temp#sum-type.sum-type = 'cgdt':U + 'pc':U temp#sum-type.xi = 116 .
     5302   create temp#sum-type.
     5303   assign temp#sum-type.sum-type = 'sadt':U + 'ie':U temp#sum-type.xi = 201 . create temp#sum-type.
     5304   assign temp#sum-type.sum-type = 'sadt':U + 'ee':U temp#sum-type.xi = 202 . create temp#sum-type.
     5305   assign temp#sum-type.sum-type = 'sadt':U + 'ep':U temp#sum-type.xi = 203 . create temp#sum-type.
     5306   assign temp#sum-type.sum-type = 'sadt':U + 'es':U temp#sum-type.xi = 204 . create temp#sum-type.
     5307   assign temp#sum-type.sum-type = 'sadt':U + 're':U temp#sum-type.xi = 205 . create temp#sum-type.
     5308   assign temp#sum-type.sum-type = 'sadt':U + 'rs':U temp#sum-type.xi = 206 . create temp#sum-type.
     5309   assign temp#sum-type.sum-type = 'sadt':U + 'we':U temp#sum-type.xi = 207 . create temp#sum-type.
     5310   assign temp#sum-type.sum-type = 'sadt':U + 'vt':U temp#sum-type.xi = 208 . create temp#sum-type.
     5311   assign temp#sum-type.sum-type = 'sadt':U + 'iv':U temp#sum-type.xi = 209 . create temp#sum-type.
     5312   assign temp#sum-type.sum-type = 'sadt':U + 'ev':U temp#sum-type.xi = 210 . create temp#sum-type.
     5313   assign temp#sum-type.sum-type = 'sadt':U + 'rv':U temp#sum-type.xi = 211 . create temp#sum-type.
     5314   assign temp#sum-type.sum-type = 'sadt':U + 'em':U temp#sum-type.xi = 212 . create temp#sum-type.
     5315   assign temp#sum-type.sum-type = 'sadt':U + 'wm':U temp#sum-type.xi = 212 . create temp#sum-type.
     5316   assign temp#sum-type.sum-type = 'sadt':U + 'im':U temp#sum-type.xi = 213 . create temp#sum-type.
     5317   assign temp#sum-type.sum-type = 'sadt':U + 'ot':U temp#sum-type.xi = 214 .
     5318   create temp#sum-type.
     5319   assign temp#sum-type.sum-type = 'sadt':U + 'ap':U temp#sum-type.xi = 215 . create temp#sum-type.
     5320   assign temp#sum-type.sum-type = 'sadt':U + 'pc':U temp#sum-type.xi = 216 .
     5321   end procedure.
     5322   procedure new-tmp-page :
     5323    do
     5324    on error undo, return error return-value
     5325    :
     5326       if   num#str#  >=  63000  then do:
     5327           output stream macr_excel  close .
     5328           run paramls-write in this-procedure
     5329             (input "file"
     5330             ,input string(v-ind)
     5331             ,input v-file-name
     5332             ) .
     5333           run gbl/_tmpfile.p ("wb", ".txt", output v-file-name) .
     5334           output stream  macr_excel to value(v-file-name) .
     5335           v-ind = v-ind + 1 .
     5336           num#str# = 0 .
     5337   define variable old-s as integer no-undo .
     5338   define variable old-s2 as integer no-undo .
     5339       assign
     5340       old-s =   num#str#
     5341       .
     5342       run make-col .
     5343       assign
     5344         old-s2 =   num#str#
     5345       .
     5346      num#str# = old-s + 1  .
     5347      run proc-print-header .
     5348      num#str# = old-s2     .
     5349       end.
     5350    end.
     5351   end procedure.
     5352   procedure pp :
     5353   define input parameter ll as integer no-undo .
     5354   define input parameter uu as integer no-undo .
     5355   define input parameter ff as character no-undo .
     5356   End procedure.
     5357   procedure find-last-prise-med :
     5358   define input parameter p-artic     like ub.goods.artic no-undo .
     5359   define input parameter p-prod-type like ub.goods.prod-type no-undo .
     5360   define input parameter p-prod-code like ub.goods.prod-code no-undo .
     5361   define input parameter p-host-code like ub.gds-obj.host-code no-undo .
     5362   define output parameter  p-price   like ub.gds-obj.last-base no-undo .
     5363   define buffer p-gds-obj   for  ub.gds-obj .
     5364   define buffer buf_trn-doc for  ub.trn-doc .
     5365   define variable v-fact-order as decimal no-undo .
     5366   p-price = 0 .
     5367     define variable v-in-date as date      no-undo .
     5368     define variable fl as logical no-undo .
     5369     fl = yes.
     5370     v-fact-order = 0 .
     5371     for each tt-obj-list no-lock break by tt-obj-list.obj-type by tt-obj-list.obj-code
     5372     :
     5373       find first p-gds-obj no-lock
     5374         where p-gds-obj.artic     = p-artic         and
     5375                 p-gds-obj.prod-type = p-prod-type     and
     5376                 p-gds-obj.prod-code = p-prod-code     and
     5377                 p-gds-obj.obj-code  = tt-obj-list.obj-code and
     5378                 p-gds-obj.obj-type  = tt-obj-list.obj-type
     5379         no-error .
     5380       if available p-gds-obj then do:
     5381       if p-gds-obj.in-date = ?  then next .
     5382       if fl = yes then do:
     5383         assign
     5384           v-in-date = p-gds-obj.in-date
     5385           p-price   =  if tPrintRubl then  p-gds-obj.last-rubl else  p-gds-obj.last-base
     5386           fl = no
     5387       .
     5388        find first buf_trn-doc no-lock  where buf_trn-doc.doc-code = p-gds-obj.in-code no-error  .
     5389        if available buf_trn-doc  then  v-fact-order = buf_trn-doc.fact-order .
     5390       end.
     5391         if p-gds-obj.in-date >= v-in-date   then do:
     5392            if p-gds-obj.in-date = v-in-date then do:
     5393               find first buf_trn-doc no-lock  where buf_trn-doc.doc-code = p-gds-obj.in-code no-error .
     5394               if available buf_trn-doc  then
     5395                   if buf_trn-doc.fact-order >  v-fact-order   then do:
     5396                     assign
     5397                       v-fact-order = buf_trn-doc.fact-order
     5398                       p-price   =  if tPrintRubl then  p-gds-obj.last-rubl else  p-gds-obj.last-base
     5399                       v-in-date =   p-gds-obj.in-date
     5400                     .
     5401                   end.
     5402            end.
     5403            else do:
     5404             find first buf_trn-doc no-lock  where buf_trn-doc.doc-code = p-gds-obj.in-code no-error .
     5405             if available buf_trn-doc  then
     5406                 assign
     5407                   p-price   =    if tPrintRubl then  p-gds-obj.last-rubl else  p-gds-obj.last-base
     5408                   v-in-date =    p-gds-obj.in-date
     5409                   v-fact-order = buf_trn-doc.fact-order .
     5410                 .
     5411             end.
     5412           if p-price = ? then   p-price  = 0 .
     5413         end.
     5414       end.
     5415     End .
     5416     if p-price = ? then   p-price  = 0 .
     5417   end procedure.
     5418   procedure find-mediator :
     5419   define input  parameter c-host-code as integer no-undo .
     5420   define input  parameter p-Showmediatr as logical no-undo .
     5421   define output parameter p-host-code as integer no-undo .
     5422   define output parameter p-flag as logical no-undo .
     5423   define buffer b-sysconf  for ub.sysconf.
     5424    p-host-code = 0 .
     5425    p-flag  = true .
     5426       if p-Showmediatr = true then do:
     5427       find first ub.sysconf where ub.sysconf.avrg-price = true no-lock no-error .
     5428             if avail ub.sysconf then DO :
     5429               p-host-code = ub.sysconf.host-code.
     5430               if tPrintRubl = false then do:
     5431                     find first b-sysconf where b-sysconf.host-code = c-host-code no-lock no-error .
     5432                           if  ub.sysconf.base-code <> b-sysconf.base-code then DO:
     5433                                 p-flag  = false  .
     5434                                 message "Базовая валюта посредника и базовая валюта текущей фирмы не совпадает . Нельзя получить отчет в валюте !"
     5435                                 view-as alert-box error.
     5436                           end.
     5437               end.
     5438             end.
     5439             for each ub.shop no-lock where ub.shop.host-code = p-host-code :
     5440                 create tt-obj-list no-error .
     5441                 assign tt-obj-list.obj-type = 'маг':U
     5442                        tt-obj-list.obj-code = ub.shop.obj-code no-error .
     5443             end.
     5444             for each ub.store no-lock where ub.store.host-code = p-host-code :
     5445                 create tt-obj-list no-error .
     5446                 assign tt-obj-list.obj-type = 'скл':U
     5447                        tt-obj-list.obj-code = ub.store.obj-code no-error .
     5448             end.
     5449       End.
     5450    End procedure .
     5451   PROCEDURE ob-line-stk  :
     5452   define input  parameter x-store-code     like ub.clients.obj-code      no-undo.
     5453   define input  parameter x-store-type     like ub.clients.obj-type      no-undo.
     5454   define INPUT  parameter x-artic          like ub.stk-line.artic        no-undo.
     5455   define INPUT  parameter x-prod-code      like ub.stk-line.prod-code    no-undo.
     5456   define INPUT  parameter x-prod-type      like ub.stk-line.prod-type    no-undo.
     5457   define INPUT  parameter x-Fact-order-1   like ub.stk-line.Fact-order   no-undo.
     5458   define INPUT  parameter x-Fact-order-2   like ub.stk-line.Fact-order   no-undo.
     5459   define input  parameter x-sum-type       like ub.stk-line.sum-type     no-undo.
     5460   define input  parameter x-cat-id         like ub.stk-line.cat-id       no-undo.
     5461   define input  parameter x-ext-doc-type   like ub.ot-line.ext-doc-type  no-undo.
     5462   define input  parameter xTog-obj         as log                     no-undo.
     5463   define input  parameter xi               as int                     no-undo.
     5464   define output  parameter Quntity         like ub.stk-line.fact-qnty   no-undo.
     5465   define output  parameter sum             like ub.stk-line.sum-base    no-undo.
     5466   define output  parameter vat             like ub.stk-line.sum-base    no-undo.
     5467   define output  parameter slt             like ub.stk-line.sum-base    no-undo.
     5468   define output  parameter disc            like ub.stk-line.sum-base    no-undo.
     5469   define variable  First-qnty   like ub.stk-line.fact-qnty   no-undo.
     5470   define variable  Second-qnty  like ub.stk-line.fact-qnty   no-undo.
     5471   define variable  First-sum   like ub.stk-line.sum-base   no-undo.
     5472   define variable  Second-sum  like ub.stk-line.sum-base   no-undo.
     5473   define variable  First-vat   like ub.stk-line.sum-base   no-undo.
     5474   define variable  Second-vat  like ub.stk-line.sum-base   no-undo.
     5475   define variable  First-slt   like ub.stk-line.sum-base   no-undo.
     5476   define variable  Second-slt  like ub.stk-line.sum-base   no-undo.
     5477   define variable  First-disc   like ub.stk-line.sum-base   no-undo.
     5478   define variable  Second-disc  like ub.stk-line.sum-base   no-undo.
     5479   define buffer stk-line2 for ub.stk-line .
     5480   if x-Fact-order-2 < x-Fact-order-1 Then x-Fact-order-2 = x-Fact-order-1.
     5481    Assign
     5482      First-qnty  = 0
     5483      Second-qnty = 0
     5484      Quntity     = 0
     5485      First-sum  = 0
     5486      Second-sum = 0
     5487      sum        = 0
     5488      First-vat  = 0
     5489      Second-vat = 0
     5490      vat        = 0
     5491      First-slt   = 0
     5492      Second-slt  = 0
     5493      slt         = 0
     5494      First-disc  = 0
     5495      Second-disc = 0
     5496      disc        = 0
     5497     .
     5498     For each obj-list  no-lock :
     5499      if  xTog-obj THEN
     5500          if   NOT(    x-store-type     = obj-list.obj-type
     5501               AND    x-store-code      = obj-list.obj-code ) Then NEXT.
     5502      FOR each temp#sum-type where temp#sum-type.xi = xi no-lock :
     5503         find last ub.stk-line no-lock
     5504           where ub.stk-line.obj-type   = obj-list.obj-type
     5505             and ub.stk-line.obj-code   = obj-list.obj-code
     5506             and ub.stk-line.artic      = x-artic
     5507             and ub.stk-line.prod-type  = x-prod-type
     5508             and ub.stk-line.prod-code  = x-prod-code
     5509             and ub.stk-line.sum-type   = temp#sum-type.sum-type
     5510             and ub.stk-line.cat-id     = '##,##':U
     5511             and ub.stk-line.fact-order <= x-fact-order-1
     5512           use-index category
     5513           no-error .
     5514         if available ub.stk-line then do:
     5515           assign
     5516             First-qnty = First-qnty + ub.stk-line.fact-qnty
     5517             First-sum  = First-sum  + (if tprintrubl then ub.stk-line.sum-rubl   else ub.stk-line.sum-base  )
     5518             First-vat  = First-vat  + (if tprintrubl then ub.stk-line.vat-rubl   else ub.stk-line.vat-base  )
     5519             First-disc = First-disc + (if tprintrubl then ub.stk-line.other-rubl else ub.stk-line.other-base )
     5520             First-slt  = First-slt  + (if tprintrubl then ub.stk-line.slt-rubl   else ub.stk-line.slt-base   )
     5521           .
     5522         end.
     5523         find last stk-line2 no-lock
     5524           where stk-line2.obj-code   = obj-list.obj-code
     5525             and stk-line2.obj-type   = obj-list.obj-type
     5526             and stk-line2.artic      = x-artic
     5527             and stk-line2.prod-type  = x-prod-type
     5528             and stk-line2.prod-code  = x-prod-code
     5529             and stk-line2.sum-type   = temp#sum-type.sum-type
     5530             and stk-line2.cat-id     = '##,##':U
     5531             and stk-line2.fact-order <= x-fact-order-2
     5532           use-index category
     5533           no-error .
     5534         if available stk-line2 then do:
     5535           assign
     5536             Second-qnty = Second-qnty + Stk-line2.fact-qnty
     5537             Second-sum  = Second-sum  + (if tprintrubl then stk-line2.sum-rubl else stk-line2.sum-base    )
     5538             Second-vat  = Second-vat  + (if tprintrubl then stk-line2.vat-rubl else stk-line2.vat-base    )
     5539             second-disc = second-disc + (if tprintrubl then stk-line2.other-rubl else stk-line2.other-base )
     5540             second-slt  = second-slt  + (if tprintrubl then stk-line2.slt-rubl   else stk-line2.slt-base   )
     5541           .
     5542         end.
     5543      end.
     5544    end.
     5545    Assign
     5546      Quntity = Second-qnty - first-qnty
     5547      sum     = Second-sum  - first-sum
     5548      vat     = Second-vat  - first-vat
     5549      slt     = Second-slt  - first-slt
     5550      disc    = Second-disc  - first-disc
     5551      .
     5552   END PROCEDURE.
     5553   procedure calc-ms-wt :
     5554   define input        parameter p-oborot-num      as decimal   no-undo .
     5555   define input        parameter p-gds-wt-ms-base  as decimal   no-undo .
     5556   define input-output parameter p-oborot          as decimal   no-undo .
     5557   define input-output parameter p-bi-oborot       as decimal   no-undo .
     5558   define input-output parameter p-bo-oborot       as decimal   no-undo .
     5559   define input-output parameter p-b1-oborot       as decimal   no-undo .
     5560   define input-output parameter p-b2-oborot       as decimal   no-undo .
     5561   do
     5562   on error undo, return error return-value
     5563   :
     5564   if p-is-petrol = true then return .
     5565     assign
     5566       p-oborot    = p-oborot-num * p-gds-wt-ms-base
     5567       p-bi-oborot = p-bi-oborot + p-oborot
     5568       p-bo-oborot = p-bo-oborot + p-oborot
     5569       p-b1-oborot = p-b1-oborot + p-oborot
     5570       p-b2-oborot = p-b2-oborot + p-oborot
     5571     .
     5572   end.
     5573   end procedure.
     5574   procedure calc-dens :
     5575   define input        parameter p-ostatok-wt       as decimal   no-undo .
     5576   define input        parameter p-ostatok          as decimal   no-undo .
     5577   define input-output parameter p-density          as decimal   no-undo .
     5578   define input-output parameter p-bi-density       as decimal   no-undo .
     5579   define input-output parameter p-bo-density       as decimal   no-undo .
     5580   define input-output parameter p-b1-density       as decimal   no-undo .
     5581   define input-output parameter p-b2-density       as decimal   no-undo .
     5582   do
     5583   on error undo, return error return-value
     5584   :
     5585   if p-is-petrol = false then return .
     5586     assign
     5587       p-density    = if abs(p-ostatok) < abs(p-ostatok-wt) then abs(p-ostatok / p-ostatok-wt) else 0
     5588       p-bi-density = 0
     5589       p-bo-density = 0
     5590       p-b1-density = 0
     5591       p-b2-density = 0
     5592     .
     5593   end.
     5594   end procedure.
     5595   procedure calc-pt-ob :
     5596   define input  parameter p-ext-doc-type    as character no-undo .
     5597   define input  parameter x-store-type      as character no-undo .
     5598   define input  parameter x-store-code      as integer   no-undo .
     5599   define input  parameter p-artic           as character no-undo .
     5600   define input  parameter p-prod-type       as character no-undo .
     5601   define input  parameter p-prod-code       as integer   no-undo .
     5602   define input-output parameter p-oborot    as decimal   no-undo .
     5603   define input-output parameter p-bi-oborot as decimal   no-undo .
     5604   define input-output parameter p-bo-oborot as decimal   no-undo .
     5605   define input-output parameter p-b1-oborot as decimal   no-undo .
     5606   define input-output parameter p-b2-oborot as decimal   no-undo .
     5607     do
     5608     on error undo, return error return-value
     5609     :
     5610   define variable v-oborot as decimal   no-undo .
     5611   define buffer buf_doc-line  for ub.doc-line  .
     5612   define buffer buf_inv-line  for ub.inv-line  .
     5613   define buffer buf1_obj-list for obj-list .
     5614   assign
     5615     v-oborot = 0
     5616   .
     5617   if p-is-petrol = false   then return .
     5618     for each buf1_obj-list no-lock :
     5619      if  xtog-obj then
     5620          if   not(x-store-type     = buf1_obj-list.obj-type
     5621               and x-store-code     = buf1_obj-list.obj-code ) then next.
     5622       for each buf_doc-line  no-lock where
     5623             buf_doc-line.obj-type     = buf1_obj-list.obj-type and
     5624             buf_doc-line.obj-code     = buf1_obj-list.obj-code and
     5625             buf_doc-line.artic        = p-artic and
     5626             buf_doc-line.prod-type    = p-prod-type and
     5627             buf_doc-line.prod-code    = p-prod-code and
     5628             buf_doc-line.ext-doc-type = p-ext-doc-type and
     5629             buf_doc-line.status_      = 'факт':U        and
     5630             buf_doc-line.fact-order   <= fact-order-2  and
     5631             buf_doc-line.fact-order   >= fact-order-1
     5632             :
     5633             for each buf_inv-line  no-lock where
     5634                 buf_inv-line.doc-code     = buf_doc-line.doc-code and
     5635                 buf_inv-line.artic        = buf_doc-line.artic and
     5636                 buf_inv-line.prod-type    = buf_doc-line.prod-type and
     5637                 buf_inv-line.prod-code    = buf_doc-line.prod-code
     5638                 :
     5639                 if p-ext-doc-type = 'vt':U  then v-oborot = v-oborot + buf_doc-line.cli-qnty .
     5640                     else do:
     5641                     if p-ext-doc-type = 'we':U    or
     5642                        p-ext-doc-type = 'ee':U    or
     5643                        p-ext-doc-type = 'ev':U    or
     5644                        p-ext-doc-type = 'ep':U or
     5645                        p-ext-doc-type = 'em':U     or
     5646                        p-ext-doc-type = 'wm':U     or
     5647                        p-ext-doc-type = 'es':U   then
     5648                           v-oborot = v-oborot - buf_inv-line.wast-cli-qnty .
     5649                           else v-oborot = v-oborot + buf_inv-line.wast-cli-qnty .
     5650                     end.
     5651             end.
     5652       end.
     5653   end.
     5654   assign
     5655     p-oborot    = v-oborot
     5656     p-bi-oborot = p-bi-oborot + v-oborot
     5657     p-bo-oborot = p-bo-oborot + v-oborot
     5658     p-b1-oborot = p-b1-oborot + v-oborot
     5659     p-b2-oborot = p-b2-oborot + v-oborot
     5660   .
     5661   end.
     5662   end procedure.
     5663   procedure calc-density :
     5664   define input        parameter p-ext-doc-type  as character no-undo .
     5665   define input        parameter x-store-type    as character no-undo .
     5666   define input        parameter x-store-code    as integer   no-undo .
     5667   define input        parameter p-artic         as character no-undo .
     5668   define input        parameter p-prod-type     as character no-undo .
     5669   define input        parameter p-prod-code     as integer   no-undo .
     5670   define input-output parameter p-density       as decimal   no-undo .
     5671   define input-output parameter p-bi-density    as decimal   no-undo .
     5672   define input-output parameter p-bo-density    as decimal   no-undo .
     5673   define input-output parameter p-b1-density    as decimal   no-undo .
     5674   define input-output parameter p-b2-density    as decimal   no-undo .
     5675     do
     5676     on error undo, return error return-value
     5677     :
     5678   define variable v-oborot    as decimal   no-undo .
     5679   define variable v-fact-qnty as decimal   no-undo .
     5680   define buffer buf_doc-line  for ub.doc-line  .
     5681   define buffer buf_inv-line  for ub.inv-line  .
     5682   define buffer buf1_obj-list for obj-list .
     5683   assign
     5684     v-oborot     = 0
     5685     v-fact-qnty  = 0
     5686   .
     5687   if p-is-petrol = false   then return .
     5688     for each buf1_obj-list no-lock :
     5689      if  xtog-obj then
     5690          if   not(x-store-type     = buf1_obj-list.obj-type
     5691               and x-store-code     = buf1_obj-list.obj-code ) then next.
     5692       for each buf_doc-line  no-lock where
     5693             buf_doc-line.obj-type     = buf1_obj-list.obj-type and
     5694             buf_doc-line.obj-code     = buf1_obj-list.obj-code and
     5695             buf_doc-line.artic        = p-artic and
     5696             buf_doc-line.prod-type    = p-prod-type and
     5697             buf_doc-line.prod-code    = p-prod-code and
     5698             buf_doc-line.ext-doc-type = p-ext-doc-type and
     5699             buf_doc-line.status_      = 'факт':U        and
     5700             buf_doc-line.fact-order   <= fact-order-2  and
     5701             buf_doc-line.fact-order   >= fact-order-1
     5702             :
     5703             assign v-fact-qnty = v-fact-qnty + buf_doc-line.fact-qnty.
     5704             for each buf_inv-line  no-lock where
     5705                 buf_inv-line.doc-code     = buf_doc-line.doc-code and
     5706                 buf_inv-line.artic        = buf_doc-line.artic and
     5707                 buf_inv-line.prod-type    = buf_doc-line.prod-type and
     5708                 buf_inv-line.prod-code    = buf_doc-line.prod-code
     5709                 :
     5710                 if p-ext-doc-type = 'vt':U  then v-oborot = v-oborot + buf_doc-line.cli-qnty .
     5711                     else do:
     5712                     if p-ext-doc-type = 'we':U    or
     5713                        p-ext-doc-type = 'ee':U    or
     5714                        p-ext-doc-type = 'ev':U    or
     5715                        p-ext-doc-type = 'ep':U or
     5716                        p-ext-doc-type = 'em':U     or
     5717                        p-ext-doc-type = 'wm':U     or
     5718                        p-ext-doc-type = 'es':U   then
     5719                           v-oborot = v-oborot - buf_inv-line.wast-cli-qnty .
     5720                           else v-oborot = v-oborot + buf_inv-line.wast-cli-qnty .
     5721                     end.
     5722             end.
     5723       end.
     5724       assign
     5725         p-density    = if ( v-fact-qnty <> 0 and ABS(v-oborot) < ABS(v-fact-qnty)) then ABS(v-oborot / v-fact-qnty) else 0
     5726       .
     5727       assign
     5728         p-bi-density = p-density
     5729         p-bo-density = 0
     5730         p-b1-density = 0
     5731         p-b2-density = 0
     5732       .
     5733   end.
     5734   end.
     5735   end procedure.
