     4203           oborot-ie[v-ii + tt#] + oborot-ee[v-ii + tt#] + oborot-ep[v-ii + tt#] +
     4204           oborot-es[v-ii + tt#] + oborot-re[v-ii + tt#] + oborot-rs[v-ii + tt#] +
     4205           oborot-we[v-ii + tt#] + oborot-vt[v-ii + tt#] + oborot-iv[v-ii + tt#] +
     4206           oborot-ev[v-ii + tt#] + oborot-rv[v-ii + tt#] + oborot-em[v-ii + tt#] +
     4207           oborot-im[v-ii + tt#] .
     4208        end.
     4209         oborot-sum-sale[1] =
     4210         oborot-ee[2 + tt#] +
     4211         oborot-es[2 + tt#] +
     4212         oborot-re[2 + tt#] +
     4213         oborot-rs[2 + tt#]
     4214         .
     4215          assign oborot-ot[1 + tt#] = (ostatok-end[1 + tt#]  - ostatok-start[1 + tt#])  -  (v-summa[1])
     4216           oborot-ot[2 + tt#] = (ostatok-end[2 + tt#]  - ostatok-start[2 + tt#])  -  (v-summa[2])
     4217                                                                                                     -  oborot-disc[1]
     4218           oborot-ot[3 + tt#] = (ostatok-end[3 + tt#]  - ostatok-start[3 + tt#])  -  (v-summa[3])
     4219           oborot-ot[10] = (ostatok-end[10]  - ostatok-start[10])                 -  (v-summa[4])
     4220           .
     4221           oborot-eff[1] = -1 * (oborot-sum-sale[1] - oborot-sum-cost[1]) .
     4222           if oborot-sum-cost[1] <>  0 then
     4223             oborot-prc[1] = 100 * (oborot-sum-sale[1] - oborot-sum-cost[1] ) / oborot-sum-cost[1].
     4224             else oborot-prc[1] = 0.
     4225     end.
     4226   oborot-ie[4]   = Round(oborot-ie[1]   *  p-price-med , 2) .
     4227   oborot-ee[4]   = Round(oborot-ee[1]   *  p-price-med , 2) .
     4228   oborot-ep[4]   = Round(oborot-ep[1]   *  p-price-med , 2) .
     4229   oborot-es[4]   = Round(oborot-es[1]   *  p-price-med , 2) .
     4230   oborot-re[4]   = Round(oborot-re[1]   *  p-price-med , 2) .
     4231   oborot-rs[4]   = Round(oborot-rs[1]   *  p-price-med , 2) .
     4232   oborot-we[4]   = Round(oborot-we[1]   *  p-price-med , 2) .
     4233   oborot-vt[4]   = Round(oborot-vt[1]   *  p-price-med , 2) .
     4234   oborot-iv[4]   = Round(oborot-iv[1]   *  p-price-med , 2) .
     4235   oborot-ev[4]   = Round(oborot-ev[1]   *  p-price-med , 2) .
     4236   oborot-rv[4]   = Round(oborot-rv[1]   *  p-price-med , 2) .
     4237   oborot-em[4]   = Round(oborot-em[1]   *  p-price-med , 2) .
     4238   oborot-im[4]   = Round(oborot-im[1]   *  p-price-med , 2) .
     4239   oborot-ot[4]   = Round(oborot-ot[1]   *  p-price-med , 2) .
     4240   oborot-ap[4]   = Round(oborot-ap[1]   *  p-price-med , 2) .
     4241   oborot-pc[4]   = Round(oborot-pc[1]   *  p-price-med , 2) .
     4242   end procedure.
     4243   procedure ost-line :
     4244     define input  parameter x-store-code like ub.clients.obj-code    no-undo .
     4245     define input  parameter x-store-type like ub.clients.obj-type    no-undo .
     4246     define input  parameter x-artic      like ub.stk-line.artic      no-undo .
     4247     define input  parameter x-prod-code  like ub.stk-line.prod-code  no-undo .
     4248     define input  parameter x-prod-type  like ub.stk-line.prod-type  no-undo .
     4249     define input  parameter x-tog-shift  as logical no-undo .
     4250     define input  parameter x-fact-order like ub.stk-line.fact-order no-undo .
     4251     define input  parameter x-sum-type   like ub.stk-line.sum-type   no-undo .
     4252     define input  parameter x-cat-id     like ub.stk-line.cat-id     no-undo .
     4253     define input  parameter xtog-obj     as logical no-undo .
     4254     define output parameter quantity     like ub.stk-line.fact-qnty  no-undo .
     4255     define output parameter coast_r      like ub.stk-line.sum-rubl   no-undo .
     4256     define output parameter coast_v      like ub.stk-line.sum-rubl   no-undo .
     4257     define output parameter vat_r        like ub.stk-line.sum-rubl   no-undo .
     4258     define output parameter vat_v        like ub.stk-line.sum-rubl   no-undo .
     4259     define output parameter slt_r        like ub.stk-line.sum-rubl   no-undo .
     4260     define output parameter slt_v        like ub.stk-line.sum-rubl   no-undo .
     4261     define buffer buff-obj-list  for obj-list .
     4262     define buffer buff-stk-line  for ub.stk-line .
     4263     assign
     4264       Quantity = 0
     4265       Coast_R  = 0
     4266       Coast_V  = 0
     4267       VAT_R    = 0
     4268       VAT_V    = 0
     4269       SLT_R    = 0
     4270       SLT_V    = 0
     4271     .
     4272     if  x-tog-shift = false then do:
     4273       for each buff-obj-list no-lock
     4274         where xtog-obj = false
     4275            or (buff-obj-list.obj-type = x-store-type
     4276               and buff-obj-list.obj-code = x-store-code
     4277               )
     4278       on error undo, return error
     4279       :
     4280       find last buff-stk-line no-lock
     4281         where buff-stk-line.obj-type   = buff-obj-list.obj-type
     4282           and buff-stk-line.obj-code   = buff-obj-list.obj-code
     4283           and buff-stk-line.artic      = x-artic
     4284           and buff-stk-line.prod-type  = x-prod-type
     4285           and buff-stk-line.prod-code  = x-prod-code
     4286           and buff-stk-line.sum-type   = x-sum-type
     4287           and buff-stk-line.cat-id     = '##,##':U
     4288           and buff-stk-line.fact-order <= x-fact-order
     4289           and buff-stk-line.shift-num  = 0
     4290         use-index category
     4291         no-error .
     4292       if available buff-stk-line then do:
     4293         assign
     4294           Quantity = Quantity + buff-stk-line.fact-qnty
     4295           Coast_R  = Coast_R  + buff-stk-line.sum-rubl
     4296           Coast_V  = Coast_V  + buff-stk-line.sum-base
     4297           VAT_R    = VAT_R    + buff-stk-line.VAT-rubl
     4298           VAT_V    = VAT_V    + buff-stk-line.VAT-base
     4299           SLT_R    = SLT_R    + buff-stk-line.SLT-rubl
     4300           SLT_V    = SLT_V    + buff-stk-line.SLT-base
     4301         .
     4302       end.
     4303      end.
     4304     end.
     4305     else do:
     4306       for each buff-obj-list no-lock
     4307         where xtog-obj = false
     4308            or (buff-obj-list.obj-type = x-store-type
     4309               and buff-obj-list.obj-code = x-store-code
     4310               )
     4311       on error undo, return error
     4312       :
     4313         find last buff-stk-line no-lock
     4314           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     4315             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     4316             and buff-stk-line.artic      = x-artic
     4317             and buff-stk-line.prod-type  = x-prod-type
     4318             and buff-stk-line.prod-code  = x-prod-code
     4319             and buff-stk-line.sum-type   = x-sum-type
     4320             and buff-stk-line.cat-id     = '##,##':U
     4321             and buff-stk-line.fact-order <= x-fact-order
     4322             and buff-stk-line.shift-num  > 0
     4323           use-index category
     4324           no-error .
     4325         if available buff-stk-line then do:
     4326           assign
     4327             Quantity = Quantity +  buff-stk-line.fact-qnty
     4328             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     4329             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     4330             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     4331             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     4332             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     4333             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     4334           .
     4335         end.
     4336       end.
     4337     end.
     4338   end procedure.
     4339   procedure ost-lineother-tax :
     4340     define input  parameter x-store-code like ub.clients.obj-code      no-undo.
     4341     define input  parameter x-store-type like ub.clients.obj-type      no-undo.
     4342     define input  parameter x-artic      like ub.stk-line.artic        no-undo.
     4343     define input  parameter x-prod-code  like ub.stk-line.prod-code    no-undo.
     4344     define input  parameter x-prod-type  like ub.stk-line.prod-type    no-undo.
     4345     define input  parameter x-tog-shift  as logical no-undo .
     4346     define input  parameter x-fact-order like ub.stk-line.fact-order   no-undo.
     4347     define input  parameter x-sum-type   like ub.stk-line.sum-type     no-undo.
     4348     define input  parameter x-type-id    like ub.stk-line.cat-id       no-undo.
     4349     define input  parameter xTog-obj     as logical no-undo .
     4350     define output parameter Quantity     like ub.stk-line.fact-qnty   no-undo.
     4351     define output parameter Coast_R      like ub.stk-line.sum-rubl    no-undo.
     4352     define output parameter Coast_V      like ub.stk-line.sum-rubl    no-undo.
     4353     define output parameter VAT_R        like ub.stk-line.sum-rubl    no-undo.
     4354     define output parameter VAT_V        like ub.stk-line.sum-rubl    no-undo.
     4355     define output parameter SLT_R        like ub.stk-line.sum-rubl    no-undo.
     4356     define output parameter SLT_V        like ub.stk-line.sum-rubl    no-undo.
     4357     define output parameter other_R      like ub.stk-line.sum-rubl    no-undo.
     4358     define output parameter other_V      like ub.stk-line.sum-rubl    no-undo.
     4359     define buffer buff-obj-list  for obj-list .
     4360     define buffer buff-stk-line  for ub.stk-line .
     4361     assign
     4362       Quantity = 0
     4363       Coast_R  = 0
     4364       Coast_V  = 0
     4365       VAT_R    = 0
     4366       VAT_V    = 0
     4367       SLT_R    = 0
     4368       SLT_V    = 0
     4369       other_R  = 0
     4370       other_V  = 0
     4371     .
     4372     if  x-tog-shift = false then do:
     4373       for each buff-obj-list no-lock
     4374         where xtog-obj = false
     4375            or (buff-obj-list.obj-type = x-store-type
     4376               and buff-obj-list.obj-code = x-store-code
     4377               )
     4378       on error undo, return error
     4379       :
     4380       find last buff-stk-line no-lock
     4381         where buff-stk-line.obj-type   = buff-obj-list.obj-type
     4382           and buff-stk-line.obj-code   = buff-obj-list.obj-code
     4383           and buff-stk-line.artic      = x-artic
     4384           and buff-stk-line.prod-type  = x-prod-type
     4385           and buff-stk-line.prod-code  = x-prod-code
     4386           and buff-stk-line.sum-type   = x-sum-type
     4387           and buff-stk-line.cat-id     = '##,##':U
     4388           and buff-stk-line.fact-order <= x-fact-order
     4389           and buff-stk-line.shift-num  = 0
     4390         use-index category
     4391         no-error .
     4392       if available buff-stk-line then do:
     4393         assign
     4394           Quantity = Quantity + buff-stk-line.fact-qnty
     4395           Coast_R  = Coast_R  + buff-stk-line.sum-rubl
     4396           Coast_V  = Coast_V  + buff-stk-line.sum-base
     4397           VAT_R    = VAT_R    + buff-stk-line.VAT-rubl
     4398           VAT_V    = VAT_V    + buff-stk-line.VAT-base
     4399           SLT_R    = SLT_R    + buff-stk-line.SLT-rubl
     4400           SLT_V    = SLT_V    + buff-stk-line.SLT-base
     4401           other_R  = other_R  + buff-stk-line.other-rubl
     4402           other_V  = other_V  + buff-stk-line.other-base
     4403         .
     4404       end.
     4405    end.
     4406     end.
     4407     else do:
     4408       for each buff-obj-list no-lock
     4409         where xtog-obj = false
     4410            or (buff-obj-list.obj-type = x-store-type
     4411               and buff-obj-list.obj-code = x-store-code
     4412               )
     4413       on error undo, return error
     4414       :
     4415         find last buff-stk-line no-lock
     4416           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     4417             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     4418             and buff-stk-line.artic      = x-artic
     4419             and buff-stk-line.prod-type  = x-prod-type
     4420             and buff-stk-line.prod-code  = x-prod-code
     4421             and buff-stk-line.sum-type   = x-sum-type
     4422             and buff-stk-line.cat-id     = '##,##':U
     4423             and buff-stk-line.fact-order <= x-fact-order
     4424             and buff-stk-line.shift-num  > 0
     4425           use-index category
     4426           no-error .
     4427         if available buff-stk-line then do:
     4428           assign
     4429             Quantity = Quantity +  buff-stk-line.fact-qnty
     4430             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     4431             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     4432             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     4433             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     4434             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     4435             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     4436             other_R = other_R   +  buff-stk-line.other-rubl
     4437             other_V = other_V   +  buff-stk-line.other-base
     4438           .
     4439         end.
     4440       end.
     4441     end.
     4442   end procedure.
     4443   procedure ost-line-kg :
     4444     define  input parameter p-obj-code    like ub.stk-line.obj-code   no-undo .
     4445     define  input parameter p-obj-type    like ub.stk-line.obj-type   no-undo .
     4446     define  input parameter p-artic       like ub.stk-line.artic      no-undo .
     4447     define  input parameter p-prod-code   like ub.stk-line.prod-code  no-undo .
     4448     define  input parameter p-prod-type   like ub.stk-line.prod-type  no-undo .
     4449     define  input parameter p-fact-order  like ub.stk-line.fact-order no-undo .
     4450     define output parameter p-quantity-kg like ub.stk-line.fact-qnty  no-undo initial 0.00 .
     4451     define buffer buff-obj-list  for obj-list .
     4452     define buffer buf_doc-line for ub.doc-line .
     4453     define buffer buf_inv-line for ub.inv-line .
     4454     do
     4455     on error undo, return error
     4456     :
     4457       for each buf_doc-line no-lock where
     4458                buf_doc-line.obj-type    = p-obj-type   and
     4459                buf_doc-line.obj-code    = p-obj-code   and
     4460                buf_doc-line.prod-type   = p-prod-type  and
     4461                buf_doc-line.prod-code   = p-prod-code  and
     4462                buf_doc-line.artic       = p-artic      and
     4463                buf_doc-line.status_     = 'факт':U      and
     4464                buf_doc-line.fact-order <= p-fact-order
     4465             by buf_doc-line.fact-order    descending
     4466       :
     4467         find first buf_inv-line no-lock where
     4468                    buf_inv-line.doc-code  = buf_doc-line.doc-code  and
     4469                    buf_inv-line.artic     = buf_doc-line.artic     and
     4470                    buf_inv-line.prod-type = buf_doc-line.prod-type and
     4471                    buf_inv-line.prod-code = buf_doc-line.prod-code no-error .
     4472         if available buf_inv-line
     4473         then do:
     4474           if buf_inv-line.after-cli-qnty <> ?
     4475           then do:
     4476             assign
     4477               p-quantity-kg = buf_inv-line.after-cli-qnty
     4478             .
     4479             leave .
     4480           end.
     4481         end.
     4482       end.
     4483       if p-quantity-kg = ?
     4484       then do:
     4485         assign
     4486           p-quantity-kg = 0
     4487         .
     4488       end.
     4489     end.
     4490   end procedure.
     4491   PROCEDURE ostatok :
     4492   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
     4493   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
     4494   def input parameter x-tog-shift   as   logical             no-undo.
     4495   def input parameter x-date-start  like ub.stk-tot.Fact-date   no-undo.
     4496   def input parameter x-date-end    like ub.stk-tot.Fact-date   no-undo.
     4497   def input parameter x-shift-start as integer               no-undo.
     4498   def input parameter x-shift-end   as integer               no-undo.
     4499   def input parameter x-sum-type    like ub.stk-tot.sum-type    no-undo.
     4500   def input parameter x-cat-id      like ub.stk-tot.cat-id      no-undo.
     4501   def input parameter xTog-obj   as log no-undo.
     4502   def output parameter Quantity    like ub.stk-tot.fact-qnty   no-undo.
     4503   def output parameter Coast_R     like ub.stk-tot.sum-rubl    no-undo.
     4504   def output parameter Coast_V     like ub.stk-tot.sum-rubl    no-undo.
     4505   def output parameter VAT_R       like ub.stk-tot.sum-rubl    no-undo.
     4506   def output parameter VAT_V       like ub.stk-tot.sum-rubl    no-undo.
     4507   def output parameter Fact-order  like ub.stk-tot.Fact-order  no-undo.
     4508   def var              Fact-order#   like ub.stk-tot.Fact-order  no-undo.
     4509   def var              Fact-orderS   as char  no-undo.
     4510   def var x-date-start-t  like ub.stk-tot.shift-date   no-undo.
     4511      Assign
     4512         Fact-order   = 0
     4513         Quantity     = 0
     4514         Coast_R      = 0
     4515         Coast_V      = 0
     4516         VAT_R        = 0
     4517         VAT_V        = 0 .
     4518    x-date-start-t  = x-date-start + 1 .
     4519   IF x-date-end = date('') then DO:
     4520      Fact-order = 0 .
     4521      for each obj-list
     4522          where  ( not xtog-obj or
     4523                 ( x-store-type = obj-list.obj-type and x-store-code = obj-list.obj-code ))
     4524                 no-lock :
     4525         if  x-tog-shift = false then do:
     4526                          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     4527                               ub.stk-tot.Fact-date <=  x-date-start
     4528                               and ub.stk-tot.shift-num = 0
     4529                               USE-INDEX fact-date no-lock no-error .
     4530              if Available ub.stk-tot THEN  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     4531         End.
     4532         Else  DO :
     4533             find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     4534              (ub.stk-tot.shift-date  = x-date-start-t and
     4535               ub.stk-tot.shift-num  < x-shift-start or
     4536               ub.stk-tot.shift-date  < x-date-start-t  )
     4537               and ub.stk-tot.shift-num  > 0
     4538               USE-INDEX Shift-num no-lock no-error .
     4539            If Available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     4540           END.
     4541       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     4542     End.
     4543   End.
     4544   Else DO:
     4545     For each obj-list  WHERE
     4546        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
     4547         no-lock :
     4548      IF  x-TOG-Shift = False Then DO:
     4549          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     4550               ub.stk-tot.Fact-date <= x-date-end
     4551               and ub.stk-tot.shift-num = 0
     4552               USE-INDEX fact-date no-lock no-error.
     4553          if available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     4554      END.
     4555      Else DO:
     4556           find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     4557               (ub.stk-tot.shift-date  = x-date-end and
     4558               ub.stk-tot.shift-num  <= x-shift-end or
     4559               ub.stk-tot.shift-date  < x-date-end       ) and
     4560               ub.stk-tot.shift-num   > 0      use-index shift-num no-lock no-error.
     4561               if Available ub.stk-tot THEN Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     4562       End.
     4563       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     4564     End.
     4565   End.
     4566   END PROCEDURE.
     4567   procedure report-exec1  :
     4568      find first clients where x-store-type = clients.obj-type and
     4569                               x-store-code = clients.obj-code
     4570                               no-lock no-error.
     4571              if available clients then assign  objname = clients.obj-name
     4572                                                x-db-num     = clients.db-num.
     4573                                            else  objname="объект не определен".
     4574     run calcitog in this-procedure .
     4575     run print-header in this-procedure .      case retclassify :
     4576      when "prod/grp-goods":u then  run run4 in this-procedure .
     4577      otherwise do:
     4578        message "Ошибка вызова" view-as alert-box error .
     4579      end.
     4580      end case.
     4581     run print-footer in this-procedure .
     4582     end procedure.
     4583   procedure calc-sub-itog :
     4584   define input parameter tt as int no-undo.
     4585   define variable tt2 as integer no-undo .
     4586     if tt = 6 then tt2 = 7 .
     4587               else tt2 = tt.
     4588   repeat i# = 1 + tt to 3 + tt2 :
     4589   run sum-i (
     4590    input oborot-vt[i#]
     4591   ,input tt
     4592   ,input-output b1-oborot-vt[i#]
     4593   ,input-output b2-oborot-vt[i#]
     4594   ,input-output bi-oborot-vt[i#]
     4595   ,input-output bo-oborot-vt[i#]
     4596   ,input oborot-ie[i#]
     4597   ,input-output b1-oborot-ie[i#]
     4598   ,input-output b2-oborot-ie[i#]
     4599   ,input-output bi-oborot-ie[i#]
     4600   ,input-output bo-oborot-ie[i#]
     4601   ) .
     4602   run sum-i (
     4603    input oborot-iv[i#]
     4604   ,input tt
     4605   ,input-output b1-oborot-iv[i#]
     4606   ,input-output b2-oborot-iv[i#]
     4607   ,input-output bi-oborot-iv[i#]
     4608   ,input-output bo-oborot-iv[i#]
     4609   ,input oborot-ee[i#]
     4610   ,input-output b1-oborot-ee[i#]
     4611   ,input-output b2-oborot-ee[i#]
     4612   ,input-output bi-oborot-ee[i#]
     4613   ,input-output bo-oborot-ee[i#]
     4614   ) .
     4615   run sum-i (
     4616    input oborot-ev[i#]
     4617   ,input tt
     4618   ,input-output b1-oborot-ev[i#]
     4619   ,input-output b2-oborot-ev[i#]
     4620   ,input-output bi-oborot-ev[i#]
     4621   ,input-output bo-oborot-ev[i#]
     4622   ,input oborot-ep[i#]
     4623   ,input-output b1-oborot-ep[i#]
     4624   ,input-output b2-oborot-ep[i#]
     4625   ,input-output bi-oborot-ep[i#]
     4626   ,input-output bo-oborot-ep[i#]
     4627   ) .
     4628   run sum-i (
     4629    input oborot-rv[i#]
     4630   ,input tt
     4631   ,input-output b1-oborot-rv[i#]
     4632   ,input-output b2-oborot-rv[i#]
     4633   ,input-output bi-oborot-rv[i#]
     4634   ,input-output bo-oborot-rv[i#]
     4635   ,input oborot-es[i#]
     4636   ,input-output b1-oborot-es[i#]
     4637   ,input-output b2-oborot-es[i#]
     4638   ,input-output bi-oborot-es[i#]
     4639   ,input-output bo-oborot-es[i#]
     4640   ) .
     4641   run sum-i (
     4642    input oborot-em[i#]
     4643   ,input tt
     4644   ,input-output b1-oborot-em[i#]
     4645   ,input-output b2-oborot-em[i#]
     4646   ,input-output bi-oborot-em[i#]
     4647   ,input-output bo-oborot-em[i#]
     4648   ,input oborot-re[i#]
     4649   ,input-output b1-oborot-re[i#]
     4650   ,input-output b2-oborot-re[i#]
     4651   ,input-output bi-oborot-re[i#]
     4652   ,input-output bo-oborot-re[i#]
     4653   ) .
     4654   run sum-i (
     4655    input oborot-im[i#]
     4656   ,input tt
     4657   ,input-output b1-oborot-im[i#]
     4658   ,input-output b2-oborot-im[i#]
     4659   ,input-output bi-oborot-im[i#]
     4660   ,input-output bo-oborot-im[i#]
     4661   ,input oborot-rs[i#]
     4662   ,input-output b1-oborot-rs[i#]
     4663   ,input-output b2-oborot-rs[i#]
     4664   ,input-output bi-oborot-rs[i#]
     4665   ,input-output bo-oborot-rs[i#]
     4666   ) .
     4667   run sum-i (
     4668    input oborot-ot[i#]
     4669   ,input tt
     4670   ,input-output b1-oborot-ot[i#]
     4671   ,input-output b2-oborot-ot[i#]
     4672   ,input-output bi-oborot-ot[i#]
     4673   ,input-output bo-oborot-ot[i#]
     4674   ,input oborot-we[i#]
     4675   ,input-output b1-oborot-we[i#]
     4676   ,input-output b2-oborot-we[i#]
     4677   ,input-output bi-oborot-we[i#]
     4678   ,input-output bo-oborot-we[i#]
     4679   ) .
     4680   run sum-i (
     4681    input oborot-ap[i#]
     4682   ,input tt
     4683   ,input-output b1-oborot-ap[i#]
     4684   ,input-output b2-oborot-ap[i#]
     4685   ,input-output bi-oborot-ap[i#]
     4686   ,input-output bo-oborot-ap[i#]
     4687   ,input oborot-pc[i#]
     4688   ,input-output b1-oborot-pc[i#]
     4689   ,input-output b2-oborot-pc[i#]
     4690   ,input-output bi-oborot-pc[i#]
     4691   ,input-output bo-oborot-pc[i#]
     4692   ) .
     4693     b1-oborot-em[ i#] = b1-oborot-em[ i#] + oborot-wm[ i#].
     4694     b2-oborot-em[ i#] = b2-oborot-em[ i#] + oborot-wm[ i#].
     4695     bi-oborot-em[ i#] = bi-oborot-em[ i#] + oborot-wm[ i#].
     4696     bo-oborot-em[ i#] = bo-oborot-em[ i#] + oborot-wm[ i#].
     4697     bo-ostatok-start[ i#]  = bo-ostatok-start[i#]  + ostatok-start[ i#]  .
     4698     bo-ostatok-end[ i#]    = bo-ostatok-end[i#]    + ostatok-end[ i#]    .
     4699     if i# = 7 then b1-oborot-disc[1 ]  = b1-oborot-disc[1]  + oborot-disc[1]  .
     4700     if i# = 7 then b2-oborot-disc[1 ]  = b2-oborot-disc[1]  + oborot-disc[1]  .
     4701     if i# = 7 then bi-oborot-disc[1 ]  = bi-oborot-disc[1]  + oborot-disc[1]  .
     4702     if i# = 7 then bo-oborot-disc[1 ]  = bo-oborot-disc[1]  + oborot-disc[1]  .
     4703     if i# = 8 then
     4704       assign
     4705         bi-oborot-sum-sale[ i#]  = bi-oborot-ee[ i#] +
     4706                                 bi-oborot-re[ i#]         +
     4707                                 bi-oborot-rs[ i#]    +
     4708                                 bi-oborot-es[ i#]
     4709         b1-oborot-sum-sale[ i#]  = b1-oborot-ee[ i#] +
     4710                                 b1-oborot-re[ i#]         +
     4711                                 b1-oborot-rs[ i#]    +
     4712                                 b1-oborot-es[ i#]
     4713         b2-oborot-sum-sale[ i#]  = b2-oborot-ee[ i#] +
     4714                                 b2-oborot-re[ i#]         +
     4715                                 b2-oborot-rs[ i#]    +
     4716                                 b2-oborot-es[ i#]
     4717         bo-oborot-sum-sale[ i#]  = bo-oborot-ee[ i#] +
     4718                                 bo-oborot-re[ i#]         +
     4719                                 bo-oborot-rs[ i#]    +
     4720                                 bo-oborot-es[ i#]
     4721         .
     4722     if  xshowmediator = true  then do:
     4723         if i# = 8 then b1-oborot-sum-cost[2 ]  = b1-oborot-sum-cost[2]  + oborot-sum-cost[1]  .
     4724         if i# = 8 then b2-oborot-sum-cost[2 ]  = b2-oborot-sum-cost[2]  + oborot-sum-cost[1]  .
     4725         if i# = 8 then bi-oborot-sum-cost[2 ]  = bi-oborot-sum-cost[2]  + oborot-sum-cost[1]  .
     4726         if i# = 8 then bo-oborot-sum-cost[2 ]  = bo-oborot-sum-cost[2]  + oborot-sum-cost[1]  .
     4727     end.
     4728     if i# = 2 and xshowmediator = false  then
     4729         assign
     4730           bi-oborot-sum-cost[ i#]  = bi-oborot-ee[ i#] +
     4731                                   bi-oborot-re[ i#]         +
     4732                                   bi-oborot-rs[ i#]    +
     4733                                   bi-oborot-es[ i#]
     4734           b1-oborot-sum-cost[ i#]  = b1-oborot-ee[ i#] +
     4735                                   b1-oborot-re[ i#]         +
     4736                                   b1-oborot-rs[ i#]    +
     4737                                   b1-oborot-es[ i#]
     4738           b2-oborot-sum-cost[ i#]  = b2-oborot-ee[ i#] +
     4739                                   b2-oborot-re[ i#]         +
     4740                                   b2-oborot-rs[ i#]    +
     4741                                   b2-oborot-es[ i#]
     4742           bo-oborot-sum-cost[ i#]  = bo-oborot-ee[ i#] +
     4743                                   bo-oborot-re[ i#]         +
     4744                                   bo-oborot-rs[ i#]    +
     4745                                   bo-oborot-es[ i#]
     4746           .
     4747     if i# = 8 then b1-oborot-eff[1 ]  = b1-oborot-eff[1]  + oborot-eff[1]  .
     4748     if i# = 8 then b2-oborot-eff[1 ]  = b2-oborot-eff[1]  + oborot-eff[1]  .
     4749     if i# = 8 then bi-oborot-eff[1 ]  = bi-oborot-eff[1]  + oborot-eff[1]  .
     4750     if i# = 8 then bo-oborot-eff[1 ]  = bo-oborot-eff[1]  + oborot-eff[1]  .
     4751     if i# = 8 then    if  bi-oborot-sum-cost[2] <>  0 then
     4752                           bi-oborot-prc[1] = 100 * (bi-oborot-sum-sale[8] - bi-oborot-sum-cost[2] ) / bi-oborot-sum-cost[2] .
     4753                      else bi-oborot-prc[1] = 0.
     4754     if i# = 8 then    if  bo-oborot-sum-cost[2] <>  0 then
     4755                           bo-oborot-prc[1] = 100 * (bo-oborot-sum-sale[8] - bo-oborot-sum-cost[2] ) / bo-oborot-sum-cost[2] .
     4756                      else bo-oborot-prc[1] = 0.
     4757     if i# = 8 then    if  b1-oborot-sum-cost[2] <>  0 then
     4758                           b1-oborot-prc[1] = 100 * (b1-oborot-sum-sale[8] - b1-oborot-sum-cost[2] ) / b1-oborot-sum-cost[2] .
     4759                      else b1-oborot-prc[1] = 0.
     4760     if i# = 8 then    if  b2-oborot-sum-cost[2] <>  0 then
     4761                           b2-oborot-prc[1] = 100 * (b2-oborot-sum-sale[8] - b2-oborot-sum-cost[2] ) / b2-oborot-sum-cost[2] .
     4762                      else b2-oborot-prc[1] = 0.
     4763    end.
     4764   end procedure.
     4765   procedure sum-i :
     4766   define input parameter ob like oborot-ot[1] no-undo.
     4767   define input parameter tt as int  no-undo.
     4768   define input-output parameter b1 like b1-oborot-ot[1] no-undo.
     4769   define input-output parameter b2 like b1-oborot-ot[1] no-undo.
     4770   define input-output parameter bi like b1-oborot-ot[1] no-undo.
     4771   define input-output parameter bo like b1-oborot-ot[1] no-undo.
     4772   define input parameter ob2 like oborot-ot[1] no-undo.
     4773   define input-output parameter b1- like b1-oborot-ot[1] no-undo.
     4774   define input-output parameter b2- like b1-oborot-ot[1] no-undo.
     4775   define input-output parameter bi- like b1-oborot-ot[1] no-undo.
     4776   define input-output parameter bo- like b1-oborot-ot[1] no-undo.
     4777   assign
     4778    b1  = b1 + ob
     4779    b2  = b2 + ob
     4780    b1- = b1- + ob2
     4781    b2- = b2- + ob2
     4782    .
     4783       assign
     4784       bi = bi + ob
     4785       bo = bo + ob
     4786       bi- = bi- + ob2
     4787       bo- = bo- + ob2
     4788       .
     4789   end procedure.
     4790   procedure clear-item :
     4791   define variable kk as int no-undo.
     4792    repeat kk = 1 to 13 :
     4793    assign
     4794       oborot-ie                 [kk]    = 0
     4795       oborot-ee                 [kk]    = 0
     4796       oborot-ep              [kk]    = 0
     4797       oborot-es            [kk]    = 0
     4798       oborot-re             [kk]    = 0
     4799       oborot-rs        [kk]    = 0
     4800       oborot-we                 [kk]    = 0
     4801       oborot-vt                       [kk]    = 0
     4802       oborot-iv                 [kk]    = 0
     4803       oborot-ev                 [kk]    = 0
     4804       oborot-rv             [kk]    = 0
     4805       oborot-em                  [kk]    = 0
     4806       oborot-wm                  [kk]    = 0
     4807       oborot-im                  [kk]    = 0
     4808       oborot-ot                  [kk]    = 0
     4809       oborot-disc                             [kk]    = 0
     4810       oborot-eff                              [kk]    = 0
     4811       oborot-prc                              [kk]    = 0
     4812       oborot-ap            [kk]    = 0
     4813       oborot-pc            [kk]    = 0
     4814       ostatok-end                                    [kk]    = 0
     4815       ostatok-start                                  [kk]    = 0
     4816     .
     4817    end.
     4818   end procedure.
     4819   procedure item-goods :
     4820    define input parameter  par-3 as char no-undo.
     4821    define input parameter  par-4 as char no-undo.
     4822        if par-4 = "goods":u  then  assign
     4823                                       gds-zap-unit-base  = goods.unit-base
     4824                                       gds-zap-prt-root   = goods.prt-root
     4825                                       gds-zap-prod-type  = goods.prod-type
     4826                                       gds-zap-prod-code  = goods.prod-code
     4827                                       gds-zap-artic      = goods.artic
     4828                                       gds-zap-type       = goods.gds-type
     4829                                       gds-zap-grp-name   = goods.grp-name
     4830                                       gds-zap-b-code     = goods.gds-code
     4831                                       gds-zap-gds-name   = if g#gds-engl then goods.engl-name
     4832                                                                          else goods.gds-name
     4833                                       gds-zap-gds-long-name = substring ((if goods.engl-name <> ? then trim(goods.engl-name) else "" ) +
     4834                                                               ( if goods.label-name <> ? then trim(goods.label-name) else "" ),1,120).
     4835        if par-4 = "gds-list":u  then  assign
     4836                                       gds-zap-unit-base  = gds-list.unit-base
     4837                                       gds-zap-prt-root   = gds-list.prt-root
     4838                                       gds-zap-prod-type  = gds-list.prod-type
     4839                                       gds-zap-prod-code  = gds-list.prod-code
     4840                                       gds-zap-artic      = gds-list.artic
     4841                                       gds-zap-type       = gds-list.gds-type
     4842                                       gds-zap-grp-name   = gds-list.grp-name
     4843                                       gds-zap-b-code     = gds-list.gds-code
     4844                                       gds-zap-gds-name   = if g#gds-engl then gds-list.engl-name
     4845                                                                          else gds-list.gds-name
     4846                                       gds-zap-gds-long-name = substring ((if gds-list.engl-name <> ? then trim(gds-list.engl-name) else "" ) +
     4847                                                               ( if gds-list.label-name <> ? then trim(gds-list.label-name) else ""), 1,120).
     4848       run foreach in this-procedure .
     4849   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     4850     (input  gds-zap-b-code
     4851     ,input  ?
     4852     ,output v-bar-code
     4853     )  .
     4854   s-bar-code = string (v-bar-code,"999999999").
     4855       If  break_group = true  and par-3 <> "1"  then DO :
     4856            FIND FIRST clients WHERE clients.obj-type = gds-zap-prod-type AND clients.obj-code = gds-zap-prod-code use-index pi NO-LOCK .
     4857            gds-zap-prod-name  = clients.obj-name.
     4858             If break_group1 = true  THEN  DO :
     4859               if (par-3 = "3"  OR  par-3 = "5" ) and  par-3 <> "6"
     4860                 then DO: Assign temp-str = string("ГРУППА : " + gds-zap-grp-name )         b1-name = gds-zap-grp-name . end.
     4861                 else DO: Assign temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name ) b1-name = gds-zap-prod-name. end.
     4862               if par-3 = "6"  then  dO:
     4863                  if xTog-obj = true then do:
     4864                   var-vat-pc = (func-vat(gds-obj.gds-code,gds-obj.obj-type,gds-obj.obj-code)) .
     4865                   end.
     4866                  else do:
     4867                   var-vat-pc = temp-gds-list.vat-pc  .
     4868                   end.
     4869                   assign
     4870                       temp-str = string( "СТАВКА НДС : " + string(var-vat-pc) + "%" )
     4871                       b1-name = temp-str .
     4872                   end.
     4873               if NOT xSumsOnly or (par-3 = "4" Or par-3 = "5" ) THEN DO :
     4874                   fr0 = true .
     4875                   tmp#stroka0 = temp-str.
     4876               End .
     4877             End .
     4878             IF (par-3 = "4"  OR  par-3 = "5")  THEN DO :
     4879               if par-3 = "4"
     4880                 then Assign temp-str = string("ГРУППА : " + gds-zap-grp-name )          b2-name = gds-zap-grp-name  .
     4881                 else Assign temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name )  b2-name = gds-zap-prod-name .
     4882               if NOT xSumsOnly THEN DO :
     4883               fr = true .
     4884               End.
     4885               break_group1 = false.
     4886             END.
     4887          break_group = false.
     4888       End.
     4889       run display-line in this-procedure .
     4890    end procedure.
     4891   procedure b1-null-str-pr :
     4892    if (
     4893        b1-oborot-im                 [1] = 0 and
     4894        b1-oborot-wm                 [1] = 0 and
     4895        b1-oborot-em                 [1] = 0 and
     4896        b1-oborot-ie                 [1] = 0 and
     4897        b1-oborot-ee                 [1] = 0 and
     4898        b1-oborot-ep              [1] = 0 and
     4899        b1-oborot-es            [1] = 0 and
     4900        b1-oborot-re             [1] = 0 and
     4901        b1-oborot-rs        [1] = 0 and
     4902        b1-oborot-we                 [1] = 0 and
     4903        b1-oborot-vt                       [1] = 0 and
     4904        b1-oborot-iv                [1] = 0 and
     4905        b1-oborot-ev                [1] = 0 and
     4906        b1-oborot-rv            [1] = 0 and
     4907        b1-oborot-ot                 [2] = 0 and
     4908        b1-oborot-ap           [1] = 0 and
     4909        b1-oborot-pc           [1] = 0 and
     4910        b1-ostatok-end[1]                                    = 0 and
     4911        b1-ostatok-start[1]                                  = 0 and
     4912        b1-oborot-im                 [2] = 0 and
     4913        b1-oborot-wm                 [2] = 0 and
     4914        b1-oborot-em                 [2] = 0 and
     4915        b1-oborot-ie                 [2] = 0 and
     4916        b1-oborot-ee                 [2] = 0 and
     4917        b1-oborot-ep              [2] = 0 and
     4918        b1-oborot-es            [2] = 0 and
     4919        b1-oborot-re             [2] = 0 and
     4920        b1-oborot-rs        [2] = 0 and
     4921        b1-oborot-we                 [2] = 0 and
     4922        b1-oborot-vt                       [2] = 0 and
     4923        b1-oborot-iv                [2] = 0 and
