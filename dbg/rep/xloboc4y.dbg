     3410   procedure display-bo  :
     3411   define variable ll as int no-undo.
     3412   define variable kk as int no-undo.
     3413     num#str# = num#str# + 1.
     3414     num#col# = 1.
     3415     run macr_excel_char_with_format( string("ИТОГО ПО ОБЪЕКТАМ")  , num#str# , num#col#  ) .
     3416     num#col#  = 0 .
     3417     if use-column[28] then assign num#col#  = num#col#  + 1 .
     3418     if use-column[1] then  assign num#col#  = num#col#  + 1 .
     3419     if use-column[2] then  assign num#col#  = num#col#  + 1 .
     3420     if use-column[3] then  assign num#col#  = num#col#  + 1 .
     3421     if use-column[4] then  assign num#col#  = num#col#  + 1 .
     3422     if use-column[5] then  assign num#col#  = num#col#  + 1 .
     3423     run macr_cell_format
     3424         ( 10    ,
     3425           true  ,
     3426           false ,
     3427           ?    ,
     3428           num#str# ,
     3429           1 ,
     3430           num#str# ,
     3431           (mp + ll + (kk * (27 - 8)))
     3432           ) .
     3433   if use-column[21] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(bo-oborot-disc [1],2 ), num#str# , num#col#   ).     end.
     3434   if use-column[23] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(bo-oborot-eff  [1],2 ), num#str# , num#col#   ).     end.
     3435   if use-column[24] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(bo-oborot-prc  [1],2 ), num#str# , num#col#   ).     end.
     3436   def var l-nk as integer no-undo .
     3437     Assign
     3438       LL = 0
     3439       KK = 1
     3440     .
     3441     if xShowCost      Then DO: KK = KK + 1. End.
     3442     if xShowCostNDS   Then DO: KK = KK + 1. End.
     3443     if xShowCrsa      Then DO: KK = KK + 1. End.
     3444     if xShowCrsaNds   Then DO: KK = KK + 1. End.
     3445     if xShowSale      Then DO: KK = KK + 1. End.
     3446     if xShowSaleNds   Then DO: KK = KK + 1. End.
     3447     if xShowSaleslt   Then DO: KK = KK + 1. End.
     3448     if xShowmediator  Then DO: KK = KK + 1. End.
     3449     if x-tog-wt       then do: KK = KK + 1. End.
     3450     if x-tog-ms       then do: KK = KK + 1. End.
     3451     if xDens          then do: KK = KK + 1. End.
     3452     repeat i = 1 to 13 :
     3453       if i = 7 then next.
     3454       if NOT xShowCost      and i = 2   Then  next.
     3455       if NOT xShowCostNDS   and i = 3   Then  next.
     3456       if NOT xShowCrsa      and i = 5   Then  next.
     3457       if NOT xShowCrsaNds   and i = 6   Then  next.
     3458       if NOT xShowSale      and i = 8   Then  next.
     3459       if NOT xShowSaleNds   and i = 9   Then  next.
     3460       if NOT xShowSaleSlt   and i = 10  Then  next.
     3461       if NOT xShowmediator  and i = 4   Then  next.
     3462       if not x-tog-wt       and i = 11  then  next.
     3463       if not x-tog-ms       and i = 12  then  next.
     3464       if not xDens          and i = 13  then  next.
     3465       assign
     3466         LL = LL + 1
     3467         l-nk = mp-1
     3468       .
     3469     if x-vat or i <> 2  then do:
     3470     if use-column[6]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bo-ostatok-start                          [i] ,  i). end.
