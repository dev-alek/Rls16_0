     3532     if use-column[18] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bo-oborot-rv      [i] -  bo-oborot-rv      [3] ),  i). end.
     3533     if use-column[19] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bo-oborot-vt                [i] -  bo-oborot-vt                [3] ),  i). end.
     3534     if use-column[20] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bo-oborot-ot           [i] -  bo-oborot-ot           [3] ),  i). end.
     3535     if use-column[22] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bo-ostatok-end                            [i] -  bo-ostatok-end                            [3] ),  i). end.
     3536     if use-column[25] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bo-oborot-ap [i] -  bo-oborot-ap[3] ),  i). end.
     3537     if use-column[26] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bo-oborot-pc [i] -  bo-oborot-pc[3] ),  i). end.
     3538     if i = 13 then do :
     3539       if use-column[27] then do: l-nk = l-nk + 1 . run ex-display in this-procedure (mp-1 + ll + (kk * (l-nk - mp))  , 0  , i ). end.
     3540     end.
     3541     else do:
     3542       if use-column[27] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,
     3543       (                                                                                      (bo-oborot-ee         [i] +
     3544                                                                                               bo-oborot-re     [i] +
     3545                                                                                               bo-oborot-es    [i] +
     3546                                                                                               bo-oborot-rs[i]) -
     3547                                                                                             (bo-oborot-ee         [3] +
     3548                                                                                               bo-oborot-re     [3] +
     3549                                                                                               bo-oborot-es    [3] +
     3550                                                                                               bo-oborot-rs[3] ) ) , i ). end.
     3551     end.
     3552     end.
     3553     end.
     3554    run new-tmp-page .
     3555   end procedure.
     3556   procedure display-b1  :
     3557   define variable ll as int no-undo.
     3558   define variable kk as int no-undo.
     3559     b1-null-str# = 1.
     3560     b1-null-str2# = 1.
     3561     if not show-negativ   then  run b1-null-str-pr   in this-procedure .
     3562     if not show-negativ-2 then  run b1-null-str-pr2  in this-procedure .
     3563      if not     ( not show-negativ   and b1-null-str#  = 0  ) then do :
     3564         if not  ( not show-negativ-2 and b1-null-str2# = 0  ) then do :
     3565                 if sums-only then do:
     3566                     if fr0 = true then do:
     3567                           num#str# = num#str# + 1     .
     3568                           num#col# = 1.
     3569                           run macr_excel_char_with_format(  caps(tmp#stroka0)  , num#str# , num#col#  ) .
     3570                           run macr_cell_format
     3571                           ( 10    ,
     3572                             true  ,
     3573                             true  ,
     3574                             36    ,
     3575                             num#str# ,
     3576                             num#col# ,
     3577                             num#str# ,
     3578                             5 ) .
     3579                         fr0 = false .
     3580                       end.
     3581                  end.
     3582     num#str# = num#str# + 1     .
     3583     num#col# = 2 .
     3584     if substitute( "&1", sf1:screen-value )  <> "?" then
     3585       run macr_excel_char_with_format(  string(s-bar-code +
     3586                                    sf1:screen-value +
     3587                                    gds-zap-artic +
     3588                                    sf2:screen-value +
     3589                                    gds-zap-gds-name +
     3590                                    temp-str-2    )  , num#str# , num#col#  ) .
     3591      else
     3592       run macr_excel_char_with_format(  string(s-bar-code +
     3593                                    gds-zap-artic +
     3594                                    gds-zap-gds-name +
     3595                                    temp-str-2    )  , num#str# , num#col#  ) .
     3596     num#col#  = 0 .
     3597     if use-column[28] then assign num#col#  = num#col#  + 1 .
     3598     if use-column[1] then  assign num#col#  = num#col#  + 1 .
     3599     if use-column[2] then  assign num#col#  = num#col#  + 1 .
     3600     if use-column[3] then  assign num#col#  = num#col#  + 1 .
     3601     if use-column[4] then  assign num#col#  = num#col#  + 1 .
     3602     if use-column[5] then  assign num#col#  = num#col#  + 1 .
     3603   if use-column[21] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(b1-oborot-disc [1],2 ), num#str# , num#col#   ).     end.
     3604   if use-column[23] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(b1-oborot-eff  [1],2 ), num#str# , num#col#   ).     end.
     3605   if use-column[24] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(b1-oborot-prc  [1],2 ), num#str# , num#col#   ).     end.
     3606   def var l-nk as integer no-undo .
     3607     Assign
     3608       LL = 0
     3609       KK = 1
     3610     .
     3611     if xShowCost      Then DO: KK = KK + 1. End.
     3612     if xShowCostNDS   Then DO: KK = KK + 1. End.
     3613     if xShowCrsa      Then DO: KK = KK + 1. End.
     3614     if xShowCrsaNds   Then DO: KK = KK + 1. End.
     3615     if xShowSale      Then DO: KK = KK + 1. End.
     3616     if xShowSaleNds   Then DO: KK = KK + 1. End.
     3617     if xShowSaleslt   Then DO: KK = KK + 1. End.
     3618     if xShowmediator  Then DO: KK = KK + 1. End.
     3619     if x-tog-wt       then do: KK = KK + 1. End.
     3620     if x-tog-ms       then do: KK = KK + 1. End.
     3621     if xDens          then do: KK = KK + 1. End.
     3622     repeat i = 1 to 13 :
     3623       if i = 7 then next.
     3624       if NOT xShowCost      and i = 2   Then  next.
     3625       if NOT xShowCostNDS   and i = 3   Then  next.
     3626       if NOT xShowCrsa      and i = 5   Then  next.
     3627       if NOT xShowCrsaNds   and i = 6   Then  next.
     3628       if NOT xShowSale      and i = 8   Then  next.
     3629       if NOT xShowSaleNds   and i = 9   Then  next.
     3630       if NOT xShowSaleSlt   and i = 10  Then  next.
     3631       if NOT xShowmediator  and i = 4   Then  next.
     3632       if not x-tog-wt       and i = 11  then  next.
     3633       if not x-tog-ms       and i = 12  then  next.
     3634       if not xDens          and i = 13  then  next.
     3635       assign
     3636         LL = LL + 1
     3637         l-nk = mp-1
     3638       .
     3639     if x-vat or i <> 2  then do:
     3640     if use-column[6]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , b1-ostatok-start                          [i] ,  i). end.
     3641     if use-column[7]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , b1-oborot-ie          [i] ,  i). end.
     3642     if use-column[8]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , b1-oborot-iv          [i] ,  i). end.
     3643     if use-column[9]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , b1-oborot-im           [i] ,  i). end.
     3644     if use-column[10] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , b1-oborot-ee          [i] ,  i). end.
     3645     if use-column[11] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , b1-oborot-ev          [i] ,  i). end.
     3646     if use-column[12] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , b1-oborot-em           [i] ,  i). end.
     3647     if use-column[13] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , b1-oborot-we          [i] ,  i). end.
     3648     if use-column[14] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , b1-oborot-es     [i] ,  i). end.
     3649     if use-column[15] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , b1-oborot-rs [i] ,  i). end.
     3650     if use-column[16] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , b1-oborot-re      [i] ,  i). end.
     3651     if use-column[17] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , b1-oborot-ep       [i] ,  i). end.
     3652     if use-column[18] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , b1-oborot-rv      [i] ,  i). end.
     3653     if use-column[19] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , b1-oborot-vt                [i] ,  i). end.
     3654     if use-column[20] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , b1-oborot-ot           [i] ,  i). end.
     3655     if use-column[22] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , b1-ostatok-end                            [i] ,  i). end.
     3656     if use-column[25] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , b1-oborot-ap [i] ,  i). end.
     3657     if use-column[26] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , b1-oborot-pc [i] ,  i). end.
     3658     if i = 13 then do:
     3659       if "b1-" = "b1-" or "b1-" = "b2-" or "b1-" = "bi-" or "b1-" = "bo-" then do:
     3660          if use-column[27] then do: l-nk = l-nk + 1 .  run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , 0 ,  i). end.
     3661       end.
     3662       else do:
     3663         if use-column[27] then do: l-nk = l-nk + 1 .  run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , ( if ABS(b1-oborot-ee         [1] +
     3664                                                                                                                                       b1-oborot-re     [1] +
     3665                                                                                                                                       b1-oborot-es    [1] +
     3666                                                                                                                                       b1-oborot-rs[1] ) <> 0
     3667                                                                                                                               then
     3668                                                                                                                                   ABS(b1-oborot-ee         [11] +
     3669                                                                                                                                       b1-oborot-re     [11] +
     3670                                                                                                                                       b1-oborot-es    [11] +
     3671                                                                                                                                       b1-oborot-rs[11] )
     3672                                                                                                                                   /
     3673                                                                                                                                   ABS(b1-oborot-ee         [1] +
     3674                                                                                                                                       b1-oborot-re     [1] +
     3675                                                                                                                                       b1-oborot-es    [1] +
     3676                                                                                                                                       b1-oborot-rs[1] )
     3677                                                                                                                               else 0 )
     3678         ,  i). end.
     3679       end.
     3680     end.
     3681     else do:
     3682     if use-column[27] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , (b1-oborot-ee         [i] +
     3683                                                                                                                           b1-oborot-re     [i] +
     3684                                                                                                                           b1-oborot-es    [i] +
     3685                                                                                                                           b1-oborot-rs[i] )
     3686     ,  i). end.
     3687     end.
     3688     end.
     3689     if x-vat = false  and i = 2 then do:
     3690     if use-column[6]  then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b1-ostatok-start                          [i] -  b1-ostatok-start                          [3] ),  i). end.
     3691     if use-column[7]  then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b1-oborot-ie          [i] -  b1-oborot-ie          [3] ),  i). end.
     3692     if use-column[8]  then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b1-oborot-iv          [i] -  b1-oborot-iv          [3] ),  i). end.
     3693     if use-column[9]  then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b1-oborot-im           [i] -  b1-oborot-im           [3] ),  i). end.
     3694     if use-column[10] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b1-oborot-ee          [i] -  b1-oborot-ee          [3] ),  i). end.
     3695     if use-column[11] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b1-oborot-ev          [i] -  b1-oborot-ev          [3] ),  i). end.
     3696     if use-column[12] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b1-oborot-em           [i] -  b1-oborot-em           [3] ),  i). end.
     3697     if use-column[13] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b1-oborot-we          [i] -  b1-oborot-we          [3] ),  i). end.
     3698     if use-column[14] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b1-oborot-es     [i] -  b1-oborot-es     [3] ),  i). end.
     3699     if use-column[15] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b1-oborot-rs [i] -  b1-oborot-rs [3] ),  i). end.
     3700     if use-column[16] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b1-oborot-re      [i] -  b1-oborot-re      [3] ),  i). end.
     3701     if use-column[17] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b1-oborot-ep       [i] -  b1-oborot-ep       [3] ),  i). end.
     3702     if use-column[18] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b1-oborot-rv      [i] -  b1-oborot-rv      [3] ),  i). end.
     3703     if use-column[19] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b1-oborot-vt                [i] -  b1-oborot-vt                [3] ),  i). end.
     3704     if use-column[20] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b1-oborot-ot           [i] -  b1-oborot-ot           [3] ),  i). end.
     3705     if use-column[22] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b1-ostatok-end                            [i] -  b1-ostatok-end                            [3] ),  i). end.
     3706     if use-column[25] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b1-oborot-ap [i] -  b1-oborot-ap[3] ),  i). end.
     3707     if use-column[26] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b1-oborot-pc [i] -  b1-oborot-pc[3] ),  i). end.
     3708     if i = 13 then do :
     3709       if use-column[27] then do: l-nk = l-nk + 1 . run ex-display in this-procedure (mp-1 + ll + (kk * (l-nk - mp))  , 0  , i ). end.
     3710     end.
     3711     else do:
     3712       if use-column[27] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,
     3713       (                                                                                      (b1-oborot-ee         [i] +
     3714                                                                                               b1-oborot-re     [i] +
     3715                                                                                               b1-oborot-es    [i] +
