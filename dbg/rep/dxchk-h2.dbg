       80   define  stream PrnLibStream.
       81   procedure prn-lib-prn-file :
       82     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
       83     define input parameter p-DIsabledoptions as integer no-undo .
       84     define variable v-report-name as character no-undo .
       85     define variable v-user-action as character no-undo .
