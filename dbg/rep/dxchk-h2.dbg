      560     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      561     .
      562   define new global shared variable mBatchMode as logical no-undo init ?.
      563   define variable mFramBachModHandle as handle no-undo.
      564   mFramBachModHandle = frame waitfram:handle.
      565   define variable mFameOldVis as logical no-undo.
      566   define variable mVisCUrentVin as logical no-undo.
      567   if session:batch-mode
      568   then
      569      mBatchMode = yes.
      570   if mBatchMode = ? then do:
      571     mVisCUrentVin = current-window:visible.
      572     mFameOldVis = mFramBachModHandle:visible.
      573     mFramBachModHandle:visible  = yes.
      574     mBatchMode = mFramBachModHandle:visible ne yes.
      575     mFramBachModHandle:visible = mFameOldVis.
      576     current-window:visible = mVisCUrentVin.
      577   end.
      578    if  log-manager:logfile-name ne ?
      579     then DO:
      580         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      581         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      582         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      583     end.
      584   on choose of B-WaitFramStop in frame waitfram
      585   do:
      586     mWaitFramStop = yes.
      587     mWaitFramStopUser = yes.
      588   end.
      589   function waitfram-check-timeout returns logical():
      590      define variable vtime as int64 no-undo.
      591      if mWaitFramStopTimeOut
      592      then
      593         return yes.
      594      vtime = ( now - mWaitFramStartProc ) / 1000 .
      595      if     mWaitFramTimeOut ne ?
      596         and mWaitFramTimeOut ne 0
      597         and mWaitFramTimeOut lt vtime
      598      then do:
      599         mWaitFramStopTimeOut = yes.
      600      end.
      601      return mWaitFramStopTimeOut.
      602   end.
      603   procedure waitfram-hide :
      604     if not session:batch-mode
      605     then do
      606     on error undo, return error return-value
      607     :
      608       pause 0 before-hide .
      609       if not mBatchMode then
      610         hide frame waitfram .
      611     if     not mWaitFramView
      612        and mWaitProcEvent
      613     then
      614       process events .
      615     end.
      616   end procedure.
      617   procedure waitfram-show :
      618     define input  parameter p-message as character no-undo .
      619     define variable v-left-margin as integer   no-undo .
      620     if not session:batch-mode
      621     then do
      622     on error undo, return error return-value
      623     :
      624       if length(p-message) <= 70 then do:
      625         assign
      626           v-left-margin = integer((70 - length(p-message)) / 2)
      627         .
      628         assign
      629           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      630         .
      631         assign
      632           v-waitfram-action01 = " "
      633           v-waitfram-action02 = " "
      634                                    + fill(" ", v-left-margin)
      635                                    + p-message
      636           v-waitfram-action03 = " "
      637         .
      638       end.
      639       else do:
      640         define variable vRindex1 as integer no-undo.
      641         define variable vRindex2 as integer no-undo.
      642         vRindex1 = r-index(p-message," ",70).
      643         if vRindex1 = 0
      644         then
      645            vRindex1 = 70.
      646         if length(p-message)  <= vRindex1 + 70 then do:
      647           assign
      648             v-waitfram-action01 = " "
      649             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      650             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      651           .
      652         end.
      653         else do:
      654           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      655           if vRindex2 <= vRindex1
      656           then
      657              vRindex2 = vRindex1 + 70.
      658           assign
      659             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      660             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      661             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      662           .
      663         end.
      664       end.
      665       B-viewProcInfo:visible   in frame waitfram = no.
      666       B-viewProcInfo:sensitive in frame waitfram = no.
      667       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      668       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      669       if  (   mWaitFramView
      670          or  mWaitProcEvent)
      671          and not mBatchMode
      672       then
      673          display
      674             v-waitfram-action01 skip
      675             v-waitfram-action02 skip
      676             v-waitfram-action03 skip
      677          with frame waitfram .
      678       if     mWaitFramView
      679          then do:
      680             if     mWaitFramInterval ne ?
      681                and not mBatchMode
      682             then
      683                wait-for go of frame waitfram pause mWaitFramInterval.
      684          end.
      685          else
      686             if     mWaitProcEvent
      687                and not mBatchMode
      688             then
      689                process events .
      690     end.
      691   end procedure.
      692      procedure waitfram-show-this:
      693         define input  parameter iInterval as int64 no-undo.
      694         define variable vtime as int64 no-undo.
      695         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      696         mWaitFramInterval = iInterval.
      697         run waitfram-show (substitute("&1&2 &3&4" ,
      698                                       mWaitFramTextBeg ,
      699                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      700                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      701                                       mWaitFramTextEnd
      702                                      )
      703                           ).
      704      end.
      705      procedure WaitFramRunPause:
      706         define input  parameter iInterval as dec no-undo.
      707         define variable vStart  as datetime-tz no-undo.
      708         define variable vend    as datetime-tz no-undo.
      709         define variable vint as int64 no-undo.
      710         define variable vOk as logical no-undo.
      711         vStart = now.
      712         vend   = vStart.
      713         publish "WaitFramPause" (iInterval,output vOk).
      714         vend   =  now.
      715         vint = vend - vStart.
      716         vint = iInterval - vint / 1000.
      717         if     not mWaitFramStop
      718            and (   vint > 0
      719                 or (    not vOk
      720                     and iInterval eq ?
      721                     )
      722                 )
      723         then
      724            run waitfram-show-this (iInterval).
      725         vend   =  now.
      726         vint = vend - vStart.
      727         vint = iInterval - vint / 1000.
      728         if     not mWaitFramStop
      729            and vint > 0
      730         then do:
      731            run gbl/pause.p (vint * 1000).
      732         end.
      733         if iInterval ne ?
      734         then
      735            publish "WaitFramStop".
      736         waitfram-check-timeout().
      737      end.
      738      procedure WaitFramWaitFor:
      739         define input  parameter iInterval as dec no-undo.
      740         assign
      741            mWaitFramStartProc   = now
      742            mWaitFramStopUser    = no
      743            mWaitFramStopTimeOut = no
      744         .
      745         block-wait:
      746         do while not mWaitFramStop:
      747            run WaitFramRunPause (iInterval).
      748            if  waitfram-check-timeout()
      749            then do:
      750               leave block-wait.
      751            end.
      752         end.
      753         run waitfram-hide.
      754      end.
      755   procedure waitfram-join :
      756     define input  parameter p-line-1  as character no-undo .
      757     define input  parameter p-line-2  as character no-undo .
      758     define input  parameter p-line-3  as character no-undo .
      759     define output parameter p-message as character no-undo .
      760     do
      761     on error undo, return error return-value
      762     :
      763       assign
      764         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      765                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      766                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      767       .
      768     end.
      769   end procedure.
      770   function waitfram-join-function returns character
      771     (input p-line-1 as character
      772     ,input p-line-2 as character
      773     ,input p-line-3 as character
      774     ).
      775     define variable v-message as character no-undo .
      776     run waitfram-join in this-procedure
      777       (input  p-line-1
      778       ,input  p-line-2
      779       ,input  p-line-3
      780       ,output v-message
      781       ) .
      782     return v-message .
      783   end function .
      784   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      785   DEFINE SHARED temp-table chk-h no-undo
      786      field grp-code like ub.goods.grp-code
      787       field obj-code like ub.clients.obj-code
      788       field hour  as integer extent 24
      789       field qnty  as integer
      790       INDEX pi IS PRIMARY obj-code grp-code ASCENDING .
      791   DEFINE SHARED temp-table num-h no-undo
      792       field obj-code like ub.clients.obj-code
      793       field hour  as integer extent 24
      794       field qnty  as integer
      795       INDEX pi IS PRIMARY obj-code  ASCENDING .
      796   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      797   DEFINE  temp-table full-grp no-undo
      798       field grp-code like ub.gds-grp.node-code
      799       field full-name like ub.goods.grp-name
      800       field other-code as integer
      801       INDEX i1 full-name ASCENDING
      802       INDEX i2
      803       grp-code other-code
      804         .
      805   define variable vss-include-info8 as character format "X(65)" no-undo
      806   initial "@(#)$Workfile$ $Revision$".
      807   procedure grplib-get-full-name :
      808      define input parameter p-node-code  as integer      no-undo.
      809      define output parameter p-full-name as character    no-undo.
      810      do
      811   on error undo, return error
      812   :
      813       define variable v-upper-code    as integer           no-undo.
      814       define buffer buf_gds-grp       for ub.gds-grp.
      815       define buffer buf_upper_gds-grp for ub.gds-grp.
      816       find first buf_gds-grp no-lock
      817            where buf_gds-grp.node-code = p-node-code
      818       no-error.
      819       if not available buf_gds-grp
      820       then do:
      821           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      822       end.
      823       assign
      824           p-full-name  = ""
      825           v-upper-code = 1
      826       .
      827       do while buf_gds-grp.upper-code <> 0
      828       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
      829       :
      830           assign
      831               p-full-name  = buf_gds-grp.node-name
      832                            + (if p-full-name <> "" then chr(47) else "")
      833                            + p-full-name
      834               v-upper-code = buf_gds-grp.upper-code
      835           .
      836           find first buf_gds-grp no-lock
      837                where buf_gds-grp.node-code = v-upper-code
      838           no-error.
      839           if not available buf_gds-grp
      840           then do:
      841               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
      842                                   + string( v-upper-code )
      843                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      844           end.
      845       end.
      846       assign
      847       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      848       .
      849   end.
      850   end .
      851   procedure grplib-get-node-from-full-name :
      852   define input parameter p-full-name as character no-undo .
      853   define output parameter p-node-code as integer no-undo .
      854   define variable v-ii as integer no-undo .
      855   define variable v-upper-code as integer no-undo .
      856   define variable v-root-code as integer no-undo .
      857   define variable v-entry as character no-undo .
      858   define buffer buf_gds-grp       for ub.gds-grp.
      859   do
      860   on error undo, return error
      861   :
      862     find first buf_gds-grp no-lock
      863         where buf_gds-grp.upper-code = 0
      864     no-error .
      865     if not available buf_gds-grp
      866     then do:
      867         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
      868     end.
      869     else do:
      870       assign
      871       v-root-code = buf_gds-grp.node-code
      872       .
      873     end.
      874     v-upper-code = v-root-code.
      875     do v-ii = 1 to num-entries(p-full-name, chr(47)):
      876       assign
      877       v-entry = entry(v-ii, p-full-name, chr(47)).
      878       if v-entry = '' then leave.
      879       find first buf_gds-grp no-lock where
      880                 buf_gds-grp.node-name = v-entry
      881             and buf_gds-grp.upper-code = v-upper-code
      882             no-error.
      883       if not available buf_gds-grp then do:
      884         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
      885       end.
      886       else do:
      887         p-node-code = buf_gds-grp.node-code.
      888         v-upper-code = buf_gds-grp.node-code.
      889       end.
      890     end.
      891   end.
      892   end .
      893   define SHARED temp-table temp-dis-card-type no-undo like dis-card-type.
      894   define   shared variable Use-column   as logical extent 256 no-undo .
      895   define buffer b-chk-h for chk-h .
      896   define buffer for-grp for ub.gds-grp.
      897   define variable ii as int     no-undo .
      898   define variable kk as int     no-undo .
      899   define variable cycle as integer no-undo .
      900   define variable cycle1 as integer no-undo .
      901   define variable accum-hour as decimal no-undo extent 24.
      902   define variable accum-qnty as decimal no-undo .
      903   define variable byobject as logical no-undo .
      904   define variable accum-obj-list as integer no-undo .
      905   define variable v-obj-code like ub.clients.obj-code no-undo .
      906   define variable v-obj-name like ub.clients.obj-name no-undo .
      907   define variable obj-count as integer no-undo .
      908   define variable v-title as character no-undo .
      909   define buffer cli-obj for ub.clients .
      910   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      911   run waitfram-show in this-procedure ("Строю дерево групп ...").
      912   if rs-option = 3 then do:
      913     create full-grp.
      914     assign
      915     full-grp.grp-code = 0
      916     full-grp.full-name = "По всем группам товаров".
      917   end.
      918   else do:
      919     for each ub.gds-grp no-lock:
      920       find first for-grp where
      921                 for-grp.upper-code = ub.gds-grp.node-code No-LOCK No-ERROR.
      922       if not avail for-grp then do:
      923         create full-grp.
      924         assign full-grp.grp-code = ub.gds-grp.node-code.
      925         run grplib-get-full-name in this-procedure(input ub.gds-grp.node-code, output full-grp.full-name).
      926       end.
      927     end.
      928   end.
      929   run waitfram-hide in this-procedure .
      930   byobject = (if rs-option = 2 or rs-option = 3 then yes else no).
      931   run prn-lib-open-stream  in this-procedure (
      932                                                input parParentProc
      933                                               ,input 62
      934                                               ,input yes
      935                                               ,input no
      936                                               ).
      937   PUT stream PrnLibStream UNFORMATTED
      938       "Почасовая статистика по количеству ПОКУПОК ЗА ПЕРИОД c " +
      939       string( startdate, "99/99/9999" ) + " по " + string( enddate, "99/99/9999" ) + "."      format "x(110)" SKIP(1).
      940   if t-dis-card then do:
      941     PUT stream PrnLibStream UNFORMATTED
      942     "Только покупки по дисконтным картам" skip.
      943     if rs-dis-card = 1 then do:
