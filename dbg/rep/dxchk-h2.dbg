      224   procedure prn-lib-reportviewer :
      225     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      226     define input parameter p-report-name-html as character no-undo .
      227     define input parameter p-param        as character no-undo .
      228     define variable v-excel           as character no-undo init 'TRUE' .
      229     define variable v-value-character as character no-undo .
      230     define variable v-value-integer   as character no-undo .
      231     define variable v-value-date      as date      no-undo .
      232     define variable v-value-decimal   as decimal   no-undo .
      233     define variable rep-excel         as logical   no-undo .
      234     define variable excel-string      as character no-undo .
      235     define variable v-param-type      as character no-undo .
      236     define variable v-tth             as handle    no-undo .
      237     run adm/shattri.p (
      238       input "get":U
      239       ,input  ""
      240       ,input  0
      241       ,input  'report-glob':U
      242       ,input  'rep-excel':U
      243       ,output v-value-character
      244       ,output v-value-date
      245       ,output v-value-decimal
      246       ,output v-value-integer
      247       ,output rep-excel
      248       ,output v-param-type
      249       ,INPUT-OUTPUT table-handle v-tth
      250       )  .
      251     if rep-excel then v-excel = "TRUE" .
      252     else v-excel = "FALSE" .
      253     if p-param eq ""
      254     then
      255        p-param = "EXCEL:" + v-excel.
      256     else
      257        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      258     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      259   end procedure.
      260   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      261   procedure cur-time :
      262      define output parameter p-today as date      no-undo .
      263      define output parameter p-time  as integer   no-undo .
      264     do
      265     on error undo, return error
      266     :
      267       define variable v-date1 as date      no-undo .
      268       define variable v-date2 as date      no-undo .
      269       define variable v-time  as integer   no-undo .
      270       assign
      271         v-date1 = today
      272         v-time  = time
      273         v-date2 = today
      274       .
      275       if v-date1 <> v-date2
      276       then do:
      277         assign
      278           v-date1 = today
      279           v-time  = v-time
      280         .
      281       end.
      282       assign
      283         p-today = v-date1
      284         p-time  = v-time
      285       .
      286     end.
      287   end.
      288   function cur-time-date returns character
      289   :
      290     return string(today, '99/99/9999':U) .
      291   end.
      292   function cur-time-mjd returns decimal
      293   :
      294     define variable v-date as date      no-undo .
      295     define variable v-time as integer   no-undo .
      296     run cur-time in this-procedure
      297       (output v-date
      298       ,output v-time
      299       ) .
      300     return integer(v-date) - 2400002 + (v-time / 86400) .
      301   end.
      302   function cur-time-get-ending-index returns integer
      303   (input p-number as integer
      304   )
      305   :
      306     if p-number < 0
      307     or p-number = ?
      308     then do:
      309       return 1 .
      310     end.
      311     define variable v-rest as integer   no-undo .
      312     assign
      313       p-number = p-number modulo 100
      314     .
      315     if p-number < 20
      316     then do:
      317       assign
      318         v-rest = p-number
      319       .
      320     end.
      321     else do:
      322       assign
      323         v-rest = p-number modulo 10
      324       .
      325     end.
      326     case v-rest :
      327       when 1
      328       then do:
      329         return 2 .
      330       end.
      331       when 2 or
      332       when 3 or
      333       when 4
      334       then do:
      335         return 3 .
      336       end.
      337       otherwise do:
      338         return 1 .
      339       end.
      340     end case .
      341   end.
      342   procedure cur-time-mjd-to-date :
      343      define input  parameter i-mjd-diff as decimal no-undo.
      344      define output parameter o-Date     as date    no-undo.
      345      define output parameter o-Time     as integer no-undo.
      346      define variable v-day-number as integer   no-undo .
      347      if    i-mjd-diff < 0
      348         or i-mjd-diff = ?
      349      then do:
      350         return "?" .
      351      end.
      352      assign
      353         v-day-number = truncate(i-mjd-diff,0).
      354         o-Date = date(v-day-number + 2400002).
      355         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      356     .
      357   end.
      358   function cur-time-mjd-to-string returns character
      359   (input p-mjd-diff as decimal
      360   )
      361   :
      362     define variable v-day-number as integer   no-undo .
      363     define variable v-seconds    as integer   no-undo .
      364     define variable v-hour       as integer   no-undo .
      365     define variable v-min        as integer   no-undo .
      366     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      367     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      368     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      369     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      370     if p-mjd-diff < 0
      371     or p-mjd-diff = ?
      372     then do:
      373       return "?" .
      374     end.
      375     assign
      376       v-day-number = integer(truncate(p-mjd-diff,0))
      377       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      378     .
      379     if v-seconds > 86400
      380     then do:
      381       assign
      382         v-seconds = 86400 - 1
      383       .
      384     end.
      385     if v-seconds < 0
      386     then do:
      387       assign
      388         v-seconds = 0
      389       .
      390     end.
      391     assign
      392       v-hour = truncate(v-seconds / 3600, 0)
      393     .
      394     assign
      395       v-seconds = v-seconds modulo 3600
      396     .
      397     assign
      398       v-min = truncate(v-seconds / 60, 0)
      399     .
      400     assign
      401       v-seconds = v-seconds modulo 60
      402     .
      403     return
      404         (if v-day-number <> 0
      405           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      406           else ""
      407         )
      408       + (if v-day-number <> 0 or v-hour <> 0
      409           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      410           else ""
      411         )
      412       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      413           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      414           else ""
      415         )
      416       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      417       .
      418   end.
      419   function cur-time-string returns character
      420   :
      421     define variable v-date as date      no-undo .
      422     define variable v-time as integer   no-undo .
      423     run cur-time in this-procedure
      424       (output v-date
      425       ,output v-time
      426       ) .
      427     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      428   end.
      429   function cur-time-string-sec returns character
      430   :
      431     define variable v-date as date      no-undo .
      432     define variable v-time as integer   no-undo .
      433     run cur-time in this-procedure
      434       (output v-date
      435       ,output v-time
      436       ) .
      437     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      438   end.
      439   function cur-time-custom  returns character
      440   (input p-prefix as character
      441   ,input p-date-format as character
      442   ,input p-delimiter as character
      443   ,input p-time-format as character
      444   ,input p-suffix as character
      445   )
      446   :
      447     define variable v-date as date      no-undo .
      448     define variable v-time as integer   no-undo .
      449     run cur-time in this-procedure
      450       (output v-date
      451       ,output v-time
      452       ) .
      453     return
      454       p-prefix
      455       + string(v-date, p-date-format)
      456       + p-delimiter
      457       + string(v-time, p-time-format)
      458       + p-suffix
      459       .
      460   end.
      461   function cur-time-print  returns character
      462   :
      463     define variable v-date as date      no-undo .
      464     define variable v-time as integer   no-undo .
      465     run cur-time in this-procedure
      466       (output v-date
      467       ,output v-time
      468       ) .
      469     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      470   end.
      471   function cur-time-datetime returns datetime
      472   :
      473     define variable v-char as character no-undo .
      474     define variable v-datetime as datetime no-undo .
      475     v-char = cur-time-string().
      476     v-datetime = datetime(v-char).
      477     return  v-datetime.
      478   end.
      479   function cur-time-string-msec returns character
      480   :
      481     define variable v-date as datetime  no-undo .
      482     v-date = now.
      483     return string(v-date) .
      484   end.
      485   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      486   def
      487    shared
      488   temp-table  obj-list no-undo
      489     field obj-type like ub.clients.obj-type
      490     field obj-code like ub.clients.obj-code
      491     field obj-name like ub.clients.obj-name
      492     field obj-id   as integer
      493     field db-num   as integer
      494     index pi is primary unique obj-id
      495     index ie1 obj-type obj-code
      496     index ie2 obj-name
      497   .
      498   procedure create_obj-list :
      499      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      500      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      501      do
      502      on error undo, return error return-value
      503      :
      504         define buffer cli-obj for ub.clients .
      505         define variable p-var as integer no-undo .
      506         define buffer buf_obj-list for obj-list .
      507         find last buf_obj-list  use-index pi no-error .
      508         if available buf_obj-list
      509         then
      510            p-var = buf_obj-list.obj-id + 1.
      511         else
      512            p-var = 1.
      513         find first cli-obj where
      514                   cli-obj.obj-type = p-obj-type
      515               and cli-obj.obj-code = p-obj-code
      516         no-lock no-error.
      517         if available cli-obj
      518         then do:
      519            create buf_obj-list.
      520            assign
      521               buf_obj-list.obj-id   = p-var
      522               buf_obj-list.obj-code = cli-obj.obj-code
      523               buf_obj-list.obj-type = cli-obj.obj-type
      524               buf_obj-list.obj-name = cli-obj.obj-name
      525               buf_obj-list.db-num   = cli-obj.db-num
      526            .
      527         end.
      528      end.
      529   end.
