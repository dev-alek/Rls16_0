      553        size 15 by 1 tooltip "Информация о процесс".
      554   define frame waitfram
      555     v-waitfram-action01 format "x(72)" no-label skip
      556     v-waitfram-action02 format "x(72)" no-label skip
      557     v-waitfram-action03 format "x(72)" no-label skip
      558     B-viewProcInfo
