     1031   PUT stream PrnLibStream
     1032   "Итого_по_строке" p-XL-delim skip.
     1033   _cycle:
     1034   do cycle = 1 to 0 by -1:
     1035     if byobject and cycle = 0 and accum-obj-list = 1 then LEAVE _cycle.
     1036     _obj-list:
     1037     for each obj-list no-lock:
     1038       obj-count = obj-count + 1.
     1039       if not byobject and cycle = 1 then LEAVE _obj-list.
     1040       if cycle = 1 then v-obj-code = obj-list.obj-code.
     1041       if cycle = 0 then v-obj-code = 0.
     1042       if cycle = 1 then do:
     1043         FIND FIRST ub.clients NO-LOCK WHERE
     1044                   ub.clients.obj-code = v-obj-code AND
     1045                   ub.clients.obj-type = 'маг':U NO-ERROR.
     1046         if available ub.clients then do:
     1047           v-obj-name = replace(ub.clients.obj-name, chr(32), "_").
     1048         end.
     1049         else v-obj-name = string(v-obj-code).
     1050       end.
     1051       if byobject and cycle = 0 then do:
     1052         v-obj-name = "ПО_ВСЕМ_ОБЪЕКТАМ".
     1053       end.
     1054       if rs-option <> 3 and byobject then do:
     1055         PUT STREAM PrnLibStream UNFORMATTED
     1056         v-obj-name skip.
     1057       end.
     1058       assign
     1059       accum-hour[1]  = 0
     1060       accum-hour[2]  = 0
     1061       accum-hour[3]  = 0
     1062       accum-hour[4]  = 0
     1063       accum-hour[5]  = 0
     1064       accum-hour[6]  = 0
     1065       accum-hour[7]  = 0
     1066       accum-hour[8]  = 0
     1067       accum-hour[9]  = 0
     1068       accum-hour[10] = 0
     1069       accum-hour[11] = 0
     1070       accum-hour[12] = 0
     1071       accum-hour[13] = 0
     1072       accum-hour[14] = 0
     1073       accum-hour[15] = 0
     1074       accum-hour[16] = 0
     1075       accum-hour[17] = 0
     1076       accum-hour[18] = 0
     1077       accum-hour[19] = 0
     1078       accum-hour[20] = 0
     1079       accum-hour[21] = 0
     1080       accum-hour[22] = 0
     1081       accum-hour[23] = 0
     1082       accum-hour[24] = 0
     1083       accum-qnty     = 0
     1084       .
     1085       FOR EACH full-grp No-LOCK,
     1086       EACH chk-h NO-LOCK where
     1087            chk-h.obj-code = v-obj-code
     1088        AND chk-h.grp-code = full-grp.grp-code
     1089       BREAK
     1090       BY full-grp.full-name
     1091       BY chk-h.grp-code:
     1092         if cycle = 0 or rs-option = 2 then do:
     1093           if first-of( chk-h.grp-code ) then do:
     1094             if (chk-h.hour[1] <> 0) OR (chk-h.hour[2]<> 0) OR (chk-h.hour[3]<> 0) OR (chk-h.hour[4]<> 0) OR
     1095                 (chk-h.hour[5] <> 0) OR (chk-h.hour[6] <> 0) OR (chk-h.hour[7] <> 0) OR (chk-h.hour[8] <> 0) OR
     1096                 (chk-h.hour[9] <> 0) OR (chk-h.hour[10] <> 0) OR (chk-h.hour[11] <> 0) OR (chk-h.hour[12] <> 0) OR
     1097                 (chk-h.hour[13] <> 0) OR (chk-h.hour[14] <> 0) OR (chk-h.hour[15] <> 0) OR (chk-h.hour[16] <> 0) OR
     1098                 (chk-h.hour[17] <> 0) OR (chk-h.hour[18] <> 0) OR (chk-h.hour[19] <> 0) OR (chk-h.hour[20] <> 0) OR
     1099                 (chk-h.hour[21] <> 0) OR (chk-h.hour[22] <> 0) OR (chk-h.hour[23] <> 0) OR (chk-h.hour[24] <> 0) then do:
     1100               PUT stream PrnLibStream UNFORMATTED
     1101               FULL-NAME p-XL-delim.
     1102               do cycle1 = 1 to 24.
     1103                 if use-column[cycle1 + 1] then
     1104                   PUT stream PrnLibStream UNFORMATTED
     1105                   chk-h.hour[cycle1]     p-XL-delim.
     1106               end.
     1107               PUT stream PrnLibStream UNFORMATTED
     1108               chk-h.qnty
     1109               skip.
     1110             end.
     1111           end.
     1112         end.
     1113         assign
     1114         accum-hour[1] = accum-hour[1] + chk-h.hour[1]
     1115         accum-hour[2] = accum-hour[2] + chk-h.hour[2]
     1116         accum-hour[3] = accum-hour[3] + chk-h.hour[3]
     1117         accum-hour[4] = accum-hour[4] + chk-h.hour[4]
     1118         accum-hour[5] = accum-hour[5] + chk-h.hour[5]
     1119         accum-hour[6] = accum-hour[6] + chk-h.hour[6]
     1120         accum-hour[7] = accum-hour[7] + chk-h.hour[7]
     1121         accum-hour[8] = accum-hour[8] + chk-h.hour[8]
     1122         accum-hour[9] = accum-hour[9] + chk-h.hour[9]
     1123         accum-hour[10] = accum-hour[10] + chk-h.hour[10]
     1124         accum-hour[11] = accum-hour[11] + chk-h.hour[11]
     1125         accum-hour[12] = accum-hour[12] + chk-h.hour[12]
     1126         accum-hour[13] = accum-hour[13] + chk-h.hour[13]
     1127         accum-hour[14] = accum-hour[14] + chk-h.hour[14]
     1128         accum-hour[15] = accum-hour[15] + chk-h.hour[15]
     1129         accum-hour[16] = accum-hour[16] + chk-h.hour[16]
     1130         accum-hour[17] = accum-hour[17] + chk-h.hour[17]
     1131         accum-hour[18] = accum-hour[18] + chk-h.hour[18]
     1132         accum-hour[19] = accum-hour[19] + chk-h.hour[19]
     1133         accum-hour[20] = accum-hour[20] + chk-h.hour[20]
     1134         accum-hour[21] = accum-hour[21] + chk-h.hour[21]
     1135         accum-hour[22] = accum-hour[22] + chk-h.hour[22]
     1136         accum-hour[23] = accum-hour[23] + chk-h.hour[23]
     1137         accum-hour[24] = accum-hour[24] + chk-h.hour[24]
     1138         accum-qnty = accum-qnty + chk-h.qnty
     1139         .
     1140       end.
     1141       if rs-option = 3 then do:
     1142         v-title = v-obj-name.
     1143       end.
     1144       else do:
     1145         v-title = substitute('ИТОГО_&1', v-obj-name).
     1146       end.
     1147       PUT stream PrnLibStream UNFORMATTED
     1148       v-title           p-XL-delim.
     1149       do cycle1 = 1 to 24.
     1150         if use-column[cycle1 + 1] then
     1151           PUT stream PrnLibStream UNFORMATTED
     1152           accum-hour[cycle1]     p-XL-delim.
     1153       end.
     1154       PUT stream PrnLibStream UNFORMATTED
     1155       accum-qnty           p-XL-delim
     1156       skip.
     1157       find first num-h where num-h.obj-code = v-obj-code no-error .
     1158        v-title = substitute('Пробито_чеков_&1', v-obj-name).
     1159       if available num-h then do:
     1160         PUT stream PrnLibStream UNFORMATTED
     1161         v-title p-XL-delim.
     1162         do cycle1 = 1 to 24.
     1163           if use-column[cycle1 + 1] then
     1164             PUT stream PrnLibStream UNFORMATTED
     1165             num-h.hour[cycle1]     p-XL-delim.
     1166         end.
     1167         PUT stream PrnLibStream UNFORMATTED
     1168         num-h.qnty           p-XL-delim
     1169         skip.
     1170       end.
     1171       if cycle = 0 then LEAVE _obj-list.
     1172     end.
     1173   end.
     1174   output stream PrnLibStream CLOSE .
