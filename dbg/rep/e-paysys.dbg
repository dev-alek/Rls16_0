        1   define variable vss-revision    as character no-undo init "$Revision$":U .
        2   define variable vss-author      as character no-undo init "$Author$":U .
        3   define variable vss-date        as character no-undo init "$Date$":U .
        4   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        5   define variable vss-archive     as character no-undo init "$Archive$":U .
        6   define variable vss-description as character no-undo init "".
        7   procedure vss-get-info :
        8     define output parameter p-vss-revision    like vss-revision    no-undo .
        9     define output parameter p-vss-author      like vss-author      no-undo .
       10     define output parameter p-vss-date        like vss-date        no-undo .
       11     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       12     define output parameter p-vss-archive     like vss-archive     no-undo .
       13     define output parameter p-vss-description like vss-description no-undo .
       14     assign
       15       p-vss-revision    = vss-revision
       16       p-vss-author      = vss-author
       17       p-vss-date        = vss-date
       18       p-vss-workfile    = vss-workfile
       19       p-vss-archive     = vss-archive
       20       p-vss-description = vss-description
       21     .
       22   end procedure.
       23   procedure vss-get-parameters :
       24     define output parameter p-vss-parameters as character no-undo .
       25   end procedure.
       26   define new global shared variable g#vssrevis-logger as handle    no-undo .
       27   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       28   define variable v-vssrevis-logger                   as handle    no-undo .
       29   procedure vss-logevent :
       30     define input  parameter p-extra-paramters as character no-undo .
       31     define variable v-vssrevis-parameters as character no-undo .
       32     do
       33     on error undo, return error return-value
       34     :
       35       if  valid-handle(v-vssrevis-logger)
       36       and v-vssrevis-logger :get-signature("logevent") <> ""
       37       then do:
       38         run vss-get-parameters in this-procedure
       39           (output v-vssrevis-parameters
       40           ).
       41         run logevent in v-vssrevis-logger
       42           (input vss-workfile
       43           ,input vss-revision
       44           ,input v-vssrevis-parameters
       45           ,input p-extra-paramters
       46           ).
       47       end.
       48     end.
       49   end procedure.
       50   assign
       51     v-vssrevis-logger = g#vssrevis-logger
       52   .
       53   if  valid-handle(v-vssrevis-logger)
       54   and v-vssrevis-logger :get-signature("logevent") <> ""
       55   then do:
       56     assign
       57       v-vssrevis-logevent = true
       58     .
       59     run vss-logevent in this-procedure (input vss-description) .
       60   end.
       61   define new global shared variable g#language as character no-undo .
       62   if g#language <> '' and g#language <> 'rus':U then do:
       63     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       64   end.
       65   define new global shared variable g#library  as handle no-undo .
       66   define new global shared variable g#library2 as handle no-undo .
       67   procedure proc-alt-shift-f2:
       68     if not ibs.th.gbl.gbl-var:rcode
       69   then
       70     run gbl\inidebug.p .
       71   end.
       72   procedure proc-alt-shift-f3:
       73     run gbl/prvssinf.p
       74       ( input this-procedure
       75       ) .
       76   end.
       77   define variable v-inform-launched as logical no-undo initial false .
       78   procedure proc-alt-shift-f4:
       79     define variable v-action as character no-undo .
       80     if v-inform-launched = false then do:
       81       assign
       82         v-inform-launched = true
       83       .
       84       run gbl/d-inform.w
       85         (  input self
       86         ,  input this-procedure
       87         , output v-action
       88         ) no-error .
       89       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       90       assign
       91         v-inform-launched = false
       92       .
       93     end.
       94   end.
       95   procedure proc-alt-f1:
       96     run gbl/corrhelp.p
       97       (input this-procedure
       98       ) .
       99   end .
      100   on alt-shift-f2 anywhere do:
      101     run proc-alt-shift-f2.
      102   end.
      103   on alt-shift-f3 anywhere do:
      104     run proc-alt-shift-f3 in this-procedure .
      105   end.
      106   on alt-shift-f4 anywhere do:
      107     run proc-alt-shift-f4 in this-procedure.
      108   end.
      109   on alt-f1 anywhere do:
      110     run proc-alt-f1 in this-procedure .
      111   end.
      112   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      113   procedure cur-time :
      114      define output parameter p-today as date      no-undo .
      115      define output parameter p-time  as integer   no-undo .
      116     do
      117     on error undo, return error
      118     :
      119       define variable v-date1 as date      no-undo .
      120       define variable v-date2 as date      no-undo .
      121       define variable v-time  as integer   no-undo .
      122       assign
      123         v-date1 = today
      124         v-time  = time
      125         v-date2 = today
      126       .
      127       if v-date1 <> v-date2
      128       then do:
      129         assign
      130           v-date1 = today
      131           v-time  = v-time
      132         .
      133       end.
      134       assign
      135         p-today = v-date1
      136         p-time  = v-time
      137       .
      138     end.
      139   end.
      140   function cur-time-date returns character
      141   :
      142     return string(today, '99/99/9999':U) .
      143   end.
      144   function cur-time-mjd returns decimal
      145   :
      146     define variable v-date as date      no-undo .
      147     define variable v-time as integer   no-undo .
      148     run cur-time in this-procedure
      149       (output v-date
      150       ,output v-time
      151       ) .
      152     return integer(v-date) - 2400002 + (v-time / 86400) .
      153   end.
      154   function cur-time-get-ending-index returns integer
      155   (input p-number as integer
      156   )
      157   :
      158     if p-number < 0
      159     or p-number = ?
      160     then do:
      161       return 1 .
      162     end.
      163     define variable v-rest as integer   no-undo .
      164     assign
      165       p-number = p-number modulo 100
      166     .
      167     if p-number < 20
      168     then do:
      169       assign
      170         v-rest = p-number
      171       .
      172     end.
      173     else do:
      174       assign
      175         v-rest = p-number modulo 10
      176       .
      177     end.
      178     case v-rest :
      179       when 1
      180       then do:
      181         return 2 .
      182       end.
      183       when 2 or
      184       when 3 or
      185       when 4
      186       then do:
      187         return 3 .
      188       end.
      189       otherwise do:
      190         return 1 .
      191       end.
      192     end case .
      193   end.
      194   procedure cur-time-mjd-to-date :
      195      define input  parameter i-mjd-diff as decimal no-undo.
      196      define output parameter o-Date     as date    no-undo.
      197      define output parameter o-Time     as integer no-undo.
      198      define variable v-day-number as integer   no-undo .
      199      if    i-mjd-diff < 0
      200         or i-mjd-diff = ?
      201      then do:
      202         return "?" .
      203      end.
      204      assign
      205         v-day-number = truncate(i-mjd-diff,0).
      206         o-Date = date(v-day-number + 2400002).
      207         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      208     .
      209   end.
      210   function cur-time-mjd-to-string returns character
      211   (input p-mjd-diff as decimal
      212   )
      213   :
      214     define variable v-day-number as integer   no-undo .
      215     define variable v-seconds    as integer   no-undo .
      216     define variable v-hour       as integer   no-undo .
      217     define variable v-min        as integer   no-undo .
      218     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      219     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      220     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      221     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      222     if p-mjd-diff < 0
      223     or p-mjd-diff = ?
      224     then do:
      225       return "?" .
      226     end.
      227     assign
      228       v-day-number = integer(truncate(p-mjd-diff,0))
      229       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      230     .
      231     if v-seconds > 86400
      232     then do:
      233       assign
      234         v-seconds = 86400 - 1
      235       .
      236     end.
      237     if v-seconds < 0
      238     then do:
      239       assign
      240         v-seconds = 0
      241       .
      242     end.
      243     assign
      244       v-hour = truncate(v-seconds / 3600, 0)
      245     .
      246     assign
      247       v-seconds = v-seconds modulo 3600
      248     .
      249     assign
      250       v-min = truncate(v-seconds / 60, 0)
      251     .
      252     assign
      253       v-seconds = v-seconds modulo 60
      254     .
      255     return
      256         (if v-day-number <> 0
      257           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      258           else ""
      259         )
      260       + (if v-day-number <> 0 or v-hour <> 0
      261           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      262           else ""
      263         )
      264       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      265           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      266           else ""
      267         )
      268       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      269       .
      270   end.
      271   function cur-time-string returns character
      272   :
      273     define variable v-date as date      no-undo .
      274     define variable v-time as integer   no-undo .
      275     run cur-time in this-procedure
      276       (output v-date
      277       ,output v-time
      278       ) .
      279     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      280   end.
      281   function cur-time-string-sec returns character
      282   :
      283     define variable v-date as date      no-undo .
      284     define variable v-time as integer   no-undo .
      285     run cur-time in this-procedure
      286       (output v-date
      287       ,output v-time
      288       ) .
      289     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      290   end.
      291   function cur-time-custom  returns character
      292   (input p-prefix as character
      293   ,input p-date-format as character
      294   ,input p-delimiter as character
      295   ,input p-time-format as character
      296   ,input p-suffix as character
      297   )
      298   :
      299     define variable v-date as date      no-undo .
      300     define variable v-time as integer   no-undo .
      301     run cur-time in this-procedure
      302       (output v-date
      303       ,output v-time
      304       ) .
      305     return
      306       p-prefix
      307       + string(v-date, p-date-format)
      308       + p-delimiter
      309       + string(v-time, p-time-format)
      310       + p-suffix
      311       .
      312   end.
      313   function cur-time-print  returns character
      314   :
      315     define variable v-date as date      no-undo .
      316     define variable v-time as integer   no-undo .
      317     run cur-time in this-procedure
      318       (output v-date
      319       ,output v-time
      320       ) .
      321     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      322   end.
      323   function cur-time-datetime returns datetime
      324   :
      325     define variable v-char as character no-undo .
      326     define variable v-datetime as datetime no-undo .
      327     v-char = cur-time-string().
      328     v-datetime = datetime(v-char).
      329     return  v-datetime.
      330   end.
      331   function cur-time-string-msec returns character
      332   :
      333     define variable v-date as datetime  no-undo .
      334     v-date = now.
      335     return string(v-date) .
      336   end.
      337   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      338   procedure sel-date :
      339     define input  parameter p-date-handle as handle    no-undo .
      340     define input  parameter p-description as character no-undo .
      341     do
      342     on error undo, return error return-value
      343     :
      344       if (can-query (p-date-handle, "sensitive")
      345         and
      346         p-date-handle :sensitive = true
      347         )
      348       or (can-query (p-date-handle, "read-only")
      349         and
      350         p-date-handle :read-only = false
      351         )
      352       then do:
      353         if p-date-handle :handle <> focus :handle
      354         then do:
      355           apply "entry":u to p-date-handle .
      356         end.
      357         define variable v-ok            as logical no-undo .
      358         define variable v-curr-sv-date as date no-undo .
      359         assign
      360           v-curr-sv-date = date(p-date-handle :screen-value) no-error
      361         .
      362         if v-curr-sv-date = ?
      363         then do:
      364           run gbl/getcurdt.p
      365             (output v-curr-sv-date
      366             ) .
      367         end.
      368         if v-curr-sv-date <> ?
      369         then do:
      370           run gbl/d-inpday.w
      371             (input ?
      372             ,input "Выбор даты"
      373             ,input p-description
      374             ,input ""
      375             ,input-output v-curr-sv-date
      376             ,output v-ok
      377             ).
      378           if v-ok = true
      379           then do:
      380             assign
      381               p-date-handle :screen-value = string(v-curr-sv-date) .
      382             .
      383           end.
      384         end.
      385       end.
      386     end.
      387   end procedure.
      388   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      389   procedure godendo-date-to-offset :
      390     define input  parameter p-today  as date      no-undo .
      391     define input  parameter p-date   as date      no-undo .
      392     define output parameter p-offset as integer   no-undo .
      393     do
      394     on error undo, return error return-value
      395     :
      396       if p-date  = ?
      397       or p-today = ?
      398       then do:
      399         assign
      400           p-offset = ?
      401         .
      402       end.
      403       else do:
      404         assign
      405           p-offset = p-date - p-today + 1
      406         .
      407       end.
      408     end.
      409   end procedure.
      410   procedure godendo-offset-to-date :
      411     define input  parameter p-today  as date      no-undo .
      412     define input  parameter p-offset as integer   no-undo .
      413     define output parameter p-date   as date      no-undo .
      414     do
      415     on error undo, return error return-value
      416     :
      417       if p-today  = ?
      418       or p-offset = ?
      419       then do:
      420         assign
      421           p-date = ?
      422         .
      423       end.
      424       else do:
      425         assign
      426           p-date = p-offset + p-today - 1
      427         .
      428       end.
      429     end.
      430   end procedure.
