      955   DEFINE VARIABLE EDITOR-3 AS CHARACTER INITIAL "Все"
      956        VIEW-AS EDITOR NO-WORD-WRAP SCROLLBAR-HORIZONTAL SCROLLBAR-VERTICAL
      957        SIZE 40.63 BY 3.71 NO-UNDO.
      958   DEFINE VARIABLE f-sum AS CHARACTER FORMAT "X(256)":U
      959        VIEW-AS FILL-IN
      960        SIZE 11 BY 1 NO-UNDO.
      961   DEFINE VARIABLE RADIO-SET-3 AS INTEGER INITIAL 1
      962        VIEW-AS RADIO-SET VERTICAL
      963        RADIO-BUTTONS
      964             "Все", 1,
      965   "Выборочно", 2
      966        SIZE 15 BY 1.71 NO-UNDO.
      967   DEFINE RECTANGLE RECT-7
      968        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      969        SIZE 66.5 BY 4.88.
      970   DEFINE FRAME F-Main
      971        EDITOR-3 AT ROW 2.33 COL 25.13 NO-LABEL WIDGET-ID 12
      972        RADIO-SET-3 AT ROW 2.54 COL 3.5 NO-LABEL WIDGET-ID 14
      973        f-sum AT ROW 6.96 COL 23.5 NO-LABEL WIDGET-ID 20
      974        "Выбор промоакций:" VIEW-AS TEXT
      975             SIZE 18.5 BY .67 AT ROW 1.38 COL 5 WIDGET-ID 34
      976        RECT-7 AT ROW 1.71 COL 2
      977       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      978            SIDE-LABELS NO-UNDERLINE THREE-D
      979            AT COL 1 ROW 1 SCROLLABLE
      980            BGCOLOR 8 .
