      986   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      987   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      988   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      989   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      990   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      991   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      992   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      993   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      994         adm-object-hdl = FRAME F-Main:HANDLE.
      995   RUN ensure-broker.
      996   THIS-PROCEDURE:ADM-DATA =
      997        'ADM1.1~`':U +
      998        'SmartViewer~`':U +
      999        '~`':U +
     1000        'NO ~`':U +
     1001        '~`':U +
     1002        '~`':U +
     1003        '~`':U +
     1004        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     1005           + "~`":U +
     1006        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
     1007        'Record-Source,Record-Target,TableIO-Target~`':U +
     1008        '~`':U +
     1009        '~`~`~`~`~`~`~`~`~`~`~`':U +
     1010        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1011            THEN "^^":U
     1012        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1013             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1014   PROCEDURE adm-apply-entry :
     1015     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1016   END PROCEDURE.
     1017   PROCEDURE adm-destroy :
     1018    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1019   END PROCEDURE.
     1020   PROCEDURE adm-disable :
     1021       DISABLE RECT-7 EDITOR-3 RADIO-SET-3 f-sum WITH FRAME F-Main.
     1022       RUN dispatch ('disable-fields':U).
     1023       RUN set-attribute-list ('ENABLED=no':U).
     1024       RETURN.
     1025   END PROCEDURE.
     1026   PROCEDURE adm-edit-attribute-list :
     1027         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
     1028         RETURN.
     1029   END PROCEDURE.
     1030   PROCEDURE adm-enable :
     1031       ENABLE UNLESS-HIDDEN RECT-7 EDITOR-3 RADIO-SET-3 f-sum WITH FRAME F-Main.
     1032       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     1033       RUN set-attribute-list ('ENABLED=yes':U).
     1034       RETURN.
     1035   END PROCEDURE.
     1036   PROCEDURE adm-exit :
     1037        RUN notify ('exit':U).
     1038     RETURN.
     1039   END PROCEDURE.
     1040   PROCEDURE adm-hide :
     1041     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1042   END PROCEDURE.
     1043   PROCEDURE adm-initialize :
     1044     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1045   END PROCEDURE.
     1046   PROCEDURE adm-show-errors :
     1047       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1048       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1049           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1050       END.
     1051       RETURN.
     1052   END PROCEDURE.
     1053   PROCEDURE adm-UIB-mode :
     1054     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1055   END PROCEDURE.
     1056   PROCEDURE adm-view :
     1057     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1058   END PROCEDURE.
     1059   PROCEDURE dispatch :
     1060       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1061       RUN broker-dispatch IN adm-broker-hdl
     1062           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1063       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1064   END PROCEDURE.
     1065   PROCEDURE ensure-broker :
     1066   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1067   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1068   DO:
     1069       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1070       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1071   END.
     1072   END PROCEDURE.
     1073   PROCEDURE get-attribute :
     1074     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1075     RUN broker-get-attribute IN adm-broker-hdl
     1076         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1077     RETURN RETURN-VALUE.
     1078   END PROCEDURE.
     1079   PROCEDURE get-attribute-list :
     1080     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1081     RUN broker-get-attribute-list IN adm-broker-hdl
     1082         (INPUT THIS-PROCEDURE,
     1083          INPUT ?,
     1084          OUTPUT p-attr-list) NO-ERROR.
     1085     RETURN.
     1086   END PROCEDURE.
     1087   PROCEDURE new-state :
     1088     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1089     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1090     RETURN.
     1091   END PROCEDURE.
     1092   PROCEDURE notify :
     1093     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1094     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1095     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1096         RETURN "ADM-ERROR":U.
     1097     RETURN.
     1098   END PROCEDURE.
     1099   PROCEDURE set-attribute-list :
     1100     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1101     RUN ensure-broker.
     1102     RUN broker-set-attribute-list IN adm-broker-hdl
     1103         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1104     RETURN.
     1105   END PROCEDURE.
     1106   PROCEDURE set-position :
     1107       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1108       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1109       IF VALID-HANDLE(adm-object-hdl) THEN
     1110       DO:
     1111         ASSIGN adm-object-hdl:ROW    =   p-row
     1112                adm-object-hdl:COLUMN =   p-col.
     1113       END.
     1114       RETURN.
     1115   END PROCEDURE.
     1116   PROCEDURE adm-display-fields :
     1117       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
     1118       RETURN.
     1119   END PROCEDURE.
     1120   PROCEDURE adm-open-query :
     1121     RETURN.
     1122   END PROCEDURE.
     1123   PROCEDURE adm-row-changed :
     1124         IF VALID-HANDLE(adm-object-hdl) THEN
     1125           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1126         RUN notify ('row-available':U).
     1127         RETURN.
     1128   END PROCEDURE.
     1129   PROCEDURE reposition-query :
     1130       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
     1131       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
     1132       RETURN.
     1133   END PROCEDURE.
     1134     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
     1135     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
     1136     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
     1137     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
     1138     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
     1139     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
     1140     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
     1141     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
     1142     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1143     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
     1144     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1145     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
     1146     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
     1147     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
     1148     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
     1149     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
     1150     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
     1151     IF "":U = "":U THEN
     1152       RUN modify-list-attribute IN adm-broker-hdl
     1153         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
     1154     RUN use-create-on-add(?).
     1155   PROCEDURE adm-add-record :
     1156       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1157          "must have at least one Enabled Table to perform Add.":U
     1158          VIEW-AS ALERT-BOX ERROR.
     1159       RETURN.
     1160   END PROCEDURE.
     1161   PROCEDURE adm-assign-record :
     1162    MESSAGE
     1163          "Object ":U THIS-PROCEDURE:FILE-NAME
     1164            "must have at least one Enabled Table to perform Assign.":U
     1165              VIEW-AS ALERT-BOX ERROR.
     1166      RETURN.
     1167     END PROCEDURE.
     1168   PROCEDURE adm-assign-statement :
     1169     RETURN.
     1170   END PROCEDURE.
     1171   PROCEDURE adm-cancel-record :
     1172      RETURN.
     1173     END PROCEDURE.
     1174   PROCEDURE adm-copy-record :
     1175       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1176        "must have at least one Enabled Table to perform Copy.":U
     1177          VIEW-AS ALERT-BOX ERROR.
     1178       RETURN.
     1179   END PROCEDURE.
     1180   PROCEDURE adm-create-record :
     1181      RETURN.
     1182   END PROCEDURE.
     1183   PROCEDURE adm-current-changed :
     1184     RETURN.
     1185   END PROCEDURE.
     1186   PROCEDURE adm-delete-record :
     1187    MESSAGE
     1188          "Object ":U THIS-PROCEDURE:FILE-NAME
     1189            "must have at least one Enabled Table to perform Delete.":U
     1190              VIEW-AS ALERT-BOX ERROR.
     1191       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
     1192       RETURN.
     1193   END PROCEDURE.
     1194   PROCEDURE adm-disable-fields :
     1195         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
     1196       RETURN.
     1197   END PROCEDURE.
     1198   PROCEDURE adm-enable-fields :
     1199       RETURN.
     1200   END PROCEDURE.
     1201   PROCEDURE adm-end-update :
     1202     RETURN.
     1203   END PROCEDURE.
     1204   PROCEDURE adm-reset-record :
     1205       RETURN.
     1206   END PROCEDURE.
     1207   PROCEDURE adm-update-record :
     1208       MESSAGE
     1209         "Object ":U THIS-PROCEDURE:FILE-NAME
     1210           "must have at least one Enabled Table to perform Update.":U
     1211             VIEW-AS ALERT-BOX ERROR.
     1212      RETURN.
     1213   END PROCEDURE.
     1214   PROCEDURE check-modified :
     1215   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1216   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1217   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1218   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1219     IF check-state = "check":U THEN
     1220     DO:
     1221       RUN get-link-handle IN adm-broker-hdl
     1222         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1223            OUTPUT group-target-list).
     1224       IF group-target-list NE "":U THEN
     1225       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1226         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1227         RUN check-modified IN curr-widget ('group-check':U).
     1228         IF RETURN-VALUE NE "":U THEN
     1229         DO:
     1230           RUN check-modified-message(RETURN-VALUE).
     1231           RETURN "":U.
     1232         END.
     1233       END.
     1234     END.
     1235     RETURN "":U.
     1236   END PROCEDURE.
     1237   PROCEDURE check-modified-message :
     1238     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1239        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1240           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1241        IF RETURN-VALUE = "YES":U THEN
     1242           RUN notify ('view,CONTAINER-SOURCE':U).
     1243        MESSAGE IF p-changed-table NE ? THEN
     1244           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1245           ELSE "Current values have been changed."
     1246           SKIP "  Do you wish to save those changes?"
     1247           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1248        IF ANS THEN
     1249        DO:
     1250           IF group-assign-target THEN
     1251             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1252           ELSE RUN dispatch('update-record':U).
     1253           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1254           DO:
     1255               MESSAGE "Changes to the previous record were not saved."
     1256                 VIEW-AS ALERT-BOX ERROR.
     1257               IF group-assign-target THEN
     1258                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1259               ELSE RUN dispatch ('cancel-record':U).
     1260           END.
     1261        END.
     1262        ELSE DO:
     1263          IF group-assign-target THEN
     1264             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1265          ELSE RUN dispatch('cancel-record':U).
     1266        END.
     1267        RETURN.
     1268   END PROCEDURE.
     1269   PROCEDURE get-rowid :
     1270       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1271       ASSIGN
     1272       p-table   =   adm-first-table.
     1273       RETURN.
     1274   END PROCEDURE.
     1275   PROCEDURE init-group-assign :
     1276       RUN request-attribute IN adm-broker-hdl
     1277         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1278       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1279         group-assign-target = yes.
     1280       ELSE group-assign-target = no.
     1281       RETURN.
     1282   END PROCEDURE.
     1283   PROCEDURE set-editors :
     1284       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1285       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1286       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1287       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1288       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1289       DO WHILE VALID-HANDLE (curr-widget):
     1290           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1291              curr-widget:HIDDEN = no THEN DO:
     1292             CASE p-field-setting:
     1293               WHEN "INITIALIZE":U THEN
     1294               DO:
     1295                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1296                     read-only-list +
     1297                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1298                        STRING(curr-widget).
     1299               END.
     1300               WHEN "DISABLE":U OR
     1301               WHEN "ENABLE":U THEN
     1302               DO:
     1303                   curr-widget:SENSITIVE = yes.
     1304                   RUN get-attribute ('Read-Only-Editors':U).
     1305                   IF RETURN-VALUE = ? OR
     1306                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1307                       curr-widget:READ-ONLY =
     1308                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1309               END.
     1310               WHEN "CLEAR":U THEN
     1311                   curr-widget:SCREEN-VALUE = "":U.
     1312             END CASE.
     1313           END.
     1314           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1315       END.
     1316       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1317         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1318           + '"':U).
     1319       RETURN.
     1320   END PROCEDURE.
     1321   PROCEDURE use-check-modified-all :
     1322    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1323     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1324     RETURN.
     1325   END PROCEDURE.
     1326   PROCEDURE use-create-on-add :
     1327   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1328      RETURN.
     1329   END PROCEDURE.
     1330   PROCEDURE use-initial-lock :
     1331     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1332     ASSIGN adm-initial-lock = p-attr-value.
     1333     RETURN.
     1334   END PROCEDURE.
     1335     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1336   ASSIGN
     1337          FRAME F-Main:SCROLLABLE       = FALSE
     1338          FRAME F-Main:HIDDEN           = TRUE.
     1339   ASSIGN
     1340          EDITOR-3:READ-ONLY IN FRAME F-Main        = TRUE.
     1341   ON LEAVE OF f-sum IN FRAME F-Main
     1342   DO:
     1343       assign f-sum .
     1344     END.
     1345   ON VALUE-CHANGED OF RADIO-SET-3 IN FRAME F-Main
     1346   DO:
     1347       ASSIGN
     1348         Radio-set-3
     1349         .
     1350       CASE RADIO-SET-3:
     1351         WHEN 2
     1352         THEN
     1353           DO:
     1354             run ref/promo.p (input parparentproc,yes,output vSubs) no-error.
     1355             if not valid-object (vSubs) then return.
     1356               EDITOR-3 = "":U.
     1357               EMPTY TEMP-TABLE tt-promo.
     1358               v-text-promo = "" .
     1359         DO ii = 1 to vSubs:iCounter:
     1360           vSubs:GetItem(ii).
     1361           v-promo-action = vSubs:promoActionObjCurr .
     1362           FIND FIRST ub.PromoAction No-LOCK WHERE
     1363             ub.PromoAction.id = v-promo-action:ID
     1364             and ub.PromoAction.db-num = v-cntxt-db-num
     1365             No-ERROR.
     1366           IF avail ub.PromoAction then
     1367           do:
     1368             CREATE tt-promo.
     1369             buffer-copy ub.PromoAction to tt-promo .
     1370                 ASSIGN
     1371                   v-text-promo = v-text-promo + chr(10) + ub.PromoAction.nameAction.
     1372                 .
     1373               END.
     1374               ASSIGN
     1375                 v-text-promo = TRIM(v-text-promo, chr(10))
     1376                 EDITOR-3   = v-text-promo
     1377                 .
     1378             END.
     1379           END.
     1380         WHEN 1 THEN
     1381           DO:
     1382             EDITOR-3 = "Все":U.
     1383              EMPTY TEMP-TABLE tt-promo.
     1384             FOR EACH  ub.PromoAction No-LOCK WHERE
     1385             ub.PromoAction.id = v-promo-action:ID
     1386             and ub.PromoAction.db-num = v-cntxt-db-num
     1387               :
     1388               CREATE tt-promo.
     1389               buffer-copy ub.PromoAction to tt-promo .
     1390               ASSIGN
     1391                 v-text-promo = v-text-promo + chr(10) + ub.PromoAction.nameAction
     1392                 .
     1393             END.
     1394           END.
     1395         OTHERWISE
     1396         DO:
     1397         END.
     1398       END case.
     1399       DISPLAY
     1400         EDITOR-3
     1401         WITH FRAME F-Main.
     1402     END.
     1403   parparentproc = my-handle.
     1404   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1405     run mainmenu_getcntxt in parparentproc
     1406       (output v-cntxt-db-num
     1407       ,output v-cntxt-userid
     1408       ,output v-cntxt-level
     1409       ,output v-cntxt-host-code-obj
     1410       ,output v-cntxt-obj-type
     1411       ,output v-cntxt-obj-code
     1412       ,output v-cntxt-db-num-obj
     1413       ,output v-cntxt-is-admin
     1414       ) .
     1415   RUN enable_UI.
     1416   PROCEDURE enable_UI :
     1417   DISPLAY
     1418         EDITOR-3
     1419         WITH FRAME F-Main.
     1420   disable f-sum with frame F-Main .
     1421   END PROCEDURE.
     1422   PROCEDURE disable_UI :
     1423     HIDE FRAME F-Main.
     1424     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1425   END PROCEDURE.
     1426   PROCEDURE my-report :
     1427     do
     1428       on error undo, return error return-value
     1429       :
     1430   if RADIO-SET-3 = 1 then do:
     1431     empty temp-table tt-promo .
     1432     FOR EACH  ub.PromoAction No-LOCK:
     1433               CREATE tt-promo.
     1434               buffer-copy ub.PromoAction to tt-promo .
     1435             END.
     1436   end.
     1437       run rep/r-paysys.p
     1438         (input my-handle
     1439         ,input table tt-promo
     1440         ) .
     1441     end.
     1442   END PROCEDURE.
     1443   PROCEDURE my-var :
     1444     assign frame F-Main EDITOR-3.
     1445   END PROCEDURE.
