      492   def
      493    shared
      494   temp-table  obj-list no-undo
      495     field obj-type like ub.clients.obj-type
      496     field obj-code like ub.clients.obj-code
      497     field obj-name like ub.clients.obj-name
      498     field obj-id   as integer
