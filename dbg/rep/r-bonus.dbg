     1414           gds-zap-gds-name column-label  "Название товара! !":C37         format "X(37)"         space(0)
     1415           sym4             column-label  ":!:"                            format "x(1)"          space(0)
     1416           F-bonus          column-label  "Значение!бонуса":C16            format "x(16)"         space(0)
     1417           sym5             column-label  ":!:"                            format "x(1)"          space(0)
     1418           F-price-sale     column-label  "Последняя цена!прихода":C16     format "x(16)"         space(0)
     1419           sym6             column-label  ":!:"                            format "x(1)"          space(0)
     1420           F-kassa          column-label  "Касса!Продажа-возврат":C16      format "x(16)"         space(0)
     1421           sym7             column-label  ":!:"                            format "x(1)"          space(0)
     1422           F-bonus-dohod    column-label  "Валовой!доход от бонуса":C16    format "x(16)"         space(0)
     1423           sym8             column-label  ":!:"                            format "x(1)"          space(0)
     1424           F-nacenka        column-label  "Фактический!% наценки":C16      format "x(16)"         space(0)
     1425           sym9             column-label  ":!:"                            format "x(1)"          space(0)
     1426       HEADER
     1427           cur-time-print() AT 5 format "X(35)"
     1428           "Цены указаны в" ( "РУБ" )
     1429           string( "Страница " + string( PAGE-NUMBER( OutStream ), ">>>>9") ) AT 130 format "X(53)" SKIP
     1430           Line format "X(152)" AT 1
     1431      with width 232 down stream-io use-text NO-BOX.
     1432   procedure create-temp-t-post-stk-line :
     1433       define variable str  as char      format "X(60)" no-undo.
     1434       define variable str2 as char      no-undo.
     1435       define variable v-r  as character no-undo init "" .
     1436       define variable i#i  as int       no-undo.
     1437    do
     1438    on error undo, return error return-value
     1439    :
     1440    if available ub.goods and
     1441       available ub.clients and
     1442       available prod-cli then do:
     1443     create temp-t-post-stk-line .
     1444     BUFFER-COPY post-stk-line  TO temp-t-post-stk-line
     1445     assign
     1446       temp-t-post-stk-line.goods-grp-name    = ub.goods.grp-name
     1447       temp-t-post-stk-line.gds-code          = ub.goods.gds-code
     1448       temp-t-post-stk-line.unit-base         = ub.goods.unit-base
     1449       temp-t-post-stk-line.prt-root          = ub.goods.prt-root
     1450       temp-t-post-stk-line.gds-type          = ub.goods.gds-type
     1451       temp-t-post-stk-line.gds-name          = if g#gds-engl then ub.goods.engl-name else ub.goods.gds-name
     1452       temp-t-post-stk-line.clients-grp-name  = ub.clients.grp-name
     1453       temp-t-post-stk-line.clients-obj-name  = ub.clients.obj-name
     1454       temp-t-post-stk-line.prod-cli-obj-name = prod-cli.obj-name
     1455       temp-t-post-stk-line.prod-cli-obj-code = prod-cli.obj-code
     1456       temp-t-post-stk-line.prod-cli-obj-type = prod-cli.obj-type
     1457     .
     1458               if xlavel > 0 then
     1459               do:
     1460                   repeat i#i =1 to xlavel:
     1461                       if i#i =1 then str   = entry(1,ub.goods.grp-name, chr(47)) .
     1462                       else
     1463                       do:
     1464                           str2 = entry(i#i,ub.goods.grp-name, chr(47)) no-error.
     1465                           if not error-status:error  and str2 <> "":u then
     1466                               str = str +  chr(47) +  entry(i#i,ub.goods.grp-name, chr(47)) no-error .
     1467                       end.
     1468                   end.
     1469                   if str <> ? then
     1470                   do:
     1471                       temp-t-post-stk-line.goods-grp-name = str + chr(47) .
     1472                   end.
     1473               end.
     1474               else
     1475               do :
     1476                   temp-t-post-stk-line.goods-grp-name = ub.goods.grp-name.
     1477               end.
     1478           end.
     1479    end.
     1480   end procedure.
     1481   define temp-table temp-font no-undo
     1482     field fontnum  as integer
     1483     field fontname as character
     1484     field fontsize as character
     1485     field fonttype as character
     1486     field font-h   as integer
     1487     field font-w   as integer
     1488     field v-row    as integer
     1489     field v-col    as integer
     1490     field v-row-lans as integer
     1491     field v-col-lans as integer
     1492   index pi fontnum
     1493   .
     1494   procedure get-font-ini :
     1495     do
     1496     on error undo, return error return-value
     1497     :
     1498   define variable ii as integer   no-undo .
     1499   define variable v-font7 as character no-undo .
     1500   define variable v-font as character no-undo .
     1501   define variable loc-name as character no-undo .
     1502   define variable loc-size as character no-undo .
     1503   define variable loc-type as character no-undo .
     1504   define variable old_H as integer   no-undo .
     1505   define variable old_w as integer   no-undo .
     1506   define variable old-row  as integer   no-undo .
     1507   define variable old-col  as integer   no-undo .
     1508   define variable old-row-lans  as integer   no-undo .
     1509   define variable old-col-lans  as integer   no-undo .
     1510   define variable vv as integer   no-undo .
     1511   empty temp-table temp-font.
     1512     GET-KEY-VALUE SECTION "fonts" KEY "font7" VALUE v-font7 .
     1513       case num-entries (v-font7) :
     1514         when 4 then do:
     1515             assign
     1516               loc-name = entry ( 1 , v-font7 )
     1517               loc-size = entry ( 2 , v-font7 )
     1518               loc-type = entry ( 3 , v-font7 ) + "," +  entry ( 4 , v-font7 )
     1519             .
     1520         end.
     1521         when 3 then do:
     1522             assign
     1523               loc-name = entry ( 1 , v-font7 )
     1524               loc-size = entry ( 2 , v-font7 )
     1525               loc-type = entry ( 3 , v-font7 )
     1526             .
     1527         end.
     1528         when 2 then  do:
     1529             assign
     1530               loc-name = entry ( 1 , v-font7 )
     1531               loc-size = entry ( 2 , v-font7 )
     1532               loc-type = ""
     1533             .
     1534         end.
     1535         when 1 then do:
     1536             assign
     1537               loc-name = trim(entry ( 1 , v-font7 ))
     1538               loc-size = ""
     1539               loc-type = ""
     1540             .
     1541         end.
     1542       end case.
     1543     create temp-font.
     1544     assign
     1545       temp-font.fontnum  = 7
     1546       temp-font.fontname = trim(loc-name)
     1547       temp-font.fontsize = trim(loc-size)
     1548       temp-font.fonttype = trim(loc-type)
     1549       temp-font.v-row    = 62
     1550       temp-font.v-col    = 136
     1551       temp-font.v-row-lans = 43
     1552       temp-font.v-col-lans = 198
     1553     .
     1554     repeat ii = 16 to 100 :
     1555       get-key-value section 'fonts' key 'font' + string(ii)   value v-font  .
     1556       if v-font = "" or v-font = ? then leave.
     1557       case num-entries (v-font) :
     1558         when 4 then do:
     1559             assign
     1560               loc-name = entry ( 1 , v-font )
     1561               loc-size = entry ( 2 , v-font )
     1562               loc-type = entry ( 3 , v-font ) + "," +  entry ( 4 , v-font )
     1563             .
     1564         end.
     1565         when 3 then do:
     1566             assign
     1567               loc-name = entry ( 1 , v-font )
     1568               loc-size = entry ( 2 , v-font )
     1569               loc-type = entry ( 3 , v-font )
     1570             .
     1571         end.
     1572         when 2 then do:
     1573             assign
     1574               loc-name = entry ( 1 , v-font )
     1575               loc-size = entry ( 2 , v-font )
     1576               loc-type = ""
     1577             .
     1578         end.
     1579         when 1 then do:
     1580             assign
     1581               loc-name = trim(entry ( 1 , v-font ))
     1582               loc-size = ""
     1583               loc-type = ""
     1584             .
     1585         end.
     1586       end case.
     1587     create temp-font.
     1588     assign
     1589       temp-font.fontnum  = ii
     1590       temp-font.fontname = trim(loc-name)
     1591       temp-font.fontsize = trim(loc-size)
     1592       temp-font.fonttype = trim(loc-type)
     1593     .
     1594     end.
     1595       for each temp-font :
     1596          vv = integer(entry(2,temp-font.fontsize, "=" )) no-error .
     1597          if  vv = ? then vv =  0 .
     1598           run rep/exfont.p (
     1599             input   temp-font.fontname ,
     1600             input   vv ,
     1601             input   temp-font.fonttype ,
     1602             output  temp-font.font-h   ,
     1603             output  temp-font.font-w   )
     1604           .
     1605       end.
     1606   find first temp-font where  temp-font.fontnum  = 7  .
     1607   old_H = temp-font.font-H .
     1608   old_w = temp-font.font-W .
     1609   old-row = temp-font.v-row .
     1610   old-col = temp-font.v-col .
     1611   old-row-lans = temp-font.v-row-lans .
     1612   old-col-lans = temp-font.v-col-lans .
     1613       for each temp-font where
     1614                temp-font.fontnum  <> 7 :
     1615           assign
     1616               temp-font.v-row    = old_H * old-row / temp-font.font-h
     1617               temp-font.v-col    = old_W * old-col / temp-font.font-W
     1618               temp-font.v-row-lans    = old_H * old-row-lans / temp-font.font-h
     1619               temp-font.v-col-lans    = old_W * old-col-lans / temp-font.font-W
     1620           .
     1621       end.
     1622     end.
     1623   end procedure.
     1624   PROCEDURE How-name :
     1625   define input  parameter h as integer no-undo .
     1626   define input  parameter w as integer no-undo .
     1627   define output parameter n as character  no-undo .
     1628   define variable A4port-H as integer   no-undo init 63.
     1629   define variable A4port-W as integer   no-undo init 136.
     1630   define variable A4lans-H as integer   no-undo init 43.
     1631   define variable A4lans-W as integer   no-undo init 198.
     1632   define variable Strim-W  as integer   no-undo init 278.
     1633   run define-a4-size (
     1634        input ReportFontNum
     1635       ,output A4port-H
     1636       ,output A4port-W
     1637       ,output A4lans-H
     1638       ,output A4lans-W ).
     1639   If w >= 1 and w <= A4port-W Then DO:
     1640     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     1641     If h > A4lans-H  and h <= A4port-H Then n = "A4-port":U.
     1642     If h > A4port-H              Then n = "to-file":U.
     1643   End.
     1644   If w > A4port-W and w <= A4lans-W Then DO:
     1645     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     1646     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     1647     If h > A4port-H              Then n = "to-file":U.
     1648   End.
     1649   If w > A4lans-W and w <= Strim-W Then DO:
     1650     If h >= 1  and h <= A4lans-H Then n = "to-file":U.
     1651     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     1652     If h > A4port-H              Then n = "to-file":U.
     1653   End.
     1654   If w > Strim-W Then DO:
     1655      n = "to-file":U.
     1656   End.
     1657   END PROCEDURE.
     1658   PROCEDURE define-a4-size :
     1659   define input  parameter p-ReportFontNum as integer   no-undo .
     1660   define output parameter A4port-H as integer   no-undo .
     1661   define output parameter A4port-W as integer   no-undo .
     1662   define output parameter A4lans-H as integer   no-undo .
     1663   define output parameter A4lans-W as integer   no-undo .
     1664   if not can-find (first temp-font ) then do:
     1665      run get-font-ini .
     1666   end.
     1667   find first temp-font where temp-font.fontnum = p-ReportFontNum no-error .
     1668   if available temp-font then do:
     1669   assign
     1670     A4port-H = temp-font.v-row
     1671     A4port-W = temp-font.v-col
     1672     A4lans-H = temp-font.v-row-lans
     1673     A4lans-W = temp-font.v-col-lans
     1674   .
     1675   end.
     1676   else do:
     1677   assign
     1678     A4port-H = 63
     1679     A4port-W = 136
     1680     A4lans-H = 43
     1681     A4lans-W = 198
     1682   .
     1683   end.
     1684   END PROCEDURE.
     1685   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1686   procedure factord :
     1687     define input  parameter p-fact-date            as date    no-undo .
     1688     define input  parameter p-fact-time            as integer no-undo .
     1689     define input  parameter p-fact-num             as integer no-undo .
     1690     define input  parameter p-shift-date           as date    no-undo .
     1691     define input  parameter p-shift-num            as integer no-undo .
     1692     define input  parameter p-shift-on             as logical no-undo .
     1693     define output parameter p-fact-order           as decimal no-undo .
     1694     define output parameter p-shift-end-fact-order as decimal no-undo .
     1695     define output parameter p-day-end-fact-order   as decimal no-undo .
     1696     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     1697     if p-fact-date = ?
     1698     then do:
     1699       return error "Не указана фактическая дата" .
     1700     end.
     1701     define variable v-fact-date-num as integer no-undo .
     1702     assign
     1703       v-fact-date-num = integer(p-fact-date)
     1704     .
     1705     if p-fact-num = ?
     1706     or p-fact-num = 0
     1707     then do:
     1708       return error "Не задан p-fact-num " + string(p-fact-num) .
     1709     end.
     1710     if p-fact-num < 0
     1711     then do:
     1712       return error "Отрицательный fact-num " + string(p-fact-num) .
     1713     end.
     1714     if p-fact-num >= 100000000
     1715     then do:
     1716       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     1717     end.
     1718     if p-shift-on = true
     1719     then do:
     1720       if p-shift-date = ?
     1721       then do:
     1722         return error "Не задана дата смены" .
     1723       end.
     1724       if p-shift-num = ?
     1725       or p-shift-num = 0
     1726       then do:
     1727         return error "Не задан номер смены" .
     1728       end.
     1729     end.
     1730     else do:
     1731       assign
     1732         p-shift-date = p-fact-date
     1733         p-shift-num  = 24
     1734       .
     1735     end.
     1736     define variable v-shift-offset as integer no-undo .
     1737     if p-shift-date = p-fact-date
     1738     then do:
     1739       assign
     1740         v-shift-offset = 1
     1741       .
     1742     end.
     1743     if p-shift-date < p-fact-date
     1744     then do:
     1745       assign
     1746         v-shift-offset = 0
     1747       .
     1748     end.
     1749     if p-shift-date > p-fact-date
     1750     then do:
     1751       message
     1752         vss-workfile vss-revision vss-description skip
     1753         "Неправильная дата закрытия смены" skip
     1754         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     1755         view-as alert-box error .
     1756       undo, return error
     1757         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     1758           ,string(p-fact-date, '99/99/9999':U)
     1759           ,string(p-shift-date, '99/99/9999':U)
     1760           )
     1761       .
     1762     end.
     1763     if p-shift-num < 1
     1764     or p-shift-num > 24
     1765     then do:
     1766       message
     1767         vss-workfile vss-revision vss-description skip
     1768         "Неправильный номер смены" skip
     1769         "p-shift-num" p-shift-num skip
     1770         view-as alert-box error .
     1771       undo, return error return-value .
     1772     end.
     1773     assign
     1774       p-fact-order           = v-fact-date-num
     1775                              + v-shift-offset * 0.5
     1776                              + p-shift-num    * 0.02 - 0.01
     1777                              + p-fact-num     * 0.0000000001
     1778       p-shift-end-fact-order = v-fact-date-num
     1779                              + v-shift-offset * 0.5
     1780                              + p-shift-num    * 0.02
     1781       p-day-end-fact-order   = v-fact-date-num
     1782                              + 0.99
     1783     .
     1784     if p-fact-order           <= v-fact-date-num
     1785     or p-shift-end-fact-order <= v-fact-date-num
     1786     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     1787     or p-shift-end-fact-order >= p-day-end-fact-order
     1788     then do:
     1789       message
     1790         vss-workfile vss-revision vss-description skip
     1791         "Внутренняя ошибка при генерации фактического номера" skip
     1792         "p-fact-date"            p-fact-date            skip
     1793         "p-fact-time"            p-fact-time            skip
     1794         "p-fact-num"             p-fact-num             skip
     1795         "p-shift-date"           p-shift-date           skip
     1796         "p-shift-num"            p-shift-num            skip
     1797         "p-shift-on"             p-shift-on             skip
     1798         "p-shift-end-fact-order" p-shift-end-fact-order skip
     1799         "p-day-end-fact-order"   p-day-end-fact-order   skip
     1800         "v-fact-date-num"        v-fact-date-num        skip
     1801         view-as alert-box error .
     1802       undo, return error return-value .
     1803     end.
     1804   end procedure.
     1805   procedure day-begin-fact-order :
     1806     define input  parameter p-fact-date            as date    no-undo .
     1807     define output parameter p-day-begin-fact-order as decimal no-undo .
     1808     do
     1809     on error undo, return error return-value
     1810     :
     1811       if p-fact-date = ?
     1812       then do:
     1813         assign
     1814           p-day-begin-fact-order = 0
     1815         .
     1816       end.
     1817       else do:
     1818         assign
     1819           p-day-begin-fact-order = integer(p-fact-date)
     1820         .
     1821       end.
     1822     end.
     1823   end procedure.
     1824   procedure factord-max-fact-order :
     1825     define output parameter p-max-fact-order as decimal   no-undo .
     1826     do
     1827     on error undo, return error return-value
     1828     :
     1829       run day-begin-fact-order in this-procedure
     1830         (input  date(1, 1, 5000)
     1831         ,output p-max-fact-order
     1832         ) .
     1833     end.
     1834   end procedure.
     1835   procedure factord-cut-archive :
     1836     define input  parameter p-obj-type             as character no-undo .
     1837     define input  parameter p-obj-code             as integer   no-undo .
     1838     define input  parameter p-fact-date            as date      no-undo .
     1839     define output parameter p-shift-on             as logical   no-undo .
     1840     define output parameter p-shift-date           as date      no-undo .
     1841     define output parameter p-shift-num            as integer   no-undo .
     1842     define output parameter p-day-end-fact-order   as decimal   no-undo .
     1843     define output parameter p-shift-end-fact-order as decimal   no-undo .
     1844     define variable v-fact-order as decimal   no-undo .
     1845     define buffer buf_shift-obj for ub.shift-obj .
     1846     do
     1847     on error undo, return error return-value
     1848     :
     1849   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1850   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1851     (input  p-obj-type
     1852     ,input  p-obj-code
     1853     ,input  'shift-on=request'
     1854     ,output p-shift-on
     1855     ) no-error .
     1856       if error-status :error
     1857       then do:
     1858         message
     1859           vss-workfile vss-revision vss-description skip
     1860           "Ошибка при определении атрибута объекта" skip
     1861           "Объект" p-obj-type p-obj-code skip
     1862           error-status :get-message(1) skip
     1863           return-value skip
     1864           view-as alert-box error .
     1865         undo, return error return-value .
     1866       end.
     1867       if p-shift-on = false
     1868       then do:
     1869         assign
     1870           p-shift-date               = ?
     1871           p-shift-num                = 0
     1872         .
     1873       end.
     1874       else do:
     1875         find first buf_shift-obj share-lock
     1876           where buf_shift-obj.obj-type   = p-obj-type
     1877             and buf_shift-obj.obj-code   = p-obj-code
     1878             and buf_shift-obj.shift-date > p-fact-date
     1879           use-index pi
     1880           no-error .
     1881         if not available buf_shift-obj
     1882         or buf_shift-obj.status_ <> 'зкр':U
     1883         then do:
     1884           message
     1885             vss-workfile vss-revision vss-description skip
     1886             "Невозможно вычислить последнюю смену" skip
     1887             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1888             "Объект" p-obj-type p-obj-code skip
     1889             "Дата" p-fact-date skip
     1890             view-as alert-box error .
     1891           undo, return error return-value .
     1892         end.
     1893         find last buf_shift-obj share-lock
     1894           where buf_shift-obj.obj-type = p-obj-type
     1895             and buf_shift-obj.obj-code = p-obj-code
     1896             and buf_shift-obj.shift-date <= p-fact-date
     1897           use-index pi
     1898           no-error .
     1899         if available buf_shift-obj
     1900         then do:
     1901           if  buf_shift-obj.status_ = 'зкр':U
     1902           then do:
     1903             assign
     1904               p-shift-date = buf_shift-obj.shift-date
     1905               p-shift-num  = buf_shift-obj.shift-num
     1906             .
     1907           end.
     1908           else do:
     1909             message
     1910               vss-workfile vss-revision vss-description skip
     1911               "Невозможно вычислить последнюю смену" skip
     1912               "Статус смены отличен от статуса" 'зкр':U skip
     1913               "Объект" p-obj-type p-obj-code skip
     1914               "Дата" p-fact-date skip
     1915               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1916               view-as alert-box error .
     1917             undo, return error return-value .
     1918           end.
     1919         end.
     1920         else do:
     1921           assign
     1922             p-shift-date = p-fact-date - 1
     1923             p-shift-num  = 1
     1924           .
     1925         end.
     1926       end.
     1927       run factord in this-procedure
     1928         (input  p-fact-date
     1929         ,input  1
     1930         ,input  1
     1931         ,input  p-shift-date
     1932         ,input  p-shift-num
     1933         ,input  p-shift-on
     1934         ,output v-fact-order
     1935         ,output p-shift-end-fact-order
     1936         ,output p-day-end-fact-order
     1937         ) no-error .
     1938       if error-status :error
     1939       then do:
     1940         message
     1941           vss-workfile vss-revision vss-description skip
     1942           "Ошибка при вызове процедуры factord"
     1943           error-status :get-message(1) skip
     1944           return-value skip
     1945           view-as alert-box error .
     1946         undo, return error return-value .
     1947       end.
     1948     end.
     1949   end procedure.
     1950   procedure factord-lock-shift :
     1951     define input  parameter p-obj-type  as character no-undo .
     1952     define input  parameter p-obj-code  as integer   no-undo .
     1953     define input  parameter p-fact-date as date      no-undo .
     1954     define parameter buffer buf_shift-obj for ub.shift-obj .
     1955     define variable v-shift-on      as logical   no-undo .
     1956     define variable v-extra-message as character no-undo .
     1957     define variable v-error as character no-undo .
     1958     do
     1959     on error undo, return error return-value
     1960     :
     1961   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1962   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1963     (input  p-obj-type
     1964     ,input  p-obj-code
     1965     ,input  'shift-on=request'
     1966     ,output v-shift-on
     1967     ) no-error .
     1968       if error-status :error
     1969       then do:
     1970         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1971         undo, return error v-error .
     1972       end.
     1973       if v-shift-on = true
     1974       then do:
     1975         find first buf_shift-obj share-lock
     1976           where buf_shift-obj.obj-type   = p-obj-type
     1977             and buf_shift-obj.obj-code   = p-obj-code
     1978             and buf_shift-obj.shift-date > p-fact-date
     1979           use-index pi
     1980           no-error .
     1981         if not available buf_shift-obj
     1982         or buf_shift-obj.status_ <> 'зкр':U
     1983         then do:
     1984           find last buf_shift-obj
     1985             where buf_shift-obj.obj-type = p-obj-type
     1986               and buf_shift-obj.obj-code = p-obj-code
     1987               and buf_shift-obj.status_  = 'зкр':U
     1988             use-index stts
     1989             no-error .
     1990           if available buf_shift-obj
     1991           then do:
     1992             assign
     1993               v-extra-message =
     1994                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1995                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1996                               )
     1997             .
     1998           end.
     1999           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     2000           undo, return error v-error .
     2001         end.
     2002       end.
     2003     end.
     2004   end procedure.
     2005   procedure factord-end-day :
     2006     define input  parameter p-fact-date            as date    no-undo .
     2007     define output parameter p-day-end-fact-order   as decimal no-undo .
     2008     do
     2009     on error undo, return error return-value
     2010     :
     2011       if p-fact-date = ?
     2012       then do:
     2013         return error "Не указана фактическая дата" .
     2014       end.
     2015       assign
     2016         p-day-end-fact-order = integer(p-fact-date) + 0.99
     2017       .
     2018     end.
     2019   end procedure.
     2020   procedure factord-to-date :
     2021     define input  parameter p-fact-order as decimal no-undo .
     2022     define output parameter p-fact-date  as date    no-undo .
     2023     define variable v-ref-date  as date      no-undo .
     2024     define variable v-ref-delta as integer   no-undo .
     2025     do
     2026     on error undo, return error return-value
     2027     :
     2028       if p-fact-order = ?
     2029       or p-fact-order = 0
     2030       then do:
     2031         return error "Не указан fact-order" .
     2032       end.
     2033       assign
     2034         v-ref-date  = date(1, 1, 2000)
     2035       .
     2036       assign
     2037         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     2038       .
     2039       assign
     2040         p-fact-date = v-ref-date + v-ref-delta
     2041       .
     2042     end.
     2043   end procedure.
     2044   procedure factord-to-fact-num :
     2045     define input  parameter p-fact-order as decimal no-undo .
     2046     define output parameter p-fact-num   as integer no-undo .
     2047     define variable v-fact-order-trunc as decimal no-undo .
     2048     do
     2049     on error undo, return error return-value
     2050     :
     2051       if p-fact-order = ?
     2052       or p-fact-order = 0
     2053       then do:
     2054         return error "Не указан fact-order" .
     2055       end.
     2056       assign
     2057        v-fact-order-trunc = truncate(p-fact-order, 2)
     2058       .
     2059       assign
     2060         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     2061       .
     2062     end.
     2063   end procedure.
     2064   procedure factord-to-shift-num :
     2065     define input  parameter p-fact-order as decimal no-undo .
     2066     define output parameter p-shift-num   as integer no-undo .
     2067     define variable  p-shift-numd  as decimal   no-undo .
     2068     define variable v-fact-order-trunc as decimal no-undo .
     2069     do
     2070     on error undo, return error return-value
     2071     :
     2072       if p-fact-order = ?
     2073       or p-fact-order = 0
     2074       then do:
     2075         return error "Не указан fact-order" .
     2076       end.
     2077       assign
     2078        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     2079       .
     2080       if v-fact-order-trunc < 0.5 then do:
     2081         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     2082       end.
     2083       assign
     2084         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     2085         .
     2086        assign
     2087         p-shift-num = truncate (p-shift-numd , 0)
     2088       .
     2089     end.
     2090   end procedure.
