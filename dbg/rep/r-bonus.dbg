     2336   procedure display-title :
     2337   define variable XLS-page-num  as integer   no-undo .
     2338   define variable sheet-name    as character no-undo .
     2339   define variable v-ii          as integer initial 0 no-undo .
     2340      PUT stream  OutStream  UNFORMATTED reportname  at 65 format "x(170)" skip
     2341               trim(str1)  at 1  format "x(75)"  skip.
     2342     repeat i = 1 to num-entries(str2,chr(10)) :
     2343     PUT stream  OutStream  UNFORMATTED  entry(i,str2,chr(10))  at 1 format "x(170)" skip.
     2344     end.
     2345   i=0.
     2346     PUT stream  OutStream  UNFORMATTED  trim(str3)  at 35 format "x(75)" skip.
     2347     repeat i = 1 to num-entries(str4,chr(10)) :
     2348     PUT stream  OutStream  UNFORMATTED  entry(i,str4,chr(10))  at 1 format "x(170)" skip.
     2349     end.
     2350   i=0.
     2351     repeat i = 1 to num-entries(reportheader,chr(10)) :
     2352     PUT stream  OutStream  UNFORMATTED  entry(i,reportheader,chr(10))  at 1 format "x(170)" skip.
     2353     end.
     2354   i=0.
     2355   for each SheetF where
     2356             SheetF.Sheet-Num > 1
     2357   :
     2358     delete SheetF .
     2359   end.
     2360    run u-line.
     2361    PUT stream  OutStream  UNFORMATTED "ОБЪЕКТЫ РАЗДЕЛЬНО" at 65 format "x(170)" skip.
     2362    run p-line.
     2363   XLS-page-num = 0.
     2364   for each obj-list no-lock :
     2365     XLS-page-num = XLS-page-num + 1.
     2366     find first sheetf where sheetf.sheet-num = XLS-page-num no-error .
     2367     if not available sheetf then do:
     2368       create sheetf.
     2369     end.
     2370     assign
     2371     sheet-name = obj-list.obj-name
     2372     sheetf.sheet-num   = XLS-page-num
     2373     sheetf.MergeCellsH = "1:4,5:8,9:11"
     2374     sheetf.Excel-Column-Lable = "Объект:" + chr(44) + chr(44) + chr(44) + chr(44) +
     2375                               sheet-name + chr(44) + chr(44) + chr(44) + chr(44) + chr(10) +
     2376                               "Код" + chr(44) +
     2377                               "Артикул" + chr(44) +
     2378                               "Наименование товара" + chr(44) +
     2379                               "Значение бонуса" + chr(44) +
     2380                               "Последняя цена прихода" + chr(44) +
     2381                               "Касса продажа-возврат" + chr(44) +
     2382                               "Валовой доход от бонуса" + chr(44) +
     2383                               "Фактический % наценки" + chr(44)
     2384     sheetf.Sizes  = "10,16,60,13,13,13,13,13"
     2385     Sheetf.ColFOrmat = "2=@;3=@" + chr(4) + chr(4) + sheet-name
     2386     Sheetf.Bas-File = "exe/Adjustw.bas"
     2387     .
     2388   end.
     2389   v-last-page = XLS-page-num + 1.
     2390   find first sheetf where sheetf.sheet-num = v-last-page no-error .
     2391   if not available sheetf then do:
     2392     create sheetf.
     2393   end.
     2394   assign
     2395   sheetf.sheet-num = v-last-page
     2396   sheetf.MergeCellsH = "1:7"
     2397   sheetf.Excel-Column-Lable = "Итоги" + chr(44) + chr(44) + chr(44) + chr(44) + chr(44) + chr(44) + chr(44) + chr(10) +
     2398                               "Код" + chr(44) +
     2399                               "Артикул" + chr(44) +
     2400                               "Наименование товара" + chr(44) +
     2401                               "Значение бонуса" + chr(44) +
     2402                               "Касса продажа-возврат" + chr(44) +
     2403                               "Валовой доход от бонуса" + chr(44) +
     2404                               "Фактический % наценки" + chr(44)
     2405   sheetf.Sizes  = "10,16,60,13,13,13,13"
     2406   Sheetf.ColFOrmat = "2=@;3=@" + chr(4) + chr(4) + "Итоги"
     2407   Sheetf.Bas-File = "exe/Adjustw.bas"
     2408   .
     2409     end procedure.
     2410   PROCEDURE ostatok :
     2411   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
     2412   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
     2413   def input parameter x-tog-shift   as   logical             no-undo.
     2414   def input parameter x-date-start  like ub.stk-tot.Fact-date   no-undo.
     2415   def input parameter x-date-end    like ub.stk-tot.Fact-date   no-undo.
     2416   def input parameter x-shift-start as integer               no-undo.
     2417   def input parameter x-shift-end   as integer               no-undo.
     2418   def input parameter x-sum-type    like ub.stk-tot.sum-type    no-undo.
     2419   def input parameter x-cat-id      like ub.stk-tot.cat-id      no-undo.
     2420   def input parameter xTog-obj   as log no-undo.
     2421   def output parameter Quantity    like ub.stk-tot.fact-qnty   no-undo.
     2422   def output parameter Coast_R     like ub.stk-tot.sum-rubl    no-undo.
     2423   def output parameter Coast_V     like ub.stk-tot.sum-rubl    no-undo.
     2424   def output parameter VAT_R       like ub.stk-tot.sum-rubl    no-undo.
     2425   def output parameter VAT_V       like ub.stk-tot.sum-rubl    no-undo.
     2426   def output parameter Fact-order  like ub.stk-tot.Fact-order  no-undo.
     2427   def var              Fact-order#   like ub.stk-tot.Fact-order  no-undo.
     2428   def var              Fact-orderS   as char  no-undo.
     2429   def var x-date-start-t  like ub.stk-tot.shift-date   no-undo.
     2430      Assign
     2431         Fact-order   = 0
     2432         Quantity     = 0
     2433         Coast_R      = 0
     2434         Coast_V      = 0
     2435         VAT_R        = 0
     2436         VAT_V        = 0 .
     2437    x-date-start-t  = x-date-start + 1 .
     2438   IF x-date-end = date('') then DO:
     2439      Fact-order = 0 .
     2440      for each obj-list
     2441          where  ( not xtog-obj or
     2442                 ( x-store-type = obj-list.obj-type and x-store-code = obj-list.obj-code ))
     2443                 no-lock :
     2444         if  x-tog-shift = false then do:
     2445                          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2446                               ub.stk-tot.Fact-date <=  x-date-start
     2447                               and ub.stk-tot.shift-num = 0
     2448                               USE-INDEX fact-date no-lock no-error .
     2449              if Available ub.stk-tot THEN  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2450         End.
     2451         Else  DO :
     2452             find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2453              (ub.stk-tot.shift-date  = x-date-start-t and
     2454               ub.stk-tot.shift-num  < x-shift-start or
     2455               ub.stk-tot.shift-date  < x-date-start-t  )
     2456               and ub.stk-tot.shift-num  > 0
     2457               USE-INDEX Shift-num no-lock no-error .
     2458            If Available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2459           END.
     2460       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     2461     End.
     2462   End.
     2463   Else DO:
     2464     For each obj-list  WHERE
     2465        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
     2466         no-lock :
     2467      IF  x-TOG-Shift = False Then DO:
     2468          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2469               ub.stk-tot.Fact-date <= x-date-end
     2470               and ub.stk-tot.shift-num = 0
     2471               USE-INDEX fact-date no-lock no-error.
     2472          if available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2473      END.
     2474      Else DO:
     2475           find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2476               (ub.stk-tot.shift-date  = x-date-end and
     2477               ub.stk-tot.shift-num  <= x-shift-end or
     2478               ub.stk-tot.shift-date  < x-date-end       ) and
     2479               ub.stk-tot.shift-num   > 0      use-index shift-num no-lock no-error.
     2480               if Available ub.stk-tot THEN Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2481       End.
     2482       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     2483     End.
     2484   End.
     2485   END PROCEDURE.
     2486   procedure report-exec1  :
     2487     find first a-clients where
     2488               a-clients.obj-type = x-store-type
     2489           and a-clients.obj-code = x-store-code  no-lock no-error.
     2490     if available a-clients then  objname = a-clients.obj-name. else  objname = "объект не определен".
     2491     run waitfram-show (objname) .
     2492     form with frame zapas .
     2493   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2494   form header
     2495     line format "x(152)" at 1 skip
     2496     "Продолжение - на следующей странице" at 30 skip
     2497     with frame bottomframe width 232 page-bottom no-labels no-box .
     2498   view stream outstream frame bottomframe .
     2499     run calcitog.
     2500     run print-header.
     2501       case retsorttype :
     2502         when "sort-article":u  or when "sort-artic":u  then do :
     2503           run rep/r-bn-2.p (x-store-code, x-store-type, x-base-type , x-base-code,x-cont-code ).
     2504         end.
     2505         when "sort-code":u  then  do :
     2506           run rep/r-bn-4.p (x-store-code, x-store-type, x-base-type , x-base-code,x-cont-code ).
     2507         end.
     2508         when "sort-name":u  then do :
     2509           run rep/r-bn-6.p (x-store-code, x-store-type, x-base-type , x-base-code,x-cont-code ).
     2510         end.
     2511       end case.
     2512       run print-last-page.
     2513     hide stream outstream frame bottomframe .
     2514     end procedure.
     2515   procedure clear-item :
     2516   define variable kk as int no-undo.
     2517    repeat kk = 1 to 6:
     2518    assign
     2519       v-bonus                    [kk]  = 0
     2520       v-price-sale               [kk]  = 0
     2521       v-kassa                    [kk]  = 0
     2522       v-bonus-dohod              [kk]  = 0
     2523       v-nacenka                  [kk]  = 0
     2524       s-kassa                    [kk]  = 0
     2525       s-bonus-dohod              [kk]  = 0
     2526       s-nacenka                  [kk]  = 0
     2527       .
     2528    end.
     2529   end procedure.
     2530   procedure print-last-page :
     2531   find first sheetf where entry(3, sheetf.colformat, chr(4)) = "Итоги" no-error.
     2532             if available sheetf then do:
     2533               run rep/extitle.p ( input sheetf.sheet-num ).
     2534               assign
     2535               Sheetf.Bas-Params = "Итоги"
     2536               .
     2537             end.
     2538   run u-line.
     2539   PUT stream  OutStream  UNFORMATTED "ИТОГИ" at 65 format "x(170)" skip.
     2540   run p-line.
     2541       case retsorttype :
     2542         when "sort-article":u  or when "sort-artic":u  then do :
     2543           run rep/r-bn-1.p (x-store-code, x-store-type, x-base-type , x-base-code,x-cont-code ).
     2544         end.
     2545         when "sort-code":u  then  do :
     2546           run rep/r-bn-3.p (x-store-code, x-store-type, x-base-type , x-base-code,x-cont-code ).
     2547         end.
     2548         when "sort-name":u  then do :
     2549           run rep/r-bn-5.p (x-store-code, x-store-type, x-base-type , x-base-code,x-cont-code ).
     2550         end.
     2551       end case.
     2552   end procedure.
