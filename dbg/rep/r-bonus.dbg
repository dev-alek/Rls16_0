      611   def
      612    shared
      613   temp-table  obj-list no-undo
      614     field obj-type like ub.clients.obj-type
      615     field obj-code like ub.clients.obj-code
      616     field obj-name like ub.clients.obj-name
      617     field obj-id   as integer
      618     field db-num   as integer
      619     index pi is primary unique obj-id
      620     index ie1 obj-type obj-code
      621     index ie2 obj-name
      622   .
      623   procedure create_obj-list :
      624      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      625      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      626      do
      627      on error undo, return error return-value
      628      :
      629         define buffer cli-obj for ub.clients .
      630         define variable p-var as integer no-undo .
      631         define buffer buf_obj-list for obj-list .
      632         find last buf_obj-list  use-index pi no-error .
      633         if available buf_obj-list
      634         then
      635            p-var = buf_obj-list.obj-id + 1.
      636         else
      637            p-var = 1.
      638         find first cli-obj where
      639                   cli-obj.obj-type = p-obj-type
      640               and cli-obj.obj-code = p-obj-code
      641         no-lock no-error.
      642         if available cli-obj
      643         then do:
      644            create buf_obj-list.
      645            assign
      646               buf_obj-list.obj-id   = p-var
      647               buf_obj-list.obj-code = cli-obj.obj-code
      648               buf_obj-list.obj-type = cli-obj.obj-type
      649               buf_obj-list.obj-name = cli-obj.obj-name
      650               buf_obj-list.db-num   = cli-obj.db-num
      651            .
      652         end.
      653      end.
      654   end.
