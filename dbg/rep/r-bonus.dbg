     2133   function excel-format-dec-to-char returns char (input p-dec as decimal ).
     2134     if num-entries(string(p-dec), '.') = 2
     2135       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
     2136       else return( string(p-dec)) .
     2137   end function.
     2138   function format-point-to-comma returns char (input orig as char ) .
     2139   define variable rtext as character no-undo .
     2140   define variable strt as integer no-undo .
     2141   define variable leng as integer no-undo .
     2142   assign rtext = orig .
     2143   repeat:
     2144     strt =  index(rtext,'.').
     2145     if strt = 0 then leave.
     2146     leng = 1.
     2147     substring(rtext,strt,leng,"character") = v-delim .
     2148   end.
     2149   return rtext.
     2150   end function.
     2151   function format-excel-text returns char ( input start-text as char ) :
     2152   def var  i    as int no-undo.
     2153   def var  ch   as char no-undo.
     2154   def var  n    as int no-undo.
     2155   def var  ipos as int no-undo.
     2156     n = num-entries(trim(start-text), chr(10)) - 1 .
     2157     do i = 1 to n :
     2158       ipos = index( start-text, chr(10)).
     2159       if ipos > 0 then
     2160         substr( start-text, ipos, 1 ) = ' '.
     2161     end.
     2162     n = num-entries(trim(start-text), chr(13)) - 1 .
     2163     do i = 1 to n :
     2164       ipos = index( start-text, chr(13)).
     2165       if ipos > 0 then
     2166         substr( start-text, ipos, 1 ) = ' '.
     2167     end.
     2168     if index( start-text, '"' ) = 0 then
     2169       start-text =  '="'   + trim( start-text) + '"'   .
     2170       else do:
     2171         n = num-entries(trim(start-text), '"') - 1.
     2172         do i = 1 to n :
     2173           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     2174         end.
     2175         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     2176         start-text = '="'  + ch  + '"' .
     2177       end.
     2178     return start-text.
     2179   end.
     2180   function excel-sum returns char (input p-dec as decimal ).
     2181     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
     2182   end function.
     2183   function excel-qnty returns char (input p-dec as decimal ).
     2184     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
     2185   end function.
     2186   function format-excel-text-macr returns char ( input start-text as char ) :
     2187   def var  i    as int no-undo.
     2188   def var  ch   as char no-undo.
     2189   def var  n    as int no-undo.
     2190   def var  ipos as int no-undo.
     2191     n = num-entries(trim(start-text), chr(10)) - 1 .
     2192     do i = 1 to n :
     2193       ipos = index( start-text, chr(10)).
     2194       if ipos > 0 then
     2195         substring( start-text, ipos , 1 ) = ' '.
     2196     end.
     2197     n = num-entries(trim(start-text), chr(13)) - 1 .
     2198     do i = 1 to n :
     2199       ipos = index( start-text, chr(13)).
     2200       if ipos > 0 then
     2201         substring( start-text, ipos, 1 ) = ' '.
     2202     end.
     2203     if index( start-text, '"' ) = 0 then
     2204       start-text =  '"'   + trim( start-text) + '"'   .
     2205       else do:
     2206         n = num-entries(trim(start-text), '"') - 1.
     2207         do i = 1 to n :
     2208           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     2209         end.
     2210         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     2211         start-text = '"'  + ch  + '"' .
     2212       end.
     2213     n = num-entries(trim(start-text), chr(10)) - 1 .
     2214     do i = 1 to n :
     2215       ipos = index( start-text, chr(10)).
     2216       if ipos > 0 then
     2217         substring( start-text, ipos , 1 ) = ' '.
     2218     end.
     2219       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
     2220     return start-text.
     2221   end.
     2222   FUNCTION n-lavel RETURNS char (INPUT grp-name as char, INPUT lavel# as int ).
     2223   define variable  str  as char format "X(60)"  no-undo.
     2224   define variable  str2 as char no-undo.
     2225   define variable v-r as character no-undo init "" .
     2226   define variable  i#i as int no-undo.
     2227   STR = "".
     2228   repeat i#i =1 to lavel#:
     2229       if i#i =1 then str   = entry(1,grp-name, chr(47)) .
     2230       else do:
     2231           str2 = entry(i#i,grp-name, chr(47)) no-error.
     2232           if not error-status:error  and str2 <> "":u then
     2233                  str = str +  chr(47) +  entry(i#i,grp-name, chr(47)) no-error .
     2234           end.
     2235   end.
     2236   if str <> ? then do:
     2237   v-r = str + chr(47) .
     2238   end.
     2239   RETURN v-r .
     2240   END FUNCTION.
