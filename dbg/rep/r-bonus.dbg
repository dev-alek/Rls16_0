     1133   procedure proc-alt-shift-f2:
     1134     if not ibs.th.gbl.gbl-var:rcode
     1135   then
     1136     run gbl\inidebug.p .
     1137   end.
     1138   procedure proc-alt-shift-f3:
     1139     run gbl/prvssinf.p
     1140       ( input this-procedure
     1141       ) .
     1142   end.
     1143   define variable v-inform-launched as logical no-undo initial false .
     1144   procedure proc-alt-shift-f4:
     1145     define variable v-action as character no-undo .
     1146     if v-inform-launched = false then do:
     1147       assign
     1148         v-inform-launched = true
     1149       .
     1150       run gbl/d-inform.w
     1151         (  input self
     1152         ,  input this-procedure
     1153         , output v-action
     1154         ) no-error .
     1155       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
     1156       assign
     1157         v-inform-launched = false
     1158       .
     1159     end.
     1160   end.
     1161   procedure proc-alt-f1:
     1162     run gbl/corrhelp.p
     1163       (input this-procedure
     1164       ) .
     1165   end .
     1166   on alt-shift-f2 anywhere do:
     1167     run proc-alt-shift-f2.
     1168   end.
     1169   on alt-shift-f3 anywhere do:
     1170     run proc-alt-shift-f3 in this-procedure .
     1171   end.
     1172   on alt-shift-f4 anywhere do:
     1173     run proc-alt-shift-f4 in this-procedure.
     1174   end.
     1175   on alt-f1 anywhere do:
     1176     run proc-alt-f1 in this-procedure .
     1177   end.
