        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: r-bonus.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: rep/r-bonus.p $":U .
        7   define variable vss-description as character no-undo init "Отчет по бонусам ".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       63   define variable v-waitfram-action01         as character   no-undo .
       64   define variable v-waitfram-action02         as character   no-undo .
       65   define variable v-waitfram-action03         as character   no-undo .
       66   define variable mWaitFramTextBeg            as character   no-undo.
       67   define variable mWaitFramTextEnd            as character   no-undo.
       68   define variable mWaitFramView               as logical     no-undo.
       69   define variable mWaitProcEvent              as logical     no-undo init yes.
       70   define variable mWaitFramInterval           as integer     no-undo init 1 .
       71   define variable mWaitFramStop               as logical     no-undo.
       72   define variable mWaitFramStopUser           as logical     no-undo.
       73   define variable mWaitFramStopTimeOut        as logical     no-undo.
       74   define variable mWaitFramStartProc          as datetime-tz no-undo.
       75   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       76   define button B-WaitFramStop auto-end-key
       77        label "Стоп"
       78        size 10 by 1 tooltip "Остоновить процесс".
       79   define button B-viewProcInfo
       80        label "Информация"
       81        size 15 by 1 tooltip "Информация о процесс".
       82   define frame waitfram
       83     v-waitfram-action01 format "x(72)" no-label skip
       84     v-waitfram-action02 format "x(72)" no-label skip
       85     v-waitfram-action03 format "x(72)" no-label skip
       86     B-viewProcInfo
       87     B-WaitFramStop at row 4 col 30
       88     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       89     .
       90   define new global shared variable mBatchMode as logical no-undo init ?.
       91   define variable mFramBachModHandle as handle no-undo.
       92   mFramBachModHandle = frame waitfram:handle.
       93   define variable mFameOldVis as logical no-undo.
       94   define variable mVisCUrentVin as logical no-undo.
       95   if session:batch-mode
       96   then
       97      mBatchMode = yes.
       98   if mBatchMode = ? then do:
       99     mVisCUrentVin = current-window:visible.
      100     mFameOldVis = mFramBachModHandle:visible.
      101     mFramBachModHandle:visible  = yes.
      102     mBatchMode = mFramBachModHandle:visible ne yes.
      103     mFramBachModHandle:visible = mFameOldVis.
      104     current-window:visible = mVisCUrentVin.
      105   end.
      106    if  log-manager:logfile-name ne ?
      107     then DO:
      108         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      109         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      110         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      111     end.
      112   on choose of B-WaitFramStop in frame waitfram
      113   do:
      114     mWaitFramStop = yes.
      115     mWaitFramStopUser = yes.
      116   end.
      117   function waitfram-check-timeout returns logical():
      118      define variable vtime as int64 no-undo.
      119      if mWaitFramStopTimeOut
      120      then
      121         return yes.
      122      vtime = ( now - mWaitFramStartProc ) / 1000 .
      123      if     mWaitFramTimeOut ne ?
      124         and mWaitFramTimeOut ne 0
      125         and mWaitFramTimeOut lt vtime
      126      then do:
      127         mWaitFramStopTimeOut = yes.
      128      end.
      129      return mWaitFramStopTimeOut.
      130   end.
      131   procedure waitfram-hide :
      132     if not session:batch-mode
      133     then do
      134     on error undo, return error return-value
      135     :
      136       pause 0 before-hide .
      137       if not mBatchMode then
      138         hide frame waitfram .
      139     if     not mWaitFramView
      140        and mWaitProcEvent
      141     then
      142       process events .
      143     end.
      144   end procedure.
      145   procedure waitfram-show :
      146     define input  parameter p-message as character no-undo .
      147     define variable v-left-margin as integer   no-undo .
      148     if not session:batch-mode
      149     then do
      150     on error undo, return error return-value
      151     :
      152       if length(p-message) <= 70 then do:
      153         assign
      154           v-left-margin = integer((70 - length(p-message)) / 2)
      155         .
      156         assign
      157           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      158         .
      159         assign
      160           v-waitfram-action01 = " "
      161           v-waitfram-action02 = " "
      162                                    + fill(" ", v-left-margin)
      163                                    + p-message
      164           v-waitfram-action03 = " "
      165         .
      166       end.
      167       else do:
      168         define variable vRindex1 as integer no-undo.
      169         define variable vRindex2 as integer no-undo.
      170         vRindex1 = r-index(p-message," ",70).
      171         if vRindex1 = 0
      172         then
      173            vRindex1 = 70.
      174         if length(p-message)  <= vRindex1 + 70 then do:
      175           assign
      176             v-waitfram-action01 = " "
      177             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      178             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      179           .
      180         end.
      181         else do:
      182           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      183           if vRindex2 <= vRindex1
      184           then
      185              vRindex2 = vRindex1 + 70.
      186           assign
      187             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      188             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      189             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      190           .
      191         end.
      192       end.
      193       B-viewProcInfo:visible   in frame waitfram = no.
      194       B-viewProcInfo:sensitive in frame waitfram = no.
      195       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      196       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      197       if  (   mWaitFramView
      198          or  mWaitProcEvent)
      199          and not mBatchMode
      200       then
      201          display
      202             v-waitfram-action01 skip
      203             v-waitfram-action02 skip
      204             v-waitfram-action03 skip
      205          with frame waitfram .
      206       if     mWaitFramView
      207          then do:
      208             if     mWaitFramInterval ne ?
      209                and not mBatchMode
      210             then
      211                wait-for go of frame waitfram pause mWaitFramInterval.
      212          end.
      213          else
      214             if     mWaitProcEvent
      215                and not mBatchMode
      216             then
      217                process events .
      218     end.
      219   end procedure.
      220      procedure waitfram-show-this:
      221         define input  parameter iInterval as int64 no-undo.
      222         define variable vtime as int64 no-undo.
      223         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      224         mWaitFramInterval = iInterval.
      225         run waitfram-show (substitute("&1&2 &3&4" ,
      226                                       mWaitFramTextBeg ,
      227                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      228                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      229                                       mWaitFramTextEnd
      230                                      )
      231                           ).
      232      end.
      233      procedure WaitFramRunPause:
      234         define input  parameter iInterval as dec no-undo.
      235         define variable vStart  as datetime-tz no-undo.
      236         define variable vend    as datetime-tz no-undo.
      237         define variable vint as int64 no-undo.
      238         define variable vOk as logical no-undo.
      239         vStart = now.
      240         vend   = vStart.
      241         publish "WaitFramPause" (iInterval,output vOk).
      242         vend   =  now.
      243         vint = vend - vStart.
      244         vint = iInterval - vint / 1000.
      245         if     not mWaitFramStop
      246            and (   vint > 0
      247                 or (    not vOk
      248                     and iInterval eq ?
      249                     )
      250                 )
      251         then
      252            run waitfram-show-this (iInterval).
      253         vend   =  now.
      254         vint = vend - vStart.
      255         vint = iInterval - vint / 1000.
      256         if     not mWaitFramStop
      257            and vint > 0
      258         then do:
      259            run gbl/pause.p (vint * 1000).
      260         end.
      261         if iInterval ne ?
      262         then
      263            publish "WaitFramStop".
      264         waitfram-check-timeout().
      265      end.
      266      procedure WaitFramWaitFor:
      267         define input  parameter iInterval as dec no-undo.
      268         assign
      269            mWaitFramStartProc   = now
      270            mWaitFramStopUser    = no
      271            mWaitFramStopTimeOut = no
      272         .
      273         block-wait:
      274         do while not mWaitFramStop:
      275            run WaitFramRunPause (iInterval).
      276            if  waitfram-check-timeout()
      277            then do:
      278               leave block-wait.
      279            end.
      280         end.
      281         run waitfram-hide.
      282      end.
      283   procedure waitfram-join :
      284     define input  parameter p-line-1  as character no-undo .
      285     define input  parameter p-line-2  as character no-undo .
      286     define input  parameter p-line-3  as character no-undo .
      287     define output parameter p-message as character no-undo .
      288     do
      289     on error undo, return error return-value
      290     :
      291       assign
      292         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      293                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      294                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      295       .
      296     end.
      297   end procedure.
      298   function waitfram-join-function returns character
      299     (input p-line-1 as character
      300     ,input p-line-2 as character
      301     ,input p-line-3 as character
      302     ).
      303     define variable v-message as character no-undo .
      304     run waitfram-join in this-procedure
      305       (input  p-line-1
      306       ,input  p-line-2
      307       ,input  p-line-3
      308       ,output v-message
      309       ) .
      310     return v-message .
      311   end function .
      312   define input parameter x-store-code like ub.clients.obj-code   no-undo.
      313   define input parameter x-store-type like ub.clients.obj-type   no-undo.
      314   define input parameter x-base-type  like ub.currency.curr-abbr no-undo.
      315   define input parameter x-base-code  like ub.currency.curr-code no-undo.
      316   define input parameter x-cli-art      as character          no-undo.
      317   define input parameter x-postname     as character          no-undo.
      318   define input parameter xclassify      as char               no-undo.
      319   define input parameter xsorttype      as char               no-undo.
      320   define input parameter x-cont-code    as integer            no-undo.
      321   define new global shared variable g#language as character no-undo .
      322   if g#language <> '' and g#language <> 'rus':U then do:
      323     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      324   end.
      325   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      326   procedure cur-time :
      327      define output parameter p-today as date      no-undo .
      328      define output parameter p-time  as integer   no-undo .
      329     do
      330     on error undo, return error
      331     :
      332       define variable v-date1 as date      no-undo .
      333       define variable v-date2 as date      no-undo .
      334       define variable v-time  as integer   no-undo .
      335       assign
      336         v-date1 = today
      337         v-time  = time
      338         v-date2 = today
      339       .
      340       if v-date1 <> v-date2
      341       then do:
      342         assign
      343           v-date1 = today
      344           v-time  = v-time
      345         .
      346       end.
      347       assign
      348         p-today = v-date1
      349         p-time  = v-time
      350       .
      351     end.
      352   end.
      353   function cur-time-date returns character
      354   :
      355     return string(today, '99/99/9999':U) .
      356   end.
      357   function cur-time-mjd returns decimal
      358   :
      359     define variable v-date as date      no-undo .
      360     define variable v-time as integer   no-undo .
      361     run cur-time in this-procedure
      362       (output v-date
      363       ,output v-time
      364       ) .
      365     return integer(v-date) - 2400002 + (v-time / 86400) .
      366   end.
      367   function cur-time-get-ending-index returns integer
      368   (input p-number as integer
      369   )
      370   :
      371     if p-number < 0
      372     or p-number = ?
      373     then do:
      374       return 1 .
      375     end.
      376     define variable v-rest as integer   no-undo .
      377     assign
      378       p-number = p-number modulo 100
      379     .
      380     if p-number < 20
      381     then do:
      382       assign
      383         v-rest = p-number
      384       .
      385     end.
      386     else do:
      387       assign
      388         v-rest = p-number modulo 10
      389       .
      390     end.
      391     case v-rest :
      392       when 1
      393       then do:
      394         return 2 .
      395       end.
      396       when 2 or
      397       when 3 or
      398       when 4
      399       then do:
      400         return 3 .
      401       end.
      402       otherwise do:
      403         return 1 .
      404       end.
      405     end case .
      406   end.
      407   procedure cur-time-mjd-to-date :
      408      define input  parameter i-mjd-diff as decimal no-undo.
      409      define output parameter o-Date     as date    no-undo.
      410      define output parameter o-Time     as integer no-undo.
      411      define variable v-day-number as integer   no-undo .
      412      if    i-mjd-diff < 0
      413         or i-mjd-diff = ?
      414      then do:
      415         return "?" .
      416      end.
      417      assign
      418         v-day-number = truncate(i-mjd-diff,0).
      419         o-Date = date(v-day-number + 2400002).
      420         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      421     .
      422   end.
      423   function cur-time-mjd-to-string returns character
      424   (input p-mjd-diff as decimal
      425   )
      426   :
      427     define variable v-day-number as integer   no-undo .
      428     define variable v-seconds    as integer   no-undo .
      429     define variable v-hour       as integer   no-undo .
      430     define variable v-min        as integer   no-undo .
      431     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      432     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      433     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      434     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      435     if p-mjd-diff < 0
      436     or p-mjd-diff = ?
      437     then do:
      438       return "?" .
      439     end.
      440     assign
      441       v-day-number = integer(truncate(p-mjd-diff,0))
      442       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      443     .
      444     if v-seconds > 86400
      445     then do:
      446       assign
      447         v-seconds = 86400 - 1
      448       .
      449     end.
      450     if v-seconds < 0
      451     then do:
      452       assign
      453         v-seconds = 0
      454       .
      455     end.
      456     assign
      457       v-hour = truncate(v-seconds / 3600, 0)
      458     .
      459     assign
      460       v-seconds = v-seconds modulo 3600
      461     .
      462     assign
      463       v-min = truncate(v-seconds / 60, 0)
      464     .
      465     assign
      466       v-seconds = v-seconds modulo 60
      467     .
      468     return
      469         (if v-day-number <> 0
      470           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      471           else ""
      472         )
      473       + (if v-day-number <> 0 or v-hour <> 0
      474           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      475           else ""
      476         )
      477       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      478           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      479           else ""
      480         )
      481       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      482       .
      483   end.
      484   function cur-time-string returns character
      485   :
      486     define variable v-date as date      no-undo .
      487     define variable v-time as integer   no-undo .
      488     run cur-time in this-procedure
      489       (output v-date
      490       ,output v-time
      491       ) .
      492     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      493   end.
      494   function cur-time-string-sec returns character
      495   :
      496     define variable v-date as date      no-undo .
      497     define variable v-time as integer   no-undo .
      498     run cur-time in this-procedure
      499       (output v-date
      500       ,output v-time
      501       ) .
      502     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      503   end.
      504   function cur-time-custom  returns character
      505   (input p-prefix as character
      506   ,input p-date-format as character
      507   ,input p-delimiter as character
      508   ,input p-time-format as character
      509   ,input p-suffix as character
      510   )
      511   :
      512     define variable v-date as date      no-undo .
      513     define variable v-time as integer   no-undo .
      514     run cur-time in this-procedure
      515       (output v-date
      516       ,output v-time
      517       ) .
      518     return
      519       p-prefix
      520       + string(v-date, p-date-format)
      521       + p-delimiter
      522       + string(v-time, p-time-format)
      523       + p-suffix
      524       .
      525   end.
      526   function cur-time-print  returns character
      527   :
      528     define variable v-date as date      no-undo .
      529     define variable v-time as integer   no-undo .
      530     run cur-time in this-procedure
      531       (output v-date
      532       ,output v-time
      533       ) .
      534     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      535   end.
      536   function cur-time-datetime returns datetime
      537   :
      538     define variable v-char as character no-undo .
      539     define variable v-datetime as datetime no-undo .
      540     v-char = cur-time-string().
      541     v-datetime = datetime(v-char).
      542     return  v-datetime.
      543   end.
      544   function cur-time-string-msec returns character
      545   :
      546     define variable v-date as datetime  no-undo .
      547     v-date = now.
      548     return string(v-date) .
      549   end.
      550   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      551   define  shared variable gdsgrp_recids      as character no-undo.
      552   define  shared variable fin-schet-recid    as character no-undo.
      553   define  shared variable v-d-report-handle  as handle    no-undo .
      554   define  shared temp-table g#customer no-undo
      555       field obj-type like ub.clients.obj-type
      556       field obj-code like ub.clients.obj-code
      557       field obj-name like ub.clients.obj-name
      558       index pi is unique primary obj-type obj-code.
      559   define  shared temp-table g#cli no-undo
      560       field obj-type like ub.clients.obj-type
      561       field obj-code like ub.clients.obj-code
      562       field obj-name like ub.clients.obj-name
      563       index pi is unique primary obj-type obj-code.
      564   define  shared temp-table tmp#grp no-undo
      565       field node-code like ub.gds-grp.node-code
      566       field grp-name like ub.gds-grp.node-name
      567       field lvl-num  like ub.gds-grp.lvl-num
      568       field is-term  like ub.gds-grp.is-term
