      809        RADIO-SET-1 AT ROW 5.92 COL 2.63 NO-LABEL
      810        max-amount AT ROW 6.92 COL 29.63 COLON-ALIGNED NO-LABEL
      811        tog-kass AT ROW 7.33 COL 47.5
      812        tog-ras AT ROW 8.13 COL 47.5
      813        max-amount-2 AT ROW 8.88 COL 6.38 COLON-ALIGNED NO-LABEL
      814        min-sum AT ROW 8.88 COL 26 COLON-ALIGNED NO-LABEL
      815        tog-voz AT ROW 8.88 COL 47.5
      816        Tog-1 AT ROW 10.63 COL 3.25
      817        week-1 AT ROW 11.83 COL 38.13 COLON-ALIGNED
      818        week-12 AT ROW 11.88 COL 55.13 COLON-ALIGNED
      819        week-2 AT ROW 12.88 COL 38.13 COLON-ALIGNED
      820        week-22 AT ROW 12.92 COL 55.13 COLON-ALIGNED
      821        week-3 AT ROW 13.92 COL 38.13 COLON-ALIGNED
      822        week-32 AT ROW 13.96 COL 55.13 COLON-ALIGNED
      823        week-4 AT ROW 14.88 COL 38.13 COLON-ALIGNED
      824        week-42 AT ROW 14.92 COL 55.13 COLON-ALIGNED
      825        week-5 AT ROW 15.96 COL 38.13 COLON-ALIGNED
      826        week-52 AT ROW 16 COL 55.13 COLON-ALIGNED
      827        "товаров,но >=" VIEW-AS TEXT
      828             SIZE 13.5 BY 1 AT ROW 8.88 COL 13.88
      829        "Сортировка :":C20 VIEW-AS TEXT
      830             SIZE 20.63 BY .75 AT ROW 1.46 COL 47.63
      831             FGCOLOR 4
      832        "Показать :" VIEW-AS TEXT
      833             SIZE 11.5 BY .75 AT ROW 4.88 COL 2.63
      834             FGCOLOR 4
      835        "Виды продаж :":C20 VIEW-AS TEXT
      836             SIZE 20.75 BY .67 AT ROW 6.54 COL 47.63
      837             FGCOLOR 4
      838        "товаров" VIEW-AS TEXT
      839             SIZE 8 BY 1 AT ROW 6.92 COL 37.13
      840        "Классификация :" VIEW-AS TEXT
      841             SIZE 15 BY .75 AT ROW 1.46 COL 12
      842             FGCOLOR 4
      843        "Интервалы просмотра реализации:" VIEW-AS TEXT
      844             SIZE 32.75 BY .67 AT ROW 10.5 COL 34.75
      845             FGCOLOR 4
      846        "" VIEW-AS TEXT
      847             SIZE 3.75 BY 1 AT ROW 8.88 COL 41.25
      848        RECT-5 AT ROW 1.21 COL 1.75
      849        RECT-6 AT ROW 1.21 COL 46.13
      850        RECT-8 AT ROW 10.21 COL 1.75
      851       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      852            SIDE-LABELS NO-UNDERLINE THREE-D
      853            AT COL 1 ROW 1 SCROLLABLE .
      854   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      855   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      856   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      857   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      858   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      859   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      860   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      861   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      862         adm-object-hdl = FRAME F-Main:HANDLE.
      863   RUN ensure-broker.
      864   THIS-PROCEDURE:ADM-DATA =
      865        'ADM1.1~`':U +
      866        'SmartObject~`':U +
      867        '~`':U +
      868        'NO ~`':U +
      869        '~`':U +
      870        '~`':U +
      871        '~`':U +
      872        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      873           + "~`":U +
      874        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
      875        'Record-Source,Record-Target,TableIO-Target~`':U +
      876        '~`':U +
      877        '~`~`~`~`~`~`~`~`~`~`~`':U +
      878        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      879            THEN "^^":U
      880        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      881             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      882   PROCEDURE adm-apply-entry :
      883     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      884   END PROCEDURE.
      885   PROCEDURE adm-destroy :
      886    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      887   END PROCEDURE.
      888   PROCEDURE adm-disable :
      889       DISABLE RECT-5 RECT-6 RECT-8 Tog-obj SortType Classify RADIO-SET-1 tog-kass tog-ras tog-voz Tog-1 week-1 week-12 week-2 week-22 week-3 week-32 week-4 week-42 week-5 week-52 WITH FRAME F-Main.
      890       RUN dispatch ('disable-fields':U).
      891       RUN set-attribute-list ('ENABLED=no':U).
      892       RETURN.
      893   END PROCEDURE.
      894   PROCEDURE adm-edit-attribute-list :
      895         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
      896         RETURN.
      897   END PROCEDURE.
      898   PROCEDURE adm-enable :
      899       ENABLE UNLESS-HIDDEN RECT-5 RECT-6 RECT-8 Tog-obj SortType Classify RADIO-SET-1 tog-kass tog-ras tog-voz Tog-1 week-1 week-12 week-2 week-22 week-3 week-32 week-4 week-42 week-5 week-52 WITH FRAME F-Main.
      900       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      901       RUN set-attribute-list ('ENABLED=yes':U).
      902       RETURN.
      903   END PROCEDURE.
      904   PROCEDURE adm-exit :
      905        RUN notify ('exit':U).
      906     RETURN.
      907   END PROCEDURE.
      908   PROCEDURE adm-hide :
      909     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      910   END PROCEDURE.
      911   PROCEDURE adm-initialize :
      912     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      913   END PROCEDURE.
      914   PROCEDURE adm-show-errors :
      915       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      916       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      917           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      918       END.
      919       RETURN.
      920   END PROCEDURE.
      921   PROCEDURE adm-UIB-mode :
      922     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      923   END PROCEDURE.
      924   PROCEDURE adm-view :
      925     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      926   END PROCEDURE.
      927   PROCEDURE dispatch :
      928       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      929       RUN broker-dispatch IN adm-broker-hdl
      930           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      931       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      932   END PROCEDURE.
      933   PROCEDURE ensure-broker :
      934   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      935   IF RETURN-VALUE NE "ADM-Broker":U THEN
      936   DO:
      937       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      938       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      939   END.
      940   END PROCEDURE.
      941   PROCEDURE get-attribute :
      942     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      943     RUN broker-get-attribute IN adm-broker-hdl
      944         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      945     RETURN RETURN-VALUE.
      946   END PROCEDURE.
      947   PROCEDURE get-attribute-list :
      948     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      949     RUN broker-get-attribute-list IN adm-broker-hdl
      950         (INPUT THIS-PROCEDURE,
      951          INPUT ?,
      952          OUTPUT p-attr-list) NO-ERROR.
      953     RETURN.
      954   END PROCEDURE.
      955   PROCEDURE new-state :
      956     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      957     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      958     RETURN.
      959   END PROCEDURE.
      960   PROCEDURE notify :
      961     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      962     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      963     IF RETURN-VALUE = "ADM-ERROR":U THEN
      964         RETURN "ADM-ERROR":U.
      965     RETURN.
      966   END PROCEDURE.
      967   PROCEDURE set-attribute-list :
      968     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      969     RUN ensure-broker.
      970     RUN broker-set-attribute-list IN adm-broker-hdl
      971         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      972     RETURN.
      973   END PROCEDURE.
      974   PROCEDURE set-position :
      975       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      976       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      977       IF VALID-HANDLE(adm-object-hdl) THEN
      978       DO:
      979         ASSIGN adm-object-hdl:ROW    =   p-row
      980                adm-object-hdl:COLUMN =   p-col.
      981       END.
      982       RETURN.
      983   END PROCEDURE.
      984   PROCEDURE adm-display-fields :
      985       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
      986       RETURN.
      987   END PROCEDURE.
      988   PROCEDURE adm-open-query :
      989     RETURN.
      990   END PROCEDURE.
      991   PROCEDURE adm-row-changed :
      992         IF VALID-HANDLE(adm-object-hdl) THEN
      993           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      994         RUN notify ('row-available':U).
      995         RETURN.
      996   END PROCEDURE.
      997   PROCEDURE reposition-query :
      998       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
      999       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
     1000       RETURN.
     1001   END PROCEDURE.
     1002     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
     1003     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
     1004     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
     1005     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
     1006     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
     1007     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
     1008     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
     1009     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
     1010     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1011     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
     1012     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1013     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
     1014     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
     1015     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
     1016     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
     1017     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
     1018     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
     1019     IF "":U = "":U THEN
     1020       RUN modify-list-attribute IN adm-broker-hdl
     1021         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
     1022     RUN use-create-on-add(?).
     1023   PROCEDURE adm-add-record :
     1024       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1025          "must have at least one Enabled Table to perform Add.":U
     1026          VIEW-AS ALERT-BOX ERROR.
     1027       RETURN.
     1028   END PROCEDURE.
     1029   PROCEDURE adm-assign-record :
     1030    MESSAGE
     1031          "Object ":U THIS-PROCEDURE:FILE-NAME
     1032            "must have at least one Enabled Table to perform Assign.":U
     1033              VIEW-AS ALERT-BOX ERROR.
     1034      RETURN.
     1035     END PROCEDURE.
     1036   PROCEDURE adm-assign-statement :
     1037     RETURN.
     1038   END PROCEDURE.
     1039   PROCEDURE adm-cancel-record :
     1040      RETURN.
     1041     END PROCEDURE.
     1042   PROCEDURE adm-copy-record :
     1043       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1044        "must have at least one Enabled Table to perform Copy.":U
     1045          VIEW-AS ALERT-BOX ERROR.
     1046       RETURN.
     1047   END PROCEDURE.
     1048   PROCEDURE adm-create-record :
     1049      RETURN.
     1050   END PROCEDURE.
     1051   PROCEDURE adm-current-changed :
     1052     RETURN.
     1053   END PROCEDURE.
     1054   PROCEDURE adm-delete-record :
     1055    MESSAGE
     1056          "Object ":U THIS-PROCEDURE:FILE-NAME
     1057            "must have at least one Enabled Table to perform Delete.":U
     1058              VIEW-AS ALERT-BOX ERROR.
     1059       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
     1060       RETURN.
     1061   END PROCEDURE.
     1062   PROCEDURE adm-disable-fields :
     1063         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
     1064       RETURN.
     1065   END PROCEDURE.
     1066   PROCEDURE adm-enable-fields :
     1067       RETURN.
     1068   END PROCEDURE.
     1069   PROCEDURE adm-end-update :
     1070     RETURN.
     1071   END PROCEDURE.
     1072   PROCEDURE adm-reset-record :
     1073       RETURN.
     1074   END PROCEDURE.
     1075   PROCEDURE adm-update-record :
     1076       MESSAGE
     1077         "Object ":U THIS-PROCEDURE:FILE-NAME
     1078           "must have at least one Enabled Table to perform Update.":U
     1079             VIEW-AS ALERT-BOX ERROR.
     1080      RETURN.
     1081   END PROCEDURE.
     1082   PROCEDURE check-modified :
     1083   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1084   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1085   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1086   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1087     IF check-state = "check":U THEN
     1088     DO:
     1089       RUN get-link-handle IN adm-broker-hdl
     1090         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1091            OUTPUT group-target-list).
     1092       IF group-target-list NE "":U THEN
     1093       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1094         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1095         RUN check-modified IN curr-widget ('group-check':U).
     1096         IF RETURN-VALUE NE "":U THEN
     1097         DO:
     1098           RUN check-modified-message(RETURN-VALUE).
     1099           RETURN "":U.
     1100         END.
     1101       END.
     1102     END.
     1103     RETURN "":U.
     1104   END PROCEDURE.
     1105   PROCEDURE check-modified-message :
     1106     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1107        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1108           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1109        IF RETURN-VALUE = "YES":U THEN
     1110           RUN notify ('view,CONTAINER-SOURCE':U).
     1111        MESSAGE IF p-changed-table NE ? THEN
     1112           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1113           ELSE "Current values have been changed."
     1114           SKIP "  Do you wish to save those changes?"
     1115           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1116        IF ANS THEN
     1117        DO:
     1118           IF group-assign-target THEN
     1119             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1120           ELSE RUN dispatch('update-record':U).
     1121           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1122           DO:
     1123               MESSAGE "Changes to the previous record were not saved."
     1124                 VIEW-AS ALERT-BOX ERROR.
     1125               IF group-assign-target THEN
     1126                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1127               ELSE RUN dispatch ('cancel-record':U).
     1128           END.
     1129        END.
     1130        ELSE DO:
     1131          IF group-assign-target THEN
     1132             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1133          ELSE RUN dispatch('cancel-record':U).
     1134        END.
     1135        RETURN.
     1136   END PROCEDURE.
     1137   PROCEDURE get-rowid :
     1138       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1139       ASSIGN
     1140       p-table   =   adm-first-table.
     1141       RETURN.
     1142   END PROCEDURE.
     1143   PROCEDURE init-group-assign :
     1144       RUN request-attribute IN adm-broker-hdl
     1145         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1146       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1147         group-assign-target = yes.
     1148       ELSE group-assign-target = no.
     1149       RETURN.
     1150   END PROCEDURE.
     1151   PROCEDURE set-editors :
     1152       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1153       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1154       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1155       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1156       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1157       DO WHILE VALID-HANDLE (curr-widget):
     1158           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1159              curr-widget:HIDDEN = no THEN DO:
     1160             CASE p-field-setting:
     1161               WHEN "INITIALIZE":U THEN
     1162               DO:
     1163                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1164                     read-only-list +
     1165                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1166                        STRING(curr-widget).
     1167               END.
     1168               WHEN "DISABLE":U OR
     1169               WHEN "ENABLE":U THEN
     1170               DO:
     1171                   curr-widget:SENSITIVE = yes.
     1172                   RUN get-attribute ('Read-Only-Editors':U).
     1173                   IF RETURN-VALUE = ? OR
     1174                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1175                       curr-widget:READ-ONLY =
     1176                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1177               END.
     1178               WHEN "CLEAR":U THEN
     1179                   curr-widget:SCREEN-VALUE = "":U.
     1180             END CASE.
     1181           END.
     1182           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1183       END.
     1184       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1185         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1186           + '"':U).
     1187       RETURN.
     1188   END PROCEDURE.
     1189   PROCEDURE use-check-modified-all :
     1190    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1191     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1192     RETURN.
     1193   END PROCEDURE.
     1194   PROCEDURE use-create-on-add :
     1195   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1196      RETURN.
     1197   END PROCEDURE.
     1198   PROCEDURE use-initial-lock :
     1199     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1200     ASSIGN adm-initial-lock = p-attr-value.
     1201     RETURN.
     1202   END PROCEDURE.
     1203     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1204   ASSIGN
     1205          FRAME F-Main:SCROLLABLE       = FALSE
     1206          FRAME F-Main:HIDDEN           = TRUE.
     1207   ON VALUE-CHANGED OF Classify IN FRAME F-Main
     1208   DO:
     1209     Assign Classify.
     1210      if Classify = "grp-goods":U
     1211            Then do:
     1212               display TOG-lavel   with frame F-Main .
     1213               enable  TOG-lavel   with frame F-Main .
     1214           end.
     1215            Else do:
     1216               TOG-lavel = false.
     1217               display  TOG-lavel  var-Lavel with frame F-Main .
     1218               disable  TOG-lavel  var-Lavel with frame F-Main .
     1219           end.
     1220   END.
     1221   ON VALUE-CHANGED OF RADIO-SET-1 IN FRAME F-Main
     1222   DO:
     1223     Assign radio-set-1.
     1224     case radio-set-1 :
     1225     when 1 then DO:
     1226             disable max-amount max-amount-2 min-sum with frame F-Main .
     1227            end.
     1228     when 2 then DO:
     1229             enable max-amount with frame F-Main .
     1230             disable max-amount-2 min-sum with frame F-Main .
     1231            end.
     1232     when 3 then DO:
     1233             disable max-amount with frame F-Main .
     1234             enable max-amount-2 min-sum with frame F-Main .
     1235              end.
     1236     End case.
     1237        display max-amount max-amount-2 min-sum with frame F-Main .
     1238   END.
     1239   ON VALUE-CHANGED OF Tog-1 IN FRAME F-Main
     1240   DO:
     1241     assign tog-1 .
     1242     if tog-1 then
     1243     enable week-1 week-12 week-2 week-22 week-3 week-32 week-4 week-42 week-5 week-52 with frame F-Main.
     1244     else
     1245     disable week-1 week-12 week-2 week-22 week-3 week-32 week-4 week-42 week-5 week-52 with frame F-Main.
     1246     display week-1 week-12 week-2 week-22 week-3 week-32 week-4 week-42 week-5 week-52 with frame F-Main.
     1247   END.
     1248   ON VALUE-CHANGED OF Tog-lavel IN FRAME F-Main
     1249   DO:
     1250     Assign tog-lavel.
     1251     if tog-lavel =TRUE
     1252           Then do:
     1253               display  var-Lavel  with frame F-Main .
     1254               enable   var-Lavel  with frame F-Main .
     1255           end.
     1256            Else do:
     1257               display    var-Lavel with frame F-Main .
     1258               disable    var-Lavel with frame F-Main .
     1259           end.
     1260   END.
     1261   if not this-procedure :persistent
     1262   then do:
     1263     message
     1264       vss-workfile vss-revision vss-description skip
     1265       "Ошибка при запуске процедуры" skip
     1266       "Данную процедуру следует запускать только с параметром persistent" skip
     1267       view-as alert-box error .
     1268     undo, return error .
     1269   end.
     1270   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1271   on ' ' of week-1 in frame F-Main
     1272   do:
     1273     if (can-query (self, "sensitive")
     1274        and
     1275        self :sensitive = true
     1276        )
     1277     or (can-query (self, "read-only")
     1278        and
     1279        self :read-only = false
     1280        )
     1281     then do:
     1282       assign
     1283         self :screen-value = ?
     1284       .
     1285     end.
     1286     return no-apply.
     1287   end.
     1288   on delete-character of week-1 in frame F-Main
     1289   do:
     1290     if (can-query (self, "sensitive")
     1291        and
     1292        self :sensitive = true
     1293        )
     1294     or (can-query (self, "read-only")
     1295        and
     1296        self :read-only = false
     1297        )
     1298     then do:
     1299       assign
     1300         self :screen-value = ?
     1301       .
     1302     end.
     1303     return no-apply.
     1304   end.
     1305   on ctrl-d of week-1 in frame F-Main
     1306   do:
     1307     define variable v-curr-sv-date as date no-undo .
     1308     if (can-query (self, "sensitive")
     1309        and
     1310        self :sensitive = true
     1311        )
     1312     or (can-query (self, "read-only")
     1313        and
     1314        self :read-only = false
     1315        )
     1316     then do:
     1317       if self :handle <> focus :handle
     1318       then do:
     1319         apply "entry":u to self .
     1320       end.
     1321       run gbl/getcurdt.p
     1322         (output v-curr-sv-date
     1323         ) .
     1324       assign
     1325         self :screen-value = string(v-curr-sv-date) .
     1326       .
     1327     end.
     1328     return no-apply.
     1329   end.
     1330   on ctrl-b of week-1 in frame F-Main
     1331   do:
     1332     if (can-query (self, "sensitive")
     1333        and
     1334        self :sensitive = true
     1335        )
     1336     or (can-query (self, "read-only")
     1337        and
     1338        self :read-only = false
     1339        )
     1340     then do:
     1341       if self :handle <> focus :handle
     1342       then do:
     1343         apply "entry":u to self .
     1344       end.
     1345       define variable v-curr-sv-date as date no-undo .
     1346       define variable v-new-sv-date  as date no-undo .
     1347       assign
     1348         v-curr-sv-date = date(self :screen-value) no-error
     1349       .
     1350       if v-curr-sv-date = ?
     1351       then do:
     1352         run gbl/getcurdt.p
     1353           (output v-curr-sv-date
     1354           ) .
     1355       end.
     1356       if v-curr-sv-date <> ?
     1357       then do:
     1358         assign
     1359           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     1360         .
     1361         assign
     1362           self :screen-value = string(v-new-sv-date) .
     1363         .
     1364       end.
     1365     end.
     1366     return no-apply .
     1367   end.
     1368   on ctrl-e of week-1 in frame F-Main
     1369   do:
     1370     if (can-query (self, "sensitive")
     1371        and
     1372        self :sensitive = true
     1373        )
     1374     or (can-query (self, "read-only")
     1375        and
     1376        self :read-only = false
     1377        )
     1378     then do:
     1379       if self :handle <> focus :handle
     1380       then do:
     1381         apply "entry":u to self .
     1382       end.
     1383       define variable v-curr-sv-date as date no-undo .
     1384       define variable v-new-sv-date  as date no-undo .
     1385       assign
     1386         v-curr-sv-date = date(self :screen-value) no-error
     1387       .
     1388       if v-curr-sv-date = ?
     1389       then do:
     1390         run gbl/getcurdt.p
     1391           (output v-curr-sv-date
     1392           ) .
     1393       end.
     1394       if v-curr-sv-date <> ?
     1395       then do:
     1396         run gbl/lastdate.p
     1397           (input  v-curr-sv-date
     1398           ,output v-new-sv-date
     1399           ).
     1400         assign
     1401           self :screen-value = string(v-new-sv-date) .
     1402         .
     1403       end.
     1404     end.
     1405     return no-apply .
     1406   end.
     1407   on ctrl-f of week-1 in frame F-Main
     1408   do:
     1409     if (can-query (self, "sensitive")
     1410        and
     1411        self :sensitive = true
     1412        )
     1413     or (can-query (self, "read-only")
     1414        and
     1415        self :read-only = false
     1416        )
     1417     then do:
     1418       if self :handle <> focus :handle
     1419       then do:
     1420         apply "entry":u to self .
     1421       end.
     1422       define variable v-ok            as logical   no-undo .
     1423       define variable v-curr-sv-date  as date      no-undo .
     1424       define variable v-description   as character no-undo .
     1425       assign
     1426         v-curr-sv-date = date(self :screen-value) no-error
     1427       .
     1428       if v-curr-sv-date = ?
     1429       then do:
     1430         run gbl/getcurdt.p
     1431           (output v-curr-sv-date
     1432           ) .
     1433       end.
     1434       if v-curr-sv-date <> ?
     1435       then do:
     1436         run gbl/d-inpday.w
     1437           (input ?
     1438           ,input "Выбор даты"
     1439           ,input v-description
     1440           ,input ""
     1441           ,input-output v-curr-sv-date
     1442           ,output v-ok
     1443           ).
     1444         if v-ok = true
     1445         then do:
     1446           assign
     1447             self :screen-value = string(v-curr-sv-date) .
     1448           .
     1449         end.
     1450       end.
     1451     end.
     1452     return no-apply .
     1453   end.
     1454     define MENU m-ed-date14
     1455       MENU-ITEM m-ed-date14-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
     1456       MENU-ITEM m-ed-date14-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
     1457       MENU-ITEM m-ed-date14-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
     1458       MENU-ITEM m-ed-date14-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
     1459       .
     1460     if week-1 :POPUP-MENU in frame F-Main = ?
     1461     then do:
     1462       ASSIGN
     1463         week-1 :POPUP-MENU in frame F-Main = MENU m-ed-date14 :HANDLE
     1464         week-1 :MENU-MOUSE in frame F-Main = 3
     1465       .
     1466     end.
     1467     define variable v-label-handle14 as handle no-undo .
     1468     assign
     1469       v-label-handle14 = week-1 :side-label-handle in frame F-Main
     1470     .
     1471     if valid-handle (v-label-handle14)
     1472     then do:
     1473       if v-label-handle14 :tooltip = ""
     1474       or v-label-handle14 :tooltip = ?
     1475       then do:
     1476         assign
     1477           v-label-handle14 :tooltip = "Ctrl-D - текущая, Ctrl-B - начало, Ctrl-E - конец, Ctrl-F - календарь, Прав.Клавиша Мыши - Popup Menu"
