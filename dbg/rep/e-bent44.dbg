      751        VIEW-AS RADIO-SET VERTICAL
      752        RADIO-BUTTONS
      753             "все", 1,
      754   "Показать с MAX реализацией", 2,
      755   "Показать с MIN реализацией", 3
      756        SIZE 29.13 BY 3.04 NO-UNDO.
      757   DEFINE VARIABLE SortType AS CHARACTER
      758        VIEW-AS RADIO-SET VERTICAL
      759        RADIO-BUTTONS
      760             "по коду", "sort-code":U,
      761   "по артикулу", "sort-artic":U,
      762   "по реализации", "sort-qunty":U,
      763   "по наименованию", "sort-name":U
      764        SIZE 20.75 BY 3.88
      765        FGCOLOR 0  NO-UNDO.
      766   DEFINE RECTANGLE RECT-5
