     3062   PROCEDURE disable_UI :
     3063     HIDE FRAME F-Main.
     3064     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     3065   END PROCEDURE.
     3066   PROCEDURE find-fo :
     3067   def input  parameter date1 as date no-undo.
     3068   def input  parameter date2 as date no-undo.
     3069   def output parameter f-1   like ot-line.fact-order no-undo.
     3070   def output parameter f-2   like ot-line.fact-order no-undo.
     3071      Assign f-1 = Integer(date1 - 1 ) + 0.99  f-2 = Integer(date2) + 0.99 .
     3072   END PROCEDURE.
     3073   PROCEDURE local-initialize :
     3074     RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     3075      disable max-amount-2 min-sum with frame F-Main .
     3076      RAdio-set-1:screen-value      in frame F-Main = '1'.
     3077      Tog-obj:screen-value      in frame F-Main = 'yes'.
     3078      Tog-1:screen-value      in frame F-Main = 'yes'.
     3079      Tog-kass:screen-value      in frame F-Main = 'yes'.
     3080      Tog-ras:screen-value      in frame F-Main = 'yes'.
     3081      Tog-voz:screen-value      in frame F-Main = 'yes'.
     3082      Tog-lavel:screen-value      in frame F-Main = 'no'.
     3083      var-lavel:screen-value    in frame F-Main = '1'.
     3084      min-sum:screen-value      in frame F-Main = '0'.
     3085      max-amount:screen-value   in frame F-Main = '20'.
     3086      max-amount-2:screen-value in frame F-Main = '20'.
     3087      max-amount   = 20.
     3088      max-amount-2 = 20.
     3089   END PROCEDURE.
     3090   PROCEDURE my-report :
     3091   if tog-obj = true  then do:
     3092         run cus/r-benet4.p (input v-cntxt-obj-code,input v-cntxt-obj-type,input base-type, input base-code, input Classify, input SortType, input false, input false, input Tog-obj, input tog-lavel, input var-lavel, input radio-set-1,input max-amount, input max-amount-2,input min-sum, input tog-kass,input tog-ras, input tog-voz, input fo1,input fo12, input fo2,input fo22,input fo3,input fo32,input fo4,input fo42,input fo5,input fo52,input tog-1 ). .
     3093   end.
     3094   Else do:
     3095           run cus/r-bene4n.p (input v-cntxt-obj-code,input v-cntxt-obj-type,input base-type, input base-code, input Classify, input SortType, input false, input false, input Tog-obj, input tog-lavel, input var-lavel, input radio-set-1,input max-amount, input max-amount-2,input min-sum, input tog-kass,input tog-ras, input tog-voz, input fo1,input fo12, input fo2,input fo22,input fo3,input fo32,input fo4,input fo42,input fo5,input fo52,input tog-1 ). .
     3096   End.
     3097   END PROCEDURE.
     3098   PROCEDURE my-var :
     3099   def var M as int no-undo.
     3100     define variable v-check-date as date      no-undo .
     3101     define variable v-archive-ok as logical   no-undo .
     3102     define variable v-comment    as character no-undo .
     3103     define variable v-can-print  as logical   no-undo .
     3104   assign frame F-Main
     3105   tog-obj tog-lavel var-lavel tog-1
     3106   Classify SortType
     3107   max-amount
     3108   max-amount-2
     3109   min-sum
     3110   tog-kass
     3111   tog-ras
     3112   tog-voz
     3113   radio-set-1
     3114   week-1
     3115   week-12
     3116   week-2
     3117   week-22
     3118   week-3
     3119   week-32
     3120   week-4
     3121   week-42
     3122   week-5
     3123   week-52
     3124   .
     3125   if
     3126   week-1  = ? OR
     3127   week-12 = ? OR
     3128   week-2  = ? OR
     3129   week-22 = ? OR
     3130   week-3  = ? OR
     3131   week-32 = ? OR
     3132   week-4  = ? OR
     3133   week-42 = ? OR
     3134   week-5  = ? OR
     3135   week-52 = ?  THEN DO:
     3136        MEssage 'Не заданы интервалы просмотра реализации ! ' view-as alert-box error.
     3137        RETURN 'Second-page':U  . End.
     3138   Assign
     3139    STR-obj-type = ''
     3140    STR-obj-code = ''
     3141    STR-obj-name = ''
     3142    STR-obj      = ''.
     3143   For each obj-list no-lock:
     3144    Assign
     3145    STR-obj-type = STR-obj-type + obj-list.obj-type + ','
     3146    STR-obj-code = STR-obj-code + String(obj-list.obj-code) + ','
     3147    STR-obj-name = STR-obj-name + obj-list.obj-name + ','
     3148    STR-obj = STR-obj +  obj-list.obj-type + '#' + string(obj-list.obj-code)  + ',' .
     3149   End.
     3150   ReportNAme = "О Т Ч Е Т   П О   Р Е А Л И З А Ц И И   В  М А Г А З И Н Е".
     3151   def var t-class as char no-undo.
     3152   def var t-sort as char no-undo.
     3153     case classify:
     3154       when "no-classify":u    then t-class =   "Без классификации" .
     3155       when "prod":u           then t-class =   "Производители"   .
     3156       when "post":u           then t-class =   "Поставщики"   .
     3157       when "grp-goods":u      then t-class =   "Группы товаров"  .
     3158       when "post/grp-goods":u then t-class =   "Поставщики/Группы товаров" .
     3159       when "prod/grp-goods":u then t-class =   "Производители/Группы товаров" .
     3160       when "grp-goods/prod":u then t-class =   "Группы товаров/Производители" .
     3161       when "grp-goods/post":u then t-class =   "Группы товаров/Поставщики" .
     3162       when  "vat-ps":u        then t-class =   "Ставка НДС" .
     3163       when  "sort":u          then t-class =   "Проба(Сорт)" .
     3164       when  "n-level":u       then t-class =   "Группы с уровнем вложенности " .
     3165       when  "t-level":u       then t-class =   "Терминальные группы" .
     3166    end case.
     3167     case sorttype:
     3168       when "sort-pp":u               then t-sort =   "по порядку" .
     3169       when "sort-code":u             then t-sort =   "по коду" .
     3170       when "sort-artic":u            then t-sort =   "по артикулу"  .
     3171       when "sort-qunty":u            then t-sort =   "по реализации".
     3172       when "sort-name":u             then t-sort =   "по наименованию".
     3173       when "sort-type":u             then t-sort =   "по типу ткани".
     3174       when "sort-doc-code":u         then t-sort =   "по номеру документа".
     3175       when "sort-recipe-code":u      then t-sort =   "по номеру рецепта".
     3176    end case.
     3177   ReportHeader = "Классификация : " + t-Class.
     3178   ReportHeader = ReportHeader +
     3179                  (if tog-lavel  then "    Итоги с уровня  "  + String(var-lavel)  else " "    ).
     3180   ReportHeader = ReportHeader + chr(10) +
     3181                  "Сортировка " + (t-Sort)  + chr(10) .
     3182   case radio-set-1 :
     3183   When 2 then
     3184       ReportHeader = ReportHeader + string(max-amount) + ' с наибольшей реализацией ' + chr(10).
     3185   When 3 then
     3186       ReportHeader = ReportHeader + string(max-amount-2) + ' с наименьшей реализацией, но большей ' + string(min-sum) + ' руб.' + chr(10).
     3187   End case.
     3188   ReportHeader = ReportHeader +
     3189                  "Виды продаж : " + if (tog-kass) then 'касса продажа':U Else ""   .
     3190   ReportHeader = ReportHeader +  " , " +
     3191                   if (tog-ras) then 'расход внешний':U Else ""   .
     3192   ReportHeader = ReportHeader +  " , " +
     3193                   if (tog-voz) then 'возврат внешний':U Else ""   .
     3194      if tog-1 then DO:
     3195       ReportHeader = ReportHeader  + chr(10) + if week-1  <> DATE('')   THEN  " 1я неделя " + String(week-1,"99/99/9999")          ELSE ""  .
     3196       ReportHeader = ReportHeader  + if week-12 <> DATE('')   THEN  " по " + String(week-12,"99/99/9999")      + chr(10) ELSE ""  .
     3197       ReportHeader = ReportHeader  + if week-2  <> DATE('')   THEN  " 2я неделя " + String(week-2,"99/99/9999")          ELSE ""  .
     3198       ReportHeader = ReportHeader  + if week-22 <> DATE('')   THEN  " по " + String(week-22,"99/99/9999")      + chr(10) ELSE ""  .
     3199       ReportHeader = ReportHeader  + if week-3  <> DATE('')   THEN  " 3я неделя " + String(week-3,"99/99/9999")          ELSE ""  .
     3200       ReportHeader = ReportHeader  + if week-32 <> DATE('')   THEN  " по " + String(week-32,"99/99/9999")      + chr(10) ELSE ""  .
     3201       ReportHeader = ReportHeader  + if week-4  <> DATE('')   THEN  " 4я неделя " + String(week-4,"99/99/9999")          ELSE ""  .
     3202       ReportHeader = ReportHeader  + if week-42 <> DATE('')   THEN  " по " + String(week-42,"99/99/9999")      + chr(10) ELSE ""  .
     3203       ReportHeader = ReportHeader  + if week-5  <> DATE('')   THEN  " 5я неделя " + String(week-5,"99/99/9999")          ELSE ""  .
     3204       ReportHeader = ReportHeader  + if week-52 <> DATE('')   THEN  " по " + String(week-52,"99/99/9999")      + chr(10) ELSE "" .
     3205     assign
     3206       v-check-date = maximum( week-1  ,
     3207                         week-12 ,
     3208                         week-2  ,
     3209                         week-22 ,
     3210                         week-3  ,
     3211                         week-32 ,
     3212                         week-4  ,
     3213                         week-42 ,
     3214                         week-5  ,
     3215                         week-52 )
     3216     .
     3217     for each obj-list no-lock
     3218     :
     3219       run rep/chk-ahz.p
     3220         (input        obj-list.obj-type
     3221         ,input        obj-list.obj-code
     3222         ,input        true
     3223         ,input        true
     3224         ,input        false
     3225         ,input        false
     3226         ,input        true
     3227         ,input        v-cntxt-db-num
     3228         ,input        v-cntxt-userid
     3229         ,input-output v-check-date
     3230         ,input-output v-check-date
     3231         ,output       v-archive-ok
     3232         ,output       v-comment
     3233         ,output       v-can-print
     3234         ) .
     3235     end.
     3236     run find-fo in this-procedure
     3237       (input  week-1
     3238       ,input  week-12
     3239       ,output fo1
     3240       ,output fo12
     3241       ).
     3242     run find-fo in this-procedure
     3243       (input  week-2
     3244       ,input  week-22
     3245       ,output fo2
     3246       ,output fo22
     3247       ).
     3248     run find-fo in this-procedure
     3249       (input  week-3
     3250       ,input  week-32
     3251       ,output fo3
     3252       ,output fo32
     3253       ).
     3254     run find-fo in this-procedure
     3255       (input  week-4
     3256       ,input  week-42
     3257       ,output fo4
     3258       ,output fo42
     3259       ).
     3260     run find-fo in this-procedure
     3261       (input  week-5
     3262       ,input  week-52
     3263       ,output fo5
     3264       ,output fo52
     3265       ).
     3266    sheetf.Excel-Column-Lable = "Артикул,Наименование,Процент (%),Реализация,,Среднесут.реализация,, " +
     3267    "Реализация 1 неделя " + ",," +
     3268    "Реализация 2 неделя " + ",," +
     3269    "Реализация 3 неделя " + ",," +
     3270    "Реализация 4 неделя " + ",," +
     3271    "Реализация 5 неделя " + ",," +
     3272    chr(10) .
     3273    sheetf.Excel-Column-Lable = sheetf.Excel-Column-Lable + ",,,Количество,Сумма,Количество,Сумма" +
     3274      ",Количество,Сумма" +
     3275      ",Количество,Сумма" +
     3276      ",Количество,Сумма" +
     3277      ",Количество,Сумма" +
     3278      ",Количество,Сумма" .
     3279    sheetf.Sizes = '16,60,12,13,13,13,13,13,13,13,13,13,13,13,13,13,13,' .
     3280    End.
     3281    Else DO:
     3282    sheetf.Excel-Column-Lable = "Артикул,Наименование,Процент (%),Реализация,,Среднесут.реализация,, " +
     3283    chr(10) .
     3284    sheetf.Excel-Column-Lable = sheetf.Excel-Column-Lable + ",,,Количество,Сумма,Количество,Сумма" .
     3285    sheetf.Sizes = '16,60,12,13,13,13,13,' .
     3286    End.
     3287    str2=''.
     3288   END PROCEDURE.
     3289   PROCEDURE state-changed :
     3290     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     3291     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     3292     def var month-1 as date no-undo .
     3293     def var month-2 as date no-undo .
     3294     def var nn as int no-undo.
     3295     def var ret# as log no-undo.
     3296     CASE p-state:
     3297       when "link-changed" then  DO:
     3298            End.
     3299     END CASE.
     3300     if month-1 = ? THEN   month-1 = DAte(month(x-Date-Start ),1,year(x-Date-Start )).
     3301   if month-2 = ? THEN   DO:
     3302       month-2 = x-Date-Start  .
     3303       run gbl/lastdate.p
     3304         (input  month-2
     3305         ,output month-2  ).
     3306       End.
     3307   NN = Weekday(DAte(month(month-1 ),1,year(month-1)))  .
     3308   if week-1  = ? THEN   week-1  = month-1 + (2 - NN)                             .
     3309   if week-12 = ? THEN   week-12 = week-1 +  6                                  .
     3310   if week-2  = ? THEN   week-2  = week-12 + 1                                  .
     3311   if week-22 = ? THEN   week-22 = week-2  + 6                                  .
     3312   if week-3  = ? THEN   week-3  = week-22 + 1                                  .
     3313   if week-32 = ? THEN   week-32 = week-3  + 6                                  .
     3314   if week-4  = ? THEN   week-4  = week-32 + 1                                  .
     3315   if week-42 = ? THEN   week-42 = week-4  + 6                                  .
     3316   if week-5  = ? THEN   week-5  = week-42 + 1                                  .
     3317   if week-52 = ? THEN   week-52 = week-5 + 6                                   .
     3318   if date(week-1:screen-value in frame F-Main) <> ? then
     3319    assign frame F-Main
     3320   week-1
     3321   week-12
     3322   week-2
     3323   week-22
     3324   week-3
     3325   week-32
     3326   week-4
     3327   week-42
     3328   week-5
     3329   week-52
     3330   .
     3331   display  week-1 week-12 week-2 week-22 week-3 week-32 week-4 week-42 week-5 week-52 with frame F-Main.
     3332   END PROCEDURE.
