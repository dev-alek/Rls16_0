      583   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      584   procedure proc-alt-shift-f2:
      585     if not ibs.th.gbl.gbl-var:rcode
      586   then
      587     run gbl\inidebug.p .
      588   end.
      589   procedure proc-alt-shift-f3:
      590     run gbl/prvssinf.p
      591       ( input this-procedure
      592       ) .
      593   end.
      594   define variable v-inform-launched as logical no-undo initial false .
      595   procedure proc-alt-shift-f4:
      596     define variable v-action as character no-undo .
      597     if v-inform-launched = false then do:
      598       assign
      599         v-inform-launched = true
      600       .
      601       run gbl/d-inform.w
      602         (  input self
      603         ,  input this-procedure
      604         , output v-action
      605         ) no-error .
      606       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      607       assign
      608         v-inform-launched = false
      609       .
      610     end.
      611   end.
      612   procedure proc-alt-f1:
      613     run gbl/corrhelp.p
      614       (input this-procedure
      615       ) .
      616   end .
      617   on alt-shift-f2 anywhere do:
      618     run proc-alt-shift-f2.
      619   end.
      620   on alt-shift-f3 anywhere do:
      621     run proc-alt-shift-f3 in this-procedure .
      622   end.
      623   on alt-shift-f4 anywhere do:
      624     run proc-alt-shift-f4 in this-procedure.
      625   end.
      626   on alt-f1 anywhere do:
      627     run proc-alt-f1 in this-procedure .
      628   end.
      629   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
