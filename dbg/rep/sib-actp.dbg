     1150   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1151   define new global shared variable g#trdcalib as handle no-undo.
     1152   procedure wthcattr-sprcli :
     1153   define input parameter parparentproc  as widget-handle no-undo.
     1154   define input parameter p-mode  as character no-undo.
     1155   define input-output parameter p-value as character no-undo .
     1156   define output parameter p-setted as logical no-undo .
     1157     DEFINE VARIABLE v-value as character no-undo .
     1158     define variable v-cli-type as character no-undo .
     1159     define variable v-cli-code as integer no-undo .
     1160     define buffer buf_clients   for ub.clients.
     1161     define variable v_rid as character no-undo.
     1162     define variable ref-rec as recid no-undo .
     1163     do
     1164     on error undo, return error
     1165     :
     1166         v-value = p-value.
     1167      if p-value <> '':U then do:
     1168       assign
     1169       v-cli-type = substring(p-value, 1, 3)
     1170       v-cli-code = integer(substring(p-value, 4))
     1171       no-error.
     1172       if error-status:error then do:
     1173         assign
     1174         v-cli-type = '':U
     1175         v-cli-code = 0
     1176         .
     1177       end.
     1178      end.
     1179      FIND FIRST buf_clients NO-LOCK WHERE
     1180               buf_clients.obj-type = v-cli-type AND
     1181               buf_clients.obj-code = v-cli-code  NO-ERROR.
     1182      IF available(buf_clients) then do:
     1183       run ref/cli-all.w (
     1184                   input parparentproc
     1185                  ,input if p-mode = 'ИЗМЕНЕНИЕ':U then "b-sel":U else "":U
     1186                  ,input v-cli-type
     1187                  ,input 'все':U
     1188                  ,input 'все':U
     1189                  ,input RECID( buf_clients )
     1190                  ,input ",,,,,,NO"
     1191                  ,input ?
     1192                  ,OUTPUT v_rid ).
     1193     END.
     1194     ELSE if p-mode = 'ИЗМЕНЕНИЕ':U then DO:
     1195       run ref/cli-all.w (
     1196                    input parparentproc
     1197                   ,INPUT "b-sel":U
     1198                  ,input  v-cli-type
     1199                  ,input 'все':U
     1200                  ,input 'текущие':U
     1201                  ,input ?
     1202                  ,input ",,,,,,NO"
     1203                  ,input ?
     1204                  ,OUTPUT v_rid ).
     1205     END.
     1206     else do:
     1207       message
     1208       if p-value = "":U then 'Атрибут не задан!'
     1209       else substitute('Не найден клиент &1',p-value)
     1210       view-as alert-box warning.
     1211     end.
     1212     IF v_rid <> ? AND v_rid <> "":U THEN DO:
     1213       ASSIGN ref-rec = INT( v_rid ) NO-ERROR.
     1214       IF ERROR-STATUS:ERROR THEN DO:
     1215           RETURN NO-APPLY.
     1216       END.
     1217       FIND FIRST buf_clients NO-LOCK WHERE
     1218                  RECID( buf_clients ) = ref-rec NO-ERROR.
     1219       IF AVAIL buf_clients THEN DO:
     1220         v-value = buf_clients.obj-type + string(buf_clients.obj-code, ">>>>>>>>9").
     1221       end.
     1222     end.
     1223     if v-value <> p-value then do:
     1224       p-value = v-value.
     1225       p-setted = yes.
     1226     end.
     1227     end.
     1228   end procedure.
     1229     define new global shared variable g#wthcalib as handle no-undo.
     1230   procedure torgconf-read :
     1231   do
     1232   on error undo, return error
     1233   :
     1234       define input parameter p-form-name  as character    no-undo.
     1235       define input parameter p-host-code  as integer      no-undo.
     1236       define input parameter p-obj-type   as character    no-undo.
     1237       define input parameter p-obj-code   as integer      no-undo.
     1238       define variable v-outdate   as character     no-undo.
     1239       define variable v-outares   as character     no-undo.
     1240       define variable v-outsend   as character     no-undo.
     1241       define variable v-outasend  as character     no-undo.
     1242       define variable v-outprops  as character     no-undo.
     1243       define variable v-outnum    as character     no-undo.
     1244       define variable v-outprim   as character     no-undo.
     1245       define variable v-outdisc   as character     no-undo.
     1246       define variable v-outsubs   as character     no-undo.
     1247       define variable v-outrecv   as character     no-undo.
     1248       define variable v-outegrp   as character     no-undo.
     1249       define variable v-outt12    as character     no-undo.
     1250       define variable v-outappr   as character     no-undo.
     1251       define variable v-outrubl   as character     no-undo.
     1252       define variable v-outhold   as character     no-undo.
     1253       define variable v-outobj    as character     no-undo.
     1254       define variable v-outexlst  as character     no-undo.
     1255       define variable v-outprncd  as character     no-undo.
     1256       define variable v-par-type  as character     no-undo.
     1257       define variable v-outogr    as character     no-undo.
     1258       define variable v-outR      as character     no-undo.
     1259       define variable v-outB      as character     no-undo.
     1260       define variable v-outC      as character     no-undo.
     1261       assign
     1262           v-torgconf-outdate  = no
     1263           v-torgconf-outnum   = no
     1264           v-torgconf-outprim  = no
     1265           v-torgconf-outdisc  = no
     1266           v-torgconf-outsubs  = no
     1267           v-torgconf-outrecv  = no
     1268           v-torgconf-outegrp  = no
     1269           v-torgconf-outt12   = no
     1270           v-torgconf-outappr  = no
     1271           v-torgconf-outrubl  = no
     1272           v-torgconf-outhold  = no
     1273           v-torgconf-outobj   = no
     1274           v-torgconf-outexlst = no
     1275           v-torgconf-outexpas = "":U
     1276           v-torgconf-outprncd = yes
     1277           v-torgconf-outares  = no
     1278           v-torgconf-outsend  = no
     1279           v-torgconf-outasend  = no
     1280           v-torgconf-outprops  = no
     1281           v-form-name          = p-form-name
     1282       .
     1283   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1284   empty temp-table thbjattr_thbj-attr.
     1285   run adm/shattri.p (
     1286      input "get":U
     1287     ,input ''
     1288     ,input 0
     1289     ,input 'prt-glob':U
     1290     ,input  ""
     1291     ,output v-value-character
     1292     ,output v-value-date
     1293     ,output v-value-decimal
     1294     ,output v-value-integer
     1295     ,output v-value-logical
     1296     ,output par-type
     1297     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1298     ) no-error .
     1299   for each thbjattr_thbj-attr :
     1300       if thbjattr_thbj-attr.prop-code = 'outprncd':U then v-outprncd =  string(thbjattr_thbj-attr.property-value-logical) .
     1301       if thbjattr_thbj-attr.prop-code = 'outrecv':U  then v-outrecv  =  thbjattr_thbj-attr.property-value-character .
     1302       if thbjattr_thbj-attr.prop-code = 'outprops':U then v-outprops =  thbjattr_thbj-attr.property-value-character .
     1303   end.
     1304   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1305   empty temp-table thbjattr_thbj-attr.
     1306   run adm/shattri.p (
     1307      input "get":U
     1308     ,input p-obj-type
     1309     ,input p-obj-code
     1310     ,input 'prt-obj':U
     1311     ,input  ""
     1312     ,output v-value-character
     1313     ,output v-value-date
     1314     ,output v-value-decimal
     1315     ,output v-value-integer
     1316     ,output v-value-logical
     1317     ,output par-type
     1318     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1319     ) no-error .
     1320   for each thbjattr_thbj-attr :
     1321       if thbjattr_thbj-attr.prop-code = 'outdate':U  then v-outdate  =  thbjattr_thbj-attr.property-value-character .
     1322       if thbjattr_thbj-attr.prop-code = 'outares':U  then v-outares  =  thbjattr_thbj-attr.property-value-character .
     1323       if thbjattr_thbj-attr.prop-code = 'outnum':U   then v-outnum   =  thbjattr_thbj-attr.property-value-character .
     1324       if thbjattr_thbj-attr.prop-code = 'outprim':U  then v-outprim  =  thbjattr_thbj-attr.property-value-character .
     1325       if thbjattr_thbj-attr.prop-code = 'outdisc':U  then v-outdisc  =  thbjattr_thbj-attr.property-value-character .
     1326       if thbjattr_thbj-attr.prop-code = 'outsubs':U  then v-outsubs  =  thbjattr_thbj-attr.property-value-character .
     1327       if thbjattr_thbj-attr.prop-code = 'outegrp':U  then v-outegrp  =  thbjattr_thbj-attr.property-value-character .
     1328       if thbjattr_thbj-attr.prop-code = 'outt12':U   then v-outt12   =  thbjattr_thbj-attr.property-value-character .
     1329       if thbjattr_thbj-attr.prop-code = 'outappr':U  then v-outappr  =  thbjattr_thbj-attr.property-value-character .
     1330       if thbjattr_thbj-attr.prop-code = 'outrubl':U  then v-outrubl  =  thbjattr_thbj-attr.property-value-character .
     1331       if thbjattr_thbj-attr.prop-code = 'outhold':U  then v-outhold  =  thbjattr_thbj-attr.property-value-character .
     1332       if thbjattr_thbj-attr.prop-code = 'outobj':U   then v-outobj   =  thbjattr_thbj-attr.property-value-character .
     1333       if thbjattr_thbj-attr.prop-code = 'outsend':U  then v-outsend  =  thbjattr_thbj-attr.property-value-character .
     1334       if thbjattr_thbj-attr.prop-code = 'outasend':U then v-outasend =  thbjattr_thbj-attr.property-value-character .
     1335       if thbjattr_thbj-attr.prop-code = 'outogr':U   then v-torgconf-outogr   =  thbjattr_thbj-attr.property-value-character .
     1336       if thbjattr_thbj-attr.prop-code = 'outR':U     then v-torgconf-outR     =  thbjattr_thbj-attr.property-value-character .
     1337       if thbjattr_thbj-attr.prop-code = 'outB':U     then v-torgconf-outB     =  thbjattr_thbj-attr.property-value-character .
     1338       if thbjattr_thbj-attr.prop-code = 'outssdoc':U then v-torgconf-outssdoc =  thbjattr_thbj-attr.property-value-character .
     1339       if thbjattr_thbj-attr.prop-code = 'outC':U     then v-torgconf-outC     =  thbjattr_thbj-attr.property-value-character .
     1340   end.
     1341       run gbl/conf-rd.p ("outexpas", "":U, "":U, 0, "":U, "":U, "":U, no, output v-torgconf-outexpas, output v-par-type) no-error.
     1342       if error-status :error
     1343       then do:
     1344           assign
     1345               v-torgconf-outexpas = "":U
     1346           .
     1347       end.
     1348       assign
     1349           v-torgconf-outprncd = ( v-outprncd = "yes":U )
     1350       .
     1351       if p-form-name <> ""
     1352       and p-form-name <> ?
     1353       then do:
     1354           run gbl/conf-rd.p ("outexlst" , p-host-code, p-obj-type, p-obj-code, "", "", "", no, output v-outexlst , output v-par-type) no-error.
     1355           if error-status :error
     1356           then do:
     1357               assign
     1358                   v-outexlst           = ""
     1359               .
     1360           end.
     1361           if lookup( p-form-name, v-outdate ) <> 0
     1362           then do:
     1363               assign
     1364                   v-torgconf-outdate  = yes
     1365               .
     1366           end.
     1367           if lookup( p-form-name, v-outares ) <> 0
     1368           then do:
     1369               assign
     1370                   v-torgconf-outares  = yes
     1371               .
     1372           end.
     1373           if lookup( p-form-name, v-outnum  ) <> 0
     1374           then do:
     1375               assign
     1376                   v-torgconf-outnum   = yes
     1377               .
     1378           end.
     1379           if lookup( p-form-name, v-outprim ) <> 0
     1380           then do:
     1381               assign
     1382                   v-torgconf-outprim  = yes
     1383               .
     1384           end.
     1385           if lookup( p-form-name, v-outdisc ) <> 0
     1386           then do:
     1387               assign
     1388                   v-torgconf-outdisc  = yes
     1389               .
     1390           end.
     1391           if lookup( p-form-name, v-outsubs ) <> 0
     1392           then do:
     1393               assign
     1394                   v-torgconf-outsubs  = yes
     1395               .
     1396           end.
     1397           if lookup( p-form-name, v-outrecv ) <> 0
     1398           then do:
     1399               assign
