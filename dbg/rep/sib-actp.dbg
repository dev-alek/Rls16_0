     4317   define variable v-host-code             as integer     no-undo .
     4318   define variable v-curr-code             as integer     no-undo .
     4319   define frame sib-act
     4320     sym1                        no-label format "X(1)"                          space(0)
     4321     tt-report.col-1             no-label format "X(20)"                   space(0)
     4322     sym2                        no-label format "X(1)"                          space(0)
