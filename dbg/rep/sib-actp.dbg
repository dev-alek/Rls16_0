     4326     sym4                        no-label format "X(1)"                          space(0)
     4327     tt-report.col-4             no-label format "X(10)"                   space(0)
     4328     sym5                        no-label format "X(1)"                          space(0)
     4329     tt-report.col-5             no-label format "X(10)"                   space(0)
