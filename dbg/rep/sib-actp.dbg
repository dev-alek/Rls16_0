     1773       define variable p-torgconf-ndovwho-type         as character no-undo.
     1774       define variable p-torgconf-accept-n-type        as character no-undo.
     1775   if valid-handle( g#wthcalib ) <> yes then do:       run str/wthcalib.p persistent no-error.       if error-status :error or valid-handle( g#wthcalib ) <> yes then do:         message "Error starting wthcalib.p"    skip( 0 )                 g#wthcalib                     skip( 0 )                 g#wthcalib   :type             skip( 0 )                 g#wthcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run wthcalib_wthat-val in g#wthcalib (  input p-torgconfdoc-code ,
     1776                           input 'wthproxy':U ,
     1777                          output p-torgconf-ndovwho ,
     1778                          output p-torgconf-ndovwho-type ) no-error .
     1779         if error-status :error then do:
     1780         message
     1781            vss-workfile vss-revision vss-description skip
     1782            "Ошибка при вызове процедуры tdat-val":U skip
     1783            "Документ: " p-torgconfdoc-code skip
     1784            "Атрибут: " 'wthproxy':U skip
     1785            "Значение: " p-torgconf-ndovwho skip
     1786            trim( error-status :get-message (1) ) skip
     1787            return-value skip
     1788            view-as alert-box error.
     1789         undo, return error return-value.
     1790         end.
     1791   if valid-handle( g#wthcalib ) <> yes then do:       run str/wthcalib.p persistent no-error.       if error-status :error or valid-handle( g#wthcalib ) <> yes then do:         message "Error starting wthcalib.p"    skip( 0 )                 g#wthcalib                     skip( 0 )                 g#wthcalib   :type             skip( 0 )                 g#wthcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run wthcalib_wthat-val in g#wthcalib (  input p-torgconfdoc-code ,
     1792                           input 'wthreceiver':U ,
     1793                          output p-torgconf-accept-fname ,
     1794                          output p-torgconf-accept-n-type ) no-error .
     1795         if error-status :error then do:
     1796         message
     1797            vss-workfile vss-revision vss-description skip
     1798            "Ошибка при вызове процедуры tdat-val":U skip
     1799            "Документ: " p-torgconfdoc-code skip
     1800            "Атрибут: " 't_accept-fname':U skip
     1801            "Значение: " p-torgconf-accept-fname skip
     1802            trim( error-status :get-message (1) ) skip
     1803            return-value skip
     1804            view-as alert-box error.
     1805         undo, return error return-value.
     1806         end.
     1807     end procedure.
     1808   procedure torgconf-get-sup-param :
     1809   define input parameter p-obj-type           as character        no-undo.
     1810   define input parameter p-obj-code           as integer          no-undo.
     1811   define input parameter p-curr-code          as integer          no-undo.
     1812       define variable v-host-code    as integer      no-undo.
     1813       define variable v-par-type     as character    no-undo.
     1814   do
     1815   on error undo, return error
     1816   :
     1817       assign
     1818          v-torgconf-sup-host-code = v-host-code
     1819       .
     1820       if v-torgconf-sup-host-code = 0
     1821       then do:
     1822           assign
     1823               v-torgconf-sup-host-name           = "":U
     1824               v-torgconf-sup-host-addres         = "":U
     1825               v-torgconf-sup-host-post-addres    = "":U
     1826               v-torgconf-sup-host-phone          = "":U
     1827               v-torgconf-sup-host-inn            = "":U
     1828               v-torgconf-sup-host-kpp            = "":U
     1829               v-torgconf-sup-host-okpo           = "":U
     1830               v-torgconf-sup-host-egrip-date     = "":U
     1831               v-torgconf-sup-host-egrip-num      = "":U
     1832           .
     1833       end.
     1834       else do:
     1835           run fmtcli-get-client in this-procedure (
     1836                 input 'орг':U
     1837               , input v-torgconf-sup-host-code
     1838           ).
     1839           assign
     1840               v-torgconf-sup-host-name        = v-fmtcli-name
     1841               v-torgconf-sup-host-engl-name   = v-fmtcli-engl-name
     1842               v-torgconf-sup-host-addres      = v-fmtcli-full-addres
     1843               v-torgconf-sup-host-post-addres = v-fmtcli-post-addres
     1844               v-torgconf-sup-host-phone       = v-fmtcli-phone
     1845               v-torgconf-sup-host-inn         = v-fmtcli-inn
     1846               v-torgconf-sup-host-kpp         = v-fmtcli-kpp
     1847               v-torgconf-sup-host-okpo        = v-fmtcli-okpo
     1848           .
     1849           run gbl/clntat-v.p (
     1850                 input 'орг':U
     1851               , input v-torgconf-sup-host-code
     1852               , input 'egrip-date':U
     1853               , output v-torgconf-sup-host-egrip-date
     1854               , output v-par-type
     1855           ).
     1856           run gbl/clntat-v.p (
     1857                 input 'орг':U
     1858               , input v-torgconf-sup-host-code
     1859               , input 'egrip-num':U
     1860               , output v-torgconf-sup-host-egrip-num
     1861               , output v-par-type
     1862           ).
     1863           run fmtcli-get-bank in this-procedure (
     1864                 input v-host-code
     1865               , input 'орг':U
     1866               , input v-torgconf-sup-host-code
     1867               , input p-curr-code
     1868           ).
     1869       end.
     1870       assign
     1871           v-torgconf-sup-schet-exists = v-fmtcli-schet-exists
     1872           v-torgconf-sup-bank-exists  = v-fmtcli-bank-exists
     1873           v-torgconf-sup-bank-r-schet = v-fmtcli-bank-r-schet
     1874           v-torgconf-sup-bank-c-schet = v-fmtcli-bank-c-schet
     1875           v-torgconf-sup-bank-bik     = v-fmtcli-bank-bik
     1876           v-torgconf-sup-bank-name    = v-fmtcli-bank-name
     1877           v-torgconf-sup-bank-addres  = v-fmtcli-bank-addres
     1878           v-torgconf-sup-bank-city    = v-fmtcli-bank-city
     1879       .
     1880       assign
     1881           v-torgconf-sup-obj-type = p-obj-type
     1882           v-torgconf-sup-obj-code = p-obj-code
     1883       .
     1884       if trim(p-obj-type) <> ""
     1885       and p-obj-code <> 0
     1886       then do:
     1887       run fmtcli-get-client in this-procedure (
     1888             input p-obj-type
     1889           , input p-obj-code
     1890       ).
     1891       assign
     1892           v-torgconf-sup-obj-name        = v-fmtcli-name
     1893           v-torgconf-sup-obj-engl-name   = v-fmtcli-engl-name
     1894           v-torgconf-sup-obj-addres      = v-fmtcli-full-addres
     1895           v-torgconf-temp-post-addres    = v-fmtcli-post-addres
     1896           v-torgconf-sup-obj-phone       = v-fmtcli-phone
     1897           v-torgconf-sup-obj-inn         = v-fmtcli-inn
     1898           v-torgconf-sup-obj-okpo        = v-fmtcli-okpo
     1899       .
     1900      end.
     1901      end.
     1902   end procedure.
     1903   procedure torgconf-get-cli-param :
     1904   define input parameter p-host-obj-code      as integer          no-undo.
     1905   define input parameter p-obj-type           as character        no-undo.
     1906   define input parameter p-obj-code           as integer          no-undo.
     1907   define input parameter p-curr-code          as integer          no-undo.
     1908       define variable v-host-code    as integer      no-undo.
     1909   do
     1910   on error undo, return error
     1911   :
     1912       assign
     1913           v-torgconf-cli-type = p-obj-type
     1914           v-torgconf-cli-code = p-obj-code
     1915       .
     1916       run fmtcli-get-client in this-procedure (
     1917             input p-obj-type
     1918           , input p-obj-code
     1919       ).
     1920       assign
     1921           v-torgconf-cli-name         = trim( v-fmtcli-name          )
     1922           v-torgconf-cli-engl-name    = trim( v-fmtcli-engl-name          )
     1923           v-torgconf-cli-addres       = trim( v-fmtcli-full-addres   )
     1924           v-torgconf-cli-post-addres  = trim( v-fmtcli-post-addres   )
     1925           v-torgconf-cli-phone        = trim( v-fmtcli-phone         )
     1926           v-torgconf-cli-inn          = trim( v-fmtcli-inn           )
     1927           v-torgconf-cli-kpp          = trim( v-fmtcli-kpp           )
     1928           v-torgconf-cli-okpo         = trim( v-fmtcli-okpo          )
     1929       .
     1930      run fmtcli-get-bank in this-procedure (
     1931             input p-host-obj-code
     1932           , input p-obj-type
     1933           , input p-obj-code
     1934           , input p-curr-code
     1935       ).
     1936       assign
     1937           v-torgconf-cli-schet-exists = v-fmtcli-schet-exists
     1938           v-torgconf-cli-bank-exists  = v-fmtcli-bank-exists
     1939           v-torgconf-cli-bank-r-schet = v-fmtcli-bank-r-schet
     1940           v-torgconf-cli-bank-c-schet = v-fmtcli-bank-c-schet
     1941           v-torgconf-cli-bank-bik     = v-fmtcli-bank-bik
     1942           v-torgconf-cli-bank-name    = v-fmtcli-bank-name
     1943           v-torgconf-cli-bank-addres  = v-fmtcli-bank-addres
     1944           v-torgconf-cli-bank-city    = v-fmtcli-bank-city
     1945       .
     1946   end.
     1947   end procedure.
     1948   procedure torgconf-get-ship-param :
     1949   define input parameter p-host-obj-code      as integer          no-undo.
     1950   define input parameter p-obj-type           as character        no-undo.
     1951   define input parameter p-obj-code           as integer          no-undo.
     1952   define input parameter p-curr-code          as integer          no-undo.
     1953       define variable v-host-code    as integer      no-undo.
     1954   do
     1955   on error undo, return error
     1956   :
     1957       assign
     1958           v-torgconf-ship-type = p-obj-type
     1959           v-torgconf-ship-code = p-obj-code
     1960       .
     1961       if trim(p-obj-type) = ""
     1962       and p-obj-code = 0
     1963       then do:
     1964       assign
     1965           v-torgconf-ship-name         = "":U
     1966           v-torgconf-ship-addres       = "":U
     1967           v-torgconf-ship-post-addres  = "":U
     1968           v-torgconf-ship-phone        = "":U
     1969           v-torgconf-ship-inn          = "":U
     1970           v-torgconf-ship-kpp          = "":U
     1971           v-torgconf-ship-okpo         = "":U
     1972       .
     1973       end.
     1974       else do:
     1975       run fmtcli-get-client in this-procedure (
     1976             input p-obj-type
     1977           , input p-obj-code
     1978       ).
     1979       assign
     1980           v-torgconf-ship-name         = trim( v-fmtcli-name          )
     1981           v-torgconf-ship-engl-name    = trim( v-fmtcli-engl-name          )
     1982           v-torgconf-ship-addres       = trim( v-fmtcli-full-addres   )
     1983           v-torgconf-ship-post-addres  = trim( v-fmtcli-post-addres   )
     1984           v-torgconf-ship-phone        = trim( v-fmtcli-phone         )
     1985           v-torgconf-ship-inn          = trim( v-fmtcli-inn           )
     1986           v-torgconf-ship-kpp          = trim( v-fmtcli-kpp           )
     1987           v-torgconf-ship-okpo         = trim( v-fmtcli-okpo          )
     1988       .
     1989       end.
     1990           run fmtcli-get-bank in this-procedure (
     1991             input p-host-obj-code
     1992           , input p-obj-type
     1993           , input p-obj-code
     1994           , input p-curr-code
     1995       ).
     1996       assign
     1997           v-torgconf-ship-schet-exists = v-fmtcli-schet-exists
     1998           v-torgconf-ship-bank-exists  = v-fmtcli-bank-exists
     1999           v-torgconf-ship-bank-r-schet = v-fmtcli-bank-r-schet
     2000           v-torgconf-ship-bank-c-schet = v-fmtcli-bank-c-schet
     2001           v-torgconf-ship-bank-bik     = v-fmtcli-bank-bik
     2002           v-torgconf-ship-bank-name    = v-fmtcli-bank-name
     2003           v-torgconf-ship-bank-addres  = v-fmtcli-bank-addres
     2004           v-torgconf-ship-bank-city    = v-fmtcli-bank-city
     2005       .
     2006   end.
     2007   end procedure.
     2008   procedure torgconf-get-holdfirm-code :
     2009   define input parameter p-obj-type   as character        no-undo.
     2010   define input parameter p-obj-code   as integer          no-undo.
     2011   define output parameter p-firm-code as integer          no-undo.
     2012       define variable v-firm-code-str     as character    no-undo.
     2013       define variable v-par-type          as character    no-undo.
     2014       define buffer buf_clients       for ub.clients.
     2015   do
     2016   for buf_clients
     2017   on error undo, return error
     2018   :
     2019       run gbl/clntat-v.p (
     2020             input p-obj-type
     2021           , input p-obj-code
     2022           , input 'holdfirm-code':U
     2023           , output v-firm-code-str
     2024           , output v-par-type
     2025       ).
     2026       assign
     2027           p-firm-code = integer( v-firm-code-str )
     2028       no-error.
     2029       if error-status :error
     2030       then do:
     2031           message
     2032               "Неверно задан код фирмы для печати накладных."
     2033           view-as alert-box warning.
     2034           assign
     2035               p-firm-code = 0
     2036           .
     2037       end.
     2038       else do:
     2039           find first buf_clients no-lock
     2040                where buf_clients.obj-type = 'орг':U
     2041                  and buf_clients.obj-code = p-firm-code
     2042           no-error.
     2043           if not available buf_clients
     2044           then do:
     2045               message
     2046                   "Включен параметр 'Список печатных форм, для которых должна быть задана фирма для печати накладных' (outhold)" skip
     2047                   "Не найдена фирма по заданному коду фирмы для печати накладных."
     2048               view-as alert-box warning.
     2049               assign
     2050                   p-firm-code = 0
     2051               .
     2052           end.
     2053       end.
     2054   end.
     2055   end procedure.
     2056   procedure torgconf-get-post-head:
     2057   define input  parameter p-obj-type             as character        no-undo.
     2058   define input  parameter p-obj-code             as integer          no-undo.
     2059   define output parameter p-torgconf-post-head   as character        no-undo.
     2060      define variable v-host-code         as integer      no-undo.
     2061      define buffer buf_sysconf     for ub.sysconf.
     2062        assign
     2063         p-torgconf-post-head  = ""
     2064        .
     2065   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2066   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2067     (input  p-obj-type
     2068     ,input  p-obj-code
     2069     ,output v-host-code
     2070     )  .
     2071      find first buf_sysconf no-lock
     2072      where buf_sysconf.host-code = v-host-code
     2073      no-error.
     2074      if available buf_sysconf
     2075      then do:
     2076         assign
     2077            p-torgconf-post-head = buf_sysconf.head-position
     2078         .
     2079      end.
     2080   end procedure.
     2081   procedure torgconf-get-storekeeper:
     2082   define input  parameter p-wrkr                   as integer          no-undo.
     2083   define output parameter p-torgconf-wrkr-name     as character        no-undo.
     2084   define output parameter p-torgconf-post          as character        no-undo.
     2085      define buffer buf_sysconf     for ub.sysconf.
     2086      define buffer buf_person      for ub.person.
     2087      define buffer buf_shop        for ub.shop .
     2088      define buffer buf_store       for ub.store .
     2089      if v-torgconf-outC = "no_print"
     2090      then do:
     2091         assign p-torgconf-post = ""
     2092                p-torgconf-wrkr-name = ""
     2093                .
     2094      end.
     2095      if v-torgconf-outC = "clad_doc"
     2096      then do:
     2097         run rep/get-psn.p
     2098               (input  p-wrkr
     2099               ,output p-torgconf-wrkr-name
     2100               ) .
     2101         find first buf_person no-lock
     2102         where buf_person.psn-code = p-wrkr
     2103         no-error.
     2104         if available buf_person
     2105         then do:
     2106           p-torgconf-post = buf_person.position.
     2107         end.
     2108         if p-torgconf-post = "?":U then p-torgconf-post = "".
     2109         if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2110      end.
     2111      if v-torgconf-outC = "clad_obj"
     2112      then do:
     2113         CASE v-torgconf-self-obj-type:
     2114         WHEN 'маг':U
     2115         THEN DO:
     2116            find first buf_shop no-lock
     2117            where buf_shop.obj-code = v-torgconf-self-obj-code
     2118            .
     2119            assign
     2120               p-torgconf-wrkr-name = buf_shop.store-man
     2121               p-torgconf-post = ""
     2122            .
     2123            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2124         END.
     2125         WHEN 'скл':U
     2126         THEN DO:
     2127            find first buf_store no-lock
     2128            where buf_store.obj-code = v-torgconf-self-obj-code
     2129            .
     2130            assign
     2131               p-torgconf-wrkr-name = buf_store.store-man
     2132               p-torgconf-post = ""
     2133            .
     2134            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2135         END.
     2136         OTHERWISE DO:
     2137            assign
     2138               p-torgconf-post = "":U
     2139               p-torgconf-wrkr-name = "":U
     2140            .
     2141         END.
     2142         END CASE.
     2143      end.
     2144    end procedure.
     2145   procedure torgconf-get-form-header :
     2146   define input parameter p-for-inverse    as logical          no-undo.
     2147   define input parameter p-doc-code       as character        no-undo.
     2148   define input parameter p-print-doc      as logical          no-undo.
     2149   define input parameter p-doc-date       as date             no-undo.
     2150   define input parameter p-fact-date      as date             no-undo.
     2151   define input parameter p-doc-type       as character        no-undo.
     2152   define input parameter p-status_        as character        no-undo.
     2153   define input parameter p-reverse        as logical          no-undo.
     2154   define input parameter p-sf-par         as logical          no-undo.
     2155       define variable v-attr-type         as character    no-undo.
     2156       define variable v-doc-code-standard as logical      no-undo.
     2157       define variable v-doc-date-standard as logical      no-undo.
     2158       define variable v-par-consignee-addres  as character    no-undo.
     2159       define variable v-host-code         as integer      no-undo.
     2160       define variable v-dcode-attr        as character    no-undo.
     2161       define variable v-ddate-attr        as character    no-undo.
     2162       define variable v-doc-date          as character    no-undo.
     2163       define variable v-doc-code          as character    no-undo.
     2164       define variable v-par-type          as character    no-undo.
     2165       define variable v-attr              as character    no-undo.
     2166       define buffer buf_firm          for ub.firm .
     2167       define buffer buf_clients       for ub.clients .
     2168       define buffer buf_sysconf       for ub.sysconf .
     2169       define buffer buf_shop          for ub.shop .
     2170       define buffer buf_store         for ub.store .
     2171       define buffer buf_person        for ub.person .
     2172       define buffer buf_trn-doc       for ub.trn-doc .
     2173       define buffer buf_wth-doc       for ub.wth-doc .
     2174       do
     2175   for buf_firm
     2176     , buf_clients
     2177     , buf_sysconf
     2178     , buf_shop
     2179     , buf_trn-doc
     2180     , buf_person
     2181     , buf_wth-doc
     2182   on error undo, return error
     2183   :
     2184       if p-doc-type = 'при':U
     2185       or p-doc-type = 'возврат':U
     2186       then do:
     2187           assign
     2188               v-torgconf-supplier         = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     2189                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     2190               v-torgconf-suppi            = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     2191                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     2192               v-torgconf-saler            = substitute( "&1&2&3&4&5", v-torgconf-self-host-name, ( if v-torgconf-self-host-addres = "":U then "":U else ", " ),
     2193                                             v-torgconf-self-host-addres, ( if v-torgconf-self-host-phone = "":U then "":U else ", " ),v-torgconf-self-host-phone )
     2194               v-torgconf-consignee        = substitute( "&1&2&3&4&5", v-torgconf-sup-host-name, ( if v-torgconf-sup-host-addres = "":U then "":U else ", " ),
     2195                                             v-torgconf-sup-host-addres, ( if v-torgconf-sup-host-phone = "":U then "":U else ", " ), v-torgconf-sup-host-phone  )
     2196               v-torgconf-supplier-okpo    = v-torgconf-cli-okpo
     2197               v-torgconf-saler-okpo       = v-torgconf-self-host-okpo
     2198               v-torgconf-consignee-okpo   = v-torgconf-sup-host-okpo
     2199               v-torgconf-supplier-code    = substitute( "&1", v-torgconf-cli-code         )
     2200               v-torgconf-supplier-type    = v-torgconf-cli-type
     2201               v-torgconf-saler-code       = substitute( "&1", v-torgconf-self-host-code   )
     2202               v-torgconf-saler-type       = v-torgconf-self-host-type
