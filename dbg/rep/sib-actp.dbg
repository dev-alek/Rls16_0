     4063           , output v-sibactxl-cell-file-name
     4064       ).
     4065       output stream excel-cell to value( v-sibactxl-cell-file-name ).
     4066       if printrubl
     4067       then do:
     4068           run sibactxl-write-cell-data in this-procedure (
     4069                 input "valutCode":U
     4070               , input "0":U
     4071           ).
     4072       end.
     4073       else do:
     4074           run sibactxl-write-cell-data in this-procedure (
     4075                 input "valutCode":U
     4076               , input "1":U
     4077           ).
     4078       end.
     4079       run sibactxl-write-cell-data in this-procedure (
     4080             input "columnList":U
     4081           , input "col1,col2,col3,col4,col5,col6,col7,col8,col9,col10,col11,col12,col13,col14,col15,col16,col17":U
     4082       ).
     4083       run sibactxl-write-cell-data in this-procedure (
     4084             input "columnType":U
     4085           , input "S,S,S,S,S,S,S,S,S,S,S,S,S,S,S,S,S":U
     4086       ).
     4087       run sibactxl-write-cell-data in this-procedure (
     4088             input "columnAmount":U
     4089           , input "17":U
     4090       ).
     4091   end.
     4092   end procedure.
     4093   procedure sibactxl-close :
     4094   do
     4095   on error undo, return error
     4096   :
     4097       output stream excel-line close.
     4098       output stream excel-cell close.
     4099       output to value( string( session:temp-directory + "$" + string( g#report-num ) ) + ".txl" ) append.
     4100           export "exe/sibactp1.xlt":U.
     4101           export "exe/t_97.bas":U.
     4102           export v-sibactxl-cell-file-name.
     4103           export v-sibactxl-data-file-name.
     4104       output close.
     4105   end.
     4106   end procedure.
     4107   procedure sibactxl-write-cell-data :
     4108   define input parameter p-data-key   as character        no-undo.
     4109   define input parameter p-data-value as character        no-undo.
     4110       define buffer buf_temp_cell-data     for temp_cell-data.
     4111   do
     4112   for buf_temp_cell-data
     4113   on error undo, return error
     4114   :
     4115       find first buf_temp_cell-data
     4116            where buf_temp_cell-data.data-key = p-data-key
     4117       no-error.
     4118       if not available buf_temp_cell-data
     4119       then do:
     4120           create buf_temp_cell-data.
     4121           assign
     4122               buf_temp_cell-data.data-key = p-data-key
     4123           .
     4124       end.
     4125       assign
     4126           buf_temp_cell-data.data-value = p-data-value
     4127       .
     4128       put stream excel-cell unformatted
     4129                           buf_temp_cell-data.data-key
     4130           chr(9)   buf_temp_cell-data.data-value
     4131           chr(10)
     4132       .
     4133   end.
     4134   end procedure.
     4135   procedure sibactxl-write-line-data :
     4136     define input parameter p-col-1  as character no-undo .
     4137     define input parameter p-col-2  as character no-undo .
     4138     define input parameter p-col-3  as character no-undo .
     4139     define input parameter p-col-4  as character no-undo .
     4140     define input parameter p-col-5  as character no-undo .
     4141     define input parameter p-col-6  as character no-undo .
     4142     define input parameter p-col-7  as character no-undo .
     4143     define input parameter p-col-8  as character no-undo .
     4144     define input parameter p-col-9  as character no-undo .
     4145     define input parameter p-col-10 as character no-undo .
     4146     define input parameter p-col-11 as character no-undo .
     4147     define input parameter p-col-12 as character no-undo .
     4148     define input parameter p-col-13 as character no-undo .
     4149     define input parameter p-col-14 as character no-undo .
     4150     define input parameter p-col-15 as character no-undo .
     4151     define input parameter p-col-16 as character no-undo .
     4152     define input parameter p-col-17 as character no-undo .
     4153       define buffer buf_temp_line-data        for temp_line-data.
     4154   do
     4155   for buf_temp_line-data
     4156   on error undo, return error
     4157   :
     4158       for each buf_temp_line-data
     4159       :
     4160           delete buf_temp_line-data.
     4161       end.
     4162       create buf_temp_line-data.
     4163       assign
     4164           v-sibactxl-current-data-row = v-sibactxl-current-data-row + 1
     4165       .
     4166       assign
     4167           buf_temp_line-data.data-key     = "LD":U
     4168           buf_temp_line-data.xl-line-id   = v-sibactxl-current-data-row
     4169           buf_temp_line-data.col-1        = p-col-1
     4170           buf_temp_line-data.col-2        = p-col-2
     4171           buf_temp_line-data.col-3        = p-col-3
     4172           buf_temp_line-data.col-4        = p-col-4
     4173           buf_temp_line-data.col-5        = p-col-5
     4174           buf_temp_line-data.col-6        = p-col-6
     4175           buf_temp_line-data.col-7        = p-col-7
     4176           buf_temp_line-data.col-8        = p-col-8
     4177           buf_temp_line-data.col-9        = p-col-9
     4178           buf_temp_line-data.col-10       = p-col-10
     4179           buf_temp_line-data.col-11       = p-col-11
     4180           buf_temp_line-data.col-12       = p-col-12
     4181           buf_temp_line-data.col-13       = p-col-13
     4182           buf_temp_line-data.col-14       = p-col-14
     4183           buf_temp_line-data.col-15       = p-col-15
     4184           buf_temp_line-data.col-16       = p-col-16
     4185           buf_temp_line-data.col-17       = p-col-17
     4186       .
     4187       put stream excel-line unformatted
     4188                           buf_temp_line-data.data-key
     4189           chr(9)   buf_temp_line-data.col-1
     4190           chr(9)   buf_temp_line-data.col-2
     4191           chr(9)   buf_temp_line-data.col-3
     4192           chr(9)   buf_temp_line-data.col-4
     4193           chr(9)   buf_temp_line-data.col-5
     4194           chr(9)   buf_temp_line-data.col-6
     4195           chr(9)   buf_temp_line-data.col-7
     4196           chr(9)   buf_temp_line-data.col-8
     4197           chr(9)   buf_temp_line-data.col-9
     4198           chr(9)   buf_temp_line-data.col-10
     4199           chr(9)   buf_temp_line-data.col-11
     4200           chr(9)   buf_temp_line-data.col-12
     4201           chr(9)   buf_temp_line-data.col-13
     4202           chr(9)   buf_temp_line-data.col-14
     4203           chr(9)   buf_temp_line-data.col-15
     4204           chr(9)   buf_temp_line-data.col-16
     4205           chr(9)   buf_temp_line-data.col-17
     4206           chr(10)
     4207       .
     4208   end.
     4209   end procedure.
     4210   procedure sibactxl-run-excel :
     4211   define input parameter p-header-filename    as character        no-undo.
     4212   define input parameter p-data-filename      as character        no-undo.
     4213       define variable v-template-file-name    as character    no-undo.
     4214       define variable v-vb-file-name          as character    no-undo.
     4215       define buffer buf_temp-param for temp-param .
     4216   do
     4217   for buf_temp-param
     4218   on error undo, return error
     4219   :
     4220       create buf_temp-param.
     4221       assign
     4222           v-template-file-name    = search( "exe/sibactp1.xlt" )
     4223           v-vb-file-name          = search( "exe/t_97.bas")
     4224       .
     4225       if v-template-file-name = ?
     4226       or v-template-file-name = "":U
     4227       then do:
     4228           message
     4229               "Ошибка имени файла шаблона."
     4230           view-as alert-box error.
     4231       end.
     4232       if v-vb-file-name = ?
     4233       or v-vb-file-name = "":U
     4234       then do:
     4235           message
     4236               "Ошибка имени файла кода обработки."
     4237           view-as alert-box error.
     4238       end.
     4239       run paramls-write in this-procedure (
     4240             input "template":U
     4241           , input "template-file-name":U
     4242           , input v-template-file-name
     4243       ).
     4244       run paramls-write in this-procedure (
     4245             input "template":U
     4246           , input "vb-file-name":U
     4247           , input v-vb-file-name
     4248       ).
     4249       run paramls-write in this-procedure (
     4250             input "data":U
     4251           , input "data-header-filename":U
     4252           , input p-header-filename
     4253       ).
     4254       run paramls-write in this-procedure (
     4255             input "data":U
     4256           , input "data-filename":U
     4257           , input p-data-filename
     4258       ).
     4259       run gbl/macroxlt.p (
     4260           input-output table buf_temp-param
     4261       ) no-error.
     4262       if error-status :error
     4263       then do:
     4264           message
     4265                    vss-workfile vss-revision vss-description
     4266               skip(1)
     4267               skip "Ошибка создания файла Excel."
     4268               skip return-value
     4269               skip trim(error-status :get-message(1))
     4270                    trim(error-status :get-message(2))
     4271                    trim(error-status :get-message(3))
     4272           view-as alert-box error.
     4273           undo, return error .
     4274       end.
     4275   end.
     4276   end procedure.
     4277   define temp-table tt-report no-undo
     4278     field line-num like ub.doc-line.line-num
     4279     field gds-code like ub.goods.gds-code
     4280     field col-1    as character
     4281     field col-2    as character
     4282     field col-3    as character
     4283     field col-4    as character
     4284     field col-5    as character
     4285     field col-6    as character
     4286     field col-7    as character
     4287     field col-8    as character
     4288     field col-9    as character
     4289     field col-10   as character
     4290     field col-11   as character
     4291     field col-12   as character
     4292     field col-13   as character
     4293     field col-14   as character
     4294     field col-15   as character
     4295     field col-16   as character
     4296     field col-17   as character
     4297   index pi is primary unique
     4298       line-num
     4299       gds-code
     4300   .
