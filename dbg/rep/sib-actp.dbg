     1468   procedure torgconf-get-self-param :
     1469   define input parameter p-obj-type           as character        no-undo.
     1470   define input parameter p-obj-code           as integer          no-undo.
     1471   define input parameter p-curr-code          as integer          no-undo.
     1472       define variable v-host-code    as integer      no-undo.
     1473       define variable v-par-type     as character    no-undo.
     1474   do
     1475   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message(1))
     1476   :
     1477   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1478   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1479     (input  p-obj-type
     1480     ,input  p-obj-code
     1481     ,output v-host-code
     1482     )  .
     1483       if v-torgconf-outhold = yes
     1484       then do:
     1485           run torgconf-get-holdfirm-code in this-procedure (
     1486                 input p-obj-type
     1487               , input p-obj-code
     1488               , output v-torgconf-self-host-code
     1489           ).
     1490           if v-torgconf-self-host-code = 0
     1491           then do:
     1492               return error.
     1493           end.
     1494       end.
     1495       else do:
     1496           assign
     1497               v-torgconf-self-host-code = v-host-code
     1498           .
     1499       end.
     1500       if v-torgconf-self-host-code = 0
     1501       then do:
     1502           assign
     1503               v-torgconf-self-host-name           = "":U
     1504               v-torgconf-self-host-addres         = "":U
     1505               v-torgconf-self-host-post-addres    = "":U
     1506               v-torgconf-self-host-phone          = "":U
     1507               v-torgconf-self-host-inn            = "":U
     1508               v-torgconf-self-host-kpp            = "":U
     1509               v-torgconf-self-host-okpo           = "":U
     1510               v-torgconf-self-host-egrip-date     = "":U
     1511               v-torgconf-self-host-egrip-num      = "":U
     1512           .
     1513       end.
     1514       else do:
     1515           run fmtcli-get-client in this-procedure (
     1516                 input 'орг':U
     1517               , input v-torgconf-self-host-code
     1518           ).
     1519           assign
     1520               v-torgconf-self-host-name        = v-fmtcli-name
     1521               v-torgconf-self-host-engl-name   = v-fmtcli-engl-name
     1522               v-torgconf-self-host-addres      = v-fmtcli-full-addres
     1523               v-torgconf-self-host-post-addres = v-fmtcli-post-addres
     1524               v-torgconf-self-host-phone       = v-fmtcli-phone
     1525               v-torgconf-self-host-inn         = v-fmtcli-inn
     1526               v-torgconf-self-host-kpp         = v-fmtcli-kpp
     1527               v-torgconf-self-host-okpo        = v-fmtcli-okpo
     1528           .
     1529           run gbl/clntat-v.p (
     1530                 input 'орг':U
     1531               , input v-torgconf-self-host-code
     1532               , input 'egrip-date':U
     1533               , output v-torgconf-self-host-egrip-date
     1534               , output v-par-type
     1535           ).
     1536           run gbl/clntat-v.p (
     1537                 input 'орг':U
     1538               , input v-torgconf-self-host-code
     1539               , input 'egrip-num':U
     1540               , output v-torgconf-self-host-egrip-num
     1541               , output v-par-type
     1542           ).
     1543           run fmtcli-get-bank in this-procedure (
     1544                 input v-host-code
     1545               , input 'орг':U
     1546               , input v-torgconf-self-host-code
     1547               , input p-curr-code
     1548           ).
     1549       end.
     1550       assign
     1551           v-torgconf-self-schet-exists = v-fmtcli-schet-exists
     1552           v-torgconf-self-bank-exists  = v-fmtcli-bank-exists
     1553           v-torgconf-self-bank-r-schet = v-fmtcli-bank-r-schet
     1554           v-torgconf-self-bank-c-schet = v-fmtcli-bank-c-schet
     1555           v-torgconf-self-bank-bik     = v-fmtcli-bank-bik
     1556           v-torgconf-self-bank-name    = v-fmtcli-bank-name
     1557           v-torgconf-self-bank-addres  = v-fmtcli-bank-addres
     1558           v-torgconf-self-bank-city    = v-fmtcli-bank-city
     1559       .
     1560       assign
     1561           v-torgconf-self-obj-type = p-obj-type
     1562           v-torgconf-self-obj-code = p-obj-code
     1563       .
     1564       run fmtcli-get-client in this-procedure (
     1565             input p-obj-type
     1566           , input p-obj-code
     1567       ).
     1568       assign
     1569           v-torgconf-self-obj-name       = v-fmtcli-name
     1570           v-torgconf-self-obj-engl-name  = v-fmtcli-engl-name
     1571           v-torgconf-self-obj-addres     = v-fmtcli-full-addres
     1572           v-torgconf-temp-post-addres    = v-fmtcli-post-addres
     1573           v-torgconf-self-obj-phone      = v-fmtcli-phone
     1574           v-torgconf-self-obj-inn        = v-fmtcli-inn
     1575           v-torgconf-self-obj-okpo       = v-fmtcli-okpo
     1576       .
     1577   end.
     1578   end procedure.
     1579   procedure torgconf-get-recepient-param :
     1580   define input parameter torgconfdoc-code   as character                  no-undo.
     1581   define output parameter v-code-rec        as integer                    no-undo .
     1582   define output parameter v-type-rec        as character                  no-undo initial 'C':U.
     1583   define output parameter v-codefirm-rec    as integer                    no-undo .
     1584   define output parameter v-curcode-rec     as integer                    no-undo .
     1585        define variable  v-recipient-code  as character                  no-undo .
     1586        define variable  v-recipient       like ub.doc-attr.attr-value   no-undo.
     1587        define variable  v-trdcattr-type   as character                  no-undo initial 'C':U.
     1588   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input torgconfdoc-code ,
     1589                           input 'Recipient':U ,
     1590                          output v-recipient-code ,
     1591                          output v-trdcattr-type ) no-error .
     1592       if error-status :error then do:
     1593        message
     1594         vss-workfile vss-revision vss-description skip
     1595         "Ошибка при вызове процедуры tdat-val":U skip
     1596         "Документ: " torgconfdoc-code skip
     1597         "Атрибут: " 'Recipient':U skip
     1598         "Значение: " v-recipient skip
     1599         trim( error-status :get-message (1) ) skip
     1600         return-value skip
     1601         view-as alert-box error.
     1602       undo, return error return-value.
     1603       end.
     1604     assign
     1605       v-recipient  = v-recipient-code
     1606       v-type-rec = substring(v-recipient-code,1,3)
     1607       v-code-rec  = int(substring(v-recipient-code,4,15))
     1608       no-error
     1609     .
     1610     if v-type-rec = ? then v-type-rec = "" .
     1611     if v-code-rec  = ? then v-code-rec  =  0 .
     1612     end procedure.
