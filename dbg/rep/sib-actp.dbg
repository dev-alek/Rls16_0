     3892   procedure torgconf-get-reason  :
     3893   define input parameter  p-doc-code       as character        no-undo.
     3894   define input parameter  p-reason-code    as integer          no-undo .
     3895   define input parameter  p-doc-type       as character        no-undo.
     3896       if p-reason-code > 0
     3897       then do:
     3898           define buffer buf_trn-reason for ub.trn-reason.
     3899           find first buf_trn-reason no-lock where buf_trn-reason.reason-code = p-reason-code no-error .
     3900           if available buf_trn-reason then assign v-torgconf-reason =  buf_trn-reason.reason-name .
     3901       end.
     3902       else do:
     3903           if p-doc-type = 'при':U
     3904           then  do:
     3905               define variable v-attr-type     as character    no-undo.
     3906               define variable v-attr-value    as character    no-undo.
     3907               run gbl/trdcat-v.p (input p-doc-code,input 'nids':U,output v-attr-value,output v-attr-type) .
     3908               assign v-torgconf-reason = v-attr-value .
     3909               run gbl/trdcat-v.p (input p-doc-code,input 'dids':U,output v-attr-value,output v-attr-type) .
     3910               assign v-torgconf-reason = v-torgconf-reason + " от " + v-attr-value .
     3911           end.
     3912       end.
     3913   end procedure.
     3914   def var vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3915   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     3916   procedure paramls-clear :
     3917     define buffer buf_temp-param for temp-param .
     3918     do
     3919     on error undo, return error return-value
     3920     :
     3921       for each buf_temp-param
     3922       on error undo, return error
     3923       :
     3924         delete buf_temp-param .
     3925       end.
     3926     end.
     3927   end procedure.
     3928   procedure paramls-write :
     3929     define input  parameter p-code     as character no-undo .
     3930     define input  parameter p-sub-code as character no-undo .
     3931     define input  parameter p-value    as character no-undo .
     3932     define buffer buf_temp-param for temp-param .
     3933     do
     3934     on error undo, return error return-value
     3935     :
     3936       find first buf_temp-param
     3937         where buf_temp-param.param-code     = p-code
     3938           and buf_temp-param.param-sub-code = p-sub-code
     3939         no-error .
     3940       if not available buf_temp-param then do:
     3941         create buf_temp-param .
     3942         assign
     3943           buf_temp-param.param-code     = p-code
     3944           buf_temp-param.param-sub-code = p-sub-code
     3945         .
     3946       end.
     3947       assign
     3948         buf_temp-param.param-value = p-value
     3949       .
     3950     end.
     3951   end procedure.
     3952   procedure paramls-read :
     3953     define input  parameter p-code          as character no-undo .
     3954     define input  parameter p-sub-code      as character no-undo .
     3955     define input  parameter p-default-value as character no-undo .
     3956     define output parameter p-value         as character no-undo .
     3957     define buffer buf_temp-param for temp-param .
     3958     do
     3959     on error undo, return error return-value
     3960     :
     3961       find first buf_temp-param
     3962         where buf_temp-param.param-code     = p-code
     3963           and buf_temp-param.param-sub-code = p-sub-code
     3964         no-error .
     3965       if available buf_temp-param then do:
     3966         assign
     3967           p-value = buf_temp-param.param-value
     3968         .
     3969       end.
     3970       else do:
     3971         assign
     3972           p-value = p-default-value
     3973         .
     3974       end.
     3975     end.
     3976   end procedure.
     3977   procedure paramls-append :
     3978     define input  parameter p-code     as character no-undo .
     3979     define input  parameter p-sub-code as character no-undo .
     3980     define input  parameter p-value    as character no-undo .
     3981     define buffer buf_temp-param for temp-param .
     3982     do
     3983     on error undo, return error return-value
     3984     :
     3985       find first buf_temp-param
     3986            where buf_temp-param.param-code     = p-code
     3987              and buf_temp-param.param-sub-code = p-sub-code
     3988         no-error .
     3989       if not available buf_temp-param then do:
     3990         create buf_temp-param .
     3991         assign
     3992           buf_temp-param.param-code     = p-code
     3993           buf_temp-param.param-sub-code = p-sub-code
     3994           buf_temp-param.param-value    = p-value
     3995         .
     3996       end.
     3997       else do:
     3998           assign
     3999               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     4000           .
     4001       end.
     4002     end.
     4003   end procedure.
