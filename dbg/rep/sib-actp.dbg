      219   procedure prn-lib-reportviewer :
      220     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      221     define input parameter p-report-name-html as character no-undo .
      222     define input parameter p-param        as character no-undo .
      223     define variable v-excel           as character no-undo init 'TRUE' .
      224     define variable v-value-character as character no-undo .
      225     define variable v-value-integer   as character no-undo .
      226     define variable v-value-date      as date      no-undo .
      227     define variable v-value-decimal   as decimal   no-undo .
      228     define variable rep-excel         as logical   no-undo .
      229     define variable excel-string      as character no-undo .
      230     define variable v-param-type      as character no-undo .
      231     define variable v-tth             as handle    no-undo .
      232     run adm/shattri.p (
      233       input "get":U
      234       ,input  ""
      235       ,input  0
      236       ,input  'report-glob':U
      237       ,input  'rep-excel':U
      238       ,output v-value-character
      239       ,output v-value-date
      240       ,output v-value-decimal
      241       ,output v-value-integer
      242       ,output rep-excel
      243       ,output v-param-type
      244       ,INPUT-OUTPUT table-handle v-tth
      245       )  .
      246     if rep-excel then v-excel = "TRUE" .
      247     else v-excel = "FALSE" .
      248     if p-param eq ""
      249     then
      250        p-param = "EXCEL:" + v-excel.
      251     else
      252        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      253     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      254   end procedure.
      255   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      256   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      257   define  shared variable RepPathName        as character no-undo .
      258   define  shared variable PrintRubl          as logical   no-undo .
      259   define variable vss-include-info3 as character format "X(65)" no-undo
      260   initial "@(#)$Workfile$ $Revision$".
      261   define temp-table temp_p-fmt_string-part no-undo
      262       field str-key       as integer
      263       field string-part   as character
      264       index pi is primary unique
      265           str-key
      266   .
      267   define variable v-p-fmt-3-str-key    as integer      no-undo.
      268   FUNCTION center-field RETURNS INTEGER (INPUT iStartPix AS INTEGER, iEndPix AS INTEGER,
      269                                     iInput AS INTEGER).
      270     def var v-start-print as integer no-undo .
      271     if (iStartPix < 0) or (iEndPix < iStartPix) then return 0.
      272     assign
      273       v-start-print = INTEGER(iStartPix + ((iEndPix - iStartPix) / 2) - (iInput / 2))
      274     .
      275     RETURN v-start-print .
      276   END FUNCTION.
      277   FUNCTION right-field RETURNS INTEGER ( iEndPix AS INTEGER,
      278                                     iInput AS INTEGER).
      279     def var v-start-print as integer no-undo .
      280     assign
      281       v-start-print = INTEGER(iEndPix - 1 - iInput)
      282     .
      283     if v-start-print < 0 then return 0.
      284     RETURN v-start-print .
      285   END FUNCTION.
      286   function p-fmt-align-string returns character (
      287         p-in-string      as character
      288       , p-page-width     as integer
      289       , p-align-type     as character
      290   ).
      291       define variable v-string-length     as integer      no-undo.
      292       define variable v-out-string        as character    no-undo.
      293       assign
      294           v-string-length = length( trim( p-in-string ) )
      295       .
      296       if v-string-length >= p-page-width
      297       then do:
      298           assign
      299               v-out-string = trim( p-in-string )
      300           .
      301       end.
      302       else do:
      303           case p-align-type
      304           :
      305               when 'left':U
      306               then do:
      307                   assign
      308                       v-out-string = trim( p-in-string )
      309                   .
      310               end.
      311               when 'right':U
      312               then do:
      313                   assign
      314                       v-out-string = fill( " ":U, p-page-width - v-string-length ) + trim( p-in-string )
      315                   .
      316               end.
      317               when 'center':U
      318               then do:
      319                   assign
      320                       v-out-string = fill( " ":U, integer( ( p-page-width - v-string-length ) / 2 ) ) + trim( p-in-string )
      321                   .
      322               end.
      323           end case.
      324       end.
      325       return v-out-string .
      326   end function.
      327   procedure p-fmt-split-string :
      328   define input parameter p-source-string  as character        no-undo.
      329   define input parameter p-split-length   as integer          no-undo.
      330   define output parameter p-string-1      as character        no-undo.
      331   define output parameter p-string-2      as character        no-undo.
      332   do
      333   on error undo, return error
      334   :
      335       define variable v-space-pos    as integer      no-undo.
      336       if length( p-source-string ) <= p-split-length
      337       then do:
      338           assign
      339               p-string-1 = p-source-string
      340           .
      341       end.
      342       else do:
      343           assign
      344               v-space-pos = r-index( p-source-string, " ":U, p-split-length )
      345           .
      346           if v-space-pos = 0
      347           then do:
      348               assign
      349                   v-space-pos = index( p-source-string, " ":U )
      350               .
      351           end.
      352           if v-space-pos = 0
      353           then do:
      354               assign
      355                   p-string-1 = substring( p-source-string, 1, p-split-length )
      356                   p-string-2 = trim( substring( p-source-string, p-split-length, p-split-length ) )
      357               .
      358           end.
      359           else do:
      360               assign
      361                   p-string-1 = substring( p-source-string, 1, v-space-pos )
      362                   p-string-2 = trim( substring( p-source-string, v-space-pos ) )
      363               .
      364           end.
      365       end.
      366   end.
      367   end procedure.
      368   procedure p-fmt-round :
      369   define input parameter p-qnty               as decimal          no-undo.
      370   define input parameter p-price-no-VAT       as decimal          no-undo.
      371   define input parameter p-VAT                as decimal          no-undo.
      372   define input parameter p-SLT                as decimal          no-undo.
      373   define input parameter p-road-tax           as decimal          no-undo.
      374   define output parameter p-new-price-no-VAT  as decimal          no-undo.
      375   define output parameter p-new-VAT           as decimal          no-undo.
      376   define output parameter p-new-SLT           as decimal          no-undo.
      377   define output parameter p-new-sum-VAT       as decimal          no-undo.
      378   define output parameter p-new-sum-SLT       as decimal          no-undo.
      379   define output parameter p-new-sum-road-tax  as decimal          no-undo.
      380   define output parameter p-new-sum-no-VAT    as decimal          no-undo.
      381   define output parameter p-new-sum-full      as decimal          no-undo.
      382       define variable v-vat-pc    as decimal      no-undo.
      383       define variable v-slt-pc    as decimal      no-undo.
      384   do
      385   on error undo, return error
      386   :
      387       if p-price-no-VAT = 0
      388       then do:
      389           assign
      390               p-new-price-no-VAT = 0.0
      391               p-new-VAT          = ?
      392               p-new-SLT          = ?
      393               p-new-sum-VAT      = 0.0
      394               p-new-sum-SLT      = 0.0
      395               p-new-sum-no-VAT   = 0.0
      396               p-new-sum-road-tax = 0.0
      397               p-new-sum-full     = 0.0
      398           .
      399       end.
      400       else do:
      401           assign
      402               v-vat-pc            = p-VAT / p-price-no-VAT
      403               v-slt-pc            = p-SLT / ( p-price-no-VAT + p-VAT )
      404               p-new-price-no-VAT  = round( p-price-no-VAT, 2 )
      405               p-new-VAT           = round( p-new-price-no-VAT * v-vat-pc, 2 )
      406               p-new-SLT           = round( ( p-new-price-no-VAT + p-new-VAT ) * v-slt-pc, 2 )
      407               p-new-sum-VAT       = round( p-new-VAT          * p-qnty, 2 )
      408               p-new-sum-SLT       = round( ( p-new-price-no-VAT + p-new-VAT ) * p-qnty * v-slt-pc, 2 )
      409               p-new-sum-no-VAT    = round( p-new-price-no-VAT * p-qnty, 2 )
      410               p-new-sum-road-tax  = round( p-road-tax * p-qnty, 2 )
      411               p-new-sum-full      = round( ( p-new-price-no-VAT + p-new-VAT + p-new-SLT + p-road-tax ) * p-qnty, 2 )
      412           .
      413       end.
      414   end.
      415   end procedure.
      416   procedure p-fmt-split :
      417   define input parameter p-in-string      as character        no-undo.
      418   define input parameter p-split-length   as integer          no-undo.
      419       define variable v-start-pos     as integer      no-undo.
      420       define variable v-end-pos       as integer      no-undo.
      421       define buffer buf_temp_p-fmt_string-part        for temp_p-fmt_string-part.
      422   do
      423   for buf_temp_p-fmt_string-part
      424   on error undo, return error
      425   :
      426       empty temp-table buf_temp_p-fmt_string-part.
      427       if p-split-length < 1
      428       then do:
      429           undo, return error substitute( "p-fmt-split: Строка не может быть разбита на &1 частей", p-split-length ).
      430       end.
      431       assign
      432           p-in-string                 = trim( p-in-string )
      433           v-p-fmt-3-str-key   = 0
      434           v-start-pos                 = 1
      435           v-end-pos                   = length( p-in-string )
      436       .
      437       run p-fmt-get-string-range in this-procedure (
      438             input p-in-string
      439           , input p-split-length
      440           , input v-start-pos
      441           , output v-start-pos
      442           , output v-end-pos
      443       ).
      444       do while v-end-pos <> 0
      445       :
      446           create buf_temp_p-fmt_string-part.
      447           assign
      448               v-p-fmt-3-str-key = v-p-fmt-3-str-key + 1
      449           .
      450           assign
      451               buf_temp_p-fmt_string-part.str-key      = v-p-fmt-3-str-key
      452               buf_temp_p-fmt_string-part.string-part  = substring( p-in-string, v-start-pos, v-end-pos - v-start-pos )
      453           .
      454           assign
      455               v-start-pos = v-end-pos + 1
      456           .
      457           run p-fmt-get-string-range in this-procedure (
      458                 input p-in-string
      459               , input p-split-length
      460               , input v-start-pos
      461               , output v-start-pos
      462               , output v-end-pos
      463           ).
      464       end.
      465   end.
      466   end procedure.
      467   procedure p-fmt-get-string-range :
      468   define input parameter p-in-string      as character        no-undo.
      469   define input parameter p-split-length   as integer          no-undo.
      470   define input parameter p-old-start-pos  as integer          no-undo.
      471   define output parameter p-start-pos     as integer          no-undo.
      472   define output parameter p-end-pos       as integer          no-undo.
      473       define variable v-init-string    as character    no-undo.
      474       define variable v-temp-char      as character    no-undo.
      475       define variable v-temp-pos       as integer      no-undo.
      476       define variable v-counter        as integer      no-undo.
      477   do
      478   on error undo, return error
      479   :
      480       assign
      481           p-start-pos   = p-old-start-pos
      482           v-init-string = substring( p-in-string, p-start-pos )
      483       no-error.
      484       if error-status :error
      485       or trim( v-init-string ) = "":U
      486       then do:
      487           assign
      488               p-end-pos = 0
      489           .
      490           undo, return .
      491       end.
      492       assign
      493           v-temp-char   = substring( v-init-string, 1, 1 )
      494       .
      495       do
      496       while trim( v-temp-char ) = "":U
      497       :
      498           assign
      499               p-start-pos     = p-start-pos + 1
      500               v-init-string   = substring( p-in-string, p-start-pos )
      501               v-temp-char     = substring( v-init-string, 1, 1 )
      502           .
      503       end.
      504       assign
      505           v-temp-pos  = p-split-length
      506           v-temp-char = substring( v-init-string, v-temp-pos, 1 )
      507           v-counter   = 0
      508       .
      509       search-word-end:
      510       do
      511       while trim( v-temp-char ) <> "":U
      512       :
      513           assign
      514               v-counter   = v-counter + 1
      515           .
      516           if v-counter > 20
      517           then do:
      518               assign
      519                   v-temp-pos  = p-split-length
      520               .
      521               leave search-word-end.
      522           end.
      523           assign
      524               v-temp-pos  = v-temp-pos - 1
      525               v-temp-char = substring( v-init-string, v-temp-pos, 1 )
      526           .
      527       end.
      528       assign
      529           p-end-pos = p-start-pos + v-temp-pos - 1
      530       .
      531   end.
      532   end procedure.
      533   define variable sym1  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      534   define variable sym2  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      535   define variable sym3  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      536   define variable sym4  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      537   define variable sym5  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      538   define variable sym6  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      539   define variable sym7  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      540   define variable sym8  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      541   define variable sym9  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      542   define variable sym10 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      543   define variable sym11 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      544   define variable sym12 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      545   define variable sym13 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      546   define variable sym14 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      547   define variable sym15 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      548   define variable sym16 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      549   define variable sym17 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      550   define variable sym18 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      551   define variable sym19 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      552   define variable sym20 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      553   define variable sym21 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      554   define variable sym22 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      555   define variable sym23 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      556   define variable sym24 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      557   define variable sym25 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      558   define variable sym26 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      559   define variable sym27 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      560   define variable temp1 as integer   no-undo.
      561   define variable vss-include-info4 as character format "X(65)" no-undo
      562   initial "@(#)$Workfile$ $Revision$".
      563   define variable v-fmtcli-name          as character    no-undo.
      564   define variable v-fmtcli-engl-name     as character    no-undo.
      565   define variable v-fmtcli-addres        as character    no-undo.
      566   define variable v-fmtcli-post-addres   as character    no-undo.
      567   define variable v-fmtcli-full-addres   as character    no-undo.
      568   define variable v-fmtcli-phone         as character    no-undo.
      569   define variable v-fmtcli-inn           as character    no-undo.
      570   define variable v-fmtcli-kpp           as character    no-undo.
      571   define variable v-fmtcli-okpo          as character    no-undo.
      572   define variable v-fmtcli-country       as character    no-undo.
      573   define variable v-fmtcli-city          as character    no-undo.
      574   define variable v-fmtcli-index         as character    no-undo.
      575   define variable v-fmtcli-schet-exists  as logical      no-undo.
      576   define variable v-fmtcli-bank-exists   as logical      no-undo.
      577   define variable v-fmtcli-bank-r-schet  as character    no-undo.
      578   define variable v-fmtcli-bank-c-schet  as character    no-undo.
      579   define variable v-fmtcli-bank-bik      as character    no-undo.
      580   define variable v-fmtcli-bank-name     as character    no-undo.
      581   define variable v-fmtcli-bank-addres   as character    no-undo.
      582   define variable v-fmtcli-bank-city     as character    no-undo.
      583   procedure fmtcli-get-bank :
      584   define input parameter p-host-code      as integer          no-undo.
      585   define input parameter p-obj-type       as character        no-undo.
      586   define input parameter p-obj-code       as integer          no-undo.
      587   define input parameter p-curr-code      as integer          no-undo.
      588       define buffer buf_fin-schet     for ub.fin-schet.
      589       define buffer buf_fin-bank      for ub.fin-bank.
      590   do
      591   for buf_fin-schet
      592     , buf_fin-bank
      593   on error undo, return error
      594   :
      595       assign
      596           v-fmtcli-schet-exists       = no
      597           v-fmtcli-bank-exists        = no
      598           v-fmtcli-bank-r-schet       = "":U
      599           v-fmtcli-bank-c-schet       = "":U
      600           v-fmtcli-bank-bik           = "":U
      601           v-fmtcli-bank-name          = "":U
      602           v-fmtcli-bank-addres        = "":U
      603           v-fmtcli-bank-city          = "":U
      604       .
      605       search-for-schet:
      606       for each buf_fin-schet no-lock
      607          where buf_fin-schet.host-code = p-host-code
      608            and buf_fin-schet.cli-type  = p-obj-type
      609            and buf_fin-schet.cli-code  = p-obj-code
      610            and buf_fin-schet.curr-code = p-curr-code
      611       on error undo, return error
      612       :
      613           if buf_fin-schet.status_   = 'удал':U
      614           then do:
      615           end.
      616           else do:
      617               assign
      618                   v-fmtcli-schet-exists   = yes
      619                   v-fmtcli-bank-r-schet   = trim( buf_fin-schet.r-schet )
      620                   v-fmtcli-bank-c-schet   = trim( buf_fin-schet.c-schet )
      621               .
      622               find first buf_fin-bank no-lock
      623                    where buf_fin-bank.host-code = p-host-code
      624                      and buf_fin-bank.code-bank = buf_fin-schet.code-bank
      625               no-error.
      626               if available buf_fin-bank
      627               then do:
      628                   assign
      629                       v-fmtcli-bank-exists      = yes
      630                       v-fmtcli-bank-bik         = trim( buf_fin-bank.bik )
      631                       v-fmtcli-bank-name        = trim( buf_fin-bank.bank-name )
      632                       v-fmtcli-bank-addres      = trim(buf_fin-bank.addres)
      633                       v-fmtcli-bank-city      = trim(buf_fin-bank.bank-city)
      634                   .
      635               end.
      636               else do:
      637                   assign
      638                       v-fmtcli-bank-exists    = no
      639                       v-fmtcli-bank-bik       = "":U
      640                       v-fmtcli-bank-name      = "":U
      641                       v-fmtcli-bank-addres    = "":U
      642                       v-fmtcli-bank-city      = "":U
      643                   .
      644               end.
      645               leave search-for-schet.
      646           end.
      647       end.
      648   end.
      649   end procedure.
      650   procedure fmtcli-get-client :
      651   define input parameter p-obj-type       as character    no-undo.
      652   define input parameter p-obj-code       as integer      no-undo.
      653       define variable v-temp-fmtcli-address      as character     no-undo.
      654       define variable v-num-country-city    as integer      no-undo.
      655       define buffer buf_clients   for ub.clients.
      656       define buffer buf_firm      for ub.firm.
      657       define buffer buf_store     for ub.store.
      658       define buffer buf_shop      for ub.shop.
      659       define buffer buf_person    for ub.person.
      660   do
      661   for buf_clients
      662     , buf_firm
      663     , buf_store
      664     , buf_shop
      665     , buf_person
      666   on error undo, return error
      667   :
      668       assign
      669           v-fmtcli-name           = "":U
      670           v-fmtcli-addres         = "":U
      671           v-fmtcli-post-addres    = "":U
      672           v-fmtcli-full-addres    = "":U
      673           v-fmtcli-phone          = "":U
      674           v-fmtcli-inn            = "":U
      675           v-fmtcli-kpp            = "":U
      676           v-fmtcli-okpo           = "":U
      677           v-fmtcli-city           = "":U
      678           v-fmtcli-index          = "":U
      679           v-fmtcli-country        = "":U
      680       .
      681       find first buf_clients no-lock
      682            where buf_clients.obj-type = p-obj-type
      683              and buf_clients.obj-code = p-obj-code
      684       .
      685       assign
      686           v-fmtcli-name = buf_clients.obj-name
      687       .
      688       case buf_clients.obj-type:
      689          when 'орг':U
      690          then do:
      691               find first buf_firm no-lock
      692                    where buf_firm.firm-code = buf_clients.obj-code
      693                    no-error
      694               .
      695               if available buf_firm
      696               then do:
      697                   assign
      698                       v-num-country-city = num-entries( buf_firm.city )
      699                       v-fmtcli-engl-name = buf_firm.engl-name
      700                   .
      701                   if v-num-country-city > 0
      702                   then do:
      703                       assign
      704                           v-fmtcli-country    = trim( entry( 1, buf_firm.city ) )
      705                       .
      706                   end.
      707                   if v-num-country-city > 1
      708                   then do:
      709                       assign
      710                           v-fmtcli-city       = trim( entry( 2, buf_firm.city ) )
      711                       .
      712                   end.
      713                   run fmtcli-concatenate-strings in this-procedure (
      714                         input v-fmtcli-full-addres
      715                       , input v-fmtcli-country
      716                       , input ", ":U
      717                       , input 50
      718                       , output v-fmtcli-full-addres
      719                   ).
      720                   run fmtcli-concatenate-strings in this-procedure (
      721                         input v-fmtcli-full-addres
      722                       , input v-fmtcli-city
      723                       , input ", ":U
      724                       , input 50
      725                       , output v-fmtcli-full-addres
      726                   ).
      727                   run fmtcli-concatenate-strings in this-procedure (
      728                         input v-fmtcli-full-addres
      729                       , input IF buf_firm.ind = 0 THEN "" ELSE string( buf_firm.ind )
      730                       , input ", ":U
      731                       , input 50
      732                       , output v-fmtcli-full-addres
      733                   ).
      734                   run fmtcli-concatenate-strings in this-procedure (
      735                         input v-fmtcli-post-addres
      736                       , input v-fmtcli-country
      737                       , input ", ":U
      738                       , input 50
      739                       , output v-fmtcli-post-addres
      740                   ).
      741                   run fmtcli-concatenate-strings in this-procedure (
      742                         input v-fmtcli-post-addres
      743                       , input v-fmtcli-city
      744                       , input ", ":U
      745                       , input 50
      746                       , output v-fmtcli-post-addres
      747                   ).
      748                   run fmtcli-concatenate-strings in this-procedure (
      749                         input v-fmtcli-post-addres
      750                       , input string( buf_firm.ind )
      751                       , input ", ":U
      752                       , input 50
      753                       , output v-fmtcli-post-addres
      754                   ).
      755                   run fmtcli-concatenate-strings in this-procedure (
      756                         input substring( buf_firm.addres1, 1, 50 )
      757                       , input buf_firm.addres2
      758                       , input " ":U
      759                       , input 50
      760                       , output v-temp-fmtcli-address
      761                   ).
      762                   run fmtcli-concatenate-strings in this-procedure (
      763                         input v-temp-fmtcli-address
      764                       , input substring( buf_firm.addres1, 51, 50 )
      765                       , input " ":U
      766                       , input 50
      767                       , output v-temp-fmtcli-address
      768                   ).
      769                   run fmtcli-concatenate-strings in this-procedure (
      770                         input v-temp-fmtcli-address
      771                       , input substring( buf_firm.addres1, 101, 50 )
      772                       , input " ":U
      773                       , input 50
      774                       , output v-temp-fmtcli-address
      775                   ).
      776                   assign
      777                       v-fmtcli-addres = v-temp-fmtcli-address
      778                   .
      779                   if buf_firm.addres1 <> ?
      780                   then do:
      781                       run fmtcli-concatenate-strings in this-procedure (
      782                             input v-fmtcli-full-addres
      783                           , input v-fmtcli-addres
      784                           , input ", ":U
      785                           , input 0
      786                           , output v-fmtcli-full-addres
      787                       ).
      788                   end.
      789                   run fmtcli-concatenate-strings in this-procedure (
      790                         input substring( buf_firm.post-addr1, 1, 50 )
      791                       , input buf_firm.post-addr2
      792                       , input " ":U
      793                       , input 50
      794                       , output v-fmtcli-post-addres
      795                   ).
      796                   run fmtcli-concatenate-strings in this-procedure (
      797                         input v-fmtcli-post-addres
      798                       , input substring( buf_firm.post-addr1, 51, 50 )
      799                       , input " ":U
      800                       , input 50
      801                       , output v-fmtcli-post-addres
      802                   ).
      803                   run fmtcli-concatenate-strings in this-procedure (
      804                         input v-fmtcli-post-addres
      805                       , input substring( buf_firm.post-addr1, 101, 50 )
      806                       , input " ":U
      807                       , input 50
      808                       , output v-fmtcli-post-addres
      809                   ).
      810                   assign
      811                       v-fmtcli-phone         = buf_firm.phone
      812                       v-fmtcli-inn           = buf_firm.inn
      813                       v-fmtcli-kpp           = buf_firm.kpp
      814                       v-fmtcli-okpo          = buf_firm.okpo
      815                       v-fmtcli-index         = string( buf_firm.ind )
      816                   .
      817               end.
      818          end.
      819          when 'маг':U
      820          then do:
      821               find first buf_shop no-lock
      822                    where buf_shop.obj-code = buf_clients.obj-code
      823               .
      824               if available buf_shop
      825               then do:
      826                   run fmtcli-concatenate-strings in this-procedure (
      827                         input buf_shop.addres1
      828                       , input buf_shop.addres2
      829                       , input " ":U
      830                       , input 50
      831                       , output v-fmtcli-addres
      832                   ).
      833                   assign
      834                       v-fmtcli-full-addres = v-fmtcli-addres
      835                       v-fmtcli-post-addres = v-fmtcli-addres
      836                       v-fmtcli-phone       = buf_shop.phone
      837                       v-fmtcli-inn         = "":U
      838                       v-fmtcli-kpp         = "":U
      839                       v-fmtcli-okpo        = "":U
      840                       v-fmtcli-city        = "":U
      841                       v-fmtcli-index       = "":U
      842                   .
      843               end.
      844          end.
      845          when 'скл':U
      846          then do:
      847               find first buf_store no-lock
      848                    where buf_store.obj-code = buf_clients.obj-code
      849               .
      850               if available buf_store
      851               then do:
      852                   run fmtcli-concatenate-strings in this-procedure (
      853                         input buf_store.addres1
      854                       , input buf_store.addres2
      855                       , input " ":U
      856                       , input 50
      857                       , output v-fmtcli-addres
      858                   ).
      859                   assign
      860                       v-fmtcli-full-addres = v-fmtcli-addres
      861                       v-fmtcli-phone       = buf_store.phone
      862                       v-fmtcli-inn         = "":U
      863                       v-fmtcli-kpp         = "":U
      864                       v-fmtcli-okpo        = "":U
      865                       v-fmtcli-city        = "":U
      866                       v-fmtcli-index       = "":U
      867                   .
      868               end.
      869          end.
      870          when 'чел':U
      871          then do:
      872               find first buf_person no-lock
      873                    where buf_person.psn-code = buf_clients.obj-code
      874               .
      875               if available buf_person
      876               then do:
      877                   run fmtcli-concatenate-strings in this-procedure (
      878                         input ( if buf_person.ind = 0 or buf_person.ind = ?
      879                                 then "":U
      880                                 else string( buf_person.ind, "999999")
      881                                 )
      882                       , input buf_person.city
      883                       , input ", ":U
      884                       , input 0
      885                       , output v-fmtcli-full-addres
      886                   ).
      887                   assign
      888                       v-fmtcli-addres = buf_person.address
      889                   .
      890                   run fmtcli-concatenate-strings in this-procedure (
      891                         input v-fmtcli-full-addres
      892                       , input v-fmtcli-addres
      893                       , input ", ":U
      894                       , input 0
      895                       , output v-fmtcli-full-addres
      896                   ).
      897                   assign
      898                       v-fmtcli-phone     = buf_person.phone1
      899                       v-fmtcli-inn       = buf_person.inn
      900                       v-fmtcli-kpp       = buf_person.kpp
      901                       v-fmtcli-okpo      = buf_person.okpo
      902                       v-fmtcli-city      = buf_person.city
      903                       v-fmtcli-index     = string( buf_person.ind )
      904                   .
      905               end.
      906          end.
      907       end case.
      908   end.
      909   end procedure.
      910   procedure fmtcli-concatenate-strings :
      911   define input parameter p-string-1       as character        no-undo.
      912   define input parameter p-string-2       as character        no-undo.
      913   define input parameter p-delimiter      as character        no-undo.
      914   define input parameter p-length         as integer          no-undo.
      915   define output parameter p-out-string    as character        no-undo.
      916   do
      917   on error undo, return error
      918   :
      919       assign
      920           p-out-string = ( if p-string-1 = ?
      921                            then "":U
      922                            else trim( p-string-1 ) )
      923       .
      924       assign
      925           p-out-string = p-out-string
      926                        + ( if p-out-string = "":U
      927                            or length( p-out-string ) = p-length
      928                            or p-string-2 = ?
      929                            or trim( p-string-2 ) = "":U
      930                            then "":U
      931                            else p-delimiter )
      932                        + ( if p-string-2 = ?
      933                            or trim( p-string-2 ) = "":U
      934                            then "":U
      935                            else trim( p-string-2 ) )
      936       .
      937   end.
      938   end procedure.
