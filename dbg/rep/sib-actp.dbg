     4693           sym17
     4694           tt-report.col-17
     4695           sym18
     4696         with frame sib-act .
     4697         down stream out-stream with frame sib-act.
     4698       end.
     4699       run hor-line in this-procedure .
     4700       run sibactxl-write-line-data in this-procedure ( input tt-report.col-1
     4701                                                      , input tt-report.col-2
     4702                                                      , input tt-report.col-3
     4703                                                      , input tt-report.col-4
     4704                                                      , input tt-report.col-5
     4705                                                      , input tt-report.col-6
     4706                                                      , input tt-report.col-7
     4707                                                      , input tt-report.col-8
     4708                                                      , input tt-report.col-9
     4709                                                      , input tt-report.col-10
     4710                                                      , input tt-report.col-11
     4711                                                      , input tt-report.col-12
     4712                                                      , input tt-report.col-13
     4713                                                      , input tt-report.col-14
     4714                                                      , input tt-report.col-15
     4715                                                      , input tt-report.col-16
     4716                                                      , input tt-report.col-17
     4717                                                      ) .
     4718   end.
     4719   end procedure.
     4720   procedure fill-tt-report :
     4721   define buffer buf_doc-line-attr for ub.doc-line-attr.
     4722   define buffer buf_clients       for ub.clients.
     4723   define variable is-petrolium           as logical   no-undo .
     4724   define variable is-pieces              as logical   no-undo .
     4725   define variable v-autoent-obj-code     as character no-undo .
     4726   define variable v-autoent-obj-type     as character no-undo .
     4727   define variable v-car-num              as character no-undo .
     4728   define variable v-car-vol              as character no-undo .
     4729   define variable v-tank-density         as character no-undo .
     4730   define variable v-tank-temp            as character no-undo .
     4731   define variable v-tank-vol             as character no-undo .
     4732   define variable v-time-pour            as character no-undo .
     4733   define variable v-time-income          as character no-undo .
     4734   define variable v-time-start           as character no-undo .
     4735   define variable v-time-end             as character no-undo .
     4736   define variable v-fio                  as character no-undo .
     4737   define variable v-mouth                as character no-undo .
     4738   define variable v-a-b-tarir            as character no-undo .
     4739   define variable v-car-vol-dec          as decimal   no-undo .
     4740   define variable v-tank-density-dec     as decimal   no-undo .
     4741   define variable v-tank-temp-dec        as decimal   no-undo .
     4742   define variable v-tank-vol-dec         as decimal   no-undo .
     4743   define variable v-mouth-dec            as decimal   no-undo .
     4744   define variable v-a-b-tarir-dec        as decimal   no-undo .
     4745   define variable v-time-pour-int        as integer   no-undo .
     4746   define variable v-time-income-int      as integer   no-undo .
     4747   define variable v-item-pour            as character no-undo .
     4748   define variable v-head-time-pour-int   as integer initial ?  no-undo .
     4749   define variable v-head-time-income-int as integer initial ?  no-undo .
     4750   define variable v-autoent-obj-code-int as integer   no-undo .
     4751   define variable v-tmp-dec              as decimal   no-undo .
     4752   do
     4753   on error undo, return error return-value
     4754   :
     4755     _doc-line:
     4756     for each buf_doc-line no-lock
     4757       where buf_doc-line.doc-code = buf_trn-doc.doc-code
     4758     :
     4759   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     4760     (
     4761        input buf_doc-line.artic
     4762     ,  input buf_doc-line.prod-type
     4763     ,  input buf_doc-line.prod-code
     4764     , output is-petrolium
     4765     , output is-pieces
     4766     ) no-error.
     4767         if error-status :error or is-petrolium <> yes or is-pieces <> no then do: next _doc-line. end.
     4768         find first buf_goods no-lock
     4769           where buf_goods.artic     = buf_doc-line.artic
     4770             and buf_goods.prod-type = buf_doc-line.prod-type
     4771             and buf_goods.prod-code = buf_doc-line.prod-code
     4772         no-error .
     4773         if not available buf_goods then do:
     4774           next _doc-line.
     4775         end.
     4776       for each buf_doc-line-attr no-lock
     4777          where buf_doc-line-attr.doc-code = buf_trn-doc.doc-code
     4778            and buf_doc-line-attr.gds-code = buf_goods.gds-code
     4779       :
     4780           case buf_doc-line-attr.attr-code:
     4781             when "car-vol"
     4782             then do:
     4783               assign
     4784                  v-car-vol = trim(buf_doc-line-attr.attr-value)
     4785               .
     4786             end.
     4787             when "tank-density"
     4788             then do:
     4789               assign
     4790                  v-tank-density = trim(buf_doc-line-attr.attr-value)
     4791               .
     4792             end.
     4793             when "tank-temp"
     4794             then do:
     4795               assign
     4796                  v-tank-temp = trim(buf_doc-line-attr.attr-value)
     4797               .
     4798             end.
     4799             when "tank-vol"
     4800             then do:
     4801               assign
     4802                  v-tank-vol = trim(buf_doc-line-attr.attr-value)
     4803               .
     4804             end.
     4805             when "time-pour"
     4806             then do:
     4807               assign
     4808                  v-time-pour = trim(buf_doc-line-attr.attr-value)
     4809               .
     4810             end.
     4811             when "mouth"
     4812             then do:
     4813               assign
     4814                  v-mouth = trim(buf_doc-line-attr.attr-value)
     4815               .
     4816             end.
     4817             when "a-b-tarir"
     4818             then do:
     4819               assign
     4820                  v-a-b-tarir = trim(buf_doc-line-attr.attr-value)
     4821               .
     4822             end.
     4823           end case.
     4824       end.
     4825       for each buf_doc-attr no-lock where
     4826                buf_doc-attr.doc-code = buf_trn-doc.doc-code:
     4827         case buf_doc-attr.attr-code :
     4828       when 'autoent':U then do:
     4829         assign
     4830           v-autoent-obj-type = entry (1, buf_doc-attr.attr-value, ";")
     4831           v-autoent-obj-code = entry (2, buf_doc-attr.attr-value, ";")
     4832         no-error.
     4833       end.
     4834       when 'car-num':U then do: assign v-car-num = trim( buf_doc-attr.attr-value ). end.
     4835       when 'time-income':U then do: assign v-time-income = trim( buf_doc-attr.attr-value ). end.
     4836       when 'ptb-item-pour':U then do: assign v-item-pour = trim( buf_doc-attr.attr-value ). end.
     4837       when 'fio-driver':U then do: assign v-fio = trim( buf_doc-attr.attr-value ). end.
     4838         end case.
     4839       end.
     4840       if v-time-pour <> "" then do:
     4841         assign
     4842           v-time-pour-int = integer(substring(v-time-pour, 1, 2)) * 3600 + integer(substring(v-time-pour, 4, 2)) * 60
     4843         no-error .
     4844         if error-status :error then do:
     4845           assign
     4846             v-time-pour-int = ?
     4847           .
     4848         end.
     4849         assign
     4850           v-head-time-pour-int  = if v-head-time-pour-int <> ? and v-time-pour-int <> ?
     4851                                   then minimum( v-head-time-pour-int , v-time-pour-int )
     4852                                   else v-time-pour-int
     4853         .
     4854       end.
     4855       if v-time-income <> "" then do:
     4856         assign
     4857           v-time-income-int = integer(substring(v-time-income, 1, 2)) * 3600 + integer(substring(v-time-income, 4, 2)) * 60
     4858         no-error .
     4859         if error-status :error then do:
     4860           assign
     4861             v-time-income-int = ?
     4862           .
     4863         end.
     4864         assign
     4865           v-head-time-income-int =  if v-head-time-income-int <> ? and v-time-income-int <> ?
     4866                                     then minimum( v-head-time-income-int , v-time-income-int )
     4867                                     else v-time-income-int
     4868         .
     4869       end.
     4870       if v-autoent-obj-type <> "" and v-autoent-obj-code <> "" then do:
     4871         assign
     4872           v-autoent-obj-code-int = integer( v-autoent-obj-code )
     4873         .
     4874         find first buf_clients no-lock
     4875           where buf_clients.obj-type = v-autoent-obj-type
     4876             and buf_clients.obj-code = v-autoent-obj-code-int
     4877         no-error .
     4878         if available buf_clients then do :
     4879           assign
     4880             v-head-autoent-obj-name = buf_clients.obj-name
     4881           .
     4882         end.
     4883       end.
     4884           assign           v-car-vol-dec = decimal(v-car-vol)         no-error.         if error-status:error then do :           assign             v-car-vol-dec = ?           .         end .
     4885           assign           v-tank-density-dec = decimal(v-tank-density)         no-error.         if error-status:error then do :           assign             v-tank-density-dec = ?           .         end .
     4886           assign           v-tank-temp-dec = decimal(v-tank-temp)         no-error.         if error-status:error then do :           assign             v-tank-temp-dec = ?           .         end .
     4887           assign           v-tank-vol-dec = decimal(v-tank-vol)         no-error.         if error-status:error then do :           assign             v-tank-vol-dec = ?           .         end .
     4888           assign           v-mouth-dec = decimal(v-mouth)         no-error.         if error-status:error then do :           assign             v-mouth-dec = ?           .         end .
     4889           assign           v-a-b-tarir-dec = decimal(v-a-b-tarir)         no-error.         if error-status:error then do :           assign             v-a-b-tarir-dec = ?           .         end .
     4890       create tt-report.
     4891       assign
     4892         tt-report.line-num  = buf_doc-line.line-num
     4893         tt-report.gds-code  = buf_goods.gds-code
     4894         tt-report.col-1     = string( v-head-doc-date ) + " " + buf_trn-doc.doc-code +
     4895                               ( if v-fio <> "" then ", " + v-fio else "" )
     4896         tt-report.col-2     = v-car-num
     4897         tt-report.col-3     = buf_goods.gds-name
     4898         tt-report.col-4     = string( buf_doc-line.doc-qnty , "->>>>>9.99" )
     4899         tt-report.col-5     = string( buf_doc-line.cli-qnty , "->>>>>9.99" )
     4900         tt-report.col-6     = if v-a-b-tarir-dec <> ?
     4901                               then string( v-a-b-tarir-dec , "->>9.99" )
     4902                               else ""
     4903         tt-report.col-7     = if v-mouth-dec <> ?
     4904                               then string( v-mouth-dec , "->>>>>9.99" )
     4905                               else ""
     4906         tt-report.col-8     = if v-car-vol-dec  <> ?
     4907                               then string( v-car-vol-dec , "->>>>>9.99" )
     4908                               else ""
     4909         tt-report.col-9     = if v-tank-vol-dec <> ?
     4910                               then string( v-tank-vol-dec , "->>>>>9.99" )
     4911                               else ""
     4912         tt-report.col-10    = if v-tank-density-dec <> ?
     4913                               then string( v-tank-density-dec , ">>9.999999" )
     4914                               else ""
     4915         tt-report.col-11    = if v-tank-temp-dec <> ?
     4916                               then string( v-tank-temp-dec , "->9.9" )
     4917                               else ""
     4918         v-tmp-dec           = v-tank-vol-dec * v-tank-density-dec
     4919         tt-report.col-12    = if v-tmp-dec <> ? then string( v-tmp-dec , "->>>>>9.99" ) else ""
     4920         tt-report.col-13    = if v-tmp-dec <> ? then string( ( v-tmp-dec * 0.4 ) / 100 , "->>>>>9.99") else ""
     4921         v-tmp-dec           = ( ( buf_doc-line.cli-qnty - v-tmp-dec ) / buf_doc-line.cli-qnty ) * 100
     4922         tt-report.col-14    = if v-tmp-dec <> ? then string( v-tmp-dec , "->>>>>9.99" ) else ""
     4923         v-tmp-dec           = buf_doc-line.cli-qnty - v-tank-vol-dec * v-tank-density-dec
     4924         tt-report.col-15    = if v-tmp-dec <> ? then string( v-tmp-dec , "->>>>>9.99" ) else ""
     4925         v-tmp-dec           = v-tmp-dec / v-tank-density-dec
     4926         tt-report.col-16    = if v-tmp-dec <> ? then string( v-tmp-dec , "->>>>>9.99" ) else ""
     4927         v-tmp-dec           = buf_doc-line.doc-qnty - v-tmp-dec
     4928         tt-report.col-17    = if v-tmp-dec <> ? then string( v-tmp-dec , "->>>>>9.99" ) else ""
     4929       .
     4930     end.
     4931     assign
     4932       v-head-time-pour    = if v-head-time-income-int <> ? then string( v-head-time-income-int , "HH:MM" ) else ""
     4933       v-head-time-income  = if v-head-time-pour-int   <> ? then string( v-head-time-pour-int   , "HH:MM" ) else ""
     4934     .
     4935   end.
     4936   end procedure.
     4937   procedure hor-line :
     4938   do
     4939   on error undo, return error return-value
     4940   :
     4941     put stream out-stream fill('-' , 199) format "X(199)" skip.
     4942   end.
     4943   end procedure.
