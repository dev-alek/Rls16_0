     4634           sym18
     4635         with frame sib-act .
     4636         down stream out-stream with frame sib-act.
     4637         display stream out-stream
     4638           sym1
     4639           substring(tt-report.col-1, v-i + 1 ) @ tt-report.col-1
     4640           sym2
     4641           sym3
     4642           sym4
     4643           sym5
     4644           sym6
     4645           sym7
     4646           sym8
     4647           sym9
     4648           sym10
     4649           sym11
     4650           sym12
     4651           sym13
     4652           sym14
     4653           sym15
     4654           sym16
     4655           sym17
     4656           sym18
     4657         with frame sib-act .
     4658       end.
     4659       else do:
     4660         display stream out-stream
     4661           sym1
     4662           tt-report.col-1
     4663           sym2
     4664           tt-report.col-2
     4665           sym3
     4666           tt-report.col-3
     4667           sym4
     4668           tt-report.col-4
     4669           sym5
     4670           tt-report.col-5
     4671           sym6
     4672           tt-report.col-6
     4673           sym7
     4674           tt-report.col-7
     4675           sym8
     4676           tt-report.col-8
     4677           sym9
     4678           tt-report.col-9
     4679           sym10
     4680           tt-report.col-10
     4681           sym11
     4682           tt-report.col-11
     4683           sym12
     4684           tt-report.col-12
     4685           sym13
     4686           tt-report.col-13
     4687           sym14
     4688           tt-report.col-14
     4689           sym15
     4690           tt-report.col-15
     4691           sym16
