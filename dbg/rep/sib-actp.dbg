        1   block-level on error undo, throw.
        2   define input parameter parparentproc   as handle    no-undo.
        3   define input parameter p-trn-recid     as recid     no-undo.
        4   define variable vss-revision    as character no-undo init "$Revision: 099a383cf864, 290, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: PGridchina $":U .
        6   define variable vss-date        as character no-undo init "$Date: Tue Dec 01 19:11:24 2015 +0300 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: sib-actp.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: rep/sib-actp.p $":U .
        9   define variable vss-description as character no-undo init "Акт приема нефтепродуктов по количеству".
       10   procedure vss-get-info :
