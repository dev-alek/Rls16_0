     6242   END PROCEDURE.
     6243   PROCEDURE state-changed :
     6244     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE NO-UNDO.
     6245     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     6246   END PROCEDURE.
     6247   PROCEDURE st_excel :
     6248   define input-output parameter p-rows as integer no-undo .
     6249   define input-output parameter p-pn as integer no-undo .
     6250   define buffer buf_sheetf for sheetf.
     6251   p-rows = p-rows + 1.
     6252   if p-rows > 50000 then do:
     6253     p-pn = p-pn + 1.
     6254     p-rows = 0.
     6255     find first buf_sheetf where
     6256               buf_sheetf.sheet-num = p-pn no-error.
     6257     if not available buf_sheetf then do:
     6258       create buf_sheetf.
     6259       buffer-copy sheetf except sheet-num to buf_sheetf
     6260       assign
     6261       buf_sheetf.sheet-num = p-pn
     6262       .
     6263       if   Make-Excel Then  do:   Output stream ForExcel close.   assign   number-list = number-list + 1   .   os-delete value( v-excel-file + ".":U + string(number-list)).   Output Stream ForExcel to value( v-excel-file + ".":U + string(number-list ) ) . end.
     6264       run rep/extitle.p ( input p-pn).
     6265     end.
     6266   end.
     6267   end procedure.
