     3070   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     3071     (input  bf_trn-doc.obj-type
     3072     ,input  bf_trn-doc.obj-code
     3073     ,input  varb-code
     3074     ,input  0
     3075     ,input  bf_trn-doc.fact-order
     3076     ,output vardoc-num
     3077     ,output varprice-sale
     3078     ,output varroad-tax
     3079     ,output varexcise
     3080     )  .
     3081             if varprice-sale = ?
     3082             then do:
     3083               assign
     3084                 varprice-sale = 0
     3085                 varroad-tax   = 0
     3086                 varexcise     = 0
     3087               .
     3088             end.
     3089             assign
     3090               varlastcur-base     = varprice-sale
     3091               varlastcur-road-tax = varroad-tax
     3092               varlastcur-excise   = varexcise
     3093               varcur-base         = varcur-base      + varprice-sale * bf_gds-dtl.fact-qnty
     3094               varcur-road-tax     = varcur-road-tax  + varroad-tax   * bf_gds-dtl.fact-qnty
     3095               varcur-excise       = varcur-excise    + varexcise     * bf_gds-dtl.fact-qnty
     3096               varcur-fact-qnty    = varcur-fact-qnty + bf_gds-dtl.fact-qnty
     3097             .
     3098         end.
     3099       end.
     3100       if varcur-fact-qnty = 0 then do:
     3101         assign
     3102           varcur-base      = varlastcur-base
     3103           varcur-road-tax  = varlastcur-road-tax
     3104           varcur-excise    = varlastcur-excise
     3105         .
     3106       end.
     3107       else do:
     3108         assign
     3109           varcur-base      = varcur-base      / varcur-fact-qnty
     3110           varcur-road-tax  = varcur-road-tax  / varcur-fact-qnty
     3111           varcur-excise    = varcur-excise    / varcur-fact-qnty
     3112         .
     3113       end.
     3114       if varcur-vat-pc = ?
     3115       then do:
     3116         return error substitute ("Нет текущего продажного НДС по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     3117       end.
     3118       if varcur-slt-pc = ?
     3119       then do:
     3120         return error substitute ("Нет текущего продажного НП по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     3121       end.
     3122       find first bf_sysconf where bf_sysconf.host-code = bf_trn-doc.host-code no-lock.
     3123       assign
     3124         varcur-cons-vat-pc = bf_sysconf.cons-vat-pc.
     3125       if varcur-cons-vat-pc = ? then do:
     3126         return error substitute ("Нет текущего продажного консигнационного НДС по фирме &1", bf_trn-doc.host-code).
     3127       end.
     3128       define buffer buf_tt-clcparts for tt-clcparts .
     3129       for each buf_tt-clcparts
     3130       on error undo, return error return-value
     3131       :
     3132         delete buf_tt-clcparts.
     3133       end.
     3134       for each bf_parts no-lock
     3135         where bf_parts.out-code  = bf_doc-line.doc-code
     3136           and bf_parts.obj-type  = bf_doc-line.obj-type
     3137           and bf_parts.obj-code  = bf_doc-line.obj-code
     3138           and bf_parts.artic     = bf_doc-line.artic
     3139           and bf_parts.prod-type = bf_doc-line.prod-type
     3140           and bf_parts.prod-code = bf_doc-line.prod-code
     3141       on error undo, return error return-value
     3142       :
     3143         create buf_tt-clcparts .
     3144         buffer-copy bf_parts to buf_tt-clcparts .
     3145         if v-calcbypart = yes   then do:
     3146   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run partbcod in g#library
     3147     (buffer bf_parts
     3148     ,output v-b-pcode
     3149     ) no-error .
     3150   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3151   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     3152     (input  bf_parts.obj-type
     3153     ,input  bf_parts.obj-code
     3154     ,input  v-b-pcode
     3155     ,input  0
     3156     ,input  bf_trn-doc.fact-order
     3157     ,output vardoc-num
     3158     ,output varprice-salef
     3159     ,output varroad-tax
     3160     ,output varexcise
     3161     ) no-error .
     3162             if varprice-sale = ?
     3163             then do:
     3164               assign
     3165                 varprice-salef = 0
     3166                 varroad-tax   = 0
     3167                 varexcise     = 0
     3168               .
     3169             end.
     3170             assign
     3171             part-cur-base  = varprice-salef
     3172             part-cur-road-tax  = varroad-tax
     3173             part-cur-excise = varexcise.
     3174         end.
     3175       end.
     3176       run clcprtsl_calc-ttable in this-procedure
     3177         (input yes,
     3178          input yes,
     3179          input bf_doc-line.road-tax,
     3180          input bf_doc-line.excise,
     3181          input bf_doc-line.vat-pc,
     3182          input bf_doc-line.cons-vat-pc,
     3183          input bf_doc-line.slt-pc,
     3184          input bf_trn-doc.base-rate,
     3185          input bf_trn-doc.base-scale,
     3186          input varr-b,
     3187          input varcur-base,
     3188          input varcur-road-tax,
     3189          input varcur-excise,
     3190          input varcur-vat-pc,
     3191          input varcur-cons-vat-pc,
     3192          input varcur-slt-pc
     3193          ) no-error.
     3194       if error-status:error then do:
     3195         message
     3196           vss-workfile vss-revision vss-description skip
     3197           "Ошибка при вызове процедуры clcprtsl_calc-ttable." skip
     3198           return-value skip
     3199           trim(error-status :get-message(1))
     3200           trim(error-status :get-message(2))
     3201           trim(error-status :get-message(3))
     3202           trim(error-status :get-message(4))
     3203           trim(error-status :get-message(5)) skip
     3204           view-as alert-box error.
     3205         undo, return error .
     3206       end.
     3207     end.
     3208   end.
     3209   end.
     3210   procedure clcprtsl_calc-ttable :
     3211   define input parameter paris-doc           as   logical                 no-undo.
     3212   define input parameter paris-cur           as   logical                 no-undo.
     3213   define input parameter parroad-tax         like ub.doc-line.road-tax    no-undo.
     3214   define input parameter parexcise           like ub.doc-line.excise      no-undo.
     3215   define input parameter parvat-pc           like ub.doc-line.vat-pc      no-undo.
     3216   define input parameter parcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     3217   define input parameter parslt-pc           like ub.doc-line.slt-pc      no-undo.
     3218   define input parameter parbase-rate        like ub.trn-doc.base-rate    no-undo.
     3219   define input parameter parbase-scale       like ub.trn-doc.base-scale   no-undo.
     3220   define input parameter parr-b              as   character               no-undo.
     3221   define input parameter parcur-base         like ub.gds-dtl.cur-base     no-undo.
     3222   define input parameter parcur-road-tax     like ub.doc-line.road-tax    no-undo.
     3223   define input parameter parcur-excise       like ub.doc-line.excise      no-undo.
     3224   define input parameter parcur-vat-pc       like ub.doc-line.vat-pc      no-undo.
     3225   define input parameter parcurcons-vat-pc   like ub.doc-line.cons-vat-pc no-undo.
     3226   define input parameter parcurslt-pc        like ub.doc-line.slt-pc      no-undo.
     3227   define buffer bf_tt-allsum      for tt-allsum.
     3228   define buffer bf_tt-clcparts    for tt-clcparts.
     3229   define buffer bf_tt-allsum-line for tt-allsum-line.
     3230   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     3231   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     3232   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     3233   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     3234   define variable varexcise          like ub.price-list.excise     no-undo.
     3235   do on error undo, return error return-value :
     3236   for each bf_tt-allsum-line
     3237   on error undo, return error return-value
     3238    :
     3239     delete bf_tt-allsum-line.
     3240   end.
     3241   for each bf_tt-allsum
     3242   on error undo, return error return-value
     3243   :
     3244     delete bf_tt-allsum.
     3245   end.
     3246   for each bf_tt-clcparts
     3247   on error undo, return error return-value
     3248   :
     3249   if v-calcbypart then do:
     3250             assign
     3251             parcur-base =   bf_tt-clcparts.part-cur-base
     3252             parcur-road-tax = bf_tt-clcparts.part-cur-road-tax
     3253             parcur-excise =   bf_tt-clcparts.part-cur-excise
     3254             .
     3255   end.
     3256      run clcprtsl_calc-parts in this-procedure (
     3257        input recid(bf_tt-clcparts),
     3258        input paris-doc,
     3259        input paris-cur,
     3260        input parroad-tax,
     3261        input parexcise,
     3262        input parvat-pc,
     3263        input parcons-vat-pc,
     3264        input parslt-pc,
     3265        input parbase-rate,
     3266        input parbase-scale,
     3267        input parr-b,
     3268        input parcur-base,
     3269        input parcur-road-tax,
     3270        input parcur-excise,
     3271        input parcur-vat-pc,
     3272        input parcurcons-vat-pc,
     3273        input parcurslt-pc
     3274        ) no-error.
     3275     if error-status:error then do:
     3276       message
     3277         vss-workfile vss-revision vss-description skip
     3278         vss-include-info13 skip
     3279         "Ошибка при обсчете партии" skip
     3280         "Документ партии " bf_tt-clcparts.out-code skip
     3281         "Товар" bf_tt-clcparts.artic bf_tt-clcparts.prod-type bf_tt-clcparts.prod-code skip
     3282         return-value skip
     3283         error-status:get-message(1) skip
     3284         error-status:get-message(2) skip
     3285         error-status:get-message(3) skip
     3286         view-as alert-box error .
     3287       undo, return error .
     3288     end.
     3289     for each bf_tt-allsum on error undo, return error return-value :
     3290       find first bf_tt-allsum-line where bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type no-error.
     3291       if not available bf_tt-allsum-line then do:
     3292         create bf_tt-allsum-line.
     3293         assign
     3294           bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type.
     3295       end.
     3296       assign
     3297         bf_tt-allsum-line.fact-qnty              = bf_tt-allsum-line.fact-qnty            + bf_tt-allsum.fact-qnty
     3298         bf_tt-allsum-line.cli-qnty               = bf_tt-allsum-line.cli-qnty             + bf_tt-allsum.cli-qnty
     3299         bf_tt-allsum-line.sum-dsc-base-doc       = bf_tt-allsum-line.sum-dsc-base-doc     + bf_tt-allsum.sum-dsc-base-doc
     3300         bf_tt-allsum-line.sum-dsc-rubl-doc       = bf_tt-allsum-line.sum-dsc-rubl-doc     + bf_tt-allsum.sum-dsc-rubl-doc
     3301         bf_tt-allsum-line.dsc-base-doc           = bf_tt-allsum-line.dsc-base-doc         + bf_tt-allsum.dsc-base-doc
     3302         bf_tt-allsum-line.dsc-rubl-doc           = bf_tt-allsum-line.dsc-rubl-doc         + bf_tt-allsum.dsc-rubl-doc
     3303         bf_tt-allsum-line.vat-base-doc           = bf_tt-allsum-line.vat-base-doc         + bf_tt-allsum.vat-base-doc
     3304         bf_tt-allsum-line.vat-rubl-doc           = bf_tt-allsum-line.vat-rubl-doc         + bf_tt-allsum.vat-rubl-doc
     3305         bf_tt-allsum-line.vat-base-buyer-doc     = bf_tt-allsum-line.vat-base-buyer-doc   + bf_tt-allsum.vat-base-buyer-doc
     3306         bf_tt-allsum-line.vat-rubl-buyer-doc     = bf_tt-allsum-line.vat-rubl-buyer-doc   + bf_tt-allsum.vat-rubl-buyer-doc
     3307         bf_tt-allsum-line.slt-base-doc           = bf_tt-allsum-line.slt-base-doc         + bf_tt-allsum.slt-base-doc
     3308         bf_tt-allsum-line.slt-rubl-doc           = bf_tt-allsum-line.slt-rubl-doc         + bf_tt-allsum.slt-rubl-doc
     3309         bf_tt-allsum-line.road-tax-base-doc      = bf_tt-allsum-line.road-tax-base-doc    + bf_tt-allsum.road-tax-base-doc
     3310         bf_tt-allsum-line.road-tax-rubl-doc      = bf_tt-allsum-line.road-tax-rubl-doc    + bf_tt-allsum.road-tax-rubl-doc
     3311         bf_tt-allsum-line.excise-base-doc        = bf_tt-allsum-line.excise-base-doc      + bf_tt-allsum.excise-base-doc
     3312         bf_tt-allsum-line.excise-rubl-doc        = bf_tt-allsum-line.excise-rubl-doc      + bf_tt-allsum.excise-rubl-doc
     3313         bf_tt-allsum-line.sum-dsc-base-cur       = bf_tt-allsum-line.sum-dsc-base-cur     + bf_tt-allsum.sum-dsc-base-cur
     3314         bf_tt-allsum-line.sum-dsc-rubl-cur       = bf_tt-allsum-line.sum-dsc-rubl-cur     + bf_tt-allsum.sum-dsc-rubl-cur
     3315         bf_tt-allsum-line.dsc-base-cur           = bf_tt-allsum-line.dsc-base-cur         + bf_tt-allsum.dsc-base-cur
     3316         bf_tt-allsum-line.dsc-rubl-cur           = bf_tt-allsum-line.dsc-rubl-cur         + bf_tt-allsum.dsc-rubl-cur
     3317         bf_tt-allsum-line.vat-base-cur           = bf_tt-allsum-line.vat-base-cur         + bf_tt-allsum.vat-base-cur
     3318         bf_tt-allsum-line.vat-rubl-cur           = bf_tt-allsum-line.vat-rubl-cur         + bf_tt-allsum.vat-rubl-cur
     3319         bf_tt-allsum-line.vat-base-buyer-cur     = bf_tt-allsum-line.vat-base-buyer-cur   + bf_tt-allsum.vat-base-buyer-cur
     3320         bf_tt-allsum-line.vat-rubl-buyer-cur     = bf_tt-allsum-line.vat-rubl-buyer-cur   + bf_tt-allsum.vat-rubl-buyer-cur
     3321         bf_tt-allsum-line.slt-base-cur           = bf_tt-allsum-line.slt-base-cur         + bf_tt-allsum.slt-base-cur
     3322         bf_tt-allsum-line.slt-rubl-cur           = bf_tt-allsum-line.slt-rubl-cur         + bf_tt-allsum.slt-rubl-cur
     3323         bf_tt-allsum-line.road-tax-base-cur      = bf_tt-allsum-line.road-tax-base-cur    + bf_tt-allsum.road-tax-base-cur
     3324         bf_tt-allsum-line.road-tax-rubl-cur      = bf_tt-allsum-line.road-tax-rubl-cur    + bf_tt-allsum.road-tax-rubl-cur
     3325         bf_tt-allsum-line.excise-base-cur        = bf_tt-allsum-line.excise-base-cur      + bf_tt-allsum.excise-base-cur
     3326         bf_tt-allsum-line.excise-rubl-cur        = bf_tt-allsum-line.excise-rubl-cur      + bf_tt-allsum.excise-rubl-cur
     3327         bf_tt-allsum-line.sum-dsc-base-acc       = bf_tt-allsum-line.sum-dsc-base-acc     + bf_tt-allsum.sum-dsc-base-acc
     3328         bf_tt-allsum-line.sum-dsc-rubl-acc       = bf_tt-allsum-line.sum-dsc-rubl-acc     + bf_tt-allsum.sum-dsc-rubl-acc
     3329         bf_tt-allsum-line.sum-dsc-cli-acc        = bf_tt-allsum-line.sum-dsc-cli-acc      + bf_tt-allsum.sum-dsc-cli-acc
     3330         bf_tt-allsum-line.dsc-base-acc           = bf_tt-allsum-line.dsc-base-acc         + bf_tt-allsum.dsc-base-acc
     3331         bf_tt-allsum-line.dsc-rubl-acc           = bf_tt-allsum-line.dsc-rubl-acc         + bf_tt-allsum.dsc-rubl-acc
     3332         bf_tt-allsum-line.dsc-cli-acc            = bf_tt-allsum-line.dsc-cli-acc          + bf_tt-allsum.dsc-cli-acc
     3333         bf_tt-allsum-line.vat-base-acc           = bf_tt-allsum-line.vat-base-acc         + bf_tt-allsum.vat-base-acc
     3334         bf_tt-allsum-line.vat-rubl-acc           = bf_tt-allsum-line.vat-rubl-acc         + bf_tt-allsum.vat-rubl-acc
     3335         bf_tt-allsum-line.vat-cli-acc            = bf_tt-allsum-line.vat-cli-acc          + bf_tt-allsum.vat-cli-acc
     3336         bf_tt-allsum-line.slt-base-acc           = bf_tt-allsum-line.slt-base-acc         + bf_tt-allsum.slt-base-acc
     3337         bf_tt-allsum-line.slt-rubl-acc           = bf_tt-allsum-line.slt-rubl-acc         + bf_tt-allsum.slt-rubl-acc
     3338         bf_tt-allsum-line.slt-cli-acc            = bf_tt-allsum-line.slt-cli-acc          + bf_tt-allsum.slt-cli-acc
     3339         bf_tt-allsum-line.road-tax-base-acc      = bf_tt-allsum-line.road-tax-base-acc    + bf_tt-allsum.road-tax-base-acc
     3340         bf_tt-allsum-line.road-tax-rubl-acc      = bf_tt-allsum-line.road-tax-rubl-acc    + bf_tt-allsum.road-tax-rubl-acc
     3341         bf_tt-allsum-line.road-tax-cli-acc       = bf_tt-allsum-line.road-tax-cli-acc     + bf_tt-allsum.road-tax-cli-acc
     3342         bf_tt-allsum-line.excise-base-acc        = bf_tt-allsum-line.excise-base-acc      + bf_tt-allsum.excise-base-acc
     3343         bf_tt-allsum-line.excise-rubl-acc        = bf_tt-allsum-line.excise-rubl-acc      + bf_tt-allsum.excise-rubl-acc
     3344         bf_tt-allsum-line.excise-cli-acc         = bf_tt-allsum-line.excise-cli-acc       + bf_tt-allsum.excise-cli-acc
     3345         bf_tt-allsum-line.transport-base-acc     = bf_tt-allsum-line.transport-base-acc   + bf_tt-allsum.transport-base-acc
     3346         bf_tt-allsum-line.transport-rubl-acc     = bf_tt-allsum-line.transport-rubl-acc   + bf_tt-allsum.transport-rubl-acc
     3347         bf_tt-allsum-line.transport-cli-acc      = bf_tt-allsum-line.transport-cli-acc    + bf_tt-allsum.transport-cli-acc
     3348         bf_tt-allsum-line.other-base-acc         = bf_tt-allsum-line.other-base-acc       + bf_tt-allsum.other-base-acc
     3349         bf_tt-allsum-line.other-rubl-acc         = bf_tt-allsum-line.other-rubl-acc       + bf_tt-allsum.other-rubl-acc
     3350         bf_tt-allsum-line.other-cli-acc          = bf_tt-allsum-line.other-cli-acc        + bf_tt-allsum.other-cli-acc
     3351         .
     3352     end.
     3353   end.
     3354   end.
     3355   end procedure.
     3356   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3357   define variable v-waitfram-action01         as character   no-undo .
     3358   define variable v-waitfram-action02         as character   no-undo .
     3359   define variable v-waitfram-action03         as character   no-undo .
     3360   define variable mWaitFramTextBeg            as character   no-undo.
     3361   define variable mWaitFramTextEnd            as character   no-undo.
     3362   define variable mWaitFramView               as logical     no-undo.
     3363   define variable mWaitProcEvent              as logical     no-undo init yes.
     3364   define variable mWaitFramInterval           as integer     no-undo init 1 .
     3365   define variable mWaitFramStop               as logical     no-undo.
     3366   define variable mWaitFramStopUser           as logical     no-undo.
     3367   define variable mWaitFramStopTimeOut        as logical     no-undo.
     3368   define variable mWaitFramStartProc          as datetime-tz no-undo.
     3369   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     3370   define button B-WaitFramStop auto-end-key
     3371        label "Стоп"
     3372        size 10 by 1 tooltip "Остоновить процесс".
     3373   define button B-viewProcInfo
     3374        label "Информация"
     3375        size 15 by 1 tooltip "Информация о процесс".
     3376   define frame waitfram
     3377     v-waitfram-action01 format "x(72)" no-label skip
     3378     v-waitfram-action02 format "x(72)" no-label skip
     3379     v-waitfram-action03 format "x(72)" no-label skip
     3380     B-viewProcInfo
     3381     B-WaitFramStop at row 4 col 30
     3382     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     3383     .
     3384   define new global shared variable mBatchMode as logical no-undo init ?.
     3385   define variable mFramBachModHandle as handle no-undo.
     3386   mFramBachModHandle = frame waitfram:handle.
     3387   define variable mFameOldVis as logical no-undo.
     3388   define variable mVisCUrentVin as logical no-undo.
     3389   if session:batch-mode
     3390   then
     3391      mBatchMode = yes.
     3392   if mBatchMode = ? then do:
     3393     mVisCUrentVin = current-window:visible.
     3394     mFameOldVis = mFramBachModHandle:visible.
     3395     mFramBachModHandle:visible  = yes.
     3396     mBatchMode = mFramBachModHandle:visible ne yes.
     3397     mFramBachModHandle:visible = mFameOldVis.
     3398     current-window:visible = mVisCUrentVin.
     3399   end.
     3400    if  log-manager:logfile-name ne ?
     3401     then DO:
     3402         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     3403         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     3404         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     3405     end.
     3406   on choose of B-WaitFramStop in frame waitfram
     3407   do:
     3408     mWaitFramStop = yes.
     3409     mWaitFramStopUser = yes.
     3410   end.
     3411   function waitfram-check-timeout returns logical():
     3412      define variable vtime as int64 no-undo.
     3413      if mWaitFramStopTimeOut
     3414      then
     3415         return yes.
     3416      vtime = ( now - mWaitFramStartProc ) / 1000 .
     3417      if     mWaitFramTimeOut ne ?
     3418         and mWaitFramTimeOut ne 0
     3419         and mWaitFramTimeOut lt vtime
     3420      then do:
     3421         mWaitFramStopTimeOut = yes.
     3422      end.
     3423      return mWaitFramStopTimeOut.
     3424   end.
     3425   procedure waitfram-hide :
     3426     if not session:batch-mode
     3427     then do
     3428     on error undo, return error return-value
     3429     :
     3430       pause 0 before-hide .
     3431       if not mBatchMode then
     3432         hide frame waitfram .
     3433     if     not mWaitFramView
     3434        and mWaitProcEvent
     3435     then
     3436       process events .
     3437     end.
     3438   end procedure.
     3439   procedure waitfram-show :
     3440     define input  parameter p-message as character no-undo .
     3441     define variable v-left-margin as integer   no-undo .
     3442     if not session:batch-mode
     3443     then do
     3444     on error undo, return error return-value
     3445     :
     3446       if length(p-message) <= 70 then do:
     3447         assign
     3448           v-left-margin = integer((70 - length(p-message)) / 2)
     3449         .
     3450         assign
     3451           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     3452         .
     3453         assign
     3454           v-waitfram-action01 = " "
     3455           v-waitfram-action02 = " "
     3456                                    + fill(" ", v-left-margin)
     3457                                    + p-message
     3458           v-waitfram-action03 = " "
     3459         .
     3460       end.
     3461       else do:
     3462         define variable vRindex1 as integer no-undo.
     3463         define variable vRindex2 as integer no-undo.
     3464         vRindex1 = r-index(p-message," ",70).
     3465         if vRindex1 = 0
     3466         then
     3467            vRindex1 = 70.
     3468         if length(p-message)  <= vRindex1 + 70 then do:
     3469           assign
     3470             v-waitfram-action01 = " "
     3471             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     3472             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     3473           .
     3474         end.
     3475         else do:
     3476           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     3477           if vRindex2 <= vRindex1
     3478           then
     3479              vRindex2 = vRindex1 + 70.
     3480           assign
     3481             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     3482             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     3483             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     3484           .
     3485         end.
     3486       end.
     3487       B-viewProcInfo:visible   in frame waitfram = no.
     3488       B-viewProcInfo:sensitive in frame waitfram = no.
     3489       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     3490       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     3491       if  (   mWaitFramView
     3492          or  mWaitProcEvent)
     3493          and not mBatchMode
     3494       then
     3495          display
     3496             v-waitfram-action01 skip
     3497             v-waitfram-action02 skip
     3498             v-waitfram-action03 skip
     3499          with frame waitfram .
     3500       if     mWaitFramView
     3501          then do:
     3502             if     mWaitFramInterval ne ?
     3503                and not mBatchMode
     3504             then
     3505                wait-for go of frame waitfram pause mWaitFramInterval.
     3506          end.
     3507          else
     3508             if     mWaitProcEvent
     3509                and not mBatchMode
     3510             then
     3511                process events .
     3512     end.
     3513   end procedure.
     3514      procedure waitfram-show-this:
     3515         define input  parameter iInterval as int64 no-undo.
     3516         define variable vtime as int64 no-undo.
     3517         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     3518         mWaitFramInterval = iInterval.
     3519         run waitfram-show (substitute("&1&2 &3&4" ,
     3520                                       mWaitFramTextBeg ,
     3521                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     3522                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     3523                                       mWaitFramTextEnd
     3524                                      )
     3525                           ).
     3526      end.
     3527      procedure WaitFramRunPause:
     3528         define input  parameter iInterval as dec no-undo.
     3529         define variable vStart  as datetime-tz no-undo.
     3530         define variable vend    as datetime-tz no-undo.
     3531         define variable vint as int64 no-undo.
     3532         define variable vOk as logical no-undo.
     3533         vStart = now.
     3534         vend   = vStart.
     3535         publish "WaitFramPause" (iInterval,output vOk).
     3536         vend   =  now.
     3537         vint = vend - vStart.
     3538         vint = iInterval - vint / 1000.
     3539         if     not mWaitFramStop
     3540            and (   vint > 0
     3541                 or (    not vOk
     3542                     and iInterval eq ?
     3543                     )
     3544                 )
     3545         then
     3546            run waitfram-show-this (iInterval).
     3547         vend   =  now.
     3548         vint = vend - vStart.
     3549         vint = iInterval - vint / 1000.
     3550         if     not mWaitFramStop
     3551            and vint > 0
     3552         then do:
     3553            run gbl/pause.p (vint * 1000).
     3554         end.
     3555         if iInterval ne ?
     3556         then
     3557            publish "WaitFramStop".
     3558         waitfram-check-timeout().
     3559      end.
     3560      procedure WaitFramWaitFor:
     3561         define input  parameter iInterval as dec no-undo.
     3562         assign
     3563            mWaitFramStartProc   = now
     3564            mWaitFramStopUser    = no
     3565            mWaitFramStopTimeOut = no
     3566         .
     3567         block-wait:
     3568         do while not mWaitFramStop:
     3569            run WaitFramRunPause (iInterval).
     3570            if  waitfram-check-timeout()
     3571            then do:
     3572               leave block-wait.
     3573            end.
     3574         end.
     3575         run waitfram-hide.
     3576      end.
     3577   procedure waitfram-join :
     3578     define input  parameter p-line-1  as character no-undo .
     3579     define input  parameter p-line-2  as character no-undo .
     3580     define input  parameter p-line-3  as character no-undo .
     3581     define output parameter p-message as character no-undo .
     3582     do
     3583     on error undo, return error return-value
     3584     :
     3585       assign
     3586         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     3587                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     3588                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     3589       .
     3590     end.
     3591   end procedure.
     3592   function waitfram-join-function returns character
     3593     (input p-line-1 as character
     3594     ,input p-line-2 as character
     3595     ,input p-line-3 as character
     3596     ).
     3597     define variable v-message as character no-undo .
     3598     run waitfram-join in this-procedure
     3599       (input  p-line-1
     3600       ,input  p-line-2
     3601       ,input  p-line-3
     3602       ,output v-message
     3603       ) .
     3604     return v-message .
     3605   end function .
     3606   define variable g#report-num as integer no-undo .
     3607   procedure OpenForExcel :
     3608      define variable v-ch#ExcelApplication as com-handle no-undo .
     3609      define variable v-ch#Workbook         as com-handle no-undo .
     3610      define variable v-ch#Worksheet        as com-handle no-undo .
     3611      os-delete value( string( session:temp-directory ) +
     3612                                 "rpt" + string( g#report-num ) + ".txt":U ) .
     3613      os-delete value( string( session:temp-directory ) +
     3614                                 "rpt" + string( g#report-num ) + ".frm":U ) .
     3615      os-delete value( string( session:temp-directory ) +
     3616                                 "rpt" + string( g#report-num ) + ".txl":U ) .
     3617      if Make-Excel
     3618      then do:
     3619         output stream ForExcel to value( string( session:temp-directory +
     3620                                        "rpt" + string( g#report-num ) + ".txt":U ) ) .
     3621         assign
     3622            v-excel-file = string( session:temp-directory + "rpt" + string( g#report-num ) )
     3623            number-list = 1
     3624         .
     3625         if make-excel-com
     3626         then do:
     3627   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3628   if valid-handle(ch#WorkSheet) then
     3629   RELEASE OBJECT ch#WorkSheet no-error.
     3630   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3631   if valid-handle(ch#Workbook) then
     3632   RELEASE OBJECT ch#Workbook no-error.
     3633   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3634   if valid-handle(ch#ExcelApplication) then
     3635   RELEASE OBJECT ch#ExcelApplication no-error.
     3636            create "Excel.Application" ch#excelApplication connect no-error.
     3637            if error-status:error
     3638            then do :
     3639           create "Excel.Application" ch#excelApplication no-error.
     3640       if error-status :error then do:
     3641           message
     3642           "Ошибка при запуске Excel" skip
     3643           error-status :get-message(1) skip
     3644           view-as alert-box error .
     3645           undo, return error .
     3646       end.
     3647            end.
     3648            assign
     3649               num#str#  = 0.
     3650               v-ch#excelApplication  = ch#excelApplication.
     3651               v-ch#excelApplication:Interactive = false.
     3652               v-ch#excelApplication:ScreenUpdating = false.
     3653               v-ch#excelApplication:Visible = false.
     3654               ch#Workbook  = v-ch#excelApplication:Workbooks:add ().
     3655               ch#WorkSheet = v-ch#excelApplication:Sheets:Item (1).
     3656               v-ch#Worksheet = ch#WorkSheet.
     3657               v-ch#Worksheet:Range ("A1"):Font:Bold = true.
     3658               v-ch#Worksheet:Range ("A1"):Font:Size = 14.
     3659               v-ch#Worksheet:Range ("A1"):HorizontalAlignment = -4131.
     3660               v-ch#Worksheet:Range ("A1"):VerticalAlignment   = -4160
     3661            no-error .
     3662            if error-status:error
     3663            then do:
     3664               Make-Excel-com = false .
     3665               Make-Excel = false .
     3666               output Stream  ForExcel close.
     3667               os-delete value( string( session:temp-directory ) +
     3668                              "rpt" + string( g#report-num ) + ".txt":U ) .
     3669               os-delete value( string( session:temp-directory ) +
     3670                              "rpt" + string( g#report-num ) + ".frm":U ) .
     3671               return.
     3672            end.
     3673         end.
     3674      end.
     3675   end.
     3676   procedure CloseForExcel :
     3677      define variable ii as integer no-undo .
     3678      define variable vsheet-num as integer no-undo.
     3679      if Make-Excel
     3680      then  do:
     3681         output Stream  ForExcel close.
     3682         os-delete value( string( session:temp-directory ) +
     3683                                "rpt" + string( g#report-num ) + ".txt":U ) .
     3684         os-delete value( string( session:temp-directory ) +
     3685                                "rpt" + string( g#report-num ) + ".frm":U ) .
     3686         define buffer buf_sheetf for sheetf.
     3687         find last buf_sheetf no-error .
     3688         if available buf_sheetf
     3689         then
     3690            vsheet-num = buf_sheetf.sheet-num.
     3691         if vsheet-num > 1
     3692         then do:
     3693            do ii = 2 to vsheet-num:
     3694               os-delete value( string( session:temp-directory ) +
     3695                                     "rpt" + string( g#report-num ) + ".":U  + string(ii)) .
     3696            end.
     3697         end.
     3698   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3699   if valid-handle(ch#WorkSheet) then
     3700   RELEASE OBJECT ch#WorkSheet no-error.
     3701   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3702   if valid-handle(ch#Workbook) then
     3703   RELEASE OBJECT ch#Workbook no-error.
     3704   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3705   if valid-handle(ch#ExcelApplication) then
     3706   RELEASE OBJECT ch#ExcelApplication no-error.
     3707      end.
     3708   end.
     3709   def temp-table sj-goods no-undo
     3710   field b-code like bar-code.b-code format "9999999999999"
     3711   field artic     like goods.artic
     3712   field prod-type like goods.prod-type
     3713   field prod-code like goods.prod-code
     3714   field name   like goods.gds-name format "x(30)"
     3715   field unit like goods.unit-base
     3716   field qnty              as   decimal
     3717   field obj-price    like price-list.price-sale
     3718   field discnt          as   decimal
     3719   field brutto-sum   as   decimal
     3720   field discnt-sum  as   decimal
     3721   field netto-sum    as   decimal
     3722   field uchet-sum   as decimal
     3723   field uchet-with-vat-sum   as decimal
     3724   field n-u-sum             as   decimal
     3725   field u-pcnt          as decimal
     3726   field is-out        as  logical
     3727   field VAT-pc       like doc-line.VAT-pc
     3728   field SLT-pc       like doc-line.SLT-pc
     3729   field VAT-r-b    as decimal
     3730   field SLT-r-b   as decimal
     3731   field grp-code as integer
     3732   field grp-name as character
     3733   INDEX p1 IS PRIMARY   b-code SLT-pc VAT-pc
     3734   INDEX p2                        is-out DESCENDING
     3735                                           b-code ASCENDING
     3736   INDEX p3 artic prod-type prod-code SLT-pc VAT-pc
     3737   index p4 grp-name
     3738   .
     3739   DEFINE temp-table sj-grp no-undo
     3740   field grp-code AS integer format "9999999999999"
     3741   field grp-name   AS character format "x(30)"
     3742   field serv-name   AS character format "x(30)"
     3743   field qnty              as   decimal
     3744   field brutto-sum   as   decimal
     3745   field discnt-sum  as   decimal
     3746   field netto-sum    as   decimal
     3747   field uchet-sum   as decimal
     3748   field uchet-with-vat-sum   as decimal
     3749   field n-u-sum             as   decimal
     3750   field u-pcnt          as decimal
     3751   field VAT-r-b    as decimal
     3752   field SLT-r-b   as decimal
     3753   INDEX p1 IS PRIMARY   grp-code
     3754   INDEX p3 grp-name
     3755   index p4 serv-name
     3756   .
     3757   define buffer t-3 for sj-grp.
     3758   define variable vss-include-info34 as character format "X(65)" no-undo
     3759   initial "@(#)$Workfile$ $Revision$".
     3760   procedure grplib-get-full-name :
     3761      define input parameter p-node-code  as integer      no-undo.
     3762      define output parameter p-full-name as character    no-undo.
     3763      do
     3764   on error undo, return error
     3765   :
     3766       define variable v-upper-code    as integer           no-undo.
     3767       define buffer buf_gds-grp       for ub.gds-grp.
     3768       define buffer buf_upper_gds-grp for ub.gds-grp.
     3769       find first buf_gds-grp no-lock
     3770            where buf_gds-grp.node-code = p-node-code
     3771       no-error.
     3772       if not available buf_gds-grp
     3773       then do:
     3774           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     3775       end.
     3776       assign
     3777           p-full-name  = ""
     3778           v-upper-code = 1
     3779       .
     3780       do while buf_gds-grp.upper-code <> 0
     3781       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     3782       :
     3783           assign
     3784               p-full-name  = buf_gds-grp.node-name
     3785                            + (if p-full-name <> "" then chr(47) else "")
     3786                            + p-full-name
     3787               v-upper-code = buf_gds-grp.upper-code
     3788           .
     3789           find first buf_gds-grp no-lock
     3790                where buf_gds-grp.node-code = v-upper-code
     3791           no-error.
     3792           if not available buf_gds-grp
     3793           then do:
     3794               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
     3795                                   + string( v-upper-code )
     3796                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     3797           end.
     3798       end.
     3799       assign
     3800       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     3801       .
     3802   end.
     3803   end .
     3804   procedure grplib-get-node-from-full-name :
     3805   define input parameter p-full-name as character no-undo .
     3806   define output parameter p-node-code as integer no-undo .
     3807   define variable v-ii as integer no-undo .
     3808   define variable v-upper-code as integer no-undo .
     3809   define variable v-root-code as integer no-undo .
     3810   define variable v-entry as character no-undo .
     3811   define buffer buf_gds-grp       for ub.gds-grp.
     3812   do
     3813   on error undo, return error
     3814   :
     3815     find first buf_gds-grp no-lock
     3816         where buf_gds-grp.upper-code = 0
     3817     no-error .
     3818     if not available buf_gds-grp
     3819     then do:
     3820         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
     3821     end.
     3822     else do:
     3823       assign
     3824       v-root-code = buf_gds-grp.node-code
     3825       .
     3826     end.
     3827     v-upper-code = v-root-code.
     3828     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     3829       assign
     3830       v-entry = entry(v-ii, p-full-name, chr(47)).
     3831       if v-entry = '' then leave.
     3832       find first buf_gds-grp no-lock where
     3833                 buf_gds-grp.node-name = v-entry
     3834             and buf_gds-grp.upper-code = v-upper-code
     3835             no-error.
     3836       if not available buf_gds-grp then do:
     3837         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     3838       end.
     3839       else do:
     3840         p-node-code = buf_gds-grp.node-code.
     3841         v-upper-code = buf_gds-grp.node-code.
     3842       end.
     3843     end.
     3844   end.
     3845   end .
     3846   procedure t-level :
     3847     define input parameter loc-node-code like ub.gds-grp.node-code no-undo .
     3848     define buffer loc-gds-grp for ub.gds-grp .
     3849     define variable loc-grp-name as character no-undo .
     3850     for each loc-gds-grp no-lock where
     3851              loc-gds-grp.upper-code = loc-node-code
     3852     :
     3853       if loc-gds-grp.is-term = no
     3854       then do:
     3855         run t-level in this-procedure ( input loc-gds-grp.node-code ) no-error .
     3856       end.
     3857       else do:
     3858         run grplib-get-full-name in this-procedure
     3859           (  input loc-gds-grp.node-code
     3860           , output loc-grp-name
     3861           ) .
     3862         create t-3 .
     3863         assign t-3.grp-code  = loc-gds-grp.node-code
     3864                t-3.serv-name = loc-grp-name
     3865                t-3.grp-name  = loc-gds-grp.node-name
     3866         .
     3867       end.
     3868     end.
     3869   end procedure.
     3870   procedure n-level :
     3871     define input parameter loc-node-code like ub.gds-grp.node-code no-undo .
     3872     define input parameter locvar-lavel  as   integer              no-undo .
     3873     define buffer loc-gds-grp for ub.gds-grp .
     3874     define variable loc-grp-name as character no-undo .
     3875     for each loc-gds-grp no-lock where
     3876              loc-gds-grp.upper-code = loc-node-code
     3877     :
     3878       run grplib-get-full-name in this-procedure
     3879         (  input loc-gds-grp.node-code
     3880         , output loc-grp-name
     3881         ) .
     3882       if loc-gds-grp.lvl-num  > locvar-lavel or
     3883        ( loc-gds-grp.lvl-num <  locvar-lavel and
     3884          loc-gds-grp.is-term <> yes )
     3885       then do:
     3886         run n-level in this-procedure
     3887           ( input loc-gds-grp.node-code
     3888           , input locvar-lavel
     3889           ) no-error .
     3890       end.
     3891       else do:
     3892         create t-3 .
     3893         assign t-3.grp-code = loc-gds-grp.node-code
     3894                t-3.serv-name = loc-grp-name
     3895                t-3.grp-name = loc-gds-grp.node-name
     3896         .
     3897       end.
     3898     end.
     3899   end procedure.
     3900   DEFINE TEMP-TABLE d-slt-vat no-undo
     3901   FIELD SLT-pc like doc-line.SLT-pc
     3902   FIELD SLT-r-b like inkas.netto
     3903   FIELD SLT-r-b-brutto like inkas.netto
     3904   FIELD VAT-pc like doc-line.VAT-pc
     3905   FIELD VAT-r-b like inkas.netto
     3906   FIELD uchet-sum as decimal
     3907   FIELD uchet-with-vat-sum as decimal
     3908   FIELD n-u-sum             as   decimal
     3909   INDEX p1 IS PRIMARY SLT-pc VAT-pc ASCENDING .
     3910   define variable cas-shft as logical no-undo.
     3911   define variable cas-num as integer no-undo.
     3912   define variable Line                as      char    no-undo.
     3913   define variable date_string     as      char    no-undo.
     3914   define variable     choice               as      logical     no-undo.
     3915   define variable     DatePrinted      as      logical     no-undo.
     3916   define variable     FrameType      as      char        no-undo.
     3917   define variable     method            as    char no-undo.
     3918   define variable     good-choice as logical init no.
     3919   define variable negparts as logical NO-UNDO.
     3920   define buffer t-doc for trn-doc.
     3921   define variable jj as integer no-undo.
     3922   define variable jj-tot as integer no-undo init 0.
     3923   define variable for-netto-without-slt as decimal no-undo.
     3924   define variable vat-pc-val-qnty as integer no-undo.
     3925   define variable v-choice-gds as char no-undo.
     3926   define variable gds-str as character no-undo init "".
     3927   DEFINE VARIABLE var-level AS INTEGER FORMAT ">>9":U INITIAL 1
     3928        VIEW-AS FILL-IN NATIVE
     3929        SIZE 5 BY .77
     3930        FGCOLOR 0  NO-UNDO.
     3931   DEFINE VARIABLE Classify AS CHARACTER
     3932        VIEW-AS RADIO-SET VERTICAL
     3933        RADIO-BUTTONS
     3934             "Нет подитогов по группам", "no-grp-totals":U,
     3935   "Группы 1-го уровня", "no-classify":U,
     3936   "Группы с n-уровнeм вложенности", "n-level":U,
     3937   "Терминальные группы", "t-level":U
     3938        SIZE 33 BY 3.43
     3939        FGCOLOR 0  NO-UNDO.
     3940   DEFINE VARIABLE RS-By AS INTEGER
     3941        VIEW-AS RADIO-SET VERTICAL
     3942        RADIO-BUTTONS
     3943             "Отчеты о продаже (касса)", 1,
     3944   "Расх. и возвр. накладные по реализации", 2,
     3945   "Отчеты о продаже и накладные", 3,
     3946   "Отчет по всем расходным документам", 4
     3947        SIZE 41.5 BY 2.77 NO-UNDO.
     3948   DEFINE VARIABLE RS-Method AS CHARACTER
     3949        VIEW-AS RADIO-SET VERTICAL
     3950        RADIO-BUTTONS
     3951             "Cо шкалами ", "B-CODE":U,
     3952   "Без шкал  ", "ARTIC":U,
     3953   "Без товаров", "TOTALS":U
     3954        SIZE 22.6 BY 3.13 NO-UNDO.
