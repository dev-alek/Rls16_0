     6088                    string(  ( ACCUM TOTAL by d-slt-vat.vat-pc d-slt-vat.slt-r-b-brutto ) , "->>>,>>>,>>9.99" )  +  ":"   )
     6089          AT 1 format "X(35)"
     6090          string (
     6091                  string(  ( ACCUM TOTAL  by d-slt-vat.vat-pc d-slt-vat.uchet-with-vat-sum ) , "->>>,>>>,>>9.99" )   +  ":"
     6092                 )
     6093          AT 38 format "X(16)"
     6094          string (
     6095                  string(  ( ACCUM TOTAL  by d-slt-vat.vat-pc d-slt-vat.uchet-sum ) , "->>>,>>>,>>9.99" )   +  ":"
     6096                 )
     6097          AT 56 format "X(16)"
