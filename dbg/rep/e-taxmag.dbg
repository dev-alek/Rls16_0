     5294   PROCEDURE My-report :
     5295   define variable glog as logical no-undo .
     5296   run My-var in this-procedure .
     5297   assign
     5298   date_string = cur-time-print()
     5299   Line = fill( "-", 158 )
     5300   jj = 0
     5301   jj-tot = 0
     5302   .
     5303   run waitfram-show in this-procedure ( 'Подождите ...' ) .
     5304   run prepare-grp in this-procedure ( input Classify
     5305                                      ,input tog-level
     5306                                      ,input var-level).
     5307   RUN PrintProc in this-procedure .
     5308   END PROCEDURE.
     5309   PROCEDURE My-var :
     5310   Assign
     5311   frame F-Main classify
     5312   frame F-Main RS-Method
     5313   frame F-Main T-neg
     5314   frame F-Main T-partsneg
     5315   frame F-Main RS-by
     5316   method = RS-method
     5317   negparts = t-partsneg
     5318   .
     5319   if classify = "n-level":u then do:
     5320     assign
     5321     frame F-Main tog-level
     5322     frame F-Main var-level
     5323     .
     5324   end.
     5325   Assign
     5326   STR-obj-type = ''
     5327   STR-obj-code = ''
     5328   STR-obj-name = ''
     5329   STR-obj      = ''.
     5330   For each obj-list no-lock:
     5331    Assign
     5332    STR-obj-type = STR-obj-type + obj-list.obj-type + ','
     5333    STR-obj-code = STR-obj-code + String(obj-list.obj-code) + ','
     5334    STR-obj-name = STR-obj-name + obj-list.obj-name + ','
     5335    STR-obj = STR-obj +  obj-list.obj-type + '#' + string(obj-list.obj-code)  + ',' .
     5336   End.
     5337   Reportname = "РАСЧЕТ НАЛОГОВ (РЕАЛИЗАЦИЯ В МАГАЗИНЕ)".
     5338   ReportHeader =  "Источник формирования: " +
     5339                   radio-label(string(RS-BY), RS-BY:radio-buttons) + chr(10) +
     5340                   "Детализация: " +
     5341                              radio-label(string(RS-method), RS-method:radio-buttons) + chr(10) +
     5342                   (if T-neg then t-neg:label else "") + chr(10) +
     5343                   (if T-partsneg then t-partsneg:label else "")                .
     5344   END PROCEDURE.
     5345   PROCEDURE prepare-grp :
     5346   DEFINE INPUT PARAMETER p-classify AS CHARACTER NO-UNDO.
     5347   DEFINE INPUT PARAMETER p-tog-level AS logical NO-UNDO.
     5348   DEFINE INPUT PARAMETER p-level AS integer NO-UNDO.
     5349   define variable loc-classify  as   integer              no-undo .
     5350   define variable curr-grp-code like ub.gds-grp.node-code no-undo .
     5351   define variable for-grp-name  like ub.gds-grp.node-name no-undo .
     5352   define buffer buf_gds-grp for ub.gds-grp.
     5353   case p-classify :
     5354     when "no-grp-totals":U
     5355     then do:
     5356       assign
     5357         loc-classify = - 1
     5358       .
     5359     end.
     5360     when "no-classify":U
     5361     then do:
     5362       assign
     5363         loc-classify = 1
     5364       .
     5365     end.
     5366     when "n-level":U
     5367     then do:
     5368       assign
     5369         loc-classify = p-level
     5370       .
     5371     end.
     5372     when "t-level":U
     5373     then do:
     5374       assign
     5375         loc-classify = 0
     5376       .
     5377     end.
     5378   end case.
     5379   for each sj-grp
     5380   :
     5381     delete sj-grp .
     5382   end.
     5383   if X-selectgood = 2
     5384   then do:
     5385     for each tmp#grp no-lock
     5386     :
     5387       run grplib-get-full-name in this-procedure
     5388         (  input tmp#grp.node-code
     5389         , output for-grp-name
     5390         ) .
     5391       case loc-Classify :
     5392         when 1
     5393         then do:
     5394           create sj-grp .
     5395           assign sj-grp.grp-code  = tmp#grp.node-code
     5396                  sj-grp.serv-name = for-grp-name
     5397                  sj-grp.grp-name  = tmp#grp.grp-name
     5398           .
     5399         end.
     5400         when  0
     5401         then do:
     5402           if tmp#grp.is-term = yes
     5403           then do:
     5404             create sj-grp .
     5405             assign sj-grp.grp-code  = tmp#grp.node-code
     5406                    sj-grp.serv-name = for-grp-name
     5407                    sj-grp.grp-name  = tmp#grp.grp-name
     5408             .
     5409           end.
     5410           else do:
     5411             run t-level in this-procedure ( input tmp#grp.node-code ) no-error .
     5412           end.
     5413         end.
     5414          when - 1
     5415         then do:
     5416                  create sj-grp .
     5417           assign sj-grp.grp-code  = tmp#grp.node-code
     5418                  sj-grp.serv-name = for-grp-name
     5419                  sj-grp.grp-name  = tmp#grp.grp-name
     5420           .
     5421         end.
     5422         when p-level
     5423         then do:
     5424           if tmp#grp.lvl-num >= p-level or
     5425            ( tmp#grp.lvl-num <  p-level and
     5426              tmp#grp.is-term  = yes )
     5427           then do:
     5428             create sj-grp .
     5429             assign sj-grp.grp-code  = tmp#grp.node-code
     5430                    sj-grp.serv-name = for-grp-name
     5431                    sj-grp.grp-name  = tmp#grp.grp-name
     5432             .
     5433           end.
     5434           else
     5435           run n-level in this-procedure(tmp#grp.node-code, p-level) no-error.
     5436         end.
     5437       end case.
     5438     end.
     5439   end.
     5440   else do:
     5441     for each buf_gds-grp no-lock
     5442     :
     5443       assign
     5444         curr-grp-code = buf_gds-grp.node-code
     5445       .
     5446       run grplib-get-full-name in this-procedure
     5447         (  input buf_gds-grp.node-code
     5448         , output for-grp-name
     5449         ) .
     5450       case loc-Classify :
     5451         when 1
     5452         then do:
     5453           if buf_gds-grp.lvl-num <> 1
     5454           then do:
     5455             next .
     5456           end.
     5457         end.
     5458         when 0
     5459         then do:
     5460           IF not buf_gds-grp.is-term
     5461           then do:
     5462             next .
     5463           end.
     5464         end.
     5465         when p-level
     5466         then do:
     5467           if buf_gds-grp.lvl-num > p-level or
     5468            ( buf_gds-grp.lvl-num < p-level and
     5469              buf_gds-grp.is-term = no )
     5470           then do:
     5471             next .
     5472           end.
     5473         end.
     5474       end case.
     5475       create sj-grp .
     5476       assign sj-grp.grp-code  = curr-grp-code
     5477              sj-grp.serv-name = for-grp-name
     5478              sj-grp.grp-name  = buf_gds-grp.node-name
     5479       .
     5480       release sj-grp.
     5481     end.
     5482   end.
     5483   END PROCEDURE.
     5484   PROCEDURE PrintProc :
     5485   define variable i as integer no-undo .
     5486   define variable sym1 as char init ":"   no-undo.
     5487   define variable sym10 as char init ":"   no-undo.
     5488   define variable Line                as      char    no-undo.
     5489   define variable cash_string     as      char    no-undo.
     5490   define variable sale_string     as      char    no-undo.
     5491   define variable date_string     as      char    no-undo.
     5492   define variable namebuf1     as      char    no-undo.
     5493   define variable namebuf2     as      char    no-undo.
     5494   define variable prodbuf1     as      char    no-undo.
     5495   define variable prodbuf2     as      char    no-undo.
     5496   define variable v-header-base-curr as character no-undo .
     5497   define variable v-curr-r-b as character no-undo .
     5498   define variable v-ii as integer no-undo .
     5499   define variable j_row as integer no-undo .
     5500   define variable XLS-page-num    as integer   no-undo initial 0 .
     5501   define variable sheet-name as character no-undo .
     5502   define variable vss-include-info42 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     5503   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     5504     (output v-curr-r-b
     5505     )  .
     5506   if v-curr-r-b = 'base':U then do:
     5507     assign
     5508     v-header-base-curr = string( "( Вал. продаж - Баз.вал. )" )
     5509     .
     5510   end.
     5511   else do:
     5512     assign
     5513     v-header-base-curr = string( "( Вал. продаж - РУБЛИ )" )
     5514     .
     5515   end.
     5516   assign
     5517     XLS-page-num = XLS-page-num + 1
     5518   .
     5519   if X-selectGood =  4 or
     5520            X-selectGood = 6     or
     5521         X-selectGood = 5 then
     5522       do:
     5523           v-choice-gds = "По списку товаров: ".
     5524           for each gds-list no-lock:
     5525               if length(gds-str) + length(gds-list.gds-name) <= 115  then do:
     5526               gds-str = gds-str + gds-list.gds-name + ", ".
     5527               end.
     5528               else
     5529               do:
     5530                    gds-str = gds-str + "..." .
     5531                leave.
     5532                end.
     5533           end.
     5534           gds-str = right-trim( gds-str, " " ).
     5535           gds-str = right-trim( gds-str, "," ).
     5536               v-choice-gds = v-choice-gds + gds-str.
     5537       end.
     5538      if error-status :error then next.
     5539       if X-selectGood = 1 then do:
     5540           v-choice-gds = "Выбор товара: По всем товарам".
     5541           end.
     5542   if  X-selectGood = 2 then do:
     5543           v-choice-gds = str2.
     5544       end.
     5545   for each SheetF where
     5546             SheetF.Sheet-Num > XLS-page-num
     5547   :
     5548     delete SheetF .
     5549   end.
     5550   find first sheetf.
     5551   assign
     5552   sheet-name = "Товары"
     5553   sheetf.sheet-num = 1
     5554   sheetf.Excel-Column-Lable =  "№,Код,Артикул,Наименование," +
     5555                                (if method = "artic":u
     5556                                 then "Производитель,"
     5557                                 else "") +
     5558                                 "Ед.изм.,Количество," +
     5559                                 "Сумма учетных цен c НДС (вал.продаж),Сумма учетных цен без НДС (вал.продаж),Сумма продажная (вал. продаж)," +
     5560                                 "Сумма торг. нацен. (вал. продаж),Торг.нацен. %," +
     5561                                 "НДС%,Сумма НДС (вал. продаж)"
     5562   sheetf.sizes = "6,9,16," + (if method = "artic":u
     5563                                  then "25,15,"
     5564                                  else "40,") +
     5565                  "3,12,"  +
     5566                  "13,13,13," +
     5567                  "13,8,2,13"
     5568   sheetf.colformat = "1=0;2=0;3=@;"  + (if method = "artic":u
     5569                                  then ("4=@;5=@;" +
     5570                                       "6=@;7=0.000;"  +
     5571                                       "8=0.00;9=0.00;10=0.00;" +
     5572                                       "11=0.00;12=0.00;13=0;14=0.00")
     5573                                  else ("4=@;" +
     5574                                       "5=@;6=0.000;"  +
     5575                                       "7=0.00;8=0.00;9=0.00;" +
     5576                                       "10=0.00;11=0.00;12=0;13=0.00" )
     5577                                   )
     5578                 + chr(4) + chr(4) + sheet-name
     5579   Make-Excel = yes
     5580   reportname = "РАСЧЕТ НАЛОГОВ (РЕАЛИЗАЦИЯ В МАГАЗИНЕ) "
     5581     str4 = v-choice-gds
     5582     str2 = v-header-base-curr
     5583   Sheetf.Bas-File = "exe/Adjustw.bas".
     5584                     .
     5585   DEFINE FRAME SJ-Base
     5586   sym1 column-label ":!:"                                                     format "X(1)" space(0)
     5587   jj-tot column-label "  N  "                                                 format ">>>>>9" space(0)
     5588   sj-goods.b-code column-label "Код ! "                                       format ">>>>>>>>>9"
     5589   sj-goods.artic column-label "Артикул   ! "                                  format "x(16)"
     5590   sj-goods.name column-label "Наименование  ! "                               format "x(25)"
     5591   clients.obj-name column-label "(Производитель)"                             format "x(15)"
     5592   sj-goods.unit column-label "Ед.!изм"                                        format "X(3)"
     5593   sj-goods.qnty column-label "Количество ! "                                  format "->>>>>9.<<<"
     5594   sj-goods.uchet-with-vat-sum column-label "Cумма! учет. c  НДС!(вал. продаж)"         format "->>>>>>>>9.99" space(0)
     5595   sj-goods.uchet-sum column-label "Cумма! учет.без НДС!(вал. продаж)"         format "->>>>>>>>9.99" space(0)
     5596   sj-goods.netto-sum column-label  "Сумма !продажная!(вал. продаж)"           format "->>>>>>>>9.99" space(0)
     5597   sj-goods.n-u-sum column-label        "Сумма !торг. нацен.!(вал. продаж)"    format "->>>>>>>>9.99" space(0)
     5598   sj-goods.u-pcnt column-label  "Торг.!нацен. %"                              format "->>9.99%" space(0)
     5599   sj-goods.VAT-pc column-label " НДС%"                                        format ">9.9" space(0)
     5600   sj-goods.VAT-r-b column-label  "Сумма НДС!(вал. продаж)"                    format "->>>>>>>>9.99" space(0)
     5601   sym10 column-label ":!:" format "X(1)"
     5602   HEADER  date_string AT 5 format "X(35)"
     5603   v-header-base-curr  format "X(25)"
     5604   string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER ( PrnLibStream)
     5605     AT 125 FORMAT ">>>>9" SKIP
     5606   Line format "X(188)" AT 1
     5607   with width 232  down stream-io use-text.
     5608   Line = fill("-", 158).
     5609   run waitfram-show in this-procedure ( "Подождите ..." ).
     5610   run Main_Cycle.
     5611   if classify <> "no-grp-totals" then do:
     5612     for each sj-grp:
     5613       for each sj-goods where
     5614               sj-goods.grp-name begins sj-grp.serv-name:
     5615         assign
     5616         sj-grp.qnty       = sj-grp.qnty        + sj-goods.qnty
     5617         sj-grp.brutto-sum = sj-grp.brutto-sum  + sj-goods.brutto-sum
     5618         sj-grp.discnt-sum = sj-grp.discnt-sum  + sj-goods.discnt-sum
     5619         sj-grp.netto-sum  = sj-grp.netto-sum   + sj-goods.brutto-sum - sj-goods.discnt-sum
     5620         sj-grp.uchet-sum  = sj-grp.uchet-sum   + sj-goods.uchet-sum
     5621         sj-grp.uchet-with-vat-sum  = sj-grp.uchet-with-vat-sum + sj-goods.uchet-with-vat-sum
     5622         sj-grp.n-u-sum    = sj-grp.n-u-sum     + (sj-goods.brutto-sum - sj-goods.discnt-sum - sj-goods.SLT-r-b) / (1 + sj-goods.VAT-pc / 100) - sj-goods.uchet-sum
     5623         sj-grp.vat-r-b    = sj-grp.vat-r-b     + sj-goods.vat-r-b
     5624         sj-grp.slt-r-b    = sj-grp.slt-r-b     + sj-goods.slt-r-b
     5625         sj-grp.u-pcnt =  (if sj-grp.uchet-sum  = 0
     5626                           then 0
     5627                           else ( sj-grp.n-u-sum / sj-grp.uchet-sum ) * 100
     5628                           )
     5629         .
     5630       end.
     5631     end.
     5632   end.
     5633   date_string = cur-time-print() .
     5634   run waitfram-hide in this-procedure .
     5635   run prn-lib-open-stream  in this-procedure (
     5636                                                input my-handle
     5637                                               ,input 43
     5638                                               ,input yes
     5639                                               ,input no
     5640                                               ).
     5641   run get-report-num in my-handle ( output g#report-num).
     5642   run rep/extitle.p (1).
     5643   assign
     5644   Sheetf.Bas-Params = sheet-name
     5645   .
     5646   PUT STREAM PrnLibStream unformatted
     5647   SPACE(25)  "РАСЧЕТ НАЛОГОВ (РЕАЛИЗАЦИЯ В МАГАЗИНЕ) " + str1 + " ПО ОБЪЕКТАМ"  format "x(90)"  SKIP(0)
     5648   v-choice-gds  skip
     5649   ReportHeader skip(0)
     5650   SPACE(25) (if negparts then "(только порожденные партии)" else "") FORMAT "X(42)" SKIP(0)
     5651      .
     5652   FOR EACH obj-list :
     5653       FIND clients WHERE clients.obj-type = obj-list.obj-type AND
     5654                                     clients.obj-code = obj-list.obj-code NO-LOCK .
     5655       PUT  STREAM PrnLibStream SPACE(21) clients.obj-name format "X(100)" SKIP.
     5656   END.
     5657   PUT STREAM PrnLibStream " " SKIP(1) .
     5658   FORM HEADER
     5659   Line format "X(158)" AT 1 SKIP
     5660   "Продолжение - на следующей странице" AT 30 SKIP
     5661   with FRAME BottomFrame width 232  PAGE-BOTTOM NO-LABELS NO-BOX .
     5662   VIEW STREAM PrnLibStream FRAME BottomFrame .
     5663   FORM with FRAME SJ-Base .
     5664   FOR EACH sj-goods use-index p2 BREAK BY sj-goods.is-out DESCENDING :
     5665     assign
     5666     sj-goods.netto-sum = sj-goods.brutto-sum - sj-goods.discnt-sum
     5667     sj-goods.n-u-sum = (sj-goods.netto-sum - sj-goods.SLT-r-b) / (1 + sj-goods.VAT-pc / 100) - sj-goods.uchet-sum
     5668     sj-goods.u-pcnt =  ( sj-goods.n-u-sum / sj-goods.uchet-sum ) * 100.
     5669     if t-neg and abs(sj-goods.uchet-sum) >= abs((sj-goods.netto-sum - sj-goods.SLT-r-b) / (1 + sj-goods.VAT-pc / 100)) then
     5670     assign
     5671     sj-goods.n-u-sum = 0
     5672     sj-goods.u-pcnt = 0
     5673      .
     5674     FIND FIRST d-slt-vat WHERE d-slt-vat.SLT-pc = sj-goods.SLT-pc AND
     5675                                 d-slt-vat.VAT-pc = sj-goods.VAT-pc NO-LOCK NO-ERROR.
     5676     IF NOT AVAILABLE d-slt-vat then do:
     5677           create d-slt-vat.
     5678           assign d-slt-vat.SLT-pc = sj-goods.SLT-pc
     5679                       d-slt-vat.VAT-pc = sj-goods.VAT-pc.
     5680     end.
     5681     assign
     5682     d-slt-vat.SLT-r-b-brutto =  d-slt-vat.SLT-r-b-brutto +  sj-goods.netto-sum
     5683     d-slt-vat.SLT-r-b = d-slt-vat.SLT-r-b + sj-goods.SLT-r-b
     5684     d-slt-vat.VAT-r-b = d-slt-vat.VAT-r-b + sj-goods.VAT-r-b
     5685     d-slt-vat.uchet-sum = d-slt-vat.uchet-sum + sj-goods.uchet-sum
     5686     d-slt-vat.uchet-with-vat-sum = d-slt-vat.uchet-with-vat-sum + sj-goods.uchet-with-vat-sum
     5687     d-slt-vat.n-u-sum = d-slt-vat.n-u-sum + sj-goods.n-u-sum
     5688     .
     5689     ACCUMULATE sj-goods.b-code (SUB-COUNT BY sj-goods.is-out).
     5690     IF method = "artic":u THEN DO:
     5691         FIND clients WHERE clients.obj-type = sj-goods.prod-type AND
     5692                                             clients.obj-code = sj-goods.prod-code NO-LOCK .
     5693             prodbuf1 = breakstr(clients.obj-name, 25, prodbuf1, prodbuf2).
     5694     END.
     5695     namebuf1 = breakstr(sj-goods.name, 18, namebuf1, namebuf2).
     5696     IF method = "b-code":U THEN do:
     5697       DISPLAY STREAM PrnLibStream
     5698       sym1
     5699       ACCUM SUB-COUNT BY sj-goods.is-out sj-goods.b-code @ jj-tot
     5700       sj-goods.b-code
     5701       sj-goods.artic
     5702       namebuf1 @ sj-goods.name
     5703       namebuf2   @ clients.obj-name
     5704       sj-goods.qnty
     5705       sj-goods.unit
     5706       sj-goods.uchet-with-vat-sum
     5707       sj-goods.uchet-sum
     5708       sj-goods.netto-sum
     5709       sj-goods.n-u-sum
     5710       sj-goods.u-pcnt
     5711       sj-goods.VAT-pc
     5712       sj-goods.VAT-r-b
     5713       sym10
     5714       with FRAME SJ-Base .
     5715       if Make-Excel then  put   stream ForExcel unformatted
     5716       ACCUM SUB-COUNT BY sj-goods.is-out sj-goods.b-code CHR(9)
     5717       sj-goods.b-code CHR(9)
     5718       sj-goods.artic  CHR(9)
     5719       sj-goods.name CHR(9)
     5720       sj-goods.unit CHR(9)
     5721       sj-goods.qnty CHR(9)
     5722       sj-goods.uchet-with-vat-sum CHR(9)
     5723       sj-goods.uchet-sum CHR(9)
     5724       sj-goods.netto-sum CHR(9)
     5725       sj-goods.n-u-sum CHR(9)
     5726       sj-goods.u-pcnt CHR(9)
     5727       sj-goods.VAT-pc CHR(9)
     5728       sj-goods.VAT-r-b
     5729       skip.
     5730       run st_excel in this-procedure ( input-output j_row
     5731                                       ,input-output XLS-page-num
     5732                                         ).
     5733     end.
     5734     ELSE do:
     5735       IF method = "artic":U then do:
     5736           DISPLAY STREAM PrnLibStream
     5737           sym1
     5738           ACCUM SUB-COUNT BY sj-goods.is-out sj-goods.b-code @ jj-tot
     5739           sj-goods.b-code
     5740           sj-goods.artic
     5741           namebuf1 @ sj-goods.name
     5742           prodbuf1   @ clients.obj-name
     5743           sj-goods.qnty
     5744           sj-goods.unit
     5745           sj-goods.uchet-with-vat-sum
     5746           sj-goods.uchet-sum
     5747           sj-goods.netto-sum
     5748           sj-goods.n-u-sum
     5749           sj-goods.u-pcnt
     5750           sj-goods.VAT-pc
     5751           sj-goods.VAT-r-b
     5752           sym10
     5753           with FRAME SJ-Base .
     5754           if Make-Excel then  put   stream ForExcel unformatted
     5755           ACCUM SUB-COUNT BY sj-goods.is-out sj-goods.b-code CHR(9)
     5756           sj-goods.b-code CHR(9)
     5757           sj-goods.artic  CHR(9)
     5758           sj-goods.name CHR(9)
     5759           clients.obj-name CHR(9)
     5760           sj-goods.unit CHR(9)
     5761           sj-goods.qnty CHR(9)
     5762           sj-goods.uchet-with-vat-sum CHR(9)
     5763           sj-goods.uchet-sum CHR(9)
     5764           sj-goods.netto-sum CHR(9)
     5765           sj-goods.n-u-sum CHR(9)
     5766           sj-goods.u-pcnt CHR(9)
     5767           sj-goods.VAT-pc CHR(9)
     5768           sj-goods.VAT-r-b
     5769           skip.
     5770           run st_excel in this-procedure ( input-output j_row
     5771                                           ,input-output XLS-page-num
     5772                                             ).
     5773       end.
     5774     end.
     5775     IF method <> "TOTALS":U THEN DO:
     5776       DOWN STREAM PrnLibStream 1 with FRAME SJ-Base .
     5777       if method = "artic":U AND ( namebuf2 <> "" ) OR ( prodbuf2 <> "" ) then do:
     5778         DISPLAY STREAM PrnLibStream
     5779         sym1
     5780         namebuf2 @ sj-goods.name
     5781         prodbuf2 @ clients.obj-name
     5782         sym10
     5783         with FRAME SJ-Base .
     5784         DOWN STREAM PrnLibStream 1 with FRAME SJ-Base .
     5785       end.
     5786     END.
     5787     ACCUMULATE
     5788     sj-goods.qnty (TOTAL)
     5789     sj-goods.uchet-sum (TOTAL)
     5790     sj-goods.uchet-sum (SUB-TOTAL BY sj-goods.is-out)
     5791     sj-goods.uchet-with-vat-sum (SUB-TOTAL BY sj-goods.is-out)
     5792     sj-goods.uchet-with-vat-sum (TOTAL)
     5793     sj-goods.SLT-r-b (TOTAL)
     5794     sj-goods.SLT-r-b (SUB-TOTAL BY sj-goods.is-out)
     5795     sj-goods.n-u-sum (TOTAL)
     5796     sj-goods.n-u-sum (SUB-TOTAL BY sj-goods.is-out)
     5797     sj-goods.VAT-r-b (TOTAL)
     5798     sj-goods.VAT-r-b (SUB-TOTAL BY sj-goods.is-out)
     5799     sj-goods.netto-sum (TOTAL)
     5800     sj-goods.qnty ( SUB-TOTAL BY sj-goods.is-out )
     5801     sj-goods.netto-sum ( SUB-TOTAL BY sj-goods.is-out )
     5802     .
     5803     if last-of( sj-goods.is-out ) then do:
     5804       UNDERLINE STREAM PrnLibStream
     5805       jj-tot
     5806       sj-goods.b-code
     5807       sj-goods.artic
     5808       sj-goods.name
     5809       clients.obj-name
     5810       sj-goods.qnty
     5811       sj-goods.unit
     5812       sj-goods.uchet-with-vat-sum
     5813       sj-goods.uchet-sum
     5814       sj-goods.netto-sum
     5815       sj-goods.n-u-sum
     5816       sj-goods.u-pcnt
     5817       sj-goods.VAT-pc
     5818       sj-goods.VAT-r-b
     5819       with FRAME SJ-Base .
     5820       DISPLAY STREAM PrnLibStream
     5821       sym1
     5822       IF method = "TOTALS":U
     5823       THEN ""
     5824       ELSE
     5825       string(ACCUM SUB-COUNT BY sj-goods.is-out sj-goods.b-code , ">>>>9") @ sj-goods.b-code
     5826       IF method = "TOTALS":U
     5827       THEN ""
     5828       ELSE " наименований"  @ sj-goods.artic
     5829       string( "Итого " + ( if sj-goods.is-out then "продажи" else "возвраты" ) )
     5830               @ sj-goods.name
     5831       ACCUM SUB-TOTAL BY sj-goods.is-out sj-goods.qnty @ sj-goods.qnty
     5832       ACCUM SUB-TOTAL BY sj-goods.is-out sj-goods.netto-sum @ sj-goods.netto-sum
     5833       ACCUM SUB-TOTAL BY sj-goods.is-out sj-goods.uchet-with-vat-sum @ sj-goods.uchet-with-vat-sum
     5834       ACCUM SUB-TOTAL BY sj-goods.is-out sj-goods.uchet-sum @ sj-goods.uchet-sum
     5835       ACCUM SUB-TOTAL BY sj-goods.is-out sj-goods.n-u-sum @ sj-goods.n-u-sum
     5836       ACCUM SUB-TOTAL BY sj-goods.is-out sj-goods.VAT-r-b @ sj-goods.VAT-r-b
     5837       sym10
     5838       with FRAME SJ-Base .
     5839       jj-tot = jj-tot  + ACCUM SUB-COUNT BY sj-goods.is-out sj-goods.b-code.
     5840       if NOT last( sj-goods.is-out ) then
     5841       UNDERLINE STREAM PrnLibStream
     5842       jj-tot
     5843       sj-goods.b-code
     5844       sj-goods.artic
     5845       sj-goods.name
     5846       clients.obj-name
     5847       sj-goods.uchet-with-vat-sum
     5848       sj-goods.uchet-sum
     5849       sj-goods.netto-sum
     5850       sj-goods.n-u-sum
     5851       sj-goods.u-pcnt
     5852       sj-goods.VAT-pc
     5853       sj-goods.VAT-r-b
     5854       with FRAME SJ-Base .
     5855       if Make-Excel then  put   stream ForExcel unformatted
     5856       CHR(9)
     5857       (IF method = "TOTALS":U
     5858       THEN ""
     5859       ELSE string(ACCUM SUB-COUNT BY sj-goods.is-out sj-goods.b-code, ">>>>9")) CHR(9)
     5860       (IF method = "TOTALS":U
     5861       THEN ""
     5862       ELSE " наименований" ) CHR(9)
     5863       string( "Итого " + ( if sj-goods.is-out then "продажи" else "возвраты" ) ) CHR(9)
     5864       (if method = "artic" then CHR(9) else '')
     5865       CHR(9)
     5866       ACCUM SUB-TOTAL BY sj-goods.is-out sj-goods.qnty CHR(9)
     5867       ACCUM SUB-TOTAL BY sj-goods.is-out sj-goods.uchet-with-vat-sum  CHR(9)
     5868       ACCUM SUB-TOTAL BY sj-goods.is-out sj-goods.uchet-sum  CHR(9)
     5869       ACCUM SUB-TOTAL BY sj-goods.is-out sj-goods.netto-sum  CHR(9)
     5870       ACCUM SUB-TOTAL BY sj-goods.is-out sj-goods.n-u-sum CHR(9)
     5871       CHR(9)
     5872       CHR(9)
     5873       ACCUM SUB-TOTAL BY sj-goods.is-out sj-goods.VAT-r-b
     5874       skip.
     5875       run st_excel in this-procedure ( input-output j_row
     5876                                       ,input-output XLS-page-num
     5877                                         ).
     5878     end.
     5879   END .
     5880   for each d-slt-vat break by d-slt-vat.vat-pc:
     5881           if first-of(d-slt-vat.vat-pc) then
     5882           vat-pc-val-qnty = vat-pc-val-qnty + 1.
     5883           ACCUMULATE d-slt-vat.slt-pc (COUNT ).
     5884   end.
     5885   PUT STREAM PrnLibStream Line format "X(188)" .
     5886   DOWN STREAM PrnLibStream 1 with FRAME SJ-Base .
     5887   if classify <> "no-grp-totals" then do:
     5888     UNDERLINE STREAM PrnLibStream
     5889     jj-tot
     5890     sj-goods.b-code
     5891     sj-goods.artic
     5892     sj-goods.name
     5893     clients.obj-name
     5894     sj-goods.qnty
     5895     sj-goods.unit
     5896     sj-goods.uchet-with-vat-sum
     5897     sj-goods.uchet-sum
     5898     sj-goods.netto-sum
     5899     sj-goods.n-u-sum
     5900     sj-goods.u-pcnt
     5901     sj-goods.VAT-pc
     5902     sj-goods.VAT-r-b
     5903     with FRAME SJ-Base .
     5904     v-ii = 0.
     5905     _grp:
     5906     do while true:
     5907       if v-ii = 0 then do:
     5908         find first sj-grp use-index p4 no-error.
     5909       end.
     5910       else do:
     5911         find next sj-grp use-index p4 no-error.
     5912       end.
     5913       v-ii = v-ii + 1.
     5914       if not available sj-grp then do:
     5915        leave _grp.
     5916       end.
     5917       define variable s1 as character no-undo .
     5918       define variable s2 as character no-undo .
     5919       define variable s3 as character no-undo .
     5920       assign
     5921       s1 = substring(sj-grp.serv-name, 1, 16)
     5922       s2 = (if length(sj-grp.serv-name) > 16
     5923             then substring(sj-grp.serv-name, 16 + 1, 25)
     5924             else '')
     5925       s3 = (if length(sj-grp.serv-name) > (16 + 25)
     5926             then substring(sj-grp.serv-name, 16 + 25 + 1, 15)
     5927             else '')
     5928       .
     5929       DISPLAY  STREAM PrnLibStream
     5930       sym1
     5931       (if v-ii = 1
     5932       then "Группы:"
     5933       else "")         @ sj-goods.b-code
     5934       s1 @ sj-goods.artic
     5935       s2 @ sj-goods.name
     5936       s3 @ clients.obj-name
     5937       sj-grp.qnty @ sj-goods.qnty
     5938       sj-grp.netto-sum @ sj-goods.netto-sum
