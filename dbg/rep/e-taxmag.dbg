     3956        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     3957        SIZE 43.7 BY 4.83.
     3958   DEFINE RECTANGLE RECT-7
     3959        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     3960        SIZE 43.7 BY 3.93.
     3961   DEFINE RECTANGLE RECT-8
     3962        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     3963        SIZE 43.7 BY 4.5.
     3964   DEFINE VARIABLE T-neg AS LOGICAL INITIAL no
     3965        LABEL "Отрицательную наценку считать = 0"
     3966        VIEW-AS TOGGLE-BOX
     3967        SIZE 37.8 BY 1.03 NO-UNDO.
     3968   DEFINE VARIABLE T-partsneg AS LOGICAL INITIAL no
     3969        LABEL "Учитывать только порожденные партии"
     3970        VIEW-AS TOGGLE-BOX
     3971        SIZE 37.8 BY 1.03 NO-UNDO.
     3972   DEFINE VARIABLE Tog-level AS LOGICAL INITIAL no
     3973        LABEL "с уровня":L
     3974        VIEW-AS TOGGLE-BOX
     3975        SIZE 12.6 BY .77
     3976        FGCOLOR 0  NO-UNDO.
     3977   DEFINE FRAME F-Main
     3978        Classify AT ROW 2.07 COL 46.5 NO-LABEL WIDGET-ID 2
     3979        RS-Method AT ROW 2.57 COL 7 NO-LABEL
     3980        Tog-level AT ROW 3.8 COL 80 WIDGET-ID 8
     3981        var-level AT ROW 4.67 COL 78 COLON-ALIGNED NO-LABEL WIDGET-ID 10
     3982        RS-By AT ROW 7.77 COL 3.5 NO-LABEL
     3983        T-neg AT ROW 12.2 COL 5
     3984        T-partsneg AT ROW 13.5 COL 5
     3985        "Подитоги по группам" VIEW-AS TEXT
     3986             SIZE 33.1 BY .87 AT ROW 1.27 COL 47.5 WIDGET-ID 12
     3987             FGCOLOR 4
     3988        "Источник формирования" VIEW-AS TEXT
     3989             SIZE 34.6 BY .83 AT ROW 6.7 COL 3.5
     3990             FGCOLOR 4
     3991        "Детализация" VIEW-AS TEXT
     3992             SIZE 33.1 BY .87 AT ROW 1.43 COL 3.3
     3993             FGCOLOR 4
     3994        RECT-6 AT ROW 1.27 COL 2.3
     3995        RECT-8 AT ROW 6.47 COL 2.3
     3996        RECT-7 AT ROW 11.33 COL 2.3
     3997       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
     3998            SIDE-LABELS NO-UNDERLINE THREE-D
     3999            AT COL 1 ROW 1
     4000            SIZE 91.9 BY 15.
     4001   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     4002   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     4003   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     4004   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     4005   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     4006   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     4007   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     4008   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     4009       ASSIGN adm-object-hdl = FRAME F-Main:HANDLE.
     4010   RUN ensure-broker.
     4011   THIS-PROCEDURE:ADM-DATA =
     4012        'ADM1.1~`':U +
     4013        'SmartObject~`':U +
     4014        'FRAME~`':U +
     4015        'NO ~`':U +
     4016        '~`':U +
     4017        '~`':U +
     4018        '~`':U +
     4019        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     4020           + "~`":U +
     4021        'Layout,Hide-on-Init~`':U +
     4022        '~`':U +
     4023        '~`':U +
     4024        '~`~`~`~`~`~`~`~`~`~`~`':U +
     4025        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     4026            THEN "^^":U
     4027        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     4028             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     4029   PROCEDURE adm-apply-entry :
     4030     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     4031   END PROCEDURE.
     4032   PROCEDURE adm-destroy :
     4033    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     4034   END PROCEDURE.
     4035   PROCEDURE adm-disable :
     4036       DISABLE RECT-6 RECT-8 RECT-7 Classify RS-Method RS-By T-neg WITH FRAME F-Main.
     4037       RUN dispatch ('disable-fields':U).
     4038       RUN set-attribute-list ('ENABLED=no':U).
     4039       RETURN.
     4040   END PROCEDURE.
     4041   PROCEDURE adm-edit-attribute-list :
     4042         RUN adm/support/contnrd.w (INPUT THIS-PROCEDURE).
     4043         RETURN.
     4044   END PROCEDURE.
     4045   PROCEDURE adm-enable :
     4046       ENABLE UNLESS-HIDDEN RECT-6 RECT-8 RECT-7 Classify RS-Method RS-By T-neg WITH FRAME F-Main.
     4047       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     4048       RUN set-attribute-list ('ENABLED=yes':U).
     4049       RETURN.
     4050   END PROCEDURE.
     4051   PROCEDURE adm-exit :
     4052        RUN notify ('exit':U).
     4053     RETURN.
     4054   END PROCEDURE.
     4055   PROCEDURE adm-hide :
     4056     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     4057   END PROCEDURE.
     4058   PROCEDURE adm-initialize :
     4059     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     4060   END PROCEDURE.
     4061   PROCEDURE adm-show-errors :
     4062       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     4063       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     4064           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     4065       END.
     4066       RETURN.
     4067   END PROCEDURE.
     4068   PROCEDURE adm-UIB-mode :
     4069     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     4070   END PROCEDURE.
     4071   PROCEDURE adm-view :
     4072     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     4073   END PROCEDURE.
     4074   PROCEDURE dispatch :
     4075       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     4076       RUN broker-dispatch IN adm-broker-hdl
     4077           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     4078       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     4079   END PROCEDURE.
     4080   PROCEDURE ensure-broker :
     4081   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     4082   IF RETURN-VALUE NE "ADM-Broker":U THEN
     4083   DO:
     4084       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     4085       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     4086   END.
     4087   END PROCEDURE.
     4088   PROCEDURE get-attribute :
     4089     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     4090     RUN broker-get-attribute IN adm-broker-hdl
     4091         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     4092     RETURN RETURN-VALUE.
     4093   END PROCEDURE.
     4094   PROCEDURE get-attribute-list :
     4095     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     4096     RUN broker-get-attribute-list IN adm-broker-hdl
     4097         (INPUT THIS-PROCEDURE,
     4098          INPUT ?,
     4099          OUTPUT p-attr-list) NO-ERROR.
     4100     RETURN.
     4101   END PROCEDURE.
     4102   PROCEDURE new-state :
     4103     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     4104     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     4105     RETURN.
     4106   END PROCEDURE.
     4107   PROCEDURE notify :
     4108     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     4109     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     4110     IF RETURN-VALUE = "ADM-ERROR":U THEN
     4111         RETURN "ADM-ERROR":U.
     4112     RETURN.
     4113   END PROCEDURE.
     4114   PROCEDURE set-attribute-list :
     4115     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     4116     RUN ensure-broker.
     4117     RUN broker-set-attribute-list IN adm-broker-hdl
     4118         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     4119     RETURN.
     4120   END PROCEDURE.
     4121   PROCEDURE set-position :
     4122       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     4123       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     4124       IF VALID-HANDLE(adm-object-hdl) THEN
     4125       DO:
     4126           DEFINE VARIABLE parent-hdl AS HANDLE NO-UNDO.
     4127           IF adm-object-hdl:TYPE = "WINDOW":U THEN
     4128           DO:
     4129             IF p-row = 0 THEN p-row =
     4130               (SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2.
     4131             IF p-col = 0 THEN p-col =
     4132               (SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2.
     4133           END.
     4134           ELSE IF adm-object-hdl:TYPE = "DIALOG-BOX":U THEN
     4135           DO:
     4136             parent-hdl = adm-object-hdl:PARENT.
     4137             IF p-row = 0 THEN p-row =
     4138               ((SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2) -
     4139                 parent-hdl:ROW.
     4140             IF p-col = 0 THEN p-col =
     4141               ((SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2) -
     4142                 parent-hdl:COL.
     4143           END.
     4144           IF p-row GE 0 AND p-row < 1 THEN p-row = 1.
     4145           IF p-col GE 0 AND p-col < 1 THEN p-col = 1.
     4146         ASSIGN adm-object-hdl:ROW    =   p-row
     4147                adm-object-hdl:COLUMN =   p-col.
     4148       END.
     4149       RETURN.
     4150   END PROCEDURE.
     4151   RUN set-attribute-list ("CURRENT-PAGE=0,ADM-OBJECT-HANDLE=":U +
     4152       STRING(adm-object-hdl)).
     4153   PAUSE 0 BEFORE-HIDE.
     4154   PROCEDURE adm-change-page :
     4155     RUN broker-change-page IN adm-broker-hdl (INPUT THIS-PROCEDURE) NO-ERROR.
     4156     END PROCEDURE.
     4157   PROCEDURE delete-page :
     4158     DEFINE INPUT PARAMETER p-page# AS INTEGER NO-UNDO.
     4159     RUN broker-delete-page IN adm-broker-hdl
     4160         (INPUT THIS-PROCEDURE, INPUT p-page#).
     4161     END PROCEDURE.
     4162   PROCEDURE init-object :
     4163     DEFINE INPUT PARAMETER  p-proc-name   AS CHARACTER NO-UNDO.
     4164     DEFINE INPUT PARAMETER  p-parent-hdl  AS HANDLE    NO-UNDO.
     4165     DEFINE INPUT PARAMETER  p-attr-list   AS CHARACTER NO-UNDO.
     4166     DEFINE OUTPUT PARAMETER p-proc-hdl    AS HANDLE    NO-UNDO.
     4167     RUN broker-init-object IN adm-broker-hdl
     4168         (INPUT THIS-PROCEDURE, INPUT p-proc-name, INPUT p-parent-hdl,
     4169          INPUT p-attr-list, OUTPUT p-proc-hdl) NO-ERROR.
     4170     RETURN.
     4171   END PROCEDURE.
     4172   PROCEDURE init-pages :
     4173     DEFINE INPUT PARAMETER p-page-list      AS CHARACTER NO-UNDO.
     4174     RUN broker-init-pages IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     4175         INPUT p-page-list) NO-ERROR.
     4176     END PROCEDURE.
     4177   PROCEDURE select-page :
     4178     DEFINE INPUT PARAMETER p-page#     AS INTEGER   NO-UNDO.
     4179     RUN broker-select-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     4180         INPUT p-page#) NO-ERROR.
     4181     END PROCEDURE.
     4182   PROCEDURE view-page :
     4183     DEFINE INPUT PARAMETER p-page#      AS INTEGER   NO-UNDO.
     4184     RUN broker-view-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     4185         INPUT p-page#).
     4186     END PROCEDURE.
     4187   ASSIGN
     4188          T-partsneg:HIDDEN IN FRAME F-Main           = TRUE.
     4189   ASSIGN
     4190          Tog-level:HIDDEN IN FRAME F-Main           = TRUE.
     4191   ASSIGN
     4192          var-level:HIDDEN IN FRAME F-Main           = TRUE.
     4193   ON VALUE-CHANGED OF Classify IN FRAME F-Main
     4194   DO:
     4195     ASSIGN Classify.
     4196     if classify = "n-level":u then do:
     4197       enable
     4198       tog-level
     4199       var-level
     4200       with frame F-Main .
     4201       display
     4202       tog-level
     4203       var-level
     4204       with frame F-Main .
     4205     end.
     4206     else do:
     4207       hide
     4208       tog-level
     4209       var-level
     4210       in frame F-Main .
     4211     end.
     4212   END.
     4213   ON VALUE-CHANGED OF Tog-level IN FRAME F-Main
     4214   DO:
     4215     assign tog-level.
     4216     if tog-level = true then do:
     4217       display var-level with frame F-Main .
     4218       enable  var-level with frame F-Main .
     4219     end.
     4220     else do:
     4221       display var-level with frame F-Main .
     4222       disable var-level with frame F-Main .
     4223     end.
     4224   END.
     4225   if not this-procedure :persistent
     4226   then do:
     4227     message
     4228       vss-workfile vss-revision vss-description skip
     4229       "Ошибка при запуске процедуры" skip
     4230       "Данную процедуру следует запускать только с параметром persistent" skip
     4231       view-as alert-box error .
     4232     undo, return error .
     4233   end.
     4234   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4235   PROCEDURE no-benq.
     4236   DEFINE OUTPUT PARAMETER found as logical init no.
     4237   define buffer buf_chk-doc for ub.chk-doc.
     4238   FOR EACH obj-list WHERE
     4239           obj-list.obj-type = 'маг':U NO-LOCK :
     4240     CASE X-Radio-Task > 1 :
     4241       WHEN YES THEN DO:
     4242         FOR EACH buf_chk-doc NO-LOCK WHERE
     4243                 buf_chk-doc.obj-type = obj-list.obj-type AND
     4244                 buf_chk-doc.obj-code = obj-list.obj-code AND
     4245                 (
     4246                   buf_chk-doc.shift-date >= X-date-start AND
     4247                   buf_chk-doc.shift-date <= X-date-end)
     4248                   AND
     4249                   (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     4250           IF X-Radio-Task = 3 AND
     4251           ((buf_chk-doc.shift-date = X-date-start AND buf_chk-doc.shift-num < X-shift-Start) OR
     4252             (buf_chk-doc.shift-date = X-date-end AND  buf_chk-doc.shift-num > X-shift-End) ) THEN NEXT.
     4253           IF X-Radio-Task = 4 AND
     4254           (buf_chk-doc.shift-num <> X-shift-Alone ) THEN NEXT.
     4255           found = yes.
     4256           return.
     4257         END.
     4258       END.
     4259       WHEN NO THEN DO:
     4260         FOR EACH buf_chk-doc NO-LOCK WHERE
     4261               buf_chk-doc.obj-type = obj-list.obj-type AND
     4262               buf_chk-doc.obj-code = obj-list.obj-code AND
     4263               buf_chk-doc.chk-date >= X-date-start AND
     4264               buf_chk-doc.chk-date <= X-date-end   AND
     4265               (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     4266           found = yes.
     4267           return.
     4268         END.
     4269        END.
     4270      END CASE.
     4271    END.
     4272   END PROCEDURE.
     4273   PROCEDURE no-benqi.
     4274   DEFINE OUTPUT PARAMETER found as logical init no.
     4275   define buffer buf_chk-doc for ub.chk-doc.
     4276   define buffer buf_inkas for ub.inkas.
     4277   FOR EACH obj-list WHERE
     4278         obj-list.obj-type = 'маг':U NO-LOCK :
     4279     CASE X-Radio-Task > 1 :
     4280       WHEN YES THEN DO:
     4281         FOR EACH buf_chk-doc No-LOCK WHERE
     4282                 buf_chk-doc.obj-type = obj-list.obj-type AND
     4283                 buf_chk-doc.obj-code = obj-list.obj-code AND
     4284                 (
     4285                   buf_chk-doc.shift-date >= X-date-start AND
     4286                   buf_chk-doc.shift-date <= X-date-end)
     4287                   AND
     4288                   buf_Chk-doc.out-code = ? AND
     4289                   (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     4290           IF X-Radio-Task = 3 AND
     4291           ((buf_chk-doc.shift-date = X-date-start AND buf_chk-doc.shift-num < X-shift-Start) OR
     4292             (buf_chk-doc.shift-date = X-date-end AND  buf_chk-doc.shift-num > X-shift-End) ) THEN NEXT.
     4293           IF X-Radio-Task = 4 AND
     4294           (buf_chk-doc.shift-num <> X-shift-Alone ) THEN NEXT.
     4295           found = yes.
     4296           return.
     4297         END.
     4298         FOR EACH buf_inkas No-LOCK WHERE
     4299                   buf_inkas.obj-type = obj-list.obj-type AND
     4300                   buf_inkas.obj-code = obj-list.obj-code AND
     4301                   (
     4302                   buf_inkas.shift-date >= X-date-start AND
     4303                   buf_inkas.shift-date <= X-date-end):
     4304           if buf_inkas.status_ = 'факт':U
     4305           or buf_inkas.status_ = 'запрос':U then next.
     4306           IF X-Radio-Task = 3 AND
     4307           ((buf_inkas.shift-date = X-date-start AND buf_inkas.shift-num < X-shift-Start) OR
     4308             (buf_inkas.shift-date = X-date-end AND  buf_inkas.shift-num > X-shift-End) ) THEN NEXT.
     4309           IF X-Radio-Task = 4 AND
     4310           (buf_inkas.shift-num <> X-shift-Alone ) THEN NEXT.
     4311           found = yes.
     4312           return.
     4313         END.
     4314       END.
     4315       WHEN NO THEN DO:
     4316         FOR EACH buf_chk-doc NO-LOCK WHERE
     4317                 buf_chk-doc.obj-type = obj-list.obj-type AND
     4318                 buf_chk-doc.obj-code = obj-list.obj-code AND
     4319                 buf_chk-doc.chk-date >= X-date-start AND
     4320                 buf_chk-doc.chk-date <= X-date-end   AND
     4321                 buf_Chk-doc.out-code = ? AND
     4322                 (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     4323           found = yes.
     4324           return.
     4325         END.
     4326         FOR EACH buf_inkas NO-LOCK WHERE
     4327                 buf_inkas.obj-type = obj-list.obj-type AND
     4328                 buf_inkas.obj-code = obj-list.obj-code AND
     4329                 buf_inkas.doc-date >= X-date-start AND
     4330                 buf_inkas.doc-date <= X-date-end :
     4331           if buf_inkas.status_ = 'факт':U
     4332           or buf_inkas.status_ = 'запрос':U then next.
     4333           found = yes.
     4334           return.
     4335         END.
     4336       END.
     4337     END CASE.
     4338   END.
     4339   END PROCEDURE.
     4340   PROCEDURE no-benq-i.
     4341   DEFINE OUTPUT PARAMETER found as logical init no.
     4342   define buffer buf_inkas for ub.inkas.
     4343   CASE X-Radio-Task > 1:
     4344     WHEN YES then do:
     4345       FOR EACH obj-list WHERE
     4346               obj-list.obj-type = 'маг':U NO-LOCK :
     4347         FOR EACH buf_inkas NO-LOCK WHERE
     4348                 buf_inkas.obj-type = obj-list.obj-type AND
     4349                 buf_inkas.obj-code = obj-list.obj-code AND
     4350                 buf_inkas.status_ = 'факт':U AND
     4351                 (
     4352                 buf_inkas.shift-date >= X-date-start AND
     4353                 buf_inkas.shift-date <= X-date-end):
     4354           IF X-Radio-Task = 3 AND
     4355           ((buf_inkas.shift-date = X-date-start AND buf_inkas.shift-num < X-shift-Start) OR
     4356             (buf_inkas.shift-date = X-date-end AND  buf_inkas.shift-num > X-shift-End) ) THEN NEXT.
     4357           IF X-Radio-Task = 4 AND
     4358           (buf_inkas.shift-num <> X-shift-Alone ) THEN NEXT.
     4359           found = yes.
     4360           return.
     4361         END.
     4362     END.
     4363     END.
     4364     WHEN NO THEN DO:
     4365       FOR EACH obj-list WHERE
     4366               obj-list.obj-type = 'маг':U NO-LOCK :
     4367         FOR EACH buf_inkas NO-LOCK WHERE
     4368                 buf_inkas.obj-type = obj-list.obj-type AND
     4369                 buf_inkas.obj-code = obj-list.obj-code AND
     4370                 buf_inkas.status_ = 'факт':U AND
     4371                 buf_inkas.doc-date >= X-date-start AND
     4372                 buf_inkas.doc-date <= X-date-end :
     4373            found = yes.
     4374            return.
     4375         END.
     4376       END.
     4377     END.
     4378   END CASE.
     4379   END PROCEDURE.
     4380   PROCEDURE no-benq-i-office.
     4381   DEFINE OUTPUT PARAMETER found as logical init no.
     4382   define buffer buf_sale-doc for ub.sale-doc.
     4383   CASE X-Radio-Task > 1:
     4384     WHEN YES then do:
     4385       FOR EACH obj-list WHERE
     4386               obj-list.obj-type = 'маг':U NO-LOCK :
     4387         FOR EACH buf_sale-doc NO-LOCK WHERE
     4388                  buf_Sale-doc.obj-type = obj-list.obj-type
     4389              AND buf_sale-doc.obj-code = obj-list.obj-code
     4390              AND buf_sale-doc.status_ = 'факт':U
     4391              AND buf_sale-doc.chr-office = 'у':U
     4392              AND (
     4393                 buf_sale-doc.shift-date >= X-date-start
     4394                 AND
     4395                 buf_sale-doc.shift-date <= X-date-end):
     4396           IF X-Radio-Task = 3 AND
     4397           ((buf_sale-doc.shift-date = X-date-start AND buf_sale-doc.shift-num < X-shift-Start) OR
     4398             (buf_sale-doc.shift-date = X-date-end AND  buf_sale-doc.shift-num > X-shift-End) ) THEN NEXT.
     4399           IF X-Radio-Task = 4 AND
     4400           (buf_sale-doc.shift-num <> X-shift-Alone ) THEN NEXT.
     4401           found = yes.
     4402           return.
     4403         END.
     4404       END.
     4405     END.
     4406     WHEN NO THEN DO:
     4407       FOR EACH obj-list WHERE
     4408               obj-list.obj-type = 'маг':U NO-LOCK :
     4409         FOR EACH buf_sale-doc NO-LOCK WHERE
     4410                 buf_sale-doc.obj-type = obj-list.obj-type
     4411            AND  buf_sale-doc.obj-code = obj-list.obj-code
     4412            AND  buf_sale-doc.status_ = 'факт':U
     4413            AND  buf_sale-doc.chr-office = 'у':U
     4414            AND  buf_sale-doc.doc-date >= X-date-start
     4415            AND  buf_sale-doc.doc-date <= X-date-end :
     4416           found = yes.
     4417           return.
     4418         END.
     4419       END.
     4420     END.
     4421   END CASE.
     4422   END PROCEDURE.
     4423   PROCEDURE adm-create-objects :
     4424   END PROCEDURE.
     4425   PROCEDURE adm-row-available :
     4426     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
     4427     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
     4428     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
     4429     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
     4430     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
     4431     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
     4432     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
     4433     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
     4434     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
     4435     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
     4436     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
     4437     IF adm-updating-record THEN RETURN.
     4438     RUN get-attribute ('FIELDS-ENABLED':U).
     4439     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
     4440     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
     4441         OUTPUT link-handle) NO-ERROR.
     4442     IF link-handle = "":U THEN
     4443         RETURN.
     4444     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
     4445     IF NUM-ENTRIES(link-handle) > 1 THEN
     4446         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
     4447             "encountered more than one RECORD-SOURCE.":U SKIP
     4448             "The first - ":U record-source-hdl:file-name " - will be used.":U
     4449                VIEW-AS ALERT-BOX ERROR.
     4450     RUN get-attribute ('Key-Name':U).
     4451     key-name = RETURN-VALUE.
     4452     IF key-name = "":U THEN key-name = ?.
     4453     IF key-name NE ? THEN DO:
     4454       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
     4455         NO-ERROR.
     4456       IF key-value NE ? THEN
     4457         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
     4458     END.
     4459   IF VALID-HANDLE (adm-object-hdl) THEN
     4460       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     4461   RUN notify IN THIS-PROCEDURE ('row-available':U).
     4462   END PROCEDURE.
     4463   PROCEDURE cre-sj :
     4464   define input parameter v-curr-r-b as character no-undo .
     4465   define input parameter  doc-num like trn-doc.doc-code no-undo.
     4466   define input parameter is-out as integer init 1.
     4467   define input parameter offc as logical no-undo.
     4468   define variable s-price as decimal no-undo .
     4469   define variable cur-discnt as decimal no-undo .
     4470   define variable cur-quant like gds-dtl.doc-qnty no-undo.
     4471   define variable slt-calc as dec.
     4472   define variable vat-cost as dec.
     4473   define variable r-bar-code like bar-code.b-code no-undo.
     4474   DEFINE VARIABLE varsum-dsc-r-b-acc as decimal no-undo .
     4475   DEFINE VARIABLE varvat-r-b-acc     as decimal no-undo .
     4476   DEFINE VARIABLE var-qnty              as decimal no-undo .
     4477   DEFINE VARIABLE varvat-r-b-doc     as decimal no-undo .
     4478   DEFINE VARIABLE varslt-r-b-doc     as decimal no-undo .
     4479   define buffer buf-bar for bar-code.
     4480   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4481   define variable p-grp-code as integer.
     4482   define variable p-grp-name as char.
     4483   define variable v-curr-grp-name as character.
     4484   _docline:
     4485   FOR EACH doc-line WHERE doc-line.doc-code = doc-num NO-LOCK:
     4486     PROCESS EVENTS.
     4487     jj = jj + 1 .
     4488     if ( jj  modulo 10 ) = 0  then
     4489     run waitfram-show in this-procedure (input ("Обработано строк накладных : " +   string(  jj ) ) ).
     4490   find first goods where goods.prod-type = doc-line.prod-type and
     4491              goods.prod-code = doc-line.prod-code and
     4492               goods.artic = doc-line.artic .
     4493               p-grp-code = goods.grp-code.
     4494               p-grp-name = goods.grp-name.
     4495       case x-SelectGood:
     4496           when 5
     4497           then
     4498               do:
     4499                   find  first gds-list no-lock
     4500                       where gds-list.artic     = goods.artic
     4501                       and gds-list.prod-type = goods.prod-type
     4502                       and gds-list.prod-code = goods.prod-code
     4503                       no-error .
     4504                   if not available gds-list then next.
     4505               end.
     4506           when 1  then
     4507               do:
     4508               end.
     4509           when 2 then
     4510               do:
     4511              find first tmp#grp where
     4512                            ub.goods.grp-name begins tmp#grp.grp-name no-error.
     4513                   if not avail tmp#grp then NEXT.
     4514               end.
     4515           otherwise
     4516           do:
     4517               find  first gds-list no-lock
     4518                   where goods.artic     = gds-list.artic
     4519                   and goods.prod-type = gds-list.prod-type
     4520                   and goods.prod-code = gds-list.prod-code no-error .
     4521               if not available  gds-list then next.
     4522           end.
     4523       end case.
     4524     run clcprtsl_calc-line in this-procedure (input recid (doc-line)).
     4525     assign
     4526     s-price = 0
     4527     cur-quant = 0
     4528     varsum-dsc-r-b-acc   = 0
     4529     varvat-r-b-acc       = 0
     4530     var-qnty                = 0
     4531     varvat-r-b-doc       = 0
     4532     varslt-r-b-doc       = 0
     4533     .
     4534     find first tt-allsum-line where
     4535                tt-allsum-line.sum-type = 'основная_сумма':U no-error .
     4536     if not available tt-allsum-line then do:
     4537     end.
     4538     else do:
     4539      assign
     4540      varsum-dsc-r-b-acc   = (if v-curr-r-b = 'rubl':U then tt-allsum-line.sum-dsc-rubl-acc else tt-allsum-line.sum-dsc-base-acc)
     4541      varvat-r-b-acc       = (if v-curr-r-b = 'rubl':U then tt-allsum-line.vat-rubl-acc else tt-allsum-line.vat-base-acc)
     4542      var-qnty                = doc-line.fact-qnty
     4543      varvat-r-b-doc       = (if v-curr-r-b = 'rubl':U then tt-allsum-line.vat-rubl-doc else tt-allsum-line.vat-base-doc)
     4544      varslt-r-b-doc       = (if v-curr-r-b = 'rubl':U then tt-allsum-line.slt-rubl-doc else tt-allsum-line.slt-rubl-doc)
     4545      cur-quant = is-out * doc-line.fact-qnty
     4546      s-price = ( varsum-dsc-r-b-acc - varvat-r-b-acc ) / var-qnty
     4547      .
     4548     end.
     4549     if NOT offc AND cur-quant = 0 and negparts then next _docline.
     4550     FOR EACH gds-dtl WHERE
     4551             gds-dtl.doc-code = doc-num AND
     4552             gds-dtl.artic = doc-line.artic AND
     4553             gds-dtl.prod-type = doc-line.prod-type AND
     4554             gds-dtl.prod-code = doc-line.prod-code
     4555             NO-LOCK:
     4556       if method = "b-code":U then do:
     4557         FIND FIRST goods No-LOCK WHERE
     4558                   goods.artic = gds-dtl.artic AND
     4559                   goods.prod-type = gds-dtl.prod-type AND
     4560                   goods.prod-code = gds-dtl.prod-code No-ERROR.
     4561         FIND FIRST bar-code WHERE
     4562                   bar-code.gds-code = goods.gds-code AND
     4563                   bar-code.in-code = "" AND
     4564                   bar-code.unit-cli = goods.unit-base AND
     4565                   bar-code.part-code = "" AND
     4566                   bar-code.node-code = gds-dtl.prt-code
     4567                   NO-LOCK   NO-ERROR.
     4568       end.
     4569       assign
     4570       cur-discnt = (if v-curr-r-b = 'rubl':U then gds-dtl.discnt-rubl else gds-dtl.discnt-base)
     4571       .
     4572       CASE method :
     4573         when "b-code":U THEN dO:
     4574           FIND FIRST sj-goods WHERE
     4575                     sj-goods.b-code = bar-code.b-code AND
     4576                     sj-goods.VAT-pc = doc-line.VAT-pc AND
     4577                     sj-goods.SLT-pc = doc-line.SLT-pc AND
     4578                     sj-goods.is-out = (is-out > 0) NO-ERROR .
     4579         END.
     4580         when "artic":U THEN DO:
     4581           FIND FIRST sj-goods WHERE
     4582                     sj-goods.artic = doc-line.artic AND
     4583                     sj-goods.prod-type = doc-line.prod-type AND
     4584                     sj-goods.prod-code = doc-line.prod-code AND
     4585                     sj-goods.VAT-pc = doc-line.VAT-pc AND
     4586                     sj-goods.SLT-pc = doc-line.SLT-pc AND
     4587                     sj-goods.is-out = (is-out > 0) USE-INDEX p3 NO-ERROR .
     4588         END.
     4589         otherwise do:
     4590           FIND FIRST sj-goods WHERE
     4591                     sj-goods.VAT-pc = doc-line.VAT-pc AND
     4592                     sj-goods.SLT-pc = doc-line.SLT-pc AND
     4593                     sj-goods.is-out = (is-out > 0) NO-ERROR .
     4594         end.
     4595       END CASE.
     4596       if NOT available sj-goods then do:
     4597         FIND goods WHERE
     4598             goods.prod-type = doc-line.prod-type AND
     4599             goods.prod-code = doc-line.prod-code AND
     4600             goods.artic = doc-line.artic NO-LOCK .
     4601         if method = "artic":U then do:
     4602   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     4603     (input  goods.gds-code
     4604     ,input  ?
     4605     ,output r-bar-code
     4606     ) no-error .
     4607           if error-status:error then NEXT _docline.
     4608         end.
     4609         CREATE sj-goods.
     4610         CASE method:
     4611           WHEN  "b-code":U then DO:
     4612             assign
     4613             sj-goods.b-code = bar-code.b-code
     4614             sj-goods.name = goods.gds-name
     4615             sj-goods.artic = goods.artic
     4616             sj-goods.VAT-pc = doc-line.VAT-pc
     4617             sj-goods.SLT-pc = doc-line.SLT-pc
     4618             sj-goods.unit  = goods.unit-base
     4619             sj-goods.is-out = (is-out > 0)
     4620               .
     4621           END.
     4622           WHEN "artic":U then do:
     4623             assign
     4624             sj-goods.b-code = r-bar-code
     4625             sj-goods.name = goods.gds-name
     4626             sj-goods.artic = goods.artic
     4627             sj-goods.prod-type = goods.prod-type
     4628             sj-goods.prod-code = goods.prod-code
     4629             sj-goods.VAT-pc = doc-line.VAT-pc
     4630             sj-goods.SLT-pc = doc-line.SLT-pc
     4631             sj-goods.unit  = goods.unit-base
     4632             sj-goods.is-out = (is-out > 0)
     4633               .
     4634           END.
     4635           WHEN "TOTALS":U then do:
     4636             assign
     4637             sj-goods.VAT-pc = doc-line.VAT-pc
     4638             sj-goods.SLT-pc = doc-line.SLT-pc
     4639             sj-goods.is-out = (is-out > 0)
     4640             .
     4641           END.
     4642         END CASE.
     4643         sj-goods.grp-code = ub.goods.grp-code.
     4644         sj-goods.grp-name = ub.goods.grp-name.
     4645       end.
     4646   if t-doc.ext-doc-type = 'ot':U or
     4647      t-doc.ext-doc-type = ?                 then do:
     4648     assign
     4649      out-vatp-have-vat-slt = yes.
     4650   end.
     4651   else do:
     4652     find first out-vatp_doc-attr no-lock
     4653       where out-vatp_doc-attr.doc-code  = t-doc.doc-code
     4654         and out-vatp_doc-attr.attr-code = 'envd':U
     4655         no-error .
     4656     if not available out-vatp_doc-attr then do:
     4657       assign
     4658         out-vatp-have-vat-slt = yes.
     4659     end.
     4660     else do:
     4661        out-vatp-have-vat-slt = no.
     4662     end.
     4663   end.
     4664   find first out-vatp_goods where out-vatp_goods.artic     = doc-line.artic     and
     4665                                      out-vatp_goods.prod-type = doc-line.prod-type and
     4666                                      out-vatp_goods.prod-code = doc-line.prod-code no-lock.
     4667   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4668   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
     4669     (input  doc-line.artic
     4670     ,input  doc-line.prod-type
     4671     ,input  doc-line.prod-code
     4672     ,output varroot-node
     4673     ) no-error .
     4674   if error-status :error then do:
     4675     message
     4676       vss-workfile vss-revision vss-description skip
     4677       "Ошибка при определении корневого признака товара" skip
     4678       "Артикул" doc-line.artic doc-line.prod-type doc-line.prod-code skip
     4679       error-status :get-message(1) skip
     4680       return-value skip
     4681       view-as alert-box error .
     4682     undo, return error .
     4683   end.
     4684   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtat in g#library
     4685     (input  varroot-node
     4686     ,input  'empty-scale=request'
     4687     ,output varempty-scale
     4688     ) no-error .
     4689   if error-status :error then do:
     4690     message
     4691       vss-workfile vss-revision vss-description skip
     4692       "Ошибка при определении атрибута признака" skip
     4693       "Артикул" doc-line.artic doc-line.prod-type doc-line.prod-code skip
     4694       "Признак" varroot-node skip
     4695       "Запрашивался атрибут" "empty-scale=request" skip
     4696       error-status :get-message(1) skip
     4697       return-value skip
     4698       view-as alert-box error .
     4699     undo, return error .
     4700   end.
     4701   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     4702   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     4703     (output varoutvprb
     4704     )  .
     4705   if varoutvprb = "base":u then do:
     4706     assign
     4707           road-tax-base-sale    =  (if doc-line.road-tax = ? then 0 else doc-line.road-tax * 1)
     4708       excise-base-sale      =  (if doc-line.excise   = ? then 0 else doc-line.excise   * 1)
     4709     .
     4710   end.
     4711   else do:
     4712     assign
     4713           road-tax-base-sale    =  (if doc-line.road-tax = ? then 0 else doc-line.road-tax / t-doc.base-rate * t-doc.base-scale)
     4714       excise-base-sale      =  (if doc-line.excise   = ? then 0 else doc-line.excise   / t-doc.base-rate * t-doc.base-scale)
     4715     .
     4716   end.
     4717   if varoutvprb = "rubl":u then do:
     4718     assign
     4719           road-tax-rubl-sale    = (if doc-line.road-tax = ? then 0 else doc-line.road-tax * 1)
     4720       excise-rubl-sale      = (if doc-line.excise   = ? then 0 else doc-line.excise   * 1) .
     4721   end.
     4722   else do:
     4723     assign
     4724           road-tax-rubl-sale    = (if doc-line.road-tax = ? then 0 else doc-line.road-tax * t-doc.base-rate / t-doc.base-scale)
     4725       excise-rubl-sale      = (if doc-line.excise   = ? then 0 else doc-line.excise   * t-doc.base-rate / t-doc.base-scale) .
     4726   end.
     4727   assign
     4728     varis-cons-parts-have =  no.
     4729   assign
     4730     varfact-qnty       = 0
     4731     varcons-qnty       = 0
     4732     varprice-base-cons = 0
     4733     varprice-rubl-cons = 0.
     4734   find first out-vatp_doc-line where
     4735              out-vatp_doc-line.doc-code   = t-doc.doc-code
     4736          and out-vatp_doc-line.artic      = doc-line.artic
     4737          and out-vatp_doc-line.prod-type  = doc-line.prod-type
     4738          and out-vatp_doc-line.prod-code  = doc-line.prod-code no-lock no-error.
     4739   if available out-vatp_doc-line           and
     4740     (out-vatp_doc-line.status_ = 'запрос':U or out-vatp_goods.gds-type = 'у':U) then do:
     4741     assign
     4742       varfact-qnty = out-vatp_doc-line.fact-qnty.
     4743   end.
     4744   else do:
     4745     for each out-vatp_parts where out-vatp_parts.out-code   = t-doc.doc-code
     4746                                  and out-vatp_parts.obj-type   = t-doc.obj-type
     4747                                  and out-vatp_parts.obj-code   = t-doc.obj-code
     4748                                  and out-vatp_parts.artic      = doc-line.artic
     4749                                  and out-vatp_parts.prod-type  = doc-line.prod-type
     4750                                  and out-vatp_parts.prod-code  = doc-line.prod-code no-lock :
     4751       if out-vatp_parts.purch-code = 2 then do:
     4752   assign
     4753     price-rubl-with-tax-loco = out-vatp_parts.price-rubl
     4754     price-base-with-tax-loco = out-vatp_parts.price-base
     4755   .
     4756   define variable vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     4757   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     4758     (output varinvprbo
     4759     )  .
     4760     if out-vatp_parts.out-code = 'free-zone':U     or
     4761        out-vatp_parts.out-code = 'out-zone':U   or
     4762        out-vatp_parts.doc-type = 'акт':U then do:
     4763       assign
     4764         in-vatp-have-vat-slto = yes.
     4765     end.
     4766     else do:
     4767       find first in-vatp_doc-attro no-lock
     4768         where in-vatp_doc-attro.doc-code  = out-vatp_parts.out-code
     4769           and in-vatp_doc-attro.attr-code = 'envd':U
     4770         no-error .
     4771       if not available in-vatp_doc-attro then do:
     4772         assign
     4773           in-vatp-have-vat-slto = yes.
     4774       end.
     4775       else do:
     4776            in-vatp-have-vat-slto = no.
     4777       end.
     4778     end.
     4779     assign
     4780      price-cli-with-tax-loco = out-vatp_parts.price-cli
     4781      cli-base-rateo          = out-vatp_parts.cli-base-rate.
     4782     ASSIGN   road-tax-base-loco  = (if out-vatp_parts.road-tax-base  = ? then 0 else out-vatp_parts.road-tax-base)
     4783              road-tax-rubl-loco  = (if out-vatp_parts.road-tax-rubl  = ? then 0 else out-vatp_parts.road-tax-rubl).
     4784     ASSIGN  transport-base-loco = (if out-vatp_parts.transport-base = ? then 0 else out-vatp_parts.transport-base)
     4785             transport-rubl-loco = (if out-vatp_parts.transport-rubl = ? then 0 else out-vatp_parts.transport-rubl)
     4786             other-base-loco     = (if out-vatp_parts.other-base     = ? then 0 else out-vatp_parts.other-base)
     4787             other-rubl-loco     = (if out-vatp_parts.other-rubl     = ? then 0 else out-vatp_parts.other-rubl)
     4788             vat-pc-loco         = (if out-vatp_parts.vat-pc         = ? then 0 else out-vatp_parts.vat-pc)
     4789             slt-pc-loco         = (if out-vatp_parts.slt-pc         = ? then 0 else out-vatp_parts.slt-pc).
     4790             ASSIGN   slt-base-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-base-with-tax-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco)))                           * slt-pc-loco / (100 + slt-pc-loco))                        vat-base-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-base-with-tax-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco))) * (1 - slt-pc-loco / (100 + slt-pc-loco)) * vat-pc-loco / (100 + vat-pc-loco)).
     4791       ASSIGN   slt-rubl-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-rubl-with-tax-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco)))                           * slt-pc-loco / (100 + slt-pc-loco))                        vat-rubl-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-rubl-with-tax-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco))) * (1 - slt-pc-loco / (100 + slt-pc-loco)) * vat-pc-loco / (100 + vat-pc-loco)).
     4792     assign
     4793       exch-rate-cli-loco = (out-vatp_parts.price-rubl - transport-rubl-loco - other-rubl-loco - road-tax-rubl-loco - (if out-vatp_parts.vat-type <> 'в т. ч.':U then vat-rubl-loco else 0) - (if out-vatp_parts.slt-type <> 'в т. ч.':U then slt-rubl-loco else 0)) / out-vatp_parts.price-cli .
     4794     assign
     4795       slt-cli-loco        = slt-rubl-loco       / exch-rate-cli-loco
     4796       vat-cli-loco        = vat-rubl-loco       / exch-rate-cli-loco
     4797       road-tax-cli-loco   = road-tax-rubl-loco  / exch-rate-cli-loco
     4798       transport-cli-loco  = 0
     4799       other-cli-loco      = 0
     4800     .
     4801   ASSIGN
     4802             price-base-without-tax-loco = price-base-with-tax-loco - vat-base-loco - slt-base-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco))
     4803       price-rubl-without-tax-loco = price-rubl-with-tax-loco - vat-rubl-loco - slt-rubl-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco))
     4804   .
     4805         assign
     4806           varprice-base-cons = varprice-base-cons + (price-base-with-tax-loco - (if road-tax-base-loco = ? then 0 else road-tax-base-loco))* out-vatp_parts.fact-qnty
     4807           varprice-rubl-cons = varprice-rubl-cons + (price-rubl-with-tax-loco - (if road-tax-rubl-loco = ? then 0 else road-tax-rubl-loco))* out-vatp_parts.fact-qnty.
     4808         assign
     4809           varis-cons-parts-have = yes
     4810           varcons-qnty          = varcons-qnty + out-vatp_parts.fact-qnty.
     4811       end.
     4812       assign
     4813         varfact-qnty = varfact-qnty + out-vatp_parts.fact-qnty.
     4814     end.
     4815   end.
     4816   assign
     4817     varprice-base-cons = varprice-base-cons / varcons-qnty
     4818     varprice-rubl-cons = varprice-rubl-cons / varcons-qnty.
     4819   if varprice-base-cons = ? then do:
     4820     assign
     4821       varprice-base-cons = 0.
     4822   end.
     4823   if varprice-rubl-cons = ? then do:
     4824     assign
     4825       varprice-rubl-cons = 0.
     4826   end.
     4827   assign
     4828       slt-base-sale               = (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc)
     4829     vat-base-buyer              = (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-base-sale) * doc-line.vat-pc / (100 + doc-line.vat-pc)
     4830     discnt-base-sale            = gds-dtl.discnt-base
     4831     price-base-with-tax-sale    = (gds-dtl.price-base - gds-dtl.discnt-base)
     4832       slt-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc)
     4833     vat-rubl-buyer              = (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-rubl-sale) * doc-line.vat-pc / (100 + doc-line.vat-pc)
     4834     discnt-rubl-sale            = gds-dtl.discnt-rubl
     4835     price-rubl-with-tax-sale    = (gds-dtl.price-rubl - gds-dtl.discnt-rubl)
     4836     .
     4837   if t-doc.doc-type = 'инв':U then do:
     4838     assign
     4839       varfact-qnty = gds-dtl.doc-qnty.
     4840   end.
     4841   else do:
     4842     assign
     4843       varfact-qnty = gds-dtl.fact-qnty.
     4844   end.
     4845   if varis-cons-parts-have = no then do:
     4846     assign
     4847           vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-base-sale) * doc-line.vat-pc / (100 + doc-line.vat-pc)
     4848           vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-rubl-sale) * doc-line.vat-pc / (100 + doc-line.vat-pc).
     4849   end.
     4850   else do:
     4851     if t-doc.doc-type = 'инв':U then do:
     4852       assign
     4853               vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else (((gds-dtl.price-base - gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-base-sale - varprice-base-cons) * doc-line.cons-vat-pc / (100 + doc-line.cons-vat-pc) * gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((gds-dtl.price-base - gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-base-sale) * doc-line.vat-pc / (100 + doc-line.vat-pc) * gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     4854               vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else (((gds-dtl.price-rubl - gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * doc-line.cons-vat-pc / (100 + doc-line.cons-vat-pc) * gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((gds-dtl.price-rubl - gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-rubl-sale) * doc-line.vat-pc / (100 + doc-line.vat-pc) * gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     4855        .
     4856     end.
     4857     else do:
     4858       assign
     4859               vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else (((gds-dtl.price-base - gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-base-sale - varprice-base-cons) * doc-line.cons-vat-pc / (100 + doc-line.cons-vat-pc) * gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((gds-dtl.price-base - gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - varprice-base-cons) * doc-line.vat-pc / (100 + doc-line.vat-pc) * gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     4860               vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else (((gds-dtl.price-rubl - gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * doc-line.cons-vat-pc / (100 + doc-line.cons-vat-pc) * gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((gds-dtl.price-rubl - gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - varprice-rubl-cons) * doc-line.vat-pc / (100 + doc-line.vat-pc) * gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     4861        .
     4862     end.
     4863   end.
     4864   assign
     4865   price-base-without-tax-sale = price-base-with-tax-sale - vat-base-sale - slt-base-sale - road-tax-base-sale
     4866   price-rubl-without-tax-sale = price-rubl-with-tax-sale - vat-rubl-sale - slt-rubl-sale - road-tax-rubl-sale.
     4867       assign
     4868       cur-quant = is-out * gds-dtl.fact-qnty
     4869       slt-calc = (if v-curr-r-b = 'rubl':U then slt-rubl-sale else slt-base-sale) * cur-quant
     4870       vat-cost = (if v-curr-r-b = 'rubl':U then vat-rubl-sale else vat-base-sale) * cur-quant
     4871       slt-calc = if gds-dtl.fact-qnty = 0 then 0 else slt-calc
     4872       vat-cost = if gds-dtl.fact-qnty = 0 then 0 else vat-cost
     4873       sj-goods.qnty = sj-goods.qnty + cur-quant
     4874       sj-goods.brutto-sum = sj-goods.brutto-sum + ( cur-quant * (if v-curr-r-b = 'rubl':U then gds-dtl.price-rubl else gds-dtl.price-base))
     4875       sj-goods.discnt-sum = sj-goods.discnt-sum + ( cur-discnt * cur-quant )
     4876       sj-goods.uchet-with-vat-sum = sj-goods.uchet-with-vat-sum + (if var-qnty = 0
     4877                                                                    then 0
     4878                                                                    else (varsum-dsc-r-b-acc / var-qnty) * cur-quant)
     4879       sj-goods.uchet-sum = sj-goods.uchet-sum + s-price * cur-quant
     4880       sj-goods.SLT-r-b = sj-goods.SLT-r-b + slt-calc
     4881       sj-goods.VAT-r-b = sj-goods.VAT-r-b + vat-cost
     4882       .
     4883     END.
     4884   END.
     4885   END PROCEDURE.
     4886   PROCEDURE disable_UI :
     4887     HIDE FRAME F-Main.
     4888     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     4889   END PROCEDURE.
     4890   PROCEDURE enable_UI :
     4891     DISPLAY Classify RS-Method RS-By T-neg
     4892         WITH FRAME F-Main.
     4893     ENABLE RECT-6 RECT-8 RECT-7 Classify RS-Method RS-By T-neg
     4894         WITH FRAME F-Main.
     4895   END PROCEDURE.
     4896   PROCEDURE Main_cycle :
     4897   define variable i as integer no-undo .
     4898   define variable tdoc-code     as      char    no-undo.
     4899   define variable real-code like clients.obj-code no-undo.
     4900   define variable real-type like clients.obj-type no-undo.
     4901   define variable doc-num like trn-doc.doc-code no-undo.
     4902   define variable is-out as integer init 1.
     4903   define variable offc as logical no-undo.
     4904   define variable v-host-code like sysconf.host-code no-undo.
     4905   define variable v-curr-r-b as character no-undo .
     4906   define variable vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     4907   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     4908     (output v-curr-r-b
     4909     )  .
     4910   define buffer buf_sysconf for ub.sysconf.
     4911   define buffer buf_sale-doc for ub.sale-doc.
     4912   define buffer b-tr-doc  for trn-doc .
     4913   FOR EACH sj-goods :
     4914       delete sj-goods .
     4915   END .
     4916   FOR EACH d-slt-vat :
     4917       delete d-slt-vat .
     4918   END .
     4919   _obj-list:
     4920   FOR EACH obj-list NO-LOCK:
     4921   define variable vss-include-info41 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4922   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     4923     (input  obj-list.obj-type
     4924     ,input  obj-list.obj-code
     4925     ,output v-host-code
     4926     )  .
     4927       FIND FIRST buf_sysconf NO-LOCK WHERE buf_sysconf.host-code = v-host-code.
     4928       IF AVAIL buf_sysconf then
     4929           assign
     4930               real-code = buf_sysconf.sale-code
     4931               real-type = buf_sysconf.sale-type
     4932           .
     4933       else NEXT _obj-list.
     4934       IF RS-by = 1 then do:
     4935           if x-tog-shift = no then do:
     4936               _inkas-with--FactDate:
     4937               FOR EACH inkas WHERE
     4938                   inkas.fact-date >= X-date-start and
     4939                   inkas.fact-date <= X-date-end AND
     4940                   inkas.obj-code = obj-list.obj-code and
     4941                   inkas.obj-type = obj-list.obj-type AND
     4942                   inkas.status_ = 'факт':U NO-LOCK,
     4943                   each buf_sale-doc  no-lock where
     4944                       buf_sale-doc.inkas-code = inkas.inkas-code
     4945                       and buf_sale-doc.in-inkas = yes,
     4946                       FIRST t-doc No-LOCK WHERE
     4947                           t-doc.doc-code = buf_sale-doc.doc-code:
     4948                   assign
     4949                       doc-num = t-doc.doc-code
     4950                       is-out = buf_sale-doc.dir
     4951                   .
     4952                   if t-doc.office and negparts then NEXT _inkas-with--FactDate.
     4953                   run cre-sj in this-procedure (
     4954                       input v-curr-r-b,
     4955                       input doc-num,
     4956                       input is-out,
     4957                       input t-doc.office)
     4958                   .
     4959                 END.
     4960           end.
     4961           else do:
     4962               _inkas-with--ShiftDate-or-Shift:
     4963               FOR EACH inkas WHERE
     4964                   inkas.shift-date >= X-date-start and
     4965                   inkas.shift-date <= X-date-end AND
     4966                   inkas.obj-code = obj-list.obj-code and
     4967                   inkas.obj-type = obj-list.obj-type AND
     4968                   inkas.status_ = 'факт':U NO-LOCK,
     4969                   each buf_sale-doc  no-lock where
     4970                       buf_sale-doc.inkas-code = inkas.inkas-code
     4971                   and buf_sale-doc.in-inkas = yes,
     4972                       FIRST t-doc No-LOCK WHERE
     4973                       t-doc.doc-code = buf_sale-doc.doc-code:
     4974                   if inkas.shift-date = x-date-start and inkas.shift-num < x-shift-start then next _inkas-with--ShiftDate-or-Shift.
     4975                   if inkas.shift-date = x-date-end and inkas.shift-num > x-shift-end then next _inkas-with--ShiftDate-or-Shift.
     4976                   assign
     4977                       doc-num = t-doc.doc-code
     4978                       is-out = buf_sale-doc.dir
     4979                   .
     4980                   if t-doc.office and negparts then NEXT _inkas-with--ShiftDate-or-Shift.
     4981                   run cre-sj in this-procedure (
     4982                       input v-curr-r-b,
     4983                       input doc-num,
     4984                       input is-out,
     4985                       input t-doc.office)
     4986                   .
     4987               END.
     4988           end.
     4989       END.
     4990       IF RS-by = 3 or RS-by = 4 then do:
     4991           if x-tog-shift = no then do:
     4992               _trn-doc:
     4993               FOR EACH t-doc NO-LOCK WHERE
     4994                   t-doc.obj-type = obj-list.obj-type AND
     4995                   t-doc.obj-code = obj-list.obj-code AND
     4996                   t-doc.ext-doc-type = 'es':U AND
     4997                   t-doc.status_ = 'факт':U AND
     4998                   t-doc.fact-date >= X-date-start AND
     4999                   t-doc.fact-date <= X-date-end:
     5000                       assign
     5001                           doc-num = t-doc.doc-code
     5002                           offc = t-doc.office
     5003                           is-out = 1
     5004                       .
     5005                       if offc and negparts then NEXT _trn-doc.
     5006                       run cre-sj in this-procedure (
     5007                           input v-curr-r-b,
     5008                           input doc-num,
     5009                           input is-out,
     5010                           input offc)
     5011                       .
     5012               END.
     5013           end.
     5014           else do:
     5015               _trn-doc--with--ShiftDate--or--Shift:
     5016               for each t-doc no-lock where
     5017                   t-doc.obj-type = obj-list.obj-type and
     5018                   t-doc.obj-code = obj-list.obj-code and
     5019                   t-doc.ext-doc-type = 'es':U and
     5020                   t-doc.status_ = 'факт':U and
     5021                   t-doc.shift-date >= X-date-start and
     5022                   t-doc.shift-date <= X-date-end:
     5023                       if t-doc.shift-date = x-date-start and t-doc.shift-num < x-shift-start then next _trn-doc--with--ShiftDate--or--Shift.
     5024                       if t-doc.shift-date = x-date-end and t-doc.shift-num > x-shift-end then next _trn-doc--with--ShiftDate--or--Shift.
     5025                       assign
     5026                           doc-num = t-doc.doc-code
     5027                           offc = t-doc.office
     5028                           is-out = 1.
