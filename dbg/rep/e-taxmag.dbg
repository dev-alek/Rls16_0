     6099                  string(  ( ACCUM TOTAL  by d-slt-vat.vat-pc d-slt-vat.VAT-r-b ) , "->>>,>>>,>>9.99" )   +  ":"
     6100                 )
     6101          AT 73 format "X(16)"
     6102          string (
