     2419   PROCEDURE CalcItog :
     2420       xTog-obj = false .
     2421       run factord-end-day (input zap-date, output fact-order-2 ).
     2422       fact-order-1 = 0 .
     2423   xTog-obj = xtogobj .
     2424   END PROCEDURE.
     2425   PROCEDURE ostatok :
     2426   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
     2427   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
     2428   def input parameter x-tog-shift   as   logical             no-undo.
     2429   def input parameter x-date-start  like ub.stk-tot.Fact-date   no-undo.
     2430   def input parameter x-date-end    like ub.stk-tot.Fact-date   no-undo.
     2431   def input parameter x-shift-start as integer               no-undo.
     2432   def input parameter x-shift-end   as integer               no-undo.
     2433   def input parameter x-sum-type    like ub.stk-tot.sum-type    no-undo.
     2434   def input parameter x-cat-id      like ub.stk-tot.cat-id      no-undo.
     2435   def input parameter xTog-obj   as log no-undo.
     2436   def output parameter Quantity    like ub.stk-tot.fact-qnty   no-undo.
     2437   def output parameter Coast_R     like ub.stk-tot.sum-rubl    no-undo.
     2438   def output parameter Coast_V     like ub.stk-tot.sum-rubl    no-undo.
     2439   def output parameter VAT_R       like ub.stk-tot.sum-rubl    no-undo.
     2440   def output parameter VAT_V       like ub.stk-tot.sum-rubl    no-undo.
     2441   def output parameter Fact-order  like ub.stk-tot.Fact-order  no-undo.
     2442   def var              Fact-order#   like ub.stk-tot.Fact-order  no-undo.
     2443   def var              Fact-orderS   as char  no-undo.
     2444   def var x-date-start-t  like ub.stk-tot.shift-date   no-undo.
     2445      Assign
     2446         Fact-order   = 0
     2447         Quantity     = 0
     2448         Coast_R      = 0
     2449         Coast_V      = 0
     2450         VAT_R        = 0
     2451         VAT_V        = 0 .
     2452    x-date-start-t  = x-date-start + 1 .
     2453   IF x-date-end = date('') then DO:
     2454      Fact-order = 0 .
     2455      for each obj-list
     2456          where  ( not xtog-obj or
     2457                 ( x-store-type = obj-list.obj-type and x-store-code = obj-list.obj-code ))
     2458                 no-lock :
     2459         if  x-tog-shift = false then do:
     2460                          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2461                               ub.stk-tot.Fact-date <=  x-date-start
     2462                               and ub.stk-tot.shift-num = 0
     2463                               USE-INDEX fact-date no-lock no-error .
     2464              if Available ub.stk-tot THEN  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2465         End.
     2466         Else  DO :
     2467             find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2468              (ub.stk-tot.shift-date  = x-date-start-t and
     2469               ub.stk-tot.shift-num  < x-shift-start or
     2470               ub.stk-tot.shift-date  < x-date-start-t  )
     2471               and ub.stk-tot.shift-num  > 0
     2472               USE-INDEX Shift-num no-lock no-error .
     2473            If Available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2474           END.
     2475       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     2476     End.
     2477   End.
     2478   Else DO:
     2479     For each obj-list  WHERE
     2480        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
     2481         no-lock :
     2482      IF  x-TOG-Shift = False Then DO:
     2483          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2484               ub.stk-tot.Fact-date <= x-date-end
     2485               and ub.stk-tot.shift-num = 0
     2486               USE-INDEX fact-date no-lock no-error.
     2487          if available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2488      END.
     2489      Else DO:
     2490           find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2491               (ub.stk-tot.shift-date  = x-date-end and
     2492               ub.stk-tot.shift-num  <= x-shift-end or
     2493               ub.stk-tot.shift-date  < x-date-end       ) and
     2494               ub.stk-tot.shift-num   > 0      use-index shift-num no-lock no-error.
     2495               if Available ub.stk-tot THEN Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2496       End.
     2497       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     2498     End.
     2499   End.
     2500   END PROCEDURE.
