     1147   procedure proc-alt-shift-f2:
     1148     if not ibs.th.gbl.gbl-var:rcode
     1149   then
     1150     run gbl\inidebug.p .
     1151   end.
     1152   procedure proc-alt-shift-f3:
     1153     run gbl/prvssinf.p
     1154       ( input this-procedure
     1155       ) .
     1156   end.
     1157   define variable v-inform-launched as logical no-undo initial false .
     1158   procedure proc-alt-shift-f4:
     1159     define variable v-action as character no-undo .
     1160     if v-inform-launched = false then do:
     1161       assign
     1162         v-inform-launched = true
     1163       .
     1164       run gbl/d-inform.w
     1165         (  input self
     1166         ,  input this-procedure
     1167         , output v-action
     1168         ) no-error .
     1169       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
     1170       assign
     1171         v-inform-launched = false
     1172       .
     1173     end.
     1174   end.
     1175   procedure proc-alt-f1:
     1176     run gbl/corrhelp.p
     1177       (input this-procedure
     1178       ) .
     1179   end .
