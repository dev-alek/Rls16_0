      313   define  input parameter x-store-type like ub.clients.obj-type   no-undo.
      314   define  input parameter x-base-type  like ub.currency.curr-abbr no-undo.
      315   define  input parameter x-base-code  like ub.currency.curr-code no-undo.
      316   define  input parameter x-Cli-art      as character no-undo .
      317   define  input parameter x-date1Rash    as date no-undo .
      318   define  input parameter x-date2Rash    as date no-undo .
      319   define  input parameter x-PostName     as character no-undo .
      320   define  input parameter x-RADIO-Anal   as logical no-undo .
      321   define  input parameter x-RADPost      as logical no-undo .
      322   define  input parameter x-Showcliprice  as logical no-undo .
      323   define  input parameter x-ShowParts     as logical no-undo .
      324   define  input parameter xClassify  as char no-undo.
      325   define  input parameter xSortType  as char no-undo.
      326   define  input parameter xSumsOnly  as log  no-undo.
      327   define  input parameter xShowZero  as log  no-undo.
      328   define  input parameter xTog-obj   as log no-undo.
      329   define  input parameter  xShowCost as log no-undo.
