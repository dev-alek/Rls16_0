     1441   procedure create-temp-t-post-stk-line :
     1442       define variable str  as char      format "X(60)" no-undo.
     1443       define variable str2 as char      no-undo.
     1444       define variable v-r  as character no-undo init "" .
     1445       define variable i#i  as int       no-undo.
     1446    do
     1447    on error undo, return error return-value
     1448    :
     1449    if available ub.goods and
     1450       available ub.clients and
     1451       available prod-cli then do:
     1452     create temp-t-post-stk-line .
     1453     BUFFER-COPY post-stk-line  TO temp-t-post-stk-line
     1454     assign
     1455       temp-t-post-stk-line.goods-grp-name    = ub.goods.grp-name
     1456       temp-t-post-stk-line.gds-code          = ub.goods.gds-code
     1457       temp-t-post-stk-line.unit-base         = ub.goods.unit-base
     1458       temp-t-post-stk-line.prt-root          = ub.goods.prt-root
     1459       temp-t-post-stk-line.gds-type          = ub.goods.gds-type
     1460       temp-t-post-stk-line.gds-name          = if g#gds-engl then ub.goods.engl-name else ub.goods.gds-name
     1461       temp-t-post-stk-line.clients-grp-name  = ub.clients.grp-name
     1462       temp-t-post-stk-line.clients-obj-name  = ub.clients.obj-name
     1463       temp-t-post-stk-line.prod-cli-obj-name = prod-cli.obj-name
     1464       temp-t-post-stk-line.prod-cli-obj-code = prod-cli.obj-code
     1465       temp-t-post-stk-line.prod-cli-obj-type = prod-cli.obj-type
     1466     .
     1467               if xlavel > 0 then
     1468               do:
     1469                   repeat i#i =1 to xlavel:
     1470                       if i#i =1 then str   = entry(1,ub.goods.grp-name, chr(47)) .
     1471                       else
     1472                       do:
     1473                           str2 = entry(i#i,ub.goods.grp-name, chr(47)) no-error.
     1474                           if not error-status:error  and str2 <> "":u then
     1475                               str = str +  chr(47) +  entry(i#i,ub.goods.grp-name, chr(47)) no-error .
     1476                       end.
     1477                   end.
     1478                   if str <> ? then
     1479                   do:
     1480                       temp-t-post-stk-line.goods-grp-name = str + chr(47) .
     1481                   end.
     1482               end.
     1483               else
     1484               do :
     1485                   temp-t-post-stk-line.goods-grp-name = ub.goods.grp-name.
     1486               end.
     1487           end.
     1488    end.
     1489   end procedure.
     1490   function excel-format-dec-to-char returns char (input p-dec as decimal ).
     1491     if num-entries(string(p-dec), '.') = 2
     1492       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
     1493       else return( string(p-dec)) .
     1494   end function.
     1495   function format-point-to-comma returns char (input orig as char ) .
     1496   define variable rtext as character no-undo .
     1497   define variable strt as integer no-undo .
     1498   define variable leng as integer no-undo .
     1499   assign rtext = orig .
     1500   repeat:
     1501     strt =  index(rtext,'.').
     1502     if strt = 0 then leave.
     1503     leng = 1.
     1504     substring(rtext,strt,leng,"character") = v-delim .
     1505   end.
     1506   return rtext.
     1507   end function.
     1508   function format-excel-text returns char ( input start-text as char ) :
     1509   def var  i    as int no-undo.
     1510   def var  ch   as char no-undo.
     1511   def var  n    as int no-undo.
     1512   def var  ipos as int no-undo.
     1513     n = num-entries(trim(start-text), chr(10)) - 1 .
     1514     do i = 1 to n :
     1515       ipos = index( start-text, chr(10)).
     1516       if ipos > 0 then
     1517         substr( start-text, ipos, 1 ) = ' '.
     1518     end.
     1519     n = num-entries(trim(start-text), chr(13)) - 1 .
     1520     do i = 1 to n :
     1521       ipos = index( start-text, chr(13)).
     1522       if ipos > 0 then
     1523         substr( start-text, ipos, 1 ) = ' '.
     1524     end.
     1525     if index( start-text, '"' ) = 0 then
     1526       start-text =  '="'   + trim( start-text) + '"'   .
     1527       else do:
     1528         n = num-entries(trim(start-text), '"') - 1.
     1529         do i = 1 to n :
     1530           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1531         end.
     1532         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1533         start-text = '="'  + ch  + '"' .
     1534       end.
     1535     return start-text.
     1536   end.
     1537   function excel-sum returns char (input p-dec as decimal ).
     1538     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
     1539   end function.
     1540   function excel-qnty returns char (input p-dec as decimal ).
     1541     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
     1542   end function.
     1543   function format-excel-text-macr returns char ( input start-text as char ) :
     1544   def var  i    as int no-undo.
     1545   def var  ch   as char no-undo.
     1546   def var  n    as int no-undo.
     1547   def var  ipos as int no-undo.
     1548     n = num-entries(trim(start-text), chr(10)) - 1 .
     1549     do i = 1 to n :
     1550       ipos = index( start-text, chr(10)).
     1551       if ipos > 0 then
     1552         substring( start-text, ipos , 1 ) = ' '.
     1553     end.
     1554     n = num-entries(trim(start-text), chr(13)) - 1 .
     1555     do i = 1 to n :
     1556       ipos = index( start-text, chr(13)).
     1557       if ipos > 0 then
     1558         substring( start-text, ipos, 1 ) = ' '.
     1559     end.
     1560     if index( start-text, '"' ) = 0 then
     1561       start-text =  '"'   + trim( start-text) + '"'   .
     1562       else do:
     1563         n = num-entries(trim(start-text), '"') - 1.
     1564         do i = 1 to n :
     1565           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1566         end.
     1567         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1568         start-text = '"'  + ch  + '"' .
     1569       end.
     1570     n = num-entries(trim(start-text), chr(10)) - 1 .
     1571     do i = 1 to n :
     1572       ipos = index( start-text, chr(10)).
     1573       if ipos > 0 then
     1574         substring( start-text, ipos , 1 ) = ' '.
     1575     end.
     1576       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
     1577     return start-text.
     1578   end.
     1579   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1580   procedure factord :
     1581     define input  parameter p-fact-date            as date    no-undo .
     1582     define input  parameter p-fact-time            as integer no-undo .
     1583     define input  parameter p-fact-num             as integer no-undo .
     1584     define input  parameter p-shift-date           as date    no-undo .
     1585     define input  parameter p-shift-num            as integer no-undo .
     1586     define input  parameter p-shift-on             as logical no-undo .
     1587     define output parameter p-fact-order           as decimal no-undo .
     1588     define output parameter p-shift-end-fact-order as decimal no-undo .
     1589     define output parameter p-day-end-fact-order   as decimal no-undo .
     1590     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     1591     if p-fact-date = ?
     1592     then do:
     1593       return error "Не указана фактическая дата" .
     1594     end.
     1595     define variable v-fact-date-num as integer no-undo .
     1596     assign
     1597       v-fact-date-num = integer(p-fact-date)
     1598     .
     1599     if p-fact-num = ?
     1600     or p-fact-num = 0
     1601     then do:
     1602       return error "Не задан p-fact-num " + string(p-fact-num) .
     1603     end.
     1604     if p-fact-num < 0
     1605     then do:
     1606       return error "Отрицательный fact-num " + string(p-fact-num) .
     1607     end.
     1608     if p-fact-num >= 100000000
     1609     then do:
     1610       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     1611     end.
     1612     if p-shift-on = true
     1613     then do:
     1614       if p-shift-date = ?
     1615       then do:
     1616         return error "Не задана дата смены" .
     1617       end.
     1618       if p-shift-num = ?
     1619       or p-shift-num = 0
     1620       then do:
     1621         return error "Не задан номер смены" .
     1622       end.
     1623     end.
     1624     else do:
     1625       assign
     1626         p-shift-date = p-fact-date
     1627         p-shift-num  = 24
     1628       .
     1629     end.
     1630     define variable v-shift-offset as integer no-undo .
     1631     if p-shift-date = p-fact-date
     1632     then do:
     1633       assign
     1634         v-shift-offset = 1
     1635       .
     1636     end.
     1637     if p-shift-date < p-fact-date
     1638     then do:
     1639       assign
     1640         v-shift-offset = 0
     1641       .
     1642     end.
     1643     if p-shift-date > p-fact-date
     1644     then do:
     1645       message
     1646         vss-workfile vss-revision vss-description skip
     1647         "Неправильная дата закрытия смены" skip
     1648         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     1649         view-as alert-box error .
     1650       undo, return error
     1651         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     1652           ,string(p-fact-date, '99/99/9999':U)
     1653           ,string(p-shift-date, '99/99/9999':U)
     1654           )
     1655       .
     1656     end.
     1657     if p-shift-num < 1
     1658     or p-shift-num > 24
     1659     then do:
     1660       message
     1661         vss-workfile vss-revision vss-description skip
     1662         "Неправильный номер смены" skip
     1663         "p-shift-num" p-shift-num skip
     1664         view-as alert-box error .
     1665       undo, return error return-value .
     1666     end.
     1667     assign
     1668       p-fact-order           = v-fact-date-num
     1669                              + v-shift-offset * 0.5
     1670                              + p-shift-num    * 0.02 - 0.01
     1671                              + p-fact-num     * 0.0000000001
     1672       p-shift-end-fact-order = v-fact-date-num
     1673                              + v-shift-offset * 0.5
     1674                              + p-shift-num    * 0.02
     1675       p-day-end-fact-order   = v-fact-date-num
     1676                              + 0.99
     1677     .
     1678     if p-fact-order           <= v-fact-date-num
     1679     or p-shift-end-fact-order <= v-fact-date-num
     1680     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     1681     or p-shift-end-fact-order >= p-day-end-fact-order
     1682     then do:
     1683       message
     1684         vss-workfile vss-revision vss-description skip
     1685         "Внутренняя ошибка при генерации фактического номера" skip
     1686         "p-fact-date"            p-fact-date            skip
     1687         "p-fact-time"            p-fact-time            skip
     1688         "p-fact-num"             p-fact-num             skip
     1689         "p-shift-date"           p-shift-date           skip
     1690         "p-shift-num"            p-shift-num            skip
     1691         "p-shift-on"             p-shift-on             skip
     1692         "p-shift-end-fact-order" p-shift-end-fact-order skip
     1693         "p-day-end-fact-order"   p-day-end-fact-order   skip
     1694         "v-fact-date-num"        v-fact-date-num        skip
     1695         view-as alert-box error .
     1696       undo, return error return-value .
     1697     end.
     1698   end procedure.
     1699   procedure day-begin-fact-order :
     1700     define input  parameter p-fact-date            as date    no-undo .
     1701     define output parameter p-day-begin-fact-order as decimal no-undo .
     1702     do
     1703     on error undo, return error return-value
     1704     :
     1705       if p-fact-date = ?
     1706       then do:
     1707         assign
     1708           p-day-begin-fact-order = 0
     1709         .
     1710       end.
     1711       else do:
     1712         assign
     1713           p-day-begin-fact-order = integer(p-fact-date)
     1714         .
     1715       end.
     1716     end.
     1717   end procedure.
     1718   procedure factord-max-fact-order :
     1719     define output parameter p-max-fact-order as decimal   no-undo .
     1720     do
     1721     on error undo, return error return-value
     1722     :
     1723       run day-begin-fact-order in this-procedure
     1724         (input  date(1, 1, 5000)
     1725         ,output p-max-fact-order
     1726         ) .
     1727     end.
     1728   end procedure.
     1729   procedure factord-cut-archive :
     1730     define input  parameter p-obj-type             as character no-undo .
     1731     define input  parameter p-obj-code             as integer   no-undo .
     1732     define input  parameter p-fact-date            as date      no-undo .
     1733     define output parameter p-shift-on             as logical   no-undo .
     1734     define output parameter p-shift-date           as date      no-undo .
     1735     define output parameter p-shift-num            as integer   no-undo .
     1736     define output parameter p-day-end-fact-order   as decimal   no-undo .
     1737     define output parameter p-shift-end-fact-order as decimal   no-undo .
     1738     define variable v-fact-order as decimal   no-undo .
     1739     define buffer buf_shift-obj for ub.shift-obj .
     1740     do
     1741     on error undo, return error return-value
     1742     :
     1743   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1744   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1745     (input  p-obj-type
     1746     ,input  p-obj-code
     1747     ,input  'shift-on=request'
     1748     ,output p-shift-on
     1749     ) no-error .
     1750       if error-status :error
     1751       then do:
     1752         message
     1753           vss-workfile vss-revision vss-description skip
     1754           "Ошибка при определении атрибута объекта" skip
     1755           "Объект" p-obj-type p-obj-code skip
     1756           error-status :get-message(1) skip
     1757           return-value skip
     1758           view-as alert-box error .
     1759         undo, return error return-value .
     1760       end.
     1761       if p-shift-on = false
     1762       then do:
     1763         assign
     1764           p-shift-date               = ?
     1765           p-shift-num                = 0
     1766         .
     1767       end.
     1768       else do:
     1769         find first buf_shift-obj share-lock
     1770           where buf_shift-obj.obj-type   = p-obj-type
     1771             and buf_shift-obj.obj-code   = p-obj-code
     1772             and buf_shift-obj.shift-date > p-fact-date
     1773           use-index pi
     1774           no-error .
     1775         if not available buf_shift-obj
     1776         or buf_shift-obj.status_ <> 'зкр':U
     1777         then do:
     1778           message
     1779             vss-workfile vss-revision vss-description skip
     1780             "Невозможно вычислить последнюю смену" skip
     1781             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1782             "Объект" p-obj-type p-obj-code skip
     1783             "Дата" p-fact-date skip
     1784             view-as alert-box error .
     1785           undo, return error return-value .
     1786         end.
     1787         find last buf_shift-obj share-lock
     1788           where buf_shift-obj.obj-type = p-obj-type
     1789             and buf_shift-obj.obj-code = p-obj-code
     1790             and buf_shift-obj.shift-date <= p-fact-date
     1791           use-index pi
     1792           no-error .
     1793         if available buf_shift-obj
     1794         then do:
     1795           if  buf_shift-obj.status_ = 'зкр':U
     1796           then do:
     1797             assign
     1798               p-shift-date = buf_shift-obj.shift-date
     1799               p-shift-num  = buf_shift-obj.shift-num
     1800             .
     1801           end.
     1802           else do:
     1803             message
     1804               vss-workfile vss-revision vss-description skip
     1805               "Невозможно вычислить последнюю смену" skip
     1806               "Статус смены отличен от статуса" 'зкр':U skip
     1807               "Объект" p-obj-type p-obj-code skip
     1808               "Дата" p-fact-date skip
     1809               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1810               view-as alert-box error .
     1811             undo, return error return-value .
     1812           end.
     1813         end.
     1814         else do:
     1815           assign
     1816             p-shift-date = p-fact-date - 1
     1817             p-shift-num  = 1
     1818           .
     1819         end.
     1820       end.
     1821       run factord in this-procedure
     1822         (input  p-fact-date
     1823         ,input  1
     1824         ,input  1
     1825         ,input  p-shift-date
     1826         ,input  p-shift-num
     1827         ,input  p-shift-on
     1828         ,output v-fact-order
     1829         ,output p-shift-end-fact-order
     1830         ,output p-day-end-fact-order
     1831         ) no-error .
     1832       if error-status :error
     1833       then do:
     1834         message
     1835           vss-workfile vss-revision vss-description skip
     1836           "Ошибка при вызове процедуры factord"
     1837           error-status :get-message(1) skip
     1838           return-value skip
     1839           view-as alert-box error .
     1840         undo, return error return-value .
     1841       end.
     1842     end.
     1843   end procedure.
     1844   procedure factord-lock-shift :
     1845     define input  parameter p-obj-type  as character no-undo .
     1846     define input  parameter p-obj-code  as integer   no-undo .
     1847     define input  parameter p-fact-date as date      no-undo .
     1848     define parameter buffer buf_shift-obj for ub.shift-obj .
     1849     define variable v-shift-on      as logical   no-undo .
     1850     define variable v-extra-message as character no-undo .
     1851     define variable v-error as character no-undo .
     1852     do
     1853     on error undo, return error return-value
     1854     :
     1855   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1856   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1857     (input  p-obj-type
     1858     ,input  p-obj-code
     1859     ,input  'shift-on=request'
     1860     ,output v-shift-on
     1861     ) no-error .
     1862       if error-status :error
     1863       then do:
     1864         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1865         undo, return error v-error .
     1866       end.
     1867       if v-shift-on = true
     1868       then do:
     1869         find first buf_shift-obj share-lock
     1870           where buf_shift-obj.obj-type   = p-obj-type
     1871             and buf_shift-obj.obj-code   = p-obj-code
     1872             and buf_shift-obj.shift-date > p-fact-date
     1873           use-index pi
     1874           no-error .
     1875         if not available buf_shift-obj
     1876         or buf_shift-obj.status_ <> 'зкр':U
     1877         then do:
     1878           find last buf_shift-obj
     1879             where buf_shift-obj.obj-type = p-obj-type
     1880               and buf_shift-obj.obj-code = p-obj-code
     1881               and buf_shift-obj.status_  = 'зкр':U
     1882             use-index stts
     1883             no-error .
     1884           if available buf_shift-obj
     1885           then do:
     1886             assign
     1887               v-extra-message =
     1888                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1889                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1890                               )
     1891             .
     1892           end.
     1893           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1894           undo, return error v-error .
     1895         end.
     1896       end.
     1897     end.
     1898   end procedure.
     1899   procedure factord-end-day :
     1900     define input  parameter p-fact-date            as date    no-undo .
     1901     define output parameter p-day-end-fact-order   as decimal no-undo .
     1902     do
     1903     on error undo, return error return-value
     1904     :
     1905       if p-fact-date = ?
     1906       then do:
     1907         return error "Не указана фактическая дата" .
     1908       end.
     1909       assign
     1910         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1911       .
     1912     end.
     1913   end procedure.
     1914   procedure factord-to-date :
     1915     define input  parameter p-fact-order as decimal no-undo .
     1916     define output parameter p-fact-date  as date    no-undo .
     1917     define variable v-ref-date  as date      no-undo .
     1918     define variable v-ref-delta as integer   no-undo .
     1919     do
     1920     on error undo, return error return-value
     1921     :
     1922       if p-fact-order = ?
     1923       or p-fact-order = 0
     1924       then do:
     1925         return error "Не указан fact-order" .
     1926       end.
     1927       assign
     1928         v-ref-date  = date(1, 1, 2000)
     1929       .
     1930       assign
     1931         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1932       .
     1933       assign
     1934         p-fact-date = v-ref-date + v-ref-delta
     1935       .
     1936     end.
     1937   end procedure.
     1938   procedure factord-to-fact-num :
     1939     define input  parameter p-fact-order as decimal no-undo .
     1940     define output parameter p-fact-num   as integer no-undo .
     1941     define variable v-fact-order-trunc as decimal no-undo .
     1942     do
     1943     on error undo, return error return-value
     1944     :
     1945       if p-fact-order = ?
     1946       or p-fact-order = 0
     1947       then do:
     1948         return error "Не указан fact-order" .
     1949       end.
     1950       assign
     1951        v-fact-order-trunc = truncate(p-fact-order, 2)
     1952       .
     1953       assign
     1954         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1955       .
     1956     end.
     1957   end procedure.
     1958   procedure factord-to-shift-num :
     1959     define input  parameter p-fact-order as decimal no-undo .
     1960     define output parameter p-shift-num   as integer no-undo .
     1961     define variable  p-shift-numd  as decimal   no-undo .
     1962     define variable v-fact-order-trunc as decimal no-undo .
     1963     do
     1964     on error undo, return error return-value
     1965     :
     1966       if p-fact-order = ?
     1967       or p-fact-order = 0
     1968       then do:
     1969         return error "Не указан fact-order" .
     1970       end.
     1971       assign
     1972        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1973       .
     1974       if v-fact-order-trunc < 0.5 then do:
     1975         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1976       end.
     1977       assign
     1978         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1979         .
     1980        assign
     1981         p-shift-num = truncate (p-shift-numd , 0)
     1982       .
     1983     end.
     1984   end procedure.
     1985   define temp-table temp-font no-undo
     1986     field fontnum  as integer
     1987     field fontname as character
     1988     field fontsize as character
     1989     field fonttype as character
     1990     field font-h   as integer
     1991     field font-w   as integer
     1992     field v-row    as integer
     1993     field v-col    as integer
     1994     field v-row-lans as integer
     1995     field v-col-lans as integer
     1996   index pi fontnum
     1997   .
     1998   procedure get-font-ini :
     1999     do
     2000     on error undo, return error return-value
     2001     :
     2002   define variable ii as integer   no-undo .
     2003   define variable v-font7 as character no-undo .
     2004   define variable v-font as character no-undo .
     2005   define variable loc-name as character no-undo .
     2006   define variable loc-size as character no-undo .
     2007   define variable loc-type as character no-undo .
     2008   define variable old_H as integer   no-undo .
     2009   define variable old_w as integer   no-undo .
     2010   define variable old-row  as integer   no-undo .
     2011   define variable old-col  as integer   no-undo .
     2012   define variable old-row-lans  as integer   no-undo .
     2013   define variable old-col-lans  as integer   no-undo .
     2014   define variable vv as integer   no-undo .
     2015   empty temp-table temp-font.
     2016     GET-KEY-VALUE SECTION "fonts" KEY "font7" VALUE v-font7 .
     2017       case num-entries (v-font7) :
     2018         when 4 then do:
     2019             assign
     2020               loc-name = entry ( 1 , v-font7 )
     2021               loc-size = entry ( 2 , v-font7 )
     2022               loc-type = entry ( 3 , v-font7 ) + "," +  entry ( 4 , v-font7 )
     2023             .
     2024         end.
     2025         when 3 then do:
     2026             assign
     2027               loc-name = entry ( 1 , v-font7 )
     2028               loc-size = entry ( 2 , v-font7 )
     2029               loc-type = entry ( 3 , v-font7 )
     2030             .
     2031         end.
     2032         when 2 then  do:
     2033             assign
     2034               loc-name = entry ( 1 , v-font7 )
     2035               loc-size = entry ( 2 , v-font7 )
     2036               loc-type = ""
     2037             .
     2038         end.
     2039         when 1 then do:
     2040             assign
     2041               loc-name = trim(entry ( 1 , v-font7 ))
     2042               loc-size = ""
     2043               loc-type = ""
     2044             .
     2045         end.
     2046       end case.
     2047     create temp-font.
     2048     assign
     2049       temp-font.fontnum  = 7
     2050       temp-font.fontname = trim(loc-name)
     2051       temp-font.fontsize = trim(loc-size)
     2052       temp-font.fonttype = trim(loc-type)
     2053       temp-font.v-row    = 62
     2054       temp-font.v-col    = 136
     2055       temp-font.v-row-lans = 43
     2056       temp-font.v-col-lans = 198
     2057     .
     2058     repeat ii = 16 to 100 :
     2059       get-key-value section 'fonts' key 'font' + string(ii)   value v-font  .
     2060       if v-font = "" or v-font = ? then leave.
     2061       case num-entries (v-font) :
     2062         when 4 then do:
     2063             assign
     2064               loc-name = entry ( 1 , v-font )
     2065               loc-size = entry ( 2 , v-font )
     2066               loc-type = entry ( 3 , v-font ) + "," +  entry ( 4 , v-font )
     2067             .
     2068         end.
     2069         when 3 then do:
     2070             assign
     2071               loc-name = entry ( 1 , v-font )
     2072               loc-size = entry ( 2 , v-font )
     2073               loc-type = entry ( 3 , v-font )
     2074             .
     2075         end.
     2076         when 2 then do:
     2077             assign
     2078               loc-name = entry ( 1 , v-font )
     2079               loc-size = entry ( 2 , v-font )
     2080               loc-type = ""
     2081             .
     2082         end.
     2083         when 1 then do:
     2084             assign
     2085               loc-name = trim(entry ( 1 , v-font ))
     2086               loc-size = ""
     2087               loc-type = ""
     2088             .
     2089         end.
     2090       end case.
     2091     create temp-font.
     2092     assign
     2093       temp-font.fontnum  = ii
     2094       temp-font.fontname = trim(loc-name)
     2095       temp-font.fontsize = trim(loc-size)
     2096       temp-font.fonttype = trim(loc-type)
     2097     .
     2098     end.
     2099       for each temp-font :
     2100          vv = integer(entry(2,temp-font.fontsize, "=" )) no-error .
     2101          if  vv = ? then vv =  0 .
     2102           run rep/exfont.p (
     2103             input   temp-font.fontname ,
     2104             input   vv ,
     2105             input   temp-font.fonttype ,
     2106             output  temp-font.font-h   ,
     2107             output  temp-font.font-w   )
     2108           .
     2109       end.
     2110   find first temp-font where  temp-font.fontnum  = 7  .
     2111   old_H = temp-font.font-H .
     2112   old_w = temp-font.font-W .
     2113   old-row = temp-font.v-row .
     2114   old-col = temp-font.v-col .
     2115   old-row-lans = temp-font.v-row-lans .
     2116   old-col-lans = temp-font.v-col-lans .
     2117       for each temp-font where
     2118                temp-font.fontnum  <> 7 :
     2119           assign
     2120               temp-font.v-row    = old_H * old-row / temp-font.font-h
     2121               temp-font.v-col    = old_W * old-col / temp-font.font-W
     2122               temp-font.v-row-lans    = old_H * old-row-lans / temp-font.font-h
     2123               temp-font.v-col-lans    = old_W * old-col-lans / temp-font.font-W
     2124           .
     2125       end.
     2126     end.
     2127   end procedure.
     2128   PROCEDURE How-name :
     2129   define input  parameter h as integer no-undo .
     2130   define input  parameter w as integer no-undo .
     2131   define output parameter n as character  no-undo .
     2132   define variable A4port-H as integer   no-undo init 63.
     2133   define variable A4port-W as integer   no-undo init 136.
     2134   define variable A4lans-H as integer   no-undo init 43.
     2135   define variable A4lans-W as integer   no-undo init 198.
     2136   define variable Strim-W  as integer   no-undo init 278.
     2137   run define-a4-size (
     2138        input ReportFontNum
     2139       ,output A4port-H
     2140       ,output A4port-W
     2141       ,output A4lans-H
     2142       ,output A4lans-W ).
     2143   If w >= 1 and w <= A4port-W Then DO:
     2144     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     2145     If h > A4lans-H  and h <= A4port-H Then n = "A4-port":U.
     2146     If h > A4port-H              Then n = "to-file":U.
     2147   End.
     2148   If w > A4port-W and w <= A4lans-W Then DO:
     2149     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     2150     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     2151     If h > A4port-H              Then n = "to-file":U.
     2152   End.
     2153   If w > A4lans-W and w <= Strim-W Then DO:
     2154     If h >= 1  and h <= A4lans-H Then n = "to-file":U.
     2155     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     2156     If h > A4port-H              Then n = "to-file":U.
     2157   End.
     2158   If w > Strim-W Then DO:
     2159      n = "to-file":U.
     2160   End.
     2161   END PROCEDURE.
     2162   PROCEDURE define-a4-size :
     2163   define input  parameter p-ReportFontNum as integer   no-undo .
     2164   define output parameter A4port-H as integer   no-undo .
     2165   define output parameter A4port-W as integer   no-undo .
     2166   define output parameter A4lans-H as integer   no-undo .
     2167   define output parameter A4lans-W as integer   no-undo .
     2168   if not can-find (first temp-font ) then do:
     2169      run get-font-ini .
     2170   end.
     2171   find first temp-font where temp-font.fontnum = p-ReportFontNum no-error .
     2172   if available temp-font then do:
     2173   assign
     2174     A4port-H = temp-font.v-row
     2175     A4port-W = temp-font.v-col
     2176     A4lans-H = temp-font.v-row-lans
     2177     A4lans-W = temp-font.v-col-lans
     2178   .
     2179   end.
     2180   else do:
     2181   assign
     2182     A4port-H = 63
     2183     A4port-W = 136
     2184     A4lans-H = 43
     2185     A4lans-W = 198
     2186   .
     2187   end.
     2188   END PROCEDURE.
     2189   define variable  zap-date   as date no-undo.
     2190   define variable    ChosedType        as   integer no-undo.
     2191   define variable    ValType           as   integer no-undo.
     2192   define variable    FirstLine         as  logical  no-undo.
     2193   define variable break_group as logical no-undo init true.
     2194   define variable break_group1 as logical no-undo init true.
     2195   define variable v-file-name as char.
     2196   define variable stat     as log no-undo .
     2197   define variable InpError as log no-undo .
     2198   define variable rid-list as character no-undo .
     2199   define variable  Quantity1      like ub.stk-tot.fact-qnty  no-undo.
     2200   define variable  Coast_R1       like ub.stk-tot.sum-rubl   no-undo.
     2201   define variable  Coast_V1       like ub.stk-tot.sum-rubl   no-undo.
     2202   define variable  VAT_R1         like ub.stk-tot.sum-rubl   no-undo.
     2203   define variable  VAT_V1         like ub.stk-tot.sum-rubl   no-undo.
     2204   define variable  Quantity2      like ub.stk-tot.fact-qnty  no-undo.
     2205   define variable  Coast2         like ub.stk-tot.sum-rubl   no-undo.
     2206   define variable  Coast_R2       like ub.stk-tot.sum-rubl   no-undo.
     2207   define variable  Coast_V2       like ub.stk-tot.sum-rubl   no-undo.
     2208   define variable  VAT_R2         like ub.stk-tot.sum-rubl   no-undo.
     2209   define variable  VAT_V2         like ub.stk-tot.sum-rubl   no-undo.
     2210      FIND First ub.clients where x-store-type = ub.clients.obj-type AND
     2211               x-store-code = ub.clients.obj-code no-lock no-error.
     2212              If available ub.clients then  ObjName = ub.clients.obj-name.
     2213                                            else  ObjName="объект не определен".
     2214        assign
     2215           i = 0
     2216           zap-date      = x-Date-Alone
     2217           Select-Good   = x-SelectGood
     2218           PayType       = x-SET_PAY_TYPE
     2219           RetClassify   = xClassify
     2220           RetSortType   = xSortType
     2221           Sums-Only     = xSumsOnly
     2222           Show-Negativ  = xShowZero
     2223           x-date-start  =  x-Date-Alone
     2224           x-date-end    =  x-Date-Alone
     2225           type-stor     =  xtype-stor
     2226           xtogobj = xtog-obj
     2227           ValType       = IF (PayType = 1) Then 0  else x-SET_val_TYPE.
     2228   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2229   case x-set_pay_type :
     2230     when 1 then do:
     2231           tprintrubl = ( var-report-r-b = 'rubl':U ) .
     2232     end.
     2233     when 2 or when 3 then do:
     2234           if x-set_val_type = 1  then tprintrubl = yes .
     2235           if x-set_val_type = 2  then tprintrubl = no  .
     2236     end.
     2237   end case.
     2238   xLavel = 0.
     2239   if  xtog-lavel    then  xLavel        =  xvar-lavel .
     2240   if  xtog-lavel-2  then  xLavel        =  xvar-lavel-2 .
     2241      os-delete value(string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".t-t")   .
     2242   Run report-execute.
     2243   PROCEDURE report-execute :
     2244     Run CalcItog.
     2245     RUN waitfram-show( 'Подождите ...' ) .
     2246     if ReportPageHeight = 0 then ReportPageHeight  = 43.
     2247   output stream OutStream to value( string( session:temp-directory +
     2248                                        "rpt" + string( g#report-num ) ) )
     2249                                        page-size  value(ReportPageHeight) .
     2250     FORM with FRAME zapas .
     2251     Line = fill("-", 189).
     2252   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2253   form header
     2254     line format "X(189)" at 1 skip
     2255     "Продолжение - на следующей странице" at 30 skip
     2256     with frame bottomframe width 232 page-bottom no-labels no-box .
     2257   view stream outstream frame bottomframe .
     2258     Run Print-Header.
     2259     run rep/extitle.p (1) .
     2260     case RetSortType :
     2261         when "sort-code":U then do:
     2262           if not can-find(first g#post no-lock)
     2263             Then   run rep/r-zps-1.p (x-store-code,x-store-type,x-base-type ,x-base-code ).
     2264             Else   run rep/r-zps-2.p (x-store-code,x-store-type,x-base-type ,x-base-code ).
     2265         end.
     2266         when "sort-article":U then do:
     2267           if not can-find(first g#post no-lock)
     2268             Then   run rep/r-zps-3.p (x-store-code,x-store-type,x-base-type ,x-base-code ).
     2269             Else   run rep/r-zps-4.p (x-store-code,x-store-type,x-base-type ,x-base-code ).
     2270         end.
     2271         when "sort-name":U then do:
     2272           if not can-find(first g#post no-lock)
     2273             Then   run rep/r-zps-5.p (x-store-code,x-store-type,x-base-type ,x-base-code ).
     2274             Else   run rep/r-zps-6.p (x-store-code,x-store-type,x-base-type ,x-base-code ).
     2275         end.
     2276     end case.
     2277     HIDE stream OutStream FRAME BottomFrame .
     2278     Run Print-footer.
     2279     HIDE STREAM OutStream FRAME ZAPAS .
     2280     Output stream OutStream close.
     2281     if Make-Excel then output stream ForExcel close.
     2282     RUN waitfram-hide .
     2283     define variable v-user-action as character no-undo .
     2284     define variable v-printed as logical   no-undo .
     2285     define variable DisabledOptions as integer   no-undo .
     2286     define variable v-orient-page as character no-undo .
     2287     run How-name in this-procedure (
     2288         input ReportPageHeight,
     2289         input ReportPageWidth,
     2290         output v-orient-page )
     2291         .
     2292     if v-orient-page = "A4-lans":U then DisabledOptions = 8 .
     2293                                    else DisabledOptions = 0 .
     2294     run gbl/prnfilen.w
     2295       (input  ""
     2296       ,input  DisabledOptions
     2297       ,input  string(session :temp-directory) + "rpt" + string( g#report-num  )
     2298       ,input  ReportFontNum
     2299       ,output v-user-action
     2300       ,output v-printed
     2301       ) .
     2302   END PROCEDURE.
     2303   PROCEDURE print-header :
     2304      PUT stream OutStream  string( v-cntxt-host-name-obj +  " , " + x-store-type  +  " " + ObjName)
     2305          AT 50 format "X(85)" SKIP(2)
     2306             "С О С Т О Я Н И Е    З А П А С А    на  "
     2307                   AT 35  format "X(41)"   zap-date format "99.99.9999" SKIP(2)
     2308               Trim(str3)  AT 35 format "X(75)" SKIP(1) .
     2309        PUT stream OutStream str2 AT 35 format "x(200)"  SKIP.
     2310        Repeat i = 1 to NUM-ENTRIES(str4,chr(10)) :
     2311          PUT stream OutStream  Entry(i,str4,chr(10))  AT 1 format "X(170)" SKIP.
     2312        End.
     2313        Repeat i = 1 to NUM-ENTRIES(ReportHeader,chr(10)) :
     2314          PUT stream OutStream  Entry(i,ReportHeader,chr(10))  AT 1 format "X(170)" SKIP.
     2315        End.
     2316        i=0.
     2317         FirstLine = TRUE .
     2318          FORM with FRAME zapas .
     2319          DOWN stream  OutStream 1 with FRAME zapas.
     2320      Assign
     2321         Tot-1=0   Tot-1-1=0  Tot-2-1=0
     2322         Tot-2=0   Tot-1-2=0  Tot-2-2=0
     2323         Tot-3=0   Tot-1-3=0  Tot-2-3=0
     2324         Tot-4=0   Tot-1-4=0  Tot-2-4=0
     2325         Tot-5=0   Tot-1-5=0  Tot-2-5=0
     2326         .
     2327      END PROCEDURE.
     2328   PROCEDURE Print-Footer :
     2329         If RetClassify = "no-classify":U  then Run U-line.
     2330         DISPLAY stream  OutStream
     2331                         sym1
     2332                       " ИТОГО" @ gds-zap-b-code
     2333                         sym4
     2334                         sym5
     2335                         Tot-1  @ gds-zap-qnty
     2336                         sym6
     2337                         Tot-2  @ gds-zap-stoim-base
     2338                         sym7
     2339                         sym8
     2340                         Tot-4  @ gds-zap-nds
     2341                         sym9
     2342                         Tot-5  @ gds-zap-nP
     2343                         sym10
     2344                         Tot-3  @ tot_tqnty
     2345                         sym11
     2346                         sym12
     2347                         with FRAME zapas.
     2348         DOWN stream  OutStream 1 with FRAME zapas.
     2349         if Make-Excel then  put   stream ForExcel unformatted
     2350             " ИТОГО" CHR(9) CHR(9) CHR(9)  CHR(9)  CHR(9)
     2351               excel-qnty(Tot-1)  CHR(9) CHR(9)
     2352               excel-sum(Tot-2)  CHR(9)
     2353               excel-sum(Tot-4)  CHR(9)
     2354               excel-sum(Tot-5)  CHR(9)
     2355               excel-sum(Tot-3)  skip.
     2356         Run U-line.
     2357         Put stream  OutStream UNFORMATTED
     2358           "Итого "
     2359           Tot-1
     2360           " единиц , "
     2361            string(i)
     2362             " наименований,"
     2363            " на сумму "
     2364           trim( string(tot-2,"->>>>>>>>>>>>9.99"))
     2365            "(" + (if tPrintRubl then "РУБ" else x-base-type ) + ")" skip.
     2366          END PROCEDURE.
     2367   PROCEDURE U-LINE :
     2368   UNDERLINE stream OutStream
     2369           sym1
     2370           gds-zap-b-code
     2371           sym2
     2372           gds-zap-artic
     2373           sym3
     2374           gds-post-artic
     2375           sym12
