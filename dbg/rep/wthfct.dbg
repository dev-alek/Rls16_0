     1347               .
     1348           end.
     1349           if lookup( p-form-name, v-outprops   ) <> 0
     1350           then do:
     1351               assign
     1352                   v-torgconf-outprops    = yes
     1353               .
     1354           end.
     1355           if lookup( p-form-name, v-outexlst ) <> 0
     1356           then do:
     1357               assign
     1358                   v-torgconf-outexlst  = yes
     1359               .
     1360           end.
     1361        assign
     1362         v-name = p-form-name.
     1363   end.
     1364   end.
     1365   end procedure.
     1366   procedure torgconf-get-self-param :
     1367   define input parameter p-obj-type           as character        no-undo.
     1368   define input parameter p-obj-code           as integer          no-undo.
     1369   define input parameter p-curr-code          as integer          no-undo.
     1370       define variable v-host-code    as integer      no-undo.
     1371       define variable v-par-type     as character    no-undo.
     1372   do
     1373   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message(1))
     1374   :
     1375   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1376   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1377     (input  p-obj-type
     1378     ,input  p-obj-code
     1379     ,output v-host-code
     1380     )  .
     1381       if v-torgconf-outhold = yes
     1382       then do:
     1383           run torgconf-get-holdfirm-code in this-procedure (
     1384                 input p-obj-type
     1385               , input p-obj-code
     1386               , output v-torgconf-self-host-code
     1387           ).
     1388           if v-torgconf-self-host-code = 0
     1389           then do:
     1390               return error.
     1391           end.
     1392       end.
     1393       else do:
     1394           assign
     1395               v-torgconf-self-host-code = v-host-code
     1396           .
     1397       end.
     1398       if v-torgconf-self-host-code = 0
     1399       then do:
     1400           assign
     1401               v-torgconf-self-host-name           = "":U
     1402               v-torgconf-self-host-addres         = "":U
     1403               v-torgconf-self-host-post-addres    = "":U
     1404               v-torgconf-self-host-phone          = "":U
     1405               v-torgconf-self-host-inn            = "":U
     1406               v-torgconf-self-host-kpp            = "":U
     1407               v-torgconf-self-host-okpo           = "":U
     1408               v-torgconf-self-host-egrip-date     = "":U
     1409               v-torgconf-self-host-egrip-num      = "":U
     1410           .
     1411       end.
     1412       else do:
     1413           run fmtcli-get-client in this-procedure (
