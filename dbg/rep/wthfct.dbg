     3540   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3541     (input  buf_wth-doc.obj-type
     3542     ,input  buf_wth-doc.obj-code
     3543     ,output v-host-code
     3544     )  .
     3545            end.
     3546         if v-torgconf-outogr = "no_print"
     3547            then do:
     3548               assign
     3549                  v-torgconf-ogr-name = ""
     3550                  v-torgconf-ogr-post = ""
     3551               .
     3552            end.
     3553         if v-torgconf-outogr  = "ruk_firm"
     3554               then do:
     3555               find first buf_sysconf no-lock
     3556               where buf_sysconf.host-code = v-host-code
     3557               no-error.
     3558               if available buf_sysconf
     3559               then do:
     3560                  assign
     3561                     v-torgconf-ogr-post = buf_sysconf.head-position
     3562                  .
     3563               end.
     3564               find first buf_clients no-lock
     3565                  where buf_clients.obj-type = 'орг':U
     3566                  and buf_clients.obj-code = v-host-code
     3567               .
     3568               find first buf_firm no-lock
     3569                  where buf_firm.firm-code = buf_clients.obj-code
     3570               .
     3571               assign
     3572                  v-torgconf-ogr-name = buf_firm.director
     3573               .
     3574            end.
     3575            if v-torgconf-outogr = "dir_obj"
     3576               then do:
     3577               find first buf_wth-doc no-lock
     3578               where buf_wth-doc.doc-code = p-doc-code
     3579               no-error.
     3580                  find first buf_shop no-lock
     3581                  where buf_shop.obj-code = buf_wth-doc.obj-code
     3582                  .
     3583                  assign
     3584                     v-torgconf-ogr-name = buf_shop.director
     3585                     v-torgconf-ogr-post = "Директор"
     3586                  .
     3587               end.
     3588         if v-torgconf-outogr = "manag_doc"
     3589            then do:
     3590               find first buf_wth-doc no-lock
     3591               where buf_wth-doc.doc-code = p-doc-code
     3592               no-error.
     3593               if available buf_wth-doc
     3594               then do:
     3595                  run rep/get-psn.p
     3596                  (input buf_wth-doc.deliver
     3597                  ,output v-torgconf-ogr-name
     3598                  ) .
     3599               end.
     3600               find first buf_person no-lock
     3601               where buf_person.psn-code = buf_wth-doc.deliver
     3602               no-error.
     3603               if available buf_person
     3604               then do:
     3605                  v-torgconf-ogr-post = buf_person.position.
     3606               end.
     3607               if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     3608               if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     3609            end.
     3610      end.
     3611   end.
     3612   end procedure.
     3613   procedure torgconf-get-outogr-param:
     3614       define input parameter p-form-name  as character    no-undo.
     3615       define input parameter p-host-code  as integer      no-undo.
     3616       define input parameter p-obj-type   as character    no-undo.
     3617       define input parameter p-obj-code   as integer      no-undo.
     3618       define input parameter p-doc-code   as character      no-undo.
     3619       define buffer buf_firm          for ub.firm .
     3620       define buffer buf_clients       for ub.clients .
     3621       define buffer buf_sysconf       for ub.sysconf .
     3622       define buffer buf_shop          for ub.shop .
     3623       define buffer buf_store         for ub.store .
     3624       define buffer buf_person        for ub.person .
     3625       define buffer buf_trn-doc       for ub.trn-doc .
     3626       define buffer buf_wth-doc       for ub.wth-doc .
     3627      if  p-form-name <> 'wthtrg12':U
     3628      and p-form-name <> 'wthfct':U
     3629      and p-form-name <> 'wthm11':U
     3630      then do:
     3631       find first buf_trn-doc no-lock
     3632       where buf_trn-doc.doc-code = p-doc-code
     3633       no-error.
     3634       if v-torgconf-outogr = "no_print"
     3635         then do:
     3636            assign
     3637               v-torgconf-ogr-name = ""
     3638               v-torgconf-ogr-post = ""
     3639            .
     3640         end.
     3641      if v-torgconf-outogr  = "ruk_firm"
     3642            then do:
     3643            find first buf_sysconf no-lock
     3644            where buf_sysconf.host-code = p-host-code
     3645            no-error.
     3646            if available buf_sysconf
     3647            then do:
     3648               assign
     3649                  v-torgconf-ogr-post = buf_sysconf.head-position
     3650               .
     3651            end.
     3652            find first buf_clients no-lock
     3653                where buf_clients.obj-type = 'орг':U
     3654                and buf_clients.obj-code = p-host-code
     3655            .
     3656            find first buf_firm no-lock
     3657                where buf_firm.firm-code = buf_clients.obj-code
     3658            .
     3659            assign
     3660                v-torgconf-ogr-name = buf_firm.director
     3661            .
     3662         end.
     3663         if v-torgconf-outogr = "dir_obj"
     3664            then do:
     3665            find first buf_trn-doc no-lock
     3666            where buf_trn-doc.doc-code = p-doc-code
     3667            no-error.
     3668               CASE buf_trn-doc.obj-type:
     3669               WHEN 'маг':U
     3670               THEN DO:
     3671                  find first buf_shop no-lock
     3672                  where buf_shop.obj-code = buf_trn-doc.obj-code
     3673                  .
     3674                  assign
     3675                     v-torgconf-ogr-name = buf_shop.director
     3676                     v-torgconf-ogr-post = "Директор"
     3677                  .
     3678               END.
     3679               WHEN 'скл':U
     3680               THEN DO:
     3681                  find first buf_store no-lock
     3682                  where buf_store.obj-code = buf_trn-doc.obj-code
     3683                  .
     3684                  assign
     3685                     v-torgconf-ogr-name = buf_store.store-boss
     3686                     v-torgconf-ogr-post = "Директор"
     3687                  .
     3688               END.
     3689               OTHERWISE DO:
     3690                  assign
     3691                     v-torgconf-ogr-name = "":U
     3692                     v-torgconf-ogr-post = "":U
     3693                  .
     3694               END.
     3695               END CASE.
     3696            end.
     3697      if v-torgconf-outogr = "manag_doc"
     3698         then do:
     3699            find first buf_trn-doc no-lock
     3700            where buf_trn-doc.doc-code = p-doc-code
     3701            no-error.
     3702            if available buf_trn-doc
     3703            then do:
     3704               run rep/get-psn.p
     3705               (input buf_trn-doc.boss
     3706               ,output v-torgconf-ogr-name
     3707               ) .
     3708            end.
     3709            find first buf_person no-lock
     3710            where buf_person.psn-code = buf_trn-doc.boss
     3711            no-error.
     3712            if available buf_person
     3713            then do:
     3714               v-torgconf-ogr-post = buf_person.position.
     3715            end.
     3716            if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     3717            if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     3718         end.
     3719      end.
     3720      else do:
     3721      find first buf_wth-doc no-lock
     3722         where buf_wth-doc.doc-code = p-doc-code
     3723         no-error.
     3724         if v-torgconf-outogr = "no_print"
     3725            then do:
     3726               assign
     3727                  v-torgconf-ogr-name = ""
     3728                  v-torgconf-ogr-post = ""
     3729               .
     3730            end.
     3731         if v-torgconf-outogr  = "ruk_firm"
     3732               then do:
     3733               find first buf_sysconf no-lock
     3734               where buf_sysconf.host-code = p-host-code
     3735               no-error.
     3736               if available buf_sysconf
     3737               then do:
     3738                  assign
     3739                     v-torgconf-ogr-post = buf_sysconf.head-position
     3740                  .
     3741               end.
     3742               find first buf_clients no-lock
     3743                  where buf_clients.obj-type = 'орг':U
     3744                  and buf_clients.obj-code = p-host-code
     3745               .
     3746               find first buf_firm no-lock
     3747                  where buf_firm.firm-code = buf_clients.obj-code
     3748               .
     3749               assign
     3750                  v-torgconf-ogr-name = buf_firm.director
     3751               .
     3752            end.
     3753            if v-torgconf-outogr = "dir_obj"
     3754               then do:
     3755               find first buf_wth-doc no-lock
     3756               where buf_wth-doc.doc-code = p-doc-code
     3757               no-error.
     3758                  find first buf_shop no-lock
     3759                  where buf_shop.obj-code = buf_wth-doc.obj-code
     3760                  .
     3761                  assign
     3762                     v-torgconf-ogr-name = buf_shop.director
     3763                     v-torgconf-ogr-post = "Директор"
     3764                  .
     3765               end.
     3766         if v-torgconf-outogr = "manag_doc"
     3767            then do:
     3768               find first buf_wth-doc no-lock
     3769               where buf_wth-doc.doc-code = p-doc-code
     3770               no-error.
     3771               if available buf_wth-doc
     3772               then do:
     3773                  run rep/get-psn.p
     3774                  (input buf_wth-doc.deliver
     3775                  ,output v-torgconf-ogr-name
     3776                  ) .
     3777               end.
     3778               find first buf_person no-lock
     3779               where buf_person.psn-code = buf_wth-doc.deliver
     3780               no-error.
     3781               if available buf_person
     3782               then do:
     3783                  v-torgconf-ogr-post = buf_person.position.
     3784               end.
     3785               if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     3786               if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     3787            end.
     3788      end.
     3789   end.
     3790   procedure torgconf-get-reason  :
     3791   define input parameter  p-doc-code       as character        no-undo.
     3792   define input parameter  p-reason-code    as integer          no-undo .
     3793   define input parameter  p-doc-type       as character        no-undo.
     3794       if p-reason-code > 0
     3795       then do:
     3796           define buffer buf_trn-reason for ub.trn-reason.
     3797           find first buf_trn-reason no-lock where buf_trn-reason.reason-code = p-reason-code no-error .
     3798           if available buf_trn-reason then assign v-torgconf-reason =  buf_trn-reason.reason-name .
     3799       end.
     3800       else do:
     3801           if p-doc-type = 'при':U
     3802           then  do:
     3803               define variable v-attr-type     as character    no-undo.
     3804               define variable v-attr-value    as character    no-undo.
     3805               run gbl/trdcat-v.p (input p-doc-code,input 'nids':U,output v-attr-value,output v-attr-type) .
     3806               assign v-torgconf-reason = v-attr-value .
     3807               run gbl/trdcat-v.p (input p-doc-code,input 'dids':U,output v-attr-value,output v-attr-type) .
     3808               assign v-torgconf-reason = v-torgconf-reason + " от " + v-attr-value .
     3809           end.
     3810       end.
     3811   end procedure.
     3812   define variable vss-include-info16 as character format "X(65)" no-undo
     3813   initial "@(#)$Workfile$ $Revision$".
     3814   define temp-table temp_wthgds_price-group no-undo
     3815       field gds-code      as integer
     3816       field price-rubl    as decimal
     3817       field vat-pc        as decimal
     3818       field sum-rubl      as decimal
     3819       field sum-base      as decimal
     3820       field sum-vat-rubl  as decimal
     3821       field sum-vat-base  as decimal
     3822       field price-base    as decimal
     3823       field qnty          as decimal
     3824       field fact-qnty     as decimal
     3825       index pi is primary unique
     3826           gds-code
     3827           price-rubl
     3828           vat-pc
     3829   .
     3830   define temp-table temp_wthgds_price-goods   no-undo
     3831       field gds-code      as integer
     3832       field sum-rubl      as decimal
     3833       field sum-base      as decimal
     3834       field sum-vat-rubl  as decimal
     3835       field sum-vat-base  as decimal
     3836       field vat-pc        as decimal
     3837       field qnty          as decimal
     3838       field fact-qnty     as decimal
     3839       field price-rubl    as decimal
     3840       field price-base    as decimal
     3841       index pi is primary unique
     3842           gds-code
     3843   .
     3844   procedure wthgds-calc-price-group:
     3845   define input parameter p-doc-code as character no-undo.
     3846       define variable v-gds-qnty          as decimal      no-undo.
     3847       define variable v-gds-price-rubl    as decimal      no-undo.
     3848       define buffer buf_wth-parts                 for ub.wth-parts.
     3849       define buffer buf_wth-par                   for ub.wth-par.
     3850       define buffer buf_temp_wthgds_price-group   for temp_wthgds_price-group.
     3851   do
     3852   for buf_wth-parts
     3853     , buf_wth-par
     3854     , buf_temp_wthgds_price-group
     3855   on error undo, return error
     3856   :
     3857       empty temp-table temp_wthgds_price-group.
     3858       for each buf_wth-parts no-lock
     3859          where buf_wth-parts.out-code = p-doc-code
     3860       :
     3861           find first buf_wth-par no-lock
     3862                where buf_wth-par.wth-code = buf_wth-parts.wth-code
     3863                  and buf_wth-par.par-code = buf_wth-parts.par-code
     3864           .
     3865           assign
     3866               v-gds-qnty          = buf_wth-par.par-val * buf_wth-parts.fact-qnty
     3867               v-gds-price-rubl    = round( ( buf_wth-parts.fact-qnty * buf_wth-parts.price-rubl ) / v-gds-qnty, 2 )
     3868           .
     3869           find first buf_temp_wthgds_price-group no-lock
     3870                where buf_temp_wthgds_price-group.gds-code     = buf_wth-parts.gds-code
     3871                  and buf_temp_wthgds_price-group.price-rubl   = v-gds-price-rubl
     3872                  and buf_temp_wthgds_price-group.vat-pc       = buf_wth-parts.vat-pc
     3873           no-error.
     3874           if not available buf_temp_wthgds_price-group
     3875           then do:
     3876               create buf_temp_wthgds_price-group.
     3877               assign
     3878                   buf_temp_wthgds_price-group.gds-code        = buf_wth-parts.gds-code
     3879                   buf_temp_wthgds_price-group.price-rubl      = v-gds-price-rubl
     3880                   buf_temp_wthgds_price-group.vat-pc          = buf_wth-parts.vat-pc
     3881                   buf_temp_wthgds_price-group.price-base      = round( ( buf_wth-parts.fact-qnty * buf_wth-parts.price-base ) / v-gds-qnty, 2 )
     3882                   buf_temp_wthgds_price-group.qnty            = 0.0
     3883                   buf_temp_wthgds_price-group.fact-qnty       = 0.0
     3884                   buf_temp_wthgds_price-group.sum-rubl        = 0.0
     3885                   buf_temp_wthgds_price-group.sum-base        = 0.0
     3886                   buf_temp_wthgds_price-group.sum-vat-rubl    = 0.0
     3887                   buf_temp_wthgds_price-group.sum-vat-base    = 0.0
     3888               .
     3889           end.
     3890           assign
     3891               buf_temp_wthgds_price-group.qnty            = buf_temp_wthgds_price-group.qnty          + v-gds-qnty
     3892               buf_temp_wthgds_price-group.fact-qnty       = buf_temp_wthgds_price-group.fact-qnty     + buf_wth-parts.fact-qnty
     3893               buf_temp_wthgds_price-group.sum-rubl        = buf_temp_wthgds_price-group.sum-rubl      + ( buf_wth-parts.fact-qnty * buf_wth-parts.price-rubl )
     3894               buf_temp_wthgds_price-group.sum-base        = buf_temp_wthgds_price-group.sum-base      + ( buf_wth-parts.fact-qnty * buf_wth-parts.price-base )
     3895               buf_temp_wthgds_price-group.sum-vat-rubl    = buf_temp_wthgds_price-group.sum-vat-rubl  + ( buf_wth-parts.fact-qnty * buf_wth-parts.price-rubl * buf_wth-parts.vat-pc / 100.0 )
     3896               buf_temp_wthgds_price-group.sum-vat-base    = buf_temp_wthgds_price-group.sum-vat-base  + ( buf_wth-parts.fact-qnty * buf_wth-parts.price-base * buf_wth-parts.vat-pc / 100.0 )
     3897           .
     3898       end.
     3899   end.
     3900   end procedure.
     3901   procedure wthgds-calc-price-goods:
     3902   define input parameter p-doc-code as character no-undo.
     3903       define variable v-gds-qnty          as decimal      no-undo.
     3904       define buffer buf_wth-parts                 for ub.wth-parts.
     3905       define buffer buf_wth-par                   for ub.wth-par.
     3906       define buffer buf_temp_wthgds_price-goods   for temp_wthgds_price-goods.
     3907   do
     3908   for buf_wth-parts
     3909     , buf_wth-par
     3910     , buf_temp_wthgds_price-goods
     3911   on error undo, return error
     3912   :
     3913       empty temp-table buf_temp_wthgds_price-goods.
     3914       for each buf_wth-parts no-lock
     3915          where buf_wth-parts.out-code = p-doc-code
     3916       :
     3917           find first buf_wth-par no-lock
     3918                where buf_wth-par.wth-code = buf_wth-parts.wth-code
     3919                  and buf_wth-par.par-code = buf_wth-parts.par-code
     3920           .
     3921           find first buf_temp_wthgds_price-goods no-lock
     3922                where buf_temp_wthgds_price-goods.gds-code     = buf_wth-parts.gds-code
     3923           no-error.
     3924           if not available buf_temp_wthgds_price-goods
     3925           then do:
     3926               create buf_temp_wthgds_price-goods.
     3927               assign
     3928                   buf_temp_wthgds_price-goods.gds-code        = buf_wth-parts.gds-code
     3929                   buf_temp_wthgds_price-goods.qnty            = 0.0
     3930                   buf_temp_wthgds_price-goods.fact-qnty       = 0.0
     3931                   buf_temp_wthgds_price-goods.sum-rubl        = 0.0
     3932                   buf_temp_wthgds_price-goods.sum-base        = 0.0
     3933                   buf_temp_wthgds_price-goods.sum-vat-rubl    = 0.0
     3934                   buf_temp_wthgds_price-goods.sum-vat-base    = 0.0
     3935               .
     3936           end.
     3937           assign
     3938               v-gds-qnty                                  = buf_wth-par.par-val * buf_wth-parts.fact-qnty
     3939               buf_temp_wthgds_price-goods.qnty            = buf_temp_wthgds_price-goods.qnty          + v-gds-qnty
     3940               buf_temp_wthgds_price-goods.fact-qnty       = buf_temp_wthgds_price-goods.fact-qnty     + buf_wth-parts.fact-qnty
     3941               buf_temp_wthgds_price-goods.sum-rubl        = buf_temp_wthgds_price-goods.sum-rubl      + ( buf_wth-parts.fact-qnty * buf_wth-parts.price-rubl )
     3942               buf_temp_wthgds_price-goods.sum-base        = buf_temp_wthgds_price-goods.sum-base      + ( buf_wth-parts.fact-qnty * buf_wth-parts.price-base )
     3943               buf_temp_wthgds_price-goods.sum-vat-rubl    = buf_temp_wthgds_price-goods.sum-vat-rubl  + ( buf_wth-parts.fact-qnty * buf_wth-parts.price-rubl * buf_wth-parts.vat-pc / 100.0 )
     3944               buf_temp_wthgds_price-goods.sum-vat-base    = buf_temp_wthgds_price-goods.sum-vat-base  + ( buf_wth-parts.fact-qnty * buf_wth-parts.price-base * buf_wth-parts.vat-pc / 100.0 )
     3945               buf_temp_wthgds_price-goods.vat-pc          = buf_wth-parts.vat-pc
     3946               buf_temp_wthgds_price-goods.price-rubl      = ( buf_wth-parts.fact-qnty * buf_wth-parts.price-rubl ) / v-gds-qnty
     3947               buf_temp_wthgds_price-goods.price-base      = ( buf_wth-parts.fact-qnty * buf_wth-parts.price-base ) / v-gds-qnty
     3948           .
     3949       end.
     3950   end.
     3951   end procedure.
     3952   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3953   define new global shared variable g#attr-lib  as handle no-undo .
     3954   define variable v-attr-lib-variable as handle no-undo .
     3955   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3956   procedure thbjattr_code :
     3957      define input  parameter p-upper-code     as character no-undo .
     3958      define input  parameter p-code           as character no-undo .
     3959      define output parameter p-label          as character no-undo .
     3960      define output parameter p-user-can-edit  as logical   no-undo .
     3961      define output parameter p-output-display as logical   no-undo .
     3962      define output parameter p-other          as character no-undo .
     3963      define output parameter p-prop-list      as character no-undo .
     3964      define output parameter p-prop-type-list as character no-undo .
     3965      define output parameter p-prop-label-list as character no-undo .
     3966      define output parameter p-global          as logical no-undo .
     3967      define output parameter p-host           as logical no-undo .
     3968      define output parameter p-shop           as logical no-undo .
     3969      define output parameter p-store          as logical no-undo .
     3970      define output parameter p-db             as logical no-undo .
     3971      define variable p-region as logical no-undo.
     3972      run thbjattr_code_reg in this-procedure (
     3973                                               p-upper-code,
     3974                                               p-code,
     3975                                               output p-label,
     3976                                               output p-user-can-edit,
     3977                                               output p-output-display,
     3978                                               output p-other,
     3979                                               output p-prop-list,
     3980                                               output p-prop-type-list,
     3981                                               output p-prop-label-list,
     3982                                               output p-global,
     3983                                               output p-host,
     3984                                               output p-shop,
     3985                                               output p-store,
     3986                                               output p-db,
     3987                                               output p-region
