     1050   procedure wthcattr-sprcli :
     1051   define input parameter parparentproc  as widget-handle no-undo.
     1052   define input parameter p-mode  as character no-undo.
     1053   define input-output parameter p-value as character no-undo .
     1054   define output parameter p-setted as logical no-undo .
     1055     DEFINE VARIABLE v-value as character no-undo .
     1056     define variable v-cli-type as character no-undo .
     1057     define variable v-cli-code as integer no-undo .
     1058     define buffer buf_clients   for ub.clients.
     1059     define variable v_rid as character no-undo.
     1060     define variable ref-rec as recid no-undo .
     1061     do
     1062     on error undo, return error
     1063     :
     1064         v-value = p-value.
     1065      if p-value <> '':U then do:
     1066       assign
     1067       v-cli-type = substring(p-value, 1, 3)
     1068       v-cli-code = integer(substring(p-value, 4))
     1069       no-error.
     1070       if error-status:error then do:
     1071         assign
     1072         v-cli-type = '':U
     1073         v-cli-code = 0
     1074         .
     1075       end.
     1076      end.
     1077      FIND FIRST buf_clients NO-LOCK WHERE
     1078               buf_clients.obj-type = v-cli-type AND
     1079               buf_clients.obj-code = v-cli-code  NO-ERROR.
     1080      IF available(buf_clients) then do:
     1081       run ref/cli-all.w (
     1082                   input parparentproc
     1083                  ,input if p-mode = 'ИЗМЕНЕНИЕ':U then "b-sel":U else "":U
     1084                  ,input v-cli-type
     1085                  ,input 'все':U
     1086                  ,input 'все':U
     1087                  ,input RECID( buf_clients )
     1088                  ,input ",,,,,,NO"
     1089                  ,input ?
     1090                  ,OUTPUT v_rid ).
     1091     END.
     1092     ELSE if p-mode = 'ИЗМЕНЕНИЕ':U then DO:
     1093       run ref/cli-all.w (
     1094                    input parparentproc
     1095                   ,INPUT "b-sel":U
     1096                  ,input  v-cli-type
     1097                  ,input 'все':U
     1098                  ,input 'текущие':U
     1099                  ,input ?
     1100                  ,input ",,,,,,NO"
     1101                  ,input ?
     1102                  ,OUTPUT v_rid ).
     1103     END.
     1104     else do:
     1105       message
     1106       if p-value = "":U then 'Атрибут не задан!'
     1107       else substitute('Не найден клиент &1',p-value)
     1108       view-as alert-box warning.
     1109     end.
     1110     IF v_rid <> ? AND v_rid <> "":U THEN DO:
     1111       ASSIGN ref-rec = INT( v_rid ) NO-ERROR.
     1112       IF ERROR-STATUS:ERROR THEN DO:
     1113           RETURN NO-APPLY.
     1114       END.
     1115       FIND FIRST buf_clients NO-LOCK WHERE
     1116                  RECID( buf_clients ) = ref-rec NO-ERROR.
     1117       IF AVAIL buf_clients THEN DO:
     1118         v-value = buf_clients.obj-type + string(buf_clients.obj-code, ">>>>>>>>9").
     1119       end.
     1120     end.
     1121     if v-value <> p-value then do:
     1122       p-value = v-value.
     1123       p-setted = yes.
     1124     end.
     1125     end.
     1126   end procedure.
     1127     define new global shared variable g#wthcalib as handle no-undo.
     1128   procedure torgconf-read :
     1129   do
     1130   on error undo, return error
     1131   :
