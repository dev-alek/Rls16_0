     1180       .
     1181   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1182   empty temp-table thbjattr_thbj-attr.
     1183   run adm/shattri.p (
     1184      input "get":U
     1185     ,input ''
     1186     ,input 0
     1187     ,input 'prt-glob':U
     1188     ,input  ""
     1189     ,output v-value-character
     1190     ,output v-value-date
     1191     ,output v-value-decimal
