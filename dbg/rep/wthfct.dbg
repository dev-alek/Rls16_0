     5281       value( "COPY /b " +
     5282         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
     5283         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
     5284         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
     5285                 ) .
     5286   end.
     5287   end.
     5288   end.
     5289   procedure print-more:
     5290   do
     5291   on error undo, return error
     5292   :
     5293       define variable v-start-string  as character        no-undo.
     5294       define variable v-add-string    as character        no-undo.
     5295       assign
     5296           v-start-string = gds-str2
     5297       .
     5298       do while trim(v-start-string) <> "" :
     5299           assign gds-str = v-start-string.
     5300           v-add-string = breakstr(gds-str, 45, input-output v-add-string, input-output v-start-string).
     5301           display stream Out-stream
     5302               sym1 (fill(" ",17) + v-add-string) @ buf_goods.gds-name
     5303               sym14 sym2 sym3 sym4 sym5 sym6 sym7 sym8
     5304               sym9  sym11 sym15 sym12 sym13
     5305               with frame factur .
     5306           down stream Out-stream 1 with frame factur .
     5307       end.
     5308   end.
     5309   end procedure.
     5310   procedure print-line :
     5311   define input parameter p-gds-code   as integer          no-undo.
     5312   define input parameter p-price-rubl as decimal          no-undo.
     5313   define input parameter p-vat-pc     as decimal          no-undo.
     5314       define buffer buf_temp_wthgds_price-group       for temp_wthgds_price-group.
     5315       define buffer buf_country                       for ub.country.
     5316       define buffer buf_units                         for ub.units.
     5317   do
     5318   for buf_temp_wthgds_price-group
     5319     , buf_country
     5320     , buf_units
     5321   on error undo, return error
     5322   :
     5323       find first buf_temp_wthgds_price-group
     5324            where buf_temp_wthgds_price-group.gds-code   = p-gds-code
     5325              and buf_temp_wthgds_price-group.price-rubl = p-price-rubl
     5326              and buf_temp_wthgds_price-group.vat-pc     = p-vat-pc
     5327       .
     5328       find first buf_goods no-lock
     5329            where buf_goods.gds-code = buf_temp_wthgds_price-group.gds-code
     5330       .
     5331       find first buf_country no-lock
     5332            where buf_country.alpha1 = buf_goods.alpha1
     5333       no-error.
     5334       if available buf_country
     5335       then do:
     5336           assign
     5337               v-country-code = " " + string(country.num-code)
     5338               v-country = buf_country.short-name
     5339           .
     5340       end.
     5341       else do:
     5342           assign
     5343               v-country-code = ""
     5344               v-country = ""
     5345           .
     5346       end.
     5347       assign
     5348           gds-str  = ''
     5349           gds-str1 = ''
     5350           gds-str2 = ''
     5351       .
     5352       find first buf_units no-lock
     5353            where buf_units.unit-name = buf_goods.unit-base
     5354       .
     5355       v-unit-code = (if units.OKEI = 0 then "-" else string(units.OKEI)) .
     5356       if ( buf_units.type = "дро,2ед"
     5357       or buf_units.type = "дро,доп" )
     5358       then do:
     5359           assign
     5360               str =  (if rep-artic then (string( buf_goods.artic, "x(16)" ) + " ") else "")  + string(buf_goods.Sort,"x(5)") + " " + trim(buf_goods.gds-name)
     5361                                                                                    + " " + trim(buf_goods.PS)
     5362           .
     5363       end.
     5364       else do:
     5365           assign
     5366               str = (if rep-artic then (string( buf_goods.artic, "x(16)" ) + " ") else "")  + trim(buf_goods.gds-name)
     5367           .
     5368       end.
     5369       assign
     5370           Gds-str1 = breakstr(str, 45, input-output gds-str1, input-output gds-str2)
     5371       .
     5372       do while trim(gds-str2) <> "" :
     5373           assign
     5374               gds-str = gds-str2
     5375               gds-str1 = breakstr(gds-str, 45, input-output gds-str1, input-output gds-str2)
     5376           .
     5377       end.
     5378       assign
     5379           gds-str1 = breakstr(str, 45, input-output gds-str1, input-output gds-str2).
     5380       .
     5381       assign
     5382           v-qnty = buf_temp_wthgds_price-group.qnty
     5383           v-VAT  = ( if PrintRubl
     5384                      then buf_temp_wthgds_price-group.sum-vat-rubl
     5385                      else buf_temp_wthgds_price-group.sum-vat-base ) / buf_temp_wthgds_price-group.qnty
     5386       .
     5387       assign
     5388           v-price-no-VAT = ( if PrintRubl
     5389                               then buf_temp_wthgds_price-group.price-rubl
     5390                               else buf_temp_wthgds_price-group.price-base ) - v-VAT
     5391       .
     5392       if p-round = 'round':U
     5393       then do:
     5394           define variable v-void-decimal    as decimal      no-undo.
     5395           run p-fmt-round in this-procedure (
     5396                 input v-qnty
     5397               , input v-price-no-VAT
     5398               , input v-VAT
     5399               , input 0.0
     5400               , input 0.0
     5401               , output v-price-no-VAT
     5402               , output v-void-decimal
     5403               , output v-void-decimal
     5404               , output v-VAT
     5405               , output v-void-decimal
     5406               , output v-void-decimal
     5407               , output v-sum-no-VAT
     5408               , output v-void-decimal
     5409           ).
     5410           assign
     5411               v-sum               = v-sum-no-VAT + v-VAT
     5412           .
     5413       end.
     5414       else do:
     5415           assign
     5416               v-VAT           = v-VAT * v-qnty
     5417               v-SLT           = v-SLT * v-qnty
     5418               v-sum-no-VAT    = v-price-no-VAT * v-qnty
     5419               v-tax           = 0.0
     5420               v-sum           = v-sum-no-VAT + v-VAT
     5421           .
     5422       end.
     5423       display stream Out-stream
     5424           sym1 gds-str1 @ buf_goods.gds-name
     5425           sym2 v-unit-code
     5426           sym14 buf_goods.unit-base @ buf_goods.unit-base
     5427           sym3 v-qnty
     5428           sym4 v-price-no-VAT
     5429           sym5 v-sum-no-VAT
     5430           sym6 "без акциза" format "x(6)" @ v-sum-actciz
     5431           sym7 p-vat-pc @ v-VAT-prc
     5432           sym8 v-VAT
     5433           sym9 v-sum
     5434           sym11 v-country-code
     5435           sym15 v-country
     5436           sym12
     5437           sym13
     5438       with frame factur .
     5439       down stream Out-stream 1 with frame factur .
     5440       run facturxl-write-line-data in this-procedure (
     5441             input gds-str1
     5442           , input "  -   ":U
     5443           , input v-unit-code
     5444           , input ( if invers then ub.doc-line.unit-cli else buf_goods.unit-base )
     5445           , input string( v-qnty              )
     5446           , input string( v-price-no-VAT      )
     5447           , input string( v-sum-no-VAT        )
     5448           , input "без акциза":U
     5449           , input string( p-vat-pc            )
     5450           , input string( v-VAT               )
     5451           , input string( v-sum               )
     5452           , input v-country-code
     5453           , input v-country
     5454           , input "":U
     5455       ).
     5456       run print-more in this-procedure.
     5457       assign v-lines-counter = v-lines-counter + 1.
     5458       assign
     5459           v-tot-sum-no-VAT    = v-tot-sum-no-VAT  + v-sum-no-VAT  + v-tax
     5460           v-tot-VAT           = v-tot-VAT         + v-VAT
     5461           v-tot-SLT           = v-tot-SLT         + v-SLT
     5462           v-tot-tax           = v-tot-tax         + v-tax
     5463           v-tot-sum           = v-tot-sum         + v-sum         + v-tax
     5464       .
     5465   end.
     5466   end procedure.
     5467   procedure print-header :
     5468   define input parameter p-doc-code           as character    no-undo.
     5469   define output parameter p-curr-abbr         as character    no-undo.
     5470       define variable v-print-doc      as character           no-undo.
     5471       define variable v-par-type       as character           no-undo.
     5472       define variable t-num            as character           no-undo.
     5473       define variable v-obj-prt-on     as logical             no-undo.
     5474       define variable t-inn            as character           no-undo.
     5475       define variable v-plat-rasch-doc as character           no-undo.
     5476       define variable v-attr-type      as character    no-undo.
     5477       define buffer buf_wth-doc       for ub.wth-doc.
     5478       define buffer buf_currency      for ub.currency.
     5479       define buffer buf_shop          for ub.shop.
     5480   do
     5481   for buf_wth-doc
     5482     , buf_currency
     5483     , buf_shop
     5484   on error undo, return error
     5485   :
     5486       find first buf_wth-doc no-lock
     5487            where buf_wth-doc.doc-code = p-doc-code
     5488       .
     5489       run torgconf-get-form-header in this-procedure (
     5490             input Invers
     5491           , input buf_wth-doc.doc-code
     5492           , input yes
     5493           , input buf_wth-doc.doc-date
     5494           , input buf_wth-doc.fact-date
     5495           , input buf_wth-doc.doc-type
     5496           , input buf_wth-doc.status_
     5497           , input p-reverse
     5498           , input no
     5499       ).
     5500       find first buf_currency no-lock
     5501            where buf_currency.curr-code = 0
     5502       .
     5503       assign
     5504           p-curr-abbr = buf_currency.curr-abbr + ", код " + string(buf_currency.okv-code)
     5505       .
     5506       assign
     5507           t-num = substitute( "&1         от &2 &3"
     5508                           , v-torgconf-doc-code
     5509                           , v-torgconf-doc-date
     5510                           , ( if buf_wth-doc.status_ <> 'факт':U
     5511                               then string( "(" + caps( buf_wth-doc.status_ ) + ")" )
     5512                               else "":U )
     5513                   )
     5514       .
     5515       assign
     5516           t-inn = substitute( "&1&2&3", v-torgconf-supplier-inn, ( if v-torgconf-supplier-kpp = "":U then "":U else "/":U ), v-torgconf-supplier-kpp )
     5517       .
     5518       assign
     5519           v-torgconf-cargo-from-name = v-torgconf-cargo-from-name
     5520                                            + "  "
     5521                                            + ( if invers
     5522                                                or ( v-torgconf-outobj = no
     5523                                                   and ( not invers ) )
     5524                                               then v-torgconf-cargo-from-addres
     5525                                               else v-torgconf-self-obj-addres )
     5526       .
     5527       if v-torgconf-self-obj-type = 'маг':U
     5528       then do:
     5529           find first buf_shop no-lock
     5530                where buf_shop.obj-code = v-torgconf-self-obj-code
     5531           no-error.
     5532           if available buf_shop
     5533           then do:
     5534               case buf_wth-doc.doc-type
     5535               :
     5536                   when 'рас':U
     5537                   then do:
     5538                       assign
     5539                           v-torgconf-cargo-from-name = substitute( "&1&2, &3"
     5540                                                               , v-torgconf-self-obj-name
     5541                                                               , ( if v-torgconf-outprncd = yes
     5542                                                                   then substitute( " (&1 &2)", v-torgconf-self-obj-type, v-torgconf-self-obj-code )
     5543                                                                   else "":U )
     5544                                                               , buf_shop.addres1 )
     5545                       .
     5546                   end.
     5547                   when 'при':U
     5548                   or when 'возврат':U
     5549                   then do:
     5550                       assign
     5551                           v-torgconf-cargo-to-value = substitute( "&1&2, &3"
     5552                                                   , v-torgconf-self-obj-name
     5553                                                   , ( if v-torgconf-outprncd = yes
     5554                                                       then substitute( " (&1 &2)", v-torgconf-self-obj-type, v-torgconf-self-obj-code )
     5555                                                       else "":U )
     5556                                                   , buf_shop.addres1 )
     5557                       .
     5558                   end.
     5559               end case.
     5560           end.
     5561       end.
     5562       put stream Out-stream
     5563            space(108) "                                                                           Приложение № 1" skip
     5564             space(108) "                                                            к постановлению Правительства" skip
     5565             space(108) "                                                                     Российской Федерации" skip
     5566             space(108) "                                                                    от 26.12.2011 № 1137," skip
     5567         .
     5568       put stream Out-stream
     5569           space(25) string( "СЧЕТ-ФАКТУРА N" + ( if p-round = 'round':U then ":" else " " ) + t-num ) format "X(190)" skip
     5570           space(23) 'ИСПРАВЛЕНИЕ N   -   от " - "    -   '
     5571           skip(1) space(5) string( "Продавец" + ( if p-round = 'round':U then ":" else " " ) + fill( " ", 31 ) + v-torgconf-supplier-name ) format "X(190)"
     5572           skip    space(5) string( "Адрес"    + ( if p-round = 'round':U then ":" else " " ) + fill( " ", 34 ) + v-torgconf-supplier-addr ) format "X(190)"
     5573           skip    space(5) string( "Идентификационный номер продавца (ИНН/КПП)" + ( if p-round = 'round':U then ":" else " " ) + t-inn ) format "X(190)"
     5574             .
     5575      if ( buf_wth-doc.doc-type = 'при':U
     5576      or buf_wth-doc.doc-type = 'возврат':U )
     5577         then do:
     5578            run facturxl-write-cell-data in this-procedure (
     5579               input "h_cargoFrom":U
     5580             , input ( v-torgconf-torg12-cargo-value )
     5581            ).
     5582            if LENGTH(v-torgconf-torg12-cargo-value) > 145
     5583               then do:
     5584                  put stream Out-stream
     5585           skip    space(5) string( "Грузоотправитель и его адрес"
     5586                                   + ( if p-round = 'round':U then ":" else " " )
     5587                                   + fill( " ", 11 )
     5588                                          + ( SUBSTRING(v-torgconf-torg12-cargo-value,1,145))) format "X(190)"
     5589                     skip    space(45) SUBSTRING(v-torgconf-torg12-cargo-value,146) format "X(145)" skip
     5590                  .
     5591               end.
     5592               else do:
     5593                  put stream Out-stream
     5594                     skip    space(5) string( "Грузоотправитель и его адрес"
     5595                                             + ( if p-round = 'round':U then ":" else " " )
     5596                                             + fill( " ", 11 )
     5597                                             + ( v-torgconf-torg12-cargo-value)) format "X(190)" skip
     5598                  .
     5599               end.
     5600         end.
     5601         else do:
     5602            run facturxl-write-cell-data in this-procedure (
     5603               input "h_cargoFrom":U
     5604             , input ( v-torgconf-organization )
     5605            ).
     5606            if LENGTH(v-torgconf-organization) > 145
     5607               then do:
     5608                  put stream Out-stream
     5609                     skip    space(5) string( "Грузоотправитель и его адрес"
     5610                                          + ( if p-round = 'round':U then ":" else " " )
     5611                                          + fill( " ", 11 )
     5612                                          + (SUBSTRING(v-torgconf-organization,1,145))) format "X(190)"
     5613                     skip    space(45) SUBSTRING(v-torgconf-organization,146) format "X(145)" skip
     5614                  .
     5615               end.
     5616               else do:
     5617                  put stream Out-stream
     5618                     skip    space(5) string( "Грузоотправитель и его адрес"
     5619                                          + ( if p-round = 'round':U then ":" else " " )
     5620                                          + fill( " ", 11 )
     5621                                          + (v-torgconf-organization)) format "X(190)" skip
     5622       .
     5623               end.
     5624         end.
     5625       run facturxl-write-cell-data in this-procedure (
     5626             input "h_docCode":U
     5627           , input v-torgconf-doc-code
     5628       ).
     5629       run facturxl-write-cell-data in this-procedure (
     5630             input "h_docDate":U
     5631           , input v-torgconf-doc-date
     5632       ).
     5633       run facturxl-write-cell-data in this-procedure (
     5634             input "h_supplier":U
     5635           , input v-torgconf-supplier-name
     5636       ).
     5637       run facturxl-write-cell-data in this-procedure (
     5638             input "h_supplierAddr":U
     5639           , input v-torgconf-supplier-addr
     5640       ).
     5641       run facturxl-write-cell-data in this-procedure (
     5642             input "h_supplierINN":U
     5643           , input t-inn
     5644       ).
     5645       assign
     5646           t-inn = substitute( "&1&2&3", v-torgconf-saler-inn, ( if v-torgconf-saler-kpp = "":U then "":U else "/":U ), v-torgconf-saler-kpp )
     5647           v-plat-rasch-doc    = " N ":U + ( if p-round = 'round':U then ": ":U else " ":U ) + fill( " ", 6 ) + v-torgconf-plat-rasch-doc
     5648       .
     5649      if ( buf_wth-doc.doc-type = 'при':U
     5650      or buf_wth-doc.doc-type = 'возврат':U )
     5651         then do:
     5652            run facturxl-write-cell-data in this-procedure (
     5653                  input "h_cargoTo":U
     5654                , input v-torgconf-organization
     5655            ).
     5656           if LENGTH(v-torgconf-organization) > 145
     5657            then do:
     5658               put stream Out-stream
     5659                  space(5) string( "Грузополучатель и его адрес" + ( if p-round = 'round':U then ": " else " " ) + fill( " ", 12 ) + SUBSTRING(v-torgconf-organization,1,145))   format "X(190)"
     5660                  skip space(45) SUBSTRING(v-torgconf-organization,146) format "X(145)"
     5661               .
     5662            end.
     5663            else do:
     5664               put stream Out-stream
     5665                  space(5) string( "Грузополучатель и его адрес" + ( if p-round = 'round':U then ": " else " " ) + fill( " ", 12 ) + v-torgconf-organization)   format "X(190)"
     5666               .
     5667            end.
     5668         end.
     5669         else do:
     5670            run facturxl-write-cell-data in this-procedure (
     5671                  input "h_cargoTo":U
     5672                , input v-torgconf-consignee
     5673            ).
     5674           if LENGTH(v-torgconf-consignee) > 145
     5675            then do:
     5676               put stream Out-stream
     5677                  space(5) string( "Грузополучатель и его адрес" + ( if p-round = 'round':U then ": " else " " ) + fill( " ", 12 ) + SUBSTRING(v-torgconf-consignee,1,145))   format "X(190)"
     5678                  skip space(45) SUBSTRING(v-torgconf-consignee,146) format "X(145)"
     5679               .
     5680            end.
     5681            else do:
     5682               put stream Out-stream
     5683                  space(5) string( "Грузополучатель и его адрес" + ( if p-round = 'round':U then ": " else " " ) + fill( " ", 12 ) + v-torgconf-consignee)   format "X(190)"
     5684               .
     5685           end.
     5686         end.
     5687       put stream Out-stream
     5688           skip    space(5) string( "К платежно-расчетному документу" + v-plat-rasch-doc ) format "X(190)"
     5689           skip(1) space(5) string( "Покупатель" + ( if p-round = 'round':U then ":" else " " ) + fill( " ", 29 ) + v-torgconf-saler-name + "(" + string( v-torgconf-saler-code ) + ")" ) format "X(190)"
     5690           skip    space(5) string( "Адрес" + ( if p-round = 'round':U then ":" else " " ) + fill( " ", 34 ) + v-torgconf-saler-addr ) format "X(190)"
     5691           skip    space(5) string( "Идентификационный номер покупателя (ИНН/КПП)" + ( if p-round = 'round':U then ": " else " " ) + t-inn ) format "X(190)"
     5692           skip    space(5) string( fill( "_", 130 ) ) format "X(130)"
     5693           skip
     5694       .
     5695       run facturxl-write-cell-data in this-procedure (
     5696             input "h_platDoc":U
     5697           , input v-torgconf-plat-rasch-doc
     5698       ).
     5699       run facturxl-write-cell-data in this-procedure (
     5700             input "h_saler":U
     5701           , input v-torgconf-saler-name + "(":U + string( v-torgconf-saler-code ) + ")":U
     5702       ).
     5703       run facturxl-write-cell-data in this-procedure (
     5704             input "h_salerAddr":U
     5705           , input v-torgconf-saler-addr
     5706       ).
     5707       run facturxl-write-cell-data in this-procedure (
     5708             input "h_salerINN":U
     5709           , input t-inn
     5710       ).
     5711       if buf_wth-doc.doc-type = 'при':U and buf_wth-doc.exter_
     5712       then do:
     5713           assign
     5714               v-is-return = yes
     5715           .
     5716       end.
     5717       if v-is-return = yes
     5718       then do:
     5719           put stream Out-stream
     5720               space(10) "Возврат товара поставщику." format "X(120)" skip
     5721           .
     5722       end.
     5723       if v-torgconf-outrubl = no
     5724       then do:
     5725       put stream Out-stream
     5726           space(5)
     5727               string( "Валюта: наименование, код  " +
     5728               trim( ( if invers and buf_wth-doc.doc-type <> 'при':U then p-curr-abbr else ( if PrintRubl then "рублях" else "баз.вал"  ) ) ) ) format "X(120)"
     5729       .
     5730       end.
     5731       if v-torgconf-outprim = no
     5732       then do:
     5733           put stream Out-stream
     5734               skip space(10)
     5735               ( if not( buf_wth-doc.PS begins "@" )
     5736               then string( "Примечание : " + substr( buf_wth-doc.PS, 1, 120 ) )
     5737               else ""
     5738               ) format "X(120)"
     5739           .
     5740       end.
     5741   end.
     5742   end procedure.
     5743   procedure print-footer :
     5744   define input parameter p-doc-code   as character    no-undo.
     5745   define input parameter p-curr-abbr  as character    no-undo.
     5746       define buffer buf_wth-doc       for ub.wth-doc.
     5747       define buffer buf_shop          for ub.shop.
     5748   do
     5749   for buf_wth-doc
     5750     , buf_shop
     5751   on error undo, return error
     5752   :
     5753       find first buf_wth-doc no-lock
     5754            where buf_wth-doc.doc-code = p-doc-code
     5755       .
     5756       put stream Out-stream
     5757           v-single-line format "X(198)"
     5758       .
     5759       if line-counter( Out-stream ) + 10 > page-size( Out-stream )
     5760       then do:
     5761           page stream Out-stream.
     5762       end.
     5763       define variable v-out-str      as character no-undo extent 2.
     5764       define variable propissumall   as character format "x(100)" no-undo .
     5765       define variable v-kop          as integer               no-undo .
     5766       run rep/wp-qnty.p ( TRUNCATE(v-tot-sum-no-VAT,0)
     5767                         , output PropisSumAll
     5768                         ) .
     5769       if PropisSumAll = '':U
     5770       then do:
     5771         assign
     5772            PropisSumAll = 'Ноль'
     5773         .
     5774       end.
     5775       assign
     5776          v-kop = ABSOLUTE(INTEGER((v-tot-sum-no-VAT - TRUNCATE(v-tot-sum-no-VAT,0)) * 100))
     5777       .
     5778       v-out-str[1] =  PropisSumall + " руб. " + STRING(v-kop,"99") + " коп.".
     5779       run facturxl-write-cell-data in this-procedure (
     5780             input "h_summ_prop":U
     5781           , input v-out-str[1]
     5782       ).
     5783       run facturxl-write-cell-data in this-procedure (
     5784             input "it_VATsum":U
     5785           , input string( v-tot-VAT )
     5786       ).
     5787       run facturxl-write-cell-data in this-procedure (
     5788             input "it_sum":U
     5789           , input string( v-tot-sum )
     5790       ).
     5791       display stream Out-stream
     5792           "Всего" @ buf_goods.gds-name
     5793           v-tot-sum-no-VAT  @ v-sum-no-VAT
     5794           v-tot-VAT         @ v-VAT
     5795           v-tot-sum         @ v-sum
     5796       with frame factur .
     5797       down stream Out-stream with frame factur .
     5798       if not invers
     5799       then do:
     5800           put stream Out-stream
     5801               space(5) "Итого по документу: "
     5802               trim( string( v-tot-sum, "->,>>>,>>>,>>>,>>>,>>9.99" ) )
     5803               + " ("
     5804               + trim( ( if invers and buf_wth-doc.doc-type <> 'при':U then p-curr-abbr else ( if PrintRubl then "РУБ" else "баз.вал" ) ) )
     5805               + ")"
     5806                                                                           format "X(120)"     at 40
     5807           .
     5808       end.
     5809       put stream Out-stream
     5810           skip space(5) "Итого к оплате: "
     5811                           string( trim( string( v-tot-sum, "->,>>>,>>>,>>>,>>>,>>9.99" ) )
     5812                           + " ("
     5813                           + trim( ( if invers and buf_wth-doc.doc-type <> 'при':U then p-curr-abbr else ( if PrintRubl then "РУБ" else "баз.вал" ) ) )
     5814                           + ")" )
     5815                                                                           format "X(150)"     at 40
     5816       .
     5817       if PrintRubl
     5818       and v-torgconf-outprops = yes
     5819       then do:
     5820           run rep/wp-rub.p (
     5821               input v-tot-sum
     5822               , output v-propis
     5823               , output v-propis-cop
     5824           ).
     5825           put stream out-stream
     5826               skip space(25) v-propis
     5827                                                                               format "X(150)"  at 40
     5828               skip(1)
     5829           .
     5830       end.
     5831       if v-torgconf-outsubs = no
     5832       then do:
     5833           run facturxl-write-cell-data in this-procedure (
     5834                 input "f_bossName":U
     5835               , input v-torgconf-main-boss
     5836           ).
     5837           run facturxl-write-cell-data in this-procedure (
     5838                 input "f_buhName":U
     5839               , input v-torgconf-main-buh
     5840           ).
     5841       end.
     5842       if v-torgconf-outsubs = no
     5843       and trim(v-torgconf-main-boss) = "":U
     5844       or v-torgconf-outsubs = yes
     5845         then do:
     5846               v-torgconf-main-boss = fill( "_", 36 ).
     5847         end.
     5848       if v-torgconf-outsubs = no
     5849       and trim(v-torgconf-main-buh) = "":U
     5850       or v-torgconf-outsubs = yes
     5851         then do:
     5852            v-torgconf-main-buh = fill( "_", 36 ).
     5853         end.
     5854       if v-torgconf-self-host-egrip-date <> "":U
     5855       or v-torgconf-self-host-egrip-num  <> "":U
     5856       then do:
     5857           put stream Out-stream
     5858               skip(1) space(10) "Руководитель организации" format "X(25)" space(75)
     5859               "Главный бухгалтер" format "X(25)" skip
     5860               space(10) "или иное уполномоченное  " format "X(25)" space(75)
     5861               "или иное уполномоченное  " format "X(25)" skip
     5862               space(10) "лицо" format "X(25)" fill( "_", 26 ) format "X(26)" "    /" v-torgconf-main-boss format "X(33)" "/"
     5863               space(10) "лицо" format "X(25)" fill( "_", 26 ) format "X(26)" "    /" v-torgconf-main-buh format "X(31)" "/"
     5864               skip space(43) "(подпись)" space(27) "(Ф.И.О)"  space(57) "(подпись)" space(27) "(Ф.И.О)"
     5865           .
     5866           if v-torgconf-outegrp = no
     5867           then do:
     5868               put stream Out-stream
     5869                   skip    space(100)
     5870                        space(10) substitute( "ЕГРИП N &1 от &2", v-torgconf-self-host-egrip-num, v-torgconf-self-host-egrip-date ) format "X(50)"
     5871           .
     5872           end.
     5873           run facturxl-write-cell-data in this-procedure (
     5874                 input "f_bossName":U
     5875               , input "":U
     5876           ).
     5877           run facturxl-write-cell-data in this-procedure (
     5878                 input "f_buhName":U
     5879               , input "":U
     5880           ).
     5881           if v-torgconf-outegrp = yes
     5882           then do:
     5883               assign
     5884                     v-torgconf-self-host-name = fill("_",42)
     5885               .
     5886           end.
     5887           else do:
     5888              if trim(v-torgconf-self-host-name) = "":U
     5889              then do:
     5890                  v-torgconf-self-host-name = fill("_", 42).
     5891              end.
     5892              run facturxl-write-cell-data in this-procedure (
     5893                 input "f_ownerName":U
     5894               , input v-torgconf-self-host-name
     5895              ) .
     5896           end.
     5897       end.
     5898   end.
     5899   end procedure.
