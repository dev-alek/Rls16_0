     1706   procedure torgconf-get-sup-param :
     1707   define input parameter p-obj-type           as character        no-undo.
     1708   define input parameter p-obj-code           as integer          no-undo.
     1709   define input parameter p-curr-code          as integer          no-undo.
     1710       define variable v-host-code    as integer      no-undo.
     1711       define variable v-par-type     as character    no-undo.
     1712   do
     1713   on error undo, return error
     1714   :
     1715       assign
     1716          v-torgconf-sup-host-code = v-host-code
     1717       .
     1718       if v-torgconf-sup-host-code = 0
     1719       then do:
     1720           assign
     1721               v-torgconf-sup-host-name           = "":U
     1722               v-torgconf-sup-host-addres         = "":U
     1723               v-torgconf-sup-host-post-addres    = "":U
     1724               v-torgconf-sup-host-phone          = "":U
     1725               v-torgconf-sup-host-inn            = "":U
     1726               v-torgconf-sup-host-kpp            = "":U
     1727               v-torgconf-sup-host-okpo           = "":U
     1728               v-torgconf-sup-host-egrip-date     = "":U
     1729               v-torgconf-sup-host-egrip-num      = "":U
     1730           .
     1731       end.
     1732       else do:
     1733           run fmtcli-get-client in this-procedure (
     1734                 input 'орг':U
     1735               , input v-torgconf-sup-host-code
     1736           ).
     1737           assign
     1738               v-torgconf-sup-host-name        = v-fmtcli-name
     1739               v-torgconf-sup-host-engl-name   = v-fmtcli-engl-name
     1740               v-torgconf-sup-host-addres      = v-fmtcli-full-addres
     1741               v-torgconf-sup-host-post-addres = v-fmtcli-post-addres
     1742               v-torgconf-sup-host-phone       = v-fmtcli-phone
     1743               v-torgconf-sup-host-inn         = v-fmtcli-inn
     1744               v-torgconf-sup-host-kpp         = v-fmtcli-kpp
     1745               v-torgconf-sup-host-okpo        = v-fmtcli-okpo
     1746           .
     1747           run gbl/clntat-v.p (
     1748                 input 'орг':U
     1749               , input v-torgconf-sup-host-code
     1750               , input 'egrip-date':U
     1751               , output v-torgconf-sup-host-egrip-date
     1752               , output v-par-type
     1753           ).
     1754           run gbl/clntat-v.p (
     1755                 input 'орг':U
     1756               , input v-torgconf-sup-host-code
     1757               , input 'egrip-num':U
     1758               , output v-torgconf-sup-host-egrip-num
     1759               , output v-par-type
     1760           ).
     1761           run fmtcli-get-bank in this-procedure (
     1762                 input v-host-code
     1763               , input 'орг':U
     1764               , input v-torgconf-sup-host-code
     1765               , input p-curr-code
     1766           ).
     1767       end.
     1768       assign
     1769           v-torgconf-sup-schet-exists = v-fmtcli-schet-exists
     1770           v-torgconf-sup-bank-exists  = v-fmtcli-bank-exists
     1771           v-torgconf-sup-bank-r-schet = v-fmtcli-bank-r-schet
     1772           v-torgconf-sup-bank-c-schet = v-fmtcli-bank-c-schet
     1773           v-torgconf-sup-bank-bik     = v-fmtcli-bank-bik
     1774           v-torgconf-sup-bank-name    = v-fmtcli-bank-name
     1775           v-torgconf-sup-bank-addres  = v-fmtcli-bank-addres
     1776           v-torgconf-sup-bank-city    = v-fmtcli-bank-city
     1777       .
     1778       assign
     1779           v-torgconf-sup-obj-type = p-obj-type
     1780           v-torgconf-sup-obj-code = p-obj-code
     1781       .
     1782       if trim(p-obj-type) <> ""
     1783       and p-obj-code <> 0
     1784       then do:
     1785       run fmtcli-get-client in this-procedure (
     1786             input p-obj-type
     1787           , input p-obj-code
     1788       ).
     1789       assign
     1790           v-torgconf-sup-obj-name        = v-fmtcli-name
     1791           v-torgconf-sup-obj-engl-name   = v-fmtcli-engl-name
     1792           v-torgconf-sup-obj-addres      = v-fmtcli-full-addres
     1793           v-torgconf-temp-post-addres    = v-fmtcli-post-addres
     1794           v-torgconf-sup-obj-phone       = v-fmtcli-phone
     1795           v-torgconf-sup-obj-inn         = v-fmtcli-inn
     1796           v-torgconf-sup-obj-okpo        = v-fmtcli-okpo
     1797       .
     1798      end.
     1799      end.
     1800   end procedure.
     1801   procedure torgconf-get-cli-param :
     1802   define input parameter p-host-obj-code      as integer          no-undo.
     1803   define input parameter p-obj-type           as character        no-undo.
     1804   define input parameter p-obj-code           as integer          no-undo.
     1805   define input parameter p-curr-code          as integer          no-undo.
     1806       define variable v-host-code    as integer      no-undo.
     1807   do
     1808   on error undo, return error
     1809   :
     1810       assign
     1811           v-torgconf-cli-type = p-obj-type
     1812           v-torgconf-cli-code = p-obj-code
     1813       .
     1814       run fmtcli-get-client in this-procedure (
     1815             input p-obj-type
     1816           , input p-obj-code
     1817       ).
     1818       assign
     1819           v-torgconf-cli-name         = trim( v-fmtcli-name          )
     1820           v-torgconf-cli-engl-name    = trim( v-fmtcli-engl-name          )
     1821           v-torgconf-cli-addres       = trim( v-fmtcli-full-addres   )
     1822           v-torgconf-cli-post-addres  = trim( v-fmtcli-post-addres   )
     1823           v-torgconf-cli-phone        = trim( v-fmtcli-phone         )
     1824           v-torgconf-cli-inn          = trim( v-fmtcli-inn           )
     1825           v-torgconf-cli-kpp          = trim( v-fmtcli-kpp           )
     1826           v-torgconf-cli-okpo         = trim( v-fmtcli-okpo          )
     1827       .
     1828      run fmtcli-get-bank in this-procedure (
     1829             input p-host-obj-code
     1830           , input p-obj-type
     1831           , input p-obj-code
     1832           , input p-curr-code
     1833       ).
     1834       assign
     1835           v-torgconf-cli-schet-exists = v-fmtcli-schet-exists
     1836           v-torgconf-cli-bank-exists  = v-fmtcli-bank-exists
     1837           v-torgconf-cli-bank-r-schet = v-fmtcli-bank-r-schet
     1838           v-torgconf-cli-bank-c-schet = v-fmtcli-bank-c-schet
     1839           v-torgconf-cli-bank-bik     = v-fmtcli-bank-bik
     1840           v-torgconf-cli-bank-name    = v-fmtcli-bank-name
     1841           v-torgconf-cli-bank-addres  = v-fmtcli-bank-addres
     1842           v-torgconf-cli-bank-city    = v-fmtcli-bank-city
     1843       .
     1844   end.
     1845   end procedure.
     1846   procedure torgconf-get-ship-param :
     1847   define input parameter p-host-obj-code      as integer          no-undo.
     1848   define input parameter p-obj-type           as character        no-undo.
     1849   define input parameter p-obj-code           as integer          no-undo.
     1850   define input parameter p-curr-code          as integer          no-undo.
     1851       define variable v-host-code    as integer      no-undo.
     1852   do
     1853   on error undo, return error
     1854   :
     1855       assign
     1856           v-torgconf-ship-type = p-obj-type
     1857           v-torgconf-ship-code = p-obj-code
     1858       .
     1859       if trim(p-obj-type) = ""
     1860       and p-obj-code = 0
     1861       then do:
     1862       assign
     1863           v-torgconf-ship-name         = "":U
     1864           v-torgconf-ship-addres       = "":U
     1865           v-torgconf-ship-post-addres  = "":U
     1866           v-torgconf-ship-phone        = "":U
     1867           v-torgconf-ship-inn          = "":U
     1868           v-torgconf-ship-kpp          = "":U
     1869           v-torgconf-ship-okpo         = "":U
     1870       .
     1871       end.
     1872       else do:
     1873       run fmtcli-get-client in this-procedure (
     1874             input p-obj-type
     1875           , input p-obj-code
     1876       ).
     1877       assign
     1878           v-torgconf-ship-name         = trim( v-fmtcli-name          )
     1879           v-torgconf-ship-engl-name    = trim( v-fmtcli-engl-name          )
     1880           v-torgconf-ship-addres       = trim( v-fmtcli-full-addres   )
     1881           v-torgconf-ship-post-addres  = trim( v-fmtcli-post-addres   )
     1882           v-torgconf-ship-phone        = trim( v-fmtcli-phone         )
     1883           v-torgconf-ship-inn          = trim( v-fmtcli-inn           )
     1884           v-torgconf-ship-kpp          = trim( v-fmtcli-kpp           )
     1885           v-torgconf-ship-okpo         = trim( v-fmtcli-okpo          )
     1886       .
     1887       end.
     1888           run fmtcli-get-bank in this-procedure (
     1889             input p-host-obj-code
     1890           , input p-obj-type
     1891           , input p-obj-code
     1892           , input p-curr-code
     1893       ).
     1894       assign
     1895           v-torgconf-ship-schet-exists = v-fmtcli-schet-exists
     1896           v-torgconf-ship-bank-exists  = v-fmtcli-bank-exists
     1897           v-torgconf-ship-bank-r-schet = v-fmtcli-bank-r-schet
     1898           v-torgconf-ship-bank-c-schet = v-fmtcli-bank-c-schet
     1899           v-torgconf-ship-bank-bik     = v-fmtcli-bank-bik
     1900           v-torgconf-ship-bank-name    = v-fmtcli-bank-name
     1901           v-torgconf-ship-bank-addres  = v-fmtcli-bank-addres
     1902           v-torgconf-ship-bank-city    = v-fmtcli-bank-city
     1903       .
     1904   end.
     1905   end procedure.
     1906   procedure torgconf-get-holdfirm-code :
     1907   define input parameter p-obj-type   as character        no-undo.
     1908   define input parameter p-obj-code   as integer          no-undo.
     1909   define output parameter p-firm-code as integer          no-undo.
     1910       define variable v-firm-code-str     as character    no-undo.
     1911       define variable v-par-type          as character    no-undo.
     1912       define buffer buf_clients       for ub.clients.
     1913   do
     1914   for buf_clients
     1915   on error undo, return error
     1916   :
     1917       run gbl/clntat-v.p (
     1918             input p-obj-type
     1919           , input p-obj-code
     1920           , input 'holdfirm-code':U
     1921           , output v-firm-code-str
     1922           , output v-par-type
     1923       ).
     1924       assign
     1925           p-firm-code = integer( v-firm-code-str )
     1926       no-error.
     1927       if error-status :error
     1928       then do:
     1929           message
     1930               "Неверно задан код фирмы для печати накладных."
     1931           view-as alert-box warning.
     1932           assign
     1933               p-firm-code = 0
     1934           .
     1935       end.
     1936       else do:
     1937           find first buf_clients no-lock
     1938                where buf_clients.obj-type = 'орг':U
     1939                  and buf_clients.obj-code = p-firm-code
     1940           no-error.
     1941           if not available buf_clients
     1942           then do:
     1943               message
     1944                   "Включен параметр 'Список печатных форм, для которых должна быть задана фирма для печати накладных' (outhold)" skip
     1945                   "Не найдена фирма по заданному коду фирмы для печати накладных."
     1946               view-as alert-box warning.
     1947               assign
     1948                   p-firm-code = 0
     1949               .
     1950           end.
     1951       end.
     1952   end.
     1953   end procedure.
     1954   procedure torgconf-get-post-head:
     1955   define input  parameter p-obj-type             as character        no-undo.
     1956   define input  parameter p-obj-code             as integer          no-undo.
     1957   define output parameter p-torgconf-post-head   as character        no-undo.
     1958      define variable v-host-code         as integer      no-undo.
     1959      define buffer buf_sysconf     for ub.sysconf.
     1960        assign
     1961         p-torgconf-post-head  = ""
     1962        .
     1963   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1964   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1965     (input  p-obj-type
     1966     ,input  p-obj-code
     1967     ,output v-host-code
     1968     )  .
     1969      find first buf_sysconf no-lock
     1970      where buf_sysconf.host-code = v-host-code
     1971      no-error.
     1972      if available buf_sysconf
     1973      then do:
     1974         assign
     1975            p-torgconf-post-head = buf_sysconf.head-position
     1976         .
     1977      end.
     1978   end procedure.
     1979   procedure torgconf-get-storekeeper:
     1980   define input  parameter p-wrkr                   as integer          no-undo.
     1981   define output parameter p-torgconf-wrkr-name     as character        no-undo.
     1982   define output parameter p-torgconf-post          as character        no-undo.
     1983      define buffer buf_sysconf     for ub.sysconf.
     1984      define buffer buf_person      for ub.person.
     1985      define buffer buf_shop        for ub.shop .
     1986      define buffer buf_store       for ub.store .
     1987      if v-torgconf-outC = "no_print"
     1988      then do:
     1989         assign p-torgconf-post = ""
     1990                p-torgconf-wrkr-name = ""
     1991                .
     1992      end.
     1993      if v-torgconf-outC = "clad_doc"
     1994      then do:
     1995         run rep/get-psn.p
     1996               (input  p-wrkr
     1997               ,output p-torgconf-wrkr-name
     1998               ) .
     1999         find first buf_person no-lock
     2000         where buf_person.psn-code = p-wrkr
     2001         no-error.
     2002         if available buf_person
     2003         then do:
     2004           p-torgconf-post = buf_person.position.
     2005         end.
     2006         if p-torgconf-post = "?":U then p-torgconf-post = "".
     2007         if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2008      end.
     2009      if v-torgconf-outC = "clad_obj"
     2010      then do:
     2011         CASE v-torgconf-self-obj-type:
     2012         WHEN 'маг':U
     2013         THEN DO:
     2014            find first buf_shop no-lock
     2015            where buf_shop.obj-code = v-torgconf-self-obj-code
     2016            .
     2017            assign
     2018               p-torgconf-wrkr-name = buf_shop.store-man
     2019               p-torgconf-post = ""
     2020            .
     2021            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2022         END.
     2023         WHEN 'скл':U
     2024         THEN DO:
     2025            find first buf_store no-lock
     2026            where buf_store.obj-code = v-torgconf-self-obj-code
     2027            .
     2028            assign
     2029               p-torgconf-wrkr-name = buf_store.store-man
     2030               p-torgconf-post = ""
     2031            .
     2032            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2033         END.
     2034         OTHERWISE DO:
     2035            assign
     2036               p-torgconf-post = "":U
     2037               p-torgconf-wrkr-name = "":U
     2038            .
     2039         END.
     2040         END CASE.
     2041      end.
     2042    end procedure.
     2043   procedure torgconf-get-form-header :
     2044   define input parameter p-for-inverse    as logical          no-undo.
     2045   define input parameter p-doc-code       as character        no-undo.
     2046   define input parameter p-print-doc      as logical          no-undo.
     2047   define input parameter p-doc-date       as date             no-undo.
     2048   define input parameter p-fact-date      as date             no-undo.
     2049   define input parameter p-doc-type       as character        no-undo.
     2050   define input parameter p-status_        as character        no-undo.
     2051   define input parameter p-reverse        as logical          no-undo.
     2052   define input parameter p-sf-par         as logical          no-undo.
     2053       define variable v-attr-type         as character    no-undo.
     2054       define variable v-doc-code-standard as logical      no-undo.
     2055       define variable v-doc-date-standard as logical      no-undo.
     2056       define variable v-par-consignee-addres  as character    no-undo.
     2057       define variable v-host-code         as integer      no-undo.
     2058       define variable v-dcode-attr        as character    no-undo.
     2059       define variable v-ddate-attr        as character    no-undo.
     2060       define variable v-doc-date          as character    no-undo.
     2061       define variable v-doc-code          as character    no-undo.
     2062       define variable v-par-type          as character    no-undo.
     2063       define variable v-attr              as character    no-undo.
     2064       define buffer buf_firm          for ub.firm .
     2065       define buffer buf_clients       for ub.clients .
     2066       define buffer buf_sysconf       for ub.sysconf .
     2067       define buffer buf_shop          for ub.shop .
     2068       define buffer buf_store         for ub.store .
     2069       define buffer buf_person        for ub.person .
     2070       define buffer buf_trn-doc       for ub.trn-doc .
     2071       define buffer buf_wth-doc       for ub.wth-doc .
     2072       do
     2073   for buf_firm
     2074     , buf_clients
     2075     , buf_sysconf
     2076     , buf_shop
     2077     , buf_trn-doc
     2078     , buf_person
     2079     , buf_wth-doc
     2080   on error undo, return error
     2081   :
     2082       if p-doc-type = 'при':U
     2083       or p-doc-type = 'возврат':U
     2084       then do:
     2085           assign
     2086               v-torgconf-supplier         = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     2087                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     2088               v-torgconf-suppi            = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     2089                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     2090               v-torgconf-saler            = substitute( "&1&2&3&4&5", v-torgconf-self-host-name, ( if v-torgconf-self-host-addres = "":U then "":U else ", " ),
     2091                                             v-torgconf-self-host-addres, ( if v-torgconf-self-host-phone = "":U then "":U else ", " ),v-torgconf-self-host-phone )
     2092               v-torgconf-consignee        = substitute( "&1&2&3&4&5", v-torgconf-sup-host-name, ( if v-torgconf-sup-host-addres = "":U then "":U else ", " ),
     2093                                             v-torgconf-sup-host-addres, ( if v-torgconf-sup-host-phone = "":U then "":U else ", " ), v-torgconf-sup-host-phone  )
     2094               v-torgconf-supplier-okpo    = v-torgconf-cli-okpo
     2095               v-torgconf-saler-okpo       = v-torgconf-self-host-okpo
     2096               v-torgconf-consignee-okpo   = v-torgconf-sup-host-okpo
     2097               v-torgconf-supplier-code    = substitute( "&1", v-torgconf-cli-code         )
     2098               v-torgconf-supplier-type    = v-torgconf-cli-type
     2099               v-torgconf-saler-code       = substitute( "&1", v-torgconf-self-host-code   )
     2100               v-torgconf-saler-type       = v-torgconf-self-host-type
     2101               v-torgconf-consignee-code   = substitute( "&1", v-torgconf-sup-host-code   )
     2102               v-torgconf-consignee-type   = v-torgconf-sup-host-type
     2103               v-torgconf-supplier-name    = substitute( "&1", v-torgconf-cli-name         )
     2104               v-torgconf-saler-name       = substitute( "&1", v-torgconf-self-host-name   )
     2105               v-torgconf-consignee-name   = substitute( "&1", v-torgconf-sup-host-name   )
     2106               v-torgconf-supplier-addr    = substitute( "&1", v-torgconf-cli-addres       )
     2107               v-torgconf-saler-addr       = substitute( "&1", v-torgconf-self-host-addres )
     2108               v-torgconf-consignee-addr   = substitute( "&1", v-torgconf-sup-host-addres )
     2109               v-torgconf-supplier-inn     = substitute( "&1", v-torgconf-cli-inn          )
     2110               v-torgconf-supplier-engl-name     = substitute( "&1", v-torgconf-cli-engl-name          )
     2111               v-torgconf-saler-inn        = substitute( "&1", v-torgconf-self-host-inn    )
     2112               v-torgconf-consignee-inn    = substitute( "&1", v-torgconf-sup-host-inn    )
     2113               v-torgconf-supplier-kpp     = substitute( "&1", v-torgconf-cli-kpp          )
     2114               v-torgconf-saler-kpp        = substitute( "&1", v-torgconf-self-host-kpp    )
     2115               v-torgconf-consignee-kpp    = substitute( "&1", v-torgconf-sup-host-kpp    )
     2116           .
     2117           if v-torgconf-cli-schet-exists = yes
     2118           AND v-form-name                  = "torg12":U
     2119           then do:
     2120               assign
     2121                   v-torgconf-supplier = v-torgconf-supplier
     2122                       + substitute( ", р/с &1 к/с &2"
     2123                                   , v-torgconf-cli-bank-r-schet
     2124                                   , v-torgconf-cli-bank-c-schet
     2125                                   )
     2126                   v-torgconf-suppi = v-torgconf-supplier
     2127                       + substitute( ", р/с &1 к/с &2"
     2128                                   , v-torgconf-cli-bank-r-schet
     2129                                   , v-torgconf-cli-bank-c-schet
     2130                                   )
     2131               .
     2132               if v-torgconf-cli-bank-exists = yes
     2133               then do:
     2134                   assign
     2135                       v-torgconf-supplier = v-torgconf-supplier
     2136                           + substitute( " БИК &1 в &2 &3"
     2137                                       , v-torgconf-cli-bank-bik
     2138                                       , v-torgconf-cli-bank-name
     2139                                       ,(if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     2140                                       )
     2141                      v-torgconf-suppi = v-torgconf-supplier
     2142                           + substitute( " БИК &1 в &2 &3"
     2143                                       , v-torgconf-cli-bank-bik
     2144                                       , v-torgconf-cli-bank-name
     2145                                       ,(if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     2146                                       )
     2147                   .
     2148               end.
     2149           end.
     2150           if v-torgconf-self-schet-exists = yes
     2151           AND v-form-name                  = "torg12":U
     2152           then do:
     2153               assign
     2154                   v-torgconf-saler = v-torgconf-saler
     2155                       + substitute( ", р/с &1 к/с &2"
     2156                                   , v-torgconf-self-bank-r-schet
     2157                                   , v-torgconf-self-bank-c-schet
     2158                                   )
     2159               .
     2160               if v-torgconf-self-bank-exists = yes
     2161               then do:
     2162                   assign
     2163                       v-torgconf-saler = v-torgconf-saler
     2164                           + substitute( " БИК &1 в &2 &3"
     2165                                       , v-torgconf-self-bank-bik
     2166                                       , v-torgconf-self-bank-name
     2167                                       , v-torgconf-self-bank-addres
     2168                                       )
     2169                   .
     2170               end.
     2171           end.
     2172           if v-torgconf-sup-schet-exists = yes
     2173           AND v-form-name                  = "torg12":U
     2174           then do:
     2175               assign
     2176                   v-torgconf-consignee = v-torgconf-consignee
     2177                       + substitute( ", р/с &1 к/с &2"
     2178                                   , v-torgconf-sup-bank-r-schet
     2179                                   , v-torgconf-sup-bank-c-schet
     2180                                   )
     2181               .
     2182             if v-torgconf-sup-bank-exists = yes
     2183              then do:
     2184                assign
     2185                   v-torgconf-consignee = v-torgconf-consignee
     2186                           + substitute( " БИК &1 в &2 &3"
     2187                                       , v-torgconf-sup-bank-bik
     2188                                       , v-torgconf-sup-bank-name
     2189                                       , v-torgconf-sup-bank-addres
     2190                                       )
     2191                   .
     2192               end.
     2193           end.
     2194      if v-torgconf-outares = yes  AND v-form-name  = "torg12":U
     2195      then do:
     2196          assign
     2197            v-torgconf-supplier = substitute(  "&1&2&3 &4 &5&6"
