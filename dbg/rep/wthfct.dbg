        1   block-level on error undo, throw.
        2   define input parameter p-mainmenu-handle    as handle           no-undo.
        3   define input parameter p-doc-code           as character        no-undo.
        4   define input parameter invers           as logical              no-undo.
        5   define input parameter p-mode           as character            no-undo.
        6   define input parameter p-round          as character            no-undo.
        7   define input parameter p-reverse            as logical          no-undo .
        8   define variable vss-revision    as character no-undo initial "$Revision: c93cbc1375c4, 1081, rls $":U .
        9   define variable vss-author      as character no-undo initial "$Author: SMMolotkov $":U .
       10   define variable vss-date        as character no-undo initial "$Date: Thu Oct 12 16:32:18 2017 +0300 $":U .
       11   define variable vss-workfile    as character no-undo initial "$Workfile: wthfct.p $":U .
       12   define variable vss-archive     as character no-undo initial "$Archive: rep/wthfct.p $":U .
       13   define variable vss-description as character no-undo initial "Печать счета-фактуры.":U .
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
