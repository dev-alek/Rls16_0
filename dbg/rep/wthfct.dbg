     4558   procedure facturxl-write-cell-data :
     4559   define input parameter p-data-key   as character        no-undo.
     4560   define input parameter p-data-value as character        no-undo.
     4561       define buffer buf_temp_cell-data     for temp_cell-data.
     4562   do
     4563   for buf_temp_cell-data
     4564   on error undo, return error
     4565   :
     4566       find first buf_temp_cell-data
     4567            where buf_temp_cell-data.data-key = p-data-key
     4568       no-error.
     4569       if not available buf_temp_cell-data
     4570       then do:
     4571           create buf_temp_cell-data.
     4572           assign
     4573               buf_temp_cell-data.data-key = p-data-key
     4574           .
     4575       end.
     4576       assign
     4577           buf_temp_cell-data.data-value = p-data-value
     4578       .
     4579       put stream excel-cell unformatted
     4580                           buf_temp_cell-data.data-key
     4581           chr(9)   buf_temp_cell-data.data-value
     4582           chr(10)
     4583       .
     4584   end.
     4585   end procedure.
     4586   procedure facturxl-write-line-data :
     4587   define input parameter p-Name          as character        no-undo.
     4588   define input parameter p-UAES          as character        no-undo.
     4589   define input parameter p-OKEI          as character        no-undo.
     4590   define input parameter p-EI            as character        no-undo.
     4591   define input parameter p-qnty          as character        no-undo.
     4592   define input parameter p-price         as character        no-undo.
     4593   define input parameter p-SumNoVAT      as character        no-undo.
     4594   define input parameter p-SumActciz     as character        no-undo.
     4595   define input parameter p-VATpc         as character        no-undo.
     4596   define input parameter p-VATsum        as character        no-undo.
     4597   define input parameter p-sum           as character        no-undo.
     4598   define input parameter p-countrycode   as character        no-undo.
     4599   define input parameter p-country       as character        no-undo.
     4600   define input parameter p-GTD           as character        no-undo.
     4601       define buffer buf_temp_line-data        for temp_line-data.
     4602   do
     4603   for buf_temp_line-data
     4604   on error undo, return error
     4605   :
     4606       for each buf_temp_line-data
     4607       :
     4608           delete buf_temp_line-data.
     4609       end.
     4610       create buf_temp_line-data.
     4611       assign
     4612           v-facturxl-current-data-row = v-facturxl-current-data-row + 1
     4613       .
     4614       assign
     4615           buf_temp_line-data.data-key     = "LD":U
     4616           buf_temp_line-data.xl-line-id   = v-facturxl-current-data-row
     4617           buf_temp_line-data.Name         = p-Name
     4618           buf_temp_line-data.UAES         = p-UAES
     4619           buf_temp_line-data.OKEI         = p-OKEI
     4620           buf_temp_line-data.EI           = p-EI
     4621           buf_temp_line-data.qnty         = p-qnty
     4622           buf_temp_line-data.price        = p-price
     4623           buf_temp_line-data.SumNoVAT     = p-SumNoVAT
     4624           buf_temp_line-data.SumActciz    = p-SumActciz
     4625           buf_temp_line-data.VATpc        = p-VATpc
     4626           buf_temp_line-data.VATsum       = p-VATsum
     4627           buf_temp_line-data.sum          = p-sum
     4628           buf_temp_line-data.countrycode  = p-countrycode
     4629           buf_temp_line-data.country      = p-country
     4630           buf_temp_line-data.GTD          = p-GTD
     4631       .
     4632       put stream excel-line unformatted
     4633                           buf_temp_line-data.data-key
     4634           chr(9)   buf_temp_line-data.Name
     4635           chr(9)   buf_temp_line-data.UAES
     4636           chr(9)   buf_temp_line-data.OKEI
     4637           chr(9)   buf_temp_line-data.EI
     4638           chr(9)   buf_temp_line-data.qnty
     4639           chr(9)   buf_temp_line-data.price
     4640           chr(9)   buf_temp_line-data.SumNoVAT
     4641           chr(9)   buf_temp_line-data.SumActciz
     4642           chr(9)   buf_temp_line-data.VATpc
     4643           chr(9)   buf_temp_line-data.VATsum
     4644           chr(9)   buf_temp_line-data.sum
     4645           chr(9)   buf_temp_line-data.countrycode
     4646           chr(9)   buf_temp_line-data.country
     4647           chr(9)   buf_temp_line-data.GTD
     4648           chr(10)
     4649       .
     4650   end.
     4651   end procedure.
     4652   procedure facturxl-write-line-data-corr :
     4653   define input parameter p-Name          as character        no-undo.
     4654   define input parameter p-pokazately    as character        no-undo.
     4655   define input parameter p-UAES          as character        no-undo.
