       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   define new global shared variable g#library  as handle no-undo .
       73   define new global shared variable g#library2 as handle no-undo .
       74   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       75   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
       76   define  shared variable RepPathName        as character no-undo .
       77   define  shared variable PrintRubl          as logical   no-undo .
       78   define variable vss-include-info1 as character format "X(65)" no-undo
       79   initial "@(#)$Workfile$ $Revision$".
       80   define temp-table temp_p-fmt_string-part no-undo
       81       field str-key       as integer
       82       field string-part   as character
       83       index pi is primary unique
       84           str-key
       85   .
       86   define variable v-p-fmt-1-str-key    as integer      no-undo.
       87   FUNCTION center-field RETURNS INTEGER (INPUT iStartPix AS INTEGER, iEndPix AS INTEGER,
       88                                     iInput AS INTEGER).
       89     def var v-start-print as integer no-undo .
       90     if (iStartPix < 0) or (iEndPix < iStartPix) then return 0.
       91     assign
       92       v-start-print = INTEGER(iStartPix + ((iEndPix - iStartPix) / 2) - (iInput / 2))
       93     .
       94     RETURN v-start-print .
       95   END FUNCTION.
       96   FUNCTION right-field RETURNS INTEGER ( iEndPix AS INTEGER,
       97                                     iInput AS INTEGER).
       98     def var v-start-print as integer no-undo .
       99     assign
      100       v-start-print = INTEGER(iEndPix - 1 - iInput)
      101     .
      102     if v-start-print < 0 then return 0.
      103     RETURN v-start-print .
      104   END FUNCTION.
      105   function p-fmt-align-string returns character (
      106         p-in-string      as character
      107       , p-page-width     as integer
      108       , p-align-type     as character
      109   ).
      110       define variable v-string-length     as integer      no-undo.
      111       define variable v-out-string        as character    no-undo.
      112       assign
      113           v-string-length = length( trim( p-in-string ) )
      114       .
      115       if v-string-length >= p-page-width
      116       then do:
      117           assign
      118               v-out-string = trim( p-in-string )
      119           .
      120       end.
      121       else do:
      122           case p-align-type
      123           :
      124               when 'left':U
      125               then do:
      126                   assign
      127                       v-out-string = trim( p-in-string )
      128                   .
      129               end.
      130               when 'right':U
      131               then do:
      132                   assign
      133                       v-out-string = fill( " ":U, p-page-width - v-string-length ) + trim( p-in-string )
      134                   .
      135               end.
      136               when 'center':U
      137               then do:
      138                   assign
      139                       v-out-string = fill( " ":U, integer( ( p-page-width - v-string-length ) / 2 ) ) + trim( p-in-string )
      140                   .
      141               end.
      142           end case.
      143       end.
      144       return v-out-string .
      145   end function.
      146   procedure p-fmt-split-string :
      147   define input parameter p-source-string  as character        no-undo.
      148   define input parameter p-split-length   as integer          no-undo.
      149   define output parameter p-string-1      as character        no-undo.
      150   define output parameter p-string-2      as character        no-undo.
      151   do
      152   on error undo, return error
      153   :
      154       define variable v-space-pos    as integer      no-undo.
      155       if length( p-source-string ) <= p-split-length
      156       then do:
      157           assign
      158               p-string-1 = p-source-string
      159           .
      160       end.
      161       else do:
      162           assign
      163               v-space-pos = r-index( p-source-string, " ":U, p-split-length )
      164           .
      165           if v-space-pos = 0
      166           then do:
      167               assign
      168                   v-space-pos = index( p-source-string, " ":U )
      169               .
      170           end.
      171           if v-space-pos = 0
      172           then do:
      173               assign
      174                   p-string-1 = substring( p-source-string, 1, p-split-length )
      175                   p-string-2 = trim( substring( p-source-string, p-split-length, p-split-length ) )
      176               .
      177           end.
      178           else do:
      179               assign
      180                   p-string-1 = substring( p-source-string, 1, v-space-pos )
      181                   p-string-2 = trim( substring( p-source-string, v-space-pos ) )
      182               .
      183           end.
      184       end.
      185   end.
      186   end procedure.
      187   procedure p-fmt-round :
      188   define input parameter p-qnty               as decimal          no-undo.
      189   define input parameter p-price-no-VAT       as decimal          no-undo.
      190   define input parameter p-VAT                as decimal          no-undo.
      191   define input parameter p-SLT                as decimal          no-undo.
      192   define input parameter p-road-tax           as decimal          no-undo.
      193   define output parameter p-new-price-no-VAT  as decimal          no-undo.
      194   define output parameter p-new-VAT           as decimal          no-undo.
      195   define output parameter p-new-SLT           as decimal          no-undo.
      196   define output parameter p-new-sum-VAT       as decimal          no-undo.
      197   define output parameter p-new-sum-SLT       as decimal          no-undo.
      198   define output parameter p-new-sum-road-tax  as decimal          no-undo.
      199   define output parameter p-new-sum-no-VAT    as decimal          no-undo.
      200   define output parameter p-new-sum-full      as decimal          no-undo.
      201       define variable v-vat-pc    as decimal      no-undo.
      202       define variable v-slt-pc    as decimal      no-undo.
      203   do
      204   on error undo, return error
      205   :
      206       if p-price-no-VAT = 0
      207       then do:
      208           assign
      209               p-new-price-no-VAT = 0.0
      210               p-new-VAT          = ?
      211               p-new-SLT          = ?
      212               p-new-sum-VAT      = 0.0
      213               p-new-sum-SLT      = 0.0
      214               p-new-sum-no-VAT   = 0.0
      215               p-new-sum-road-tax = 0.0
      216               p-new-sum-full     = 0.0
      217           .
      218       end.
      219       else do:
      220           assign
      221               v-vat-pc            = p-VAT / p-price-no-VAT
      222               v-slt-pc            = p-SLT / ( p-price-no-VAT + p-VAT )
      223               p-new-price-no-VAT  = round( p-price-no-VAT, 2 )
      224               p-new-VAT           = round( p-new-price-no-VAT * v-vat-pc, 2 )
      225               p-new-SLT           = round( ( p-new-price-no-VAT + p-new-VAT ) * v-slt-pc, 2 )
      226               p-new-sum-VAT       = round( p-new-VAT          * p-qnty, 2 )
      227               p-new-sum-SLT       = round( ( p-new-price-no-VAT + p-new-VAT ) * p-qnty * v-slt-pc, 2 )
      228               p-new-sum-no-VAT    = round( p-new-price-no-VAT * p-qnty, 2 )
      229               p-new-sum-road-tax  = round( p-road-tax * p-qnty, 2 )
      230               p-new-sum-full      = round( ( p-new-price-no-VAT + p-new-VAT + p-new-SLT + p-road-tax ) * p-qnty, 2 )
      231           .
      232       end.
      233   end.
      234   end procedure.
      235   procedure p-fmt-split :
      236   define input parameter p-in-string      as character        no-undo.
      237   define input parameter p-split-length   as integer          no-undo.
      238       define variable v-start-pos     as integer      no-undo.
      239       define variable v-end-pos       as integer      no-undo.
      240       define buffer buf_temp_p-fmt_string-part        for temp_p-fmt_string-part.
      241   do
      242   for buf_temp_p-fmt_string-part
      243   on error undo, return error
      244   :
      245       empty temp-table buf_temp_p-fmt_string-part.
      246       if p-split-length < 1
      247       then do:
      248           undo, return error substitute( "p-fmt-split: Строка не может быть разбита на &1 частей", p-split-length ).
      249       end.
      250       assign
      251           p-in-string                 = trim( p-in-string )
      252           v-p-fmt-1-str-key   = 0
      253           v-start-pos                 = 1
      254           v-end-pos                   = length( p-in-string )
      255       .
      256       run p-fmt-get-string-range in this-procedure (
      257             input p-in-string
      258           , input p-split-length
      259           , input v-start-pos
      260           , output v-start-pos
      261           , output v-end-pos
      262       ).
      263       do while v-end-pos <> 0
      264       :
      265           create buf_temp_p-fmt_string-part.
      266           assign
      267               v-p-fmt-1-str-key = v-p-fmt-1-str-key + 1
      268           .
      269           assign
      270               buf_temp_p-fmt_string-part.str-key      = v-p-fmt-1-str-key
      271               buf_temp_p-fmt_string-part.string-part  = substring( p-in-string, v-start-pos, v-end-pos - v-start-pos )
      272           .
      273           assign
      274               v-start-pos = v-end-pos + 1
      275           .
      276           run p-fmt-get-string-range in this-procedure (
      277                 input p-in-string
      278               , input p-split-length
      279               , input v-start-pos
      280               , output v-start-pos
      281               , output v-end-pos
      282           ).
      283       end.
      284   end.
      285   end procedure.
      286   procedure p-fmt-get-string-range :
      287   define input parameter p-in-string      as character        no-undo.
      288   define input parameter p-split-length   as integer          no-undo.
      289   define input parameter p-old-start-pos  as integer          no-undo.
      290   define output parameter p-start-pos     as integer          no-undo.
      291   define output parameter p-end-pos       as integer          no-undo.
      292       define variable v-init-string    as character    no-undo.
      293       define variable v-temp-char      as character    no-undo.
      294       define variable v-temp-pos       as integer      no-undo.
      295       define variable v-counter        as integer      no-undo.
      296   do
      297   on error undo, return error
      298   :
      299       assign
      300           p-start-pos   = p-old-start-pos
      301           v-init-string = substring( p-in-string, p-start-pos )
      302       no-error.
      303       if error-status :error
      304       or trim( v-init-string ) = "":U
      305       then do:
      306           assign
      307               p-end-pos = 0
      308           .
      309           undo, return .
      310       end.
      311       assign
      312           v-temp-char   = substring( v-init-string, 1, 1 )
      313       .
      314       do
      315       while trim( v-temp-char ) = "":U
      316       :
      317           assign
      318               p-start-pos     = p-start-pos + 1
      319               v-init-string   = substring( p-in-string, p-start-pos )
      320               v-temp-char     = substring( v-init-string, 1, 1 )
      321           .
      322       end.
      323       assign
      324           v-temp-pos  = p-split-length
      325           v-temp-char = substring( v-init-string, v-temp-pos, 1 )
      326           v-counter   = 0
      327       .
      328       search-word-end:
      329       do
      330       while trim( v-temp-char ) <> "":U
      331       :
      332           assign
      333               v-counter   = v-counter + 1
      334           .
      335           if v-counter > 20
      336           then do:
      337               assign
      338                   v-temp-pos  = p-split-length
      339               .
      340               leave search-word-end.
      341           end.
      342           assign
      343               v-temp-pos  = v-temp-pos - 1
      344               v-temp-char = substring( v-init-string, v-temp-pos, 1 )
      345           .
      346       end.
      347       assign
      348           p-end-pos = p-start-pos + v-temp-pos - 1
      349       .
      350   end.
      351   end procedure.
      352   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      353   function breakstr returns character ( input        for-name    as character,
      354                                         input        line-length as integer,
      355                                         input-output line1       as character,
      356                                         input-output line2       as character ) :
      357     define variable ii as integer no-undo.
      358     if length( for-name ) > line-length then do:
      359       assign ii    = 1
      360              line1 = "":u
      361              line2 = "":u.
      362       if length( entry( ii, for-name , " ":u ) ) > line-length then do:
      363         assign line1 =       substring( for-name, 1, line-length     )
      364                line2 = trim( substring( for-name,    line-length + 1 ) ).
      365       end.                                                     else do:
      366         do while length( line1 + entry( ii, for-name, " ":u ) ) < ( line-length + 1 ) :
      367           assign line1 = line1 + entry( ii, for-name, " ":u ) + " ":u
      368                  ii    = ii    + 1.
      369           if length( entry( ii, for-name, " ":u ) ) > line-length then do:
      370             assign line1 = line1 + substring( for-name, length( line1 ), line-length - length( line1 ) + 1 ).
      371           end.
      372         end.
      373         assign line2 = trim( substring( for-name, length( line1 ) ) ).
      374       end.
      375     end.                                else do:
      376       assign line1 = for-name
      377              line2 = "":u.
      378     end.
      379     return ( line1 ).
      380   end function.
      381   function cross-list returns logical (
      382     input parfirst-stream  as character,
      383     input parsecond-stream as character,
      384     input pardelim         as character).
      385     if pardelim = ""
      386     or pardelim = ?
      387     then do:
      388       assign
      389         pardelim = ","
      390       .
      391     end.
      392     define variable vari            as integer no-undo .
      393     define variable varresult-cross as logical no-undo .
      394     assign
      395       varresult-cross = no
      396     .
      397     def var v-num-parfirst-stream as integer no-undo .
      398     assign
      399       v-num-parfirst-stream = num-entries(parfirst-stream, pardelim)
      400     .
      401     do vari = 1 to v-num-parfirst-stream
      402     :
      403       if lookup(entry(vari, parfirst-stream, pardelim)
      404                ,parsecond-stream
      405                ,pardelim
      406                ) > 0 then do:
      407         assign
      408           varresult-cross = yes
      409         .
      410         leave.
      411       end.
      412     end.
      413     return varresult-cross .
      414   end function.
      415   function hvrdtax return logical (input parrecid as recid):
      416   define variable varresult as logical no-undo.
      417   run hvrdtax-proc (input parrecid, output varresult).
      418   return varresult.
      419   end function.
      420   procedure hvrdtax-proc:
      421   define input  parameter parrecid  as recid   no-undo.
      422   define output parameter parresult as logical no-undo.
      423   define buffer bf_goods for ub.goods.
      424   define buffer bf_units for ub.units.
      425   define buffer rt_tax   for ub.tax.
      426   find first rt_tax   where rt_tax.tax-code    = integer('3':U) no-lock no-error.
      427   find first bf_goods where recid(bf_goods)    = parrecid              no-lock.
      428   find first bf_units where bf_units.unit-name = bf_goods.unit-base    no-lock.
      429   if available rt_tax and
      430       can-find(first ub.tax-units No-LOCK WHERE
      431                      ub.tax-units.tax-code = rt_tax.tax-code AND
      432                      LOOKUP(ub.tax-units.type, bf_units.type) > 0) then assign parresult = yes.
      433                                                       else assign parresult = no.
      434   end procedure.
      435   def var vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      436   procedure tax-name:
      437   define input  parameter pardef-tax  as character           no-undo.
      438   define output parameter parname-tax as character initial ? no-undo.
      439   define buffer bf_tax for ub.tax.
      440   do on error undo, return error :
      441      case pardef-tax:
      442         when 'vat':U then do:
      443                     find first bf_tax where bf_tax.tax-code = integer('1':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '1':U(не задействован)".
      444         end.
      445         when 'slt':U then do:
      446                     find first bf_tax where bf_tax.tax-code = integer('2':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '2':U(не задействован)".
      447         end.
      448         when 'rdt':U then do:
      449                     find first bf_tax where bf_tax.tax-code = integer('3':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '3':U(не задействован)".
      450         end.
      451         when 'exc':U then do:
      452                     find first bf_tax where bf_tax.tax-code = integer('4':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '4':U(не задействован)".
      453         end.
      454         otherwise do:
      455            return error "Задан неверный параметр " + pardef-tax + " .".
      456         end.
      457      end case.
      458   end.
      459   end procedure.
      460   define variable vss-include-info4 as character format "X(65)" no-undo
      461   initial "@(#)$Workfile$ $Revision$".
      462   define variable v-fmtcli-name          as character    no-undo.
      463   define variable v-fmtcli-engl-name     as character    no-undo.
      464   define variable v-fmtcli-addres        as character    no-undo.
      465   define variable v-fmtcli-post-addres   as character    no-undo.
      466   define variable v-fmtcli-full-addres   as character    no-undo.
      467   define variable v-fmtcli-phone         as character    no-undo.
      468   define variable v-fmtcli-inn           as character    no-undo.
      469   define variable v-fmtcli-kpp           as character    no-undo.
      470   define variable v-fmtcli-okpo          as character    no-undo.
      471   define variable v-fmtcli-country       as character    no-undo.
      472   define variable v-fmtcli-city          as character    no-undo.
      473   define variable v-fmtcli-index         as character    no-undo.
      474   define variable v-fmtcli-schet-exists  as logical      no-undo.
      475   define variable v-fmtcli-bank-exists   as logical      no-undo.
      476   define variable v-fmtcli-bank-r-schet  as character    no-undo.
      477   define variable v-fmtcli-bank-c-schet  as character    no-undo.
      478   define variable v-fmtcli-bank-bik      as character    no-undo.
      479   define variable v-fmtcli-bank-name     as character    no-undo.
      480   define variable v-fmtcli-bank-addres   as character    no-undo.
      481   define variable v-fmtcli-bank-city     as character    no-undo.
      482   procedure fmtcli-get-bank :
      483   define input parameter p-host-code      as integer          no-undo.
      484   define input parameter p-obj-type       as character        no-undo.
      485   define input parameter p-obj-code       as integer          no-undo.
      486   define input parameter p-curr-code      as integer          no-undo.
      487       define buffer buf_fin-schet     for ub.fin-schet.
      488       define buffer buf_fin-bank      for ub.fin-bank.
      489   do
      490   for buf_fin-schet
      491     , buf_fin-bank
      492   on error undo, return error
      493   :
      494       assign
      495           v-fmtcli-schet-exists       = no
      496           v-fmtcli-bank-exists        = no
      497           v-fmtcli-bank-r-schet       = "":U
      498           v-fmtcli-bank-c-schet       = "":U
      499           v-fmtcli-bank-bik           = "":U
      500           v-fmtcli-bank-name          = "":U
      501           v-fmtcli-bank-addres        = "":U
      502           v-fmtcli-bank-city          = "":U
      503       .
      504       search-for-schet:
      505       for each buf_fin-schet no-lock
      506          where buf_fin-schet.host-code = p-host-code
      507            and buf_fin-schet.cli-type  = p-obj-type
      508            and buf_fin-schet.cli-code  = p-obj-code
      509            and buf_fin-schet.curr-code = p-curr-code
      510       on error undo, return error
      511       :
      512           if buf_fin-schet.status_   = 'удал':U
      513           then do:
      514           end.
      515           else do:
      516               assign
      517                   v-fmtcli-schet-exists   = yes
      518                   v-fmtcli-bank-r-schet   = trim( buf_fin-schet.r-schet )
      519                   v-fmtcli-bank-c-schet   = trim( buf_fin-schet.c-schet )
      520               .
      521               find first buf_fin-bank no-lock
      522                    where buf_fin-bank.host-code = p-host-code
      523                      and buf_fin-bank.code-bank = buf_fin-schet.code-bank
      524               no-error.
      525               if available buf_fin-bank
      526               then do:
      527                   assign
      528                       v-fmtcli-bank-exists      = yes
      529                       v-fmtcli-bank-bik         = trim( buf_fin-bank.bik )
      530                       v-fmtcli-bank-name        = trim( buf_fin-bank.bank-name )
      531                       v-fmtcli-bank-addres      = trim(buf_fin-bank.addres)
      532                       v-fmtcli-bank-city      = trim(buf_fin-bank.bank-city)
      533                   .
      534               end.
      535               else do:
      536                   assign
      537                       v-fmtcli-bank-exists    = no
      538                       v-fmtcli-bank-bik       = "":U
      539                       v-fmtcli-bank-name      = "":U
      540                       v-fmtcli-bank-addres    = "":U
      541                       v-fmtcli-bank-city      = "":U
      542                   .
      543               end.
      544               leave search-for-schet.
      545           end.
      546       end.
      547   end.
      548   end procedure.
      549   procedure fmtcli-get-client :
      550   define input parameter p-obj-type       as character    no-undo.
      551   define input parameter p-obj-code       as integer      no-undo.
      552       define variable v-temp-fmtcli-address      as character     no-undo.
      553       define variable v-num-country-city    as integer      no-undo.
      554       define buffer buf_clients   for ub.clients.
      555       define buffer buf_firm      for ub.firm.
      556       define buffer buf_store     for ub.store.
      557       define buffer buf_shop      for ub.shop.
      558       define buffer buf_person    for ub.person.
      559   do
      560   for buf_clients
      561     , buf_firm
      562     , buf_store
      563     , buf_shop
      564     , buf_person
      565   on error undo, return error
      566   :
      567       assign
      568           v-fmtcli-name           = "":U
      569           v-fmtcli-addres         = "":U
      570           v-fmtcli-post-addres    = "":U
      571           v-fmtcli-full-addres    = "":U
      572           v-fmtcli-phone          = "":U
      573           v-fmtcli-inn            = "":U
      574           v-fmtcli-kpp            = "":U
      575           v-fmtcli-okpo           = "":U
      576           v-fmtcli-city           = "":U
      577           v-fmtcli-index          = "":U
      578           v-fmtcli-country        = "":U
      579       .
      580       find first buf_clients no-lock
      581            where buf_clients.obj-type = p-obj-type
      582              and buf_clients.obj-code = p-obj-code
      583       .
      584       assign
      585           v-fmtcli-name = buf_clients.obj-name
      586       .
      587       case buf_clients.obj-type:
      588          when 'орг':U
      589          then do:
      590               find first buf_firm no-lock
      591                    where buf_firm.firm-code = buf_clients.obj-code
      592                    no-error
      593               .
      594               if available buf_firm
      595               then do:
      596                   assign
      597                       v-num-country-city = num-entries( buf_firm.city )
      598                       v-fmtcli-engl-name = buf_firm.engl-name
      599                   .
      600                   if v-num-country-city > 0
      601                   then do:
      602                       assign
      603                           v-fmtcli-country    = trim( entry( 1, buf_firm.city ) )
      604                       .
      605                   end.
      606                   if v-num-country-city > 1
      607                   then do:
      608                       assign
      609                           v-fmtcli-city       = trim( entry( 2, buf_firm.city ) )
      610                       .
      611                   end.
      612                   run fmtcli-concatenate-strings in this-procedure (
      613                         input v-fmtcli-full-addres
      614                       , input v-fmtcli-country
      615                       , input ", ":U
      616                       , input 50
      617                       , output v-fmtcli-full-addres
      618                   ).
      619                   run fmtcli-concatenate-strings in this-procedure (
      620                         input v-fmtcli-full-addres
      621                       , input v-fmtcli-city
      622                       , input ", ":U
      623                       , input 50
      624                       , output v-fmtcli-full-addres
      625                   ).
      626                   run fmtcli-concatenate-strings in this-procedure (
      627                         input v-fmtcli-full-addres
      628                       , input IF buf_firm.ind = 0 THEN "" ELSE string( buf_firm.ind )
      629                       , input ", ":U
      630                       , input 50
      631                       , output v-fmtcli-full-addres
      632                   ).
      633                   run fmtcli-concatenate-strings in this-procedure (
      634                         input v-fmtcli-post-addres
      635                       , input v-fmtcli-country
      636                       , input ", ":U
      637                       , input 50
      638                       , output v-fmtcli-post-addres
      639                   ).
      640                   run fmtcli-concatenate-strings in this-procedure (
      641                         input v-fmtcli-post-addres
      642                       , input v-fmtcli-city
      643                       , input ", ":U
      644                       , input 50
      645                       , output v-fmtcli-post-addres
      646                   ).
      647                   run fmtcli-concatenate-strings in this-procedure (
      648                         input v-fmtcli-post-addres
      649                       , input string( buf_firm.ind )
      650                       , input ", ":U
      651                       , input 50
      652                       , output v-fmtcli-post-addres
      653                   ).
      654                   run fmtcli-concatenate-strings in this-procedure (
      655                         input substring( buf_firm.addres1, 1, 50 )
      656                       , input buf_firm.addres2
      657                       , input " ":U
      658                       , input 50
      659                       , output v-temp-fmtcli-address
      660                   ).
      661                   run fmtcli-concatenate-strings in this-procedure (
      662                         input v-temp-fmtcli-address
      663                       , input substring( buf_firm.addres1, 51, 50 )
      664                       , input " ":U
      665                       , input 50
      666                       , output v-temp-fmtcli-address
      667                   ).
      668                   run fmtcli-concatenate-strings in this-procedure (
      669                         input v-temp-fmtcli-address
      670                       , input substring( buf_firm.addres1, 101, 50 )
      671                       , input " ":U
      672                       , input 50
      673                       , output v-temp-fmtcli-address
      674                   ).
      675                   assign
      676                       v-fmtcli-addres = v-temp-fmtcli-address
      677                   .
      678                   if buf_firm.addres1 <> ?
      679                   then do:
      680                       run fmtcli-concatenate-strings in this-procedure (
      681                             input v-fmtcli-full-addres
      682                           , input v-fmtcli-addres
      683                           , input ", ":U
      684                           , input 0
      685                           , output v-fmtcli-full-addres
      686                       ).
      687                   end.
      688                   run fmtcli-concatenate-strings in this-procedure (
      689                         input substring( buf_firm.post-addr1, 1, 50 )
      690                       , input buf_firm.post-addr2
      691                       , input " ":U
      692                       , input 50
      693                       , output v-fmtcli-post-addres
      694                   ).
      695                   run fmtcli-concatenate-strings in this-procedure (
      696                         input v-fmtcli-post-addres
      697                       , input substring( buf_firm.post-addr1, 51, 50 )
      698                       , input " ":U
      699                       , input 50
      700                       , output v-fmtcli-post-addres
      701                   ).
      702                   run fmtcli-concatenate-strings in this-procedure (
      703                         input v-fmtcli-post-addres
      704                       , input substring( buf_firm.post-addr1, 101, 50 )
      705                       , input " ":U
      706                       , input 50
      707                       , output v-fmtcli-post-addres
      708                   ).
      709                   assign
      710                       v-fmtcli-phone         = buf_firm.phone
      711                       v-fmtcli-inn           = buf_firm.inn
      712                       v-fmtcli-kpp           = buf_firm.kpp
      713                       v-fmtcli-okpo          = buf_firm.okpo
      714                       v-fmtcli-index         = string( buf_firm.ind )
      715                   .
      716               end.
      717          end.
      718          when 'маг':U
      719          then do:
      720               find first buf_shop no-lock
      721                    where buf_shop.obj-code = buf_clients.obj-code
      722               .
      723               if available buf_shop
      724               then do:
      725                   run fmtcli-concatenate-strings in this-procedure (
      726                         input buf_shop.addres1
      727                       , input buf_shop.addres2
      728                       , input " ":U
      729                       , input 50
      730                       , output v-fmtcli-addres
      731                   ).
      732                   assign
      733                       v-fmtcli-full-addres = v-fmtcli-addres
      734                       v-fmtcli-post-addres = v-fmtcli-addres
      735                       v-fmtcli-phone       = buf_shop.phone
      736                       v-fmtcli-inn         = "":U
      737                       v-fmtcli-kpp         = "":U
      738                       v-fmtcli-okpo        = "":U
      739                       v-fmtcli-city        = "":U
      740                       v-fmtcli-index       = "":U
      741                   .
      742               end.
      743          end.
      744          when 'скл':U
      745          then do:
      746               find first buf_store no-lock
      747                    where buf_store.obj-code = buf_clients.obj-code
      748               .
      749               if available buf_store
      750               then do:
      751                   run fmtcli-concatenate-strings in this-procedure (
      752                         input buf_store.addres1
      753                       , input buf_store.addres2
      754                       , input " ":U
      755                       , input 50
      756                       , output v-fmtcli-addres
      757                   ).
      758                   assign
      759                       v-fmtcli-full-addres = v-fmtcli-addres
      760                       v-fmtcli-phone       = buf_store.phone
      761                       v-fmtcli-inn         = "":U
      762                       v-fmtcli-kpp         = "":U
      763                       v-fmtcli-okpo        = "":U
      764                       v-fmtcli-city        = "":U
      765                       v-fmtcli-index       = "":U
      766                   .
      767               end.
      768          end.
      769          when 'чел':U
      770          then do:
      771               find first buf_person no-lock
      772                    where buf_person.psn-code = buf_clients.obj-code
      773               .
      774               if available buf_person
      775               then do:
      776                   run fmtcli-concatenate-strings in this-procedure (
      777                         input ( if buf_person.ind = 0 or buf_person.ind = ?
      778                                 then "":U
      779                                 else string( buf_person.ind, "999999")
      780                                 )
      781                       , input buf_person.city
      782                       , input ", ":U
      783                       , input 0
      784                       , output v-fmtcli-full-addres
      785                   ).
      786                   assign
      787                       v-fmtcli-addres = buf_person.address
      788                   .
      789                   run fmtcli-concatenate-strings in this-procedure (
      790                         input v-fmtcli-full-addres
      791                       , input v-fmtcli-addres
      792                       , input ", ":U
      793                       , input 0
      794                       , output v-fmtcli-full-addres
      795                   ).
      796                   assign
      797                       v-fmtcli-phone     = buf_person.phone1
      798                       v-fmtcli-inn       = buf_person.inn
      799                       v-fmtcli-kpp       = buf_person.kpp
      800                       v-fmtcli-okpo      = buf_person.okpo
      801                       v-fmtcli-city      = buf_person.city
      802                       v-fmtcli-index     = string( buf_person.ind )
      803                   .
      804               end.
      805          end.
      806       end case.
      807   end.
      808   end procedure.
      809   procedure fmtcli-concatenate-strings :
      810   define input parameter p-string-1       as character        no-undo.
      811   define input parameter p-string-2       as character        no-undo.
      812   define input parameter p-delimiter      as character        no-undo.
      813   define input parameter p-length         as integer          no-undo.
      814   define output parameter p-out-string    as character        no-undo.
      815   do
      816   on error undo, return error
      817   :
      818       assign
      819           p-out-string = ( if p-string-1 = ?
      820                            then "":U
      821                            else trim( p-string-1 ) )
      822       .
      823       assign
      824           p-out-string = p-out-string
      825                        + ( if p-out-string = "":U
      826                            or length( p-out-string ) = p-length
      827                            or p-string-2 = ?
      828                            or trim( p-string-2 ) = "":U
      829                            then "":U
      830                            else p-delimiter )
      831                        + ( if p-string-2 = ?
      832                            or trim( p-string-2 ) = "":U
      833                            then "":U
      834                            else trim( p-string-2 ) )
      835       .
      836   end.
      837   end procedure.
