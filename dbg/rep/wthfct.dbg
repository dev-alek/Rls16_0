     1495         "Атрибут: " 'Recipient':U skip
     1496         "Значение: " v-recipient skip
     1497         trim( error-status :get-message (1) ) skip
     1498         return-value skip
     1499         view-as alert-box error.
     1500       undo, return error return-value.
     1501       end.
     1502     assign
     1503       v-recipient  = v-recipient-code
     1504       v-type-rec = substring(v-recipient-code,1,3)
     1505       v-code-rec  = int(substring(v-recipient-code,4,15))
     1506       no-error
     1507     .
     1508     if v-type-rec = ? then v-type-rec = "" .
     1509     if v-code-rec  = ? then v-code-rec  =  0 .
     1510     end procedure.
