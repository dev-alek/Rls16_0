     4396   .
     4397   define temp-table temp_line-data no-undo
     4398       field data-key     as character
     4399       field xl-line-id   as integer
     4400       field Name         as character
     4401       field pokazately   as character
     4402       field UAES         as character
     4403       field OKEI         as character
     4404       field EI           as character
     4405       field qnty         as character
     4406       field price        as character
     4407       field SumNoVAT     as character
     4408       field SumActciz    as character
     4409       field VATpc        as character
     4410       field VATsum       as character
     4411       field sum          as character
     4412       field countrycode  as character
     4413       field country      as character
     4414       field GTD          as character
     4415       index pi is primary unique xl-line-id
     4416   .
     4417   define variable v-facturxl-current-data-row     as integer      no-undo.
     4418   define variable v-facturxl-cell-file-name       as character    no-undo.
     4419   define variable v-facturxl-data-file-name       as character    no-undo.
     4420   procedure facturxl-init :
     4421       define buffer buf_temp_cell-data        for temp_cell-data.
     4422       define buffer buf_usr-flt               for ubflt.usr-flt.
     4423       define variable v-column-list as character no-undo .
     4424       define variable v-column-type as character no-undo .
     4425       define variable v-num-cloumns as integer no-undo .
     4426   do
     4427   for buf_temp_cell-data
     4428     , buf_usr-flt
     4429   on error undo, return error
     4430   :
     4431       assign
     4432           v-facturxl-current-data-row = 0
     4433       .
     4434       run gbl/_tmpfile.p (
     4435             input "xd"
     4436           , input ".txt"
     4437           , output v-facturxl-data-file-name
     4438       ).
     4439       output stream excel-line to value( v-facturxl-data-file-name ).
     4440       run gbl/_tmpfile.p (
     4441             input "xc"
     4442           , input ".txt"
     4443           , output v-facturxl-cell-file-name
     4444       ).
     4445       output stream excel-cell to value( v-facturxl-cell-file-name ).
     4446       run facturxl-write-cell-data in this-procedure (
     4447             input "valutCode":U
     4448           , input if printrubl then "0":U else "1":U
     4449       ).
     4450     if lookup ("corr" , p-mode) <> 0 then do :
     4451       v-column-list = "Name,pokazately,UAES,OKEI,EI,qnty,price,SumNoVAT,SumActciz,VATpc,VATsum,sum":U .
     4452       v-column-type = "S,S,S,I,S,D,C,C,S,D,C,C":U .
     4453     end.
     4454     else do :
     4455       v-column-list = "Name,UAES,OKEI,EI,qnty,price,SumNoVAT,SumActciz,VATpc,VATsum,sum,countrycode,country,GTD":U .
     4456       v-column-type = "S,S,I,S,D,C,C,S,D,C,C,I,S,S":U .
     4457     end.
     4458     v-num-cloumns = num-entries(v-column-list) .
     4459     run facturxl-write-cell-data in this-procedure (
     4460             input "columnList":U
     4461           , input v-column-list
     4462     ).
     4463     run facturxl-write-cell-data in this-procedure (
     4464             input "columnType":U
     4465           , input v-column-type
     4466     ).
     4467     run facturxl-write-cell-data in this-procedure (
     4468             input "columnAmount":U
     4469           , input string(v-num-cloumns)
     4470     ).
     4471     if lookup ("corr" , p-mode) <> 0 then .
     4472     else do :
     4473       run facturxl-write-cell-data in this-procedure (
     4474             input "subtotalList":U
     4475           , input "SumNoVAT,VATsum,sum":U
     4476       ).
     4477       run facturxl-write-cell-data in this-procedure (
     4478             input "subtotalType":U
     4479           , input "S,S,S":U
     4480       ).
     4481       run facturxl-write-cell-data in this-procedure (
     4482             input "subtotalAmount":U
     4483           , input "3":U
     4484       ).
     4485     end.
     4486   end.
     4487   end procedure.
     4488   procedure facturxl-close :
     4489   do
     4490   on error undo, return error
     4491   :
     4492       output stream excel-line close.
     4493       output stream excel-cell close.
     4494       output to value( string( session:temp-directory + "$" + string( g#report-num ) ) + ".txl" ) append.
     4495           export "exe/sf_97.xlt":U.
     4496           export "exe/t_97.bas":U.
     4497           export v-facturxl-cell-file-name.
     4498           export v-facturxl-data-file-name.
     4499       output close.
     4500   end.
     4501   end procedure.
