     4677       .
     4678       assign
     4679           buf_temp_line-data.data-key     = "LD":U
     4680           buf_temp_line-data.xl-line-id   = v-facturxl-current-data-row
     4681           buf_temp_line-data.Name         = p-Name
     4682           buf_temp_line-data.pokazately   = p-pokazately
     4683           buf_temp_line-data.UAES         = p-UAES
     4684           buf_temp_line-data.OKEI         = p-OKEI
     4685           buf_temp_line-data.EI           = p-EI
     4686           buf_temp_line-data.qnty         = p-qnty
     4687           buf_temp_line-data.price        = p-price
     4688           buf_temp_line-data.SumNoVAT     = p-SumNoVAT
     4689           buf_temp_line-data.SumActciz    = p-SumActciz
     4690           buf_temp_line-data.VATpc        = p-VATpc
     4691           buf_temp_line-data.VATsum       = p-VATsum
     4692           buf_temp_line-data.sum          = p-sum
     4693       .
