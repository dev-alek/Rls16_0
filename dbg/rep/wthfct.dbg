     1158       define variable v-outC      as character     no-undo.
     1159       assign
     1160           v-torgconf-outdate  = no
     1161           v-torgconf-outnum   = no
     1162           v-torgconf-outprim  = no
     1163           v-torgconf-outdisc  = no
     1164           v-torgconf-outsubs  = no
     1165           v-torgconf-outrecv  = no
     1166           v-torgconf-outegrp  = no
     1167           v-torgconf-outt12   = no
     1168           v-torgconf-outappr  = no
     1169           v-torgconf-outrubl  = no
     1170           v-torgconf-outhold  = no
     1171           v-torgconf-outobj   = no
     1172           v-torgconf-outexlst = no
     1173           v-torgconf-outexpas = "":U
     1174           v-torgconf-outprncd = yes
     1175           v-torgconf-outares  = no
     1176           v-torgconf-outsend  = no
     1177           v-torgconf-outasend  = no
