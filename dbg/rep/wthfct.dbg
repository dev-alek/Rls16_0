     1212     ,output v-value-decimal
     1213     ,output v-value-integer
     1214     ,output v-value-logical
     1215     ,output par-type
     1216     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1217     ) no-error .
     1218   for each thbjattr_thbj-attr :
     1219       if thbjattr_thbj-attr.prop-code = 'outdate':U  then v-outdate  =  thbjattr_thbj-attr.property-value-character .
     1220       if thbjattr_thbj-attr.prop-code = 'outares':U  then v-outares  =  thbjattr_thbj-attr.property-value-character .
     1221       if thbjattr_thbj-attr.prop-code = 'outnum':U   then v-outnum   =  thbjattr_thbj-attr.property-value-character .
     1222       if thbjattr_thbj-attr.prop-code = 'outprim':U  then v-outprim  =  thbjattr_thbj-attr.property-value-character .
     1223       if thbjattr_thbj-attr.prop-code = 'outdisc':U  then v-outdisc  =  thbjattr_thbj-attr.property-value-character .
     1224       if thbjattr_thbj-attr.prop-code = 'outsubs':U  then v-outsubs  =  thbjattr_thbj-attr.property-value-character .
     1225       if thbjattr_thbj-attr.prop-code = 'outegrp':U  then v-outegrp  =  thbjattr_thbj-attr.property-value-character .
     1226       if thbjattr_thbj-attr.prop-code = 'outt12':U   then v-outt12   =  thbjattr_thbj-attr.property-value-character .
     1227       if thbjattr_thbj-attr.prop-code = 'outappr':U  then v-outappr  =  thbjattr_thbj-attr.property-value-character .
     1228       if thbjattr_thbj-attr.prop-code = 'outrubl':U  then v-outrubl  =  thbjattr_thbj-attr.property-value-character .
     1229       if thbjattr_thbj-attr.prop-code = 'outhold':U  then v-outhold  =  thbjattr_thbj-attr.property-value-character .
     1230       if thbjattr_thbj-attr.prop-code = 'outobj':U   then v-outobj   =  thbjattr_thbj-attr.property-value-character .
     1231       if thbjattr_thbj-attr.prop-code = 'outsend':U  then v-outsend  =  thbjattr_thbj-attr.property-value-character .
     1232       if thbjattr_thbj-attr.prop-code = 'outasend':U then v-outasend =  thbjattr_thbj-attr.property-value-character .
     1233       if thbjattr_thbj-attr.prop-code = 'outogr':U   then v-torgconf-outogr   =  thbjattr_thbj-attr.property-value-character .
     1234       if thbjattr_thbj-attr.prop-code = 'outR':U     then v-torgconf-outR     =  thbjattr_thbj-attr.property-value-character .
     1235       if thbjattr_thbj-attr.prop-code = 'outB':U     then v-torgconf-outB     =  thbjattr_thbj-attr.property-value-character .
     1236       if thbjattr_thbj-attr.prop-code = 'outssdoc':U then v-torgconf-outssdoc =  thbjattr_thbj-attr.property-value-character .
     1237       if thbjattr_thbj-attr.prop-code = 'outC':U     then v-torgconf-outC     =  thbjattr_thbj-attr.property-value-character .
     1238   end.
     1239       run gbl/conf-rd.p ("outexpas", "":U, "":U, 0, "":U, "":U, "":U, no, output v-torgconf-outexpas, output v-par-type) no-error.
     1240       if error-status :error
     1241       then do:
     1242           assign
     1243               v-torgconf-outexpas = "":U
     1244           .
     1245       end.
     1246       assign
     1247           v-torgconf-outprncd = ( v-outprncd = "yes":U )
     1248       .
     1249       if p-form-name <> ""
     1250       and p-form-name <> ?
     1251       then do:
     1252           run gbl/conf-rd.p ("outexlst" , p-host-code, p-obj-type, p-obj-code, "", "", "", no, output v-outexlst , output v-par-type) no-error.
     1253           if error-status :error
     1254           then do:
     1255               assign
     1256                   v-outexlst           = ""
     1257               .
     1258           end.
     1259           if lookup( p-form-name, v-outdate ) <> 0
     1260           then do:
     1261               assign
     1262                   v-torgconf-outdate  = yes
     1263               .
     1264           end.
     1265           if lookup( p-form-name, v-outares ) <> 0
     1266           then do:
     1267               assign
     1268                   v-torgconf-outares  = yes
     1269               .
     1270           end.
     1271           if lookup( p-form-name, v-outnum  ) <> 0
     1272           then do:
     1273               assign
     1274                   v-torgconf-outnum   = yes
     1275               .
     1276           end.
     1277           if lookup( p-form-name, v-outprim ) <> 0
     1278           then do:
     1279               assign
     1280                   v-torgconf-outprim  = yes
     1281               .
     1282           end.
     1283           if lookup( p-form-name, v-outdisc ) <> 0
     1284           then do:
     1285               assign
     1286                   v-torgconf-outdisc  = yes
     1287               .
     1288           end.
     1289           if lookup( p-form-name, v-outsubs ) <> 0
     1290           then do:
     1291               assign
     1292                   v-torgconf-outsubs  = yes
     1293               .
     1294           end.
     1295           if lookup( p-form-name, v-outrecv ) <> 0
     1296           then do:
     1297               assign
     1298                   v-torgconf-outrecv  = yes
     1299               .
     1300           end.
     1301           if lookup( p-form-name, v-outegrp ) <> 0
     1302           then do:
     1303               assign
     1304                   v-torgconf-outegrp  = yes
     1305               .
     1306           end.
     1307           if lookup( p-form-name, v-outt12  ) <> 0
     1308           then do:
     1309               assign
