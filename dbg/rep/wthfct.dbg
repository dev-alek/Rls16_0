     4695                           buf_temp_line-data.data-key
     4696           chr(9)   buf_temp_line-data.Name
     4697           chr(9)   buf_temp_line-data.pokazately
     4698           chr(9)   buf_temp_line-data.UAES
     4699           chr(9)   buf_temp_line-data.OKEI
     4700           chr(9)   buf_temp_line-data.EI
     4701           chr(9)   buf_temp_line-data.qnty
     4702           chr(9)   buf_temp_line-data.price
     4703           chr(9)   buf_temp_line-data.SumNoVAT
     4704           chr(9)   buf_temp_line-data.SumActciz
     4705           chr(9)   buf_temp_line-data.VATpc
     4706           chr(9)   buf_temp_line-data.VATsum
     4707           chr(9)   buf_temp_line-data.sum
     4708           chr(10)
     4709       .
     4710   end.
     4711   end procedure.
     4712   procedure facturxl-run-excel :
     4713   define input parameter p-header-filename    as character        no-undo.
     4714   define input parameter p-data-filename      as character        no-undo.
     4715       define variable v-template-file-name    as character    no-undo.
     4716       define variable v-vb-file-name          as character    no-undo.
     4717       define buffer buf_temp-param for temp-param .
     4718   do
     4719   for buf_temp-param
     4720   on error undo, return error
     4721   :
     4722       create buf_temp-param.
     4723       assign
     4724           v-template-file-name    = search( "exe/sf_97.xlt" )
     4725           v-vb-file-name          = search( "exe/t_97.bas")
     4726       .
     4727       if v-template-file-name = ?
     4728       or v-template-file-name = "":U
     4729       then do:
     4730           message
     4731               "Ошибка имени файла шаблона."
     4732           view-as alert-box error.
     4733       end.
     4734       if v-vb-file-name = ?
     4735       or v-vb-file-name = "":U
     4736       then do:
     4737           message
     4738               "Ошибка имени файла кода обработки."
     4739           view-as alert-box error.
     4740       end.
     4741       run paramls-write in this-procedure (
     4742             input "template":U
     4743           , input "template-file-name":U
     4744           , input v-template-file-name
     4745       ).
     4746       run paramls-write in this-procedure (
     4747             input "template":U
     4748           , input "vb-file-name":U
     4749           , input v-vb-file-name
     4750       ).
     4751       run paramls-write in this-procedure (
     4752             input "data":U
     4753           , input "data-header-filename":U
     4754           , input p-header-filename
     4755       ).
     4756       run paramls-write in this-procedure (
     4757             input "data":U
     4758           , input "data-filename":U
     4759           , input p-data-filename
     4760       ).
     4761       run gbl/macroxlt.p (
     4762           input-output table buf_temp-param
     4763       ) no-error.
     4764       if error-status :error
     4765       then do:
     4766           message
     4767                    vss-workfile vss-revision vss-description
     4768               skip(1)
     4769               skip "Ошибка создания файла Excel."
     4770               skip return-value
     4771               skip trim(error-status :get-message(1))
     4772                    trim(error-status :get-message(2))
     4773                    trim(error-status :get-message(3))
     4774           view-as alert-box error.
     4775           undo, return error .
     4776       end.
     4777   end.
     4778   end procedure.
