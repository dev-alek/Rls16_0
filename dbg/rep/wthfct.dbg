     4299   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     4300   procedure paramls-clear :
     4301     define buffer buf_temp-param for temp-param .
     4302     do
     4303     on error undo, return error return-value
     4304     :
     4305       for each buf_temp-param
     4306       on error undo, return error
     4307       :
     4308         delete buf_temp-param .
     4309       end.
     4310     end.
     4311   end procedure.
     4312   procedure paramls-write :
     4313     define input  parameter p-code     as character no-undo .
     4314     define input  parameter p-sub-code as character no-undo .
     4315     define input  parameter p-value    as character no-undo .
     4316     define buffer buf_temp-param for temp-param .
     4317     do
     4318     on error undo, return error return-value
     4319     :
     4320       find first buf_temp-param
     4321         where buf_temp-param.param-code     = p-code
     4322           and buf_temp-param.param-sub-code = p-sub-code
     4323         no-error .
     4324       if not available buf_temp-param then do:
     4325         create buf_temp-param .
     4326         assign
     4327           buf_temp-param.param-code     = p-code
     4328           buf_temp-param.param-sub-code = p-sub-code
     4329         .
     4330       end.
     4331       assign
     4332         buf_temp-param.param-value = p-value
     4333       .
     4334     end.
     4335   end procedure.
     4336   procedure paramls-read :
     4337     define input  parameter p-code          as character no-undo .
     4338     define input  parameter p-sub-code      as character no-undo .
     4339     define input  parameter p-default-value as character no-undo .
     4340     define output parameter p-value         as character no-undo .
     4341     define buffer buf_temp-param for temp-param .
     4342     do
     4343     on error undo, return error return-value
     4344     :
     4345       find first buf_temp-param
     4346         where buf_temp-param.param-code     = p-code
     4347           and buf_temp-param.param-sub-code = p-sub-code
     4348         no-error .
     4349       if available buf_temp-param then do:
     4350         assign
     4351           p-value = buf_temp-param.param-value
     4352         .
     4353       end.
     4354       else do:
     4355         assign
     4356           p-value = p-default-value
     4357         .
     4358       end.
     4359     end.
     4360   end procedure.
     4361   procedure paramls-append :
     4362     define input  parameter p-code     as character no-undo .
     4363     define input  parameter p-sub-code as character no-undo .
     4364     define input  parameter p-value    as character no-undo .
     4365     define buffer buf_temp-param for temp-param .
     4366     do
     4367     on error undo, return error return-value
     4368     :
     4369       find first buf_temp-param
     4370            where buf_temp-param.param-code     = p-code
     4371              and buf_temp-param.param-sub-code = p-sub-code
     4372         no-error .
     4373       if not available buf_temp-param then do:
     4374         create buf_temp-param .
     4375         assign
     4376           buf_temp-param.param-code     = p-code
     4377           buf_temp-param.param-sub-code = p-sub-code
     4378           buf_temp-param.param-value    = p-value
     4379         .
     4380       end.
     4381       else do:
     4382           assign
     4383               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     4384           .
     4385       end.
     4386     end.
     4387   end procedure.
