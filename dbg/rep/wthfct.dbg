     1311               .
     1312           end.
     1313           if lookup( p-form-name, v-outappr  ) <> 0
     1314           then do:
     1315               assign
     1316                   v-torgconf-outappr   = yes
     1317               .
     1318           end.
     1319           if lookup( p-form-name, v-outrubl  ) <> 0
     1320           then do:
     1321               assign
     1322                   v-torgconf-outrubl   = yes
     1323               .
     1324           end.
     1325           if lookup( p-form-name, v-outhold  ) <> 0
     1326           then do:
     1327               assign
     1328                   v-torgconf-outhold   = yes
     1329               .
     1330           end.
     1331           if lookup( p-form-name, v-outobj   ) <> 0
     1332           then do:
     1333               assign
     1334                   v-torgconf-outobj    = yes
     1335               .
     1336           end.
     1337           if lookup( p-form-name, v-outsend   ) <> 0
     1338           then do:
     1339               assign
     1340                   v-torgconf-outsend    = yes
     1341               .
     1342           end.
     1343           if lookup( p-form-name, v-outasend   ) <> 0
     1344           then do:
