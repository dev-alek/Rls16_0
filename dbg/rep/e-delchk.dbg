     1018        '~`':U +
     1019        '~`':U +
     1020        '~`~`~`~`~`~`~`~`~`~`~`':U +
     1021        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1022            THEN "^^":U
     1023        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1024             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1025   PROCEDURE adm-apply-entry :
     1026     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1027   END PROCEDURE.
     1028   PROCEDURE adm-destroy :
     1029    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1030   END PROCEDURE.
     1031   PROCEDURE adm-disable :
     1032       DISABLE rect-3 bt-date-to bt-date-from F-date-to F-date-from flagOnlyDel WITH FRAME F-Main.
     1033       RUN dispatch ('disable-fields':U).
     1034       RUN set-attribute-list ('ENABLED=no':U).
     1035       RETURN.
     1036   END PROCEDURE.
     1037   PROCEDURE adm-edit-attribute-list :
     1038         RUN adm/support/contnrd.w (INPUT THIS-PROCEDURE).
     1039         RETURN.
     1040   END PROCEDURE.
     1041   PROCEDURE adm-enable :
     1042       ENABLE UNLESS-HIDDEN rect-3 bt-date-to bt-date-from F-date-to F-date-from flagOnlyDel WITH FRAME F-Main.
     1043       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     1044       RUN set-attribute-list ('ENABLED=yes':U).
     1045       RETURN.
     1046   END PROCEDURE.
     1047   PROCEDURE adm-exit :
     1048        RUN notify ('exit':U).
     1049     RETURN.
     1050   END PROCEDURE.
     1051   PROCEDURE adm-hide :
     1052     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1053   END PROCEDURE.
     1054   PROCEDURE adm-initialize :
     1055     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1056   END PROCEDURE.
     1057   PROCEDURE adm-show-errors :
     1058       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1059       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1060           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1061       END.
     1062       RETURN.
     1063   END PROCEDURE.
     1064   PROCEDURE adm-UIB-mode :
     1065     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1066   END PROCEDURE.
     1067   PROCEDURE adm-view :
     1068     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1069   END PROCEDURE.
     1070   PROCEDURE dispatch :
     1071       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1072       RUN broker-dispatch IN adm-broker-hdl
     1073           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1074       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1075   END PROCEDURE.
     1076   PROCEDURE ensure-broker :
     1077   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1078   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1079   DO:
     1080       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1081       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1082   END.
     1083   END PROCEDURE.
     1084   PROCEDURE get-attribute :
     1085     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1086     RUN broker-get-attribute IN adm-broker-hdl
     1087         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1088     RETURN RETURN-VALUE.
     1089   END PROCEDURE.
     1090   PROCEDURE get-attribute-list :
     1091     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1092     RUN broker-get-attribute-list IN adm-broker-hdl
     1093         (INPUT THIS-PROCEDURE,
     1094          INPUT ?,
     1095          OUTPUT p-attr-list) NO-ERROR.
     1096     RETURN.
     1097   END PROCEDURE.
     1098   PROCEDURE new-state :
     1099     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1100     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1101     RETURN.
     1102   END PROCEDURE.
     1103   PROCEDURE notify :
     1104     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1105     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1106     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1107         RETURN "ADM-ERROR":U.
     1108     RETURN.
     1109   END PROCEDURE.
     1110   PROCEDURE set-attribute-list :
     1111     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1112     RUN ensure-broker.
     1113     RUN broker-set-attribute-list IN adm-broker-hdl
     1114         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1115     RETURN.
     1116   END PROCEDURE.
     1117   PROCEDURE set-position :
     1118       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1119       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1120       IF VALID-HANDLE(adm-object-hdl) THEN
     1121       DO:
     1122           DEFINE VARIABLE parent-hdl AS HANDLE NO-UNDO.
     1123           IF adm-object-hdl:TYPE = "WINDOW":U THEN
     1124           DO:
     1125             IF p-row = 0 THEN p-row =
     1126               (SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2.
     1127             IF p-col = 0 THEN p-col =
     1128               (SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2.
     1129           END.
     1130           ELSE IF adm-object-hdl:TYPE = "DIALOG-BOX":U THEN
     1131           DO:
     1132             parent-hdl = adm-object-hdl:PARENT.
     1133             IF p-row = 0 THEN p-row =
     1134               ((SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2) -
     1135                 parent-hdl:ROW.
     1136             IF p-col = 0 THEN p-col =
     1137               ((SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2) -
     1138                 parent-hdl:COL.
     1139           END.
     1140           IF p-row GE 0 AND p-row < 1 THEN p-row = 1.
     1141           IF p-col GE 0 AND p-col < 1 THEN p-col = 1.
     1142         ASSIGN adm-object-hdl:ROW    =   p-row
     1143                adm-object-hdl:COLUMN =   p-col.
     1144       END.
     1145       RETURN.
     1146   END PROCEDURE.
     1147   RUN set-attribute-list ("CURRENT-PAGE=0,ADM-OBJECT-HANDLE=":U +
     1148       STRING(adm-object-hdl)).
     1149   PAUSE 0 BEFORE-HIDE.
     1150   PROCEDURE adm-change-page :
     1151     RUN broker-change-page IN adm-broker-hdl (INPUT THIS-PROCEDURE) NO-ERROR.
     1152     END PROCEDURE.
     1153   PROCEDURE delete-page :
     1154     DEFINE INPUT PARAMETER p-page# AS INTEGER NO-UNDO.
     1155     RUN broker-delete-page IN adm-broker-hdl
     1156         (INPUT THIS-PROCEDURE, INPUT p-page#).
     1157     END PROCEDURE.
     1158   PROCEDURE init-object :
     1159     DEFINE INPUT PARAMETER  p-proc-name   AS CHARACTER NO-UNDO.
     1160     DEFINE INPUT PARAMETER  p-parent-hdl  AS HANDLE    NO-UNDO.
     1161     DEFINE INPUT PARAMETER  p-attr-list   AS CHARACTER NO-UNDO.
     1162     DEFINE OUTPUT PARAMETER p-proc-hdl    AS HANDLE    NO-UNDO.
     1163     RUN broker-init-object IN adm-broker-hdl
     1164         (INPUT THIS-PROCEDURE, INPUT p-proc-name, INPUT p-parent-hdl,
     1165          INPUT p-attr-list, OUTPUT p-proc-hdl) NO-ERROR.
     1166     RETURN.
     1167   END PROCEDURE.
     1168   PROCEDURE init-pages :
     1169     DEFINE INPUT PARAMETER p-page-list      AS CHARACTER NO-UNDO.
     1170     RUN broker-init-pages IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1171         INPUT p-page-list) NO-ERROR.
     1172     END PROCEDURE.
     1173   PROCEDURE select-page :
     1174     DEFINE INPUT PARAMETER p-page#     AS INTEGER   NO-UNDO.
     1175     RUN broker-select-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1176         INPUT p-page#) NO-ERROR.
     1177     END PROCEDURE.
     1178   PROCEDURE view-page :
     1179     DEFINE INPUT PARAMETER p-page#      AS INTEGER   NO-UNDO.
     1180     RUN broker-view-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1181         INPUT p-page#).
     1182     END PROCEDURE.
     1183   ON CHOOSE OF bt-date-from IN FRAME F-Main
     1184   DO:
     1185       run sel-date in this-procedure
     1186         (input F-date-from :handle
     1187         ,input ""
     1188         ) .
     1189     END.
     1190   ON CHOOSE OF bt-date-to IN FRAME F-Main
     1191   DO:
     1192       run sel-date in this-procedure
     1193         (input F-date-to :handle
     1194         ,input ""
     1195         ) .
     1196     END.
     1197   ON LEAVE OF F-date-from IN FRAME F-Main
     1198   DO:
     1199       assign F-date-from.
     1200       if F-date-from < F-date-to then
     1201       do:
     1202         message "Дата начала не может быть больше конечной даты"
     1203           view-as alert-box.
     1204         return no-apply .
     1205       end.
     1206     END.
     1207   ON RETURN OF F-date-from IN FRAME F-Main
     1208   DO:
     1209       apply "TAB":U to self .
     1210       return no-apply .
     1211     END.
     1212   ON TAB OF F-date-from IN FRAME F-Main
     1213   DO:
     1214       if string(F-date-from) <> F-date-from:screen-value then
     1215       do:
     1216         assign F-date-from .
     1217       end.
     1218       if F-date-from < F-date-to then
     1219       do:
     1220         message "Дата начала не может быть больше конечной даты"
     1221           view-as alert-box.
     1222         return no-apply .
     1223       end.
     1224     END.
     1225   ON LEAVE OF F-date-to IN FRAME F-Main
     1226   DO:
     1227       assign F-date-to .
     1228       if F-date-from < F-date-to then
     1229       do:
     1230         message "Дата начала не может быть больше конечной даты"
     1231           view-as alert-box.
     1232         return no-apply .
     1233       end.
     1234     END.
     1235   ON RETURN OF F-date-to IN FRAME F-Main
     1236   DO:
     1237       apply "TAB":U to self .
     1238       return no-apply .
     1239     END.
     1240   ON TAB OF F-date-to IN FRAME F-Main
     1241   DO:
     1242       if string(F-date-from) <> F-date-from:screen-value then
     1243       do:
     1244         assign F-date-to .
     1245       end.
     1246       if F-date-from < F-date-to then
     1247       do:
     1248         message "Дата начала не может быть больше конечной даты"
     1249           view-as alert-box.
     1250         return no-apply .
     1251       end.
     1252     END.
     1253   ON VALUE-CHANGED OF flagOnlyDel IN FRAME F-Main
     1254   DO:
     1255     assign flagOnlyDel .
     1256     if flagOnlyDel then do:
     1257       if F-date-from = ? or F-date-to = ? then do:
     1258         message "Заполните даты удаления чека"
     1259         view-as alert-box.
     1260         flagOnlyDel = false .
     1261         flagOnlyDel:screen-value = string(false) .
     1262       end.
     1263     end.
     1264   END.
     1265   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1266   on ' ' of f-date-from in frame F-Main
     1267   do:
     1268     if (can-query (self, "sensitive")
     1269        and
     1270        self :sensitive = true
     1271        )
     1272     or (can-query (self, "read-only")
     1273        and
     1274        self :read-only = false
     1275        )
     1276     then do:
     1277       assign
     1278         self :screen-value = ?
     1279       .
     1280     end.
     1281     return no-apply.
     1282   end.
     1283   on delete-character of f-date-from in frame F-Main
     1284   do:
     1285     if (can-query (self, "sensitive")
     1286        and
     1287        self :sensitive = true
     1288        )
     1289     or (can-query (self, "read-only")
     1290        and
     1291        self :read-only = false
     1292        )
     1293     then do:
     1294       assign
     1295         self :screen-value = ?
     1296       .
     1297     end.
     1298     return no-apply.
     1299   end.
     1300   on ctrl-d of f-date-from in frame F-Main
     1301   do:
     1302     define variable v-curr-sv-date as date no-undo .
     1303     if (can-query (self, "sensitive")
     1304        and
     1305        self :sensitive = true
     1306        )
     1307     or (can-query (self, "read-only")
     1308        and
     1309        self :read-only = false
     1310        )
     1311     then do:
     1312       if self :handle <> focus :handle
     1313       then do:
     1314         apply "entry":u to self .
     1315       end.
     1316       run gbl/getcurdt.p
     1317         (output v-curr-sv-date
     1318         ) .
     1319       assign
     1320         self :screen-value = string(v-curr-sv-date) .
     1321       .
     1322     end.
     1323     return no-apply.
     1324   end.
     1325   on ctrl-b of f-date-from in frame F-Main
     1326   do:
     1327     if (can-query (self, "sensitive")
     1328        and
     1329        self :sensitive = true
     1330        )
     1331     or (can-query (self, "read-only")
     1332        and
     1333        self :read-only = false
     1334        )
     1335     then do:
     1336       if self :handle <> focus :handle
     1337       then do:
     1338         apply "entry":u to self .
     1339       end.
     1340       define variable v-curr-sv-date as date no-undo .
     1341       define variable v-new-sv-date  as date no-undo .
     1342       assign
     1343         v-curr-sv-date = date(self :screen-value) no-error
     1344       .
     1345       if v-curr-sv-date = ?
     1346       then do:
     1347         run gbl/getcurdt.p
     1348           (output v-curr-sv-date
     1349           ) .
     1350       end.
     1351       if v-curr-sv-date <> ?
     1352       then do:
     1353         assign
     1354           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     1355         .
     1356         assign
     1357           self :screen-value = string(v-new-sv-date) .
     1358         .
     1359       end.
     1360     end.
     1361     return no-apply .
     1362   end.
     1363   on ctrl-e of f-date-from in frame F-Main
     1364   do:
     1365     if (can-query (self, "sensitive")
     1366        and
     1367        self :sensitive = true
     1368        )
     1369     or (can-query (self, "read-only")
     1370        and
     1371        self :read-only = false
     1372        )
     1373     then do:
     1374       if self :handle <> focus :handle
     1375       then do:
     1376         apply "entry":u to self .
     1377       end.
     1378       define variable v-curr-sv-date as date no-undo .
     1379       define variable v-new-sv-date  as date no-undo .
     1380       assign
     1381         v-curr-sv-date = date(self :screen-value) no-error
     1382       .
     1383       if v-curr-sv-date = ?
     1384       then do:
     1385         run gbl/getcurdt.p
     1386           (output v-curr-sv-date
     1387           ) .
     1388       end.
     1389       if v-curr-sv-date <> ?
     1390       then do:
     1391         run gbl/lastdate.p
     1392           (input  v-curr-sv-date
     1393           ,output v-new-sv-date
     1394           ).
     1395         assign
     1396           self :screen-value = string(v-new-sv-date) .
     1397         .
     1398       end.
     1399     end.
     1400     return no-apply .
     1401   end.
     1402   on ctrl-f of f-date-from in frame F-Main
     1403   do:
     1404     if (can-query (self, "sensitive")
     1405        and
     1406        self :sensitive = true
     1407        )
     1408     or (can-query (self, "read-only")
     1409        and
     1410        self :read-only = false
     1411        )
     1412     then do:
     1413       if self :handle <> focus :handle
     1414       then do:
     1415         apply "entry":u to self .
     1416       end.
     1417       define variable v-ok            as logical   no-undo .
     1418       define variable v-curr-sv-date  as date      no-undo .
     1419       define variable v-description   as character no-undo .
     1420       assign
     1421         v-curr-sv-date = date(self :screen-value) no-error
     1422       .
     1423       if v-curr-sv-date = ?
     1424       then do:
     1425         run gbl/getcurdt.p
     1426           (output v-curr-sv-date
     1427           ) .
     1428       end.
     1429       if v-curr-sv-date <> ?
     1430       then do:
     1431         run gbl/d-inpday.w
     1432           (input ?
     1433           ,input "Выбор даты"
     1434           ,input v-description
     1435           ,input ""
     1436           ,input-output v-curr-sv-date
     1437           ,output v-ok
     1438           ).
     1439         if v-ok = true
     1440         then do:
     1441           assign
     1442             self :screen-value = string(v-curr-sv-date) .
     1443           .
     1444         end.
     1445       end.
     1446     end.
     1447     return no-apply .
     1448   end.
     1449     define MENU m-ed-date16
     1450       MENU-ITEM m-ed-date16-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
     1451       MENU-ITEM m-ed-date16-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
     1452       MENU-ITEM m-ed-date16-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
     1453       MENU-ITEM m-ed-date16-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
     1454       .
     1455     if f-date-from :POPUP-MENU in frame F-Main = ?
     1456     then do:
     1457       ASSIGN
     1458         f-date-from :POPUP-MENU in frame F-Main = MENU m-ed-date16 :HANDLE
     1459         f-date-from :MENU-MOUSE in frame F-Main = 3
     1460       .
     1461     end.
     1462     define variable v-label-handle16 as handle no-undo .
     1463     assign
     1464       v-label-handle16 = f-date-from :side-label-handle in frame F-Main
     1465     .
     1466     if valid-handle (v-label-handle16)
     1467     then do:
     1468       if v-label-handle16 :tooltip = ""
     1469       or v-label-handle16 :tooltip = ?
     1470       then do:
     1471         assign
     1472           v-label-handle16 :tooltip = "Ctrl-D - текущая, Ctrl-B - начало, Ctrl-E - конец, Ctrl-F - календарь, Прав.Клавиша Мыши - Popup Menu"
     1473         .
     1474       end.
     1475     end.
     1476     ON CHOOSE OF MENU-ITEM m-ed-date16-1 in menu m-ed-date16 DO:
     1477       apply "ctrl-b":U to f-date-from in frame F-Main .
     1478     END.
     1479     ON CHOOSE OF MENU-ITEM m-ed-date16-2 in menu m-ed-date16 DO:
     1480       apply "ctrl-d":U to f-date-from in frame F-Main .
     1481     END.
     1482     ON CHOOSE OF MENU-ITEM m-ed-date16-3 in menu m-ed-date16 DO:
     1483       apply "ctrl-e":U to f-date-from in frame F-Main .
     1484     END.
     1485     ON CHOOSE OF MENU-ITEM m-ed-date16-4 in menu m-ed-date16 DO:
     1486       apply "ctrl-f":U to f-date-from in frame F-Main .
     1487     END.
