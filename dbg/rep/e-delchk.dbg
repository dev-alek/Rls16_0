     1575       then do:
     1576         assign
     1577           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     1578         .
     1579         assign
     1580           self :screen-value = string(v-new-sv-date) .
     1581         .
     1582       end.
     1583     end.
     1584     return no-apply .
     1585   end.
     1586   on ctrl-e of f-date-to in frame F-Main
     1587   do:
     1588     if (can-query (self, "sensitive")
     1589        and
     1590        self :sensitive = true
     1591        )
     1592     or (can-query (self, "read-only")
     1593        and
     1594        self :read-only = false
     1595        )
     1596     then do:
     1597       if self :handle <> focus :handle
     1598       then do:
     1599         apply "entry":u to self .
     1600       end.
     1601       define variable v-curr-sv-date as date no-undo .
     1602       define variable v-new-sv-date  as date no-undo .
     1603       assign
     1604         v-curr-sv-date = date(self :screen-value) no-error
     1605       .
     1606       if v-curr-sv-date = ?
     1607       then do:
     1608         run gbl/getcurdt.p
     1609           (output v-curr-sv-date
     1610           ) .
     1611       end.
     1612       if v-curr-sv-date <> ?
     1613       then do:
     1614         run gbl/lastdate.p
     1615           (input  v-curr-sv-date
     1616           ,output v-new-sv-date
     1617           ).
     1618         assign
     1619           self :screen-value = string(v-new-sv-date) .
     1620         .
     1621       end.
     1622     end.
     1623     return no-apply .
     1624   end.
     1625   on ctrl-f of f-date-to in frame F-Main
     1626   do:
     1627     if (can-query (self, "sensitive")
     1628        and
     1629        self :sensitive = true
     1630        )
     1631     or (can-query (self, "read-only")
     1632        and
     1633        self :read-only = false
     1634        )
     1635     then do:
     1636       if self :handle <> focus :handle
     1637       then do:
     1638         apply "entry":u to self .
     1639       end.
     1640       define variable v-ok            as logical   no-undo .
     1641       define variable v-curr-sv-date  as date      no-undo .
     1642       define variable v-description   as character no-undo .
     1643       assign
     1644         v-curr-sv-date = date(self :screen-value) no-error
     1645       .
     1646       if v-curr-sv-date = ?
     1647       then do:
     1648         run gbl/getcurdt.p
     1649           (output v-curr-sv-date
     1650           ) .
     1651       end.
     1652       if v-curr-sv-date <> ?
     1653       then do:
     1654         run gbl/d-inpday.w
     1655           (input ?
     1656           ,input "Выбор даты"
     1657           ,input v-description
     1658           ,input ""
     1659           ,input-output v-curr-sv-date
     1660           ,output v-ok
     1661           ).
     1662         if v-ok = true
     1663         then do:
     1664           assign
     1665             self :screen-value = string(v-curr-sv-date) .
     1666           .
     1667         end.
     1668       end.
     1669     end.
     1670     return no-apply .
     1671   end.
     1672     define MENU m-ed-date18
     1673       MENU-ITEM m-ed-date18-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
     1674       MENU-ITEM m-ed-date18-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
     1675       MENU-ITEM m-ed-date18-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
     1676       MENU-ITEM m-ed-date18-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
     1677       .
     1678     if f-date-to :POPUP-MENU in frame F-Main = ?
     1679     then do:
     1680       ASSIGN
     1681         f-date-to :POPUP-MENU in frame F-Main = MENU m-ed-date18 :HANDLE
     1682         f-date-to :MENU-MOUSE in frame F-Main = 3
     1683       .
     1684     end.
     1685     define variable v-label-handle18 as handle no-undo .
     1686     assign
     1687       v-label-handle18 = f-date-to :side-label-handle in frame F-Main
     1688     .
     1689     if valid-handle (v-label-handle18)
     1690     then do:
     1691       if v-label-handle18 :tooltip = ""
     1692       or v-label-handle18 :tooltip = ?
     1693       then do:
     1694         assign
     1695           v-label-handle18 :tooltip = "Ctrl-D - текущая, Ctrl-B - начало, Ctrl-E - конец, Ctrl-F - календарь, Прав.Клавиша Мыши - Popup Menu"
     1696         .
     1697       end.
     1698     end.
     1699     ON CHOOSE OF MENU-ITEM m-ed-date18-1 in menu m-ed-date18 DO:
     1700       apply "ctrl-b":U to f-date-to in frame F-Main .
     1701     END.
     1702     ON CHOOSE OF MENU-ITEM m-ed-date18-2 in menu m-ed-date18 DO:
     1703       apply "ctrl-d":U to f-date-to in frame F-Main .
     1704     END.
     1705     ON CHOOSE OF MENU-ITEM m-ed-date18-3 in menu m-ed-date18 DO:
     1706       apply "ctrl-e":U to f-date-to in frame F-Main .
     1707     END.
     1708     ON CHOOSE OF MENU-ITEM m-ed-date18-4 in menu m-ed-date18 DO:
     1709       apply "ctrl-f":U to f-date-to in frame F-Main .
     1710     END.
     1711   PROCEDURE adm-create-objects :
     1712   END PROCEDURE.
     1713   PROCEDURE adm-row-available :
     1714     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
     1715     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
     1716     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
     1717     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
     1718     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
     1719     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
     1720     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
     1721     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
     1722     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
     1723     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
     1724     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
     1725     IF adm-updating-record THEN RETURN.
     1726     RUN get-attribute ('FIELDS-ENABLED':U).
     1727     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
     1728     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
     1729         OUTPUT link-handle) NO-ERROR.
     1730     IF link-handle = "":U THEN
     1731         RETURN.
     1732     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
     1733     IF NUM-ENTRIES(link-handle) > 1 THEN
     1734         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
     1735             "encountered more than one RECORD-SOURCE.":U SKIP
     1736             "The first - ":U record-source-hdl:file-name " - will be used.":U
     1737                VIEW-AS ALERT-BOX ERROR.
     1738     RUN get-attribute ('Key-Name':U).
     1739     key-name = RETURN-VALUE.
     1740     IF key-name = "":U THEN key-name = ?.
     1741     IF key-name NE ? THEN DO:
     1742       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
     1743         NO-ERROR.
     1744       IF key-value NE ? THEN
     1745         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
     1746     END.
     1747   IF VALID-HANDLE (adm-object-hdl) THEN
     1748       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1749   RUN notify IN THIS-PROCEDURE ('row-available':U).
     1750   END PROCEDURE.
     1751   PROCEDURE disable_UI :
     1752     HIDE FRAME F-Main.
     1753     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1754   END PROCEDURE.
     1755   PROCEDURE enable_UI :
     1756     DISPLAY F-date-to F-date-from flagOnlyDel
     1757         WITH FRAME F-Main.
     1758     ENABLE rect-3 bt-date-to bt-date-from F-date-to F-date-from flagOnlyDel
     1759         WITH FRAME F-Main.
     1760   END PROCEDURE.
     1761   PROCEDURE local-initialize :
     1762     run dispatch in this-procedure ( input 'initialize':u ) .
     1763   end procedure.
     1764   PROCEDURE My-report :
     1765   do:
     1766       run rep/r-delChk.p (
     1767         input my-handle,
     1768         input F-date-to,
     1769         input F-date-from,
     1770         input flagOnlyDel
     1771         ).
     1772     end.
     1773   end procedure.
     1774   PROCEDURE my-var :
     1775   .
     1776   end procedure.
     1777   PROCEDURE state-changed :
     1778   define input parameter p-issuer-hdl as handle no-undo.
     1779     define input parameter p-state as character no-undo.
     1780   end procedure.
