      564   define new global shared variable g#library  as handle no-undo .
      565   define new global shared variable g#library2 as handle no-undo .
      566   define variable var-report-r-b as character no-undo .
      567   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      568   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      569     (output var-report-r-b
      570     )  .
      571   procedure proc-alt-shift-f2:
      572     if not ibs.th.gbl.gbl-var:rcode
      573   then
      574     run gbl\inidebug.p .
      575   end.
      576   procedure proc-alt-shift-f3:
      577     run gbl/prvssinf.p
      578       ( input this-procedure
      579       ) .
      580   end.
      581   define variable v-inform-launched as logical no-undo initial false .
      582   procedure proc-alt-shift-f4:
      583     define variable v-action as character no-undo .
      584     if v-inform-launched = false then do:
      585       assign
      586         v-inform-launched = true
      587       .
      588       run gbl/d-inform.w
      589         (  input self
      590         ,  input this-procedure
      591         , output v-action
      592         ) no-error .
      593       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      594       assign
      595         v-inform-launched = false
      596       .
      597     end.
      598   end.
      599   procedure proc-alt-f1:
      600     run gbl/corrhelp.p
      601       (input this-procedure
      602       ) .
      603   end .
      604   on alt-shift-f2 anywhere do:
      605     run proc-alt-shift-f2.
      606   end.
      607   on alt-shift-f3 anywhere do:
      608     run proc-alt-shift-f3 in this-procedure .
      609   end.
      610   on alt-shift-f4 anywhere do:
      611     run proc-alt-shift-f4 in this-procedure.
      612   end.
      613   on alt-f1 anywhere do:
      614     run proc-alt-f1 in this-procedure .
      615   end.
      616   DEFINE RECTANGLE RECT-8
      617        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      618        SIZE 38.2 BY 3.1.
      619   DEFINE VARIABLE tog-det-tov AS LOGICAL INITIAL no
      620        LABEL "Детализация по товарам"
      621        VIEW-AS TOGGLE-BOX
      622        SIZE 35 BY 1.19 NO-UNDO.
      623   DEFINE VARIABLE tog-itog-prod AS LOGICAL INITIAL no
      624        LABEL "Подитоги по производителям"
      625        VIEW-AS TOGGLE-BOX
      626        SIZE 35 BY 1.19 NO-UNDO.
      627   DEFINE FRAME F-Main
      628        tog-det-tov AT ROW 1.57 COL 3.6 WIDGET-ID 2
      629        tog-itog-prod AT ROW 3.1 COL 3.6 WIDGET-ID 16
      630        RECT-8 AT ROW 1.48 COL 2
      631       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      632            SIDE-LABELS NO-UNDERLINE THREE-D
      633            AT COL 1 ROW 1 SCROLLABLE .
      634   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      635   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      636   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      637   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      638   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      639   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      640   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      641   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      642         adm-object-hdl = FRAME F-Main:HANDLE.
      643   RUN ensure-broker.
      644   THIS-PROCEDURE:ADM-DATA =
      645        'ADM1.1~`':U +
      646        'SmartObject~`':U +
      647        '~`':U +
      648        'NO ~`':U +
      649        '~`':U +
      650        '~`':U +
      651        '~`':U +
      652        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      653           + "~`":U +
      654        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
      655        'Record-Source,Record-Target,TableIO-Target~`':U +
      656        '~`':U +
      657        '~`~`~`~`~`~`~`~`~`~`~`':U +
      658        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      659            THEN "^^":U
      660        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      661             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      662   PROCEDURE adm-apply-entry :
      663     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      664   END PROCEDURE.
      665   PROCEDURE adm-destroy :
      666    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      667   END PROCEDURE.
      668   PROCEDURE adm-disable :
      669       DISABLE RECT-8 tog-det-tov tog-itog-prod WITH FRAME F-Main.
      670       RUN dispatch ('disable-fields':U).
      671       RUN set-attribute-list ('ENABLED=no':U).
      672       RETURN.
      673   END PROCEDURE.
      674   PROCEDURE adm-edit-attribute-list :
      675         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
      676         RETURN.
      677   END PROCEDURE.
      678   PROCEDURE adm-enable :
      679       ENABLE UNLESS-HIDDEN RECT-8 tog-det-tov tog-itog-prod WITH FRAME F-Main.
      680       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      681       RUN set-attribute-list ('ENABLED=yes':U).
      682       RETURN.
      683   END PROCEDURE.
      684   PROCEDURE adm-exit :
      685        RUN notify ('exit':U).
      686     RETURN.
      687   END PROCEDURE.
      688   PROCEDURE adm-hide :
      689     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      690   END PROCEDURE.
      691   PROCEDURE adm-initialize :
      692     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      693   END PROCEDURE.
      694   PROCEDURE adm-show-errors :
      695       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      696       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      697           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      698       END.
      699       RETURN.
      700   END PROCEDURE.
      701   PROCEDURE adm-UIB-mode :
      702     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      703   END PROCEDURE.
      704   PROCEDURE adm-view :
      705     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      706   END PROCEDURE.
      707   PROCEDURE dispatch :
      708       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      709       RUN broker-dispatch IN adm-broker-hdl
      710           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      711       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      712   END PROCEDURE.
      713   PROCEDURE ensure-broker :
      714   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      715   IF RETURN-VALUE NE "ADM-Broker":U THEN
      716   DO:
      717       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      718       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      719   END.
      720   END PROCEDURE.
      721   PROCEDURE get-attribute :
      722     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      723     RUN broker-get-attribute IN adm-broker-hdl
      724         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      725     RETURN RETURN-VALUE.
      726   END PROCEDURE.
      727   PROCEDURE get-attribute-list :
      728     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      729     RUN broker-get-attribute-list IN adm-broker-hdl
      730         (INPUT THIS-PROCEDURE,
      731          INPUT ?,
      732          OUTPUT p-attr-list) NO-ERROR.
      733     RETURN.
      734   END PROCEDURE.
      735   PROCEDURE new-state :
      736     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      737     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      738     RETURN.
      739   END PROCEDURE.
      740   PROCEDURE notify :
      741     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      742     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      743     IF RETURN-VALUE = "ADM-ERROR":U THEN
      744         RETURN "ADM-ERROR":U.
      745     RETURN.
      746   END PROCEDURE.
      747   PROCEDURE set-attribute-list :
      748     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      749     RUN ensure-broker.
      750     RUN broker-set-attribute-list IN adm-broker-hdl
      751         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      752     RETURN.
      753   END PROCEDURE.
      754   PROCEDURE set-position :
      755       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      756       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      757       IF VALID-HANDLE(adm-object-hdl) THEN
      758       DO:
      759         ASSIGN adm-object-hdl:ROW    =   p-row
      760                adm-object-hdl:COLUMN =   p-col.
      761       END.
      762       RETURN.
      763   END PROCEDURE.
      764   PROCEDURE adm-display-fields :
      765       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
      766       RETURN.
      767   END PROCEDURE.
      768   PROCEDURE adm-open-query :
      769     RETURN.
      770   END PROCEDURE.
      771   PROCEDURE adm-row-changed :
      772         IF VALID-HANDLE(adm-object-hdl) THEN
      773           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      774         RUN notify ('row-available':U).
      775         RETURN.
      776   END PROCEDURE.
      777   PROCEDURE reposition-query :
      778       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
      779       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
      780       RETURN.
      781   END PROCEDURE.
      782     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
      783     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
      784     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
      785     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
      786     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
      787     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
      788     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
      789     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
      790     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      791     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
      792     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      793     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
      794     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
      795     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
      796     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
      797     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
      798     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
      799     IF "":U = "":U THEN
      800       RUN modify-list-attribute IN adm-broker-hdl
      801         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
      802     RUN use-create-on-add(?).
      803   PROCEDURE adm-add-record :
      804       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      805          "must have at least one Enabled Table to perform Add.":U
      806          VIEW-AS ALERT-BOX ERROR.
      807       RETURN.
      808   END PROCEDURE.
      809   PROCEDURE adm-assign-record :
      810    MESSAGE
      811          "Object ":U THIS-PROCEDURE:FILE-NAME
      812            "must have at least one Enabled Table to perform Assign.":U
      813              VIEW-AS ALERT-BOX ERROR.
      814      RETURN.
      815     END PROCEDURE.
      816   PROCEDURE adm-assign-statement :
      817     RETURN.
      818   END PROCEDURE.
      819   PROCEDURE adm-cancel-record :
      820      RETURN.
      821     END PROCEDURE.
      822   PROCEDURE adm-copy-record :
      823       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      824        "must have at least one Enabled Table to perform Copy.":U
      825          VIEW-AS ALERT-BOX ERROR.
      826       RETURN.
      827   END PROCEDURE.
      828   PROCEDURE adm-create-record :
      829      RETURN.
      830   END PROCEDURE.
      831   PROCEDURE adm-current-changed :
      832     RETURN.
      833   END PROCEDURE.
      834   PROCEDURE adm-delete-record :
      835    MESSAGE
      836          "Object ":U THIS-PROCEDURE:FILE-NAME
      837            "must have at least one Enabled Table to perform Delete.":U
      838              VIEW-AS ALERT-BOX ERROR.
      839       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
      840       RETURN.
      841   END PROCEDURE.
      842   PROCEDURE adm-disable-fields :
      843         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
      844       RETURN.
      845   END PROCEDURE.
      846   PROCEDURE adm-enable-fields :
      847       RETURN.
      848   END PROCEDURE.
      849   PROCEDURE adm-end-update :
      850     RETURN.
      851   END PROCEDURE.
      852   PROCEDURE adm-reset-record :
      853       RETURN.
      854   END PROCEDURE.
      855   PROCEDURE adm-update-record :
      856       MESSAGE
      857         "Object ":U THIS-PROCEDURE:FILE-NAME
      858           "must have at least one Enabled Table to perform Update.":U
      859             VIEW-AS ALERT-BOX ERROR.
      860      RETURN.
      861   END PROCEDURE.
      862   PROCEDURE check-modified :
      863   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
      864   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
      865   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
      866   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
      867     IF check-state = "check":U THEN
      868     DO:
      869       RUN get-link-handle IN adm-broker-hdl
      870         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
      871            OUTPUT group-target-list).
      872       IF group-target-list NE "":U THEN
      873       DO i = 1 TO NUM-ENTRIES(group-target-list):
      874         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
      875         RUN check-modified IN curr-widget ('group-check':U).
      876         IF RETURN-VALUE NE "":U THEN
      877         DO:
      878           RUN check-modified-message(RETURN-VALUE).
      879           RETURN "":U.
      880         END.
      881       END.
      882     END.
      883     RETURN "":U.
      884   END PROCEDURE.
      885   PROCEDURE check-modified-message :
      886     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
      887        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
      888           'CONTAINER-SOURCE':U, 'HIDDEN':U).
      889        IF RETURN-VALUE = "YES":U THEN
      890           RUN notify ('view,CONTAINER-SOURCE':U).
      891        MESSAGE IF p-changed-table NE ? THEN
      892           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
      893           ELSE "Current values have been changed."
      894           SKIP "  Do you wish to save those changes?"
      895           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
      896        IF ANS THEN
      897        DO:
      898           IF group-assign-target THEN
      899             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
      900           ELSE RUN dispatch('update-record':U).
      901           IF RETURN-VALUE = "ADM-ERROR":U THEN
      902           DO:
      903               MESSAGE "Changes to the previous record were not saved."
      904                 VIEW-AS ALERT-BOX ERROR.
      905               IF group-assign-target THEN
      906                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      907               ELSE RUN dispatch ('cancel-record':U).
      908           END.
      909        END.
      910        ELSE DO:
      911          IF group-assign-target THEN
      912             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      913          ELSE RUN dispatch('cancel-record':U).
      914        END.
      915        RETURN.
      916   END PROCEDURE.
      917   PROCEDURE get-rowid :
      918       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
      919       ASSIGN
      920       p-table   =   adm-first-table.
      921       RETURN.
      922   END PROCEDURE.
      923   PROCEDURE init-group-assign :
      924       RUN request-attribute IN adm-broker-hdl
      925         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
      926       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
      927         group-assign-target = yes.
      928       ELSE group-assign-target = no.
      929       RETURN.
      930   END PROCEDURE.
      931   PROCEDURE set-editors :
      932       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
      933       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
      934       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
      935       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
      936       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
      937       DO WHILE VALID-HANDLE (curr-widget):
      938           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
      939              curr-widget:HIDDEN = no THEN DO:
      940             CASE p-field-setting:
      941               WHEN "INITIALIZE":U THEN
      942               DO:
      943                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
      944                     read-only-list +
      945                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
      946                        STRING(curr-widget).
      947               END.
      948               WHEN "DISABLE":U OR
      949               WHEN "ENABLE":U THEN
      950               DO:
      951                   curr-widget:SENSITIVE = yes.
      952                   RUN get-attribute ('Read-Only-Editors':U).
      953                   IF RETURN-VALUE = ? OR
      954                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
      955                       curr-widget:READ-ONLY =
      956                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
      957               END.
      958               WHEN "CLEAR":U THEN
      959                   curr-widget:SCREEN-VALUE = "":U.
      960             END CASE.
      961           END.
      962           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
      963       END.
      964       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
      965         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
      966           + '"':U).
      967       RETURN.
      968   END PROCEDURE.
      969   PROCEDURE use-check-modified-all :
      970    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
      971     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
      972     RETURN.
      973   END PROCEDURE.
      974   PROCEDURE use-create-on-add :
      975   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
      976      RETURN.
      977   END PROCEDURE.
      978   PROCEDURE use-initial-lock :
      979     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
      980     ASSIGN adm-initial-lock = p-attr-value.
      981     RETURN.
      982   END PROCEDURE.
      983     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
      984   ASSIGN
      985          FRAME F-Main:SCROLLABLE       = FALSE
      986          FRAME F-Main:HIDDEN           = TRUE.
      987   if not this-procedure :persistent
      988   then do:
      989     message
      990       vss-workfile vss-revision vss-description skip
      991       "Ошибка при запуске процедуры" skip
      992       "Данную процедуру следует запускать только с параметром persistent" skip
      993       view-as alert-box error .
      994     undo, return error .
      995   end.
      996     run enable_UI in this-procedure .
      997   PROCEDURE disable_UI :
      998     HIDE FRAME F-Main.
      999     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1000   END PROCEDURE.
     1001   PROCEDURE enable_UI :
     1002   END PROCEDURE.
     1003   PROCEDURE local-apply-layout :
     1004     RUN dispatch IN THIS-PROCEDURE ( INPUT 'apply-layout':U ) .
     1005   END PROCEDURE.
     1006   PROCEDURE my-report :
     1007   run rep/r-retroB.p (input my-handle, input tog-det-tov, input tog-itog-prod) .
     1008   END PROCEDURE.
     1009   PROCEDURE my-var :
     1010   define variable temp-str as character no-undo.
     1011   define variable l        as integer   no-undo.
     1012     Assign frame F-Main tog-itog-prod tog-det-tov .
     1013   ReportNAme = "Расчет ретро-бонусов " .
     1014   assign
     1015   sheetf.Excel-Column-Lable = "Наименование, Код" +
     1016   (if tog-det-tov then (",Артикул")  else "") + ", Сумма прихода с НДС, Сумма прихода без НДС" +
     1017   (if tog-det-tov then (", Ставка бонуса %, Ставка бонуса (сумма), Метод расчета")  else "") + ", Сумма бонуса"
     1018   sheetf.Sizes  = "40,10" + (if tog-det-tov then ",16" else "") + ",16,16" + (if tog-det-tov then ",8,12,22" else "") + ",16"
     1019   Sheetf.colformat = (if tog-det-tov then "1=@;2=@;3=@;4=0,00;5=0,00;6=0,00;7=0,00;8=@;9=0,00" else "1=@;2=@;3=0,00;4=0,00;5=0,00")
     1020   .
     1021   if tog-det-tov then l = 176. else l = 118.
     1022   temp-str = "".
     1023   str3 = "Выбор объекта:" + chr(10).
     1024   for each obj-list no-lock :
     1025     if length(temp-str) + length(obj-list.obj-name) > l then do :
     1026       temp-str = temp-str + "...".
     1027       leave.
     1028     end.
     1029     else temp-str = temp-str + ", " + obj-list.obj-name.
     1030   end.
     1031   temp-str = substring(temp-str, 3).
     1032   str3 = str3 + temp-str.
     1033   temp-str = "".
     1034   str4 = "Выбор контрагента:" + chr(10).
     1035   find first G#CUSTOMER no-lock no-error.
     1036   if available G#CUSTOMER then do :
     1037     for each G#CUSTOMER no-lock :
     1038       if length(temp-str) + length(G#CUSTOMER.obj-name) > l then do :
     1039         temp-str = temp-str + "...".
     1040         leave.
     1041       end.
     1042       else temp-str = temp-str + ", " + G#CUSTOMER.obj-name.
     1043     end.
     1044   end.
     1045   else temp-str = ", Все".
     1046   temp-str = substring(temp-str, 3).
     1047   str4 = str4 + temp-str.
     1048   END PROCEDURE.
     1049   PROCEDURE state-changed :
     1050     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     1051     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     1052     CASE p-state:
     1053       when "link-changed":U then  DO:
     1054            Run my-var.
     1055            End.
     1056     END CASE.
     1057   END PROCEDURE.
