     4033       l2f-cost-sum-all  = c-f-cost-sum-all:FORMAT
     4034       c-f-cost-sum-all:DATA-TYPE = "CHARACTER"
     4035       c-f-cost-sum-all:FORMAT    = "x(" + string(C-f-cost-sum-all:WIDTH-CHARS) + ")"
     4036       c-f-cost-sum-all:screen-value = string(ff)  .
     4037   End.
     4038   if c-f-crsa-sum-all <>  ?  then do : assign
     4039       l1f-crsa-sum-all  = c-f-crsa-sum-all:DATA-TYPE
     4040       l2f-crsa-sum-all  = c-f-crsa-sum-all:FORMAT
     4041       c-f-crsa-sum-all:DATA-TYPE = "CHARACTER"
     4042       c-f-crsa-sum-all:FORMAT    = "x(" + string(C-f-crsa-sum-all:WIDTH-CHARS) + ")"
     4043       c-f-crsa-sum-all:screen-value = string(ff)  .
     4044   End.
     4045   if c-f-qnty-o <>  ?  then do : assign
     4046       l1f-qnty-o  = c-f-qnty-o:DATA-TYPE
     4047       l2f-qnty-o  = c-f-qnty-o:FORMAT
     4048       c-f-qnty-o:DATA-TYPE = "CHARACTER"
     4049       c-f-qnty-o:FORMAT    = "x(" + string(C-f-qnty-o:WIDTH-CHARS) + ")"
     4050       c-f-qnty-o:screen-value = string(ff)  .
     4051   End.
     4052   if c-f-cost-sum-o <>  ?  then do : assign
     4053       l1f-cost-sum-o  = c-f-cost-sum-o:DATA-TYPE
