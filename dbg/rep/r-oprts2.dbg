     4845   PROCEDURE foreach6 :
     4846     for each obj-list no-lock with FRAME Zapas :
     4847       if NOT( classify = 1 and Itog = true) then dO:
     4848     if c-f-gds-name <>  ?  then do :
     4849       c-f-gds-name:screen-value = string(obj-list.obj-name) .
     4850       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     4851           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     4852           display STREAM OutStream    with frame top-frame .
     4853       End.
     4854     End.
     4855   if c-f-qnty <>  ?  then do :
     4856   Assign
     4857       l1f-qnty  = c-f-qnty:DATA-TYPE
     4858       l2f-qnty  = c-f-qnty:FORMAT
     4859       c-f-qnty:DATA-TYPE = "CHARACTER"
     4860       c-f-qnty:FORMAT    = "x(" + string(C-f-qnty:WIDTH-CHARS) + ")"
     4861       c-f-qnty:screen-value = string('')  .
     4862   End.
     4863   if c-f-cost-sum <>  ?  then do :
     4864   Assign
     4865       l1f-cost-sum  = c-f-cost-sum:DATA-TYPE
