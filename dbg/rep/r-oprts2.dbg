     5045                  For Each temp-doc-code-all  : delete temp-doc-code-all . end.
     5046               End.
     5047               if can-find( first tdedt where  ub.ot-line.ext-doc-type = tdedt.id no-lock ) then DO:
     5048                   Case  ub.ot-line.sum-type :
     5049                       When 'cost':U then do:
     5050                           f-cost-sum = f-cost-sum + ub.ot-line.sum-base .
     5051                       End.
     5052                       When 'sale':U then do:
     5053                           f-sale-sum   = f-sale-sum   +  ub.ot-line.sum-base .
     5054                           f-sale-other = f-sale-other + ub.ot-line.other-base .
     5055                       End.
     5056                       When  'crsa':U then do:
     5057                           f-crsa-sum = f-crsa-sum + ub.ot-line.sum-base  .
     5058                           f-qnty     = f-qnty     + ub.ot-line.fact-qnty .
