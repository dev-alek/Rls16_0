     1263   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     1264   DEFINE BUTTON StopBtn AUTO-END-KEY
     1265        LABEL "Стоп"
     1266        SIZE 10 BY 1.
     1267   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     1268        LABEL "Обработано записей"
     1269         VIEW-AS TEXT
     1270        SIZE 14 BY .67 NO-UNDO.
     1271   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     1272         VIEW-AS TEXT
     1273        SIZE 53.25 BY .67
     1274        FGCOLOR 1  NO-UNDO.
     1275   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     1276         VIEW-AS TEXT
     1277        SIZE 53.25 BY .67
     1278        FGCOLOR 1  NO-UNDO.
     1279   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     1280         VIEW-AS TEXT
     1281        SIZE 53.25 BY .67
     1282        FGCOLOR 1  NO-UNDO.
     1283   DEFINE RECTANGLE RECT-1
     1284        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1285        SIZE 55.13 BY 4.46.
     1286   DEFINE FRAME InfoFrame
     1287        StopBtn AT ROW 4.25 COL 21.75
     1288        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     1289        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     1290        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     1291        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     1292        RECT-1 AT ROW 1 COL 1
     1293       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1294            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1295            TITLE "Процесс"
     1296            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     1297   define variable mFrameView      as logical   no-undo init yes.
     1298     define variable mFramHandle as handle no-undo.
     1299     mFramHandle = frame InfoFrame:handle.
     1300     if  log-manager:logfile-name ne ?
     1301     then DO:
     1302         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1303         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1304         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     1305     end.
     1306     mFrameView = not session:batch-mode and mFramHandle:visible.
     1307     if mFrameView
     1308     then do:
     1309       ASSIGN
     1310          FRAME InfoFrame:HIDDEN                           = TRUE
     1311          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     1312     end.
     1313   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     1314   DO:
     1315     IF not StopProcessing THEN
     1316       Message "Вы действительно хотите прервать" SKIP
     1317               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     1318                 UPDATE StopProcessing.
     1319     IF StopProcessing THEN do:
     1320        if mFrameView
     1321        then do:
     1322           HIDE FRAME InfoFrame.
     1323        end.
     1324     End.
     1325   END.
     1326   assign v-account = ( if integer( 100 ) = 0 then 100 else integer( 100 ) ).
     1327     if  log-manager:logfile-name ne ?
     1328     then DO:
     1329         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     1330     end.
     1331     if not session:batch-mode then
     1332     do:
     1333       VIEW FRAME InfoFrame.
     1334       mFrameView = true.
     1335     end.
