     4310                 put stream outstream tt-season.sea-name  at 1 format "x(160)" skip.  down stream outstream .
     4311                 if Make-Excel then  put   stream ForExcel unformatted tt-season.sea-name chr(10) .
     4312             end.
     4313                 for each ub.gds-season no-lock where
     4314                          ub.gds-season.sea-code = tt-season.sea-code and
     4315                          ub.gds-season.db-num   = tt-season.db-num
     4316                          ,
     4317                     each goods no-lock where
     4318                          goods.gds-code    = ub.gds-season.gds-code and
     4319                          goods.gds-type   = 'т':U ,
     4320                     Each ub.ot-line where
     4321                             ub.ot-line.fact-order <= fact-order-2 and
     4322                             ub.ot-line.fact-order >= fact-order-1 and
     4323                             ub.ot-line.obj-code    = obj-list.obj-code and
     4324                             ub.ot-line.obj-type    = obj-list.obj-type  and
     4325                             ub.ot-line.prod-type   = goods.prod-type and
     4326                             ub.ot-line.prod-code   = goods.prod-code and
     4327                             ub.ot-line.artic       = goods.artic  and
     4328                             (ub.ot-line.sum-type   = 'sale':U OR
     4329                               ub.ot-line.sum-type  = 'crsa':U OR
     4330                               ub.ot-line.sum-type  = 'cost':U )
     4331                         break
     4332                             by (ub.gds-season.gds-code ) by goods.grp-name
     4333                             with FRAME Zapas :
     4334                n-nm = n-nm + 1.
     4335               IF first-of(ub.gds-season.gds-code) then DO:
     4336                   assign
     4337                     f-qnty         = 0
     4338                     f-cost-sum     = 0
     4339                     f-sale-sum     = 0
     4340                     f-sale-other   = 0
     4341                     f-crsa-sum     = 0
     4342                     f-qnty-all     = 0
     4343                     f-cost-sum-all = 0
     4344                     f-crsa-sum-all = 0
     4345                     f-qnty-o       = 0
     4346                     f-cost-sum-o   = 0
     4347                     f-crsa-sum-o   = 0.
     4348                  For Each temp-doc-code  : delete temp-doc-code . end.
     4349                  For Each temp-doc-code-all  : delete temp-doc-code-all . end.
     4350               End.
     4351               if can-find( first tdedt where  ub.ot-line.ext-doc-type = tdedt.id no-lock ) then DO:
     4352                   Case  ub.ot-line.sum-type :
     4353                       When 'cost':U then do:
     4354                           f-cost-sum = f-cost-sum + ub.ot-line.sum-base .
     4355                       End.
     4356                       When 'sale':U then do:
     4357                           f-sale-sum   = f-sale-sum   +  ub.ot-line.sum-base .
     4358                           f-sale-other = f-sale-other + ub.ot-line.other-base .
     4359                       End.
     4360                       When  'crsa':U then do:
     4361                           f-crsa-sum = f-crsa-sum + ub.ot-line.sum-base  .
     4362                           f-qnty     = f-qnty     + ub.ot-line.fact-qnty .
     4363                           IF itog = false then do:
     4364                               Create temp-doc-code .
     4365                               Assign
     4366                                  temp-doc-code.doc-code = ub.ot-line.doc-code
     4367                                  temp-doc-code.ext-doc-type = ub.ot-line.ext-doc-type
     4368                                  temp-doc-code.si  = if  ub.ot-line.fact-qnty < 0 then -1 else 1
     4369                                  temp-doc-code.si2 = if  ub.ot-line.other-base < 0 then -1 else 1
     4370                                  .
     4371                           End.
     4372                       End.
     4373                   End case.
     4374                 End.
     4375                   Case  ub.ot-line.sum-type :
     4376                       when 'cost':U then do:
     4377                         f-cost-sum-all = f-cost-sum-all + ub.ot-line.sum-base .
