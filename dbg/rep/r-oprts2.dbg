     6656      if Make-Excel then  put   stream ForExcel unformatted  obj-list.obj-name chr(10).
     6657             n-nn = 0.
     6658             n-no = n-no + 1 .
     6659   for each tt-season no-lock with FRAME Zapas:
     6660       if not ("no-classify" = "no-classify" and itog = true ) then do:
     6661           put stream outstream tt-season.sea-name  at 1 format "x(160)" skip.  down stream outstream .
     6662           if Make-Excel then  put   stream ForExcel unformatted tt-season.sea-name chr(10) .
     6663       end.
     6664   for each ub.gds-season no-lock where
     6665             ub.gds-season.db-num   = tt-season.db-num and
     6666             ub.gds-season.sea-code = tt-season.sea-code ,
     6667       each gds-obj where
     6668             gds-obj.gds-code    = ub.gds-season.gds-code and
     6669             gds-obj.obj-code    = obj-list.obj-code and
     6670             gds-obj.obj-type    = obj-list.obj-type
     6671             and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     6672             no-lock,
     6673             first goods where   gds-obj.gds-code  = goods.gds-code and
     6674                                 goods.gds-type    = 'т':U
     6675                                 no-lock
     6676               break
     6677                   by ub.gds-season.gds-code  by goods.grp-name
     6678                   with FRAME Zapas :
     6679                IF first-of(ub.gds-season.gds-code) then DO:
     6680                   assign
     6681                     f-qnty         = 0
     6682                     f-cost-sum     = 0
     6683                     f-sale-sum     = 0
     6684                     f-sale-other   = 0
