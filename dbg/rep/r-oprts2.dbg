     3745      price-cli-with-tax-locoprl = out-vatp_partsprl.price-cli
     3746      cli-base-rateoprl          = out-vatp_partsprl.cli-base-rate.
     3747     ASSIGN   road-tax-base-locoprl  = (if out-vatp_partsprl.road-tax-base  = ? then 0 else out-vatp_partsprl.road-tax-base)
     3748              road-tax-rubl-locoprl  = (if out-vatp_partsprl.road-tax-rubl  = ? then 0 else out-vatp_partsprl.road-tax-rubl).
     3749     ASSIGN  transport-base-locoprl = (if out-vatp_partsprl.transport-base = ? then 0 else out-vatp_partsprl.transport-base)
     3750             transport-rubl-locoprl = (if out-vatp_partsprl.transport-rubl = ? then 0 else out-vatp_partsprl.transport-rubl)
     3751             other-base-locoprl     = (if out-vatp_partsprl.other-base     = ? then 0 else out-vatp_partsprl.other-base)
     3752             other-rubl-locoprl     = (if out-vatp_partsprl.other-rubl     = ? then 0 else out-vatp_partsprl.other-rubl)
     3753             vat-pc-locoprl         = (if out-vatp_partsprl.vat-pc         = ? then 0 else out-vatp_partsprl.vat-pc)
     3754             slt-pc-locoprl         = (if out-vatp_partsprl.slt-pc         = ? then 0 else out-vatp_partsprl.slt-pc).
     3755             ASSIGN   slt-base-locoprl    = (if in-vatp-have-vat-sltoprl = no then 0 else (price-base-with-tax-locoprl - ((if road-tax-base-locoprl  = ? then 0 else road-tax-base-locoprl) + (if transport-base-locoprl = ? then 0 else transport-base-locoprl) + (if other-base-locoprl = ? then 0 else other-base-locoprl)))                           * slt-pc-locoprl / (100 + slt-pc-locoprl))                        vat-base-locoprl    = (if in-vatp-have-vat-sltoprl = no then 0 else (price-base-with-tax-locoprl - ((if road-tax-base-locoprl  = ? then 0 else road-tax-base-locoprl) + (if transport-base-locoprl = ? then 0 else transport-base-locoprl) + (if other-base-locoprl = ? then 0 else other-base-locoprl))) * (1 - slt-pc-locoprl / (100 + slt-pc-locoprl)) * vat-pc-locoprl / (100 + vat-pc-locoprl)).
     3756       ASSIGN   slt-rubl-locoprl    = (if in-vatp-have-vat-sltoprl = no then 0 else (price-rubl-with-tax-locoprl - ((if road-tax-rubl-locoprl  = ? then 0 else road-tax-rubl-locoprl) + (if transport-rubl-locoprl = ? then 0 else transport-rubl-locoprl) + (if other-rubl-locoprl = ? then 0 else other-rubl-locoprl)))                           * slt-pc-locoprl / (100 + slt-pc-locoprl))                        vat-rubl-locoprl    = (if in-vatp-have-vat-sltoprl = no then 0 else (price-rubl-with-tax-locoprl - ((if road-tax-rubl-locoprl  = ? then 0 else road-tax-rubl-locoprl) + (if transport-rubl-locoprl = ? then 0 else transport-rubl-locoprl) + (if other-rubl-locoprl = ? then 0 else other-rubl-locoprl))) * (1 - slt-pc-locoprl / (100 + slt-pc-locoprl)) * vat-pc-locoprl / (100 + vat-pc-locoprl)).
     3757     assign
     3758       exch-rate-cli-locoprl = (out-vatp_partsprl.price-rubl - transport-rubl-locoprl - other-rubl-locoprl - road-tax-rubl-locoprl - (if out-vatp_partsprl.vat-type <> 'в т. ч.':U then vat-rubl-locoprl else 0) - (if out-vatp_partsprl.slt-type <> 'в т. ч.':U then slt-rubl-locoprl else 0)) / out-vatp_partsprl.price-cli .
     3759     assign
     3760       slt-cli-locoprl        = slt-rubl-locoprl       / exch-rate-cli-locoprl
     3761       vat-cli-locoprl        = vat-rubl-locoprl       / exch-rate-cli-locoprl
     3762       road-tax-cli-locoprl   = road-tax-rubl-locoprl  / exch-rate-cli-locoprl
     3763       transport-cli-locoprl  = 0
     3764       other-cli-locoprl      = 0
     3765     .
     3766   ASSIGN
     3767             price-base-without-tax-locoprl = price-base-with-tax-locoprl - vat-base-locoprl - slt-base-locoprl - ((if road-tax-base-locoprl  = ? then 0 else road-tax-base-locoprl) + (if transport-base-locoprl = ? then 0 else transport-base-locoprl) + (if other-base-locoprl = ? then 0 else other-base-locoprl))
     3768       price-rubl-without-tax-locoprl = price-rubl-with-tax-locoprl - vat-rubl-locoprl - slt-rubl-locoprl - ((if road-tax-rubl-locoprl  = ? then 0 else road-tax-rubl-locoprl) + (if transport-rubl-locoprl = ? then 0 else transport-rubl-locoprl) + (if other-rubl-locoprl = ? then 0 else other-rubl-locoprl))
     3769   .
     3770         assign
     3771           varprice-base-consprl = varprice-base-consprl + (price-base-with-tax-locoprl - (if road-tax-base-locoprl = ? then 0 else road-tax-base-locoprl))* out-vatp_partsprl.fact-qnty
     3772           varprice-rubl-consprl = varprice-rubl-consprl + (price-rubl-with-tax-locoprl - (if road-tax-rubl-locoprl = ? then 0 else road-tax-rubl-locoprl))* out-vatp_partsprl.fact-qnty.
     3773         assign
     3774           varis-cons-parts-haveprl = yes
     3775           varcons-qntyprl          = varcons-qntyprl + out-vatp_partsprl.fact-qnty.
     3776       end.
     3777       assign
     3778         varfact-qntyprl = varfact-qntyprl + out-vatp_partsprl.fact-qnty.
     3779     end.
     3780   end.
     3781   assign
     3782     varprice-base-consprl = varprice-base-consprl / varcons-qntyprl
     3783     varprice-rubl-consprl = varprice-rubl-consprl / varcons-qntyprl.
     3784   if varprice-base-consprl = ? then do:
     3785     assign
     3786       varprice-base-consprl = 0.
     3787   end.
     3788   if varprice-rubl-consprl = ? then do:
     3789     assign
     3790       varprice-rubl-consprl = 0.
     3791   end.
     3792   assign
     3793       slt-base-saleprl               = (if out-vatp-have-vat-sltprl = no then 0 else varprice-base - vardiscnt-base                - road-tax-base-saleprl) * varSLT-pc / (100 + varSLT-pc)
     3794     vat-base-buyerprl              = (if out-vatp-have-vat-sltprl = no then 0 else varprice-base - vardiscnt-base - (if out-vatp-have-vat-sltprl = no then 0 else varprice-base - vardiscnt-base                - road-tax-base-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-base-saleprl) * varvat-pc / (100 + varvat-pc)
     3795     discnt-base-saleprl            = vardiscnt-base
     3796     price-base-with-tax-saleprl    = (varprice-base - vardiscnt-base)
     3797       slt-rubl-saleprl               = (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl                - road-tax-rubl-saleprl) * varSLT-pc / (100 + varSLT-pc)
     3798     vat-rubl-buyerprl              = (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl - (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl                - road-tax-rubl-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-rubl-saleprl) * varvat-pc / (100 + varvat-pc)
     3799     discnt-rubl-saleprl            = vardiscnt-rubl
     3800     price-rubl-with-tax-saleprl    = (varprice-rubl - vardiscnt-rubl)
     3801     .
     3802   if vardoc-type = 'инв':U then do:
     3803     assign
     3804       varfact-qntyprl = vardoc-qnty.
     3805   end.
     3806   else do:
     3807     assign
     3808       varfact-qntyprl = varfact-qnty.
     3809   end.
     3810   if varis-cons-parts-haveprl = no then do:
     3811     assign
     3812           vat-base-saleprl               = (if out-vatp-have-vat-sltprl = no then 0 else varprice-base - vardiscnt-base - (if out-vatp-have-vat-sltprl = no then 0 else varprice-base - vardiscnt-base                - road-tax-base-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-base-saleprl) * varvat-pc / (100 + varvat-pc)
     3813           vat-rubl-saleprl               = (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl - (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl                - road-tax-rubl-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-rubl-saleprl) * varvat-pc / (100 + varvat-pc).
     3814   end.
     3815   else do:
     3816     if vardoc-type = 'инв':U then do:
     3817       assign
     3818               vat-base-saleprl               = (if out-vatp-have-vat-sltprl = no then 0 else (((varprice-base - vardiscnt-base) - (if out-vatp-have-vat-sltprl = no then 0 else varprice-base - vardiscnt-base                - road-tax-base-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-base-saleprl - varprice-base-consprl) * varcons-vat-pc / (100 + varcons-vat-pc) * vardoc-qnty * varcons-qntyprl / varfact-qntyprl + ((varprice-base - vardiscnt-base) - (if out-vatp-have-vat-sltprl = no then 0 else varprice-base - vardiscnt-base                - road-tax-base-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-base-saleprl) * varvat-pc / (100 + varvat-pc) * vardoc-qnty * (varfact-qntyprl - varcons-qntyprl) / varfact-qntyprl) / varfact-qntyprl)
     3819               vat-rubl-saleprl               = (if out-vatp-have-vat-sltprl = no then 0 else (((varprice-rubl - vardiscnt-rubl) - (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl                - road-tax-rubl-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-rubl-saleprl - varprice-rubl-consprl) * varcons-vat-pc / (100 + varcons-vat-pc) * vardoc-qnty * varcons-qntyprl / varfact-qntyprl + ((varprice-rubl - vardiscnt-rubl) - (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl                - road-tax-rubl-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-rubl-saleprl) * varvat-pc / (100 + varvat-pc) * vardoc-qnty * (varfact-qntyprl - varcons-qntyprl) / varfact-qntyprl) / varfact-qntyprl)
     3820        .
     3821     end.
     3822     else do:
     3823       assign
     3824               vat-base-saleprl               = (if out-vatp-have-vat-sltprl = no then 0 else (((varprice-base - vardiscnt-base) - (if out-vatp-have-vat-sltprl = no then 0 else varprice-base - vardiscnt-base                - road-tax-base-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-base-saleprl - varprice-base-consprl) * varcons-vat-pc / (100 + varcons-vat-pc) * varfact-qnty * varcons-qntyprl / varfact-qntyprl + ((varprice-base - vardiscnt-base) - (if out-vatp-have-vat-sltprl = no then 0 else varprice-base - vardiscnt-base                - road-tax-base-saleprl) * varSLT-pc / (100 + varSLT-pc) - varprice-base-consprl) * varvat-pc / (100 + varvat-pc) * varfact-qnty * (varfact-qntyprl - varcons-qntyprl) / varfact-qntyprl) / varfact-qntyprl)
     3825               vat-rubl-saleprl               = (if out-vatp-have-vat-sltprl = no then 0 else (((varprice-rubl - vardiscnt-rubl) - (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl                - road-tax-rubl-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-rubl-saleprl - varprice-rubl-consprl) * varcons-vat-pc / (100 + varcons-vat-pc) * varfact-qnty * varcons-qntyprl / varfact-qntyprl + ((varprice-rubl - vardiscnt-rubl) - (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl                - road-tax-rubl-saleprl) * varSLT-pc / (100 + varSLT-pc) - varprice-rubl-consprl) * varvat-pc / (100 + varvat-pc) * varfact-qnty * (varfact-qntyprl - varcons-qntyprl) / varfact-qntyprl) / varfact-qntyprl)
     3826        .
     3827     end.
     3828   end.
     3829   assign
     3830   price-base-without-tax-saleprl = price-base-with-tax-saleprl - vat-base-saleprl - slt-base-saleprl - road-tax-base-saleprl
     3831   price-rubl-without-tax-saleprl = price-rubl-with-tax-saleprl - vat-rubl-saleprl - slt-rubl-saleprl - road-tax-rubl-saleprl.
     3832     end.
     3833   end procedure.
     3834   PROCEDURE report-execute :
     3835     If (ValType=0 and x-base-code=0)  Or ValType=1
     3836                                   then   assign tPrintRubl = yes .
     3837                                   else   assign tPrintRubl = no .
     3838      NO-PRISE = true .
     3839     if var-report-r-b = "rubl"  Then
     3840       if  x-base-code <> 0 and ValType = 2  then NO-PRISE = false  .
     3841     else
     3842       if  x-base-code <> 0 and ValType = 1  then NO-PRISE = false  .
     3843     If ReportPageHeight = 0 then ReportPageHeight = 43 .
     3844   output stream OutStream to value( string( session:temp-directory +
     3845                                        "rpt" + string( g#report-num ) ) )
     3846                                        page-size  value(ReportPageHeight) .
     3847     FORM with FRAME Zapas .
     3848   define variable vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3849   form header
     3850     line format "x(198)" at 1 skip
     3851     "Продолжение - на следующей странице" at 30 skip
     3852     with frame bottomframe width 232 page-bottom no-labels no-box .
     3853   view stream outstream frame bottomframe .
     3854      Line = fill("-", 198).
     3855     run calcitog in this-procedure.
     3856     run print-header in this-procedure.
     3857     If x-zero = false then do:
     3858       CAse classify :
     3859         when 5 then do:
     3860           run foreach5 in this-procedure.
     3861         end.
     3862         when 6 then do:
     3863           run foreach6 in this-procedure.
     3864         end.
     3865         when 7 then do:
     3866           run foreach7 in this-procedure.
     3867         end.
     3868       End case.
     3869    End.
     3870    Else do:
     3871       CAse classify :
     3872         when 5 then do:
     3873           run foreach5_1 in this-procedure.
     3874         end.
     3875         when 6 then do:
     3876           run foreach6_1 in this-procedure.
     3877         end.
     3878         when 7 then do:
     3879           run foreach7_1 in this-procedure.
     3880         end.
     3881       End case.
     3882    End.
     3883     HIDE stream OutStream FRAME BottomFrame .
     3884     run  print-footer in this-procedure.
     3885     HIDE STREAM OutStream FRAME Zapas .
     3886     HIDE   STREAM OutStream FRAME top-Frame .
     3887     DELETE WIDGET-POOL "My-pool".
     3888     Output stream OutStream close.
     3889     if Make-Excel then output stream ForExcel close.
     3890   if mFrameView
     3891   then do:
     3892      HIDE FRAME InfoFrame.
     3893   end.
     3894     define variable v-user-action as character no-undo .
     3895     define variable v-printed as logical   no-undo .
     3896     define variable DisabledOptions as integer   no-undo .
     3897     define variable v-orient-page as character no-undo .
     3898     run How-name in this-procedure (
     3899         input ReportPageHeight,
     3900         input ReportPageWidth,
     3901         output v-orient-page )
     3902         .
     3903     if v-orient-page = "A4-lans":U then DisabledOptions = 8 .
     3904                                    else DisabledOptions = 0 .
     3905     run gbl/prnfilen.w
     3906       (input  ""
     3907       ,input  DisabledOptions
     3908       ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
     3909       ,input ReportFontNum
     3910       ,output v-user-action
     3911       ,output v-printed
     3912       ) .
     3913   END PROCEDURE.
     3914   PROCEDURE print-header :
     3915      PUT stream OutStream  string(v-cntxt-host-name-obj +  " , " + x-store-type  +  " " + ObjName)
     3916            AT 50 format "X(85)" SKIP(2)
     3917            REPORTNAME
     3918            AT 35  format "X(100)" skip.
     3919        PUT stream OutStream   "за период с "  + string(x-date-start,"99/99/9999") +
     3920            " по "  + string(x-date-end,"99/99/9999") +
     3921            " дата и время формирования " + cur-time-string-sec()
     3922                                                       AT 35 format "X(160)" SKIP.
     3923        Repeat i = 1 to NUM-ENTRIES(STR2,chr(10)) :
     3924           PUT stream OutStream  Entry(i,STR2,chr(10))  AT 1 format "X(160)" SKIP.
     3925        End.
     3926        Repeat i = 1 to NUM-ENTRIES(STR3,chr(10)) :
     3927           PUT stream OutStream  Entry(i,STR3,chr(10))  AT 1 format "X(160)" SKIP.
     3928        End.
     3929        Repeat i = 1 to NUM-ENTRIES(STR4,chr(10)) :
     3930           PUT stream OutStream  Entry(i,STR4,chr(10))  AT 1 format "X(160)" SKIP.
     3931        End.
     3932        Repeat i = 1 to NUM-ENTRIES(ReportHeader,chr(10)) :
     3933           PUT stream OutStream  Entry(i,ReportHeader,chr(10))  AT 1 format "X(160)" SKIP.
     3934        End.
     3935       i=0.
     3936       run rep/extitle.p (1) .
     3937       display STREAM OutStream     with frame top-Frame .
     3938   END PROCEDURE.
     3939   PROCEDURE Print-Footer :
     3940     run cur-time in this-procedure ( output v-today
     3941                                    , output v-time
     3942                                    ).
     3943     PUT STREAM OutStream UNFORMATTED " Печать закончена : " + string(v-time,"HH:MM:SS") SKIP.
     3944     PUT STREAM OutStream UNFORMATTED " За время формирования отчета были закрыты документы : " SKIP.
     3945     for each ub.trn-doc no-lock where
     3946         ub.trn-doc.status_ = 'факт':U and
     3947         ub.trn-doc.flag_= true and
     3948         ub.trn-doc.host-code = v-cntxt-host-code-obj
     3949         by ub.trn-doc.fact-order DESCENDING :
     3950         If ub.trn-doc.fact-order <= fact-order-2 then leave.
     3951         PUT STREAM OutStream  UNFORMATTED ub.trn-doc.doc-code SKIP.
     3952     end.
     3953     PUT STREAM OutStream UNFORMATTED " ______________________________________________________" SKIP.
     3954      run on-same-page in this-procedure (input 1) .
     3955   END PROCEDURE.
     3956   PROCEDURE U-LINE :
     3957   define variable ff as character no-undo .
     3958   if itog = false
     3959   Then do:
     3960   ff = fill("-",40).
     3961     if c-nn <>  ?  then do :
     3962       c-nn:screen-value = string(ff) .
     3963       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     3964           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     3965           display STREAM OutStream    with frame top-frame .
     3966       End.
     3967     End.
     3968     if c-f-b-code <>  ?  then do :
     3969       c-f-b-code:screen-value = string(ff) .
     3970       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     3971           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     3972           display STREAM OutStream    with frame top-frame .
     3973       End.
     3974     End.
     3975     if c-f-artic <>  ?  then do :
     3976       c-f-artic:screen-value = string(ff) .
     3977       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     3978           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
