     8515   END PROCEDURE.
     8516   PROCEDURE Display-prt :
     8517   if goods.prt-root <> Prtroot Then DO:
     8518   If v-var = "no-today"  then
     8519   run prdoclib-init-prt-obj-by-factord in this-procedure
     8520   ( input gds-obj.obj-type  ,
     8521   input gds-obj.obj-code  ,
     8522   input gds-obj.artic     ,
     8523   input gds-obj.prod-type ,
     8524   input gds-obj.prod-code ,
     8525   input fact-order-2 ,
     8526   input false ) .
     8527   for each ub.prt-obj where
     8528     ub.prt-obj.artic     = goods.artic         and
     8529     ub.prt-obj.prod-type = goods.prod-type and
     8530     ub.prt-obj.prod-code = goods.prod-code and
     8531     ub.prt-obj.obj-code  = obj-list.obj-code   and
     8532     ub.prt-obj.obj-type  = obj-list.obj-type   and
     8533     ub.prt-obj.IS-term   =  true no-lock
     8534           BREAK BY ub.prt-obj.prt-code with FRAME Zapas:
     8535                 if v-var <> "no-today" then do:
     8536                   Assign
     8537                     p-qnty-o     = p-qnty-o     + ub.prt-obj.fact-qnty
     8538                     p-crsa-sum-o = p-crsa-sum-o + ub.prt-obj.fact-qnty * ub.prt-obj.price-sale .
     8539                 End.
     8540   IF last-of(prt-obj.prt-code) THEN DO:
     8541   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     8542     (input  gds-obj.gds-code
     8543     ,input  ub.prt-obj.prt-code
     8544     ,output v-bar-code
     8545     )  .
     8546             if v-var = "no-today" then do:
     8547               find first temp-prt-obj no-lock
     8548                     where temp-prt-obj.prt-obj-recid   = recid (prt-obj) no-error .
     8549                     if avail temp-prt-obj then do :
     8550                       run calc-price-sale-for-prt in this-procedure  (output v-price-sale) .
     8551                       Assign
     8552                         p-qnty-o      = temp-prt-obj.fact-qnty
     8553                         p-crsa-sum-o  = temp-prt-obj.fact-qnty * v-price-sale      .
     8554                     End.
     8555                     Else
     8556                       Assign
     8557                         p-qnty-o      = 0
     8558                         p-crsa-sum-o  = 0   .
     8559             End.
     8560       FIND first ub.gds-prt  where ub.gds-prt.node-code = ub.prt-obj.prt-code NO-LOCK no-error .
     8561       for each ub.gds-dtl no-lock where
     8562           ub.gds-dtl.artic      = goods.artic     and
     8563           ub.gds-dtl.prod-code  = goods.prod-code and
     8564           ub.gds-dtl.prod-type  = goods.prod-type and
     8565           ub.gds-dtl.prt-code   = ub.prt-obj.prt-code  and
     8566           ub.gds-dtl.obj-code   = obj-list.obj-code  and
     8567           ub.gds-dtl.obj-type   = obj-list.obj-type :
     8568               find first temp-doc-code where temp-doc-code.doc-code = ub.gds-dtl.doc-code no-lock no-error .
     8569                 if avail temp-doc-code then DO:
     8570                 Assign
     8571                     t-qnty = if temp-doc-code.ext-doc-type = 'vt':U
     8572                                 then ub.gds-dtl.doc-qnty
     8573                                 else ( ub.gds-dtl.fact-qnty * temp-doc-code.si )
     8574                     p-qnty       = p-qnty       + t-qnty
     8575                     p-sale-sum   = p-sale-sum   + (gds-dtl.price-base * t-qnty)
     8576                     p-sale-other = p-sale-other + (gds-dtl.discnt-base * temp-doc-code.si2)
     8577                     p-crsa-sum   = p-crsa-sum   + (gds-dtl.cur-base * t-qnty)
     8578                     .
     8579               End.
     8580               find first temp-doc-code-all where temp-doc-code-all.doc-code = ub.gds-dtl.doc-code no-lock no-error .
     8581                 if avail temp-doc-code-all then DO:
     8582                     Assign
     8583                     t-qnty-all = if temp-doc-code-all.ext-doc-type = 'vt':U
     8584                                       then ub.gds-dtl.doc-qnty
     8585                                       else ( ub.gds-dtl.fact-qnty * temp-doc-code-all.si )
     8586                       p-qnty-all       = p-qnty-all  + t-qnty-all
     8587                       p-crsa-sum-all   = p-crsa-sum-all   + (gds-dtl.cur-base * t-qnty-all ).
     8588                 End.
     8589       end.
     8590       if f-qnty <> ? and f-qnty <> 0 then
     8591           Assign
     8592             p-cost-sum     = f-cost-sum      * p-qnty     / f-qnty
     8593           .
     8594       else
     8595           Assign
     8596               p-cost-sum     = 0
     8597           .
     8598       if f-qnty-all <> ? and f-qnty-all <> 0 then
     8599           Assign
     8600             p-cost-sum-all = f-cost-sum-all  * p-qnty-all / f-qnty-all
     8601           .
     8602       else
     8603           Assign
     8604               p-cost-sum-all = 0
     8605             .
     8606       if f-qnty-o <> ? and f-qnty-o <> 0 then
     8607           Assign
     8608             p-cost-sum-o   = f-cost-sum-o    * p-qnty-o   / f-qnty-o
     8609           .
     8610       else
     8611           Assign
     8612               p-cost-sum-o   = 0
     8613           .
     8614       if  NOT(p-qnty      =  0 and
     8615             p-cost-sum    =  0     and
     8616             p-sale-sum    =  0     and
     8617             p-sale-other  =  0     and
     8618             p-crsa-sum    =  0     and
     8619             p-qnty-all    =  0     and
     8620             p-cost-sum-all = 0     and
     8621             p-crsa-sum-all=  0    ) then dO:
     8622     if c-nn <>  ?  then do :
     8623       c-nn:screen-value = string('') .
     8624       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8625           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8626           display STREAM OutStream    with frame top-frame .
     8627       End.
     8628     End.
     8629     if c-f-artic <>  ?  then do :
     8630       c-f-artic:screen-value = string('') .
     8631       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8632           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8633           display STREAM OutStream    with frame top-frame .
     8634       End.
     8635     End.
     8636     if c-f-b-code <>  ?  then do :
     8637       c-f-b-code:screen-value = string(string(v-bar-code,'999999999')) .
     8638       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8639           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8640           display STREAM OutStream    with frame top-frame .
     8641       End.
     8642     End.
     8643     if c-f-gds-name <>  ?  then do :
     8644       c-f-gds-name:screen-value = string(ub.gds-prt.f-name) .
     8645       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8646           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8647           display STREAM OutStream    with frame top-frame .
     8648       End.
     8649     End.
     8650     if c-f-qnty <>  ?  then do :
     8651       c-f-qnty:screen-value = string(p-qnty) .
     8652       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8653           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8654           display STREAM OutStream    with frame top-frame .
     8655       End.
     8656     End.
     8657     if c-f-cost-sum <>  ?  then do :
     8658       c-f-cost-sum:screen-value = string(p-cost-sum) .
     8659       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8660           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8661           display STREAM OutStream    with frame top-frame .
     8662       End.
     8663     End.
     8664     if c-f-sale-sum <>  ?  then do :
     8665       c-f-sale-sum:screen-value = string(p-sale-sum) .
     8666       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8667           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8668           display STREAM OutStream    with frame top-frame .
     8669       End.
     8670     End.
     8671     if c-f-sale-other <>  ?  then do :
     8672       c-f-sale-other:screen-value = string(p-sale-other) .
     8673       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8674           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8675           display STREAM OutStream    with frame top-frame .
     8676       End.
     8677     End.
     8678     if c-f-crsa-sum <>  ?  then do :
     8679       c-f-crsa-sum:screen-value = string(p-crsa-sum) .
     8680       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8681           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8682           display STREAM OutStream    with frame top-frame .
     8683       End.
     8684     End.
     8685     if c-f-qnty-all <>  ?  then do :
     8686       c-f-qnty-all:screen-value = string(p-qnty-all) .
     8687       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8688           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8689           display STREAM OutStream    with frame top-frame .
     8690       End.
     8691     End.
     8692     if c-f-cost-sum-all <>  ?  then do :
     8693       c-f-cost-sum-all:screen-value = string(p-cost-sum-all) .
     8694       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8695           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8696           display STREAM OutStream    with frame top-frame .
     8697       End.
     8698     End.
     8699     if c-f-crsa-sum-all <>  ?  then do :
     8700       c-f-crsa-sum-all:screen-value = string(p-crsa-sum-all) .
     8701       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8702           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8703           display STREAM OutStream    with frame top-frame .
     8704       End.
     8705     End.
     8706     if c-f-qnty-o <>  ?  then do :
     8707       c-f-qnty-o:screen-value = string(p-qnty-o) .
     8708       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8709           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8710           display STREAM OutStream    with frame top-frame .
     8711       End.
     8712     End.
     8713     if c-f-cost-sum-o <>  ?  then do :
     8714       c-f-cost-sum-o:screen-value = string(p-cost-sum-o) .
     8715       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8716           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8717           display STREAM OutStream    with frame top-frame .
     8718       End.
     8719     End.
     8720     if c-f-crsa-sum-o <>  ?  then do :
     8721       c-f-crsa-sum-o:screen-value = string(p-crsa-sum-o) .
     8722       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8723           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8724           display STREAM OutStream    with frame top-frame .
     8725       End.
     8726     End.
     8727           Display stream OutStream no-error.
     8728           DOWN stream OutStream .
     8729       if Make-Excel then  put   stream ForExcel unformatted
     8730             " "                             CHR(9)
     8731             " "                             CHR(9)
     8732             format-excel-text(string(v-bar-code,"999999999"))  CHR(9)
     8733             ub.gds-prt.f-name                 CHR(9)
     8734             round(p-qnty,3)                CHR(9)
     8735             round(p-cost-sum,2)            CHR(9)
     8736             round(p-sale-sum,2)            CHR(9)
     8737             round(p-sale-other,2)          CHR(9)
     8738             round(p-crsa-sum,2)            CHR(9)
     8739             round(p-qnty-all,3)            CHR(9)
     8740             round(p-cost-sum-all,2)        CHR(9)
     8741             round(p-crsa-sum-all,2)        CHR(9)
     8742             round(p-qnty-o,3)              CHR(9)
     8743             round(p-cost-sum-o,2)          CHR(9)
     8744             round(p-crsa-sum-o,2)          chr(10) .
     8745       End.
     8746       Assign
     8747         p-qnty        =  0
     8748         p-cost-sum    =  0
     8749         p-sale-sum    =  0
     8750         p-sale-other  =  0
     8751         p-crsa-sum    =  0
     8752         p-qnty-all    =  0
     8753         p-cost-sum-all = 0
     8754         p-crsa-sum-all=  0
     8755         p-qnty-o      =  0
     8756         p-cost-sum-o  =  0
     8757         p-crsa-sum-o  =  0 .
     8758   End.
     8759   End.
     8760   End.
     8761   END PROCEDURE.
     8762   PROCEDURE on-same-page :
     8763     define input parameter p-line-number as integer  no-undo .
     8764     if p-line-number > page-size( OutStream ) then do:
     8765       return .
     8766     end.
     8767     if line-counter( OutStream ) + p-line-number > page-size( OutStream ) then do:
     8768       page stream OutStream .
     8769     end.
     8770   end procedure.
     8771   procedure ost-line :
     8772     define input  parameter x-store-code like ub.clients.obj-code    no-undo .
     8773     define input  parameter x-store-type like ub.clients.obj-type    no-undo .
     8774     define input  parameter x-artic      like ub.stk-line.artic      no-undo .
     8775     define input  parameter x-prod-code  like ub.stk-line.prod-code  no-undo .
     8776     define input  parameter x-prod-type  like ub.stk-line.prod-type  no-undo .
     8777     define input  parameter x-tog-shift  as logical no-undo .
     8778     define input  parameter x-fact-order like ub.stk-line.fact-order no-undo .
     8779     define input  parameter x-sum-type   like ub.stk-line.sum-type   no-undo .
     8780     define input  parameter x-cat-id     like ub.stk-line.cat-id     no-undo .
     8781     define input  parameter xtog-obj     as logical no-undo .
     8782     define output parameter quantity     like ub.stk-line.fact-qnty  no-undo .
     8783     define output parameter coast_r      like ub.stk-line.sum-rubl   no-undo .
     8784     define output parameter coast_v      like ub.stk-line.sum-rubl   no-undo .
     8785     define output parameter vat_r        like ub.stk-line.sum-rubl   no-undo .
     8786     define output parameter vat_v        like ub.stk-line.sum-rubl   no-undo .
     8787     define output parameter slt_r        like ub.stk-line.sum-rubl   no-undo .
     8788     define output parameter slt_v        like ub.stk-line.sum-rubl   no-undo .
     8789     define buffer buff-obj-list  for obj-list .
     8790     define buffer buff-stk-line  for ub.stk-line .
     8791     assign
     8792       Quantity = 0
     8793       Coast_R  = 0
     8794       Coast_V  = 0
     8795       VAT_R    = 0
     8796       VAT_V    = 0
     8797       SLT_R    = 0
     8798       SLT_V    = 0
     8799     .
     8800     if  x-tog-shift = false then do:
     8801       for each buff-obj-list no-lock
     8802         where xtog-obj = false
     8803            or (buff-obj-list.obj-type = x-store-type
     8804               and buff-obj-list.obj-code = x-store-code
     8805               )
     8806       on error undo, return error
     8807       :
     8808       find last buff-stk-line no-lock
     8809         where buff-stk-line.obj-type   = buff-obj-list.obj-type
     8810           and buff-stk-line.obj-code   = buff-obj-list.obj-code
     8811           and buff-stk-line.artic      = x-artic
     8812           and buff-stk-line.prod-type  = x-prod-type
     8813           and buff-stk-line.prod-code  = x-prod-code
     8814           and buff-stk-line.sum-type   = x-sum-type
     8815           and buff-stk-line.cat-id     = '##,##':U
     8816           and buff-stk-line.fact-order <= x-fact-order
     8817           and buff-stk-line.shift-num  = 0
     8818         use-index category
     8819         no-error .
     8820       if available buff-stk-line then do:
     8821         assign
     8822           Quantity = Quantity + buff-stk-line.fact-qnty
     8823           Coast_R  = Coast_R  + buff-stk-line.sum-rubl
     8824           Coast_V  = Coast_V  + buff-stk-line.sum-base
     8825           VAT_R    = VAT_R    + buff-stk-line.VAT-rubl
     8826           VAT_V    = VAT_V    + buff-stk-line.VAT-base
     8827           SLT_R    = SLT_R    + buff-stk-line.SLT-rubl
     8828           SLT_V    = SLT_V    + buff-stk-line.SLT-base
     8829         .
     8830       end.
     8831      end.
     8832     end.
     8833     else do:
     8834       for each buff-obj-list no-lock
     8835         where xtog-obj = false
     8836            or (buff-obj-list.obj-type = x-store-type
     8837               and buff-obj-list.obj-code = x-store-code
     8838               )
     8839       on error undo, return error
     8840       :
     8841         find last buff-stk-line no-lock
     8842           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     8843             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     8844             and buff-stk-line.artic      = x-artic
     8845             and buff-stk-line.prod-type  = x-prod-type
     8846             and buff-stk-line.prod-code  = x-prod-code
     8847             and buff-stk-line.sum-type   = x-sum-type
     8848             and buff-stk-line.cat-id     = '##,##':U
     8849             and buff-stk-line.fact-order <= x-fact-order
     8850             and buff-stk-line.shift-num  > 0
     8851           use-index category
     8852           no-error .
     8853         if available buff-stk-line then do:
     8854           assign
     8855             Quantity = Quantity +  buff-stk-line.fact-qnty
     8856             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     8857             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     8858             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     8859             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     8860             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     8861             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     8862           .
     8863         end.
     8864       end.
     8865     end.
     8866   end procedure.
     8867   procedure ost-lineother-tax :
     8868     define input  parameter x-store-code like ub.clients.obj-code      no-undo.
     8869     define input  parameter x-store-type like ub.clients.obj-type      no-undo.
     8870     define input  parameter x-artic      like ub.stk-line.artic        no-undo.
     8871     define input  parameter x-prod-code  like ub.stk-line.prod-code    no-undo.
     8872     define input  parameter x-prod-type  like ub.stk-line.prod-type    no-undo.
     8873     define input  parameter x-tog-shift  as logical no-undo .
     8874     define input  parameter x-fact-order like ub.stk-line.fact-order   no-undo.
     8875     define input  parameter x-sum-type   like ub.stk-line.sum-type     no-undo.
     8876     define input  parameter x-type-id    like ub.stk-line.cat-id       no-undo.
     8877     define input  parameter xTog-obj     as logical no-undo .
     8878     define output parameter Quantity     like ub.stk-line.fact-qnty   no-undo.
     8879     define output parameter Coast_R      like ub.stk-line.sum-rubl    no-undo.
     8880     define output parameter Coast_V      like ub.stk-line.sum-rubl    no-undo.
     8881     define output parameter VAT_R        like ub.stk-line.sum-rubl    no-undo.
     8882     define output parameter VAT_V        like ub.stk-line.sum-rubl    no-undo.
     8883     define output parameter SLT_R        like ub.stk-line.sum-rubl    no-undo.
     8884     define output parameter SLT_V        like ub.stk-line.sum-rubl    no-undo.
     8885     define output parameter other_R      like ub.stk-line.sum-rubl    no-undo.
     8886     define output parameter other_V      like ub.stk-line.sum-rubl    no-undo.
     8887     define buffer buff-obj-list  for obj-list .
     8888     define buffer buff-stk-line  for ub.stk-line .
     8889     assign
     8890       Quantity = 0
     8891       Coast_R  = 0
     8892       Coast_V  = 0
     8893       VAT_R    = 0
     8894       VAT_V    = 0
     8895       SLT_R    = 0
     8896       SLT_V    = 0
     8897       other_R  = 0
     8898       other_V  = 0
     8899     .
     8900     if  x-tog-shift = false then do:
     8901       for each buff-obj-list no-lock
     8902         where xtog-obj = false
     8903            or (buff-obj-list.obj-type = x-store-type
     8904               and buff-obj-list.obj-code = x-store-code
     8905               )
     8906       on error undo, return error
     8907       :
     8908       find last buff-stk-line no-lock
     8909         where buff-stk-line.obj-type   = buff-obj-list.obj-type
     8910           and buff-stk-line.obj-code   = buff-obj-list.obj-code
     8911           and buff-stk-line.artic      = x-artic
     8912           and buff-stk-line.prod-type  = x-prod-type
     8913           and buff-stk-line.prod-code  = x-prod-code
     8914           and buff-stk-line.sum-type   = x-sum-type
     8915           and buff-stk-line.cat-id     = '##,##':U
     8916           and buff-stk-line.fact-order <= x-fact-order
     8917           and buff-stk-line.shift-num  = 0
     8918         use-index category
     8919         no-error .
     8920       if available buff-stk-line then do:
     8921         assign
     8922           Quantity = Quantity + buff-stk-line.fact-qnty
     8923           Coast_R  = Coast_R  + buff-stk-line.sum-rubl
     8924           Coast_V  = Coast_V  + buff-stk-line.sum-base
     8925           VAT_R    = VAT_R    + buff-stk-line.VAT-rubl
     8926           VAT_V    = VAT_V    + buff-stk-line.VAT-base
     8927           SLT_R    = SLT_R    + buff-stk-line.SLT-rubl
     8928           SLT_V    = SLT_V    + buff-stk-line.SLT-base
     8929           other_R  = other_R  + buff-stk-line.other-rubl
     8930           other_V  = other_V  + buff-stk-line.other-base
     8931         .
     8932       end.
     8933    end.
     8934     end.
     8935     else do:
     8936       for each buff-obj-list no-lock
     8937         where xtog-obj = false
     8938            or (buff-obj-list.obj-type = x-store-type
     8939               and buff-obj-list.obj-code = x-store-code
     8940               )
     8941       on error undo, return error
     8942       :
     8943         find last buff-stk-line no-lock
     8944           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     8945             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     8946             and buff-stk-line.artic      = x-artic
     8947             and buff-stk-line.prod-type  = x-prod-type
     8948             and buff-stk-line.prod-code  = x-prod-code
     8949             and buff-stk-line.sum-type   = x-sum-type
     8950             and buff-stk-line.cat-id     = '##,##':U
     8951             and buff-stk-line.fact-order <= x-fact-order
     8952             and buff-stk-line.shift-num  > 0
     8953           use-index category
     8954           no-error .
     8955         if available buff-stk-line then do:
     8956           assign
     8957             Quantity = Quantity +  buff-stk-line.fact-qnty
     8958             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     8959             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     8960             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     8961             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     8962             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     8963             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     8964             other_R = other_R   +  buff-stk-line.other-rubl
     8965             other_V = other_V   +  buff-stk-line.other-base
     8966           .
     8967         end.
     8968       end.
     8969     end.
     8970   end procedure.
     8971   procedure ost-line-kg :
     8972     define  input parameter p-obj-code    like ub.stk-line.obj-code   no-undo .
     8973     define  input parameter p-obj-type    like ub.stk-line.obj-type   no-undo .
     8974     define  input parameter p-artic       like ub.stk-line.artic      no-undo .
     8975     define  input parameter p-prod-code   like ub.stk-line.prod-code  no-undo .
     8976     define  input parameter p-prod-type   like ub.stk-line.prod-type  no-undo .
     8977     define  input parameter p-fact-order  like ub.stk-line.fact-order no-undo .
     8978     define output parameter p-quantity-kg like ub.stk-line.fact-qnty  no-undo initial 0.00 .
     8979     define buffer buff-obj-list  for obj-list .
     8980     define buffer buf_doc-line for ub.doc-line .
     8981     define buffer buf_inv-line for ub.inv-line .
     8982     do
     8983     on error undo, return error
     8984     :
     8985       for each buf_doc-line no-lock where
     8986                buf_doc-line.obj-type    = p-obj-type   and
     8987                buf_doc-line.obj-code    = p-obj-code   and
     8988                buf_doc-line.prod-type   = p-prod-type  and
     8989                buf_doc-line.prod-code   = p-prod-code  and
     8990                buf_doc-line.artic       = p-artic      and
     8991                buf_doc-line.status_     = 'факт':U      and
     8992                buf_doc-line.fact-order <= p-fact-order
     8993             by buf_doc-line.fact-order    descending
     8994       :
     8995         find first buf_inv-line no-lock where
     8996                    buf_inv-line.doc-code  = buf_doc-line.doc-code  and
     8997                    buf_inv-line.artic     = buf_doc-line.artic     and
     8998                    buf_inv-line.prod-type = buf_doc-line.prod-type and
     8999                    buf_inv-line.prod-code = buf_doc-line.prod-code no-error .
     9000         if available buf_inv-line
     9001         then do:
     9002           if buf_inv-line.after-cli-qnty <> ?
     9003           then do:
     9004             assign
     9005               p-quantity-kg = buf_inv-line.after-cli-qnty
     9006             .
     9007             leave .
     9008           end.
     9009         end.
     9010       end.
     9011       if p-quantity-kg = ?
     9012       then do:
     9013         assign
     9014           p-quantity-kg = 0
     9015         .
     9016       end.
     9017     end.
     9018   end procedure.
     9019   procedure calc-price-sale-for-prt :
     9020   define output parameter v-cur-base as decimal no-undo .
     9021   end procedure.
     9022   Procedure display-str-cr :
     9023     if c-nn <>  ?  then do :
     9024       c-nn:screen-value = string(string(n-nn)) .
     9025       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9026           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9027           display STREAM OutStream    with frame top-frame .
     9028       End.
     9029     End.
     9030     if c-f-artic <>  ?  then do :
     9031       c-f-artic:screen-value = string(ub.ot-line.artic) .
     9032       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9033           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9034           display STREAM OutStream    with frame top-frame .
     9035       End.
     9036     End.
     9037     if c-f-b-code <>  ?  then do :
     9038       c-f-b-code:screen-value = string(string(v-bar-code,'999999999')) .
     9039       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9040           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9041           display STREAM OutStream    with frame top-frame .
     9042       End.
     9043     End.
     9044     if c-f-gds-name <>  ?  then do :
     9045       c-f-gds-name:screen-value = string(goods.gds-name) .
     9046       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9047           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9048           display STREAM OutStream    with frame top-frame .
     9049       End.
     9050     End.
     9051     if c-f-qnty <>  ?  then do :
     9052       c-f-qnty:screen-value = string(f-qnty) .
     9053       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9054           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9055           display STREAM OutStream    with frame top-frame .
     9056       End.
     9057     End.
     9058     if c-f-cost-sum <>  ?  then do :
     9059       c-f-cost-sum:screen-value = string(f-cost-sum) .
     9060       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9061           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9062           display STREAM OutStream    with frame top-frame .
     9063       End.
     9064     End.
     9065     if c-f-sale-sum <>  ?  then do :
     9066       c-f-sale-sum:screen-value = string(f-sale-sum) .
     9067       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9068           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9069           display STREAM OutStream    with frame top-frame .
     9070       End.
     9071     End.
     9072     if c-f-sale-other <>  ?  then do :
     9073       c-f-sale-other:screen-value = string(f-sale-other) .
     9074       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9075           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9076           display STREAM OutStream    with frame top-frame .
     9077       End.
     9078     End.
     9079     if c-f-crsa-sum <>  ?  then do :
     9080       c-f-crsa-sum:screen-value = string(f-crsa-sum) .
     9081       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9082           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9083           display STREAM OutStream    with frame top-frame .
     9084       End.
     9085     End.
     9086     if c-f-qnty-all <>  ?  then do :
     9087       c-f-qnty-all:screen-value = string(f-qnty-all) .
     9088       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9089           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9090           display STREAM OutStream    with frame top-frame .
     9091       End.
     9092     End.
     9093     if c-f-cost-sum-all <>  ?  then do :
     9094       c-f-cost-sum-all:screen-value = string(f-cost-sum-all) .
     9095       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9096           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9097           display STREAM OutStream    with frame top-frame .
     9098       End.
     9099     End.
     9100     if c-f-crsa-sum-all <>  ?  then do :
     9101       c-f-crsa-sum-all:screen-value = string(f-crsa-sum-all) .
     9102       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9103           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9104           display STREAM OutStream    with frame top-frame .
     9105       End.
     9106     End.
     9107     if c-f-qnty-o <>  ?  then do :
     9108       c-f-qnty-o:screen-value = string(f-qnty-o) .
     9109       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9110           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9111           display STREAM OutStream    with frame top-frame .
     9112       End.
     9113     End.
     9114     if c-f-cost-sum-o <>  ?  then do :
     9115       c-f-cost-sum-o:screen-value = string(f-cost-sum-o) .
     9116       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9117           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9118           display STREAM OutStream    with frame top-frame .
     9119       End.
     9120     End.
     9121     if c-f-crsa-sum-o <>  ?  then do :
     9122       c-f-crsa-sum-o:screen-value = string(f-crsa-sum-o) .
     9123       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9124           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9125           display STREAM OutStream    with frame top-frame .
     9126       End.
     9127     End.
     9128     display stream OutStream   with frame zapas  no-error  .
     9129     DOWN stream OutStream  with frame zapas .
     9130     if Make-Excel then  put   stream ForExcel unformatted
     9131       string(n-nn)                      CHR(9)
     9132       v-bar-code                        CHR(9)
     9133       (ub.ot-line.artic)  CHR(9)
     9134       goods.gds-name                    CHR(9)
     9135       excel-qnty(f-qnty        )        CHR(9)
     9136       excel-sum (f-cost-sum    )        CHR(9)
     9137       excel-sum (f-sale-sum    )        CHR(9)
     9138       excel-sum (f-sale-other  )        CHR(9)
     9139       excel-sum (f-crsa-sum    )        CHR(9)
     9140       excel-sum (f-qnty-all    )        CHR(9)
     9141       excel-sum (f-cost-sum-all)        CHR(9)
     9142       excel-sum (f-crsa-sum-all)        CHR(9)
     9143       excel-sum (f-qnty-o      )        CHR(9)
     9144       excel-qnty(f-cost-sum-o  )        CHR(9)
     9145       excel-qnty(f-crsa-sum-o  )        chr(10) .
     9146   end procedure.
     9147   procedure init-p2 :
     9148   run cur-time in this-procedure ( output v-today
     9149                               , output x-time
     9150                               ).
     9151   find last ub.ot-tot  no-lock use-index pi .
     9152   if avail  ub.ot-tot then fix-doc-code = ub.ot-tot.doc-code.
     9153                 else fix-doc-code = "".
     9154   FIND first clients where x-store-type = clients.obj-type AND
     9155           x-store-code = clients.obj-code no-lock no-error.
     9156           If available clients then  ObjName = clients.obj-name.
     9157                                         else  ObjName="объект не определен".
     9158     assign
     9159       i=0
     9160       startdate     = x-date-start
     9161       enddate       = x-date-end
     9162       PayType       = x-SET_PAY_TYPE
     9163       v-var         = string("")
     9164       ValType       = IF (PayType = 1) Then 0  else x-SET_val_TYPE.
     9165       Find first ub.gds-prt where ub.gds-prt.node-name = '_Пустая шкала':U no-lock no-error.
     9166       If available  ub.gds-prt then   Prtroot = ub.gds-prt.prt-root.
     9167                             Else   Prtroot = 0.
     9168   end procedure.
     9169   procedure in-proc:
     9170     if can-find( first tdedt where  ub.ot-line.ext-doc-type = tdedt.id no-lock ) then DO:
     9171         Case  ub.ot-line.sum-type :
     9172             When 'cost':U then do:
     9173                 f-cost-sum = f-cost-sum + ub.ot-line.sum-base .
     9174             End.
     9175             When 'sale':U then do:
     9176                 f-sale-sum   = f-sale-sum   +  ub.ot-line.sum-base .
     9177                 f-sale-other = f-sale-other + ub.ot-line.other-base .
     9178             End.
     9179             When  'crsa':U then do:
     9180                 f-crsa-sum = f-crsa-sum + ub.ot-line.sum-base  .
     9181                 f-qnty     = f-qnty     + ub.ot-line.fact-qnty .
     9182                 IF itog = false then do:
     9183                     Create temp-doc-code .
     9184                     Assign  temp-doc-code.doc-code = ub.ot-line.doc-code
     9185                             temp-doc-code.ext-doc-type = ub.ot-line.ext-doc-type
     9186                     .
     9187                 End.
     9188             End.
     9189         End case.
     9190       End.
     9191         Case  ub.ot-line.sum-type :
     9192             when 'cost':U then do:
     9193               f-cost-sum-all = f-cost-sum-all + ub.ot-line.sum-base .
     9194             end.
     9195             when  'crsa':U then do:
     9196               f-crsa-sum-all = f-crsa-sum-all + ub.ot-line.sum-base  .
     9197               f-qnty-all     = f-qnty-all     + ub.ot-line.fact-qnty .
     9198             end.
     9199         End case.
     9200   end procedure.
     9201   procedure last-of-artic :
     9202           n-nm = n-nm + 1.
     9203           Assign
     9204             f-qnty-o     = gds-obj.fact-qnty
     9205             f-cost-sum-o = gds-obj.fact-base
     9206             f-crsa-sum-o = gds-obj.fact-sale.
     9207           if itog = false and
     9208             ( x-zero  or
     9209             not(f-qnty        = 0 and
     9210                 f-cost-sum    = 0 and
     9211                 f-sale-sum    = 0 and
     9212                 f-sale-other  = 0 and
     9213                 f-crsa-sum    = 0 and
     9214                 f-qnty-all    = 0 and
     9215                 f-cost-sum-all =0 and
     9216                 f-crsa-sum-all =0 and
     9217                 f-qnty-o       =0 and
     9218                 f-cost-sum-o   =0 and
     9219                 f-crsa-sum-o   =0 ))
     9220             Then DO:
     9221             if x-zero = true and v-show-all-goods = false and
     9222                (f-qnty        = 0 and
     9223                 f-cost-sum    = 0 and
     9224                 f-sale-sum    = 0 and
     9225                 f-sale-other  = 0 and
     9226                 f-crsa-sum    = 0 and
     9227                 f-qnty-all    = 0 and
     9228                 f-cost-sum-all =0 and
     9229                 f-crsa-sum-all =0 and
     9230                 f-qnty-o       =0 and
     9231                 f-cost-sum-o   =0 and
     9232                 f-crsa-sum-o   =0 ) then next.
     9233                 n-nn = n-nn + 1 .
     9234   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     9235     (input  gds-obj.gds-code
     9236     ,input  ?
     9237     ,output v-bar-code
     9238     )  .
     9239     if c-nn <>  ?  then do :
     9240       c-nn:screen-value = string(string(n-nn)) .
     9241       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9242           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9243           display STREAM OutStream    with frame top-frame .
     9244       End.
     9245     End.
     9246     if c-f-artic <>  ?  then do :
     9247       c-f-artic:screen-value = string(gds-obj.artic) .
     9248       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9249           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9250           display STREAM OutStream    with frame top-frame .
     9251       End.
     9252     End.
     9253     if c-f-b-code <>  ?  then do :
     9254       c-f-b-code:screen-value = string(string(v-bar-code,'999999999')) .
     9255       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9256           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9257           display STREAM OutStream    with frame top-frame .
     9258       End.
     9259     End.
     9260     if c-f-gds-name <>  ?  then do :
     9261       c-f-gds-name:screen-value = string(goods.gds-name) .
     9262       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9263           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9264           display STREAM OutStream    with frame top-frame .
     9265       End.
     9266     End.
     9267     if c-f-qnty <>  ?  then do :
     9268       c-f-qnty:screen-value = string(f-qnty) .
     9269       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9270           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9271           display STREAM OutStream    with frame top-frame .
     9272       End.
     9273     End.
     9274     if c-f-cost-sum <>  ?  then do :
     9275       c-f-cost-sum:screen-value = string(f-cost-sum) .
     9276       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9277           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9278           display STREAM OutStream    with frame top-frame .
     9279       End.
     9280     End.
     9281     if c-f-sale-sum <>  ?  then do :
     9282       c-f-sale-sum:screen-value = string(f-sale-sum) .
     9283       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9284           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9285           display STREAM OutStream    with frame top-frame .
     9286       End.
     9287     End.
     9288     if c-f-sale-other <>  ?  then do :
     9289       c-f-sale-other:screen-value = string(f-sale-other) .
     9290       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9291           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9292           display STREAM OutStream    with frame top-frame .
     9293       End.
     9294     End.
     9295     if c-f-crsa-sum <>  ?  then do :
     9296       c-f-crsa-sum:screen-value = string(f-crsa-sum) .
     9297       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9298           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9299           display STREAM OutStream    with frame top-frame .
     9300       End.
     9301     End.
     9302     if c-f-qnty-all <>  ?  then do :
     9303       c-f-qnty-all:screen-value = string(f-qnty-all) .
     9304       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9305           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9306           display STREAM OutStream    with frame top-frame .
     9307       End.
     9308     End.
     9309     if c-f-cost-sum-all <>  ?  then do :
     9310       c-f-cost-sum-all:screen-value = string(f-cost-sum-all) .
     9311       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9312           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9313           display STREAM OutStream    with frame top-frame .
     9314       End.
     9315     End.
     9316     if c-f-crsa-sum-all <>  ?  then do :
     9317       c-f-crsa-sum-all:screen-value = string(f-crsa-sum-all) .
     9318       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9319           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9320           display STREAM OutStream    with frame top-frame .
     9321       End.
     9322     End.
     9323     if c-f-qnty-o <>  ?  then do :
     9324       c-f-qnty-o:screen-value = string(f-qnty-o) .
     9325       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9326           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9327           display STREAM OutStream    with frame top-frame .
     9328       End.
     9329     End.
     9330     if c-f-cost-sum-o <>  ?  then do :
     9331       c-f-cost-sum-o:screen-value = string(f-cost-sum-o) .
     9332       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9333           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9334           display STREAM OutStream    with frame top-frame .
     9335       End.
     9336     End.
     9337     if c-f-crsa-sum-o <>  ?  then do :
     9338       c-f-crsa-sum-o:screen-value = string(f-crsa-sum-o) .
     9339       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9340           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9341           display STREAM OutStream    with frame top-frame .
     9342       End.
     9343     End.
     9344                 display stream OutStream with FRAME Zapas  no-error .
     9345                 DOWN stream OutStream with FRAME Zapas.
     9346                 if Make-Excel then  put   stream ForExcel unformatted
     9347                   string(n-nn)                      CHR(9)
     9348                   v-bar-code                        CHR(9)
     9349                   (gds-obj.artic)                   CHR(9)
     9350                   goods.gds-name                    CHR(9)
     9351                   excel-qnty(f-qnty        )        CHR(9)
     9352                   excel-sum (f-cost-sum    )        CHR(9)
     9353                   excel-sum (f-sale-sum    )        CHR(9)
     9354                   excel-sum (f-sale-other  )        CHR(9)
     9355                   excel-sum (f-crsa-sum    )        CHR(9)
     9356                   excel-sum (f-qnty-all    )        CHR(9)
     9357                   excel-sum (f-cost-sum-all)        CHR(9)
     9358                   excel-sum (f-crsa-sum-all)        CHR(9)
     9359                   excel-sum (f-qnty-o      )        CHR(9)
     9360                   excel-qnty(f-cost-sum-o  )        CHR(9)
     9361                   excel-qnty(f-crsa-sum-o  )        chr(10) .
     9362                   run display-prt in this-procedure .
     9363            End.
     9364   end procedure.
