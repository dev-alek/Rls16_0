     7946      if Make-Excel then  put   stream ForExcel unformatted  obj-list.obj-name chr(10).
     7947             n-nn = 0.
     7948             n-no = n-no + 1 .
     7949   for each tt-season no-lock ,
     7950       each ub.gds-season no-lock where
     7951            ub.gds-season.db-num   = tt-season.db-num and
     7952            ub.gds-season.sea-code = tt-season.sea-code ,
     7953       each gds-obj where
     7954             gds-obj.gds-code    = ub.gds-season.gds-code and
     7955             gds-obj.obj-code    = obj-list.obj-code and
     7956             gds-obj.obj-type    = obj-list.obj-type
     7957             and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     7958             no-lock,
     7959             first goods where   gds-obj.gds-code  = goods.gds-code and
     7960                                 goods.gds-type    = 'т':U
     7961                                 no-lock
     7962               break
     7963                   by goods.grp-name
     7964                   by ub.gds-season.db-num
     7965                   by ub.gds-season.sea-code
     7966                   by ub.gds-season.gds-code
     7967                   with FRAME Zapas :
     7968                IF first-of(ub.gds-season.gds-code) then DO:
     7969                   assign
     7970                     f-qnty         = 0
     7971                     f-cost-sum     = 0
     7972                     f-sale-sum     = 0
     7973                     f-sale-other   = 0
     7974                     f-crsa-sum     = 0
     7975                     f-qnty-all     = 0
     7976                     f-cost-sum-all = 0
     7977                     f-crsa-sum-all = 0
     7978                     f-qnty-o       = 0
