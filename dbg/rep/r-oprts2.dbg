     6698                           ub.ot-line.artic     = gds-obj.artic  and
     6699                           ub.ot-line.prod-type = gds-obj.prod-type and
     6700                           ub.ot-line.prod-code = gds-obj.prod-code and
     6701                           (ub.ot-line.sum-type = 'sale':U OR
     6702                             ub.ot-line.sum-type = 'crsa':U OR
     6703                             ub.ot-line.sum-type = 'cost':U ) no-lock :
     6704                       run in-proc in this-procedure .
     6705                 End.
     6706               End.
     6707             if last-of(ub.gds-season.gds-code) then DO:
     6708             run last-of-artic in this-procedure .
