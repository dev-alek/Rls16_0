     5062                                  temp-doc-code.doc-code = ub.ot-line.doc-code
     5063                                  temp-doc-code.ext-doc-type = ub.ot-line.ext-doc-type
     5064                                  temp-doc-code.si  = if  ub.ot-line.fact-qnty < 0 then -1 else 1
     5065                                  temp-doc-code.si2 = if  ub.ot-line.other-base < 0 then -1 else 1
     5066                                  .
     5067                           End.
     5068                       End.
     5069                   End case.
     5070                 End.
