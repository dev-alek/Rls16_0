     4125   PROCEDURE CalcItog :
     4126       run ostatok (
     4127           input x-store-code  ,
     4128           input x-store-type  , x-TOG-Shift,
     4129           input x-date-start - 1 ,
     4130           input date('')      , x-Shift-Start,x-Shift-End,
     4131           input 'crsa':U   ,
     4132           input '##,##':U,
     4133           input xTog-obj ,
     4134           output  Quantity1  ,
     4135           output  Coast_R1   ,
     4136           output  Coast_V1   ,
     4137           output  VAT_R1     ,
     4138           output  VAT_V1     ,
     4139           output  Fact-order-1 ).
     4140     for each ub.trn-doc no-lock where
     4141         ub.trn-doc.status_ = 'факт':U and
     4142         ub.trn-doc.flag_= true  and
     4143         ub.trn-doc.host-code = v-cntxt-host-code-obj
     4144         by ub.trn-doc.fact-order DESCENDING :
     4145           fact-order-2 = ub.trn-doc.fact-order  .
     4146           leave.
     4147     end.
     4148   END PROCEDURE.
