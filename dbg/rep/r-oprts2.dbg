     2092           "Бар-код" buf_main_price-list.b-code skip
     2093           view-as alert-box error .
     2094         undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  )  .
     2095       end.
     2096       find first buf_goods no-lock
     2097         where buf_goods.artic     = buf_main_price-list.artic
     2098           and buf_goods.prod-type = buf_main_price-list.prod-type
     2099           and buf_goods.prod-code = buf_main_price-list.prod-code
     2100         no-error .
     2101       if not available buf_goods
     2102       then do:
     2103         message
     2104           vss-workfile vss-revision vss-description skip
     2105           vss-include-info16 skip
     2106           "Не найден товар" skip
     2107           "Переоценка" buf_main_price-list.doc-num skip
     2108           "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     2109           view-as alert-box error .
     2110         undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     2111       end.
