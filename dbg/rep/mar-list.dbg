     1268   function excel-format-dec-to-char returns char (input p-dec as decimal ).
     1269     if num-entries(string(p-dec), '.') = 2
     1270       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
     1271       else return( string(p-dec)) .
     1272   end function.
     1273   function format-point-to-comma returns char (input orig as char ) .
     1274   define variable rtext as character no-undo .
     1275   define variable strt as integer no-undo .
     1276   define variable leng as integer no-undo .
     1277   assign rtext = orig .
     1278   repeat:
     1279     strt =  index(rtext,'.').
     1280     if strt = 0 then leave.
     1281     leng = 1.
     1282     substring(rtext,strt,leng,"character") = v-delim .
     1283   end.
     1284   return rtext.
     1285   end function.
     1286   function format-excel-text returns char ( input start-text as char ) :
     1287   def var  i    as int no-undo.
     1288   def var  ch   as char no-undo.
     1289   def var  n    as int no-undo.
     1290   def var  ipos as int no-undo.
     1291     n = num-entries(trim(start-text), chr(10)) - 1 .
     1292     do i = 1 to n :
     1293       ipos = index( start-text, chr(10)).
     1294       if ipos > 0 then
     1295         substr( start-text, ipos, 1 ) = ' '.
     1296     end.
     1297     n = num-entries(trim(start-text), chr(13)) - 1 .
     1298     do i = 1 to n :
     1299       ipos = index( start-text, chr(13)).
     1300       if ipos > 0 then
     1301         substr( start-text, ipos, 1 ) = ' '.
     1302     end.
     1303     if index( start-text, '"' ) = 0 then
     1304       start-text =  '="'   + trim( start-text) + '"'   .
     1305       else do:
     1306         n = num-entries(trim(start-text), '"') - 1.
     1307         do i = 1 to n :
     1308           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1309         end.
     1310         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1311         start-text = '="'  + ch  + '"' .
     1312       end.
     1313     return start-text.
     1314   end.
     1315   function excel-sum returns char (input p-dec as decimal ).
     1316     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
     1317   end function.
     1318   function excel-qnty returns char (input p-dec as decimal ).
     1319     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
     1320   end function.
     1321   function format-excel-text-macr returns char ( input start-text as char ) :
     1322   def var  i    as int no-undo.
     1323   def var  ch   as char no-undo.
     1324   def var  n    as int no-undo.
     1325   def var  ipos as int no-undo.
     1326     n = num-entries(trim(start-text), chr(10)) - 1 .
     1327     do i = 1 to n :
     1328       ipos = index( start-text, chr(10)).
     1329       if ipos > 0 then
     1330         substring( start-text, ipos , 1 ) = ' '.
     1331     end.
     1332     n = num-entries(trim(start-text), chr(13)) - 1 .
     1333     do i = 1 to n :
     1334       ipos = index( start-text, chr(13)).
     1335       if ipos > 0 then
     1336         substring( start-text, ipos, 1 ) = ' '.
     1337     end.
     1338     if index( start-text, '"' ) = 0 then
     1339       start-text =  '"'   + trim( start-text) + '"'   .
     1340       else do:
     1341         n = num-entries(trim(start-text), '"') - 1.
     1342         do i = 1 to n :
     1343           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1344         end.
     1345         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1346         start-text = '"'  + ch  + '"' .
     1347       end.
     1348     n = num-entries(trim(start-text), chr(10)) - 1 .
     1349     do i = 1 to n :
     1350       ipos = index( start-text, chr(10)).
     1351       if ipos > 0 then
     1352         substring( start-text, ipos , 1 ) = ' '.
     1353     end.
     1354       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
     1355     return start-text.
     1356   end.
