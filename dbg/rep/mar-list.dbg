      147   procedure create_obj-list :
      148      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      149      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      150      do
      151      on error undo, return error return-value
      152      :
      153         define buffer cli-obj for ub.clients .
      154         define variable p-var as integer no-undo .
      155         define buffer buf_obj-list for obj-list .
      156         find last buf_obj-list  use-index pi no-error .
      157         if available buf_obj-list
      158         then
      159            p-var = buf_obj-list.obj-id + 1.
      160         else
      161            p-var = 1.
      162         find first cli-obj where
      163                   cli-obj.obj-type = p-obj-type
      164               and cli-obj.obj-code = p-obj-code
      165         no-lock no-error.
      166         if available cli-obj
      167         then do:
      168            create buf_obj-list.
      169            assign
      170               buf_obj-list.obj-id   = p-var
      171               buf_obj-list.obj-code = cli-obj.obj-code
      172               buf_obj-list.obj-type = cli-obj.obj-type
      173               buf_obj-list.obj-name = cli-obj.obj-name
      174               buf_obj-list.db-num   = cli-obj.db-num
      175            .
      176         end.
      177      end.
      178   end.
