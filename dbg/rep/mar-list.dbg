     1406     RUN fmtcli-get-client IN THIS-PROCEDURE ( INPUT  ub.clients.obj-type
     1407                                             , INPUT  ub.clients.obj-code
     1408                                             ) .
     1409     assign
     1410       v-address = ( if v-fmtcli-full-addres <> '':U then ( v-fmtcli-full-addres ) else '':U )
     1411     .
     1412           v-ves = 0 .
     1413           for each ub.doc-line no-lock where
     1414                    ub.doc-line.doc-code = ub.trn-doc.doc-code ,
     1415                    first ub.goods no-lock  where ub.goods.prod-type = ub.doc-line.prod-type
     1416                                              and ub.goods.prod-code = ub.doc-line.prod-code
     1417                                              and ub.goods.artic = ub.doc-line.artic
     1418                                              :
     1419               v-ves     = if ub.goods.wt-base = 0 or ub.goods.wt-base = ? then ub.doc-line.fact-qnty  else
     1420                              ub.goods.wt-base * ub.doc-line.fact-qnty .
     1421               v-all-ves = v-all-ves + v-ves .
     1422           end.
