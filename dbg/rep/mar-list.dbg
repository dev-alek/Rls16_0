      599   procedure grplib-get-full-name :
      600      define input parameter p-node-code  as integer      no-undo.
      601      define output parameter p-full-name as character    no-undo.
      602      do
      603   on error undo, return error
      604   :
      605       define variable v-upper-code    as integer           no-undo.
      606       define buffer buf_gds-grp       for ub.gds-grp.
      607       define buffer buf_upper_gds-grp for ub.gds-grp.
      608       find first buf_gds-grp no-lock
      609            where buf_gds-grp.node-code = p-node-code
      610       no-error.
      611       if not available buf_gds-grp
      612       then do:
      613           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      614       end.
      615       assign
      616           p-full-name  = ""
      617           v-upper-code = 1
      618       .
      619       do while buf_gds-grp.upper-code <> 0
      620       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
      621       :
      622           assign
      623               p-full-name  = buf_gds-grp.node-name
      624                            + (if p-full-name <> "" then chr(47) else "")
      625                            + p-full-name
      626               v-upper-code = buf_gds-grp.upper-code
      627           .
      628           find first buf_gds-grp no-lock
      629                where buf_gds-grp.node-code = v-upper-code
      630           no-error.
      631           if not available buf_gds-grp
      632           then do:
      633               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
      634                                   + string( v-upper-code )
      635                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      636           end.
      637       end.
      638       assign
      639       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      640       .
      641   end.
      642   end .
      643   procedure grplib-get-node-from-full-name :
      644   define input parameter p-full-name as character no-undo .
      645   define output parameter p-node-code as integer no-undo .
      646   define variable v-ii as integer no-undo .
      647   define variable v-upper-code as integer no-undo .
      648   define variable v-root-code as integer no-undo .
      649   define variable v-entry as character no-undo .
      650   define buffer buf_gds-grp       for ub.gds-grp.
      651   do
      652   on error undo, return error
      653   :
      654     find first buf_gds-grp no-lock
      655         where buf_gds-grp.upper-code = 0
      656     no-error .
      657     if not available buf_gds-grp
      658     then do:
      659         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
      660     end.
      661     else do:
      662       assign
      663       v-root-code = buf_gds-grp.node-code
      664       .
      665     end.
      666     v-upper-code = v-root-code.
      667     do v-ii = 1 to num-entries(p-full-name, chr(47)):
      668       assign
      669       v-entry = entry(v-ii, p-full-name, chr(47)).
      670       if v-entry = '' then leave.
      671       find first buf_gds-grp no-lock where
      672                 buf_gds-grp.node-name = v-entry
      673             and buf_gds-grp.upper-code = v-upper-code
      674             no-error.
      675       if not available buf_gds-grp then do:
      676         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
      677       end.
      678       else do:
      679         p-node-code = buf_gds-grp.node-code.
      680         v-upper-code = buf_gds-grp.node-code.
      681       end.
      682     end.
      683   end.
      684   end .
      685   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      686     define variable v-cntxt-db-num        as integer   no-undo .
      687     define variable v-cntxt-userid        as character no-undo .
      688     define variable v-cntxt-level         as character no-undo .
      689     define variable v-cntxt-host-code-obj as integer   no-undo .
      690     define variable v-cntxt-obj-type      as character no-undo .
      691     define variable v-cntxt-obj-code      as integer   no-undo .
      692     define variable v-cntxt-db-num-obj    as integer   no-undo .
      693     define variable v-cntxt-is-admin      as logical   no-undo .
      694   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      695   procedure rep-clb_fill-report-xml :
      696   define input parameter p-uniq-key-rec as character no-undo .
      697   define input parameter p-field-name_ as character no-undo .
      698   define input parameter p-dataseth as handle no-undo .
      699   define output parameter p-db-num-list as character no-undo .
      700   define output parameter p-int64-id-list as character no-undo .
      701   define output parameter p-part-num-list as character no-undo .
      702   define variable v-longchar as longchar no-undo .
      703   define variable glog as logical no-undo .
      704   define buffer buf_clob-bind for ub.clob-bin.
      705   define buffer buf_clob-data for ub.clob-data.
      706   for each buf_clob-bind no-lock where
      707             buf_clob-bind.uniq-key-rec = p-uniq-key-rec
      708         and buf_clob-bind.field-name_ = p-field-name_
      709         and buf_clob-bind.resource-type = 'report-xml':U
      710   by buf_clob-bind.uniq-key-rec
      711   by buf_clob-bind.field-name_
      712   by buf_clob-bind.part-num:
      713     find first buf_clob-data no-lock where
      714               buf_clob-data.db-num = buf_clob-bind.db-num
      715           and buf_clob-data.int64-id = buf_clob-bind.int64-id no-error.
      716     if not available buf_clob-data then do:
      717       undo, return error substitute("Отсутствует CLOB-DATA (БД &1 id &2) для имеющегося CLOB-BIND:&3" +
      718                                     "ресурс типа &4 объект &5 файл № &6"
      719                                     ,buf_clob-bind.db-num
      720                                     ,buf_clob-bind.int64-id
      721                                     ,chr(10)
      722                                     , p-uniq-key-rec
      723                                     , p-field-name_
      724                                     ,buf_clob-bind.part-num) .
      725     end.
      726     v-longchar = ''.
      727     COPY-LOB FROM object buf_clob-data.cdata
      728     to OBJECT v-longchar NO-ERROR .
      729     assign
      730     p-part-num-list = p-part-num-list +
      731                       (if p-part-num-list = '' then '' else chr(44)) +
      732                       string(buf_clob-bind.part-num)
      733     p-db-num-list = p-db-num-list +
      734                 (if p-db-num-list = '' then '' else chr(44)) +
      735                 string(buf_clob-bind.db-num)
      736     p-int64-id-list = p-int64-id-list +
      737                 (if p-int64-id-list = '' then '' else chr(44)) +
      738                 string(buf_clob-bind.int64-id)
      739     .
      740     glog = p-dataseth:READ-XML("LONGCHAR"
      741                                 ,v-longchar
      742                                 ,"append"
      743                                 ,?
      744                                 ,?
      745                                 ,?
      746                                 ,"LOOSE") no-error.
      747     v-longchar = ''.
      748     if error-status:error
      749     then do:
      750       undo, return error substitute("&1&2Ошибка при заполнении датасета данными&2" +
      751                                       "отчет ID &3 срез &4"
      752                                       ,vss-include-info12
      753                                       ,chr(10)
      754                                     , p-uniq-key-rec
      755                                     , p-field-name_
      756                                     ).
      757     end.
      758     if not glog then do:
      759       undo, return error substitute("&1&2Ошибка при заполнении датасета данными&2" +
      760                                       "отчет ID &3 срез &4"
      761                                       ,vss-include-info12
      762                                       ,chr(10)
      763                                     , p-uniq-key-rec
      764                                     , p-field-name_
      765                                     ).
      766     end.
      767   end.
      768   v-longchar = ''.
      769   end procedure.
      770   procedure rep-clb_save-rep-xml :
      771   define input parameter parparentproc as widget-handle no-undo .
      772   define input parameter p-parent-handle as handle no-undo .
      773   define input parameter p-log-handle  as handle no-undo .
      774   define input parameter p-cont-handle  as handle no-undo .
      775   define input parameter p-uniq-key-rec as character no-undo .
      776   define input parameter p-field-name_ as character no-undo .
      777   define input parameter p-part-num-list as character no-undo .
      778   define input parameter p-clob-db-num-list as character no-undo .
      779   define input parameter p-int64-id-list as character no-undo .
      780   define input parameter p-locked-rec-handle as handle no-undo .
      781   define input parameter p-descr as character no-undo .
      782   define input parameter p-nws as logical no-undo .
      783   define input parameter p-encoding as character no-undo .
      784   define input parameter p-dataseth as handle no-undo .
      785   define variable v-ii as integer no-undo .
      786   define variable v-clob-db-num as integer no-undo .
      787   define variable v-part-num as integer no-undo .
      788   define variable v-int64-id as integer no-undo .
      789   define variable v-file-name as character no-undo .
      790   define variable v-num-entries as integer no-undo .
      791   do
      792   on error undo, return error
      793   :
      794     if p-part-num-list = "" then do:
      795       assign
      796       p-part-num-list = string(0)
      797       p-clob-db-num-list = ''
      798       p-int64-id-list = string(0)
      799       .
      800     end.
      801     do v-ii = 1 to num-entries(p-part-num-list):
      802       run gbl/_tmpfile.p ( input ""
      803                           ,input "tmp"
      804                           ,output v-file-name).
      805       p-dataseth:write-xml("file"
      806                           ,v-file-name
      807                           ,yes
      808                           ,(if p-encoding = "1251" then "windows-1251" else p-encoding)
      809                           ,?
      810                           ,no
      811                           ,no
      812                           ).
      813       assign
      814       v-part-num = integer(entry(v-ii, p-part-num-list))
      815       v-clob-db-num = (if entry(v-ii, p-clob-db-num-list) = ''
      816                        then ?
      817                        else integer(entry(v-ii, p-clob-db-num-list)))
      818       v-int64-id = int64(entry(v-ii, p-int64-id-list))
      819       .
      820       run gbl/file2clb.p ( input (if v-clob-db-num = ?
      821                                   then 'ДОБАВЛЕНИЕ':U
      822                                   else 'ИЗМЕНЕНИЕ':U)
      823                           ,input ("override" +
      824                                   (if p-nws = no
      825                                    then (chr(44) + string(no))
      826                                    else "")
      827                                   )
      828                           ,input p-locked-rec-handle
      829                           ,input p-uniq-key-rec
      830                           ,input p-field-name_
      831                           ,input p-descr
      832                           ,input-output v-part-num
      833                           ,input 'report-xml':U
      834                           ,input-output v-clob-db-num
      835                           ,input-output v-int64-id
      836                           ,input v-file-name
      837                           ,input p-encoding
      838                           ) no-error .
      839       if error-status:error then do:
      840         undo, return error substitute("&1&2Ошибка при сохранении в БД отчета ID &3 срез &4"
      841                                         ,vss-include-info12
      842                                         ,chr(10)
      843                                       , p-uniq-key-rec
      844                                       , p-field-name_
      845                                       ).
      846       end.
      847       os-delete value(v-file-name).
      848     end.
      849   end.
      850   end procedure.
      851   define variable vss-include-info13 as character format "X(65)" no-undo
      852   initial "@(#)$Workfile$ $Revision$".
