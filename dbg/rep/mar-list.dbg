     1248   if lookup ( "get-handle-all-docs" , h-parent:internal-entries ) > 0 then do:
     1249      run get-handle-all-docs in  h-parent (output h-all-docs ) no-error .
     1250      run get-mark-list       in  h-all-docs  (output p-list-recid ) no-error .
