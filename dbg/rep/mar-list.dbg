      866   define variable v-fmtcli-bank-exists   as logical      no-undo.
      867   define variable v-fmtcli-bank-r-schet  as character    no-undo.
      868   define variable v-fmtcli-bank-c-schet  as character    no-undo.
      869   define variable v-fmtcli-bank-bik      as character    no-undo.
      870   define variable v-fmtcli-bank-name     as character    no-undo.
      871   define variable v-fmtcli-bank-addres   as character    no-undo.
      872   define variable v-fmtcli-bank-city     as character    no-undo.
      873   procedure fmtcli-get-bank :
      874   define input parameter p-host-code      as integer          no-undo.
      875   define input parameter p-obj-type       as character        no-undo.
      876   define input parameter p-obj-code       as integer          no-undo.
      877   define input parameter p-curr-code      as integer          no-undo.
      878       define buffer buf_fin-schet     for ub.fin-schet.
      879       define buffer buf_fin-bank      for ub.fin-bank.
      880   do
      881   for buf_fin-schet
      882     , buf_fin-bank
      883   on error undo, return error
      884   :
      885       assign
      886           v-fmtcli-schet-exists       = no
      887           v-fmtcli-bank-exists        = no
      888           v-fmtcli-bank-r-schet       = "":U
      889           v-fmtcli-bank-c-schet       = "":U
      890           v-fmtcli-bank-bik           = "":U
      891           v-fmtcli-bank-name          = "":U
      892           v-fmtcli-bank-addres        = "":U
      893           v-fmtcli-bank-city          = "":U
      894       .
      895       search-for-schet:
      896       for each buf_fin-schet no-lock
      897          where buf_fin-schet.host-code = p-host-code
      898            and buf_fin-schet.cli-type  = p-obj-type
      899            and buf_fin-schet.cli-code  = p-obj-code
      900            and buf_fin-schet.curr-code = p-curr-code
      901       on error undo, return error
      902       :
      903           if buf_fin-schet.status_   = 'удал':U
      904           then do:
      905           end.
      906           else do:
      907               assign
      908                   v-fmtcli-schet-exists   = yes
      909                   v-fmtcli-bank-r-schet   = trim( buf_fin-schet.r-schet )
      910                   v-fmtcli-bank-c-schet   = trim( buf_fin-schet.c-schet )
      911               .
      912               find first buf_fin-bank no-lock
      913                    where buf_fin-bank.host-code = p-host-code
      914                      and buf_fin-bank.code-bank = buf_fin-schet.code-bank
      915               no-error.
      916               if available buf_fin-bank
      917               then do:
      918                   assign
      919                       v-fmtcli-bank-exists      = yes
      920                       v-fmtcli-bank-bik         = trim( buf_fin-bank.bik )
      921                       v-fmtcli-bank-name        = trim( buf_fin-bank.bank-name )
      922                       v-fmtcli-bank-addres      = trim(buf_fin-bank.addres)
      923                       v-fmtcli-bank-city      = trim(buf_fin-bank.bank-city)
      924                   .
      925               end.
      926               else do:
      927                   assign
      928                       v-fmtcli-bank-exists    = no
      929                       v-fmtcli-bank-bik       = "":U
      930                       v-fmtcli-bank-name      = "":U
      931                       v-fmtcli-bank-addres    = "":U
      932                       v-fmtcli-bank-city      = "":U
      933                   .
      934               end.
      935               leave search-for-schet.
      936           end.
      937       end.
      938   end.
      939   end procedure.
      940   procedure fmtcli-get-client :
      941   define input parameter p-obj-type       as character    no-undo.
      942   define input parameter p-obj-code       as integer      no-undo.
      943       define variable v-temp-fmtcli-address      as character     no-undo.
      944       define variable v-num-country-city    as integer      no-undo.
      945       define buffer buf_clients   for ub.clients.
      946       define buffer buf_firm      for ub.firm.
      947       define buffer buf_store     for ub.store.
      948       define buffer buf_shop      for ub.shop.
      949       define buffer buf_person    for ub.person.
      950   do
      951   for buf_clients
      952     , buf_firm
      953     , buf_store
      954     , buf_shop
      955     , buf_person
      956   on error undo, return error
      957   :
      958       assign
      959           v-fmtcli-name           = "":U
      960           v-fmtcli-addres         = "":U
      961           v-fmtcli-post-addres    = "":U
      962           v-fmtcli-full-addres    = "":U
      963           v-fmtcli-phone          = "":U
      964           v-fmtcli-inn            = "":U
      965           v-fmtcli-kpp            = "":U
      966           v-fmtcli-okpo           = "":U
      967           v-fmtcli-city           = "":U
      968           v-fmtcli-index          = "":U
      969           v-fmtcli-country        = "":U
      970       .
      971       find first buf_clients no-lock
      972            where buf_clients.obj-type = p-obj-type
      973              and buf_clients.obj-code = p-obj-code
      974       .
      975       assign
      976           v-fmtcli-name = buf_clients.obj-name
      977       .
      978       case buf_clients.obj-type:
      979          when 'орг':U
      980          then do:
      981               find first buf_firm no-lock
      982                    where buf_firm.firm-code = buf_clients.obj-code
      983                    no-error
      984               .
      985               if available buf_firm
      986               then do:
      987                   assign
      988                       v-num-country-city = num-entries( buf_firm.city )
      989                       v-fmtcli-engl-name = buf_firm.engl-name
      990                   .
      991                   if v-num-country-city > 0
      992                   then do:
      993                       assign
      994                           v-fmtcli-country    = trim( entry( 1, buf_firm.city ) )
      995                       .
      996                   end.
      997                   if v-num-country-city > 1
      998                   then do:
      999                       assign
     1000                           v-fmtcli-city       = trim( entry( 2, buf_firm.city ) )
     1001                       .
     1002                   end.
     1003                   run fmtcli-concatenate-strings in this-procedure (
     1004                         input v-fmtcli-full-addres
     1005                       , input v-fmtcli-country
     1006                       , input ", ":U
     1007                       , input 50
     1008                       , output v-fmtcli-full-addres
     1009                   ).
     1010                   run fmtcli-concatenate-strings in this-procedure (
     1011                         input v-fmtcli-full-addres
     1012                       , input v-fmtcli-city
     1013                       , input ", ":U
     1014                       , input 50
     1015                       , output v-fmtcli-full-addres
     1016                   ).
     1017                   run fmtcli-concatenate-strings in this-procedure (
     1018                         input v-fmtcli-full-addres
     1019                       , input IF buf_firm.ind = 0 THEN "" ELSE string( buf_firm.ind )
     1020                       , input ", ":U
     1021                       , input 50
     1022                       , output v-fmtcli-full-addres
     1023                   ).
     1024                   run fmtcli-concatenate-strings in this-procedure (
     1025                         input v-fmtcli-post-addres
     1026                       , input v-fmtcli-country
     1027                       , input ", ":U
     1028                       , input 50
     1029                       , output v-fmtcli-post-addres
     1030                   ).
     1031                   run fmtcli-concatenate-strings in this-procedure (
     1032                         input v-fmtcli-post-addres
     1033                       , input v-fmtcli-city
     1034                       , input ", ":U
     1035                       , input 50
     1036                       , output v-fmtcli-post-addres
     1037                   ).
     1038                   run fmtcli-concatenate-strings in this-procedure (
     1039                         input v-fmtcli-post-addres
     1040                       , input string( buf_firm.ind )
     1041                       , input ", ":U
     1042                       , input 50
     1043                       , output v-fmtcli-post-addres
     1044                   ).
     1045                   run fmtcli-concatenate-strings in this-procedure (
     1046                         input substring( buf_firm.addres1, 1, 50 )
     1047                       , input buf_firm.addres2
     1048                       , input " ":U
     1049                       , input 50
     1050                       , output v-temp-fmtcli-address
     1051                   ).
     1052                   run fmtcli-concatenate-strings in this-procedure (
     1053                         input v-temp-fmtcli-address
     1054                       , input substring( buf_firm.addres1, 51, 50 )
     1055                       , input " ":U
     1056                       , input 50
     1057                       , output v-temp-fmtcli-address
     1058                   ).
     1059                   run fmtcli-concatenate-strings in this-procedure (
     1060                         input v-temp-fmtcli-address
     1061                       , input substring( buf_firm.addres1, 101, 50 )
     1062                       , input " ":U
     1063                       , input 50
     1064                       , output v-temp-fmtcli-address
     1065                   ).
     1066                   assign
     1067                       v-fmtcli-addres = v-temp-fmtcli-address
     1068                   .
     1069                   if buf_firm.addres1 <> ?
     1070                   then do:
     1071                       run fmtcli-concatenate-strings in this-procedure (
     1072                             input v-fmtcli-full-addres
     1073                           , input v-fmtcli-addres
     1074                           , input ", ":U
     1075                           , input 0
     1076                           , output v-fmtcli-full-addres
     1077                       ).
     1078                   end.
     1079                   run fmtcli-concatenate-strings in this-procedure (
     1080                         input substring( buf_firm.post-addr1, 1, 50 )
     1081                       , input buf_firm.post-addr2
     1082                       , input " ":U
     1083                       , input 50
     1084                       , output v-fmtcli-post-addres
     1085                   ).
     1086                   run fmtcli-concatenate-strings in this-procedure (
     1087                         input v-fmtcli-post-addres
     1088                       , input substring( buf_firm.post-addr1, 51, 50 )
     1089                       , input " ":U
     1090                       , input 50
     1091                       , output v-fmtcli-post-addres
     1092                   ).
     1093                   run fmtcli-concatenate-strings in this-procedure (
     1094                         input v-fmtcli-post-addres
     1095                       , input substring( buf_firm.post-addr1, 101, 50 )
     1096                       , input " ":U
     1097                       , input 50
     1098                       , output v-fmtcli-post-addres
     1099                   ).
     1100                   assign
     1101                       v-fmtcli-phone         = buf_firm.phone
     1102                       v-fmtcli-inn           = buf_firm.inn
     1103                       v-fmtcli-kpp           = buf_firm.kpp
     1104                       v-fmtcli-okpo          = buf_firm.okpo
     1105                       v-fmtcli-index         = string( buf_firm.ind )
     1106                   .
     1107               end.
     1108          end.
     1109          when 'маг':U
     1110          then do:
     1111               find first buf_shop no-lock
     1112                    where buf_shop.obj-code = buf_clients.obj-code
     1113               .
     1114               if available buf_shop
     1115               then do:
     1116                   run fmtcli-concatenate-strings in this-procedure (
     1117                         input buf_shop.addres1
     1118                       , input buf_shop.addres2
     1119                       , input " ":U
     1120                       , input 50
     1121                       , output v-fmtcli-addres
     1122                   ).
     1123                   assign
     1124                       v-fmtcli-full-addres = v-fmtcli-addres
     1125                       v-fmtcli-post-addres = v-fmtcli-addres
     1126                       v-fmtcli-phone       = buf_shop.phone
     1127                       v-fmtcli-inn         = "":U
     1128                       v-fmtcli-kpp         = "":U
     1129                       v-fmtcli-okpo        = "":U
     1130                       v-fmtcli-city        = "":U
     1131                       v-fmtcli-index       = "":U
     1132                   .
     1133               end.
     1134          end.
     1135          when 'скл':U
     1136          then do:
     1137               find first buf_store no-lock
     1138                    where buf_store.obj-code = buf_clients.obj-code
     1139               .
     1140               if available buf_store
     1141               then do:
     1142                   run fmtcli-concatenate-strings in this-procedure (
     1143                         input buf_store.addres1
     1144                       , input buf_store.addres2
     1145                       , input " ":U
     1146                       , input 50
     1147                       , output v-fmtcli-addres
     1148                   ).
     1149                   assign
     1150                       v-fmtcli-full-addres = v-fmtcli-addres
     1151                       v-fmtcli-phone       = buf_store.phone
     1152                       v-fmtcli-inn         = "":U
     1153                       v-fmtcli-kpp         = "":U
     1154                       v-fmtcli-okpo        = "":U
     1155                       v-fmtcli-city        = "":U
     1156                       v-fmtcli-index       = "":U
     1157                   .
     1158               end.
     1159          end.
     1160          when 'чел':U
     1161          then do:
     1162               find first buf_person no-lock
     1163                    where buf_person.psn-code = buf_clients.obj-code
     1164               .
     1165               if available buf_person
     1166               then do:
     1167                   run fmtcli-concatenate-strings in this-procedure (
     1168                         input ( if buf_person.ind = 0 or buf_person.ind = ?
     1169                                 then "":U
     1170                                 else string( buf_person.ind, "999999")
     1171                                 )
     1172                       , input buf_person.city
     1173                       , input ", ":U
     1174                       , input 0
     1175                       , output v-fmtcli-full-addres
     1176                   ).
     1177                   assign
     1178                       v-fmtcli-addres = buf_person.address
     1179                   .
     1180                   run fmtcli-concatenate-strings in this-procedure (
     1181                         input v-fmtcli-full-addres
     1182                       , input v-fmtcli-addres
     1183                       , input ", ":U
     1184                       , input 0
     1185                       , output v-fmtcli-full-addres
     1186                   ).
     1187                   assign
     1188                       v-fmtcli-phone     = buf_person.phone1
     1189                       v-fmtcli-inn       = buf_person.inn
     1190                       v-fmtcli-kpp       = buf_person.kpp
     1191                       v-fmtcli-okpo      = buf_person.okpo
     1192                       v-fmtcli-city      = buf_person.city
     1193                       v-fmtcli-index     = string( buf_person.ind )
     1194                   .
     1195               end.
     1196          end.
     1197       end case.
     1198   end.
     1199   end procedure.
     1200   procedure fmtcli-concatenate-strings :
     1201   define input parameter p-string-1       as character        no-undo.
     1202   define input parameter p-string-2       as character        no-undo.
     1203   define input parameter p-delimiter      as character        no-undo.
     1204   define input parameter p-length         as integer          no-undo.
     1205   define output parameter p-out-string    as character        no-undo.
     1206   do
     1207   on error undo, return error
     1208   :
     1209       assign
     1210           p-out-string = ( if p-string-1 = ?
     1211                            then "":U
     1212                            else trim( p-string-1 ) )
     1213       .
     1214       assign
     1215           p-out-string = p-out-string
     1216                        + ( if p-out-string = "":U
     1217                            or length( p-out-string ) = p-length
     1218                            or p-string-2 = ?
     1219                            or trim( p-string-2 ) = "":U
     1220                            then "":U
     1221                            else p-delimiter )
     1222                        + ( if p-string-2 = ?
     1223                            or trim( p-string-2 ) = "":U
     1224                            then "":U
     1225                            else trim( p-string-2 ) )
     1226       .
     1227   end.
     1228   end procedure.
     1229   my-handle = p-mainmenu-handle .
