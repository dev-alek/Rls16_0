     1451   define variable v-kol-nakl-cli as integer   no-undo .
     1452   define variable v-ves-cli      as decimal   no-undo .
     1453   v-nn           = 0 .
     1454   v-kol-nakl-cli = 0 .
     1455   v-ves-cli      = 0 .
     1456   v-kol-cli = 0.
     1457           for each  temp-list break by temp-list.cli-type by temp-list.cli-code:
     1458             if first-of(temp-list.cli-code) then do:
     1459               v-kol-nakl-cli = 0 .
     1460               v-ves-cli      = 0 .
     1461               v-kol-cli = v-kol-cli  + 1.
     1462             end.
     1463             v-nn = v-nn + 1.
     1464             v-kol-nakl-cli = v-kol-nakl-cli +  1 .
     1465             v-ves-cli      = v-ves-cli      + temp-list.ves .
     1466             if Make-Excel then  put   stream ForExcel unformatted
     1467               v-nn                 CHR(9)
     1468                                    CHR(9)
     1469               temp-list.doc-code   CHR(9)
     1470               temp-list.cli-name + ", " temp-list.cli-address  CHR(9)
     1471               temp-list.ves CHR(9)
     1472               chr(10)
     1473               .
     1474             if last-of(temp-list.cli-code) then do:
     1475                 if Make-Excel then  put   stream ForExcel unformatted
     1476                    CHR(9)
     1477                    v-kol-nakl-cli CHR(9) CHR(9)  CHR(9)
     1478                    v-ves-cli
     1479                    chr(10)
     1480                    .
     1481              end.
     1482           end.
     1483   if Make-Excel then  put   stream ForExcel unformatted
     1484       "Итого накладных"  CHR(9) CHR(9)
     1485        v-nn CHR(9)
     1486        "Общий вес/кол-во" CHR(9)
     1487        v-all-ves
     1488       chr(10)
     1489       "Итого клиентов"    CHR(9) CHR(9)
     1490        v-kol-cli
     1491    chr(10).
     1492   if session:set-wait-state("") then.
     1493    if Make-Excel then output stream ForExcel close.
     1494    run rep/runexcel.p (string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txt").
     1495   os-delete value( string( session:temp-directory ) +
     1496                              "rpt" + string( g#report-num ) + ".txt":u ) .
