     3681                                 assign temp-grp-obj.prielse   = temp-grp-obj.prielse   + ABS(buf_ot-line.sum-rubl - buf_ot-line.VAT-rubl) .
     3682                  end .
     3683                             else do :
     3684                                 assign temp-grp-obj.raselse   = temp-grp-obj.raselse   + ABS(buf_ot-line.sum-rubl - buf_ot-line.VAT-rubl) .
     3685                             end .
     3686                          end.
     3687               when 'es':U
     3688                                                       then assign temp-grp-obj.rasprod    = temp-grp-obj.rasprod   + ABS(buf_ot-line.sum-rubl - buf_ot-line.VAT-rubl) .
     3689     when 'rs':U then assign temp-grp-obj.rasprod = temp-grp-obj.rasprod  - ABS(buf_ot-line.sum-rubl - buf_ot-line.VAT-rubl) .
     3690       when 'ep':U   then assign temp-grp-obj.rasvozv    = temp-grp-obj.rasvozv   + ABS(buf_ot-line.sum-rubl - buf_ot-line.VAT-rubl) .
