     3297   procedure xl-run-excel :
     3298   define input parameter p-header-filename    as character        no-undo.
     3299   define input parameter p-data-filename      as character        no-undo.
     3300       define variable v-template-file-name    as character    no-undo.
     3301       define variable v-vb-file-name          as character    no-undo.
     3302       define buffer buf_temp-param for temp-param .
     3303   do
     3304   for buf_temp-param
     3305   on error undo, return error
     3306   :
     3307       create buf_temp-param.
     3308       assign
     3309           v-template-file-name    = search( "exe/tg89.xlt" )
     3310           v-vb-file-name          = search( "exe/t_97.bas")
     3311       .
     3312       if v-template-file-name = ?
     3313       or v-template-file-name = "":U
     3314       then do :
     3315           message
     3316               "Ошибка имени файла шаблона."
     3317           view-as alert-box error.
     3318       end.
     3319       if v-vb-file-name = ?
     3320       or v-vb-file-name = "":U
     3321       then do :
     3322           message
     3323               "Ошибка имени файла кода обработки."
     3324           view-as alert-box error.
     3325       end.
     3326       run paramls-write in this-procedure (
     3327             input "template":U
     3328           , input "template-file-name":U
     3329           , input v-template-file-name
     3330       ).
     3331       run paramls-write in this-procedure (
     3332             input "template":U
     3333           , input "vb-file-name":U
     3334           , input v-vb-file-name
     3335       ).
     3336       run paramls-write in this-procedure (
     3337             input "data":U
     3338           , input "data-header-filename":U
     3339           , input p-header-filename
     3340       ).
     3341       run paramls-write in this-procedure (
     3342             input "data":U
     3343           , input "data-filename":U
     3344           , input p-data-filename
     3345       ).
     3346       run gbl/macroxlt.p (
     3347           input-output table buf_temp-param
     3348       ) no-error.
     3349       if error-status :error
     3350       then do :
     3351           message
     3352                    vss-workfile vss-revision vss-description
     3353               skip(1)
     3354               skip "Ошибка создания файла Excel."
     3355               skip return-value
     3356               skip trim(error-status :get-message(1))
     3357                    trim(error-status :get-message(2))
     3358                    trim(error-status :get-message(3))
     3359           view-as alert-box error.
     3360           undo, return error .
     3361       end.
     3362   end.
     3363   end procedure.
