      602   function excel-format-dec-to-char returns char (input p-dec as decimal ).
      603     if num-entries(string(p-dec), '.') = 2
      604       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
      605       else return( string(p-dec)) .
      606   end function.
      607   function format-point-to-comma returns char (input orig as char ) .
      608   define variable rtext as character no-undo .
      609   define variable strt as integer no-undo .
      610   define variable leng as integer no-undo .
      611   assign rtext = orig .
      612   repeat:
      613     strt =  index(rtext,'.').
      614     if strt = 0 then leave.
      615     leng = 1.
      616     substring(rtext,strt,leng,"character") = v-delim .
      617   end.
      618   return rtext.
      619   end function.
      620   function format-excel-text returns char ( input start-text as char ) :
      621   def var  i    as int no-undo.
      622   def var  ch   as char no-undo.
      623   def var  n    as int no-undo.
      624   def var  ipos as int no-undo.
      625     n = num-entries(trim(start-text), chr(10)) - 1 .
      626     do i = 1 to n :
      627       ipos = index( start-text, chr(10)).
      628       if ipos > 0 then
      629         substr( start-text, ipos, 1 ) = ' '.
      630     end.
      631     n = num-entries(trim(start-text), chr(13)) - 1 .
      632     do i = 1 to n :
      633       ipos = index( start-text, chr(13)).
      634       if ipos > 0 then
      635         substr( start-text, ipos, 1 ) = ' '.
      636     end.
      637     if index( start-text, '"' ) = 0 then
      638       start-text =  '="'   + trim( start-text) + '"'   .
      639       else do:
      640         n = num-entries(trim(start-text), '"') - 1.
      641         do i = 1 to n :
      642           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      643         end.
      644         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      645         start-text = '="'  + ch  + '"' .
      646       end.
      647     return start-text.
      648   end.
      649   function excel-sum returns char (input p-dec as decimal ).
      650     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
      651   end function.
      652   function excel-qnty returns char (input p-dec as decimal ).
      653     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
      654   end function.
      655   function format-excel-text-macr returns char ( input start-text as char ) :
      656   def var  i    as int no-undo.
      657   def var  ch   as char no-undo.
      658   def var  n    as int no-undo.
      659   def var  ipos as int no-undo.
      660     n = num-entries(trim(start-text), chr(10)) - 1 .
      661     do i = 1 to n :
      662       ipos = index( start-text, chr(10)).
      663       if ipos > 0 then
      664         substring( start-text, ipos , 1 ) = ' '.
      665     end.
      666     n = num-entries(trim(start-text), chr(13)) - 1 .
      667     do i = 1 to n :
      668       ipos = index( start-text, chr(13)).
      669       if ipos > 0 then
      670         substring( start-text, ipos, 1 ) = ' '.
      671     end.
      672     if index( start-text, '"' ) = 0 then
      673       start-text =  '"'   + trim( start-text) + '"'   .
      674       else do:
      675         n = num-entries(trim(start-text), '"') - 1.
      676         do i = 1 to n :
      677           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      678         end.
      679         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      680         start-text = '"'  + ch  + '"' .
      681       end.
      682     n = num-entries(trim(start-text), chr(10)) - 1 .
      683     do i = 1 to n :
      684       ipos = index( start-text, chr(10)).
      685       if ipos > 0 then
      686         substring( start-text, ipos , 1 ) = ' '.
      687     end.
      688       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
      689     return start-text.
      690   end.
      691   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      692   procedure cur-time :
      693      define output parameter p-today as date      no-undo .
      694      define output parameter p-time  as integer   no-undo .
      695     do
      696     on error undo, return error
      697     :
      698       define variable v-date1 as date      no-undo .
      699       define variable v-date2 as date      no-undo .
      700       define variable v-time  as integer   no-undo .
      701       assign
      702         v-date1 = today
      703         v-time  = time
      704         v-date2 = today
      705       .
      706       if v-date1 <> v-date2
      707       then do:
      708         assign
      709           v-date1 = today
      710           v-time  = v-time
      711         .
      712       end.
      713       assign
      714         p-today = v-date1
      715         p-time  = v-time
      716       .
      717     end.
      718   end.
      719   function cur-time-date returns character
      720   :
      721     return string(today, '99/99/9999':U) .
      722   end.
      723   function cur-time-mjd returns decimal
      724   :
      725     define variable v-date as date      no-undo .
      726     define variable v-time as integer   no-undo .
      727     run cur-time in this-procedure
      728       (output v-date
      729       ,output v-time
      730       ) .
      731     return integer(v-date) - 2400002 + (v-time / 86400) .
      732   end.
      733   function cur-time-get-ending-index returns integer
      734   (input p-number as integer
      735   )
      736   :
      737     if p-number < 0
      738     or p-number = ?
      739     then do:
      740       return 1 .
      741     end.
      742     define variable v-rest as integer   no-undo .
      743     assign
      744       p-number = p-number modulo 100
      745     .
      746     if p-number < 20
      747     then do:
      748       assign
      749         v-rest = p-number
      750       .
      751     end.
      752     else do:
      753       assign
      754         v-rest = p-number modulo 10
      755       .
      756     end.
      757     case v-rest :
      758       when 1
      759       then do:
      760         return 2 .
      761       end.
      762       when 2 or
      763       when 3 or
      764       when 4
      765       then do:
      766         return 3 .
      767       end.
      768       otherwise do:
      769         return 1 .
      770       end.
      771     end case .
      772   end.
      773   procedure cur-time-mjd-to-date :
      774      define input  parameter i-mjd-diff as decimal no-undo.
      775      define output parameter o-Date     as date    no-undo.
      776      define output parameter o-Time     as integer no-undo.
      777      define variable v-day-number as integer   no-undo .
      778      if    i-mjd-diff < 0
      779         or i-mjd-diff = ?
      780      then do:
      781         return "?" .
      782      end.
      783      assign
      784         v-day-number = truncate(i-mjd-diff,0).
      785         o-Date = date(v-day-number + 2400002).
      786         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      787     .
      788   end.
      789   function cur-time-mjd-to-string returns character
      790   (input p-mjd-diff as decimal
      791   )
      792   :
      793     define variable v-day-number as integer   no-undo .
      794     define variable v-seconds    as integer   no-undo .
      795     define variable v-hour       as integer   no-undo .
      796     define variable v-min        as integer   no-undo .
      797     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      798     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      799     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      800     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      801     if p-mjd-diff < 0
      802     or p-mjd-diff = ?
      803     then do:
      804       return "?" .
      805     end.
      806     assign
      807       v-day-number = integer(truncate(p-mjd-diff,0))
      808       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      809     .
      810     if v-seconds > 86400
      811     then do:
      812       assign
      813         v-seconds = 86400 - 1
      814       .
      815     end.
      816     if v-seconds < 0
      817     then do:
      818       assign
      819         v-seconds = 0
      820       .
      821     end.
      822     assign
      823       v-hour = truncate(v-seconds / 3600, 0)
      824     .
      825     assign
      826       v-seconds = v-seconds modulo 3600
      827     .
      828     assign
      829       v-min = truncate(v-seconds / 60, 0)
      830     .
      831     assign
      832       v-seconds = v-seconds modulo 60
      833     .
      834     return
      835         (if v-day-number <> 0
      836           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      837           else ""
      838         )
      839       + (if v-day-number <> 0 or v-hour <> 0
      840           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      841           else ""
      842         )
      843       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      844           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      845           else ""
      846         )
      847       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      848       .
      849   end.
      850   function cur-time-string returns character
      851   :
      852     define variable v-date as date      no-undo .
      853     define variable v-time as integer   no-undo .
      854     run cur-time in this-procedure
      855       (output v-date
      856       ,output v-time
      857       ) .
      858     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      859   end.
      860   function cur-time-string-sec returns character
      861   :
      862     define variable v-date as date      no-undo .
      863     define variable v-time as integer   no-undo .
      864     run cur-time in this-procedure
      865       (output v-date
      866       ,output v-time
      867       ) .
      868     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      869   end.
      870   function cur-time-custom  returns character
      871   (input p-prefix as character
      872   ,input p-date-format as character
      873   ,input p-delimiter as character
      874   ,input p-time-format as character
      875   ,input p-suffix as character
      876   )
      877   :
      878     define variable v-date as date      no-undo .
      879     define variable v-time as integer   no-undo .
      880     run cur-time in this-procedure
      881       (output v-date
      882       ,output v-time
      883       ) .
      884     return
      885       p-prefix
      886       + string(v-date, p-date-format)
      887       + p-delimiter
      888       + string(v-time, p-time-format)
      889       + p-suffix
      890       .
      891   end.
      892   function cur-time-print  returns character
      893   :
      894     define variable v-date as date      no-undo .
      895     define variable v-time as integer   no-undo .
      896     run cur-time in this-procedure
      897       (output v-date
      898       ,output v-time
      899       ) .
      900     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      901   end.
      902   function cur-time-datetime returns datetime
      903   :
      904     define variable v-char as character no-undo .
      905     define variable v-datetime as datetime no-undo .
      906     v-char = cur-time-string().
      907     v-datetime = datetime(v-char).
      908     return  v-datetime.
      909   end.
      910   function cur-time-string-msec returns character
      911   :
      912     define variable v-date as datetime  no-undo .
      913     v-date = now.
      914     return string(v-date) .
      915   end.
      916   def var vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      917   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
      918   procedure paramls-clear :
      919     define buffer buf_temp-param for temp-param .
      920     do
      921     on error undo, return error return-value
      922     :
      923       for each buf_temp-param
      924       on error undo, return error
      925       :
      926         delete buf_temp-param .
      927       end.
      928     end.
      929   end procedure.
      930   procedure paramls-write :
      931     define input  parameter p-code     as character no-undo .
      932     define input  parameter p-sub-code as character no-undo .
      933     define input  parameter p-value    as character no-undo .
      934     define buffer buf_temp-param for temp-param .
      935     do
      936     on error undo, return error return-value
      937     :
      938       find first buf_temp-param
      939         where buf_temp-param.param-code     = p-code
      940           and buf_temp-param.param-sub-code = p-sub-code
      941         no-error .
      942       if not available buf_temp-param then do:
      943         create buf_temp-param .
      944         assign
      945           buf_temp-param.param-code     = p-code
      946           buf_temp-param.param-sub-code = p-sub-code
      947         .
      948       end.
      949       assign
      950         buf_temp-param.param-value = p-value
      951       .
      952     end.
      953   end procedure.
      954   procedure paramls-read :
      955     define input  parameter p-code          as character no-undo .
      956     define input  parameter p-sub-code      as character no-undo .
      957     define input  parameter p-default-value as character no-undo .
      958     define output parameter p-value         as character no-undo .
      959     define buffer buf_temp-param for temp-param .
      960     do
      961     on error undo, return error return-value
      962     :
      963       find first buf_temp-param
      964         where buf_temp-param.param-code     = p-code
      965           and buf_temp-param.param-sub-code = p-sub-code
      966         no-error .
      967       if available buf_temp-param then do:
      968         assign
      969           p-value = buf_temp-param.param-value
      970         .
      971       end.
      972       else do:
      973         assign
      974           p-value = p-default-value
      975         .
      976       end.
      977     end.
      978   end procedure.
      979   procedure paramls-append :
      980     define input  parameter p-code     as character no-undo .
      981     define input  parameter p-sub-code as character no-undo .
      982     define input  parameter p-value    as character no-undo .
      983     define buffer buf_temp-param for temp-param .
      984     do
      985     on error undo, return error return-value
      986     :
      987       find first buf_temp-param
      988            where buf_temp-param.param-code     = p-code
      989              and buf_temp-param.param-sub-code = p-sub-code
      990         no-error .
      991       if not available buf_temp-param then do:
      992         create buf_temp-param .
      993         assign
      994           buf_temp-param.param-code     = p-code
      995           buf_temp-param.param-sub-code = p-sub-code
      996           buf_temp-param.param-value    = p-value
      997         .
      998       end.
      999       else do:
     1000           assign
     1001               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     1002           .
     1003       end.
     1004     end.
     1005   end procedure.
     1006   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1007   define  stream PrnLibStream.
     1008   procedure prn-lib-prn-file :
     1009     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1010     define input parameter p-DIsabledoptions as integer no-undo .
     1011     define variable v-report-name as character no-undo .
     1012     define variable v-user-action as character no-undo .
     1013     define variable v-printed     as logical   no-undo .
     1014     define variable v-exist       as logical   no-undo .
     1015     do
     1016       on error undo, return error
     1017       :
     1018       run prn-lib-get-report-name  in this-procedure (
     1019         input parParentProc
     1020         ,output v-report-name
     1021         ).
     1022   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1023   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     1024     (input  v-report-name
     1025     ,input  2
     1026     ,output v-exist
     1027     )  .
     1028       if NOT v-exist then
     1029       DO:
     1030         Message
     1031           "Нет заданий на печать ! "
     1032           view-as alert-box .
     1033         Return  .
     1034       End.
     1035       run gbl/prnfilen.w
     1036         (input  ""
     1037         ,input  p-DisabledOptions
     1038         ,input  string(v-report-name )
     1039         ,input  7
     1040         ,output v-user-action
     1041         ,output v-printed
     1042         ) .
     1043       if v-printed then
     1044       do:
     1045         return "YES" .
     1046       end.
     1047       else
     1048       do:
     1049         return "NO" .
     1050       end.
     1051     end.
     1052   end procedure.
     1053   procedure prn-lib-open-stream :
     1054     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1055     define input parameter p-page-size    as integer no-undo .
     1056     define input parameter p-is-stream    as logical no-undo .
     1057     define input parameter p-append       as logical no-undo .
     1058     define variable v-report-name as character no-undo .
     1059     do
     1060       on error undo, return error
     1061       :
     1062       run prn-lib-get-report-name  in this-procedure (
     1063         input parParentProc
     1064         ,output v-report-name
     1065         ).
     1066       if p-is-stream then
     1067       do:
     1068         if p-append then
     1069         do:
     1070           output stream PrnLibStream to value( v-report-name )
     1071             page-size value(p-page-size) append .
     1072         end.
     1073         if not p-append then
     1074         do:
     1075           output stream PrnLibStream to value( v-report-name )
     1076             page-size value(p-page-size) .
     1077         end.
     1078       end.
     1079       if not p-is-stream then
     1080       do:
     1081         if p-append then
     1082         do:
     1083           output to value( v-report-name )
     1084             page-size value(p-page-size) append .
     1085         end.
     1086         if not p-append then
     1087         do:
     1088           output to value( v-report-name )
     1089             page-size value(p-page-size) .
     1090         end.
     1091       end.
     1092     end.
     1093   end procedure.
     1094   procedure prn-lib-open-exp :
     1095     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1096     define input parameter p-is-stream    as logical no-undo .
     1097     define input parameter p-is-append    as logical no-undo .
     1098     define output parameter p-ReportFileName as char init "report" no-undo.
     1099     define output parameter p-process as logical no-undo .
     1100     define variable glog as logical no-undo .
     1101     do
     1102       on error undo, return error
     1103       :
     1104       SYSTEM-DIALOG GET-FILE p-ReportFileName
     1105         TITLE      "Укажите путь"
     1106         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     1107         ASK-OVERWRITE
     1108         CREATE-TEST-FILE
     1109         SAVE-AS
     1110         USE-FILENAME
     1111         DEFAULT-EXTENSION "txt"
     1112         UPDATE glog
     1113         .
     1114       if not glog then  return.
     1115       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     1116       if p-is-stream then
     1117       do:
     1118         if p-is-append then
     1119         do:
     1120           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1121         end.
     1122         else
     1123         do:
     1124           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1125         end.
     1126       end.
     1127       else
     1128       do:
     1129         if p-is-append then
     1130         do:
     1131           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1132         end.
     1133         else
     1134         do:
     1135           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1136         end.
     1137       end.
     1138       p-process = yes.
     1139     end.
     1140   end procedure.
     1141   procedure prn-lib-get-report-name :
     1142     define input parameter parParentProc  as widget-handle no-undo.
     1143     define output parameter p-report-name as character no-undo .
     1144     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     1145   end procedure.
     1146   procedure prn-lib-reportviewer-report-name :
     1147     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1148     define input parameter p-report-name-html as character no-undo .
     1149     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
     1150   end procedure.
     1151   procedure prn-lib-reportviewer :
     1152     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1153     define input parameter p-report-name-html as character no-undo .
     1154     define input parameter p-param        as character no-undo .
     1155     define variable v-excel           as character no-undo init 'TRUE' .
     1156     define variable v-value-character as character no-undo .
     1157     define variable v-value-integer   as character no-undo .
     1158     define variable v-value-date      as date      no-undo .
     1159     define variable v-value-decimal   as decimal   no-undo .
     1160     define variable rep-excel         as logical   no-undo .
     1161     define variable excel-string      as character no-undo .
     1162     define variable v-param-type      as character no-undo .
     1163     define variable v-tth             as handle    no-undo .
     1164     run adm/shattri.p (
     1165       input "get":U
     1166       ,input  ""
     1167       ,input  0
     1168       ,input  'report-glob':U
     1169       ,input  'rep-excel':U
     1170       ,output v-value-character
     1171       ,output v-value-date
     1172       ,output v-value-decimal
     1173       ,output v-value-integer
     1174       ,output rep-excel
     1175       ,output v-param-type
     1176       ,INPUT-OUTPUT table-handle v-tth
     1177       )  .
     1178     if rep-excel then v-excel = "TRUE" .
     1179     else v-excel = "FALSE" .
     1180     if p-param eq ""
     1181     then
     1182        p-param = "EXCEL:" + v-excel.
     1183     else
     1184        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1185     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1186   end procedure.
     1187   define variable vss-include-info12 as character format "X(65)" no-undo
     1188   initial "@(#)$Workfile$ $Revision$".
     1189   define temp-table temp_grplib_grp no-undo
     1190       field sel           as character
     1191       field nabor         as character
     1192       field full-name     as character
     1193       field print-code    as character
     1194       field sort-name     as character
     1195       field node-code     as integer
     1196       field upper-code    as integer
     1197       field calc-method   as character
     1198       field round-method  as character
     1199       field increase-pc   as decimal
     1200       field min-marg      as character
     1201       field max-marg      as character
     1202       field cli-type      as character
     1203       field cli-code      as integer
     1204       field notcorr      as character
     1205       field name          as character
     1206       field level         as integer
     1207       field mark          as character
     1208       index pi is primary unique sort-name
     1209       index fn full-name
     1210       index nc is unique node-code
     1211       index sl sel
     1212       index uc upper-code
     1213   .
     1214   define temp-table temp_grplib_found-grp no-undo
     1215       field full-name   as character
     1216       field sort-name   as character
     1217       field node-code   as integer
     1218       field level       as integer
     1219       field is-terminal as logical
     1220       index pi is primary unique sort-name
     1221       index fn full-name
     1222       index lv level
     1223       index it is-terminal
     1224   .
     1225   define temp-table temp_found-result-nodelist no-undo
     1226       field node-code     as recid
     1227       field processed     as logical
     1228       field sort-name     as character
     1229       field full-name     as character
     1230       index pi is primary unique node-code
     1231       index ps processed
     1232   .
     1233   define variable v-grplib-not-fill-extra-info        as logical      no-undo.
     1234   define variable v-grplib-no-warning-grp-amount      as logical      no-undo.
     1235   define variable v-grplib-grp-amount-for-load        as integer      no-undo.
     1236   procedure grplib-get-parameters :
     1237   define input parameter p-store-type     as character        no-undo.
     1238   define input parameter p-store-code     as integer          no-undo.
     1239   do
     1240   on error undo, return error
     1241   :
     1242       assign
     1243           v-grplib-not-fill-extra-info = no
     1244       .
     1245   end.
     1246   end procedure.
     1247   procedure grplib-get-sort-name :
     1248   do
     1249   on error undo, return error
     1250   :
     1251   define input parameter p-node-code  as integer      no-undo.
     1252   define output parameter p-sort-name as character    no-undo.
     1253       define variable v-upper-code    as integer           no-undo.
     1254       define buffer buf_gds-grp       for ub.gds-grp.
     1255       define buffer buf_upper_gds-grp for ub.gds-grp.
     1256       find first buf_gds-grp no-lock
     1257            where buf_gds-grp.node-code = p-node-code
     1258       no-error.
     1259       if not available buf_gds-grp
     1260       then do:
     1261           undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     1262       end.
     1263       assign
     1264           p-sort-name  = ""
     1265           v-upper-code = 1
     1266       .
     1267       do while buf_gds-grp.upper-code <> 0
     1268       on error undo, return error "grplib-get-sort-name: Ошибка составления полного имени группы"
     1269       :
     1270           assign
     1271               p-sort-name  = buf_gds-grp.node-name
     1272                            + (if p-sort-name <> "" then chr(2) else "")
     1273                            + p-sort-name
     1274               v-upper-code = buf_gds-grp.upper-code
     1275           .
     1276           find first buf_gds-grp no-lock
     1277                where buf_gds-grp.node-code = v-upper-code
     1278           no-error.
     1279           if not available buf_gds-grp
     1280           then do:
     1281               undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом "
     1282                                   + string( v-upper-code )
     1283                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     1284           end.
     1285       end.
     1286   end.
     1287   end procedure.
     1288   define variable vss-include-info13 as character format "X(65)" no-undo
     1289   initial "@(#)$Workfile$ $Revision$".
     1290   procedure grplib-get-full-name :
     1291      define input parameter p-node-code  as integer      no-undo.
     1292      define output parameter p-full-name as character    no-undo.
     1293      do
     1294   on error undo, return error
     1295   :
     1296       define variable v-upper-code    as integer           no-undo.
     1297       define buffer buf_gds-grp       for ub.gds-grp.
     1298       define buffer buf_upper_gds-grp for ub.gds-grp.
     1299       find first buf_gds-grp no-lock
     1300            where buf_gds-grp.node-code = p-node-code
     1301       no-error.
     1302       if not available buf_gds-grp
     1303       then do:
     1304           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     1305       end.
     1306       assign
     1307           p-full-name  = ""
     1308           v-upper-code = 1
     1309       .
     1310       do while buf_gds-grp.upper-code <> 0
     1311       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     1312       :
     1313           assign
     1314               p-full-name  = buf_gds-grp.node-name
     1315                            + (if p-full-name <> "" then chr(47) else "")
     1316                            + p-full-name
     1317               v-upper-code = buf_gds-grp.upper-code
     1318           .
     1319           find first buf_gds-grp no-lock
     1320                where buf_gds-grp.node-code = v-upper-code
     1321           no-error.
     1322           if not available buf_gds-grp
     1323           then do:
     1324               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
     1325                                   + string( v-upper-code )
     1326                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     1327           end.
     1328       end.
     1329       assign
     1330       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     1331       .
     1332   end.
     1333   end .
     1334   procedure grplib-get-node-from-full-name :
     1335   define input parameter p-full-name as character no-undo .
     1336   define output parameter p-node-code as integer no-undo .
     1337   define variable v-ii as integer no-undo .
     1338   define variable v-upper-code as integer no-undo .
     1339   define variable v-root-code as integer no-undo .
     1340   define variable v-entry as character no-undo .
     1341   define buffer buf_gds-grp       for ub.gds-grp.
     1342   do
     1343   on error undo, return error
     1344   :
     1345     find first buf_gds-grp no-lock
     1346         where buf_gds-grp.upper-code = 0
     1347     no-error .
     1348     if not available buf_gds-grp
     1349     then do:
     1350         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
     1351     end.
     1352     else do:
     1353       assign
     1354       v-root-code = buf_gds-grp.node-code
     1355       .
     1356     end.
     1357     v-upper-code = v-root-code.
     1358     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     1359       assign
     1360       v-entry = entry(v-ii, p-full-name, chr(47)).
     1361       if v-entry = '' then leave.
     1362       find first buf_gds-grp no-lock where
     1363                 buf_gds-grp.node-name = v-entry
     1364             and buf_gds-grp.upper-code = v-upper-code
     1365             no-error.
     1366       if not available buf_gds-grp then do:
     1367         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     1368       end.
     1369       else do:
     1370         p-node-code = buf_gds-grp.node-code.
     1371         v-upper-code = buf_gds-grp.node-code.
     1372       end.
     1373     end.
     1374   end.
     1375   end .
     1376   procedure grplib-get-root-code :
     1377   do
     1378   on error undo, return error
     1379   :
     1380   define output parameter p-root-code as integer      no-undo.
     1381       define buffer buf_gds-grp       for ub.gds-grp.
     1382       find first buf_gds-grp no-lock
     1383           where buf_gds-grp.upper-code = 0
     1384       no-error .
     1385       if not available buf_gds-grp
     1386       then do:
     1387           undo, return error .
     1388       end.
     1389       else do:
     1390           assign
     1391               p-root-code = buf_gds-grp.node-code
     1392           .
     1393       end.
     1394   end.
     1395   end procedure.
     1396   procedure grplib-find-grp-by-full-name :
     1397   do
     1398   on error undo, return error
     1399   :
     1400   define input parameter p-search-name  as character    no-undo.
     1401   define input parameter p-fill-path    as logical      no-undo.
     1402   define output parameter p-found       as logical      no-undo.
     1403       define variable v-upper-code    as integer          no-undo.
     1404       define variable v-counter       as integer           no-undo.
     1405       define variable v-level         as integer           no-undo.
     1406       define variable v-full-name     as character         no-undo.
     1407       define variable v-sort-name     as character         no-undo.
     1408       define buffer buf_gds-grp       for ub.gds-grp.
     1409       assign
     1410           p-search-name = replace( p-search-name, chr(47), chr(2) )
     1411       .
     1412       run grplib-get-root-code ( output v-upper-code ) no-error .
     1413       if error-status :error
     1414       then do:
     1415           undo, return error "grplib-expand-name: Ошибка при поиске корневого узла".
     1416       end.
     1417       assign
     1418           v-full-name  = ""
     1419           v-level      = num-entries( p-search-name, chr(2) )
     1420       .
     1421       for each temp_grplib_found-grp
     1422       :
     1423           delete temp_grplib_found-grp.
     1424       end.
     1425       start-name-analyze:
     1426       do v-counter = 1 to v-level
     1427       :
     1428           if v-counter < v-level
     1429           then do:
     1430               find first buf_gds-grp no-lock
     1431                    where buf_gds-grp.upper-code = v-upper-code
     1432                      and buf_gds-grp.node-name  = entry( v-counter, p-search-name, chr(2) )
     1433               no-error .
     1434               if not available buf_gds-grp
     1435               then do:
     1436                   assign
     1437                       v-full-name  = p-search-name
     1438                       v-sort-name  = p-search-name
     1439                   .
     1440                   return error "grplib-expand-name: не найдена группа " + entry( v-level, p-search-name, chr(2) ).
     1441               end.
     1442               else do:
     1443                   assign
     1444                       v-full-name = v-full-name + ( if v-full-name = "" then "" else chr(47) )        + buf_gds-grp.node-name
     1445                       v-sort-name = v-sort-name + ( if v-sort-name = "" then "" else chr(2) ) + buf_gds-grp.node-name
     1446                       v-upper-code = buf_gds-grp.node-code
     1447                   .
     1448                   if p-fill-path = yes
     1449                   then do:
     1450                       create temp_grplib_found-grp.
     1451                       assign
     1452                           temp_grplib_found-grp.full-name = v-full-name + chr(47)
     1453                           temp_grplib_found-grp.sort-name = v-sort-name
     1454                           temp_grplib_found-grp.node-code = v-upper-code
     1455                           temp_grplib_found-grp.level     = v-counter
     1456                       .
     1457                   end.
     1458               end.
     1459           end.
     1460           else do:
     1461               for each buf_gds-grp no-lock
     1462                  where buf_gds-grp.upper-code = v-upper-code
     1463                    and buf_gds-grp.node-name begins entry( v-counter, p-search-name, chr(2) )
     1464               :
     1465                   assign
     1466                       p-found = yes
     1467                   .
     1468                   create temp_grplib_found-grp.
     1469                   assign
     1470                       temp_grplib_found-grp.full-name = v-full-name
     1471                                                           + (if v-full-name = "" then "" else chr(47) )
     1472                                                           + buf_gds-grp.node-name + chr(47)
     1473                       temp_grplib_found-grp.sort-name = v-sort-name
     1474                                                           + ( if v-sort-name = "" then "" else chr(2) )
     1475                                                           + buf_gds-grp.node-name
     1476                       temp_grplib_found-grp.node-code = buf_gds-grp.node-code
     1477                       temp_grplib_found-grp.level     = v-level
     1478                   .
     1479               end.
     1480               if p-found = no
     1481               then do:
     1482                   assign
     1483                       v-full-name  = p-search-name
     1484                       v-sort-name  = p-search-name
     1485                   .
     1486                   for each temp_grplib_found-grp
     1487                   :
     1488                       delete temp_grplib_found-grp.
     1489                   end.
     1490                   assign
     1491                       p-found = no
     1492                   .
     1493               end.
     1494           end.
     1495       end.
     1496   end.
     1497   end procedure.
     1498   procedure grplib-find-all-subgroup :
     1499   do
     1500   on error undo, return error
     1501   :
     1502   define input parameter p-start-node-code    as integer      no-undo.
     1503   define input parameter p-terminal-only      as logical      no-undo.
     1504       define variable v-start-full-name   as character     no-undo.
     1505       define variable v-start-sort-name   as character     no-undo.
     1506       define variable v-not-found         as logical       no-undo.
     1507       define variable v-is-terminal       as logical       no-undo.
     1508       define buffer buf_gds-grp           for ub.gds-grp.
     1509       create temp_found-result-nodelist.
     1510       assign
     1511           temp_found-result-nodelist.node-code = p-start-node-code
     1512           temp_found-result-nodelist.processed = no
     1513       .
     1514       run grplib-get-full-name in this-procedure (
     1515             input p-start-node-code
     1516           , output v-start-full-name
     1517       ).
     1518       run grplib-get-full-name in this-procedure (
     1519             input p-start-node-code
     1520           , output v-start-sort-name
     1521       ).
     1522       process-nodes:
     1523       do while yes
     1524       :
     1525           find first temp_found-result-nodelist
     1526                where temp_found-result-nodelist.node-code = p-start-node-code
     1527           .
     1528           assign
     1529               temp_found-result-nodelist.processed = yes
     1530           .
     1531           for each buf_gds-grp no-lock
     1532              where buf_gds-grp.upper-code = p-start-node-code
     1533           on error undo, return error
     1534           :
     1535               run grplib-is-terminal in this-procedure (
     1536                     input buf_gds-grp.node-code
     1537                   , output v-is-terminal
     1538               ).
     1539               if v-is-terminal = yes
     1540               then do:
     1541                   create temp_grplib_found-grp.
     1542                   assign
     1543                       temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
     1544                                                           chr(47) + buf_gds-grp.node-name + chr(47)
     1545                       temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
     1546                                                           chr(2) + buf_gds-grp.node-name + chr(2)
     1547                       temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
     1548                       temp_grplib_found-grp.is-terminal = yes
     1549                   .
     1550               end.
     1551               else do:
     1552                   create temp_found-result-nodelist.
     1553                   assign
     1554                       temp_found-result-nodelist.node-code = buf_gds-grp.node-code
     1555                       temp_found-result-nodelist.full-name = right-trim(v-start-full-name, chr(47)) +
     1556                                                              chr(47) + buf_gds-grp.node-name + chr(47)
     1557                       temp_found-result-nodelist.sort-name = right-trim(v-start-sort-name, chr(2)) +
     1558                                                              chr(2) + buf_gds-grp.node-name + chr(2)
     1559                       temp_found-result-nodelist.processed = no
     1560                   .
     1561                   if p-terminal-only = no
     1562                   then do:
     1563                       create temp_grplib_found-grp.
     1564                       assign
     1565                           temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
     1566                                                               chr(47) + buf_gds-grp.node-name + chr(47)
     1567                           temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
     1568                                                               chr(2) + buf_gds-grp.node-name + chr(2)
     1569                           temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
     1570                           temp_grplib_found-grp.is-terminal = no
     1571                       .
     1572                   end.
     1573               end.
     1574           end.
     1575           find first temp_found-result-nodelist
     1576                where temp_found-result-nodelist.processed = no
     1577           no-error.
     1578           if not available temp_found-result-nodelist
     1579           then do:
     1580               leave process-nodes.
     1581           end.
     1582           else do:
     1583               assign
     1584                   p-start-node-code = temp_found-result-nodelist.node-code
     1585                   v-start-full-name = temp_found-result-nodelist.full-name
     1586                   v-start-sort-name = temp_found-result-nodelist.sort-name
     1587               .
     1588           end.
     1589       end.
     1590   end.
     1591   end procedure.
     1592   procedure grplib-expand-name :
     1593   define input parameter p-start-name as character        no-undo.
     1594   define output parameter p-end-name  as character        no-undo.
     1595       define variable v-is-terminal   as logical      no-undo.
     1596       define variable v-found         as character    no-undo.
     1597       define buffer buf_temp_grplib_found-grp     for temp_grplib_found-grp.
     1598   do
     1599   for buf_temp_grplib_found-grp
     1600   on error undo, return error
     1601   :
     1602       run grplib-find-grp-by-full-name in this-procedure (
     1603             input p-start-name
     1604           , input no
     1605           , output v-found
     1606       ) no-error.
     1607       run grplib-get-max-substring in this-procedure (
     1608                   input length( p-start-name )
     1609                 , output p-end-name
     1610       ) no-error .
     1611       if error-status :error
     1612       then do:
     1613           assign
     1614               p-end-name = ""
     1615           .
     1616       end.
     1617       else do:
     1618           find first temp_grplib_found-grp
     1619               where temp_grplib_found-grp.full-name = p-end-name
     1620           no-error.
     1621           if available temp_grplib_found-grp
     1622           then do:
     1623               find first buf_temp_grplib_found-grp
     1624                   where buf_temp_grplib_found-grp.full-name begins p-end-name
     1625                   and recid( buf_temp_grplib_found-grp ) <> recid( temp_grplib_found-grp )
     1626               no-error.
     1627               if not available buf_temp_grplib_found-grp
     1628               then do:
     1629                   run grplib-is-terminal in this-procedure (
     1630                       input temp_grplib_found-grp.node-code
     1631                       , output v-is-terminal
     1632                   ).
     1633               end.
     1634           end.
     1635       end.
     1636   end.
     1637   end procedure.
     1638   procedure grplib-get-max-substring :
     1639   do
     1640   on error undo, return error
     1641   :
     1642   define input parameter p-min-substring-length   as integer      no-undo.
     1643   define output parameter p-substring             as character    no-undo.
     1644           define variable v-char-counter  as integer           no-undo.
     1645           define variable v-current-char  as character         no-undo.
     1646           define variable v-names-counter  as integer           no-undo.
     1647           define variable v-base-string   as character         no-undo.
     1648           assign
     1649               v-char-counter  = p-min-substring-length
     1650           .
     1651           find first temp_grplib_found-grp no-error.
     1652           if not available temp_grplib_found-grp
     1653           then do:
     1654               undo, return error "grplib-get-max-substring: Нет строк для вычисления общей подстроки".
     1655           end.
     1656           else do:
     1657               assign
     1658                   v-base-string  = temp_grplib_found-grp.full-name
     1659                   v-char-counter = 0
     1660               .
     1661               counter-block:
     1662               do while yes
     1663               on error undo, return error "grplib-get-max-substring: Ошибка вычисления продолжения имени группы."
     1664               :
     1665                   assign
     1666                       v-char-counter  = v-char-counter + 1
     1667                       v-current-char  = substring( v-base-string, v-char-counter, 1 )
     1668                       v-names-counter = 0
     1669                   .
     1670                   compare-block:
     1671                   for each temp_grplib_found-grp
     1672                   :
     1673                       assign
     1674                           v-names-counter = v-names-counter + 1
     1675                       .
     1676                       if v-names-counter = 1
     1677                       then do:
     1678                           next compare-block.
     1679                       end.
     1680                       if substring( temp_grplib_found-grp.full-name, v-char-counter, 1 ) <> v-current-char
     1681                       then do:
     1682                           leave counter-block.
     1683                       end.
     1684                   end.
     1685                   if v-names-counter = 1
     1686                   then do:
     1687                       assign
     1688                           p-substring = v-base-string
     1689                       .
     1690                       return.
     1691                   end.
     1692               end.
     1693               assign
     1694                   p-substring = substring( v-base-string, 1, v-char-counter - 1 )
     1695               .
     1696           end.
     1697   end.
     1698   end procedure.
     1699   procedure grplib-is-terminal :
     1700   do
     1701   on error undo, return error "Ошибка процедуры grplib-is-terminal"
     1702   :
     1703   define input parameter p-node-code      as integer      no-undo.
     1704   define output parameter p-is-terminal   as logical      no-undo.
     1705       define buffer buf_gds-grp       for ub.gds-grp.
     1706       find first buf_gds-grp no-lock
     1707           where buf_gds-grp.upper-code = p-node-code
     1708       no-error .
     1709       if not available buf_gds-grp
     1710       then do:
     1711           assign
     1712               p-is-terminal = yes
     1713           .
     1714       end.
     1715       else do:
     1716           assign
     1717               p-is-terminal = no
     1718           .
     1719       end.
     1720   end.
     1721   end procedure.
     1722   procedure grplib-have-goods :
     1723   do
     1724   on error undo, return error
     1725   :
     1726   define input parameter p-node-code      as integer      no-undo.
     1727   define output parameter p-have-goods   as logical      no-undo.
     1728       define buffer buf_goods         for ub.goods.
     1729       find first buf_goods no-lock
     1730            where buf_goods.grp-code = p-node-code
     1731       no-error .
     1732       if available buf_goods
     1733       then do:
     1734           assign
     1735               p-have-goods = yes
     1736           .
     1737       end.
     1738       else do:
     1739           assign
     1740               p-have-goods = no
     1741           .
     1742       end.
     1743   end.
     1744   end procedure.
     1745   procedure grplib-find-by-substring :
     1746   do
     1747   on error undo, return error
     1748   :
     1749   define input parameter p-start-code         as integer      no-undo.
     1750   define input parameter p-full-search-string as character    no-undo.
     1751   define output parameter p-found-code        as integer      no-undo.
     1752   define output parameter p-full-name         as character    no-undo.
     1753       define variable v-start-code     as integer           no-undo.
     1754       define variable v-found          as logical  init no  no-undo.
     1755       define buffer buf_gds-grp       for ub.gds-grp.
     1756       search-grp:
     1757       for each buf_gds-grp no-lock
     1758           where buf_gds-grp.node-code > p-start-code
     1759       :
     1760           if index( buf_gds-grp.node-name, p-full-search-string ) <> 0
     1761           then do:
     1762               assign
     1763                   p-found-code = buf_gds-grp.node-code
     1764                   v-found      = yes
     1765               .
     1766               run grplib-get-full-name in this-procedure (
     1767                     input p-found-code
     1768                   , output p-full-name
     1769               ) no-error .
     1770               if error-status :error
     1771               then do:
     1772                   undo, return error "grplib-find-by-substring: Ошибка вычисления полного имени группы." + chr(10) + return-value.
     1773               end.
     1774               leave search-grp.
     1775           end.
     1776       end.
     1777       if v-found = yes
     1778       then do:
     1779       end.
     1780       else do:
     1781           assign
     1782               p-full-name  = ""
     1783               p-found-code = 0
     1784           .
     1785       end.
     1786   end.
     1787   end procedure.
     1788   procedure grplib-analyze-grp-name :
     1789   do
     1790   on error undo, return error
     1791   :
     1792   define input parameter p-grp-name       as character            no-undo.
     1793   define input parameter p-upper-code     as integer              no-undo.
     1794   define output parameter p-error-message as character init ""    no-undo.
     1795       define variable v-char-list     as character    no-undo.
     1796       define variable v-char-counter  as integer      no-undo.
     1797       define variable v-full-name     as character    no-undo.
     1798       if p-grp-name = "" then do:
     1799           assign
     1800               p-error-message = "Название группы не может быть пустым.".
     1801           .
     1802       end.
     1803       else do:
     1804           assign
     1805               v-char-list = "47,92,58,63,34,60,62,171,187,183"
     1806           .
     1807           do v-char-counter = 1 to num-entries( v-char-list )
     1808           :
     1809               if index( p-grp-name, chr( integer( entry( v-char-counter, v-char-list ) ) ) ) <> 0
     1810               then do:
     1811                   assign
     1812                       p-error-message = 'Название группы не может содержать символы /\:*?"<>|«»·'
     1813                   .
     1814                   return.
     1815               end.
     1816           end.
     1817           if p-upper-code > 0
     1818           then do:
     1819               run grplib-get-full-name in this-procedure (
     1820                     input p-upper-code
     1821                   , output v-full-name
     1822               ) no-error .
     1823               if error-status :error
     1824               then do:
     1825                   undo, return error "grplib-analyze-grp-name: Не удалось вычислить полное имя группы." + chr(10) + return-value.
     1826               end.
     1827               if length( v-full-name ) + 1 + length( p-grp-name ) > 350
     1828               then do:
     1829                   assign
     1830                       p-error-message = 'Полное название группы не может содержать более 350 символов.'
     1831                   .
     1832               end.
     1833           end.
     1834       end.
     1835   end.
     1836   end procedure.
     1837   procedure grplib-get-lvl-num :
     1838   define input parameter p-node-code  as integer      no-undo.
     1839   define output parameter p-lvl-num   as integer      no-undo.
     1840       define variable v-full-name    as character    no-undo.
     1841   do
     1842   on error undo, return error
     1843   :
     1844       run grplib-get-full-name in this-procedure (
     1845             input p-node-code
     1846           , output v-full-name
     1847       ).
     1848       assign
     1849           p-lvl-num = num-entries( v-full-name, chr(47) ) - 1
     1850       .
     1851       if p-lvl-num = -1
     1852       then do:
     1853           assign
     1854               p-lvl-num = 0
     1855           .
     1856       end.
     1857   end.
     1858   end procedure.
