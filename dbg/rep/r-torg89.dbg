     3901           output  Quantity1  ,
     3902           output  Coast_R1   ,
     3903           output  Coast_V1   ,
     3904           output  VAT_R1     ,
     3905           output  VAT_V1     ,
     3906           output  Fact-order-2 ).
     3907   end procedure.
