     3133   define variable v-xl-current-data-row     as integer      no-undo.
     3134   define variable v-xl-cell-file-name       as character    no-undo.
     3135   define variable v-xl-data-file-name       as character    no-undo.
     3136   procedure xl-init :
     3137       define buffer buf_temp_cell-data        for temp_cell-data.
     3138       define buffer buf_usr-flt               for ubflt.usr-flt.
     3139   do
     3140   for buf_temp_cell-data
     3141     , buf_usr-flt
     3142   on error undo, return error
     3143   :
     3144       assign
     3145           v-xl-current-data-row = 0
     3146       .
     3147       run gbl/_tmpfile.p (
     3148             input "xd"
     3149           , input ".txt"
     3150           , output v-xl-data-file-name
     3151       ).
     3152       output stream excel-line to value( v-xl-data-file-name ).
     3153       run gbl/_tmpfile.p (
     3154             input "xc"
     3155           , input ".txt"
     3156           , output v-xl-cell-file-name
     3157       ).
     3158       output stream excel-cell to value( v-xl-cell-file-name ).
     3159       run xl-write-cell-data in this-procedure (
     3160             input "valutCode":U
     3161           , input "0":U
     3162       ).
     3163       run xl-write-cell-data in this-procedure (
     3164             input "columnList":U
     3165           , input "count,grpname,ostbegin,pripost,priperem,priprvo,privozv,prielse,rasprod,rasvozv,rasperem,rasvnesh,rasprvo,rasspis,raselse,peresort,izlish,nedost,ostend":U
     3166       ).
     3167       run xl-write-cell-data in this-procedure (
     3168             input "columnType":U
     3169           , input "S,S,D,D,D,D,D,D,D,D,D,D,D,D,D,D,D,D,D":U
     3170       ).
     3171       run xl-write-cell-data in this-procedure (
     3172             input "columnAmount":U
     3173           , input "19":U
     3174       ).
     3175   end.
     3176   end procedure.
     3177   procedure xl-close :
     3178   do
     3179   on error undo, return error
     3180   :
     3181       output stream excel-line close.
     3182       output stream excel-cell close.
     3183       output to value( string( session:temp-directory + "$" + string( g#report-num ) ) + ".txl" ) append.
     3184           export "exe/tg89.xlt":U.
     3185           export "exe/t_97.bas":U.
     3186           export v-xl-cell-file-name.
     3187           export v-xl-data-file-name.
     3188       output close.
     3189   end.
     3190   end procedure.
     3191   procedure xl-write-cell-data :
     3192   define input parameter p-data-key   as character        no-undo.
     3193   define input parameter p-data-value as character        no-undo.
     3194       define buffer buf_temp_cell-data     for temp_cell-data.
     3195   do
     3196   for buf_temp_cell-data
     3197   on error undo, return error
     3198   :
     3199       find first buf_temp_cell-data
     3200            where buf_temp_cell-data.data-key = p-data-key
     3201       no-error.
     3202       if not available buf_temp_cell-data
     3203       then do :
     3204           create buf_temp_cell-data.
     3205           assign
     3206               buf_temp_cell-data.data-key = p-data-key
     3207           .
     3208       end.
     3209       assign
     3210           buf_temp_cell-data.data-value = p-data-value
     3211       .
     3212       put stream excel-cell unformatted
     3213                           buf_temp_cell-data.data-key
     3214           CHR(9)   buf_temp_cell-data.data-value
     3215           chr(10)
     3216       .
     3217   end.
     3218   end procedure.
