     2257       assign
     2258               vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else (((buf_gds-dtl.price-base - buf_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale - varprice-base-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * buf_gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((buf_gds-dtl.price-base - buf_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * buf_gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     2259               vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else (((buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * buf_gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * buf_gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     2260        .
     2261     end.
     2262     else do:
     2263       assign
     2264               vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else (((buf_gds-dtl.price-base - buf_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale - varprice-base-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * buf_gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((buf_gds-dtl.price-base - buf_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - varprice-base-cons) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * buf_gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     2265               vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else (((buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * buf_gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - varprice-rubl-cons) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * buf_gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     2266        .
     2267     end.
     2268   end.
     2269   assign
     2270   price-base-without-tax-sale = price-base-with-tax-sale - vat-base-sale - slt-base-sale - road-tax-base-sale
     2271   price-rubl-without-tax-sale = price-rubl-with-tax-sale - vat-rubl-sale - slt-rubl-sale - road-tax-rubl-sale.
     2272               ASSIGN
     2273                   p-fact-qnty           = p-fact-qnty     + v-gds-dtl-fact-qnty
     2274                   p-sum-base            = p-sum-base      + price-base-with-tax-sale  * v-gds-dtl-fact-qnty
     2275                   p-sum-rubl            = p-sum-rubl      + price-rubl-with-tax-sale  * v-gds-dtl-fact-qnty
     2276                   p-vat-base            = p-vat-base      + vat-base-sale             * v-gds-dtl-fact-qnty
     2277                   p-vat-rubl            = p-vat-rubl      + vat-rubl-sale             * v-gds-dtl-fact-qnty
     2278                   p-slt-base            = p-slt-base      + slt-base-sale             * v-gds-dtl-fact-qnty
     2279                   p-slt-rubl            = p-slt-rubl      + slt-rubl-sale             * v-gds-dtl-fact-qnty
     2280                   p-road-tax-base       = p-road-tax-base + road-tax-base-sale        * v-gds-dtl-fact-qnty
     2281                   p-road-tax-rubl       = p-road-tax-rubl + road-tax-rubl-sale        * v-gds-dtl-fact-qnty
     2282                   p-excise-base         = p-excise-base   + excise-base-sale          * v-gds-dtl-fact-qnty
     2283                   p-excise-rubl         = p-excise-rubl   + excise-rubl-sale          * v-gds-dtl-fact-qnty
     2284                   p-other-base          = p-other-base    + discnt-base-sale          * v-gds-dtl-fact-qnty
     2285                   p-other-rubl          = p-other-rubl    + discnt-rubl-sale          * v-gds-dtl-fact-qnty
     2286               .
     2287           end.
     2288       end.
     2289       assign
     2290           p-transport-base      = 0
     2291           p-transport-rubl      = 0
     2292           p-vat-pc              = buf_doc-line.vat-pc
     2293           p-slt-pc              = buf_doc-line.slt-pc
     2294       .
     2295     end.
     2296     if p-fact-qnty      = ?
     2297     or p-vat-pc         = ?
     2298     or p-slt-pc         = ?
     2299     or p-sum-base       = ?
     2300     or p-sum-rubl       = ?
     2301     or p-vat-base       = ?
     2302     or p-vat-rubl       = ?
     2303     or p-slt-base       = ?
     2304     or p-slt-rubl       = ?
     2305     or p-road-tax-base  = ?
     2306     or p-road-tax-rubl  = ?
     2307     or p-transport-base = ?
     2308     or p-transport-rubl = ?
     2309     or p-other-base     = ?
     2310     or p-other-rubl     = ?
     2311     or p-excise-base    = ?
     2312     or p-excise-rubl    = ?
     2313     then do:
     2314       message
     2315         vss-workfile vss-revision vss-description skip
     2316         vss-include-info15 skip
     2317         "Получены неопределенные значения" skip
     2318         "Документ" p-doc-code skip
     2319         "Артикул" p-artic p-prod-type p-prod-code skip
     2320         "fact-qnty     " p-fact-qnty      skip
     2321         "vat-pc        " p-vat-pc         skip
     2322         "slt-pc        " p-slt-pc         skip
     2323         "sum-base      " p-sum-base       skip
     2324         "sum-rubl      " p-sum-rubl       skip
     2325         "vat-base      " p-vat-base       skip
     2326         "vat-rubl      " p-vat-rubl       skip
     2327         "slt-base      " p-slt-base       skip
     2328         "slt-rubl      " p-slt-rubl       skip
     2329         "road-tax-base " p-road-tax-base  skip
     2330         "road-tax-rubl " p-road-tax-rubl  skip
     2331         "transport-base" p-transport-base skip
     2332         "transport-rubl" p-transport-rubl skip
     2333         "other-base    " p-other-base     skip
     2334         "other-rubl    " p-other-rubl     skip
     2335         "excise-base   " p-excise-base    skip
     2336         "excise-rubl   " p-excise-rubl    skip
     2337         view-as alert-box error .
     2338       undo, return error .
     2339     end.
     2340   end procedure.
     2341   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2342   procedure factord :
     2343     define input  parameter p-fact-date            as date    no-undo .
     2344     define input  parameter p-fact-time            as integer no-undo .
     2345     define input  parameter p-fact-num             as integer no-undo .
     2346     define input  parameter p-shift-date           as date    no-undo .
     2347     define input  parameter p-shift-num            as integer no-undo .
     2348     define input  parameter p-shift-on             as logical no-undo .
     2349     define output parameter p-fact-order           as decimal no-undo .
     2350     define output parameter p-shift-end-fact-order as decimal no-undo .
     2351     define output parameter p-day-end-fact-order   as decimal no-undo .
     2352     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     2353     if p-fact-date = ?
     2354     then do:
     2355       return error "Не указана фактическая дата" .
     2356     end.
     2357     define variable v-fact-date-num as integer no-undo .
     2358     assign
     2359       v-fact-date-num = integer(p-fact-date)
     2360     .
     2361     if p-fact-num = ?
     2362     or p-fact-num = 0
     2363     then do:
     2364       return error "Не задан p-fact-num " + string(p-fact-num) .
     2365     end.
     2366     if p-fact-num < 0
     2367     then do:
     2368       return error "Отрицательный fact-num " + string(p-fact-num) .
     2369     end.
     2370     if p-fact-num >= 100000000
     2371     then do:
     2372       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     2373     end.
     2374     if p-shift-on = true
     2375     then do:
     2376       if p-shift-date = ?
     2377       then do:
     2378         return error "Не задана дата смены" .
     2379       end.
     2380       if p-shift-num = ?
     2381       or p-shift-num = 0
     2382       then do:
     2383         return error "Не задан номер смены" .
     2384       end.
     2385     end.
     2386     else do:
     2387       assign
     2388         p-shift-date = p-fact-date
     2389         p-shift-num  = 24
     2390       .
     2391     end.
     2392     define variable v-shift-offset as integer no-undo .
     2393     if p-shift-date = p-fact-date
     2394     then do:
     2395       assign
     2396         v-shift-offset = 1
     2397       .
     2398     end.
     2399     if p-shift-date < p-fact-date
     2400     then do:
     2401       assign
     2402         v-shift-offset = 0
     2403       .
     2404     end.
     2405     if p-shift-date > p-fact-date
     2406     then do:
     2407       message
     2408         vss-workfile vss-revision vss-description skip
     2409         "Неправильная дата закрытия смены" skip
     2410         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     2411         view-as alert-box error .
     2412       undo, return error
     2413         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     2414           ,string(p-fact-date, '99/99/9999':U)
     2415           ,string(p-shift-date, '99/99/9999':U)
     2416           )
     2417       .
     2418     end.
     2419     if p-shift-num < 1
     2420     or p-shift-num > 24
     2421     then do:
     2422       message
     2423         vss-workfile vss-revision vss-description skip
     2424         "Неправильный номер смены" skip
     2425         "p-shift-num" p-shift-num skip
     2426         view-as alert-box error .
     2427       undo, return error return-value .
     2428     end.
     2429     assign
     2430       p-fact-order           = v-fact-date-num
     2431                              + v-shift-offset * 0.5
     2432                              + p-shift-num    * 0.02 - 0.01
     2433                              + p-fact-num     * 0.0000000001
     2434       p-shift-end-fact-order = v-fact-date-num
     2435                              + v-shift-offset * 0.5
     2436                              + p-shift-num    * 0.02
     2437       p-day-end-fact-order   = v-fact-date-num
     2438                              + 0.99
     2439     .
     2440     if p-fact-order           <= v-fact-date-num
     2441     or p-shift-end-fact-order <= v-fact-date-num
     2442     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     2443     or p-shift-end-fact-order >= p-day-end-fact-order
     2444     then do:
     2445       message
     2446         vss-workfile vss-revision vss-description skip
     2447         "Внутренняя ошибка при генерации фактического номера" skip
     2448         "p-fact-date"            p-fact-date            skip
     2449         "p-fact-time"            p-fact-time            skip
     2450         "p-fact-num"             p-fact-num             skip
     2451         "p-shift-date"           p-shift-date           skip
     2452         "p-shift-num"            p-shift-num            skip
     2453         "p-shift-on"             p-shift-on             skip
     2454         "p-shift-end-fact-order" p-shift-end-fact-order skip
     2455         "p-day-end-fact-order"   p-day-end-fact-order   skip
     2456         "v-fact-date-num"        v-fact-date-num        skip
     2457         view-as alert-box error .
     2458       undo, return error return-value .
     2459     end.
     2460   end procedure.
     2461   procedure day-begin-fact-order :
     2462     define input  parameter p-fact-date            as date    no-undo .
     2463     define output parameter p-day-begin-fact-order as decimal no-undo .
     2464     do
     2465     on error undo, return error return-value
     2466     :
     2467       if p-fact-date = ?
     2468       then do:
     2469         assign
     2470           p-day-begin-fact-order = 0
     2471         .
     2472       end.
     2473       else do:
     2474         assign
     2475           p-day-begin-fact-order = integer(p-fact-date)
     2476         .
     2477       end.
     2478     end.
     2479   end procedure.
     2480   procedure factord-max-fact-order :
     2481     define output parameter p-max-fact-order as decimal   no-undo .
     2482     do
     2483     on error undo, return error return-value
     2484     :
     2485       run day-begin-fact-order in this-procedure
     2486         (input  date(1, 1, 5000)
     2487         ,output p-max-fact-order
     2488         ) .
     2489     end.
     2490   end procedure.
     2491   procedure factord-cut-archive :
     2492     define input  parameter p-obj-type             as character no-undo .
     2493     define input  parameter p-obj-code             as integer   no-undo .
     2494     define input  parameter p-fact-date            as date      no-undo .
     2495     define output parameter p-shift-on             as logical   no-undo .
     2496     define output parameter p-shift-date           as date      no-undo .
     2497     define output parameter p-shift-num            as integer   no-undo .
     2498     define output parameter p-day-end-fact-order   as decimal   no-undo .
     2499     define output parameter p-shift-end-fact-order as decimal   no-undo .
     2500     define variable v-fact-order as decimal   no-undo .
     2501     define buffer buf_shift-obj for ub.shift-obj .
     2502     do
     2503     on error undo, return error return-value
     2504     :
     2505   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2506   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     2507     (input  p-obj-type
     2508     ,input  p-obj-code
     2509     ,input  'shift-on=request'
     2510     ,output p-shift-on
     2511     ) no-error .
     2512       if error-status :error
     2513       then do:
     2514         message
     2515           vss-workfile vss-revision vss-description skip
     2516           "Ошибка при определении атрибута объекта" skip
     2517           "Объект" p-obj-type p-obj-code skip
     2518           error-status :get-message(1) skip
     2519           return-value skip
     2520           view-as alert-box error .
     2521         undo, return error return-value .
     2522       end.
     2523       if p-shift-on = false
     2524       then do:
     2525         assign
     2526           p-shift-date               = ?
     2527           p-shift-num                = 0
     2528         .
     2529       end.
     2530       else do:
     2531         find first buf_shift-obj share-lock
     2532           where buf_shift-obj.obj-type   = p-obj-type
     2533             and buf_shift-obj.obj-code   = p-obj-code
     2534             and buf_shift-obj.shift-date > p-fact-date
     2535           use-index pi
     2536           no-error .
     2537         if not available buf_shift-obj
     2538         or buf_shift-obj.status_ <> 'зкр':U
     2539         then do:
     2540           message
     2541             vss-workfile vss-revision vss-description skip
     2542             "Невозможно вычислить последнюю смену" skip
     2543             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     2544             "Объект" p-obj-type p-obj-code skip
     2545             "Дата" p-fact-date skip
     2546             view-as alert-box error .
     2547           undo, return error return-value .
     2548         end.
     2549         find last buf_shift-obj share-lock
     2550           where buf_shift-obj.obj-type = p-obj-type
     2551             and buf_shift-obj.obj-code = p-obj-code
     2552             and buf_shift-obj.shift-date <= p-fact-date
     2553           use-index pi
     2554           no-error .
     2555         if available buf_shift-obj
     2556         then do:
     2557           if  buf_shift-obj.status_ = 'зкр':U
     2558           then do:
     2559             assign
     2560               p-shift-date = buf_shift-obj.shift-date
     2561               p-shift-num  = buf_shift-obj.shift-num
     2562             .
     2563           end.
     2564           else do:
     2565             message
     2566               vss-workfile vss-revision vss-description skip
     2567               "Невозможно вычислить последнюю смену" skip
     2568               "Статус смены отличен от статуса" 'зкр':U skip
     2569               "Объект" p-obj-type p-obj-code skip
     2570               "Дата" p-fact-date skip
     2571               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     2572               view-as alert-box error .
     2573             undo, return error return-value .
     2574           end.
     2575         end.
     2576         else do:
     2577           assign
     2578             p-shift-date = p-fact-date - 1
     2579             p-shift-num  = 1
     2580           .
     2581         end.
     2582       end.
     2583       run factord in this-procedure
     2584         (input  p-fact-date
     2585         ,input  1
     2586         ,input  1
     2587         ,input  p-shift-date
     2588         ,input  p-shift-num
     2589         ,input  p-shift-on
     2590         ,output v-fact-order
     2591         ,output p-shift-end-fact-order
     2592         ,output p-day-end-fact-order
     2593         ) no-error .
     2594       if error-status :error
     2595       then do:
     2596         message
     2597           vss-workfile vss-revision vss-description skip
     2598           "Ошибка при вызове процедуры factord"
     2599           error-status :get-message(1) skip
     2600           return-value skip
     2601           view-as alert-box error .
     2602         undo, return error return-value .
     2603       end.
     2604     end.
     2605   end procedure.
     2606   procedure factord-lock-shift :
     2607     define input  parameter p-obj-type  as character no-undo .
     2608     define input  parameter p-obj-code  as integer   no-undo .
     2609     define input  parameter p-fact-date as date      no-undo .
     2610     define parameter buffer buf_shift-obj for ub.shift-obj .
     2611     define variable v-shift-on      as logical   no-undo .
     2612     define variable v-extra-message as character no-undo .
     2613     define variable v-error as character no-undo .
     2614     do
     2615     on error undo, return error return-value
     2616     :
     2617   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2618   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     2619     (input  p-obj-type
     2620     ,input  p-obj-code
     2621     ,input  'shift-on=request'
     2622     ,output v-shift-on
     2623     ) no-error .
     2624       if error-status :error
     2625       then do:
     2626         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     2627         undo, return error v-error .
     2628       end.
     2629       if v-shift-on = true
     2630       then do:
     2631         find first buf_shift-obj share-lock
     2632           where buf_shift-obj.obj-type   = p-obj-type
     2633             and buf_shift-obj.obj-code   = p-obj-code
     2634             and buf_shift-obj.shift-date > p-fact-date
     2635           use-index pi
     2636           no-error .
     2637         if not available buf_shift-obj
     2638         or buf_shift-obj.status_ <> 'зкр':U
     2639         then do:
     2640           find last buf_shift-obj
     2641             where buf_shift-obj.obj-type = p-obj-type
     2642               and buf_shift-obj.obj-code = p-obj-code
     2643               and buf_shift-obj.status_  = 'зкр':U
     2644             use-index stts
     2645             no-error .
     2646           if available buf_shift-obj
     2647           then do:
     2648             assign
     2649               v-extra-message =
     2650                     substitute("Дата начала последеней закрытой смены на объекте &1"
     2651                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     2652                               )
     2653             .
     2654           end.
     2655           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     2656           undo, return error v-error .
     2657         end.
     2658       end.
     2659     end.
     2660   end procedure.
     2661   procedure factord-end-day :
     2662     define input  parameter p-fact-date            as date    no-undo .
     2663     define output parameter p-day-end-fact-order   as decimal no-undo .
     2664     do
     2665     on error undo, return error return-value
     2666     :
     2667       if p-fact-date = ?
     2668       then do:
     2669         return error "Не указана фактическая дата" .
     2670       end.
     2671       assign
     2672         p-day-end-fact-order = integer(p-fact-date) + 0.99
     2673       .
     2674     end.
     2675   end procedure.
     2676   procedure factord-to-date :
     2677     define input  parameter p-fact-order as decimal no-undo .
     2678     define output parameter p-fact-date  as date    no-undo .
     2679     define variable v-ref-date  as date      no-undo .
     2680     define variable v-ref-delta as integer   no-undo .
     2681     do
     2682     on error undo, return error return-value
     2683     :
     2684       if p-fact-order = ?
     2685       or p-fact-order = 0
     2686       then do:
     2687         return error "Не указан fact-order" .
     2688       end.
     2689       assign
     2690         v-ref-date  = date(1, 1, 2000)
     2691       .
     2692       assign
     2693         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     2694       .
     2695       assign
     2696         p-fact-date = v-ref-date + v-ref-delta
     2697       .
     2698     end.
     2699   end procedure.
     2700   procedure factord-to-fact-num :
     2701     define input  parameter p-fact-order as decimal no-undo .
     2702     define output parameter p-fact-num   as integer no-undo .
     2703     define variable v-fact-order-trunc as decimal no-undo .
     2704     do
     2705     on error undo, return error return-value
     2706     :
     2707       if p-fact-order = ?
     2708       or p-fact-order = 0
     2709       then do:
     2710         return error "Не указан fact-order" .
     2711       end.
     2712       assign
     2713        v-fact-order-trunc = truncate(p-fact-order, 2)
     2714       .
     2715       assign
     2716         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     2717       .
     2718     end.
     2719   end procedure.
     2720   procedure factord-to-shift-num :
     2721     define input  parameter p-fact-order as decimal no-undo .
     2722     define output parameter p-shift-num   as integer no-undo .
     2723     define variable  p-shift-numd  as decimal   no-undo .
     2724     define variable v-fact-order-trunc as decimal no-undo .
     2725     do
     2726     on error undo, return error return-value
     2727     :
     2728       if p-fact-order = ?
     2729       or p-fact-order = 0
     2730       then do:
     2731         return error "Не указан fact-order" .
     2732       end.
     2733       assign
     2734        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     2735       .
     2736       if v-fact-order-trunc < 0.5 then do:
     2737         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     2738       end.
     2739       assign
     2740         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     2741         .
     2742        assign
     2743         p-shift-num = truncate (p-shift-numd , 0)
     2744       .
     2745     end.
     2746   end procedure.
     2747   PROCEDURE ostatok :
     2748   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
     2749   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
     2750   def input parameter x-tog-shift   as   logical             no-undo.
     2751   def input parameter x-date-start  like ub.stk-tot.Fact-date   no-undo.
     2752   def input parameter x-date-end    like ub.stk-tot.Fact-date   no-undo.
     2753   def input parameter x-shift-start as integer               no-undo.
     2754   def input parameter x-shift-end   as integer               no-undo.
     2755   def input parameter x-sum-type    like ub.stk-tot.sum-type    no-undo.
     2756   def input parameter x-cat-id      like ub.stk-tot.cat-id      no-undo.
     2757   def input parameter xTog-obj   as log no-undo.
     2758   def output parameter Quantity    like ub.stk-tot.fact-qnty   no-undo.
     2759   def output parameter Coast_R     like ub.stk-tot.sum-rubl    no-undo.
     2760   def output parameter Coast_V     like ub.stk-tot.sum-rubl    no-undo.
     2761   def output parameter VAT_R       like ub.stk-tot.sum-rubl    no-undo.
     2762   def output parameter VAT_V       like ub.stk-tot.sum-rubl    no-undo.
     2763   def output parameter Fact-order  like ub.stk-tot.Fact-order  no-undo.
     2764   def var              Fact-order#   like ub.stk-tot.Fact-order  no-undo.
     2765   def var              Fact-orderS   as char  no-undo.
     2766   def var x-date-start-t  like ub.stk-tot.shift-date   no-undo.
     2767      Assign
     2768         Fact-order   = 0
     2769         Quantity     = 0
     2770         Coast_R      = 0
     2771         Coast_V      = 0
     2772         VAT_R        = 0
     2773         VAT_V        = 0 .
     2774    x-date-start-t  = x-date-start + 1 .
     2775   IF x-date-end = date('') then DO:
     2776      Fact-order = 0 .
     2777      for each obj-list
     2778          where  ( not xtog-obj or
     2779                 ( x-store-type = obj-list.obj-type and x-store-code = obj-list.obj-code ))
     2780                 no-lock :
     2781         if  x-tog-shift = false then do:
     2782                          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2783                               ub.stk-tot.Fact-date <=  x-date-start
     2784                               and ub.stk-tot.shift-num = 0
     2785                               USE-INDEX fact-date no-lock no-error .
     2786              if Available ub.stk-tot THEN  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2787         End.
     2788         Else  DO :
     2789             find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2790              (ub.stk-tot.shift-date  = x-date-start-t and
     2791               ub.stk-tot.shift-num  < x-shift-start or
     2792               ub.stk-tot.shift-date  < x-date-start-t  )
     2793               and ub.stk-tot.shift-num  > 0
     2794               USE-INDEX Shift-num no-lock no-error .
     2795            If Available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2796           END.
     2797       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     2798     End.
     2799   End.
     2800   Else DO:
     2801     For each obj-list  WHERE
     2802        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
     2803         no-lock :
     2804      IF  x-TOG-Shift = False Then DO:
     2805          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2806               ub.stk-tot.Fact-date <= x-date-end
     2807               and ub.stk-tot.shift-num = 0
     2808               USE-INDEX fact-date no-lock no-error.
     2809          if available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2810      END.
     2811      Else DO:
     2812           find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     2813               (ub.stk-tot.shift-date  = x-date-end and
     2814               ub.stk-tot.shift-num  <= x-shift-end or
     2815               ub.stk-tot.shift-date  < x-date-end       ) and
     2816               ub.stk-tot.shift-num   > 0      use-index shift-num no-lock no-error.
     2817               if Available ub.stk-tot THEN Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     2818       End.
     2819       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     2820     End.
     2821   End.
     2822   END PROCEDURE.
     2823   procedure ost-line :
     2824     define input  parameter x-store-code like ub.clients.obj-code    no-undo .
     2825     define input  parameter x-store-type like ub.clients.obj-type    no-undo .
     2826     define input  parameter x-artic      like ub.stk-line.artic      no-undo .
     2827     define input  parameter x-prod-code  like ub.stk-line.prod-code  no-undo .
     2828     define input  parameter x-prod-type  like ub.stk-line.prod-type  no-undo .
     2829     define input  parameter x-tog-shift  as logical no-undo .
     2830     define input  parameter x-fact-order like ub.stk-line.fact-order no-undo .
     2831     define input  parameter x-sum-type   like ub.stk-line.sum-type   no-undo .
     2832     define input  parameter x-cat-id     like ub.stk-line.cat-id     no-undo .
     2833     define input  parameter xtog-obj     as logical no-undo .
     2834     define output parameter quantity     like ub.stk-line.fact-qnty  no-undo .
     2835     define output parameter coast_r      like ub.stk-line.sum-rubl   no-undo .
     2836     define output parameter coast_v      like ub.stk-line.sum-rubl   no-undo .
     2837     define output parameter vat_r        like ub.stk-line.sum-rubl   no-undo .
     2838     define output parameter vat_v        like ub.stk-line.sum-rubl   no-undo .
     2839     define output parameter slt_r        like ub.stk-line.sum-rubl   no-undo .
     2840     define output parameter slt_v        like ub.stk-line.sum-rubl   no-undo .
     2841     define buffer buff-obj-list  for obj-list .
     2842     define buffer buff-stk-line  for ub.stk-line .
     2843     assign
     2844       Quantity = 0
     2845       Coast_R  = 0
     2846       Coast_V  = 0
     2847       VAT_R    = 0
     2848       VAT_V    = 0
     2849       SLT_R    = 0
     2850       SLT_V    = 0
     2851     .
     2852     if  x-tog-shift = false then do:
     2853       for each buff-obj-list no-lock
     2854         where xtog-obj = false
     2855            or (buff-obj-list.obj-type = x-store-type
     2856               and buff-obj-list.obj-code = x-store-code
     2857               )
     2858       on error undo, return error
     2859       :
     2860         find last buff-stk-line no-lock
     2861           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     2862             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     2863             and buff-stk-line.artic      = x-artic
     2864             and buff-stk-line.prod-type  = x-prod-type
     2865             and buff-stk-line.prod-code  = x-prod-code
     2866             and buff-stk-line.sum-type   = x-sum-type
     2867             and buff-stk-line.cat-id     = '##,##':U
     2868             and buff-stk-line.fact-order <= x-fact-order
     2869             and buff-stk-line.shift-num  = 0
     2870           use-index category
     2871           no-error .
     2872         if available buff-stk-line then do:
     2873           assign
     2874             Quantity = Quantity +  buff-stk-line.fact-qnty
     2875             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     2876             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     2877             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     2878             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     2879             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     2880             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     2881           .
     2882         end.
     2883       end.
     2884     end.
     2885     else do:
     2886       for each buff-obj-list no-lock
     2887         where xtog-obj = false
     2888            or (buff-obj-list.obj-type = x-store-type
     2889               and buff-obj-list.obj-code = x-store-code
     2890               )
     2891       on error undo, return error
     2892       :
     2893         find last buff-stk-line no-lock
     2894           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     2895             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     2896             and buff-stk-line.artic      = x-artic
     2897             and buff-stk-line.prod-type  = x-prod-type
     2898             and buff-stk-line.prod-code  = x-prod-code
     2899             and buff-stk-line.sum-type   = x-sum-type
     2900             and buff-stk-line.cat-id     = '##,##':U
     2901             and buff-stk-line.fact-order <= x-fact-order
     2902             and buff-stk-line.shift-num  > 0
     2903           use-index category
     2904           no-error .
     2905         if available buff-stk-line then do:
     2906           assign
     2907             Quantity = Quantity +  buff-stk-line.fact-qnty
     2908             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     2909             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     2910             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     2911             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     2912             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     2913             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     2914           .
     2915         end.
     2916       end.
     2917     end.
     2918   end procedure.
     2919   procedure ost-lineother-tax :
     2920     define input  parameter x-store-code like ub.clients.obj-code      no-undo.
     2921     define input  parameter x-store-type like ub.clients.obj-type      no-undo.
     2922     define input  parameter x-artic      like ub.stk-line.artic        no-undo.
     2923     define input  parameter x-prod-code  like ub.stk-line.prod-code    no-undo.
     2924     define input  parameter x-prod-type  like ub.stk-line.prod-type    no-undo.
     2925     define input  parameter x-tog-shift  as logical no-undo .
     2926     define input  parameter x-fact-order like ub.stk-line.fact-order   no-undo.
     2927     define input  parameter x-sum-type   like ub.stk-line.sum-type     no-undo.
     2928     define input  parameter x-type-id    like ub.stk-line.cat-id       no-undo.
     2929     define input  parameter xTog-obj     as logical no-undo .
     2930     define output parameter Quantity     like ub.stk-line.fact-qnty   no-undo.
     2931     define output parameter Coast_R      like ub.stk-line.sum-rubl    no-undo.
     2932     define output parameter Coast_V      like ub.stk-line.sum-rubl    no-undo.
     2933     define output parameter VAT_R        like ub.stk-line.sum-rubl    no-undo.
     2934     define output parameter VAT_V        like ub.stk-line.sum-rubl    no-undo.
     2935     define output parameter SLT_R        like ub.stk-line.sum-rubl    no-undo.
     2936     define output parameter SLT_V        like ub.stk-line.sum-rubl    no-undo.
     2937     define output parameter other_R      like ub.stk-line.sum-rubl    no-undo.
     2938     define output parameter other_V      like ub.stk-line.sum-rubl    no-undo.
     2939     define buffer buff-obj-list  for obj-list .
     2940     define buffer buff-stk-line  for ub.stk-line .
     2941     assign
     2942       Quantity = 0
     2943       Coast_R  = 0
     2944       Coast_V  = 0
     2945       VAT_R    = 0
     2946       VAT_V    = 0
     2947       SLT_R    = 0
     2948       SLT_V    = 0
     2949       other_R  = 0
     2950       other_V  = 0
     2951     .
     2952     if  x-tog-shift = false then do:
     2953       for each buff-obj-list no-lock
     2954         where xtog-obj = false
     2955            or (buff-obj-list.obj-type = x-store-type
     2956               and buff-obj-list.obj-code = x-store-code
     2957               )
     2958       on error undo, return error
     2959       :
     2960         find last buff-stk-line no-lock
     2961           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     2962             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     2963             and buff-stk-line.artic      = x-artic
     2964             and buff-stk-line.prod-type  = x-prod-type
     2965             and buff-stk-line.prod-code  = x-prod-code
     2966             and buff-stk-line.sum-type   = x-sum-type
     2967             and buff-stk-line.cat-id     = '##,##':U
     2968             and buff-stk-line.fact-order <= x-fact-order
     2969             and buff-stk-line.shift-num  = 0
     2970           use-index category
     2971           no-error .
     2972         if available buff-stk-line then do:
     2973           assign
     2974             Quantity = Quantity +  buff-stk-line.fact-qnty
     2975             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     2976             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     2977             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     2978             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     2979             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     2980             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     2981             other_R  = other_R  +  buff-stk-line.other-rubl
     2982             other_V  = other_V  +  buff-stk-line.other-base
     2983           .
     2984         end.
     2985       end.
     2986     end.
     2987     else do:
     2988       for each buff-obj-list no-lock
     2989         where xtog-obj = false
     2990            or (buff-obj-list.obj-type = x-store-type
     2991               and buff-obj-list.obj-code = x-store-code
     2992               )
     2993       on error undo, return error
     2994       :
     2995         find last buff-stk-line no-lock
     2996           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     2997             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     2998             and buff-stk-line.artic      = x-artic
     2999             and buff-stk-line.prod-type  = x-prod-type
     3000             and buff-stk-line.prod-code  = x-prod-code
     3001             and buff-stk-line.sum-type   = x-sum-type
     3002             and buff-stk-line.cat-id     = '##,##':U
     3003             and buff-stk-line.fact-order <= x-fact-order
     3004             and buff-stk-line.shift-num  > 0
     3005           use-index category
     3006           no-error .
     3007         if available buff-stk-line then do:
     3008           assign
     3009             Quantity = Quantity +  buff-stk-line.fact-qnty
     3010             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     3011             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     3012             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     3013             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     3014             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     3015             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     3016             other_R = other_R   +  buff-stk-line.other-rubl
     3017             other_V = other_V   +  buff-stk-line.other-base
     3018           .
     3019         end.
     3020       end.
     3021     end.
     3022   end procedure.
     3023   procedure ost-line-kg :
     3024     define  input parameter p-obj-code    like ub.stk-line.obj-code   no-undo .
     3025     define  input parameter p-obj-type    like ub.stk-line.obj-type   no-undo .
     3026     define  input parameter p-artic       like ub.stk-line.artic      no-undo .
     3027     define  input parameter p-prod-code   like ub.stk-line.prod-code  no-undo .
     3028     define  input parameter p-prod-type   like ub.stk-line.prod-type  no-undo .
     3029     define  input parameter p-fact-order  like ub.stk-line.fact-order no-undo .
     3030     define output parameter p-quantity-kg like ub.stk-line.fact-qnty  no-undo initial 0.00 .
     3031     define buffer buff-obj-list  for obj-list .
     3032     define buffer buf_doc-line for ub.doc-line .
     3033     define buffer buf_inv-line for ub.inv-line .
     3034     do
     3035     on error undo, return error
     3036     :
     3037       for each buf_doc-line no-lock where
     3038                buf_doc-line.obj-type    = p-obj-type   and
     3039                buf_doc-line.obj-code    = p-obj-code   and
     3040                buf_doc-line.prod-type   = p-prod-type  and
     3041                buf_doc-line.prod-code   = p-prod-code  and
     3042                buf_doc-line.artic       = p-artic      and
     3043                buf_doc-line.status_     = 'факт':U      and
     3044                buf_doc-line.fact-order <= p-fact-order
     3045             by buf_doc-line.fact-order    descending
     3046       :
     3047         find first buf_inv-line no-lock where
     3048                    buf_inv-line.doc-code  = buf_doc-line.doc-code  and
     3049                    buf_inv-line.artic     = buf_doc-line.artic     and
     3050                    buf_inv-line.prod-type = buf_doc-line.prod-type and
     3051                    buf_inv-line.prod-code = buf_doc-line.prod-code no-error .
     3052         if available buf_inv-line
     3053         then do:
     3054           if buf_inv-line.after-cli-qnty <> ?
     3055           then do:
     3056             assign
     3057               p-quantity-kg = buf_inv-line.after-cli-qnty
     3058             .
     3059             leave .
     3060           end.
     3061         end.
     3062       end.
     3063       if p-quantity-kg = ?
     3064       then do:
     3065         assign
     3066           p-quantity-kg = 0
     3067         .
     3068       end.
     3069     end.
     3070   end procedure.
     3071   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3072   define new global shared variable g#trdcalib as handle no-undo.
