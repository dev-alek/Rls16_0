     3674       when 'iv':U or when 'rv':U
     3675                                                       then assign temp-grp-obj.priperem   = temp-grp-obj.priperem  + ABS(buf_ot-line.sum-rubl - buf_ot-line.VAT-rubl) .
     3676       when 'im':U       then assign temp-grp-obj.priprvo    = temp-grp-obj.priprvo   + ABS(buf_ot-line.sum-rubl - buf_ot-line.VAT-rubl) .
     3677       when 're':U  then assign temp-grp-obj.privozv    = temp-grp-obj.privozv   + ABS(buf_ot-line.sum-rubl - buf_ot-line.VAT-rubl) .
     3678       when 'ap':U or when 'mp':U
     3679                          then do :
