     1055   PROCEDURE check-modified :
     1056   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1057   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1058   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1059   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1060     IF check-state = "check":U THEN
     1061     DO:
     1062       RUN get-link-handle IN adm-broker-hdl
     1063         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1064            OUTPUT group-target-list).
     1065       IF group-target-list NE "":U THEN
     1066       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1067         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1068         RUN check-modified IN curr-widget ('group-check':U).
     1069         IF RETURN-VALUE NE "":U THEN
     1070         DO:
     1071           RUN check-modified-message(RETURN-VALUE).
     1072           RETURN "":U.
     1073         END.
     1074       END.
     1075     END.
     1076     RETURN "":U.
     1077   END PROCEDURE.
     1078   PROCEDURE check-modified-message :
     1079     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1080        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1081           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1082        IF RETURN-VALUE = "YES":U THEN
     1083           RUN notify ('view,CONTAINER-SOURCE':U).
     1084        MESSAGE IF p-changed-table NE ? THEN
     1085           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1086           ELSE "Current values have been changed."
     1087           SKIP "  Do you wish to save those changes?"
     1088           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1089        IF ANS THEN
     1090        DO:
     1091           IF group-assign-target THEN
     1092             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1093           ELSE RUN dispatch('update-record':U).
     1094           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1095           DO:
     1096               MESSAGE "Changes to the previous record were not saved."
     1097                 VIEW-AS ALERT-BOX ERROR.
     1098               IF group-assign-target THEN
     1099                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1100               ELSE RUN dispatch ('cancel-record':U).
     1101           END.
     1102        END.
     1103        ELSE DO:
     1104          IF group-assign-target THEN
     1105             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1106          ELSE RUN dispatch('cancel-record':U).
     1107        END.
     1108        RETURN.
     1109   END PROCEDURE.
     1110   PROCEDURE get-rowid :
     1111       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1112       ASSIGN
     1113       p-table   =   adm-first-table.
     1114       RETURN.
     1115   END PROCEDURE.
     1116   PROCEDURE init-group-assign :
     1117       RUN request-attribute IN adm-broker-hdl
     1118         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1119       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1120         group-assign-target = yes.
     1121       ELSE group-assign-target = no.
     1122       RETURN.
     1123   END PROCEDURE.
     1124   PROCEDURE set-editors :
     1125       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1126       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1127       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1128       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1129       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1130       DO WHILE VALID-HANDLE (curr-widget):
     1131           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1132              curr-widget:HIDDEN = no THEN DO:
     1133             CASE p-field-setting:
     1134               WHEN "INITIALIZE":U THEN
     1135               DO:
     1136                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1137                     read-only-list +
     1138                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1139                        STRING(curr-widget).
     1140               END.
     1141               WHEN "DISABLE":U OR
     1142               WHEN "ENABLE":U THEN
     1143               DO:
     1144                   curr-widget:SENSITIVE = yes.
     1145                   RUN get-attribute ('Read-Only-Editors':U).
     1146                   IF RETURN-VALUE = ? OR
     1147                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1148                       curr-widget:READ-ONLY =
     1149                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1150               END.
     1151               WHEN "CLEAR":U THEN
     1152                   curr-widget:SCREEN-VALUE = "":U.
     1153             END CASE.
     1154           END.
     1155           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1156       END.
     1157       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1158         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1159           + '"':U).
     1160       RETURN.
     1161   END PROCEDURE.
     1162   PROCEDURE use-check-modified-all :
     1163    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1164     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1165     RETURN.
     1166   END PROCEDURE.
     1167   PROCEDURE use-create-on-add :
     1168   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1169      RETURN.
     1170   END PROCEDURE.
     1171   PROCEDURE use-initial-lock :
     1172     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1173     ASSIGN adm-initial-lock = p-attr-value.
     1174     RETURN.
     1175   END PROCEDURE.
     1176     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1177   ASSIGN
     1178          FRAME F-Main:SCROLLABLE       = FALSE
     1179          FRAME F-Main:HIDDEN           = TRUE.
     1180   if not this-procedure :persistent
     1181   then do:
     1182     message
     1183       vss-workfile vss-revision vss-description skip
     1184       "Ошибка при запуске процедуры" skip
     1185       "Данную процедуру следует запускать только с параметром persistent" skip
     1186       view-as alert-box error .
     1187     undo, return error .
     1188   end.
     1189   PROCEDURE disable_UI :
