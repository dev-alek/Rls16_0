      569   def var vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      570   function func-get-name-from-ext-type   returns char
      571     ( p-ext-type as character   ,
      572       p-caps     as logical ).
      573   define variable v-ext-name as character no-undo .
      574   run get-name-from-ext-type in this-procedure (
      575       input p-ext-type  ,
      576       input p-caps  ,
      577       output v-ext-name )
      578       no-error .
      579       if error-status :error then do:
      580          assign
      581            v-ext-name = p-ext-type
      582          .
      583       end.
      584    return (v-ext-name) .
      585   end.
      586   procedure get-name-from-ext-type :
      587    do
      588    on error undo, return error return-value
      589    :
      590   define input  parameter p-ext-type as character no-undo .
      591   define input  parameter p-caps     as logical no-undo   .
      592   define output parameter p-ext-name as character no-undo .
      593   define variable v-num as integer no-undo .
      594     if lookup ( p-ext-type , 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ) = 0 then do :
      595       message
      596         vss-include-info7 skip
      597         "Неправильно задано значение входящего параметра! "
      598         "Нет такого типа документов " p-ext-type
      599         view-as alert-box error .
      600         undo, return error .
      601     end.
      602     v-num      = lookup ( p-ext-type , 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ) .
      603     p-ext-name = entry  ( v-num , 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U ) .
      604     if p-caps  = true then do :
      605        p-ext-name = caps(substring(p-ext-name,1,1) ) + substring(p-ext-name, 2 , length (p-ext-name) - 1 ) .
      606     end .
      607     end.
      608   end procedure.
      609   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      610   procedure proc-alt-shift-f2:
      611     if not ibs.th.gbl.gbl-var:rcode
      612   then
      613     run gbl\inidebug.p .
      614   end.
      615   procedure proc-alt-shift-f3:
      616     run gbl/prvssinf.p
      617       ( input this-procedure
      618       ) .
      619   end.
      620   define variable v-inform-launched as logical no-undo initial false .
      621   procedure proc-alt-shift-f4:
      622     define variable v-action as character no-undo .
      623     if v-inform-launched = false then do:
      624       assign
      625         v-inform-launched = true
      626       .
      627       run gbl/d-inform.w
      628         (  input self
      629         ,  input this-procedure
      630         , output v-action
      631         ) no-error .
      632       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      633       assign
      634         v-inform-launched = false
      635       .
      636     end.
      637   end.
