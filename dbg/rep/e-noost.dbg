      964   PROCEDURE adm-row-changed :
      965         IF VALID-HANDLE(adm-object-hdl) THEN
      966           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      967         RUN notify ('row-available':U).
      968         RETURN.
