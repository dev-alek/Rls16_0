      975     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
      976     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
      977     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
      978     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
      979     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
      980     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
      981     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
      982     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
      983     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      984     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
      985     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      986     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
      987     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
      988     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
      989     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
      990     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
      991     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
      992     IF "":U = "":U THEN
      993       RUN modify-list-attribute IN adm-broker-hdl
      994         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
      995     RUN use-create-on-add(?).
