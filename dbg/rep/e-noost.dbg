      717   CREATE WIDGET-POOL.
      718   def var State-source as  WIDGET-HANDLE.
      719   DEFINE VARIABLE Classify AS INTEGER INITIAL 1
      720        VIEW-AS RADIO-SET VERTICAL
      721        RADIO-BUTTONS
      722             "Без классификации", 1,
      723   "По производителю", 2,
      724   "НДС по учетной цене", 3,
      725   "НДС по цене документа", 4,
      726   "НсП от цены документа", 5
      727        SIZE 28.63 BY 4.54 NO-UNDO.
      728   DEFINE RECTANGLE RECT-10
      729        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      730        SIZE 30.63 BY 16.83.
      731   DEFINE RECTANGLE RECT-12
      732        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      733        SIZE 46.5 BY 16.83.
      734   DEFINE VARIABLE ee AS LOGICAL INITIAL yes
      735        LABEL "расход внешний":L
      736        VIEW-AS TOGGLE-BOX
      737        SIZE 17.63 BY .75 NO-UNDO.
      738   DEFINE VARIABLE em AS LOGICAL INITIAL yes
      739        LABEL "расход произв.":L
      740        VIEW-AS TOGGLE-BOX
      741        SIZE 24 BY .75 NO-UNDO.
      742   DEFINE VARIABLE ep AS LOGICAL INITIAL yes
      743        LABEL "возврат поставщику"
      744        VIEW-AS TOGGLE-BOX
      745        SIZE 23.25 BY .75 NO-UNDO.
      746   DEFINE VARIABLE es AS LOGICAL INITIAL yes
      747        LABEL "касса продажа":L
      748        VIEW-AS TOGGLE-BOX
      749        SIZE 20.38 BY .75 NO-UNDO.
      750   DEFINE VARIABLE ev AS LOGICAL INITIAL yes
      751        LABEL "расход перемещение":L
      752        VIEW-AS TOGGLE-BOX
      753        SIZE 22.63 BY .75 NO-UNDO.
      754   DEFINE VARIABLE ie AS LOGICAL INITIAL yes
      755        LABEL "приход внешний":L
      756        VIEW-AS TOGGLE-BOX
      757        SIZE 22.63 BY .75 NO-UNDO.
      758   DEFINE VARIABLE im AS LOGICAL INITIAL yes
      759        LABEL "приход произв.":L
      760        VIEW-AS TOGGLE-BOX
      761        SIZE 23.25 BY .75 NO-UNDO.
      762   DEFINE VARIABLE Itog AS LOGICAL INITIAL no
      763        LABEL "Только итоги"
      764        VIEW-AS TOGGLE-BOX
      765        SIZE 28.88 BY .83 NO-UNDO.
      766   DEFINE VARIABLE iv AS LOGICAL INITIAL yes
      767        LABEL "приход перемещение":L
      768        VIEW-AS TOGGLE-BOX
      769        SIZE 26.38 BY .75 NO-UNDO.
      770   DEFINE VARIABLE ot AS LOGICAL INITIAL no
      771        LABEL "переоценка":L
      772        VIEW-AS TOGGLE-BOX
      773        SIZE 16.13 BY .75 NO-UNDO.
      774   DEFINE VARIABLE re AS LOGICAL INITIAL yes
      775        LABEL "возврат внешний":L
      776        VIEW-AS TOGGLE-BOX
      777        SIZE 18 BY .75 NO-UNDO.
      778   DEFINE VARIABLE rs AS LOGICAL INITIAL yes
      779        LABEL "касса возврат":L
      780        VIEW-AS TOGGLE-BOX
      781        SIZE 16.13 BY .75 NO-UNDO.
      782   DEFINE VARIABLE rv AS LOGICAL INITIAL yes
      783        LABEL "возврат перемещение":L
      784        VIEW-AS TOGGLE-BOX
      785        SIZE 23.25 BY .75 NO-UNDO.
      786   DEFINE VARIABLE vt AS LOGICAL INITIAL yes
      787        LABEL "инвентаризация":L
      788        VIEW-AS TOGGLE-BOX
      789        SIZE 20.38 BY .75 NO-UNDO.
      790   DEFINE VARIABLE we AS LOGICAL INITIAL yes
      791        LABEL "списание":L
      792        VIEW-AS TOGGLE-BOX
      793        SIZE 23.25 BY .75 NO-UNDO.
      794   DEFINE VARIABLE wm AS LOGICAL INITIAL yes
      795        LABEL "списан. произв.":L
      796        VIEW-AS TOGGLE-BOX
      797        SIZE 23.25 BY .75 NO-UNDO.
      798   DEFINE FRAME F-Main
      799        Itog AT ROW 7.75 COL 3.5
      800        Classify AT ROW 2.38 COL 3.13 NO-LABEL
      801        ie AT ROW 2.46 COL 49.63
      802        ee AT ROW 3.42 COL 49.63
      803        ep AT ROW 4.33 COL 49.63
      804        es AT ROW 5.25 COL 49.63
      805        re AT ROW 6.21 COL 49.63
      806        rs AT ROW 7.08 COL 49.63
      807        we AT ROW 8 COL 49.63
      808        vt AT ROW 8.79 COL 49.63
      809        iv AT ROW 9.79 COL 49.63
      810        ev AT ROW 10.75 COL 49.63
      811        rv AT ROW 11.71 COL 49.63
      812        em AT ROW 12.63 COL 49.63
      813        wm AT ROW 13.58 COL 49.63
      814        im AT ROW 14.5 COL 49.63
      815        ot AT ROW 15.42 COL 49.63
      816        "Классификация:":C15 VIEW-AS TEXT
      817             SIZE 15 BY .75 AT ROW 1.42 COL 11
      818             FGCOLOR 4
      819        "Документы:" VIEW-AS TEXT
      820             SIZE 11 BY .75 AT ROW 1.5 COL 56.38
      821             FGCOLOR 4
      822        RECT-10 AT ROW 1.13 COL 47.63
      823        RECT-12 AT ROW 1.13 COL 1
      824       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      825            SIDE-LABELS NO-UNDERLINE THREE-D
      826            AT COL 1 ROW 1 SCROLLABLE .
      827   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      828   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      829   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      830   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      831   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      832   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      833   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      834   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      835         adm-object-hdl = FRAME F-Main:HANDLE.
      836   RUN ensure-broker.
      837   THIS-PROCEDURE:ADM-DATA =
      838        'ADM1.1~`':U +
      839        'SmartObject~`':U +
      840        '~`':U +
      841        'NO ~`':U +
      842        '~`':U +
      843        '~`':U +
      844        '~`':U +
      845        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      846           + "~`":U +
      847        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
      848        'Record-Source,Record-Target,TableIO-Target~`':U +
      849        '~`':U +
      850        '~`~`~`~`~`~`~`~`~`~`~`':U +
      851        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      852            THEN "^^":U
      853        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      854             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      855   PROCEDURE adm-apply-entry :
      856     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      857   END PROCEDURE.
      858   PROCEDURE adm-destroy :
      859    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      860   END PROCEDURE.
      861   PROCEDURE adm-disable :
      862       DISABLE Itog Classify ie ee ep es re rs we vt iv ev rv em wm im RECT-10 RECT-12 WITH FRAME F-Main.
      863       RUN dispatch ('disable-fields':U).
      864       RUN set-attribute-list ('ENABLED=no':U).
      865       RETURN.
      866   END PROCEDURE.
      867   PROCEDURE adm-edit-attribute-list :
      868         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
      869         RETURN.
      870   END PROCEDURE.
      871   PROCEDURE adm-enable :
      872       ENABLE UNLESS-HIDDEN Itog Classify ie ee ep es re rs we vt iv ev rv em wm im RECT-10 RECT-12 WITH FRAME F-Main.
      873       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      874       RUN set-attribute-list ('ENABLED=yes':U).
      875       RETURN.
      876   END PROCEDURE.
      877   PROCEDURE adm-exit :
      878        RUN notify ('exit':U).
      879     RETURN.
      880   END PROCEDURE.
      881   PROCEDURE adm-hide :
      882     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      883   END PROCEDURE.
      884   PROCEDURE adm-initialize :
      885     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      886   END PROCEDURE.
      887   PROCEDURE adm-show-errors :
      888       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      889       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      890           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      891       END.
      892       RETURN.
      893   END PROCEDURE.
      894   PROCEDURE adm-UIB-mode :
      895     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      896   END PROCEDURE.
      897   PROCEDURE adm-view :
      898     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      899   END PROCEDURE.
      900   PROCEDURE dispatch :
      901       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      902       RUN broker-dispatch IN adm-broker-hdl
      903           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      904       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      905   END PROCEDURE.
      906   PROCEDURE ensure-broker :
      907   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      908   IF RETURN-VALUE NE "ADM-Broker":U THEN
      909   DO:
      910       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      911       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      912   END.
      913   END PROCEDURE.
      914   PROCEDURE get-attribute :
      915     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      916     RUN broker-get-attribute IN adm-broker-hdl
      917         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      918     RETURN RETURN-VALUE.
      919   END PROCEDURE.
      920   PROCEDURE get-attribute-list :
      921     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      922     RUN broker-get-attribute-list IN adm-broker-hdl
      923         (INPUT THIS-PROCEDURE,
      924          INPUT ?,
      925          OUTPUT p-attr-list) NO-ERROR.
      926     RETURN.
      927   END PROCEDURE.
      928   PROCEDURE new-state :
      929     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      930     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      931     RETURN.
      932   END PROCEDURE.
      933   PROCEDURE notify :
      934     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      935     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      936     IF RETURN-VALUE = "ADM-ERROR":U THEN
      937         RETURN "ADM-ERROR":U.
      938     RETURN.
      939   END PROCEDURE.
      940   PROCEDURE set-attribute-list :
      941     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      942     RUN ensure-broker.
      943     RUN broker-set-attribute-list IN adm-broker-hdl
      944         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      945     RETURN.
      946   END PROCEDURE.
      947   PROCEDURE set-position :
      948       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      949       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      950       IF VALID-HANDLE(adm-object-hdl) THEN
      951       DO:
      952         ASSIGN adm-object-hdl:ROW    =   p-row
      953                adm-object-hdl:COLUMN =   p-col.
      954       END.
      955       RETURN.
      956   END PROCEDURE.
      957   PROCEDURE adm-display-fields :
      958       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
      959       RETURN.
