     1237   PROCEDURE no-benq.
     1238   DEFINE OUTPUT PARAMETER found as logical init no.
     1239   define buffer buf_chk-doc for ub.chk-doc.
     1240   FOR EACH obj-list WHERE
     1241           obj-list.obj-type = 'маг':U NO-LOCK :
     1242     CASE X-Radio-Task > 1 :
     1243       WHEN YES THEN DO:
     1244         FOR EACH buf_chk-doc NO-LOCK WHERE
     1245                 buf_chk-doc.obj-type = obj-list.obj-type AND
     1246                 buf_chk-doc.obj-code = obj-list.obj-code AND
     1247                 (
     1248                   buf_chk-doc.shift-date >= X-date-start AND
     1249                   buf_chk-doc.shift-date <= X-date-end)
     1250                   AND
     1251                   (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1252           IF X-Radio-Task = 3 AND
     1253           ((buf_chk-doc.shift-date = X-date-start AND buf_chk-doc.shift-num < X-shift-Start) OR
     1254             (buf_chk-doc.shift-date = X-date-end AND  buf_chk-doc.shift-num > X-shift-End) ) THEN NEXT.
     1255           IF X-Radio-Task = 4 AND
     1256           (buf_chk-doc.shift-num <> X-shift-Alone ) THEN NEXT.
     1257           found = yes.
     1258           return.
     1259         END.
     1260       END.
     1261       WHEN NO THEN DO:
     1262         FOR EACH buf_chk-doc NO-LOCK WHERE
     1263               buf_chk-doc.obj-type = obj-list.obj-type AND
     1264               buf_chk-doc.obj-code = obj-list.obj-code AND
     1265               buf_chk-doc.chk-date >= X-date-start AND
     1266               buf_chk-doc.chk-date <= X-date-end   AND
     1267               (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1268           found = yes.
     1269           return.
     1270         END.
     1271        END.
     1272      END CASE.
     1273    END.
     1274   END PROCEDURE.
     1275   PROCEDURE no-benqi.
     1276   DEFINE OUTPUT PARAMETER found as logical init no.
     1277   define buffer buf_chk-doc for ub.chk-doc.
     1278   define buffer buf_inkas for ub.inkas.
     1279   FOR EACH obj-list WHERE
     1280         obj-list.obj-type = 'маг':U NO-LOCK :
     1281     CASE X-Radio-Task > 1 :
     1282       WHEN YES THEN DO:
     1283         FOR EACH buf_chk-doc No-LOCK WHERE
     1284                 buf_chk-doc.obj-type = obj-list.obj-type AND
     1285                 buf_chk-doc.obj-code = obj-list.obj-code AND
     1286                 (
     1287                   buf_chk-doc.shift-date >= X-date-start AND
     1288                   buf_chk-doc.shift-date <= X-date-end)
     1289                   AND
     1290                   buf_Chk-doc.out-code = ? AND
     1291                   (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1292           IF X-Radio-Task = 3 AND
     1293           ((buf_chk-doc.shift-date = X-date-start AND buf_chk-doc.shift-num < X-shift-Start) OR
     1294             (buf_chk-doc.shift-date = X-date-end AND  buf_chk-doc.shift-num > X-shift-End) ) THEN NEXT.
     1295           IF X-Radio-Task = 4 AND
     1296           (buf_chk-doc.shift-num <> X-shift-Alone ) THEN NEXT.
     1297           found = yes.
     1298           return.
     1299         END.
     1300         FOR EACH buf_inkas No-LOCK WHERE
     1301                   buf_inkas.obj-type = obj-list.obj-type AND
     1302                   buf_inkas.obj-code = obj-list.obj-code AND
     1303                   (
     1304                   buf_inkas.shift-date >= X-date-start AND
     1305                   buf_inkas.shift-date <= X-date-end):
     1306           if buf_inkas.status_ = 'факт':U
     1307           or buf_inkas.status_ = 'запрос':U then next.
     1308           IF X-Radio-Task = 3 AND
     1309           ((buf_inkas.shift-date = X-date-start AND buf_inkas.shift-num < X-shift-Start) OR
     1310             (buf_inkas.shift-date = X-date-end AND  buf_inkas.shift-num > X-shift-End) ) THEN NEXT.
     1311           IF X-Radio-Task = 4 AND
     1312           (buf_inkas.shift-num <> X-shift-Alone ) THEN NEXT.
     1313           found = yes.
     1314           return.
     1315         END.
     1316       END.
     1317       WHEN NO THEN DO:
     1318         FOR EACH buf_chk-doc NO-LOCK WHERE
     1319                 buf_chk-doc.obj-type = obj-list.obj-type AND
     1320                 buf_chk-doc.obj-code = obj-list.obj-code AND
     1321                 buf_chk-doc.chk-date >= X-date-start AND
     1322                 buf_chk-doc.chk-date <= X-date-end   AND
     1323                 buf_Chk-doc.out-code = ? AND
     1324                 (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1325           found = yes.
     1326           return.
     1327         END.
     1328         FOR EACH buf_inkas NO-LOCK WHERE
     1329                 buf_inkas.obj-type = obj-list.obj-type AND
     1330                 buf_inkas.obj-code = obj-list.obj-code AND
     1331                 buf_inkas.doc-date >= X-date-start AND
     1332                 buf_inkas.doc-date <= X-date-end :
     1333           if buf_inkas.status_ = 'факт':U
     1334           or buf_inkas.status_ = 'запрос':U then next.
     1335           found = yes.
     1336           return.
     1337         END.
     1338       END.
     1339     END CASE.
     1340   END.
     1341   END PROCEDURE.
