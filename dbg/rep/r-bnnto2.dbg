     1414            AND  buf_sale-doc.status_ = 'факт':U
     1415            AND  buf_sale-doc.chr-office = 'у':U
     1416            AND  buf_sale-doc.doc-date >= X-date-start
     1417            AND  buf_sale-doc.doc-date <= X-date-end :
