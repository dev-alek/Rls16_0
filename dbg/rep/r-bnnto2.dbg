     1514   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1515   procedure cur-time :
     1516      define output parameter p-today as date      no-undo .
     1517      define output parameter p-time  as integer   no-undo .
     1518     do
     1519     on error undo, return error
     1520     :
     1521       define variable v-date1 as date      no-undo .
     1522       define variable v-date2 as date      no-undo .
     1523       define variable v-time  as integer   no-undo .
     1524       assign
     1525         v-date1 = today
     1526         v-time  = time
     1527         v-date2 = today
     1528       .
     1529       if v-date1 <> v-date2
     1530       then do:
     1531         assign
     1532           v-date1 = today
     1533           v-time  = v-time
     1534         .
     1535       end.
     1536       assign
     1537         p-today = v-date1
     1538         p-time  = v-time
     1539       .
     1540     end.
     1541   end.
     1542   function cur-time-date returns character
     1543   :
     1544     return string(today, '99/99/9999':U) .
     1545   end.
     1546   function cur-time-mjd returns decimal
     1547   :
     1548     define variable v-date as date      no-undo .
     1549     define variable v-time as integer   no-undo .
     1550     run cur-time in this-procedure
     1551       (output v-date
     1552       ,output v-time
     1553       ) .
     1554     return integer(v-date) - 2400002 + (v-time / 86400) .
     1555   end.
     1556   function cur-time-get-ending-index returns integer
     1557   (input p-number as integer
     1558   )
     1559   :
     1560     if p-number < 0
     1561     or p-number = ?
     1562     then do:
     1563       return 1 .
     1564     end.
     1565     define variable v-rest as integer   no-undo .
     1566     assign
     1567       p-number = p-number modulo 100
     1568     .
     1569     if p-number < 20
     1570     then do:
     1571       assign
     1572         v-rest = p-number
     1573       .
     1574     end.
     1575     else do:
     1576       assign
     1577         v-rest = p-number modulo 10
     1578       .
     1579     end.
     1580     case v-rest :
     1581       when 1
     1582       then do:
     1583         return 2 .
     1584       end.
     1585       when 2 or
     1586       when 3 or
     1587       when 4
     1588       then do:
     1589         return 3 .
     1590       end.
     1591       otherwise do:
     1592         return 1 .
     1593       end.
     1594     end case .
     1595   end.
     1596   procedure cur-time-mjd-to-date :
     1597      define input  parameter i-mjd-diff as decimal no-undo.
     1598      define output parameter o-Date     as date    no-undo.
     1599      define output parameter o-Time     as integer no-undo.
     1600      define variable v-day-number as integer   no-undo .
     1601      if    i-mjd-diff < 0
     1602         or i-mjd-diff = ?
     1603      then do:
     1604         return "?" .
     1605      end.
     1606      assign
     1607         v-day-number = truncate(i-mjd-diff,0).
     1608         o-Date = date(v-day-number + 2400002).
     1609         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1610     .
     1611   end.
     1612   function cur-time-mjd-to-string returns character
     1613   (input p-mjd-diff as decimal
     1614   )
     1615   :
     1616     define variable v-day-number as integer   no-undo .
     1617     define variable v-seconds    as integer   no-undo .
     1618     define variable v-hour       as integer   no-undo .
     1619     define variable v-min        as integer   no-undo .
     1620     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1621     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1622     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1623     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1624     if p-mjd-diff < 0
     1625     or p-mjd-diff = ?
     1626     then do:
     1627       return "?" .
     1628     end.
     1629     assign
     1630       v-day-number = integer(truncate(p-mjd-diff,0))
     1631       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1632     .
     1633     if v-seconds > 86400
     1634     then do:
     1635       assign
     1636         v-seconds = 86400 - 1
     1637       .
     1638     end.
     1639     if v-seconds < 0
     1640     then do:
     1641       assign
     1642         v-seconds = 0
     1643       .
     1644     end.
     1645     assign
     1646       v-hour = truncate(v-seconds / 3600, 0)
     1647     .
     1648     assign
     1649       v-seconds = v-seconds modulo 3600
     1650     .
     1651     assign
     1652       v-min = truncate(v-seconds / 60, 0)
     1653     .
     1654     assign
     1655       v-seconds = v-seconds modulo 60
     1656     .
     1657     return
     1658         (if v-day-number <> 0
     1659           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1660           else ""
     1661         )
     1662       + (if v-day-number <> 0 or v-hour <> 0
     1663           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1664           else ""
     1665         )
     1666       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1667           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1668           else ""
     1669         )
     1670       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1671       .
     1672   end.
     1673   function cur-time-string returns character
     1674   :
     1675     define variable v-date as date      no-undo .
     1676     define variable v-time as integer   no-undo .
     1677     run cur-time in this-procedure
     1678       (output v-date
     1679       ,output v-time
     1680       ) .
     1681     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1682   end.
     1683   function cur-time-string-sec returns character
     1684   :
     1685     define variable v-date as date      no-undo .
     1686     define variable v-time as integer   no-undo .
     1687     run cur-time in this-procedure
     1688       (output v-date
     1689       ,output v-time
     1690       ) .
     1691     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1692   end.
     1693   function cur-time-custom  returns character
     1694   (input p-prefix as character
     1695   ,input p-date-format as character
     1696   ,input p-delimiter as character
     1697   ,input p-time-format as character
     1698   ,input p-suffix as character
     1699   )
     1700   :
     1701     define variable v-date as date      no-undo .
     1702     define variable v-time as integer   no-undo .
     1703     run cur-time in this-procedure
     1704       (output v-date
     1705       ,output v-time
     1706       ) .
     1707     return
     1708       p-prefix
     1709       + string(v-date, p-date-format)
     1710       + p-delimiter
     1711       + string(v-time, p-time-format)
     1712       + p-suffix
     1713       .
     1714   end.
     1715   function cur-time-print  returns character
     1716   :
     1717     define variable v-date as date      no-undo .
     1718     define variable v-time as integer   no-undo .
     1719     run cur-time in this-procedure
     1720       (output v-date
     1721       ,output v-time
     1722       ) .
     1723     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1724   end.
     1725   function cur-time-datetime returns datetime
     1726   :
     1727     define variable v-char as character no-undo .
     1728     define variable v-datetime as datetime no-undo .
     1729     v-char = cur-time-string().
     1730     v-datetime = datetime(v-char).
     1731     return  v-datetime.
     1732   end.
     1733   function cur-time-string-msec returns character
     1734   :
     1735     define variable v-date as datetime  no-undo .
     1736     v-date = now.
     1737     return string(v-date) .
     1738   end.
     1739   function fnc-convert-dot-to-colon returns character
     1740       (input p-data as decimal, input p-accur as character, input p-num as integer) forward.
     1741   function fnc-convert-dot-to-colon returns character
     1742   (input p-data as decimal, input p-accur as character, input p-num as integer):
     1743       define variable result as character no-undo.
     1744       define variable v-str-result as character no-undo.
     1745       if p-data = ? then p-data = 0 .
     1746       p-data = round(p-data, p-num).
     1747       v-str-result = trim(replace(string(p-data, p-accur), ".", ",")).
     1748       return v-str-result.
     1749   END FUNCTION.
     1750   function putRowAmount1 returns character private
     1751   (input p-curr-name as character
     1752   ,input p-total1    as decimal
     1753   ) :
     1754   define variable v-row-amount as character no-undo .
     1755   define variable v-curr-name  as character no-undo .
     1756     v-curr-name = if p-curr-name > "" then p-curr-name else "<br />":U .
     1757     v-row-amount = substitute (
     1758         '<td>&1</td><td num="0.00" val="&2">&2</td><td><br /></td><td><br /></td>'
     1759         , v-curr-name
     1760         , fnc-convert-dot-to-colon(p-total1, "->>>>>>>>>>>9.99", 2)
     1761     ) .
     1762     return v-row-amount .
     1763   end function .
     1764   function putRowAmount returns character private
     1765   (input p-curr-name as character
     1766   ,input p-total1    as decimal
     1767   ,input p-total2    as decimal
     1768   ,input p-total3    as decimal
     1769   ) :
     1770   define variable v-row-amount as character no-undo .
     1771   define variable v-curr-name  as character no-undo .
     1772     v-curr-name = if p-curr-name > "" then p-curr-name else "<br />":U .
     1773     v-row-amount = substitute (
     1774         '<td>&1</td><td num="0.00" val="&2">&2</td><td num="0.00" val="&3">&3</td><td num="0.00" val="&4">&4</td>'
     1775         , v-curr-name
     1776         , fnc-convert-dot-to-colon(p-total1, "->>>>>>>>>>>9.99", 2)
     1777         , fnc-convert-dot-to-colon(p-total2, "->>>>>>>>>>>9.99", 2)
     1778         , fnc-convert-dot-to-colon(p-total3, "->>>>>>>>>>>9.99", 2)
     1779     ) .
     1780     return v-row-amount .
     1781   end function .
     1782   procedure CreateBenefits2 private :
     1783   define input parameter p-obj-type  as character no-undo .
     1784   define input parameter p-obj-code  as integer no-undo .
     1785   define input parameter p-pay-code  as integer no-undo .
     1786   define input parameter p-curr-code as integer no-undo .
     1787   define input parameter p-pay-desk  as integer no-undo .
     1788   define input parameter p-sum       as decimal no-undo .
     1789   define input parameter p-base      as decimal no-undo .
     1790   define input parameter p-rubl      as decimal no-undo .
     1791   define buffer buf_benefits for benefits .
     1792   define buffer buf_cash-pay for ub.cash-pay .
     1793   define buffer buf_currency for ub.currency .
     1794     find first buf_benefits
     1795          where buf_benefits.obj-type  = p-obj-type
     1796            and buf_benefits.obj-code  = p-obj-code
     1797            and buf_benefits.pay-code  = p-pay-code
     1798            and buf_benefits.curr-code = p-curr-code
     1799     and buf_benefits.pay-desk  = p-pay-desk no-error .
     1800     if not available buf_benefits then do:
     1801       FIND FIRST buf_cash-pay NO-LOCK
     1802            WHERE buf_cash-pay.cdpay-code = p-pay-code
     1803              AND buf_cash-pay.curr-code  = p-curr-code NO-ERROR.
     1804       FIND FIRST buf_currency NO-LOCK
     1805            WHERE buf_currency.curr-code = p-curr-code NO-ERROR.
     1806       create buf_benefits.
     1807       assign
     1808         buf_benefits.pay-desk  = p-pay-desk
     1809         buf_benefits.obj-type  = p-obj-type
     1810         buf_benefits.obj-code  = p-obj-code
     1811         buf_benefits.pay-code  = p-pay-code
     1812         buf_benefits.pay-name  = if available buf_cash-pay then buf_cash-pay.obj-name  else "Неопознанная оплата"
     1813         buf_benefits.curr-code = p-curr-code
     1814         buf_benefits.curr-name = if available buf_currency then buf_currency.curr-name else "Неопознанная валюта"
     1815         buf_benefits.tot-sum   = p-sum
     1816         buf_benefits.tot-base  = p-base
     1817         buf_benefits.tot-rubl  = p-rubl
     1818       .
     1819     end .
     1820     else assign
     1821       buf_benefits.tot-sum  = buf_benefits.tot-sum  + p-sum
     1822       buf_benefits.tot-base = buf_benefits.tot-base + p-base
     1823       buf_benefits.tot-rubl = buf_benefits.tot-rubl + p-rubl
     1824     .
     1825   end procedure .
     1826   empty temp-table benefits .
     1827   empty temp-table inkas-num .
     1828   empty temp-table day_sum .
     1829   empty temp-table all-days_sum .
     1830   empty temp-table ben-chk-count .
     1831   assign
     1832   date_string = cur-time-print()
     1833   .
     1834   assign
     1835   ChkAmount = 0
     1836   ObjAmount = 0
     1837   AllDay-BaseSum = 0
     1838   AllDay-RublSum = 0
     1839     acc-count-ln = 0
     1840     acc-count-step = 0
     1841   .
     1842   FOR EACH obj-list WHERE obj-list.obj-type = 'маг':U NO-LOCK :
     1843     ACCUMULATE obj-list.obj-code ( COUNT ).
     1844     assign
     1845     acc-day-base = 0
     1846     acc-day-rubl = 0
     1847     acc-day-cnt = 0
     1848     acc-day-nf  = 0
     1849     .
     1850     CASE X-radio-Task > 1 :
     1851       WHEN YES THEN DO:
     1852         _chk-doc3:
     1853         FOR EACH chk-doc WHERE
     1854                   chk-doc.obj-type = obj-list.obj-type AND
     1855                 chk-doc.obj-code = obj-list.obj-code AND
     1856                 chk-doc.shift-date >= x-date-start AND
     1857                 chk-doc.shift-date <= x-date-end AND
     1858                 (IF cas-num > 0 then chk-doc.pay-desk = cas-num else TRUE) NO-LOCK
     1859         BREAK
     1860         by chk-doc.obj-type
     1861         by chk-doc.obj-code
     1862         by chk-doc.pay-desk :
     1863           IF FIRST-OF(chk-doc.pay-desk) then assign
     1864             acc-desk-rubl = 0
     1865             acc-desk-base = 0
     1866             acc-desk-count = 0
     1867             acc-desk-count-nf = 0
     1868           .
     1869           v-skip-line =
     1870           (
     1871                X-Radio-task = 3 AND
     1872                ((chk-doc.shift-date = x-date-start AND chk-doc.shift-num < X-shift-start) OR
     1873                 (chk-doc.shift-date = x-date-end   AND chk-doc.shift-num > X-shift-end))
     1874           ) OR (
     1875                X-radio-task = 4 AND
     1876                chk-doc.shift-num <> X-Shift-Alone
     1877           ) .
     1878           if not v-skip-line then do :
     1879             v-is-sub-count = (  lookup(string(chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0  ).
     1880             found = false .
     1881             if v-is-sub-count then do :
     1882               for EACH chk-pay NO-LOCK
     1883                  WHERE chk-pay.doc-code = chk-doc.doc-code :
     1884                 if chk-pay.tot-sum <> 0 then do :
     1885                   found = true .
     1886                   leave .
     1887                 end .
     1888               END .
     1889             end .
     1890             else do :
     1891               for EACH chk-pay NO-LOCK
     1892                  WHERE chk-pay.doc-code = chk-doc.doc-code
     1893               BREAK
     1894               BY chk-pay.pay-code
     1895               BY chk-pay.curr-code:
     1896                 if chk-pay.tot-sum <> 0 then do :
     1897                   found = true .
     1898   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1899           acc-count-ln = acc-count-ln + 1.
     1900   if acc-count-ln > acc-count-step then do:
     1901     run waitfram-show in this-procedure ( obj-list.obj-type + string( obj-list.obj-code ) +
     1902                                     ", обработано строк чеков : " +
     1903                                     string( ACC-count-ln) ) .
     1904     acc-count-step = acc-count-ln + 96 .
     1905   end.
     1906           if FIRST-of( chk-pay.curr-code ) then assign
     1907             acc-curr-sum  = 0
     1908             acc-curr-base = 0
     1909             acc-curr-rubl = 0
     1910           .
     1911         assign
     1912             acc-curr-sum  = acc-curr-sum  + chk-pay.tot-sum
     1913             acc-curr-base = acc-curr-base + chk-pay.tot-base
     1914             acc-curr-rubl = acc-curr-rubl + chk-pay.tot-rubl
     1915             acc-desk-base = acc-desk-base + chk-pay.tot-base
     1916             acc-desk-rubl = acc-desk-rubl + chk-pay.tot-rubl
     1917         .
     1918   if last-of( chk-pay.curr-code ) then do:
     1919     run CreateBenefits2 in this-procedure
     1920     ( obj-list.obj-type
     1921     , obj-list.obj-code
     1922     , chk-pay.pay-code
     1923     , chk-pay.curr-code
     1924     , chk-doc.pay-desk
     1925     , acc-curr-sum
     1926     , acc-curr-base
     1927     , acc-curr-rubl
     1928     ) .
     1929     if not can-find (first ben-chk-count where ben-chk-count.doc-code  = chk-pay.doc-code
     1930                                            and ben-chk-count.obj-type  = obj-list.obj-type
     1931                                            and ben-chk-count.obj-code  = obj-list.obj-code
     1932                                            and ben-chk-count.pay-desk  = chk-doc.pay-desk
     1933                                            and ben-chk-count.pay-code  = chk-pay.pay-code
     1934                                            and ben-chk-count.curr-code = chk-pay.curr-code) then do:
     1935       create ben-chk-count.
     1936       assign
     1937         ben-chk-count.doc-code  = chk-pay.doc-code
     1938         ben-chk-count.obj-type  = obj-list.obj-type
     1939         ben-chk-count.obj-code  = obj-list.obj-code
     1940         ben-chk-count.pay-desk  = chk-doc.pay-desk
     1941         ben-chk-count.pay-code  = chk-pay.pay-code
     1942         ben-chk-count.curr-code = chk-pay.curr-code
     1943       .
     1944     end.
     1945   end.
     1946                 end .
     1947               END .
     1948             end .
     1949             if found then assign
     1950               acc-desk-count    = acc-desk-count    + 1
     1951               acc-desk-count-nf = acc-desk-count-nf + 1 when (v-is-sub-count)
     1952             .
     1953           end .
     1954           if last-of( chk-doc.pay-desk ) then do:
     1955             create day_sum.
     1956             assign
     1957               day_sum.obj-type = obj-list.obj-type
     1958               day_sum.obj-code = obj-list.obj-code
     1959               day_sum.pay-desk = chk-doc.pay-desk
     1960               day_sum.tot-rubl = acc-desk-rubl
     1961               day_sum.tot-base = acc-desk-base
     1962               day_sum.chk-cnt-all =  acc-desk-count
     1963               day_sum.chk-cnt-nf  =  acc-desk-count-nf
     1964             .
     1965             assign
     1966               acc-day-rubl = acc-day-rubl + day_sum.tot-rubl
     1967               acc-day-base = acc-day-base + day_sum.tot-base
     1968               acc-day-cnt  = acc-day-cnt  + day_sum.chk-cnt-all
     1969               acc-day-nf   = acc-day-nf   + day_sum.chk-cnt-nf
     1970             .
     1971           end.
     1972         END.
     1973       END.
     1974       WHEN NO THEN DO:
     1975         _chk-doc4:
     1976         FOR EACH chk-doc WHERE
     1977                     chk-doc.obj-type = obj-list.obj-type AND
     1978                   chk-doc.obj-code = obj-list.obj-code AND
     1979                   chk-doc.chk-date >= x-date-start AND
     1980                   chk-doc.chk-date <= x-date-end AND
     1981                   (IF cas-num > 0 then chk-doc.pay-desk = cas-num else TRUE) NO-LOCK
     1982           BREAK
     1983           by chk-doc.obj-type
     1984           by chk-doc.obj-code
     1985           by chk-doc.pay-desk :
     1986           IF FIRST-OF(chk-doc.pay-desk) then assign
     1987             acc-desk-rubl = 0
     1988             acc-desk-base = 0
     1989             acc-desk-count = 0
     1990             acc-desk-count-nf = 0
     1991           .
     1992           v-skip-line = false .
     1993           if not v-skip-line then do :
     1994             v-is-sub-count = (  lookup(string(chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0  ).
     1995             found = false .
     1996             if v-is-sub-count then do :
     1997               for EACH chk-pay NO-LOCK
     1998                  WHERE chk-pay.doc-code = chk-doc.doc-code :
     1999                 if chk-pay.tot-sum <> 0 then do :
     2000                   found = true .
     2001                   leave .
     2002                 end .
     2003               END .
     2004             end .
     2005             else do :
     2006               for EACH chk-pay NO-LOCK
     2007                  WHERE chk-pay.doc-code = chk-doc.doc-code
     2008               BREAK
     2009               BY chk-pay.pay-code
     2010               BY chk-pay.curr-code:
     2011                 if chk-pay.tot-sum <> 0 then do :
     2012                   found = true .
     2013   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2014           acc-count-ln = acc-count-ln + 1.
     2015   if acc-count-ln > acc-count-step then do:
     2016     run waitfram-show in this-procedure ( obj-list.obj-type + string( obj-list.obj-code ) +
     2017                                     ", обработано строк чеков : " +
     2018                                     string( ACC-count-ln) ) .
     2019     acc-count-step = acc-count-ln + 96 .
     2020   end.
     2021           if FIRST-of( chk-pay.curr-code ) then assign
     2022             acc-curr-sum  = 0
     2023             acc-curr-base = 0
     2024             acc-curr-rubl = 0
     2025           .
     2026         assign
     2027             acc-curr-sum  = acc-curr-sum  + chk-pay.tot-sum
     2028             acc-curr-base = acc-curr-base + chk-pay.tot-base
     2029             acc-curr-rubl = acc-curr-rubl + chk-pay.tot-rubl
     2030             acc-desk-base = acc-desk-base + chk-pay.tot-base
     2031             acc-desk-rubl = acc-desk-rubl + chk-pay.tot-rubl
     2032         .
     2033   if last-of( chk-pay.curr-code ) then do:
     2034     run CreateBenefits2 in this-procedure
     2035     ( obj-list.obj-type
     2036     , obj-list.obj-code
     2037     , chk-pay.pay-code
     2038     , chk-pay.curr-code
     2039     , chk-doc.pay-desk
     2040     , acc-curr-sum
     2041     , acc-curr-base
     2042     , acc-curr-rubl
     2043     ) .
     2044     if not can-find (first ben-chk-count where ben-chk-count.doc-code  = chk-pay.doc-code
     2045                                            and ben-chk-count.obj-type  = obj-list.obj-type
     2046                                            and ben-chk-count.obj-code  = obj-list.obj-code
     2047                                            and ben-chk-count.pay-desk  = chk-doc.pay-desk
     2048                                            and ben-chk-count.pay-code  = chk-pay.pay-code
     2049                                            and ben-chk-count.curr-code = chk-pay.curr-code) then do:
     2050       create ben-chk-count.
     2051       assign
     2052         ben-chk-count.doc-code  = chk-pay.doc-code
     2053         ben-chk-count.obj-type  = obj-list.obj-type
     2054         ben-chk-count.obj-code  = obj-list.obj-code
     2055         ben-chk-count.pay-desk  = chk-doc.pay-desk
     2056         ben-chk-count.pay-code  = chk-pay.pay-code
     2057         ben-chk-count.curr-code = chk-pay.curr-code
     2058       .
     2059     end.
     2060   end.
     2061                 end .
     2062               END .
     2063             end .
     2064             if found then assign
     2065               acc-desk-count    = acc-desk-count    + 1
     2066               acc-desk-count-nf = acc-desk-count-nf + 1 when (v-is-sub-count)
     2067             .
     2068           end .
     2069           if last-of( chk-doc.pay-desk ) then do:
     2070             create day_sum.
     2071             assign
     2072               day_sum.obj-type = obj-list.obj-type
     2073               day_sum.obj-code = obj-list.obj-code
     2074               day_sum.pay-desk = chk-doc.pay-desk
     2075               day_sum.tot-rubl = acc-desk-rubl
     2076               day_sum.tot-base = acc-desk-base
     2077               day_sum.chk-cnt-all =  acc-desk-count
     2078               day_sum.chk-cnt-nf  =  acc-desk-count-nf
     2079             .
     2080             assign
     2081               acc-day-rubl = acc-day-rubl + day_sum.tot-rubl
     2082               acc-day-base = acc-day-base + day_sum.tot-base
     2083               acc-day-cnt  = acc-day-cnt  + day_sum.chk-cnt-all
     2084               acc-day-nf   = acc-day-nf   + day_sum.chk-cnt-nf
     2085             .
     2086           end.
     2087         END.
     2088       END.
     2089     END CASE.
     2090     CREATE all-days_sum .
     2091     assign
     2092       all-days_sum.obj-type = obj-list.obj-type
     2093       all-days_sum.obj-code = obj-list.obj-code
     2094       all-days_sum.tot-base = acc-day-base
     2095       all-days_sum.tot-rubl = acc-day-rubl
     2096       all-days_sum.chk-cnt-all  = acc-day-cnt
     2097       all-days_sum.chk-cnt-nf   = acc-day-nf
     2098     .
     2099     assign
     2100       AllDay-BaseSum = AllDay-BaseSum + acc-day-base
     2101       AllDay-RublSum = AllDay-RublSum + acc-day-rubl
     2102       ObjAmount      = ObjAmount + 1
     2103       ChkAmount      = ChkAmount + (all-days_sum.chk-cnt-all - all-days_sum.chk-cnt-nf)
     2104     .
     2105   END.
     2106   if not can-find (first benefits) then do:
     2107     message "Не было никакой выручки на выбранных объектах в течение заданного Вами периода времени." view-as alert-box information .
     2108     return.
     2109   end.
     2110   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2111   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2112     (output v-curr-r-b
     2113     )  .
     2114   if v-curr-r-b = 'base':U then do:
     2115   sale-price-type = base-type.
     2116   end.
     2117   else sale-price-type = "рублей".
     2118   for each benefits :
     2119     benefits.tot-r-b = if v-curr-r-b = 'base':U then benefits.tot-base else benefits.tot-rubl .
     2120   end .
     2121   for each day_sum :
     2122     day_sum.tot-r-b = if v-curr-r-b = 'base':U then day_sum.tot-base else day_sum.tot-rubl .
     2123   end .
     2124   for each all-days_sum :
     2125     all-days_sum.tot-r-b = if v-curr-r-b = 'rubl':U then all-days_sum.tot-rubl else all-days_sum.tot-base .
     2126   end .
     2127   run waitfram-hide in this-procedure .
     2128       run prn-lib-get-report-name  in this-procedure (
     2129                                                          input parParentProc
     2130                                                         ,output v-report-name
     2131                                                       ).
     2132     assign
     2133       v-file-name-rep-htm = v-report-name + ".html"
     2134       v-vsex-cas = IF cas-num = 0 then "ВСЕХ КАСС" ELSE ("КАССЫ " + string(cas-num))
     2135       v-avg-chk  = if ChkAmount > 0 then round(
     2136         (if v-curr-r-b = 'rubl':U then AllDay-RublSum else AllDay-BaseSum)  /  ChkAmount
     2137                                                , 2 ) else 0
     2138     .
     2139     v-times = "" .
     2140     IF T-time then
     2141       FOR EACH times No-LOCK :
     2142         v-times = v-times + times + chr(32) .
     2143       END .
     2144   do :
     2145     output stream OutStr-html to value(v-file-name-rep-htm) convert target 'UTF-8' .
     2146     put stream OutStr-html unformatted
     2147       "<!DOCTYPE HTML>" skip
     2148       '<html>' skip
     2149       '<head>' skip
     2150       '  <meta charset="utf-8">' skip
     2151       '  <style type="text/css">' skip
     2152       '      table ~{border-collapse: collapse~;~}' skip
     2153       '      tbody td, th ~{border: 1px solid black~; height: 14px~;}' skip
     2154       '      tbody td:nth-child(4), tbody td:nth-child(5), tbody td:nth-child(6) ~{text-align: right~; padding-right: 4px~;~}' skip
     2155       '      tfoot td ~{height: 14px~;}' skip
     2156       '      .sumtotal ~{text-align: right~; padding-right: 4px~;~}' skip
     2157       '  </style>' skip
     2158       '</head>' skip
     2159       '<body>' skip
     2160       '<TABLE name="1" fit_to_page="true" orientation="portrait">' skip
     2161       '<thead>' skip
     2162       '  <tr>' skip
     2163       '    <td style="width:  35px;"></td>' skip
     2164       '    <td style="width: 124px;"></td>' skip
     2165       '    <td style="width: 31px;"></td>' skip
     2166       '    <td style="width: 71px;"></td>' skip
     2167       '    <td style="width: 63px;"></td>' skip
     2168       '    <td style="width: 63px;"></td>' skip
     2169       '    <td style="width: 49px;"></td>' skip
     2170       '    <td style="width: 41px;"></td>' skip
     2171       '  </tr>' skip
     2172       '  <tr>' skip
     2173       '    <td colspan="8">' + date_string + '</td>' skip
     2174       '  </tr>' skip
     2175       '  <tr>' skip
     2176       '    <td colspan="8">ОТЧЕТ  О  ВЫРУЧКЕ ' + str1
     2177            + '<br />' + str4
     2178            + '<br />( сформирован по ВСЕМ ЧЕКАМ '
     2179            + (IF NotInc then v-vsex-cas + ", включая невошедшие в отчеты о продажах" else v-vsex-cas)
     2180            + ' )'
     2181            + '<br />'
     2182            + substitute("( всего чеков : &1, в среднем &2 &3 / чек )",  ChkAmount,  v-avg-chk,  sale-price-type  )
     2183            + '</td>' skip
     2184       '  </tr>' skip
     2185     .
     2186     IF T-time then do:
     2187       put stream OutStr-html unformatted
     2188         '  <tr>' skip
     2189         '    <td colspan="7">Выборочно по времени: '
     2190            + v-times
     2191            + '</td>' skip
     2192         '  </tr>' skip
     2193       .
     2194     end.
     2195     put stream OutStr-html unformatted
     2196       '</thead>' skip
     2197       '<tbody>' skip
     2198       '  <tr>' skip
     2199       '    <th>Касса</th>' skip
     2200       '    <th>Вид оплаты</th>' skip
     2201       '    <th>Валюта продаж</th>' skip
     2202       '    <th>Сумма в валюте продаж</th>' skip
     2203       '    <th>Сумма в Б.Вал.</th>' skip
     2204       '    <th>Сумма в рублях</th>' skip
     2205       '    <th>~% от суммы</th>' skip
     2206       '    <th>Кол-во фиск. чеков</th>' skip
     2207       '  </tr>' skip
     2208     .
     2209   end .
     2210   FOR EACH obj-list WHERE
     2211             obj-list.obj-type = 'маг':U ,
     2212       EACH all-days_sum WHERE
     2213             all-days_sum.obj-type = obj-list.obj-type AND
     2214             all-days_sum.obj-code = obj-list.obj-code
     2215   BREAK
     2216   BY obj-list.obj-type
     2217   BY obj-list.obj-code :
     2218     ACCUMULATE
     2219     all-days_sum.tot-base ( TOTAL )
     2220     all-days_sum.tot-rubl ( TOTAL )
     2221     all-days_sum.tot-r-b ( TOTAL )
     2222     all-days_sum.chk-cnt-all ( TOTAL )
     2223     all-days_sum.chk-cnt-nf  ( TOTAL )
     2224     obj-list.obj-code ( COUNT ) .
     2225       if first-of( obj-list.obj-code ) then do:
     2226         FIND FIRST clients WHERE
     2227                      clients.obj-type = obj-list.obj-type  AND
     2228                      clients.obj-code = obj-list.obj-code  NO-LOCK no-error .
     2229         put stream OutStr-html unformatted
     2230             '  <tr><td colspan="8">'
     2231             if available clients then clients.obj-name else '<br />'
     2232             '</td></tr>'
     2233         .
     2234       end.
     2235     FOR EACH benefits WHERE
     2236                 benefits.obj-type = obj-list.obj-type AND
     2237                 benefits.obj-code = obj-list.obj-code
     2238     BREAK
     2239     BY benefits.obj-type
     2240     BY benefits.obj-code
     2241     BY benefits.pay-desk
     2242     BY benefits.pay-code
     2243     BY benefits.curr-code :
     2244       if first-of( benefits.pay-desk ) then do:
     2245           FIND FIRST day_sum WHERE
     2246                       day_sum.obj-type = obj-list.obj-type AND
     2247                       day_sum.obj-code = obj-list.obj-code AND
     2248                       day_sum.pay-desk = benefits.pay-desk NO-ERROR.
     2249           DatePrinted = FALSE .
     2250       end.
     2251       benefits.pcnt = round( benefits.tot-r-b / day_sum.tot-r-b * 100 , 2 ) .
     2252       if benefits.tot-base  <> 0
     2253       or (day_sum.chk-cnt-all > day_sum.chk-cnt-nf)
     2254       then do:
     2255         if DatePrinted then assign
     2256           v-td-date = '<br />'
     2257         .
     2258         else assign
     2259           v-td-date   = string(benefits.pay-desk)
     2260           DatePrinted = TRUE
     2261         .
     2262         open query qben-chk-count
     2263          preselect each ben-chk-count
     2264                   where ben-chk-count.obj-type  = obj-list.obj-type
     2265                     and ben-chk-count.obj-code  = obj-list.obj-code
     2266                     and ben-chk-count.pay-desk  = benefits.pay-desk
     2267                     and ben-chk-count.pay-code  = benefits.pay-code
     2268                     and ben-chk-count.curr-code = benefits.curr-code.
     2269         v-chk-count = query qben-chk-count:num-results .
     2270         close query qben-chk-count.
     2271         put stream OutStr-html unformatted
     2272           '  <tr>'
     2273           '<td>' + v-td-date + '</td>'
     2274           '<td>' + benefits.pay-name + '</td>'
     2275           putRowAmount (benefits.curr-name, benefits.tot-sum, benefits.tot-base, benefits.tot-rubl)
     2276           substitute(  '<td num="0.00" val="&1">&1</td>',  fnc-convert-dot-to-colon(benefits.pcnt,    "->>9.99",2)  )
     2277           substitute(  '<td num="0" val="&1" class="sumtotal">&1</td>',  v-chk-count  )
     2278           '</tr>' skip
     2279         .
     2280       end.
     2281       if last-of( benefits.pay-desk ) then do:
     2282         if day_sum.chk-cnt-all > day_sum.chk-cnt-nf then do:
     2283           put stream OutStr-html unformatted
     2284             substitute(  '  <td colspan="3">средн.чек: &1</td>',
     2285               ROUND(day_sum.tot-base / (day_sum.chk-cnt-all - day_sum.chk-cnt-nf), 2)  )
     2286             substitute(  '<td num="0.00" val="&1" class="sumtotal">&1</td>',  fnc-convert-dot-to-colon(day_sum.tot-base,"->>>>>>>>>>>9.99",2)  )
     2287             '<td></td>'
     2288             substitute(  '<td num="0.00" val="&1" class="sumtotal">&1</td>',  fnc-convert-dot-to-colon(day_sum.tot-rubl,"->>>>>>>>>>>9.99",2)  )
     2289             '<td>100.00%</td>'
     2290             substitute(  '<td num="0" val="&1" class="sumtotal">&1</td>',  day_sum.chk-cnt-all - day_sum.chk-cnt-nf  )
     2291             '</tr>' skip
     2292           .
     2293         end.
     2294       end.
     2295       if last-of( benefits.obj-code ) then do:
     2296         put stream OutStr-html unformatted
     2297           '  <tr><td colspan="3">ИТОГО:</td>'
     2298           substitute(  '<td num="0.00" val="&1" class="sumtotal">&1</td>',  fnc-convert-dot-to-colon(all-days_sum.tot-base,"->>>>>>>>>>>9.99",2)  )
     2299           '<td></td>'
     2300           substitute(  '<td num="0.00" val="&1" class="sumtotal">&1</td>',  fnc-convert-dot-to-colon(all-days_sum.tot-rubl,"->>>>>>>>>>>9.99",2)  )
     2301           '<td></td>'
     2302           substitute(  '<td num="0" val="&1" class="sumtotal">&1</td>',  all-days_sum.chk-cnt-all - all-days_sum.chk-cnt-nf  )
     2303           '</tr>' skip
     2304         .
     2305       end.
     2306     END.
     2307     if last( obj-list.obj-code ) AND ( ACCUM COUNT obj-list.obj-code ) > 1 then do:
     2308       put stream OutStr-html unformatted
     2309         '  <tr><td colspan="3">ИТОГО по всем</td>'
     2310         substitute(  '<td num="0.00" val="&1" class="sumtotal">&1</td>',  fnc-convert-dot-to-colon(ACCUM TOTAL all-days_sum.tot-base,"->>>>>>>>>>>9.99",2)  )
     2311         '<td></td>'
     2312         substitute(  '<td num="0.00" val="&1" class="sumtotal">&1</td>',  fnc-convert-dot-to-colon(ACCUM TOTAL all-days_sum.tot-rubl,"->>>>>>>>>>>9.99",2)  )
     2313         '<td></td>'
     2314         substitute(  '<td num="0" val="&1" class="sumtotal">&1</td>',
     2315           (ACCUM TOTAL all-days_sum.chk-cnt-all) - (ACCUM TOTAL all-days_sum.chk-cnt-nf)  )
     2316         '</tr>' skip
     2317       .
     2318     end.
     2319   END.
     2320   if  ObjAmount > 1  then do:
     2321     FOR EACH benefits
     2322     BREAK
     2323     BY benefits.pay-code :
     2324       ACCUMULATE
     2325       benefits.tot-base ( SUB-TOTAL BY benefits.pay-code )
     2326       benefits.tot-rubl ( SUB-TOTAL BY benefits.pay-code )
     2327       benefits.tot-r-b  ( SUB-TOTAL BY benefits.pay-code )
     2328       .
     2329       if last-of( benefits.pay-code ) AND
     2330           ( ACCUM SUB-TOTAL BY benefits.pay-code benefits.tot-base ) <> 0 then do:
     2331         open query qben-chk-count
     2332          preselect each ben-chk-count
     2333                   where ben-chk-count.pay-code  = benefits.pay-code.
     2334         v-chk-count = query qben-chk-count:num-results .
     2335         close query qben-chk-count.
     2336         put stream OutStr-html unformatted
     2337           substitute(  '  <tr><td colspan="3">/итого по &1</td>',  benefits.pay-name  )
     2338           substitute(  '<td num="0.00" val="&1" class="sumtotal">&1</td>',  fnc-convert-dot-to-colon(ACCUM SUB-TOTAL BY benefits.pay-code benefits.tot-base,"->>>>>>>>>>>9.99",2)  )
     2339           '<td></td>'
     2340           substitute(  '<td num="0.00" val="&1" class="sumtotal">&1</td>',  fnc-convert-dot-to-colon(ACCUM SUB-TOTAL BY benefits.pay-code benefits.tot-rubl,"->>>>>>>>>>>9.99",2)  )
     2341           '<td></td>'
     2342           substitute(  '<td num="0" val="&1" class="sumtotal">&1</td>',  v-chk-count  )
     2343           '</tr>' skip
     2344         .
     2345       end.
     2346     END.
     2347   end.
     2348   put stream OutStr-html unformatted
     2349     '</tbody>' skip
     2350     '<tfoot>' skip
     2351   .
     2352   if ( ACCUM COUNT obj-list.obj-code ) < 2 then do:
     2353     put stream OutStr-html unformatted
     2354       '  <tr><td colspan="8"><br /></td></tr>' skip
     2355       '  <tr><td colspan="4">Директор _______________</td><td colspan="4">Старший продавец ______________</td></tr>' skip
     2356       '  <tr><td colspan="8"><br /></td></tr>' skip
     2357       '  <tr><td colspan="4">Бухгалтер ______________</td><td colspan="4">Кассир ________________________</td></tr>' skip
     2358     .
     2359   end.
     2360   put stream OutStr-html unformatted
     2361     '</tfoot>' skip
     2362     '</table>' skip
     2363     '</body>' skip
     2364     '</html>' skip
     2365   .
     2366   output stream OutStr-html close.
     2367   run prn-lib-reportviewer in this-procedure (
     2368       input this-procedure
     2369       ,input v-file-name-rep-htm
     2370       ,input ""
     2371       ) no-error.
     2372   if error-status:error then
     2373   do:
     2374       message return-value view-as alert-box.
     2375       return .
     2376   end.
