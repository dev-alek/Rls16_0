        1   define input parameter parparentproc as widget-handle no-undo .
        2   define input parameter p-curr-obj-type like ub.clients.obj-type no-undo .
        3   define input parameter p-curr-obj-code like ub.clients.obj-code no-undo .
        4   define input parameter p-lst-type as character no-undo .
        5   define input parameter table-name as character no-undo .
        6   define variable vss-revision    as character no-undo init "$Revision$":U .
        7   define variable vss-author      as character no-undo init "$Author$":U .
        8   define variable vss-date        as character no-undo init "$Date$":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       10   define variable vss-archive     as character no-undo init "$Archive$":U .
       11   define variable vss-description as character no-undo init "Печать списка товаров".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   procedure proc-alt-shift-f2:
       71     if not ibs.th.gbl.gbl-var:rcode
       72   then
       73     run gbl\inidebug.p .
       74   end.
       75   procedure proc-alt-shift-f3:
       76     run gbl/prvssinf.p
       77       ( input this-procedure
       78       ) .
       79   end.
       80   define variable v-inform-launched as logical no-undo initial false .
       81   procedure proc-alt-shift-f4:
       82     define variable v-action as character no-undo .
       83     if v-inform-launched = false then do:
       84       assign
       85         v-inform-launched = true
       86       .
       87       run gbl/d-inform.w
       88         (  input self
       89         ,  input this-procedure
       90         , output v-action
       91         ) no-error .
       92       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       93       assign
       94         v-inform-launched = false
       95       .
       96     end.
       97   end.
       98   procedure proc-alt-f1:
       99     run gbl/corrhelp.p
      100       (input this-procedure
      101       ) .
      102   end .
      103   on alt-shift-f2 anywhere do:
      104     run proc-alt-shift-f2.
      105   end.
      106   on alt-shift-f3 anywhere do:
      107     run proc-alt-shift-f3 in this-procedure .
      108   end.
      109   on alt-shift-f4 anywhere do:
      110     run proc-alt-shift-f4 in this-procedure.
      111   end.
      112   on alt-f1 anywhere do:
      113     run proc-alt-f1 in this-procedure .
      114   end.
      115   DEFINE BUTTON b-exit AUTO-GO
      116        LABEL "&Ввод ":L
      117        SIZE 10 BY 1
      118        BGCOLOR 8 .
      119   DEFINE BUTTON B-Help
      120        LABEL "&Помощь":L
      121        SIZE 10 BY 1
      122        BGCOLOR 8 .
      123   DEFINE BUTTON Btn_Cancel AUTO-END-KEY DEFAULT
      124        LABEL "&Отмена":L
      125        SIZE 10 BY 1
      126        BGCOLOR 8 .
      127   DEFINE VARIABLE Classify AS CHARACTER
      128        VIEW-AS RADIO-SET VERTICAL
      129        RADIO-BUTTONS
      130             "Без классификации", "Classify_1",
      131   "Производители", "Classify_2",
      132   "Группы товаров", "Classify_3",
      133   "Производители/Группы товаров", "Classify_4",
      134   "Группы товаров/Производители", "Classify_5"
      135        SIZE 30.5 BY 5.75 NO-UNDO.
      136   DEFINE VARIABLE SortType AS CHARACTER
      137        VIEW-AS RADIO-SET VERTICAL
      138        RADIO-BUTTONS
      139             "по коду", "b-code":U,
      140   "по артикулу", "artic":U,
      141   "в порядке ввода", "order-num":U
      142        SIZE 20 BY 3.5
      143        FGCOLOR 0  NO-UNDO.
      144   DEFINE FRAME DLGOKCAN
      145        b-exit AT ROW 1 COL 1
      146        Btn_Cancel AT ROW 1 COL 11
      147        B-Help AT ROW 1 COL 52
      148        Classify AT ROW 3.25 COL 7.5 NO-LABEL
      149        SortType AT ROW 4 COL 44 NO-LABEL
      150        "Сортировка :" VIEW-AS TEXT
      151             SIZE 11.5 BY .75 AT ROW 2.25 COL 45
      152             FGCOLOR 4
      153        "Классификация :" VIEW-AS TEXT
      154             SIZE 16.5 BY .75 AT ROW 2.25 COL 10
      155             FGCOLOR 4
      156        SPACE(37.62) SKIP(6.37)
      157       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      158            SIDE-LABELS THREE-D  SCROLLABLE
      159            BGCOLOR 8 FGCOLOR 0
      160            TITLE BGCOLOR 8 FGCOLOR 1 "Как напечатать список":L.
      161   ASSIGN
      162          FRAME DLGOKCAN:SCROLLABLE       = FALSE
      163          FRAME DLGOKCAN:PRIVATE-DATA     =
      164                   "DLGCLOSE".
      165   ASSIGN
      166          b-exit:PRIVATE-DATA IN FRAME DLGOKCAN     =
      167                   "b-exit".
      168   ON CHOOSE OF b-exit IN FRAME DLGOKCAN
      169   DO:
      170     run print-gds-list in this-procedure .
      171   END.
      172   ON CHOOSE OF Btn_Cancel IN FRAME DLGOKCAN
      173   DO:
      174       return "NO" .
      175   END.
      176   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME DLGOKCAN:PARENT eq ?
      177   THEN FRAME DLGOKCAN:PARENT = ACTIVE-WINDOW.
      178   ON WINDOW-CLOSE OF FRAME DLGOKCAN APPLY "END-ERROR":U TO SELF.
      179   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      180   on help of frame DLGOKCAN
      181   do:
      182     run gbl/app_help.p
      183       (input this-procedure :file-name
      184       ,input ''
      185       ,input ?
      186       ) no-error.
      187     if error-status :error then do:
      188       message
      189         "Ошибка при вызове помощи"
      190         error-status :get-message(1)
      191         view-as alert-box .
      192     end.
      193   end.
      194   run minbtn-set in this-procedure .
      195   on choose of b-help in frame DLGOKCAN
      196   do:
      197     apply "help":u to frame DLGOKCAN .
      198   end.
      199   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      200   procedure minbtn-set :
      201       do
      202           on error undo, return error return-value
      203           :
      204           define variable ii              as integer       no-undo .
      205           define variable fh              as widget-handle no-undo .
      206           define variable hh              as widget-handle no-undo .
      207           define variable v-h             as handle        extent 4 no-undo .
      208           define variable v-name-button   as character     no-undo .
      209           define variable v-help-old-x    as decimal       no-undo .
      210           define variable v-help-old-y    as decimal       no-undo .
      211           define variable v-help-old-size as decimal       no-undo .
      212           define variable v-frame-width   as decimal       no-undo .
      213           define variable jj              as integer       no-undo .
      214           do
      215               on error undo, return error
      216               :
      217               assign
      218                   v-frame-width = frame DLGOKCAN:width - 0.3
      219                   fh            = frame DLGOKCAN:first-child
      220                   hh            = fh:first-child
      221                   ii            = 1
      222                   .
      223               do while valid-handle(hh):
      224                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      225                   do:
      226                       case lc(hh:name) :
      227                           when "b-help" then
      228                               do:
      229                                   hh:load-image-up("cmp/b-help.bmp":u) .
      230                                   hh:load-image-down("cmp/b-help.bmp":u) .
      231                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      232                                   hh:TOOLTIP = "Помощь" .
      233                                   v-help-old-x = hh:column .
      234                                   v-help-old-y = hh:row    .
      235                                   v-help-old-size = hh:width .
      236                                   hh:width-chars = 2.5 .
      237                               end.
      238                           when "b-print" then
      239                               do:
      240                                   hh:load-image("cmp/b-print.bmp":u) .
      241                                   hh:TOOLTIP = "Печать" .
      242                                   v-h[ii] = hh:handle .
      243                                   ii = ii + 1 .
      244                                   hh:width-chars = 3 .
      245                               end.
      246                           when "b-history" or
      247                           when "b-hist" then
      248                               do:
      249                                   hh:load-image("cmp/b-hist.bmp":u) .
      250                                   hh:TOOLTIP = "История" .
      251                                   v-h[ii] = hh:handle .
      252                                   ii = ii + 1 .
      253                                   hh:width-chars = 3 .
      254                               end.
      255                           when "b-sch" then
      256                               do:
      257                                   hh:load-image("cmp/b-sch.bmp":u) .
      258                                   hh:TOOLTIP = "Установка Фильтра" .
      259                                   v-h[ii] = hh:handle .
      260                                   ii = ii + 1 .
      261                                   hh:width-chars = 3 .
      262                               end.
      263                           when "b-hist-user" then
      264                               do:
      265                                   hh:load-image("cmp/b-hist.bmp":u) .
      266                                   hh:TOOLTIP = "История пользователя" .
      267                                   ii = ii + 1 .
      268                               end.
      269                       end case.
      270                   end.
      271                   hh = hh:next-sibling.
      272               end.
      273               b-help:column = v-frame-width - b-help:width-chars.
      274               jj = 0.
      275               repeat ii = 4 to 1 by -1 :
      276                   if valid-handle (v-h[ii] ) then
      277                   do:
      278                       jj  = jj + 1 .
      279                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      280                       v-h[ii]:row    = v-help-old-y .
      281                   end.
      282               end.
      283           end.
      284       end.
      285   end procedure.
      286   MAIN-BLOCK:
      287   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      288      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      289     RUN enable_UI.
      290     WAIT-FOR GO OF FRAME DLGOKCAN.
      291   END.
      292   RUN disable_UI.
      293   PROCEDURE disable_UI :
      294     HIDE FRAME DLGOKCAN.
      295   END PROCEDURE.
      296   PROCEDURE enable_UI :
      297     DISPLAY Classify SortType
      298         WITH FRAME DLGOKCAN.
      299     ENABLE b-exit Btn_Cancel B-Help Classify SortType
      300         WITH FRAME DLGOKCAN.
      301   END PROCEDURE.
      302   PROCEDURE print-gds-list :
      303   define variable v-ok as character no-undo .
      304   do with frame DLGOKCAN:
      305     assign
      306     SortType
      307     Classify
      308     .
      309   end.
      310   CASE table-name:
      311     when "gds-list":U then do:
      312       if p-lst-type = "ALL":U then
      313         run rep/rgdslstg.p (
      314                       input parparentproc
      315                       ,input p-curr-obj-type
      316                       ,input p-curr-obj-code
      317                       ,input sorttype
      318                       ,input classify
      319                       ).
      320       if p-lst-type = "LIST":U then
      321         run rep/rgdslsts.p (
      322                        input parparentproc
      323                       ,input p-curr-obj-type
      324                       ,input p-curr-obj-code
      325                       ,input sorttype
      326                       ,input classify
      327                       ).
      328     end.
      329     when "bb-list" then do:
      330       if p-lst-type = "ALL":U then
      331         run rep/rbblstg.p (
      332                       input  parparentproc
      333                       ,input p-curr-obj-type
      334                       ,input p-curr-obj-code
      335                       ,input sorttype
      336                       ,input classify
      337                       ).
      338       if p-lst-type = "LIST":U then
      339         run rep/rbblsts.p (
      340                         input parparentproc
      341                       ,input p-curr-obj-type
      342                       ,input p-curr-obj-code
      343                       ,input sorttype
      344                       ,input classify
      345                       ).
      346     end.
      347   END CASE.
      348   return return-value.
      349   END PROCEDURE.
