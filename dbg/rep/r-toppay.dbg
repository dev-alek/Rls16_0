     1784   PROCEDURE no-benq.
     1785   DEFINE OUTPUT PARAMETER found as logical init no.
     1786   define buffer buf_chk-doc for ub.chk-doc.
     1787   FOR EACH obj-list WHERE
     1788           obj-list.obj-type = 'маг':U NO-LOCK :
     1789     CASE X-Radio-Task > 1 :
     1790       WHEN YES THEN DO:
     1791         FOR EACH buf_chk-doc NO-LOCK WHERE
     1792                 buf_chk-doc.obj-type = obj-list.obj-type AND
     1793                 buf_chk-doc.obj-code = obj-list.obj-code AND
     1794                 (
     1795                   buf_chk-doc.shift-date >= X-date-start AND
     1796                   buf_chk-doc.shift-date <= X-date-end)
     1797                   AND
     1798                   (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1799           IF X-Radio-Task = 3 AND
     1800           ((buf_chk-doc.shift-date = X-date-start AND buf_chk-doc.shift-num < X-shift-Start) OR
     1801             (buf_chk-doc.shift-date = X-date-end AND  buf_chk-doc.shift-num > X-shift-End) ) THEN NEXT.
     1802           IF X-Radio-Task = 4 AND
     1803           (buf_chk-doc.shift-num <> X-shift-Alone ) THEN NEXT.
     1804           found = yes.
     1805           return.
     1806         END.
     1807       END.
     1808       WHEN NO THEN DO:
     1809         FOR EACH buf_chk-doc NO-LOCK WHERE
     1810               buf_chk-doc.obj-type = obj-list.obj-type AND
     1811               buf_chk-doc.obj-code = obj-list.obj-code AND
     1812               buf_chk-doc.chk-date >= X-date-start AND
     1813               buf_chk-doc.chk-date <= X-date-end   AND
     1814               (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1815           found = yes.
     1816           return.
     1817         END.
     1818        END.
     1819      END CASE.
     1820    END.
     1821   END PROCEDURE.
     1822   PROCEDURE no-benqi.
     1823   DEFINE OUTPUT PARAMETER found as logical init no.
     1824   define buffer buf_chk-doc for ub.chk-doc.
     1825   define buffer buf_inkas for ub.inkas.
     1826   FOR EACH obj-list WHERE
     1827         obj-list.obj-type = 'маг':U NO-LOCK :
     1828     CASE X-Radio-Task > 1 :
     1829       WHEN YES THEN DO:
     1830         FOR EACH buf_chk-doc No-LOCK WHERE
     1831                 buf_chk-doc.obj-type = obj-list.obj-type AND
     1832                 buf_chk-doc.obj-code = obj-list.obj-code AND
     1833                 (
     1834                   buf_chk-doc.shift-date >= X-date-start AND
     1835                   buf_chk-doc.shift-date <= X-date-end)
     1836                   AND
     1837                   buf_Chk-doc.out-code = ? AND
     1838                   (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1839           IF X-Radio-Task = 3 AND
     1840           ((buf_chk-doc.shift-date = X-date-start AND buf_chk-doc.shift-num < X-shift-Start) OR
     1841             (buf_chk-doc.shift-date = X-date-end AND  buf_chk-doc.shift-num > X-shift-End) ) THEN NEXT.
     1842           IF X-Radio-Task = 4 AND
     1843           (buf_chk-doc.shift-num <> X-shift-Alone ) THEN NEXT.
     1844           found = yes.
     1845           return.
     1846         END.
     1847         FOR EACH buf_inkas No-LOCK WHERE
     1848                   buf_inkas.obj-type = obj-list.obj-type AND
     1849                   buf_inkas.obj-code = obj-list.obj-code AND
     1850                   (
     1851                   buf_inkas.shift-date >= X-date-start AND
     1852                   buf_inkas.shift-date <= X-date-end):
     1853           if buf_inkas.status_ = 'факт':U
     1854           or buf_inkas.status_ = 'запрос':U then next.
     1855           IF X-Radio-Task = 3 AND
     1856           ((buf_inkas.shift-date = X-date-start AND buf_inkas.shift-num < X-shift-Start) OR
     1857             (buf_inkas.shift-date = X-date-end AND  buf_inkas.shift-num > X-shift-End) ) THEN NEXT.
     1858           IF X-Radio-Task = 4 AND
     1859           (buf_inkas.shift-num <> X-shift-Alone ) THEN NEXT.
     1860           found = yes.
     1861           return.
     1862         END.
     1863       END.
     1864       WHEN NO THEN DO:
     1865         FOR EACH buf_chk-doc NO-LOCK WHERE
     1866                 buf_chk-doc.obj-type = obj-list.obj-type AND
     1867                 buf_chk-doc.obj-code = obj-list.obj-code AND
     1868                 buf_chk-doc.chk-date >= X-date-start AND
     1869                 buf_chk-doc.chk-date <= X-date-end   AND
     1870                 buf_Chk-doc.out-code = ? AND
     1871                 (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1872           found = yes.
     1873           return.
     1874         END.
     1875         FOR EACH buf_inkas NO-LOCK WHERE
     1876                 buf_inkas.obj-type = obj-list.obj-type AND
     1877                 buf_inkas.obj-code = obj-list.obj-code AND
     1878                 buf_inkas.doc-date >= X-date-start AND
     1879                 buf_inkas.doc-date <= X-date-end :
     1880           if buf_inkas.status_ = 'факт':U
     1881           or buf_inkas.status_ = 'запрос':U then next.
     1882           found = yes.
     1883           return.
     1884         END.
     1885       END.
     1886     END CASE.
     1887   END.
     1888   END PROCEDURE.
     1889   PROCEDURE no-benq-i.
     1890   DEFINE OUTPUT PARAMETER found as logical init no.
     1891   define buffer buf_inkas for ub.inkas.
     1892   CASE X-Radio-Task > 1:
     1893     WHEN YES then do:
     1894       FOR EACH obj-list WHERE
     1895               obj-list.obj-type = 'маг':U NO-LOCK :
     1896         FOR EACH buf_inkas NO-LOCK WHERE
     1897                 buf_inkas.obj-type = obj-list.obj-type AND
     1898                 buf_inkas.obj-code = obj-list.obj-code AND
     1899                 buf_inkas.status_ = 'факт':U AND
     1900                 (
     1901                 buf_inkas.shift-date >= X-date-start AND
     1902                 buf_inkas.shift-date <= X-date-end):
     1903           IF X-Radio-Task = 3 AND
     1904           ((buf_inkas.shift-date = X-date-start AND buf_inkas.shift-num < X-shift-Start) OR
     1905             (buf_inkas.shift-date = X-date-end AND  buf_inkas.shift-num > X-shift-End) ) THEN NEXT.
     1906           IF X-Radio-Task = 4 AND
     1907           (buf_inkas.shift-num <> X-shift-Alone ) THEN NEXT.
     1908           found = yes.
     1909           return.
     1910         END.
     1911     END.
     1912     END.
     1913     WHEN NO THEN DO:
     1914       FOR EACH obj-list WHERE
     1915               obj-list.obj-type = 'маг':U NO-LOCK :
     1916         FOR EACH buf_inkas NO-LOCK WHERE
     1917                 buf_inkas.obj-type = obj-list.obj-type AND
     1918                 buf_inkas.obj-code = obj-list.obj-code AND
     1919                 buf_inkas.status_ = 'факт':U AND
     1920                 buf_inkas.doc-date >= X-date-start AND
     1921                 buf_inkas.doc-date <= X-date-end :
     1922            found = yes.
     1923            return.
     1924         END.
     1925       END.
     1926     END.
     1927   END CASE.
     1928   END PROCEDURE.
     1929   PROCEDURE no-benq-i-office.
     1930   DEFINE OUTPUT PARAMETER found as logical init no.
     1931   define buffer buf_sale-doc for ub.sale-doc.
     1932   CASE X-Radio-Task > 1:
     1933     WHEN YES then do:
     1934       FOR EACH obj-list WHERE
     1935               obj-list.obj-type = 'маг':U NO-LOCK :
     1936         FOR EACH buf_sale-doc NO-LOCK WHERE
     1937                  buf_Sale-doc.obj-type = obj-list.obj-type
     1938              AND buf_sale-doc.obj-code = obj-list.obj-code
     1939              AND buf_sale-doc.status_ = 'факт':U
     1940              AND buf_sale-doc.chr-office = 'у':U
     1941              AND (
     1942                 buf_sale-doc.shift-date >= X-date-start
     1943                 AND
     1944                 buf_sale-doc.shift-date <= X-date-end):
     1945           IF X-Radio-Task = 3 AND
     1946           ((buf_sale-doc.shift-date = X-date-start AND buf_sale-doc.shift-num < X-shift-Start) OR
     1947             (buf_sale-doc.shift-date = X-date-end AND  buf_sale-doc.shift-num > X-shift-End) ) THEN NEXT.
     1948           IF X-Radio-Task = 4 AND
     1949           (buf_sale-doc.shift-num <> X-shift-Alone ) THEN NEXT.
     1950           found = yes.
     1951           return.
     1952         END.
     1953       END.
     1954     END.
     1955     WHEN NO THEN DO:
     1956       FOR EACH obj-list WHERE
     1957               obj-list.obj-type = 'маг':U NO-LOCK :
     1958         FOR EACH buf_sale-doc NO-LOCK WHERE
     1959                 buf_sale-doc.obj-type = obj-list.obj-type
     1960            AND  buf_sale-doc.obj-code = obj-list.obj-code
     1961            AND  buf_sale-doc.status_ = 'факт':U
     1962            AND  buf_sale-doc.chr-office = 'у':U
     1963            AND  buf_sale-doc.doc-date >= X-date-start
     1964            AND  buf_sale-doc.doc-date <= X-date-end :
     1965           found = yes.
     1966           return.
     1967         END.
     1968       END.
     1969     END.
     1970   END CASE.
     1971   END PROCEDURE.
     1972   assign
     1973     date_string     = cur-time-print()
     1974     Line            = fill( "-", 142 )
     1975     my-set_val_type = if x-set_Val_Type = 0 then 2 else x-Set_val_type.
     1976   run no-benq(output found).
     1977   run no-benqi(output NotInc).
     1978   if not found then
     1979   do:
     1980     run waitfram-hide in this-procedure .
     1981     message "Не было никакой выручки  в течение заданного Вами периода времени." view-as alert-box information .
     1982     return.
     1983   end.
     1984   run waitfram-show in this-procedure ( 'Подождите ...' ) .
