        1   using Progress.Lang.*.
        2   using Ibs.Th.Gbl.ReportXml.
        3   using Ibs.Th.Gbl.rep-out.
        4   block-level on error undo, throw.
        5   define variable vss-revision    as character no-undo init "$Revision: 3b789addcaba, 2696, rls $":U .
        6   define variable vss-author      as character no-undo init "$Author: EShklyar $":U .
        7   define variable vss-date        as character no-undo init "$Date: Пт дек 18 18:16:05 2020 +0300 $":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile: r-toppay.p $":U .
        9   define variable vss-archive     as character no-undo init "$Archive: rep/r-toppay.p $":U .
