       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define new global shared variable g#library  as handle no-undo .
       70   define new global shared variable g#library2 as handle no-undo .
       71   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       72   procedure cur-time :
       73      define output parameter p-today as date      no-undo .
       74      define output parameter p-time  as integer   no-undo .
       75     do
       76     on error undo, return error
       77     :
       78       define variable v-date1 as date      no-undo .
       79       define variable v-date2 as date      no-undo .
       80       define variable v-time  as integer   no-undo .
       81       assign
       82         v-date1 = today
       83         v-time  = time
       84         v-date2 = today
       85       .
       86       if v-date1 <> v-date2
       87       then do:
       88         assign
       89           v-date1 = today
       90           v-time  = v-time
       91         .
       92       end.
       93       assign
       94         p-today = v-date1
       95         p-time  = v-time
       96       .
       97     end.
       98   end.
       99   function cur-time-date returns character
      100   :
      101     return string(today, '99/99/9999':U) .
      102   end.
      103   function cur-time-mjd returns decimal
      104   :
      105     define variable v-date as date      no-undo .
      106     define variable v-time as integer   no-undo .
      107     run cur-time in this-procedure
      108       (output v-date
      109       ,output v-time
      110       ) .
      111     return integer(v-date) - 2400002 + (v-time / 86400) .
      112   end.
      113   function cur-time-get-ending-index returns integer
      114   (input p-number as integer
      115   )
      116   :
      117     if p-number < 0
      118     or p-number = ?
      119     then do:
      120       return 1 .
      121     end.
      122     define variable v-rest as integer   no-undo .
      123     assign
      124       p-number = p-number modulo 100
      125     .
      126     if p-number < 20
      127     then do:
      128       assign
      129         v-rest = p-number
      130       .
      131     end.
      132     else do:
      133       assign
      134         v-rest = p-number modulo 10
      135       .
      136     end.
      137     case v-rest :
      138       when 1
      139       then do:
      140         return 2 .
      141       end.
      142       when 2 or
      143       when 3 or
      144       when 4
      145       then do:
      146         return 3 .
      147       end.
      148       otherwise do:
      149         return 1 .
      150       end.
      151     end case .
      152   end.
      153   procedure cur-time-mjd-to-date :
      154      define input  parameter i-mjd-diff as decimal no-undo.
      155      define output parameter o-Date     as date    no-undo.
      156      define output parameter o-Time     as integer no-undo.
      157      define variable v-day-number as integer   no-undo .
      158      if    i-mjd-diff < 0
      159         or i-mjd-diff = ?
      160      then do:
      161         return "?" .
      162      end.
      163      assign
      164         v-day-number = truncate(i-mjd-diff,0).
      165         o-Date = date(v-day-number + 2400002).
      166         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      167     .
      168   end.
      169   function cur-time-mjd-to-string returns character
      170   (input p-mjd-diff as decimal
      171   )
      172   :
      173     define variable v-day-number as integer   no-undo .
      174     define variable v-seconds    as integer   no-undo .
      175     define variable v-hour       as integer   no-undo .
      176     define variable v-min        as integer   no-undo .
      177     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      178     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      179     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      180     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      181     if p-mjd-diff < 0
      182     or p-mjd-diff = ?
      183     then do:
      184       return "?" .
      185     end.
      186     assign
      187       v-day-number = integer(truncate(p-mjd-diff,0))
      188       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      189     .
      190     if v-seconds > 86400
      191     then do:
      192       assign
      193         v-seconds = 86400 - 1
      194       .
      195     end.
      196     if v-seconds < 0
      197     then do:
      198       assign
      199         v-seconds = 0
      200       .
      201     end.
      202     assign
      203       v-hour = truncate(v-seconds / 3600, 0)
      204     .
      205     assign
      206       v-seconds = v-seconds modulo 3600
      207     .
      208     assign
      209       v-min = truncate(v-seconds / 60, 0)
      210     .
      211     assign
      212       v-seconds = v-seconds modulo 60
      213     .
      214     return
      215         (if v-day-number <> 0
      216           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      217           else ""
      218         )
      219       + (if v-day-number <> 0 or v-hour <> 0
      220           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      221           else ""
      222         )
      223       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      224           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      225           else ""
      226         )
      227       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      228       .
      229   end.
      230   function cur-time-string returns character
      231   :
      232     define variable v-date as date      no-undo .
      233     define variable v-time as integer   no-undo .
      234     run cur-time in this-procedure
      235       (output v-date
      236       ,output v-time
      237       ) .
      238     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      239   end.
      240   function cur-time-string-sec returns character
      241   :
      242     define variable v-date as date      no-undo .
      243     define variable v-time as integer   no-undo .
      244     run cur-time in this-procedure
      245       (output v-date
      246       ,output v-time
      247       ) .
      248     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      249   end.
      250   function cur-time-custom  returns character
      251   (input p-prefix as character
      252   ,input p-date-format as character
      253   ,input p-delimiter as character
      254   ,input p-time-format as character
      255   ,input p-suffix as character
      256   )
      257   :
      258     define variable v-date as date      no-undo .
      259     define variable v-time as integer   no-undo .
      260     run cur-time in this-procedure
      261       (output v-date
      262       ,output v-time
      263       ) .
      264     return
      265       p-prefix
      266       + string(v-date, p-date-format)
      267       + p-delimiter
      268       + string(v-time, p-time-format)
      269       + p-suffix
      270       .
      271   end.
      272   function cur-time-print  returns character
      273   :
      274     define variable v-date as date      no-undo .
      275     define variable v-time as integer   no-undo .
      276     run cur-time in this-procedure
      277       (output v-date
      278       ,output v-time
      279       ) .
      280     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      281   end.
      282   function cur-time-datetime returns datetime
      283   :
      284     define variable v-char as character no-undo .
      285     define variable v-datetime as datetime no-undo .
      286     v-char = cur-time-string().
      287     v-datetime = datetime(v-char).
      288     return  v-datetime.
      289   end.
      290   function cur-time-string-msec returns character
      291   :
      292     define variable v-date as datetime  no-undo .
      293     v-date = now.
      294     return string(v-date) .
      295   end.
