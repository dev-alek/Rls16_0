     2368         CASE my-set_val_type :
     2369           when 2 then
     2370             do:
     2371               Report:table-total(    ""
     2372                 + "|" +    ""
     2373                 + "|" +    "Всего продано топлива"
     2374                 + "|" +    ""
     2375                 + "|" +    ""
     2376                 + "|" +    ""
     2377                 + "|" +    string(total-qnty1)
     2378                 + "|" +    if v-curr-r-b = 'base':U
     2379                 then string(total-tot-base1)
     2380                 else string(total-tot-rubl1)
     2381                 ).
     2382               v-mode = "yestotal":U.
     2383             end.
     2384           when 3 then
     2385             do:
     2386               Report:table-total(  ""
     2387                 + "|" +    ""
     2388                 + "|" +    "Всего продано топлива"
     2389                 + "|" +    ""
     2390                 + "|" +    ""
     2391                 + "|" +    ""
     2392                 + "|" +    if total-qnty1 = ? then "" else (string(total-qnty1))
     2393                 + "|" +    ""
     2394                 + "|" +    if total-tot-base1 = ? then "" else string(total-tot-base1)
     2395                 + "|" +    if total-tot-rubl1 = ? then "" else string(total-tot-rubl1)
     2396                 ).
     2397               v-mode = "yestotal":U.
     2398             end.
     2399         END CASE .
     2400       END.
     2401     END.
     2402     if v-mode = "nototal":U and my-set_val_type = 2  then
     2403     do:
     2404       Report:table-total(  ""
     2405         + "|" +    ""
     2406         + "|" +    "Всего продано топлива"
     2407         + "|" +    ""
     2408         + "|" +    ""
     2409         + "|" +    ""
     2410         + "|" +    ""
     2411         + "|" +    ""
     2412         ).
     2413     end.
     2414     if v-mode = "nototal":U and my-set_val_type = 3  then
     2415     do:
     2416       Report:table-total(  ""
     2417         + "|" +    ""
     2418         + "|" +    "Всего продано топлива"
     2419         + "|" +    ""
     2420         + "|" +    ""
     2421         + "|" +    ""
     2422         + "|" +    ""
     2423         + "|" +    ""
     2424         + "|" +    ""
     2425         + "|" +    ""
     2426         ).
     2427     end.
     2428     Report:worksheet-footer("start").
     2429     Report:worksheet-footer("").
     2430     Report:worksheet-footer("Директор _______________        Старший продавец ______________"  ).
     2431     Report:worksheet-footer("").
     2432     Report:worksheet-footer("").
     2433     Report:worksheet-footer("Бухгалтер ______________         Кассир _________________________  ").
     2434     Report:worksheet-footer("end").
     2435     report:worksheet("end").
     2436     delete object Report.
     2437     xslt-path = search("exe\template.xsl").
     2438     rep-out-unit = new rep-out ().
     2439     rep-out-unit:office(xml_tmp, xslt-path).
     2440   END PROCEDURE.
     2441   procedure t-beneq.
     2442     define var      sum-list          as character no-undo.
     2443     define var      pay-code-list     as character no-undo.
     2444     define var      curr-code-list    as character no-undo.
     2445     define var      atr64-list        as character no-undo.
     2446     define var      exch-list         as character no-undo.
     2447     define var      for-sum           as decimal   no-undo.
     2448     define var      b-sum             as decimal   no-undo.
     2449     define var      dop-sum           as decimal   no-undo.
     2450     define var      dop-sum2          as decimal   no-undo.
     2451     define var      b-qnty            as decimal   no-undo.
     2452     define variable nottopgood        as logical   no-undo.
     2453     define variable is-real-top       as logical   no-undo .
     2454     define variable nottopsum         as decimal   no-undo.
     2455     define variable nottoppaysum      as decimal   no-undo.
     2456     define variable nottoppaysum-rubl as decimal   no-undo.
     2457     define variable nottoppaysum-base as decimal   no-undo.
     2458     define variable nottoppayexch     as decimal   no-undo.
     2459     define variable curr-b-code       like ub.bar-code.b-code no-undo.
     2460     define variable curr-is-real-top  as integer   no-undo .
     2461     define variable b-name            like ub.goods.gds-name no-undo.
     2462     define variable b-price           as decimal   no-undo.
     2463     define variable b-pricen          as decimal   no-undo.
     2464     define variable b-code-list       as char      no-undo.
     2465     define variable b-sum-list        as char      no-undo.
     2466     define variable b-price-list      as char      no-undo.
     2467     define variable b-pricen-list     as char      no-undo.
     2468     define variable b-name-list       as char      no-undo.
     2469     define variable b-qnty-list       as char      no-undo.
     2470     define variable is-real-top-list  as character no-undo .
     2471     define variable entry-num         as integer   no-undo.
     2472     define variable ii                as integer   no-undo.
     2473     define variable sign              as integer   no-undo .
     2474     for each units no-lock where
     2475       lookup( 'топ':U, units.type) > 0,
     2476       each buf_goods no-lock where
     2477       buf_goods.unit-base = units.unit-name  , each bar-code no-lock where bar-code.gds-code  = buf_goods.gds-code and bar-code.stts_ = 0
     2478       :
     2479       for each obj-list where obj-list.obj-type = 'маг':U no-lock :
     2480         accumulate obj-list.obj-code ( count ) .
     2481         run rep/rpychk0.p ( input "r-shftc2"
     2482           ,input obj-list.obj-type
     2483           ,input obj-list.obj-code
     2484           ,input ?
     2485           ,input ?
     2486           ,input X-date-start
     2487           ,input X-date-end
     2488           ,input 1
     2489           ,input 99
     2490           ,input ?
     2491           ) no-error.
     2492         if error-status:error then
     2493         do:
     2494           message error-status:get-message(1) view-as alert-box.
     2495         end.
     2496         if x-TOG-Shift then
     2497         do:
     2498           for each buf_chk-gds-pay no-lock where buf_chk-gds-pay.b-code = bar-code.b-code  and
     2499             buf_chk-gds-pay.obj-type = obj-list.obj-type and
     2500             buf_chk-gds-pay.obj-code = obj-list.obj-code and
     2501             (
     2502             buf_chk-gds-pay.shift-date >= X-date-start and
     2503             buf_chk-gds-pay.shift-date <= X-date-end) :
     2504             if ((buf_chk-gds-pay.shift-date = x-date-Start and buf_chk-gds-pay.shift-num < X-shift-start) or
     2505               (buf_chk-gds-pay.shift-date = x-date-End and  buf_chk-gds-pay.shift-num > X-shift-end) ) then next.
     2506             run  fill-behefit.
     2507           end.
     2508         end.
     2509         else
     2510         do:
     2511           for each buf_chk-gds-pay no-lock where buf_chk-gds-pay.b-code = bar-code.b-code  and
     2512             buf_chk-gds-pay.obj-type = obj-list.obj-type and
     2513             buf_chk-gds-pay.obj-code = obj-list.obj-code and
     2514             (
     2515             buf_chk-gds-pay.chk-date >= X-date-start and
     2516             buf_chk-gds-pay.chk-date <= X-date-end) :
     2517             run  fill-behefit.
     2518           end.
     2519         end.
     2520         empty temp-table benefits1 .
     2521         empty temp-table pays .
     2522         for each benefits:
     2523           find first benefits1 no-lock where
     2524             benefits1.b-code = benefits.b-code
     2525             and benefits1.pay-code = benefits.pay-code
     2526             and benefits1.curr-code = benefits.curr-code
     2527             no-error.
     2528           if not available (benefits1) then
     2529           do:
     2530             create benefits1 .
     2531             buffer-copy benefits except benefits.date_ to benefits1 .
     2532           end.
     2533           else
     2534           do:
     2535             assign
     2536               benefits1.tot-base = benefits1.tot-base + benefits.tot-base
     2537               benefits1.qnty     = benefits1.qnty +  benefits.qnty
     2538               benefits1.tot-rubl = benefits1.tot-base.
     2539             .
     2540           end.
     2541           if benefits.is-real-top <> 0 then
     2542           do:
     2543             FIND FIRST pays WHERE
     2544               pays.pay-code = benefits.pay-code NO-ERROR.
     2545             IF NOT AVAIL pays then
     2546             do:
     2547               create pays.
     2548               assign
     2549                 pays.pay-code = benefits.pay-code
     2550                 pays.pay-name = benefits.pay-name
     2551                 .
     2552             end.
     2553             assign
     2554               pays.qnty     = pays.qnty  + benefits.qnty
     2555               pays.tot-rubl = pays.tot-rubl  + benefits.tot-rubl
     2556               pays.tot-base = pays.tot-base  + benefits.tot-base
     2557               .
     2558           end.
     2559         end.
     2560       end.
     2561     end.
     2562   end procedure.
     2563   procedure fill-behefit:
     2564     case entry(1, buf_chk-gds-pay.line-type, chr(4)):
     2565       when 'топ':U then
     2566         do:
     2567           find first benefits no-lock where
     2568             benefits.b-code = bar-code.b-code
     2569             and benefits.pay-code = buf_chk-gds-pay.pay-code
     2570             and benefits.curr-code = buf_chk-gds-pay.curr-code
     2571             and benefits.date_ = buf_chk-gds-pay.chk-date
     2572             no-error.
     2573           if not avail benefits then
     2574           do:
     2575             create benefits.
     2576             assign
     2577               benefits.date_       = buf_chk-gds-pay.chk-date
     2578               benefits.b-code      = bar-code.b-code
     2579               benefits.pay-code    = buf_chk-gds-pay.pay-code
     2580               benefits.curr-code   = buf_chk-gds-pay.curr-code
     2581               benefits.gds-name    = buf_goods.gds-name
     2582               benefits.tot-sum     = 0
     2583               benefits.tot-base    = 0
     2584               benefits.tot-rubl    = 0
     2585               benefits.is-real-top = 1
     2586               .
     2587           end.
     2588           assign
     2589             benefits.tot-base = benefits.tot-base +
     2590                                                           (if v-curr-r-b = 'base':U
     2591                                                           then buf_chk-gds-pay.tot-r-b
     2592                                                           else (if  buf_chk-gds-pay.tot-r-b = 0
     2593                                                                 then 0
     2594                                                                 else buf_chk-gds-pay.tot-r-b / buf_chk-gds-pay.eff-base-rate))
     2595             benefits.qnty     = benefits.qnty +  buf_chk-gds-pay.eff-doc-qnty
     2596             benefits.tot-rubl = benefits.tot-base.
     2597           .
     2598           FIND FIRST ub.cash-pay No-LOCK WHERE ub.cash-pay.cdpay-code = benefits.pay-code No-ERROR.
     2599           IF AVAIL ub.cash-pay
     2600             then
     2601           do:
     2602             benefits.pay-name = ub.cash-pay.obj-name.
     2603           end.
     2604           else
     2605           do:
     2606             if benefits.pay-code = 0 then
     2607             do:
     2608               benefits.pay-name = "Нетопливные платежи".
     2609             end.
     2610             else
     2611             do:
     2612               benefits.pay-name = "Неопознанный платеж".
     2613             end.
     2614           end.
     2615         end.
     2616     end.
     2617   end procedure.
