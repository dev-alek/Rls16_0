     2008   procedure FindTov :
     2009     do
     2010     on error undo, return error return-value
     2011     :
     2012         find first temp-tov
     2013           where temp-tov.artic     = buf_gds-obj.artic
     2014             and temp-tov.prod-type = buf_gds-obj.prod-type
     2015             and temp-tov.prod-code = buf_gds-obj.prod-code
     2016         no-error .
     2017         if not available temp-tov then do:
     2018           create temp-tov .
     2019           assign
     2020             temp-tov.artic     = buf_gds-obj.artic
     2021             temp-tov.prod-type = buf_gds-obj.prod-type
     2022             temp-tov.prod-code = buf_gds-obj.prod-code
     2023             temp-tov.grp-code  = buf_goods.grp-code
     2024           .
     2025         end.
     2026     end.
     2027   end procedure.
     2028   procedure PutColumnTitulExcel :
     2029     do
     2030     on error undo, return error return-value
     2031     :
     2032       assign
     2033         v-row = 1
     2034         v-col = 1
     2035       .
     2036       put  stream macr_excel unformatted substitute('select("r1c1:r1c1 ")' )  skip .
     2037       put  stream macr_excel unformatted 'row.height(15,,,) '  skip .
     2038       put  stream macr_excel unformatted substitute('select("r2c1:r5c1 ")' )  skip .
     2039       put  stream macr_excel unformatted 'row.height(10.5,,,) '  skip .
     2040       put  stream macr_excel unformatted substitute('select("r6c1:r6c1 ")' )  skip .
     2041       put  stream macr_excel unformatted 'row.height(33,,,) '  skip .
     2042       run macr_cell_format1 ( 'Tahoma', 12, yes, no, ?, 1, 1, 1, 1) .
     2043       assign  v-row = v-row + 1 .
     2044       run macr_excel_char ("Оборотная ведомость по группам товаров", v-row,  v-col) .
     2045       assign  v-row = v-row + 1 .
     2046       run macr_excel_char ("Период: с " + string(p-date1,"99.99.9999") + " по " + string(p-date2 - 1,"99.99.9999"), v-row,  v-col) .
     2047       assign  v-row = v-row + 1 .
     2048       assign CurrGrpName = "Список объектов: " .
     2049       for each temp-mag:
     2050         if length(CurrGrpName) + 1 + length(temp-mag.obj-name) > 255 then do:
     2051           run macr_excel_char (CurrGrpName, v-row, v-col) .
     2052           assign  v-row = v-row + 1 .
     2053           CurrGrpName = "".
     2054       end.
     2055         assign
     2056         CurrGrpName = CurrGrpName + (if CurrGrpName = "Список объектов: "
     2057                                       or CurrGrpName = ""
     2058                                       then ''
     2059                                       else  "; ") + temp-mag.obj-name .
     2060       end.
     2061       if CurrGrpName  <> '' then do:
     2062       run macr_excel_char (CurrGrpName, v-row, v-col) .
     2063       end.
     2064       assign  v-row = v-row + 2 .
     2065       run macr_excel_char("код группы", v-row, v-col) .                        assign  v-col = v-col + 1 .
     2066       run macr_excel_char("название группы", v-row, 2) .
     2067       assign  v-col = 5.
     2068       run macr_excel_char("ассортимент, кол-во наименований", v-row, v-col) .  assign  v-col = v-col + 1 .
     2069       run macr_excel_char("остаток на начало, уч.цена", v-row, v-col) .        assign  v-col = v-col + 1 .
     2070       run macr_excel_char("приход внешний, уч.цена", v-row, v-col) .           assign  v-col = v-col + 1 .
     2071       run macr_excel_char("расход внешний, уч.цена", v-row, v-col) .           assign  v-col = v-col + 1 .
     2072       run macr_excel_char("возврат пост-ку, уч.цена", v-row, v-col) .          assign  v-col = v-col + 1 .
     2073       run macr_excel_char("реализация розничная, прод.цена", v-row, v-col) .   assign  v-col = v-col + 1 .
