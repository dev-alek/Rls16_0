     1902       run macr_excel_sum1  ( gds-gr.InExt-CostSum     , v-row, v-col, 2) . assign v-col = v-col + 1 .
     1903       run macr_excel_sum1  ( gds-gr.OutExt-CostSum    , v-row, v-col, 2) . assign v-col = v-col + 1 .
     1904       run macr_excel_sum1  ( gds-gr.RetPost-CostSum   , v-row, v-col, 2) . assign v-col = v-col + 1 .
     1905       run macr_excel_sum1  ( gds-gr.OutExtKass-SaleSum, v-row, v-col, 2) . assign v-col = v-col + 1 .
     1906       run macr_excel_sum1  ( gds-gr.OutExtKass-CostSum, v-row, v-col, 2) . assign v-col = v-col + 1 .
     1907       put stream macr_excel unformatted substitute('select("r&1c&2")', v-row , v-col ) + chr(10) .
     1908       put stream macr_excel unformatted 'format.number("#,##0.00")' + chr(10) .
     1909       put stream macr_excel unformatted substitute('formula("=(r&1c10 - r&1c11)","r&1c&2")', v-row , v-col ) skip  .
     1910       assign v-col = v-col + 1 .
