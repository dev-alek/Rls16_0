     1924       run macr_excel_sum1  ( gds-gr.InExt-Qnty        , v-row, v-col, 3) . assign v-col = v-col + 1 .
     1925       run macr_excel_sum1  ( gds-gr.OutExt-Qnty       , v-row, v-col, 3) . assign v-col = v-col + 1 .
     1926       run macr_excel_sum1  ( gds-gr.RetPost-Qnty      , v-row, v-col, 3) . assign v-col = v-col + 1 .
     1927       run macr_excel_sum1  ( gds-gr.OutExtKass-Qnty   , v-row, v-col, 3) . assign v-col = v-col + 1 .
     1928       run macr_excel_sum1  ( gds-gr.Spi-Qnty          , v-row, v-col, 3) . assign v-col = v-col + 1 .
     1929       run macr_excel_sum1  ( gds-gr.InProiz-Qnty      , v-row, v-col, 3) . assign v-col = v-col + 1 .
     1930       run macr_excel_sum1  ( gds-gr.OutProiz-Qnty     , v-row, v-col, 3) . assign v-col = v-col + 1 .
