     1963       run macr_excel_sum2  ( v-row , v-col, 2) .  assign v-col = v-col + 1 .
     1964       put stream macr_excel unformatted substitute('select("r&1c&2")', v-row , v-col ) + chr(10) .
     1965       put stream macr_excel unformatted 'format.number("#,##0.00")' + chr(10) .
     1966       put stream macr_excel unformatted substitute('formula("=(r&1c10 - r&1c11)","r&1c&2")', v-row , v-col ) skip  .
     1967       assign v-col = v-col + 1 .
     1968       put stream macr_excel unformatted substitute('select("r&1c&2")', v-row , v-col ) + chr(10) .
