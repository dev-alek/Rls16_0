     1873           gds-gr.InProiz-Qnty       = gds-gr.InProiz-Qnty       + gds-prop.InProiz-Qnty
     1874           gds-gr.InProiz-CostSum    = gds-gr.InProiz-CostSum    + gds-prop.InProiz-CostSum
     1875           gds-gr.OutProiz-Qnty      = gds-gr.OutProiz-Qnty      + gds-prop.OutProiz-Qnty
     1876           gds-gr.OutProiz-CostSum   = gds-gr.OutProiz-CostSum   + gds-prop.OutProiz-CostSum
     1877           gds-gr.num-tov            = gds-gr.num-tov            + gds-prop.num-tov
     1878         .
     1879         find first buf_gds-grp no-lock where buf_gds-grp.node-code = gds-gr.grp-code .
     1880       end.
     1881     end.
     1882     assign
     1883     v-file-name = v-file-prefix + ".txt"
     1884     .
     1885     output stream macr_excel to value(v-file-name) .
     1886     assign v-ind = v-ind + 1 .
     1887   if session :set-wait-state( "compiler" ) then.
     1888     run PutColumnTitulExcel in this-procedure .
     1889     for each gds-gr:
     1890       if gds-gr.grp-name = "" then next .
     1891       assign v-col = 1 .
     1892       run macr_excel_char ( string(gds-gr.grp-code)  , v-row, v-col) .    assign v-col = v-col + 1 .
     1893       case num-entries( right-trim(gds-gr.grp-name, chr(47)), chr(47) ) :
     1894         when 1 then assign v-col = 2 .
     1895         when 2 then assign v-col = 3 .
     1896         otherwise   assign v-col = 4 .
     1897       end.
     1898       run macr_excel_char ( gds-gr.sgrp-name          , v-row, v-col) .
     1899       assign v-col = 5 .
     1900       run macr_excel_sum1  ( gds-gr.num-tov           , v-row, v-col, 0) . assign v-col = v-col + 1 .
