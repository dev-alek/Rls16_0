     1916       put stream macr_excel unformatted 'format.number("0.00%")' + chr(10) .
     1917       put stream macr_excel unformatted substitute('formula("=(r&1c10 - r&1c11)/r&1c10","r&1c&2")', v-row , v-col ) skip  .
     1918       assign v-col = v-col + 1 .
     1919       run macr_excel_sum1  ( gds-gr.Spi-CostSum       , v-row, v-col, 2) . assign v-col = v-col + 1 .
     1920       run macr_excel_sum1  ( gds-gr.InProiz-CostSum   , v-row, v-col, 2) . assign v-col = v-col + 1 .
