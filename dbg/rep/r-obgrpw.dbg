     2077       run macr_excel_char("маржа розничная", v-row, v-col) .                   assign  v-col = v-col + 1 .
     2078       run macr_excel_char("списано, уч.цена", v-row, v-col) .                  assign  v-col = v-col + 1 .
     2079       run macr_excel_char("приход про-во, уч.цена", v-row, v-col) .            assign  v-col = v-col + 1 .
     2080       run macr_excel_char("расход про-во, уч.цена", v-row, v-col) .            assign  v-col = v-col + 1 .
