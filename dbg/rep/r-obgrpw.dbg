     2113       put  stream macr_excel unformatted  substitute('select("r&1c&2:r&3c&4 ")' , v-row , 2 , v-row , 2 ) skip .
     2114       put  stream macr_excel unformatted 'BORDER( 0, 7, 0, 1, 1, ,0,0,0,0,0) '  skip .
