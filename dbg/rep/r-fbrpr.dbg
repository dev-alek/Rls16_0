     3236   procedure fbrrep-fill-qnty-and-prices-gds :
     3237   do
     3238   on error undo, return error
     3239   :
     3240   define input parameter p-fbr-doc-doc-code   as character    no-undo.
     3241   define input parameter p-gds-code           as integer      no-undo.
     3242       define variable v-sign      as decimal       no-undo.
