     2531         if other-base-loc     = ? then other-base-loc     = 0.
     2532         if other-rubl-loc     = ? then other-rubl-loc     = 0.
     2533         assign
     2534           transport-cli-loc      = 0
     2535           other-cli-loc          = 0
     2536           road-tax-cli-loc       = ?
     2537           vat-cli-loc            = ?
     2538           slt-cli-loc            = ?
     2539           price-cli-with-tax-loc = ?.
     2540      end.
     2541   ASSIGN
     2542             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     2543       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     2544   .
     2545           assign
     2546               v-vat-pc              = vat-pc-loc
     2547               v-slt-pc              = slt-pc-loc
     2548           .
     2549       end.
     2550       else do:
     2551             assign
     2552               v-parts-fact-qnty           = (if buf_trn-doc.doc-type = 'при':U
     2553                                         or buf_trn-doc.doc-type = 'возврат':U
     2554                                         or buf_trn-doc.doc-type = 'инв':U
     2555                                         then buf_doc-line.fact-qnty
     2556                                         else - buf_doc-line.fact-qnty
     2557                                       )
     2558             .
     2559   assign
     2560     price-rubl-with-tax-loc = buf_doc-line.price-rubl
     2561     price-base-with-tax-loc = buf_doc-line.price-base
     2562   .
     2563   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2564   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2565     (output varinvprb
     2566     )  .
     2567      find first in-vatp_doc-attr no-lock
     2568       where in-vatp_doc-attr.doc-code  = buf_trn-doc.doc-code
     2569         and in-vatp_doc-attr.attr-code = 'envd':U
     2570       no-error .
     2571       if available in-vatp_doc-attr
     2572          then do:
     2573          assign
     2574            in-vatp-have-vat-slt = no.
     2575      end.
     2576      else do:
     2577        assign
     2578          in-vatp-have-vat-slt = yes.
     2579      end.
     2580      find first in-vatp-goods where in-vatp-goods.artic     = buf_doc-line.artic     and
     2581                                        in-vatp-goods.prod-type = buf_doc-line.prod-type and
     2582                                        in-vatp-goods.prod-code = buf_doc-line.prod-code no-lock.
     2583      if (not buf_trn-doc.internal and
     2584              buf_trn-doc.doc-type = 'при':U) or
     2585         in-vatp-goods.gds-type = 'у':U then do:
     2586         if varinvprb = "base":u then do:
     2587           assign
     2588             road-tax-base-loc = buf_doc-line.road-tax
     2589             road-tax-rubl-loc = buf_doc-line.road-tax * buf_trn-doc.base-rate / buf_trn-doc.base-scale.
     2590         end.
     2591         else do:
     2592           ASSIGN
     2593             road-tax-rubl-loc = buf_doc-line.road-tax
     2594             road-tax-base-loc = buf_doc-line.road-tax / buf_trn-doc.base-rate * buf_trn-doc.base-scale.
     2595         end.
     2596         if road-tax-base-loc = ? then road-tax-base-loc = 0.
     2597         if road-tax-rubl-loc = ? then road-tax-rubl-loc = 0.
     2598         assign
     2599           road-tax-cli-loc = ?.
     2600         ASSIGN
     2601           transport-base-loc = (if buf_doc-line.transport-base = ? then 0 else buf_doc-line.transport-base)
     2602           transport-rubl-loc = (if buf_doc-line.transport-rubl = ? then 0 else buf_doc-line.transport-rubl)
     2603           transport-cli-loc  = 0
     2604           other-base-loc     = (if buf_doc-line.other-base     = ? then 0 else buf_doc-line.other-base)
     2605           other-rubl-loc     = (if buf_doc-line.other-rubl     = ? then 0 else buf_doc-line.other-rubl)
     2606           other-cli-loc      = 0
     2607           vat-pc-loc         = (if buf_doc-line.vat-pc         = ? then 0 else buf_doc-line.vat-pc)
     2608           slt-pc-loc         = (if buf_doc-line.slt-pc         = ? then 0 else buf_doc-line.slt-pc).
     2609                                 ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     2610               ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     2611         assign
     2612           vat-cli-loc            = ?
     2613           slt-cli-loc            = ?
     2614           price-cli-with-tax-loc = ?.
     2615      end.
     2616      else do:
     2617                                                   for each in-vatp-parts where in-vatp-parts.out-code  = buf_doc-line.doc-code  and
     2618                                         in-vatp-parts.obj-type  = buf_doc-line.obj-type  and
     2619                                         in-vatp-parts.obj-code  = buf_doc-line.obj-code  and
     2620                                         in-vatp-parts.artic     = buf_doc-line.artic     and
     2621                                         in-vatp-parts.prod-type = buf_doc-line.prod-type and
     2622                                         in-vatp-parts.prod-code = buf_doc-line.prod-code
     2623                            use-index out-code no-lock:
     2624             accumulate  in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty (total)
     2625                         in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty (total)
     2626                         in-vatp-parts.transport-base * in-vatp-parts.fact-qnty (total)
     2627                         in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty (total)
     2628                         in-vatp-parts.other-base     * in-vatp-parts.fact-qnty (total)
     2629                         in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty (total)
     2630                                                                                                                 (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  (total)
     2631                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
     2632                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))  (total)
     2633                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc))  (total)
     2634                                               (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  (total)
     2635                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
     2636                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))  (total)
     2637                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc))  (total)
     2638                         .
     2639         end.
     2640         ASSIGN
     2641           road-tax-base-loc   = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     2642           road-tax-rubl-loc   = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     2643           transport-base-loc  = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-base * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     2644           transport-rubl-loc  = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     2645           other-base-loc      = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-base     * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     2646           other-rubl-loc      = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     2647                                           vat-base-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / buf_doc-line.fact-qnty   else 0
     2648           slt-base-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / buf_doc-line.fact-qnty   else 0
     2649                   vat-rubl-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / buf_doc-line.fact-qnty   else 0
     2650           slt-rubl-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / buf_doc-line.fact-qnty   else 0
     2651           vat-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc)))
     2652           slt-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))).
     2653         if road-tax-base-loc  = ? then road-tax-base-loc  = 0.
     2654         if road-tax-rubl-loc  = ? then road-tax-rubl-loc  = 0.
     2655         if transport-base-loc = ? then transport-base-loc = 0.
     2656         if transport-rubl-loc = ? then transport-rubl-loc = 0.
     2657         if other-base-loc     = ? then other-base-loc     = 0.
     2658         if other-rubl-loc     = ? then other-rubl-loc     = 0.
     2659         assign
     2660           transport-cli-loc      = 0
     2661           other-cli-loc          = 0
     2662           road-tax-cli-loc       = ?
     2663           vat-cli-loc            = ?
     2664           slt-cli-loc            = ?
     2665           price-cli-with-tax-loc = ?.
     2666      end.
     2667   ASSIGN
     2668             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     2669       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     2670   .
     2671             assign
     2672               v-fact-qnty           = v-fact-qnty      + v-parts-fact-qnty
     2673               v-vat-pc              = vat-pc-loc
     2674               v-slt-pc              = slt-pc-loc
     2675               v-sum-base            = v-sum-base       + (price-base-with-tax-loc * v-parts-fact-qnty)
     2676               v-sum-rubl            = v-sum-rubl       + (price-rubl-with-tax-loc * v-parts-fact-qnty)
     2677               v-vat-base            = v-vat-base       + (vat-base-loc            * v-parts-fact-qnty)
     2678               v-vat-rubl            = v-vat-rubl       + (vat-rubl-loc            * v-parts-fact-qnty)
     2679               v-slt-base            = v-slt-base       + (slt-base-loc            * v-parts-fact-qnty)
     2680               v-slt-rubl            = v-slt-rubl       + (slt-rubl-loc            * v-parts-fact-qnty)
     2681               v-road-tax-base       =  0
     2682               v-road-tax-rubl       =  0
     2683               v-excise-base         =  0
     2684               v-excise-rubl         =  0
     2685               v-transport-base      =  0
     2686               v-transport-rubl      =  0
     2687               v-other-base          =  0
     2688               v-other-rubl          =  0
     2689             .
     2690       end.
     2691     end.
     2692   end procedure.
     2693   procedure fbrrep-fill-qnty-and-prices :
     2694   do
     2695   on error undo, return error
     2696   :
     2697   define input parameter p-fbr-doc-doc-code  as character    no-undo.
     2698       define variable v-gds-code  as integer       no-undo.
     2699       define variable v-gds-name  as character     no-undo.
     2700       define variable v-sign      as decimal       no-undo.
     2701       define buffer buf_fbr-line          for ub.fbr-line.
     2702       define buffer buf_temp_fbrrep-goods for temp_fbrrep-goods.
     2703       for each buf_fbr-line no-lock
     2704          where buf_fbr-line.doc-code = p-fbr-doc-doc-code
     2705       on error undo, return error
     2706       :
     2707           find first buf_temp_fbrrep-goods
     2708                where buf_temp_fbrrep-goods.artic     = buf_fbr-line.artic
     2709                  and buf_temp_fbrrep-goods.prod-type = buf_fbr-line.prod-type
     2710                  and buf_temp_fbrrep-goods.prod-code = buf_fbr-line.prod-code
     2711           use-index ar
     2712           no-error.
     2713           if not available buf_temp_fbrrep-goods
     2714           then do:
     2715               create buf_temp_fbrrep-goods.
     2716   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2717   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     2718     (input  buf_fbr-line.artic
     2719     ,input  buf_fbr-line.prod-type
     2720     ,input  buf_fbr-line.prod-code
     2721     ,output v-gds-code
     2722     )  .
     2723   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2724   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-arnm in g#library
     2725     (input  buf_fbr-line.artic
     2726     ,input  buf_fbr-line.prod-type
     2727     ,input  buf_fbr-line.prod-code
     2728     ,output v-gds-name
     2729     )  .
     2730   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2731   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     2732     (input  buf_fbr-line.artic
     2733     ,input  buf_fbr-line.prod-type
     2734     ,input  buf_fbr-line.prod-code
     2735     ,input  'gds-goods=request':u
     2736     ,output buf_temp_fbrrep-goods.is-not-office
     2737     )  .
     2738               assign
     2739                   buf_temp_fbrrep-goods.gds-code             = v-gds-code
     2740                   buf_temp_fbrrep-goods.artic                = buf_fbr-line.artic
     2741                   buf_temp_fbrrep-goods.prod-type            = buf_fbr-line.prod-type
     2742                   buf_temp_fbrrep-goods.prod-code            = buf_fbr-line.prod-code
     2743                   buf_temp_fbrrep-goods.gds-name             = v-gds-name
     2744                   buf_temp_fbrrep-goods.is-waste             = buf_fbr-line.is-waste
     2745                   buf_temp_fbrrep-goods.fact-qnty            = 0
     2746                   buf_temp_fbrrep-goods.write-off-rsrv-qnty  = 0
     2747                   buf_temp_fbrrep-goods.write-off-qnty       = 0
     2748                   buf_temp_fbrrep-goods.income-qnty          = 0
     2749                   buf_temp_fbrrep-goods.income-rsrv-qnty     = 0
     2750                   buf_temp_fbrrep-goods.cost-rubl            = 0
     2751                   buf_temp_fbrrep-goods.cost-base            = 0
     2752                   buf_temp_fbrrep-goods.sum-cost-rubl        = 0
     2753                   buf_temp_fbrrep-goods.sum-cost-base        = 0
     2754                   buf_temp_fbrrep-goods.vat-cost-rubl        = 0
     2755                   buf_temp_fbrrep-goods.vat-cost-base        = 0
     2756                   buf_temp_fbrrep-goods.sum-vat-cost-rubl    = 0
     2757                   buf_temp_fbrrep-goods.sum-vat-cost-base    = 0
     2758                   buf_temp_fbrrep-goods.price-sale           = buf_fbr-line.price-sale
     2759                   buf_temp_fbrrep-goods.deleted              = no
     2760               .
     2761   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2762   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run unitbase in g#library
     2763     (input  v-gds-code
     2764     ,output buf_temp_fbrrep-goods.unit-base
     2765     )  .
     2766           end.
     2767           case buf_fbr-line.trn-type
     2768           :
     2769               when 'при':U
     2770               then do:
     2771                   assign
     2772                       v-sign                                  = 1
     2773                       buf_temp_fbrrep-goods.income-qnty       = buf_temp_fbrrep-goods.income-qnty     + buf_fbr-line.fact-qnty
     2774                   .
     2775                   if buf_fbr-line.rsrv-qnty <> ?
     2776                   then do:
     2777                       assign
     2778                           buf_temp_fbrrep-goods.income-rsrv-qnty = buf_temp_fbrrep-goods.income-rsrv-qnty   + buf_fbr-line.rsrv-qnty
     2779                       .
     2780                   end.
     2781               end.
     2782               when 'спи':U
     2783               then do:
     2784                   assign
     2785                       v-sign                                  = -1
     2786                       buf_temp_fbrrep-goods.write-off-qnty    = buf_temp_fbrrep-goods.write-off-qnty  + buf_fbr-line.fact-qnty
     2787                   .
     2788                   if buf_fbr-line.rsrv-qnty <> ?
     2789                   then do:
     2790                       assign
     2791                           buf_temp_fbrrep-goods.write-off-rsrv-qnty = buf_temp_fbrrep-goods.write-off-rsrv-qnty   + buf_fbr-line.rsrv-qnty
     2792                       .
     2793                   end.
     2794               end.
     2795           end case.
     2796           assign
     2797               buf_temp_fbrrep-goods.sum-cost-rubl        = buf_temp_fbrrep-goods.sum-cost-rubl     + v-sign * buf_fbr-line.price-sum-rubl
     2798               buf_temp_fbrrep-goods.sum-cost-base        = buf_temp_fbrrep-goods.sum-cost-base     + v-sign * buf_fbr-line.price-sum-base
     2799               buf_temp_fbrrep-goods.sum-vat-cost-rubl    = buf_temp_fbrrep-goods.sum-vat-cost-rubl + v-sign * buf_fbr-line.price-sum-vat-rubl
     2800               buf_temp_fbrrep-goods.sum-vat-cost-base    = buf_temp_fbrrep-goods.sum-vat-cost-base + v-sign * buf_fbr-line.price-sum-vat-base
     2801           .
     2802       end.
     2803       run test-temp-tables in this-procedure .
     2804   end.
     2805   end procedure.
     2806   procedure fbrrep-fill-for-fbr-actp :
     2807   do
     2808   on error undo, return error
     2809   :
     2810   define input parameter p-fbr-doc-doc-code  as character    no-undo.
     2811       define buffer buf_temp_fbrrep-goods for temp_fbrrep-goods.
     2812       define buffer buf_fbr-line          for ub.fbr-line.
     2813       run fbrrep-fill-qnty-and-prices in this-procedure (
     2814           input p-fbr-doc-doc-code
     2815       ).
     2816       for each buf_temp_fbrrep-goods
     2817       :
     2818           assign
     2819               buf_temp_fbrrep-goods.sum-cost-rubl     = 0
     2820               buf_temp_fbrrep-goods.sum-cost-base     = 0
     2821               buf_temp_fbrrep-goods.sum-vat-cost-rubl = 0
     2822               buf_temp_fbrrep-goods.sum-vat-cost-base = 0
     2823               buf_temp_fbrrep-goods.cost-rubl     = 0
     2824               buf_temp_fbrrep-goods.cost-base     = 0
     2825               buf_temp_fbrrep-goods.vat-cost-rubl = 0
     2826               buf_temp_fbrrep-goods.vat-cost-base = 0
     2827           .
     2828           if buf_temp_fbrrep-goods.income-qnty = 0
     2829           or buf_temp_fbrrep-goods.write-off-qnty = 0
     2830           then do:
     2831               assign
     2832                   buf_temp_fbrrep-goods.deleted   = yes
     2833                   buf_temp_fbrrep-goods.fact-qnty = 0
     2834               .
     2835           end.
     2836           else do:
     2837               if buf_temp_fbrrep-goods.income-qnty <= buf_temp_fbrrep-goods.write-off-qnty
     2838               then do:
     2839                   assign
     2840                       buf_temp_fbrrep-goods.fact-qnty = buf_temp_fbrrep-goods.income-qnty
     2841                   .
     2842                   for each buf_fbr-line no-lock
     2843                      where buf_fbr-line.doc-code  = p-fbr-doc-doc-code
     2844                        and buf_fbr-line.artic     = buf_temp_fbrrep-goods.artic
     2845                        and buf_fbr-line.prod-type = buf_temp_fbrrep-goods.prod-type
     2846                        and buf_fbr-line.prod-code = buf_temp_fbrrep-goods.prod-code
     2847                        and buf_fbr-line.trn-type  = 'при':U
     2848                   :
     2849                       assign
     2850                           buf_temp_fbrrep-goods.sum-cost-rubl     = buf_temp_fbrrep-goods.sum-cost-rubl     + buf_fbr-line.price-sum-rubl
     2851                           buf_temp_fbrrep-goods.sum-cost-base     = buf_temp_fbrrep-goods.sum-cost-base     + buf_fbr-line.price-sum-base
     2852                           buf_temp_fbrrep-goods.sum-vat-cost-rubl = buf_temp_fbrrep-goods.sum-vat-cost-rubl + buf_fbr-line.price-sum-vat-rubl
     2853                           buf_temp_fbrrep-goods.sum-vat-cost-base = buf_temp_fbrrep-goods.sum-vat-cost-base + buf_fbr-line.price-sum-vat-base
     2854                       .
     2855                   end.
     2856                   assign
     2857                       buf_temp_fbrrep-goods.cost-rubl     = buf_temp_fbrrep-goods.sum-cost-rubl     / buf_temp_fbrrep-goods.fact-qnty
     2858                       buf_temp_fbrrep-goods.cost-base     = buf_temp_fbrrep-goods.sum-cost-base     / buf_temp_fbrrep-goods.fact-qnty
     2859                       buf_temp_fbrrep-goods.vat-cost-rubl = buf_temp_fbrrep-goods.sum-vat-cost-rubl / buf_temp_fbrrep-goods.fact-qnty
     2860                       buf_temp_fbrrep-goods.vat-cost-base = buf_temp_fbrrep-goods.sum-vat-cost-base / buf_temp_fbrrep-goods.fact-qnty
     2861                   .
     2862               end.
     2863               else do:
     2864                   assign
     2865                       buf_temp_fbrrep-goods.fact-qnty = buf_temp_fbrrep-goods.write-off-qnty
     2866                   .
     2867                   for each buf_fbr-line no-lock
     2868                      where buf_fbr-line.doc-code  = p-fbr-doc-doc-code
     2869                        and buf_fbr-line.artic     = buf_temp_fbrrep-goods.artic
     2870                        and buf_fbr-line.prod-type = buf_temp_fbrrep-goods.prod-type
     2871                        and buf_fbr-line.prod-code = buf_temp_fbrrep-goods.prod-code
     2872                        and buf_fbr-line.trn-type  = 'спи':U
     2873                   :
     2874                       assign
     2875                           buf_temp_fbrrep-goods.sum-cost-rubl     = buf_temp_fbrrep-goods.sum-cost-rubl     + buf_fbr-line.price-sum-rubl
     2876                           buf_temp_fbrrep-goods.sum-cost-base     = buf_temp_fbrrep-goods.sum-cost-base     + buf_fbr-line.price-sum-base
     2877                           buf_temp_fbrrep-goods.sum-vat-cost-rubl = buf_temp_fbrrep-goods.sum-vat-cost-rubl + buf_fbr-line.price-sum-vat-rubl
     2878                           buf_temp_fbrrep-goods.sum-vat-cost-base = buf_temp_fbrrep-goods.sum-vat-cost-base + buf_fbr-line.price-sum-vat-base
     2879                       .
     2880                   end.
     2881                   assign
     2882                       buf_temp_fbrrep-goods.cost-rubl     = buf_temp_fbrrep-goods.sum-cost-rubl     / buf_temp_fbrrep-goods.fact-qnty
     2883                       buf_temp_fbrrep-goods.cost-base     = buf_temp_fbrrep-goods.sum-cost-base     / buf_temp_fbrrep-goods.fact-qnty
     2884                       buf_temp_fbrrep-goods.vat-cost-rubl = buf_temp_fbrrep-goods.sum-vat-cost-rubl / buf_temp_fbrrep-goods.fact-qnty
     2885                       buf_temp_fbrrep-goods.vat-cost-base = buf_temp_fbrrep-goods.sum-vat-cost-base / buf_temp_fbrrep-goods.fact-qnty
     2886                   .
     2887               end.
     2888           end.
     2889       end.
     2890       for each buf_temp_fbrrep-goods
     2891          where buf_temp_fbrrep-goods.deleted = yes
     2892       on error undo, return error
     2893       :
     2894           delete buf_temp_fbrrep-goods.
     2895       end.
     2896       run test-temp-tables in this-procedure .
     2897   end.
     2898   end procedure.
     2899   procedure fbrrep-fill-for-op-del :
     2900   do
     2901   on error undo, return error
     2902   :
     2903   define input parameter p-fbr-doc-doc-code   as character    no-undo.
     2904   define input parameter p-db-remote          as logical          no-undo.
     2905       define variable v-serv-code as character    no-undo.
     2906       define variable v-in-code   as character    no-undo.
     2907       define variable v-out-code  as character    no-undo.
     2908       define variable v-trn-qnty  as decimal       no-undo.
     2909       define variable v-sign      as decimal       no-undo.
     2910       define variable v-qnty      as decimal       no-undo.
     2911       define buffer buf_fbr-doc           for ub.fbr-doc.
     2912       define buffer buf_fbr-line          for ub.fbr-line.
     2913       define buffer buf_goods             for ub.goods .
     2914       define buffer buf_doc-line          for ub.doc-line .
     2915       define buffer buf_temp_fbrrep-goods for temp_fbrrep-goods .
     2916       run fbrrep-fill-qnty-and-prices in this-procedure (
     2917           input p-fbr-doc-doc-code
     2918       ).
     2919       for each buf_temp_fbrrep-goods
     2920       on error undo, return error
     2921       :
     2922           if buf_temp_fbrrep-goods.income-qnty <> 0
     2923           or buf_temp_fbrrep-goods.write-off-qnty <> 0
     2924           then do:
     2925               assign
     2926                   v-qnty  = ( buf_temp_fbrrep-goods.write-off-qnty - buf_temp_fbrrep-goods.income-qnty )
     2927               .
     2928               if v-qnty = 0
     2929               then do:
     2930                   find first buf_fbr-line no-lock
     2931                        where buf_fbr-line.doc-code    = p-fbr-doc-doc-code
     2932                          and buf_fbr-line.artic       = buf_temp_fbrrep-goods.artic
     2933                          and buf_fbr-line.prod-type   = buf_temp_fbrrep-goods.prod-type
     2934                          and buf_fbr-line.prod-code   = buf_temp_fbrrep-goods.prod-code
     2935                          and buf_fbr-line.fact-qnty   <> 0
     2936                   no-error.
     2937                   if available buf_fbr-line
     2938                   then do:
     2939                       assign
     2940                           buf_temp_fbrrep-goods.cost-rubl     = buf_fbr-line.price-rubl
     2941                           buf_temp_fbrrep-goods.cost-base     = buf_fbr-line.price-base
     2942                           buf_temp_fbrrep-goods.vat-cost-rubl = buf_fbr-line.price-sum-vat-rubl / buf_fbr-line.fact-qnty
     2943                           buf_temp_fbrrep-goods.vat-cost-base = buf_fbr-line.price-sum-vat-base / buf_fbr-line.fact-qnty
     2944                       .
     2945                   end.
     2946                   else do:
     2947                       assign
     2948                           buf_temp_fbrrep-goods.cost-rubl     = 0
     2949                           buf_temp_fbrrep-goods.cost-base     = 0
     2950                           buf_temp_fbrrep-goods.vat-cost-rubl = 0
     2951                           buf_temp_fbrrep-goods.vat-cost-base = 0
     2952                       .
     2953                   end.
     2954               end.
     2955               else do:
     2956                   assign
     2957                       buf_temp_fbrrep-goods.cost-rubl     = buf_temp_fbrrep-goods.sum-cost-rubl     / v-qnty
     2958                       buf_temp_fbrrep-goods.cost-base     = buf_temp_fbrrep-goods.sum-cost-base     / v-qnty
     2959                       buf_temp_fbrrep-goods.vat-cost-rubl = buf_temp_fbrrep-goods.sum-vat-cost-rubl / v-qnty
     2960                       buf_temp_fbrrep-goods.vat-cost-base = buf_temp_fbrrep-goods.sum-vat-cost-base / v-qnty
     2961                   .
     2962               end.
     2963           end.
     2964           else do:
     2965               assign
     2966                   buf_temp_fbrrep-goods.cost-rubl     = 0
     2967                   buf_temp_fbrrep-goods.cost-base     = 0
     2968                   buf_temp_fbrrep-goods.vat-cost-rubl = 0
     2969                   buf_temp_fbrrep-goods.vat-cost-base = 0
     2970               .
     2971           end.
     2972       end.
     2973       for each buf_temp_fbrrep-goods
     2974       :
     2975           if buf_temp_fbrrep-goods.is-waste = yes
     2976           then do:
     2977               assign
     2978                   buf_temp_fbrrep-goods.deleted = yes
     2979               .
     2980           end.
     2981           else do:
     2982               if buf_temp_fbrrep-goods.write-off-qnty <> 0
     2983               and buf_temp_fbrrep-goods.income-qnty <> 0
     2984               then do:
     2985                   if buf_temp_fbrrep-goods.write-off-qnty = buf_temp_fbrrep-goods.income-qnty
     2986                   then do:
     2987                       assign
     2988                           buf_temp_fbrrep-goods.deleted = yes
     2989                       .
     2990                   end.
     2991                   else do:
     2992                       if buf_temp_fbrrep-goods.write-off-qnty > buf_temp_fbrrep-goods.income-qnty
     2993                       then do:
     2994                           assign
     2995                               buf_temp_fbrrep-goods.write-off-qnty    = buf_temp_fbrrep-goods.write-off-qnty - buf_temp_fbrrep-goods.income-qnty
     2996                               buf_temp_fbrrep-goods.income-qnty       = 0
     2997                           .
     2998                       end.
     2999                       else do:
     3000                           assign
     3001                               buf_temp_fbrrep-goods.income-qnty       = buf_temp_fbrrep-goods.income-qnty - buf_temp_fbrrep-goods.write-off-qnty
     3002                               buf_temp_fbrrep-goods.write-off-qnty    = 0
     3003                           .
     3004                       end.
     3005                   end.
     3006               end.
     3007           end.
     3008       end.
     3009       for each buf_temp_fbrrep-goods
     3010          where buf_temp_fbrrep-goods.deleted = yes
     3011       on error undo, return error
     3012       :
     3013           delete buf_temp_fbrrep-goods.
     3014       end.
     3015       run test-temp-tables in this-procedure .
     3016       find first buf_fbr-doc no-lock
     3017            where buf_fbr-doc.doc-code = p-fbr-doc-doc-code
     3018       .
     3019       assign
     3020           v-out-code = p-fbr-doc-doc-code
     3021       .
     3022       run doc-code in this-procedure (
     3023             input  "pair"
     3024           , input  buf_fbr-doc.obj-type
     3025           , input  buf_fbr-doc.obj-code
     3026           , input  v-out-code
     3027           , output v-in-code
     3028       ) no-error.
     3029       if error-status:error
     3030       then do:
     3031           message
     3032                    vss-workfile vss-revision vss-description
     3033               skip "Ошибка вычисления номера приходной накладной."
     3034               skip return-value
     3035               skip trim(error-status :get-message(1))
     3036                    trim(error-status :get-message(2))
     3037                    trim(error-status :get-message(3))
     3038           view-as alert-box error.
     3039           undo, return error .
     3040       end.
     3041       run doc-code in this-procedure (
     3042             input  "trio"
     3043           , input  buf_fbr-doc.obj-type
     3044           , input  buf_fbr-doc.obj-code
     3045           , input  v-in-code
     3046           , output v-serv-code
     3047       ) no-error.
     3048       if error-status:error
     3049       then do:
     3050           message
     3051                    vss-workfile vss-revision vss-description
     3052               skip "Ошибка вычисления номера накладной расхода."
     3053               skip return-value
     3054               skip trim(error-status :get-message(1))
     3055                    trim(error-status :get-message(2))
     3056                    trim(error-status :get-message(3))
     3057           view-as alert-box error.
     3058           undo, return error .
     3059       end.
     3060       for each buf_temp_fbrrep-goods
     3061       on error undo, return error
     3062       :
     3063           if buf_temp_fbrrep-goods.income-qnty > buf_temp_fbrrep-goods.write-off-qnty
     3064           then do:
     3065               find first buf_doc-line no-lock
     3066                    where buf_doc-line.doc-code  = v-in-code
     3067                      and buf_doc-line.artic     = buf_temp_fbrrep-goods.artic
     3068                      and buf_doc-line.prod-type = buf_temp_fbrrep-goods.prod-type
     3069                      and buf_doc-line.prod-code = buf_temp_fbrrep-goods.prod-code
     3070               no-error.
     3071               if available buf_doc-line
     3072               then do:
     3073                   assign
     3074                       buf_temp_fbrrep-goods.fact-qnty = buf_temp_fbrrep-goods.income-qnty - buf_doc-line.doc-qnty
     3075                   .
     3076               end.
     3077               else do:
     3078                   assign
     3079                       buf_temp_fbrrep-goods.fact-qnty = buf_temp_fbrrep-goods.income-qnty
     3080                   .
     3081               end.
     3082           end.
     3083           else do:
     3084               if buf_temp_fbrrep-goods.is-not-office = no
     3085               then do:
     3086                   find first buf_doc-line no-lock
     3087                        where buf_doc-line.doc-code  = v-serv-code
     3088                          and buf_doc-line.artic     = buf_temp_fbrrep-goods.artic
     3089                          and buf_doc-line.prod-type = buf_temp_fbrrep-goods.prod-type
     3090                          and buf_doc-line.prod-code = buf_temp_fbrrep-goods.prod-code
     3091                   no-error.
     3092               end.
     3093               else do:
     3094                   find first buf_doc-line no-lock
     3095                        where buf_doc-line.doc-code  = v-out-code
     3096                          and buf_doc-line.artic     = buf_temp_fbrrep-goods.artic
     3097                          and buf_doc-line.prod-type = buf_temp_fbrrep-goods.prod-type
     3098                          and buf_doc-line.prod-code = buf_temp_fbrrep-goods.prod-code
     3099                   no-error.
     3100               end.
     3101               if available buf_doc-line
     3102               then do:
     3103                   assign
     3104                       buf_temp_fbrrep-goods.fact-qnty = buf_temp_fbrrep-goods.write-off-qnty - buf_doc-line.doc-qnty
     3105                   .
     3106               end.
     3107               else do:
     3108                   assign
     3109                       buf_temp_fbrrep-goods.fact-qnty = buf_temp_fbrrep-goods.write-off-qnty
     3110                   .
     3111               end.
     3112           end.
     3113           if available buf_doc-line
     3114           then do:
     3115               define variable v-void              as decimal       no-undo.
     3116               define variable v-fact-qnty         as decimal       no-undo.
     3117               define variable v-sum-base          as decimal       no-undo.
     3118               define variable v-sum-rubl          as decimal       no-undo.
     3119               define variable v-vat-base          as decimal       no-undo.
     3120               define variable v-vat-rubl          as decimal       no-undo.
     3121               define variable v-slt-base          as decimal       no-undo.
     3122               define variable v-slt-rubl          as decimal       no-undo.
     3123               define variable v-road-tax-base     as decimal       no-undo.
     3124               define variable v-road-tax-rubl     as decimal       no-undo.
     3125               define variable v-transport-base    as decimal       no-undo.
     3126               define variable v-transport-rubl    as decimal       no-undo.
     3127               define variable v-other-base        as decimal       no-undo.
     3128               define variable v-other-rubl        as decimal       no-undo.
     3129               define variable v-excise-base       as decimal       no-undo.
     3130               define variable v-excise-rubl       as decimal       no-undo.
     3131               run r-cost in this-procedure (
     3132                     input buf_doc-line.doc-code
     3133                   , input buf_doc-line.artic
     3134                   , input buf_doc-line.prod-type
     3135                   , input buf_doc-line.prod-code
     3136                   , output v-fact-qnty
     3137                   , output v-void
     3138                   , output v-void
     3139                   , output v-sum-base
     3140                   , output v-sum-rubl
     3141                   , output v-vat-base
     3142                   , output v-vat-rubl
     3143                   , output v-slt-base
     3144                   , output v-slt-rubl
     3145                   , output v-road-tax-base
     3146                   , output v-road-tax-rubl
     3147                   , output v-transport-base
     3148                   , output v-transport-rubl
     3149                   , output v-other-base
     3150                   , output v-other-rubl
     3151                   , output v-excise-base
     3152                   , output v-excise-rubl
     3153               ).
     3154               assign
     3155                   v-sign = ( if v-fact-qnty >= 0 then 1 else -1 )
     3156               .
     3157               assign
     3158                   v-sum-rubl = v-sum-rubl - v-vat-rubl - v-slt-rubl - v-road-tax-rubl - v-transport-rubl - v-other-rubl - v-excise-rubl
     3159                   v-sum-base = v-sum-base - v-vat-base - v-slt-base - v-road-tax-base - v-transport-base - v-other-base - v-excise-base
     3160                   v-sum-rubl = v-sum-rubl   * v-sign
     3161                   v-sum-base = v-sum-base   * v-sign
     3162                   v-vat-rubl = v-vat-rubl   * v-sign
     3163                   v-vat-base = v-vat-base   * v-sign
     3164                   v-fact-qnty = v-fact-qnty * v-sign
     3165               .
     3166               output to "fbrrep.txt" append .
     3167               put unformatted skip(1) v-fact-qnty "   " v-sum-rubl "    " v-vat-rubl.
     3168               output close.
     3169               assign
     3170                   buf_temp_fbrrep-goods.sum-cost-rubl     = absolute( buf_temp_fbrrep-goods.cost-rubl     * v-fact-qnty ) - absolute( v-sum-rubl )
     3171                   buf_temp_fbrrep-goods.sum-cost-base     = absolute( buf_temp_fbrrep-goods.cost-base     * v-fact-qnty ) - absolute( v-sum-base )
     3172                   buf_temp_fbrrep-goods.sum-vat-cost-rubl = absolute( buf_temp_fbrrep-goods.vat-cost-rubl * v-fact-qnty ) - absolute( v-vat-rubl )
     3173                   buf_temp_fbrrep-goods.sum-vat-cost-base = absolute( buf_temp_fbrrep-goods.vat-cost-base * v-fact-qnty ) - absolute( v-vat-base )
     3174               .
     3175               if buf_temp_fbrrep-goods.fact-qnty          = 0
     3176               and buf_temp_fbrrep-goods.sum-cost-rubl     = 0
     3177               and buf_temp_fbrrep-goods.sum-cost-base     = 0
     3178               and buf_temp_fbrrep-goods.sum-vat-cost-rubl = 0
     3179               and buf_temp_fbrrep-goods.sum-vat-cost-base = 0
     3180               then do:
     3181                   assign
     3182                       buf_temp_fbrrep-goods.deleted = yes
     3183                   .
     3184               end.
     3185           end.
     3186       end.
     3187       for each buf_temp_fbrrep-goods
     3188          where buf_temp_fbrrep-goods.deleted = yes
     3189       on error undo, return error
     3190       :
     3191           delete buf_temp_fbrrep-goods.
     3192       end.
     3193       run test-temp-tables in this-procedure .
     3194   end.
     3195   end procedure.
     3196   procedure test-temp-tables :
     3197   do
     3198   on error undo, return error
     3199   :
     3200       define variable v-str   as character     no-undo.
     3201       assign
     3202           v-str = ""
     3203       .
     3204       for each temp_fbrrep-goods
     3205       :
     3206           assign
     3207               v-str = v-str
     3208                   + chr(10) + temp_fbrrep-goods.artic
     3209                   + CHR(9) + string( temp_fbrrep-goods.income-qnty )
     3210                   + CHR(9) + string( temp_fbrrep-goods.write-off-qnty )
     3211                   + CHR(9) + string( temp_fbrrep-goods.cost-rubl )
     3212                   + CHR(9) + string( temp_fbrrep-goods.vat-cost-rubl )
     3213                   + CHR(9) + string( temp_fbrrep-goods.sum-cost-rubl )
     3214                   + CHR(9) + string( temp_fbrrep-goods.sum-vat-cost-rubl )
     3215                   + CHR(9) + string( temp_fbrrep-goods.gds-name )
     3216           .
     3217       end.
     3218       output to "fbrrep.txt" append .
     3219       put unformatted skip(2) v-str.
     3220       output close.
     3221   end.
     3222   end procedure.
