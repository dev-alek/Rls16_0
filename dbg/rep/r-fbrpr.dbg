     3248       .
     3249       find first buf_temp_fbrrep-goods
     3250            where buf_temp_fbrrep-goods.artic     = buf_goods.artic
     3251              and buf_temp_fbrrep-goods.prod-type = buf_goods.prod-type
     3252              and buf_temp_fbrrep-goods.prod-code = buf_goods.prod-code
     3253       use-index ar
     3254       no-error.
     3255       if available buf_temp_fbrrep-goods
     3256       then do:
     3257           delete buf_temp_fbrrep-goods.
     3258       end.
     3259       create buf_temp_fbrrep-goods.
