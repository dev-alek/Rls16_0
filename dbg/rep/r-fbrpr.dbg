     3466   run get-report-num in my-handle ( output g#report-num ).
     3467   run get-gds-engl in my-handle ( output g#gds-engl ) .
     3468   define temp-table temp_final_fbrrep-goods no-undo
     3469       field gds-code                      as integer
     3470       field artic                         as character
     3471       field prod-type                     as character
     3472       field prod-code                     as integer
     3473       field gds-name                      as character
     3474       field is-not-office                 as logical
     3475       field is-waste                      as logical
     3476       field unit-base                     as character
     3477       field fact-qnty                     as decimal
     3478       field write-off-qnty                as decimal
     3479       field write-off-rsrv-qnty           as decimal
     3480       field sum-write-off-rsrv-rubl       as decimal
     3481       field sum-write-off-rsrv-base       as decimal
     3482       field sum-write-off-rsrv-vat-rubl   as decimal
     3483       field sum-write-off-rsrv-vat-base   as decimal
     3484       field cost-rubl                     as decimal
     3485       field cost-base                     as decimal
     3486       field sum-cost-rubl                 as decimal
     3487       field sum-cost-base                 as decimal
     3488       field sum-vat-cost-rubl             as decimal
     3489       field sum-vat-cost-base             as decimal
     3490       field vat-cost-rubl                 as decimal
     3491       field vat-cost-base                 as decimal
     3492       field income-qnty                   as decimal
     3493       field income-rsrv-qnty              as decimal
     3494       field cost-income-rubl              as decimal
     3495       field cost-income-base              as decimal
     3496       field sum-cost-income-rubl          as decimal
     3497       field sum-cost-income-base          as decimal
     3498       field sum-vat-cost-income-rubl      as decimal
     3499       field sum-vat-cost-income-base      as decimal
     3500       field vat-cost-income-rubl          as decimal
     3501       field vat-cost-income-base          as decimal
     3502       field price-sale                    as decimal
     3503       field sum-sale                      as decimal
     3504       field deleted                       as logical
     3505       index pi is primary unique gds-code
     3506       index ar is unique artic prod-type prod-code
     3507       index dd deleted
     3508       index ws is-waste
     3509   .
     3510   define stream out-stream.
     3511       define variable v-host-code             as integer      no-undo.
     3512       define variable v-obj-type              as character    no-undo.
     3513       define variable v-obj-code              as integer      no-undo.
     3514       define variable v-today                 as date         no-undo.
     3515       define variable v-time                  as integer      no-undo.
     3516       define variable v-have-transit          as logical      no-undo.
     3517       define variable v-single-line           as character    no-undo.
     3518       define variable v-underline             as character    no-undo.
     3519       define variable v-line-counter          as integer      no-undo.
     3520       define variable v-is-base               as logical      no-undo.
     3521       define variable v-print-in-rubl         as logical      no-undo.
     3522       define variable v-page-sum-rubl         as decimal       no-undo.
     3523       define variable v-page-sum-base         as decimal       no-undo.
     3524       define variable v-page-sum-vat-rubl     as decimal       no-undo.
     3525       define variable v-page-sum-vat-base     as decimal       no-undo.
     3526       define variable v-page-sum-sale-rubl    as decimal       no-undo.
     3527       define variable v-doc-sum-rubl          as decimal       no-undo.
     3528       define variable v-doc-sum-base          as decimal       no-undo.
     3529       define variable v-doc-sum-vat-rubl      as decimal       no-undo.
     3530       define variable v-doc-sum-vat-base      as decimal       no-undo.
     3531       define variable v-doc-sum-sale-rubl     as decimal       no-undo.
     3532       define variable v-docs-exists           as logical      no-undo.
     3533       define variable v-ingr-exists           as logical      no-undo.
     3534       define buffer buf_fbr-doc                   for fbr-doc.
     3535       define buffer buf_fbr-line                  for fbr-line.
     3536       define buffer buf_temp_fbrrep-goods         for temp_fbrrep-goods.
     3537       define buffer buf_temp_final_fbrrep-goods   for temp_final_fbrrep-goods.
     3538   do
     3539   for buf_fbr-doc
     3540     , buf_fbr-line
     3541     , buf_temp_fbrrep-goods
     3542     , buf_temp_final_fbrrep-goods
     3543   on error undo, return error
     3544   :
     3545       assign
     3546           v-obj-type = entry( 1, p-obj-type-code )
     3547           v-obj-code = integer( entry( 2, p-obj-type-code ) )
     3548           v-print-in-rubl = ( x-SET_val_TYPE = 1   )
     3549           g#db-remote     = ( v-cntxt-db-num <> 0 )
     3550           v-docs-exists   = no
     3551           v-ingr-exists   = no
     3552       .
     3553   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3554   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rbisbase in g#library
     3555     (output v-is-base
     3556     )  .
     3557   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3558   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3559     (input  v-obj-type
     3560     ,input  v-obj-code
     3561     ,output v-host-code
     3562     )  .
     3563       assign
     3564           v-single-line  = fill( "-", 230 )
     3565           v-underline    = fill( "_", 230 )
     3566           v-line-counter = 0
     3567       .
     3568   if session :set-wait-state( "compiler" ) then.
     3569       for each buf_fbr-doc no-lock
     3570          where buf_fbr-doc.host-code = v-host-code
     3571            and buf_fbr-doc.fact-date >= x-date-start
     3572            and buf_fbr-doc.fact-date <= x-date-end
     3573            and buf_fbr-doc.obj-type  = v-obj-type
     3574            and buf_fbr-doc.obj-code  = v-obj-code
     3575       on error undo, return error
     3576       :
     3577           assign
     3578               v-docs-exists = yes
     3579           .
     3580           run fbrrep-fill-for-fbr-actp in this-procedure (
     3581               input buf_fbr-doc.doc-code
     3582           ).
     3583           for each buf_temp_fbrrep-goods
     3584           on error undo, return error
     3585           :
     3586               find first buf_temp_final_fbrrep-goods
     3587                    where buf_temp_final_fbrrep-goods.gds-code = buf_temp_fbrrep-goods.gds-code
     3588               no-error.
     3589               if not available buf_temp_final_fbrrep-goods
     3590               then do:
     3591                   assign
     3592                       v-ingr-exists = yes
     3593                   .
     3594                   create buf_temp_final_fbrrep-goods.
     3595                   buffer-copy buf_temp_fbrrep-goods to buf_temp_final_fbrrep-goods.
     3596               end.
     3597               else do:
     3598                   assign
     3599                       buf_temp_final_fbrrep-goods.fact-qnty                    = buf_temp_final_fbrrep-goods.fact-qnty                   + ( if buf_temp_fbrrep-goods.fact-qnty                   = ? then 0 else buf_temp_fbrrep-goods.fact-qnty                     )
     3600                       buf_temp_final_fbrrep-goods.write-off-qnty               = buf_temp_final_fbrrep-goods.write-off-qnty              + ( if buf_temp_fbrrep-goods.write-off-qnty              = ? then 0 else buf_temp_fbrrep-goods.write-off-qnty                )
     3601                       buf_temp_final_fbrrep-goods.write-off-rsrv-qnty          = buf_temp_final_fbrrep-goods.write-off-rsrv-qnty         + ( if buf_temp_fbrrep-goods.write-off-rsrv-qnty         = ? then 0 else buf_temp_fbrrep-goods.write-off-rsrv-qnty           )
     3602                       buf_temp_final_fbrrep-goods.sum-write-off-rsrv-rubl      = buf_temp_final_fbrrep-goods.sum-write-off-rsrv-rubl     + ( if buf_temp_fbrrep-goods.sum-write-off-rsrv-rubl     = ? then 0 else buf_temp_fbrrep-goods.sum-write-off-rsrv-rubl       )
     3603                       buf_temp_final_fbrrep-goods.sum-write-off-rsrv-base      = buf_temp_final_fbrrep-goods.sum-write-off-rsrv-base     + ( if buf_temp_fbrrep-goods.sum-write-off-rsrv-base     = ? then 0 else buf_temp_fbrrep-goods.sum-write-off-rsrv-base       )
     3604                       buf_temp_final_fbrrep-goods.sum-write-off-rsrv-vat-rubl  = buf_temp_final_fbrrep-goods.sum-write-off-rsrv-vat-rubl + ( if buf_temp_fbrrep-goods.sum-write-off-rsrv-vat-rubl = ? then 0 else buf_temp_fbrrep-goods.sum-write-off-rsrv-vat-rubl   )
     3605                       buf_temp_final_fbrrep-goods.sum-write-off-rsrv-vat-base  = buf_temp_final_fbrrep-goods.sum-write-off-rsrv-vat-base + ( if buf_temp_fbrrep-goods.sum-write-off-rsrv-vat-base = ? then 0 else buf_temp_fbrrep-goods.sum-write-off-rsrv-vat-base   )
     3606                       buf_temp_final_fbrrep-goods.sum-cost-rubl                = buf_temp_final_fbrrep-goods.sum-cost-rubl               + ( if buf_temp_fbrrep-goods.sum-cost-rubl               = ? then 0 else buf_temp_fbrrep-goods.sum-cost-rubl                 )
     3607                       buf_temp_final_fbrrep-goods.sum-cost-base                = buf_temp_final_fbrrep-goods.sum-cost-base               + ( if buf_temp_fbrrep-goods.sum-cost-base               = ? then 0 else buf_temp_fbrrep-goods.sum-cost-base                 )
     3608                       buf_temp_final_fbrrep-goods.sum-vat-cost-rubl            = buf_temp_final_fbrrep-goods.sum-vat-cost-rubl           + ( if buf_temp_fbrrep-goods.sum-vat-cost-rubl           = ? then 0 else buf_temp_fbrrep-goods.sum-vat-cost-rubl             )
     3609                       buf_temp_final_fbrrep-goods.sum-vat-cost-base            = buf_temp_final_fbrrep-goods.sum-vat-cost-base           + ( if buf_temp_fbrrep-goods.sum-vat-cost-base           = ? then 0 else buf_temp_fbrrep-goods.sum-vat-cost-base             )
     3610                       buf_temp_final_fbrrep-goods.income-qnty                  = buf_temp_final_fbrrep-goods.income-qnty                 + ( if buf_temp_fbrrep-goods.income-qnty                 = ? then 0 else buf_temp_fbrrep-goods.income-qnty                   )
     3611                       buf_temp_final_fbrrep-goods.income-rsrv-qnty             = buf_temp_final_fbrrep-goods.income-rsrv-qnty            + ( if buf_temp_fbrrep-goods.income-rsrv-qnty            = ? then 0 else buf_temp_fbrrep-goods.income-rsrv-qnty              )
     3612                       buf_temp_final_fbrrep-goods.sum-cost-income-rubl         = buf_temp_final_fbrrep-goods.sum-cost-income-rubl        + ( if buf_temp_fbrrep-goods.sum-cost-income-rubl        = ? then 0 else buf_temp_fbrrep-goods.sum-cost-income-rubl          )
     3613                       buf_temp_final_fbrrep-goods.sum-cost-income-base         = buf_temp_final_fbrrep-goods.sum-cost-income-base        + ( if buf_temp_fbrrep-goods.sum-cost-income-base        = ? then 0 else buf_temp_fbrrep-goods.sum-cost-income-base          )
     3614                       buf_temp_final_fbrrep-goods.sum-vat-cost-income-rubl     = buf_temp_final_fbrrep-goods.sum-vat-cost-income-rubl    + ( if buf_temp_fbrrep-goods.sum-vat-cost-income-rubl    = ? then 0 else buf_temp_fbrrep-goods.sum-vat-cost-income-rubl      )
     3615                       buf_temp_final_fbrrep-goods.sum-vat-cost-income-base     = buf_temp_final_fbrrep-goods.sum-vat-cost-income-base    + ( if buf_temp_fbrrep-goods.sum-vat-cost-income-base    = ? then 0 else buf_temp_fbrrep-goods.sum-vat-cost-income-base      )
     3616                       buf_temp_final_fbrrep-goods.sum-sale                     = buf_temp_final_fbrrep-goods.sum-sale                    + ( buf_temp_fbrrep-goods.price-sale * buf_temp_fbrrep-goods.fact-qnty )
     3617                   .
     3618               end.
     3619           end.
     3620       end.
     3621       if v-docs-exists = no
     3622       then do:
     3623           message
     3624               "В заданном диапазоне нет документов производства."
     3625           view-as alert-box information.
     3626           undo, return .
     3627       end.
     3628       if v-ingr-exists = no
     3629       then do:
     3630           message
     3631               "В заданном диапазоне нет документов производства"
     3632               skip "с промежуточными ингредиентами."
     3633           view-as alert-box information.
     3634           undo, return .
     3635       end.
     3636   output stream out-stream to value( string( session:temp-directory +
     3637                                        "rpt" + string( g#report-num ) ) )
     3638                                        page-size  value(230) .
     3639       run fmtcli-get-client in this-procedure (
     3640             input v-obj-type
     3641           , input v-obj-code
     3642       ).
     3643       run cur-time in this-procedure (
     3644             output v-today
     3645           , output v-time
     3646       ).
     3647       put stream Out-Stream
     3648           skip space(3)
     3649               substitute( "Объект: (&1 &2) &3"
     3650                           , v-obj-type
     3651                           , v-obj-code
     3652                           , v-fmtcli-name      )              format "X(190)"
     3653           skip(1) space(3)
     3654               substitute( "Дата печати: &1"
     3655                           , string( v-today, "99/99/9999" ) ) format "X(10)"
     3656               "Производство промежуточных ингредиентов"                                   at 3 + 10 + 40
     3657       .
     3658       run print-header in this-procedure (
     3659           input yes
     3660       ).
     3661       for each buf_temp_final_fbrrep-goods no-lock
     3662       on error undo, return error
     3663       :
     3664           assign
     3665               v-have-transit          = yes
     3666               v-line-counter          = v-line-counter       + 1
     3667               v-page-sum-rubl         = v-page-sum-rubl      + buf_temp_final_fbrrep-goods.sum-cost-rubl
     3668               v-page-sum-base         = v-page-sum-base      + buf_temp_final_fbrrep-goods.sum-cost-base
     3669               v-page-sum-vat-rubl     = v-page-sum-vat-rubl  + buf_temp_final_fbrrep-goods.sum-vat-cost-rubl
     3670               v-page-sum-vat-base     = v-page-sum-vat-base  + buf_temp_final_fbrrep-goods.sum-vat-cost-base
     3671               v-page-sum-sale-rubl    = v-page-sum-sale-rubl + buf_temp_final_fbrrep-goods.sum-sale
     3672           .
     3673           run print-line in this-procedure (
     3674                 input buf_temp_final_fbrrep-goods.gds-code
     3675               , input v-print-in-rubl
     3676               , input v-is-base
     3677           ) no-error.
     3678           if error-status :error
     3679           then do:
     3680               message
     3681                           vss-workfile vss-revision vss-description
     3682                   skip(1)
     3683                   skip "Ошибка печати строки."
     3684                   skip v-line-counter
     3685                   skip return-value
     3686                   skip trim(error-status :get-message(1))
     3687                           trim(error-status :get-message(2))
     3688                           trim(error-status :get-message(3))
     3689               view-as alert-box error.
     3690               undo, return error .
     3691           end.
     3692       end.
     3693       if v-have-transit = no
     3694       then do:
     3695           output stream Out-Stream close.
     3696   if session :set-wait-state( "" ) then.
     3697       end.
     3698       else do:
     3699           run print-footer in this-procedure (
     3700                 input v-print-in-rubl
     3701               , input v-is-base
     3702           ).
     3703           output stream Out-Stream close.
     3704   if session :set-wait-state( "" ) then.
     3705           define variable v-user-action           as character            no-undo.
     3706           define variable v-printed               as logical              no-undo.
     3707           run gbl/prnfilen.w (
     3708                 input "":U
     3709               , input 8
     3710               , input string( session :temp-directory ) + "rpt" + string( g#report-num )
     3711               , input 7
     3712               , output v-user-action
     3713               , output v-printed
     3714           ) .
     3715       end.
     3716   end.
     3717   procedure print-header :
     3718   define input parameter p-first  as logical      no-undo.
     3719   do
     3720   on error undo, return error
     3721   :
     3722       if line-counter( Out-stream ) = 0
     3723       or p-first = yes
     3724       then do:
     3725           put stream Out-Stream
     3726               skip string( "Страница " + string( page-number( Out-Stream ), ">>9" ) ) format "X(13)"   at right-field( 3  + 190, 13)
     3727           .
     3728           put stream Out-Stream
     3729               skip
     3730                   v-single-line           format "X(191)"    at 3
     3731               skip
     3732                   "|"                                                 at 3
     3733                   "N"                                                 at center-field( 3, 3  + 5, 1 )
     3734                   "|"                                                 at 3  + 5
     3735                   "Код"                                               at center-field( 3  + 5, 3  + 15, 3 )
     3736                   "|"                                                 at 3  + 15
     3737                   "Артикул"                                           at center-field( 3  + 15, 3  + 32, 7 )
     3738                   "|"                                                 at 3  + 32
     3739                   "Название товара"                                   at 3  + 32 + 2
     3740                   "|"                                                 at 3  + 83
     3741                   "Ед."                                               at center-field( 3  + 83, 3  + 88, 3 )
     3742                   "|"                                                 at 3  + 88
     3743                   "Количество"                                        at center-field( 3  + 88, 3  + 100, 10 )
     3744                   "|"                                                 at 3  + 100
     3745                   "Уч.цена"                                           at center-field( 3  + 100, 3  + 111, 7 )
     3746                   "|"                                                 at 3  + 111
     3747                   "Сумма уч.цен"                                      at center-field( 3  + 111, 3  + 128, 12 )
     3748                   "|"                                                 at 3  + 128
     3749                   "Сумма НДС"                                         at center-field( 3  + 128, 3 + 145, 9 )
     3750                   "|"                                                 at 3 + 145
     3751                   "Сумма уч.цен"                                      at center-field( 3 + 145, 3 + 162, 12 )
     3752                   "|"                                                 at 3 + 162
     3753                   "Продажная"                                         at center-field( 3 + 162, 3 + 173, 9 )
     3754                   "|"                                                 at 3 + 173
     3755                   "Сумма"                                             at center-field( 3 + 173, 3  + 190, 5 )
     3756                   "|"                                                 at 3  + 190
     3757               skip
     3758                   "|"                                                 at 3
     3759                   "п/п"                                               at center-field( 3, 3  + 5, 3 )
     3760                   "|"                                                 at 3  + 5
     3761                   "|"                                                 at 3  + 15
     3762                   "|"                                                 at 3  + 32
     3763                   "|"                                                 at 3  + 83
     3764                   "изм."                                              at center-field( 3  + 83, 3  + 88, 4 )
     3765                   "|"                                                 at 3  + 88
     3766                   "|"                                                 at 3  + 100
     3767                   "без НДС"                                           at center-field( 3  + 100, 3  + 111, 7 )
     3768                   "|"                                                 at 3  + 111
     3769                   "без НДС"                                           at center-field( 3  + 111, 3  + 128, 7 )
     3770                   "|"                                                 at 3  + 128
     3771                   "|"                                                 at 3 + 145
     3772                   "с НДС"                                             at center-field( 3 + 145, 3 + 162, 5 )
     3773                   "|"                                                 at 3 + 162
     3774                   "цена"                                              at center-field( 3 + 162, 3 + 173, 4 )
     3775                   "|"                                                 at 3 + 173
     3776                   "прод.цен"                                          at center-field( 3 + 173, 3  + 190, 8 )
     3777                   "|"                                                 at 3  + 190
     3778               skip
     3779                   v-single-line           format "X(191)"    at 3
     3780           .
     3781       end.
     3782   end.
     3783   end procedure.
     3784   procedure print-footer :
     3785   do
     3786   on error undo, return error
     3787   :
     3788   define input parameter p-print-rubl as logical      no-undo.
     3789   define input parameter p-is-base    as logical      no-undo.
     3790       define variable v-all-sum-cost as decimal       no-undo.
     3791       if p-print-rubl = yes
     3792       then do:
     3793           assign
     3794               v-all-sum-cost = v-doc-sum-rubl + v-page-sum-rubl + v-doc-sum-vat-rubl + v-page-sum-vat-rubl
     3795           .
     3796       end.
     3797       else do:
     3798           assign
     3799               v-all-sum-cost = v-doc-sum-base + v-page-sum-base + v-doc-sum-vat-base + v-page-sum-vat-base
     3800           .
     3801       end.
     3802       run print-end-of-page in this-procedure (
     3803             input p-print-rubl
     3804           , input no
     3805           , input p-is-base
     3806       ).
     3807       if line-counter( Out-stream ) + 10 > page-size( Out-stream )
     3808       then do:
     3809           page stream out-stream.
     3810       end.
     3811       put stream Out-Stream
     3812           skip (1)
     3813               "Всего промежуточных ингредиентов на сумму (в учетных ценах):   "                       at 3
     3814               v-all-sum-cost                                                      format "->>>,>>>,>>9.99"
     3815       .
     3816       if ( p-is-base   = no
     3817           and p-print-rubl = yes )
     3818       or ( p-is-base   = yes
     3819           and p-print-rubl = no )
     3820       then do:
     3821           put stream Out-Stream
     3822               skip (1)
     3823                   "Всего промежуточных ингредиентов на сумму (в продажных ценах): "                       at 3
     3824                   v-doc-sum-sale-rubl + v-page-sum-sale-rubl                          format "->>>,>>>,>>9.99"
     3825           .
     3826       end.
     3827       put stream Out-Stream
     3828           skip (2)
     3829               "Материально ответственное лицо:_______________________________ "                       at 3
     3830           skip (1)
     3831               "Бухгалтер:____________________________________________________ "                       at 3
     3832           skip (1)
     3833               "Обработал:____________________________________________________ "                       at 3
     3834       .
     3835   end.
     3836   end procedure.
     3837   procedure print-end-of-page :
     3838   do
     3839   on error undo, return error
     3840   :
     3841   define input parameter p-print-rubl             as logical      no-undo.
     3842   define input parameter p-print-continue-line    as logical      no-undo.
     3843   define input parameter p-is-base                as logical      no-undo.
     3844       define variable v-sum-cost       as decimal       no-undo.
     3845       define variable v-sum-vat-cost   as decimal       no-undo.
     3846       define variable v-sum-all-cost   as decimal       no-undo.
     3847       define variable v-sum-price-sale as decimal       no-undo.
     3848       define variable v-sum-cost-length       as integer       no-undo.
     3849       define variable v-sum-vat-cost-length   as integer       no-undo.
     3850       define variable v-sum-all-cost-length   as integer       no-undo.
     3851       define variable v-sum-price-sale-length as integer       no-undo.
     3852       if p-print-rubl = yes
     3853       then do:
     3854           assign
     3855               v-sum-cost       = v-page-sum-rubl
     3856               v-sum-vat-cost   = v-page-sum-vat-rubl
     3857               v-sum-all-cost   = v-page-sum-rubl + v-page-sum-vat-rubl
     3858           .
     3859       end.
     3860       else do:
     3861           assign
     3862               v-sum-cost       = v-page-sum-base
     3863               v-sum-vat-cost   = v-page-sum-vat-base
     3864               v-sum-all-cost   = v-page-sum-base + v-page-sum-vat-base
     3865           .
     3866       end.
     3867       assign
     3868           v-sum-price-sale        = v-page-sum-sale-rubl
     3869           v-sum-cost-length       = length( string( v-sum-cost      , "->>>,>>>,>>9.99"  ) )
     3870           v-sum-vat-cost-length   = length( string( v-sum-vat-cost  , "->>>,>>>,>>9.99"  ) )
     3871           v-sum-all-cost-length   = length( string( v-sum-all-cost  , "->>>,>>>,>>9.99" ) )
     3872           v-sum-price-sale-length = length( string( v-sum-price-sale, "->>>,>>>,>>9.99" ) )
     3873       .
     3874       put stream Out-Stream
     3875           skip
     3876               v-single-line           format "X(191)"    at 3
     3877           skip
     3878               "Итого: "                                           at 3  + 32
     3879               v-sum-cost              format "->>>,>>>,>>9.99"    at right-field( 3  + 128 , v-sum-cost-length       )
     3880               v-sum-vat-cost          format "->>>,>>>,>>9.99"    at right-field( 3 + 145, v-sum-vat-cost-length   )
     3881               v-sum-all-cost          format "->>>,>>>,>>9.99"   at right-field( 3 + 162, v-sum-all-cost-length   )
     3882       .
     3883       if ( p-is-base   = no
     3884           and p-print-rubl = yes )
     3885       or ( p-is-base   = yes
     3886           and p-print-rubl = no )
     3887       then do:
     3888           put stream Out-Stream
     3889                   v-sum-price-sale        format "->>>,>>>,>>9.99"   at right-field( 3  + 190    , v-sum-price-sale-length )
     3890           .
     3891       end.
     3892       if p-print-continue-line = yes
     3893       then do:
     3894           put stream Out-Stream
     3895               skip
     3896                   v-single-line           format "X(191)"    at 3
     3897               skip
     3898                   "Продолжение - на следующей странице"               at 30
     3899           .
     3900       end.
     3901       assign
     3902           v-doc-sum-rubl      = v-doc-sum-rubl      + v-page-sum-rubl
     3903           v-doc-sum-base      = v-doc-sum-base      + v-page-sum-base
     3904           v-doc-sum-vat-rubl  = v-doc-sum-vat-rubl  + v-page-sum-vat-rubl
     3905           v-doc-sum-vat-base  = v-doc-sum-vat-base  + v-page-sum-vat-base
     3906           v-doc-sum-sale-rubl = v-doc-sum-sale-rubl + v-page-sum-sale-rubl
     3907       .
     3908       assign
     3909           v-page-sum-rubl      = 0
     3910           v-page-sum-base      = 0
     3911           v-page-sum-vat-rubl  = 0
     3912           v-page-sum-vat-base  = 0
     3913           v-page-sum-sale-rubl = 0
     3914       .
     3915   end.
     3916   end procedure.
     3917   procedure print-line :
     3918   do
     3919   on error undo, return error
     3920   :
     3921   define input parameter p-gds-code   as integer      no-undo.
     3922   define input parameter p-print-rubl as logical      no-undo.
     3923   define input parameter p-is-base as logical      no-undo.
     3924       define variable v-qnty           as decimal       no-undo.
     3925       define variable v-cost           as decimal       no-undo.
     3926       define variable v-sum-cost       as decimal       no-undo.
     3927       define variable v-sum-vat-cost   as decimal       no-undo.
     3928       define variable v-sum-all-cost   as decimal       no-undo.
     3929       define variable v-price-sale     as decimal       no-undo.
     3930       define variable v-sum-price-sale as decimal       no-undo.
     3931       define variable v-qnty-length           as integer       no-undo.
     3932       define variable v-cost-length           as integer       no-undo.
     3933       define variable v-sum-cost-length       as integer       no-undo.
     3934       define variable v-sum-vat-cost-length   as integer       no-undo.
     3935       define variable v-sum-all-cost-length   as integer       no-undo.
     3936       define variable v-price-sale-length     as integer       no-undo.
     3937       define variable v-sum-price-sale-length as integer       no-undo.
     3938       define buffer buf_temp_final_fbrrep-goods        for temp_final_fbrrep-goods.
     3939       find first buf_temp_final_fbrrep-goods
     3940            where buf_temp_final_fbrrep-goods.gds-code = p-gds-code
     3941       .
     3942       run print-header in this-procedure (
     3943           input no
     3944       ).
     3945       assign
     3946           v-qnty           = buf_temp_final_fbrrep-goods.fact-qnty
     3947           v-price-sale     = buf_temp_final_fbrrep-goods.price-sale
     3948           v-sum-price-sale = buf_temp_final_fbrrep-goods.price-sale * buf_temp_final_fbrrep-goods.fact-qnty
     3949       .
     3950       if p-print-rubl = yes
     3951       then do:
     3952           assign
     3953               v-cost           = buf_temp_final_fbrrep-goods.sum-cost-rubl / buf_temp_final_fbrrep-goods.fact-qnty
     3954               v-sum-cost       = buf_temp_final_fbrrep-goods.sum-cost-rubl
     3955               v-sum-vat-cost   = buf_temp_final_fbrrep-goods.sum-vat-cost-rubl
     3956               v-sum-all-cost   = buf_temp_final_fbrrep-goods.sum-cost-rubl + buf_temp_final_fbrrep-goods.sum-vat-cost-rubl
     3957           .
     3958       end.
     3959       else do:
     3960           assign
     3961               v-cost           = buf_temp_final_fbrrep-goods.sum-cost-base / buf_temp_final_fbrrep-goods.fact-qnty
     3962               v-sum-cost       = buf_temp_final_fbrrep-goods.sum-cost-base
     3963               v-sum-vat-cost   = buf_temp_final_fbrrep-goods.sum-vat-cost-base
     3964               v-sum-all-cost   = buf_temp_final_fbrrep-goods.sum-cost-base + buf_temp_final_fbrrep-goods.sum-vat-cost-base
     3965           .
     3966       end.
     3967       assign
     3968           v-qnty-length           = length( string( v-qnty          , "->>,>>9.99"  ) )
     3969           v-cost-length           = length( string( v-cost          , ">>,>>9.99"  ) )
     3970           v-sum-cost-length       = length( string( v-sum-cost      , "->>>,>>>,>>9.99"  ) )
     3971           v-sum-vat-cost-length   = length( string( v-sum-vat-cost  , "->>>,>>>,>>9.99"  ) )
     3972           v-sum-all-cost-length   = length( string( v-sum-all-cost  , "->>>,>>>,>>9.99" ) )
     3973           v-price-sale-length     = length( string( v-price-sale    , ">>,>>9.99" ) )
     3974           v-sum-price-sale-length = length( string( v-sum-price-sale, "->>>,>>>,>>9.99" ) )
     3975       .
     3976       put stream Out-Stream
     3977           skip
     3978               "|"                                                     at 3
     3979               v-line-counter                      format ">>>9"
     3980               "|"                                                     at 3  + 5
     3981               buf_temp_final_fbrrep-goods.gds-code     format "999999999"
     3982               "|"                                                     at 3  + 15
     3983               buf_temp_final_fbrrep-goods.artic        format "X(16)"
     3984               "|"                                                     at 3  + 32
     3985               buf_temp_final_fbrrep-goods.gds-name     format "X(48)"
     3986               "|"                                                     at 3  + 83
     3987               buf_temp_final_fbrrep-goods.unit-base    format "X(4)"
     3988               "|"                                                     at 3  + 88
     3989               v-qnty                       format "->>,>>9.99"    at right-field( 3  + 100 , v-qnty-length               )
     3990               "|"                                                     at 3  + 100
     3991               v-cost                       format ">>,>>9.99"    at right-field( 3  + 111 , v-cost-length               )
     3992               "|"                                                     at 3  + 111
     3993               v-sum-cost                   format "->>>,>>>,>>9.99"    at right-field( 3  + 128 , v-sum-cost-length           )
     3994               "|"                                                     at 3  + 128
     3995               v-sum-vat-cost               format "->>>,>>>,>>9.99"    at right-field( 3 + 145, v-sum-vat-cost-length       )
     3996               "|"                                                     at 3 + 145
     3997               v-sum-all-cost               format "->>>,>>>,>>9.99"   at right-field( 3 + 162, v-sum-all-cost-length       )
     3998               "|"                                                     at 3 + 162
     3999       .
     4000       if ( p-is-base   = no
     4001           and p-print-rubl = yes )
     4002       or ( p-is-base   = yes
     4003           and p-print-rubl = no )
     4004       then do:
     4005           put stream Out-Stream
     4006                   v-price-sale                 format ">>,>>9.99"   at right-field( 3 + 173, v-price-sale-length         )
     4007           .
     4008       end.
     4009       put stream Out-Stream
     4010               "|"                                             at 3 + 173
     4011       .
     4012       if ( p-is-base   = no
     4013           and p-print-rubl = yes )
     4014       or ( p-is-base   = yes
     4015           and p-print-rubl = no )
     4016       then do:
     4017           put stream Out-Stream
     4018                   v-sum-price-sale             format "->>>,>>>,>>9.99"   at right-field( 3  + 190    ,     v-sum-price-sale-length )
     4019           .
     4020       end.
     4021       put stream Out-Stream
     4022               "|"                                                     at 3  + 190
     4023       .
     4024       if line-counter( Out-stream ) + 2 > page-size( Out-stream )
     4025       then do:
     4026           run print-end-of-page in this-procedure (
     4027                 input p-print-rubl
     4028               , input yes
     4029               , input p-is-base
     4030           ).
     4031       end.
     4032   end.
     4033   end procedure.
