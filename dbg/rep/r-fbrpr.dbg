     2136           p-road-tax-rubl  = p-road-tax-rubl  + road-tax-rubl-loc       * buf_temp-parts.fact-qnty
     2137           p-transport-base = p-transport-base + transport-base-loc      * buf_temp-parts.fact-qnty
     2138           p-transport-rubl = p-transport-rubl + transport-rubl-loc      * buf_temp-parts.fact-qnty
     2139           p-other-base     = p-other-base     + other-base-loc          * buf_temp-parts.fact-qnty
     2140           p-other-rubl     = p-other-rubl     + other-rubl-loc          * buf_temp-parts.fact-qnty
     2141           p-excise-base    = p-excise-base    + 0
     2142           p-excise-rubl    = p-excise-rubl    + 0
     2143         .
