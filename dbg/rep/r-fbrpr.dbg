      564   define new global shared variable g#library  as handle no-undo .
      565   define new global shared variable g#library2 as handle no-undo .
      566   define variable var-report-r-b as character no-undo .
      567   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      568   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      569     (output var-report-r-b
      570     )  .
      571   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      572   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      573   define  shared variable RepPathName        as character no-undo .
      574   define  shared variable PrintRubl          as logical   no-undo .
      575   define variable vss-include-info8 as character format "X(65)" no-undo
      576   initial "@(#)$Workfile$ $Revision$".
      577   define temp-table temp_p-fmt_string-part no-undo
      578       field str-key       as integer
      579       field string-part   as character
      580       index pi is primary unique
      581           str-key
      582   .
      583   define variable v-p-fmt-8-str-key    as integer      no-undo.
      584   FUNCTION center-field RETURNS INTEGER (INPUT iStartPix AS INTEGER, iEndPix AS INTEGER,
      585                                     iInput AS INTEGER).
      586     def var v-start-print as integer no-undo .
      587     if (iStartPix < 0) or (iEndPix < iStartPix) then return 0.
      588     assign
      589       v-start-print = INTEGER(iStartPix + ((iEndPix - iStartPix) / 2) - (iInput / 2))
      590     .
      591     RETURN v-start-print .
      592   END FUNCTION.
      593   FUNCTION right-field RETURNS INTEGER ( iEndPix AS INTEGER,
      594                                     iInput AS INTEGER).
      595     def var v-start-print as integer no-undo .
      596     assign
      597       v-start-print = INTEGER(iEndPix - 1 - iInput)
      598     .
      599     if v-start-print < 0 then return 0.
      600     RETURN v-start-print .
      601   END FUNCTION.
      602   function p-fmt-align-string returns character (
      603         p-in-string      as character
      604       , p-page-width     as integer
      605       , p-align-type     as character
      606   ).
      607       define variable v-string-length     as integer      no-undo.
      608       define variable v-out-string        as character    no-undo.
      609       assign
      610           v-string-length = length( trim( p-in-string ) )
      611       .
      612       if v-string-length >= p-page-width
      613       then do:
      614           assign
      615               v-out-string = trim( p-in-string )
      616           .
      617       end.
      618       else do:
      619           case p-align-type
      620           :
      621               when 'left':U
      622               then do:
      623                   assign
      624                       v-out-string = trim( p-in-string )
      625                   .
      626               end.
      627               when 'right':U
      628               then do:
      629                   assign
      630                       v-out-string = fill( " ":U, p-page-width - v-string-length ) + trim( p-in-string )
      631                   .
      632               end.
      633               when 'center':U
      634               then do:
      635                   assign
      636                       v-out-string = fill( " ":U, integer( ( p-page-width - v-string-length ) / 2 ) ) + trim( p-in-string )
      637                   .
      638               end.
      639           end case.
      640       end.
      641       return v-out-string .
      642   end function.
      643   procedure p-fmt-split-string :
      644   define input parameter p-source-string  as character        no-undo.
      645   define input parameter p-split-length   as integer          no-undo.
      646   define output parameter p-string-1      as character        no-undo.
      647   define output parameter p-string-2      as character        no-undo.
      648   do
      649   on error undo, return error
      650   :
      651       define variable v-space-pos    as integer      no-undo.
      652       if length( p-source-string ) <= p-split-length
      653       then do:
      654           assign
      655               p-string-1 = p-source-string
      656           .
      657       end.
      658       else do:
      659           assign
      660               v-space-pos = r-index( p-source-string, " ":U, p-split-length )
      661           .
      662           if v-space-pos = 0
      663           then do:
      664               assign
      665                   v-space-pos = index( p-source-string, " ":U )
      666               .
      667           end.
      668           if v-space-pos = 0
      669           then do:
      670               assign
      671                   p-string-1 = substring( p-source-string, 1, p-split-length )
      672                   p-string-2 = trim( substring( p-source-string, p-split-length, p-split-length ) )
      673               .
      674           end.
      675           else do:
      676               assign
      677                   p-string-1 = substring( p-source-string, 1, v-space-pos )
      678                   p-string-2 = trim( substring( p-source-string, v-space-pos ) )
      679               .
      680           end.
      681       end.
      682   end.
      683   end procedure.
      684   procedure p-fmt-round :
      685   define input parameter p-qnty               as decimal          no-undo.
      686   define input parameter p-price-no-VAT       as decimal          no-undo.
      687   define input parameter p-VAT                as decimal          no-undo.
      688   define input parameter p-SLT                as decimal          no-undo.
      689   define input parameter p-road-tax           as decimal          no-undo.
      690   define output parameter p-new-price-no-VAT  as decimal          no-undo.
      691   define output parameter p-new-VAT           as decimal          no-undo.
      692   define output parameter p-new-SLT           as decimal          no-undo.
      693   define output parameter p-new-sum-VAT       as decimal          no-undo.
      694   define output parameter p-new-sum-SLT       as decimal          no-undo.
      695   define output parameter p-new-sum-road-tax  as decimal          no-undo.
      696   define output parameter p-new-sum-no-VAT    as decimal          no-undo.
      697   define output parameter p-new-sum-full      as decimal          no-undo.
      698       define variable v-vat-pc    as decimal      no-undo.
      699       define variable v-slt-pc    as decimal      no-undo.
      700   do
      701   on error undo, return error
      702   :
      703       if p-price-no-VAT = 0
      704       then do:
      705           assign
      706               p-new-price-no-VAT = 0.0
      707               p-new-VAT          = ?
      708               p-new-SLT          = ?
      709               p-new-sum-VAT      = 0.0
      710               p-new-sum-SLT      = 0.0
      711               p-new-sum-no-VAT   = 0.0
      712               p-new-sum-road-tax = 0.0
      713               p-new-sum-full     = 0.0
      714           .
      715       end.
      716       else do:
      717           assign
      718               v-vat-pc            = p-VAT / p-price-no-VAT
      719               v-slt-pc            = p-SLT / ( p-price-no-VAT + p-VAT )
      720               p-new-price-no-VAT  = round( p-price-no-VAT, 2 )
      721               p-new-VAT           = round( p-new-price-no-VAT * v-vat-pc, 2 )
      722               p-new-SLT           = round( ( p-new-price-no-VAT + p-new-VAT ) * v-slt-pc, 2 )
      723               p-new-sum-VAT       = round( p-new-VAT          * p-qnty, 2 )
      724               p-new-sum-SLT       = round( ( p-new-price-no-VAT + p-new-VAT ) * p-qnty * v-slt-pc, 2 )
      725               p-new-sum-no-VAT    = round( p-new-price-no-VAT * p-qnty, 2 )
      726               p-new-sum-road-tax  = round( p-road-tax * p-qnty, 2 )
      727               p-new-sum-full      = round( ( p-new-price-no-VAT + p-new-VAT + p-new-SLT + p-road-tax ) * p-qnty, 2 )
      728           .
      729       end.
      730   end.
      731   end procedure.
      732   procedure p-fmt-split :
      733   define input parameter p-in-string      as character        no-undo.
      734   define input parameter p-split-length   as integer          no-undo.
      735       define variable v-start-pos     as integer      no-undo.
      736       define variable v-end-pos       as integer      no-undo.
      737       define buffer buf_temp_p-fmt_string-part        for temp_p-fmt_string-part.
      738   do
      739   for buf_temp_p-fmt_string-part
      740   on error undo, return error
      741   :
      742       empty temp-table buf_temp_p-fmt_string-part.
      743       if p-split-length < 1
      744       then do:
      745           undo, return error substitute( "p-fmt-split: Строка не может быть разбита на &1 частей", p-split-length ).
      746       end.
      747       assign
      748           p-in-string                 = trim( p-in-string )
      749           v-p-fmt-8-str-key   = 0
      750           v-start-pos                 = 1
      751           v-end-pos                   = length( p-in-string )
      752       .
      753       run p-fmt-get-string-range in this-procedure (
      754             input p-in-string
      755           , input p-split-length
      756           , input v-start-pos
      757           , output v-start-pos
      758           , output v-end-pos
      759       ).
      760       do while v-end-pos <> 0
      761       :
      762           create buf_temp_p-fmt_string-part.
      763           assign
      764               v-p-fmt-8-str-key = v-p-fmt-8-str-key + 1
      765           .
      766           assign
      767               buf_temp_p-fmt_string-part.str-key      = v-p-fmt-8-str-key
      768               buf_temp_p-fmt_string-part.string-part  = substring( p-in-string, v-start-pos, v-end-pos - v-start-pos )
      769           .
      770           assign
      771               v-start-pos = v-end-pos + 1
      772           .
      773           run p-fmt-get-string-range in this-procedure (
      774                 input p-in-string
      775               , input p-split-length
      776               , input v-start-pos
      777               , output v-start-pos
      778               , output v-end-pos
      779           ).
      780       end.
      781   end.
      782   end procedure.
      783   procedure p-fmt-get-string-range :
      784   define input parameter p-in-string      as character        no-undo.
      785   define input parameter p-split-length   as integer          no-undo.
      786   define input parameter p-old-start-pos  as integer          no-undo.
      787   define output parameter p-start-pos     as integer          no-undo.
      788   define output parameter p-end-pos       as integer          no-undo.
      789       define variable v-init-string    as character    no-undo.
      790       define variable v-temp-char      as character    no-undo.
      791       define variable v-temp-pos       as integer      no-undo.
      792       define variable v-counter        as integer      no-undo.
      793   do
      794   on error undo, return error
      795   :
      796       assign
      797           p-start-pos   = p-old-start-pos
      798           v-init-string = substring( p-in-string, p-start-pos )
      799       no-error.
      800       if error-status :error
      801       or trim( v-init-string ) = "":U
      802       then do:
      803           assign
      804               p-end-pos = 0
      805           .
      806           undo, return .
      807       end.
      808       assign
      809           v-temp-char   = substring( v-init-string, 1, 1 )
      810       .
      811       do
      812       while trim( v-temp-char ) = "":U
      813       :
      814           assign
      815               p-start-pos     = p-start-pos + 1
      816               v-init-string   = substring( p-in-string, p-start-pos )
      817               v-temp-char     = substring( v-init-string, 1, 1 )
      818           .
      819       end.
      820       assign
      821           v-temp-pos  = p-split-length
      822           v-temp-char = substring( v-init-string, v-temp-pos, 1 )
      823           v-counter   = 0
      824       .
      825       search-word-end:
      826       do
      827       while trim( v-temp-char ) <> "":U
      828       :
      829           assign
      830               v-counter   = v-counter + 1
      831           .
      832           if v-counter > 20
      833           then do:
      834               assign
      835                   v-temp-pos  = p-split-length
      836               .
      837               leave search-word-end.
      838           end.
      839           assign
      840               v-temp-pos  = v-temp-pos - 1
      841               v-temp-char = substring( v-init-string, v-temp-pos, 1 )
      842           .
      843       end.
      844       assign
      845           p-end-pos = p-start-pos + v-temp-pos - 1
      846       .
      847   end.
      848   end procedure.
      849   define variable vss-include-info9 as character format "X(65)" no-undo
      850   initial "@(#)$Workfile$ $Revision$".
      851   define variable v-fmtcli-name          as character    no-undo.
      852   define variable v-fmtcli-engl-name     as character    no-undo.
      853   define variable v-fmtcli-addres        as character    no-undo.
      854   define variable v-fmtcli-post-addres   as character    no-undo.
      855   define variable v-fmtcli-full-addres   as character    no-undo.
      856   define variable v-fmtcli-phone         as character    no-undo.
      857   define variable v-fmtcli-inn           as character    no-undo.
      858   define variable v-fmtcli-kpp           as character    no-undo.
      859   define variable v-fmtcli-okpo          as character    no-undo.
      860   define variable v-fmtcli-country       as character    no-undo.
      861   define variable v-fmtcli-city          as character    no-undo.
      862   define variable v-fmtcli-index         as character    no-undo.
      863   define variable v-fmtcli-schet-exists  as logical      no-undo.
      864   define variable v-fmtcli-bank-exists   as logical      no-undo.
      865   define variable v-fmtcli-bank-r-schet  as character    no-undo.
      866   define variable v-fmtcli-bank-c-schet  as character    no-undo.
      867   define variable v-fmtcli-bank-bik      as character    no-undo.
      868   define variable v-fmtcli-bank-name     as character    no-undo.
      869   define variable v-fmtcli-bank-addres   as character    no-undo.
      870   define variable v-fmtcli-bank-city     as character    no-undo.
      871   procedure fmtcli-get-bank :
      872   define input parameter p-host-code      as integer          no-undo.
      873   define input parameter p-obj-type       as character        no-undo.
      874   define input parameter p-obj-code       as integer          no-undo.
      875   define input parameter p-curr-code      as integer          no-undo.
      876       define buffer buf_fin-schet     for ub.fin-schet.
      877       define buffer buf_fin-bank      for ub.fin-bank.
      878   do
      879   for buf_fin-schet
      880     , buf_fin-bank
      881   on error undo, return error
      882   :
      883       assign
      884           v-fmtcli-schet-exists       = no
      885           v-fmtcli-bank-exists        = no
      886           v-fmtcli-bank-r-schet       = "":U
      887           v-fmtcli-bank-c-schet       = "":U
      888           v-fmtcli-bank-bik           = "":U
      889           v-fmtcli-bank-name          = "":U
      890           v-fmtcli-bank-addres        = "":U
      891           v-fmtcli-bank-city          = "":U
      892       .
      893       search-for-schet:
      894       for each buf_fin-schet no-lock
      895          where buf_fin-schet.host-code = p-host-code
      896            and buf_fin-schet.cli-type  = p-obj-type
      897            and buf_fin-schet.cli-code  = p-obj-code
      898            and buf_fin-schet.curr-code = p-curr-code
      899       on error undo, return error
      900       :
      901           if buf_fin-schet.status_   = 'удал':U
      902           then do:
      903           end.
      904           else do:
      905               assign
      906                   v-fmtcli-schet-exists   = yes
      907                   v-fmtcli-bank-r-schet   = trim( buf_fin-schet.r-schet )
      908                   v-fmtcli-bank-c-schet   = trim( buf_fin-schet.c-schet )
      909               .
      910               find first buf_fin-bank no-lock
      911                    where buf_fin-bank.host-code = p-host-code
      912                      and buf_fin-bank.code-bank = buf_fin-schet.code-bank
      913               no-error.
      914               if available buf_fin-bank
      915               then do:
      916                   assign
      917                       v-fmtcli-bank-exists      = yes
      918                       v-fmtcli-bank-bik         = trim( buf_fin-bank.bik )
      919                       v-fmtcli-bank-name        = trim( buf_fin-bank.bank-name )
      920                       v-fmtcli-bank-addres      = trim(buf_fin-bank.addres)
      921                       v-fmtcli-bank-city      = trim(buf_fin-bank.bank-city)
      922                   .
      923               end.
      924               else do:
      925                   assign
      926                       v-fmtcli-bank-exists    = no
      927                       v-fmtcli-bank-bik       = "":U
      928                       v-fmtcli-bank-name      = "":U
      929                       v-fmtcli-bank-addres    = "":U
      930                       v-fmtcli-bank-city      = "":U
      931                   .
      932               end.
      933               leave search-for-schet.
      934           end.
      935       end.
      936   end.
      937   end procedure.
      938   procedure fmtcli-get-client :
      939   define input parameter p-obj-type       as character    no-undo.
      940   define input parameter p-obj-code       as integer      no-undo.
      941       define variable v-temp-fmtcli-address      as character     no-undo.
      942       define variable v-num-country-city    as integer      no-undo.
      943       define buffer buf_clients   for ub.clients.
      944       define buffer buf_firm      for ub.firm.
      945       define buffer buf_store     for ub.store.
      946       define buffer buf_shop      for ub.shop.
      947       define buffer buf_person    for ub.person.
      948   do
      949   for buf_clients
      950     , buf_firm
      951     , buf_store
      952     , buf_shop
      953     , buf_person
      954   on error undo, return error
      955   :
      956       assign
      957           v-fmtcli-name           = "":U
      958           v-fmtcli-addres         = "":U
      959           v-fmtcli-post-addres    = "":U
      960           v-fmtcli-full-addres    = "":U
      961           v-fmtcli-phone          = "":U
      962           v-fmtcli-inn            = "":U
      963           v-fmtcli-kpp            = "":U
      964           v-fmtcli-okpo           = "":U
      965           v-fmtcli-city           = "":U
      966           v-fmtcli-index          = "":U
      967           v-fmtcli-country        = "":U
      968       .
      969       find first buf_clients no-lock
      970            where buf_clients.obj-type = p-obj-type
      971              and buf_clients.obj-code = p-obj-code
      972       .
      973       assign
      974           v-fmtcli-name = buf_clients.obj-name
      975       .
      976       case buf_clients.obj-type:
      977          when 'орг':U
      978          then do:
      979               find first buf_firm no-lock
      980                    where buf_firm.firm-code = buf_clients.obj-code
      981                    no-error
      982               .
      983               if available buf_firm
      984               then do:
      985                   assign
      986                       v-num-country-city = num-entries( buf_firm.city )
      987                       v-fmtcli-engl-name = buf_firm.engl-name
      988                   .
      989                   if v-num-country-city > 0
      990                   then do:
      991                       assign
      992                           v-fmtcli-country    = trim( entry( 1, buf_firm.city ) )
      993                       .
      994                   end.
      995                   if v-num-country-city > 1
      996                   then do:
      997                       assign
      998                           v-fmtcli-city       = trim( entry( 2, buf_firm.city ) )
      999                       .
     1000                   end.
     1001                   run fmtcli-concatenate-strings in this-procedure (
     1002                         input v-fmtcli-full-addres
     1003                       , input v-fmtcli-country
     1004                       , input ", ":U
     1005                       , input 50
     1006                       , output v-fmtcli-full-addres
     1007                   ).
     1008                   run fmtcli-concatenate-strings in this-procedure (
     1009                         input v-fmtcli-full-addres
     1010                       , input v-fmtcli-city
     1011                       , input ", ":U
     1012                       , input 50
     1013                       , output v-fmtcli-full-addres
     1014                   ).
     1015                   run fmtcli-concatenate-strings in this-procedure (
     1016                         input v-fmtcli-full-addres
     1017                       , input IF buf_firm.ind = 0 THEN "" ELSE string( buf_firm.ind )
     1018                       , input ", ":U
     1019                       , input 50
     1020                       , output v-fmtcli-full-addres
     1021                   ).
     1022                   run fmtcli-concatenate-strings in this-procedure (
     1023                         input v-fmtcli-post-addres
     1024                       , input v-fmtcli-country
     1025                       , input ", ":U
     1026                       , input 50
     1027                       , output v-fmtcli-post-addres
     1028                   ).
     1029                   run fmtcli-concatenate-strings in this-procedure (
     1030                         input v-fmtcli-post-addres
     1031                       , input v-fmtcli-city
     1032                       , input ", ":U
     1033                       , input 50
     1034                       , output v-fmtcli-post-addres
     1035                   ).
     1036                   run fmtcli-concatenate-strings in this-procedure (
     1037                         input v-fmtcli-post-addres
     1038                       , input string( buf_firm.ind )
     1039                       , input ", ":U
     1040                       , input 50
     1041                       , output v-fmtcli-post-addres
     1042                   ).
     1043                   run fmtcli-concatenate-strings in this-procedure (
     1044                         input substring( buf_firm.addres1, 1, 50 )
     1045                       , input buf_firm.addres2
     1046                       , input " ":U
     1047                       , input 50
     1048                       , output v-temp-fmtcli-address
     1049                   ).
     1050                   run fmtcli-concatenate-strings in this-procedure (
     1051                         input v-temp-fmtcli-address
     1052                       , input substring( buf_firm.addres1, 51, 50 )
     1053                       , input " ":U
     1054                       , input 50
     1055                       , output v-temp-fmtcli-address
     1056                   ).
     1057                   run fmtcli-concatenate-strings in this-procedure (
     1058                         input v-temp-fmtcli-address
     1059                       , input substring( buf_firm.addres1, 101, 50 )
     1060                       , input " ":U
     1061                       , input 50
     1062                       , output v-temp-fmtcli-address
     1063                   ).
     1064                   assign
     1065                       v-fmtcli-addres = v-temp-fmtcli-address
     1066                   .
     1067                   if buf_firm.addres1 <> ?
     1068                   then do:
     1069                       run fmtcli-concatenate-strings in this-procedure (
     1070                             input v-fmtcli-full-addres
     1071                           , input v-fmtcli-addres
     1072                           , input ", ":U
     1073                           , input 0
     1074                           , output v-fmtcli-full-addres
     1075                       ).
     1076                   end.
     1077                   run fmtcli-concatenate-strings in this-procedure (
     1078                         input substring( buf_firm.post-addr1, 1, 50 )
     1079                       , input buf_firm.post-addr2
     1080                       , input " ":U
     1081                       , input 50
     1082                       , output v-fmtcli-post-addres
     1083                   ).
     1084                   run fmtcli-concatenate-strings in this-procedure (
     1085                         input v-fmtcli-post-addres
     1086                       , input substring( buf_firm.post-addr1, 51, 50 )
     1087                       , input " ":U
     1088                       , input 50
     1089                       , output v-fmtcli-post-addres
     1090                   ).
     1091                   run fmtcli-concatenate-strings in this-procedure (
     1092                         input v-fmtcli-post-addres
     1093                       , input substring( buf_firm.post-addr1, 101, 50 )
     1094                       , input " ":U
     1095                       , input 50
     1096                       , output v-fmtcli-post-addres
     1097                   ).
     1098                   assign
     1099                       v-fmtcli-phone         = buf_firm.phone
     1100                       v-fmtcli-inn           = buf_firm.inn
     1101                       v-fmtcli-kpp           = buf_firm.kpp
     1102                       v-fmtcli-okpo          = buf_firm.okpo
     1103                       v-fmtcli-index         = string( buf_firm.ind )
     1104                   .
     1105               end.
     1106          end.
     1107          when 'маг':U
     1108          then do:
     1109               find first buf_shop no-lock
     1110                    where buf_shop.obj-code = buf_clients.obj-code
     1111               .
     1112               if available buf_shop
     1113               then do:
     1114                   run fmtcli-concatenate-strings in this-procedure (
     1115                         input buf_shop.addres1
     1116                       , input buf_shop.addres2
     1117                       , input " ":U
     1118                       , input 50
     1119                       , output v-fmtcli-addres
     1120                   ).
     1121                   assign
     1122                       v-fmtcli-full-addres = v-fmtcli-addres
     1123                       v-fmtcli-post-addres = v-fmtcli-addres
     1124                       v-fmtcli-phone       = buf_shop.phone
     1125                       v-fmtcli-inn         = "":U
     1126                       v-fmtcli-kpp         = "":U
     1127                       v-fmtcli-okpo        = "":U
     1128                       v-fmtcli-city        = "":U
     1129                       v-fmtcli-index       = "":U
     1130                   .
     1131               end.
     1132          end.
     1133          when 'скл':U
     1134          then do:
     1135               find first buf_store no-lock
     1136                    where buf_store.obj-code = buf_clients.obj-code
     1137               .
     1138               if available buf_store
     1139               then do:
     1140                   run fmtcli-concatenate-strings in this-procedure (
     1141                         input buf_store.addres1
     1142                       , input buf_store.addres2
     1143                       , input " ":U
     1144                       , input 50
     1145                       , output v-fmtcli-addres
     1146                   ).
     1147                   assign
     1148                       v-fmtcli-full-addres = v-fmtcli-addres
     1149                       v-fmtcli-phone       = buf_store.phone
     1150                       v-fmtcli-inn         = "":U
     1151                       v-fmtcli-kpp         = "":U
     1152                       v-fmtcli-okpo        = "":U
     1153                       v-fmtcli-city        = "":U
     1154                       v-fmtcli-index       = "":U
     1155                   .
     1156               end.
     1157          end.
     1158          when 'чел':U
     1159          then do:
     1160               find first buf_person no-lock
     1161                    where buf_person.psn-code = buf_clients.obj-code
     1162               .
     1163               if available buf_person
     1164               then do:
     1165                   run fmtcli-concatenate-strings in this-procedure (
     1166                         input ( if buf_person.ind = 0 or buf_person.ind = ?
     1167                                 then "":U
     1168                                 else string( buf_person.ind, "999999")
     1169                                 )
     1170                       , input buf_person.city
     1171                       , input ", ":U
     1172                       , input 0
     1173                       , output v-fmtcli-full-addres
     1174                   ).
     1175                   assign
     1176                       v-fmtcli-addres = buf_person.address
     1177                   .
     1178                   run fmtcli-concatenate-strings in this-procedure (
     1179                         input v-fmtcli-full-addres
     1180                       , input v-fmtcli-addres
     1181                       , input ", ":U
     1182                       , input 0
     1183                       , output v-fmtcli-full-addres
     1184                   ).
     1185                   assign
     1186                       v-fmtcli-phone     = buf_person.phone1
     1187                       v-fmtcli-inn       = buf_person.inn
     1188                       v-fmtcli-kpp       = buf_person.kpp
     1189                       v-fmtcli-okpo      = buf_person.okpo
     1190                       v-fmtcli-city      = buf_person.city
     1191                       v-fmtcli-index     = string( buf_person.ind )
     1192                   .
     1193               end.
     1194          end.
     1195       end case.
     1196   end.
     1197   end procedure.
     1198   procedure fmtcli-concatenate-strings :
     1199   define input parameter p-string-1       as character        no-undo.
     1200   define input parameter p-string-2       as character        no-undo.
     1201   define input parameter p-delimiter      as character        no-undo.
     1202   define input parameter p-length         as integer          no-undo.
     1203   define output parameter p-out-string    as character        no-undo.
     1204   do
     1205   on error undo, return error
     1206   :
     1207       assign
     1208           p-out-string = ( if p-string-1 = ?
     1209                            then "":U
     1210                            else trim( p-string-1 ) )
     1211       .
     1212       assign
     1213           p-out-string = p-out-string
     1214                        + ( if p-out-string = "":U
     1215                            or length( p-out-string ) = p-length
     1216                            or p-string-2 = ?
     1217                            or trim( p-string-2 ) = "":U
     1218                            then "":U
     1219                            else p-delimiter )
     1220                        + ( if p-string-2 = ?
     1221                            or trim( p-string-2 ) = "":U
     1222                            then "":U
     1223                            else trim( p-string-2 ) )
     1224       .
     1225   end.
     1226   end procedure.
     1227   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1228   procedure cur-time :
     1229      define output parameter p-today as date      no-undo .
     1230      define output parameter p-time  as integer   no-undo .
     1231     do
     1232     on error undo, return error
     1233     :
     1234       define variable v-date1 as date      no-undo .
     1235       define variable v-date2 as date      no-undo .
     1236       define variable v-time  as integer   no-undo .
     1237       assign
     1238         v-date1 = today
     1239         v-time  = time
     1240         v-date2 = today
     1241       .
     1242       if v-date1 <> v-date2
     1243       then do:
     1244         assign
     1245           v-date1 = today
     1246           v-time  = v-time
     1247         .
     1248       end.
     1249       assign
     1250         p-today = v-date1
     1251         p-time  = v-time
     1252       .
     1253     end.
     1254   end.
     1255   function cur-time-date returns character
     1256   :
     1257     return string(today, '99/99/9999':U) .
     1258   end.
     1259   function cur-time-mjd returns decimal
     1260   :
     1261     define variable v-date as date      no-undo .
     1262     define variable v-time as integer   no-undo .
     1263     run cur-time in this-procedure
     1264       (output v-date
     1265       ,output v-time
     1266       ) .
     1267     return integer(v-date) - 2400002 + (v-time / 86400) .
     1268   end.
     1269   function cur-time-get-ending-index returns integer
     1270   (input p-number as integer
     1271   )
     1272   :
     1273     if p-number < 0
     1274     or p-number = ?
     1275     then do:
     1276       return 1 .
     1277     end.
     1278     define variable v-rest as integer   no-undo .
     1279     assign
     1280       p-number = p-number modulo 100
     1281     .
     1282     if p-number < 20
     1283     then do:
     1284       assign
     1285         v-rest = p-number
     1286       .
     1287     end.
     1288     else do:
     1289       assign
     1290         v-rest = p-number modulo 10
     1291       .
     1292     end.
     1293     case v-rest :
     1294       when 1
     1295       then do:
     1296         return 2 .
     1297       end.
     1298       when 2 or
     1299       when 3 or
     1300       when 4
     1301       then do:
     1302         return 3 .
     1303       end.
     1304       otherwise do:
     1305         return 1 .
     1306       end.
     1307     end case .
     1308   end.
     1309   procedure cur-time-mjd-to-date :
     1310      define input  parameter i-mjd-diff as decimal no-undo.
     1311      define output parameter o-Date     as date    no-undo.
     1312      define output parameter o-Time     as integer no-undo.
     1313      define variable v-day-number as integer   no-undo .
     1314      if    i-mjd-diff < 0
     1315         or i-mjd-diff = ?
     1316      then do:
     1317         return "?" .
     1318      end.
     1319      assign
     1320         v-day-number = truncate(i-mjd-diff,0).
     1321         o-Date = date(v-day-number + 2400002).
     1322         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1323     .
     1324   end.
     1325   function cur-time-mjd-to-string returns character
     1326   (input p-mjd-diff as decimal
     1327   )
     1328   :
     1329     define variable v-day-number as integer   no-undo .
     1330     define variable v-seconds    as integer   no-undo .
     1331     define variable v-hour       as integer   no-undo .
     1332     define variable v-min        as integer   no-undo .
     1333     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1334     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1335     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1336     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1337     if p-mjd-diff < 0
     1338     or p-mjd-diff = ?
     1339     then do:
     1340       return "?" .
     1341     end.
     1342     assign
     1343       v-day-number = integer(truncate(p-mjd-diff,0))
     1344       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1345     .
     1346     if v-seconds > 86400
     1347     then do:
     1348       assign
     1349         v-seconds = 86400 - 1
     1350       .
     1351     end.
     1352     if v-seconds < 0
     1353     then do:
     1354       assign
     1355         v-seconds = 0
     1356       .
     1357     end.
     1358     assign
     1359       v-hour = truncate(v-seconds / 3600, 0)
     1360     .
     1361     assign
     1362       v-seconds = v-seconds modulo 3600
     1363     .
     1364     assign
     1365       v-min = truncate(v-seconds / 60, 0)
     1366     .
     1367     assign
     1368       v-seconds = v-seconds modulo 60
     1369     .
     1370     return
     1371         (if v-day-number <> 0
     1372           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1373           else ""
     1374         )
     1375       + (if v-day-number <> 0 or v-hour <> 0
     1376           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1377           else ""
     1378         )
     1379       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1380           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1381           else ""
     1382         )
     1383       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1384       .
     1385   end.
     1386   function cur-time-string returns character
     1387   :
     1388     define variable v-date as date      no-undo .
     1389     define variable v-time as integer   no-undo .
     1390     run cur-time in this-procedure
     1391       (output v-date
     1392       ,output v-time
     1393       ) .
     1394     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1395   end.
     1396   function cur-time-string-sec returns character
     1397   :
     1398     define variable v-date as date      no-undo .
     1399     define variable v-time as integer   no-undo .
     1400     run cur-time in this-procedure
     1401       (output v-date
     1402       ,output v-time
     1403       ) .
     1404     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1405   end.
     1406   function cur-time-custom  returns character
     1407   (input p-prefix as character
     1408   ,input p-date-format as character
     1409   ,input p-delimiter as character
     1410   ,input p-time-format as character
     1411   ,input p-suffix as character
     1412   )
     1413   :
     1414     define variable v-date as date      no-undo .
     1415     define variable v-time as integer   no-undo .
     1416     run cur-time in this-procedure
     1417       (output v-date
     1418       ,output v-time
     1419       ) .
     1420     return
     1421       p-prefix
     1422       + string(v-date, p-date-format)
     1423       + p-delimiter
     1424       + string(v-time, p-time-format)
     1425       + p-suffix
     1426       .
     1427   end.
     1428   function cur-time-print  returns character
     1429   :
     1430     define variable v-date as date      no-undo .
     1431     define variable v-time as integer   no-undo .
     1432     run cur-time in this-procedure
     1433       (output v-date
     1434       ,output v-time
     1435       ) .
     1436     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1437   end.
     1438   function cur-time-datetime returns datetime
     1439   :
     1440     define variable v-char as character no-undo .
     1441     define variable v-datetime as datetime no-undo .
     1442     v-char = cur-time-string().
     1443     v-datetime = datetime(v-char).
     1444     return  v-datetime.
     1445   end.
     1446   function cur-time-string-msec returns character
     1447   :
     1448     define variable v-date as datetime  no-undo .
     1449     v-date = now.
     1450     return string(v-date) .
     1451   end.
     1452   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1453   define temp-table temp-parts no-undo   like ub.parts   field free-qnty as decimal   field free-cli-qnty as decimal .
     1454   procedure partslib-clear-temp-parts :
     1455     define buffer buf_temp-parts for temp-parts .
     1456     do
     1457     on error undo, return error
     1458     :
     1459       for each buf_temp-parts
     1460       on error undo, return error
     1461       :
     1462         delete buf_temp-parts .
     1463       end.
     1464     end.
     1465   end procedure.
     1466   procedure partslib-create-temp-parts :
     1467     define parameter buffer buf_parts       for ub.parts .
     1468     define parameter buffer buf_temp-parts  for temp-parts .
     1469     define input  parameter p-goods-twounit as logical   no-undo .
     1470     define variable v-base-part-code as character no-undo .
     1471     do
     1472     on error undo, return error
     1473     :
     1474       if p-goods-twounit = true
     1475       then do:
     1476         assign
     1477           v-base-part-code = entry(1, buf_parts.part-code, '#':U)
     1478         .
     1479       end.
     1480       else do:
     1481         assign
     1482           v-base-part-code = buf_parts.part-code
     1483         .
     1484       end.
     1485       find first buf_temp-parts exclusive-lock
     1486         where buf_temp-parts.obj-type  = buf_parts.obj-type
     1487           and buf_temp-parts.obj-code  = buf_parts.obj-code
     1488           and buf_temp-parts.artic     = buf_parts.artic
     1489           and buf_temp-parts.prod-type = buf_parts.prod-type
     1490           and buf_temp-parts.prod-code = buf_parts.prod-code
     1491           and buf_temp-parts.in-code   = buf_parts.in-code
     1492           and buf_temp-parts.out-code  = 'free-zone':U
     1493           and buf_temp-parts.part-code = v-base-part-code
     1494         no-error.
     1495       if not available buf_temp-parts
     1496       then do:
     1497         create buf_temp-parts .
     1498         buffer-copy buf_parts to buf_temp-parts
     1499         assign
     1500           buf_temp-parts.out-code  = 'free-zone':U
     1501           buf_temp-parts.part-code = v-base-part-code
     1502           buf_temp-parts.rsrv-free = yes
     1503           buf_temp-parts.status_   = no
     1504           buf_temp-parts.qnty      = 0
     1505           buf_temp-parts.fact-qnty = 0
     1506           buf_temp-parts.real-qnty = 0
     1507           buf_temp-parts.cli-qnty  = 0
     1508         .
     1509       end.
     1510     end.
     1511   end procedure.
     1512   procedure partslib-init-temp-parts :
     1513     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
     1514     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
     1515     define input parameter p-artic           like ub.parts.artic     no-undo .
     1516     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
     1517     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
     1518     define buffer buf_parts      for ub.parts .
     1519     define buffer buf_temp-parts for temp-parts .
     1520     define variable v-goods-twounit    as logical   no-undo .
     1521     do
     1522     on error undo, return error
     1523     :
     1524   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1525   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1526     (input  p-artic
     1527     ,input  p-prod-type
     1528     ,input  p-prod-code
     1529     ,input  'twounit=request':u
     1530     ,output v-goods-twounit
     1531     ) no-error .
     1532       if error-status :error
     1533       then do:
     1534         message
     1535           vss-workfile vss-revision vss-description skip
     1536           vss-include-info11 skip
     1537           "Ошибка при определении атрибута товара" skip
     1538           "Артикул" p-artic p-prod-type p-prod-code skip
     1539           "twounit=request" skip
     1540           error-status :get-message(1) skip
     1541           return-value skip
     1542           view-as alert-box error .
     1543         undo, return error return-value .
     1544       end.
     1545       run partslib-clear-temp-parts in this-procedure .
     1546       for each buf_parts
     1547         where buf_parts.obj-type  = p-obj-type
     1548           and buf_parts.obj-code  = p-obj-code
     1549           and buf_parts.artic     = p-artic
     1550           and buf_parts.prod-type = p-prod-type
     1551           and buf_parts.prod-code = p-prod-code
     1552           and buf_parts.rsrv-free = yes
     1553           and buf_parts.status_   = no
     1554           and buf_parts.in-code   <> buf_parts.out-code
     1555       on error undo, return error
     1556       :
     1557         run partslib-create-temp-parts in this-procedure
     1558           (buffer buf_parts
     1559           ,buffer buf_temp-parts
     1560           ,input  v-goods-twounit
     1561           ) .
     1562         define variable v-parts-qnty          as decimal   no-undo .
     1563         define variable v-parts-cli-qnty      as decimal   no-undo .
     1564         define variable v-parts-free-qnty     as decimal   no-undo .
     1565         define variable v-parts-free-cli-qnty as decimal   no-undo .
     1566         if buf_parts.out-code = 'free-zone':U
     1567         then do:
     1568           assign
     1569             v-parts-qnty          = buf_parts.qnty
     1570             v-parts-cli-qnty      = buf_parts.cli-qnty
     1571             v-parts-free-qnty     = buf_parts.qnty
     1572             v-parts-free-cli-qnty = buf_parts.cli-qnty
     1573           .
     1574         end.
     1575         else do:
     1576           assign
     1577             v-parts-qnty          = abs(buf_parts.qnty)
     1578             v-parts-cli-qnty      = abs(buf_parts.cli-qnty)
     1579             v-parts-free-qnty     = 0
     1580             v-parts-free-cli-qnty = 0
     1581           .
     1582         end.
     1583         assign
     1584           buf_temp-parts.qnty          = buf_temp-parts.qnty          + v-parts-qnty
     1585           buf_temp-parts.fact-qnty     = buf_temp-parts.fact-qnty     + v-parts-qnty
     1586           buf_temp-parts.real-qnty     = 0
     1587           buf_temp-parts.cli-qnty      = buf_temp-parts.cli-qnty      + v-parts-cli-qnty
     1588           buf_temp-parts.free-qnty     = buf_temp-parts.free-qnty     + v-parts-free-qnty
     1589           buf_temp-parts.free-cli-qnty = buf_temp-parts.free-cli-qnty + v-parts-free-cli-qnty
     1590         .
     1591       end.
     1592     end.
     1593   end procedure.
     1594   procedure partslib-init-temp-parts-by-factord :
     1595     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
     1596     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
     1597     define input parameter p-artic              like ub.parts.artic     no-undo .
     1598     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
     1599     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
     1600     define input parameter p-fact-order         as decimal   no-undo .
     1601     define input parameter p-include-fact-order as logical   no-undo .
     1602     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
     1603     define buffer buf_gds-obj  for ub.gds-obj .
     1604     do
     1605     on error undo, return error
     1606     :
     1607       do transaction
     1608       on error undo, return error
     1609       :
     1610   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1611   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     1612     (input  p-obj-type
     1613     ,input  p-obj-code
     1614     ,input  p-artic
     1615     ,input  p-prod-type
     1616     ,input  p-prod-code
     1617     ,buffer buf_gds-obj
     1618     ) no-error .
     1619         if error-status :error
     1620         then do:
     1621           message
     1622             vss-workfile vss-revision vss-description skip
     1623             vss-include-info11 skip
     1624             "Невозможно найти товар на объекте" skip
     1625             "Объект" p-obj-type p-obj-code skip
     1626             "Артикул" p-artic p-prod-type p-prod-code skip
     1627             error-status :get-message(1) skip
     1628             return-value skip
     1629             view-as alert-box error .
     1630           undo, return error .
     1631         end.
     1632         find current buf_gds-obj exclusive-lock .
     1633       end.
     1634       run partslib-init-temp-parts in this-procedure
     1635         (input p-obj-type
     1636         ,input p-obj-code
     1637         ,input p-artic
     1638         ,input p-prod-type
     1639         ,input p-prod-code
     1640         ) no-error .
     1641       if error-status :error
     1642       then do:
     1643         message
     1644           vss-workfile vss-revision vss-description skip
     1645           vss-include-info11 skip
     1646           "Ошибка при инициализации текущего остатка по партиям свободной зоны" skip
     1647           "Объект" p-obj-type p-obj-code skip
     1648           "Артикул" p-artic p-prod-type p-prod-code skip
     1649           "p-fact-order" p-fact-order skip
     1650           view-as alert-box error .
     1651         undo, return error .
     1652       end.
     1653       if p-include-fact-order = true
     1654       then do:
     1655         assign
     1656           p-fact-order = p-fact-order - 0.0000000001
     1657         .
     1658       end.
     1659       define variable v-max-fact-order as character no-undo .
     1660       run factord-max-fact-order in this-procedure
     1661         (output v-max-fact-order
     1662         ) no-error .
     1663       if error-status :error
     1664       then do:
     1665         message
     1666           vss-workfile vss-revision vss-description skip
     1667           vss-include-info11 skip
     1668           "Ошибка при вызове процедуры factord-max-fact-order" skip
     1669           "Объект" p-obj-type p-obj-code skip
     1670           "Артикул" p-artic p-prod-type p-prod-code skip
     1671           "p-fact-order" p-fact-order skip
     1672           view-as alert-box error .
     1673         undo, return error .
     1674       end.
     1675       run partslib-update-by-factord in this-procedure
     1676         (input p-obj-type
     1677         ,input p-obj-code
     1678         ,input p-artic
     1679         ,input p-prod-type
     1680         ,input p-prod-code
     1681         ,input p-fact-order
     1682         ,input v-max-fact-order
     1683         ,input false
     1684         ) no-error .
     1685       if error-status :error
     1686       then do:
     1687         message
     1688           vss-workfile vss-revision vss-description skip
     1689           vss-include-info11 skip
     1690           "Ошибка при вызове процедуры partslib-update-by-factord" skip
     1691           "Объект" p-obj-type p-obj-code skip
     1692           "Артикул" p-artic p-prod-type p-prod-code skip
     1693           "p-fact-order" p-fact-order skip
     1694           "v-max-fact-order" v-max-fact-order skip
     1695           view-as alert-box error .
     1696         undo, return error .
     1697       end.
     1698     end.
     1699   end procedure.
     1700   procedure partslib-update-by-factord :
     1701     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
     1702     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
     1703     define input parameter p-artic              like ub.parts.artic     no-undo .
     1704     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
     1705     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
     1706     define input parameter p-start-fact-order   as decimal   no-undo .
     1707     define input parameter p-end-fact-order     as decimal   no-undo .
     1708     define input parameter p-lock-gds-obj       as logical   no-undo .
     1709     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
     1710     define buffer buf_gds-obj  for ub.gds-obj .
     1711     define buffer buf_doc-line for ub.doc-line .
     1712     define variable v-total-parts-qnty as decimal   no-undo .
     1713     define variable v-goods-gds-goods  as logical   no-undo .
     1714     define variable v-goods-twounit    as logical   no-undo .
     1715     do
     1716     on error undo, return error
     1717     :
     1718       if p-start-fact-order > p-end-fact-order
     1719       then do:
     1720         message
     1721           vss-workfile vss-revision vss-description skip
     1722           vss-include-info11 skip
     1723           "Ошибка задания входных параметров" skip
     1724           "Начало интервала превышает конец интервала" skip
     1725           "Объект" p-obj-type p-obj-code skip
     1726           "Артикул" p-artic p-prod-type p-prod-code skip
     1727           "p-start-fact-order" p-start-fact-order skip
     1728           "p-end-fact-order"   p-end-fact-order skip
     1729           view-as alert-box error .
     1730         undo, return error .
     1731       end.
     1732       if p-lock-gds-obj = true
     1733       then do:
     1734         do transaction
     1735         on error undo, return error
     1736         :
     1737   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1738   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     1739     (input  p-obj-type
     1740     ,input  p-obj-code
     1741     ,input  p-artic
     1742     ,input  p-prod-type
     1743     ,input  p-prod-code
     1744     ,buffer buf_gds-obj
     1745     ) no-error .
     1746           if error-status :error
     1747           then do:
     1748             message
     1749               vss-workfile vss-revision vss-description skip
     1750               vss-include-info11 skip
     1751               "Невозможно найти gds-obj" skip
     1752               error-status :get-message(1) skip
     1753               return-value skip
     1754               view-as alert-box error .
     1755             undo, return error .
     1756           end.
     1757           find current buf_gds-obj exclusive-lock .
     1758         end.
     1759       end.
     1760   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1761   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1762     (input  p-artic
     1763     ,input  p-prod-type
     1764     ,input  p-prod-code
     1765     ,input  'gds-goods=request':u
     1766     ,output v-goods-gds-goods
     1767     ) no-error .
     1768       if error-status :error
     1769       then do:
     1770         message
     1771           vss-workfile vss-revision vss-description skip
     1772           vss-include-info11 skip
     1773           "Ошибка при определении атрибута товара" skip
     1774           "Артикул" p-artic p-prod-type p-prod-code skip
     1775           "gds-goods=request" skip
     1776           error-status :get-message(1) skip
     1777           return-value skip
     1778           view-as alert-box error .
     1779         undo, return error return-value .
     1780       end.
     1781   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1782   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1783     (input  p-artic
     1784     ,input  p-prod-type
     1785     ,input  p-prod-code
     1786     ,input  'twounit=request':u
     1787     ,output v-goods-twounit
     1788     ) no-error .
     1789       if error-status :error
     1790       then do:
     1791         message
     1792           vss-workfile vss-revision vss-description skip
     1793           vss-include-info11 skip
     1794           "Ошибка при определении атрибута товара" skip
     1795           "Артикул" p-artic p-prod-type p-prod-code skip
     1796           "twounit=request" skip
     1797           error-status :get-message(1) skip
     1798           return-value skip
     1799           view-as alert-box error .
     1800         undo, return error return-value .
     1801       end.
     1802       for each buf_doc-line no-lock
     1803         where buf_doc-line.obj-type   = p-obj-type
     1804           and buf_doc-line.obj-code   = p-obj-code
     1805           and buf_doc-line.artic      = p-artic
     1806           and buf_doc-line.prod-type  = p-prod-type
     1807           and buf_doc-line.prod-code  = p-prod-code
     1808           and buf_doc-line.status_    = 'факт':U
     1809           and buf_doc-line.fact-order > p-start-fact-order
     1810           and buf_doc-line.fact-order <= p-end-fact-order
     1811       on error undo, return error
     1812       :
     1813         run partslib-process-document in this-procedure
     1814           (input  buf_doc-line.doc-code
     1815           ,input  p-obj-type
     1816           ,input  p-obj-code
     1817           ,input  p-artic
     1818           ,input  p-prod-type
     1819           ,input  p-prod-code
     1820           ,input  v-goods-gds-goods
     1821           ,input  v-goods-twounit
     1822           ,output v-total-parts-qnty
     1823           ) no-error .
     1824         if error-status :error
     1825         then do:
     1826           message
     1827             vss-workfile vss-revision vss-description skip
     1828             vss-include-info11 skip
     1829             "Ошибка при вызове процедуры partslib-process-document" skip
     1830             "Документ" buf_doc-line.doc-code skip
     1831             "Объект" p-obj-type p-obj-code skip
     1832             "Артикул" p-artic p-prod-type p-prod-code skip
     1833             "p-start-fact-order" p-start-fact-order skip
     1834             "p-end-fact-order" p-end-fact-order skip
     1835             error-status :get-message(1) skip
     1836             return-value skip
     1837             view-as alert-box error .
     1838           undo, return error return-value .
     1839         end.
     1840       end.
     1841     end.
     1842   end procedure.
     1843   procedure partslib-process-document :
     1844     define input  parameter p-doc-code         as character no-undo .
     1845     define input  parameter p-obj-type         as character no-undo .
     1846     define input  parameter p-obj-code         as integer   no-undo .
     1847     define input  parameter p-artic            as character no-undo .
     1848     define input  parameter p-prod-type        as character no-undo .
     1849     define input  parameter p-prod-code        as integer   no-undo .
     1850     define input  parameter p-goods-gds-goods  as logical   no-undo .
     1851     define input  parameter p-goods-twounit    as logical   no-undo .
     1852     define output parameter p-total-parts-qnty as decimal   no-undo .
     1853     define variable v-parts-sign as integer   no-undo .
     1854     define buffer buf_trn-doc    for ub.trn-doc .
     1855     define buffer buf_doc-line   for ub.doc-line .
     1856     define buffer buf_parts      for ub.parts .
     1857     define buffer buf_temp-parts for temp-parts .
     1858     do
     1859     on error undo, return error return-value
     1860     :
     1861       find first buf_trn-doc no-lock
     1862         where buf_trn-doc.doc-code = p-doc-code
     1863         no-error .
     1864       if not available buf_trn-doc
     1865       then do:
     1866         undo, return error substitute("Ошибка при поиске документа. Документ &1"
     1867                                      ,p-doc-code
     1868                                      ) .
     1869       end.
     1870       case buf_trn-doc.doc-type
     1871       :
     1872         when 'при':U or
     1873         when 'возврат':U or
     1874         when 'инв':U
     1875         then do:
     1876           assign
     1877             v-parts-sign = -1
     1878           .
     1879         end.
     1880         when 'рас':U or
     1881         when 'спи':U
     1882         then do:
     1883           assign
     1884             v-parts-sign = 1
     1885           .
     1886         end.
     1887         otherwise do:
     1888           undo, return error substitute("Неизвестный тип документа &1"
     1889                                       ,buf_trn-doc.doc-type
     1890                                       ) .
     1891         end.
     1892       end.
     1893       find first buf_doc-line no-lock
     1894         where buf_doc-line.doc-code  = p-doc-code
     1895           and buf_doc-line.artic     = p-artic
     1896           and buf_doc-line.prod-type = p-prod-type
     1897           and buf_doc-line.prod-code = p-prod-code
     1898         no-error .
     1899       if not available buf_doc-line
     1900       then do:
     1901         undo, return error substitute("Ошибка при поиске строки документа. Документ &1. Артикул &2 &3 &4"
     1902                                      ,p-doc-code
     1903                                      ,artic
     1904                                      ,prod-type
     1905                                      ,prod-code
     1906                                      ) .
     1907       end.
     1908       assign
     1909         p-total-parts-qnty = 0
     1910       .
     1911       if p-goods-gds-goods = true
     1912       then do:
     1913         for each buf_parts no-lock
     1914           where buf_parts.out-code  = p-doc-code
     1915             and buf_parts.obj-type  = p-obj-type
     1916             and buf_parts.obj-code  = p-obj-code
     1917             and buf_parts.artic     = p-artic
     1918             and buf_parts.prod-type = p-prod-type
     1919             and buf_parts.prod-code = p-prod-code
     1920         on error undo, return error
     1921         :
     1922           run partslib-create-temp-parts in this-procedure
     1923             (buffer buf_parts
     1924             ,buffer buf_temp-parts
     1925             ,input  p-goods-twounit
     1926             ) .
     1927           assign
     1928             p-total-parts-qnty        = p-total-parts-qnty
     1929                                       + v-parts-sign * buf_parts.fact-qnty
     1930             buf_temp-parts.qnty       = buf_temp-parts.qnty
     1931                                       + v-parts-sign * buf_parts.fact-qnty
     1932             buf_temp-parts.fact-qnty  = buf_temp-parts.fact-qnty
     1933                                       + v-parts-sign * buf_parts.fact-qnty
     1934             buf_temp-parts.cli-qnty   = buf_temp-parts.cli-qnty
     1935                                       + v-parts-sign * buf_parts.cli-qnty
     1936           .
     1937           if buf_temp-parts.qnty = 0
     1938           then do:
     1939             delete buf_temp-parts .
     1940           end.
     1941         end.
     1942       end.
     1943       else do:
     1944         assign
     1945           p-total-parts-qnty = p-total-parts-qnty
     1946                              + v-parts-sign * buf_doc-line.fact-qnty
     1947         .
     1948       end.
     1949     end.
     1950   end procedure.
     1951   procedure partslib-init-temp-parts-by-date :
     1952     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
     1953     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
     1954     define input parameter p-artic           like ub.parts.artic     no-undo .
     1955     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
     1956     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
     1957     define input parameter p-fact-date       as date      no-undo .
     1958     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-date: определение партий свободной зоны на любую дату".
     1959     do
     1960     on error undo, return error
     1961     :
     1962       define variable v-fact-order                as decimal   no-undo .
     1963       define variable v-shift-end-fact-order      as decimal   no-undo .
     1964       define variable v-day-end-fact-order        as decimal   no-undo .
     1965       run factord in this-procedure
     1966         (input  p-fact-date
     1967         ,input  1
     1968         ,input  1
     1969         ,input  ?
     1970         ,input  0
     1971         ,input  false
     1972         ,output v-fact-order
     1973         ,output v-shift-end-fact-order
     1974         ,output v-day-end-fact-order
     1975         ) no-error .
     1976       if error-status :error
     1977       then do:
     1978         message
     1979           vss-workfile vss-revision vss-description skip
     1980           vss-include-info11 skip
     1981           "Ошибка при определении момента времени, на который требуется остаток" skip
     1982           "Объект" p-obj-type p-obj-code skip
     1983           "Артикул" p-artic p-prod-type p-prod-code skip
     1984           "Дата" p-fact-date skip
     1985           view-as alert-box error .
     1986         undo, return error .
     1987       end.
     1988       run partslib-init-temp-parts-by-factord in this-procedure
     1989         (input p-obj-type
     1990         ,input p-obj-code
     1991         ,input p-artic
     1992         ,input p-prod-type
     1993         ,input p-prod-code
     1994         ,input v-day-end-fact-order
     1995         ,input false
     1996         ) no-error .
     1997       if error-status :error
     1998       then do:
     1999         message
     2000           vss-workfile vss-revision vss-description skip
     2001           vss-include-info11 skip
     2002           "Ошибка при вызове метода partslib-init-temp-parts-by-factord" skip
     2003           "Объект" p-obj-type p-obj-code skip
     2004           "Артикул" p-artic p-prod-type p-prod-code skip
     2005           "Дата" p-fact-date skip
     2006           view-as alert-box error .
     2007         undo, return error .
     2008       end.
     2009     end.
     2010   end procedure.
     2011   procedure partslib-calc-cost :
     2012     define output parameter p-fact-qnty      as decimal   no-undo .
     2013     define output parameter p-vat-pc         as decimal   no-undo .
     2014     define output parameter p-slt-pc         as decimal   no-undo .
     2015     define output parameter p-sum-base       as decimal   no-undo .
     2016     define output parameter p-sum-rubl       as decimal   no-undo .
     2017     define output parameter p-vat-base       as decimal   no-undo .
     2018     define output parameter p-vat-rubl       as decimal   no-undo .
     2019     define output parameter p-slt-base       as decimal   no-undo .
     2020     define output parameter p-slt-rubl       as decimal   no-undo .
     2021     define output parameter p-road-tax-base  as decimal   no-undo .
     2022     define output parameter p-road-tax-rubl  as decimal   no-undo .
     2023     define output parameter p-transport-base as decimal   no-undo .
     2024     define output parameter p-transport-rubl as decimal   no-undo .
     2025     define output parameter p-other-base     as decimal   no-undo .
     2026     define output parameter p-other-rubl     as decimal   no-undo .
     2027     define output parameter p-excise-base    as decimal   no-undo .
     2028     define output parameter p-excise-rubl    as decimal   no-undo .
     2029     define variable vss-description as character no-undo init "partslib-calc-cost: расчет сумм в учетных ценах".
     2030     do
     2031     on error undo, return error return-value
     2032     :
     2033       define buffer buf_temp-parts for temp-parts .
     2034       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     2035       define buffer   in-vatp-parts    for ub.parts   .
     2036       define buffer   in-vatp-doc      for ub.trn-doc .
     2037       define buffer   in-vatp-goods    for ub.goods   .
     2038       define buffer   in-vatp-sysconf  for ub.sysconf .
     2039       define buffer   in-vatp_doc-attr for ub.doc-attr.
     2040       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     2041       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     2042       define variable varinvprb                  as   character              no-undo.
     2043       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     2044       define variable cli-base-rate              as   decimal                no-undo.
