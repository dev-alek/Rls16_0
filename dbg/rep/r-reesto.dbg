     1067   define temp-table temp-font no-undo
     1068     field fontnum  as integer
     1069     field fontname as character
     1070     field fontsize as character
     1071     field fonttype as character
     1072     field font-h   as integer
     1073     field font-w   as integer
     1074     field v-row    as integer
     1075     field v-col    as integer
     1076     field v-row-lans as integer
     1077     field v-col-lans as integer
     1078   index pi fontnum
     1079   .
     1080   procedure get-font-ini :
     1081     do
     1082     on error undo, return error return-value
     1083     :
     1084   define variable ii as integer   no-undo .
     1085   define variable v-font7 as character no-undo .
     1086   define variable v-font as character no-undo .
     1087   define variable loc-name as character no-undo .
     1088   define variable loc-size as character no-undo .
     1089   define variable loc-type as character no-undo .
     1090   define variable old_H as integer   no-undo .
     1091   define variable old_w as integer   no-undo .
     1092   define variable old-row  as integer   no-undo .
     1093   define variable old-col  as integer   no-undo .
     1094   define variable old-row-lans  as integer   no-undo .
     1095   define variable old-col-lans  as integer   no-undo .
     1096   define variable vv as integer   no-undo .
     1097   empty temp-table temp-font.
     1098     GET-KEY-VALUE SECTION "fonts" KEY "font7" VALUE v-font7 .
     1099       case num-entries (v-font7) :
     1100         when 4 then do:
     1101             assign
     1102               loc-name = entry ( 1 , v-font7 )
     1103               loc-size = entry ( 2 , v-font7 )
     1104               loc-type = entry ( 3 , v-font7 ) + "," +  entry ( 4 , v-font7 )
     1105             .
     1106         end.
     1107         when 3 then do:
     1108             assign
     1109               loc-name = entry ( 1 , v-font7 )
     1110               loc-size = entry ( 2 , v-font7 )
     1111               loc-type = entry ( 3 , v-font7 )
     1112             .
     1113         end.
     1114         when 2 then  do:
     1115             assign
     1116               loc-name = entry ( 1 , v-font7 )
     1117               loc-size = entry ( 2 , v-font7 )
     1118               loc-type = ""
     1119             .
     1120         end.
     1121         when 1 then do:
     1122             assign
     1123               loc-name = trim(entry ( 1 , v-font7 ))
     1124               loc-size = ""
     1125               loc-type = ""
     1126             .
     1127         end.
     1128       end case.
     1129     create temp-font.
     1130     assign
     1131       temp-font.fontnum  = 7
     1132       temp-font.fontname = trim(loc-name)
     1133       temp-font.fontsize = trim(loc-size)
     1134       temp-font.fonttype = trim(loc-type)
     1135       temp-font.v-row    = 62
     1136       temp-font.v-col    = 136
     1137       temp-font.v-row-lans = 43
     1138       temp-font.v-col-lans = 198
     1139     .
     1140     repeat ii = 16 to 100 :
     1141       get-key-value section 'fonts' key 'font' + string(ii)   value v-font  .
     1142       if v-font = "" or v-font = ? then leave.
     1143       case num-entries (v-font) :
     1144         when 4 then do:
     1145             assign
     1146               loc-name = entry ( 1 , v-font )
     1147               loc-size = entry ( 2 , v-font )
     1148               loc-type = entry ( 3 , v-font ) + "," +  entry ( 4 , v-font )
     1149             .
     1150         end.
     1151         when 3 then do:
     1152             assign
     1153               loc-name = entry ( 1 , v-font )
     1154               loc-size = entry ( 2 , v-font )
     1155               loc-type = entry ( 3 , v-font )
     1156             .
     1157         end.
     1158         when 2 then do:
     1159             assign
     1160               loc-name = entry ( 1 , v-font )
     1161               loc-size = entry ( 2 , v-font )
     1162               loc-type = ""
     1163             .
     1164         end.
     1165         when 1 then do:
     1166             assign
     1167               loc-name = trim(entry ( 1 , v-font ))
     1168               loc-size = ""
     1169               loc-type = ""
     1170             .
     1171         end.
     1172       end case.
     1173     create temp-font.
     1174     assign
     1175       temp-font.fontnum  = ii
     1176       temp-font.fontname = trim(loc-name)
     1177       temp-font.fontsize = trim(loc-size)
     1178       temp-font.fonttype = trim(loc-type)
     1179     .
     1180     end.
     1181       for each temp-font :
     1182          vv = integer(entry(2,temp-font.fontsize, "=" )) no-error .
     1183          if  vv = ? then vv =  0 .
     1184           run rep/exfont.p (
     1185             input   temp-font.fontname ,
     1186             input   vv ,
     1187             input   temp-font.fonttype ,
     1188             output  temp-font.font-h   ,
     1189             output  temp-font.font-w   )
     1190           .
     1191       end.
     1192   find first temp-font where  temp-font.fontnum  = 7  .
     1193   old_H = temp-font.font-H .
     1194   old_w = temp-font.font-W .
     1195   old-row = temp-font.v-row .
     1196   old-col = temp-font.v-col .
     1197   old-row-lans = temp-font.v-row-lans .
     1198   old-col-lans = temp-font.v-col-lans .
     1199       for each temp-font where
     1200                temp-font.fontnum  <> 7 :
     1201           assign
     1202               temp-font.v-row    = old_H * old-row / temp-font.font-h
     1203               temp-font.v-col    = old_W * old-col / temp-font.font-W
     1204               temp-font.v-row-lans    = old_H * old-row-lans / temp-font.font-h
     1205               temp-font.v-col-lans    = old_W * old-col-lans / temp-font.font-W
     1206           .
     1207       end.
     1208     end.
     1209   end procedure.
     1210   PROCEDURE How-name :
     1211   define input  parameter h as integer no-undo .
     1212   define input  parameter w as integer no-undo .
     1213   define output parameter n as character  no-undo .
     1214   define variable A4port-H as integer   no-undo init 63.
     1215   define variable A4port-W as integer   no-undo init 136.
     1216   define variable A4lans-H as integer   no-undo init 43.
     1217   define variable A4lans-W as integer   no-undo init 198.
     1218   define variable Strim-W  as integer   no-undo init 278.
     1219   run define-a4-size (
     1220        input ReportFontNum
     1221       ,output A4port-H
     1222       ,output A4port-W
     1223       ,output A4lans-H
     1224       ,output A4lans-W ).
     1225   If w >= 1 and w <= A4port-W Then DO:
     1226     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     1227     If h > A4lans-H  and h <= A4port-H Then n = "A4-port":U.
     1228     If h > A4port-H              Then n = "to-file":U.
     1229   End.
     1230   If w > A4port-W and w <= A4lans-W Then DO:
     1231     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     1232     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     1233     If h > A4port-H              Then n = "to-file":U.
     1234   End.
     1235   If w > A4lans-W and w <= Strim-W Then DO:
     1236     If h >= 1  and h <= A4lans-H Then n = "to-file":U.
     1237     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     1238     If h > A4port-H              Then n = "to-file":U.
     1239   End.
     1240   If w > Strim-W Then DO:
     1241      n = "to-file":U.
     1242   End.
     1243   END PROCEDURE.
     1244   PROCEDURE define-a4-size :
     1245   define input  parameter p-ReportFontNum as integer   no-undo .
     1246   define output parameter A4port-H as integer   no-undo .
     1247   define output parameter A4port-W as integer   no-undo .
     1248   define output parameter A4lans-H as integer   no-undo .
     1249   define output parameter A4lans-W as integer   no-undo .
     1250   if not can-find (first temp-font ) then do:
     1251      run get-font-ini .
     1252   end.
     1253   find first temp-font where temp-font.fontnum = p-ReportFontNum no-error .
     1254   if available temp-font then do:
     1255   assign
     1256     A4port-H = temp-font.v-row
     1257     A4port-W = temp-font.v-col
     1258     A4lans-H = temp-font.v-row-lans
     1259     A4lans-W = temp-font.v-col-lans
     1260   .
     1261   end.
     1262   else do:
     1263   assign
     1264     A4port-H = 63
     1265     A4port-W = 136
     1266     A4lans-H = 43
     1267     A4lans-W = 198
     1268   .
     1269   end.
     1270   END PROCEDURE.
