     2006   PROCEDURE CalcItog :
     2007       Assign
     2008         Coast1        = 0
     2009         Coast-vat1    = 0
     2010         Coast2        = 0
     2011         Coast-vat2    = 0
     2012         Coast3        = 0
     2013         Coast-vat3    = 0
     2014         Coast4        = 0
     2015         Coast-vat4    = 0
     2016      .
     2017      define buffer buf_obj-list for obj-list.
     2018      find first buf_obj-list no-error .
     2019       run ostatok  in this-procedure (
     2020           input buf_obj-list.obj-code  ,
     2021           input buf_obj-list.obj-type  ,x-TOG-Shift,
     2022           input x-date-start - 1 ,
     2023           input date('')      , x-Shift-Start,x-Shift-End,
     2024           input 'cost':U   ,
     2025           input '##,##':U,
     2026           input false   ,
     2027           output  Quantity1   ,
     2028           output  Coast_R1    ,
     2029           output  Coast_V1    ,
     2030           output  VAT_R1      ,
     2031           output  VAT_V1      ,
     2032           output  Fact-order-1-C ).
     2033       run ostatok  in this-procedure(
     2034           input buf_obj-list.obj-code  ,
     2035           input buf_obj-list.obj-type  ,x-TOG-Shift,
     2036           input x-date-start - 1 ,
     2037           input date('')      , x-Shift-Start,x-Shift-End,
     2038           input 'crsa':U   ,
     2039           input '##,##':U,
     2040           input false ,
     2041           output  Quantity1  ,
     2042           output  Coast_R3   ,
     2043           output  Coast_V3   ,
     2044           output  VAT_R3     ,
     2045           output  VAT_V3     ,
     2046           output  Fact-order-1-P ).
     2047           Fact-order-1 = Fact-order-1-P .
     2048       run ostatok  in this-procedure (
     2049           input buf_obj-list.obj-code  ,
     2050           input buf_obj-list.obj-type  , x-TOG-Shift,
     2051           input x-date-start  ,
     2052           input x-date-end    , x-Shift-Start,x-Shift-End,
     2053           input 'cost':U   ,
     2054           input '##,##':U,
     2055           input false ,
     2056           output  Quantity2  ,
     2057           output  Coast_R2   ,
     2058           output  Coast_V2   ,
     2059           output  VAT_R2     ,
     2060           output  VAT_V2     ,
     2061           output  Fact-order-2-C ).
     2062       run ostatok  in this-procedure (
     2063           input buf_obj-list.obj-code  ,
     2064           input buf_obj-list.obj-type  , x-TOG-Shift,
     2065           input x-date-start  ,
     2066           input x-date-end    , x-Shift-Start , x-Shift-End,
     2067           input 'crsa':U   ,
     2068           input '##,##':U,
     2069           input false      ,
     2070           output  Quantity2  ,
     2071           output  Coast_R4   ,
     2072           output  Coast_V4   ,
     2073           output  VAT_R4     ,
     2074           output  VAT_V4     ,
     2075           output  Fact-order-2-P ).
     2076           Fact-order-2 = Fact-order-2-P .
     2077       Assign
     2078         Coast1        =  if tPrintRubl then Coast_R1 else  Coast_V1
     2079         Coast-vat1    =  if tPrintRubl then VAT_R1   else  VAT_V1
     2080         Coast2        =  if tPrintRubl then Coast_R2 else  Coast_V2
     2081         Coast-vat2    =  if tPrintRubl then VAT_R2   else  VAT_V2
     2082         Coast3        =  if tPrintRubl then Coast_R3 else  Coast_V3
     2083         Coast-vat3    =  if tPrintRubl then VAT_R3   else  VAT_V3
     2084         Coast4        =  if tPrintRubl then Coast_R4 else  Coast_V4
     2085         Coast-vat4    =  if tPrintRubl then VAT_R4   else  VAT_V4
     2086         .
     2087   END PROCEDURE.
     2088   PROCEDURE foreach :
     2089     run pre-foreach-intmove.
     2090     If sliv# Then run pre-foreach.
     2091     for each tdedt where tdedt.id  <> 'rs':U + ',' + 'es':U  no-lock :
     2092         if tdedt.id = 'ot':U Then find-str = 'cgsr':U + ','.
     2093                                         Else find-str = temp-find-str.
     2094         for each obj-list ,
     2095             each  ub.ot-tot no-lock where
     2096                   ub.ot-tot.obj-type     = obj-list.obj-type
     2097               and ub.ot-tot.obj-code     = obj-list.obj-code
     2098               and ub.ot-tot.ext-doc-type = tdedt.id
     2099               and ub.ot-tot.fact-order   >  fact-order-1
     2100               and ub.ot-tot.fact-order   <= fact-order-2
     2101               and lookup  (ub.ot-tot.sum-type  , find-str ) <> 0
     2102               and can-find (first tmp-doc where tmp-doc.doc-code = ub.ot-tot.doc-code) = false
     2103               break by ub.ot-tot.ext-doc-type
     2104                     by ub.ot-tot.fact-order
     2105                     by ub.ot-tot.doc-code
     2106                     :
     2107   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2108     ii = ii + 1.
     2109   IF ( ii modulo v-account = 0 )  then DO:
     2110             if  log-manager:logfile-name ne ?
     2111             then DO:
     2112                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     2113             end.
     2114              if mFrameView
     2115              then do:
     2116               DISPLAY
     2117                 ii @ RecordsDone
     2118                 WITH FRAME InfoFrame.
     2119              end.
     2120   End.
     2121      if v-button-stop then  DO:
     2122            if mFrameView
     2123            then
     2124               PROCESS EVENTS.
     2125            IF StopProcessing THEN DO:
     2126            RETURN error.
     2127            End.
     2128      end.
     2129     Find ub.trn-doc where ub.trn-doc.doc-code = ub.ot-tot.doc-code no-lock no-error.
     2130     if avail ub.trn-doc then do:
     2131                       Assign
     2132                         fact-date      = ub.trn-doc.fact-date
     2133                         doc-code       = ub.ot-tot.doc-code
     2134                         cli-name       = ub.trn-doc.cli-name
     2135                         .
     2136                       end.
     2137    else do:
     2138    Assign
     2139         fact-date      = ?
     2140         doc-code       = ub.ot-tot.doc-code
     2141         cli-name       = ""
     2142         qnty           = 0
     2143         .
     2144         end.
     2145         IF ub.ot-tot.sum-type = 'cgsr':U  THEN DO:
     2146                 If  ub.ot-tot.ext-doc-type = 'ot':U then DO:
     2147                     Find Last ub.price-doc where ub.price-doc.doc-num = ub.ot-tot.doc-code no-lock no-error.
     2148                     Assign
     2149                       fact-date      = If ub.ot-tot.ext-doc-type <> 'ot':U then  ub.trn-doc.fact-date Else (If Available ub.price-doc THEN ub.price-doc.fact-date ELSE date(''))
     2150                       doc-code       = ub.ot-tot.doc-code
     2151                       cli-name       = If ub.ot-tot.ext-doc-type <> 'ot':U then ub.trn-doc.cli-name Else ""
     2152                       qnty           = ub.ot-tot.fact-qnty
     2153                       Sale-sum-ot   = if tPrintRubl then ub.ot-tot.sum-rubl else ub.ot-tot.sum-base.
     2154                       Accumulate Sale-sum-ot (TOTAL) .
     2155                 End.
     2156               if  ub.ot-tot.ext-doc-type = 'vt':U then do :
     2157                 Find Last ub.trn-doc where ub.trn-doc.doc-code = ub.ot-tot.doc-code no-lock no-error.
     2158                 if avail ub.trn-doc then
     2159                                 Assign
     2160                                     fact-date      = ub.trn-doc.fact-date
     2161                                     doc-code       = ub.ot-tot.doc-code
     2162                                     cli-name       = ub.trn-doc.cli-name
     2163                                     qnty           = ub.ot-tot.fact-qnty
     2164                                     .
     2165                   if not can-find
     2166                   (first cost-ot-tot-inv where
     2167                          cost-ot-tot-inv.doc-code = ub.ot-tot.doc-code and
     2168                          cost-ot-tot-inv.sum-type = 'cssr':U no-lock )
     2169                           Then
     2170                           Assign
     2171                             SumWithNDS-coast    = 0
     2172                             VAT-Sum-coast       = 0
     2173                             SLT-sum-coast       = 0
     2174                             SumWithoutNDS-coast = 0
     2175                           .
     2176                   if not can-find
     2177                   (first sale-ot-tot-inv where
     2178                          sale-ot-tot-inv.doc-code = ub.ot-tot.doc-code and
     2179                          sale-ot-tot-inv.sum-type = 'sasr':U no-lock )
     2180                           Then
     2181                           Assign
     2182                             discnt-sum   =      0
     2183                             ov-sum       =      0
     2184                             VAT-Sum      =      0
     2185                             SLT-sum      =      0
     2186                             SumWithoutNDS =     0
     2187                             SumWithNDS    =     0
     2188                             .
     2189               End.
     2190         End.
     2191         IF ub.ot-tot.sum-type = 'sasr':U  THEN DO:
     2192             Find Last ub.trn-doc where ub.trn-doc.doc-code = ub.ot-tot.doc-code no-lock no-error.
     2193                 If  ub.ot-tot.ext-doc-type = 'ot':U then
     2194                     Find Last ub.price-doc where ub.price-doc.doc-num = ub.ot-tot.doc-code no-lock no-error.
     2195             Assign
     2196             fact-date      = If ub.ot-tot.ext-doc-type <> 'ot':U then  ub.trn-doc.fact-date Else (If Available ub.price-doc then ub.price-doc.fact-date ELSE date(''))
     2197             doc-code       = ub.ot-tot.doc-code
     2198             cli-name       = If ub.ot-tot.ext-doc-type <> 'ot':U then ub.trn-doc.cli-name Else " "
     2199             qnty           = ub.ot-tot.fact-qnty
     2200             SumWithNDS     = if tPrintRubl then ub.ot-tot.sum-rubl else ub.ot-tot.sum-base.
     2201             iF SumWithNDS = ? tHEN SumWithNDS = 0.
     2202             If not Available ub.trn-doc Then
     2203                Assign    discnt-sum     = 0
     2204                          ov-sum         = 0.
     2205             discnt-sum     = if tPrintRubl then ub.ot-tot.other-rubl
     2206                                            else ub.ot-tot.other-base .
     2207              iF discnt-sum = ? tHEN discnt-sum = 0.
     2208              if ub.ot-tot.ext-doc-type = 'vt':U THEN discnt-sum = 0.
     2209             Assign
     2210             VAT_pc         = 0
     2211             VAT-Sum        = if tPrintRubl then ub.ot-tot.VAT-rubl else ub.ot-tot.VAT-base
     2212             SLT_pc         = 0
     2213             SLT-sum        = if tPrintRubl then ub.ot-tot.SLT-rubl else ub.ot-tot.SLT-base.
     2214             iF VAT-Sum = ? tHEN VAT-Sum = 0.
     2215             iF SLT-sum = ? tHEN slt-Sum = 0.
     2216             SumWithoutNDS  = SumWithNDS - VAT-Sum.
     2217               FIND LAST crsa-ot-tot where
     2218                   crsa-ot-tot.doc-code = ub.ot-tot.doc-code   and
     2219                   crsa-ot-tot.sum-type = 'cgsr':U    and
     2220                   crsa-ot-tot.cat-id   = ub.ot-tot.cat-id  no-lock use-index pi.
     2221                   if available crsa-ot-tot then
     2222                   sale-sum       = if tPrintRubl then crsa-ot-tot.sum-rubl else crsa-ot-tot.sum-base .
     2223                   Else sale-sum  = 0.
     2224                   ov-sum =  sale-sum - ( SumWithNDS +  discnt-sum ).
     2225             Accumulate sale-sum     (TOTAL) .
     2226             Accumulate qnty         (TOTAL) .
     2227             Accumulate SumWithNDS   (TOTAL) .
     2228             Accumulate discnt-sum   (TOTAL) .
     2229             Accumulate ov-sum       (TOTAL) .
     2230             Accumulate VAT-Sum      (TOTAL) .
     2231             Accumulate SLT-sum      (TOTAL) .
     2232             Accumulate SumWithoutNDS  (TOTAL) .
     2233          End.
     2234         IF ub.ot-tot.sum-type = 'cssr':U  THEN DO:
     2235             Assign
     2236             SumWithNDS-coast     = if tPrintRubl then ub.ot-tot.sum-rubl else ub.ot-tot.sum-base
     2237             VAT-Sum-coast        = if tPrintRubl then ub.ot-tot.VAT-rubl else ub.ot-tot.VAT-base
     2238             SLT-sum-coast        = if tPrintRubl then ub.ot-tot.SLT-rubl else ub.ot-tot.SLT-base
     2239             SumWithoutNDS-coast  = SumWithNDS-coast - VAT-Sum-coast.
     2240             if fact-date = date('') and ub.ot-tot.ext-doc-type <> 'ot':U then do:
     2241                 Find Last ub.trn-doc where ub.trn-doc.doc-code = ub.ot-tot.doc-code no-lock no-error.
     2242                 if avail ub.trn-doc then
     2243                                       Assign
     2244                                           fact-date      = ub.trn-doc.fact-date
     2245                                           doc-code       = ub.ot-tot.doc-code
     2246                                           cli-name       = ub.trn-doc.cli-name
     2247                                           .
     2248             end.
     2249             Accumulate SumWithNDS-coast          (TOTAL) .
     2250             Accumulate VAT-Sum-coast             (TOTAL) .
     2251             Accumulate SLT-sum-coast             (TOTAL) .
     2252             Accumulate SumWithoutNDS-coast       (TOTAL) .
     2253          End.
     2254        IF ub.ot-tot.sum-type BEGINS 'cssr':U and ub.ot-tot.sum-type <> 'cssr':U Then DO:
     2255               IF CostSum Then DO:
     2256                 IF entry (2 , ub.ot-tot.cat-id) = '##':U Then DO:
     2257   create tmp#taxVAT.
     2258   assign tmp#taxVAT.type    = ot-tot.sum-type
     2259         tmp#taxVAT.pc      = entry (1 , ot-tot.cat-id)
     2260         tmp#taxVAT.sum     = if tprintrubl then ot-tot.VAT-rubl else ot-tot.VAT-base
     2261         tmp#taxVAT.sum_full     = if tprintrubl then ot-tot.sum-rubl else ot-tot.sum-base
     2262         .
     2263   i = i + 1.
     2264   find first acc#taxVAT where acc#taxVAT.pc   = tmp#taxVAT.pc
     2265                           and acc#taxVAT.type = tmp#taxVAT.type
     2266                           no-error.
     2267   if available acc#taxVAT then
     2268     assign  acc#taxVAT.sum     = acc#taxVAT.sum + (if tprintrubl then ot-tot.VAT-rubl else ot-tot.VAT-base).
     2269     else do:
     2270         create acc#taxVAT.
     2271         assign acc#taxVAT.type    = ot-tot.sum-type
     2272                 acc#taxVAT.pc      = entry (1 , ot-tot.cat-id)
     2273                 acc#taxVAT.sum     = if tprintrubl then ot-tot.VAT-rubl else ot-tot.VAT-base
     2274                 acc#taxVAT.sum_full = if tprintrubl then ot-tot.sum-rubl else ot-tot.sum-base.
     2275             acc-i = acc-i + 1.
     2276     end.
     2277      End.
     2278                    Else DO:
     2279   create tmp#taxslt.
     2280   assign tmp#taxslt.type    = ot-tot.sum-type
     2281         tmp#taxslt.pc      = entry (2 , ot-tot.cat-id)
     2282         tmp#taxslt.sum     = if tprintrubl then ot-tot.slt-rubl else ot-tot.slt-base
     2283         tmp#taxslt.sum_full     = if tprintrubl then ot-tot.sum-rubl else ot-tot.sum-base
     2284         .
     2285   j = j + 1.
     2286   find first acc#taxslt where acc#taxslt.pc   = tmp#taxslt.pc
     2287                           and acc#taxslt.type = tmp#taxslt.type
     2288                           no-error.
     2289   if available acc#taxslt then
     2290     assign  acc#taxslt.sum     = acc#taxslt.sum + (if tprintrubl then ot-tot.slt-rubl else ot-tot.slt-base).
     2291     else do:
     2292         create acc#taxslt.
     2293         assign acc#taxslt.type    = ot-tot.sum-type
     2294                 acc#taxslt.pc      = entry (2 , ot-tot.cat-id)
     2295                 acc#taxslt.sum     = if tprintrubl then ot-tot.slt-rubl else ot-tot.slt-base
     2296                 acc#taxslt.sum_full = if tprintrubl then ot-tot.sum-rubl else ot-tot.sum-base.
     2297             acc-j = acc-j + 1.
     2298     end.
     2299     End.
     2300                 End.
     2301             End.
     2302        IF ub.ot-tot.sum-type BEGINS 'sasr':U and ub.ot-tot.sum-type <> 'sasr':U Then DO:
     2303                 IF entry (2 , ub.ot-tot.cat-id) = '##':U Then DO:
     2304   create tmp#taxVAT.
     2305   assign tmp#taxVAT.type    = ot-tot.sum-type
     2306         tmp#taxVAT.pc      = entry (1 , ot-tot.cat-id)
     2307         tmp#taxVAT.sum     = if tprintrubl then ot-tot.VAT-rubl else ot-tot.VAT-base
     2308         tmp#taxVAT.sum_full     = if tprintrubl then ot-tot.sum-rubl else ot-tot.sum-base
     2309         .
     2310   i = i + 1.
     2311   find first acc#taxVAT where acc#taxVAT.pc   = tmp#taxVAT.pc
     2312                           and acc#taxVAT.type = tmp#taxVAT.type
     2313                           no-error.
     2314   if available acc#taxVAT then
     2315     assign  acc#taxVAT.sum     = acc#taxVAT.sum + (if tprintrubl then ot-tot.VAT-rubl else ot-tot.VAT-base).
     2316     else do:
     2317         create acc#taxVAT.
     2318         assign acc#taxVAT.type    = ot-tot.sum-type
     2319                 acc#taxVAT.pc      = entry (1 , ot-tot.cat-id)
     2320                 acc#taxVAT.sum     = if tprintrubl then ot-tot.VAT-rubl else ot-tot.VAT-base
     2321                 acc#taxVAT.sum_full = if tprintrubl then ot-tot.sum-rubl else ot-tot.sum-base.
     2322             acc-i = acc-i + 1.
     2323     end.
     2324      End.
     2325                    Else DO:
     2326   create tmp#taxslt.
     2327   assign tmp#taxslt.type    = ot-tot.sum-type
     2328         tmp#taxslt.pc      = entry (2 , ot-tot.cat-id)
     2329         tmp#taxslt.sum     = if tprintrubl then ot-tot.slt-rubl else ot-tot.slt-base
     2330         tmp#taxslt.sum_full     = if tprintrubl then ot-tot.sum-rubl else ot-tot.sum-base
     2331         .
     2332   j = j + 1.
     2333   find first acc#taxslt where acc#taxslt.pc   = tmp#taxslt.pc
     2334                           and acc#taxslt.type = tmp#taxslt.type
     2335                           no-error.
     2336   if available acc#taxslt then
     2337     assign  acc#taxslt.sum     = acc#taxslt.sum + (if tprintrubl then ot-tot.slt-rubl else ot-tot.slt-base).
     2338     else do:
     2339         create acc#taxslt.
     2340         assign acc#taxslt.type    = ot-tot.sum-type
     2341                 acc#taxslt.pc      = entry (2 , ot-tot.cat-id)
     2342                 acc#taxslt.sum     = if tprintrubl then ot-tot.slt-rubl else ot-tot.slt-base
     2343                 acc#taxslt.sum_full = if tprintrubl then ot-tot.sum-rubl else ot-tot.sum-base.
     2344             acc-j = acc-j + 1.
     2345     end.
     2346     End.
     2347        End.
     2348         IF ub.ot-tot.sum-type BEGINS 'cgsr':U and ub.ot-tot.sum-type <> 'cgsr':U Then DO:
     2349                   IF entry (2 , ub.ot-tot.cat-id) = '##':U Then DO:
     2350   create tmp#taxVAT.
     2351   assign tmp#taxVAT.type    = ot-tot.sum-type
     2352         tmp#taxVAT.pc      = entry (1 , ot-tot.cat-id)
     2353         tmp#taxVAT.sum     = if tprintrubl then ot-tot.VAT-rubl else ot-tot.VAT-base
     2354         tmp#taxVAT.sum_full     = if tprintrubl then ot-tot.sum-rubl else ot-tot.sum-base
     2355         .
     2356   i = i + 1.
     2357   find first acc#taxVAT where acc#taxVAT.pc   = tmp#taxVAT.pc
     2358                           and acc#taxVAT.type = tmp#taxVAT.type
     2359                           no-error.
     2360   if available acc#taxVAT then
     2361     assign  acc#taxVAT.sum     = acc#taxVAT.sum + (if tprintrubl then ot-tot.VAT-rubl else ot-tot.VAT-base).
     2362     else do:
     2363         create acc#taxVAT.
     2364         assign acc#taxVAT.type    = ot-tot.sum-type
     2365                 acc#taxVAT.pc      = entry (1 , ot-tot.cat-id)
     2366                 acc#taxVAT.sum     = if tprintrubl then ot-tot.VAT-rubl else ot-tot.VAT-base
     2367                 acc#taxVAT.sum_full = if tprintrubl then ot-tot.sum-rubl else ot-tot.sum-base.
     2368             acc-i = acc-i + 1.
     2369     end.
     2370      End.
     2371                     Else DO:
     2372   create tmp#taxslt.
     2373   assign tmp#taxslt.type    = ot-tot.sum-type
     2374         tmp#taxslt.pc      = entry (2 , ot-tot.cat-id)
     2375         tmp#taxslt.sum     = if tprintrubl then ot-tot.slt-rubl else ot-tot.slt-base
     2376         tmp#taxslt.sum_full     = if tprintrubl then ot-tot.sum-rubl else ot-tot.sum-base
     2377         .
     2378   j = j + 1.
     2379   find first acc#taxslt where acc#taxslt.pc   = tmp#taxslt.pc
     2380                           and acc#taxslt.type = tmp#taxslt.type
     2381                           no-error.
     2382   if available acc#taxslt then
     2383     assign  acc#taxslt.sum     = acc#taxslt.sum + (if tprintrubl then ot-tot.slt-rubl else ot-tot.slt-base).
     2384     else do:
     2385         create acc#taxslt.
     2386         assign acc#taxslt.type    = ot-tot.sum-type
     2387                 acc#taxslt.pc      = entry (2 , ot-tot.cat-id)
     2388                 acc#taxslt.sum     = if tprintrubl then ot-tot.slt-rubl else ot-tot.slt-base
     2389                 acc#taxslt.sum_full = if tprintrubl then ot-tot.sum-rubl else ot-tot.sum-base.
     2390             acc-j = acc-j + 1.
     2391     end.
     2392     End.
     2393         End.
     2394             if first-of ( ub.ot-tot.ext-doc-type ) then  run break-h-1.
     2395             if last-of ( ub.ot-tot.doc-code ) then do:
     2396                 if (ub.ot-tot.sum-type     =  'cgsr':U  and
     2397                    not (ub.ot-tot.ext-doc-type = 'vt':U ))
     2398                    then do:
     2399                       run break-ot.
     2400                       if ub.ot-tot.ext-doc-type = 'ap':U and costsum then run break-cost.
     2401                    end.
     2402                    else do:
     2403                       run break-1str.
     2404                       if available ub.trn-doc then do:
     2405                         if (absolute(ub.trn-doc.fact-qnty) - absolute(ub.trn-doc.doc-qnty) <> 0)
     2406                             and ub.ot-tot.ext-doc-type <> 'vt':U
     2407                             then run break-akt.
     2408                         end.
     2409                       if costsum then run break-cost.
     2410                       run break-2str.
     2411                       if dispupfact then run break-disp .
     2412                    end.
     2413                run erase-var.
     2414             end.
     2415             if last-of ( ub.ot-tot.ext-doc-type ) then do:
     2416                 qnty               = accum total       qnty                       .
     2417                 sumwithnds         = accum total       sumwithnds                 .
     2418                 discnt-sum         = accum total       discnt-sum                 .
     2419                 ov-sum             = accum total       ov-sum                     .
     2420                 vat-sum            = accum total       vat-sum                    .
     2421                 slt-sum            = accum total       slt-sum                    .
     2422                 sumwithoutnds      = accum total       sumwithoutnds              .
     2423                 sumwithnds-coast   = accum total       sumwithnds-coast           .
     2424                 vat-sum-coast      = accum total       vat-sum-coast              .
     2425                 slt-sum-coast      = accum total       slt-sum-coast              .
     2426                 sumwithoutnds-coast= accum total       sumwithoutnds-coast        .
     2427                 sale-sum-ot        = accum total       sale-sum-ot                .
     2428                 sale-sum           = (accum total       sale-sum   )  + sale-sum-ot  .
     2429   for each tmp#taxvat : delete tmp#taxvat. end.
     2430   for each acc#taxvat :
     2431     create tmp#taxvat.
     2432     assign tmp#taxvat.type   = acc#taxvat.type
     2433           tmp#taxvat.pc      = acc#taxvat.pc
     2434           tmp#taxvat.sum     = acc#taxvat.sum.
     2435   end.
     2436   i = acc-i.
     2437   for each tmp#taxslt : delete tmp#taxslt. end.
     2438   for each acc#taxslt :
     2439     create tmp#taxslt.
     2440     assign tmp#taxslt.type   = acc#taxslt.type
     2441           tmp#taxslt.pc      = acc#taxslt.pc
     2442           tmp#taxslt.sum     = acc#taxslt.sum.
     2443   end.
     2444   j = acc-j.
     2445             assign
     2446                   quantity3  = quantity3   + qnty
     2447                   coast5     = coast5      + sumwithnds-coast
     2448                   coast6     = coast6      + sale-sum
     2449                   .
     2450                run break-f-1.
     2451                End.
     2452         end.
     2453     end.
     2454     If sliv#  Then run runkassa in this-procedure.
     2455     run run-intmove.
     2456   END PROCEDURE.
     2457   PROCEDURE Break-H-1 :
     2458   Display stream OutStream
     2459       sym1
     2460       sym2
     2461       sym3
     2462       CAPS (tdedt.name)  @ F-cli-name
     2463       sym4
     2464       sym5
     2465       sym6
     2466       sym7
     2467       sym8
     2468       sym9
     2469       sym10
     2470       sym11
     2471       sym12
     2472       sym13
     2473       sym14
     2474       with FRAME DocsRep .
     2475       DOWN stream  OutStream 1 with FRAME DocsRep.
     2476   END PROCEDURE.
     2477   PROCEDURE Break-F-1 :
     2478    run u-line.
     2479    Assign
     2480      fact-date = date('')
     2481      doc-code  = ''
     2482      cli-name  = "ИТОГО " +  tdedt.name .
     2483      run break-1str.
     2484      if costsum then run break-cost.
     2485    run break-2str.
     2486    if dispupfact then run break-disp .
     2487    run u-line.
     2488    run erase-var1.
     2489    run erase-var.
     2490   END PROCEDURE.
     2491   PROCEDURE Break-1str :
     2492   Display stream OutStream
     2493       sym1
     2494       fact-date format "99/99/9999" @ f-fact-date
     2495       sym2
     2496       doc-code @ f-doc-code
     2497       sym3
     2498       cli-name @ f-cli-name
     2499       sym4
     2500       qnty format "->>>>>>>9.999"   @ F-qnty
     2501        sym5
     2502        sym6
     2503        sym7
     2504        sym8
     2505        sym9
     2506        sym10
     2507        sym11
     2508        sym12
     2509        sym13
     2510        sym14
     2511           with FRAME DocsRep .
     2512           DOWN stream  OutStream 1 with FRAME DocsRep.
     2513   END PROCEDURE.
     2514   PROCEDURE Break-ot :
     2515   if NOT (NOT NullPer And sale-sum-ot = 0 And VAT-Sum = 0 and VAT-Sum-coast = 0) THEN DO:
     2516   Display stream OutStream
     2517       sym1
     2518       fact-date format "99/99/9999" @ f-fact-date
     2519       sym2
     2520       doc-code @ f-doc-code
     2521       sym3
     2522       cli-name @ f-cli-name
     2523       sym4
     2524       qnty format "->>>>>>>9.999"   @ F-qnty
     2525       sym5
     2526       sym6
     2527       sym7
     2528       sym8
     2529       sym9
     2530       sale-sum-ot @ F-sale-sum
     2531       sym10
     2532       sym11
     2533       sym12
     2534       sym13
     2535       sym14
     2536           with FRAME DocsRep .
     2537           DOWN stream  OutStream 1 with FRAME DocsRep.
     2538    End .
     2539   END PROCEDURE.
     2540   PROCEDURE Break-2str :
     2541     define variable str-inv  as character initial "" no-undo .
     2542     define variable str-inv1 as character initial "" no-undo .
     2543     define buffer buf_doc-attr for ub.doc-attr.
     2544     str-inv1 = "".
     2545     If Available ub.trn-doc then do:
     2546       if not(cli-name begins "ИТОГО") then do:
     2547         find first buf_doc-attr no-lock
     2548           where buf_doc-attr.doc-code  = ub.trn-doc.doc-code
     2549             and buf_doc-attr.attr-code = 'nids':U
     2550         no-error .
     2551         if avail buf_doc-attr then assign  str-inv1 = buf_doc-attr.attr-value .
     2552         find first buf_doc-attr no-lock
     2553           where buf_doc-attr.doc-code  = ub.trn-doc.doc-code
     2554             and buf_doc-attr.attr-code = 'dids':U
     2555         no-error .
     2556         if avail buf_doc-attr then assign  str-inv1 =  str-inv1  +  ( if  buf_doc-attr.attr-value <> ? and buf_doc-attr.attr-value <> ""  then (  " от " + buf_doc-attr.attr-value ) else " " ).
     2557         if trim(str-inv1) <> "" then assign str-inv = "Основ. " .
     2558       end.
     2559     end.
     2560     Display stream OutStream
     2561       sym1
     2562       sym2    str-inv                           @ f-doc-code
     2563       sym3    str-inv1                          @ f-cli-name
     2564       sym4    "По документу"                    @ f-qnty
     2565       sym5    SumWithNDS                        @ F-SumWithNDS
     2566       sym6    SumWithoutNDS                     @ f-SumWithoutNDS
     2567       sym7    discnt-sum                        @ f-discnt-sum
     2568       sym8    ov-sum  when ( NO-PRISE = true )  @ f-ov-sum
     2569       sym9    sale-sum                          @ f-sale-sum
     2570       sym10   "итого"                           @ f-VAT_PC
     2571       sym11   VAT-Sum                           @ f-vat-sum
     2572       sym12
     2573       sym13   SLT-sum                           @ f-slt-sum
     2574       sym14
     2575     with FRAME DocsRep .
     2576     DOWN stream  OutStream 1 with FRAME DocsRep.
     2577     str-inv1 = "" .
     2578     If Available ub.trn-doc then do:
     2579       if not(cli-name begins "ИТОГО") then do:
     2580         find first buf_doc-attr no-lock
     2581           where buf_doc-attr.doc-code  = ub.trn-doc.doc-code
     2582             and buf_doc-attr.attr-code = 'ndog':U
     2583         no-error .
     2584         if avail buf_doc-attr then assign  str-inv1 = buf_doc-attr.attr-value .
     2585         find first buf_doc-attr no-lock
     2586           where buf_doc-attr.doc-code  = ub.trn-doc.doc-code
     2587             and buf_doc-attr.attr-code = 'ddog':U
     2588         no-error .
     2589         if avail buf_doc-attr then assign  str-inv1 =  str-inv1  +  ( if  buf_doc-attr.attr-value <> ? and buf_doc-attr.attr-value <> ""  then (  " от " + buf_doc-attr.attr-value ) else " " ).
     2590             if trim(str-inv1) <> "" then assign str-inv = "Договор " .
     2591       end.
     2592     end.
     2593     if trim(str-inv1) <> "" then do:
     2594         display stream outstream
     2595           sym1
     2596           sym2    str-inv                           @ f-doc-code
     2597           sym3    str-inv1                          @ f-cli-name
     2598           sym4
     2599           sym5
     2600           sym6
     2601           sym7
     2602           sym8
     2603           sym9
     2604           sym10
     2605           sym11
     2606           sym12
     2607           sym13
     2608           sym14
     2609         with frame docsrep .
     2610         down stream  outstream 1 with frame docsrep.
     2611     end.
     2612   END PROCEDURE.
     2613   PROCEDURE Break-cost :
     2614   Display stream OutStream
     2615       sym1
     2616       sym2
     2617       sym3
     2618       sym4
     2619       "Учет" @ F-qnty
     2620       sym5
     2621       SumWithNDS-coast    @  f-SumWithNDS
     2622       sym6
     2623       SumWithoutNDS-coast @ F-SumWithoutNDS
     2624       sym7
     2625       sym8
     2626       sym9
     2627       sym10
     2628       "итого"            @ f-vat_PC
     2629       sym11
     2630       VAT-Sum-coast      @ f-VAT-Sum
     2631       sym12
     2632       space(6)
     2633       sym13
     2634       SLT-sum-coast      @ f-slt-sum
     2635       sym14
     2636       with FRAME DocsRep .
     2637       DOWN stream  OutStream 1 with FRAME DocsRep.
     2638   END PROCEDURE.
     2639   PROCEDURE Break-Akt :
     2640    tmpact = ABSOLUTE (If Available  ub.trn-doc then ub.trn-doc.doc-qnty else 0 )
     2641            - ABSOLUTE (If Available ub.trn-doc then  ub.trn-doc.fact-qnty else 0).
     2642   Display stream OutStream
     2643       sym1
     2644       sym2
     2645       sym3
     2646       "Акт несоответствия" @ f-cli-name
     2647       sym4
     2648       tmpact @ f-qnty
     2649       sym5
     2650       sym6
     2651       sym7
     2652       sym8
     2653       sym9
     2654       sym10
     2655       sym11
     2656       sym12
     2657       sym13
     2658       sym14
     2659           with FRAME DocsRep .
     2660           DOWN stream  OutStream 1 with FRAME DocsRep.
     2661   END PROCEDURE.
     2662   PROCEDURE Break-disp :
     2663     Assign
     2664     SumWithNDS-disp     = sale-sum - SumWithoutNDS-coast
     2665     SumWithoutNDS-disp  = SumWithNDS - VAT-Sum - SLT-Sum - SumWithoutNDS-coast.
     2666   Display stream OutStream
     2667       sym1
     2668       sym2
     2669       sym3
     2670       sym4
     2671       "Наценка" @ f-qnty
     2672       sym5
     2673       SumWithNDS-disp   @ f-SumWithNDS
     2674       sym6
     2675       SumWithoutNDS-disp @ f-SumWithoutNDS
     2676       sym7
     2677       sym8
     2678       sym9
     2679       sym10
     2680       sym11
     2681       sym12
     2682       sym13
     2683       sym14
     2684           with FRAME DocsRep .
     2685           DOWN stream  OutStream 1 with FRAME DocsRep.
     2686   END PROCEDURE.
     2687   PROCEDURE Erase-var :
     2688     Assign
     2689        qnty                  = 0
     2690        SumWithNDS            = 0
     2691        SumWithoutNDS         = 0
     2692        discnt-sum            = 0
     2693        ov-sum                = 0
     2694        sale-sum              = 0
     2695        sale-sum-ot           = 0
     2696        VAT_pc                = 0
     2697        VAT-Sum               = 0
     2698        SLT_pc                = 0
     2699        SLT-sum               = 0
     2700        SumWithNDS-coast      = 0
     2701        SumWithoutNDS-coast   = 0
     2702        VAT-Sum-coast         = 0
     2703        SLT-sum-coast         = 0
     2704        SumWithNDS-disp       = 0
     2705        SumWithoutNDS-disp    = 0
     2706         .
     2707   END PROCEDURE.
     2708   PROCEDURE pre-foreach :
     2709     if can-find (first tdedt where tdedt.id = 'rs':U) AND
     2710        can-find (first tdedt where tdedt.id = 'es':U)  Then  DO:
     2711        Find  First tdedt where tdedt.id = 'rs':U no-error.
     2712        delete tdedt no-error.
     2713        Find  First tdedt where tdedt.id = 'es':U no-error.
     2714        delete tdedt no-error.
     2715        create tdedt.
     2716        Assign  tdedt.id   = 'rs':U + ',' + 'es':U
     2717                tdedt.name = 'касса' .
     2718     End.
     2719    find-str = 'cgsr':U + ',' + 'sasr':U + ',' +
     2720          if CostSum Then
     2721                'cssr':U + ','
     2722                Else "".
     2723    temp-find-str = find-str.
     2724   END PROCEDURE.
     2725   PROCEDURE erase-var1 :
     2726     acc-i=0.
     2727     acc-J=0.
     2728     For each acc#taxSLT : delete acc#taxSLT . End.
     2729     For each acc#taxVAt : delete acc#taxVAT . End.
     2730   END PROCEDURE.
     2731   procedure runkassa :
     2732     find-str = temp-find-str.
     2733       for each obj-list ,
     2734          each ub.ot-tot where
     2735                  ub.ot-tot.obj-type = obj-list.obj-type
     2736             and  ub.ot-tot.obj-code = obj-list.obj-code
     2737             and  ub.ot-tot.fact-order >  fact-order-1
     2738             and  ub.ot-tot.fact-order <= fact-order-2
     2739             and  lookup (ub.ot-tot.sum-type  , find-str ) <> 0
     2740             and  (ub.ot-tot.ext-doc-type = 'rs':U
     2741             or    ub.ot-tot.ext-doc-type = 'es':U) no-lock,
     2742                   first tdedt where tdedt.id  = 'rs':U + ',' + 'es':U  no-lock
     2743                               break by tdedt.id
     2744                                     by ub.ot-tot.fact-order
     2745                                     by ub.ot-tot.doc-code
     2746                                     :
     2747   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2748     ii = ii + 1.
     2749   IF ( ii modulo v-account = 0 )  then DO:
     2750             if  log-manager:logfile-name ne ?
     2751             then DO:
     2752                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     2753             end.
     2754              if mFrameView
     2755              then do:
     2756               DISPLAY
     2757                 ii @ RecordsDone
     2758                 WITH FRAME InfoFrame.
     2759              end.
     2760   End.
     2761      if v-button-stop then  DO:
     2762            if mFrameView
     2763            then
     2764               PROCESS EVENTS.
     2765            IF StopProcessing THEN DO:
     2766            RETURN error.
     2767            End.
     2768      end.
     2769     Find ub.trn-doc where ub.trn-doc.doc-code = ub.ot-tot.doc-code no-lock no-error.
     2770     if avail ub.trn-doc then do:
     2771                       Assign
     2772                         fact-date      = ub.trn-doc.fact-date
     2773                         doc-code       = ub.ot-tot.doc-code
     2774                         cli-name       = ub.trn-doc.cli-name
     2775                         .
     2776                       end.
     2777    else do:
     2778    Assign
     2779         fact-date      = ?
     2780         doc-code       = ub.ot-tot.doc-code
     2781         cli-name       = ""
     2782         qnty           = 0
     2783         .
     2784         end.
     2785         IF ub.ot-tot.sum-type = 'cgsr':U  THEN DO:
     2786                 If  ub.ot-tot.ext-doc-type = 'ot':U then DO:
     2787                     Find Last ub.price-doc where ub.price-doc.doc-num = ub.ot-tot.doc-code no-lock no-error.
     2788                     Assign
     2789                       fact-date      = If ub.ot-tot.ext-doc-type <> 'ot':U then  ub.trn-doc.fact-date Else (If Available ub.price-doc THEN ub.price-doc.fact-date ELSE date(''))
     2790                       doc-code       = ub.ot-tot.doc-code
     2791                       cli-name       = If ub.ot-tot.ext-doc-type <> 'ot':U then ub.trn-doc.cli-name Else ""
     2792                       qnty           = ub.ot-tot.fact-qnty
     2793                       Sale-sum-ot   = if tPrintRubl then ub.ot-tot.sum-rubl else ub.ot-tot.sum-base.
     2794                       Accumulate Sale-sum-ot (TOTAL) .
     2795                 End.
     2796               if  ub.ot-tot.ext-doc-type = 'vt':U then do :
     2797                 Find Last ub.trn-doc where ub.trn-doc.doc-code = ub.ot-tot.doc-code no-lock no-error.
     2798                 if avail ub.trn-doc then
     2799                                 Assign
     2800                                     fact-date      = ub.trn-doc.fact-date
     2801                                     doc-code       = ub.ot-tot.doc-code
     2802                                     cli-name       = ub.trn-doc.cli-name
     2803                                     qnty           = ub.ot-tot.fact-qnty
     2804                                     .
     2805                   if not can-find
     2806                   (first cost-ot-tot-inv where
     2807                          cost-ot-tot-inv.doc-code = ub.ot-tot.doc-code and
     2808                          cost-ot-tot-inv.sum-type = 'cssr':U no-lock )
     2809                           Then
     2810                           Assign
     2811                             SumWithNDS-coast    = 0
     2812                             VAT-Sum-coast       = 0
     2813                             SLT-sum-coast       = 0
     2814                             SumWithoutNDS-coast = 0
     2815                           .
     2816                   if not can-find
     2817                   (first sale-ot-tot-inv where
     2818                          sale-ot-tot-inv.doc-code = ub.ot-tot.doc-code and
     2819                          sale-ot-tot-inv.sum-type = 'sasr':U no-lock )
     2820                           Then
     2821                           Assign
     2822                             discnt-sum   =      0
     2823                             ov-sum       =      0
     2824                             VAT-Sum      =      0
     2825                             SLT-sum      =      0
     2826                             SumWithoutNDS =     0
     2827                             SumWithNDS    =     0
     2828                             .
     2829               End.
     2830         End.
     2831         IF ub.ot-tot.sum-type = 'sasr':U  THEN DO:
     2832             Find Last ub.trn-doc where ub.trn-doc.doc-code = ub.ot-tot.doc-code no-lock no-error.
     2833                 If  ub.ot-tot.ext-doc-type = 'ot':U then
     2834                     Find Last ub.price-doc where ub.price-doc.doc-num = ub.ot-tot.doc-code no-lock no-error.
     2835             Assign
     2836             fact-date      = If ub.ot-tot.ext-doc-type <> 'ot':U then  ub.trn-doc.fact-date Else (If Available ub.price-doc then ub.price-doc.fact-date ELSE date(''))
     2837             doc-code       = ub.ot-tot.doc-code
     2838             cli-name       = If ub.ot-tot.ext-doc-type <> 'ot':U then ub.trn-doc.cli-name Else " "
     2839             qnty           = ub.ot-tot.fact-qnty
     2840             SumWithNDS     = if tPrintRubl then ub.ot-tot.sum-rubl else ub.ot-tot.sum-base.
     2841             iF SumWithNDS = ? tHEN SumWithNDS = 0.
     2842             If not Available ub.trn-doc Then
     2843                Assign    discnt-sum     = 0
     2844                          ov-sum         = 0.
     2845             discnt-sum     = if tPrintRubl then ub.ot-tot.other-rubl
     2846                                            else ub.ot-tot.other-base .
     2847              iF discnt-sum = ? tHEN discnt-sum = 0.
     2848              if ub.ot-tot.ext-doc-type = 'vt':U THEN discnt-sum = 0.
     2849             Assign
     2850             VAT_pc         = 0
     2851             VAT-Sum        = if tPrintRubl then ub.ot-tot.VAT-rubl else ub.ot-tot.VAT-base
     2852             SLT_pc         = 0
     2853             SLT-sum        = if tPrintRubl then ub.ot-tot.SLT-rubl else ub.ot-tot.SLT-base.
     2854             iF VAT-Sum = ? tHEN VAT-Sum = 0.
     2855             iF SLT-sum = ? tHEN slt-Sum = 0.
     2856             SumWithoutNDS  = SumWithNDS - VAT-Sum.
     2857               FIND LAST crsa-ot-tot where
     2858                   crsa-ot-tot.doc-code = ub.ot-tot.doc-code   and
     2859                   crsa-ot-tot.sum-type = 'cgsr':U    and
     2860                   crsa-ot-tot.cat-id   = ub.ot-tot.cat-id  no-lock use-index pi.
     2861                   if available crsa-ot-tot then
     2862                   sale-sum       = if tPrintRubl then crsa-ot-tot.sum-rubl else crsa-ot-tot.sum-base .
     2863                   Else sale-sum  = 0.
     2864                   ov-sum =  sale-sum - ( SumWithNDS +  discnt-sum ).
     2865             Accumulate sale-sum     (TOTAL) .
     2866             Accumulate qnty         (TOTAL) .
     2867             Accumulate SumWithNDS   (TOTAL) .
     2868             Accumulate discnt-sum   (TOTAL) .
     2869             Accumulate ov-sum       (TOTAL) .
     2870             Accumulate VAT-Sum      (TOTAL) .
     2871             Accumulate SLT-sum      (TOTAL) .
     2872             Accumulate SumWithoutNDS  (TOTAL) .
     2873          End.
     2874         IF ub.ot-tot.sum-type = 'cssr':U  THEN DO:
     2875             Assign
     2876             SumWithNDS-coast     = if tPrintRubl then ub.ot-tot.sum-rubl else ub.ot-tot.sum-base
     2877             VAT-Sum-coast        = if tPrintRubl then ub.ot-tot.VAT-rubl else ub.ot-tot.VAT-base
     2878             SLT-sum-coast        = if tPrintRubl then ub.ot-tot.SLT-rubl else ub.ot-tot.SLT-base
     2879             SumWithoutNDS-coast  = SumWithNDS-coast - VAT-Sum-coast.
     2880             if fact-date = date('') and ub.ot-tot.ext-doc-type <> 'ot':U then do:
     2881                 Find Last ub.trn-doc where ub.trn-doc.doc-code = ub.ot-tot.doc-code no-lock no-error.
     2882                 if avail ub.trn-doc then
     2883                                       Assign
     2884                                           fact-date      = ub.trn-doc.fact-date
     2885                                           doc-code       = ub.ot-tot.doc-code
     2886                                           cli-name       = ub.trn-doc.cli-name
     2887                                           .
     2888             end.
     2889             Accumulate SumWithNDS-coast          (TOTAL) .
     2890             Accumulate VAT-Sum-coast             (TOTAL) .
     2891             Accumulate SLT-sum-coast             (TOTAL) .
     2892             Accumulate SumWithoutNDS-coast       (TOTAL) .
     2893          End.
     2894        IF ub.ot-tot.sum-type BEGINS 'cssr':U and ub.ot-tot.sum-type <> 'cssr':U Then DO:
     2895               IF CostSum Then DO:
     2896                 IF entry (2 , ub.ot-tot.cat-id) = '##':U Then DO:
     2897   create tmp#taxVAT.
     2898   assign tmp#taxVAT.type    = ot-tot.sum-type
     2899         tmp#taxVAT.pc      = entry (1 , ot-tot.cat-id)
     2900         tmp#taxVAT.sum     = if tprintrubl then ot-tot.VAT-rubl else ot-tot.VAT-base
     2901         tmp#taxVAT.sum_full     = if tprintrubl then ot-tot.sum-rubl else ot-tot.sum-base
     2902         .
     2903   i = i + 1.
     2904   find first acc#taxVAT where acc#taxVAT.pc   = tmp#taxVAT.pc
     2905                           and acc#taxVAT.type = tmp#taxVAT.type
     2906                           no-error.
     2907   if available acc#taxVAT then
     2908     assign  acc#taxVAT.sum     = acc#taxVAT.sum + (if tprintrubl then ot-tot.VAT-rubl else ot-tot.VAT-base).
     2909     else do:
     2910         create acc#taxVAT.
     2911         assign acc#taxVAT.type    = ot-tot.sum-type
     2912                 acc#taxVAT.pc      = entry (1 , ot-tot.cat-id)
     2913                 acc#taxVAT.sum     = if tprintrubl then ot-tot.VAT-rubl else ot-tot.VAT-base
     2914                 acc#taxVAT.sum_full = if tprintrubl then ot-tot.sum-rubl else ot-tot.sum-base.
     2915             acc-i = acc-i + 1.
     2916     end.
     2917      End.
     2918                    Else DO:
     2919   create tmp#taxslt.
     2920   assign tmp#taxslt.type    = ot-tot.sum-type
     2921         tmp#taxslt.pc      = entry (2 , ot-tot.cat-id)
     2922         tmp#taxslt.sum     = if tprintrubl then ot-tot.slt-rubl else ot-tot.slt-base
     2923         tmp#taxslt.sum_full     = if tprintrubl then ot-tot.sum-rubl else ot-tot.sum-base
     2924         .
     2925   j = j + 1.
     2926   find first acc#taxslt where acc#taxslt.pc   = tmp#taxslt.pc
     2927                           and acc#taxslt.type = tmp#taxslt.type
     2928                           no-error.
     2929   if available acc#taxslt then
     2930     assign  acc#taxslt.sum     = acc#taxslt.sum + (if tprintrubl then ot-tot.slt-rubl else ot-tot.slt-base).
     2931     else do:
     2932         create acc#taxslt.
     2933         assign acc#taxslt.type    = ot-tot.sum-type
     2934                 acc#taxslt.pc      = entry (2 , ot-tot.cat-id)
     2935                 acc#taxslt.sum     = if tprintrubl then ot-tot.slt-rubl else ot-tot.slt-base
     2936                 acc#taxslt.sum_full = if tprintrubl then ot-tot.sum-rubl else ot-tot.sum-base.
     2937             acc-j = acc-j + 1.
     2938     end.
     2939     End.
     2940                 End.
     2941             End.
     2942        IF ub.ot-tot.sum-type BEGINS 'sasr':U and ub.ot-tot.sum-type <> 'sasr':U Then DO:
     2943                 IF entry (2 , ub.ot-tot.cat-id) = '##':U Then DO:
     2944   create tmp#taxVAT.
     2945   assign tmp#taxVAT.type    = ot-tot.sum-type
     2946         tmp#taxVAT.pc      = entry (1 , ot-tot.cat-id)
     2947         tmp#taxVAT.sum     = if tprintrubl then ot-tot.VAT-rubl else ot-tot.VAT-base
     2948         tmp#taxVAT.sum_full     = if tprintrubl then ot-tot.sum-rubl else ot-tot.sum-base
     2949         .
     2950   i = i + 1.
     2951   find first acc#taxVAT where acc#taxVAT.pc   = tmp#taxVAT.pc
     2952                           and acc#taxVAT.type = tmp#taxVAT.type
     2953                           no-error.
     2954   if available acc#taxVAT then
     2955     assign  acc#taxVAT.sum     = acc#taxVAT.sum + (if tprintrubl then ot-tot.VAT-rubl else ot-tot.VAT-base).
     2956     else do:
     2957         create acc#taxVAT.
     2958         assign acc#taxVAT.type    = ot-tot.sum-type
     2959                 acc#taxVAT.pc      = entry (1 , ot-tot.cat-id)
     2960                 acc#taxVAT.sum     = if tprintrubl then ot-tot.VAT-rubl else ot-tot.VAT-base
     2961                 acc#taxVAT.sum_full = if tprintrubl then ot-tot.sum-rubl else ot-tot.sum-base.
     2962             acc-i = acc-i + 1.
     2963     end.
     2964      End.
     2965                    Else DO:
     2966   create tmp#taxslt.
     2967   assign tmp#taxslt.type    = ot-tot.sum-type
     2968         tmp#taxslt.pc      = entry (2 , ot-tot.cat-id)
     2969         tmp#taxslt.sum     = if tprintrubl then ot-tot.slt-rubl else ot-tot.slt-base
     2970         tmp#taxslt.sum_full     = if tprintrubl then ot-tot.sum-rubl else ot-tot.sum-base
     2971         .
     2972   j = j + 1.
     2973   find first acc#taxslt where acc#taxslt.pc   = tmp#taxslt.pc
     2974                           and acc#taxslt.type = tmp#taxslt.type
     2975                           no-error.
     2976   if available acc#taxslt then
     2977     assign  acc#taxslt.sum     = acc#taxslt.sum + (if tprintrubl then ot-tot.slt-rubl else ot-tot.slt-base).
     2978     else do:
     2979         create acc#taxslt.
     2980         assign acc#taxslt.type    = ot-tot.sum-type
     2981                 acc#taxslt.pc      = entry (2 , ot-tot.cat-id)
     2982                 acc#taxslt.sum     = if tprintrubl then ot-tot.slt-rubl else ot-tot.slt-base
     2983                 acc#taxslt.sum_full = if tprintrubl then ot-tot.sum-rubl else ot-tot.sum-base.
     2984             acc-j = acc-j + 1.
     2985     end.
     2986     End.
     2987        End.
     2988         IF ub.ot-tot.sum-type BEGINS 'cgsr':U and ub.ot-tot.sum-type <> 'cgsr':U Then DO:
     2989                   IF entry (2 , ub.ot-tot.cat-id) = '##':U Then DO:
     2990   create tmp#taxVAT.
     2991   assign tmp#taxVAT.type    = ot-tot.sum-type
     2992         tmp#taxVAT.pc      = entry (1 , ot-tot.cat-id)
     2993         tmp#taxVAT.sum     = if tprintrubl then ot-tot.VAT-rubl else ot-tot.VAT-base
     2994         tmp#taxVAT.sum_full     = if tprintrubl then ot-tot.sum-rubl else ot-tot.sum-base
     2995         .
     2996   i = i + 1.
     2997   find first acc#taxVAT where acc#taxVAT.pc   = tmp#taxVAT.pc
     2998                           and acc#taxVAT.type = tmp#taxVAT.type
     2999                           no-error.
     3000   if available acc#taxVAT then
     3001     assign  acc#taxVAT.sum     = acc#taxVAT.sum + (if tprintrubl then ot-tot.VAT-rubl else ot-tot.VAT-base).
     3002     else do:
     3003         create acc#taxVAT.
     3004         assign acc#taxVAT.type    = ot-tot.sum-type
     3005                 acc#taxVAT.pc      = entry (1 , ot-tot.cat-id)
     3006                 acc#taxVAT.sum     = if tprintrubl then ot-tot.VAT-rubl else ot-tot.VAT-base
     3007                 acc#taxVAT.sum_full = if tprintrubl then ot-tot.sum-rubl else ot-tot.sum-base.
     3008             acc-i = acc-i + 1.
     3009     end.
     3010      End.
     3011                     Else DO:
     3012   create tmp#taxslt.
     3013   assign tmp#taxslt.type    = ot-tot.sum-type
     3014         tmp#taxslt.pc      = entry (2 , ot-tot.cat-id)
     3015         tmp#taxslt.sum     = if tprintrubl then ot-tot.slt-rubl else ot-tot.slt-base
     3016         tmp#taxslt.sum_full     = if tprintrubl then ot-tot.sum-rubl else ot-tot.sum-base
     3017         .
     3018   j = j + 1.
     3019   find first acc#taxslt where acc#taxslt.pc   = tmp#taxslt.pc
     3020                           and acc#taxslt.type = tmp#taxslt.type
     3021                           no-error.
     3022   if available acc#taxslt then
     3023     assign  acc#taxslt.sum     = acc#taxslt.sum + (if tprintrubl then ot-tot.slt-rubl else ot-tot.slt-base).
     3024     else do:
     3025         create acc#taxslt.
     3026         assign acc#taxslt.type    = ot-tot.sum-type
     3027                 acc#taxslt.pc      = entry (2 , ot-tot.cat-id)
     3028                 acc#taxslt.sum     = if tprintrubl then ot-tot.slt-rubl else ot-tot.slt-base
     3029                 acc#taxslt.sum_full = if tprintrubl then ot-tot.sum-rubl else ot-tot.sum-base.
     3030             acc-j = acc-j + 1.
     3031     end.
     3032     End.
     3033         End.
     3034             if first-of ( tdedt.id ) then  run break-h-1.
     3035             if last-of ( ub.ot-tot.doc-code ) then do:
     3036                 if (ub.ot-tot.sum-type     =  'cgsr':U  and
     3037                    not (ub.ot-tot.ext-doc-type = 'vt':U ))
     3038                    then do:
     3039                       run break-ot.
     3040                       if ub.ot-tot.ext-doc-type = 'ap':U and costsum then run break-cost.
     3041                    end.
     3042                    else do:
     3043                       run break-1str.
     3044                       if available ub.trn-doc then do:
     3045                         if (absolute(ub.trn-doc.fact-qnty) - absolute(ub.trn-doc.doc-qnty) <> 0)
     3046                             and ub.ot-tot.ext-doc-type <> 'vt':U
     3047                             then run break-akt.
     3048                         end.
     3049                       if costsum then run break-cost.
     3050                       run break-2str.
     3051                       if dispupfact then run break-disp .
     3052                    end.
     3053                run erase-var.
     3054             end.
     3055             if last-of ( tdedt.id ) then do:
     3056                 qnty               = accum total       qnty                       .
     3057                 sumwithnds         = accum total       sumwithnds                 .
     3058                 discnt-sum         = accum total       discnt-sum                 .
     3059                 ov-sum             = accum total       ov-sum                     .
     3060                 vat-sum            = accum total       vat-sum                    .
     3061                 slt-sum            = accum total       slt-sum                    .
     3062                 sumwithoutnds      = accum total       sumwithoutnds              .
     3063                 sumwithnds-coast   = accum total       sumwithnds-coast           .
     3064                 vat-sum-coast      = accum total       vat-sum-coast              .
     3065                 slt-sum-coast      = accum total       slt-sum-coast              .
     3066                 sumwithoutnds-coast= accum total       sumwithoutnds-coast        .
     3067                 sale-sum-ot        = accum total       sale-sum-ot                .
     3068                 sale-sum           = (accum total       sale-sum   )  + sale-sum-ot  .
     3069   for each tmp#taxvat : delete tmp#taxvat. end.
     3070   for each acc#taxvat :
     3071     create tmp#taxvat.
     3072     assign tmp#taxvat.type   = acc#taxvat.type
     3073           tmp#taxvat.pc      = acc#taxvat.pc
     3074           tmp#taxvat.sum     = acc#taxvat.sum.
     3075   end.
     3076   i = acc-i.
     3077   for each tmp#taxslt : delete tmp#taxslt. end.
     3078   for each acc#taxslt :
     3079     create tmp#taxslt.
     3080     assign tmp#taxslt.type   = acc#taxslt.type
     3081           tmp#taxslt.pc      = acc#taxslt.pc
     3082           tmp#taxslt.sum     = acc#taxslt.sum.
     3083   end.
     3084   j = acc-j.
     3085             assign
     3086                   quantity3  = quantity3   + qnty
     3087                   coast5     = coast5      + sumwithnds-coast
     3088                   coast6     = coast6      + sale-sum
     3089                   .
     3090                run break-f-1.
     3091                End.
     3092         end.
     3093   end procedure.
     3094   PROCEDURE on-same-page :
     3095     define input parameter p-line-number as integer  no-undo .
     3096     if p-line-number > page-size( OutStream ) then do:
     3097       return .
     3098     end.
     3099     if line-counter( OutStream ) + p-line-number > page-size( OutStream ) then do:
     3100       page stream OutStream .
     3101     end.
     3102   end procedure.
     3103   procedure pre-foreach-intmove :
     3104     do
     3105     on error undo, return error return-value
     3106     :
     3107   define buffer pri_trn-doc  for ub.trn-doc.
     3108   define buffer Vz_trn-doc   for ub.trn-doc.
     3109   define buffer buf_ot-tot   for ub.ot-tot.
     3110   define buffer buf_obj-list for obj-list.
     3111   define variable v-nn as integer   no-undo .
     3112   v-nn = 0.
     3113     if not ( can-find (first tdedt where tdedt.id = 'iv':U )  and
     3114              can-find (first tdedt where tdedt.id = 'ev':U ) and
     3115              can-find (first tdedt where tdedt.id = 'rv':U) ) then return.
     3116         for each obj-list ,
     3117             each  buf_ot-tot no-lock where
     3118                   buf_ot-tot.obj-type      = obj-list.obj-type
     3119               and buf_ot-tot.obj-code      = obj-list.obj-code
     3120               and buf_ot-tot.ext-doc-type  = 'ev':U
     3121               and buf_ot-tot.fact-order   >  fact-order-1
     3122               and buf_ot-tot.fact-order   <= fact-order-2
     3123               and buf_ot-tot.sum-type      = 'cgsr':U
     3124               :
     3125                   find first  Pri_trn-doc no-lock where
     3126                               Pri_trn-doc.ext-doc-type =  'iv':U
     3127                           and Pri_trn-doc.out-code     = buf_ot-tot.doc-code
     3128                           and Pri_trn-doc.status_      = 'факт':U
     3129                           and Pri_trn-doc.fact-order   >  fact-order-1
     3130                           and Pri_trn-doc.fact-order   <= fact-order-2 no-error .
     3131                           if available   Pri_trn-doc  and
     3132                              can-find (first buf_obj-list where
     3133                              Pri_trn-doc.fact-qnty <> 0 and
     3134                              Pri_trn-doc.obj-type      = buf_obj-list.obj-type and
     3135                              Pri_trn-doc.obj-code      = buf_obj-list.obj-code   ) then do:
     3136                              v-nn = v-nn + 1.
     3137                              create tmp-doc.
     3138                              assign
     3139                                 tmp-doc.doc-code =  buf_ot-tot.doc-code
     3140                                 tmp-doc.ext-doc-type =  'ev':U
     3141                                 tmp-doc.nn = v-nn
     3142                              .
     3143                              create tmp-doc.
     3144                              assign
     3145                                 tmp-doc.doc-code =  Pri_trn-doc.doc-code
     3146                                 tmp-doc.ext-doc-type =  'iv':U
     3147                                 tmp-doc.nn = v-nn
     3148                              .
     3149                               find first  Vz_trn-doc no-lock where
     3150                                           Vz_trn-doc.ext-doc-type =  'rv':U
     3151                                       and Vz_trn-doc.out-code     = Pri_trn-doc.doc-code
     3152                                       and Vz_trn-doc.status_      = 'факт':U
     3153                                       and Vz_trn-doc.fact-order   >  fact-order-1
     3154                                       and Vz_trn-doc.fact-order   <= fact-order-2 no-error .
     3155                                       if available   vz_trn-doc then do:
     3156                                           create tmp-doc.
     3157                                           assign
     3158                                               tmp-doc.doc-code =  vz_trn-doc.doc-code
     3159                                               tmp-doc.ext-doc-type =  'rv':U
     3160                                               tmp-doc.nn = v-nn
     3161                                           .
     3162                                       end.
     3163                           end.
     3164         end.
     3165     end.
     3166   end procedure.
     3167   procedure run-intmove :
     3168     do
     3169     on error undo, return error return-value
     3170     :
     3171     create tdedt.
     3172     assign
     3173       tdedt.name = "ВНУТРЕННЕЕ ПЕРЕМЕЩЕНИЕ"
     3174       tdedt.id =    'iv':U + "," +
     3175                     'ev':U   + "," +
     3176                     'rv':U
     3177     .
     3178          for each  tmp-doc ,
     3179           each ub.ot-tot no-lock where
     3180                ub.ot-tot.doc-code = tmp-doc.doc-code and
     3181                lookup ( ub.ot-tot.sum-type  , find-str ) <> 0
     3182                break
     3183                      by tdedt.id
     3184                      by tmp-doc.nn
     3185                      by ub.ot-tot.fact-order
     3186                      by ub.ot-tot.doc-code :
     3187   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3188     ii = ii + 1.
     3189   IF ( ii modulo v-account = 0 )  then DO:
     3190             if  log-manager:logfile-name ne ?
     3191             then DO:
     3192                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     3193             end.
     3194              if mFrameView
     3195              then do:
     3196               DISPLAY
     3197                 ii @ RecordsDone
     3198                 WITH FRAME InfoFrame.
     3199              end.
     3200   End.
     3201      if v-button-stop then  DO:
     3202            if mFrameView
     3203            then
     3204               PROCESS EVENTS.
     3205            IF StopProcessing THEN DO:
     3206            RETURN error.
     3207            End.
     3208      end.
     3209     Find ub.trn-doc where ub.trn-doc.doc-code = ub.ot-tot.doc-code no-lock no-error.
     3210     if avail ub.trn-doc then do:
     3211                       Assign
     3212                         fact-date      = ub.trn-doc.fact-date
     3213                         doc-code       = ub.ot-tot.doc-code
     3214                         cli-name       = ub.trn-doc.cli-name
     3215                         .
     3216                       end.
     3217    else do:
     3218    Assign
     3219         fact-date      = ?
     3220         doc-code       = ub.ot-tot.doc-code
     3221         cli-name       = ""
     3222         qnty           = 0
     3223         .
     3224         end.
     3225         IF ub.ot-tot.sum-type = 'cgsr':U  THEN DO:
     3226                 If  ub.ot-tot.ext-doc-type = 'ot':U then DO:
     3227                     Find Last ub.price-doc where ub.price-doc.doc-num = ub.ot-tot.doc-code no-lock no-error.
     3228                     Assign
     3229                       fact-date      = If ub.ot-tot.ext-doc-type <> 'ot':U then  ub.trn-doc.fact-date Else (If Available ub.price-doc THEN ub.price-doc.fact-date ELSE date(''))
     3230                       doc-code       = ub.ot-tot.doc-code
     3231                       cli-name       = If ub.ot-tot.ext-doc-type <> 'ot':U then ub.trn-doc.cli-name Else ""
     3232                       qnty           = ub.ot-tot.fact-qnty
     3233                       Sale-sum-ot   = if tPrintRubl then ub.ot-tot.sum-rubl else ub.ot-tot.sum-base.
     3234                       Accumulate Sale-sum-ot (TOTAL) .
     3235                 End.
     3236               if  ub.ot-tot.ext-doc-type = 'vt':U then do :
     3237                 Find Last ub.trn-doc where ub.trn-doc.doc-code = ub.ot-tot.doc-code no-lock no-error.
     3238                 if avail ub.trn-doc then
     3239                                 Assign
     3240                                     fact-date      = ub.trn-doc.fact-date
     3241                                     doc-code       = ub.ot-tot.doc-code
     3242                                     cli-name       = ub.trn-doc.cli-name
     3243                                     qnty           = ub.ot-tot.fact-qnty
     3244                                     .
     3245                   if not can-find
     3246                   (first cost-ot-tot-inv where
     3247                          cost-ot-tot-inv.doc-code = ub.ot-tot.doc-code and
     3248                          cost-ot-tot-inv.sum-type = 'cssr':U no-lock )
     3249                           Then
     3250                           Assign
     3251                             SumWithNDS-coast    = 0
     3252                             VAT-Sum-coast       = 0
     3253                             SLT-sum-coast       = 0
     3254                             SumWithoutNDS-coast = 0
     3255                           .
     3256                   if not can-find
     3257                   (first sale-ot-tot-inv where
     3258                          sale-ot-tot-inv.doc-code = ub.ot-tot.doc-code and
     3259                          sale-ot-tot-inv.sum-type = 'sasr':U no-lock )
     3260                           Then
     3261                           Assign
     3262                             discnt-sum   =      0
     3263                             ov-sum       =      0
     3264                             VAT-Sum      =      0
     3265                             SLT-sum      =      0
     3266                             SumWithoutNDS =     0
     3267                             SumWithNDS    =     0
     3268                             .
     3269               End.
     3270         End.
     3271         IF ub.ot-tot.sum-type = 'sasr':U  THEN DO:
     3272             Find Last ub.trn-doc where ub.trn-doc.doc-code = ub.ot-tot.doc-code no-lock no-error.
     3273                 If  ub.ot-tot.ext-doc-type = 'ot':U then
     3274                     Find Last ub.price-doc where ub.price-doc.doc-num = ub.ot-tot.doc-code no-lock no-error.
     3275             Assign
     3276             fact-date      = If ub.ot-tot.ext-doc-type <> 'ot':U then  ub.trn-doc.fact-date Else (If Available ub.price-doc then ub.price-doc.fact-date ELSE date(''))
     3277             doc-code       = ub.ot-tot.doc-code
     3278             cli-name       = If ub.ot-tot.ext-doc-type <> 'ot':U then ub.trn-doc.cli-name Else " "
     3279             qnty           = ub.ot-tot.fact-qnty
     3280             SumWithNDS     = if tPrintRubl then ub.ot-tot.sum-rubl else ub.ot-tot.sum-base.
     3281             iF SumWithNDS = ? tHEN SumWithNDS = 0.
     3282             If not Available ub.trn-doc Then
     3283                Assign    discnt-sum     = 0
     3284                          ov-sum         = 0.
     3285             discnt-sum     = if tPrintRubl then ub.ot-tot.other-rubl
     3286                                            else ub.ot-tot.other-base .
     3287              iF discnt-sum = ? tHEN discnt-sum = 0.
     3288              if ub.ot-tot.ext-doc-type = 'vt':U THEN discnt-sum = 0.
     3289             Assign
     3290             VAT_pc         = 0
     3291             VAT-Sum        = if tPrintRubl then ub.ot-tot.VAT-rubl else ub.ot-tot.VAT-base
     3292             SLT_pc         = 0
     3293             SLT-sum        = if tPrintRubl then ub.ot-tot.SLT-rubl else ub.ot-tot.SLT-base.
     3294             iF VAT-Sum = ? tHEN VAT-Sum = 0.
     3295             iF SLT-sum = ? tHEN slt-Sum = 0.
     3296             SumWithoutNDS  = SumWithNDS - VAT-Sum.
     3297               FIND LAST crsa-ot-tot where
     3298                   crsa-ot-tot.doc-code = ub.ot-tot.doc-code   and
     3299                   crsa-ot-tot.sum-type = 'cgsr':U    and
     3300                   crsa-ot-tot.cat-id   = ub.ot-tot.cat-id  no-lock use-index pi.
     3301                   if available crsa-ot-tot then
     3302                   sale-sum       = if tPrintRubl then crsa-ot-tot.sum-rubl else crsa-ot-tot.sum-base .
     3303                   Else sale-sum  = 0.
     3304                   ov-sum =  sale-sum - ( SumWithNDS +  discnt-sum ).
     3305             Accumulate sale-sum     (TOTAL) .
     3306             Accumulate qnty         (TOTAL) .
     3307             Accumulate SumWithNDS   (TOTAL) .
     3308             Accumulate discnt-sum   (TOTAL) .
     3309             Accumulate ov-sum       (TOTAL) .
     3310             Accumulate VAT-Sum      (TOTAL) .
     3311             Accumulate SLT-sum      (TOTAL) .
     3312             Accumulate SumWithoutNDS  (TOTAL) .
     3313          End.
     3314         IF ub.ot-tot.sum-type = 'cssr':U  THEN DO:
     3315             Assign
     3316             SumWithNDS-coast     = if tPrintRubl then ub.ot-tot.sum-rubl else ub.ot-tot.sum-base
     3317             VAT-Sum-coast        = if tPrintRubl then ub.ot-tot.VAT-rubl else ub.ot-tot.VAT-base
     3318             SLT-sum-coast        = if tPrintRubl then ub.ot-tot.SLT-rubl else ub.ot-tot.SLT-base
     3319             SumWithoutNDS-coast  = SumWithNDS-coast - VAT-Sum-coast.
     3320             if fact-date = date('') and ub.ot-tot.ext-doc-type <> 'ot':U then do:
     3321                 Find Last ub.trn-doc where ub.trn-doc.doc-code = ub.ot-tot.doc-code no-lock no-error.
     3322                 if avail ub.trn-doc then
     3323                                       Assign
     3324                                           fact-date      = ub.trn-doc.fact-date
     3325                                           doc-code       = ub.ot-tot.doc-code
     3326                                           cli-name       = ub.trn-doc.cli-name
     3327                                           .
     3328             end.
     3329             Accumulate SumWithNDS-coast          (TOTAL) .
     3330             Accumulate VAT-Sum-coast             (TOTAL) .
     3331             Accumulate SLT-sum-coast             (TOTAL) .
     3332             Accumulate SumWithoutNDS-coast       (TOTAL) .
     3333          End.
     3334        IF ub.ot-tot.sum-type BEGINS 'cssr':U and ub.ot-tot.sum-type <> 'cssr':U Then DO:
     3335               IF CostSum Then DO:
     3336                 IF entry (2 , ub.ot-tot.cat-id) = '##':U Then DO:
     3337   create tmp#taxVAT.
     3338   assign tmp#taxVAT.type    = ot-tot.sum-type
     3339         tmp#taxVAT.pc      = entry (1 , ot-tot.cat-id)
     3340         tmp#taxVAT.sum     = if tprintrubl then ot-tot.VAT-rubl else ot-tot.VAT-base
     3341         tmp#taxVAT.sum_full     = if tprintrubl then ot-tot.sum-rubl else ot-tot.sum-base
     3342         .
     3343   i = i + 1.
     3344   find first acc#taxVAT where acc#taxVAT.pc   = tmp#taxVAT.pc
     3345                           and acc#taxVAT.type = tmp#taxVAT.type
     3346                           no-error.
     3347   if available acc#taxVAT then
     3348     assign  acc#taxVAT.sum     = acc#taxVAT.sum + (if tprintrubl then ot-tot.VAT-rubl else ot-tot.VAT-base).
     3349     else do:
     3350         create acc#taxVAT.
     3351         assign acc#taxVAT.type    = ot-tot.sum-type
     3352                 acc#taxVAT.pc      = entry (1 , ot-tot.cat-id)
     3353                 acc#taxVAT.sum     = if tprintrubl then ot-tot.VAT-rubl else ot-tot.VAT-base
     3354                 acc#taxVAT.sum_full = if tprintrubl then ot-tot.sum-rubl else ot-tot.sum-base.
     3355             acc-i = acc-i + 1.
     3356     end.
     3357      End.
     3358                    Else DO:
     3359   create tmp#taxslt.
     3360   assign tmp#taxslt.type    = ot-tot.sum-type
     3361         tmp#taxslt.pc      = entry (2 , ot-tot.cat-id)
     3362         tmp#taxslt.sum     = if tprintrubl then ot-tot.slt-rubl else ot-tot.slt-base
     3363         tmp#taxslt.sum_full     = if tprintrubl then ot-tot.sum-rubl else ot-tot.sum-base
     3364         .
     3365   j = j + 1.
     3366   find first acc#taxslt where acc#taxslt.pc   = tmp#taxslt.pc
     3367                           and acc#taxslt.type = tmp#taxslt.type
     3368                           no-error.
     3369   if available acc#taxslt then
     3370     assign  acc#taxslt.sum     = acc#taxslt.sum + (if tprintrubl then ot-tot.slt-rubl else ot-tot.slt-base).
     3371     else do:
     3372         create acc#taxslt.
     3373         assign acc#taxslt.type    = ot-tot.sum-type
     3374                 acc#taxslt.pc      = entry (2 , ot-tot.cat-id)
     3375                 acc#taxslt.sum     = if tprintrubl then ot-tot.slt-rubl else ot-tot.slt-base
     3376                 acc#taxslt.sum_full = if tprintrubl then ot-tot.sum-rubl else ot-tot.sum-base.
     3377             acc-j = acc-j + 1.
     3378     end.
     3379     End.
     3380                 End.
     3381             End.
     3382        IF ub.ot-tot.sum-type BEGINS 'sasr':U and ub.ot-tot.sum-type <> 'sasr':U Then DO:
     3383                 IF entry (2 , ub.ot-tot.cat-id) = '##':U Then DO:
     3384   create tmp#taxVAT.
     3385   assign tmp#taxVAT.type    = ot-tot.sum-type
     3386         tmp#taxVAT.pc      = entry (1 , ot-tot.cat-id)
     3387         tmp#taxVAT.sum     = if tprintrubl then ot-tot.VAT-rubl else ot-tot.VAT-base
     3388         tmp#taxVAT.sum_full     = if tprintrubl then ot-tot.sum-rubl else ot-tot.sum-base
     3389         .
     3390   i = i + 1.
     3391   find first acc#taxVAT where acc#taxVAT.pc   = tmp#taxVAT.pc
     3392                           and acc#taxVAT.type = tmp#taxVAT.type
     3393                           no-error.
     3394   if available acc#taxVAT then
     3395     assign  acc#taxVAT.sum     = acc#taxVAT.sum + (if tprintrubl then ot-tot.VAT-rubl else ot-tot.VAT-base).
     3396     else do:
     3397         create acc#taxVAT.
     3398         assign acc#taxVAT.type    = ot-tot.sum-type
     3399                 acc#taxVAT.pc      = entry (1 , ot-tot.cat-id)
     3400                 acc#taxVAT.sum     = if tprintrubl then ot-tot.VAT-rubl else ot-tot.VAT-base
     3401                 acc#taxVAT.sum_full = if tprintrubl then ot-tot.sum-rubl else ot-tot.sum-base.
     3402             acc-i = acc-i + 1.
     3403     end.
     3404      End.
     3405                    Else DO:
     3406   create tmp#taxslt.
     3407   assign tmp#taxslt.type    = ot-tot.sum-type
     3408         tmp#taxslt.pc      = entry (2 , ot-tot.cat-id)
     3409         tmp#taxslt.sum     = if tprintrubl then ot-tot.slt-rubl else ot-tot.slt-base
     3410         tmp#taxslt.sum_full     = if tprintrubl then ot-tot.sum-rubl else ot-tot.sum-base
     3411         .
     3412   j = j + 1.
     3413   find first acc#taxslt where acc#taxslt.pc   = tmp#taxslt.pc
     3414                           and acc#taxslt.type = tmp#taxslt.type
     3415                           no-error.
     3416   if available acc#taxslt then
     3417     assign  acc#taxslt.sum     = acc#taxslt.sum + (if tprintrubl then ot-tot.slt-rubl else ot-tot.slt-base).
     3418     else do:
     3419         create acc#taxslt.
     3420         assign acc#taxslt.type    = ot-tot.sum-type
     3421                 acc#taxslt.pc      = entry (2 , ot-tot.cat-id)
     3422                 acc#taxslt.sum     = if tprintrubl then ot-tot.slt-rubl else ot-tot.slt-base
     3423                 acc#taxslt.sum_full = if tprintrubl then ot-tot.sum-rubl else ot-tot.sum-base.
     3424             acc-j = acc-j + 1.
     3425     end.
     3426     End.
     3427        End.
     3428         IF ub.ot-tot.sum-type BEGINS 'cgsr':U and ub.ot-tot.sum-type <> 'cgsr':U Then DO:
     3429                   IF entry (2 , ub.ot-tot.cat-id) = '##':U Then DO:
     3430   create tmp#taxVAT.
     3431   assign tmp#taxVAT.type    = ot-tot.sum-type
     3432         tmp#taxVAT.pc      = entry (1 , ot-tot.cat-id)
     3433         tmp#taxVAT.sum     = if tprintrubl then ot-tot.VAT-rubl else ot-tot.VAT-base
     3434         tmp#taxVAT.sum_full     = if tprintrubl then ot-tot.sum-rubl else ot-tot.sum-base
     3435         .
     3436   i = i + 1.
     3437   find first acc#taxVAT where acc#taxVAT.pc   = tmp#taxVAT.pc
     3438                           and acc#taxVAT.type = tmp#taxVAT.type
     3439                           no-error.
     3440   if available acc#taxVAT then
     3441     assign  acc#taxVAT.sum     = acc#taxVAT.sum + (if tprintrubl then ot-tot.VAT-rubl else ot-tot.VAT-base).
     3442     else do:
     3443         create acc#taxVAT.
     3444         assign acc#taxVAT.type    = ot-tot.sum-type
     3445                 acc#taxVAT.pc      = entry (1 , ot-tot.cat-id)
     3446                 acc#taxVAT.sum     = if tprintrubl then ot-tot.VAT-rubl else ot-tot.VAT-base
     3447                 acc#taxVAT.sum_full = if tprintrubl then ot-tot.sum-rubl else ot-tot.sum-base.
     3448             acc-i = acc-i + 1.
     3449     end.
     3450      End.
     3451                     Else DO:
     3452   create tmp#taxslt.
     3453   assign tmp#taxslt.type    = ot-tot.sum-type
     3454         tmp#taxslt.pc      = entry (2 , ot-tot.cat-id)
     3455         tmp#taxslt.sum     = if tprintrubl then ot-tot.slt-rubl else ot-tot.slt-base
     3456         tmp#taxslt.sum_full     = if tprintrubl then ot-tot.sum-rubl else ot-tot.sum-base
     3457         .
     3458   j = j + 1.
     3459   find first acc#taxslt where acc#taxslt.pc   = tmp#taxslt.pc
     3460                           and acc#taxslt.type = tmp#taxslt.type
     3461                           no-error.
     3462   if available acc#taxslt then
     3463     assign  acc#taxslt.sum     = acc#taxslt.sum + (if tprintrubl then ot-tot.slt-rubl else ot-tot.slt-base).
     3464     else do:
     3465         create acc#taxslt.
     3466         assign acc#taxslt.type    = ot-tot.sum-type
     3467                 acc#taxslt.pc      = entry (2 , ot-tot.cat-id)
     3468                 acc#taxslt.sum     = if tprintrubl then ot-tot.slt-rubl else ot-tot.slt-base
     3469                 acc#taxslt.sum_full = if tprintrubl then ot-tot.sum-rubl else ot-tot.sum-base.
     3470             acc-j = acc-j + 1.
     3471     end.
     3472     End.
     3473         End.
     3474             if first-of ( tdedt.id ) then  run break-h-1.
     3475             if last-of ( ub.ot-tot.doc-code ) then do:
     3476                 if (ub.ot-tot.sum-type     =  'cgsr':U  and
     3477                    not (ub.ot-tot.ext-doc-type = 'vt':U ))
     3478                    then do:
     3479                       run break-ot.
     3480                       if ub.ot-tot.ext-doc-type = 'ap':U and costsum then run break-cost.
     3481                    end.
     3482                    else do:
     3483                       run break-1str.
     3484                       if available ub.trn-doc then do:
     3485                         if (absolute(ub.trn-doc.fact-qnty) - absolute(ub.trn-doc.doc-qnty) <> 0)
     3486                             and ub.ot-tot.ext-doc-type <> 'vt':U
     3487                             then run break-akt.
     3488                         end.
     3489                       if costsum then run break-cost.
     3490                       run break-2str.
     3491                       if dispupfact then run break-disp .
     3492                    end.
     3493                run erase-var.
     3494             end.
     3495             if last-of ( tdedt.id ) then do:
     3496                 qnty               = accum total       qnty                       .
     3497                 sumwithnds         = accum total       sumwithnds                 .
     3498                 discnt-sum         = accum total       discnt-sum                 .
     3499                 ov-sum             = accum total       ov-sum                     .
     3500                 vat-sum            = accum total       vat-sum                    .
     3501                 slt-sum            = accum total       slt-sum                    .
     3502                 sumwithoutnds      = accum total       sumwithoutnds              .
     3503                 sumwithnds-coast   = accum total       sumwithnds-coast           .
     3504                 vat-sum-coast      = accum total       vat-sum-coast              .
     3505                 slt-sum-coast      = accum total       slt-sum-coast              .
     3506                 sumwithoutnds-coast= accum total       sumwithoutnds-coast        .
     3507                 sale-sum-ot        = accum total       sale-sum-ot                .
     3508                 sale-sum           = (accum total       sale-sum   )  + sale-sum-ot  .
     3509   for each tmp#taxvat : delete tmp#taxvat. end.
     3510   for each acc#taxvat :
     3511     create tmp#taxvat.
     3512     assign tmp#taxvat.type   = acc#taxvat.type
     3513           tmp#taxvat.pc      = acc#taxvat.pc
     3514           tmp#taxvat.sum     = acc#taxvat.sum.
     3515   end.
     3516   i = acc-i.
     3517   for each tmp#taxslt : delete tmp#taxslt. end.
     3518   for each acc#taxslt :
     3519     create tmp#taxslt.
     3520     assign tmp#taxslt.type   = acc#taxslt.type
     3521           tmp#taxslt.pc      = acc#taxslt.pc
     3522           tmp#taxslt.sum     = acc#taxslt.sum.
     3523   end.
     3524   j = acc-j.
     3525             assign
     3526                   quantity3  = quantity3   + qnty
     3527                   coast5     = coast5      + sumwithnds-coast
     3528                   coast6     = coast6      + sale-sum
     3529                   .
     3530                run break-f-1.
     3531                End.
     3532           end.
     3533     end.
     3534   end procedure.
