     1659   end.
     1660   if  v-log = true  then
     1661   PUT STREAM OutStream
     1662   SPACE(23) string( "Cумма   УЧЕТНЫХ  цен: " +
     1663               trim( string( Coast1 , "->>>,>>>,>>>,>>>,>>9.99" ) ) + " " +
