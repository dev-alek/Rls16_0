     1450           string( "цены и суммы указаны в " + (if tPrintRubl then "РУБ" else x-base-type ) ) AT 90 format "X(27)"
     1451           string( "Страница " + string( PAGE-NUMBER( OutStream ), ">>>>9" ) ) AT 155 format "X(15)" SKIP
     1452           Line format "X(194)" AT 1
     1453       with width 232 down stream-io use-text NO-BOX.
     1454   define variable v-account as integer init 0 no-undo .
     1455   define variable v-account-lavel as character no-undo .
     1456   define variable v-button-stop as logical no-undo .
     1457   define variable v-kol-spice as integer no-undo .
     1458   define variable v-kol-spice2 as integer no-undo .
     1459   define variable v-kol-spice3 as integer no-undo .
     1460   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     1461   DEFINE BUTTON StopBtn AUTO-END-KEY
     1462        LABEL "Стоп"
     1463        SIZE 10 BY 1.
     1464   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     1465        LABEL "Обработано записей"
     1466         VIEW-AS TEXT
     1467        SIZE 14 BY .67 NO-UNDO.
     1468   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     1469         VIEW-AS TEXT
     1470        SIZE 53.25 BY .67
     1471        FGCOLOR 1  NO-UNDO.
     1472   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     1473         VIEW-AS TEXT
     1474        SIZE 53.25 BY .67
     1475        FGCOLOR 1  NO-UNDO.
     1476   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     1477         VIEW-AS TEXT
     1478        SIZE 53.25 BY .67
     1479        FGCOLOR 1  NO-UNDO.
     1480   DEFINE RECTANGLE RECT-1
     1481        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1482        SIZE 55.13 BY 4.46.
     1483   DEFINE FRAME InfoFrame
     1484        StopBtn AT ROW 4.25 COL 21.75
     1485        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     1486        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     1487        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     1488        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     1489        RECT-1 AT ROW 1 COL 1
     1490       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1491            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1492            TITLE "Процесс"
     1493            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     1494   define variable mFrameView      as logical   no-undo init yes.
     1495     define variable mFramHandle as handle no-undo.
     1496     mFramHandle = frame InfoFrame:handle.
     1497     if  log-manager:logfile-name ne ?
     1498     then DO:
     1499         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1500         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1501         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     1502     end.
     1503     mFrameView = not session:batch-mode and mFramHandle:visible.
     1504     if mFrameView
     1505     then do:
     1506       ASSIGN
     1507          FRAME InfoFrame:HIDDEN                           = TRUE
     1508          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     1509     end.
     1510   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     1511   DO:
     1512     IF not StopProcessing THEN
     1513       Message "Вы действительно хотите прервать" SKIP
     1514               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     1515                 UPDATE StopProcessing.
     1516     IF StopProcessing THEN do:
     1517        if mFrameView
     1518        then do:
     1519           HIDE FRAME InfoFrame.
     1520        end.
     1521     End.
     1522   END.
     1523   assign v-account = ( if integer( 50 ) = 0 then 100 else integer( 50 ) ).
     1524     if  log-manager:logfile-name ne ?
     1525     then DO:
     1526         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     1527     end.
     1528     if not session:batch-mode then
     1529     do:
     1530       VIEW FRAME InfoFrame.
     1531       mFrameView = true.
     1532     end.
     1533      v-button-stop = false .
     1534         if mFrameView
     1535         then do:
     1536         if v-button-stop then view STOPBTN in frame InfoFrame.
     1537                          else Hide STOPBTN in frame InfoFrame.
     1538         end.
     1539        assign
     1540           i=0
     1541           startdate     = x-date-start
     1542           enddate       = x-date-end
     1543           PayType       = x-SET_PAY_TYPE
     1544           xTog-obj      = true
     1545           ValType       = IF (PayType = 1) Then 0  else x-SET_val_TYPE.
     1546           run report-execute.
     1547   PROCEDURE report-execute :
     1548     If (ValType=0 and x-base-code=0)  Or ValType=1
     1549                                   then   assign tPrintRubl = yes .
     1550                                   else   assign tPrintRubl = no .
     1551      curr-rep = (if tPrintRubl then "РУБ" else x-base-type ) .
     1552      NO-PRISE = true .
     1553     if var-report-r-b = "rubl"  then do:
     1554       if  x-base-code <> 0 and valtype = 2  then no-prise = false  .
     1555     end.
     1556     else do:
     1557      if  x-base-code <> 0 and valtype = 1  then no-prise = false  .
     1558     end.
     1559   output stream OutStream to value( string( session:temp-directory +
     1560                                        "rpt" + string( g#report-num ) ) )
     1561                                        page-size  value(ReportPageHeight) .
     1562     FORM with FRAME DocsRep .
     1563   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1564   form header
     1565     line format "x(194)" at 1 skip
     1566     "Продолжение - на следующей странице" at 30 skip
     1567     with frame bottomframe width 232 page-bottom no-labels no-box .
     1568   view stream outstream frame bottomframe .
     1569      Line = fill("-", 194).
     1570      run calcitog in this-procedure.
     1571      run print-header in this-procedure.
     1572      run foreach in this-procedure.
     1573     HIDE stream OutStream FRAME BottomFrame .
     1574     run print-footer in this-procedure.
     1575     HIDE STREAM OutStream FRAME DocsRep .
     1576     Output stream OutStream close.
     1577   if mFrameView
     1578   then do:
     1579      HIDE FRAME InfoFrame.
     1580   end.
     1581     define variable v-user-action as character no-undo .
     1582     define variable v-printed as logical   no-undo .
     1583     define variable DisabledOptions as integer   no-undo .
     1584     define variable v-orient-page as character no-undo .
     1585     run How-name in this-procedure (
     1586         input ReportPageHeight,
     1587         input ReportPageWidth,
     1588         output v-orient-page )
     1589         .
     1590     if v-orient-page = "A4-lans":U then DisabledOptions = 8 .
     1591                                    else DisabledOptions = 0 .
     1592     run gbl/prnfilen.w
     1593       (input  ""
     1594       ,input  DisabledOptions
     1595       ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
     1596       ,input  ReportFontNum
     1597       ,output v-user-action
     1598       ,output v-printed
     1599       ) .
