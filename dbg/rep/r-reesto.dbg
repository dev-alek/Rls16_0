      882   define new global shared variable g#trdcalib as handle no-undo.
      883   PROCEDURE ostatok :
      884   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
      885   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
      886   def input parameter x-tog-shift   as   logical             no-undo.
      887   def input parameter x-date-start  like ub.stk-tot.Fact-date   no-undo.
      888   def input parameter x-date-end    like ub.stk-tot.Fact-date   no-undo.
      889   def input parameter x-shift-start as integer               no-undo.
      890   def input parameter x-shift-end   as integer               no-undo.
      891   def input parameter x-sum-type    like ub.stk-tot.sum-type    no-undo.
      892   def input parameter x-cat-id      like ub.stk-tot.cat-id      no-undo.
      893   def input parameter xTog-obj   as log no-undo.
      894   def output parameter Quantity    like ub.stk-tot.fact-qnty   no-undo.
      895   def output parameter Coast_R     like ub.stk-tot.sum-rubl    no-undo.
      896   def output parameter Coast_V     like ub.stk-tot.sum-rubl    no-undo.
      897   def output parameter VAT_R       like ub.stk-tot.sum-rubl    no-undo.
      898   def output parameter VAT_V       like ub.stk-tot.sum-rubl    no-undo.
      899   def output parameter Fact-order  like ub.stk-tot.Fact-order  no-undo.
      900   def var              Fact-order#   like ub.stk-tot.Fact-order  no-undo.
      901   def var              Fact-orderS   as char  no-undo.
      902   def var x-date-start-t  like ub.stk-tot.shift-date   no-undo.
      903      Assign
      904         Fact-order   = 0
      905         Quantity     = 0
      906         Coast_R      = 0
      907         Coast_V      = 0
      908         VAT_R        = 0
      909         VAT_V        = 0 .
      910    x-date-start-t  = x-date-start + 1 .
      911   IF x-date-end = date('') then DO:
      912      Fact-order = 0 .
      913      for each obj-list
      914          where  ( not xtog-obj or
      915                 ( x-store-type = obj-list.obj-type and x-store-code = obj-list.obj-code ))
      916                 no-lock :
      917         if  x-tog-shift = false then do:
      918                          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
      919                               ub.stk-tot.Fact-date <=  x-date-start
      920                               and ub.stk-tot.shift-num = 0
      921                               USE-INDEX fact-date no-lock no-error .
      922              if Available ub.stk-tot THEN  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
      923         End.
      924         Else  DO :
      925             find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
      926              (ub.stk-tot.shift-date  = x-date-start-t and
      927               ub.stk-tot.shift-num  < x-shift-start or
      928               ub.stk-tot.shift-date  < x-date-start-t  )
      929               and ub.stk-tot.shift-num  > 0
      930               USE-INDEX Shift-num no-lock no-error .
      931            If Available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
      932           END.
      933       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
      934     End.
      935   End.
      936   Else DO:
      937     For each obj-list  WHERE
      938        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
      939         no-lock :
      940      IF  x-TOG-Shift = False Then DO:
      941          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
      942               ub.stk-tot.Fact-date <= x-date-end
      943               and ub.stk-tot.shift-num = 0
      944               USE-INDEX fact-date no-lock no-error.
      945          if available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
      946      END.
      947      Else DO:
      948           find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
      949               (ub.stk-tot.shift-date  = x-date-end and
      950               ub.stk-tot.shift-num  <= x-shift-end or
      951               ub.stk-tot.shift-date  < x-date-end       ) and
      952               ub.stk-tot.shift-num   > 0      use-index shift-num no-lock no-error.
      953               if Available ub.stk-tot THEN Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
      954       End.
      955       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
      956     End.
      957   End.
      958   END PROCEDURE.
