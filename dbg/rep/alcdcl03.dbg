     3330   procedure clcprtsl_calc-line :
     3331   define input  parameter parrec-line as recid no-undo.
     3332   define variable v-tax-date         as   date                     no-undo.
     3333   define variable v-vat-pc           like ub.doc-line.vat-pc       no-undo.
     3334   define variable varr-b             as   character                no-undo.
     3335   define variable varr-btype         as   character                no-undo.
     3336   define variable varcur-base        like ub.gds-dtl.price-base    no-undo.
     3337   define variable varcur-road-tax    like ub.doc-line.road-tax     no-undo.
     3338   define variable varcur-excise      like ub.doc-line.excise       no-undo.
     3339   define variable varcur-vat-pc      like ub.doc-line.vat-pc       no-undo.
     3340   define variable varcur-cons-vat-pc like ub.doc-line.cons-vat-pc  no-undo.
     3341   define variable varcur-slt-pc      like ub.doc-line.slt-pc       no-undo.
     3342   define variable varcur-fact-qnty   like ub.gds-dtl.fact-qnty     no-undo.
     3343   define variable varb-code          like ub.bar-code.b-code       no-undo.
     3344   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     3345   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     3346   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     3347   define variable varexcise          like ub.price-list.excise     no-undo.
     3348   define variable varlastcur-base        like ub.gds-dtl.price-base no-undo.
     3349   define variable varlastcur-road-tax    like ub.gds-dtl.price-base no-undo.
     3350   define variable varlastcur-excise      like ub.gds-dtl.price-base     no-undo.
     3351   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     3352   define variable v-varsum           as decimal                  no-undo.
     3353   define variable varprice-salef as decimal   no-undo .
     3354   define buffer bf_trn-doc             for ub.trn-doc.
     3355   define buffer bf_doc-line            for ub.doc-line.
     3356   define buffer bf_gds-dtl             for ub.gds-dtl.
     3357   define buffer bf_goods               for ub.goods.
     3358   define buffer bf_parts               for ub.parts.
     3359   define buffer bf_sysconf             for ub.sysconf.
     3360   define buffer bf_tt-allsum-line      for tt-allsum-line.
     3361   define buffer bfs_tt-allsum-line     for tt-allsum-line.
     3362   define buffer bfo_tt-allsum-line     for tt-allsum-line.
     3363   define buffer bfos_tt-allsum-line    for tt-allsum-line.
     3364   define buffer buf_parts        for ub.parts.
     3365   v-calcbypart = no.
     3366   do on error undo, return error return-value :
     3367   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     3368   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     3369     (output varr-b
     3370     )  .
     3371     find first bf_doc-line where recid (bf_doc-line) = parrec-line no-lock.
     3372     find first bf_trn-doc where bf_trn-doc.doc-code = bf_doc-line.doc-code no-lock.
     3373     find first bf_goods where bf_goods.artic     = bf_doc-line.artic     and
     3374                               bf_goods.prod-type = bf_doc-line.prod-type and
     3375                               bf_goods.prod-code = bf_doc-line.prod-code no-lock.
     3376     if bf_trn-doc.fact-date <> ?        then do:
     3377       assign v-tax-date = bf_trn-doc.fact-date.
     3378     end.
     3379     else do:
     3380       assign v-tax-date = ?.
     3381     end.
