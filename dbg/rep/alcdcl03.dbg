     3928         undo, return error return-value .
     3929       end.
     3930     end.
     3931   end procedure.
     3932   procedure clntattr-tooltip :
     3933     define input  parameter p-code    as character no-undo .
     3934     define output parameter p-tooltip as character no-undo .
