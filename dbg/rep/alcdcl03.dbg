     6018   procedure gds-attr_check-ptrl-divis :
     6019     define input  parameter p-gds-code    like ub.goods-attr.gds-code     no-undo .
     6020     define input  parameter p-code        like ub.goods-attr.attr-code  no-undo .
     6021     define input  parameter p-value       as character no-undo .
