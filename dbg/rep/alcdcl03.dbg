     2004   define variable v-calcbypart as log no-undo.
     2005   procedure clcprtsl_calc-parts :
     2006   define input parameter parrec-parts        as   recid                   no-undo.
     2007   define input parameter paris-doc           as   logical                 no-undo.
     2008   define input parameter paris-cur           as   logical                 no-undo.
     2009   define input parameter parroad-tax         like ub.doc-line.road-tax    no-undo.
     2010   define input parameter parexcise           like ub.doc-line.excise      no-undo.
     2011   define input parameter parvat-pc           like ub.doc-line.vat-pc      no-undo.
     2012   define input parameter parcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     2013   define input parameter parslt-pc           like ub.doc-line.slt-pc      no-undo.
     2014   define input parameter parbase-rate        like ub.trn-doc.base-rate    no-undo.
     2015   define input parameter parbase-scale       like ub.trn-doc.base-scale   no-undo.
     2016   define input parameter parr-b              as   character               no-undo.
     2017   define input parameter parcur-base         like ub.gds-dtl.cur-base     no-undo.
     2018   define input parameter parcurroad-tax      like ub.doc-line.road-tax    no-undo.
     2019   define input parameter parcurexcise        like ub.doc-line.excise      no-undo.
     2020   define input parameter parcurvat-pc        like ub.doc-line.vat-pc      no-undo.
     2021   define input parameter parcurcons-vat-pc   like ub.doc-line.cons-vat-pc no-undo.
