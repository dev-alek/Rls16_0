     2687       parcurobj-type   = cl_tt-clcparts.obj-type
     2688       parcurobj-code   = cl_tt-clcparts.obj-code.
     2689     if parr-b = "base" then do:
     2690       assign
     2691         parcurprice-base = parcur-base
     2692         parcurprice-rubl = parcur-base * parbase-rate / parbase-scale.
     2693     end.
     2694     else do:
     2695       assign
     2696         parcurprice-base = parcur-base / parbase-rate * parbase-scale
     2697         parcurprice-rubl = parcur-base.
