     3638               varlastcur-road-tax = varroad-tax
     3639               varlastcur-excise   = varexcise
     3640               varcur-base         = varcur-base      + varprice-sale * bf_gds-dtl.fact-qnty
     3641               varcur-road-tax     = varcur-road-tax  + varroad-tax   * bf_gds-dtl.fact-qnty
     3642               varcur-excise       = varcur-excise    + varexcise     * bf_gds-dtl.fact-qnty
     3643               varcur-fact-qnty    = varcur-fact-qnty + bf_gds-dtl.fact-qnty
     3644             .
     3645         end.
     3646       end.
     3647       if varcur-fact-qnty = 0 then do:
     3648         assign
     3649           varcur-base      = varlastcur-base
     3650           varcur-road-tax  = varlastcur-road-tax
     3651           varcur-excise    = varlastcur-excise
     3652         .
     3653       end.
     3654       else do:
     3655         assign
     3656           varcur-base      = varcur-base      / varcur-fact-qnty
     3657           varcur-road-tax  = varcur-road-tax  / varcur-fact-qnty
     3658           varcur-excise    = varcur-excise    / varcur-fact-qnty
     3659         .
     3660       end.
     3661       if varcur-vat-pc = ?
     3662       then do:
     3663         return error substitute ("Нет текущего продажного НДС по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     3664       end.
     3665       if varcur-slt-pc = ?
     3666       then do:
     3667         return error substitute ("Нет текущего продажного НП по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     3668       end.
     3669       find first bf_sysconf where bf_sysconf.host-code = bf_trn-doc.host-code no-lock.
     3670       assign
     3671         varcur-cons-vat-pc = bf_sysconf.cons-vat-pc.
     3672       if varcur-cons-vat-pc = ? then do:
     3673         return error substitute ("Нет текущего продажного консигнационного НДС по фирме &1", bf_trn-doc.host-code).
     3674       end.
     3675       define buffer buf_tt-clcparts for tt-clcparts .
     3676       for each buf_tt-clcparts
     3677       on error undo, return error return-value
     3678       :
     3679         delete buf_tt-clcparts.
     3680       end.
     3681       for each bf_parts no-lock
     3682         where bf_parts.out-code  = bf_doc-line.doc-code
     3683           and bf_parts.obj-type  = bf_doc-line.obj-type
     3684           and bf_parts.obj-code  = bf_doc-line.obj-code
     3685           and bf_parts.artic     = bf_doc-line.artic
     3686           and bf_parts.prod-type = bf_doc-line.prod-type
     3687           and bf_parts.prod-code = bf_doc-line.prod-code
     3688       on error undo, return error return-value
     3689       :
     3690         create buf_tt-clcparts .
     3691         buffer-copy bf_parts to buf_tt-clcparts .
     3692         if v-calcbypart = yes   then do:
     3693   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run partbcod in g#library
     3694     (buffer bf_parts
     3695     ,output v-b-pcode
     3696     ) no-error .
     3697   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3698   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     3699     (input  bf_parts.obj-type
     3700     ,input  bf_parts.obj-code
     3701     ,input  v-b-pcode
     3702     ,input  0
     3703     ,input  bf_trn-doc.fact-order
     3704     ,output vardoc-num
     3705     ,output varprice-salef
     3706     ,output varroad-tax
     3707     ,output varexcise
     3708     ) no-error .
     3709             if varprice-sale = ?
     3710             then do:
     3711               assign
     3712                 varprice-salef = 0
     3713                 varroad-tax   = 0
     3714                 varexcise     = 0
     3715               .
     3716             end.
     3717             assign
     3718             part-cur-base  = varprice-salef
     3719             part-cur-road-tax  = varroad-tax
     3720             part-cur-excise = varexcise.
     3721         end.
     3722       end.
     3723       run clcprtsl_calc-ttable in this-procedure
     3724         (input yes,
     3725          input yes,
     3726          input bf_doc-line.road-tax,
     3727          input bf_doc-line.excise,
     3728          input bf_doc-line.vat-pc,
     3729          input bf_doc-line.cons-vat-pc,
     3730          input bf_doc-line.slt-pc,
     3731          input bf_trn-doc.base-rate,
     3732          input bf_trn-doc.base-scale,
     3733          input varr-b,
     3734          input varcur-base,
     3735          input varcur-road-tax,
     3736          input varcur-excise,
     3737          input varcur-vat-pc,
     3738          input varcur-cons-vat-pc,
     3739          input varcur-slt-pc
     3740          ) no-error.
     3741       if error-status:error then do:
     3742         message
     3743           vss-workfile vss-revision vss-description skip
     3744           "Ошибка при вызове процедуры clcprtsl_calc-ttable." skip
     3745           return-value skip
     3746           trim(error-status :get-message(1))
     3747           trim(error-status :get-message(2))
     3748           trim(error-status :get-message(3))
     3749           trim(error-status :get-message(4))
     3750           trim(error-status :get-message(5)) skip
     3751           view-as alert-box error.
     3752         undo, return error .
     3753       end.
     3754     end.
     3755   end.
     3756   end.
     3757   procedure clcprtsl_calc-ttable :
     3758   define input parameter paris-doc           as   logical                 no-undo.
     3759   define input parameter paris-cur           as   logical                 no-undo.
     3760   define input parameter parroad-tax         like ub.doc-line.road-tax    no-undo.
     3761   define input parameter parexcise           like ub.doc-line.excise      no-undo.
     3762   define input parameter parvat-pc           like ub.doc-line.vat-pc      no-undo.
     3763   define input parameter parcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     3764   define input parameter parslt-pc           like ub.doc-line.slt-pc      no-undo.
     3765   define input parameter parbase-rate        like ub.trn-doc.base-rate    no-undo.
     3766   define input parameter parbase-scale       like ub.trn-doc.base-scale   no-undo.
     3767   define input parameter parr-b              as   character               no-undo.
     3768   define input parameter parcur-base         like ub.gds-dtl.cur-base     no-undo.
     3769   define input parameter parcur-road-tax     like ub.doc-line.road-tax    no-undo.
     3770   define input parameter parcur-excise       like ub.doc-line.excise      no-undo.
     3771   define input parameter parcur-vat-pc       like ub.doc-line.vat-pc      no-undo.
     3772   define input parameter parcurcons-vat-pc   like ub.doc-line.cons-vat-pc no-undo.
     3773   define input parameter parcurslt-pc        like ub.doc-line.slt-pc      no-undo.
     3774   define buffer bf_tt-allsum      for tt-allsum.
     3775   define buffer bf_tt-clcparts    for tt-clcparts.
     3776   define buffer bf_tt-allsum-line for tt-allsum-line.
     3777   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     3778   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     3779   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     3780   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     3781   define variable varexcise          like ub.price-list.excise     no-undo.
     3782   do on error undo, return error return-value :
     3783   for each bf_tt-allsum-line
     3784   on error undo, return error return-value
     3785    :
     3786     delete bf_tt-allsum-line.
     3787   end.
     3788   for each bf_tt-allsum
     3789   on error undo, return error return-value
     3790   :
     3791     delete bf_tt-allsum.
     3792   end.
     3793   for each bf_tt-clcparts
     3794   on error undo, return error return-value
     3795   :
     3796   if v-calcbypart then do:
     3797             assign
     3798             parcur-base =   bf_tt-clcparts.part-cur-base
     3799             parcur-road-tax = bf_tt-clcparts.part-cur-road-tax
     3800             parcur-excise =   bf_tt-clcparts.part-cur-excise
     3801             .
     3802   end.
     3803      run clcprtsl_calc-parts in this-procedure (
     3804        input recid(bf_tt-clcparts),
     3805        input paris-doc,
     3806        input paris-cur,
     3807        input parroad-tax,
     3808        input parexcise,
     3809        input parvat-pc,
     3810        input parcons-vat-pc,
     3811        input parslt-pc,
     3812        input parbase-rate,
     3813        input parbase-scale,
     3814        input parr-b,
     3815        input parcur-base,
     3816        input parcur-road-tax,
     3817        input parcur-excise,
     3818        input parcur-vat-pc,
     3819        input parcurcons-vat-pc,
     3820        input parcurslt-pc
     3821        ) no-error.
     3822     if error-status:error then do:
     3823       message
     3824         vss-workfile vss-revision vss-description skip
     3825         vss-include-info15 skip
     3826         "Ошибка при обсчете партии" skip
     3827         "Документ партии " bf_tt-clcparts.out-code skip
     3828         "Товар" bf_tt-clcparts.artic bf_tt-clcparts.prod-type bf_tt-clcparts.prod-code skip
     3829         return-value skip
     3830         error-status:get-message(1) skip
     3831         error-status:get-message(2) skip
     3832         error-status:get-message(3) skip
     3833         view-as alert-box error .
     3834       undo, return error .
     3835     end.
     3836     for each bf_tt-allsum on error undo, return error return-value :
     3837       find first bf_tt-allsum-line where bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type no-error.
     3838       if not available bf_tt-allsum-line then do:
     3839         create bf_tt-allsum-line.
     3840         assign
     3841           bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type.
     3842       end.
     3843       assign
     3844         bf_tt-allsum-line.fact-qnty              = bf_tt-allsum-line.fact-qnty            + bf_tt-allsum.fact-qnty
     3845         bf_tt-allsum-line.cli-qnty               = bf_tt-allsum-line.cli-qnty             + bf_tt-allsum.cli-qnty
     3846         bf_tt-allsum-line.sum-dsc-base-doc       = bf_tt-allsum-line.sum-dsc-base-doc     + bf_tt-allsum.sum-dsc-base-doc
     3847         bf_tt-allsum-line.sum-dsc-rubl-doc       = bf_tt-allsum-line.sum-dsc-rubl-doc     + bf_tt-allsum.sum-dsc-rubl-doc
     3848         bf_tt-allsum-line.dsc-base-doc           = bf_tt-allsum-line.dsc-base-doc         + bf_tt-allsum.dsc-base-doc
     3849         bf_tt-allsum-line.dsc-rubl-doc           = bf_tt-allsum-line.dsc-rubl-doc         + bf_tt-allsum.dsc-rubl-doc
     3850         bf_tt-allsum-line.vat-base-doc           = bf_tt-allsum-line.vat-base-doc         + bf_tt-allsum.vat-base-doc
     3851         bf_tt-allsum-line.vat-rubl-doc           = bf_tt-allsum-line.vat-rubl-doc         + bf_tt-allsum.vat-rubl-doc
     3852         bf_tt-allsum-line.vat-base-buyer-doc     = bf_tt-allsum-line.vat-base-buyer-doc   + bf_tt-allsum.vat-base-buyer-doc
     3853         bf_tt-allsum-line.vat-rubl-buyer-doc     = bf_tt-allsum-line.vat-rubl-buyer-doc   + bf_tt-allsum.vat-rubl-buyer-doc
     3854         bf_tt-allsum-line.slt-base-doc           = bf_tt-allsum-line.slt-base-doc         + bf_tt-allsum.slt-base-doc
     3855         bf_tt-allsum-line.slt-rubl-doc           = bf_tt-allsum-line.slt-rubl-doc         + bf_tt-allsum.slt-rubl-doc
     3856         bf_tt-allsum-line.road-tax-base-doc      = bf_tt-allsum-line.road-tax-base-doc    + bf_tt-allsum.road-tax-base-doc
     3857         bf_tt-allsum-line.road-tax-rubl-doc      = bf_tt-allsum-line.road-tax-rubl-doc    + bf_tt-allsum.road-tax-rubl-doc
     3858         bf_tt-allsum-line.excise-base-doc        = bf_tt-allsum-line.excise-base-doc      + bf_tt-allsum.excise-base-doc
     3859         bf_tt-allsum-line.excise-rubl-doc        = bf_tt-allsum-line.excise-rubl-doc      + bf_tt-allsum.excise-rubl-doc
     3860         bf_tt-allsum-line.sum-dsc-base-cur       = bf_tt-allsum-line.sum-dsc-base-cur     + bf_tt-allsum.sum-dsc-base-cur
     3861         bf_tt-allsum-line.sum-dsc-rubl-cur       = bf_tt-allsum-line.sum-dsc-rubl-cur     + bf_tt-allsum.sum-dsc-rubl-cur
     3862         bf_tt-allsum-line.dsc-base-cur           = bf_tt-allsum-line.dsc-base-cur         + bf_tt-allsum.dsc-base-cur
     3863         bf_tt-allsum-line.dsc-rubl-cur           = bf_tt-allsum-line.dsc-rubl-cur         + bf_tt-allsum.dsc-rubl-cur
     3864         bf_tt-allsum-line.vat-base-cur           = bf_tt-allsum-line.vat-base-cur         + bf_tt-allsum.vat-base-cur
     3865         bf_tt-allsum-line.vat-rubl-cur           = bf_tt-allsum-line.vat-rubl-cur         + bf_tt-allsum.vat-rubl-cur
     3866         bf_tt-allsum-line.vat-base-buyer-cur     = bf_tt-allsum-line.vat-base-buyer-cur   + bf_tt-allsum.vat-base-buyer-cur
     3867         bf_tt-allsum-line.vat-rubl-buyer-cur     = bf_tt-allsum-line.vat-rubl-buyer-cur   + bf_tt-allsum.vat-rubl-buyer-cur
     3868         bf_tt-allsum-line.slt-base-cur           = bf_tt-allsum-line.slt-base-cur         + bf_tt-allsum.slt-base-cur
     3869         bf_tt-allsum-line.slt-rubl-cur           = bf_tt-allsum-line.slt-rubl-cur         + bf_tt-allsum.slt-rubl-cur
     3870         bf_tt-allsum-line.road-tax-base-cur      = bf_tt-allsum-line.road-tax-base-cur    + bf_tt-allsum.road-tax-base-cur
     3871         bf_tt-allsum-line.road-tax-rubl-cur      = bf_tt-allsum-line.road-tax-rubl-cur    + bf_tt-allsum.road-tax-rubl-cur
     3872         bf_tt-allsum-line.excise-base-cur        = bf_tt-allsum-line.excise-base-cur      + bf_tt-allsum.excise-base-cur
     3873         bf_tt-allsum-line.excise-rubl-cur        = bf_tt-allsum-line.excise-rubl-cur      + bf_tt-allsum.excise-rubl-cur
     3874         bf_tt-allsum-line.sum-dsc-base-acc       = bf_tt-allsum-line.sum-dsc-base-acc     + bf_tt-allsum.sum-dsc-base-acc
     3875         bf_tt-allsum-line.sum-dsc-rubl-acc       = bf_tt-allsum-line.sum-dsc-rubl-acc     + bf_tt-allsum.sum-dsc-rubl-acc
     3876         bf_tt-allsum-line.sum-dsc-cli-acc        = bf_tt-allsum-line.sum-dsc-cli-acc      + bf_tt-allsum.sum-dsc-cli-acc
     3877         bf_tt-allsum-line.dsc-base-acc           = bf_tt-allsum-line.dsc-base-acc         + bf_tt-allsum.dsc-base-acc
     3878         bf_tt-allsum-line.dsc-rubl-acc           = bf_tt-allsum-line.dsc-rubl-acc         + bf_tt-allsum.dsc-rubl-acc
     3879         bf_tt-allsum-line.dsc-cli-acc            = bf_tt-allsum-line.dsc-cli-acc          + bf_tt-allsum.dsc-cli-acc
     3880         bf_tt-allsum-line.vat-base-acc           = bf_tt-allsum-line.vat-base-acc         + bf_tt-allsum.vat-base-acc
     3881         bf_tt-allsum-line.vat-rubl-acc           = bf_tt-allsum-line.vat-rubl-acc         + bf_tt-allsum.vat-rubl-acc
     3882         bf_tt-allsum-line.vat-cli-acc            = bf_tt-allsum-line.vat-cli-acc          + bf_tt-allsum.vat-cli-acc
     3883         bf_tt-allsum-line.slt-base-acc           = bf_tt-allsum-line.slt-base-acc         + bf_tt-allsum.slt-base-acc
     3884         bf_tt-allsum-line.slt-rubl-acc           = bf_tt-allsum-line.slt-rubl-acc         + bf_tt-allsum.slt-rubl-acc
     3885         bf_tt-allsum-line.slt-cli-acc            = bf_tt-allsum-line.slt-cli-acc          + bf_tt-allsum.slt-cli-acc
     3886         bf_tt-allsum-line.road-tax-base-acc      = bf_tt-allsum-line.road-tax-base-acc    + bf_tt-allsum.road-tax-base-acc
     3887         bf_tt-allsum-line.road-tax-rubl-acc      = bf_tt-allsum-line.road-tax-rubl-acc    + bf_tt-allsum.road-tax-rubl-acc
     3888         bf_tt-allsum-line.road-tax-cli-acc       = bf_tt-allsum-line.road-tax-cli-acc     + bf_tt-allsum.road-tax-cli-acc
     3889         bf_tt-allsum-line.excise-base-acc        = bf_tt-allsum-line.excise-base-acc      + bf_tt-allsum.excise-base-acc
     3890         bf_tt-allsum-line.excise-rubl-acc        = bf_tt-allsum-line.excise-rubl-acc      + bf_tt-allsum.excise-rubl-acc
     3891         bf_tt-allsum-line.excise-cli-acc         = bf_tt-allsum-line.excise-cli-acc       + bf_tt-allsum.excise-cli-acc
     3892         bf_tt-allsum-line.transport-base-acc     = bf_tt-allsum-line.transport-base-acc   + bf_tt-allsum.transport-base-acc
     3893         bf_tt-allsum-line.transport-rubl-acc     = bf_tt-allsum-line.transport-rubl-acc   + bf_tt-allsum.transport-rubl-acc
     3894         bf_tt-allsum-line.transport-cli-acc      = bf_tt-allsum-line.transport-cli-acc    + bf_tt-allsum.transport-cli-acc
     3895         bf_tt-allsum-line.other-base-acc         = bf_tt-allsum-line.other-base-acc       + bf_tt-allsum.other-base-acc
     3896         bf_tt-allsum-line.other-rubl-acc         = bf_tt-allsum-line.other-rubl-acc       + bf_tt-allsum.other-rubl-acc
     3897         bf_tt-allsum-line.other-cli-acc          = bf_tt-allsum-line.other-cli-acc        + bf_tt-allsum.other-cli-acc
     3898         .
     3899     end.
     3900   end.
     3901   end.
     3902   end procedure.
     3903   def var vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3904   define new global shared variable g#attr-lib  as handle no-undo .
     3905   define variable v-attr-lib-variable as handle no-undo .
     3906   procedure clntattr-code :
     3907     define input  parameter p-code           as character no-undo .
     3908     define output parameter p-type           as character no-undo .
     3909     define output parameter p-format         as character no-undo .
     3910     define output parameter p-label          as character no-undo .
     3911     define output parameter p-user-can-edit  as logical   no-undo .
     3912     define output parameter p-output-display as logical   no-undo .
     3913     define output parameter p-other          as character no-undo .
     3914     do
     3915     on error undo, return error return-value
     3916     :
     3917           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clntattr-code in g#attr-lib
     3918         (input  p-code
     3919         ,output p-type
     3920         ,output p-format
     3921         ,output p-label
     3922         ,output p-user-can-edit
     3923         ,output p-output-display
     3924         ,output p-other
     3925         ) no-error .
     3926       if error-status :error
