     4841           and buf_doc-line-attr.gds-code  = p-gds-code
     4842           and buf_doc-line-attr.attr-code = p-code  + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
     4843         no-error .
     4844       if avail buf_doc-line-attr then do:
     4845         assign
