     3950   procedure clntattr-value :
     3951     define input  parameter p-obj-type like ub.clients-attr.obj-type   no-undo .
     3952     define input  parameter p-obj-code like ub.clients-attr.obj-code   no-undo .
     3953     define input  parameter p-code     like ub.clients-attr.attr-code  no-undo .
     3954     define output parameter p-value    like ub.clients-attr.attr-value no-undo .
     3955     define output parameter p-type     as character no-undo .
     3956     do
