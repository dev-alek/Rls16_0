     6410     define input  parameter p-obj-type like ub.clients-attr.obj-type   no-undo .
     6411     define input  parameter p-obj-code like ub.clients-attr.obj-code   no-undo .
     6412     define input  parameter p-gds-code as   integer                    no-undo .
     6413     define output parameter o-result   as   logical                    no-undo.
     6414     do
     6415     on error undo, return error
     6416     :
     6417           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run isVolumArticGoods in g#attr-lib
     6418         (input  p-obj-type
     6419         ,input  p-obj-code
     6420         ,input p-gds-code
     6421         ,output o-result
     6422         ) no-error .
     6423       if error-status :error
     6424       then do:
     6425         undo, return error return-value .
     6426       end.
     6427     end.
     6428   end procedure.
     6429   define temp-table temp-font no-undo
     6430     field fontnum  as integer
     6431     field fontname as character
     6432     field fontsize as character
     6433     field fonttype as character
     6434     field font-h   as integer
     6435     field font-w   as integer
     6436     field v-row    as integer
     6437     field v-col    as integer
     6438     field v-row-lans as integer
     6439     field v-col-lans as integer
     6440   index pi fontnum
     6441   .
     6442   procedure get-font-ini :
     6443     do
     6444     on error undo, return error return-value
     6445     :
     6446   define variable ii as integer   no-undo .
     6447   define variable v-font7 as character no-undo .
     6448   define variable v-font as character no-undo .
     6449   define variable loc-name as character no-undo .
     6450   define variable loc-size as character no-undo .
     6451   define variable loc-type as character no-undo .
     6452   define variable old_H as integer   no-undo .
     6453   define variable old_w as integer   no-undo .
     6454   define variable old-row  as integer   no-undo .
     6455   define variable old-col  as integer   no-undo .
     6456   define variable old-row-lans  as integer   no-undo .
     6457   define variable old-col-lans  as integer   no-undo .
     6458   define variable vv as integer   no-undo .
     6459   empty temp-table temp-font.
     6460     GET-KEY-VALUE SECTION "fonts" KEY "font7" VALUE v-font7 .
     6461       case num-entries (v-font7) :
     6462         when 4 then do:
     6463             assign
     6464               loc-name = entry ( 1 , v-font7 )
     6465               loc-size = entry ( 2 , v-font7 )
     6466               loc-type = entry ( 3 , v-font7 ) + "," +  entry ( 4 , v-font7 )
     6467             .
     6468         end.
     6469         when 3 then do:
     6470             assign
     6471               loc-name = entry ( 1 , v-font7 )
     6472               loc-size = entry ( 2 , v-font7 )
     6473               loc-type = entry ( 3 , v-font7 )
     6474             .
     6475         end.
     6476         when 2 then  do:
     6477             assign
     6478               loc-name = entry ( 1 , v-font7 )
     6479               loc-size = entry ( 2 , v-font7 )
     6480               loc-type = ""
     6481             .
     6482         end.
     6483         when 1 then do:
     6484             assign
     6485               loc-name = trim(entry ( 1 , v-font7 ))
     6486               loc-size = ""
     6487               loc-type = ""
     6488             .
     6489         end.
     6490       end case.
     6491     create temp-font.
     6492     assign
     6493       temp-font.fontnum  = 7
     6494       temp-font.fontname = trim(loc-name)
     6495       temp-font.fontsize = trim(loc-size)
     6496       temp-font.fonttype = trim(loc-type)
     6497       temp-font.v-row    = 62
     6498       temp-font.v-col    = 136
     6499       temp-font.v-row-lans = 43
     6500       temp-font.v-col-lans = 198
     6501     .
     6502     repeat ii = 16 to 100 :
     6503       get-key-value section 'fonts' key 'font' + string(ii)   value v-font  .
     6504       if v-font = "" or v-font = ? then leave.
     6505       case num-entries (v-font) :
     6506         when 4 then do:
     6507             assign
     6508               loc-name = entry ( 1 , v-font )
     6509               loc-size = entry ( 2 , v-font )
     6510               loc-type = entry ( 3 , v-font ) + "," +  entry ( 4 , v-font )
     6511             .
     6512         end.
     6513         when 3 then do:
     6514             assign
     6515               loc-name = entry ( 1 , v-font )
     6516               loc-size = entry ( 2 , v-font )
     6517               loc-type = entry ( 3 , v-font )
     6518             .
     6519         end.
     6520         when 2 then do:
     6521             assign
     6522               loc-name = entry ( 1 , v-font )
     6523               loc-size = entry ( 2 , v-font )
     6524               loc-type = ""
     6525             .
     6526         end.
     6527         when 1 then do:
     6528             assign
     6529               loc-name = trim(entry ( 1 , v-font ))
     6530               loc-size = ""
     6531               loc-type = ""
     6532             .
     6533         end.
     6534       end case.
     6535     create temp-font.
     6536     assign
     6537       temp-font.fontnum  = ii
     6538       temp-font.fontname = trim(loc-name)
     6539       temp-font.fontsize = trim(loc-size)
     6540       temp-font.fonttype = trim(loc-type)
     6541     .
     6542     end.
     6543       for each temp-font :
     6544          vv = integer(entry(2,temp-font.fontsize, "=" )) no-error .
     6545          if  vv = ? then vv =  0 .
     6546           run rep/exfont.p (
     6547             input   temp-font.fontname ,
     6548             input   vv ,
     6549             input   temp-font.fonttype ,
     6550             output  temp-font.font-h   ,
     6551             output  temp-font.font-w   )
     6552           .
     6553       end.
     6554   find first temp-font where  temp-font.fontnum  = 7  .
     6555   old_H = temp-font.font-H .
     6556   old_w = temp-font.font-W .
     6557   old-row = temp-font.v-row .
     6558   old-col = temp-font.v-col .
     6559   old-row-lans = temp-font.v-row-lans .
     6560   old-col-lans = temp-font.v-col-lans .
     6561       for each temp-font where
     6562                temp-font.fontnum  <> 7 :
     6563           assign
     6564               temp-font.v-row    = old_H * old-row / temp-font.font-h
     6565               temp-font.v-col    = old_W * old-col / temp-font.font-W
     6566               temp-font.v-row-lans    = old_H * old-row-lans / temp-font.font-h
     6567               temp-font.v-col-lans    = old_W * old-col-lans / temp-font.font-W
     6568           .
     6569       end.
     6570     end.
     6571   end procedure.
     6572   PROCEDURE How-name :
     6573   define input  parameter h as integer no-undo .
     6574   define input  parameter w as integer no-undo .
     6575   define output parameter n as character  no-undo .
     6576   define variable A4port-H as integer   no-undo init 63.
     6577   define variable A4port-W as integer   no-undo init 136.
     6578   define variable A4lans-H as integer   no-undo init 43.
     6579   define variable A4lans-W as integer   no-undo init 198.
     6580   define variable Strim-W  as integer   no-undo init 278.
     6581   run define-a4-size (
     6582        input ReportFontNum
     6583       ,output A4port-H
     6584       ,output A4port-W
     6585       ,output A4lans-H
     6586       ,output A4lans-W ).
     6587   If w >= 1 and w <= A4port-W Then DO:
     6588     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     6589     If h > A4lans-H  and h <= A4port-H Then n = "A4-port":U.
     6590     If h > A4port-H              Then n = "to-file":U.
     6591   End.
     6592   If w > A4port-W and w <= A4lans-W Then DO:
     6593     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     6594     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     6595     If h > A4port-H              Then n = "to-file":U.
     6596   End.
     6597   If w > A4lans-W and w <= Strim-W Then DO:
     6598     If h >= 1  and h <= A4lans-H Then n = "to-file":U.
     6599     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     6600     If h > A4port-H              Then n = "to-file":U.
     6601   End.
     6602   If w > Strim-W Then DO:
     6603      n = "to-file":U.
     6604   End.
     6605   END PROCEDURE.
     6606   PROCEDURE define-a4-size :
     6607   define input  parameter p-ReportFontNum as integer   no-undo .
     6608   define output parameter A4port-H as integer   no-undo .
     6609   define output parameter A4port-W as integer   no-undo .
     6610   define output parameter A4lans-H as integer   no-undo .
     6611   define output parameter A4lans-W as integer   no-undo .
     6612   if not can-find (first temp-font ) then do:
     6613      run get-font-ini .
     6614   end.
     6615   find first temp-font where temp-font.fontnum = p-ReportFontNum no-error .
     6616   if available temp-font then do:
     6617   assign
     6618     A4port-H = temp-font.v-row
     6619     A4port-W = temp-font.v-col
     6620     A4lans-H = temp-font.v-row-lans
     6621     A4lans-W = temp-font.v-col-lans
     6622   .
     6623   end.
     6624   else do:
     6625   assign
     6626     A4port-H = 63
     6627     A4port-W = 136
     6628     A4lans-H = 43
     6629     A4lans-W = 198
     6630   .
     6631   end.
     6632   END PROCEDURE.
