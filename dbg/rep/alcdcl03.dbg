     3023       bfs_tt-allsum.vat-base-cur        =  - bf_tt-allsum.vat-base-cur
     3024       bfs_tt-allsum.vat-rubl-cur        =  - bf_tt-allsum.vat-rubl-cur
     3025       bfs_tt-allsum.vat-base-buyer-cur  =  - bf_tt-allsum.vat-base-buyer-cur
     3026       bfs_tt-allsum.vat-rubl-buyer-cur  =  - bf_tt-allsum.vat-rubl-buyer-cur
     3027       bfs_tt-allsum.slt-base-cur        =  - bf_tt-allsum.slt-base-cur
     3028       bfs_tt-allsum.slt-rubl-cur        =  - bf_tt-allsum.slt-rubl-cur
     3029       bfs_tt-allsum.road-tax-base-cur   =  - bf_tt-allsum.road-tax-base-cur
     3030       bfs_tt-allsum.road-tax-rubl-cur   =  - bf_tt-allsum.road-tax-rubl-cur
     3031       bfs_tt-allsum.excise-base-cur     =  - bf_tt-allsum.excise-base-cur
     3032       bfs_tt-allsum.excise-rubl-cur     =  - bf_tt-allsum.excise-rubl-cur
     3033       bfs_tt-allsum.sum-dsc-base-acc    =  - bf_tt-allsum.sum-dsc-base-acc
     3034       bfs_tt-allsum.sum-dsc-rubl-acc    =  - bf_tt-allsum.sum-dsc-rubl-acc
     3035       bfs_tt-allsum.sum-dsc-cli-acc     =  - bf_tt-allsum.sum-dsc-cli-acc
     3036       bfs_tt-allsum.dsc-base-acc        =  - bf_tt-allsum.dsc-base-acc
     3037       bfs_tt-allsum.dsc-rubl-acc        =  - bf_tt-allsum.dsc-rubl-acc
     3038       bfs_tt-allsum.dsc-cli-acc         =  - bf_tt-allsum.dsc-cli-acc
     3039       bfs_tt-allsum.vat-base-acc        =  - bf_tt-allsum.vat-base-acc
     3040       bfs_tt-allsum.vat-rubl-acc        =  - bf_tt-allsum.vat-rubl-acc
     3041       bfs_tt-allsum.vat-cli-acc         =  - bf_tt-allsum.vat-cli-acc
     3042       bfs_tt-allsum.slt-base-acc        =  - bf_tt-allsum.slt-base-acc
     3043       bfs_tt-allsum.slt-rubl-acc        =  - bf_tt-allsum.slt-rubl-acc
     3044       bfs_tt-allsum.slt-cli-acc         =  - bf_tt-allsum.slt-cli-acc
     3045       bfs_tt-allsum.road-tax-base-acc   =  - bf_tt-allsum.road-tax-base-acc
     3046       bfs_tt-allsum.road-tax-rubl-acc   =  - bf_tt-allsum.road-tax-rubl-acc
     3047       bfs_tt-allsum.road-tax-cli-acc    =  - bf_tt-allsum.road-tax-cli-acc
     3048       bfs_tt-allsum.excise-base-acc     =  - bf_tt-allsum.excise-base-acc
     3049       bfs_tt-allsum.excise-rubl-acc     =  - bf_tt-allsum.excise-rubl-acc
     3050       bfs_tt-allsum.excise-cli-acc      =  - bf_tt-allsum.excise-cli-acc
     3051       bfs_tt-allsum.transport-base-acc  =  - bf_tt-allsum.transport-base-acc
     3052       bfs_tt-allsum.transport-rubl-acc  =  - bf_tt-allsum.transport-rubl-acc
     3053       bfs_tt-allsum.transport-cli-acc   =  - bf_tt-allsum.transport-cli-acc
     3054       bfs_tt-allsum.other-base-acc      =  - bf_tt-allsum.other-base-acc
     3055       bfs_tt-allsum.other-rubl-acc      =  - bf_tt-allsum.other-rubl-acc
     3056       bfs_tt-allsum.other-cli-acc       =  - bf_tt-allsum.other-cli-acc.
     3057   end.
     3058   create bfpc_tt-allsum.
     3059   create bfspc_tt-allsum.
     3060   case cl_tt-clcparts.purch-code :
     3061   when 1           then do:
     3062     assign
     3063       bfpc_tt-allsum.sum-type  = 'сумма_по_выкупу':U
     3064       bfspc_tt-allsum.sum-type = 'сумма_по_выкупу_со_знаком':U.
     3065     buffer-copy bf_tt-allsum  except bf_tt-allsum.sum-type  to bfpc_tt-allsum.
     3066     buffer-copy bfs_tt-allsum except bfs_tt-allsum.sum-type to bfspc_tt-allsum.
     3067   end.
     3068   when 4    then do:
     3069     assign
     3070       bfpc_tt-allsum.sum-type  = 'сумма_по_старой_консигнации':U
     3071       bfspc_tt-allsum.sum-type = 'сумма_по_старой_консигнации_со_знаком':U.
     3072     buffer-copy bf_tt-allsum  except bf_tt-allsum.sum-type  to bfpc_tt-allsum.
     3073     buffer-copy bfs_tt-allsum except bfs_tt-allsum.sum-type to bfspc_tt-allsum.
     3074   end.
     3075   when 3 then do:
     3076     assign
     3077       bfpc_tt-allsum.sum-type  = 'сумма_по_ответственному_хранению':U
     3078       bfspc_tt-allsum.sum-type = 'сумма_по_ответственному_хранению_со_знаком':U.
     3079     buffer-copy bf_tt-allsum  except bf_tt-allsum.sum-type  to bfpc_tt-allsum.
     3080     buffer-copy bfs_tt-allsum except bfs_tt-allsum.sum-type to bfspc_tt-allsum.
     3081   end.
     3082   when 2 then do:
     3083     assign
     3084       bfpc_tt-allsum.sum-type  = 'сумма_по_консигнации_выгода':U
     3085       bfspc_tt-allsum.sum-type = 'сумма_по_консигнации_выгода_со_знаком':U.
     3086     assign
     3087       bfpc_tt-allsum.fact-qnty           = bf_tt-allsum.fact-qnty
     3088       bfpc_tt-allsum.cli-qnty            = bf_tt-allsum.cli-qnty
     3089       bfpc_tt-allsum.sum-dsc-base-doc    = bf_tt-allsum.sum-dsc-base-doc    - bf_tt-allsum.sum-dsc-base-acc
     3090       bfpc_tt-allsum.sum-dsc-rubl-doc    = bf_tt-allsum.sum-dsc-rubl-doc    - bf_tt-allsum.sum-dsc-rubl-acc
     3091       bfpc_tt-allsum.dsc-base-doc        = bf_tt-allsum.dsc-base-doc        - bf_tt-allsum.dsc-base-acc
     3092       bfpc_tt-allsum.dsc-rubl-doc        = bf_tt-allsum.dsc-rubl-doc        - bf_tt-allsum.dsc-rubl-acc
     3093       bfpc_tt-allsum.vat-base-doc        = bf_tt-allsum.vat-base-doc
     3094       bfpc_tt-allsum.vat-rubl-doc        = bf_tt-allsum.vat-rubl-doc
     3095       bfpc_tt-allsum.vat-base-buyer-doc  = bf_tt-allsum.vat-base-buyer-doc  - bf_tt-allsum.vat-base-acc
     3096       bfpc_tt-allsum.vat-rubl-buyer-doc  = bf_tt-allsum.vat-rubl-buyer-doc  - bf_tt-allsum.vat-rubl-acc
     3097       bfpc_tt-allsum.slt-base-doc        = bf_tt-allsum.slt-base-doc        - bf_tt-allsum.slt-base-acc
     3098       bfpc_tt-allsum.slt-rubl-doc        = bf_tt-allsum.slt-rubl-doc        - bf_tt-allsum.slt-rubl-acc
     3099       bfpc_tt-allsum.road-tax-base-doc   = bf_tt-allsum.road-tax-base-doc   - bf_tt-allsum.road-tax-base-acc
     3100       bfpc_tt-allsum.road-tax-rubl-doc   = bf_tt-allsum.road-tax-rubl-doc   - bf_tt-allsum.road-tax-rubl-acc
     3101       bfpc_tt-allsum.excise-base-doc     = bf_tt-allsum.excise-base-doc
     3102       bfpc_tt-allsum.excise-rubl-doc     = bf_tt-allsum.excise-rubl-doc
     3103       bfpc_tt-allsum.sum-dsc-base-cur    = bf_tt-allsum.sum-dsc-base-cur    - bf_tt-allsum.sum-dsc-base-acc
     3104       bfpc_tt-allsum.sum-dsc-rubl-cur    = bf_tt-allsum.sum-dsc-rubl-cur    - bf_tt-allsum.sum-dsc-rubl-acc
     3105       bfpc_tt-allsum.dsc-base-cur        = bf_tt-allsum.dsc-base-cur        - bf_tt-allsum.dsc-base-acc
     3106       bfpc_tt-allsum.dsc-rubl-cur        = bf_tt-allsum.dsc-rubl-cur        - bf_tt-allsum.dsc-rubl-acc
     3107       bfpc_tt-allsum.vat-base-cur        = bf_tt-allsum.vat-base-cur
     3108       bfpc_tt-allsum.vat-rubl-cur        = bf_tt-allsum.vat-rubl-cur
     3109       bfpc_tt-allsum.vat-base-buyer-cur  = bf_tt-allsum.vat-base-buyer-cur  - bf_tt-allsum.vat-base-acc
     3110       bfpc_tt-allsum.vat-rubl-buyer-cur  = bf_tt-allsum.vat-rubl-buyer-cur  - bf_tt-allsum.vat-rubl-acc
     3111       bfpc_tt-allsum.slt-base-cur        = bf_tt-allsum.slt-base-cur        - bf_tt-allsum.slt-base-acc
     3112       bfpc_tt-allsum.slt-rubl-cur        = bf_tt-allsum.slt-rubl-cur        - bf_tt-allsum.slt-rubl-acc
     3113       bfpc_tt-allsum.road-tax-base-cur   = bf_tt-allsum.road-tax-base-cur   - bf_tt-allsum.road-tax-base-acc
     3114       bfpc_tt-allsum.road-tax-rubl-cur   = bf_tt-allsum.road-tax-rubl-cur   - bf_tt-allsum.road-tax-rubl-acc
     3115       bfpc_tt-allsum.excise-base-cur     = bf_tt-allsum.excise-base-cur
     3116       bfpc_tt-allsum.excise-rubl-cur     = bf_tt-allsum.excise-rubl-cur
     3117       bfpc_tt-allsum.sum-dsc-base-acc    = 0
     3118       bfpc_tt-allsum.sum-dsc-rubl-acc    = 0
     3119       bfpc_tt-allsum.sum-dsc-cli-acc     = 0
     3120       bfpc_tt-allsum.dsc-base-acc        = 0
     3121       bfpc_tt-allsum.dsc-rubl-acc        = 0
