     5262     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
     5263     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
     5264     define input parameter p-fact-order         as decimal   no-undo .
     5265     define input parameter p-include-fact-order as logical   no-undo .
     5266     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
     5267     define buffer buf_gds-obj  for ub.gds-obj .
     5268     do
     5269     on error undo, return error
     5270     :
     5271       do transaction
     5272       on error undo, return error
     5273       :
     5274   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5275   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     5276     (input  p-obj-type
     5277     ,input  p-obj-code
     5278     ,input  p-artic
     5279     ,input  p-prod-type
     5280     ,input  p-prod-code
     5281     ,buffer buf_gds-obj
     5282     ) no-error .
     5283         if error-status :error
     5284         then do:
     5285           message
     5286             vss-workfile vss-revision vss-description skip
     5287             vss-include-info34 skip
     5288             "Невозможно найти товар на объекте" skip
     5289             "Объект" p-obj-type p-obj-code skip
     5290             "Артикул" p-artic p-prod-type p-prod-code skip
     5291             error-status :get-message(1) skip
     5292             return-value skip
     5293             view-as alert-box error .
     5294           undo, return error .
     5295         end.
     5296         find current buf_gds-obj exclusive-lock .
     5297       end.
     5298       run partslib-init-temp-parts in this-procedure
     5299         (input p-obj-type
     5300         ,input p-obj-code
     5301         ,input p-artic
     5302         ,input p-prod-type
     5303         ,input p-prod-code
     5304         ) no-error .
     5305       if error-status :error
     5306       then do:
     5307         message
     5308           vss-workfile vss-revision vss-description skip
     5309           vss-include-info34 skip
     5310           "Ошибка при инициализации текущего остатка по партиям свободной зоны" skip
     5311           "Объект" p-obj-type p-obj-code skip
     5312           "Артикул" p-artic p-prod-type p-prod-code skip
     5313           "p-fact-order" p-fact-order skip
     5314           view-as alert-box error .
     5315         undo, return error .
     5316       end.
     5317       if p-include-fact-order = true
     5318       then do:
     5319         assign
     5320           p-fact-order = p-fact-order - 0.0000000001
     5321         .
     5322       end.
     5323       define variable v-max-fact-order as character no-undo .
     5324       run factord-max-fact-order in this-procedure
     5325         (output v-max-fact-order
     5326         ) no-error .
     5327       if error-status :error
     5328       then do:
     5329         message
     5330           vss-workfile vss-revision vss-description skip
     5331           vss-include-info34 skip
     5332           "Ошибка при вызове процедуры factord-max-fact-order" skip
     5333           "Объект" p-obj-type p-obj-code skip
     5334           "Артикул" p-artic p-prod-type p-prod-code skip
     5335           "p-fact-order" p-fact-order skip
     5336           view-as alert-box error .
     5337         undo, return error .
     5338       end.
     5339       run partslib-update-by-factord in this-procedure
     5340         (input p-obj-type
     5341         ,input p-obj-code
     5342         ,input p-artic
     5343         ,input p-prod-type
     5344         ,input p-prod-code
     5345         ,input p-fact-order
     5346         ,input v-max-fact-order
     5347         ,input false
     5348         ) no-error .
     5349       if error-status :error
     5350       then do:
     5351         message
     5352           vss-workfile vss-revision vss-description skip
     5353           vss-include-info34 skip
     5354           "Ошибка при вызове процедуры partslib-update-by-factord" skip
     5355           "Объект" p-obj-type p-obj-code skip
     5356           "Артикул" p-artic p-prod-type p-prod-code skip
     5357           "p-fact-order" p-fact-order skip
     5358           "v-max-fact-order" v-max-fact-order skip
     5359           view-as alert-box error .
     5360         undo, return error .
     5361       end.
     5362     end.
     5363   end procedure.
     5364   procedure partslib-update-by-factord :
     5365     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
     5366     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
     5367     define input parameter p-artic              like ub.parts.artic     no-undo .
     5368     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
     5369     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
     5370     define input parameter p-start-fact-order   as decimal   no-undo .
     5371     define input parameter p-end-fact-order     as decimal   no-undo .
     5372     define input parameter p-lock-gds-obj       as logical   no-undo .
     5373     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
     5374     define buffer buf_gds-obj  for ub.gds-obj .
     5375     define buffer buf_doc-line for ub.doc-line .
     5376     define variable v-total-parts-qnty as decimal   no-undo .
     5377     define variable v-goods-gds-goods  as logical   no-undo .
     5378     define variable v-goods-twounit    as logical   no-undo .
     5379     do
     5380     on error undo, return error
     5381     :
     5382       if p-start-fact-order > p-end-fact-order
     5383       then do:
     5384         message
     5385           vss-workfile vss-revision vss-description skip
     5386           vss-include-info34 skip
     5387           "Ошибка задания входных параметров" skip
     5388           "Начало интервала превышает конец интервала" skip
     5389           "Объект" p-obj-type p-obj-code skip
     5390           "Артикул" p-artic p-prod-type p-prod-code skip
     5391           "p-start-fact-order" p-start-fact-order skip
     5392           "p-end-fact-order"   p-end-fact-order skip
     5393           view-as alert-box error .
     5394         undo, return error .
     5395       end.
     5396       if p-lock-gds-obj = true
     5397       then do:
     5398         do transaction
     5399         on error undo, return error
     5400         :
     5401   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5402   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     5403     (input  p-obj-type
     5404     ,input  p-obj-code
     5405     ,input  p-artic
     5406     ,input  p-prod-type
     5407     ,input  p-prod-code
     5408     ,buffer buf_gds-obj
     5409     ) no-error .
     5410           if error-status :error
     5411           then do:
     5412             message
     5413               vss-workfile vss-revision vss-description skip
     5414               vss-include-info34 skip
     5415               "Невозможно найти gds-obj" skip
     5416               error-status :get-message(1) skip
     5417               return-value skip
     5418               view-as alert-box error .
     5419             undo, return error .
     5420           end.
     5421           find current buf_gds-obj exclusive-lock .
     5422         end.
     5423       end.
     5424   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5425   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     5426     (input  p-artic
     5427     ,input  p-prod-type
     5428     ,input  p-prod-code
     5429     ,input  'gds-goods=request':u
     5430     ,output v-goods-gds-goods
     5431     ) no-error .
     5432       if error-status :error
     5433       then do:
     5434         message
     5435           vss-workfile vss-revision vss-description skip
     5436           vss-include-info34 skip
     5437           "Ошибка при определении атрибута товара" skip
     5438           "Артикул" p-artic p-prod-type p-prod-code skip
     5439           "gds-goods=request" skip
     5440           error-status :get-message(1) skip
     5441           return-value skip
     5442           view-as alert-box error .
     5443         undo, return error return-value .
     5444       end.
     5445   define variable vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5446   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     5447     (input  p-artic
     5448     ,input  p-prod-type
     5449     ,input  p-prod-code
     5450     ,input  'twounit=request':u
     5451     ,output v-goods-twounit
     5452     ) no-error .
     5453       if error-status :error
     5454       then do:
     5455         message
     5456           vss-workfile vss-revision vss-description skip
     5457           vss-include-info34 skip
     5458           "Ошибка при определении атрибута товара" skip
     5459           "Артикул" p-artic p-prod-type p-prod-code skip
     5460           "twounit=request" skip
     5461           error-status :get-message(1) skip
     5462           return-value skip
     5463           view-as alert-box error .
     5464         undo, return error return-value .
     5465       end.
     5466       for each buf_doc-line no-lock
     5467         where buf_doc-line.obj-type   = p-obj-type
     5468           and buf_doc-line.obj-code   = p-obj-code
     5469           and buf_doc-line.artic      = p-artic
     5470           and buf_doc-line.prod-type  = p-prod-type
     5471           and buf_doc-line.prod-code  = p-prod-code
     5472           and buf_doc-line.status_    = 'факт':U
     5473           and buf_doc-line.fact-order > p-start-fact-order
     5474           and buf_doc-line.fact-order <= p-end-fact-order
     5475       on error undo, return error
     5476       :
     5477         run partslib-process-document in this-procedure
     5478           (input  buf_doc-line.doc-code
     5479           ,input  p-obj-type
     5480           ,input  p-obj-code
     5481           ,input  p-artic
     5482           ,input  p-prod-type
     5483           ,input  p-prod-code
     5484           ,input  v-goods-gds-goods
     5485           ,input  v-goods-twounit
     5486           ,output v-total-parts-qnty
     5487           ) no-error .
     5488         if error-status :error
     5489         then do:
     5490           message
     5491             vss-workfile vss-revision vss-description skip
     5492             vss-include-info34 skip
     5493             "Ошибка при вызове процедуры partslib-process-document" skip
     5494             "Документ" buf_doc-line.doc-code skip
     5495             "Объект" p-obj-type p-obj-code skip
     5496             "Артикул" p-artic p-prod-type p-prod-code skip
     5497             "p-start-fact-order" p-start-fact-order skip
     5498             "p-end-fact-order" p-end-fact-order skip
     5499             error-status :get-message(1) skip
     5500             return-value skip
     5501             view-as alert-box error .
     5502           undo, return error return-value .
     5503         end.
     5504       end.
     5505     end.
     5506   end procedure.
     5507   procedure partslib-process-document :
     5508     define input  parameter p-doc-code         as character no-undo .
     5509     define input  parameter p-obj-type         as character no-undo .
     5510     define input  parameter p-obj-code         as integer   no-undo .
     5511     define input  parameter p-artic            as character no-undo .
     5512     define input  parameter p-prod-type        as character no-undo .
     5513     define input  parameter p-prod-code        as integer   no-undo .
     5514     define input  parameter p-goods-gds-goods  as logical   no-undo .
     5515     define input  parameter p-goods-twounit    as logical   no-undo .
     5516     define output parameter p-total-parts-qnty as decimal   no-undo .
     5517     define variable v-parts-sign as integer   no-undo .
     5518     define buffer buf_trn-doc    for ub.trn-doc .
     5519     define buffer buf_doc-line   for ub.doc-line .
     5520     define buffer buf_parts      for ub.parts .
     5521     define buffer buf_temp-parts for temp-parts .
     5522     do
     5523     on error undo, return error return-value
     5524     :
     5525       find first buf_trn-doc no-lock
     5526         where buf_trn-doc.doc-code = p-doc-code
     5527         no-error .
     5528       if not available buf_trn-doc
     5529       then do:
     5530         undo, return error substitute("Ошибка при поиске документа. Документ &1"
     5531                                      ,p-doc-code
     5532                                      ) .
     5533       end.
     5534       case buf_trn-doc.doc-type
     5535       :
     5536         when 'при':U or
     5537         when 'возврат':U or
     5538         when 'инв':U
     5539         then do:
     5540           assign
     5541             v-parts-sign = -1
     5542           .
     5543         end.
     5544         when 'рас':U or
     5545         when 'спи':U
     5546         then do:
     5547           assign
     5548             v-parts-sign = 1
     5549           .
     5550         end.
     5551         otherwise do:
     5552           undo, return error substitute("Неизвестный тип документа &1"
     5553                                       ,buf_trn-doc.doc-type
     5554                                       ) .
     5555         end.
     5556       end.
     5557       find first buf_doc-line no-lock
     5558         where buf_doc-line.doc-code  = p-doc-code
     5559           and buf_doc-line.artic     = p-artic
     5560           and buf_doc-line.prod-type = p-prod-type
     5561           and buf_doc-line.prod-code = p-prod-code
     5562         no-error .
     5563       if not available buf_doc-line
     5564       then do:
     5565         undo, return error substitute("Ошибка при поиске строки документа. Документ &1. Артикул &2 &3 &4"
     5566                                      ,p-doc-code
     5567                                      ,artic
     5568                                      ,prod-type
     5569                                      ,prod-code
     5570                                      ) .
     5571       end.
     5572       assign
     5573         p-total-parts-qnty = 0
     5574       .
     5575       if p-goods-gds-goods = true
     5576       then do:
     5577         for each buf_parts no-lock
     5578           where buf_parts.out-code  = p-doc-code
     5579             and buf_parts.obj-type  = p-obj-type
     5580             and buf_parts.obj-code  = p-obj-code
     5581             and buf_parts.artic     = p-artic
     5582             and buf_parts.prod-type = p-prod-type
     5583             and buf_parts.prod-code = p-prod-code
     5584         on error undo, return error
     5585         :
     5586           run partslib-create-temp-parts in this-procedure
     5587             (buffer buf_parts
     5588             ,buffer buf_temp-parts
     5589             ,input  p-goods-twounit
     5590             ) .
     5591           assign
     5592             p-total-parts-qnty        = p-total-parts-qnty
     5593                                       + v-parts-sign * buf_parts.fact-qnty
     5594             buf_temp-parts.qnty       = buf_temp-parts.qnty
     5595                                       + v-parts-sign * buf_parts.fact-qnty
     5596             buf_temp-parts.fact-qnty  = buf_temp-parts.fact-qnty
     5597                                       + v-parts-sign * buf_parts.fact-qnty
     5598             buf_temp-parts.cli-qnty   = buf_temp-parts.cli-qnty
     5599                                       + v-parts-sign * buf_parts.cli-qnty
     5600           .
     5601           if buf_temp-parts.qnty = 0
     5602           then do:
     5603             delete buf_temp-parts .
     5604           end.
     5605         end.
     5606       end.
     5607       else do:
     5608         assign
     5609           p-total-parts-qnty = p-total-parts-qnty
     5610                              + v-parts-sign * buf_doc-line.fact-qnty
     5611         .
     5612       end.
     5613     end.
     5614   end procedure.
     5615   procedure partslib-init-temp-parts-by-date :
     5616     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
     5617     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
     5618     define input parameter p-artic           like ub.parts.artic     no-undo .
     5619     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
     5620     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
     5621     define input parameter p-fact-date       as date      no-undo .
     5622     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-date: определение партий свободной зоны на любую дату".
     5623     do
     5624     on error undo, return error
     5625     :
     5626       define variable v-fact-order                as decimal   no-undo .
     5627       define variable v-shift-end-fact-order      as decimal   no-undo .
     5628       define variable v-day-end-fact-order        as decimal   no-undo .
     5629       run factord in this-procedure
     5630         (input  p-fact-date
     5631         ,input  1
     5632         ,input  1
     5633         ,input  ?
     5634         ,input  0
     5635         ,input  false
     5636         ,output v-fact-order
     5637         ,output v-shift-end-fact-order
     5638         ,output v-day-end-fact-order
     5639         ) no-error .
     5640       if error-status :error
     5641       then do:
     5642         message
     5643           vss-workfile vss-revision vss-description skip
     5644           vss-include-info34 skip
     5645           "Ошибка при определении момента времени, на который требуется остаток" skip
     5646           "Объект" p-obj-type p-obj-code skip
     5647           "Артикул" p-artic p-prod-type p-prod-code skip
     5648           "Дата" p-fact-date skip
     5649           view-as alert-box error .
     5650         undo, return error .
     5651       end.
     5652       run partslib-init-temp-parts-by-factord in this-procedure
     5653         (input p-obj-type
     5654         ,input p-obj-code
     5655         ,input p-artic
     5656         ,input p-prod-type
     5657         ,input p-prod-code
     5658         ,input v-day-end-fact-order
     5659         ,input false
     5660         ) no-error .
     5661       if error-status :error
     5662       then do:
     5663         message
     5664           vss-workfile vss-revision vss-description skip
     5665           vss-include-info34 skip
     5666           "Ошибка при вызове метода partslib-init-temp-parts-by-factord" skip
     5667           "Объект" p-obj-type p-obj-code skip
     5668           "Артикул" p-artic p-prod-type p-prod-code skip
     5669           "Дата" p-fact-date skip
     5670           view-as alert-box error .
     5671         undo, return error .
     5672       end.
     5673     end.
     5674   end procedure.
     5675   procedure partslib-calc-cost :
     5676     define output parameter p-fact-qnty      as decimal   no-undo .
     5677     define output parameter p-vat-pc         as decimal   no-undo .
     5678     define output parameter p-slt-pc         as decimal   no-undo .
     5679     define output parameter p-sum-base       as decimal   no-undo .
     5680     define output parameter p-sum-rubl       as decimal   no-undo .
     5681     define output parameter p-vat-base       as decimal   no-undo .
     5682     define output parameter p-vat-rubl       as decimal   no-undo .
     5683     define output parameter p-slt-base       as decimal   no-undo .
     5684     define output parameter p-slt-rubl       as decimal   no-undo .
     5685     define output parameter p-road-tax-base  as decimal   no-undo .
     5686     define output parameter p-road-tax-rubl  as decimal   no-undo .
     5687     define output parameter p-transport-base as decimal   no-undo .
     5688     define output parameter p-transport-rubl as decimal   no-undo .
     5689     define output parameter p-other-base     as decimal   no-undo .
     5690     define output parameter p-other-rubl     as decimal   no-undo .
     5691     define output parameter p-excise-base    as decimal   no-undo .
     5692     define output parameter p-excise-rubl    as decimal   no-undo .
     5693     define variable vss-description as character no-undo init "partslib-calc-cost: расчет сумм в учетных ценах".
     5694     do
     5695     on error undo, return error return-value
     5696     :
     5697       define buffer buf_temp-parts for temp-parts .
     5698       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     5699       define buffer   in-vatp-parts    for ub.parts   .
     5700       define buffer   in-vatp-doc      for ub.trn-doc .
     5701       define buffer   in-vatp-goods    for ub.goods   .
     5702       define buffer   in-vatp-sysconf  for ub.sysconf .
     5703       define buffer   in-vatp_doc-attr for ub.doc-attr.
     5704       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     5705       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     5706       define variable varinvprb                  as   character              no-undo.
     5707       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     5708       define variable cli-base-rate              as   decimal                no-undo.
     5709       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     5710       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     5711       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     5712       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     5713       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     5714       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     5715       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     5716       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     5717       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     5718       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     5719       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     5720       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     5721       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     5722       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     5723       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     5724       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     5725       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     5726       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     5727       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     5728       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     5729       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     5730       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     5731       define variable varinvatp-envd             as   character              no-undo.
     5732       define variable varinvatp-type             as   character              no-undo.
     5733       for each buf_temp-parts
     5734       on error undo, return error
     5735       :
     5736   assign
     5737     price-rubl-with-tax-loc = buf_temp-parts.price-rubl
     5738     price-base-with-tax-loc = buf_temp-parts.price-base
     5739   .
     5740   define variable vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     5741   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     5742     (output varinvprb
     5743     )  .
     5744     if buf_temp-parts.out-code = 'free-zone':U     or
     5745        buf_temp-parts.out-code = 'out-zone':U   or
     5746        buf_temp-parts.doc-type = 'акт':U then do:
     5747       assign
     5748         in-vatp-have-vat-slt = yes.
     5749     end.
     5750     else do:
     5751       find first in-vatp_doc-attr no-lock
     5752         where in-vatp_doc-attr.doc-code  = buf_temp-parts.out-code
     5753           and in-vatp_doc-attr.attr-code = 'envd':U
     5754         no-error .
     5755       if not available in-vatp_doc-attr then do:
     5756         assign
     5757           in-vatp-have-vat-slt = yes.
     5758       end.
     5759       else do:
     5760            in-vatp-have-vat-slt = no.
     5761       end.
     5762     end.
     5763     assign
     5764      price-cli-with-tax-loc = buf_temp-parts.price-cli
     5765      cli-base-rate          = buf_temp-parts.cli-base-rate.
     5766     ASSIGN   road-tax-base-loc  = (if buf_temp-parts.road-tax-base  = ? then 0 else buf_temp-parts.road-tax-base)
     5767              road-tax-rubl-loc  = (if buf_temp-parts.road-tax-rubl  = ? then 0 else buf_temp-parts.road-tax-rubl).
     5768     ASSIGN  transport-base-loc = (if buf_temp-parts.transport-base = ? then 0 else buf_temp-parts.transport-base)
     5769             transport-rubl-loc = (if buf_temp-parts.transport-rubl = ? then 0 else buf_temp-parts.transport-rubl)
     5770             other-base-loc     = (if buf_temp-parts.other-base     = ? then 0 else buf_temp-parts.other-base)
     5771             other-rubl-loc     = (if buf_temp-parts.other-rubl     = ? then 0 else buf_temp-parts.other-rubl)
     5772             vat-pc-loc         = (if buf_temp-parts.vat-pc         = ? then 0 else buf_temp-parts.vat-pc)
     5773             slt-pc-loc         = (if buf_temp-parts.slt-pc         = ? then 0 else buf_temp-parts.slt-pc).
     5774             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     5775       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     5776     assign
     5777       exch-rate-cli-loc = (buf_temp-parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_temp-parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_temp-parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_temp-parts.price-cli .
     5778     assign
     5779       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     5780       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     5781       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     5782       transport-cli-loc  = 0
     5783       other-cli-loc      = 0
     5784     .
     5785   ASSIGN
     5786             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     5787       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     5788   .
     5789         assign
     5790           p-fact-qnty      = p-fact-qnty      + buf_temp-parts.fact-qnty
     5791           p-vat-pc         = p-vat-pc         + vat-pc-loc
     5792           p-slt-pc         = p-slt-pc         + slt-pc-loc
     5793           p-sum-base       = p-sum-base       + price-base-with-tax-loc * buf_temp-parts.fact-qnty
     5794           p-sum-rubl       = p-sum-rubl       + price-rubl-with-tax-loc * buf_temp-parts.fact-qnty
     5795           p-vat-base       = p-vat-base       + vat-base-loc            * buf_temp-parts.fact-qnty
     5796           p-vat-rubl       = p-vat-rubl       + vat-rubl-loc            * buf_temp-parts.fact-qnty
     5797           p-slt-base       = p-slt-base       + slt-base-loc            * buf_temp-parts.fact-qnty
     5798           p-slt-rubl       = p-slt-rubl       + slt-rubl-loc            * buf_temp-parts.fact-qnty
     5799           p-road-tax-base  = p-road-tax-base  + road-tax-base-loc       * buf_temp-parts.fact-qnty
     5800           p-road-tax-rubl  = p-road-tax-rubl  + road-tax-rubl-loc       * buf_temp-parts.fact-qnty
     5801           p-transport-base = p-transport-base + transport-base-loc      * buf_temp-parts.fact-qnty
     5802           p-transport-rubl = p-transport-rubl + transport-rubl-loc      * buf_temp-parts.fact-qnty
     5803           p-other-base     = p-other-base     + other-base-loc          * buf_temp-parts.fact-qnty
     5804           p-other-rubl     = p-other-rubl     + other-rubl-loc          * buf_temp-parts.fact-qnty
     5805           p-excise-base    = p-excise-base    + 0
     5806           p-excise-rubl    = p-excise-rubl    + 0
     5807         .
     5808       end.
     5809       if p-fact-qnty      = ?
     5810       or p-sum-base       = ?
     5811       or p-sum-rubl       = ?
     5812       or p-vat-base       = ?
     5813       or p-vat-rubl       = ?
     5814       or p-slt-base       = ?
     5815       or p-slt-rubl       = ?
     5816       or p-road-tax-base  = ?
     5817       or p-road-tax-rubl  = ?
     5818       or p-transport-base = ?
     5819       or p-transport-rubl = ?
     5820       or p-other-base     = ?
     5821       or p-other-rubl     = ?
     5822       or p-excise-base    = ?
     5823       or p-excise-rubl    = ?
     5824       then do:
     5825         message
     5826           vss-workfile vss-revision vss-description skip
     5827           vss-include-info34 skip
     5828           "Программа in-vatp.i вернула неопределенные значения" skip
     5829           "p-fact-qnty"      p-fact-qnty      skip
     5830           "p-sum-base"       p-sum-base       skip
     5831           "p-sum-rubl"       p-sum-rubl       skip
     5832           "p-vat-base"       p-vat-base       skip
     5833           "p-vat-rubl"       p-vat-rubl       skip
     5834           "p-slt-base"       p-slt-base       skip
     5835           "p-slt-rubl"       p-slt-rubl       skip
     5836           "p-road-tax-base"  p-road-tax-base  skip
     5837           "p-road-tax-rubl"  p-road-tax-rubl  skip
     5838           "p-transport-base" p-transport-base skip
     5839           "p-transport-rubl" p-transport-rubl skip
     5840           "p-other-base"     p-other-base     skip
     5841           "p-other-rubl"     p-other-rubl     skip
     5842           "p-excise-base"    p-excise-base    skip
     5843           "p-excise-rubl"    p-excise-rubl    skip
     5844           view-as alert-box error .
     5845         undo, return error .
     5846       end.
     5847     end.
     5848   end procedure.
     5849   define variable vss-include-info41 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5850   procedure gds-attr-name :
     5851     define input  parameter p-code           as character no-undo .
     5852     define output parameter p-type           as character no-undo .
     5853     define output parameter p-format         as character no-undo .
     5854     define output parameter p-label          as character no-undo .
     5855     define output parameter p-user-can-edit  as logical   no-undo .
     5856     define output parameter p-output-display as logical   no-undo .
     5857     define output parameter p-other          as character no-undo .
     5858     do
     5859     on error undo, return error
     5860     :
     5861           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-name in g#attr-lib
     5862         (input  p-code
     5863         ,output p-type
     5864         ,output p-format
     5865         ,output p-label
     5866         ,output p-user-can-edit
     5867         ,output p-output-display
     5868         ,output p-other
     5869         ) no-error .
     5870       if error-status :error
     5871       then do:
     5872         undo, return error return-value .
     5873       end.
     5874     end.
