     4950   procedure lineattr-write-add-line-cli :
     4951   define input  parameter p-doc-code      like  ub.doc-line-attr.doc-code   no-undo .
     4952   define input  parameter p-gds-code      like  ub.doc-line-attr.gds-code   no-undo .
     4953   define input  parameter p-cli-type      as character no-undo .
     4954   define input  parameter p-cli-code      as integer   no-undo .
     4955   define input  parameter p-contract-code as integer   no-undo .
     4956   define input  parameter p-host-code     as integer   no-undo .
     4957   define input  parameter p-exch-code     as integer   no-undo .
     4958   define input  parameter p-exch-rate     as decimal   no-undo .
     4959   define input  parameter p-exch-scale    as integer   no-undo .
     4960   define input  parameter p-sum-cli       as decimal   no-undo .
     4961   define input  parameter p-sum-vat       as decimal   no-undo .
     4962   define buffer buf_doc-line-attr for ub.doc-line-attr .
     4963     do
     4964     on error undo, return error return-value
     4965     :
     4966       find first buf_doc-line-attr exclusive-lock
     4967         where buf_doc-line-attr.doc-code  = p-doc-code
     4968           and buf_doc-line-attr.gds-code  = p-gds-code
     4969           and buf_doc-line-attr.attr-code = 'add-line-cli':U +
     4970                                             chr(4) + p-cli-type +
     4971                                             chr(4) + string(p-cli-code) +
     4972                                             chr(4) + string(p-contract-code) +
     4973                                             chr(4) + string(p-host-code)
     4974         no-error .
     4975       if not available buf_doc-line-attr then do:
     4976         create buf_doc-line-attr .
     4977         assign
     4978           buf_doc-line-attr.doc-code  = p-doc-code
     4979           buf_doc-line-attr.gds-code  = p-gds-code
     4980           buf_doc-line-attr.attr-code = 'add-line-cli':U  +
     4981                                         chr(4) + p-cli-type +
     4982                                         chr(4) + string(p-cli-code) +
     4983                                         chr(4) + string(p-contract-code) +
     4984                                         chr(4) + string(p-host-code)
     4985         .
     4986       end.
     4987       assign
     4988         buf_doc-line-attr.attr-value =
     4989         string(p-exch-code)  + chr(4) +
     4990         string(p-exch-rate)  + chr(4) +
     4991         string(p-exch-scale) + chr(4) +
     4992         string(p-sum-cli)    + chr(4) +
     4993         string(p-sum-vat)
     4994         .
     4995     end.
     4996   end procedure.
     4997   procedure lineattr-value-add-line-cli :
     4998   define input   parameter p-doc-code      like  ub.doc-line-attr.doc-code   no-undo .
     4999   define input   parameter p-gds-code      like  ub.doc-line-attr.gds-code   no-undo .
     5000   define input   parameter p-cli-type      as character no-undo .
     5001   define input   parameter p-cli-code      as integer   no-undo .
     5002   define input   parameter p-contract-code as integer   no-undo .
     5003   define input   parameter p-host-code     as integer   no-undo .
     5004   define output  parameter p-exch-code     as integer   no-undo .
     5005   define output  parameter p-exch-rate     as decimal   no-undo .
     5006   define output  parameter p-exch-scale    as integer   no-undo .
     5007   define output  parameter p-sum-cli       as decimal   no-undo .
     5008   define output  parameter p-sum-vat       as decimal   no-undo .
     5009   define buffer buf_doc-line-attr for ub.doc-line-attr .
     5010     do
     5011     on error undo, return error return-value
     5012     :
     5013       find first buf_doc-line-attr exclusive-lock
     5014         where buf_doc-line-attr.doc-code  = p-doc-code
     5015           and buf_doc-line-attr.gds-code  = p-gds-code
     5016           and buf_doc-line-attr.attr-code = 'add-line-cli':U +
     5017                                             chr(4) + p-cli-type +
     5018                                             chr(4) + string(p-cli-code) +
     5019                                             chr(4) + string(p-contract-code) +
     5020                                             chr(4) + string(p-host-code)
     5021         no-error .
     5022       if available buf_doc-line-attr then do:
     5023        assign
     5024           p-exch-code  = integer ( entry (1 , buf_doc-line-attr.attr-value,  chr(4) ))
     5025           p-exch-rate  = decimal ( entry (2 , buf_doc-line-attr.attr-value, chr(4) ))
     5026           p-exch-scale = integer ( entry (3 , buf_doc-line-attr.attr-value, chr(4) ))
     5027           p-sum-cli    = decimal ( entry (4 , buf_doc-line-attr.attr-value, chr(4) ))
     5028           p-sum-vat    = decimal ( entry (5 , buf_doc-line-attr.attr-value, chr(4) ))
     5029          .
     5030        end.
     5031     end.
     5032   end procedure.
     5033   function lineattr-get-reason returns character ( buffer local-doc-line for ub.doc-line ) :
     5034     define variable v-code as character no-undo .
     5035     define variable v-type as character no-undo .
     5036     define variable v-gds-code as integer   no-undo .
     5037   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5038   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     5039     (input  local-doc-line.artic
     5040     ,input  local-doc-line.prod-type
     5041     ,input  local-doc-line.prod-code
     5042     ,output v-gds-code
     5043     )  .
     5044     run lineattr-value (
     5045         input   local-doc-line.doc-code ,
     5046         input   v-gds-code              ,
     5047         input   'reason-code':U ,
     5048         output  v-code                  ,
     5049         output  v-type ) .
     5050     find first ub.trn-reason no-lock where
     5051                ub.trn-reason.reason-code = integer ( v-code ) no-error.
     5052     if not available ub.trn-reason then do:
     5053        return "" .
     5054     end.
     5055     else do:
     5056        return ub.trn-reason.reason-name .
     5057     end.
     5058   end function.
     5059   procedure lineattr-value-parts :
     5060     do
     5061     on error undo, return error return-value
     5062     :
     5063       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
     5064       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
     5065       define input  parameter p-part-code   as character no-undo .
     5066       define input  parameter p_in-code     as character no-undo .
     5067       define input  parameter p-code        like  ub.doc-line-attr.attr-code  no-undo .
     5068       define output parameter p-value       as    decimal   no-undo .
     5069       define buffer buf_doc-line-attr for ub.doc-line-attr .
     5070       find first buf_doc-line-attr no-lock
     5071         where buf_doc-line-attr.doc-code  = p-doc-code
     5072           and buf_doc-line-attr.gds-code  = p-gds-code
     5073           and buf_doc-line-attr.attr-code = p-code  + chr(4) + trim(p-part-code)  + chr(4) + trim(p_in-code)
     5074         no-error .
     5075       if avail buf_doc-line-attr then do:
     5076         assign
     5077           p-value = decimal( buf_doc-line-attr.attr-value)
     5078         .
     5079       end.
     5080       else do:
     5081         assign
     5082           p-value = 0
     5083         .
     5084       end.
     5085     end.
     5086   end procedure.
     5087   procedure lineattr-write-parts :
     5088     do
     5089     on error undo, return error return-value
     5090     :
     5091       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     5092       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     5093       define input parameter p-part-code  as character no-undo .
     5094       define input parameter p_in-code    as character no-undo .
     5095       define input parameter p-code       like ub.doc-line-attr.attr-code  no-undo .
     5096       define input parameter p-value      as decimal   no-undo .
     5097       define buffer buf_doc-line-attr for ub.doc-line-attr .
     5098       find first buf_doc-line-attr exclusive-lock
     5099         where buf_doc-line-attr.doc-code  = p-doc-code
     5100           and buf_doc-line-attr.gds-code  = p-gds-code
     5101           and buf_doc-line-attr.attr-code = p-code + chr(4)  + trim(p-part-code)  + chr(4) + trim(p_in-code)
     5102         no-error .
     5103       if not available buf_doc-line-attr then do:
     5104         create buf_doc-line-attr .
     5105         assign
     5106           buf_doc-line-attr.doc-code  = p-doc-code
     5107           buf_doc-line-attr.gds-code  = p-gds-code
     5108           buf_doc-line-attr.attr-code = p-code  + chr(4)  + trim(p-part-code)  + chr(4) + trim(p_in-code)
     5109         .
     5110       end.
     5111       assign
     5112         buf_doc-line-attr.attr-value = string( p-value )
     5113       .
     5114     end.
     5115   end procedure.
     5116   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5117   define temp-table temp-parts no-undo   like ub.parts   field free-qnty as decimal   field free-cli-qnty as decimal .
     5118   procedure partslib-clear-temp-parts :
     5119     define buffer buf_temp-parts for temp-parts .
     5120     do
     5121     on error undo, return error
     5122     :
     5123       for each buf_temp-parts
     5124       on error undo, return error
     5125       :
     5126         delete buf_temp-parts .
     5127       end.
     5128     end.
     5129   end procedure.
     5130   procedure partslib-create-temp-parts :
     5131     define parameter buffer buf_parts       for ub.parts .
     5132     define parameter buffer buf_temp-parts  for temp-parts .
     5133     define input  parameter p-goods-twounit as logical   no-undo .
     5134     define variable v-base-part-code as character no-undo .
     5135     do
     5136     on error undo, return error
     5137     :
     5138       if p-goods-twounit = true
     5139       then do:
     5140         assign
     5141           v-base-part-code = entry(1, buf_parts.part-code, '#':U)
     5142         .
     5143       end.
     5144       else do:
     5145         assign
     5146           v-base-part-code = buf_parts.part-code
     5147         .
     5148       end.
     5149       find first buf_temp-parts exclusive-lock
     5150         where buf_temp-parts.obj-type  = buf_parts.obj-type
     5151           and buf_temp-parts.obj-code  = buf_parts.obj-code
     5152           and buf_temp-parts.artic     = buf_parts.artic
     5153           and buf_temp-parts.prod-type = buf_parts.prod-type
     5154           and buf_temp-parts.prod-code = buf_parts.prod-code
     5155           and buf_temp-parts.in-code   = buf_parts.in-code
     5156           and buf_temp-parts.out-code  = 'free-zone':U
     5157           and buf_temp-parts.part-code = v-base-part-code
     5158         no-error.
     5159       if not available buf_temp-parts
     5160       then do:
     5161         create buf_temp-parts .
     5162         buffer-copy buf_parts to buf_temp-parts
     5163         assign
     5164           buf_temp-parts.out-code  = 'free-zone':U
     5165           buf_temp-parts.part-code = v-base-part-code
     5166           buf_temp-parts.rsrv-free = yes
     5167           buf_temp-parts.status_   = no
     5168           buf_temp-parts.qnty      = 0
     5169           buf_temp-parts.fact-qnty = 0
     5170           buf_temp-parts.real-qnty = 0
     5171           buf_temp-parts.cli-qnty  = 0
     5172         .
     5173       end.
     5174     end.
     5175   end procedure.
     5176   procedure partslib-init-temp-parts :
     5177     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
     5178     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
     5179     define input parameter p-artic           like ub.parts.artic     no-undo .
     5180     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
     5181     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
     5182     define buffer buf_parts      for ub.parts .
     5183     define buffer buf_temp-parts for temp-parts .
     5184     define variable v-goods-twounit    as logical   no-undo .
     5185     do
     5186     on error undo, return error
     5187     :
     5188   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5189   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     5190     (input  p-artic
     5191     ,input  p-prod-type
     5192     ,input  p-prod-code
     5193     ,input  'twounit=request':u
     5194     ,output v-goods-twounit
     5195     ) no-error .
     5196       if error-status :error
     5197       then do:
     5198         message
     5199           vss-workfile vss-revision vss-description skip
     5200           vss-include-info34 skip
     5201           "Ошибка при определении атрибута товара" skip
     5202           "Артикул" p-artic p-prod-type p-prod-code skip
     5203           "twounit=request" skip
     5204           error-status :get-message(1) skip
     5205           return-value skip
     5206           view-as alert-box error .
     5207         undo, return error return-value .
     5208       end.
     5209       run partslib-clear-temp-parts in this-procedure .
     5210       for each buf_parts
     5211         where buf_parts.obj-type  = p-obj-type
     5212           and buf_parts.obj-code  = p-obj-code
     5213           and buf_parts.artic     = p-artic
     5214           and buf_parts.prod-type = p-prod-type
     5215           and buf_parts.prod-code = p-prod-code
     5216           and buf_parts.rsrv-free = yes
     5217           and buf_parts.status_   = no
     5218           and buf_parts.in-code   <> buf_parts.out-code
     5219       on error undo, return error
     5220       :
     5221         run partslib-create-temp-parts in this-procedure
     5222           (buffer buf_parts
     5223           ,buffer buf_temp-parts
     5224           ,input  v-goods-twounit
     5225           ) .
     5226         define variable v-parts-qnty          as decimal   no-undo .
     5227         define variable v-parts-cli-qnty      as decimal   no-undo .
     5228         define variable v-parts-free-qnty     as decimal   no-undo .
     5229         define variable v-parts-free-cli-qnty as decimal   no-undo .
     5230         if buf_parts.out-code = 'free-zone':U
     5231         then do:
     5232           assign
     5233             v-parts-qnty          = buf_parts.qnty
     5234             v-parts-cli-qnty      = buf_parts.cli-qnty
     5235             v-parts-free-qnty     = buf_parts.qnty
     5236             v-parts-free-cli-qnty = buf_parts.cli-qnty
     5237           .
     5238         end.
     5239         else do:
     5240           assign
     5241             v-parts-qnty          = abs(buf_parts.qnty)
     5242             v-parts-cli-qnty      = abs(buf_parts.cli-qnty)
     5243             v-parts-free-qnty     = 0
     5244             v-parts-free-cli-qnty = 0
     5245           .
     5246         end.
     5247         assign
     5248           buf_temp-parts.qnty          = buf_temp-parts.qnty          + v-parts-qnty
     5249           buf_temp-parts.fact-qnty     = buf_temp-parts.fact-qnty     + v-parts-qnty
     5250           buf_temp-parts.real-qnty     = 0
     5251           buf_temp-parts.cli-qnty      = buf_temp-parts.cli-qnty      + v-parts-cli-qnty
     5252           buf_temp-parts.free-qnty     = buf_temp-parts.free-qnty     + v-parts-free-qnty
     5253           buf_temp-parts.free-cli-qnty = buf_temp-parts.free-cli-qnty + v-parts-free-cli-qnty
     5254         .
     5255       end.
     5256     end.
     5257   end procedure.
     5258   procedure partslib-init-temp-parts-by-factord :
     5259     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
     5260     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
