      575   function excel-format-dec-to-char returns char (input p-dec as decimal ).
      576     if num-entries(string(p-dec), '.') = 2
      577       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
      578       else return( string(p-dec)) .
      579   end function.
      580   function format-point-to-comma returns char (input orig as char ) .
      581   define variable rtext as character no-undo .
      582   define variable strt as integer no-undo .
      583   define variable leng as integer no-undo .
      584   assign rtext = orig .
      585   repeat:
      586     strt =  index(rtext,'.').
      587     if strt = 0 then leave.
      588     leng = 1.
      589     substring(rtext,strt,leng,"character") = v-delim .
      590   end.
      591   return rtext.
      592   end function.
      593   function format-excel-text returns char ( input start-text as char ) :
      594   def var  i    as int no-undo.
      595   def var  ch   as char no-undo.
      596   def var  n    as int no-undo.
      597   def var  ipos as int no-undo.
      598     n = num-entries(trim(start-text), chr(10)) - 1 .
      599     do i = 1 to n :
      600       ipos = index( start-text, chr(10)).
      601       if ipos > 0 then
      602         substr( start-text, ipos, 1 ) = ' '.
      603     end.
      604     n = num-entries(trim(start-text), chr(13)) - 1 .
      605     do i = 1 to n :
      606       ipos = index( start-text, chr(13)).
      607       if ipos > 0 then
      608         substr( start-text, ipos, 1 ) = ' '.
      609     end.
      610     if index( start-text, '"' ) = 0 then
      611       start-text =  '="'   + trim( start-text) + '"'   .
      612       else do:
      613         n = num-entries(trim(start-text), '"') - 1.
      614         do i = 1 to n :
      615           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      616         end.
      617         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      618         start-text = '="'  + ch  + '"' .
      619       end.
      620     return start-text.
      621   end.
      622   function excel-sum returns char (input p-dec as decimal ).
      623     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
      624   end function.
      625   function excel-qnty returns char (input p-dec as decimal ).
      626     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
      627   end function.
      628   function format-excel-text-macr returns char ( input start-text as char ) :
      629   def var  i    as int no-undo.
      630   def var  ch   as char no-undo.
      631   def var  n    as int no-undo.
      632   def var  ipos as int no-undo.
      633     n = num-entries(trim(start-text), chr(10)) - 1 .
      634     do i = 1 to n :
      635       ipos = index( start-text, chr(10)).
      636       if ipos > 0 then
      637         substring( start-text, ipos , 1 ) = ' '.
      638     end.
      639     n = num-entries(trim(start-text), chr(13)) - 1 .
      640     do i = 1 to n :
      641       ipos = index( start-text, chr(13)).
      642       if ipos > 0 then
      643         substring( start-text, ipos, 1 ) = ' '.
      644     end.
      645     if index( start-text, '"' ) = 0 then
      646       start-text =  '"'   + trim( start-text) + '"'   .
      647       else do:
      648         n = num-entries(trim(start-text), '"') - 1.
      649         do i = 1 to n :
      650           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      651         end.
      652         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      653         start-text = '"'  + ch  + '"' .
      654       end.
      655     n = num-entries(trim(start-text), chr(10)) - 1 .
      656     do i = 1 to n :
      657       ipos = index( start-text, chr(10)).
      658       if ipos > 0 then
      659         substring( start-text, ipos , 1 ) = ' '.
      660     end.
      661       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
      662     return start-text.
      663   end.
      664   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      665   define variable v-waitfram-action01         as character   no-undo .
      666   define variable v-waitfram-action02         as character   no-undo .
      667   define variable v-waitfram-action03         as character   no-undo .
      668   define variable mWaitFramTextBeg            as character   no-undo.
      669   define variable mWaitFramTextEnd            as character   no-undo.
      670   define variable mWaitFramView               as logical     no-undo.
      671   define variable mWaitProcEvent              as logical     no-undo init yes.
      672   define variable mWaitFramInterval           as integer     no-undo init 1 .
      673   define variable mWaitFramStop               as logical     no-undo.
      674   define variable mWaitFramStopUser           as logical     no-undo.
      675   define variable mWaitFramStopTimeOut        as logical     no-undo.
      676   define variable mWaitFramStartProc          as datetime-tz no-undo.
      677   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      678   define button B-WaitFramStop auto-end-key
      679        label "Стоп"
      680        size 10 by 1 tooltip "Остоновить процесс".
      681   define button B-viewProcInfo
      682        label "Информация"
      683        size 15 by 1 tooltip "Информация о процесс".
      684   define frame waitfram
      685     v-waitfram-action01 format "x(72)" no-label skip
      686     v-waitfram-action02 format "x(72)" no-label skip
      687     v-waitfram-action03 format "x(72)" no-label skip
      688     B-viewProcInfo
      689     B-WaitFramStop at row 4 col 30
      690     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      691     .
      692   define new global shared variable mBatchMode as logical no-undo init ?.
      693   define variable mFramBachModHandle as handle no-undo.
      694   mFramBachModHandle = frame waitfram:handle.
      695   define variable mFameOldVis as logical no-undo.
      696   define variable mVisCUrentVin as logical no-undo.
      697   if session:batch-mode
      698   then
      699      mBatchMode = yes.
      700   if mBatchMode = ? then do:
      701     mVisCUrentVin = current-window:visible.
      702     mFameOldVis = mFramBachModHandle:visible.
      703     mFramBachModHandle:visible  = yes.
      704     mBatchMode = mFramBachModHandle:visible ne yes.
      705     mFramBachModHandle:visible = mFameOldVis.
      706     current-window:visible = mVisCUrentVin.
      707   end.
      708    if  log-manager:logfile-name ne ?
      709     then DO:
      710         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      711         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      712         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      713     end.
      714   on choose of B-WaitFramStop in frame waitfram
      715   do:
      716     mWaitFramStop = yes.
      717     mWaitFramStopUser = yes.
      718   end.
      719   function waitfram-check-timeout returns logical():
      720      define variable vtime as int64 no-undo.
      721      if mWaitFramStopTimeOut
      722      then
      723         return yes.
      724      vtime = ( now - mWaitFramStartProc ) / 1000 .
      725      if     mWaitFramTimeOut ne ?
      726         and mWaitFramTimeOut ne 0
      727         and mWaitFramTimeOut lt vtime
      728      then do:
      729         mWaitFramStopTimeOut = yes.
      730      end.
      731      return mWaitFramStopTimeOut.
      732   end.
      733   procedure waitfram-hide :
      734     if not session:batch-mode
      735     then do
      736     on error undo, return error return-value
      737     :
      738       pause 0 before-hide .
      739       if not mBatchMode then
      740         hide frame waitfram .
      741     if     not mWaitFramView
      742        and mWaitProcEvent
      743     then
      744       process events .
      745     end.
      746   end procedure.
      747   procedure waitfram-show :
      748     define input  parameter p-message as character no-undo .
      749     define variable v-left-margin as integer   no-undo .
      750     if not session:batch-mode
      751     then do
      752     on error undo, return error return-value
      753     :
      754       if length(p-message) <= 70 then do:
      755         assign
      756           v-left-margin = integer((70 - length(p-message)) / 2)
      757         .
      758         assign
      759           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      760         .
      761         assign
      762           v-waitfram-action01 = " "
      763           v-waitfram-action02 = " "
      764                                    + fill(" ", v-left-margin)
      765                                    + p-message
      766           v-waitfram-action03 = " "
      767         .
      768       end.
      769       else do:
      770         define variable vRindex1 as integer no-undo.
      771         define variable vRindex2 as integer no-undo.
      772         vRindex1 = r-index(p-message," ",70).
      773         if vRindex1 = 0
      774         then
      775            vRindex1 = 70.
      776         if length(p-message)  <= vRindex1 + 70 then do:
      777           assign
      778             v-waitfram-action01 = " "
      779             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      780             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      781           .
      782         end.
      783         else do:
      784           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      785           if vRindex2 <= vRindex1
      786           then
      787              vRindex2 = vRindex1 + 70.
      788           assign
      789             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      790             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      791             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      792           .
      793         end.
      794       end.
      795       B-viewProcInfo:visible   in frame waitfram = no.
      796       B-viewProcInfo:sensitive in frame waitfram = no.
      797       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      798       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      799       if  (   mWaitFramView
      800          or  mWaitProcEvent)
      801          and not mBatchMode
      802       then
      803          display
      804             v-waitfram-action01 skip
      805             v-waitfram-action02 skip
      806             v-waitfram-action03 skip
      807          with frame waitfram .
      808       if     mWaitFramView
      809          then do:
      810             if     mWaitFramInterval ne ?
      811                and not mBatchMode
      812             then
      813                wait-for go of frame waitfram pause mWaitFramInterval.
      814          end.
      815          else
      816             if     mWaitProcEvent
      817                and not mBatchMode
      818             then
      819                process events .
      820     end.
      821   end procedure.
      822      procedure waitfram-show-this:
      823         define input  parameter iInterval as int64 no-undo.
      824         define variable vtime as int64 no-undo.
      825         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      826         mWaitFramInterval = iInterval.
      827         run waitfram-show (substitute("&1&2 &3&4" ,
      828                                       mWaitFramTextBeg ,
      829                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      830                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      831                                       mWaitFramTextEnd
      832                                      )
      833                           ).
      834      end.
      835      procedure WaitFramRunPause:
      836         define input  parameter iInterval as dec no-undo.
      837         define variable vStart  as datetime-tz no-undo.
      838         define variable vend    as datetime-tz no-undo.
      839         define variable vint as int64 no-undo.
      840         define variable vOk as logical no-undo.
      841         vStart = now.
      842         vend   = vStart.
      843         publish "WaitFramPause" (iInterval,output vOk).
      844         vend   =  now.
      845         vint = vend - vStart.
      846         vint = iInterval - vint / 1000.
      847         if     not mWaitFramStop
      848            and (   vint > 0
      849                 or (    not vOk
      850                     and iInterval eq ?
      851                     )
      852                 )
      853         then
      854            run waitfram-show-this (iInterval).
      855         vend   =  now.
      856         vint = vend - vStart.
      857         vint = iInterval - vint / 1000.
      858         if     not mWaitFramStop
      859            and vint > 0
      860         then do:
      861            run gbl/pause.p (vint * 1000).
      862         end.
      863         if iInterval ne ?
      864         then
      865            publish "WaitFramStop".
      866         waitfram-check-timeout().
      867      end.
      868      procedure WaitFramWaitFor:
      869         define input  parameter iInterval as dec no-undo.
      870         assign
      871            mWaitFramStartProc   = now
      872            mWaitFramStopUser    = no
      873            mWaitFramStopTimeOut = no
      874         .
      875         block-wait:
      876         do while not mWaitFramStop:
      877            run WaitFramRunPause (iInterval).
      878            if  waitfram-check-timeout()
      879            then do:
      880               leave block-wait.
      881            end.
      882         end.
      883         run waitfram-hide.
      884      end.
      885   procedure waitfram-join :
      886     define input  parameter p-line-1  as character no-undo .
      887     define input  parameter p-line-2  as character no-undo .
      888     define input  parameter p-line-3  as character no-undo .
      889     define output parameter p-message as character no-undo .
      890     do
      891     on error undo, return error return-value
      892     :
      893       assign
      894         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      895                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      896                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      897       .
      898     end.
      899   end procedure.
      900   function waitfram-join-function returns character
      901     (input p-line-1 as character
      902     ,input p-line-2 as character
      903     ,input p-line-3 as character
      904     ).
      905     define variable v-message as character no-undo .
      906     run waitfram-join in this-procedure
      907       (input  p-line-1
      908       ,input  p-line-2
      909       ,input  p-line-3
      910       ,output v-message
      911       ) .
      912     return v-message .
      913   end function .
      914   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      915   define  stream PrnLibStream.
      916   procedure prn-lib-prn-file :
      917     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      918     define input parameter p-DIsabledoptions as integer no-undo .
      919     define variable v-report-name as character no-undo .
      920     define variable v-user-action as character no-undo .
      921     define variable v-printed     as logical   no-undo .
      922     define variable v-exist       as logical   no-undo .
      923     do
      924       on error undo, return error
      925       :
      926       run prn-lib-get-report-name  in this-procedure (
      927         input parParentProc
      928         ,output v-report-name
      929         ).
      930   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      931   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      932     (input  v-report-name
      933     ,input  2
      934     ,output v-exist
      935     )  .
      936       if NOT v-exist then
      937       DO:
      938         Message
      939           "Нет заданий на печать ! "
      940           view-as alert-box .
