     6773   PROCEDURE find-sert-cli :
     6774   define input  parameter p-cli-type            like trn-doc.cli-type no-undo .
     6775   define input  parameter p-cli-code            like trn-doc.cli-code no-undo .
     6776   define input  parameter p-alc-type-inner-code like alc-type.alc-type-inner-code .
     6777   define output parameter p-sert      as character          no-undo .
     6778   define output parameter p-sert-give as character          no-undo .
     6779   define buffer buf_alc-supp-lic      for alc-supp-lic.
     6780   define buffer buf_alc-supp-lic-type for alc-supp-lic-type.
     6781   do
     6782   on error undo, return error return-value
     6783   :
     6784     for each   buf_alc-supp-lic
     6785          where buf_alc-supp-lic.cli-type = p-cli-type
     6786            and buf_alc-supp-lic.cli-code = p-cli-code
     6787            and buf_alc-supp-lic.date-to  > x-Date-Alone
     6788          no-lock
     6789          :
     6790          IF buf_alc-supp-lic.all-type = 0 then do:
     6791             find first buf_alc-supp-lic-type
     6792                  where buf_alc-supp-lic-type.alc-supp-lic-code   = buf_alc-supp-lic.alc-supp-lic-code
     6793                  and buf_alc-supp-lic-type.alc-type-inner-code = p-alc-type-inner-code
     6794                  no-lock
     6795                  no-error.
     6796             if not available buf_alc-supp-lic-type then do:
     6797                next.
     6798             end.
     6799         end.
     6800         assign
     6801           p-sert       =  substitute( "серия &1 № &2 выдана &3 c &4 по &5"
     6802                                     , buf_alc-supp-lic.seria
     6803                                     , buf_alc-supp-lic.number
     6804                                     )
     6805           p-sert-give  = substitute( "выдана &3 c &4 по &5"
     6806                                     , buf_alc-supp-lic.who-are-got
     6807                                     , string( buf_alc-supp-lic.date-from , "99/99/9999")
     6808                                     , string( buf_alc-supp-lic.date-to , "99/99/9999")
     6809                                     )
     6810         .
     6811         return.
     6812     end.
     6813   end.
     6814   END PROCEDURE.
     6815   PROCEDURE find-sert-sale :
     6816   define input  parameter p-cli-type            like trn-doc.cli-type no-undo .
     6817   define input  parameter p-cli-code            like trn-doc.cli-code no-undo .
